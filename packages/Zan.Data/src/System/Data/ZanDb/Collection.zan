using System;
using System.IO;
using System.Json;
using System.Text;
using System.Threading;

namespace System.Data.ZanDb;

/// <summary><see cref="Collection.ScanField"/> 的访问器：id 为文档 id，
/// v 为该文档 field 字段的值（每篇文档只有这一个字段被解码）。
/// 返回 false 结束扫描。</summary>
delegate bool FieldVisit(int id, JsonValue v);

/// <summary><see cref="Collection.ScanNumField"/> 的访问器：
/// id 为文档 id，v 为字段的数值形态（免 JsonValue 树）。</summary>
delegate bool NumVisit(int id, long v);

/// <summary><see cref="Collection.ScanStrField"/> 的访问器：
/// id 为文档 id，v 为字段的文本形态（免 JsonValue 树）。</summary>
delegate bool StrVisit(int id, string v);

/// <summary>
/// <see cref="ZanDatabase"/> 中一组有名字的文档。文档是
/// JsonValue 对象树，每篇文档分配一个自增整数 _id。
/// 存储键在 <see cref="ZanStore"/> 中以命名空间区分：
///   c:{name}:{id}                   文档正文（key-dict 编码的 JSON）
///   m:{name}:keys                   字段名字典（JSON 数组）
///   m:{name}:seq                    最后分配的 id
///   m:{name}:idx                    逗号分隔的索引字段列表
///   m:{name}:idxpos:{field}         批量索引构建游标（缺失表示已构建完成）
///   i:{name}:{field}:{value}\t{id}  二级索引条目 -> id
/// id 用零填充，因此键序即插入顺序，使 FindAll
/// 和范围迭代变成顺序扫描。
/// </summary>
class Collection {
    ZanStore kv;
    AsyncRwLock rw;
    string name;
    List<string> indexedFields;
    List<string> keyDict;
    bool keyDictDirty;
    long metaVersion;
    /// 已缓存的下一个待分配 id；0 = 尚未从 seq 键加载。
    /// 单写者模型下安全：序列键仍随每次分配落盘（事务覆盖层
    /// 会在提交时去重成一帧），崩溃后经重开恢复，缓存作废重读。
    int nextIdCache;
    /// 进程内热点文档 LRU 缓存池与访问序列，避免重复 I/O 与反序列化。
    Dict<int, JsonValue> docCache;
    List<int> docCacheOrder;
    int docCacheCapacity;

    /// <summary>批量索引构建中每个事务索引的文档数。</summary>
    static int INDEX_BATCH = 500;

    // 记录会转义以剔除 0x00（参见 EncodeDoc）；转义
    // 字节为 0xFF，几乎从不出现，因此读取路径用 memchr——
    // C 中的一次向量化扫描——判断是否确实需要反转义，而不是
    // 将每条记录逐字节复制到第二个缓冲区。
    [DllImport("crt", EntryPoint = "memchr")]
    static extern nint MemChr(nint p, int c, long n);

    /// 仅初始化空字段；真正的构造走 <see cref="Attach"/>。
    Collection() {
        this.name = "";
        this.indexedFields = new List<string>();
        this.keyDict = new List<string>();
        this.keyDictDirty = false;
        this.metaVersion = 0 - 1;
        this.nextIdCache = 0;
        this.docCache = new Dict<int, JsonValue>();
        this.docCacheOrder = new List<int>();
        this.docCacheCapacity = 256;
    }

    /// 绑定到底层 ZanStore 的一个命名空间，并加载索引列表与字段名字典。
    static Collection Attach(ZanStore kv, AsyncRwLock rw, string name) {
        Collection c = new Collection();
        c.kv = kv;
        c.rw = rw;
        c.name = name;
        c.docCache = new Dict<int, JsonValue>();
        c.docCacheOrder = new List<int>();
        c.docCacheCapacity = 256;
        c.LoadIndexMeta();
        c.LoadKeyDict();
        c.metaVersion = kv.Version();
        return c;
    }

    /// <summary>当数据库更新到新版本（即其他进程已提交）时，重新读取缓存的元数据（字段名字典、索引
    /// 列表）。操作文档前两者都必需：
    /// 字典负责编解码对象键，因此过期的副本会
    /// 用错误的字段名解码其他进程的文档，并将这些 id
    /// 复用到不同的名称上。开销低：一次版本比较，
    /// 两次读取只在确实有变化时
    /// 才发生。</summary>
    void SyncMeta() {
        long v = this.kv.Version();
        if (v == this.metaVersion) { return; }
        // 绝不要在当前尚未落盘的字典条目上重新加载——
        // （事务中编码中途的条目）——否则它们会丢失。
        if (this.keyDictDirty) { return; }
        this.metaVersion = v;
        ClearCache();
        LoadIndexMeta();
        LoadKeyDict();
    }

    /// 集合名。
    string Name() { return this.name; }

    // id 出现在每个文档键和每个索引条目中，其文本形式
    // 占据文件的一大部分。它们写成六个 base-64 数字，
    // 取自可打印字符集 '?'..'~' (0x3F..0x7E)：字节序仍
    // 等于数值顺序，因此 B+Tree 顺序保持为插入顺序；
    // 该字符集既不含 0x00，也不含分隔键的 ':' 和制表符；
    // 6 位数字仍可覆盖 64^6 = 680 亿个 id——宽度只有
    // 之前 12 位十进制数字的一半。
    static int ID_DIGITS = 6;

    /// 把 id 编码为定宽 6 位 base-64 数字（'?'..'~'）：字节序即数值序，
    /// 且不含 0x00、':' 与 '\t'，不破坏 B+Tree 顺序与键分隔。
    static string PadId(int id) {
        ByteBuffer b = ByteBuffer.Alloc(Collection.ID_DIGITS);
        int shift = (Collection.ID_DIGITS - 1) * 6;
        while (shift >= 0) {
            b.WriteU8(63 + ((id >> shift) & 63));
            shift = shift - 6;
        }
        string s = b.ToStr();
        b.Free();
        return s;
    }

    /// <summary>PadId 的逆操作。</summary>
    static int UnpadId(string s) {
        int v = 0;
        for (int i = 0; i < s.Length; i = i + 1) {
            v = (v << 6) | ((s[i] & 255) - 63);
        }
        return v;
    }

    /// <see cref="UnpadId"/> 的裸指针形式（定宽 ID_DIGITS 字节）。
    static int UnpadIdPtr(nint p) {
        int v = 0;
        for (int i = 0; i < Collection.ID_DIGITS; i = i + 1) {
            v = (v << 6) | (Collection.PeekB(p + i) - 63);
        }
        return v;
    }

    /// 文档正文键 c:{name}:{id(定宽)}。
    string DocKey(int id) {
        return "c:" + this.name + ":" + Collection.PadId(id);
    }

    /// 自增 id 序列键。
    string SeqKey() {
        return "m:" + this.name + ":seq";
    }

    /// 索引字段列表元数据键（逗号分隔）。
    string IdxMetaKey() {
        return "m:" + this.name + ":idx";
    }

    /// 字段名字典元数据键（JSON 数组）。
    string KeysMetaKey() {
        return "m:" + this.name + ":keys";
    }

    /// 批量索引构建游标键；键不存在即表示该索引已构建完成。
    string IdxPosKey(string field) {
        return "m:" + this.name + ":idxpos:" + field;
    }

    /// <summary>同一索引字段所有条目共享的前缀。字段用
    /// 其字典 id 表示而非拼出全名，因此长字段名
    /// 对每个条目零开销。</summary>
    string IdxPrefix(string field, string val) {
        return "i:" + this.name + ":" + Collection.PadId(KeyIdOf(field)) + ":"
               + val + "\t";
    }

    /// 完整二级索引条目键：<see cref="IdxPrefix"/> 加定宽 id。
    string IdxKey(string field, string val, int id) {
        return IdxPrefix(field, val) + Collection.PadId(id);
    }

    /// 从元数据键加载索引字段列表（逗号分隔；空则无索引）。
    void LoadIndexMeta() {
        this.indexedFields = new List<string>();
        string meta = this.kv.Get(IdxMetaKey());
        if (meta.Length == 0) { return; }
        int start = 0;
        for (int i = 0; i <= meta.Length; i = i + 1) {
            if (i == meta.Length || (meta[i] & 255) == 44) {
                if (i > start) { this.indexedFields.Add(meta.Substring(start, i - start)); }
                start = i + 1;
            }
        }
    }

    // ===== 字段名字典 =====
    //
    // 对象键在每篇文档中重复出现，原样存储会浪费
    // 与集合规模成正比的空间。每个集合维护一个
    // 持久的字段名字典；磁盘上的对象键是 1 起始的
    // 字典 id，文档正文是紧凑的二进制记录，其中是
    // 带类型的 varint 编码值（非 JSON 文本）——参见 EncodeDoc/DecodeDoc。

    /// 从元数据键的 JSON 数组加载字段名字典。
    void LoadKeyDict() {
        this.keyDict = new List<string>();
        this.keyDictDirty = false;
        string meta = this.kv.Get(KeysMetaKey());
        if (meta.Length == 0) { return; }
        JsonValue arr = JsonValue.ParseLenient(meta);
        for (int i = 0; i < arr.Count(); i = i + 1) {
            this.keyDict.Add(arr.At(i).AsString(""));
        }
    }

    /// 字段名的 1 起始字典 id；首次出现时追加进字典并标记待持久化（须在 kv 事务内）。
    int KeyId(string k) {
        for (int i = 0; i < this.keyDict.Count; i = i + 1) {
            if (this.keyDict[i] == k) { return i + 1; }
        }
        this.keyDict.Add(k);
        this.keyDictDirty = true;
        return this.keyDict.Count;
    }

    /// <summary>字段名的字典 id；若该集合从未
    /// 存储过该字段则返回 0。与 KeyId 不同，此方法不会扩充字典，
    /// 因此可在读取路径安全使用。</summary>
    int KeyIdOf(string k) {
        for (int i = 0; i < this.keyDict.Count; i = i + 1) {
            if (this.keyDict[i] == k) { return i + 1; }
        }
        return 0;
    }

    /// 字典 id 反查字段名；越界时返回 "?" 加 id（不抛错）。
    string KeyName(int id) {
        if (id >= 1 && id <= this.keyDict.Count) { return this.keyDict[id - 1]; }
        return "?" + Convert.ToString(id);
    }

    /// 字典有变更时把整个字典写回元数据键（须在 kv 事务内）。
    void PersistKeyDict() {
        if (!this.keyDictDirty) { return; }
        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < this.keyDict.Count; i = i + 1) {
            arr.Append(JsonValue.NewStr(this.keyDict[i]));
        }
        this.kv.Put(KeysMetaKey(), arr.ToJson());
        this.keyDictDirty = false;
    }

    // 二进制记录的值标签：0 null、1 false、2 true、3 非负整数
    // （varint）、8 负整数（其幅度的 varint）、9 整数零（无
    // 载荷）、4 文本数字（非整数）、5 字符串、10 空字符串（无
    // 载荷）、6 数组、7 对象。标签 9/10 为最常见的两个单元格
    // （0 和 ""）提供 SQLite 式“值即类型”表示——它们还
    // 让 0x00 不进入记录，因此下面的 NUL 转义几乎从不触发。
    /// 字符串是否为纯十进制整数（可带负号，至多 18 位以留在 varint 范围内）。
    static bool IsIntStr(string s) {
        int n = s.Length;
        if (n == 0) { return false; }
        int i = 0;
        if ((s[0] & 255) == 45) { i = 1; if (n == 1) { return false; } }
        if (n - i > 18) { return false; }   // 保持在 zigzag varint 范围内
        while (i < n) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { return false; }
            i = i + 1;
        }
        return true;
    }

    /// 解析带符号的十进制整数为 64 位。用它替代 Convert.ToInt，因为后者
    /// 目前降级为 C 的 atoi（声明返回 i64），因此无法
    /// 符号扩展——负数及大于 2^31 的值会以零扩展的
    /// 垃圾数据返回。累加器必须是 long：IsIntStr 放行最长 18 位，
    /// epoch 毫秒时间戳（13 位，>2^31）此前在 int 里静默回绕后落盘。
    static long ParseI64(string s) {
        int n = s.Length;
        int i = 0;
        bool neg = false;
        if (n > 0 && (s[0] & 255) == 45) { neg = true; i = 1; }   // '-'
        long acc = 0;
        while (i < n) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { break; }
            acc = acc * 10 + (c - 48);
            i = i + 1;
        }
        if (neg) { return 0 - acc; }
        return acc;
    }

    /// 按上方标签表把一个 JsonValue 写入记录；对象键写作字典 id（须在 kv 事务内）。
    void WriteVal(ByteBuffer b, JsonValue v) {
        if (v.IsNull()) { b.WriteU8(0); return; }
        if (v.IsBool()) {
            if (v.AsBool(false)) { b.WriteU8(2); } else { b.WriteU8(1); }
            return;
        }
        if (v.IsNumber()) {
            string raw = v.AsString("");
            if (Collection.IsIntStr(raw)) {
                long iv = Collection.ParseI64(raw);
                if (iv == 0) { b.WriteU8(9); }
                else if (iv < 0) { b.WriteU8(8); b.WriteVarInt(0 - iv); }
                else { b.WriteU8(3); b.WriteVarInt(iv); }
            } else {
                b.WriteU8(4);
                b.WriteString(raw);
            }
            return;
        }
        if (v.IsString()) {
            string sv = v.AsString("");
            if (sv.Length == 0) { b.WriteU8(10); }
            else { b.WriteU8(5); b.WriteString(sv); }
            return;
        }
        if (v.IsArray()) {
            b.WriteU8(6);
            b.WriteVarInt(v.Count());
            for (int i = 0; i < v.Count(); i = i + 1) { WriteVal(b, v.At(i)); }
            return;
        }
        b.WriteU8(7);
        b.WriteVarInt(v.Count());
        for (int i = 0; i < v.Count(); i = i + 1) {
            b.WriteVarInt(KeyId(v.KeyAt(i)));
            WriteVal(b, v.ValAt(i));
        }
    }

    /// <summary>doc 的 from 之后是否还存在同名键
    /// （JsonValue.Put 追加不去重，重复键以后写为准——与
    /// DecodeDoc/JSON 语义一致，编码时在这里去重）。</summary>
    static bool HasLaterKey(JsonValue doc, string key, int from) {
        for (int j = from + 1; j < doc.Count(); j = j + 1) {
            if (doc.KeyAt(j) == key) { return true; }
        }
        return false;
    }

    /// <summary>将文档序列化为紧凑的二进制记录：一个 'B'
    /// 格式字节，随后是顶层对象的字段（字典 id 键 +
    /// 带类型的值）。冗余的 "_id" 被省略——它是行键，读取时
    /// 重新附加。重复键只写最后一次出现（Put 的追加语义下
    /// 老值作废），部分读取（FieldOf）与全量解码因此一致。
    /// 必须在 kv 事务内运行：新字段名
    /// 会与正文一起持久化。</summary>
    string EncodeDoc(JsonValue doc) {
        ByteBuffer b = ByteBuffer.Alloc(64);
        b.WriteU8(66);   // 'B'
        int n = 0;
        int i = 0;
        for (; i < doc.Count(); i = i + 1) {
            string k0 = doc.KeyAt(i);
            if (k0 != "_id" && !Collection.HasLaterKey(doc, k0, i)) { n = n + 1; }
        }
        b.WriteVarInt(n);
        i = 0;
        while (i < doc.Count()) {
            string k = doc.KeyAt(i);
            if (k != "_id" && !Collection.HasLaterKey(doc, k, i)) {
                b.WriteVarInt(KeyId(k));
                WriteVal(b, doc.ValAt(i));
            }
            i = i + 1;
        }
        PersistKeyDict();
        // 常态快速路径：记录不含 0x00/0xFF 时无需转义，直接成串——
        // 省去逐字节扫描重写与第二个缓冲区（文本型文档几乎总命中）。
        long blen = b.Length();
        if (Collection.MemChr(b.Raw(), 0, blen) == 0
                && Collection.MemChr(b.Raw(), 255, blen) == 0) {
            string s0 = b.ToStr();
            b.Free();
            return s0;
        }
        // 转义为不含 NUL 的字节流。运行时字符串类型（以及
        // ToStr 和 B+Tree 自带的 ReadString 都在使用的
        // NativeMemory.GetString）遇到第一个 0x00 即停止，因此原始记录——
        // 它通常包含 0x00 字节（例如整数 0、空字符串、
        // 零计数）——无法经受字符串的往返。0xFF 是
        // 转义字节：0x00 -> FF 01，0xFF -> FF 02；其余字节原样通过。
        ByteBuffer e = ByteBuffer.Alloc(b.Length() + 8);
        b.SeekRead(0);
        while (b.Remaining() > 0) {
            int by = b.ReadU8();
            if (by == 0) { e.WriteU8(255); e.WriteU8(1); }
            else if (by == 255) { e.WriteU8(255); e.WriteU8(2); }
            else { e.WriteU8(by); }
        }
        string s = e.ToStr();
        b.Free();
        e.Free();
        return s;
    }

    /// <summary>键尾随数字中编码的 id。行键和
    /// 索引条目都以定宽 id 结尾，因此无需搜索分隔符——
    /// id 的某个数字可能恰好像分隔符。</summary>
    static int IdOfKey(string key) {
        int off = key.Length - Collection.ID_DIGITS;
        if (off < 0) { return 0; }
        return Collection.UnpadId(key.Substring(off, Collection.ID_DIGITS));
    }

    /// <see cref="IdOfKey"/> 的裸指针形式：键尾 6 字节定宽
    /// id（'?'..'~'）直接还原，零分配。baseKey 指向键首字节，
    /// keyLen 为键长。</summary>
    static int IdOfPtr(nint baseKey, int keyLen) {
        int off = keyLen - Collection.ID_DIGITS;
        if (off < 0) { return 0; }
        return Collection.UnpadIdPtr(baseKey + off);
    }

    /// <see cref="IdOfKey"/> 的字符串形式。
    static string IdFromKey(string key) {
        return Convert.ToString(Collection.IdOfKey(key));
    }

    // ===== 字符串直读解码器：不经 ByteBuffer、常态零拷贝零分配（除值本身）。=====
    // 记录格式见 EncodeDoc：'B' + VarInt(字段数) + (VarInt(字典id) + 值)*。
    // 存储串不含 0x00；含 0xFF（转义标记或载荷）的先经 UnescapeRecord 还原。

    [DllImport("crt", EntryPoint = "memchr")]
    static extern nint StrMemChr(string p, int c, long n);

    [DllImport("crt", EntryPoint = "memcmp")]
    static extern int MemCmpRaw(nint a, string b, long n);

    /// 与 ByteBuffer.WriteVarInt 同格式的变长整数读取（显式位置传递）。
    static long RecVarInt(string s, int p, out int np) {
        long v = 0;
        int shift = 0;
        while (true) {
            int by = s[p] & 255;
            p = p + 1;
            v = v + ((long)(by & 127) << shift);
            if ((by & 128) == 0) { break; }
            shift = shift + 7;
        }
        np = p;
        return v;
    }

    /// 记录含 0xFF 时（转义标记或载荷）还原为可直读的串。罕见路径。
    static string UnescapeRecord(string body) {
        ByteBuffer b = ByteBuffer.Alloc(body.Length + 4);
        for (int i = 0; i < body.Length; i = i + 1) {
            int by = body[i] & 255;
            if (by == 255) {
                i = i + 1;
                int nx = body[i] & 255;
                if (nx == 1) { b.WriteU8(0); } else { b.WriteU8(255); }
            } else {
                b.WriteU8(by);
            }
        }
        string s = b.ToStr();
        b.Free();
        return s;
    }

    /// 从记录中读取 <see cref="WriteVal"/> 写出的一个值并还原为
    /// JsonValue；p 为值起始字节，np 为值结束后的位置。
    JsonValue ReadValS(string s, int p, out int np) {
        int tag = s[p] & 255;
        p = p + 1;
        if (tag == 0) { np = p; return JsonValue.NewNull(); }
        if (tag == 1) { np = p; return JsonValue.NewBool(false); }
        if (tag == 2) { np = p; return JsonValue.NewBool(true); }
        if (tag == 3) {
            long v = Collection.RecVarInt(s, p, out np);
            return JsonValue.NewNum(Convert.ToString(v));
        }
        if (tag == 8) {
            long v = Collection.RecVarInt(s, p, out np);
            return JsonValue.NewNum(Convert.ToString(0 - v));
        }
        if (tag == 9) { np = p; return JsonValue.NewNum("0"); }
        if (tag == 4 || tag == 5) {
            long n = Collection.RecVarInt(s, p, out p);
            string t = s.Substring(p, (int)n);
            np = p + (int)n;
            if (tag == 4) { return JsonValue.NewNum(t); }
            return JsonValue.NewStr(t);
        }
        if (tag == 10) { np = p; return JsonValue.NewStr(""); }
        if (tag == 6) {
            long c = Collection.RecVarInt(s, p, out p);
            JsonValue a = JsonValue.NewArray();
            for (int i = 0; i < (int)c; i = i + 1) {
                JsonValue v = ReadValS(s, p, out p);
                a.Append(v);
            }
            np = p;
            return a;
        }
        // tag == 7：对象
        long oc = Collection.RecVarInt(s, p, out p);
        JsonValue obj = JsonValue.NewObject();
        for (int i = 0; i < (int)oc; i = i + 1) {
            long kid = Collection.RecVarInt(s, p, out p);
            JsonValue v = ReadValS(s, p, out p);
            obj.Set(KeyName((int)kid), v);
        }
        np = p;
        return obj;
    }

    /// <summary>跳过一个编码值，而不从中构建任何内容。
    /// 字符串和文本形式的数字按长度跳过，而非复制。</summary>
    static void SkipValS(string s, int p, out int np) {
        int tag = s[p] & 255;
        p = p + 1;
        if (tag == 3 || tag == 8) { Collection.RecVarInt(s, p, out np); return; }
        if (tag == 4 || tag == 5) {
            long n = Collection.RecVarInt(s, p, out p);
            np = p + (int)n;
            return;
        }
        if (tag == 6) {
            long c = Collection.RecVarInt(s, p, out p);
            for (int i = 0; i < (int)c; i = i + 1) { Collection.SkipValS(s, p, out p); }
            np = p;
            return;
        }
        if (tag == 7) {
            long c = Collection.RecVarInt(s, p, out p);
            for (int i = 0; i < (int)c; i = i + 1) {
                p = (int)Collection.RecVarInt(s, p, out p);
                Collection.SkipValS(s, p, out p);
            }
            np = p;
            return;
        }
        // 标签 0、1、2、9、10 不带载荷。
        np = p;
    }

    /// <summary>直接从存储的记录中取出一个字段：其他字段
    /// 被跳过而非解码，因此对大集合做过滤
    /// 不会为每篇文档构建 JsonValue 树。记录中
    /// 没有该字段时返回 null。</summary>
    JsonValue FieldOf(string body, int kid) {
        if (kid == 0) { return null; }
        if (StrMemChr(body, 255, body.Length) != 0) { body = Collection.UnescapeRecord(body); }
        int p = 1;                     // 'B'
        long n = Collection.RecVarInt(body, p, out p);
        int i = 0;
        while (i < (int)n) {
            long k = Collection.RecVarInt(body, p, out p);
            if ((int)k == kid) {
                return ReadValS(body, p, out p);
            }
            Collection.SkipValS(body, p, out p);
            i = i + 1;
        }
        return null;
    }

    /// <summary>字段等值判定（<see cref="FindIdsByField"/> 与
    /// <see cref="CountByField"/> 的过滤内核）：字符串值
    /// （记录 tag 5）按长度 + 逐字节比较，零分配；
    /// 其他类型才解码出值按 <see cref="JsonValue.AsString"/>
    /// 比较（与投影读语义一致）。与 FieldOf 相同的记录行走，
    /// 但命中字段后不构建 JsonValue。</summary>
    bool FieldEquals(string body, int kid, string val) {
        if (kid == 0) { return false; }
        if (StrMemChr(body, 255, body.Length) != 0) { body = Collection.UnescapeRecord(body); }
        int p = 1;                     // 'B'
        long n = Collection.RecVarInt(body, p, out p);
        int i = 0;
        while (i < (int)n) {
            long k = Collection.RecVarInt(body, p, out p);
            if ((int)k == kid) {
                int tag = body[p] & 255;
                if (tag == 5) {
                    p = p + 1;
                    long len = Collection.RecVarInt(body, p, out p);
                    if (len != val.Length) { return false; }
                    for (int j = 0; j < (int)len; j = j + 1) {
                        if (body[p + j] != val[j]) { return false; }
                    }
                    return true;
                }
                JsonValue f = ReadValS(body, p, out p);
                return f.AsString("") == val;
            }
            Collection.SkipValS(body, p, out p);
            i = i + 1;
        }
        return false;
    }

    /// <summary>等值过滤的快速否证前提：needle 至少 2 字符、
    /// 含「非数值渲染字符」的字符（排除数值 AsString 归一化渲染
    /// 的等值可能——整数/浮点渲染只含 0-9 与 + - . e E）、
    /// 不含 0x00/0xFF（排除转义编码的字节位移）、不是 "true"/
    /// "false"（排除布尔 AsString 等值）。满足时 needle 的原
    /// 字节若不在记录值区出现，字段就绝不等于该值——整行免
    /// 物化免走读直接否决。</summary>
    bool EqFastReject(string val) {
        if (val.Length < 2) { return false; }
        if (val == "true" || val == "false") { return false; }
        if (StrMemChr(val, 0, val.Length) != 0
                || StrMemChr(val, 255, val.Length) != 0) { return false; }
        for (int i = 0; i < val.Length; i = i + 1) {
            int c = val[i] & 255;
            if (c < 48 || c > 57) {
                if (c != 43 && c != 45 && c != 46 && c != 69 && c != 101) { return true; }
            }
        }
        return false;
    }

    /// <summary>needle 原字节是否不在行值区出现：memchr 找首字符
    /// 出现点、memcmp 全针验证，命中点逐个推进。找不到即整行
    /// 否决（<see cref="EqFastReject"/> 前提下声音）。约 5ns 级
    /// 原语成本，替代数百纳秒的记录走读。</summary>
    bool NeedleAbsent(ScanRow row, string val) {
        nint p = row.ValPtr();
        long n = row.ValLen();
        if (n < val.Length) { return true; }
        int c = val[0] & 255;
        long len = val.Length;
        nint hit = MemChr(p, c, n);
        while (hit != 0) {
            long off = (long)(hit - p);
            if (off + len <= n && MemCmpRaw(hit, val, len) == 0) { return false; }
            hit = MemChr(hit + 1, c, n - off - 1);
        }
        return true;
    }

    /// <summary><see cref="FieldEquals"/> 的行视图版：满足
    /// <see cref="EqFastReject"/> 的 needle 先做针线否证（零物化），
    /// 未否决才物化值走权威走读；不满足直接走权威走读。</summary>
    bool FieldEqualsRow(ScanRow row, int kid, string val, bool fastReject) {
        if (kid == 0) { return false; }
        if (fastReject && row.Block() != null && NeedleAbsent(row, val)) { return false; }
        return FieldEquals(row.Val(), kid, val);
    }

    /// <summary><see cref="FieldOf"/> 的行视图版：值按需物化，
    /// 走读落在静态字符串路径（物化实测比 ByteBuffer 有状态
    /// 方法逐字节走读便宜）。</summary>
    JsonValue FieldOfRow(ScanRow row, int kid) {
        if (kid == 0) { return null; }
        return FieldOf(row.Val(), kid);
    }

    /// <summary>字段的数值形态（类型化免树）：varint(3/8/9) 直接
    /// 还原、文本数值(4)解析；字符串/布尔/容器/缺字段返回 false
    /// ——聚合只认数值型字段，不做隐式强制。</summary>
    bool FieldNum(string body, int kid, out long v) {
        v = 0;
        if (kid == 0) { return false; }
        if (StrMemChr(body, 255, body.Length) != 0) { body = Collection.UnescapeRecord(body); }
        int p = 1;                     // 'B'
        long n = Collection.RecVarInt(body, p, out p);
        for (int i = 0; i < (int)n; i = i + 1) {
            long k = Collection.RecVarInt(body, p, out p);
            int tag = body[p] & 255;
            if ((int)k == kid) {
                if (tag == 3) { v = Collection.RecVarInt(body, p + 1, out p); return true; }
                if (tag == 8) { v = 0 - Collection.RecVarInt(body, p + 1, out p); return true; }
                if (tag == 9) { return true; }
                if (tag == 4) {
                    long len = Collection.RecVarInt(body, p + 1, out p);
                    v = body.Substring(p, (int)len).ToInt64();
                    return true;
                }
                return false;
            }
            Collection.SkipValS(body, p, out p);
        }
        return false;
    }

    /// <summary>字段的文本形态（免 JsonValue）：字符串(5/10)直接
    /// 取载荷、数值(3/8/9/4)转十进制文本、布尔(1/2)转
    /// "true"/"false"——与 <see cref="JsonValue.AsString"/> 的
    /// 归一化形态一致；null/容器/缺字段返回 null（调用方跳过）。</summary>
    string FieldText(string body, int kid) {
        if (kid == 0) { return null; }
        if (StrMemChr(body, 255, body.Length) != 0) { body = Collection.UnescapeRecord(body); }
        int p = 1;                     // 'B'
        long n = Collection.RecVarInt(body, p, out p);
        for (int i = 0; i < (int)n; i = i + 1) {
            long k = Collection.RecVarInt(body, p, out p);
            int tag = body[p] & 255;
            if ((int)k == kid) {
                if (tag == 5 || tag == 4) {
                    long len = Collection.RecVarInt(body, p + 1, out p);
                    return body.Substring(p, (int)len);
                }
                if (tag == 10) { return ""; }
                if (tag == 3) { return Convert.ToString(Collection.RecVarInt(body, p + 1, out p)); }
                if (tag == 8) { return Convert.ToString(0 - Collection.RecVarInt(body, p + 1, out p)); }
                if (tag == 9) { return "0"; }
                if (tag == 1) { return "false"; }
                if (tag == 2) { return "true"; }
                return null;
            }
            Collection.SkipValS(body, p, out p);
        }
        return null;
    }

    /// <summary>数值字段投影扫描：每条含 field 的文档以 (id, 数值)
    /// 调用一次 visit，不构建任何 JsonValue（varint 直接还原，
    /// 文本数值才解析）；visit 返回 false 提前结束。返回 visit
    /// 被调用的次数。</summary>
    int ScanNumField(string field, NumVisit visit) {
        SyncMeta();
        int kid = KeyIdOf(field);
        if (kid == 0) { return 0; }
        string hi = "c:" + this.name + ";";
        int n = 0;
        this.kv.ScanRows("c:" + this.name + ":", hi, delegate(ScanRow row) {
            long v;
            if (FieldNum(row.Val(), kid, out v)) {
                n = n + 1;
                if (!visit(Collection.IdOfKey(row.Key()), v)) { return false; }
            }
            return true;
        });
        return n;
    }

    /// <summary>文本字段投影扫描：每条含 field 的文档以 (id, 文本)
    /// 调用一次 visit，只物化该字段的字符串（不建 JsonValue 包装）；
    /// visit 返回 false 提前结束。返回 visit 被调用的次数。</summary>
    int ScanStrField(string field, StrVisit visit) {
        SyncMeta();
        int kid = KeyIdOf(field);
        if (kid == 0) { return 0; }
        string hi = "c:" + this.name + ";";
        int n = 0;
        this.kv.ScanRows("c:" + this.name + ":", hi, delegate(ScanRow row) {
            string s = FieldText(row.Val(), kid);
            if (s != null) {
                n = n + 1;
                if (!visit(Collection.IdOfKey(row.Key()), s)) { return false; }
            }
            return true;
        });
        return n;
    }

    /// <summary>数值字段的全文求和：单段稳态走块级聚合内核
    /// （免游标/ScanRow 对象，记录裸走读直累加）；记录含转义
    /// （0xFF）或目标字段是文本数值(4)时逐行回退
    /// <see cref="FieldNum"/> 权威走读，语义与之一致——数值型
    /// 标签直接还原累加，非数值型文档跳过。字段不存在或全非
    /// 数值时返回 0。</summary>
    long SumField(string field) {
        SyncMeta();
        int kid = KeyIdOf(field);
        long sum = 0;
        if (kid == 0) { return 0; }
        string lo = "c:" + this.name + ":";
        string hi = "c:" + this.name + ";";
        // 块级内核路径：每行一次裸走读回调，无对象分配。
        // 遇到需要权威走读的行（转义/文本数值）置 walk 标记，
        // 回调无法"继续扫剩下的行"，故记录已计入内核的行数，
        // 剩余行（含当行）回退 ScanRows——用计数哨兵跳过已聚合行。
        NumAcc acc = new NumAcc();
        bool[] walk = new bool[1];
        long[] skipUntilId = new long[1];
        skipUntilId[0] = -1;
        int kernelN = this.kv.TryScanKernel(lo, hi,
            delegate(nint basePtr, int keyOff, int keyLen, int valOff, int valLen) {
                int id = Collection.IdOfPtr(basePtr + keyOff, keyLen);
                if (id <= skipUntilId[0]) { return true; }
                if (!Collection.RecAccNum(basePtr, valOff, valLen, kid, acc)) {
                    walk[0] = true;
                    skipUntilId[0] = id - 1;
                    return false;
                }
                return true;
            });
        if (kernelN >= 0 && !walk[0]) {
            return acc.Sum();
        }
        if (kernelN >= 0) {
            sum = acc.Sum();
        }
        // 权威路径：字符串走读（全量回退或内核让出的剩余行）。
        string fromKey = kernelN >= 0 ? DocKey((int)skipUntilId[0] + 1) : lo;
        this.kv.ScanRows(fromKey, hi, delegate(ScanRow row) {
            long v;
            if (FieldNum(row.Val(), kid, out v)) { sum = sum + v; }
            return true;
        });
        return sum;
    }

    /// <summary>字段值的分组计数（GROUP BY field 的 COUNT）：
    /// 一遍流式扫描直接在键控结构里聚合，每组只分配一次键字符串。
    /// null/容器/缺字段的文档不计入。索引就绪时零文档读：该索引
    /// 字段的条目键序 = （值, id）序，值相同的条目天然连片——扫
    /// 索引前缀范围、按值切段计数即可。</summary>
    Dictionary<string, int> CountGroups(string field) {
        SyncMeta();
        Dictionary<string, int> groups = new Dictionary<string, int>();
        int kid = KeyIdOf(field);
        if (kid == 0) { return groups; }
        if (IndexReady(field)) {
            // 索引条目键 = "i:{coll}:{kid}:{value}\t{id}"；范围扫该
            // 字段的全部条目，键中 \t 前的部分即组值。单段稳态走
            // 键只读内核：条目（基址+偏移+长）零拷贝交付，值段
            // 直接 memcmp 判同组——同组连片，与上一条同组则免物化
            // 计数，组值只在开新组时物化一次。
            string head = "i:" + this.name + ":" + Collection.PadId(kid) + ":";
            string endKey = "i:" + this.name + ":" + Collection.PadId(kid) + ";";
            int baseLen = head.Length;
            List<string>[] lastVal = new List<string>[1];   // 上一条目组值（单元素数组绕闭包捕获）
            int[] lastCount = new int[1];
            int kernelN = this.kv.TryScanKeyKernel(head, endKey,
                delegate(nint basePtr, int keyOff, int keyLen) {
                    int vStart = keyOff + baseLen;
                    int vLen = 0;
                    for (int i = vStart; i < keyOff + keyLen; i = i + 1) {
                        if (Collection.PeekB(basePtr + i) == 9) { vLen = i - vStart; break; }
                    }
                    if (vLen == 0 && keyOff + keyLen == vStart) { vLen = 0; }
                    bool same = false;
                    if (lastVal[0] != null) {
                        string lv = lastVal[0][0];
                        if (lv.Length == vLen
                                && NativeMemory.Compare(basePtr + vStart, lv, vLen) == 0) {
                            same = true;
                        }
                    }
                    if (same) {
                        lastCount[0] = lastCount[0] + 1;
                        return true;
                    }
                    // 开新组：物化组键（每组一次）。同组连片，上一
                    // 组到此封账。
                    if (lastVal[0] != null) {
                        groups.Add(lastVal[0][0], lastCount[0]);
                    }
                    string nv = NativeMemory.GetString(basePtr, vStart, vLen);
                    lastVal[0] = new List<string>();
                    lastVal[0].Add(nv);
                    lastCount[0] = 1;
                    return true;
                });
            if (kernelN >= 0) {
                if (lastVal[0] != null) { groups.Add(lastVal[0][0], lastCount[0]); }
                return groups;
            }
            // 多源/未固化态：退 KvEntry 字符串路径。
            List<KvEntry> entries = new List<KvEntry>();
            this.kv.ScanRange(head, endKey, 0, entries);
            for (int i = 0; i < entries.Count; i = i + 1) {
                string k = entries[i].key;
                // value 段 = head 之后到 \t 之前；索引值不含 \t。
                int tab = k.IndexOf("\t", baseLen);   // 键内首个 \t = 值段终点
                string val = tab > baseLen ? k.Substring(baseLen, tab - baseLen) : "";
                int c;
                if (groups.TryGetValue(val, out c)) {
                    groups.Remove(val);
                    groups.Add(val, c + 1);
                } else {
                    groups.Add(val, 1);
                }
            }
            return groups;
        }
        string docHi = "c:" + this.name + ";";
        this.kv.ScanRows("c:" + this.name + ":", docHi, delegate(ScanRow row) {
            string s = FieldText(row.Val(), kid);
            if (s != null) {
                int c;
                if (groups.TryGetValue(s, out c)) {
                    groups.Remove(s);
                    groups.Add(s, c + 1);
                } else {
                    groups.Add(s, 1);
                }
            }
            return true;
        });
        return groups;
    }

    /// 把存储的二进制记录（见 <see cref="EncodeDoc"/>）解码回 JsonValue 对象；
    /// "_id" 由调用方从行键附加。
    JsonValue DecodeDoc(string body) {
        if (StrMemChr(body, 255, body.Length) != 0) { body = Collection.UnescapeRecord(body); }
        int p = 1;                     // 'B' = 66
        long n = Collection.RecVarInt(body, p, out p);
        JsonValue o = JsonValue.NewObject();
        for (int i = 0; i < (int)n; i = i + 1) {
            long kid = Collection.RecVarInt(body, p, out p);
            JsonValue v = ReadValS(body, p, out p);
            o.Set(KeyName((int)kid), v);
        }
        return o;
    }

    /// 为每个已索引字段写入该文档的二级索引条目（须在 kv 事务内）。
    void AddIndexEntries(int id, JsonValue doc) {
        for (int i = 0; i < this.indexedFields.Count; i = i + 1) {
            string f = this.indexedFields[i];
            JsonValue v = doc.Get(f);
            if (v != null) {
                this.kv.Put(IdxKey(f, v.AsString(""), id), "");
            }
        }
    }

    /// 删除一篇文档的全部二级索引条目；doc 为 null（文档已不存在）时无事可做。
    void RemoveIndexEntries(int id, JsonValue doc) {
        if (doc == null) { return; }
        for (int i = 0; i < this.indexedFields.Count; i = i + 1) {
            string f = this.indexedFields[i];
            JsonValue v = doc.Get(f);
            if (v != null) {
                this.kv.Delete(IdxKey(f, v.AsString(""), id));
            }
        }
    }

    /// 读取并推进自增 id 序列，返回新分配的 id（须在 kv 事务内）。
    /// seq 值缓存在内存（0 = 未加载）：单写者下没有并发分配者，
    /// 序列键本身仍随本次分配 Put 落盘，崩溃后重开时缓存作废重读。
    /// 省掉每次分配一次 Get——实测它随段数增长，占插入路径大头。
    int NextId() {
        if (this.nextIdCache < 1) {
            string cur = this.kv.Get(SeqKey());
            this.nextIdCache = 1;
            if (cur.Length > 0) { this.nextIdCache = Convert.ToInt(cur) + 1; }
        } else {
            this.nextIdCache = this.nextIdCache + 1;
        }
        this.kv.Put(SeqKey(), Convert.ToString(this.nextIdCache));
        return this.nextIdCache;
    }

    // ===== 缓存池与 CRUD =====

    /// <summary>设置集合的文档缓存池容量（0 为关闭缓存，默认 256）。</summary>
    void SetCacheCapacity(int capacity) {
        if (capacity < 0) { capacity = 0; }
        this.docCacheCapacity = capacity;
        if (capacity == 0) {
            ClearCache();
        } else {
            int pruneMax = this.docCacheOrder.Count;
            for (int i = 0; i < pruneMax; i = i + 1) {
                if (this.docCacheOrder.Count <= this.docCacheCapacity) { break; }
                int evictId = this.docCacheOrder[0];
                this.docCacheOrder.RemoveAt(0);
                this.docCache.Remove(evictId);
            }
        }
    }

    /// <summary>获取当前集合文档缓存池的缓存容量。</summary>
    int GetCacheCapacity() { return this.docCacheCapacity; }

    /// <summary>获取当前集合文档缓存池中已缓存的文档数。</summary>
    int CachedDocCount() { return this.docCache.Count; }

    /// <summary>清空文档缓存池。</summary>
    void ClearCache() {
        this.docCache.Clear();
        this.docCacheOrder.Clear();
    }

    /// <summary>从文档缓存中获取文档，若存在则更新 LRU 访问热度并返回其只读副本。</summary>
    JsonValue CacheGet(int id) {
        if (this.docCacheCapacity <= 0 || !this.docCache.ContainsKey(id)) {
            JsonValue miss = null;
            return miss;
        }
        int lastIdx = this.docCacheOrder.Count - 1;
        if (lastIdx >= 0 && this.docCacheOrder[lastIdx] != id) {
            for (int i = 0; i < this.docCacheOrder.Count; i = i + 1) {
                if (this.docCacheOrder[i] == id) {
                    this.docCacheOrder.RemoveAt(i);
                    this.docCacheOrder.Add(id);
                    break;
                }
            }
        }
        return this.docCache[id];
    }

    /// <summary>将文档放入 LRU 缓存池；超过容量时淘汰最久未访问的条目。</summary>
    void CachePut(int id, JsonValue doc) {
        if (this.docCacheCapacity <= 0 || doc == null) { return; }
        if (this.docCache.ContainsKey(id)) {
            this.docCache[id] = doc.Clone();
            int lastIdx = this.docCacheOrder.Count - 1;
            if (lastIdx >= 0 && this.docCacheOrder[lastIdx] != id) {
                for (int i = 0; i < this.docCacheOrder.Count; i = i + 1) {
                    if (this.docCacheOrder[i] == id) {
                        this.docCacheOrder.RemoveAt(i);
                        this.docCacheOrder.Add(id);
                        break;
                    }
                }
            }
            return;
        }
        if (this.docCacheOrder.Count >= this.docCacheCapacity && this.docCacheOrder.Count > 0) {
            int evictId = this.docCacheOrder[0];
            this.docCacheOrder.RemoveAt(0);
            this.docCache.Remove(evictId);
        }
        this.docCache[id] = doc.Clone();
        this.docCacheOrder.Add(id);
    }

    /// <summary>从缓存池中显式失效指定文档。</summary>
    void CacheEvict(int id) {
        if (this.docCacheCapacity <= 0) { return; }
        if (this.docCache.ContainsKey(id)) {
            this.docCache.Remove(id);
            for (int i = 0; i < this.docCacheOrder.Count; i = i + 1) {
                if (this.docCacheOrder[i] == id) {
                    this.docCacheOrder.RemoveAt(i);
                    break;
                }
            }
        }
    }

    /// <summary>存储新文档，分配并返回其 _id
    /// （同时写入文档中）。</summary>
    int Insert(JsonValue doc) {
        this.kv.Begin();
        SyncMeta();
        int id = NextId();
        doc.Set("_id", JsonValue.NewNum(Convert.ToString(id)));
        this.kv.Put(DocKey(id), EncodeDoc(doc));
        AddIndexEntries(id, doc);
        this.kv.Commit();
        this.metaVersion = this.kv.Version();
        CachePut(id, doc);
        return id;
    }

    /// <summary>在单个原子提交中批量插入（整个批次
    /// 只做一次 WAL 刷新）。返回第一个分配的 id。</summary>
    int InsertBulk(List<JsonValue> docs) {
        this.kv.Begin();
        SyncMeta();
        int first = 0;
        for (int i = 0; i < docs.Count; i = i + 1) {
            int id = NextId();
            if (first == 0) { first = id; }
            docs[i].Set("_id", JsonValue.NewNum(Convert.ToString(id)));
            this.kv.Put(DocKey(id), EncodeDoc(docs[i]));
            AddIndexEntries(id, docs[i]);
        }
        this.kv.Commit();
        this.metaVersion = this.kv.Version();
        for (int i = 0; i < docs.Count; i = i + 1) {
            int cid = first + i;
            CachePut(cid, docs[i]);
        }
        return first;
    }

    /// <summary>返回文档；优先走内存 LRU Buffer Pool，未命中则反序列化；不存在则返回 null。</summary>
    JsonValue FindById(int id) {
        SyncMeta();
        JsonValue cached = CacheGet(id);
        if (cached != null) {
            return cached.Clone();
        }
        string body = this.kv.Get(DocKey(id));
        JsonValue doc = null;
        if (body.Length > 0) {
            doc = DecodeDoc(body);
            doc.Set("_id", JsonValue.NewNum(Convert.ToString(id)));
            CachePut(id, doc);
            return doc.Clone();
        }
        return doc;
    }

    /// 文档 id 是否存在。
    bool Exists(int id) { return this.kv.Contains(DocKey(id)); }

    /// <summary>替换现有文档；id 不存在时返回 false。</summary>
    bool Update(int id, JsonValue doc) {
        if (!this.kv.Contains(DocKey(id))) { return false; }
        this.kv.Begin();
        SyncMeta();
        if (this.indexedFields.Count > 0) { RemoveIndexEntries(id, FindById(id)); }
        doc.Set("_id", JsonValue.NewNum(Convert.ToString(id)));
        this.kv.Put(DocKey(id), EncodeDoc(doc));
        AddIndexEntries(id, doc);
        this.kv.Commit();
        this.metaVersion = this.kv.Version();
        CachePut(id, doc);
        return true;
    }

    /// <summary>在显式 id 下插入或替换。推进自增 id
    /// 序列越过该 id，避免后续插入冲突。</summary>
    void Upsert(int id, JsonValue doc) {
        this.kv.Begin();
        SyncMeta();
        string cur = this.kv.Get(SeqKey());
        int seq = 0;
        if (cur.Length > 0) { seq = Convert.ToInt(cur); }
        if (id > seq) {
            this.kv.Put(SeqKey(), Convert.ToString(id));
            // 序列缓存与此处绕过 NextId 的推进保持一致
            //（缓存语义 = 已落盘的序列值；已分配 id 不回退）。
            if (this.nextIdCache < id) { this.nextIdCache = id; }
        }
        if (this.indexedFields.Count > 0 && this.kv.Contains(DocKey(id))) {
            RemoveIndexEntries(id, FindById(id));
        }
        doc.Set("_id", JsonValue.NewNum(Convert.ToString(id)));
        this.kv.Put(DocKey(id), EncodeDoc(doc));
        AddIndexEntries(id, doc);
        this.kv.Commit();
        this.metaVersion = this.kv.Version();
        CachePut(id, doc);
    }

    /// 删除文档及其索引条目；返回该 id 是否原本存在。
    bool DeleteById(int id) {
        this.kv.Begin();
        SyncMeta();
        if (this.indexedFields.Count > 0) { RemoveIndexEntries(id, FindById(id)); }
        bool existed = this.kv.Delete(DocKey(id));
        this.kv.Commit();
        this.metaVersion = this.kv.Version();
        if (existed) {
            CacheEvict(id);
        }
        return existed;
    }

    // ===== 二级索引 =====

    /// 把索引字段列表写回元数据键（须在 kv 事务内）。
    void PersistIndexMeta() {
        string meta = "";
        for (int i = 0; i < this.indexedFields.Count; i = i + 1) {
            if (i > 0) { meta = meta + ","; }
            meta = meta + this.indexedFields[i];
        }
        this.kv.Put(IdxMetaKey(), meta);
    }

    /// <summary>为字段创建（或重建）二级索引，按有界批次
    /// 索引现有文档。后续写入会自动维护。
    /// 中断的构建会继续执行，而不是
    /// 重新开始。</summary>
    void EnsureIndex(string field) {
        EnsureIndex(field, Collection.INDEX_BATCH);
    }

    /// <summary>带显式批次大小的 EnsureIndex（每
    /// 个事务处理的文档数）。</summary>
    void EnsureIndex(string field, int batchSize) {
        bool done = false;
        while (!done) { done = BuildIndexStep(field, batchSize); }
    }

    /// <summary>索引下一批文档，每次调用一个事务，
    /// 覆盖整个集合后返回 true。
    ///
    /// 在单个事务中为大集合构建索引会把
    /// 每个触及的页固定到提交为止，并在整个构建期间持有
    /// 跨进程写锁；分批将两者都限制在界内。游标
    /// （m:{name}:idxpos:{field}）与它所覆盖的条目属于同一提交，
    /// 因此构建中途崩溃或被杀死不会丢失任何内容，下次调用
    /// 会从上次提交的位置继续。
    ///
    /// 字段在第一批就加入索引列表，因此并发写入者
    /// （包括其他进程）已经在为构建尚未到达的
    /// 文档维护条目；这些写入与构建结果一致，因为两者都
    /// 从同一篇文档派生出条目。在构建完成前，
    /// IndexReady 为 false，FindByIndex 回退为扫描，因此不完整的
    /// 索引绝不会产生不完整的结果。</summary>
    bool BuildIndexStep(string field, int batchSize) {
        if (batchSize <= 0) { batchSize = Collection.INDEX_BATCH; }
        this.kv.Begin();
        SyncMeta();
        if (!HasIndex(field)) {
            this.indexedFields.Add(field);
            PersistIndexMeta();
        }
        int from = 0;
        string cursor = this.kv.Get(IdxPosKey(field));
        if (cursor.Length > 0) {
            // 文档 id 本身是 int（DocKey 的参数类型）；显式收窄，
            // 解析已升为 long 只是为了正确读出历史 18 位游标。
            from = (int)(Collection.ParseI64(cursor) + 1);
        }
        // 只从每条记录中读取被索引的字段：构建索引
        // 永远不需要文档的其他部分。
        List<KvEntry> entries = new List<KvEntry>();
        this.kv.ScanRange(DocKey(from), "c:" + this.name + ";", batchSize, entries);
        int kid = KeyIdOf(field);
        int last = from;
        for (int i = 0; i < entries.Count; i = i + 1) {
            int id = Collection.IdOfKey(entries[i].key);
            JsonValue f = FieldOf(entries[i].val, kid);
            if (f != null) {
                this.kv.Put(IdxKey(field, f.AsString(""), id), "");
            }
            if (id > last) { last = id; }
        }
        bool done = entries.Count < batchSize;
        if (done) { this.kv.Delete(IdxPosKey(field)); }
        else { this.kv.Put(IdxPosKey(field), Convert.ToString(last)); }
        this.kv.Commit();
        return done;
    }

    /// 字段是否已在索引列表中（含批量构建尚未完成的）。
    bool HasIndex(string field) {
        for (int i = 0; i < this.indexedFields.Count; i = i + 1) {
            if (this.indexedFields[i] == field) { return true; }
        }
        return false;
    }

    /// <summary>当字段已被索引且其批次构建
    /// 完成（即索引覆盖所有文档）时为 true。</summary>
    bool IndexReady(string field) {
        SyncMeta();
        return HasIndex(field) && !this.kv.Contains(IdxPosKey(field));
    }

    /// <summary>索引查找：字段等于 val（字符串形式）的文档，
    /// 通过二级索引实现——无需全表扫描。索引仍在构建时
    /// 回退为扫描，因此结果总是完整的。</summary>
    List<JsonValue> FindByIndex(string field, string val) {
        SyncMeta();
        List<JsonValue> docs = new List<JsonValue>();
        if (HasIndex(field) && !this.kv.Contains(IdxPosKey(field))) {
            List<KvEntry> entries = new List<KvEntry>();
            this.kv.ScanPrefix(IdxPrefix(field, val), 0, entries);
            for (int i = 0; i < entries.Count; i = i + 1) {
                JsonValue d = FindById(Collection.IdOfKey(entries[i].key));
                if (d != null) { docs.Add(d); }
            }
            return docs;
        }
        return FindByFieldScan(field, val);
    }

    /// <summary>通过扫描找出字段等于 val 的文档：每条
    /// 记录只被询问这一个字段（字符串值走零分配比较），
    /// 只有匹配项会被完整解码，全程流式。用于字段没有
    /// 可用索引的情况。</summary>
    List<JsonValue> FindByFieldScan(string field, string val) {
        SyncMeta();
        List<JsonValue> docs = new List<JsonValue>();
        int kid = KeyIdOf(field);
        if (kid == 0) {
            return docs;
        }
        bool fastReject = EqFastReject(val);
        string hi = "c:" + this.name + ";";
        this.kv.ScanRows("c:" + this.name + ":", hi, delegate(ScanRow row) {
            if (FieldEqualsRow(row, kid, val, fastReject)) {
                JsonValue doc = DecodeDoc(row.Val());
                doc.Set("_id", JsonValue.NewNum(Collection.IdFromKey(row.Key())));
                docs.Add(doc);
            }
            return true;
        });
        return docs;
    }

    /// <summary>字段值等于 val 的文档数，无需具体化
    /// 任何文档：字符串值零分配比较，全程流式计数。</summary>
    int CountByField(string field, string val) {
        SyncMeta();
        int n = 0;
        if (HasIndex(field) && !this.kv.Contains(IdxPosKey(field))) {
            // 已就绪的索引仅凭其键即可作答：无需读取任何文档。
            List<KvEntry> entries = new List<KvEntry>();
            return this.kv.ScanPrefix(IdxPrefix(field, val), 0, entries);
        }
        int kid = KeyIdOf(field);
        if (kid == 0) {
            return 0;
        }
        bool fastReject = EqFastReject(val);
        string hi = "c:" + this.name + ";";
        this.kv.ScanRows("c:" + this.name + ":", hi, delegate(ScanRow row) {
            if (FieldEqualsRow(row, kid, val, fastReject)) { n = n + 1; }
            return true;
        });
        return n;
    }

    /// <summary>文档总数（命名空间的键范围直数）。上界判定
    /// 与存活判定都在存储层循环内，无回调、大集合不按文档数分配。</summary>
    int Count() {
        return this.kv.CountRange("c:" + this.name + ":", "c:" + this.name + ";");
    }

    /// <summary>裸记录走读（静态、免 this）：从记录起始位置解析
    /// 'B' + VarInt(字段数) + (VarInt(kid) + 值)*，对每个 kid==want
    /// 的数值字段（tag 3/8/9/4）累加进 agg。tag 语义与
    /// <see cref="FieldNum"/> 一致；basePtr 指向键起点（值在
    /// basePtr+valOff）。返回 false = 记录含转义（0xFF）或格式
    /// 异常，调用方须回退权威走读。</summary>
    static bool RecAccNum(nint basePtr, int valOff, int valLen, int want, NumAcc acc) {
        nint v = basePtr + valOff;
        // 记录首字节必须是 'B'(66)。
        int b0 = Collection.PeekB(v);
        if (b0 != 66) { return false; }
        // 含 0xFF 的记录是转义态（0x00→FF 01、0xFF→FF 02，见
        // EncodeDoc）：裸字节不再是 varint/tag 的原始编码，逐字段
        // 走读会读出加大的假值。一次 memchr 检出即回退权威走读
        // （FieldNum 的 UnescapeRecord 先行反转义）。文本记录几乎
        // 总不含 0xFF，常态无此开销。
        if (Collection.MemChr(v, 255, valLen) != 0) { return false; }
        int p = valOff + 1;
        long n = Collection.ReadVarIntRaw(basePtr, ref p, valOff + valLen);
        if (n < 0 || n > 4096) { return false; }
        int end = valOff + valLen;
        for (int i = 0; i < (int)n; i = i + 1) {
            long kid = Collection.ReadVarIntRaw(basePtr, ref p, end);
            if (kid < 0) { return false; }
            // tag 只消费一次：want 命中分支自己读；跳过分支由
            // SkipValRaw 读（p 仍指向 tag——与 FieldNum 调
            // SkipValS 的契约一致）。预读再跳会导致 SkipValRaw
            // 把长度/载荷字节当 tag， kid/tag 全线错位。
            if ((int)kid == want) {
                if (p >= end) { return false; }
                int tag = Collection.PeekB(basePtr + p);
                p = p + 1;
                if (tag == 3) {
                    long x = Collection.ReadVarIntRaw(basePtr, ref p, end);
                    if (x < 0) { return false; }
                    acc.Add(x);
                    return true;
                }
                if (tag == 8) {
                    long x = Collection.ReadVarIntRaw(basePtr, ref p, end);
                    if (x < 0) { return false; }
                    acc.Add(0 - x);
                    return true;
                }
                if (tag == 9) { acc.Add(0); return true; }
                return false;   // 文本数值/非数值：交给权威走读兜底
            }
            // 跳过该值：按标签长度规则推进（含容器递归长度，用
            // 栈式计数实现，免递归调用）。
            if (!Collection.SkipValRaw(basePtr, ref p, end)) { return false; }
        }
        return true;
    }

    /// 块级聚合的数值累加器：sum/count/min/max 由调用方按需取用。
    class NumAcc {
        long sum;
        long count;
        long min;
        long max;
        internal void Add(long v) {
            this.sum = this.sum + v;
            this.count = this.count + 1;
            if (this.count == 1 || v < this.min) { this.min = v; }
            if (this.count == 1 || v > this.max) { this.max = v; }
        }
        internal long Sum() { return this.sum; }
        internal long Count() { return this.count; }
        internal long Min() { return this.min; }
        internal long Max() { return this.max; }
    }

    /// <summary><see cref="FieldEquals"/> 的裸指针版（内核回调用，
    /// 免整串物化）：记录含 0xFF（转义态）或格式异常返回 -1（调用
    /// 方回退权威路径）；tag 5 字符串值按长度 + memcmp 零分配比较，
    /// 数值/布尔等非字符串类型返回 -2（走权威 AsString 语义），
    /// 字段缺失返回 0。1 = 字段值等于 val。</summary>
    static int FieldEqualsPtr(nint basePtr, int valOff, int valLen, int kid, string val) {
        nint v = basePtr + valOff;
        int b0 = Collection.PeekB(v);
        if (b0 != 66) { return -1; }
        if (Collection.MemChr(v, 255, valLen) != 0) { return -1; }
        int p = valOff + 1;
        int end = valOff + valLen;
        long n = Collection.ReadVarIntRaw(basePtr, ref p, end);
        if (n < 0 || n > 4096) { return -1; }
        for (int i = 0; i < (int)n; i = i + 1) {
            long k = Collection.ReadVarIntRaw(basePtr, ref p, end);
            if (k < 0) { return -1; }
            if (p >= end) { return -1; }
            int tag = Collection.PeekB(basePtr + p);
            p = p + 1;
            if ((int)k == kid) {
                if (tag == 5) {
                    long len = Collection.ReadVarIntRaw(basePtr, ref p, end);
                    if (len < 0 || p + (int)len > end) { return -1; }
                    if (len != val.Length) { return 0; }
                    if (NativeMemory.Compare(basePtr + p, val, (int)len) != 0) { return 0; }
                    return 1;
                }
                // 整数（3/8/9）：val 是 AsString 归一化形态（十进制
                // 文本），解析后直接比 varint——数值字段等值不走
                // 权威回退（等值过滤最常见形态之一）。
                if (tag == 3 || tag == 8 || tag == 9) {
                    if (!Collection.IsIntStr(val)) { return -2; }
                    long want = Collection.ParseI64(val);
                    if (tag == 9) { return want == 0 ? 1 : 0; }
                    long x = Collection.ReadVarIntRaw(basePtr, ref p, end);
                    if (x < 0) { return -1; }
                    if (tag == 8) { x = 0 - x; }
                    return x == want ? 1 : 0;
                }
                // 布尔："true"/"false" 字面等值。
                if (tag == 1 || tag == 2) {
                    if (val == "true" && tag == 2) { return 1; }
                    if (val == "false" && tag == 1) { return 1; }
                    return 0;
                }
                return -2;   // 文本数值/空串/容器：As 归一化语义交权威
            }
            if (!Collection.SkipValRaw(basePtr, ref p, end)) { return -1; }
        }
        return 0;
    }

    /// 读取裸指针处一个字节；offset 为相对位移。
    static int PeekB(nint p) {
        Span<byte> sp = new Span<byte>(p, 1);
        return sp[0] & 255;
    }

    /// <summary>裸指针 LEB128 varint 读取：自 base+p 起解析，
    /// 结束位置写回 p（引用传参），limit 为缓冲绝对终点。越界
    /// 返回 -1。与 ByteBuffer.ReadVarIntAt 同格式。</summary>
    static long ReadVarIntRaw(nint basePtr, ref int p, int limit) {
        long result = 0;
        int shift = 0;
        while (true) {
            if (p >= limit) { return -1; }
            int b = Collection.PeekB(basePtr + p);
            p = p + 1;
            result = result + ((long)(b & 127) << shift);
            if ((b & 128) == 0) { break; }
            shift = shift + 7;
            if (shift > 63) { return -1; }
        }
        return result;
    }

    /// <summary>裸指针跳过一个编码值（标签已读、p 指向标签后）：
    /// 与 <see cref="SkipValS"/> 同规则，数组/对象载荷含嵌套时
    /// 返回 false 回退权威走读（数值聚合场景容器字段罕见）。
    /// 推进失败返回 false。</summary>
    static bool SkipValRaw(nint basePtr, ref int p, int end) {
        if (p >= end) { return false; }
        int tag = Collection.PeekB(basePtr + p);
        p = p + 1;
        if (tag == 3 || tag == 8) {
            return Collection.ReadVarIntRaw(basePtr, ref p, end) >= 0;
        }
        if (tag == 4 || tag == 5) {
            long n = Collection.ReadVarIntRaw(basePtr, ref p, end);
            if (n < 0 || p + (int)n > end) { return false; }
            p = p + (int)n;
            return true;
        }
        // 标签 0/1/2/9/10 无载荷；6 数组/7 对象含嵌套结构，
        // 裸走读不展开——回退权威路径。
        return tag == 0 || tag == 1 || tag == 2 || tag == 9 || tag == 10;
    }

    /// <summary>按 id 顺序返回所有文档。</summary>
    List<JsonValue> FindAll() {
        return FindRange(0, 0, 0);
    }

    /// <summary>满足 fromId <= _id <= toId 的文档（0 表示无界），
    /// limit 0 表示不限数量，按 id 顺序返回。</summary>
    List<JsonValue> FindRange(int fromId, int toId, int limit) {
        SyncMeta();
        string lo = DocKey(fromId);
        string hi = "";
        if (toId > 0) { hi = DocKey(toId); }
        else { hi = "c:" + this.name + ";"; }   // ';' 的排序紧随 ':' 之后
        // 流式解码：扫描回调里直接建文档树，不经 KvEntry 中间层；
        // 上界由存储层判定。
        List<JsonValue> docs = new List<JsonValue>();
        this.kv.ScanBetween(lo, hi, delegate(string k, string v) {
            JsonValue doc = DecodeDoc(v);
            doc.Set("_id", JsonValue.NewNum(Convert.ToString(Collection.IdOfKey(k))));
            docs.Add(doc);
            return limit <= 0 || docs.Count < limit;
        });
        return docs;
    }

    /// <summary>投影式扫描：按 id 序遍历集合，每篇含 field 的文档
    /// 以 (id, 值) 调用一次 visit；visit 返回 false 提前结束。
    /// 每条记录只解码这一个字段——值留在块内按偏移解析，不构建
    /// 文档树、不物化文档，单字段聚合/过滤的每文档成本与文档的
    /// 字段数无关。返回 visit 被调用的次数。</summary>
    int ScanField(string field, FieldVisit visit) {
        SyncMeta();
        int kid = KeyIdOf(field);
        if (kid == 0) { return 0; }
        string hi = "c:" + this.name + ";";
        int n = 0;
        this.kv.ScanRows("c:" + this.name + ":", hi, delegate(ScanRow row) {
            JsonValue f = FieldOfRow(row, kid);
            if (f != null) {
                n = n + 1;
                if (!visit(Collection.IdOfKey(row.Key()), f)) { return false; }
            }
            return true;
        });
        return n;
    }

    /// <summary>字段值等于 val 的所有文档 id，按 id 序。
    /// 索引就绪时只扫索引条目（覆盖索引，一个文档都不读）；
    /// 否则流式扫描、每条记录只解码这一个字段（零拷贝），
    /// 匹配才物化键收 id——全程不构建文档树。</summary>
    List<int> FindIdsByField(string field, string val) {
        SyncMeta();
        List<int> ids = new List<int>();
        if (HasIndex(field) && !this.kv.Contains(IdxPosKey(field))) {
            List<KvEntry> entries = new List<KvEntry>();
            this.kv.ScanPrefix(IdxPrefix(field, val), 0, entries);
            for (int i = 0; i < entries.Count; i = i + 1) {
                ids.Add(Collection.IdOfKey(entries[i].key));
            }
            return ids;
        }
        int kid = KeyIdOf(field);
        if (kid == 0) { return ids; }
        string lo = "c:" + this.name + ":";
        string hi = "c:" + this.name + ";";
        bool fastReject = EqFastReject(val);
        // 内核路径：单段稳态下裸走读等值判定，字符串值零分配
        // memcmp；针线否证先挡掉大多数不匹配行。命中行才物化键。
        int[] fallbackId = new int[1];
        fallbackId[0] = -1;
        bool[] walk = new bool[1];
        int[] needleState = new int[1];
        needleState[0] = fastReject ? 1 : 0;   // 1 = 需要先试针线否证
        int kernelN = this.kv.TryScanKernel(lo, hi,
            delegate(nint basePtr, int keyOff, int keyLen, int valOff, int valLen) {
                int id = Collection.IdOfPtr(basePtr + keyOff, keyLen);
                if (id <= fallbackId[0]) { return true; }
                if (needleState[0] == 1) {
                    // EqFastReject 前提下：needle 原字节不在值区即否决。
                    nint vp = basePtr + valOff;
                    if (valLen < val.Length) { return true; }
                    nint hit = MemChr(vp, val[0] & 255, valLen);
                    bool present = false;
                    while (hit != 0) {
                        long off = (long)(hit - vp);
                        if (off + val.Length <= valLen
                                && NativeMemory.Compare(hit, val, val.Length) == 0) {
                            present = true;
                            break;
                        }
                        hit = MemChr(hit + 1, val[0] & 255, (int)(valLen - off - 1));
                    }
                    if (!present) { return true; }
                }
                int r = Collection.FieldEqualsPtr(basePtr, valOff, valLen, kid, val);
                if (r >= 0) {
                    if (r == 1) { ids.Add(id); }
                    return true;
                }
                // -1 转义/格式异常 或 -2 非字符串类型：该行起回退
                // 权威走读（含当行）。
                walk[0] = true;
                fallbackId[0] = id;
                return false;
            });
        if (kernelN >= 0 && !walk[0]) { return ids; }
        if (kernelN >= 0 && fallbackId[0] >= 0) {
            // 内核已收集 fallbackId 之前（不含）的命中；剩余行走
            // 权威路径。
            string fromKey = DocKey(fallbackId[0]);
            this.kv.ScanRows(fromKey, hi, delegate(ScanRow row) {
                if (FieldEqualsRow(row, kid, val, fastReject)) {
                    ids.Add(Collection.IdOfKey(row.Key()));
                }
                return true;
            });
            return ids;
        }
        this.kv.ScanRows(lo, hi, delegate(ScanRow row) {
            if (FieldEqualsRow(row, kid, val, fastReject)) {
                ids.Add(Collection.IdOfKey(row.Key()));
            }
            return true;
        });
        return ids;
    }

    /// <summary>字段值落在 [lo, hi]（双端含）的所有文档 id。
    /// 索引就绪时走索引键序范围扫（覆盖索引，一个文档都不读，
    /// 成本与等值覆盖查询同量级），结果按（值, id）序；无索引则
    /// 流式扫描按 id 序。比较语义：字段值 AsString 形态的**序数**
    /// 比较——数字按十进制文本比（"9" &gt; "20"），范围端点与索引
    /// 值不应含 &lt; \t 的控制字符。lo 为空串 = 无下界，hi 为空串 =
    /// 无上界。</summary>
    List<int> FindIdsByFieldRange(string field, string lo, string hi) {
        SyncMeta();
        List<int> ids = new List<int>();
        int kid = KeyIdOf(field);
        if (kid == 0) { return ids; }
        if (HasIndex(field) && !this.kv.Contains(IdxPosKey(field))) {
            string head = "i:" + this.name + ":" + Collection.PadId(kid) + ":";
            string startKey = head + lo + "\t";
            string endKey;
            if (hi.Length > 0) {
                // 上界钉在 \t 后的 6 个 '~'（id 段每字符 ≤ '~'）：
                // 收尽 hi 本值的全部条目，且不放进 hi 的任何扩展值
                //（"c1" 不放进 "c10"——'\t'(9) < '0'(48)）。
                endKey = head + hi + "\t~~~~~~";
            } else {
                // 无上界：该索引字段的段尾（';' 排在 ':' 之后）。
                endKey = "i:" + this.name + ":" + Collection.PadId(kid) + ";";
            }
            List<KvEntry> entries = new List<KvEntry>();
            this.kv.ScanRange(startKey, endKey, 0, entries);
            for (int i = 0; i < entries.Count; i = i + 1) {
                ids.Add(Collection.IdOfKey(entries[i].key));
            }
            return ids;
        }
        string docHi = "c:" + this.name + ";";
        this.kv.ScanRows("c:" + this.name + ":", docHi, delegate(ScanRow row) {
            JsonValue f = FieldOfRow(row, kid);
            if (f != null) {
                string s = f.AsString("");
                if ((lo.Length == 0 || String.CompareOrdinal(s, lo) >= 0)
                        && (hi.Length == 0 || String.CompareOrdinal(s, hi) <= 0)) {
                    ids.Add(Collection.IdOfKey(row.Key()));
                }
            }
            return true;
        });
        return ids;
    }

    /// <summary>数值聚合的公共骨架：单段稳态先走块级内核
    /// （RecAccNum 裸走读，语义同 FieldNum 的数值标签判定），
    /// 内核路径遇到需权威处理的行（转义 0xFF/文本数值/格式
    /// 异常/容器）时以「已聚合到 id-1」为界，剩余行回退
    /// <see cref="ScanRows"/> 字符串路径，sum 与 min/max 在两段
    /// 之间保持一致。返回 false = 内核不可用（多源/未固化数据），
    /// 调用方直接全量走权威路径。</summary>
    bool NumAggregate(string field, NumAcc acc, out int fromId) {
        fromId = 0;
        int kid = KeyIdOf(field);
        if (kid == 0) { return true; }
        string lo = "c:" + this.name + ":";
        string hi = "c:" + this.name + ";";
        int[] fallbackId = new int[1];
        fallbackId[0] = -1;
        bool[] walk = new bool[1];
        int kernelN = this.kv.TryScanKernel(lo, hi,
            delegate(nint basePtr, int keyOff, int keyLen, int valOff, int valLen) {
                int id = Collection.IdOfPtr(basePtr + keyOff, keyLen);
                if (id <= fallbackId[0]) { return true; }
                if (!Collection.RecAccNum(basePtr, valOff, valLen, kid, acc)) {
                    walk[0] = true;
                    fallbackId[0] = id;   // 该行起（含）回退权威走读
                    return false;
                }
                return true;
            });
        if (kernelN < 0) { return false; }
        fromId = walk[0] ? fallbackId[0] : 0;
        if (!walk[0]) { return true; }
        // 内核让出部分行：剩余行走权威路径（有界：本集合段内）。
        this.kv.ScanRows(DocKey(fromId), hi, delegate(ScanRow row) {
            long x;
            if (FieldNum(row.Val(), kid, out x)) { acc.Add(x); }
            return true;
        });
        return true;
    }

    /// <summary>数值字段的最小值：块级内核直算（带权威回退），
    /// 无 JsonValue；无数值文档时返回 false。out 参数被闭包捕获
    /// 时不回传（捕获的是副本），先累计到局部变量、扫完再写回。</summary>
    bool MinField(string field, out long v) {
        v = 0;
        int kid = KeyIdOf(field);
        if (kid == 0) { return false; }
        bool has = false;
        long acc = 0;
        string hi = "c:" + this.name + ";";
        NumAcc a = new NumAcc();
        int fromId;
        bool ok = NumAggregate(field, a, out fromId);
        if (ok && a.Count() > 0) {
            v = a.Min();
            return true;
        }
        // 内核不可用（多源/未固化数据）：全量权威路径。
        this.kv.ScanRows("c:" + this.name + ":", hi, delegate(ScanRow row) {
            long x;
            if (FieldNum(row.Val(), kid, out x)) {
                if (!has || x < acc) { acc = x; has = true; }
            }
            return true;
        });
        if (has) { v = acc; }
        return has;
    }

    /// <summary>数值字段的最大值：块级内核直算（带权威回退），
    /// 无 JsonValue；无数值文档时返回 false。</summary>
    bool MaxField(string field, out long v) {
        v = 0;
        int kid = KeyIdOf(field);
        if (kid == 0) { return false; }
        bool has = false;
        long acc = 0;
        string hi = "c:" + this.name + ";";
        NumAcc a = new NumAcc();
        int fromId;
        bool ok = NumAggregate(field, a, out fromId);
        if (ok && a.Count() > 0) {
            v = a.Max();
            return true;
        }
        this.kv.ScanRows("c:" + this.name + ":", hi, delegate(ScanRow row) {
            long x;
            if (FieldNum(row.Val(), kid, out x)) {
                if (!has || x > acc) { acc = x; has = true; }
            }
            return true;
        });
        if (has) { v = acc; }
        return has;
    }

    /// <summary>数值字段的平均值：一遍流式同时累计和与计数
    /// （块级内核，带权威回退）；无数值文档时返回 0。</summary>
    double AvgField(string field) {
        int kid = KeyIdOf(field);
        if (kid == 0) { return 0.0; }
        NumAcc a = new NumAcc();
        int fromId;
        bool ok = NumAggregate(field, a, out fromId);
        if (ok) {
            return a.Count() == 0 ? 0.0 : (double)a.Sum() / (double)a.Count();
        }
        long sum = 0;
        long cnt = 0;
        string hi = "c:" + this.name + ";";
        this.kv.ScanRows("c:" + this.name + ":", hi, delegate(ScanRow row) {
            long x;
            if (FieldNum(row.Val(), kid, out x)) {
                sum = sum + x;
                cnt = cnt + 1;
            }
            return true;
        });
        if (cnt == 0) { return 0.0; }
        return (double)sum / (double)cnt;
    }

    /// <summary>数值字段 TopN：按字段值降序的前 n 个文档 id
    /// （等值时 id 小者在前）。容量有界的最小堆流式筛选——堆里
    /// 只驻留 n 项，内存 O(n) 与文档数无关；非数值/缺字段文档
    /// 不参与。n ≤ 0 返回空表。排行榜类负载免全排序。</summary>
    List<int> FindTopIds(string field, int n) {
        List<int> tops = new List<int>();
        if (n <= 0) { return tops; }
        int kid = KeyIdOf(field);
        if (kid == 0) { return tops; }
        List<long> heapVal = new List<long>();
        List<int> heapId = new List<int>();
        string hi = "c:" + this.name + ";";
        this.kv.ScanRows("c:" + this.name + ":", hi, delegate(ScanRow row) {
            long v;
            if (FieldNum(row.Val(), kid, out v)) {
                int id = Collection.IdOfKey(row.Key());
                if (heapVal.Count < n) {
                    HeapPush(heapVal, heapId, v, id);
                } else if (ZanCollectionBetter(v, id, heapVal[0], heapId[0])) {
                    // 比堆顶（当前第 n 名）更好：换根后下沉。
                    heapVal[0] = v;
                    heapId[0] = id;
                    HeapSiftDown(heapVal, heapId);
                }
            }
            return true;
        });
        // 堆内 n 项做选择式输出（n 小，O(n²) 可忽略）：反复取最优。
        int total = heapVal.Count;
        for (int out2 = 0; out2 < total; out2 = out2 + 1) {
            int best = 0;
            for (int i = 1; i < heapVal.Count; i = i + 1) {
                if (ZanCollectionBetter(heapVal[i], heapId[i], heapVal[best], heapId[best])) {
                    best = i;
                }
            }
            tops.Add(heapId[best]);
            heapVal.RemoveAt(best);
            heapId.RemoveAt(best);
        }
        return tops;
    }

    /// 候选 (va,ia) 是否优于 (vb,ib)：值大者优；等值 id 小者优。
    static bool ZanCollectionBetter(long va, int ia, long vb, int ib) {
        if (va != vb) { return va > vb; }
        return ia < ib;
    }

    // 堆不变量：父节点"不优于"子节点（worst-at-top）——根永远是
    // 当前保留集里第 n 名，替换判定只跟根比较。
    static void HeapPush(List<long> hv, List<int> hi, long v, int id) {
        hv.Add(v);
        hi.Add(id);
        int c = hv.Count - 1;
        while (c > 0) {
            int p = (c - 1) / 2;
            // 父优于子 → 违例，差的上浮。
            if (ZanCollectionBetter(hv[p], hi[p], hv[c], hi[c])) {
                long tv = hv[c]; hv[c] = hv[p]; hv[p] = tv;
                int ti = hi[c]; hi[c] = hi[p]; hi[p] = ti;
                c = p;
            } else { break; }
        }
    }

    static void HeapSiftDown(List<long> hv, List<int> hi) {
        int p = 0;
        while (true) {
            int l = p * 2 + 1;
            int r = l + 1;
            int worst = p;
            // 找 p 与两子里"最差"的那个；最差者应居上。
            if (l < hv.Count && !ZanCollectionBetter(hv[l], hi[l], hv[worst], hi[worst])) { worst = l; }
            if (r < hv.Count && !ZanCollectionBetter(hv[r], hi[r], hv[worst], hi[worst])) { worst = r; }
            if (worst == p) { break; }
            long tv = hv[p]; hv[p] = hv[worst]; hv[worst] = tv;
            int ti = hi[p]; hi[p] = hi[worst]; hi[worst] = ti;
            p = worst;
        }
    }

    /// <summary>对集合启动流畅的 LINQ 风格查询。</summary>
    DocQuery Query() {
        return DocQuery.Of(this);
    }

    // ===== 协程安全的异步 API =====

    /// <see cref="FindById"/> 的协程版本：在共享读写锁的读侧执行。
    async JsonValue FindByIdAsync(int id) {
        await this.rw.EnterRead();
        JsonValue v = FindById(id);
        this.rw.ExitRead();
        return v;
    }

    /// <see cref="Insert"/> 的协程版本：在共享读写锁的写侧执行。
    async int InsertAsync(JsonValue doc) {
        await this.rw.EnterWrite();
        int id = Insert(doc);
        this.rw.ExitWrite();
        return id;
    }

    /// <see cref="Update"/> 的协程版本：在共享读写锁的写侧执行。
    async bool UpdateAsync(int id, JsonValue doc) {
        await this.rw.EnterWrite();
        bool ok = Update(id, doc);
        this.rw.ExitWrite();
        return ok;
    }

    /// <see cref="DeleteById"/> 的协程版本：在共享读写锁的写侧执行。
    async bool DeleteByIdAsync(int id) {
        await this.rw.EnterWrite();
        bool ok = DeleteById(id);
        this.rw.ExitWrite();
        return ok;
    }

    /// <summary>对单篇文档的原子读改写：fn 在
    /// 写临界区内基于最新已提交版本运行，因此
    /// 并发更新不会丢失写入（判断与写入是
    /// 一个原子步骤）。当文档存在且 fn
    /// 返回了替换值时返回 true。</summary>
    async bool UpdateAtomic(int id, DocUpdater fn) {
        await this.rw.EnterWrite();
        JsonValue cur = FindById(id);
        if (cur == null) {
            this.rw.ExitWrite();
            return false;
        }
        JsonValue next = fn(cur);
        bool ok = false;
        if (next != null) {
            ok = Update(id, next);
        }
        this.rw.ExitWrite();
        return ok;
    }
}
