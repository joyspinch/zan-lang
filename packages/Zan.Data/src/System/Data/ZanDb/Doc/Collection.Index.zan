using System;
using System.IO;
using System.Json;
using System.Text;
using System.Threading;

namespace System.Data.ZanDb;

public partial class Collection {
    // 为每个已索引字段写入该文档的二级索引条目（须在 kv 事务内）。
    public void AddIndexEntries(int id, JsonValue doc) {
        for (int i = 0; i < this.indexedFields.Count; i = i + 1) {
            string f = this.indexedFields[i];
            JsonValue v = doc.Get(f);
            if (v != null) {
                this.kv.Put(IdxKey(f, v.AsString(""), id), "");
            }
        }
    }

    // 删除一篇文档的全部二级索引条目；doc 为 null（文档已不存在）时无事可做。
    public void RemoveIndexEntries(int id, JsonValue doc) {
        if (doc == null) { return; }
        for (int i = 0; i < this.indexedFields.Count; i = i + 1) {
            string f = this.indexedFields[i];
            JsonValue v = doc.Get(f);
            if (v != null) {
                this.kv.Delete(IdxKey(f, v.AsString(""), id));
            }
        }
    }


    // ===== 二级索引 =====

    // 把索引字段列表写回元数据键（须在 kv 事务内）。
    public void PersistIndexMeta() {
        string meta = "";
        for (int i = 0; i < this.indexedFields.Count; i = i + 1) {
            if (i > 0) { meta = meta + ","; }
            meta = meta + this.indexedFields[i];
        }
        this.kv.Put(IdxMetaKey(), meta);
    }

    // 为字段创建（或重建）二级索引，按有界批次
    // 索引现有文档。后续写入会自动维护。
    // 中断的构建会继续执行，而不是
    // 重新开始。
    public void EnsureIndex(string field) {
        this.tlock.EnterWrite();
        try {
        EnsureIndexLocked(field, Collection.INDEX_BATCH);
        } finally { this.tlock.ExitWrite(); }
    }

    // 带显式批次大小的 EnsureIndex（每
    // 个事务处理的文档数）。
    public void EnsureIndex(string field, int batchSize) {
        this.tlock.EnterWrite();
        try {
        EnsureIndexLocked(field, batchSize);
        } finally { this.tlock.ExitWrite(); }
    }

    // 刀12：EnsureIndex 的持锁实现（公开壳持有整库线程读写锁；内部互调走本变体）。
    public void EnsureIndexLocked(string field, int batchSize) {
        bool done = false;
        while (!done) { done = BuildIndexStepLocked(field, batchSize); }
    }

    // 索引下一批文档，每次调用一个事务，
    // 覆盖整个集合后返回 true。
    // 分批限制事务大小；游标（m:{name}:idxpos:{field}）与条目
    // 共用提交边界，中断后从最后一批继续。字段在第一批加入
    // 索引列表，持库服务中的后续写入也会维护条目。构建完成前
    // IndexReady 为 false，FindByIndex 回退为扫描。
    public bool BuildIndexStep(string field, int batchSize) {
        this.tlock.EnterWrite();
        try {
        return BuildIndexStepLocked(field, batchSize);
        } finally { this.tlock.ExitWrite(); }
    }

    // 刀12：BuildIndexStep 的持锁实现（公开壳持有整库线程读写锁；内部互调走本变体）。
    public bool BuildIndexStepLocked(string field, int batchSize) {
        if (batchSize <= 0) { batchSize = Collection.INDEX_BATCH; }
        SyncMeta();
        this.kv.Begin();
        try {
            if (!HasIndexLocked(field)) {
                this.indexedFields.Add(field);
                PersistIndexMeta();
            }
            int from = 0;
            string cursor = this.kv.Get(IdxPosKey(field));
            if (cursor.Length > 0) { from = (int)(Collection.ParseI64(cursor) + 1); }
            List<KvEntry> entries = new List<KvEntry>();
            this.kv.ScanRange(DocKey(from), "c:" + this.name + ";", batchSize, entries);
            int kid = KeyIdOf(field);
            int last = from;
            for (int i = 0; i < entries.Count; i = i + 1) {
                int id = Collection.IdOfKey(entries[i].key);
                JsonValue f = FieldOf(entries[i].val, kid);
                if (f != null) { this.kv.Put(IdxKey(field, f.AsString(""), id), ""); }
                if (id > last) { last = id; }
            }
            bool done = entries.Count < batchSize;
            if (done) { this.kv.Delete(IdxPosKey(field)); }
            else { this.kv.Put(IdxPosKey(field), Convert.ToString(last)); }
            CommitWrite();
            return done;
        } catch {
            this.kv.Rollback();
            SyncMeta();
            throw;
        }
    }

    // 字段是否已在索引列表中（含批量构建尚未完成的）。
    public bool HasIndex(string field) {
        this.tlock.EnterRead();
        try {
        return HasIndexLocked(field);
        } finally { this.tlock.ExitRead(); }
    }

    // 刀12：HasIndex 的持锁实现（公开壳持有整库线程读写锁；内部互调走本变体）。
    public bool HasIndexLocked(string field) {
        for (int i = 0; i < this.indexedFields.Count; i = i + 1) {
            if (this.indexedFields[i] == field) { return true; }
        }
        return false;
    }

    // 当字段已被索引且其批次构建
    // 完成（即索引覆盖所有文档）时为 true。
    public bool IndexReady(string field) {
        this.tlock.EnterRead();
        try {
        return IndexReadyLocked(field);
        } finally { this.tlock.ExitRead(); }
    }

    // 刀12：IndexReady 的持锁实现（公开壳持有整库线程读写锁；内部互调走本变体）。
    public bool IndexReadyLocked(string field) {
        SyncMeta();
        return HasIndexLocked(field) && !this.kv.Contains(IdxPosKey(field));
    }

    // 索引查找：字段等于 val（字符串形式）的文档，
    // 通过二级索引实现——无需全表扫描。索引仍在构建时
    // 回退为扫描，因此结果总是完整的。
    public List<JsonValue> FindByIndex(string field, string val) {
        this.tlock.EnterRead();
        try {
        SyncMeta();
        List<JsonValue> docs = new List<JsonValue>();
        if (HasIndexLocked(field) && !this.kv.Contains(IdxPosKey(field))) {
            List<KvEntry> entries = new List<KvEntry>();
            this.kv.ScanPrefix(IdxPrefix(field, val), 0, entries);
            for (int i = 0; i < entries.Count; i = i + 1) {
                JsonValue d = FindByIdLocked(Collection.IdOfKey(entries[i].key));
                if (d != null) { docs.Add(d); }
            }
            return docs;
        }
        return FindByFieldScan(field, val);
        } finally { this.tlock.ExitRead(); }
    }

    // 通过扫描找出字段等于 val 的文档：每条
    // 记录只被询问这一个字段（字符串值走零分配比较），
    // 只有匹配项会被完整解码，全程流式。用于字段没有
    // 可用索引的情况。
    public List<JsonValue> FindByFieldScan(string field, string val) {
        this.tlock.EnterRead();
        try {
        return FindByFieldScanLocked(field, val);
        } finally { this.tlock.ExitRead(); }
    }

    // 刀12：FindByFieldScan 的持锁实现（公开壳持有整库线程读写锁；内部互调走本变体）。
    public List<JsonValue> FindByFieldScanLocked(string field, string val) {
        SyncMeta();
        List<JsonValue> docs = new List<JsonValue>();
        int kid = KeyIdOf(field);
        if (kid == 0) {
            return docs;
        }
        bool fastReject = EqFastReject(val);
        string hi = "c:" + this.name + ";";
        this.kv.ScanRows("c:" + this.name + ":", hi, delegate(ScanRow row) {
            if (FieldEqualsRow(row, kid, val, fastReject)) {
                JsonValue doc = DecodeDoc(row.Val());
                doc.Set("_id", JsonValue.NewNum(Collection.IdFromKey(row.Key())));
                docs.Add(doc);
            }
            return true;
        });
        return docs;
    }


    // 字段值等于 val 的所有文档 id，按 id 序。
    // 索引就绪时只扫索引条目（覆盖索引，一个文档都不读）；
    // 否则流式扫描、每条记录只解码这一个字段（零拷贝），
    // 匹配才物化键收 id——全程不构建文档树。
    public List<int> FindIdsByField(string field, string val) {
        this.tlock.EnterRead();
        try {
        SyncMeta();
        List<int> ids = new List<int>();
        if (HasIndexLocked(field) && !this.kv.Contains(IdxPosKey(field))) {
            List<KvEntry> entries = new List<KvEntry>();
            this.kv.ScanPrefix(IdxPrefix(field, val), 0, entries);
            for (int i = 0; i < entries.Count; i = i + 1) {
                ids.Add(Collection.IdOfKey(entries[i].key));
            }
            return ids;
        }
        int kid = KeyIdOf(field);
        if (kid == 0) { return ids; }
        string lo = "c:" + this.name + ":";
        string hi = "c:" + this.name + ";";
        bool fastReject = EqFastReject(val);
        // 内核路径：单段稳态下裸走读等值判定，字符串值零分配
        // memcmp；针线否证先挡掉大多数不匹配行。命中行才物化键。
        int[] fallbackId = new int[1];
        fallbackId[0] = -1;
        bool[] walk = new bool[1];
        int[] needleState = new int[1];
        needleState[0] = fastReject ? 1 : 0;  // 1 = 需要先试针线否证
        int kernelN = this.kv.TryScanKernel(lo, hi,
        delegate(nint basePtr, int keyOff, int keyLen, int valOff, int valLen) {
            int id = Collection.IdOfPtr(basePtr + keyOff, keyLen);
            if (id <= fallbackId[0]) { return true; }
            if (needleState[0] == 1) {
                // EqFastReject 前提下：needle 原字节不在值区即否决。
                nint vp = basePtr + valOff;
                if (valLen < val.Length) { return true; }
                nint hit = MemChr(vp, val[0] & 255, valLen);
                bool present = false;
                while (hit != 0) {
                    long off = (long)(hit - vp);
                    if (off + val.Length <= valLen
                    && NativeMemory.Compare(hit, val, val.Length) == 0) {
                        present = true;
                        break;
                    }
                    hit = MemChr(hit + 1, val[0] & 255, (int)(valLen - off - 1));
                }
                if (!present) { return true; }
            }
            int r = Collection.FieldEqualsPtr(basePtr, valOff, valLen, kid, val);
            if (r >= 0) {
                if (r == 1) { ids.Add(id); }
                return true;
            }
            // -1 转义/格式异常 或 -2 非字符串类型：该行起回退
            // 权威走读（含当行）。
            walk[0] = true;
            fallbackId[0] = id;
            return false;
        });
        if (kernelN >= 0 && !walk[0]) { return ids; }
        if (kernelN >= 0 && fallbackId[0] >= 0) {
            // 内核已收集 fallbackId 之前（不含）的命中；剩余行走
            // 权威路径。
            string fromKey = DocKey(fallbackId[0]);
            this.kv.ScanRows(fromKey, hi, delegate(ScanRow row) {
                if (FieldEqualsRow(row, kid, val, fastReject)) {
                    ids.Add(Collection.IdOfKey(row.Key()));
                }
                return true;
            });
            return ids;
        }
        this.kv.ScanRows(lo, hi, delegate(ScanRow row) {
            if (FieldEqualsRow(row, kid, val, fastReject)) {
                ids.Add(Collection.IdOfKey(row.Key()));
            }
            return true;
        });
        return ids;
        } finally { this.tlock.ExitRead(); }
    }

    // 字段值落在 [lo, hi]（双端含）的所有文档 id。
    // 索引就绪时走索引键序范围扫（覆盖索引，一个文档都不读，
    // 成本与等值覆盖查询同量级），结果按（值, id）序；无索引则
    // 流式扫描按 id 序。比较语义：字段值 AsString 形态的**序数**
    // 比较——数字按十进制文本比（"9" &gt; "20"），范围端点与索引
    // 值不应含 &lt; \t 的控制字符。lo 为空串 = 无下界，hi 为空串 =
    // 无上界。
    public List<int> FindIdsByFieldRange(string field, string lo, string hi) {
        this.tlock.EnterRead();
        try {
        return FindIdsByFieldRangeLocked(field, lo, hi);
        } finally { this.tlock.ExitRead(); }
    }

    // 刀12：FindIdsByFieldRange 的持锁实现（公开壳持有整库线程读写锁；内部互调走本变体）。
    public List<int> FindIdsByFieldRangeLocked(string field, string lo, string hi) {
        SyncMeta();
        List<int> ids = new List<int>();
        int kid = KeyIdOf(field);
        if (kid == 0) { return ids; }
        if (HasIndexLocked(field) && !this.kv.Contains(IdxPosKey(field))) {
            string head = "i:" + this.name + ":" + Collection.PadId(kid) + ":";
            string startKey = head + lo + "\t";
            string endKey;
            if (hi.Length > 0) {
                // 上界钉在 \t 后的 6 个 '~'（id 段每字符 ≤ '~'）：
                // 收尽 hi 本值的全部条目，且不放进 hi 的任何扩展值
                // （"c1" 不放进 "c10"——'\t'(9) < '0'(48)）。
                endKey = head + hi + "\t~~~~~~";
            } else {
                // 无上界：该索引字段的段尾（';' 排在 ':' 之后）。
                endKey = "i:" + this.name + ":" + Collection.PadId(kid) + ";";
            }
            List<KvEntry> entries = new List<KvEntry>();
            this.kv.ScanRange(startKey, endKey, 0, entries);
            for (int i = 0; i < entries.Count; i = i + 1) {
                ids.Add(Collection.IdOfKey(entries[i].key));
            }
            return ids;
        }
        string docHi = "c:" + this.name + ";";
        this.kv.ScanRows("c:" + this.name + ":", docHi, delegate(ScanRow row) {
            JsonValue f = FieldOfRow(row, kid);
            if (f != null) {
                string s = f.AsString("");
                if ((lo.Length == 0 || String.CompareOrdinal(s, lo) >= 0)
                && (hi.Length == 0 || String.CompareOrdinal(s, hi) <= 0)) {
                    ids.Add(Collection.IdOfKey(row.Key()));
                }
            }
            return true;
        });
        return ids;
    }

}
