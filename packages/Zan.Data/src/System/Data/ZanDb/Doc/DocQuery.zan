using System;
using System.Json;
namespace System.Data.ZanDb;

public delegate bool DocPredicate(JsonValue doc);
public delegate int DocIntKey(JsonValue doc);
public delegate string DocStrKey(JsonValue doc);

public class DocQuery {
    public Collection col;
    public List<DocPredicate> preds;
    public List<EqFilter> eqFilters;
    public List<RangeFilter> rangeFilters;
    public List<InFilter> inFilters;
    public string idxField;
    public string idxValue;
    public bool hasIdxEq;
    public bool sortInt;
    public bool sortStr;
    public bool sortDesc;
    public DocIntKey intKey;
    public DocStrKey strKey;
    public int skipN;
    public int takeN;

    // 构造
    public DocQuery() {
        this.preds = new List<DocPredicate>();
        this.eqFilters = new List<EqFilter>();
        this.rangeFilters = new List<RangeFilter>();
        this.inFilters = new List<InFilter>();
        this.idxField = "";
        this.idxValue = "";
        this.hasIdxEq = false;
        this.sortInt = false;
        this.sortStr = false;
        this.sortDesc = false;
        this.skipN = 0;
        this.takeN = 0;
    }

    // 为集合创建一个空查询。
    public static DocQuery Of(Collection col) {
        if (col == null) { throw new ArgumentNullException("col"); }
        DocQuery q = new DocQuery();
        q.col = col;
        return q;
    }

    // Lambda 过滤器；多次调用彼此 AND。
    public DocQuery Where(DocPredicate pred) {
        if (pred == null) { throw new ArgumentNullException("pred"); }
        this.preds.Add(pred);
        return this;
    }

    // 字段等值约束（字符串形式）。当字段有
    // 二级索引时，候选集来自索引而非
    // 全表扫描；若有多个索引字段则自动执行双指针多索引求交。
    public DocQuery WhereEq(string field, string val) {
        if (!this.hasIdxEq && this.col.HasIndex(field)) {
            this.hasIdxEq = true;
            this.idxField = field;
            this.idxValue = val;
        }
        this.eqFilters.Add(new EqFilter(field, val));
        return this;
    }

    // 字段的整数等值约束。
    public DocQuery WhereEqInt(string field, int val) {
        return WhereEq(field, Convert.ToString(val));
    }

    // 字段序数范围约束 [lo, hi]（lo 为空表示无下界，hi 为空表示无上界）。
    // 当字段有二级索引时，自动下推至 B+Tree 范围扫描。
    public DocQuery WhereRange(string field, string lo, string hi) {
        this.rangeFilters.Add(new RangeFilter(field, lo, hi));
        return this;
    }

    // 字段集合约束（字符串列表形式：WHERE field IN (...)）。
    // 当字段有二级索引时，自动按索引合并求并集并参与求交加速；无索引时基于哈希表 O(1) 过滤。
    public DocQuery WhereIn(string field, List<string> values) {
        if (values == null) {
            this.inFilters.Add(new InFilter(field, new List<string>()));
            return this;
        }
        this.inFilters.Add(new InFilter(field, values));
        return this;
    }

    // 字段集合约束（整数列表形式）。
    public DocQuery WhereInInt(string field, List<int> values) {
        List<string> svals = new List<string>();
        if (values != null) {
            for (int i = 0; i < values.Count; i = i + 1) {
                svals.Add(Convert.ToString(values[i]));
            }
        }
        return WhereIn(field, svals);
    }

    // 按整数键升序排序（再次调用覆盖先前排序设置）。
    public DocQuery OrderByInt(DocIntKey key) {
        if (key == null) { throw new ArgumentNullException("key"); }
        this.sortInt = true;
        this.sortStr = false;
        this.sortDesc = false;
        this.intKey = key;
        return this;
    }

    // 按整数键降序排序。
    public DocQuery OrderByIntDesc(DocIntKey key) {
        OrderByInt(key);
        this.sortDesc = true;
        return this;
    }

    // 按字符串键升序排序。
    public DocQuery OrderByStr(DocStrKey key) {
        if (key == null) { throw new ArgumentNullException("key"); }
        this.sortStr = true;
        this.sortInt = false;
        this.sortDesc = false;
        this.strKey = key;
        return this;
    }

    // 按字符串键降序排序。
    public DocQuery OrderByStrDesc(DocStrKey key) {
        OrderByStr(key);
        this.sortDesc = true;
        return this;
    }

    // 跳过前 n 条（分页）。
    public DocQuery Skip(int n) {
        this.skipN = n > 0 ? n : 0;
        return this;
    }

    // 最多返回 n 条（0 = 不限）。
    public DocQuery Take(int n) {
        this.takeN = n > 0 ? n : 0;
        return this;
    }

    // ===== 多索引求交辅助 =====

    // 两个严格递增的整数 ID 列表的双指针有序求交集：O(A + B)。
    public static List<int> IntersectSortedIds(List<int> a, List<int> b) {
        List<int> outp = new List<int>();
        if (a == null || b == null) { return outp; }
        int i = 0;
        int j = 0;
        while (i < a.Count && j < b.Count) {
            int ai = a[i];
            int bj = b[j];
            if (ai == bj) {
                outp.Add(ai);
                i = i + 1;
                j = j + 1;
            } else if (ai < bj) {
                i = i + 1;
            } else {
                j = j + 1;
            }
        }
        return outp;
    }

    // 两个严格递增的整数 ID 列表的双指针有序求并集：O(A + B)。
    public static List<int> UnionSortedIds(List<int> a, List<int> b) {
        List<int> outp = new List<int>();
        if (a == null && b == null) { return outp; }
        if (a == null) {
            for (int k = 0; k < b.Count; k = k + 1) { outp.Add(b[k]); }
            return outp;
        }
        if (b == null) {
            for (int k = 0; k < a.Count; k = k + 1) { outp.Add(a[k]); }
            return outp;
        }
        int i = 0;
        int j = 0;
        while (i < a.Count && j < b.Count) {
            int ai = a[i];
            int bj = b[j];
            if (ai == bj) {
                outp.Add(ai);
                i = i + 1;
                j = j + 1;
            } else if (ai < bj) {
                outp.Add(ai);
                i = i + 1;
            } else {
                outp.Add(bj);
                j = j + 1;
            }
        }
        while (i < a.Count) {
            outp.Add(a[i]);
            i = i + 1;
        }
        while (j < b.Count) {
            outp.Add(b[j]);
            j = j + 1;
        }
        return outp;
    }

    public List<int> FindIdsByInValues(string field, List<string> vals) {
        List<int> unionIds = new List<int>();
        for (int i = 0; i < vals.Count; i = i + 1) {
            List<int> ids = this.col.FindIdsByField(field, vals[i]);
            if (ids != null && ids.Count > 0) {
                unionIds = DocQuery.UnionSortedIds(unionIds, ids);
            }
        }
        return unionIds;
    }

    // ===== 执行 =====

    // 候选集检索：多就绪索引求交 -> 单索引快路径 -> 无索引流式快筛 / 全表扫描。
    public List<JsonValue> Candidates() {
        // 统计所有已就绪的二级索引条件
        List<int> readyEq = new List<int>();
        for (int i = 0; i < this.eqFilters.Count; i = i + 1) {
            if (this.col.IndexReady(this.eqFilters[i].field)) {
                readyEq.Add(i);
            }
        }
        List<int> readyRange = new List<int>();
        for (int i = 0; i < this.rangeFilters.Count; i = i + 1) {
            if (this.col.IndexReady(this.rangeFilters[i].field)) {
                readyRange.Add(i);
            }
        }
        List<int> readyIn = new List<int>();
        for (int i = 0; i < this.inFilters.Count; i = i + 1) {
            if (this.col.IndexReady(this.inFilters[i].field)) {
                readyIn.Add(i);
            }
        }

        int totalReady = readyEq.Count + readyRange.Count + readyIn.Count;

        // 单索引特化快路径
        if (totalReady == 1) {
            if (readyEq.Count == 1) {
                EqFilter f = this.eqFilters[readyEq[0]];
                return this.col.FindByIndex(f.field, f.val);
            }
            if (readyRange.Count == 1) {
                RangeFilter rf = this.rangeFilters[readyRange[0]];
                return this.LoadDocsByIds(this.col.FindIdsByFieldRange(rf.field, rf.lo, rf.hi));
            }
            InFilter inf = this.inFilters[readyIn[0]];
            return this.LoadDocsByIds(FindIdsByInValues(inf.field, inf.values));
        }

        // 多索引求交路径：拉取各索引匹配 ID 并归并求交
        if (totalReady > 1) {
            List<int> curIds = null;
            for (int i = 0; i < readyEq.Count; i = i + 1) {
                EqFilter f = this.eqFilters[readyEq[i]];
                List<int> ids = this.col.FindIdsByField(f.field, f.val);
                curIds = curIds == null ? ids : DocQuery.IntersectSortedIds(curIds, ids);
                if (curIds.Count == 0) { break; }
            }
            if (curIds == null || curIds.Count > 0) {
                for (int i = 0; i < readyRange.Count; i = i + 1) {
                    RangeFilter rf = this.rangeFilters[readyRange[i]];
                    List<int> ids = this.col.FindIdsByFieldRange(rf.field, rf.lo, rf.hi);
                    curIds = curIds == null ? ids : DocQuery.IntersectSortedIds(curIds, ids);
                    if (curIds.Count == 0) { break; }
                }
            }
            if (curIds == null || curIds.Count > 0) {
                for (int i = 0; i < readyIn.Count; i = i + 1) {
                    InFilter inf = this.inFilters[readyIn[i]];
                    List<int> ids = FindIdsByInValues(inf.field, inf.values);
                    curIds = curIds == null ? ids : DocQuery.IntersectSortedIds(curIds, ids);
                    if (curIds.Count == 0) { break; }
                }
            }
            return this.LoadDocsByIds(curIds);
        }

        // 无就绪索引回退：首选等值字段流式快筛
        if (this.eqFilters.Count > 0) {
            EqFilter f = this.eqFilters[0];
            return this.col.FindByFieldScan(f.field, f.val);
        }
        if (this.rangeFilters.Count > 0) {
            RangeFilter rf = this.rangeFilters[0];
            return this.LoadDocsByIds(this.col.FindIdsByFieldRange(rf.field, rf.lo, rf.hi));
        }
        return this.col.FindAll();
    }

    private List<JsonValue> LoadDocsByIds(List<int> ids) {
        List<JsonValue> docs = new List<JsonValue>();
        if (ids == null) { return docs; }
        for (int i = 0; i < ids.Count; i = i + 1) {
            JsonValue d = this.col.FindById(ids[i]);
            if (d != null) { docs.Add(d); }
        }
        return docs;
    }

    // 检查余下的等值约束、范围约束与 lambda 过滤器（首个等值约束已由 Candidates 扫描应用）。
    public bool MatchesRest(JsonValue d) {
        return this.MatchesFrom(d, 1);
    }

    // 当候选集已经由单字段快筛扫描应用了首个等值条件时为 true。
    public bool EqAppliedByScan() {
        bool hasReady = false;
        for (int i = 0; i < this.eqFilters.Count; i = i + 1) {
            if (this.col.IndexReady(this.eqFilters[i].field)) { hasReady = true; break; }
        }
        if (!hasReady) {
            for (int i = 0; i < this.rangeFilters.Count; i = i + 1) {
                if (this.col.IndexReady(this.rangeFilters[i].field)) { hasReady = true; break; }
            }
        }
        if (!hasReady) {
            for (int i = 0; i < this.inFilters.Count; i = i + 1) {
                if (this.col.IndexReady(this.inFilters[i].field)) { hasReady = true; break; }
            }
        }
        return !hasReady && this.eqFilters.Count > 0;
    }

    // 检查全部等值约束、范围约束与 lambda 过滤器。
    public bool Matches(JsonValue d) {
        return this.MatchesFrom(d, 0);
    }

    private bool MatchesFrom(JsonValue d, int eqStart) {
        for (int i = eqStart; i < this.eqFilters.Count; i = i + 1) {
            EqFilter f = this.eqFilters[i];
            JsonValue v = d.Get(f.field);
            if (v == null || v.AsString("") != f.val) { return false; }
        }
        for (int r = 0; r < this.rangeFilters.Count; r = r + 1) {
            RangeFilter rf = this.rangeFilters[r];
            JsonValue v = d.Get(rf.field);
            if (v == null) { return false; }
            string sv = v.AsString("");
            if (rf.lo != "" && String.CompareOrdinal(sv, rf.lo) < 0) { return false; }
            if (rf.hi != "" && String.CompareOrdinal(sv, rf.hi) > 0) { return false; }
        }
        for (int k = 0; k < this.inFilters.Count; k = k + 1) {
            InFilter inf = this.inFilters[k];
            JsonValue v = d.Get(inf.field);
            if (v == null || !inf.valSet.ContainsKey(v.AsString(""))) { return false; }
        }
        foreach (DocPredicate p in this.preds) {
            if (!p(d)) { return false; }
        }
        return true;
    }

    // 对预计算的键做自底向上归并排序：O(n log n)，稳定。
    public void SortDocs(List<JsonValue> docs) {
        int n = docs.Count;
        if (n < 2) { return; }
        List<int> ik = new List<int>();
        List<string> sk = new List<string>();
        int i = 0;
        for (; i < n; i = i + 1) {
            if (this.sortInt) { ik.Add(this.intKey(docs[i])); sk.Add(""); }
            else { sk.Add(this.strKey(docs[i])); ik.Add(0); }
        }
        List<JsonValue> tmpD = new List<JsonValue>();
        List<int> tmpI = new List<int>();
        List<string> tmpS = new List<string>();
        i = 0;
        while (i < n) {
            tmpD.Add(docs[i]);
            tmpI.Add(0);
            tmpS.Add("");
            i = i + 1;
        }
        int width = 1;
        while (width < n) {
            int lo = 0;
            while (lo < n) {
                int mid = lo + width;
                int hi = lo + width * 2;
                if (mid > n) { mid = n; }
                if (hi > n) { hi = n; }
                int a = lo;
                int b = mid;
                int t = lo;
                while (a < mid || b < hi) {
                    bool takeA = false;
                    if (b >= hi) { takeA = true; }
                    else if (a < mid) {
                        if (this.sortInt) { takeA = ik[a] <= ik[b]; }
                        else { takeA = String.CompareOrdinal(sk[a], sk[b]) <= 0; }
                    }
                    if (takeA) {
                        tmpD[t] = docs[a]; tmpI[t] = ik[a]; tmpS[t] = sk[a];
                        a = a + 1;
                    } else {
                        tmpD[t] = docs[b]; tmpI[t] = ik[b]; tmpS[t] = sk[b];
                        b = b + 1;
                    }
                    t = t + 1;
                }
                lo = hi;
            }
            i = 0;
            while (i < n) {
                docs[i] = tmpD[i];
                ik[i] = tmpI[i];
                sk[i] = tmpS[i];
                i = i + 1;
            }
            width = width * 2;
        }
    }

    // 基于二叉堆的整数键 Top-K 局部堆排序：O(N log K)，严格无死循环。
    public List<JsonValue> SortTopDocsInt(List<JsonValue> docs, int k) {
        List<JsonValue> hDoc = new List<JsonValue>();
        if (docs == null || k <= 0) { return hDoc; }
        List<int> hKey = new List<int>();
        bool isMaxHeap = !this.sortDesc;

        for (int i = 0; i < docs.Count; i = i + 1) {
            JsonValue d = docs[i];
            int key = this.intKey(d);

            if (hDoc.Count < k) {
                hDoc.Add(d);
                hKey.Add(key);
                int cur = hDoc.Count - 1;
                while (cur > 0) {
                    int parent = (cur - 1) / 2;
                    bool swap = false;
                    if (isMaxHeap) { swap = hKey[cur] > hKey[parent]; }
                    else { swap = hKey[cur] < hKey[parent]; }
                    if (swap) {
                        JsonValue td = hDoc[cur]; hDoc[cur] = hDoc[parent]; hDoc[parent] = td;
                        int tk = hKey[cur]; hKey[cur] = hKey[parent]; hKey[parent] = tk;
                        cur = parent;
                    } else {
                        break;
                    }
                }
            } else {
                bool replace = false;
                if (isMaxHeap) { replace = key < hKey[0]; }
                else { replace = key > hKey[0]; }
                if (replace) {
                    hDoc[0] = d;
                    hKey[0] = key;
                    int p = 0;
                    int n = hDoc.Count;
                    while (p * 2 + 1 < n) {
                        int left = p * 2 + 1;
                        int right = p * 2 + 2;
                        int best = p;
                        if (isMaxHeap) {
                            if (hKey[left] > hKey[best]) { best = left; }
                            if (right < n && hKey[right] > hKey[best]) { best = right; }
                        } else {
                            if (hKey[left] < hKey[best]) { best = left; }
                            if (right < n && hKey[right] < hKey[best]) { best = right; }
                        }
                        if (best != p) {
                            JsonValue td = hDoc[p]; hDoc[p] = hDoc[best]; hDoc[best] = td;
                            int tk = hKey[p]; hKey[p] = hKey[best]; hKey[best] = tk;
                            p = best;
                        } else {
                            break;
                        }
                    }
                }
            }
        }

        int heapSize = hDoc.Count;
        while (heapSize > 1) {
            int last = heapSize - 1;
            JsonValue td = hDoc[0]; hDoc[0] = hDoc[last]; hDoc[last] = td;
            int tk = hKey[0]; hKey[0] = hKey[last]; hKey[last] = tk;
            heapSize = heapSize - 1;

            int p = 0;
            while (p * 2 + 1 < heapSize) {
                int left = p * 2 + 1;
                int right = p * 2 + 2;
                int best = p;
                if (isMaxHeap) {
                    if (hKey[left] > hKey[best]) { best = left; }
                    if (right < heapSize && hKey[right] > hKey[best]) { best = right; }
                } else {
                    if (hKey[left] < hKey[best]) { best = left; }
                    if (right < heapSize && hKey[right] < hKey[best]) { best = right; }
                }
                if (best != p) {
                    JsonValue swapD = hDoc[p]; hDoc[p] = hDoc[best]; hDoc[best] = swapD;
                    int swapK = hKey[p]; hKey[p] = hKey[best]; hKey[best] = swapK;
                    p = best;
                } else {
                    break;
                }
            }
        }
        return hDoc;
    }

    // 基于二叉堆的字符串键 Top-K 局部堆排序：O(N log K)，严格无死循环。
    public List<JsonValue> SortTopDocsStr(List<JsonValue> docs, int k) {
        List<JsonValue> hDoc = new List<JsonValue>();
        if (docs == null || k <= 0) { return hDoc; }
        List<string> hKey = new List<string>();
        bool isMaxHeap = !this.sortDesc;

        for (int i = 0; i < docs.Count; i = i + 1) {
            JsonValue d = docs[i];
            string key = this.strKey(d);

            if (hDoc.Count < k) {
                hDoc.Add(d);
                hKey.Add(key);
                int cur = hDoc.Count - 1;
                while (cur > 0) {
                    int parent = (cur - 1) / 2;
                    bool swap = false;
                    if (isMaxHeap) { swap = String.CompareOrdinal(hKey[cur], hKey[parent]) > 0; }
                    else { swap = String.CompareOrdinal(hKey[cur], hKey[parent]) < 0; }
                    if (swap) {
                        JsonValue td = hDoc[cur]; hDoc[cur] = hDoc[parent]; hDoc[parent] = td;
                        string tk = hKey[cur]; hKey[cur] = hKey[parent]; hKey[parent] = tk;
                        cur = parent;
                    } else {
                        break;
                    }
                }
            } else {
                bool replace = false;
                if (isMaxHeap) { replace = String.CompareOrdinal(key, hKey[0]) < 0; }
                else { replace = String.CompareOrdinal(key, hKey[0]) > 0; }
                if (replace) {
                    hDoc[0] = d;
                    hKey[0] = key;
                    int p = 0;
                    int n = hDoc.Count;
                    while (p * 2 + 1 < n) {
                        int left = p * 2 + 1;
                        int right = p * 2 + 2;
                        int best = p;
                        if (isMaxHeap) {
                            if (String.CompareOrdinal(hKey[left], hKey[best]) > 0) { best = left; }
                            if (right < n && String.CompareOrdinal(hKey[right], hKey[best]) > 0) { best = right; }
                        } else {
                            if (String.CompareOrdinal(hKey[left], hKey[best]) < 0) { best = left; }
                            if (right < n && String.CompareOrdinal(hKey[right], hKey[best]) < 0) { best = right; }
                        }
                        if (best != p) {
                            JsonValue td = hDoc[p]; hDoc[p] = hDoc[best]; hDoc[best] = td;
                            string tk = hKey[p]; hKey[p] = hKey[best]; hKey[best] = tk;
                            p = best;
                        } else {
                            break;
                        }
                    }
                }
            }
        }

        int heapSize = hDoc.Count;
        while (heapSize > 1) {
            int last = heapSize - 1;
            JsonValue td = hDoc[0]; hDoc[0] = hDoc[last]; hDoc[last] = td;
            string tk = hKey[0]; hKey[0] = hKey[last]; hKey[last] = tk;
            heapSize = heapSize - 1;

            int p = 0;
            while (p * 2 + 1 < heapSize) {
                int left = p * 2 + 1;
                int right = p * 2 + 2;
                int best = p;
                if (isMaxHeap) {
                    if (String.CompareOrdinal(hKey[left], hKey[best]) > 0) { best = left; }
                    if (right < heapSize && String.CompareOrdinal(hKey[right], hKey[best]) > 0) { best = right; }
                } else {
                    if (String.CompareOrdinal(hKey[left], hKey[best]) < 0) { best = left; }
                    if (right < heapSize && String.CompareOrdinal(hKey[right], hKey[best]) < 0) { best = right; }
                }
                if (best != p) {
                    JsonValue swapD = hDoc[p]; hDoc[p] = hDoc[best]; hDoc[best] = swapD;
                    string swapK = hKey[p]; hKey[p] = hKey[best]; hKey[best] = swapK;
                    p = best;
                } else {
                    break;
                }
            }
        }
        return hDoc;
    }

    // 执行查询并具体化匹配的文档。
    public List<JsonValue> ToList() {
        List<JsonValue> cand = Candidates();
        bool scanned = EqAppliedByScan();
        List<JsonValue> matched = new List<JsonValue>();

        // 优化：无排序时，如果指定了 Take(k)，达到数量立即提前终止，无需遍历全量候选集
        long limit = 0L;
        if (!this.sortInt && !this.sortStr && this.takeN > 0) {
            limit = (long)this.skipN + (long)this.takeN;
        }

        for (int i = 0; i < cand.Count; i = i + 1) {
            bool keep = false;
            if (scanned) { keep = MatchesRest(cand[i]); }
            else { keep = Matches(cand[i]); }
            if (keep) {
                matched.Add(cand[i]);
                if (limit > 0L && (long)matched.Count >= limit) {
                    break;
                }
            }
        }

        if (this.sortInt || this.sortStr) {
            long neededL = 0L;
            if (this.takeN > 0) {
                neededL = (long)this.skipN + (long)this.takeN;
            }
            if (neededL > 0L && neededL < (long)(matched.Count / 2)) {
                int needed = (int)neededL;
                if (this.sortInt) { matched = SortTopDocsInt(matched, needed); }
                else { matched = SortTopDocsStr(matched, needed); }
            } else {
                SortDocs(matched);
                if (this.sortDesc) {
                    List<JsonValue> rev = new List<JsonValue>();
                    int r = matched.Count - 1;
                    while (r >= 0) {
                        rev.Add(matched[r]);
                        r = r - 1;
                    }
                    matched = rev;
                }
            }
        }

        if (this.skipN > 0 || this.takeN > 0) {
            List<JsonValue> page = new List<JsonValue>();
            int p = this.skipN;
            while (p < matched.Count) {
                if (this.takeN > 0 && page.Count >= this.takeN) { break; }
                page.Add(matched[p]);
                p = p + 1;
            }
            return page;
        }
        return matched;
    }

    // 返回第一个匹配项，没有则返回 null。
    // 借助无排序提前终止特性，找到第 1 项立即返回，避免无效扫描。
    public JsonValue First() {
        List<JsonValue> r = Take(1).ToList();
        if (r.Count > 0) { return r[0]; }
        return null;
    }

    // 匹配数量（不应用排序/分页；单等值条件走快速计数）。
    public int Count() {
        if (this.preds.Count == 0 && this.rangeFilters.Count == 0 && this.inFilters.Count == 0 && this.eqFilters.Count == 1) {
            EqFilter only = this.eqFilters[0];
            return this.col.CountByField(only.field, only.val);
        }
        List<JsonValue> cand = Candidates();
        bool scanned = EqAppliedByScan();
        int n = 0;
        for (int i = 0; i < cand.Count; i = i + 1) {
            bool keep = scanned ? MatchesRest(cand[i]) : Matches(cand[i]);
            if (keep) { n = n + 1; }
        }
        return n;
    }
}
