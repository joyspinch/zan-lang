using System;
using System.IO;
using System.Json;
using System.Text;
using System.Threading;

namespace System.Data.ZanDb;

public partial class Collection {
    // 索引字段文本，支持中文词典与未知词召回。
    public void EnsureFullTextIndex(string field) {
        this.tlock.EnterWrite();
        try {
             this.search.EnsureText(this, field, new TextTokenizer());
        } finally { this.tlock.ExitWrite(); }
    }
    public void EnsureFullTextIndex(string field, TextTokenizer tokenizer) {
        this.tlock.EnterWrite();
        try {
             this.search.EnsureText(this, field, tokenizer);
        } finally { this.tlock.ExitWrite(); }
    }
    public void EnsureVectorIndex(string field, VectorIndexOptions options) {
        this.tlock.EnterWrite();
        try {
             this.search.EnsureVector(this, field, options);
        } finally { this.tlock.ExitWrite(); }
    }
    public List<Bm25Hit> SearchText(string field, string query, int k) {
        this.tlock.EnterRead();
        try { return this.search.Text(field, query, k, null); }
        finally { this.tlock.ExitRead(); }
    }
    public List<Bm25Hit> SearchTextFiltered(string field, string query, int k, Bm25Filter filter) {
        this.tlock.EnterRead();
        try {
        return this.search.Text(field, query, k, filter);
        } finally { this.tlock.ExitRead(); }
    }
    public List<VectorHit> SearchVector(string field, float[] query, int k, int efSearch) {
        this.tlock.EnterRead();
        try {
        return this.search.Vector(field, query, k, efSearch, false, null);
        } finally { this.tlock.ExitRead(); }
    }
    public List<VectorHit> SearchVectorFiltered(string field, float[] query, int k, int efSearch, VectorFilter filter) {
        this.tlock.EnterRead();
        try {
        return this.search.Vector(field, query, k, efSearch, false, filter);
        } finally { this.tlock.ExitRead(); }
    }
    public List<VectorHit> SearchVectorExact(string field, float[] query, int k) {
        this.tlock.EnterRead();
        try {
        return this.search.Vector(field, query, k, 0, true, null);
        } finally { this.tlock.ExitRead(); }
    }
    public List<VectorHit> SearchVectorExactFiltered(string field, float[] query, int k, VectorFilter filter) {
        this.tlock.EnterRead();
        try {
        return this.search.Vector(field, query, k, 0, true, filter);
        } finally { this.tlock.ExitRead(); }
    }
    // 两段式重打分（刀3b）：量化索引近似召回 + 文档行原向量精排。
    // 非量化索引转发普通搜索。
    public List<VectorHit> SearchVectorRescore(string field, float[] query, int k, int efSearch) {
        this.tlock.EnterRead();
        try {
        return this.search.VectorRescore(this, field, query, k, efSearch, null);
        } finally { this.tlock.ExitRead(); }
    }
    public List<VectorHit> SearchVectorRescoreFiltered(string field, float[] query, int k, int efSearch, VectorFilter filter) {
        this.tlock.EnterRead();
        try {
        return this.search.VectorRescore(this, field, query, k, efSearch, filter);
        } finally { this.tlock.ExitRead(); }
    }
    public List<HybridHit> SearchHybrid(string textField, string query, string vectorField, float[] vector, int k, int efSearch) {
        this.tlock.EnterRead();
        try {
        return this.search.Hybrid(textField, query, vectorField, vector, k, efSearch, null, null);
        } finally { this.tlock.ExitRead(); }
    }
    public List<HybridHit> SearchHybridFiltered(string textField, string query, string vectorField, float[] vector, int k, int efSearch, Bm25Filter textFilter, VectorFilter vectorFilter) {
        this.tlock.EnterRead();
        try {
        return this.search.Hybrid(textField, query, vectorField, vector, k, efSearch, textFilter, vectorFilter);
        } finally { this.tlock.ExitRead(); }
    }
    public void RebuildSearchIndexes() {
        this.tlock.EnterWrite();
        try {
             this.search.Rebuild(this);
        } finally { this.tlock.ExitWrite(); }
    }
    public void CheckpointSearchIndexes() {
        this.tlock.EnterWrite();
        try {
             this.search.Checkpoint(this);
        } finally { this.tlock.ExitWrite(); }
    }
    public JsonValue ListSearchIndexes() {
        this.tlock.EnterRead();
        try {
        SyncMeta();
        JsonValue list = this.search.ListIndexes();
        for (int i = 0; i < this.indexedFields.Count; i = i + 1) {
            JsonValue item = JsonValue.NewObject();
            item.PutStr("type", "field");
            item.PutStr("field", this.indexedFields[i]);
            list.Append(item);
        }
        return list;
        } finally { this.tlock.ExitRead(); }
    }

}
