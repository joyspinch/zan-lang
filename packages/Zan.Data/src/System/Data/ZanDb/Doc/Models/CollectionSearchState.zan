using System;
using System.IO;
using System.Json;
using System.Text;
namespace System.Data.ZanDb;

public class CollectionSearchState {
    public string field;
    public string kind;
    public string definition;
    public string generation;
    public string checkpoint;
    public Bm25Index text;
    public VectorIndex vector;
    public VectorIndexOptions options;
    public long applied;

    public CollectionSearchState(string field, string kind, string definition, string generation) {
        this.field = field;
        this.kind = kind;
        this.definition = definition;
        this.generation = generation;
        this.checkpoint = "";
        this.applied = -1;
    }
}
