using System;
using System.Json;
using System.Threading;

namespace System.Data.ZanDb;

/// <summary>在写临界区内根据当前文档计算新文档
/// （id 不存在时为 null）。返回 null 表示保持
/// 文档不变。</summary>
delegate JsonValue DocUpdater(JsonValue current);

/// <summary>
/// 嵌入式文档数据库，存储原生 Zan 值树（JsonValue：
/// 整数、浮点数、布尔、字符串、嵌套对象、数组）——无 ORM 映射、
/// 无 SQL 字符串。底层为 <see cref="ZanStore"/>：追加 CRC 帧日志 +
/// 不可变有序段 + 双槽清单，崩溃安全；memtable 与块缓存皆有界。
///
///   ZanDatabase db = ZanDatabase.Open("app.zdb");
///   Collection users = db.GetCollection("users");
///   JsonValue u = JsonValue.NewObject();
///   u.Put("name", JsonValue.NewStr("alice"));
///   u.Put("age", JsonValue.NewNum("30"));
///   int id = users.Insert(u);
///   JsonValue back = users.FindById(id);
///   db.Close();
/// </summary>
class ZanDatabase {
    ZanStore kv;
    AsyncRwLock rw;
    List<string> colNames;
    List<Collection> cols;
    string lastError;

    ZanDatabase() {
        this.colNames = new List<string>();
        this.cols = new List<Collection>();
        this.lastError = "";
    }

    /// <summary>以默认参数打开（不存在则创建）：分组提交档、
    /// 64MB 固化阈值、32MB 块缓存。</summary>
    static ZanDatabase Open(string path) {
        return ZanDatabase.Open(path, ZanStore.DUR_GROUP);
    }

    /// <summary>以显式持久化档打开（不存在则创建）：
    /// <see cref="ZanStore.DUR_SYNC"/> 每次提交 fsync、
    /// <see cref="ZanStore.DUR_GROUP"/> 分组提交、
    /// <see cref="ZanStore.DUR_NONE"/> 缓冲落盘。打开失败时
    /// <see cref="IsOpen"/> 为 false，原因见 <see cref="GetError"/>。</summary>
    static ZanDatabase Open(string path, int durability) {
        ZanDatabase d = new ZanDatabase();
        d.kv = ZanStore.Open(path, durability);
        if (!d.kv.IsOpen()) { d.lastError = d.kv.GetError(); }
        d.rw = new AsyncRwLock();
        return d;
    }

    /// 打开是否成功（失败原因见 <see cref="GetError"/>）。
    bool IsOpen() { return this.lastError.Length == 0 && this.kv.IsOpen(); }

    /// 打开失败的错误文本；成功时为空串。
    string GetError() { return this.lastError; }

    /// <summary>fsync 频率：1 = 每次提交，N = 分组提交。</summary>
    void SetSyncEvery(int n) { this.kv.SetSyncEvery(n); }

    /// <summary>返回指定名称的文档集合（惰性创建）。</summary>
    Collection GetCollection(string name) {
        for (int i = 0; i < this.colNames.Count; i = i + 1) {
            if (this.colNames[i] == name) { return this.cols[i]; }
        }
        Collection c = Collection.Attach(this.kv, this.rw, name);
        this.colNames.Add(name);
        this.cols.Add(c);
        return c;
    }

    /// <summary>直接访问底层的键/值存储。</summary>
    ZanStore Kv() { return this.kv; }

    /// <summary>将后续写入批量合并为一次原子提交。</summary>
    void Begin() { this.kv.Begin(); }

    /// 提交 <see cref="Begin"/> 以来的全部写入；返回是否成功落盘。
    bool Commit() { return this.kv.Commit(); }

    /// 将迄今写入的内容强制落盘到稳定存储。
    void Checkpoint() { this.kv.Checkpoint(); }

    /// <summary>把 memtable 中尚未固化的写入立即固化为新段
    /// （不归并）：归并/维护与「稳态查询」前置步骤——memtable
    /// 空了聚合与计数才走块级内核，否则退化为归并扫描。见
    /// <see cref="ZanStore.FlushToSegment"/>。</summary>
    void Flush() { this.kv.FlushToSegment(); }

    /// <summary>把全部已固化段归并为一个段：掉落被新版压住的
    /// 旧版本与已无意义的墓碑，回收存储空间。见
    /// <see cref="ZanStore.MergeSegments"/>。</summary>
    void MergeSegments() { this.kv.MergeSegments(); }

    /// 当前已固化段数（观测/运维用）。
    int SegCount() { return this.kv.SegCount(); }

    /// <summary>增量归并：把最老 maxMerge（≥2）个段归并为一个，
    /// 写阻塞被归并集规模封顶，反复调用收敛为单段。返回实际归并
    /// 的段数（0 = 段不足 2 或在事务中）。见
    /// <see cref="ZanStore.MergeSomeSegments"/>。</summary>
    int MergeSomeSegments(int maxMerge) { return this.kv.MergeSomeSegments(maxMerge); }

    /// <summary>开启自动增量归并：固化新段后段数达 atSegs 就归并
    /// 最老 mergeK 段（0 = 关闭，默认）。见
    /// <see cref="ZanStore.SetAutoMerge"/>。</summary>
    void SetAutoMerge(int atSegs, int mergeK) { this.kv.SetAutoMerge(atSegs, mergeK); }

    /// 关闭底层存储与读写锁。
    void Close() {
        this.kv.Close();
        this.rw.Close();
    }
}
