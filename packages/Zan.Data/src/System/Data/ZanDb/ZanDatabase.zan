using System;
using System.Json;
using System.Threading;
namespace System.Data.ZanDb;

public class ZanDatabase : IDisposable {
    // 并发模型：rw 是协程闸（配 await），tlock 是线程读写锁（读共享/
    // 写排他、写优先）。集合与检索门面都在 tlock 下运行；Begin/Commit/
    // Rollback/InTransaction/GetRevision/CacheVersion/SetSyncEvery/Close
    // 直通 kv 原语不受锁保护——调用方自行串行（手工事务纪律不变）。
    public ZanStore kv;
    public AsyncRwLock rw;
    public RwLock tlock;
    public List<CollectionEntry> entries;
    public List<VectorTableEntry> vectorTables;
    public List<RecordTableEntry> recordTables;
    public string lastError;

    public ZanDatabase() {
        this.entries = new List<CollectionEntry>();
        this.vectorTables = new List<VectorTableEntry>();
        this.recordTables = new List<RecordTableEntry>();
        this.lastError = "";
    }

    // 以默认参数打开（不存在则创建）：分组提交档、
    // 64MB 固化阈值、32MB 块缓存。
    public static ZanDatabase Open(string path) {
        return ZanDatabase.Open(path, ZanStore.DUR_GROUP);
    }

    // 以显式持久化档打开（不存在则创建）：
    // <see cref="ZanStore.DUR_SYNC"/> 每次提交 fsync、
    // <see cref="ZanStore.DUR_GROUP"/> 分组提交、
    // <see cref="ZanStore.DUR_NONE"/> 缓冲落盘。打开失败时
    // <see cref="IsOpen"/> 为 false，原因见 <see cref="GetError"/>。
    public static ZanDatabase Open(string path, int durability) {
        ZanDatabase d = new ZanDatabase();
        d.kv = ZanStore.Open(path, durability);
        if (!d.kv.IsOpen()) { d.lastError = d.kv.GetError(); }
        d.rw = new AsyncRwLock();
        d.tlock = new RwLock();
        return d;
    }

    // 打开是否成功（失败原因见 <see cref="GetError"/>）。
    public bool IsOpen() { return this.lastError == "" && this.kv != null && this.kv.IsOpen(); }

    // 打开及后续读写/维护失败的诊断。
    public string GetError() {
        return this.kv != null && this.kv.GetError() != "" ? this.kv.GetError() : this.lastError;
    }

    // fsync 频率：1 = 每次提交，N = 分组提交。
    public void SetSyncEvery(int n) { this.kv.SetSyncEvery(n); }

    // 返回指定名称的文档集合（惰性创建）。
    public Collection GetCollection(string name) {
        this.tlock.EnterWrite();
        try {
        return GetCollectionLocked(name);
        } finally { this.tlock.ExitWrite(); }
    }

    // 刀12：GetCollection 的持锁实现（公开壳持有整库线程读写锁；内部互调走本变体）。
    public Collection GetCollectionLocked(string name) {
        for (int i = 0; i < this.entries.Count; i = i + 1) {
            if (this.entries[i].name == name) { return this.entries[i].collection; }
        }
        Collection c = Collection.Attach(this.kv, this.rw, this.tlock, name);
        this.entries.Add(new CollectionEntry(name, c));
        return c;
    }

    // 刀14：返回指定名称的专用列式向量表（惰性打开或创建）。
    public VectorTable GetVectorTable(string name, int dimensions, int metric = 0, bool quantize = true) {
        return this.GetVectorTable(name, new VectorIndexOptions(dimensions, metric, quantize));
    }

    public VectorTable GetVectorTable(string name, VectorIndexOptions options) {
        this.tlock.EnterWrite();
        try {
            return this.GetVectorTableLocked(name, options);
        } finally { this.tlock.ExitWrite(); }
    }

    public VectorTable GetVectorTableLocked(string name, VectorIndexOptions options) {
        for (int i = 0; i < this.vectorTables.Count; i = i + 1) {
            if (this.vectorTables[i].name == name) { return this.vectorTables[i].table; }
        }
        string basePath = this.kv != null ? this.kv.basePath : "";
        VectorTable vt = VectorTable.Open(basePath, name, options);
        this.vectorTables.Add(new VectorTableEntry(name, vt));
        return vt;
    }

    // 返回指定名称的纯二进制结构化表格（RecordTable），零 JsonValue 装箱
    public RecordTable GetRecordTable(string name, RecordSchema schema = null) {
        this.tlock.EnterWrite();
        try {
            return this.GetRecordTableLocked(name, schema);
        } finally { this.tlock.ExitWrite(); }
    }

    public RecordTable GetRecordTableLocked(string name, RecordSchema schema = null) {
        for (int i = 0; i < this.recordTables.Count; i = i + 1) {
            if (this.recordTables[i].name == name) { return this.recordTables[i].table; }
        }
        string basePath = this.kv != null ? this.kv.basePath : "";
        RecordTable rt = RecordTable.Open(basePath, name, schema);
        this.recordTables.Add(new RecordTableEntry(name, rt));
        return rt;
    }

    // 直接访问底层的键/值存储。
    public ZanStore Kv() { return this.kv; }

    // 全库巡检：内核段 CRC/WAL/清单双槽 + 已加载集合的快照代
    // 审计。只读不修复；返回问题清单，空 = 健康。
    public List<string> IntegrityCheck() {
        this.tlock.EnterRead();
        try {
        List<string> problems = this.kv.IntegrityCheck();
        for (int i = 0; i < this.entries.Count; i = i + 1) {
            this.entries[i].collection.search.AuditSnapshots(problems);
        }
        for (int i = 0; i < this.vectorTables.Count; i = i + 1) {
            VectorTable vt = this.vectorTables[i].table;
            if (!vt.IsOpen()) {
                problems.Add("vector table " + this.vectorTables[i].name + " is not open: " + vt.GetError());
            } else if (vt.TotalRows() < vt.Count()) {
                problems.Add("vector table " + this.vectorTables[i].name + " count inconsistent");
            }
        }
        for (int i = 0; i < this.recordTables.Count; i = i + 1) {
            RecordTable rt = this.recordTables[i].table;
            if (!rt.IsOpen()) {
                problems.Add("record table " + this.recordTables[i].name + " is not open: " + rt.GetError());
            } else if (rt.TotalRows() < rt.Count()) {
                problems.Add("record table " + this.recordTables[i].name + " count inconsistent");
            }
        }
        return problems;
        } finally { this.tlock.ExitRead(); }
    }

    // 将后续写入批量合并为一次原子提交（协调底座 KV 与所有已挂载 RecordTable）。
    public void Begin() {
        this.kv.Begin();
        for (int i = 0; i < this.recordTables.Count; i = i + 1) {
            this.recordTables[i].table.BeginTransaction();
        }
    }

    // 外层非空提交推进修订号；嵌套 true 仅表示仍暂存。
    // 可比较 GetRevision/CacheVersion 的前后值决定是否通知外部缓存。
    public bool Commit() {
        bool ok = this.kv.Commit();
        for (int i = 0; i < this.recordTables.Count; i = i + 1) {
            this.recordTables[i].table.Commit();
        }
        return ok;
    }

    // 丢弃最外层批次的全部暂存写入，同时使事务读缓存失效。
    public void Rollback() {
        this.kv.Rollback();
        for (int i = 0; i < this.recordTables.Count; i = i + 1) {
            this.recordTables[i].table.Rollback();
        }
    }
    public bool InTransaction() { return this.kv.InTransaction(); }
    public long GetRevision() { return this.kv.GetRevision(); }
    public long CacheVersion() { return this.kv.CacheVersion(); }

    // 将迄今写入的内容强制落盘到稳定存储。
    public void Checkpoint() {
        this.tlock.EnterWrite();
        try {
            this.kv.Checkpoint();
            for (int i = 0; i < this.vectorTables.Count; i = i + 1) {
                this.vectorTables[i].table.Flush();
            }
            for (int i = 0; i < this.recordTables.Count; i = i + 1) {
                this.recordTables[i].table.Flush();
            }
        } finally { this.tlock.ExitWrite(); }
    }

    // 把 memtable 中尚未固化的写入立即固化为新段
    // （不归并）：归并/维护与「稳态查询」前置步骤——memtable
    // 空了聚合与计数才走块级内核，否则退化为归并扫描。见
    public void Flush() {
        this.tlock.EnterWrite();
        try {
            this.kv.FlushToSegment();
            for (int i = 0; i < this.vectorTables.Count; i = i + 1) {
                this.vectorTables[i].table.Flush();
            }
            for (int i = 0; i < this.recordTables.Count; i = i + 1) {
                this.recordTables[i].table.Flush();
            }
        } finally { this.tlock.ExitWrite(); }
    }

    // 把全部已固化段归并为一个段：掉落被新版压住的
    // 旧版本与已无意义的墓碑，回收存储空间。见
    public void MergeSegments() {
        this.tlock.EnterWrite();
        try {
        this.kv.MergeSegments();
        } finally { this.tlock.ExitWrite(); }
    }

    // 当前已固化段数（观测/运维用）。
    public int SegCount() {
        this.tlock.EnterRead();
        try { return this.kv.SegCount(); }
        finally { this.tlock.ExitRead(); }
    }

    // 增量归并：把最老 maxMerge（≥2）个段归并为一个，
    // 写阻塞被归并集规模封顶，反复调用收敛为单段。返回实际归并
    // 的段数（0 = 段不足 2 或在事务中）。见
    public int MergeSomeSegments(int maxMerge) {
        this.tlock.EnterWrite();
        try { return this.kv.MergeSomeSegments(maxMerge); }
        finally { this.tlock.ExitWrite(); }
    }

    // 开启自动增量归并：固化新段后段数达 atSegs 就归并
    // 最老 mergeK 段（0 = 关闭，默认）。见
    public void SetAutoMerge(int atSegs, int mergeK) {
        this.tlock.EnterWrite();
        try { this.kv.SetAutoMerge(atSegs, mergeK); }
        finally { this.tlock.ExitWrite(); }
    }

    // 热备份 / 一致快照导出（SQLite backup API 对位）：
    // 锁内原子截取底层 KV 存储与检索检查点，导出到目标路径并执行全库巡检审计。
    public void Backup(string targetPath) {
        this.tlock.EnterWrite();
        try {
            this.BackupLocked(targetPath);
        } finally {
            this.tlock.ExitWrite();
        }
    }

    // 刀12：Backup 的持锁实现（公开壳持有整库线程读写锁；内部互调走本变体）。
    public void BackupLocked(string targetPath) {
        if (!this.IsOpen()) {
            throw new InvalidOperationException("cannot backup closed database: " + this.GetError());
        }
        string target = Path.Normalize(targetPath);
        this.kv.Backup(target);

        // 刀14：备份伴生的 VectorTable 物理文件
        for (int i = 0; i < this.vectorTables.Count; i = i + 1) {
            VectorTable vt = this.vectorTables[i].table;
            vt.Flush();
            string srcVec = vt.vecPath;
            string dstVec = target + "." + this.vectorTables[i].name + ".zvec";
            if (File.Exists(srcVec)) {
                if (File.Exists(dstVec)) { File.Delete(dstVec); }
                File.Copy(srcVec, dstVec);
            }
            string srcHnsw = vt.hnswPath;
            string dstHnsw = target + "." + this.vectorTables[i].name + ".zhnsw";
            if (File.Exists(srcHnsw)) {
                if (File.Exists(dstHnsw)) { File.Delete(dstHnsw); }
                File.Copy(srcHnsw, dstHnsw);
            }
        }

        // 备份伴生的 RecordTable 物理文件
        for (int i = 0; i < this.recordTables.Count; i = i + 1) {
            RecordTable rt = this.recordTables[i].table;
            rt.Flush();
            string srcTab = rt.tabPath;
            string dstTab = target + "." + this.recordTables[i].name + ".ztab";
            if (File.Exists(srcTab)) {
                if (File.Exists(dstTab)) { File.Delete(dstTab); }
                File.Copy(srcTab, dstTab);
            }
            string srcBlob = rt.blobPath;
            string dstBlob = target + "." + this.recordTables[i].name + ".zblob";
            if (File.Exists(srcBlob)) {
                if (File.Exists(dstBlob)) { File.Delete(dstBlob); }
                File.Copy(srcBlob, dstBlob);
            }
            string srcIdx = rt.idxPath;
            string dstIdx = target + "." + this.recordTables[i].name + ".zidx";
            if (File.Exists(srcIdx)) {
                if (File.Exists(dstIdx)) { File.Delete(dstIdx); }
                File.Copy(srcIdx, dstIdx);
            }
            string srcWal = rt.walPath;
            string dstWal = target + "." + this.recordTables[i].name + ".zwal";
            if (File.Exists(srcWal)) {
                if (File.Exists(dstWal)) { File.Delete(dstWal); }
                File.Copy(srcWal, dstWal);
            }
        }

        // 对导出的数据库做全库巡检审计（包含已注册集合的索引代审计、向量表与表格校验）
        ZanDatabase probe = ZanDatabase.Open(target, ZanStore.DUR_SYNC);
        if (!probe.IsOpen()) {
            string err = probe.GetError();
            probe.Close();
            ZanStore.CleanTargetFiles(target, 256);
            this.CleanTargetVectorFiles(target);
            this.CleanTargetRecordFiles(target);
            throw new IOException("backup database probe failed: " + err);
        }
        for (int i = 0; i < this.entries.Count; i = i + 1) {
            probe.GetCollection(this.entries[i].name);
        }
        for (int i = 0; i < this.vectorTables.Count; i = i + 1) {
            probe.GetVectorTable(this.vectorTables[i].name, this.vectorTables[i].table.options);
        }
        for (int i = 0; i < this.recordTables.Count; i = i + 1) {
            probe.GetRecordTable(this.recordTables[i].name);
        }
        List<string> problems = probe.IntegrityCheck();
        probe.Close();
        if (problems.Count > 0) {
            ZanStore.CleanTargetFiles(target, 256);
            this.CleanTargetVectorFiles(target);
            this.CleanTargetRecordFiles(target);
            string msg = "";
            for (int i = 0; i < problems.Count; i = i + 1) {
                if (i > 0) { msg = msg + "; "; }
                msg = msg + problems[i];
            }
            throw new IOException("backup database integrity check failed: " + msg);
        }
    }

    public void CleanTargetVectorFiles(string target) {
        for (int i = 0; i < this.vectorTables.Count; i = i + 1) {
            string dstVec = target + "." + this.vectorTables[i].name + ".zvec";
            if (File.Exists(dstVec)) { File.Delete(dstVec); }
            string dstHnsw = target + "." + this.vectorTables[i].name + ".zhnsw";
            if (File.Exists(dstHnsw)) { File.Delete(dstHnsw); }
        }
    }

    public void CleanTargetRecordFiles(string target) {
        for (int i = 0; i < this.recordTables.Count; i = i + 1) {
            string dstTab = target + "." + this.recordTables[i].name + ".ztab";
            if (File.Exists(dstTab)) { File.Delete(dstTab); }
            string dstBlob = target + "." + this.recordTables[i].name + ".zblob";
            if (File.Exists(dstBlob)) { File.Delete(dstBlob); }
            string dstIdx = target + "." + this.recordTables[i].name + ".zidx";
            if (File.Exists(dstIdx)) { File.Delete(dstIdx); }
            string dstWal = target + "." + this.recordTables[i].name + ".zwal";
            if (File.Exists(dstWal)) { File.Delete(dstWal); }
        }
    }

    // 协程异步热备份（排他写锁保护）
    public async void BackupAsync(string targetPath) {
        await this.rw.EnterWrite();
        this.tlock.EnterWrite();
        try {
            this.BackupLocked(targetPath);
        } finally {
            this.tlock.ExitWrite();
            this.rw.ExitWrite();
        }
    }

    // 关闭底层存储与读写锁。
    public void Close() {
        for (int i = 0; i < this.vectorTables.Count; i = i + 1) {
            this.vectorTables[i].table.Close();
        }
        for (int i = 0; i < this.recordTables.Count; i = i + 1) {
            this.recordTables[i].table.Close();
        }
        this.kv.Close();
        this.rw.Close();
        this.tlock.Close();
    }

    public void Dispose() {
        this.Close();
    }
}
