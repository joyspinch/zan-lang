using System;
using System.IO;
using System.Threading;
namespace System.Data.ZanDb;

public delegate string StoreUpdater(string current);
public delegate bool StoreVisit(string key, string val);
public delegate bool ScanRowVisit(ScanRow row);
public delegate void CrashHookDelegate(string phase);

public partial class ZanStore {
    // 进程外故障注入与崩溃模拟钩子（B-ID147 crash fuzz 专用，非空时在持久化关键窗口触发）。
    public static CrashHookDelegate CrashHook;
    // 每次提交都 fsync。
    public static int DUR_SYNC = 0;
    // 分组提交：按次数/字节数窗口 fsync。
    public static int DUR_GROUP = 1;
    // 只在 Checkpoint/Close 与缓冲攒满时落盘。
    public static int DUR_NONE = 2;

    // GROUP 档攒满这么多字节提前 fsync。
    public static int GROUP_FLUSH_BYTES = 524288;
    // NONE 档攒满这么多字节强制 flush 进 OS 缓存。
    public static int NONE_FLUSH_BYTES = 1048576;
    // 默认 memtable/日志 flush 阈值（字节）。
    public static long DEFAULT_FLUSH_THRESHOLD = 67108864;
    // 默认块缓存上限（字节）。
    public static long DEFAULT_CACHE_CAP = 33554432;
    // 块级内核的读跨度（字节）：一次 ReadAt 摊掉这么多的逐块
    // 系统调用——扫描/聚合路径的 IO 下限由它决定。
    public static int KERNEL_SPAN_BYTES = 262144;

    public LogFile log;
    public Dictionary<string, string> memtable;
    public Dictionary<string, long> index;
    public List<SegRef> segs;
    public Manifest man;
    public string basePath;
    public BlockCache cache;
    public AsyncRwLock rw;
    public int durability;
    public int syncEvery;
    public int commitsSinceSync;
    public long bytesSinceSync;
    public long seq;
    public long cacheEpoch;
    public long lockHandle;
    public bool closed;
    public long logStartSeq;
    public long nextSegId;
    public long flushThreshold;
    public long recoverSeg;
    public int txDepth;
    public static int BATCH_VERSION = 1;
    public static int BATCH_HEADER_LEN = 17;
    public Dictionary<string, string> txPut;
    public Dictionary<string, string> txDel;
    // 未固化墓碑：删掉的键在旧段里仍有旧版本，固化时
    // 必须把 op=2 记录写进新段压住它们，否则恢复扫描会让已删
    // 键复活（旧段版本重指索引）。
    public Dictionary<string, long> tombstones;
    // 自动增量归并阈值：固化后段数 ≥ autoMergeAt 时就地
    // 归并 autoMergeK 个最老段。0 = 关闭（默认）——归并代价显式
    // 交还调用方，自动策略只应被明确开启。
    public int autoMergeAt;
    public int autoMergeK;
    public string lastError;

    public ZanStore() {
        this.memtable = new Dictionary<string, string>();
        this.index = new Dictionary<string, long>();
        this.segs = new List<SegRef>();
        this.txPut = new Dictionary<string, string>();
        this.txDel = new Dictionary<string, string>();
        this.tombstones = new Dictionary<string, long>();
        this.cache = new BlockCache(ZanStore.DEFAULT_CACHE_CAP);
        this.rw = new AsyncRwLock();
        this.durability = ZanStore.DUR_GROUP;
        this.syncEvery = 32;
        this.commitsSinceSync = 0;
        this.bytesSinceSync = 0;
        this.seq = 0;
        this.cacheEpoch = 0;
        this.lockHandle = 0;
        this.closed = false;
        this.logStartSeq = 0;
        this.nextSegId = 0;
        this.flushThreshold = ZanStore.DEFAULT_FLUSH_THRESHOLD;
        this.recoverSeg = 0;
        this.txDepth = 0;
        this.autoMergeAt = 0;
        this.autoMergeK = 0;
        this.basePath = "";
        this.lastError = "";
    }

    public static string SegPath(string basePath, long id) {
        return basePath + ".s" + Convert.ToString(id);
    }

    // 基础路径的目录段：无分隔符视为当前目录。
    public static string DirOf(string basePath) {
        int cut = -1;
        for (int i = 0; i < basePath.Length; i = i + 1) {
            char ch = basePath[i];
            if (ch == '/' || ch == 92) { cut = i; }  // 92 = 反斜杠
        }
        if (cut < 0) { return "."; }
        // 根目录必须保留分隔符；C: 是盘符当前目录，不是 C:/ 根目录。
        if (cut == 0 || (cut == 2 && basePath[1] == ':')) {
            return basePath.Substring(0, cut + 1);
        }
        return basePath.Substring(0, cut);
    }

    // 巡检用恒真扫描回调：只驱动逐块 CRC 校验，不收集内容。
    public static SegVisit KeepVisit = (string key, string val, int op) => { return true; };

    // 打开（必要时创建）分组提交档的存储。
    public static ZanStore Open(string path) {
        return ZanStore.Open(path, ZanStore.DUR_GROUP);
    }

    // 先取得持久 .lock 文件的系统锁，再打开 WAL/清单/段。
    // Path.Normalize 只统一分隔符；调用者必须使用同一规范路径，不能
    // 用符号链接、硬链接或不同目录别名指向同一 WAL。锁文件不删除。
    public static ZanStore Open(string path, int durability) {
        ZanStore s = new ZanStore();
        s.durability = durability;
        s.basePath = Path.Normalize(path);
        if (s.basePath == "") { s.Fail("store path is empty"); return s; }
        s.lockHandle = File.TryLock(s.basePath + ".lock");
        if (s.lockHandle == 0) {
            s.Fail("store is locked or its lock file cannot be opened");
            return s;
        }
        try {
            s.log = LogFile.Open(s.basePath);
            if (!s.log.IsOpen()) { s.Fail(s.log.GetError()); return s; }
            // WAL 锁保留为兼容守卫：旧版写入者尚不认识稳定 .lock。
            if (!s.log.TryLockExclusive()) {
                s.Fail("store is locked by another writer");
                return s;
            }
            // 每次打开都确认 WAL 目录项，不能假定已有路径已被上次进程同步。
            // Store 不创建目录；调用者负责先持久化其创建的父目录链。
            // 屏障先于任何提交/Checkpoint/Close 的文件同步成功确认。
            if (!PageFile.DirSync(ZanStore.DirOf(s.basePath))) {
                s.Fail("WAL directory sync failed");
                return s;
            }
            s.man = Manifest.Load(s.basePath);
            if (s.man.GetError() != "") { s.Fail(s.man.GetError()); return s; }
            if (s.man.Exists()) {
                s.logStartSeq = s.man.LogStartSeq();
                s.seq = s.logStartSeq;
                s.nextSegId = s.man.NextSegId();
                List<long> ids = s.man.SegIds();
                for (int i = 0; i < ids.Count; i = i + 1) {
                    SegmentFile sf = SegmentFile.Open(ZanStore.SegPath(s.basePath, ids[i]));
                    s.segs.Add(new SegRef(sf, ids[i]));
                    if (sf.GetError() != "") {
                        s.Fail("segment " + Convert.ToString(ids[i]) + ": " + sf.GetError());
                        return s;
                    }
                    s.recoverSeg = ids[i];
                    int scanned = sf.Scan("", s.RecoverRecord);
                    if (sf.GetError() != "" || (long)scanned != sf.Count()) {
                        s.Fail("segment recovery failed: " + sf.GetError());
                        return s;
                    }
                }
            }
            if (s.log.Replay(s.ApplyFrame) < 0 || s.lastError != "") {
                s.Fail(s.lastError != "" ? s.lastError : s.log.GetError());
                return s;
            }
            s.cacheEpoch = s.seq;
        } catch (Exception ex) {
            // Open 的错误值契约：保留诊断并释放本句柄的全部资源。
            s.Fail("store recovery failed: " + ex.Message);
        }
        return s;
    }

    // 恢复扫描回调：段内记录重指索引（段按号升序扫描，
    // 后段覆盖前段；墓碑摘除索引，为合并输出预留）。
    public bool RecoverRecord(string key, string val, int op) {
        if (op == 2) {
            if (this.index.ContainsKey(key)) { this.index.Remove(key); }
            return true;
        }
        if (this.index.ContainsKey(key)) { this.index.Remove(key); }
        this.index.Add(key, this.recoverSeg);
        return true;
    }

    // 不物化字符串地验证完整长度，避免 ReadString 的 long→int
    // 转换吞掉恶意高位；合法帧的长度前缀最多需要 5 个字节。
    public static bool SkipWalString(ByteBuffer b) {
        int at = b.ReadPos();
        int next = at;
        long n = b.ReadVarIntAt(at, out next);
        if (n < 0 || next <= at || next - at > 5 || n > b.Length() - next) { return false; }
        b.SeekRead(next + (int)n);
        return true;
    }

    // 校验全部记录后才允许应用，CRC 有效并不等于载荷有效。
    public static bool ValidFrame(ByteBuffer b) {
        b.SeekRead(0);
        if (!b.CanRead(9)) { return false; }
        long fseq = b.ReadU64();
        if (fseq < 0 || fseq == 9223372036854775807) { return false; }
        int op = b.ReadU8();
        long count = 1;
        bool batch = op == 3;
        if (batch) {
            if (!b.CanRead(8) || b.ReadU32() != ZanStore.BATCH_VERSION) { return false; }
            count = b.ReadU32();
            if (count == 0 || count > b.Remaining() / 2) { return false; }
        } else if (op != 1 && op != 2) { return false; }
        for (long i = 0; i < count; i = i + 1) {
            if (batch) {
                if (!b.CanRead(1)) { return false; }
                op = b.ReadU8();
            }
            if (op != 1 && op != 2) { return false; }
            if (!ZanStore.SkipWalString(b)) { return false; }
            if (op == 1 && !ZanStore.SkipWalString(b)) { return false; }
        }
        return b.Remaining() == 0;
    }

    // 新格式：seq:u64, op=3:u8, version:u32, count:u32，随后每条
    // op:u8 + WriteString(key)，put 再跟 WriteString(val)。旧 op1/2 兼容。
    public bool ApplyFrame(ByteBuffer b) {
        if (!ZanStore.ValidFrame(b)) {
            this.lastError = "invalid WAL record or batch";
            return false;
        }
        b.SeekRead(0);
        long fseq = b.ReadU64();
        if (fseq < this.logStartSeq) { return true; }
        if (fseq < this.seq) { this.lastError = "WAL sequence went backwards"; return false; }
        int op = b.ReadU8();
        long count = 1;
        bool batch = op == 3;
        if (batch) { b.ReadU32(); count = b.ReadU32(); }
        for (long i = 0; i < count; i = i + 1) {
            if (batch) { op = b.ReadU8(); }
            string key = b.ReadString();
            string val = op == 1 ? b.ReadString() : "";
            this.ApplyRecord(op, key, val);
        }
        this.seq = fseq + 1;
        return true;
    }

    public void ApplyRecord(int op, string key, string val) {
        if (op == 1) {
            this.memtable.Remove(key);
            this.tombstones.Remove(key);
            this.memtable.Add(key, val);
        } else {
            this.memtable.Remove(key);
            this.index.Remove(key);
            if (!this.tombstones.ContainsKey(key)) { this.tombstones.Add(key, 0); }
        }
    }

    public bool IsOpen() {
        return !this.closed && this.lastError == "" && this.log != null && this.log.IsOpen();
    }

    // 打开/读写/维护失败的诊断；失败句柄不再接收写入。
    public string GetError() { return this.lastError; }

    // 已提交版本：每个非空外层批次只推进一次，回滚不推进。
    public long Version() { return this.seq; }
    public long GetRevision() { return this.seq; }
    public bool InTransaction() { return this.txDepth > 0; }
    // 缓存失效代数：外层提交及回滚后改变；事务中读缓存应禁用。
    public long CacheVersion() { return this.cacheEpoch; }

    // 键值对总数：索引（已落段）+ memtable 中尚未落段的新键。
    public int Count() {
        if (!this.IsOpen()) { return 0; }
        int n = this.index.Count;
        List<string> mk = this.memtable.Keys;
        for (int i = 0; i < mk.Count; i = i + 1) {
            if (!this.index.ContainsKey(mk[i])) { n = n + 1; }
        }
        return n;
    }

    // 已固化段的数量。
    public int SegCount() { return this.segs.Count; }

    // 日志逻辑大小（字节）：0 表示全部数据已在段里。
    public long LogBytes() { return this.log != null ? this.log.Size() : -1; }

    // 切换持久化档（立即生效）。
    public void SetDurability(int d) { this.durability = d; }

    // GROUP 档的 fsync 窗口：N = 每 N 次提交至多
    // 一次 fsync（攒满 <see cref="GROUP_FLUSH_BYTES"/> 字节会提前）。
    public void SetSyncEvery(int n) {
        if (n >= 1) { this.syncEvery = n; }
    }

    // memtable/日志 flush 阈值（字节）：日志攒到该值
    // 即固化新段。默认 64MB；调小是合法配置（=1 即每次提交
    // 都固化），只拒绝非正数。
    public void SetFlushThreshold(long bytes) {
        if (bytes >= 1) { this.flushThreshold = bytes; }
    }

    // 块缓存字节上限。默认 32MB；调小是合法配置
    // （缓存退化到直读），只拒绝非正数。
    public void SetCacheCap(long bytes) {
        if (bytes >= 1) { this.cache.SetCap(bytes); }
    }

    // 开启自动增量归并：每次固化新段后若段数达到
    // <paramref name="atSegs"/>，就地归并最老的
    // <paramref name="mergeK"/> 个段（同
    // <see cref="MergeSomeSegments"/>，有界停顿=写 k 段的耗时）。
    // atSegs ≥ max(3, mergeK+1) 才生效——阈值太低会每次固化都
    // 归并、得不偿失；atSegs = 0 关闭（默认）。段数稳态在
    // [atSegs-mergeK+1, atSegs] 间振荡，不再无界增长。
    public void SetAutoMerge(int atSegs, int mergeK) {
        if (atSegs <= 0) { this.autoMergeAt = 0; this.autoMergeK = 0; return; }
        if (mergeK < 2) { return; }
        if (atSegs < mergeK + 1) { return; }
        this.autoMergeAt = atSegs;
        this.autoMergeK = mergeK;
    }

    // ===== 同步核心（单所有者，无锁） =====

    // 返回值；不存在时返回 ""（与「值为空串」不可区分，
    // 需要区分时用 <see cref="Contains"/>）。事务内可见未提交的
    // 本事务写入。
    public string Get(string key) {
        if (!this.IsOpen()) { return ""; }
        if (this.txDepth > 0) {
            if (this.txDel.ContainsKey(key)) { return ""; }
            string tv = "";
            if (this.txPut.TryGetValue(key, out tv)) { return tv; }
        }
        string mv = "";
        if (this.memtable.TryGetValue(key, out mv)) { return mv; }
        long segId = 0;
        if (this.index.TryGetValue(key, out segId)) {
            SegRef r = this.FindSeg(segId);
            if (r != null) {
                string sv = "";
                int hit = r.seg.Lookup(key, out sv, this.cache, segId);
                if (r.seg.GetError() != "") { this.Fail(r.seg.GetError()); return ""; }
                if (hit == 1) { return sv; }
            }
        }
        return "";
    }

    // 键是否存在。
    public bool Contains(string key) {
        if (!this.IsOpen()) { return false; }
        if (this.txDepth > 0) {
            if (this.txDel.ContainsKey(key)) { return false; }
            if (this.txPut.ContainsKey(key)) { return true; }
        }
        if (this.memtable.ContainsKey(key)) { return true; }
        return this.index.ContainsKey(key);
    }

    // 事务内只暂存最终值；自动提交走同一批次路径。
    // 失败抛 IOException，并通过 GetError 留下诊断。
    public void Put(string key, string val) {
        if (!this.WriteReady()) { throw new IOException(this.GetError()); }
        bool automatic = this.txDepth == 0;
        if (automatic) { this.Begin(); }
        this.txDel.Remove(key);
        this.txPut.Remove(key);
        this.txPut.Add(key, val);
        if (automatic && !this.Commit()) { throw new IOException(this.GetError()); }
    }

    // 删除存在的键；事务内 true 表示暂存，自动提交失败返回 false。
    public bool Delete(string key) {
        if (!this.WriteReady() || !this.Contains(key)) { return false; }
        bool automatic = this.txDepth == 0;
        if (automatic) { this.Begin(); }
        this.txPut.Remove(key);
        this.txDel.Remove(key);
        this.txDel.Add(key, "");
        return !automatic || this.Commit();
    }

    // 写入仅进入覆盖层；嵌套批次由最外层一次性提交。
    public void Begin() {
        if (!this.WriteReady()) { throw new IOException(this.GetError()); }
        this.txDepth = this.txDepth + 1;
    }

    // 最外层非空批次写一个 CRC 帧，按持久化档落盘成功后
    // 才发布 memtable 和版本。嵌套 true 仅表示仍在暂存；空批次不推进。
    // I/O 失败返回 false 并关闭写入。若自动固化在 WAL 提交后失败，
    // false 的结果可能已提交，调用者应重开并检查修订号。
    public bool Commit() {
        if (!this.WriteReady()) { return false; }
        if (this.txDepth == 0) { return true; }
        this.txDepth = this.txDepth - 1;
        if (this.txDepth > 0) { return true; }
        if (this.txPut.Count == 0 && this.txDel.Count == 0) { return true; }
        if (this.seq == 9223372036854775807) { this.Fail("store revision exhausted"); return false; }
        ByteBuffer b = null;
        try {
            b = this.BuildTxFrame();
            if (b == null) { return false; }
            int bytes = b.Length() + LogFile.HEADER_LEN;
            if (ZanStore.CrashHook != null) { ZanStore.CrashHook("wal_before_commit"); }
            if (!this.log.AppendFrame(b) || !this.PersistCommit(bytes)) {
                this.Fail(this.log.GetError());
                return false;
            }
            if (ZanStore.CrashHook != null) { ZanStore.CrashHook("wal_after_append"); }
            this.MergeTxOverlay();
            this.seq = this.seq + 1;
            this.cacheEpoch = this.cacheEpoch + 1;
            long logBytes = this.log.Size();
            if (logBytes < 0) { this.Fail(this.log.GetError()); return false; }
            if (logBytes >= this.flushThreshold) { this.FlushToSegment(); }
            return this.IsOpen();
        } catch (Exception ex) {
            // bool 提交契约：丢弃覆盖层、关闭失败句柄，保留真实诊断。
            this.Fail("store commit failed: " + ex.Message);
            return false;
        } finally {
            if (b != null) { b.Free(); }
        }
    }

    public static int VarIntBytes(long n) {
        int bytes = 1;
        while (n >= 128) { n = n >> 7; bytes = bytes + 1; }
        return bytes;
    }

    // 在分配/追加之前计算精确大小，不让多键批次绕过帧上限。
    public ByteBuffer BuildTxFrame() {
        List<string> dk = this.txDel.Keys;
        List<string> pk = this.txPut.Keys;
        long size = ZanStore.BATCH_HEADER_LEN;
        for (int i = 0; i < dk.Count; i = i + 1) {
            size = size + 1 + ZanStore.VarIntBytes(dk[i].Length) + dk[i].Length;
            if (size > LogFile.MAX_FRAME) { this.Fail("WAL batch exceeds maximum payload"); return null; }
        }
        for (int i = 0; i < pk.Count; i = i + 1) {
            string v = "";
            this.txPut.TryGetValue(pk[i], out v);
            size = size + 1 + ZanStore.VarIntBytes(pk[i].Length) + pk[i].Length
            + ZanStore.VarIntBytes(v.Length) + v.Length;
            if (size > LogFile.MAX_FRAME) { this.Fail("WAL batch exceeds maximum payload"); return null; }
        }
        ByteBuffer b = ByteBuffer.Alloc((int)size);
        b.WriteU64(this.seq);
        b.WriteU8(3);
        b.WriteU32(ZanStore.BATCH_VERSION);
        b.WriteU32((long)dk.Count + pk.Count);
        for (int i = 0; i < dk.Count; i = i + 1) {
            b.WriteU8(2);
            b.WriteString(dk[i]);
        }
        for (int i = 0; i < pk.Count; i = i + 1) {
            string v = "";
            this.txPut.TryGetValue(pk[i], out v);
            b.WriteU8(1);
            b.WriteString(pk[i]);
            b.WriteString(v);
        }
        return b;
    }

    // 回滚覆盖层；缓冲中从未写入本事务，既有已提交待写帧不受影响。
    public void Rollback() {
        if (this.txDepth == 0) { return; }
        this.txDepth = 0;
        this.txPut.Clear();
        this.txDel.Clear();
        this.cacheEpoch = this.cacheEpoch + 1;
    }

    public void MergeTxOverlay() {
        List<string> dk = this.txDel.Keys;
        for (int i = 0; i < dk.Count; i = i + 1) { this.ApplyRecord(2, dk[i], ""); }
        List<string> pk = this.txPut.Keys;
        for (int i = 0; i < pk.Count; i = i + 1) {
            string v = "";
            this.txPut.TryGetValue(pk[i], out v);
            this.ApplyRecord(1, pk[i], v);
        }
        this.txDel.Clear();
        this.txPut.Clear();
    }

    // 成功完成选定的持久化动作后才能发布覆盖层。GROUP 字节窗口
    // 记录已 flush 但未 sync 的量，不能在 Flush 清零后看 PendingBytes。
    public bool PersistCommit(int bytes) {
        if (this.durability == ZanStore.DUR_SYNC) {
            if (!this.log.Sync()) { return false; }
            this.commitsSinceSync = 0;
            this.bytesSinceSync = 0;
        } else if (this.durability == ZanStore.DUR_GROUP) {
            if (!this.log.Flush()) { return false; }
            this.commitsSinceSync = this.commitsSinceSync + 1;
            this.bytesSinceSync = this.bytesSinceSync + bytes;
            if (this.commitsSinceSync >= this.syncEvery || this.bytesSinceSync >= ZanStore.GROUP_FLUSH_BYTES) {
                if (!this.log.Sync()) { return false; }
                this.commitsSinceSync = 0;
                this.bytesSinceSync = 0;
            }
        } else if (this.log.PendingBytes() >= ZanStore.NONE_FLUSH_BYTES) {
            if (!this.log.Flush()) { return false; }
        }
        return true;
    }

    // 把 memtable 固化为新段：put 与未固化墓碑按键序
    // 合并写段 → fsync → 保存 manifest（水位 = 当前 seq）→ 截断
    // 日志。墓碑必须随段持久化：被删键在旧段里仍有旧版本，没有
    // 新段墓碑压住，恢复扫描就会把它复活。任一步失败都保持日志
    // 兜底（旧 manifest + 完整日志 = 完好状态）；成功后日志归零。
    // 须在写侧串行环境调用（同步核心即满足；协程请走
    public void FlushToSegment() {
        if (!this.WriteReady() || this.txDepth > 0) { return; }
        long logBytes = this.log.Size();
        if (logBytes < 0) { this.Fail(this.log.GetError()); return; }
        if (this.memtable.Count == 0 && this.tombstones.Count == 0 && logBytes == 0) { return; }
        // 维护失败也不得丢失此前 NONE 档的已提交待写帧。
        if (!this.log.Sync()) { this.Fail(this.log.GetError()); return; }
        if (this.memtable.Count == 0 && this.tombstones.Count == 0) {
            List<long> ids = this.SegIdList();
            if (!this.PublishBoth(this.seq, this.nextSegId, ids)) { return; }
            if (!this.log.Reset()) { this.Fail(this.log.GetError()); return; }
            this.logStartSeq = this.seq;
            this.commitsSinceSync = 0;
            this.bytesSinceSync = 0;
            return;
        }
        long segId = this.nextSegId;
        if (segId == 9223372036854775807) { this.Fail("store segment id exhausted"); return; }
        string segPath = ZanStore.SegPath(this.basePath, segId);
        File.Delete(segPath);
        List<string> keys = new List<string>();
        List<string> src = this.memtable.Keys;
        for (int i = 0; i < src.Count; i = i + 1) { keys.Add(src[i]); }
        List<string> tks = this.tombstones.Keys;
        for (int i = 0; i < tks.Count; i = i + 1) { keys.Add(tks[i]); }
        ZanStore.SortStrings(keys);
        SegmentWriter wtr = null;
        SegmentFile seg = null;
        bool published = false;
        bool adopted = false;
        try {
            wtr = SegmentWriter.Create(segPath);
            if (wtr.Failed()) { this.Fail(wtr.GetError()); return; }
            for (int i = 0; i < keys.Count; i = i + 1) {
                if (this.tombstones.ContainsKey(keys[i])) { wtr.Add(keys[i], "", 2); }
                else {
                    string v = "";
                    this.memtable.TryGetValue(keys[i], out v);
                    wtr.Add(keys[i], v, 1);
                }
            }
            if (!wtr.Finish()) { this.Fail(wtr.GetError()); return; }
            seg = SegmentFile.Open(segPath);
            if (seg.GetError() != "") { this.Fail(seg.GetError()); return; }
            // 段目录项持久化后再发布清单：断电最坏留下孤儿段
            // （同号覆盖），旧槽 + 完整日志仍可恢复。
            if (!PageFile.DirSync(ZanStore.DirOf(this.basePath))) {
                this.Fail("segment dir sync failed");
                return;
            }
            if (ZanStore.CrashHook != null) { ZanStore.CrashHook("flush_mid_seg"); }
            List<long> ids = this.SegIdList();
            ids.Add(segId);
            // 第一槽成功后新段已可能被引用，之后失败必须保留新段。
            published = true;
            if (!this.PublishBoth(this.seq, segId + 1, ids)) { return; }
            // 两个 fallback 槽都覆盖日志后才能截断，否则旧槽会缺恢复尾。
            if (!this.log.Reset()) { this.Fail(this.log.GetError()); return; }
            for (int i = 0; i < keys.Count; i = i + 1) {
                this.index.Remove(keys[i]);
                if (!this.tombstones.ContainsKey(keys[i])) { this.index.Add(keys[i], segId); }
            }
            this.memtable.Clear();
            this.tombstones.Clear();
            this.segs.Add(new SegRef(seg, segId));
            adopted = true;
            this.nextSegId = segId + 1;
            this.logStartSeq = this.seq;
            this.commitsSinceSync = 0;
            this.bytesSinceSync = 0;
            if (this.autoMergeAt > 0 && this.segs.Count >= this.autoMergeAt) {
                this.MergeSomeSegments(this.autoMergeK);
            }
        } catch (Exception ex) {
            // 维护的错误值契约：旧清单与 WAL 或新清单均可恢复。
            this.Fail("store flush failed: " + ex.Message);
        } finally {
            ZanStore.CloseWriter(wtr);
            if (seg != null && !adopted) { seg.Close(); }
            if (!published) { File.Delete(segPath); }
        }
    }

    // 批量直写段提交（刀5）：最外层非空批次不写 WAL 数据帧，把
    // 覆盖层排序后直接固化成新段发布——大数据导入免 WAL 双写、
    // 免 memtable 常驻（内存峰值减半），段只写一遍。语义契约：
    // 崩溃窗口全有或全无——覆盖层只在内存，日志先行 Sync 归零后
    // 写段，任一步失败/崩溃都回到导入前状态（旧清单 + 空日志，
    // 未发布孤儿段同号覆盖），调用方重跑导入即可；这与事务回滚
    // 一致的原子性，但已提交批崩溃后不恢复（WAL 通道才有恢复
    // 兜底）。memtable 非空先固化（保证数据不混两介质），空批次
    // 不推进。失败返回 false 并留诊断，调用方 Rollback。须在写侧
    // 串行环境调用。
    public bool CommitBulk() {
        if (!this.WriteReady()) { return false; }
        if (this.txDepth == 0) { return true; }
        this.txDepth = this.txDepth - 1;
        if (this.txDepth > 0) { return true; }
        if (this.txPut.Count == 0 && this.txDel.Count == 0) { return true; }
        if (this.seq == 9223372036854775807) { this.Fail("store revision exhausted"); return false; }
        // 既有 memtable 先固化：BulkLoad 只走段介质，覆盖层与其
        // 不混。空日志是崩溃窗口「回到导入前」的前提——日志若还
        // 有未固化已提交帧，崩溃后重放会把导入前的旧状态复活。
        this.FlushToSegment();
        if (!this.IsOpen()) { return false; }
        long logBytes = this.log.Size();
        if (logBytes < 0) { this.Fail(this.log.GetError()); return false; }
        if (logBytes > 0) { this.Fail("bulk commit requires an empty log"); return false; }
        if (!this.log.Sync()) { this.Fail(this.log.GetError()); return false; }
        long newSeq = this.seq + 1;
        long segId = this.nextSegId;
        if (segId == 9223372036854775807) { this.Fail("store segment id exhausted"); return false; }
        string segPath = ZanStore.SegPath(this.basePath, segId);
        File.Delete(segPath);
        List<string> keys = new List<string>();
        List<string> src = this.txPut.Keys;
        for (int i = 0; i < src.Count; i = i + 1) { keys.Add(src[i]); }
        List<string> tks = this.txDel.Keys;
        for (int i = 0; i < tks.Count; i = i + 1) { keys.Add(tks[i]); }
        ZanStore.SortStrings(keys);
        SegmentWriter wtr = null;
        SegmentFile seg = null;
        bool published = false;
        bool adopted = false;
        try {
            wtr = SegmentWriter.Create(segPath);
            if (wtr.Failed()) { this.Fail(wtr.GetError()); return false; }
            for (int i = 0; i < keys.Count; i = i + 1) {
                // 同键 put+del 并存时 del 胜（与事务覆盖层语义一致）。
                if (this.txDel.ContainsKey(keys[i])) { wtr.Add(keys[i], "", 2); }
                else {
                    string v = "";
                    this.txPut.TryGetValue(keys[i], out v);
                    wtr.Add(keys[i], v, 1);
                }
            }
            if (!wtr.Finish()) { this.Fail(wtr.GetError()); return false; }
            seg = SegmentFile.Open(segPath);
            if (seg.GetError() != "") { this.Fail(seg.GetError()); return false; }
            // 段目录项持久化后再发布清单：断电最坏留下孤儿段
            // （同号覆盖），旧清单 + 空日志 = 导入前状态。
            if (!PageFile.DirSync(ZanStore.DirOf(this.basePath))) {
                this.Fail("segment dir sync failed");
                return false;
            }
            List<long> ids = this.SegIdList();
            ids.Add(segId);
            published = true;
            if (!this.PublishBoth(newSeq, segId + 1, ids)) { return false; }
            if (!this.log.Reset()) { this.Fail(this.log.GetError()); return false; }
            for (int i = 0; i < keys.Count; i = i + 1) {
                this.index.Remove(keys[i]);
                if (!this.txDel.ContainsKey(keys[i])) { this.index.Add(keys[i], segId); }
            }
            this.segs.Add(new SegRef(seg, segId));
            adopted = true;
            this.nextSegId = segId + 1;
            this.seq = newSeq;
            this.cacheEpoch = this.cacheEpoch + 1;
            this.logStartSeq = newSeq;
            this.commitsSinceSync = 0;
            this.bytesSinceSync = 0;
            this.txDel.Clear();
            this.txPut.Clear();
            if (this.autoMergeAt > 0 && this.segs.Count >= this.autoMergeAt) {
                this.MergeSomeSegments(this.autoMergeK);
            }
            return this.IsOpen();
        } catch (Exception ex) {
            this.Fail("store bulk commit failed: " + ex.Message);
            return false;
        } finally {
            ZanStore.CloseWriter(wtr);
            if (seg != null && !adopted) { seg.Close(); }
            if (!published) { File.Delete(segPath); }
        }
    }

    // 覆盖两个 fallback 槽后，旧段/日志才能退休。第二次失败时
    // 第一份已发布，不可删除它引用的新段，也不可截断/删除旧介质。
    public bool PublishBoth(long logSeq, long nextId, List<long> ids) {        if (!this.man.Save(logSeq, nextId, ids)) { this.Fail(this.man.GetError()); return false; }
    // 第一槽目录项持久化后才能发布第二槽：POSIX 上新建文件的
    // fsync 不保证目录项落盘，两槽皆失等于整库拒开。
    if (!PageFile.DirSync(ZanStore.DirOf(this.basePath))) {
        this.Fail("manifest slot dir sync failed");
        return false;
    }
    if (ZanStore.CrashHook != null) { ZanStore.CrashHook("manifest_mid_slot"); }
    if (!this.man.Save(logSeq, nextId, ids)) { this.Fail(this.man.GetError()); return false; }
    return true;
}

public static void CloseWriter(SegmentWriter wtr) {
    if (wtr == null) { return; }
    if (wtr.file != null) { wtr.file.Close(); }
    if (wtr.buf != null) { wtr.buf.Free(); wtr.buf = null; }
}

// 把全部已固化段（≥2 个）归并为一个新段：同键只留
// 最新版本，墓碑直接掉落（归并集=全部段，不存在会复活的更老
// 版本），索引按归并结果重建。须在写侧串行环境调用且不在事务
// 中（协程请走 <see cref="MergeAsync"/>）；期间阻塞写入——
// 在线换段优化留待后续。崩溃窗口两段皆一致：段已写清单未换
// = 孤儿段，下次同号归并覆盖之；清单已换 = 旧段成孤儿（不再
// 被引用，仅占盘）。内存峰值 ≈ 存活键数（重建索引用）。
public void MergeSegments() {
    this.MergeSomeSegments(this.segs.Count);
}

// 独占锁下的 <see cref="MergeSegments"/>。
public async void MergeAsync() {
    await this.rw.EnterWrite();
    MergeSegments();
    this.rw.ExitWrite();
}

}
