using System;
using System.IO;
using System.Interop;
namespace System.Data.ZanDb;

public delegate bool SegVisit(string key, string val, int op);

public class SegmentFile {
    public static string MAGIC = "ZSEG";

    public PageFile file;
    public string path;
    public List<SegmentIndexEntry> entries;
    public long indexStart;
    public long recordCount;
    public string lastError;

    public SegmentFile() {
        this.path = "";
        this.indexStart = 0;
        this.recordCount = 0;
        this.lastError = "";
        this.entries = new List<SegmentIndexEntry>();
    }

    // 打开并校验一个已完成的段：读尾部定位索引区，
    // 加载稀疏索引与块 CRC。头部/尾部/索引损坏时报错，
    // 记录区损坏在读块时才发现。
    public static SegmentFile Open(string segPath) {
        SegmentFile sf = new SegmentFile();
        sf.path = segPath;
        if (!File.Exists(segPath)) { sf.lastError = "segment missing: " + segPath; return sf; }
        ByteBuffer tail = null;
        ByteBuffer head = null;
        ByteBuffer idx = null;
        ByteBuffer cnt = null;
        try {
            sf.file = PageFile.OpenExisting(segPath);
            if (!sf.file.IsOpen()) { sf.lastError = sf.file.GetError(); return sf; }
            long size = sf.file.Size();
            if (size < 0) { sf.lastError = sf.file.GetError(); return sf; }
            if (size < 32) { sf.lastError = "segment too short"; return sf; }
            tail = ByteBuffer.Alloc(12);
            if (sf.file.ReadAt(size - 12, tail, 12) != 12) {
                sf.lastError = "segment footer short read";
                return sf;
            }
            tail.SeekRead(0);
            long indexOff = tail.ReadU64();
            if (tail.Str(8, 4) != SegmentFile.MAGIC || indexOff < 16 || indexOff > size - 16) {
                sf.lastError = "segment footer corrupt";
                return sf;
            }
            head = ByteBuffer.Alloc(16);
            if (sf.file.ReadAt(0, head, 16) != 16) {
                sf.lastError = "segment header short read";
                return sf;
            }
            head.SeekRead(4);
            long ver = head.ReadU32();
            long count = head.ReadU64();
            if (head.Str(0, 4) != SegmentFile.MAGIC || ver != SegmentWriter.VERSION
                    || count < 0 || count > 2147483647) {
                sf.lastError = "segment header corrupt";
                return sf;
            }
            sf.recordCount = count;
            sf.indexStart = indexOff;
            long indexBytes = size - 16 - indexOff;
            if (indexBytes > 2147483647) { sf.lastError = "segment index exceeds bounds"; return sf; }
            int idxLen = (int)indexBytes;
            cnt = ByteBuffer.Alloc(4);
            if (sf.file.ReadAt(indexOff, cnt, 4) != 4) {
                sf.lastError = "segment index count short read";
                return sf;
            }
            cnt.SeekRead(0);
            long n = cnt.ReadU32();
            if (n > idxLen / 13 || (n == 0) != (count == 0)) {
                sf.lastError = "segment index count corrupt";
                return sf;
            }
            idx = ByteBuffer.Alloc(idxLen);
            if (sf.file.ReadAt(indexOff + 4, idx, idxLen) != idxLen) {
                sf.lastError = "segment index short read";
                return sf;
            }
            idx.SeekRead(0);
            long prevOff = 0;
            string prevKey = "";
            for (long i = 0; i < n; i = i + 1) {
                if (!idx.CanRead(13)) { sf.lastError = "segment index truncated"; return sf; }
                long off = idx.ReadU64();
                int at = idx.ReadPos();
                int keyAt = at;
                long keyLen = idx.ReadVarIntAt(at, out keyAt);
                if (keyLen < 0 || keyAt <= at || keyAt - at > 5 || keyLen > idx.Length() - keyAt - 4
                        || off < 16 || off >= indexOff || (i == 0 && off != 16) || (i > 0 && off <= prevOff)) {
                    sf.lastError = "segment index entry corrupt";
                    return sf;
                }
                string key = idx.Str(keyAt, (int)keyLen);
                if (i > 0 && String.CompareOrdinal(prevKey, key) >= 0) {
                    sf.lastError = "segment index key order corrupt";
                    return sf;
                }
                idx.SeekRead(keyAt + (int)keyLen);
                long crc = idx.ReadU32();
                sf.entries.Add(new SegmentIndexEntry(off, key, crc));
                prevOff = off;
                prevKey = key;
            }
            if (idx.Remaining() != 0 || (n == 0 && indexOff != 16)) {
                sf.lastError = "segment index trailing data";
            }
        } catch (Exception ex) {
            // Open 的错误值契约：格式/读取异常留诊断，不泄漏内部句柄。
            sf.lastError = "segment open failed: " + ex.Message;
        } finally {
            if (tail != null) { tail.Free(); }
            if (head != null) { head.Free(); }
            if (idx != null) { idx.Free(); }
            if (cnt != null) { cnt.Free(); }
            if (sf.lastError != "") { sf.Close(); }
        }
        return sf;
    }

    // 段文件路径。
    public string Path() { return this.path; }

    // 段内记录数。
    public long Count() { return this.recordCount; }

    // 最近一次错误描述（块 CRC 不符也记在这里）。
    public string GetError() { return this.lastError; }

    // 定位 key 所在或其插入位置的块号（最后一个块首键 <= key 的块；小于全部首键返回 0）。
    public int BlockFor(string key) {
        int lo = 0;
        int hi = this.entries.Count - 1;
        int ans = 0;
        while (lo <= hi) {
            int mid = (lo + hi) / 2;
            if (String.CompareOrdinal(this.entries[mid].key, key) <= 0) {
                ans = mid;
                lo = mid + 1;
            } else {
                hi = mid - 1;
            }
        }
        return ans;
    }

    // 稀疏索引覆盖的块数（0 = 空段）。
    public int BlockCount() { return this.entries.Count; }

    // 一次 ReadAt 读入 [fromBlock, toBlock) 连续块区间并逐块校验未缓存 CRC；
    // 失败返回 null 并在 GetError 留痕，缓冲归调用方 Free。
    public ByteBuffer LoadBlockSpan(int fromBlock, int toBlock, ByteBuffer reuse) {
        if (fromBlock < 0 || toBlock > this.entries.Count || fromBlock >= toBlock) {
            this.lastError = "segment block span out of range";
            return null;
        }
        long start = this.entries[fromBlock].offset;
        long end = this.indexStart;
        if (toBlock < this.entries.Count) { end = this.entries[toBlock].offset; }
        int len = (int)(end - start);
        if (len <= 0) {
            this.lastError = "segment block span empty";
            return null;
        }
        ByteBuffer b = reuse;
        if (b == null) { b = ByteBuffer.Alloc(len); }
        int got = this.file.ReadAt(start, b, len);
        if (got != len) {
            this.lastError = "segment block span short read";
            if (reuse == null) { b.Free(); }
            return null;
        }
        for (int i = fromBlock; i < toBlock; i = i + 1) {
            if (this.entries[i].verified == 0) {
                int blen = this.BlockLen(i);
                int boff = (int)(this.entries[i].offset - start);
                if (NativeMemory.Crc32(b.Raw() + boff, blen) != this.entries[i].crc) {
                    this.lastError = "segment block corrupt";
                    if (reuse == null) { b.Free(); }
                    return null;
                }
                this.entries[i].verified = 1;
            }
        }
        b.SeekRead(0);
        return b;
    }

    // 块 i 的文件偏移（块跨度整读用）。
    public long BlockFileOff(int i) { return this.entries[i].offset; }

    // 块 i 的字节长度（块跨度整读用）。
    public int BlockLen(int i) {
        long end = this.indexStart;
        if (i + 1 < this.entries.Count) { end = this.entries[i + 1].offset; }
        return (int)(end - this.entries[i].offset);
    }

    // 加载块 i 并校验 CRC；失败返回 null 并在 GetError 留痕，缓冲区归调用方 Free。
    public ByteBuffer LoadBlock(int i) {
        return this.LoadBlockReuse(i, null);
    }

    // LoadBlock 的复用缓冲版：非 null reuse 原地读入，每块只于首次加载校验 CRC。
    public ByteBuffer LoadBlockReuse(int i, ByteBuffer reuse) {
        if (i < 0 || i >= this.entries.Count) {
            // 空段（0 条记录）或越界：返回「未命中」而不是索引崩。
            this.lastError = "segment block out of range";
            return null;
        }
        int len = this.BlockLen(i);
        if (len <= 0) {
            this.lastError = "segment block empty";
            return null;
        }
        ByteBuffer b = reuse;
        if (b == null) { b = ByteBuffer.Alloc(len); }
        int got = this.file.ReadAt(this.entries[i].offset, b, len);
        if (got != len) {
            this.lastError = "segment block short read";
            if (reuse == null) { b.Free(); }
            return null;
        }
        if (this.entries[i].verified == 0) {
            if (b.Crc32(len) != this.entries[i].crc) {
                this.lastError = "segment block corrupt";
                if (reuse == null) { b.Free(); }
                return null;
            }
            this.entries[i].verified = 1;
        }
        b.SeekRead(0);
        return b;
    }

    // 块内顺序解析下一条记录到 key/val/op；缓冲耗尽返回 false。
    public static bool NextRecord(ByteBuffer b, out string key, out string val, out int op) {
        key = "";
        val = "";
        int keyOff;
        int keyLen;
        int valOff;
        int valLen;
        if (!SegmentFile.NextRecordRaw(b, out keyOff, out keyLen, out valOff, out valLen, out op)) {
            return false;
        }
        key = b.Str(keyOff, keyLen);
        if (op != 2) { val = b.Str(valOff, valLen); }
        return true;
    }

    // 裸解析块内下一条记录：不物化任何字符串，直接基于 ByteBuffer 底层指针 + 1 字节 VarInt 快路径，
    // 消除 CanRead/ReadU8/ReadVarInt 逐条跨函数抛异常 invoke 开销。
    public static bool NextRecordRaw(ByteBuffer b, out int keyOff, out int keyLen,
                              out int valOff, out int valLen, out int op) {
        keyOff = 0;
        keyLen = 0;
        valOff = 0;
        valLen = 0;
        op = 0;
        int pos = b.rpos;
        int lim = b.length;
        if (pos >= lim) { return false; }
        Span<byte> sp = new Span<byte>(b.data, lim);
        int rop = sp[pos] & 255;
        pos = pos + 1;
        b.rpos = pos;
        op = rop;
        if (rop != 1 && rop != 2) { return false; }
        if (pos >= lim) { return false; }
        int b0 = sp[pos] & 255;
        pos = pos + 1;
        long klen = (long)b0;
        if (b0 >= 128) {
            klen = (long)(b0 & 127);
            int shift = 7;
            while (true) {
                if (pos >= lim || shift > 63) { b.rpos = pos; return false; }
                int bx = sp[pos] & 255;
                pos = pos + 1;
                klen = klen + ((long)(bx & 127) << shift);
                if (bx < 128) { break; }
                shift = shift + 7;
            }
        }
        b.rpos = pos;
        if (klen < 0 || klen > (long)(lim - pos)) { return false; }
        keyOff = pos;
        keyLen = (int)klen;
        pos = pos + keyLen;
        b.rpos = pos;
        if (rop == 2) { return true; }
        if (pos >= lim) { return false; }
        int vb0 = sp[pos] & 255;
        pos = pos + 1;
        long vlen = (long)vb0;
        if (vb0 >= 128) {
            vlen = (long)(vb0 & 127);
            int shift = 7;
            while (true) {
                if (pos >= lim || shift > 63) { b.rpos = pos; return false; }
                int bx = sp[pos] & 255;
                pos = pos + 1;
                vlen = vlen + ((long)(bx & 127) << shift);
                if (bx < 128) { break; }
                shift = shift + 7;
            }
        }
        b.rpos = pos;
        if (vlen < 0 || vlen > (long)(lim - pos)) { return false; }
        valOff = pos;
        valLen = (int)vlen;
        b.rpos = pos + valLen;
        return true;
    }

    // 块内顺序查找 key：1=命中（val 为值）、2=墓碑、
    // 0=不存在（含越过 key 的位置）。直接内联块字节游标 + 1 字节 VarInt 快路径 + 首字节过滤 + memcmp，
    // 零抛异常调用、零跳过记录堆分配，退出时同步回写 b.rpos。
    public static int ScanBlock(ByteBuffer b, string key, out string val) {
        val = "";
        nint bufPtr = b.data;
        int lim = b.length;
        int pos = b.rpos;
        if (pos >= lim) { return 0; }
        Span<byte> sp = new Span<byte>(bufPtr, lim);
        nint keyPtr = (nint)key;
        int kLen = key.Length;
        int keyFirst = kLen > 0 ? (key[0] & 255) : -1;
        while (pos < lim) {
            int rop = sp[pos] & 255;
            pos = pos + 1;
            if (rop != 1 && rop != 2) { b.rpos = pos; return 0; }
            if (pos >= lim) { b.rpos = pos; return 0; }
            int b0 = sp[pos] & 255;
            pos = pos + 1;
            int keyLen = b0;
            if (b0 >= 128) {
                long kl = (long)(b0 & 127);
                int shift = 7;
                while (true) {
                    if (pos >= lim || shift > 63) { b.rpos = pos; return 0; }
                    int bx = sp[pos] & 255;
                    pos = pos + 1;
                    kl = kl + ((long)(bx & 127) << shift);
                    if (bx < 128) { break; }
                    shift = shift + 7;
                }
                if (kl < 0 || kl > (long)(lim - pos)) { b.rpos = pos; return 0; }
                keyLen = (int)kl;
            } else if (keyLen > lim - pos) {
                b.rpos = pos;
                return 0;
            }
            int keyOff = pos;
            pos = pos + keyLen;
            int valOff = 0;
            int valLen = 0;
            if (rop == 1) {
                if (pos >= lim) { b.rpos = pos; return 0; }
                int vb0 = sp[pos] & 255;
                pos = pos + 1;
                if (vb0 >= 128) {
                    long vl = (long)(vb0 & 127);
                    int shift = 7;
                    while (true) {
                        if (pos >= lim || shift > 63) { b.rpos = pos; return 0; }
                        int bx = sp[pos] & 255;
                        pos = pos + 1;
                        vl = vl + ((long)(bx & 127) << shift);
                        if (bx < 128) { break; }
                        shift = shift + 7;
                    }
                    if (vl < 0 || vl > (long)(lim - pos)) { b.rpos = pos; return 0; }
                    valLen = (int)vl;
                } else {
                    if (vb0 > lim - pos) { b.rpos = pos; return 0; }
                    valLen = vb0;
                }
                valOff = pos;
                pos = pos + valLen;
            }
            int minLen = keyLen < kLen ? keyLen : kLen;
            int cmp = 0;
            if (minLen > 0) {
                int r0 = sp[keyOff] & 255;
                if (r0 != keyFirst) {
                    cmp = r0 - keyFirst;
                } else if (minLen > 1) {
                    cmp = NativeMemory.Compare(bufPtr + (nint)(keyOff + 1), keyPtr + (nint)1, minLen - 1);
                }
            }
            if (cmp == 0) {
                cmp = keyLen - kLen;
            }
            if (cmp == 0) {
                b.rpos = pos;
                if (rop == 2) { return 2; }
                val = NativeMemory.GetString(bufPtr, valOff, valLen);
                return 1;
            }
            if (cmp > 0) {
                b.rpos = pos;
                return 0;
            }
        }
        b.rpos = pos;
        return 0;
    }

    // 无状态块内顺序查找（始终从偏移 0 起扫，不修改 b.rpos）：供共享 BlockCache 并发点查使用，消除数据竞争。
    public static int ScanBlockFromStart(ByteBuffer b, string key, out string val) {
        val = "";
        nint bufPtr = b.data;
        int lim = b.length;
        int pos = 0;
        if (lim <= 0) { return 0; }
        Span<byte> sp = new Span<byte>(bufPtr, lim);
        nint keyPtr = (nint)key;
        int kLen = key.Length;
        int keyFirst = kLen > 0 ? (key[0] & 255) : -1;
        while (pos < lim) {
            int rop = sp[pos] & 255;
            pos = pos + 1;
            if (rop != 1 && rop != 2) { return 0; }
            if (pos >= lim) { return 0; }
            int b0 = sp[pos] & 255;
            pos = pos + 1;
            int keyLen = b0;
            if (b0 >= 128) {
                long kl = (long)(b0 & 127);
                int shift = 7;
                while (true) {
                    if (pos >= lim || shift > 63) { return 0; }
                    int bx = sp[pos] & 255;
                    pos = pos + 1;
                    kl = kl + ((long)(bx & 127) << shift);
                    if (bx < 128) { break; }
                    shift = shift + 7;
                }
                if (kl < 0 || kl > (long)(lim - pos)) { return 0; }
                keyLen = (int)kl;
            } else if (keyLen > lim - pos) {
                return 0;
            }
            int keyOff = pos;
            pos = pos + keyLen;
            int valOff = 0;
            int valLen = 0;
            if (rop == 1) {
                if (pos >= lim) { return 0; }
                int vb0 = sp[pos] & 255;
                pos = pos + 1;
                if (vb0 >= 128) {
                    long vl = (long)(vb0 & 127);
                    int shift = 7;
                    while (true) {
                        if (pos >= lim || shift > 63) { return 0; }
                        int bx = sp[pos] & 255;
                        pos = pos + 1;
                        vl = vl + ((long)(bx & 127) << shift);
                        if (bx < 128) { break; }
                        shift = shift + 7;
                    }
                    if (vl < 0 || vl > (long)(lim - pos)) { return 0; }
                    valLen = (int)vl;
                } else {
                    if (vb0 > lim - pos) { return 0; }
                    valLen = vb0;
                }
                valOff = pos;
                pos = pos + valLen;
            }
            int minLen = keyLen < kLen ? keyLen : kLen;
            int cmp = 0;
            if (minLen > 0) {
                int r0 = sp[keyOff] & 255;
                if (r0 != keyFirst) {
                    cmp = r0 - keyFirst;
                } else if (minLen > 1) {
                    cmp = NativeMemory.Compare(bufPtr + (nint)(keyOff + 1), keyPtr + (nint)1, minLen - 1);
                }
            }
            if (cmp == 0) {
                cmp = keyLen - kLen;
            }
            if (cmp == 0) {
                if (rop == 2) { return 2; }
                val = NativeMemory.GetString(bufPtr, valOff, valLen);
                return 1;
            }
            if (cmp > 0) {
                return 0;
            }
        }
        return 0;
    }

    // 点查：0=不存在，1=命中（val 为值），
    // 2=墓碑（键在本段被删，查找到此为止）。块腐坏按不存在
    // 处理并留错误痕迹。
    public int Lookup(string key, out string val) {
        val = "";
        int bi = this.BlockFor(key);
        ByteBuffer b = this.LoadBlock(bi);
        if (b == null) { return 0; }
        int r = SegmentFile.ScanBlock(b, key, out val);
        b.Free();
        return r;
    }

    // 点查（带块缓存）：先借缓存 pin，未命中则加载
    // 块并入库。val 是字符串拷贝，pin 释放后仍然有效。
    // segNo 是本段的全局段号，用于跨段区分缓存键。
    public int Lookup(string key, out string val, BlockCache cache, long segNo) {
        if (cache == null) { return this.Lookup(key, out val); }
        val = "";
        int bi = this.BlockFor(key);
        long ck = segNo * 4294967296 + bi;
        CachePin pin = cache.Acquire(ck);
        if (pin == null) {
            ByteBuffer nb = this.LoadBlock(bi);
            if (nb == null) { return 0; }
            pin = cache.Insert(ck, nb);
            if (pin == null) {
                ByteBuffer direct = this.LoadBlock(bi);
                if (direct == null) { return 0; }
                int r2 = SegmentFile.ScanBlock(direct, key, out val);
                direct.Free();
                return r2;
            }
        }
        if (pin.buf == null) {
            cache.Release(pin);
            return 0;
        }
        // 缓存块会被多读者并发扫描：使用无状态扫描，绝不修改共享 pin.buf.rpos。
        int r = SegmentFile.ScanBlockFromStart(pin.buf, key, out val);
        cache.Release(pin);
        return r;
    }

    // 从 fromKey（含）起顺序扫描全部记录，逐条交给
    // visit（返回 false 早停，该条不计入）。跨块推进，直到
    // 记录区终点。返回 visit 接受的记录数。
    public int Scan(string fromKey, SegVisit visit) {
        int bi = this.BlockFor(fromKey);
        int added = 0;
        while (bi < this.entries.Count) {
            ByteBuffer b = this.LoadBlock(bi);
            if (b == null) { return added; }
            try {
                while (b.Remaining() > 0) {
                    string rk;
                    string rv;
                    int rop;
                    if (!SegmentFile.NextRecord(b, out rk, out rv, out rop)) {
                        this.lastError = "segment record corrupt";
                        return added;
                    }
                    if (String.CompareOrdinal(rk, fromKey) < 0) { continue; }
                    if (!visit(rk, rv, rop)) { return added; }
                    added = added + 1;
                }
            } catch (Exception ex) {
                // 扫描错误值契约：恢复调用方读取 GetError，块缓冲仍释放。
                this.lastError = "segment scan failed: " + ex.Message;
                return added;
            } finally {
                b.Free();
            }
            bi = bi + 1;
        }
        return added;
    }

    // 错误/缺失段也允许幂等关闭。
    public void Close() {
        if (this.file != null) { this.file.Close(); }
    }
}
