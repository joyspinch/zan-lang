using System;
using System.IO;
using System.Collections.Generic;

namespace System.Data.ZanDb.Storage;

public partial class ZanStore {
// 线性查小列表（归并集段号，k 很小）。
public static bool IdInList(List<long> ids, long id) {
    for (int i = 0; i < ids.Count; i = i + 1) {
        if (ids[i] == id) { return true; }
    }
    return false;
}

// <see cref="MergeSegments"/> 的增量形式：把最老的
// maxMerge（≥2）个段归并为一个新段，其余较新段原样保留——
// 写阻塞时长被归并集规模封顶，反复调用最终收敛为单段。索引
// 原地改指：只有键索引仍指向归并集的键才重指/摘除；指向未
// 归并新段的键保持原指（更新版本继续赢），且这样的键**不写
// 入新段**——重开恢复按清单序「后扫覆盖前扫」时才不会让旧
// 版本压住未归并段的新版本。归并集内同键由游标新→旧序去重，
// 未固化墓碑压键与崩溃窗口语义同全量归并。返回实际归并的
// 段数（0 = 无事可做：段不足 2 或在事务中）。
public int MergeSomeSegments(int maxMerge) {
    if (!this.WriteReady() || maxMerge < 2 || this.segs.Count < 2 || this.txDepth > 0) { return 0; }
    if (!this.log.Sync()) { this.Fail(this.log.GetError()); return 0; }
    int k = maxMerge < this.segs.Count ? maxMerge : this.segs.Count;
    long newId = this.nextSegId;
    if (newId == 9223372036854775807) { this.Fail("store segment id exhausted"); return 0; }
    string segPath = ZanStore.SegPath(this.basePath, newId);
    File.Delete(segPath);
    List<long> chosenIds = new List<long>();
    for (int i = 0; i < k; i = i + 1) { chosenIds.Add(this.segs[i].id); }
    // 完全独立地构建索引：写段、读段、清单保存失败时在线索引不变。
    Dictionary<string, long> mergedIndex = new Dictionary<string, long>();
    List<string> liveKeys = this.index.Keys;
    for (int i = 0; i < liveKeys.Count; i = i + 1) {
        long id = 0;
        this.index.TryGetValue(liveKeys[i], out id);
        if (!ZanStore.IdInList(chosenIds, id)) { mergedIndex.Add(liveKeys[i], id); }
    }
    SegmentWriter wtr = null;
    SegmentFile seg = null;
    List<SegCursor> cursors = new List<SegCursor>();
    bool published = false;
    bool adopted = false;
    try {
        wtr = SegmentWriter.Create(segPath);
        if (wtr.Failed()) { this.Fail(wtr.GetError()); return 0; }
        for (int i = k - 1; i >= 0; i = i - 1) {
            cursors.Add(SegCursor.Open(this.segs[i].seg, ""));
        }
        while (true) {
            string minKey = "";
            bool has = false;
            for (int i = 0; i < cursors.Count; i = i + 1) {
                SegCursor c = cursors[i];
                if (!c.Valid()) { continue; }
                if (!has || String.CompareOrdinal(c.Key(), minKey) < 0) {
                    minKey = c.Key();
                    has = true;
                }
            }
            if (!has) { break; }
            bool decided = false;
            for (int i = 0; i < cursors.Count; i = i + 1) {
                SegCursor c = cursors[i];
                if (!c.Valid() || c.Key() != minKey) { continue; }
                if (!decided) {
                    decided = true;
                    long curSeg = 0;
                    bool mine = this.index.TryGetValue(minKey, out curSeg)
                    && ZanStore.IdInList(chosenIds, curSeg);
                    if (c.Op() == 1 && mine && !this.tombstones.ContainsKey(minKey)) {
                        wtr.Add(minKey, c.Val(), 1);
                        mergedIndex.Add(minKey, newId);
                    }
                }
                c.Next();
            }
            if (wtr.Failed()) { this.Fail(wtr.GetError()); return 0; }
        }
        for (int i = 0; i < k; i = i + 1) {
            if (this.segs[i].seg.GetError() != "") {
                this.Fail(this.segs[i].seg.GetError());
                return 0;
            }
        }
        if (!wtr.Finish()) { this.Fail(wtr.GetError()); return 0; }
        seg = SegmentFile.Open(segPath);
        if (seg.GetError() != "") { this.Fail(seg.GetError()); return 0; }
        // 段目录项持久化后再发布清单：断电最坏留下孤儿段
        // （同号覆盖），旧槽 + 完整日志仍可恢复。
        if (!PageFile.DirSync(ZanStore.DirOf(this.basePath))) {
            this.Fail("segment dir sync failed");
            return 0;
        }
        // 新段载最老数据，列表排前；未归并新段保持相对年龄序。
        List<long> ids = new List<long>();
        ids.Add(newId);
        List<SegRef> remaining = new List<SegRef>();
        remaining.Add(new SegRef(seg, newId));
        for (int i = k; i < this.segs.Count; i = i + 1) {
            ids.Add(this.segs[i].id);
            remaining.Add(this.segs[i]);
        }
        published = true;
        if (ZanStore.CrashHook != null) { ZanStore.CrashHook("merge_mid_seg"); }
        // 归并不固化 memtable，恢复水位必须保持原值。
        if (!this.PublishBoth(this.man.LogStartSeq(), newId + 1, ids)) { return 0; }
        List<SegRef> old = this.segs;
        this.index = mergedIndex;
        this.segs = remaining;
        this.nextSegId = newId + 1;
        adopted = true;
        // 两个有效 fallback 槽都不再引用旧段后才允许删除。
        for (int i = 0; i < k; i = i + 1) {
            old[i].seg.Close();
            File.Delete(ZanStore.SegPath(this.basePath, old[i].id));
        }
        this.commitsSinceSync = 0;
        this.bytesSinceSync = 0;
        return k;
    } catch (Exception ex) {
        // 维护的错误值契约：失败关闭，未退休介质保留以供恢复。
        this.Fail("store merge failed: " + ex.Message);
        return 0;
    } finally {
        for (int i = 0; i < cursors.Count; i = i + 1) { cursors[i].Free(); }
        ZanStore.CloseWriter(wtr);
        if (seg != null && !adopted) { seg.Close(); }
        if (!published) { File.Delete(segPath); }
    }
}

public bool WriteReady() {
    if (this.IsOpen()) { return true; }
    this.Fail(this.lastError != "" ? this.lastError
    : (this.log != null && this.log.GetError() != "" ? this.log.GetError() : "store is closed"));
    return false;
}

// 按键序（<see cref="String.CompareOrdinal"/> 升序）
// 归并扫描 fromKey（含）起的全部存活键值：memtable 与各段
// 多路归并，同键取最新版本（memtable &gt; 更大段号），墓碑
// 隐藏。visit 返回 false 早停。看到的是已提交视图（不含未
// 提交事务的覆盖层）；memtable 部分每次扫描现排序，段部分
// 顺序流读、不占用块缓存。返回 visit 接受的键数。
public int Scan(string fromKey, StoreVisit visit) {
    return ScanBetween(fromKey, "", visit);
}

// <see cref="Scan"/> 的有界形式：只访问
// [startKey, endKey] 闭区间内的键，上界在归并循环内判定，
// 调用方无需在回调里逐键比对。返回 visit 接受的键数。
public int ScanBetween(string startKey, string endKey, StoreVisit visit) {
    // 各段游标，段号降序排列 = 新段在前。
    List<SegCursor> cursors = new List<SegCursor>();
    for (int i = this.segs.Count - 1; i >= 0; i = i - 1) {
        cursors.Add(SegCursor.Open(this.segs[i].seg, startKey));
    }
    // memtable 中键 ≥ startKey 的部分（每键至多一条，即最新版本），
    // 先过滤再排序：固化+归并后的常态是 memtable 为空，排序整段跳过。
    List<string> mk = new List<string>();
    List<string> src = this.memtable.Keys;
    for (int i = 0; i < src.Count; i = i + 1) {
        if (String.CompareOrdinal(src[i], startKey) >= 0) { mk.Add(src[i]); }
    }
    ZanStore.SortStrings(mk);
    int mi = 0;

    int accepted = 0;
    bool bounded = endKey.Length > 0;
    // 墓碑集为空（无未固化删除）时逐键哈希整个跳过：
    // 扫描态集合的常态。
    bool hasTombs = this.tombstones.Count > 0;

    // 单一来源快速路径：恰好一个段、memtable 无参与归并的键。
    // 固化+归并后的常态——无需最小键仲裁与同键裁决，顺序直读。
    if (cursors.Count == 1 && mk.Count == 0) {
        SegCursor c = cursors[0];
        while (c.Valid()) {
            if (c.Op() == 1) {
                string k = c.Key();
                if (bounded && String.CompareOrdinal(k, endKey) > 0) { break; }
                if (!hasTombs || !this.tombstones.ContainsKey(k)) {
                    if (!visit(k, c.Val())) { break; }
                    accepted = accepted + 1;
                }
            }
            c.Next();
        }
        c.Free();
        return accepted;
    }

    bool go = true;
    while (go) {
        // 1) 各来源当前位置上的最小键；win = 胜出游标下标
        // （-1 = memtable 持有当前键或无来源）。cursors 新→旧，
        // 严格小于才替换，天然让最新段在并列时胜出。
        string minKey = "";
        bool has = false;
        bool memHas = false;
        int win = -1;
        if (mi < mk.Count) { minKey = mk[mi]; has = true; memHas = true; }
        for (int i = 0; i < cursors.Count; i = i + 1) {
            SegCursor c = cursors[i];
            if (!c.Valid()) { continue; }
            if (!has) {
                minKey = c.Key(); has = true; win = i;
            } else {
                int cmp = String.CompareOrdinal(c.Key(), minKey);
                if (cmp < 0) {
                    minKey = c.Key(); win = i; memHas = false;
                } else if (cmp == 0 && win == -1) {
                    win = i;  // 与 memtable 同键：值仍取 memtable，游标须推进
                }
            }
        }
        if (!has) { break; }
        if (bounded && String.CompareOrdinal(minKey, endKey) > 0) { break; }
        // 2) 最新来源定值：memtable 优先；否则胜出游标。
        bool live = false;
        string val = "";
        if (memHas) {
            string v = "";
            this.memtable.TryGetValue(minKey, out v);
            val = v;
            live = true;
        } else {
            SegCursor c = cursors[win];
            live = c.Op() == 1;
            val = c.Val();
        }
        // 3) 推进停在 minKey 的来源：memtable 与胜出游标必推；
        // 多段时更旧的段可能同名键，逐个核对一并作废。
        if (memHas) { mi = mi + 1; }
        if (win >= 0) { cursors[win].Next(); }
        for (int i = win + 1; i < cursors.Count; i = i + 1) {
            SegCursor c = cursors[i];
            if (c.Valid() && c.Key() == minKey) { c.Next(); }
        }
        // 尚未固化的墓碑同样压住旧段版本（点读路径由索引摘除
        // 保证，扫描路径在这里保证）。
        if (live && hasTombs && this.tombstones.ContainsKey(minKey)) { live = false; }
        // 4) 存活键才交给 visit；false 早停。
        if (live) {
            if (!visit(minKey, val)) { go = false; }
            else { accepted = accepted + 1; }
        }
    }
    for (int i = 0; i < cursors.Count; i = i + 1) { cursors[i].Free(); }
    return accepted;
}

// <see cref="ScanBetween"/> 的零拷贝形式：交付
// <see cref="ScanBetween"/> 的零拷贝形式：交付
// <see cref="ScanRow"/> 而非字符串——单段且 memtable 无未固化
// 数据时值不物化、上界与墓碑判定全走块内指针；memtable 有
// 参与则退化为字符串路径包装。语义与 ScanBetween 完全一致，
// 行数据仅在回调返回前有效。返回 visit 接受的键数。
public int ScanRows(string startKey, string endKey, ScanRowVisit visit) {
    if (this.segs.Count == 1 && this.memtable.Keys.Count == 0) {
        SegCursor c = SegCursor.Open(this.segs[0].seg, startKey);
        ScanRow row = new ScanRow();
        row.Bind(c);
        bool hasTombs = this.tombstones.Count > 0;
        bool bounded = endKey.Length > 0;
        int accepted = 0;
        while (c.Valid()) {
            if (c.Op() == 1) {
                if (bounded && c.CmpKeyRaw(endKey) > 0) { break; }
                if (!hasTombs || !this.tombstones.ContainsKey(c.Key())) {
                    if (!visit(row)) { break; }
                    accepted = accepted + 1;
                }
            }
            c.Next();
        }
        c.Free();
        return accepted;
    }
    // 多源归并（未固化数据参与）：退化为字符串路径包装交付。
    ScanRow mrow = new ScanRow();
    return ScanBetween(startKey, endKey, delegate(string k, string v) {
        mrow.BindMem(k, v);
        return visit(mrow);
    });
}

// 统计 [startKey, endKey] 闭区间内的存活键数，
// 不做任何回调：单段且 memtable 无参与时走块级内核直数
// （免游标/回调对象），否则退化为归并扫描。返回键数。
public int CountRange(string startKey, string endKey) {
    List<string> src = this.memtable.Keys;
    if (this.segs.Count == 1 && src.Count == 0) {
        return ScanKernel(this.segs[0].seg, startKey, endKey,
        delegate(nint basePtr, int keyOff, int keyLen, int valOff, int valLen) {
            return true;
        });
    }
    return ScanBetween(startKey, endKey, delegate(string k, string v) {
        return true;
    });
}

// <see cref="ScanKernel"/> 的区间形式：仅当处于
// 单段稳态（memtable 空）时走块级内核；多源归并或 memtable
// 有未固化数据时返回 -1（调用方须退回 <see cref="ScanRows"/>
// 字符串路径）。endKey 为空串 = 无上界。
public int TryScanKernel(string startKey, string endKey, KernelVisit visit) {
    List<string> src = this.memtable.Keys;
    if (this.segs.Count != 1 || src.Count != 0) { return -1; }
    return ScanKernel(this.segs[0].seg, startKey, endKey, visit);
}

// 块级聚合内核（单段快速路径）：把块跨度一次读入（每
// <see cref="KERNEL_SPAN_BYTES"/> 一次系统调用，块在段文件里物理
// 连续、记录解析不依赖块边界）后循环裸解析记录，把（基址+偏移+
// 长度）直接交给 visit——不经 SegCursor/ScanRow 对象、不经每行
// delegate 之外的任何抽象；op=2 的段内墓碑由这里跳过（op=2 记
// 录无值）。墓碑集非空时逐键 memcmp 比对（未固化删除极少，比
// 对成本可忽略）；visit 返回 false 早停。返回 visit 接受的行数。
// 常态扫描（固化+归并后单段、memtable 空）的聚合与计数走
// 这里——每行成本 = varint 解码 + 一次回调，无对象分配；每
// 跨度成本 = 一次 ReadAt + 逐块 CRC（同会话首遍）。
public int ScanKernel(SegmentFile seg, string startKey, string endKey, KernelVisit visit) {
    int blockIdx = seg.BlockFor(startKey);
    int blockTotal = seg.BlockCount();
    int accepted = 0;
    bool bounded = endKey.Length > 0;
    bool hasTombs = this.tombstones.Count > 0;
    ByteBuffer buf = null;
    bool stop = false;
    while (blockIdx < blockTotal && !stop) {
        // 跨度终点：够 KERNEL_SPAN_BYTES 或到段尾。单块超长时
        // 至少覆盖该块。
        int endBlock = blockIdx + 1;
        long spanLen = seg.BlockLen(blockIdx);
        while (endBlock < blockTotal
        && spanLen + seg.BlockLen(endBlock) <= ZanStore.KERNEL_SPAN_BYTES) {
            spanLen = spanLen + seg.BlockLen(endBlock);
            endBlock = endBlock + 1;
        }
        ByteBuffer nb = seg.LoadBlockSpan(blockIdx, endBlock, buf);
        if (nb == null) { break; }
        buf = nb;
        int pos = 0;
        int len = buf.Length();
        while (pos < len) {
            int op = buf.PeekU8(pos);
            if (op != 1 && op != 2) { break; }
            int p = pos + 1;
            long klen = buf.ReadVarIntAt(p, out p);
            if (klen < 0 || p + (int)klen > len) { break; }
            int keyOff = p;
            p = p + (int)klen;
            // 下界：定位块里可能有 < startKey 的前缀键（稀疏索
            // 引只保证块首 <= startKey），跳过。
            if (buf.CmpRangeRaw(keyOff, (int)klen, startKey) < 0) {
                if (op == 2) { pos = p; continue; }
                long skip = buf.ReadVarIntAt(p, out p);
                if (skip < 0 || p + (int)skip > len) { break; }
                pos = p + (int)skip;
                continue;
            }
            if (op == 2) {
                // 段内墓碑：无值。单段快速路径下它就是该键的
                // 最新版本，直接跳过（键已被固化时索引摘除）。
                pos = p;
                continue;
            }
            long vlen = buf.ReadVarIntAt(p, out p);
            if (vlen < 0 || p + (int)vlen > len) { break; }
            int valOff = p;
            p = p + (int)vlen;
            // 起始定位之后段内按键序——首条越过上界即整段止步。
            if (bounded && buf.CmpRangeRaw(keyOff, (int)klen, endKey) > 0) {
                stop = true;
                break;
            }
            if (hasTombs && this.tombstones.ContainsKey(buf.Str(keyOff, (int)klen))) {
                pos = p;
                continue;
            }
            accepted = accepted + 1;
            if (!visit(buf.Raw(), keyOff, (int)klen, valOff, (int)vlen)) {
                stop = true;
                break;
            }
            pos = p;
        }
        blockIdx = endBlock;
    }
    if (buf != null) { buf.Free(); }
    return accepted;
}

// 共享锁下的 <see cref="Scan"/>；可与并发写入共存。
public async int ScanAsync(string fromKey, StoreVisit visit) {
    await this.rw.EnterRead();
    int n = Scan(fromKey, visit);
    this.rw.ExitRead();
    return n;
}

// 物化式范围扫描：startKey（含）到 endKey（含，与
// 旧引擎 <c>BTree.Scan</c> 语义一致）按键序收集到 output；
// limit &gt; 0 时至多 limit 条。返回收集的条数。
public int ScanRange(string startKey, string endKey, int limit, List<KvEntry> output) {
    int before = output.Count;
    Scan(startKey, delegate(string k, string v) {
        if (endKey.Length > 0 && String.CompareOrdinal(k, endKey) > 0) {
            return false;
        }
        output.Add(new KvEntry(k, v));
        return limit <= 0 || output.Count - before < limit;
    });
    return output.Count - before;
}

// 前缀扫描：所有以 prefix 开头的键值按键序收集；
// limit &gt; 0 时至多 limit 条。返回收集的条数。
public int ScanPrefix(string prefix, int limit, List<KvEntry> output) {
    int before = output.Count;
    Scan(prefix, delegate(string k, string v) {
        if (!k.StartsWith(prefix)) { return false; }
        output.Add(new KvEntry(k, v));
        return limit <= 0 || output.Count - before < limit;
    });
    return output.Count - before;
}

// <see cref="ScanKernel"/> 的键只读形式：不解析值、
// 只把（基址+键偏移+键长）交给 visit，供覆盖索引路径
// （索引条目键自带 id/值段，零文档读也零字符串物化）使用。
// 单段稳态前提与 <see cref="TryScanKernel"/> 相同，否则返回 -1。
// 返回 visit 接受的键数。
public int TryScanKeyKernel(string startKey, string endKey, KernelKeyVisit visit) {
    List<string> src = this.memtable.Keys;
    if (this.segs.Count != 1 || src.Count != 0) { return -1; }
    return ScanKeyKernel(this.segs[0].seg, startKey, endKey, visit);
}

// <see cref="ScanKernel"/> 的键只读内档：与行版同
// 跨度整读与上界/墓碑逻辑，只是不读值、交付键区间。
public int ScanKeyKernel(SegmentFile seg, string startKey, string endKey, KernelKeyVisit visit) {
    int blockIdx = seg.BlockFor(startKey);
    int blockTotal = seg.BlockCount();
    int accepted = 0;
    bool bounded = endKey.Length > 0;
    bool hasTombs = this.tombstones.Count > 0;
    ByteBuffer buf = null;
    bool stop = false;
    while (blockIdx < blockTotal && !stop) {
        int endBlock = blockIdx + 1;
        long spanLen = seg.BlockLen(blockIdx);
        while (endBlock < blockTotal
        && spanLen + seg.BlockLen(endBlock) <= ZanStore.KERNEL_SPAN_BYTES) {
            spanLen = spanLen + seg.BlockLen(endBlock);
            endBlock = endBlock + 1;
        }
        ByteBuffer nb = seg.LoadBlockSpan(blockIdx, endBlock, buf);
        if (nb == null) { break; }
        buf = nb;
        int pos = 0;
        int len = buf.Length();
        while (pos < len) {
            int op = buf.PeekU8(pos);
            if (op != 1 && op != 2) { break; }
            int p = pos + 1;
            long klen = buf.ReadVarIntAt(p, out p);
            if (klen < 0 || p + (int)klen > len) { break; }
            int keyOff = p;
            p = p + (int)klen;
            // 下界：定位块里可能有 < startKey 的前缀键（稀疏索
            // 引只保证块首 <= startKey），跳过。
            if (buf.CmpRangeRaw(keyOff, (int)klen, startKey) < 0) {
                if (op == 2) { pos = p; continue; }
                long skip = buf.ReadVarIntAt(p, out p);
                if (skip < 0 || p + (int)skip > len) { break; }
                pos = p + (int)skip;
                continue;
            }
            if (op == 2) {
                if (bounded && buf.CmpRangeRaw(keyOff, (int)klen, endKey) > 0) {
                    stop = true;
                    break;
                }
                pos = p;
                continue;
            }
            long vlen = buf.ReadVarIntAt(p, out p);
            if (vlen < 0 || p + (int)vlen > len) { break; }
            p = p + (int)vlen;
            if (bounded && buf.CmpRangeRaw(keyOff, (int)klen, endKey) > 0) {
                stop = true;
                break;
            }
            if (hasTombs && this.tombstones.ContainsKey(buf.Str(keyOff, (int)klen))) {
                pos = p;
                continue;
            }
            accepted = accepted + 1;
            if (!visit(buf.Raw(), keyOff, (int)klen)) {
                stop = true;
                break;
            }
            pos = p;
        }
        blockIdx = endBlock;
    }
    if (buf != null) { buf.Free(); }
    return accepted;
}

// 将缓冲与 OS 缓存全部强制落盘。
public void Checkpoint() {
    if (!this.WriteReady()) { return; }
    if (!this.log.Sync()) { this.Fail(this.log.GetError()); return; }
    this.commitsSinceSync = 0;
    this.bytesSinceSync = 0;
}

// 当前全部段号列表。
public List<long> SegIdList() {
    List<long> ids = new List<long>();
    for (int i = 0; i < this.segs.Count; i = i + 1) {
        ids.Add(this.segs[i].id);
    }
    return ids;
}

// 全库巡检：段逐块 CRC 全扫、索引段号指向、WAL 帧、清单双槽
// 冗余。只读不修复不截断；返回问题清单，空 = 健康。撕裂尾与
// 尚未落盘的缓冲不算问题。须在写侧串行环境调用。
public List<string> IntegrityCheck() {
    List<string> problems = new List<string>();
    if (!this.IsOpen()) {
        problems.Add("store is not open: " + this.GetError());
        return problems;
    }
    // 段：独立句柄重开全扫描，走块级 CRC（不经块缓存）。
    List<long> ids = this.SegIdList();
    for (int i = 0; i < ids.Count; i = i + 1) {
        SegmentFile sf = SegmentFile.Open(ZanStore.SegPath(this.basePath, ids[i]));
        if (sf.GetError() != "") {
            problems.Add("segment " + Convert.ToString(ids[i]) + " open: " + sf.GetError());
            continue;
        }
        sf.Scan("", ZanStore.KeepVisit);
        if (sf.GetError() != "") {
            problems.Add("segment " + Convert.ToString(ids[i]) + " scan: " + sf.GetError());
        }
        sf.Close();
    }
    // 索引：每个键的段号必须在清单段列表内。
    List<string> keys = this.index.Keys;
    for (int i = 0; i < keys.Count; i = i + 1) {
        long seg = 0;
        this.index.TryGetValue(keys[i], out seg);
        if (!ids.Contains(seg)) {
            problems.Add("index key " + keys[i] + " points to missing segment "
            + Convert.ToString(seg));
        }
    }
    // 日志帧（撕裂尾不算损坏）；Verify 只读不碰句柄错误态。
    string logError = this.log.Verify();
    if (logError != "") {
        problems.Add("log: " + logError);
    }
    // 清单：当前槽开库已验证必好；另一槽不可读且文件在
    // = 冗余降级。
    int other = this.man.curSlot == 0 ? 1 : 0;
    string otherPath = Manifest.SlotPath(this.basePath, other);
    if (File.Exists(otherPath)) {
        Manifest probe = new Manifest();
        List<long> probeIds = new List<long>();
        long gen = 0;
        long seq = 0;
        long nextId = 0;
        if (!probe.ParseSlot(otherPath, out gen, out seq, out nextId, probeIds)) {
            problems.Add("manifest slot " + Convert.ToString(other) + " unreadable: "
            + probe.GetError());
        }
    }
    return problems;
}

// 清理目标路径上的旧数据库文件（WAL、锁、双槽清单、段文件）。
public static void CleanTargetFiles(string target, long maxSegId) {
    if (target == null || target == "") { return; }
    if (File.Exists(target)) { File.Delete(target); }
    if (File.Exists(target + ".lock")) { File.Delete(target + ".lock"); }
    if (File.Exists(target + ".m0")) { File.Delete(target + ".m0"); }
    if (File.Exists(target + ".m1")) { File.Delete(target + ".m1"); }
    long limit = maxSegId + 64;
    if (limit < 256) { limit = 256; }
    for (long i = 0; i < limit; i = i + 1) {
        string sp = ZanStore.SegPath(target, i);
        if (File.Exists(sp)) { File.Delete(sp); }
    }
}

// 热备份 / 一致快照导出（SQLite backup API 对位）：
// 锁内原子截取段清单，逐段复制到目标库，写入目标双槽清单与日志，
// 最后执行独立恢复巡检校验；目标存在则清理覆盖。
// 失败抛出明确异常并清理半成品，不毒化当前运行中句柄。
public void Backup(string targetPath) {
    this.BackupWithPersistence(targetPath, new BackupPersistence());
}

internal void BackupWithPersistence(string targetPath, BackupPersistence persistence) {
    if (this.closed || !this.IsOpen()) {
        throw new InvalidOperationException("cannot backup closed store: " + this.GetError());
    }
    if (targetPath == null || targetPath == "") {
        throw new ArgumentException("missing backup target path");
    }
    string target = Path.Normalize(targetPath);
    if (target == "" || target == this.basePath) {
        throw new ArgumentException("backup target cannot be same as source");
    }
    if (this.txDepth > 0) {
        throw new InvalidOperationException("cannot backup store while transaction is active");
    }
    string targetDir = ZanStore.DirOf(target);
    if (targetDir != "" && !Directory.Exists(targetDir)) {
        Directory.CreateDirectory(targetDir);
    }

    // 1. 先将内存中尚未固化的 memtable 与未落盘日志固化为段，
    // 确保备份包含截至调用时刻的全部已提交数据，且数据全部进入不可变段中。
    this.FlushToSegment();
    if (!this.IsOpen()) {
        throw new IOException("flush before backup failed: " + this.GetError());
    }
    if (this.log.Size() != 0L || this.log.PendingBytes() != 0) {
        throw new IOException("backup checkpoint left a nonempty WAL");
    }

    // 2. 截取不可变快照状态：段清单、日志水位、段游标。
    List<long> snapIds = this.SegIdList();
    long snapStartSeq = this.man.LogStartSeq();
    long snapNextId = this.man.NextSegId();

    // 3. 清理目标文件残余。
    ZanStore.CleanTargetFiles(target, snapNextId);

    try {
        // 4. 逐段复制并同步；CRC 巡检验证本次导出内容。
        for (int i = 0; i < snapIds.Count; i = i + 1) {
            string srcSeg = ZanStore.SegPath(this.basePath, snapIds[i]);
            string dstSeg = ZanStore.SegPath(target, snapIds[i]);
            if (!File.Exists(srcSeg)) {
                throw new FileNotFoundException("source segment missing: " + srcSeg);
            }
            persistence.Copy(srcSeg, dstSeg);
        }

        // Checkpoint covered all committed frames. Keep the source WAL lock held;
        // a second Windows handle cannot read through its compatibility byte lock.
        File.WriteAllText(target, "");
        persistence.SyncFile(target);
        persistence.SyncParents(targetDir == "" ? "." : targetDir, "backup-files");

        // 6. 构造目标双槽清单（双槽写入相同代数与有效 CRC，保证高冗余度）。
        Manifest targetMan = new Manifest();
        targetMan.basePath = target;
        if (!targetMan.Save(snapStartSeq, snapNextId, snapIds)) {
            throw new IOException("failed to write target manifest slot 0: " + targetMan.GetError());
        }
        if (!targetMan.Save(snapStartSeq, snapNextId, snapIds)) {
            throw new IOException("failed to write target manifest slot 1: " + targetMan.GetError());
        }
        string syncDir = targetDir == "" ? "." : targetDir;
        persistence.SyncParents(syncDir, "backup-manifests");

        // 7. 恢复巡检校验（对位 SQLite backup 校验契约）：
        // 独立以 DUR_SYNC 方式重开备份库，执行全段 CRC 扫描、索引指向、WAL 与双槽完整性巡检。
        ZanStore probe = ZanStore.Open(target, ZanStore.DUR_SYNC);
        if (!probe.IsOpen()) {
            string openErr = probe.GetError();
            probe.Close();
            throw new IOException("backup verification open failed: " + openErr);
        }
        List<string> problems = null;
        try { problems = probe.IntegrityCheck(); }
        finally { probe.Close(); }
        if (probe.GetError() != "") {
            throw new IOException("backup verification close failed: " + probe.GetError());
        }
        if (problems.Count > 0) {
            string msg = "";
            for (int i = 0; i < problems.Count; i = i + 1) {
                if (i > 0) { msg = msg + "; "; }
                msg = msg + problems[i];
            }
            throw new IOException("backup integrity check failed: " + msg);
        }
        // Verification closes its WAL after checking it; confirm those final writes.
        persistence.SyncFile(target);
        persistence.SyncFile(target + ".m0");
        persistence.SyncFile(target + ".m1");
        persistence.SyncParents(syncDir, "backup-store-verified");
    } catch (Exception ex) {
        ZanStore.CleanTargetFiles(target, snapNextId);
        throw;
    }
}

// 协程异步热备份（排他写锁保护）。
public async void BackupAsync(string targetPath) {
    await this.rw.EnterWrite();
    try {
        this.Backup(targetPath);
    } finally {
        this.rw.ExitWrite();
    }
}

// 按段号找段句柄。
public SegRef FindSeg(long id) {
    for (int i = 0; i < this.segs.Count; i = i + 1) {
        if (this.segs[i].id == id) { return this.segs[i]; }
    }
    return null;
}

// 失败关闭：保留首个诊断，丢弃事务，绝不重刷失败 pending 帧。
public void Fail(string error) {
    if (this.lastError == "") { this.lastError = error != "" ? error : "store I/O failed"; }
    if (this.txDepth > 0 || this.txPut.Count > 0 || this.txDel.Count > 0) {
        this.txDepth = 0;
        this.txPut.Clear();
        this.txDel.Clear();
        this.cacheEpoch = this.cacheEpoch + 1;
    }
    this.CloseResources();
}

public void CloseResources() {
    if (this.closed) { return; }
    this.closed = true;
    if (this.log != null) { this.log.Close(false); }
    for (int i = 0; i < this.segs.Count; i = i + 1) { this.segs[i].seg.Close(); }
    this.cache.Close();
    this.rw.Close();
    if (this.lockHandle != 0) {
        long handle = this.lockHandle;
        this.lockHandle = 0;
        if (!File.Unlock(handle) && this.lastError == "") { this.lastError = "store unlock failed"; }
    }
}

// 健康关闭同步所有已提交帧；尚未提交的覆盖层回滚。
public void Close() {
    if (this.closed) { return; }
    this.Rollback();
    if (this.IsOpen() && !this.log.Sync()) { this.lastError = this.log.GetError(); }
    this.CloseResources();
    if (this.lastError == "" && this.log != null && this.log.GetError() != "") {
        this.lastError = this.log.GetError();
    }
}

// ===== 排序（键序固化段用）：中位数三选快速排序 =====

public static void SortStrings(List<string> a) {
    ZanStore.SortRange(a, 0, a.Count - 1);
}

public static void SortRange(List<string> a, int lo, int hi) {
    while (lo < hi) {
        if (hi - lo < 12) {
            for (int i = lo + 1; i <= hi; i = i + 1) {
                string k = a[i];
                int j = i - 1;
                while (j >= lo && String.CompareOrdinal(a[j], k) > 0) {
                    a[j + 1] = a[j];
                    j = j - 1;
                }
                a[j + 1] = k;
            }
            return;
        }
        int mid = (lo + hi) / 2;
        if (String.CompareOrdinal(a[lo], a[mid]) > 0) { ZanStore.Swap(a, lo, mid); }
        if (String.CompareOrdinal(a[lo], a[hi]) > 0) { ZanStore.Swap(a, lo, hi); }
        if (String.CompareOrdinal(a[mid], a[hi]) > 0) { ZanStore.Swap(a, mid, hi); }
        string pivot = a[mid];
        int l = lo;
        int r = hi;
        while (l <= r) {
            while (String.CompareOrdinal(a[l], pivot) < 0) { l = l + 1; }
            while (String.CompareOrdinal(a[r], pivot) > 0) { r = r - 1; }
            if (l <= r) {
                ZanStore.Swap(a, l, r);
                l = l + 1;
                r = r - 1;
            }
        }
        if (r - lo < hi - l) {
            ZanStore.SortRange(a, lo, r);
            lo = l;
        } else {
            ZanStore.SortRange(a, l, hi);
            hi = r;
        }
    }
}

public static void Swap(List<string> a, int i, int j) {
    string t = a[i];
    a[i] = a[j];
    a[j] = t;
}

// ===== 协程安全的异步 API =====

// 共享锁读取；可安全地与并发写入共存。
public async string GetAsync(string key) {
    await this.rw.EnterRead();
    string v = Get(key);
    this.rw.ExitRead();
    return v;
}

// 独占锁写入并按当前持久化档落盘。
public async void PutAsync(string key, string val) {
    await this.rw.EnterWrite();
    try { Put(key, val); }
    finally { this.rw.ExitWrite(); }
}

// 独占锁删除一个键；返回键此前是否存在。
public async bool DeleteAsync(string key) {
    await this.rw.EnterWrite();
    bool existed = Delete(key);
    this.rw.ExitWrite();
    return existed;
}

// 独占锁下把 memtable 固化为新段。
public async void FlushAsync() {
    await this.rw.EnterWrite();
    FlushToSegment();
    this.rw.ExitWrite();
}

// 原子读改写：fn 在写临界区内看到最新已提交值
// （不存在时为 ""），因此同一键上的并发 UpdateAtomic
// 不会丢失更新。返回最终存储的结果。
public async string UpdateAtomic(string key, StoreUpdater fn) {
    await this.rw.EnterWrite();
    try {
        Begin();
        string next = fn(Get(key));
        Put(key, next);
        if (!Commit()) { throw new IOException(this.GetError()); }
        return next;
    } catch (Exception ex) {
        // 更新失败传播异常，先丢弃未提交覆盖层。
        this.Rollback();
        throw;
    } finally {
        this.rw.ExitWrite();
    }
}

}
