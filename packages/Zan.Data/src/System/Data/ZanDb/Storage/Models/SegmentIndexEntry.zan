using System;
using System.IO;
namespace System.Data.ZanDb;

public class SegmentIndexEntry {
    public long offset;
    public string key;
    public long crc;
    public int verified;

    public SegmentIndexEntry(long offset, string key, long crc) {
        this.offset = offset;
        this.key = key != null ? key : "";
        this.crc = crc;
        this.verified = 0;
    }
}
