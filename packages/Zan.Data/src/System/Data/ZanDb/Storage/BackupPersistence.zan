using System.IO;

namespace System.Data.ZanDb;

// Per-export collaborator keeps failure injection local to one backup.
internal class BackupPersistence {
    internal virtual void SyncFile(string path) {
        File.FlushToDisk(path);
    }

    internal virtual void SyncDirectory(string path, string boundary) {
        #if !WINDOWS
        Directory.FlushToDisk(path);
        #endif
        // Windows has no directory barrier backend; this is not namespace durability.
    }

    internal void Copy(string source, string target) {
        File.Copy(source, target);
        this.SyncFile(target);
    }

    internal void SyncParents(string path, string boundary) {
        string current = Path.GetFullPath(path);
        while (current != null && current.Length > 0) {
            this.SyncDirectory(current, boundary);
            string parent = ZanStore.DirOf(current);
            if (parent == current) { break; }
            current = parent;
        }
    }
}
