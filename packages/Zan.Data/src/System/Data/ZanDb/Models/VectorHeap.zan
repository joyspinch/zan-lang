using System;
using System.Collections.Generic;
using System.Json;
using System.Threading;
namespace System.Data.ZanDb;

public class VectorHeap {
    public int[] slots;
    public int[] ids;
    public double[] distances;
    public int count;
    public bool maximum;

    public VectorHeap(int capacity, bool maximum) {
        if (capacity < 4) { capacity = 4; }
        this.slots = new int[capacity];
        this.ids = new int[capacity];
        this.distances = new double[capacity];
        this.count = 0;
        this.maximum = maximum;
    }

    public static bool Before(double ad, int ai, int av, double bd, int bi, int bv) {
        if (ad < bd) { return true; }
        if (ad > bd) { return false; }
        if (ai < bi) { return true; }
        if (ai > bi) { return false; }
        return av < bv;
    }

    public bool Higher(double ad, int ai, int av, double bd, int bi, int bv) {
        if (this.maximum) { return VectorHeap.Before(bd, bi, bv, ad, ai, av); }
        return VectorHeap.Before(ad, ai, av, bd, bi, bv);
    }

    public void Grow() {
        int capacity = this.slots.Length * 2;
        int[] ns = new int[capacity];
        int[] ni = new int[capacity];
        double[] nd = new double[capacity];
        for (int i = 0; i < this.count; i = i + 1) {
            ns[i] = this.slots[i]; ni[i] = this.ids[i]; nd[i] = this.distances[i];
        }
        this.slots = ns; this.ids = ni; this.distances = nd;
    }

    public void Push(int slot, int id, double distance) {
        if (this.count == this.slots.Length) { this.Grow(); }
        int pos = this.count;
        this.count = this.count + 1;
        while (pos > 0) {
            int parent = (pos - 1) / 2;
            if (!this.Higher(distance, id, slot, this.distances[parent], this.ids[parent], this.slots[parent])) { break; }
            this.slots[pos] = this.slots[parent];
            this.ids[pos] = this.ids[parent];
            this.distances[pos] = this.distances[parent];
            pos = parent;
        }
        this.slots[pos] = slot; this.ids[pos] = id; this.distances[pos] = distance;
    }

    public void Pop() {
        this.count = this.count - 1;
        if (this.count == 0) { return; }
        int slot = this.slots[this.count];
        int id = this.ids[this.count];
        double distance = this.distances[this.count];
        int pos = 0;
        while (pos * 2 + 1 < this.count) {
            int child = pos * 2 + 1;
            int right = child + 1;
            if (right < this.count && this.Higher(this.distances[right], this.ids[right], this.slots[right],
                    this.distances[child], this.ids[child], this.slots[child])) { child = right; }
            if (!this.Higher(this.distances[child], this.ids[child], this.slots[child], distance, id, slot)) { break; }
            this.slots[pos] = this.slots[child];
            this.ids[pos] = this.ids[child];
            this.distances[pos] = this.distances[child];
            pos = child;
        }
        this.slots[pos] = slot; this.ids[pos] = id; this.distances[pos] = distance;
    }

    public int NearestSlot() {
        int best = 0;
        for (int i = 1; i < this.count; i = i + 1) {
            if (VectorHeap.Before(this.distances[i], this.ids[i], this.slots[i],
                    this.distances[best], this.ids[best], this.slots[best])) { best = i; }
        }
        return this.slots[best];
    }
}
