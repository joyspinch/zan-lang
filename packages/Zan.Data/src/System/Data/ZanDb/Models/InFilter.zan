using System;
using System.Json;
namespace System.Data.ZanDb;

public class InFilter {
    public string field;
    public List<string> values;
    public Dict<string, bool> valSet;

    public InFilter(string field, List<string> values) {
        this.field = field;
        this.values = values;
        this.valSet = new Dict<string, bool>();
        for (int i = 0; i < values.Count; i = i + 1) {
            this.valSet[values[i]] = true;
        }
    }
}

// 针对 <see cref="Collection"/> 的流畅 LINQ 风格查询：类型安全的 lambda
// 谓词、多索引求交加速、范围索引下推、O(n log n) 稳定归并排序与 Top-K 堆优化、
// Skip/Take 提前终止分页。求值推迟到 ToList/First/Count 时才进行。
