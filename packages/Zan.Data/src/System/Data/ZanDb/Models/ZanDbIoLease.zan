using System;
using System.Json;
using System.Net.Sockets;
using System.Security.Cryptography;
using System.Text;
using System.Threading;
namespace System.Data.ZanDb;

class ZanDbIoLease {
    ZanDbIoState state;
    Timer timer;

    ZanDbIoLease(TcpClient client, int timeoutMs, CancellationToken cancellation) {
        ZanDbIoState state = new ZanDbIoState(client, timeoutMs, cancellation);
        this.state = state;
        this.timer = new Timer(10, () => { state.Check(); });
        if (!this.timer.Start()) {
            state.Finish();
            throw new IOException("Cannot start ZanDB frame deadline timer.");
        }
        state.Check();
    }

    async void FinishAsync() {
        this.state.Finish();
        await this.timer.StopAsync();
    }

    void ThrowIfAborted() { this.state.ThrowIfAborted(); }
}
