using System;
using System.IO;
using System.Threading;
namespace System.Data.ZanDb;

public class CachePin {
    public ByteBuffer buf;
    public int pins;
    public int size;

    public CachePin(ByteBuffer buf, int size) {
        this.buf = buf;
        this.pins = 0;
        this.size = size;
    }
}
