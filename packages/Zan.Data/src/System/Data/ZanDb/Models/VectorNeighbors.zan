using System;
using System.Collections.Generic;
using System.Json;
using System.Threading;
namespace System.Data.ZanDb;

class VectorNeighbors {
    int[] slots;
    int count;
    VectorNeighbors(int capacity) { this.slots = new int[capacity]; this.count = 0; }

    bool Contains(int slot) {
        for (int i = 0; i < this.count; i = i + 1) {
            if (this.slots[i] == slot) { return true; }
        }
        return false;
    }
}
