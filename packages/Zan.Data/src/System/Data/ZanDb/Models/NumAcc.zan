using System;

namespace System.Data.ZanDb;

// 块级聚合的数值累加器：sum/count/min/max 由调用方按需取用。
public class NumAcc {
    public long sum;
    public long count;
    public long min;
    public long max;

    public void Add(long v) {
        this.sum = this.sum + v;
        this.count = this.count + 1;
        if (this.count == 1 || v < this.min) { this.min = v; }
        if (this.count == 1 || v > this.max) { this.max = v; }
    }
    public long Sum() { return this.sum; }
    public long Count() { return this.count; }
    public long Min() { return this.min; }
    public long Max() { return this.max; }
}
