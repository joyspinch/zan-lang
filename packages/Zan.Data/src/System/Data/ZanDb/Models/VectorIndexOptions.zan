using System;
using System.Collections.Generic;
using System.Json;
using System.Threading;
namespace System.Data.ZanDb;

public class VectorIndexOptions {
    public int dimensions;
    public int metric;
    public int m;
    public int efConstruction;
    public int efSearch;
    public int seed;
    // SQ8 量化码驻留：内存中的向量以每向量 min-max 量化的 1 字节
    // 码 + scale/offset 表示（4× 内存压缩），距离全部走码反量化
    // 近似；精确全扫在量化模式不可用（重建时关闭量化）。
    public bool quantize;

    public VectorIndexOptions() {
        this.dimensions = 0;
        this.metric = 0;
        this.m = 16;
        this.efConstruction = 100;
        this.efSearch = 64;
        this.seed = 1729;
        this.quantize = false;
    }

    public VectorIndexOptions(int dimensions) {
        this.dimensions = dimensions;
        this.metric = 0;
        this.m = 16;
        this.efConstruction = 100;
        this.efSearch = 64;
        this.seed = 1729;
        this.quantize = false;
    }

    public VectorIndexOptions(int dimensions, int metric) {
        this.dimensions = dimensions;
        this.metric = metric;
        this.m = 16;
        this.efConstruction = 100;
        this.efSearch = 64;
        this.seed = 1729;
        this.quantize = false;
    }

    public VectorIndexOptions(int dimensions, int metric, bool quantize) {
        this.dimensions = dimensions;
        this.metric = metric;
        this.m = 16;
        this.efConstruction = 100;
        this.efSearch = 64;
        this.seed = 1729;
        this.quantize = quantize;
    }

    public VectorIndexOptions Clone() {
        VectorIndexOptions copy = new VectorIndexOptions();
        copy.dimensions = this.dimensions;
        copy.metric = this.metric;
        copy.m = this.m;
        copy.efConstruction = this.efConstruction;
        copy.efSearch = this.efSearch;
        copy.seed = this.seed;
        copy.quantize = this.quantize;
        return copy;
    }

    public bool Equals(VectorIndexOptions other) {
        if (other == null) { return false; }
        return this.dimensions == other.dimensions
        && this.metric == other.metric
        && this.m == other.m
        && this.efConstruction == other.efConstruction
        && this.efSearch == other.efSearch
        && this.seed == other.seed
        && this.quantize == other.quantize;
    }

    public void Validate() {
        if (this.dimensions < 1 || this.dimensions > 65536) {
            throw new ArgumentException("Vector dimensions must be in [1,65536]");
        }
        if (this.metric != 0 && this.metric != 1) {
            throw new ArgumentException("Vector metric must be 0 (cosine) or 1 (squared L2)");
        }
        if (this.m < 2 || this.m > 128) {
            throw new ArgumentException("Vector m must be in [2,128]");
        }
        if (this.efConstruction < this.m || this.efConstruction > 1000000) {
            throw new ArgumentException("Vector efConstruction must be in [m,1000000]");
        }
        if (this.efSearch < 1 || this.efSearch > 1000000) {
            throw new ArgumentException("Vector efSearch must be in [1,1000000]");
        }
    }

    public JsonValue ToJson() {
        JsonValue obj = JsonValue.NewObject();
        obj.Put("dimensions", JsonValue.NewInt(this.dimensions));
        obj.Put("metric", JsonValue.NewInt(this.metric));
        obj.Put("m", JsonValue.NewInt(this.m));
        obj.Put("efConstruction", JsonValue.NewInt(this.efConstruction));
        obj.Put("efSearch", JsonValue.NewInt(this.efSearch));
        obj.Put("seed", JsonValue.NewInt(this.seed));
        obj.Put("quantize", JsonValue.NewBool(this.quantize));
        return obj;
    }

    public static VectorIndexOptions FromJson(JsonValue obj) {
        VectorStateJson.RequireObject(obj);
        VectorIndexOptions result = new VectorIndexOptions();
        result.dimensions = VectorStateJson.IntField(obj, "dimensions");
        if (obj.Has("metric")) { result.metric = VectorStateJson.IntField(obj, "metric"); }
        if (obj.Has("m")) { result.m = VectorStateJson.IntField(obj, "m"); }
        if (obj.Has("efConstruction")) { result.efConstruction = VectorStateJson.IntField(obj, "efConstruction"); }
        if (obj.Has("efSearch")) { result.efSearch = VectorStateJson.IntField(obj, "efSearch"); }
        if (obj.Has("seed")) { result.seed = VectorStateJson.IntField(obj, "seed"); }
        if (obj.Has("quantize")) { result.quantize = obj.Bool("quantize", false); }
        result.Validate();
        return result;
    }
}
