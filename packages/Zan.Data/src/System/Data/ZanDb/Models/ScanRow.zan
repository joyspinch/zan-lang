using System;
using System.IO;
using System.Threading;
namespace System.Data.ZanDb;

public class ScanRow {
    public SegCursor cur;
    public string memKey;
    public string memVal;

    // 绑定到段游标当前记录（零拷贝模式）。
    public void Bind(SegCursor c) {
        this.cur = c;
        this.memKey = "";
        this.memVal = "";
    }

    // 绑定到一对字符串（多源归并退化模式）。
    public void BindMem(string k, string v) {
        this.cur = null;
        this.memKey = k;
        this.memVal = v;
    }

    // 当前行的键（惰性物化，行内缓存；退化模式直接给字符串）。
    public string Key() { return this.cur != null ? this.cur.Key() : this.memKey; }

    // 当前行的值字符串（惰性物化，行内缓存）。
    public string Val() { return this.cur != null ? this.cur.Val() : this.memVal; }

    // 值所在块缓冲；退化模式下为 null，调用方须走字符串路径。
    public ByteBuffer Block() { return this.cur != null ? this.cur.Block() : null; }

    // 值在块内的起始偏移（退化模式无意义）。
    public int ValOff() { return this.cur != null ? this.cur.ValOff() : 0; }

    // 值的字节长度。
    public int ValLen() { return this.cur != null ? this.cur.ValLen() : 0; }

    // 值字节的裸指针（等于 Block().Raw() + ValOff()）。
    public nint ValPtr() {
        if (this.cur == null) { return 0; }
        ByteBuffer b = this.cur.Block();
        if (b == null) { return 0; }
        return b.Raw() + this.cur.ValOff();
    }
}

// 聚合内核回调：块级扫描按记录粒度交付（op=1 的存活 put），
// 键/值以（缓冲裸指针 + 偏移 + 长度）零拷贝给出——同一缓冲跨
// 块复用、回调期间有效。返回 false 早停整个扫描。
public delegate bool KernelVisit(nint basePtr, int keyOff, int keyLen, int valOff, int valLen);

// 覆盖索引内核回调：索引条目键以（缓冲裸指针 + 偏移 +
// 长度）零拷贝交付，id 段固定在键尾 6 字节；缓冲跨跨度复用、
// 回调期间有效。返回 false 早停。
public delegate bool KernelKeyVisit(nint basePtr, int keyOff, int keyLen);

// 段句柄：段文件与其全局段号的配对。
