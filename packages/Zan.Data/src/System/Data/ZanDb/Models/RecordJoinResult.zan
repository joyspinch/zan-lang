using System;

namespace System.Data.ZanDb;

// 多表关联结果对：包含左表行与右表行
// 支持 InnerJoin（左右均非空）与 LeftJoin（右表未匹配时为 null）
public class RecordJoinResult {
    public RecordRow left;
    public RecordRow right;

    public RecordJoinResult(RecordRow left, RecordRow right) {
        this.left = left;
        this.right = right;
    }

    public bool HasRight() {
        return this.right != null;
    }
}
