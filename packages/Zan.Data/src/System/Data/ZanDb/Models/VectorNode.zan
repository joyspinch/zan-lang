using System;
using System.Collections.Generic;
using System.Json;
using System.Threading;
namespace System.Data.ZanDb;

public class VectorNode {
    public int id;
    public int active;
    public int level;
    public double inverseNorm;
    // SQ8 量化驻留：反量化值 = code * quantScale + quantOffset
    //（每向量 min-max 归一；非量化模式恒 0/1 无效）。
    public double quantScale;
    public double quantOffset;
    public List<VectorNeighbors> layers;

    public VectorNode(int id, int level, int m, double inverseNorm) {
        this.id = id;
        this.active = 1;
        this.level = level;
        this.inverseNorm = inverseNorm;
        this.layers = new List<VectorNeighbors>();
        this.layers.Add(new VectorNeighbors(m * 2));
        for (int i = 1; i <= level; i = i + 1) {
            this.layers.Add(new VectorNeighbors(m));
        }
    }
}
