using System;
using System.IO;
using System.Json;
using System.Text;
namespace System.Data.ZanDb;

class CollectionSearchState {
    string field;
    string kind;
    string definition;
    string generation;
    string checkpoint;
    Bm25Index text;
    VectorIndex vector;
    VectorIndexOptions options;
    long applied;
    CollectionSearchState(string field, string kind, string definition, string generation) {
        this.field = field;
        this.kind = kind;
        this.definition = definition;
        this.generation = generation;
        this.checkpoint = "";
        this.applied = -1;
    }
}

