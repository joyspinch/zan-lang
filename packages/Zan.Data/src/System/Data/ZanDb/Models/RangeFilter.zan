using System;
using System.Json;
namespace System.Data.ZanDb;

public class RangeFilter {
    public string field;
    public string lo;
    public string hi;

    public RangeFilter(string field, string lo, string hi) {
        this.field = field;
        this.lo = lo;
        this.hi = hi;
    }
}

