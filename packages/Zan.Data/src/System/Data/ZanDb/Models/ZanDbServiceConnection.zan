using System;
using System.Json;
using System.Net.Sockets;
using System.Text;
using System.Threading;
namespace System.Data.ZanDb;

public class ZanDbServiceConnection {
    public TcpClient client;
    public long task;
    public bool busy;

    public ZanDbServiceConnection(TcpClient client) {
        this.client = client;
        this.task = 0;
        this.busy = false;
    }
}

// 底层数据库文件唯一持有者；所有操作（含带缓存变更的读）均受排他写锁保护。
