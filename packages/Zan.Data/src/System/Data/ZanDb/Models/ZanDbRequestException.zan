using System;
using System.Json;
using System.Net.Sockets;
using System.Security.Cryptography;
using System.Text;
using System.Threading;
namespace System.Data.ZanDb;

class ZanDbRequestException : Exception {
    public string code;

    ZanDbRequestException(string code, string message) {
        this.code = code;
        this.Message = message;
    }
}

// 回调持有独立状态对象；监视器防止并发操作竞争。
