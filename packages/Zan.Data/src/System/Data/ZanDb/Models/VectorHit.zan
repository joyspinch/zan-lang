using System;
using System.Collections.Generic;
using System.Json;
using System.Threading;
namespace System.Data.ZanDb;

class VectorHit {
    int id;
    double distance;

    VectorHit() { this.id = 0; this.distance = 0; }
    VectorHit(int id, double distance) { this.id = id; this.distance = distance; }
}
