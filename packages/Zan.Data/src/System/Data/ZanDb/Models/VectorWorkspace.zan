using System;
using System.Collections.Generic;
using System.Json;
using System.Threading;
namespace System.Data.ZanDb;

class VectorWorkspace {
    float[] query;
    int offset;
    double inverseNorm;
    int[] visited;
    int epoch;
    long distanceCount;

    VectorWorkspace(float[] query, int offset, double inverseNorm, int count) {
        this.query = query;
        this.offset = offset;
        this.inverseNorm = inverseNorm;
        this.visited = new int[count];
        this.epoch = 0;
        this.distanceCount = 0;
    }
}

// 纯 Zan 实现的 HNSW 向量索引（余弦距离与平方 L2 距离）；支持并发只读查询。
