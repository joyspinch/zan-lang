using System;
using System.Collections.Generic;
using System.Json;
using System.Threading;
namespace System.Data.ZanDb;

public class VectorWorkspace {
    public float[] query;
    public int offset;
    public double inverseNorm;
    public int[] visited;
    public int epoch;
    public long distanceCount;
    // 量化模式预计算的 Σq（查询向量各维之和），供余弦 ADC 单趟展开；
    // 非量化模式恒 0 不读。
    public double sumQuery;

    public VectorWorkspace(float[] query, int offset, double inverseNorm, int count) {
        this.query = query;
        this.offset = offset;
        this.inverseNorm = inverseNorm;
        this.visited = new int[count];
        this.epoch = 0;
        this.distanceCount = 0;
        this.sumQuery = 0;
    }
}
