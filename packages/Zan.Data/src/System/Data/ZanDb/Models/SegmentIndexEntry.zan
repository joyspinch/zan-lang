using System;
using System.IO;
namespace System.Data.ZanDb;

public class SegmentIndexEntry {
    public long offset;
    public string key;
    public long crc;
    public int verified;

    public SegmentIndexEntry(long offset, string key, long crc) {
        this.offset = offset;
        this.key = key != null ? key : "";
        this.crc = crc;
        this.verified = 0;
    }
}

// 不可变有序段文件的读取端：稀疏索引二分定位块（一次块读 +
// CRC 校验），块内顺序解析。点查与范围扫描共用同一套块读取。
