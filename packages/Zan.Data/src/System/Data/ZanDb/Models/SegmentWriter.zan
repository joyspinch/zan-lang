using System;
using System.IO;
namespace System.Data.ZanDb;

public class SegmentWriter {
    // 段文件魔数（头尾各一次）。
    public static string MAGIC = "ZSEG";
    public static int VERSION = 1;
    // 每 N 条记录落一个稀疏索引项（第 0 条必落）。
    public static int SPARSE_EVERY = 16;
    // 记录缓冲达到该字节数就刷盘。
    public static int WRITE_BUF = 262144;

    public PageFile file;
    public ByteBuffer buf;
    public long fileLen;
    public long recCount;
    public List<SegmentSparseWriteEntry> sparseEntries;
    public bool failed;
    public string lastError;

    public SegmentWriter() {
        this.buf = ByteBuffer.Alloc(SegmentWriter.WRITE_BUF);
        this.sparseEntries = new List<SegmentSparseWriteEntry>();
        this.fileLen = 0;
        this.recCount = 0;
        this.failed = false;
        this.lastError = "";
    }

    // 创建段文件并写入头部占位（记录数在
    // <see cref="Finish"/> 时回填）。
    public static SegmentWriter Create(string path) {
        SegmentWriter w = new SegmentWriter();
        w.file = PageFile.Open(path);
        if (!w.file.IsOpen()) {
            w.failed = true;
            w.lastError = w.file.GetError();
            return w;
        }
        ByteBuffer h = ByteBuffer.Alloc(16);
        h.WriteRaw(SegmentWriter.MAGIC, 4);
        h.WriteU32(SegmentWriter.VERSION);
        h.WriteU64(0);
        if (w.file.WriteAt(0, h.Raw(), 16) != 16) {
            w.failed = true;
            w.lastError = "segment header write failed";
        }
        h.Free();
        w.fileLen = 16;
        return w;
    }

    // 写入是否已失败。
    public bool Failed() { return this.failed; }

    // 最近一次错误描述。
    public string GetError() { return this.lastError; }

    // 追加一条记录；键必须严格升序（由调用方保证，
    // 内存排序的结果天然满足）。op 1=put、2=del（del 不带值）。
    public void Add(string key, string val, int op) {
        if (this.failed) { return; }
        if (this.recCount % SegmentWriter.SPARSE_EVERY == 0) {
            this.sparseEntries.Add(new SegmentSparseWriteEntry(this.fileLen + this.buf.Length(), key));
        }
        this.buf.WriteU8(op);
        this.buf.WriteString(key);
        if (op == 1) { this.buf.WriteString(val); }
        this.recCount = this.recCount + 1;
        if (this.buf.Length() >= SegmentWriter.WRITE_BUF) { this.FlushBuf(); }
    }

    // 缓冲刷到文件当前末尾。
    public void FlushBuf() {
        if (this.failed || this.buf.Length() == 0) { return; }
        int n = this.file.WriteAt(this.fileLen, this.buf.Raw(), this.buf.Length());
        if (n != this.buf.Length()) {
            this.failed = true;
            this.lastError = "segment write failed";
            return;
        }
        this.fileLen = this.fileLen + n;
        this.buf.Clear();
    }

    // 完成段：刷记录 → 回读逐块算 CRC 写索引 →
    // 写尾部 → 回填头部记录数 → fsync。成功后调用方应立刻
    // 丢弃本写入端（段不可变）。
    public bool Finish() {
        if (this.failed) { return false; }
        this.FlushBuf();
        if (this.failed) { return false; }
        long indexStart = this.fileLen;
        // 索引块以条目数开头，与 SegmentFile.Open 的解析对齐。
        this.buf.WriteU32(this.sparseEntries.Count);

        ByteBuffer block = ByteBuffer.Alloc(256);
        int n = this.sparseEntries.Count;
        for (int i = 0; i < n; i = i + 1) {
            long end = indexStart;
            if (i + 1 < n) { end = this.sparseEntries[i + 1].offset; }
            int len = (int)(end - this.sparseEntries[i].offset);
            long crc = 0;
            if (len > 0) {
                block.EnsureCapacity(len);
                int got = this.file.ReadAt(this.sparseEntries[i].offset, block, len);
                if (got == len) { crc = block.Crc32(len); }
                else {
                    this.failed = true;
                    this.lastError = "segment verify read failed";
                    break;
                }
            }
            this.buf.EnsureRoom(24 + this.sparseEntries[i].key.Length);
            this.buf.WriteU64(this.sparseEntries[i].offset);
            this.buf.WriteString(this.sparseEntries[i].key);
            this.buf.WriteU32(crc);
        }
        block.Free();
        if (this.failed) { return false; }
        this.FlushBuf();
        if (this.failed) { return false; }

        ByteBuffer foot = ByteBuffer.Alloc(12);
        foot.WriteU64(indexStart);
        foot.WriteRaw(SegmentWriter.MAGIC, 4);
        if (this.file.WriteAt(this.fileLen, foot.Raw(), 12) != 12) {
            this.failed = true;
            this.lastError = "segment footer write failed";
        }
        foot.Free();
        if (this.failed) { return false; }
        this.fileLen = this.fileLen + 12;

        ByteBuffer h = ByteBuffer.Alloc(16);
        h.WriteRaw(SegmentWriter.MAGIC, 4);
        h.WriteU32(SegmentWriter.VERSION);
        h.WriteU64(this.recCount);
        if (this.file.WriteAt(0, h.Raw(), 16) != 16) {
            this.failed = true;
            this.lastError = "segment header rewrite failed";
        }
        h.Free();
        if (this.failed) { return false; }

        if (!this.file.Sync()) {
            this.lastError = "segment sync failed";
            return false;
        }
        this.file.Close();
        return true;
    }
}

// 稀疏索引读取项实体（消除 sparseOff / sparseKey / sparseCrc / blockVerified 四组平行列表反模式）。
