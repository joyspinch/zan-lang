using System;
using System.IO;
namespace System.Data.ZanDb;

public class SegmentSparseWriteEntry {
    public long offset;
    public string key;

    public SegmentSparseWriteEntry(long offset, string key) {
        this.offset = offset;
        this.key = key != null ? key : "";
    }
}

// 不可变有序段文件的写入端：调用方按
// <see cref="String.CompareOrdinal"/> 升序逐条 <see cref="Add"/>，
// <see cref="Finish"/> 时回读校验并落稀疏索引。
// 文件布局（小端）：
// 头部   "ZSEG" + u32 version + u64 记录数          （16 字节）
// 记录   u8 op（1=put 2=del）+ varint 键 + [varint 值]
// （键按 CompareOrdinal 升序，由写入方保证）
// 索引   u32 项数 + 每项 { u64 块偏移 + varint 块首键
// + u32 块 CRC }
// 尾部   u64 索引偏移 + "ZSEG"                      （12 字节）
// 索引项覆盖的块 = 本项偏移到下一项偏移（末项到索引区起点）。
// CRC 在 Finish 时回读整段算出——「创建即校验」：之后每次
// 块读取都能凭它发现磁盘腐坏。
