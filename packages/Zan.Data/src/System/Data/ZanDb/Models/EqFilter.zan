using System;
using System.Json;
namespace System.Data.ZanDb;

class EqFilter {
    public string field;
    public string val;

    // 私有构造；经 <see cref="DocQuery.WhereEq"/> 创建。
    public EqFilter(string field, string val) {
        this.field = field;
        this.val = val;
    }
}

