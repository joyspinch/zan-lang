using System;
using System.Collections.Generic;
using System.Json;
using System.Threading;
namespace System.Data.ZanDb;

public class VectorHit {
    public int id;
    public double distance;

    public VectorHit() { this.id = 0; this.distance = 0; }
    public VectorHit(int id, double distance) { this.id = id; this.distance = distance; }
}
