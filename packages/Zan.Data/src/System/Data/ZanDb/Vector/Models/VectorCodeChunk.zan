using System;
using System.Collections.Generic;
using System.Json;
using System.Threading;
namespace System.Data.ZanDb;

// SQ8 量化码块：与 VectorChunk 平行的 1 字节码存储，
// 布局同构（chunkRows × dimensions）。反量化值 =
// code * node.quantScale + node.quantOffset。
public class VectorCodeChunk {
    public byte[] values;
    public VectorCodeChunk(int size) { this.values = new byte[size]; }
}
