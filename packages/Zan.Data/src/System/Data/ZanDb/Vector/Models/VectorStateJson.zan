using System;
using System.Collections.Generic;
using System.Json;
using System.Threading;
namespace System.Data.ZanDb;

public class VectorStateJson {
    public static void RequireObject(JsonValue obj) {
        if (obj == null) { throw new ArgumentException("Missing vector state object"); }
        if (!obj.IsObject()) { throw new ArgumentException("Expected vector state object"); }
        Dict<string, int> keys = new Dict<string, int>();
        for (int i = 0; i < obj.Count(); i = i + 1) {
            string key = obj.KeyAt(i);
            if (keys.ContainsKey(key)) { throw new ArgumentException("Duplicate vector state key"); }
            keys.Add(key, 1);
        }
    }

    public static JsonValue Field(JsonValue obj, string key) {
        JsonValue value = obj.Get(key);
        if (value == null) { throw new ArgumentException("Missing vector state field: " + key); }
        return value;
    }

    public static int IntValue(JsonValue value) {
        if (value == null) { throw new ArgumentException("Missing vector state integer"); }
        if (!value.IsNumber()) { throw new ArgumentException("Expected vector state integer"); }
        double number = value.AsDouble(0);
        if (number != number || number - number != 0 || number < -2147483648.0 || number > 2147483647.0) {
            throw new ArgumentException("Vector state integer out of range");
        }
        int result = (int)number;
        if ((double)result != number) { throw new ArgumentException("Fractional vector state integer"); }
        return result;
    }

    public static int IntField(JsonValue obj, string key) {
        return VectorStateJson.IntValue(VectorStateJson.Field(obj, key));
    }

    public static JsonValue ArrayField(JsonValue obj, string key) {
        JsonValue value = VectorStateJson.Field(obj, key);
        if (!value.IsArray()) { throw new ArgumentException("Expected vector state array: " + key); }
        return value;
    }
}
