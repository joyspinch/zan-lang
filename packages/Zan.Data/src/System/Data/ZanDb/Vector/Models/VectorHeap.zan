using System;
using System.Collections.Generic;
using System.Json;
using System.Threading;
namespace System.Data.ZanDb;

public class VectorHeap {
    public int[] slots;
    public int[] ids;
    public double[] distances;
    public int count;
    public bool maximum;

    public VectorHeap(int capacity, bool maximum) {
        if (capacity < 4) { capacity = 4; }
        this.slots = new int[capacity];
        this.ids = new int[capacity];
        this.distances = new double[capacity];
        this.count = 0;
        this.maximum = maximum;
    }

    public static bool Before(double ad, int ai, int av, double bd, int bi, int bv) {
        if (ad < bd) { return true; }
        if (ad > bd) { return false; }
        if (ai < bi) { return true; }
        if (ai > bi) { return false; }
        return av < bv;
    }

    public bool Higher(double ad, int ai, int av, double bd, int bi, int bv) {
        if (this.maximum) { return VectorHeap.Before(bd, bi, bv, ad, ai, av); }
        return VectorHeap.Before(ad, ai, av, bd, bi, bv);
    }

    public void Grow() {
        long capL = (long)this.slots.Length * 2L;
        if (capL > 2147483647L || (int)capL <= this.slots.Length) {
            throw new InvalidOperationException("VectorHeap capacity overflow");
        }
        int capacity = (int)capL;
        int[] ns = new int[capacity];
        int[] ni = new int[capacity];
        double[] nd = new double[capacity];
        for (int i = 0; i < this.count; i = i + 1) {
            ns[i] = this.slots[i]; ni[i] = this.ids[i]; nd[i] = this.distances[i];
        }
        this.slots = ns; this.ids = ni; this.distances = nd;
    }

    public void Push(int slot, int id, double distance) {
        if (this.count == this.slots.Length) { this.Grow(); }
        int pos = this.count;
        this.count = pos + 1;
        if (this.maximum) {
            while (pos > 0) {
                int parent = (pos - 1) >> 1;
                double pd = this.distances[parent];
                if (distance < pd || (distance == pd && (id < this.ids[parent] || (id == this.ids[parent] && slot <= this.slots[parent])))) { break; }
                this.slots[pos] = this.slots[parent];
                this.ids[pos] = this.ids[parent];
                this.distances[pos] = pd;
                pos = parent;
            }
        } else {
            while (pos > 0) {
                int parent = (pos - 1) >> 1;
                double pd = this.distances[parent];
                if (distance > pd || (distance == pd && (id > this.ids[parent] || (id == this.ids[parent] && slot >= this.slots[parent])))) { break; }
                this.slots[pos] = this.slots[parent];
                this.ids[pos] = this.ids[parent];
                this.distances[pos] = pd;
                pos = parent;
            }
        }
        this.slots[pos] = slot; this.ids[pos] = id; this.distances[pos] = distance;
    }

    public void Pop() {
        if (this.count <= 0) { return; }
        int n = this.count - 1;
        this.count = n;
        if (n == 0) { return; }
        int slot = this.slots[n];
        int id = this.ids[n];
        double distance = this.distances[n];
        int pos = 0;
        if (this.maximum) {
            while (true) {
                int child = (pos << 1) + 1;
                if (child >= n) { break; }
                int right = child + 1;
                if (right < n) {
                    double rd = this.distances[right];
                    double cd = this.distances[child];
                    if (rd > cd || (rd == cd && (this.ids[right] > this.ids[child] || (this.ids[right] == this.ids[child] && this.slots[right] > this.slots[child])))) {
                        child = right;
                    }
                }
                double cd2 = this.distances[child];
                if (cd2 < distance || (cd2 == distance && (this.ids[child] < id || (this.ids[child] == id && this.slots[child] <= slot)))) { break; }
                this.slots[pos] = this.slots[child];
                this.ids[pos] = this.ids[child];
                this.distances[pos] = cd2;
                pos = child;
            }
        } else {
            while (true) {
                int child = (pos << 1) + 1;
                if (child >= n) { break; }
                int right = child + 1;
                if (right < n) {
                    double rd = this.distances[right];
                    double cd = this.distances[child];
                    if (rd < cd || (rd == cd && (this.ids[right] < this.ids[child] || (this.ids[right] == this.ids[child] && this.slots[right] < this.slots[child])))) {
                        child = right;
                    }
                }
                double cd2 = this.distances[child];
                if (cd2 > distance || (cd2 == distance && (this.ids[child] > id || (this.ids[child] == id && this.slots[child] >= slot)))) { break; }
                this.slots[pos] = this.slots[child];
                this.ids[pos] = this.ids[child];
                this.distances[pos] = cd2;
                pos = child;
            }
        }
        this.slots[pos] = slot; this.ids[pos] = id; this.distances[pos] = distance;
    }

    public int NearestSlot() {
        if (this.count <= 0) { return -1; }
        int best = 0;
        for (int i = 1; i < this.count; i = i + 1) {
            if (VectorHeap.Before(this.distances[i], this.ids[i], this.slots[i],
                    this.distances[best], this.ids[best], this.slots[best])) { best = i; }
        }
        return this.slots[best];
    }
}
