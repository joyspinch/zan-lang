using System;
using System.Collections.Generic;
using System.IO;
using System.Threading;
using System.Interop;

namespace System.Data.ZanDb;

// 列式向量表：.zvec 定长按 ID 寻址 + appendBuf 增量双路检索 + 墓碑软删 + .zhnsw 快照。
public class VectorTable : IDisposable {
    public static string MAGIC_VEC = "ZVEC";
    public static string MAGIC_HNSW = "ZHNS";
    public static int HEADER_SIZE = 32;
    public static int VERSION = 1;

    public string basePath;
    public string name;
    public string vecPath;
    public string hnswPath;
    public PageFile file;
    public nint ioMtx;
    public VectorIndex index;
    public VectorIndexOptions options;
    public RwLock tlock;
    public int totalRows;
    public int activeRows;
    public int indexedRows;
    public List<float[]> appendBuf;
    public List<int> appendIds;
    public Dict<int, bool> tombstones;
    public string lastError;

    public VectorTable() {
        this.basePath = "";
        this.name = "";
        this.vecPath = "";
        this.hnswPath = "";
        this.totalRows = 0;
        this.activeRows = 0;
        this.indexedRows = 0;
        this.appendBuf = new List<float[]>();
        this.appendIds = new List<int>();
        this.tombstones = new Dict<int, bool>();
        this.lastError = "";
        this.tlock = new RwLock();
        this.ioMtx = Mutex.Create();
    }

    // 打开或创建专用向量表：
    // basePath 为主库路径（如 "app.zdb"），伴生文件为 "app.zdb.<name>.zvec" 与 ".zhnsw"。
    public static VectorTable Open(string basePath, string name, VectorIndexOptions options) {
        VectorTable vt = new VectorTable();
        if (basePath == null || basePath.Length == 0) {
            vt.lastError = "invalid vector table base path";
            vt.Close();
            return vt;
        }
        if (!RecordTable.IsValidTableName(name)) {
            vt.lastError = "invalid vector table name";
            vt.Close();
            return vt;
        }
        vt.basePath = basePath;
        vt.name = name;
        vt.vecPath = basePath + "." + name + ".zvec";
        vt.hnswPath = basePath + "." + name + ".zhnsw";
        vt.options = options != null ? options.Clone() : new VectorIndexOptions();

        if (File.Exists(vt.vecPath)) {
            vt.file = PageFile.OpenExisting(vt.vecPath);
            if (!vt.file.IsOpen()) {
                vt.lastError = "cannot open zvec file: " + vt.file.GetError();
                vt.Close();
                return vt;
            }
            // 读取 32 字节头部
            ByteBuffer h = ByteBuffer.Alloc(HEADER_SIZE);
            string magic = "";
            int ver = 0;
            int dims = 0;
            int metric = 0;
            long total = 0L;
            long active = 0L;
            bool hdrOk = false;
            try {
                if (vt.file.ReadAt(0, h, HEADER_SIZE) == HEADER_SIZE) {
                    h.SeekRead(0);
                    magic = h.Str(0, 4);
                    h.SeekRead(4);
                    ver = (int)h.ReadU32();
                    dims = (int)h.ReadU32();
                    metric = (int)h.ReadU32();
                    total = h.ReadU64();
                    active = h.ReadU64();
                    hdrOk = true;
                }
            } finally {
                h.Free();
            }
            if (!hdrOk) {
                vt.lastError = "truncated zvec header";
                vt.Close();
                return vt;
            }

            if (magic != MAGIC_VEC || ver != VERSION) {
                vt.lastError = "invalid zvec magic or version";
                vt.Close();
                return vt;
            }
            if (dims <= 0 || dims > 65536 || metric < 0 || metric > 1) {
                vt.lastError = "invalid zvec header dimensions or metric";
                vt.Close();
                return vt;
            }
            if (total < 0L || total > 2147483646L || active < 0L || active > total) {
                vt.lastError = "corrupt zvec row counts";
                vt.Close();
                return vt;
            }
            if (vt.options.dimensions <= 0) {
                vt.options.dimensions = dims;
                vt.options.metric = metric;
            } else if (vt.options.dimensions != dims) {
                vt.lastError = "dimensions mismatch: header=" + Convert.ToString(dims) + " opts=" + Convert.ToString(vt.options.dimensions);
                vt.Close();
                return vt;
            }
            vt.totalRows = (int)total;
            vt.activeRows = (int)active;
        } else {
            if (vt.options.dimensions <= 0) {
                vt.lastError = "dimensions must be positive for new VectorTable";
                vt.Close();
                return vt;
            }
            vt.file = PageFile.Open(vt.vecPath);
            if (!vt.file.IsOpen()) {
                vt.lastError = "cannot create zvec file: " + vt.file.GetError();
                vt.Close();
                return vt;
            }
            vt.WriteHeaderLocked(0, 0);
        }

        vt.options.Validate();
        vt.index = new VectorIndex(vt.options);

        // 尝试从 .zhnsw 恢复快照；若无快照或快照损坏，从 .zvec 顺序重放构建
        bool indexLoaded = false;
        if (File.Exists(vt.hnswPath)) {
            indexLoaded = vt.LoadHnswSnapshotLocked();
        }
        if (indexLoaded) {
            if (vt.indexedRows < vt.index.nodes.Count) {
                vt.indexedRows = vt.index.nodes.Count;
            }
            for (int si = 0; si < vt.index.nodes.Count; si = si + 1) {
                int nid = vt.index.nodes[si].id;
                if (nid > vt.indexedRows) { vt.indexedRows = nid; }
            }
            if (vt.indexedRows > vt.totalRows) { vt.indexedRows = vt.totalRows; }
            // 标记在 index 中已被软删除（或跳过未索引的墓碑）的槽位
            for (int id = 1; id <= vt.indexedRows; id = id + 1) {
                if (!vt.index.idSlots.ContainsKey(id)) {
                    vt.tombstones[id] = true;
                }
            }
            // 若 totalRows 大于已索引行数，装入 appendBuf 保持立即可查
            if (vt.totalRows > vt.indexedRows) {
                for (int id = vt.indexedRows + 1; id <= vt.totalRows; id = id + 1) {
                    float[] v = vt.GetLocked(id);
                    if (v != null) {
                        vt.appendBuf.Add(v);
                        vt.appendIds.Add(id);
                    }
                }
            }
            int expectedActive = vt.totalRows - vt.tombstones.Count;
            if (vt.activeRows != expectedActive) {
                vt.WriteHeaderLocked((long)vt.totalRows, (long)expectedActive);
            }
        } else if (vt.totalRows > 0) {
            vt.RebuildIndexLocked();
        }

        return vt;
    }

    private static ByteBuffer BuildVecHeader(int dims, int metric, long total, long active) {
        ByteBuffer h = ByteBuffer.Alloc(HEADER_SIZE);
        h.WriteU8(90); h.WriteU8(86); h.WriteU8(69); h.WriteU8(67); // "ZVEC"
        h.WriteU32((long)VERSION);
        h.WriteU32((long)dims);
        h.WriteU32((long)metric);
        h.WriteU64(total);
        h.WriteU64(active);
        return h;
    }

    // 写入头部元数据（持写锁或初始化时调用）
    public void WriteHeaderLocked(long total, long active) {
        if (this.file == null || !this.file.IsOpen() || this.options == null) { return; }
        this.totalRows = (int)total;
        this.activeRows = (int)active;
        ByteBuffer h = VectorTable.BuildVecHeader(this.options.dimensions, this.options.metric, total, active);
        try {
            Mutex.Lock(this.ioMtx);
            try {
                this.file.WriteAt(0, h.Raw(), HEADER_SIZE);
            } finally {
                Mutex.Unlock(this.ioMtx);
            }
        } finally {
            h.Free();
        }
    }

    public bool IsOpen() {
        return this.file != null && this.file.IsOpen() && this.lastError == "";
    }

    public string GetError() {
        return this.lastError != "" ? this.lastError : (this.file != null ? this.file.GetError() : "");
    }

    public int Dimensions() {
        return this.options != null ? this.options.dimensions : 0;
    }

    public int Count() {
        this.tlock.EnterRead();
        try { return this.activeRows; }
        finally { this.tlock.ExitRead(); }
    }

    public int TotalRows() {
        this.tlock.EnterRead();
        try { return this.totalRows; }
        finally { this.tlock.ExitRead(); }
    }

    public int IndexedRows() {
        this.tlock.EnterRead();
        try { return this.indexedRows; }
        finally { this.tlock.ExitRead(); }
    }

    public int PendingAppendCount() {
        this.tlock.EnterRead();
        try { return this.appendBuf.Count; }
        finally { this.tlock.ExitRead(); }
    }

    public int Add(float[] vector) {
        this.tlock.EnterWrite();
        try {
            if (!this.IsOpen()) { throw new InvalidOperationException("VectorTable is not open: " + this.GetError()); }
            if (vector == null || vector.Length != this.options.dimensions) {
                throw new ArgumentException("vector dimension mismatch: expected " + Convert.ToString(this.options.dimensions));
            }
            if (this.totalRows >= 2147483646) {
                throw new InvalidOperationException("VectorTable row capacity exhausted");
            }
            int id = this.totalRows + 1;
            int bytesPerVec = this.options.dimensions * 4;
            long offset = (long)HEADER_SIZE + (long)(id - 1) * (long)bytesPerVec;
            int written = 0;
            Mutex.Lock(this.ioMtx);
            try {
                written = this.file.WriteAt(offset, (nint)vector, bytesPerVec);
            } finally {
                Mutex.Unlock(this.ioMtx);
            }
            if (written != bytesPerVec) {
                throw new IOException("failed to write vector row: " + this.file.GetError());
            }
            this.appendBuf.Add(vector);
            this.appendIds.Add(id);
            int newActive = id - this.tombstones.Count;
            this.WriteHeaderLocked((long)id, (long)newActive);
            return id;
        } finally { this.tlock.ExitWrite(); }
    }

    public void AddBulk(List<float[]> vectors, out int firstId) {
        this.AddBulk(vectors, out firstId, false);
    }

    public void AddBulk(List<float[]> vectors, out int firstId, bool indexNow) {
        this.tlock.EnterWrite();
        try {
            firstId = 0;
            if (!this.IsOpen()) { throw new InvalidOperationException("VectorTable is not open: " + this.GetError()); }
            if (vectors == null || vectors.Count == 0) { return; }
            int n = vectors.Count;
            int dims = this.options.dimensions;
            if ((long)this.totalRows + (long)n > 2147483646L) {
                throw new InvalidOperationException("VectorTable row capacity exhausted");
            }
            // 先全量预校验，确保出错时不产生半写入与 appendBuf 状态漂移
            for (int i = 0; i < n; i = i + 1) {
                float[] v = vectors[i];
                if (v == null || v.Length != dims) {
                    throw new ArgumentException("vector at " + Convert.ToString(i) + " dimension mismatch");
                }
            }
            firstId = this.totalRows + 1;

            long startOffset = (long)HEADER_SIZE + (long)(firstId - 1) * (long)dims * 4L;
            int bytesPerVec = dims * 4;

            Mutex.Lock(this.ioMtx);
            try {
                for (int i = 0; i < n; i = i + 1) {
                    float[] v = vectors[i];
                    long off = startOffset + (long)i * (long)bytesPerVec;
                    if (this.file.WriteAt(off, (nint)v, bytesPerVec) != bytesPerVec) {
                        throw new IOException("failed to write bulk vector row at " + Convert.ToString(i) + ": " + this.file.GetError());
                    }
                }
            } finally {
                Mutex.Unlock(this.ioMtx);
            }
            for (int i = 0; i < n; i = i + 1) {
                this.appendBuf.Add(vectors[i]);
                this.appendIds.Add(firstId + i);
            }
            int newTotal = firstId + n - 1;
            int newActive = newTotal - this.tombstones.Count;
            this.WriteHeaderLocked((long)newTotal, (long)newActive);
            if (indexNow) {
                this.CatchUpIndexLocked();
            }
        } finally { this.tlock.ExitWrite(); }
    }

    // 将 appendBuf 增量队列中的向量批量挂载入 HNSW 索引图
    public void CatchUpIndex() {
        this.tlock.EnterWrite();
        try {
            this.CatchUpIndexLocked();
        } finally { this.tlock.ExitWrite(); }
    }

    public void CatchUpIndexLocked() {
        if (!this.IsOpen() || this.appendBuf.Count == 0) { return; }
        int n = this.appendBuf.Count;
        for (int i = 0; i < n; i = i + 1) {
            int id = this.appendIds[i];
            if (!this.tombstones.ContainsKey(id)) {
                this.index.Add(id, this.appendBuf[i]);
            }
        }
        this.indexedRows = this.totalRows;
        this.appendBuf.Clear();
        this.appendIds.Clear();
    }

    // 全量重构或更新 HNSW 内存图索引
    public void BuildIndex() {
        this.CatchUpIndex();
    }

    // 按 ID 读取原始向量（O(1) 绝对物理寻址）：
    public float[] Get(int id) {
        this.tlock.EnterRead();
        try {
            return this.GetLocked(id);
        } finally { this.tlock.ExitRead(); }
    }

    // 内部持读/写锁直读变体
    public float[] GetLocked(int id) {
        if (!this.IsOpen() || id < 1 || id > this.totalRows) { return null; }
        if (this.tombstones.ContainsKey(id)) { return null; }

        // 若在 appendBuf 内存缓冲中，直接内存拷贝直出
        int appCount = this.appendIds.Count;
        if (appCount > 0 && id > this.indexedRows) {
            int idx = id - this.indexedRows - 1;
            if (idx >= 0 && idx < appCount && this.appendIds[idx] == id) {
                float[] src = this.appendBuf[idx];
                float[] copy = new float[src.Length];
                NativeMemory.Copy((nint)copy, (nint)src, src.Length * 4);
                return copy;
            }
        }

        int dims = this.options.dimensions;
        long offset = (long)HEADER_SIZE + (long)(id - 1) * (long)dims * 4L;
        float[] v = new float[dims];
        int got = 0;
        Mutex.Lock(this.ioMtx);
        try {
            got = this.file.ReadRaw(offset, (nint)v, dims * 4);
        } finally {
            Mutex.Unlock(this.ioMtx);
        }
        if (got != dims * 4) { return null; }
        return v;
    }

    // 软删除向量（标记墓碑，从索引图和统计中剔除，ID 物理槽位永不前移错位）
    public void Remove(int id) {
        this.tlock.EnterWrite();
        try {
            if (!this.IsOpen() || id < 1 || id > this.totalRows) { return; }
            if (this.tombstones.ContainsKey(id)) { return; }
            this.tombstones[id] = true;
            if (this.index != null) {
                this.index.Remove(id);
            }
            int newActive = this.totalRows - this.tombstones.Count;
            if (newActive < 0) { newActive = 0; }
            this.activeRows = newActive;
            this.WriteHeaderLocked((long)this.totalRows, (long)newActive);
        } finally { this.tlock.ExitWrite(); }
    }

    public void Vacuum() {
        this.tlock.EnterWrite();
        try {
            if (!this.IsOpen()) { return; }
            this.CatchUpIndexLocked();
            if (this.tombstones.Count == 0 && this.activeRows == this.totalRows) { return; }
            string tmpVec = this.vecPath + ".vac.tmp";
            string bakVec = this.vecPath + ".bak";
            if (File.Exists(tmpVec)) { File.Delete(tmpVec); }
            if (File.Exists(bakVec)) { File.Delete(bakVec); }

            PageFile newFile = PageFile.Open(tmpVec);
            if (!newFile.IsOpen()) { return; }

            int dims = this.options.dimensions;
            int bytesPerVec = dims * 4;
            VectorIndex newIndex = new VectorIndex(this.options);
            int newId = 1;
            try {
                long newTotal = (long)this.activeRows;
                ByteBuffer h = VectorTable.BuildVecHeader(dims, this.options.metric, newTotal, newTotal);
                int hw = 0;
                try {
                    hw = newFile.WriteAt(0, h.Raw(), HEADER_SIZE);
                } finally {
                    h.Free();
                }
                if (hw != HEADER_SIZE) { throw new IOException("failed to write vacuum vector header"); }

                float[] scratchVec = new float[dims];
                for (int oldId = 1; oldId <= this.totalRows; oldId = oldId + 1) {
                    if (!this.tombstones.ContainsKey(oldId)) {
                        long offset = (long)HEADER_SIZE + (long)(oldId - 1) * (long)bytesPerVec;
                        int got = 0;
                        Mutex.Lock(this.ioMtx);
                        try {
                            got = this.file.ReadRaw(offset, (nint)scratchVec, bytesPerVec);
                        } finally {
                            Mutex.Unlock(this.ioMtx);
                        }
                        if (got == bytesPerVec) {
                            long off = (long)HEADER_SIZE + (long)(newId - 1) * (long)bytesPerVec;
                            if (newFile.WriteAt(off, (nint)scratchVec, bytesPerVec) != bytesPerVec) {
                                throw new IOException("failed to write vacuum vector row");
                            }
                            float[] copy = new float[dims];
                            NativeMemory.Copy((nint)copy, (nint)scratchVec, bytesPerVec);
                            newIndex.Add(newId, copy);
                            newId = newId + 1;
                        }
                    }
                }
                int writtenRows = newId - 1;
                if ((long)writtenRows != newTotal) {
                    ByteBuffer h2 = VectorTable.BuildVecHeader(dims, this.options.metric, (long)writtenRows, (long)writtenRows);
                    int hw2 = 0;
                    try {
                        hw2 = newFile.WriteAt(0, h2.Raw(), HEADER_SIZE);
                    } finally {
                        h2.Free();
                    }
                    if (hw2 != HEADER_SIZE) { throw new IOException("failed to update vacuum vector header"); }
                }
                if (!newFile.Sync()) { throw new IOException("failed to sync vacuum vector file"); }
            } catch (Exception ex) {
                newFile.Close();
                if (File.Exists(tmpVec)) { File.Delete(tmpVec); }
                throw ex;
            }
            newFile.Close();
            this.file.Close();

            bool backed = false;
            try {
                if (File.Exists(this.vecPath)) {
                    File.Move(this.vecPath, bakVec);
                    backed = true;
                }
                File.Move(tmpVec, this.vecPath);
                PageFile reopened = PageFile.Open(this.vecPath);
                if (reopened == null || !reopened.IsOpen()) {
                    throw new IOException("failed to reopen vacuumed VectorTable");
                }
                this.file = reopened;
                int finalRows = newId - 1;
                this.totalRows = finalRows;
                this.activeRows = finalRows;
                this.indexedRows = finalRows;
                this.tombstones.Clear();
                this.appendBuf.Clear();
                this.appendIds.Clear();
                this.index = newIndex;
                this.SaveHnswSnapshotLocked();
            } catch (Exception ex) {
                if (this.file != null && this.file.IsOpen()) { this.file.Close(); }
                if (backed && File.Exists(bakVec)) {
                    if (File.Exists(this.vecPath)) { File.Delete(this.vecPath); }
                    File.Move(bakVec, this.vecPath);
                }
                if (File.Exists(this.vecPath)) {
                    this.file = PageFile.Open(this.vecPath);
                }
                throw ex;
            }
            if (File.Exists(bakVec)) { File.Delete(bakVec); }
        } finally {
            this.tlock.ExitWrite();
        }
    }

    // 近邻向量搜索（双路并发融合架构）：
    // 1. 主路：检索已构建的不可变 HNSW 索引图（全精度或 SQ8 ADC 召回重打分），过滤墓碑；
    // 2. 旁路：扫描 appendBuf 增量追加队列（纳秒级内积计算，过滤墓碑）；
    // 3. 归并：线程局部工作栈 Top-K 堆融合，保证 100% Read-Your-Writes（立即可查零等待）。
    public List<VectorHit> Search(float[] query, int k, int efSearch = 64) {
        this.tlock.EnterRead();
        try {
            if (!this.IsOpen() || this.activeRows == 0 || k <= 0) { return new List<VectorHit>(); }
            if (query == null || query.Length != this.options.dimensions) {
                throw new ArgumentException("query vector dimension mismatch");
            }

            int dims = this.options.dimensions;
            int metric = this.options.metric;

            // 1. 主路：检索 HNSW 索引图
            List<VectorHit> recalled = null;
            if (this.index != null && this.index.Count() > 0) {
                if (!this.options.quantize) {
                    recalled = this.index.SearchFiltered(query, k, efSearch, (int id) => {
                        return !this.tombstones.ContainsKey(id);
                    });
                } else {
                    recalled = this.index.SearchRescoreFiltered(query, k, efSearch, (int id) => {
                        return !this.tombstones.ContainsKey(id);
                    }, (int id) => {
                        return this.GetLocked(id);
                    });
                }
            }

            // 2. 候选入堆（最大堆 VectorHeap，按距离升序保留最小的 k 个）
            VectorHeap best = new VectorHeap(k + 1, true);
            if (recalled != null) {
                for (int i = 0; i < recalled.Count; i = i + 1) {
                    best.Push(recalled[i].id, recalled[i].id, recalled[i].distance);
                    if (best.count > k) { best.Pop(); }
                }
            }

            // 3. 旁路：扫描 appendBuf 增量队列
            int appCount = this.appendBuf.Count;
            if (appCount > 0) {
                float[] scratch = new float[4];
                int simdLimit = dims - (dims % 4);
                double queryNormSq = 0.0;
                if (metric == 0) { // Cosine
                    Vector128 accQn = Vector128.Zero;
                    for (int d = 0; d < simdLimit; d = d + 4) {
                        Vector128 q = Vector128.Load(query, d);
                        accQn = Vector128.MultiplyAdd(q, q, accQn);
                    }
                    Vector128.Store(scratch, 0, accQn);
                    queryNormSq = (double)scratch[0] + (double)scratch[1] + (double)scratch[2] + (double)scratch[3];
                    for (int d = simdLimit; d < dims; d = d + 1) {
                        double qv = (double)query[d];
                        queryNormSq = queryNormSq + qv * qv;
                    }
                }

                for (int i = 0; i < appCount; i = i + 1) {
                    int id = this.appendIds[i];
                    if (this.tombstones.ContainsKey(id)) { continue; }
                    float[] v = this.appendBuf[i];

                    double dist = 0.0;
                    if (metric == 1) { // L2
                        Vector128 acc = Vector128.Zero;
                        for (int d = 0; d < simdLimit; d = d + 4) {
                            Vector128 q = Vector128.Load(query, d);
                            Vector128 vv = Vector128.Load(v, d);
                            Vector128 diff = Vector128.SubtractFloat(q, vv);
                            acc = Vector128.MultiplyAdd(diff, diff, acc);
                        }
                        Vector128.Store(scratch, 0, acc);
                        double sumSq = (double)scratch[0] + (double)scratch[1] + (double)scratch[2] + (double)scratch[3];
                        for (int d = simdLimit; d < dims; d = d + 1) {
                            double delta = (double)query[d] - (double)v[d];
                            sumSq = sumSq + delta * delta;
                        }
                        dist = sumSq;
                    } else { // Cosine
                        Vector128 accDot = Vector128.Zero;
                        Vector128 accVn = Vector128.Zero;
                        for (int d = 0; d < simdLimit; d = d + 4) {
                            Vector128 q = Vector128.Load(query, d);
                            Vector128 vv = Vector128.Load(v, d);
                            accDot = Vector128.MultiplyAdd(q, vv, accDot);
                            accVn = Vector128.MultiplyAdd(vv, vv, accVn);
                        }
                        Vector128.Store(scratch, 0, accDot);
                        double dot = (double)scratch[0] + (double)scratch[1] + (double)scratch[2] + (double)scratch[3];
                        Vector128.Store(scratch, 0, accVn);
                        double vNormSq = (double)scratch[0] + (double)scratch[1] + (double)scratch[2] + (double)scratch[3];
                        for (int d = simdLimit; d < dims; d = d + 1) {
                            double qv = (double)query[d];
                            double vv = (double)v[d];
                            dot = dot + qv * vv;
                            vNormSq = vNormSq + vv * vv;
                        }
                        if (queryNormSq > 0.0 && vNormSq > 0.0) {
                            dist = 1.0 - dot / (Math.Sqrt(queryNormSq) * Math.Sqrt(vNormSq));
                            if (dist < 0.0) { dist = 0.0; }
                            if (dist > 2.0) { dist = 2.0; }
                        } else {
                            dist = 1.0;
                        }
                    }

                    best.Push(id, id, dist);
                    if (best.count > k) { best.Pop(); }
                }
            }

            // 4. 堆元素出堆并反转（得到按距离升序排列的 Top-K 结果）
            List<VectorHit> hits = new List<VectorHit>();
            while (best.count > 0) {
                hits.Add(new VectorHit(best.ids[0], best.distances[0]));
                best.Pop();
            }
            hits.Reverse();
            return hits;
        } finally { this.tlock.ExitRead(); }
    }

    // 持久化刷盘：同步 .zvec 数据文件并固化 .zhnsw 快照
    public void Flush() {
        this.tlock.EnterWrite();
        try {
            this.FlushLocked();
        } finally { this.tlock.ExitWrite(); }
    }

    public void FlushLocked() {
        if (!this.IsOpen()) { return; }
        this.CatchUpIndexLocked();
        Mutex.Lock(this.ioMtx);
        try {
            this.file.Sync();
        } finally {
            Mutex.Unlock(this.ioMtx);
        }
        this.SaveHnswSnapshotLocked();
    }

    // 保存 .zhnsw 快照文件
    public void SaveHnswSnapshotLocked() {
        if (this.index == null) { return; }
        string tmpPath = this.hnswPath + ".tmp";
        if (File.Exists(tmpPath)) { File.Delete(tmpPath); }
        PageFile snapFile = PageFile.Open(tmpPath);
        if (!snapFile.IsOpen()) { return; }

        try {
            // 写入 32 字节头部
            ByteBuffer h = ByteBuffer.Alloc(HEADER_SIZE);
            try {
                h.WriteU8(90); h.WriteU8(72); h.WriteU8(78); h.WriteU8(83); // "ZHNS"
                h.WriteU32((long)VERSION);
                h.WriteU32((long)this.index.entry);
                h.WriteU32((long)this.index.maxLevel);
                h.WriteU32(this.index.randomState);
                h.WriteU64((long)this.index.nodes.Count);
                h.WriteU32((long)this.indexedRows); // 已索引高水位（含被跳过的尾部墓碑）
                if (snapFile.WriteAt(0, h.Raw(), HEADER_SIZE) != HEADER_SIZE) {
                    throw new IOException("failed to write hnsw header");
                }
            } finally {
                h.Free();
            }

            long fileOffset = (long)HEADER_SIZE;
            // 导出批次
            this.index.ExportBatches((string payload) => {
                int len = payload.Length;
                ByteBuffer b = ByteBuffer.Alloc(4 + len);
                try {
                    b.WriteU32((long)len);
                    b.WriteRaw(payload, len);
                    int blen = b.Length();
                    if (snapFile.WriteAt(fileOffset, b.Raw(), blen) != blen) {
                        throw new IOException("failed to write hnsw snapshot batch");
                    }
                    fileOffset = fileOffset + (long)blen;
                } finally {
                    b.Free();
                }
            }, 1048576, (int id) => {
                return this.GetLocked(id);
            });

            if (!snapFile.Sync()) {
                throw new IOException("failed to sync hnsw snapshot");
            }
            snapFile.Close();
            if (File.Exists(this.hnswPath)) { File.Delete(this.hnswPath); }
            File.Move(tmpPath, this.hnswPath);
        } catch (Exception _ex) {
            this.lastError = "hnsw snapshot write failed: " + _ex.Message;
            snapFile.Close();
            if (File.Exists(tmpPath)) { File.Delete(tmpPath); }
        }
    }

    // 加载 .zhnsw 快照
    public bool LoadHnswSnapshotLocked() {
        PageFile snapFile = PageFile.OpenExisting(this.hnswPath);
        if (!snapFile.IsOpen()) { return false; }
        try {
            ByteBuffer h = ByteBuffer.Alloc(HEADER_SIZE);
            string magic = "";
            int ver = 0;
            int entry = -1;
            int maxLevel = -1;
            int rng = 0;
            long count = 0L;
            long savedIndexedRows = 0L;
            bool hdrOk = false;
            try {
                if (snapFile.ReadAt(0, h, HEADER_SIZE) == HEADER_SIZE) {
                    h.SeekRead(0);
                    magic = h.Str(0, 4);
                    h.SeekRead(4);
                    ver = (int)h.ReadU32();
                    long entryRaw = h.ReadU32();
                    entry = entryRaw == 4294967295L ? -1 : (int)entryRaw;
                    long maxLevelRaw = h.ReadU32();
                    maxLevel = maxLevelRaw == 4294967295L ? -1 : (int)maxLevelRaw;
                    rng = (int)h.ReadU32();
                    count = h.ReadU64();
                    savedIndexedRows = h.ReadU32();
                    hdrOk = true;
                }
            } finally {
                h.Free();
            }

            if (!hdrOk || magic != MAGIC_HNSW || ver != VERSION) { return false; }
            if (count < 0L || count > 2147483646L) { return false; }

            long offset = (long)HEADER_SIZE;
            long fileSize = snapFile.Size();
            this.index = new VectorIndex(this.options);

            while (offset < fileSize) {
                if (fileSize - offset < 4L) { return false; }
                ByteBuffer lenBuf = ByteBuffer.Alloc(4);
                long batchLenL = 0L;
                bool lenOk = false;
                try {
                    if (snapFile.ReadAt(offset, lenBuf, 4) == 4) {
                        lenBuf.SeekRead(0);
                        batchLenL = lenBuf.ReadU32();
                        lenOk = true;
                    }
                } finally {
                    lenBuf.Free();
                }
                if (!lenOk) { return false; }
                offset = offset + 4L;

                long remaining = fileSize - offset;
                if (batchLenL <= 0L || batchLenL > remaining || batchLenL > 134217728L) { return false; }
                int batchLen = (int)batchLenL;

                ByteBuffer payloadBuf = ByteBuffer.Alloc(batchLen);
                string payload = "";
                bool payOk = false;
                try {
                    if (snapFile.ReadAt(offset, payloadBuf, batchLen) == batchLen) {
                        payload = payloadBuf.ToStr();
                        payOk = true;
                    }
                } finally {
                    payloadBuf.Free();
                }
                if (!payOk) { return false; }
                offset = offset + (long)batchLen;

                this.index.ImportBatch(payload);
            }
            this.index.ImportFinish(entry, maxLevel, rng, count);
            if (savedIndexedRows > 0L && savedIndexedRows <= 2147483647L) {
                this.indexedRows = (int)savedIndexedRows;
            }
            return true;
        } catch (Exception _ex) {
            // 向量索引快照损坏或截断异常：安全关闭句柄并返回加载失败
            return false;
        } finally {
            snapFile.Close();
        }
    }

    // 从 .zvec 重建纯内存索引（快照缺失或损坏时的自动自愈机制）
    public void RebuildIndexLocked() {
        this.index = new VectorIndex(this.options);
        for (int id = 1; id <= this.totalRows; id = id + 1) {
            if (!this.tombstones.ContainsKey(id)) {
                float[] v = this.GetLocked(id);
                if (v != null) {
                    this.index.Add(id, v);
                }
            }
        }
        this.indexedRows = this.totalRows;
        this.appendBuf.Clear();
        this.appendIds.Clear();
        this.activeRows = this.totalRows - this.tombstones.Count;
        this.WriteHeaderLocked((long)this.totalRows, (long)this.activeRows);
    }

    public void Close() {
        if (this.tlock != null) {
            this.tlock.EnterWrite();
            try {
                if (this.file != null && this.file.IsOpen()) {
                    if (this.index != null) { this.FlushLocked(); }
                    this.file.Close();
                }
            } finally {
                this.tlock.ExitWrite();
                this.tlock.Close();
                this.tlock = null;
            }
        } else if (this.file != null && this.file.IsOpen()) {
            this.file.Close();
        }
        if (this.ioMtx != 0) {
            Mutex.Destroy(this.ioMtx);
            this.ioMtx = 0;
        }
    }

    public void Dispose() {
        this.Close();
    }
}
