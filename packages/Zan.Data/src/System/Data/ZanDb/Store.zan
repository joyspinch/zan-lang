using System;
using System.IO;
using System.Threading;

namespace System.Data.ZanDb;

delegate string StoreUpdater(string current);

/// <summary>扫描回调：按 键序升序 收到每个存活键的最新值；
/// 返回 false 早停。</summary>
delegate bool StoreVisit(string key, string val);

/// <summary>裸扫描回调：收到零拷贝扫描行（值按块内偏移/长度/指针
/// 暴露，Key()/Val() 才物化字符串）；返回 false 早停。</summary>
delegate bool ScanRowVisit(ScanRow row);

/// <summary>
/// 扫描行视图：<see cref="ZanStore.ScanRows"/> 回调参数。值默认
/// 零拷贝——按块内偏移/长度/指针暴露，调用 Key()/Val() 才物化
/// 字符串（同一行内缓存，推进到下一行自动失效）。多源归并退化
/// 路径（memtable 有未固化数据）时 <see cref="Block"/> 为 null，
/// 键值直接以字符串给出。行数据仅在回调返回前有效。
/// </summary>
class ScanRow {
    SegCursor cur;
    string memKey;
    string memVal;

    /// 绑定到段游标当前记录（零拷贝模式）。
    void Bind(SegCursor c) {
        this.cur = c;
        this.memKey = "";
        this.memVal = "";
    }

    /// 绑定到一对字符串（多源归并退化模式）。
    void BindMem(string k, string v) {
        this.cur = null;
        this.memKey = k;
        this.memVal = v;
    }

    /// 当前行的键（惰性物化，行内缓存；退化模式直接给字符串）。
    string Key() { return this.cur != null ? this.cur.Key() : this.memKey; }

    /// 当前行的值字符串（惰性物化，行内缓存）。
    string Val() { return this.cur != null ? this.cur.Val() : this.memVal; }

    /// 值所在块缓冲；退化模式下为 null，调用方须走字符串路径。
    ByteBuffer Block() { return this.cur != null ? this.cur.Block() : null; }

    /// 值在块内的起始偏移（退化模式无意义）。
    int ValOff() { return this.cur != null ? this.cur.ValOff() : 0; }

    /// 值的字节长度。
    int ValLen() { return this.cur != null ? this.cur.ValLen() : 0; }

    /// 值字节的裸指针（等于 Block().Raw() + ValOff()）。
    nint ValPtr() {
        if (this.cur == null) { return 0; }
        ByteBuffer b = this.cur.Block();
        if (b == null) { return 0; }
        return b.Raw() + this.cur.ValOff();
    }
}

/// <summary>
/// 聚合内核回调：块级扫描按记录粒度交付（op=1 的存活 put），
/// 键/值以（缓冲裸指针 + 偏移 + 长度）零拷贝给出——同一缓冲跨
/// 块复用、回调期间有效。返回 false 早停整个扫描。
/// </summary>
delegate bool KernelVisit(nint basePtr, int keyOff, int keyLen, int valOff, int valLen);

/// <summary>覆盖索引内核回调：索引条目键以（缓冲裸指针 + 偏移 +
/// 长度）零拷贝交付，id 段固定在键尾 6 字节；缓冲跨跨度复用、
/// 回调期间有效。返回 false 早停。</summary>
delegate bool KernelKeyVisit(nint basePtr, int keyOff, int keyLen);

/// 段句柄：段文件与其全局段号的配对。
class SegRef {
    SegmentFile seg;
    long id;

    SegRef(SegmentFile seg, long id) {
        this.seg = seg;
        this.id = id;
    }
}

/// <summary>
/// 日志式键值存储：memtable + 不可变有序段 + 追加日志 + 双槽清单。
///
/// 写路径：追加 CRC 帧日志（组提交）+ 更新 memtable；日志攒到
/// 阈值（默认 64MB，可调）把 memtable 排序固化为新段、保存
/// manifest、截断日志。读路径：memtable → 内存索引（键 → 段号）
/// → 目标段的块（有界块缓存，O(1) 点读）。恢复：逐段顺序扫描
/// 重建索引（Bitcask 式，纯顺序读）+ 重放日志中 seq ≥ 水位的
/// 尾部——「manifest 已存、日志未截断」的崩溃窗口由水位跳过。
///
/// 内存有界：memtable ≤ 阈值，块缓存有硬上限；常驻索引每键
/// 只有哈希项 + 4 字节段号。
///
/// 记录帧、持久化三档、NUL-free 契约、单进程单写多读模型
/// 与异步 API 的说明见各类注释（LogFile / Segment / Manifest）。
/// </summary>
class ZanStore {
    /// 每次提交都 fsync。
    static int DUR_SYNC = 0;
    /// 分组提交：按次数/字节数窗口 fsync。
    static int DUR_GROUP = 1;
    /// 只在 Checkpoint/Close 与缓冲攒满时落盘。
    static int DUR_NONE = 2;

    /// GROUP 档攒满这么多字节提前 fsync。
    static int GROUP_FLUSH_BYTES = 524288;
    /// NONE 档攒满这么多字节强制 flush 进 OS 缓存。
    static int NONE_FLUSH_BYTES = 1048576;
    /// 默认 memtable/日志 flush 阈值（字节）。
    static long DEFAULT_FLUSH_THRESHOLD = 67108864;
    /// 默认块缓存上限（字节）。
    static long DEFAULT_CACHE_CAP = 33554432;
    /// 块级内核的读跨度（字节）：一次 ReadAt 摊掉这么多的逐块
    /// 系统调用——扫描/聚合路径的 IO 下限由它决定。
    static int KERNEL_SPAN_BYTES = 262144;

    LogFile log;
    Dictionary<string, string> memtable;
    Dictionary<string, long> index;
    List<SegRef> segs;
    Manifest man;
    string basePath;
    BlockCache cache;
    AsyncRwLock rw;
    int durability;
    int syncEvery;
    int commitsSinceSync;
    long bytesSinceSync;
    long seq;
    long cacheEpoch;
    long lockHandle;
    bool closed;
    long logStartSeq;
    long nextSegId;
    long flushThreshold;
    long recoverSeg;
    int txDepth;
    static int BATCH_VERSION = 1;
    static int BATCH_HEADER_LEN = 17;
    Dictionary<string, string> txPut;
    Dictionary<string, string> txDel;
    /// <summary>未固化墓碑：删掉的键在旧段里仍有旧版本，固化时
    /// 必须把 op=2 记录写进新段压住它们，否则恢复扫描会让已删
    /// 键复活（旧段版本重指索引）。</summary>
    Dictionary<string, long> tombstones;
    /// <summary>自动增量归并阈值：固化后段数 ≥ autoMergeAt 时就地
    /// 归并 autoMergeK 个最老段。0 = 关闭（默认）——归并代价显式
    /// 交还调用方，自动策略只应被明确开启。</summary>
    int autoMergeAt;
    int autoMergeK;
    string lastError;

    ZanStore() {
        this.memtable = new Dictionary<string, string>();
        this.index = new Dictionary<string, long>();
        this.segs = new List<SegRef>();
        this.txPut = new Dictionary<string, string>();
        this.txDel = new Dictionary<string, string>();
        this.tombstones = new Dictionary<string, long>();
        this.cache = new BlockCache(ZanStore.DEFAULT_CACHE_CAP);
        this.rw = new AsyncRwLock();
        this.durability = ZanStore.DUR_GROUP;
        this.syncEvery = 32;
        this.commitsSinceSync = 0;
        this.bytesSinceSync = 0;
        this.seq = 0;
        this.cacheEpoch = 0;
        this.lockHandle = 0;
        this.closed = false;
        this.logStartSeq = 0;
        this.nextSegId = 0;
        this.flushThreshold = ZanStore.DEFAULT_FLUSH_THRESHOLD;
        this.recoverSeg = 0;
        this.txDepth = 0;
        this.autoMergeAt = 0;
        this.autoMergeK = 0;
        this.basePath = "";
        this.lastError = "";
    }

    static string SegPath(string basePath, long id) {
        return basePath + ".s" + Convert.ToString(id);
    }

    /// <summary>打开（必要时创建）分组提交档的存储。</summary>
    static ZanStore Open(string path) {
        return ZanStore.Open(path, ZanStore.DUR_GROUP);
    }

    /// <summary>先取得持久 .lock 文件的系统锁，再打开 WAL/清单/段。
    /// Path.Normalize 只统一分隔符；调用者必须使用同一规范路径，不能
    /// 用符号链接、硬链接或不同目录别名指向同一 WAL。锁文件不删除。</summary>
    static ZanStore Open(string path, int durability) {
        ZanStore s = new ZanStore();
        s.durability = durability;
        s.basePath = Path.Normalize(path);
        if (s.basePath == "") { s.Fail("store path is empty"); return s; }
        s.lockHandle = File.TryLock(s.basePath + ".lock");
        if (s.lockHandle == 0) {
            s.Fail("store is locked or its lock file cannot be opened");
            return s;
        }
        try {
            s.log = LogFile.Open(s.basePath);
            if (!s.log.IsOpen()) { s.Fail(s.log.GetError()); return s; }
            // WAL 锁保留为兼容守卫：旧版写入者尚不认识稳定 .lock。
            if (!s.log.TryLockExclusive()) {
                s.Fail("store is locked by another writer");
                return s;
            }
            s.man = Manifest.Load(s.basePath);
            if (s.man.GetError() != "") { s.Fail(s.man.GetError()); return s; }
            if (s.man.Exists()) {
                s.logStartSeq = s.man.LogStartSeq();
                s.seq = s.logStartSeq;
                s.nextSegId = s.man.NextSegId();
                List<long> ids = s.man.SegIds();
                for (int i = 0; i < ids.Count; i = i + 1) {
                    SegmentFile sf = SegmentFile.Open(ZanStore.SegPath(s.basePath, ids[i]));
                    s.segs.Add(new SegRef(sf, ids[i]));
                    if (sf.GetError() != "") {
                        s.Fail("segment " + Convert.ToString(ids[i]) + ": " + sf.GetError());
                        return s;
                    }
                    s.recoverSeg = ids[i];
                    int scanned = sf.Scan("", s.RecoverRecord);
                    if (sf.GetError() != "" || (long)scanned != sf.Count()) {
                        s.Fail("segment recovery failed: " + sf.GetError());
                        return s;
                    }
                }
            }
            if (s.log.Replay(s.ApplyFrame) < 0 || s.lastError != "") {
                s.Fail(s.lastError != "" ? s.lastError : s.log.GetError());
                return s;
            }
            s.cacheEpoch = s.seq;
        } catch (Exception ex) {
            // Open 的错误值契约：保留诊断并释放本句柄的全部资源。
            s.Fail("store recovery failed: " + ex.Message);
        }
        return s;
    }

    /// 恢复扫描回调：段内记录重指索引（段按号升序扫描，
    /// 后段覆盖前段；墓碑摘除索引，为合并输出预留）。
    bool RecoverRecord(string key, string val, int op) {
        if (op == 2) {
            if (this.index.ContainsKey(key)) { this.index.Remove(key); }
            return true;
        }
        if (this.index.ContainsKey(key)) { this.index.Remove(key); }
        this.index.Add(key, this.recoverSeg);
        return true;
    }

    /// 不物化字符串地验证完整长度，避免 ReadString 的 long→int
    /// 转换吞掉恶意高位；合法帧的长度前缀最多需要 5 个字节。
    static bool SkipWalString(ByteBuffer b) {
        int at = b.ReadPos();
        int next = at;
        long n = b.ReadVarIntAt(at, out next);
        if (n < 0 || next <= at || next - at > 5 || n > b.Length() - next) { return false; }
        b.SeekRead(next + (int)n);
        return true;
    }

    /// 校验全部记录后才允许应用，CRC 有效并不等于载荷有效。
    static bool ValidFrame(ByteBuffer b) {
        b.SeekRead(0);
        if (!b.CanRead(9)) { return false; }
        long fseq = b.ReadU64();
        if (fseq < 0 || fseq == 9223372036854775807) { return false; }
        int op = b.ReadU8();
        long count = 1;
        bool batch = op == 3;
        if (batch) {
            if (!b.CanRead(8) || b.ReadU32() != ZanStore.BATCH_VERSION) { return false; }
            count = b.ReadU32();
            if (count == 0 || count > b.Remaining() / 2) { return false; }
        } else if (op != 1 && op != 2) { return false; }
        for (long i = 0; i < count; i = i + 1) {
            if (batch) {
                if (!b.CanRead(1)) { return false; }
                op = b.ReadU8();
            }
            if (op != 1 && op != 2) { return false; }
            if (!ZanStore.SkipWalString(b)) { return false; }
            if (op == 1 && !ZanStore.SkipWalString(b)) { return false; }
        }
        return b.Remaining() == 0;
    }

    /// 新格式：seq:u64, op=3:u8, version:u32, count:u32，随后每条
    /// op:u8 + WriteString(key)，put 再跟 WriteString(val)。旧 op1/2 兼容。
    bool ApplyFrame(ByteBuffer b) {
        if (!ZanStore.ValidFrame(b)) {
            this.lastError = "invalid WAL record or batch";
            return false;
        }
        b.SeekRead(0);
        long fseq = b.ReadU64();
        if (fseq < this.logStartSeq) { return true; }
        if (fseq < this.seq) { this.lastError = "WAL sequence went backwards"; return false; }
        int op = b.ReadU8();
        long count = 1;
        bool batch = op == 3;
        if (batch) { b.ReadU32(); count = b.ReadU32(); }
        for (long i = 0; i < count; i = i + 1) {
            if (batch) { op = b.ReadU8(); }
            string key = b.ReadString();
            string val = op == 1 ? b.ReadString() : "";
            this.ApplyRecord(op, key, val);
        }
        this.seq = fseq + 1;
        return true;
    }

    void ApplyRecord(int op, string key, string val) {
        if (op == 1) {
            this.memtable.Remove(key);
            this.tombstones.Remove(key);
            this.memtable.Add(key, val);
        } else {
            this.memtable.Remove(key);
            this.index.Remove(key);
            if (!this.tombstones.ContainsKey(key)) { this.tombstones.Add(key, 0); }
        }
    }

    bool IsOpen() {
        return !this.closed && this.lastError == "" && this.log != null && this.log.IsOpen();
    }

    /// 打开/读写/维护失败的诊断；失败句柄不再接收写入。
    string GetError() { return this.lastError; }

    /// 已提交版本：每个非空外层批次只推进一次，回滚不推进。
    long Version() { return this.seq; }
    long GetRevision() { return this.seq; }
    bool InTransaction() { return this.txDepth > 0; }
    /// 缓存失效代数：外层提交及回滚后改变；事务中读缓存应禁用。
    long CacheVersion() { return this.cacheEpoch; }

    /// 键值对总数：索引（已落段）+ memtable 中尚未落段的新键。
    int Count() {
        if (!this.IsOpen()) { return 0; }
        int n = this.index.Count;
        List<string> mk = this.memtable.Keys;
        for (int i = 0; i < mk.Count; i = i + 1) {
            if (!this.index.ContainsKey(mk[i])) { n = n + 1; }
        }
        return n;
    }

    /// 已固化段的数量。
    int SegCount() { return this.segs.Count; }

    /// 日志逻辑大小（字节）：0 表示全部数据已在段里。
    long LogBytes() { return this.log != null ? this.log.Size() : -1; }

    /// 切换持久化档（立即生效）。
    void SetDurability(int d) { this.durability = d; }

    /// <summary>GROUP 档的 fsync 窗口：N = 每 N 次提交至多
    /// 一次 fsync（攒满 <see cref="GROUP_FLUSH_BYTES"/> 字节会提前）。</summary>
    void SetSyncEvery(int n) {
        if (n >= 1) { this.syncEvery = n; }
    }

    /// <summary>memtable/日志 flush 阈值（字节）：日志攒到该值
    /// 即固化新段。默认 64MB；调小是合法配置（=1 即每次提交
    /// 都固化），只拒绝非正数。</summary>
    void SetFlushThreshold(long bytes) {
        if (bytes >= 1) { this.flushThreshold = bytes; }
    }

    /// <summary>块缓存字节上限。默认 32MB；调小是合法配置
    /// （缓存退化到直读），只拒绝非正数。</summary>
    void SetCacheCap(long bytes) {
        if (bytes >= 1) { this.cache.SetCap(bytes); }
    }

    /// <summary>开启自动增量归并：每次固化新段后若段数达到
    /// <paramref name="atSegs"/>，就地归并最老的
    /// <paramref name="mergeK"/> 个段（同
    /// <see cref="MergeSomeSegments"/>，有界停顿=写 k 段的耗时）。
    /// atSegs ≥ max(3, mergeK+1) 才生效——阈值太低会每次固化都
    /// 归并、得不偿失；atSegs = 0 关闭（默认）。段数稳态在
    /// [atSegs-mergeK+1, atSegs] 间振荡，不再无界增长。</summary>
    void SetAutoMerge(int atSegs, int mergeK) {
        if (atSegs <= 0) { this.autoMergeAt = 0; this.autoMergeK = 0; return; }
        if (mergeK < 2) { return; }
        if (atSegs < mergeK + 1) { return; }
        this.autoMergeAt = atSegs;
        this.autoMergeK = mergeK;
    }

    // ===== 同步核心（单所有者，无锁） =====

    /// <summary>返回值；不存在时返回 ""（与「值为空串」不可区分，
    /// 需要区分时用 <see cref="Contains"/>）。事务内可见未提交的
    /// 本事务写入。</summary>
    string Get(string key) {
        if (!this.IsOpen()) { return ""; }
        if (this.txDepth > 0) {
            if (this.txDel.ContainsKey(key)) { return ""; }
            string tv = "";
            if (this.txPut.TryGetValue(key, out tv)) { return tv; }
        }
        string mv = "";
        if (this.memtable.TryGetValue(key, out mv)) { return mv; }
        long segId = 0;
        if (this.index.TryGetValue(key, out segId)) {
            SegRef r = this.FindSeg(segId);
            if (r != null) {
                string sv = "";
                int hit = r.seg.Lookup(key, out sv, this.cache, segId);
                if (r.seg.GetError() != "") { this.Fail(r.seg.GetError()); return ""; }
                if (hit == 1) { return sv; }
            }
        }
        return "";
    }

    /// 键是否存在。
    bool Contains(string key) {
        if (!this.IsOpen()) { return false; }
        if (this.txDepth > 0) {
            if (this.txDel.ContainsKey(key)) { return false; }
            if (this.txPut.ContainsKey(key)) { return true; }
        }
        if (this.memtable.ContainsKey(key)) { return true; }
        return this.index.ContainsKey(key);
    }

    /// <summary>事务内只暂存最终值；自动提交走同一批次路径。
    /// 失败抛 IOException，并通过 GetError 留下诊断。</summary>
    void Put(string key, string val) {
        if (!this.WriteReady()) { throw new IOException(this.GetError()); }
        bool automatic = this.txDepth == 0;
        if (automatic) { this.Begin(); }
        this.txDel.Remove(key);
        this.txPut.Remove(key);
        this.txPut.Add(key, val);
        if (automatic && !this.Commit()) { throw new IOException(this.GetError()); }
    }

    /// 删除存在的键；事务内 true 表示暂存，自动提交失败返回 false。
    bool Delete(string key) {
        if (!this.WriteReady() || !this.Contains(key)) { return false; }
        bool automatic = this.txDepth == 0;
        if (automatic) { this.Begin(); }
        this.txPut.Remove(key);
        this.txDel.Remove(key);
        this.txDel.Add(key, "");
        return !automatic || this.Commit();
    }

    /// 写入仅进入覆盖层；嵌套批次由最外层一次性提交。
    void Begin() {
        if (!this.WriteReady()) { throw new IOException(this.GetError()); }
        this.txDepth = this.txDepth + 1;
    }

    /// <summary>最外层非空批次写一个 CRC 帧，按持久化档落盘成功后
    /// 才发布 memtable 和版本。嵌套 true 仅表示仍在暂存；空批次不推进。
    /// I/O 失败返回 false 并关闭写入。若自动固化在 WAL 提交后失败，
    /// false 的结果可能已提交，调用者应重开并检查修订号。</summary>
    bool Commit() {
        if (!this.WriteReady()) { return false; }
        if (this.txDepth == 0) { return true; }
        this.txDepth = this.txDepth - 1;
        if (this.txDepth > 0) { return true; }
        if (this.txPut.Count == 0 && this.txDel.Count == 0) { return true; }
        if (this.seq == 9223372036854775807) { this.Fail("store revision exhausted"); return false; }
        ByteBuffer b = null;
        try {
            b = this.BuildTxFrame();
            if (b == null) { return false; }
            int bytes = b.Length() + LogFile.HEADER_LEN;
            if (!this.log.AppendFrame(b) || !this.PersistCommit(bytes)) {
                this.Fail(this.log.GetError());
                return false;
            }
            this.MergeTxOverlay();
            this.seq = this.seq + 1;
            this.cacheEpoch = this.cacheEpoch + 1;
            long logBytes = this.log.Size();
            if (logBytes < 0) { this.Fail(this.log.GetError()); return false; }
            if (logBytes >= this.flushThreshold) { this.FlushToSegment(); }
            return this.IsOpen();
        } catch (Exception ex) {
            // bool 提交契约：丢弃覆盖层、关闭失败句柄，保留真实诊断。
            this.Fail("store commit failed: " + ex.Message);
            return false;
        } finally {
            if (b != null) { b.Free(); }
        }
    }

    static int VarIntBytes(long n) {
        int bytes = 1;
        while (n >= 128) { n = n >> 7; bytes = bytes + 1; }
        return bytes;
    }

    /// 在分配/追加之前计算精确大小，不让多键批次绕过帧上限。
    ByteBuffer BuildTxFrame() {
        List<string> dk = this.txDel.Keys;
        List<string> pk = this.txPut.Keys;
        long size = ZanStore.BATCH_HEADER_LEN;
        for (int i = 0; i < dk.Count; i = i + 1) {
            size = size + 1 + ZanStore.VarIntBytes(dk[i].Length) + dk[i].Length;
            if (size > LogFile.MAX_FRAME) { this.Fail("WAL batch exceeds maximum payload"); return null; }
        }
        for (int i = 0; i < pk.Count; i = i + 1) {
            string v = "";
            this.txPut.TryGetValue(pk[i], out v);
            size = size + 1 + ZanStore.VarIntBytes(pk[i].Length) + pk[i].Length
                + ZanStore.VarIntBytes(v.Length) + v.Length;
            if (size > LogFile.MAX_FRAME) { this.Fail("WAL batch exceeds maximum payload"); return null; }
        }
        ByteBuffer b = ByteBuffer.Alloc((int)size);
        b.WriteU64(this.seq);
        b.WriteU8(3);
        b.WriteU32(ZanStore.BATCH_VERSION);
        b.WriteU32((long)dk.Count + pk.Count);
        for (int i = 0; i < dk.Count; i = i + 1) {
            b.WriteU8(2);
            b.WriteString(dk[i]);
        }
        for (int i = 0; i < pk.Count; i = i + 1) {
            string v = "";
            this.txPut.TryGetValue(pk[i], out v);
            b.WriteU8(1);
            b.WriteString(pk[i]);
            b.WriteString(v);
        }
        return b;
    }

    /// 回滚覆盖层；缓冲中从未写入本事务，既有已提交待写帧不受影响。
    void Rollback() {
        if (this.txDepth == 0) { return; }
        this.txDepth = 0;
        this.txPut.Clear();
        this.txDel.Clear();
        this.cacheEpoch = this.cacheEpoch + 1;
    }

    void MergeTxOverlay() {
        List<string> dk = this.txDel.Keys;
        for (int i = 0; i < dk.Count; i = i + 1) { this.ApplyRecord(2, dk[i], ""); }
        List<string> pk = this.txPut.Keys;
        for (int i = 0; i < pk.Count; i = i + 1) {
            string v = "";
            this.txPut.TryGetValue(pk[i], out v);
            this.ApplyRecord(1, pk[i], v);
        }
        this.txDel.Clear();
        this.txPut.Clear();
    }

    /// 成功完成选定的持久化动作后才能发布覆盖层。GROUP 字节窗口
    /// 记录已 flush 但未 sync 的量，不能在 Flush 清零后看 PendingBytes。
    bool PersistCommit(int bytes) {
        if (this.durability == ZanStore.DUR_SYNC) {
            if (!this.log.Sync()) { return false; }
            this.commitsSinceSync = 0;
            this.bytesSinceSync = 0;
        } else if (this.durability == ZanStore.DUR_GROUP) {
            if (!this.log.Flush()) { return false; }
            this.commitsSinceSync = this.commitsSinceSync + 1;
            this.bytesSinceSync = this.bytesSinceSync + bytes;
            if (this.commitsSinceSync >= this.syncEvery || this.bytesSinceSync >= ZanStore.GROUP_FLUSH_BYTES) {
                if (!this.log.Sync()) { return false; }
                this.commitsSinceSync = 0;
                this.bytesSinceSync = 0;
            }
        } else if (this.log.PendingBytes() >= ZanStore.NONE_FLUSH_BYTES) {
            if (!this.log.Flush()) { return false; }
        }
        return true;
    }

    /// <summary>把 memtable 固化为新段：put 与未固化墓碑按键序
    /// 合并写段 → fsync → 保存 manifest（水位 = 当前 seq）→ 截断
    /// 日志。墓碑必须随段持久化：被删键在旧段里仍有旧版本，没有
    /// 新段墓碑压住，恢复扫描就会把它复活。任一步失败都保持日志
    /// 兜底（旧 manifest + 完整日志 = 完好状态）；成功后日志归零。
    /// 须在写侧串行环境调用（同步核心即满足；协程请走
    /// <see cref="FlushAsync"/>）。</summary>
    void FlushToSegment() {
        if (!this.WriteReady() || this.txDepth > 0) { return; }
        long logBytes = this.log.Size();
        if (logBytes < 0) { this.Fail(this.log.GetError()); return; }
        if (this.memtable.Count == 0 && this.tombstones.Count == 0 && logBytes == 0) { return; }
        // 维护失败也不得丢失此前 NONE 档的已提交待写帧。
        if (!this.log.Sync()) { this.Fail(this.log.GetError()); return; }
        if (this.memtable.Count == 0 && this.tombstones.Count == 0) {
            List<long> ids = this.SegIdList();
            if (!this.PublishBoth(this.seq, this.nextSegId, ids)) { return; }
            if (!this.log.Reset()) { this.Fail(this.log.GetError()); return; }
            this.logStartSeq = this.seq;
            this.commitsSinceSync = 0;
            this.bytesSinceSync = 0;
            return;
        }
        long segId = this.nextSegId;
        if (segId == 9223372036854775807) { this.Fail("store segment id exhausted"); return; }
        string segPath = ZanStore.SegPath(this.basePath, segId);
        File.Delete(segPath);
        List<string> keys = new List<string>();
        List<string> src = this.memtable.Keys;
        for (int i = 0; i < src.Count; i = i + 1) { keys.Add(src[i]); }
        List<string> tks = this.tombstones.Keys;
        for (int i = 0; i < tks.Count; i = i + 1) { keys.Add(tks[i]); }
        ZanStore.SortStrings(keys);
        SegmentWriter wtr = null;
        SegmentFile seg = null;
        bool published = false;
        bool adopted = false;
        try {
            wtr = SegmentWriter.Create(segPath);
            if (wtr.Failed()) { this.Fail(wtr.GetError()); return; }
            for (int i = 0; i < keys.Count; i = i + 1) {
                if (this.tombstones.ContainsKey(keys[i])) { wtr.Add(keys[i], "", 2); }
                else {
                    string v = "";
                    this.memtable.TryGetValue(keys[i], out v);
                    wtr.Add(keys[i], v, 1);
                }
            }
            if (!wtr.Finish()) { this.Fail(wtr.GetError()); return; }
            seg = SegmentFile.Open(segPath);
            if (seg.GetError() != "") { this.Fail(seg.GetError()); return; }
            List<long> ids = this.SegIdList();
            ids.Add(segId);
            // 第一槽成功后新段已可能被引用，之后失败必须保留新段。
            published = true;
            if (!this.PublishBoth(this.seq, segId + 1, ids)) { return; }
            // 两个 fallback 槽都覆盖日志后才能截断，否则旧槽会缺恢复尾。
            if (!this.log.Reset()) { this.Fail(this.log.GetError()); return; }
            for (int i = 0; i < keys.Count; i = i + 1) {
                this.index.Remove(keys[i]);
                if (!this.tombstones.ContainsKey(keys[i])) { this.index.Add(keys[i], segId); }
            }
            this.memtable.Clear();
            this.tombstones.Clear();
            this.segs.Add(new SegRef(seg, segId));
            adopted = true;
            this.nextSegId = segId + 1;
            this.logStartSeq = this.seq;
            this.commitsSinceSync = 0;
            this.bytesSinceSync = 0;
            if (this.autoMergeAt > 0 && this.segs.Count >= this.autoMergeAt) {
                this.MergeSomeSegments(this.autoMergeK);
            }
        } catch (Exception ex) {
            // 维护的错误值契约：旧清单与 WAL 或新清单均可恢复。
            this.Fail("store flush failed: " + ex.Message);
        } finally {
            ZanStore.CloseWriter(wtr);
            if (seg != null && !adopted) { seg.Close(); }
            if (!published) { File.Delete(segPath); }
        }
    }

    /// 覆盖两个 fallback 槽后，旧段/日志才能退休。第二次失败时
    /// 第一份已发布，不可删除它引用的新段，也不可截断/删除旧介质。
    bool PublishBoth(long logSeq, long nextId, List<long> ids) {
        if (!this.man.Save(logSeq, nextId, ids) || !this.man.Save(logSeq, nextId, ids)) {
            this.Fail(this.man.GetError());
            return false;
        }
        return true;
    }

    static void CloseWriter(SegmentWriter wtr) {
        if (wtr == null) { return; }
        if (wtr.file != null) { wtr.file.Close(); }
        if (wtr.buf != null) { wtr.buf.Free(); wtr.buf = null; }
    }

    /// <summary>把全部已固化段（≥2 个）归并为一个新段：同键只留
    /// 最新版本，墓碑直接掉落（归并集=全部段，不存在会复活的更老
    /// 版本），索引按归并结果重建。须在写侧串行环境调用且不在事务
    /// 中（协程请走 <see cref="MergeAsync"/>）；期间阻塞写入——
    /// 在线换段优化留待后续。崩溃窗口两段皆一致：段已写清单未换
    /// = 孤儿段，下次同号归并覆盖之；清单已换 = 旧段成孤儿（不再
    /// 被引用，仅占盘）。内存峰值 ≈ 存活键数（重建索引用）。</summary>
    void MergeSegments() {
        this.MergeSomeSegments(this.segs.Count);
    }

    /// <summary>独占锁下的 <see cref="MergeSegments"/>。</summary>
    async void MergeAsync() {
        await this.rw.EnterWrite();
        MergeSegments();
        this.rw.ExitWrite();
    }

    /// 线性查小列表（归并集段号，k 很小）。
    static bool IdInList(List<long> ids, long id) {
        for (int i = 0; i < ids.Count; i = i + 1) {
            if (ids[i] == id) { return true; }
        }
        return false;
    }

    /// <summary><see cref="MergeSegments"/> 的增量形式：把最老的
    /// maxMerge（≥2）个段归并为一个新段，其余较新段原样保留——
    /// 写阻塞时长被归并集规模封顶，反复调用最终收敛为单段。索引
    /// 原地改指：只有键索引仍指向归并集的键才重指/摘除；指向未
    /// 归并新段的键保持原指（更新版本继续赢），且这样的键**不写
    /// 入新段**——重开恢复按清单序「后扫覆盖前扫」时才不会让旧
    /// 版本压住未归并段的新版本。归并集内同键由游标新→旧序去重，
    /// 未固化墓碑压键与崩溃窗口语义同全量归并。返回实际归并的
    /// 段数（0 = 无事可做：段不足 2 或在事务中）。</summary>
    int MergeSomeSegments(int maxMerge) {
        if (!this.WriteReady() || maxMerge < 2 || this.segs.Count < 2 || this.txDepth > 0) { return 0; }
        if (!this.log.Sync()) { this.Fail(this.log.GetError()); return 0; }
        int k = maxMerge < this.segs.Count ? maxMerge : this.segs.Count;
        long newId = this.nextSegId;
        if (newId == 9223372036854775807) { this.Fail("store segment id exhausted"); return 0; }
        string segPath = ZanStore.SegPath(this.basePath, newId);
        File.Delete(segPath);
        List<long> chosenIds = new List<long>();
        for (int i = 0; i < k; i = i + 1) { chosenIds.Add(this.segs[i].id); }
        // 完全独立地构建索引：写段、读段、清单保存失败时在线索引不变。
        Dictionary<string, long> mergedIndex = new Dictionary<string, long>();
        List<string> liveKeys = this.index.Keys;
        for (int i = 0; i < liveKeys.Count; i = i + 1) {
            long id = 0;
            this.index.TryGetValue(liveKeys[i], out id);
            if (!ZanStore.IdInList(chosenIds, id)) { mergedIndex.Add(liveKeys[i], id); }
        }
        SegmentWriter wtr = null;
        SegmentFile seg = null;
        List<SegCursor> cursors = new List<SegCursor>();
        bool published = false;
        bool adopted = false;
        try {
            wtr = SegmentWriter.Create(segPath);
            if (wtr.Failed()) { this.Fail(wtr.GetError()); return 0; }
            for (int i = k - 1; i >= 0; i = i - 1) {
                cursors.Add(SegCursor.Open(this.segs[i].seg, ""));
            }
            while (true) {
                string minKey = "";
                bool has = false;
                for (int i = 0; i < cursors.Count; i = i + 1) {
                    SegCursor c = cursors[i];
                    if (!c.Valid()) { continue; }
                    if (!has || String.CompareOrdinal(c.Key(), minKey) < 0) {
                        minKey = c.Key();
                        has = true;
                    }
                }
                if (!has) { break; }
                bool decided = false;
                for (int i = 0; i < cursors.Count; i = i + 1) {
                    SegCursor c = cursors[i];
                    if (!c.Valid() || c.Key() != minKey) { continue; }
                    if (!decided) {
                        decided = true;
                        long curSeg = 0;
                        bool mine = this.index.TryGetValue(minKey, out curSeg)
                            && ZanStore.IdInList(chosenIds, curSeg);
                        if (c.Op() == 1 && mine && !this.tombstones.ContainsKey(minKey)) {
                            wtr.Add(minKey, c.Val(), 1);
                            mergedIndex.Add(minKey, newId);
                        }
                    }
                    c.Next();
                }
                if (wtr.Failed()) { this.Fail(wtr.GetError()); return 0; }
            }
            for (int i = 0; i < k; i = i + 1) {
                if (this.segs[i].seg.GetError() != "") {
                    this.Fail(this.segs[i].seg.GetError());
                    return 0;
                }
            }
            if (!wtr.Finish()) { this.Fail(wtr.GetError()); return 0; }
            seg = SegmentFile.Open(segPath);
            if (seg.GetError() != "") { this.Fail(seg.GetError()); return 0; }
            // 新段载最老数据，列表排前；未归并新段保持相对年龄序。
            List<long> ids = new List<long>();
            ids.Add(newId);
            List<SegRef> remaining = new List<SegRef>();
            remaining.Add(new SegRef(seg, newId));
            for (int i = k; i < this.segs.Count; i = i + 1) {
                ids.Add(this.segs[i].id);
                remaining.Add(this.segs[i]);
            }
            published = true;
            // 归并不固化 memtable，恢复水位必须保持原值。
            if (!this.PublishBoth(this.man.LogStartSeq(), newId + 1, ids)) { return 0; }
            List<SegRef> old = this.segs;
            this.index = mergedIndex;
            this.segs = remaining;
            this.nextSegId = newId + 1;
            adopted = true;
            // 两个有效 fallback 槽都不再引用旧段后才允许删除。
            for (int i = 0; i < k; i = i + 1) {
                old[i].seg.Close();
                File.Delete(ZanStore.SegPath(this.basePath, old[i].id));
            }
            this.commitsSinceSync = 0;
            this.bytesSinceSync = 0;
            return k;
        } catch (Exception ex) {
            // 维护的错误值契约：失败关闭，未退休介质保留以供恢复。
            this.Fail("store merge failed: " + ex.Message);
            return 0;
        } finally {
            for (int i = 0; i < cursors.Count; i = i + 1) { cursors[i].Free(); }
            ZanStore.CloseWriter(wtr);
            if (seg != null && !adopted) { seg.Close(); }
            if (!published) { File.Delete(segPath); }
        }
    }

    bool WriteReady() {
        if (this.IsOpen()) { return true; }
        this.Fail(this.lastError != "" ? this.lastError
            : (this.log != null && this.log.GetError() != "" ? this.log.GetError() : "store is closed"));
        return false;
    }

    /// <summary>按键序（<see cref="String.CompareOrdinal"/> 升序）
    /// 归并扫描 fromKey（含）起的全部存活键值：memtable 与各段
    /// 多路归并，同键取最新版本（memtable &gt; 更大段号），墓碑
    /// 隐藏。visit 返回 false 早停。看到的是已提交视图（不含未
    /// 提交事务的覆盖层）；memtable 部分每次扫描现排序，段部分
    /// 顺序流读、不占用块缓存。返回 visit 接受的键数。</summary>
    int Scan(string fromKey, StoreVisit visit) {
        return ScanBetween(fromKey, "", visit);
    }

    /// <summary><see cref="Scan"/> 的有界形式：只访问
    /// [startKey, endKey] 闭区间内的键，上界在归并循环内判定，
    /// 调用方无需在回调里逐键比对。返回 visit 接受的键数。</summary>
    int ScanBetween(string startKey, string endKey, StoreVisit visit) {
        // 各段游标，段号降序排列 = 新段在前。
        List<SegCursor> cursors = new List<SegCursor>();
        for (int i = this.segs.Count - 1; i >= 0; i = i - 1) {
            cursors.Add(SegCursor.Open(this.segs[i].seg, startKey));
        }
        // memtable 中键 ≥ startKey 的部分（每键至多一条，即最新版本），
        // 先过滤再排序：固化+归并后的常态是 memtable 为空，排序整段跳过。
        List<string> mk = new List<string>();
        List<string> src = this.memtable.Keys;
        for (int i = 0; i < src.Count; i = i + 1) {
            if (String.CompareOrdinal(src[i], startKey) >= 0) { mk.Add(src[i]); }
        }
        ZanStore.SortStrings(mk);
        int mi = 0;

        int accepted = 0;
        bool bounded = endKey.Length > 0;
        // 墓碑集为空（无未固化删除）时逐键哈希整个跳过：
        // 扫描态集合的常态。
        bool hasTombs = this.tombstones.Count > 0;

        // 单一来源快速路径：恰好一个段、memtable 无参与归并的键。
        // 固化+归并后的常态——无需最小键仲裁与同键裁决，顺序直读。
        if (cursors.Count == 1 && mk.Count == 0) {
            SegCursor c = cursors[0];
            while (c.Valid()) {
                if (c.Op() == 1) {
                    string k = c.Key();
                    if (bounded && String.CompareOrdinal(k, endKey) > 0) { break; }
                    if (!hasTombs || !this.tombstones.ContainsKey(k)) {
                        if (!visit(k, c.Val())) { break; }
                        accepted = accepted + 1;
                    }
                }
                c.Next();
            }
            c.Free();
            return accepted;
        }

        bool go = true;
        while (go) {
            // 1) 各来源当前位置上的最小键；win = 胜出游标下标
            //    （-1 = memtable 持有当前键或无来源）。cursors 新→旧，
            //    严格小于才替换，天然让最新段在并列时胜出。
            string minKey = "";
            bool has = false;
            bool memHas = false;
            int win = -1;
            if (mi < mk.Count) { minKey = mk[mi]; has = true; memHas = true; }
            for (int i = 0; i < cursors.Count; i = i + 1) {
                SegCursor c = cursors[i];
                if (!c.Valid()) { continue; }
                if (!has) {
                    minKey = c.Key(); has = true; win = i;
                } else {
                    int cmp = String.CompareOrdinal(c.Key(), minKey);
                    if (cmp < 0) {
                        minKey = c.Key(); win = i; memHas = false;
                    } else if (cmp == 0 && win == -1) {
                        win = i;    // 与 memtable 同键：值仍取 memtable，游标须推进
                    }
                }
            }
            if (!has) { break; }
            if (bounded && String.CompareOrdinal(minKey, endKey) > 0) { break; }
            // 2) 最新来源定值：memtable 优先；否则胜出游标。
            bool live = false;
            string val = "";
            if (memHas) {
                string v = "";
                this.memtable.TryGetValue(minKey, out v);
                val = v;
                live = true;
            } else {
                SegCursor c = cursors[win];
                live = c.Op() == 1;
                val = c.Val();
            }
            // 3) 推进停在 minKey 的来源：memtable 与胜出游标必推；
            //    多段时更旧的段可能同名键，逐个核对一并作废。
            if (memHas) { mi = mi + 1; }
            if (win >= 0) { cursors[win].Next(); }
            for (int i = win + 1; i < cursors.Count; i = i + 1) {
                SegCursor c = cursors[i];
                if (c.Valid() && c.Key() == minKey) { c.Next(); }
            }
            // 尚未固化的墓碑同样压住旧段版本（点读路径由索引摘除
            // 保证，扫描路径在这里保证）。
            if (live && hasTombs && this.tombstones.ContainsKey(minKey)) { live = false; }
            // 4) 存活键才交给 visit；false 早停。
            if (live) {
                if (!visit(minKey, val)) { go = false; }
                else { accepted = accepted + 1; }
            }
        }
        for (int i = 0; i < cursors.Count; i = i + 1) { cursors[i].Free(); }
        return accepted;
    }

    /// <summary><see cref="ScanBetween"/> 的零拷贝形式：交付
    /// <see cref="ScanRow"/> 而非字符串——单段且 memtable 无未固化
    /// 数据时值不物化、上界与墓碑判定全走块内指针；memtable 有
    /// 参与则退化为字符串路径包装。语义与 ScanBetween 完全一致，
    /// 行数据仅在回调返回前有效。返回 visit 接受的键数。</summary>
    int ScanRows(string startKey, string endKey, ScanRowVisit visit) {
        if (this.segs.Count == 1 && this.memtable.Keys.Count == 0) {
            SegCursor c = SegCursor.Open(this.segs[0].seg, startKey);
            ScanRow row = new ScanRow();
            row.Bind(c);
            bool hasTombs = this.tombstones.Count > 0;
            bool bounded = endKey.Length > 0;
            int accepted = 0;
            while (c.Valid()) {
                if (c.Op() == 1) {
                    if (bounded && c.CmpKeyRaw(endKey) > 0) { break; }
                    if (!hasTombs || !this.tombstones.ContainsKey(c.Key())) {
                        if (!visit(row)) { break; }
                        accepted = accepted + 1;
                    }
                }
                c.Next();
            }
            c.Free();
            return accepted;
        }
        // 多源归并（未固化数据参与）：退化为字符串路径包装交付。
        ScanRow mrow = new ScanRow();
        return ScanBetween(startKey, endKey, delegate(string k, string v) {
            mrow.BindMem(k, v);
            return visit(mrow);
        });
    }

    /// <summary>统计 [startKey, endKey] 闭区间内的存活键数，
    /// 不做任何回调：单段且 memtable 无参与时走块级内核直数
    /// （免游标/回调对象），否则退化为归并扫描。返回键数。</summary>
    int CountRange(string startKey, string endKey) {
        List<string> src = this.memtable.Keys;
        if (this.segs.Count == 1 && src.Count == 0) {
            return ScanKernel(this.segs[0].seg, startKey, endKey,
                delegate(nint basePtr, int keyOff, int keyLen, int valOff, int valLen) {
                    return true;
                });
        }
        return ScanBetween(startKey, endKey, delegate(string k, string v) {
            return true;
        });
    }

    /// <summary><see cref="ScanKernel"/> 的区间形式：仅当处于
    /// 单段稳态（memtable 空）时走块级内核；多源归并或 memtable
    /// 有未固化数据时返回 -1（调用方须退回 <see cref="ScanRows"/>
    /// 字符串路径）。endKey 为空串 = 无上界。</summary>
    int TryScanKernel(string startKey, string endKey, KernelVisit visit) {
        List<string> src = this.memtable.Keys;
        if (this.segs.Count != 1 || src.Count != 0) { return -1; }
        return ScanKernel(this.segs[0].seg, startKey, endKey, visit);
    }

    /// <summary>
    /// 块级聚合内核（单段快速路径）：把块跨度一次读入（每
    /// <see cref="KERNEL_SPAN_BYTES"/> 一次系统调用，块在段文件里物理
    /// 连续、记录解析不依赖块边界）后循环裸解析记录，把（基址+偏移+
    /// 长度）直接交给 visit——不经 SegCursor/ScanRow 对象、不经每行
    /// delegate 之外的任何抽象；op=2 的段内墓碑由这里跳过（op=2 记
    /// 录无值）。墓碑集非空时逐键 memcmp 比对（未固化删除极少，比
    /// 对成本可忽略）；visit 返回 false 早停。返回 visit 接受的行数。
    ///
    /// 常态扫描（固化+归并后单段、memtable 空）的聚合与计数走
    /// 这里——每行成本 = varint 解码 + 一次回调，无对象分配；每
    /// 跨度成本 = 一次 ReadAt + 逐块 CRC（同会话首遍）。
    /// </summary>
    int ScanKernel(SegmentFile seg, string startKey, string endKey, KernelVisit visit) {
        int blockIdx = seg.BlockFor(startKey);
        int blockTotal = seg.BlockCount();
        int accepted = 0;
        bool bounded = endKey.Length > 0;
        bool hasTombs = this.tombstones.Count > 0;
        ByteBuffer buf = null;
        bool stop = false;
        while (blockIdx < blockTotal && !stop) {
            // 跨度终点：够 KERNEL_SPAN_BYTES 或到段尾。单块超长时
            // 至少覆盖该块。
            int endBlock = blockIdx + 1;
            long spanLen = seg.BlockLen(blockIdx);
            while (endBlock < blockTotal
                    && spanLen + seg.BlockLen(endBlock) <= ZanStore.KERNEL_SPAN_BYTES) {
                spanLen = spanLen + seg.BlockLen(endBlock);
                endBlock = endBlock + 1;
            }
            ByteBuffer nb = seg.LoadBlockSpan(blockIdx, endBlock, buf);
            if (nb == null) { break; }
            buf = nb;
            int pos = 0;
            int len = buf.Length();
            while (pos < len) {
                int op = buf.PeekU8(pos);
                if (op != 1 && op != 2) { break; }
                int p = pos + 1;
                long klen = buf.ReadVarIntAt(p, out p);
                if (klen < 0 || p + (int)klen > len) { break; }
                int keyOff = p;
                p = p + (int)klen;
                // 下界：定位块里可能有 < startKey 的前缀键（稀疏索
                // 引只保证块首 <= startKey），跳过。
                if (buf.CmpRangeRaw(keyOff, (int)klen, startKey) < 0) {
                    if (op == 2) { pos = p; continue; }
                    long skip = buf.ReadVarIntAt(p, out p);
                    if (skip < 0 || p + (int)skip > len) { break; }
                    pos = p + (int)skip;
                    continue;
                }
                if (op == 2) {
                    // 段内墓碑：无值。单段快速路径下它就是该键的
                    // 最新版本，直接跳过（键已被固化时索引摘除）。
                    pos = p;
                    continue;
                }
                long vlen = buf.ReadVarIntAt(p, out p);
                if (vlen < 0 || p + (int)vlen > len) { break; }
                int valOff = p;
                p = p + (int)vlen;
                // 起始定位之后段内按键序——首条越过上界即整段止步。
                if (bounded && buf.CmpRangeRaw(keyOff, (int)klen, endKey) > 0) {
                    stop = true;
                    break;
                }
                if (hasTombs && this.tombstones.ContainsKey(buf.Str(keyOff, (int)klen))) {
                    pos = p;
                    continue;
                }
                accepted = accepted + 1;
                if (!visit(buf.Raw(), keyOff, (int)klen, valOff, (int)vlen)) {
                    stop = true;
                    break;
                }
                pos = p;
            }
            blockIdx = endBlock;
        }
        if (buf != null) { buf.Free(); }
        return accepted;
    }

    /// <summary>共享锁下的 <see cref="Scan"/>；可与并发写入共存。</summary>
    async int ScanAsync(string fromKey, StoreVisit visit) {
        await this.rw.EnterRead();
        int n = Scan(fromKey, visit);
        this.rw.ExitRead();
        return n;
    }

    /// <summary>物化式范围扫描：startKey（含）到 endKey（含，与
    /// 旧引擎 <c>BTree.Scan</c> 语义一致）按键序收集到 output；
    /// limit &gt; 0 时至多 limit 条。返回收集的条数。</summary>
    int ScanRange(string startKey, string endKey, int limit, List<KvEntry> output) {
        int before = output.Count;
        Scan(startKey, delegate(string k, string v) {
            if (endKey.Length > 0 && String.CompareOrdinal(k, endKey) > 0) {
                return false;
            }
            output.Add(new KvEntry(k, v));
            return limit <= 0 || output.Count - before < limit;
        });
        return output.Count - before;
    }

    /// <summary>前缀扫描：所有以 prefix 开头的键值按键序收集；
    /// limit &gt; 0 时至多 limit 条。返回收集的条数。</summary>
    int ScanPrefix(string prefix, int limit, List<KvEntry> output) {
        int before = output.Count;
        Scan(prefix, delegate(string k, string v) {
            if (!k.StartsWith(prefix)) { return false; }
            output.Add(new KvEntry(k, v));
            return limit <= 0 || output.Count - before < limit;
        });
        return output.Count - before;
    }

    /// <summary><see cref="ScanKernel"/> 的键只读形式：不解析值、
    /// 只把（基址+键偏移+键长）交给 visit，供覆盖索引路径
    /// （索引条目键自带 id/值段，零文档读也零字符串物化）使用。
    /// 单段稳态前提与 <see cref="TryScanKernel"/> 相同，否则返回 -1。
    /// 返回 visit 接受的键数。</summary>
    int TryScanKeyKernel(string startKey, string endKey, KernelKeyVisit visit) {
        List<string> src = this.memtable.Keys;
        if (this.segs.Count != 1 || src.Count != 0) { return -1; }
        return ScanKeyKernel(this.segs[0].seg, startKey, endKey, visit);
    }

    /// <summary><see cref="ScanKernel"/> 的键只读内档：与行版同
    /// 跨度整读与上界/墓碑逻辑，只是不读值、交付键区间。</summary>
    int ScanKeyKernel(SegmentFile seg, string startKey, string endKey, KernelKeyVisit visit) {
        int blockIdx = seg.BlockFor(startKey);
        int blockTotal = seg.BlockCount();
        int accepted = 0;
        bool bounded = endKey.Length > 0;
        bool hasTombs = this.tombstones.Count > 0;
        ByteBuffer buf = null;
        bool stop = false;
        while (blockIdx < blockTotal && !stop) {
            int endBlock = blockIdx + 1;
            long spanLen = seg.BlockLen(blockIdx);
            while (endBlock < blockTotal
                    && spanLen + seg.BlockLen(endBlock) <= ZanStore.KERNEL_SPAN_BYTES) {
                spanLen = spanLen + seg.BlockLen(endBlock);
                endBlock = endBlock + 1;
            }
            ByteBuffer nb = seg.LoadBlockSpan(blockIdx, endBlock, buf);
            if (nb == null) { break; }
            buf = nb;
            int pos = 0;
            int len = buf.Length();
            while (pos < len) {
                int op = buf.PeekU8(pos);
                if (op != 1 && op != 2) { break; }
                int p = pos + 1;
                long klen = buf.ReadVarIntAt(p, out p);
                if (klen < 0 || p + (int)klen > len) { break; }
                int keyOff = p;
                p = p + (int)klen;
                // 下界：定位块里可能有 < startKey 的前缀键（稀疏索
                // 引只保证块首 <= startKey），跳过。
                if (buf.CmpRangeRaw(keyOff, (int)klen, startKey) < 0) {
                    if (op == 2) { pos = p; continue; }
                    long skip = buf.ReadVarIntAt(p, out p);
                    if (skip < 0 || p + (int)skip > len) { break; }
                    pos = p + (int)skip;
                    continue;
                }
                if (op == 2) {
                    if (bounded && buf.CmpRangeRaw(keyOff, (int)klen, endKey) > 0) {
                        stop = true;
                        break;
                    }
                    pos = p;
                    continue;
                }
                long vlen = buf.ReadVarIntAt(p, out p);
                if (vlen < 0 || p + (int)vlen > len) { break; }
                p = p + (int)vlen;
                if (bounded && buf.CmpRangeRaw(keyOff, (int)klen, endKey) > 0) {
                    stop = true;
                    break;
                }
                if (hasTombs && this.tombstones.ContainsKey(buf.Str(keyOff, (int)klen))) {
                    pos = p;
                    continue;
                }
                accepted = accepted + 1;
                if (!visit(buf.Raw(), keyOff, (int)klen)) {
                    stop = true;
                    break;
                }
                pos = p;
            }
            blockIdx = endBlock;
        }
        if (buf != null) { buf.Free(); }
        return accepted;
    }

    /// <summary>将缓冲与 OS 缓存全部强制落盘。</summary>
    void Checkpoint() {
        if (!this.WriteReady()) { return; }
        if (!this.log.Sync()) { this.Fail(this.log.GetError()); return; }
        this.commitsSinceSync = 0;
        this.bytesSinceSync = 0;
    }

    /// 当前全部段号列表。
    List<long> SegIdList() {
        List<long> ids = new List<long>();
        for (int i = 0; i < this.segs.Count; i = i + 1) {
            ids.Add(this.segs[i].id);
        }
        return ids;
    }

    /// 按段号找段句柄。
    SegRef FindSeg(long id) {
        for (int i = 0; i < this.segs.Count; i = i + 1) {
            if (this.segs[i].id == id) { return this.segs[i]; }
        }
        return null;
    }

    /// 失败关闭：保留首个诊断，丢弃事务，绝不重刷失败 pending 帧。
    void Fail(string error) {
        if (this.lastError == "") { this.lastError = error != "" ? error : "store I/O failed"; }
        if (this.txDepth > 0 || this.txPut.Count > 0 || this.txDel.Count > 0) {
            this.txDepth = 0;
            this.txPut.Clear();
            this.txDel.Clear();
            this.cacheEpoch = this.cacheEpoch + 1;
        }
        this.CloseResources();
    }

    void CloseResources() {
        if (this.closed) { return; }
        this.closed = true;
        if (this.log != null) { this.log.Close(false); }
        for (int i = 0; i < this.segs.Count; i = i + 1) { this.segs[i].seg.Close(); }
        this.cache.Close();
        this.rw.Close();
        if (this.lockHandle != 0) {
            long handle = this.lockHandle;
            this.lockHandle = 0;
            if (!File.Unlock(handle) && this.lastError == "") { this.lastError = "store unlock failed"; }
        }
    }

    /// 健康关闭同步所有已提交帧；尚未提交的覆盖层回滚。
    void Close() {
        if (this.closed) { return; }
        this.Rollback();
        if (this.IsOpen() && !this.log.Sync()) { this.lastError = this.log.GetError(); }
        this.CloseResources();
        if (this.lastError == "" && this.log != null && this.log.GetError() != "") {
            this.lastError = this.log.GetError();
        }
    }

    // ===== 排序（键序固化段用）：中位数三选快速排序 =====

    static void SortStrings(List<string> a) {
        ZanStore.SortRange(a, 0, a.Count - 1);
    }

    static void SortRange(List<string> a, int lo, int hi) {
        while (lo < hi) {
            if (hi - lo < 12) {
                for (int i = lo + 1; i <= hi; i = i + 1) {
                    string k = a[i];
                    int j = i - 1;
                    while (j >= lo && String.CompareOrdinal(a[j], k) > 0) {
                        a[j + 1] = a[j];
                        j = j - 1;
                    }
                    a[j + 1] = k;
                }
                return;
            }
            int mid = (lo + hi) / 2;
            if (String.CompareOrdinal(a[lo], a[mid]) > 0) { ZanStore.Swap(a, lo, mid); }
            if (String.CompareOrdinal(a[lo], a[hi]) > 0) { ZanStore.Swap(a, lo, hi); }
            if (String.CompareOrdinal(a[mid], a[hi]) > 0) { ZanStore.Swap(a, mid, hi); }
            string pivot = a[mid];
            int l = lo;
            int r = hi;
            while (l <= r) {
                while (String.CompareOrdinal(a[l], pivot) < 0) { l = l + 1; }
                while (String.CompareOrdinal(a[r], pivot) > 0) { r = r - 1; }
                if (l <= r) {
                    ZanStore.Swap(a, l, r);
                    l = l + 1;
                    r = r - 1;
                }
            }
            if (r - lo < hi - l) {
                ZanStore.SortRange(a, lo, r);
                lo = l;
            } else {
                ZanStore.SortRange(a, l, hi);
                hi = r;
            }
        }
    }

    static void Swap(List<string> a, int i, int j) {
        string t = a[i];
        a[i] = a[j];
        a[j] = t;
    }

    // ===== 协程安全的异步 API =====

    /// <summary>共享锁读取；可安全地与并发写入共存。</summary>
    async string GetAsync(string key) {
        await this.rw.EnterRead();
        string v = Get(key);
        this.rw.ExitRead();
        return v;
    }

    /// <summary>独占锁写入并按当前持久化档落盘。</summary>
    async void PutAsync(string key, string val) {
        await this.rw.EnterWrite();
        try { Put(key, val); }
        finally { this.rw.ExitWrite(); }
    }

    /// 独占锁删除一个键；返回键此前是否存在。
    async bool DeleteAsync(string key) {
        await this.rw.EnterWrite();
        bool existed = Delete(key);
        this.rw.ExitWrite();
        return existed;
    }

    /// <summary>独占锁下把 memtable 固化为新段。</summary>
    async void FlushAsync() {
        await this.rw.EnterWrite();
        FlushToSegment();
        this.rw.ExitWrite();
    }

    /// <summary>原子读改写：fn 在写临界区内看到最新已提交值
    /// （不存在时为 ""），因此同一键上的并发 UpdateAtomic
    /// 不会丢失更新。返回最终存储的结果。</summary>
    async string UpdateAtomic(string key, StoreUpdater fn) {
        await this.rw.EnterWrite();
        try {
            Begin();
            string next = fn(Get(key));
            Put(key, next);
            if (!Commit()) { throw new IOException(this.GetError()); }
            return next;
        } catch (Exception ex) {
            // 更新失败传播异常，先丢弃未提交覆盖层。
            this.Rollback();
            throw;
        } finally {
            this.rw.ExitWrite();
        }
    }
}
