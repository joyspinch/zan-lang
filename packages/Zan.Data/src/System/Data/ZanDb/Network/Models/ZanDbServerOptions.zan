using System;
using System.Json;
using System.Net.Sockets;
using System.Text;
using System.Threading;
namespace System.Data.ZanDb;

public class ZanDbServerOptions {
    public const string DEFAULT_HOST = "127.0.0.1";
    public const int DEFAULT_PORT = 19740;
    public const int DEFAULT_MAX_CONNECTIONS = 256;

    public string path;
    public string host;
    public int port;
    public string token;
    public int timeoutMs;
    public int maxConnections;

    public ZanDbServerOptions() {
        this.path = "";
        this.host = DEFAULT_HOST;
        this.port = DEFAULT_PORT;
        this.token = "";
        this.timeoutMs = ZanDbProtocol.DEFAULT_TIMEOUT_MS;
        this.maxConnections = DEFAULT_MAX_CONNECTIONS;
    }
}
