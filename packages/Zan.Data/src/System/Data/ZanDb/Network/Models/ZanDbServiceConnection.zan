using System;
using System.Json;
using System.Net.Sockets;
using System.Text;
using System.Threading;
namespace System.Data.ZanDb;

public class ZanDbServiceConnection {
    public TcpClient client;
    public long task;
    public bool busy;

    public ZanDbServiceConnection(TcpClient client) {
        this.client = client;
        this.task = 0;
        this.busy = false;
    }
}
