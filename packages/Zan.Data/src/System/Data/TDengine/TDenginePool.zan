using System;
using System.Data;
using System.Threading;

namespace System.Data.TDengine;

// 为 <see cref="TDengineConnection"/> 设计的协程感知连接池。
// 契约与 <see cref="DbPool"/> 相同——惰性增长到 <c>maxSize</c>，
// 等待由 <see cref="Gate"/> 驱动而非轮询，逐出失效连接——
// 但它是类型化的，协程查询 API（<c>QueryAsync</c>、
// <c>ExecuteAsync</c>）仍可用。打开连接和每条语句都运行在
// IO reactor 上，因此限制并发的是池的大小，
// 而不是 worker 线程数。
// 用法：
// pool.Release(db);
// pool.Close();
public class TDenginePool : IDisposable {
    string host;
    int port;
    string user;
    string password;
    string token;  // "" 表示使用用户名/密码
    string database;
    PoolCore<TDengineConnection> core;

    public TDenginePool(string host, int port, string user, string password,
            string token, string database, int maxSize) {
        this.host = host;
        this.port = port;
        this.user = user;
        this.password = password;
        this.token = token;
        this.database = database;
        this.core = new PoolCore<TDengineConnection>(maxSize);
    }

    // 令牌登录形式的构造，委托给完整构造（无用户名/密码）。
    public TDenginePool(string host, int port, string token,
            string database, int maxSize) : this(host, port, "", "", token,
                    database, maxSize) {
    }

    // 新建一个连接：有 token 走令牌登录，否则用户名/密码。
    async TDengineConnection OpenOne() {
        if (this.token != "") {
            return await TDengineConnection.OpenTokenAsync(this.host, this.port,
                                                           this.token, this.database);
        }
        return await TDengineConnection.OpenAsync(this.host, this.port, this.user,
                                                  this.password, this.database);
    }

    // 借出一个连接：复用空闲连接，未达上限则新建，
    // 否则挂起协程，直到有连接被归还。饱和等待有硬上限
    // （见 <see cref="PoolWait"/>）：超时返回 null，绝不定死。
    // 池已关闭后返回 null。
    public async TDengineConnection AcquireAsync() {
        PoolOpenAsync<TDengineConnection> open = this.OpenOne;
        Predicate<TDengineConnection> connected = TDenginePool.IsUsable;
        Action<TDengineConnection> close = TDenginePool.CloseConnection;
        PoolOpenFailure<TDengineConnection> failed = TDenginePool.ReportOpenFailure;
        return await this.core.AcquireAsync(open, connected, close, failed);
    }

    static bool IsUsable(TDengineConnection c) { return c.IsConnected(); }
    static void CloseConnection(TDengineConnection c) { c.Close(); }

    static void ReportOpenFailure(TDengineConnection c, Exception error) {
        string why = error != null ? error.Message : (c != null ? c.lastError : "");
        Console.WriteLine("[tdenginepool] connect failed: "
            + (why.Length > 0 ? why : "refused, timeout, or auth rejected"));
    }

    // 将连接归还给池。已损坏或 Close() 之后的
    // 连接会被直接关闭丢弃，不再入池。
    public void Release(TDengineConnection c) {
        if (c == null) {
            return;
        }
        if (this.core.IsClosed() || !c.IsConnected()) {
            c.Close();
            this.core.Drop(c);
            return;
        }
        if (!this.core.Pool(c)) { c.Close(); }
    }

    // 空闲（已入池、可用）连接数。
    public int IdleCount() {
        return this.core.IdleCount();
    }

    // 存活连接总数（空闲 + 已借出）。
    public int LiveCount() {
        return this.core.LiveCount();
    }

    // 当前挂起等待连接的协程数。
    public int WaitingCount() {
        return this.core.WaitingCount();
    }

    // 并发存活连接数的上限。
    public int MaxSize() {
        return this.core.MaxSize();
    }

    // 关闭所有空闲连接并将池标记为已关闭。
    // 仍借出的连接会在归还时被关闭。
    public void Close() {
        this.core.MarkClosed();
        TDengineConnection c = this.core.TakeClosing();
        while (c != null) {
            c.Close();
            this.core.Drop(c);
            c = this.core.TakeClosing();
        }
        this.core.WakeAll();
    }

    public void Dispose() {
        this.Close();
    }
}
