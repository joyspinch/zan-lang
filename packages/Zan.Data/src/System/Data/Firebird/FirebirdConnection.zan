using System;
using System.Data;
using System.Net.Sockets;
using System.Threading;

namespace System.Data.Firebird;

// 纯 Zan 协程化 Firebird 协议 v13 客户端（Firebird 3+，SRP 认证与可选 ARC4 线路加密）。
public partial class FirebirdConnection : IDbConnection {
    nint sock;
    bool connected;
    string lastError;
    int lastAffected;
    string database;
    string user;
    string plugin;
    string cryptPlugin;
    int acceptVersion;
    int dbHandle;
    int transHandle;
    FbBytes authData;
    FbArc4 encIn;
    FbArc4 encOut;
    bool wantCrypt;
    FbError lastStatus;
    bool busy;
    List<AsyncGate> waiters;
    // Fb 在 COMMIT/ROLLBACK 后自动续开空事务；仅携带未收尾写时为 true，由连接池归还路径回滚。
    public bool inTxn;

    private async bool AcquireLock() {
        if (!this.busy) {
            this.busy = true;
            return true;
        }
        AsyncGate g = new AsyncGate();
        if (this.waiters == null) { this.waiters = new List<AsyncGate>(); }
        this.waiters.Add(g);
        await g.Wait();
        g.Close();
        return true;
    }

    private void ReleaseLock() {
        if (this.waiters != null && this.waiters.Count > 0) {
            AsyncGate g = this.waiters[0];
            this.waiters.RemoveAt(0);
            g.Signal();
        } else {
            this.busy = false;
        }
    }

    public static int FETCH_ROWS = 400;
    public static int INFO_BUFFER = 32768;
    public static int MAX_BLOCK = 33554432;

    public FirebirdConnection() {
        this.sock = -1;
        this.connected = false;
        this.lastError = "";
        this.lastAffected = 0;
        this.database = "";
        this.user = "";
        this.plugin = "";
        this.cryptPlugin = "";
        this.acceptVersion = 0;
        this.dbHandle = -1;
        this.transHandle = -1;
        this.authData = null;
        this.encIn = null;
        this.encOut = null;
        this.wantCrypt = true;
        this.lastStatus = new FbError();
    }

    async int recvExact(byte[] dst, int off, int need) {
        int got = 0;
        byte[] tmp = new byte[need + 1];
        while (got < need) {
            int n = await Socket.RecvOv(this.sock, tmp, need - got);
            if (n <= 0) { return got; }
            NativeMemory.Copy((nint)dst + (nint)(off + got), (nint)tmp, n);
            if (this.encIn != null) { this.encIn.Translate(dst, off + got, n); }
            got = got + n;
        }
        return got;
    }

    async bool sendPacket(FbBytes pkt) {
        int n = pkt.Len();
        byte[] buf = new byte[n + 1];
        if (n > 0) { NativeMemory.Copy((nint)buf, (nint)pkt.Data(), n); }
        pkt.Release();
        if (this.encOut != null) { this.encOut.Translate(buf, 0, n); }
        if (await Socket.SendAsync(this.sock, buf, n) < 0) {
            this.lastError = "send failed";
            this.connected = false;
            return false;
        }
        return true;
    }

    async int recvInt() {
        byte[] b = new byte[5];
        if (await this.recvExact(b, 0, 4) < 4) {
            this.lastError = "connection closed by the server";
            this.connected = false;
            return -1;
        }
        return ((b[0] & 255) << 24) | ((b[1] & 255) << 16)
             | ((b[2] & 255) << 8) | (b[3] & 255);
    }

    async int recvSigned() {
        int v = await this.recvInt();
        return v >= 2147483648 ? v - 4294967296 : v;
    }

    async FbBytes recvAligned(int n) {
        if (n < 0 || n > FirebirdConnection.MAX_BLOCK) {
            this.lastError = "malformed block length";
            this.connected = false;
            return null;
        }
        int pad = (4 - (n % 4)) % 4;
        FbBytes b = FbBytes.Alloc(n + pad);
        if (await this.recvExact(b.Data(), 0, n + pad) < n + pad) {
            b.Release();
            this.lastError = "truncated response";
            this.connected = false;
            return null;
        }
        FbBytes v = b.Slice(0, n);
        b.Release();
        return v;
    }

    async FbBytes recvBlock() {
        int n = await this.recvInt();
        if (n < 0) { return null; }
        return await this.recvAligned(n);
    }

    async FbError recvStatus() {
        FbError e = new FbError();
        List<string> segs = new List<string>();
        int argNum = 0;
        bool more = true;
        while (more) {
            int kind = await this.recvInt();
            if (kind < 0) {
                e.SetMessage("connection closed while reading the status vector");
                return e;
            }
            if (kind == FbOp.ARG_END) {
                more = false;
            } else if (kind == FbOp.ARG_GDS) {
                int code = await this.recvInt();
                if (code != 0) {
                    e.AddCode(code);
                    segs.Add(FbError.Text(code));
                }
                argNum = 0;
            } else if (kind == FbOp.ARG_NUMBER) {
                int v = await this.recvSigned();
                argNum = argNum + 1;
                if (e.CodeCount() > 0 && e.CodeAt(e.CodeCount() - 1) == 335544436) {
                    e.SetSqlCode(v);
                }
                FirebirdConnection.fill(segs, argNum, Convert.ToString(v));
            } else if (kind == FbOp.ARG_STRING || kind == FbOp.ARG_CSTRING || kind == FbOp.ARG_SQL_STATE) {
                FbBytes s = await this.recvBlock();
                if (s == null) { return e; }
                argNum = argNum + 1;
                FirebirdConnection.fill(segs, argNum, s.Text());
                s.Release();
            } else if (kind == FbOp.ARG_INTERPRETED) {
                FbBytes s = await this.recvBlock();
                if (s == null) { return e; }
                segs.Add(s.Text());
                s.Release();
                argNum = 0;
            } else {
                e.SetMessage("unsupported status argument " + Convert.ToString(kind));
                return e;
            }
        }
        if (segs.Count > 0) {
            StringBuilder sb = new StringBuilder();
            bool first = true;
            for (int i = 0; i < segs.Count; i = i + 1) {
                if (segs[i].Length > 0) {
                    if (!first) { sb.Append("; "); }
                    sb.Append(segs[i]);
                    first = false;
                }
            }
            e.SetMessage(sb.ToString());
        }
        return e;
    }

    static void fill(List<string> segs, int argNum, string text) {
        if (segs.Count == 0) { segs.Add(text); return; }
        int last = segs.Count - 1;
        string mark = "@" + Convert.ToString(argNum);
        if (segs[last].Contains(mark)) {
            segs[last] = segs[last].Replace(mark, text);
        } else {
            segs.Add(text);
        }
    }

    async FbResponse recvResponse() {
        int op = await this.recvInt();
        while (op == FbOp.DUMMY) { op = await this.recvInt(); }
        if (op < 0) { return null; }
        if (op != FbOp.RESPONSE) {
            this.lastError = "unexpected operation " + Convert.ToString(op);
            this.connected = false;
            return null;
        }
        return await this.recvResponse4();
    }

    async FbResponse roundTrip(FbBytes pkt) {
        if (!await this.sendPacket(pkt)) { return null; }
        FbResponse resp = await this.recvResponse();
        if (resp == null) { return null; }
        // 仅在失败时覆盖 lastError，避免后续释放语句等成功往返抹掉真正错误信息。
        if (resp.Failed()) {
            this.lastStatus = resp.Err();
            this.lastError = resp.Err().Message();
        }
        return resp;
    }

    public static async FirebirdConnection OpenAsync(string host, int port,
            string database, string user, string password) {
        return await FirebirdConnection.OpenAsync(host, port, database, user, password, true);
    }

    public static async FirebirdConnection OpenAsync(string host, int port,
            string database, string user, string password, bool wireCrypt) {
        Socket.Initialize();
        FirebirdConnection conn = new FirebirdConnection();
        conn.database = database;
        conn.user = user;
        conn.wantCrypt = wireCrypt;
        bool ok = await conn.handshake(host, port, database, user, password);
        conn.connected = ok;
        if (!ok && conn.sock >= 0) {
            Socket.Close(conn.sock);
            conn.sock = -1;
        }
        return conn;
    }

    async bool handshake(string host, int port, string db, string user, string pw) {
        this.sock = Socket.CreateTcp();
        if (this.sock < 0) { this.lastError = "socket create failed"; return false; }
        Socket.SetNonBlocking(this.sock);
        if (await Socket.ConnectAsync(this.sock, host, port) != 0) {
            this.lastError = "cannot reach " + host + ":" + Convert.ToString(port);
            return false;
        }
        Socket.SetNoDelay(this.sock);

        FbSrp srp = FbSrp.Create();
        if (srp == null) {
            this.lastError = "no secure random source for the SRP exchange";
            return false;
        }
        if (!await this.sendPacket(FirebirdConnection.ConnectPacket(db, user, srp.PublicHex(), this.wantCrypt))) {
            return false;
        }
        if (!await this.authenticate(srp, user, pw)) { return false; }

        FbResponse att = await this.roundTrip(FirebirdConnection.AttachPacket(db, user, this.authData));
        if (att == null) { return false; }
        if (att.Failed()) { att.Release(); return false; }
        this.dbHandle = att.Handle();
        att.Release();
        return await this.beginTransaction();
    }

    static FbBytes ConnectPacket(string database, string user, string pubHex, bool wireCrypt) {
        FbBuf uid = new FbBuf();
        FirebirdConnection.writeClumplet(uid, FbOp.CNCT_LOGIN, user);
        FirebirdConnection.writeClumplet(uid, FbOp.CNCT_PLUGIN_NAME, "Srp256");
        FirebirdConnection.writeClumplet(uid, FbOp.CNCT_PLUGIN_LIST, "Srp256,Srp");
        FirebirdConnection.cnctChunked(uid, FbOp.CNCT_SPECIFIC_DATA, pubHex);
        uid.U8(FbOp.CNCT_CLIENT_CRYPT);
        uid.U8(4);
        uid.U8(wireCrypt ? 1 : 0);
        uid.U8(0); uid.U8(0); uid.U8(0);
        FirebirdConnection.writeClumplet(uid, FbOp.CNCT_USER, user);
        FirebirdConnection.writeClumplet(uid, FbOp.CNCT_HOST, "zan");
        FirebirdConnection.writeClumplet(uid, FbOp.CNCT_USER_VERIFICATION, "");

        FbBuf p = new FbBuf();
        p.Int(FbOp.CONNECT);
        p.Int(FbOp.ATTACH);
        p.Int(FbOp.CONNECT_VERSION);
        p.Int(FbOp.ARCH_GENERIC);
        p.Str(database);
        p.Int(1);
        FbBytes uidBytes = uid.ToBytes();
        p.Block(uidBytes);
        uidBytes.Release();
        p.Int(FbOp.PROTOCOL_V13);
        p.Int(FbOp.ARCH_GENERIC);
        p.Int(0);
        p.Int(FbOp.PTYPE_BATCH_SEND);
        p.Int(8);
        return p.ToBytes();
    }

    static void writeClumplet(FbBuf b, int tag, string v) {
        b.U8(tag);
        b.U8(v.Length);
        b.Raw(v);
    }

    static void cnctChunked(FbBuf b, int tag, string v) {
        int off = 0;
        int seq = 0;
        while (v.Length - off > 254) {
            b.U8(tag);
            b.U8(255);
            b.U8(seq);
            b.Raw(v.Substring(off, 254));
            off = off + 254;
            seq = seq + 1;
        }
        b.U8(tag);
        b.U8(v.Length - off + 1);
        b.U8(seq);
        b.Raw(v.Substring(off, v.Length - off));
    }

    async FbBytes answerSrpChallenge(FbBytes data, FbSrp srp, string user, string password, out FbBytes sessionKey) {
        sessionKey = null;
        if (this.plugin != "Srp" && this.plugin != "Srp256") {
            data.Release();
            this.lastError = "the server asked for the " + this.plugin
                + " authentication plugin, which this driver does not implement";
            return null;
        }
        if (data.Len() == 0) {
            data.Release();
            if (!await this.sendPacket(FirebirdConnection.ContAuth(srp.Public(), this.plugin, "Srp256,Srp"))) {
                return null;
            }
            int op2 = await this.recvInt();
            if (op2 == FbOp.RESPONSE) {
                FbResponse r = await this.recvResponse4();
                if (r != null) { this.lastError = r.Err().Message(); r.Release(); }
                return null;
            }
            if (op2 != FbOp.CONT_AUTH) {
                this.lastError = "unexpected authentication response " + Convert.ToString(op2);
                return null;
            }
            data = await this.recvBlock();
            if (data == null) { return null; }
            for (int skipIdx = 0; skipIdx < 3; skipIdx = skipIdx + 1) {
                FbBytes skip = await this.recvBlock();
                if (skip != null) { skip.Release(); }
            }
        }
        if (data.Len() < 4) {
            data.Release();
            this.lastError = "the server sent no SRP challenge (login refused)";
            return null;
        }
        int saltLen = (data.At(0) & 255) | ((data.At(1) & 255) << 8);
        if (saltLen < 0 || saltLen + 4 > data.Len()) {
            data.Release();
            this.lastError = "malformed SRP challenge";
            return null;
        }
        FbBytes salt = data.Slice(2, saltLen);
        FbBytes keyHex = data.Slice(4 + saltLen, data.Len() - 4 - saltLen);
        FbBytes serverPub = FbBytes.FromHex(keyHex.Text());
        keyHex.Release();
        FbSrpProof proof = srp.Prove(FbSrp.NormalizeUser(user), password, salt, serverPub, this.plugin == "Srp256");
        salt.Release();
        serverPub.Release();
        data.Release();
        if (proof == null) {
            this.lastError = "the SRP challenge could not be answered";
            return null;
        }
        sessionKey = proof.Key();
        return proof.Proof();
    }

    async bool finishCondAccept(FbBytes sessionKey) {
        if (!await this.sendPacket(FirebirdConnection.ContAuth(this.authData, this.plugin, "Srp256,Srp"))) {
            return false;
        }
        FbResponse resp = await this.recvResponse();
        if (resp == null) { return false; }
        if (resp.Failed()) {
            this.lastError = resp.Err().Message();
            resp.Release();
            return false;
        }
        string enc = FirebirdConnection.GuessWireCrypt(resp.Buf());
        resp.Release();
        if (enc.Length > 0 && this.wantCrypt && sessionKey != null) {
            if (enc != "Arc4") {
                this.lastError = "the server offers only the " + enc
                    + " wire encryption plugin, which this driver does not"
                    + " implement; run the connection through a tunnel or allow Arc4";
                return false;
            }
            if (!await this.startCrypt(sessionKey)) { return false; }
            // 握手已认证会话，attach 参数块不再重复证明。
            this.authData.Release();
            this.authData = FbBytes.Empty();
        }
        return true;
    }

    async bool authenticate(FbSrp srp, string user, string password) {
        int op = await this.recvInt();
        while (op == FbOp.DUMMY) { op = await this.recvInt(); }
        if (op < 0) { return false; }
        if (op == FbOp.REJECT) { this.lastError = "the server rejected the connection"; return false; }
        if (op == FbOp.RESPONSE) {
            FbResponse r = await this.recvResponse4();
            if (r != null) {
                this.lastError = r.Err().Message().Length == 0 ? "the server refused the connection" : r.Err().Message();
                r.Release();
            }
            return false;
        }
        if (op != FbOp.ACCEPT && op != FbOp.ACCEPT_DATA && op != FbOp.COND_ACCEPT) {
            this.lastError = "unexpected connect response " + Convert.ToString(op);
            return false;
        }
        this.acceptVersion = (await this.recvInt()) & 255;
        await this.recvInt();  // arch
        await this.recvInt();  // ptype
        if (this.acceptVersion != 13) {
            this.lastError = "the server speaks protocol " + Convert.ToString(this.acceptVersion)
                + "; this driver needs 13 (Firebird 3 or newer)";
            return false;
        }
        if (op == FbOp.ACCEPT) {
            this.lastError = "the server accepted without authentication data";
            return false;
        }
        FbBytes data = await this.recvBlock();
        if (data == null) { return false; }
        FbBytes pluginName = await this.recvBlock();
        if (pluginName == null) { data.Release(); return false; }
        this.plugin = pluginName.Text();
        pluginName.Release();
        int authenticated = await this.recvInt();
        FbBytes keys = await this.recvBlock();
        if (keys == null) { data.Release(); return false; }
        keys.Release();

        FbBytes sessionKey = null;
        if (authenticated == 0) {
            this.authData = await this.answerSrpChallenge(data, srp, user, password, out sessionKey);
            if (this.authData == null) { return false; }
        } else {
            data.Release();
            this.authData = FbBytes.Empty();
        }
        bool ok = op == FbOp.COND_ACCEPT ? await this.finishCondAccept(sessionKey) : true;
        if (sessionKey != null) { sessionKey.Release(); }
        return ok;
    }

    async FbResponse recvResponse4() {
        int handle = await this.recvInt();
        FbBytes oid = await this.recvAligned(8);
        if (oid == null) { return null; }
        FbBytes buf = await this.recvBlock();
        if (buf == null) { oid.Release(); return null; }
        FbError err = await this.recvStatus();
        return FbResponse.Of(handle, oid, buf, err);
    }

    static FbBytes ContAuth(FbBytes authData, string plugin, string pluginList) {
        FbBuf p = new FbBuf();
        p.Int(FbOp.CONT_AUTH);
        p.Str(authData.Hex());
        p.Str(plugin);
        p.Str(pluginList);
        p.Str("");
        return p.ToBytes();
    }

    static string GuessWireCrypt(FbBytes buf) {
        FbReader r = FbReader.Over(buf);
        string names = "";
        while (r.Left() >= 2) {
            int tag = r.U8();
            int ln = r.U8();
            string v = r.Text(ln);
            if (tag == 1) { names = v; }
        }
        if (names.Length == 0) { return ""; }
        if (names.Contains("Arc4")) { return "Arc4"; }
        int sp = names.IndexOf(" ");
        return sp > 0 ? names.Substring(0, sp) : names;
    }

    async bool startCrypt(FbBytes sessionKey) {
        FbBuf p = new FbBuf();
        p.Int(FbOp.CRYPT);
        p.Str("Arc4");
        p.Str("Symmetric");
        if (!await this.sendPacket(p.ToBytes())) { return false; }
        // 密钥流自请求发出后的下一字节生效，故在 recvResponse 前启用双向加密器。
        this.encOut = new FbArc4(sessionKey);
        this.encIn = new FbArc4(sessionKey);
        this.cryptPlugin = "Arc4";
        FbResponse resp = await this.recvResponse();
        if (resp == null) { return false; }
        if (resp.Failed()) {
            this.lastError = resp.Err().Message();
            resp.Release();
            return false;
        }
        resp.Release();
        return true;
    }

    static FbBytes AttachPacket(string database, string user, FbBytes authData) {
        FbBuf dpb = new FbBuf();
        dpb.U8(FbOp.DPB_VERSION1);
        FirebirdConnection.writeClumplet(dpb, FbOp.DPB_LC_CTYPE, "UTF8");
        FirebirdConnection.writeClumplet(dpb, FbOp.DPB_USER_NAME, user);
        FirebirdConnection.writeClumplet(dpb, FbOp.DPB_PROCESS_NAME, "zan");
        dpb.U8(FbOp.DPB_SQL_DIALECT);
        dpb.U8(4);
        dpb.U8(3); dpb.U8(0); dpb.U8(0); dpb.U8(0);
        if (authData != null && authData.Len() > 0) {
            FirebirdConnection.writeClumplet(dpb, FbOp.DPB_SPECIFIC_AUTH_DATA, authData.Hex());
        }
        FbBuf p = new FbBuf();
        p.Int(FbOp.ATTACH);
        p.Int(0);
        p.Str(database);
        FbBytes d = dpb.ToBytes();
        p.Block(d);
        d.Release();
        return p.ToBytes();
    }
}
