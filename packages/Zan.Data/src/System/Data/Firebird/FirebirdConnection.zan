using System;
using System.Data;
using System.Net.Sockets;
using System.Threading;

namespace System.Data.Firebird;

// 原生 Firebird 客户端，使用服务器自身的线缆协议（版本 13，
// 即 Firebird 3 及以上）——无需 fbclient，无需 ODBC。它以 SRP 登录，
// 可选开启服务器的 ARC4 线路加密，并直接驱动
// 语句生命周期（allocate / prepare / execute / fetch / free）。
// 每个网络步骤都在 IO 反应器上挂起（<c>Socket.ConnectAsync</c>、
// <c>Socket.SendAsync</c>、<c>Socket.RecvOv</c>），语句不会阻塞
// 工作线程，多连接可在单线程上推进。这正是
// 该类只暴露协程 API 而非阻塞式
// <see cref="IDbExecutor"/> 接口的原因：连接池见 <see cref="FirebirdPool"/>。
// 用法：
// await db.CloseAsync();
public partial class FirebirdConnection : IDbConnection {
    nint sock;
    bool connected;
    string lastError;
    int lastAffected;
    string database;
    string user;
    string plugin;  // 服务器选择的认证插件
    string cryptPlugin;  // 使用的线路加密，明文连接时为 ""
    int acceptVersion;
    int dbHandle;
    int transHandle;
    FbBytes authData;
    FbArc4 encIn;
    FbArc4 encOut;
    bool wantCrypt;
    FbError lastStatus;
    bool busy;
    List<AsyncGate> waiters;
    // A535：事务携带未收尾写时为 true。Fb 协议在 COMMIT/ROLLBACK 后会
    // 自动续开一个空事务（无用户写入，非残留），故成功落地即清零；
    // 落地失败保持 true，由连接池归还路径的清理协程再试 ROLLBACK。
    public bool inTxn;

    private async bool AcquireLock() {
        if (!this.busy) {
            this.busy = true;
            return true;
        }
        AsyncGate g = new AsyncGate();
        if (this.waiters == null) { this.waiters = new List<AsyncGate>(); }
        this.waiters.Add(g);
        await g.Wait();
        g.Close();
        return true;
    }

    private void ReleaseLock() {
        if (this.waiters != null && this.waiters.Count > 0) {
            AsyncGate g = this.waiters[0];
            this.waiters.RemoveAt(0);
            g.Signal();
        } else {
            this.busy = false;
        }
    }

    // 每次 fetch 往返请求服务器发送的行数。
    public static int FETCH_ROWS = 400;
    // 描述语句时请求的 info 缓冲区大小。
    public static int INFO_BUFFER = 32768;
    // 可接受的单个协议块上限，用于防范
    // 损坏或恶意的长度前缀。
    public static int MAX_BLOCK = 33554432;

    // 空连接；外部经 <see cref="OpenAsync"/> 构造。
    public FirebirdConnection() {
        this.sock = 0 - 1;
        this.connected = false;
        this.lastError = "";
        this.lastAffected = 0;
        this.database = "";
        this.user = "";
        this.plugin = "";
        this.cryptPlugin = "";
        this.acceptVersion = 0;
        this.dbHandle = 0 - 1;
        this.transHandle = 0 - 1;
        this.authData = null;
        this.encIn = null;
        this.encOut = null;
        this.wantCrypt = true;
        this.lastStatus = new FbError();
    }

    // 传输

    // 精确读取 <paramref name="need"/> 字节，会话加密时
    // 对其解密。返回实际读取的字节数。
    async int recvExact(byte[] dst, int off, int need) {
        int got = 0;
        byte[] tmp = new byte[need + 1];
        while (got < need) {
            int n = await Socket.RecvOv(this.sock, tmp, need - got);
            if (n <= 0) {
                return got;
            }
            NativeMemory.Copy((nint)dst + (nint)(off + got), (nint)tmp, n);
            if (this.encIn != null) {
                this.encIn.Translate(dst, off + got, n);
            }
            got = got + n;
        }
        return got;
    }

    // 发送整个数据包并释放它。字节在
    // 加密前复制，确保密钥流不会改写调用方的缓冲区。
    async bool sendPacket(FbBytes pkt) {
        int n = pkt.Len();
        byte[] buf = new byte[n + 1];
        if (n > 0) {
            NativeMemory.Copy((nint)buf, (nint)pkt.Data(), n);
        }
        pkt.Release();
        if (this.encOut != null) {
            this.encOut.Translate(buf, 0, n);
        }
        int sent = await Socket.SendAsync(this.sock, buf, n);
        if (sent < 0) {
            this.lastError = "send failed";
            this.connected = false;
            return false;
        }
        return true;
    }

    // 读取 4 字节大端整数；连接关闭时返回 -1 并标记断开。
    async int recvInt() {
        byte[] b = new byte[5];
        int got = await this.recvExact(b, 0, 4);
        if (got < 4) {
            this.lastError = "connection closed by the server";
            this.connected = false;
            return 0 - 1;
        }
        return ((b[0] & 255) << 24) | ((b[1] & 255) << 16)
             | ((b[2] & 255) << 8) | (b[3] & 255);
    }

    // 读取一个协议视为有符号的 32 位值。
    async int recvSigned() {
        int v = await this.recvInt();
        if (v >= 2147483648) { return v - 4294967296; }
        return v;
    }

    // <paramref name="n"/> 字节加上将其补至
    // 4 字节边界的填充。
    async FbBytes recvAligned(int n) {
        if (n < 0 || n > FirebirdConnection.MAX_BLOCK) {
            this.lastError = "malformed block length";
            this.connected = false;
            return null;
        }
        int pad = (4 - (n % 4)) % 4;
        FbBytes b = FbBytes.Alloc(n + pad);
        int got = await this.recvExact(b.Data(), 0, n + pad);
        if (got < n + pad) {
            b.Release();
            this.lastError = "truncated response";
            this.connected = false;
            return null;
        }
        FbBytes v = b.Slice(0, n);
        b.Release();
        return v;
    }

    // 带长度前缀、4 字节对齐的块。
    async FbBytes recvBlock() {
        int n = await this.recvInt();
        if (n < 0) { return null; }
        return await this.recvAligned(n);
    }

    // 响应与错误

    // 读取状态向量并将其转为可读错误。
    async FbError recvStatus() {
        FbError e = new FbError();
        List<string> segs = new List<string>();
        int argNum = 0;
        bool more = true;
        while (more) {
            int kind = await this.recvInt();
            if (kind < 0) {
                e.SetMessage("connection closed while reading the status vector");
                return e;
            }
            if (kind == FbOp.ARG_END) {
                more = false;
            } else if (kind == FbOp.ARG_GDS) {
                int code = await this.recvInt();
                // 每个向量都以 0 结尾，无论成败；只有
                // 非 0 的才带有消息。
                if (code != 0) {
                    e.AddCode(code);
                    segs.Add(FbError.Text(code));
                }
                argNum = 0;
            } else if (kind == FbOp.ARG_NUMBER) {
                int v = await this.recvSigned();
                argNum = argNum + 1;
                if (e.CodeCount() > 0
                        && e.CodeAt(e.CodeCount() - 1) == 335544436) {
                    e.SetSqlCode(v);
                }
                FirebirdConnection.fill(segs, argNum, Convert.ToString(v));
            } else if (kind == FbOp.ARG_STRING || kind == FbOp.ARG_CSTRING
                    || kind == FbOp.ARG_SQL_STATE) {
                FbBytes s = await this.recvBlock();
                if (s == null) { return e; }
                argNum = argNum + 1;
                FirebirdConnection.fill(segs, argNum, s.Text());
                s.Release();
            } else if (kind == FbOp.ARG_INTERPRETED) {
                FbBytes s = await this.recvBlock();
                if (s == null) { return e; }
                segs.Add(s.Text());
                s.Release();
                argNum = 0;
            } else {
                e.SetMessage("unsupported status argument "
                             + Convert.ToString(kind));
                return e;
            }
        }
        if (segs.Count > 0) {
            StringBuilder sb = new StringBuilder();
            bool first = true;
            for (int i = 0; i < segs.Count; i = i + 1) {
                if (segs[i].Length > 0) {
                    if (!first) { sb.Append("; "); }
                    sb.Append(segs[i]);
                    first = false;
                }
            }
            e.SetMessage(sb.ToString());
        }
        return e;
    }

    // 将第 n 个参数代入正在等待它的
    // 消息段。
    static void fill(List<string> segs, int argNum, string text) {
        if (segs.Count == 0) {
            segs.Add(text);
            return;
        }
        int last = segs.Count - 1;
        string mark = "@" + Convert.ToString(argNum);
        if (segs[last].Contains(mark)) {
            segs[last] = segs[last].Replace(mark, text);
        } else {
            segs.Add(text);
        }
    }

    // 读取一个 <c>op_response</c>，跳过服务器可能
    // 穿插发送的 keep-alive 包。
    async FbResponse recvResponse() {
        int op = await this.recvInt();
        while (op == FbOp.DUMMY) {
            op = await this.recvInt();
        }
        if (op < 0) { return null; }
        if (op != FbOp.RESPONSE) {
            this.lastError = "unexpected operation " + Convert.ToString(op);
            this.connected = false;
            return null;
        }
        int handle = await this.recvInt();
        FbBytes oid = await this.recvAligned(8);
        if (oid == null) { return null; }
        FbBytes buf = await this.recvBlock();
        if (buf == null) {
            oid.Release();
            return null;
        }
        FbError err = await this.recvStatus();
        return FbResponse.Of(handle, oid, buf, err);
    }

    // 发送一个数据包并读取对应的响应，记录
    // 任何服务器错误。
    async FbResponse roundTrip(FbBytes pkt) {
        bool sent = await this.sendPacket(pkt);
        if (!sent) { return null; }
        FbResponse resp = await this.recvResponse();
        if (resp == null) { return null; }
        // 失败后各次往返（例如释放语句）返回的干净状态
        // 不能抹去真正的错误信息。
        if (resp.Failed()) {
            this.lastStatus = resp.Err();
            this.lastError = resp.Err().Message();
        }
        return resp;
    }

    // 连接、认证、附加

    // 打开连接，以 SRP 认证并附加到
    // 数据库。服务器支持时启用线路加密。
    public static async FirebirdConnection OpenAsync(string host, int port,
            string database, string user, string password) {
        return await FirebirdConnection.OpenAsync(host, port, database, user,
                                                  password, true);
    }

    // 可拒绝线路加密的打开变体（适用于
    // 经由已加密隧道访问的服务器，或配置了
    // <c>WireCrypt = Disabled</c> 的服务器）。
    public static async FirebirdConnection OpenAsync(string host, int port,
            string database, string user, string password, bool wireCrypt) {
        Socket.Initialize();
        FirebirdConnection conn = new FirebirdConnection();
        conn.database = database;
        conn.user = user;
        conn.wantCrypt = wireCrypt;
        bool ok = await conn.handshake(host, port, database, user, password);
        conn.connected = ok;
        if (!ok) {
            if (conn.sock >= 0) {
                Socket.Close(conn.sock);
                conn.sock = 0 - 1;
            }
        }
        return conn;
    }

    // 完整连接序列：TCP 连接、op_connect（协议 13 + SRP 公钥）、
    // SRP 认证、op_attach 取数据库句柄并开启事务。
    async bool handshake(string host, int port, string db, string user, string pw) {
        this.sock = Socket.CreateTcp();
        if (this.sock < 0) {
            this.lastError = "socket create failed";
            return false;
        }
        Socket.SetNonBlocking(this.sock);
        int rc = await Socket.ConnectAsync(this.sock, host, port);
        if (rc != 0) {
            this.lastError = "cannot reach " + host + ":" + Convert.ToString(port);
            return false;
        }
        Socket.SetNoDelay(this.sock);

        FbSrp srp = FbSrp.Create();
        if (srp == null) {
            this.lastError = "no secure random source for the SRP exchange";
            return false;
        }
        bool sent = await this.sendPacket(
            FirebirdConnection.ConnectPacket(db, user, srp.PublicHex(),
                                             this.wantCrypt));
        if (!sent) { return false; }
        if (!await this.authenticate(srp, user, pw)) { return false; }

        FbResponse att = await this.roundTrip(
            FirebirdConnection.AttachPacket(db, user, this.authData));
        if (att == null) { return false; }
        if (att.Failed()) {
            att.Release();
            return false;
        }
        this.dbHandle = att.Handle();
        att.Release();
        return await this.beginTransaction();
    }

    // 构建 <c>op_connect</c>：客户端提供协议 13 及
    // SRP 公钥，服务器以 salt 和自身公钥应答。
    static FbBytes ConnectPacket(string database, string user, string pubHex,
            bool wireCrypt) {
        FbBuf uid = new FbBuf();
        FirebirdConnection.cnct(uid, FbOp.CNCT_LOGIN, user);
        FirebirdConnection.cnct(uid, FbOp.CNCT_PLUGIN_NAME, "Srp256");
        FirebirdConnection.cnct(uid, FbOp.CNCT_PLUGIN_LIST, "Srp256,Srp");
        FirebirdConnection.cnctChunked(uid, FbOp.CNCT_SPECIFIC_DATA, pubHex);
        uid.U8(FbOp.CNCT_CLIENT_CRYPT);
        uid.U8(4);
        if (wireCrypt) { uid.U8(1); } else { uid.U8(0); }
        uid.U8(0); uid.U8(0); uid.U8(0);
        FirebirdConnection.cnct(uid, FbOp.CNCT_USER, user);
        FirebirdConnection.cnct(uid, FbOp.CNCT_HOST, "zan");
        FirebirdConnection.cnct(uid, FbOp.CNCT_USER_VERIFICATION, "");

        FbBuf p = new FbBuf();
        p.Int(FbOp.CONNECT);
        p.Int(FbOp.ATTACH);
        p.Int(FbOp.CONNECT_VERSION);
        p.Int(FbOp.ARCH_GENERIC);
        p.Str(database);
        p.Int(1);  // 提供一个协议选项
        FbBytes uidBytes = uid.ToBytes();
        p.Block(uidBytes);
        uidBytes.Release();
        // 版本、架构、最小类型、最大类型（批量发送）、权重
        p.Int(FbOp.PROTOCOL_V13);
        p.Int(FbOp.ARCH_GENERIC);
        p.Int(0);
        p.Int(FbOp.PTYPE_BATCH_SEND);
        p.Int(8);
        return p.ToBytes();
    }

    // 写入单个 connect 用户项（1 字节标签 + 1 字节长度 + 值）。
    static void cnct(FbBuf b, int tag, string v) {
        b.U8(tag);
        b.U8(v.Length);
        b.Raw(v);
    }

    // specific-data clumplet 带有序号字节，按
    // 254 字节分片，SRP 公钥总是需要这样发送。
    static void cnctChunked(FbBuf b, int tag, string v) {
        int off = 0;
        int seq = 0;
        while (v.Length - off > 254) {
            b.U8(tag);
            b.U8(255);
            b.U8(seq);
            b.Raw(v.Substring(off, 254));
            off = off + 254;
            seq = seq + 1;
        }
        b.U8(tag);
        b.U8(v.Length - off + 1);
        b.U8(seq);
        b.Raw(v.Substring(off, v.Length - off));
    }

    // 执行 SRP 续接流程，并在服务器要求时
    // 开启线路加密。
    async bool authenticate(FbSrp srp, string user, string password) {
        int op = await this.recvInt();
        while (op == FbOp.DUMMY) {
            op = await this.recvInt();
        }
        if (op < 0) { return false; }
        if (op == FbOp.REJECT) {
            this.lastError = "the server rejected the connection";
            return false;
        }
        if (op == FbOp.RESPONSE) {
            FbResponse r = await this.recvResponse4();
            if (r != null) {
                this.lastError = r.Err().Message();
                if (this.lastError.Length == 0) {
                    this.lastError = "the server refused the connection";
                }
                r.Release();
            }
            return false;
        }
        if (op != FbOp.ACCEPT && op != FbOp.ACCEPT_DATA
                && op != FbOp.COND_ACCEPT) {
            this.lastError = "unexpected connect response " + Convert.ToString(op);
            return false;
        }
        int version = await this.recvInt();
        this.acceptVersion = version & 255;
        await this.recvInt();  // 架构
        await this.recvInt();  // 数据包类型
        if (this.acceptVersion != 13) {
            this.lastError = "the server speaks protocol "
                + Convert.ToString(this.acceptVersion)
                + "; this driver needs 13 (Firebird 3 or newer)";
            return false;
        }
        if (op == FbOp.ACCEPT) {
            // 协议 13 的 accept 总带有认证数据；
            // 裸 accept 意味着服务器想要我们未提供的认证方案。
            this.lastError = "the server accepted without authentication data";
            return false;
        }

        FbBytes data = await this.recvBlock();
        if (data == null) { return false; }
        FbBytes pluginName = await this.recvBlock();
        if (pluginName == null) { data.Release(); return false; }
        this.plugin = pluginName.Text();
        pluginName.Release();
        int authenticated = await this.recvInt();
        FbBytes keys = await this.recvBlock();
        if (keys == null) { data.Release(); return false; }
        keys.Release();

        FbBytes sessionKey = null;
        if (authenticated == 0) {
            if (this.plugin != "Srp" && this.plugin != "Srp256") {
                data.Release();
                this.lastError = "the server asked for the " + this.plugin
                    + " authentication plugin, which this driver does not implement";
                return false;
            }
            if (data.Len() == 0) {
                // 服务器在发送 salt 前
                // 再次索取公钥：继续握手。
                data.Release();
                bool sent = await this.sendPacket(FirebirdConnection.ContAuth(
                    srp.Public(), this.plugin, "Srp256,Srp"));
                if (!sent) { return false; }
                int op2 = await this.recvInt();
                if (op2 == FbOp.RESPONSE) {
                    FbResponse r = await this.recvResponse4();
                    if (r != null) {
                        this.lastError = r.Err().Message();
                        r.Release();
                    }
                    return false;
                }
                if (op2 != FbOp.CONT_AUTH) {
                    this.lastError = "unexpected authentication response "
                        + Convert.ToString(op2);
                    return false;
                }
                data = await this.recvBlock();
                if (data == null) { return false; }
                FbBytes skip = await this.recvBlock();  // 插件名
                if (skip != null) { skip.Release(); }
                skip = await this.recvBlock();  // 插件列表
                if (skip != null) { skip.Release(); }
                skip = await this.recvBlock();  // 密钥
                if (skip != null) { skip.Release(); }
            }
            if (data.Len() < 4) {
                data.Release();
                this.lastError = "the server sent no SRP challenge (login refused)";
                return false;
            }
            int saltLen = (data.At(0) & 255) | ((data.At(1) & 255) << 8);
            if (saltLen < 0 || saltLen + 4 > data.Len()) {
                data.Release();
                this.lastError = "malformed SRP challenge";
                return false;
            }
            FbBytes salt = data.Slice(2, saltLen);
            FbBytes keyHex = data.Slice(4 + saltLen, data.Len() - 4 - saltLen);
            FbBytes serverPub = FbBytes.FromHex(keyHex.Text());
            keyHex.Release();
            FbSrpProof proof = srp.Prove(FbSrp.NormalizeUser(user), password,
                                         salt, serverPub,
                                         this.plugin == "Srp256");
            salt.Release();
            serverPub.Release();
            if (proof == null) {
                data.Release();
                this.lastError = "the SRP challenge could not be answered";
                return false;
            }
            this.authData = proof.Proof();
            sessionKey = proof.Key();
        } else {
            this.authData = FbBytes.Empty();
        }
        data.Release();

        if (op == FbOp.COND_ACCEPT) {
            bool sent = await this.sendPacket(FirebirdConnection.ContAuth(
                this.authData, this.plugin, "Srp256,Srp"));
            if (!sent) {
                if (sessionKey != null) { sessionKey.Release(); }
                return false;
            }
            FbResponse resp = await this.recvResponse();
            if (resp == null) {
                if (sessionKey != null) { sessionKey.Release(); }
                return false;
            }
            if (resp.Failed()) {
                this.lastError = resp.Err().Message();
                resp.Release();
                if (sessionKey != null) { sessionKey.Release(); }
                return false;
            }
            string enc = FirebirdConnection.GuessWireCrypt(resp.Buf());
            resp.Release();
            if (enc.Length > 0 && this.wantCrypt && sessionKey != null) {
                if (enc != "Arc4") {
                    this.lastError = "the server offers only the " + enc
                        + " wire encryption plugin, which this driver does not"
                        + " implement; run the connection through a tunnel or"
                        + " allow Arc4";
                    sessionKey.Release();
                    return false;
                }
                bool up = await this.startCrypt(sessionKey);
                sessionKey.Release();
                if (!up) { return false; }
                // 握手已认证会话，因此 attach
                // 的参数块中不得重复证明。
                this.authData.Release();
                this.authData = FbBytes.Empty();
                return true;
            }
        }
        if (sessionKey != null) { sessionKey.Release(); }
        return true;
    }

    // 读取一个操作码已从线缆上取走的响应的
    // 正文。
    async FbResponse recvResponse4() {
        int handle = await this.recvInt();
        FbBytes oid = await this.recvAligned(8);
        if (oid == null) { return null; }
        FbBytes buf = await this.recvBlock();
        if (buf == null) {
            oid.Release();
            return null;
        }
        FbError err = await this.recvStatus();
        return FbResponse.Of(handle, oid, buf, err);
    }

    // 构建 op_cont_auth：认证数据（hex）、插件名与插件列表。
    static FbBytes ContAuth(FbBytes authData, string plugin, string pluginList) {
        FbBuf p = new FbBuf();
        p.Int(FbOp.CONT_AUTH);
        p.Str(authData.Hex());
        p.Str(plugin);
        p.Str(pluginList);
        p.Str("");
        return p.ToBytes();
    }

    // 从服务器提供的列表中选择线路加密插件。
    // 缓冲区是 clumplet 列表：标签 1 保存以空格分隔的插件名。
    static string GuessWireCrypt(FbBytes buf) {
        FbReader r = FbReader.Over(buf);
        string names = "";
        while (r.Left() >= 2) {
            int tag = r.U8();
            int ln = r.U8();
            string v = r.Text(ln);
            if (tag == 1) { names = v; }
        }
        if (names.Length == 0) { return ""; }
        if (names.Contains("Arc4")) { return "Arc4"; }
        int sp = names.IndexOf(" ");
        if (sp > 0) { return names.Substring(0, sp); }
        return names;
    }

    // 发送 op_crypt 请求 Arc4 线路加密，并在发出请求之后、
    // 读取应答之前启用双向 ARC4 密钥流。
    async bool startCrypt(FbBytes sessionKey) {
        FbBuf p = new FbBuf();
        p.Int(FbOp.CRYPT);
        p.Str("Arc4");
        p.Str("Symmetric");
        bool sent = await this.sendPacket(p.ToBytes());
        if (!sent) { return false; }
        // 密钥流从各方向的下一字节开始，因此
        // 翻译器应在请求发出后、
        // 读取应答前启用。
        this.encOut = new FbArc4(sessionKey);
        this.encIn = new FbArc4(sessionKey);
        this.cryptPlugin = "Arc4";
        FbResponse resp = await this.recvResponse();
        if (resp == null) { return false; }
        if (resp.Failed()) {
            this.lastError = resp.Err().Message();
            resp.Release();
            return false;
        }
        resp.Release();
        return true;
    }

    // 构建带数据库参数块的 <c>op_attach</c>。
    static FbBytes AttachPacket(string database, string user, FbBytes authData) {
        FbBuf dpb = new FbBuf();
        dpb.U8(FbOp.DPB_VERSION1);
        FirebirdConnection.dpbStr(dpb, FbOp.DPB_LC_CTYPE, "UTF8");
        FirebirdConnection.dpbStr(dpb, FbOp.DPB_USER_NAME, user);
        FirebirdConnection.dpbStr(dpb, FbOp.DPB_PROCESS_NAME, "zan");
        dpb.U8(FbOp.DPB_SQL_DIALECT);
        dpb.U8(4);
        dpb.U8(3); dpb.U8(0); dpb.U8(0); dpb.U8(0);
        if (authData != null && authData.Len() > 0) {
            FirebirdConnection.dpbStr(dpb, FbOp.DPB_SPECIFIC_AUTH_DATA,
                                      authData.Hex());
        }
        FbBuf p = new FbBuf();
        p.Int(FbOp.ATTACH);
        p.Int(0);
        p.Str(database);
        FbBytes d = dpb.ToBytes();
        p.Block(d);
        d.Release();
        return p.ToBytes();
    }

    // 写入单个 DPB 字符串项（标签 + 长度 + 值）。
    static void dpbStr(FbBuf b, int tag, string v) {
        b.U8(tag);
        b.U8(v.Length);
        b.Raw(v);
    }

}
