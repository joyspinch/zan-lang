using System;
using System.Data;
using System.Threading;

namespace System.Data.Firebird;

// 面向协程的 <see cref="FirebirdConnection"/> 连接池。
// 与 <see cref="DbPool"/> 契约一致——惰性增长至 <c>maxSize</c>，
// 由 <see cref="Gate"/> 驱动等待而非轮询，淘汰失效
// 连接——但类型化，因此协程查询 API（<c>QueryAsync</c>、
// <c>ExecuteAsync</c>）仍可访问。一次 attach 需要一次 SRP 握手和
// 多轮往返，这就是要复用会话而非
// 每条语句开一个新会话的原因。
// 用法：
// pool.Release(db);
// pool.Close();
public class FirebirdPool : IDisposable {
    private string host;
    private int port;
    private string database;
    private string user;
    private string password;
    private bool wireCrypt;
    private PoolCore<FirebirdConnection> core;

    // 完整构造：显式指定是否启用 wire 协议加密。
    public FirebirdPool(string host, int port, string database, string user,
            string password, bool wireCrypt, int maxSize) {
        this.host = host;
        this.port = port;
        this.database = database;
        this.user = user;
        this.password = password;
        this.wireCrypt = wireCrypt;
        this.core = new PoolCore<FirebirdConnection>(maxSize);
    }

    // 以默认配置（启用 wire 加密）构造。
    public FirebirdPool(string host, int port, string database, string user,
            string password, int maxSize) : this(host, port, database, user,
                    password, true, maxSize) {
    }

    // 新建一个连接（attach + SRP 认证握手）；失败返回 null。
    private async FirebirdConnection OpenOne() {
        return await FirebirdConnection.OpenAsync(this.host, this.port,
                                                  this.database, this.user,
                                                  this.password,
                                                  this.wireCrypt);
    }

    // 借出一个连接：复用空闲的，未达上限则新建，
    // 否则挂起协程，直到有连接被释放。饱和等待有硬上限
    // （见 <see cref="PoolWait"/>）：超时返回 null，绝不定死。
    // 连接池关闭后返回 null。
    public async FirebirdConnection AcquireAsync() {
        PoolOpenAsync<FirebirdConnection> open = this.OpenOne;
        Predicate<FirebirdConnection> connected = FirebirdPool.IsUsable;
        Action<FirebirdConnection> close = FirebirdPool.CloseConnection;
        PoolOpenFailure<FirebirdConnection> failed = FirebirdPool.ReportOpenFailure;
        return await this.core.AcquireAsync(open, connected, close, failed);
    }

    static bool IsUsable(FirebirdConnection c) { return c.IsConnected(); }
    static void CloseConnection(FirebirdConnection c) { c.Close(); }

    static void ReportOpenFailure(FirebirdConnection c, Exception error) {
        string why = error != null ? error.Message : (c != null ? c.lastError : "");
        Console.WriteLine("[firebirdpool] connect failed: "
            + (why.Length > 0 ? why : "refused, timeout, or auth rejected"));
    }

    // 将连接归还连接池。已损坏或 Close() 之后
    // 的连接会直接关闭丢弃，而非放回池中。归还时事务未收尾的连接
    // 不直接入池：挂清理协程把残留事务 ROLLBACK 掉后再回池
    // （A535，P2-29 的异步驱动半边；协程由调度器泵动——异步
    // 驱动的使用方必然运行在协程环境里）。
    public void Release(FirebirdConnection c) {
        if (c == null) {
            return;
        }
        if (this.core.IsClosed() || !c.IsConnected()) {
            this.CloseAndDrop(c);
            return;
        }
        if (c.inTxn) {
            Task.Spawn(this.Cleanup(c));
            return;
        }
        if (!this.core.Pool(c)) { c.Close(); }
    }

    // 清理协程体：ROLLBACK 落地后连接才回池；若回滚异常或连接失效，
    // 说明连接协议或底层通道已损坏，立即关闭并丢弃，严禁脏连接回池。
    private async bool Cleanup(FirebirdConnection c) {
        bool restored = false;
        string why = "";
        try {
            restored = await c.RollbackAsync();
            if (!restored) { why = c.lastError; }
        } catch (Exception ex) {
            // Release is fire-and-forget: retain a diagnostic and evict on throw.
            why = ex.Message;
        }
        if (!restored) {
            Console.WriteLine("[firebirdpool] cleanup failed: "
                + (why.Length > 0 ? why : "rollback or replacement transaction failed"));
        }
        if (!restored || this.core.IsClosed() || !c.IsConnected()) {
            this.CloseAndDrop(c);
            return true;
        }
        if (!this.core.Pool(c)) { c.Close(); }
        return true;
    }

    private void CloseAndDrop(FirebirdConnection c) {
        try { c.Close(); }
        finally { this.core.Drop(c); }
    }

    // 空闲（已入池、可立即使用）连接数。
    public int IdleCount() {
        return this.core.IdleCount();
    }

    // 存活连接总数（空闲 + 已借出）。
    public int LiveCount() {
        return this.core.LiveCount();
    }

    // 当前挂起等待连接的协程数。
    public int WaitingCount() {
        return this.core.WaitingCount();
    }

    // 最大并发存活连接数。
    public int MaxSize() {
        return this.core.MaxSize();
    }

    // <see cref="Close"/> 调用过后为 true。
    public bool IsClosed() {
        return this.core.IsClosed();
    }

    // 池的 provider id（恒为 <see cref="DbProvider.Firebird"/>）。
    public int GetProvider() {
        return DbProvider.Firebird;
    }

    // 关闭所有空闲连接并将连接池标记为已关闭。仍被
    // 借出的连接在归还时才会被关闭。
    public void Close() {
        this.core.MarkClosed();
        try {
            FirebirdConnection c = this.core.TakeClosing();
            while (c != null) {
                try { this.CloseAndDrop(c); }
                catch (Exception error) {
                    // Preserve the first cleanup error and its concrete type.
                    this.DrainAfterFailure();
                    throw;
                }
                c = this.core.TakeClosing();
            }
        } finally { this.core.WakeAll(); }
    }

    private void DrainAfterFailure() {
        FirebirdConnection c = this.core.TakeClosing();
        while (c != null) {
            try { this.CloseAndDrop(c); }
            catch (Exception secondary) {
                // Close is already preserving the first cleanup exception.
            }
            c = this.core.TakeClosing();
        }
    }

    public void Dispose() {
        this.Close();
    }
}
