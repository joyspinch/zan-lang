using System;
using System.Collections.Generic;
using System.Data;

namespace System.Data.Firebird;

public partial class FirebirdConnection : IDbConnection {
    // 事务

    // 以 WRITE / WAIT / READ COMMITTED（REC_VERSION）开启新事务。
    async bool beginTransaction() {
        FbBuf tpb = new FbBuf();
        tpb.U8(FbOp.TPB_VERSION3);
        tpb.U8(FbOp.TPB_WRITE);
        tpb.U8(FbOp.TPB_WAIT);
        tpb.U8(FbOp.TPB_READ_COMMITTED);
        tpb.U8(FbOp.TPB_REC_VERSION);

        FbBuf p = new FbBuf();
        p.Int(FbOp.TRANSACTION);
        p.Int(this.dbHandle);
        FbBytes t = tpb.ToBytes();
        p.Block(t);
        t.Release();
        FbResponse resp = await this.roundTrip(p.ToBytes());
        if (resp == null) { return false; }
        if (resp.Failed()) {
            resp.Release();
            return false;
        }
        this.transHandle = resp.Handle();
        resp.Release();
        return true;
    }

    // 提交但不放弃事务句柄：在显式事务之外执行的语句
    // 都以此方式提交，这正是
    // 连接像自动提交一样工作的原因。
    async bool commitRetaining() {
        FbBuf p = new FbBuf();
        p.Int(FbOp.COMMIT_RETAINING);
        p.Int(this.transHandle);
        FbResponse resp = await this.roundTrip(p.ToBytes());
        if (resp == null) { return false; }
        bool ok = !resp.Failed();
        resp.Release();
        return ok;
    }

    public static DbException Sync() {
        return new DbException("FirebirdConnection is asynchronous: use QueryAsync/ExecuteAsync", 0, DbProvider.Firebird);
    }

    public DbResult Query(string sql) { throw FirebirdConnection.Sync(); }
    public DbResult Query(string sql, DbParams prms) { throw FirebirdConnection.Sync(); }
    public int Execute(string sql) { throw FirebirdConnection.Sync(); }
    public int Execute(string sql, DbParams prms) { throw FirebirdConnection.Sync(); }
    public string ExecuteScalar(string sql) { throw FirebirdConnection.Sync(); }
    public string ExecuteScalar(string sql, DbParams prms) { throw FirebirdConnection.Sync(); }

    public void BeginTransaction() { throw FirebirdConnection.Sync(); }
    public void Commit() { throw FirebirdConnection.Sync(); }
    public void Rollback() { throw FirebirdConnection.Sync(); }

    public async bool BeginTransactionAsync() {
        bool ok = await this.beginTransaction();
        if (ok) { this.inTxn = true; }
        return ok;
    }

    // 提交当前事务并开启新事务。内部通过 AsyncGate 门控保证单连接事务互斥，杜绝并发调用数据串号。
    public async bool CommitAsync() {
        await this.AcquireLock();
        try {
            if (!this.connected) { return false; }
            FbBuf p = new FbBuf();
            p.Int(FbOp.COMMIT);
            p.Int(this.transHandle);
            FbResponse resp = await this.roundTrip(p.ToBytes());
            if (resp == null) { return false; }
            bool ok = !resp.Failed();
            resp.Release();
            this.transHandle = 0 - 1;
            if (!ok) { return false; }
            // 提交已落地，未收尾写清零（随后的 beginTransaction 是驱动
            // 基线的空事务，不携带用户写入）。
            this.inTxn = false;
            return await this.beginTransaction();
        } finally {
            this.ReleaseLock();
        }
    }

    // 回滚当前事务并开启新事务。内部通过 AsyncGate 门控保证单连接事务互斥，杜绝并发调用数据串号。
    public async bool RollbackAsync() {
        await this.AcquireLock();
        try {
            if (!this.connected) { return false; }
            FbBuf p = new FbBuf();
            p.Int(FbOp.ROLLBACK);
            p.Int(this.transHandle);
            FbResponse resp = await this.roundTrip(p.ToBytes());
            if (resp == null) { return false; }
            bool ok = !resp.Failed();
            resp.Release();
            this.transHandle = 0 - 1;
            if (!ok) { return false; }
            // 回滚已落地，未收尾写清零（随后的 beginTransaction 是驱动
            // 基线的空事务，不携带用户写入）。
            this.inTxn = false;
            return await this.beginTransaction();
        } finally {
            this.ReleaseLock();
        }
    }

    // 语句

    // 分配语句句柄；失败返回 -1。
    async int allocStatement() {
        FbBuf p = new FbBuf();
        p.Int(FbOp.ALLOCATE_STATEMENT);
        p.Int(this.dbHandle);
        FbResponse resp = await this.roundTrip(p.ToBytes());
        if (resp == null) { return 0 - 1; }
        if (resp.Failed()) {
            resp.Release();
            return 0 - 1;
        }
        int h = resp.Handle();
        resp.Release();
        return h;
    }

    // prepare 请求的 describe 条目：先是语句类型，
    // 再是每个输出列的布局。
    static FbBytes describeItems() {
        FbBuf b = new FbBuf();
        b.U8(FbType.INFO_STMT_TYPE);
        b.U8(FbType.INFO_SELECT);
        b.U8(FbType.INFO_DESCRIBE_VARS);
        b.U8(FbType.INFO_SQLDA_SEQ);
        b.U8(FbType.INFO_TYPE);
        b.U8(FbType.INFO_SUB_TYPE);
        b.U8(FbType.INFO_SCALE);
        b.U8(FbType.INFO_LENGTH);
        b.U8(FbType.INFO_NULL_IND);
        b.U8(FbType.INFO_FIELD);
        b.U8(FbType.INFO_RELATION);
        b.U8(FbType.INFO_OWNER);
        b.U8(FbType.INFO_ALIAS);
        b.U8(FbType.INFO_DESCRIBE_END);
        return b.ToBytes();
    }

    // prepare 语句并解析输出描述（XSQLDA）；描述超出单个缓冲区时
    // 按 INFO_SQLDA_START 从服务器停下的列继续读取，失败返回 null。
    async FbXsqlda prepare(int stmt, string sql) {
        FbBuf p = new FbBuf();
        p.Int(FbOp.PREPARE_STATEMENT);
        p.Int(this.transHandle);
        p.Int(stmt);
        p.Int(3);  // SQL 方言
        p.Str(sql);
        FbBytes items = FirebirdConnection.describeItems();
        p.Block(items);
        items.Release();
        p.Int(FirebirdConnection.INFO_BUFFER);
        FbResponse resp = await this.roundTrip(p.ToBytes());
        if (resp == null) { return null; }
        if (resp.Failed()) {
            resp.Release();
            return null;
        }
        FbXsqlda xs = new FbXsqlda();
        int next = xs.Parse(resp.Buf());
        resp.Release();
        if (next == 0 - 2) {
            this.lastError = "malformed statement description";
            return null;
        }
        // 超出单个缓冲区的描述会被截断返回；从服务器
        // 停下的列开始请求剩余部分。
        while (next > 0) {
            FbBuf q = new FbBuf();
            q.Int(FbOp.INFO_SQL);
            q.Int(stmt);
            q.Int(0);
            FbBuf items2 = new FbBuf();
            items2.U8(FbType.INFO_SQLDA_START);
            items2.U8(2);
            items2.U8(next & 255);
            items2.U8((next >> 8) & 255);
            items2.U8(FbType.INFO_SELECT);
            items2.U8(FbType.INFO_DESCRIBE_VARS);
            items2.U8(FbType.INFO_SQLDA_SEQ);
            items2.U8(FbType.INFO_TYPE);
            items2.U8(FbType.INFO_SUB_TYPE);
            items2.U8(FbType.INFO_SCALE);
            items2.U8(FbType.INFO_LENGTH);
            items2.U8(FbType.INFO_NULL_IND);
            items2.U8(FbType.INFO_FIELD);
            items2.U8(FbType.INFO_RELATION);
            items2.U8(FbType.INFO_OWNER);
            items2.U8(FbType.INFO_ALIAS);
            items2.U8(FbType.INFO_DESCRIBE_END);
            FbBytes i2 = items2.ToBytes();
            q.Block(i2);
            i2.Release();
            q.Int(FirebirdConnection.INFO_BUFFER);
            FbResponse more = await this.roundTrip(q.ToBytes());
            if (more == null) { return null; }
            if (more.Failed()) {
                more.Release();
                return null;
            }
            int again = xs.Parse(more.Buf());
            more.Release();
            if (again == next) {
                this.lastError = "the server keeps truncating the description";
                return null;
            }
            next = again;
        }
        return xs;
    }

    // 执行语句：无参数走空 BLR；有参数经 FbValue.Params 编码
    // BLR 与绑定值后随 op_execute 发送。
    async bool execute(int stmt, DbParams prms) {
        FbParamBlock pb = FbValue.Params(prms);
        FbBuf p = new FbBuf();
        p.Int(FbOp.EXECUTE);
        p.Int(stmt);
        p.Int(this.transHandle);
        int count = 0;
        if (prms != null) { count = prms.Count(); }
        if (count == 0) {
            FbBytes none = FbBytes.Empty();
            p.Block(none);
            none.Release();
            p.Int(0);
            p.Int(0);
        } else {
            p.Block(pb.Blr());
            p.Int(0);
            p.Int(1);
            p.RawBlock(pb.Values());
        }
        pb.Release();
        FbResponse resp = await this.roundTrip(p.ToBytes());
        if (resp == null) { return false; }
        bool ok = !resp.Failed();
        resp.Release();
        return ok;
    }

    // 释放（DSQL_DROP）语句句柄。
    async bool freeStatement(int stmt) {
        FbBuf p = new FbBuf();
        p.Int(FbOp.FREE_STATEMENT);
        p.Int(stmt);
        p.Int(FbOp.DSQL_DROP);
        FbResponse resp = await this.roundTrip(p.ToBytes());
        if (resp == null) { return false; }
        bool ok = !resp.Failed();
        resp.Release();
        return ok;
    }

    // 读取上一条语句产生的行计数器。
    async int affectedRows(int stmt, bool select) {
        FbBuf p = new FbBuf();
        p.Int(FbOp.INFO_SQL);
        p.Int(stmt);
        p.Int(0);
        FbBytes items = FbBytes.Alloc(1);
        items.SetAt(0, FbType.INFO_RECORDS);
        p.Block(items);
        items.Release();
        p.Int(FirebirdConnection.INFO_BUFFER);
        FbResponse resp = await this.roundTrip(p.ToBytes());
        if (resp == null) { return 0; }
        if (resp.Failed()) {
            resp.Release();
            return 0;
        }
        int total = 0;
        FbReader r = FbReader.Over(resp.Buf());
        if (r.U8() == FbType.INFO_RECORDS) {
            r.U16LE();  // 计数器组的长度
            bool more = true;
            while (more && r.Left() > 0) {
                int item = r.U8();
                if (item == FbType.INFO_END) {
                    more = false;
                } else {
                    int ln = r.U16LE();
                    int v = r.IntLE(ln);
                    if (select) {
                        if (item == FbType.REQ_SELECT_COUNT) { total = v; }
                    } else if (item == FbType.REQ_INSERT_COUNT
                            || item == FbType.REQ_UPDATE_COUNT
                            || item == FbType.REQ_DELETE_COUNT) {
                        total = total + v;
                    }
                }
            }
        }
        resp.Release();
        return total;
    }

    // 取数

    // 从线缆读取一个值，遵循每字段
    // 补齐到的 4 字节对齐。
    async FbBytes fetchValue(FbColumn col) {
        int n = col.IoLength();
        if (n < 0) {
            n = await this.recvInt();
            if (n < 0) { return null; }
        }
        return await this.recvAligned(n);
    }

    // 拉取打开游标的每一行。BLOB 列先收集
    // 稍后再解析，因为其载荷需要单独的往返，
    // 且不能与取数流交错。
    async DbResult fetchAll(int stmt, FbXsqlda xs) {
        DbResult res = new DbResult();
        int cols = xs.Count();
        res.SetColumnCount(cols);
        for (int c = 0; c < cols; c = c + 1) {
            res.AddColumnName(xs.At(c).Name());
        }
        List<FbRow> rows = new List<FbRow>();
        List<FbBlobRef> blobs = new List<FbBlobRef>();
        FbBytes blr = xs.CalcBlr();
        int nullBytes = cols / 8;
        if ((cols % 8) != 0) { nullBytes = nullBytes + 1; }

        bool more = true;
        while (more) {
            FbBuf p = new FbBuf();
            p.Int(FbOp.FETCH);
            p.Int(stmt);
            p.Block(blr);
            p.Int(0);
            p.Int(FirebirdConnection.FETCH_ROWS);
            bool sent = await this.sendPacket(p.ToBytes());
            if (!sent) {
                blr.Release();
                return res;
            }
            int op = await this.recvInt();
            while (op == FbOp.DUMMY) {
                op = await this.recvInt();
            }
            if (op == FbOp.RESPONSE) {
                FbResponse r = await this.recvResponse4();
                if (r != null) {
                    if (r.Failed()) { this.lastError = r.Err().Message(); }
                    r.Release();
                }
                blr.Release();
                return res;
            }
            if (op != FbOp.FETCH_RESPONSE) {
                this.lastError = "unexpected fetch response "
                    + Convert.ToString(op);
                this.connected = false;
                blr.Release();
                return res;
            }
            int status = await this.recvInt();
            int count = await this.recvInt();
            while (count != 0) {
                FbBytes flags = await this.recvAligned(nullBytes);
                if (flags == null) {
                    blr.Release();
                    return res;
                }
                FbRow row = new FbRow(cols);
                for (int i = 0; i < cols; i = i + 1) {
                    bool isNull = ((flags.At(i / 8) >> (i % 8)) & 1) != 0;
                    if (!isNull) {
                        FbColumn col = xs.At(i);
                        FbBytes raw = await this.fetchValue(col);
                        if (raw == null) {
                            flags.Release();
                            blr.Release();
                            return res;
                        }
                        if (col.SqlType() == FbType.BLOB) {
                            blobs.Add(FbBlobRef.Of(row, i, raw, col.SubType()));
                            row.Set(i, "");
                        } else {
                            row.Set(i, FbValue.Decode(col, raw));
                            raw.Release();
                        }
                    }
                }
                flags.Release();
                rows.Add(row);
                op = await this.recvInt();
                status = await this.recvInt();
                count = await this.recvInt();
            }
            if (status == 100) { more = false; }
        }
        blr.Release();

        for (int b = 0; b < blobs.Count; b = b + 1) {
            FbBlobRef br = blobs[b];
            string text = await this.readBlob(br.id, br.subtype);
            br.row.Set(br.col, text);
            br.id.Release();
        }

        for (int k = 0; k < rows.Count; k = k + 1) {
            List<bool> n = rows[k].Nulls();
            bool hasNull = false;
            if (n != null) {
                for (int ni = 0; ni < n.Count; ni = ni + 1) {
                    if (n[ni]) { hasNull = true; break; }
                }
            }
            if (hasNull) {
                res.AddRowNulls(rows[k].Values(), n);
            } else {
                res.AddRow(rows[k].Values());
            }
        }
        return res;
    }

    // 完整读取 BLOB。子类型 1 为文本，按文本返回；
    // 其余为二进制，以十六进制渲染，而非在
    // 首个零字节处截断。
    async string readBlob(FbBytes blobId, int subtype) {
        FbBuf p = new FbBuf();
        p.Int(FbOp.OPEN_BLOB2);
        p.Int(0);
        p.Int(this.transHandle);
        p.RawBlock(blobId);
        FbResponse open = await this.roundTrip(p.ToBytes());
        if (open == null) { return ""; }
        if (open.Failed()) {
            open.Release();
            return "";
        }
        int h = open.Handle();
        open.Release();

        FbBuf all = new FbBuf();
        bool more = true;
        while (more) {
            FbBuf g = new FbBuf();
            g.Int(FbOp.GET_SEGMENT);
            g.Int(h);
            g.Int(FirebirdConnection.INFO_BUFFER);
            g.Int(0);
            FbResponse seg = await this.roundTrip(g.ToBytes());
            if (seg == null) { return ""; }
            if (seg.Failed()) {
                seg.Release();
                more = false;
            } else {
                FbReader r = FbReader.Over(seg.Buf());
                while (r.Left() >= 2) {
                    int ln = r.U16LE();
                    FbBytes part = r.Raw(ln);
                    all.RawBlock(part);
                    part.Release();
                }
                if (seg.Handle() == 2) { more = false; }
                seg.Release();
            }
        }

        FbBuf cl = new FbBuf();
        cl.Int(FbOp.CLOSE_BLOB);
        cl.Int(h);
        FbResponse close = await this.roundTrip(cl.ToBytes());
        if (close != null) { close.Release(); }

        FbBytes data = all.ToBytes();
        string outp;
        if (subtype == 1) {
            outp = FbReader.Over(data).Text(data.Len());
        } else {
            outp = "0x" + data.Hex();
        }
        data.Release();
        return outp;
    }

    // 协程查询 API

    // 运行语句并返回其行（不产生行的语句
    // 返回空）。语句失败时抛出 <see cref="DbException"/>，
    // 因此空结果总是表示“无行”而绝非“未执行”；
    // <see cref="GetError"/> 和 <see cref="SqlCode"/> 仍携带
    // 上次失败信息，供调用方自行检查。
    public async DbResult QueryAsync(string sql) {
        return await this.QueryAsync(sql, null);
    }

    // 运行带参数的语句。占位符是协议
    // 自身的位置占位符，因此值采用绑定而非拼入
    // SQL 文本。内部通过 AsyncGate 门控保证单连接事务互斥，杜绝并发调用数据串号。
    public async DbResult QueryAsync(string sql, DbParams prms) {
        await this.AcquireLock();
        try {
            this.lastError = "";
            this.lastStatus = new FbError();
            if (!this.connected) {
                this.lastError = "not connected";
                this.fail();
            }
            int stmt = await this.allocStatement();
            if (stmt < 0) { this.fail(); }
            FbXsqlda xs = await this.prepare(stmt, sql);
            if (xs == null) {
                await this.freeStatement(stmt);
                this.fail();
            }
            if (xs.StmtType() == FbType.STMT_EXEC_PROCEDURE && xs.Count() > 0) {
                // 带输出参数的过程以 op_sql_response 应答，
                // 而非游标；应据此判断，避免误读数据流。
                await this.freeStatement(stmt);
                this.lastError = "EXECUTE PROCEDURE with output parameters is not"
                    + " supported; select from the procedure instead";
                this.fail();
            }
            bool ok = await this.execute(stmt, prms);
            if (!ok) {
                await this.freeStatement(stmt);
                this.fail();
            }
            DbResult res = DbResult.Empty();
            if (xs.IsSelect() && xs.Count() > 0) {
                res = await this.fetchAll(stmt, xs);
                this.lastAffected = res.RowCount();
            } else {
                this.lastAffected = await this.affectedRows(stmt, false);
            }
            await this.freeStatement(stmt);
            if (!xs.IsSelect()) {
                await this.commitRetaining();
            }
            return res;
        } finally {
            this.ReleaseLock();
        }
    }

    // 运行语句并返回其影响的行数。语句
    // 失败时抛出 <see cref="DbException"/>。
    public async int ExecuteAsync(string sql) {
        return await this.ExecuteAsync(sql, null);
    }

    // ExecuteAsync 的带参数版本。
    public async int ExecuteAsync(string sql, DbParams prms) {
        DbResult r = await this.QueryAsync(sql, prms);
        if (this.lastError.Length > 0) { this.fail(); }
        return this.lastAffected;
    }

    // 抛出记录的失败，让调用方看到服务器的
    // 原始措辞和 SQL 码，而不是空结果。
    void fail() {
        string why = this.lastError;
        if (why.Length == 0) {
            why = "the statement failed";
        }
        throw new DbException(why, this.lastStatus.SqlCode(),
                              DbProvider.Firebird);
    }

    // 第一行第一列的值，无行时返回 ""。
    public async string ExecuteScalarAsync(string sql) {
        DbResult r = await this.QueryAsync(sql, null);
        if (r.RowCount() == 0) { return ""; }
        return r.GetString(0, 0);
    }

    // ExecuteScalarAsync 的带参数版本。
    public async string ExecuteScalarAsync(string sql, DbParams prms) {
        DbResult r = await this.QueryAsync(sql, prms);
        if (r.RowCount() == 0) { return ""; }
        return r.GetString(0, 0);
    }

    // 用于验证会话仍可用的往返。内部通过 AsyncGate 门控保证单连接事务互斥。
    public async bool PingAsync() {
        await this.AcquireLock();
        try {
            if (!this.connected) { return false; }
            FbBuf p = new FbBuf();
            p.Int(FbOp.PING);
            FbResponse resp = await this.roundTrip(p.ToBytes());
            if (resp == null) { return false; }
            bool ok = !resp.Failed();
            resp.Release();
            return ok;
        } finally {
            this.ReleaseLock();
        }
    }

    // 状态

    // 上一条语句影响的行数。
    public int AffectedRows() { return this.lastAffected; }

    // 上次失败的描述，没有则为 ""。
    public string GetError() { return this.lastError; }

    // 上次失败的 Firebird SQL 码（无失败时为 0）。
    public int SqlCode() { return this.lastStatus.SqlCode(); }

    // 服务器选择的认证插件。
    public string AuthPlugin() { return this.plugin; }

    // 当前线路加密方式，会话未加密时为 ""。
    public string WireCrypt() { return this.cryptPlugin; }

    // 服务器接受的协议版本。
    public int ProtocolVersion() { return this.acceptVersion; }

    // 本会话附加到的数据库。
    public string Database() { return this.database; }

    // 连接是否仍打开。
    public bool IsConnected() { return this.connected; }

    // 驱动标识，恒为 <see cref="DbProvider.Firebird"/>。
    public int GetProvider() { return DbProvider.Firebird; }

    // 礼貌地分离（回滚打开的事务），然后
    // 关闭套接字。
    public async void CloseAsync() {
        if (this.connected && this.transHandle >= 0) {
            FbBuf p = new FbBuf();
            p.Int(FbOp.ROLLBACK);
            p.Int(this.transHandle);
            FbResponse r = await this.roundTrip(p.ToBytes());
            if (r != null) { r.Release(); }
            this.transHandle = 0 - 1;
        }
        if (this.connected && this.dbHandle >= 0) {
            FbBuf p = new FbBuf();
            p.Int(FbOp.DETACH);
            p.Int(this.dbHandle);
            FbResponse r = await this.roundTrip(p.ToBytes());
            if (r != null) { r.Release(); }
            this.dbHandle = 0 - 1;
        }
        this.Close();
    }

    // 不经分离往返直接丢弃连接。安全释放互斥门控并唤醒所有等待者。
    public void Close() {
        while (this.waiters != null && this.waiters.Count > 0) {
            AsyncGate g = this.waiters[0];
            this.waiters.RemoveAt(0);
            g.Signal();
        }
        this.busy = false;
        if (this.sock >= 0) {
            Socket.Close(this.sock);
            this.sock = 0 - 1;
        }
        this.connected = false;
        this.encIn = null;
        this.encOut = null;
        if (this.authData != null) {
            this.authData.Release();
            this.authData = null;
        }
    }

    public void Dispose() {
        this.Close();
    }

}
