using System;
using System.Collections.Generic;

namespace System.Data.Firebird;

// 构建中的行：单元格强类型实体列表。
public class FbRow {
    public List<FbCell> cells;

    // 构造 n 格、默认全 NULL 的行。
    public FbRow(int n) {
        this.cells = new List<FbCell>();
        for (int i = 0; i < n; i = i + 1) {
            this.cells.Add(new FbCell("", true));
        }
    }

    // 写入第 i 格并清除其 NULL 标志。
    public void Set(int i, string v) {
        if (i >= 0 && i < this.cells.Count) {
            this.cells[i].value = v != null ? v : "";
            this.cells[i].isNull = false;
        }
    }

    // 指定格是否为 NULL。
    public bool IsNull(int i) {
        if (i >= 0 && i < this.cells.Count) { return this.cells[i].isNull; }
        return true;
    }

    // 指定格文本。
    public string ValueAt(int i) {
        if (i >= 0 && i < this.cells.Count) { return this.cells[i].value; }
        return "";
    }

    // 各格文本投影（用于适配 DbResult 输入）。
    public List<string> Values() {
        List<string> vs = new List<string>();
        for (int i = 0; i < this.cells.Count; i = i + 1) {
            vs.Add(this.cells[i].value);
        }
        return vs;
    }

    // 各格 NULL 标志投影（用于适配 DbResult 输入）。
    public List<bool> Nulls() {
        List<bool> ns = new List<bool>();
        for (int i = 0; i < this.cells.Count; i = i + 1) {
            ns.Add(this.cells[i].isNull);
        }
        return ns;
    }
}
