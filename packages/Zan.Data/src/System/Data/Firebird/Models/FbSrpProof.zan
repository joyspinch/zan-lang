using System;

namespace System.Data.Firebird;

// SRP 握手的客户端证明及双方协商出的会话密钥
// （该密钥同时用作线路加密密钥）。
public class FbSrpProof {
    public FbBytes proof;
    public FbBytes key;

    // 构造；统一经 <see cref="Of"/> 创建。
    public FbSrpProof(FbBytes proof, FbBytes key) {
        this.proof = proof;
        this.key = key;
    }

    // 组装证明与密钥。
    public static FbSrpProof Of(FbBytes proof, FbBytes key) {
        return new FbSrpProof(proof, key);
    }

    // 客户端证明 M。
    public FbBytes Proof() { return this.proof; }
    // 会话密钥 K（同时用作线路加密密钥）。
    public FbBytes Key() { return this.key; }
}
