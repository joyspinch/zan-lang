using System;

namespace System.Data.Firebird;

// 带长度的字节块。Zan 字符串在首个 NUL 处截断，而线缆
// 协议中充满零字节（每个整数都是 4 字节大端），因此
// 二进制数据必须携带显式长度。
public class FbBytes {
    public byte[] data;
    public int len;

    // 构造；或经 <see cref="Own"/>/<see cref="Of"/>/<see cref="Alloc"/> 创建。
    public FbBytes(byte[] data, int len) {
        this.data = data;
        this.len = len;
    }

    // 将现有缓冲区连同其长度封装起来。
    public static FbBytes Own(byte[] data, int len) {
        return new FbBytes(data, len);
    }

    // 从调用方仍持有的缓冲区中复制 <paramref name="len"/> 字节
    // （例如托管 <c>byte[]</c> 摘要）。
    public static FbBytes CopyOf(string src, int len) {
        FbBytes b = FbBytes.Alloc(len);
        for (int i = 0; i < len; i = i + 1) {
            b.SetAt(i, src[i] & 255);
        }
        return b;
    }

    // 将 Zan 字符串的字节复制到带长度的块中。
    public static FbBytes Of(string s) {
        int n = s.Length;
        byte[] t = new byte[n + 1];
        for (int i = 0; i < n; i = i + 1) {
            t[i] = (byte)(s[i] & 255);
        }
        return new FbBytes(t, n);
    }

    // 分配 n 字节的零填充块。
    public static FbBytes Alloc(int n) {
        if (n < 0) { n = 0; }
        return new FbBytes(new byte[n + 1], n);
    }

    // 长度为 0 的空块。
    public static FbBytes Empty() {
        return FbBytes.Alloc(0);
    }

    // 底层缓冲区（自带 NUL 终止，内容按长度解读）。
    public byte[] Data() { return this.data; }
    // 有效字节数。
    public int Len() { return this.len; }
    // 下标 i 处的字节。
    public int At(int i) { return this.data[i] & 255; }
    // 覆写下标 i 处的字节。
    public void SetAt(int i, int v) { this.data[i] = (byte)(v & 255); }

    // 字节作为文本，止于首个 NUL。
    public string Text() {
        int n = 0;
        for (; n < this.len && (this.data[n] & 255) != 0; n = n + 1) {
        }
        return this.data.ToStr(0, n);
    }

    // 从 <paramref name="off"/> 起复制
    // <paramref name="n"/> 字节。
    public FbBytes Slice(int off, int n) {
        if (off < 0) { off = 0; }
        if (off + n > this.len) { n = this.len - off; }
        FbBytes b = FbBytes.Alloc(n);
        for (int i = 0; i < n; i = i + 1) {
            b.SetAt(i, this.data[off + i] & 255);
        }
        return b;
    }

    // 整块的小写十六进制。
    public string Hex() {
        int n = this.len;
        if (n == 0) { return ""; }
        byte[] buf = new byte[n * 2];
        int p = 0;
        for (int i = 0; i < n; i = i + 1) {
            int v = this.data[i] & 255;
            int hi = (v >> 4) & 15;
            int lo = v & 15;
            buf[p] = (byte)(hi < 10 ? hi + 48 : hi + 87);
            buf[p + 1] = (byte)(lo < 10 ? lo + 48 : lo + 87);
            p = p + 2;
        }
        return buf.ToStr(0, n * 2);
    }

    // 将十六进制字符串解码为带长度的块。
    public static FbBytes FromHex(string hex) {
        int n = hex.Length / 2;
        FbBytes b = FbBytes.Alloc(n);
        for (int i = 0; i < n; i = i + 1) {
            b.SetAt(i, (FbBytes.nibble(hex[2 * i] & 255) << 4)
                       | FbBytes.nibble(hex[2 * i + 1] & 255));
        }
        return b;
    }

    // 十六进制字符转半字节（0-9/a-f/A-F；其余为 0）。
    public static int nibble(int c) {
        if (c >= 48 && c <= 57) { return c - 48; }
        if (c >= 97 && c <= 102) { return c - 87; }
        if (c >= 65 && c <= 70) { return c - 55; }
        return 0;
    }

    // 丢弃缓冲区以便立即回收。
    public void Release() {
        this.data = null;
        this.len = 0;
    }
}
