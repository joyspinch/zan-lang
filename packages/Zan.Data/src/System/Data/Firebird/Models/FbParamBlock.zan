using System;
using System.Data;

namespace System.Data.Firebird;

// 按 <c>op_execute</c> 所需方式编码的输入参数：
// 一条描述取值的 BLR 消息，以及取值本身。
public class FbParamBlock {
    public FbBytes blr;
    public FbBytes values;

    // 构造；统一经 <see cref="Of"/> 创建。
    public FbParamBlock(FbBytes blr, FbBytes values) {
        this.blr = blr;
        this.values = values;
    }

    // 组装 BLR 消息与取值块。
    public static FbParamBlock Of(FbBytes blr, FbBytes values) {
        return new FbParamBlock(blr, values);
    }

    // 描述取值的 BLR 消息。
    public FbBytes Blr() { return this.blr; }
    // 取值本身（前缀 NULL 位图）。
    public FbBytes Values() { return this.values; }

    // 释放两块缓冲区。
    public void Release() {
        this.blr.Release();
        this.values.Release();
    }
}
