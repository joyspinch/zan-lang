using System;

namespace System.Data.Firebird;

// Firebird 结果行单元格实体（消除 values / nulls 平行列表反模式）。
public class FbCell {
    public string value;
    public bool isNull;

    public FbCell(string value, bool isNull) {
        this.value = value != null ? value : "";
        this.isNull = isNull;
    }
}
