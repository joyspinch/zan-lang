using System;

namespace System.Data.Firebird;

// 载荷仍需另行取回的 BLOB 列。
public class FbBlobRef {
    public FbRow row;
    public int col;
    public FbBytes id;
    public int subtype;

    // 记录目标行、列号、BLOB id 与子类型。
    public FbBlobRef(FbRow row, int col, FbBytes id, int subtype) {
        this.row = row;
        this.col = col;
        this.id = id;
        this.subtype = subtype;
    }

    // 构造 <see cref="FbBlobRef"/>。
    public static FbBlobRef Of(FbRow row, int col, FbBytes id, int subtype) {
        return new FbBlobRef(row, col, id, subtype);
    }
}
