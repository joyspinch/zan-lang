using System;

namespace System.Data.Firebird;

// 载荷仍需另行取回的 BLOB 列。
class FbBlobRef {
    FbRow row;
    int col;
    FbBytes id;
    int subtype;

    // 记录目标行、列号、BLOB id 与子类型。
    FbBlobRef(FbRow row, int col, FbBytes id, int subtype) {
        this.row = row;
        this.col = col;
        this.id = id;
        this.subtype = subtype;
    }

    // 构造 <see cref="FbBlobRef"/>。
    static FbBlobRef Of(FbRow row, int col, FbBytes id, int subtype) {
        return new FbBlobRef(row, col, id, subtype);
    }
}
