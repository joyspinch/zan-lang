using System;
using System.Collections.Generic;

namespace System.Data.Firebird;

// ARC4 密钥流（Firebird 3+ 线路加密；发送与接收方向各需独立实例）。
public class FbArc4 {
    private byte[] s;
    public int x;
    public int y;

    // 由会话密钥构建（K = SHA1(S)，见 FbSrp.Prove）。
    public FbArc4(FbBytes key) {
        byte[] s = new byte[256];
        for (int i = 0; i < 256; i = i + 1) {
            s[i] = (byte)i;
        }
        int j = 0;
        int klen = key.Len();
        for (int i = 0; i < 256; i = i + 1) {
            j = (j + (s[i] & 255) + key.At(i % klen)) & 255;
            byte t = s[i];
            s[i] = s[j];
            s[j] = t;
        }
        this.s = s;
        this.x = 0;
        this.y = 0;
    }

    // 就地异或缓冲区中从 off 起 len 字节（加密与解密相同）。
    public void Translate(string buf, int off, int len) {
        byte[] st = this.s;
        int sx = this.x;
        int sy = this.y;
        for (int i = 0; i < len; i = i + 1) {
            sx = (sx + 1) & 255;
            sy = (sy + (st[sx] & 255)) & 255;
            byte t = st[sx];
            st[sx] = st[sy];
            st[sy] = t;
            int k = st[((st[sx] & 255) + (st[sy] & 255)) & 255] & 255;
            buf[off + i] = (buf[off + i] & 255) ^ k;
        }
        this.x = sx;
        this.y = sy;
    }
}
