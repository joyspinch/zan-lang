using System;
using System.Collections.Generic;

namespace System.Data.Firebird;

// ARC4 密钥流（Firebird 3+ 线路加密；发送与接收方向各需独立实例）。
public class FbArc4 {
    public List<int> s;
    public int x;
    public int y;

    // 由会话密钥构建（K = SHA1(S)，见 FbSrp.Prove）。
    public FbArc4(FbBytes key) {
        List<int> s = new List<int>();
        for (int i = 0; i < 256; i = i + 1) {
            s.Add(i);
        }
        int j = 0;
        for (int i = 0; i < 256; i = i + 1) {
            j = (j + s[i] + key.At(i % key.Len())) % 256;
            int t = s[i];
            s[i] = s[j];
            s[j] = t;
        }
        this.s = s;
        this.x = 0;
        this.y = 0;
    }

    // 就地异或缓冲区中从 off 起 len 字节（加密与解密相同）。
    public void Translate(string buf, int off, int len) {
        for (int i = 0; i < len; i = i + 1) {
            this.x = (this.x + 1) % 256;
            this.y = (this.y + this.s[this.x]) % 256;
            int t = this.s[this.x];
            this.s[this.x] = this.s[this.y];
            this.s[this.y] = t;
            int k = this.s[(this.s[this.x] + this.s[this.y]) % 256];
            buf[off + i] = (buf[off + i] & 255) ^ k;
        }
    }
}
