using System;
using System.Data;

namespace System.Data.Firebird;

// 预编译语句输出行中的一列。
public class FbColumn {
    public int sqltype;
    public int subtype;
    public int scale;
    public int sqllen;
    public bool nullOk;
    public string field;
    public string relation;
    public string owner;
    public string alias;

    // 空列描述，经 describe 解析或 <see cref="Of"/> 填充。
    public FbColumn() {
        this.sqltype = 0;
        this.subtype = 0;
        this.scale = 0;
        this.sqllen = 0;
        this.nullOk = false;
        this.field = "";
        this.relation = "";
        this.owner = "";
        this.alias = "";
    }

    // 已知形状的列，用于在缺少 describe 缓冲区时
    // 解码某个值。
    public static FbColumn Of(int sqltype, int scale, int sqllen) {
        FbColumn c = new FbColumn();
        c.sqltype = sqltype;
        c.scale = scale;
        c.sqllen = sqllen;
        return c;
    }

    // Firebird SQL 类型码。
    public int SqlType() { return this.sqltype; }
    // 子类型（BLOB/数值细分）。
    public int SubType() { return this.subtype; }
    // 缩放（负值表示隐含小数位）。
    public int Scale() { return this.scale; }
    // 声明长度。
    public int Length() { return this.sqllen; }
    // 列是否可为 NULL。
    public bool NullOk() { return this.nullOk; }
    // 底层字段名。
    public string Field() { return this.field; }
    // 所属表名。
    public string Relation() { return this.relation; }

    // 结果集应展示的列名：有 SELECT 别名时
    // 用别名，否则用底层字段名。
    public string Name() {
        if (this.alias.Length > 0) { return this.alias; }
        return this.field;
    }

    // 该列在取回的行中占用的字节数，
    // 带长度前缀（VARCHAR）时为 -1。
    public int IoLength() {
        int t = this.sqltype;
        if (t == FbType.TEXT) { return this.sqllen; }
        if (t == FbType.VARYING) { return 0 - 1; }
        if (t == FbType.SHORT || t == FbType.LONG || t == FbType.FLOAT
                || t == FbType.TIME || t == FbType.DATE) { return 4; }
        if (t == FbType.DOUBLE || t == FbType.TIMESTAMP || t == FbType.BLOB
                || t == FbType.ARRAY || t == FbType.QUAD || t == FbType.INT64
                || t == FbType.DEC64 || t == FbType.TIME_TZ) { return 8; }
        if (t == FbType.INT128 || t == FbType.DEC128
                || t == FbType.DEC_FIXED) { return 16; }
        if (t == FbType.TIMESTAMP_TZ) { return 12; }
        if (t == FbType.BOOLEAN) { return 1; }
        return this.sqllen;
    }
}
