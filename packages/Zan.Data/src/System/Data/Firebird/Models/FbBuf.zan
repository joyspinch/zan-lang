using System;
using System.Collections.Generic;

namespace System.Data.Firebird;

// 协议类 XDR 帧格式的构建器：每个整数占 4 字节
// 大端，每个变长块为长度后跟数据，并
// 补齐到 4 字节边界。
public class FbBuf {
    private byte[] buf;
    private int len;

    // 分配 n 字节的零填充块（读侧解码复用）。
    public static byte[] Alloc(int n) { return new byte[n + 1]; }

    // 构造；写入方法链式累积字节。
    public FbBuf() {
        this.buf = new byte[64];
        this.len = 0;
    }

    private void Ensure(int add) {
        int need = this.len + add;
        if (need <= this.buf.Length) { return; }
        int cap = this.buf.Length * 2;
        while (cap < need) { cap = cap * 2; }
        byte[] next = new byte[cap];
        if (this.len > 0) {
            NativeMemory.Copy((nint)next, (nint)this.buf, (long)this.len);
        }
        this.buf = next;
    }

    // 当前字节数。
    public int Count() { return this.len; }
    // 下标 i 处的字节。
    public int At(int i) { return this.buf[i] & 255; }

    // 追加单字节，返回自身以链式写入。
    public FbBuf U8(int v) {
        this.Ensure(1);
        this.buf[this.len] = (byte)(v & 255);
        this.len = this.len + 1;
        return this;
    }

    // 4 字节大端整数。
    public FbBuf Int(int v) {
        this.Ensure(4);
        this.buf[this.len] = (byte)((v >> 24) & 255);
        this.buf[this.len + 1] = (byte)((v >> 16) & 255);
        this.buf[this.len + 2] = (byte)((v >> 8) & 255);
        this.buf[this.len + 3] = (byte)(v & 255);
        this.len = this.len + 4;
        return this;
    }

    // Zan 字符串的原始字节。
    public FbBuf Raw(string s) {
        if (s == null || s.Length == 0) { return this; }
        int n = s.Length;
        this.Ensure(n);
        NativeMemory.Copy((nint)this.buf + (nint)this.len, (nint)s, (long)n);
        this.len = this.len + n;
        return this;
    }

    // 带长度块的原始字节。
    public FbBuf RawBlock(FbBytes src) {
        if (src == null || src.Len() <= 0) { return this; }
        int n = src.Len();
        this.Ensure(n);
        NativeMemory.Copy((nint)this.buf + (nint)this.len, (nint)src.Data(), (long)n);
        this.len = this.len + n;
        return this;
    }

    // 补零到 4 字节边界（块尾对齐是 XDR 帧格式的要求）。
    public void Pad() {
        int rem = this.len & 3;
        if (rem == 0) { return; }
        int padN = 4 - rem;
        this.Ensure(padN);
        for (int i = 0; i < padN; i = i + 1) {
            this.buf[this.len + i] = 0;
        }
        this.len = this.len + padN;
    }

    // 带长度前缀、4 字节对齐的块。
    public FbBuf Block(FbBytes src) {
        Int(src.Len());
        RawBlock(src);
        Pad();
        return this;
    }

    // 带长度前缀、4 字节对齐的文本。
    public FbBuf Str(string s) {
        Int(s.Length);
        Raw(s);
        Pad();
        return this;
    }

    // 将缓冲区物化为带长度的块。
    public FbBytes ToBytes() {
        int n = this.len;
        byte[] t = new byte[n + 1];
        if (n > 0) {
            NativeMemory.Copy((nint)t, (nint)this.buf, (long)n);
        }
        return FbBytes.Own(t, n);
    }
}
