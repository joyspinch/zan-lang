using System;
using System.Data;

namespace System.Data.Firebird;

// 接收块的游标。
public class FbReader {
    public string buf;
    public int pos;
    public int len;

    // 构造；或经 <see cref="Over"/> 创建。
    public FbReader(string buf, int len) {
        this.buf = buf;
        this.pos = 0;
        this.len = len;
    }

    // 游标覆盖一个带长度的字节块。
    public static FbReader Over(FbBytes b) {
        return new FbReader(b.Data(), b.Len());
    }

    // 游标覆盖缓冲区前 len 字节。
    public static FbReader Over(string buf, int len) {
        return new FbReader(buf, len);
    }

    // 当前读取位置。
    public int Pos() { return this.pos; }
    // 距末尾剩余的字节数。
    public int Left() { return this.len - this.pos; }
    // 是否已读到末尾。
    public bool Eof() { return this.pos >= this.len; }
    // 向前跳过 n 字节（截停在末尾，不报错）。
    public void Skip(int n) {
        this.pos = this.pos + n;
        if (this.pos > this.len) { this.pos = this.len; }
    }

    // 读取单字节；越过末尾返回 0。
    public int U8() {
        if (this.pos >= this.len) { return 0; }
        int v = this.buf[this.pos] & 255;
        this.pos = this.pos + 1;
        return v;
    }

    // 2 字节小端整数：info 缓冲区和 clumplets
    // 在响应内为小端序，尽管帧格式本身不是。
    public int U16LE() {
        int a = U8();
        int b = U8();
        return a | (b << 8);
    }

    // <paramref name="n"/> 字节的无符号小端整数。
    public int UIntLE(int n) {
        int v = 0;
        for (int i = 0; i < n; i = i + 1) {
            v = v | (U8() << (i * 8));
        }
        return v;
    }

    // <paramref name="n"/> 字节的有符号小端整数。
    public int IntLE(int n) {
        int v = UIntLE(n);
        int bits = n * 8;
        if (bits < 64) {
            int sign = 1 << (bits - 1);
            if ((v & sign) != 0) {
                v = v - (sign << 1);
            }
        }
        return v;
    }

    // 4 字节大端整数。
    public int Int() {
        int a = U8();
        int b = U8();
        int c = U8();
        int d = U8();
        return (a << 24) | (b << 16) | (c << 8) | d;
    }

    // <paramref name="n"/> 字节的有符号大端整数。
    public int IntBE(int n) {
        int v = 0;
        for (int i = 0; i < n; i = i + 1) {
            v = (v << 8) | U8();
        }
        int bits = n * 8;
        if (bits < 64) {
            int sign = 1 << (bits - 1);
            if ((v & sign) != 0) {
                v = v - (sign << 1);
            }
        }
        return v;
    }

    // <paramref name="n"/> 字节的有符号大端整数，以
    // 64 位 long 返回（INT64/BIGINT 和 IEEE double 放不进 32 位 int）。
    public long LongBE(int n) {
        long v = 0;
        for (int i = 0; i < n; i = i + 1) {
            v = (v << 8) | U8();
        }
        int bits = n * 8;
        if (bits < 64) {
            long sign = 1;
            sign = sign << (bits - 1);
            if ((v & sign) != 0) {
                v = v - (sign << 1);
            }
        }
        return v;
    }

    // <paramref name="n"/> 个原始字节。
    public FbBytes Raw(int n) {
        if (n < 0) { n = 0; }
        if (this.pos + n > this.len) { n = this.len - this.pos; }
        FbBytes b = FbBytes.Alloc(n);
        for (int i = 0; i < n; i = i + 1) {
            b.SetAt(i, this.buf[this.pos + i] & 255);
        }
        this.pos = this.pos + n;
        return b;
    }

    // <paramref name="n"/> 字节的文本。
    public string Text(int n) {
        if (n <= 0) { return ""; }
        if (this.pos + n > this.len) { n = this.len - this.pos; }
        byte[] t = FbBuf.Alloc(n);
        for (int i = 0; i < n; i = i + 1) {
            t[i] = (byte)(this.buf[this.pos + i] & 255);
        }
        this.pos = this.pos + n;
        return t.ToStr(0, n);
    }
}
