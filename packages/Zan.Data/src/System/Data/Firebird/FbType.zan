using System;
using System.Data;

namespace System.Data.Firebird;

// Firebird SQL 类型码（表示“可空”的奇数变体
// 在解析元数据时并入对应的偶数基础类型）。
public class FbType {
    public static int TEXT         = 452;
    public static int VARYING      = 448;
    public static int SHORT        = 500;
    public static int LONG         = 496;
    public static int FLOAT        = 482;
    public static int DOUBLE       = 480;
    public static int D_FLOAT      = 530;
    public static int TIMESTAMP    = 510;
    public static int BLOB         = 520;
    public static int ARRAY        = 540;
    public static int QUAD         = 550;
    public static int TIME         = 560;
    public static int DATE         = 570;
    public static int INT64        = 580;
    public static int INT128       = 32752;
    public static int TIMESTAMP_TZ = 32754;
    public static int TIME_TZ      = 32756;
    public static int DEC_FIXED    = 32758;
    public static int DEC64        = 32760;
    public static int DEC128       = 32762;
    public static int BOOLEAN      = 32764;
    public static int NULL         = 32766;

    // describe 请求的 isc_info_sql_* 项
    public static int INFO_END           = 1;
    public static int INFO_TRUNCATED     = 2;
    public static int INFO_SELECT        = 4;
    public static int INFO_BIND          = 5;
    public static int INFO_DESCRIBE_VARS = 7;
    public static int INFO_DESCRIBE_END  = 8;
    public static int INFO_SQLDA_SEQ     = 9;
    public static int INFO_TYPE          = 11;
    public static int INFO_SUB_TYPE      = 12;
    public static int INFO_SCALE         = 13;
    public static int INFO_LENGTH        = 14;
    public static int INFO_NULL_IND      = 15;
    public static int INFO_FIELD         = 16;
    public static int INFO_RELATION      = 17;
    public static int INFO_OWNER         = 18;
    public static int INFO_ALIAS         = 19;
    public static int INFO_SQLDA_START   = 20;
    public static int INFO_STMT_TYPE     = 21;
    public static int INFO_RECORDS       = 23;

    // isc_info_sql_records 中的 isc_info_req_* 计数器
    public static int REQ_SELECT_COUNT = 13;
    public static int REQ_INSERT_COUNT = 14;
    public static int REQ_UPDATE_COUNT = 15;
    public static int REQ_DELETE_COUNT = 16;

    // 语句类型
    public static int STMT_SELECT = 1;
    public static int STMT_INSERT = 2;
    public static int STMT_UPDATE = 3;
    public static int STMT_DELETE = 4;
    public static int STMT_DDL    = 5;
    public static int STMT_EXEC_PROCEDURE = 8;
    public static int STMT_SELECT_FOR_UPD = 12;
}
