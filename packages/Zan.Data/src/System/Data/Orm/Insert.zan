using System;
using System.Text;
using System.Data;

namespace System.Data.Orm;

// 类型化 INSERT 的运行期实现：实体行与动态列（DbValues）两条来源，
// Only/Skip 决定的列集合在运行期成形，upsert 子句按方言拼装。
public class Insert {
    public IDbExecutor db;
    public Meta meta;
    public string tbl;
    private IRows rows;
    private List<DbValues> dicts;
    private List<string> only;
    private List<string> skip;
    private List<string> conf;
    private List<string> acc;
    private List<string> gmx;
    private List<string> gmn;
    private bool upsert;
    private bool nop;
    private string sql;
    private DbParams bound;

    // 私有构造；统一经 <see cref="Create"/> 创建。
    public Insert(IDbExecutor db, Meta meta) {
        this.db = db;
        this.meta = meta;
        this.tbl = meta.Table;
        this.rows = null;
        this.dicts = new List<DbValues>();
        this.only = new List<string>();
        this.skip = new List<string>();
        this.conf = new List<string>();
        this.acc = new List<string>();
        this.gmx = new List<string>();
        this.gmn = new List<string>();
        this.upsert = false;
        this.nop = false;
        this.sql = "";
        this.bound = new DbParams();
    }

    // 为实体创建一个空的 INSERT 构造器。
    public static Insert Create(IDbExecutor db, Meta meta) {
        return new Insert(db, meta);
    }

    // 改写到另一张表（标识符校验，防注入）。
    public void AsTable(string t) { this.tbl = QueryBuilder.RequireIdent(t); }
    // 实体行来源：由编译期为该实体发的取值口提供。
    public void SetRows(IRows rows) { this.rows = rows; }

    // 实体行数。
    public int RowCount() { return this.rows == null ? 0 : this.rows.RowCount(); }

    // 追加一行动态列（列名经元数据校验，未知列抛异常）。
    public void AddDict(DbValues v) {
        List<DbValue> vItems = v.items;
        int vc = vItems.Count;
        if (this.dicts.Count > 0) {
            List<DbValue> hItems = this.dicts[0].items;
            int hc = hItems.Count;
            for (int i = 0; i < vc; i = i + 1) {
                string nm = vItems[i].name;
                if (i < hc && hItems[i].name == nm) { continue; }
                this.meta.Require(nm);
            }
        } else {
            for (int i = 0; i < vc; i = i + 1) {
                this.meta.Require(vItems[i].name);
            }
        }
        this.dicts.Add(v);
    }

    // 只插入该列（可多次调用，与 Skip 互斥语义）。
    public void Only(string c) { this.only.Add(this.meta.Require(c)); }
    // 跳过该列（可多次调用）。
    public void Skip(string c) { this.skip.Add(this.meta.Require(c)); }
    // upsert：冲突时把该列更新为新值；键列缺省取主键。
    public void OC(string c) { this.conf.Add(this.meta.Require(c)); this.upsert = true; }
    // upsert：冲突时该列累加（counter 语义）。
    public void ACC(string c) { this.acc.Add(this.meta.Require(c)); this.upsert = true; }
    // upsert：冲突时该列取更大值（GREATEST/max）。
    public void GMX(string c) { this.gmx.Add(this.meta.Require(c)); this.upsert = true; }
    // upsert：冲突时该列取更小值。
    public void GMN(string c) { this.gmn.Add(this.meta.Require(c)); this.upsert = true; }
    // upsert：冲突时什么都不改（DO NOTHING）。
    public void NOP() { this.nop = true; this.upsert = true; }
    // 动态列行数。
    public int DictCount() { return this.dicts.Count; }

    // 这一列是否进语句：Only 优先，其次自增列不写，
    // 最后看 Skip。
    public bool Use(string c, bool identity) {
        if (this.only.Count > 0) { return Dialect.Has(this.only, c); }
        if (identity) { return false; }
        return !Dialect.Has(this.skip, c);
    }

    // 依 Only / 自增列 / Skip 规则选出参与语句的列集合。
    private List<Col> Used() {
        List<Col> l = new List<Col>();
        for (int i = 0; i < this.meta.Cols.Count; i = i + 1) {
            Col c = this.meta.Cols[i];
            if (this.Use(c.Col, c.IsIdent)) { l.Add(c); }
        }
        return l;
    }

    // 返回标识符按方言引用后的精确字节长度（零分配）。
    private static int QuotedLen(int p, string ident, out bool isSimple) {
        isSimple = false;
        if (ident == null || ident.Length == 0) { return 0; }
        int len = ident.Length;
        if (len == 1 && (ident[0] & 255) == 42) { return 1; }
        int openCh = 34;
        int closeCh = 34;
        if (p == DbProvider.MySQL || p == DbProvider.MariaDB) {
            openCh = 96; closeCh = 96;
        } else if (p == DbProvider.SqlServer) {
            openCh = 91; closeCh = 93;
        }
        if (!(len >= 2 && (ident[0] & 255) == openCh && (ident[len - 1] & 255) == closeCh)) {
            bool ok = true;
            for (int i = 0; i < len; i = i + 1) {
                int c = ident[i] & 255;
                if (c == 46 || c == closeCh) { ok = false; break; }
            }
            if (ok) {
                isSimple = true;
                return len + 2;
            }
        }
        return Dialect.QuoteIdentifier(p, ident).Length;
    }

    private static int WriteQuoted(byte[] buf, nint bp, int pos, int p, string ident) {
        if (ident == null || ident.Length == 0) { return pos; }
        int len = ident.Length;
        if (len == 1 && (ident[0] & 255) == 42) {
            buf[pos] = 42;
            return pos + 1;
        }
        int openCh = 34;
        int closeCh = 34;
        if (p == DbProvider.MySQL || p == DbProvider.MariaDB) {
            openCh = 96; closeCh = 96;
        } else if (p == DbProvider.SqlServer) {
            openCh = 91; closeCh = 93;
        }
        bool simple = true;
        if (len >= 2 && (ident[0] & 255) == openCh && (ident[len - 1] & 255) == closeCh) {
            simple = false;
        } else {
            for (int i = 0; i < len; i = i + 1) {
                int c = ident[i] & 255;
                if (c == 46 || c == closeCh) { simple = false; break; }
            }
        }
        if (simple) {
            buf[pos] = (byte)openCh;
            NativeMemory.Copy(bp + (nint)(pos + 1), (nint)ident, len);
            buf[pos + 1 + len] = (byte)closeCh;
            return pos + len + 2;
        }
        string q = Dialect.QuoteIdentifier(p, ident);
        NativeMemory.Copy(bp + (nint)pos, (nint)q, q.Length);
        return pos + q.Length;
    }

    // 预检冲突子句并计算精确字节长度（零中间对象）。
    private int MeasureConflict(int p, out List<string> keysOut, out int[] modesOut, out int updateCount) {
        keysOut = null;
        modesOut = null;
        updateCount = 0;
        if (!this.upsert) { return 0; }
        List<string> keys = this.conf;
        if (keys.Count == 0) { keys = this.meta.PkCols(); }
        if (keys.Count == 0) {
            throw new Exception(this.meta.Entity
                + ": OnConflict needs key columns");
        }
        bool my = p == DbProvider.MySQL || p == DbProvider.MariaDB;
        bool pg = p == DbProvider.PostgreSQL || p == DbProvider.OpenGauss
                  || p == DbProvider.Kingbase;
        if (!my && !pg && p != DbProvider.SQLite) {
            throw new Exception(
                "Upsert (OnConflict) is not supported on this provider");
        }
        keysOut = keys;
        bool tmpSimple = false;
        int keysLen = 0;
        if (my) {
            keysLen = Insert.QuotedLen(p, keys[0], out tmpSimple);
        } else {
            for (int i = 0; i < keys.Count; i = i + 1) {
                if (i > 0) { keysLen = keysLen + 2; }
                keysLen = keysLen + Insert.QuotedLen(p, keys[i], out tmpSimple);
            }
        }
        if (this.nop) {
            return my ? (25 + keysLen + 3 + keysLen) : (14 + keysLen + 12);
        }

        int metaCount = this.meta.Cols.Count;
        int[] modes = new int[metaCount];
        bool isSqlite = p == DbProvider.SQLite;
        bool hasAcc = this.acc.Count > 0;
        bool hasGmx = this.gmx.Count > 0;
        bool hasGmn = this.gmn.Count > 0;
        int bodyLen = 0;
        int n = 0;
        for (int i = 0; i < metaCount; i = i + 1) {
            Col c = this.meta.Cols[i];
            if (!this.Use(c.Col, c.IsIdent) || Dialect.Has(keys, c.Col)) {
                modes[i] = -1;
                continue;
            }
            int md = 0;
            if (hasAcc && Dialect.Has(this.acc, c.Col)) { md = 1; }
            else if (hasGmx && Dialect.Has(this.gmx, c.Col)) { md = 2; }
            else if (hasGmn && Dialect.Has(this.gmn, c.Col)) { md = 3; }
            modes[i] = md;
            int ql = Insert.QuotedLen(p, c.Col, out tmpSimple);
            if (n > 0) { bodyLen = bodyLen + 2; }
            if (md == 0) {
                // my: qc + " = VALUES(" + qc + ")" -> 2*ql + 11; pg/sq: qc + " = excluded." + qc -> 2*ql + 12
                bodyLen = bodyLen + ql + ql + (my ? 11 : 12);
            } else if (md == 1) {
                // my: qc + " = " + qc + " + VALUES(" + qc + ")" -> 3*ql + 14; pg/sq: 3*ql + 15
                bodyLen = bodyLen + ql * 3 + (my ? 14 : 15);
            } else {
                int fnLen = md == 2 ? (isSqlite ? 3 : 8) : (isSqlite ? 3 : 5);
                // qc + " = " + fn + "(" + qc + ", " + src + ")"
                // my: 3*ql + fnLen + 15; pg/sq: 3*ql + fnLen + 16
                bodyLen = bodyLen + ql * 3 + fnLen + (my ? 15 : 16);
            }
            n = n + 1;
        }
        modesOut = modes;
        updateCount = n;
        if (n == 0) {
            return my ? (25 + keysLen + 3 + keysLen) : (14 + keysLen + 12);
        }
        return (my ? 25 : (14 + keysLen + 16)) + bodyLen;
    }

    private int WriteConflict(byte[] buf, nint bp, int pos, int p,
                              List<string> keys, int[] modes, int updateCount) {
        if (!this.upsert) { return pos; }
        bool my = p == DbProvider.MySQL || p == DbProvider.MariaDB;
        if (this.nop || updateCount == 0) {
            if (my) {
                NativeMemory.Copy(bp + (nint)pos, (nint)" ON DUPLICATE KEY UPDATE ", 25);
                pos = pos + 25;
                pos = Insert.WriteQuoted(buf, bp, pos, p, keys[0]);
                NativeMemory.Copy(bp + (nint)pos, (nint)" = ", 3);
                pos = pos + 3;
                pos = Insert.WriteQuoted(buf, bp, pos, p, keys[0]);
            } else {
                NativeMemory.Copy(bp + (nint)pos, (nint)" ON CONFLICT (", 14);
                pos = pos + 14;
                for (int i = 0; i < keys.Count; i = i + 1) {
                    if (i > 0) { buf[pos] = 44; buf[pos + 1] = 32; pos = pos + 2; }
                    pos = Insert.WriteQuoted(buf, bp, pos, p, keys[i]);
                }
                NativeMemory.Copy(bp + (nint)pos, (nint)") DO NOTHING", 12);
                pos = pos + 12;
            }
            return pos;
        }

        if (my) {
            NativeMemory.Copy(bp + (nint)pos, (nint)" ON DUPLICATE KEY UPDATE ", 25);
            pos = pos + 25;
        } else {
            NativeMemory.Copy(bp + (nint)pos, (nint)" ON CONFLICT (", 14);
            pos = pos + 14;
            for (int i = 0; i < keys.Count; i = i + 1) {
                if (i > 0) { buf[pos] = 44; buf[pos + 1] = 32; pos = pos + 2; }
                pos = Insert.WriteQuoted(buf, bp, pos, p, keys[i]);
            }
            NativeMemory.Copy(bp + (nint)pos, (nint)") DO UPDATE SET ", 16);
            pos = pos + 16;
        }

        bool isSqlite = p == DbProvider.SQLite;
        int metaCount = this.meta.Cols.Count;
        int n = 0;
        for (int i = 0; i < metaCount; i = i + 1) {
            int md = modes[i];
            if (md < 0) { continue; }
            string col = this.meta.Cols[i].Col;
            if (n > 0) { buf[pos] = 44; buf[pos + 1] = 32; pos = pos + 2; }
            int qStart = pos;
            pos = Insert.WriteQuoted(buf, bp, pos, p, col);
            int qLen = pos - qStart;
            buf[pos] = 32; buf[pos + 1] = 61; buf[pos + 2] = 32;
            pos = pos + 3;
            if (md == 0) {
                if (my) {
                    NativeMemory.Copy(bp + (nint)pos, (nint)"VALUES(", 7);
                    pos = pos + 7;
                    NativeMemory.Copy(bp + (nint)pos, bp + (nint)qStart, qLen);
                    pos = pos + qLen;
                    buf[pos] = 41; pos = pos + 1;
                } else {
                    NativeMemory.Copy(bp + (nint)pos, (nint)"excluded.", 9);
                    pos = pos + 9;
                    NativeMemory.Copy(bp + (nint)pos, bp + (nint)qStart, qLen);
                    pos = pos + qLen;
                }
            } else if (md == 1) {
                NativeMemory.Copy(bp + (nint)pos, bp + (nint)qStart, qLen);
                pos = pos + qLen;
                if (my) {
                    NativeMemory.Copy(bp + (nint)pos, (nint)" + VALUES(", 10);
                    pos = pos + 10;
                    NativeMemory.Copy(bp + (nint)pos, bp + (nint)qStart, qLen);
                    pos = pos + qLen;
                    buf[pos] = 41; pos = pos + 1;
                } else {
                    NativeMemory.Copy(bp + (nint)pos, (nint)" + excluded.", 12);
                    pos = pos + 12;
                    NativeMemory.Copy(bp + (nint)pos, bp + (nint)qStart, qLen);
                    pos = pos + qLen;
                }
            } else {
                if (md == 2) {
                    if (isSqlite) {
                        NativeMemory.Copy(bp + (nint)pos, (nint)"max(", 4); pos = pos + 4;
                    } else {
                        NativeMemory.Copy(bp + (nint)pos, (nint)"GREATEST(", 9); pos = pos + 9;
                    }
                } else {
                    if (isSqlite) {
                        NativeMemory.Copy(bp + (nint)pos, (nint)"min(", 4); pos = pos + 4;
                    } else {
                        NativeMemory.Copy(bp + (nint)pos, (nint)"LEAST(", 6); pos = pos + 6;
                    }
                }
                NativeMemory.Copy(bp + (nint)pos, bp + (nint)qStart, qLen);
                pos = pos + qLen;
                if (my) {
                    NativeMemory.Copy(bp + (nint)pos, (nint)", VALUES(", 9);
                    pos = pos + 9;
                    NativeMemory.Copy(bp + (nint)pos, bp + (nint)qStart, qLen);
                    pos = pos + qLen;
                    buf[pos] = 41; buf[pos + 1] = 41; pos = pos + 2;
                } else {
                    NativeMemory.Copy(bp + (nint)pos, (nint)", excluded.", 11);
                    pos = pos + 11;
                    NativeMemory.Copy(bp + (nint)pos, bp + (nint)qStart, qLen);
                    pos = pos + qLen;
                    buf[pos] = 41; pos = pos + 1;
                }
            }
            n = n + 1;
        }
        return pos;
    }

    private static int WriteValueTuples(byte[] buf, nint bp, int pos, int colCount, int rowCount) {
        if (rowCount <= 0) { return pos; }
        int tupleLen = colCount <= 0 ? 6 : (colCount * 3);
        int startPos = pos;
        buf[pos] = 40; pos = pos + 1;
        if (colCount <= 0) {
            NativeMemory.Copy(bp + (nint)pos, (nint)"NULL", 4);
            pos = pos + 4;
        } else {
            buf[pos] = 63; pos = pos + 1;
            for (int k = 1; k < colCount; k = k + 1) {
                buf[pos] = 44; buf[pos + 1] = 32; buf[pos + 2] = 63;
                pos = pos + 3;
            }
        }
        buf[pos] = 41; pos = pos + 1;

        if (rowCount > 1) {
            int unitStart = pos;
            int unitLen = tupleLen + 2;
            buf[pos] = 44; buf[pos + 1] = 32;
            NativeMemory.Copy(bp + (nint)(pos + 2), bp + (nint)startPos, tupleLen);
            pos = pos + unitLen;

            int built = 1;
            int rem = rowCount - 2;
            while (rem > 0) {
                int take = built < rem ? built : rem;
                int bytes = take * unitLen;
                NativeMemory.Copy(bp + (nint)pos, bp + (nint)unitStart, bytes);
                pos = pos + bytes;
                built = built + take;
                rem = rem - take;
            }
        }
        return pos;
    }

    // 冲突子句。键列缺省取实体主键；方言差异
    // （excluded 对 VALUES()、GREATEST 对 max）在 Dialect 里解决。
    public string Conflict() {
        if (!this.upsert) { return ""; }
        int p = this.db.GetProvider();
        List<string> keys = null;
        int[] modes = null;
        int updateCount = 0;
        int len = this.MeasureConflict(p, out keys, out modes, out updateCount);
        if (len <= 0) { return ""; }
        byte[] buf = new byte[len];
        nint bp = (nint)buf;
        this.WriteConflict(buf, bp, 0, p, keys, modes, updateCount);
        return NativeMemory.GetString(bp, 0, len);
    }

    // 动态列写入（指定行范围）：所有行按第一行的列形状对齐，缺的列写
    // NULL，值按列声明类型绑定。
    public int BuildDictsRange(int start, int count) {
        if (count <= 0) { return 0; }
        List<DbValue> headItems = this.dicts[0].items;
        int hc = headItems.Count;
        if (hc == 0) { return 0; }

        bool noFilter = this.only.Count == 0 && this.skip.Count == 0;
        string[] colNames = new string[hc];
        int[] headIdx = new int[hc];
        int[] kinds = new int[hc];
        int colCount = 0;
        int p = this.db.GetProvider();
        bool tmpSimple = false;
        int colsSqlLen = 0;
        for (int c = 0; c < hc; c = c + 1) {
            string cn = headItems[c].name;
            if (noFilter || this.Use(cn, false)) {
                colNames[colCount] = cn;
                headIdx[colCount] = c;
                kinds[colCount] = this.meta.KindOf(cn);
                if (colCount > 0) { colsSqlLen = colsSqlLen + 2; }
                colsSqlLen = colsSqlLen + Insert.QuotedLen(p, cn, out tmpSimple);
                colCount = colCount + 1;
            }
        }
        if (colCount == 0) { return 0; }

        List<string> confKeys = null;
        int[] confModes = null;
        int confUpdates = 0;
        int confLen = this.MeasureConflict(p, out confKeys, out confModes, out confUpdates);

        int tblLen = Insert.QuotedLen(p, this.tbl, out tmpSimple);
        int tupleLen = colCount * 3;
        int tuplesLen = tupleLen + (count - 1) * (tupleLen + 2);
        // "INSERT INTO " (12) + tbl + " (" (2) + cols + ") VALUES " (9) + tuples + conflict
        int totalLen = 23 + tblLen + colsSqlLen + tuplesLen + confLen;
        byte[] buf = new byte[totalLen];
        nint bp = (nint)buf;
        int pos = 0;
        NativeMemory.Copy(bp, (nint)"INSERT INTO ", 12);
        pos = 12;
        pos = Insert.WriteQuoted(buf, bp, pos, p, this.tbl);
        buf[pos] = 32; buf[pos + 1] = 40; pos = pos + 2;
        for (int c = 0; c < colCount; c = c + 1) {
            if (c > 0) { buf[pos] = 44; buf[pos + 1] = 32; pos = pos + 2; }
            pos = Insert.WriteQuoted(buf, bp, pos, p, colNames[c]);
        }
        NativeMemory.Copy(bp + (nint)pos, (nint)") VALUES ", 9);
        pos = pos + 9;
        pos = Insert.WriteValueTuples(buf, bp, pos, colCount, count);
        if (confLen > 0) {
            pos = this.WriteConflict(buf, bp, pos, p, confKeys, confModes, confUpdates);
        }

        DbParams ps = new DbParams();
        for (int i = 0; i < count; i = i + 1) {
            DbValues v = this.dicts[start + i];
            List<DbValue> vItems = v.items;
            int vc = vItems.Count;
            for (int k = 0; k < colCount; k = k + 1) {
                int hp = headIdx[k];
                string col = colNames[k];
                int at = (hp < vc && vItems[hp].name == col) ? hp : v.IndexOf(col);
                if (at < 0) {
                    ps.AddNull();
                } else {
                    DbValue dv = vItems[at];
                    int want = kinds[k];
                    int vk = dv.kind;
                    if (vk == want || vk == DbParams.KindNull || want == DbParams.KindNull) {
                        if (vk == DbParams.KindInt) { ps.AddLong(dv.ival); }
                        else if (vk == DbParams.KindText) { ps.Add(dv.text); }
                        else if (vk == DbParams.KindDouble) { ps.AddDouble(dv.dval); }
                        else { ps.AddNull(); }
                    } else {
                        v.BindAs(ps, at, want);
                    }
                }
            }
        }
        this.sql = NativeMemory.GetString(bp, 0, pos);
        this.bound = ps;
        return 1;
    }

    // 动态列写入：全量行按第一行的列形状对齐。
    public int BuildDicts() {
        return this.BuildDictsRange(0, this.dicts.Count);
    }

    // 实体行写入（指定行范围）：列集合成形一次，每行按同一集合绑定。
    public int BuildRowsRange(int start, int count) {
        if (count <= 0) { return 0; }
        List<Col> cols = this.Used();
        int colCount = cols.Count;
        if (colCount == 0) { return 0; }
        int p = this.db.GetProvider();
        bool tmpSimple = false;
        int colsSqlLen = 0;
        for (int c = 0; c < colCount; c = c + 1) {
            if (c > 0) { colsSqlLen = colsSqlLen + 2; }
            colsSqlLen = colsSqlLen + Insert.QuotedLen(p, cols[c].Col, out tmpSimple);
        }
        List<string> confKeys = null;
        int[] confModes = null;
        int confUpdates = 0;
        int confLen = this.MeasureConflict(p, out confKeys, out confModes, out confUpdates);

        int tblLen = Insert.QuotedLen(p, this.tbl, out tmpSimple);
        int tupleLen = colCount * 3;
        int tuplesLen = tupleLen + (count - 1) * (tupleLen + 2);
        int totalLen = 23 + tblLen + colsSqlLen + tuplesLen + confLen;
        byte[] buf = new byte[totalLen];
        nint bp = (nint)buf;
        int pos = 0;
        NativeMemory.Copy(bp, (nint)"INSERT INTO ", 12);
        pos = 12;
        pos = Insert.WriteQuoted(buf, bp, pos, p, this.tbl);
        buf[pos] = 32; buf[pos + 1] = 40; pos = pos + 2;
        for (int c = 0; c < colCount; c = c + 1) {
            if (c > 0) { buf[pos] = 44; buf[pos + 1] = 32; pos = pos + 2; }
            pos = Insert.WriteQuoted(buf, bp, pos, p, cols[c].Col);
        }
        NativeMemory.Copy(bp + (nint)pos, (nint)") VALUES ", 9);
        pos = pos + 9;
        pos = Insert.WriteValueTuples(buf, bp, pos, colCount, count);
        if (confLen > 0) {
            pos = this.WriteConflict(buf, bp, pos, p, confKeys, confModes, confUpdates);
        }

        DbParams ps = new DbParams();
        for (int i = 0; i < count; i = i + 1) {
            int rowIdx = start + i;
            for (int k = 0; k < colCount; k = k + 1) {
                this.rows.BindCol(rowIdx, cols[k], ps);
            }
        }
        this.sql = NativeMemory.GetString(bp, 0, pos);
        this.bound = ps;
        return 1;
    }

    // 实体行写入：列集合成形一次，每行按同一集合绑定。
    public int BuildRows() {
        return this.BuildRowsRange(0, this.RowCount());
    }

    // 计算当前数据库引擎下安全的分批行数，防止超大批量参数溢出与 SQL 膨胀。
    private int SafeBatchRows(int colCount) {
        if (colCount <= 0) { return 500; }
        int p = this.db.GetProvider();
        int maxParams = 1000;
        if (p == DbProvider.SQLite) { maxParams = 500; }
        else if (p == DbProvider.SqlServer) { maxParams = 1000; }
        int b = maxParams / colCount;
        if (b < 1) { b = 1; }
        if (b > 500) { b = 500; }
        return b;
    }

    // 执行动态列 INSERT，返回受影响行数。超大批量时自动分批执行，防止参数超限。
    public int ExecuteDicts() {
        int total = this.dicts.Count;
        if (total == 0) { return 0; }
        int cols = this.dicts[0].Count();
        int batch = this.SafeBatchRows(cols);
        if (total <= batch) {
            if (this.BuildDicts() == 0) { return 0; }
            return this.db.Execute(this.sql, this.bound);
        }
        int aff = 0;
        int off = 0;
        while (off < total) {
            int take = total - off;
            if (take > batch) { take = batch; }
            if (this.BuildDictsRange(off, take) > 0) {
                aff = aff + this.db.Execute(this.sql, this.bound);
            }
            off = off + take;
        }
        return aff;
    }

    // 异步执行动态列 INSERT。超大批量时自动分批执行。
    public async int ExecuteDictsAsync() {
        int total = this.dicts.Count;
        if (total == 0) { return 0; }
        int cols = this.dicts[0].Count();
        int batch = this.SafeBatchRows(cols);
        if (total <= batch) {
            if (this.BuildDicts() == 0) { return 0; }
            return await this.db.ExecuteAsync(this.sql, this.bound);
        }
        int aff = 0;
        int off = 0;
        while (off < total) {
            int take = total - off;
            if (take > batch) { take = batch; }
            if (this.BuildDictsRange(off, take) > 0) {
                aff = aff + await this.db.ExecuteAsync(this.sql, this.bound);
            }
            off = off + take;
        }
        return aff;
    }

    // 执行实体行 INSERT，返回受影响行数。超大批量时自动分批执行。
    public int ExecuteRows() {
        int total = this.RowCount();
        if (total == 0) { return 0; }
        List<Col> cols = this.Used();
        if (cols.Count == 0) { return 0; }
        int batch = this.SafeBatchRows(cols.Count);
        if (total <= batch) {
            if (this.BuildRows() == 0) { return 0; }
            return this.db.Execute(this.sql, this.bound);
        }
        int aff = 0;
        int off = 0;
        while (off < total) {
            int take = total - off;
            if (take > batch) { take = batch; }
            if (this.BuildRowsRange(off, take) > 0) {
                aff = aff + this.db.Execute(this.sql, this.bound);
            }
            off = off + take;
        }
        return aff;
    }

    // 异步执行实体行 INSERT。超大批量时自动分批执行。
    public async int ExecuteRowsAsync() {
        int total = this.RowCount();
        if (total == 0) { return 0; }
        List<Col> cols = this.Used();
        if (cols.Count == 0) { return 0; }
        int batch = this.SafeBatchRows(cols.Count);
        if (total <= batch) {
            if (this.BuildRows() == 0) { return 0; }
            return await this.db.ExecuteAsync(this.sql, this.bound);
        }
        int aff = 0;
        int off = 0;
        while (off < total) {
            int take = total - off;
            if (take > batch) { take = batch; }
            if (this.BuildRowsRange(off, take) > 0) {
                aff = aff + await this.db.ExecuteAsync(this.sql, this.bound);
            }
            off = off + take;
        }
        return aff;
    }

    // 执行插入（动态列优先，否则实体行），返回受影响行数。
    public int ExecuteAffrows() {
        if (this.dicts.Count > 0) { return this.ExecuteDicts(); }
        return this.ExecuteRows();
    }

    // 异步执行插入。
    public async int ExecuteAffrowsAsync() {
        if (this.dicts.Count > 0) { return await this.ExecuteDictsAsync(); }
        return await this.ExecuteRowsAsync();
    }

    // 插入单行并取自增主键值（0 = 插入失败或无自增列）。
    public int ExecuteIdentity() {
        if (this.ExecuteAffrows() == 0) { return 0; }
        return Dialect.LastId(this.db);
    }

    // 异步插入并取自增主键值。
    public async int ExecuteIdentityAsync() {
        int n = await this.ExecuteAffrowsAsync();
        if (n == 0) { return 0; }
        return await Dialect.LastIdAsync(this.db);
    }
}
