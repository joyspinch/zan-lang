using System;
using System.Collections.Generic;
using System.Text;
using System.Data;
using System.Threading;

namespace System.Data.Orm;

public class UpdateQuery<T> {
    public Update inner;
    public Meta meta;

    public UpdateQuery(IDbExecutor db) {
        this.meta = Meta.For<T>();
        this.inner = Update.Create(db, this.meta);
    }

    public UpdateQuery(IDbExecutor db, Meta meta) {
        this.meta = meta;
        this.inner = Update.Create(db, this.meta);
    }

    public string DetectColInt(Func<T, int> expr) {
        TypeInfo ti = (this.meta != null && this.meta.Type.Name.Length > 0) ? this.meta.Type : typeof(T);
        for (int i = 0; i < this.meta.Cols.Count; i = i + 1) {
            Col c = this.meta.Cols[i];
            if (c.Kind == 0) {
                object dummy = ti.CreateInstance();
                if (dummy == null) { break; }
                dummy.SetFieldInt(c.Field, OrmProbeConstants.PROBE_INT_MAGIC);
                try {
                    int res = expr((T)dummy);
                    if (res == OrmProbeConstants.PROBE_INT_MAGIC) { return c.Col; }
                } catch (Exception _ex) {
                    // 探针反射探测：非目标字段触发异常时跳过该候选列
                }
            }
        }
        return this.meta.Cols.Count > 0 ? this.meta.Cols[this.meta.Cols.Count - 1].Col : "";
    }

    public string DetectColLong(Func<T, long> expr) {
        TypeInfo ti = (this.meta != null && this.meta.Type.Name.Length > 0) ? this.meta.Type : typeof(T);
        for (int i = 0; i < this.meta.Cols.Count; i = i + 1) {
            Col c = this.meta.Cols[i];
            if (c.Kind == 0 && c.I64) {
                object dummy = ti.CreateInstance();
                if (dummy == null) { break; }
                dummy.SetFieldLong(c.Field, OrmProbeConstants.PROBE_LONG_MAGIC);
                try {
                    long res = expr((T)dummy);
                    if (res == OrmProbeConstants.PROBE_LONG_MAGIC) { return c.Col; }
                } catch (Exception _ex) {
                    // 探针反射探测：非目标字段触发异常时跳过该候选列
                }
            }
        }
        return this.meta.Cols.Count > 0 ? this.meta.Cols[this.meta.Cols.Count - 1].Col : "";
    }

    public string DetectColDouble(Func<T, double> expr) {
        TypeInfo ti = (this.meta != null && this.meta.Type.Name.Length > 0) ? this.meta.Type : typeof(T);
        for (int i = 0; i < this.meta.Cols.Count; i = i + 1) {
            Col c = this.meta.Cols[i];
            if (c.Kind == 1) {
                object dummy = ti.CreateInstance();
                if (dummy == null) { break; }
                dummy.SetFieldDouble(c.Field, OrmProbeConstants.PROBE_DOUBLE_MAGIC);
                try {
                    double res = expr((T)dummy);
                    if (res == OrmProbeConstants.PROBE_DOUBLE_MAGIC) { return c.Col; }
                } catch (Exception _ex) {
                    // 探针反射探测：非目标字段触发异常时跳过该候选列
                }
            }
        }
        return this.meta.Cols.Count > 0 ? this.meta.Cols[this.meta.Cols.Count - 1].Col : "";
    }

    public string DetectColString(Func<T, string> expr) {
        TypeInfo ti = (this.meta != null && this.meta.Type.Name.Length > 0) ? this.meta.Type : typeof(T);
        for (int i = 0; i < this.meta.Cols.Count; i = i + 1) {
            Col c = this.meta.Cols[i];
            if (c.Kind == 3) {
                object dummy = ti.CreateInstance();
                if (dummy == null) { break; }
                dummy.SetFieldString(c.Field, OrmProbeConstants.PROBE_STRING_MAGIC);
                try {
                    string res = expr((T)dummy);
                    if (res == OrmProbeConstants.PROBE_STRING_MAGIC) { return c.Col; }
                } catch (Exception _ex) {
                    // 探针反射探测：非目标字段触发异常时跳过该候选列
                }
            }
        }
        return this.meta.Cols.Count > 0 ? this.meta.Cols[this.meta.Cols.Count - 1].Col : "";
    }

    public string DetectColBool(Func<T, bool> expr) {
        TypeInfo ti = (this.meta != null && this.meta.Type.Name.Length > 0) ? this.meta.Type : typeof(T);
        for (int i = 0; i < this.meta.Cols.Count; i = i + 1) {
            Col c = this.meta.Cols[i];
            if (c.Kind == 2) {
                object dummy = ti.CreateInstance();
                if (dummy == null) { break; }
                dummy.SetFieldBool(c.Field, true);
                try {
                    if (expr((T)dummy)) { return c.Col; }
                } catch (Exception _ex) {
                    // 探针反射探测：非目标字段触发异常时跳过该候选列
                }
            }
        }
        return this.meta.Cols.Count > 0 ? this.meta.Cols[this.meta.Cols.Count - 1].Col : "";
    }

    public UpdateQuery<T> Set(Func<T, int> expr, int val) {
        string col = this.DetectColInt(expr);
        if (col.Length > 0) { this.inner.SetI(col, val); }
        return this;
    }

    public UpdateQuery<T> Set(Func<T, long> expr, long val) {
        string col = this.DetectColLong(expr);
        if (col.Length > 0) { this.inner.SetL(col, val); }
        return this;
    }

    public UpdateQuery<T> Set(Func<T, double> expr, double val) {
        string col = this.DetectColDouble(expr);
        if (col.Length > 0) { this.inner.SetD(col, val); }
        return this;
    }

    public UpdateQuery<T> Set(Func<T, string> expr, string val) {
        string col = this.DetectColString(expr);
        if (col.Length > 0) { this.inner.SetS(col, val); }
        return this;
    }

    public UpdateQuery<T> Set(Func<T, bool> expr, bool val) {
        string col = this.DetectColBool(expr);
        if (col.Length > 0) { this.inner.SetB(col, val); }
        return this;
    }

    public UpdateQuery<T> Set(string col, int val) {
        this.inner.SetI(col, val);
        return this;
    }

    public UpdateQuery<T> Set(string col, long val) {
        this.inner.SetL(col, val);
        return this;
    }

    public UpdateQuery<T> Set(string col, double val) {
        this.inner.SetD(col, val);
        return this;
    }

    public UpdateQuery<T> Set(string col, string val) {
        this.inner.SetS(col, val);
        return this;
    }

    public UpdateQuery<T> Set(string col, bool val) {
        this.inner.SetB(col, val);
        return this;
    }

    public UpdateQuery<T> SetIncr(Func<T, int> expr, int val) {
        string col = this.DetectColInt(expr);
        if (col.Length > 0) { this.inner.SetIncrI(col, val); }
        return this;
    }

    public UpdateQuery<T> SetIncr(Func<T, long> expr, long val) {
        string col = this.DetectColLong(expr);
        if (col.Length > 0) { this.inner.SetIncrL(col, val); }
        return this;
    }

    public UpdateQuery<T> SetIncr(Func<T, double> expr, double val) {
        string col = this.DetectColDouble(expr);
        if (col.Length > 0) { this.inner.SetIncrD(col, val); }
        return this;
    }

    public UpdateQuery<T> SetIncr(string col, int val) {
        this.inner.SetIncrI(col, val);
        return this;
    }

    public UpdateQuery<T> SetIncr(string col, long val) {
        this.inner.SetIncrL(col, val);
        return this;
    }

    public UpdateQuery<T> SetIncr(string col, double val) {
        this.inner.SetIncrD(col, val);
        return this;
    }

    public UpdateQuery<T> Where(string sql) {
        this.inner.W(sql);
        return this;
    }

    // 表达式树过滤条件（编译期 ExprNode 下推，直接生成参数化 UPDATE，零反射零装箱）
    public UpdateQuery<T> Where(ExprNode expr) {
        this.inner.WExpr(expr);
        return this;
    }

    public UpdateQuery<T> Where(Expr<T> expr) {
        if (expr != null && expr.Root != null) {
            this.inner.WExpr(expr.Root);
        }
        return this;
    }

    /* 与 <see cref="DeleteQuery{T}.Where"/> 同一策略：bool 谓词无法还原
     * 成 SQL，候选行物化后内存过滤，命中的主键集合下推回 UPDATE。 */
    public UpdateQuery<T> Where(Func<T, bool> expr) {
        if (expr == null) { return this; }
        List<string> pks = this.meta.PkCols();
        bool byRowId = pks.Count == 0;
        if (byRowId && this.inner.db.GetProvider() != DbProvider.SQLite) {
            throw new Exception(this.meta.Entity
                + ": lambda Where needs a primary key to target rows");
        }
        StringBuilder sb = new StringBuilder();
        sb.Append("SELECT ");
        if (byRowId) { sb.Append("rowid, "); }
        for (int i = 0; i < this.meta.Cols.Count; i = i + 1) {
            if (i > 0) { sb.Append(", "); }
            sb.Append(this.meta.Cols[i].Col);
        }
        sb.Append(" FROM ");
        sb.Append(this.inner.tbl);
        DbResult r = this.inner.db.Query(sb.ToString(), new DbParams());
        if (r == null) { this.inner.WhereNone(); return this; }
        List<int> colIdx = SelectQuery<T>.ResolveColIndices(r, this.meta);
        int[] pkPos = new int[pks.Count];
        int p = 0;
        for (int i = 0; i < this.meta.Cols.Count; i = i + 1) {
            if (!byRowId && this.meta.Cols[i].IsPk && p < pkPos.Length) {
                pkPos[p] = i;
                p = p + 1;
            }
        }
        List<int> hits = new List<int>();
        int count = r.RowCount();
        for (int i = 0; i < count; i = i + 1) {
            T item = SelectQuery<T>.MapRow(r, i, this.meta, colIdx);
            if (expr(item)) { hits.Add(i); }
        }
        if (hits.Count == 0) { this.inner.WhereNone(); return this; }
        if (byRowId) {
            if (hits.Count > 2000) {
                throw new Exception(this.meta.Entity
                    + ": lambda Where matched " + Convert.ToString(hits.Count)
                    + " rows; use an explicit column predicate for bulk statements");
            }
            int rid = r.GetColumnIndex("rowid");
            StringBuilder rw = new StringBuilder();
            rw.Append("rowid IN (");
            for (int k = 0; k < hits.Count; k = k + 1) {
                if (k > 0) { rw.Append(", "); }
                rw.Append("?");
            }
            rw.Append(")");
            this.inner.W(rw.ToString());
            for (int k = 0; k < hits.Count; k = k + 1) {
                this.inner.Pl(r.GetLong(hits[k], rid));
            }
            return this;
        }
        if (pks.Count == 1) {
            int at = colIdx[pkPos[0]];
            if (this.meta.KindOf(pks[0]) == 3) {
                List<string> sv = new List<string>();
                for (int k = 0; k < hits.Count; k = k + 1) {
                    sv.Add(r.GetString(hits[k], at));
                }
                this.inner.WhereIn(pks[0], sv);
            } else {
                List<long> lv = new List<long>();
                for (int k = 0; k < hits.Count; k = k + 1) {
                    lv.Add(r.GetLong(hits[k], at));
                }
                this.inner.WhereIn(pks[0], lv);
            }
            return this;
        }
        if (hits.Count * pks.Count > 2000) {
            throw new Exception(this.meta.Entity
                + ": lambda Where matched " + Convert.ToString(hits.Count)
                + " rows; use an explicit column predicate for bulk updates");
        }
        StringBuilder w = new StringBuilder();
        for (int k = 0; k < hits.Count; k = k + 1) {
            if (k > 0) { w.Append(" OR "); }
            w.Append("(");
            for (int j = 0; j < pks.Count; j = j + 1) {
                if (j > 0) { w.Append(" AND "); }
                w.Append(pks[j] + " = ?");
            }
            w.Append(")");
        }
        this.inner.W(w.ToString());
        for (int k = 0; k < hits.Count; k = k + 1) {
            for (int j = 0; j < pks.Count; j = j + 1) {
                int at = colIdx[pkPos[j]];
                if (this.meta.KindOf(pks[j]) == 3) {
                    this.inner.P(r.GetString(hits[k], at));
                } else {
                    this.inner.Pl(r.GetLong(hits[k], at));
                }
            }
        }
        return this;
    }

    public UpdateQuery<T> WhereEq(string col, int val) {
        this.inner.WhereEq(col, val);
        return this;
    }

    public UpdateQuery<T> WhereEq(string col, string val) {
        this.inner.WhereEq(col, val);
        return this;
    }

    public UpdateQuery<T> WherePk(int id) {
        Col pk = this.meta.PkCol();
        if (pk != null) { this.inner.WhereEq(pk.Col, id); }
        return this;
    }

    public UpdateQuery<T> WherePk(long id) {
        Col pk = this.meta.PkCol();
        if (pk != null) { this.inner.WhereEq(pk.Col, id); }
        return this;
    }

    public UpdateQuery<T> WherePk(string id) {
        Col pk = this.meta.PkCol();
        if (pk != null) { this.inner.WhereEq(pk.Col, id); }
        return this;
    }

    public UpdateQuery<T> SetDict(DbValues v) {
        this.inner.SetDict(v);
        return this;
    }

    public UpdateQuery<T> WhereDict(DbValues v) {
        this.inner.WhereDict(v);
        return this;
    }

    public UpdateQuery<T> SetSource(T entity) {
        if (entity != null) {
            EntityRows<T> rows = new EntityRows<T>();
            rows.Add(entity);
            this.inner.SetSource(rows);
        }
        return this;
    }

    public UpdateQuery<T> UpdateColumns(Func<T, int> expr) {
        string col = this.DetectColInt(expr);
        if (col.Length > 0) { this.inner.Only(col); }
        return this;
    }

    public UpdateQuery<T> UpdateColumns(Func<T, long> expr) {
        string col = this.DetectColLong(expr);
        if (col.Length > 0) { this.inner.Only(col); }
        return this;
    }

    public UpdateQuery<T> UpdateColumns(Func<T, double> expr) {
        string col = this.DetectColDouble(expr);
        if (col.Length > 0) { this.inner.Only(col); }
        return this;
    }

    public UpdateQuery<T> UpdateColumns(Func<T, string> expr) {
        string col = this.DetectColString(expr);
        if (col.Length > 0) { this.inner.Only(col); }
        return this;
    }

    public UpdateQuery<T> UpdateColumns(Func<T, bool> expr) {
        string col = this.DetectColBool(expr);
        if (col.Length > 0) { this.inner.Only(col); }
        return this;
    }

    public UpdateQuery<T> UpdateColumns(string col) {
        this.inner.Only(col);
        return this;
    }

    public UpdateQuery<T> IgnoreColumns(string col) {
        this.inner.Skip(col);
        return this;
    }

    public int ExecuteAffrows() {
        return this.inner.ExecuteAffrows();
    }

    public async int ExecuteAffrowsAsync() {
        return await this.inner.ExecuteAffrowsAsync();
    }
}

// 为 IDbConnection 与 IDbExecutor 挂接的纯库泛型扩展方法
public static class DbExtensions {
    public static SelectQuery<T> Select<T>(this IDbConnection db) {
        return new SelectQuery<T>(db, Meta.For<T>());
    }

    public static SelectQuery<T> Select<T>(this IDbExecutor db) {
        return new SelectQuery<T>(db, Meta.For<T>());
    }

    public static SelectQuery<T> Query<T>(this IDbConnection db) {
        return new SelectQuery<T>(db, Meta.For<T>());
    }

    public static SelectQuery<T> Query<T>(this IDbExecutor db) {
        return new SelectQuery<T>(db, Meta.For<T>());
    }

    public static InsertQuery<T> Insert<T>(this IDbConnection db) {
        return new InsertQuery<T>(db, null, Meta.For<T>());
    }

    public static InsertQuery<T> Insert<T>(this IDbExecutor db) {
        return new InsertQuery<T>(db, null, Meta.For<T>());
    }

    public static InsertQuery<T> Insert<T>(this IDbConnection db, T entity) {
        return new InsertQuery<T>(db, entity, Meta.For<T>());
    }

    public static InsertQuery<T> Insert<T>(this IDbExecutor db, T entity) {
        return new InsertQuery<T>(db, entity, Meta.For<T>());
    }

    public static InsertQuery<T> Insert<T>(this IDbConnection db, List<T> entities) {
        InsertQuery<T> q = new InsertQuery<T>(db, null, Meta.For<T>());
        if (entities != null) {
            for (int i = 0; i < entities.Count; i = i + 1) {
                T entity = entities[i];
                DbValues v = new DbValues();
                for (int j = 0; j < q.meta.Cols.Count; j = j + 1) {
                    Col c = q.meta.Cols[j];
                    if (c.IsIdent) { continue; }
                    if (c.Kind == 3) {
                        string sv = ((object)entity).GetFieldString(c.Field);
                        if (sv == null) {
                            v.SetNull(c.Col);
                        } else {
                            v.Set(c.Col, sv);
                        }
                    } else if (c.Kind == 1) {
                        v.Set(c.Col, ((object)entity).GetFieldDouble(c.Field));
                    } else if (c.Kind == 2) {
                        v.Set(c.Col, ((object)entity).GetFieldBool(c.Field));
                    } else if (c.Kind == 0 && c.I64) {
                        v.Set(c.Col, ((object)entity).GetFieldLong(c.Field));
                    } else {
                        v.Set(c.Col, ((object)entity).GetFieldInt(c.Field));
                    }
                }
                q.inner.AddDict(v);
            }
        }
        return q;
    }

    public static InsertQuery<T> Insert<T>(this IDbExecutor db, List<T> entities) {
        InsertQuery<T> q = new InsertQuery<T>(db, null, Meta.For<T>());
        if (entities != null) {
            for (int i = 0; i < entities.Count; i = i + 1) {
                T entity = entities[i];
                DbValues v = new DbValues();
                for (int j = 0; j < q.meta.Cols.Count; j = j + 1) {
                    Col c = q.meta.Cols[j];
                    if (c.IsIdent) { continue; }
                    if (c.Kind == 3) {
                        string sv = ((object)entity).GetFieldString(c.Field);
                        if (sv == null) {
                            v.SetNull(c.Col);
                        } else {
                            v.Set(c.Col, sv);
                        }
                    } else if (c.Kind == 1) {
                        v.Set(c.Col, ((object)entity).GetFieldDouble(c.Field));
                    } else if (c.Kind == 2) {
                        v.Set(c.Col, ((object)entity).GetFieldBool(c.Field));
                    } else if (c.Kind == 0 && c.I64) {
                        v.Set(c.Col, ((object)entity).GetFieldLong(c.Field));
                    } else {
                        v.Set(c.Col, ((object)entity).GetFieldInt(c.Field));
                    }
                }
                q.inner.AddDict(v);
            }
        }
        return q;
    }

    public static DeleteQuery<T> Delete<T>(this IDbConnection db) {
        return new DeleteQuery<T>(db, Meta.For<T>());
    }

    public static DeleteQuery<T> Delete<T>(this IDbExecutor db) {
        return new DeleteQuery<T>(db, Meta.For<T>());
    }

    public static UpdateQuery<T> Update<T>(this IDbConnection db) {
        return new UpdateQuery<T>(db, Meta.For<T>());
    }

    public static UpdateQuery<T> Update<T>(this IDbExecutor db) {
        return new UpdateQuery<T>(db, Meta.For<T>());
    }

    public static void SyncStructure<T>(this IDbConnection db) {
        Sync.Sync(db, Meta.For<T>());
    }

    public static void SyncStructure<T>(this IDbExecutor db) {
        Sync.Sync(db, Meta.For<T>());
    }

    /* 这两个包装必须是 async bool：await 挂在 async void 上是火后不理，
     * 调用方（MetricsStore.Start 的 CodeFirst 建表）会在建表完成前就把
     * 连接还池/关池——metrics_flush_retry 的 "no such table" 即由此来。
     * 返回内层 SyncAsync 的结果，await 语义才真正串行。 */
    public static async bool SyncStructureAsync<T>(this IDbConnection db) {
        return await Sync.SyncAsync(db, Meta.For<T>());
    }

    public static async bool SyncStructureAsync<T>(this IDbExecutor db) {
        return await Sync.SyncAsync(db, Meta.For<T>());
    }

    /* 全量同步：实体清单由编译期合成（checker 对零参调用点按 [Table]
     * 类清单补 `new Meta[] { Meta.For<E>()... }` 实参）——清单与编译
     * 单元永远一致，无运行时注册表。同步版逐实体 Sync；异步版是
     * async bool（await 挂 async void 是火后不理）。 */
    public static void SyncStructureAll(this IDbConnection db, Meta[] metas) {
        if (metas == null) { return; }
        for (int i = 0; i < metas.Length; i = i + 1) {
            Sync.Sync(db, metas[i]);
        }
    }

    public static void SyncStructureAll(this IDbExecutor db, Meta[] metas) {
        if (metas == null) { return; }
        for (int i = 0; i < metas.Length; i = i + 1) {
            Sync.Sync(db, metas[i]);
        }
    }

    public static async bool SyncStructureAllAsync(this IDbConnection db,
                                                   Meta[] metas) {
        if (metas == null) { return true; }
        for (int i = 0; i < metas.Length; i = i + 1) {
            if (!await Sync.SyncAsync(db, metas[i])) {
                throw new Exception("SyncStructureAllAsync failed for table "
                    + metas[i].Table);
            }
        }
        return true;
    }

    public static async bool SyncStructureAllAsync(this IDbExecutor db,
                                                   Meta[] metas) {
        if (metas == null) { return true; }
        for (int i = 0; i < metas.Length; i = i + 1) {
            if (!await Sync.SyncAsync(db, metas[i])) {
                throw new Exception("SyncStructureAllAsync failed for table "
                    + metas[i].Table);
            }
        }
        return true;
    }
}

// 转发到 DbExtensions 的扩展方法集合：每个方法体一律转调 DbExtensions 的同名方法。
public static class DbOrmExtensions {
    public static SelectQuery<T> Select<T>(this IDbConnection db) { return DbExtensions.Select<T>(db); }
    public static SelectQuery<T> Select<T>(this IDbExecutor db) { return DbExtensions.Select<T>(db); }
    public static SelectQuery<T> Query<T>(this IDbConnection db) { return DbExtensions.Query<T>(db); }
    public static SelectQuery<T> Query<T>(this IDbExecutor db) { return DbExtensions.Query<T>(db); }
    public static InsertQuery<T> Insert<T>(this IDbConnection db) { return DbExtensions.Insert<T>(db); }
    public static InsertQuery<T> Insert<T>(this IDbExecutor db) { return DbExtensions.Insert<T>(db); }
    public static InsertQuery<T> Insert<T>(this IDbConnection db, T entity) { return DbExtensions.Insert<T>(db, entity); }
    public static InsertQuery<T> Insert<T>(this IDbExecutor db, T entity) { return DbExtensions.Insert<T>(db, entity); }
    public static InsertQuery<T> Insert<T>(this IDbConnection db, List<T> entities) { return DbExtensions.Insert<T>(db, entities); }
    public static InsertQuery<T> Insert<T>(this IDbExecutor db, List<T> entities) { return DbExtensions.Insert<T>(db, entities); }
    public static DeleteQuery<T> Delete<T>(this IDbConnection db) { return DbExtensions.Delete<T>(db); }
    public static DeleteQuery<T> Delete<T>(this IDbExecutor db) { return DbExtensions.Delete<T>(db); }
    public static UpdateQuery<T> Update<T>(this IDbConnection db) { return DbExtensions.Update<T>(db); }
    public static UpdateQuery<T> Update<T>(this IDbExecutor db) { return DbExtensions.Update<T>(db); }
    public static void SyncStructure<T>(this IDbConnection db) { DbExtensions.SyncStructure<T>(db); }
    public static void SyncStructure<T>(this IDbExecutor db) { DbExtensions.SyncStructure<T>(db); }
    public static void SyncStructureAll(this IDbConnection db, Meta[] metas) { DbExtensions.SyncStructureAll(db, metas); }
    public static void SyncStructureAll(this IDbExecutor db, Meta[] metas) { DbExtensions.SyncStructureAll(db, metas); }
    public static async bool SyncStructureAllAsync(this IDbConnection db, Meta[] metas) { return await DbExtensions.SyncStructureAllAsync(db, metas); }
    public static async bool SyncStructureAllAsync(this IDbExecutor db, Meta[] metas) { return await DbExtensions.SyncStructureAllAsync(db, metas); }
}
