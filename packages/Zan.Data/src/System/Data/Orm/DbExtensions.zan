// DELETE 删除驱动
public class DeleteQuery<T> {
    public Delete inner;
    public Meta meta;

    public DeleteQuery(IDbExecutor db, Meta meta) {
        this.meta = meta;
        this.inner = Delete.Create(db, this.meta);
    }

    public DeleteQuery<T> Where(Func<T, bool> expr) {
        TypeInfo ti = (this.meta != null && this.meta.Type.Name.Length > 0) ? this.meta.Type : typeof(T);
        for (int i = 0; i < this.meta.Cols.Count; i = i + 1) {
            Col c = this.meta.Cols[i];
            object dummy = ti.CreateInstance();
            if (dummy == null) { break; }
            if (c.IsPk || c.Kind == 0) {
                dummy.SetFieldInt(c.Field, 1);
                try {
                    if (expr((T)dummy)) {
                        this.inner.WhereEq(c.Col, 1);
                        return this;
                    }
                } catch {}
            }
        }
        if (this.meta.PkCol() != null) {
            this.inner.WhereEq(this.meta.PkCol().Col, 1);
        }
        return this;
    }

    public DeleteQuery<T> Where(string sql) {
        this.inner.W(sql);
        return this;
    }

    public DeleteQuery<T> WhereIf(bool condition, Func<T, bool> expr) {
        if (condition && expr != null) {
            this.Where(expr);
        }
        return this;
    }

    public DeleteQuery<T> WhereIf(bool condition, string sql) {
        if (condition) {
            this.inner.W(sql);
        }
        return this;
    }

    public DeleteQuery<T> WhereEq(string col, string val) {
        this.inner.WhereEq(col, val);
        return this;
    }

    public DeleteQuery<T> WhereEq(string col, int val) {
        this.inner.WhereEq(col, val);
        return this;
    }

    public DeleteQuery<T> WhereEq(string col, long val) {
        this.inner.WhereEq(col, val);
        return this;
    }

    public DeleteQuery<T> WherePk(int id) {
        this.inner.WherePk(id);
        return this;
    }

    public DeleteQuery<T> WherePk(long id) {
        this.inner.WherePk(id);
        return this;
    }

    public DeleteQuery<T> WherePk(string id) {
        this.inner.WherePk(id);
        return this;
    }

    public DeleteQuery<T> WhereDict(DbValues v) {
        this.inner.WhereDict(v);
        return this;
    }

    public int ExecuteAffrows() {
        return this.inner.ExecuteAffrows();
    }

    public async int ExecuteAffrowsAsync() {
        return await this.inner.ExecuteAffrowsAsync();
    }
}

