using System;
using System.Collections.Generic;

namespace System.Data.Orm;

/// <summary>强类型游标/键控分页查询回执（Keyset Pagination）：封装当前批次数据、是否有下一页、游标结束位及条数。
/// 专用于大表深翻页、时间线瀑布流与高并发导出，规避传统 LIMIT OFFSET 深度扫描劣化的性能痛点。</summary>
public class SeekResult<T> {
    /// <summary>当前批次记录列表。</summary>
    public List<T> items;
    /// <summary>当前批次条数。</summary>
    public int count;
    /// <summary>是否还有下一页。</summary>
    public bool hasMore;
    /// <summary>当前批次末尾游标（最后一条记录的主键或指定游标值）。</summary>
    public long lastCursor;

    public SeekResult() {
        this.items = new List<T>();
        this.count = 0;
        this.hasMore = false;
        this.lastCursor = 0L;
    }

    public SeekResult(List<T> items, bool hasMore, long lastCursor) {
        this.items = items == null ? new List<T>() : items;
        this.count = this.items.Count;
        this.hasMore = hasMore;
        this.lastCursor = lastCursor;
    }
}
