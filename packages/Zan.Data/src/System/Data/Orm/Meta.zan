using System;
using System.Text;
using System.Data;
namespace System.Data.Orm;

public class Meta {
    public string Entity;
    public string Table;
    public TypeInfo Type;
    public List<Col> Cols;
    public List<Nav> Navs;
    public List<Index> Idx;
    public Dict<string, Col> byCol;
    public string selList;
    public bool frozen;

    public Meta(string entity, string table) {
        this.Entity = entity;
        this.Table = QueryBuilder.RequireIdent(table);
        this.Cols = new List<Col>();
        this.Navs = new List<Nav>();
        this.Idx = new List<Index>();
        this.byCol = new Dict<string, Col>();
        this.selList = "";
        this.frozen = false;
    }

    // 新建一个实体的元数据。
    public static Meta Of(string entity, string table) {
        return new Meta(entity, table);
    }

    // 基于原生运行时反射自动提取实体类型的元数据（表名、字段、类型与主键）。
    // 全局泛型单例缓存：进程启动后每类型仅构建并封存一次，高并发与高频查询 O(1) 零分配。
    public static Meta For<T>() {
        Meta cached = MetaCache<T>.Meta;
        if (cached != null) {
            return cached;
        }
        cached = Meta.BuildFor<T>();
        MetaCache<T>.Meta = cached;
        return cached;
    }

    public static Meta BuildFor<T>() {
        TypeInfo ti = typeof(T);
        string tbl = ti.TableName;
        if (tbl.Length == 0) {
            tbl = ti.Name;
        }
        Meta meta = new Meta(ti.Name, tbl);
        meta.Type = ti;
        for (int i = 0; i < ti.FieldCount; i = i + 1) {
            if (ti.IsFieldIgnored(i)) {
                continue;
            }
            string fname = ti.GetFieldName(i);
            string colName = ti.GetFieldCustomName(i);
            if (colName.Length == 0) {
                colName = fname;
            }
            string ftype = ti.GetFieldType(i);
            int kind = 0;
            bool i64 = false;
            if (ftype == "string") {
                kind = 3;
            } else if (ftype == "double" || ftype == "float") {
                kind = 1;
            } else if (ftype == "bool") {
                kind = 2;
            } else if (ftype == "long" || ftype == "ulong") {
                kind = 0;
                i64 = true;
            } else if (ftype == "int" || ftype == "uint" || ftype == "short" || ftype == "ushort" || ftype == "byte" || ftype == "sbyte") {
                kind = 0;
            } else {
                // 实体引用（GetFieldTypeInfo 有名字且不是枚举）= 导航属性：
                // 登记反向关系（Children/ChildrenOf 反推用），不作为物理
                // 数据库列；枚举按 int 处理。
                TypeInfo navTi = ti.GetFieldTypeInfo(i);
                if (navTi.Name.Length > 0 && navTi.Kind != "enum") {
                    meta.Navs.Add(new Nav(fname, ftype));
                    continue;
                }
                kind = 0;
            }
            // 主键只认声明，不按字段名猜：「叫 id 就是主键」是隐式约定，
            // 把普通业务列静默升格成主键既不可见也不可控。声明形态两种：
            // [Key] / [PrimaryKey] / [Column(IsPrimary: true)] 走显式主键
            // 位（可多列组成复合主键）；[Column(IsIdentity: true)] 走自增
            // 位，同时本身就是主键声明——自增列在 SQLite 里只有
            // INTEGER PRIMARY KEY AUTOINCREMENT 一种合法形态，生态既有
            // 实体也只写 IsIdentity 不写 IsPrimary。
            bool isIdent = ti.IsFieldIdentity(i);
            bool isPk = isIdent || ti.IsFieldPk(i);
            int strLen = 255;
            if (kind == 3) {
                // 反射属性格式为 Column.StringLength=4096;Column.DbType=text;。
                // text 优先于有界长度，不依赖负数属性的序列化。
                bool largeText = false;
                List<string> attrs = ti.GetFieldCustomAttributes(i).Split(";");
                for (int a = 0; a < attrs.Count; a = a + 1) {
                    string attr = attrs[a].Trim();
                    if (attr == "Column.DbType=text") { largeText = true; }
                    else if (attr.StartsWith("Column.StringLength=")) {
                        int declaredLength = 0;
                        if (int.TryParse(attr.Substring(20), out declaredLength)
                            && declaredLength > 0) { strLen = declaredLength; }
                    }
                }
                if (largeText) { strLen = -1; }
            }
            meta.Col(colName, fname, kind, i64, isPk, isIdent, false, strLen);
        }
        meta.Seal();
        return meta;
    }

    // 封存元数据：<see cref="Seal"/> 之后的构建调用一律
    // 抛异常。生成的代码在元数据建成并发布到静态缓存前调用它，
    // 保证运行期描述不会被后续代码悄悄改形。
    public Meta Seal() {
        this.frozen = true;
        return this;
    }

    // 封存后的构建调用统一经此拒绝。
    public void CheckNotFrozen() {
        if (this.frozen) {
            throw new Exception(this.Entity
                + " metadata is sealed; Col/Nav/Index are build-time only");
        }
    }

    // 追加一列（按实体字段声明顺序）。
    public Meta Col(string col, string field, int kind, bool i64, bool pk,
                bool ident, bool notNull, int len) {
        this.CheckNotFrozen();
        Col c = new Col(QueryBuilder.RequireIdent(col), field, kind,
                              i64, pk, ident, notNull, len);
        this.Cols.Add(c);
        this.byCol.Add(col, c);
        return this;
    }

    // 追加一个导航字段，返回它以便继续追加它的列。
    public Nav Nav(string field, string table) {
        this.CheckNotFrozen();
        Nav n = new Nav(field, table);
        this.Navs.Add(n);
        return n;
    }

    // 追加一条索引声明。
    public Meta Index(string name, string cols, bool uniq) {
        this.CheckNotFrozen();
        QueryBuilder.RequireIdent(name);
        List<string> parts = cols.Split(",");
        for (int i = 0; i < parts.Count; i = i + 1) {
            QueryBuilder.RequireIdent(parts[i].Trim());
        }
        this.Idx.Add(new Index(name, cols, uniq));
        return this;
    }

    // 列描述，不存在时为 null。
    public Col Find(string c) {
        Col v;
        if (this.byCol.TryGetValue(c, out v)) { return v; }
        return null;
    }

    // 列是否属于本实体。
    public bool Has(string c) { return this.Find(c) != null; }

    // 列的声明类型（DbParams.Kind*），不存在时 KindNull。
    public int KindOf(string c) {
        Col f = this.Find(c);
        if (f == null) { return DbParams.KindNull; }
        return f.PKind();
    }

    // 校验列名属于本实体，动态列集合的唯一入口。
    public string Require(string c) {
        string n = c;
        if (n.Length > 2 && n.IndexOf("t.") == 0) { n = n.Substring(2); }
        if (!this.Has(n)) {
            throw new Exception(this.Entity + " has no column: " + c);
        }
        return n;
    }

    // `t.a, t.b` —— 实体自身列的 SELECT 片段（按方言转义）。
    public string SelectList(int p) {
        string s = "";
        for (int i = 0; i < this.Cols.Count; i = i + 1) {
            if (i > 0) { s = s + ", "; }
            s = s + "t." + Dialect.QuoteIdentifier(p, this.Cols[i].Col);
        }
        return s;
    }

    public string SelectList() {
        return this.SelectList(DbProvider.SQLite);
    }

    // 主键列名（声明顺序）。
    public List<string> PkCols() {
        List<string> k = new List<string>();
        for (int i = 0; i < this.Cols.Count; i = i + 1) {
            if (this.Cols[i].IsPk) { k.Add(this.Cols[i].Col); }
        }
        return k;
    }

    // UPDATE ... WHERE 用的定位列：最后一个主键列，
    // 没有主键时为 null（与实体链的既有语义一致）。
    public Col PkCol() {
        Col pk = null;
        for (int i = 0; i < this.Cols.Count; i = i + 1) {
            if (this.Cols[i].IsPk) { pk = this.Cols[i]; }
        }
        return pk;
    }

    // 复合主键的表级约束列清单（两列及以上才有；
    // identity 列自带 PRIMARY KEY，不参与）。
    public string PkList() {
        string s = "";
        int n = 0;
        for (int i = 0; i < this.Cols.Count; i = i + 1) {
            Col c = this.Cols[i];
            if (!c.IsPk || c.IsIdent) { continue; }
            if (n > 0) { s = s + ", "; }
            s = s + c.Col;
            n = n + 1;
        }
        if (n < 2) { return ""; }
        return s;
    }

}

public class MetaCache<T> {
    public static Meta Meta = Meta.BuildFor<T>();
}

