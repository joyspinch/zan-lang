using System;
using System.Data;
namespace System.Data.Orm;

public class UnitOfWork : IUnitOfWork {
    public IDbConnection conn;
    public DbPool pool;
    public bool committed;
    public bool rolledBack;
    public bool closeOnDispose;

    // 活着的保存点（按建立顺序）。事务结束时一并作废。
    public List<string> savepoints;

    public UnitOfWork(IDbConnection conn, bool closeOnDispose) {
        this.conn = conn;
        this.pool = null;
        this.committed = false;
        this.rolledBack = false;
        this.closeOnDispose = closeOnDispose;
        this.savepoints = new List<string>();
        if (this.conn != null) {
            this.conn.BeginTransaction();
        }
    }

    public UnitOfWork(IDbConnection conn, DbPool pool, bool closeOnDispose) {
        this.conn = conn;
        this.pool = pool;
        this.committed = false;
        this.rolledBack = false;
        this.closeOnDispose = closeOnDispose;
        this.savepoints = new List<string>();
        if (this.conn != null) {
            this.conn.BeginTransaction();
        }
    }

    public static UnitOfWork Create(IDbConnection conn, bool closeOnDispose) {
        return new UnitOfWork(conn, closeOnDispose);
    }

    public static UnitOfWork Create(IDbConnection conn, DbPool pool, bool closeOnDispose) {
        return new UnitOfWork(conn, pool, closeOnDispose);
    }

    public static async UnitOfWork CreateAsync(IDbConnection conn, bool closeOnDispose) {
        return await UnitOfWork.CreateAsync(conn, null, closeOnDispose);
    }

    public static async UnitOfWork CreateAsync(IDbConnection conn, DbPool pool, bool closeOnDispose) {
        UnitOfWork uow = new UnitOfWork(null, pool, closeOnDispose);
        uow.conn = conn;
        if (conn != null) {
            try {
                await conn.BeginTransactionAsync();
            } catch (Exception ex) {
                if (pool != null) {
                    pool.Release(conn);
                } else if (closeOnDispose) {
                    conn.Close();
                }
                throw ex;
            }
        }
        return uow;
    }

    public IDbConnection GetConnection() {
        return this.conn;
    }

    // ---- 保存点（savepoint）----
    //
    // 在一条事务里划出可回滚的子段：建立 →（写入）→ 回滚到 / 释放。
    // 语义与 SQL 一致，见 Savepoint 与 ISavepointScope。

    // 事务还没结束、连接还在，才能操作保存点。
    void SpCheckLive() {
        if (this.conn == null) {
            throw new Exception("没有连接，不能操作保存点");
        }
        if (this.committed || this.rolledBack) {
            throw new Exception("事务已结束，不能再操作保存点");
        }
    }

    // 该连接的后端（决定保存点方言）。
    int SpProvider() {
        if (this.conn == null) { return DbProvider.Unknown; }
        return this.conn.GetProvider();
    }

    // 账本里有没有这个保存点。
    bool SpHas(string n) {
        for (int i = 0; i < this.savepoints.Count; i = i + 1) {
            if (this.savepoints[i] == n) { return true; }
        }
        return false;
    }

    // 建立保存点。
    public void CreateSavepoint(string name) {
        string n = Savepoint.Name(name);
        this.SpCheckLive();
        if (this.SpHas(n)) {
            throw new Exception("保存点 " + n + " 已经存在");
        }
        this.conn.Execute(Savepoint.CreateSql(this.SpProvider(), n));
        this.savepoints.Add(n);
    }

    // 回滚到保存点：该点之后的写入撤销，保存点本身仍然活着（还能再回滚一次）。
    public void RollbackToSavepoint(string name) {
        string n = Savepoint.Name(name);
        this.SpCheckLive();
        if (!this.SpHas(n)) {
            throw new Exception("没有名为 " + n + " 的保存点");
        }
        this.conn.Execute(Savepoint.RollbackSql(this.SpProvider(), n));
    }

    // 释放保存点：之后不能再回滚到它。
    public void ReleaseSavepoint(string name) {
        string n = Savepoint.Name(name);
        this.SpCheckLive();
        if (!this.SpHas(n)) {
            throw new Exception("没有名为 " + n + " 的保存点");
        }
        string sql = Savepoint.ReleaseSql(this.SpProvider(), n);
        // 该后端没有释放语句时（SQL Server / Oracle 家族）只做本地记账。
        if (sql.Length > 0) {
            this.conn.Execute(sql);
        }
        this.savepoints.Remove(n);
    }

    // 异步版本。
    public async bool CreateSavepointAsync(string name) {
        string n = Savepoint.Name(name);
        this.SpCheckLive();
        if (this.SpHas(n)) {
            throw new Exception("保存点 " + n + " 已经存在");
        }
        await this.conn.ExecuteAsync(Savepoint.CreateSql(this.SpProvider(), n));
        this.savepoints.Add(n);
        return true;
    }

    public async bool RollbackToSavepointAsync(string name) {
        string n = Savepoint.Name(name);
        this.SpCheckLive();
        if (!this.SpHas(n)) {
            throw new Exception("没有名为 " + n + " 的保存点");
        }
        await this.conn.ExecuteAsync(Savepoint.RollbackSql(this.SpProvider(), n));
        return true;
    }

    public async bool ReleaseSavepointAsync(string name) {
        string n = Savepoint.Name(name);
        this.SpCheckLive();
        if (!this.SpHas(n)) {
            throw new Exception("没有名为 " + n + " 的保存点");
        }
        string sql = Savepoint.ReleaseSql(this.SpProvider(), n);
        if (sql.Length > 0) {
            await this.conn.ExecuteAsync(sql);
        }
        this.savepoints.Remove(n);
        return true;
    }

    public void Commit() {
        if (!this.committed && !this.rolledBack && this.conn != null) {
            this.conn.Commit();
            this.committed = true;
            // 事务结束，保存点随之全部作废。
            this.savepoints = new List<string>();
        }
    }

    public void Rollback() {
        if (!this.committed && !this.rolledBack && this.conn != null) {
            try {
                this.conn.Rollback();
            } catch (Exception _ex) {
                // 部分纯异步驱动（如协程化 MySQL/PG）同步 Rollback 会 throw Sync()；
                // 捕获避免破坏 Dispose 清理流程。
            }
            this.rolledBack = true;
            this.savepoints = new List<string>();
        }
    }

    public async bool CommitAsync() {
        if (!this.committed && !this.rolledBack && this.conn != null) {
            bool ok = await this.conn.CommitAsync();
            this.committed = true;
            this.savepoints = new List<string>();
            return ok;
        }
        return false;
    }

    public async bool RollbackAsync() {
        if (!this.committed && !this.rolledBack && this.conn != null) {
            bool ok = await this.conn.RollbackAsync();
            this.rolledBack = true;
            this.savepoints = new List<string>();
            return ok;
        }
        return false;
    }

    public void Dispose() {
        if (!this.committed && !this.rolledBack) {
            this.Rollback();
        }
        if (this.conn != null) {
            if (this.pool != null) {
                this.pool.Release(this.conn);
                this.conn = null;
            } else if (this.closeOnDispose) {
                this.conn.Close();
                this.conn = null;
            }
        }
    }

    ~UnitOfWork() {
        this.Dispose();
    }

    // IDbExecutor 实现
    public DbResult Query(string sql, DbParams prms) { return this.conn.Query(sql, prms); }
    public int Execute(string sql, DbParams prms) { return this.conn.Execute(sql, prms); }
    public DbResult Query(string sql) { return this.conn.Query(sql); }
    public int Execute(string sql) { return this.conn.Execute(sql); }
    public string ExecuteScalar(string sql) { return this.conn.ExecuteScalar(sql); }
    public string ExecuteScalar(string sql, DbParams prms) { return this.conn.ExecuteScalar(sql, prms); }
    public int GetProvider() { return this.conn.GetProvider(); }

    public async DbResult QueryAsync(string sql, DbParams prms) { return await this.conn.QueryAsync(sql, prms); }
    public async int ExecuteAsync(string sql, DbParams prms) { return await this.conn.ExecuteAsync(sql, prms); }
    public async DbResult QueryAsync(string sql) { return await this.conn.QueryAsync(sql); }
    public async int ExecuteAsync(string sql) { return await this.conn.ExecuteAsync(sql); }
    public async string ExecuteScalarAsync(string sql) { return await this.conn.ExecuteScalarAsync(sql); }
    public async string ExecuteScalarAsync(string sql, DbParams prms) { return await this.conn.ExecuteScalarAsync(sql, prms); }
}
