using System;
using System.Data;
using System.Data.Sqlite;

namespace System.Data.Orm;

/// <summary>
/// FreeSql 构建器：流式配置并创建 IFreeSql 实例。
/// 示例：
/// IFreeSql fsql = new FreeSqlBuilder()
/// .UseConnection(db)
/// .Build();
/// </summary>
class FreeSqlBuilder {
    IDbConnection conn;
    DbPool pool;
    int provider;
    string connectionString;
    bool autoSyncStructure;

    FreeSqlBuilder() {
        this.conn = null;
        this.pool = null;
        this.provider = 0;
        this.connectionString = "";
        this.autoSyncStructure = false;
    }

    FreeSqlBuilder UseConnection(IDbConnection conn) {
        this.conn = conn;
        return this;
    }

    FreeSqlBuilder UsePool(DbPool pool) {
        this.pool = pool;
        return this;
    }

    FreeSqlBuilder UseConnectionString(int provider, string connectionString) {
        this.provider = provider;
        this.connectionString = connectionString;
        return this;
    }

    FreeSqlBuilder UseAutoSyncStructure(bool autoSync) {
        this.autoSyncStructure = autoSync;
        return this;
    }

    IFreeSql Build() {
        if (this.conn != null) {
            return new FreeSql(this.conn);
        }
        if (this.pool != null) {
            return new FreeSql(this.pool);
        }
        if (this.provider == DbProvider.SQLite && this.connectionString.Length > 0) {
            SqliteConnection c = SqliteConnection.Open(this.connectionString);
            return new FreeSql(c);
        }
        throw new Exception("FreeSqlBuilder: no valid connection or pool configured");
    }
}
