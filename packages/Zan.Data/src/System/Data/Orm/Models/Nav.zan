using System;
using System.Data;
namespace System.Data.Orm;

public class Nav {
    public string Field;
    public string Table;
    public List<Col> Cols;
    public int PkAt;  // Cols 中 id 列的下标（没有 id 时为 0）

    public Nav(string field, string table) {
        this.Field = field;
        this.Table = QueryBuilder.RequireIdent(table);
        this.Cols = new List<Col>();
        this.PkAt = 0;
    }

    // 追加一列被连接实体的列。
    public Nav Col(string col, string field, int kind, bool i64) {
        this.Cols.Add(new Col(QueryBuilder.RequireIdent(col), field, kind,
                                 i64, false, false, false, 0));
        if (field == "id") { this.PkAt = this.Cols.Count - 1; }
        return this;
    }

    // `j_<Field>.a, j_<Field>.b` —— 连接列的 SELECT 片段。
    public string SelectList() {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < this.Cols.Count; i = i + 1) {
            sb.Append(", j_" + this.Field + "." + this.Cols[i].Col);
        }
        return sb.ToString();
    }

    // 连接子句。
    public string Join() {
        return " LEFT JOIN " + this.Table + " j_" + this.Field + " ON t."
            + this.Field + "Id = j_" + this.Field + ".id";
    }
}

// 实体上声明的二级索引。
