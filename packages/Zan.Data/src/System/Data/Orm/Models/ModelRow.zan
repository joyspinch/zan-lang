using System;
using System.Data;
using System.Data.Orm;
using System.Json;
namespace System.Data.Orm;

public class ModelRow {
    public List<ModelCell> cells;

    // 构造空行。
    public ModelRow() {
        this.cells = new List<ModelCell>();
    }

    // 设置行上的一个值。
    public ModelRow Set(string key, string val) {
        foreach (ModelCell cell in this.cells) {
            if (cell.key == key) {
                cell.val = val;
                return this;
            }
        }
        this.cells.Add(new ModelCell(key, val));
        return this;
    }

    // 设置一个整数值。
    public ModelRow SetInt(string key, int val) {
        return Set(key, Convert.ToString(val));
    }

    // 按键获取字符串值。
    public string Get(string key) {
        foreach (ModelCell cell in this.cells) {
            if (cell.key == key) { return cell.val; }
        }
        return "";
    }

    // 按键获取整数值。
    public int GetInt(string key) {
        string val = Get(key);
        if (val.Length == 0) { return 0; }
        return Convert.ToInt(val);
    }

    // 检查行中是否存在某个键。
    public bool Has(string key) {
        foreach (ModelCell cell in this.cells) {
            if (cell.key == key) { return true; }
        }
        return false;
    }

    // 按插入顺序返回所有键。
    public List<string> GetKeys() {
        List<string> keys = new List<string>();
        foreach (ModelCell cell in this.cells) { keys.Add(cell.key); }
        return keys;
    }

    // 按插入顺序返回所有值。
    public List<string> GetValues() {
        List<string> values = new List<string>();
        foreach (ModelCell cell in this.cells) { values.Add(cell.val); }
        return values;
    }

    // 从 DbResult 的一行创建 ModelRow。
    public static ModelRow FromDbResult(DbResult result, int rowIndex) {
        ModelRow row = new ModelRow();
        List<string> columns = result.GetColumnNames();
        for (int c = 0; c < columns.Count; c = c + 1) {
            row.Set(columns[c], result.GetString(rowIndex, c));
        }
        return row;
    }

    // 从 DbResult 的所有行创建 ModelRow 列表。
    public static List<ModelRow> FromDbResultAll(DbResult result) {
        List<ModelRow> rows = new List<ModelRow>();
        for (int r = 0; r < result.RowCount(); r = r + 1) {
            rows.Add(FromDbResult(result, r));
        }
        return rows;
    }

    // 将行转换为 JSON 字符串。
    public string ToJson() {
        JsonWriter w = new JsonWriter();
        w.StartObject();
        foreach (ModelCell cell in this.cells) {
            w.WriteProperty(cell.key, cell.val);
        }
        w.EndObject();
        return w.ToJson();
    }
}

// 模型级 SELECT 查询构建器。
