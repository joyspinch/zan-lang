using System;
using System.Data;
namespace System.Data.Orm;

class OrmDelete {
    IDbExecutor db;
    OrmMeta meta;
    string tbl;
    string w;
    DbParams ps;
    bool on;

    // 私有构造；统一经 <see cref="Create"/> 创建。
    OrmDelete(IDbExecutor db, OrmMeta meta) {
        this.db = db;
        this.meta = meta;
        this.tbl = meta.Table;
        this.w = "";
        this.ps = new DbParams();
        this.on = true;
    }

    // 为实体创建一个空 DELETE 构造器。
    static OrmDelete Create(IDbExecutor db, OrmMeta meta) {
        return new OrmDelete(db, meta);
    }

    // 改写到另一张表（标识符校验，防注入）。
    void AsTable(string t) { this.tbl = QueryBuilder.RequireIdent(t); }
    // 条件开关：false 期间 W/P* 收集的片段全部失效（ORM 内部
    // 按条件组合调用，应用层一般不直接用）。
    void CondBegin(bool c) { this.on = c; }
    // 结束条件区间，恢复片段收集。
    void CondEnd() { this.on = true; }

    // WHERE 片段：多个片段以 AND 连接。
    void W(string f) {
        if (!this.on) { return; }
        string u = OrmDialect.Unalias(f);
        if (this.w.Length == 0) { this.w = u; }
        else { this.w = this.w + " AND " + u; }
    }

    // 字典键值批量进 WHERE（等值条件，列名经元数据校验）。
    void WhereDict(DbValues v) {
        if (!this.on) { return; }
        for (int i = 0; i < v.Count(); i = i + 1) {
            string c = this.meta.Require(v.NameAt(i));
            this.W(c + " = ?");
            v.BindAs(this.ps, i, this.meta.KindOf(c));
        }
    }

    /* ---- 值自带条件原语：条件与值同一次调用原子绑定。单表 DELETE
     * 没有 "t." 别名，列名按实体校验（多余前缀剥掉），未知列抛异常。 */

    // 校验列名属于本实体（剥掉可选的 "t." 前缀）；未知列抛异常。
    string RequireCol(string c) {
        string n = c;
        if (n.Length > 2 && n.IndexOf("t.") == 0) { n = n.Substring(2); }
        if (!this.meta.Has(n)) {
            throw new Exception(this.meta.Table + " has no column: " + c);
        }
        return n;
    }

    // column = 文本值。
    void WhereEq(string c, string v) {
        if (!this.on) { return; }
        this.W(this.RequireCol(c) + " = ?");
        this.ps.Add(v);
    }

    // column = 整数值。
    void WhereEq(string c, int v) {
        if (!this.on) { return; }
        this.W(this.RequireCol(c) + " = ?");
        this.ps.AddInt(v);
    }

    // column = 64 位整数值。
    void WhereEq(string c, long v) {
        if (!this.on) { return; }
        this.W(this.RequireCol(c) + " = ?");
        this.ps.AddLong(v);
    }

    // column IN (逐个占位符)；空列表按恒假处理，不生成 `IN ()`。
    void WhereIn(string c, List<int> vs) {
        if (!this.on) { return; }
        if (vs.Count == 0) { this.W("1 = 0"); return; }
        StringBuilder sb = new StringBuilder();
        sb.Append(this.RequireCol(c) + " IN (");
        for (int i = 0; i < vs.Count; i = i + 1) {
            if (i > 0) { sb.Append(", "); }
            sb.Append("?");
            this.ps.AddInt(vs[i]);
        }
        sb.Append(")");
        this.W(sb.ToString());
    }

    // <see cref="WhereIn"/> 的 long 版本。
    void WhereIn(string c, List<long> vs) {
        if (!this.on) { return; }
        if (vs.Count == 0) { this.W("1 = 0"); return; }
        StringBuilder sb = new StringBuilder();
        sb.Append(this.RequireCol(c) + " IN (");
        for (int i = 0; i < vs.Count; i = i + 1) {
            if (i > 0) { sb.Append(", "); }
            sb.Append("?");
            this.ps.AddLong(vs[i]);
        }
        sb.Append(")");
        this.W(sb.ToString());
    }

    // <see cref="WhereIn"/> 的 string 版本。
    void WhereIn(string c, List<string> vs) {
        if (!this.on) { return; }
        if (vs.Count == 0) { this.W("1 = 0"); return; }
        StringBuilder sb = new StringBuilder();
        sb.Append(this.RequireCol(c) + " IN (");
        for (int i = 0; i < vs.Count; i = i + 1) {
            if (i > 0) { sb.Append(", "); }
            sb.Append("?");
            this.ps.Add(vs[i]);
        }
        sb.Append(")");
        this.W(sb.ToString());
    }

    // 恒假条件：数据边界为空集时用它表达"一行都不许删"。
    void WhereNone() {
        if (!this.on) { return; }
        this.W("1 = 0");
    }

    // WHERE 参数：与 W 片段中占位符的出现顺序一致。
    void P(string v) { if (this.on) { this.ps.Add(v); } }
    // WHERE 整数参数。
    void Pi(int v) { if (this.on) { this.ps.AddInt(v); } }
    // WHERE 64 位整数参数。
    void Pl(long v) { if (this.on) { this.ps.AddLong(v); } }
    // WHERE 浮点参数。
    void Pd(double v) { if (this.on) { this.ps.AddDouble(v); } }

    // IN 列表参数（配合 W 片段里的 "col IN (?)"）。
    void InI(List<int> vs) {
        if (!this.on) { return; }
        for (int i = 0; i < vs.Count; i = i + 1) { this.ps.AddInt(vs[i]); }
    }

    // <see cref="InI"/> 的 long 版本。
    void InL(List<long> vs) {
        if (!this.on) { return; }
        for (int i = 0; i < vs.Count; i = i + 1) { this.ps.AddLong(vs[i]); }
    }

    // <see cref="InI"/> 的 string 版本。
    void InS(List<string> vs) {
        if (!this.on) { return; }
        for (int i = 0; i < vs.Count; i = i + 1) { this.ps.Add(vs[i]); }
    }

    // <see cref="InI"/> 的 double 版本。
    void InD(List<double> vs) {
        if (!this.on) { return; }
        for (int i = 0; i < vs.Count; i = i + 1) { this.ps.AddDouble(vs[i]); }
    }

    // 执行 DELETE 并返回受影响行数；无 WHERE 时不执行（不生成
    // 全表删除）。
    int ExecuteAffrows() {
        if (this.w.Length == 0) { return 0; }
        string sql = "DELETE FROM " + this.tbl + " WHERE " + this.w;
        return this.db.Execute(sql, this.ps);
    }

    // 异步执行 DELETE。
    async int ExecuteAffrowsAsync() {
        if (this.w.Length == 0) { return 0; }
        string sql = "DELETE FROM " + this.tbl + " WHERE " + this.w;
        return await this.db.ExecuteAsync(sql, this.ps);
    }
}
