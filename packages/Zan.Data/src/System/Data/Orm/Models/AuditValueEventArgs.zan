using System;
using System.Data;
namespace System.Data.Orm;

public class AuditValueEventArgs {
    public string table;
    public string column;
    public object val;
    public bool isInsert;

    public AuditValueEventArgs(string table, string column, object val, bool isInsert) {
        this.table = table;
        this.column = column;
        this.val = val;
        this.isInsert = isInsert;
    }

    public string Table { get { return this.table; } }
    public string Column { get { return this.column; } }
    public object Value { get { return this.val; } set { this.val = value; } }
    public bool IsInsert { get { return this.isInsert; } }
}

