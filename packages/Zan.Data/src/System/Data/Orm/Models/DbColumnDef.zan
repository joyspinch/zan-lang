using System;
using System.Data;
using System.Data.Orm;
using System.Text;
namespace System.Data.Orm;

class DbColumnDef {
    string name;
    string kind;
    int size;
    bool nullable;
    bool identity;
    string defText;

    DbColumnDef(string name, string kind) {
        this.name = QueryBuilder.RequireIdent(name);
        this.kind = kind;
        this.size = 0;
        this.nullable = true;
        this.identity = false;
        this.defText = "";
    }

    // 一个普通列。
    static DbColumnDef Of(string name, string kind) {
        return new DbColumnDef(name, kind);
    }

    // 自增整型主键列（每家方言写法不同，这里只表达意图）。
    static DbColumnDef Identity(string name) {
        DbColumnDef c = new DbColumnDef(name, "int");
        c.identity = true;
        c.nullable = false;
        return c;
    }

    // 字符串列的宽度（其余类型忽略；&lt;= 0 表示按默认 255）。
    DbColumnDef WithSize(int n) { this.size = n; return this; }

    // 可空性。
    DbColumnDef WithNull(bool ok) { this.nullable = ok; return this; }

    DbColumnDef NotNull() { this.nullable = false; return this; }

    // 默认值，按逻辑类型校验后写成字面量：数值类型只接受
    // 数字，其余按文本加引号（引号翻倍）。无法用作字面量时忽略。
    // DDL 里没有参数占位，默认值只能内联，所以这一步的校验就是
    // 这里唯一的防线。
    DbColumnDef WithDefault(string v) { this.defText = v; return this; }

    // 列名（构造时已通过标识符校验）。
    string Name() { return this.name; }
}

// 库表层面的内省与运维动作：一张表在不在、有哪些列、改个名、丢掉、
// 以及 SQLite 的写前日志。CodeFirst（`SyncStructure&lt;T&gt;()`）负责
// 让实体对应的表长成实体的样子，这里补的是它管不到的那一半：一个
// 更早版本留下的表要不要让路、一个诊断库要不要开 WAL。
// 为什么在标准库而不是业务里：这些语句每家方言都不一样（SQLite 问
// `sqlite_master` 和 `PRAGMA`，别家问 `information_schema`），业务
// 代码不该知道自己跑在谁上面，也不该自己拼语句。表名一律按标识符
// 校验后才进语句，其余全部走参数。
