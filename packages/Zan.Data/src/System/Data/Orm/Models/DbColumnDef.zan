using System;
using System.Data;
using System.Data.Orm;
using System.Text;
namespace System.Data.Orm;

public class DbColumnDef {
    public string name;
    public string kind;
    public int size;
    public bool nullable;
    public bool identity;
    public string defText;

    public DbColumnDef(string name, string kind) {
        this.name = QueryBuilder.RequireIdent(name);
        this.kind = kind;
        this.size = 0;
        this.nullable = true;
        this.identity = false;
        this.defText = "";
    }

    // 一个普通列。
    public static DbColumnDef Of(string name, string kind) {
        return new DbColumnDef(name, kind);
    }

    // 自增整型主键列（每家方言写法不同，这里只表达意图）。
    public static DbColumnDef Identity(string name) {
        DbColumnDef c = new DbColumnDef(name, "int");
        c.identity = true;
        c.nullable = false;
        return c;
    }

    // 字符串列的宽度（其余类型忽略；<= 0 表示按默认 255）。
    public DbColumnDef WithSize(int n) { this.size = n; return this; }

    // 可空性。
    public DbColumnDef WithNull(bool ok) { this.nullable = ok; return this; }

    public DbColumnDef NotNull() { this.nullable = false; return this; }

    // 默认值，按逻辑类型校验后写成字面量：数值类型只接受
    // 数字，其余按文本加引号（引号翻倍）。无法用作字面量时忽略。
    // DDL 里没有参数占位，默认值只能内联，所以这一步的校验就是
    // 这里唯一的防线。
    public DbColumnDef WithDefault(string v) { this.defText = v; return this; }

    // 列名（构造时已通过标识符校验）。
    public string Name() { return this.name; }
}
