using System;
using System.Data;
namespace System.Data.Orm;

public class Col {
    public string Col;  // 物理列名
    public string Field;  // 实体字段名（反射读写用）
    public int Kind;  // 0 int, 1 double, 2 bool, 3 string, 4 enum
    public bool I64;  // 声明类型是 64 位整数
    public bool IsPk;
    public bool IsIdent;
    public bool NotNull;
    public int StrLen;

    public Col(string col, string field, int kind, bool i64, bool pk, bool ident,
           bool notNull, int len) {
        this.Col = col;
        this.Field = field;
        this.Kind = kind;
        this.I64 = i64;
        this.IsPk = pk;
        this.IsIdent = ident;
        this.NotNull = notNull;
        this.StrLen = len;
    }

    // DDL 类型码（<see cref="Dialect.Ty"/>）：
    public int TyCode() {
        if (this.Kind == 1) { return 1; }
        if (this.Kind == 2) { return 2; }
        if (this.Kind == 3) { return 3; }
        if (this.Kind == 0 && this.I64) { return 4; }
        return 0;
    }

    // 动态值按列声明类型转换时用的 DbParams 类型码。
    public int PKind() {
        if (this.Kind == 1) { return DbParams.KindDouble; }
        if (this.Kind == 3) { return DbParams.KindText; }
        return DbParams.KindInt;
    }
}

// 导航字段（`[Column]` 之外的实体引用）的连接描述：
// 连接 `LEFT JOIN <Table> j_<Field> ON t.<Field>Id = j_<Field>.id`，
// 被包含时它的列跟在实体自身列之后。
