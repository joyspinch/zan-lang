using System;
using System.Data;
using System.Data.Orm;
using System.Json;
namespace System.Data.Orm;

public class ModelDelete {
    public IDbExecutor db;
    public QueryBuilder qb;

    // 记录执行器，条件构建复用 <see cref="QueryBuilder"/>。
    public ModelDelete(IDbExecutor db, string tableName) {
        this.db = db;
        this.qb = QueryBuilder.DeleteFrom(tableName);
    }

    // 为表开启 DELETE 构建。
    public static ModelDelete New(IDbExecutor db, string tableName) {
        return new ModelDelete(db, tableName);
    }

    // 追加原始条件（AND 连接）。
    public ModelDelete Where(string condition) {
        this.qb.Where(condition);
        return this;
    }

    // 追加 column = ?（绑定值）。
    public ModelDelete WhereEq(string column, string val) {
        this.qb.WhereEq(column, val);
        return this;
    }

    // 执行 DELETE 并返回受影响的行数。
    public int Execute() {
        return this.db.Execute(this.qb.BuildDeleteParams(), this.qb.SelectParams());
    }

    // <see cref="Execute"/> 的包装方法。
    public int ExecuteAsync() {
        return Execute();
    }
}

// 用于管理数据库 schema 演进的迁移辅助工具。
