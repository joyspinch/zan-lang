using System;
using System.Data;
using System.Data.Orm;
using System.Json;
namespace System.Data.Orm;

public class ModelCell {
    public string key;
    public string val;

    // 构造一个键值单元格。
    public ModelCell(string key, string val) {
        this.key = key;
        this.val = val;
    }
}

// 表示模型数据的单行（键值对）。
