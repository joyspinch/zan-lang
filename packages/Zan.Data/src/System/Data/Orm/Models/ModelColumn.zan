using System;
using System.Data;
using System.Data.Orm;
using System.Json;
namespace System.Data.Orm;

class ModelColumn {
    string name;
    string type;

    // 保存列名与完整类型文本（类型文本经 RequireDdlType 校验）。
    ModelColumn(string name, string type) {
        this.name = name;
        this.type = QueryBuilder.RequireDdlType(type);
    }
}

// 【已弃用 / 历史兼容】早期基于字符串字典的动态行模型。
// 现代 Zan 项目一律遵从正统 FreeSql 范式：
// 1. 使用强类型实体类标注 [Table] / [Column(IsIdentity=true)]；
// 2. 使用 IFreeSql 统一门面（FreeSqlBuilder / AppServices.Orm()）；
// 3. 使用 CodeFirst 同步结构（fsql.CodeFirst().SyncStructure<T>()）；
// 4. 使用 BaseRepository<T> 泛型仓储或 fsql.Select<T>() / Insert<T>() / Update<T>() / Delete<T>()；
// 5. 详见 examples/db/orm_model.zan 与 tests/conformance/orm_freesql.zan。
