using System;
using System.Data;
using System.Data.Orm;
using System.Json;
namespace System.Data.Orm;

public class ModelColumn {
    public string name;
    public string type;

    // 保存列名与完整类型文本（类型文本经 RequireDdlType 校验）。
    public ModelColumn(string name, string type) {
        this.name = name;
        this.type = QueryBuilder.RequireDdlType(type);
    }
}

// 【已弃用 / 历史兼容】早期基于字符串字典的动态行模型。
// 现代 Zan 项目走强类型 ORM：实体类用 [Table] / [Column(...)] 标注，
// 经 IZanSql 门面（ZanSql.FromConnection / AppServices.Orm()）操作，
// 结构同步用 zsql.SyncStructure<T>()（DbExtensions 的扩展方法），
// 读写走 BaseRepository<T> 泛型仓储或 zsql.Select<T>() / Insert<T>() / Update<T>() / Delete<T>()。
// 完整示例见 examples/db/Program.zan 与 tests/conformance/orm_zansql.zan。
