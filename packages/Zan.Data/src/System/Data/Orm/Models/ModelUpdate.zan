using System;
using System.Data;
using System.Data.Orm;
using System.Json;
namespace System.Data.Orm;

class ModelUpdate {
    IDbExecutor db;
    QueryBuilder qb;

    // 记录执行器，条件与赋值构建复用 <see cref="QueryBuilder"/>。
    ModelUpdate(IDbExecutor db, string tableName) {
        this.db = db;
        this.qb = QueryBuilder.Update(tableName);
    }

    // 为表开启 UPDATE 构建。
    static ModelUpdate New(IDbExecutor db, string tableName) {
        return new ModelUpdate(db, tableName);
    }

    // 设置 column = ?（绑定值）。
    ModelUpdate Set(string column, string val) {
        this.qb.Set(column, val);
        return this;
    }

    // 设置 column = ?（绑定整数）。
    ModelUpdate SetInt(string column, int val) {
        this.qb.SetInt(column, val);
        return this;
    }

    // 追加原始条件（AND 连接）。
    ModelUpdate Where(string condition) {
        this.qb.Where(condition);
        return this;
    }

    // 追加 column = ?（绑定值）。
    ModelUpdate WhereEq(string column, string val) {
        this.qb.WhereEq(column, val);
        return this;
    }

    // 执行 UPDATE 并返回受影响的行数。
    int Execute() {
        return this.db.Execute(this.qb.BuildUpdateParams(), this.qb.UpdateParams());
    }

    // <see cref="Execute"/> 的包装方法。
    int ExecuteAsync() {
        return Execute();
    }
}

