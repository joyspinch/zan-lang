using System;
using System.Data;
using System.Data.Orm;
using System.Json;
namespace System.Data.Orm;

public class Migration {
    public string name;
    public string upSql;
    public string downSql;

    // 保存迁移名与 UP/DOWN SQL；外部经 <see cref="New"/> 构造。
    public Migration(string name, string up, string down) {
        this.name = name;
        this.upSql = up;
        this.downSql = down;
    }

    // 创建一条迁移。
    public static Migration New(string name, string up, string down) {
        return new Migration(name, up, down);
    }

    // 执行一条迁移语句；执行器以负数报告失败时抛出
    // <see cref="DbException"/>——迁移绝不能悄悄落空，
    // 否则记录表照样登记，失败被永久掩盖（内置驱动语句失败
    // 本就直接抛，这里给不抛异常的自定义执行器兜底）。
    public static int Exec(IDbExecutor db, string sql) {
        int n = db.Execute(sql);
        if (n < 0) {
            throw new DbException("statement failed: " + sql, 0,
                                  DbProvider.Unknown);
        }
        return n;
    }

    // 执行迁移（运行 UP SQL）。
    public void Up(IDbExecutor db) {
        Migration.Exec(db, this.upSql);
    }

    // 回退迁移（运行 DOWN SQL）。
    public void Down(IDbExecutor db) {
        Migration.Exec(db, this.downSql);
    }

    // 确保迁移记录表存在。SQLite 可以以
    // TEXT 为键；MySQL/MariaDB 禁止无长度前缀的 TEXT 作键，因此它们
    // 使用 VARCHAR(255)。
    public static void EnsureTable(IDbExecutor db) {
        int p = db.GetProvider();
        if (p == DbProvider.MySQL || p == DbProvider.MariaDB) {
            Migration.Exec(db, "CREATE TABLE IF NOT EXISTS _migrations "
                + "(name VARCHAR(255) PRIMARY KEY, applied_at VARCHAR(64))");
        } else {
            Migration.Exec(db, "CREATE TABLE IF NOT EXISTS _migrations "
                + "(name TEXT PRIMARY KEY, applied_at TEXT)");
        }
    }

    // 检查某个迁移是否已执行。
    public static bool IsApplied(IDbExecutor db, string name) {
        string result = db.ExecuteScalar(
            "SELECT COUNT(*) FROM _migrations WHERE name = ?",
            new DbParams().Add(name));
        return result == "1";
    }

    // 按顺序运行迁移列表。
    public static void RunAll(IDbExecutor db, List<Migration> migrations) {
        EnsureTable(db);
        for (int i = 0; i < migrations.Count; i = i + 1) {
            Migration m = migrations[i];
            if (!IsApplied(db, m.name)) {
                m.Up(db);
                int mark = db.Execute(
                    "INSERT INTO _migrations (name, applied_at) VALUES (?, 'now')",
                    new DbParams().Add(m.name));
                if (mark < 0) {
                    throw new DbException("recording the migration failed: "
                        + m.name, 0, DbProvider.Unknown);
                }
                Console.WriteLine("[Migration] Applied: " + m.name);
            }
        }
    }
}
