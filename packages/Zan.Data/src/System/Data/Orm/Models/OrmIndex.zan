using System;
using System.Data;
namespace System.Data.Orm;

public class OrmIndex {
    public string Name;
    public string Cols;
    public bool Unique;

    public OrmIndex(string name, string cols, bool uniq) {
        this.Name = name;
        this.Cols = cols;
        this.Unique = uniq;
    }
}

// 一个实体的全部运行期元数据。生成的代码为每个实体建一次并缓存，
// 之后所有 SELECT/INSERT/UPDATE/DELETE/CodeFirst 都读它。
