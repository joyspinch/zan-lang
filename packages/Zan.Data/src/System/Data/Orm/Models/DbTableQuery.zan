using System;
using System.Data;
namespace System.Data.Orm;

public class DbTableQuery {
    public IDbConnection conn;
    public QueryBuilder qb;
    public int limitVal;
    public int offsetVal;

    public DbTableQuery(IDbConnection conn, string table) {
        this.conn = conn;
        this.qb = QueryBuilder.From(table);
        this.limitVal = 0 - 1;
        this.offsetVal = 0 - 1;
    }

    // column = 文本值。
    public DbTableQuery WhereEq(string column, string val) {
        this.qb.WhereEq(column, val);
        return this;
    }

    // column = 整数值。
    public DbTableQuery WhereEq(string column, long val) {
        this.qb.WhereEqLong(column, val);
        return this;
    }

    // column >= 整数值。
    public DbTableQuery WhereGe(string column, long val) {
        this.qb.WhereGeLong(column, val);
        return this;
    }

    // column <= 整数值。
    public DbTableQuery WhereLe(string column, long val) {
        this.qb.WhereLeLong(column, val);
        return this;
    }

    // column LIKE %val%（子串匹配）。
    public DbTableQuery WhereContains(string column, string val) {
        this.qb.WhereContains(column, val);
        return this;
    }

    // DbValues 里的每一列都按等值匹配（提交上来的
    // 筛选表单原样交给 ORM）。
    public DbTableQuery WhereDict(DbValues cond) {
        for (int i = 0; i < cond.Count(); i = i + 1) {
            this.qb.WhereValueAt(cond, i);
        }
        return this;
    }

    // column IN (整型列表)，逐个占位符；空列表按恒假处理。
    public DbTableQuery WhereIn(string column, List<int> values) {
        this.qb.WhereInInts(column, values);
        return this;
    }

    // column IN (64 位整数列表)，逐个占位符；空列表按恒假处理。
    public DbTableQuery WhereIn(string column, List<long> values) {
        this.qb.WhereInLongs(column, values);
        return this;
    }

    // 升序排序。
    public DbTableQuery OrderBy(string column) {
        this.qb.OrderBy(column);
        return this;
    }

    // 降序排序。
    public DbTableQuery OrderByDesc(string column) {
        this.qb.OrderByDesc(column);
        return this;
    }

    // 白名单版排序（升序）：allowed 之外的列一律抛异常。
    // 排序列无法参数化，可能来自用户输入（?sort=）时必须持单。
    public DbTableQuery OrderBySafe(string column, List<string> allowed) {
        this.qb.OrderBySafe(column, allowed);
        return this;
    }

    // 白名单版排序（降序）。
    public DbTableQuery OrderBySafeDesc(string column, List<string> allowed) {
        this.qb.OrderBySafeDesc(column, allowed);
        return this;
    }

    // 最多读多少行。
    public DbTableQuery Limit(int count) {
        this.limitVal = count;
        return this;
    }

    // 跳过多少行。
    public DbTableQuery Offset(int count) {
        this.offsetVal = count;
        return this;
    }

    // 一页：take 行，跳过 skip 行。
    public DbTableQuery Page(int take, int skip) {
        return this.Limit(take).Offset(skip);
    }

    // 符合条件的行数（分页不参与计数）。
    public async long CountAsync() {
        string text = await this.conn.ExecuteScalarAsync(
            this.qb.BuildSelectParams("COUNT(*)"), this.qb.SelectParams());
        if (text == null || text.Length == 0) { return 0; }
        return Convert.ToInt64(text);
    }

    // 读取全部列。
    public async DbResult ToResultAsync() {
        return await this.run("*");
    }

    // 只读取列出的列（每个列名都会校验）。
    public async DbResult ToResultAsync(List<string> columns) {
        if (columns == null || columns.Count == 0) { return await this.run("*"); }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < columns.Count; i = i + 1) {
            if (i > 0) { sb.Append(", "); }
            sb.Append(QueryBuilder.RequireIdent(columns[i]));
        }
        return await this.run(sb.ToString());
    }

    // 删除符合条件的行，返回删除行数。
    public async int ExecuteDeleteAsync() {
        return await this.conn.ExecuteAsync(this.qb.BuildDeleteParams(),
                                           this.qb.SelectParams());
    }

    // 按 DbValues 更新符合条件的行，返回更新行数。SET 值排在
    // WHERE 值之前，与 BuildUpdateParams 的占位符顺序一致。
    public async int ExecuteUpdateAsync(DbValues row) {
        if (row.Count() == 0) { throw new Exception("update without columns"); }
        DbParams ps = new DbParams();
        for (int i = 0; i < row.Count(); i = i + 1) {
            this.qb.SetParam(row.NameAt(i));
            row.BindTo(ps, i);
        }
        return await this.conn.ExecuteAsync(this.qb.BuildUpdateParams(),
                                            Dialect.Cat(ps, this.qb.SelectParams()));
    }

    // 执行 SELECT：套用已设置的 Limit/Offset 后按给定列清单查询。
    public async DbResult run(string columns) {
        if (this.limitVal >= 0) { this.qb.Limit(this.limitVal); }
        if (this.offsetVal >= 0) { this.qb.Offset(this.offsetVal); }
        return await this.conn.QueryAsync(this.qb.BuildSelectParams(columns),
                                         this.qb.SelectParams());
    }
}
