using System;
using System.Data;
namespace System.Data.Orm;

public interface IZanSql : IDbExecutor, IDisposable {
    // CodeFirst 结构同步模块。
    ICodeFirst CodeFirst();

    // AOP 拦截模块。
    IAop Aop();

    // 创建独立的工作单元与事务。
    IUnitOfWork CreateUnitOfWork();

    // 异步创建独立的工作单元与事务（从连接池非阻塞借出连接并启动事务）。
    async IUnitOfWork CreateUnitOfWorkAsync();

    // 借出或打开一个底层数据库连接。
    IDbConnection OpenConnection();

    // 释放 ZanSql 占用的连接或池资源。
    void Dispose();
}
