using System;
using System.Collections.Generic;
using System.Data;

namespace System.Data.Orm;

// 一条**反向关系**：父表 → 子表（外键在子表上）。
//
// ## 为什么需要它
//
// ORM 的导航（`Nav`）是**单边**的：子实体声明 `public User user;` 之后，
// `LEFT JOIN` 把父表的列带进子行——查子行时能顺手拿到父行。但**反方向
// 没有**：「这个用户有哪些 UserPoint」只能自己写
// `Where(p => p.userId == 1)`，而外键列名（`<导航字段名>Id`）这个约定
// 只写在 `Nav.Join()` 里，调用方看不见——写错了列名要等到运行期
// 「no such column」才知道。
//
// 本类把这个约定**显式化**：从子实体的导航声明**反推**出反向关系
// （父表 + 外键列），并把「取某个父行的子集合」落成一条**带参数**的
// 查询条件。
//
// ## 反推不是另立一套规则
//
// 外键列名 = `<导航字段名>Id`，与 `Nav.Join()` 的 ON 子句
// （`ON t.<field>Id = j_<field>.id`）**同一套约定**——反推只是把连接
// 子句读回来。子实体没声明导航，就没有反向关系（返回 null）。
//
// ## 为什么不做成"全局注册表"
//
// 「哪些子表指向我」需要知道所有实体的元数据，而元数据是**按需**建好的
// （`ECols.__Meta()` 首次用到才建）。要在运行时回答这个问题，就得有一份
// 常驻的全局表——那是**进程退出时的泄漏**（包级 static 持有集合），
// 得不偿失。调用方知道自己的实体类型，把子实体的元数据传进来即可。
public class Rel {
    // 关系名：子侧对父的称呼（导航字段名）。
    public string Name;

    // 父表（导航的目标表）。
    public string ParentTable;

    // 子表（声明导航的实体自己的表）。
    public string ChildTable;

    // 子表上的外键列。
    public string ForeignKey;

    public Rel() {
        this.Name = "";
        this.ParentTable = "";
        this.ChildTable = "";
        this.ForeignKey = "";
    }

    public Rel(string name, string parentTable, string childTable,
    string foreignKey) {
        this.Name = name == null ? "" : name;
        this.ParentTable = parentTable == null ? "" : parentTable;
        this.ChildTable = childTable == null ? "" : childTable;
        this.ForeignKey = foreignKey == null ? "" : foreignKey;
    }

    // 外键列名的约定：`<导航字段名>Id`（与 `Nav.Join()` 同源）。
    public static string ForeignKeyOf(string navField) {
        return navField + "Id";
    }

    // 从子实体的导航声明反推反向关系。
    //
    // parentTable 为空串 → 用子实体的**唯一**导航。子实体有多个导航时
    // 抛异常：「反查哪个父」是调用方才能回答的问题，ORM 不替它猜
    // （猜错会静默返回另一个父的子集合）。
    //
    // 找不到对应导航时返回 null——调用方据此返回空集合，而不是崩。
    public static Rel Derive(Meta child, string parentTable) {
        if (child == null) { return null; }
        string want = parentTable == null ? "" : parentTable;
        if (want.Length > 0) {
            for (int i = 0; i < child.Navs.Count; i = i + 1) {
                Nav nav = child.Navs[i];
                if (nav.Table == want) {
                    return new Rel(nav.Field, nav.Table, child.Table,
                        Rel.ForeignKeyOf(nav.Field));
                }
            }
            // 表名大小写不同但指的是同一张表（SQL 里表名通常不区分
            // 大小写）——再按不区分大小写找一次。
            for (int i = 0; i < child.Navs.Count; i = i + 1) {
                Nav nav = child.Navs[i];
                if (nav.Table.ToLower() == want.ToLower()) {
                    return new Rel(nav.Field, nav.Table, child.Table,
                        Rel.ForeignKeyOf(nav.Field));
                }
            }
            return null;
        }
        if (child.Navs.Count == 0) { return null; }
        if (child.Navs.Count > 1) {
            throw new Exception(child.Entity + " 有 " +
                Convert.ToString(child.Navs.Count) + " 个导航，反查父行要指明父表："
                + "用 ChildrenOf(父表, id)");
        }
        Nav only = child.Navs[0];
        return new Rel(only.Field, only.Table, child.Table,
            Rel.ForeignKeyOf(only.Field));
    }

    // 把「外键 = 父行 id」加到查询上（数值外键）。
    public void Apply(Select q, long parentId) {
        this.Require(q);
        q.WhereEq(this.ForeignKey, parentId);
    }

    // 把「外键 = 父行 id」加到查询上（文本外键）。
    public void Apply(Select q, string parentId) {
        this.Require(q);
        q.WhereEq(this.ForeignKey, parentId);
    }

    // 外键列必须落在子实体的**映射列**里：查询条件按实体元数据校验列名，
    // 未知列抛异常。与其让调用方拿到一句干巴巴的 "has no column"，
    // 不如说清楚是哪个关系的外键没被映射。
    void Require(Select q) {
        if (q == null) { return; }
        Meta m = q.Meta();
        if (m == null) { return; }
        if (m.Has(this.ForeignKey)) { return; }
        throw new Exception("反向关系 " + this.Name + " 的外键列 " +
            this.ForeignKey + " 不是 " + this.ChildTable + " 的映射列"
            + "（无法按它过滤；把该列声明成实体的字段即可）");
    }
}
