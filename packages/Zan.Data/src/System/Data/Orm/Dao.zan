using System;
using System.Collections.Generic;

namespace System.Data.Orm;

// 现代化无状态轻量 DAO 基类：
// 既可作为面向对象基类继承，也可通过静态方法零参数直接访问。
// 内部自动寻径 ZanSql.Current，彻底消灭手动传递 DB/ORM 句柄。
public class Dao<T> : BaseRepository<T> {
    public Dao() : base() {}
    public Dao(IZanSql zsql) : base(zsql) {}
    public Dao(IZanSql zsql, IUnitOfWork uow) : base(zsql, uow) {}

    // 获取当前绑定的底层执行器
    public static IDbExecutor Executor() {
        return ZanSql.Current;
    }

    // 单条插入
    public static int Insert(T entity) {
        IDbExecutor db = ZanSql.Current;
        return db.Insert<T>(entity).ExecuteAffrows();
    }

    public static async int InsertAsync(T entity) {
        IDbExecutor db = ZanSql.Current;
        return await db.Insert<T>(entity).ExecuteAffrowsAsync();
    }

    // 插入并返回自增主键
    public static int InsertIdentity(T entity) {
        IDbExecutor db = ZanSql.Current;
        return db.Insert<T>(entity).ExecuteIdentity();
    }

    public static async int InsertIdentityAsync(T entity) {
        IDbExecutor db = ZanSql.Current;
        return await db.Insert<T>(entity).ExecuteIdentityAsync();
    }

    // 批量插入
    public static int InsertBatch(List<T> entities) {
        IDbExecutor db = ZanSql.Current;
        return db.Insert<T>(entities).ExecuteAffrows();
    }

    public static async int InsertBatchAsync(List<T> entities) {
        IDbExecutor db = ZanSql.Current;
        return await db.Insert<T>(entities).ExecuteAffrowsAsync();
    }

    // 按主键更新
    public static int Update(T entity) {
        IDbExecutor db = ZanSql.Current;
        return db.Update<T>().SetSource(entity).ExecuteAffrows();
    }

    public static async int UpdateAsync(T entity) {
        IDbExecutor db = ZanSql.Current;
        return await db.Update<T>().SetSource(entity).ExecuteAffrowsAsync();
    }

    // 全量列表
    public static List<T> SelectAll() {
        IDbExecutor db = ZanSql.Current;
        return db.Select<T>().ToList();
    }

    public static async List<T> SelectAllAsync() {
        IDbExecutor db = ZanSql.Current;
        return await db.Select<T>().ToListAsync();
    }

    // 统计总数
    public static int Count() {
        IDbExecutor db = ZanSql.Current;
        return db.Select<T>().Count();
    }

    public static async int CountAsync() {
        IDbExecutor db = ZanSql.Current;
        return await db.Select<T>().CountAsync();
    }

    // 主键查询（int / long / string）
    public static T FindById(int id) {
        IDbExecutor db = ZanSql.Current;
        return db.Select<T>().WherePk(id).First();
    }

    public static async T FindByIdAsync(int id) {
        IDbExecutor db = ZanSql.Current;
        return await db.Select<T>().WherePk(id).FirstAsync();
    }

    public static T FindById(long id) {
        IDbExecutor db = ZanSql.Current;
        return db.Select<T>().WherePk(id).First();
    }

    public static async T FindByIdAsync(long id) {
        IDbExecutor db = ZanSql.Current;
        return await db.Select<T>().WherePk(id).FirstAsync();
    }

    public static T FindById(string id) {
        IDbExecutor db = ZanSql.Current;
        return db.Select<T>().WherePk(id).First();
    }

    public static async T FindByIdAsync(string id) {
        IDbExecutor db = ZanSql.Current;
        return await db.Select<T>().WherePk(id).FirstAsync();
    }

    // 主键是否存在
    public static bool ExistsById(int id) {
        IDbExecutor db = ZanSql.Current;
        return db.Select<T>().WherePk(id).Any();
    }

    public static async bool ExistsByIdAsync(int id) {
        IDbExecutor db = ZanSql.Current;
        return await db.Select<T>().WherePk(id).AnyAsync();
    }

    // 主键删除
    public static int DeleteById(int id) {
        IDbExecutor db = ZanSql.Current;
        return db.Delete<T>().WherePk(id).ExecuteAffrows();
    }

    public static async int DeleteByIdAsync(int id) {
        IDbExecutor db = ZanSql.Current;
        return await db.Delete<T>().WherePk(id).ExecuteAffrowsAsync();
    }

    // 分页查询
    public static List<T> Page(int page, int pageSize) {
        IDbExecutor db = ZanSql.Current;
        return db.Select<T>().Page(page, pageSize).ToList();
    }

    public static async List<T> PageAsync(int page, int pageSize) {
        IDbExecutor db = ZanSql.Current;
        OrmSelectQuery<T> q = db.Select<T>();
        return await q.Page(page, pageSize).ToListAsync();
    }
}
