using System;
using System.Text;
using System.Data;
using System.Linq;

namespace System.Data.Orm;

// 纯 Zan 的表达式树转 SQL 构建器。遍历查询 lambda 降级得到的 <see cref="ExprNode"/> 树
// （即将 lambda 降级为可检查的节点），
// 并将参数化 SQL 片段追加到 StringBuilder，同时把
// 常量绑定到 DbParams 列表。类型化 ORM 的所有 WHERE 子句 SQL 构造都在这里——
// 编译器只把 `Where(o => ...)` lambda 降级为
// Expr 树；C 通道不会生成任何 SQL 形式的内容。
// 列引用将成员名映射为 `t.<name>`（列 = 字段名，
// ORM 默认约定）。支持：
// binary: == != &lt; &gt; &lt;= &gt;= + - * / %  && (AND)  || (OR)
// not: !expr
// 调用：StartsWith / EndsWith / Contains → 转换为带绑定模式的 LIKE
public class ExprSql {
    // 将常量节点渲染为文本（用于组装 LIKE 模式）。
    public static string EvalText(ExprNode n) {
        if (n == null) { throw new NotSupportedException("SQL expression requires a constant value"); }
        if (n.Kind == 1 && n.TVal == 2) { return n.SVal; }
        if (n.Kind == 1 && n.TVal == 0) { return Convert.ToString(n.IVal); }
        if (n.Kind == 1 && n.TVal == 5) { return Convert.ToString(n.LVal); }
        throw new NotSupportedException("SQL LIKE requires a text or integer constant");
    }

    // n 是否 null 常量节点（TVal 4）。等值比较撞上它必须译
    // IS [NOT] NULL——SQL 三值逻辑下 `= NULL` 永不命中。
    public static bool IsNullConst(ExprNode n) {
        return n != null && n.Kind == 1 && n.TVal == 4;
    }

    // 融合版 LIKE 模式转义与前后 % 包装：wrap 0=纯转义、1=StartsWith、2=EndsWith、3=Contains。
    private static string EscapeLikeWrapped(string s, int wrap) {
        if (s == null) {
            if (wrap == 0) { return null; }
            if (wrap == 3) { return "%%"; }
            return "%";
        }
        int len = s.Length;
        int esc = 0;
        for (int i = 0; i < len; i = i + 1) {
            int c = s[i] & 255;
            if (c == 92 || c == 37 || c == 95) { esc = esc + 1; }
        }
        if (esc == 0 && wrap == 0) { return s; }
        int lead = (wrap == 2 || wrap == 3) ? 1 : 0;
        int trail = (wrap == 1 || wrap == 3) ? 1 : 0;
        int total = lead + len + esc + trail;
        byte[] buf = new byte[total];
        nint bp = (nint)buf;
        nint sp = (nint)s;
        int dst = 0;
        if (lead == 1) { buf[dst] = 37; dst = 1; }
        if (esc == 0) {
            if (len > 0) {
                NativeMemory.Copy(bp + (nint)dst, sp, len);
                dst = dst + len;
            }
        } else {
            int seg = 0;
            for (int i = 0; i < len; i = i + 1) {
                int c = s[i] & 255;
                if (c == 92 || c == 37 || c == 95) {
                    if (i > seg) {
                        NativeMemory.Copy(bp + (nint)dst, sp + (nint)seg, i - seg);
                        dst = dst + (i - seg);
                    }
                    buf[dst] = 92;
                    buf[dst + 1] = (byte)c;
                    dst = dst + 2;
                    seg = i + 1;
                }
            }
            if (seg < len) {
                NativeMemory.Copy(bp + (nint)dst, sp + (nint)seg, len - seg);
                dst = dst + (len - seg);
            }
        }
        if (trail == 1) { buf[dst] = 37; }
        return NativeMemory.GetString(bp, 0, total);
    }

    // LIKE 模式转义：用户文本里的 \ % _ 原义化（前置 \），
    // 通配语义只留给调用形态补的 %；拼 ESCAPE '\' 子句使用。
    public static string EscapeLike(string s) {
        return ExprSql.EscapeLikeWrapped(s, 0);
    }

    // Zan 比较运算符对应的 SQL 写法。SQLite 恰好
    // 接受 `==` 和 `!=`，但标准 SQL（MySQL、PostgreSQL、SQL Server）
    // 不接受——未转换的运算符在那里是语法错误，因此
    // 运算符必须做映射，不能直接透传。
    public static string SqlOp(string op) {
        if (op == "==") { return "="; }
        if (op == "!=") { return "<>"; }
        return op;
    }

    public static bool IsSafeIdent(string s) {
        if (s == null || s.Length == 0 || s.Length > 128) { return false; }
        int len = s.Length;
        for (int i = 0; i < len; i = i + 1) {
            int c = s[i] & 255;
            bool ok = (c >= 97 && c <= 122) ||
                      (c >= 65 && c <= 90) ||
                      (c >= 48 && c <= 57) ||
                      c == 95;
            if (!ok) { return false; }
        }
        return true;
    }

    private static int MAX_DEPTH = 128;

    // 单遍校验并测量精确字节数（供 Validate 与超大表达式回退路径共用）。
    private static int ValidateAndMeasure(ExprNode n, int depth) {
        if (n == null) { throw new NotSupportedException("SQL expression is missing a node"); }
        if (depth > ExprSql.MAX_DEPTH) {
            throw new NotSupportedException("SQL expression exceeds maximum nesting depth");
        }
        int kind = n.Kind;
        if (kind == 2) {
            string op = n.Name;
            if (op == null) { throw new NotSupportedException("Unsupported SQL operator: "); }
            int opLen = op.Length;
            if (opLen == 2) {
                int c0 = op[0] & 255;
                int c1 = op[1] & 255;
                if (c0 == 38 && c1 == 38) { return 7 + ValidateAndMeasure(n.A, depth + 1) + ValidateAndMeasure(n.B, depth + 1); }
                if (c0 == 124 && c1 == 124) { return 6 + ValidateAndMeasure(n.A, depth + 1) + ValidateAndMeasure(n.B, depth + 1); }
                if (c1 == 61 && (c0 == 61 || c0 == 33)) {
                    int laLen = ValidateAndMeasure(n.A, depth + 1);
                    int lbLen = ValidateAndMeasure(n.B, depth + 1);
                    bool la = n.A.Kind == 1 && n.A.TVal == 4;
                    bool lb = n.B.Kind == 1 && n.B.TVal == 4;
                    if (la && lb) { return 3; }
                    if (la) { return (c0 == 61 ? 10 : 14) + lbLen; }
                    if (lb) { return (c0 == 61 ? 10 : 14) + laLen; }
                    return (c0 == 61 ? 5 : 6) + laLen + lbLen;
                }
                if (c1 == 61 && (c0 == 60 || c0 == 62)) {
                    return 6 + ValidateAndMeasure(n.A, depth + 1) + ValidateAndMeasure(n.B, depth + 1);
                }
                throw new NotSupportedException("Unsupported SQL operator: " + op);
            }
            if (opLen == 1) {
                int c0 = op[0] & 255;
                if (c0 == 60 || c0 == 62 || c0 == 43 || c0 == 45 || c0 == 42 || c0 == 47 || c0 == 37) {
                    return 5 + ValidateAndMeasure(n.A, depth + 1) + ValidateAndMeasure(n.B, depth + 1);
                }
            }
            throw new NotSupportedException("Unsupported SQL operator: " + op);
        }
        if (kind == 0) {
            string nm = n.Name;
            if (nm == null || nm.Length == 0 || nm.Length > 128) {
                throw new NotSupportedException("Invalid SQL member name");
            }
            int len = nm.Length;
            bool safe = true;
            int quotes = 0;
            for (int i = 0; i < len; i = i + 1) {
                int c = nm[i] & 255;
                if (c < 32) { throw new NotSupportedException("Invalid SQL member name"); }
                if (!((c >= 97 && c <= 122) || (c >= 65 && c <= 90)
                    || (c >= 48 && c <= 57) || c == 95)) {
                    safe = false;
                    if (c == 34) { quotes = quotes + 1; }
                }
            }
            return safe ? (2 + len) : (4 + len + quotes);
        }
        if (kind == 1) {
            if (n.TVal < 0 || n.TVal > 5) { throw new NotSupportedException("Unsupported SQL constant type"); }
            return 1;
        }
        if (kind == 4) { return ValidateAndMeasure(n.A, depth + 1); }
        if (kind == 5) { return 6 + ValidateAndMeasure(n.A, depth + 1); }
        if (kind == 3) {
            string fn = n.Name;
            if (fn == "StartsWith" || fn == "EndsWith" || fn == "Contains") {
                int recvLen = ValidateAndMeasure(n.A, depth + 1);
                ExprNode arg = n.B;
                if (arg == null) { throw new NotSupportedException("SQL expression requires a constant value"); }
                if (!(arg.Kind == 1 && (arg.TVal == 2 || arg.TVal == 0 || arg.TVal == 5))) {
                    throw new NotSupportedException("SQL LIKE requires a text or integer constant");
                }
                return recvLen + 18;
            }
        }
        throw new NotSupportedException("Unsupported SQL expression: " + (n.Name != null ? n.Name : ""));
    }

    // Validate before binding: rejected subtrees must not leave stray parameters.
    public static void Validate(ExprNode n) {
        ExprSql.ValidateAndMeasure(n, 0);
    }

    // 零 ref/out 单遍快路径：-1 表示非法节点（交 Validate 抛原异常），-2 表示超出当前缓冲需精确测量重跑。
    private static int RenderFast(ExprNode n, byte[] buf, int cap, int pos, List<DbParam> items, int depth) {
        if (n == null || depth > ExprSql.MAX_DEPTH) { return -1; }
        int kind = n.Kind;
        if (kind == 2) {
            string op = n.Name;
            if (op == null) { return -1; }
            int opLen = op.Length;
            if (opLen == 2) {
                int c0 = op[0] & 255;
                int c1 = op[1] & 255;
                if (c0 == 38 && c1 == 38) {
                    if (pos + 7 > cap) { return -2; }
                    buf[pos] = 40; pos = pos + 1;
                    pos = ExprSql.RenderFast(n.A, buf, cap, pos, items, depth + 1);
                    if (pos < 0) { return pos; }
                    if (pos + 6 > cap) { return -2; }
                    buf[pos] = 32; buf[pos + 1] = 65; buf[pos + 2] = 78; buf[pos + 3] = 68; buf[pos + 4] = 32;
                    pos = pos + 5;
                    pos = ExprSql.RenderFast(n.B, buf, cap, pos, items, depth + 1);
                    if (pos < 0) { return pos; }
                    if (pos + 1 > cap) { return -2; }
                    buf[pos] = 41;
                    return pos + 1;
                }
                if (c0 == 124 && c1 == 124) {
                    if (pos + 6 > cap) { return -2; }
                    buf[pos] = 40; pos = pos + 1;
                    pos = ExprSql.RenderFast(n.A, buf, cap, pos, items, depth + 1);
                    if (pos < 0) { return pos; }
                    if (pos + 5 > cap) { return -2; }
                    buf[pos] = 32; buf[pos + 1] = 79; buf[pos + 2] = 82; buf[pos + 3] = 32;
                    pos = pos + 4;
                    pos = ExprSql.RenderFast(n.B, buf, cap, pos, items, depth + 1);
                    if (pos < 0) { return pos; }
                    if (pos + 1 > cap) { return -2; }
                    buf[pos] = 41;
                    return pos + 1;
                }
                if (c1 == 61 && (c0 == 61 || c0 == 33)) {
                    ExprNode na = n.A;
                    ExprNode nb = n.B;
                    if (na == null || nb == null) { return -1; }
                    bool la = na.Kind == 1 && na.TVal == 4;
                    bool lb = nb.Kind == 1 && nb.TVal == 4;
                    if (la && lb) {
                        if (pos + 3 > cap) { return -2; }
                        buf[pos] = 49; buf[pos + 1] = 61; buf[pos + 2] = c0 == 61 ? (byte)49 : (byte)48;
                        return pos + 3;
                    }
                    if (la || lb) {
                        if (pos + 14 > cap) { return -2; }
                        buf[pos] = 40; pos = pos + 1;
                        pos = ExprSql.RenderFast(la ? nb : na, buf, cap, pos, items, depth + 1);
                        if (pos < 0) { return pos; }
                        if (c0 == 61) {
                            if (pos + 9 > cap) { return -2; }
                            buf[pos] = 32; buf[pos + 1] = 73; buf[pos + 2] = 83; buf[pos + 3] = 32;
                            buf[pos + 4] = 78; buf[pos + 5] = 85; buf[pos + 6] = 76; buf[pos + 7] = 76; buf[pos + 8] = 41;
                            return pos + 9;
                        }
                        if (pos + 13 > cap) { return -2; }
                        buf[pos] = 32; buf[pos + 1] = 73; buf[pos + 2] = 83; buf[pos + 3] = 32;
                        buf[pos + 4] = 78; buf[pos + 5] = 79; buf[pos + 6] = 84; buf[pos + 7] = 32;
                        buf[pos + 8] = 78; buf[pos + 9] = 85; buf[pos + 10] = 76; buf[pos + 11] = 76; buf[pos + 12] = 41;
                        return pos + 13;
                    }
                    if (pos + 6 > cap) { return -2; }
                    buf[pos] = 40; pos = pos + 1;
                    pos = ExprSql.RenderFast(na, buf, cap, pos, items, depth + 1);
                    if (pos < 0) { return pos; }
                    if (c0 == 61) {
                        if (pos + 4 > cap) { return -2; }
                        buf[pos] = 32; buf[pos + 1] = 61; buf[pos + 2] = 32;
                        pos = pos + 3;
                    } else {
                        if (pos + 5 > cap) { return -2; }
                        buf[pos] = 32; buf[pos + 1] = 60; buf[pos + 2] = 62; buf[pos + 3] = 32;
                        pos = pos + 4;
                    }
                    pos = ExprSql.RenderFast(nb, buf, cap, pos, items, depth + 1);
                    if (pos < 0) { return pos; }
                    if (pos + 1 > cap) { return -2; }
                    buf[pos] = 41;
                    return pos + 1;
                }
                if (c1 == 61 && (c0 == 60 || c0 == 62)) {
                    if (pos + 6 > cap) { return -2; }
                    buf[pos] = 40; pos = pos + 1;
                    pos = ExprSql.RenderFast(n.A, buf, cap, pos, items, depth + 1);
                    if (pos < 0) { return pos; }
                    if (pos + 5 > cap) { return -2; }
                    buf[pos] = 32; buf[pos + 1] = (byte)c0; buf[pos + 2] = 61; buf[pos + 3] = 32;
                    pos = pos + 4;
                    pos = ExprSql.RenderFast(n.B, buf, cap, pos, items, depth + 1);
                    if (pos < 0) { return pos; }
                    if (pos + 1 > cap) { return -2; }
                    buf[pos] = 41;
                    return pos + 1;
                }
                return -1;
            }
            if (opLen == 1) {
                int c0 = op[0] & 255;
                if (c0 == 60 || c0 == 62 || c0 == 43 || c0 == 45 || c0 == 42 || c0 == 47 || c0 == 37) {
                    if (pos + 5 > cap) { return -2; }
                    buf[pos] = 40; pos = pos + 1;
                    pos = ExprSql.RenderFast(n.A, buf, cap, pos, items, depth + 1);
                    if (pos < 0) { return pos; }
                    if (pos + 4 > cap) { return -2; }
                    buf[pos] = 32; buf[pos + 1] = (byte)c0; buf[pos + 2] = 32;
                    pos = pos + 3;
                    pos = ExprSql.RenderFast(n.B, buf, cap, pos, items, depth + 1);
                    if (pos < 0) { return pos; }
                    if (pos + 1 > cap) { return -2; }
                    buf[pos] = 41;
                    return pos + 1;
                }
            }
            return -1;
        }
        if (kind == 0) {
            string nm = n.Name;
            if (nm == null || nm.Length == 0 || nm.Length > 128) { return -1; }
            int nLen = nm.Length;
            if (pos + nLen + 2 > cap) { return -2; }
            buf[pos] = 116; buf[pos + 1] = 46;
            int dst = pos + 2;
            bool safe = true;
            for (int i = 0; i < nLen; i = i + 1) {
                int c = nm[i] & 255;
                if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90)
                    || (c >= 48 && c <= 57) || c == 95) {
                    buf[dst + i] = (byte)c;
                } else {
                    if (c < 32) { return -1; }
                    safe = false;
                    break;
                }
            }
            if (safe) { return dst + nLen; }
            if (dst + 1 > cap) { return -2; }
            buf[dst] = 34;
            dst = dst + 1;
            for (int i = 0; i < nLen; i = i + 1) {
                int c = nm[i] & 255;
                if (c < 32) { return -1; }
                if (c == 34) {
                    if (dst + 2 > cap) { return -2; }
                    buf[dst] = 34; buf[dst + 1] = 34;
                    dst = dst + 2;
                } else {
                    if (dst + 1 > cap) { return -2; }
                    buf[dst] = (byte)c;
                    dst = dst + 1;
                }
            }
            if (dst + 1 > cap) { return -2; }
            buf[dst] = 34;
            return dst + 1;
        }
        if (kind == 1) {
            int tv = n.TVal;
            if (tv < 0 || tv > 5) { return -1; }
            if (pos + 1 > cap) { return -2; }
            if (tv == 2) {
                string sv = n.SVal;
                if (sv == null) { items.Add(new DbParam(DbParams.KindNull, "", 0L, 0.0)); }
                else { items.Add(new DbParam(DbParams.KindText, sv, 0L, 0.0)); }
            } else if (tv == 3) {
                items.Add(new DbParam(DbParams.KindInt, "", n.BVal ? 1L : 0L, 0.0));
            } else if (tv == 1) {
                items.Add(new DbParam(DbParams.KindDouble, "", 0L, n.DVal));
            } else if (tv == 4) {
                items.Add(new DbParam(DbParams.KindNull, "", 0L, 0.0));
            } else if (tv == 5) {
                items.Add(new DbParam(DbParams.KindInt, "", n.LVal, 0.0));
            } else {
                items.Add(new DbParam(DbParams.KindInt, "", (long)n.IVal, 0.0));
            }
            buf[pos] = 63;
            return pos + 1;
        }
        if (kind == 3) {
            string fn = n.Name;
            int wrap = 0;
            if (fn == "StartsWith") { wrap = 1; }
            else if (fn == "EndsWith") { wrap = 2; }
            else if (fn == "Contains") { wrap = 3; }
            else { return -1; }
            pos = ExprSql.RenderFast(n.A, buf, cap, pos, items, depth + 1);
            if (pos < 0) { return pos; }
            ExprNode arg = n.B;
            if (arg == null) { return -1; }
            string raw;
            if (arg.Kind == 1 && arg.TVal == 2) { raw = arg.SVal; }
            else if (arg.Kind == 1 && arg.TVal == 0) { raw = Convert.ToString(arg.IVal); }
            else if (arg.Kind == 1 && arg.TVal == 5) { raw = Convert.ToString(arg.LVal); }
            else { return -1; }
            if (pos + 18 > cap) { return -2; }
            buf[pos] = 32; buf[pos + 1] = 76; buf[pos + 2] = 73; buf[pos + 3] = 75; buf[pos + 4] = 69;
            buf[pos + 5] = 32; buf[pos + 6] = 63; buf[pos + 7] = 32;
            buf[pos + 8] = 69; buf[pos + 9] = 83; buf[pos + 10] = 67; buf[pos + 11] = 65; buf[pos + 12] = 80; buf[pos + 13] = 69;
            buf[pos + 14] = 32; buf[pos + 15] = 39; buf[pos + 16] = 92; buf[pos + 17] = 39;
            pos = pos + 18;
            string pat = ExprSql.EscapeLikeWrapped(raw, wrap);
            if (pat == null) { items.Add(new DbParam(DbParams.KindNull, "", 0L, 0.0)); }
            else { items.Add(new DbParam(DbParams.KindText, pat, 0L, 0.0)); }
            return pos;
        }
        if (kind == 5) {
            if (pos + 6 > cap) { return -2; }
            buf[pos] = 78; buf[pos + 1] = 79; buf[pos + 2] = 84; buf[pos + 3] = 32; buf[pos + 4] = 40;
            pos = pos + 5;
            pos = ExprSql.RenderFast(n.A, buf, cap, pos, items, depth + 1);
            if (pos < 0) { return pos; }
            if (pos + 1 > cap) { return -2; }
            buf[pos] = 41;
            return pos + 1;
        }
        if (kind == 4) { return ExprSql.RenderFast(n.A, buf, cap, pos, items, depth + 1); }
        return -1;
    }

    // 为以 n 为根的树构建 WHERE 片段。
    public static void Build(ExprNode n, StringBuilder sb, DbParams ps) {
        if (sb == null || ps == null) { throw new ArgumentNullException("sb/ps"); }
        List<DbParam> items = ps.items;
        int savedParams = items.Count;
        byte[] buf = new byte[512];
        int len = ExprSql.RenderFast(n, buf, 512, 0, items, 0);
        if (len >= 0) {
            if (len > 0) { sb.Append(NativeMemory.GetString((nint)buf, 0, len)); }
            return;
        }
        while (items.Count > savedParams) {
            items.RemoveAt(items.Count - 1);
        }
        if (len == -1) {
            ExprSql.ValidateAndMeasure(n, 0);
            return;
        }
        int exact = ExprSql.ValidateAndMeasure(n, 0);
        if (exact <= 0) { return; }
        byte[] big = new byte[exact + 16];
        int bigLen = ExprSql.RenderFast(n, big, exact + 16, 0, items, 0);
        if (bigLen < 0) {
            while (items.Count > savedParams) {
                items.RemoveAt(items.Count - 1);
            }
            throw new NotSupportedException("SQL expression rendering failed");
        }
        if (bigLen > 0) {
            sb.Append(NativeMemory.GetString((nint)big, 0, bigLen));
        }
    }
}
