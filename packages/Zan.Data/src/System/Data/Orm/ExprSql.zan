using System;
using System.Text;
using System.Data;
using System.Linq;

namespace System.Data.Orm;

// 纯 Zan 的表达式树转 SQL 构建器。遍历查询 lambda 降级得到的 <see cref="ExprNode"/> 树
// （即将 lambda 降级为可检查的节点），
// 并将参数化 SQL 片段追加到 StringBuilder，同时把
// 常量绑定到 DbParams 列表。类型化 ORM 的所有 WHERE 子句 SQL 构造都在这里——
// 编译器只把 `Where(o => ...)` lambda 降级为
// Expr 树；C 通道不会生成任何 SQL 形式的内容。
// 列引用将成员名映射为 `t.<name>`（列 = 字段名，
// ORM 默认约定）。支持：
// binary: == != &lt; &gt; &lt;= &gt;= + - * / %  && (AND)  || (OR)
// not: !expr
// 调用：StartsWith / EndsWith / Contains → 转换为带绑定模式的 LIKE
public class ExprSql {
    // 将常量节点渲染为文本（用于组装 LIKE 模式）。
    public static string EvalText(ExprNode n) {
        if (n == null) { throw new NotSupportedException("SQL expression requires a constant value"); }
        if (n.Kind == 1 && n.TVal == 2) { return n.SVal; }
        if (n.Kind == 1 && n.TVal == 0) { return Convert.ToString(n.IVal); }
        if (n.Kind == 1 && n.TVal == 5) { return Convert.ToString(n.LVal); }
        throw new NotSupportedException("SQL LIKE requires a text or integer constant");
    }

    // n 是否 null 常量节点（TVal 4）。等值比较撞上它必须译
    // IS [NOT] NULL——SQL 三值逻辑下 `= NULL` 永不命中。
    public static bool IsNullConst(ExprNode n) {
        return n != null && n.Kind == 1 && n.TVal == 4;
    }

    // LIKE 模式转义：用户文本里的 \ % _ 原义化（前置 \），
    // 通配语义只留给调用形态补的 %；拼 ESCAPE '\' 子句使用。
    public static string EscapeLike(string s) {
        if (s == null) { return s; }
        if (s.IndexOf("\\") < 0 && s.IndexOf("%") < 0 &&
            s.IndexOf("_") < 0) { return s; }
        StringBuilder e = new StringBuilder();
        for (int i = 0; i < s.Length; i++) {
            char c = s[i];
            if (c == '\\' || c == '%' || c == '_') { e.Append("\\"); }
            e.Append(c);
        }
        return e.ToString();
    }

    // Zan 比较运算符对应的 SQL 写法。SQLite 恰好
    // 接受 `==` 和 `!=`，但标准 SQL（MySQL、PostgreSQL、SQL Server）
    // 不接受——未转换的运算符在那里是语法错误，因此
    // 运算符必须做映射，不能直接透传。
    public static string SqlOp(string op) {
        if (op == "==") { return "="; }
        if (op == "!=") { return "<>"; }
        return op;
    }

    public static bool IsSafeIdent(string s) {
        if (s == null || s.Length == 0 || s.Length > 128) { return false; }
        for (int i = 0; i < s.Length; i = i + 1) {
            char c = s[i];
            bool ok = (c >= 'a' && c <= 'z') ||
                      (c >= 'A' && c <= 'Z') ||
                      (c >= '0' && c <= '9') ||
                      c == '_';
            if (!ok) { return false; }
        }
        return true;
    }

    // Validate before binding: rejected subtrees must not leave stray parameters.
    public static void Validate(ExprNode n) {
        if (n == null) { throw new NotSupportedException("SQL expression is missing a node"); }
        if (n.Kind == 0) {
            if (n.Name == null || n.Name.Length == 0 || n.Name.Length > 128) {
                throw new NotSupportedException("Invalid SQL member name");
            }
            for (int i = 0; i < n.Name.Length; i = i + 1) {
                if (n.Name[i] < 32) { throw new NotSupportedException("Invalid SQL member name"); }
            }
            return;
        }
        if (n.Kind == 1) {
            if (n.TVal < 0 || n.TVal > 5) { throw new NotSupportedException("Unsupported SQL constant type"); }
            return;
        }
        if (n.Kind == 4 || n.Kind == 5) { Validate(n.A); return; }
        if (n.Kind == 2) {
            string op = n.Name;
            if (op != "==" && op != "!=" && op != "<" && op != ">" &&
                op != "<=" && op != ">=" && op != "+" && op != "-" &&
                op != "*" && op != "/" && op != "%" && op != "&&" && op != "||") {
                throw new NotSupportedException("Unsupported SQL operator: " + op);
            }
            Validate(n.A); Validate(n.B); return;
        }
        if (n.Kind == 3 && (n.Name == "StartsWith" || n.Name == "EndsWith" || n.Name == "Contains")) {
            Validate(n.A);
            string text = EvalText(n.B);
            return;
        }
        throw new NotSupportedException("Unsupported SQL expression: " + n.Name);
    }

    // 为以 n 为根的树构建 WHERE 片段。
    public static void Build(ExprNode n, StringBuilder sb, DbParams ps) {
        Validate(n);
        Render(n, sb, ps);
    }

    static void Render(ExprNode n, StringBuilder sb, DbParams ps) {
        if (n.Kind == 4) {
            Render(n.A, sb, ps);
        } else if (n.Kind == 0) {
            sb.Append("t.");
            if (IsSafeIdent(n.Name)) {
                sb.Append(n.Name);
            } else {
                // A member is one column, never a prequoted fragment or qualified path.
                sb.Append("\"" + n.Name.Replace("\"", "\"\"") + "\"");
            }
        } else if (n.Kind == 1) {
            if (n.TVal == 2) {
                ps.Add(n.SVal);
            } else if (n.TVal == 3) {
                ps.AddInt(n.BVal ? 1 : 0);
            } else if (n.TVal == 1) {
                ps.AddDouble(n.DVal);
            } else if (n.TVal == 4) {
                ps.AddNull();
            } else if (n.TVal == 5) {
                ps.AddLong(n.LVal);
            } else {
                ps.AddInt(n.IVal);
            }
            sb.Append("?");
        } else if (n.Kind == 2) {
            if (n.Name == "==" || n.Name == "!=") {
                // 等值撞 null 常量（B-ID65）：`= NULL` 在三值逻辑下永不
                // 命中，必须译 IS [NOT] NULL；两边全 null 是常量谓词。
                bool la = IsNullConst(n.A);
                bool lb = IsNullConst(n.B);
                if (la && lb) {
                    sb.Append(n.Name == "==" ? "1=1" : "1=0");
                } else if (la || lb) {
                    sb.Append("(");
                    Render(la ? n.B : n.A, sb, ps);
                    sb.Append(" IS ");
                    if (n.Name == "!=") { sb.Append("NOT "); }
                    sb.Append("NULL)");
                } else {
                    sb.Append("(");
                    Render(n.A, sb, ps);
                    sb.Append(" ");
                    sb.Append(SqlOp(n.Name));
                    sb.Append(" ");
                    Render(n.B, sb, ps);
                    sb.Append(")");
                }
            } else if (n.Name == "&&") {
                sb.Append("(");
                Render(n.A, sb, ps);
                sb.Append(" AND ");
                Render(n.B, sb, ps);
                sb.Append(")");
            } else if (n.Name == "||") {
                sb.Append("(");
                Render(n.A, sb, ps);
                sb.Append(" OR ");
                Render(n.B, sb, ps);
                sb.Append(")");
            } else {
                sb.Append("(");
                Render(n.A, sb, ps);
                sb.Append(" ");
                sb.Append(SqlOp(n.Name));
                sb.Append(" ");
                Render(n.B, sb, ps);
                sb.Append(")");
            }
        } else if (n.Kind == 5) {
            sb.Append("NOT (");
            Render(n.A, sb, ps);
            sb.Append(")");
        } else if (n.Kind == 3) {
            if (n.Name == "StartsWith" || n.Name == "EndsWith" ||
                n.Name == "Contains") {
                Render(n.A, sb, ps);
                // ESCAPE '\'（B-ID65）：用户文本经 EscapeLike 原义化，
                // 通配语义只留给这里补的 %。
                sb.Append(" LIKE ? ESCAPE '\\'");
                string pat = EscapeLike(EvalText(n.B));
                if (n.Name == "StartsWith") {
                    pat = pat + "%";
                } else if (n.Name == "EndsWith") {
                    pat = "%" + pat;
                } else {
                    pat = "%" + pat + "%";
                }
                ps.Add(pat);
            } else {
                throw new NotSupportedException("Unsupported SQL expression: " + n.Name);
            }
        } else {
            throw new NotSupportedException("Unsupported SQL expression: " + n.Name);
        }
    }
}
