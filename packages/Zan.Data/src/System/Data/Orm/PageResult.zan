using System;
using System.Collections.Generic;

namespace System.Data.Orm;

/// <summary>强类型分页查询聚合回执：封装当前页记录列表、记录总数、当前页码、页大小及总页数。</summary>
public class PageResult<T> {
    /// <summary>当前页记录列表。</summary>
    public List<T> items;
    /// <summary>符合查询条件的总记录数。</summary>
    public int total;
    /// <summary>当前页码（从 1 开始）。</summary>
    public int page;
    /// <summary>每页显示条数。</summary>
    public int pageSize;
    /// <summary>总页数。</summary>
    public int totalPages;

    public PageResult() {
        this.items = new List<T>();
        this.total = 0;
        this.page = 1;
        this.pageSize = 10;
        this.totalPages = 0;
    }

    public PageResult(List<T> items, int total, int page, int pageSize) {
        this.items = items == null ? new List<T>() : items;
        this.total = total;
        this.page = page < 1 ? 1 : page;
        this.pageSize = pageSize <= 0 ? 10 : pageSize;
        if (this.total <= 0) {
            this.totalPages = 0;
        } else {
            this.totalPages = (this.total + this.pageSize - 1) / this.pageSize;
        }
    }
}
