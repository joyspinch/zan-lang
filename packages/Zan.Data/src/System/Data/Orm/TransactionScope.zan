using System;
using System.Data;

namespace System.Data.Orm;

// 事务作用域包装器（零反射自动化事务上下文控制）。
// 支持基于 IUnitOfWork / IDbConnection 的安全事务生命周期管理。
// 遵循经典 using / Complete 模式：只有显式调用 Complete() 时才会在 Dispose 阶段 Commit，
// 否则自动 Rollback，杜绝未捕获异常导致脏事务泄露或未提交死锁。
public class TransactionScope {
    public IUnitOfWork uow;
    public bool completed;
    public bool disposed;

    // One completion attempt per scope: an uncertain failure must never be
    // retried implicitly by Complete/Dispose, even with a custom IUnitOfWork.
    private bool completionAttempted;
    private bool committing;
    private bool completionResult = true;

    public TransactionScope(IUnitOfWork uow) {
        this.uow = uow;
        this.completed = false;
        this.disposed = false;
    }

    public TransactionScope(IDbConnection conn) {
        this.uow = new UnitOfWork(conn, false);
        this.completed = false;
        this.disposed = false;
    }

    public static TransactionScope Create(IUnitOfWork uow) {
        return new TransactionScope(uow);
    }

    public static TransactionScope Create(IDbConnection conn) {
        return new TransactionScope(conn);
    }

    // 从数据门面开一个作用域（内部自己建工作单元与事务）。
    public static TransactionScope Create(IZanSql zsql) {
        return new TransactionScope(zsql.CreateUnitOfWork());
    }

    // 标记当前作用域内所有操作均成功，允许在 Dispose 时提交事务。
    public void Complete() {
        if (this.disposed) {
            throw new Exception("Cannot complete a disposed TransactionScope");
        }
        if (!this.completionAttempted) { this.completed = true; }
    }

    // 显式提交
    public void Commit() {
        if (this.uow != null && !this.disposed && !this.completionAttempted) {
            this.completionAttempted = true;
            this.committing = true;
            this.completionResult = false;
            this.completed = false;
            this.uow.Commit();
            this.completionResult = true;
            this.completed = true;
        }
    }

    // 异步显式提交；false 或异常均为终态，释放只清理，不重试提交。
    public async bool CommitAsync() {
        if (this.uow == null || this.disposed) { return false; }
        if (!this.completionAttempted) {
            this.completionAttempted = true;
            this.committing = true;
            this.completionResult = false;
            this.completed = false;
            this.completionResult = await this.uow.CommitAsync();
            this.completed = this.completionResult;
        }
        return this.committing && this.completionResult;
    }

    // 显式回滚
    public void Rollback() {
        if (this.uow != null && !this.disposed && !this.completionAttempted) {
            this.completionAttempted = true;
            this.committing = false;
            this.completionResult = false;
            this.completed = false;
            this.uow.Rollback();
            this.completionResult = true;
        }
    }

    // 异步显式回滚
    public async bool RollbackAsync() {
        if (this.uow == null || this.disposed) { return false; }
        if (!this.completionAttempted) {
            this.completionAttempted = true;
            this.committing = false;
            this.completionResult = false;
            this.completed = false;
            this.completionResult = await this.uow.RollbackAsync();
        }
        return !this.committing && this.completionResult;
    }

    // ---- 保存点（转发给工作单元）----
    //
    // 作用域里的保存点就是工作单元的保存点：转发即可，语义见 ISavepointScope。

    void SpCheckLive() {
        if (this.disposed) {
            throw new Exception("TransactionScope 已经释放，不能操作保存点");
        }
        if (this.uow == null) {
            throw new Exception("TransactionScope 没有工作单元，不能操作保存点");
        }
    }

    // 建立保存点。
    public void CreateSavepoint(string name) {
        this.SpCheckLive();
        this.uow.CreateSavepoint(name);
    }

    // 回滚到保存点：该点之后的写入撤销，保存点本身仍然活着。
    public void RollbackToSavepoint(string name) {
        this.SpCheckLive();
        this.uow.RollbackToSavepoint(name);
    }

    // 释放保存点：之后不能再回滚到它。
    public void ReleaseSavepoint(string name) {
        this.SpCheckLive();
        this.uow.ReleaseSavepoint(name);
    }

    // 异步版本。
    public async bool CreateSavepointAsync(string name) {
        this.SpCheckLive();
        return await this.uow.CreateSavepointAsync(name);
    }

    public async bool RollbackToSavepointAsync(string name) {
        this.SpCheckLive();
        return await this.uow.RollbackToSavepointAsync(name);
    }

    public async bool ReleaseSavepointAsync(string name) {
        this.SpCheckLive();
        return await this.uow.ReleaseSavepointAsync(name);
    }

    // IUnitOfWork owns cleanup (including rollback of an unfinished transaction).
    // A completion failure wins over a cleanup exception; cleanup alone still throws.
    void Cleanup() {
        if (this.completionResult) {
            try { this.uow.Dispose(); }
            catch (Exception) {
                // Cache failed disposal before propagating the cleanup-only exception.
                this.completionResult = false;
                throw;
            }
        } else {
            try { this.uow.Dispose(); }
            catch (Exception) { /* Don't mask the transaction's false result or original exception. */ }
        }
    }

    // 返回首次事务结束的结果；重复释放不再提交、回滚或清理。
    public async bool DisposeAsync() {
        if (this.disposed) { return this.completionResult; }
        this.disposed = true;

        if (this.uow != null) {
            try {
                if (!this.completionAttempted) {
                    this.completionAttempted = true;
                    this.committing = this.completed;
                    this.completionResult = false;
                    this.completed = false;
                    if (this.committing) {
                        this.completionResult = await this.uow.CommitAsync();
                        this.completed = this.completionResult;
                    } else {
                        this.completionResult = await this.uow.RollbackAsync();
                    }
                }
            } finally {
                this.Cleanup();
            }
        }
        return this.completionResult;
    }

    // 释放作用域：未显式结束时按 Complete 选择提交或回滚。
    public void Dispose() {
        if (this.disposed) { return; }
        this.disposed = true;

        if (this.uow != null) {
            try {
                if (!this.completionAttempted) {
                    this.completionAttempted = true;
                    this.committing = this.completed;
                    this.completionResult = false;
                    this.completed = false;
                    if (this.committing) {
                        this.uow.Commit();
                        this.completed = true;
                    } else {
                        this.uow.Rollback();
                    }
                    this.completionResult = true;
                }
            } finally {
                this.Cleanup();
            }
        }
    }
}
