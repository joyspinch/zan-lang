using System;
using System.Data;

namespace System.Data.Orm;

// CodeFirst：缺表建表、缺列加列、缺索引补索引。DDL 从实体元数据
// 直接算出来，同步与异步两条路径共用同一段文本构造。
public class Sync {
    // CREATE TABLE 语句。复合主键写成表级约束（列定义里
    // 不能各自带 PRIMARY KEY）。
    public static string CreateDdl(int p, Meta m, string t) {
        string pks = m.PkList();
        bool comp = pks.Length > 0;
        StringBuilder sb = new StringBuilder();
        sb.Append("CREATE TABLE " + t + " (");
        for (int i = 0; i < m.Cols.Count; i = i + 1) {
            Col c = m.Cols[i];
            if (i > 0) { sb.Append(", "); }
            sb.Append(c.Col + " ");
            sb.Append(Dialect.Ty(p, c.TyCode(), c.IsPk && !comp, c.IsIdent,
                                    c.StrLen));
        }
        if (comp) { sb.Append(", PRIMARY KEY (" + pks + ")"); }
        sb.Append(")");
        return sb.ToString();
    }

    // ALTER TABLE ... ADD COLUMN 语句（新列不带主键/自增修饰）。
    public static string AddColDdl(int p, Col c, string t) {
        return "ALTER TABLE " + t + " ADD COLUMN " + c.Col + " "
            + Dialect.Ty(p, c.TyCode(), false, false, c.StrLen);
    }

    // 执行一条 DDL；执行器以负数报告失败（内置驱动
    // 语句失败会直接抛 DbException，这里给不抛异常的
    // 自定义执行器兜底）时同样抛出，绝不让建表/加列悄悄落空。
    public static void ExecDdl(IDbExecutor db, string ddl) {
        int n = db.Execute(ddl);
        if (n < 0) {
            throw new DbException("DDL failed: " + ddl, 0, DbProvider.Unknown);
        }
    }

    // <see cref="ExecDdl"/> 的协程版本，失败约定相同。
    public static async bool ExecDdlAsync(IDbExecutor db, string ddl) {
        int n = await db.ExecuteAsync(ddl);
        if (n < 0) {
            throw new DbException("DDL failed: " + ddl, 0, DbProvider.Unknown);
        }
        return true;
    }

    // 同步路径的 schema 同步：缺表则建表并建全部索引；表已存在时
    // 逐列比对、缺列加列，最后补齐索引（幂等，可重复调用）。
    public static void Sync(IDbExecutor db, Meta m) {
        int p = db.GetProvider();
        string t = m.Table;
        if (!Dialect.HasTable(db, t)) {
            Sync.ExecDdl(db, Sync.CreateDdl(p, m, t));
            Sync.Indexes(db, m, t);
            return;
        }
        List<string> have = Dialect.Cols(db, t);
        for (int i = 0; i < m.Cols.Count; i = i + 1) {
            Col c = m.Cols[i];
            if (!Dialect.Has(have, c.Col)) {
                Sync.ExecDdl(db, Sync.AddColDdl(p, c, t));
            }
        }
        Sync.Indexes(db, m, t);
    }

    // <see cref="Sync"/> 的协程版本。
    public static async bool SyncAsync(IDbExecutor db, Meta m) {
        int p = db.GetProvider();
        string t = m.Table;
        bool exists = await Dialect.HasTableAsync(db, t);
        if (!exists) {
            await Sync.ExecDdlAsync(db, Sync.CreateDdl(p, m, t));
            await Sync.IndexesAsync(db, m, t);
            return true;
        }
        List<string> have = await Dialect.ColsAsync(db, t);
        for (int i = 0; i < m.Cols.Count; i = i + 1) {
            Col c = m.Cols[i];
            if (!Dialect.Has(have, c.Col)) {
                await Sync.ExecDdlAsync(db, Sync.AddColDdl(p, c, t));
            }
        }
        await Sync.IndexesAsync(db, m, t);
        return true;
    }

    // 按元数据补齐实体声明的全部索引（EnsureIndex 幂等）。
    public static void Indexes(IDbExecutor db, Meta m, string t) {
        for (int i = 0; i < m.Idx.Count; i = i + 1) {
            Index x = m.Idx[i];
            Dialect.EnsureIndex(db, x.Name, t, x.Cols, x.Unique);
        }
    }

    // <see cref="Indexes"/> 的协程版本。
    public static async bool IndexesAsync(IDbExecutor db, Meta m, string t) {
        for (int i = 0; i < m.Idx.Count; i = i + 1) {
            Index x = m.Idx[i];
            await Dialect.EnsureIndexAsync(db, x.Name, t, x.Cols, x.Unique);
        }
        return true;
    }
}
