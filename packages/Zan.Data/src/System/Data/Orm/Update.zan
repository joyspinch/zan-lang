using System;
using System.Data;
namespace System.Data.Orm;

public class Update {
    public IDbExecutor db;
    public Meta meta;
    public string tbl;
    public IRows src;
    public List<string> only;
    public List<string> skip;
    public string sets;
    public DbParams sp;
    public string w;
    public DbParams wp;
    public bool on;

    // 构造；统一经 <see cref="Create"/> 或直接创建。
    public Update(IDbExecutor db, Meta meta) {
        this.db = db;
        this.meta = meta;
        this.tbl = meta.Table;
        this.src = null;
        this.only = new List<string>();
        this.skip = new List<string>();
        this.sets = "";
        this.sp = new DbParams();
        this.w = "";
        this.wp = new DbParams();
        this.on = true;
    }

    // 为实体创建一个空 UPDATE 构造器。
    public static Update Create(IDbExecutor db, Meta meta) {
        return new Update(db, meta);
    }

    // 改写到另一张表（标识符校验，防注入）。
    public void AsTable(string t) { this.tbl = QueryBuilder.RequireIdent(t); }
    // 只更新该列（与 Skip 互斥语义，可多次调用，列名经元数据校验）。
    public void Only(string c) { this.only.Add(this.meta.Require(c)); }
    // 跳过该列（可多次调用，列名经元数据校验）。
    public void Skip(string c) { this.skip.Add(this.meta.Require(c)); }
    // 实体整体更新的值来源（取第一行）。
    public void SetSource(IRows rows) { this.src = rows; }
    // 条件开关：false 期间 W/P* 收集的片段全部失效（ORM 内部
    // 按条件组合调用，应用层一般不直接用）。
    public void CondBegin(bool c) { this.on = c; }
    // 结束条件区间，恢复片段收集。
    public void CondEnd() { this.on = true; }

    // 该列是否进 SET：Only 优先，其次非 Skip。
    public bool Use(string c) {
        if (this.only.Count > 0) { return Dialect.Has(this.only, c); }
        return !Dialect.Has(this.skip, c);
    }

    // 追加一段 SET 片段（片段间以逗号连接）。
    public void Frag(string f) {
        if (this.sets.Length > 0) { this.sets = this.sets + ", "; }
        this.sets = this.sets + f;
    }

    // SET 片段：追加一个 "col = ?" 并把值排入 SET 参数区。
    public void SetI(string c, int v) { this.sp.AddInt(v); this.Frag(this.RequireCol(c) + " = ?"); }
    // <see cref="SetI"/> 的 long 版本。
    public void SetL(string c, long v) { this.sp.AddLong(v); this.Frag(this.RequireCol(c) + " = ?"); }
    // <see cref="SetI"/> 的 double 版本。
    public void SetD(string c, double v) { this.sp.AddDouble(v); this.Frag(this.RequireCol(c) + " = ?"); }
    // <see cref="SetI"/> 的 string 版本。
    public void SetS(string c, string v) { this.sp.Add(v); this.Frag(this.RequireCol(c) + " = ?"); }

    // 布尔值写整型 0/1。
    public void SetB(string c, bool v) {
        if (v) { this.sp.AddInt(1); } else { this.sp.AddInt(0); }
        this.Frag(this.RequireCol(c) + " = ?");
    }

    // 自增片段："col = col + ?"（数据库侧原值累加）。
    public void SetIncrI(string c, int v) {
        string col = this.RequireCol(c);
        this.sp.AddInt(v);
        this.Frag(col + " = " + col + " + ?");
    }

    // <see cref="SetIncrI"/> 的 long 版本。
    public void SetIncrL(string c, long v) {
        string col = this.RequireCol(c);
        this.sp.AddLong(v);
        this.Frag(col + " = " + col + " + ?");
    }

    // <see cref="SetIncrI"/> 的 double 版本。
    public void SetIncrD(string c, double v) {
        string col = this.RequireCol(c);
        this.sp.AddDouble(v);
        this.Frag(col + " = " + col + " + ?");
    }

    // 字典键值批量进 SET（列名经元数据校验，按列类型绑定）。
    public void SetDict(DbValues v) {
        for (int i = 0; i < v.Count(); i = i + 1) {
            string c = this.meta.Require(v.NameAt(i));
            if (this.Use(c)) {
                v.BindAs(this.sp, i, this.meta.KindOf(c));
                this.Frag(c + " = ?");
            }
        }
    }

    // WHERE 片段：多个片段以 AND 连接。
    public void W(string f) {
        if (!this.on) { return; }
        string u = Dialect.Unalias(f);
        if (this.w.Length == 0) { this.w = u; }
        else { this.w = this.w + " AND " + u; }
    }

    // 字典键值批量进 WHERE（等值条件）。
    public void WhereDict(DbValues v) {
        if (!this.on) { return; }
        for (int i = 0; i < v.Count(); i = i + 1) {
            string c = this.meta.Require(v.NameAt(i));
            this.W(c + " = ?");
            v.BindAs(this.wp, i, this.meta.KindOf(c));
        }
    }

    /* ---- 值自带条件原语：条件与值同一次调用原子绑定。单表 UPDATE
     * 没有 "t." 别名，列名按实体校验（多余前缀剥掉），未知列抛异常。 */

    // 校验列名属于本实体（剥掉可选的 "t." 前缀）；未知列抛异常。
    public string RequireCol(string c) {
        string n = c;
        if (n.Length > 2 && n.IndexOf("t.") == 0) { n = n.Substring(2); }
        if (!this.meta.Has(n)) {
            throw new Exception(this.meta.Table + " has no column: " + c);
        }
        return n;
    }

    // column = 文本值。
    public void WhereEq(string c, string v) {
        if (!this.on) { return; }
        this.W(this.RequireCol(c) + " = ?");
        this.wp.Add(v);
    }

    // column = 整数值。
    public void WhereEq(string c, int v) {
        if (!this.on) { return; }
        this.W(this.RequireCol(c) + " = ?");
        this.wp.AddInt(v);
    }

    // column = 64 位整数值。
    public void WhereEq(string c, long v) {
        if (!this.on) { return; }
        this.W(this.RequireCol(c) + " = ?");
        this.wp.AddLong(v);
    }

    // column IN (逐个占位符)；空列表按恒假处理，不生成 `IN ()`。带 2000 参数安全防御上限。
    public void WhereIn(string c, List<int> vs) {
        if (!this.on) { return; }
        if (vs.Count == 0) { this.W("1 = 0"); return; }
        if (vs.Count > 2000) {
            throw new Exception("WhereIn parameter count exceeds safety limit of 2000");
        }
        StringBuilder sb = new StringBuilder();
        sb.Append(this.RequireCol(c) + " IN (");
        for (int i = 0; i < vs.Count; i = i + 1) {
            if (i > 0) { sb.Append(", "); }
            sb.Append("?");
            this.wp.AddInt(vs[i]);
        }
        sb.Append(")");
        this.W(sb.ToString());
    }

    // <see cref="WhereIn"/> 的 long 版本。
    public void WhereIn(string c, List<long> vs) {
        if (!this.on) { return; }
        if (vs.Count == 0) { this.W("1 = 0"); return; }
        if (vs.Count > 2000) {
            throw new Exception("WhereIn parameter count exceeds safety limit of 2000");
        }
        StringBuilder sb = new StringBuilder();
        sb.Append(this.RequireCol(c) + " IN (");
        for (int i = 0; i < vs.Count; i = i + 1) {
            if (i > 0) { sb.Append(", "); }
            sb.Append("?");
            this.wp.AddLong(vs[i]);
        }
        sb.Append(")");
        this.W(sb.ToString());
    }

    // <see cref="WhereIn"/> 的 string 版本。
    public void WhereIn(string c, List<string> vs) {
        if (!this.on) { return; }
        if (vs.Count == 0) { this.W("1 = 0"); return; }
        if (vs.Count > 2000) {
            throw new Exception("WhereIn parameter count exceeds safety limit of 2000");
        }
        StringBuilder sb = new StringBuilder();
        sb.Append(this.RequireCol(c) + " IN (");
        for (int i = 0; i < vs.Count; i = i + 1) {
            if (i > 0) { sb.Append(", "); }
            sb.Append("?");
            this.wp.Add(vs[i]);
        }
        sb.Append(")");
        this.W(sb.ToString());
    }

    // 恒假条件：数据边界为空集时用它表达"一行都不许动"。
    public void WhereNone() {
        if (!this.on) { return; }
        this.W("1 = 0");
    }

    // WHERE 参数：与 W 片段中占位符的出现顺序一致。
    public void P(string v) { if (this.on) { this.wp.Add(v); } }
    // WHERE 整数参数。
    public void Pi(int v) { if (this.on) { this.wp.AddInt(v); } }
    // WHERE 64 位整数参数。
    public void Pl(long v) { if (this.on) { this.wp.AddLong(v); } }
    // WHERE 浮点参数。
    public void Pd(double v) { if (this.on) { this.wp.AddDouble(v); } }

    // IN 列表参数（配合 W 片段里的 "col IN (?)"）。
    public void InI(List<int> vs) {
        if (!this.on) { return; }
        for (int i = 0; i < vs.Count; i = i + 1) { this.wp.AddInt(vs[i]); }
    }

    // <see cref="InI"/> 的 long 版本。
    public void InL(List<long> vs) {
        if (!this.on) { return; }
        for (int i = 0; i < vs.Count; i = i + 1) { this.wp.AddLong(vs[i]); }
    }

    // <see cref="InI"/> 的 string 版本。
    public void InS(List<string> vs) {
        if (!this.on) { return; }
        for (int i = 0; i < vs.Count; i = i + 1) { this.wp.Add(vs[i]); }
    }

    // <see cref="InI"/> 的 double 版本。
    public void InD(List<double> vs) {
        if (!this.on) { return; }
        for (int i = 0; i < vs.Count; i = i + 1) { this.wp.AddDouble(vs[i]); }
    }

    // 实体整体更新：列在执行时展开，Only/Skip 的链顺序
    // 任意；定位列取实体主键（含复合主键），没有主键则无法定位、
    // 什么也不做。
    public void ApplySource() {
        if (this.src == null) { return; }
        IRows o = this.src;
        this.src = null;
        if (o.RowCount() == 0) { return; }
        if (this.meta.PkCol() == null) { return; }
        for (int i = 0; i < this.meta.Cols.Count; i = i + 1) {
            Col c = this.meta.Cols[i];
            if (c.IsPk || !this.Use(c.Col)) { continue; }
            o.BindCol(0, c, this.sp);
            this.Frag(c.Col + " = ?");
        }
        for (int i = 0; i < this.meta.Cols.Count; i = i + 1) {
            Col c = this.meta.Cols[i];
            if (!c.IsPk) { continue; }
            this.W(c.Col + " = ?");
            o.BindCol(0, c, this.wp);
        }
    }

    // 生成 UPDATE 语句；无 SET 或无 WHERE 时返回 ""
    // （绝无全表更新）。
    public string BuildUpdate() {
        this.ApplySource();
        if (this.sets.Length == 0) { return ""; }
        if (this.w.Length == 0) { return ""; }
        return "UPDATE " + this.tbl + " SET " + this.sets + " WHERE " + this.w;
    }

    // 执行并返回受影响行数。
    public int ExecuteAffrows() {
        string sql = this.BuildUpdate();
        if (sql.Length == 0) { return 0; }
        return this.db.Execute(sql, Dialect.Cat(this.sp, this.wp));
    }

    // 异步执行并返回受影响行数。
    public async int ExecuteAffrowsAsync() {
        string sql = this.BuildUpdate();
        if (sql.Length == 0) { return 0; }
        return await this.db.ExecuteAsync(sql,
                                          Dialect.Cat(this.sp, this.wp));
    }
}

// 类型化 DELETE 的运行期实现：条件片段 + 绑定值。
// 没有条件时不执行（不生成全表删除）。
