using System;
using System.Data;
namespace System.Data.Orm;

public class AopProvider : IAop {
    public Action<AuditValueEventArgs> handler;

    public AopProvider() {
        this.handler = null;
    }

    public void SetAuditValueHandler(Action<AuditValueEventArgs> handler) {
        this.handler = handler;
    }

    public void Audit(AuditValueEventArgs e) {
        if (this.handler != null && e != null) {
            this.handler(e);
        }
    }
}
