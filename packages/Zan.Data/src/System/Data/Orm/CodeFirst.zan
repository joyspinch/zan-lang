using System;
using System.Data;
namespace System.Data.Orm;

public class CodeFirst : ICodeFirst {
    public IDbExecutor db;

    public CodeFirst(IDbExecutor db) {
        this.db = db;
    }

    public void SetExecutor(IDbExecutor db) {
        this.db = db;
    }

    public void SyncStructure(Meta meta) {
        if (this.db == null || meta == null) { return; }
        Sync.Sync(this.db, meta);
    }

    public async void SyncStructureAsync(Meta meta) {
        if (this.db == null || meta == null) { return; }
        await Sync.SyncAsync(this.db, meta);
    }

    private IDbExecutor RequireDb() {
        if (this.db == null) { throw new InvalidOperationException("CodeFirst executor is null"); }
        return this.db;
    }

    // IDbExecutor 透传实现
    public DbResult Query(string sql, DbParams prms) { return this.RequireDb().Query(sql, prms); }
    public int Execute(string sql, DbParams prms) { return this.RequireDb().Execute(sql, prms); }
    public DbResult Query(string sql) { return this.RequireDb().Query(sql); }
    public int Execute(string sql) { return this.RequireDb().Execute(sql); }
    public string ExecuteScalar(string sql) { return this.RequireDb().ExecuteScalar(sql); }
    public string ExecuteScalar(string sql, DbParams prms) { return this.RequireDb().ExecuteScalar(sql, prms); }
    public int GetProvider() { return this.RequireDb().GetProvider(); }

    public async DbResult QueryAsync(string sql, DbParams prms) { return await this.RequireDb().QueryAsync(sql, prms); }
    public async int ExecuteAsync(string sql, DbParams prms) { return await this.RequireDb().ExecuteAsync(sql, prms); }
    public async DbResult QueryAsync(string sql) { return await this.RequireDb().QueryAsync(sql); }
    public async int ExecuteAsync(string sql) { return await this.RequireDb().ExecuteAsync(sql); }
    public async string ExecuteScalarAsync(string sql) { return await this.RequireDb().ExecuteScalarAsync(sql); }
    public async string ExecuteScalarAsync(string sql, DbParams prms) { return await this.RequireDb().ExecuteScalarAsync(sql, prms); }
}
