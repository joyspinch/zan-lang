using System;
using System.Data;
namespace System.Data.Orm;

public class CodeFirst : ICodeFirst {
    public IDbExecutor db;

    public CodeFirst(IDbExecutor db) {
        this.db = db;
    }

    public void SetExecutor(IDbExecutor db) {
        this.db = db;
    }

    public void SyncStructure(Meta meta) {
        if (this.db == null || meta == null) { return; }
        Sync.Sync(this.db, meta);
    }

    public async void SyncStructureAsync(Meta meta) {
        if (this.db == null || meta == null) { return; }
        await Sync.SyncAsync(this.db, meta);
    }

    // IDbExecutor 透传实现
    public DbResult Query(string sql, DbParams prms) { return this.db.Query(sql, prms); }
    public int Execute(string sql, DbParams prms) { return this.db.Execute(sql, prms); }
    public DbResult Query(string sql) { return this.db.Query(sql); }
    public int Execute(string sql) { return this.db.Execute(sql); }
    public string ExecuteScalar(string sql) { return this.db.ExecuteScalar(sql); }
    public string ExecuteScalar(string sql, DbParams prms) { return this.db.ExecuteScalar(sql, prms); }
    public int GetProvider() { return this.db.GetProvider(); }

    public async DbResult QueryAsync(string sql, DbParams prms) { return await this.db.QueryAsync(sql, prms); }
    public async int ExecuteAsync(string sql, DbParams prms) { return await this.db.ExecuteAsync(sql, prms); }
    public async DbResult QueryAsync(string sql) { return await this.db.QueryAsync(sql); }
    public async int ExecuteAsync(string sql) { return await this.db.ExecuteAsync(sql); }
    public async string ExecuteScalarAsync(string sql) { return await this.db.ExecuteScalarAsync(sql); }
    public async string ExecuteScalarAsync(string sql, DbParams prms) { return await this.db.ExecuteScalarAsync(sql, prms); }
}
