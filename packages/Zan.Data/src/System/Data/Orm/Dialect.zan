using System;
using System.Text;
using System.Data;

namespace System.Data.Orm;

// SQL 方言与目录探测：标识符转义、upsert 写法、表/列/索引存在性与自增值。
public class Dialect {
    // 对表名、列名、索引名等标识符按数据库方言进行转义包装，避免保留关键字（如 Order/User/Group/Key/Desc 等）语法崩毁。
    public static string QuoteIdentifier(int p, string ident) {
        if (ident == null || ident.Length == 0) { return ""; }
        if (ident == "*") { return "*"; }
        int len = ident.Length;
        char first = ident[0];
        char last = ident[len - 1];
        if (first == '`' && last == '`') { return ident; }
        if (first == '[' && last == ']') { return ident; }
        if (first == '"' && last == '"') { return ident; }

        if (ident.Contains(".")) {
            List<string> parts = ident.Split(".");
            StringBuilder sb = new StringBuilder();
            for (int i = 0; i < parts.Count; i = i + 1) {
                if (i > 0) { sb.Append("."); }
                sb.Append(Dialect.QuoteIdentifier(p, parts[i]));
            }
            return sb.ToString();
        }

        if (p == DbProvider.MySQL || p == DbProvider.MariaDB) {
            string escaped = ident.Replace("`", "``");
            return "`" + escaped + "`";
        }
        if (p == DbProvider.SqlServer) {
            string escaped = ident.Replace("]", "]]");
            return "[" + escaped + "]";
        }
        // SQLite, PostgreSQL, Oracle, DuckDB, Firebird, DM, Kingbase, OpenGauss 及默认标准方言
        string escapedDbl = ident.Replace("\"", "\"\"");
        return "\"" + escapedDbl + "\"";
    }

    // `?, ?, ?` —— n 个占位符（n 为 0 时是 NULL）。
    public static string Marks(int n) {
        StringBuilder sb = new StringBuilder();
        int i = 0;
        while (i < n) {
            if (i > 0) { sb.Append(", "); }
            sb.Append("?");
            i = i + 1;
        }
        if (sb.Length == 0) { sb.Append("NULL"); }
        return sb.ToString();
    }

    // 列表是否包含某值。
    public static bool Has(List<string> l, string v) {
        int i = 0;
        while (i < l.Count) {
            if (l[i] == v) { return true; }
            i = i + 1;
        }
        return false;
    }

    // WHERE 片段里的 `t.` 别名在 UPDATE/DELETE 上不成立。
    public static string Unalias(string f) { return f.Replace("t.", ""); }

    // 两段参数按顺序合成一段（SET 在前、WHERE 在后）。
    public static DbParams Cat(DbParams a, DbParams b) {
        DbParams r = new DbParams();
        Dialect.CopyInto(a, r);
        Dialect.CopyInto(b, r);
        return r;
    }

    // 按各自的类型码把参数逐个复制到 dst。
    public static void CopyInto(DbParams src, DbParams dst) {
        int i = 0;
        while (i < src.Count()) {
            int k = src.KindAt(i);
            if (k == DbParams.KindInt) { dst.AddLong(src.IntAt(i)); }
            else if (k == DbParams.KindDouble) { dst.AddDouble(src.DoubleAt(i)); }
            else if (k == DbParams.KindText) { dst.Add(src.TextAt(i)); }
            else { dst.AddNull(); }
            i = i + 1;
        }
    }

    // upsert 的冲突头：各家写法不同（ON CONFLICT /
    // ON DUPLICATE KEY / MERGE 前的 ON ...）。
    public static string ConflictHead(int p, List<string> keys, bool nop) {
        bool my = p == DbProvider.MySQL || p == DbProvider.MariaDB;
        bool pg = p == DbProvider.PostgreSQL || p == DbProvider.OpenGauss
                  || p == DbProvider.Kingbase;
        if (!my && !pg && p != DbProvider.SQLite) {
            throw new Exception(
                "Upsert (OnConflict) is not supported on this provider");
        }
        if (my) {
            string qk0 = Dialect.QuoteIdentifier(p, keys[0]);
            if (nop) {
                return " ON DUPLICATE KEY UPDATE " + qk0 + " = "
                    + qk0;
            }
            return " ON DUPLICATE KEY UPDATE ";
        }
        StringBuilder sb = new StringBuilder();
        sb.Append(" ON CONFLICT (");
        int i = 0;
        while (i < keys.Count) {
            if (i > 0) { sb.Append(", "); }
            sb.Append(Dialect.QuoteIdentifier(p, keys[i]));
            i = i + 1;
        }
        sb.Append(")");
        if (nop) { sb.Append(" DO NOTHING"); }
        else { sb.Append(" DO UPDATE SET "); }
        return sb.ToString();
    }

    // 冲突时一列的新值：直接覆盖（0）、累加（1）、
    // 取大（2）、取小（3）。
    public static string Excl(int p, string c, int md) {
        bool my = p == DbProvider.MySQL || p == DbProvider.MariaDB;
        string qc = Dialect.QuoteIdentifier(p, c);
        string src = my ? "VALUES(" + qc + ")" : "excluded." + qc;
        if (md == 1) { return qc + " = " + qc + " + " + src; }
        if (md == 2 || md == 3) {
            string fn = md == 2 ? "GREATEST" : "LEAST";
            if (p == DbProvider.SQLite) { fn = md == 2 ? "max" : "min"; }
            return qc + " = " + fn + "(" + qc + ", " + src + ")";
        }
        return qc + " = " + src;
    }

    // 列 c 的冲突更新模式码：累加 1、取大 2、取小 3、覆盖 0（与 Excl 的 md 对应）。
    public static int Mode(List<string> acc, List<string> mx, List<string> mn,
                    string c) {
        if (Dialect.Has(acc, c)) { return 1; }
        if (Dialect.Has(mx, c)) { return 2; }
        if (Dialect.Has(mn, c)) { return 3; }
        return 0;
    }

    // 刚插入行的自增值 SQL（不支持会话级 last id 的引擎直接报错）。
    public static string LastIdSql(IDbExecutor db) {
        int p = db.GetProvider();
        if (p == DbProvider.SQLite) {
            return "SELECT last_insert_rowid()";
        }
        if (p == DbProvider.MySQL || p == DbProvider.MariaDB) {
            return "SELECT LAST_INSERT_ID()";
        }
        if (p == DbProvider.PostgreSQL || p == DbProvider.OpenGauss
                || p == DbProvider.Kingbase) {
            return "SELECT lastval()";
        }
        if (p == DbProvider.SqlServer || p == DbProvider.DM) {
            return "SELECT SCOPE_IDENTITY()";
        }
        throw new DbException(
            "the provider has no session-wide last id; read the identity "
            + "via INSERT ... RETURNING instead (provider id "
            + Convert.ToString(p) + ")", 0, p);
    }

    // 查询刚插入行的自增值；无行时为 0。
    public static int LastId(IDbExecutor db) {
        DbResult r = db.Query(Dialect.LastIdSql(db));
        if (r.RowCount() == 0) { return 0; }
        return r.GetInt(0, 0);
    }

    // LastId 的异步版本。
    public static async int LastIdAsync(IDbExecutor db) {
        string sql = Dialect.LastIdSql(db);
        DbResult r = await db.QueryAsync(sql);
        if (r.RowCount() == 0) { return 0; }
        return r.GetInt(0, 0);
    }

    // 目录探测的库/schema 作用域过滤子句（限定在当前连接所属库/schema）。
    public static string OwnScope(int p) {
        if (p == DbProvider.MySQL || p == DbProvider.MariaDB) {
            return " AND table_schema = DATABASE()";
        }
        if (p == DbProvider.PostgreSQL || p == DbProvider.OpenGauss
                || p == DbProvider.Kingbase) {
            return " AND table_schema = current_schema()";
        }
        if (p == DbProvider.SqlServer || p == DbProvider.DM) {
            return " AND table_schema = SCHEMA_NAME()";
        }
        return "";
    }

    // 该 provider 是否提供 information_schema 目录。
    public static bool HasInformationSchema(int p) {
        return p == DbProvider.MySQL || p == DbProvider.MariaDB
            || p == DbProvider.PostgreSQL || p == DbProvider.OpenGauss
            || p == DbProvider.Kingbase || p == DbProvider.SqlServer
            || p == DbProvider.DM;
    }

    // 表存在性探测 SQL（带参数占位符）；不支持目录探测的 provider 抛错。
    public static string HasTableSql(IDbExecutor db) {
        int p = db.GetProvider();
        if (p == DbProvider.SQLite) {
            return "SELECT COUNT(*) FROM sqlite_master WHERE type = 'table'"
                + " AND name = ?";
        }
        if (p == DbProvider.Firebird) {
            // 未加引号的标识符以大写存储；CHAR(N) 比较按标准
            // 补空格，视图不算表。
            return "SELECT COUNT(*) FROM RDB$RELATIONS"
                + " WHERE RDB$RELATION_NAME = UPPER(?)"
                + " AND RDB$VIEW_BLR IS NULL";
        }
        if (Dialect.HasInformationSchema(p)) {
            return "SELECT COUNT(*) FROM information_schema.tables"
                + " WHERE table_name = ?" + Dialect.OwnScope(p);
        }
        throw new DbException(
            "CodeFirst catalog queries are not supported for provider id "
            + Convert.ToString(p), 0, p);
    }

    // 表是否存在。
    public static bool HasTable(IDbExecutor db, string t) {
        DbResult r = db.Query(Dialect.HasTableSql(db),
                              new DbParams().Add(t));
        if (r.RowCount() == 0) { return false; }
        return r.GetInt(0, 0) > 0;
    }

    // HasTable 的异步版本。
    public static async bool HasTableAsync(IDbExecutor db, string t) {
        string sql = Dialect.HasTableSql(db);
        DbResult r = await db.QueryAsync(sql, new DbParams().Add(t));
        if (r.RowCount() == 0) { return false; }
        return r.GetInt(0, 0) > 0;
    }

    // information_schema 列名查询（限自身库/schema）。
    public static string ColsSql(int p) {
        return "SELECT column_name FROM information_schema.columns"
            + " WHERE table_name = ?" + Dialect.OwnScope(p);
    }

    private static List<string> ReadColNames(DbResult r, int nameCol, bool padded) {
        List<string> cols = new List<string>();
        int i = 0;
        while (i < r.RowCount()) {
            string nm = r.GetString(i, nameCol);
            if (padded) { nm = nm.Trim(); }
            cols.Add(nm);
            i = i + 1;
        }
        return cols;
    }

    // 查询表已有列名清单（SQLite 走 PRAGMA table_info，Firebird 裁剪 CHAR(31) 尾空格）。
    public static List<string> Cols(IDbExecutor db, string t) {
        QueryBuilder.RequireIdent(t);
        int p = db.GetProvider();
        DbResult r;
        int nameCol = 0;
        bool padded = false;
        if (p == DbProvider.SQLite) {
            r = db.Query("PRAGMA table_info(" + Dialect.QuoteIdentifier(p, t) + ")");
            nameCol = 1;
        } else if (p == DbProvider.Firebird) {
            r = db.Query("SELECT RDB$FIELD_NAME FROM RDB$RELATION_FIELDS"
                + " WHERE RDB$RELATION_NAME = UPPER(?)"
                + " ORDER BY RDB$FIELD_POSITION", new DbParams().Add(t));
            padded = true;
        } else if (Dialect.HasInformationSchema(p)) {
            r = db.Query(Dialect.ColsSql(p), new DbParams().Add(t));
        } else {
            throw new DbException(
                "CodeFirst catalog queries are not supported for provider id "
                + Convert.ToString(p), 0, p);
        }
        return Dialect.ReadColNames(r, nameCol, padded);
    }

    // Cols 的异步版本。
    public static async List<string> ColsAsync(IDbExecutor db, string t) {
        QueryBuilder.RequireIdent(t);
        int p = db.GetProvider();
        DbResult r;
        int nameCol = 0;
        bool padded = false;
        if (p == DbProvider.SQLite) {
            string ps = "PRAGMA table_info(" + Dialect.QuoteIdentifier(p, t) + ")";
            r = await db.QueryAsync(ps);
            nameCol = 1;
        } else if (p == DbProvider.Firebird) {
            r = await db.QueryAsync("SELECT RDB$FIELD_NAME FROM RDB$RELATION_FIELDS"
                + " WHERE RDB$RELATION_NAME = UPPER(?)"
                + " ORDER BY RDB$FIELD_POSITION", new DbParams().Add(t));
            padded = true;
        } else if (Dialect.HasInformationSchema(p)) {
            string cs = Dialect.ColsSql(p);
            r = await db.QueryAsync(cs, new DbParams().Add(t));
        } else {
            throw new DbException(
                "CodeFirst catalog queries are not supported for provider id "
                + Convert.ToString(p), 0, p);
        }
        return Dialect.ReadColNames(r, nameCol, padded);
    }

    // 二级索引存在性探测 SQL（按方言给出，MySQL/SQL Server 连同表名比对）。
    public static string HasIndexSql(int p) {
        if (p == DbProvider.SQLite) {
            return "SELECT COUNT(*) FROM sqlite_master WHERE type = 'index'"
                + " AND name = ?";
        }
        if (p == DbProvider.MySQL || p == DbProvider.MariaDB) {
            return "SELECT COUNT(*) FROM information_schema.statistics"
                + " WHERE index_name = ? AND table_schema = DATABASE()"
                + " AND table_name = ?";
        }
        if (p == DbProvider.SqlServer || p == DbProvider.DM) {
            return "SELECT COUNT(*) FROM sys.indexes"
                + " WHERE name = ? AND object_id = OBJECT_ID(?)";
        }
        if (p == DbProvider.Firebird) {
            // 索引名数据库内唯一，无须再按表过滤。
            return "SELECT COUNT(*) FROM RDB$INDICES"
                + " WHERE RDB$INDEX_NAME = UPPER(?)";
        }
        if (p == DbProvider.PostgreSQL || p == DbProvider.OpenGauss
                || p == DbProvider.Kingbase) {
            // 索引在 schema 内唯一（索引本身是一种关系）。
            return "SELECT COUNT(*) FROM pg_indexes"
                + " WHERE indexname = ? AND schemaname = current_schema()";
        }
        throw new DbException(
            "CodeFirst catalog queries are not supported for provider id "
            + Convert.ToString(p), 0, p);
    }

    // HasIndexSql 对应的探测参数：按表名比对的方言为 (索引名, 表名)，其余为 (索引名)。
    public static DbParams IndexProbeParams(int p, string nm, string t) {
        if (p == DbProvider.MySQL || p == DbProvider.MariaDB
                || p == DbProvider.SqlServer || p == DbProvider.DM) {
            return new DbParams().Add(nm).Add(t);
        }
        return new DbParams().Add(nm);
    }

    // CREATE [UNIQUE] INDEX 语句文本（全参数合法标识符校验，防注入）。
    public static string IndexDdl(int p, string nm, string t, string cols,
                           bool uniq) {
        QueryBuilder.RequireIdent(nm);
        QueryBuilder.RequireIdent(t);
        List<string> parts = cols.Split(",");
        for (int i = 0; i < parts.Count; i = i + 1) {
            QueryBuilder.RequireIdent(parts[i].Trim());
        }
        return "CREATE " + (uniq ? "UNIQUE " : "") + "INDEX " + nm + " ON "
            + t + " (" + cols + ")";
    }

    // 索引不存在时创建；DDL 失败（负返回值）抛 DbException。
    public static void EnsureIndex(IDbExecutor db, string nm, string t, string cols,
                            bool uniq) {
        int p = db.GetProvider();
        DbResult r = db.Query(Dialect.HasIndexSql(p),
                              Dialect.IndexProbeParams(p, nm, t));
        if (r.RowCount() > 0 && r.GetInt(0, 0) > 0) { return; }
        string ddl = Dialect.IndexDdl(p, nm, t, cols, uniq);
        int n = db.Execute(ddl);
        if (n < 0) {
            throw new DbException("DDL failed: " + ddl, 0, DbProvider.Unknown);
        }
    }

    // EnsureIndex 的异步版本。
    public static async bool EnsureIndexAsync(IDbExecutor db, string nm, string t,
                                       string cols, bool uniq) {
        int p = db.GetProvider();
        DbResult r = await db.QueryAsync(Dialect.HasIndexSql(p),
                                         Dialect.IndexProbeParams(p, nm, t));
        if (r.RowCount() > 0 && r.GetInt(0, 0) > 0) { return true; }
        string ddl = Dialect.IndexDdl(p, nm, t, cols, uniq);
        int n = await db.ExecuteAsync(ddl);
        if (n < 0) {
            throw new DbException("DDL failed: " + ddl, 0, DbProvider.Unknown);
        }
        return true;
    }

    // 列的 DDL 类型。kind：0 int/enum、1 double、2 bool、
    // 3 string、4 64 位整数。string 的 len=-1 表示大文本（Column.DbType="text"），
    // 其余非正长度仍使用默认 255，正长度保留原映射。
    public static string Ty(int p, int kind, bool pk, bool ident, int len) {
        bool my = p == DbProvider.MySQL || p == DbProvider.MariaDB;
        bool pg = p == DbProvider.PostgreSQL || p == DbProvider.OpenGauss
                  || p == DbProvider.Kingbase;
        bool ms = p == DbProvider.SqlServer || p == DbProvider.DM;
        bool largeText = kind == 3 && len == -1;
        if (len <= 0) { len = 255; }
        if (ident) {
            if (my) { return "INT NOT NULL AUTO_INCREMENT PRIMARY KEY"; }
            if (pg) { return "SERIAL PRIMARY KEY"; }
            if (ms) { return "INT IDENTITY(1,1) PRIMARY KEY"; }
            return "INTEGER PRIMARY KEY AUTOINCREMENT";
        }
        string t = "INTEGER";
        if (kind == 4) {
            if (p == DbProvider.SQLite) { t = "INTEGER"; } else { t = "BIGINT"; }
            if (pk) { t = t + " PRIMARY KEY"; }
            return t;
        }
        if (kind == 1) {
            t = "DOUBLE PRECISION";
            if (my) { t = "DOUBLE"; }
            if (ms) { t = "FLOAT"; }
            if (p == DbProvider.SQLite) { t = "REAL"; }
        } else if (kind == 2) {
            t = "BOOLEAN";
            if (my) { t = "TINYINT(1)"; }
            if (ms) { t = "BIT"; }
            if (p == DbProvider.SQLite) { t = "INTEGER"; }
        } else if (kind == 3) {
            t = "VARCHAR(" + Convert.ToString(len) + ")";
            if (p == DbProvider.SQLite) { t = "TEXT"; }
            if (ms) { t = "NVARCHAR(" + Convert.ToString(len) + ")"; }
            if (largeText) {
                t = "TEXT";
                if (my) { t = "LONGTEXT"; }
                if (ms) { t = "NVARCHAR(MAX)"; }
            }
        } else {
            if (my || ms) { t = "INT"; }
        }
        if (pk) { t = t + " PRIMARY KEY"; }
        return t;
    }
}
