using System;
using System.Data;

namespace System.Data.Orm;

// 运行期成形的表网关：表名与列名在编译期还不知道（代码生成器
// 设计出来的表、导入的电子表格、外部库），因此无法用
// <c>Select&lt;T&gt;</c> 那样的实体链，但业务代码同样不该去拼 SQL。
// 核心契约与语义定义。
// await t.InsertAsync(form);                  // form 是 DbValues
// await t.UpdateAsync(form, "id", id);
// await t.DeleteAsync("id", id);
// 表名与每个列名都按标识符规则校验（<see cref="QueryBuilder"/>
// 的 RequireIdent），值一律作为绑定参数，绝不进入 SQL 文本。
// SQL 文本由 <see cref="QueryBuilder"/> 生成 —— 调用方只描述
// 要读写什么。
class DbTable {
    IDbConnection conn;
    string table;

    DbTable(IDbConnection conn, string table) {
        this.conn = conn;
        this.table = QueryBuilder.RequireIdent(table);
    }

    // 某个连接上的一张运行期表。
    static DbTable Of(IDbConnection conn, string table) {
        return new DbTable(conn, table);
    }

    // 表名（已校验）。
    string Name() { return this.table; }

    // 这张表上的一次读取：条件、排序、分页。
    DbTableQuery Query() {
        return new DbTableQuery(this.conn, this.table);
    }

    // 按主键读取一行的全部列，没有该行时返回 null。
    async DbResult ReadAsync(string keyColumn, long key) {
        DbTableQuery q = this.Query().WhereEq(keyColumn, key).Limit(1);
        DbResult r = await q.ToResultAsync();
        if (r == null || r.RowCount() == 0) { return null; }
        return r;
    }

    // 写入一行动态列，返回写入行数。
    async int InsertAsync(DbValues row) {
        if (row.Count() == 0) { throw new Exception("insert without columns"); }
        QueryBuilder qb = QueryBuilder.InsertInto(this.table);
        DbParams ps = new DbParams();
        for (int i = 0; i < row.Count(); i = i + 1) {
            qb.SetParam(row.NameAt(i));
            row.BindTo(ps, i);
        }
        return await this.conn.ExecuteAsync(qb.BuildInsertParams(), ps);
    }

    // 按主键更新一行的动态列，返回更新行数。
    async int UpdateAsync(DbValues row, string keyColumn, long key) {
        if (row.Count() == 0) { throw new Exception("update without columns"); }
        QueryBuilder qb = QueryBuilder.Update(this.table);
        DbParams ps = new DbParams();
        for (int i = 0; i < row.Count(); i = i + 1) {
            qb.SetParam(row.NameAt(i));
            row.BindTo(ps, i);
        }
        qb.Where(QueryBuilder.RequireIdent(keyColumn) + " = ?");
        ps.AddLong(key);
        return await this.conn.ExecuteAsync(qb.BuildUpdateParams(), ps);
    }

    // 按主键删除一行，返回删除行数。
    async int DeleteAsync(string keyColumn, long key) {
        DbTableQuery q = this.Query().WhereEq(keyColumn, key);
        return await q.ExecuteDeleteAsync();
    }
}

// <see cref="DbTable"/> 上的一次读取：条件、排序、分页都用列名
// 描述，执行时才由 <see cref="QueryBuilder"/> 变成参数化 SQL。
class DbTableQuery {
    IDbConnection conn;
    QueryBuilder qb;
    int limitVal;
    int offsetVal;

    DbTableQuery(IDbConnection conn, string table) {
        this.conn = conn;
        this.qb = QueryBuilder.From(table);
        this.limitVal = 0 - 1;
        this.offsetVal = 0 - 1;
    }

    // column = 文本值。
    DbTableQuery WhereEq(string column, string val) {
        this.qb.WhereEq(column, val);
        return this;
    }

    // column = 整数值。
    DbTableQuery WhereEq(string column, long val) {
        this.qb.WhereEqLong(column, val);
        return this;
    }

    // column >= 整数值。
    DbTableQuery WhereGe(string column, long val) {
        this.qb.WhereGeLong(column, val);
        return this;
    }

    // column &lt;= 整数值。
    DbTableQuery WhereLe(string column, long val) {
        this.qb.WhereLeLong(column, val);
        return this;
    }

    // column LIKE %val%（子串匹配）。
    DbTableQuery WhereContains(string column, string val) {
        this.qb.WhereContains(column, val);
        return this;
    }

    // DbValues 里的每一列都按等值匹配（提交上来的
    // 筛选表单原样交给 ORM）。
    DbTableQuery WhereDict(DbValues cond) {
        for (int i = 0; i < cond.Count(); i = i + 1) {
            this.qb.WhereValueAt(cond, i);
        }
        return this;
    }

    // column IN (整型列表)，逐个占位符；空列表按恒假处理。
    DbTableQuery WhereIn(string column, List<int> values) {
        this.qb.WhereInInts(column, values);
        return this;
    }

    // column IN (64 位整数列表)，逐个占位符；空列表按恒假处理。
    DbTableQuery WhereIn(string column, List<long> values) {
        this.qb.WhereInLongs(column, values);
        return this;
    }

    // 升序排序。
    DbTableQuery OrderBy(string column) {
        this.qb.OrderBy(column);
        return this;
    }

    // 降序排序。
    DbTableQuery OrderByDesc(string column) {
        this.qb.OrderByDesc(column);
        return this;
    }

    // 白名单版排序（升序）：allowed 之外的列一律抛异常。
    // 排序列无法参数化，可能来自用户输入（?sort=）时必须持单。
    DbTableQuery OrderBySafe(string column, List<string> allowed) {
        this.qb.OrderBySafe(column, allowed);
        return this;
    }

    // 白名单版排序（降序）。
    DbTableQuery OrderBySafeDesc(string column, List<string> allowed) {
        this.qb.OrderBySafeDesc(column, allowed);
        return this;
    }

    // 最多读多少行。
    DbTableQuery Limit(int count) {
        this.limitVal = count;
        return this;
    }

    // 跳过多少行。
    DbTableQuery Offset(int count) {
        this.offsetVal = count;
        return this;
    }

    // 一页：take 行，跳过 skip 行。
    DbTableQuery Page(int take, int skip) {
        return this.Limit(take).Offset(skip);
    }

    // 符合条件的行数（分页不参与计数）。
    async long CountAsync() {
        string text = await this.conn.ExecuteScalarAsync(
            this.qb.BuildSelectParams("COUNT(*)"), this.qb.SelectParams());
        if (text == null || text.Length == 0) { return 0; }
        return Convert.ToInt64(text);
    }

    // 读取全部列。
    async DbResult ToResultAsync() {
        return await this.run("*");
    }

    // 只读取列出的列（每个列名都会校验）。
    async DbResult ToResultAsync(List<string> columns) {
        if (columns == null || columns.Count == 0) { return await this.run("*"); }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < columns.Count; i = i + 1) {
            if (i > 0) { sb.Append(", "); }
            sb.Append(QueryBuilder.RequireIdent(columns[i]));
        }
        return await this.run(sb.ToString());
    }

    // 删除符合条件的行，返回删除行数。
    async int ExecuteDeleteAsync() {
        return await this.conn.ExecuteAsync(this.qb.BuildDeleteParams(),
                                           this.qb.SelectParams());
    }

    // 按 DbValues 更新符合条件的行，返回更新行数。SET 值排在
    // WHERE 值之前，与 BuildUpdateParams 的占位符顺序一致。
    async int ExecuteUpdateAsync(DbValues row) {
        if (row.Count() == 0) { throw new Exception("update without columns"); }
        DbParams ps = new DbParams();
        for (int i = 0; i < row.Count(); i = i + 1) {
            this.qb.SetParam(row.NameAt(i));
            row.BindTo(ps, i);
        }
        return await this.conn.ExecuteAsync(this.qb.BuildUpdateParams(),
                                            OrmDialect.Cat(ps, this.qb.SelectParams()));
    }

    // 执行 SELECT：套用已设置的 Limit/Offset 后按给定列清单查询。
    async DbResult run(string columns) {
        if (this.limitVal >= 0) { this.qb.Limit(this.limitVal); }
        if (this.offsetVal >= 0) { this.qb.Offset(this.offsetVal); }
        return await this.conn.QueryAsync(this.qb.BuildSelectParams(columns),
                                         this.qb.SelectParams());
    }
}
