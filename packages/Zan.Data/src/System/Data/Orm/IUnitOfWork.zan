using System;
using System.Data;
namespace System.Data.Orm;

public interface IUnitOfWork : IDbExecutor, IDisposable, ISavepointScope {
    // 获取工作单元持有的底层连接。
    IDbConnection GetConnection();
    // 提交事务。
    void Commit();
    // 回滚事务。
    void Rollback();
    // 异步提交事务。
    async bool CommitAsync();
    // 异步回滚事务。
    async bool RollbackAsync();
    // 释放连接并回滚未提交的事务。
    void Dispose();
}

// 工作单元默认实现。
