using System;
using System.Data;
namespace System.Data.Orm;

public delegate IZanSql ZanSqlProvider();
public delegate void TransactionAction();

public class ZanSql : IZanSql {
    public static IZanSql DefaultInstance;
    public static ZanSqlProvider CurrentProvider;

    // 核心环境门面：优先取动态上下文解析器，其次回退到全局默认连接池门面
    public static IZanSql Current {
        get {
            if (CurrentProvider != null) {
                IZanSql s = CurrentProvider();
                if (s != null) { return s; }
            }
            return DefaultInstance;
        }
        set {
            DefaultInstance = value;
        }
    }

    public static void SetDefault(IZanSql orm) {
        DefaultInstance = orm;
    }

    public static void SetProvider(ZanSqlProvider provider) {
        CurrentProvider = provider;
    }

    // 自动事务闭包：内部自动创建 UnitOfWork 并在当前上下文中隔离执行
    public static void Transaction(TransactionAction action) {
        IZanSql currentOrm = ZanSql.Current;
        if (currentOrm == null) {
            throw new Exception("ZanSql.Transaction: no active database connection or pool in current context");
        }
        IUnitOfWork uow = currentOrm.CreateUnitOfWork();
        IZanSql previous = DefaultInstance;
        IZanSql uowOrm = ZanSql.FromConnection(uow.GetConnection());
        try {
            DefaultInstance = uowOrm;
            action();
            uow.Commit();
        } catch (Exception ex) {
            uow.Rollback();
            throw ex;
        } finally {
            DefaultInstance = previous;
            uow.Dispose();
        }
    }

    public IDbConnection conn;
    public DbPool pool;
    public AopProvider aop;

    public ZanSql(IDbConnection conn) {
        this.conn = conn;
        this.pool = null;
        this.aop = new AopProvider();
    }

    public ZanSql(DbPool pool) {
        this.conn = null;
        this.pool = pool;
        this.aop = new AopProvider();
    }

    public static IZanSql FromConnection(IDbConnection conn) {
        return new ZanSql(conn);
    }

    public static IZanSql FromPool(DbPool pool) {
        return new ZanSql(pool);
    }

    public ICodeFirst CodeFirst() { return new CodeFirst(this); }
    public IAop Aop() { return this.aop; }

    // 属性风格访问 CodeFirst。
    public CodeFirst CodeFirstProperty { get { return new CodeFirst(this); } }

    // 创建独立的工作单元与事务。
    public IUnitOfWork CreateUnitOfWork() {
        if (this.pool != null) {
            IDbConnection c = this.pool.TryAcquire();
            if (c == null) {
                throw new Exception("ZanSql.CreateUnitOfWork: no idle connection in pool");
            }
            try {
                return UnitOfWork.Create(c, this.pool, false);
            } catch (Exception ex) {
                this.pool.Release(c);
                throw ex;
            }
        }
        return UnitOfWork.Create(this.conn, false);
    }

    // 异步创建独立的工作单元与事务。
    public async IUnitOfWork CreateUnitOfWorkAsync() {
        if (this.pool != null) {
            IDbConnection c = await this.pool.AcquireAsync();
            if (c == null) {
                throw new Exception("ZanSql.CreateUnitOfWorkAsync: failed to acquire connection from pool");
            }
            try {
                return await UnitOfWork.CreateAsync(c, this.pool, false);
            } catch (Exception ex) {
                this.pool.Release(c);
                throw ex;
            }
        }
        return await UnitOfWork.CreateAsync(this.conn, false);
    }

    public IDbConnection OpenConnection() {
        if (this.conn != null) { return this.conn; }
        if (this.pool != null) { return this.pool.TryAcquire(); }
        return null;
    }

    // 供实体访问器与控制器重写的桥接方法。
    public IDbConnection __Conn() {
        return this.OpenConnection();
    }

    public int GetProvider() {
        if (this.conn != null) { return this.conn.GetProvider(); }
        if (this.pool != null) { return this.pool.GetProvider(); }
        return 0;
    }

    public DbResult Query(string sql, DbParams prms) {
        DbParams ps = prms != null ? prms : new DbParams();
        if (this.conn != null) { return this.conn.Query(sql, ps); }
        if (this.pool != null) {
            IDbConnection c = this.pool.TryAcquire();
            if (c == null) { throw new Exception("ZanSql: db pool exhausted"); }
            try {
                return c.Query(sql, ps);
            } finally {
                this.pool.Release(c);
            }
        }
        throw new Exception("ZanSql: no connection or pool configured");
    }

    public int Execute(string sql, DbParams prms) {
        DbParams ps = prms != null ? prms : new DbParams();
        if (this.conn != null) { return this.conn.Execute(sql, ps); }
        if (this.pool != null) {
            IDbConnection c = this.pool.TryAcquire();
            if (c == null) { throw new Exception("ZanSql: db pool exhausted"); }
            try {
                return c.Execute(sql, ps);
            } finally {
                this.pool.Release(c);
            }
        }
        throw new Exception("ZanSql: no connection or pool configured");
    }

    public DbResult Query(string sql) {
        if (this.conn != null) { return this.conn.Query(sql); }
        if (this.pool != null) {
            IDbConnection c = this.pool.TryAcquire();
            if (c == null) { throw new Exception("ZanSql: db pool exhausted"); }
            try {
                return c.Query(sql);
            } finally {
                this.pool.Release(c);
            }
        }
        throw new Exception("ZanSql: no connection or pool configured");
    }

    public int Execute(string sql) {
        if (this.conn != null) { return this.conn.Execute(sql); }
        if (this.pool != null) {
            IDbConnection c = this.pool.TryAcquire();
            if (c == null) { throw new Exception("ZanSql: db pool exhausted"); }
            try {
                return c.Execute(sql);
            } finally {
                this.pool.Release(c);
            }
        }
        throw new Exception("ZanSql: no connection or pool configured");
    }

    public string ExecuteScalar(string sql) {
        if (this.conn != null) { return this.conn.ExecuteScalar(sql); }
        if (this.pool != null) {
            IDbConnection c = this.pool.TryAcquire();
            if (c == null) { throw new Exception("ZanSql: db pool exhausted"); }
            try {
                return c.ExecuteScalar(sql);
            } finally {
                this.pool.Release(c);
            }
        }
        throw new Exception("ZanSql: no connection or pool configured");
    }

    public string ExecuteScalar(string sql, DbParams prms) {
        DbParams ps = prms != null ? prms : new DbParams();
        if (this.conn != null) { return this.conn.ExecuteScalar(sql, ps); }
        if (this.pool != null) {
            IDbConnection c = this.pool.TryAcquire();
            if (c == null) { throw new Exception("ZanSql: db pool exhausted"); }
            try {
                return c.ExecuteScalar(sql, ps);
            } finally {
                this.pool.Release(c);
            }
        }
        throw new Exception("ZanSql: no connection or pool configured");
    }

    public async DbResult QueryAsync(string sql, DbParams prms) {
        DbParams ps = prms != null ? prms : new DbParams();
        if (this.conn != null) { return await this.conn.QueryAsync(sql, ps); }
        if (this.pool != null) {
            IDbConnection c = await this.pool.AcquireAsync();
            if (c == null) { throw new Exception("ZanSql: db pool exhausted"); }
            try {
                return await c.QueryAsync(sql, ps);
            } finally {
                this.pool.Release(c);
            }
        }
        throw new Exception("ZanSql: no connection or pool configured");
    }

    public async int ExecuteAsync(string sql, DbParams prms) {
        DbParams ps = prms != null ? prms : new DbParams();
        if (this.conn != null) { return await this.conn.ExecuteAsync(sql, ps); }
        if (this.pool != null) {
            IDbConnection c = await this.pool.AcquireAsync();
            if (c == null) { throw new Exception("ZanSql: db pool exhausted"); }
            try {
                return await c.ExecuteAsync(sql, ps);
            } finally {
                this.pool.Release(c);
            }
        }
        throw new Exception("ZanSql: no connection or pool configured");
    }

    public async DbResult QueryAsync(string sql) {
        if (this.conn != null) { return await this.conn.QueryAsync(sql); }
        if (this.pool != null) {
            IDbConnection c = await this.pool.AcquireAsync();
            if (c == null) { throw new Exception("ZanSql: db pool exhausted"); }
            try {
                return await c.QueryAsync(sql);
            } finally {
                this.pool.Release(c);
            }
        }
        throw new Exception("ZanSql: no connection or pool configured");
    }

    public async int ExecuteAsync(string sql) {
        if (this.conn != null) { return await this.conn.ExecuteAsync(sql); }
        if (this.pool != null) {
            IDbConnection c = await this.pool.AcquireAsync();
            if (c == null) { throw new Exception("ZanSql: db pool exhausted"); }
            try {
                return await c.ExecuteAsync(sql);
            } finally {
                this.pool.Release(c);
            }
        }
        throw new Exception("ZanSql: no connection or pool configured");
    }

    public async string ExecuteScalarAsync(string sql) {
        if (this.conn != null) { return await this.conn.ExecuteScalarAsync(sql); }
        if (this.pool != null) {
            IDbConnection c = await this.pool.AcquireAsync();
            if (c == null) { throw new Exception("ZanSql: db pool exhausted"); }
            try {
                return await c.ExecuteScalarAsync(sql);
            } finally {
                this.pool.Release(c);
            }
        }
        throw new Exception("ZanSql: no connection or pool configured");
    }

    public async string ExecuteScalarAsync(string sql, DbParams prms) {
        DbParams ps = prms != null ? prms : new DbParams();
        if (this.conn != null) { return await this.conn.ExecuteScalarAsync(sql, ps); }
        if (this.pool != null) {
            IDbConnection c = await this.pool.AcquireAsync();
            if (c == null) { throw new Exception("ZanSql: db pool exhausted"); }
            try {
                return await c.ExecuteScalarAsync(sql, ps);
            } finally {
                this.pool.Release(c);
            }
        }
        throw new Exception("ZanSql: no connection or pool configured");
    }

    void Dispose() {
        if (this.conn != null) {
            this.conn.Dispose();
            this.conn = null;
        }
        if (this.pool != null) {
            this.pool.Close();
            this.pool = null;
        }
    }
}
