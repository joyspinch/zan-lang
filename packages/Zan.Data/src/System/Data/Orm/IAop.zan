using System;
using System.Data;

namespace System.Data.Orm;

// 审计事件参数，供 AOP 拦截实体插入与更新。
class AuditValueEventArgs {
    string table;
    string column;
    object val;
    bool isInsert;

    AuditValueEventArgs(string table, string column, object val, bool isInsert) {
        this.table = table;
        this.column = column;
        this.val = val;
        this.isInsert = isInsert;
    }

    string Table { get { return this.table; } }
    string Column { get { return this.column; } }
    object Value { get { return this.val; } set { this.val = value; } }
    bool IsInsert { get { return this.isInsert; } }
}

// FreeSql AOP 扩展点接口。
interface IAop {
    // 设置全局审计值拦截处理器。
    void SetAuditValueHandler(Action<AuditValueEventArgs> handler);
    // 分发审计拦截。
    void Audit(AuditValueEventArgs e);
}

// AOP 审计与拦截提供者。
class AopProvider : IAop {
    Action<AuditValueEventArgs> handler;

    AopProvider() {
        this.handler = null;
    }

    void SetAuditValueHandler(Action<AuditValueEventArgs> handler) {
        this.handler = handler;
    }

    void Audit(AuditValueEventArgs e) {
        if (this.handler != null && e != null) {
            this.handler(e);
        }
    }
}
