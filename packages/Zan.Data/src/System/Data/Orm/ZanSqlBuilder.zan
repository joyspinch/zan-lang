using System;
using System.Data;
using System.Data.Sqlite;

namespace System.Data.Orm;

// ZanSql 构建器：流式配置并创建 IZanSql 实例。
// 示例：
// .UseConnection(db)
// .Build();
class ZanSqlBuilder {
    IDbConnection conn;
    DbPool pool;
    int provider;
    string connectionString;
    bool autoSyncStructure;

    ZanSqlBuilder() {
        this.conn = null;
        this.pool = null;
        this.provider = 0;
        this.connectionString = "";
        this.autoSyncStructure = false;
    }

    ZanSqlBuilder UseConnection(IDbConnection conn) {
        this.conn = conn;
        return this;
    }

    ZanSqlBuilder UsePool(DbPool pool) {
        this.pool = pool;
        return this;
    }

    ZanSqlBuilder UseConnectionString(int provider, string connectionString) {
        this.provider = provider;
        this.connectionString = connectionString;
        return this;
    }

    ZanSqlBuilder UseAutoSyncStructure(bool autoSync) {
        this.autoSyncStructure = autoSync;
        return this;
    }

    IZanSql Build() {
        if (this.conn != null) {
            return new ZanSql(this.conn);
        }
        if (this.pool != null) {
            return new ZanSql(this.pool);
        }
        if (this.provider == DbProvider.SQLite && this.connectionString.Length > 0) {
            SqliteConnection c = SqliteConnection.Open(this.connectionString);
            return new ZanSql(c);
        }
        throw new Exception("ZanSqlBuilder: no valid connection or pool configured");
    }
}
