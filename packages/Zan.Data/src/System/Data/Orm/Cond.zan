using System;

namespace System.Data.Orm;

// 一条声明式查询条件：声明式列表页（ListPage.Collect 一类）
// 的产出，经 <see cref="Select.WhereConds"/> 变成参数化 WHERE。
// col/kind/value 都是声明侧给定的自由文本，但各自的出口都被 ORM 收口：
// col 在 <see cref="Select"/> 里按实体元数据校验（未知列抛异常），
// kind 只认 LIKE/EQ/GE/LE，value 永远走绑定参数——用户输入进不了
// SQL 文本。name 是来源参数名（回填分页链接用，可空）。
public class Cond {
    public string name;
    public string col;
    public string kind;
    public string value;

    public Cond() {
        this.name = "";
        this.col = "";
        this.kind = "";
        this.value = "";
    }

    public Cond(string name, string col, string kind, string value) {
        this.name = name;
        this.col = col;
        this.kind = kind;
        this.value = value;
    }

    // 宽松数字解析：可选正负号 + 纯数字，其余形态一律 0
    // （与 Web 层 Filter.ToInt 的容错一致）。EQ/GE/LE 的 value 在
    // WhereConds 里经它落到整型绑定。
    public static long Num(string s) {
        string t = s == null ? "" : s.Trim();
        int i = 0;
        bool neg = false;
        if (i < t.Length) {
            int c = t[i] & 255;
            if (c == 45 || c == 43) {
                neg = c == 45;
                i = i + 1;
            }
        }
        long v = 0;
        bool any = false;
        while (i < t.Length) {
            int c = t[i] & 255;
            if (c < 48 || c > 57) { return 0; }
            v = v * 10 + (c - 48);
            any = true;
            i = i + 1;
        }
        if (!any) { return 0; }
        return neg ? 0 - v : v;
    }
}

// 兼容别名
public class OrmCond : Cond {
    public OrmCond() : base() {}
    public OrmCond(string name, string col, string kind, string value) : base(name, col, kind, value) {}
}
