using System;
using System.Data;
using System.Data.Orm;
using System.Text;
namespace System.Data.Orm;

class DbSchema {
    // 表的列名，顺序同表定义；表不存在时是空列表。
    static async List<string> ColumnsAsync(IDbExecutor db, string table) {
        List<string> cols = new List<string>();
        string t = QueryBuilder.RequireIdent(table);
        int p = db.GetProvider();
        DbResult r;
        int nameCol = 0;
        if (p == DbProvider.SQLite) {
            r = await db.QueryAsync("PRAGMA table_info(" + t + ")");
            nameCol = 1;
        } else {
            r = await db.QueryAsync(
                "SELECT column_name FROM information_schema.columns "
                + "WHERE table_name = ?", new DbParams().Add(t));
        }
        for (int i = 0; i < r.RowCount(); i = i + 1) {
            cols.Add(r.GetString(i, nameCol));
        }
        return cols;
    }

    // 该表是否有这一列。
    static async bool HasColumnAsync(IDbExecutor db, string table,
                                     string column) {
        List<string> cols = await DbSchema.ColumnsAsync(db, table);
        for (int i = 0; i < cols.Count; i = i + 1) {
            if (cols[i] == column) { return true; }
        }
        return false;
    }

    // 该表是否有其中任意一列。一个换过形状的旧表就是这么认出
    // 来的：它带着新实体里已经没有的列。
    static async bool HasAnyColumnAsync(IDbExecutor db, string table,
                                        List<string> columns) {
        List<string> cols = await DbSchema.ColumnsAsync(db, table);
        for (int i = 0; i < cols.Count; i = i + 1) {
            for (int k = 0; k < columns.Count; k = k + 1) {
                if (cols[i] == columns[k]) { return true; }
            }
        }
        return false;
    }

    // 表是否存在。
    static async bool TableExistsAsync(IDbExecutor db, string table) {
        int p = db.GetProvider();
        string sql = "SELECT COUNT(*) FROM information_schema.tables "
            + "WHERE table_name = ?";
        if (p == DbProvider.SQLite) {
            sql = "SELECT COUNT(*) FROM sqlite_master "
                + "WHERE type = 'table' AND name = ?";
        }
        DbResult r = await db.QueryAsync(sql, new DbParams().Add(table));
        if (r.RowCount() == 0) { return false; }
        return r.GetInt(0, 0) > 0;
    }

    // 逻辑类型在该 provider 上的物理类型。
    static string SqlType(string kind, int size, int provider) {
        bool sqlite = provider == DbProvider.SQLite;
        if (kind == "int" || kind == "bool") {
            if (sqlite) { return "INTEGER"; }
            return "INT";
        }
        if (kind == "long" || kind == "datetime") {
            if (sqlite) { return "INTEGER"; }
            return "BIGINT";
        }
        if (kind == "decimal" || kind == "double") {
            if (sqlite) { return "REAL"; }
            return "DECIMAL(18,4)";
        }
        if (kind == "text") { return "TEXT"; }
        int n = size;
        if (n <= 0) { n = 255; }
        if (sqlite) { return "TEXT"; }
        return "VARCHAR(" + Convert.ToString(n) + ")";
    }

    // 默认值的字面量，无法安全内联时是空串。
    static string DefaultLiteral(DbColumnDef c) {
        string v = c.defText;
        if (v.Length == 0) { return ""; }
        if (c.kind == "int" || c.kind == "long" || c.kind == "bool"
            || c.kind == "decimal" || c.kind == "double"
            || c.kind == "datetime") {
            for (int i = 0; i < v.Length; i = i + 1) {
                int ch = v[i] & 255;
                bool digit = ch >= 48 && ch <= 57;
                if (!digit && ch != 45 && ch != 46) { return ""; }
            }
            return v;
        }
        return "'" + QueryBuilder.EscapeDdlLiteral(v) + "'";
    }

    // 一列的 DDL 片段。
    static string ColumnSql(DbColumnDef c, int provider) {
        if (c.identity) {
            if (provider == DbProvider.SQLite) {
                return c.name + " INTEGER PRIMARY KEY AUTOINCREMENT";
            }
            if (provider == DbProvider.PostgreSQL
                || provider == DbProvider.Kingbase
                || provider == DbProvider.OpenGauss) {
                return c.name + " SERIAL PRIMARY KEY";
            }
            return c.name + " INT NOT NULL AUTO_INCREMENT PRIMARY KEY";
        }
        string sql = c.name + " " + DbSchema.SqlType(c.kind, c.size, provider);
        if (!c.nullable) { sql = sql + " NOT NULL"; }
        string lit = DbSchema.DefaultLiteral(c);
        if (lit.Length > 0) { sql = sql + " DEFAULT " + lit; }
        return sql;
    }

    // 建表语句（列顺序即给定顺序；表已存在时不报错）。
    static string CreateTableSql(string table, List<DbColumnDef> cols,
                                 int provider) {
        string t = QueryBuilder.RequireIdent(table);
        StringBuilder b = new StringBuilder();
        b.Append("CREATE TABLE IF NOT EXISTS ");
        b.Append(t);
        b.Append(" (");
        for (int i = 0; i < cols.Count; i = i + 1) {
            if (i > 0) { b.Append(", "); }
            b.Append(DbSchema.ColumnSql(cols[i], provider));
        }
        b.Append(")");
        return b.ToString();
    }

    // 按逻辑列定义建表。形状在运行期才知道的表（表设计器、
    // 数据字典）走这里，业务代码不必拼 DDL，也不必分方言。
    static async void CreateTableAsync(IDbExecutor db, string table,
                                       List<DbColumnDef> cols) {
        if (cols.Count == 0) { throw new Exception("create table without columns"); }
        int _n = await db.ExecuteAsync(
            DbSchema.CreateTableSql(table, cols, db.GetProvider()));
    }

    // 给已有表加一列（不改类型、不删列 —— 那会丢数据）。
    static async void AddColumnAsync(IDbExecutor db, string table,
                                     DbColumnDef col) {
        string t = QueryBuilder.RequireIdent(table);
        int _n = await db.ExecuteAsync("ALTER TABLE " + t + " ADD COLUMN "
            + DbSchema.ColumnSql(col, db.GetProvider()));
    }

    // 把设计里有、表里没有的列补上，返回补了几列；表还不
    // 存在时先建表，返回列数。列永不删除、永不改类型。
    static async int MigrateAsync(IDbExecutor db, string table,
                                  List<DbColumnDef> cols) {
        List<string> have = await DbSchema.ColumnsAsync(db, table);
        if (have.Count == 0) {
            await DbSchema.CreateTableAsync(db, table, cols);
            return cols.Count;
        }
        int added = 0;
        for (int i = 0; i < cols.Count; i = i + 1) {
            DbColumnDef c = cols[i];
            bool found = false;
            for (int j = 0; j < have.Count; j = j + 1) {
                if (have[j] == c.name) { found = true; }
            }
            if (found) { continue; }
            await DbSchema.AddColumnAsync(db, table, c);
            added = added + 1;
        }
        return added;
    }

    // 把一张表改名（目标名已被占用时先丢掉目标）。
    static async void RenameTableAsync(IDbExecutor db, string from,
                                       string to) {
        string a = QueryBuilder.RequireIdent(from);
        string b = QueryBuilder.RequireIdent(to);
        await DbSchema.DropTableAsync(db, b);
        int _n = await db.ExecuteAsync("ALTER TABLE " + a + " RENAME TO " + b);
    }

    // 丢掉一张表（不存在也不报错）。
    static async void DropTableAsync(IDbExecutor db, string table) {
        string t = QueryBuilder.RequireIdent(table);
        int _n = await db.ExecuteAsync("DROP TABLE IF EXISTS " + t);
    }

    // SQLite 的写前日志：写的人不再挡住读的人。别的 provider
    // 上是空操作 —— 日志形态是它们自己的服务端配置，不是连接属性。
    static async void UseWriteAheadLogAsync(IDbExecutor db) {
        Console.WriteLine("[probe] wal-enter provider=" + Convert.ToString((int)db.GetProvider()));
        if (db.GetProvider() != DbProvider.SQLite) { Console.WriteLine("[probe] wal-early-return"); return; }
        Console.WriteLine("[probe] wal-go");
        // journal_mode / synchronous 都是「赋值并回显新值」的 PRAGMA：
        // 各回一行结果。ExecuteAsync 对返回行的语句会抛
        // "the statement returned rows"，必须用 QueryAsync 读掉。
        DbResult _j = await db.QueryAsync("PRAGMA journal_mode=WAL");
        Console.WriteLine("[probe] wal-1");
        DbResult _s = await db.QueryAsync("PRAGMA synchronous=NORMAL");
        Console.WriteLine("[probe] wal-2");
    }
}
