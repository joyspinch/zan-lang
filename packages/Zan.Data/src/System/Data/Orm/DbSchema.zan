using System;
using System.Data;
using System.Data.Orm;
using System.Text;
namespace System.Data.Orm;

public class DbSchema {
    // 按方言引用已校验标识符，防止关键字列名/表名导致语法错误。
    public static string QuoteIdent(string ident, int provider) {
        string safe = QueryBuilder.RequireIdent(ident);
        if (provider == DbProvider.MySQL || provider == DbProvider.MariaDB) {
            return "`" + safe + "`";
        }
        if (provider == DbProvider.SqlServer) {
            return "[" + safe + "]";
        }
        return "\"" + safe + "\"";
    }

    // 表的列名，顺序同表定义；表不存在时是空列表。
    public static async List<string> ColumnsAsync(IDbExecutor db, string table) {
        List<string> cols = new List<string>();
        string t = QueryBuilder.RequireIdent(table);
        int p = db.GetProvider();
        DbResult r;
        int nameCol = 0;
        if (p == DbProvider.SQLite) {
            r = await db.QueryAsync("PRAGMA table_info(\"" + t + "\")");
            nameCol = 1;
        } else if (p == DbProvider.MySQL || p == DbProvider.MariaDB) {
            r = await db.QueryAsync(
                "SELECT column_name FROM information_schema.columns "
                + "WHERE table_schema = DATABASE() AND table_name = ? "
                + "ORDER BY ordinal_position", new DbParams().Add(t));
        } else if (p == DbProvider.PostgreSQL || p == DbProvider.Kingbase
            || p == DbProvider.OpenGauss) {
            r = await db.QueryAsync(
                "SELECT column_name FROM information_schema.columns "
                + "WHERE table_schema = CURRENT_SCHEMA() AND table_name = ? "
                + "ORDER BY ordinal_position", new DbParams().Add(t));
        } else if (p == DbProvider.SqlServer) {
            r = await db.QueryAsync(
                "SELECT column_name FROM information_schema.columns "
                + "WHERE table_schema = SCHEMA_NAME() AND table_name = ? "
                + "ORDER BY ordinal_position", new DbParams().Add(t));
        } else {
            r = await db.QueryAsync(
                "SELECT column_name FROM information_schema.columns "
                + "WHERE table_name = ?", new DbParams().Add(t));
        }
        for (int i = 0; i < r.RowCount(); i = i + 1) {
            cols.Add(r.GetString(i, nameCol));
        }
        return cols;
    }

    // 该表是否有这一列。
    public static async bool HasColumnAsync(IDbExecutor db, string table,
                                     string column) {
        List<string> cols = await DbSchema.ColumnsAsync(db, table);
        for (int i = 0; i < cols.Count; i = i + 1) {
            if (cols[i] == column) { return true; }
        }
        return false;
    }

    // 该表是否有其中任意一列。一个换过形状的旧表就是这么认出
    // 来的：它带着新实体里已经没有的列。
    public static async bool HasAnyColumnAsync(IDbExecutor db, string table,
                                        List<string> columns) {
        List<string> cols = await DbSchema.ColumnsAsync(db, table);
        for (int i = 0; i < cols.Count; i = i + 1) {
            for (int k = 0; k < columns.Count; k = k + 1) {
                if (cols[i] == columns[k]) { return true; }
            }
        }
        return false;
    }

    // 表是否存在。
    public static async bool TableExistsAsync(IDbExecutor db, string table) {
        int p = db.GetProvider();
        string sql = "SELECT COUNT(*) FROM information_schema.tables "
            + "WHERE table_name = ?";
        if (p == DbProvider.SQLite) {
            sql = "SELECT COUNT(*) FROM sqlite_master "
                + "WHERE type = 'table' AND name = ?";
        } else if (p == DbProvider.MySQL || p == DbProvider.MariaDB) {
            sql = "SELECT COUNT(*) FROM information_schema.tables "
                + "WHERE table_schema = DATABASE() AND table_name = ?";
        } else if (p == DbProvider.PostgreSQL || p == DbProvider.Kingbase
            || p == DbProvider.OpenGauss) {
            sql = "SELECT COUNT(*) FROM information_schema.tables "
                + "WHERE table_schema = CURRENT_SCHEMA() AND table_name = ?";
        } else if (p == DbProvider.SqlServer) {
            sql = "SELECT COUNT(*) FROM information_schema.tables "
                + "WHERE table_schema = SCHEMA_NAME() AND table_name = ?";
        }
        DbResult r = await db.QueryAsync(sql, new DbParams().Add(table));
        if (r.RowCount() == 0) { return false; }
        return r.GetInt(0, 0) > 0;
    }

    // 逻辑类型在该 provider 上的物理类型。
    public static string SqlType(string kind, int size, int provider) {
        bool sqlite = provider == DbProvider.SQLite;
        if (kind == "int" || kind == "bool") {
            if (sqlite) { return "INTEGER"; }
            return "INT";
        }
        if (kind == "long" || kind == "datetime") {
            if (sqlite) { return "INTEGER"; }
            return "BIGINT";
        }
        if (kind == "decimal" || kind == "double") {
            if (sqlite) { return "REAL"; }
            return "DECIMAL(18,4)";
        }
        if (kind == "text") { return "TEXT"; }
        int n = size;
        if (n <= 0) { n = 255; }
        if (sqlite) { return "TEXT"; }
        return "VARCHAR(" + Convert.ToString(n) + ")";
    }

    // 严格校验数值字面量：可选单个前导 '-'、至少一位整数数字、至多一个小数点且其后至少一位数字。
    private static bool IsValidNumericLiteral(string v) {
        if (v == null || v.Length == 0) { return false; }
        int i = 0;
        if ((v[0] & 255) == 45) { i = 1; }
        if (i >= v.Length) { return false; }
        int intDigits = 0;
        while (i < v.Length) {
            int ch = v[i] & 255;
            if (ch >= 48 && ch <= 57) {
                intDigits = intDigits + 1;
                i = i + 1;
            } else {
                break;
            }
        }
        if (intDigits == 0) { return false; }
        if (i == v.Length) { return true; }
        if ((v[i] & 255) != 46) { return false; }
        i = i + 1;
        int fracDigits = 0;
        while (i < v.Length) {
            int ch = v[i] & 255;
            if (ch >= 48 && ch <= 57) {
                fracDigits = fracDigits + 1;
                i = i + 1;
            } else {
                return false;
            }
        }
        return fracDigits > 0;
    }

    // 默认值的字面量，无法安全内联时是空串。
    public static string DefaultLiteral(DbColumnDef c) {
        return DbSchema.DefaultLiteral(c, 0);
    }

    public static string DefaultLiteral(DbColumnDef c, int provider) {
        string v = c.defText;
        if (v == null || v.Length == 0) { return ""; }
        if (c.kind == "int" || c.kind == "long" || c.kind == "bool"
            || c.kind == "decimal" || c.kind == "double"
            || c.kind == "datetime") {
            if (!DbSchema.IsValidNumericLiteral(v)) { return ""; }
            return v;
        }
        return "'" + QueryBuilder.EscapeDdlLiteral(v, provider) + "'";
    }

    // 一列的 DDL 片段。
    public static string ColumnSql(DbColumnDef c, int provider) {
        string colName = DbSchema.QuoteIdent(c.name, provider);
        if (c.identity) {
            if (provider == DbProvider.SQLite) {
                return colName + " INTEGER PRIMARY KEY AUTOINCREMENT";
            }
            if (provider == DbProvider.PostgreSQL
                || provider == DbProvider.Kingbase
                || provider == DbProvider.OpenGauss) {
                return colName + " SERIAL PRIMARY KEY";
            }
            return colName + " INT NOT NULL AUTO_INCREMENT PRIMARY KEY";
        }
        string sql = colName + " " + DbSchema.SqlType(c.kind, c.size, provider);
        if (!c.nullable) { sql = sql + " NOT NULL"; }
        string lit = DbSchema.DefaultLiteral(c, provider);
        if (lit.Length > 0) { sql = sql + " DEFAULT " + lit; }
        return sql;
    }

    // 建表语句（列顺序即给定顺序；表已存在时不报错）。
    public static string CreateTableSql(string table, List<DbColumnDef> cols,
                                 int provider) {
        string t = DbSchema.QuoteIdent(table, provider);
        StringBuilder b = new StringBuilder();
        b.Append("CREATE TABLE IF NOT EXISTS ");
        b.Append(t);
        b.Append(" (");
        for (int i = 0; i < cols.Count; i = i + 1) {
            if (i > 0) { b.Append(", "); }
            b.Append(DbSchema.ColumnSql(cols[i], provider));
        }
        b.Append(")");
        return b.ToString();
    }

    // 按逻辑列定义建表。形状在运行期才知道的表（表设计器、
    // 数据字典）走这里，业务代码不必拼 DDL，也不必分方言。
    public static async void CreateTableAsync(IDbExecutor db, string table,
                                       List<DbColumnDef> cols) {
        if (cols.Count == 0) { throw new Exception("create table without columns"); }
        int _n = await db.ExecuteAsync(
            DbSchema.CreateTableSql(table, cols, db.GetProvider()));
    }

    // 给已有表加一列（不改类型、不删列 —— 那会丢数据）。
    public static async void AddColumnAsync(IDbExecutor db, string table,
                                     DbColumnDef col) {
        int p = db.GetProvider();
        string t = DbSchema.QuoteIdent(table, p);
        int _n = await db.ExecuteAsync("ALTER TABLE " + t + " ADD COLUMN "
            + DbSchema.ColumnSql(col, p));
    }

    // 把设计里有、表里没有的列补上，返回补了几列；表还不
    // 存在时先建表，返回列数。列永不删除、永不改类型。
    public static async int MigrateAsync(IDbExecutor db, string table,
                                  List<DbColumnDef> cols) {
        List<string> have = await DbSchema.ColumnsAsync(db, table);
        if (have.Count == 0) {
            await DbSchema.CreateTableAsync(db, table, cols);
            return cols.Count;
        }
        int added = 0;
        for (int i = 0; i < cols.Count; i = i + 1) {
            DbColumnDef c = cols[i];
            bool found = false;
            for (int j = 0; j < have.Count; j = j + 1) {
                if (have[j] == c.name) { found = true; }
            }
            if (found) { continue; }
            await DbSchema.AddColumnAsync(db, table, c);
            added = added + 1;
        }
        return added;
    }

    // 把一张表改名（目标名已被占用时先丢掉目标）。
    public static async void RenameTableAsync(IDbExecutor db, string from,
                                       string to) {
        int p = db.GetProvider();
        string a = DbSchema.QuoteIdent(from, p);
        string b = DbSchema.QuoteIdent(to, p);
        await DbSchema.DropTableAsync(db, to);
        int _n = await db.ExecuteAsync("ALTER TABLE " + a + " RENAME TO " + b);
    }

    // 丢掉一张表（不存在也不报错）。
    public static async void DropTableAsync(IDbExecutor db, string table) {
        int p = db.GetProvider();
        string t = DbSchema.QuoteIdent(table, p);
        int _n = await db.ExecuteAsync("DROP TABLE IF EXISTS " + t);
    }

    // SQLite 的写前日志：写的人不再挡住读的人。别的 provider
    // 上是空操作 —— 日志形态是它们自己的服务端配置，不是连接属性。
    public static async void UseWriteAheadLogAsync(IDbExecutor db) {
        if (db.GetProvider() != DbProvider.SQLite) { return; }
        // journal_mode / synchronous 都是「赋值并回显新值」的 PRAGMA：
        // 各回一行结果。ExecuteAsync 对返回行的语句会抛
        // "the statement returned rows"，必须用 QueryAsync 读掉。
        DbResult _j = await db.QueryAsync("PRAGMA journal_mode=WAL");
        DbResult _s = await db.QueryAsync("PRAGMA synchronous=NORMAL");
    }
}
