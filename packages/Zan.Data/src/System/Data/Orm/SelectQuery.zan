using System;
using System.Collections.Generic;
using System.Data;
using System.Linq;
using System.Threading;

namespace System.Data.Orm;

// 为实体字段提供流式断言扩展方法，确保在 IDE 中编码与自动补全（IntelliSense）时能流畅提示。
public static class FieldExtensions {
    public static bool Eq<T>(this T field, T val) { return field == val; }
    public static bool Ne<T>(this T field, T val) { return field != val; }
    public static bool Gt(this int field, int val) { return field > val; }
    public static bool Ge(this int field, int val) { return field >= val; }
    public static bool Lt(this int field, int val) { return field < val; }
    public static bool Le(this int field, int val) { return field <= val; }
    public static bool Between(this int field, int low, int high) { return field >= low && field <= high; }
    public static bool NotBetween(this int field, int low, int high) { return field < low || field > high; }
    public static bool IsNull(this object field) { return field == null; }
    public static bool IsNotNull(this object field) { return field != null; }
    public static bool IsNull(this string field) { return field == null; }
    public static bool IsNotNull(this string field) { return field != null; }

    public static bool Like(this string field, string pattern) {
        if (field == null || pattern == null) { return false; }
        if (pattern == "%") { return true; }
        if (pattern.StartsWith("%") && pattern.EndsWith("%") && pattern.Length > 2) {
            return field.Contains(pattern.Substring(1, pattern.Length - 2));
        }
        if (pattern.EndsWith("%")) {
            return field.StartsWith(pattern.Substring(0, pattern.Length - 1));
        }
        if (pattern.StartsWith("%")) {
            return field.EndsWith(pattern.Substring(1, pattern.Length - 1));
        }
        return field == pattern;
    }

    public static bool In<T>(this T field, List<T> values) {
        if (values == null) { return false; }
        for (int i = 0; i < values.Count; i = i + 1) {
            if (field == values[i]) { return true; }
        }
        return false;
    }

    public static bool NotIn<T>(this T field, List<T> values) {
        return !field.In(values);
    }
}

public class OrmAggContext {
    private static ThreadLocal<List<object>> contextLocal = new ThreadLocal<List<object>>();

    public static List<object> current {
        get {
            if (contextLocal == null) { return null; }
            return contextLocal.Value;
        }
        set {
            if (contextLocal != null) {
                contextLocal.Value = value;
            }
        }
    }
}

public static class OrmAggregates {
    public static long Sum<T, V>(this T item, Func<T, V> expr) {
        if (OrmAggContext.current == null || OrmAggContext.current.Count == 0) return 0;
        long s = 0;
        for (int i = 0; i < OrmAggContext.current.Count; i = i + 1) {
            s = s + Convert.ToInt64(expr((T)OrmAggContext.current[i]));
        }
        return s;
    }

    public static long Max<T, V>(this T item, Func<T, V> expr) {
        if (OrmAggContext.current == null || OrmAggContext.current.Count == 0) return 0;
        long m = Convert.ToInt64(expr((T)OrmAggContext.current[0]));
        for (int i = 1; i < OrmAggContext.current.Count; i = i + 1) {
            long v = Convert.ToInt64(expr((T)OrmAggContext.current[i]));
            if (v > m) m = v;
        }
        return m;
    }

    public static long Min<T, V>(this T item, Func<T, V> expr) {
        if (OrmAggContext.current == null || OrmAggContext.current.Count == 0) return 0;
        long m = Convert.ToInt64(expr((T)OrmAggContext.current[0]));
        for (int i = 1; i < OrmAggContext.current.Count; i = i + 1) {
            long v = Convert.ToInt64(expr((T)OrmAggContext.current[i]));
            if (v < m) m = v;
        }
        return m;
    }

    public static double Avg<T, V>(this T item, Func<T, V> expr) {
        if (OrmAggContext.current == null || OrmAggContext.current.Count == 0) return 0.0;
        double s = 0.0;
        for (int i = 0; i < OrmAggContext.current.Count; i = i + 1) {
            s = s + Convert.ToDouble(expr((T)OrmAggContext.current[i]));
        }
        return s / (double)OrmAggContext.current.Count;
    }

    public static int Count<T>(this T item) {
        if (OrmAggContext.current == null) return 0;
        return OrmAggContext.current.Count;
    }
}

// 动态探针式列名推断专用探测值（无表达式树环境下的属性反推机制）
internal static class OrmProbeConstants {
    public const int PROBE_INT_MAGIC = 987654;
    public const long PROBE_LONG_MAGIC = 9876543210L;
    public const double PROBE_DOUBLE_MAGIC = 987654.25;
    public const string PROBE_STRING_MAGIC = "__detect_marker__";
}

// 泛型 SELECT 查询驱动：结合元数据缓存与原生类型反射，提供流式查询。
public class SelectQuery<T> {
    public IDbExecutor db;
    public Select inner;
    public Meta meta;
    public Func<T, bool> predicate;
    public List<Func<T, bool>> predicates;
    public List<string> includeFields;
    public Func<T, bool> havingPredicate;
    public TypeInfo navTypeInfo;
    public Func<T, string> groupByStringFn;
    public Func<T, long> orderByLongFn;
    public bool orderByDesc;

    public SelectQuery(IDbExecutor db) {
        this.db = db;
        this.meta = Meta.For<T>();
        this.inner = Select.Create(db, this.meta);
        this.predicates = new List<Func<T, bool>>();
        this.includeFields = new List<string>();
    }

    public SelectQuery(IDbExecutor db, Meta meta) {
        this.db = db;
        this.meta = meta;
        this.inner = Select.Create(db, this.meta);
        this.predicates = new List<Func<T, bool>>();
        this.includeFields = new List<string>();
    }

    SelectQuery<T> Snapshot() {
        SelectQuery<T> copy = new SelectQuery<T>(this.db, this.meta);
        copy.inner = this.inner.Snapshot();
        copy.predicate = this.predicate;
        if (this.predicates != null) {
            for (int i = 0; i < this.predicates.Count; i = i + 1) {
                copy.predicates.Add(this.predicates[i]);
            }
        }
        for (int i = 0; i < this.includeFields.Count; i = i + 1) {
            copy.includeFields.Add(this.includeFields[i]);
        }
        copy.havingPredicate = this.havingPredicate;
        copy.navTypeInfo = this.navTypeInfo;
        copy.groupByStringFn = this.groupByStringFn;
        copy.orderByLongFn = this.orderByLongFn;
        copy.orderByDesc = this.orderByDesc;
        return copy;
    }

    public string DetectColInt(Func<T, int> expr) {
        TypeInfo ti = (this.meta != null && this.meta.Type.Name.Length > 0) ? this.meta.Type : typeof(T);
        object dummy = ti.CreateInstance();
        if (dummy == null) { return ""; }
        for (int i = 0; i < this.meta.Cols.Count; i = i + 1) {
            Col c = this.meta.Cols[i];
            if (c.Kind == 0) {
                if (c.I64) {
                    dummy.SetFieldLong(c.Field, (long)OrmProbeConstants.PROBE_INT_MAGIC);
                } else {
                    dummy.SetFieldInt(c.Field, OrmProbeConstants.PROBE_INT_MAGIC);
                }
                try {
                    int res = expr((T)dummy);
                    if (res == OrmProbeConstants.PROBE_INT_MAGIC) { return c.Col; }
                } catch (Exception _ex) {
                    // 探针反射探测：非目标字段触发异常时跳过该候选列
                }
                if (c.I64) { dummy.SetFieldLong(c.Field, 0L); }
                else { dummy.SetFieldInt(c.Field, 0); }
            }
        }
        return "";
    }

    public string DetectColLong(Func<T, long> expr) {
        TypeInfo ti = (this.meta != null && this.meta.Type.Name.Length > 0) ? this.meta.Type : typeof(T);
        object dummy = ti.CreateInstance();
        if (dummy == null) { return ""; }
        for (int i = 0; i < this.meta.Cols.Count; i = i + 1) {
            Col c = this.meta.Cols[i];
            if (c.Kind == 0) {
                if (c.I64) {
                    dummy.SetFieldLong(c.Field, OrmProbeConstants.PROBE_LONG_MAGIC);
                    try {
                        long res = expr((T)dummy);
                        if (res == OrmProbeConstants.PROBE_LONG_MAGIC) { return c.Col; }
                    } catch (Exception _ex) {
                        // 探针反射探测：非目标字段触发异常时跳过该候选列
                    }
                    dummy.SetFieldLong(c.Field, 0L);
                } else {
                    dummy.SetFieldInt(c.Field, OrmProbeConstants.PROBE_INT_MAGIC);
                    try {
                        long res = expr((T)dummy);
                        if (res == (long)OrmProbeConstants.PROBE_INT_MAGIC) { return c.Col; }
                    } catch (Exception _ex) {
                        // 探针反射探测：非目标字段触发异常时跳过该候选列
                    }
                    dummy.SetFieldInt(c.Field, 0);
                }
            }
        }
        return "";
    }

    public string DetectColDouble(Func<T, double> expr) {
        TypeInfo ti = (this.meta != null && this.meta.Type.Name.Length > 0) ? this.meta.Type : typeof(T);
        object dummy = ti.CreateInstance();
        if (dummy == null) { return ""; }
        for (int i = 0; i < this.meta.Cols.Count; i = i + 1) {
            Col c = this.meta.Cols[i];
            if (c.Kind == 1) {
                dummy.SetFieldDouble(c.Field, OrmProbeConstants.PROBE_DOUBLE_MAGIC);
                try {
                    double res = expr((T)dummy);
                    if (res == OrmProbeConstants.PROBE_DOUBLE_MAGIC) { return c.Col; }
                } catch (Exception _ex) {
                    // 探针反射探测：非目标字段触发异常时跳过该候选列
                }
                dummy.SetFieldDouble(c.Field, 0.0);
            }
        }
        return "";
    }

    public string DetectColString(Func<T, string> expr) {
        TypeInfo ti = (this.meta != null && this.meta.Type.Name.Length > 0) ? this.meta.Type : typeof(T);
        object dummy = ti.CreateInstance();
        if (dummy == null) { return ""; }
        for (int i = 0; i < this.meta.Cols.Count; i = i + 1) {
            Col c = this.meta.Cols[i];
            if (c.Kind == 3) {
                dummy.SetFieldString(c.Field, OrmProbeConstants.PROBE_STRING_MAGIC);
                try {
                    string res = expr((T)dummy);
                    if (res == OrmProbeConstants.PROBE_STRING_MAGIC) { return c.Col; }
                } catch (Exception _ex) {
                    // 探针反射探测：非目标字段触发异常时跳过该候选列
                }
                dummy.SetFieldString(c.Field, "");
            }
        }
        return "";
    }

    public SelectQuery<T> Where(Func<T, bool> predicate) {
        if (predicate != null) {
            if (this.predicates == null) {
                this.predicates = new List<Func<T, bool>>();
            }
            this.predicates.Add(predicate);
        }
        this.predicate = predicate;
        return this;
    }

    public SelectQuery<T> Where(string sql) {
        this.inner.Where(sql);
        return this;
    }

    public SelectQuery<T> WhereIf(bool condition, Func<T, bool> predicate) {
        if (condition && predicate != null) {
            this.Where(predicate);
        }
        return this;
    }

    public SelectQuery<T> WhereIf(bool condition, string sql) {
        if (condition) {
            this.inner.Where(sql);
        }
        return this;
    }

    public SelectQuery<T> WhereEq(string col, string val) {
        this.inner.WhereEq(col, val);
        return this;
    }

    public SelectQuery<T> WhereEq(string col, int val) {
        this.inner.WhereEq(col, val);
        return this;
    }

    public SelectQuery<T> WhereEq(string col, long val) {
        this.inner.WhereEq(col, val);
        return this;
    }

    public SelectQuery<T> Where(ExprNode expr) {
        this.inner.WExpr(expr);
        return this;
    }

    public SelectQuery<T> Where(Expr<T> expr) {
        if (expr != null && expr.Root != null) {
            this.inner.WExpr(expr.Root);
        }
        return this;
    }

    public SelectQuery<T> WhereConds(List<Cond> cs) {
        this.inner.WhereConds(cs);
        return this;
    }

    public SelectQuery<T> WhereConds(List<OrmCond> cs) {
        if (cs != null) {
            List<Cond> list = new List<Cond>();
            for (int i = 0; i < cs.Count; i = i + 1) {
                list.Add(cs[i]);
            }
            this.inner.WhereConds(list);
        }
        return this;
    }

    public SelectQuery<T> WherePk(int id) {
        this.inner.WherePk(id);
        return this;
    }

    public SelectQuery<T> WherePk(long id) {
        this.inner.WherePk(id);
        return this;
    }

    public SelectQuery<T> WherePk(string id) {
        this.inner.WherePk(id);
        return this;
    }

    public SelectQuery<T> WhereDict(DbValues v) {
        this.inner.WhereDict(v);
        return this;
    }

    public string ExtractColFromExpr(ExprNode expr) {
        if (expr == null) { return ""; }
        if (expr.Kind == 0) {
            Col c = this.meta.Find(expr.Name);
            if (c != null) { return c.Col; }
            for (int i = 0; i < this.meta.Cols.Count; i = i + 1) {
                if (this.meta.Cols[i].Field == expr.Name) { return this.meta.Cols[i].Col; }
            }
            return expr.Name;
        }
        if (expr.Kind == 4 && expr.A != null) {
            return this.ExtractColFromExpr(expr.A);
        }
        return "";
    }

    public SelectQuery<T> OrderBy(string col) {
        this.inner.OrderBy(col);
        return this;
    }

    public SelectQuery<T> OrderBy(ExprNode expr) {
        string col = this.ExtractColFromExpr(expr);
        if (col.Length > 0) { this.inner.OrderBy(col); }
        return this;
    }

    public SelectQuery<T> OrderBy(Expr<T> expr) {
        if (expr != null) { return this.OrderBy(expr.Root); }
        return this;
    }

    public SelectQuery<T> OrderBy(Func<T, long> expr) {
        this.orderByLongFn = expr;
        this.orderByDesc = false;
        string col = this.DetectColLong(expr);
        if (col.Length > 0) { this.inner.OrderBy(col); }
        return this;
    }

    public SelectQuery<T> OrderBy(Func<T, int> expr) {
        this.orderByLongFn = (T item) => (long)expr(item);
        this.orderByDesc = false;
        string col = this.DetectColInt(expr);
        if (col.Length > 0) { this.inner.OrderBy(col); }
        return this;
    }

    public SelectQuery<T> OrderBy(Func<T, string> expr) {
        string col = this.DetectColString(expr);
        if (col.Length > 0) { this.inner.OrderBy(col); }
        return this;
    }

    public SelectQuery<T> OrderByDescending(string col) {
        this.inner.OBD(col);
        return this;
    }

    public SelectQuery<T> OrderByDescending(ExprNode expr) {
        string col = this.ExtractColFromExpr(expr);
        if (col.Length > 0) { this.inner.OBD(col); }
        return this;
    }

    public SelectQuery<T> OrderByDescending(Expr<T> expr) {
        if (expr != null) { return this.OrderByDescending(expr.Root); }
        return this;
    }

    public SelectQuery<T> OrderByDescending(Func<T, long> expr) {
        this.orderByLongFn = expr;
        this.orderByDesc = true;
        string col = this.DetectColLong(expr);
        if (col.Length > 0) { this.inner.OBD(col); }
        return this;
    }

    public SelectQuery<T> OrderByDescending(Func<T, int> expr) {
        this.orderByLongFn = (T item) => (long)expr(item);
        this.orderByDesc = true;
        string col = this.DetectColInt(expr);
        if (col.Length > 0) { this.inner.OBD(col); }
        return this;
    }

    public SelectQuery<T> OrderByDescending(Func<T, string> expr) {
        string col = this.DetectColString(expr);
        if (col.Length > 0) { this.inner.OBD(col); }
        return this;
    }

    public SelectQuery<T> GroupBy(string col) {
        this.inner.GroupBy(col);
        return this;
    }

    public SelectQuery<T> GroupBy(ExprNode expr) {
        string col = this.ExtractColFromExpr(expr);
        if (col.Length > 0) { this.inner.GroupBy(col); }
        return this;
    }

    public SelectQuery<T> GroupBy(Expr<T> expr) {
        if (expr != null) { return this.GroupBy(expr.Root); }
        return this;
    }

    public SelectQuery<T> GroupBy(Func<T, string> expr) {
        this.groupByStringFn = expr;
        string col = this.DetectColString(expr);
        if (col.Length > 0) { this.inner.GroupBy(col); }
        return this;
    }

    public SelectQuery<T> GroupBy(Func<T, int> expr) {
        string col = this.DetectColInt(expr);
        if (col.Length > 0) { this.inner.GroupBy(col); }
        return this;
    }

    public SelectQuery<T> Having(string condition) {
        this.inner.Having(condition);
        return this;
    }

    public SelectQuery<T> Having(Func<T, bool> predicate) {
        this.havingPredicate = predicate;
        return this;
    }

    public SelectQuery<T> Distinct() {
        this.inner.Distinct();
        return this;
    }

    public SelectQuery<T> Skip(int offset) {
        this.inner.offN = offset;
        return this;
    }

    public SelectQuery<T> Take(int limit) {
        this.inner.limN = limit;
        return this;
    }

    public SelectQuery<T> Limit(int limit) {
        this.inner.limN = limit;
        return this;
    }

    public SelectQuery<T> Limit(int limit, int offset) {
        this.inner.limN = limit;
        this.inner.offN = offset;
        return this;
    }

    public SelectQuery<T> Page(int page, int pageSize) {
        if (page < 1) { page = 1; }
        int off = (page - 1) * pageSize;
        return this.Limit(pageSize, off);
    }

    // 执行分页查询并返回封装总记录数与分页明细的 PageResult。
    public PageResult<T> ToPageResult(int page, int pageSize) {
        SelectQuery<T> query = this.Snapshot();
        int total = query.CountRows();
        List<T> list = query.Page(page, pageSize).ReadList();
        return new PageResult<T>(list, total, page, pageSize);
    }

    // 异步执行分页查询并返回封装总记录数与分页明细的 PageResult。
    public async PageResult<T> ToPageResultAsync(int page, int pageSize) {
        SelectQuery<T> query = this.Snapshot();
        int total = await query.CountRowsAsync();
        query.Page(page, pageSize);
        List<T> list = await query.ReadListAsync();
        return new PageResult<T>(list, total, page, pageSize);
    }

    public Col PkCol() {
        if (this.meta != null) {
            return this.meta.PkCol();
        }
        return null;
    }

    public string PkName() {
        Col pk = this.PkCol();
        return pk != null ? pk.Col : "id";
    }

    public long ExtractLongPk(T item) {
        if (item == null) { return 0L; }
        Col pk = this.PkCol();
        string fname = pk != null ? pk.Field : "id";
        object obj = (object)item;
        try {
            if (pk != null && pk.I64) {
                return obj.GetFieldLong(fname);
            }
            return (long)obj.GetFieldInt(fname);
        } catch (Exception) {
            try {
                return obj.GetFieldLong(fname);
            } catch (Exception) {
                return 0L;
            }
        }
    }

    // 基于主键游标的分页不改写调用方的查询条件或排序。
    void ConfigureSeek(long lastCursor, int pageSize, bool asc) {
        string pk = this.PkName();
        if (lastCursor > 0) {
            this.Where(pk + (asc ? " > " : " < ") + lastCursor.ToString());
        }
        this.OrderBy(pk + (asc ? " ASC" : " DESC"));
        this.Limit(pageSize < 2147483647 ? pageSize + 1 : pageSize, 0);
    }

    SeekResult<T> SeekPage(List<T> rows, long lastCursor, int pageSize) {
        bool hasMore = rows.Count > pageSize;
        if (hasMore) { rows.RemoveAt(rows.Count - 1); }
        long nextCursor = rows.Count > 0 ? this.ExtractLongPk(rows[rows.Count - 1]) : lastCursor;
        return new SeekResult<T>(rows, hasMore, nextCursor);
    }

    public SeekResult<T> ToSeekResult(long lastCursor, int pageSize, bool asc = true) {
        if (pageSize <= 0) { pageSize = 10; }
        SelectQuery<T> query = this.Snapshot();
        query.ConfigureSeek(lastCursor, pageSize, asc);
        return query.SeekPage(query.ReadList(), lastCursor, pageSize);
    }

    public async SeekResult<T> ToSeekResultAsync(long lastCursor, int pageSize, bool asc = true) {
        if (pageSize <= 0) { pageSize = 10; }
        SelectQuery<T> query = this.Snapshot();
        query.ConfigureSeek(lastCursor, pageSize, asc);
        List<T> rows = await query.ReadListAsync();
        return query.SeekPage(rows, lastCursor, pageSize);
    }

    public SelectQuery<T> Include<TNav>(Func<T, TNav> expr) {
        this.navTypeInfo = typeof(TNav);
        TypeInfo ti = (this.meta != null && this.meta.Type.Name.Length > 0) ? this.meta.Type : typeof(T);
        for (int i = 0; i < ti.FieldCount; i = i + 1) {
            string fname = ti.GetFieldName(i);
            string fkField = fname + "Id";
            if (ti.HasField(fkField) || ti.HasField(fname + "id")) {
                this.includeFields.Add(fname);
            }
        }
        return this;
    }

    public bool HasPredicates() {
        return this.predicate != null || (this.predicates != null && this.predicates.Count > 0);
    }

    public bool MatchPredicates(T item) {
        if (this.predicates != null && this.predicates.Count > 0) {
            for (int i = 0; i < this.predicates.Count; i = i + 1) {
                if (!this.predicates[i](item)) { return false; }
            }
            return true;
        }
        if (this.predicate != null) {
            return this.predicate(item);
        }
        return true;
    }

    public int Count() {
        return this.Snapshot().CountRows();
    }

    public async int CountAsync() {
        SelectQuery<T> query = this.Snapshot();
        return await query.CountRowsAsync();
    }

    bool HasClientFilter() {
        return this.HasPredicates() || this.havingPredicate != null;
    }

    bool CountOnClient() {
        return this.HasClientFilter() || this.groupByStringFn != null;
    }

    int CountRows() {
        if (!this.CountOnClient()) { return this.inner.Count(); }
        return this.CountMatching(this.Unpaged().Rows());
    }

    async int CountRowsAsync() {
        if (!this.CountOnClient()) { return await this.inner.CountAsync(); }
        Select select = this.Unpaged();
        DbResult rows = await select.RowsAsync();
        return this.CountMatching(rows);
    }

    int CountMatching(DbResult rows) {
        List<T> items = this.FilterRows(rows, this.groupByStringFn == null, 0, -1);
        if (this.groupByStringFn == null) { return items.Count; }
        List<string> keys = new List<string>();
        Dictionary<string, List<object>> groups = this.GroupRows(items, keys);
        int count = 0;
        for (int i = 0; i < keys.Count; i = i + 1) {
            if (this.GroupMatches(groups[keys[i]])) { count = count + 1; }
        }
        return count;
    }

    List<T> AggregateRows() {
        SelectQuery<T> query = this.Snapshot();
        return query.FilterRows(query.Unpaged().Rows(), true, 0, -1);
    }

    public int Sum(Func<T, int> expr) {
        if (this.HasClientFilter()) {
            List<T> list = this.AggregateRows();
            int s = 0;
            for (int i = 0; i < list.Count; i = i + 1) {
                s = s + expr(list[i]);
            }
            return s;
        }
        string col = this.DetectColInt(expr);
        return this.inner.AggI("SUM(" + col + ")");
    }

    public int Max(Func<T, int> expr) {
        if (this.HasClientFilter()) {
            List<T> list = this.AggregateRows();
            if (list.Count == 0) { return 0; }
            int m = expr(list[0]);
            for (int i = 1; i < list.Count; i = i + 1) {
                int val = expr(list[i]);
                if (val > m) { m = val; }
            }
            return m;
        }
        string col = this.DetectColInt(expr);
        return this.inner.AggI("MAX(" + col + ")");
    }

    public int Min(Func<T, int> expr) {
        if (this.HasClientFilter()) {
            List<T> list = this.AggregateRows();
            if (list.Count == 0) { return 0; }
            int m = expr(list[0]);
            for (int i = 1; i < list.Count; i = i + 1) {
                int val = expr(list[i]);
                if (val < m) { m = val; }
            }
            return m;
        }
        string col = this.DetectColInt(expr);
        return this.inner.AggI("MIN(" + col + ")");
    }

    public double Avg(Func<T, double> expr) {
        if (this.HasClientFilter()) {
            List<T> list = this.AggregateRows();
            if (list.Count == 0) { return 0.0; }
            double sum = 0.0;
            for (int i = 0; i < list.Count; i = i + 1) {
                sum = sum + expr(list[i]);
            }
            return sum / (double)list.Count;
        }
        string col = this.DetectColDouble(expr);
        return this.inner.AggD("AVG(" + col + ")");
    }

    // 列名至结果集列索引预解析，避免在行遍历内层高频重复字典查表
    public static List<int> ResolveColIndices(DbResult r, Meta meta) {
        List<int> colIndices = new List<int>();
        if (r == null || meta == null) { return colIndices; }
        int totalCols = r.ColumnCount();
        for (int i = 0; i < meta.Cols.Count; i = i + 1) {
            Col c = meta.Cols[i];
            int colIdx = r.GetColumnIndex(c.Col);
            if (colIdx < 0) {
                colIdx = i;
            }
            if (colIdx >= totalCols) {
                colIdx = -1;
            }
            colIndices.Add(colIdx);
        }
        return colIndices;
    }

    // 从 DbResult 当前行映射生成实体实例（带预解析列索引缓存，O(1) 零查找）
    public static T MapRow(DbResult r, int row, Meta meta, List<int> colIndices) {
        TypeInfo ti = (meta != null && meta.Type.Name.Length > 0) ? meta.Type : typeof(T);
        object obj = ti.CreateInstance();
        for (int i = 0; i < meta.Cols.Count; i = i + 1) {
            int colIdx = -1;
            if (colIndices != null && i < colIndices.Count) {
                colIdx = colIndices[i];
            } else {
                colIdx = r.GetColumnIndex(meta.Cols[i].Col);
                if (colIdx < 0) { colIdx = i; }
                if (colIdx >= r.ColumnCount()) { continue; }
            }
            if (colIdx < 0) {
                continue;
            }
            Col c = meta.Cols[i];
            if (c.Kind == 3) {
                if (r.IsNull(row, colIdx)) {
                    obj.SetFieldObject(c.Field, null);
                } else {
                    obj.SetFieldString(c.Field, r.GetString(row, colIdx));
                }
            } else if (c.Kind == 1) {
                obj.SetFieldDouble(c.Field, r.GetDouble(row, colIdx));
            } else if (c.Kind == 2) {
                obj.SetFieldBool(c.Field, r.GetInt(row, colIdx) != 0);
            } else if (c.Kind == 0 && c.I64) {
                obj.SetFieldLong(c.Field, r.GetLong(row, colIdx));
            } else {
                obj.SetFieldInt(c.Field, r.GetInt(row, colIdx));
            }
        }
        return (T)obj;
    }

    // 从 DbResult 当前行映射生成实体实例
    public static T MapRow(DbResult r, int row, Meta meta) {
        return MapRow(r, row, meta, null);
    }

    // Only execution snapshots change SQL pagination. Delegate filters see
    // the full SQL candidate set; only filtered rows count toward a page.
    Select Unpaged() {
        Select select = this.inner.Snapshot();
        select.limN = -1;
        select.offN = -1;
        return select;
    }

    List<T> FilterRows(DbResult rows, bool applyHaving, int skip, int take) {
        List<T> list = new List<T>();
        if (rows == null || take == 0) { return list; }
        int remaining = skip > 0 ? skip : 0;
        int count = rows.RowCount();
        List<int> columns = ResolveColIndices(rows, this.meta);
        for (int i = 0; i < count && (take < 0 || list.Count < take); i = i + 1) {
            T item = MapRow(rows, i, this.meta, columns);
            if (!this.MatchPredicates(item)) { continue; }
            if (applyHaving && this.havingPredicate != null && !this.havingPredicate(item)) { continue; }
            if (remaining > 0) { remaining = remaining - 1; }
            else { list.Add(item); }
        }
        return list;
    }

    List<T> ReadList() {
        if (this.inner.limN == 0) { return new List<T>(); }
        bool client = this.HasClientFilter();
        Select select = client ? this.Unpaged() : this.inner;
        List<T> items = this.FilterRows(select.Rows(), true,
            client ? this.inner.offN : 0, client ? this.inner.limN : -1);
        if (this.includeFields.Count > 0) {
            for (int i = 0; i < items.Count; i = i + 1) { this.PopulateNavigations(items[i]); }
        }
        return items;
    }

    async List<T> ReadListAsync() {
        if (this.inner.limN == 0) { return new List<T>(); }
        bool client = this.HasClientFilter();
        Select select = client ? this.Unpaged() : this.inner;
        DbResult rows = await select.RowsAsync();
        List<T> items = this.FilterRows(rows, true,
            client ? this.inner.offN : 0, client ? this.inner.limN : -1);
        if (this.includeFields.Count > 0) {
            for (int i = 0; i < items.Count; i = i + 1) { await this.PopulateNavigationsAsync(items[i]); }
        }
        return items;
    }

    public List<T> ToList() {
        return this.Snapshot().ReadList();
    }

    TypeInfo NavigationOwnerType() {
        return (this.meta != null && this.meta.Type.Name.Length > 0) ? this.meta.Type : typeof(T);
    }

    int NavigationField(TypeInfo owner, string name, out string foreignKey) {
        foreignKey = name + "Id";
        if (!owner.HasField(foreignKey)) { foreignKey = name + "id"; }
        if (!owner.HasField(foreignKey)) { return -1; }
        for (int i = 0; i < owner.FieldCount; i = i + 1) {
            if (owner.GetFieldName(i) == name) { return i; }
        }
        return -1;
    }

    static string NavigationSql(TypeInfo owner, int field) {
        return "SELECT * FROM " + QueryBuilder.RequireIdent(owner.GetFieldType(field)) + " WHERE id = ?";
    }

    static void SetNavigation(object item, string field, TypeInfo type, DbResult rows) {
        if (rows == null || rows.RowCount() == 0) { return; }
        object nav = type.CreateInstance();
        for (int i = 0; i < type.FieldCount; i = i + 1) {
            string name = type.GetFieldName(i);
            int col = rows.GetColumnIndex(name);
            if (col < 0) { continue; }
            string kind = type.GetFieldType(i);
            if (kind == "string") { nav.SetFieldString(name, rows.GetString(0, col)); }
            else if (kind == "bool") { nav.SetFieldBool(name, rows.GetInt(0, col) != 0); }
            else if (kind == "double" || kind == "float") { nav.SetFieldDouble(name, rows.GetDouble(0, col)); }
            else if (kind == "long" || kind == "ulong") { nav.SetFieldLong(name, rows.GetLong(0, col)); }
            else { nav.SetFieldInt(name, rows.GetInt(0, col)); }
        }
        item.SetFieldObject(field, nav);
    }

    public void PopulateNavigations(T item) {
        if (item == null || this.db == null) { return; }
        object obj = (object)item;
        TypeInfo owner = this.NavigationOwnerType();
        for (int i = 0; i < this.includeFields.Count; i = i + 1) {
            string name = this.includeFields[i];
            string key = "";
            int field = this.NavigationField(owner, name, out key);
            if (field < 0) { continue; }
            DbParams ps = new DbParams();
            ps.AddInt(obj.GetFieldInt(key));
            DbResult rows = this.db.Query(NavigationSql(owner, field), ps);
            SetNavigation(obj, name, owner.GetFieldTypeInfo(field), rows);
        }
    }

    async bool PopulateNavigationsAsync(T item) {
        if (item == null || this.db == null) { return true; }
        object obj = (object)item;
        TypeInfo owner = this.NavigationOwnerType();
        for (int i = 0; i < this.includeFields.Count; i = i + 1) {
            string name = this.includeFields[i];
            string key = "";
            int field = this.NavigationField(owner, name, out key);
            if (field < 0) { continue; }
            DbParams ps = new DbParams();
            ps.AddInt(obj.GetFieldInt(key));
            DbResult rows = await this.db.QueryAsync(NavigationSql(owner, field), ps);
            SetNavigation(obj, name, owner.GetFieldTypeInfo(field), rows);
        }
        return true;
    }

    public async List<T> ToListAsync() {
        SelectQuery<T> query = this.Snapshot();
        return await query.ReadListAsync();
    }

    static List<string> ProjectStrings(List<T> raw, Func<T, string> selector) {
        List<string> result = new List<string>();
        for (int i = 0; i < raw.Count; i = i + 1) { result.Add(selector(raw[i])); }
        return result;
    }

    public List<string> ToList(Func<T, string> selector) {
        return ProjectStrings(this.ToList(), selector);
    }

    public async List<string> ToListAsync(Func<T, string> selector) {
        List<T> raw = await this.ToListAsync();
        return ProjectStrings(raw, selector);
    }

    Dictionary<string, List<object>> GroupRows(List<T> rows, List<string> keys) {
        Dictionary<string, List<object>> groups = new Dictionary<string, List<object>>();
        for (int i = 0; i < rows.Count; i = i + 1) {
            T item = rows[i];
            string key = this.groupByStringFn(item);
            if (!groups.ContainsKey(key)) {
                groups[key] = new List<object>();
                keys.Add(key);
            }
            groups[key].Add((object)item);
        }
        return groups;
    }

    bool GroupMatches(List<object> group) {
        if (this.havingPredicate == null) { return true; }
        List<object> previous = OrmAggContext.current;
        OrmAggContext.current = group;
        try { return this.havingPredicate((T)group[0]); }
        finally { OrmAggContext.current = previous; }
    }

    long GroupSortKey(List<object> group) {
        List<object> previous = OrmAggContext.current;
        OrmAggContext.current = group;
        try { return this.orderByLongFn((T)group[0]); }
        finally { OrmAggContext.current = previous; }
    }

    List<List<object>> PageGroups(List<T> rows) {
        List<List<object>> page = new List<List<object>>();
        if (rows.Count == 0 || this.inner.limN == 0) { return page; }
        if (this.groupByStringFn == null) {
            List<object> group = new List<object>();
            for (int i = 0; i < rows.Count; i = i + 1) { group.Add((object)rows[i]); }
            page.Add(group);
            return page;
        }
        List<string> keys = new List<string>();
        Dictionary<string, List<object>> groups = this.GroupRows(rows, keys);
        if (this.orderByLongFn != null && keys.Count > 1) {
            Dictionary<string, long> order = new Dictionary<string, long>();
            for (int i = 0; i < keys.Count; i = i + 1) {
                order[keys[i]] = this.GroupSortKey(groups[keys[i]]);
            }
            for (int i = 0; i < keys.Count - 1; i = i + 1) {
                for (int j = 0; j < keys.Count - 1 - i; j = j + 1) {
                    long left = order[keys[j]];
                    long right = order[keys[j + 1]];
                    if (this.orderByDesc ? (left < right) : (left > right)) {
                        string tmp = keys[j];
                        keys[j] = keys[j + 1];
                        keys[j + 1] = tmp;
                    }
                }
            }
        }
        int remaining = this.inner.offN > 0 ? this.inner.offN : 0;
        int limit = this.inner.limN;
        for (int i = 0; i < keys.Count && (limit < 0 || page.Count < limit); i = i + 1) {
            List<object> group = groups[keys[i]];
            if (!this.GroupMatches(group)) { continue; }
            if (remaining > 0) { remaining = remaining - 1; }
            else { page.Add(group); }
        }
        return page;
    }

    TReturn ProjectGroup<TReturn>(List<object> group, Func<T, TReturn> selector) {
        List<object> previous = OrmAggContext.current;
        OrmAggContext.current = group;
        try { return selector((T)group[0]); }
        finally { OrmAggContext.current = previous; }
    }

    List<TReturn> ReadProjection<TReturn>(Func<T, TReturn> selector) {
        List<TReturn> result = new List<TReturn>();
        if (this.inner.limN == 0) { return result; }
        List<T> rows = this.FilterRows(this.Unpaged().Rows(), this.groupByStringFn == null, 0, -1);
        List<List<object>> page = this.PageGroups(rows);
        for (int i = 0; i < page.Count; i = i + 1) {
            if (this.includeFields.Count > 0) { this.PopulateNavigations((T)page[i][0]); }
            result.Add(this.ProjectGroup<TReturn>(page[i], selector));
        }
        return result;
    }

    async List<TReturn> ReadProjectionAsync<TReturn>(Func<T, TReturn> selector) {
        List<TReturn> result = new List<TReturn>();
        if (this.inner.limN == 0) { return result; }
        Select select = this.Unpaged();
        DbResult data = await select.RowsAsync();
        List<T> rows = this.FilterRows(data, this.groupByStringFn == null, 0, -1);
        List<List<object>> page = this.PageGroups(rows);
        for (int i = 0; i < page.Count; i = i + 1) {
            if (this.includeFields.Count > 0) { await this.PopulateNavigationsAsync((T)page[i][0]); }
            result.Add(this.ProjectGroup<TReturn>(page[i], selector));
        }
        return result;
    }

    public List<TReturn> ToList<TReturn>(Func<T, TReturn> selector) {
        return this.Snapshot().ReadProjection<TReturn>(selector);
    }

    public async List<TReturn> ToListAsync<TReturn>(Func<T, TReturn> selector) {
        SelectQuery<T> query = this.Snapshot();
        return await query.ReadProjectionAsync<TReturn>(selector);
    }

    public TReturn ToOne<TReturn>(Func<T, TReturn> selector) {
        SelectQuery<T> query = this.Snapshot();
        if (query.inner.limN != 0) { query.inner.One(); }
        List<TReturn> list = query.ReadProjection<TReturn>(selector);
        return list.Count > 0 ? list[0] : null;
    }

    public async TReturn ToOneAsync<TReturn>(Func<T, TReturn> selector) {
        SelectQuery<T> query = this.Snapshot();
        if (query.inner.limN != 0) { query.inner.One(); }
        List<TReturn> list = await query.ReadProjectionAsync<TReturn>(selector);
        return list.Count > 0 ? list[0] : null;
    }

    // 反向关系：取某个父行的子集合。关系从子实体的导航声明反推
    // （外键列 = <导航字段名>Id，与正向 Include 同一约定），调用方不写
    // 外键列名。子实体有多个导航时 Children 抛异常——「反查哪个父」
    // 只有调用方能回答，用 ChildrenOf 指明父表；没有导航或父表未知
    // 返回空集合。
    public List<T> Children(int id) {
        return this.ChildrenOf("", id);
    }

    public List<T> Children(string id) {
        return this.ChildrenOf("", id);
    }

    public List<T> ChildrenOf(string table, int id) {
        Rel rel = Rel.Derive(this.meta, table);
        if (rel == null) { return new List<T>(); }
        Select q = Select.Create(this.db, this.meta);
        rel.Apply(q, (long)id);
        return this.MapAll(q.Rows());
    }

    public List<T> ChildrenOf(string table, string id) {
        Rel rel = Rel.Derive(this.meta, table);
        if (rel == null) { return new List<T>(); }
        Select q = Select.Create(this.db, this.meta);
        rel.Apply(q, id);
        return this.MapAll(q.Rows());
    }

    public async List<T> ChildrenAsync(int id) {
        return await this.ChildrenOfAsync("", id);
    }

    public async List<T> ChildrenAsync(string id) {
        return await this.ChildrenOfAsync("", id);
    }

    public async List<T> ChildrenOfAsync(string table, int id) {
        Rel rel = Rel.Derive(this.meta, table);
        if (rel == null) { return new List<T>(); }
        Select q = Select.Create(this.db, this.meta);
        rel.Apply(q, (long)id);
        DbResult rows = await q.RowsAsync();
        return this.MapAll(rows);
    }

    public async List<T> ChildrenOfAsync(string table, string id) {
        Rel rel = Rel.Derive(this.meta, table);
        if (rel == null) { return new List<T>(); }
        Select q = Select.Create(this.db, this.meta);
        rel.Apply(q, id);
        DbResult rows = await q.RowsAsync();
        return this.MapAll(rows);
    }

    List<T> MapAll(DbResult r) {
        List<T> list = new List<T>();
        if (r == null) { return list; }
        List<int> colIndices = ResolveColIndices(r, this.meta);
        int totalRows = r.RowCount();
        for (int i = 0; i < totalRows; i = i + 1) {
            list.Add(MapRow(r, i, this.meta, colIndices));
        }
        return list;
    }

    public T First() {
        SelectQuery<T> query = this.Snapshot();
        if (query.inner.limN != 0) { query.inner.One(); }
        List<T> list = query.ReadList();
        return list.Count > 0 ? list[0] : null;
    }

    public async T FirstAsync() {
        SelectQuery<T> query = this.Snapshot();
        if (query.inner.limN != 0) { query.inner.One(); }
        List<T> list = await query.ReadListAsync();
        return list.Count > 0 ? list[0] : null;
    }

    public T ToOne() {
        return this.First();
    }

    public async T ToOneAsync() {
        return await this.FirstAsync();
    }

    public bool Any() {
        return this.First() != null;
    }

    public async bool AnyAsync() {
        return (await this.FirstAsync()) != null;
    }
}

// 实体行的反射取值集合
public class EntityRows<T> : IRows {
    public List<T> items;

    public EntityRows() {
        this.items = new List<T>();
    }

    public void Add(T item) {
        this.items.Add(item);
    }

    public int RowCount() {
        return this.items.Count;
    }

    public void BindCol(int row, Col c, DbParams ps) {
        T item = this.items[row];
        if (item == null) {
            ps.AddNull();
            return;
        }
        if (c.Kind == 3) {
            ps.Add(((object)item).GetFieldString(c.Field));
        } else if (c.Kind == 1) {
            ps.AddDouble(((object)item).GetFieldDouble(c.Field));
        } else if (c.Kind == 2) {
            bool b = ((object)item).GetFieldBool(c.Field);
            ps.AddInt(b ? 1 : 0);
        } else if (c.Kind == 0 && c.I64) {
            ps.AddLong(((object)item).GetFieldLong(c.Field));
        } else {
            ps.AddInt(((object)item).GetFieldInt(c.Field));
        }
    }
}

