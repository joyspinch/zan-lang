using System;
using System.Data;

namespace System.Data.Orm;

// ZanSql 强类型通用泛型仓储基类。
// 封装实体的全部常规 CRUD 操作，消除各个业务模块中重复书写的样板 DAO 代码。
// 业务仓储只需继承此类，即可直接拥有开箱即用的异步/同步查询与写入能力。
// 用法：
// }
public class BaseRepository<T> {
    public IZanSql zsql;
    public IUnitOfWork uow;

    // 无参构造：自动绑定当前环境上下文中的 ZanSql.Current 实例，免去外部手动传参
    public BaseRepository() {
        this.zsql = ZanSql.Current;
        this.uow = null;
    }

    public BaseRepository(IZanSql zsql) {
        this.zsql = zsql;
        this.uow = null;
    }

    public BaseRepository(IZanSql zsql, IUnitOfWork uow) {
        this.zsql = zsql;
        this.uow = uow;
    }

    // 获取当前仓储绑定的 ZanSql 门面。
    public IZanSql Orm { get { return this.zsql; } }

    // 获取或设置工作单元事务。
    public IUnitOfWork UnitOfWork {
        get { return this.uow; }
        set { this.uow = value; }
    }

    // 获取当前执行上下文（若存在工作单元则在工作单元内执行）。
    public IDbExecutor GetExecutor() {
        if (this.uow != null) { return this.uow; }
        return this.zsql;
    }

    // 绑定工作单元事务。
    public void Attach(IUnitOfWork uow) {
        this.uow = uow;
    }

    // 解绑工作单元事务。
    public void Detach() {
        this.uow = null;
    }

    // 获取当前实体的 SelectQuery 查询构造器。
    public SelectQuery<T> Select() {
        return this.GetExecutor().Select<T>();
    }

    // 过滤条件查询构造器。
    public SelectQuery<T> Where(Func<T, bool> expr) {
        return this.GetExecutor().Select<T>().Where(expr);
    }

    // 条件过滤查询构造器（SQL 原生片段）。
    public SelectQuery<T> Where(string sql) {
        return this.GetExecutor().Select<T>().Where(sql);
    }

    // 条件成立时附加过滤条件。
    public SelectQuery<T> WhereIf(bool condition, Func<T, bool> expr) {
        return this.GetExecutor().Select<T>().WhereIf(condition, expr);
    }

    // 条件成立时附加过滤条件（SQL 原生片段）。
    public SelectQuery<T> WhereIf(bool condition, string sql) {
        return this.GetExecutor().Select<T>().WhereIf(condition, sql);
    }

    // 声明式列表条件。
    public SelectQuery<T> WhereConds(List<Cond> cs) {
        return this.GetExecutor().Select<T>().WhereConds(cs);
    }

    public SelectQuery<T> WhereConds(List<OrmCond> cs) {
        return this.GetExecutor().Select<T>().WhereConds(cs);
    }

    // 排序查询构造器。
    public SelectQuery<T> OrderBy(Func<T, int> expr) {
        return this.GetExecutor().Select<T>().OrderBy(expr);
    }

    public SelectQuery<T> OrderBy(Func<T, string> expr) {
        return this.GetExecutor().Select<T>().OrderBy(expr);
    }

    public SelectQuery<T> OrderBy(string col) {
        return this.GetExecutor().Select<T>().OrderBy(col);
    }

    // 降序排序查询构造器。
    public SelectQuery<T> OrderByDescending(Func<T, int> expr) {
        return this.GetExecutor().Select<T>().OrderByDescending(expr);
    }

    public SelectQuery<T> OrderByDescending(Func<T, string> expr) {
        return this.GetExecutor().Select<T>().OrderByDescending(expr);
    }

    public SelectQuery<T> OrderByDescending(string col) {
        return this.GetExecutor().Select<T>().OrderByDescending(col);
    }

    // 获取当前实体的 UpdateQuery 更新构造器。
    public UpdateQuery<T> Update() {
        return this.GetExecutor().Update<T>();
    }

    public UpdateQuery<T> UpdateDml() {
        return this.GetExecutor().Update<T>();
    }

    // 获取当前实体的 DeleteQuery 删除构造器。
    public DeleteQuery<T> Delete() {
        return this.GetExecutor().Delete<T>();
    }

    public DeleteQuery<T> DeleteDml() {
        return this.GetExecutor().Delete<T>();
    }

    // 插入单条实体，返回 InsertQuery 查询构造器。
    public InsertQuery<T> Insert(T entity) {
        return this.GetExecutor().Insert<T>(entity);
    }

    // 异步插入单条实体，返回影响行数。
    public async int InsertAsync(T entity) {
        return await this.GetExecutor().Insert<T>(entity).ExecuteAffrowsAsync();
    }

    // 单条插入并返回自增主键。
    public int InsertIdentity(T entity) {
        return this.GetExecutor().Insert<T>(entity).ExecuteIdentity();
    }

    // 异步单条插入并返回自增主键。
    public async int InsertIdentityAsync(T entity) {
        return await this.GetExecutor().Insert<T>(entity).ExecuteIdentityAsync();
    }

    // 批量插入实体列表。
    public int InsertBatch(List<T> entities) {
        return this.GetExecutor().Insert<T>(entities).ExecuteAffrows();
    }

    // 异步批量插入实体列表。
    public async int InsertBatchAsync(List<T> entities) {
        return await this.GetExecutor().Insert<T>(entities).ExecuteAffrowsAsync();
    }

    // 更新实体，返回 UpdateQuery 更新构造器（按主键更新所有非键字段）。
    public UpdateQuery<T> Update(T entity) {
        return this.GetExecutor().Update<T>().SetSource(entity);
    }

    // 异步更新实体。
    public async int UpdateAsync(T entity) {
        return await this.GetExecutor().Update<T>().SetSource(entity).ExecuteAffrowsAsync();
    }

    // 获取全量列表。
    public List<T> SelectAll() {
        return this.GetExecutor().Select<T>().ToList();
    }

    // 快捷全量列表查询。
    public List<T> ToList() {
        return this.GetExecutor().Select<T>().ToList();
    }

    // 异步获取全量列表。
    public async List<T> SelectAllAsync() {
        return await this.GetExecutor().Select<T>().ToListAsync();
    }

    // 快捷异步全量列表查询。
    public async List<T> ToListAsync() {
        return await this.GetExecutor().Select<T>().ToListAsync();
    }

    // 总记录数。
    public int Count() {
        return this.GetExecutor().Select<T>().Count();
    }

    // 异步总记录数。
    public async int CountAsync() {
        return await this.GetExecutor().Select<T>().CountAsync();
    }

    // 是否存在任意记录。
    public bool Any() {
        return this.GetExecutor().Select<T>().Any();
    }

    // 异步判断是否存在任意记录。
    public async bool AnyAsync() {
        return await this.GetExecutor().Select<T>().AnyAsync();
    }

    // 根据整数主键查询单条实体。
    public T FindById(int id) {
        return this.GetExecutor().Select<T>().WherePk(id).First();
    }

    // 异步根据整数主键查询单条实体。
    public async T FindByIdAsync(int id) {
        return await this.GetExecutor().Select<T>().WherePk(id).FirstAsync();
    }

    // 根据 64 位长整数主键查询单条实体。
    public T FindById(long id) {
        return this.GetExecutor().Select<T>().WherePk(id).First();
    }

    // 异步根据 64 位长整数主键查询单条实体。
    public async T FindByIdAsync(long id) {
        return await this.GetExecutor().Select<T>().WherePk(id).FirstAsync();
    }

    // 根据字符串主键查询单条实体。
    public T FindById(string id) {
        return this.GetExecutor().Select<T>().WherePk(id).First();
    }

    // 异步根据字符串主键查询单条实体。
    public async T FindByIdAsync(string id) {
        return await this.GetExecutor().Select<T>().WherePk(id).FirstAsync();
    }

    // 根据整数主键删除单条记录，返回影响行数。
    public int DeleteById(int id) {
        return this.GetExecutor().Delete<T>().WherePk(id).ExecuteAffrows();
    }

    // 异步根据整数主键删除单条记录，返回影响行数。
    public async int DeleteByIdAsync(int id) {
        return await this.GetExecutor().Delete<T>().WherePk(id).ExecuteAffrowsAsync();
    }

    // 根据 64 位长整数主键删除单条记录，返回影响行数。
    public int DeleteById(long id) {
        return this.GetExecutor().Delete<T>().WherePk(id).ExecuteAffrows();
    }

    // 异步根据 64 位长整数主键删除单条记录，返回影响行数。
    public async int DeleteByIdAsync(long id) {
        return await this.GetExecutor().Delete<T>().WherePk(id).ExecuteAffrowsAsync();
    }

    // 根据字符串主键删除单条记录，返回影响行数。
    public int DeleteById(string id) {
        return this.GetExecutor().Delete<T>().WherePk(id).ExecuteAffrows();
    }

    // 异步根据字符串主键删除单条记录，返回影响行数。
    public async int DeleteByIdAsync(string id) {
        return await this.GetExecutor().Delete<T>().WherePk(id).ExecuteAffrowsAsync();
    }

    // 检查指定主键记录是否存在。
    public bool ExistsById(int id) {
        return this.GetExecutor().Select<T>().WherePk(id).Any();
    }

    // 异步检查指定主键记录是否存在。
    public async bool ExistsByIdAsync(int id) {
        return await this.GetExecutor().Select<T>().WherePk(id).AnyAsync();
    }

    // 分页查询（page 从 1 开始）。
    public List<T> Page(int page, int pageSize) {
        return this.GetExecutor().Select<T>().Page(page, pageSize).ToList();
    }

    // 异步分页查询（page 从 1 开始）。
    public async List<T> PageAsync(int page, int pageSize) {
        return await this.GetExecutor().Select<T>().Page(page, pageSize).ToListAsync();
    }
}
