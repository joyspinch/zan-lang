using System;
using System.Data;
using System.Linq;

namespace System.Data.Orm;

// ZanSql 泛型仓储基类，封装常规同步/异步 CRUD（未绑定 uow 时委托至 zsql）。
public class BaseRepository<T> {
    public IZanSql zsql;
    public IUnitOfWork uow;

    public BaseRepository() {
        this.zsql = ZanSql.Current;
        this.uow = null;
    }

    public BaseRepository(IZanSql zsql) {
        this.zsql = zsql;
        this.uow = null;
    }

    public BaseRepository(IZanSql zsql, IUnitOfWork uow) {
        this.zsql = zsql;
        this.uow = uow;
    }

    public IZanSql Orm { get { return this.zsql; } }

    public IUnitOfWork UnitOfWork {
        get { return this.uow; }
        set { this.uow = value; }
    }

    public IDbExecutor GetExecutor() {
        if (this.uow != null) { return this.uow; }
        return this.zsql;
    }

    public void Attach(IUnitOfWork uow) { this.uow = uow; }
    public void Detach() { this.uow = null; }

    public SelectQuery<T> Select() { return this.GetExecutor().Select<T>(); }
    public SelectQuery<T> Where(Func<T, bool> expr) { return this.Select().Where(expr); }
    public SelectQuery<T> Where(ExprNode expr) { return this.Select().Where(expr); }
    public SelectQuery<T> Where(Expr<T> expr) { return this.Select().Where(expr); }
    public SelectQuery<T> Where(string sql) { return this.Select().Where(sql); }
    public SelectQuery<T> WhereIf(bool condition, Func<T, bool> expr) { return this.Select().WhereIf(condition, expr); }
    public SelectQuery<T> WhereIf(bool condition, string sql) { return this.Select().WhereIf(condition, sql); }
    public SelectQuery<T> WhereConds(List<Cond> cs) { return this.Select().WhereConds(cs); }
    public SelectQuery<T> WhereConds(List<OrmCond> cs) { return this.Select().WhereConds(cs); }

    public SelectQuery<T> OrderBy(Func<T, int> expr) { return this.Select().OrderBy(expr); }
    public SelectQuery<T> OrderBy(Func<T, string> expr) { return this.Select().OrderBy(expr); }
    public SelectQuery<T> OrderBy(string col) { return this.Select().OrderBy(col); }
    public SelectQuery<T> OrderBy(ExprNode expr) { return this.Select().OrderBy(expr); }
    public SelectQuery<T> OrderBy(Expr<T> expr) { return this.Select().OrderBy(expr); }

    public SelectQuery<T> OrderByDescending(Func<T, int> expr) { return this.Select().OrderByDescending(expr); }
    public SelectQuery<T> OrderByDescending(Func<T, string> expr) { return this.Select().OrderByDescending(expr); }
    public SelectQuery<T> OrderByDescending(string col) { return this.Select().OrderByDescending(col); }
    public SelectQuery<T> OrderByDescending(ExprNode expr) { return this.Select().OrderByDescending(expr); }
    public SelectQuery<T> OrderByDescending(Expr<T> expr) { return this.Select().OrderByDescending(expr); }

    public SelectQuery<T> GroupBy(ExprNode expr) { return this.Select().GroupBy(expr); }
    public SelectQuery<T> GroupBy(Expr<T> expr) { return this.Select().GroupBy(expr); }

    public UpdateQuery<T> Update() { return this.GetExecutor().Update<T>(); }
    public UpdateQuery<T> UpdateDml() { return this.Update(); }
    public UpdateQuery<T> UpdateWhere(ExprNode expr) { return this.Update().Where(expr); }
    public UpdateQuery<T> UpdateWhere(Expr<T> expr) { return this.Update().Where(expr); }

    public DeleteQuery<T> Delete() { return this.GetExecutor().Delete<T>(); }
    public DeleteQuery<T> DeleteDml() { return this.Delete(); }
    public DeleteQuery<T> DeleteWhere(ExprNode expr) { return this.Delete().Where(expr); }
    public DeleteQuery<T> DeleteWhere(Expr<T> expr) { return this.Delete().Where(expr); }

    public int Insert(T entity) { return this.GetExecutor().Insert<T>(entity).ExecuteAffrows(); }
    public InsertQuery<T> InsertDml(T entity) { return this.GetExecutor().Insert<T>(entity); }
    public async int InsertAsync(T entity) { return await this.GetExecutor().Insert<T>(entity).ExecuteAffrowsAsync(); }
    public int InsertIdentity(T entity) { return this.GetExecutor().Insert<T>(entity).ExecuteIdentity(); }
    public async int InsertIdentityAsync(T entity) { return await this.GetExecutor().Insert<T>(entity).ExecuteIdentityAsync(); }
    public int InsertBatch(List<T> entities) { return this.GetExecutor().Insert<T>(entities).ExecuteAffrows(); }
    public async int InsertBatchAsync(List<T> entities) { return await this.GetExecutor().Insert<T>(entities).ExecuteAffrowsAsync(); }

    public static List<T> SliceChunk(List<T> entities, int start, int chunkSize) {
        int end = start + chunkSize;
        if (end > entities.Count) { end = entities.Count; }
        List<T> chunk = new List<T>();
        for (int j = start; j < end; j = j + 1) {
            chunk.Add(entities[j]);
        }
        return chunk;
    }

    public int InsertBatchChunked(List<T> entities, int chunkSize = 500) {
        if (entities == null || entities.Count == 0) { return 0; }
        if (chunkSize <= 0) { chunkSize = 500; }
        int totalAff = 0;
        for (int i = 0; i < entities.Count; i = i + chunkSize) {
            totalAff = totalAff + this.InsertBatch(BaseRepository<T>.SliceChunk(entities, i, chunkSize));
        }
        return totalAff;
    }

    public async int InsertBatchChunkedAsync(List<T> entities, int chunkSize = 500) {
        if (entities == null || entities.Count == 0) { return 0; }
        if (chunkSize <= 0) { chunkSize = 500; }
        int totalAff = 0;
        for (int i = 0; i < entities.Count; i = i + chunkSize) {
            totalAff = totalAff + await this.InsertBatchAsync(BaseRepository<T>.SliceChunk(entities, i, chunkSize));
        }
        return totalAff;
    }

    public UpdateQuery<T> Update(T entity) { return this.GetExecutor().Update<T>().SetSource(entity); }
    public async int UpdateAsync(T entity) { return await this.GetExecutor().Update<T>().SetSource(entity).ExecuteAffrowsAsync(); }

    public List<T> ToList() { return this.Select().ToList(); }
    public List<T> SelectAll() { return this.ToList(); }
    public async List<T> ToListAsync() { return await this.Select().ToListAsync(); }
    public async List<T> SelectAllAsync() { return await this.ToListAsync(); }

    public int Count() { return this.Select().Count(); }
    public async int CountAsync() { return await this.Select().CountAsync(); }
    public bool Any() { return this.Select().Any(); }
    public async bool AnyAsync() { return await this.Select().AnyAsync(); }
    public bool Any(ExprNode expr) { return this.Where(expr).Any(); }
    public async bool AnyAsync(ExprNode expr) { return await this.Where(expr).AnyAsync(); }
    public bool Any(Func<T, bool> expr) { return this.Where(expr).Any(); }
    public async bool AnyAsync(Func<T, bool> expr) { return await this.Where(expr).AnyAsync(); }

    public T FindById(int id) { return this.Select().WherePk(id).First(); }
    public async T FindByIdAsync(int id) { return await this.Select().WherePk(id).FirstAsync(); }
    public T FindById(long id) { return this.Select().WherePk(id).First(); }
    public async T FindByIdAsync(long id) { return await this.Select().WherePk(id).FirstAsync(); }
    public T FindById(string id) { return this.Select().WherePk(id).First(); }
    public async T FindByIdAsync(string id) { return await this.Select().WherePk(id).FirstAsync(); }

    public T Read(int id) { return this.FindById(id); }
    public async T ReadAsync(int id) { return await this.FindByIdAsync(id); }
    public T Read(long id) { return this.FindById(id); }
    public async T ReadAsync(long id) { return await this.FindByIdAsync(id); }
    public T Read(string id) { return this.FindById(id); }
    public async T ReadAsync(string id) { return await this.FindByIdAsync(id); }

    public int DeleteById(int id) { return this.Delete().WherePk(id).ExecuteAffrows(); }
    public async int DeleteByIdAsync(int id) { return await this.Delete().WherePk(id).ExecuteAffrowsAsync(); }
    public int DeleteById(long id) { return this.Delete().WherePk(id).ExecuteAffrows(); }
    public async int DeleteByIdAsync(long id) { return await this.Delete().WherePk(id).ExecuteAffrowsAsync(); }
    public int DeleteById(string id) { return this.Delete().WherePk(id).ExecuteAffrows(); }
    public async int DeleteByIdAsync(string id) { return await this.Delete().WherePk(id).ExecuteAffrowsAsync(); }

    public bool ExistsById(int id) { return this.Select().WherePk(id).Any(); }
    public async bool ExistsByIdAsync(int id) { return await this.Select().WherePk(id).AnyAsync(); }
    public bool ExistsById(long id) { return this.Select().WherePk(id).Any(); }
    public async bool ExistsByIdAsync(long id) { return await this.Select().WherePk(id).AnyAsync(); }
    public bool ExistsById(string id) { return this.Select().WherePk(id).Any(); }
    public async bool ExistsByIdAsync(string id) { return await this.Select().WherePk(id).AnyAsync(); }

    public bool Exists(int id) { return this.ExistsById(id); }
    public async bool ExistsAsync(int id) { return await this.ExistsByIdAsync(id); }
    public bool Exists(long id) { return this.ExistsById(id); }
    public async bool ExistsAsync(long id) { return await this.ExistsByIdAsync(id); }
    public bool Exists(string id) { return this.ExistsById(id); }
    public async bool ExistsAsync(string id) { return await this.ExistsByIdAsync(id); }

    public List<T> Page(int page, int pageSize) { return this.Select().Page(page, pageSize).ToList(); }
    public async List<T> PageAsync(int page, int pageSize) { return await this.Select().Page(page, pageSize).ToListAsync(); }
    public PageResult<T> PageResult(int page, int pageSize) { return this.Select().ToPageResult(page, pageSize); }
    public async PageResult<T> PageResultAsync(int page, int pageSize) { return await this.Select().ToPageResultAsync(page, pageSize); }
    public SeekResult<T> SeekPage(long lastCursor, int pageSize, bool asc = true) { return this.Select().ToSeekResult(lastCursor, pageSize, asc); }
    public async SeekResult<T> SeekPageAsync(long lastCursor, int pageSize, bool asc = true) { return await this.Select().ToSeekResultAsync(lastCursor, pageSize, asc); }

    public List<T> FindByIds(List<int> ids) {
        List<T> outp = new List<T>();
        if (ids == null || ids.Count == 0) { return outp; }
        for (int i = 0; i < ids.Count; i = i + 1) {
            T item = this.FindById(ids[i]);
            if (item != null) { outp.Add(item); }
        }
        return outp;
    }

    public async List<T> FindByIdsAsync(List<int> ids) {
        List<T> outp = new List<T>();
        if (ids == null || ids.Count == 0) { return outp; }
        for (int i = 0; i < ids.Count; i = i + 1) {
            T item = await this.FindByIdAsync(ids[i]);
            if (item != null) { outp.Add(item); }
        }
        return outp;
    }

    public int DeleteByIds(List<int> ids) {
        if (ids == null || ids.Count == 0) { return 0; }
        int aff = 0;
        for (int i = 0; i < ids.Count; i = i + 1) {
            aff = aff + this.DeleteById(ids[i]);
        }
        return aff;
    }

    public async int DeleteByIdsAsync(List<int> ids) {
        if (ids == null || ids.Count == 0) { return 0; }
        int aff = 0;
        for (int i = 0; i < ids.Count; i = i + 1) {
            aff = aff + await this.DeleteByIdAsync(ids[i]);
        }
        return aff;
    }

    public List<T> FindByIds(List<long> ids) {
        List<T> outp = new List<T>();
        if (ids == null || ids.Count == 0) { return outp; }
        for (int i = 0; i < ids.Count; i = i + 1) {
            T item = this.FindById(ids[i]);
            if (item != null) { outp.Add(item); }
        }
        return outp;
    }

    public async List<T> FindByIdsAsync(List<long> ids) {
        List<T> outp = new List<T>();
        if (ids == null || ids.Count == 0) { return outp; }
        for (int i = 0; i < ids.Count; i = i + 1) {
            T item = await this.FindByIdAsync(ids[i]);
            if (item != null) { outp.Add(item); }
        }
        return outp;
    }

    public int DeleteByIds(List<long> ids) {
        if (ids == null || ids.Count == 0) { return 0; }
        int aff = 0;
        for (int i = 0; i < ids.Count; i = i + 1) {
            aff = aff + this.DeleteById(ids[i]);
        }
        return aff;
    }

    public async int DeleteByIdsAsync(List<long> ids) {
        if (ids == null || ids.Count == 0) { return 0; }
        int aff = 0;
        for (int i = 0; i < ids.Count; i = i + 1) {
            aff = aff + await this.DeleteByIdAsync(ids[i]);
        }
        return aff;
    }

    public List<T> FindByIds(List<string> ids) {
        List<T> outp = new List<T>();
        if (ids == null || ids.Count == 0) { return outp; }
        for (int i = 0; i < ids.Count; i = i + 1) {
            T item = this.FindById(ids[i]);
            if (item != null) { outp.Add(item); }
        }
        return outp;
    }

    public async List<T> FindByIdsAsync(List<string> ids) {
        List<T> outp = new List<T>();
        if (ids == null || ids.Count == 0) { return outp; }
        for (int i = 0; i < ids.Count; i = i + 1) {
            T item = await this.FindByIdAsync(ids[i]);
            if (item != null) { outp.Add(item); }
        }
        return outp;
    }

    public int DeleteByIds(List<string> ids) {
        if (ids == null || ids.Count == 0) { return 0; }
        int aff = 0;
        for (int i = 0; i < ids.Count; i = i + 1) {
            aff = aff + this.DeleteById(ids[i]);
        }
        return aff;
    }

    public async int DeleteByIdsAsync(List<string> ids) {
        if (ids == null || ids.Count == 0) { return 0; }
        int aff = 0;
        for (int i = 0; i < ids.Count; i = i + 1) {
            aff = aff + await this.DeleteByIdAsync(ids[i]);
        }
        return aff;
    }

    public int UpdateBatch(List<T> entities) {
        if (entities == null || entities.Count == 0) { return 0; }
        int aff = 0;
        for (int i = 0; i < entities.Count; i = i + 1) {
            aff = aff + this.GetExecutor().Update<T>().SetSource(entities[i]).ExecuteAffrows();
        }
        return aff;
    }

    public async int UpdateBatchAsync(List<T> entities) {
        if (entities == null || entities.Count == 0) { return 0; }
        int aff = 0;
        for (int i = 0; i < entities.Count; i = i + 1) {
            aff = aff + await this.UpdateAsync(entities[i]);
        }
        return aff;
    }
}
