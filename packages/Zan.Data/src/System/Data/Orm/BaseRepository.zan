using System;
using System.Data;

namespace System.Data.Orm;

// FreeSql 强类型通用泛型仓储基类。
// 封装实体的全部常规 CRUD 操作，消除各个业务模块中重复书写的样板 DAO 代码。
// 业务仓储只需继承此类，即可直接拥有开箱即用的异步/同步查询与写入能力。
// 用法：
// 核心契约与语义定义。
// }
class BaseRepository<T> {
    IFreeSql fsql;
    IUnitOfWork uow;

    BaseRepository(IFreeSql fsql) {
        this.fsql = fsql;
        this.uow = null;
    }

    BaseRepository(IFreeSql fsql, IUnitOfWork uow) {
        this.fsql = fsql;
        this.uow = uow;
    }

    // 获取当前仓储绑定的 FreeSql 门面。
    IFreeSql Orm { get { return this.fsql; } }

    // 获取或设置工作单元事务。
    IUnitOfWork UnitOfWork {
        get { return this.uow; }
        set { this.uow = value; }
    }

    // 获取当前执行上下文（若存在工作单元则在工作单元内执行）。
    IDbExecutor GetExecutor() {
        if (this.uow != null) { return this.uow; }
        return this.fsql;
    }

    // 绑定工作单元事务。
    void Attach(IUnitOfWork uow) {
        this.uow = uow;
    }

    // 解绑工作单元事务。
    void Detach() {
        this.uow = null;
    }

    // 插入单条实体，返回影响行数。
    int Insert(T entity) {
        return this.GetExecutor().Insert<T>(entity).ExecuteAffrows();
    }

    // 异步插入单条实体，返回影响行数。
    async int InsertAsync(T entity) {
        return await this.GetExecutor().Insert<T>(entity).ExecuteAffrowsAsync();
    }

    // 单条插入并返回自增主键。
    int InsertIdentity(T entity) {
        return this.GetExecutor().Insert<T>(entity).ExecuteIdentity();
    }

    // 异步单条插入并返回自增主键。
    async int InsertIdentityAsync(T entity) {
        return await this.GetExecutor().Insert<T>(entity).ExecuteIdentityAsync();
    }

    // 批量插入实体列表。
    int InsertBatch(List<T> entities) {
        return this.GetExecutor().Insert<T>(entities).ExecuteAffrows();
    }

    // 异步批量插入实体列表。
    async int InsertBatchAsync(List<T> entities) {
        return await this.GetExecutor().Insert<T>(entities).ExecuteAffrowsAsync();
    }

    // 更新实体（按主键更新所有非键字段）。
    int Update(T entity) {
        return this.GetExecutor().Update<T>().SetSource(entity).ExecuteAffrows();
    }

    // 异步更新实体。
    async int UpdateAsync(T entity) {
        return await this.GetExecutor().Update<T>().SetSource(entity).ExecuteAffrowsAsync();
    }

    // 获取全量列表。
    List<T> SelectAll() {
        return this.GetExecutor().Select<T>().ToList();
    }

    // 异步获取全量列表。
    async List<T> SelectAllAsync() {
        return await this.GetExecutor().Select<T>().ToListAsync();
    }

    // 总记录数。
    int Count() {
        return this.GetExecutor().Select<T>().Count();
    }

    // 异步总记录数。
    async int CountAsync() {
        return await this.GetExecutor().Select<T>().CountAsync();
    }
}
