using System;
using System.Data;

namespace System.Data.Orm;

/// <summary>
/// FreeSql CodeFirst 表结构同步契约。
/// 实现 IDbExecutor，天然支持编译期降级的 SyncStructure 泛型语法：
/// fsql.CodeFirst.SyncStructure<T>()
/// </summary>
interface ICodeFirst : IDbExecutor {
    /// <summary>同步单个实体的结构到数据库。</summary>
    void SyncStructure(OrmMeta meta);
    /// <summary>异步同步单个实体的结构到数据库。</summary>
    async void SyncStructureAsync(OrmMeta meta);
}

/// <summary>
/// CodeFirst 结构同步实现类。
/// </summary>
class CodeFirst : ICodeFirst {
    IDbExecutor db;

    CodeFirst(IDbExecutor db) {
        this.db = db;
    }

    void SetExecutor(IDbExecutor db) {
        this.db = db;
    }

    void SyncStructure(OrmMeta meta) {
        if (this.db == null || meta == null) { return; }
        OrmSync.Sync(this.db, meta);
    }

    async void SyncStructureAsync(OrmMeta meta) {
        if (this.db == null || meta == null) { return; }
        await OrmSync.SyncAsync(this.db, meta);
    }

    // IDbExecutor 透传实现
    DbResult Query(string sql, DbParams prms) { return this.db.Query(sql, prms); }
    int Execute(string sql, DbParams prms) { return this.db.Execute(sql, prms); }
    DbResult Query(string sql) { return this.db.Query(sql); }
    int Execute(string sql) { return this.db.Execute(sql); }
    string ExecuteScalar(string sql) { return this.db.ExecuteScalar(sql); }
    string ExecuteScalar(string sql, DbParams prms) { return this.db.ExecuteScalar(sql, prms); }
    int GetProvider() { return this.db.GetProvider(); }

    async DbResult QueryAsync(string sql, DbParams prms) { return await this.db.QueryAsync(sql, prms); }
    async int ExecuteAsync(string sql, DbParams prms) { return await this.db.ExecuteAsync(sql, prms); }
    async DbResult QueryAsync(string sql) { return await this.db.QueryAsync(sql); }
    async int ExecuteAsync(string sql) { return await this.db.ExecuteAsync(sql); }
    async string ExecuteScalarAsync(string sql) { return await this.db.ExecuteScalarAsync(sql); }
    async string ExecuteScalarAsync(string sql, DbParams prms) { return await this.db.ExecuteScalarAsync(sql, prms); }
}
