using System;

namespace System.Data.Orm;

// 事务**保存点**的能力契约（语义见 <see cref="Savepoint"/>）。
//
// 独立成接口而不是直接塞进 IUnitOfWork：保存点只在**事务内**有意义，
// 单列一份，"这个对象能划保存点"这件事在类型上就看得出来；不需要保存点
// 的实现（自建 IUnitOfWork 的代码）也不必被逼着实现六个方法。
//
// 三个动作的语义与 SQL 一致：
// - 建立保存点：之后的写入可以回滚到它。
// - 回滚到保存点：该点之后的写入撤销，**保存点本身仍然活着**（可以再回滚
//   一次，也可以继续在它之后写）。
// - 释放保存点：销毁它，之后不能再回滚到它。
public interface ISavepointScope {
    // 建立一个保存点。名字必须是合法标识符（见 Savepoint.Name）。
    void CreateSavepoint(string name);

    // 回滚到某个保存点。该点之后的写入撤销，保存点本身仍然活着。
    void RollbackToSavepoint(string name);

    // 释放保存点；之后不能再回滚到它。
    void ReleaseSavepoint(string name);

    // 异步版本。
    async bool CreateSavepointAsync(string name);
    async bool RollbackToSavepointAsync(string name);
    async bool ReleaseSavepointAsync(string name);
}
