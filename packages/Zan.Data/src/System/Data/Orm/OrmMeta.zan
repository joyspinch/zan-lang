using System;
using System.Data;
namespace System.Data.Orm;

class OrmMeta {
    string Entity;
    string Table;
    List<OrmCol> Cols;
    List<OrmNav> Navs;
    List<OrmIndex> Idx;
    Dict<string, OrmCol> byCol;
    string selList;
    bool frozen;

    OrmMeta(string entity, string table) {
        this.Entity = entity;
        this.Table = QueryBuilder.RequireIdent(table);
        this.Cols = new List<OrmCol>();
        this.Navs = new List<OrmNav>();
        this.Idx = new List<OrmIndex>();
        this.byCol = new Dict<string, OrmCol>();
        this.selList = "";
        this.frozen = false;
    }

    // 新建一个实体的元数据。
    static OrmMeta Of(string entity, string table) {
        return new OrmMeta(entity, table);
    }

    // 封存元数据：<see cref="Seal"/> 之后的构建调用一律
    // 抛异常。生成的代码在元数据建成并发布到静态缓存前调用它，
    // 保证运行期描述不会被后续代码悄悄改形。
    OrmMeta Seal() {
        this.frozen = true;
        return this;
    }

    // 封存后的构建调用统一经此拒绝。
    void CheckNotFrozen() {
        if (this.frozen) {
            throw new Exception(this.Entity
                + " metadata is sealed; Col/Nav/Index are build-time only");
        }
    }

    // 追加一列（按实体字段声明顺序）。
    OrmMeta Col(string col, string field, int kind, bool i64, bool pk,
                bool ident, bool notNull, int len) {
        this.CheckNotFrozen();
        OrmCol c = new OrmCol(QueryBuilder.RequireIdent(col), field, kind,
                              i64, pk, ident, notNull, len);
        this.Cols.Add(c);
        this.byCol.Add(col, c);
        return this;
    }

    // 追加一个导航字段，返回它以便继续追加它的列。
    OrmNav Nav(string field, string table) {
        this.CheckNotFrozen();
        OrmNav n = new OrmNav(field, table);
        this.Navs.Add(n);
        return n;
    }

    // 追加一条索引声明。
    OrmMeta Index(string name, string cols, bool uniq) {
        this.CheckNotFrozen();
        QueryBuilder.RequireIdent(name);
        List<string> parts = cols.Split(",");
        for (int i = 0; i < parts.Count; i = i + 1) {
            QueryBuilder.RequireIdent(parts[i].Trim());
        }
        this.Idx.Add(new OrmIndex(name, cols, uniq));
        return this;
    }

    // 列描述，不存在时为 null。
    OrmCol Find(string c) {
        OrmCol v;
        if (this.byCol.TryGetValue(c, out v)) { return v; }
        return null;
    }

    // 列是否属于本实体。
    bool Has(string c) { return this.Find(c) != null; }

    // 列的声明类型（DbParams.Kind*），不存在时 KindNull。
    int KindOf(string c) {
        OrmCol f = this.Find(c);
        if (f == null) { return DbParams.KindNull; }
        return f.PKind();
    }

    // 校验列名属于本实体，动态列集合的唯一入口。
    string Require(string c) {
        string n = c;
        if (n.Length > 2 && n.IndexOf("t.") == 0) { n = n.Substring(2); }
        if (!this.Has(n)) {
            throw new Exception(this.Entity + " has no column: " + c);
        }
        return n;
    }

    // `t.a, t.b` —— 实体自身列的 SELECT 片段（缓存）。
    string SelectList() {
        if (this.selList.Length > 0) { return this.selList; }
        lock (this) {
            if (this.selList.Length > 0) { return this.selList; }
            StringBuilder sb = new StringBuilder();
            for (int i = 0; i < this.Cols.Count; i = i + 1) {
                if (i > 0) { sb.Append(", "); }
                sb.Append("t." + this.Cols[i].Col);
            }
            this.selList = sb.ToString();
            return this.selList;
        }
    }

    // 主键列名（声明顺序）。
    List<string> PkCols() {
        List<string> k = new List<string>();
        for (int i = 0; i < this.Cols.Count; i = i + 1) {
            if (this.Cols[i].IsPk) { k.Add(this.Cols[i].Col); }
        }
        return k;
    }

    // UPDATE ... WHERE 用的定位列：最后一个主键列，
    // 没有主键时为 null（与实体链的既有语义一致）。
    OrmCol PkCol() {
        OrmCol pk = null;
        for (int i = 0; i < this.Cols.Count; i = i + 1) {
            if (this.Cols[i].IsPk) { pk = this.Cols[i]; }
        }
        return pk;
    }

    // 复合主键的表级约束列清单（两列及以上才有；
    // identity 列自带 PRIMARY KEY，不参与）。
    string PkList() {
        StringBuilder sb = new StringBuilder();
        int n = 0;
        for (int i = 0; i < this.Cols.Count; i = i + 1) {
            OrmCol c = this.Cols[i];
            if (!c.IsPk || c.IsIdent) { continue; }
            if (n > 0) { sb.Append(", "); }
            sb.Append(c.Col);
            n = n + 1;
        }
        if (n < 2) { return ""; }
        return sb.ToString();
    }

}
