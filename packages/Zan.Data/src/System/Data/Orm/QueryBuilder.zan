using System;
using System.Text;
using System.Data;
namespace System.Data.Orm;

public class QueryBuilder {
    public string tableName;
    public string whereClause;
    public string orderByClause;
    public string groupByClause;
    public string havingClause;
    public string joinClause;
    public int limitVal;
    public int offsetVal;
    public int dialect;
    public List<SetClause> sets;
    public bool distinct;

    public DbParams whereParams;

    public QueryBuilder(string table) {
        this.tableName = QueryBuilder.RequireIdent(table);
        this.whereClause = "";
        this.orderByClause = "";
        this.groupByClause = "";
        this.havingClause = "";
        this.joinClause = "";
        this.limitVal = -1;
        this.offsetVal = -1;
        this.dialect = SqlDialect.Standard;
        this.sets = new List<SetClause>();
        this.distinct = false;
        this.whereParams = new DbParams();
    }

    public int Provider() {
        if (this.dialect == SqlDialect.SqlServer) { return DbProvider.SqlServer; }
        if (this.dialect == SqlDialect.Oracle) { return DbProvider.Oracle; }
        return DbProvider.SQLite;
    }

    public string Quote(string ident) {
        return Dialect.QuoteIdentifier(this.Provider(), QueryBuilder.RequireIdent(ident));
    }

    // 校验 SQL 标识符：[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)*
    public static bool IsIdent(string s) {
        if (s == null) { return false; }
        int n = s.Length;
        if (n == 0) { return false; }
        int c0 = s[0] & 255;
        if (!((c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122) || c0 == 95)) { return false; }
        bool prevDot = false;
        for (int i = 1; i < n; i = i + 1) {
            int c = s[i] & 255;
            if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95) {
                prevDot = false;
            } else if (c == 46) {
                if (prevDot || i == n - 1) { return false; }
                prevDot = true;
            } else {
                return false;
            }
        }
        return true;
    }

    public static string RequireIdent(string s) {
        if (!QueryBuilder.IsIdent(s)) { throw new Exception("unsafe SQL identifier: " + s); }
        return s;
    }

    // 对已通过 IsIdent 校验的标识符计算方言引号包装后的精确字节数并直接写入缓冲（零中间字符串）。
    private int OpenQuoteByte() {
        return this.dialect == SqlDialect.SqlServer ? 91 : 34;
    }

    private int CloseQuoteByte() {
        return this.dialect == SqlDialect.SqlServer ? 93 : 34;
    }

    private static int ValidatedQuotedLen(string ident) {
        int n = ident.Length;
        nint ip = (nint)ident;
        int dots = 0;
        int pos = NativeMemory.Find(ip, 0, 46, n);
        while (pos >= 0) {
            dots = dots + 1;
            int next = pos + 1;
            pos = next < n ? NativeMemory.Find(ip, next, 46, n - next) : -1;
        }
        return n + (dots + 1) * 2;
    }

    private static int WriteValidatedQuoted(string ident, byte[] bspan, nint bp, int dst, int openCh, int closeCh) {
        int n = ident.Length;
        nint ip = (nint)ident;
        int start = 0;
        int dot = NativeMemory.Find(ip, 0, 46, n);
        if (dot < 0) {
            bspan[dst] = (byte)openCh;
            NativeMemory.Copy(bp + (nint)(dst + 1), ip, n);
            bspan[dst + 1 + n] = (byte)closeCh;
            return dst + n + 2;
        }
        while (true) {
            int segEnd = dot >= 0 ? dot : n;
            int segLen = segEnd - start;
            bspan[dst] = (byte)openCh;
            NativeMemory.Copy(bp + (nint)(dst + 1), ip + (nint)start, segLen);
            bspan[dst + 1 + segLen] = (byte)closeCh;
            dst = dst + segLen + 2;
            if (dot < 0) { break; }
            bspan[dst] = (byte)46;
            dst = dst + 1;
            start = dot + 1;
            dot = start < n ? NativeMemory.Find(ip, start, 46, n - start) : -1;
        }
        return dst;
    }

    private static int IntDecLen(int v) {
        if (v == 0) { return 1; }
        int len = 0;
        if (v < 0) {
            len = 1;
            if (v == -2147483647 - 1) { return 11; }
            v = -v;
        }
        while (v > 0) { len = len + 1; v = v / 10; }
        return len;
    }

    private static int WriteIntDec(byte[] buf, int pos, int v) {
        if (v == 0) { buf[pos] = (byte)48; return pos + 1; }
        if (v == -2147483647 - 1) {
            string ms = "-2147483648";
            for (int i = 0; i < 11; i = i + 1) { buf[pos + i] = (byte)(ms[i] & 255); }
            return pos + 11;
        }
        if (v < 0) { buf[pos] = (byte)45; pos = pos + 1; v = -v; }
        int start = pos;
        while (v > 0) {
            int q = v / 10;
            buf[pos] = (byte)(48 + (v - q * 10));
            pos = pos + 1;
            v = q;
        }
        int l = start;
        int r = pos - 1;
        while (l < r) {
            byte tmp = buf[l];
            buf[l] = buf[r];
            buf[r] = tmp;
            l = l + 1;
            r = r - 1;
        }
        return pos;
    }

    // 校验 DDL 列类型文本，拒绝分号与注释符等注入通道。
    public static string RequireDdlType(string s) {
        int n = s.Length;
        if (n == 0) { throw new Exception("unsafe SQL column type: empty"); }
        for (int i = 0; i < n; i = i + 1) {
            int c = s[i] & 255;
            bool ok = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
                || (c >= 48 && c <= 57) || c == 32 || c == 40 || c == 41
                || c == 44 || c == 39 || c == 46;
            if (!ok) { throw new Exception("unsafe SQL column type: " + s); }
        }
        return s;
    }

    public static QueryBuilder From(string table) { return new QueryBuilder(table); }
    public static QueryBuilder InsertInto(string table) { return new QueryBuilder(table); }
    public static QueryBuilder Update(string table) { return new QueryBuilder(table); }
    public static QueryBuilder DeleteFrom(string table) { return new QueryBuilder(table); }

    public QueryBuilder Where(string condition) {
        int wl = this.whereClause.Length;
        if (wl == 0) {
            this.whereClause = condition;
            return this;
        }
        int cl = condition.Length;
        int total = wl + 5 + cl;
        byte[] buf = new byte[total];
        nint bp = (nint)buf;
        NativeMemory.Copy(bp, (nint)this.whereClause, wl);
        NativeMemory.Copy(bp + (nint)wl, (nint)" AND ", 5);
        if (cl > 0) { NativeMemory.Copy(bp + (nint)(wl + 5), (nint)condition, cl); }
        this.whereClause = NativeMemory.GetString(bp, 0, total);
        return this;
    }

    public QueryBuilder OrWhere(string condition) {
        int wl = this.whereClause.Length;
        if (wl == 0) {
            this.whereClause = condition;
            return this;
        }
        int cl = condition.Length;
        int total = wl + 4 + cl;
        byte[] buf = new byte[total];
        nint bp = (nint)buf;
        NativeMemory.Copy(bp, (nint)this.whereClause, wl);
        NativeMemory.Copy(bp + (nint)wl, (nint)" OR ", 4);
        if (cl > 0) { NativeMemory.Copy(bp + (nint)(wl + 4), (nint)condition, cl); }
        this.whereClause = NativeMemory.GetString(bp, 0, total);
        return this;
    }

    // 单缓冲直拼 "<oldWhere>[ AND ]<quotedCol><op>"（零 Quote / 中间拼接分配）。
    private QueryBuilder AppendWhereQuotedOp(string column, string op) {
        QueryBuilder.RequireIdent(column);
        int wl = this.whereClause.Length;
        int sepLen = wl > 0 ? 5 : 0;
        int qLen = QueryBuilder.ValidatedQuotedLen(column);
        int opLen = op.Length;
        int total = wl + sepLen + qLen + opLen;
        byte[] buf = new byte[total];
        nint bp = (nint)buf;
        byte[] bspan = buf;
        int p = 0;
        if (wl > 0) {
            NativeMemory.Copy(bp, (nint)this.whereClause, wl);
            NativeMemory.Copy(bp + (nint)wl, (nint)" AND ", 5);
            p = wl + 5;
        }
        p = QueryBuilder.WriteValidatedQuoted(column, bspan, bp, p, this.OpenQuoteByte(), this.CloseQuoteByte());
        if (opLen > 0) { NativeMemory.Copy(bp + (nint)p, (nint)op, opLen); }
        this.whereClause = NativeMemory.GetString(bp, 0, total);
        return this;
    }

    private QueryBuilder AppendCmpStr(string column, string op, string val) {
        QueryBuilder.RequireIdent(column);
        this.whereParams.Add(val);
        return this.AppendWhereQuotedOp(column, op);
    }

    private QueryBuilder AppendCmpInt(string column, string op, int val) {
        QueryBuilder.RequireIdent(column);
        this.whereParams.AddInt(val);
        return this.AppendWhereQuotedOp(column, op);
    }

    private QueryBuilder AppendCmpLong(string column, string op, long val) {
        QueryBuilder.RequireIdent(column);
        this.whereParams.AddLong(val);
        return this.AppendWhereQuotedOp(column, op);
    }

    public QueryBuilder WhereEq(string column, string val) { return this.AppendCmpStr(column, " = ?", val); }
    public QueryBuilder WhereEqInt(string column, int val) { return this.AppendCmpInt(column, " = ?", val); }
    public QueryBuilder WhereEqLong(string column, long val) { return this.AppendCmpLong(column, " = ?", val); }
    public QueryBuilder WhereGeLong(string column, long val) { return this.AppendCmpLong(column, " >= ?", val); }
    public QueryBuilder WhereLeLong(string column, long val) { return this.AppendCmpLong(column, " <= ?", val); }

    public QueryBuilder WhereValueAt(DbValues vals, int i) {
        string col = vals.NameAt(i);
        QueryBuilder.RequireIdent(col);
        vals.BindTo(this.whereParams, i);
        return this.AppendWhereQuotedOp(col, " = ?");
    }

    private QueryBuilder AppendWhereIn(string column, string op, int count) {
        QueryBuilder.RequireIdent(column);
        int wl = this.whereClause.Length;
        int sepLen = wl > 0 ? 5 : 0;
        int qLen = QueryBuilder.ValidatedQuotedLen(column);
        int opLen = op.Length;
        int marksLen = count == 0 ? 4 : (count * 3 - 2);
        int total = wl + sepLen + qLen + opLen + marksLen + 1;
        byte[] buf = new byte[total];
        nint bp = (nint)buf;
        byte[] bspan = buf;
        int p = 0;
        if (wl > 0) {
            NativeMemory.Copy(bp, (nint)this.whereClause, wl);
            NativeMemory.Copy(bp + (nint)wl, (nint)" AND ", 5);
            p = wl + 5;
        }
        p = QueryBuilder.WriteValidatedQuoted(column, bspan, bp, p, this.OpenQuoteByte(), this.CloseQuoteByte());
        NativeMemory.Copy(bp + (nint)p, (nint)op, opLen);
        p = p + opLen;
        if (count == 0) {
            NativeMemory.Copy(bp + (nint)p, (nint)"NULL", 4);
            p = p + 4;
        } else {
            bspan[p] = (byte)63;
            p = p + 1;
            for (int i = 1; i < count; i = i + 1) {
                bspan[p] = (byte)44;
                bspan[p + 1] = (byte)32;
                bspan[p + 2] = (byte)63;
                p = p + 3;
            }
        }
        bspan[p] = (byte)41;
        this.whereClause = NativeMemory.GetString(bp, 0, total);
        return this;
    }

    public QueryBuilder WhereIn(string column, List<string> values) {
        QueryBuilder.RequireIdent(column);
        int n = values != null ? values.Count : 0;
        for (int i = 0; i < n; i = i + 1) { this.whereParams.Add(values[i]); }
        return this.AppendWhereIn(column, " IN (", n);
    }

    // 空列表生成 IN (NULL) 恒假；避免非法 IN ()。
    public QueryBuilder WhereInInts(string column, List<int> values) {
        QueryBuilder.RequireIdent(column);
        int n = values != null ? values.Count : 0;
        for (int i = 0; i < n; i = i + 1) { this.whereParams.AddInt(values[i]); }
        return this.AppendWhereIn(column, " IN (", n);
    }

    public QueryBuilder WhereInLongs(string column, List<long> values) {
        QueryBuilder.RequireIdent(column);
        int n = values != null ? values.Count : 0;
        for (int i = 0; i < n; i = i + 1) { this.whereParams.AddLong(values[i]); }
        return this.AppendWhereIn(column, " IN (", n);
    }

    public QueryBuilder WhereNotIn(string column, List<string> values) {
        QueryBuilder.RequireIdent(column);
        int n = values != null ? values.Count : 0;
        if (n == 0) { return this; }
        for (int i = 0; i < n; i = i + 1) { this.whereParams.Add(values[i]); }
        return this.AppendWhereIn(column, " NOT IN (", n);
    }

    public QueryBuilder WhereLike(string column, string pattern) { return this.AppendCmpStr(column, " LIKE ?", pattern); }
    public QueryBuilder WhereNotLike(string column, string pattern) { return this.AppendCmpStr(column, " NOT LIKE ?", pattern); }
    public QueryBuilder WhereContains(string column, string val) { return this.WhereLike(column, "%" + val + "%"); }
    public QueryBuilder WhereStartsWith(string column, string val) { return this.WhereLike(column, val + "%"); }
    public QueryBuilder WhereEndsWith(string column, string val) { return this.WhereLike(column, "%" + val); }

    public QueryBuilder WhereAnyLike(List<string> columns, string val) {
        int n = columns.Count;
        if (n == 0) { return this; }
        int wl = this.whereClause.Length;
        int sepLen = wl > 0 ? 5 : 0;
        int total = wl + sepLen + 2 + (n - 1) * 4 + n * 7; // "(" + ... + ")" + " OR "*(n-1) + " LIKE ?"*n
        for (int i = 0; i < n; i = i + 1) {
            string col = QueryBuilder.RequireIdent(columns[i]);
            total = total + QueryBuilder.ValidatedQuotedLen(col);
        }
        string pat = "%" + val + "%";
        byte[] buf = new byte[total];
        nint bp = (nint)buf;
        byte[] bspan = buf;
        int p = 0;
        if (wl > 0) {
            NativeMemory.Copy(bp, (nint)this.whereClause, wl);
            NativeMemory.Copy(bp + (nint)wl, (nint)" AND ", 5);
            p = wl + 5;
        }
        int openCh = this.OpenQuoteByte();
        int closeCh = this.CloseQuoteByte();
        bspan[p] = (byte)40; p = p + 1;
        for (int i = 0; i < n; i = i + 1) {
            if (i > 0) {
                NativeMemory.Copy(bp + (nint)p, (nint)" OR ", 4);
                p = p + 4;
            }
            p = QueryBuilder.WriteValidatedQuoted(columns[i], bspan, bp, p, openCh, closeCh);
            NativeMemory.Copy(bp + (nint)p, (nint)" LIKE ?", 7);
            p = p + 7;
            this.whereParams.Add(pat);
        }
        bspan[p] = (byte)41;
        this.whereClause = NativeMemory.GetString(bp, 0, total);
        return this;
    }

    public QueryBuilder WhereNe(string column, string val) { return this.AppendCmpStr(column, " <> ?", val); }
    public QueryBuilder WhereNeInt(string column, int val) { return this.AppendCmpInt(column, " <> ?", val); }
    public QueryBuilder WhereGtInt(string column, int val) { return this.AppendCmpInt(column, " > ?", val); }
    public QueryBuilder WhereGeInt(string column, int val) { return this.AppendCmpInt(column, " >= ?", val); }
    public QueryBuilder WhereLtInt(string column, int val) { return this.AppendCmpInt(column, " < ?", val); }
    public QueryBuilder WhereLeInt(string column, int val) { return this.AppendCmpInt(column, " <= ?", val); }

    public QueryBuilder WhereBetween(string column, string low, string high) {
        QueryBuilder.RequireIdent(column);
        this.whereParams.Add(low);
        this.whereParams.Add(high);
        return this.AppendWhereQuotedOp(column, " BETWEEN ? AND ?");
    }

    public QueryBuilder WhereNull(string column) { return this.AppendWhereQuotedOp(column, " IS NULL"); }
    public QueryBuilder WhereNotNull(string column) { return this.AppendWhereQuotedOp(column, " IS NOT NULL"); }

    public QueryBuilder OrderBy(string column) {
        this.orderByClause = QueryBuilder.RequireIdent(column);
        return this;
    }

    public QueryBuilder OrderByDesc(string column) {
        this.orderByClause = QueryBuilder.RequireIdent(column) + " DESC";
        return this;
    }

    public static void CheckAllowed(string column, List<string> allowed) {
        if (allowed != null) {
            for (int i = 0; i < allowed.Count; i = i + 1) {
                if (allowed[i] == column) { return; }
            }
        }
        throw new Exception("column not in allowed list: " + column);
    }

    // 排序列无法参数化：来自用户输入的列必须经白名单校验以防布尔预言机泄密。
    public QueryBuilder OrderBySafe(string column, List<string> allowed) {
        QueryBuilder.CheckAllowed(column, allowed);
        return this.OrderBy(column);
    }

    public QueryBuilder OrderBySafeDesc(string column, List<string> allowed) {
        QueryBuilder.CheckAllowed(column, allowed);
        return this.OrderByDesc(column);
    }

    public QueryBuilder GroupBy(string column) {
        this.groupByClause = QueryBuilder.RequireIdent(column);
        return this;
    }

    public QueryBuilder Having(string condition) {
        this.havingClause = condition;
        return this;
    }

    private QueryBuilder AddJoin(string keyword, string table, string on) {
        string t = QueryBuilder.RequireIdent(table);
        int jl = this.joinClause.Length;
        int kl = keyword.Length;
        int tl = t.Length;
        int ol = on.Length;
        int total = jl + kl + tl + 4 + ol;
        byte[] buf = new byte[total];
        nint bp = (nint)buf;
        int p = 0;
        if (jl > 0) { NativeMemory.Copy(bp + (nint)p, (nint)this.joinClause, jl); p = p + jl; }
        NativeMemory.Copy(bp + (nint)p, (nint)keyword, kl); p = p + kl;
        NativeMemory.Copy(bp + (nint)p, (nint)t, tl); p = p + tl;
        NativeMemory.Copy(bp + (nint)p, (nint)" ON ", 4); p = p + 4;
        if (ol > 0) { NativeMemory.Copy(bp + (nint)p, (nint)on, ol); }
        this.joinClause = NativeMemory.GetString(bp, 0, total);
        return this;
    }

    public QueryBuilder Join(string table, string on) { return this.AddJoin(" JOIN ", table, on); }
    public QueryBuilder LeftJoin(string table, string on) { return this.AddJoin(" LEFT JOIN ", table, on); }
    public QueryBuilder RightJoin(string table, string on) { return this.AddJoin(" RIGHT JOIN ", table, on); }

    public QueryBuilder Limit(int count) { this.limitVal = count; return this; }
    public QueryBuilder Offset(int count) { this.offsetVal = count; return this; }
    public QueryBuilder Dialect(int d) { this.dialect = d; return this; }
    public QueryBuilder Distinct() { this.distinct = true; return this; }

    public QueryBuilder Set(string column, string val) {
        this.sets.Add(new SetClause(QueryBuilder.RequireIdent(column), val));
        return this;
    }

    public QueryBuilder SetParam(string column) { return this.Set(column, ""); }
    public QueryBuilder SetInt(string column, int val) { return this.Set(column, Convert.ToString(val)); }

    public void AppendClauses(StringBuilder sb) {
        if (this.joinClause.Length > 0) { sb.Append(this.joinClause); }
        if (this.whereClause.Length > 0) { sb.Append(" WHERE "); sb.Append(this.whereClause); }
        if (this.groupByClause.Length > 0) { sb.Append(" GROUP BY "); sb.Append(this.groupByClause); }
        if (this.havingClause.Length > 0) { sb.Append(" HAVING "); sb.Append(this.havingClause); }
        if (this.orderByClause.Length > 0) { sb.Append(" ORDER BY "); sb.Append(this.orderByClause); }
        if (this.dialect == SqlDialect.Standard) {
            if (this.limitVal >= 0) { sb.Append(" LIMIT "); sb.Append(Convert.ToString(this.limitVal)); }
            if (this.offsetVal >= 0) { sb.Append(" OFFSET "); sb.Append(Convert.ToString(this.offsetVal)); }
        } else if (this.offsetVal >= 0 || this.limitVal >= 0) {
            int off = this.offsetVal < 0 ? 0 : this.offsetVal;
            sb.Append(" OFFSET ");
            sb.Append(Convert.ToString(off));
            sb.Append(" ROWS");
            if (this.limitVal >= 0) {
                sb.Append(" FETCH NEXT ");
                sb.Append(Convert.ToString(this.limitVal));
                sb.Append(" ROWS ONLY");
            }
        }
    }

    public string BuildSelectParams(string columns) {
        string tbl = QueryBuilder.RequireIdent(this.tableName);
        int total = 7 + (this.distinct ? 9 : 0) + columns.Length + 6 + QueryBuilder.ValidatedQuotedLen(tbl);
        if (this.joinClause.Length > 0) { total = total + this.joinClause.Length; }
        if (this.whereClause.Length > 0) { total = total + 7 + this.whereClause.Length; }
        if (this.groupByClause.Length > 0) { total = total + 10 + this.groupByClause.Length; }
        if (this.havingClause.Length > 0) { total = total + 8 + this.havingClause.Length; }
        if (this.orderByClause.Length > 0) { total = total + 10 + this.orderByClause.Length; }
        int off = this.offsetVal < 0 ? 0 : this.offsetVal;
        if (this.dialect == SqlDialect.Standard) {
            if (this.limitVal >= 0) { total = total + 7 + QueryBuilder.IntDecLen(this.limitVal); }
            if (this.offsetVal >= 0) { total = total + 8 + QueryBuilder.IntDecLen(this.offsetVal); }
        } else if (this.offsetVal >= 0 || this.limitVal >= 0) {
            total = total + 8 + QueryBuilder.IntDecLen(off) + 5;
            if (this.limitVal >= 0) { total = total + 12 + QueryBuilder.IntDecLen(this.limitVal) + 10; }
        }

        byte[] buf = new byte[total];
        nint bp = (nint)buf;
        byte[] bspan = buf;
        int p = 0;
        NativeMemory.Copy(bp + (nint)p, (nint)"SELECT ", 7); p = p + 7;
        if (this.distinct) { NativeMemory.Copy(bp + (nint)p, (nint)"DISTINCT ", 9); p = p + 9; }
        if (columns.Length > 0) { NativeMemory.Copy(bp + (nint)p, (nint)columns, columns.Length); p = p + columns.Length; }
        NativeMemory.Copy(bp + (nint)p, (nint)" FROM ", 6); p = p + 6;
        p = QueryBuilder.WriteValidatedQuoted(tbl, bspan, bp, p, this.OpenQuoteByte(), this.CloseQuoteByte());

        if (this.joinClause.Length > 0) { NativeMemory.Copy(bp + (nint)p, (nint)this.joinClause, this.joinClause.Length); p = p + this.joinClause.Length; }
        if (this.whereClause.Length > 0) {
            NativeMemory.Copy(bp + (nint)p, (nint)" WHERE ", 7); p = p + 7;
            NativeMemory.Copy(bp + (nint)p, (nint)this.whereClause, this.whereClause.Length); p = p + this.whereClause.Length;
        }
        if (this.groupByClause.Length > 0) {
            NativeMemory.Copy(bp + (nint)p, (nint)" GROUP BY ", 10); p = p + 10;
            NativeMemory.Copy(bp + (nint)p, (nint)this.groupByClause, this.groupByClause.Length); p = p + this.groupByClause.Length;
        }
        if (this.havingClause.Length > 0) {
            NativeMemory.Copy(bp + (nint)p, (nint)" HAVING ", 8); p = p + 8;
            NativeMemory.Copy(bp + (nint)p, (nint)this.havingClause, this.havingClause.Length); p = p + this.havingClause.Length;
        }
        if (this.orderByClause.Length > 0) {
            NativeMemory.Copy(bp + (nint)p, (nint)" ORDER BY ", 10); p = p + 10;
            NativeMemory.Copy(bp + (nint)p, (nint)this.orderByClause, this.orderByClause.Length); p = p + this.orderByClause.Length;
        }
        if (this.dialect == SqlDialect.Standard) {
            if (this.limitVal >= 0) {
                NativeMemory.Copy(bp + (nint)p, (nint)" LIMIT ", 7); p = p + 7;
                p = QueryBuilder.WriteIntDec(bspan, p, this.limitVal);
            }
            if (this.offsetVal >= 0) {
                NativeMemory.Copy(bp + (nint)p, (nint)" OFFSET ", 8); p = p + 8;
                p = QueryBuilder.WriteIntDec(bspan, p, this.offsetVal);
            }
        } else if (this.offsetVal >= 0 || this.limitVal >= 0) {
            NativeMemory.Copy(bp + (nint)p, (nint)" OFFSET ", 8); p = p + 8;
            p = QueryBuilder.WriteIntDec(bspan, p, off);
            NativeMemory.Copy(bp + (nint)p, (nint)" ROWS", 5); p = p + 5;
            if (this.limitVal >= 0) {
                NativeMemory.Copy(bp + (nint)p, (nint)" FETCH NEXT ", 12); p = p + 12;
                p = QueryBuilder.WriteIntDec(bspan, p, this.limitVal);
                NativeMemory.Copy(bp + (nint)p, (nint)" ROWS ONLY", 10); p = p + 10;
            }
        }
        return NativeMemory.GetString(bp, 0, total);
    }

    public DbParams SelectParams() { return this.whereParams; }

    public string BuildInsertParams() {
        string tbl = QueryBuilder.RequireIdent(this.tableName);
        int sn = this.sets.Count;
        int total = 12 + QueryBuilder.ValidatedQuotedLen(tbl) + 2 + 10 + 1; // "INSERT INTO " + tbl + " (" + ") VALUES (" + ")"
        if (sn > 0) {
            total = total + (sn - 1) * 2 + (sn * 3 - 2);
            for (int i = 0; i < sn; i = i + 1) {
                string col = QueryBuilder.RequireIdent(this.sets[i].column);
                total = total + QueryBuilder.ValidatedQuotedLen(col);
            }
        }
        byte[] buf = new byte[total];
        nint bp = (nint)buf;
        byte[] bspan = buf;
        int openCh = this.OpenQuoteByte();
        int closeCh = this.CloseQuoteByte();
        int p = 0;
        NativeMemory.Copy(bp + (nint)p, (nint)"INSERT INTO ", 12); p = p + 12;
        p = QueryBuilder.WriteValidatedQuoted(tbl, bspan, bp, p, openCh, closeCh);
        bspan[p] = (byte)32; bspan[p + 1] = (byte)40; p = p + 2;
        for (int i = 0; i < sn; i = i + 1) {
            if (i > 0) { bspan[p] = (byte)44; bspan[p + 1] = (byte)32; p = p + 2; }
            p = QueryBuilder.WriteValidatedQuoted(this.sets[i].column, bspan, bp, p, openCh, closeCh);
        }
        NativeMemory.Copy(bp + (nint)p, (nint)") VALUES (", 10); p = p + 10;
        if (sn > 0) {
            bspan[p] = (byte)63; p = p + 1;
            for (int i = 1; i < sn; i = i + 1) {
                bspan[p] = (byte)44; bspan[p + 1] = (byte)32; bspan[p + 2] = (byte)63; p = p + 3;
            }
        }
        bspan[p] = (byte)41;
        return NativeMemory.GetString(bp, 0, total);
    }

    public DbParams InsertParams() {
        DbParams p = new DbParams();
        foreach (SetClause s in this.sets) { p.Add(s.val); }
        return p;
    }

    public string BuildUpdateParams() {
        string tbl = QueryBuilder.RequireIdent(this.tableName);
        int sn = this.sets.Count;
        int total = 7 + QueryBuilder.ValidatedQuotedLen(tbl) + 5; // "UPDATE " + tbl + " SET "
        if (sn > 0) {
            total = total + (sn - 1) * 2 + sn * 4; // ", "*(sn-1) + " = ?"*sn
            for (int i = 0; i < sn; i = i + 1) {
                string col = QueryBuilder.RequireIdent(this.sets[i].column);
                total = total + QueryBuilder.ValidatedQuotedLen(col);
            }
        }
        if (this.whereClause.Length > 0) { total = total + 7 + this.whereClause.Length; }
        byte[] buf = new byte[total];
        nint bp = (nint)buf;
        byte[] bspan = buf;
        int openCh = this.OpenQuoteByte();
        int closeCh = this.CloseQuoteByte();
        int p = 0;
        NativeMemory.Copy(bp + (nint)p, (nint)"UPDATE ", 7); p = p + 7;
        p = QueryBuilder.WriteValidatedQuoted(tbl, bspan, bp, p, openCh, closeCh);
        NativeMemory.Copy(bp + (nint)p, (nint)" SET ", 5); p = p + 5;
        for (int i = 0; i < sn; i = i + 1) {
            if (i > 0) { bspan[p] = (byte)44; bspan[p + 1] = (byte)32; p = p + 2; }
            p = QueryBuilder.WriteValidatedQuoted(this.sets[i].column, bspan, bp, p, openCh, closeCh);
            NativeMemory.Copy(bp + (nint)p, (nint)" = ?", 4); p = p + 4;
        }
        if (this.whereClause.Length > 0) {
            NativeMemory.Copy(bp + (nint)p, (nint)" WHERE ", 7); p = p + 7;
            NativeMemory.Copy(bp + (nint)p, (nint)this.whereClause, this.whereClause.Length);
        }
        return NativeMemory.GetString(bp, 0, total);
    }

    public DbParams UpdateParams() {
        DbParams p = new DbParams();
        foreach (SetClause s in this.sets) { p.Add(s.val); }
        int wn = this.whereParams.Count();
        for (int i = 0; i < wn; i = i + 1) {
            int k = this.whereParams.KindAt(i);
            if (k == 1) { p.AddLong(this.whereParams.IntAt(i)); }
            else if (k == 2) { p.AddDouble(this.whereParams.DoubleAt(i)); }
            else if (k == 3) { p.Add(this.whereParams.TextAt(i)); }
            else { p.AddNull(); }
        }
        return p;
    }

    public string BuildDeleteParams() {
        string tbl = QueryBuilder.RequireIdent(this.tableName);
        int total = 12 + QueryBuilder.ValidatedQuotedLen(tbl);
        if (this.whereClause.Length > 0) { total = total + 7 + this.whereClause.Length; }
        byte[] buf = new byte[total];
        nint bp = (nint)buf;
        byte[] bspan = buf;
        int p = 0;
        NativeMemory.Copy(bp + (nint)p, (nint)"DELETE FROM ", 12); p = p + 12;
        p = QueryBuilder.WriteValidatedQuoted(tbl, bspan, bp, p, this.OpenQuoteByte(), this.CloseQuoteByte());
        if (this.whereClause.Length > 0) {
            NativeMemory.Copy(bp + (nint)p, (nint)" WHERE ", 7); p = p + 7;
            NativeMemory.Copy(bp + (nint)p, (nint)this.whereClause, this.whereClause.Length);
        }
        return NativeMemory.GetString(bp, 0, total);
    }

    // 仅用于无法参数化的 DDL DEFAULT 字面量；DML 一律走 `?` 参数绑定。
    public static string EscapeDdlLiteral(string val) {
        return QueryBuilder.EscapeDdlLiteral(val, 0);
    }

    // 带方言感知的 DDL 字面量转义：剥离 NUL，双写单引号；MySQL/MariaDB 额外转义反斜杠。
    public static string EscapeDdlLiteral(string val, int provider) {
        if (val == null || val.Length == 0) { return ""; }
        bool escBackslash = provider == DbProvider.MySQL || provider == DbProvider.MariaDB;
        int n = val.Length;
        bool needEsc = false;
        for (int i = 0; i < n; i = i + 1) {
            int ch = val[i] & 255;
            if (ch == 39 || ch == 0 || (escBackslash && ch == 92)) {
                needEsc = true;
                break;
            }
        }
        if (!needEsc) { return val; }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < n; i = i + 1) {
            int ch = val[i] & 255;
            if (ch == 0) { continue; }
            if (ch == 39) { sb.Append("''"); }
            else if (escBackslash && ch == 92) { sb.Append("\\\\"); }
            else { sb.Append(val.Substring(i, 1)); }
        }
        return sb.ToString();
    }
}
