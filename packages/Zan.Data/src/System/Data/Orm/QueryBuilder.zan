using System;
using System.Text;
using System.Data;
namespace System.Data.Orm;

public class QueryBuilder {
    public string tableName;
    public string whereClause;
    public string orderByClause;
    public string groupByClause;
    public string havingClause;
    public string joinClause;
    public int limitVal;
    public int offsetVal;
    public int dialect;
    public List<SetClause> sets;
    public bool distinct;

    public DbParams whereParams;

    public QueryBuilder(string table) {
        this.tableName = QueryBuilder.RequireIdent(table);
        this.whereClause = "";
        this.orderByClause = "";
        this.groupByClause = "";
        this.havingClause = "";
        this.joinClause = "";
        this.limitVal = -1;
        this.offsetVal = -1;
        this.dialect = SqlDialect.Standard;
        this.sets = new List<SetClause>();
        this.distinct = false;
        this.whereParams = new DbParams();
    }

    public int Provider() {
        if (this.dialect == SqlDialect.SqlServer) { return DbProvider.SqlServer; }
        if (this.dialect == SqlDialect.Oracle) { return DbProvider.Oracle; }
        return DbProvider.SQLite;
    }

    public string Quote(string ident) {
        return Dialect.QuoteIdentifier(this.Provider(), QueryBuilder.RequireIdent(ident));
    }

    // 校验 SQL 标识符：[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)*
    public static bool IsIdent(string s) {
        int n = s.Length;
        if (n == 0) { return false; }
        bool prevDot = false;
        for (int i = 0; i < n; i = i + 1) {
            int c = s[i] & 255;
            bool alpha = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
            bool digit = c >= 48 && c <= 57;
            if (i == 0) {
                if (!alpha) { return false; }
            } else if (c == 46) {
                if (prevDot || i == n - 1) { return false; }
                prevDot = true;
                continue;
            } else if (!alpha && !digit) {
                return false;
            }
            prevDot = false;
        }
        return true;
    }

    public static string RequireIdent(string s) {
        if (!QueryBuilder.IsIdent(s)) { throw new Exception("unsafe SQL identifier: " + s); }
        return s;
    }

    // 校验 DDL 列类型文本，拒绝分号与注释符等注入通道。
    public static string RequireDdlType(string s) {
        int n = s.Length;
        if (n == 0) { throw new Exception("unsafe SQL column type: empty"); }
        for (int i = 0; i < n; i = i + 1) {
            int c = s[i] & 255;
            bool ok = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
                || (c >= 48 && c <= 57) || c == 32 || c == 40 || c == 41
                || c == 44 || c == 39 || c == 46;
            if (!ok) { throw new Exception("unsafe SQL column type: " + s); }
        }
        return s;
    }

    public static QueryBuilder From(string table) { return new QueryBuilder(table); }
    public static QueryBuilder InsertInto(string table) { return new QueryBuilder(table); }
    public static QueryBuilder Update(string table) { return new QueryBuilder(table); }
    public static QueryBuilder DeleteFrom(string table) { return new QueryBuilder(table); }

    public QueryBuilder Where(string condition) {
        this.whereClause = this.whereClause.Length == 0
            ? condition
            : this.whereClause + " AND " + condition;
        return this;
    }

    public QueryBuilder OrWhere(string condition) {
        this.whereClause = this.whereClause.Length == 0
            ? condition
            : this.whereClause + " OR " + condition;
        return this;
    }

    private QueryBuilder AppendCmpStr(string column, string op, string val) {
        this.whereParams.Add(val);
        return this.Where(this.Quote(column) + op);
    }

    private QueryBuilder AppendCmpInt(string column, string op, int val) {
        this.whereParams.AddInt(val);
        return this.Where(this.Quote(column) + op);
    }

    private QueryBuilder AppendCmpLong(string column, string op, long val) {
        this.whereParams.AddLong(val);
        return this.Where(this.Quote(column) + op);
    }

    public QueryBuilder WhereEq(string column, string val) { return this.AppendCmpStr(column, " = ?", val); }
    public QueryBuilder WhereEqInt(string column, int val) { return this.AppendCmpInt(column, " = ?", val); }
    public QueryBuilder WhereEqLong(string column, long val) { return this.AppendCmpLong(column, " = ?", val); }
    public QueryBuilder WhereGeLong(string column, long val) { return this.AppendCmpLong(column, " >= ?", val); }
    public QueryBuilder WhereLeLong(string column, long val) { return this.AppendCmpLong(column, " <= ?", val); }

    public QueryBuilder WhereValueAt(DbValues vals, int i) {
        vals.BindTo(this.whereParams, i);
        return this.Where(this.Quote(vals.NameAt(i)) + " = ?");
    }

    private string FormatInClause(string column, string op, int count) {
        StringBuilder sb = new StringBuilder();
        sb.Append(this.Quote(column));
        sb.Append(op);
        for (int i = 0; i < count; i = i + 1) {
            if (i > 0) { sb.Append(", "); }
            sb.Append("?");
        }
        if (count == 0) { sb.Append("NULL"); }
        sb.Append(")");
        return sb.ToString();
    }

    public QueryBuilder WhereIn(string column, List<string> values) {
        for (int i = 0; i < values.Count; i = i + 1) { this.whereParams.Add(values[i]); }
        return this.Where(this.FormatInClause(column, " IN (", values.Count));
    }

    // 空列表生成 IN (NULL) 恒假；避免非法 IN ()。
    public QueryBuilder WhereInInts(string column, List<int> values) {
        for (int i = 0; i < values.Count; i = i + 1) { this.whereParams.AddInt(values[i]); }
        return this.Where(this.FormatInClause(column, " IN (", values.Count));
    }

    public QueryBuilder WhereInLongs(string column, List<long> values) {
        for (int i = 0; i < values.Count; i = i + 1) { this.whereParams.AddLong(values[i]); }
        return this.Where(this.FormatInClause(column, " IN (", values.Count));
    }

    public QueryBuilder WhereNotIn(string column, List<string> values) {
        if (values.Count == 0) { return this; }
        for (int i = 0; i < values.Count; i = i + 1) { this.whereParams.Add(values[i]); }
        return this.Where(this.FormatInClause(column, " NOT IN (", values.Count));
    }

    public QueryBuilder WhereLike(string column, string pattern) { return this.AppendCmpStr(column, " LIKE ?", pattern); }
    public QueryBuilder WhereNotLike(string column, string pattern) { return this.AppendCmpStr(column, " NOT LIKE ?", pattern); }
    public QueryBuilder WhereContains(string column, string val) { return this.WhereLike(column, "%" + val + "%"); }
    public QueryBuilder WhereStartsWith(string column, string val) { return this.WhereLike(column, val + "%"); }
    public QueryBuilder WhereEndsWith(string column, string val) { return this.WhereLike(column, "%" + val); }

    public QueryBuilder WhereAnyLike(List<string> columns, string val) {
        int n = columns.Count;
        if (n == 0) { return this; }
        StringBuilder sb = new StringBuilder();
        sb.Append("(");
        string pat = "%" + val + "%";
        for (int i = 0; i < n; i = i + 1) {
            if (i > 0) { sb.Append(" OR "); }
            sb.Append(this.Quote(columns[i]));
            sb.Append(" LIKE ?");
            this.whereParams.Add(pat);
        }
        sb.Append(")");
        return this.Where(sb.ToString());
    }

    public QueryBuilder WhereNe(string column, string val) { return this.AppendCmpStr(column, " <> ?", val); }
    public QueryBuilder WhereNeInt(string column, int val) { return this.AppendCmpInt(column, " <> ?", val); }
    public QueryBuilder WhereGtInt(string column, int val) { return this.AppendCmpInt(column, " > ?", val); }
    public QueryBuilder WhereGeInt(string column, int val) { return this.AppendCmpInt(column, " >= ?", val); }
    public QueryBuilder WhereLtInt(string column, int val) { return this.AppendCmpInt(column, " < ?", val); }
    public QueryBuilder WhereLeInt(string column, int val) { return this.AppendCmpInt(column, " <= ?", val); }

    public QueryBuilder WhereBetween(string column, string low, string high) {
        this.whereParams.Add(low);
        this.whereParams.Add(high);
        return this.Where(this.Quote(column) + " BETWEEN ? AND ?");
    }

    public QueryBuilder WhereNull(string column) { return this.Where(this.Quote(column) + " IS NULL"); }
    public QueryBuilder WhereNotNull(string column) { return this.Where(this.Quote(column) + " IS NOT NULL"); }

    public QueryBuilder OrderBy(string column) {
        this.orderByClause = QueryBuilder.RequireIdent(column);
        return this;
    }

    public QueryBuilder OrderByDesc(string column) {
        this.orderByClause = QueryBuilder.RequireIdent(column) + " DESC";
        return this;
    }

    public static void CheckAllowed(string column, List<string> allowed) {
        if (allowed != null) {
            for (int i = 0; i < allowed.Count; i = i + 1) {
                if (allowed[i] == column) { return; }
            }
        }
        throw new Exception("column not in allowed list: " + column);
    }

    // 排序列无法参数化：来自用户输入的列必须经白名单校验以防布尔预言机泄密。
    public QueryBuilder OrderBySafe(string column, List<string> allowed) {
        QueryBuilder.CheckAllowed(column, allowed);
        return this.OrderBy(column);
    }

    public QueryBuilder OrderBySafeDesc(string column, List<string> allowed) {
        QueryBuilder.CheckAllowed(column, allowed);
        return this.OrderByDesc(column);
    }

    public QueryBuilder GroupBy(string column) {
        this.groupByClause = QueryBuilder.RequireIdent(column);
        return this;
    }

    public QueryBuilder Having(string condition) {
        this.havingClause = condition;
        return this;
    }

    private QueryBuilder AddJoin(string keyword, string table, string on) {
        this.joinClause = this.joinClause + keyword + QueryBuilder.RequireIdent(table) + " ON " + on;
        return this;
    }

    public QueryBuilder Join(string table, string on) { return this.AddJoin(" JOIN ", table, on); }
    public QueryBuilder LeftJoin(string table, string on) { return this.AddJoin(" LEFT JOIN ", table, on); }
    public QueryBuilder RightJoin(string table, string on) { return this.AddJoin(" RIGHT JOIN ", table, on); }

    public QueryBuilder Limit(int count) { this.limitVal = count; return this; }
    public QueryBuilder Offset(int count) { this.offsetVal = count; return this; }
    public QueryBuilder Dialect(int d) { this.dialect = d; return this; }
    public QueryBuilder Distinct() { this.distinct = true; return this; }

    public QueryBuilder Set(string column, string val) {
        this.sets.Add(new SetClause(QueryBuilder.RequireIdent(column), val));
        return this;
    }

    public QueryBuilder SetParam(string column) { return this.Set(column, ""); }
    public QueryBuilder SetInt(string column, int val) { return this.Set(column, Convert.ToString(val)); }

    public void AppendClauses(StringBuilder sb) {
        if (this.joinClause.Length > 0) { sb.Append(this.joinClause); }
        if (this.whereClause.Length > 0) { sb.Append(" WHERE "); sb.Append(this.whereClause); }
        if (this.groupByClause.Length > 0) { sb.Append(" GROUP BY "); sb.Append(this.groupByClause); }
        if (this.havingClause.Length > 0) { sb.Append(" HAVING "); sb.Append(this.havingClause); }
        if (this.orderByClause.Length > 0) { sb.Append(" ORDER BY "); sb.Append(this.orderByClause); }
        if (this.dialect == SqlDialect.Standard) {
            if (this.limitVal >= 0) { sb.Append(" LIMIT "); sb.Append(Convert.ToString(this.limitVal)); }
            if (this.offsetVal >= 0) { sb.Append(" OFFSET "); sb.Append(Convert.ToString(this.offsetVal)); }
        } else if (this.offsetVal >= 0 || this.limitVal >= 0) {
            int off = this.offsetVal < 0 ? 0 : this.offsetVal;
            sb.Append(" OFFSET ");
            sb.Append(Convert.ToString(off));
            sb.Append(" ROWS");
            if (this.limitVal >= 0) {
                sb.Append(" FETCH NEXT ");
                sb.Append(Convert.ToString(this.limitVal));
                sb.Append(" ROWS ONLY");
            }
        }
    }

    public string BuildSelectParams(string columns) {
        StringBuilder sb = new StringBuilder();
        sb.Append("SELECT ");
        if (this.distinct) { sb.Append("DISTINCT "); }
        sb.Append(columns);
        sb.Append(" FROM ");
        sb.Append(this.Quote(this.tableName));
        this.AppendClauses(sb);
        return sb.ToString();
    }

    public DbParams SelectParams() { return this.whereParams; }

    public string BuildInsertParams() {
        StringBuilder sb = new StringBuilder();
        StringBuilder vals = new StringBuilder();
        sb.Append("INSERT INTO ");
        sb.Append(this.Quote(this.tableName));
        sb.Append(" (");
        for (int i = 0; i < this.sets.Count; i = i + 1) {
            if (i > 0) { sb.Append(", "); vals.Append(", "); }
            sb.Append(this.Quote(this.sets[i].column));
            vals.Append("?");
        }
        sb.Append(") VALUES (");
        sb.Append(vals.ToString());
        sb.Append(")");
        return sb.ToString();
    }

    public DbParams InsertParams() {
        DbParams p = new DbParams();
        foreach (SetClause s in this.sets) { p.Add(s.val); }
        return p;
    }

    public string BuildUpdateParams() {
        StringBuilder sb = new StringBuilder();
        sb.Append("UPDATE ");
        sb.Append(this.Quote(this.tableName));
        sb.Append(" SET ");
        for (int i = 0; i < this.sets.Count; i = i + 1) {
            if (i > 0) { sb.Append(", "); }
            sb.Append(this.Quote(this.sets[i].column));
            sb.Append(" = ?");
        }
        if (this.whereClause.Length > 0) {
            sb.Append(" WHERE ");
            sb.Append(this.whereClause);
        }
        return sb.ToString();
    }

    public DbParams UpdateParams() {
        DbParams p = new DbParams();
        foreach (SetClause s in this.sets) { p.Add(s.val); }
        int wn = this.whereParams.Count();
        for (int i = 0; i < wn; i = i + 1) {
            int k = this.whereParams.KindAt(i);
            if (k == 1) { p.AddLong(this.whereParams.IntAt(i)); }
            else if (k == 2) { p.AddDouble(this.whereParams.DoubleAt(i)); }
            else if (k == 3) { p.Add(this.whereParams.TextAt(i)); }
            else { p.AddNull(); }
        }
        return p;
    }

    public string BuildDeleteParams() {
        StringBuilder sb = new StringBuilder();
        sb.Append("DELETE FROM ");
        sb.Append(this.Quote(this.tableName));
        if (this.whereClause.Length > 0) {
            sb.Append(" WHERE ");
            sb.Append(this.whereClause);
        }
        return sb.ToString();
    }

    // 仅用于无法参数化的 DDL DEFAULT 字面量；DML 一律走 `?` 参数绑定。
    public static string EscapeDdlLiteral(string val) {
        if (val == null || val.Length == 0) { return ""; }
        if (val.IndexOf("'") < 0) { return val; }
        return val.Replace("'", "''");
    }
}
