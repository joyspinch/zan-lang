using System;
using System.Data;

namespace System.Data.Orm;

// SQL 分页方言。不同引擎对 LIMIT/OFFSET 的写法不同。
// 核心契约与语义定义。
// QuestDB、DuckDB、Firebird 3+）
// - SqlServer：OFFSET m ROWS FETCH NEXT n ROWS ONLY（需要 ORDER BY）
// 核心契约与语义定义。
class SqlDialect {
    static int Standard  = 0;
    static int SqlServer = 1;
    static int Oracle    = 2;
}

// INSERT/UPDATE 的单个 column=value 赋值，合并为一个
// 实体，而非并行的列/值列表。
class SetClause {
    string column;
    string val;

    SetClause(string column, string val) {
        this.column = column;
        this.val = val;
    }
}

// 仿 FreeSQL 的流式 SQL 查询构建器。
// 支持通过方法链执行 SELECT、INSERT、UPDATE、DELETE。
// 用法（全部走 `?` 占位符 + DbParams——值永远不会进入 SQL 文本，
// 由 DbConnection 以驱动级参数绑定上线）：
// 核心契约与语义定义。
// db.Execute(sql, qb.InsertParams());
// 标识符（表、列、ORDER BY / GROUP BY 目标）会按
// [A-Za-z_][A-Za-z0-9_.]* 校验；非法标识符抛出 Exception。
// 原始字符串子句（Where/OrWhere/Having/Join）不做参数化——
// 绝不要在其中放入用户输入；请改用 WhereEq/WhereIn/...。
class QueryBuilder {
    string tableName;
    string whereClause;
    string orderByClause;
    string groupByClause;
    string havingClause;
    string joinClause;
    int limitVal;
    int offsetVal;
    int dialect;
    List<SetClause> sets;
    bool distinct;

    DbParams whereParams;

    QueryBuilder(string table) {
        this.tableName = QueryBuilder.RequireIdent(table);
        this.whereClause = "";
        this.orderByClause = "";
        this.groupByClause = "";
        this.havingClause = "";
        this.joinClause = "";
        this.limitVal = -1;
        this.offsetVal = -1;
        this.dialect = SqlDialect.Standard;
        this.sets = new List<SetClause>();
        this.distinct = false;
        this.whereParams = new DbParams();
    }

    // 当 s 是安全的 SQL 标识符时返回 true：[A-Za-z_][A-Za-z0-9_.]*
    // （点号允许用于 schema.table 这类限定名）。
    static bool IsIdent(string s) {
        int n = s.Length;
        if (n == 0) { return false; }
        for (int i = 0; i < n; i = i + 1) {
            int c = s[i] & 255;
            bool alpha = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
            bool digit = c >= 48 && c <= 57;
            bool dot = c == 46;
            if (i == 0) {
                if (!alpha) { return false; }
            } else {
                if (!alpha && !digit && !dot) { return false; }
            }
        }
        return true;
    }

    // s 是安全标识符时原样返回；否则抛出异常。
    static string RequireIdent(string s) {
        if (!QueryBuilder.IsIdent(s)) {
            throw new Exception("unsafe SQL identifier: " + s);
        }
        return s;
    }

    // s 是安全的 DDL 类型文本时原样返回；否则抛出异常。
    // 允许字母、数字、下划线、空格、括号、逗号、单引号与点号——足以表达
    // 核心契约与语义定义。
    // 这类类型与约束表达式，而分号、注释符等批处理注入通道一律拒绝。
    // 列类型文本会拼接进 CREATE TABLE，必须过这道检查。
    static string RequireDdlType(string s) {
        int n = s.Length;
        if (n == 0) {
            throw new Exception("unsafe SQL column type: empty");
        }
        for (int i = 0; i < n; i = i + 1) {
            int c = s[i] & 255;
            bool alpha = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
            bool digit = c >= 48 && c <= 57;
            bool space = c == 32;
            bool paren = c == 40 || c == 41;
            bool comma = c == 44;
            bool quote = c == 39;  // 单引号允许用于 DEFAULT 'literal'
            bool dot = c == 46;  // 浮点默认值
            if (!alpha && !digit && !space && !paren && !comma && !quote && !dot) {
                throw new Exception("unsafe SQL column type: " + s);
            }
        }
        return s;
    }

    // 创建从某表 SELECT 的查询构建器。
    static QueryBuilder From(string table) {
        return new QueryBuilder(table);
    }

    // 创建向某表 INSERT INTO 的查询构建器。
    static QueryBuilder InsertInto(string table) {
        return new QueryBuilder(table);
    }

    // 创建更新某表的查询构建器。
    static QueryBuilder Update(string table) {
        return new QueryBuilder(table);
    }

    // 创建从某表 DELETE 的查询构建器。
    static QueryBuilder DeleteFrom(string table) {
        return new QueryBuilder(table);
    }

    // 添加 WHERE 子句。
    QueryBuilder Where(string condition) {
        if (this.whereClause.Length == 0) {
            this.whereClause = condition;
        } else {
            this.whereClause = this.whereClause + " AND " + condition;
        }
        return this;
    }

    // 添加 OR WHERE 子句。
    QueryBuilder OrWhere(string condition) {
        if (this.whereClause.Length == 0) {
            this.whereClause = condition;
        } else {
            this.whereClause = this.whereClause + " OR " + condition;
        }
        return this;
    }

    // 添加 `column = ?`，值作为绑定参数传递
    // （防 SQL 注入：值永远不会进入 SQL 文本）。
    QueryBuilder WhereEq(string column, string val) {
        this.whereParams.Add(val);
        return Where(QueryBuilder.RequireIdent(column) + " = ?");
    }

    // 添加 `column = ?`，使用整数参数。
    QueryBuilder WhereEqInt(string column, int val) {
        this.whereParams.AddInt(val);
        return Where(QueryBuilder.RequireIdent(column) + " = ?");
    }

    // 添加 `column = ?`，使用 64 位整数参数。
    QueryBuilder WhereEqLong(string column, long val) {
        this.whereParams.AddLong(val);
        return Where(QueryBuilder.RequireIdent(column) + " = ?");
    }

    // 添加 `column >= ?`，使用 64 位整数参数。
    QueryBuilder WhereGeLong(string column, long val) {
        this.whereParams.AddLong(val);
        return Where(QueryBuilder.RequireIdent(column) + " >= ?");
    }

    // 添加 `column <= ?`，使用 64 位整数参数。
    QueryBuilder WhereLeLong(string column, long val) {
        this.whereParams.AddLong(val);
        return Where(QueryBuilder.RequireIdent(column) + " <= ?");
    }

    // 添加 `column = ?`，值按 DbValues 里声明的类型绑定
    // （运行期成形的条件：提交的筛选表单、解析出的 JSON）。
    QueryBuilder WhereValueAt(DbValues vals, int i) {
        vals.BindTo(this.whereParams, i);
        return Where(QueryBuilder.RequireIdent(vals.NameAt(i)) + " = ?");
    }

    // 添加 WHERE column IN (?, ?, ...)，使用绑定参数。
    QueryBuilder WhereIn(string column, List<string> values) {
        StringBuilder sb = new StringBuilder();
        sb.Append(QueryBuilder.RequireIdent(column));
        sb.Append(" IN (");
        int n = values.Count;
        for (int i = 0; i < n; i = i + 1) {
            if (i > 0) { sb.Append(", "); }
            sb.Append("?");
            this.whereParams.Add(values[i]);
        }
        if (n == 0) { sb.Append("NULL"); }
        sb.Append(")");
        return Where(sb.ToString());
    }

    // 添加 WHERE column IN (?, ?, ...)，使用整数参数；
    // 空列表按恒假处理（`IN (NULL)`），不生成 `IN ()`。
    QueryBuilder WhereInInts(string column, List<int> values) {
        StringBuilder sb = new StringBuilder();
        sb.Append(QueryBuilder.RequireIdent(column));
        sb.Append(" IN (");
        int n = values.Count;
        for (int i = 0; i < n; i = i + 1) {
            if (i > 0) { sb.Append(", "); }
            sb.Append("?");
            this.whereParams.AddInt(values[i]);
        }
        if (n == 0) { sb.Append("NULL"); }
        sb.Append(")");
        return Where(sb.ToString());
    }

    // 添加 WHERE column IN (?, ?, ...)，使用 64 位整数参数；
    // 空列表按恒假处理（`IN (NULL)`），不生成 `IN ()`。
    QueryBuilder WhereInLongs(string column, List<long> values) {
        StringBuilder sb = new StringBuilder();
        sb.Append(QueryBuilder.RequireIdent(column));
        sb.Append(" IN (");
        int n = values.Count;
        for (int i = 0; i < n; i = i + 1) {
            if (i > 0) { sb.Append(", "); }
            sb.Append("?");
            this.whereParams.AddLong(values[i]);
        }
        if (n == 0) { sb.Append("NULL"); }
        sb.Append(")");
        return Where(sb.ToString());
    }

    // 添加 WHERE column NOT IN (?, ?, ...)，使用绑定参数。
    QueryBuilder WhereNotIn(string column, List<string> values) {
        StringBuilder sb = new StringBuilder();
        sb.Append(QueryBuilder.RequireIdent(column));
        sb.Append(" NOT IN (");
        int n = values.Count;
        for (int i = 0; i < n; i = i + 1) {
            if (i > 0) { sb.Append(", "); }
            sb.Append("?");
            this.whereParams.Add(values[i]);
        }
        sb.Append(")");
        return Where(sb.ToString());
    }

    // 添加 WHERE column LIKE ?，使用绑定参数。
    QueryBuilder WhereLike(string column, string pattern) {
        this.whereParams.Add(pattern);
        return Where(QueryBuilder.RequireIdent(column) + " LIKE ?");
    }

    // 添加 WHERE column NOT LIKE ?，使用绑定参数。
    QueryBuilder WhereNotLike(string column, string pattern) {
        this.whereParams.Add(pattern);
        return Where(QueryBuilder.RequireIdent(column) + " NOT LIKE ?");
    }

    // 添加 `column LIKE %value%`（子串匹配，已绑定）。
    QueryBuilder WhereContains(string column, string val) {
        return WhereLike(column, "%" + val + "%");
    }

    // 添加 `column LIKE value%`（前缀匹配，已绑定）。
    QueryBuilder WhereStartsWith(string column, string val) {
        return WhereLike(column, val + "%");
    }

    // 添加 `column LIKE %value`（后缀匹配，已绑定）。
    QueryBuilder WhereEndsWith(string column, string val) {
        return WhereLike(column, "%" + val);
    }

    // 添加 `(col1 LIKE ? OR col2 LIKE ? OR ...)`，单个关键字
    // 绑定到每一列（子串匹配）。整个组是一个 WHERE
    // 操作数，因此可与 AND 组合为 `... AND (a LIKE ? OR b LIKE ?)`。
    // 空列列表时不做任何操作；值始终绑定，绝不内联。
    QueryBuilder WhereAnyLike(List<string> columns, string val) {
        int n = columns.Count;
        if (n == 0) { return this; }
        StringBuilder sb = new StringBuilder();
        sb.Append("(");
        for (int i = 0; i < n; i = i + 1) {
            if (i > 0) { sb.Append(" OR "); }
            sb.Append(QueryBuilder.RequireIdent(columns[i]));
            sb.Append(" LIKE ?");
            this.whereParams.Add("%" + val + "%");
        }
        sb.Append(")");
        return Where(sb.ToString());
    }

    // 添加 `column <> ?`，使用绑定参数。
    QueryBuilder WhereNe(string column, string val) {
        this.whereParams.Add(val);
        return Where(QueryBuilder.RequireIdent(column) + " <> ?");
    }

    // 添加 `column <> ?`，使用整数参数。
    QueryBuilder WhereNeInt(string column, int val) {
        this.whereParams.AddInt(val);
        return Where(QueryBuilder.RequireIdent(column) + " <> ?");
    }

    // 添加 `column > ?`，使用整数参数。
    QueryBuilder WhereGtInt(string column, int val) {
        this.whereParams.AddInt(val);
        return Where(QueryBuilder.RequireIdent(column) + " > ?");
    }

    // 添加 `column >= ?`，使用整数参数。
    QueryBuilder WhereGeInt(string column, int val) {
        this.whereParams.AddInt(val);
        return Where(QueryBuilder.RequireIdent(column) + " >= ?");
    }

    // 添加 `column < ?`，使用整数参数。
    QueryBuilder WhereLtInt(string column, int val) {
        this.whereParams.AddInt(val);
        return Where(QueryBuilder.RequireIdent(column) + " < ?");
    }

    // 添加 `column <= ?`，使用整数参数。
    QueryBuilder WhereLeInt(string column, int val) {
        this.whereParams.AddInt(val);
        return Where(QueryBuilder.RequireIdent(column) + " <= ?");
    }

    // 添加 WHERE column BETWEEN ? AND ?，使用绑定参数。
    QueryBuilder WhereBetween(string column, string low, string high) {
        this.whereParams.Add(low);
        this.whereParams.Add(high);
        return Where(QueryBuilder.RequireIdent(column) + " BETWEEN ? AND ?");
    }

    // 添加 WHERE IS NULL 子句。
    QueryBuilder WhereNull(string column) {
        return Where(QueryBuilder.RequireIdent(column) + " IS NULL");
    }

    // 添加 WHERE IS NOT NULL 子句。
    QueryBuilder WhereNotNull(string column) {
        return Where(QueryBuilder.RequireIdent(column) + " IS NOT NULL");
    }

    // 设置 ORDER BY 子句（列名已做标识符校验）。
    QueryBuilder OrderBy(string column) {
        this.orderByClause = QueryBuilder.RequireIdent(column);
        return this;
    }

    // 设置 ORDER BY DESC 子句（列名已做标识符校验）。
    QueryBuilder OrderByDesc(string column) {
        this.orderByClause = QueryBuilder.RequireIdent(column) + " DESC";
        return this;
    }

    // 列名必须精确命中调用方提供的白名单；未命中抛异常。
    static void CheckAllowed(string column, List<string> allowed) {
        if (allowed != null) {
            for (int i = 0; i < allowed.Count; i = i + 1) {
                if (allowed[i] == column) { return; }
            }
        }
        throw new Exception("column not in allowed list: " + column);
    }

    // 白名单版 ORDER BY：列名必须命中 allowed（精确匹配）
    // 且是安全标识符，否则抛异常。RequireIdent 挡住注入语法，但挡不住
    // "合法但未授权"的列——排序既能被攻击者当布尔预言机（按保密列
    // 排序观察顺序差），也能放大误差泄密；ORDER BY 无法参数化，可能
    // 来自用户输入（?sort=）的排序列必须持单。
    QueryBuilder OrderBySafe(string column, List<string> allowed) {
        QueryBuilder.CheckAllowed(column, allowed);
        this.orderByClause = QueryBuilder.RequireIdent(column);
        return this;
    }

    // 白名单版 ORDER BY DESC。
    QueryBuilder OrderBySafeDesc(string column, List<string> allowed) {
        QueryBuilder.CheckAllowed(column, allowed);
        this.orderByClause = QueryBuilder.RequireIdent(column) + " DESC";
        return this;
    }

    // 设置 GROUP BY 子句（列名已做标识符校验）。
    QueryBuilder GroupBy(string column) {
        this.groupByClause = QueryBuilder.RequireIdent(column);
        return this;
    }

    // 设置 HAVING 子句。
    QueryBuilder Having(string condition) {
        this.havingClause = condition;
        return this;
    }

    // 添加 JOIN 子句。表名经过标识符校验；
    // `on` 是自由条件表达式，引用外部输入时须自行参数化。
    QueryBuilder Join(string table, string on) {
        this.joinClause = this.joinClause + " JOIN "
            + QueryBuilder.RequireIdent(table) + " ON " + on;
        return this;
    }

    // 添加 LEFT JOIN 子句。表名经过标识符校验。
    QueryBuilder LeftJoin(string table, string on) {
        this.joinClause = this.joinClause + " LEFT JOIN "
            + QueryBuilder.RequireIdent(table) + " ON " + on;
        return this;
    }

    // 添加 RIGHT JOIN 子句。表名经过标识符校验。
    QueryBuilder RightJoin(string table, string on) {
        this.joinClause = this.joinClause + " RIGHT JOIN "
            + QueryBuilder.RequireIdent(table) + " ON " + on;
        return this;
    }

    // 设置 LIMIT。
    QueryBuilder Limit(int count) {
        this.limitVal = count;
        return this;
    }

    // 设置 OFFSET。
    QueryBuilder Offset(int count) {
        this.offsetVal = count;
        return this;
    }

    // 选择 SQL 分页方言（参见 SqlDialect）。
    QueryBuilder Dialect(int d) {
        this.dialect = d;
        return this;
    }

    // 设置 DISTINCT 标志。
    QueryBuilder Distinct() {
        this.distinct = true;
        return this;
    }

    // 为 INSERT/UPDATE 设置 column=value 对。
    QueryBuilder Set(string column, string val) {
        this.sets.Add(new SetClause(QueryBuilder.RequireIdent(column), val));
        return this;
    }

    // 声明一个 column = ? 赋值，值由调用方自己绑定
    // （运行期成形的列：DbValues 按它记录的类型绑定，值不必
    // 先变成字符串）。与 BuildInsertParams / BuildUpdateParams
    // 搭配使用，绑定顺序即声明顺序。
    QueryBuilder SetParam(string column) {
        this.sets.Add(new SetClause(QueryBuilder.RequireIdent(column), ""));
        return this;
    }

    // 设置整数形式的 column=value 对。
    QueryBuilder SetInt(string column, int val) {
        this.sets.Add(new SetClause(QueryBuilder.RequireIdent(column), Convert.ToString(val)));
        return this;
    }

    // ===== 参数化构建器（推荐） =====
    // SQL 文本只包含 `?` 占位符；调用对应的 *Params()
    // 访问器，将两者一起传给支持参数化的驱动重载，例如
    // db.Query(qb.BuildSelectParams("*"), qb.SelectParams())

    // 把 JOIN/WHERE/GROUP BY/HAVING/ORDER BY/LIMIT/OFFSET
    // 子句追加到 sb（占位符原样保留，参数由调用方随 SQL 一起传）。
    void AppendClauses(StringBuilder sb) {
        if (this.joinClause.Length > 0) {
            sb.Append(this.joinClause);
        }
        if (this.whereClause.Length > 0) {
            sb.Append(" WHERE ");
            sb.Append(this.whereClause);
        }
        if (this.groupByClause.Length > 0) {
            sb.Append(" GROUP BY ");
            sb.Append(this.groupByClause);
        }
        if (this.havingClause.Length > 0) {
            sb.Append(" HAVING ");
            sb.Append(this.havingClause);
        }
        if (this.orderByClause.Length > 0) {
            sb.Append(" ORDER BY ");
            sb.Append(this.orderByClause);
        }
        if (this.dialect == SqlDialect.Standard) {
            if (this.limitVal >= 0) {
                sb.Append(" LIMIT ");
                sb.Append(Convert.ToString(this.limitVal));
            }
            if (this.offsetVal >= 0) {
                sb.Append(" OFFSET ");
                sb.Append(Convert.ToString(this.offsetVal));
            }
        } else {
            // 核心契约与语义定义。
            if (this.offsetVal >= 0 || this.limitVal >= 0) {
                int off = this.offsetVal;
                if (off < 0) { off = 0; }
                sb.Append(" OFFSET ");
                sb.Append(Convert.ToString(off));
                sb.Append(" ROWS");
                if (this.limitVal >= 0) {
                    sb.Append(" FETCH NEXT ");
                    sb.Append(Convert.ToString(this.limitVal));
                    sb.Append(" ROWS ONLY");
                }
            }
        }
    }

    // 构建带 `?` 占位符的 SELECT（参见 SelectParams()）。
    string BuildSelectParams(string columns) {
        StringBuilder sb = new StringBuilder();
        sb.Append("SELECT ");
        if (this.distinct) { sb.Append("DISTINCT "); }
        sb.Append(columns);
        sb.Append(" FROM ");
        sb.Append(this.tableName);
        AppendClauses(sb);
        return sb.ToString();
    }

    // BuildSelectParams / BuildDeleteParams 的参数。
    DbParams SelectParams() {
        return this.whereParams;
    }

    // 构建带 `?` 占位符的 INSERT（参见 InsertParams()）。
    string BuildInsertParams() {
        StringBuilder sb = new StringBuilder();
        sb.Append("INSERT INTO ");
        sb.Append(this.tableName);
        sb.Append(" (");
        bool first = true;
        foreach (SetClause s in this.sets) {
            if (!first) { sb.Append(", "); }
            sb.Append(s.column);
            first = false;
        }
        sb.Append(") VALUES (");
        first = true;
        foreach (SetClause s in this.sets) {
            if (!first) { sb.Append(", "); }
            sb.Append("?");
            first = false;
        }
        sb.Append(")");
        return sb.ToString();
    }

    // BuildInsertParams 的参数（按顺序排列的 Set 值）。
    DbParams InsertParams() {
        DbParams p = new DbParams();
        foreach (SetClause s in this.sets) { p.Add(s.val); }
        return p;
    }

    // 构建带 `?` 占位符的 UPDATE（参见 UpdateParams()）。
    string BuildUpdateParams() {
        StringBuilder sb = new StringBuilder();
        sb.Append("UPDATE ");
        sb.Append(this.tableName);
        sb.Append(" SET ");
        bool first = true;
        foreach (SetClause s in this.sets) {
            if (!first) { sb.Append(", "); }
            sb.Append(s.column);
            sb.Append(" = ?");
            first = false;
        }
        if (this.whereClause.Length > 0) {
            sb.Append(" WHERE ");
            sb.Append(this.whereClause);
        }
        return sb.ToString();
    }

    // BuildUpdateParams 的参数（先是 Set 值，再是 WHERE 值）。
    DbParams UpdateParams() {
        DbParams p = new DbParams();
        foreach (SetClause s in this.sets) { p.Add(s.val); }
        int wn = this.whereParams.Count();
        for (int i = 0; i < wn; i = i + 1) {
            int k = this.whereParams.KindAt(i);
            if (k == 1) { p.AddLong(this.whereParams.IntAt(i)); }
            else if (k == 2) { p.AddDouble(this.whereParams.DoubleAt(i)); }
            else if (k == 3) { p.Add(this.whereParams.TextAt(i)); }
            else { p.AddNull(); }
        }
        return p;
    }

    // 构建带 `?` 占位符的 DELETE（参见 SelectParams()）。
    string BuildDeleteParams() {
        StringBuilder sb = new StringBuilder();
        sb.Append("DELETE FROM ");
        sb.Append(this.tableName);
        if (this.whereClause.Length > 0) {
            sb.Append(" WHERE ");
            sb.Append(this.whereClause);
        }
        return sb.ToString();
    }

    // DDL 字面量转义（单引号加倍）。只允许用于
    // CREATE TABLE 的 DEFAULT 子句这类无法参数化的位置——
    // 所有 DML 一律走 `?` + DbParams 驱动级绑定，
    // 不要用本方法拼接查询值。
    static string EscapeDdlLiteral(string val) {
        if (val == null || val.Length == 0) { return ""; }
        if (val.IndexOf("'") < 0) { return val; }
        return val.Replace("'", "''");
    }

}
