using System;
using System.Text;
using System.Data;
using System.Data.Orm;
using System.Json;
namespace System.Data.Orm;

public class Model {
    private string tableName;
    private List<ModelColumn> columns;
    private string primaryKey;
    private IDbExecutor db;

    // 以已校验的表名初始化空模型；外部入口是 <see cref="Define"/>。
    public Model(string tableName) {
        this.tableName = QueryBuilder.RequireIdent(tableName);
        this.columns = new List<ModelColumn>();
        this.primaryKey = "";
    }

    // 以表名定义一个新模型。
    public static Model Define(string tableName) {
        return new Model(tableName);
    }

    // 添加一个列定义。
    public Model Column(string name, string type) {
        this.columns.Add(new ModelColumn(QueryBuilder.RequireIdent(name), type));
        return this;
    }

    // 将一列设为主键。
    public Model Column(string name, string type, bool isPrimaryKey) {
        string ident = QueryBuilder.RequireIdent(name);
        if (isPrimaryKey) {
            this.columns.Add(new ModelColumn(ident, type + " PRIMARY KEY AUTOINCREMENT"));
            this.primaryKey = ident;
        } else {
            this.columns.Add(new ModelColumn(ident, type));
        }
        return this;
    }

    // 添加一个 NOT NULL 列。
    public Model ColumnNotNull(string name, string type) {
        this.columns.Add(new ModelColumn(QueryBuilder.RequireIdent(name), type + " NOT NULL"));
        return this;
    }

    // 添加带默认值的列。
    public Model ColumnDefault(string name, string type, string defaultVal) {
        this.columns.Add(new ModelColumn(QueryBuilder.RequireIdent(name), type + " DEFAULT '" + QueryBuilder.EscapeDdlLiteral(defaultVal) + "'"));
        return this;
    }

    // 添加一个 UNIQUE 列。
    public Model ColumnUnique(string name, string type) {
        this.columns.Add(new ModelColumn(QueryBuilder.RequireIdent(name), type + " UNIQUE"));
        return this;
    }

    // 在数据库中创建表。
    public void CreateTable(IDbExecutor db) {
        StringBuilder sb = new StringBuilder();
        sb.Append("CREATE TABLE IF NOT EXISTS ");
        sb.Append(this.tableName);
        sb.Append(" (");
        bool first = true;
        foreach (ModelColumn col in this.columns) {
            if (!first) { sb.Append(", "); }
            sb.Append(col.name);
            sb.Append(" ");
            sb.Append(col.type);
            first = false;
        }
        sb.Append(")");
        db.Execute(sb.ToString());
    }

    // 创建表（异步版本）。
    public async int CreateTableAsync(IDbExecutor db) {
        StringBuilder sb = new StringBuilder();
        sb.Append("CREATE TABLE IF NOT EXISTS ");
        sb.Append(this.tableName);
        sb.Append(" (");
        bool first = true;
        foreach (ModelColumn col in this.columns) {
            if (!first) { sb.Append(", "); }
            sb.Append(col.name);
            sb.Append(" ");
            sb.Append(col.type);
            first = false;
        }
        sb.Append(")");
        return await db.ExecuteAsync(sb.ToString());
    }

    // 从数据库中删除表。
    public void DropTable(IDbExecutor db) {
        db.Execute("DROP TABLE IF EXISTS " + this.tableName);
    }

    // 异步从数据库中删除表。
    public async int DropTableAsync(IDbExecutor db) {
        return await db.ExecuteAsync("DROP TABLE IF EXISTS " + this.tableName);
    }

    // 检查表是否存在（跨数据库方言，参数化查询防注入）。
    public bool TableExists(IDbExecutor db) {
        int prov = db != null ? db.GetProvider() : DbProvider.SQLite;
        string sql = "SELECT COUNT(*) FROM sqlite_master WHERE type='table' AND name = ?";
        if (prov == DbProvider.MySQL || prov == DbProvider.PostgreSQL || prov == DbProvider.SqlServer) {
            sql = "SELECT COUNT(*) FROM information_schema.tables WHERE table_name = ?";
        }
        DbParams ps = new DbParams();
        ps.Add(this.tableName);
        string result = db.ExecuteScalar(sql, ps);
        return Convert.ToInt(result) > 0;
    }

    // 异步检查表是否存在。
    public async bool TableExistsAsync(IDbExecutor db) {
        int prov = db != null ? db.GetProvider() : DbProvider.SQLite;
        string sql = "SELECT COUNT(*) FROM sqlite_master WHERE type='table' AND name = ?";
        if (prov == DbProvider.MySQL || prov == DbProvider.PostgreSQL || prov == DbProvider.SqlServer) {
            sql = "SELECT COUNT(*) FROM information_schema.tables WHERE table_name = ?";
        }
        DbParams ps = new DbParams();
        ps.Add(this.tableName);
        string result = await db.ExecuteScalarAsync(sql, ps);
        return Convert.ToInt(result) > 0;
    }

    // 向表中插入一行。
    public int Insert(IDbExecutor db, ModelRow row) {
        QueryBuilder qb = QueryBuilder.InsertInto(this.tableName);
        List<string> keys = row.GetKeys();
        for (int i = 0; i < keys.Count; i = i + 1) {
            string key = keys[i];
            string val = row.Get(key);
            qb.Set(key, val);
        }
        return db.Execute(qb.BuildInsertParams(), qb.InsertParams());
    }

    // 插入一行（异步版本）。
    public async int InsertAsync(IDbExecutor db, ModelRow row) {
        QueryBuilder qb = QueryBuilder.InsertInto(this.tableName);
        List<string> keys = row.GetKeys();
        for (int i = 0; i < keys.Count; i = i + 1) {
            string key = keys[i];
            string val = row.Get(key);
            qb.Set(key, val);
        }
        return await db.ExecuteAsync(qb.BuildInsertParams(), qb.InsertParams());
    }

    // 为该模型开启 SELECT 查询构建器。
    public ModelQuery Select(IDbExecutor db) {
        return ModelQuery.NewSelect(db, this.tableName);
    }

    // 为该模型开启 UPDATE 查询构建器。
    public ModelUpdate UpdateQuery(IDbExecutor db) {
        return ModelUpdate.New(db, this.tableName);
    }

    // 为该模型开启 DELETE 查询构建器。
    public ModelDelete DeleteQuery(IDbExecutor db) {
        return ModelDelete.New(db, this.tableName);
    }

    // 按主键查找一行（参数化查询）。
    public ModelRow FindById(IDbExecutor db, int id) {
        string pk = this.primaryKey;
        if (pk.Length == 0) { pk = "id"; }
        string tbl = QueryBuilder.RequireIdent(this.tableName);
        string sql = "SELECT * FROM " + tbl + " WHERE " + QueryBuilder.RequireIdent(pk) + " = ?";
        DbParams ps = new DbParams();
        ps.AddInt(id);
        DbResult result = db.Query(sql, ps);
        if (result.RowCount() > 0) {
            return ModelRow.FromDbResult(result, 0);
        }
        return new ModelRow();
    }

    // 按主键查找一行（异步版本）。
    public async ModelRow FindByIdAsync(IDbExecutor db, int id) {
        string pk = this.primaryKey;
        if (pk.Length == 0) { pk = "id"; }
        string tbl = QueryBuilder.RequireIdent(this.tableName);
        string sql = "SELECT * FROM " + tbl + " WHERE " + QueryBuilder.RequireIdent(pk) + " = ?";
        DbParams ps = new DbParams();
        ps.AddInt(id);
        DbResult result = await db.QueryAsync(sql, ps);
        if (result.RowCount() > 0) {
            return ModelRow.FromDbResult(result, 0);
        }
        return new ModelRow();
    }

    // 统计表中的总行数（强制预编译参数化）。
    public int Count(IDbExecutor db) {
        string sql = "SELECT COUNT(*) FROM " + QueryBuilder.RequireIdent(this.tableName);
        string result = db.ExecuteScalar(sql, new DbParams());
        return Convert.ToInt(result);
    }

    // 异步统计表中的总行数（强制预编译参数化）。
    public async int CountAsync(IDbExecutor db) {
        string sql = "SELECT COUNT(*) FROM " + QueryBuilder.RequireIdent(this.tableName);
        string result = await db.ExecuteScalarAsync(sql, new DbParams());
        return Convert.ToInt(result);
    }

    // 统计满足条件的行数（强制预编译参数化，严禁裸拼值）。
    public int CountWhere(IDbExecutor db, string condition, DbParams ps) {
        string sql = "SELECT COUNT(*) FROM " + QueryBuilder.RequireIdent(this.tableName) + " WHERE " + condition;
        string result = db.ExecuteScalar(sql, ps != null ? ps : new DbParams());
        return Convert.ToInt(result);
    }

    // 异步统计满足条件的行数（强制预编译参数化，严禁裸拼值）。
    public async int CountWhereAsync(IDbExecutor db, string condition, DbParams ps) {
        string sql = "SELECT COUNT(*) FROM " + QueryBuilder.RequireIdent(this.tableName) + " WHERE " + condition;
        string result = await db.ExecuteScalarAsync(sql, ps != null ? ps : new DbParams());
        return Convert.ToInt(result);
    }

    // 按主键删除一行（参数化执行）。
    public void DeleteById(IDbExecutor db, int id) {
        string pk = this.primaryKey;
        if (pk.Length == 0) { pk = "id"; }
        DbParams ps = new DbParams();
        ps.AddInt(id);
        db.Execute("DELETE FROM " + QueryBuilder.RequireIdent(this.tableName) + " WHERE " + QueryBuilder.RequireIdent(pk) + " = ?", ps);
    }

    // 异步按主键删除一行（参数化执行）。
    public async int DeleteByIdAsync(IDbExecutor db, int id) {
        string pk = this.primaryKey;
        if (pk.Length == 0) { pk = "id"; }
        DbParams ps = new DbParams();
        ps.AddInt(id);
        return await db.ExecuteAsync("DELETE FROM " + QueryBuilder.RequireIdent(this.tableName) + " WHERE " + QueryBuilder.RequireIdent(pk) + " = ?", ps);
    }

    // 返回所有行（强制预编译参数化）。
    public List<ModelRow> All(IDbExecutor db) {
        DbResult result = db.Query("SELECT * FROM " + QueryBuilder.RequireIdent(this.tableName), new DbParams());
        return ModelRow.FromDbResultAll(result);
    }

    // 异步返回所有行（强制预编译参数化）。
    public async List<ModelRow> AllAsync(IDbExecutor db) {
        DbResult result = await db.QueryAsync("SELECT * FROM " + QueryBuilder.RequireIdent(this.tableName), new DbParams());
        return ModelRow.FromDbResultAll(result);
    }

    // 返回表名。
    public string GetTableName() {
        return this.tableName;
    }

    // 返回主键列名。
    public string GetPrimaryKey() {
        return this.primaryKey;
    }

    // ===== 反向映射：从已有表构建 Model =====
    // 与 CreateTable()（模型 -> 表）互补，提供表 -> 模型，即
    // ZanSql 的“数据库优先”方向。内省 SQL 由
    // 连接的 provider 决定；数据库原始列类型会原样保留。

    // 该模型定义的列数。
    public int ColumnCount() { return this.columns.Count; }

    // 索引 i 处的列名。
    public string ColumnNameAt(int i) { return this.columns[i].name; }

    // 索引 i 处的列类型（含 NOT NULL / PRIMARY KEY 后缀）。
    public string ColumnTypeAt(int i) { return this.columns[i].type; }

    // 忽略 ASCII 大小写比较两个字符串。
    public static bool EqIgnoreCase(string a, string b) {
        if (a.Length != b.Length) { return false; }
        for (int i = 0; i < a.Length; i = i + 1) {
            int ca = a[i] & 255;
            int cb = b[i] & 255;
            if (ca >= 65 && ca <= 90) { ca = ca + 32; }
            if (cb >= 65 && cb <= 90) { cb = cb + 32; }
            if (ca != cb) { return false; }
        }
        return true;
    }

    // 按列名（忽略大小写）在查询结果中找下标；未找到返回 -1。
    public static int ColIndex(DbResult r, string name) {
        List<string> cols = r.GetColumnNames();
        for (int i = 0; i < cols.Count; i = i + 1) {
            if (Model.EqIgnoreCase(cols[i], name)) { return i; }
        }
        return 0 - 1;
    }

    // 用 PRAGMA table_info 把 SQLite 表内省进模型。
    public void FillFromSqlite(IDbExecutor db, string t) {
        DbResult r = db.Query("PRAGMA table_info(" + t + ")");
        if (r == null) { return; }
        int ni = Model.ColIndex(r, "name");
        int ti = Model.ColIndex(r, "type");
        int nn = Model.ColIndex(r, "notnull");
        int pk = Model.ColIndex(r, "pk");
        for (int row = 0; row < r.RowCount(); row = row + 1) {
            string name = r.GetString(row, ni);
            string type = r.GetString(row, ti);
            bool isPk = pk >= 0 && r.GetString(row, pk) != "0"
                && r.GetString(row, pk) != "";
            bool notNull = nn >= 0 && r.GetString(row, nn) == "1";
            this.AddIntrospected(name, type, isPk, notNull);
        }
    }

    // 用 SHOW COLUMNS 把 MySQL/MariaDB 表内省进模型。
    public void FillFromMysql(IDbExecutor db, string t) {
        DbResult r = db.Query("SHOW COLUMNS FROM " + t);
        if (r == null) { return; }
        int ni = Model.ColIndex(r, "Field");
        int ti = Model.ColIndex(r, "Type");
        int nu = Model.ColIndex(r, "Null");
        int ky = Model.ColIndex(r, "Key");
        for (int row = 0; row < r.RowCount(); row = row + 1) {
            string name = r.GetString(row, ni);
            string type = r.GetString(row, ti);
            bool isPk = ky >= 0 && r.GetString(row, ky) == "PRI";
            bool notNull = nu >= 0 && Model.EqIgnoreCase(r.GetString(row, nu), "NO");
            this.AddIntrospected(name, type, isPk, notNull);
        }
    }

    // 用 information_schema.columns 内省表（PG / SQL Server 等 ANSI 目录），
    // 主键尽力从目录补取。
    public void FillFromInformationSchema(IDbExecutor db, string t) {
        DbResult r = db.Query("SELECT column_name, data_type, is_nullable "
            + "FROM information_schema.columns WHERE table_name = '" + t
            + "' ORDER BY ordinal_position");
        if (r == null) { return; }
        int ni = Model.ColIndex(r, "column_name");
        int ti = Model.ColIndex(r, "data_type");
        int nu = Model.ColIndex(r, "is_nullable");
        // 尽力获取主键列（ANSI catalog；PG / SQL Server）。
        string pkCol = Model.PrimaryKeyFromCatalog(db, t);
        for (int row = 0; row < r.RowCount(); row = row + 1) {
            string name = r.GetString(row, ni);
            string type = r.GetString(row, ti);
            bool isPk = pkCol.Length > 0 && Model.EqIgnoreCase(name, pkCol);
            bool notNull = nu >= 0 && Model.EqIgnoreCase(r.GetString(row, nu), "NO");
            this.AddIntrospected(name, type, isPk, notNull);
        }
    }

    // 用 DESCRIBE 内省 TDengine 表；首行 timestamp 列视作主键。
    public void FillFromTdengine(IDbExecutor db, string t) {
        DbResult r = db.Query("DESCRIBE " + t);
        if (r == null) { return; }
        int ni = Model.ColIndex(r, "field");
        int ti = Model.ColIndex(r, "type");
        int li = Model.ColIndex(r, "length");
        for (int row = 0; row < r.RowCount(); row = row + 1) {
            string name = r.GetString(row, ni);
            string type = r.GetString(row, ti);
            // BINARY/NCHAR 的宽度存放在单独的列中。
            if (li >= 0 && (Model.EqIgnoreCase(type, "BINARY")
                    || Model.EqIgnoreCase(type, "VARCHAR")
                    || Model.EqIgnoreCase(type, "NCHAR"))) {
                type = type + "(" + r.GetString(row, li) + ")";
            }
            // DESCRIBE 会把 timestamp 列列在第一位；它是每个
            // TDengine 表排序和查询所依据的键。
            this.AddIntrospected(name, type, row == 0, row == 0);
        }
    }

    // 从 ANSI 目录查表的主键列名；无主键或查询失败时返回空串。
    public static string PrimaryKeyFromCatalog(IDbExecutor db, string t) {
        DbResult r = db.Query("SELECT kcu.column_name "
            + "FROM information_schema.table_constraints tc "
            + "JOIN information_schema.key_column_usage kcu "
            + "ON tc.constraint_name = kcu.constraint_name "
            + "WHERE tc.table_name = '" + t
            + "' AND tc.constraint_type = 'PRIMARY KEY'");
        if (r == null) { return ""; }
        if (r.RowCount() == 0) { return ""; }
        return r.GetString(0, 0);
    }

    // 追加内省得到的列，按需附加 PRIMARY KEY / NOT NULL 后缀。
    public void AddIntrospected(string name, string type, bool isPk, bool notNull) {
        string ident = QueryBuilder.RequireIdent(name);
        if (isPk) {
            this.columns.Add(new ModelColumn(ident, type + " PRIMARY KEY"));
            this.primaryKey = ident;
        } else if (notNull) {
            this.columns.Add(new ModelColumn(ident, type + " NOT NULL"));
        } else {
            this.columns.Add(new ModelColumn(ident, type));
        }
    }

    // 通过反射现有表结构来构建 Model（即
    // “数据库优先”方向）。Provider 自动检测：SQLite 使用
    // PRAGMA table_info，MySQL/MariaDB 使用 SHOW COLUMNS，TDengine 使用
    // DESCRIBE，其余情况回退到 ANSI information_schema
    // 目录。原始 DB 列类型会被保留，以便后续
    // CreateTable() 能够往返重建。
    public static Model FromTable(IDbExecutor db, string tableName) {
        Model m = new Model(tableName);
        if (db == null) { return m; }
        int p = db.GetProvider();
        if (p == DbProvider.SQLite) {
            m.FillFromSqlite(db, tableName);
        } else if (p == DbProvider.MySQL || p == DbProvider.MariaDB) {
            m.FillFromMysql(db, tableName);
        } else if (p == DbProvider.TDengine) {
            m.FillFromTdengine(db, tableName);
        } else {
            m.FillFromInformationSchema(db, tableName);
        }
        return m;
    }

    // 去掉类型文本尾部的 PRIMARY KEY / NOT NULL / UNIQUE 修饰。
    public static string StripMods(string type) {
        string t = type;
        int at = Model.IndexOfSub(t, " PRIMARY KEY");
        if (at >= 0) { t = t.Substring(0, at); }
        at = Model.IndexOfSub(t, " NOT NULL");
        if (at >= 0) { t = t.Substring(0, at); }
        at = Model.IndexOfSub(t, " UNIQUE");
        if (at >= 0) { t = t.Substring(0, at); }
        return t;
    }

    // 朴素子串查找，返回首个下标；未找到返回 -1。
    public static int IndexOfSub(string s, string sub) {
        int n = s.Length;
        int m = sub.Length;
        if (m == 0) { return 0; }
        for (int i = 0; i + m <= n; i = i + 1) {
            if (s.Substring(i, m) == sub) { return i; }
        }
        return 0 - 1;
    }

    // 生成重建该模型的 Zan 源码，形式为
    // Model.Define(...) 链式调用——方便从现有表
    // 生成模型文件骨架（`FromTable(...).ToDefineCode()`）。
    public string ToDefineCode() {
        StringBuilder sb = new StringBuilder();
        sb.Append("Model.Define(\"");
        sb.Append(this.tableName);
        sb.Append("\")");
        foreach (ModelColumn col in this.columns) {
            string nm = col.name;
            string ty = col.type;
            string bt = Model.StripMods(ty);
            if (nm == this.primaryKey) {
                sb.Append("\n    .Column(\"");
                sb.Append(nm); sb.Append("\", \""); sb.Append(bt);
                sb.Append("\", true)");
            } else if (Model.IndexOfSub(ty, " NOT NULL") >= 0) {
                sb.Append("\n    .ColumnNotNull(\"");
                sb.Append(nm); sb.Append("\", \""); sb.Append(bt); sb.Append("\")");
            } else {
                sb.Append("\n    .Column(\"");
                sb.Append(nm); sb.Append("\", \""); sb.Append(bt); sb.Append("\")");
            }
        }
        sb.Append(";");
        return sb.ToString();
    }
}
