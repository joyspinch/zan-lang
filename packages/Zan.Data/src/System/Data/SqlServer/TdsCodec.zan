using System;
using System.Data;

namespace System.Data.SqlServer;

/// <summary>
/// 用于构建 TDS 消息的字节缓冲区。字节先收集到列表，
/// 最后一次性生成，编码器无需进行指针运算；
/// 生成的 Zan 字符串是纯字节数组，保持二进制安全（包括
/// 内嵌的 NUL 字节）。
/// </summary>
class TdsBuf {
    List<int> b;

    /// <summary>分配 <paramref name="n"/> 字节的零填充块，
    /// 供逐字节拼接文本的解码器使用。</summary>
    static byte[] Alloc(int n) { return new byte[n + 1]; }

    /// 私有构造；缓冲区经 <see cref="Alloc"/> 风格的写入方法累积。
    TdsBuf() {
        this.b = new List<int>();
    }

    /// 当前字节数。
    int Count() { return this.b.Count; }
    /// 下标 i 处的字节。
    int At(int i) { return this.b[i]; }
    /// 覆写下标 i 处的字节（回填长度/状态位用）。
    internal void SetAt(int i, int v) { this.b[i] = v & 255; }

    /// 追加单字节，返回自身以链式写入。
    TdsBuf U8(int v) {
        this.b.Add(v & 255);
        return this;
    }

    /// 追加两字节小端整数。
    TdsBuf U16LE(int v) {
        this.b.Add(v & 255);
        this.b.Add((v >> 8) & 255);
        return this;
    }

    /// 追加两字节大端整数（BLOB 块头等大端字段用）。
    TdsBuf U16BE(int v) {
        this.b.Add((v >> 8) & 255);
        this.b.Add(v & 255);
        return this;
    }

    /// 追加四字节小端整数。
    TdsBuf U32LE(int v) {
        this.b.Add(v & 255);
        this.b.Add((v >> 8) & 255);
        this.b.Add((v >> 16) & 255);
        this.b.Add((v >> 24) & 255);
        return this;
    }

    /// 追加四字节大端整数。
    TdsBuf U32BE(int v) {
        this.b.Add((v >> 24) & 255);
        this.b.Add((v >> 16) & 255);
        this.b.Add((v >> 8) & 255);
        this.b.Add(v & 255);
        return this;
    }

    /// <summary>八字节小端整数（行数、事务
    /// 描述符、money）。</summary>
    TdsBuf U64LE(long v) {
        for (int i = 0; i < 8; i = i + 1) {
            this.b.Add((int)((v >> (i * 8)) & 255));
        }
        return this;
    }

    /// <summary>Zan 字符串的原始字节，直到其 NUL 终止符。</summary>
    TdsBuf Bytes(string s) {
        for (int i = 0; i < s.Length; i = i + 1) {
            this.b.Add(s[i] & 255);
        }
        return this;
    }

    /// <summary>追加一段带长度的字节块。</summary>
    TdsBuf Block(TdsBytes src) {
        for (int i = 0; i < src.Len(); i = i + 1) {
            this.b.Add(src.At(i));
        }
        return this;
    }

    /// <summary>UCS-2LE 文本，TDS 中所有字符串使用的编码。</summary>
    TdsBuf Ucs2(string s) {
        for (int i = 0; i < s.Length; i = i + 1) {
            this.b.Add(s[i] & 255);
            this.b.Add(0);
        }
        return this;
    }

    /// <summary>密码字段经过混淆（半字节交换，再 XOR 0xA5），
    /// 而非加密——这只是混淆，因此正式
    /// 部署时应通过 TLS 进行登录。</summary>
    TdsBuf Password(string s) {
        for (int i = 0; i < s.Length; i = i + 1) {
            int lo = s[i] & 15;
            int hi = (s[i] >> 4) & 15;
            this.b.Add(((lo << 4) | hi) ^ 165);
            this.b.Add(165);   // UCS-2 单元的高字节：0x00 混淆后
        }
        return this;
    }

    /// <summary>生成最终缓冲区。结果自带长度，
    /// 因为 Zan 字符串以第一个 NUL 结尾，而 TDS 消息中满是
    /// 零字节。</summary>
    TdsBytes ToBytes() {
        int n = this.b.Count;
        byte[] t = new byte[n + 1];
        for (int i = 0; i < n; i = i + 1) {
            t[i] = (byte)(this.b[i] & 255);
        }
        return TdsBytes.Own(t, n);
    }
}

/// <summary>
/// 带长度的字节块。Zan 字符串以 NUL 结尾，因此任何二进制数据
/// 都必须与长度一起传递；此类将两者绑定并持有
/// 内存分配。
/// </summary>
class TdsBytes {
    byte[] data;
    int len;

    /// 私有构造；统一经 <see cref="Own"/>/<see cref="Of"/>/<see cref="Alloc"/> 创建。
    TdsBytes(byte[] data, int len) {
        this.data = data;
        this.len = len;
    }

    /// <summary>包装现有缓冲区及其长度。</summary>
    static TdsBytes Own(byte[] data, int len) {
        return new TdsBytes(data, len);
    }

    /// <summary>将 Zan 字符串的字节复制为带长度的块。</summary>
    static TdsBytes Of(string s) {
        int n = s.Length;
        byte[] t = new byte[n + 1];
        for (int i = 0; i < n; i = i + 1) {
            t[i] = (byte)(s[i] & 255);
        }
        return new TdsBytes(t, n);
    }

    /// 分配 n 字节的零填充块。
    static TdsBytes Alloc(int n) {
        return new TdsBytes(new byte[n + 1], n);
    }

    /// 底层缓冲区（自带 NUL 终止，内容按长度解读）。
    byte[] Data() { return this.data; }
    /// 有效字节数。
    int Len() { return this.len; }
    /// 下标 i 处的字节。
    int At(int i) { return this.data[i] & 255; }
    /// 覆写下标 i 处的字节。
    void SetAt(int i, int v) { this.data[i] = (byte)(v & 255); }

    /// <summary>释放缓冲区，以便立即回收。</summary>
    void Release() {
        this.data = null;
        this.len = 0;
    }
}

/// <summary>接收到的字节缓冲区上的游标。</summary>
class TdsReader {
    string buf;
    int pos;
    int len;

    /// 私有构造；统一经 <see cref="Over"/> 创建。
    TdsReader(string buf, int len) {
        this.buf = buf;
        this.pos = 0;
        this.len = len;
    }

    /// 游标覆盖整段缓冲区。
    static TdsReader Over(string buf) {
        return new TdsReader(buf, buf.Length);
    }

    /// 游标只覆盖缓冲区前 len 字节（消息体短于缓冲区时用）。
    static TdsReader Over(string buf, int len) {
        return new TdsReader(buf, len);
    }

    /// 游标覆盖一个带长度的字节块。
    static TdsReader Over(TdsBytes b) {
        return new TdsReader(b.Data(), b.Len());
    }

    /// 当前读取位置。
    int Pos() { return this.pos; }
    /// 距末尾剩余的字节数。
    int Left() { return this.len - this.pos; }
    /// 是否已读到末尾。
    bool Eof() { return this.pos >= this.len; }
    /// 跳到绝对位置 p。
    void Seek(int p) { this.pos = p; }

    /// 读取单字节；越过末尾返回 0（各 U* 同此约定）。
    int U8() {
        if (this.pos >= this.len) { return 0; }
        int v = this.buf[this.pos] & 255;
        this.pos = this.pos + 1;
        return v;
    }

    /// 读取两字节小端整数。
    int U16LE() {
        int a = U8();
        int b = U8();
        return a | (b << 8);
    }

    /// 读取两字节大端整数。
    int U16BE() {
        int a = U8();
        int b = U8();
        return (a << 8) | b;
    }

    /// 读取四字节小端整数。
    int U32LE() {
        int a = U16LE();
        int b = U16LE();
        return a | (b << 16);
    }

    /// 读取四字节大端整数。
    int U32BE() {
        int a = U16BE();
        int b = U16BE();
        return (a << 16) | b;
    }

    /// <summary>1..8 字节的无符号小端整数。结果用
    /// <c>long</c> 表示：八字节字段（bigint、MONEY、PLP 长度）以及完整
    /// 的无符号四字节范围都超出 <c>int</c>。</summary>
    long UIntLE(int n) {
        long v = 0;
        for (int i = 0; i < n; i = i + 1) {
            v = v | ((long)U8() << (i * 8));
        }
        return v;
    }

    /// <summary>1..8 字节的有符号小端整数。</summary>
    long IntLE(int n) {
        long v = UIntLE(n);
        int bits = n * 8;
        if (bits < 64) {
            long sign = (long)1 << (bits - 1);
            if ((v & sign) != 0) {
                v = v - (sign << 1);
            }
        }
        return v;
    }

    /// 向前跳过 n 字节（截停在末尾，不报错）。
    void Skip(int n) {
        this.pos = this.pos + n;
        if (this.pos > this.len) { this.pos = this.len; }
    }

    /// <summary>读取 <paramref name="n"/> 字节的单字节文本。其中的任何 NUL
    /// 都会截断生成的 Zan 字符串，这与这类文本的用法一致。</summary>
    string Narrow(int n) {
        if (n <= 0) { return ""; }
        if (this.pos + n > this.len) { n = this.len - this.pos; }
        byte[] t = TdsBuf.Alloc(n);
        for (int i = 0; i < n; i = i + 1) {
            t[i] = (byte)(this.buf[this.pos + i] & 255);
        }
        this.pos = this.pos + n;
        return t.ToStr(0, n);
    }

    /// <summary>读取 <paramref name="n"/> 个原始字节，作为带长度的块返回。</summary>
    TdsBytes Raw(int n) {
        if (n < 0) { n = 0; }
        if (this.pos + n > this.len) { n = this.len - this.pos; }
        TdsBytes b = TdsBytes.Alloc(n);
        for (int i = 0; i < n; i = i + 1) {
            b.SetAt(i, this.buf[this.pos + i] & 255);
        }
        this.pos = this.pos + n;
        return b;
    }

    /// <summary>读取 <paramref name="chars"/> 个代码单元的 UCS-2LE 文本。
    /// 高于 U+00FF 的单元渲染为 '?'，解码器无需
    /// 引入完整转码器即可保持完备；其余单元保留原字节值。</summary>
    string Ucs2(int chars) {
        if (chars <= 0) { return ""; }
        byte[] t = new byte[chars + 1];
        for (int i = 0; i < chars; i = i + 1) {
            int lo = U8();
            int hi = U8();
            if (hi != 0) {
                t[i] = 63;      // '?'
            } else {
                t[i] = (byte)lo;
            }
        }
        return t.ToStr(0, chars);
    }

    /// <summary>B_VARCHAR：一个长度字节，后跟相应数量的 UCS-2 单元。</summary>
    string BVarchar() {
        return Ucs2(U8());
    }

    /// <summary>US_VARCHAR：两字节长度，后跟相应数量的 UCS-2 单元。</summary>
    string UsVarchar() {
        return Ucs2(U16LE());
    }
}
