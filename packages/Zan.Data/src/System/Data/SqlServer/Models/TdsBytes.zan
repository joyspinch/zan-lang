using System;

namespace System.Data.SqlServer;

// 带长度的字节块。Zan 字符串以 NUL 结尾，因此任何二进制数据
// 都必须与长度一起传递；此类将两者绑定并持有
// 内存分配。
public class TdsBytes {
    public byte[] data;
    public int len;

    // 构造；或经 <see cref="Own"/>/<see cref="Of"/>/<see cref="Alloc"/> 创建。
    public TdsBytes(byte[] data, int len) {
        this.data = data;
        this.len = len;
    }

    // 包装现有缓冲区及其长度。
    public static TdsBytes Own(byte[] data, int len) {
        return new TdsBytes(data, len);
    }

    // 将 Zan 字符串的字节复制为带长度的块。
    public static TdsBytes Of(string s) {
        int n = s.Length;
        byte[] t = new byte[n + 1];
        for (int i = 0; i < n; i = i + 1) {
            t[i] = (byte)(s[i] & 255);
        }
        return new TdsBytes(t, n);
    }

    // 分配 n 字节的零填充块。
    public static TdsBytes Alloc(int n) {
        return new TdsBytes(new byte[n + 1], n);
    }

    // 底层缓冲区（自带 NUL 终止，内容按长度解读）。
    public byte[] Data() { return this.data; }
    // 有效字节数。
    public int Len() { return this.len; }
    // 下标 i 处的字节。
    public int At(int i) { return this.data[i] & 255; }
    // 覆写下标 i 处的字节。
    public void SetAt(int i, int v) { this.data[i] = (byte)(v & 255); }

    // 释放缓冲区，以便立即回收。
    public void Release() {
        this.data = null;
        this.len = 0;
    }
}
