using System;
using System.Data;

namespace System.Data.SqlServer;

// 用于构建 TDS 消息的字节缓冲区。字节先收集到列表，
// 最后一次性生成，编码器无需进行指针运算；
// 生成的 Zan 字符串是纯字节数组，保持二进制安全（包括
// 内嵌的 NUL 字节）。
public class TdsBuf {
    private byte[] buf;
    private int len;

    // 分配 n 字节的零填充块，供逐字节拼接文本的解码器使用。
    public static byte[] Alloc(int n) { return new byte[n + 1]; }

    // 构造；缓冲区经链式写入方法累积。
    public TdsBuf() {
        this.buf = new byte[64];
        this.len = 0;
    }

    private void Ensure(int add) {
        int need = this.len + add;
        if (need <= this.buf.Length) { return; }
        int cap = this.buf.Length * 2;
        while (cap < need) { cap = cap * 2; }
        byte[] next = new byte[cap];
        if (this.len > 0) {
            NativeMemory.Copy((nint)next, (nint)this.buf, (long)this.len);
        }
        this.buf = next;
    }

    // 当前字节数。
    public int Count() { return this.len; }
    // 下标 i 处的字节。
    public int At(int i) { return this.buf[i] & 255; }
    // 覆写下标 i 处的字节（回填长度/状态位用）。
    public void SetAt(int i, int v) { this.buf[i] = (byte)(v & 255); }

    // 追加单字节，返回自身以链式写入。
    public TdsBuf U8(int v) {
        this.Ensure(1);
        this.buf[this.len] = (byte)(v & 255);
        this.len = this.len + 1;
        return this;
    }

    // 追加两字节小端整数。
    public TdsBuf U16LE(int v) {
        this.Ensure(2);
        this.buf[this.len] = (byte)(v & 255);
        this.buf[this.len + 1] = (byte)((v >> 8) & 255);
        this.len = this.len + 2;
        return this;
    }

    // 追加两字节大端整数（BLOB 块头等大端字段用）。
    public TdsBuf U16BE(int v) {
        this.Ensure(2);
        this.buf[this.len] = (byte)((v >> 8) & 255);
        this.buf[this.len + 1] = (byte)(v & 255);
        this.len = this.len + 2;
        return this;
    }

    // 追加四字节小端整数。
    public TdsBuf U32LE(int v) {
        this.Ensure(4);
        this.buf[this.len] = (byte)(v & 255);
        this.buf[this.len + 1] = (byte)((v >> 8) & 255);
        this.buf[this.len + 2] = (byte)((v >> 16) & 255);
        this.buf[this.len + 3] = (byte)((v >> 24) & 255);
        this.len = this.len + 4;
        return this;
    }

    // 追加四字节大端整数。
    public TdsBuf U32BE(int v) {
        this.Ensure(4);
        this.buf[this.len] = (byte)((v >> 24) & 255);
        this.buf[this.len + 1] = (byte)((v >> 16) & 255);
        this.buf[this.len + 2] = (byte)((v >> 8) & 255);
        this.buf[this.len + 3] = (byte)(v & 255);
        this.len = this.len + 4;
        return this;
    }

    // 八字节小端整数（行数、事务
    // 描述符、money）。
    public TdsBuf U64LE(long v) {
        this.Ensure(8);
        for (int i = 0; i < 8; i = i + 1) {
            this.buf[this.len + i] = (byte)((v >> (i * 8)) & 255);
        }
        this.len = this.len + 8;
        return this;
    }

    // 批量追加字符串切片的原始字节（零逐字节循环，PLP 分块热路径专用）。
    public TdsBuf BytesSlice(string s, int off, int count) {
        if (s == null || count <= 0) { return this; }
        this.Ensure(count);
        NativeMemory.Copy((nint)this.buf + (nint)this.len, (nint)s + (nint)off, (long)count);
        this.len = this.len + count;
        return this;
    }

    // Zan 字符串的原始字节。
    public TdsBuf Bytes(string s) {
        if (s == null || s.Length == 0) { return this; }
        return this.BytesSlice(s, 0, s.Length);
    }

    // 追加一段带长度的字节块。
    public TdsBuf Block(TdsBytes src) {
        if (src == null || src.Len() <= 0) { return this; }
        return this.BytesSlice(src.Data(), 0, src.Len());
    }

    // UCS-2LE 文本，TDS 中所有字符串使用的编码。
    public TdsBuf Ucs2(string s) {
        if (s == null || s.Length == 0) { return this; }
        int n = s.Length;
        this.Ensure(n * 2);
        int p = this.len;
        for (int i = 0; i < n; i = i + 1) {
            this.buf[p] = (byte)(s[i] & 255);
            this.buf[p + 1] = 0;
            p = p + 2;
        }
        this.len = p;
        return this;
    }

    // 密码字段经过混淆（半字节交换，再 XOR 0xA5），
    // 而非加密——这只是混淆，因此正式
    // 部署时应通过 TLS 进行登录。
    public TdsBuf Password(string s) {
        if (s == null || s.Length == 0) { return this; }
        int n = s.Length;
        this.Ensure(n * 2);
        int p = this.len;
        for (int i = 0; i < n; i = i + 1) {
            int lo = s[i] & 15;
            int hi = (s[i] >> 4) & 15;
            this.buf[p] = (byte)(((lo << 4) | hi) ^ 165);
            this.buf[p + 1] = 165;  // UCS-2 单元的高字节：0x00 混淆后
            p = p + 2;
        }
        this.len = p;
        return this;
    }

    // 生成最终缓冲区。结果自带长度，
    // 因为 Zan 字符串以第一个 NUL 结尾，而 TDS 消息中满是
    // 零字节。
    public TdsBytes ToBytes() {
        int n = this.len;
        byte[] t = new byte[n + 1];
        if (n > 0) {
            NativeMemory.Copy((nint)t, (nint)this.buf, (long)n);
        }
        return TdsBytes.Own(t, n);
    }
}
