using System;
using System.Data;

namespace System.Data.SqlServer;

// 用于构建 TDS 消息的字节缓冲区。字节先收集到列表，
// 最后一次性生成，编码器无需进行指针运算；
// 生成的 Zan 字符串是纯字节数组，保持二进制安全（包括
// 内嵌的 NUL 字节）。
public class TdsBuf {
    public List<int> b;

    // 分配 <paramref name="n"/> 字节的零填充块，
    // 供逐字节拼接文本的解码器使用。
    public static byte[] Alloc(int n) { return new byte[n + 1]; }

    // 构造；缓冲区经 <see cref="Alloc"/> 风格的写入方法累积。
    public TdsBuf() {
        this.b = new List<int>();
    }

    // 当前字节数。
    public int Count() { return this.b.Count; }
    // 下标 i 处的字节。
    public int At(int i) { return this.b[i]; }
    // 覆写下标 i 处的字节（回填长度/状态位用）。
    public void SetAt(int i, int v) { this.b[i] = v & 255; }

    // 追加单字节，返回自身以链式写入。
    public TdsBuf U8(int v) {
        this.b.Add(v & 255);
        return this;
    }

    // 追加两字节小端整数。
    public TdsBuf U16LE(int v) {
        this.b.Add(v & 255);
        this.b.Add((v >> 8) & 255);
        return this;
    }

    // 追加两字节大端整数（BLOB 块头等大端字段用）。
    public TdsBuf U16BE(int v) {
        this.b.Add((v >> 8) & 255);
        this.b.Add(v & 255);
        return this;
    }

    // 追加四字节小端整数。
    public TdsBuf U32LE(int v) {
        this.b.Add(v & 255);
        this.b.Add((v >> 8) & 255);
        this.b.Add((v >> 16) & 255);
        this.b.Add((v >> 24) & 255);
        return this;
    }

    // 追加四字节大端整数。
    public TdsBuf U32BE(int v) {
        this.b.Add((v >> 24) & 255);
        this.b.Add((v >> 16) & 255);
        this.b.Add((v >> 8) & 255);
        this.b.Add(v & 255);
        return this;
    }

    // 八字节小端整数（行数、事务
    // 描述符、money）。
    public TdsBuf U64LE(long v) {
        for (int i = 0; i < 8; i = i + 1) {
            this.b.Add((int)((v >> (i * 8)) & 255));
        }
        return this;
    }

    // Zan 字符串的原始字节，直到其 NUL 终止符。
    public TdsBuf Bytes(string s) {
        for (int i = 0; i < s.Length; i = i + 1) {
            this.b.Add(s[i] & 255);
        }
        return this;
    }

    // 追加一段带长度的字节块。
    public TdsBuf Block(TdsBytes src) {
        for (int i = 0; i < src.Len(); i = i + 1) {
            this.b.Add(src.At(i));
        }
        return this;
    }

    // UCS-2LE 文本，TDS 中所有字符串使用的编码。
    public TdsBuf Ucs2(string s) {
        for (int i = 0; i < s.Length; i = i + 1) {
            this.b.Add(s[i] & 255);
            this.b.Add(0);
        }
        return this;
    }

    // 密码字段经过混淆（半字节交换，再 XOR 0xA5），
    // 而非加密——这只是混淆，因此正式
    // 部署时应通过 TLS 进行登录。
    public TdsBuf Password(string s) {
        for (int i = 0; i < s.Length; i = i + 1) {
            int lo = s[i] & 15;
            int hi = (s[i] >> 4) & 15;
            this.b.Add(((lo << 4) | hi) ^ 165);
            this.b.Add(165);  // UCS-2 单元的高字节：0x00 混淆后
        }
        return this;
    }

    // 生成最终缓冲区。结果自带长度，
    // 因为 Zan 字符串以第一个 NUL 结尾，而 TDS 消息中满是
    // 零字节。
    public TdsBytes ToBytes() {
        int n = this.b.Count;
        byte[] t = new byte[n + 1];
        for (int i = 0; i < n; i = i + 1) {
            t[i] = (byte)(this.b[i] & 255);
        }
        return TdsBytes.Own(t, n);
    }
}
