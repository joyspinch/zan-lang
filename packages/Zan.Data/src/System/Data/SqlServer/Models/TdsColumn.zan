using System;

namespace System.Data.SqlServer;

// COLMETADATA 描述的结果集的一列。
public class TdsColumn {
    public string name;
    public int type;
    // 声明长度；0xFFFF 表示 MAX (PLP) 列。
    public int size;  // 声明长度；0xFFFF 表示 MAX (PLP) 列
    public int precision;
    public int scale;

    // 空列描述，经 <see cref="TdsValue.ReadTypeInfo"/> 填充。
    public TdsColumn() {
        this.name = "";
        this.type = 0;
        this.size = 0;
        this.precision = 0;
        this.scale = 0;
    }

    // 列名。
    public string Name() { return this.name; }
    // TDS 类型 ID。
    public int Type() { return this.type; }
    // 声明长度；0xFFFF 表示 MAX (PLP) 列。
    public int Size() { return this.size; }
    // 小数位数（时间/数值类型）。
    public int Scale() { return this.scale; }
    // 精度（DECIMAL/NUMERIC）。
    public int Precision() { return this.precision; }
}
