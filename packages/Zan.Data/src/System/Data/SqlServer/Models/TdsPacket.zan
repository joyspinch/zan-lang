using System;

namespace System.Data.SqlServer;

// TDS 报文类型及报文头的状态位。
public class TdsPacket {
    // 报文类型 0x01：SQL 语句批处理。
    public static int SQLBATCH = 1;  // 0x01
    // 报文类型 0x03：RPC 调用（sp_executesql）。
    public static int RPC      = 3;  // 0x03
    // 报文类型 0x04：服务器响应。
    public static int REPLY    = 4;  // 0x04
    // 报文类型 0x06：Attention（取消当前请求）。
    public static int ATTENTION = 6;  // 0x06
    // 报文类型 0x10：登录请求。
    public static int LOGIN7   = 16;  // 0x10
    // 报文类型 0x12：登录前协商。
    public static int PRELOGIN = 18;  // 0x12

    // 状态位 0x00：消息未结束（后续还有包）。
    public static int STATUS_NORMAL = 0;
    // 状态位 0x01：EOM，本消息的最后一个包。
    public static int STATUS_EOM    = 1;

    // 报文头长度（字节）。
    public static int HEADER_LEN = 8;
    // 登录时协商的默认包大小。
    public static int DEFAULT_SIZE = 4096;

    // 将载荷包进八字节报文头。
    // 长度字段包含报文头本身且为大端序，与协议中其他
    // 整数不同。
    public static TdsBytes Frame(int type, int status, int packetId, TdsBytes payload,
            int off, int len) {
        TdsBuf b = new TdsBuf();
        b.U8(type);
        b.U8(status);
        b.U16BE(len + TdsPacket.HEADER_LEN);
        b.U16BE(0);  // SPID
        b.U8(packetId & 255);
        b.U8(0);  // window
        for (int i = 0; i < len; i = i + 1) {
            b.U8(payload.At(off + i));
        }
        return b.ToBytes();
    }
}
