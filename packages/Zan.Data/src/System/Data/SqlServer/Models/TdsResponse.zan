using System;
using System.Data;

namespace System.Data.SqlServer;

// 解码一条 TDS 响应消息的结果。
public class TdsResponse {
    public DbResult rows;
    public int affected;
    public string error;
    public int errorNumber;
    public string serverVersion;
    public string database;

    // 构造；经 <see cref="TdsMessage.Decode"/> 填充。
    public TdsResponse() {
        this.rows = new DbResult();
        this.affected = 0;
        this.error = "";
        this.errorNumber = 0;
        this.serverVersion = "";
        this.database = "";
    }

    // 结果集（无结果集时为空结果）。
    public DbResult Rows() { return this.rows; }
    // 受影响行数（有结果集时等于行数）。
    public int Affected() { return this.affected; }
    // 第一条 ERROR token 的消息文本；无错为 ""。
    public string Error() { return this.error; }
    // 服务器自身的错误号；无错为 0。
    public int ErrorNumber() { return this.errorNumber; }
    // LOGINACK 报告的服务器版本。
    public string ServerVersion() { return this.serverVersion; }
    // ENVCHANGE 报告的会话数据库。
    public string Database() { return this.database; }
    // 服务器是否拒绝了请求（<see cref="Error"/> 非空）。
    public bool Failed() { return this.error.Length > 0; }
}
