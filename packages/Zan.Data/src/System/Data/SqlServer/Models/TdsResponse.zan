using System;
using System.Data;

namespace System.Data.SqlServer;

// 解码一条 TDS 响应消息的结果。
class TdsResponse {
    DbResult rows;
    int affected;
    string error;
    int errorNumber;
    string serverVersion;
    string database;

    // 私有构造；经 <see cref="TdsMessage.Decode"/> 填充。
    TdsResponse() {
        this.rows = new DbResult();
        this.affected = 0;
        this.error = "";
        this.errorNumber = 0;
        this.serverVersion = "";
        this.database = "";
    }

    // 结果集（无结果集时为空结果）。
    DbResult Rows() { return this.rows; }
    // 受影响行数（有结果集时等于行数）。
    int Affected() { return this.affected; }
    // 第一条 ERROR token 的消息文本；无错为 ""。
    string Error() { return this.error; }
    // 服务器自身的错误号；无错为 0。
    int ErrorNumber() { return this.errorNumber; }
    // LOGINACK 报告的服务器版本。
    string ServerVersion() { return this.serverVersion; }
    // ENVCHANGE 报告的会话数据库。
    string Database() { return this.database; }
    // 服务器是否拒绝了请求（<see cref="Error"/> 非空）。
    bool Failed() { return this.error.Length > 0; }
}
