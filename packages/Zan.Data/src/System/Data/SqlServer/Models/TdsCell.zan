using System;

namespace System.Data.SqlServer;

// 一个解码后的单元格：NULL 与空字符串不同，因此
// 仅凭文本无法表达这一区别。整型值（INT2/INT4/INT8/INTN）额外
// 以 ival 携带（intKind 1），行组装直接产出类型化
// DbCell，免一次十进制格式化-重解析往返。
public class TdsCell {
    public string text;
    public bool isNull;
    // intKind 1 时的 64 位整数值。
    public long ival;
    // 0 = 文本/NULL；1 = 整数（ival 有效）。
    public int intKind;

    // 构造；或经 <see cref="Of"/>/<see cref="Null"/> 创建。
    public TdsCell(string text, bool isNull) {
        this.text = text;
        this.isNull = isNull;
        this.ival = 0;
        this.intKind = 0;
    }

    // 非空单元格。
    public static TdsCell Of(string text) { return new TdsCell(text, false); }
    // NULL 单元格（文本为空串但 <see cref="IsNull"/> 为 true）。
    public static TdsCell Null() { return new TdsCell("", true); }
    // 整数单元格（文本惰性格式化，仅诊断路径需要）。
    public static TdsCell OfInt(long v) {
        TdsCell c = new TdsCell("", false);
        c.intKind = 1;
        c.ival = v;
        return c;
    }

    // 单元格文本（NULL 时为空串）。
    public string Text() { return this.text; }
    // 是否为 SQL NULL。
    public bool IsNull() { return this.isNull; }
    // 是否携带整数值（<see cref="IVal"/> 有效）。
    public int IntKind() { return this.intKind; }
    // 整数值（<see cref="IntKind"/> 为 1 时有效）。
    public long IVal() { return this.ival; }
}
