using System;
using System.Data;

namespace System.Data.SqlServer;

// 接收到的字节缓冲区上的游标。
public class TdsReader {
    public string buf;
    public int pos;
    public int len;

    // 构造；或经 Over 创建。
    public TdsReader(string buf, int len) {
        this.buf = buf;
        this.pos = 0;
        int blen = buf != null ? buf.Length : 0;
        int l = len;
        if (l < 0) { l = 0; }
        if (l > blen) { l = blen; }
        this.len = l;
    }

    // 游标覆盖整段缓冲区。
    public static TdsReader Over(string buf) {
        return new TdsReader(buf, buf != null ? buf.Length : 0);
    }

    // 游标只覆盖缓冲区前 len 字节（消息体短于缓冲区时用）。
    public static TdsReader Over(string buf, int len) {
        return new TdsReader(buf, len);
    }

    // 游标覆盖一个带长度的字节块。
    public static TdsReader Over(TdsBytes b) {
        if (b == null) { return new TdsReader("", 0); }
        return new TdsReader(b.Data(), b.Len());
    }

    // 当前读取位置。
    public int Pos() { return this.pos; }
    // 距末尾剩余的字节数。
    public int Left() {
        int rem = this.len - this.pos;
        return rem > 0 ? rem : 0;
    }
    // 是否已读到末尾。
    public bool Eof() { return this.pos >= this.len; }
    // 跳到绝对位置 p。
    public void Seek(int p) {
        if (p < 0) { this.pos = 0; }
        else if (p > this.len) { this.pos = this.len; }
        else { this.pos = p; }
    }

    // 读取单字节；越过末尾返回 0（各 U* 同此约定）。
    public int U8() {
        if (this.pos < 0 || this.pos >= this.len || this.buf == null) { return 0; }
        int v = this.buf[this.pos] & 255;
        this.pos = this.pos + 1;
        return v;
    }

    // 读取两字节小端整数。
    public int U16LE() {
        int a = U8();
        int b = U8();
        return a | (b << 8);
    }

    // 读取两字节大端整数。
    public int U16BE() {
        int a = U8();
        int b = U8();
        return (a << 8) | b;
    }

    // 读取四字节小端整数。
    public int U32LE() {
        int a = U16LE();
        int b = U16LE();
        return a | (b << 16);
    }

    // 读取四字节大端整数。
    public int U32BE() {
        int a = U16BE();
        int b = U16BE();
        return (a << 16) | b;
    }

    // 1..8 字节的无符号小端整数（用 long 覆盖 64 位字段及无符号 32 位全范围）。
    public long UIntLE(int n) {
        if (n <= 0) { return 0L; }
        if (n > 8) { n = 8; }
        long v = 0;
        for (int i = 0; i < n; i = i + 1) {
            v = v | ((long)U8() << (i * 8));
        }
        return v;
    }

    // 1..8 字节的有符号小端整数。
    public long IntLE(int n) {
        if (n <= 0) { return 0L; }
        if (n > 8) { n = 8; }
        long v = UIntLE(n);
        int bits = n * 8;
        if (bits < 64) {
            long sign = (long)1 << (bits - 1);
            if ((v & sign) != 0) {
                v = v - (sign << 1);
            }
        }
        return v;
    }

    // 向前跳过 n 字节（截停在末尾，不报错）。
    public void Skip(int n) {
        if (n <= 0) { return; }
        int rem = this.len - this.pos;
        if (n >= rem) {
            this.pos = this.len;
        } else {
            this.pos = this.pos + n;
        }
    }

    private int ClampReadCount(int n) {
        if (n <= 0 || this.pos < 0 || this.pos >= this.len || this.buf == null) { return 0; }
        int avail = this.len - this.pos;
        return n < avail ? n : avail;
    }

    // 读取 n 字节的单字节文本（直接 Substring 切片，免临时缓冲）。
    public string Narrow(int n) {
        int take = ClampReadCount(n);
        if (take == 0) { return ""; }
        string s = this.buf.Substring(this.pos, take);
        this.pos = this.pos + take;
        return s;
    }

    // 读取 n 个原始字节，作为带长度的块返回。
    public TdsBytes Raw(int n) {
        int take = ClampReadCount(n);
        if (take == 0) { return TdsBytes.Alloc(0); }
        TdsBytes b = TdsBytes.Alloc(take);
        for (int i = 0; i < take; i = i + 1) {
            b.SetAt(i, this.buf[this.pos + i] & 255);
        }
        this.pos = this.pos + take;
        return b;
    }

    // 读取 chars 个代码单元的 UTF-16LE/UCS-2LE 文本并解码为合法 UTF-8。
    public string Ucs2(int chars) {
        if (chars <= 0) { return ""; }
        int avail = this.Left() / 2;
        if (chars > avail) { chars = avail; }
        if (chars <= 0 || chars > 715827882) { return ""; }
        byte[] t = new byte[chars * 3 + 1];
        int o = 0;
        for (int i = 0; i < chars; i = i + 1) {
            int lo = U8();
            int hi = U8();
            int cu = lo | (hi << 8);
            if (cu < 128) {
                t[o] = (byte)cu;
                o = o + 1;
            } else if (cu < 2048) {
                t[o] = (byte)(192 | (cu >> 6));
                t[o + 1] = (byte)(128 | (cu & 63));
                o = o + 2;
            } else if (cu >= 55296 && cu <= 56319 && i + 1 < chars) {
                int lo2 = this.buf[this.pos] & 255;
                int hi2 = this.buf[this.pos + 1] & 255;
                int cu2 = lo2 | (hi2 << 8);
                if (cu2 >= 56320 && cu2 <= 57343) {
                    this.pos = this.pos + 2;
                    i = i + 1;
                    int cp = 65536 + (((cu - 55296) << 10) | (cu2 - 56320));
                    t[o] = (byte)(240 | (cp >> 18));
                    t[o + 1] = (byte)(128 | ((cp >> 12) & 63));
                    t[o + 2] = (byte)(128 | ((cp >> 6) & 63));
                    t[o + 3] = (byte)(128 | (cp & 63));
                    o = o + 4;
                } else {
                    t[o] = 239; t[o + 1] = 191; t[o + 2] = 189;
                    o = o + 3;
                }
            } else if (cu >= 55296 && cu <= 57343) {
                t[o] = 239; t[o + 1] = 191; t[o + 2] = 189;
                o = o + 3;
            } else {
                t[o] = (byte)(224 | (cu >> 12));
                t[o + 1] = (byte)(128 | ((cu >> 6) & 63));
                t[o + 2] = (byte)(128 | (cu & 63));
                o = o + 3;
            }
        }
        return t.ToStr(0, o);
    }

    // B_VARCHAR：一个长度字节，后跟相应数量的 UCS-2 单元。
    public string BVarchar() {
        return Ucs2(U8());
    }

    // US_VARCHAR：两字节长度，后跟相应数量的 UCS-2 单元。
    public string UsVarchar() {
        return Ucs2(U16LE());
    }
}
