using System;
using System.Data;

namespace System.Data.SqlServer;

// 接收到的字节缓冲区上的游标。
public class TdsReader {
    public string buf;
    public int pos;
    public int len;

    // 构造；或经 <see cref="Over"/> 创建。
    public TdsReader(string buf, int len) {
        this.buf = buf;
        this.pos = 0;
        this.len = len;
    }

    // 游标覆盖整段缓冲区。
    public static TdsReader Over(string buf) {
        return new TdsReader(buf, buf.Length);
    }

    // 游标只覆盖缓冲区前 len 字节（消息体短于缓冲区时用）。
    public static TdsReader Over(string buf, int len) {
        return new TdsReader(buf, len);
    }

    // 游标覆盖一个带长度的字节块。
    public static TdsReader Over(TdsBytes b) {
        return new TdsReader(b.Data(), b.Len());
    }

    // 当前读取位置。
    public int Pos() { return this.pos; }
    // 距末尾剩余的字节数。
    public int Left() { return this.len - this.pos; }
    // 是否已读到末尾。
    public bool Eof() { return this.pos >= this.len; }
    // 跳到绝对位置 p。
    public void Seek(int p) { this.pos = p; }

    // 读取单字节；越过末尾返回 0（各 U* 同此约定）。
    public int U8() {
        if (this.pos >= this.len) { return 0; }
        int v = this.buf[this.pos] & 255;
        this.pos = this.pos + 1;
        return v;
    }

    // 读取两字节小端整数。
    public int U16LE() {
        int a = U8();
        int b = U8();
        return a | (b << 8);
    }

    // 读取两字节大端整数。
    public int U16BE() {
        int a = U8();
        int b = U8();
        return (a << 8) | b;
    }

    // 读取四字节小端整数。
    public int U32LE() {
        int a = U16LE();
        int b = U16LE();
        return a | (b << 16);
    }

    // 读取四字节大端整数。
    public int U32BE() {
        int a = U16BE();
        int b = U16BE();
        return (a << 16) | b;
    }

    // 1..8 字节的无符号小端整数。结果用
    // <c>long</c> 表示：八字节字段（bigint、MONEY、PLP 长度）以及完整
    // 的无符号四字节范围都超出 <c>int</c>。
    public long UIntLE(int n) {
        long v = 0;
        for (int i = 0; i < n; i = i + 1) {
            v = v | ((long)U8() << (i * 8));
        }
        return v;
    }

    // 1..8 字节的有符号小端整数。
    public long IntLE(int n) {
        long v = UIntLE(n);
        int bits = n * 8;
        if (bits < 64) {
            long sign = (long)1 << (bits - 1);
            if ((v & sign) != 0) {
                v = v - (sign << 1);
            }
        }
        return v;
    }

    // 向前跳过 n 字节（截停在末尾，不报错）。
    public void Skip(int n) {
        this.pos = this.pos + n;
        if (this.pos > this.len) { this.pos = this.len; }
    }

    // 读取 <paramref name="n"/> 字节的单字节文本。直接基于 Substring 原生切片，
    // 免去 TdsBuf.Alloc 临时缓冲区分配与逐字节拷贝。
    public string Narrow(int n) {
        if (n <= 0) { return ""; }
        if (this.pos + n > this.len) { n = this.len - this.pos; }
        string s = this.buf.Substring(this.pos, n);
        this.pos = this.pos + n;
        return s;
    }

    // 读取 <paramref name="n"/> 个原始字节，作为带长度的块返回。
    public TdsBytes Raw(int n) {
        if (n < 0) { n = 0; }
        if (this.pos + n > this.len) { n = this.len - this.pos; }
        TdsBytes b = TdsBytes.Alloc(n);
        for (int i = 0; i < n; i = i + 1) {
            b.SetAt(i, this.buf[this.pos + i] & 255);
        }
        this.pos = this.pos + n;
        return b;
    }

    // 读取 <paramref name="chars"/> 个代码单元的 UCS-2LE 文本。
    // 高于 U+00FF 的单元渲染为 '?'，解码器无需
    // 引入完整转码器即可保持完备；其余单元保留原字节值。
    public string Ucs2(int chars) {
        if (chars <= 0) { return ""; }
        byte[] t = new byte[chars + 1];
        for (int i = 0; i < chars; i = i + 1) {
            int lo = U8();
            int hi = U8();
            if (hi != 0) {
                t[i] = 63;  // '?'
            } else {
                t[i] = (byte)lo;
            }
        }
        return t.ToStr(0, chars);
    }

    // B_VARCHAR：一个长度字节，后跟相应数量的 UCS-2 单元。
    public string BVarchar() {
        return Ucs2(U8());
    }

    // US_VARCHAR：两字节长度，后跟相应数量的 UCS-2 单元。
    public string UsVarchar() {
        return Ucs2(U16LE());
    }
}
