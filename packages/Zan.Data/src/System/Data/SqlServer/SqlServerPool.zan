using System;
using System.Data;
using System.Threading;

namespace System.Data.SqlServer;

// 适用于 <see cref="SqlServerConnection"/> 的协程感知连接池。
// 与 <see cref="DbPool"/> 契约相同——惰性增长至 <c>maxSize</c>，
// 用 <see cref="Gate"/> 驱动等待而非轮询，驱逐失效的
// 连接——但保留类型，因此协程查询 API（<c>QueryAsync</c>、
// <c>ExecuteAsync</c>）仍然可用。一次 TDS 登录需要多轮往返，
// 因此应复用会话，而非每条语句都新建一个。
// 用法：
// pool.Release(db);
// pool.Close();
public class SqlServerPool : IDisposable {
    string host;
    int port;
    string database;
    string user;
    string password;
    PoolCore<SqlServerConnection> core;

    public SqlServerPool(string host, int port, string database, string user,
            string password, int maxSize) {
        this.host = host;
        this.port = port;
        this.database = database;
        this.user = user;
        this.password = password;
        this.core = new PoolCore<SqlServerConnection>(maxSize);
    }

    // 新建一条 TDS 连接（池的建连回调）。
    async SqlServerConnection OpenOne() {
        return await SqlServerConnection.OpenAsync(this.host, this.port,
                                                   this.database, this.user,
                                                   this.password);
    }

    // 借出一条连接：复用空闲连接，未达到上限则新建，
    // 否则挂起协程直到有连接被释放。饱和等待有硬上限
    // （见 <see cref="PoolWait"/>）：超时返回 null，绝不定死。
    // 连接池关闭后返回 null。
    public async SqlServerConnection AcquireAsync() {
        PoolOpenAsync<SqlServerConnection> open = this.OpenOne;
        Predicate<SqlServerConnection> connected = SqlServerPool.IsUsable;
        Action<SqlServerConnection> close = SqlServerPool.CloseConnection;
        PoolOpenFailure<SqlServerConnection> failed = SqlServerPool.ReportOpenFailure;
        return await this.core.AcquireAsync(open, connected, close, failed);
    }

    static bool IsUsable(SqlServerConnection c) { return c.IsConnected(); }
    static void CloseConnection(SqlServerConnection c) { c.Close(); }

    static void ReportOpenFailure(SqlServerConnection c, Exception error) {
        string why = error != null ? error.Message : (c != null ? c.lastError : "");
        Console.WriteLine("[mssqlpool] connect failed: "
            + (why.Length > 0 ? why : "refused, timeout, or auth rejected"));
    }

    // 将连接归还连接池。已损坏或 Close() 之后的
    // 连接将被关闭并丢弃，而不会入池。归还时事务未收尾的连接
    // 不直接入池：挂清理协程把残留事务 ROLLBACK 掉后再回池
    // （A535，P2-29 的异步驱动半边；协程由调度器泵动——异步
    // 驱动的使用方必然运行在协程环境里）。
    public void Release(SqlServerConnection c) {
        if (c == null) {
            return;
        }
        if (this.core.IsClosed() || !c.IsConnected()) {
            c.Close();
            this.core.Drop(c);
            return;
        }
        if (c.inTxn) {
            Task.Spawn(this.Cleanup(c));
            return;
        }
        if (!this.core.Pool(c)) { c.Close(); }
    }

    // 清理协程体：ROLLBACK 落地后连接才回池；若回滚异常或连接失效，
    // 说明连接协议或底层通道已损坏，立即关闭并丢弃，严禁脏连接回池。
    private async bool Cleanup(SqlServerConnection c) {
        bool failed = false;
        try {
            await c.RollbackAsync();
        } catch (Exception ex) {
            failed = true;
        }
        c.inTxn = false;
        if (failed || this.core.IsClosed() || !c.IsConnected()) {
            c.Close();
            this.core.Drop(c);
            return true;
        }
        if (!this.core.Pool(c)) { c.Close(); }
        return true;
    }

    // 空闲（已入池、可直接使用）连接数。
    public int IdleCount() {
        return this.core.IdleCount();
    }

    // 活跃连接总数（空闲 + 已借出）。
    public int LiveCount() {
        return this.core.LiveCount();
    }

    // 当前挂起等待连接的协程数。
    public int WaitingCount() {
        return this.core.WaitingCount();
    }

    // 并发活跃连接数上限。
    public int MaxSize() {
        return this.core.MaxSize();
    }

    // 关闭所有空闲连接并将连接池标记为已关闭。
    // 仍被借出的连接在归还时关闭。
    public void Close() {
        this.core.MarkClosed();
        SqlServerConnection c = this.core.TakeClosing();
        while (c != null) {
            c.Close();
            this.core.Drop(c);
            c = this.core.TakeClosing();
        }
        this.core.WakeAll();
    }

    public void Dispose() {
        this.Close();
    }
}
