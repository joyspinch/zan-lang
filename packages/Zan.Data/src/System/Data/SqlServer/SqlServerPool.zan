using System;
using System.Data;
using System.Threading;

namespace System.Data.SqlServer;

// 适用于 <see cref="SqlServerConnection"/> 的协程感知连接池。
// 与 <see cref="DbPool"/> 契约相同——惰性增长至 <c>maxSize</c>，
// 用 <see cref="Gate"/> 驱动等待而非轮询，驱逐失效的
// 连接——但保留类型，因此协程查询 API（<c>QueryAsync</c>、
// <c>ExecuteAsync</c>）仍然可用。一次 TDS 登录需要多轮往返，
// 因此应复用会话，而非每条语句都新建一个。
// 用法：
// pool.Release(db);
// pool.Close();
public class SqlServerPool : IDisposable {
    string host;
    int port;
    string database;
    string user;
    string password;
    PoolCore<SqlServerConnection> core;
    string lastOpenError;

    public SqlServerPool(string host, int port, string database, string user,
            string password, int maxSize) {
        this.host = host;
        this.port = port;
        this.database = database;
        this.user = user;
        this.password = password;
        this.core = new PoolCore<SqlServerConnection>(maxSize);
        this.lastOpenError = "";
    }

    // 新建一条 TDS 连接（池的建连回调）。
    async SqlServerConnection OpenOne() {
        try {
            return await SqlServerConnection.OpenAsync(this.host, this.port,
                                                       this.database, this.user,
                                                       this.password);
        } catch (Exception ex) {
            this.lastOpenError = ex.Message;
            return null;
        }
    }

    // 借出一条连接：复用空闲连接，未达到上限则新建，
    // 否则挂起协程直到有连接被释放。饱和等待有硬上限
    // （见 <see cref="PoolWait"/>）：超时返回 null，绝不定死。
    // 连接池关闭后返回 null。
    public async SqlServerConnection AcquireAsync() {
        PoolWait wait = new PoolWait();
        while (true) {
            if (this.core.IsClosed()) {
                return null;
            }
            SqlServerConnection pooled = this.core.TakeIdle();
            while (pooled != null) {
                // 连接在池中闲置时可能已失效（服务器重启、空闲超时），
                // 此时应将其驱逐，把名额让给等待者。
                if (pooled.IsConnected()) {
                    return pooled;
                }
                this.core.Drop(pooled);
                pooled = this.core.TakeIdle();
            }
            // 上一次建连失败后退避：后端不可达时，若每次获取都重试建连，
            // 失败本身就成了每请求的固定开销（失败的本地 open 也要约
            // 125us），足以让命中路由的吞吐掉一个数量级。
            if (this.core.OpenBlocked()) {
                return null;
            }
            if (this.core.TryReserve()) {
                SqlServerConnection opened = await this.OpenOne();
                if (opened == null || !opened.IsConnected()) {
                    if (opened != null) {
                        opened.Close();
                    }
                    /* 契约：借出失败折进 null（下面随即记退避）。根因只在
                       失败 episode 的首条记录诊断，退避期内零星重试静默。 */
                    if (!this.core.OpenFailing()) {
                        string why = opened != null ? opened.lastError : this.lastOpenError;
                        Console.WriteLine("[mssqlpool] connect failed: "
                            + (why.Length > 0 ? why
                                : "refused, timeout, or auth rejected"));
                    }
                    this.lastOpenError = "";
                    this.core.NoteOpenFailed();
                    this.core.UndoReserve();
                    return null;
                }
                if (this.core.IsClosed()) {
                    opened.Close();
                    this.core.UndoReserve();
                    return null;
                }
                this.core.NoteOpenOk();
                this.lastOpenError = "";
                this.core.Borrow(opened);
                return opened;
            }
            // 连接池已满：交给共享的有界等待（见 PoolWait），
            // 预算耗尽以 null 快速失败。
            if (!await this.core.WaitForRelease(wait)) {
                return null;
            }
        }
        return null;
    }

    // 将连接归还连接池。已损坏或 Close() 之后的
    // 连接将被关闭并丢弃，而不会入池。归还时事务未收尾的连接
    // 不直接入池：挂清理协程把残留事务 ROLLBACK 掉后再回池
    // （A535，P2-29 的异步驱动半边；协程由调度器泵动——异步
    // 驱动的使用方必然运行在协程环境里）。
    public void Release(SqlServerConnection c) {
        if (c == null) {
            return;
        }
        if (this.core.IsClosed() || !c.IsConnected()) {
            c.Close();
            this.core.Drop(c);
            return;
        }
        if (c.inTxn) {
            Task.Spawn(this.Cleanup(c));
            return;
        }
        this.core.Pool(c);
    }

    // 清理协程体：ROLLBACK 落地后连接才回池；回滚失败也放行——连接
    // 仍可用，下一位使用者的显式 BEGIN 会撞上残留事务报错，可定位
    // （与 SqliteDbPool.Release 同一取舍）。池已关闭或连接失效则丢弃。
    private async bool Cleanup(SqlServerConnection c) {
        try {
            await c.RollbackAsync();
        } catch (Exception) {
        }
        c.inTxn = false;
        if (this.core.IsClosed() || !c.IsConnected()) {
            c.Close();
            this.core.Drop(c);
            return true;
        }
        this.core.Pool(c);
        return true;
    }

    // 空闲（已入池、可直接使用）连接数。
    public int IdleCount() {
        return this.core.IdleCount();
    }

    // 活跃连接总数（空闲 + 已借出）。
    public int LiveCount() {
        return this.core.LiveCount();
    }

    // 当前挂起等待连接的协程数。
    public int WaitingCount() {
        return this.core.WaitingCount();
    }

    // 并发活跃连接数上限。
    public int MaxSize() {
        return this.core.MaxSize();
    }

    // 关闭所有空闲连接并将连接池标记为已关闭。
    // 仍被借出的连接在归还时关闭。
    public void Close() {
        this.core.MarkClosed();
        SqlServerConnection c = this.core.TakeIdle();
        while (c != null) {
            c.Close();
            this.core.Drop(c);
            c = this.core.TakeIdle();
        }
        this.core.WakeAll();
    }

    public void Dispose() {
        this.Close();
    }
}
