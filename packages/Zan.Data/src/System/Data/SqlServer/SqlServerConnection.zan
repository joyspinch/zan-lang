using System;
using System.Collections.Generic;
using System.Data;
using System.Net.Sockets;
using System.Net.Tls;
using System.Threading;

namespace System.Data.SqlServer;

// 协程化的纯 Zan TDS 7.4 客户端（支持明文 OpenAsync 与全链路 TLS OpenSecureAsync）。
// 用法：SqlServerConnection db = await SqlServerConnection.OpenAsync("127.0.0.1", 1433, "master", "sa", "secret");
public class SqlServerConnection : IDbConnection {
    nint sock;
    bool connected;
    string lastError;
    int lastNumber;
    int lastAffected;
    string serverVersion;
    string database;
    string appName;
    int packetSize;
    int packetId;
    TlsStream tls;
    bool busy;
    Queue<AsyncGate> waiters;
    // 连接池归还时据此挂异步 ROLLBACK 清理未收尾事务（P2-29）。
    public bool inTxn;

    async bool AcquireLock() {
        AsyncGate g = null;
        lock (this) {
            if (!this.busy) { this.busy = true; return true; }
            g = new AsyncGate();
            if (this.waiters == null) { this.waiters = new Queue<AsyncGate>(); }
            this.waiters.Enqueue(g);
        }
        await g.Wait();
        g.Close();
        return true;
    }

    void ReleaseLock() {
        lock (this) {
            if (this.waiters != null && this.waiters.Count() > 0) {
                AsyncGate g = this.waiters.Dequeue();
                g.Signal();
            } else { this.busy = false; }
        }
    }

    private static bool defaultVerifyTls = true;
    public static bool verifyTls {
        get { return SqlServerConnection.defaultVerifyTls; }
        set { SqlServerConnection.defaultVerifyTls = value; }
    }

    // 切换后续 OpenSecureAsync 的证书链与主机名校验（仅自签测试关闭，生产保持开启）。
    public static void SetTlsVerify(bool verify) {
        SqlServerConnection.defaultVerifyTls = verify;
    }

    public bool tlsVerify = true;

    public SqlServerConnection() {
        this.sock = -1;
        this.connected = false;
        this.lastError = "";
        this.lastAffected = 0;
        this.serverVersion = "";
        this.database = "";
        this.appName = "zan";
        this.packetSize = TdsPacket.DEFAULT_SIZE;
        this.packetId = 1;
        this.tls = null;
    }

    async int recvExact(byte[] dst, int off, int need) {
        if (this.tls == null) {
            return await this.recvExactRaw(dst, off, need);
        }
        int have = 0;
        while (have < need) {
            int read = await this.tls.RecvBytesAsync(dst, off + have, need - have);
            if (read <= 0) { return have; }
            have = have + read;
        }
        return have;
    }

    // 握手阶段专用裸读取（0x12 封装的 TLS 密文，此时尚不能走隧道）。
    async int recvExactRaw(byte[] dst, int off, int need) {
        int got = 0;
        byte[] tmp = new byte[need + 1];
        while (got < need) {
            int n = await Socket.RecvOv(this.sock, tmp, need - got);
            if (n <= 0) { return got; }
            NativeMemory.Copy((nint)dst + (nint)(off + got), (nint)tmp, n);
            got = got + n;
        }
        return got;
    }

    async bool sendMessage(int type, TdsBytes payload) {
        int max = this.packetSize - TdsPacket.HEADER_LEN;
        int off = 0;
        int total = payload.Len();
        bool first = true;
        while (first || off < total) {
            first = false;
            int chunk = total - off;
            int status = TdsPacket.STATUS_EOM;
            if (chunk > max) {
                chunk = max;
                status = TdsPacket.STATUS_NORMAL;
            }
            TdsBytes pkt = TdsPacket.Frame(type, status, this.packetId, payload, off, chunk);
            this.packetId = this.packetId + 1;
            if (this.packetId > 255) { this.packetId = 1; }
            int sent = this.tls != null
                ? await this.tls.SendBytesAsync(pkt.Data(), 0, pkt.Len())
                : await Socket.SendAsync(this.sock, pkt.Data(), pkt.Len());
            pkt.Release();
            if (sent < 0) {
                this.lastError = "send failed";
                return false;
            }
            off = off + chunk;
        }
        return true;
    }

    async TdsBytes recvMessage() {
        TdsBuf body = new TdsBuf();
        bool more = true;
        int totalBytes = 0;
        int maxBytes = 67108864; // 64 MiB 累计消息上限，防止恶意/异常服务端无界拼包 OOM
        while (more) {
            byte[] hdr = new byte[TdsPacket.HEADER_LEN + 1];
            if (await this.recvExact(hdr, 0, TdsPacket.HEADER_LEN) < TdsPacket.HEADER_LEN) {
                this.lastError = "connection closed by the server";
                return null;
            }
            int status = hdr[1] & 255;
            int len = ((hdr[2] & 255) << 8) | (hdr[3] & 255);
            int payLen = len - TdsPacket.HEADER_LEN;
            if (payLen < 0) {
                this.lastError = "malformed packet header";
                return null;
            }
            if (payLen > maxBytes - totalBytes) {
                this.lastError = "TDS message exceeds maximum allowed size";
                return null;
            }
            totalBytes = totalBytes + payLen;
            if (payLen > 0) {
                byte[] pay = new byte[payLen + 1];
                if (await this.recvExact(pay, 0, payLen) < payLen) {
                    this.lastError = "truncated packet";
                    return null;
                }
                for (int i = 0; i < payLen; i = i + 1) { body.U8(pay[i] & 255); }
            }
            if ((status & TdsPacket.STATUS_EOM) != 0) { more = false; }
        }
        return body.ToBytes();
    }

    static async SqlServerConnection OpenCoreAsync(string host, int port,
            string database, string user, string password, bool secure) {
        Socket.Initialize();
        SqlServerConnection conn = new SqlServerConnection();
        conn.database = database;
        bool ok = await conn.handshake(host, port, database, user, password, secure);
        conn.connected = ok;
        if (!ok) {
            conn.Close();
        }
        return conn;
    }

    public static async SqlServerConnection OpenAsync(string host, int port,
            string database, string user, string password) {
        return await SqlServerConnection.OpenCoreAsync(host, port, database, user, password, false);
    }

    // 协商 ENCRYPT_ON 并升级 TLS；服务器拒绝加密时显式失败，绝不静默降级明文。
    public static async SqlServerConnection OpenSecureAsync(string host, int port,
            string database, string user, string password) {
        return await SqlServerConnection.OpenCoreAsync(host, port, database, user, password, true);
    }

    async bool handshake(string host, int port, string db, string user, string pw, bool secure) {
        this.sock = Socket.CreateTcp();
        if (this.sock < 0) { this.lastError = "socket create failed"; return false; }
        Socket.SetNonBlocking(this.sock);
        if (await Socket.ConnectAsync(this.sock, host, port) != 0) {
            this.lastError = "cannot reach " + host + ":" + Convert.ToString(port);
            return false;
        }

        TdsBytes preloginMsg = TdsMessage.Prelogin(secure ? 1 : 2);
        bool sent = await this.sendMessage(TdsPacket.PRELOGIN, preloginMsg);
        preloginMsg.Release();
        if (!sent) { return false; }
        TdsBytes pre = await this.recvMessage();
        if (pre == null) { return false; }
        int enc = TdsMessage.PreloginEncryption(pre);
        pre.Release();
        if (secure) {
            if (enc != 1 && enc != 3) {
                this.lastError = "server refused TDS encryption (no TLS)";
                return false;
            }
            if (!await this.tlsUpgrade(host)) { return false; }
        } else if (enc == 1 || enc == 3) {
            this.lastError = "the server requires TLS, which this driver does not speak yet";
            return false;
        }

        this.packetId = 1;
        TdsBytes login = TdsMessage.Login7(host, user, pw, this.appName, host, db, this.packetSize);
        sent = await this.sendMessage(TdsPacket.LOGIN7, login);
        login.Release();
        if (!sent) { return false; }
        TdsBytes ack = await this.recvMessage();
        if (ack == null) { return false; }
        TdsResponse resp = TdsMessage.Decode(ack);
        ack.Release();
        if (resp.Failed()) {
            this.lastError = "login failed: " + resp.Error();
            return false;
        }
        this.serverVersion = resp.ServerVersion();
        if (resp.Database().Length > 0) { this.database = resp.Database(); }
        return true;
    }

    // 握手期间 TLS 记录封装在 PRELOGIN(0x12) 中，完成后直接走裸 TLS 隧道。
    async bool tlsUpgrade(string host) {
        TlsContext tlsCtx = TlsContext.CreateClient();
        if (tlsCtx == null) {
            this.lastError = "TLS init failed: " + TlsStream.LastError();
            return false;
        }
        if (!this.tlsVerify || !SqlServerConnection.defaultVerifyTls) { tlsCtx.DisableVerify(); }
        // 压制 TLS 1.3：1.3 握手后仍会发 post-handshake 记录，会污染已停止 0x12 封装的裸流。
        tlsCtx.DisableTls13();
        this.tls = TlsStream.ConnectStepped(tlsCtx, this.sock, host);
        if (this.tls == null) {
            this.lastError = "TLS init failed: " + TlsStream.LastError();
            return false;
        }
        while (true) {
            int st = this.tls.HandshakePump();
            string out1 = this.tls.HandshakeDrain();
            int off = 0;
            while (off < out1.Length) {
                int chunk = out1.Length - off;
                if (chunk > 16300) { chunk = 16300; }
                byte[] frame = new byte[chunk + 9];
                frame[0] = (byte)TdsPacket.PRELOGIN;
                frame[1] = (byte)TdsPacket.STATUS_EOM;
                int len = chunk + 8;
                frame[2] = (byte)(len >> 8);
                frame[3] = (byte)(len & 255);
                frame[4] = 0; frame[5] = 0;
                frame[6] = (byte)(this.packetId & 255);
                frame[7] = 0;
                for (int i = 0; i < chunk; i = i + 1) { frame[8 + i] = (byte)(out1[off + i] & 255); }
                this.packetId = this.packetId + 1;
                if (this.packetId > 255) { this.packetId = 1; }
                if (await Socket.SendAsync(this.sock, frame, chunk + 8) < 0) {
                    this.lastError = "TLS handshake send failed";
                    return false;
                }
                off = off + chunk;
            }
            if (st == 1) { return true; }
            if (st < 0) {
                this.lastError = "TLS handshake failed: " + TlsStream.LastError();
                return false;
            }
            byte[] hdr = new byte[9];
            if (await this.recvExactRaw(hdr, 0, 8) < 8) {
                this.lastError = "TLS handshake: connection closed by the server";
                return false;
            }
            int payLen = (((hdr[2] & 255) << 8) | (hdr[3] & 255)) - 8;
            if (payLen > 0) {
                byte[] pay = new byte[payLen + 1];
                if (await this.recvExactRaw(pay, 0, payLen) < payLen) {
                    this.lastError = "TLS handshake: truncated packet";
                    return false;
                }
                this.tls.HandshakeFeed(pay.ToStr(0, payLen));
            }
        }
        return false;
    }

    async TdsResponse roundTrip(int type, TdsBytes payload) {
        await this.AcquireLock();
        try {
            this.lastError = "";
            if (!this.connected) {
                payload.Release();
                this.lastError = "not connected";
                this.fail();
                return new TdsResponse();
            }
            this.packetId = 1;
            bool sent = await this.sendMessage(type, payload);
            payload.Release();
            if (!sent) {
                this.connected = false;
                this.fail();
                return new TdsResponse();
            }
            TdsBytes body = await this.recvMessage();
            if (body == null) {
                this.connected = false;
                this.fail();
                return new TdsResponse();
            }
            TdsResponse resp = TdsMessage.Decode(body);
            body.Release();
            this.lastAffected = resp.Affected();
            if (resp.Failed()) {
                this.lastError = resp.Error();
                this.lastNumber = resp.ErrorNumber();
                this.fail();
            }
            return resp;
        } finally { this.ReleaseLock(); }
    }

    TdsBytes buildRpcParams(string sql, DbParams prms) {
        string text = SqlServerConnection.Renumber(sql, prms.Count());
        if (text.Length == 0 && sql.Length > 0) {
            this.lastError = "parameter count does not match the placeholders";
            this.fail();
        }
        return TdsMessage.RpcExecuteSql(text, prms);
    }

    public async DbResult QueryAsync(string sql) {
        TdsResponse resp = await this.roundTrip(TdsPacket.SQLBATCH, TdsMessage.SqlBatch(sql));
        return resp.Rows();
    }

    public async DbResult QueryAsync(string sql, DbParams prms) {
        TdsResponse resp = await this.roundTrip(TdsPacket.RPC, this.buildRpcParams(sql, prms));
        return resp.Rows();
    }

    public async int ExecuteAsync(string sql) {
        TdsResponse resp = await this.roundTrip(TdsPacket.SQLBATCH, TdsMessage.SqlBatch(sql));
        return resp.Affected();
    }

    public async int ExecuteAsync(string sql, DbParams prms) {
        TdsResponse resp = await this.roundTrip(TdsPacket.RPC, this.buildRpcParams(sql, prms));
        return resp.Affected();
    }

    void fail() {
        string why = this.lastError.Length > 0 ? this.lastError : "the statement failed";
        throw new DbException(why, this.lastNumber, DbProvider.SqlServer);
    }

    public static DbException Sync() {
        return new DbException("SqlServerConnection is asynchronous: use QueryAsync/ExecuteAsync", 0, DbProvider.SqlServer);
    }

    public DbResult Query(string sql) { throw SqlServerConnection.Sync(); }
    public DbResult Query(string sql, DbParams prms) { throw SqlServerConnection.Sync(); }
    public int Execute(string sql) { throw SqlServerConnection.Sync(); }
    public int Execute(string sql, DbParams prms) { throw SqlServerConnection.Sync(); }
    public string ExecuteScalar(string sql) { throw SqlServerConnection.Sync(); }
    public string ExecuteScalar(string sql, DbParams prms) { throw SqlServerConnection.Sync(); }
    public void BeginTransaction() { throw SqlServerConnection.Sync(); }
    public void Commit() { throw SqlServerConnection.Sync(); }
    public void Rollback() { throw SqlServerConnection.Sync(); }

    public async bool BeginTransactionAsync() {
        int _n = await this.ExecuteAsync("BEGIN TRANSACTION");
        this.inTxn = true;
        return true;
    }

    public async bool CommitAsync() {
        int _n = await this.ExecuteAsync("COMMIT TRANSACTION");
        this.inTxn = false;
        return true;
    }

    public async bool RollbackAsync() {
        int _n = await this.ExecuteAsync("ROLLBACK TRANSACTION");
        this.inTxn = false;
        return true;
    }

    public async string ExecuteScalarAsync(string sql) {
        DbResult r = await this.QueryAsync(sql);
        return r.RowCount() == 0 ? "" : r.GetString(0, 0);
    }

    public async string ExecuteScalarAsync(string sql, DbParams prms) {
        DbResult r = await this.QueryAsync(sql, prms);
        return (r == null || r.RowCount() == 0 || r.ColumnCount() == 0) ? "" : r.GetString(0, 0);
    }

    // 将 `?` 占位符改写为 @P1..，保留引号/方括号字面量；占位符数不匹配时返回 ""。
    public static string Renumber(string sql, int count) {
        if (sql == null) { return ""; }
        if (count == 0) { return sql; }
        StringBuilder outp = new StringBuilder();
        int i = 0;
        int start = 0;
        int n = 0;
        int quote = 0;  // 0 无，1 '，2 ", 3 [
        int len = sql.Length;
        while (i < len) {
            int c = sql[i] & 255;
            if (quote == 0) {
                if (c == 39) { quote = 1; }
                else if (c == 34) { quote = 2; }
                else if (c == 91) { quote = 3; }
                else if (c == 63) {
                    if (i > start) { outp.Append(sql.Substring(start, i - start)); }
                    n = n + 1;
                    outp.Append("@P");
                    outp.Append(Convert.ToString(n));
                    i = i + 1;
                    start = i;
                    continue;
                }
            } else if ((quote == 1 && c == 39) || (quote == 2 && c == 34) || (quote == 3 && c == 93)) {
                quote = 0;
            }
            i = i + 1;
        }
        if (start < len) { outp.Append(sql.Substring(start, len - start)); }
        return n != count ? "" : outp.ToString();
    }

    public int AffectedRows() { return this.lastAffected; }
    public string GetError() { return this.lastError; }
    public string ServerVersion() { return this.serverVersion; }
    public string Database() { return this.database; }
    public bool IsConnected() { return this.connected; }
    public int GetProvider() { return DbProvider.SqlServer; }

    public void Close() {
        this.connected = false;
        lock (this) {
            while (this.waiters != null && this.waiters.Count() > 0) {
                AsyncGate g = this.waiters.Dequeue();
                g.Signal();
            }
        }
        if (this.tls != null) {
            this.tls.Close();
            this.tls = null;
        }
        if (this.sock >= 0) {
            Socket.Close(this.sock);
            this.sock = -1;
        }
    }

    public void Dispose() { this.Close(); }
}
