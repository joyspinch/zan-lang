using System;
using System.Data;
using System.Text;

namespace System.Data.SqlServer;

// TYPE_INFO 描述符及其后的行值的解码。
// 所有值都转为文本：SQL Server 发送十几种二进制
// 编码，而 <see cref="DbResult"/> 基于文本，因此转换
// 必须在此完成，并对所有调用方共享。
public class TdsValue {
    // 十六进制渲染用的字符表。
    public static string HEX = "0123456789abcdef";

    // 读取 TYPE_INFO 描述符到 <paramref name="col"/>。
    public static void ReadTypeInfo(TdsReader r, TdsColumn col) {
        int t = r.U8();
        col.type = t;
        if (t == TdsType.GUIDN || t == TdsType.INTN || t == TdsType.BITN
                || t == TdsType.FLTN || t == TdsType.MONEYN
                || t == TdsType.DATETIMN || t == TdsType.CHAR
                || t == TdsType.VARCHAR || t == TdsType.BINARY
                || t == TdsType.VARBINARY) {
            col.size = r.U8();
            return;
        }
        if (t == TdsType.DECIMAL || t == TdsType.NUMERIC
                || t == TdsType.DECIMALN || t == TdsType.NUMERICN) {
            col.size = r.U8();
            col.precision = r.U8();
            col.scale = r.U8();
            return;
        }
        if (t == TdsType.DATEN) { return; }
        if (t == TdsType.TIMEN || t == TdsType.DATETIME2N || t == TdsType.DTOFFSETN) {
            col.scale = r.U8();
            return;
        }
        if (t == TdsType.BIGVARBIN || t == TdsType.BIGBINARY) {
            col.size = r.U16LE();
            return;
        }
        if (t == TdsType.BIGVARCHR || t == TdsType.BIGCHAR
                || t == TdsType.NVARCHAR || t == TdsType.NCHAR) {
            col.size = r.U16LE();
            r.Skip(5);  // 排序规则
            return;
        }
        if (t == TdsType.TEXT || t == TdsType.NTEXT) {
            col.size = r.U32LE();
            r.Skip(5);  // 排序规则
            TdsValue.SkipTableName(r);
            return;
        }
        if (t == TdsType.IMAGE) {
            col.size = r.U32LE();
            TdsValue.SkipTableName(r);
            return;
        }
        if (t == TdsType.XML) {
            int schema = r.U8();
            if (schema == 1) {
                r.BVarchar();  // 数据库
                r.BVarchar();  // 所属 schema
                r.UsVarchar();  // schema 集合
            }
            col.size = 65535;
            return;
        }
        if (t == TdsType.UDT) {
            col.size = r.U16LE();
            r.BVarchar();
            r.BVarchar();
            r.BVarchar();
            r.UsVarchar();
            return;
        }
        // 定长类型的宽度已编码在 ID 本身中。
        col.size = TdsValue.FixedWidth(t);
    }

    // 跳过 TEXT/IMAGE 类型描述符尾部的表名（多段 UsVarchar）。
    public static void SkipTableName(TdsReader r) {
        int parts = r.U8();
        for (int i = 0; i < parts; i = i + 1) {
            r.UsVarchar();
        }
    }

    // 定长类型的线上宽度（字节）；变长类型返回 0。
    public static int FixedWidth(int t) {
        if (t == TdsType.INT1 || t == TdsType.BIT) { return 1; }
        if (t == TdsType.INT2) { return 2; }
        if (t == TdsType.INT4 || t == TdsType.FLT4 || t == TdsType.DATETIM4
                || t == TdsType.MONEY4) { return 4; }
        if (t == TdsType.INT8 || t == TdsType.FLT8 || t == TdsType.MONEY
                || t == TdsType.DATETIME) { return 8; }
        return 0;
    }

    // 读取 <paramref name="col"/> 对应的一行值。
    public static TdsCell ReadValue(TdsReader r, TdsColumn col) {
        int t = col.type;
        int fixedLen = TdsValue.FixedWidth(t);
        if (fixedLen > 0 && t != TdsType.INTN) {
            return TdsValue.Scalar(r, t, fixedLen, col);
        }
        if (t == TdsType.NULLTYPE) { return TdsCell.Null(); }

        if (t == TdsType.TEXT || t == TdsType.NTEXT || t == TdsType.IMAGE) {
            int ptrLen = r.U8();
            if (ptrLen == 0) { return TdsCell.Null(); }
            r.Skip(ptrLen);
            r.Skip(8);  // timestamp
            return TdsValue.Text(r, r.U32LE(), t);
        }

        if (TdsValue.IsLarge(t)) {
            if (col.size == 65535) {
                return TdsValue.ReadPlp(r, t);
            }
            int n = r.U16LE();
            if (n == 65535) { return TdsCell.Null(); }
            return TdsValue.Text(r, n, t);
        }

        // 其余类型均以单字节长度前缀。
        int n = r.U8();
        if (n == 0) { return TdsCell.Null(); }
        if (t == TdsType.CHAR || t == TdsType.VARCHAR
                || t == TdsType.BINARY || t == TdsType.VARBINARY) {
            if (n == 255) { return TdsCell.Null(); }
            return TdsValue.Text(r, n, t);
        }
        return TdsValue.Scalar(r, t, n, col);
    }

    // 是否为「大值类型」（两字节长度或 PLP 编码）。
    public static bool IsLarge(int t) {
        return t == TdsType.BIGVARCHR || t == TdsType.BIGCHAR
            || t == TdsType.BIGVARBIN || t == TdsType.BIGBINARY
            || t == TdsType.NVARCHAR || t == TdsType.NCHAR
            || t == TdsType.XML || t == TdsType.UDT;
    }

    // PLP：八字节总长度（或 unknown/NULL 标记），
    // 随后是分块，直到零长度块。分块先合并为一个
    // 带长度的块，因为一个值可能横跨多个分块。
    // 防御：U8() 读穿缓冲尾会返回 0 而非报错，因此损坏/恶意
    // 的流此前可以无限追加零字节把客户端喂到 OOM。这里按
    // 包剩余字节校验每个分块声明（分块不会横跨包边界），
    // 并给单值设 64 MiB 硬上限；违规一律按 NULL 收场。
    public static TdsCell ReadPlp(TdsReader r, int t) {
        int hi = r.U32LE();
        int lo = r.U32LE();
        if (hi == 0 - 1 && lo == 0 - 1) { return TdsCell.Null(); }
        long cap = 67108864;
        TdsBuf acc = new TdsBuf();
        bool more = true;
        while (more) {
            int chunk = r.U32LE();
            if (chunk < 0) { return TdsCell.Null(); }
            if (chunk == 0) {
                more = false;
            } else {
                if ((long)chunk > r.Left()) { return TdsCell.Null(); }
                if (acc.Count() + chunk > cap) { return TdsCell.Null(); }
                for (int i = 0; i < chunk; i = i + 1) {
                    acc.U8(r.U8());
                }
            }
        }
        TdsBytes all = acc.ToBytes();
        TdsReader rr = TdsReader.Over(all);
        TdsCell cell = TdsValue.Text(rr, all.Len(), t);
        all.Release();
        return cell;
    }

    // 按列类型家族渲染接下来的 <paramref name="n"/> 个字节：
    // 二进制用十六进制，national 类型用 UCS-2，其余
    // 原样输出。
    public static TdsCell Text(TdsReader r, int n, int t) {
        if (TdsType.IsBinary(t)) {
            return TdsCell.Of(TdsValue.Hex(r, n));
        }
        if (TdsType.IsWide(t)) {
            return TdsCell.Of(r.Ucs2(n / 2));
        }
        return TdsCell.Of(r.Narrow(n));
    }

    // 把 n 字节渲染为 "0x…" 小写十六进制。
    public static string Hex(TdsReader r, int n) {
        byte[] buf = new byte[2 + n * 2];
        buf[0] = 48;  // '0'
        buf[1] = 120;  // 'x'
        int p = 2;
        for (int i = 0; i < n; i = i + 1) {
            int v = r.U8();
            int hi = (v >> 4) & 15;
            int lo = v & 15;
            buf[p] = (byte)(hi < 10 ? hi + 48 : hi + 87);
            buf[p + 1] = (byte)(lo < 10 ? lo + 48 : lo + 87);
            p = p + 2;
        }
        return buf.ToStr(0, p);
    }

    // 数值、时间及 GUID 值，其含义取决于
    // 实际发送的字节数（INTN 4 是 int，INTN 8 是 bigint）。
    public static TdsCell Scalar(TdsReader r, int t, int n, TdsColumn col) {
        if (t == TdsType.BIT || t == TdsType.BITN) {
            int v = r.U8();
            if (v == 0) { return TdsCell.Of("0"); }
            return TdsCell.Of("1");
        }
        if (t == TdsType.INT1) { return TdsCell.Of(Convert.ToString(r.U8())); }
        if (t == TdsType.INT2 || t == TdsType.INT4 || t == TdsType.INT8
                || t == TdsType.INTN) {
            return TdsCell.OfInt(r.IntLE(n));
        }
        if (t == TdsType.FLT4 || t == TdsType.FLT8 || t == TdsType.FLTN) {
            return TdsCell.Of(TdsValue.Float(r, n));
        }
        if (t == TdsType.MONEY || t == TdsType.MONEY4 || t == TdsType.MONEYN) {
            return TdsCell.Of(TdsValue.Money(r, n));
        }
        if (t == TdsType.DECIMAL || t == TdsType.NUMERIC
                || t == TdsType.DECIMALN || t == TdsType.NUMERICN) {
            return TdsCell.Of(TdsValue.Numeric(r, n, col.scale));
        }
        if (t == TdsType.DATETIME || t == TdsType.DATETIM4
                || t == TdsType.DATETIMN) {
            return TdsCell.Of(TdsValue.LegacyDateTime(r, n));
        }
        if (t == TdsType.DATEN) {
            return TdsCell.Of(TdsValue.CivilDate((int)r.UIntLE(3) - 719162));
        }
        if (t == TdsType.TIMEN) {
            return TdsCell.Of(TdsValue.TimeOfDay(r.UIntLE(n), col.scale));
        }
        if (t == TdsType.DATETIME2N) {
            int timeLen = n - 3;
            string tod = TdsValue.TimeOfDay(r.UIntLE(timeLen), col.scale);
            string day = TdsValue.CivilDate((int)r.UIntLE(3) - 719162);
            return TdsCell.Of(day + " " + tod);
        }
        if (t == TdsType.DTOFFSETN) {
            int timeLen = n - 5;
            string tod = TdsValue.TimeOfDay(r.UIntLE(timeLen), col.scale);
            string day = TdsValue.CivilDate((int)r.UIntLE(3) - 719162);
            int off = (int)r.IntLE(2);
            return TdsCell.Of(day + " " + tod + " " + TdsValue.Offset(off));
        }
        if (t == TdsType.GUIDN) {
            return TdsCell.Of(TdsValue.Guid(r, n));
        }
        return TdsCell.Of(TdsValue.Hex(r, n));
    }

    // 读取 n(4 或 8) 字节小端位型并按 IEEE 754 渲染浮点文本。
    public static string Float(TdsReader r, int n) {
        if (n == 4) {
            long bits = r.UIntLE(4);
            return TdsValue.Ieee((int)((bits >> 31) & 1), (int)((bits >> 23) & 255),
                                 bits & 8388607, 127, 23);
        }
        long bits = r.UIntLE(8);
        return TdsValue.Ieee((int)((bits >> 63) & 1), (int)((bits >> 52) & 2047),
                             bits & 4503599627370495, 1023, 52);
    }

    // 以 double 表示的 2^e（e 可为负）。
    public static double Pow2(int e) {
        double v = 1.0;
        int i = 0;
        if (e >= 0) {
            while (i < e) { v = v * 2.0; i = i + 1; }
        } else {
            while (i > e) { v = v / 2.0; i = i - 1; }
        }
        return v;
    }

    // 由 IEEE 754 位型（符号/指数/尾数/偏置/尾数位数）渲染浮点文本。
    public static string Ieee(int sign, int exp, long mant, int bias, int mantBits) {
        if (exp == 0 && mant == 0) { return "0"; }
        double m = 1.0;
        int b = mantBits - 1;
        while (b >= 0) {
            if (((mant >> b) & 1) == 1) { m = m + TdsValue.Pow2(b - mantBits); }
            b = b - 1;
        }
        double v = m * TdsValue.Pow2(exp - bias);
        if (sign == 1) { v = 0.0 - v; }
        return Convert.ToString(v);
    }

    // MONEY 是缩放整数：每单位四万分之一，
    // 八字节形式先发送高半字。
    public static string Money(TdsReader r, int n) {
        long units = 0;
        if (n == 4) {
            units = r.IntLE(4);
        } else {
            long hi = r.IntLE(4);
            long lo = r.UIntLE(4);
            units = (hi << 32) | lo;
        }
        return TdsValue.Scaled(units, 4);
    }

    // DECIMAL/NUMERIC：一个符号字节，后跟小端
    // 幅值，最多十六字节，因此通过反复
    // 对 32 位 limb 做除法来生成各位数字，而非直接整数运算。
    public static string Numeric(TdsReader r, int n, int scale) {
        int sign = r.U8();
        int mlen = n - 1;
        List<int> limbs = new List<int>();  // 小端 32 位 limb
        for (int i = 0; i < mlen; i = i + 1) {
            int shift = (i % 4) * 8;
            int byteVal = r.U8();
            if (shift == 0) {
                limbs.Add(byteVal);
            } else {
                int idx = limbs.Count - 1;
                limbs[idx] = limbs[idx] | (byteVal << shift);
            }
        }
        string digits = TdsValue.LimbsToDecimal(limbs);
        while (digits.Length <= scale) { digits = "0" + digits; }
        string outp = digits;
        if (scale > 0) {
            int cut = digits.Length - scale;
            outp = digits.Substring(0, cut) + "." + digits.Substring(cut, scale);
        }
        if (sign == 0 && digits != "0") { outp = "-" + outp; }
        return outp;
    }

    // 小端 32 位 limb 序列转十进制数字串（去前导零）。
    public static string LimbsToDecimal(List<int> limbs) {
        StringBuilder rev = new StringBuilder();
        bool any = true;
        while (any) {
            int rem = 0;
            int i = limbs.Count - 1;
            any = false;
            while (i >= 0) {
                long cur = ((long)rem << 32) | ((long)limbs[i] & 4294967295);
                long q = cur / 10;
                rem = (int)(cur - q * 10);
                limbs[i] = (int)(q & 4294967295);
                if (limbs[i] != 0) { any = true; }
                i = i - 1;
            }
            rev.Append(TdsValue.Digit(rem));
        }
        string s = rev.ToString();
        int slen = s.Length;
        byte[] buf = new byte[slen];
        for (int k = 0; k < slen; k = k + 1) {
            buf[k] = (byte)(s[slen - 1 - k] & 255);
        }
        int start = 0;
        while (start < slen - 1 && buf[start] == 48) {
            start = start + 1;
        }
        return buf.ToStr(start, slen - start);
    }

    // 把 0-15 的数值渲染为单个十六进制字符。
    public static string Digit(int v) {
        int d = v & 15;
        byte[] b = new byte[1];
        b[0] = (byte)(d < 10 ? d + 48 : d + 87);
        return b.ToStr(0, 1);
    }

    // 渲染带 <paramref name="scale"/> 位隐式
    // 小数的整数。
    public static string Scaled(long units, int scale) {
        bool neg = units < 0;
        if (neg) { units = 0 - units; }
        string digits = Convert.ToString(units);
        while (digits.Length <= scale) { digits = "0" + digits; }
        int cut = digits.Length - scale;
        string outp = digits.Substring(0, cut) + "." + digits.Substring(cut, scale);
        if (neg) { outp = "-" + outp; }
        return outp;
    }

    // DATETIME（8 字节：1900 年以来的天数加 1/300 秒）和
    // SMALLDATETIME（4 字节：天数加整分钟）。
    public static string LegacyDateTime(TdsReader r, int n) {
        if (n == 4) {
            int days = (int)r.UIntLE(2);
            int mins = (int)r.UIntLE(2);
            return TdsValue.CivilDate(days - 25567) + " "
                + TdsValue.Pad2(mins / 60) + ":" + TdsValue.Pad2(mins % 60) + ":00";
        }
        int days = (int)r.IntLE(4);
        int ticks = (int)r.UIntLE(4);
        int ms = (ticks * 10 + 1) / 3;  // 1/300 秒 -> 毫秒
        int secs = ms / 1000;
        return TdsValue.CivilDate(days - 25567) + " "
            + TdsValue.Pad2(secs / 3600) + ":" + TdsValue.Pad2((secs / 60) % 60)
            + ":" + TdsValue.Pad2(secs % 60) + "." + TdsValue.Pad3(ms % 1000);
    }

    // TIME/DATETIME2 保存 10^-scale 秒的计数。scale 为 7 时，
    // 一天的量是 8.64e11，因此计数用 <c>long</c>。
    public static string TimeOfDay(long ticks, int scale) {
        long div = 1;
        for (int i = 0; i < scale; i = i + 1) { div = div * 10; }
        int secs = (int)(ticks / div);
        string outp = TdsValue.Pad2(secs / 3600) + ":"
            + TdsValue.Pad2((secs / 60) % 60) + ":" + TdsValue.Pad2(secs % 60);
        if (scale > 0) {
            string frac = Convert.ToString(ticks - secs * div);
            while (frac.Length < scale) { frac = "0" + frac; }
            outp = outp + "." + frac;
        }
        return outp;
    }

    // 渲染 UTC 偏移："+HH:MM" / "-HH:MM"。
    public static string Offset(int minutes) {
        string sign = "+";
        if (minutes < 0) {
            sign = "-";
            minutes = 0 - minutes;
        }
        return sign + TdsValue.Pad2(minutes / 60) + ":" + TdsValue.Pad2(minutes % 60);
    }

    // 相对于 1970-01-01 的天数对应的公历日期。
    public static string CivilDate(int z) {
        z = z + 719468;
        int era = z / 146097;
        if (z < 0) { era = (z - 146096) / 146097; }
        int doe = z - era * 146097;
        int yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
        int y = yoe + era * 400;
        int doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
        int mp = (5 * doy + 2) / 153;
        int d = doy - (153 * mp + 2) / 5 + 1;
        int m = mp + 3;
        if (mp >= 10) { m = mp - 9; }
        if (m <= 2) { y = y + 1; }
        return TdsValue.Pad4(y) + "-" + TdsValue.Pad2(m) + "-" + TdsValue.Pad2(d);
    }

    // 规范 GUID 文本：前三个组在线上是小端，
    // 后两个是大端。
    public static string Guid(TdsReader r, int n) {
        if (n < 16) {
            r.Skip(n);
            return "";
        }
        List<int> raw = new List<int>();
        for (int k = 0; k < 16; k = k + 1) {
            raw.Add(r.U8());
        }
        if (n > 16) { r.Skip(n - 16); }
        StringBuilder sb = new StringBuilder();
        sb.Append(TdsValue.HexAt(raw, 3));
        sb.Append(TdsValue.HexAt(raw, 2));
        sb.Append(TdsValue.HexAt(raw, 1));
        sb.Append(TdsValue.HexAt(raw, 0));
        sb.Append("-");
        sb.Append(TdsValue.HexAt(raw, 5));
        sb.Append(TdsValue.HexAt(raw, 4));
        sb.Append("-");
        sb.Append(TdsValue.HexAt(raw, 7));
        sb.Append(TdsValue.HexAt(raw, 6));
        sb.Append("-");
        sb.Append(TdsValue.HexAt(raw, 8));
        sb.Append(TdsValue.HexAt(raw, 9));
        sb.Append("-");
        int i = 10;
        while (i < 16) {
            sb.Append(TdsValue.HexAt(raw, i));
            i = i + 1;
        }
        return sb.ToString();
    }

    // 取 raw[i] 的两个十六进制字符。
    public static string HexAt(List<int> raw, int i) {
        int v = raw[i] & 255;
        int hi = (v >> 4) & 15;
        int lo = v & 15;
        byte[] b = new byte[2];
        b[0] = (byte)(hi < 10 ? hi + 48 : hi + 87);
        b[1] = (byte)(lo < 10 ? lo + 48 : lo + 87);
        return b.ToStr(0, 2);
    }

    // 两位零填充十进制。
    public static string Pad2(int v) {
        if (v < 10) { return "0" + Convert.ToString(v); }
        return Convert.ToString(v);
    }

    // 三位零填充十进制。
    public static string Pad3(int v) {
        string s = Convert.ToString(v);
        while (s.Length < 3) { s = "0" + s; }
        return s;
    }

    // 四位零填充十进制。
    public static string Pad4(int v) {
        string s = Convert.ToString(v);
        while (s.Length < 4) { s = "0" + s; }
        return s;
    }
}
