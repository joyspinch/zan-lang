using System;

namespace System.Data.SqlServer;

// TDS 数据类型 ID（TYPE_INFO），按其长度在
// 线上的传输方式分组。
public class TdsType {
    // 定长，线上无长度字节。
    public static int NULLTYPE  = 31;  // 0x1F
    public static int INT1      = 48;  // 0x30
    public static int BIT       = 50;  // 0x32
    public static int INT2      = 52;  // 0x34
    public static int INT4      = 56;  // 0x38
    public static int DATETIM4  = 58;  // 0x3A
    public static int FLT4      = 59;  // 0x3B
    public static int MONEY     = 60;  // 0x3C
    public static int DATETIME  = 61;  // 0x3D
    public static int FLT8      = 62;  // 0x3E
    public static int MONEY4    = 122;  // 0x7A
    public static int INT8      = 127;  // 0x7F

    // 在 TYPE_INFO 和行中各一个长度字节。
    public static int GUIDN     = 36;  // 0x24
    public static int INTN      = 38;  // 0x26
    public static int DECIMAL   = 55;  // 0x37
    public static int NUMERIC   = 63;  // 0x3F
    public static int BITN      = 104;  // 0x68
    public static int DECIMALN  = 106;  // 0x6A
    public static int NUMERICN  = 108;  // 0x6C
    public static int FLTN      = 109;  // 0x6D
    public static int MONEYN    = 110;  // 0x6E
    public static int DATETIMN  = 111;  // 0x6F
    public static int DATEN     = 40;  // 0x28
    public static int TIMEN     = 41;  // 0x29
    public static int DATETIME2N = 42;  // 0x2A
    public static int DTOFFSETN = 43;  // 0x2B
    public static int CHAR      = 47;  // 0x2F
    public static int VARCHAR   = 39;  // 0x27
    public static int BINARY    = 45;  // 0x2D
    public static int VARBINARY = 37;  // 0x25

    // 两个长度字节；声明大小为 0xFFFF 表示 MAX（PLP 行）。
    public static int BIGVARBIN = 165;  // 0xA5
    public static int BIGVARCHR = 167;  // 0xA7
    public static int BIGBINARY = 173;  // 0xAD
    public static int BIGCHAR   = 175;  // 0xAF
    public static int NVARCHAR  = 231;  // 0xE7
    public static int NCHAR     = 239;  // 0xEF
    public static int XML       = 241;  // 0xF1
    public static int UDT       = 240;  // 0xF0

    // 四个长度字节，行中另有文本指针。
    public static int TEXT      = 35;  // 0x23
    public static int IMAGE     = 34;  // 0x22
    public static int NTEXT     = 99;  // 0x63

    // 该类型的文本是否为 UCS-2 而非单字节。
    public static bool IsWide(int t) {
        return t == TdsType.NVARCHAR || t == TdsType.NCHAR
            || t == TdsType.NTEXT || t == TdsType.XML;
    }

    // 该类型的值是否为原始字节（以十六进制显示）。
    public static bool IsBinary(int t) {
        return t == TdsType.BINARY || t == TdsType.VARBINARY
            || t == TdsType.BIGBINARY || t == TdsType.BIGVARBIN
            || t == TdsType.IMAGE || t == TdsType.UDT;
    }
}
