using System;
using System.IO;
using System.Json;
using System.Text;
namespace System.Data.Search;

public class TextTokenizer {
    // 扁平开放寻址 Trie 边表（多单元编译下避免 Dictionary<long, int> / List<int> 跨单元调用）。
    // edgeKeys 存 ((long)node << 21) | (long)cp + 1L（0 表示空槽）。
    long[] edgeKeys = new long[512];
    int[] edgeVals = new int[512];
    int edgeMask = 511;
    int edgeCount = 0;
    int[] termArr = new int[256];
    // 一维只读预计算表（仅在 AcceptWord 构建，Tokenize 完全只读、线程安全、零锯齿数组 ARC）：
    string[] termWord = new string[256];
    int[] termAuxStart = new int[256];
    int[] termAuxEnd = new int[256];
    int[] termLastCjkLen = new int[256];
    string[] auxPoolText = new string[512];
    int[] auxPoolOff = new int[512];
    int auxPoolCount = 0;
    int nodeCount = 1;
    int[] rootAscii = new int[128];
    List<string> words = new List<string>();
    string fingerprint = "";

    public TextTokenizer() {
        ReadDictionary("中国\n中文\n中华\n中华人民共和国\n北京\n上海\n南京\n南京市\n长江\n长江大桥\n大桥\n语言\n程序\n编程\n编译器\n标准库\n工具\n项目\n文件\n文档\n数据库\n数据\n索引\n全文\n检索\n搜索\n查询\n更新\n删除\n测试\n性能\n网络\n服务\n用户\n系统\n配置\n缓存\n记录\n文本\n分词\n词典\n学习\n机器学习\n深度学习\n人工智能\n模型\n开发\n应用\n软件\n开源\n存储\n事务\n恢复\n排序\n过滤\n结果\n欢迎\n世界");
    }

    private void ResetTrie() {
        int cap = this.edgeKeys.Length;
        for (int i = 0; i < cap; i = i + 1) { this.edgeKeys[i] = 0L; this.edgeVals[i] = 0; }
        this.edgeCount = 0;
        for (int i = 0; i < this.nodeCount; i = i + 1) {
            this.termArr[i] = 0;
            this.termWord[i] = null;
            this.termAuxStart[i] = 0;
            this.termAuxEnd[i] = 0;
            this.termLastCjkLen[i] = 0;
        }
        for (int i = 0; i < this.auxPoolCount; i = i + 1) {
            this.auxPoolText[i] = null;
            this.auxPoolOff[i] = 0;
        }
        this.auxPoolCount = 0;
        this.nodeCount = 1;
        for (int k = 0; k < 128; k = k + 1) { this.rootAscii[k] = 0; }
    }

    private int LookupEdge(int node, int cp) {
        long k = (((long)node << 21) | (long)cp) + 1L;
        int mask = this.edgeMask;
        long[] keys = this.edgeKeys;
        int slot = (int)((k * 2654435761L) >> 16) & mask;
        while (true) {
            long cur = keys[slot];
            if (cur == k) { return this.edgeVals[slot]; }
            if (cur == 0L) { return 0; }
            slot = (slot + 1) & mask;
        }
    }

    private void InsertEdge(int node, int cp, int child) {
        if ((this.edgeCount + 1) * 2 >= this.edgeKeys.Length) {
            int newCap = this.edgeKeys.Length * 2;
            int newMask = newCap - 1;
            long[] nKeys = new long[newCap];
            int[] nVals = new int[newCap];
            long[] oKeys = this.edgeKeys;
            int[] oVals = this.edgeVals;
            int oldCap = oKeys.Length;
            for (int i = 0; i < oldCap; i = i + 1) {
                long ok = oKeys[i];
                if (ok == 0L) { continue; }
                int s = (int)((ok * 2654435761L) >> 16) & newMask;
                while (nKeys[s] != 0L) { s = (s + 1) & newMask; }
                nKeys[s] = ok;
                nVals[s] = oVals[i];
            }
            this.edgeKeys = nKeys;
            this.edgeVals = nVals;
            this.edgeMask = newMask;
        }
        long k = (((long)node << 21) | (long)cp) + 1L;
        int mask = this.edgeMask;
        int slot = (int)((k * 2654435761L) >> 16) & mask;
        while (this.edgeKeys[slot] != 0L) { slot = (slot + 1) & mask; }
        this.edgeKeys[slot] = k;
        this.edgeVals[slot] = child;
        this.edgeCount = this.edgeCount + 1;
        if (node == 0 && cp < 128) { this.rootAscii[cp] = child; }
    }

    private int AllocNode() {
        int id = this.nodeCount;
        if (id >= this.termArr.Length) {
            int newCap = this.termArr.Length * 2;
            int[] gTerm = new int[newCap];
            string[] gWord = new string[newCap];
            int[] gStart = new int[newCap];
            int[] gEnd = new int[newCap];
            int[] gLast = new int[newCap];
            for (int i = 0; i < id; i = i + 1) {
                gTerm[i] = this.termArr[i];
                gWord[i] = this.termWord[i];
                gStart[i] = this.termAuxStart[i];
                gEnd[i] = this.termAuxEnd[i];
                gLast[i] = this.termLastCjkLen[i];
            }
            this.termArr = gTerm;
            this.termWord = gWord;
            this.termAuxStart = gStart;
            this.termAuxEnd = gEnd;
            this.termLastCjkLen = gLast;
        }
        this.termArr[id] = 0;
        this.termWord[id] = null;
        this.termAuxStart[id] = 0;
        this.termAuxEnd[id] = 0;
        this.termLastCjkLen[id] = 0;
        this.nodeCount = id + 1;
        return id;
    }

    private void EnsureAuxPool(int need) {
        if (need <= this.auxPoolText.Length) { return; }
        int newCap = this.auxPoolText.Length * 2;
        while (newCap < need) { newCap = newCap * 2; }
        string[] gText = new string[newCap];
        int[] gOff = new int[newCap];
        int n = this.auxPoolCount;
        for (int i = 0; i < n; i = i + 1) {
            gText[i] = this.auxPoolText[i];
            gOff[i] = this.auxPoolOff[i];
        }
        this.auxPoolText = gText;
        this.auxPoolOff = gOff;
    }

    public void AddWord(string word) {
        AcceptWord(word);
    }

    public int LoadDictionary(string path) {
        if (path == null || path.Length == 0) { return 0; }
        return ReadDictionary(File.ReadAllText(path));
    }

    private static int IntDecLen(int v) {
        if (v < 10) { return 1; }
        if (v < 100) { return 2; }
        if (v < 1000) { return 3; }
        if (v < 10000) { return 4; }
        int len = 0;
        while (v > 0) { len = len + 1; v = v / 10; }
        return len;
    }

    private static int WriteIntDec(byte[] buf, int pos, int v) {
        if (v <= 0) { buf[pos] = (byte)48; return pos + 1; }
        int start = pos;
        while (v > 0) {
            int q = v / 10;
            buf[pos] = (byte)(48 + (v - q * 10));
            pos = pos + 1;
            v = q;
        }
        int l = start;
        int r = pos - 1;
        while (l < r) {
            byte tmp = buf[l];
            buf[l] = buf[r];
            buf[r] = tmp;
            l = l + 1;
            r = r - 1;
        }
        return pos;
    }

    public string Fingerprint() {
        if (fingerprint.Length != 0) { return fingerprint; }
        List<string> sorted = new List<string>();
        sorted.AddRange(words);
        List<string> temp = new List<string>();
        temp.AddRange(words);
        int n = sorted.Count;
        for (int width = 1; width < n; width = width * 2) {
            for (int start = 0; start < n; start = start + width * 2) {
                int mid = start + width;
                if (mid > n) { mid = n; }
                int end = mid + width;
                if (end > n) { end = n; }
                int a = start;
                int b = mid;
                for (int outPos = start; outPos < end; outPos = outPos + 1) {
                    if (a < mid && (b >= end || String.CompareOrdinal(sorted[a], sorted[b]) <= 0)) {
                        temp[outPos] = sorted[a];
                        a = a + 1;
                    } else {
                        temp[outPos] = sorted[b];
                        b = b + 1;
                    }
                }
            }
            List<string> swap = sorted;
            sorted = temp;
            temp = swap;
        }
        string header = "text-tokenizer-v1;ascii-fullwidth;longest;cjk-single-bigram\n";
        long totalL = (long)header.Length;
        for (int i = 0; i < n; i = i + 1) {
            int wl = sorted[i].Length;
            totalL = totalL + (long)TextTokenizer.IntDecLen(wl) + 2L + (long)wl;
            if (totalL > 2147483647L) {
                throw new ArgumentException("Tokenizer dictionary exceeds fingerprint buffer limit");
            }
        }
        int total = (int)totalL;
        byte[] srcBuf = new byte[total];
        nint sp = (nint)srcBuf;
        NativeMemory.Copy(sp, (nint)header, header.Length);
        int p = header.Length;
        for (int i = 0; i < n; i = i + 1) {
            string word = sorted[i];
            int wl = word.Length;
            p = TextTokenizer.WriteIntDec(srcBuf, p, wl);
            srcBuf[p] = (byte)58; p = p + 1;
            if (wl > 0) {
                NativeMemory.Copy(sp + (nint)p, (nint)word, wl);
                p = p + wl;
            }
            srcBuf[p] = (byte)10; p = p + 1;
        }
        string source = NativeMemory.GetString(sp, 0, total);
        byte[] digest = new byte[20];
        Encoding.Sha1(source, source.Length, digest);
        byte[] hexBuf = new byte[48];
        nint hp = (nint)hexBuf;
        NativeMemory.Copy(hp, (nint)"text-v1:", 8);
        int ho = 8;
        for (int i = 0; i < 20; i = i + 1) {
            int bv = digest[i] & 255;
            int hi = bv >> 4;
            int lo = bv & 15;
            hexBuf[ho] = (byte)(hi < 10 ? 48 + hi : 87 + hi);
            hexBuf[ho + 1] = (byte)(lo < 10 ? 48 + lo : 87 + lo);
            ho = ho + 2;
        }
        fingerprint = NativeMemory.GetString(hp, 0, 48);
        return fingerprint;
    }

    public JsonValue ExportState() {
        JsonValue state = JsonValue.NewObject();
        state.PutInt("version", 1);
        state.PutStr("fingerprint", Fingerprint());
        JsonValue lexicon = JsonValue.NewArray();
        for (int i = 0; i < words.Count; i = i + 1) { lexicon.AppendStr(words[i]); }
        state.Put("words", lexicon);
        return state;
    }

    public static TextTokenizer ImportState(JsonValue state) {
        if (state == null || !state.IsObject()) {
            throw new ArgumentException("Invalid tokenizer state");
        }
        JsonValue version = state.Get("version");
        JsonValue identity = state.Get("fingerprint");
        JsonValue lexicon = state.Get("words");
        if (version == null || !version.IsNumber() || !version.numIsInt || version.AsLong(0) != 1
                || identity == null || !identity.IsString() || lexicon == null || !lexicon.IsArray()) {
            throw new ArgumentException("Invalid tokenizer state shape/version");
        }
        TextTokenizer result = new TextTokenizer();
        result.ResetTrie();
        result.words.Clear();
        result.fingerprint = "";
        for (int i = 0; i < lexicon.Count(); i = i + 1) {
            JsonValue word = lexicon.At(i);
            if (word == null || !word.IsString()) {
                throw new ArgumentException("Invalid tokenizer dictionary entry");
            }
            string text = word.AsString("");
            if (Normalize(text) != text || !result.AcceptWord(text)) {
                throw new ArgumentException("Invalid or duplicate tokenizer dictionary word");
            }
        }
        if (result.Fingerprint() != identity.AsString("")) {
            throw new ArgumentException("Tokenizer fingerprint mismatch");
        }
        return result;
    }

    // 自包含热路径：BMP UTF-8 解码、开放寻址 Trie 查边、最长匹配与一维预计算辅助词发射
    // 全部收口在本函数内，多单元编译下零跨单元小函数调用。
    public List<TextToken> Tokenize(string text) {
        List<TextToken> tokens = new List<TextToken>();
        string source = Normalize(text);
        int n = source.Length;
        if (n == 0) { return tokens; }

        long[] eKeys = this.edgeKeys;
        int[] eVals = this.edgeVals;
        int eMask = this.edgeMask;
        int[] terms = this.termArr;
        string[] tWord = this.termWord;
        int[] tAuxS = this.termAuxStart;
        int[] tAuxE = this.termAuxEnd;
        int[] tLastLen = this.termLastCjkLen;
        string[] poolT = this.auxPoolText;
        int[] poolO = this.auxPoolOff;
        int[] rAscii = this.rootAscii;

        int cursor = 0;
        int position = 0;
        bool hasNext = false;
        int cachedCp = 0;
        int cachedUsed = 0;

        while (cursor < n) {
            int b = source[cursor] & 255;
            if (!hasNext && b < 128) {
                if (!((b >= 97 && b <= 122) || (b >= 48 && b <= 57))) {
                    cursor = cursor + 1;
                    position = position + 1;
                    continue;
                }
                int start = cursor;
                int firstPosition = position;
                int nextRoot = rAscii[b];
                if (nextRoot == 0) {
                    cursor = cursor + 1;
                    position = position + 1;
                    while (cursor < n) {
                        int c2 = source[cursor] & 255;
                        if (!((c2 >= 97 && c2 <= 122) || (c2 >= 48 && c2 <= 57))) { break; }
                        cursor = cursor + 1;
                        position = position + 1;
                    }
                    tokens.Add(new TextToken(source.Substring(start, cursor - start), 0, firstPosition));
                    continue;
                }
                int node = nextRoot;
                int mCur = start + 1;
                int mCnt = 1;
                int mCp = b;
                int matchEnd = start;
                int matchCount = 0;
                int matchNode = 0;
                if (terms[node] != 0) {
                    bool bnd = true;
                    if (mCur < n) {
                        int nb = source[mCur] & 255;
                        bnd = !((nb >= 97 && nb <= 122) || (nb >= 48 && nb <= 57));
                    }
                    if (bnd) { matchEnd = mCur; matchCount = mCnt; matchNode = node; }
                }
                while (mCur < n) {
                    int mb = source[mCur] & 255;
                    int mu = 1;
                    if (mb < 128) {
                        mCp = mb;
                    } else if (mb >= 224 && mb < 240 && mCur + 2 < n) {
                        int mb1 = source[mCur + 1] & 255;
                        int mb2 = source[mCur + 2] & 255;
                        if ((mb1 & 192) == 128 && (mb2 & 192) == 128) {
                            int mcp = ((mb & 15) << 12) | ((mb1 & 63) << 6) | (mb2 & 63);
                            if (mcp >= 2048 && !(mcp >= 55296 && mcp <= 57343)) {
                                mCp = mcp; mu = 3;
                            } else {
                                long md = Encoding.DecodeCodePointFast(source, mCur);
                                mu = (int)(md >> 32); mCp = (int)(md & 0xFFFFFFFFL);
                            }
                        } else {
                            long md = Encoding.DecodeCodePointFast(source, mCur);
                            mu = (int)(md >> 32); mCp = (int)(md & 0xFFFFFFFFL);
                        }
                    } else {
                        long md = Encoding.DecodeCodePointFast(source, mCur);
                        mu = (int)(md >> 32); mCp = (int)(md & 0xFFFFFFFFL);
                    }
                    long mk = (((long)node << 21) | (long)mCp) + 1L;
                    int ms = (int)((mk * 2654435761L) >> 16) & eMask;
                    int nn = 0;
                    while (true) {
                        long ck = eKeys[ms];
                        if (ck == mk) { nn = eVals[ms]; break; }
                        if (ck == 0L) { break; }
                        ms = (ms + 1) & eMask;
                    }
                    if (nn == 0) { break; }
                    node = nn;
                    mCur = mCur + mu;
                    mCnt = mCnt + 1;
                    if (terms[node] != 0) {
                        bool bnd = true;
                        if (mCp < 128 && ((mCp >= 97 && mCp <= 122) || (mCp >= 48 && mCp <= 57)) && mCur < n) {
                            int nb = source[mCur] & 255;
                            bnd = !((nb >= 97 && nb <= 122) || (nb >= 48 && nb <= 57));
                        }
                        if (bnd) { matchEnd = mCur; matchCount = mCnt; matchNode = node; }
                    }
                }
                if (matchNode != 0) {
                    cursor = matchEnd;
                    position = position + matchCount;
                    tokens.Add(new TextToken(tWord[matchNode], 0, firstPosition));
                    int as0 = tAuxS[matchNode];
                    int ae0 = tAuxE[matchNode];
                    for (int a = as0; a < ae0; a = a + 1) {
                        tokens.Add(new TextToken(poolT[a], 1, firstPosition + poolO[a]));
                    }
                    int lastLen = tLastLen[matchNode];
                    if (lastLen > 0 && matchEnd < n) {
                        int nb = source[matchEnd] & 255;
                        if (nb >= 128) {
                            int nextUsed = 0;
                            int nextCp = 0;
                            if (nb >= 224 && nb < 240 && matchEnd + 2 < n) {
                                int nb1 = source[matchEnd + 1] & 255;
                                int nb2 = source[matchEnd + 2] & 255;
                                if ((nb1 & 192) == 128 && (nb2 & 192) == 128) {
                                    int ncp = ((nb & 15) << 12) | ((nb1 & 63) << 6) | (nb2 & 63);
                                    if (ncp >= 2048 && !(ncp >= 55296 && ncp <= 57343)) {
                                        nextCp = ncp; nextUsed = 3;
                                    }
                                }
                            }
                            if (nextUsed == 0) {
                                long nd = Encoding.DecodeCodePointFast(source, matchEnd);
                                nextUsed = (int)(nd >> 32); nextCp = (int)(nd & 0xFFFFFFFFL);
                            }
                            if ((nextCp >= 19968 && nextCp <= 40959) || nextCp == 12295
                                    || (nextCp >= 13312 && nextCp <= 19903)
                                    || (nextCp >= 63744 && nextCp <= 64255)
                                    || (nextCp >= 131072 && nextCp <= 195103)
                                    || (nextCp >= 196608 && nextCp <= 205743)) {
                                tokens.Add(new TextToken(source.Substring(matchEnd - lastLen, lastLen + nextUsed), 1, firstPosition + matchCount - 1));
                            }
                            hasNext = true;
                            cachedCp = nextCp;
                            cachedUsed = nextUsed;
                        }
                    }
                } else {
                    cursor = cursor + 1;
                    position = position + 1;
                    while (cursor < n) {
                        int c2 = source[cursor] & 255;
                        if (!((c2 >= 97 && c2 <= 122) || (c2 >= 48 && c2 <= 57))) { break; }
                        cursor = cursor + 1;
                        position = position + 1;
                    }
                    tokens.Add(new TextToken(source.Substring(start, cursor - start), 0, firstPosition));
                }
                continue;
            }

            int used = 0;
            int cp = 0;
            if (hasNext) {
                cp = cachedCp;
                used = cachedUsed;
                hasNext = false;
            } else if (b >= 224 && b < 240 && cursor + 2 < n) {
                int b1 = source[cursor + 1] & 255;
                int b2 = source[cursor + 2] & 255;
                if ((b1 & 192) == 128 && (b2 & 192) == 128) {
                    int mcp = ((b & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63);
                    if (mcp >= 2048 && !(mcp >= 55296 && mcp <= 57343)) {
                        cp = mcp; used = 3;
                    }
                }
                if (used == 0) {
                    long dec = Encoding.DecodeCodePointFast(source, cursor);
                    used = (int)(dec >> 32); cp = (int)(dec & 0xFFFFFFFFL);
                }
            } else {
                long dec = Encoding.DecodeCodePointFast(source, cursor);
                used = (int)(dec >> 32); cp = (int)(dec & 0xFFFFFFFFL);
            }

            bool isCjk = (cp >= 19968 && cp <= 40959) || cp == 12295
                || (cp >= 13312 && cp <= 19903) || (cp >= 63744 && cp <= 64255)
                || (cp >= 131072 && cp <= 195103) || (cp >= 196608 && cp <= 205743);
            if (!isCjk) {
                cursor = cursor + used;
                position = position + 1;
                continue;
            }

            int start2 = cursor;
            int firstPosition2 = position;
            long rk = (long)cp + 1L;
            int rs = (int)((rk * 2654435761L) >> 16) & eMask;
            int nextNode = 0;
            while (true) {
                long ck = eKeys[rs];
                if (ck == rk) { nextNode = eVals[rs]; break; }
                if (ck == 0L) { break; }
                rs = (rs + 1) & eMask;
            }

            if (nextNode != 0) {
                int node = nextNode;
                int mCur = start2 + used;
                int mCnt = 1;
                int mCp = cp;
                int matchEnd = start2;
                int matchCount = 0;
                int matchNode = 0;
                if (terms[node] != 0) {
                    matchEnd = mCur; matchCount = 1; matchNode = node;
                }
                while (mCur < n) {
                    int mb = source[mCur] & 255;
                    int mu = 1;
                    if (mb < 128) {
                        mCp = mb;
                    } else if (mb >= 224 && mb < 240 && mCur + 2 < n) {
                        int mb1 = source[mCur + 1] & 255;
                        int mb2 = source[mCur + 2] & 255;
                        if ((mb1 & 192) == 128 && (mb2 & 192) == 128) {
                            int mcp = ((mb & 15) << 12) | ((mb1 & 63) << 6) | (mb2 & 63);
                            if (mcp >= 2048 && !(mcp >= 55296 && mcp <= 57343)) {
                                mCp = mcp; mu = 3;
                            } else {
                                long md = Encoding.DecodeCodePointFast(source, mCur);
                                mu = (int)(md >> 32); mCp = (int)(md & 0xFFFFFFFFL);
                            }
                        } else {
                            long md = Encoding.DecodeCodePointFast(source, mCur);
                            mu = (int)(md >> 32); mCp = (int)(md & 0xFFFFFFFFL);
                        }
                    } else {
                        long md = Encoding.DecodeCodePointFast(source, mCur);
                        mu = (int)(md >> 32); mCp = (int)(md & 0xFFFFFFFFL);
                    }
                    long mk = (((long)node << 21) | (long)mCp) + 1L;
                    int ms = (int)((mk * 2654435761L) >> 16) & eMask;
                    int nn = 0;
                    while (true) {
                        long ck = eKeys[ms];
                        if (ck == mk) { nn = eVals[ms]; break; }
                        if (ck == 0L) { break; }
                        ms = (ms + 1) & eMask;
                    }
                    if (nn == 0) { break; }
                    node = nn;
                    mCur = mCur + mu;
                    mCnt = mCnt + 1;
                    if (terms[node] != 0) {
                        bool bnd = true;
                        if (mCp < 128 && ((mCp >= 97 && mCp <= 122) || (mCp >= 48 && mCp <= 57)) && mCur < n) {
                            int nb = source[mCur] & 255;
                            bnd = !((nb >= 97 && nb <= 122) || (nb >= 48 && nb <= 57));
                        }
                        if (bnd) { matchEnd = mCur; matchCount = mCnt; matchNode = node; }
                    }
                }
                if (matchNode != 0) {
                    cursor = matchEnd;
                    position = position + matchCount;
                    tokens.Add(new TextToken(tWord[matchNode], 0, firstPosition2));
                    int as0 = tAuxS[matchNode];
                    int ae0 = tAuxE[matchNode];
                    for (int a = as0; a < ae0; a = a + 1) {
                        tokens.Add(new TextToken(poolT[a], 1, firstPosition2 + poolO[a]));
                    }
                    int lastLen = tLastLen[matchNode];
                    if (lastLen > 0 && matchEnd < n) {
                        int nb = source[matchEnd] & 255;
                        if (nb >= 128) {
                            int nextUsed = 0;
                            int nextCp = 0;
                            if (nb >= 224 && nb < 240 && matchEnd + 2 < n) {
                                int nb1 = source[matchEnd + 1] & 255;
                                int nb2 = source[matchEnd + 2] & 255;
                                if ((nb1 & 192) == 128 && (nb2 & 192) == 128) {
                                    int ncp = ((nb & 15) << 12) | ((nb1 & 63) << 6) | (nb2 & 63);
                                    if (ncp >= 2048 && !(ncp >= 55296 && ncp <= 57343)) {
                                        nextCp = ncp; nextUsed = 3;
                                    }
                                }
                            }
                            if (nextUsed == 0) {
                                long nd = Encoding.DecodeCodePointFast(source, matchEnd);
                                nextUsed = (int)(nd >> 32); nextCp = (int)(nd & 0xFFFFFFFFL);
                            }
                            if ((nextCp >= 19968 && nextCp <= 40959) || nextCp == 12295
                                    || (nextCp >= 13312 && nextCp <= 19903)
                                    || (nextCp >= 63744 && nextCp <= 64255)
                                    || (nextCp >= 131072 && nextCp <= 195103)
                                    || (nextCp >= 196608 && nextCp <= 205743)) {
                                tokens.Add(new TextToken(source.Substring(matchEnd - lastLen, lastLen + nextUsed), 1, firstPosition2 + matchCount - 1));
                            }
                            hasNext = true;
                            cachedCp = nextCp;
                            cachedUsed = nextUsed;
                        }
                    }
                    continue;
                }
            }

            // 未命中词典的单汉字快路径：主词 + 仅向后前瞻 1 码点生成二元组，并复用解码结果到下一迭代。
            int nextPos = start2 + used;
            tokens.Add(new TextToken(source.Substring(start2, used), 0, firstPosition2));
            if (nextPos < n) {
                int nb = source[nextPos] & 255;
                if (nb >= 128) {
                    int nextUsed = 0;
                    int nextCp = 0;
                    if (nb >= 224 && nb < 240 && nextPos + 2 < n) {
                        int nb1 = source[nextPos + 1] & 255;
                        int nb2 = source[nextPos + 2] & 255;
                        if ((nb1 & 192) == 128 && (nb2 & 192) == 128) {
                            int ncp = ((nb & 15) << 12) | ((nb1 & 63) << 6) | (nb2 & 63);
                            if (ncp >= 2048 && !(ncp >= 55296 && ncp <= 57343)) {
                                nextCp = ncp; nextUsed = 3;
                            }
                        }
                    }
                    if (nextUsed == 0) {
                        long nd = Encoding.DecodeCodePointFast(source, nextPos);
                        nextUsed = (int)(nd >> 32); nextCp = (int)(nd & 0xFFFFFFFFL);
                    }
                    if ((nextCp >= 19968 && nextCp <= 40959) || nextCp == 12295
                            || (nextCp >= 13312 && nextCp <= 19903)
                            || (nextCp >= 63744 && nextCp <= 64255)
                            || (nextCp >= 131072 && nextCp <= 195103)
                            || (nextCp >= 196608 && nextCp <= 205743)) {
                        tokens.Add(new TextToken(source.Substring(start2, used + nextUsed), 1, firstPosition2));
                    }
                    hasNext = true;
                    cachedCp = nextCp;
                    cachedUsed = nextUsed;
                }
            }
            cursor = nextPos;
            position = position + 1;
        }
        return tokens;
    }

    public static bool IsAsciiWord(int cp) {
        return (cp >= 97 && cp <= 122) || (cp >= 48 && cp <= 57);
    }

    public static bool IsCjk(int cp) {
        if (cp >= 19968 && cp <= 40959) { return true; }
        return cp == 12295 || (cp >= 13312 && cp <= 19903)
            || (cp >= 63744 && cp <= 64255)
            || (cp >= 131072 && cp <= 195103) || (cp >= 196608 && cp <= 205743);
    }

    public static int Fold(int cp) {
        if (cp >= 65281 && cp <= 65374) { cp = cp - 65248; }
        else if (cp == 12288) { cp = 32; }
        if (cp >= 65 && cp <= 90) { cp = cp + 32; }
        return cp;
    }

    private static int WriteUtf8CodePoint(byte[] buf, int pos, int cp) {
        if (cp < 0 || cp > 1114111 || (cp >= 55296 && cp <= 57343)) { cp = 65533; }
        if (cp < 128) {
            buf[pos] = (byte)cp;
            return pos + 1;
        }
        if (cp < 2048) {
            buf[pos] = (byte)(192 | (cp >> 6));
            buf[pos + 1] = (byte)(128 | (cp & 63));
            return pos + 2;
        }
        if (cp < 65536) {
            buf[pos] = (byte)(224 | (cp >> 12));
            buf[pos + 1] = (byte)(128 | ((cp >> 6) & 63));
            buf[pos + 2] = (byte)(128 | (cp & 63));
            return pos + 3;
        }
        buf[pos] = (byte)(240 | (cp >> 18));
        buf[pos + 1] = (byte)(128 | ((cp >> 12) & 63));
        buf[pos + 2] = (byte)(128 | ((cp >> 6) & 63));
        buf[pos + 3] = (byte)(128 | (cp & 63));
        return pos + 4;
    }

    public static string Normalize(string text) {
        if (text == null || text.Length == 0) { return ""; }
        int n = text.Length;
        int cursor = 0;
        // 自包含零分配快检：ASCII 与 3 字节 BMP 内联快扫，规范串零分配直返。
        while (cursor < n) {
            int b = text[cursor] & 255;
            if (b < 128) {
                if (b >= 65 && b <= 90) { break; }
                cursor = cursor + 1;
                continue;
            }
            int used = 0;
            int cp = 0;
            if (b >= 224 && b < 240 && cursor + 2 < n) {
                int b1 = text[cursor + 1] & 255;
                int b2 = text[cursor + 2] & 255;
                if ((b1 & 192) == 128 && (b2 & 192) == 128) {
                    int mcp = ((b & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63);
                    if (mcp >= 2048 && !(mcp >= 55296 && mcp <= 57343)) {
                        cp = mcp; used = 3;
                    }
                }
            }
            if (used == 0) {
                long dec = Encoding.DecodeCodePointFast(text, cursor);
                used = (int)(dec >> 32); cp = (int)(dec & 0xFFFFFFFFL);
            }
            if ((cp >= 65281 && cp <= 65374) || cp == 12288) { break; }
            if (cp == 65533 && (used != 3 || b != 239
                    || (text[cursor + 1] & 255) != 191 || (text[cursor + 2] & 255) != 189)) {
                break;
            }
            cursor = cursor + used;
        }
        if (cursor >= n) { return text; }

        int cap = n + 16;
        byte[] outBuf = new byte[cap];
        nint op = (nint)outBuf;
        nint tp = (nint)text;
        if (cursor > 0) {
            NativeMemory.Copy(op, tp, cursor);
        }
        int w = cursor;
        while (cursor < n) {
            if (w + 4 > cap) {
                int newCap = cap * 2;
                byte[] grown = new byte[newCap];
                NativeMemory.Copy((nint)grown, op, w);
                outBuf = grown;
                op = (nint)outBuf;
                cap = newCap;
            }
            int b = text[cursor] & 255;
            if (b < 128) {
                outBuf[w] = (byte)(b >= 65 && b <= 90 ? b + 32 : b);
                w = w + 1;
                cursor = cursor + 1;
                continue;
            }
            int used = 0;
            int cp = 0;
            if (b >= 224 && b < 240 && cursor + 2 < n) {
                int b1 = text[cursor + 1] & 255;
                int b2 = text[cursor + 2] & 255;
                if ((b1 & 192) == 128 && (b2 & 192) == 128) {
                    int mcp = ((b & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63);
                    if (mcp >= 2048 && !(mcp >= 55296 && mcp <= 57343)) {
                        cp = mcp; used = 3;
                    }
                }
            }
            if (used == 0) {
                long dec = Encoding.DecodeCodePointFast(text, cursor);
                used = (int)(dec >> 32); cp = (int)(dec & 0xFFFFFFFFL);
            }
            int folded = cp;
            if (folded >= 65281 && folded <= 65374) { folded = folded - 65248; }
            else if (folded == 12288) { folded = 32; }
            if (folded >= 65 && folded <= 90) { folded = folded + 32; }
            bool invalid = cp == 65533 && (used != 3 || b != 239
                || (text[cursor + 1] & 255) != 191 || (text[cursor + 2] & 255) != 189);
            if (folded != cp || invalid) {
                if (folded < 128) {
                    outBuf[w] = (byte)folded; w = w + 1;
                } else {
                    w = TextTokenizer.WriteUtf8CodePoint(outBuf, w, folded);
                }
            } else {
                for (int k = 0; k < used; k = k + 1) {
                    outBuf[w + k] = (byte)(text[cursor + k] & 255);
                }
                w = w + used;
            }
            cursor = cursor + used;
        }
        return NativeMemory.GetString(op, 0, w);
    }

    public bool AcceptWord(string word) {
        string normalized = Normalize(word);
        int n = normalized.Length;
        if (n == 0) { return false; }
        int cursor = 0;
        int lastCp = 0;
        int lastUsed = 0;
        while (cursor < n) {
            int b = normalized[cursor] & 255;
            if (b < 128) {
                if (!IsAsciiWord(b)) { return false; }
                lastCp = b;
                lastUsed = 1;
                cursor = cursor + 1;
            } else {
                long dec = Encoding.DecodeCodePointFast(normalized, cursor);
                int used = (int)(dec >> 32);
                int cp = (int)(dec & 0xFFFFFFFFL);
                if (used <= 0 || !IsCjk(cp)) { return false; }
                lastCp = cp;
                lastUsed = used;
                cursor = cursor + used;
            }
        }
        int node = 0;
        cursor = 0;
        while (cursor < n) {
            int b = normalized[cursor] & 255;
            int used = 1;
            int cp = b;
            if (b >= 128) {
                long dec = Encoding.DecodeCodePointFast(normalized, cursor);
                used = (int)(dec >> 32);
                cp = (int)(dec & 0xFFFFFFFFL);
            }
            int nextNode = this.LookupEdge(node, cp);
            if (nextNode != 0) {
                node = nextNode;
            } else {
                int child = this.AllocNode();
                this.InsertEdge(node, cp, child);
                node = child;
            }
            cursor = cursor + used;
        }
        if (this.termArr[node] != 0) { return false; }
        this.termArr[node] = 1;
        this.termWord[node] = normalized;
        this.termLastCjkLen[node] = IsCjk(lastCp) ? lastUsed : 0;
        // 预计算词典词内部的全部辅助 token 进一维只读池，Tokenize 零分配零锯齿数组 ARC 复用。
        List<TextToken> preAux = new List<TextToken>();
        TextTokenizer.EmitAuxiliary(preAux, normalized, 0, n, 0, normalized, null);
        int auxStart = this.auxPoolCount;
        int an = preAux.Count;
        if (an > 0) {
            this.EnsureAuxPool(auxStart + an);
            for (int a = 0; a < an; a = a + 1) {
                TextToken t = preAux[a];
                this.auxPoolText[auxStart + a] = t.text;
                this.auxPoolOff[auxStart + a] = t.position;
            }
            this.auxPoolCount = auxStart + an;
        }
        this.termAuxStart[node] = auxStart;
        this.termAuxEnd[node] = auxStart + an;
        words.Add(normalized);
        fingerprint = "";
        return true;
    }

    public int ReadDictionary(string data) {
        if (data == null || data.Length == 0) { return 0; }
        int accepted = 0;
        int n = data.Length;
        nint dp = (nint)data;
        int start = 0;
        if (n >= 3 && (data[0] & 255) == 239 && (data[1] & 255) == 187
                && (data[2] & 255) == 191) { start = 3; }
        while (start < n) {
            int end = NativeMemory.Find(dp, start, 10, n - start);
            if (end < 0) { end = n; }
            int first = start;
            while (first < end) {
                int c = data[first] & 255;
                if (c != 32 && c != 9 && c != 13) { break; }
                first = first + 1;
            }
            int last = first;
            while (last < end) {
                int c = data[last] & 255;
                if (c == 32 || c == 9 || c == 13 || c == 35) { break; }
                last = last + 1;
            }
            if (last > first && AcceptWord(data.Substring(first, last - first))) {
                accepted = accepted + 1;
            }
            start = end + 1;
        }
        return accepted;
    }

    public void LongestMatch(string source, int start, int[] scalar, int[] result) {
        if (result == null || result.Length < 2) { return; }
        result[0] = start;
        result[1] = 0;
        if (source == null || start < 0) { return; }
        int n = source.Length;
        if (start >= n) { return; }
        int node = 0;
        int cursor = start;
        int count = 0;
        while (cursor < n) {
            int b = source[cursor] & 255;
            int used = 1;
            int cp = b;
            if (b >= 128) {
                long dec = Encoding.DecodeCodePointFast(source, cursor);
                used = (int)(dec >> 32);
                cp = (int)(dec & 0xFFFFFFFFL);
                if (used <= 0) { used = 1; }
            }
            int nextNode = (node == 0 && cp < 128) ? this.rootAscii[cp] : this.LookupEdge(node, cp);
            if (nextNode == 0) { break; }
            node = nextNode;
            cursor = cursor + used;
            count = count + 1;
            if (this.termArr[node] != 0) {
                bool boundary = true;
                if (cp < 128 && IsAsciiWord(cp) && cursor < n) {
                    int nb = source[cursor] & 255;
                    boundary = !(nb < 128 && IsAsciiWord(nb));
                }
                if (boundary) { result[0] = cursor; result[1] = count; }
            }
        }
    }

    public static void EmitAuxiliary(List<TextToken> tokens, string source, int start, int end,
            int position, string primary, int[] scalar) {
        if (tokens == null || source == null) { return; }
        int n = source.Length;
        if (start < 0) { start = 0; }
        if (end > n) { end = n; }
        if (start >= end) { return; }
        int cursor = start;
        int firstPosition = position;
        while (cursor < end) {
            int b = source[cursor] & 255;
            int used = 1;
            int cp = b;
            if (b >= 128) {
                long dec = Encoding.DecodeCodePointFast(source, cursor);
                used = (int)(dec >> 32);
                cp = (int)(dec & 0xFFFFFFFFL);
                if (used <= 0) { used = 1; }
            }
            if (cp < 128 && IsAsciiWord(cp)) {
                int run = cursor + used;
                int count = 1;
                while (run < end) {
                    int nb = source[run] & 255;
                    if (!(nb < 128 && IsAsciiWord(nb))) { break; }
                    run = run + 1;
                    count = count + 1;
                }
                string latin = source.Substring(cursor, run - cursor);
                if (position != firstPosition || latin != primary) {
                    tokens.Add(new TextToken(latin, 1, position));
                }
                cursor = run;
                position = position + count;
                continue;
            }
            if (IsCjk(cp)) {
                string single = source.Substring(cursor, used);
                if (position != firstPosition || single != primary) {
                    tokens.Add(new TextToken(single, 1, position));
                }
                int next = cursor + used;
                if (next < n) {
                    int nb = source[next] & 255;
                    int nextUsed = 1;
                    int nextCp = nb;
                    if (nb >= 128) {
                        long ndec = Encoding.DecodeCodePointFast(source, next);
                        nextUsed = (int)(ndec >> 32);
                        nextCp = (int)(ndec & 0xFFFFFFFFL);
                        if (nextUsed <= 0) { nextUsed = 1; }
                    }
                    if (IsCjk(nextCp)) {
                        string bigram = source.Substring(cursor, used + nextUsed);
                        if (position != firstPosition || bigram != primary) {
                            tokens.Add(new TextToken(bigram, 1, position));
                        }
                    }
                }
            }
            cursor = cursor + used;
            position = position + 1;
        }
    }
}
