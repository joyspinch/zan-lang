using System;

namespace System.Data;

// 可入池的数据库连接：扩展 IDbExecutor，补充存活检测、事务边界与资源释放，供 DbPool 与通用数据层直接调用。
public interface IDbConnection : IDbExecutor, IDisposable {
    // 连接关闭或损坏后返回 false（归池时将被剔除）。
    bool IsConnected();

    // 释放底层句柄或套接字。
    void Close();

    // 在当前连接上开启事务（不支持事务的引擎实现为空操作）。
    void BeginTransaction();

    // 提交事务的写入。
    void Commit();

    // 回滚事务的写入。
    void Rollback();

    // 在当前连接上异步开启事务。
    async bool BeginTransactionAsync();
    // 异步提交事务写入。
    async bool CommitAsync();
    // 异步回滚事务写入。
    async bool RollbackAsync();

    // 释放连接持有的资源（实现 IDisposable，等同于 Close）。
    void Dispose();
}
