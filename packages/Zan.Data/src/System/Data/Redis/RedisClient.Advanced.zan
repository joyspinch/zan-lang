        RedisReply r = await this.CommandAsync(args);
        return r.AsInt() == 1;
    }

    // SSCAN 增量迭代集合元素。
    public async RedisScanResult SScanAsync(string key, long cursor, string pattern, int count) {
        List<string> args = new List<string>{ "SSCAN", key, Convert.ToString(cursor) };
        if (pattern != null && pattern.Length > 0) {
            args.Add("MATCH");
            args.Add(pattern);
        }
        if (count > 0) {
            args.Add("COUNT");
            args.Add(Convert.ToString(count));
        }
        RedisReply r = await this.CommandAsync(args);
        if (r.kind == RedisReply.ARRAY && r.Count() >= 2) {
            long nextCur = Convert.ToInt64(r.At(0).AsString());
            List<string> items = r.At(1).AsListString();
            return new RedisScanResult(nextCur, items);
        }
        return new RedisScanResult(0, new List<string>());
    }

    // 有序集合 (Sorted Sets / ZSet)

    // ZADD 添加单个成员与分数。
    public async long ZAddAsync(string key, double score, string member) {
        List<string> args = new List<string>{ "ZADD", key, Convert.ToString(score), member };
        RedisReply r = await this.CommandAsync(args);
        return r.AsLong();
    }

    // ZADD 批量添加多个成员与分数实体。
    public async long ZAddMultipleAsync(string key, List<ZMember> members) {
        if (members == null || members.Count == 0) { return 0; }
        List<string> args = new List<string>{ "ZADD", key };
        for (int i = 0; i < members.Count; i = i + 1) {
            ZMember zm = members[i];
            if (zm != null) {
                args.Add(Convert.ToString(zm.score));
                args.Add(zm.member);
            }
        }
        RedisReply r = await this.CommandAsync(args);
        return r.AsLong();
    }

    // ZSCORE 查询成员分数。
    public async double ZScoreAsync(string key, string member) {
        RedisReply r = await this.CommandAsync3("ZSCORE", key, member);
        if (r.IsNil()) { return 0.0; }
        return r.AsDouble();
    }

