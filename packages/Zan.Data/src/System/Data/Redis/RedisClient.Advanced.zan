using System;
using System.Collections.Generic;

namespace System.Data.Redis;

public partial class RedisClient {
    // 列表 (Lists)

    // LPUSH 将单个元素推入列表左端。
    public async long LPushAsync(string key, string value) {
        RedisReply r = await this.CommandAsync3("LPUSH", key, value);
        return r.AsLong();
    }

    // LPUSH 将对象序列化后推入列表左端。
    public async long LPushAsync<T>(string key, T value) {
        string s = this.SerializeObject((object)value);
        return await this.LPushAsync(key, s);
    }

    // LPUSH 批量推入多个元素到左端。
    public async long LPushMultipleAsync(string key, List<string> values) {
        if (values == null || values.Count == 0) { return 0; }
        List<string> args = new List<string>{ "LPUSH", key };
        for (int i = 0; i < values.Count; i = i + 1) {
            args.Add(values[i]);
        }
        RedisReply r = await this.CommandAsync(args);
        return r.AsLong();
    }

    // RPUSH 将单个元素推入列表右端。
    public async long RPushAsync(string key, string value) {
        RedisReply r = await this.CommandAsync3("RPUSH", key, value);
        return r.AsLong();
    }

    // RPUSH 将对象序列化后推入列表右端。
    public async long RPushAsync<T>(string key, T value) {
        string s = this.SerializeObject((object)value);
        return await this.RPushAsync(key, s);
    }

    // RPUSH 批量推入多个元素到右端。
    public async long RPushMultipleAsync(string key, List<string> values) {
        if (values == null || values.Count == 0) { return 0; }
        List<string> args = new List<string>{ "RPUSH", key };
        for (int i = 0; i < values.Count; i = i + 1) {
            args.Add(values[i]);
        }
        RedisReply r = await this.CommandAsync(args);
        return r.AsLong();
    }

    // LPUSHX 仅当列表存在时推入左端。
    public async long LPushXAsync(string key, string value) {
        RedisReply r = await this.CommandAsync3("LPUSHX", key, value);
        return r.AsLong();
    }

    // RPUSHX 仅当列表存在时推入右端。
    public async long RPushXAsync(string key, string value) {
        RedisReply r = await this.CommandAsync3("RPUSHX", key, value);
        return r.AsLong();
    }

    // LPOP 弹出左端元素。
    public async string LPopAsync(string key) {
        RedisReply r = await this.CommandAsync2("LPOP", key);
        if (r.IsNil()) { return ""; }
        return r.AsString();
    }

    // LPOP 弹出左端元素并反序列化为对象类型 T。不存在返回 null/default。
    public async T LPopObjectAsync<T>(string key) {
        string raw = await this.LPopAsync(key);
        if (raw == null || raw == "") {
            return (T)(object)null;
        }
        return this.DeserializeObject<T>(raw);
    }

    // LPOP 弹出左端元素并反序列化为 T（FreeRedis cli.LPop&lt;T&gt; 规范）。
    public async T LPopAsync<T>(string key) {
        return await this.LPopObjectAsync<T>(key);
    }

    // LPOP 二进制安全弹出。
    public async byte[] LPopBytesAsync(string key) {
        RedisReply r = await this.CommandAsync2("LPOP", key);
        if (r.IsNil() || r.IsError()) { return null; }
        return r.AsBytes();
    }

    // RPOP 弹出右端元素。
    public async string RPopAsync(string key) {
        RedisReply r = await this.CommandAsync2("RPOP", key);
        if (r.IsNil()) { return ""; }
        return r.AsString();
    }

    // RPOP 弹出右端元素并反序列化为对象类型 T。不存在返回 null/default。
    public async T RPopObjectAsync<T>(string key) {
        string raw = await this.RPopAsync(key);
        if (raw == null || raw == "") {
            return (T)(object)null;
        }
        return this.DeserializeObject<T>(raw);
    }

    // RPOP 弹出右端元素并反序列化为 T（FreeRedis cli.RPop&lt;T&gt; 规范）。
    public async T RPopAsync<T>(string key) {
        return await this.RPopObjectAsync<T>(key);
    }

    // RPOP 二进制安全弹出。
    public async byte[] RPopBytesAsync(string key) {
        RedisReply r = await this.CommandAsync2("RPOP", key);
        if (r.IsNil() || r.IsError()) { return null; }
        return r.AsBytes();
    }

    // LLEN 获取列表长度。
    public async long LLenAsync(string key) {
        RedisReply r = await this.CommandAsync2("LLEN", key);
        return r.AsLong();
    }

    // LINDEX 获取指定索引处的元素。
    public async string LIndexAsync(string key, long index) {
        List<string> args = new List<string>{ "LINDEX", key, Convert.ToString(index) };
        RedisReply r = await this.CommandAsync(args);
        if (r.IsNil()) { return ""; }
        return r.AsString();
    }

    // LRANGE 获取指定闭区间 [start, stop] 的元素列表。
    public async List<string> LRangeAsync(string key, long start, long stop) {
        List<string> args = new List<string>{ "LRANGE", key, Convert.ToString(start), Convert.ToString(stop) };
        RedisReply r = await this.CommandAsync(args);
        return r.AsListString();
    }

    // LRANGE 获取指定闭区间元素并反序列化为对象列表 List&lt;T&gt;。
    public async List<T> LRangeObjectsAsync<T>(string key, long start, long stop) {
        List<string> rawList = await this.LRangeAsync(key, start, stop);
        List<T> res = new List<T>();
        if (rawList == null) { return res; }
        for (int i = 0; i < rawList.Count; i = i + 1) {
            string raw = rawList[i];
            if (raw == null || raw == "") {
                res.Add((T)(object)null);
            } else {
                res.Add(this.DeserializeObject<T>(raw));
            }
        }
        return res;
    }

    // LRANGE 获取指定闭区间元素并反序列化为 List&lt;T&gt;（FreeRedis cli.LRange&lt;T&gt; 规范）。
    public async List<T> LRangeAsync<T>(string key, long start, long stop) {
        return await this.LRangeObjectsAsync<T>(key, start, stop);
    }

    // LSET 设置指定索引处的元素值。
    public async bool LSetAsync(string key, long index, string value) {
        List<string> args = new List<string>{ "LSET", key, Convert.ToString(index), value };
        RedisReply r = await this.CommandAsync(args);
        return r.AsString() == "OK";
    }

