    }

    async long bitOp(string op, string destKey, List<string> keys) {
        List<string> args = new List<string>{ "BITOP", op, destKey };
        if (keys != null) {
            for (int i = 0; i < keys.Count; i = i + 1) { args.Add(keys[i]); }
        }
        RedisReply r = await this.CommandAsync(args);
        return r.AsLong();
    }

    // BITPOS 查找第一个设置为指定 bit (0 或 1) 的位置。
    public async long BitPosAsync(string key, int bit) {
        List<string> args = new List<string>{ "BITPOS", key, Convert.ToString(bit) };
        RedisReply r = await this.CommandAsync(args);
        return r.AsLong();
    }

    // HyperLogLog (基数统计)

    // PFADD 添加单个元素。
    public async bool PfAddAsync(string key, string element) {
        RedisReply r = await this.CommandAsync3("PFADD", key, element);
        return r.AsInt() == 1;
    }

    // PFADD 批量添加多个元素。
    public async bool PfAddMultipleAsync(string key, List<string> elements) {
        if (elements == null || elements.Count == 0) { return false; }
        List<string> args = new List<string>{ "PFADD", key };
        for (int i = 0; i < elements.Count; i = i + 1) {
            args.Add(elements[i]);
        }
        RedisReply r = await this.CommandAsync(args);
        return r.AsInt() == 1;
    }

    // PFCOUNT 返回近似基数。
    public async long PfCountAsync(string key) {
        RedisReply r = await this.CommandAsync2("PFCOUNT", key);
        return r.AsLong();
    }

    // PFCOUNT 批量合并计算多个键的近似基数。
    public async long PfCountMultipleAsync(List<string> keys) {
        if (keys == null || keys.Count == 0) { return 0; }
        List<string> args = new List<string>{ "PFCOUNT" };
        for (int i = 0; i < keys.Count; i = i + 1) { args.Add(keys[i]); }
        RedisReply r = await this.CommandAsync(args);
        return r.AsLong();
    }

    // PFMERGE 合并多个源 HyperLogLog 到目标键。
    public async bool PfMergeAsync(string destKey, List<string> sourceKeys) {
        if (sourceKeys == null || sourceKeys.Count == 0) { return false; }
        List<string> args = new List<string>{ "PFMERGE", destKey };
        for (int i = 0; i < sourceKeys.Count; i = i + 1) { args.Add(sourceKeys[i]); }
        RedisReply r = await this.CommandAsync(args);
        return r.AsString() == "OK";
    }

    // 发布与订阅 (Pub / Sub)

    // PUBLISH 向指定频道发布消息，返回接收到消息的订阅者数量。
    public async long PublishAsync(string channel, string message) {
        List<string> args = new List<string>{ "PUBLISH", channel, message };
        RedisReply r = await this.CommandAsync(args);
        return r.AsLong();
    }

    // 服务端与系统管理 (Server & System)

    // DBSIZE 返回当前数据库中的键数量。
    public async long DbSizeAsync() {
        RedisReply r = await this.CommandAsync1("DBSIZE");
        return r.AsLong();
    }

    // FLUSHDB 清空当前逻辑数据库。
    public async bool FlushDbAsync() {
        RedisReply r = await this.CommandAsync1("FLUSHDB");
        return r.AsString() == "OK";
    }

    // FLUSHALL 清空所有逻辑数据库。
    public async bool FlushAllAsync() {
        RedisReply r = await this.CommandAsync1("FLUSHALL");
        return r.AsString() == "OK";
    }

    // TIME 获取服务器时间（[0]为秒，[1]为微秒）。
    public async List<string> TimeAsync() {
        RedisReply r = await this.CommandAsync1("TIME");
        return r.AsListString();
    }

    // INFO 获取服务器信息与统计数据。
    public async string InfoAsync() {
        RedisReply r = await this.CommandAsync1("INFO");
        return r.AsString();
    }

    // INFO 获取指定节的服务器信息。
    public async string InfoAsync(string section) {
        RedisReply r = await this.CommandAsync2("INFO", section);
        return r.AsString();
    }

    // BGSAVE 异步将数据库保存到磁盘。
    public async string BgSaveAsync() {
        RedisReply r = await this.CommandAsync1("BGSAVE");
        return r.AsString();
    }

    // LASTSAVE 返回最近一次成功将数据保存到磁盘的 UNIX 时间戳。
    public async long LastSaveAsync() {
        RedisReply r = await this.CommandAsync1("LASTSAVE");
        return r.AsLong();
    }

    // 状态与辅助

    // 返回最近记录到的服务器错误消息（如有）。
    public string GetLastError() {
        return this.lastError;
    }

    // 已连接则返回 true。
    public bool IsConnected() {
        if (this.pool != null) {
            return !this.pool.IsClosed();
        }
        return this.connected;
    }

}
