    public async long BitOpAndAsync(string destKey, List<string> keys) { return await this.bitOp("AND", destKey, keys); }
    public async long BitOpOrAsync(string destKey, List<string> keys) { return await this.bitOp("OR", destKey, keys); }
    public async long BitOpXorAsync(string destKey, List<string> keys) { return await this.bitOp("XOR", destKey, keys); }

