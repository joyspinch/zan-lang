using System;
using System.Collections.Generic;

namespace System.Data.Redis;

public partial class RedisClient {
    async RedisReply ExecKeyValuesAsync(string cmd, string key, List<string> values) {
        List<string> args = new List<string>{ cmd, key };
        for (int i = 0; i < values.Count; i = i + 1) { args.Add(values[i]); }
        return await this.CommandAsync(args);
    }

    async RedisReply ExecKeysAsync(string cmd, List<string> keys) {
        List<string> args = new List<string>{ cmd };
        for (int i = 0; i < keys.Count; i = i + 1) { args.Add(keys[i]); }
        return await this.CommandAsync(args);
    }

    async RedisReply ExecDestKeysAsync(string cmd, string dest, List<string> keys) {
        List<string> args = new List<string>{ cmd, dest };
        if (keys != null) {
            for (int i = 0; i < keys.Count; i = i + 1) { args.Add(keys[i]); }
        }
        return await this.CommandAsync(args);
    }

    async RedisScanResult ScanKeyAsync(string cmd, string key, long cursor, string pattern, int count) {
        List<string> args = new List<string>{ cmd, key, Convert.ToString(cursor) };
        if (pattern != null && pattern.Length > 0) {
            args.Add("MATCH");
            args.Add(pattern);
        }
        if (count > 0) {
            args.Add("COUNT");
            args.Add(Convert.ToString(count));
        }
        return RedisClient.ParseScanReply(await this.CommandAsync(args));
    }

    static RedisScanResult ParseScanReply(RedisReply r) {
        if (r != null && r.kind == RedisReply.ARRAY && r.Count() >= 2) {
            long nextCur = r.At(0).AsLong();
            return new RedisScanResult(nextCur, r.At(1).AsListString());
        }
        return new RedisScanResult(0, new List<string>());
    }

    // 列表 (Lists)

    public async long LPushAsync(string key, string value) {
        RedisReply r = await this.CommandAsync3("LPUSH", key, value);
        return r.AsLong();
    }

    public async long LPushAsync<T>(string key, T value) {
        return await this.LPushAsync(key, this.SerializeObject((object)value));
    }

    public async long LPushMultipleAsync(string key, List<string> values) {
        if (values == null || values.Count == 0) { return 0; }
        RedisReply r = await this.ExecKeyValuesAsync("LPUSH", key, values);
        return r.AsLong();
    }

    public async long RPushAsync(string key, string value) {
        RedisReply r = await this.CommandAsync3("RPUSH", key, value);
        return r.AsLong();
    }

    public async long RPushAsync<T>(string key, T value) {
        return await this.RPushAsync(key, this.SerializeObject((object)value));
    }

    public async long RPushMultipleAsync(string key, List<string> values) {
        if (values == null || values.Count == 0) { return 0; }
        RedisReply r = await this.ExecKeyValuesAsync("RPUSH", key, values);
        return r.AsLong();
    }

