    public async long PfCountMultipleAsync(List<string> keys) {
        RedisClient c = await this.AcquireAsync();
        if (c == null) { return 0; }
        try { return await c.PfCountMultipleAsync(keys); } finally { this.Release(c); }
    }

    public async bool PfMergeAsync(string destKey, List<string> sourceKeys) {
        RedisClient c = await this.AcquireAsync();
        if (c == null) { return false; }
        try { return await c.PfMergeAsync(destKey, sourceKeys); } finally { this.Release(c); }
    }

