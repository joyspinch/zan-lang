using System;
using System.Collections.Generic;
using System.Data;

namespace System.Data.Redis;

// Redis 客户端连接池（对标 FreeRedis 规范设计）。
// 具备双重使用形态：
// 1. 高级免借还客户端：直接在池上调用 GetAsync / SetAsync / HSetAsync 等全套高阶命令，
// 内部自动借出并在执行完成后安全归还，支持高并发协程调用；
// 2. 传统借还池：通过 AcquireAsync / Release 手动管理特定长事务或复杂序列。
public partial class RedisPool : IDisposable {
    string host;
    int port;
    int connectTimeoutMs;
    RedisOptions options;
    PoolCore<RedisClient> core;

    // 对象序列化委托（例如 obj => Json.Serialize(obj)）。
    public RedisSerializer Serialize;

    // 对象反序列化委托（例如 (json, type) => Json.Deserialize(json, type)）。
    public RedisDeserializer Deserialize;

    // 命令执行日志与审计通知事件（FreeRedis Notice 规范）。
    public NoticeEventHandler Notice;

    // 通过连接字符串构造连接池（FreeRedis 规范）。
    public RedisPool(string connectionString) : this(RedisOptions.Parse(connectionString)) {
    }

    // 通过配置项构造连接池。
    public RedisPool(RedisOptions options) {
        this.options = options;
        this.host = options.host;
        this.port = options.port;
        this.connectTimeoutMs = options.connectTimeoutMs;
        int size = options.poolSize > 0 ? options.poolSize : 10;
        this.core = new PoolCore<RedisClient>(size);
    }

    // 以默认 3000ms 连接超时构建池。
    public RedisPool(string host, int port, int maxSize) : this(host, port, maxSize, 3000) {
    }

    // 以显式连接超时（毫秒）构建池。
    public RedisPool(string host, int port, int maxSize, int connectTimeoutMs) {
        this.options = new RedisOptions();
        this.options.host = host;
        this.options.port = port;
        this.options.poolSize = maxSize;
        this.options.connectTimeoutMs = connectTimeoutMs;
        this.host = host;
        this.port = port;
        this.connectTimeoutMs = connectTimeoutMs;
        this.core = new PoolCore<RedisClient>(maxSize);
    }

    // 新建一个客户端并用 PING 验证可用性（含自动认证与库切换）。
    async RedisClient OpenOne() {
        RedisClient client = null;
        if (this.options != null && this.options.ssl) {
            client = await RedisClient.ConnectSecureAsync(
                this.host, this.port, this.connectTimeoutMs);
        } else {
            client = await RedisClient.ConnectAsync(
                this.host, this.port, this.connectTimeoutMs);
        }
        if (client == null) {
            this.NoteOpenEpisode("connect failed (refused or timeout)");
            return null;
        }
        try {
            if (this.options != null && this.options.password != null && this.options.password.Length > 0) {
                bool authOk = false;
                if (this.options.user != null && this.options.user.Length > 0) {
                    authOk = await client.AuthAsync(this.options.user, this.options.password);
                } else {
                    authOk = await client.AuthAsync(this.options.password);
                }
                if (!authOk) {
                    this.NoteOpenEpisode("auth failed");
                    client.Close();
                    return null;
                }
            }
            if (this.options != null && this.options.database > 0) {
                if (!await client.SelectAsync(this.options.database)) {
                    this.NoteOpenEpisode("select database failed");
                    client.Close();
                    return null;
                }
            }
            /* 池级钩子下沉拷贝到物理连接（开连时快照）。物理连接绝不能回绑
             * pool：pool != null 的客户端是借还门面，CommandAsync 会把每条
             * 命令重新走 pool.AcquireAsync——物理连接带上 pool 后连自己的
             * 验活 PING 都会递归开连挂死。 */
            client.Serialize = this.Serialize;
            client.Deserialize = this.Deserialize;
            client.Notice = this.Notice;
            if (!await client.PingAsync()) {
                string why = client.GetLastError();
                this.NoteOpenEpisode("ping failed"
                    + (why.Length > 0 ? ": " + why : ""));
                client.Close();
                return null;
            }
            return client;
        } catch (Exception ex) {
            this.NoteOpenEpisode("ping error: " + ex.Message);
            client.Close();
            return null;
        }
    }

    void NoteOpenEpisode(string detail) {
        if (!this.core.OpenFailing()) {
            Console.WriteLine("[redispool] " + this.host + ":"
                + Convert.ToString(this.port) + " " + detail);
        }
    }

    // 借出一个客户端。
    public async RedisClient AcquireAsync() {
        PoolWait wait = new PoolWait();
        while (true) {
            if (this.core.IsClosed()) { return null; }
            RedisClient pooled = this.core.TakeIdle();
            while (pooled != null) {
                if (pooled.IsConnected()) { return pooled; }
                this.core.Drop(pooled);
                pooled = this.core.TakeIdle();
            }
            if (this.core.OpenBlocked()) {
                return null;
            }
            if (this.core.TryReserve()) {
                RedisClient opened = null;
                try {
                    opened = await this.OpenOne();
                } catch (Exception ex) {
                    this.NoteOpenEpisode("open error: " + ex.Message);
                    this.core.NoteOpenFailed();
                    this.core.UndoReserve();
                    return null;
                }
                if (opened == null || !opened.IsConnected()) {
                    this.core.NoteOpenFailed();
                    this.core.UndoReserve();
                    return null;
                }
                if (this.core.IsClosed()) {
                    opened.Close();
                    this.core.UndoReserve();
                    return null;
                }
                this.core.NoteOpenOk();
                this.core.Borrow(opened);
                return opened;
            }
            if (!await this.core.WaitForRelease(wait)) {
                return null;
            }
        }
        return null;
    }

    // 归还一个客户端。
    public void Release(RedisClient client) {
        if (client == null) { return; }
        if (this.core.IsClosed() || !client.IsConnected()) {
            client.Close();
            this.core.Drop(client);
            return;
        }
        this.core.Pool(client);
    }

    public int IdleCount() { return this.core.IdleCount(); }
    public int LiveCount() { return this.core.LiveCount(); }
    public int WaitingCount() { return this.core.WaitingCount(); }
    public int MaxSize() { return this.core.MaxSize(); }
    public bool IsClosed() { return this.core.IsClosed(); }

    // 关闭池：关闭所有连接并唤醒等待者。
    public void Close() {
        this.core.MarkClosed();
        RedisClient client = this.core.TakeIdle();
        while (client != null) {
            client.Close();
            this.core.Drop(client);
            client = this.core.TakeIdle();
        }
        this.core.WakeAll();
    }

    public void Dispose() {
        this.Close();
    }

    // FreeRedis 风格高阶透明调用：自动借还连接执行命令

    public async RedisReply CommandAsync(List<string> args) {
        RedisClient c = await this.AcquireAsync();
        if (c == null) {
            RedisReply err = new RedisReply();
            err.kind = RedisReply.ERROR;
            err.str = "failed to acquire redis client from pool";
            return err;
        }
        try {
            return await c.CommandAsync(args);
        } finally {
            this.Release(c);
        }
    }

    public async RedisReply CommandBytesAsync(List<string> prefixArgs, byte[] binaryArg) {
        RedisClient c = await this.AcquireAsync();
        if (c == null) {
            RedisReply err = new RedisReply();
            err.kind = RedisReply.ERROR;
            err.str = "failed to acquire redis client from pool";
            return err;
        }
        try {
            return await c.CommandBytesAsync(prefixArgs, binaryArg);
        } finally {
            this.Release(c);
        }
    }

    public async bool PingAsync() {
        RedisClient c = await this.AcquireAsync();
        if (c == null) { return false; }
        try { return await c.PingAsync(); } finally { this.Release(c); }
    }

    public async string EchoAsync(string message) {
        RedisClient c = await this.AcquireAsync();
        if (c == null) { return ""; }
        try { return await c.EchoAsync(message); } finally { this.Release(c); }
    }

