using System;
using System.Collections.Generic;

namespace System.Data.Redis;

/// <summary>
/// 一条已解析的 RESP（REdis Serialization Protocol）回复。
///
/// Redis 回复自带类型信息；<see cref=\"kind\"/> 指明值在哪个字段中：
/// 携带值：
///   - <c>STR</c>   : simple string (<c>+OK</c>)        -> <see cref=\"str\"/>
///   - <c>ERROR</c> : error string (<c>-ERR ...</c>)    -> <see cref=\"str\"/>
///   - <c>INT</c>   : integer (<c>:42</c>)              -> <see cref=\"integer\"/>
///   - <c>BULK</c>  : bulk string (<c>$3\r\nfoo</c>)    -> <see cref=\"str\"/> / <see cref=\"len\"/>
///   - <c>NIL</c>   : null bulk / null array (<c>$-1</c>)
///   - <c>ARRAY</c> : array (<c>*2 ...</c>)             -> <see cref=\"items\"/>
///
/// <see cref=\"len\"/> 是 BULK 负载的真实字节长度；当值可能含
/// NUL 字节时，用它代替 <c>str.Length</c>（二进制安全）。
/// </summary>
class RedisReply {
    static int STR   = 1;
    static int ERROR = 2;
    static int INT   = 3;
    static int BULK  = 4;
    static int NIL   = 5;
    static int ARRAY = 6;

    int kind;
    string str;
    int len;
    int integer;
    long integer64;
    List<RedisReply> items;

    RedisReply() {
        this.kind = RedisReply.NIL;
        this.str = "";
        this.len = 0;
        this.integer = 0;
        this.integer64 = 0;
        this.items = null;
    }

    /// <summary>当回复为 null bulk 字符串或 null 数组时为 true。</summary>
    bool IsNil() {
        return this.kind == RedisReply.NIL;
    }

    /// <summary>当回复为服务器错误（<c>-ERR ...</c>）时为 true。</summary>
    bool IsError() {
        return this.kind == RedisReply.ERROR;
    }

    /// <summary>当回复为简单字符串或 bulk 字符串时为 true。</summary>
    bool IsString() {
        return this.kind == RedisReply.STR || this.kind == RedisReply.BULK;
    }

    /// <summary>返回原始字节数组。二进制安全，即使包含 NUL 字节也不会被截断。</summary>
    byte[] AsBytes() {
        if (this.kind != RedisReply.BULK || this.len <= 0) {
            return new byte[0];
        }
        byte[] b = new byte[this.len];
        NativeMemory.Copy((nint)b, (nint)this.str, this.len);
        return b;
    }

    /// <summary>返回字符串负载（nil 或非字符串类型返回空）。</summary>
    string AsString() {
        if (this.kind == RedisReply.STR || this.kind == RedisReply.BULK ||
            this.kind == RedisReply.ERROR) {
            return this.str;
        }
        if (this.kind == RedisReply.INT) {
            return Convert.ToString(this.integer64);
        }
        return "";
    }

    /// <summary>返回整数负载（非整数类型返回 0）。</summary>
    int AsInt() {
        if (this.kind == RedisReply.INT) {
            return this.integer;
        }
        if ((this.kind == RedisReply.STR || this.kind == RedisReply.BULK) &&
            this.len > 0) {
            return Convert.ToInt(this.str);
        }
        return 0;
    }

    /// <summary>返回 64 位长整数负载（非整数类型尝试从字符串转换，非法返回 0）。</summary>
    long AsLong() {
        if (this.kind == RedisReply.INT) {
            return this.integer64;
        }
        if ((this.kind == RedisReply.STR || this.kind == RedisReply.BULK) &&
            this.len > 0) {
            return Convert.ToInt64(this.str);
        }
        return 0;
    }

    /// <summary>返回浮点数值（非数字类型返回 0.0）。</summary>
    double AsDouble() {
        if (this.kind == RedisReply.INT) {
            return (double)this.integer64;
        }
        if ((this.kind == RedisReply.STR || this.kind == RedisReply.BULK) &&
            this.len > 0) {
            return Convert.ToDouble(this.str);
        }
        return 0.0;
    }

    /// <summary>返回布尔值：状态为 "OK"、值为 1 或字符串为 "true"/"1"/"PONG" 返回 true。</summary>
    bool AsBool() {
        if (this.kind == RedisReply.INT) {
            return this.integer64 != 0;
        }
        if (this.kind == RedisReply.STR || this.kind == RedisReply.BULK) {
            string s = this.str;
            return s == "OK" || s == "1" || s == "true" || s == "PONG";
        }
        return false;
    }

    /// <summary>ARRAY 回复转为字符串列表（nil 元素视为空字符串）。</summary>
    List<string> AsListString() {
        List<string> res = new List<string>();
        if (this.kind == RedisReply.ARRAY && this.items != null) {
            for (int i = 0; i < this.items.Count; i = i + 1) {
                RedisReply item = this.items[i];
                if (item.IsNil()) {
                    res.Add("");
                } else {
                    res.Add(item.AsString());
                }
            }
        }
        return res;
    }

    /// <summary>ARRAY 回复转为字典（成对键值，如 HGETALL 返回的 field, val 序列）。</summary>
    Dictionary<string, string> AsDictionary() {
        Dictionary<string, string> dict = new Dictionary<string, string>();
        if (this.kind == RedisReply.ARRAY && this.items != null) {
            int n = this.items.Count;
            for (int i = 0; i + 1 < n; i = i + 2) {
                string k = this.items[i].AsString();
                string v = this.items[i + 1].AsString();
                dict.Add(k, v);
            }
        }
        return dict;
    }

    /// <summary>ARRAY 回复转为有序集合成员列表（成对的 member, score 序列）。</summary>
    List<ZMember> AsZMemberList() {
        List<ZMember> res = new List<ZMember>();
        if (this.kind == RedisReply.ARRAY && this.items != null) {
            int n = this.items.Count;
            for (int i = 0; i + 1 < n; i = i + 2) {
                string m = this.items[i].AsString();
                double sc = this.items[i + 1].AsDouble();
                res.Add(new ZMember(m, sc));
            }
        }
        return res;
    }

    /// <summary>ARRAY 回复的元素数量（否则为 0）。</summary>
    int Count() {
        if (this.kind == RedisReply.ARRAY && this.items != null) {
            return this.items.Count;
        }
        return 0;
    }

    /// <summary>ARRAY 回复中下标为 <paramref name=\"i\"/> 的元素。</summary>
    RedisReply At(int i) {
        return this.items[i];
    }
}
