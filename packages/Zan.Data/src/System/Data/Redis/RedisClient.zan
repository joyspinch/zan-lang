    async T GetAsync<T>(string key) {
        return await this.GetObjectAsync<T>(key);
    }

    /// <summary>二进制安全的 GET：返回原始字节数组。键不存在返回 null。</summary>
    async byte[] GetBytesAsync(string key) {
        RedisReply r = await this.CommandAsync2("GET", key);
        if (r.IsNil() || r.IsError()) { return null; }
        return r.AsBytes();
    }

    /// <summary>GET key，返回原始 RESP 回复。</summary>
    async RedisReply GetReplyAsync(string key) {
        return await this.CommandAsync2("GET", key);
    }

    /// <summary>GETSET key value：设置新值并返回旧值。</summary>
    async string GetSetAsync(string key, string val) {
        RedisReply r = await this.CommandAsync3("GETSET", key, val);
        if (r.IsNil()) { return ""; }
        return r.AsString();
    }

    /// <summary>SET key value。成功返回 true。</summary>
    async bool SetAsync(string key, string val) {
        RedisReply r = await this.CommandAsync3("SET", key, val);
        return r.AsString() == "OK";
    }

    /// <summary>SET key value EX seconds：带过期时间秒数的设置。</summary>
    async bool SetAsync(string key, string val, int expireSeconds) {
        if (expireSeconds <= 0) {
            return await this.SetAsync(key, val);
        }
        List<string> args = new List<string>{ "SET", key, val, "EX", Convert.ToString(expireSeconds) };
        RedisReply r = await this.CommandAsync(args);
        return r.AsString() == "OK";
    }

    /// <summary>SET key value [EX seconds] [NX|XX] 全功能重载。</summary>
    async bool SetAsync(string key, string val, int expireSeconds, bool nx, bool xx) {
        List<string> args = new List<string>{ "SET", key, val };
        if (expireSeconds > 0) {
            args.Add("EX");
            args.Add(Convert.ToString(expireSeconds));
        }
        if (nx) {
            args.Add("NX");
        } else if (xx) {
            args.Add("XX");
        }
        RedisReply r = await this.CommandAsync(args);
        return r.AsString() == "OK";
    }

    /// <summary>SETEX key seconds value。</summary>
    async bool SetExAsync(string key, int seconds, string val) {
        List<string> args = new List<string>{ "SETEX", key, Convert.ToString(seconds), val };
        RedisReply r = await this.CommandAsync(args);
        return r.AsString() == "OK";
    }

    /// <summary>SETNX key value：键不存在时才设置，成功返回 true。</summary>
    async bool SetNxAsync(string key, string val) {
        RedisReply r = await this.CommandAsync3("SETNX", key, val);
        return r.AsInt() == 1;
    }

    /// <summary>SETNX 带过期时间设置（原子锁常用）。</summary>
    async bool SetNxAsync(string key, string val, int expireSeconds) {
        return await this.SetAsync(key, val, expireSeconds, true, false);
    }

    /// <summary>SETXX key value：键已存在时才设置更新。</summary>
    async bool SetXxAsync(string key, string val) {
        return await this.SetAsync(key, val, 0, false, true);
    }

