using System;
using System.Collections.Generic;
using System.Net.Sockets;
using System.Net.Tls;
using System.Data.Redis;
using System.Threading;

namespace System.Data.Redis;

// 基于异步 IO reactor、使用 RESP（RESP2）协议的高性能协程化 Redis 客户端。
// 全面对标 FreeRedis 规范设计，支持池化多协程安全复用与丰富强类型命令，告别手拼命令。
// 用法（免借还连接池模式，如同 FreeRedis）：
// 用法（单一底层连接模式）：
// r.Close();
public partial class RedisClient {
    nint sock;
    string host;
    int port;
    bool connected;
    string lastError;
    string protocolError;
    // Per-line content bytes, including the RESP type byte but excluding CRLF.
    private const int MaxProtocolLineBytes = 65536;
    private const int MaxReceiveBufferBytes = 1073741824;
    private const int MaxProtocolArrayDepth = 64;
    int maxReplyPayloadBytes;
    int maxReplyNodes;
    bool busy;
    List<AsyncGate> waiters;

    byte[] inbuf;
    int incap;
    int inhead;
    int intail;
    byte[] tmp;
    int tmpcap;
    TlsStream tls;

    // 当作为池化客户端使用时，委托至该连接池执行
    RedisPool pool;

    // 对象序列化委托（例如 obj => Json.Serialize(obj)）。
    public RedisSerializer Serialize;

    // 对象反序列化委托（例如 (json, type) => Json.Deserialize(json, type)）。
    public RedisDeserializer Deserialize;

    // 命令执行日志与审计通知事件（FreeRedis Notice 规范）。
    public NoticeEventHandler Notice;

    private static bool defaultVerifyTls = true;
    public static bool verifyTls {
        get { return RedisClient.defaultVerifyTls; }
        set { RedisClient.defaultVerifyTls = value; }
    }

    // 切换后续 ConnectSecureAsync 的证书与主机名校验。
    public static void SetTlsVerify(bool verify) {
        RedisClient.defaultVerifyTls = verify;
    }

    public bool tlsVerify = true;

    [DllImport("crt")]
    static extern long strlen(string str);

    // 通过连接字符串创建池化 Redis 客户端（FreeRedis 规范）。
    public RedisClient(string connectionString) {
        RedisOptions opt = RedisOptions.Parse(connectionString);
        this.initPool(opt);
    }

    // 通过配置项创建池化 Redis 客户端。
    public RedisClient(RedisOptions options) {
        this.initPool(options);
    }

    // 直接绑定现有连接池作为客户端。
    public RedisClient(RedisPool pool) {
        this.initMembers();
        this.pool = pool;
    }

    void initMembers() {
        this.sock = -1;
        this.host = "";
        this.port = 6379;
        this.connected = false;
        this.lastError = "";
        this.protocolError = "";
        this.maxReplyPayloadBytes = RedisReplyBudget.DefaultPayloadBytes;
        this.maxReplyNodes = RedisReplyBudget.DefaultNodes;
        this.inbuf = null;
        this.incap = 0;
        this.inhead = 0;
        this.intail = 0;
        this.tmp = null;
        this.tmpcap = 16384;
        this.tls = null;
        this.busy = false;
        this.waiters = new List<AsyncGate>();
        this.pool = null;
        this.Serialize = null;
        this.Deserialize = null;
        this.Notice = null;
    }

    // Per-root decoded reply limits; defaults: 64 MiB payload and 1,048,576
    // nodes (root, arrays, scalars and nil all count). Bulk/simple/error bytes
    // count at their wire length; integers count as eight bytes. Node overhead
    // is bounded separately, so empty values cannot bypass the memory bound.
    // Both limits must be positive; invalid/busy changes return false unchanged.
    // Configure before issuing commands. A pooled facade applies its limits to
    // each borrowed connection for that command, then restores its old limits.
    // Direct RedisPool users get defaults, or configure an acquired client.
    public bool SetReplyLimits(int maxPayloadBytes, int maxNodes) {
        if (maxPayloadBytes <= 0 || maxNodes <= 0 || this.busy) { return false; }
        this.maxReplyPayloadBytes = maxPayloadBytes;
        this.maxReplyNodes = maxNodes;
        return true;
    }

    void FireNotice(string logText, long elapsedMs, Exception ex) {
        if (this.Notice != null) {
            NoticeEventArgs e = new NoticeEventArgs(logText, elapsedMs, ex);
            this.Notice(this, e);
        }
        if (this.pool != null && this.pool.Notice != null) {
            NoticeEventArgs e2 = new NoticeEventArgs(logText, elapsedMs, ex);
            this.pool.Notice(this, e2);
        }
    }

    string formatCmdLog(List<string> args) {
        if (args == null || args.Count == 0) { return ""; }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < args.Count; i = i + 1) {
            if (i > 0) { sb.Append(" "); }
            string a = args[i];
            if (a.Length > 80) {
                sb.Append(a.Substring(0, 77) + "...");
            } else {
                sb.Append(a);
            }
        }
        return sb.ToString();
    }

    // 使用绑定的序列化器将对象转为字符串。
    public string SerializeObject(object obj) {
        if (obj == null) { return ""; }
        if (this.Serialize != null) {
            return this.Serialize(obj);
        }
        if (this.pool != null && this.pool.Serialize != null) {
            return this.pool.Serialize(obj);
        }
        return Convert.ToString(obj);
    }

    // 使用绑定的反序列化器将字符串解析为指定类型。
    public T DeserializeObject<T>(string val) {
        if (val == null) {
            return (T)(object)null;
        }
        if (this.Deserialize != null) {
            object obj = this.Deserialize(val, typeof(T));
            return (T)obj;
        }
        if (this.pool != null && this.pool.Deserialize != null) {
            object obj2 = this.pool.Deserialize(val, typeof(T));
            return (T)obj2;
        }
        return (T)(object)val;
    }

    void initPool(RedisOptions opt) {
        this.initMembers();
        this.host = opt.host;
        this.port = opt.port;
        this.pool = new RedisPool(opt);
    }

    // 私有构造；单一物理连接统一经 ConnectAsync 创建。
    public RedisClient() {
        this.initMembers();
    }

    // 连接 Redis 服务器（默认超时）。
    public static async RedisClient ConnectAsync(string host, int port) {
        return await RedisClient.ConnectAsync(host, port, 0);
    }

    // 带连接超时（毫秒，0 = 不限时）的连接；失败返回 null。
    public static async RedisClient ConnectAsync(string host, int port, int timeoutMs) {
        return await RedisClient.doConnect(host, port, timeoutMs, false);
    }

    // 通过连接字符串异步建立单物理连接。
    public static async RedisClient ConnectAsync(string connectionString) {
        RedisOptions opt = RedisOptions.Parse(connectionString);
        return await RedisClient.ConnectAsync(opt);
    }

    // 通过配置项异步建立单物理连接（包含自动 AUTH 与 SELECT）。
    public static async RedisClient ConnectAsync(RedisOptions opt) {
        RedisClient c = await RedisClient.doConnect(opt.host, opt.port, opt.connectTimeoutMs, opt.ssl);
        if (c == null) { return null; }
        if (opt.password != null && opt.password.Length > 0) {
            bool authOk = false;
            if (opt.user != null && opt.user.Length > 0) {
                authOk = await c.AuthAsync(opt.user, opt.password);
            } else {
                authOk = await c.AuthAsync(opt.password);
            }
            if (!authOk) {
                c.Close();
                return null;
            }
        }
        if (opt.database > 0) {
            bool selOk = await c.SelectAsync(opt.database);
            if (!selOk) {
                c.Close();
                return null;
            }
        }
        return c;
    }

    // TLS 加密信道连接。
    public static async RedisClient ConnectSecureAsync(string host, int port, int timeoutMs) {
        return await RedisClient.doConnect(host, port, timeoutMs, true);
    }

    static async RedisClient doConnect(string host, int port, int timeoutMs, bool secure) {
        Socket.Initialize();
        RedisClient c = new RedisClient();
        c.host = host;
        c.port = port;
        c.sock = Socket.CreateTcp();
        Socket.SetNonBlocking(c.sock);
        int err = await Socket.ConnectAsync(c.sock, host, port, timeoutMs);
        if (err != 0) {
            Socket.Close(c.sock);
            c.sock = -1;
            return null;
        }
        if (secure) {
            TlsContext tlsCtx = TlsContext.CreateClient();
            if (tlsCtx == null) {
                Socket.Close(c.sock);
                c.sock = -1;
                return null;
            }
            if (!c.tlsVerify || !RedisClient.defaultVerifyTls) { tlsCtx.DisableVerify(); }
            int hsTimeout = timeoutMs > 0 ? timeoutMs : 15000;
            c.tls = await TlsStream.ConnectAsync(tlsCtx, c.sock, host, hsTimeout);
            if (c.tls == null) {
                Socket.Close(c.sock);
                c.sock = -1;
                return null;
            }
        }
        c.connected = true;
        c.incap = 16384;
        c.inbuf = new byte[c.incap + 1];
        c.inhead = 0;
        c.intail = 0;
        c.tmp = new byte[c.tmpcap + 1];
        return c;
    }

    async bool AcquireLock() {
        if (!this.busy) {
            this.busy = true;
            return true;
        }
        AsyncGate g = new AsyncGate();
        this.waiters.Add(g);
        await g.Wait();
        g.Close();
        return true;
    }

    void ReleaseLock() {
        if (this.waiters != null && this.waiters.Count > 0) {
            AsyncGate g = this.waiters[0];
            this.waiters.RemoveAt(0);
            g.Signal();
        } else {
            this.busy = false;
        }
    }

    // 关闭连接并释放缓冲区；若是池化客户端则关闭连接池。
    public void Close() {
        if (this.pool != null) {
            this.pool.Close();
            this.pool = null;
        }
        while (this.waiters != null && this.waiters.Count > 0) {
            AsyncGate g = this.waiters[0];
            this.waiters.RemoveAt(0);
            g.Signal();
        }
        this.busy = false;
        if (this.tls != null) {
            this.tls.Close();
            this.tls = null;
        }
        if (this.connected || this.sock >= 0) {
            Socket.Close(this.sock);
            this.connected = false;
            this.sock = -1;
        }
        this.inbuf = null;
        this.tmp = null;
        this.inhead = 0;
        this.intail = 0;
        this.incap = 0;
    }

    void failProtocol(string detail) {
        this.protocolError = "protocol error: " + detail;
        this.lastError = this.protocolError;
        this.Close();
    }

    RedisReply protocolFailure() {
        RedisReply r = new RedisReply();
        r.kind = RedisReply.ERROR;
        r.str = this.protocolError;
        return r;
    }

    string sliceBytes(int start, int len) {
        return this.inbuf.ToStr(start, len);
    }

    bool ensureRoom(int extra) {
        if (extra < 0 || extra > RedisClient.MaxReceiveBufferBytes) {
            this.failProtocol("receive buffer limit exceeded");
            return false;
        }
        if (extra <= this.incap - this.intail) {
            return true;
        }
        if (this.inhead > 0) {
            int span = this.intail - this.inhead;
            if (span > 0) {
                NativeMemory.Copy((nint)this.inbuf, (nint)this.inbuf + (nint)this.inhead, span);
            }
            this.inhead = 0;
            this.intail = span;
        }
        if (extra <= this.incap - this.intail) {
            return true;
        }
        if (this.intail > RedisClient.MaxReceiveBufferBytes - extra) {
            this.failProtocol("receive buffer limit exceeded");
            return false;
        }
        int need = this.intail + extra;
        int ncap = this.incap > 0 ? this.incap : 16384;
        while (need > ncap) {
            if (ncap > RedisClient.MaxReceiveBufferBytes / 2) {
                ncap = RedisClient.MaxReceiveBufferBytes;
            } else {
                ncap = ncap * 2;
            }
        }
        byte[] nb = new byte[ncap + 1];
        if (this.intail > 0) {
            NativeMemory.Copy((nint)nb, (nint)this.inbuf, this.intail);
        }
        this.inbuf = nb;
        this.incap = ncap;
        return true;
    }

    async int fillMore(int maxBytes) {
        if (!this.connected) { return 0; }
        int take = maxBytes < this.tmpcap ? maxBytes : this.tmpcap;
        int n;
        if (this.tls != null) {
            n = await this.tls.RecvBytesAsync(this.tmp, 0, take);
        } else {
            n = await Socket.RecvIntoAsync(this.sock, this.tmp, take);
        }
        if (n <= 0) {
            this.failProtocol("truncated RESP reply");
            return 0;
        }
        if (!this.ensureRoom(n)) { return 0; }
        NativeMemory.Copy((nint)this.inbuf + (nint)this.intail, (nint)this.tmp, n);
        this.intail = this.intail + n;
        return n;
    }

    async bool ensureAvailable(int need) {
        while ((this.intail - this.inhead) < need) {
            int got = await this.fillMore(this.tmpcap);
            if (got == 0) {
                return false;
            }
        }
        return true;
    }

    async string readLine(RedisReplyBudget budget) {
        int scanned = 0;
        while (this.connected) {
            int available = this.intail - this.inhead;
            int window = available;
            if (window > RedisClient.MaxProtocolLineBytes + 2) {
                window = RedisClient.MaxProtocolLineBytes + 2;
            }
            int scan = this.inhead + scanned;
            int pos = MemoryExtensions.IndexOf(this.inbuf, (byte)13, scan, window - scanned);
            int lf = MemoryExtensions.IndexOf(this.inbuf, (byte)10, scan, window - scanned);
            if (lf >= 0 && (pos < 0 || lf < pos)) {
                this.failProtocol("invalid RESP line ending");
                return null;
            }
            if (pos >= 0) {
                int lineLen = pos - this.inhead;
                if (lineLen > RedisClient.MaxProtocolLineBytes) {
                    this.failProtocol("RESP line exceeds 65536 byte limit");
                    return null;
                }
                if (pos + 1 < this.intail) {
                    if (this.inbuf[pos + 1] != 10) {
                        this.failProtocol("invalid RESP line ending");
                        return null;
                    }
                    // Charge raw text bytes before either ToStr or Substring.
                    // Numeric/length headers stay bounded by the line guard;
                    // their decoded payload is admitted by readReplyAtDepth.
                    if (lineLen > 0 && (this.inbuf[this.inhead] == 43 || this.inbuf[this.inhead] == 45)) {
                        if (!budget.AdmitPayload(lineLen - 1)) {
                            this.failProtocol("RESP reply payload budget exceeded");
                            return null;
                        }
                    }
                    string line = this.sliceBytes(this.inhead, lineLen);
                    this.inhead = pos + 2;
                    return line;
                }
                scanned = lineLen;
            } else {
                scanned = window;
                if (available > RedisClient.MaxProtocolLineBytes) {
                    this.failProtocol("RESP line exceeds 65536 byte limit");
                    return null;
                }
            }
            // Limit this read before ensureRoom can grow; later replies already
            // prefetched after a complete CRLF do not contribute to this budget.
            int remaining = RedisClient.MaxProtocolLineBytes + 2 - available;
            int got = await this.fillMore(remaining);
            if (got == 0) { return null; }
        }
        return null;
    }

    async string readBulk(int n) {
        bool ok = await this.ensureAvailable(n + 2);
        if (!ok) {
            return null;
        }
        if (this.inbuf[this.inhead + n] != 13 || this.inbuf[this.inhead + n + 1] != 10) {
            this.failProtocol("invalid bulk string trailer");
            return null;
        }
        string data = this.sliceBytes(this.inhead, n);
        this.inhead = this.inhead + n + 2;
        return data;
    }

    async RedisReply readReply() {
        RedisReplyBudget budget = new RedisReplyBudget(this.maxReplyPayloadBytes, this.maxReplyNodes);
        if (!budget.AdmitNodes(1)) {
            this.failProtocol("RESP reply node budget exceeded");
            return this.protocolFailure();
        }
        return await this.readReplyAtDepth(0, budget);
    }

    // The root or parent array reserves this node before entering the parser.
    async RedisReply readReplyAtDepth(int arrayDepth, RedisReplyBudget budget) {
        string line = await this.readLine(budget);
        if (line == null) { return this.protocolFailure(); }
        RedisReply r = new RedisReply();
        if (line.Length == 0) {
            this.failProtocol("empty RESP line");
            return this.protocolFailure();
        }
        int prefix = line[0];
        string rest = line.Substring(1);
        if (prefix == 43) {  // '+'
            r.kind = RedisReply.STR;
            r.str = rest;
            r.len = (int)strlen(rest);
            return r;
        }
        if (prefix == 45) {  // '-'
            r.kind = RedisReply.ERROR;
            r.str = rest;
            r.len = (int)strlen(rest);
            return r;
        }
        long number = 0;
        if (prefix == 58 || prefix == 36 || prefix == 42) {
            if (!RedisClient.tryProtocolInteger(rest, out number)) {
                this.failProtocol("invalid RESP integer");
                return this.protocolFailure();
            }
        }
        if (prefix == 58) {  // ':'
            if (!budget.AdmitPayload(8)) {
                this.failProtocol("RESP reply payload budget exceeded");
                return this.protocolFailure();
            }
            r.kind = RedisReply.INT;
            r.integer64 = number;
            r.integer = (int)r.integer64;
            return r;
        }
        if (prefix == 36) {  // '$'
            if (number == -1) {
                r.kind = RedisReply.NIL;
                return r;
            }
            if (number < -1 || number > 536870912) {
                this.failProtocol("bulk string length outside -1..536870912 limit");
                return this.protocolFailure();
            }
            int blen = (int)number;
            // Admit the advertised length before receive-buffer growth or ToStr.
            if (!budget.AdmitPayload(blen)) {
                this.failProtocol("RESP reply payload budget exceeded");
                return this.protocolFailure();
            }
            string data = await this.readBulk(blen);
            if (data == null) { return this.protocolFailure(); }
            r.kind = RedisReply.BULK;
            r.str = data;
            r.len = blen;
            return r;
        }
        if (prefix == 42) {  // '*'
            // Bound active array frames before allocating or descending.
            if (arrayDepth >= RedisClient.MaxProtocolArrayDepth) {
                this.failProtocol("RESP array nesting exceeds 64 level limit");
                return this.protocolFailure();
            }
            if (number == -1) {
                r.kind = RedisReply.NIL;
                return r;
            }
            if (number < -1 || number > 1048576) {
                this.failProtocol("array element count outside -1..1048576 limit");
                return this.protocolFailure();
            }
            int count = (int)number;
            // Reserve all direct children at the header, before allocating the
            // list or any child. Descendants share this root's remaining nodes.
            if (!budget.AdmitNodes(count)) {
                this.failProtocol("RESP reply node budget exceeded");
                return this.protocolFailure();
            }
            r.kind = RedisReply.ARRAY;
            r.items = new List<RedisReply>();
            for (int i = 0; i < count; i = i + 1) {
                RedisReply child = await this.readReplyAtDepth(arrayDepth + 1, budget);
                if (!this.connected) { return child; }
                r.items.Add(child);
            }
            return r;
        }
        this.failProtocol("unknown RESP type");
        return this.protocolFailure();
    }

    static bool tryProtocolInteger(string text, out long value) {
        value = 0;
        if (text.Length == 0) { return false; }
        bool negative = text[0] == 45;
        int i = negative || text[0] == 43 ? 1 : 0;
        if (i == text.Length) { return false; }
        // Accumulate negatively so Int64.MinValue also fits without overflow.
        long limit = negative ? -9223372036854775807L - 1 : -9223372036854775807L;
        long result = 0;
        while (i < text.Length) {
            int digit = text[i] - 48;
            if (digit < 0 || digit > 9 || result < limit / 10) { return false; }
            result = result * 10;
            if (result < limit + digit) { return false; }
            result = result - digit;
            i = i + 1;
        }
        value = negative ? result : -result;
        return true;
    }

    async int sendArgs(List<string> args) {
        StringBuilder sb = new StringBuilder();
        sb.Append("*");
        sb.Append(Convert.ToString(args.Count));
        sb.Append("\r\n");
        for (int i = 0; i < args.Count; i = i + 1) {
            string a = args[i];
            sb.Append("$");
            sb.Append(Convert.ToString((int)strlen(a)));
            sb.Append("\r\n");
            sb.Append(a);
            sb.Append("\r\n");
        }
        string payload = sb.ToString();
        int expected = (int)strlen(payload);
        int sent;
        if (this.tls != null) {
            sent = await this.tls.SendAsync(payload, expected);
        } else {
            sent = await Socket.SendAsync(this.sock, payload, expected);
        }
        if (sent != expected) { this.Close(); }
        return sent;
    }

    // 发送命令（参数向量）并等待其回复。自动支持池化透明路由。
    public async RedisReply CommandAsync(List<string> args) {
        long start = Environment.TickCount64;
        Exception errEx = null;
        RedisReply r = null;
        try {
            if (this.pool != null) {
                RedisClient c = await this.pool.AcquireAsync();
                if (c == null) {
                    RedisReply err = new RedisReply();
                    err.kind = RedisReply.ERROR;
                    err.str = "failed to acquire redis client from pool";
                    r = err;
                    return err;
                }
                int savedPayload = c.maxReplyPayloadBytes;
                int savedNodes = c.maxReplyNodes;
                c.SetReplyLimits(this.maxReplyPayloadBytes, this.maxReplyNodes);
                try {
                    r = await c.CommandAsync(args);
                    if (r.IsError()) { this.lastError = r.str; }
                    return r;
                } finally {
                    c.SetReplyLimits(savedPayload, savedNodes);
                    this.pool.Release(c);
                }
            }
            await this.AcquireLock();
            try {
                r = await this.CommandInternalAsync(args);
                return r;
            } finally {
                this.ReleaseLock();
            }
        } catch (Exception ex) {
            errEx = ex;
            throw ex;
        } finally {
            if (this.Notice != null || (this.pool != null && this.pool.Notice != null)) {
                long el = Environment.TickCount64 - start;
                string log = this.formatCmdLog(args);
                this.FireNotice(log, el, errEx);
            }
        }
    }

    async RedisReply CommandInternalAsync(List<string> args) {
        if (!this.connected && this.protocolError.Length > 0) { return this.protocolFailure(); }
        if (!this.connected) {
            RedisReply closed = new RedisReply();
            closed.kind = RedisReply.ERROR;
            closed.str = "connection closed";
            this.lastError = closed.str;
            return closed;
        }
        int sent = await this.sendArgs(args);
        RedisReply r = new RedisReply();
        if (!this.connected || sent <= 0) {
            r.kind = RedisReply.ERROR;
            r.str = "connection closed";
            this.lastError = r.str;
            return r;
        }
        r = await this.readReply();
        if (r.IsError()) {
            this.lastError = r.str;
        }
        return r;
    }

    // 发送带二进制参数的命令（如 SET key <byte[]>）并等待回复。
    public async RedisReply CommandBytesAsync(List<string> prefixArgs, byte[] binaryArg) {
        long start = Environment.TickCount64;
        Exception errEx = null;
        RedisReply r = null;
        try {
            if (this.pool != null) {
                RedisClient c = await this.pool.AcquireAsync();
                if (c == null) {
                    RedisReply err = new RedisReply();
                    err.kind = RedisReply.ERROR;
                    err.str = "failed to acquire redis client from pool";
                    r = err;
                    return err;
                }
                int savedPayload = c.maxReplyPayloadBytes;
                int savedNodes = c.maxReplyNodes;
                c.SetReplyLimits(this.maxReplyPayloadBytes, this.maxReplyNodes);
                try {
                    r = await c.CommandBytesAsync(prefixArgs, binaryArg);
                    if (r.IsError()) { this.lastError = r.str; }
                    return r;
                } finally {
                    c.SetReplyLimits(savedPayload, savedNodes);
                    this.pool.Release(c);
                }
            }
            await this.AcquireLock();
            try {
                r = await this.CommandBytesInternalAsync(prefixArgs, binaryArg);
                return r;
            } finally {
                this.ReleaseLock();
            }
        } catch (Exception ex) {
            errEx = ex;
            throw ex;
        } finally {
            if (this.Notice != null || (this.pool != null && this.pool.Notice != null)) {
                long el = Environment.TickCount64 - start;
                string log = this.formatCmdLog(prefixArgs) + " <bytes:" + Convert.ToString(binaryArg != null ? binaryArg.Length : 0) + ">";
                this.FireNotice(log, el, errEx);
            }
        }
    }

    async RedisReply CommandBytesInternalAsync(List<string> prefixArgs, byte[] binaryArg) {
        if (!this.connected && this.protocolError.Length > 0) { return this.protocolFailure(); }
        RedisReply r = new RedisReply();
        if (!this.connected) {
            r.kind = RedisReply.ERROR;
            r.str = "connection closed";
            this.lastError = r.str;
            return r;
        }
        int totalArgs = prefixArgs.Count + 1;
        StringBuilder sb = new StringBuilder();
        sb.Append("*");
        sb.Append(Convert.ToString(totalArgs));
        sb.Append("\r\n");
        for (int i = 0; i < prefixArgs.Count; i = i + 1) {
            string a = prefixArgs[i];
            sb.Append("$");
            sb.Append(Convert.ToString((int)strlen(a)));
            sb.Append("\r\n");
            sb.Append(a);
            sb.Append("\r\n");
        }
        sb.Append("$");
        int blen = binaryArg != null ? binaryArg.Length : 0;
        sb.Append(Convert.ToString(blen));
        sb.Append("\r\n");
        string head = sb.ToString();
        int hlen = (int)strlen(head);
        int sentHead = 0;
        if (this.tls != null) {
            sentHead = await this.tls.SendAsync(head, hlen);
        } else {
            sentHead = await Socket.SendAsync(this.sock, head, hlen);
        }
        if (sentHead != hlen) {
            this.Close();
            r.kind = RedisReply.ERROR;
            r.str = "connection closed";
            return r;
        }
        if (blen > 0) {
            int sentBin = 0;
            if (this.tls != null) {
                sentBin = await this.tls.SendBytesAsync(binaryArg, 0, blen);
            } else {
                sentBin = await Socket.SendBytesAsync(this.sock, binaryArg, 0, blen);
            }
            if (sentBin != blen) {
                this.Close();
                r.kind = RedisReply.ERROR;
                r.str = "connection closed";
                return r;
            }
        }
        int sentTail = 0;
        if (this.tls != null) {
            sentTail = await this.tls.SendAsync("\r\n", 2);
        } else {
            sentTail = await Socket.SendAsync(this.sock, "\r\n", 2);
        }
        if (sentTail != 2) {
            this.Close();
            r.kind = RedisReply.ERROR;
            r.str = "connection closed";
            return r;
        }
        r = await this.readReply();
        if (r.IsError()) {
            this.lastError = r.str;
        }
        return r;
    }

    // 便捷方法：单参数命令。
    public async RedisReply CommandAsync1(string a0) {
        List<string> args = new List<string>();
        args.Add(a0);
        return await this.CommandAsync(args);
    }

    // 便捷方法：双参数命令。
    public async RedisReply CommandAsync2(string a0, string a1) {
        List<string> args = new List<string>{ a0, a1 };
        return await this.CommandAsync(args);
    }

    // 便捷方法：三参数命令。
    public async RedisReply CommandAsync3(string a0, string a1, string a2) {
        List<string> args = new List<string>{ a0, a1, a2 };
        return await this.CommandAsync(args);
    }

}
