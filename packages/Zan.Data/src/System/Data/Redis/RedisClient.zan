using System;
using System.Collections.Generic;
using System.Net.Sockets;
using System.Net.Tls;
using System.Data.Redis;
using System.Threading;

namespace System.Data.Redis;

/// <summary>
/// 基于异步 IO reactor、使用 RESP（RESP2）协议的高性能协程化 Redis 客户端。
/// 全面对标 FreeRedis 规范设计，支持池化多协程安全复用与丰富强类型命令，告别手拼命令。
/// 用法（免借还连接池模式，如同 FreeRedis）：
/// RedisClient r = new RedisClient("127.0.0.1:6379,poolsize=10");
/// await r.SetAsync("name", "Alice");
/// string v = await r.GetAsync("name");
/// await r.HSetAsync("user:1", "age", "18");
/// Dictionary<string, string> map = await r.HGetAllAsync("user:1");
/// 用法（单一底层连接模式）：
/// RedisClient r = await RedisClient.ConnectAsync("127.0.0.1", 6379);
/// await r.SetAsync("name", "Alice");
/// r.Close();
/// </summary>
class RedisClient {
    nint sock;
    string host;
    int port;
    bool connected;
    string lastError;
    bool busy;
    List<AsyncGate> waiters;

    byte[] inbuf;
    int incap;
    int inhead;
    int intail;
    byte[] tmp;
    int tmpcap;
    TlsStream tls;

    // 当作为池化客户端使用时，委托至该连接池执行
    RedisPool pool;

    /// <summary>对象序列化委托（例如 obj => Json.Serialize(obj)）。</summary>
    public RedisSerializer Serialize;

    /// <summary>对象反序列化委托（例如 (json, type) => Json.Deserialize(json, type)）。</summary>
    public RedisDeserializer Deserialize;

    /// <summary>命令执行日志与审计通知事件（FreeRedis Notice 规范）。</summary>
    public NoticeEventHandler Notice;

    static bool verifyTls = true;

    /// <summary>切换后续 ConnectSecureAsync 的证书与主机名校验。</summary>
    static void SetTlsVerify(bool verify) {
        RedisClient.verifyTls = verify;
    }

    [DllImport("crt")]
    static extern long strlen(string str);

    /// <summary>通过连接字符串创建池化 Redis 客户端（FreeRedis 规范）。</summary>
    public RedisClient(string connectionString) {
        RedisOptions opt = RedisOptions.Parse(connectionString);
        this.initPool(opt);
    }

    /// <summary>通过配置项创建池化 Redis 客户端。</summary>
    public RedisClient(RedisOptions options) {
        this.initPool(options);
    }

    /// <summary>直接绑定现有连接池作为客户端。</summary>
    public RedisClient(RedisPool pool) {
        this.initMembers();
        this.pool = pool;
    }

    void initMembers() {
        this.sock = -1;
        this.host = "";
        this.port = 6379;
        this.connected = false;
        this.lastError = "";
        this.inbuf = null;
        this.incap = 0;
        this.inhead = 0;
        this.intail = 0;
        this.tmp = null;
        this.tmpcap = 16384;
        this.tls = null;
        this.busy = false;
        this.waiters = new List<AsyncGate>();
        this.pool = null;
        this.Serialize = null;
        this.Deserialize = null;
        this.Notice = null;
    }

    void FireNotice(string logText, long elapsedMs, Exception ex) {
        if (this.Notice != null) {
            NoticeEventArgs e = new NoticeEventArgs(logText, elapsedMs, ex);
            this.Notice(this, e);
        }
        if (this.pool != null && this.pool.Notice != null) {
            NoticeEventArgs e2 = new NoticeEventArgs(logText, elapsedMs, ex);
            this.pool.Notice(this, e2);
        }
    }

    string formatCmdLog(List<string> args) {
        if (args == null || args.Count == 0) { return ""; }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < args.Count; i = i + 1) {
            if (i > 0) { sb.Append(" "); }
            string a = args[i];
            if (a.Length > 80) {
                sb.Append(a.Substring(0, 77) + "...");
            } else {
                sb.Append(a);
            }
        }
        return sb.ToString();
    }

    /// <summary>使用绑定的序列化器将对象转为字符串。</summary>
    public string SerializeObject(object obj) {
        if (obj == null) { return ""; }
        if (this.Serialize != null) {
            return this.Serialize(obj);
        }
        if (this.pool != null && this.pool.Serialize != null) {
            return this.pool.Serialize(obj);
        }
        return Convert.ToString(obj);
    }

    /// <summary>使用绑定的反序列化器将字符串解析为指定类型。</summary>
    public T DeserializeObject<T>(string val) {
        if (val == null) {
            return (T)(object)null;
        }
        if (this.Deserialize != null) {
            object obj = this.Deserialize(val, typeof(T));
            return (T)obj;
        }
        if (this.pool != null && this.pool.Deserialize != null) {
            object obj2 = this.pool.Deserialize(val, typeof(T));
            return (T)obj2;
        }
        return (T)(object)val;
    }

    void initPool(RedisOptions opt) {
        this.initMembers();
        this.host = opt.host;
        this.port = opt.port;
        this.pool = new RedisPool(opt);
    }

    /// 私有构造；单一物理连接统一经 ConnectAsync 创建。
    RedisClient() {
        this.initMembers();
    }

    /// <summary>连接 Redis 服务器（默认超时）。</summary>
    static async RedisClient ConnectAsync(string host, int port) {
        return await RedisClient.ConnectAsync(host, port, 0);
    }

    /// <summary>带连接超时（毫秒，0 = 不限时）的连接；失败返回 null。</summary>
    static async RedisClient ConnectAsync(string host, int port, int timeoutMs) {
        return await RedisClient.doConnect(host, port, timeoutMs, false);
    }

    /// <summary>通过连接字符串异步建立单物理连接。</summary>
    static async RedisClient ConnectAsync(string connectionString) {
        RedisOptions opt = RedisOptions.Parse(connectionString);
        return await RedisClient.ConnectAsync(opt);
    }

    /// <summary>通过配置项异步建立单物理连接（包含自动 AUTH 与 SELECT）。</summary>
    static async RedisClient ConnectAsync(RedisOptions opt) {
        RedisClient c = await RedisClient.doConnect(opt.host, opt.port, opt.connectTimeoutMs, opt.ssl);
        if (c == null) { return null; }
        if (opt.password != null && opt.password.Length > 0) {
            bool authOk = false;
            if (opt.user != null && opt.user.Length > 0) {
                authOk = await c.AuthAsync(opt.user, opt.password);
            } else {
                authOk = await c.AuthAsync(opt.password);
            }
            if (!authOk) {
                c.Close();
                return null;
            }
        }
        if (opt.database > 0) {
            bool selOk = await c.SelectAsync(opt.database);
            if (!selOk) {
                c.Close();
                return null;
            }
        }
        return c;
    }

    /// <summary>TLS 加密信道连接。</summary>
    static async RedisClient ConnectSecureAsync(string host, int port, int timeoutMs) {
        return await RedisClient.doConnect(host, port, timeoutMs, true);
    }

    static async RedisClient doConnect(string host, int port, int timeoutMs, bool secure) {
        Socket.Initialize();
        RedisClient c = new RedisClient();
        c.host = host;
        c.port = port;
        c.sock = Socket.CreateTcp();
        Socket.SetNonBlocking(c.sock);
        int err = await Socket.ConnectAsync(c.sock, host, port, timeoutMs);
        if (err != 0) {
            Socket.Close(c.sock);
            c.sock = -1;
            return null;
        }
        if (secure) {
            TlsContext tlsCtx = TlsContext.CreateClient();
            if (tlsCtx == null) {
                Socket.Close(c.sock);
                c.sock = -1;
                return null;
            }
            if (!RedisClient.verifyTls) { tlsCtx.DisableVerify(); }
            int hsTimeout = timeoutMs > 0 ? timeoutMs : 15000;
            c.tls = await TlsStream.ConnectAsync(tlsCtx, c.sock, host, hsTimeout);
            if (c.tls == null) {
                Socket.Close(c.sock);
                c.sock = -1;
                return null;
            }
        }
        c.connected = true;
        c.incap = 16384;
        c.inbuf = new byte[c.incap + 1];
        c.inhead = 0;
        c.intail = 0;
        c.tmp = new byte[c.tmpcap + 1];
        return c;
    }

    async bool AcquireLock() {
        while (this.busy) {
            AsyncGate g = new AsyncGate();
            this.waiters.Add(g);
            await g.Wait();
            g.Close();
        }
        this.busy = true;
        return true;
    }

    void ReleaseLock() {
        this.busy = false;
        if (this.waiters != null && this.waiters.Count > 0) {
            AsyncGate g = this.waiters[0];
            this.waiters.RemoveAt(0);
            g.Signal();
        }
    }

    /// <summary>关闭连接并释放缓冲区；若是池化客户端则关闭连接池。</summary>
    void Close() {
        if (this.pool != null) {
            this.pool.Close();
            this.pool = null;
        }
        this.ReleaseLock();
        while (this.waiters != null && this.waiters.Count > 0) {
            AsyncGate g = this.waiters[0];
            this.waiters.RemoveAt(0);
            g.Signal();
        }
        if (this.tls != null) {
            this.tls.Close();
            this.tls = null;
        }
        if (this.connected || this.sock >= 0) {
            Socket.Close(this.sock);
            this.connected = false;
            this.sock = -1;
        }
        this.inbuf = null;
        this.tmp = null;
    }

    string sliceBytes(int start, int len) {
        return this.inbuf.ToStr(start, len);
    }

    void ensureRoom(int extra) {
        if (this.intail + extra <= this.incap) {
            return;
        }
        if (this.inhead > 0) {
            int span = this.intail - this.inhead;
            if (span > 0) {
                NativeMemory.Copy((nint)this.inbuf, (nint)this.inbuf + (nint)this.inhead, span);
            }
            this.inhead = 0;
            this.intail = span;
        }
        if (this.intail + extra <= this.incap) {
            return;
        }
        int ncap = this.incap > 0 ? this.incap * 2 : 16384;
        while (this.intail + extra > ncap) {
            if (ncap > 1073741824 / 2) {
                ncap = 1073741824;
                break;
            }
            ncap = ncap * 2;
        }
        byte[] nb = new byte[ncap + 1];
        if (this.intail > 0) {
            NativeMemory.Copy((nint)nb, (nint)this.inbuf, this.intail);
        }
        this.inbuf = nb;
        this.incap = ncap;
    }

    async int fillMore() {
        if (this.tls != null) {
            int n = await this.tls.RecvBytesAsync(this.tmp, 0, this.tmpcap);
            if (n <= 0) {
                this.Close();
                return 0;
            }
            this.ensureRoom(n);
            NativeMemory.Copy((nint)this.inbuf + (nint)this.intail, (nint)this.tmp, n);
            this.intail = this.intail + n;
            return n;
        }
        int n = await Socket.RecvIntoAsync(this.sock, this.tmp, this.tmpcap);
        if (n <= 0) {
            this.Close();
            return 0;
        }
        this.ensureRoom(n);
        NativeMemory.Copy((nint)this.inbuf + (nint)this.intail, (nint)this.tmp, n);
        this.intail = this.intail + n;
        return n;
    }

    async bool ensureAvailable(int need) {
        while ((this.intail - this.inhead) < need) {
            int got = await this.fillMore();
            if (got == 0) {
                return false;
            }
        }
        return true;
    }

    async string readLine() {
        int scan = this.inhead;
        while (true) {
            while (scan + 1 < this.intail) {
                int pos = MemoryExtensions.IndexOf(this.inbuf, (byte)13, scan, this.intail - scan);
                if (pos < 0 || pos >= this.intail - 1) {
                    scan = (pos == this.intail - 1) ? pos : this.intail;
                    break;
                }
                if (this.inbuf[pos + 1] == 10) {
                    int lineLen = pos - this.inhead;
                    string line = this.sliceBytes(this.inhead, lineLen);
                    this.inhead = pos + 2;
                    return line;
                }
                scan = pos + 1;
            }
            int got = await this.fillMore();
            if (got == 0) {
                return null;
            }
        }
        return null;
    }

    async string readBulk(int n) {
        bool ok = await this.ensureAvailable(n + 2);
        if (!ok) {
            return null;
        }
        string data = this.sliceBytes(this.inhead, n);
        this.inhead = this.inhead + n + 2;
        return data;
    }

    async RedisReply readReply() {
        string line = await this.readLine();
        RedisReply r = new RedisReply();
        if (line == null) {
            r.kind = RedisReply.ERROR;
            r.str = "connection closed";
            return r;
        }
        int prefix = line[0];
        string rest = line.Substring(1);
        if (prefix == 43) {  // '+'
            r.kind = RedisReply.STR;
            r.str = rest;
            r.len = (int)strlen(rest);
            return r;
        }
        if (prefix == 45) {  // '-'
            r.kind = RedisReply.ERROR;
            r.str = rest;
            r.len = (int)strlen(rest);
            return r;
        }
        if (prefix == 58) {  // ':'
            r.kind = RedisReply.INT;
            r.integer64 = Convert.ToInt64(rest);
            r.integer = (int)r.integer64;
            return r;
        }
        if (prefix == 36) {  // '$'
            int blen = Convert.ToInt(rest);
            if (blen < 0) {
                r.kind = RedisReply.NIL;
                return r;
            }
            if (blen > 536870912) {
                r.kind = RedisReply.ERROR;
                r.str = "bulk string length exceeds 512MB protocol limit";
                this.Close();
                return r;
            }
            string data = await this.readBulk(blen);
            if (data == null) {
                r.kind = RedisReply.ERROR;
                r.str = "connection closed";
                return r;
            }
            r.kind = RedisReply.BULK;
            r.str = data;
            r.len = blen;
            return r;
        }
        if (prefix == 42) {  // '*'
            int count = Convert.ToInt(rest);
            if (count < 0) {
                r.kind = RedisReply.NIL;
                return r;
            }
            if (count > 1048576) {
                r.kind = RedisReply.ERROR;
                r.str = "array element count exceeds 1M limit";
                this.Close();
                return r;
            }
            r.kind = RedisReply.ARRAY;
            r.items = new List<RedisReply>();
            for (int i = 0; i < count; i = i + 1) {
                RedisReply child = await this.readReply();
                r.items.Add(child);
            }
            return r;
        }
        r.kind = RedisReply.ERROR;
        r.str = "protocol error: " + line;
        this.Close();
        return r;
    }

    async int sendArgs(List<string> args) {
        StringBuilder sb = new StringBuilder();
        sb.Append("*");
        sb.Append(Convert.ToString(args.Count));
        sb.Append("\r\n");
        for (int i = 0; i < args.Count; i = i + 1) {
            string a = args[i];
            sb.Append("$");
            sb.Append(Convert.ToString((int)strlen(a)));
            sb.Append("\r\n");
            sb.Append(a);
            sb.Append("\r\n");
        }
        string payload = sb.ToString();
        int expected = (int)strlen(payload);
        int sent;
        if (this.tls != null) {
            sent = await this.tls.SendAsync(payload, expected);
        } else {
            sent = await Socket.SendAsync(this.sock, payload, expected);
        }
        if (sent != expected) { this.Close(); }
        return sent;
    }

    /// <summary>发送命令（参数向量）并等待其回复。自动支持池化透明路由。</summary>
    async RedisReply CommandAsync(List<string> args) {
        long start = Environment.TickCount64;
        Exception errEx = null;
        RedisReply r = null;
        try {
            if (this.pool != null) {
                RedisClient c = await this.pool.AcquireAsync();
                if (c == null) {
                    RedisReply err = new RedisReply();
                    err.kind = RedisReply.ERROR;
                    err.str = "failed to acquire redis client from pool";
                    r = err;
                    return err;
                }
                try {
                    r = await c.CommandAsync(args);
                    return r;
                } finally {
                    this.pool.Release(c);
                }
            }
            await this.AcquireLock();
            try {
                r = await this.CommandInternalAsync(args);
                return r;
            } finally {
                this.ReleaseLock();
            }
        } catch (Exception ex) {
            errEx = ex;
            throw ex;
        } finally {
            if (this.Notice != null || (this.pool != null && this.pool.Notice != null)) {
                long el = Environment.TickCount64 - start;
                string log = this.formatCmdLog(args);
                this.FireNotice(log, el, errEx);
            }
        }
    }

    async RedisReply CommandInternalAsync(List<string> args) {
        int sent = await this.sendArgs(args);
        RedisReply r = new RedisReply();
        if (!this.connected || sent <= 0) {
            r.kind = RedisReply.ERROR;
            r.str = "connection closed";
            this.lastError = r.str;
            return r;
        }
        r = await this.readReply();
        if (r.IsError()) {
            this.lastError = r.str;
        }
        return r;
    }

    /// <summary>发送带二进制参数的命令（如 SET key <byte[]>）并等待回复。</summary>
    async RedisReply CommandBytesAsync(List<string> prefixArgs, byte[] binaryArg) {
        long start = Environment.TickCount64;
        Exception errEx = null;
        RedisReply r = null;
        try {
            if (this.pool != null) {
                RedisClient c = await this.pool.AcquireAsync();
                if (c == null) {
                    RedisReply err = new RedisReply();
                    err.kind = RedisReply.ERROR;
                    err.str = "failed to acquire redis client from pool";
                    r = err;
                    return err;
                }
                try {
                    r = await c.CommandBytesAsync(prefixArgs, binaryArg);
                    return r;
                } finally {
                    this.pool.Release(c);
                }
            }
            await this.AcquireLock();
            try {
                r = await this.CommandBytesInternalAsync(prefixArgs, binaryArg);
                return r;
            } finally {
                this.ReleaseLock();
            }
        } catch (Exception ex) {
            errEx = ex;
            throw ex;
        } finally {
            if (this.Notice != null || (this.pool != null && this.pool.Notice != null)) {
                long el = Environment.TickCount64 - start;
                string log = this.formatCmdLog(prefixArgs) + " <bytes:" + Convert.ToString(binaryArg != null ? binaryArg.Length : 0) + ">";
                this.FireNotice(log, el, errEx);
            }
        }
    }

    async RedisReply CommandBytesInternalAsync(List<string> prefixArgs, byte[] binaryArg) {
        RedisReply r = new RedisReply();
        if (!this.connected) {
            r.kind = RedisReply.ERROR;
            r.str = "connection closed";
            this.lastError = r.str;
            return r;
        }
        int totalArgs = prefixArgs.Count + 1;
        StringBuilder sb = new StringBuilder();
        sb.Append("*");
        sb.Append(Convert.ToString(totalArgs));
        sb.Append("\r\n");
        for (int i = 0; i < prefixArgs.Count; i = i + 1) {
            string a = prefixArgs[i];
            sb.Append("$");
            sb.Append(Convert.ToString((int)strlen(a)));
            sb.Append("\r\n");
            sb.Append(a);
            sb.Append("\r\n");
        }
        sb.Append("$");
        int blen = binaryArg != null ? binaryArg.Length : 0;
        sb.Append(Convert.ToString(blen));
        sb.Append("\r\n");
        string head = sb.ToString();
        int hlen = (int)strlen(head);
        int sentHead = 0;
        if (this.tls != null) {
            sentHead = await this.tls.SendAsync(head, hlen);
        } else {
            sentHead = await Socket.SendAsync(this.sock, head, hlen);
        }
        if (sentHead != hlen) {
            this.Close();
            r.kind = RedisReply.ERROR;
            r.str = "connection closed";
            return r;
        }
        if (blen > 0) {
            int sentBin = 0;
            if (this.tls != null) {
                sentBin = await this.tls.SendBytesAsync(binaryArg, 0, blen);
            } else {
                sentBin = await Socket.SendBytesAsync(this.sock, binaryArg, 0, blen);
            }
            if (sentBin != blen) {
                this.Close();
                r.kind = RedisReply.ERROR;
                r.str = "connection closed";
                return r;
            }
        }
        int sentTail = 0;
        if (this.tls != null) {
            sentTail = await this.tls.SendAsync("\r\n", 2);
        } else {
            sentTail = await Socket.SendAsync(this.sock, "\r\n", 2);
        }
        if (sentTail != 2) {
            this.Close();
            r.kind = RedisReply.ERROR;
            r.str = "connection closed";
            return r;
        }
        r = await this.readReply();
        if (r.IsError()) {
            this.lastError = r.str;
        }
        return r;
    }

    /// <summary>便捷方法：单参数命令。</summary>
    async RedisReply CommandAsync1(string a0) {
        List<string> args = new List<string>();
        args.Add(a0);
        return await this.CommandAsync(args);
    }

    /// <summary>便捷方法：双参数命令。</summary>
    async RedisReply CommandAsync2(string a0, string a1) {
        List<string> args = new List<string>{ a0, a1 };
        return await this.CommandAsync(args);
    }

    /// <summary>便捷方法：三参数命令。</summary>
    async RedisReply CommandAsync3(string a0, string a1, string a2) {
        List<string> args = new List<string>{ a0, a1, a2 };
        return await this.CommandAsync(args);
    }

    // 连接与认证 (Connection & Auth)

    /// <summary>PING；回复 PONG 返回 true。</summary>
    async bool PingAsync() {
        RedisReply r = await this.CommandAsync1("PING");
        return r.AsString() == "PONG";
    }

    /// <summary>AUTH 单密码认证。</summary>
    async bool AuthAsync(string password) {
        RedisReply r = await this.CommandAsync2("AUTH", password);
        return r.AsString() == "OK";
    }

    /// <summary>AUTH 用户名与密码认证（Redis 6+ ACL）。</summary>
    async bool AuthAsync(string username, string password) {
        RedisReply r = await this.CommandAsync3("AUTH", username, password);
        return r.AsString() == "OK";
    }

    /// <summary>SELECT 切换逻辑数据库。</summary>
    async bool SelectAsync(int index) {
        RedisReply r = await this.CommandAsync2("SELECT", Convert.ToString(index));
        return r.AsString() == "OK";
    }

    /// <summary>ECHO 回显测试。</summary>
    async string EchoAsync(string message) {
        RedisReply r = await this.CommandAsync2("ECHO", message);
        return r.AsString();
    }

    // 字符串 (Strings)

    /// <summary>GET key。键不存在或出错返回空串。区分 nil 请用 GetReplyAsync。</summary>
    async string GetAsync(string key) {
        RedisReply r = await this.CommandAsync2("GET", key);
        if (r.IsNil()) { return ""; }
        return r.AsString();
    }

    /// <summary>GET key 并自动反序列化为对象类型 T。键不存在或反序列化失败返回 null/default。</summary>
    async T GetObjectAsync<T>(string key) {
        string raw = await this.GetAsync(key);
        if (raw == null || raw == "") {
            return (T)(object)null;
        }
        return this.DeserializeObject<T>(raw);
    }

