    // 位图 (Bitmaps)

    /// <summary>SETBIT 设置指定偏移量的位值（0 或 1）。返回旧的位值。</summary>
    async int SetBitAsync(string key, long offset, int value) {
        List<string> args = new List<string>{ "SETBIT", key, Convert.ToString(offset), Convert.ToString(value) };
        RedisReply r = await this.CommandAsync(args);
        return r.AsInt();
    }

    /// <summary>GETBIT 获取指定偏移量的位值。</summary>
    async int GetBitAsync(string key, long offset) {
        List<string> args = new List<string>{ "GETBIT", key, Convert.ToString(offset) };
        RedisReply r = await this.CommandAsync(args);
        return r.AsInt();
    }

    /// <summary>BITCOUNT 统计字符串中被设置为 1 的位数量。</summary>
    async long BitCountAsync(string key) {
        RedisReply r = await this.CommandAsync2("BITCOUNT", key);
        return r.AsLong();
    }

    /// <summary>BITCOUNT 统计指定字节区间中为 1 的位数量。</summary>
    async long BitCountAsync(string key, long start, long end) {
        List<string> args = new List<string>{ "BITCOUNT", key, Convert.ToString(start), Convert.ToString(end) };
        RedisReply r = await this.CommandAsync(args);
        return r.AsLong();
    }

    /// <summary>BITOP AND 位与运算并保存到目标键。</summary>
    async long BitOpAndAsync(string destKey, List<string> keys) {
        return await this.bitOp("AND", destKey, keys);
    }

    /// <summary>BITOP OR 位或运算并保存到目标键。</summary>
    async long BitOpOrAsync(string destKey, List<string> keys) {
        return await this.bitOp("OR", destKey, keys);
    }

    /// <summary>BITOP XOR 位异或运算并保存到目标键。</summary>
    async long BitOpXorAsync(string destKey, List<string> keys) {
        return await this.bitOp("XOR", destKey, keys);
    }

    /// <summary>BITOP NOT 位非运算并保存到目标键。</summary>
    async long BitOpNotAsync(string destKey, string srcKey) {
        List<string> args = new List<string>{ "BITOP", "NOT", destKey, srcKey };
        RedisReply r = await this.CommandAsync(args);
        return r.AsLong();
    }

    async long bitOp(string op, string destKey, List<string> keys) {
        List<string> args = new List<string>{ "BITOP", op, destKey };
        if (keys != null) {
            for (int i = 0; i < keys.Count; i = i + 1) { args.Add(keys[i]); }
        }
        RedisReply r = await this.CommandAsync(args);
        return r.AsLong();
    }

    /// <summary>BITPOS 查找第一个设置为指定 bit (0 或 1) 的位置。</summary>
    async long BitPosAsync(string key, int bit) {
        List<string> args = new List<string>{ "BITPOS", key, Convert.ToString(bit) };
        RedisReply r = await this.CommandAsync(args);
        return r.AsLong();
    }

    // HyperLogLog (基数统计)

    /// <summary>PFADD 添加单个元素。</summary>
    async bool PfAddAsync(string key, string element) {
        RedisReply r = await this.CommandAsync3("PFADD", key, element);
        return r.AsInt() == 1;
    }

    /// <summary>PFADD 批量添加多个元素。</summary>
    async bool PfAddMultipleAsync(string key, List<string> elements) {
        if (elements == null || elements.Count == 0) { return false; }
        List<string> args = new List<string>{ "PFADD", key };
        for (int i = 0; i < elements.Count; i = i + 1) {
            args.Add(elements[i]);
        }
        RedisReply r = await this.CommandAsync(args);
        return r.AsInt() == 1;
    }

    /// <summary>PFCOUNT 返回近似基数。</summary>
    async long PfCountAsync(string key) {
        RedisReply r = await this.CommandAsync2("PFCOUNT", key);
        return r.AsLong();
    }

    /// <summary>PFCOUNT 批量合并计算多个键的近似基数。</summary>
    async long PfCountMultipleAsync(List<string> keys) {
        if (keys == null || keys.Count == 0) { return 0; }
        List<string> args = new List<string>{ "PFCOUNT" };
        for (int i = 0; i < keys.Count; i = i + 1) { args.Add(keys[i]); }
        RedisReply r = await this.CommandAsync(args);
        return r.AsLong();
    }

    /// <summary>PFMERGE 合并多个源 HyperLogLog 到目标键。</summary>
    async bool PfMergeAsync(string destKey, List<string> sourceKeys) {
        if (sourceKeys == null || sourceKeys.Count == 0) { return false; }
        List<string> args = new List<string>{ "PFMERGE", destKey };
        for (int i = 0; i < sourceKeys.Count; i = i + 1) { args.Add(sourceKeys[i]); }
        RedisReply r = await this.CommandAsync(args);
        return r.AsString() == "OK";
    }

    // 发布与订阅 (Pub / Sub)

    /// <summary>PUBLISH 向指定频道发布消息，返回接收到消息的订阅者数量。</summary>
    async long PublishAsync(string channel, string message) {
        List<string> args = new List<string>{ "PUBLISH", channel, message };
        RedisReply r = await this.CommandAsync(args);
        return r.AsLong();
    }

    // 服务端与系统管理 (Server & System)

    /// <summary>DBSIZE 返回当前数据库中的键数量。</summary>
    async long DbSizeAsync() {
        RedisReply r = await this.CommandAsync1("DBSIZE");
        return r.AsLong();
    }

    /// <summary>FLUSHDB 清空当前逻辑数据库。</summary>
    async bool FlushDbAsync() {
        RedisReply r = await this.CommandAsync1("FLUSHDB");
        return r.AsString() == "OK";
    }

    /// <summary>FLUSHALL 清空所有逻辑数据库。</summary>
    async bool FlushAllAsync() {
        RedisReply r = await this.CommandAsync1("FLUSHALL");
        return r.AsString() == "OK";
    }

    /// <summary>TIME 获取服务器时间（[0]为秒，[1]为微秒）。</summary>
    async List<string> TimeAsync() {
        RedisReply r = await this.CommandAsync1("TIME");
        return r.AsListString();
    }

    /// <summary>INFO 获取服务器信息与统计数据。</summary>
    async string InfoAsync() {
        RedisReply r = await this.CommandAsync1("INFO");
        return r.AsString();
    }

    /// <summary>INFO 获取指定节的服务器信息。</summary>
    async string InfoAsync(string section) {
        RedisReply r = await this.CommandAsync2("INFO", section);
        return r.AsString();
    }

    /// <summary>BGSAVE 异步将数据库保存到磁盘。</summary>
    async string BgSaveAsync() {
        RedisReply r = await this.CommandAsync1("BGSAVE");
        return r.AsString();
    }

    /// <summary>LASTSAVE 返回最近一次成功将数据保存到磁盘的 UNIX 时间戳。</summary>
    async long LastSaveAsync() {
        RedisReply r = await this.CommandAsync1("LASTSAVE");
        return r.AsLong();
    }

    // 状态与辅助

    /// <summary>返回最近记录到的服务器错误消息（如有）。</summary>
    string GetLastError() {
        return this.lastError;
    }

    /// <summary>已连接则返回 true。</summary>
    bool IsConnected() {
        if (this.pool != null) {
            return !this.pool.IsClosed();
        }
        return this.connected;
    }
}
