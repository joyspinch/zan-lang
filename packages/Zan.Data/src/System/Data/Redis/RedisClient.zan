    /// <summary>HSTRLEN 获取指定字段值的字符串长度。</summary>
    async long HStrLenAsync(string key, string field) {
        RedisReply r = await this.CommandAsync3("HSTRLEN", key, field);
        return r.AsLong();
    }

    /// <summary>HSCAN 增量迭代哈希字段。</summary>
    async RedisScanResult HScanAsync(string key, long cursor, string pattern, int count) {
        List<string> args = new List<string>{ "HSCAN", key, Convert.ToString(cursor) };
        if (pattern != null && pattern.Length > 0) {
            args.Add("MATCH");
            args.Add(pattern);
        }
        if (count > 0) {
            args.Add("COUNT");
            args.Add(Convert.ToString(count));
        }
        RedisReply r = await this.CommandAsync(args);
        if (r.kind == RedisReply.ARRAY && r.Count() >= 2) {
            long nextCur = Convert.ToInt64(r.At(0).AsString());
            List<string> items = r.At(1).AsListString();
            return new RedisScanResult(nextCur, items);
        }
        return new RedisScanResult(0, new List<string>());
    }

