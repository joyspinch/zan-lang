    /// <summary>MGET 批量获取（变长参数平铺）。</summary>
    async List<string> MGetAsync(params string[] keys) {
        List<string> list = new List<string>();
        if (keys == null) { return list; }
        for (int i = 0; i < keys.Length; i = i + 1) {
            list.Add(keys[i]);
        }
        return await this.MGetAsync(list);
    }

    /// <summary>MGET 批量获取。</summary>
    async List<string> MGetAsync(List<string> keys) {
        List<string> res = new List<string>();
        if (keys == null || keys.Count == 0) { return res; }
        List<string> args = new List<string>();
        args.Add("MGET");
        for (int i = 0; i < keys.Count; i = i + 1) {
            args.Add(keys[i]);
        }
        RedisReply r = await this.CommandAsync(args);
        return r.AsListString();
    }

    /// <summary>MSET 批量设置实体列表。</summary>
    async bool MSetAsync(List<RedisEntry> entries) {
        return await this.MSetEntriesAsync(entries);
    }

    /// <summary>MSET 批量设置（变长平铺参数：key1, val1, key2, val2, ...）。</summary>
    async bool MSetAsync(params string[] keyValues) {
        if (keyValues == null || keyValues.Length < 2) { return false; }
        List<RedisEntry> entries = new List<RedisEntry>();
        for (int i = 0; i + 1 < keyValues.Length; i = i + 2) {
            entries.Add(new RedisEntry(keyValues[i], keyValues[i + 1]));
        }
        return await this.MSetEntriesAsync(entries);
    }

    /// <summary>MSET 批量设置字典。</summary>
    async bool MSetAsync(Dictionary<string, string> dict) {
        if (dict == null || dict.Count == 0) { return false; }
        List<RedisEntry> entries = new List<RedisEntry>();
        List<string> keys = dict.Keys;
        for (int i = 0; i < keys.Count; i = i + 1) {
            string k = keys[i];
            entries.Add(new RedisEntry(k, dict[k]));
        }
        return await this.MSetEntriesAsync(entries);
    }

    /// <summary>MSET 兼容平行列表。</summary>
    async bool MSetAsync(List<string> keys, List<string> vals) {
        if (keys == null || vals == null || keys.Count == 0 || keys.Count != vals.Count) {
            return false;
        }
        List<RedisEntry> entries = new List<RedisEntry>();
        for (int i = 0; i < keys.Count; i = i + 1) {
            entries.Add(new RedisEntry(keys[i], vals[i]));
        }
        return await this.MSetEntriesAsync(entries);
    }

    /// <summary>MSET 实体主方法。</summary>
    async bool MSetEntriesAsync(List<RedisEntry> entries) {
        if (entries == null || entries.Count == 0) { return false; }
        List<string> args = new List<string>();
        args.Add("MSET");
        for (int i = 0; i < entries.Count; i = i + 1) {
            RedisEntry e = entries[i];
            if (e != null) {
                args.Add(e.key);
                args.Add(e.value);
            }
        }
        RedisReply r = await this.CommandAsync(args);
        return r.AsString() == "OK";
    }

    /// <summary>MSETNX 仅当所有键都不存在时批量设置。</summary>
    async bool MSetNxAsync(List<RedisEntry> entries) {
        if (entries == null || entries.Count == 0) { return false; }
        List<string> args = new List<string>();
        args.Add("MSETNX");
        for (int i = 0; i < entries.Count; i = i + 1) {
            RedisEntry e = entries[i];
            if (e != null) {
                args.Add(e.key);
                args.Add(e.value);
            }
        }
        RedisReply r = await this.CommandAsync(args);
        return r.AsInt() == 1;
    }

