namespace System.Data.Redis;

// One root reply owns this budget, shared by every recursive array frame.
// Payload bytes and reply nodes are independent bounds: empty values still
// consume nodes, while integer replies consume eight logical payload bytes.
internal class RedisReplyBudget {
    internal const int DefaultPayloadBytes = 67108864;
    internal const int DefaultNodes = 1048576;
    int payloadLeft;
    int nodesLeft;

    internal RedisReplyBudget(int maxPayloadBytes, int maxNodes) {
        this.payloadLeft = maxPayloadBytes;
        this.nodesLeft = maxNodes;
    }

    // Subtraction admits the exact boundary without overflowing on addition.
    // Failed admission leaves the counters unchanged.
    internal bool AdmitPayload(int bytes) {
        if (bytes < 0 || bytes > this.payloadLeft) { return false; }
        this.payloadLeft = this.payloadLeft - bytes;
        return true;
    }

    internal bool AdmitNodes(int count) {
        if (count < 0 || count > this.nodesLeft) { return false; }
        this.nodesLeft = this.nodesLeft - count;
        return true;
    }
}
