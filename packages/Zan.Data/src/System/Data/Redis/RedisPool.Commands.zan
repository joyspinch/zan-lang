using System;
using System.Collections.Generic;

namespace System.Data.Redis;

public partial class RedisPool {
    // 哈希
    public async long HSetAsync(string key, string field, string value) {
        RedisClient c = await this.AcquireAsync();
        if (c == null) { return 0; }
        try { return await c.HSetAsync(key, field, value); } finally { this.Release(c); }
    }

    // HSET 将对象序列化后存入哈希字段。
    public async long HSetAsync<T>(string key, string field, T value) {
        RedisClient c = await this.AcquireAsync();
        if (c == null) { return 0; }
        try { return await c.HSetAsync<T>(key, field, value); } finally { this.Release(c); }
    }

    public async bool HSetNxAsync(string key, string field, string value) {
        RedisClient c = await this.AcquireAsync();
        if (c == null) { return false; }
        try { return await c.HSetNxAsync(key, field, value); } finally { this.Release(c); }
    }

    // HSETNX 仅当字段不存在时设置对象。
    public async bool HSetNxAsync<T>(string key, string field, T value) {
        RedisClient c = await this.AcquireAsync();
        if (c == null) { return false; }
        try { return await c.HSetNxAsync<T>(key, field, value); } finally { this.Release(c); }
    }

    public async string HGetAsync(string key, string field) {
        RedisClient c = await this.AcquireAsync();
        if (c == null) { return ""; }
        try { return await c.HGetAsync(key, field); } finally { this.Release(c); }
    }

    // HGET 获取哈希字段值并反序列化为对象类型 T。键/字段不存在返回 null/default。
    public async T HGetObjectAsync<T>(string key, string field) {
        RedisClient c = await this.AcquireAsync();
        if (c == null) { return (T)(object)null; }
        try { return await c.HGetObjectAsync<T>(key, field); } finally { this.Release(c); }
    }

