using System;
using System.Collections.Generic;

namespace System.Data.Redis;

// Redis 命令审计/日志事件参数（FreeRedis Notice 规范）。
class NoticeEventArgs {
    public string Log;
    public long ElapsedMs;
    public Exception Exception;

    public NoticeEventArgs(string log, long elapsedMs, Exception ex) {
        this.Log = log;
        this.ElapsedMs = elapsedMs;
        this.Exception = ex;
    }
}

// Redis 命令审计委托。
delegate void NoticeEventHandler(object sender, NoticeEventArgs e);

// 对象序列化为 Redis 字符串的委托。
delegate string RedisSerializer(object obj);

// 从 Redis 字符串反序列化为指定类型对象的委托。
delegate object RedisDeserializer(string json, TypeInfo type);

// Redis 键值对实体（用于 MSET / HMSET 等批量操作）。
class RedisEntry {
    public string key;
    public string value;

    public RedisEntry(string key, string value) {
        this.key = key;
        this.value = value;
    }
}

// 有序集合 (Sorted Set / ZSet) 的成员与分数实体。
class ZMember {
    public string member;
    public double score;

    public ZMember(string member, double score) {
        this.member = member;
        this.score = score;
    }
}

// SCAN / HSCAN / SSCAN / ZSCAN 迭代游标与结果集。
class RedisScanResult {
    public long cursor;
    public List<string> items;

    public RedisScanResult(long cursor, List<string> items) {
        this.cursor = cursor;
        this.items = items;
    }
}

