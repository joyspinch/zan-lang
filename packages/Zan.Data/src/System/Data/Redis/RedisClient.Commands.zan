    // DUMP 序列化键的值。
    public async byte[] DumpAsync(string key) {
        RedisReply r = await this.CommandAsync2("DUMP", key);
        return r.AsBytes();
    }

    // SCAN 增量迭代键空间。
    public async RedisScanResult ScanAsync(long cursor, string pattern, int count) {
        List<string> args = new List<string>{ "SCAN", Convert.ToString(cursor) };
        if (pattern != null && pattern.Length > 0) {
            args.Add("MATCH");
            args.Add(pattern);
        }
        if (count > 0) {
            args.Add("COUNT");
            args.Add(Convert.ToString(count));
        }
        RedisReply r = await this.CommandAsync(args);
        if (r.kind == RedisReply.ARRAY && r.Count() >= 2) {
            long nextCur = Convert.ToInt64(r.At(0).AsString());
            List<string> items = r.At(1).AsListString();
            return new RedisScanResult(nextCur, items);
        }
        return new RedisScanResult(0, new List<string>());
    }

    // 哈希 (Hashes)

    // HSET 设置单个字段。
    public async long HSetAsync(string key, string field, string value) {
        List<string> args = new List<string>{ "HSET", key, field, value };
        RedisReply r = await this.CommandAsync(args);
        return r.AsLong();
    }

    // HSET 将对象序列化后存入哈希字段。
    public async long HSetAsync<T>(string key, string field, T value) {
        string s = this.SerializeObject((object)value);
        return await this.HSetAsync(key, field, s);
    }

    // HSETNX 仅当字段不存在时设置。
    public async bool HSetNxAsync(string key, string field, string value) {
        List<string> args = new List<string>{ "HSETNX", key, field, value };
        RedisReply r = await this.CommandAsync(args);
        return r.AsInt() == 1;
    }

    // HSETNX 仅当字段不存在时设置对象。
    public async bool HSetNxAsync<T>(string key, string field, T value) {
        string s = this.SerializeObject((object)value);
        return await this.HSetNxAsync(key, field, s);
    }

    // HGET 获取字段值。
    public async string HGetAsync(string key, string field) {
        RedisReply r = await this.CommandAsync3("HGET", key, field);
        if (r.IsNil()) { return ""; }
        return r.AsString();
    }

    // HGET 获取哈希字段值并反序列化为对象类型 T。键/字段不存在返回 null/default。
    public async T HGetObjectAsync<T>(string key, string field) {
        string raw = await this.HGetAsync(key, field);
        if (raw == null || raw == "") {
            return (T)(object)null;
        }
        return this.DeserializeObject<T>(raw);
    }

    // HGET 获取哈希字段值并反序列化为 T（FreeRedis cli.HGet&lt;T&gt; 规范）。
    public async T HGetAsync<T>(string key, string field) {
        return await this.HGetObjectAsync<T>(key, field);
    }

    // HGET 二进制安全获取。
    public async byte[] HGetBytesAsync(string key, string field) {
        RedisReply r = await this.CommandAsync3("HGET", key, field);
        if (r.IsNil() || r.IsError()) { return null; }
        return r.AsBytes();
    }

    // HMSET 批量设置字典。
    public async bool HMSetAsync(string key, Dictionary<string, string> dict) {
        if (dict == null || dict.Count == 0) { return false; }
        List<string> args = new List<string>{ "HMSET", key };
        List<string> keys = dict.Keys;
        for (int i = 0; i < keys.Count; i = i + 1) {
            string f = keys[i];
            args.Add(f);
            args.Add(dict[f]);
        }
        RedisReply r = await this.CommandAsync(args);
        return r.AsString() == "OK";
    }

    // HMSET 批量设置实体列表。
    public async bool HMSetAsync(string key, List<RedisEntry> entries) {
        if (entries == null || entries.Count == 0) { return false; }
        List<string> args = new List<string>{ "HMSET", key };
        for (int i = 0; i < entries.Count; i = i + 1) {
            RedisEntry e = entries[i];
            if (e != null) {
                args.Add(e.key);
                args.Add(e.value);
            }
        }
        RedisReply r = await this.CommandAsync(args);
        return r.AsString() == "OK";
    }

    // HMSET 字段与值列表批量设置便捷重载。
    public async bool HMSetAsync(string key, List<string> fields, List<string> values) {
        if (fields == null || values == null || fields.Count == 0 || fields.Count != values.Count) {
            return false;
        }
        List<string> args = new List<string>{ "HMSET", key };
        for (int i = 0; i < fields.Count; i = i + 1) {
            args.Add(fields[i]);
            args.Add(values[i]);
        }
        RedisReply r = await this.CommandAsync(args);
        return r.AsString() == "OK";
    }

    // HMGET 批量获取指定字段（变长参数平铺）。
    public async List<string> HMGetAsync(string key, params string[] fields) {
        List<string> list = new List<string>();
        if (fields == null) { return list; }
        for (int i = 0; i < fields.Length; i = i + 1) {
            list.Add(fields[i]);
        }
        return await this.HMGetAsync(key, list);
    }

    // HMGET 批量获取指定字段。
    public async List<string> HMGetAsync(string key, List<string> fields) {
        List<string> res = new List<string>();
        if (fields == null || fields.Count == 0) { return res; }
        List<string> args = new List<string>{ "HMGET", key };
        for (int i = 0; i < fields.Count; i = i + 1) {
            args.Add(fields[i]);
        }
        RedisReply r = await this.CommandAsync(args);
        return r.AsListString();
    }

