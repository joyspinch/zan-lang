    public async long TtlAsync(string key) {
        RedisReply r = await this.CommandAsync2("TTL", key);
        return r.AsLong();
    }

    // PTTL 查询剩余生存时间（毫秒）。
    public async long PTtlAsync(string key) {
        RedisReply r = await this.CommandAsync2("PTTL", key);
