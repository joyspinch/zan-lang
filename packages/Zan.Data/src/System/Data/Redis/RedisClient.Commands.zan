    // GETRANGE 获取子字符串区间。
    public async string GetRangeAsync(string key, long start, long end) {
        List<string> args = new List<string>{ "GETRANGE", key, Convert.ToString(start), Convert.ToString(end) };
        RedisReply r = await this.CommandAsync(args);
        return r.AsString();
    }

    // SETRANGE 覆写指定偏移处的子字符串，返回修改后的长度。
    public async long SetRangeAsync(string key, long offset, string value) {
        List<string> args = new List<string>{ "SETRANGE", key, Convert.ToString(offset), value };
