    }

    // HKEYS 获取哈希表中所有字段名。
    public async List<string> HKeysAsync(string key) {
        RedisReply r = await this.CommandAsync2("HKEYS", key);
        return r.AsListString();
    }

    // HVALS 获取哈希表中所有字段值。
    public async List<string> HValsAsync(string key) {
        RedisReply r = await this.CommandAsync2("HVALS", key);
        return r.AsListString();
    }

    // HGETALL 获取全部键值对为字典。
    public async Dictionary<string, string> HGetAllAsync(string key) {
        RedisReply r = await this.CommandAsync2("HGETALL", key);
        return r.AsDictionary();
    }

    // HSTRLEN 获取指定字段值的字符串长度。
    public async long HStrLenAsync(string key, string field) {
        RedisReply r = await this.CommandAsync3("HSTRLEN", key, field);
        return r.AsLong();
    }

    // HSCAN 增量迭代哈希字段。
    public async RedisScanResult HScanAsync(string key, long cursor, string pattern, int count) {
        List<string> args = new List<string>{ "HSCAN", key, Convert.ToString(cursor) };
        if (pattern != null && pattern.Length > 0) {
            args.Add("MATCH");
            args.Add(pattern);
        }
        if (count > 0) {
            args.Add("COUNT");
            args.Add(Convert.ToString(count));
        }
        RedisReply r = await this.CommandAsync(args);
        if (r.kind == RedisReply.ARRAY && r.Count() >= 2) {
            long nextCur = Convert.ToInt64(r.At(0).AsString());
            List<string> items = r.At(1).AsListString();
            return new RedisScanResult(nextCur, items);
        }
        return new RedisScanResult(0, new List<string>());
    }


}
