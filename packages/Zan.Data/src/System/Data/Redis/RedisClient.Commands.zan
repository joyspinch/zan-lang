using System;
using System.Collections.Generic;

namespace System.Data.Redis;

public partial class RedisClient {
    async RedisReply ExecEntriesAsync(string cmd, List<RedisEntry> entries) {
        List<string> args = new List<string>{ cmd };
        for (int i = 0; i < entries.Count; i = i + 1) {
            RedisEntry e = entries[i];
            if (e != null) {
                args.Add(e.key);
                args.Add(e.value);
            }
        }
        return await this.CommandAsync(args);
    }

    // 连接与认证

    public async bool PingAsync() {
        RedisReply r = await this.CommandAsync1("PING");
        return r.AsString() == "PONG";
    }

    public async bool AuthAsync(string password) {
        RedisReply r = await this.CommandAsync2("AUTH", password);
        return r.AsString() == "OK";
    }

    public async bool AuthAsync(string username, string password) {
        RedisReply r = await this.CommandAsync3("AUTH", username, password);
        return r.AsString() == "OK";
    }

    public async bool SelectAsync(int index) {
        RedisReply r = await this.CommandAsync2("SELECT", Convert.ToString(index));
        return r.AsString() == "OK";
    }

    public async string EchoAsync(string message) {
        RedisReply r = await this.CommandAsync2("ECHO", message);
        return r.AsString();
    }

    // 字符串 (Strings)

    // 键不存在或出错返回空串；需区分 nil 时使用 GetReplyAsync。
    public async string GetAsync(string key) {
        RedisReply r = await this.CommandAsync2("GET", key);
        return r.IsNil() ? "" : r.AsString();
    }

    public async T GetObjectAsync<T>(string key) {
        string raw = await this.GetAsync(key);
        if (raw == null || raw == "") { return (T)(object)null; }
        return this.DeserializeObject<T>(raw);
    }

    public async T GetAsync<T>(string key) { return await this.GetObjectAsync<T>(key); }

    public async byte[] GetBytesAsync(string key) {
        RedisReply r = await this.CommandAsync2("GET", key);
        if (r.IsNil() || r.IsError()) { return null; }
        return r.AsBytes();
    }

    public async RedisReply GetReplyAsync(string key) { return await this.CommandAsync2("GET", key); }

    public async string GetSetAsync(string key, string val) {
        RedisReply r = await this.CommandAsync3("GETSET", key, val);
        return r.IsNil() ? "" : r.AsString();
    }

    public async bool SetAsync(string key, string val) {
        RedisReply r = await this.CommandAsync3("SET", key, val);
        return r.AsString() == "OK";
    }

    public async bool SetAsync(string key, string val, int expireSeconds) {
        if (expireSeconds <= 0) { return await this.SetAsync(key, val); }
        List<string> args = new List<string>{ "SET", key, val, "EX", Convert.ToString(expireSeconds) };
        RedisReply r = await this.CommandAsync(args);
        return r.AsString() == "OK";
    }

    public async bool SetAsync(string key, string val, int expireSeconds, bool nx, bool xx) {
        List<string> args = new List<string>{ "SET", key, val };
        if (expireSeconds > 0) {
            args.Add("EX");
            args.Add(Convert.ToString(expireSeconds));
        }
        if (nx) {
            args.Add("NX");
        } else if (xx) {
            args.Add("XX");
        }
        RedisReply r = await this.CommandAsync(args);
        return r.AsString() == "OK";
    }

    public async bool SetExAsync(string key, int seconds, string val) {
        List<string> args = new List<string>{ "SETEX", key, Convert.ToString(seconds), val };
        RedisReply r = await this.CommandAsync(args);
        return r.AsString() == "OK";
    }

    public async bool SetNxAsync(string key, string val) {
        RedisReply r = await this.CommandAsync3("SETNX", key, val);
        return r.AsInt() == 1;
    }

    public async bool SetNxAsync(string key, string val, int expireSeconds) {
        return await this.SetAsync(key, val, expireSeconds, true, false);
    }

    public async bool SetXxAsync(string key, string val) {
        return await this.SetAsync(key, val, 0, false, true);
    }

    public async bool SetAsync<T>(string key, T val) {
        return await this.SetAsync(key, this.SerializeObject((object)val));
    }

    public async bool SetAsync<T>(string key, T val, int expireSeconds) {
        return await this.SetAsync(key, this.SerializeObject((object)val), expireSeconds);
    }

    public async bool SetAsync<T>(string key, T val, int expireSeconds, bool nx, bool xx) {
        return await this.SetAsync(key, this.SerializeObject((object)val), expireSeconds, nx, xx);
    }

    public async bool SetExAsync<T>(string key, int seconds, T val) {
        return await this.SetExAsync(key, seconds, this.SerializeObject((object)val));
    }

    public async bool SetNxAsync<T>(string key, T val) {
        return await this.SetNxAsync(key, this.SerializeObject((object)val));
    }

    public async bool SetNxAsync<T>(string key, T val, int expireSeconds) {
        return await this.SetNxAsync(key, this.SerializeObject((object)val), expireSeconds);
    }

    public async bool SetBytesAsync(string key, byte[] val) {
        if (val == null) { return false; }
        List<string> args = new List<string>{ "SET", key };
        RedisReply r = await this.CommandBytesAsync(args, val);
        return r.IsString() && r.AsString() == "OK";
    }

    public async List<string> MGetAsync(params string[] keys) {
        List<string> list = new List<string>();
        if (keys == null) { return list; }
        for (int i = 0; i < keys.Length; i = i + 1) { list.Add(keys[i]); }
        return await this.MGetAsync(list);
    }

    public async List<string> MGetAsync(List<string> keys) {
        if (keys == null || keys.Count == 0) { return new List<string>(); }
        RedisReply r = await this.ExecKeysAsync("MGET", keys);
        return r.AsListString();
    }

    public async bool MSetAsync(List<RedisEntry> entries) {
        return await this.MSetEntriesAsync(entries);
    }

    public async bool MSetAsync(params string[] keyValues) {
        if (keyValues == null || keyValues.Length < 2) { return false; }
        List<RedisEntry> entries = new List<RedisEntry>();
        for (int i = 0; i + 1 < keyValues.Length; i = i + 2) {
            entries.Add(new RedisEntry(keyValues[i], keyValues[i + 1]));
        }
        return await this.MSetEntriesAsync(entries);
    }

    public async bool MSetAsync(Dictionary<string, string> dict) {
        if (dict == null || dict.Count == 0) { return false; }
        List<RedisEntry> entries = new List<RedisEntry>();
        List<string> keys = dict.Keys;
        for (int i = 0; i < keys.Count; i = i + 1) {
            string k = keys[i];
            entries.Add(new RedisEntry(k, dict[k]));
        }
        return await this.MSetEntriesAsync(entries);
    }

    public async bool MSetAsync(List<string> keys, List<string> vals) {
        if (keys == null || vals == null || keys.Count == 0 || keys.Count != vals.Count) { return false; }
        List<RedisEntry> entries = new List<RedisEntry>();
        for (int i = 0; i < keys.Count; i = i + 1) {
            entries.Add(new RedisEntry(keys[i], vals[i]));
        }
        return await this.MSetEntriesAsync(entries);
    }

    public async bool MSetEntriesAsync(List<RedisEntry> entries) {
        if (entries == null || entries.Count == 0) { return false; }
        RedisReply r = await this.ExecEntriesAsync("MSET", entries);
        return r.AsString() == "OK";
    }

    public async bool MSetNxAsync(List<RedisEntry> entries) {
        if (entries == null || entries.Count == 0) { return false; }
        RedisReply r = await this.ExecEntriesAsync("MSETNX", entries);
        return r.AsInt() == 1;
    }

    public async int IncrAsync(string key) {
        RedisReply r = await this.CommandAsync2("INCR", key);
        return r.AsInt();
    }

    public async long Incr64Async(string key) {
        RedisReply r = await this.CommandAsync2("INCR", key);
        return r.AsLong();
    }

    public async long IncrByAsync(string key, long amount) {
        RedisReply r = await this.CommandAsync3("INCRBY", key, Convert.ToString(amount));
        return r.AsLong();
    }

    public async double IncrByFloatAsync(string key, double amount) {
        List<string> args = new List<string>{ "INCRBYFLOAT", key, Convert.ToString(amount) };
        RedisReply r = await this.CommandAsync(args);
        return r.AsDouble();
    }

    public async int DecrAsync(string key) {
        RedisReply r = await this.CommandAsync2("DECR", key);
        return r.AsInt();
    }

    public async long Decr64Async(string key) {
        RedisReply r = await this.CommandAsync2("DECR", key);
        return r.AsLong();
    }

    public async long DecrByAsync(string key, long amount) {
        RedisReply r = await this.CommandAsync3("DECRBY", key, Convert.ToString(amount));
        return r.AsLong();
    }

    public async long StrLenAsync(string key) {
        RedisReply r = await this.CommandAsync2("STRLEN", key);
        return r.AsLong();
    }

    public async long AppendAsync(string key, string value) {
        RedisReply r = await this.CommandAsync3("APPEND", key, value);
        return r.AsLong();
    }

    public async string GetRangeAsync(string key, long start, long end) {
        List<string> args = new List<string>{ "GETRANGE", key, Convert.ToString(start), Convert.ToString(end) };
        RedisReply r = await this.CommandAsync(args);
        return r.AsString();
    }

    public async long SetRangeAsync(string key, long offset, string value) {
        List<string> args = new List<string>{ "SETRANGE", key, Convert.ToString(offset), value };
        RedisReply r = await this.CommandAsync(args);
        return r.AsLong();
    }

    // 键管理 (Keys)

    public async int DelAsync(string key) {
        RedisReply r = await this.CommandAsync2("DEL", key);
        return r.AsInt();
    }

    public async int DelMultipleAsync(List<string> keys) {
        if (keys == null || keys.Count == 0) { return 0; }
        RedisReply r = await this.ExecKeysAsync("DEL", keys);
        return r.AsInt();
    }

    public async int ExistsAsync(string key) {
        RedisReply r = await this.CommandAsync2("EXISTS", key);
        return r.AsInt();
    }

    public async int ExistsMultipleAsync(List<string> keys) {
        if (keys == null || keys.Count == 0) { return 0; }
        RedisReply r = await this.ExecKeysAsync("EXISTS", keys);
        return r.AsInt();
    }

    public async string TypeAsync(string key) {
        RedisReply r = await this.CommandAsync2("TYPE", key);
        return r.AsString();
    }

    public async int ExpireAsync(string key, int seconds) {
        RedisReply r = await this.CommandAsync3("EXPIRE", key, Convert.ToString(seconds));
        return r.AsInt();
    }

    public async int ExpireAtAsync(string key, long timestamp) {
        RedisReply r = await this.CommandAsync3("EXPIREAT", key, Convert.ToString(timestamp));
        return r.AsInt();
    }

    public async int PExpireAsync(string key, long ms) {
        RedisReply r = await this.CommandAsync3("PEXPIRE", key, Convert.ToString(ms));
        return r.AsInt();
    }

    public async long TtlAsync(string key) {
        RedisReply r = await this.CommandAsync2("TTL", key);
        return r.AsLong();
    }

    public async long PTtlAsync(string key) {
        RedisReply r = await this.CommandAsync2("PTTL", key);
        return r.AsLong();
    }

    public async int PersistAsync(string key) {
        RedisReply r = await this.CommandAsync2("PERSIST", key);
        return r.AsInt();
    }

    // KEYS 会全库阻塞扫描，生产大库应优先使用 ScanAsync。
    public async List<string> KeysAsync(string pattern) {
        RedisReply r = await this.CommandAsync2("KEYS", pattern);
        return r.AsListString();
    }

    public async bool RenameAsync(string key, string newKey) {
        RedisReply r = await this.CommandAsync3("RENAME", key, newKey);
        return r.AsString() == "OK";
    }

    public async bool RenameNxAsync(string key, string newKey) {
        RedisReply r = await this.CommandAsync3("RENAMENX", key, newKey);
        return r.AsInt() == 1;
    }

    public async string RandomKeyAsync() {
        RedisReply r = await this.CommandAsync1("RANDOMKEY");
        return r.AsString();
    }

    public async byte[] DumpAsync(string key) {
        RedisReply r = await this.CommandAsync2("DUMP", key);
        return r.AsBytes();
    }

    public async RedisScanResult ScanAsync(long cursor, string pattern, int count) {
        List<string> args = new List<string>{ "SCAN", Convert.ToString(cursor) };
        if (pattern != null && pattern.Length > 0) {
            args.Add("MATCH");
            args.Add(pattern);
        }
        if (count > 0) {
            args.Add("COUNT");
            args.Add(Convert.ToString(count));
        }
        return RedisClient.ParseScanReply(await this.CommandAsync(args));
    }

    // 哈希 (Hashes)

    public async long HSetAsync(string key, string field, string value) {
        List<string> args = new List<string>{ "HSET", key, field, value };
        RedisReply r = await this.CommandAsync(args);
        return r.AsLong();
    }

    public async long HSetAsync<T>(string key, string field, T value) {
        return await this.HSetAsync(key, field, this.SerializeObject((object)value));
    }

    public async bool HSetNxAsync(string key, string field, string value) {
        List<string> args = new List<string>{ "HSETNX", key, field, value };
        RedisReply r = await this.CommandAsync(args);
        return r.AsInt() == 1;
    }

    public async bool HSetNxAsync<T>(string key, string field, T value) {
        return await this.HSetNxAsync(key, field, this.SerializeObject((object)value));
    }

    public async string HGetAsync(string key, string field) {
        RedisReply r = await this.CommandAsync3("HGET", key, field);
        return r.IsNil() ? "" : r.AsString();
    }

    public async T HGetObjectAsync<T>(string key, string field) {
        string raw = await this.HGetAsync(key, field);
        if (raw == null || raw == "") { return (T)(object)null; }
        return this.DeserializeObject<T>(raw);
    }

    public async T HGetAsync<T>(string key, string field) { return await this.HGetObjectAsync<T>(key, field); }

    public async byte[] HGetBytesAsync(string key, string field) {
        RedisReply r = await this.CommandAsync3("HGET", key, field);
        if (r.IsNil() || r.IsError()) { return null; }
        return r.AsBytes();
    }

    public async bool HMSetAsync(string key, Dictionary<string, string> dict) {
        if (dict == null || dict.Count == 0) { return false; }
        List<string> args = new List<string>{ "HMSET", key };
        List<string> keys = dict.Keys;
        for (int i = 0; i < keys.Count; i = i + 1) {
            string f = keys[i];
            args.Add(f);
            args.Add(dict[f]);
        }
        RedisReply r = await this.CommandAsync(args);
        return r.AsString() == "OK";
    }

    public async bool HMSetAsync(string key, List<RedisEntry> entries) {
        if (entries == null || entries.Count == 0) { return false; }
        List<string> args = new List<string>{ "HMSET", key };
        for (int i = 0; i < entries.Count; i = i + 1) {
            RedisEntry e = entries[i];
            if (e != null) {
                args.Add(e.key);
                args.Add(e.value);
            }
        }
        RedisReply r = await this.CommandAsync(args);
        return r.AsString() == "OK";
    }

    public async bool HMSetAsync(string key, List<string> fields, List<string> values) {
        if (fields == null || values == null || fields.Count == 0 || fields.Count != values.Count) { return false; }
        List<string> args = new List<string>{ "HMSET", key };
        for (int i = 0; i < fields.Count; i = i + 1) {
            args.Add(fields[i]);
            args.Add(values[i]);
        }
        RedisReply r = await this.CommandAsync(args);
        return r.AsString() == "OK";
    }

    public async List<string> HMGetAsync(string key, params string[] fields) {
        List<string> list = new List<string>();
        if (fields == null) { return list; }
        for (int i = 0; i < fields.Length; i = i + 1) { list.Add(fields[i]); }
        return await this.HMGetAsync(key, list);
    }

    public async List<string> HMGetAsync(string key, List<string> fields) {
        if (fields == null || fields.Count == 0) { return new List<string>(); }
        RedisReply r = await this.ExecKeyValuesAsync("HMGET", key, fields);
        return r.AsListString();
    }

    public async long HIncrByAsync(string key, string field, long amount) {
        List<string> args = new List<string>{ "HINCRBY", key, field, Convert.ToString(amount) };
        RedisReply r = await this.CommandAsync(args);
        return r.AsLong();
    }

    public async double HIncrByFloatAsync(string key, string field, double amount) {
        List<string> args = new List<string>{ "HINCRBYFLOAT", key, field, Convert.ToString(amount) };
        RedisReply r = await this.CommandAsync(args);
        return r.AsDouble();
    }

    public async bool HExistsAsync(string key, string field) {
        RedisReply r = await this.CommandAsync3("HEXISTS", key, field);
        return r.AsInt() == 1;
    }

    public async int HDelAsync(string key, string field) {
        RedisReply r = await this.CommandAsync3("HDEL", key, field);
        return r.AsInt();
    }

    public async int HDelMultipleAsync(string key, List<string> fields) {
        if (fields == null || fields.Count == 0) { return 0; }
        RedisReply r = await this.ExecKeyValuesAsync("HDEL", key, fields);
        return r.AsInt();
    }

    public async long HLenAsync(string key) {
        RedisReply r = await this.CommandAsync2("HLEN", key);
        return r.AsLong();
    }

    public async List<string> HKeysAsync(string key) {
        RedisReply r = await this.CommandAsync2("HKEYS", key);
        return r.AsListString();
    }

    public async List<string> HValsAsync(string key) {
        RedisReply r = await this.CommandAsync2("HVALS", key);
        return r.AsListString();
    }

    public async Dictionary<string, string> HGetAllAsync(string key) {
        RedisReply r = await this.CommandAsync2("HGETALL", key);
        return r.AsDictionary();
    }

    public async long HStrLenAsync(string key, string field) {
        RedisReply r = await this.CommandAsync3("HSTRLEN", key, field);
        return r.AsLong();
    }

    public async RedisScanResult HScanAsync(string key, long cursor, string pattern, int count) {
        return await this.ScanKeyAsync("HSCAN", key, cursor, pattern, count);
    }
}
