    // DEL 删除单个键，返回删除数（0 或 1）。
    public async int DelAsync(string key) {
        RedisReply r = await this.CommandAsync2("DEL", key);
        return r.AsInt();
    }

    // DEL 批量删除多个键，返回成功删除的键数。
    public async int DelMultipleAsync(List<string> keys) {
        if (keys == null || keys.Count == 0) { return 0; }
        List<string> args = new List<string>();
        args.Add("DEL");
        for (int i = 0; i < keys.Count; i = i + 1) {
            args.Add(keys[i]);
        }
        RedisReply r = await this.CommandAsync(args);
        return r.AsInt();
    }

    // EXISTS 检查单个键是否存在。
    public async int ExistsAsync(string key) {
        RedisReply r = await this.CommandAsync2("EXISTS", key);
        return r.AsInt();
    }

    // EXISTS 检查多个键中存在的数量。
    public async int ExistsMultipleAsync(List<string> keys) {
        if (keys == null || keys.Count == 0) { return 0; }
        List<string> args = new List<string>();
        args.Add("EXISTS");
        for (int i = 0; i < keys.Count; i = i + 1) {
            args.Add(keys[i]);
        }
        RedisReply r = await this.CommandAsync(args);
        return r.AsInt();
    }

    // TYPE 获取键的数据类型。
    public async string TypeAsync(string key) {
        RedisReply r = await this.CommandAsync2("TYPE", key);
