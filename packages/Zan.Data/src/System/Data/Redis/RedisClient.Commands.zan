using System;
using System.Collections.Generic;

namespace System.Data.Redis;

public partial class RedisClient {
    // 连接与认证 (Connection & Auth)

    // PING；回复 PONG 返回 true。
    public async bool PingAsync() {
        RedisReply r = await this.CommandAsync1("PING");
        return r.AsString() == "PONG";
    }

    // AUTH 单密码认证。
    public async bool AuthAsync(string password) {
        RedisReply r = await this.CommandAsync2("AUTH", password);
        return r.AsString() == "OK";
    }

    // AUTH 用户名与密码认证（Redis 6+ ACL）。
    public async bool AuthAsync(string username, string password) {
        RedisReply r = await this.CommandAsync3("AUTH", username, password);
        return r.AsString() == "OK";
    }

    // SELECT 切换逻辑数据库。
    public async bool SelectAsync(int index) {
        RedisReply r = await this.CommandAsync2("SELECT", Convert.ToString(index));
        return r.AsString() == "OK";
    }

    // ECHO 回显测试。
    public async string EchoAsync(string message) {
        RedisReply r = await this.CommandAsync2("ECHO", message);
        return r.AsString();
    }

    // 字符串 (Strings)

    // GET key。键不存在或出错返回空串。区分 nil 请用 GetReplyAsync。
    public async string GetAsync(string key) {
        RedisReply r = await this.CommandAsync2("GET", key);
        if (r.IsNil()) { return ""; }
        return r.AsString();
    }

    // GET key 并自动反序列化为对象类型 T。键不存在或反序列化失败返回 null/default。
    public async T GetObjectAsync<T>(string key) {
        string raw = await this.GetAsync(key);
        if (raw == null || raw == "") {
            return (T)(object)null;
        }
        return this.DeserializeObject<T>(raw);
    }

    // GET key 并自动反序列化为 T（FreeRedis cli.Get&lt;T&gt; 规范）。
    public async T GetAsync<T>(string key) {
        return await this.GetObjectAsync<T>(key);
    }

    // 二进制安全的 GET：返回原始字节数组。键不存在返回 null。
    public async byte[] GetBytesAsync(string key) {
        RedisReply r = await this.CommandAsync2("GET", key);
        if (r.IsNil() || r.IsError()) { return null; }
        return r.AsBytes();
    }

    // GET key，返回原始 RESP 回复。
    public async RedisReply GetReplyAsync(string key) {
        return await this.CommandAsync2("GET", key);
    }

    // GETSET key value：设置新值并返回旧值。
    public async string GetSetAsync(string key, string val) {
        RedisReply r = await this.CommandAsync3("GETSET", key, val);
        if (r.IsNil()) { return ""; }
        return r.AsString();
    }

    // SET key value。成功返回 true。
    public async bool SetAsync(string key, string val) {
        RedisReply r = await this.CommandAsync3("SET", key, val);
        return r.AsString() == "OK";
    }

    // SET key value EX seconds：带过期时间秒数的设置。
    public async bool SetAsync(string key, string val, int expireSeconds) {
        if (expireSeconds <= 0) {
            return await this.SetAsync(key, val);
        }
        List<string> args = new List<string>{ "SET", key, val, "EX", Convert.ToString(expireSeconds) };
        RedisReply r = await this.CommandAsync(args);
        return r.AsString() == "OK";
    }

    // SET key value [EX seconds] [NX|XX] 全功能重载。
    public async bool SetAsync(string key, string val, int expireSeconds, bool nx, bool xx) {
        List<string> args = new List<string>{ "SET", key, val };
        if (expireSeconds > 0) {
            args.Add("EX");
            args.Add(Convert.ToString(expireSeconds));
        }
        if (nx) {
            args.Add("NX");
        } else if (xx) {
            args.Add("XX");
        }
        RedisReply r = await this.CommandAsync(args);
        return r.AsString() == "OK";
    }

    public async bool SetExAsync(string key, int seconds, string val) {
        List<string> args = new List<string>{ "SETEX", key, Convert.ToString(seconds), val };
        RedisReply r = await this.CommandAsync(args);
        return r.AsString() == "OK";
    }

    // SETNX key value：键不存在时才设置，成功返回 true。
    public async bool SetNxAsync(string key, string val) {
        RedisReply r = await this.CommandAsync3("SETNX", key, val);
        return r.AsInt() == 1;
    }

    // SETNX 带过期时间设置（原子锁常用）。
    public async bool SetNxAsync(string key, string val, int expireSeconds) {
        return await this.SetAsync(key, val, expireSeconds, true, false);
    }

    // SETXX key value：键已存在时才设置更新。
    public async bool SetXxAsync(string key, string val) {
        return await this.SetAsync(key, val, 0, false, true);
    }

    // SET key value 将对象序列化后存入 Redis。成功返回 true。
    public async bool SetAsync<T>(string key, T val) {
        string s = this.SerializeObject((object)val);
        return await this.SetAsync(key, s);
    }

    // SET key value EX seconds 将对象序列化后带过期时间存入 Redis。
    public async bool SetAsync<T>(string key, T val, int expireSeconds) {
        string s = this.SerializeObject((object)val);
        return await this.SetAsync(key, s, expireSeconds);
    }

    // SET key value [EX seconds] [NX|XX] 对象全功能重载。
    public async bool SetAsync<T>(string key, T val, int expireSeconds, bool nx, bool xx) {
        string s = this.SerializeObject((object)val);
        return await this.SetAsync(key, s, expireSeconds, nx, xx);
    }

    // SETEX key seconds value 对象存入并设置过期时间。
    public async bool SetExAsync<T>(string key, int seconds, T val) {
        string s = this.SerializeObject((object)val);
        return await this.SetExAsync(key, seconds, s);
    }

    // SETNX key value 对象键不存在时才设置，成功返回 true。
    public async bool SetNxAsync<T>(string key, T val) {
        string s = this.SerializeObject((object)val);
        return await this.SetNxAsync(key, s);
    }

    // SETNX 带过期时间设置（原子锁常用）。
    public async bool SetNxAsync<T>(string key, T val, int expireSeconds) {
        string s = this.SerializeObject((object)val);
        return await this.SetNxAsync(key, s, expireSeconds);
    }

    // 二进制安全 SET。
    public async bool SetBytesAsync(string key, byte[] val) {
        if (val == null) { return false; }
        List<string> args = new List<string>{ "SET", key };
        RedisReply r = await this.CommandBytesAsync(args, val);
        return r.IsString() && r.AsString() == "OK";
    }

    // MGET 批量获取（变长参数平铺）。
    public async List<string> MGetAsync(params string[] keys) {
        List<string> list = new List<string>();
        if (keys == null) { return list; }
        for (int i = 0; i < keys.Length; i = i + 1) {
            list.Add(keys[i]);
        }
        return await this.MGetAsync(list);
    }

    // MGET 批量获取。
    public async List<string> MGetAsync(List<string> keys) {
        List<string> res = new List<string>();
        if (keys == null || keys.Count == 0) { return res; }
        List<string> args = new List<string>();
        args.Add("MGET");
        for (int i = 0; i < keys.Count; i = i + 1) {
            args.Add(keys[i]);
        }
        RedisReply r = await this.CommandAsync(args);
        return r.AsListString();
    }

    // MSET 批量设置实体列表。
    public async bool MSetAsync(List<RedisEntry> entries) {
        return await this.MSetEntriesAsync(entries);
    }

    // MSET 批量设置（变长平铺参数：key1, val1, key2, val2, ...）。
    public async bool MSetAsync(params string[] keyValues) {
        if (keyValues == null || keyValues.Length < 2) { return false; }
        List<RedisEntry> entries = new List<RedisEntry>();
        for (int i = 0; i + 1 < keyValues.Length; i = i + 2) {
            entries.Add(new RedisEntry(keyValues[i], keyValues[i + 1]));
        }
        return await this.MSetEntriesAsync(entries);
    }

    // MSET 批量设置字典。
    public async bool MSetAsync(Dictionary<string, string> dict) {
        if (dict == null || dict.Count == 0) { return false; }
        List<RedisEntry> entries = new List<RedisEntry>();
        List<string> keys = dict.Keys;
        for (int i = 0; i < keys.Count; i = i + 1) {
            string k = keys[i];
            entries.Add(new RedisEntry(k, dict[k]));
        }
        return await this.MSetEntriesAsync(entries);
    }

    // MSET 键与值列表批量设置便捷重载。
    public async bool MSetAsync(List<string> keys, List<string> vals) {
        if (keys == null || vals == null || keys.Count == 0 || keys.Count != vals.Count) {
            return false;
        }
        List<RedisEntry> entries = new List<RedisEntry>();
        for (int i = 0; i < keys.Count; i = i + 1) {
            entries.Add(new RedisEntry(keys[i], vals[i]));
        }
        return await this.MSetEntriesAsync(entries);
    }

    // MSET 实体主方法。
    public async bool MSetEntriesAsync(List<RedisEntry> entries) {
        if (entries == null || entries.Count == 0) { return false; }
        List<string> args = new List<string>();
        args.Add("MSET");
        for (int i = 0; i < entries.Count; i = i + 1) {
            RedisEntry e = entries[i];
            if (e != null) {
                args.Add(e.key);
                args.Add(e.value);
            }
        }
        RedisReply r = await this.CommandAsync(args);
        return r.AsString() == "OK";
    }

    // MSETNX 仅当所有键都不存在时批量设置。
    public async bool MSetNxAsync(List<RedisEntry> entries) {
        if (entries == null || entries.Count == 0) { return false; }
        List<string> args = new List<string>();
        args.Add("MSETNX");
        for (int i = 0; i < entries.Count; i = i + 1) {
            RedisEntry e = entries[i];
            if (e != null) {
                args.Add(e.key);
                args.Add(e.value);
            }
        }
        RedisReply r = await this.CommandAsync(args);
        return r.AsInt() == 1;
    }

