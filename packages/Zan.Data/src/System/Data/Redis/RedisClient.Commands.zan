    public async long Decr64Async(string key) {
        RedisReply r = await this.CommandAsync2("DECR", key);
        return r.AsLong();
    }

    // DECRBY 按指定 64 位整数自减。
    public async long DecrByAsync(string key, long amount) {
        RedisReply r = await this.CommandAsync3("DECRBY", key, Convert.ToString(amount));
        return r.AsLong();
    }

    // STRLEN 获取字符串长度。
    public async long StrLenAsync(string key) {
        RedisReply r = await this.CommandAsync2("STRLEN", key);
        return r.AsLong();
    }

    // APPEND 追加字符串，返回追加后的长度。
    public async long AppendAsync(string key, string value) {
        RedisReply r = await this.CommandAsync3("APPEND", key, value);
        return r.AsLong();
