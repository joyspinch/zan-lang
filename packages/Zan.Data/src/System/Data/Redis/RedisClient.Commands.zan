    }

    // KEYS 模式匹配查找键（注意：生产大库谨慎使用）。
    public async List<string> KeysAsync(string pattern) {
        RedisReply r = await this.CommandAsync2("KEYS", pattern);
        return r.AsListString();
    }

    // RENAME 重命名键。
    public async bool RenameAsync(string key, string newKey) {
        RedisReply r = await this.CommandAsync3("RENAME", key, newKey);
        return r.AsString() == "OK";
    }

    // RENAMENX 仅当新键不存在时重命名。
    public async bool RenameNxAsync(string key, string newKey) {
        RedisReply r = await this.CommandAsync3("RENAMENX", key, newKey);
        return r.AsInt() == 1;
