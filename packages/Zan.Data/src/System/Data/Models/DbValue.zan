using System;
using System.Data;
using System.Data.Orm;
namespace System.Data;

public class DbValue {
    public string name;
    public int kind;
    public string text;
    public long ival;
    public double dval;

    public DbValue(string name, int kind, string text, long ival, double dval) {
        this.name = name;
        this.kind = kind;
        this.text = text;
        this.ival = ival;
        this.dval = dval;
    }
}
