using System;
using System.Text;
namespace System.Data;

public class DbRow {
    public List<DbCell> cells;
    public List<string> texts;

    public DbRow(List<DbCell> cells, List<string> texts) {
        this.cells = cells;
        this.texts = texts;
    }

    // 返回该行的字段总数。
    public int Count() {
        if (this.cells == null) { return 0; }
        return this.cells.Count;
    }

    // 获取指定列索引处的字符串值。
    public string GetString(int col) {
        if (this.cells == null || col < 0 || col >= this.cells.Count) {
            return "";
        }
        DbCell cell = this.cells[col];
        if (cell.kind == 1) {
            return Convert.ToString(cell.ival);
        }
        if (cell.kind == 2) {
            return this.texts[col];
        }
        return "";
    }

    // 指定列是否为 SQL NULL。
    public bool IsNull(int col) {
        if (this.cells == null || col < 0 || col >= this.cells.Count) {
            return false;
        }
        return this.cells[col].kind == 0;
    }

    // 获取指定列索引处的整数值。
    public int GetInt(int col) {
        if (this.cells == null || col < 0 || col >= this.cells.Count) { return 0; }
        DbCell cell = this.cells[col];
        if (cell.kind == 1) {
            return (int)cell.ival;
        }
        if (cell.kind == 2) {
            string val = this.texts[col];
            if (val.Length == 0) { return 0; }
            return Convert.ToInt(val);
        }
        return 0;
    }

    // 获取指定列索引处的 64 位整数值。
    public long GetLong(int col) {
        if (this.cells == null || col < 0 || col >= this.cells.Count) { return 0L; }
        DbCell cell = this.cells[col];
        if (cell.kind == 1) {
            return cell.ival;
        }
        if (cell.kind == 2) {
            string val = this.texts[col];
            if (val.Length == 0) { return 0L; }
            return Convert.ToInt64(val);
        }
        return 0L;
    }

    // 获取指定列索引处的双精度浮点值。
    public double GetDouble(int col) {
        if (this.cells == null || col < 0 || col >= this.cells.Count) { return 0.0; }
        DbCell cell = this.cells[col];
        if (cell.kind == 1) {
            return (double)cell.ival;
        }
        if (cell.kind == 2) {
            string val = this.texts[col];
            if (val.Length == 0) { return 0.0; }
            return val.ToDouble();
        }
        return 0.0;
    }

    // 获取指定列索引处的布尔值。
    public bool GetBool(int col) {
        if (this.cells == null || col < 0 || col >= this.cells.Count) { return false; }
        DbCell cell = this.cells[col];
        if (cell.kind == 1) {
            return cell.ival == 1;
        }
        if (cell.kind == 2) {
            string val = this.texts[col];
            return val == "1" || val == "true" || val == "True";
        }
        return false;
    }
}
