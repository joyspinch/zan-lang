using System;
using System.Text;
namespace System.Data;

public struct DbCell {
    // 0 = SQL NULL；1 = 整数；2 = 文本。
    public int kind;
    // kind 1 的 64 位整数值。
    public long ival;
}

// 一行结果：类型化单元格带（kind/ival）与文本载荷平行表。
// cells 刻意保持纯 POD（无 ARC 指针字段）——List&lt;struct&gt; 每次
// 下标读都按位拷贝，带指针字段就会每次 retain/release，纯 POD 才能
// 当数组用（同 JsonSlot/JsonPair 的取舍）；文本放 texts 平行表，
// 只在 kind 2 时读取。两表长度恒相等。
