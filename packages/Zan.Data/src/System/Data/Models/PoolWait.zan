using System;
using System.Threading;
namespace System.Data;

public class PoolWait {
    // 已消耗的事件门等次数。计数语义的门加上调用方的复查
    // 循环保证不丢失唤醒；超过上限说明持有者整体停滞（嵌套租借、
    // 漏归还），转轮询兜底。
    public int gated;

    // 剩余的短轮询预算（毫秒），耗尽即放弃本次获取。
    public int budget;

    public PoolWait() {
        this.gated = 0;
        this.budget = PoolWait.PollBudgetMs;
    }

    // 单次门等的看门狗上限（毫秒）。Signal 正常到达时等待者
    // 立即醒来，不受此值影响；它只是唤醒丢失时的保险丝——最坏情况
    // 下每轮门等多拖这么久就复查一次，谁也不会永久停在门上。
    public static int GateWaitMs = 250;

    // 门等次数上限：健康系统里归还远快于此，用满意味着池
    // 已被病态持有拖住。
    public static int MaxGateWaits = 64;

    // 轮询步长（毫秒）：预算耗尽前最后的挣扎，也让等待者
    // 周期性重查 IsClosed/空闲列表。
    public static int PollStepMs = 20;

    // 轮询总预算（毫秒）：这是进程级自愈兜底的一部分——
    // 病态持有的最坏情形下，单个请求最多挂这么久就以 null 放弃。
    public static int PollBudgetMs = 10000;
}
