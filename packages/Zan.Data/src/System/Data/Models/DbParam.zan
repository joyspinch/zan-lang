using System;
namespace System.Data;

public class DbParam {
    public int kind;
    public string text;
    public long ival;
    public double dval;

    public DbParam(int kind, string text, long ival, double dval) {
        this.kind = kind;
        this.text = text;
        this.ival = ival;
        this.dval = dval;
    }
}
