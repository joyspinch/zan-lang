using System;
namespace System.Data;

public class DbParam {
    public int kind;
    public string text;
    public long ival;
    public double dval;

    public DbParam(int kind, string text, long ival, double dval) {
        this.kind = kind;
        this.text = text;
        this.ival = ival;
        this.dval = dval;
    }
}

// 有序、带类型的 SQL 参数列表，所有数据库驱动共用。
// 值携带自身类型（int / double / text / null），驱动可
// 原生绑定它们（sqlite3_bind_*、COM_STMT_EXECUTE、PQexecParams、
// SQLBindParameter），而不是把转义字符串内联进 SQL。
// 用法：
