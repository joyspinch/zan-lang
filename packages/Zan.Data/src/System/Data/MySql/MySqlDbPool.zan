using System;
using System.Data;
using System.Threading;

namespace System.Data.MySql;

// 协程化 MySQL 连接池（与 MySqlAsyncConnector.Pool 配对）：归还时若残留未收尾事务，通过清理协程异步回滚后再入池。
public class MySqlDbPool : DbPool {
    public MySqlDbPool(IDbConnector connector, int maxSize)
            : base(connector, maxSize) {
    }

    // 归还连接；若存在未收尾事务则由清理协程回滚后再放行。
    public override void Release(IDbConnection c) {
        if (c is MySqlConnection) {
            MySqlConnection mc = (MySqlConnection)c;
            if (mc.inTxn) {
                Task.Spawn(this.Cleanup(mc));
                return;
            }
        }
        base.Release(c);
    }

    // 清理协程体：ROLLBACK 落地后按基类同规入池；若回滚抛出异常或连接失效，
    // 说明连接可能处于协议错位或断开状态，立即关闭并丢弃，严禁脏连接回池。
    private async bool Cleanup(MySqlConnection mc) {
        bool failed = false;
        try {
            await mc.RollbackAsync();
        } catch (Exception ex) {
            failed = true;
        }
        mc.inTxn = false;
        if (failed || !mc.IsConnected()) {
            try { mc.Close(); }
            finally { this.Drop(mc); }
            return true;
        }
        base.Release(mc);
        return true;
    }
}
