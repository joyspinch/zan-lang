using System;

namespace System.Data.MySql;

// One logical receive message (all 0xFFFFFF continuations), excluding headers
// and the trailing NUL slot. 64 MiB matches the TDS value and ZanDb frame
// budgets. Admission precedes body reads/allocations in both MySQL readers.
internal static class MySqlPacketBounds {
    internal const int MaxMessageBytes = 67108864;
    internal const int MaxChunkBytes = 16777215;

    // -1 rejects invalid state or an over-budget header without adding first.
    // The accepted result leaves room for the array's trailing NUL slot.
    internal static int AppendLength(int total, int chunk) {
        if (total < 0 || total > MySqlPacketBounds.MaxMessageBytes
            || chunk < 0 || chunk > MySqlPacketBounds.MaxChunkBytes) { return -1; }
        if (chunk > MySqlPacketBounds.MaxMessageBytes - total) { return -1; }
        return total + chunk;
    }

    internal static void Advertise(byte[] header, int offset) {
        int limit = MySqlPacketBounds.MaxMessageBytes;
        header[offset] = (byte)(limit & 255);
        header[offset + 1] = (byte)((limit >> 8) & 255);
        header[offset + 2] = (byte)((limit >> 16) & 255);
        header[offset + 3] = (byte)((limit >> 24) & 255);
    }
}
