using System;
using System.Data;

namespace System.Data.MySql;

/// <summary>
/// 面向 MySQL / MariaDB 的 <see cref="IDbConnector"/>，让 MySQL 与 SQLite、
/// PostgreSQL、ODBC 一起接入与驱动无关的 <see cref="DbPool"/>，
/// 应用可用一种类型池化所有引擎。
///
/// 它返回的连接是同步线协议客户端
/// （<see cref="DbConnection.OpenMySQL"/>）：语句执行时阻塞工作线程
/// 等待服务器响应，因此连接池提供容量控制与复用，而非
/// 非阻塞 IO。它面向无法改成协程的调用点。
/// 优先使用 <see cref="MySqlAsyncConnector"/>，其连接会在
/// reactor 上挂起，除非你需要同步 ORM 终端。
///
/// 用法：
///   DbPool pool = MySqlConnector.Pool("127.0.0.1", 3306, "app", "root", "", 8);
///   IDbConnection db = await pool.AcquireAsync();
///   try { List&lt;Post&gt; rows = db.Select&lt;Post&gt;().ToList(); }
///   finally { pool.Release(db); }
/// </summary>
class MySqlConnector : IDbConnector {
    string host;
    int port;
    string database;
    string user;
    string password;

    MySqlConnector(string host, int port, string database, string user,
            string password) {
        this.host = host;
        this.port = port;
        this.database = database;
        this.user = user;
        this.password = password;
    }

    /// <summary>基于 host/port/database/user/password 的连接池。</summary>
    static DbPool Pool(string host, int port, string database, string user,
            string password, int maxSize) {
        return new DbPool(
            new MySqlConnector(host, port, database, user, password), maxSize);
    }

    /// 打开一个同步线协议连接（执行语句时阻塞工作线程等待服务器）。
    async IDbConnection ConnectAsync() {
        return DbConnection.OpenMySQL(this.host, this.port, this.database,
            this.user, this.password);
    }

    /// 池的 provider id（恒为 <see cref="DbProvider.MySQL"/>）。
    int GetProvider() {
        return DbProvider.MySQL;
    }
}

/// <summary>
/// 返回协程化
/// <see cref="MySqlConnection"/> 的 <see cref="IDbConnector"/>，使 MySQL 连接的 <see cref="DbPool"/>
/// 端到端非阻塞：等待空闲连接时
/// 挂起（连接池），等待服务器响应同样挂起（驱动）。而
/// 使用阻塞驱动时只有前者成立，这会把数据库并发
/// 限制在 worker 数量上，无论连接池多大。
///
/// 这些连接只实现
/// <see cref="IDbExecutor"/> 的异步部分；同步部分会抛错并指明要用的 *Async
/// 终端。因此请将此连接池与异步 ORM 链搭配使用：
///
///   DbPool pool = MySqlAsyncConnector.Pool("127.0.0.1", 3306, "app", "root", "", 8);
///   IDbConnection db = await pool.AcquireAsync();
///   try { List&lt;Post&gt; rows = await db.Select&lt;Post&gt;().ToListAsync(); }
///   finally { pool.Release(db); }
/// </summary>
class MySqlAsyncConnector : IDbConnector {
    string host;
    int port;
    string database;
    string user;
    string password;

    MySqlAsyncConnector(string host, int port, string database, string user,
            string password) {
        this.host = host;
        this.port = port;
        this.database = database;
        this.user = user;
        this.password = password;
    }

    /// <summary>基于 host/port/database/user/password 的非阻塞连接池。</summary>
    static DbPool Pool(string host, int port, string database, string user,
            string password, int maxSize) {
        return new DbPool(
            new MySqlAsyncConnector(host, port, database, user, password),
            maxSize);
    }

    /// 在 reactor 上执行握手打开一个协程化连接。
    async IDbConnection ConnectAsync() {
        return await MySqlConnection.OpenParamsAsync(this.host, this.port,
            this.database, this.user, this.password);
    }

    /// 池的 provider id（恒为 <see cref="DbProvider.MySQL"/>）。
    int GetProvider() {
        return DbProvider.MySQL;
    }
}
