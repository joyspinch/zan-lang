using System;
using System.Data;
using System.Data.Odbc;

namespace System.Data.MySql;

// 面向 MySQL / MariaDB 的同步 IDbConnector（接入通用 DbPool）；协程路径优先使用 MySqlAsyncConnector。
public class MySqlConnector : IDbConnector {
    public string host;
    public int port;
    public string database;
    public string user;
    public string password;

    public MySqlConnector(string host, int port, string database, string user,
            string password) {
        this.host = host;
        this.port = port;
        this.database = database;
        this.user = user;
        this.password = password;
    }

    // 基于 host/port/database/user/password 的连接池。
    public static DbPool Pool(string host, int port, string database, string user,
            string password, int maxSize) {
        return new DbPool(
            new MySqlConnector(host, port, database, user, password), maxSize);
    }

    // 打开一个同步线协议连接（执行语句时阻塞工作线程等待服务器）。
    public async IDbConnection ConnectAsync() {
        return DbConnection.OpenMySQL(this.host, this.port, this.database,
            this.user, this.password);
    }

    // 池的 provider id（恒为 DbProvider.MySQL）。
    public int GetProvider() {
        return DbProvider.MySQL;
    }
}
