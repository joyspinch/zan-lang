using System;

namespace System.Data.MySql;

// 一条缓存的预编译语句：其 SQL 文本及对应的
// 服务端语句 id。用一个实体，而非并行的 sql/id 列表。
public class PreparedStmt {
    public string sql;
    public int id;

    // 保存 SQL 文本与服务端语句 id。
    public PreparedStmt(string sql, int id) {
        this.sql = sql;
        this.id = id;
    }
}
