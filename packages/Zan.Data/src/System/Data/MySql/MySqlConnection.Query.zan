using System;
using System.Collections.Generic;
using System.Data;

namespace System.Data.MySql;

public partial class MySqlConnection : IDbConnection {
    public async DbResult QueryAsync(string sql) {
        await this.AcquireLock();
        try {
            DbResult result = new DbResult();
            this.hadError = false;
            this.lastAffected = 0;
            this.lastError = "";
            if (!this.connected) {
                this.hadError = true;
                this.lastError = "not connected";
                this.fail();
            }
            await this.comQuery(sql);
            byte[] first = await this.readPacket();
            if (first == null) {
                this.hadError = true;
                this.lastError = "connection closed";
                this.connected = false;
                this.fail();
            }
            int b0 = first[0] & 255;
            if (b0 == 255) {
                int code = (first[1]&255)|((first[2]&255)<<8);
                this.lastError = "err " + Convert.ToString(code) + ": "
                    + MySqlWire.bytesToStr(first, 9, this.lastLen - 9);
                this.hadError = true;
                this.lastNumber = code;
                this.fail();
            }
            if (b0 == 0 || b0 == 254) {
                // OK 包（无结果集）：偏移 1 处的 lenenc 整数即受影响行数。
                int p = 1;
                this.lastAffected = (int)MySqlWire.readLenencRaw(first, ref p);
                return result;
            }
            // 结果集：首个数据包为列数（lenenc）。
            int pcc = 0;
            int ncols = (int)MySqlWire.readLenencRaw(first, ref pcc);
            result.SetColumnCount(ncols);
            List<int> colTypes = new List<int>();
            List<int> colFlags = new List<int>();
            int c = 0;
            for (; c < ncols; c = c + 1) {
                byte[] cd = await this.readPacket();
                int p = 0;
                MySqlWire.readLenencStrRaw(cd, ref p);  // catalog
                MySqlWire.readLenencStrRaw(cd, ref p);  // schema
                MySqlWire.readLenencStrRaw(cd, ref p);  // table
                MySqlWire.readLenencStrRaw(cd, ref p);  // org_table
                result.AddColumnName(MySqlWire.readLenencStrRaw(cd, ref p));  // name
                MySqlWire.readLenencStrRaw(cd, ref p);  // org_name
                MySqlWire.readLenencRaw(cd, ref p);  // 定长字段标记（0x0c）
                colTypes.Add(cd[p + 6] & 255);  // 字符集 2 + 长度 4
                colFlags.Add((cd[p+7]&255) | ((cd[p+8]&255) << 8));
            }
            byte[] colEof = await this.readPacket();  // 结束列定义的 EOF
            int rowCount = 0;
            while (true) {
                byte[] row = await this.readPacket();
                if (row == null) { break; }
                if (this.isEof(row)) { break; }
                int p = 0;
                List<DbCell> cells = new List<DbCell>();
                List<string> texts = new List<string>();
                c = 0;
                while (c < ncols) {
                    DbCell cell = new DbCell();
                    if ((row[p] & 255) == 251) {  // NULL 标记
                        p = p + 1;
                        texts.Add("");
                    } else {
                        int ct = colTypes[c];
                        // 整型列直接从线协议按数值解析存 ival，完全免去临时字符串分配与 Convert.ToInt64 开销；
                        // 无符号 BIGINT 超 long 的回绕会改写 GetString，保留文本通道。
                        if ((ct == 1 || ct == 2 || ct == 3 || ct == 9 || ct == 13)
                                || (ct == 8 && (colFlags[c] & 32) == 0)) {
                            cell.kind = 1;
                            cell.ival = MySqlWire.readLenencIntRaw(row, ref p);
                            texts.Add("");
                        } else {
                            string v = MySqlWire.readLenencStrRaw(row, ref p);
                            cell.kind = 2;
                            texts.Add(v);
                        }
                    }
                    cells.Add(cell);
                    c = c + 1;
                }
                result.AddRowCells(cells, texts);
                rowCount = rowCount + 1;
            }
            this.lastAffected = rowCount;
            return result;
        } finally {
            this.ReleaseLock();
        }
    }

    // 执行非查询语句并返回受影响行数。语句失败时
    // 抛出 <see cref="DbException"/>。
    public async int ExecuteAsync(string sql) {
        if (!this.connected) {
            this.lastError = "not connected";
            this.fail();
        }
        DbResult r = await this.QueryAsync(sql);
        if (this.hadError) {
            this.fail();
        }
        return this.lastAffected;
    }

    // 抛出记录的失败，携带服务器自身的错误
    // 号，处理方无需解析错误消息。
    void fail() {
        string why = this.lastError;
        if (why.Length == 0) {
            why = "the statement failed";
        }
        throw new DbException(why, this.lastNumber, DbProvider.MySQL);
    }

    // 第一行第一列以字符串返回（无行时返回 ""
    // ）。
    public async string ExecuteScalarAsync(string sql) {
        DbResult r = await this.QueryAsync(sql);
        if (r.RowCount() > 0) {
            return r.GetString(0, 0);
        }
        return "";
    }

    // 预编译语句（COM_STMT_PREPARE / COM_STMT_EXECUTE）
    // 二进制协议中参数值带外传输，因此
    // 不可能通过参数值注入，也无需转义。占位符为 `?`。
    // 所有参数按 MYSQL_TYPE_VAR_STRING 发送（服务器会转换到
    // 列类型）或 MYSQL_TYPE_NULL；结果行以二进制
    // 行格式返回，并按列类型解码。

    // 在 pos 处写入长度编码整数；返回新的 pos。

    // 以 double 返回 2^e（e 可为负）。

    // 从尾数/指数/符号字段解码 IEEE-754 值。


    // 在游标 cur[0] 处读取给定列类型的一个二进制协议整数值，
    // 读取后推进游标，返回 long（免去格式化成字符串再反解析；无符号 BIGINT 与
    // ReadBinValue 一样按 long 回绕解释）。
    private static long readBinLong(string buf, List<int> cur, int type, int flags) {
        int p = cur[0];
        long v = readBinLongRaw(buf, ref p, type, flags);
        cur[0] = p;
        return v;
    }

    private static long readBinLongRaw(string buf, ref int p, int type, int flags) {
        bool uns = (flags & 32) != 0;
        if (type == 1) {
            int v = buf[p] & 255; p = p + 1;
            if (!uns && v > 127) { v = v - 256; }
            return v;
        }
        if (type == 2 || type == 13) {
            int v = (buf[p]&255) | ((buf[p+1]&255) << 8); p = p + 2;
            if (!uns && v > 32767) { v = v - 65536; }
            return v;
        }
        if (type == 3 || type == 9) {
            long v = (long)(buf[p]&255) | ((long)(buf[p+1]&255)<<8)
                   | ((long)(buf[p+2]&255)<<16) | ((long)(buf[p+3]&255)<<24);
            p = p + 4;
            if (!uns && v > 2147483647) { v = v - 4294967296; }
            return v;
        }
        long w = 0;
        for (int i = 0; i < 8; i = i + 1) { w = w | ((long)(buf[p+i]&255) << (8*i)); }
        p = p + 8;
        return w;
    }

    // 在游标 cur[0] 处读取给定列类型的一个二进制协议值，
    // 读取后推进游标，返回其文本形式。
    public static string ReadBinValue(string buf, List<int> cur, int type, int flags) {
        int p = cur[0];
        string s = ReadBinValueRaw(buf, ref p, type, flags);
        cur[0] = p;
        return s;
    }

    public static string ReadBinValueRaw(string buf, ref int p, int type, int flags) {
        bool uns = (flags & 32) != 0;
        if (type == 1) {
            int v = buf[p] & 255; p = p + 1;
            if (!uns && v > 127) { v = v - 256; }
            return Convert.ToString(v);
        }
        if (type == 2 || type == 13) {
            int v = (buf[p]&255) | ((buf[p+1]&255) << 8); p = p + 2;
            if (!uns && v > 32767) { v = v - 65536; }
            return Convert.ToString(v);
        }
        if (type == 3 || type == 9) {
            long v = (long)(buf[p]&255) | ((long)(buf[p+1]&255)<<8)
                   | ((long)(buf[p+2]&255)<<16) | ((long)(buf[p+3]&255)<<24);
            p = p + 4;
            if (!uns && v > 2147483647) { v = v - 4294967296; }
            return Convert.ToString(v);
        }
        if (type == 8) {
            long v = 0;
            for (int i = 0; i < 8; i = i + 1) { v = v | ((long)(buf[p+i]&255) << (8*i)); }
            p = p + 8;
            return Convert.ToString(v);
        }
        if (type == 4) {  // FLOAT（IEEE binary32）
            long bits = (long)(buf[p]&255) | ((long)(buf[p+1]&255)<<8)
                      | ((long)(buf[p+2]&255)<<16) | ((long)(buf[p+3]&255)<<24);
            p = p + 4;
            return MySqlWire.ieeeToText((int)((bits >> 31) & 1), (int)((bits >> 23) & 255),
                              bits & 8388607, 127, 23);
        }
        if (type == 5) {  // DOUBLE（IEEE binary64）
            long bits = 0; 
            for (int i = 0; i < 8; i = i + 1) { bits = bits | ((long)(buf[p+i]&255) << (8*i)); }
            p = p + 8;
            return MySqlWire.ieeeToText((int)((bits >> 63) & 1), (int)((bits >> 52) & 2047),
                              bits & 4503599627370495, 1023, 52);
        }
        if (type == 10 || type == 12 || type == 7) {  // DATE / DATETIME / TIMESTAMP
            int len = buf[p] & 255; p = p + 1;
            int y = 0; int mo = 0; int d = 0; int h = 0; int mi = 0; int s = 0;
            if (len >= 4) {
                y = (buf[p]&255) | ((buf[p+1]&255)<<8);
                mo = buf[p+2] & 255; d = buf[p+3] & 255;
            }
            if (len >= 7) { h = buf[p+4] & 255; mi = buf[p+5] & 255; s = buf[p+6] & 255; }
            p = p + len;
            string date = Convert.ToString(y) + "-" + MySqlWire.pad2(mo) + "-" + MySqlWire.pad2(d);
            if (type == 10) { return date; }
            return date + " " + MySqlWire.pad2(h) + ":" + MySqlWire.pad2(mi) + ":" + MySqlWire.pad2(s);
        }
        if (type == 11) {  // TIME
            int len = buf[p] & 255; p = p + 1;
            int h = 0; int mi = 0; int s = 0; string sign = "";
            if (len >= 8) {
                if ((buf[p] & 255) == 1) { sign = "-"; }
                int days = (buf[p+1]&255) | ((buf[p+2]&255)<<8) | ((buf[p+3]&255)<<16) | ((buf[p+4]&255)<<24);
                h = (buf[p+5] & 255) + days * 24; mi = buf[p+6] & 255; s = buf[p+7] & 255;
            }
            p = p + len;
            return sign + MySqlWire.pad2(h) + ":" + MySqlWire.pad2(mi) + ":" + MySqlWire.pad2(s);
        }
        // VAR_STRING、STRING、GEOMETRY：长度编码的字节串。
        return MySqlWire.readLenencStrRaw(buf, ref p);
    }

    // 预编译 sql；成功后填写 out[0]=stmtId、out[1]=numCols、
    // out[2]=numParams 并返回 true。跳过 prepare 响应中
    // 的参数/列定义包。
    internal async bool stmtPrepare(string sql, List<int> outIds) {
        int len = sql.Length + 1;
        byte[] pay = new byte[len + 1];
        pay[0] = (byte)(22);  // COM_STMT_PREPARE
        for (int i = 0; i < sql.Length; i = i + 1) { pay[i+1] = (byte)(sql[i] & 255); }
        await this.writePacket(pay, len, 0);
        byte[] r = await this.readPacket();
        if (r == null) { this.lastError = "connection closed"; this.connected = false; return false; }
        int b0 = r[0] & 255;
        if (b0 == 255) {
            int code = (r[1]&255)|((r[2]&255)<<8);
            this.lastError = "prepare err " + Convert.ToString(code) + ": "
                + MySqlWire.bytesToStr(r, 9, this.lastLen - 9);
            return false;
        }
        int stmtId = (r[1]&255) | ((r[2]&255)<<8) | ((r[3]&255)<<16) | ((r[4]&255)<<24);
        int numCols = (r[5]&255) | ((r[6]&255)<<8);
        int numParams = (r[7]&255) | ((r[8]&255)<<8);
        outIds.Add(stmtId); outIds.Add(numCols); outIds.Add(numParams);
        int skip = 0;
        if (numParams > 0) { skip = numParams + 1; }  // 参数定义 + EOF
        if (numCols > 0) { skip = skip + numCols + 1; }  // 列定义 + EOF
        for (int k = 0; k < skip; k = k + 1) {
            byte[] d = await this.readPacket();
            if (d == null) { this.connected = false; return false; }
        }
        return true;
    }

    // 发送带类型化二进制参数的 COM_STMT_EXECUTE：
    // 整数用 LONGLONG，文本/浮点用 VAR_STRING（长度编码，
    // 服务器将文本转换到列类型），NULL 通过 null bitmap 标记。
    internal async int stmtExecute(int stmtId, DbParams prms) {
        int n = prms.Count();
        int bitmapLen = (n + 7) / 8;
        int total = 1 + 4 + 1 + 4;
        if (n > 0) {
            total = total + bitmapLen + 1 + 2 * n;
            for (int i = 0; i < n; i = i + 1) {
                if (prms.KindAt(i) == DbParams.KindInt) { total = total + 8; }
                else if (!prms.IsNull(i)) { total = total + 4 + prms.AsText(i).Length; }
            }
        }
        byte[] pay = new byte[total + 1];
        pay[0] = (byte)(23);  // COM_STMT_EXECUTE
        pay[1] = (byte)(stmtId&255); pay[2] = (byte)((stmtId>>8)&255); pay[3] = (byte)((stmtId>>16)&255); pay[4] = (byte)((stmtId>>24)&255);
        pay[5] = (byte)(0);  // CURSOR_TYPE_NO_CURSOR
        pay[6] = (byte)(1); pay[7] = (byte)(0); pay[8] = (byte)(0); pay[9] = (byte)(0);  // 迭代次数 = 1
        int q = 10;
        if (n > 0) {
            int i = 0;
            for (; i < n; i = i + 1) {
                if (prms.IsNull(i)) {
                    int off = q + i / 8;
                    pay[off] = (byte)((pay[off] & 255) | (1 << (i % 8)));
                }
            }
            q = q + bitmapLen;
            pay[q] = (byte)(1); q = q + 1;  // 新参数绑定标志
            i = 0;
            while (i < n) {
                if (prms.IsNull(i)) { pay[q] = (byte)(6); }  // MYSQL_TYPE_NULL
                else if (prms.KindAt(i) == DbParams.KindInt) { pay[q] = (byte)(8); }  // MYSQL_TYPE_LONGLONG
                else { pay[q] = (byte)(253); }  // MYSQL_TYPE_VAR_STRING
                pay[q+1] = (byte)(0);
                q = q + 2;
                i = i + 1;
            }
            i = 0;
            while (i < n) {
                if (prms.IsNull(i)) { i = i + 1; continue; }
                if (prms.KindAt(i) == DbParams.KindInt) {
                    long v = prms.IntAt(i);
                    for (int j = 0; j < 8; j = j + 1) {
                        pay[q+j] = (byte)((v >> (j * 8)) & 255);
                    }
                    q = q + 8;
                } else {
                    string t = prms.AsText(i);
                    q = MySqlWire.writeLenenc(pay, q, t.Length);
                    for (int j = 0; j < t.Length; j = j + 1) { pay[q+j] = (byte)(t[j] & 255); }
                    q = q + t.Length;
                }
                i = i + 1;
            }
        }
        int rc = await this.writePacket(pay, q, 0);
        return rc;
    }

    // 关闭服务端预编译语句（发完即忘）。
    internal async int stmtClose(int stmtId) {
        byte[] pay = new byte[6];
        pay[0] = (byte)(25);  // COM_STMT_CLOSE
        pay[1] = (byte)(stmtId&255); pay[2] = (byte)((stmtId>>8)&255); pay[3] = (byte)((stmtId>>16)&255); pay[4] = (byte)((stmtId>>24)&255);
        int rc = await this.writePacket(pay, 5, 0);
        return rc;
    }

    // sql 在语句缓存中的索引，找不到则为 -1。
    private int stmtCacheFind(string sql) {
        for (int i = 0; i < this.stmtCache.Count; i = i + 1) {
            if (this.stmtCache[i].sql == sql) { return i; }
        }
        return -1;
    }

    // 缓存预编译语句 id，缓存满时
    // 关闭最旧的条目（每连接 32 条）。
    private async int stmtCacheAdd(string sql, int stmtId) {
        if (this.stmtCache.Count >= 32) {
            await this.stmtClose(this.stmtCache[0].id);
            this.stmtCache.RemoveAt(0);
        }
        this.stmtCache.Add(new PreparedStmt(sql, stmtId));
        return 0;
    }

    // 从缓存中移除一条语句（服务器出错后调用）。
    private void stmtCacheRemove(int stmtId) {
        for (int i = 0; i < this.stmtCache.Count; i = i + 1) {
            if (this.stmtCache[i].id == stmtId) {
                this.stmtCache.RemoveAt(i);
                return;
            }
        }
    }

    // 通过二进制预编译语句协议执行参数化查询
    // （COM_STMT_PREPARE + COM_STMT_EXECUTE）。参数值带外传输，
    // 绝不拼入 SQL 文本。预编译语句按连接缓存，
    // 重复查询可省去 prepare 往返。内部通过 AsyncGate 门控保证单连接事务互斥，杜绝并发调用数据串号。
    public async DbResult QueryParamsAsync(string sql, DbParams prms) {
        await this.AcquireLock();
        try {
            DbResult result = new DbResult();
            this.hadError = false;
            this.lastAffected = 0;
            this.lastError = "";
            if (!this.connected) {
                this.hadError = true;
                this.lastError = "not connected";
                this.fail();
            }
            int stmtId = 0;
            int hit = this.stmtCacheFind(sql);
            if (hit >= 0) {
                stmtId = this.stmtCache[hit].id;
            } else {
                List<int> ids = new List<int>();
                bool ok = await this.stmtPrepare(sql, ids);
                if (!ok) { this.hadError = true; this.fail(); }
                stmtId = ids[0];
                await this.stmtCacheAdd(sql, stmtId);
            }
            await this.stmtExecute(stmtId, prms);
            byte[] first = await this.readPacket();
            if (first == null) {
                this.hadError = true;
                this.lastError = "connection closed";
                this.connected = false;
                this.fail();
            }
            int b0 = first[0] & 255;
            if (b0 == 255) {
                int code = (first[1]&255)|((first[2]&255)<<8);
                this.lastError = "err " + Convert.ToString(code) + ": "
                    + MySqlWire.bytesToStr(first, 9, this.lastLen - 9);
                this.hadError = true;
                this.lastNumber = code;
                this.stmtCacheRemove(stmtId);
                await this.stmtClose(stmtId);
                this.fail();
            }
            if (b0 == 0 || b0 == 254) {
                int p = 1;
                this.lastAffected = (int)MySqlWire.readLenencRaw(first, ref p);
                return result;
            }
            int pcc = 0;
            int ncols = (int)MySqlWire.readLenencRaw(first, ref pcc);
            result.SetColumnCount(ncols);
            List<int> colTypes = new List<int>();
            List<int> colFlags = new List<int>();
            int c = 0;
            for (; c < ncols; c = c + 1) {
                byte[] cd = await this.readPacket();
                int p = 0;
                MySqlWire.readLenencStrRaw(cd, ref p);  // catalog
                MySqlWire.readLenencStrRaw(cd, ref p);  // schema
                MySqlWire.readLenencStrRaw(cd, ref p);  // table
                MySqlWire.readLenencStrRaw(cd, ref p);  // org_table
                result.AddColumnName(MySqlWire.readLenencStrRaw(cd, ref p));  // name
                MySqlWire.readLenencStrRaw(cd, ref p);  // org_name
                MySqlWire.readLenencRaw(cd, ref p);  // 定长字段标记（0x0c）
                int ctype = cd[p + 6] & 255;  // 字符集 2 + 长度 4
                int cflags = (cd[p+7]&255) | ((cd[p+8]&255) << 8);
                colTypes.Add(ctype);
                colFlags.Add(cflags);
            }
            byte[] colEof = await this.readPacket();
            int rowCount = 0;
            while (true) {
                byte[] row = await this.readPacket();
                if (row == null) { break; }
                if (this.isEof(row)) { break; }
                // 二进制行：0x00 头，接着是带 2 位偏移的 null bitmap。
                int bmLen = (ncols + 9) / 8;
                int p = 1 + bmLen;
                List<DbCell> cells = new List<DbCell>();
                List<string> texts = new List<string>();
                c = 0;
                while (c < ncols) {
                    DbCell cell = new DbCell();
                    int bit = c + 2;
                    int nb = row[1 + bit / 8] & 255;
                    if (((nb >> (bit % 8)) & 1) == 1) {
                        texts.Add("");
                    } else {
                        int ct = colTypes[c];
                        if (ct == 1 || ct == 2 || ct == 3 || ct == 8
                                || ct == 9 || ct == 13) {
                            cell.kind = 1;  // 整型直取
                            cell.ival = readBinLongRaw(row, ref p, ct, colFlags[c]);
                            texts.Add("");
                        } else {
                            cell.kind = 2;
                            texts.Add(ReadBinValueRaw(row, ref p, ct, colFlags[c]));
                        }
                    }
                    cells.Add(cell);
                    c = c + 1;
                }
                result.AddRowCells(cells, texts);
                rowCount = rowCount + 1;
            }
            this.lastAffected = rowCount;
            return result;
        } finally {
            this.ReleaseLock();
        }
    }

    // 执行参数化非查询语句；返回受影响行数。
    // 语句失败时抛出 <see cref="DbException"/>，
    // 失败的写入绝不会被误判为「匹配 0 行」。
    public async int ExecuteParamsAsync(string sql, DbParams prms) {
        DbResult r = await this.QueryParamsAsync(sql, prms);
        if (this.hadError) {
            this.fail();
        }
        return this.lastAffected;
    }

    // 参数化标量查询（第一行第一列）。
    public async string ExecuteScalarParamsAsync(string sql, DbParams prms) {
        DbResult r = await this.QueryParamsAsync(sql, prms);
        if (r.RowCount() > 0) {
            return r.GetString(0, 0);
        }
        return "";
    }

    // IDbConnection / IDbExecutor

    // 参数化协程查询的接口形式，
    // 让生成的 ORM 终端在所有驱动上调用同一方法名。
    public async DbResult QueryAsync(string sql, DbParams prms) {
        return await this.QueryParamsAsync(sql, prms);
    }

    // 接口的参数化执行形式，转发 <see cref="ExecuteParamsAsync"/>。
    public async int ExecuteAsync(string sql, DbParams prms) {
        return await this.ExecuteParamsAsync(sql, prms);
    }

    // 接口的参数化标量形式，转发 <see cref="ExecuteScalarParamsAsync"/>。
    public async string ExecuteScalarAsync(string sql, DbParams prms) {
        return await this.ExecuteScalarParamsAsync(sql, prms);
    }

    // MySQL 的事务控制，与其他语句一样在 reactor 上执行
    // 。
    public async bool BeginTransactionAsync() {
        int _n = await this.ExecuteAsync("START TRANSACTION");
        this.inTxn = true;
        return true;
    }

    // 提交当前事务（COMMIT），恒返回 true。
    public async bool CommitAsync() {
        int _n = await this.ExecuteAsync("COMMIT");
        this.inTxn = false;
        return true;
    }

    // 回滚当前事务（ROLLBACK），恒返回 true。
    public async bool RollbackAsync() {
        int _n = await this.ExecuteAsync("ROLLBACK");
        this.inTxn = false;
        return true;
    }

    // 驱动标识，恒为 <see cref="DbProvider.MySQL"/>。
    public int GetProvider() {
        return DbProvider.MySQL;
    }

    // 该契约的同步部分在此无法兑现：此驱动的每一步
    // 都是挂在 IO reactor 上的协程，
    // 非协程代码要等它完成，只能阻塞 reactor 所在的
    // 工作线程 —— 那会造成死锁，而不只是
    // 停顿。因此这里直接抛错而非假装可用，错误信息指明了解决办法：
    // 使用 *Async 终端（ToListAsync / ExecuteAffrowsAsync 等），
    // 或在调用点无法改为协程时，用连接池容纳阻塞驱动（MySqlConnector）
    // 。
    public static DbException Sync() {
        return new DbException(
            "MySqlConnection is asynchronous: call the *Async form"
            + " (QueryAsync / ExecuteAsync / ToListAsync / ExecuteAffrowsAsync)."
            + " Use MySqlConnector's blocking driver for synchronous call sites.",
            0, DbProvider.MySQL);
    }

    // 同步接口不可用：协程化驱动上阻塞等待会死锁（见 <see cref="Sync"/>）。
    public DbResult Query(string sql) { throw MySqlConnection.Sync(); }
    // 同步接口不可用：协程化驱动上阻塞等待会死锁（见 <see cref="Sync"/>）。
    public DbResult Query(string sql, DbParams prms) { throw MySqlConnection.Sync(); }
    // 同步接口不可用：协程化驱动上阻塞等待会死锁（见 <see cref="Sync"/>）。
    public int Execute(string sql) { throw MySqlConnection.Sync(); }
    // 同步接口不可用：协程化驱动上阻塞等待会死锁（见 <see cref="Sync"/>）。
    public int Execute(string sql, DbParams prms) { throw MySqlConnection.Sync(); }
    // 同步接口不可用：协程化驱动上阻塞等待会死锁（见 <see cref="Sync"/>）。
    public string ExecuteScalar(string sql) { throw MySqlConnection.Sync(); }
    // 同步接口不可用：协程化驱动上阻塞等待会死锁（见 <see cref="Sync"/>）。
    public string ExecuteScalar(string sql, DbParams prms) { throw MySqlConnection.Sync(); }
    // 同步接口不可用：协程化驱动上阻塞等待会死锁（见 <see cref="Sync"/>）。
    public void BeginTransaction() { throw MySqlConnection.Sync(); }
    // 同步接口不可用：协程化驱动上阻塞等待会死锁（见 <see cref="Sync"/>）。
    public void Commit() { throw MySqlConnection.Sync(); }
    // 同步接口不可用：协程化驱动上阻塞等待会死锁（见 <see cref="Sync"/>）。
    public void Rollback() { throw MySqlConnection.Sync(); }

    // 此连接上记录的最后一条错误信息。
    public string GetError() {
        return this.lastError;
    }

    // 连接是否已打开。
    public bool IsConnected() {
        return this.connected;
    }

    // 关闭连接。TLS 通道先发 close_notify 再关套接字
    // （TlsStream.Close 不拥有底层 fd）。安全释放互斥门控并唤醒所有等待者。
    public void Close() {
        this.connected = false;
        while (this.waiters != null && this.waiters.Count > 0) {
            AsyncGate g = this.waiters[0];
            this.waiters.RemoveAt(0);
            g.Signal();
        }
        this.busy = false;
        if (this.tls != null) {
            this.tls.Close();
            this.tls = null;
        }
        if (this.sock >= 0) {
            Socket.Close(this.sock);
            this.sock = -1;
        }
        // 服务端语句随连接一起销毁。
        this.stmtCache = new List<PreparedStmt>();
    }

    // 释放连接持有的资源（实现 IDisposable，等同于 Close）。
    public void Dispose() {
        this.Close();
    }

}
