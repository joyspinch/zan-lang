using System;
using System.Collections.Generic;
using System.Data;
using System.Interop;
using System.Net.Sockets;
using System.Net.Tls;
using System.Security.Cryptography;
using System.Threading;

namespace System.Data.MySql;

// 原生协程化 MySQL / MariaDB 客户端（支持明文、TLS 升级与 caching_sha2_password）。
public partial class MySqlConnection : IDbConnection {
    nint sock;
    bool connected;
    string lastError;
    int lastNumber;
    int lastLen;
    public bool inTxn;
    int lastSeq;
    int lastAffected;
    bool hadError;
    List<PreparedStmt> stmtCache;
    TlsStream tls;
    public bool tlsVerify = true;
    bool busy;
    Queue<AsyncGate> waiters;
    byte[] hdrBuf;

    public MySqlConnection() {
        this.sock = -1;
        this.connected = false;
        this.lastError = "";
        this.lastLen = 0;
        this.lastSeq = 0;
        this.lastAffected = 0;
        this.hadError = false;
        this.stmtCache = new List<PreparedStmt>();
        this.tls = null;
        this.hdrBuf = new byte[5];
    }

    private async bool AcquireLock() {
        AsyncGate g = null;
        lock (this) {
            if (!this.busy) {
                this.busy = true;
                return true;
            }
            g = new AsyncGate();
            if (this.waiters == null) { this.waiters = new Queue<AsyncGate>(); }
            this.waiters.Enqueue(g);
        }
        await g.Wait();
        g.Close();
        return true;
    }

    private void ReleaseLock() {
        lock (this) {
            if (this.waiters != null && this.waiters.Count() > 0) {
                AsyncGate g = this.waiters.Dequeue();
                g.Signal();
            } else {
                this.busy = false;
            }
        }
    }

    private async int recvExact(byte[] dst, int off, int need) {
        if (need <= 0) { return 0; }
        if (this.tls != null) {
            int have = 0;
            while (have < need) {
                int read = await this.tls.RecvBytesAsync(dst, off + have, need - have);
                if (read <= 0) { return have; }
                have = have + read;
            }
            return have;
        }
        int got = 0;
        byte[] tmp = null;
        while (got < need) {
            if (off == 0 && got == 0) {
                int n = await Socket.RecvOv(this.sock, dst, need);
                if (n <= 0) { return got; }
                got = got + n;
            } else {
                int remain = need - got;
                if (tmp == null || tmp.Length < remain) { tmp = new byte[remain + 1]; }
                int n = await Socket.RecvOv(this.sock, tmp, remain);
                if (n <= 0) { return got; }
                NativeMemory.Copy((nint)dst + (nint)(off + got), (nint)tmp, n);
                got = got + n;
            }
        }
        return got;
    }

    internal async byte[] readPacket() {
        byte[] hdr = this.hdrBuf;
        if (hdr == null) { hdr = new byte[5]; this.hdrBuf = hdr; }
        byte[] pay = null;
        int totalLen = 0;
        this.lastLen = -1;
        bool complete = false;
        try {
            while (true) {
                int got = await this.recvExact(hdr, 0, 4);
                if (got < 4) { this.lastError = "truncated MySQL packet header"; return null; }
                int len = (hdr[0] & 255) | ((hdr[1] & 255) << 8) | ((hdr[2] & 255) << 16);
                this.lastSeq = hdr[3] & 255;
                int nextLen = MySqlPacketBounds.AppendLength(totalLen, len);
                if (nextLen < 0) {
                    this.lastError = "MySQL message exceeds 64 MiB receive limit";
                    return null;
                }
                if (len > 0) {
                    if (totalLen == 0) {
                        pay = new byte[len + 1];
                    } else {
                        byte[] merged = new byte[nextLen + 1];
                        NativeMemory.Copy((nint)merged, (nint)pay, totalLen);
                        pay = merged;
                    }
                    int body = await this.recvExact(pay, totalLen, len);
                    if (body < len) { this.lastError = "truncated MySQL packet body"; return null; }
                }
                totalLen = nextLen;
                if (len < MySqlPacketBounds.MaxChunkBytes) {
                    this.lastLen = totalLen;
                    complete = true;
                    return pay != null ? pay : new byte[1];
                }
            }
        } finally {
            // 读帧中断则销毁连接，禁止半截帧回到连接池。
            if (!complete) { this.Close(); }
        }
    }

    private async int SendRawPacketBytesAsync(byte[] buf, int totalBytes) {
        if (this.tls != null) {
            return await this.tls.SendBytesAsync(buf, 0, totalBytes);
        }
        return await Socket.SendAsync(this.sock, buf, totalBytes);
    }

    internal async int writePacket(string payload, int len, int seq) {
        if (len < 16777215) {
            byte[] buf = new byte[len + 5];
            buf[0] = (byte)(len & 255);
            buf[1] = (byte)((len >> 8) & 255);
            buf[2] = (byte)((len >> 16) & 255);
            buf[3] = (byte)(seq & 255);
            NativeMemory.PutString((nint)buf + (nint)4, 0, payload, len);
            return await this.SendRawPacketBytesAsync(buf, len + 4);
        }
        int offset = 0;
        int curSeq = seq;
        int sentTotal = 0;
        while (offset < len) {
            int chunkLen = len - offset;
            if (chunkLen > 16777215) { chunkLen = 16777215; }
            byte[] buf = new byte[chunkLen + 5];
            buf[0] = (byte)(chunkLen & 255);
            buf[1] = (byte)((chunkLen >> 8) & 255);
            buf[2] = (byte)((chunkLen >> 16) & 255);
            buf[3] = (byte)(curSeq & 255);
            NativeMemory.PutString((nint)buf + (nint)4, 0, payload.Substring(offset, chunkLen), chunkLen);
            int r = await this.SendRawPacketBytesAsync(buf, chunkLen + 4);
            if (r <= 0) { return r; }
            sentTotal = sentTotal + r;
            offset = offset + chunkLen;
            curSeq = (curSeq + 1) & 255;
        }
        if (len % 16777215 == 0) {
            byte[] term = new byte[4];
            term[3] = (byte)(curSeq & 255);
            int tr = await this.SendRawPacketBytesAsync(term, 4);
            if (tr <= 0) { return tr; }
            sentTotal = sentTotal + tr;
        }
        return sentTotal;
    }

    private bool isEof(byte[] pkt) {
        return (pkt[0] & 255) == 254 && this.lastLen < 9;
    }

    static byte[] scramble41(string pw, string nonce20) {
        byte[] a = Sha256.Hash(pw, pw.Length);
        byte[] b = Sha256.Hash(a, 32);
        byte[] cat = new byte[53];
        NativeMemory.Copy((nint)cat, (nint)b, 32);
        NativeMemory.PutString((nint)cat, 32, nonce20, 20);
        byte[] c = Sha256.Hash(cat, 52);
        byte[] tok = new byte[33];
        for (int i = 0; i < 32; i = i + 1) { tok[i] = (byte)((a[i] ^ c[i]) & 255); }
        return tok;
    }

    static byte[] scrambleNative(string pw, string nonce20) {
        byte[] a = Sha1.Hash(pw, pw.Length);
        byte[] b = Sha1.Hash(a, 20);
        byte[] cat = new byte[41];
        NativeMemory.PutString((nint)cat, 0, nonce20, 20);
        NativeMemory.Copy((nint)cat + 20, (nint)b, 20);
        byte[] c = Sha1.Hash(cat, 40);
        byte[] tok = new byte[21];
        for (int i = 0; i < 20; i = i + 1) { tok[i] = (byte)((a[i] ^ c[i]) & 255); }
        return tok;
    }

    static byte[] authToken(string plugin, string pw, string nonce20, List<int> outLen) {
        if (pw.Length == 0) { outLen[0] = 0; return new byte[1]; }
        if (plugin == "caching_sha2_password") { outLen[0] = 32; return scramble41(pw, nonce20); }
        if (plugin == "mysql_native_password") { outLen[0] = 20; return scrambleNative(pw, nonce20); }
        outLen[0] = -1;
        return null;
    }

    static byte[] pemToDer(string pem, int pemLen, List<int> outLen) {
        int begin = MySqlWire.findSub(pem, pemLen, "-----BEGIN", 10, 0);
        if (begin < 0) { return null; }
        int hb = begin;
        while (hb < pemLen && (pem[hb] & 255) != 10) { hb = hb + 1; }
        hb = hb + 1;
        int end = MySqlWire.findSub(pem, pemLen, "-----END", 8, hb);
        if (end < 0) { end = pemLen; }
        int blen = end - hb;
        byte[] b64 = new byte[blen + 1];
        int o = 0;
        for (int i = 0; i < blen; i = i + 1) {
            int c = pem[hb + i] & 255;
            if (c != 10 && c != 13) { b64[o] = (byte)c; o = o + 1; }
        }
        List<int> dl = new List<int>(); dl.Add(0);
        byte[] der = Base64.Decode(b64.ToStr(0, o), dl);
        outLen[0] = dl[0];
        return der;
    }

    static byte[] fullAuthCipher(string der, int derLen, string obf, int obfLen, string seed, List<int> kOut) {
        List<int> c = new List<int>(); c.Add(0);
        c[0] = c[0] + 1; MySqlWire.readDerLen(der, c);
        c[0] = c[0] + 1; int algLen = MySqlWire.readDerLen(der, c); c[0] = c[0] + algLen;
        c[0] = c[0] + 1; MySqlWire.readDerLen(der, c);
        c[0] = c[0] + 1;
        c[0] = c[0] + 1; MySqlWire.readDerLen(der, c);
        c[0] = c[0] + 1; int nLen = MySqlWire.readDerLen(der, c);
        int origStart = c[0];
        int nStart = origStart;
        int useLen = nLen;
        if ((der[nStart] & 255) == 0) { nStart = nStart + 1; useLen = useLen - 1; }
        c[0] = origStart + nLen;
        c[0] = c[0] + 1; int eLen = MySqlWire.readDerLen(der, c);
        int eStart = c[0];
        byte[] nBuf = new byte[useLen + 1];
        for (int i = 0; i < useLen; i = i + 1) { nBuf[i] = (byte)(der[nStart + i] & 255); }
        byte[] eBuf = new byte[eLen + 1];
        for (int i = 0; i < eLen; i = i + 1) { eBuf[i] = (byte)(der[eStart + i] & 255); }
        byte[] cph = Rsa.EncryptOaep(obf, obfLen, nBuf, useLen, eBuf, eLen, 1, seed);
        kOut[0] = useLen;
        return cph;
    }

    public static async MySqlConnection OpenParamsAsync(string host, int port,
            string database, string user, string password) {
        Socket.Initialize();
        MySqlConnection conn = new MySqlConnection();
        conn.connected = await conn.doConnect(host, port, database, user, password, false, "");
        return conn;
    }

    private static bool defaultVerifyTls = true;
    public static bool verifyTls {
        get { return MySqlConnection.defaultVerifyTls; }
        set { MySqlConnection.defaultVerifyTls = value; }
    }

    public static void SetTlsVerify(bool verify) {
        MySqlConnection.defaultVerifyTls = verify;
    }

    public static async MySqlConnection OpenSecureParamsAsync(string host, int port,
            string database, string user, string password) {
        return await MySqlConnection.OpenSecureParamsAsync(host, port, database, user, password, "");
    }

    public static async MySqlConnection OpenSecureParamsAsync(string host, int port,
            string database, string user, string password, string sslCa) {
        Socket.Initialize();
        MySqlConnection conn = new MySqlConnection();
        conn.connected = await conn.doConnect(host, port, database, user, password, true, sslCa);
        return conn;
    }

    private async bool UpgradeTlsAsync(string host, int caps, string sslCa) {
        byte[] sslreq = new byte[33];
        sslreq[0] = (byte)(caps & 255);
        sslreq[1] = (byte)((caps >> 8) & 255);
        sslreq[2] = (byte)((caps >> 16) & 255);
        sslreq[3] = (byte)((caps >> 24) & 255);
        MySqlPacketBounds.Advertise(sslreq, 4);
        sslreq[8] = (byte)45;
        await this.writePacket(sslreq.ToStr(0, 32), 32, 1);
        TlsContext tlsCtx = TlsContext.CreateClient();
        if (tlsCtx == null) {
            this.lastError = "TLS init failed: " + TlsStream.LastError();
            return false;
        }
        if (!this.tlsVerify || !MySqlConnection.defaultVerifyTls) { tlsCtx.DisableVerify(); }
        if (sslCa.Length > 0 && !tlsCtx.AddTrustedCert(sslCa)) {
            this.lastError = "TLS CA bundle unreadable: " + sslCa;
            return false;
        }
        this.tls = await TlsStream.ConnectAsync(tlsCtx, this.sock, host, 15000);
        if (this.tls == null) {
            this.lastError = "TLS handshake failed: " + TlsStream.LastError();
            return false;
        }
        return true;
    }

    private static byte[] BuildHandshakeResponse(int caps, string db, string user, string plugin,
            byte[] token, int tokenLen, out int respLen) {
        bool hasDb = db.Length > 0;
        int userLen = user.Length;
        respLen = 34 + userLen + tokenLen + plugin.Length + 1 + (hasDb ? db.Length + 1 : 0);
        byte[] resp = new byte[respLen + 1];
        int q = 0;
        resp[q] = (byte)(caps & 255);
        resp[q + 1] = (byte)((caps >> 8) & 255);
        resp[q + 2] = (byte)((caps >> 16) & 255);
        resp[q + 3] = (byte)((caps >> 24) & 255);
        q = q + 4;
        MySqlPacketBounds.Advertise(resp, q);
        q = q + 4;
        resp[q] = (byte)45;
        q = q + 24;
        for (int i = 0; i < userLen; i = i + 1) { resp[q + i] = (byte)(user[i] & 255); }
        q = q + userLen + 1;
        resp[q] = (byte)tokenLen;
        q = q + 1;
        for (int i = 0; i < tokenLen; i = i + 1) { resp[q + i] = (byte)(token[i] & 255); }
        q = q + tokenLen;
        if (hasDb) {
            for (int i = 0; i < db.Length; i = i + 1) { resp[q + i] = (byte)(db[i] & 255); }
            q = q + db.Length + 1;
        }
        for (int i = 0; i < plugin.Length; i = i + 1) { resp[q + i] = (byte)(plugin[i] & 255); }
        return resp;
    }

    private async bool RunAuthLoopAsync(string pw, byte[] nonce) {
        while (true) {
            byte[] r = await this.readPacket();
            if (r == null) { this.lastError = "connection closed during auth"; return false; }
            int b0 = r[0] & 255;
            if (b0 == 0) { return true; }
            if (b0 == 255) {
                int code = (r[1] & 255) | ((r[2] & 255) << 8);
                this.lastError = "auth err " + Convert.ToString(code) + ": "
                    + MySqlWire.bytesToStr(r, 9, this.lastLen - 9);
                return false;
            }
            if (b0 == 1) {
                int more = r[1] & 255;
                if (more == 3) { continue; }
                if (more == 4) {
                    if (this.tls != null) {
                        byte[] pwresp = new byte[pw.Length + 2];
                        for (int i = 0; i < pw.Length; i = i + 1) { pwresp[i] = (byte)(pw[i] & 255); }
                        await this.writePacket(pwresp.ToStr(0, pw.Length + 1), pw.Length + 1, this.lastSeq + 1);
                        continue;
                    }
                    byte[] req = new byte[2];
                    req[0] = 2;
                    await this.writePacket(req, 1, this.lastSeq + 1);
                    byte[] pk = await this.readPacket();
                    if (pk == null) { this.lastError = "no RSA public key from server"; return false; }
                    int pemLen = this.lastLen - 1;
                    byte[] pem = new byte[pemLen + 1];
                    for (int i = 0; i < pemLen; i = i + 1) { pem[i] = (byte)(pk[1 + i] & 255); }
                    List<int> derLen = new List<int>(); derLen.Add(0);
                    byte[] der = pemToDer(pem, pemLen, derLen);
                    if (der == null) { this.lastError = "bad RSA public key PEM"; return false; }
                    int obfLen = pw.Length + 1;
                    byte[] obf = new byte[obfLen + 1];
                    for (int i = 0; i < obfLen; i = i + 1) {
                        obf[i] = (byte)((pw[i] & 255) ^ (nonce[i % 20] & 255));
                    }
                    byte[] seed = RandomNumberGenerator.GetBytes(20);
                    if (seed == null) {
                        this.lastError = "secure RNG unavailable for full-auth";
                        return false;
                    }
                    List<int> kOut = new List<int>(); kOut.Add(0);
                    byte[] cipher = fullAuthCipher(der, derLen[0], obf, obfLen, seed, kOut);
                    await this.writePacket(cipher, kOut[0], this.lastSeq + 1);
                    continue;
                }
                this.lastError = "unexpected auth-more-data " + Convert.ToString(more);
                return false;
            }
            if (b0 == 254) {
                int pluginEnd = 1;
                while (pluginEnd < this.lastLen && (r[pluginEnd] & 255) != 0) { pluginEnd = pluginEnd + 1; }
                string switchPlugin = MySqlWire.bytesToStr(r, 1, pluginEnd - 1);
                int nonceStart = pluginEnd + 1;
                int switchNonceLen = this.lastLen - nonceStart;
                if (switchNonceLen > 20) { switchNonceLen = 20; }
                byte[] switchNonce = new byte[21];
                for (int i = 0; i < switchNonceLen; i = i + 1) {
                    switchNonce[i] = (byte)(r[nonceStart + i] & 255);
                }
                List<int> switchLenOut = new List<int>(); switchLenOut.Add(0);
                byte[] switchToken = authToken(switchPlugin, pw, switchNonce, switchLenOut);
                int switchLen = switchLenOut[0];
                if (switchToken == null || switchLen < 0) {
                    this.lastError = "unsupported auth-switch plugin: " + switchPlugin;
                    return false;
                }
                nonce = switchNonce;
                await this.writePacket(switchToken, switchLen, this.lastSeq + 1);
                continue;
            }
            this.lastError = "unexpected auth packet " + Convert.ToString(b0);
            return false;
        }
        return false;
    }

    internal async bool doConnect(string host, int port, string db, string user, string pw, bool secure, string sslCa) {
        this.sock = Socket.CreateTcp();
        if (this.sock < 0) { this.lastError = "socket create failed"; return false; }
        Socket.SetNonBlocking(this.sock);
        await Socket.ConnectAsync(this.sock, host, port);

        byte[] hs = await this.readPacket();
        if (hs == null) { this.lastError = "no handshake from server"; return false; }
        if ((hs[0] & 255) == 255) {
            int code = (hs[1] & 255) | ((hs[2] & 255) << 8);
            this.lastError = "handshake err " + Convert.ToString(code) + ": "
                + MySqlWire.bytesToStr(hs, 3, this.lastLen - 3);
            return false;
        }
        int p = 1;
        while ((hs[p] & 255) != 0) { p = p + 1; }
        p = p + 5;
        byte[] nonce = new byte[21];
        for (int i = 0; i < 8; i = i + 1) { nonce[i] = (byte)(hs[p + i] & 255); }
        p = p + 9;
        int capLow = (hs[p] & 255) | ((hs[p + 1] & 255) << 8);
        p = p + 5;
        int capHigh = (hs[p] & 255) | ((hs[p + 1] & 255) << 8);
        int serverCaps = capLow | (capHigh << 16);
        p = p + 2;
        int authlen = hs[p] & 255;
        p = p + 11;
        int part2 = authlen - 8;
        if (part2 < 13) { part2 = 13; }
        int copy2 = part2 > 12 ? 12 : part2;
        for (int i = 0; i < copy2; i = i + 1) { nonce[8 + i] = (byte)(hs[p + i] & 255); }
        p = p + part2;
        string plugin = "mysql_native_password";
        if ((serverCaps & 524288) != 0 && p < this.lastLen) {
            int pluginEnd = p;
            while (pluginEnd < this.lastLen && (hs[pluginEnd] & 255) != 0) { pluginEnd = pluginEnd + 1; }
            if (pluginEnd > p) { plugin = MySqlWire.bytesToStr(hs, p, pluginEnd - p); }
        }

        // SSLRequest 与 HandshakeResponse41 须通告一致的能力标志。
        int caps = 1 | 2 | 4 | 512 | 8192 | 32768 | 524288;
        if (db.Length > 0) { caps = caps | 8; }
        if (secure) { caps = caps | 2048; }
        int loginSeq = 1;
        if (secure) {
            if ((serverCaps & 2048) == 0) {
                this.lastError = "server does not support TLS (no CLIENT_SSL)";
                return false;
            }
            if (!await this.UpgradeTlsAsync(host, caps, sslCa)) { return false; }
            loginSeq = 2;
        }
        List<int> tokenLenOut = new List<int>(); tokenLenOut.Add(0);
        byte[] token = authToken(plugin, pw, nonce, tokenLenOut);
        if (token == null || tokenLenOut[0] < 0) {
            this.lastError = "unsupported auth plugin: " + plugin;
            return false;
        }
        int respLen = 0;
        byte[] resp = MySqlConnection.BuildHandshakeResponse(caps, db, user, plugin, token, tokenLenOut[0], out respLen);
        await this.writePacket(resp, respLen, loginSeq);
        return await this.RunAuthLoopAsync(pw, nonce);
    }

    internal async int comQuery(string sql) {
        int len = sql.Length + 1;
        byte[] pay = new byte[len + 1];
        pay[0] = (byte)3;
        for (int i = 0; i < sql.Length; i = i + 1) { pay[i + 1] = (byte)(sql[i] & 255); }
        return await this.writePacket(pay, len, 0);
    }
}
