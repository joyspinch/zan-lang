using System;
using System.Data;
using System.Threading;

namespace System.Data.MySql;

// 面向 <see cref="MySqlConnection"/> 的协程感知连接池。
// 连接按需懒打开，最多 <c>maxSize</c> 条，并在协程间
// 复用。当所有连接都被借出且达到上限时，
// <see cref="AcquireAsync"/> 会让调用协程挂起在事件驱动的
// <see cref="Gate"/> 上（无轮询、无定时器），而非阻塞
// 工作线程；一旦有连接通过 <see cref="Release"/>
// 归还，它便立即恢复。由于打开连接
// 与执行查询都已协程化于 IO reactor 上，
// 整个 获取/查询/释放 周期保持非阻塞。
// 连接池依赖协作式「每调度器单线程」模型：
// 空闲列表只在 await 之间被访问，因此无需加锁。
// 用法：
// pool.Release(db);
// pool.Close();
public class MySqlPool : IDisposable {
    private string host;
    private int port;
    private string database;
    private string user;
    private string password;
    private PoolCore<MySqlConnection> core;

    public MySqlPool(string host, int port, string database, string user,
            string password, int maxSize) {
        this.host = host;
        this.port = port;
        this.database = database;
        this.user = user;
        this.password = password;
        this.core = new PoolCore<MySqlConnection>(maxSize);
    }

    // 新建一条 MySQL 连接（池的建连回调）。
    private async MySqlConnection OpenOne() {
        return await MySqlConnection.OpenParamsAsync(this.host, this.port,
                                                     this.database, this.user,
                                                     this.password);
    }

    // 借出一个连接：复用空闲的，未达上限则新建，
    // 否则挂起协程直到有连接被释放。饱和等待有硬上限
    // （见 <see cref="PoolWait"/>）：超时返回 null——嵌套租借或漏归还
    // 只会退化成个别请求拿不到连接，绝不会把协程永久停在门上。
    // 连接池关闭后返回 null。
    public async MySqlConnection AcquireAsync() {
        PoolOpenAsync<MySqlConnection> open = this.OpenOne;
        Predicate<MySqlConnection> connected = MySqlPool.IsUsable;
        Action<MySqlConnection> close = MySqlPool.CloseConnection;
        PoolOpenFailure<MySqlConnection> failed = MySqlPool.ReportOpenFailure;
        return await this.core.AcquireAsync(open, connected, close, failed);
    }

    static bool IsUsable(MySqlConnection c) { return c.IsConnected(); }
    static void CloseConnection(MySqlConnection c) { c.Close(); }

    static void ReportOpenFailure(MySqlConnection c, Exception error) {
        string why = error != null ? error.Message : (c != null ? c.lastError : "");
        Console.WriteLine("[mysqlpool] connect failed: "
            + (why.Length > 0 ? why : "refused, timeout, or auth rejected"));
    }

    // 将连接归还连接池。损坏的或 Close() 之后的
    // 连接会被关闭丢弃，不再入池。归还时事务未收尾的连接
    // 不直接入池：挂清理协程把残留事务 ROLLBACK 掉后再回池
    // （A535，P2-29 的异步驱动半边；协程由调度器泵动——异步
    // 驱动的使用方必然运行在协程环境里）。
    public void Release(MySqlConnection c) {
        if (c == null) {
            return;
        }
        if (this.core.IsClosed() || !c.IsConnected()) {
            c.Close();
            this.core.Drop(c);
            return;
        }
        if (c.inTxn) {
            Task.Spawn(this.Cleanup(c));
            return;
        }
        if (!this.core.Pool(c)) { c.Close(); }
    }

    // 清理协程体：ROLLBACK 落地后连接才回池；回滚失败连接状态不明，必须关闭丢弃。
    private async bool Cleanup(MySqlConnection c) {
        bool failed = false;
        try {
            await c.RollbackAsync();
        } catch (Exception _ex) {
            failed = true;
        }
        c.inTxn = false;
        if (failed || this.core.IsClosed() || !c.IsConnected()) {
            c.Close();
            this.core.Drop(c);
            return true;
        }
        if (!this.core.Pool(c)) { c.Close(); }
        return true;
    }

    // 空闲（已入池、可直接使用）连接数。
    public int IdleCount() {
        return this.core.IdleCount();
    }

    // 活跃连接总数（空闲 + 已借出）。
    public int LiveCount() {
        return this.core.LiveCount();
    }

    // 关闭所有空闲连接并将连接池标记为已关闭。
    // 仍被借出的连接在归还时关闭。
    public void Close() {
        this.core.MarkClosed();
        MySqlConnection c = this.core.TakeClosing();
        while (c != null) {
            c.Close();
            this.core.Drop(c);
            c = this.core.TakeClosing();
        }
        this.core.WakeAll();
    }

    public void Dispose() {
        this.Close();
    }
}
