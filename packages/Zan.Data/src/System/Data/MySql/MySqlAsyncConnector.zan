using System;
using System.Data;

namespace System.Data.MySql;

// 返回协程化 MySqlConnection 的 IDbConnector，使 MySQL 连接池端到端非阻塞。
// 这些连接只实现 IDbExecutor 的异步部分，请搭配异步 ORM 链使用。
public class MySqlAsyncConnector : IDbConnector {
    public string host;
    public int port;
    public string database;
    public string user;
    public string password;

    public MySqlAsyncConnector(string host, int port, string database, string user,
            string password) {
        this.host = host;
        this.port = port;
        this.database = database;
        this.user = user;
        this.password = password;
    }

    // 基于 host/port/database/user/password 的非阻塞连接池（MySqlDbPool 会在归还前清理未收尾事务）。
    public static DbPool Pool(string host, int port, string database, string user,
            string password, int maxSize) {
        return new MySqlDbPool(
            new MySqlAsyncConnector(host, port, database, user, password),
            maxSize);
    }

    // 在 reactor 上执行握手打开一个协程化连接。
    public async IDbConnection ConnectAsync() {
        return await MySqlConnection.OpenParamsAsync(this.host, this.port,
            this.database, this.user, this.password);
    }

    // 池的 provider id（恒为 DbProvider.MySQL）。
    public int GetProvider() {
        return DbProvider.MySQL;
    }
}
