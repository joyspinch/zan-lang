using System;
using System.Data;

namespace System.Data.MySql;

// 返回协程化
// <see cref="MySqlConnection"/> 的 <see cref="IDbConnector"/>，使 MySQL 连接的 <see cref="DbPool"/>
// 端到端非阻塞：等待空闲连接时
// 挂起（连接池），等待服务器响应同样挂起（驱动）。而
// 使用阻塞驱动时只有前者成立，这会把数据库并发
// 限制在 worker 数量上，无论连接池多大。
// 这些连接只实现
// <see cref="IDbExecutor"/> 的异步部分；同步部分会抛错并指明要用的 *Async
// 终端。因此请将此连接池与异步 ORM 链搭配使用：
// finally { pool.Release(db); }
class MySqlAsyncConnector : IDbConnector {
    string host;
    int port;
    string database;
    string user;
    string password;

    MySqlAsyncConnector(string host, int port, string database, string user,
            string password) {
        this.host = host;
        this.port = port;
        this.database = database;
        this.user = user;
        this.password = password;
    }

    // 基于 host/port/database/user/password 的非阻塞连接池。
    static DbPool Pool(string host, int port, string database, string user,
            string password, int maxSize) {
        return new DbPool(
            new MySqlAsyncConnector(host, port, database, user, password),
            maxSize);
    }

    // 在 reactor 上执行握手打开一个协程化连接。
    async IDbConnection ConnectAsync() {
        return await MySqlConnection.OpenParamsAsync(this.host, this.port,
            this.database, this.user, this.password);
    }

    // 池的 provider id（恒为 <see cref="DbProvider.MySQL"/>）。
    int GetProvider() {
        return DbProvider.MySQL;
    }
}
