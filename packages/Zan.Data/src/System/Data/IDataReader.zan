using System;

namespace System.Data;

// 只进、只读流式数据读取器接口。
// 逐行消费数据，消除整表全量预加载（DbResult）带来的巨大堆分配与 GC 压力。
public interface IDataReader : IDisposable {
    // 读取下一行；若存在下一行返回 true，到达末尾返回 false 并自动释放底层语句。
    bool Read();

    // 异步读取下一行。
    async bool ReadAsync();

    // 获取当前结果集的列数。
    int GetFieldCount();

    // 获取指定序号（0-based）的列名。
    string GetName(int i);

    // 根据列名获取列序号（0-based）；未找到返回 -1。
    int GetOrdinal(string name);

    // 获取指定列的数据类型种类代码（1=Int, 2=Float, 3=Text, 4=Blob, 5=Null）。
    int GetFieldType(int i);

    // 判断指定列是否为 SQL NULL。
    bool IsDBNull(int i);

    // 获取指定列的 32 位整型值。
    int GetInt32(int i);

    // 获取指定列的 64 位长整型值。
    long GetInt64(int i);

    // 获取指定列的双精度浮点数值。
    double GetDouble(int i);

    // 获取指定列的布尔值。
    bool GetBoolean(int i);

    // 获取指定列的托管字符串副本。
    string GetString(int i);

    // 零分配核心原语：直接返回指向驱动底层原生缓冲区的只读 StringView 切片。
    // 0 字节堆分配，0 次内存复制。生命周期仅在当前行有效（下一次 Read 或 Close 失效）。
    StringView GetStringView(int i);

    // 关闭读取器并归还底层语句与连接占用。
    void Close();

    // 释放资源（实现 IDisposable）。
    void Dispose();
}
