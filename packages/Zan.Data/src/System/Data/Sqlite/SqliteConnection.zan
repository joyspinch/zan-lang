using System;
using System.Data;
using System.Data.Orm;

namespace System.Data.Sqlite;

// 原生、无依赖的嵌入式 SQLite 连接（sqlite3 C 库）。
// 在需要零外部配置且只需 SQLite 时，优先选择它而非 ODBC 路径。
// 构建/运行时需要 sqlite3 共享库。
// 用法：
// db.Close();
// 语句失败（语法错、表/列不存在、约束冲突、库被锁超时……）时
// 抛出 <see cref="DbException"/>，携带驱动返回码与
// sqlite3_errmsg 文本；因此空结果集总意味着「无行」。
// 失败不会中断连接，后续语句照常执行。
public class SqliteConnection : IDbConnection {
    // QueryAsync 内联 step 的让出阈值（微秒），见 QueryAsync。
    public static const long InlineSliceUs = 1000;
    public static const long InlineStepUs = 200;

    public nint handle;
    public bool connected;
    // 单语句准备缓存：同一条 SQL 的 prepare 只做一次，之后每次执行
    // reset + 重绑。stmtBusy 记录在途标志——并发的两个协程用同一连接
    // 跑同一条 SQL 时，后来者现场准备一次性语句（与不缓存完全同义），
    // 不碰缓存句柄。多语句文本不入缓存。
    public Dict<string, nint> stmtCache;
    public Dict<string, bool> stmtBusy;

    [DllImport("sqlite3")]
    static extern int sqlite3_open(string filename, string ppDb);

    [DllImport("sqlite3")]
    static extern int sqlite3_close(nint db);

    [DllImport("sqlite3")]
    static extern int sqlite3_exec(nint db, string sql, nint callback, nint arg, string errmsg);

    [DllImport("sqlite3")]
    static extern int sqlite3_prepare_v2(nint db, string sql, int nByte, string ppStmt, string pzTail);

    [DllImport("sqlite3")]
    static extern int sqlite3_step(nint stmt);

    [DllImport("sqlite3")]
    static extern int sqlite3_reset(nint stmt);

    [DllImport("sqlite3")]
    static extern int sqlite3_clear_bindings(nint stmt);

    [DllImport("sqlite3")]
    static extern int sqlite3_finalize(nint stmt);

    [DllImport("sqlite3")]
    static extern int sqlite3_column_count(nint stmt);

    [DllImport("sqlite3")]
    static extern string sqlite3_column_text(nint stmt, int col);

    [DllImport("sqlite3")]
    static extern string sqlite3_column_name(nint stmt, int col);

    [DllImport("sqlite3")]
    static extern int sqlite3_column_type(nint stmt, int col);

    [DllImport("sqlite3")]
    static extern long sqlite3_column_int64(nint stmt, int col);

    [DllImport("sqlite3")]
    static extern string sqlite3_errmsg(nint db);

    [DllImport("sqlite3")]
    static extern int sqlite3_bind_int64(nint stmt, int index, long val);

    [DllImport("sqlite3")]
    static extern int sqlite3_bind_double(nint stmt, int index, double val);

    [DllImport("sqlite3")]
    static extern int sqlite3_bind_text(nint stmt, int index, string val, int nBytes, nint destructor);

    [DllImport("sqlite3")]
    static extern int sqlite3_bind_null(nint stmt, int index);

    [DllImport("sqlite3")]
    static extern int sqlite3_changes(nint db);

    [DllImport("sqlite3")]
    static extern long sqlite3_last_insert_rowid(nint db);

    [DllImport("sqlite3")]
    static extern int sqlite3_busy_timeout(nint db, int ms);

    [DllImport("sqlite3")]
    static extern void sqlite3_free(nint ptr);

    // 一个连接遇到别人持锁时愿意等多久（毫秒，&lt;=0 关闭等待）。
    // SQLite 一个库同一时刻只容一个写者，默认行为是立刻返回 SQLITE_BUSY，
    // 于是并发写在应用层表现为随机失败而不是排队。等待是连接属性、只能在
    // 打开时设置，而池里的连接是惰性打开的、调用方拿不到那一刻，所以由
    // Open 统一设置。
    static int busyTimeoutMs = 5000;

    // 构造；统一经 <see cref="Open"/> 创建。
    public SqliteConnection() {
        this.handle = 0;
        this.connected = false;
        this.stmtCache = new Dict<string, nint>();
        this.stmtBusy = new Dict<string, bool>();
    }

    // 将 sqlite3 库返回的 C 字符串复制为受 ARC 管理、
    // 自有的 Zan 字符串。sqlite3_column_text/_name 返回的指针指向
    // libsqlite3 自己的缓冲区，会被下一次 step()/
    // finalize() 失效；直接保存会使结果集指向
    // 已释放的内存（垃圾行）。与 "" 拼接会分配一份新的
    // 托管副本，而此时源指针仍有效。
    public static string CopyText(string s) {
        if (s == null) { return ""; }
        return "" + s;
    }

    // 从 8 字节缓冲区按小端重组出指针值（sqlite3_open/prepare_v2
    // 的句柄出参经此取回）。
    public static nint HandleFromBuf(string p) {
        if (p == null || p.Length < 8) { return 0; }
        long v = 0;
        v = v + (p[0] & 255);
        v = v + ((long)(p[1] & 255) << 8);
        v = v + ((long)(p[2] & 255) << 16);
        v = v + ((long)(p[3] & 255) << 24);
        v = v + ((long)(p[4] & 255) << 32);
        v = v + ((long)(p[5] & 255) << 40);
        v = v + ((long)(p[6] & 255) << 48);
        v = v + ((long)(p[7] & 255) << 56);
        return (nint)v;
    }

    // 打开（或创建）SQLite 数据库文件。
    // 失败时 sqlite3_open 依然会回填一个句柄（用于取错误信息），
    // 该句柄必须由调用方 close，否则每次失败的打开都会
    // 泄漏一整个 sqlite3 连接对象（约 1.5KB）。数据库不可达时
    // 连接池每个请求都会尝试打开一次，泄漏便随请求线性增长。
    public static SqliteConnection Open(string filename) {
        SqliteConnection conn = new SqliteConnection();
        if (filename == null || filename.Length == 0) {
            return conn;
        }
        for (int i = 0; i < filename.Length; i = i + 1) {
            if ((filename[i] & 255) == 0) { return conn; }
        }
        byte[] ppDb = new byte[8];
        int rc = sqlite3_open(filename, ppDb);
        nint h = HandleFromBuf(ppDb);
        if (rc == 0) {
            conn.handle = h;
            conn.connected = true;
            if (SqliteConnection.busyTimeoutMs > 0) {
                int _bt = sqlite3_busy_timeout(h, SqliteConnection.busyTimeoutMs);
            }
        } else if (h != 0) {
            int _rc = sqlite3_close(h);
        }
        return conn;
    }

    // 将 <paramref name="prms"/> 中的每个参数按其原生类型绑定到
    // 预编译语句，序号从 1 开始。SQLITE_TRANSIENT (-1) 让
    // sqlite3 立即复制文本，这样 Zan 字符串可随时被回收。
    // 返回 0，或首个绑定失败的驱动返回码。
    static int BindAll(nint stmt, DbParams prms) {
        if (prms == null) { return 0; }
        int n = prms.Count();
        for (int i = 0; i < n; i = i + 1) {
            int rc = 0;
            int k = prms.KindAt(i);
            if (k == 1) {
                rc = sqlite3_bind_int64(stmt, i + 1, prms.IntAt(i));
            } else if (k == 2) {
                rc = sqlite3_bind_double(stmt, i + 1, prms.DoubleAt(i));
            } else if (k == 3) {
                string t = prms.TextAt(i);
                if (t == null) {
                    rc = sqlite3_bind_null(stmt, i + 1);
                } else {
                    rc = sqlite3_bind_text(stmt, i + 1, t, t.Length, -1);
                }
            } else {
                rc = sqlite3_bind_null(stmt, i + 1);
            }
            if (rc != 0) { return rc; }
        }
        return 0;
    }

    // 抛出记录的失败：文本来自 sqlite3_errmsg（服务器
    // 自身的说明），错误号是驱动返回码（如 SQLITE_CONSTRAINT）。
    // 空结果从此总意味着「无行」，而不是掩盖了一次失败。
    public void Fail(int rc) {
        string why = "the statement failed";
        if (this.handle != 0) {
            string msg = SqliteConnection.CopyText(sqlite3_errmsg(this.handle));
            if (msg.Length > 0 && msg != "not an error") {
                why = msg;
            }
        }
        throw new DbException(why, rc, DbProvider.SQLite);
    }

    // 执行非查询语句（INSERT/UPDATE/DELETE/DDL）。
    // 失败时抛出 <see cref="DbException"/>。
    int Execute(string sql) {
        if (!this.connected || this.handle == 0) {
            throw new DbException("not connected", 0, DbProvider.SQLite);
        }
        if (sql == null) {
            throw new DbException("sql is null", 0, DbProvider.SQLite);
        }
        byte[] errmsg = new byte[8];
        int rc = sqlite3_exec(this.handle, sql, 0, 0, errmsg);
        if (rc == 0) {
            return sqlite3_changes(this.handle);
        }
        // sqlite3_exec 失败时会 malloc 一条错误消息挂到出参上；
        // 消息本身已能从 sqlite3_errmsg 拿到，这里只需释放，
        // 否则每次失败的执行都泄漏一份。
        nint pMsg = HandleFromBuf(errmsg);
        if (pMsg != 0) { sqlite3_free(pMsg); }
        this.Fail(rc);
        return 0 - 1;
    }

    // 单连接语句缓存上限：覆盖热路径参数化 SQL，同时避免动态 SQL 无限累积导致语句句柄泄漏。
    private static const int MaxStmtCache = 256;

    // 从单连接缓存复用或重新 prepare 一条 SQLite 语句。
    // 空/纯注释 SQL 返回 0（不入缓存）；多语句或已满缓存按一次性语句处理。
    private nint PrepareOrReuseStmt(string sql, out bool cached) {
        cached = false;
        if (sql == null) {
            throw new DbException("sql is null", 0, DbProvider.SQLite);
        }
        nint hit = 0;
        lock (this) {
            if (this.stmtCache != null && this.stmtCache.TryGetValue(sql, out hit)) {
                bool busy = false;
                if (!this.stmtBusy.TryGetValue(sql, out busy) || !busy) {
                    cached = true;
                    this.stmtBusy[sql] = true;
                } else {
                    hit = 0;
                }
            }
        }
        if (cached && hit != 0) {
            sqlite3_reset(hit);
            sqlite3_clear_bindings(hit);
            return hit;
        }
        byte[] ppStmt = new byte[8];
        byte[] pzTail = new byte[8];
        int rc = sqlite3_prepare_v2(this.handle, sql, sql.Length, ppStmt, pzTail);
        nint stmt = HandleFromBuf(ppStmt);
        if (rc != 0) {
            if (stmt != 0) { sqlite3_finalize(stmt); }
            this.Fail(rc);
        }
        if (stmt == 0) { return 0; }
        // pzTail 指向 sql 中未被消耗的首字节（单条语句通常指向 NUL 终止符）；
        // 仅当剩余尾部存在非空白字符（第二条语句）时才视为多语句不缓存。
        nint tailPtr = HandleFromBuf(pzTail);
        bool hasTrailing = false;
        if (tailPtr != 0) {
            long tailOff = (long)(tailPtr - (nint)sql);
            if (tailOff >= 0 && tailOff < (long)sql.Length) {
                for (int ti = (int)tailOff; ti < sql.Length; ti = ti + 1) {
                    if ((sql[ti] & 255) > 32) {
                        hasTrailing = true;
                        break;
                    }
                }
            }
        }
        if (!hasTrailing) {
            lock (this) {
                nint ignore = 0;
                if (this.connected && this.stmtCache != null
                    && this.stmtCache.Count < SqliteConnection.MaxStmtCache
                    && !this.stmtCache.TryGetValue(sql, out ignore)) {
                    this.stmtCache.Add(sql, stmt);
                    this.stmtBusy[sql] = true;
                    cached = true;
                }
            }
        }
        return stmt;
    }

    // 执行带参数的非查询语句。值按原生方式绑定
    // （绝不内联进 SQL 文本），因此无需转义，
    // 也无法通过值进行注入。占位符为 `?`。
    // 失败时抛出 <see cref="DbException"/>。
    int Execute(string sql, DbParams prms) {
        if (!this.connected) {
            throw new DbException("not connected", 0, DbProvider.SQLite);
        }
        bool cached = false;
        nint stmt = this.PrepareOrReuseStmt(sql, out cached);
        if (stmt == 0) { return 0; }
        int step = 0;
        try {
            int brc = BindAll(stmt, prms);
            if (brc != 0) { this.Fail(brc); }
            step = sqlite3_step(stmt);
        } finally {
            this.ReleaseStmt(sql, stmt, cached);
        }
        if (step != 101) {  // SQLITE_DONE = 101
            if (step == 100) {
                throw new DbException(
                    "the statement returned rows; use Query to read them",
                    step, DbProvider.SQLite);
            }
            this.Fail(step);
        }
        return sqlite3_changes(this.handle);
    }

    // 执行查询并返回结果集。
    DbResult Query(string sql) {
        return Query(sql, new DbParams());
    }

    // 执行带参数的查询（`?` 占位符）并返回
    // 结果集。值通过 sqlite3_bind_* 按原生方式绑定。
    // 失败时抛出 <see cref="DbException"/>——包括取行
    // 中途的 step 错误，不再把截短的结果集当成功返回。
    public System.Data.Orm.SelectQuery<T> Query<T>() {
        return new System.Data.Orm.SelectQuery<T>(this, System.Data.Orm.Meta.For<T>());
    }

    DbResult Query(string sql, DbParams prms) {
        if (!this.connected) {
            throw new DbException("not connected", 0, DbProvider.SQLite);
        }
        DbResult result = new DbResult();
        bool cached = false;
        nint stmt = this.PrepareOrReuseStmt(sql, out cached);
        if (stmt == 0) { return result; }
        int step = 0;
        try {
            int brc = BindAll(stmt, prms);
            if (brc != 0) { this.Fail(brc); }

            int colCount = sqlite3_column_count(stmt);
            result.SetColumnCount(colCount);

            int c = 0;
            for (; c < colCount; c = c + 1) {
                result.AddColumnName(CopyText(sqlite3_column_name(stmt, c)));
            }

            step = sqlite3_step(stmt);
            while (step == 100) {  // SQLITE_ROW = 100
                List<DbCell> cells = new List<DbCell>();
                List<string> texts = new List<string>();
                c = 0;
                while (c < colCount) {
                    DbCell cell = new DbCell();
                    int ct = sqlite3_column_type(stmt, c);
                    if (ct == 5) {  // SQLITE_NULL
                        texts.Add("");
                    } else if (ct == 1) {  // SQLITE_INTEGER：类型化直取，免串物化
                        cell.kind = 1;
                        cell.ival = sqlite3_column_int64(stmt, c);
                        texts.Add("");
                    } else {  // TEXT/REAL/BLOB 沿用文本通道
                        texts.Add(CopyText(sqlite3_column_text(stmt, c)));
                        cell.kind = 2;
                    }
                    cells.Add(cell);
                    c = c + 1;
                }
                result.AddRowCells(cells, texts);
                step = sqlite3_step(stmt);
            }
        } finally {
            this.ReleaseStmt(sql, stmt, cached);
        }
        if (step != 101) {  // SQLITE_DONE = 101
            this.Fail(step);
        }
        return result;
    }

    // 执行查询并返回只进流式数据读取器。
    public SqliteDataReader ExecuteReader(string sql) {
        return this.ExecuteReader(sql, new DbParams());
    }

    // 执行带参数的查询并返回只进流式数据读取器。
    public SqliteDataReader ExecuteReader(string sql, DbParams prms) {
        if (!this.connected) {
            throw new DbException("not connected", 0, DbProvider.SQLite);
        }
        bool cached = false;
        nint stmt = this.PrepareOrReuseStmt(sql, out cached);
        if (stmt == 0) {
            return new SqliteDataReader(this, sql, (nint)0, false);
        }
        int brc = BindAll(stmt, prms);
        if (brc != 0) {
            this.ReleaseStmt(sql, stmt, cached);
            this.Fail(brc);
        }
        return new SqliteDataReader(this, sql, stmt, cached);
    }

    // 执行标量查询（第一行第一列）。
    string ExecuteScalar(string sql) {
        DbResult result = Query(sql);
        if (result.RowCount() > 0) {
            return result.GetString(0, 0);
        }
        return "";
    }

    // 执行带参数的标量查询。
    string ExecuteScalar(string sql, DbParams prms) {
        DbResult result = Query(sql, prms);
        if (result.RowCount() > 0) {
            return result.GetString(0, 0);
        }
        return "";
    }

    // 获取最后插入行的 ID。
    long LastInsertId() {
        if (!this.connected || this.handle == 0) { return 0; }
        return sqlite3_last_insert_rowid(this.handle);
    }

    // 获取最后一条错误消息。
    string GetError() {
        if (this.handle == 0) { return ""; }
        return CopyText(sqlite3_errmsg(this.handle));
    }

    // ===== 协程孪生方法 =====
    // <see cref="Query(string)"/> 的协程版本。
    async DbResult QueryAsync(string sql) {
        return await this.QueryAsync(sql, new DbParams());
    }

    // <see cref="Query(string, DbParams)"/> 的协程版本：准备/绑定留在
    // reactor 上，仅 sqlite3_step 跨阻塞卸载边界；失败抛
    async DbResult QueryAsync(string sql, DbParams prms) {
        if (!this.connected) {
            throw new DbException("not connected", 0, DbProvider.SQLite);
        }
        DbResult result = new DbResult();
        bool cached = false;
        nint stmt = this.PrepareOrReuseStmt(sql, out cached);
        if (stmt == 0) { return result; }
        int step = 0;
        try {
            int brc = BindAll(stmt, prms);
            if (brc != 0) { this.Fail(brc); }
            int colCount = sqlite3_column_count(stmt);
            result.SetColumnCount(colCount);
            int c = 0;
            for (; c < colCount; c = c + 1) {
                result.AddColumnName(CopyText(sqlite3_column_name(stmt, c)));
            }

            // 首个 step 卸载到阻塞线程（排序/索引定位等重活通常在这一步）；之后
            // 游标已就位，后续 step 多为微秒级——曾每行都 await 卸载，20 行一页
            // 就是 21 次线程往返。现在后续 step 在协程线程内联执行，按时间片
            // 让出：一片内联累计超过 InlineSliceUs、或单个 step 超过
            // InlineStepUs（如过滤扫描跨大量行），下一个 step 重新卸载。最坏
            // 情况阻塞 reactor 一个 step + 一片。
            step = await sqlite3_step(stmt);
            long sliceStart = Stopwatch.GetMicroseconds();
            bool inline = true;
            while (step == 100) {
                List<DbCell> cells = new List<DbCell>();
                List<string> texts = new List<string>();
                c = 0;
                while (c < colCount) {
                    DbCell cell = new DbCell();
                    int ct = sqlite3_column_type(stmt, c);
                    if (ct == 5) {  // SQLITE_NULL
                        texts.Add("");
                    } else if (ct == 1) {  // SQLITE_INTEGER：类型化直取，免串物化
                        cell.kind = 1;
                        cell.ival = sqlite3_column_int64(stmt, c);
                        texts.Add("");
                    } else {  // TEXT/REAL/BLOB 沿用文本通道
                        texts.Add(CopyText(sqlite3_column_text(stmt, c)));
                        cell.kind = 2;
                    }
                    cells.Add(cell);
                    c = c + 1;
                }
                result.AddRowCells(cells, texts);
                if (inline) {
                    long t0 = Stopwatch.GetMicroseconds();
                    step = sqlite3_step(stmt);
                    long t1 = Stopwatch.GetMicroseconds();
                    if (t1 - t0 > SqliteConnection.InlineStepUs
                        || t1 - sliceStart > SqliteConnection.InlineSliceUs) {
                        inline = false;
                    }
                } else {
                    step = await sqlite3_step(stmt);
                    sliceStart = Stopwatch.GetMicroseconds();
                    inline = true;
                }
            }
        } finally {
            this.ReleaseStmt(sql, stmt, cached);
        }
        if (step != 101) {  // SQLITE_DONE = 101
            this.Fail(step);
        }
        return result;
    }

    // <see cref="ExecuteReader(string)"/> 的协程版本。
    public async SqliteDataReader ExecuteReaderAsync(string sql) {
        return await this.ExecuteReaderAsync(sql, new DbParams());
    }

    // <see cref="ExecuteReader(string, DbParams)"/> 的协程版本。
    public async SqliteDataReader ExecuteReaderAsync(string sql, DbParams prms) {
        return this.ExecuteReader(sql, prms);
    }

    // <see cref="Execute(string)"/> 的协程版本。
    async int ExecuteAsync(string sql) {
        return await this.ExecuteAsync(sql, new DbParams());
    }

    // 协程版多语句执行：按 `pzTail` 逐条 prepare/step，
    // 参数只绑定到第一条语句。失败时抛出
    // <see cref="DbException"/>，停在首条失败的语句上。
    async int ExecuteAsync(string sql, DbParams prms) {
        if (!this.connected || this.handle == 0) {
            throw new DbException("not connected", 0, DbProvider.SQLite);
        }
        if (sql == null) {
            throw new DbException("sql is null", 0, DbProvider.SQLite);
        }
        string remaining = sql;
        int affected = 0;
        bool firstStatement = true;
        byte[] ppStmt = new byte[8];
        byte[] pzTail = new byte[8];
        while (remaining.Length > 0) {
            int rc = sqlite3_prepare_v2(this.handle, remaining, remaining.Length,
                ppStmt, pzTail);
            nint stmt = HandleFromBuf(ppStmt);
            if (rc != 0) {
                if (stmt != 0) { sqlite3_finalize(stmt); }
                this.Fail(rc);
            }
            if (stmt == 0) { break; }  // whitespace/comments after the last statement

            int step = 0;
            try {
                if (firstStatement) {
                    int brc = BindAll(stmt, prms);
                    if (brc != 0) { this.Fail(brc); }
                }
                step = await sqlite3_step(stmt);
            } finally {
                sqlite3_finalize(stmt);
            }
            if (step != 101) {  // SQLITE_DONE = 101
                if (step == 100) {
                    throw new DbException(
                        "the statement returned rows; use Query to read them",
                        step, DbProvider.SQLite);
                }
                this.Fail(step);
            }
            affected = sqlite3_changes(this.handle);
            firstStatement = false;

            nint tail = HandleFromBuf(pzTail);
            long offset = (long)(tail - (nint)remaining);
            if (offset <= 0L || offset >= (long)remaining.Length) { break; }
            remaining = remaining.Substring((int)offset, remaining.Length - (int)offset);
        }
        return affected;
    }

    // <see cref="ExecuteScalar(string)"/> 的协程版本。
    async string ExecuteScalarAsync(string sql) {
        return await this.ExecuteScalarAsync(sql, new DbParams());
    }

    // <see cref="ExecuteScalar(string, DbParams)"/> 的协程版本。
    async string ExecuteScalarAsync(string sql, DbParams prms) {
        DbResult result = await this.QueryAsync(sql, prms);
        if (result.RowCount() > 0) {
            return result.GetString(0, 0);
        }
        return "";
    }

    // 事务在途标志：Begin 置位，Commit/Rollback 复位。池归还时据此
    // 回滚未收尾的事务（P2-29），下一个借出者绝不能落进上一个请求
    // 的未提交状态。
    public bool inTxn;

    // 协程版事务：执行 BEGIN TRANSACTION，恒返回 true。
    async bool BeginTransactionAsync() {
        await this.ExecuteAsync("BEGIN TRANSACTION");
        this.inTxn = true;
        return true;
    }

    // 协程版提交：执行 COMMIT，恒返回 true。
    async bool CommitAsync() {
        await this.ExecuteAsync("COMMIT");
        this.inTxn = false;
        return true;
    }

    // 协程版回滚：执行 ROLLBACK，恒返回 true。
    async bool RollbackAsync() {
        await this.ExecuteAsync("ROLLBACK");
        this.inTxn = false;
        return true;
    }

    // 开始一个事务。
    public void BeginTransaction() { Execute("BEGIN TRANSACTION"); this.inTxn = true; }

    // 提交当前事务。
    public void Commit() { Execute("COMMIT"); this.inTxn = false; }

    // 回滚当前事务。
    public void Rollback() { Execute("ROLLBACK"); this.inTxn = false; }

    // 关闭数据库连接。
    // 单语句执行的收尾：缓存语句 reset 后留待复用并清忙
    // 标志；一次性语句立即 finalize。所有退出路径（绑定失败、step
    // 失败、成功）都必须先走这里再抛错/返回。
    public void ReleaseStmt(string sql, nint stmt, bool cached) {
        if (stmt == 0) { return; }
        if (cached) {
            bool stillCached = false;
            lock (this) {
                nint cur = 0;
                if (this.stmtCache != null && sql != null
                    && this.stmtCache.TryGetValue(sql, out cur) && cur == stmt) {
                    stillCached = true;
                    sqlite3_reset(stmt);
                    this.stmtBusy[sql] = false;
                }
            }
            if (!stillCached) {
                sqlite3_finalize(stmt);
            }
        } else {
            sqlite3_finalize(stmt);
        }
    }

    // 关闭连接：先 finalize 全部缓存语句（否则 sqlite3_close 返回
    // SQLITE_BUSY），再关闭连接句柄。
    public void Close() {
        Dict<string, nint> oldCache = null;
        nint h = 0;
        lock (this) {
            oldCache = this.stmtCache;
            this.stmtCache = new Dict<string, nint>();
            this.stmtBusy = new Dict<string, bool>();
            h = this.handle;
            this.connected = false;
            this.handle = 0;
        }
        // 缓存的语句句柄必须先于连接句柄销毁，否则 sqlite3_close
        // 对未 finalize 的语句返回 SQLITE_BUSY，连接就关不上了。
        if (oldCache != null) {
            foreach (string k in oldCache.Keys) {
                nint cachedStmt = 0;
                if (oldCache.TryGetValue(k, out cachedStmt)
                    && cachedStmt != 0) {
                    sqlite3_finalize(cachedStmt);
                }
            }
        }
        // 同 Postgres：句柄在就释放，不依赖 connected 标志。
        if (h != 0) {
            sqlite3_close(h);
        }
    }

    // 返回连接是否已打开。
    bool IsConnected() { return this.connected; }

    // 释放连接持有的资源（实现 IDisposable，等同于 Close）。
    void Dispose() { this.Close(); }

    // 返回 provider id（DbProvider.SQLite）。
    int GetProvider() { return DbProvider.SQLite; }
}
