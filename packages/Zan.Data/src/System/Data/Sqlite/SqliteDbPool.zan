using System;
using System.Data;

namespace System.Data.Sqlite;

// SQLite 通用连接池（与 SqliteConnector.Pool 配对）：归还时自动回滚残留未收尾事务。
public class SqliteDbPool : DbPool {
    public SqliteDbPool(string filename, int maxSize)
            : base(new SqliteConnector(filename), maxSize) {
    }

    // 归还前先回滚残留事务，异常或断连则直接关闭并剔除。
    public override void Release(IDbConnection c) {
        if (c is SqliteConnection) {
            SqliteConnection sc = (SqliteConnection)c;
            if (sc.inTxn) {
                bool failed = false;
                try { sc.Rollback(); } catch (Exception _ex) { failed = true; }
                sc.inTxn = false;
                if (failed || !sc.IsConnected()) {
                    sc.Close();
                    this.Drop(sc);
                    return;
                }
            }
        }
        base.Release(c);
    }
}
