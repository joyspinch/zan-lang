using System;
using System.Data;
using System.Threading;

namespace System.Data.Sqlite;

// 为 <see cref="SqliteConnection"/> 设计的协程感知连接池。
// SQLite 是嵌入式的基于文件的引擎，没有网络 socket 可等待，
// 因此查询无法在 reactor 意义上"异步"。这个连接池提供的是
// 协程感知的生命周期管理：连接被复用，
// 而不是每次请求都新建/关闭，并发借出的
// 连接数也有上限。当池满时，
// <see cref="AcquireAsync"/> 让调用协程挂起在
// 事件驱动的 <see cref="Gate"/> 上（不轮询），而不是阻塞 worker 线程，
// 所以其他协程可以继续运行，直到有连接通过
// <see cref="Release"/> 归还。
// 该池依赖每个 scheduler 单线程的协作模型：
// free-list 只在 await 点之间被访问，因此无需加锁。
// 用法：
// pool.Release(db);
// pool.Close();
public class SqlitePool : IDisposable {
    string filename;
    PoolCore<SqliteConnection> core;

    public SqlitePool(string filename, int maxSize) {
        this.filename = filename;
        this.core = new PoolCore<SqliteConnection>(maxSize);
    }

    // 打开 SQLite 数据库是本地非阻塞调用；
    // 协程形态让获取连接的过程与网络驱动一致。
    async SqliteConnection OpenOne() {
        return SqliteConnection.Open(this.filename);
    }

    // 借出一个连接：复用空闲连接，未达上限则新建，
    // 否则挂起协程，直到有连接被归还。饱和等待有硬上限
    // （见 <see cref="PoolWait"/>）：超时返回 null，绝不定死。
    // 池已关闭后返回 null。
    public async SqliteConnection AcquireAsync() {
        PoolOpenAsync<SqliteConnection> open = this.OpenOne;
        Predicate<SqliteConnection> connected = SqlitePool.IsUsable;
        Action<SqliteConnection> close = SqlitePool.CloseConnection;
        return await this.core.AcquireAsync(open, connected, close, null);
    }

    static bool IsUsable(SqliteConnection c) { return c.IsConnected(); }
    static void CloseConnection(SqliteConnection c) { c.Close(); }

    // 将连接归还给池。已损坏或 Close() 之后的
    // 连接会被直接关闭丢弃，不再入池。
    public void Release(SqliteConnection c) {
        if (c == null) {
            return;
        }
        if (this.core.IsClosed() || !c.IsConnected()) {
            c.Close();
            this.core.Drop(c);
            return;
        }
        if (c.inTxn) {
            // 归还时事务未收尾：执行回滚；若回滚失败则连接状态不可信，必须关闭丢弃。
            bool failed = false;
            try {
                c.Rollback();
            } catch (Exception _ex) {
                failed = true;
            }
            c.inTxn = false;
            if (failed || this.core.IsClosed() || !c.IsConnected()) {
                c.Close();
                this.core.Drop(c);
                return;
            }
        }
        if (!this.core.Pool(c)) { c.Close(); }
    }

    // 空闲（已入池、可用）连接数。
    public int IdleCount() {
        return this.core.IdleCount();
    }

    // 存活连接总数（空闲 + 已借出）。
    public int LiveCount() {
        return this.core.LiveCount();
    }

    // 关闭所有空闲连接并将池标记为已关闭。
    // 仍借出的连接会在归还时被关闭。
    public void Close() {
        this.core.MarkClosed();
        SqliteConnection c = this.core.TakeClosing();
        while (c != null) {
            c.Close();
            this.core.Drop(c);
            c = this.core.TakeClosing();
        }
        this.core.WakeAll();
    }

    public void Dispose() {
        this.Close();
    }
}

