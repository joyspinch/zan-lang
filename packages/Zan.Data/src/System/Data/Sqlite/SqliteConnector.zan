using System;
using System.Data;

namespace System.Data.Sqlite;

// 内置 SQLite 驱动，见 <see cref="IDbConnector"/>。
// SQLite 是嵌入式数据库：打开数据库、执行语句都是库调用，
// 而非 reactor 上的 IO，因此这里的池化就是连接复用加
// 并发连接数上限，等待通过协程（而非线程）实现。
// 用法：
// pool.Release(db);
// <see cref="SqlitePool"/> 是对应的类型化池，返回的
// <see cref="SqliteConnection"/> 带有 SQLite 专属成员
// （LastInsertId、事务）。
public class SqliteConnector : IDbConnector {
    public string filename;

    public SqliteConnector(string filename) {
        this.filename = filename;
    }

    // 到 <paramref name="filename"/> 的连接池。
    public static DbPool Pool(string filename, int maxSize) {
        return new SqliteDbPool(filename, maxSize);
    }

    // 打开一个新连接。SQLite 是库调用而非 reactor IO：
    // 打开在调用线程同步完成，返回的连接可立即使用。
    public async IDbConnection ConnectAsync() {
        return SqliteConnection.Open(this.filename);
    }

    // 池的 provider id（恒为 <see cref="DbProvider.SQLite"/>）。
    public int GetProvider() {
        return DbProvider.SQLite;
    }
}
