using System;

namespace System.Data;

public class TracedDbConnection : IDbConnection {
    public IDbConnection inner;

    public TracedDbConnection(IDbConnection inner) {
        this.inner = inner;
    }

    // connection).
    public IDbConnection Inner() { return this.inner; }

    public static IDbConnection Wrap(IDbConnection db) {
        if (db == null) { return null; }
        if (!DbTrace.Enabled()) { return db; }
        if (db is TracedDbConnection) { return db; }
        return new TracedDbConnection(db);
    }

    public static IDbConnection Unwrap(IDbConnection db) {
        IDbConnection cur = db;
        while (cur != null && cur is TracedDbConnection) {
            cur = ((TracedDbConnection)cur).Inner();
        }
        return cur;
    }


    public DbResult Query(string sql) {
        long t = DbTrace.NowUs();
        Activity span = DbTrace.BeginSpan(sql);
        DbResult r = this.inner.Query(sql);
        DbTrace.Report(sql, t, span);
        return r;
    }

    public DbResult Query(string sql, DbParams prms) {
        long t = DbTrace.NowUs();
        Activity span = DbTrace.BeginSpan(sql);
        DbResult r = this.inner.Query(sql, prms);
        DbTrace.Report(sql, t, span);
        return r;
    }

    public int Execute(string sql) {
        long t = DbTrace.NowUs();
        Activity span = DbTrace.BeginSpan(sql);
        int n = this.inner.Execute(sql);
        DbTrace.Report(sql, t, span);
        return n;
    }

    public int Execute(string sql, DbParams prms) {
        long t = DbTrace.NowUs();
        Activity span = DbTrace.BeginSpan(sql);
        int n = this.inner.Execute(sql, prms);
        DbTrace.Report(sql, t, span);
        return n;
    }

    public string ExecuteScalar(string sql) {
        long t = DbTrace.NowUs();
        Activity span = DbTrace.BeginSpan(sql);
        string s = this.inner.ExecuteScalar(sql);
        DbTrace.Report(sql, t, span);
        return s;
    }

    public string ExecuteScalar(string sql, DbParams prms) {
        long t = DbTrace.NowUs();
        Activity span = DbTrace.BeginSpan(sql);
        string s = this.inner.ExecuteScalar(sql, prms);
        DbTrace.Report(sql, t, span);
        return s;
    }

    public async DbResult QueryAsync(string sql) {
        long t = DbTrace.NowUs();
        Activity span = DbTrace.BeginSpan(sql);
        DbResult r = await this.inner.QueryAsync(sql);
        DbTrace.Report(sql, t, span);
        return r;
    }

    public async DbResult QueryAsync(string sql, DbParams prms) {
        long t = DbTrace.NowUs();
        Activity span = DbTrace.BeginSpan(sql);
        DbResult r = await this.inner.QueryAsync(sql, prms);
        DbTrace.Report(sql, t, span);
        return r;
    }

    public async int ExecuteAsync(string sql) {
        long t = DbTrace.NowUs();
        Activity span = DbTrace.BeginSpan(sql);
        int n = await this.inner.ExecuteAsync(sql);
        DbTrace.Report(sql, t, span);
        return n;
    }

    public async int ExecuteAsync(string sql, DbParams prms) {
        long t = DbTrace.NowUs();
        Activity span = DbTrace.BeginSpan(sql);
        int n = await this.inner.ExecuteAsync(sql, prms);
        DbTrace.Report(sql, t, span);
        return n;
    }

    public async string ExecuteScalarAsync(string sql) {
        long t = DbTrace.NowUs();
        Activity span = DbTrace.BeginSpan(sql);
        string s = await this.inner.ExecuteScalarAsync(sql);
        DbTrace.Report(sql, t, span);
        return s;
    }

    public async string ExecuteScalarAsync(string sql, DbParams prms) {
        long t = DbTrace.NowUs();
        Activity span = DbTrace.BeginSpan(sql);
        string s = await this.inner.ExecuteScalarAsync(sql, prms);
        DbTrace.Report(sql, t, span);
        return s;
    }


    public int GetProvider() { return this.inner.GetProvider(); }
    public bool IsConnected() { return this.inner.IsConnected(); }
    public void Close() { this.inner.Close(); }
    // 释放连接持有的资源（实现 IDisposable，等同于 Close）。
    public void Dispose() { this.Close(); }
    public void BeginTransaction() { this.inner.BeginTransaction(); }
    public void Commit() { this.inner.Commit(); }
    public void Rollback() { this.inner.Rollback(); }
    public async bool BeginTransactionAsync() { return await this.inner.BeginTransactionAsync(); }
    public async bool CommitAsync() { return await this.inner.CommitAsync(); }
    public async bool RollbackAsync() { return await this.inner.RollbackAsync(); }
}
