using System;

namespace System.Data;

class TracedDbConnection : IDbConnection {
    IDbConnection inner;

    TracedDbConnection(IDbConnection inner) {
        this.inner = inner;
    }

    // connection).
    IDbConnection Inner() { return this.inner; }

    static IDbConnection Wrap(IDbConnection db) {
        if (db == null) { return null; }
        if (!DbTrace.Enabled()) { return db; }
        if (db is TracedDbConnection) { return db; }
        return new TracedDbConnection(db);
    }

    static IDbConnection Unwrap(IDbConnection db) {
        IDbConnection cur = db;
        while (cur != null && cur is TracedDbConnection) {
            cur = ((TracedDbConnection)cur).Inner();
        }
        return cur;
    }


    DbResult Query(string sql) {
        long t = DbTrace.NowUs();
        DbResult r = this.inner.Query(sql);
        DbTrace.Report(sql, t);
        return r;
    }

    DbResult Query(string sql, DbParams prms) {
        long t = DbTrace.NowUs();
        DbResult r = this.inner.Query(sql, prms);
        DbTrace.Report(sql, t);
        return r;
    }

    int Execute(string sql) {
        long t = DbTrace.NowUs();
        int n = this.inner.Execute(sql);
        DbTrace.Report(sql, t);
        return n;
    }

    int Execute(string sql, DbParams prms) {
        long t = DbTrace.NowUs();
        int n = this.inner.Execute(sql, prms);
        DbTrace.Report(sql, t);
        return n;
    }

    string ExecuteScalar(string sql) {
        long t = DbTrace.NowUs();
        string s = this.inner.ExecuteScalar(sql);
        DbTrace.Report(sql, t);
        return s;
    }

    string ExecuteScalar(string sql, DbParams prms) {
        long t = DbTrace.NowUs();
        string s = this.inner.ExecuteScalar(sql, prms);
        DbTrace.Report(sql, t);
        return s;
    }

    async DbResult QueryAsync(string sql) {
        long t = DbTrace.NowUs();
        DbResult r = await this.inner.QueryAsync(sql);
        DbTrace.Report(sql, t);
        return r;
    }

    async DbResult QueryAsync(string sql, DbParams prms) {
        long t = DbTrace.NowUs();
        DbResult r = await this.inner.QueryAsync(sql, prms);
        DbTrace.Report(sql, t);
        return r;
    }

    async int ExecuteAsync(string sql) {
        long t = DbTrace.NowUs();
        int n = await this.inner.ExecuteAsync(sql);
        DbTrace.Report(sql, t);
        return n;
    }

    async int ExecuteAsync(string sql, DbParams prms) {
        long t = DbTrace.NowUs();
        int n = await this.inner.ExecuteAsync(sql, prms);
        DbTrace.Report(sql, t);
        return n;
    }

    async string ExecuteScalarAsync(string sql) {
        long t = DbTrace.NowUs();
        string s = await this.inner.ExecuteScalarAsync(sql);
        DbTrace.Report(sql, t);
        return s;
    }

    async string ExecuteScalarAsync(string sql, DbParams prms) {
        long t = DbTrace.NowUs();
        string s = await this.inner.ExecuteScalarAsync(sql, prms);
        DbTrace.Report(sql, t);
        return s;
    }


    int GetProvider() { return this.inner.GetProvider(); }
    bool IsConnected() { return this.inner.IsConnected(); }
    void Close() { this.inner.Close(); }
    // 释放连接持有的资源（实现 IDisposable，等同于 Close）。
    void Dispose() { this.Close(); }
    void BeginTransaction() { this.inner.BeginTransaction(); }
    void Commit() { this.inner.Commit(); }
    void Rollback() { this.inner.Rollback(); }
    async bool BeginTransactionAsync() { return await this.inner.BeginTransactionAsync(); }
    async bool CommitAsync() { return await this.inner.CommitAsync(); }
    async bool RollbackAsync() { return await this.inner.RollbackAsync(); }
}
