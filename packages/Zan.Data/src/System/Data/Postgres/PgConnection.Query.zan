using System;
using System.Collections.Generic;
using System.Net.Sockets;
using System.Data;

namespace System.Data.Postgres;

public partial class PgConnection : IDbConnection {
    // 打开连接（公开入口）

    // 从 conninfo 字符串打开连接（阻塞）。
    public static PgConnection Open(string conninfo) {
        Socket.Initialize();
        PgConnection conn = new PgConnection();
        if (conn.applyConninfo(conninfo) != 0) { return conn; }
        conn.connected = conn.doConnectSync();
        return conn;
    }

    // 从分散参数打开连接（阻塞）。
    public static PgConnection OpenParams(string host, int port, string database,
            string user, string password) {
        string conninfo = "host=" + host + " port=" + Convert.ToString(port)
            + " dbname=" + database + " user=" + user + " password=" + password;
        return PgConnection.Open(conninfo);
    }

    // 打开连接而不阻塞线程：TCP 连接、SSL 协商、认证、
    // 就绪各步骤都在 IO reactor 上挂起等待。
    public static async PgConnection OpenAsync(string conninfo) {
        Socket.Initialize();
        PgConnection conn = new PgConnection();
        if (conn.applyConninfo(conninfo) != 0) { return conn; }
        conn.connected = await conn.doConnectAsync();
        return conn;
    }

    // 从分散参数异步打开连接。
    public static async PgConnection OpenParamsAsync(string host, int port,
            string database, string user, string password) {
        string conninfo = "host=" + host + " port=" + Convert.ToString(port)
            + " dbname=" + database + " user=" + user + " password=" + password;
        PgConnection conn = await PgConnection.OpenAsync(conninfo);
        return conn;
    }

    // 结果读取（简单与扩展协议共用）

    // 读取一个协议往返的全部后端消息直到 ReadyForQuery，
    // 组装 DbResult（多语句时保留最后一个结果集）。错误记录 lastError 并置 hadError。
    DbResult readResultsSync() {
        DbResult result = new DbResult();
        List<int> colOids = new List<int>();
        this.hadError = false;
        while (true) {
            byte[] pay = this.recvMessageSync();
            if (pay == null) {
                this.connected = false;
                this.hadError = true;
                if (this.lastError.Length == 0) {
                    this.lastError = "connection closed by server";
                }
                return result;
            }
            int t = this.msgType;
            int plen = this.msgLen - 4;
            if (t == 84) {  // 'T' RowDescription
                result = new DbResult();
                colOids = new List<int>();
                PgWire.readRowDescription(result, pay, plen, colOids);
            } else if (t == 68) {  // 'D' DataRow
                PgWire.readDataRow(result, pay, plen, colOids);
            } else if (t == 67) {  // 'C' CommandComplete
                if (plen > 0) {
                    string tag = PgWire.bytesToStr(pay, 0, plen - 1);
                    this.lastAffected = PgWire.parseCommandTag(tag);
                }
            } else if (t == 69) {  // 'E' ErrorResponse
                this.lastError = PgWire.formatError(pay, plen);
                this.hadError = true;
            } else if (t == 90) {  // 'Z' ReadyForQuery
                return result;
            }
            // 'N' 通知、'I' 空查询、'1'/'2'/'n'/'t' 扩展协议应答、
            // 'S'/'K' 会话消息——全部忽略。
        }
    }

    // <see cref="readResultsSync"/> 的协程版。
    async DbResult readResultsAsync() {
        DbResult result = new DbResult();
        List<int> colOids = new List<int>();
        this.hadError = false;
        while (true) {
            byte[] pay = await this.recvMessageAsync();
            if (pay == null) {
                this.connected = false;
                this.hadError = true;
                if (this.lastError.Length == 0) {
                    this.lastError = "connection closed by server";
                }
                return result;
            }
            int t = this.msgType;
            int plen = this.msgLen - 4;
            if (t == 84) {
                result = new DbResult();
                colOids = new List<int>();
                PgWire.readRowDescription(result, pay, plen, colOids);
            } else if (t == 68) {
                PgWire.readDataRow(result, pay, plen, colOids);
            } else if (t == 67) {
                if (plen > 0) {
                    string tag = PgWire.bytesToStr(pay, 0, plen - 1);
                    this.lastAffected = PgWire.parseCommandTag(tag);
                }
            } else if (t == 69) {
                this.lastError = PgWire.formatError(pay, plen);
                this.hadError = true;
            } else if (t == 90) {
                return result;
            }
        }
    }

    // 查询 / 执行（同步）

    // 执行非查询语句；返回受影响行数或 -1（错误详情在
    int Execute(string sql) {
        if (!this.connected) { this.lastError = "not connected"; return -1; }
        this.lastError = "";
        this.lastAffected = 0;
        byte[] b = PgWire.strToBytes(sql, sql.Length);
        if (this.sendMessageSync(81, b, sql.Length + 1) <= 0) {  // 'Q'
            this.connected = false;
            this.lastError = "cannot send the query";
            return -1;
        }
        DbResult r = this.readResultsSync();
        if (this.hadError) { return -1; }
        return this.lastAffected;
    }

    // 执行查询并返回结果集；错误返回空结果
    // （详情在 <see cref="GetError"/>）。
    public DbResult Query(string sql) {
        if (!this.connected) { this.lastError = "not connected"; return new DbResult(); }
        this.lastError = "";
        this.lastAffected = 0;
        byte[] b = PgWire.strToBytes(sql, sql.Length);
        if (this.sendMessageSync(81, b, sql.Length + 1) <= 0) {
            this.connected = false;
            this.lastError = "cannot send the query";
            return new DbResult();
        }
        return this.readResultsSync();
    }

    // 执行标量查询（第一行第一列）。
    public string ExecuteScalar(string sql) {
        DbResult result = this.Query(sql);
        if (result.RowCount() > 0) {
            return result.GetString(0, 0);
        }
        return "";
    }

    // 参数化执行（扩展协议）：Parse/Bind/Describe/Execute/
    // Sync 五连发，值文本格式带外传输，绝不拼入 SQL 文本。
    // 返回受影响行数或 -1。
    public int Execute(string sql, DbParams prms) {
        if (!this.connected) { this.lastError = "not connected"; return -1; }
        this.lastError = "";
        this.lastAffected = 0;
        if (!this.sendExtendedSync(PgWire.ToDollarParams(sql), prms)) {
            return -1;
        }
        this.readResultsSync();
        if (this.hadError) { return -1; }
        return this.lastAffected;
    }

    // 参数化查询（扩展协议）；错误返回空结果。
    public DbResult Query(string sql, DbParams prms) {
        if (!this.connected) { this.lastError = "not connected"; return new DbResult(); }
        this.lastError = "";
        this.lastAffected = 0;
        if (!this.sendExtendedSync(PgWire.ToDollarParams(sql), prms)) {
            return new DbResult();
        }
        return this.readResultsSync();
    }

    // 执行参数化标量查询。
    public string ExecuteScalar(string sql, DbParams prms) {
        DbResult result = this.Query(sql, prms);
        if (result.RowCount() > 0) {
            return result.GetString(0, 0);
        }
        return "";
    }

    // 发送扩展协议五连发（同步）。失败标记连接死亡。
    bool sendExtendedSync(string dollarSql, DbParams prms) {
        // Parse('P')：未命名语句 + $n 形式的 SQL + 0 个显式参数类型
        // （服务器按上下文推断）。
        this.begin(8 + dollarSql.Length);
        this.putCstr("");
        this.putCstr(dollarSql);
        this.put16(0);
        if (this.sendMessageSync(80, this.bb, this.bp) <= 0) { this.die("cannot send Parse"); return false; }
        // Bind('B')：全部参数文本格式。
        List<string> vals = new List<string>();
        int size = 64;
        int n = prms.Count();
        int i = 0;
        for (; i < n; i = i + 1) {
            string t = prms.IsNull(i) ? "" : prms.AsText(i);
            vals.Add(t);
            size = size + t.Length + 4;
        }
        this.begin(size);
        this.putCstr("");  // portal
        this.putCstr("");  // statement
        this.put16(1);  // 1 个参数格式码
        this.put16(0);  // 全部文本格式（0 为文本，1 为二进制，类型为 int16）
        this.put16(n);
        i = 0;
        for (; i < n; i = i + 1) {
            if (prms.IsNull(i)) {
                this.put32(-1);  // NULL：长度 -1，无字节
            } else {
                string t = vals[i];
                this.put32(t.Length);
                if (t.Length > 0) { this.putRaw(t); }
            }
        }
        this.put16(0);  // 结果格式：默认全文本
        if (this.sendMessageSync(66, this.bb, this.bp) <= 0) { this.die("cannot send Bind"); return false; }
        // Describe('D') portal：取 RowDescription（列名/类型）。
        this.begin(4);
        this.put8(80);  // 'P'
        this.putCstr("");
        if (this.sendMessageSync(68, this.bb, this.bp) <= 0) { this.die("cannot send Describe"); return false; }
        // Execute('E')：取全部行。
        this.begin(6);
        this.putCstr("");
        this.put32(0);
        if (this.sendMessageSync(69, this.bb, this.bp) <= 0) { this.die("cannot send Execute"); return false; }
        // Sync('S')：结束本轮。
        if (this.sendMessageSync(83, this.bb, 0) <= 0) { this.die("cannot send Sync"); return false; }
        return true;
    }

    // 连接已死：记因并标记断开。
    void die(string why) {
        this.lastError = why;
        this.connected = false;
    }

    // 查询 / 执行（协程版）

    // 执行查询并返回完整结果集。当服务器返回错误或
    // 会话已断开时抛出 <see cref="DbException"/>，因此空结果总意味着
    // 「无行」；错误信息仍可通过 <see cref="GetError"/> 获取。
    // 内部通过 AsyncGate 门控保证单连接事务互斥，杜绝并发调用数据串号。
    public async DbResult QueryAsync(string sql) {
        await this.AcquireLock();
        try {
            if (!this.connected) {
                this.lastError = "not connected";
                this.fail();
            }
            this.lastError = "";
            this.lastAffected = 0;
            byte[] b = PgWire.strToBytes(sql, sql.Length);
            if (await this.sendMessageAsync(81, b, sql.Length + 1) <= 0) {
                this.connected = false;
                this.lastError = "cannot send the query";
                this.fail();
            }
            DbResult r = await this.readResultsAsync();
            if (this.hadError) { this.fail(); }
            return r;
        } finally {
            this.ReleaseLock();
        }
    }

    // 执行非查询语句并返回受影响行数。语句失败时
    // 抛出 <see cref="DbException"/>。内部通过 AsyncGate 门控保证单连接事务互斥，杜绝并发调用数据串号。
    public async int ExecuteAsync(string sql) {
        await this.AcquireLock();
        try {
            if (!this.connected) {
                this.lastError = "not connected";
                this.fail();
            }
            this.lastError = "";
            this.lastAffected = 0;
            byte[] b = PgWire.strToBytes(sql, sql.Length);
            if (await this.sendMessageAsync(81, b, sql.Length + 1) <= 0) {
                this.connected = false;
                this.lastError = "cannot send the statement";
                this.fail();
            }
            await this.readResultsAsync();
            if (this.hadError) { this.fail(); }
            return this.lastAffected;
        } finally {
            this.ReleaseLock();
        }
    }

    // 异步发送参数化查询（扩展协议）。语句失败时抛出
    // <see cref="DbException"/>。内部通过 AsyncGate 门控保证单连接事务互斥，杜绝并发调用数据串号。
    public async DbResult QueryParamsAsync(string sql, DbParams prms) {
        await this.AcquireLock();
        try {
            if (!this.connected) {
                this.lastError = "not connected";
                this.fail();
            }
            this.lastError = "";
            this.lastAffected = 0;
            if (!await this.sendExtendedAsync(PgWire.ToDollarParams(sql), prms)) {
                this.fail();
            }
            DbResult r = await this.readResultsAsync();
            if (this.hadError) { this.fail(); }
            return r;
        } finally {
            this.ReleaseLock();
        }
    }

    // 异步发送参数化非查询语句并返回受影响行数。
    // 语句失败时抛出 <see cref="DbException"/>。内部通过 AsyncGate 门控保证单连接事务互斥，杜绝并发调用数据串号。
    public async int ExecuteParamsAsync(string sql, DbParams prms) {
        await this.AcquireLock();
        try {
            if (!this.connected) {
                this.lastError = "not connected";
                this.fail();
            }
            this.lastError = "";
            this.lastAffected = 0;
            if (!await this.sendExtendedAsync(PgWire.ToDollarParams(sql), prms)) {
                this.fail();
            }
            await this.readResultsAsync();
            if (this.hadError) { this.fail(); }
            return this.lastAffected;
        } finally {
            this.ReleaseLock();
        }
    }

    // <see cref="sendExtendedSync"/> 的协程版。
    async bool sendExtendedAsync(string dollarSql, DbParams prms) {
        this.begin(8 + dollarSql.Length);
        this.putCstr("");
        this.putCstr(dollarSql);
        this.put16(0);
        if (await this.sendMessageAsync(80, this.bb, this.bp) <= 0) { this.die("cannot send Parse"); return false; }
        List<string> vals = new List<string>();
        int size = 64;
        int n = prms.Count();
        int i = 0;
        for (; i < n; i = i + 1) {
            string t = prms.IsNull(i) ? "" : prms.AsText(i);
            vals.Add(t);
            size = size + t.Length + 4;
        }
        this.begin(size);
        this.putCstr("");
        this.putCstr("");
        this.put16(1);
        this.put16(0);  // 全部文本格式（0 为文本，1 为二进制，类型为 int16）
        this.put16(n);
        i = 0;
        for (; i < n; i = i + 1) {
            if (prms.IsNull(i)) {
                this.put32(-1);  // NULL：长度 -1，无字节
            } else {
                string t = vals[i];
                this.put32(t.Length);
                if (t.Length > 0) { this.putRaw(t); }
            }
        }
        this.put16(0);
        if (await this.sendMessageAsync(66, this.bb, this.bp) <= 0) { this.die("cannot send Bind"); return false; }
        this.begin(4);
        this.put8(80);
        this.putCstr("");
        if (await this.sendMessageAsync(68, this.bb, this.bp) <= 0) { this.die("cannot send Describe"); return false; }
        this.begin(6);
        this.putCstr("");
        this.put32(0);
        if (await this.sendMessageAsync(69, this.bb, this.bp) <= 0) { this.die("cannot send Execute"); return false; }
        if (await this.sendMessageAsync(83, this.bb, 0) <= 0) { this.die("cannot send Sync"); return false; }
        return true;
    }

    // 抛出记录的失败。错误消息来自服务器本身，因此能
    // 原样到达调用方，而不会被空结果或 -1 吞掉。
    void fail() {
        string why = this.lastError;
        if (why.Length == 0) {
            why = "the statement failed";
        }
        throw new DbException(why, 0, DbProvider.PostgreSQL);
    }

    // 获取最后一条错误消息。
    public string GetError() { return this.lastError; }

    // 服务器在 ParameterStatus 里报的版本串（如 "16.4"）与会话
    // 编码；连接未建立时为空。
    public string serverVersion;
    public string clientEncoding;

    // 事务在途标志：Begin 置位，Commit/Rollback 复位。池归还时据此
    // 回滚未收尾的事务（P2-29），下一个借出者绝不能落进上一个请求
    // 的未提交状态。
    public bool inTxn;

    // 开始一个事务（执行 BEGIN）。
    public void BeginTransaction() { this.Execute("BEGIN"); this.inTxn = true; }

    // 提交当前事务。
    public void Commit() { this.Execute("COMMIT"); this.inTxn = false; }

    // 回滚当前事务。
    public void Rollback() { this.Execute("ROLLBACK"); this.inTxn = false; }

    // ===== 协程对应方法 =====
    // 参数化协程历来命名为 QueryParamsAsync / ExecuteParamsAsync；
    // 这些重载让它们采用接口命名，使生成的 ORM 终端节点可以用
    // 统一名称调用。

    // <see cref="QueryParamsAsync"/> 的接口命名别名（IDbExecutor 用）。
    public async DbResult QueryAsync(string sql, DbParams prms) {
        return await this.QueryParamsAsync(sql, prms);
    }

    // <see cref="ExecuteParamsAsync"/> 的接口命名别名。
    public async int ExecuteAsync(string sql, DbParams prms) {
        return await this.ExecuteParamsAsync(sql, prms);
    }

    // <see cref="ExecuteScalar(string)"/> 的协程版本。
    public async string ExecuteScalarAsync(string sql) {
        DbResult r = await this.QueryAsync(sql);
        if (r.RowCount() == 0) { return ""; }
        return r.GetString(0, 0);
    }

    // <see cref="ExecuteScalar(string, DbParams)"/> 的协程版本。
    public async string ExecuteScalarAsync(string sql, DbParams prms) {
        DbResult r = await this.QueryParamsAsync(sql, prms);
        if (r.RowCount() == 0) { return ""; }
        return r.GetString(0, 0);
    }

    // 协程版事务：执行 BEGIN，恒返回 true。
    public async bool BeginTransactionAsync() { int _n = await this.ExecuteAsync("BEGIN"); this.inTxn = true; return true; }
    // 协程版提交：执行 COMMIT，恒返回 true。
    public async bool CommitAsync() { int _n = await this.ExecuteAsync("COMMIT"); this.inTxn = false; return true; }
    // 协程版回滚：执行 ROLLBACK，恒返回 true。
    public async bool RollbackAsync() { int _n = await this.ExecuteAsync("ROLLBACK"); this.inTxn = false; return true; }

    // 关闭数据库连接：尽力发送 Terminate('X')，然后收尾
    // TLS 与套接字。安全释放互斥门控并唤醒所有等待者。同步通道的
    // Terminate 走 TLS 加密；异步 TLS 通道直接关套接字（对端以
    // EOF 收尾，等价干净），因为 Close 无协程上下文可用。
    public void Close() {
        while (this.waiters != null && this.waiters.Count > 0) {
            AsyncGate g = this.waiters[0];
            this.waiters.RemoveAt(0);
            g.Signal();
        }
        this.busy = false;
        if (this.sock >= 0) {
            if (this.connected && this.syncTls != null) {
                this.sendMessageSync(88, this.bb, 0);  // 'X' Terminate
            } else if (this.connected && this.tls == null) {
                byte[] bye = new byte[6];
                bye[0] = 88;  // 'X'
                bye[1] = 0; bye[2] = 0; bye[3] = 0; bye[4] = 4;
                Socket.Send(this.sock, bye, 5);
            }
            if (this.tls != null) {
                this.tls.Close();  // 不拥有底层 fd
                this.tls = null;
            }
            this.syncTls = null;
            Socket.Close(this.sock);
            this.sock = -1;
        }
        this.connected = false;
    }

    // 返回连接是否已打开。
    public bool IsConnected() { return this.connected; }

    // 返回提供程序 ID（DbProvider.PostgreSQL）。
    public int GetProvider() { return DbProvider.PostgreSQL; }

    // 释放连接持有的资源（实现 IDisposable，等同于 Close）。
    public void Dispose() {
        this.Close();
    }

}
