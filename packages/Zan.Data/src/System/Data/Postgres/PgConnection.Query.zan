using System;
using System.Collections.Generic;
using System.Net.Sockets;
using System.Data;

namespace System.Data.Postgres;

public partial class PgConnection : IDbConnection {
    public static PgConnection Open(string conninfo) {
        Socket.Initialize();
        PgConnection conn = new PgConnection();
        if (conn.applyConninfo(conninfo) != 0) { return conn; }
        conn.connected = conn.doConnectSync();
        if (!conn.connected) { conn.Close(); }
        return conn;
    }

    public static PgConnection OpenParams(string host, int port, string database,
            string user, string password) {
        return PgConnection.Open(PgConnector.BuildConninfo(host, port, database, user, password));
    }

    public static async PgConnection OpenAsync(string conninfo) {
        Socket.Initialize();
        PgConnection conn = new PgConnection();
        if (conn.applyConninfo(conninfo) != 0) { return conn; }
        conn.connected = await conn.doConnectAsync();
        if (!conn.connected) { conn.Close(); }
        return conn;
    }

    public static async PgConnection OpenParamsAsync(string host, int port,
            string database, string user, string password) {
        return await PgConnection.OpenAsync(PgConnector.BuildConninfo(host, port, database, user, password));
    }

    void markReadEof() {
        this.connected = false;
        this.hadError = true;
        if (this.lastError.Length == 0) { this.lastError = "connection closed by server"; }
    }

    void applyBackendDataMsg(int t, int plen, byte[] pay, DbResult result, List<int> colOids) {
        if (t == 68) {  // 'D' DataRow
            if (!PgWire.TryReadDataRow(result, pay, plen, colOids)) {
                this.lastError = "malformed or truncated DataRow";
                this.hadError = true;
            }
        } else if (t == 67) {  // 'C' CommandComplete
            if (plen > 0) {
                string tag = PgWire.bytesToStr(pay, 0, plen - 1);
                this.lastCommandTag = tag;
                this.lastAffected = PgWire.parseCommandTag(tag);
            }
        } else if (t == 69) {  // 'E' ErrorResponse
            this.lastError = PgWire.formatError(pay, plen);
            this.hadError = true;
        }
    }

    DbResult readResultsSync() {
        DbResult result = new DbResult();
        List<int> colOids = new List<int>();
        this.hadError = false;
        this.lastCommandTag = "";
        while (true) {
            byte[] pay = this.recvMessageSync();
            if (pay == null) { this.markReadEof(); return result; }
            int t = this.msgType;
            int plen = this.msgLen - 4;
            if (t == 84) {
                result = new DbResult();
                colOids = new List<int>();
                PgWire.readRowDescription(result, pay, plen, colOids);
            } else if (t == 90) {
                if (plen > 0) { this.inTxn = pay[0] != 73; }
                return result;
            } else {
                this.applyBackendDataMsg(t, plen, pay, result, colOids);
            }
        }
    }

    async DbResult readResultsAsync() {
        DbResult result = new DbResult();
        List<int> colOids = new List<int>();
        this.hadError = false;
        this.lastCommandTag = "";
        while (true) {
            byte[] pay = await this.recvMessageAsync();
            if (pay == null) { this.markReadEof(); return result; }
            int t = this.msgType;
            int plen = this.msgLen - 4;
            if (t == 84) {
                result = new DbResult();
                colOids = new List<int>();
                PgWire.readRowDescription(result, pay, plen, colOids);
            } else if (t == 90) {
                if (plen > 0) { this.inTxn = pay[0] != 73; }
                return result;
            } else {
                this.applyBackendDataMsg(t, plen, pay, result, colOids);
            }
        }
    }

    bool sendSimpleQuerySync(string sql) {
        if (sql == null) { this.lastError = "sql is null"; this.hadError = true; return false; }
        if (!this.connected) { this.lastError = "not connected"; return false; }
        this.lastError = "";
        this.lastAffected = 0;
        byte[] b = PgWire.strToBytes(sql, sql.Length);
        if (this.sendMessageSync(81, b, sql.Length + 1) <= 0) {
            this.connected = false;
            this.lastError = "cannot send the query";
            return false;
        }
        return true;
    }

    int Execute(string sql) {
        if (!this.sendSimpleQuerySync(sql)) { return -1; }
        this.readResultsSync();
        return this.hadError ? -1 : this.lastAffected;
    }

    public DbResult Query(string sql) {
        if (!this.sendSimpleQuerySync(sql)) { return new DbResult(); }
        return this.readResultsSync();
    }

    public string ExecuteScalar(string sql) {
        DbResult result = this.Query(sql);
        return result.RowCount() > 0 ? result.GetString(0, 0) : "";
    }

    public int Execute(string sql, DbParams prms) {
        if (sql == null) { this.lastError = "sql is null"; this.hadError = true; return -1; }
        if (!this.connected) { this.lastError = "not connected"; return -1; }
        this.lastError = "";
        this.lastAffected = 0;
        if (!this.sendExtendedSync(PgWire.ToDollarParams(sql), prms)) { return -1; }
        this.readResultsSync();
        return this.hadError ? -1 : this.lastAffected;
    }

    public DbResult Query(string sql, DbParams prms) {
        if (sql == null) { this.lastError = "sql is null"; this.hadError = true; return new DbResult(); }
        if (!this.connected) { this.lastError = "not connected"; return new DbResult(); }
        this.lastError = "";
        this.lastAffected = 0;
        if (!this.sendExtendedSync(PgWire.ToDollarParams(sql), prms)) { return new DbResult(); }
        return this.readResultsSync();
    }

    public string ExecuteScalar(string sql, DbParams prms) {
        DbResult result = this.Query(sql, prms);
        return result.RowCount() > 0 ? result.GetString(0, 0) : "";
    }

    void buildParseFrame(string dollarSql) {
        this.begin(8 + dollarSql.Length);
        this.putCstr("");
        this.putCstr(dollarSql);
        this.put16(0);
    }

    bool buildBindFrame(DbParams prms) {
        List<string> vals = new List<string>();
        long sizeL = 64L;
        int n = prms != null ? prms.Count() : 0;
        if (n > 65535) {
            this.lastError = "too many parameters for PostgreSQL Bind";
            return false;
        }
        for (int i = 0; i < n; i = i + 1) {
            string t = prms.IsNull(i) ? "" : prms.AsText(i);
            vals.Add(t);
            sizeL = sizeL + (long)t.Length + 4L;
            if (sizeL > 2147483600L) {
                this.lastError = "PostgreSQL Bind payload too large";
                return false;
            }
        }
        this.begin((int)sizeL);
        this.putCstr("");
        this.putCstr("");
        this.put16(1);
        this.put16(0);  // 全参数文本格式
        this.put16(n);
        for (int i = 0; i < n; i = i + 1) {
            if (prms.IsNull(i)) {
                this.put32(-1);
            } else {
                string t = vals[i];
                this.put32(t.Length);
                if (t.Length > 0) { this.putRaw(t); }
            }
        }
        this.put16(0);
        return true;
    }

    void buildDescribePortalFrame() {
        this.begin(4);
        this.put8(80);  // 'P'
        this.putCstr("");
    }

    void buildExecuteFrame() {
        this.begin(6);
        this.putCstr("");
        this.put32(0);
    }

    bool sendExtendedSync(string dollarSql, DbParams prms) {
        this.buildParseFrame(dollarSql);
        if (this.sendMessageSync(80, this.bb, this.bp) <= 0) { this.die("cannot send Parse"); return false; }
        if (!this.buildBindFrame(prms)) { return false; }
        if (this.sendMessageSync(66, this.bb, this.bp) <= 0) { this.die("cannot send Bind"); return false; }
        this.buildDescribePortalFrame();
        if (this.sendMessageSync(68, this.bb, this.bp) <= 0) { this.die("cannot send Describe"); return false; }
        this.buildExecuteFrame();
        if (this.sendMessageSync(69, this.bb, this.bp) <= 0) { this.die("cannot send Execute"); return false; }
        if (this.sendMessageSync(83, this.bb, 0) <= 0) { this.die("cannot send Sync"); return false; }
        return true;
    }

    void die(string why) {
        this.lastError = why;
        this.connected = false;
    }

    async DbResult runSimpleAsync(string sql, string sendErr) {
        await this.AcquireLock();
        try {
            if (sql == null) { this.lastError = "sql is null"; this.fail(); }
            if (!this.connected) { this.lastError = "not connected"; this.fail(); }
            this.lastError = "";
            this.lastAffected = 0;
            byte[] b = PgWire.strToBytes(sql, sql.Length);
            if (await this.sendMessageAsync(81, b, sql.Length + 1) <= 0) {
                this.connected = false;
                this.lastError = sendErr;
                this.fail();
            }
            DbResult r = await this.readResultsAsync();
            if (this.hadError) { this.fail(); }
            return r;
        } finally { this.ReleaseLock(); }
    }

    async DbResult runExtendedAsync(string sql, DbParams prms) {
        await this.AcquireLock();
        try {
            if (sql == null) { this.lastError = "sql is null"; this.fail(); }
            if (!this.connected) { this.lastError = "not connected"; this.fail(); }
            this.lastError = "";
            this.lastAffected = 0;
            if (!await this.sendExtendedAsync(PgWire.ToDollarParams(sql), prms)) { this.fail(); }
            DbResult r = await this.readResultsAsync();
            if (this.hadError) { this.fail(); }
            return r;
        } finally { this.ReleaseLock(); }
    }

    public async DbResult QueryAsync(string sql) {
        return await this.runSimpleAsync(sql, "cannot send the query");
    }

    public async int ExecuteAsync(string sql) {
        await this.AcquireLock();
        try {
            if (sql == null) { this.lastError = "sql is null"; this.fail(); }
            if (!this.connected) { this.lastError = "not connected"; this.fail(); }
            this.lastError = "";
            this.lastAffected = 0;
            byte[] b = PgWire.strToBytes(sql, sql.Length);
            if (await this.sendMessageAsync(81, b, sql.Length + 1) <= 0) {
                this.die("cannot send the statement"); this.fail();
            }
            await this.readResultsAsync();
            if (this.hadError) { this.fail(); }
            return this.lastAffected;
        } finally { this.ReleaseLock(); }
    }

    public async DbResult QueryParamsAsync(string sql, DbParams prms) {
        return await this.runExtendedAsync(sql, prms);
    }

    public async int ExecuteParamsAsync(string sql, DbParams prms) {
        await this.AcquireLock();
        try {
            if (sql == null) { this.lastError = "sql is null"; this.fail(); }
            if (!this.connected) { this.lastError = "not connected"; this.fail(); }
            this.lastError = "";
            this.lastAffected = 0;
            if (!await this.sendExtendedAsync(PgWire.ToDollarParams(sql), prms)) { this.fail(); }
            await this.readResultsAsync();
            if (this.hadError) { this.fail(); }
            return this.lastAffected;
        } finally { this.ReleaseLock(); }
    }

    async bool sendExtendedAsync(string dollarSql, DbParams prms) {
        this.buildParseFrame(dollarSql);
        if (await this.sendMessageAsync(80, this.bb, this.bp) <= 0) { this.die("cannot send Parse"); return false; }
        if (!this.buildBindFrame(prms)) { return false; }
        if (await this.sendMessageAsync(66, this.bb, this.bp) <= 0) { this.die("cannot send Bind"); return false; }
        this.buildDescribePortalFrame();
        if (await this.sendMessageAsync(68, this.bb, this.bp) <= 0) { this.die("cannot send Describe"); return false; }
        this.buildExecuteFrame();
        if (await this.sendMessageAsync(69, this.bb, this.bp) <= 0) { this.die("cannot send Execute"); return false; }
        if (await this.sendMessageAsync(83, this.bb, 0) <= 0) { this.die("cannot send Sync"); return false; }
        return true;
    }

    void fail() {
        string why = this.lastError.Length > 0 ? this.lastError : "the statement failed";
        throw new DbException(why, 0, DbProvider.PostgreSQL);
    }

    public string GetError() { return this.lastError; }

    public string serverVersion;
    public string clientEncoding;
    // 池归还时据此回滚未收尾事务（P2-29），防止未提交状态泄漏给下一借出者。
    public bool inTxn;
    string lastCommandTag;

    void CheckTransactionTag(string expected) {
        if (this.lastCommandTag != expected) {
            this.lastError = "Expected " + expected + " but server completed " + this.lastCommandTag;
            this.fail();
        }
    }

    void TransactionCommand(string sql) {
        if (this.Execute(sql) < 0) { this.fail(); }
        this.CheckTransactionTag(sql);
    }

    // 必须在锁内校验完成标签：已中止事务下的 COMMIT 在线协议上会返回成功但 tag 为 ROLLBACK。
    async bool TransactionCommandAsync(string sql) {
        await this.AcquireLock();
        try {
            if (!this.connected) { this.lastError = "not connected"; this.fail(); }
            this.lastError = "";
            this.lastAffected = 0;
            byte[] b = PgWire.strToBytes(sql, sql.Length);
            if (await this.sendMessageAsync(81, b, sql.Length + 1) <= 0) {
                this.die("cannot send transaction command"); this.fail();
            }
            await this.readResultsAsync();
            if (this.hadError) { this.fail(); }
            this.CheckTransactionTag(sql);
            return true;
        } finally { this.ReleaseLock(); }
    }

    public void BeginTransaction() { this.TransactionCommand("BEGIN"); }
    public void Commit() { this.TransactionCommand("COMMIT"); }
    public void Rollback() { this.TransactionCommand("ROLLBACK"); }

    public async DbResult QueryAsync(string sql, DbParams prms) { return await this.QueryParamsAsync(sql, prms); }
    public async int ExecuteAsync(string sql, DbParams prms) { return await this.ExecuteParamsAsync(sql, prms); }

    public async string ExecuteScalarAsync(string sql) {
        DbResult r = await this.QueryAsync(sql);
        return r.RowCount() == 0 ? "" : r.GetString(0, 0);
    }

    public async string ExecuteScalarAsync(string sql, DbParams prms) {
        DbResult r = await this.QueryParamsAsync(sql, prms);
        return r.RowCount() == 0 ? "" : r.GetString(0, 0);
    }

    public async bool BeginTransactionAsync() { return await this.TransactionCommandAsync("BEGIN"); }
    public async bool CommitAsync() { return await this.TransactionCommandAsync("COMMIT"); }
    public async bool RollbackAsync() { return await this.TransactionCommandAsync("ROLLBACK"); }

    // 同步 TLS 发送 Terminate('X')；异步 TLS 直接关套接字由对端以 EOF 收尾。
    // 不在 Close() 中清空 busy 或群发唤醒等待者，防止活跃持锁者仍在临界区时并发重入。
    public void Close() {
        bool wasConnected = this.connected;
        this.connected = false;
        nint s = this.sock;
        TlsStream t = this.tls;
        TlsEngine st = this.syncTls;
        this.tls = null;
        this.syncTls = null;
        if (s >= 0) {
            try {
                if (wasConnected && st != null) {
                    this.syncTls = st;
                    try { this.sendMessageSync(88, this.bb, 0); } catch (Exception _ex) { }
                    this.syncTls = null;
                } else if (wasConnected && t == null) {
                    byte[] bye = new byte[6];
                    bye[0] = 88;
                    bye[1] = 0; bye[2] = 0; bye[3] = 0; bye[4] = 4;
                    Socket.Send(s, bye, 5);
                }
                if (t != null) {
                    t.Close();  // 不拥有底层 fd
                }
            } finally {
                this.sock = -1;
                Socket.Close(s);
            }
        }
    }

    public bool IsConnected() { return this.connected; }
    public int GetProvider() { return DbProvider.PostgreSQL; }
    public void Dispose() { this.Close(); }
}
