using System;
using System.Data;
using System.Threading;

namespace System.Data.Postgres;

// 面向 <see cref="PgConnection"/> 的协程化连接池。
// 契约与 <see cref="DbPool"/> 相同——惰性增长至 <c>maxSize</c>，
// 用事件驱动 <see cref="Gate"/> 等待而非轮询，驱逐失效
// 连接——但它是类型化的，协程查询 API（<c>QueryAsync</c>、
// <c>ExecuteAsync</c>、<c>QueryParamsAsync</c>）仍然可用。连接
// 使用纯 Zan 异步网络握手建立，因此无论扩容
// 连接池还是查询都不会阻塞工作线程。
// 用法：
// pool.Release(db);
// pool.Close();
public class PgPool : IDisposable {
    string conninfo;
    PoolCore<PgConnection> core;

    public PgPool(string conninfo, int maxSize) {
        this.conninfo = conninfo;
        this.core = new PoolCore<PgConnection>(maxSize);
    }

    // 以主机/端口/库/用户/密码构造连接池（内部拼成 conninfo）。
    public PgPool(string host, int port, string database, string user,
            string password, int maxSize) : this(
                "host=" + host + " port=" + Convert.ToString(port)
                + " dbname=" + database + " user=" + user
                + " password=" + password, maxSize) {
    }

    // 新建一条物理连接（池扩容时由 AcquireAsync 调用）；失败返回 null。
    async PgConnection OpenOne() {
        return await PgConnection.OpenAsync(this.conninfo);
    }

    // 借出连接：优先复用空闲连接，
    // 未达上限则新建，否则挂起协程直到有连接被归还。饱和等待有
    // 硬上限（见 <see cref="PoolWait"/>）：超时返回 null，绝不定死。
    // 连接池关闭后返回 null。
    public async PgConnection AcquireAsync() {
        PoolOpenAsync<PgConnection> open = this.OpenOne;
        Predicate<PgConnection> connected = PgPool.IsUsable;
        Action<PgConnection> close = PgPool.CloseConnection;
        PoolOpenFailure<PgConnection> failed = PgPool.ReportOpenFailure;
        return await this.core.AcquireAsync(open, connected, close, failed);
    }

    static bool IsUsable(PgConnection c) { return c.IsConnected(); }
    static void CloseConnection(PgConnection c) { c.Close(); }

    static void ReportOpenFailure(PgConnection c, Exception error) {
        string why = error != null ? error.Message : (c != null ? c.lastError : "");
        Console.WriteLine("[pgpool] connect failed: "
            + (why.Length > 0 ? why : "refused, timeout, or auth rejected"));
    }

    // 将连接归还连接池。已损坏或 Close() 之后的
    // 连接会被关闭销毁而不入池。
    public void Release(PgConnection c) {
        if (c == null) {
            return;
        }
        if (this.core.IsClosed() || !c.IsConnected()) {
            c.Close();
            this.core.Drop(c);
            return;
        }
        if (c.inTxn) {
            // 归还时事务未收尾：执行回滚；若回滚失败则连接状态不可信，必须关闭丢弃。
            bool failed = false;
            try {
                c.Rollback();
            } catch (Exception _ex) {
                failed = true;
            }
            c.inTxn = false;
            if (failed || this.core.IsClosed() || !c.IsConnected()) {
                c.Close();
                this.core.Drop(c);
                return;
            }
        }
        if (!this.core.Pool(c)) { c.Close(); }
    }

    // 空闲（已入池、立即可用）连接数。
    public int IdleCount() {
        return this.core.IdleCount();
    }

    // 存活连接总数（空闲 + 借出）。
    public int LiveCount() {
        return this.core.LiveCount();
    }

    // 当前停泊等待连接的协程数。
    public int WaitingCount() {
        return this.core.WaitingCount();
    }

    // 关闭所有空闲连接并标记连接池已关闭。仍
    // 被借出的连接在归还时关闭。
    public void Close() {
        this.core.MarkClosed();
        PgConnection c = this.core.TakeClosing();
        while (c != null) {
            c.Close();
            this.core.Drop(c);
            c = this.core.TakeClosing();
        }
        this.core.WakeAll();
    }

    public void Dispose() {
        this.Close();
    }
}

