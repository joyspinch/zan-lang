using System;
using System.Data;

namespace System.Data.Postgres;

// <see cref="IDbConnector"/> 的原生 PostgreSQL 驱动实现。
// 使用非阻塞握手建立连接（<c>PQconnectStart</c> 由
// IO reactor 驱动），因此扩容连接池从不阻塞工作线程。
// 用法：
// DbResult r = db.Query("SELECT 1");
// pool.Release(db);
// <see cref="PgPool"/> 是对应的类型化连接池；当查询
// 本身需要以协程方式运行时使用（<c>QueryAsync</c>/<c>ExecuteAsync</c>）。
public class PgConnector : IDbConnector {
    string conninfo;

    public PgConnector(string conninfo) {
        this.conninfo = conninfo;
    }

    // 基于 host/port/database/user/password 的连接器。
    public static PgConnector CreateParams(string host, int port, string database,
            string user, string password) {
        return new PgConnector(PgConnector.BuildConninfo(host, port, database,
                                                         user, password));
    }

    // 基于标准 conninfo 连接字符串的连接池。
    public static DbPool Pool(string conninfo, int maxSize) {
        return new PgDbPool(conninfo, maxSize);
    }

    // 基于 host/port/database/user/password 的连接池。
    public static DbPool Pool(string host, int port, string database, string user,
            string password, int maxSize) {
        return new PgDbPool(
            PgConnector.BuildConninfo(host, port, database, user, password),
            maxSize);
    }

    // 把 host/port/database/user/password 拼成标准 conninfo 字符串。
    public static string BuildConninfo(string host, int port, string database,
            string user, string password) {
        return "host=" + host + " port=" + Convert.ToString(port)
             + " dbname=" + database + " user=" + user
             + " password=" + password;
    }

    // 执行非阻塞握手打开一个新连接（由 IO reactor 驱动）。
    public async IDbConnection ConnectAsync() {
        return await PgConnection.OpenAsync(this.conninfo);
    }

    // 池的 provider id（恒为 <see cref="DbProvider.PostgreSQL"/>）。
    public int GetProvider() {
        return DbProvider.PostgreSQL;
    }
}
