using System;
using System.Data;
using System.Net.Sockets;
using System.Net.Tls;
using System.Text;
using System.Threading;

namespace System.Data.Postgres;

/// <summary>
/// 纯 Zan 的 PostgreSQL 客户端，直接用 Zan 套接字讲 PG wire protocol v3
/// —— 不依赖 libpq、OpenSSL 或任何原生数据库 DLL（同样适用于
/// PG wire 兼容引擎：openGauss / GaussDB, KingbaseES 人大金仓,
/// Vastbase and QuestDB）。libpq 全套（libpq/libcrypto/libssl/krb5/
/// libintl/libiconv）由此退役，静态发布不再需要任何目标机的
/// OpenSSL 存档。
/// 协议能力：
/// - SSLRequest → 'S' → 通道整体升级 TLS（sslmode=prefer/require；
/// prefer 回退明文，require 不支持即失败——绝不静默降级）。
/// 异步路径走 TlsStream.ConnectAsync；同步路径直接驱动
/// TlsEngine 分步泵（与 SqlServer 驱动的带内升级同一招法）。
/// - 认证：SCRAM-SHA-256（PG 10+ 默认；纯 Zan 的 PBKDF2-HMAC-
/// SHA256/HMAC/SHA256，RFC 5802 含服务器签名校验）、MD5、
/// 明文。GSSAPI/SSPI/Kerberos 显式报不支持。
/// - 查询：简单协议（Q）与扩展协议（Parse/Bind/Describe/Execute/
/// Sync）；`?` 占位符改写为 $1..$n，参数文本格式带外传输。
/// 用法：
/// PgConnection db = PgConnection.Open(
/// 数据库连接池与实体映射状态同步契约。
/// 数据库连接池与实体映射状态同步契约。
/// 核心契约与语义定义。
/// db.Close();
/// 参数化（推荐做法——值从不进入 SQL 文本；`?` 占位符会转换为
/// $1..$n 形式）：
/// 数据库连接池与实体映射状态同步契约。
/// 数据库连接池与实体映射状态同步契约。
/// 核心契约与语义定义。
/// conninfo 支持 libpq 关键字/值格式：host、port、dbname、user、
/// 数据库连接池与实体映射状态同步契约。
/// 按 require 处理且证书校验恒开）、connect_timeout（秒，异步连接
/// 生效）、sslrootcert（PEM；非 Windows 客户端 TLS 必须提供或经
/// <see cref="SetTlsVerify"/> 关校验——与 HttpClient/MySql 同一约束）。
/// </summary>
class PgConnection : IDbConnection {
    nint sock;
    TlsStream tls;  // 非空 = 异步通道已加密
    TlsEngine syncTls;  // 非空 = 同步通道已加密（直接驱动引擎）
    byte[] tlsIn;  // 同步 TLS 的密文读缓冲
    bool connected;
    string lastError;
    int lastAffected;
    bool hadError;  // 最近一次语句是否失败
    int msgType;  // 最近读到的服务端消息类型字节
    int msgLen;  // 最近读到的消息总长（含 4 字节长度域）
    // conninfo 解析产物
    string host;
    int port;
    string database;
    string user;
    string password;
    int sslMode;  // 0=disable 1=prefer 2=require
    string sslRootCert;
    int connectTimeout;  // 秒（异步连接生效；0 = 默认）
    int backendPid;  // BackendKeyData，取消请求备用
    int backendSecret;
    // 消息构造器（单连接内串行使用）
    byte[] bb;
    int bp;
    bool busy;
    List<AsyncGate> waiters;

    async bool AcquireLock() {
        while (this.busy) {
            AsyncGate g = new AsyncGate();
            if (this.waiters == null) { this.waiters = new List<AsyncGate>(); }
            this.waiters.Add(g);
            await g.Wait();
            g.Close();
        }
        this.busy = true;
        return true;
    }

    void ReleaseLock() {
        this.busy = false;
        if (this.waiters != null && this.waiters.Count > 0) {
            AsyncGate g = this.waiters[0];
            this.waiters.RemoveAt(0);
            g.Signal();
        }
    }

    // TLS 校验开关：默认开启——证书链与主机名都验。自签/测试服务器
    // 可经 SetTlsVerify(false) 放宽（只加密不校验），与 HttpClient 的
    // verifyTls 开关同一语义；非 Windows 无系统信任根，须配
    // sslrootcert 或关校验。
    static bool verifyTls = true;

    /// <summary>切换后续 Open/OpenAsync 的证书与主机名校验。
    /// 仅测试/开发自签场景关闭；生产保持默认开启。</summary>
    static void SetTlsVerify(bool verify) {
        PgConnection.verifyTls = verify;
    }

    /// 私有构造；统一经 <see cref="Open"/>/<see cref="OpenAsync"/> 创建。
    PgConnection() {
        this.sock = -1;
        this.tls = null;
        this.syncTls = null;
        this.tlsIn = null;
        this.connected = false;
        this.lastError = "";
        this.lastAffected = 0;
        this.hadError = false;
        this.msgType = 0;
        this.msgLen = 0;
        this.host = "localhost";
        this.port = 5432;
        this.database = "";
        this.user = "";
        this.password = "";
        this.sslMode = 1;  // prefer，与 libpq 默认一致
        this.sslRootCert = "";
        this.connectTimeout = 0;
        this.backendPid = 0;
        this.backendSecret = 0;
        this.bb = null;
        this.bp = 0;
    }

    // 消息构造器

    /// 准备容量为 cap 字节的新构造缓冲。
    void begin(int cap) {
        this.bb = new byte[cap + 1];
        this.bp = 0;
    }

    void put8(int v) {
        this.bb[this.bp] = (byte)(v & 255);
        this.bp = this.bp + 1;
    }

    /// 大端 int32（消息长度域、认证子码、参数长度）。
    void put32(int v) {
        this.put8(v >> 24);
        this.put8(v >> 16);
        this.put8(v >> 8);
        this.put8(v);
    }

    /// 大端 int16（参数/结果格式码、列数）。
    void put16(int v) {
        this.put8(v >> 8);
        this.put8(v);
    }

    /// 追加字符串字节（不带 NUL）。
    void putRaw(string s) {
        int n = s.Length;
        int i = 0;
        for (; i < n; i = i + 1) { this.bb[this.bp + i] = (byte)(s[i] & 255); }
        this.bp = this.bp + n;
    }

    /// 追加字符串 + NUL 终止符。
    void putCstr(string s) {
        this.putRaw(s);
        this.put8(0);
    }

    void putBytes(byte[] b, int len) {
        int i = 0;
        for (; i < len; i = i + 1) { this.bb[this.bp + i] = (byte)(b[i] & 255); }
        this.bp = this.bp + len;
    }

    // 同步 IO（阻塞套接字；TLS 时直接驱动 TlsEngine）

    /// 同步 TLS：把引擎积累的网络密文全部发到套接字。
    int tlsFlushSync() {
        while (this.syncTls.OutNetLength() > 0) {
            int toSend = this.syncTls.OutNetLength();
            byte[] out1 = new byte[toSend + 1];
            NativeMemory.Copy(out1, this.syncTls.OutNetBuffer(), toSend);
            int sent = Socket.Send(this.sock, out1, toSend);
            if (sent <= 0) { return -1; }
            this.syncTls.DropOutNet(sent);
        }
        return 0;
    }

    /// 同步 TLS 收：泵引擎（Step 会消费已喂入的密文）直到能解出
    /// 明文；引擎要更多密文时从套接字收一段喂进去。关闭返回 0。
    int tlsRecvSync(byte[] dst, int want) {
        if (this.tlsIn == null) { this.tlsIn = new byte[65537]; }
        while (true) {
            int st = this.syncTls.Step();
            if (st < 0) { return -1; }
            if (this.tlsFlushSync() < 0) { return -1; }
            int avail = this.syncTls.AvailableAppData();
            if (avail > 0) {
                int toRead = avail > want ? want : avail;
                int r = this.syncTls.RecvAppData(dst, 0, toRead);
                if (r > 0) { return r; }
            }
            if (this.syncTls.IsClosed()) { return 0; }
            int n = Socket.Recv(this.sock, this.tlsIn, 65536);
            if (n == -1) { continue; }
            if (n <= 0) { return 0; }
            this.syncTls.FeedNetwork(this.tlsIn, 0, n);
        }
    }

    /// 同步 TLS 发：加密并冲刷。
    int tlsSendSync(byte[] data, int len) {
        int r = this.syncTls.SendAppData(data, 0, len);
        if (r < 0) { return -1; }
        if (this.tlsFlushSync() < 0) { return -1; }
        return len;
    }

    /// 恰好读取 need 字节到 dst 的 off 处；对端关闭返回不足。
    int recvExactSync(byte[] dst, int off, int need) {
        int got = 0;
        byte[] tmp = new byte[need + 1];
        while (got < need) {
            int n;
            if (this.syncTls != null) {
                n = this.tlsRecvSync(tmp, need - got);
            } else {
                n = Socket.Recv(this.sock, tmp, need - got);
            }
            if (n == -1) { continue; }
            if (n <= 0) { return got; }
            NativeMemory.Copy((nint)dst + (nint)(off + got), (nint)tmp, n);
            got = got + n;
        }
        return got;
    }

    /// 发原始字节（SSLRequest / Startup / TLS 密文）。
    int sendRawSync(byte[] buf, int len) {
        if (this.syncTls != null) { return this.tlsSendSync(buf, len); }
        return Socket.Send(this.sock, buf, len);
    }

    /// 发一条前端消息：类型字节 + 大端长度（含自身，不含类型）。
    int sendMessageSync(int type, byte[] pay, int len) {
        byte[] buf = new byte[len + 6];
        buf[0] = (byte)(type & 255);
        int total = len + 4;
        buf[1] = (byte)((total >> 24) & 255);
        buf[2] = (byte)((total >> 16) & 255);
        buf[3] = (byte)((total >> 8) & 255);
        buf[4] = (byte)(total & 255);
        int i = 0;
        for (; i < len; i = i + 1) { buf[5 + i] = (byte)(pay[i] & 255); }
        return this.sendRawSync(buf, len + 5);
    }

    /// 收一条后端消息：类型字节 + 大端长度。负载存入 pay，
    /// 长度记入 msgLen（含长度域自身）。连接关闭返回 null。
    byte[] recvMessageSync() {
        byte[] hdr = new byte[6];
        int got = this.recvExactSync(hdr, 0, 5);
        if (got < 5) { return null; }
        this.msgType = hdr[0] & 255;
        int blen = ((hdr[1] & 255) << 24) | ((hdr[2] & 255) << 16)
            | ((hdr[3] & 255) << 8) | (hdr[4] & 255);
        if (blen < 4 || blen > 1073741824) { return null; }
        this.msgLen = blen;
        int plen = blen - 4;
        byte[] pay = new byte[plen + 1];
        if (plen > 0) {
            int g2 = this.recvExactSync(pay, 0, plen);
            if (g2 < plen) { return null; }
        }
        return pay;
    }

    int sendPasswordSync(string text) {
        byte[] b = PgWire.strToBytes(text, text.Length);
        return this.sendMessageSync(112, b, text.Length);  // 'p'
    }

    // 异步 IO（IO reactor 挂起；TLS 经 TlsStream）

    async int recvExactAsync(byte[] dst, int off, int need) {
        if (this.tls != null) {
            int have = 0;
            while (have < need) {
                int read = await this.tls.RecvBytesAsync(dst, off + have, need - have);
                if (read <= 0) { return have; }
                have = have + read;
            }
            return have;
        }
        int got = 0;
        byte[] tmp = new byte[need + 1];
        while (got < need) {
            int n = await Socket.RecvOv(this.sock, tmp, need - got);
            if (n <= 0) { return got; }
            NativeMemory.Copy((nint)dst + (nint)(off + got), (nint)tmp, n);
            got = got + n;
        }
        return got;
    }

    async int sendRawAsync(byte[] buf, int len) {
        if (this.tls != null) {
            return await this.tls.SendBytesAsync(buf, 0, len);
        }
        return await Socket.SendAsync(this.sock, buf, len);
    }

    async int sendMessageAsync(int type, byte[] pay, int len) {
        byte[] buf = new byte[len + 6];
        buf[0] = (byte)(type & 255);
        int total = len + 4;
        buf[1] = (byte)((total >> 24) & 255);
        buf[2] = (byte)((total >> 16) & 255);
        buf[3] = (byte)((total >> 8) & 255);
        buf[4] = (byte)(total & 255);
        int i = 0;
        for (; i < len; i = i + 1) { buf[5 + i] = (byte)(pay[i] & 255); }
        return await this.sendRawAsync(buf, len + 5);
    }

    async byte[] recvMessageAsync() {
        byte[] hdr = new byte[6];
        int got = await this.recvExactAsync(hdr, 0, 5);
        if (got < 5) { return null; }
        this.msgType = hdr[0] & 255;
        int blen = ((hdr[1] & 255) << 24) | ((hdr[2] & 255) << 16)
            | ((hdr[3] & 255) << 8) | (hdr[4] & 255);
        if (blen < 4 || blen > 1073741824) { return null; }
        this.msgLen = blen;
        int plen = blen - 4;
        byte[] pay = new byte[plen + 1];
        if (plen > 0) {
            int g2 = await this.recvExactAsync(pay, 0, plen);
            if (g2 < plen) { return null; }
        }
        return pay;
    }

    async int sendPasswordAsync(string text) {
        byte[] b = PgWire.strToBytes(text, text.Length);
        return await this.sendMessageAsync(112, b, text.Length);  // 'p'
    }

    // 连接建立

    /// <summary>解析 conninfo 并套用到本连接的参数字段；
    /// 语法或必填项问题写入 lastError 并返回 -1。</summary>
    int applyConninfo(string conninfo) {
        List<string> outs = new List<string>();
        int k = 0;
        for (; k < 8; k = k + 1) { outs.Add(""); }
        if (conninfo != null && conninfo.Length > 0) {
            if (PgWire.parseConninfo(conninfo, outs) != 0) {
                this.lastError = "invalid conninfo syntax";
                return -1;
            }
        }
        if (outs[0].Length > 0) { this.host = outs[0]; }
        if (outs[1].Length > 0) {
            int p = Encoding.ParseInt(outs[1]);
            if (p <= 0 || p > 65535) {
                this.lastError = "invalid port: " + outs[1];
                return -1;
            }
            this.port = p;
        }
        if (outs[2].Length > 0) { this.database = outs[2]; }
        if (outs[3].Length > 0) { this.user = outs[3]; }
        if (outs[4].Length > 0) { this.password = outs[4]; }
        if (outs[5].Length > 0) {
            string m = outs[5];
            if (m == "disable") { this.sslMode = 0; }
            else if (m == "prefer") { this.sslMode = 1; }
            else if (m == "require" || m == "verify-ca" || m == "verify-full") {
                // 校验级别跟随全局 SetTlsVerify（默认全验）。
                this.sslMode = 2;
            } else {
                this.lastError = "invalid sslmode: " + m;
                return -1;
            }
        }
        if (outs[6].Length > 0) {
            int t = Encoding.ParseInt(outs[6]);
            if (t < 0 || t > 86400) {
                this.lastError = "invalid connect_timeout: " + outs[6];
                return -1;
            }
            this.connectTimeout = t;
        }
        if (outs[7].Length > 0) { this.sslRootCert = outs[7]; }
        if (this.user.Length == 0) {
            this.lastError = "no user name specified in conninfo";
            return -1;
        }
        return 0;
    }

    /// 发送 SSLRequest（长度 8 + 代码 80877103，无类型字节）并读
    /// 单字节答复：'S' = 支持 TLS，'N' = 不支持。返回答复字节，
    /// 连接失败返回 0。
    int sslNegotiateSync() {
        byte[] req = new byte[9];
        req[0] = 0; req[1] = 0; req[2] = 0; req[3] = 8;
        req[4] = 4; req[5] = 210; req[6] = 22; req[7] = 47;  // 80877103
        int sn = Socket.Send(this.sock, req, 8);
        byte[] rsp = new byte[2];
        int got = this.recvExactSync(rsp, 0, 1);
        if (got < 1) { return 0; }
        return rsp[0] & 255;
    }

    async int sslNegotiateAsync() {
        byte[] req = new byte[9];
        req[0] = 0; req[1] = 0; req[2] = 0; req[3] = 8;
        req[4] = 4; req[5] = 210; req[6] = 22; req[7] = 47;  // 80877103
        int sent = await Socket.SendAsync(this.sock, req, 8);
        if (sent <= 0) { return 0; }
        byte[] rsp = new byte[2];
        int got = await this.recvExactAsync(rsp, 0, 1);
        if (got < 1) { return 0; }
        return rsp[0] & 255;
    }

    /// <summary>同步 TLS 升级：直接构造 TlsEngine 并用阻塞套接字
    /// 泵握手。PG 的 SSLRequest 之后整个通道换 TLS，同步方法无法
    /// await，因此不走 TlsStream（其收发皆异步），与 SqlServer
    /// 驱动的带内升级同一招法。</summary>
    bool tlsUpgradeSync() {
        List<X509Certificate> trust = null;
        if (this.sslRootCert.Length > 0) {
            trust = TlsContext.ReadTrustBundle(this.sslRootCert, true);
            if (trust == null) {
                this.lastError = "sslrootcert could not be read: " + this.sslRootCert;
                return false;
            }
        }
        this.syncTls = new TlsEngine(this.host, !PgConnection.verifyTls, false,
            null, false, null, trust, false, "", "");
        this.syncTls.StartHandshake();
        if (this.tlsIn == null) { this.tlsIn = new byte[65537]; }
        while (true) {
            int st = this.syncTls.Step();
            if (this.tlsFlushSync() < 0) {
                this.lastError = "TLS handshake send failed";
                return false;
            }
            if (st == 1) { return true; }
            if (st < 0) {
                this.lastError = "TLS handshake failed: " + this.syncTls.LastError();
                return false;
            }
            int n = Socket.Recv(this.sock, this.tlsIn, 65536);
            if (n == -1) { continue; }
            if (n <= 0) {
                this.lastError = "server closed connection during TLS handshake";
                return false;
            }
            this.syncTls.FeedNetwork(this.tlsIn, 0, n);
        }
        return false;
    }

    /// 构造完整 StartupMessage（长度域 + 协议 3.0 + 参数表）。
    /// 长度域先占位、按最终 bp 回填——估算长度差一字节服务器就会
    /// 永久等待不存在的尾字节（本驱动踩过的第一坑）。
    byte[] startupPayload() {
        int est = 4
            + 5 + this.user.Length + 1
            + (this.database.Length > 0 ? 9 + this.database.Length + 1 : 0)
            + 15 + 1 + 5 + 1  // client_encoding=UTF8
            + 16 + 1 + 3 + 1  // application_name=zan
            + 1;
        this.begin(est + 4);
        this.put32(0);  // 长度域占位
        this.put32(196608);  // 协议 3.0
        this.putCstr("user");
        this.putCstr(this.user);
        if (this.database.Length > 0) {
            this.putCstr("database");
            this.putCstr(this.database);
        }
        this.putCstr("client_encoding");
        this.putCstr("UTF8");
        this.putCstr("application_name");
        this.putCstr("zan");
        this.put8(0);  // 参数表终止符
        this.bb[0] = (byte)((this.bp >> 24) & 255);
        this.bb[1] = (byte)((this.bp >> 16) & 255);
        this.bb[2] = (byte)((this.bp >> 8) & 255);
        this.bb[3] = (byte)(this.bp & 255);
        return this.bb;
    }

    /// 完整同步握手：TCP → SSLRequest/TLS → Startup → 认证 →
    /// ReadyForQuery。失败原因写入 lastError。
    bool doConnectSync() {
        this.sock = Socket.CreateTcp();
        if (this.sock < 0) { this.lastError = "socket create failed"; return false; }
        int cr = Socket.Connect(this.sock, this.host, this.port);
        if (cr < 0) {
            this.lastError = "could not connect to " + this.host + ":"
                + Convert.ToString(this.port);
            Socket.Close(this.sock);
            this.sock = -1;
            return false;
        }
        if (this.sslMode != 0) {
            int rsp = this.sslNegotiateSync();
            if (rsp == 83) {  // 'S'
                if (!this.tlsUpgradeSync()) { return false; }
            } else {
                if (rsp == 0) {
                    this.lastError = "server closed connection during SSL negotiation";
                    return false;
                }
                if (this.sslMode == 2) {
                    this.lastError = "server does not support SSL, but SSL was required";
                    return false;
                }
                // prefer：'N' 回退明文。
            }
        }
        byte[] sup = this.startupPayload();
        if (this.sendRawSync(sup, this.bp) <= 0) {
            this.lastError = "could not send startup message";
            return false;
        }
        if (!this.authLoopSync()) { return false; }
        while (true) {
            byte[] pay = this.recvMessageSync();
            if (pay == null) {
                this.lastError = "connection closed during startup";
                return false;
            }
            if (this.msgType == 69) {  // 'E'
                this.lastError = PgWire.formatError(pay, this.msgLen - 4);
                return false;
            }
            if (this.msgType == 83) {  // 'S' ParameterStatus
                this.recordParamStatus(pay);
            } else if (this.msgType == 75) {  // 'K' BackendKeyData
                this.backendPid = PgWire.be32(pay, 0);
                this.backendSecret = PgWire.be32(pay, 4);
            } else if (this.msgType == 90) {  // 'Z' ReadyForQuery
                return true;
            }
            // 'N' NoticeResponse 忽略
        }
        return false;
    }

    /// 完整异步握手（协程版）：TCP（reactor + 可选超时）→
    /// SSLRequest/TLS（TlsStream.ConnectAsync）→ Startup → 认证 →
    /// ReadyForQuery。
    async bool doConnectAsync() {
        this.sock = Socket.CreateTcp();
        if (this.sock < 0) { this.lastError = "socket create failed"; return false; }
        Socket.SetNonBlocking(this.sock);
        int cr;
        if (this.connectTimeout > 0) {
            cr = await Socket.ConnectAsync(this.sock, this.host, this.port,
                this.connectTimeout * 1000);
        } else {
            cr = await Socket.ConnectAsync(this.sock, this.host, this.port);
        }
        if (cr < 0) {
            this.lastError = "could not connect to " + this.host + ":"
                + Convert.ToString(this.port);
            Socket.Close(this.sock);
            this.sock = -1;
            return false;
        }
        if (this.sslMode != 0) {
            int rsp = await this.sslNegotiateAsync();
            if (rsp == 83) {  // 'S'
                TlsContext ctx = TlsContext.CreateClient();
                if (ctx == null) {
                    this.lastError = "TLS init failed: " + TlsStream.LastError();
                    return false;
                }
                if (!PgConnection.verifyTls) { ctx.DisableVerify(); }
                if (this.sslRootCert.Length > 0 && !ctx.AddTrustedCert(this.sslRootCert)) {
                    this.lastError = "sslrootcert could not be read: " + this.sslRootCert;
                    return false;
                }
                this.tls = await TlsStream.ConnectAsync(ctx, this.sock, this.host, 15000);
                if (this.tls == null) {
                    this.lastError = "TLS handshake failed: " + TlsStream.LastError();
                    return false;
                }
            } else {
                if (rsp == 0) {
                    this.lastError = "server closed connection during SSL negotiation";
                    return false;
                }
                if (this.sslMode == 2) {
                    this.lastError = "server does not support SSL, but SSL was required";
                    return false;
                }
            }
        }
        byte[] sup = this.startupPayload();
        if (await this.sendRawAsync(sup, this.bp) <= 0) {
            this.lastError = "could not send startup message";
            return false;
        }
        if (!await this.authLoopAsync()) { return false; }
        while (true) {
            byte[] pay = await this.recvMessageAsync();
            if (pay == null) {
                this.lastError = "connection closed during startup";
                return false;
            }
            if (this.msgType == 69) {  // 'E'
                this.lastError = PgWire.formatError(pay, this.msgLen - 4);
                return false;
            }
            if (this.msgType == 83) {  // 'S'
                this.recordParamStatus(pay);
            } else if (this.msgType == 75) {  // 'K'
                this.backendPid = PgWire.be32(pay, 0);
                this.backendSecret = PgWire.be32(pay, 4);
            } else if (this.msgType == 90) {  // 'Z'
                return true;
            }
        }
        return false;
    }

    /// ParameterStatus('S')：key\0value\0。只记 server_version 与
    /// client_encoding（后者应为 UTF8——Startup 里已指定）。
    void recordParamStatus(byte[] pay) {
        int p = 0;
        int len = this.msgLen - 4;
        int ks = 0;
        while (p < len && (pay[p] & 255) != 0) { p = p + 1; }
        string key = PgWire.bytesToStr(pay, ks, p - ks);
        p = p + 1;
        int vs = p;
        while (p < len && (pay[p] & 255) != 0) { p = p + 1; }
        string val = PgWire.bytesToStr(pay, vs, p - vs);
        if (key == "server_version") { this.serverVersion = val; }
        else if (key == "client_encoding") { this.clientEncoding = val; }
    }

    // 认证

    /// 同步认证循环：处理 AuthenticationOk / Cleartext / MD5 /
    /// SASL(SCRAM-SHA-256) 直到 AuthenticationOk；ErrorResponse
    /// 即失败。SCRAM 服务器签名在此一并校验。
    bool authLoopSync() {
        string clientNonceB64 = "";
        string clientFirstBare = "";
        byte[] serverKey = null;
        string authMessage = "";
        while (true) {
            byte[] pay = this.recvMessageSync();
            if (pay == null) {
                this.lastError = "connection closed during authentication";
                return false;
            }
            if (this.msgType == 69) {  // 'E'
                this.lastError = PgWire.formatError(pay, this.msgLen - 4);
                return false;
            }
            if (this.msgType != 82) {  // 'R'
                this.lastError = "unexpected message during authentication";
                return false;
            }
            int code = PgWire.be32(pay, 0);
            int plen = this.msgLen - 4;
            if (code == 0) {  // AuthenticationOk
                return true;
            }
            if (code == 3) {  // CleartextPassword
                if (this.sendPasswordSync(this.password) <= 0) {
                    this.lastError = "could not send password";
                    return false;
                }
                continue;
            }
            if (code == 5) {  // MD5Password
                if (this.sendPasswordSync(
                        PgWire.md5PasswordToken(this.password, this.user,
                            PgWire.slice4(pay, 4))) <= 0) {
                    this.lastError = "could not send password";
                    return false;
                }
                continue;
            }
            if (code == 10) {  // AuthenticationSASL
                bool mechOk = false;
                int p = 4;
                while (p < plen) {
                    if ((pay[p] & 255) == 0) { break; }
                    int ns = p;
                    while (p < plen && (pay[p] & 255) != 0) { p = p + 1; }
                    string m = PgWire.bytesToStr(pay, ns, p - ns);
                    p = p + 1;
                    if (m == "SCRAM-SHA-256") { mechOk = true; }
                }
                if (!mechOk) {
                    this.lastError = "server does not offer SCRAM-SHA-256";
                    return false;
                }
                clientNonceB64 = PgWire.clientNonce();
                clientFirstBare = "n=,r=" + clientNonceB64;
                string clientFirst = "n,," + clientFirstBare;
                this.begin(13 + 1 + 4 + clientFirst.Length + 8);
                this.putCstr("SCRAM-SHA-256");
                this.put32(clientFirst.Length);
                this.putRaw(clientFirst);
                if (this.sendMessageSync(112, this.bb, this.bp) <= 0) {
                    this.lastError = "could not send SASL initial response";
                    return false;
                }
                continue;
            }
            if (code == 11) {  // AuthenticationSASLContinue
                string serverFirst = PgWire.bytesToStr(pay, 4, plen - 4);
                string serverNonce = PgWire.scramField(serverFirst, "r");
                string saltB64 = PgWire.scramField(serverFirst, "s");
                int iters = Encoding.ParseInt(PgWire.scramField(serverFirst, "i"));
                if (!PgWire.hasPrefix(serverNonce, clientNonceB64)
                        || saltB64.Length == 0 || iters < 1) {
                    this.lastError = "invalid SCRAM server-first-message";
                    return false;
                }
                List<int> saltLen = new List<int>();
                saltLen.Add(0);
                byte[] salt = Base64.Decode(saltB64, saltLen);
                byte[] salted = PgWire.pbkdf2Sha256(this.password, salt,
                    saltLen[0], iters);
                byte[] clientKey = Hmac.Sha256(salted, 32,
                    PgWire.strToBytes("Client Key", 10), 10);
                byte[] storedKey = Sha256.Hash(clientKey, 32);
                string finalWoProof = "c=biws,r=" + serverNonce;
                authMessage = clientFirstBare + "," + serverFirst + ","
                    + finalWoProof;
                byte[] authBytes = PgWire.strToBytes(authMessage,
                    authMessage.Length);
                byte[] clientSig = Hmac.Sha256(storedKey, 32, authBytes,
                    authMessage.Length);
                byte[] proof = PgWire.xor32(clientKey, clientSig);
                serverKey = Hmac.Sha256(salted, 32,
                    PgWire.strToBytes("Server Key", 10), 10);
                string finalMsg = finalWoProof + ",p="
                    + Base64.Encode(proof.ToStr(0, 32), 32);
                if (this.sendPasswordSync(finalMsg) <= 0) {
                    this.lastError = "could not send SASL response";
                    return false;
                }
                continue;
            }
            if (code == 12) {  // AuthenticationSASLFinal
                string verifier = PgWire.bytesToStr(pay, 4, plen - 4);
                byte[] authBytes2 = PgWire.strToBytes(authMessage,
                    authMessage.Length);
                byte[] serverSig = Hmac.Sha256(serverKey, 32, authBytes2,
                    authMessage.Length);
                string expect = "v=" + Base64.Encode(serverSig.ToStr(0, 32), 32);
                if (verifier != expect) {
                    this.lastError = "SCRAM server signature mismatch";
                    return false;
                }
                continue;  // AuthenticationOk 随后到达
            }
            // 2=KerberosV5 6=SCM 7=GSS 8=GSSContinue 9=SSPI——纯 Zan
            // 客户端不支持企业 SSO 族认证。
            this.lastError = "unsupported authentication method "
                + Convert.ToString(code) + " (GSSAPI/SSPI/Kerberos are not supported)";
            return false;
        }
        return false;
    }

    /// 异步认证循环（协程版），逻辑与 <see cref="authLoopSync"/> 逐分支一致。
    async bool authLoopAsync() {
        string clientNonceB64 = "";
        string clientFirstBare = "";
        byte[] serverKey = null;
        string authMessage = "";
        while (true) {
            byte[] pay = await this.recvMessageAsync();
            if (pay == null) {
                this.lastError = "connection closed during authentication";
                return false;
            }
            if (this.msgType == 69) {  // 'E'
                this.lastError = PgWire.formatError(pay, this.msgLen - 4);
                return false;
            }
            if (this.msgType != 82) {  // 'R'
                this.lastError = "unexpected message during authentication";
                return false;
            }
            int code = PgWire.be32(pay, 0);
            int plen = this.msgLen - 4;
            if (code == 0) { return true; }
            if (code == 3) {
                if (await this.sendPasswordAsync(this.password) <= 0) {
                    this.lastError = "could not send password";
                    return false;
                }
                continue;
            }
            if (code == 5) {
                if (await this.sendPasswordAsync(
                        PgWire.md5PasswordToken(this.password, this.user,
                            PgWire.slice4(pay, 4))) <= 0) {
                    this.lastError = "could not send password";
                    return false;
                }
                continue;
            }
            if (code == 10) {
                bool mechOk = false;
                int p = 4;
                while (p < plen) {
                    if ((pay[p] & 255) == 0) { break; }
                    int ns = p;
                    while (p < plen && (pay[p] & 255) != 0) { p = p + 1; }
                    string m = PgWire.bytesToStr(pay, ns, p - ns);
                    p = p + 1;
                    if (m == "SCRAM-SHA-256") { mechOk = true; }
                }
                if (!mechOk) {
                    this.lastError = "server does not offer SCRAM-SHA-256";
                    return false;
                }
                clientNonceB64 = PgWire.clientNonce();
                clientFirstBare = "n=,r=" + clientNonceB64;
                string clientFirst = "n,," + clientFirstBare;
                this.begin(13 + 1 + 4 + clientFirst.Length + 8);
                this.putCstr("SCRAM-SHA-256");
                this.put32(clientFirst.Length);
                this.putRaw(clientFirst);
                if (await this.sendMessageAsync(112, this.bb, this.bp) <= 0) {
                    this.lastError = "could not send SASL initial response";
                    return false;
                }
                continue;
            }
            if (code == 11) {
                string serverFirst = PgWire.bytesToStr(pay, 4, plen - 4);
                string serverNonce = PgWire.scramField(serverFirst, "r");
                string saltB64 = PgWire.scramField(serverFirst, "s");
                int iters = Encoding.ParseInt(PgWire.scramField(serverFirst, "i"));
                if (!PgWire.hasPrefix(serverNonce, clientNonceB64)
                        || saltB64.Length == 0 || iters < 1) {
                    this.lastError = "invalid SCRAM server-first-message";
                    return false;
                }
                List<int> saltLen = new List<int>();
                saltLen.Add(0);
                byte[] salt = Base64.Decode(saltB64, saltLen);
                byte[] salted = PgWire.pbkdf2Sha256(this.password, salt,
                    saltLen[0], iters);
                byte[] clientKey = Hmac.Sha256(salted, 32,
                    PgWire.strToBytes("Client Key", 10), 10);
                byte[] storedKey = Sha256.Hash(clientKey, 32);
                string finalWoProof = "c=biws,r=" + serverNonce;
                authMessage = clientFirstBare + "," + serverFirst + ","
                    + finalWoProof;
                byte[] authBytes = PgWire.strToBytes(authMessage,
                    authMessage.Length);
                byte[] clientSig = Hmac.Sha256(storedKey, 32, authBytes,
                    authMessage.Length);
                byte[] proof = PgWire.xor32(clientKey, clientSig);
                serverKey = Hmac.Sha256(salted, 32,
                    PgWire.strToBytes("Server Key", 10), 10);
                string finalMsg = finalWoProof + ",p="
                    + Base64.Encode(proof.ToStr(0, 32), 32);
                if (await this.sendPasswordAsync(finalMsg) <= 0) {
                    this.lastError = "could not send SASL response";
                    return false;
                }
                continue;
            }
            if (code == 12) {
                string verifier = PgWire.bytesToStr(pay, 4, plen - 4);
                byte[] authBytes2 = PgWire.strToBytes(authMessage,
                    authMessage.Length);
                byte[] serverSig = Hmac.Sha256(serverKey, 32, authBytes2,
                    authMessage.Length);
                string expect = "v=" + Base64.Encode(serverSig.ToStr(0, 32), 32);
                if (verifier != expect) {
                    this.lastError = "SCRAM server signature mismatch";
                    return false;
                }
                continue;
            }
            this.lastError = "unsupported authentication method "
                + Convert.ToString(code) + " (GSSAPI/SSPI/Kerberos are not supported)";
            return false;
        }
        return false;
    }

    // 打开连接（公开入口，API 与 libpq 时代完全一致）

    /// <summary>从 libpq conninfo 字符串打开连接（阻塞）。</summary>
    static PgConnection Open(string conninfo) {
        Socket.Initialize();
        PgConnection conn = new PgConnection();
        if (conn.applyConninfo(conninfo) != 0) { return conn; }
        conn.connected = conn.doConnectSync();
        return conn;
    }

    /// <summary>从分散参数打开连接（阻塞）。</summary>
    static PgConnection OpenParams(string host, int port, string database,
            string user, string password) {
        string conninfo = "host=" + host + " port=" + Convert.ToString(port)
            + " dbname=" + database + " user=" + user + " password=" + password;
        return PgConnection.Open(conninfo);
    }

    /// <summary>打开连接而不阻塞线程：TCP 连接、SSL 协商、认证、
    /// 就绪各步骤都在 IO reactor 上挂起等待。</summary>
    static async PgConnection OpenAsync(string conninfo) {
        Socket.Initialize();
        PgConnection conn = new PgConnection();
        if (conn.applyConninfo(conninfo) != 0) { return conn; }
        conn.connected = await conn.doConnectAsync();
        return conn;
    }

    /// <summary>从分散参数异步打开连接。</summary>
    static async PgConnection OpenParamsAsync(string host, int port,
            string database, string user, string password) {
        string conninfo = "host=" + host + " port=" + Convert.ToString(port)
            + " dbname=" + database + " user=" + user + " password=" + password;
        PgConnection conn = await PgConnection.OpenAsync(conninfo);
        return conn;
    }

    // 结果读取（简单与扩展协议共用）

    /// <summary>读取一个协议往返的全部后端消息直到 ReadyForQuery，
    /// 组装 DbResult（多语句时保留最后一个结果集——与 libpq 时代
    /// QueryAsync 行为一致）。错误记录 lastError 并置 hadError。</summary>
    DbResult readResultsSync() {
        DbResult result = new DbResult();
        List<int> colOids = new List<int>();
        this.hadError = false;
        while (true) {
            byte[] pay = this.recvMessageSync();
            if (pay == null) {
                this.connected = false;
                this.hadError = true;
                if (this.lastError.Length == 0) {
                    this.lastError = "connection closed by server";
                }
                return result;
            }
            int t = this.msgType;
            int plen = this.msgLen - 4;
            if (t == 84) {  // 'T' RowDescription
                result = new DbResult();
                colOids = new List<int>();
                PgWire.readRowDescription(result, pay, plen, colOids);
            } else if (t == 68) {  // 'D' DataRow
                PgWire.readDataRow(result, pay, plen, colOids);
            } else if (t == 67) {  // 'C' CommandComplete
                if (plen > 0) {
                    string tag = PgWire.bytesToStr(pay, 0, plen - 1);
                    this.lastAffected = PgWire.parseCommandTag(tag);
                }
            } else if (t == 69) {  // 'E' ErrorResponse
                this.lastError = PgWire.formatError(pay, plen);
                this.hadError = true;
            } else if (t == 90) {  // 'Z' ReadyForQuery
                return result;
            }
            // 'N' 通知、'I' 空查询、'1'/'2'/'n'/'t' 扩展协议应答、
            // 'S'/'K' 会话消息——全部忽略。
        }
    }

    /// <see cref="readResultsSync"/> 的协程版。
    async DbResult readResultsAsync() {
        DbResult result = new DbResult();
        List<int> colOids = new List<int>();
        this.hadError = false;
        while (true) {
            byte[] pay = await this.recvMessageAsync();
            if (pay == null) {
                this.connected = false;
                this.hadError = true;
                if (this.lastError.Length == 0) {
                    this.lastError = "connection closed by server";
                }
                return result;
            }
            int t = this.msgType;
            int plen = this.msgLen - 4;
            if (t == 84) {
                result = new DbResult();
                colOids = new List<int>();
                PgWire.readRowDescription(result, pay, plen, colOids);
            } else if (t == 68) {
                PgWire.readDataRow(result, pay, plen, colOids);
            } else if (t == 67) {
                if (plen > 0) {
                    string tag = PgWire.bytesToStr(pay, 0, plen - 1);
                    this.lastAffected = PgWire.parseCommandTag(tag);
                }
            } else if (t == 69) {
                this.lastError = PgWire.formatError(pay, plen);
                this.hadError = true;
            } else if (t == 90) {
                return result;
            }
        }
    }

    // 查询 / 执行（同步）

    /// <summary>执行非查询语句；返回受影响行数或 -1（错误详情在
    /// 核心契约与语义定义。
    int Execute(string sql) {
        if (!this.connected) { this.lastError = "not connected"; return -1; }
        this.lastError = "";
        this.lastAffected = 0;
        byte[] b = PgWire.strToBytes(sql, sql.Length);
        if (this.sendMessageSync(81, b, sql.Length) <= 0) {  // 'Q'
            this.connected = false;
            this.lastError = "cannot send the query";
            return -1;
        }
        DbResult r = this.readResultsSync();
        if (this.hadError) { return -1; }
        return this.lastAffected;
    }

    /// <summary>执行查询并返回结果集；错误返回空结果
    /// （详情在 <see cref="GetError"/>）。</summary>
    DbResult Query(string sql) {
        if (!this.connected) { this.lastError = "not connected"; return new DbResult(); }
        this.lastError = "";
        this.lastAffected = 0;
        byte[] b = PgWire.strToBytes(sql, sql.Length);
        if (this.sendMessageSync(81, b, sql.Length) <= 0) {
            this.connected = false;
            this.lastError = "cannot send the query";
            return new DbResult();
        }
        return this.readResultsSync();
    }

    /// <summary>执行标量查询（第一行第一列）。</summary>
    string ExecuteScalar(string sql) {
        DbResult result = this.Query(sql);
        if (result.RowCount() > 0) {
            return result.GetString(0, 0);
        }
        return "";
    }

    /// <summary>参数化执行（扩展协议）：Parse/Bind/Describe/Execute/
    /// Sync 五连发，值文本格式带外传输，绝不拼入 SQL 文本。
    /// 返回受影响行数或 -1。</summary>
    int Execute(string sql, DbParams prms) {
        if (!this.connected) { this.lastError = "not connected"; return -1; }
        this.lastError = "";
        this.lastAffected = 0;
        if (!this.sendExtendedSync(PgWire.ToDollarParams(sql), prms)) {
            return -1;
        }
        this.readResultsSync();
        if (this.hadError) { return -1; }
        return this.lastAffected;
    }

    /// <summary>参数化查询（扩展协议）；错误返回空结果。</summary>
    DbResult Query(string sql, DbParams prms) {
        if (!this.connected) { this.lastError = "not connected"; return new DbResult(); }
        this.lastError = "";
        this.lastAffected = 0;
        if (!this.sendExtendedSync(PgWire.ToDollarParams(sql), prms)) {
            return new DbResult();
        }
        return this.readResultsSync();
    }

    /// <summary>执行参数化标量查询。</summary>
    string ExecuteScalar(string sql, DbParams prms) {
        DbResult result = this.Query(sql, prms);
        if (result.RowCount() > 0) {
            return result.GetString(0, 0);
        }
        return "";
    }

    /// 发送扩展协议五连发（同步）。失败标记连接死亡。
    bool sendExtendedSync(string dollarSql, DbParams prms) {
        // Parse('P')：未命名语句 + $n 形式的 SQL + 0 个显式参数类型
        // （服务器按上下文推断）。
        this.begin(8 + dollarSql.Length);
        this.putCstr("");
        this.putCstr(dollarSql);
        this.put16(0);
        if (this.sendMessageSync(80, this.bb, this.bp) <= 0) { this.die("cannot send Parse"); return false; }
        // Bind('B')：全部参数文本格式。
        List<string> vals = new List<string>();
        int size = 64;
        int n = prms.Count();
        int i = 0;
        for (; i < n; i = i + 1) {
            string t = prms.IsNull(i) ? "" : prms.AsText(i);
            vals.Add(t);
            size = size + t.Length + 4;
        }
        this.begin(size);
        this.putCstr("");  // portal
        this.putCstr("");  // statement
        this.put16(1);  // 1 个参数格式码
        this.put32(0);  // 全部文本
        this.put16(n);
        i = 0;
        for (; i < n; i = i + 1) {
            if (prms.IsNull(i)) {
                this.put32(-1);  // NULL：长度 -1，无字节
            } else {
                string t = vals[i];
                this.put32(t.Length);
                if (t.Length > 0) { this.putRaw(t); }
            }
        }
        this.put16(0);  // 结果格式：默认全文本
        if (this.sendMessageSync(66, this.bb, this.bp) <= 0) { this.die("cannot send Bind"); return false; }
        // Describe('D') portal：取 RowDescription（列名/类型）。
        this.begin(4);
        this.put8(80);  // 'P'
        this.putCstr("");
        if (this.sendMessageSync(68, this.bb, this.bp) <= 0) { this.die("cannot send Describe"); return false; }
        // Execute('E')：取全部行。
        this.begin(6);
        this.putCstr("");
        this.put32(0);
        if (this.sendMessageSync(69, this.bb, this.bp) <= 0) { this.die("cannot send Execute"); return false; }
        // Sync('S')：结束本轮。
        if (this.sendMessageSync(83, this.bb, 0) <= 0) { this.die("cannot send Sync"); return false; }
        return true;
    }

    /// 连接已死：记因并标记断开。
    void die(string why) {
        this.lastError = why;
        this.connected = false;
    }

    // 查询 / 执行（协程版）

    /// <summary>执行查询并返回完整结果集。当服务器返回错误或
    /// 会话已断开时抛出 <see cref="DbException"/>，因此空结果总意味着
    /// 「无行」；错误信息仍可通过 <see cref="GetError"/> 获取。
    /// 内部通过 AsyncGate 门控保证单连接事务互斥，杜绝并发调用数据串号。</summary>
    async DbResult QueryAsync(string sql) {
        await this.AcquireLock();
        try {
            if (!this.connected) {
                this.lastError = "not connected";
                this.fail();
            }
            this.lastError = "";
            this.lastAffected = 0;
            byte[] b = PgWire.strToBytes(sql, sql.Length);
            if (await this.sendMessageAsync(81, b, sql.Length) <= 0) {
                this.connected = false;
                this.lastError = "cannot send the query";
                this.fail();
            }
            DbResult r = await this.readResultsAsync();
            if (this.hadError) { this.fail(); }
            return r;
        } finally {
            this.ReleaseLock();
        }
    }

    /// <summary>执行非查询语句并返回受影响行数。语句失败时
    /// 抛出 <see cref="DbException"/>。内部通过 AsyncGate 门控保证单连接事务互斥，杜绝并发调用数据串号。</summary>
    async int ExecuteAsync(string sql) {
        await this.AcquireLock();
        try {
            if (!this.connected) {
                this.lastError = "not connected";
                this.fail();
            }
            this.lastError = "";
            this.lastAffected = 0;
            byte[] b = PgWire.strToBytes(sql, sql.Length);
            if (await this.sendMessageAsync(81, b, sql.Length) <= 0) {
                this.connected = false;
                this.lastError = "cannot send the statement";
                this.fail();
            }
            await this.readResultsAsync();
            if (this.hadError) { this.fail(); }
            return this.lastAffected;
        } finally {
            this.ReleaseLock();
        }
    }

    /// <summary>异步发送参数化查询（扩展协议）。语句失败时抛出
    /// <see cref="DbException"/>。内部通过 AsyncGate 门控保证单连接事务互斥，杜绝并发调用数据串号。</summary>
    async DbResult QueryParamsAsync(string sql, DbParams prms) {
        await this.AcquireLock();
        try {
            if (!this.connected) {
                this.lastError = "not connected";
                this.fail();
            }
            this.lastError = "";
            this.lastAffected = 0;
            if (!await this.sendExtendedAsync(PgWire.ToDollarParams(sql), prms)) {
                this.fail();
            }
            DbResult r = await this.readResultsAsync();
            if (this.hadError) { this.fail(); }
            return r;
        } finally {
            this.ReleaseLock();
        }
    }

    /// <summary>异步发送参数化非查询语句并返回受影响行数。
    /// 语句失败时抛出 <see cref="DbException"/>。内部通过 AsyncGate 门控保证单连接事务互斥，杜绝并发调用数据串号。</summary>
    async int ExecuteParamsAsync(string sql, DbParams prms) {
        await this.AcquireLock();
        try {
            if (!this.connected) {
                this.lastError = "not connected";
                this.fail();
            }
            this.lastError = "";
            this.lastAffected = 0;
            if (!await this.sendExtendedAsync(PgWire.ToDollarParams(sql), prms)) {
                this.fail();
            }
            await this.readResultsAsync();
            if (this.hadError) { this.fail(); }
            return this.lastAffected;
        } finally {
            this.ReleaseLock();
        }
    }

    /// <see cref="sendExtendedSync"/> 的协程版。
    async bool sendExtendedAsync(string dollarSql, DbParams prms) {
        this.begin(8 + dollarSql.Length);
        this.putCstr("");
        this.putCstr(dollarSql);
        this.put16(0);
        if (await this.sendMessageAsync(80, this.bb, this.bp) <= 0) { this.die("cannot send Parse"); return false; }
        List<string> vals = new List<string>();
        int size = 64;
        int n = prms.Count();
        int i = 0;
        for (; i < n; i = i + 1) {
            string t = prms.IsNull(i) ? "" : prms.AsText(i);
            vals.Add(t);
            size = size + t.Length + 4;
        }
        this.begin(size);
        this.putCstr("");
        this.putCstr("");
        this.put16(1);
        this.put32(0);
        this.put16(n);
        i = 0;
        for (; i < n; i = i + 1) {
            if (prms.IsNull(i)) {
                this.put32(-1);  // NULL：长度 -1，无字节
            } else {
                string t = vals[i];
                this.put32(t.Length);
                if (t.Length > 0) { this.putRaw(t); }
            }
        }
        this.put16(0);
        if (await this.sendMessageAsync(66, this.bb, this.bp) <= 0) { this.die("cannot send Bind"); return false; }
        this.begin(4);
        this.put8(80);
        this.putCstr("");
        if (await this.sendMessageAsync(68, this.bb, this.bp) <= 0) { this.die("cannot send Describe"); return false; }
        this.begin(6);
        this.putCstr("");
        this.put32(0);
        if (await this.sendMessageAsync(69, this.bb, this.bp) <= 0) { this.die("cannot send Execute"); return false; }
        if (await this.sendMessageAsync(83, this.bb, 0) <= 0) { this.die("cannot send Sync"); return false; }
        return true;
    }

    /// <summary>抛出记录的失败。错误消息来自服务器本身，因此能
    /// 原样到达调用方，而不会被空结果或 -1 吞掉。</summary>
    void fail() {
        string why = this.lastError;
        if (why.Length == 0) {
            why = "the statement failed";
        }
        throw new DbException(why, 0, DbProvider.PostgreSQL);
    }

    /// <summary>获取最后一条错误消息。</summary>
    string GetError() { return this.lastError; }

    /// 服务器在 ParameterStatus 里报的版本串（如 "16.4"）与会话
    /// 编码；连接未建立时为空。
    string serverVersion;
    string clientEncoding;

    /// <summary>开始一个事务（执行 BEGIN）。</summary>
    void BeginTransaction() { this.Execute("BEGIN"); }

    /// <summary>提交当前事务。</summary>
    void Commit() { this.Execute("COMMIT"); }

    /// <summary>回滚当前事务。</summary>
    void Rollback() { this.Execute("ROLLBACK"); }

    // ===== 协程对应方法 =====
    // 参数化协程历来命名为 QueryParamsAsync / ExecuteParamsAsync；
    // 这些重载让它们采用接口命名，使生成的 ORM 终端节点可以用
    // 统一名称调用。

    /// <see cref="QueryParamsAsync"/> 的接口命名别名（IDbExecutor 用）。
    async DbResult QueryAsync(string sql, DbParams prms) {
        return await this.QueryParamsAsync(sql, prms);
    }

    /// <see cref="ExecuteParamsAsync"/> 的接口命名别名。
    async int ExecuteAsync(string sql, DbParams prms) {
        return await this.ExecuteParamsAsync(sql, prms);
    }

    /// <see cref="ExecuteScalar(string)"/> 的协程版本。
    async string ExecuteScalarAsync(string sql) {
        DbResult r = await this.QueryAsync(sql);
        if (r.RowCount() == 0) { return ""; }
        return r.GetString(0, 0);
    }

    /// <see cref="ExecuteScalar(string, DbParams)"/> 的协程版本。
    async string ExecuteScalarAsync(string sql, DbParams prms) {
        DbResult r = await this.QueryParamsAsync(sql, prms);
        if (r.RowCount() == 0) { return ""; }
        return r.GetString(0, 0);
    }

    /// 协程版事务：执行 BEGIN，恒返回 true。
    async bool BeginTransactionAsync() { int _n = await this.ExecuteAsync("BEGIN"); return true; }
    /// 协程版提交：执行 COMMIT，恒返回 true。
    async bool CommitAsync() { int _n = await this.ExecuteAsync("COMMIT"); return true; }
    /// 协程版回滚：执行 ROLLBACK，恒返回 true。
    async bool RollbackAsync() { int _n = await this.ExecuteAsync("ROLLBACK"); return true; }

    /// <summary>关闭数据库连接：尽力发送 Terminate('X')，然后收尾
    /// TLS 与套接字。安全释放互斥门控并唤醒所有等待者。同步通道的
    /// Terminate 走 TLS 加密；异步 TLS 通道直接关套接字（对端以
    /// EOF 收尾，等价干净），因为 Close 无协程上下文可用。</summary>
    void Close() {
        this.ReleaseLock();
        while (this.waiters != null && this.waiters.Count > 0) {
            AsyncGate g = this.waiters[0];
            this.waiters.RemoveAt(0);
            g.Signal();
        }
        if (this.sock >= 0) {
            if (this.connected && this.syncTls != null) {
                this.sendMessageSync(88, this.bb, 0);  // 'X' Terminate
            } else if (this.connected && this.tls == null) {
                byte[] bye = new byte[6];
                bye[0] = 88;  // 'X'
                bye[1] = 0; bye[2] = 0; bye[3] = 0; bye[4] = 4;
                Socket.Send(this.sock, bye, 5);
            }
            if (this.tls != null) {
                this.tls.Close();  // 不拥有底层 fd
                this.tls = null;
            }
            this.syncTls = null;
            Socket.Close(this.sock);
            this.sock = -1;
        }
        this.connected = false;
    }

    /// <summary>返回连接是否已打开。</summary>
    bool IsConnected() { return this.connected; }

    /// <summary>返回提供程序 ID（DbProvider.PostgreSQL）。</summary>
    int GetProvider() { return DbProvider.PostgreSQL; }

    /// <summary>释放连接持有的资源（实现 IDisposable，等同于 Close）。</summary>
    void Dispose() {
        this.Close();
    }
}
