using System;
using System.Data;

namespace System.Data.Postgres;

// DbPool 的 PostgreSQL 形态，与 <see cref="PgConnector.Pool"/> 工厂配对。
// 官方工厂返回的是通用 DbPool，而类型化 <see cref="PgPool"/> 在归还时
// 清残留事务（P2-29）的收尾对通用池不生效——通用池只认 IDbConnection，
// 读不到 inTxn。这里覆写 Release 补齐同款清理，两个通路行为一致。
public class PgDbPool : DbPool {
    public PgDbPool(string conninfo, int maxSize)
            : base(new PgConnector(conninfo), maxSize) {
    }

    // 归还前把没收尾的事务回滚掉再入池（P2-29，与 PgPool.Release 同规）。
    // UnitOfWork 用户不受影响（它本来就先 Rollback）；回滚失败也放行
    // ——连接仍可用，下一位使用者的显式 BEGIN 会撞上残留事务报错，可定位。
    public override void Release(IDbConnection c) {
        if (c is PgConnection) {
            PgConnection pc = (PgConnection)c;
            if (pc.inTxn) {
                try { pc.Rollback(); } catch (DbException e) { }
                pc.inTxn = false;
            }
        }
        base.Release(c);
    }
}
