using System;
using System.Data;

namespace System.Data.Postgres;

// PostgreSQL 通用连接池（与 PgConnector.Pool 配对）：归还时自动回滚残留未收尾事务。
public class PgDbPool : DbPool {
    public PgDbPool(string conninfo, int maxSize)
            : base(new PgConnector(conninfo), maxSize) {
    }

    // 归还前先回滚残留事务，异常或断连则直接关闭并剔除。
    public override void Release(IDbConnection c) {
        if (c is PgConnection) {
            PgConnection pc = (PgConnection)c;
            if (pc.inTxn) {
                bool failed = false;
                try { pc.Rollback(); } catch (Exception _ex) { failed = true; }
                pc.inTxn = false;
                if (failed || !pc.IsConnected()) {
                    pc.Close();
                    this.Drop(pc);
                    return;
                }
            }
        }
        base.Release(c);
    }
}
