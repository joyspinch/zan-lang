using System;
using System.Data;
using System.Data.Orm;

class DbValue {
    string name;
    int kind;
    string text;
    long ival;
    double dval;

    DbValue(string name, int kind, string text, long ival, double dval) {
        this.name = name;
        this.kind = kind;
        this.text = text;
        this.ival = ival;
        this.dval = dval;
    }
}

// 用于仅存在于运行期数据的有序、带类型列集合——如
// 提交的表单、解析出的 JSON 主体、电子表格行——使动态写入
// 无需手写 SQL：
// .Set(BlogCols.clicks, 5);
// 生成的代码会校验键是否属于实体的列，且
// 值始终作为参数绑定，绝不内联进 SQL 文本。
// ORM 生成的 `&lt;Entity&gt;Cols` 类为列名提供
// 自动补全，代替裸字符串字面量。
