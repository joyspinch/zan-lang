using System;
using System.Data;

namespace System.Data.Odbc;

// 基于通用 ODBC DbConnection 实现的 IDbConnector（同步调用，连接池负责复用与并发上限控制）。
public class OdbcConnector : IDbConnector {
    public string connectionString;
    public int provider;

    public OdbcConnector(string connectionString, int provider) {
        this.connectionString = connectionString;
        this.provider = provider;
    }

    // 根据连接字符串构建的 ODBC 连接池。
    public static DbPool Pool(string connectionString, int provider, int maxSize) {
        return new DbPool(new OdbcConnector(connectionString, provider), maxSize);
    }

    // 打开一个新连接。ODBC 调用是同步的：打开在调用线程完成，
    // 返回的连接可立即使用（协程在此不挂起）。
    public async IDbConnection ConnectAsync() {
        return DbConnection.OpenWith(this.connectionString, this.provider);
    }

    // 池的 provider id（构造时传入）。
    public int GetProvider() {
        return this.provider;
    }
}
