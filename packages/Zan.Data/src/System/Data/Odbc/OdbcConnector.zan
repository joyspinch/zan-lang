using System;
using System.Data;

namespace System.Data.Odbc;

// 基于通用 ODBC <see cref="DbConnection"/> 实现的 <see cref="IDbConnector"/>，
// 因此凡是通过 DSN/驱动可访问的引擎都能获得与原生驱动相同的
// 协程感知连接池。
// ODBC 调用是同步的，所以连接池只提供生命周期管理——
// 连接复用与并发连接上限，等待者以协程挂起
// 而非阻塞线程——并非非阻塞 IO。
// 用法：
// 核心契约与语义定义。
// DbResult r = db.Query("SELECT 1");
// pool.Release(db);
class OdbcConnector : IDbConnector {
    string connectionString;
    int provider;

    OdbcConnector(string connectionString, int provider) {
        this.connectionString = connectionString;
        this.provider = provider;
    }

    // 根据连接字符串构建的 ODBC 连接池。
    static DbPool Pool(string connectionString, int provider, int maxSize) {
        return new DbPool(new OdbcConnector(connectionString, provider), maxSize);
    }

    // 打开一个新连接。ODBC 调用是同步的：打开在调用线程完成，
    // 返回的连接可立即使用（协程在此不挂起）。
    async IDbConnection ConnectAsync() {
        return DbConnection.OpenWith(this.connectionString, this.provider);
    }

    // 池的 provider id（构造时传入）。
    int GetProvider() {
        return this.provider;
    }
}
