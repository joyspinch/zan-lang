using System;

namespace System.Data;

// 数据库语句或连接执行失败时抛出的异常（空结果集一律表示无行，不再掩盖错误）。
// Code 为驱动原生错误号（未到达服务端时为 0），Provider 为 DbProvider 中的驱动 id。
public class DbException : Exception {
    // 驱动自身的错误号；失败未到达服务器时为 0。
    public int Code;
    // 抛出异常的驱动在 DbProvider 中的 id。
    public int Provider;

    // 构造异常（code 为驱动错误号，provider 为 DbProvider id）。
    public DbException(string message, int code, int provider) {
        Message = message;
        Code = code;
        Provider = provider;
    }

    // 构造未到达服务器的本地失败异常（Code=0，Provider=Unknown）。
    public static DbException Of(string message) {
        return new DbException(message, 0, DbProvider.Unknown);
    }
}
