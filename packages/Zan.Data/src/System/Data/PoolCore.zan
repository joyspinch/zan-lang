using System;
using System.Threading;
namespace System.Data;

public async delegate T PoolOpenAsync<T>();
public delegate void PoolOpenFailure<T>(T connection, Exception error);

public class PoolCore<T> {
    int maxSize;
    List<T> idle;
    List<T> borrowed;
    int liveCount;
    int waiting;
    Gate gate;
    bool closed;
    bool openFailed;
    int skipped;
    int retryEvery;

    public PoolCore(int maxSize) {
        if (maxSize < 1) { maxSize = 1; }
        this.maxSize = maxSize;
        this.idle = new List<T>();
        this.borrowed = new List<T>();
        this.liveCount = 0;
        this.waiting = 0;
        this.gate = new Gate();
        this.closed = false;
        this.openFailed = false;
        this.skipped = 0;
        this.retryEvery = 64;
    }

    // 回调按次传入而非长期持有，避免实例打开器与连接池形成 ARC 环。
    public async T AcquireAsync(PoolOpenAsync<T> open, Predicate<T> connected,
                                Action<T> close, PoolOpenFailure<T> failed) {
        if (open == null) { return null; }
        PoolWait wait = null;
        while (!this.IsClosed()) {
            T pooled = this.TryAcquireIdle(connected, close);
            if (pooled != null) { return pooled; }
            if (this.OpenBlocked()) { return null; }
            if (this.TryReserve()) {
                T opened = null;
                bool pending = true;
                try {
                    try {
                        opened = await open();
                    } catch (Exception error) {
                        this.ReportOpenFailure(opened, error, failed);
                        return null;
                    }
                    if (opened == null || (connected != null && !connected(opened))) {
                        this.ReportOpenFailure(opened, null, failed);
                        return null;
                    }
                    bool borrowed = this.CompleteReserve(opened, true);
                    pending = false;
                    if (!borrowed) {
                        if (close != null) { close(opened); }
                        return null;
                    }
                    return opened;
                } finally {
                    if (pending) {
                        try {
                            if (opened != null && close != null) { close(opened); }
                        } finally {
                            this.UndoReserve();
                        }
                    }
                }
            }
            if (this.IsClosed()) { return null; }
            if (wait == null) { wait = new PoolWait(); }
            if (!await this.WaitForRelease(wait)) { return null; }
        }
        return null;
    }

    public T TryAcquireIdle(Predicate<T> connected, Action<T> close) {
        T pooled = this.TakeIdle();
        while (pooled != null) {
            bool usable = false;
            try {
                usable = connected == null || connected(pooled);
                if (usable) { return pooled; }
            } finally {
                if (!usable) {
                    try {
                        if (close != null) { close(pooled); }
                    } finally {
                        this.Drop(pooled);
                    }
                }
            }
            pooled = this.TakeIdle();
        }
        return null;
    }

    void ReportOpenFailure(T connection, Exception error, PoolOpenFailure<T> failed) {
        if (this.BeginOpenFailure() && failed != null) { failed(connection, error); }
    }

    T TakeIdleEntry(bool requireClosed) {
        lock (this) {
            if (this.closed != requireClosed || this.idle.Count == 0) {
                return null;
            }
            int last = this.idle.Count - 1;
            T c = this.idle[last];
            this.idle.RemoveAt(last);
            this.borrowed.Add(c);
            return c;
        }
    }

    public T TakeIdle() { return this.TakeIdleEntry(false); }

    // 仅回收仍在 borrowed 中的连接，避免重复归还误释放槽位；返回 false 表示池已关闭需调用方销毁。
    public bool Pool(T c) {
        lock (this) {
            if (!this.RemoveBorrowed(c)) { return true; }
            if (this.closed) {
                if (this.liveCount > 0) { this.liveCount = this.liveCount - 1; }
                return false;
            }
            this.idle.Add(c);
            if (this.waiting > 0) { this.gate.Signal(); }
            return true;
        }
    }

    public T TakeClosing() { return this.TakeIdleEntry(true); }

    // 只有确实从 borrowed 摘除才递减 liveCount，防止重复 Drop 把 liveCount 减穿而超限建连。
    public void Drop(T c) {
        lock (this) {
            if (!this.RemoveBorrowed(c)) { return; }
            if (this.liveCount > 0) { this.liveCount = this.liveCount - 1; }
            if (this.waiting > 0) { this.gate.Signal(); }
        }
    }

    public bool Borrow(T c) { return this.CompleteReserve(c, false); }

    bool CompleteReserve(T c, bool clearBackoff) {
        lock (this) {
            if (this.closed) {
                if (this.liveCount > 0) { this.liveCount = this.liveCount - 1; }
                return false;
            }
            this.borrowed.Add(c);
            if (clearBackoff) {
                this.openFailed = false;
                this.skipped = 0;
            }
            return true;
        }
    }

    public bool TryReserve() {
        lock (this) {
            if (!this.closed && this.liveCount < this.maxSize) {
                this.liveCount = this.liveCount + 1;
                return true;
            }
            return false;
        }
    }

    public void UndoReserve() {
        lock (this) {
            if (this.liveCount > 0) { this.liveCount = this.liveCount - 1; }
            if (this.waiting > 0) { this.gate.Signal(); }
        }
    }

    public bool RemoveBorrowed(T c) {
        lock (this) {
            int n = this.borrowed.Count;
            for (int i = 0; i < n; i = i + 1) {
                if (this.borrowed[i] == c) {
                    this.borrowed.RemoveAt(i);
                    return true;
                }
            }
            return false;
        }
    }

    // 后端不可达时按计数退避（每 retryEvery 次放行一次重试），不依赖时钟，跨平台一致。
    public bool OpenBlocked() {
        lock (this) {
            if (!this.openFailed) { return false; }
            this.skipped = this.skipped + 1;
            if (this.skipped >= this.retryEvery) {
                this.skipped = 0;
                return false;
            }
            return true;
        }
    }

    public void NoteOpenFailed() { this.BeginOpenFailure(); }

    bool BeginOpenFailure() {
        lock (this) {
            bool first = !this.openFailed;
            this.openFailed = true;
            this.skipped = 0;
            return first;
        }
    }

    public void NoteOpenOk() {
        lock (this) {
            this.openFailed = false;
            this.skipped = 0;
        }
    }

    public bool OpenFailing() {
        lock (this) { return this.openFailed; }
    }

    public Gate Waiter() { return this.gate; }

    public void EnterWait() {
        lock (this) { this.waiting = this.waiting + 1; }
    }

    public void LeaveWait() {
        lock (this) {
            if (this.waiting > 0) { this.waiting = this.waiting - 1; }
        }
    }

    public int IdleCount() { lock (this) { return this.idle.Count; } }
    public int LiveCount() { lock (this) { return this.liveCount; } }
    public int WaitingCount() { lock (this) { return this.waiting; } }
    public int MaxSize() { return this.maxSize; }
    public bool IsClosed() { lock (this) { return this.closed; } }

    public void MarkClosed() {
        lock (this) { this.closed = true; }
    }

    public void WakeAll() {
        int n = 0;
        lock (this) { n = this.waiting; }
        for (int k = 0; k < n; k = k + 1) { this.gate.Signal(); }
    }

    // 先在锁内复查再入 Gate 停泊以防丢唤醒；门等耗尽后切短轮询直至预算用完。
    public async bool WaitForRelease(PoolWait w) {
        if (w == null) { return false; }
        if (w.gated < PoolWait.MaxGateWaits) {
            lock (this) {
                if (this.closed || this.idle.Count > 0 || this.liveCount < this.maxSize) {
                    return true;
                }
                this.waiting = this.waiting + 1;
            }
            try {
                await this.gate.Wait(PoolWait.GateWaitMs);
            } finally {
                this.LeaveWait();
            }
            w.gated = w.gated + 1;
            return true;
        }
        await Task.Delay(PoolWait.PollStepMs);
        w.budget = w.budget - PoolWait.PollStepMs;
        return w.budget > 0;
    }
}
