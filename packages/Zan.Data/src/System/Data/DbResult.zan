using System;
using System.Text;

namespace System.Data;

/// <summary>单元格存储类别：0 = SQL NULL，1 = 整数（ival 有效），
/// 2 = 文本（texts 同下标有效）。整数格读取时直接存整型，避免每次物化字符串；
/// 实数/大对象沿用文本通道——sqlite REAL 的 column_text 形如 "2.0"，与 double 的最短往返格式（"2"）不同，
/// 直接存 double 会在 GetString 上引入静默兼容差异。</summary>
struct DbCell {
    /// 0 = SQL NULL；1 = 整数；2 = 文本。
    public int kind;
    /// kind 1 的 64 位整数值。
    public long ival;
}

/// <summary>一行结果：类型化单元格带（kind/ival）与文本载荷平行表。
/// cells 刻意保持纯 POD（无 ARC 指针字段）——List&lt;struct&gt; 每次
/// 下标读都按位拷贝，带指针字段就会每次 retain/release，纯 POD 才能
/// 当数组用（同 JsonSlot/JsonPair 的取舍）；文本放 texts 平行表，
/// 只在 kind 2 时读取。两表长度恒相等。</summary>
class DbRow {
    List<DbCell> cells;
    List<string> texts;

    DbRow(List<DbCell> cells, List<string> texts) {
        this.cells = cells;
        this.texts = texts;
    }

    /// <summary>返回该行的字段总数。</summary>
    int Count() {
        if (this.cells == null) { return 0; }
        return this.cells.Count;
    }

    /// <summary>获取指定列索引处的字符串值。</summary>
    string GetString(int col) {
        if (this.cells == null || col < 0 || col >= this.cells.Count) {
            return "";
        }
        DbCell cell = this.cells[col];
        if (cell.kind == 1) {
            return Convert.ToString(cell.ival);
        }
        if (cell.kind == 2) {
            return this.texts[col];
        }
        return "";
    }

    /// <summary>指定列是否为 SQL NULL。</summary>
    bool IsNull(int col) {
        if (this.cells != null && col >= 0 && col < this.cells.Count) {
            return this.cells[col].kind == 0;
        }
        return false;
    }

    /// <summary>获取指定列索引处的整数值。</summary>
    int GetInt(int col) {
        if (this.cells != null && col >= 0 && col < this.cells.Count
            && this.cells[col].kind == 1) {
            return (int)this.cells[col].ival;
        }
        string val = this.GetString(col);
        if (val.Length == 0) { return 0; }
        return Convert.ToInt(val);
    }

    /// <summary>获取指定列索引处的 64 位整数值。</summary>
    long GetLong(int col) {
        if (this.cells != null && col >= 0 && col < this.cells.Count
            && this.cells[col].kind == 1) {
            return this.cells[col].ival;
        }
        string val = this.GetString(col);
        if (val.Length == 0) { return 0; }
        return Convert.ToInt64(val);
    }

    /// <summary>获取指定列索引处的双精度浮点值。</summary>
    double GetDouble(int col) {
        if (this.cells != null && col >= 0 && col < this.cells.Count
            && this.cells[col].kind == 1) {
            return (double)this.cells[col].ival;
        }
        string val = this.GetString(col);
        if (val.Length == 0) { return 0.0; }
        return Encoding.ParseDouble(val);
    }

    /// <summary>获取指定列索引处的布尔值。</summary>
    bool GetBool(int col) {
        if (this.cells != null && col >= 0 && col < this.cells.Count
            && this.cells[col].kind == 1) {
            return this.cells[col].ival == 1;
        }
        string val = this.GetString(col);
        return val == "1" || val == "true" || val == "True";
    }
}

/// <summary>
/// 表示一次数据库查询的结果集。
/// 以类型化单元格存储各行，并附带列名元数据。
/// </summary>
class DbResult {
    List<DbRow> rows;
    List<string> columnNames;
    int columnCount;
    Dict<string, int> colMap;

    DbResult() {
        this.rows = new List<DbRow>();
        this.columnNames = new List<string>();
        this.columnCount = 0;
        this.colMap = null;
    }

    /// <summary>创建空结果（无行）。</summary>
    static DbResult Empty() {
        return new DbResult();
    }

    /// <summary>设置列数。</summary>
    void SetColumnCount(int count) {
        this.columnCount = count;
    }

    /// <summary>添加一个列名。</summary>
    void AddColumnName(string name) {
        this.columnNames.Add(name);
        this.colMap = null;
    }

    /// <summary>添加一行已物化的单元格（驱动快路径：整数格免字符串
    /// 物化）。cells 与 texts 长度必须一致；文本格的载荷在 texts。</summary>
    void AddRowCells(List<DbCell> cells, List<string> texts) {
        this.rows.Add(new DbRow(cells, texts));
    }

    /// <summary>添加一行值（不含 SQL NULL）。</summary>
    void AddRow(List<string> row) {
        List<DbCell> cells = new List<DbCell>();
        for (int i = 0; i < row.Count; i = i + 1) {
            DbCell cell = new DbCell();
            cell.kind = 2;
            cells.Add(cell);
        }
        this.rows.Add(new DbRow(cells, row));
    }

    /// <summary>添加一行，并附逐列的 SQL NULL 标记，调用方
    /// 可通过 IsNull() 区分 NULL 与空字符串。</summary>
    void AddRowNulls(List<string> row, List<bool> nullFlags) {
        List<DbCell> cells = new List<DbCell>();
        for (int i = 0; i < row.Count; i = i + 1) {
            DbCell cell = new DbCell();
            if (nullFlags != null && i < nullFlags.Count && nullFlags[i]) {
                cell.kind = 0;
            } else {
                cell.kind = 2;
            }
            cells.Add(cell);
        }
        this.rows.Add(new DbRow(cells, row));
    }

    /// <summary>单元格为 SQL NULL 时为 true（空字符串则相反，
    /// GetString 对空字符串同样返回 ""）。</summary>
    bool IsNull(int row, int col) {
        if (row >= 0 && row < this.rows.Count) {
            return this.rows[row].IsNull(col);
        }
        return false;
    }

    /// <summary>按列名检查是否为 NULL。</summary>
    bool IsNullByName(int row, string columnName) {
        return IsNull(row, GetColumnIndex(columnName));
    }

    /// <summary>返回行数。</summary>
    int RowCount() {
        return this.rows.Count;
    }

    /// <summary>返回列数。</summary>
    int ColumnCount() {
        return this.columnCount;
    }

    /// <summary>获取指定行列索引处的字符串值。</summary>
    string GetString(int row, int col) {
        if (row >= 0 && row < this.rows.Count) {
            return this.rows[row].GetString(col);
        }
        return "";
    }

    /// <summary>获取指定行列索引处的整数值。</summary>
    int GetInt(int row, int col) {
        if (row >= 0 && row < this.rows.Count) {
            return this.rows[row].GetInt(col);
        }
        return 0;
    }

    /// <summary>获取指定行列索引处的 64 位整数值。</summary>
    long GetLong(int row, int col) {
        if (row >= 0 && row < this.rows.Count) {
            return this.rows[row].GetLong(col);
        }
        return 0;
    }

    /// <summary>获取指定行列索引处的双精度值。</summary>
    double GetDouble(int row, int col) {
        if (row >= 0 && row < this.rows.Count) {
            return this.rows[row].GetDouble(col);
        }
        return 0.0;
    }

    /// <summary>获取指定行列索引处的布尔值。</summary>
    bool GetBool(int row, int col) {
        if (row >= 0 && row < this.rows.Count) {
            return this.rows[row].GetBool(col);
        }
        return false;
    }

    /// <summary>按行索引和列名取值。</summary>
    string GetByName(int row, string columnName) {
        int col = GetColumnIndex(columnName);
        if (col >= 0) {
            return GetString(row, col);
        }
        return "";
    }

    /// <summary>按列名获取列索引。内部带有懒加载字典索引缓存，将大数据量高频调用从 O(N) 线性扫描降为 O(1)。</summary>
    int GetColumnIndex(string name) {
        if (this.colMap == null) {
            this.colMap = new Dict<string, int>();
            for (int i = 0; i < this.columnNames.Count; i = i + 1) {
                if (!this.colMap.ContainsKey(this.columnNames[i])) {
                    this.colMap.Add(this.columnNames[i], i);
                }
            }
        }
        if (this.colMap.ContainsKey(name)) {
            return this.colMap[name];
        }
        return -1;
    }

    /// <summary>获取指定索引处的列名。</summary>
    string GetColumnName(int index) {
        if (index >= 0 && index < this.columnNames.Count) {
            return this.columnNames[index];
        }
        return "";
    }

    /// <summary>返回所有列名（内部列表的副本，调用方改动
    /// 不会影响本结果集）。</summary>
    List<string> GetColumnNames() {
        List<string> copy = new List<string>();
        for (int i = 0; i < this.columnNames.Count; i = i + 1) {
            copy.Add(this.columnNames[i]);
        }
        return copy;
    }

    /// <summary>检查结果集是否包含行。</summary>
    bool HasRows() {
        return this.rows.Count > 0;
    }

    /// <summary>返回指定索引处的只读行实体（零列表克隆，大数据量循环极速读取推荐）。</summary>
    DbRow RowAt(int index) {
        if (index >= 0 && index < this.rows.Count) {
            return this.rows[index];
        }
        return null;
    }

    /// <summary>将整行作为字符串列表返回（内部行的副本）。</summary>
    List<string> GetRow(int index) {
        if (index >= 0 && index < this.rows.Count) {
            List<string> copy = new List<string>();
            DbRow src = this.rows[index];
            for (int i = 0; i < src.Count(); i = i + 1) {
                copy.Add(src.GetString(i));
            }
            return copy;
        }
        return new List<string>();
    }

    /// <summary>获取第一行（便捷方法）。</summary>
    List<string> First() {
        return GetRow(0);
    }

    /// <summary>将结果集打印到控制台（用于调试）。</summary>
    void Print() {
        // 打印列标题
        StringBuilder headerSb = new StringBuilder();
        for (int c = 0; c < this.columnNames.Count; c = c + 1) {
            if (c > 0) { headerSb.Append("\t"); }
            headerSb.Append(this.columnNames[c]);
        }
        Console.WriteLine(headerSb.ToString());

        // 打印分隔线
        Console.WriteLine("---");

        // 打印各行（整数格按 GetString 的十进制格式物化）
        for (int r = 0; r < this.rows.Count; r = r + 1) {
            StringBuilder rowSb = new StringBuilder();
            DbRow row = this.rows[r];
            for (int cc = 0; cc < row.Count(); cc = cc + 1) {
                if (cc > 0) { rowSb.Append("\t"); }
                rowSb.Append(row.GetString(cc));
            }
            Console.WriteLine(rowSb.ToString());
        }
    }
}
