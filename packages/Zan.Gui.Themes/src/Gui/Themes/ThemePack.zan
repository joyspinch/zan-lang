using System;
using System.IO;
using Gui;

namespace Gui.Themes;

// 官方精选视觉主题包 (Zan.Gui.Themes)
// 内含 14 款开箱即用的专业视觉风格，支持通过名字或强类型常量一键换肤。
public class ThemePack {
    public const string Brutalism = "brutalism";
    public const string Chinese = "chinese";
    public const string DarkGold = "darkgold";
    public const string Dreamy = "dreamy";
    public const string Emerald = "emerald";
    public const string Fortune = "fortune";
    public const string GameHud = "gamehud";
    public const string LiquidGlass = "liquidglass";
    public const string Matrix = "matrix";
    public const string Mono = "mono";
    public const string Neon = "neon";
    public const string PeachBlossom = "peachblossom";
    public const string RetroAmber = "retroamber";
    public const string Sunset = "sunset";

    // 获取所有可用主题名称列表
    public static List<string> All() {
        List<string> list = new List<string>();
        list.Add(ThemePack.Brutalism);
        list.Add(ThemePack.Chinese);
        list.Add(ThemePack.DarkGold);
        list.Add(ThemePack.Dreamy);
        list.Add(ThemePack.Emerald);
        list.Add(ThemePack.Fortune);
        list.Add(ThemePack.GameHud);
        list.Add(ThemePack.LiquidGlass);
        list.Add(ThemePack.Matrix);
        list.Add(ThemePack.Mono);
        list.Add(ThemePack.Neon);
        list.Add(ThemePack.PeachBlossom);
        list.Add(ThemePack.RetroAmber);
        list.Add(ThemePack.Sunset);
        return list;
    }

    static Dict<string, string> cssCache;
    static Dict<string, StyleSheet> sheetCache;

    // 判断指定名称的主题是否存在
    public static bool Exists(string name) {
        if (name == null || name.Length == 0) return false;
        string n = name.ToLower().Trim();
        List<string> all = ThemePack.All();
        for (int i = 0; i < all.Count; i = i + 1) {
            if (all[i] == n) return true;
        }
        return false;
    }

    // 获取指定主题的 CSS 样式表文本（优先读取外部文件，未找到则回退内置资源；自动进行内存缓存）
    public static string GetCss(string name) {
        if (!ThemePack.Exists(name)) return "";
        string n = name.ToLower().Trim();
        if (cssCache == null) {
            cssCache = new Dict<string, string>();
        }
        if (cssCache.ContainsKey(n)) {
            return cssCache[n];
        }

        string css = "";
        string diskPath = "packages/Zan.Gui.Themes/skins/" + n + "/skin.css";
        if (File.Exists(diskPath)) {
            try {
                css = File.ReadAllText(diskPath);
            } catch (Exception) {}
        }

        if (css == "") {
            css = ThemePack.GetEmbeddedCss(n);
        }
        cssCache[n] = css;
        return css;
    }

    // 获取已解析的强类型 StyleSheet 对象（带内存缓存，消除重复解析开销）
    public static StyleSheet GetStyleSheet(string name) {
        if (!ThemePack.Exists(name)) return null;
        string n = name.ToLower().Trim();
        if (sheetCache == null) {
            sheetCache = new Dict<string, StyleSheet>();
        }
        if (sheetCache.ContainsKey(n)) {
            return sheetCache[n];
        }

        string css = ThemePack.GetCss(n);
        if (css.Length == 0) return null;
        StyleSheet sheet = StyleSheet.FromCss(css);
        sheetCache[n] = sheet;
        return sheet;
    }

    // 将指定主题应用至指定的 App 实例（直接复用预编译 StyleSheet 零开销注入）
    public static bool Apply(App app, string name) {
        if (app == null || !ThemePack.Exists(name)) return false;
        StyleSheet sheet = ThemePack.GetStyleSheet(name);
        if (sheet == null) return false;
        app.UseSheet(sheet);
        return true;
    }

    private static string GetEmbeddedCss(string name) {
        if (name == "brutalism") {
            return ":root { --name: \"粗野主义\"; --order: 4; --dark: 0; --base: light; --primary: #ff5c78; --primary-hover: #ff7a92; --primary-pressed: #e03c5c; --info: #2d5cff; --info-hover: #2d5cff; --info-pressed: #2d5cff; --success: #26c878; --success-hover: #26c878; --success-pressed: #26c878; --warning: #ffc428; --warning-hover: #ffc428; --warning-pressed: #ffc428; --error: #ff4646; --error-hover: #ff4646; --error-pressed: #ff4646; --text-primary: #0c0c0c; --text-secondary: #262626; --text-tertiary: #5c5c5c; --text-disabled: #5c5c5c; --bg-primary: #f7f4ea; --bg-secondary: #ffffff; --bg-tertiary: #ffec78; --bg-hover: #f0ece0; --bg-active: #e4e0d4; --bg-disabled: #ffffff; --border-primary: #0c0c0c; --border-secondary: #0c0c0c; --border-hover: #0c0c0c; --border-focus: #0c0c0c; --divider: #0c0c0c; --scrollbar: #0c0c0c; --scrollbar-hover: #5c5c5c; --shadow-color: #0c0c0c; --border-radius-small: 0; --border-radius-medium: 0; --border-radius-large: 0; --border-width: 3; --brutal: 1; }";
        }
        if (name == "chinese") {
            return ":root { --name: \"国风\"; --order: 5; --dark: 0; --base: light; --primary: #b42d28; --primary-hover: #ca423c; --primary-pressed: #96201c; --info: #3a5c82; --info-hover: #3a5c82; --info-pressed: #3a5c82; --success: #5e8a5a; --success-hover: #5e8a5a; --success-pressed: #5e8a5a; --warning: #c69436; --warning-hover: #c69436; --warning-pressed: #c69436; --error: #962420; --error-hover: #962420; --error-pressed: #962420; --text-primary: #2b2621; --text-secondary: #5c5247; --text-tertiary: #968a7a; --text-disabled: #968a7a; --text-inverse: #faf4e8; --bg-primary: #f4eee1; --bg-secondary: #ede5d4; --bg-tertiary: #e4dac6; --bg-hover: #dfd2b8; --bg-active: #d1bf9f; --bg-disabled: #ede5d4; --border-primary: #cebea0; --border-secondary: #cebea0; --border-hover: #b42d28; --border-focus: #b42d28; --divider: #cebea0; --scrollbar: #cebea0; --scrollbar-hover: #968a7a; --fx: 4; }";
        }
        if (name == "darkgold") {
            return ":root { --name: \"暗金\"; --order: 12; --base: dark; --dark: 1; --primary: #c9962f; --primary-hover: #e0ae43; --primary-pressed: #a87b21; --info: #7c9ec9; --info-hover: #93b2d9; --info-pressed: #6785ac; --success: #6faa5e; --success-hover: #85c073; --success-pressed: #5b8f4c; --warning: #d99a35; --warning-hover: #ecae49; --warning-pressed: #bb8028; --error: #c0553f; --error-hover: #d66c55; --error-pressed: #a24431; --bg-primary: #14110d; --bg-secondary: #1c1813; --bg-tertiary: #251f18; --bg-hover: #32281e; --bg-active: #4a3a28; --bg-disabled: #201c16; --bg-grad-top: #1c1813; --bg-grad-bottom: #0a0806; --text-primary: #f0e6d2; --text-secondary: #c8b795; --text-tertiary: #9a8a6b; --text-disabled: #6f6350; --text-inverse: #14110d; --border-primary: #4a3d28; --border-secondary: #332a1c; --border-hover: #8a6f3a; --border-focus: #c9962f; --divider: #332a1c; --shadow-color: #66000000; --border-radius-small: 2; --border-radius-medium: 4; --border-radius-large: 6; --border-width: 1; --gradient: 1; --fx: 10; --art-opacity: 45; --bronze: #c9962f; --bronze-lit: #f0c765; --basalt: #0f0d0a; } card, panel, dialog, popup { background: linear-gradient(rgba(52, 44, 33, 0.48), rgba(30, 25, 19, 0.30)); border: 1 #4a3d28; border-radius: 8px; box-shadow: 0 8 18 rgba(0, 0, 0, 0.6); padding: 16px; } card { border-top: 1 #6b5730; } button { border-radius: var(--radius-medium); padding: 0 var(--padding-large); font-weight: 600; text-transform: uppercase; letter-spacing: 1; transition: var(--anim-medium) ease-in-out; cursor: pointer; } button.primary { background: linear-gradient(to bottom, #d8a63c, #96701d); color: #17130c; border: 1 #f0c765; box-shadow: 0 3 10 rgba(0, 0, 0, 0.55); } button.primary:hover { background: linear-gradient(to bottom, #f0c765, #b4881f); animation: glow 2600ms; } button.primary:active { background: linear-gradient(to bottom, #96701d, #7a5a14); transform: translateY(1px); box-shadow: none; } button.ghost { background: transparent; color: var(--bronze-lit); border: 1 var(--bronze); } button.ghost:hover { background: rgba(201, 150, 47, 0.14); } button.secondary { background: #2c2418; color: var(--bronze-lit); border: 1 #4a3d28; } button.secondary:hover { background: #392f1f; } button:disabled { background: #2a251c; color: #6f6350; border: 1 #3a3226; box-shadow: none; } input, textarea, select { background: var(--basalt); color: #f0e6d2; border: 1 #4a3d28; border-radius: var(--radius-medium); padding: 0 12px; transition: var(--anim-medium) ease-out; } input:hover, select:hover { border-color: #8a6f3a; } input:focus, select:focus { border-color: var(--bronze); box-shadow: 0 0 8 rgba(201, 150, 47, 0.4); } input:disabled { background: #1a1712; color: #6f6350; } tab { color: #c8b795; padding: 0 16px; text-transform: uppercase; letter-spacing: 1; transition: var(--anim-medium) ease-out; } tab:hover { background: rgba(201, 150, 47, 0.08); color: #f0e6d2; } tab:selected { color: var(--bronze-lit); border-bottom: 2 var(--bronze); } tabs { border-bottom: 1 #332a1c; } option, item, row { color: #f0e6d2; border-radius: 4px; padding: 0 12px; } option:hover { background: #2c251c; } option:selected { background: #362d22; color: var(--bronze-lit); }";
        }
        if (name == "dreamy") {
            return ":root { --name: \"梦境\"; --order: 13; --base: dark; --dark: 1; --primary: #a78bfa; --primary-hover: #bda4ff; --primary-pressed: #8b6ce0; --info: #7dd3fc; --info-hover: #99e0ff; --info-pressed: #63b6df; --success: #86efac; --success-hover: #a0f5c0; --success-pressed: #6ad091; --warning: #fcd34d; --warning-hover: #ffe173; --warning-pressed: #dcb531; --error: #fb7185; --error-hover: #ff8d9d; --error-pressed: #dc5a6d; --bg-primary: #1b1730; --bg-secondary: #241f3f; --bg-tertiary: #2e2850; --bg-hover: #342d5c; --bg-active: #3e3670; --bg-disabled: #262138; --bg-grad-top: #2a2450; --bg-grad-bottom: #120f22; --text-primary: #f4f1ff; --text-secondary: #cdc6ee; --text-tertiary: #a49bd0; --text-disabled: #6f6890; --text-inverse: #1b1730; --border-primary: #453c72; --border-secondary: #332c58; --border-hover: #6d5fb0; --border-focus: #a78bfa; --divider: #332c58; --shadow-color: #5a0a0620; --padding-medium: 8; --padding-large: 12; --border-radius-small: 2; --border-radius-medium: 4; --border-radius-large: 6; --border-width: 1; --glass: 0; --gradient: 1; --fx: 11; --art-opacity: 60; --halo: #cbb6ff; } card, panel, dialog, popup { background: rgba(40, 34, 74, 0.55); border: 1 rgba(203, 182, 255, 0.35); border-radius: var(--radius-large); box-shadow: 0 10 24 rgba(10, 6, 30, 0.5); padding: var(--padding-large); } card:hover { border-color: rgba(203, 182, 255, 0.55); } dialog { border-radius: 24px; } button { border-radius: var(--radius-full); padding: 0 var(--padding-large); font-weight: 500; transition: var(--anim-medium) ease-in-out; cursor: pointer; } button.primary { background: linear-gradient(to right, #a78bfa, #7dd3fc); color: #16122a; border: none; box-shadow: 0 4 14 rgba(167, 139, 250, 0.45); } button.primary:hover { background: linear-gradient(to right, #bda4ff, #9ce0ff); transform: scale(1.03); box-shadow: 0 6 20 rgba(167, 139, 250, 0.6); } button.primary:active { transform: scale(0.98); box-shadow: 0 2 8 rgba(167, 139, 250, 0.4); } button.ghost { background: rgba(203, 182, 255, 0.08); color: var(--halo); border: 1 rgba(203, 182, 255, 0.45); } button.ghost:hover { background: rgba(203, 182, 255, 0.18); } button.secondary { background: rgba(203, 182, 255, 0.14); color: #f4f1ff; border: none; } button.secondary:hover { background: rgba(203, 182, 255, 0.24); } button:disabled { background: rgba(111, 104, 144, 0.35); color: #6f6890; border: none; box-shadow: none; } input, textarea, select { background: rgba(18, 15, 34, 0.55); color: #f4f1ff; border: 1 rgba(203, 182, 255, 0.3); border-radius: var(--radius-medium); padding: 0 var(--padding-medium); transition: var(--anim-medium) ease-out; } input:hover, select:hover { border-color: rgba(203, 182, 255, 0.5); } input:focus, select:focus { border-color: #a78bfa; box-shadow: 0 0 10 rgba(167, 139, 250, 0.45); } input:disabled { background: rgba(38, 33, 56, 0.6); color: #6f6890; } tab { color: #cdc6ee; padding: 0 var(--padding-large); border-radius: var(--radius-full); transition: var(--anim-medium) ease-out; } tab:hover { background: rgba(203, 182, 255, 0.12); color: #f4f1ff; } tab:selected { background: rgba(167, 139, 250, 0.22); color: #f4f1ff; border-bottom: 0 transparent; } tab.card:selected { background: rgba(167, 139, 250, 0.3); border-bottom: 0 transparent; } option, item, row { color: #f4f1ff; border-radius: var(--radius-small); padding: 0 var(--padding-medium); } option:hover { background: rgba(203, 182, 255, 0.12); } option:selected { background: rgba(167, 139, 250, 0.26); color: #f4f1ff; }";
        }
        if (name == "emerald") {
            return ":root { --name: \"翠绿\"; --order: 10; --dark: 1; --base: dark; --primary: #48e2a8; --primary-hover: #76f0c0; --primary-pressed: #28be8a; --info: #60d6e0; --info-hover: #60d6e0; --info-pressed: #60d6e0; --success: #78ec96; --success-hover: #78ec96; --success-pressed: #78ec96; --warning: #f0d678; --warning-hover: #f5c878; --warning-pressed: #f5c878; --error: #ff7e84; --error-hover: #ff7882; --error-pressed: #ff7882; --text-primary: #f5f7fb; --text-secondary: #d2d8e4; --text-tertiary: #a5acbc; --text-disabled: #788091; --text-inverse: #14161e; --bg-primary: #181b2c; --bg-secondary: #961a1e32; --bg-tertiary: #6e14182a; --bg-hover: #1e4542; --bg-active: #226b63; --bg-disabled: #325a647d; --border-primary: #38ffffff; --border-secondary: #22ffffff; --border-hover: #48e2a8; --border-focus: #60d6e0; --divider: #1effffff; --overlay: #46000000; --scrollbar: #38ffffff; --scrollbar-hover: #6effffff; --glass: 1; --gradient: 1; --bg-grad-top: #18524a; --bg-grad-bottom: #081a1e; --fx: 2; } --chart-1: #4fd8b8; --chart-2: #a8e26a; --chart-3: #f2d264; --chart-4: #f28a7a; --chart-5: #6ecfe8; --chart-6: #58c98a; --chart-7: #f0a468; --chart-8: #c08ae0; }";
        }
        if (name == "fortune") {
            return ":root { --name: \"福运\"; --order: 14; --base: dark; --dark: 1; --primary: #d92b2b; --primary-hover: #ef4444; --primary-pressed: #b21f1f; --info: #e0a020; --info-hover: #f2b53c; --info-pressed: #c2871a; --success: #43a047; --success-hover: #58b95c; --success-pressed: #34833a; --warning: #e8a33d; --warning-hover: #f4b755; --warning-pressed: #cd8a26; --error: #d64545; --error-hover: #e85f5f; --error-pressed: #b83636; --bg-primary: #2a1113; --bg-secondary: #35171a; --bg-tertiary: #421d21; --bg-hover: #4a2226; --bg-active: #57282c; --bg-disabled: #3a1e21; --bg-grad-top: #35171a; --bg-grad-bottom: #1c0b0d; --text-primary: #fdf0dc; --text-secondary: #e2c69b; --text-tertiary: #b9946a; --text-disabled: #8c6a4c; --text-inverse: #2a1113; --border-primary: #6d3c25; --border-secondary: #4d2a1d; --border-hover: #a6702f; --border-focus: #ffd76a; --divider: #4d2a1d; --shadow-color: #40000000; --overlay: #b31c0a0c; --border-radius-small: 2; --border-radius-medium: 4; --border-radius-large: 6; --border-width: 1; --gradient: 1; --fx: 9; --art-opacity: 55; --gold: #ffd76a; --gold-deep: #e0a020; --lacquer: #8a1c1c; --ink: #3a1214; } card, panel, dialog, popup { background: linear-gradient(rgba(86, 40, 44, 0.48), rgba(58, 24, 27, 0.30)); border: 1 #6d3c25; border-radius: 12px; box-shadow: 0 6 14 rgba(0, 0, 0, 0.45); padding: 16px; } dialog { border-radius: 16px; border: 1 var(--gold-deep); } button { border-radius: 8px; padding: 0 var(--padding-large); font-weight: 600; letter-spacing: 1; transition: var(--anim-fast) ease-out; cursor: pointer; } button.primary { background: linear-gradient(to bottom, #e8413c, #a81616); color: var(--gold); border: 1 #ffd76a; box-shadow: 0 3 8 rgba(0, 0, 0, 0.5); } button.primary:hover { background: linear-gradient(to bottom, #ff5a4f, #c11d1d); transform: translateY(-1px); box-shadow: 0 5 12 rgba(0, 0, 0, 0.55); } button.primary:active { background: linear-gradient(to bottom, #a81616, #8a1010); transform: translateY(1px); box-shadow: none; } button.primary:focus { border-color: #fff0c0; } button.info { background: linear-gradient(to bottom, #ffd76a, #e0a020); color: var(--ink); border: 1 #8a5b12; } button.info:hover { background: linear-gradient(to bottom, #ffe490, #edb436); } button.ghost { background: transparent; color: var(--gold); border: 1 var(--gold-deep); } button.ghost:hover { background: rgba(255, 215, 106, 0.12); } button.text { color: var(--gold); } button.text:hover { background: rgba(255, 215, 106, 0.1); } button:disabled { background: #4a2b2b; color: #8c6a4c; border: 1 #5c3535; box-shadow: none; } input, textarea, select { background: #1f0c0e; color: #fdf0dc; border: 1 #6d3c25; border-radius: 8px; padding: 0 12px; transition: var(--anim-medium) ease-out; } input:hover, select:hover { border-color: #a6702f; } input:focus, select:focus { border-color: var(--gold); box-shadow: 0 0 6 rgba(255, 215, 106, 0.35); } input:disabled { background: #2d1517; color: #8c6a4c; } tab { color: #e2c69b; padding: 0 var(--padding-large); letter-spacing: 1; transition: var(--anim-medium) ease-out; } tab:hover { background: rgba(255, 215, 106, 0.08); color: #fdf0dc; } tab:selected { color: var(--gold); border-bottom: 2 var(--gold); } tab.card:selected { background: linear-gradient(#4a1f22, #35171a); border-radius: 8px 8px 0 0; border-bottom: 0 transparent; } option, item, row { color: #fdf0dc; border-radius: var(--radius-small); padding: 0 12px; } option:hover { background: rgba(255, 215, 106, 0.1); } option:selected { background: #57282c; color: var(--gold); }";
        }
        if (name == "gamehud") {
            return "windowbg { background: transparent; } :root { --name: \"游戏HUD\"; --order: 30; --base: dark; --dark: 1; --primary: #c9962f; --primary-hover: #e0ae43; --primary-pressed: #a87b21; --info: #7c9ec9; --success: #6faa5e; --warning: #d99a35; --error: #c0553f; --bg-primary: #10131a; --bg-secondary: #161a23; --bg-tertiary: #1d222d; --bg-hover: #232937; --bg-active: #2b3242; --bg-disabled: #171a21; --text-primary: #e8e2d4; --text-secondary: #b4ac9a; --text-tertiary: #7d786c; --text-disabled: #565349; --border-primary: #3a3324; --border-secondary: #2c2820; --border-hover: #8a6f33; --border-focus: #c9962f; --radius: 4; --radius-large: 6; --gap-small: 2; --gap-medium: 4; --gap-large: 6; } .hud-panel { background: rgba(12, 14, 20, 0.82); border: 1 #8a6f33; border-radius: var(--radius-large); } .hud-panel:hover { border-color: #c9962f; } .hud-bar { background: rgba(12, 14, 20, 0.82); border: 0 #8a6f33; border-radius: 0; } .hud-chat { background: rgba(10, 12, 17, 0.62); border: 1 #3a3324; border-radius: var(--radius); } .hud-chat .message { color: var(--text-primary); } .hud-chat .message-system { color: var(--warning); } .hud-chat .timestamp { color: var(--text-tertiary); } button.hud { background: transparent; color: var(--text-primary); border: 1 #8a6f33; border-radius: var(--radius); } button.hud:hover { background: #22c9962f; border-color: #c9962f; } button.hud:active { background: #44c9962f; } button.hud.primary { background: linear-gradient(#e0ae43, #a87b21); color: #1a1305; border: 1 #8a6f33; } button.hud.primary:hover { background: linear-gradient(#f0c258, #b98a2c); } button.hud:disabled { color: var(--text-disabled); border-color: var(--border-secondary); } progressbar.hud { background: rgba(8, 9, 13, 0.9); border-radius: var(--radius-medium); border: 1 #2c2820; } progressbar.hud .fill { background: linear-gradient(#6faa5e, #4c7a40); } progressbar.hud.mana .fill { background: linear-gradient(#7c9ec9, #4e6e96); } progressbar.hud.xp .fill { background: linear-gradient(#d99a35, #96691f); } slot.hud { background: rgba(20, 22, 30, 0.9); border: 1 #2c2820; border-radius: var(--radius); } slot.hud:hover { border-color: #8a6f33; } slot.hud.rare { border-color: #7c9ec9; } slot.hud.epic { border-color: #a86fc9; } slot.hud.legendary { border-color: #d99a35; } .hud-title { color: #e8d9a8; font-size: 39; } .hud-subtitle { color: var(--text-secondary); font-size: 30; } .hud-small { color: var(--text-tertiary); font-size: 24; }";
        }
        if (name == "liquidglass") {
