class Worker {
    string protocol;
    string host;
    int port;
    string name;
    bool running;
    // 多进程网络工作单元与内核套接字调度契约。
    // 多进程网络工作单元与内核套接字调度契约。
    // 网络协程状态调度与数据交互。
    // 连接计数器衰减与最大并发连接数限制阈值检查。
    // everything.
    AtomicInt connectionCount;
    int maxConnections;

    // 核心契约与语义定义。
    int maxHeaderBytes;
    int maxRequestBytes;
    int requestTimeout;

    /// 多进程网络工作单元与内核套接字调度契约。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 接口数据协议与执行契约。
    int count;

    // 核心契约与语义定义。
    /// TCP 连接建立后调用（tcp 协议；可 await I/O）。
    ConnectionHandler onConnect;
    /// 收到一条完整入站消息后调用；返回串作为应答回发，返回 "" 不回发。
    MessageHandler onMessage;
    /// 连接关闭（对端断开或 conn.Close() 生效）后调用。
    ConnectionCloseHandler onClose;
    /// 每个解析完成的 HTTP 请求调用，返回响应对象。
    HttpRequestHandler onHttpRequest;
    /// 每个完整 UDP 数据报调用；返回串回发给发送方，返回 "" 不回发。
    DatagramHandler onUdpMessage;
    /// 设置后接管该 Worker 的整条连接：socket 交给回调自主驱动，
    /// 绕过内建协议处理与连接数闸门。
    RawConnHandler onRawConnection;

    // 网络协程状态调度与数据交互。
    // 网络协程状态调度与数据交互。
    // 网络协程状态调度与数据交互。
    // 核心契约与语义定义。
    /// onConnect 的 WebSocket 叫法（连接已建立）。
    ConnectionHandler onOpen;  // websocket: connection established
    /// onMessage 的 TCP 叫法（收到字节）。
    MessageHandler onReceive;  // tcp: bytes arrived
    /// onUdpMessage 的 UDP 叫法（收到数据报）。
    DatagramHandler onPacket;  // udp: datagram arrived
    /// onHttpRequest 的 HTTP 叫法（请求已解析）。
    HttpRequestHandler onRequest;  // http: request parsed


    static List<Worker> workers = new List<Worker>();
    static bool daemonize = false;
    // 网络协程状态调度与数据交互。
    // 接口数据协议与执行契约。
    static bool cliMode = false;
    // 多进程网络工作单元与内核套接字调度契约。
    static bool stopping = false;
    // 多进程网络工作单元与内核套接字调度契约。
    // 多进程网络工作单元与内核套接字调度契约。
    static List<ShutdownHook> shutdownHooks = new List<ShutdownHook>();
    // 多进程网络工作单元与内核套接字调度契约。
    static List<TcpClient> ctlConn = new List<TcpClient>();
    static List<int> ctlWid = new List<int>();
    #if WINDOWS
    // 网络协程状态调度与数据交互。
    // 多进程网络工作单元与内核套接字调度契约。
    static List<TcpClient> wkChannels = new List<TcpClient>();
    #endif
    static int controlPort = 0;
    // 网络协程状态调度与数据交互。
    // 网络协程状态调度与数据交互。
    // 网络协程状态调度与数据交互。
    // 核心契约与语义定义。
    static bool ctlPortFixed = false;
    static int nextConnId = 1;
    // 多进程网络工作单元与内核套接字调度契约。
    // 核心契约与语义定义。
    // 多进程网络工作单元与内核套接字调度契约。
    // 多进程网络工作单元与内核套接字调度契约。
    // 网络协程状态调度与数据交互。
    // 多进程网络工作单元与内核套接字调度契约。
    // 网络协程状态调度与数据交互。
    // 网络协程状态调度与数据交互。
    // 接口数据协议与执行契约。
    static string logDir = "logs";
    static string logPattern = "{yyyy}{MM}/{dd}.log";

    // 核心契约与语义定义。
    // 多进程网络工作单元与内核套接字调度契约。
    /// 本进程累计服务的请求/消息数（workerman 风格 `status` 统计）。
    static AtomicInt statRequests = new AtomicInt(0);

    // 接口数据协议与执行契约。
    // 网络协程状态调度与数据交互。
    // 多进程网络工作单元与内核套接字调度契约。
    // 接口数据协议与执行契约。
    /// 静态上下文里的计数自增；实例 async 方法中直接自增会被按值捕获而丢失。
    static void BumpStat() {
        long _r = statRequests.Increment();
    }

    // 当前工作进程向对端成功写回的数据报文/帧统计数。
    /// 本进程累计发回对端的消息/帧/数据报数。
    static AtomicInt statSent = new AtomicInt(0);

    /// 发送计数自增（同 BumpStat 的静态上下文约束）。
    static void BumpSent() {
        long _s = statSent.Increment();
    }

    // 当前工作进程中维护的活跃客户端连接总数。
    /// 本进程所有 Worker 的在线连接总数。
    static int LiveConnections() {
        int n = 0;
        for (int i = 0; i < workers.Count; i = i + 1) {
            n = n + (int)workers[i].connectionCount.Load();
        }
        return n;
    }
    // 前台主进程服务状态监控与吞吐指标打印周期（秒）。
    // 多进程网络工作单元与内核套接字调度契约。
    // 核心契约与语义定义。
    static int statusInterval = 10;

    // 网络协程状态调度与数据交互。
    // 网络协程状态调度与数据交互。
    // 网络协程状态调度与数据交互。
    // 接口数据协议与执行契约。
    // 多进程网络工作单元与内核套接字调度契约。
    // 接口数据协议与执行契约。
    static SharedTable statTable = null;

    // 多进程网络工作单元与内核套接字调度契约。
    static List<long> stPrevReq = new List<long>();
    static List<long> stPrevCpuMs = new List<long>();

    [DllImport("crt")]
    static extern void exit(int code);
    [DllImport("crt")]
    static extern long strlen(string str);
    static bool debugLog = false;
    /// 调试跟踪输出：SetDebug(true) 时打印 master/worker 交接与握手轨迹。
    static void Dbg(string msg) {
        if (!debugLog) { return; }
        Console.WriteLine("[dbg] " + msg);
        #if WINDOWS
        int _f = _flushall();
        #endif
    }
    #if WINDOWS
    [DllImport("crt")]
    static extern int _flushall();
    #endif
    /// 多进程网络工作单元与内核套接字调度契约。
    static void SetDebug(bool on) {
        debugLog = on;
    }

    #if !WINDOWS
    // 收紧记录文件权限用（见 RecordControlPort）。
    [DllImport("crt")]
    static extern int chmod(string path, int mode);
    [DllImport("crt")]
    static extern int setenv(string name, string val, int overwrite);
    [DllImport("crt")]
    static extern int unsetenv(string name);
    #endif

    #if WINDOWS
    [DllImport("ws2_32", EntryPoint = "WSADuplicateSocketA")]
    static extern int WSADuplicateSocketA(nint s, int pid, string info);
    [DllImport("ws2_32", EntryPoint = "WSASocketA")]
    static extern nint WSASocketA(int af, int type, int protocol, string info, int g, int flags);
    [DllImport("kernel32", EntryPoint = "SetEnvironmentVariableW")]
    static extern int SetEnvironmentVariableW(nint name, nint val);
    #endif

    /// 按协议、监听地址与端口构造 Worker 并注册进全局 Worker 列表；
    /// 经 Listen() 使用。
    Worker(string protocol, string host, int port) {
        this.protocol = protocol;
        this.host = host;
        this.port = port;
        this.name = protocol + "-worker";
        this.running = false;
        this.connectionCount = new AtomicInt(0);
        this.maxConnections = 10000;
        this.maxHeaderBytes = 16384;
        this.maxRequestBytes = 1048576;
        this.requestTimeout = 30000;
        this.count = 1;
        this.onConnect = null;
        this.onMessage = null;
        this.onClose = null;
        this.onHttpRequest = null;
        this.onUdpMessage = null;
        this.onRawConnection = null;
        this.onOpen = null;
        this.onReceive = null;
        this.onPacket = null;
        this.onRequest = null;
        workers.Add(this);
    }

    /// onOpen 与 onConnect 中已设置的那个（别名归一）。
    ConnectionHandler OpenHandler() {
        if (this.onOpen != null) { return this.onOpen; }
        return this.onConnect;
    }

    /// onMessage 与 onReceive 中已设置的那个。
    MessageHandler MessageHandlerOf() {
        if (this.onMessage != null) { return this.onMessage; }
        return this.onReceive;
    }

    /// onPacket 与 onUdpMessage 中已设置的那个。
    DatagramHandler PacketHandler() {
        if (this.onPacket != null) { return this.onPacket; }
        return this.onUdpMessage;
    }

    /// onRequest 与 onHttpRequest 中已设置的那个。
    HttpRequestHandler RequestHandler() {
        if (this.onRequest != null) { return this.onRequest; }
        return this.onHttpRequest;
    }


    /// 是否支持 WebSocket 协议升级握手连接。
    /// 多进程网络工作单元与内核套接字调度契约。
    bool HasWsHandlers() {
        if (this.onOpen != null) { return true; }
        if (this.onMessage != null) { return true; }
        return false;
    }

    /// 多进程网络工作单元与内核套接字调度契约。
    static Worker Listen(string address) {
        string proto = "tcp";
        string rest = address;
        int n = address.Length;
        for (int i = 0; i + 2 < n; i = i + 1) {
            if ((address[i] & 255) == 58 && (address[i + 1] & 255) == 47 && (address[i + 2] & 255) == 47) {
                proto = address.Substring(0, i);
                rest = address.Substring(i + 3, n - i - 3);
                break;
            }
        }
        string host = rest;
        int port = 0;
        int colon = -1;
        int j = rest.Length - 1;
        while (j >= 0) {
            if ((rest[j] & 255) == 58) { colon = j; break; }
            j = j - 1;
        }
        if (colon >= 0) {
            host = rest.Substring(0, colon);
            port = Convert.ToInt32(rest.Substring(colon + 1, rest.Length - colon - 1));
        }
        return new Worker(proto, host, port);
    }

    /// 多进程网络工作单元与内核套接字调度契约。
    Worker SetName(string name) {
        this.name = name;
        return this;
    }

    /// 网络协程状态调度与数据交互。
    /// 网络协程状态调度与数据交互。
    Worker SetMaxConnections(int max) {
        this.maxConnections = max;
        return this;
    }

    /// 网络协程状态调度与数据交互。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 多进程网络工作单元与内核套接字调度契约。
    Worker SetHttpLimits(int maxHeaderBytes, int maxRequestBytes, int timeoutMs) {
        // 与 HttpServer.SetMaxRequestBytes 同一钳制：超出 1 GiB 会让
        // 帧解析的 `headerEnd + bodyLen` int 回绕，判限失效。
        if (maxRequestBytes < 1024) { maxRequestBytes = 1024; }
        if (maxRequestBytes > 1073741824) { maxRequestBytes = 1073741824; }
        this.maxHeaderBytes = maxHeaderBytes;
        this.maxRequestBytes = maxRequestBytes;
        this.requestTimeout = timeoutMs;
        return this;
    }

    /// 多进程网络工作单元与内核套接字调度契约。
    /// 网络协程状态调度与数据交互。
    /// 核心契约与执行状态转移规范。
    Worker SetCount(int count) {
        this.count = count;
        return this;
    }

    /// 网络协程状态调度与数据交互。
    /// 核心契约与语义定义。
    static void SetDaemonize(bool on) {
        daemonize = on;
    }

    /// 网络协程状态调度与数据交互。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 多进程网络工作单元与内核套接字调度契约。
    static void SetControlPort(int port) {
        controlPort = port;
        ctlPortFixed = true;
    }

    /// 多进程网络工作单元与内核套接字调度契约。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 接口数据协议与执行契约。
    static void SetStatusInterval(int seconds) {
        statusInterval = seconds;
    }

    /// 网络协程状态调度与数据交互。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 网络协程状态调度与数据交互。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 接口数据协议与执行契约。
    static void SetLogDir(string dir) {
        logDir = dir;
    }

    /// 多进程网络工作单元与内核套接字调度契约。
    static string LogDir() {
        return logDir;
    }

    /// 多进程网络工作单元与内核套接字调度契约。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 多进程网络工作单元与内核套接字调度契约。
    static void SetLogPattern(string pattern) {
        if (pattern != "") { logPattern = pattern; }
    }

    /// 网络协程状态调度与数据交互。
    /// 核心契约与语义定义。
    static string LogPath() {
        if (logDir == "") { return ""; }
        return logDir + Path.Separator()
            + Log.ExpandFor(logPattern, DateTime.Now(), ProcessHost.WorkerId());
    }

    // 网络协程状态调度与数据交互。
    // 网络协程状态调度与数据交互。
    // 核心契约与执行状态转移规范。
    /// master 启动初期：应用未自配 Log 时按 logDir/logPattern 配置日志，确保监督事件落盘。
    static void EnsureMasterLog() {
        if (logDir == "") { return; }
        EnsureLogDir();
        if (Log.IsEnabled()) { return; }
        Log.Configure(logDir, logPattern, Log.INFO);
    }

    // 网络协程状态调度与数据交互。
    // 网络协程状态调度与数据交互。
    // 网络协程状态调度与数据交互。
    /// 确保当前日志文件所在目录存在（每次 spawn 前调用）。
    static void EnsureLogDir() {
        if (logDir == "") { return; }
        Log.EnsureDirFor(LogPath());
    }

    /// 所有注册 Worker 中最大的 worker 进程数。
    static int MaxCount() {
        int m = 1;
        for (int i = 0; i < workers.Count; i = i + 1) {
            if (workers[i].count > m) { m = workers[i].count; }
        }
        return m;
    }

    /// 控制端口取值顺序：显式指定 > 环境变量 ZAN_CTL_PORT > 首 Worker 端口+10000（无 Worker 时 19999）。
    static int ControlPort() {
        if (controlPort > 0) { return controlPort; }
        string env = ProcessHost.Env("ZAN_CTL_PORT");
        if (env != "") {
            // 网络协程状态调度与数据交互。
            // 核心契约与语义定义。
            controlPort = Convert.ToInt32(env);
            ctlPortFixed = true;
            return controlPort;
        }
        if (workers.Count > 0) { return workers[0].port + 10000; }
        return 19999;
    }

    /// 网络协程状态调度与数据交互。
    /// 网络协程状态调度与数据交互。
    /// 网络协程状态调度与数据交互。
    /// 网络协程状态调度与数据交互。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 网络协程状态调度与数据交互。
    static string appId = "";

    /// 服务器实例标识：自身可执行文件路径的哈希（同副本重启即同实例，与端口无关）。
    static string AppId() {
        if (appId == "") {
            long h = SharedTable.Hash(ProcessHost.SelfExe());
            if (h < 0) { h = 0 - h; }
            appId = Convert.ToString(h);
        }
        return appId;
    }

    /// 多进程网络工作单元与内核套接字调度契约。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 网络协程状态调度与数据交互。
    /// 网络协程状态调度与数据交互。
    /// 核心契约与执行状态转移规范。
    static string CtlPortFile() {
        return Path.Combine(Path.GetTempPath(),
            "zan-worker-" + AppId() + ".ctl");
    }

    /// master 把实际认领的控制端口与实例令牌写入记录文件，供 stop/status/reload 寻址。
    static void RecordControlPort() {
        File.WriteAllText(CtlPortFile(), Convert.ToString(ControlPort())
            + " " + CtlToken());
        #if !WINDOWS
        // POSIX 上 temp 里的新文件默认 0644，任何本机用户可读走令牌、
        // 进而伪造 PONG 冒充本实例 master。收紧到 0600（仅属主可读写）。
        // Windows 无需处理：%TEMP% 在用户 profile 下，ACL 天然仅本用户。
        chmod(CtlPortFile(), 384);
        #endif
    }

    /// 停机时删除控制端口记录文件。
    static void ForgetControlPort() {
        File.Delete(CtlPortFile());
    }

    /// 多进程网络工作单元与内核套接字调度契约。
    /// 网络协程状态调度与数据交互。
    static int RecordedControlPort() {
        string f = CtlPortFile();
        if (!File.Exists(f)) { return 0; }
        string body = File.ReadAllText(f);
        int port = 0;
        for (int i = 0; i < body.Length; i = i + 1) {
            int c = body[i] & 255;
            if (c < 48 || c > 57) { break; }
            port = port * 10 + (c - 48);
        }
        if (port < 1 || port > 65535) { return 0; }
        return port;
    }

    // 核心契约与语义定义。
    // 多进程网络工作单元与内核套接字调度契约。
    // 接口数据协议与执行契约。
    // 网络协程状态调度与数据交互。
    // 网络协程状态调度与数据交互。
    // 多进程网络工作单元与内核套接字调度契约。
    // 网络协程状态调度与数据交互。
    // 网络协程状态调度与数据交互。
    // 多进程网络工作单元与内核套接字调度契约。
    // 网络协程状态调度与数据交互。
    // 网络协程状态调度与数据交互。
    // 多进程网络工作单元与内核套接字调度契约。
    static string ctlToken = "";

    /// 本实例令牌：CSPRNG 16 字节的 32 位 hex。原先的
    /// "<pid>-<unix秒>" 可被本机任何进程按进程表+时间预算出来，从而在
    /// 控制端口上伪造 PONG 冒充本实例 master（影响 start 的占用判定与
    /// stop/status 的寻址结论）。令牌只做身份甄别，不是控制命令的鉴权
    /// 凭据——CSPRNG 不可用时退回旧形态，甄别仍然工作。
    static string CtlToken() {
        if (ctlToken == "") {
            byte[] rnd = RandomNumberGenerator.GetBytes(16);
            if (rnd != null) {
                ctlToken = ByteHex(rnd, 16);
            } else {
                ctlToken = Convert.ToString(ProcessHost.Pid()) + "-"
                    + Convert.ToString(DateTime.UtcNow().ToUnixSeconds());
            }
        }
        return ctlToken;
    }

    /// 字节数组的低位在前 hex 编码（每字节两位）。
    static string ByteHex(byte[] b, int n) {
        if (b == null || n <= 0) { return ""; }
        return Convert.ToHexString(b, 0, n);
    }

    /// 网络协程状态调度与数据交互。
    /// there is no record.
    static string RecordedCtlToken() {
        string f = CtlPortFile();
        if (!File.Exists(f)) { return ""; }
        string body = File.ReadAllText(f);
        int sp = 0 - 1;
        for (int i = 0; i < body.Length; i = i + 1) {
            if ((body[i] & 255) == 32) { sp = i; break; }
        }
        if (sp < 0) { return ""; }
        return Worker.TrimEol(body.Substring(sp + 1));
    }

    /// 去除字符串尾部的换行、空格与制表符。
    static string TrimEol(string s) {
        int n = s.Length;
        while (n > 0) {
            int c = s[n - 1] & 255;
            if (c != 10 && c != 13 && c != 32 && c != 9) { break; }
            n = n - 1;
        }
        return s.Substring(0, n);
    }

    // 网络协程状态调度与数据交互。
    // 网络协程状态调度与数据交互。
    // 多进程网络工作单元与内核套接字调度契约。
    // 网络协程状态调度与数据交互。
    // 多进程网络工作单元与内核套接字调度契约。
    static int ctlProbeMs = 1500;
    static int ctlCmdMs = 10000;

    // 网络协程状态调度与数据交互。
    // 网络协程状态调度与数据交互。
    static string lastCtlErr = "";

    /// 网络协程状态调度与数据交互。
    /// reason in lastCtlErr.
    static nint BindCtl(int port, bool reuse) {
        nint s = Socket.CreateTcp();
        if (s < 0) {
            lastCtlErr = SocketErr();
            return -1;
        }
        if (reuse) { Socket.SetReuseAddr(s); }
        if (Socket.Bind(s, "127.0.0.1", port) != 0) {
            lastCtlErr = SocketErr();
            Socket.Close(s);
            return -1;
        }
        return s;
    }

    /// 网络协程状态调度与数据交互。
    /// 网络协程状态调度与数据交互。
    /// 网络协程状态调度与数据交互。
    /// 接口数据协议与执行契约。
    static async nint ClaimControlPort() {
        int want = ControlPort();
        #if WINDOWS
        // 多进程网络工作单元与内核套接字调度契约。
        // 多进程网络工作单元与内核套接字调度契约。
        // 多进程网络工作单元与内核套接字调度契约。
        // 核心契约与执行状态转移规范。
        nint s = BindCtl(want, false);
        #else
        // 多进程网络工作单元与内核套接字调度契约。
        // 网络协程状态调度与数据交互。
        // 多进程网络工作单元与内核套接字调度契约。
        // 核心契约与语义定义。
        nint s = BindCtl(want, true);
        #endif
        if (s >= 0) { return s; }
        string wantErr = lastCtlErr;

        // 多进程网络工作单元与内核套接字调度契约。
        // 多进程网络工作单元与内核套接字调度契约。
        // 多进程网络工作单元与内核套接字调度契约。
        // 多进程网络工作单元与内核套接字调度契约。
        int probed = await ProbeControlPort();
        if (probed == Worker.CTL_OURS) {
            Console.WriteLine("[Worker] FATAL: control port "
                + Convert.ToString(want)
                + " is served by a running master; stop it first"
                + " (<app> stop), or start this one with --ctl-port N");
            exit(1);
        }

        // 多进程网络工作单元与内核套接字调度契约。
        // 接口数据协议与执行契约。
        // 网络协程状态调度与数据交互。
        // 多进程网络工作单元与内核套接字调度契约。
        // 网络协程状态调度与数据交互。
        // 核心契约与语义定义。
        if (probed == Worker.CTL_FOREIGN || probed == Worker.CTL_UNKNOWN) {
            if (ctlPortFixed) {
                Console.WriteLine("[Worker] FATAL: control port "
                    + Convert.ToString(want) + " is held by another program"
                    + " that is not this app's master (" + wantErr
                    + "); name a free one with --ctl-port N");
                exit(1);
            }
            return MoveOffControlPort(want, wantErr);
        }

        s = BindCtl(want, true);
        if (s >= 0) {
            Console.WriteLine("[Worker] control port " + Convert.ToString(want)
                + " was left behind by a previous run; reclaimed it");
            return s;
        }

        if (ctlPortFixed) {
            Console.WriteLine("[Worker] FATAL: cannot bind control port "
                + Convert.ToString(want) + " (" + wantErr + ", retry: "
                + lastCtlErr + "); nothing answers on it, so it is not a"
                + " running master -- name a free one with --ctl-port N");
            exit(1);
        }

        return MoveOffControlPort(want, wantErr);
    }

    /// 网络协程状态调度与数据交互。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 网络协程状态调度与数据交互。
    static nint MoveOffControlPort(int want, string wantErr) {
        int probe = want + 1;
        while (probe <= want + 64) {
            nint s = BindCtl(probe, false);
            if (s >= 0) {
                controlPort = probe;
                Console.WriteLine("[Worker] control port "
                    + Convert.ToString(want) + " is taken (" + wantErr
                    + "); using " + Convert.ToString(probe) + " instead");
                return s;
            }
            probe = probe + 1;
        }
        Console.WriteLine("[Worker] FATAL: no free control port in "
            + Convert.ToString(want) + "-" + Convert.ToString(want + 64)
            + " (" + lastCtlErr + "); name one with --ctl-port N");
        exit(1);
        return -1;
    }

    /// 多进程网络工作单元与内核套接字调度契约。
    /// 核心契约与语义定义。
    /// 核心契约与执行状态转移规范。
    /// 核心契约与语义定义。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 核心契约与语义定义。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 接口数据协议与执行契约。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 网络协程状态调度与数据交互。
    /// 核心契约与语义定义。
    /// 网络协程状态调度与数据交互。
    /// </summary>
    static async void RunCommand() {
        cliMode = true;
        string cmd = "start";
        bool detach = false;
        for (int i = 0; i < Environment.ArgCount(); i = i + 1) {
            string a = Environment.ArgAt(i);
            if (a == "-d" || a == "--daemon") {
                detach = true;
            } else if (a == "--ctl-port" && i + 1 < Environment.ArgCount()) {
                // 接口数据协议与执行契约。
                // 多进程网络工作单元与内核套接字调度契约。
                // 接口数据协议与执行契约。
                // 多进程网络工作单元与内核套接字调度契约。
                // 核心契约与语义定义。
                SetControlPort(Convert.ToInt32(Environment.ArgAt(i + 1)));
            } else if (i == 0) {
                cmd = a;
            }
        }

        if (cmd == "stop") {
            await SendCommand("STOP");
            return;
        }
        if (cmd == "reload") {
            await SendCommand("RELOAD");
            return;
        }
        if (cmd == "status") {
            await SendCommand("STATUS");
            return;
        }
        if (cmd == "restart") {
            await SendCommand("STOP");
            // 网络协程状态调度与数据交互。
            // 核心契约与执行状态转移规范。
            await Task.Delay(1500);
            // 网络协程状态调度与数据交互。
            // 多进程网络工作单元与内核套接字调度契约。
            if (!ctlPortFixed) { controlPort = 0; }
            cmd = "start";
        }
        if (cmd != "start") {
            Console.WriteLine("usage: " + Worker.Usage());
            return;
        }
        if (detach) { daemonize = true; }
        await RunAll();
    }

    /// 网络协程状态调度与数据交互。
    /// 网络协程状态调度与数据交互。
    /// 网络协程状态调度与数据交互。
    static async void SendCommand(string cmd) {
        Socket.Initialize();
        if (!ctlPortFixed) {
            int recorded = RecordedControlPort();
            if (recorded > 0) { controlPort = recorded; }
        }
        // 多进程网络工作单元与内核套接字调度契约。
        // 多进程网络工作单元与内核套接字调度契约。
        // 多进程网络工作单元与内核套接字调度契约。
        if (await ProbeControlPort() == Worker.CTL_FOREIGN) {
            Console.WriteLine("[Worker] control port "
                + Convert.ToString(ControlPort()) + " is answered by another"
                + " program, not by this app -- ignoring " + cmd);
            return;
        }
        TcpClient c = await TcpClient.ConnectAsync("127.0.0.1", ControlPort(),
            ctlProbeMs);
        if (c == null || !c.IsConnected()) {
            Console.WriteLine("[Worker] no server on control port "
                + Convert.ToString(ControlPort()));
            return;
        }
        int _s = await c.SendAsync(cmd + "\n");
        // 多进程网络工作单元与内核套接字调度契约。
        // 多进程网络工作单元与内核套接字调度契约。
        // 多进程网络工作单元与内核套接字调度契约。
        string reply = "";
        bool timedOut = false;
        while (true) {
            string chunk = await c.RecvAsync(4096, ctlCmdMs);
            if (chunk.Length == 0) {
                timedOut = Socket.LastRecvTimedOut();
                break;
            }
            reply = reply + chunk;
        }
        c.Close();
        if (reply.Length > 0) { Console.Write(reply); }
        if (timedOut) {
            Console.WriteLine("[Worker] control port "
                + Convert.ToString(ControlPort()) + " accepted the connection"
                + " but did not answer " + cmd + " within "
                + Convert.ToString(ctlCmdMs / 1000) + "s; it is not a live"
                + " master (leftover listening socket?)");
        }
    }

    /// 多进程网络工作单元与内核套接字调度契约。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 网络协程状态调度与数据交互。
    /// count is 1.</summary>
    static async void RunAll() {
        Socket.Initialize();

        if (ProcessHost.IsWorker()) {
            await RunAsWorkerProcess();
            return;
        }

        CheckProtoEntries();
        EnsureMasterLog();
        if (daemonize) {
            // 网络协程状态调度与数据交互。
            // 接口数据协议与执行契约。
            // 网络协程状态调度与数据交互。
            // 核心契约与语义定义。
            if (ProcessHost.DaemonizeTo(LogPath(), logDir)) {
                exit(0);
            }
        }

        int procs = MaxCount();
        if (procs <= 1 && !cliMode) {
            // 网络协程状态调度与数据交互。
            // 多进程网络工作单元与内核套接字调度契约。
            // 多进程网络工作单元与内核套接字调度契约。
            List<nint> socks = new List<nint>();
            for (int i = 0; i < workers.Count; i = i + 1) {
                nint s = workers[i].BindSocket(false);
                if (s < 0) {
                    Console.WriteLine(BindFailure(workers[i]));
                    exit(1);
                }
                socks.Add(s);
            }
            StatsCreate(1);
            Task.Spawn(StatsPublishLoop());
            PrintBanner(1);
            PrintSharedTables();
            // 多进程网络工作单元与内核套接字调度契约。
            // 多进程网络工作单元与内核套接字调度契约。
            // 多进程网络工作单元与内核套接字调度契约。
            // 多进程网络工作单元与内核套接字调度契约。
            if (cliMode) { Task.Spawn(SingleProcessControlLoop()); }
            await RunAllLoopsOnSockets(socks);
            return;
        }

        // 多进程网络工作单元与内核套接字调度契约。
        // 接口数据协议与执行契约。
        // 多进程网络工作单元与内核套接字调度契约。
        await RunAsMaster(procs);
    }

    // 网络协程状态调度与数据交互。
    // 网络协程状态调度与数据交互。
    /// 状态屏文本按宽度左对齐补空格（委托 ServerBanner.Pad）。
    static string Pad(string s, int width) {
        return ServerBanner.Pad(s, width);
    }

    /// 状态屏分隔线（委托 ServerBanner.Rule）。
    static string Rule(string title) {
        return ServerBanner.Rule(title);
    }

    /// 网络协程状态调度与数据交互。
    /// 网络协程状态调度与数据交互。
    /// state.</summary>
    static void PrintBanner(int procs) {
        string mode = "single process";
        if (procs > 1 || cliMode) {
            mode = "master + " + Convert.ToString(procs) + " worker";
            if (procs != 1) { mode = mode + "s"; }
        }
        ServerBanner b = new ServerBanner("ZAN", "WORKERS").Mode(mode);
        for (int i = 0; i < workers.Count; i = i + 1) {
            Worker w = workers[i];
            int c = w.count;
            if (c < 1) { c = 1; }
            b.Service(w.name,
                w.protocol + "://" + w.host + ":" + Convert.ToString(w.port),
                Convert.ToString(c), "[OK]");
        }
        if (cliMode) { b.Commands(Worker.Usage()); }
        b.Footer("Press Ctrl+C to stop. Start success.");
        b.Print();
    }

    // 核心契约与执行状态转移规范。

    // 多进程网络工作单元与内核套接字调度契约。
    // 多进程网络工作单元与内核套接字调度契约。
    // 网络协程状态调度与数据交互。
    // 网络协程状态调度与数据交互。
    // 网络协程状态调度与数据交互。
    // 网络协程状态调度与数据交互。
    // 多进程网络工作单元与内核套接字调度契约。
    // 多进程网络工作单元与内核套接字调度契约。
    static long statOsHandle = 0;

    /// 统计表行键：wid>0 为 "w<id>"，否则 "self"。
    static string StatsKey(int wid) {
        if (wid <= 0) { return "self"; }
        return "w" + Convert.ToString(wid);
    }

    /// 构造跨进程统计共享表的列布局（pid/recv/sent/conns/cpu/rss）。
    static SharedTable StatsTable(int procs) {
        SharedTable t = new SharedTable("", procs + 8);
        t.Label("worker stats");
        t.KeySize(16);
        t.ColumnInt("pid");
        t.ColumnInt("recv");
        t.ColumnInt("sent");
        t.ColumnInt("conns");
        t.ColumnInt("cpu");
        t.ColumnInt("rss");
        return t;
    }

    /// 网络协程状态调度与数据交互。
    /// 核心契约与语义定义。
    static void StatsSeed(SharedTable t, int procs) {
        for (int wid = 0; wid <= procs; wid = wid + 1) {
            t.SetInt(StatsKey(wid), "pid", 0);
            t.SetInt(StatsKey(wid), "recv", 0);
            t.SetInt(StatsKey(wid), "sent", 0);
            t.SetInt(StatsKey(wid), "conns", 0);
            t.SetInt(StatsKey(wid), "cpu", 0);
            t.SetInt(StatsKey(wid), "rss", 0);
        }
    }

    /// 网络协程状态调度与数据交互。
    /// 网络协程状态调度与数据交互。
    /// 核心契约与语义定义。
    static void StatsCreate(int procs) {
        SharedTable t = StatsTable(procs);
        if (!t.CreateAnonymous()) {
            Console.WriteLine("[Worker] cannot create the shared stats table;"
                + " per-process counters will read as zero");
            return;
        }
        StatsSeed(t, procs);
        statTable = t;
        statOsHandle = t.OsHandle();
    }

    /// 网络协程状态调度与数据交互。
    /// 网络协程状态调度与数据交互。
    /// 网络协程状态调度与数据交互。
    /// 接口数据协议与执行契约。
    static void StatsDestroy() {
        SharedTable t = statTable;
        statOsHandle = 0;
        if (t == null) { return; }
        statTable = null;
        if (t.IsOpen()) { bool _d = t.Destroy(); }
    }

    /// 网络协程状态调度与数据交互。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 网络协程状态调度与数据交互。
    /// 接口数据协议与执行契约。
    static void StatsAttach() {
        string env = ProcessHost.Env("ZAN_STATS_HANDLE");
        if (env == "") { return; }
        SharedTable t = SharedTable.Attach(Convert.ToInt64(env));
        if (t.IsOpen()) {
            t.Label("worker stats");
            statTable = t;
        }
    }

    // 接口数据协议与执行契约。
    // 网络协程状态调度与数据交互。
    // 网络协程状态调度与数据交互。
    // 多进程网络工作单元与内核套接字调度契约。
    // 网络协程状态调度与数据交互。
    // 接口数据协议与执行契约。
    static List<string> shareNames = new List<string>();
    static List<long> shareHandles = new List<long>();

    // 网络协程状态调度与数据交互。
    /// 共享表句柄经环境变量传递时的变量名（ZAN_SHARE_<name>）。
    static string ShareEnv(string name) { return "ZAN_SHARE_" + name; }

    /// 多进程网络工作单元与内核套接字调度契约。
    /// 网络协程状态调度与数据交互。
    /// 网络协程状态调度与数据交互。
    /// 多进程网络工作单元与内核套接字调度契约。
    static void ShareHandle(string name, long osHandle) {
        if (name == "" || osHandle == 0) { return; }
        for (int i = 0; i < shareNames.Count; i = i + 1) {
            if (shareNames[i] == name) {
                shareHandles[i] = osHandle;
                return;
            }
        }
        shareNames.Add(name);
        shareHandles.Add(osHandle);
    }

    /// 网络协程状态调度与数据交互。
    /// 多进程网络工作单元与内核套接字调度契约。
    static long InheritedHandle(string name) {
        string env = ProcessHost.Env(ShareEnv(name));
        if (env == "") { return 0; }
        return Convert.ToInt64(env);
    }

    /// 接口数据协议与执行契约。
    static void StatsPublish() {
        SharedTable t = statTable;
        if (t == null) { return; }
        if (!t.IsOpen()) { return; }
        string key = StatsKey(ProcessHost.WorkerId());
        t.SetInt(key, "pid", ProcessHost.Pid());
        t.SetInt(key, "recv", statRequests.Load());
        t.SetInt(key, "sent", statSent.Load());
        t.SetInt(key, "conns", LiveConnections());
        t.SetInt(key, "cpu", ServerMetrics.CpuMillis());
        t.SetInt(key, "rss", ServerMetrics.MemoryRssBytes());
    }

    /// 后台循环：每 2 秒把本进程计数器发布进统计表。
    static async void StatsPublishLoop() {
        while (true) {
            await Task.Delay(2000);
            StatsPublish();
        }
    }

    /// 读取指定 worker 行的统计列；统计表不可用时返回 0。
    static long StatsRead(int wid, string column) {
        SharedTable t = statTable;
        if (t == null) { return 0; }
        if (!t.IsOpen()) { return 0; }
        return t.GetInt(StatsKey(wid), column);
    }

    /// 多进程网络工作单元与内核套接字调度契约。
    static string Usage() {
        return "<app> [start [-d] | stop | restart [-d] | reload | status]"
            + " [--ctl-port N]";
    }

    /// 多进程网络工作单元与内核套接字调度契约。
    /// 多进程网络工作单元与内核套接字调度契约。
    static void StopAll() {
        for (int i = 0; i < workers.Count; i = i + 1) {
            workers[i].Stop();
        }
    }

    /// 网络协程状态调度与数据交互。
    /// 接口数据协议与执行契约。
    void Stop() {
        this.running = false;
    }

    // 多进程网络工作单元与内核套接字调度契约。
    // 多进程网络工作单元与内核套接字调度契约。
    /// 连接计数 +1（包装一层以便集中丢弃原子自增的返回值）。
    void AddConn() { long _n = this.connectionCount.Increment(); }
    /// 连接计数 -1。
    void DropConn() { long _n = this.connectionCount.Decrement(); }

    /// <summary>当前活连接数（本进程视角；多进程时其他 worker 的
    /// 连接不计入）。</summary>
    int GetConnectionCount() {
        return (int)this.connectionCount.Load();
    }

    /// 网络协程状态调度与数据交互。
    #if WINDOWS
    /// 以宽字符 API 设置环境变量，避免 UTF-8 值经 Windows ANSI 代码页窄化。
    static void SetWorkerEnv(string name, string val) {
        nint wname = Wide.Of(name);
        nint wval = Wide.Of(val);
        int _ok = SetEnvironmentVariableW(wname, wval);
        Wide.Free(wname);
        Wide.Free(wval);
    }
    #endif

    // 核心契约与语义定义。

    // 网络协程状态调度与数据交互。
    // 网络协程状态调度与数据交互。
    static int totalSpawned = 0;
    static int maxTotalSpawns = 512;

    /// Master 派生一个 worker 子进程（wid 从 1 起）：经环境变量传递 worker id、
    /// 控制端口、统计表句柄、日志目录与共享表句柄；通过 Process.StartProgram 直接以
    /// 原生系统调用（Windows CreateProcessW / POSIX fork+execvp+setsid）安全派生，
    /// 彻底消除 /bin/sh 或 cmd.exe Shell 逃逸漏洞与管道死锁风险；总派生数受 maxTotalSpawns 硬上限保护。
    static void SpawnChild(int wid) {
        if (totalSpawned >= maxTotalSpawns) {
            Console.WriteLine("[Worker] spawn cap (" + Convert.ToString(maxTotalSpawns)
                + ") reached; refusing to spawn more workers");
            return;
        }
        totalSpawned = totalSpawned + 1;
        string exe = ProcessHost.SelfExe();
        int ctl = ControlPort();
        EnsureLogDir();
        string logPath = Worker.LogPath();
        #if WINDOWS
        // 网络协程状态调度与数据交互。
        // 网络协程状态调度与数据交互。
        // like a worker.
        SetWorkerEnv("ZAN_WORKER_ID", Convert.ToString(wid));
        SetWorkerEnv("ZAN_CTL_PORT", Convert.ToString(ctl));
        // 网络协程状态调度与数据交互。
        // 多进程网络工作单元与内核套接字调度契约。
        // inheritance on.
        SetWorkerEnv("ZAN_STATS_HANDLE", Convert.ToString(statOsHandle));
        // 网络协程状态调度与数据交互。
        SetWorkerEnv("ZAN_LOG_DIR", logDir);
        for (int s = 0; s < shareNames.Count; s = s + 1) {
            SetWorkerEnv(ShareEnv(shareNames[s]),
                Convert.ToString(shareHandles[s]));
        }
        // 网络协程状态调度与数据交互。
        // 网络协程状态调度与数据交互。
        // 多进程网络工作单元与内核套接字调度契约。
        // 核心契约与语义定义。
        int rc = Process.StartProgram(exe, logPath);
        SetWorkerEnv("ZAN_WORKER_ID", "");
        SetWorkerEnv("ZAN_CTL_PORT", "");
        SetWorkerEnv("ZAN_STATS_HANDLE", "");
        for (int c = 0; c < shareNames.Count; c = c + 1) {
            SetWorkerEnv(ShareEnv(shareNames[c]), "");
        }
        if (rc != 0) {
            Log.Error("[Worker] worker " + Convert.ToString(wid)
                + " failed to start: CreateProcess(" + exe + ") failed");
        }
        #else
        // POSIX 侧同样走 setenv 设置环境变量，子进程通过 fork() 自动继承完整环境块，
        // 随后由 Process.StartProgram 直接调用 fork+setsid+dup2+execvp 启动，
        // 彻底消除了原先构造 "/bin/sh -c" 字符串拼接带来的 Shell 命令注入隐患。
        setenv("ZAN_WORKER_ID", Convert.ToString(wid), 1);
        setenv("ZAN_CTL_PORT", Convert.ToString(ctl), 1);
        setenv("ZAN_STATS_HANDLE", Convert.ToString(statOsHandle), 1);
        setenv("ZAN_LOG_DIR", logDir, 1);
        for (int s = 0; s < shareNames.Count; s = s + 1) {
            setenv(ShareEnv(shareNames[s]), Convert.ToString(shareHandles[s]), 1);
        }
        int rc = Process.StartProgram(exe, logPath);
        unsetenv("ZAN_WORKER_ID");
        unsetenv("ZAN_CTL_PORT");
        unsetenv("ZAN_STATS_HANDLE");
        for (int c = 0; c < shareNames.Count; c = c + 1) {
            unsetenv(ShareEnv(shareNames[c]));
        }
        if (rc != 0) {
            Log.Error("[Worker] worker " + Convert.ToString(wid)
                + " failed to start: exec(" + exe + ") failed");
        }
        #endif
        Log.Info("[Worker] worker " + Convert.ToString(wid) + " spawned");
    }

    // 核心契约与语义定义。
    // 网络协程状态调度与数据交互。
    // 接口数据协议与执行契约。
    static List<int> chIdx = new List<int>();  // listener index served
    static List<int> chPid = new List<int>();  // worker process pid
    static List<TcpClient> chConn = new List<TcpClient>();
    static int rrCounter = 0;

    /// 网络协程状态调度与数据交互。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 核心契约与语义定义。
    static string SocketErr() {
        #if WINDOWS
        return "WSA error " + Convert.ToString(Socket.LastSocketError());
        #else
        return "errno " + Convert.ToString(Socket.LastSocketError());
        #endif
    }

    // 网络协程状态调度与数据交互。
    // 网络协程状态调度与数据交互。
    static string lastBindErr;

    // 网络协程状态调度与数据交互。
    // 多进程网络工作单元与内核套接字调度契约。
    // 网络协程状态调度与数据交互。
    /// 监听绑定失败的完整错误信息；端口被占用时给出可操作的两种处理建议。
    static string BindFailure(Worker w) {
        string at = w.protocol + "://" + w.host + ":" + Convert.ToString(w.port);
        string s = "[Worker] FATAL: cannot bind " + at + " ("
            + Worker.lastBindErr + ")";
        if (Worker.lastBindErrInUse) {
            s = s + "; the address is already in use -- another program (or a"
                + " previous run of this one that is still alive) is listening"
                + " on it. Stop it, or give this server a free port.";
        }
        return s;
    }

    // 多进程网络工作单元与内核套接字调度契约。
    // 核心契约与语义定义。
    static bool lastBindErrInUse;

    /// 平台错误号是否表示"地址已被占用"（WSA 10048 / macOS 48 / Linux 98）。
    static bool IsAddrInUse(int err) {
        #if WINDOWS
        return err == 10048;
        #elif MACOS
        return err == 48;
        #else
        return err == 98;
        #endif
    }

    /// 网络协程状态调度与数据交互。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 接口数据协议与执行契约。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 网络协程状态调度与数据交互。
    /// 网络协程状态调度与数据交互。
    /// 网络协程状态调度与数据交互。
    /// 网络协程状态调度与数据交互。
    /// 核心契约与语义定义。
    /// 网络协程状态调度与数据交互。
    /// 网络协程状态调度与数据交互。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 核心契约与语义定义。
    /// 网络协程状态调度与数据交互。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 网络协程状态调度与数据交互。
    /// 核心契约与语义定义。
    static const int CTL_FREE = 0;
    static const int CTL_OURS = 1;
    static const int CTL_FOREIGN = 2;
    static const int CTL_UNKNOWN = 3;

    /// 向控制端口发 PING 并按应答（含令牌核对）返回 CTL_FREE/CTL_OURS/CTL_FOREIGN/CTL_UNKNOWN。
    static async int ProbeControlPort() {
        TcpClient probe = await TcpClient.ConnectAsync("127.0.0.1",
            ControlPort(), ctlProbeMs);
        if (probe == null || !probe.IsConnected()) { return Worker.CTL_FREE; }
        int _s = await probe.SendAsync("PING\n");
        string reply = await probe.RecvAsync(64, ctlProbeMs);
        probe.Close();
        if (reply.Length < 4 || reply.Substring(0, 4) != "PONG") {
            return Worker.CTL_FREE;
        }
        // 网络协程状态调度与数据交互。
        // 多进程网络工作单元与内核套接字调度契约。
        // 接口数据协议与执行契约。
        List<string> f = SplitWords(reply);
        if (f.Count < 3) { return Worker.CTL_UNKNOWN; }
        string mine = RecordedCtlToken();
        if (mine != "" && f[2] == mine) { return Worker.CTL_OURS; }
        if (ctlToken != "" && f[2] == ctlToken) { return Worker.CTL_OURS; }
        return Worker.CTL_FOREIGN;
    }

    /// master 主流程：先认领控制端口（fork 炸弹防护），再绑定监听、建统计表、派生并监督 procs 个 worker。
    static async void RunAsMaster(int procs) {
        // 网络协程状态调度与数据交互。
        // 多进程网络工作单元与内核套接字调度契约。
        // 多进程网络工作单元与内核套接字调度契约。
        // 核心契约与执行状态转移规范。
        nint ctlSock = await ClaimControlPort();
        RecordControlPort();
        PrintBanner(procs);
        Socket.Listen(ctlSock, 64);
        Socket.SetNonBlocking(ctlSock);

        // 网络协程状态调度与数据交互。
        // 多进程网络工作单元与内核套接字调度契约。
        // 核心契约与语义定义。
        #if WINDOWS
        for (int i = 0; i < workers.Count; i = i + 1) {
            Worker w = workers[i];
            nint s = w.BindSocket(false);
            if (s < 0) {
                Console.WriteLine(BindFailure(w));
                exit(1);
            }
            if (w.protocol == "udp") {
                // 接口数据协议与执行契约。
                Task.Spawn(w.RunOnSocket(s));
            } else {
                Task.Spawn(MasterAcceptLoop(i, s));
            }
        }
        #endif

        // 网络协程状态调度与数据交互。
        // 核心契约与语义定义。
        StatsCreate(procs);
        // 网络协程状态调度与数据交互。
        // 多进程网络工作单元与内核套接字调度契约。
        // 多进程网络工作单元与内核套接字调度契约。
        StatsPublish();
        Task.Spawn(StatsPublishLoop());
        PrintSharedTables();

        int wid = 1;
        while (wid <= procs) {
            SpawnChild(wid);
            wid = wid + 1;
        }


        // 网络协程状态调度与数据交互。
        // 多进程网络工作单元与内核套接字调度契约。
        // 核心契约与执行状态转移规范。
        while (true) {
            nint sock = await Socket.AcceptAsync(ctlSock);
            if (sock < 0) { continue; }
            Socket.SetNonBlocking(sock);
            Task.Spawn(HandleWorkerControl(sock));
        }
    }

    #if WINDOWS
    // 网络协程状态调度与数据交互。
    // 网络协程状态调度与数据交互。
    /// Windows：listener idx 的 master 接受循环，事件驱动 accept 后把连接轮流移交 worker。
    static async void MasterAcceptLoop(int idx, nint sock) {
        Dbg("accept loop up idx=" + Convert.ToString(idx));
        while (true) {
            nint c = await Socket.AcceptAsync(sock);
            Dbg("accepted idx=" + Convert.ToString(idx) + " c=" + Convert.ToString(c));
            if (c < 0) { continue; }
            await HandoffClient(idx, c);
        }
    }

    /// 多进程网络工作单元与内核套接字调度契约。
    static int PickChannel(int idx) {
        int n = chIdx.Count;
        if (n == 0) { return -1; }
        rrCounter = rrCounter + 1;
        int start = rrCounter;
        for (int k = 0; k < n; k = k + 1) {
            int slot = (start + k) % n;
            if (chIdx[slot] == idx) { return slot; }
        }
        return -1;
    }

    /// 关闭并移除一个失效的 handoff 通道（worker 已死/ACK 失败）。
    static void DropChannel(int slot) {
        chConn[slot].Close();
        chIdx.RemoveAt(slot);
        chPid.RemoveAt(slot);
        chConn.RemoveAt(slot);
    }

    /// 多进程网络工作单元与内核套接字调度契约。
    /// 网络协程状态调度与数据交互。
    static async void HandoffClient(int idx, nint c) {
        while (true) {
            int slot = PickChannel(idx);
            if (slot < 0) {
                // 接口数据协议与执行契约。
                Socket.Close(c);
                return;
            }
            TcpClient ch = chConn[slot];
            byte[] info = new byte[373];
            int r = WSADuplicateSocketA(c, chPid[slot], info);
            Dbg("dup c=" + Convert.ToString(c) + " -> pid=" + Convert.ToString(chPid[slot]) + " r=" + Convert.ToString(r));
            if (r != 0) {
                Socket.Close(c);
                return;
            }
            int n = await Socket.SendAsync(ch.GetSocket(), info, 372);
            if (n <= 0) { DropChannel(slot); continue; }
            string ack = await ch.RecvAsync(1);
            Dbg("ack len=" + Convert.ToString(ack.Length));
            if (ack.Length == 0) { DropChannel(slot); continue; }
            Socket.Close(c);
            return;
        }
    }
    #endif

    /// 处理一条控制端口连接。首行是握手："HELLO <pid> <wid>"（控制/存活
    /// 连接）、"CHAN <pid> <listenerIdx>"（Windows 交接通道），CLI 的单词
    /// 命令 PING/STOP/RELOAD/STATUS 也在此分流。HELLO 连接随后作为存活
    /// 监视长驻：对端关闭即视为 worker 退出，延迟 1s 后重启（stopping
    /// 置位时不重启，避免停机后复活）。
    static async void HandleWorkerControl(nint sock) {
        TcpClient conn = TcpClient.FromSocket(sock);

        // 核心契约与语义定义。
        // 接口数据协议与执行契约。
        // 多进程网络工作单元与内核套接字调度契约。
        string line = "";
        bool ok = true;
        while (true) {
            int nl = IndexOfByte(line, 10);
            if (nl >= 0) { line = line.Substring(0, nl); break; }
            string chunk = await conn.RecvAsync(256);
            if (chunk.Length == 0) { ok = false; break; }
            line = line + chunk;
        }
        if (!ok) { conn.Close(); return; }

        List<string> f = SplitWords(line);
        if (f.Count == 0) { conn.Close(); return; }

        // 网络协程状态调度与数据交互。
        // 多进程网络工作单元与内核套接字调度契约。
        if (f[0] == "PING" || f[0] == "STOP" || f[0] == "RELOAD"
                || f[0] == "STATUS") {
            await HandleCliCommand(conn, f[0]);
            return;
        }
        if (f.Count < 3) { conn.Close(); return; }

        #if WINDOWS
        if (f[0] == "CHAN") {
            // 核心契约与语义定义。
            // 网络协程状态调度与数据交互。
            chPid.Add(Convert.ToInt32(f[1]));
            chIdx.Add(Convert.ToInt32(f[2]));
            chConn.Add(conn);
            Dbg("chan registered pid=" + f[1] + " idx=" + f[2] + " total=" + Convert.ToString(chConn.Count));
            return;
        }
        #endif
        if (f[0] != "HELLO") { conn.Close(); return; }
        int childPid = Convert.ToInt32(f[1]);
        int childWid = Convert.ToInt32(f[2]);

        #if !WINDOWS
        int _n = await Socket.SendStringAsync(sock, "GO\n");
        #endif

        Log.Info("[Worker] worker " + Convert.ToString(childWid)
            + " (pid " + Convert.ToString(childPid) + ") online");
        ctlConn.Add(conn);
        ctlWid.Add(childWid);

        // 网络协程状态调度与数据交互。
        // 网络协程状态调度与数据交互。
        // 核心契约与语义定义。
        while (true) {
            string beat = await conn.RecvAsync(256);
            if (beat.Length == 0) { break; }
        }
        conn.Close();
        DropCtl(conn);
        if (stopping) {
            Log.Info("[Worker] worker " + Convert.ToString(childWid)
                + " (pid " + Convert.ToString(childPid) + ") stopped");
            return;
        }
        // 多进程网络工作单元与内核套接字调度契约。
        // 核心契约与语义定义。
        await Task.Delay(1000);
        // 多进程网络工作单元与内核套接字调度契约。
        // 多进程网络工作单元与内核套接字调度契约。
        // 网络协程状态调度与数据交互。
        // 核心契约与语义定义。
        Log.Error("[Worker] worker " + Convert.ToString(childWid) + " pid="
            + Convert.ToString(childPid)
            + " exited; see the records above for its last output; respawning");
        SpawnChild(childWid);
    }

    /// worker 退出后将其控制连接从存活表中移除。
    static void DropCtl(TcpClient conn) {
        for (int i = 0; i < ctlConn.Count; i = i + 1) {
            if (ctlConn[i] == conn) {
                ctlConn.RemoveAt(i);
                ctlWid.RemoveAt(i);
                return;
            }
        }
    }

    /// 核心契约与语义定义。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 网络协程状态调度与数据交互。
    /// 核心契约与语义定义。
    /// 网络协程状态调度与数据交互。
    static async void HandleCliCommand(TcpClient conn, string cmd) {
        if (cmd == "PING") {
            // 核心契约与语义定义。
            // 网络协程状态调度与数据交互。
            // 多进程网络工作单元与内核套接字调度契约。
            // 网络协程状态调度与数据交互。
            int _p = await conn.SendAsync("PONG "
                + Convert.ToString(ProcessHost.Pid()) + " " + CtlToken()
                + "\n");
            conn.Close();
            return;
        }
        if (cmd == "STATUS") {
            int _s = await conn.SendAsync(StatusText());
            conn.Close();
            return;
        }
        if (cmd == "STOP") {
            stopping = true;
            int _r = await conn.SendAsync("stopping "
                + Convert.ToString(ctlConn.Count) + " worker(s)\n");
            conn.Close();
            await StopWorkersAndExit();
            return;
        }
        // 网络协程状态调度与数据交互。
        // 多进程网络工作单元与内核套接字调度契约。
        int _l = await conn.SendAsync("reloading "
            + Convert.ToString(ctlConn.Count) + " worker(s)\n");
        conn.Close();
        Task.Spawn(ReloadWorkers());
    }

    /// 依次向所有 worker 发 QUIT，等待它们的控制连接关闭（上限 30s）后
    /// 清理端口记录与统计表并 exit(0)。
    static async void StopWorkersAndExit() {
        for (int i = 0; i < ctlConn.Count; i = i + 1) {
            int _q = await ctlConn[i].SendAsync("QUIT\n");
        }
        int waited = 0;
        while (ctlConn.Count > 0 && waited < 30000) {
            await Task.Delay(200);
            waited = waited + 200;
        }
        ForgetControlPort();
        StatsDestroy();
        // 网络协程状态调度与数据交互。
        // 多进程网络工作单元与内核套接字调度契约。
        await RunShutdownHooks();
        Console.WriteLine("[Worker] master stopped");
        exit(0);
    }

    /// 网络协程状态调度与数据交互。
    /// 网络协程状态调度与数据交互。
    /// 接口数据协议与执行契约。
    static async void ReloadWorkers() {
        int total = ctlConn.Count;
        int done = 0;
        while (done < total && ctlConn.Count > 0) {
            TcpClient victim = ctlConn[0];
            int wid = ctlWid[0];
            int before = ctlConn.Count;
            int _q = await victim.SendAsync("QUIT\n");
            int waited = 0;
            while (waited < 30000 && ctlConn.Count >= before) {
                await Task.Delay(100);
                waited = waited + 100;
            }
            Console.WriteLine("[Worker] reloaded worker " + Convert.ToString(wid));
            done = done + 1;
            // 多进程网络工作单元与内核套接字调度契约。
            await Task.Delay(1500);
        }
        Console.WriteLine("[Worker] reload complete");
    }

    /// 网络协程状态调度与数据交互。
    /// 多进程网络工作单元与内核套接字调度契约。
    static string StatusText() {
        StringBuilder sb = new StringBuilder();
        sb.Append(Rule("ZAN STATUS"));
        sb.Append("\n");
        sb.Append(Pad("master pid: " + Convert.ToString(ProcessHost.Pid()), 30));
        sb.Append("control port: " + Convert.ToString(ControlPort()));
        sb.Append("\n");
        sb.Append(Pad("service", 22) + Pad("listen", 32)
            + Pad("processes", 12) + "status\n");
        for (int i = 0; i < workers.Count; i = i + 1) {
            Worker w = workers[i];
            int wc = w.count;
            if (wc < 1) { wc = 1; }
            sb.Append(Pad(w.name, 22)
                + Pad(w.protocol + "://" + w.host + ":" + Convert.ToString(w.port), 32)
                + Pad(Convert.ToString(wc), 12) + "[OK]\n");
        }
        sb.Append(Rule(""));
        sb.Append("\n");
        sb.Append(Pad("worker", 8) + Pad("pid", 9) + Pad("received", 12)
            + Pad("sent", 12) + Pad("clients", 10) + Pad("cpu ms", 10)
            + "memory\n");
        int procs = MaxCount();
        if (procs <= 1 && !cliMode) {
            // 多进程网络工作单元与内核套接字调度契约。
            StatsPublish();
            sb.Append(StatusRow("self", 0));
            sb.Append(SharedTablesText());
            return sb.ToString();
        }
        // 多进程网络工作单元与内核套接字调度契约。
        // 多进程网络工作单元与内核套接字调度契约。
        StatsPublish();
        sb.Append(StatusRow("master", 0));
        long totRecv = 0;
        long totSent = 0;
        long totConns = 0;
        int wid = 1;
        while (wid <= procs) {
            if (StatsRead(wid, "pid") != 0) {
                totRecv = totRecv + StatsRead(wid, "recv");
                totSent = totSent + StatsRead(wid, "sent");
                totConns = totConns + StatsRead(wid, "conns");
                sb.Append(StatusRow("w" + Convert.ToString(wid), wid));
            }
            wid = wid + 1;
        }
        sb.Append("total   received: " + Convert.ToString(totRecv)
            + "   sent: " + Convert.ToString(totSent)
            + "   clients: " + Convert.ToString(totConns) + "\n");
        sb.Append(SharedTablesText());
        return sb.ToString();
    }

    /// 多进程网络工作单元与内核套接字调度契约。
    /// 网络协程状态调度与数据交互。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 接口数据协议与执行契约。
    static string SharedTablesText() {
        StringBuilder sb = new StringBuilder();
        sb.Append(Rule("SHARED TABLES"));
        sb.Append("\n");
        sb.Append(SharedTable.StatusText());
        return sb.ToString();
    }

    /// 启动屏打印本进程共享内存表占用情况。
    static void PrintSharedTables() {
        Console.Write(SharedTablesText());
    }

    /// 网络协程状态调度与数据交互。
    static string StatusRow(string label, int wid) {
        return Pad(label, 8)
            + Pad(Convert.ToString(StatsRead(wid, "pid")), 9)
            + Pad(Convert.ToString(StatsRead(wid, "recv")), 12)
            + Pad(Convert.ToString(StatsRead(wid, "sent")), 12)
            + Pad(Convert.ToString(StatsRead(wid, "conns")), 10)
            + Pad(Convert.ToString(StatsRead(wid, "cpu")), 10)
            + Convert.ToString(StatsRead(wid, "rss") / 1048576) + "MB\n";
    }

    /// 多进程网络工作单元与内核套接字调度契约。
    /// 多进程网络工作单元与内核套接字调度契约。
    static async void SingleProcessControlLoop() {
        #if WINDOWS
        nint ctlSock = BindCtl(ControlPort(), false);
        #else
        nint ctlSock = BindCtl(ControlPort(), true);
        #endif
        if (ctlSock < 0) {
            // 多进程网络工作单元与内核套接字调度契约。
            // 多进程网络工作单元与内核套接字调度契约。
            // 接口数据协议与执行契约。
            // 核心契约与语义定义。
            if (await ProbeControlPort() != Worker.CTL_FREE) { return; }
            ctlSock = BindCtl(ControlPort(), true);
        }
        if (ctlSock < 0 && !ctlPortFixed) {
            int want = ControlPort();
            int probe = want + 1;
            while (probe <= want + 64 && ctlSock < 0) {
                ctlSock = BindCtl(probe, false);
                if (ctlSock >= 0) { controlPort = probe; }
                probe = probe + 1;
            }
        }
        // 网络协程状态调度与数据交互。
        // 核心契约与语义定义。
        if (ctlSock < 0) { return; }
        RecordControlPort();
        Socket.Listen(ctlSock, 16);
        Socket.SetNonBlocking(ctlSock);
        while (true) {
            nint s = await Socket.AcceptAsync(ctlSock);
            if (s < 0) { continue; }
            Socket.SetNonBlocking(s);
            Task.Spawn(HandleSelfCommand(s));
        }
    }

    /// 单进程服务器的控制命令处理：与 master 相同的 PING/STATUS/STOP/
    /// RELOAD；RELOAD 回复提示改用 restart（没有可替换的 worker 进程）。
    static async void HandleSelfCommand(nint sock) {
        TcpClient conn = TcpClient.FromSocket(sock);
        string line = "";
        while (true) {
            int nl = IndexOfByte(line, 10);
            if (nl >= 0) { line = line.Substring(0, nl); break; }
            string chunk = await conn.RecvAsync(64);
            if (chunk.Length == 0) { conn.Close(); return; }
            line = line + chunk;
        }
        List<string> f = SplitWords(line);
        if (f.Count == 0) { conn.Close(); return; }
        if (f[0] == "PING") {
            int _p = await conn.SendAsync("PONG "
                + Convert.ToString(ProcessHost.Pid()) + " " + CtlToken()
                + "\n");
            conn.Close();
            return;
        }
        if (f[0] == "STATUS") {
            int _s = await conn.SendAsync(StatusText());
            conn.Close();
            return;
        }
        if (f[0] == "STOP") {
            StopAll();
            int _r = await conn.SendAsync("stopped\n");
            conn.Close();
            await DrainThenExit();
            return;
        }
        if (f[0] == "RELOAD") {
            // 接口数据协议与执行契约。
            // server is reloaded by restarting it.
            int _l = await conn.SendAsync("single-process server: use restart\n");
            conn.Close();
            return;
        }
        conn.Close();
    }

    /// 网络协程状态调度与数据交互。
    /// 网络协程状态调度与数据交互。
    /// 核心契约与执行状态转移规范。
    static async void DrainThenExit() {
        StopAll();
        // 网络协程状态调度与数据交互。
        // 网络协程状态调度与数据交互。
        // 网络协程状态调度与数据交互。
        // 多进程网络工作单元与内核套接字调度契约。
        stopping = true;
        #if WINDOWS
        // 网络协程状态调度与数据交互。
        // 接口数据协议与执行契约。
        for (int c = 0; c < wkChannels.Count; c = c + 1) {
            wkChannels[c].Close();
        }
        #endif
        int waited = 0;
        while (waited < 30000) {
            int conns = 0;
            for (int i = 0; i < workers.Count; i = i + 1) {
                conns = conns + (int)workers[i].connectionCount.Load();
            }
            if (conns <= 0) { break; }
            await Task.Delay(100);
            waited = waited + 100;
        }
        // 网络协程状态调度与数据交互。
        // 网络协程状态调度与数据交互。
        if (!ProcessHost.IsWorker()) {
            ForgetControlPort();
            StatsDestroy();
        }
        await RunShutdownHooks();
        exit(0);
    }

    /// 多进程网络工作单元与内核套接字调度契约。
    /// 网络协程状态调度与数据交互。
    /// 多进程网络工作单元与内核套接字调度契约。
    static async void RunShutdownHooks() {
        // 网络协程状态调度与数据交互。
        // 多进程网络工作单元与内核套接字调度契约。
        // 核心契约与语义定义。
        for (int i = 0; i < shutdownHooks.Count; i = i + 1) {
            try {
                await shutdownHooks[i]();
            } catch (Exception e) {
                Console.WriteLine("[worker] shutdown hook exception: "
                    + e.Message);
            }
        }
    }

    /// 网络协程状态调度与数据交互。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 网络协程状态调度与数据交互。
    /// 核心契约与语义定义。
    static void OnShutdown(ShutdownHook hook) { shutdownHooks.Add(hook); }

    // 多进程网络工作单元与内核套接字调度契约。

    /// worker 进程入口：向 master 的控制端口发 HELLO 注册。Windows 上为每个
    /// TCP listener 开一条 CHAN 交接通道并服务 master 递来的 socket；POSIX 上
    /// 等 GO 后自行以 SO_REUSEPORT 绑定各 listener。随后挂载统计上报，并长驻
    /// 监视控制连接：master 关闭即退出，收到 QUIT 则排空在途请求后退出。
    static async void RunAsWorkerProcess() {
        TcpClient ctl = await TcpClient.ConnectAsync("127.0.0.1", ControlPort());
        if (ctl == null || !ctl.IsConnected()) {
            Console.WriteLine("[Worker] worker cannot reach master; exiting");
            exit(1);
        }
        int _h = await ctl.SendAsync("HELLO " + Convert.ToString(ProcessHost.Pid())
            + " " + Convert.ToString(ProcessHost.WorkerId()) + "\n");

        #if WINDOWS
        // 网络协程状态调度与数据交互。
        // 多进程网络工作单元与内核套接字调度契约。
        // 核心契约与语义定义。
        int i = 0;
        for (; i < workers.Count; i = i + 1) {
            if (workers[i].protocol != "udp") {
                TcpClient ch = await TcpClient.ConnectAsync("127.0.0.1", ControlPort());
                if (ch == null || !ch.IsConnected()) {
                    Console.WriteLine("[Worker] channel connect failed; exiting");
                    exit(1);
                }
                int _c = await ch.SendAsync("CHAN " + Convert.ToString(ProcessHost.Pid())
                    + " " + Convert.ToString(i) + "\n");
                wkChannels.Add(ch);
                Task.Spawn(ChannelLoop(ch, workers[i]));
            }
        }
        #else
        // 多进程网络工作单元与内核套接字调度契约。
        string go = await ctl.RecvAsync(16);
        if (go.Length == 0) { exit(1); }
        for (int i = 0; i < workers.Count; i = i + 1) {
            Worker w = workers[i];
            nint s = w.BindSocket(true);
            if (s < 0) {
                Console.WriteLine("[Worker] worker cannot bind "
                    + Convert.ToString(w.port) + "; exiting");
                exit(1);
            }
            Task.Spawn(w.RunOnSocket(s));
        }
        #endif

        // 多进程网络工作单元与内核套接字调度契约。
        StatsAttach();
        Task.Spawn(StatsPublishLoop());

        // 网络协程状态调度与数据交互。
        // 网络协程状态调度与数据交互。
        // 网络协程状态调度与数据交互。
        // 核心契约与语义定义。
        while (true) {
            string beat = await ctl.RecvAsync(64);
            if (beat.Length == 0) { break; }
            if (IndexOfByte(beat, 81) >= 0) {  // 'Q'
                ctl.Close();
                await DrainThenExit();
                return;
            }
        }
        exit(0);
    }

    #if WINDOWS
    /// 接口数据协议与执行契约。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 网络协程状态调度与数据交互。
    static async void ChannelLoop(TcpClient ch, Worker w) {
        Dbg("worker chan loop up " + w.protocol);
        while (true) {
            byte[] info = new byte[373];
            bool ok = await RecvExact(ch, info, 372);
            if (!ok) {
                // 多进程网络工作单元与内核套接字调度契约。
                // 接口数据协议与执行契约。
                // 多进程网络工作单元与内核套接字调度契约。
                // 网络协程状态调度与数据交互。
                // 核心契约与语义定义。
                if (stopping) { return; }
                exit(0);  // master gone
            }
            nint s = WSASocketA(-1, -1, -1, info, 0, 1);
            Dbg("worker rebuilt s=" + Convert.ToString(s));
            int _a = await ch.SendAsync("K");
            if (_a <= 0) {
                if (stopping) { return; }
                exit(0);
            }
            if (s >= 0) {
                Socket.SetNonBlocking(s);
                w.Dispatch(s);
            }
        }
    }
    #endif

    /// 按空白字符（空格/制表/回车/换行）切分为单词列表。
    static List<string> SplitWords(string s) {
        List<string> parts = new List<string>();
        if (s == null || s.Length == 0) { return parts; }
        int len = s.Length;
        int start = -1;
        for (int i = 0; i < len; i = i + 1) {
            int c = s[i] & 255;
            bool isSpace = (c == 32 || c == 9 || c == 13 || c == 10);
            if (isSpace) {
                if (start >= 0) {
                    parts.Add(s.Substring(start, i - start));
                    start = -1;
                }
            } else if (start < 0) {
                start = i;
            }
        }
        if (start >= 0) {
            parts.Add(s.Substring(start, len - start));
        }
        return parts;
    }

    /// 网络协程状态调度与数据交互。
    /// 网络协程状态调度与数据交互。
    static async void MasterStatusLoop() {
        long prevWall = ServerMetrics.MonoMillis();
        while (true) {
            await Task.Delay(statusInterval * 1000);
            long now = ServerMetrics.MonoMillis();
            long dWall = now - prevWall;
            prevWall = now;
            if (dWall <= 0) { continue; }
            StringBuilder sb = new StringBuilder();
            sb.Append("[status]");
            sb.Append(" master pid=" + Convert.ToString(ProcessHost.Pid())
                + " mem=" + Convert.ToString(StatsRead(0, "rss") / 1048576)
                + "MB");
            long totQps = 0;
            int procs = MaxCount();
            while (stPrevReq.Count <= procs) {
                stPrevReq.Add(0);
                stPrevCpuMs.Add(0);
            }
            int wid = 1;
            while (wid <= procs) {
                long pid = StatsRead(wid, "pid");
                if (pid == 0) { wid = wid + 1; continue; }
                long recv = StatsRead(wid, "recv");
                long cpu = StatsRead(wid, "cpu");
                long dReq = recv - stPrevReq[wid];
                long dCpu = cpu - stPrevCpuMs[wid];
                stPrevReq[wid] = recv;
                stPrevCpuMs[wid] = cpu;
                long qps = (dReq * 1000) / dWall;
                totQps = totQps + qps;
                long cpuPct = -1;
                if (cpu >= 0 && dCpu >= 0) { cpuPct = (dCpu * 100) / dWall; }
                sb.Append(" | w" + Convert.ToString(wid)
                    + " pid=" + Convert.ToString(pid)
                    + " reqs=" + Convert.ToString(recv)
                    + " qps=" + Convert.ToString(qps)
                    + " sent=" + Convert.ToString(StatsRead(wid, "sent"))
                    + " conns=" + Convert.ToString(StatsRead(wid, "conns"))
                    + " cpu=" + Convert.ToString(cpuPct) + "%"
                    + " mem=" + Convert.ToString(StatsRead(wid, "rss") / 1048576) + "MB");
                wid = wid + 1;
            }
            sb.Append(" | total qps=" + Convert.ToString(totQps));
            Console.WriteLine(sb.ToString());
        }
    }

    /// 多进程网络工作单元与内核套接字调度契约。
    static async void SelfStatusLoop() {
        long prevWall = ServerMetrics.MonoMillis();
        long prevReq = 0;
        long prevCpu = 0;
        while (true) {
            await Task.Delay(statusInterval * 1000);
            long now = ServerMetrics.MonoMillis();
            long dWall = now - prevWall;
            prevWall = now;
            if (dWall <= 0) { continue; }
            long cpu = ServerMetrics.CpuMillis();
            long rss = ServerMetrics.MemoryRssBytes();
            long nowReq = statRequests.Load();
            long qps = ((nowReq - prevReq) * 1000) / dWall;
            long cpuPct = -1;
            if (cpu >= 0) { cpuPct = ((cpu - prevCpu) * 100) / dWall; }
            prevReq = nowReq;
            prevCpu = cpu;
            Console.WriteLine("[status] pid=" + Convert.ToString(ProcessHost.Pid())
                + " reqs=" + Convert.ToString(nowReq)
                + " qps=" + Convert.ToString(qps)
                + " sent=" + Convert.ToString(statSent.Load())
                + " conns=" + Convert.ToString(LiveConnections())
                + " cpu=" + Convert.ToString(cpuPct) + "%"
                + " mem=" + Convert.ToString(rss / 1048576) + "MB");
        }
    }

    /// 网络协程状态调度与数据交互。
    static async bool RecvExact(TcpClient conn, byte[] dest, int need) {
        byte[] tmp = new byte[need + 1];
        int got = 0;
        while (got < need) {
            int n = await Socket.RecvIntoAsync(conn.GetSocket(), tmp, need - got);
            if (n <= 0) { return false; }
            for (int k = 0; k < n; k = k + 1) {
                dest[got + k] = tmp[k];
            }
            got = got + n;
        }
        return true;
    }

    /// 返回字节 b 在字符串中首次出现的下标，未找到返回 -1。
    static int IndexOfByte(string s, int b) {
        for (int i = 0; i < s.Length; i = i + 1) {
            if ((s[i] & 255) == b) { return i; }
        }
        return -1;
    }

    // 核心契约与执行状态转移规范。

    /// 多进程网络工作单元与内核套接字调度契约。
    /// 网络协程状态调度与数据交互。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 网络协程状态调度与数据交互。
    /// 多进程网络工作单元与内核套接字调度契约。
    static async void RunAllLoopsOnSockets(List<nint> socks) {
        CheckProtoEntries();
        int n = socks.Count;
        for (int j = 0; j < n - 1; j = j + 1) {
            Task.Spawn(workers[j].RunOnSocket(socks[j]));
        }
        if (n > 0) {
            await workers[n - 1].RunOnSocket(socks[n - 1]);
        }
    }

    /// 网络协程状态调度与数据交互。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// 网络协程状态调度与数据交互。
    /// or -1.</summary>
    nint BindSocket(bool reusePort) {
        if (this.protocol == "udp") {
            nint u = Socket.CreateUdp();
            Socket.SetReuseAddr(u);
            if (reusePort) { Socket.SetReusePort(u); }
            int r = Socket.Bind(u, this.host, this.port);
            if (r != 0) {
                Worker.lastBindErrInUse = IsAddrInUse(Socket.LastSocketError());
                Worker.lastBindErr = SocketErr();
                Socket.Close(u);
                return -1;
            }
            Socket.SetNonBlocking(u);
            return u;
        }
        nint s = Socket.CreateTcp();
        Socket.SetReuseAddr(s);
        if (reusePort) { Socket.SetReusePort(s); }
        int r2 = Socket.Bind(s, this.host, this.port);
        if (r2 != 0) {
            Worker.lastBindErrInUse = IsAddrInUse(Socket.LastSocketError());
            Worker.lastBindErr = SocketErr();
            Socket.Close(s);
            return -1;
        }
        Socket.Listen(s, 511);
        Socket.SetNonBlocking(s);
        return s;
    }

    // 核心契约与语义定义。
    // 高并发网络事件循环与服务调度契约
    // WorkerWs/WorkerSse/WorkerMqtt），经 Install() 回填到这三个静态槽；
    // 分片文件声明的类型名不被拼写就不进编译图（见 ProtoEntryFn 注释）。
    // 专用协议在 RunAll 经 CheckProtoEntries 前置报错；http 端口只在
    // HasWsHandlers() 且槽非空时才走升级路径。
    static ProtoEntryFn wsEntry;
    static ProtoEntryFn sseEntry;
    static ProtoEntryFn mqttEntry;

    /// 多进程网络工作单元与内核套接字调度契约。
    async void RunOnSocket(nint sock) {
        this.running = true;

        if (this.protocol == "udp") {
            await RunUdp(sock);
            return;
        }

        while (this.running) {
            nint clientSock = await Socket.AcceptAsync(sock);
            if (clientSock >= 0) {
                Socket.SetNonBlocking(clientSock);
                this.Dispatch(clientSock);
            }
        }
    }

    // 网络协程状态调度与数据交互。
    // 多进程网络工作单元与内核套接字调度契约。
    /// 分发一个已接受的客户端 socket：先设 NoDelay；onRawConnection 在场时
    /// 整条连接交给它（回调自主计数，不计入连接数闸门）；否则超过
    /// maxConnections 的连接直接关闭，余者按协议路由到 HTTP/WebSocket/
    /// SSE/MQTT/TCP 处理协程。
    void Dispatch(nint clientSock) {
        Socket.SetNoDelay(clientSock);
        // 多进程网络工作单元与内核套接字调度契约。
        // 多进程网络工作单元与内核套接字调度契约。
        // 多进程网络工作单元与内核套接字调度契约。
        if (this.onRawConnection != null) {
            Task.Spawn(this.RunRaw(clientSock));
            return;
        }
        if (this.connectionCount.Load() >= (long)this.maxConnections) {
            Socket.Close(clientSock);
            return;
        }
        this.AddConn();
        if (this.protocol == "http") {
            // 多进程网络工作单元与内核套接字调度契约。
            // 多进程网络工作单元与内核套接字调度契约。
            // ws 分片未装（WorkerWs.Install() 没调）时槽为空，升级请求
            // 由明文 HTTP 路径应答——RunAll 会为此打告警。
            if (this.HasWsHandlers() && Worker.wsEntry != null) {
                Task.Spawn(this.RunProto(Worker.wsEntry, clientSock));
            } else {
                Task.Spawn(HandleHttp(clientSock));
            }
        } else if (this.protocol == "websocket" || this.protocol == "ws") {
            Task.Spawn(this.RunProto(Worker.wsEntry, clientSock));
        } else if (this.protocol == "sse") {
            Task.Spawn(this.RunProto(Worker.sseEntry, clientSock));
        } else if (this.protocol == "mqtt") {
            Task.Spawn(this.RunProto(Worker.mqttEntry, clientSock));
        } else {
            Task.Spawn(HandleTcp(clientSock));
        }
    }

    /// 多进程网络工作单元与内核套接字调度契约。
    /// 网络协程状态调度与数据交互。
    /// itself arrives as a delegate. 槽为空（分片未装）时关连接归还计数，
    /// 不 NRE——专用协议在 RunAll 已先行报错，这里是兜底。
    async void RunProto(ProtoEntryFn entry, nint clientSock) {
        if (entry == null) {
            Socket.Close(clientSock);
            this.DropConn();
            return;
        }
        await entry(this, clientSock);
    }

    /// RunAll 前的协议分片检查：专用协议（websocket/sse/mqtt）的入口槽为
    /// 空说明对应分片没装（WorkerWs/WorkerSse/WorkerMqtt.Install()），
    /// 直接报错退出——比第一个连接进来时静默断开可诊断得多。http 端口
    /// 设了 ws 回调但没装分片只告警：明文 HTTP 语义不受影响。这里只读
    /// 槽字段，不拼分片类型名（拼了会把分片拉回编译图，槽就白拆了）。
    static void CheckProtoEntries() {
        for (int i = 0; i < workers.Count; i = i + 1) {
            Worker wk = workers[i];
            if (wk.protocol == "websocket" || wk.protocol == "ws") {
                if (Worker.wsEntry == null) {
                    Console.WriteLine("[worker] protocol 'websocket' needs WorkerWs.Install() -- the ws codec compiles in only when installed");
                    exit(1);
                }
            } else if (wk.protocol == "sse") {
                if (Worker.sseEntry == null) {
                    Console.WriteLine("[worker] protocol 'sse' needs WorkerSse.Install() -- the SSE helper compiles in only when installed");
                    exit(1);
                }
            } else if (wk.protocol == "mqtt") {
                if (Worker.mqttEntry == null) {
                    Console.WriteLine("[worker] protocol 'mqtt' needs WorkerMqtt.Install() -- the MQTT broker compiles in only when installed");
                    exit(1);
                }
            } else if (wk.protocol == "http" && wk.HasWsHandlers()
                && Worker.wsEntry == null) {
                Console.WriteLine("[worker] http port has ws callbacks but WorkerWs.Install() was not called; upgrade requests will be answered as plain HTTP");
            }
        }
    }

    /// 网络协程状态调度与数据交互。
    /// 网络协程状态调度与数据交互。
    /// 网络协程状态调度与数据交互。
    /// 核心契约与语义定义。
    async void RunRaw(nint clientSock) {
        // 多进程网络工作单元与内核套接字调度契约。
        await this.onRawConnection(clientSock);
    }

    /// 分配自增连接 id 并构造 Connection。
    Connection NewConnection(nint sock) {
        int id = nextConnId;
        nextConnId = nextConnId + 1;
        return new Connection(id, sock, this.protocol);
    }

    // ---- tcp ----

    /// TCP 连接生命周期：先触发 onConnect，再循环收取数据交给 onMessage
    /// （未设回调时默认回显），非空返回串回发；对端断开后触发 onClose 并
    /// 归还连接计数。回调抛出的异常会跳过顺序清理（Close/DropConn），
    /// 计数漂移会让服务器在 maxConnections 处永久拒绝新连接，因此
    /// 清理在 finally 中执行。
    async void HandleTcp(nint clientSock) {
        TcpClient client = TcpClient.FromSocket(clientSock);
        Connection conn = NewConnection(clientSock);
        try {
            ConnectionHandler onUp = this.OpenHandler();
            if (onUp != null) { await onUp(conn); }

            MessageHandler onData = this.MessageHandlerOf();
            bool active = true;
            while (active && !conn.closed) {
                string data = await client.RecvReuseAsync();
                if (data.Length == 0) {
                    active = false;
                } else {
                    BumpStat();
                    string response = "";
                    if (onData != null) {
                        // 用户回调不受框架信任：抛出只结束本连接，
                        // 不允许撕断 accept 循环之外的任何东西。
                        try {
                            response = await onData(conn, data);
                            if (response == null) { response = ""; }
                        } catch (Exception e) {
                            Console.WriteLine("[tcp] onMessage exception: "
                                + e.Message);
                            response = "";
                        }
                    } else {
                        response = data;  // default: echo
                    }
                    if (response.Length > 0) {
                        int _n = await client.SendAsync(response);
                        BumpSent();
                    }
                }
            }
        } finally {
            client.Close();
            conn.closed = true;
            this.DropConn();
            ConnectionCloseHandler onDown = this.onClose;
            if (onDown != null) { await onDown(conn); }
        }
    }

    // ---- http ----

    /// 多进程网络工作单元与内核套接字调度契约。
    /// 接口数据协议与执行契约。
    /// Worker path and a bare HttpServer cannot drift apart. DropConn 在
    /// finally 中：ServeConnection 抛出时计数同样必须归还。
    async void HandleHttp(nint clientSock) {
        try {
            await HttpServer.ServeConnection(clientSock, this.RequestHandler(),
                this.maxHeaderBytes, this.maxRequestBytes, this.requestTimeout);
        } finally {
            this.DropConn();
        }
    }

    // ---- udp ----

    /// UDP 事件循环：每收到一个数据报调用 onPacket（未设回调时默认回显），
    /// 非空返回串回发给发送方；Stop 置位退出循环后关闭 socket。
    async void RunUdp(nint sock) {
        DatagramHandler onDatagram = this.PacketHandler();
        while (this.running) {
            string data = await Socket.RecvFromPeerAsync(sock, 65536);
            if (data.Length > 0) {
                BumpStat();
                string peerIp = Socket.PeerIp();
                int peerPort = Socket.PeerPort();
                string response = "";
                if (onDatagram != null) {
                    response = await onDatagram(data);
                    if (response == null) { response = ""; }
                } else {
                    response = data;  // default: echo
                }
                if (response.Length > 0 && peerPort > 0) {
                    int _n = await Socket.SendToAsync(sock, response, response.Length, peerIp, peerPort);
                    BumpSent();
                }
            }
        }
        Socket.Close(sock);
    }
}

/// <summary>
/// 多进程网络工作单元与内核套接字调度契约。
/// 网络协程状态调度与数据交互。
/// 多进程网络工作单元与内核套接字调度契约。
/// </summary>
class Connection {
    [DllImport("crt")]
    static extern long strlen(string str);

    int id;
    nint sock;
    string protocol;
    string userData;
    bool closed;

    Connection(int id, nint sock, string protocol) {
        this.id = id;
        this.sock = sock;
        this.protocol = protocol;
        this.userData = "";
        this.closed = false;
    }

    /// 多进程网络工作单元与内核套接字调度契约。
    void SetData(string data) {
        this.userData = data;
    }

    /// 取该连接的自定义应用数据（SetData 设置的值）。
    string GetData() {
        return this.userData;
    }

    /// 连接 id（进程内自增，唯一）。
    int GetId() {
        return this.id;
    }

    /// 底层 socket 句柄。
    nint GetSocket() {
        return this.sock;
    }

    /// 连接所属协议名（如 "http"、"websocket"、"tcp"）。
    string GetProtocol() {
        return this.protocol;
    }

    /// 网络协程状态调度与数据交互。
    /// 接口数据协议与执行契约。
    /// 多进程网络工作单元与内核套接字调度契约。
    /// bytes.</summary>
    void Send(string data) {
        Task.Spawn(Socket.SendStringAsync(this.sock, data));
        Worker.BumpSent();
    }

    /// 多进程网络工作单元与内核套接字调度契约。
    async int SendAsync(string data) {
        int n = await Socket.SendStringAsync(this.sock, data);
        Worker.BumpSent();
        return n;
    }

    /// 多进程网络工作单元与内核套接字调度契约。
    void Close() {
        this.closed = true;
    }

    /// 连接是否已被标记关闭（实际关闭由 worker 循环执行）。
    bool IsClosed() {
        return this.closed;
    }
}
