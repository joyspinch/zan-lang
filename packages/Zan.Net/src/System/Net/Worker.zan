using System;
using System.Net.Sockets;
using System.Net.Http;
using System.Diagnostics;
using System.IO;
using System.Text;
using System.Threading;

namespace System.Net;

// 客户端连接建立时触发的异步回调。
public async delegate void ConnectionHandler(Connection conn);

// TCP 或 WebSocket 收到完整数据包时的异步消息处理回调。
public async delegate string MessageHandler(Connection conn, string data);

// 连接关闭（对端断开或主动关闭）后的异步清理回调。
public async delegate void ConnectionCloseHandler(Connection conn);

// 接收到 UDP 数据报时的回调，返回值非空则回传响应。
public async delegate string DatagramHandler(string data);


// 接入新套接字时的底层劫持回调（覆盖默认事件循环）。
public async delegate void RawConnHandler(nint sock);

// I/O.
public async delegate void ShutdownHook();

public async delegate void ProtoEntryFn(Worker w, nint sock);

// 多进程并发网络工作者：基于单连接单协程模型的高吞吐事件循环。
// onHttpRequest / onRequest           -- http
// onUdpMessage / onPacket             -- udp
// 主从进程模式：Master 进程负责派生并监控各 Worker 工作子进程生命周期。
// Windows IOCP / Linux SO_REUSEPORT 端口复用与内核连接哈希分发。
// 端口监听套接字：内核直接按四元组哈希分发新连接。
public partial class Worker {
    public string protocol;
    public string host;
    public int port;
    public string name;
    private bool running;
    // 连接计数器衰减与最大并发连接数限制阈值检查。
    // everything.
    private AtomicInt connectionCount;
    private int maxConnections;

    private int maxHeaderBytes;
    private int maxRequestBytes;
    private int requestTimeout;

    public int count;

    // TCP 连接建立后调用（tcp 协议；可 await I/O）。
    public ConnectionHandler onConnect;
    // 收到一条完整入站消息后调用；返回串作为应答回发，返回 "" 不回发。
    public MessageHandler onMessage;
    // 连接关闭（对端断开或 conn.Close() 生效）后调用。
    public ConnectionCloseHandler onClose;
    // 每个解析完成的 HTTP 请求调用，返回响应对象。
    public HttpRequestHandler onHttpRequest;
    // 每个完整 UDP 数据报调用；返回串回发给发送方，返回 "" 不回发。
    public DatagramHandler onUdpMessage;
    // 设置后接管该 Worker 的整条连接：socket 交给回调自主驱动，
    // 绕过内建协议处理与连接数闸门。
    public RawConnHandler onRawConnection;

    // onConnect 的 WebSocket 叫法（连接已建立）。
    public ConnectionHandler onOpen;  // websocket: connection established
    // onMessage 的 TCP 叫法（收到字节）。
    public MessageHandler onReceive;  // tcp: bytes arrived
    // onUdpMessage 的 UDP 叫法（收到数据报）。
    public DatagramHandler onPacket;  // udp: datagram arrived
    // onHttpRequest 的 HTTP 叫法（请求已解析）。
    public HttpRequestHandler onRequest;  // http: request parsed


    private static List<Worker> workers = new List<Worker>();
    private static bool daemonize = false;
    private static bool cliMode = false;
    private static bool stopping = false;
    private static List<ShutdownHook> shutdownHooks = new List<ShutdownHook>();
    private static List<TcpClient> ctlConn = new List<TcpClient>();
    private static List<int> ctlWid = new List<int>();
    #if WINDOWS
    private static List<TcpClient> wkChannels = new List<TcpClient>();
    #endif
    private static int controlPort = 0;
    private static bool ctlPortFixed = false;
    private static int nextConnId = 1;
    private static string logDir = "logs";
    private static string logPattern = "{yyyy}{MM}/{dd}.log";

    // 本进程累计服务的请求/消息数（workerman 风格 `status` 统计）。
    private static AtomicInt statRequests = new AtomicInt(0);

    // 静态上下文里的计数自增；实例 async 方法中直接自增会被按值捕获而丢失。
    public static void BumpStat() {
        long _r = statRequests.Increment();
    }

    // 当前工作进程向对端成功写回的数据报文/帧统计数。
    // 本进程累计发回对端的消息/帧/数据报数。
    private static AtomicInt statSent = new AtomicInt(0);

    // 发送计数自增（同 BumpStat 的静态上下文约束）。
    public static void BumpSent() {
        long _s = statSent.Increment();
    }

    // 当前工作进程中维护的活跃客户端连接总数。
    // 本进程所有 Worker 的在线连接总数。
    public static int LiveConnections() {
        int n = 0;
        for (int i = 0; i < workers.Count; i = i + 1) {
            n = n + (int)workers[i].connectionCount.Load();
        }
        return n;
    }

    [DllImport("crt")]
    private static extern void exit(int code);
    [DllImport("crt")]
    private static extern long strlen(string str);
    private static bool debugLog = false;
    // 调试开关判定：供高频热路径在拼接参数字符串前短路，避免生产无谓分配。
    public static bool IsDebug() {
        return debugLog;
    }
    // 调试跟踪输出：SetDebug(true) 时打印 master/worker 交接与握手轨迹。
    // public：HTTP/WS 分片（不同命名空间）也要打同一条轨迹。
    public static void Dbg(string msg) {
        if (!debugLog) { return; }
        Console.WriteLine("[dbg] " + msg);
        #if WINDOWS
        int _f = _flushall();
        #endif
    }
    #if WINDOWS
    [DllImport("crt")]
    private static extern int _flushall();
    #endif
    private static void SetDebug(bool on) {
        debugLog = on;
    }

    // 环境变量开关：ZAN_WORKER_DEBUG=1 时打开交接轨迹。Windows 的
    // master→worker 套接字移交一旦断在半路（客户端只看到 RST、服务端
    // 访问日志里没有这次请求），没有轨迹就无从定位——这条日志是唯一的
    // 证据面。默认关闭（不影响生产路径的输出量）。
    private static void InitDebugFromEnv() {
        string v = Environment.GetEnvironmentVariable("ZAN_WORKER_DEBUG");
        if (v == null || v.Length == 0) { return; }
        if (v == "0") { return; }
        debugLog = true;
    }

    #if !WINDOWS
    // 收紧记录文件权限用（见 RecordControlPort）。
    [DllImport("crt")]
    private static extern int chmod(string path, int mode);
    [DllImport("crt")]
    private static extern int setenv(string name, string val, int overwrite);
    [DllImport("crt")]
    private static extern int unsetenv(string name);
    #endif

    #if WINDOWS
    [DllImport("ws2_32", EntryPoint = "WSADuplicateSocketA")]
    private static extern int WSADuplicateSocketA(nint s, int pid, string info);
    [DllImport("ws2_32", EntryPoint = "WSASocketA")]
    private static extern nint WSASocketA(int af, int type, int protocol, string info, int g, int flags);
    [DllImport("kernel32", EntryPoint = "SetEnvironmentVariableW")]
    private static extern int SetEnvironmentVariableW(nint name, nint val);
    #endif

    // 按协议、监听地址与端口构造 Worker 并注册进全局 Worker 列表；
    // 经 Listen() 使用。
    public Worker(string protocol, string host, int port) {
        this.protocol = protocol;
        this.host = host;
        this.port = port;
        this.name = protocol + "-worker";
        this.running = false;
        this.connectionCount = new AtomicInt(0);
        this.maxConnections = 10000;
        this.maxHeaderBytes = 16384;
        this.maxRequestBytes = 1048576;
        this.requestTimeout = 30000;
        this.count = 1;
        this.onConnect = null;
        this.onMessage = null;
        this.onClose = null;
        this.onHttpRequest = null;
        this.onUdpMessage = null;
        this.onRawConnection = null;
        this.onOpen = null;
        this.onReceive = null;
        this.onPacket = null;
        this.onRequest = null;
        workers.Add(this);
    }

    // onOpen 与 onConnect 中已设置的那个（别名归一）。
    public ConnectionHandler OpenHandler() {
        if (this.onOpen != null) { return this.onOpen; }
        return this.onConnect;
    }

    // onMessage 与 onReceive 中已设置的那个。
    public MessageHandler MessageHandlerOf() {
        if (this.onMessage != null) { return this.onMessage; }
        return this.onReceive;
    }

    // onPacket 与 onUdpMessage 中已设置的那个。
    public DatagramHandler PacketHandler() {
        if (this.onPacket != null) { return this.onPacket; }
        return this.onUdpMessage;
    }

    // onRequest 与 onHttpRequest 中已设置的那个。
    public HttpRequestHandler RequestHandler() {
        if (this.onRequest != null) { return this.onRequest; }
        return this.onHttpRequest;
    }


    // 是否支持 WebSocket 协议升级握手连接。
    public bool HasWsHandlers() {
        if (this.onOpen != null) { return true; }
        if (this.onMessage != null) { return true; }
        return false;
    }

    public static Worker Listen(string address) {
        string proto = "tcp";
        string rest = address;
        int n = address.Length;
        for (int i = 0; i + 2 < n; i = i + 1) {
            if ((address[i] & 255) == 58 && (address[i + 1] & 255) == 47 && (address[i + 2] & 255) == 47) {
                proto = address.Substring(0, i);
                rest = address.Substring(i + 3, n - i - 3);
                break;
            }
        }
        string host = rest;
        int port = 0;
        int colon = -1;
        int j = rest.Length - 1;
        while (j >= 0) {
            if ((rest[j] & 255) == 58) { colon = j; break; }
            j = j - 1;
        }
        if (colon >= 0) {
            host = rest.Substring(0, colon);
            port = Convert.ToInt32(rest.Substring(colon + 1, rest.Length - colon - 1));
        }
        return new Worker(proto, host, port);
    }

    public Worker SetName(string name) {
        this.name = name;
        return this;
    }

    public Worker SetMaxConnections(int max) {
        this.maxConnections = max;
        return this;
    }

    public Worker SetHttpLimits(int maxHeaderBytes, int maxRequestBytes, int timeoutMs) {
        // 与 HttpServer.SetMaxRequestBytes 同一钳制：超出 1 GiB 会让
        // 帧解析的 `headerEnd + bodyLen` int 回绕，判限失效。
        if (maxRequestBytes < 1024) { maxRequestBytes = 1024; }
        if (maxRequestBytes > 1073741824) { maxRequestBytes = 1073741824; }
        this.maxHeaderBytes = maxHeaderBytes;
        this.maxRequestBytes = maxRequestBytes;
        this.requestTimeout = timeoutMs;
        return this;
    }

    public Worker SetCount(int count) {
        this.count = count;
        return this;
    }

    public static void SetDaemonize(bool on) {
        daemonize = on;
    }

    public static void SetControlPort(int port) {
        controlPort = port;
        ctlPortFixed = true;
    }

    public static void SetLogDir(string dir) {
        logDir = dir;
    }

    public static string LogDir() {
        return logDir;
    }

    public static void SetLogPattern(string pattern) {
        if (pattern != "") { logPattern = pattern; }
    }

    public static string LogPath() {
        if (logDir == "") { return ""; }
        return logDir + Path.Separator()
            + Log.ExpandFor(logPattern, DateTime.Now(), ProcessHost.WorkerId());
    }

    // master 启动初期：应用未自配 Log 时按 logDir/logPattern 配置日志，确保监督事件落盘。
    private static void EnsureMasterLog() {
        if (logDir == "") { return; }
        EnsureLogDir();
        if (Log.IsEnabled()) { return; }
        Log.Configure(logDir, logPattern, Log.INFO);
    }

    // 确保当前日志文件所在目录存在（每次 spawn 前调用）。
    private static void EnsureLogDir() {
        if (logDir == "") { return; }
        Log.EnsureDirFor(LogPath());
    }

    // 所有注册 Worker 中最大的 worker 进程数。
    private static int MaxCount() {
        int m = 1;
        for (int i = 0; i < workers.Count; i = i + 1) {
            if (workers[i].count > m) { m = workers[i].count; }
        }
        return m;
    }

    // 控制端口认领 (ClaimControlPort)、探针 (ProbeControlPort) 与
    // CLI 命令行指令派发 (RunCommand/SendCommand) 见 Worker.Control.zan。

    // count is 1.
    public static async void RunAll() {
        Socket.Initialize();
        InitDebugFromEnv();

        if (ProcessHost.IsWorker()) {
            await RunAsWorkerProcess();
            return;
        }

        CheckProtoEntries();
        EnsureMasterLog();
        if (daemonize) {
            if (ProcessHost.DaemonizeTo(LogPath(), logDir)) {
                exit(0);
            }
        }

        int procs = MaxCount();
        if (procs <= 1 && !cliMode) {
            List<nint> socks = new List<nint>();
            for (int i = 0; i < workers.Count; i = i + 1) {
                nint s = workers[i].BindSocket(false);
                if (s < 0) {
                    Console.WriteLine(BindFailure(workers[i]));
                    exit(1);
                }
                socks.Add(s);
            }
            StatsCreate(1);
            Task.Spawn(StatsPublishLoop());
            PrintBanner(1);
            PrintSharedTables();
            if (cliMode) { Task.Spawn(SingleProcessControlLoop()); }
            await RunAllLoopsOnSockets(socks);
            return;
        }

        await RunAsMaster(procs);
    }

    // 状态屏格式化与打印 (PrintBanner/Pad/Rule)、跨进程共享统计表 (StatsTable/StatsCreate/StatsPublish)
    // 与命令行帮助信息 (Usage) 见 Worker.Stats.zan。

    private static void StopAll() {
        for (int i = 0; i < workers.Count; i = i + 1) {
            workers[i].Stop();
        }
    }

    public void Stop() {
        this.running = false;
    }

    // 连接计数 +1（包装一层以便集中丢弃原子自增的返回值）。
    public void AddConn() { long _n = this.connectionCount.Increment(); }
    // 连接计数 -1。
    public void DropConn() { long _n = this.connectionCount.Decrement(); }

    // 当前活连接数（本进程视角；多进程时其他 worker 的
    // 连接不计入）。
    public int GetConnectionCount() {
        return (int)this.connectionCount.Load();
    }

    #if WINDOWS
    // 以宽字符 API 设置环境变量，避免 UTF-8 值经 Windows ANSI 代码页窄化。
    private static void SetWorkerEnv(string name, string val) {
        nint wname = Wide.Of(name);
        nint wval = Wide.Of(val);
        int _ok = SetEnvironmentVariableW(wname, wval);
        Wide.Free(wname);
        Wide.Free(wval);
    }
    #endif


    private static int totalSpawned = 0;
    private static int maxTotalSpawns = 512;

    // Master 派生一个 worker 子进程（wid 从 1 起）：经环境变量传递 worker id、
    // 控制端口、统计表句柄、日志目录与共享表句柄；通过 Process.StartProgram 直接以
    // 原生系统调用（Windows CreateProcessW / POSIX fork+execvp+setsid）安全派生，
    // 彻底消除 /bin/sh 或 cmd.exe Shell 逃逸漏洞与管道死锁风险；总派生数受 maxTotalSpawns 硬上限保护。
    private static void SpawnChild(int wid) {
        if (totalSpawned >= maxTotalSpawns) {
            Console.WriteLine("[Worker] spawn cap (" + Convert.ToString(maxTotalSpawns)
                + ") reached; refusing to spawn more workers");
            return;
        }
        totalSpawned = totalSpawned + 1;
        string exe = ProcessHost.SelfExe();
        int ctl = ControlPort();
        EnsureLogDir();
        string logPath = Worker.LogPath();
        #if WINDOWS
        // like a worker.
        SetWorkerEnv("ZAN_WORKER_ID", Convert.ToString(wid));
        SetWorkerEnv("ZAN_CTL_PORT", Convert.ToString(ctl));
        // inheritance on.
        SetWorkerEnv("ZAN_STATS_HANDLE", Convert.ToString(statOsHandle));
        SetWorkerEnv("ZAN_LOG_DIR", logDir);
        for (int s = 0; s < shareNames.Count; s = s + 1) {
            SetWorkerEnv(ShareEnv(shareNames[s]),
                Convert.ToString(shareHandles[s]));
        }
        int rc = Process.StartProgram(exe, logPath);
        SetWorkerEnv("ZAN_WORKER_ID", "");
        SetWorkerEnv("ZAN_CTL_PORT", "");
        SetWorkerEnv("ZAN_STATS_HANDLE", "");
        for (int c = 0; c < shareNames.Count; c = c + 1) {
            SetWorkerEnv(ShareEnv(shareNames[c]), "");
        }
        if (rc != 0) {
            Log.Error("[Worker] worker " + Convert.ToString(wid)
                + " failed to start: CreateProcess(" + exe + ") failed");
        }
        #else
        // POSIX 侧同样走 setenv 设置环境变量，子进程通过 fork() 自动继承完整环境块，
        // 随后由 Process.StartProgram 直接调用 fork+setsid+dup2+execvp 启动，
        // 彻底消除了原先构造 "/bin/sh -c" 字符串拼接带来的 Shell 命令注入隐患。
        setenv("ZAN_WORKER_ID", Convert.ToString(wid), 1);
        setenv("ZAN_CTL_PORT", Convert.ToString(ctl), 1);
        setenv("ZAN_STATS_HANDLE", Convert.ToString(statOsHandle), 1);
        setenv("ZAN_LOG_DIR", logDir, 1);
        for (int s = 0; s < shareNames.Count; s = s + 1) {
            setenv(ShareEnv(shareNames[s]), Convert.ToString(shareHandles[s]), 1);
        }
        int rc = Process.StartProgram(exe, logPath);
        unsetenv("ZAN_WORKER_ID");
        unsetenv("ZAN_CTL_PORT");
        unsetenv("ZAN_STATS_HANDLE");
        for (int c = 0; c < shareNames.Count; c = c + 1) {
            unsetenv(ShareEnv(shareNames[c]));
        }
        if (rc != 0) {
            Log.Error("[Worker] worker " + Convert.ToString(wid)
                + " failed to start: exec(" + exe + ") failed");
        }
        #endif
        Log.Info("[Worker] worker " + Convert.ToString(wid) + " spawned");
    }

    private static List<int> chIdx = new List<int>();  // listener index served
    private static List<int> chPid = new List<int>();  // worker process pid
    private static List<TcpClient> chConn = new List<TcpClient>();
    private static int rrCounter = 0;

    private static string SocketErr() {
        #if WINDOWS
        return "WSA error " + Convert.ToString(Socket.LastSocketError());
        #else
        return "errno " + Convert.ToString(Socket.LastSocketError());
        #endif
    }

    private static string lastBindErr;

    // 监听绑定失败的完整错误信息；端口被占用时给出可操作的两种处理建议。
    private static string BindFailure(Worker w) {
        string at = w.protocol + "://" + w.host + ":" + Convert.ToString(w.port);
        string s = "[Worker] FATAL: cannot bind " + at + " ("
            + Worker.lastBindErr + ")";
        if (Worker.lastBindErrInUse) {
            s = s + "; the address is already in use -- another program (or a"
                + " previous run of this one that is still alive) is listening"
                + " on it. Stop it, or give this server a free port.";
        }
        return s;
    }

    private static bool lastBindErrInUse;

    // 平台错误号是否表示"地址已被占用"（WSA 10048 / macOS 48 / Linux 98）。
    private static bool IsAddrInUse(int err) {
        #if WINDOWS
        return err == 10048;
        #elif MACOS
        return err == 48;
        #else
        return err == 98;
        #endif
    }

    // master 主流程：先认领控制端口（fork 炸弹防护），再绑定监听、建统计表、派生并监督 procs 个 worker。
    private static async void RunAsMaster(int procs) {
        nint ctlSock = await ClaimControlPort();
        RecordControlPort();
        PrintBanner(procs);
        Socket.Listen(ctlSock, 64);
        Socket.SetNonBlocking(ctlSock);

        #if WINDOWS
        for (int i = 0; i < workers.Count; i = i + 1) {
            Worker w = workers[i];
            nint s = w.BindSocket(false);
            if (s < 0) {
                Console.WriteLine(BindFailure(w));
                exit(1);
            }
            if (w.protocol == "udp") {
                Task.Spawn(w.RunOnSocket(s));
            } else {
                Task.Spawn(MasterAcceptLoop(i, s));
            }
        }
        #endif

        StatsCreate(procs);
        StatsPublish();
        Task.Spawn(StatsPublishLoop());
        PrintSharedTables();

        int wid = 1;
        while (wid <= procs) {
            SpawnChild(wid);
            wid = wid + 1;
        }


        while (true) {
            nint sock = await Socket.AcceptAsync(ctlSock);
            if (sock < 0) { continue; }
            Socket.SetNonBlocking(sock);
            Dbg("ctl accepted sock=" + Convert.ToString(sock));
            Task.Spawn(HandleWorkerControl(sock));
        }
    }

    #if WINDOWS
    // Windows：listener idx 的 master 接受循环，事件驱动 accept 后把连接轮流移交 worker。
    private static async void MasterAcceptLoop(int idx, nint sock) {
        Dbg("accept loop up idx=" + Convert.ToString(idx));
        while (true) {
            nint c = await Socket.AcceptAsync(sock);
            Dbg("accepted idx=" + Convert.ToString(idx) + " c=" + Convert.ToString(c));
            if (c < 0) { continue; }
            await HandoffClient(idx, c);
        }
    }

    private static int PickChannel(int idx) {
        int n = chIdx.Count;
        if (n == 0) { return -1; }
        rrCounter = rrCounter + 1;
        int start = rrCounter;
        for (int k = 0; k < n; k = k + 1) {
            int slot = (start + k) % n;
            if (chIdx[slot] == idx) { return slot; }
        }
        return -1;
    }

    // 关闭并移除一个失效的 handoff 通道（worker 已死/ACK 失败）。
    private static void DropChannel(int slot) {
        chConn[slot].Close();
        chIdx.RemoveAt(slot);
        chPid.RemoveAt(slot);
        chConn.RemoveAt(slot);
    }

    private static async void HandoffClient(int idx, nint c) {
        while (true) {
            int slot = PickChannel(idx);
            if (slot < 0) {
                Socket.Close(c);
                return;
            }
            TcpClient ch = chConn[slot];
            byte[] info = new byte[373];
            int r = WSADuplicateSocketA(c, chPid[slot], info);
            Dbg("dup c=" + Convert.ToString(c) + " -> pid=" + Convert.ToString(chPid[slot]) + " r=" + Convert.ToString(r));
            if (r != 0) {
                Socket.Close(c);
                return;
            }
            int n = await Socket.SendAsync(ch.GetSocket(), info, 372);
            if (n <= 0) { DropChannel(slot); continue; }
            string ack = await ch.RecvAsync(1);
            Dbg("ack len=" + Convert.ToString(ack.Length));
            if (ack.Length == 0) { DropChannel(slot); continue; }
            Socket.Close(c);
            return;
        }
    }
    #endif

    // 处理一条控制端口连接。首行是握手："HELLO <pid> <wid>"（控制/存活
    // 连接）、"CHAN <pid> <listenerIdx>"（Windows 交接通道），CLI 的单词
    // 命令 PING/STOP/RELOAD/STATUS 也在此分流。HELLO 连接随后作为存活
    // 监视长驻：对端关闭即视为 worker 退出，延迟 1s 后重启（stopping
    // 置位时不重启，避免停机后复活）。
    private static async void HandleWorkerControl(nint sock) {
        TcpClient conn = TcpClient.FromSocket(sock);

        string line = "";
        bool ok = true;
        while (true) {
            int nl = IndexOfByte(line, 10);
            if (nl >= 0) { line = line.Substring(0, nl); break; }
            string chunk = await conn.RecvAsync(256);
            if (chunk.Length == 0) { ok = false; break; }
            line = line + chunk;
        }
        if (!ok) { conn.Close(); return; }

        List<string> f = SplitWords(line);
        Dbg("ctl handshake line=" + line);
        if (f.Count == 0) { conn.Close(); return; }

        if (f[0] == "PING" || f[0] == "STOP" || f[0] == "RELOAD"
                || f[0] == "STATUS") {
            await HandleCliCommand(conn, f[0]);
            return;
        }
        if (f.Count < 3) { conn.Close(); return; }

        #if WINDOWS
        if (f[0] == "CHAN") {
            chPid.Add(Convert.ToInt32(f[1]));
            chIdx.Add(Convert.ToInt32(f[2]));
            chConn.Add(conn);
            Dbg("chan registered pid=" + f[1] + " idx=" + f[2] + " total=" + Convert.ToString(chConn.Count));
            return;
        }
        #endif
        if (f[0] != "HELLO") { conn.Close(); return; }
        int childPid = Convert.ToInt32(f[1]);
        int childWid = Convert.ToInt32(f[2]);

        #if !WINDOWS
        int _n = await Socket.SendStringAsync(sock, "GO\n");
        #endif

        Log.Info("[Worker] worker " + Convert.ToString(childWid)
            + " (pid " + Convert.ToString(childPid) + ") online");
        ctlConn.Add(conn);
        ctlWid.Add(childWid);

        while (true) {
            string beat = await conn.RecvAsync(256);
            if (beat.Length == 0) { break; }
        }
        conn.Close();
        DropCtl(conn);
        if (stopping) {
            Log.Info("[Worker] worker " + Convert.ToString(childWid)
                + " (pid " + Convert.ToString(childPid) + ") stopped");
            return;
        }
        await Task.Delay(1000);
        Log.Error("[Worker] worker " + Convert.ToString(childWid) + " pid="
            + Convert.ToString(childPid)
            + " exited; see the records above for its last output; respawning");
        SpawnChild(childWid);
    }

    // worker 退出后将其控制连接从存活表中移除。
    private static void DropCtl(TcpClient conn) {
        for (int i = 0; i < ctlConn.Count; i = i + 1) {
            if (ctlConn[i] == conn) {
                ctlConn.RemoveAt(i);
                ctlWid.RemoveAt(i);
                return;
            }
        }
    }

    private static async void DrainThenExit() {
        StopAll();
        stopping = true;
        #if WINDOWS
        for (int c = 0; c < wkChannels.Count; c = c + 1) {
            wkChannels[c].Close();
        }
        #endif
        int waited = 0;
        while (waited < 30000) {
            int conns = 0;
            for (int i = 0; i < workers.Count; i = i + 1) {
                conns = conns + (int)workers[i].connectionCount.Load();
            }
            if (conns <= 0) { break; }
            await Task.Delay(100);
            waited = waited + 100;
        }
        if (!ProcessHost.IsWorker()) {
            ForgetControlPort();
            StatsDestroy();
        }
        await RunShutdownHooks();
        exit(0);
    }

    private static async void RunShutdownHooks() {
        for (int i = 0; i < shutdownHooks.Count; i = i + 1) {
            try {
                await shutdownHooks[i]();
            } catch (Exception e) {
                Console.WriteLine("[worker] shutdown hook exception: "
                    + e.Message);
            }
        }
    }

    public static void OnShutdown(ShutdownHook hook) { shutdownHooks.Add(hook); }


    // worker 进程入口：向 master 的控制端口发 HELLO 注册。Windows 上为每个
    // TCP listener 开一条 CHAN 交接通道并服务 master 递来的 socket；POSIX 上
    // 等 GO 后自行以 SO_REUSEPORT 绑定各 listener。随后挂载统计上报，并长驻
    // 监视控制连接：master 关闭即退出，收到 QUIT 则排空在途请求后退出。
    private static async void RunAsWorkerProcess() {
        TcpClient ctl = await TcpClient.ConnectAsync("127.0.0.1", ControlPort());
        if (ctl == null || !ctl.IsConnected()) {
            Console.WriteLine("[Worker] worker cannot reach master; exiting");
            exit(1);
        }
        int _h = await ctl.SendAsync("HELLO " + Convert.ToString(ProcessHost.Pid())
            + " " + Convert.ToString(ProcessHost.WorkerId()) + "\n");

        #if WINDOWS
        int i = 0;
        for (; i < workers.Count; i = i + 1) {
            if (workers[i].protocol != "udp") {
                TcpClient ch = await TcpClient.ConnectAsync("127.0.0.1", ControlPort());
                if (ch == null || !ch.IsConnected()) {
                    Console.WriteLine("[Worker] channel connect failed; exiting");
                    exit(1);
                }
                int _c = await ch.SendAsync("CHAN " + Convert.ToString(ProcessHost.Pid())
                    + " " + Convert.ToString(i) + "\n");
                Dbg("worker sent CHAN pid=" + Convert.ToString(ProcessHost.Pid())
                    + " idx=" + Convert.ToString(i)
                    + " sent=" + Convert.ToString(_c));
                wkChannels.Add(ch);
                Task.Spawn(ChannelLoop(ch, workers[i]));
            }
        }
        #else
        string go = await ctl.RecvAsync(16);
        if (go.Length == 0) { exit(1); }
        for (int i = 0; i < workers.Count; i = i + 1) {
            Worker w = workers[i];
            nint s = w.BindSocket(true);
            if (s < 0) {
                Console.WriteLine("[Worker] worker cannot bind "
                    + Convert.ToString(w.port) + "; exiting");
                exit(1);
            }
            Task.Spawn(w.RunOnSocket(s));
        }
        #endif

        StatsAttach();
        Task.Spawn(StatsPublishLoop());

        while (true) {
            string beat = await ctl.RecvAsync(64);
            if (beat.Length == 0) { break; }
            if (IndexOfByte(beat, 81) >= 0) {  // 'Q'
                ctl.Close();
                await DrainThenExit();
                return;
            }
        }
        exit(0);
    }

    #if WINDOWS
    private static async void ChannelLoop(TcpClient ch, Worker w) {
        Dbg("worker chan loop up " + w.protocol);
        while (true) {
            byte[] info = new byte[373];
            bool ok = await RecvExact(ch, info, 372);
            if (!ok) {
                if (stopping) { return; }
                exit(0);  // master gone
            }
            nint s = WSASocketA(-1, -1, -1, info, 0, 1);
            Dbg("worker rebuilt s=" + Convert.ToString(s));
            int _a = await ch.SendAsync("K");
            if (_a <= 0) {
                if (stopping) { return; }
                exit(0);
            }
            if (s >= 0) {
                Socket.SetNonBlocking(s);
                w.Dispatch(s);
            }
        }
    }
    #endif

    // 按空白字符（空格/制表/回车/换行）切分为单词列表。
    private static List<string> SplitWords(string s) {
        List<string> parts = new List<string>();
        if (s == null || s.Length == 0) { return parts; }
        int len = s.Length;
        int start = -1;
        for (int i = 0; i < len; i = i + 1) {
            int c = s[i] & 255;
            bool isSpace = (c == 32 || c == 9 || c == 13 || c == 10);
            if (isSpace) {
                if (start >= 0) {
                    parts.Add(s.Substring(start, i - start));
                    start = -1;
                }
            } else if (start < 0) {
                start = i;
            }
        }
        if (start >= 0) {
            parts.Add(s.Substring(start, len - start));
        }
        return parts;
    }

    private static async bool RecvExact(TcpClient conn, byte[] dest, int need) {
        byte[] tmp = new byte[need + 1];
        int got = 0;
        while (got < need) {
            int n = await Socket.RecvIntoAsync(conn.GetSocket(), tmp, need - got);
            if (n <= 0) { return false; }
            for (int k = 0; k < n; k = k + 1) {
                dest[got + k] = tmp[k];
            }
            got = got + n;
        }
        return true;
    }

    // 返回字节 b 在字符串中首次出现的下标，未找到返回 -1。
    private static int IndexOfByte(string s, int b) {
        for (int i = 0; i < s.Length; i = i + 1) {
            if ((s[i] & 255) == b) { return i; }
        }
        return -1;
    }


    private static async void RunAllLoopsOnSockets(List<nint> socks) {
        CheckProtoEntries();
        int n = socks.Count;
        for (int j = 0; j < n - 1; j = j + 1) {
            Task.Spawn(workers[j].RunOnSocket(socks[j]));
        }
        if (n > 0) {
            await workers[n - 1].RunOnSocket(socks[n - 1]);
        }
    }

    // or -1.
    public nint BindSocket(bool reusePort) {
        if (this.protocol == "udp") {
            nint u = Socket.CreateUdp();
            Socket.SetReuseAddr(u);
            if (reusePort) { Socket.SetReusePort(u); }
            int r = Socket.Bind(u, this.host, this.port);
            if (r != 0) {
                Worker.lastBindErrInUse = IsAddrInUse(Socket.LastSocketError());
                Worker.lastBindErr = SocketErr();
                Socket.Close(u);
                return -1;
            }
            Socket.SetNonBlocking(u);
            return u;
        }
        nint s = Socket.CreateTcp();
        Socket.SetReuseAddr(s);
        if (reusePort) { Socket.SetReusePort(s); }
        int r2 = Socket.Bind(s, this.host, this.port);
        if (r2 != 0) {
            Worker.lastBindErrInUse = IsAddrInUse(Socket.LastSocketError());
            Worker.lastBindErr = SocketErr();
            Socket.Close(s);
            return -1;
        }
        Socket.Listen(s, 511);
        Socket.SetNonBlocking(s);
        return s;
    }

    // WorkerWs/WorkerSse/WorkerMqtt），经 Install() 回填到这三个静态槽；
    // 分片文件声明的类型名不被拼写就不进编译图（见 ProtoEntryFn 注释）。
    // 专用协议在 RunAll 经 CheckProtoEntries 前置报错；http 端口只在
    // HasWsHandlers() 且槽非空时才走升级路径。
    public static ProtoEntryFn wsEntry;
    public static ProtoEntryFn sseEntry;
    public static ProtoEntryFn mqttEntry;

    private async void RunOnSocket(nint sock) {
        this.running = true;

        if (this.protocol == "udp") {
            await RunUdp(sock);
            return;
        }

        while (this.running) {
            nint clientSock = await Socket.AcceptAsync(sock);
            if (clientSock >= 0) {
                Socket.SetNonBlocking(clientSock);
                this.Dispatch(clientSock);
            }
        }
    }

    // 分发一个已接受的客户端 socket：先设 NoDelay；onRawConnection 在场时
    // 整条连接交给它（回调自主计数，不计入连接数闸门）；否则超过
    // maxConnections 的连接直接关闭，余者按协议路由到 HTTP/WebSocket/
    // SSE/MQTT/TCP 处理协程。
    public void Dispatch(nint clientSock) {
        Socket.SetNoDelay(clientSock);
        if (this.onRawConnection != null) {
            Task.Spawn(this.RunRaw(clientSock));
            return;
        }
        if (this.connectionCount.Load() >= (long)this.maxConnections) {
            Socket.Close(clientSock);
            return;
        }
        this.AddConn();
        if (this.protocol == "http") {
            // ws 分片未装（WorkerWs.Install() 没调）时槽为空，升级请求
            // 由明文 HTTP 路径应答——RunAll 会为此打告警。
            if (this.HasWsHandlers() && Worker.wsEntry != null) {
                Task.Spawn(this.RunProto(Worker.wsEntry, clientSock));
            } else {
                Task.Spawn(HandleHttp(clientSock));
            }
        } else if (this.protocol == "websocket" || this.protocol == "ws") {
            Task.Spawn(this.RunProto(Worker.wsEntry, clientSock));
        } else if (this.protocol == "sse") {
            Task.Spawn(this.RunProto(Worker.sseEntry, clientSock));
        } else if (this.protocol == "mqtt") {
            Task.Spawn(this.RunProto(Worker.mqttEntry, clientSock));
        } else {
            Task.Spawn(HandleTcp(clientSock));
        }
    }

    // itself arrives as a delegate. 槽为空（分片未装）时关连接归还计数，
    // 不 NRE——专用协议在 RunAll 已先行报错，这里是兜底。
    private async void RunProto(ProtoEntryFn entry, nint clientSock) {
        if (entry == null) {
            Socket.Close(clientSock);
            this.DropConn();
            return;
        }
        await entry(this, clientSock);
    }

    // RunAll 前的协议分片检查：专用协议（websocket/sse/mqtt）的入口槽为
    // 空说明对应分片没装（WorkerWs/WorkerSse/WorkerMqtt.Install()），
    // 直接报错退出——比第一个连接进来时静默断开可诊断得多。http 端口
    // 设了 ws 回调但没装分片只告警：明文 HTTP 语义不受影响。这里只读
    // 槽字段，不拼分片类型名（拼了会把分片拉回编译图，槽就白拆了）。
    private static void CheckProtoEntries() {
        for (int i = 0; i < workers.Count; i = i + 1) {
            Worker wk = workers[i];
            if (wk.protocol == "websocket" || wk.protocol == "ws") {
                if (Worker.wsEntry == null) {
                    Console.WriteLine("[worker] protocol 'websocket' needs WorkerWs.Install() -- the ws codec compiles in only when installed");
                    exit(1);
                }
            } else if (wk.protocol == "sse") {
                if (Worker.sseEntry == null) {
                    Console.WriteLine("[worker] protocol 'sse' needs WorkerSse.Install() -- the SSE helper compiles in only when installed");
                    exit(1);
                }
            } else if (wk.protocol == "mqtt") {
                if (Worker.mqttEntry == null) {
                    Console.WriteLine("[worker] protocol 'mqtt' needs WorkerMqtt.Install() -- the MQTT broker compiles in only when installed");
                    exit(1);
                }
            } else if (wk.protocol == "http" && wk.HasWsHandlers()
                && Worker.wsEntry == null) {
                Console.WriteLine("[worker] http port has ws callbacks but WorkerWs.Install() was not called; upgrade requests will be answered as plain HTTP");
            }
        }
    }

    private async void RunRaw(nint clientSock) {
        await this.onRawConnection(clientSock);
    }

    // 分配自增连接 id 并构造 Connection。
    private Connection NewConnection(nint sock) {
        int id = nextConnId;
        nextConnId = nextConnId + 1;
        return new Connection(id, sock, this.protocol);
    }

    // ---- tcp ----

    // TCP 连接生命周期：先触发 onConnect，再循环收取数据交给 onMessage
    // （未设回调时默认回显），非空返回串回发；对端断开后触发 onClose 并
    // 归还连接计数。回调抛出的异常会跳过顺序清理（Close/DropConn），
    // 计数漂移会让服务器在 maxConnections 处永久拒绝新连接，因此
    // 清理在 finally 中执行。
    private async void HandleTcp(nint clientSock) {
        TcpClient client = TcpClient.FromSocket(clientSock);
        Connection conn = NewConnection(clientSock);
        try {
            ConnectionHandler onUp = this.OpenHandler();
            if (onUp != null) { await onUp(conn); }

            MessageHandler onData = this.MessageHandlerOf();
            bool active = true;
            while (active && !conn.IsClosed()) {
                string data = await client.RecvReuseAsync();
                if (data.Length == 0) {
                    active = false;
                } else {
                    BumpStat();
                    string response = "";
                    if (onData != null) {
                        // 用户回调不受框架信任：抛出只结束本连接，
                        // 不允许撕断 accept 循环之外的任何东西。
                        try {
                            response = await onData(conn, data);
                            if (response == null) { response = ""; }
                        } catch (Exception e) {
                            Console.WriteLine("[tcp] onMessage exception: "
                                + e.Message);
                            response = "";
                        }
                    } else {
                        response = data;  // default: echo
                    }
                    if (response.Length > 0) {
                        int _n = await client.SendAsync(response);
                        BumpSent();
                    }
                }
            }
        } finally {
            client.Close();
            conn.Close();
            this.DropConn();
            ConnectionCloseHandler onDown = this.onClose;
            if (onDown != null) { await onDown(conn); }
        }
    }

    // ---- http ----

    // Worker path and a bare HttpServer cannot drift apart. DropConn 在
    // finally 中：ServeConnection 抛出时计数同样必须归还。
    private async void HandleHttp(nint clientSock) {
        try {
            await HttpServer.ServeConnection(clientSock, this.RequestHandler(),
                this.maxHeaderBytes, this.maxRequestBytes, this.requestTimeout);
        } finally {
            this.DropConn();
        }
    }

    // ---- udp ----

    // UDP 事件循环：每收到一个数据报调用 onPacket（未设回调时默认回显），
    // 非空返回串回发给发送方；Stop 置位退出循环后关闭 socket。
    private async void RunUdp(nint sock) {
        DatagramHandler onDatagram = this.PacketHandler();
        while (this.running) {
            string data = await Socket.RecvFromPeerAsync(sock, 65536);
            if (data.Length > 0) {
                BumpStat();
                string peerIp = Socket.PeerIp();
                int peerPort = Socket.PeerPort();
                string response = "";
                if (onDatagram != null) {
                    response = await onDatagram(data);
                    if (response == null) { response = ""; }
                } else {
                    response = data;  // default: echo
                }
                if (response.Length > 0 && peerPort > 0) {
                    int _n = await Socket.SendToAsync(sock, response, response.Length, peerIp, peerPort);
                    BumpSent();
                }
            }
        }
        Socket.Close(sock);
    }
}
