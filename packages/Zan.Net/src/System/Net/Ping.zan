using System;
using System.Threading;

namespace System.Net;

// Ping 返回的强类型结果状态。
enum PingStatus {
    // 收到应答。
    Success,
    // 超时内未收到应答。
    TimedOut,
    // 目标不可达（网络或主机）。
    DestinationUnreachable,
    // 报文过大无法传送。
    PacketTooBig,
    // 请求参数被拒（Windows IP_STATUS 11006-11008/11015）。
    BadRequest,
    // 其他错误（句柄/内存/API 失败等）。
    Error
}

// 一条 ICMP echo 结果。
class PingReply {
    // 应答状态。
    public PingStatus status;
    // 应答方地址（Windows 取自应答，可能异于请求串）。
    public string address;
    // 往返时间（毫秒）。
    public int roundtripTime;
    // 应答携带的数据字节数。
    public int dataSize;

    // 是否成功收到应答。
    public bool IsSuccess() { return status == PingStatus.Success; }

    // 主动释放 reply 持有的文本。
    public void Dispose() { address = null; }
}

// ICMP echo 客户端，不经过命令行 shell 或外部 ping 可执行程序。
// Windows 上直接调 iphlpapi；Linux/macOS 上走运行时的 ICMP socket
// （Linux 优先用无需提权的 SOCK_DGRAM/IPPROTO_ICMP “ping socket”，
// 内核不开放时回退到需 root/CAP_NET_RAW 的 SOCK_RAW）。
class Ping {
    // 发送 IPv4 echo 请求，超时 4 秒。
    static PingReply Send(string address) {
        return Ping.Send(address, 4000);
    }

    // 异步发送 IPv4 echo 请求，超时 4 秒（在 Worker 线程池运行，非阻塞）。
    static async Task<PingReply> SendAsync(string address) {
        return await Ping.SendAsync(address, 4000);
    }

    // 异步发送 IPv4 echo 请求并等待应答（在 Worker 线程池运行，不阻塞调用线程与渲染帧）。
    static async Task<PingReply> SendAsync(string address, int timeoutMs) {
        TaskCompletionSource<PingReply> tcs = new TaskCompletionSource<PingReply>();
        Task.Run(delegate () {
            try {
                PingReply r = Ping.Send(address, timeoutMs);
                tcs.SetResult(r);
            } catch (Exception ex) {
                tcs.SetException(ex);
            }
        });
        return await tcs.Task;
    }

    // 发送 IPv4 echo 请求并返回类型化回复。
    // 发送 IPv4 echo 请求并等待应答，最多
    // <paramref name="timeoutMs"/> 毫秒（负值按 0 处理）。地址不是
    // 合法 IPv4 时抛 ArgumentException（Windows 侧对广播地址
    // "255.255.255.255" 网开一面）；非 Windows 下 socket/权限错误
    // 映射为 <see cref="PingStatus.Error"/>。
    static PingReply Send(string address, int timeoutMs) {
        #if WINDOWS
        if (timeoutMs < 0) { timeoutMs = 0; }
        int destination = Ping.ParseIPv4(address);
        if (destination == -1 && address != "255.255.255.255") {
            throw new ArgumentException("Ping address must be an IPv4 address");
        }

        PingReply result = new PingReply();
        result.status = PingStatus.Error;
        result.address = address;
        result.roundtripTime = 0;
        result.dataSize = 0;

        nint handle = Ping.IcmpCreateFile();
        if (handle == (nint)-1 || handle == 0) { return result; }

        try {
            string payload = "zan-ping";
            nint request = NativeMemory.Alloc(payload.Length);
            try {
                NativeMemory.PutString(request, 0, payload, payload.Length);
                // x64 下 ICMP_ECHO_REPLY 为 40 字节，为返回的数据留出空间
                // 以及 API 文档所述的额外 8 字节错误负载。
                int replySize = 40 + payload.Length + 8;
                nint reply = NativeMemory.Alloc(replySize);
                try {
                    int count = Ping.IcmpSendEcho(handle, destination, request,
                        (ushort)payload.Length, 0, reply, replySize, timeoutMs);
                    if (count > 0) {
                        int nativeStatus = new Span<int>(reply + 4, 1)[0];
                        result.status = Ping.MapStatus(nativeStatus);
                        result.roundtripTime = new Span<int>(reply + 8, 1)[0];
                        result.dataSize = (int)new Span<ushort>(reply + 12, 1)[0];
                        result.address = Ping.FormatIPv4(new Span<int>(reply, 1)[0]);
                    }
                } finally {
                    NativeMemory.Free(reply);
                }
            } finally {
                NativeMemory.Free(request);
            }
        } finally {
            Ping.IcmpCloseHandle(handle);
        }
        return result;
        #else
        if (timeoutMs < 0) { timeoutMs = 0; }
        PingReply result = new PingReply();
        result.address = address;
        result.roundtripTime = 0;
        result.dataSize = 0;
        int rc = Ping.NativeIcmpPing(address, timeoutMs);
        if (rc >= 0) {
            result.status = PingStatus.Success;
            result.roundtripTime = rc;
            result.dataSize = 8;
            return result;
        }
        if (rc == -1) { result.status = PingStatus.TimedOut; return result; }
        if (rc == -2) {
            result.status = PingStatus.DestinationUnreachable;
            return result;
        }
        if (rc == -4) {
            throw new ArgumentException("Ping address must be an IPv4 address");
        }
        result.status = PingStatus.Error;
        return result;
        #endif
    }

    #if !WINDOWS
    // 平台 ICMP 实现：返回往返毫秒（&gt;= 0），或
    // -1 超时 / -2 不可达 / -3 socket 或权限错误 / -4 地址无法解析。
    [DllImport("crt", EntryPoint = "zan_plat_icmp_ping")]
    static extern int NativeIcmpPing(string address, int timeoutMs);
    #endif

    #if WINDOWS
    [DllImport("iphlpapi", EntryPoint = "IcmpCreateFile")]
    static extern nint IcmpCreateFile();

    [DllImport("iphlpapi", EntryPoint = "IcmpSendEcho")]
    static extern int IcmpSendEcho(nint handle, int destination, nint request,
                                   ushort requestSize, nint options, nint reply,
                                   int replySize, int timeoutMs);

    [DllImport("iphlpapi", EntryPoint = "IcmpCloseHandle")]
    static extern int IcmpCloseHandle(nint handle);

    // 把 Windows IP_STATUS 码映射为 <see cref="PingStatus"/>。
    static PingStatus MapStatus(int status) {
        if (status == 0) { return PingStatus.Success; }
        if (status == 11010) { return PingStatus.TimedOut; }
        if (status == 11009) { return PingStatus.PacketTooBig; }
        if (status == 11004 || status == 11005 || status == 11002
            || status == 11003) { return PingStatus.DestinationUnreachable; }
        if (status == 11006 || status == 11007 || status == 11008
            || status == 11015) { return PingStatus.BadRequest; }
        return PingStatus.Error;
    }

    // 点分 IPv4 解析为 Windows IPAddr——网络序字节按小端
    // 解释的 DWORD（因此 127.0.0.1 变成 0x0100007f）。非法格式返回 -1。
    static int ParseIPv4(string text) {
        if (text == null || text.Length == 0) { return -1; }
        int packed = 0;
        int part = 0;
        int digits = 0;
        int octet = 0;
        int len = text.Length;
        for (int i = 0; i <= len; i = i + 1) {
            bool atEnd = (i == len);
            int c = atEnd ? 46 : (text[i] & 255);
            if (c == 46) {  // '.'
                if (digits == 0 || octet > 255 || part > 3) { return -1; }
                packed = packed | (octet << (part * 8));
                part = part + 1;
                octet = 0;
                digits = 0;
            } else {
                if (c < 48 || c > 57 || digits >= 3) { return -1; }
                octet = octet * 10 + (c - 48);
                digits = digits + 1;
            }
        }
        if (part != 4) { return -1; }
        return packed;
    }

    // 单字符十进制数字；"0" 与非 1-9 字符都返回 0。
    static int Digit(string ch) {
        if (ch == "1") { return 1; }
        if (ch == "2") { return 2; }
        if (ch == "3") { return 3; }
        if (ch == "4") { return 4; }
        if (ch == "5") { return 5; }
        if (ch == "6") { return 6; }
        if (ch == "7") { return 7; }
        if (ch == "8") { return 8; }
        if (ch == "9") { return 9; }
        return 0;
    }

    // IPAddr DWORD 还原为点分十进制。
    static string FormatIPv4(int packed) {
        return Convert.ToString(packed & 255) + "."
            + Convert.ToString((packed >> 8) & 255) + "."
            + Convert.ToString((packed >> 16) & 255) + "."
            + Convert.ToString((packed >> 24) & 255);
    }
    #endif
}
