using System;
using System.Threading;
using System.Net.Sockets;
using System.Net.Http;
using System.Net.Sse;
using System.Net.WebSocket;

namespace System.Net;

// （原 Worker.zan 顶层委托——签名引用 SseConnection，随 SSE 分片外迁，
// 否则核心文件会把 SSE 家族拖进一切 Worker 程序。）
public async delegate void SseSubscriberHandler(SseConnection conn);

// SSE 协议分片：订阅握手/事件流处理，从 Worker.zan 外迁
// 为独立类。应用调用一次 WorkerSse.Install() 本文件才进编译图（并连带
// 拉入 SseClient.zan），纯 HTTP 服务不背 SSE；订阅回调从原来的 Worker 字段
// 改为这里的静态字段 WorkerSse.onSseSubscriber（签名引用 SseConnection，
// 放在核心会把 SSE 拖回编译图）。槽反转与独立类（不写 partial Worker）
// 的理由见 Worker.ProtoEntryFn 的文档。
public class WorkerSse {
    // SSE 订阅者握手完成后调用；应用持有 SseConnection 主动推事件。
    public static SseSubscriberHandler onSseSubscriber;

    // ---- 面向对象 SseHub 服务委托 ----
    public static SseHub defaultHub = new SseHub();
    public static SseHub Hub { get { return WorkerSse.defaultHub; } }

    public static List<SseConnection> conns {
        get { return WorkerSse.defaultHub.conns; }
    }
    public static nint sseLock {
        get { return WorkerSse.defaultHub.sseLock; }
        set { WorkerSse.defaultHub.sseLock = value; }
    }
    public static WsSharedBus sharedBus {
        get { return WorkerSse.defaultHub.sharedBus; }
        set { WorkerSse.defaultHub.sharedBus = value; }
    }
    public static WorkerSseConsumer busConsumer {
        get { return WorkerSse.defaultHub.busConsumer; }
        set { WorkerSse.defaultHub.busConsumer = value; }
    }

    public static void SseInit() { WorkerSse.defaultHub.SseInit(); }
    public static void EnableSharedBus(string busName) { WorkerSse.defaultHub.EnableSharedBus(busName); }
    public static void DisableSharedBus() { WorkerSse.defaultHub.DisableSharedBus(); }

    public static void Install() {
        Worker.sseEntry = WorkerSse.HandleSse;
        WorkerSse.EnableSharedBus("zan_sse_worker_bus");
    }

    public static void Uninstall() {
        Worker.sseEntry = null;
        WorkerSse.onSseSubscriber = null;
        WorkerSse.defaultHub.Clear();
    }

    public static void Attach(SseConnection conn) {
        WorkerSse.defaultHub.Attach(conn);
    }

    public static void Detach(SseConnection conn) {
        WorkerSse.defaultHub.Detach(conn);
    }

    public static int ConnCount() {
        return WorkerSse.defaultHub.ConnCount();
    }

    public static int ClusterConnCount() {
        return WorkerSse.defaultHub.ClusterConnCount();
    }

    public static async int BroadcastLocal(string eventName, string data) {
        return await WorkerSse.defaultHub.BroadcastLocal(eventName, data);
    }

    public static async int Broadcast(string eventName, string data) {
        return await WorkerSse.defaultHub.Broadcast(eventName, data);
    }

    public static async int Broadcast(string data) {
        return await WorkerSse.defaultHub.Broadcast(data);
    }

    public static async void OnSharedMessage(int targetType, string channel, int targetId, string payload, int payloadLen) {
        await WorkerSse.defaultHub.BroadcastLocal(channel, payload);
    }

    // SSE 订阅：读取 GET 请求头后回 200 text/event-stream（带 no-cache 与
    // CORS 通配头），把连接包成 SseConnection 交给 onSseSubscriber（未设
    // 回调时立即关闭）；此后连接由应用持有。请求头读取与 HTTP 路径
    // 一样武装 requestTimeout（慢速滴字客户端不能永久钉住连接），
    // 清理在 finally 中执行——无论是读头中断、慢速超时还是 onSseSubscriber 抛出，DropConn 都绝不能丢。
    public static async void HandleSse(Worker w, nint clientSock) {
        TcpClient client = TcpClient.FromSocket(clientSock);
        try {
            HttpDeadlineToken watch = HttpDeadline.Arm(clientSock, w.requestTimeout);

            string req = "";
            try {
                while (HttpServer.FindHeaderEnd(req) < 0 && req.Length < 65536) {
                    string chunk = await client.RecvAsync(4096);
                    if (chunk.Length == 0) {
                        client.Close();
                        return;
                    }
                    req = req + chunk;
                }
            } finally {
                HttpDeadline.Disarm(watch);
            }
            string path = "/";
            HttpRequest head = HttpRequest.Parse(req);
            if (head.path.Length > 0) { path = head.path; }

            int _n = await client.SendAsync("HTTP/1.1 200 OK\r\n"
                + "Content-Type: text/event-stream\r\n"
                + "Cache-Control: no-cache\r\n"
                + "Connection: keep-alive\r\n"
                + "Access-Control-Allow-Origin: *\r\n"
                + "\r\n");

            Worker.BumpStat();
            SseConnection sse = SseConnection.Of(client, path);
            WorkerSse.Attach(sse);
            try {
                if (WorkerSse.onSseSubscriber != null) {
                    await WorkerSse.onSseSubscriber(sse);
                } else {
                    sse.Close();
                }
            } finally {
                WorkerSse.Detach(sse);
            }
        } finally {
            w.DropConn();
        }
    }
}

// SSE 业务连接中枢与广播 Hub 服务（面向对象化封装）
public class SseHub {
    public List<SseConnection> conns = new List<SseConnection>();
    public nint sseLock = Mutex.Create();
    public WsSharedBus sharedBus = null;
    public WorkerSseConsumer busConsumer = null;

    public void SseInit() {
        if (this.sseLock == 0) { this.sseLock = Mutex.Create(); }
    }

    public void EnableSharedBus(string busName) {
        if (this.sharedBus != null) { return; }
        this.sharedBus = new WsSharedBus(busName, 128);
        if (this.sharedBus.IsAvailable()) {
            this.busConsumer = new WorkerSseConsumer();
            this.sharedBus.StartPolling(this.busConsumer);
        }
    }

    public void DisableSharedBus() {
        if (this.sharedBus != null) { this.sharedBus.Stop(); }
        this.sharedBus = null;
        this.busConsumer = null;
    }

    public void Attach(SseConnection conn) {
        this.SseInit();
        Mutex.Lock(this.sseLock);
        this.conns.Add(conn);
        Mutex.Unlock(this.sseLock);
        if (this.sharedBus != null) {
            this.sharedBus.OnConnChange(1);
        }
    }

    public void Detach(SseConnection conn) {
        this.SseInit();
        Mutex.Lock(this.sseLock);
        for (int i = 0; i < this.conns.Count; i = i + 1) {
            if (this.conns[i] == conn) {
                this.conns.RemoveAt(i);
                break;
            }
        }
        Mutex.Unlock(this.sseLock);
        if (this.sharedBus != null) {
            this.sharedBus.OnConnChange(-1);
        }
    }

    public int ConnCount() {
        this.SseInit();
        Mutex.Lock(this.sseLock);
        int n = this.conns.Count;
        Mutex.Unlock(this.sseLock);
        return n;
    }

    public int ClusterConnCount() {
        if (this.sharedBus != null && this.sharedBus.IsAvailable()) {
            return this.sharedBus.GetTotalConnCount();
        }
        return this.ConnCount();
    }

    public async int BroadcastLocal(string eventName, string data) {
        this.SseInit();
        Mutex.Lock(this.sseLock);
        List<SseConnection> snap = new List<SseConnection>();
        for (int i = 0; i < this.conns.Count; i = i + 1) {
            snap.Add(this.conns[i]);
        }
        Mutex.Unlock(this.sseLock);
        int sent = 0;
        for (int i = 0; i < snap.Count; i = i + 1) {
            SseConnection s = snap[i];
            if (s.IsOpen()) {
                int n = await s.SendAsync(eventName, data);
                if (n > 0) { sent = sent + 1; }
            }
        }
        return sent;
    }

    public async int Broadcast(string eventName, string data) {
        int sent = await this.BroadcastLocal(eventName, data);
        if (this.sharedBus != null && this.sharedBus.IsAvailable()) {
            this.sharedBus.PublishChannel(eventName, data, data.Length);
        }
        return sent;
    }

    public async int Broadcast(string data) {
        return await this.Broadcast("", data);
    }

    public void Clear() {
        this.DisableSharedBus();
        if (this.sseLock != 0) {
            Mutex.Lock(this.sseLock);
            this.conns.Clear();
            Mutex.Unlock(this.sseLock);
        }
    }
}
