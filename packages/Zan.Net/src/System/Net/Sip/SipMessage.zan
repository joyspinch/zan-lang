using System;

namespace System.Net.Sip;

// SIP 头部实体记录（键/值对）。
public class SipMessage {
    public bool isRequest;
    public string method;  // 请求："REGISTER"、"OPTIONS"、"INVITE" 等
    public string uri;  // 请求目标
    public int status;  // 响应：200、401、486 等
    public string reason;  // 响应原因短语
    public List<SipHeader> headers;
    public string body;

    public SipMessage() {
        this.isRequest = false;
        this.method = "";
        this.uri = "";
        this.status = 0;
        this.reason = "";
        this.headers = new List<SipHeader>();
        this.body = "";
    }

    // 创建请求消息。
    public static SipMessage Request(string method, string uri) {
        SipMessage m = new SipMessage();
        m.isRequest = true;
        m.method = method;
        m.uri = uri;
        return m;
    }

    // 创建响应消息。
    public static SipMessage Response(int status, string reason) {
        SipMessage m = new SipMessage();
        m.isRequest = false;
        m.status = status;
        m.reason = reason;
        return m;
    }

    public bool GetIsRequest() { return this.isRequest; }
    public string GetMethod() { return this.method; }
    public string GetUri() { return this.uri; }
    public int GetStatus() { return this.status; }
    public string GetReason() { return this.reason; }
    public string GetBody() { return this.body; }
    public void SetBody(string b) { this.body = b; }

    private static bool IsTrimWs(int c) {
        return c == 32 || (c >= 9 && c <= 13);
    }

    // 从头部中提取 tag 参数（例如从 "<sip:alice@domain>;tag=12345" 提取 "12345"）。
    public static string ExtractTag(string headerValue) {
        if (headerValue == null || headerValue.Length == 0) { return ""; }
        int idx = headerValue.IndexOf("tag=");
        if (idx < 0) { return ""; }
        int n = headerValue.Length;
        nint hp = (nint)headerValue;
        int start = idx + 4;
        int end = NativeMemory.Find(hp, start, 59, n - start); // ';'
        if (end < 0) {
            end = NativeMemory.Find(hp, start, 62, n - start); // '>'
        }
        if (end < 0) { end = n; }
        while (start < end && SipMessage.IsTrimWs(headerValue[start] & 255)) { start = start + 1; }
        while (end > start && SipMessage.IsTrimWs(headerValue[end - 1] & 255)) { end = end - 1; }
        return start < end ? NativeMemory.GetString(hp, start, end - start) : "";
    }

    public static string SanitizeHeaderToken(string s) {
        if (s == null || s.Length == 0) { return ""; }
        int n = s.Length;
        Span<byte> sb = new Span<byte>((nint)s, n);
        for (int i = 0; i < n; i = i + 1) {
            int c = sb[i] & 255;
            if (c <= 32 || c >= 127 || c == 58) {
                return ""; // 包含换行、控制符或冒号直接拒绝整条非法头名
            }
        }
        return s;
    }

    // 干净值快路径零拷贝返回 s；仅含 CRLF 或非法控制字符时单次分配清洗。
    public static string SanitizeHeaderValue(string s) {
        if (s == null || s.Length == 0) { return ""; }
        int n = s.Length;
        nint sp = (nint)s;
        Span<byte> sb = new Span<byte>(sp, n);
        int dirtyAt = -1;
        for (int i = 0; i < n; i = i + 1) {
            int c = sb[i] & 255;
            if (c < 32 && c != 9) {
                dirtyAt = i;
                break;
            }
        }
        if (dirtyAt < 0) { return s; }
        int cut = n;
        for (int i = dirtyAt; i < n; i = i + 1) {
            int c = sb[i] & 255;
            if (c == 13 || c == 10) {
                cut = i;
                break;
            }
        }
        if (cut == 0) { return ""; }
        byte[] outb = new byte[cut];
        int oPos = dirtyAt;
        if (dirtyAt > 0) {
            NativeMemory.Copy((nint)outb, sp, dirtyAt);
        }
        for (int i = dirtyAt; i < cut; i = i + 1) {
            int c = sb[i] & 255;
            if (c >= 32 || c == 9) {
                outb[oPos] = (byte)c;
                oPos = oPos + 1;
            }
        }
        return oPos == 0 ? "" : NativeMemory.GetString((nint)outb, 0, oPos);
    }

    // 添加头部（追加；SIP 允许重复，如 Via）。
    // 自动清洗 CRLF 与非法控制字符，杜绝 SIP 头注入与走私。
    public SipMessage Add(string name, string headerValue) {
        if (name == null || headerValue == null) { return this; }
        string cleanName = SipMessage.SanitizeHeaderToken(name);
        if (cleanName.Length > 0) {
            string cleanVal = SipMessage.SanitizeHeaderValue(headerValue);
            this.headers.Add(new SipHeader(cleanName, cleanVal));
        }
        return this;
    }

    private static int GetCompactHeaderByte(string name) {
        if (name == null) { return -1; }
        int len = name.Length;
        if (len == 1) {
            int c = name[0] & 255;
            if (c >= 65 && c <= 90) { c = c + 32; }
            switch (c) {
                case 105: return 105; // i
                case 102: return 102; // f
                case 116: return 116; // t
                case 118: return 118; // v
                case 109: return 109; // m
                case 99:  return 99;  // c
                case 108: return 108; // l
                case 115: return 115; // s
                default:  return -1;
            }
        }
        switch (len) {
            case 2:
                return SipMessage.NameEq(name, "To") ? 116 : -1;
            case 3:
                return SipMessage.NameEq(name, "Via") ? 118 : -1;
            case 4:
                return SipMessage.NameEq(name, "From") ? 102 : -1;
            case 7:
                int c0 = name[0] & 255;
                if (c0 >= 65 && c0 <= 90) { c0 = c0 + 32; }
                if (c0 == 99) {
                    if (SipMessage.NameEq(name, "Call-ID")) { return 105; }
                    if (SipMessage.NameEq(name, "Contact")) { return 109; }
                } else if (c0 == 115 && SipMessage.NameEq(name, "Subject")) {
                    return 115;
                }
                return -1;
            case 12:
                return SipMessage.NameEq(name, "Content-Type") ? 99 : -1;
            case 14:
                return SipMessage.NameEq(name, "Content-Length") ? 108 : -1;
            default:
                return -1;
        }
    }

    // 获取 RFC 3261 标准紧凑单字母头部缩写（长度 + 首字母 O(1) 分发）
    public static string GetCompactHeaderName(string name) {
        switch (SipMessage.GetCompactHeaderByte(name)) {
            case 105: return "i";
            case 102: return "f";
            case 116: return "t";
            case 118: return "v";
            case 109: return "m";
            case 99:  return "c";
            case 108: return "l";
            case 115: return "s";
            default:  return "";
        }
    }

    // 头部（名称不区分大小写，自动支持 RFC 3261 紧凑缩写）的第一个值，没有则返回 ""。
    public string Header(string name) {
        if (name == null) { return ""; }
        int targetLen = name.Length;
        int compactByte = SipMessage.GetCompactHeaderByte(name);
        List<SipHeader> hs = this.headers;
        int cnt = hs.Count;
        for (int i = 0; i < cnt; i = i + 1) {
            SipHeader h = hs[i];
            string hname = h.name;
            int hlen = hname.Length;
            if (hlen == 1 && compactByte >= 0) {
                int c = hname[0] & 255;
                if (c >= 65 && c <= 90) { c = c + 32; }
                if (c == compactByte) { return h.value; }
            } else if (hlen == targetLen && SipMessage.NameEq(hname, name)) {
                return h.value;
            }
        }
        return "";
    }

    // 头部名 ASCII 大小写不敏感相等比较。
    public static bool NameEq(string a, string b) {
        if (a == null || b == null) { return a == b; }
        int len = a.Length;
        if (len != b.Length) { return false; }
        for (int i = 0; i < len; i = i + 1) {
            int ca = a[i] & 255;
            int cb = b[i] & 255;
            if (ca == cb) { continue; }
            if (ca >= 65 && ca <= 90) { ca = ca + 32; }
            if (cb >= 65 && cb <= 90) { cb = cb + 32; }
            if (ca != cb) { return false; }
        }
        return true;
    }

    private static bool IsContentLengthSlice(Span<byte> db, int start, int len) {
        if (len == 1) {
            int c = db[start] & 255;
            return c == 108 || c == 76; // 'l' or 'L'
        }
        if (len != 14) { return false; }
        string target = "content-length";
        for (int i = 0; i < 14; i = i + 1) {
            int c = db[start + i] & 255;
            if (c >= 65 && c <= 90) { c = c + 32; }
            if (c != (target[i] & 255)) { return false; }
        }
        return true;
    }

    private static int IntDecLen(int v) {
        if (v < 0) {
            if (v == -2147483648) { return 11; }
            return 1 + SipMessage.IntDecLen(0 - v);
        }
        if (v < 10) { return 1; }
        if (v < 100) { return 2; }
        if (v < 1000) { return 3; }
        if (v < 10000) { return 4; }
        int n = 5;
        int x = v / 100000;
        while (x > 0) { n = n + 1; x = x / 10; }
        return n;
    }

    private static int WriteIntDec(byte[] dst, int pos, int v) {
        if (v == 0) {
            dst[pos] = 48;
            return pos + 1;
        }
        if (v < 0) {
            string s = Convert.ToString(v);
            NativeMemory.PutString((nint)dst, pos, s, s.Length);
            return pos + s.Length;
        }
        int dlen = SipMessage.IntDecLen(v);
        int end = pos + dlen;
        int p = end - 1;
        while (v > 0) {
            int q = v / 10;
            dst[p] = (byte)(48 + (v - q * 10));
            p = p - 1;
            v = q;
        }
        return end;
    }

    // 序列化为线上形式（精确两遍计算 + 单次 byte[] 分配直写，零 StringBuilder）。
    // Content-Length 自动生成。
    public string Serialize() {
        List<SipHeader> hs = this.headers;
        int hCount = hs.Count;
        string bodyStr = this.body != null ? this.body : "";
        int bodyLen = bodyStr.Length;
        int total = 0;

        if (this.isRequest) {
            string meth = this.method != null ? this.method : "";
            string u = this.uri != null ? this.uri : "";
            total = meth.Length + 1 + u.Length + 10; // " " + " SIP/2.0\r\n"
        } else {
            string rsn = this.reason != null ? this.reason : "";
            total = 8 + SipMessage.IntDecLen(this.status) + 1 + rsn.Length + 2; // "SIP/2.0 " + status + " " + reason + "\r\n"
        }

        for (int i = 0; i < hCount; i = i + 1) {
            SipHeader h = hs[i];
            total = total + h.name.Length + 2 + h.value.Length + 2;
        }
        int bodyLenDigits = SipMessage.IntDecLen(bodyLen);
        total = total + 16 + bodyLenDigits + 4 + bodyLen; // "Content-Length: " + digits + "\r\n\r\n" + body

        byte[] outb = new byte[total];
        nint oPtr = (nint)outb;
        int pos = 0;

        if (this.isRequest) {
            string meth = this.method != null ? this.method : "";
            string u = this.uri != null ? this.uri : "";
            if (meth.Length > 0) { NativeMemory.PutString(oPtr, pos, meth, meth.Length); pos = pos + meth.Length; }
            outb[pos] = 32; pos = pos + 1;
            if (u.Length > 0) { NativeMemory.PutString(oPtr, pos, u, u.Length); pos = pos + u.Length; }
            NativeMemory.PutString(oPtr, pos, " SIP/2.0\r\n", 10); pos = pos + 10;
        } else {
            string rsn = this.reason != null ? this.reason : "";
            NativeMemory.PutString(oPtr, pos, "SIP/2.0 ", 8); pos = pos + 8;
            pos = SipMessage.WriteIntDec(outb, pos, this.status);
            outb[pos] = 32; pos = pos + 1;
            if (rsn.Length > 0) { NativeMemory.PutString(oPtr, pos, rsn, rsn.Length); pos = pos + rsn.Length; }
            outb[pos] = 13; outb[pos + 1] = 10; pos = pos + 2;
        }

        for (int i = 0; i < hCount; i = i + 1) {
            SipHeader h = hs[i];
            string hn = h.name;
            string hv = h.value;
            if (hn.Length > 0) { NativeMemory.PutString(oPtr, pos, hn, hn.Length); pos = pos + hn.Length; }
            outb[pos] = 58; outb[pos + 1] = 32; pos = pos + 2;
            if (hv.Length > 0) { NativeMemory.PutString(oPtr, pos, hv, hv.Length); pos = pos + hv.Length; }
            outb[pos] = 13; outb[pos + 1] = 10; pos = pos + 2;
        }

        NativeMemory.PutString(oPtr, pos, "Content-Length: ", 16); pos = pos + 16;
        pos = SipMessage.WriteIntDec(outb, pos, bodyLen);
        outb[pos] = 13; outb[pos + 1] = 10; outb[pos + 2] = 13; outb[pos + 3] = 10; pos = pos + 4;
        if (bodyLen > 0) {
            NativeMemory.PutString(oPtr, pos, bodyStr, bodyLen);
        }
        return NativeMemory.GetString(oPtr, 0, total);
    }

    // 安全解析十进制非负整数，非法字符或空串返回 -1。
    public static int ParsePositiveInt(string s) {
        if (s == null || s.Length == 0) { return -1; }
        int v = 0;
        int n = s.Length;
        for (int i = 0; i < n; i = i + 1) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { return -1; }
            v = v * 10 + (c - 48);
        }
        return v;
    }

    private static int ParsePositiveIntSlice(Span<byte> db, int start, int end) {
        if (start >= end) { return -1; }
        int v = 0;
        for (int i = start; i < end; i = i + 1) {
            int c = db[i] & 255;
            if (c < 48 || c > 57) { return -1; }
            v = v * 10 + (c - 48);
        }
        return v;
    }

    private static bool StartsWithSip20(Span<byte> db, int start, int end, bool needSpace) {
        int need = needSpace ? 8 : 7;
        if (end - start < need) { return false; }
        if ((db[start] & 255) != 83 || (db[start + 1] & 255) != 73 || (db[start + 2] & 255) != 80
            || (db[start + 3] & 255) != 47 || (db[start + 4] & 255) != 50
            || (db[start + 5] & 255) != 46 || (db[start + 6] & 255) != 48) {
            return false;
        }
        if (needSpace && (db[start + 7] & 255) != 32) { return false; }
        return true;
    }

    // 解析线上消息；起始行不是 SIP 时返回 null（NativeMemory.Find 直扫，零逐行子串）。
    public static SipMessage Parse(string data) {
        if (data == null || data.Length == 0) { return null; }
        int dlen = data.Length;
        nint dp = (nint)data;
        Span<byte> db = new Span<byte>(dp, dlen);
        int lineEnd = SipMessage.FindCrlfPtr(dp, db, dlen, 0);
        if (lineEnd < 0) { return null; }

        SipMessage m = new SipMessage();
        if (SipMessage.StartsWithSip20(db, 0, lineEnd, true)) {
            m.isRequest = false;
            // "SIP/2.0 200 OK"
            int sp = NativeMemory.Find(dp, 8, 32, lineEnd - 8);
            int codeEnd = sp < 0 ? lineEnd : sp;
            int code = SipMessage.ParsePositiveIntSlice(db, 8, codeEnd);
            if (code <= 0) { return null; }
            m.status = code;
            if (sp >= 0 && sp + 1 < lineEnd) {
                m.reason = NativeMemory.GetString(dp, sp + 1, lineEnd - sp - 1);
            }
        } else {
            int sp1 = NativeMemory.Find(dp, 0, 32, lineEnd);
            if (sp1 < 0) { return null; }
            int sp2 = NativeMemory.Find(dp, sp1 + 1, 32, lineEnd - sp1 - 1);
            if (sp2 < 0) { return null; }
            if (!SipMessage.StartsWithSip20(db, sp2 + 1, lineEnd, false)) {
                return null;
            }
            m.isRequest = true;
            m.method = NativeMemory.GetString(dp, 0, sp1);
            m.uri = NativeMemory.GetString(dp, sp1 + 1, sp2 - sp1 - 1);
        }

        int pos = lineEnd + 2;
        int cl = -1;
        bool haveCl = false;
        List<SipHeader> hdrs = m.headers;
        while (pos < dlen) {
            int e = SipMessage.FindCrlfPtr(dp, db, dlen, pos);
            if (e < 0) { break; }
            if (e == pos) {  // 空行：正文紧随其后
                int bodyStart = pos + 2;
                int remaining = dlen - bodyStart;
                if (remaining > 0) {
                    if (haveCl && cl >= 0) {
                        int bodyLen = cl < remaining ? cl : remaining;
                        m.body = bodyLen > 0 ? NativeMemory.GetString(dp, bodyStart, bodyLen) : "";
                    } else {
                        m.body = NativeMemory.GetString(dp, bodyStart, remaining);
                    }
                }
                break;
            }
            int colon = NativeMemory.Find(dp, pos, 58, e - pos);
            if (colon > pos) {
                int ns = pos;
                int ne = colon;
                while (ns < ne && SipMessage.IsTrimWs(db[ns] & 255)) { ns = ns + 1; }
                while (ne > ns && SipMessage.IsTrimWs(db[ne - 1] & 255)) { ne = ne - 1; }
                int vs = colon + 1;
                int ve = e;
                while (vs < ve && SipMessage.IsTrimWs(db[vs] & 255)) { vs = vs + 1; }
                while (ve > vs && SipMessage.IsTrimWs(db[ve - 1] & 255)) { ve = ve - 1; }
                string name = ns < ne ? NativeMemory.GetString(dp, ns, ne - ns) : "";
                string val = vs < ve ? NativeMemory.GetString(dp, vs, ve - vs) : "";
                hdrs.Add(new SipHeader(name, val));
                if (!haveCl && SipMessage.IsContentLengthSlice(db, ns, ne - ns)) {
                    haveCl = true;
                    cl = SipMessage.ParsePositiveIntSlice(db, vs, ve);
                }
            }
            pos = e + 2;
        }
        return m;
    }

    // 从 from 起第一个字节 c 的下标，不存在时返回 -1（memchr 加速）。
    private static int FindChar(string s, int c, int from) {
        if (s == null || from >= s.Length) { return -1; }
        if (from < 0) { from = 0; }
        return NativeMemory.Find((nint)s, from, c, s.Length - from);
    }

    // 从 from 起第一个 CRLF 的下标，不存在时返回 -1（memchr 查找 CR）。
    private static int FindCrlfPtr(nint dp, Span<byte> db, int len, int from) {
        int i = from;
        while (i + 1 < len) {
            int cr = NativeMemory.Find(dp, i, 13, len - 1 - i);
            if (cr < 0) { return -1; }
            if ((db[cr + 1] & 255) == 10) { return cr; }
            i = cr + 1;
        }
        return -1;
    }

    private static int FindCrlf(string s, int from) {
        if (s == null || from + 1 >= s.Length) { return -1; }
        int len = s.Length;
        nint sp = (nint)s;
        return SipMessage.FindCrlfPtr(sp, new Span<byte>(sp, len), len, from);
    }
}
