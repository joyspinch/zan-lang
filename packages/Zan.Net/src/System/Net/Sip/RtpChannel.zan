using System;
using System.Net.Sockets;

namespace System.Net.Sip;

public class RtpChannel {
    public UdpClient udp;
    public string remoteHost;
    public int remotePort;
    public int localPort;
    public int nextSeq;
    public long nextTimestamp;
    public long ssrc;

    public RtpChannel(int localPort, string remoteHost, int remotePort) {
        this.localPort = localPort;
        this.remoteHost = remoteHost;
        this.remotePort = remotePort;
        this.nextSeq = 1;
        this.nextTimestamp = 0;
        this.ssrc = Stopwatch.GetMilliseconds() & 16777215;
        if (localPort > 0) {
            this.udp = UdpClient.Bind("0.0.0.0", localPort);
        }
        if (this.udp == null) {
            this.udp = new UdpClient();
        }
    }

    public int GetLocalPort() { return this.localPort; }
    public string GetRemoteHost() { return this.remoteHost; }
    public int GetRemotePort() { return this.remotePort; }

    // 发送封装好的 RTP 包。
    public async int SendRtpAsync(RtpPacket packet) {
        byte[] data = packet.Encode();
        return await this.udp.SendBytesToAsync(data, data.Length, this.remoteHost, this.remotePort);
    }

    // 自动按递增序号与时间戳发送一段音频载荷（如 20ms G.711，增量 160 采样点）。
    public async int SendAudioFrameAsync(byte[] pcmData, int payloadType, int sampleIncrement) {
        RtpPacket pkt = RtpPacket.Create(payloadType, this.nextSeq, this.nextTimestamp, this.ssrc, pcmData);
        this.nextSeq = (this.nextSeq + 1) & 65535;
        this.nextTimestamp = (this.nextTimestamp + sampleIncrement) & 4294967295;
        return await SendRtpAsync(pkt);
    }

    // 接收远端发来的 RTP 音频包。
    public RtpPacket RecvRtp(int maxBytes) {
        byte[] buf = new byte[maxBytes];
        int n = this.udp.RecvBytesFrom(buf, maxBytes);
        if (n >= 12) {
            return RtpPacket.Decode(buf, 0, n);
        }
        return null;
    }

    // 关闭通道与底层套接字。
    public void Close() {
        if (this.udp != null) {
            this.udp.Close();
        }
    }
}
