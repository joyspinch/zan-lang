using System;

namespace System.Net.Sip;

class SipCallState {
    static const int Idle = 0;        // 空闲
    static const int Calling = 1;     // 呼叫中（INVITE 已发出）
    static const int Ringing = 2;     // 对方振铃中（180 Ringing）
    static const int Connected = 3;   // 通话已接通（200 OK + ACK 握手完成）
    static const int Terminating = 4; // 正在挂断（BYE / CANCEL 发出）
    static const int Terminated = 5;  // 通话已结束 / 挂断
}

// SIP 呼叫会话（Call Dialog）实体，表示一个完整的双向语音通话。
