using System;
using System.Net.Sockets;
using System.Threading;

namespace System.Net.Ntp;

// SNTP 客户端（RFC 4330）——通过 UDP 123 端口获取墙上时钟时间，
// 这是没有电池供电 RTC 的设备获知日期的常见方式。
// 用法：
public class NtpClient {
    // NTP 纪元（1900）与 Unix 纪元（1970）之间的秒数。
    public static const long EPOCH_DELTA = 2208988800;

    // 解析 SNTP 服务器应答数据报（RFC 4330），返回 Unix 秒（UTC），
    // 校验 Mode（4 或 5）、Leap Indicator（!= 3 告警未同步）、Stratum（> 0 非 KoD）及时间戳有效性。
    // 失败或不满足 RFC 4330 规范时返回 -1。
    public static long ParseResponse(byte[] d, int n) {
        if (d == null || n < 48) { return -1; }
        int li = (d[0] >> 6) & 3;
        if (li == 3) { return -1; } // 3 = alarm condition (clock not synchronized)
        int mode = d[0] & 7;
        if (mode != 4 && mode != 5) { return -1; } // 4 = server, 5 = broadcast
        int stratum = d[1] & 255;
        if (stratum == 0) { return -1; } // 0 = Kiss-o'-Death (KoD) packet / unsynchronized
        long secs = 0;
        int i = 40;
        while (i < 44) {
            secs = (secs << 8) + (d[i] & 255);
            i = i + 1;
        }
        if (secs < NtpClient.EPOCH_DELTA) { return -1; }
        return secs - NtpClient.EPOCH_DELTA;
    }

    // 发送一次 SNTP 请求并返回 Unix 秒（UTC），
    // 超时或应答格式错误时返回 -1。<paramref name="timeoutMs"/> 限定
    // 等待应答数据报的时间。
    public static async long QueryAsync(string host, int port, int timeoutMs) {
        UdpClient udp = new UdpClient();
        byte[] pkt = new byte[48];
        pkt[0] = (byte)((0 << 6) + (4 << 3) + 3);  // LI=0，VN=4，mode=3（客户端）
        int _s = await udp.SendBytesToAsync(pkt, 48, host, port);

        byte[] d = new byte[64];
        int n = await udp.RecvBytesFromAsync(d, 64, timeoutMs);
        udp.Close();
        return NtpClient.ParseResponse(d, n);
    }

    // 发送 SNTP 请求并返回 Unix 秒（UTC），默认端口 123 与指定超时。
    public static async long QueryAsync(string host, int port) {
        return await NtpClient.QueryAsync(host, port, 3000);
    }

    // 发送 SNTP 请求并返回 Unix 秒（UTC），默认端口 123 与 3000ms 超时。
    public static async long QueryAsync(string host) {
        return await NtpClient.QueryAsync(host, 123, 3000);
    }

    // 发送 SNTP 请求并返回类型化 DateTime 结构（UTC），失败时返回 null。
    public static async DateTime QueryDateTimeAsync(string host, int port, int timeoutMs) {
        long secs = await NtpClient.QueryAsync(host, port, timeoutMs);
        if (secs < 0) { return null; }
        return new DateTime(secs);
    }

    // 发送 SNTP 请求并返回类型化 DateTime 结构（UTC），默认端口 123 与 3000ms 超时。
    public static async DateTime QueryDateTimeAsync(string host) {
        return await NtpClient.QueryDateTimeAsync(host, 123, 3000);
    }
}
