using System;

namespace System.Net;

class WsLink {
    Connection conn;
    WsWriter writer;
    TcpClient client;
    bool busy;
    List<AsyncGate> waiters;

    async bool LockAsync() {
        while (this.busy) {
            AsyncGate g = new AsyncGate();
            if (this.waiters == null) { this.waiters = new List<AsyncGate>(); }
            this.waiters.Add(g);
            await g.Wait();
            g.Close();
        }
        this.busy = true;
        return true;
    }

    void Unlock() {
        this.busy = false;
        if (this.waiters != null && this.waiters.Count > 0) {
            AsyncGate g = this.waiters[0];
            this.waiters.RemoveAt(0);
            g.Signal();
        }
    }
}
