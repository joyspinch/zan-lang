using System;
using System.Collections.Generic;
using System.Net.Sockets;
using System.Net.WebSocket;
using System.Threading;

namespace System.Net;

public class WsLink {
    public Connection conn;
    public WsWriter writer;
    public TcpClient client;
    public bool busy;
    public Queue<AsyncGate> waiters;

    public async bool LockAsync() {
        AsyncGate g = null;
        lock (this) {
            if (!this.busy) {
                this.busy = true;
                return true;
            }
            g = new AsyncGate();
            if (this.waiters == null) { this.waiters = new Queue<AsyncGate>(); }
            this.waiters.Enqueue(g);
        }
        await g.Wait();
        g.Close();
        return true;
    }

    public void Unlock() {
        lock (this) {
            if (this.waiters != null && this.waiters.Count() > 0) {
                AsyncGate g = this.waiters.Dequeue();
                g.Signal();
            } else {
                this.busy = false;
            }
        }
    }
}
