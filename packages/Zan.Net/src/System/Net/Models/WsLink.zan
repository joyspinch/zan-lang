using System;

namespace System.Net;

public class WsLink {
    public Connection conn;
    public WsWriter writer;
    public TcpClient client;
    public bool busy;
    public List<AsyncGate> waiters;

    public async bool LockAsync() {
        if (!this.busy) {
            this.busy = true;
            return true;
        }
        AsyncGate g = new AsyncGate();
        if (this.waiters == null) { this.waiters = new List<AsyncGate>(); }
        this.waiters.Add(g);
        await g.Wait();
        g.Close();
        return true;
    }

    public void Unlock() {
        if (this.waiters != null && this.waiters.Count > 0) {
            AsyncGate g = this.waiters[0];
            this.waiters.RemoveAt(0);
            g.Signal();
        } else {
            this.busy = false;
        }
    }
}
