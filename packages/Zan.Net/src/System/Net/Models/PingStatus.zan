using System;

namespace System.Net;

public enum PingStatus {
    // 收到应答。
    Success,
    // 超时内未收到应答。
    TimedOut,
    // 目标不可达（网络或主机）。
    DestinationUnreachable,
    // 报文过大无法传送。
    PacketTooBig,
    // 请求参数被拒（Windows IP_STATUS 11006-11008/11015）。
    BadRequest,
    // 其他错误（句柄/内存/API 失败等）。
    Error
}

// 一条 ICMP echo 结果。
