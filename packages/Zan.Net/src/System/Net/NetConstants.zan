using System;

namespace System.Net;

// NetConstants.zan - 网络协议栈全局标准常量定义（消除代码中的裸数字与魔数）
public static class NetConstants {
    // ---- 协议默认端口 ----
    public static const int PortHttp = 80;
    public static const int PortHttps = 443;
    public static const int PortMqtt = 1883;
    public static const int PortMqtts = 8883;
    public static const int PortSip = 5060;
    public static const int PortSips = 5061;
    public static const int PortCoap = 5683;
    public static const int PortCoaps = 5684;
    public static const int PortModbus = 502;
    public static const int PortPop3 = 110;
    public static const int PortPop3s = 995;
    public static const int PortSmtp = 25;
    public static const int PortSmtpSubmission = 587;
    public static const int PortSmtps = 465;
    public static const int PortDns = 53;
    public static const int PortDnsTls = 853;
    public static const int PortWebSocket = 80;
    public static const int PortWebSocketSecure = 443;

    // ---- 标准缓冲区阶梯（字节） ----
    public static const int BufferTiny = 256;
    public static const int BufferSmall = 1024;
    public static const int BufferNormal = 4096;
    public static const int BufferLarge = 8192;
    public static const int BufferJumbo = 65536;

    // ---- 帧与报文默认安全上限（字节） ----
    public static const int DefaultMaxHeaderBytes = 16384;
    public static const int DefaultMaxRequestBytes = 1048576; // 1 MiB
    public static const int DefaultMaxResponseBytes = 16777216; // 16 MiB
    public static const int DefaultMaxStreamBytes = 33554432; // 32 MiB
    public static const int DefaultMaxErrorBytes = 65536; // 64 KiB
    public static const int MaxRequestBytesCeiling = 1073741824; // 1 GiB

    // ---- 标准超时（毫秒） ----
    public static const int TimeoutConnectMs = 10000;
    public static const int TimeoutLongConnectMs = 120000;
    public static const int TimeoutReadMs = 30000;
    public static const int TimeoutWriteMs = 10000;
    public static const int TimeoutRequestMs = 30000;
    public static const int TimeoutIdleMs = 30000;
    public static const int TimeoutTotalBudgetMs = 60000;
    public static const int TimeoutHardRejectMs = 3000;
    public static const int TimeoutDnsLookupMs = 3000;
    public static const int TimeoutCoapAckMs = 2000;
    public static const int DefaultRetryBackoffMs = 250;

    // ---- 连接并发阶梯 ----
    public static const int DefaultBacklog = 128;
    public static const int DefaultMaxConnections = 10000;
    public static const int DefaultMaxConnectionsPerIp = 0; // 0 表示不设单 IP 限制
}
