using System;
using System.Collections.Generic;
using System.Diagnostics;
using System.Text;
using System.Threading;

namespace System.Net;

// Worker.Stats.zan - 状态屏打印 (Banner)、共享内存性能指标采集与 Status 报表生成
public partial class Worker {
    static long statOsHandle = 0;
    static SharedTable statTable = null;

    // 前台主进程服务状态监控与吞吐指标打印周期（秒）。
    static int statusInterval = 10;
    static List<long> stPrevReq = new List<long>();
    static List<long> stPrevCpuMs = new List<long>();

    public static void SetStatusInterval(int seconds) {
        statusInterval = seconds;
    }

    // 状态屏文本按宽度左对齐补空格（委托 ServerBanner.Pad）。
    private static string Pad(string s, int width) {
        return ServerBanner.Pad(s, width);
    }

    // 状态屏分隔线（委托 ServerBanner.Rule）。
    private static string Rule(string title) {
        return ServerBanner.Rule(title);
    }

    private static void PrintBanner(int procs) {
        string mode = "single process";
        if (procs > 1 || cliMode) {
            mode = "master + " + Convert.ToString(procs) + " worker";
            if (procs != 1) { mode = mode + "s"; }
        }
        ServerBanner b = new ServerBanner("ZAN", "WORKERS").Mode(mode);
        for (int i = 0; i < workers.Count; i = i + 1) {
            Worker w = workers[i];
            int c = w.count;
            if (c < 1) { c = 1; }
            b.Service(w.name,
                w.protocol + "://" + w.host + ":" + Convert.ToString(w.port),
                Convert.ToString(c), "[OK]");
        }
        if (cliMode) { b.Commands(Worker.Usage()); }
        b.Footer("Press Ctrl+C to stop. Start success.");
        b.Print();
    }

    // 统计表行键：wid>0 为 "w<id>"，否则 "self"。
    private static string StatsKey(int wid) {
        if (wid <= 0) { return "self"; }
        return "w" + Convert.ToString(wid);
    }

    // 构造跨进程统计共享表的列布局（pid/recv/sent/conns/cpu/rss）。
    private static SharedTable StatsTable(int procs) {
        SharedTable t = new SharedTable("", procs + 8);
        t.Label("worker stats");
        t.KeySize(16);
        t.ColumnInt("pid");
        t.ColumnInt("recv");
        t.ColumnInt("sent");
        t.ColumnInt("conns");
        t.ColumnInt("cpu");
        t.ColumnInt("rss");
        return t;
    }

    private static void StatsSeed(SharedTable t, int procs) {
        for (int wid = 0; wid <= procs; wid = wid + 1) {
            t.SetInt(StatsKey(wid), "pid", 0);
            t.SetInt(StatsKey(wid), "recv", 0);
            t.SetInt(StatsKey(wid), "sent", 0);
            t.SetInt(StatsKey(wid), "conns", 0);
            t.SetInt(StatsKey(wid), "cpu", 0);
            t.SetInt(StatsKey(wid), "rss", 0);
        }
    }

    private static void StatsCreate(int procs) {
        SharedTable t = StatsTable(procs);
        if (!t.CreateAnonymous()) {
            Console.WriteLine("[Worker] cannot create the shared stats table;"
                + " per-process counters will read as zero");
            return;
        }
        StatsSeed(t, procs);
        statTable = t;
        statOsHandle = t.OsHandle();
    }

    private static void StatsDestroy() {
        SharedTable t = statTable;
        statOsHandle = 0;
        if (t == null) { return; }
        statTable = null;
        if (t.IsOpen()) { bool _d = t.Destroy(); }
    }

    private static void StatsAttach() {
        string env = ProcessHost.Env("ZAN_STATS_HANDLE");
        if (env == "") { return; }
        SharedTable t = SharedTable.Attach(Convert.ToInt64(env));
        if (t.IsOpen()) {
            t.Label("worker stats");
            statTable = t;
        }
    }

    static List<string> shareNames = new List<string>();
    static List<long> shareHandles = new List<long>();

    // 共享表句柄经环境变量传递时的变量名（ZAN_SHARE_<name>）。
    public static string ShareEnv(string name) { return "ZAN_SHARE_" + name; }

    public static void ShareHandle(string name, long osHandle) {
        if (name == "" || osHandle == 0) { return; }
        for (int i = 0; i < shareNames.Count; i = i + 1) {
            if (shareNames[i] == name) {
                shareHandles[i] = osHandle;
                return;
            }
        }
        shareNames.Add(name);
        shareHandles.Add(osHandle);
    }

    public static long InheritedHandle(string name) {
        string env = ProcessHost.Env(ShareEnv(name));
        if (env == "") { return 0; }
        return Convert.ToInt64(env);
    }

    private static void StatsPublish() {
        SharedTable t = statTable;
        if (t == null) { return; }
        if (!t.IsOpen()) { return; }
        string key = StatsKey(ProcessHost.WorkerId());
        t.SetInt(key, "pid", ProcessHost.Pid());
        t.SetInt(key, "recv", statRequests.Load());
        t.SetInt(key, "sent", statSent.Load());
        t.SetInt(key, "conns", LiveConnections());
        t.SetInt(key, "cpu", ServerMetrics.CpuMillis());
        t.SetInt(key, "rss", ServerMetrics.MemoryRssBytes());
    }

    // 后台循环：每 2 秒把本进程计数器发布进统计表。
    static async void StatsPublishLoop() {
        while (true) {
            await Task.Delay(2000);
            StatsPublish();
        }
    }

    // 读取指定 worker 行的统计列；统计表不可用时返回 0。
    private static long StatsRead(int wid, string column) {
        SharedTable t = statTable;
        if (t == null) { return 0; }
        if (!t.IsOpen()) { return 0; }
        return t.GetInt(StatsKey(wid), column);
    }

    private static string Usage() {
        return "<app> [start [-d] | stop | restart [-d] | reload | status]"
            + " [--ctl-port N]";
    }

    private static string StatusText() {
        StringBuilder sb = new StringBuilder();
        sb.Append(Rule("ZAN STATUS"));
        sb.Append("\n");
        sb.Append(Pad("master pid: " + Convert.ToString(ProcessHost.Pid()), 30));
        sb.Append("control port: " + Convert.ToString(ControlPort()));
        sb.Append("\n");
        sb.Append(Pad("service", 22) + Pad("listen", 32)
            + Pad("processes", 12) + "status\n");
        for (int i = 0; i < workers.Count; i = i + 1) {
            Worker w = workers[i];
            int wc = w.count;
            if (wc < 1) { wc = 1; }
            sb.Append(Pad(w.name, 22)
                + Pad(w.protocol + "://" + w.host + ":" + Convert.ToString(w.port), 32)
                + Pad(Convert.ToString(wc), 12) + "[OK]\n");
        }
        sb.Append(Rule(""));
        sb.Append("\n");
        sb.Append(Pad("worker", 8) + Pad("pid", 9) + Pad("received", 12)
            + Pad("sent", 12) + Pad("clients", 10) + Pad("cpu ms", 10)
            + "memory\n");
        int procs = MaxCount();
        if (procs <= 1 && !cliMode) {
            StatsPublish();
            sb.Append(StatusRow("self", 0));
            sb.Append(SharedTablesText());
            return sb.ToString();
        }
        StatsPublish();
        sb.Append(StatusRow("master", 0));
        long totRecv = 0;
        long totSent = 0;
        long totConns = 0;
        int wid = 1;
        while (wid <= procs) {
            if (StatsRead(wid, "pid") != 0) {
                totRecv = totRecv + StatsRead(wid, "recv");
                totSent = totSent + StatsRead(wid, "sent");
                totConns = totConns + StatsRead(wid, "conns");
                sb.Append(StatusRow("w" + Convert.ToString(wid), wid));
            }
            wid = wid + 1;
        }
        sb.Append("total   received: " + Convert.ToString(totRecv)
            + "   sent: " + Convert.ToString(totSent)
            + "   clients: " + Convert.ToString(totConns) + "\n");
        sb.Append(SharedTablesText());
        return sb.ToString();
    }

    private static string SharedTablesText() {
        StringBuilder sb = new StringBuilder();
        sb.Append(Rule("SHARED TABLES"));
        sb.Append("\n");
        sb.Append(SharedTable.StatusText());
        return sb.ToString();
    }

    // 启动屏打印本进程共享内存表占用情况。
    private static void PrintSharedTables() {
        Console.Write(SharedTablesText());
    }

    private static string StatusRow(string label, int wid) {
        return Pad(label, 8)
            + Pad(Convert.ToString(StatsRead(wid, "pid")), 9)
            + Pad(Convert.ToString(StatsRead(wid, "recv")), 12)
            + Pad(Convert.ToString(StatsRead(wid, "sent")), 12)
            + Pad(Convert.ToString(StatsRead(wid, "conns")), 10)
            + Pad(Convert.ToString(StatsRead(wid, "cpu")), 10)
            + Convert.ToString(StatsRead(wid, "rss") / 1048576) + "MB\n";
    }

    static async void MasterStatusLoop() {
        long prevWall = ServerMetrics.MonoMillis();
        while (true) {
            await Task.Delay(statusInterval * 1000);
            long now = ServerMetrics.MonoMillis();
            long dWall = now - prevWall;
            prevWall = now;
            if (dWall <= 0) { continue; }
            StringBuilder sb = new StringBuilder();
            sb.Append("[status]");
            sb.Append(" master pid=" + Convert.ToString(ProcessHost.Pid())
                + " mem=" + Convert.ToString(StatsRead(0, "rss") / 1048576)
                + "MB");
            long totQps = 0;
            int procs = MaxCount();
            while (stPrevReq.Count <= procs) {
                stPrevReq.Add(0);
                stPrevCpuMs.Add(0);
            }
            int wid = 1;
            while (wid <= procs) {
                long pid = StatsRead(wid, "pid");
                if (pid == 0) { wid = wid + 1; continue; }
                long recv = StatsRead(wid, "recv");
                long cpu = StatsRead(wid, "cpu");
                long dReq = recv - stPrevReq[wid];
                long dCpu = cpu - stPrevCpuMs[wid];
                stPrevReq[wid] = recv;
                stPrevCpuMs[wid] = cpu;
                long qps = (dReq * 1000) / dWall;
                totQps = totQps + qps;
                long cpuPct = -1;
                if (cpu >= 0 && dCpu >= 0) { cpuPct = (dCpu * 100) / dWall; }
                sb.Append(" | w" + Convert.ToString(wid)
                    + " pid=" + Convert.ToString(pid)
                    + " reqs=" + Convert.ToString(recv)
                    + " qps=" + Convert.ToString(qps)
                    + " sent=" + Convert.ToString(StatsRead(wid, "sent"))
                    + " conns=" + Convert.ToString(StatsRead(wid, "conns"))
                    + " cpu=" + Convert.ToString(cpuPct) + "%"
                    + " mem=" + Convert.ToString(StatsRead(wid, "rss") / 1048576) + "MB");
                wid = wid + 1;
            }
            sb.Append(" | total qps=" + Convert.ToString(totQps));
            Console.WriteLine(sb.ToString());
        }
    }

    static async void SelfStatusLoop() {
        long prevWall = ServerMetrics.MonoMillis();
        long prevReq = 0;
        long prevCpu = 0;
        while (true) {
            await Task.Delay(statusInterval * 1000);
            long now = ServerMetrics.MonoMillis();
            long dWall = now - prevWall;
            prevWall = now;
            if (dWall <= 0) { continue; }
            long cpu = ServerMetrics.CpuMillis();
            long rss = ServerMetrics.MemoryRssBytes();
            long nowReq = statRequests.Load();
            long qps = ((nowReq - prevReq) * 1000) / dWall;
            long cpuPct = -1;
            if (cpu >= 0) { cpuPct = ((cpu - prevCpu) * 100) / dWall; }
            prevReq = nowReq;
            prevCpu = cpu;
            Console.WriteLine("[status] pid=" + Convert.ToString(ProcessHost.Pid())
                + " reqs=" + Convert.ToString(nowReq)
                + " qps=" + Convert.ToString(qps)
                + " sent=" + Convert.ToString(statSent.Load())
                + " conns=" + Convert.ToString(LiveConnections())
                + " cpu=" + Convert.ToString(cpuPct) + "%"
                + " mem=" + Convert.ToString(rss / 1048576) + "MB");
        }
    }
}
