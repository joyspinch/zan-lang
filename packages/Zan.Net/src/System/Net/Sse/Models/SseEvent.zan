using System;

namespace System.Net.Sse;

class SseEvent {
    string name;
    string data;
    string id;

    // 私有构造：空事件，由 ParseBlock 填充。
    SseEvent() {
        this.name = "";
        this.data = "";
        this.id = "";
    }

    // 事件名（流未设置时默认为 "message"）。
    string Name() {
        if (this.name.Length == 0) { return "message"; }
        return this.name;
    }

    // 负载文本（多行 data 以 '\n' 连接）。
    string Data() { return this.data; }
    // last-event id（流未提供时为空串）。
    string Id() { return this.id; }
}

// 服务器端一条已接受的 SSE 订阅者连接。Worker.HandleSse
// 完成 HTTP 握手后传给 onSseSubscriber；用
// SendAsync/SendDataAsync 推送事件，最后以 Close 收尾。
