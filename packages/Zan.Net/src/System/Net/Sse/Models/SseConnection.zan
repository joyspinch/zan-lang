using System;

namespace System.Net.Sse;

class SseConnection {
    TcpClient client;
    string path;
    bool open;

    // 私有工厂：Worker 完成 SSE 握手后构造。
    static SseConnection Of(TcpClient client, string path) {
        SseConnection c = new SseConnection();
        c.client = client;
        c.path = path;
        c.open = true;
        return c;
    }

    // 订阅者请求的路径（如 "/events"）。
    string Path() { return this.path; }

    // 连接是否仍可写（发送失败或 Close 后为 false）。
    bool IsOpen() { return this.open; }

    // 发送具名事件。data 中的每个 '\n' 都会变成独立的
    // `data:` 行，保证多行负载在线上格式中不被破坏。
    // 返回值 <= 0 表示订阅者已断开。
    async int SendAsync(string eventName, string data) {
        StringBuilder sb = new StringBuilder();
        if (eventName.Length > 0) {
            sb.Append("event: ");
            sb.Append(eventName);
            sb.Append("\n");
        }
        int start = 0;
        for (int i = 0; i <= data.Length; i = i + 1) {
            if (i == data.Length || (data[i] & 255) == 10) {
                sb.Append("data: ");
                sb.Append(data.Substring(start, i - start));
                sb.Append("\n");
                start = i + 1;
            }
        }
        sb.Append("\n");
        string frame = sb.ToString();
        int total = frame.Length;
        int n = await this.client.SendBytesAsync(frame, total);
        if (n <= 0) { this.open = false; return n; }
        return total;
    }

    // 发送具名事件，载荷为原生字节数组。
    async int SendBytesAsync(string eventName, byte[] data, int dataOffset, int dataLen) {
        StringBuilder sb = new StringBuilder();
        if (eventName.Length > 0) {
            sb.Append("event: ");
            sb.Append(eventName);
            sb.Append("\n");
        }
        sb.Append("data: ");
        int total = sb.Length + dataLen + 2;
        byte[] frame = new byte[total + 1];
        int off = 0;
        string header = sb.ToString();
        NativeMemory.PutString((nint)frame, off, header, header.Length);
        off = off + header.Length;
        if (dataLen > 0 && data != null) {
            NativeMemory.Copy((nint)frame + (nint)off, (nint)data + (nint)dataOffset, dataLen);
            off = off + dataLen;
        }
        frame[off] = 10;
        frame[off + 1] = 10;
        int n = await this.client.SendBytesAsync(frame, total);
        if (n <= 0) { this.open = false; return n; }
        return total;
    }

    // 发送匿名（"message"）事件。
    async int SendDataAsync(string data) {
        int n = await SendAsync("", data);
        return n;
    }

    // 发送一条 SSE 注释行，可用作 keep-alive 心跳。
    async int PingAsync() {
        int n = await this.client.SendAsync(": ping\n\n");
        return n;
    }

    // 关闭底层连接并标记断开。
    void Close() {
        this.open = false;
        this.client.Close();
    }
}

// Server-Sent Events 客户端：建立连接、完成 HTTP 握手，然后
// 逐个产出解析好的事件。
