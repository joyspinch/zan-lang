using System;

namespace System.Net.Sse;

public class SseText {
    // `needle` 在 `s` 中从 `from` 起（含）首次出现的位置，找不到返回 -1。
    // 混合策略：短尾（<256 字节）朴素扫——原生调用开销大于 SIMD 收益
    // （52 字节事件块实测纯 memchr 路径反而慢 9%）；长尾走
    // NativeMemory.Find（原生 memchr，SIMD）跳到首字符命中 +
    // SequenceEqual 确认余下 m-1 字节，4 KiB 无命中最坏情况实测 4.5x。
    public static int Find(string s, string needle, int from) {
        if (s == null || needle == null) { return -1; }
        int n = s.Length;
        int m = needle.Length;
        if (m == 0) { return from; }
        if (from < 0) { from = 0; }
        if (m > n) { return -1; }
        if (n - from < 256) {
            int i = from;
            while (i + m <= n) {
                int j = 0;
                for (; j < m && (s[i + j] & 255) == (needle[j] & 255); j = j + 1) { }
                if (j == m) { return i; }
                i = i + 1;
            }
            return -1;
        }
        StringView sv = StringView.FromString(s);
        StringView nv = StringView.FromString(needle);
        int c0 = nv.ByteAt(0);
        int last = n - m;
        int p = from;
        while (p <= last) {
            int hit = NativeMemory.Find(sv.ptr, p, c0, n - p);
            if (hit < 0 || hit > last) { return -1; }
            if (NativeMemory.SequenceEqual(sv.ptr + (nint)hit, nv.ptr, m)) { return hit; }
            p = hit + 1;
        }
        return -1;
    }
}
