using System;
using System.Collections.Generic;
using System.Net.Sockets;
using System.Net.Http;
using System.Net.WebSocket;
using System.Text;
using System.Threading;

namespace System.Net;

// WebSocket 协议分片：握手/帧循环/连接注册表/Push 的实现，
// 从 Worker.zan 外迁为独立类。Worker 核心只经静态槽分发（Worker.wsEntry），
// 应用调用一次 WorkerWs.Install() 本文件才进编译图——纯 HTTP 服务不背
// ws 编解码（约 870 行），正如不背 SSE/MQTT。槽反转与独立类（不写
// partial Worker）的理由见 Worker.ProtoEntryFn 的文档。
public class WorkerWs {
    [DllImport("crt")]
    private static extern long strlen(string str);

    public static void Install() {
        Worker.wsEntry = WorkerWs.HandleWebSocket;
        WorkerWs.EnableSharedBus("zan_ws_worker_bus");
    }

    // ---- 面向对象 WebSocketHub 服务委托 ----
    public static WebSocketHub defaultHub = new WebSocketHub();
    public static WebSocketHub Hub { get { return WorkerWs.defaultHub; } }

    public static WsSharedBus sharedBus {
        get { return WorkerWs.defaultHub.sharedBus; }
        set { WorkerWs.defaultHub.sharedBus = value; }
    }
    public static WorkerWsConsumer busConsumer {
        get { return WorkerWs.defaultHub.busConsumer; }
        set { WorkerWs.defaultHub.busConsumer = value; }
    }
    public static Dict<string, List<Connection>> channels {
        get { return WorkerWs.defaultHub.channels; }
    }
    public static nint chanLock {
        get { return WorkerWs.defaultHub.chanLock; }
        set { WorkerWs.defaultHub.chanLock = value; }
    }
    public static Dict<int, WsLink> conns {
        get { return WorkerWs.defaultHub.conns; }
    }
    public static nint regLock {
        get { return WorkerWs.defaultHub.regLock; }
        set { WorkerWs.defaultHub.regLock = value; }
    }

    public static void ChanInit() { WorkerWs.defaultHub.ChanInit(); }
    public static void RegInit() { WorkerWs.defaultHub.RegInit(); }

    public static void EnableSharedBus(string busName) {
        WorkerWs.defaultHub.EnableSharedBus(busName);
    }

    public static void DisableSharedBus() {
        WorkerWs.defaultHub.DisableSharedBus();
    }

    public static void Uninstall() {
        Worker.wsEntry = null;
        WorkerWs.defaultHub.Clear();
    }

    public static void Join(string channel, Connection conn) {
        WorkerWs.defaultHub.Join(channel, conn);
    }

    public static void Leave(string channel, Connection conn) {
        WorkerWs.defaultHub.Leave(channel, conn);
    }

    public static void LeaveAllChannels(Connection conn) {
        WorkerWs.defaultHub.LeaveAllChannels(conn);
    }

    public static void Attach(Connection conn, WsWriter writer, TcpClient client) {
        WorkerWs.defaultHub.Attach(conn, writer, client);
    }

    public static void ConnRemove(Connection conn) {
        WorkerWs.defaultHub.ConnRemove(conn);
    }

    public static WsLink LinkOf(int id) {
        return WorkerWs.defaultHub.LinkOf(id);
    }

    public static int ConnCount() {
        return WorkerWs.defaultHub.ConnCount();
    }

    public static int ClusterConnCount() {
        return WorkerWs.defaultHub.ClusterConnCount();
    }

    // 按连接 id 取在线连接；不存在（已断开）返回 null。
    // 用于定时器等无引用上下文里找回连接后 WorkerWs.Push(conn, ...)。
    public static Connection ConnById(int id) {
        WsLink link = WorkerWs.LinkOf(id);
        if (link == null) { return null; }
        return link.conn;
    }

    // 向本进程内所有在线 WebSocket 连接广播一条 Text 帧，返回成功投递数。
    public static async int BroadcastLocal(string data) {
        WorkerWs.RegInit();
        Mutex.Lock(WorkerWs.regLock);
        List<WsLink> snap = WorkerWs.conns.Values;
        Mutex.Unlock(WorkerWs.regLock);
        int sent = 0;
        int j = 0;
        while (j < snap.Count) {
            bool ok = await WorkerWs.Push(snap[j].conn, data);
            if (ok) { sent = sent + 1; }
            j = j + 1;
        }
        return sent;
    }

    // 向所有 Worker 进程的所有在线 WebSocket 连接全局广播一条 Text 帧。
    // 本进程连接立即本地推送，其他 Worker 进程经 SharedTable 环形总线接收后推送。
    public static async int Broadcast(string data) {
        int sent = await WorkerWs.BroadcastLocal(data);
        if (WorkerWs.sharedBus != null && WorkerWs.sharedBus.IsAvailable()) {
            WorkerWs.sharedBus.PublishBroadcast(data, data.Length);
        }
        return sent;
    }

    // 向本进程内加入指定频道/房间的所有连接广播一条 Text 帧。
    public static async int BroadcastToLocal(string channel, string data) {
        WorkerWs.ChanInit();
        Mutex.Lock(WorkerWs.chanLock);
        List<Connection> snap = new List<Connection>();
        if (WorkerWs.channels.ContainsKey(channel)) {
            List<Connection> list = WorkerWs.channels[channel];
            for (int i = 0; i < list.Count; i = i + 1) {
                snap.Add(list[i]);
            }
        }
        Mutex.Unlock(WorkerWs.chanLock);
        int sent = 0;
        int j = 0;
        while (j < snap.Count) {
            bool ok = await WorkerWs.Push(snap[j], data);
            if (ok) { sent = sent + 1; }
            j = j + 1;
        }
        return sent;
    }

    // 跨 Worker 向加入指定频道/房间的所有在线连接广播 Text 帧。
    public static async int BroadcastTo(string channel, string data) {
        int sent = await WorkerWs.BroadcastToLocal(channel, data);
        if (WorkerWs.sharedBus != null && WorkerWs.sharedBus.IsAvailable()) {
            WorkerWs.sharedBus.PublishChannel(channel, data, data.Length);
        }
        return sent;
    }

    // 精准向指定连接 ID 发送消息。若该连接在本进程则立即发送；
    // 若在集群其他 Worker 进程，则经 SharedTable 路由至目标进程发送。
    public static async bool PushTo(int connId, string data) {
        Connection localConn = WorkerWs.ConnById(connId);
        if (localConn != null) {
            return await WorkerWs.Push(localConn, data);
        }
        if (WorkerWs.sharedBus != null && WorkerWs.sharedBus.IsAvailable()) {
            WorkerWs.sharedBus.PublishDirect(connId, data, data.Length);
            return true;
        }
        return false;
    }

    // 接收来自其他 Worker 进程发来的跨进程共享总线消息。
    public static async void OnSharedMessage(int targetType, string channel, int targetId, string payload, int payloadLen) {
        if (targetType == 0) {
            await WorkerWs.BroadcastLocal(payload);
        } else if (targetType == 1) {
            await WorkerWs.BroadcastToLocal(channel, payload);
        } else if (targetType == 2) {
            Connection c = WorkerWs.ConnById(targetId);
            if (c != null) {
                await WorkerWs.Push(c, payload);
            }
        }
    }

    // WebSocket push：把一条 Text 帧排进该连接的出站缓冲并立即
    // 写出（服务端帧不掩码）。可从任何回调上下文调用——包括 onOpen 里
    // 主动欢迎、定时器里广播等没有入站消息先行的场景，这正是与"从
    // onMessage 返回应答"的区别。连接已关或未升级返回 false。
    // 帧序与帧循环共用同一缓冲，Append 到 Flush 之间不让出，天然一致。
    public static async bool Push(Connection c, string data) {
        WsLink link = WorkerWs.LinkOf(c.GetId());
        if (link == null || c.IsClosed()) { return false; }
        await link.LockAsync();
        try {
            if (c.IsClosed()) { return false; }
            int len = (int)strlen(data);
            WsFrame frame = WsFrame.RawFrame(WsOpcode.Text, data, len);
            byte[] encoded = frame.Encode();
            link.writer.Append(encoded, WsFrame.HeaderLen(len) + len);
            int n = await link.writer.Flush(link.client);
            if (n < 0) {
                c.Close();
                return false;
            }
            Worker.BumpSent();
            return true;
        } finally {
            link.Unlock();
        }
    }

    // WebSocket 二进制 push：`data` 可含 NUL，`len` 为精确
    // 字节数（绝不 strlen）。语义同 Push。
    public static async bool PushBinary(Connection c, string data, int len) {
        WsLink link = WorkerWs.LinkOf(c.GetId());
        if (link == null || c.IsClosed()) { return false; }
        await link.LockAsync();
        try {
            if (c.IsClosed()) { return false; }
            WsFrame frame = WsFrame.RawFrame(WsOpcode.Binary, data, len);
            byte[] encoded = frame.Encode();
            link.writer.Append(encoded, WsFrame.HeaderLen(len) + len);
            int n = await link.writer.Flush(link.client);
            if (n < 0) {
                c.Close();
                return false;
            }
            Worker.BumpSent();
            return true;
        } finally {
            link.Unlock();
        }
    }

    // WebSocket 原始字节数组 push：零中转字符串拷贝与二进制安全。
    public static async bool PushBinary(Connection c, byte[] data, int offset, int len) {
        if (data == null || offset < 0 || len <= 0 || offset + len > data.Length) { return false; }
        WsLink link = WorkerWs.LinkOf(c.GetId());
        if (link == null || c.IsClosed()) { return false; }
        await link.LockAsync();
        try {
            if (c.IsClosed()) { return false; }
            WsFrame frame = WsFrame.RawBytes(WsOpcode.Binary, data, offset, len);
            byte[] encoded = frame.Encode();
            link.writer.Append(encoded, WsFrame.HeaderLen(len) + len);
            int n = await link.writer.Flush(link.client);
            if (n < 0) {
                c.Close();
                return false;
            }
            Worker.BumpSent();
            return true;
        } finally {
            link.Unlock();
        }
    }

    // WebSocket 原始字节数组 push 全量切片。
    public static async bool PushBinary(Connection c, byte[] data) {
        int len = data != null ? data.Length : 0;
        return await WorkerWs.PushBinary(c, data, 0, len);
    }

    // ---- 帧循环 ----

    public static async void HandleWebSocket(Worker w, nint clientSock) {
        TcpClient client = TcpClient.FromSocket(clientSock);

        // 握手读取与明文 HTTP 一样受 requestTimeout 约束（慢速客户端
        // 每秒滴一个字节就能永久钉住协程与 64KB 复用缓冲）；WS 循环
        // 的空闲不设限，与 HTTP keep-alive 的请求间空闲一致。
        HttpDeadlineToken watch = HttpDeadline.Arm(clientSock, w.requestTimeout);
        HttpFramer framer = HttpFramer.Create(clientSock);
        int headerEnd = 0;
        try {
            headerEnd = await framer.ReadHead(w.maxHeaderBytes);
            HttpDeadline.Disarm(watch);
            watch = null;
        } finally {
            // ReadHead 半途抛出时 deadline 槽位必须释放（幂等）。
            HttpDeadline.Disarm(watch);
        }
        if (headerEnd <= 0) {
            framer.Dispose();
            client.Close();
            w.DropConn();
            return;
        }
        HttpRequest req = HttpRequest.Parse(framer.Head(headerEnd), headerEnd);
        bool wantsUpgrade = req.HasHeader("Sec-WebSocket-Key")
            || req.HasHeader("Upgrade")
            || req.HasHeader("Sec-WebSocket-Version")
            || WsHandshake.HasToken(req.GetHeader("Connection"), "upgrade");
        if (Worker.IsDebug()) {
            Worker.Dbg("ws port got " + req.method + " " + req.path
                + " headEnd=" + Convert.ToString(headerEnd)
                + " parseStatus=" + Convert.ToString(req.parseStatus)
                + " upgrade=" + Convert.ToString(wantsUpgrade));
        }

        if (!wantsUpgrade && req.parseStatus == 0) {
            await HttpServer.ServeFramed(clientSock, w.RequestHandler(), framer,
                w.maxHeaderBytes, w.maxRequestBytes, w.requestTimeout);
            w.DropConn();
            return;
        }
        string wsKey = req.GetHeader("Sec-WebSocket-Key");
        if (!WsHandshake.Valid(req)) {
            int _bad = await client.SendAsync("HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
            framer.Dispose();
            client.Close();
            w.DropConn();
            return;
        }
        // 之后的路径全部收口到帧循环末尾的统一清理；本函数内不再
        // 有提前 return。

        StringBuilder sb = HttpBufferPool.Rent();
        sb.Append("HTTP/1.1 101 Switching Protocols\r\n");
        sb.Append("Upgrade: websocket\r\n");
        sb.Append("Connection: Upgrade\r\n");
        sb.Append("Sec-WebSocket-Accept: ");
        sb.Append(Encoding.WebSocketAccept(wsKey));
        sb.Append("\r\n\r\n");
        string hsText = sb.ToString();
        HttpBufferPool.Return(sb);
        int _hs = await client.SendAsync(hsText);

        Connection conn = w.NewConnection(clientSock);

        WsReader reader = new WsReader(clientSock);
        int afterHead = framer.Pending() - headerEnd;
        if (afterHead > 0) {
            reader.Prime(framer.Slice(headerEnd, afterHead), afterHead);
        }
        framer.Dispose();
        WsWriter writer = new WsWriter();
        // 连接级出站能力：WorkerWs.Push/Broadcast 与帧循环共用这个 writer，
        // 回调里（onOpen 欢迎、定时器广播）无需入站消息先行即可推帧。
        WorkerWs.Attach(conn, writer, client);
        // onOpen 必须在 writer 挂载并登记之后触发：回调里的
        // WorkerWs.Push 依赖注册项非空（否则静默返回 false，
        // 欢迎帧丢失且无任何错误迹象）。
        // WS 帧循环的收尾清理在 finally 中：onOpen/onFrameData 抛出时
        // Close/ConnRemove/DropConn 一个都不能少——连接留在广播表里
        // 会对死 socket 持续推送，计数漂移则自我拒绝服务。
        ConnectionHandler onUp = w.OpenHandler();
        try {
        if (onUp != null) { await onUp(conn); }
        WsAssembler asm = new WsAssembler(reader.MaxLen());
        MessageHandler onFrameData = w.MessageHandlerOf();
        bool active = true;
        while (active && !conn.IsClosed()) {
            int total = reader.FrameSize();
            while (total < 0) {
                if (total == -2 || total == -3) {
                    // -2 = 帧长编码违规（1002）；-3 = 消息过大（1009）。
                    // 无上限时对端声明一个 2GB 的帧就能把缓冲撑到 OOM。
                    byte[] enc = WsFrame.CloseFrameWithCode(total == -3 ? 1009 : 1002).Encode();
                    writer.Append(enc, 4);
                    int _v = await writer.Flush(client);
                    active = false;
                    break;
                }
                if (writer.Pending()) { int _f = await writer.Flush(client); }
                int got = await reader.FillMore();
                if (got == 0) {
                    active = false;
                    break;
                }
                total = reader.FrameSize();
            }
            if (!active) { break; }

            WsFrame frame = reader.TakeFrame(total);

            // RFC 6455 入站帧门禁：统一复用公共校验，包含 RSV、掩码、
            // 控制帧边界、保留 opcode 与 Close code/reason UTF-8。
            if (!WsFrame.ValidInbound(frame, true)) {
                byte[] enc = WsFrame.CloseFrameWithCode(1002).Encode();
                writer.Append(enc, 4);
                int _b = await writer.Flush(client);
                active = false;
                break;
            }
            if (frame.opcode == WsOpcode.Ping) {
                // §5.5.3：Pong 必须原样带回 Ping 的应用数据——空 Pong
                // 会让按载荷配对的心跳客户端断连。
                WsFrame pong = WsFrame.RawFrame(WsOpcode.Pong, frame.payload, frame.payloadLen);
                byte[] encoded = pong.Encode();
                writer.Append(encoded, WsFrame.HeaderLen(frame.payloadLen) + frame.payloadLen);
                continue;
            }
            if (frame.opcode == WsOpcode.Pong) { continue; }
            if (frame.opcode == WsOpcode.Close) {
                WsFrame closeResp = WsFrame.CloseFrame();
                byte[] enc2 = closeResp.Encode();
                writer.Append(enc2, 2);
                int _c = await writer.Flush(client);
                active = false;
                break;
            }
            // 数据帧（Text/Binary/Continuation）：分片消息在 fin 时
            // 整条交付——此前 continuation 帧被静默丢弃。
            int feed = asm.Feed(frame);
            if (feed < 0) {
                byte[] enc = WsFrame.CloseFrameWithCode(feed == -2 ? 1009 : 1002).Encode();
                writer.Append(enc, 4);
                int _r = await writer.Flush(client);
                active = false;
                break;
            }
            if (feed == 0) { continue; }
            if (!asm.ValidComplete()) {
                byte[] encUtf = WsFrame.CloseFrameWithCode(1007).Encode();
                writer.Append(encUtf, 4);
                int _u = await writer.Flush(client);
                active = false;
                break;
            }

            int msgOpcode = asm.MessageOpcode();
            string message = asm.Complete();

            Worker.BumpStat();
            string response = "";
            if (onFrameData != null) {
                // 同 HandleTcp：用户帧回调抛出只丢弃本条消息，
                // 连接与循环存活。
                try {
                    response = await onFrameData(conn, message);
                    if (response == null) { response = ""; }
                } catch (Exception e) {
                    Console.WriteLine("[ws] onMessage exception: " + e.Message);
                    response = "";
                }
            } else {
                response = message;  // default: echo
            }
            int respLen = (int)strlen(response);
            if (respLen > 16777216) {
                byte[] encBig = WsFrame.CloseFrameWithCode(1009).Encode();
                writer.Append(encBig, 4);
                int _big = await writer.Flush(client);
                active = false;
                break;
            }
            if (respLen > 0) {
                WsFrame respFrame = WsFrame.RawFrame(msgOpcode, response, respLen);
                byte[] encoded = respFrame.Encode();
                writer.Append(encoded, WsFrame.HeaderLen(respLen) + respLen);
                Worker.BumpSent();
            }
        }  // while (active && !conn.IsClosed())
        } finally {
            client.Close();
            conn.Close();
            WorkerWs.ConnRemove(conn);  // Push 之后拒绝写已关闭的 socket
            w.DropConn();
            ConnectionCloseHandler onDown = w.onClose;
            if (onDown != null) { await onDown(conn); }
        }
    }
}

// WebSocket 业务连接中枢与广播 Hub 服务（面向对象化封装）
public class WebSocketHub {
    public WsSharedBus sharedBus = null;
    public WorkerWsConsumer busConsumer = null;
    public Dict<string, List<Connection>> channels = new Dict<string, List<Connection>>();
    public nint chanLock = Mutex.Create();
    public Dict<int, WsLink> conns = new Dict<int, WsLink>();
    public nint regLock = Mutex.Create();

    public void ChanInit() {
        if (this.chanLock == 0) { this.chanLock = Mutex.Create(); }
    }

    public void RegInit() {
        if (this.regLock == 0) { this.regLock = Mutex.Create(); }
    }

    public void EnableSharedBus(string busName) {
        if (this.sharedBus != null) { return; }
        this.sharedBus = new WsSharedBus(busName, 128);
        if (this.sharedBus.IsAvailable()) {
            this.busConsumer = new WorkerWsConsumer();
            this.sharedBus.StartPolling(this.busConsumer);
        }
    }

    public void DisableSharedBus() {
        if (this.sharedBus != null) { this.sharedBus.Stop(); }
        this.sharedBus = null;
        this.busConsumer = null;
    }

    public void Join(string channel, Connection conn) {
        if (conn == null || channel == "") { return; }
        this.ChanInit();
        Mutex.Lock(this.chanLock);
        List<Connection> list = null;
        if (this.channels.ContainsKey(channel)) {
            list = this.channels[channel];
        } else {
            list = new List<Connection>();
            this.channels.Add(channel, list);
        }
        int id = conn.GetId();
        bool exists = false;
        for (int i = 0; i < list.Count; i = i + 1) {
            if (list[i].GetId() == id) {
                exists = true;
                break;
            }
        }
        if (!exists) {
            list.Add(conn);
        }
        Mutex.Unlock(this.chanLock);
    }

    public void Leave(string channel, Connection conn) {
        if (conn == null || channel == "") { return; }
        this.ChanInit();
        Mutex.Lock(this.chanLock);
        if (this.channels.ContainsKey(channel)) {
            List<Connection> list = this.channels[channel];
            int id = conn.GetId();
            for (int i = 0; i < list.Count; i = i + 1) {
                if (list[i].GetId() == id) {
                    list.RemoveAt(i);
                    break;
                }
            }
            if (list.Count == 0) {
                this.channels.Remove(channel);
            }
        }
        Mutex.Unlock(this.chanLock);
    }

    public void LeaveAllChannels(Connection conn) {
        if (conn == null) { return; }
        this.ChanInit();
        Mutex.Lock(this.chanLock);
        int id = conn.GetId();
        List<string> keys = this.channels.Keys;
        for (int k = 0; k < keys.Count; k = k + 1) {
            string ch = keys[k];
            List<Connection> list = this.channels[ch];
            for (int i = 0; i < list.Count; i = i + 1) {
                if (list[i].GetId() == id) {
                    list.RemoveAt(i);
                    break;
                }
            }
        }
        Mutex.Unlock(this.chanLock);
    }

    public void Attach(Connection conn, WsWriter writer, TcpClient client) {
        this.RegInit();
        Mutex.Lock(this.regLock);
        WsLink link = new WsLink();
        link.conn = conn;
        link.writer = writer;
        link.client = client;
        int id = conn.GetId();
        if (this.conns.ContainsKey(id)) {
            this.conns.Remove(id);
        }
        this.conns.Add(id, link);
        Mutex.Unlock(this.regLock);
        if (this.sharedBus != null) {
            this.sharedBus.OnConnChange(1);
        }
    }

    public void ConnRemove(Connection conn) {
        this.RegInit();
        Mutex.Lock(this.regLock);
        int id = conn.GetId();
        if (this.conns.ContainsKey(id)) {
            WsLink link = this.conns[id];
            link.Unlock();
            while (link.waiters != null && link.waiters.Count > 0) {
                AsyncGate g = link.waiters[0];
                link.waiters.RemoveAt(0);
                g.Signal();
            }
            this.conns.Remove(id);
        }
        Mutex.Unlock(this.regLock);
        this.LeaveAllChannels(conn);
        if (this.sharedBus != null) {
            this.sharedBus.OnConnChange(-1);
        }
    }

    public WsLink LinkOf(int id) {
        this.RegInit();
        Mutex.Lock(this.regLock);
        WsLink found = null;
        if (this.conns.ContainsKey(id)) {
            found = this.conns[id];
        }
        Mutex.Unlock(this.regLock);
        return found;
    }

    public int ConnCount() {
        this.RegInit();
        Mutex.Lock(this.regLock);
        int n = this.conns.Count;
        Mutex.Unlock(this.regLock);
        return n;
    }

    public int ClusterConnCount() {
        if (this.sharedBus != null && this.sharedBus.IsAvailable()) {
            return this.sharedBus.GetTotalConnCount();
        }
        return this.ConnCount();
    }

    public void Clear() {
        this.DisableSharedBus();
        if (this.chanLock != 0) {
            Mutex.Lock(this.chanLock);
            this.channels.Clear();
            Mutex.Unlock(this.chanLock);
        }
        if (this.regLock != 0) {
            Mutex.Lock(this.regLock);
            this.conns.Clear();
            Mutex.Unlock(this.regLock);
        }
    }
}
