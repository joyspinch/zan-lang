using System;
using System.Collections.Generic;
using System.Net.Sockets;

namespace System.Net.Dns;

// 纯 Zan 原生全异步 UDP DNS 客户端（RFC 1035 标准实现）。
// 核心能力：
// 1. 无 OS 同步 getaddrinfo / C 运行时 FFI 依赖，真正纯非阻塞事件循环就绪等待。
// 2. 毫秒级超时防线，查询挂起在 reactor 定时器，杜绝因上游 DNS 宕机瘫痪事件循环。
// 3. 完整的报文事务 ID 校验与响应匹配防线。
// 4. 支持 A、AAAA、CNAME 等多记录类型查询。
public class DnsClient : IDisposable {
    public string dnsServer;
    public int dnsPort;
    public int timeoutMs;
    private int nextId;

    public DnsClient() {
        this.dnsServer = "8.8.8.8";
        this.dnsPort = 53;
        this.timeoutMs = 3000;
        this.nextId = 1000;
    }

    public DnsClient(string server, int port) {
        this.dnsServer = server;
        this.dnsPort = port;
        this.timeoutMs = 3000;
        this.nextId = 1000;
    }

    public DnsClient SetTimeout(int ms) {
        if (ms < 100) { ms = 100; }
        this.timeoutMs = ms;
        return this;
    }

    private int NextTxId() {
        this.nextId = (this.nextId + 1) & 65535;
        if (this.nextId == 0) { this.nextId = 1; }
        return this.nextId;
    }

    // 异步解析 IPv4 地址列表 (Type A)
    public async List<string> ResolveAsync(string domain) {
        List<DnsRecord> records = await this.QueryAsync(domain, DnsRecordType.A);
        List<string> ips = new List<string>();
        for (int i = 0; i < records.Count; i = i + 1) {
            if (records[i].recordType == DnsRecordType.A && records[i].value.Length > 0) {
                ips.Add(records[i].value);
            }
        }
        return ips;
    }

    // 异步解析 IPv6 地址列表 (Type AAAA)
    public async List<string> ResolveAaaaAsync(string domain) {
        List<DnsRecord> records = await this.QueryAsync(domain, DnsRecordType.AAAA);
        List<string> ips = new List<string>();
        for (int i = 0; i < records.Count; i = i + 1) {
            if (records[i].recordType == DnsRecordType.AAAA && records[i].value.Length > 0) {
                ips.Add(records[i].value);
            }
        }
        return ips;
    }

    // 异步解析规范别名 (Type CNAME)
    public async string ResolveCnameAsync(string domain) {
        List<DnsRecord> records = await this.QueryAsync(domain, DnsRecordType.CNAME);
        for (int i = 0; i < records.Count; i = i + 1) {
            if (records[i].recordType == DnsRecordType.CNAME && records[i].value.Length > 0) {
                return records[i].value;
            }
        }
        return "";
    }

    // 异步解析邮件交换服务器 (Type MX)
    public async List<string> ResolveMxAsync(string domain) {
        List<DnsRecord> records = await this.QueryAsync(domain, DnsRecordType.MX);
        List<string> mxs = new List<string>();
        for (int i = 0; i < records.Count; i = i + 1) {
            if (records[i].recordType == DnsRecordType.MX && records[i].value.Length > 0) {
                mxs.Add(records[i].value);
            }
        }
        return mxs;
    }

    // 异步解析文本记录 (Type TXT)
    public async List<string> ResolveTxtAsync(string domain) {
        List<DnsRecord> records = await this.QueryAsync(domain, DnsRecordType.TXT);
        List<string> txts = new List<string>();
        for (int i = 0; i < records.Count; i = i + 1) {
            if (records[i].recordType == DnsRecordType.TXT && records[i].value.Length > 0) {
                txts.Add(records[i].value);
            }
        }
        return txts;
    }

    // 异步解析 IPv4 反向指针域名 (RFC 1035 §3.5 PTR 记录与 IN-ADDR.ARPA 映射)。
    // 例如输入 "192.168.1.10" -> 查询 "10.1.168.192.in-addr.arpa"。
    public async string ResolvePtrAsync(string ip) {
        if (!IPAddress.IsIPv4(ip)) { return ""; }
        List<string> parts = ip.Split(".");
        if (parts.Count != 4) { return ""; }
        string arpaDomain = parts[3] + "." + parts[2] + "." + parts[1] + "." + parts[0] + ".in-addr.arpa";
        List<DnsRecord> records = await this.QueryAsync(arpaDomain, DnsRecordType.PTR);
        for (int i = 0; i < records.Count; i = i + 1) {
            if (records[i].recordType == DnsRecordType.PTR && records[i].value.Length > 0) {
                return records[i].value;
            }
        }
        return "";
    }

    // 异步发送 RFC 1035 UDP DNS 查询报文，并等待对端回显应答。
    // RFC 1035 §4.2.1: 若响应报文被截断（TC=1），自动回退至 TCP 53 端口重新查询。
    public async List<DnsRecord> QueryAsync(string domain, int queryType) {
        if (domain == null || domain.Length == 0) {
            return new List<DnsRecord>();
        }

        int txId = this.NextTxId();
        byte[] queryPkt = DnsPacket.BuildQuery(domain, queryType, txId);

        UdpClient udp = new UdpClient();
        try {
            int sent = await udp.SendBytesToAsync(queryPkt, queryPkt.Length, this.dnsServer, this.dnsPort);
            if (sent <= 0) {
                return new List<DnsRecord>();
            }

            byte[] respBuf = new byte[4096];
            int rlen = await udp.RecvBytesFromAsync(respBuf, respBuf.Length, this.timeoutMs);
            if (rlen <= 0) {
                return new List<DnsRecord>(); // 超时或对端异常
            }

            DnsPacket pkt = DnsPacket.Parse(respBuf, rlen);
            if (pkt == null || pkt.transactionId != txId || !pkt.isResponse) {
                return new List<DnsRecord>();
            }

            // RFC 1035 §4.2.1 规范要求：若 UDP 报文被截断（TC=1），必须自动切换至 TCP 53 端口获取完整记录
            if (pkt.isTruncated) {
                return await this.DoQueryTcpAsync(domain, queryType, queryPkt, txId);
            }

            return pkt.answers;
        } finally {
            udp.Close();
        }
    }

    // 显式执行 RFC 1035 §4.2.2 基于 TCP 53 端口的 DNS 异步查询
    public async List<DnsRecord> QueryTcpAsync(string domain, int queryType) {
        if (domain == null || domain.Length == 0) {
            return new List<DnsRecord>();
        }
        int txId = this.NextTxId();
        byte[] queryPkt = DnsPacket.BuildQuery(domain, queryType, txId);
        return await this.DoQueryTcpAsync(domain, queryType, queryPkt, txId);
    }

    private async List<DnsRecord> DoQueryTcpAsync(string domain, int queryType, byte[] queryPkt, int txId) {
        TcpClient client = await TcpClient.ConnectAsync(this.dnsServer, this.dnsPort, this.timeoutMs);
        if (client == null || !client.IsConnected()) {
            return new List<DnsRecord>();
        }

        try {
            int qlen = queryPkt.Length;
            byte[] tcpQuery = new byte[qlen + 2];
            tcpQuery[0] = (byte)((qlen >> 8) & 255);
            tcpQuery[1] = (byte)(qlen & 255);
            for (int i = 0; i < qlen; i = i + 1) {
                tcpQuery[i + 2] = queryPkt[i];
            }

            int sent = await client.SendBytesAsync(tcpQuery, tcpQuery.Length);
            if (sent <= 0) {
                return new List<DnsRecord>();
            }

            // RFC 1035 §4.2.2: TCP 报文前置 2 字节大端网络序长度
            byte[] prefix = new byte[2];
            int pRead = 0;
            while (pRead < 2) {
                byte[] pBuf = new byte[2 - pRead];
                int n = await client.RecvBytesAsync(pBuf, 2 - pRead, this.timeoutMs);
                if (n <= 0) { return new List<DnsRecord>(); }
                for (int i = 0; i < n; i = i + 1) {
                    prefix[pRead + i] = pBuf[i];
                }
                pRead = pRead + n;
            }

            int msgLen = ((prefix[0] & 255) << 8) | (prefix[1] & 255);
            if (msgLen <= 0 || msgLen > 65535) {
                return new List<DnsRecord>();
            }

            byte[] respBuf = new byte[msgLen];
            int received = 0;
            while (received < msgLen) {
                byte[] chunk = new byte[msgLen - received];
                int r = await client.RecvBytesAsync(chunk, msgLen - received, this.timeoutMs);
                if (r <= 0) { break; }
                for (int i = 0; i < r; i = i + 1) {
                    respBuf[received + i] = chunk[i];
                }
                received = received + r;
            }

            if (received < msgLen) {
                return new List<DnsRecord>();
            }

            DnsPacket pkt = DnsPacket.Parse(respBuf, msgLen);
            if (pkt == null || pkt.transactionId != txId || !pkt.isResponse) {
                return new List<DnsRecord>();
            }

            return pkt.answers;
        } finally {
            client.Close();
        }
    }

    public void Dispose() {
    }
}
