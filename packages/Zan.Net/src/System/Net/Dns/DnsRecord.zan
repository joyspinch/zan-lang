using System;

namespace System.Net.Dns;

// RFC 1035 DNS 资源记录类型
public class DnsRecordType {
    public const int A = 1;         // IPv4 主机地址
    public const int NS = 2;        // 权威域名服务器
    public const int CNAME = 5;     // 规范别名
    public const int SOA = 6;       // 区域授权起点
    public const int PTR = 12;      // 域名指针（反向解析）
    public const int MX = 15;       // 邮件交换
    public const int TXT = 16;      // 文本记录
    public const int AAAA = 28;     // IPv6 主机地址（RFC 3596）
    public const int SRV = 33;      // 服务定位记录（RFC 2782）
    public const int OPT = 41;      // RFC 6891 EDNS0 OPT 伪记录
    public const int ANY = 255;     // 任意类型
}

// RFC 1035 DNS 响应状态码
public class DnsResponseCode {
    public const int NOERROR = 0;   // 成功，无错误
    public const int FORMERR = 1;   // 格式错误
    public const int SERVFAIL = 2;  // 服务器故障
    public const int NXDOMAIN = 3;  // 域名不存在
    public const int NOTIMP = 4;    // 未实现的操作
    public const int REFUSED = 5;   // 拒绝查询
}

// 解析出的 DNS 记录
public class DnsRecord {
    public string name;
    public int recordType;
    public int recordClass;
    public int ttl;
    public string value;

    public DnsRecord() {
        this.name = "";
        this.recordType = DnsRecordType.A;
        this.recordClass = 1;
        this.ttl = 0;
        this.value = "";
    }

    public DnsRecord(string name, int type, int ttl, string value) {
        this.name = name;
        this.recordType = type;
        this.recordClass = 1;
        this.ttl = ttl;
        this.value = value;
    }
}
