using System;
using System.Collections.Generic;
using System.Net.Sockets;

namespace System.Net;

class Connection {
    [DllImport("crt")]
    static extern long strlen(string str);

    int id;
    nint sock;
    string protocol;
    string userData;
    bool closed;

    Connection(int id, nint sock, string protocol) {
        this.id = id;
        this.sock = sock;
        this.protocol = protocol;
        this.userData = "";
        this.closed = false;
    }

    void SetData(string data) {
        this.userData = data;
    }

    // 取该连接的自定义应用数据（SetData 设置的值）。
    string GetData() {
        return this.userData;
    }

    // 连接 id（进程内自增，唯一）。
    int GetId() {
        return this.id;
    }

    // 底层 socket 句柄。
    nint GetSocket() {
        return this.sock;
    }

    // 连接所属协议名（如 "http"、"websocket"、"tcp"）。
    string GetProtocol() {
        return this.protocol;
    }

    // bytes.
    void Send(string data) {
        Task.Spawn(Socket.SendStringAsync(this.sock, data));
        Worker.BumpSent();
    }

    async int SendAsync(string data) {
        int n = await Socket.SendStringAsync(this.sock, data);
        Worker.BumpSent();
        return n;
    }

    void Close() {
        this.closed = true;
    }

    // 连接是否已被标记关闭（实际关闭由 worker 循环执行）。
    bool IsClosed() {
        return this.closed;
    }
}
