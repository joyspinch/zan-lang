using System;

namespace System.Net;

public class BannerService {
    public string name;
    public string listen;
    public string procs;
    public string status;

    public BannerService(string name, string listen, string procs, string status) {
        this.name = name;
        this.listen = listen;
        this.procs = procs;
        this.status = status;
    }
}
