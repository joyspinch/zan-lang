using System;
using System.Net.Sockets;

namespace System.Net.Sockets;

// 跨平台的异步 UDP 客户端/服务器。
// UDP 是无连接的：一个套接字可以向多个对端发送并从多个对端接收，
// 并与协程调度器集成。
// 用法（服务器）：
// while (true) {
// // 处理数据
// }
// 用法（客户端）：
public class UdpClient : IDisposable {
    nint sock;
    string host;
    int port;
    bool bound;

    [DllImport("crt")]
    private static extern long strlen(string str);

    // 构造非阻塞 UDP 套接字，不绑定本地地址；经 Bind() 绑定端口。
    public UdpClient() {
        Socket.Initialize();
        this.sock = Socket.CreateUdp();
        Socket.SetNonBlocking(this.sock);
        this.host = "";
        this.port = 0;
        this.bound = false;
    }

    // 创建绑定到本地地址和端口的 UDP 套接字。
    // 绑定失败（端口被占用等）返回 null。
    public static UdpClient Bind(string host, int port) {
        UdpClient client = new UdpClient();
        client.host = host;
        client.port = port;
        Socket.SetReuseAddr(client.sock);
        if (Socket.Bind(client.sock, host, port) != 0) {
            Socket.Close(client.sock);
            return null;
        }
        client.bound = true;
        return client;
    }

    // 向指定地址发送数据报。
    public int SendTo(string data, string ip, int port) {
        int len = (int)strlen(data);
        return Socket.SendTo(this.sock, data, len, ip, port);
    }

    // 发送数据报，在 IO reactor 上挂起直到可写。
    public async int SendToAsync(string data, string ip, int port) {
        int len = (int)strlen(data);
        int r = await Socket.SendToAsync(this.sock, data, len, ip, port);
        return r;
    }

    // 发送原始字节（字符串形式，带显式长度）。
    public int SendBytesTo(string data, int len, string ip, int port) {
        return Socket.SendTo(this.sock, data, len, ip, port);
    }

    // 发送原始字节数组（零拷贝与二进制安全）。
    public int SendBytesTo(byte[] data, int len, string ip, int port) {
        return Socket.SendTo(this.sock, data, len, ip, port);
    }

    // 以显式长度发送原始字节（字符串形式），在 IO
    // reactor 上挂起直到可写。用于二进制数据报：字符串
    // 重载用 strlen 计算长度，会在第一个 NUL 处停止。
    public async int SendBytesToAsync(string data, int len, string ip, int port) {
        int r = await Socket.SendToAsync(this.sock, data, len, ip, port);
        return r;
    }

    // 以显式长度发送原始字节数组，在 IO
    // reactor 上挂起直到可写。零中转字符串拷贝与二进制安全。
    public async int SendBytesToAsync(byte[] data, int len, string ip, int port) {
        int r = await Socket.SendToAsync(this.sock, data, len, ip, port);
        return r;
    }

    // 同步接收数据报。
    public string RecvFrom(int bufSize) {
        return Socket.RecvFrom(this.sock, bufSize);
    }

    // 接收数据报到调用方提供的缓冲区，返回
    // 字节数（无数据时为 0）。用于二进制数据报：字符串
    // 版本用 strlen 计算长度，会在第一个 NUL 处停止。
    public int RecvBytesFrom(byte[] buf, int bufSize) {
        return Socket.RecvFromInto(this.sock, buf, bufSize);
    }

    // 接收数据报，在 IO reactor 上挂起直到有数据报
    // 到达。
    public async string RecvFromAsync(int bufSize) {
        string r = await Socket.RecvFromAsync(this.sock, bufSize);
        return r;
    }

    // 使用默认缓冲区大小接收。
    public async string RecvFromAsync() {
        string r = await Socket.RecvFromAsync(this.sock, 65536);
        return r;
    }

    // 关闭 UDP 套接字（幂等）。关闭后 IsBound 为 false。
    public void Close() {
        if (this.sock >= 0) {
            Socket.Close(this.sock);
            this.sock = -1;
        }
        this.bound = false;
    }

    public void Dispose() {
        this.Close();
    }

    // 析构兜底：未显式 Close 时在此释放底层套接字句柄，杜绝文件描述符泄漏。

    // 返回底层套接字句柄。
    public nint GetSocket() {
        return this.sock;
    }

    // 返回该套接字是否已绑定。
    public bool IsBound() {
        return this.bound;
    }

    // 在套接字上启用广播。
    public void EnableBroadcast() {
        Socket.SetBroadcast(this.sock);
    }
}
