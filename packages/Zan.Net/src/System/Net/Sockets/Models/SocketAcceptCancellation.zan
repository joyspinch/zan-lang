using System;

namespace System.Net.Sockets;

public class SocketAcceptCancellation {
    public object sync;
    public nint socket;
    public CancellationToken cancellation;
    public bool active;

    public SocketAcceptCancellation(nint socket, CancellationToken cancellation) {
        this.sync = new object();
        this.socket = socket;
        this.cancellation = cancellation;
        this.active = true;
    }

    public void Check() {
        lock (this.sync) {
            if (this.active && this.cancellation.IsCancellationRequested) {
                Socket.CancelPendingIo(this.socket);
            }
        }
    }

    public void Finish() {
        lock (this.sync) { this.active = false; }
    }
}

// 跨平台的低层套接字操作。
// Windows 使用 Winsock2，Linux/macOS 使用 BSD 套接字（libc）。
