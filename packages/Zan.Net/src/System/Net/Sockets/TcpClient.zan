using System;
using System.Net;
using System.Net.Sockets;
using System.Threading;

namespace System.Net.Sockets;

// 基于 Socket 层实现的 TCP 客户端。
public class TcpClient : IDisposable {
    private nint sock;
    private string host;
    private int port;
    private bool connected;
    private bool nonBlocking;
    private int recvBufSize;
    private string recvBuf;

    public TcpClient() {
        this.sock = -1;
        this.host = "";
        this.port = 0;
        this.connected = false;
        this.nonBlocking = false;
        this.recvBufSize = NetConstants.BufferJumbo;
        this.recvBuf = null;
    }

    public nint Sock() { return this.sock; }
    public Socket Client { get { return new Socket(this.sock); } }

    public static TcpClient FromSocket(nint sock) {
        TcpClient client = new TcpClient();
        client.sock = sock;
        client.connected = true;
        return client;
    }

    public static async TcpClient ConnectAsync(string host, int port) {
        return await TcpClient.ConnectAsync(host, port, NetConstants.TimeoutLongConnectMs, true);
    }

    public static async TcpClient ConnectAsync(string host, int port, int timeoutMs) {
        return await TcpClient.ConnectAsync(host, port, timeoutMs, true);
    }

    public static async TcpClient ConnectAsync(string host, int port, int timeoutMs, bool allowLoopback) {
        return await TcpClient.ConnectAsync(host, port, timeoutMs, allowLoopback, true);
    }

    // 解析并按候选 sockaddr 逐个审核与建连；timeoutMs <= 0 表示不设截止时间。
    public static async TcpClient ConnectAsync(string host, int port, int timeoutMs,
                                        bool allowLoopback, bool allowPrivate) {
        Socket.Initialize();
        TcpClient.MarkConnectTimeout(false);
        TcpClient.MarkConnectResolveFailed(false);
        bool bounded = timeoutMs > 0;
        long deadline = bounded ? (Socket.NativeMonotonicUs() + (long)timeoutMs * 1000) : 0;
        byte[] records = new byte[16 * 32];
        bool fromCache = false;
        int count = DnsCache.Lookup(host, port, records);
        if (count > 0) {
            fromCache = true;
        } else {
            count = await Socket.ResolveAllAsync(host, port, records);
            if (count <= 0) {
                TcpClient.MarkConnectResolveFailed(true);
                return null;
            }
            DnsCache.Store(host, port, records, count);
        }
        byte[] rec = new byte[32];
        for (int i = 0; i < count; i = i + 1) {
            int offset = i * 32;
            NativeMemory.Copy((nint)rec, (nint)records + (nint)offset, 32);
            int family = Socket.SockAddrFamily(rec, 32);
            if (family == 0) { continue; }
            int saLen = Socket.IsV6Family(family) ? 28 : 16;
            if (!Socket.SockAddrIsSafe(rec, saLen, allowLoopback, allowPrivate)) {
                TcpClient.MarkConnectResolveFailed(true);
                return null;
            }
            nint sock = Socket.IsV6Family(family) ? Socket.CreateTcp6() : Socket.CreateTcp();
            if (sock < 0) { continue; }
            Socket.SetNonBlocking(sock);
            int remain = -1;
            if (bounded) {
                remain = (int)((deadline - Socket.NativeMonotonicUs()) / 1000);
                if (remain <= 0) {
                    Socket.Close(sock);
                    TcpClient.MarkConnectTimeout(true);
                    return null;
                }
            }
            int err = await Socket.ConnectSockAddrAsync(sock, rec, saLen, remain);
            if (err == 0) {
                TcpClient client = new TcpClient();
                client.sock = sock;
                client.host = host;  // 保留原始主机名供 TLS SNI/校验证书使用
                client.port = port;
                client.connected = true;
                client.nonBlocking = true;
                return client;
            }
            Socket.Close(sock);
            if (err == -3) {
                TcpClient.MarkConnectTimeout(true);
                return null;
            }
        }
        if (fromCache) {
            // 缓存地址全部不可达时驱逐缓存并以剩余预算重新解析一次。
            DnsCache.Invalidate(host, port);
            int retryRemain = -1;
            if (bounded) {
                retryRemain = (int)((deadline - Socket.NativeMonotonicUs()) / 1000);
                if (retryRemain <= 0) {
                    TcpClient.MarkConnectTimeout(true);
                    return null;
                }
            }
            return await TcpClient.ConnectAsync(host, port, retryRemain, allowLoopback, allowPrivate);
        }
        return null;
    }

    private static ThreadLocal<bool> tlConnectTimedOut = new ThreadLocal<bool>();
    private static ThreadLocal<bool> tlConnectResolveFailed = new ThreadLocal<bool>();

    public static bool LastConnectTimedOut() {
        return TcpClient.tlConnectTimedOut != null && TcpClient.tlConnectTimedOut.Value;
    }

    private static void MarkConnectTimeout(bool timedOut) {
        if (TcpClient.tlConnectTimedOut != null) { TcpClient.tlConnectTimedOut.Value = timedOut; }
    }

    public static bool LastConnectResolveFailed() {
        return TcpClient.tlConnectResolveFailed != null && TcpClient.tlConnectResolveFailed.Value;
    }

    private static void MarkConnectResolveFailed(bool failed) {
        if (TcpClient.tlConnectResolveFailed != null) { TcpClient.tlConnectResolveFailed.Value = failed; }
    }

    public static TcpClient Connect(string host, int port) {
        Socket.Initialize();
        TcpClient client = new TcpClient();
        client.host = host;
        client.port = port;
        client.sock = Socket.CreateTcp();
        int ret = Socket.Connect(client.sock, host, port);
        if (ret < 0) {
            Socket.Close(client.sock);
            client.sock = -1;
            client.connected = false;
            return null;
        }
        client.connected = true;
        return client;
    }

    // 异步入口幂等切到非阻塞，避免同步 Connect/FromSocket 传入的阻塞句柄卡住调度线程。
    public void EnsureNonBlocking() {
        if (this.nonBlocking || this.sock < 0) { return; }
        Socket.SetNonBlocking(this.sock);
        this.nonBlocking = true;
    }

    public async int SendAsync(string data) {
        this.EnsureNonBlocking();
        int len = data != null ? data.Length : 0;
        return await Socket.SendAsync(this.sock, data, len);
    }

    public async int SendBytesAsync(string data, int len) {
        this.EnsureNonBlocking();
        return await Socket.SendAsync(this.sock, data, len);
    }

    public async int SendBytesAsync(byte[] data, int len) {
        this.EnsureNonBlocking();
        return await Socket.SendBytesAsync(this.sock, data, 0, len);
    }

    public async int SendBytesAsync(byte[] data, int offset, int len) {
        this.EnsureNonBlocking();
        return await Socket.SendBytesAsync(this.sock, data, offset, len);
    }

    public async int SendPtrAsync(nint ptr, int len) {
        this.EnsureNonBlocking();
        return await Socket.SendPtrAsync(this.sock, ptr, len);
    }

    public async int SendViewAsync(StringView view) {
        this.EnsureNonBlocking();
        return await Socket.SendViewAsync(this.sock, view);
    }

    public async int RecvPtrAsync(nint ptr, int maxLen) {
        this.EnsureNonBlocking();
        return await Socket.RecvPtrAsync(this.sock, ptr, maxLen);
    }

    public async string RecvAsync(int bufSize) {
        this.EnsureNonBlocking();
        return await Socket.RecvAsync(this.sock, bufSize);
    }

    public async int RecvBytesAsync(byte[] buf, int maxLen) {
        this.EnsureNonBlocking();
        return await Socket.RecvBytesAsync(this.sock, buf, maxLen);
    }

    public async int RecvBytesAsync(byte[] buf, int maxLen, int timeoutMs) {
        this.EnsureNonBlocking();
        return await Socket.RecvBytesAsync(this.sock, buf, maxLen, timeoutMs);
    }

    public async string RecvAsync(int bufSize, int timeoutMs) {
        this.EnsureNonBlocking();
        return await Socket.RecvAsync(this.sock, bufSize, timeoutMs);
    }

    public async string RecvAsync() {
        this.EnsureNonBlocking();
        return await Socket.RecvAsync(this.sock, this.recvBufSize);
    }

    // 复用本连接 64KB ARC 缓冲区；返回值仅在下一次接收前有效。
    public async string RecvReuseAsync() {
        this.EnsureNonBlocking();
        if (this.recvBuf == null) {
            this.recvBuf = TcpClient.RentRecvBuffer(this.recvBufSize);
        }
        int _n = await Socket.RecvIntoAsync(this.sock, this.recvBuf, this.recvBufSize);
        return this.recvBuf;
    }

    private static List<string> recvPool = new List<string>();
    private static int recvPoolSize = 65536;
    private static int recvPoolMax = 1024;

    private static string AllocBuffer(int size) {
        if (size <= 0) { return ""; }
        byte[] tmp = new byte[size];
        NativeMemory.Fill((nint)tmp, 32, size);
        return NativeMemory.GetString((nint)tmp, 0, size);
    }

    public static string RentRecvBuffer(int size) {
        if (size == TcpClient.recvPoolSize) {
            lock (TcpClient.recvPool) {
                int n = TcpClient.recvPool.Count;
                if (n > 0) {
                    string buf = TcpClient.recvPool[n - 1];
                    TcpClient.recvPool.RemoveAt(n - 1);
                    return buf;
                }
            }
        }
        // 必须分配为 ARC 托管字符串，避免原始 calloc 块被 str_release 误释放。
        return TcpClient.AllocBuffer(size);
    }

    public static void ReturnRecvBuffer(string buf, int size) {
        if (buf == null || size != TcpClient.recvPoolSize) { return; }
        lock (TcpClient.recvPool) {
            if (TcpClient.recvPool.Count >= TcpClient.recvPoolMax) { return; }
            TcpClient.recvPool.Add(buf);
        }
    }

    public int Send(string data) { return Socket.SendString(this.sock, data); }
    public string Recv(int bufSize) { return Socket.Receive(this.sock, bufSize); }

    public void Close() {
        if (this.connected) {
            // 先 ShutdownBoth（含 Windows CancelIoEx）唤醒挂起重叠 IO，防止调度器永不静止。
            Socket.ShutdownBoth(this.sock);
            Socket.Close(this.sock);
            this.connected = false;
            this.sock = -1;
        }
        if (this.recvBuf != null) {
            TcpClient.ReturnRecvBuffer(this.recvBuf, this.recvBufSize);
            this.recvBuf = null;
        }
    }

    public void Dispose() { this.Close(); }
    public bool IsConnected() { return this.connected; }
    public nint GetSocket() { return this.sock; }
    public void SetRecvBufferSize(int size) { this.recvBufSize = size; }
}
