using System;

namespace System.Net.Sockets;

// 由无栈 IO reactor 驱动的异步非阻塞套接字操作（挂起到 Socket.ReadReady / WriteReady，
// 仅在 fd 就绪后才操作；套接字需先设置 Socket.SetNonBlocking）。
public class AsyncSocket {
    [DllImport("crt")]
    private static extern long strlen(string str);

    // 挂起直到 sock 可读，接收最多 bufSize 字节并以字符串返回（EOF 时返回空串）。
    public static async string Receive(nint sock, int bufSize) {
        byte[] buf = new byte[bufSize + 1];
        int n = await Socket.RecvOv(sock, buf, bufSize);
        if (n < 0) {
            n = 0;
        }
        return buf.ToStr(0, n);
    }

    // 挂起直到可读，接收最多 bufSize 字节到调用方缓冲区 buf，返回字节数（EOF 为 0，无额外分配）。
    public static async int ReceiveInto(nint sock, string buf, int bufSize) {
        int n = await Socket.RecvIntoAsync(sock, buf, bufSize);
        return n;
    }

    // 挂起直到可写并发送 len 字节（处理部分写直到全部发完或对端关闭，二进制安全）。
    public static async int Send(nint sock, string data, int len) {
        int r = await Socket.SendAsync(sock, data, len);
        return r;
    }

    // 发送整个以 NUL 结尾的字符串（长度由 strlen 得出）。
    public static async int SendString(nint sock, string data) {
        int len = (int)strlen(data);
        int r = await Send(sock, data, len);
        return r;
    }

    // 挂起直到有入站连接并接受，返回客户端 fd。
    public static async nint Accept(nint sock) {
        return await Socket.AcceptAsync(sock);
    }

    // 发起非阻塞连接并挂起直到完成；成功返回 0，失败返回非零 SO_ERROR 错误码。
    public static async int Connect(nint sock, string ip, int port) {
        return await Socket.ConnectAsync(sock, ip, port);
    }
}
