using System;
using System.Threading;
using System.Platform;

namespace System.Net.Sockets;

// 定时器独占捕获该状态；Finish 与迟到回调串行化执行。
public class Socket {
    // 整个 API 中套接字句柄统一使用 `nint`，同 C#
    // （SafeSocketHandle / IntPtr）：Windows SOCKET 是 UINT_PTR，POSIX fd 是
    // 32 位 int。只有下面的 Sys* 包装函数符合真实 C 签名，
    // 在 POSIX 需要 fd 处截断为 `int`。
    [DllImport("crt", EntryPoint = "zan_io_socket_send")]
    public static extern long ReactorSend(nint sock, string buf, long len, int flags);

    [DllImport("crt", EntryPoint = "zan_io_socket_send")]
    public static extern long ReactorSendPtr(nint sock, nint buf, long len, int flags);

    [DllImport("crt", EntryPoint = "zan_io_socket_recv")]
    public static extern long ReactorRecv(nint sock, string buf, long len, int flags);

    [DllImport("crt", EntryPoint = "zan_io_socket_recv")]
    public static extern long ReactorRecvPtr(nint sock, nint buf, long len, int flags);

    [DllImport("crt", EntryPoint = "zan_io_socket_ready")]
    public static extern int ReactorReady(nint sock, int writeReady);

    // 探测非阻塞连接的结果：0 表示已连接，
    // 失败时为正的 SO_ERROR 码（或 -1），连接进行中为 -2。
    [DllImport("crt", EntryPoint = "zan_io_connect_status")]
    public static extern int ConnectStatus(nint sock);

    [DllImport("crt", EntryPoint = "zan_io_socket_alive")]
    public static extern int SocketAlive(nint sock);

    // 关闭通知钩子：必须在 close 之前调用，把 reactor 中挂起
    // 在该 fd 上的就绪等待者以「对端关闭」形态唤醒并摘除注册，
    // 消除 fd 号复用后老等待者错投到新连接的窗口。
    [DllImport("crt", EntryPoint = "zan_io_close_notify")]
    public static extern void ReactorCloseNotify(nint sock);

    [DllImport("crt", EntryPoint = "zan_io_socket_peer_ip")]
    private static extern string NativePeerIp(nint sock);

    private static nint socket(int af, int type, int protocol) {
        return Pal.Network.CreateSocket(af, type, protocol);
    }

    private static int SysClose(nint s) { return Pal.Network.CloseSocket(s); }
    private static int SysShutdown(nint s, int how) { return Pal.Network.Shutdown(s, how); }
    private static int SysBind(nint s, string addr, int addrlen) { return Pal.Network.Bind(s, addr, addrlen); }
    private static int SysListen(nint s, int backlog) { return Pal.Network.Listen(s, backlog); }
    private static nint SysAccept(nint s, string addr, string addrlen) { return Pal.Network.Accept(s, addr, addrlen); }
    private static int SysConnect(nint s, string addr, int addrlen) { return Pal.Network.Connect(s, addr, addrlen); }
    private static int SysSetSockOpt(nint s, int level, int optname, string optval, int optlen) {
        return Pal.Network.SetSocketOption(s, level, optname, optval, optlen);
    }
    private static int SysSendTo(nint s, string buf, int len, int flags, string to, int tolen) {
        return Pal.Network.SendTo(s, buf, len, flags, to, tolen);
    }
    private static int SysRecvFrom(nint s, string buf, int len, int flags, string from, string fromlen) {
        return Pal.Network.RecvFrom(s, buf, len, flags, from, fromlen);
    }

    // 纯 Zan 实现的网络字节序转换（16位与32位高低位翻转）。
    // 零依赖 libc/ws2_32 外部符号，支持所有平台自举。
    public static ushort Htons(ushort hostshort) {
        int v = hostshort & 65535;
        return (ushort)(((v & 255) << 8) | ((v >> 8) & 255));
    }
    private static ushort htons(ushort hostshort) { return Socket.Htons(hostshort); }

    public static ushort Ntohs(ushort netshort) { return Socket.Htons(netshort); }
    private static ushort ntohs(ushort netshort) { return Socket.Ntohs(netshort); }

    public static int Htonl(int hostlong) {
        return ((hostlong & 255) << 24) |
               (((hostlong >> 8) & 255) << 16) |
               (((hostlong >> 16) & 255) << 8) |
               ((hostlong >> 24) & 255);
    }
    private static int htonl(int hostlong) { return Socket.Htonl(hostlong); }

    public static int Ntohl(int netlong) { return Socket.Htonl(netlong); }

    // 纯 Zan 实现的点分 IPv4 文本解析（点分十进制 → 网络字节序 32 位整数）。
    // 第一段在低字节，解析失败返回 -1；255.255.255.255 按 inet_addr 惯例也返回 -1。
    public static int InetAddr(string cp) {
        if (cp == null || cp.Length == 0) { return -1; }
        int value = 0;
        int part = 0;
        int count = 0;
        int i = 0;
        while (i < cp.Length) {
            int c = cp[i] & 255;
            if (c == 46) {  // '.'
                if (part > 255) { return -1; }
                value = value | (part << (count * 8));
                count = count + 1;
                part = 0;
                if (count > 3) { return -1; }
            } else if (c >= 48 && c <= 57) {
                part = part * 10 + c - 48;
                if (part > 255) { return -1; }
            } else {
                return -1;
            }
            i = i + 1;
        }
        if (count != 3 || part > 255) { return -1; }
        return value | (part << 24);
    }
    private static int inet_addr(string cp) { return Socket.InetAddr(cp); }

    // 主机名解析由运行时提供（rt_io.c），跨平台统一支持。
    [DllImport("crt", EntryPoint = "zan_io_resolve_ipv4")]
    private static extern int NativeResolveIpv4(string hostname);

    // getaddrinfo 版解析：主机名或字面量 IP（IPv4/IPv6）→ 完整
    // sockaddr 字节（16 或 28），返回实际长度（失败 0）。sockaddr
    // 布局（含平台 family 字节序）全部在 C 端填充，不进 stdlib。
    [DllImport("crt", EntryPoint = "zan_io_resolve_sa")]
    private static extern int NativeResolveSockAddr(string name, int port, byte[] buf, int cap);

    // 每个候选固定 32 字节：前 16/28 字节是 native sockaddr，余下清零。
    [DllImport("crt", EntryPoint = "zan_io_resolve_all")]
    private static extern int NativeResolveAll(string name, int port, byte[] buf, int cap);

    // await native extern 只能安全跨挂起传递标量；把托管对象转换为其
    // 原始地址后调用 C worker ABI，结果仍回到当前 async frame。
    [DllImport("crt", EntryPoint = "zan_io_resolve_all_async")]
    private static extern long NativeResolveAllAsync(nint name, int port, nint buf, int cap);

    [DllImport("crt", EntryPoint = "zan_io_sockaddr_family")]
    private static extern int NativeSockAddrFamily(nint sa, int len);

    [DllImport("crt", EntryPoint = "zan_io_sockaddr_is_safe")]
    private static extern int NativeSockAddrIsSafe(nint sa, int len,
                                           int allowLoopback);

    [DllImport("crt", EntryPoint = "zan_io_sockaddr_is_safe_ex")]
    private static extern int NativeSockAddrIsSafeEx(nint sa, int len,
                                           int allowLoopback, int allowPrivate);

    [DllImport("crt", EntryPoint = "zan_io_connect_sa")]
    private static extern long NativeConnectSockAddr(nint sock, nint sa, int len,
                                             int timeoutMs);

    // 把 sockaddr 的地址部分格式化为文本（IPv4 点分 / IPv6 冒号十六进制）。
    // 注意：这两个 *_str 原生返回值按 ABI 是“采纳而非拷贝”，背后是
    // 线程共享缓冲——存进托管字符串后，同 worker 的下一次调用或
    // await 迁移都会让内容悄悄变化。跨 await 持有 IP 文本的代码
    // （WebApp、UDP 回信）必须走下面的 SockAddrIpText/RemoteIp 拷贝封装。
    [DllImport("crt", EntryPoint = "zan_io_sockaddr_ip_str")]
    private static extern string NativeSockAddrIp(byte[] sa);

    [DllImport("crt", EntryPoint = "zan_io_sockaddr_ip_str_into")]
    private static extern int NativeSockAddrIpInto(byte[] sa, nint buf, int cap);

    [DllImport("crt", EntryPoint = "zan_io_socket_peer_ip_into")]
    private static extern int NativePeerIpInto(nint sock, nint buf, int cap);

    // 从临时原生缓冲取出拷贝好的地址文本并释放缓冲。
    private static string IpTextFromNative(nint buf, int n) {
        if (n <= 0) { NativeMemory.Free(buf); return ""; }
        string s = NativeMemory.GetString(buf, 0, n);
        NativeMemory.Free(buf);
        return s;
    }

    // sockaddr → 地址文本（拷贝语义，可安全跨 await 持有）。
    private static string SockAddrIpText(byte[] sa) {
        nint buf = NativeMemory.Alloc(64);  // INET6_ADDRSTRLEN 上限
        if (buf == 0) { return ""; }
        return IpTextFromNative(buf, NativeSockAddrIpInto(sa, buf, 64));
    }

    [DllImport("crt")]
    private static extern long strlen(string str);


    // 用于带截止时限操作的单调时钟（与
    // Stopwatch 同源；声明在此处，套接字层就不依赖
    // System.Threading）。
    [DllImport("crt", EntryPoint = "zan_monotonic_us")]
    public static extern long NativeMonotonicUs();

    // 初始化套接字子系统（通过 PAL 平台层驱动）。
    public static void Initialize() {
        Pal.Network.Initialize();
    }

    // 清理套接字子系统。
    public static void Cleanup() {
        Pal.Network.Cleanup();
    }

    // 创建 TCP 套接字。
    public static nint CreateTcp() {
        nint s = Pal.Network.CreateTcpSocket(false);
        if (s < 0) { Socket.CaptureLastError(); }
        return s;
    }

    // 创建 IPv6 TCP 套接字（AF_INET6）。
    public static nint CreateTcp6() {
        nint s = Pal.Network.CreateTcpSocket(true);
        if (s < 0) { Socket.CaptureLastError(); }
        return s;
    }

    // 创建 UDP 套接字。
    public static nint CreateUdp() {
        nint s = Pal.Network.CreateUdpSocket(false);
        if (s < 0) { Socket.CaptureLastError(); }
        return s;
    }

    // 创建 IPv6 UDP 套接字（AF_INET6）。
    public static nint CreateUdp6() {
        nint s = Pal.Network.CreateUdpSocket(true);
        if (s < 0) { Socket.CaptureLastError(); }
        return s;
    }

    // 关闭套接字。
    public static void Close(nint sock) {
        ReactorCloseNotify(sock);  // 先摘 reactor 注册，再关描述符
        SysClose(sock);
    }

    // 唤醒/取消当前挂起的 IO，不 shutdown 或释放描述符。
    public static void CancelPendingIo(nint sock) {
        if (sock >= 0) { ReactorCloseNotify(sock); }
    }

    // 双向关闭已连接套接字但保留描述符，唤醒挂起的 IO。
    public static void ShutdownBoth(nint sock) {
        SysShutdown(sock, 2);  // SD_BOTH / SHUT_RDWR
        Pal.Network.CancelPendingIo(sock);
    }

    // 将套接字设为非阻塞模式。
    public static int SetNonBlocking(nint sock) {
        int rc = Pal.Network.SetNonBlocking(sock);
        if (rc != 0) { Socket.CaptureLastError(); }
        return rc;
    }

    // 在套接字上设置 SO_REUSEADDR。
    public static void SetReuseAddr(nint sock) {
        Pal.Network.SetReuseAddress(sock, true);
    }

    // 启用 SO_REUSEPORT（在支持的平台上设置端口复用，不支持的平台回退 SO_REUSEADDR）。
    public static void SetReusePort(nint sock) {
        Pal.Network.SetReusePort(sock, true);
    }

    // 在接受连接上禁用 Nagle 算法（TCP_NODELAY）。
    public static void SetNoDelay(nint sock) {
        Pal.Network.SetNoDelay(sock, true);
    }

    // 在套接字上启用 SO_BROADCAST。
    public static void SetBroadcast(nint sock) {
        Pal.Network.SetBroadcast(sock, true);
    }

    // 把主机名或 IP 文本（IPv4/IPv6）解析为完整的
    // sockaddr 字节（IPv4 16 字节 / IPv6 28 字节），供
    // connect/bind/sendto 使用。字面量 IP 和主机名统一由
    // getaddrinfo 处理（C 端按返回地址族填充 sockaddr，布局
    // 不进 stdlib）。"0.0.0.0"/空串仍走零地址快路径；解析失败
    // 时回退 0.0.0.0（旧行为，随后的 connect/bind 会报错）。
    // 返回的数组长度即 sockaddr 实际长度。
    private static byte[] BuildSockAddr(string ip, int port) {
        if (ip == "0.0.0.0" || ip == "") {
            return BuildSockAddrResolved(0, port);
        }
        byte[] addr = new byte[28];
        int len = Socket.NativeResolveSockAddr(ip, port, addr, 28);
        if (len == 28) { return addr; }
        if (len == 16) {
            byte[] v4 = new byte[16];
            for (int i = 0; i < 16; i = i + 1) { v4[i] = addr[i]; }
            return v4;
        }
        return BuildSockAddrResolved(0, port);
    }

    // 该地址是否为数值字面量（IPv4 点分十进制或含冒号的
    // IPv6），即无需 DNS 解析即可直接构建 sockaddr。
    private static bool IsNumericHost(string ip) {
        if (ip == "") { return false; }
        if (ip.IndexOf(":") >= 0) { return true; }
        if (InetAddr(ip) != 0 - 1) { return true; }
        return ip == "255.255.255.255";
    }

    // BuildSockAddr 的异步版本：主机名通过
    // <see cref="ResolveSockAddr"/> 在后台线程解析（不会阻塞
    // 事件循环），字面量 IP 走同步快路径。供 ConnectAsync /
    // SendToAsync 使用。
    private static async byte[] BuildSockAddrAsync(string ip, int port) {
        Socket.MarkResolveFailed(false);
        if (ip == "0.0.0.0" || ip == "") {
            Socket.MarkResolveFailed(true);
            return null;
        }
        if (Socket.IsNumericHost(ip)) {
            return Socket.BuildSockAddr(ip, port);
        }
        byte[] addr = new byte[28];
        int len = await Socket.ResolveSockAddr(ip, port, addr, 28);
        if (len == 28) { return addr; }
        if (len == 16) {
            byte[] v4 = new byte[16];
            for (int i = 0; i < 16; i = i + 1) { v4[i] = addr[i]; }
            return v4;
        }
        Socket.MarkResolveFailed(true);
        return null;
    }

    // 同步解析全部地址候选到调用方提供的固定缓冲区。
    // 每条记录占 32 字节，前 16/28 字节为 sockaddr，其余清零；返回
    // 候选数，失败返回 0。
    private static int ResolveAll(string host, int port, byte[] records) {
        if (host == "" || records == null) { return 0; }
        return Socket.NativeResolveAll(host, port, records, records.Length);
    }

    // 异步解析全部地址候选到调用方提供的固定缓冲区。返回候选
    // 数，失败返回 0；解析失败绝不伪造 0.0.0.0。
    public static async int ResolveAllAsync(string host, int port, byte[] records) {
        if (host == "" || records == null || records.Length < 32) { return 0; }
        #if WASI
        // wasm32：await 直接 extern 被编译器拒绝，且 zanrt_syncw.o 的
        // 桩本来就是同步失败——直接退桩，不进协程。
        return 0;
        #else
        // 跨异步边界前将托管值转换为稳定的裸内存地址，帧对象持有强引用。
        nint hostPtr = (nint)host;
        nint recordsPtr = (nint)records;
        long n = await Socket.NativeResolveAllAsync(hostPtr, port, recordsPtr,
                                                    records.Length);
        if (n <= 0) { return 0; }
        return (int)n;
        #endif
    }

    // 返回 sockaddr 记录的地址族常量（平台原生值）。
    internal static int SockAddrFamily(byte[] record, int len) {
        nint p = (nint)record;
        return Socket.NativeSockAddrFamily(p, len);
    }

    // 该 sockaddr 是否为可安全连接的常规地址（非未指定/组播）；
    // allowLoopback 决定环回地址是否放行，allowPrivate 决定私网/局域网地址是否放行。
    internal static bool SockAddrIsSafe(byte[] record, int len, bool allowLoopback) {
        return Socket.SockAddrIsSafe(record, len, allowLoopback, true);
    }

    internal static bool SockAddrIsSafe(byte[] record, int len, bool allowLoopback, bool allowPrivate) {
        nint p = (nint)record;
        return Socket.NativeSockAddrIsSafeEx(p, len,
            allowLoopback ? 1 : 0, allowPrivate ? 1 : 0) != 0;
    }

    // 该地址族常量是否为 IPv6（由平台抽象层区分平台取值）。
    internal static bool IsV6Family(int family) {
        return Pal.Network.IsIpv6Family(family);
    }

    // 对一个已经解析出的 sockaddr 做精确异步连接。仅传递
    // 二进制地址给 runtime，不会再次按主机名解析。
    public static async int ConnectSockAddrAsync(nint sock, byte[] record, int len,
                                          int timeoutMs) {
        #if WASI
        // wasm32：await 直接 extern 被编译器拒绝；连接本就不可能
        // 成功，直接报失败（-1）。
        return -1;
        #else
        nint p = (nint)record;
        // 底层非阻塞连接 ABI：在工作线程中等待连接建立并返回二进制地址。
        long r = await Socket.NativeConnectSockAddr(sock, p, len, timeoutMs);
        return (int)r;
        #endif
    }

    // 从已解析的 IPv4 整数地址构建 sockaddr_in（字节序与
    // <c>inet_addr</c> 一致）。供异步连接复用——由平台抽象层构建正确的平台 sockaddr 结构。
    private static byte[] BuildSockAddrResolved(int ipAddr, int port) {
        return Pal.Network.CreateSockAddrV4(ipAddr, port);
    }

    // 将套接字绑定到地址和端口。
    public static int Bind(nint sock, string ip, int port) {
        byte[] addr = BuildSockAddr(ip, port);
        int rc = SysBind(sock, addr, addr.Length);
        if (rc != 0) { Socket.CaptureLastError(); }
        return rc;
    }

    // 开始监听连接。
    public static int Listen(nint sock, int backlog) {
        int rc = SysListen(sock, backlog);
        if (rc != 0) { Socket.CaptureLastError(); }
        return rc;
    }

    // 同步接受连接。
    public static nint Accept(nint sock) {
        byte[] clientAddr = new byte[16];
        byte[] addrLen = new byte[4];
        addrLen[0] = 16;
        nint client = SysAccept(sock, clientAddr, addrLen);
        if (client < 0) { Socket.CaptureLastError(); }
        return client;
    }

    // 在 IO reactor 上等待并接受连接。监听套接字须非阻塞。
    // POSIX 只重试瞬时 accept 错误；已 shutdown 但仍分配的 fd 上
    // EINVAL 等终止错误直接返回 -1，不因 IsOpen 为真而空转。
    public static async nint AcceptAsync(nint sock) {
        return await Socket.AcceptAsync(sock, null);
    }

    // 可取消的 accept；取消/失败返回 -1。调用方必须保留
    // sock 到 await 完成，随后才能 close。取消通知重复唤醒以覆盖
    // 检查取消状态与 IO 注册之间的竞态；不会 shutdown 监听器。
    public static async nint AcceptAsync(nint sock, CancellationToken cancellation) {
        if (sock < 0 || (cancellation != null && cancellation.IsCancellationRequested)) { return -1; }
        SocketAcceptCancellation state = null;
        Timer timer = null;
        if (cancellation != null) {
            SocketAcceptCancellation callbackState = new SocketAcceptCancellation(sock, cancellation);
            state = callbackState;
            timer = new Timer(10, () => { callbackState.Check(); });
            if (!timer.Start()) {
                state.Finish();
                return -1;
            }
            state.Check();
        }
        try {
            if (cancellation != null && cancellation.IsCancellationRequested) { return -1; }
            if (Pal.Network.SupportsAsyncAcceptOv()) {
                nint client = await Socket.AcceptOv(sock);
                if (client >= 0 && cancellation != null && cancellation.IsCancellationRequested) {
                    Socket.Close(client);
                    return -1;
                }
                return client;
            } else {
                byte[] clientAddr = new byte[16];
                byte[] addrLen = new byte[4];
                while (true) {
                    if (cancellation != null && cancellation.IsCancellationRequested) { return -1; }
                    addrLen[0] = 16;
                    nint client = SysAccept(sock, clientAddr, addrLen);
                    if (client >= 0) {
                        if (cancellation != null && cancellation.IsCancellationRequested) {
                            Socket.Close(client);
                            return -1;
                        }
                        return client;
                    }
                    int error = Pal.Network.GetLastSocketError();
                    Socket.SetLastError(error);
                    if (!Socket.IsTransientAcceptError(error)) { return -1; }
                    if (error == 4) { continue; }  // EINTR: retry the interrupted syscall.
                    if (cancellation != null && cancellation.IsCancellationRequested) { return -1; }
                    await Socket.ReadReady(sock);
                    if (cancellation != null && cancellation.IsCancellationRequested) { return -1; }
                }
                return -1;
            }
        } finally {
            if (state != null) { state.Finish(); }
            if (timer != null) { await timer.StopAsync(); }
        }
    }

    public static bool IsTransientAcceptError(int error) {
        return Pal.Network.IsTransientAcceptError(error);
    }

    // 同步连接到远程地址。
    public static int Connect(nint sock, string ip, int port) {
        if (ip == "" || ip == "0.0.0.0") { return -1; }
        byte[] addr;
        if (Socket.IsNumericHost(ip)) {
            addr = BuildSockAddr(ip, port);
        } else {
            addr = new byte[28];
            int resolved = Socket.NativeResolveSockAddr(ip, port, addr, 28);
            if (resolved == 0) { return -1; }
            if (resolved == 16) {
                byte[] v4 = new byte[16];
                for (int i = 0; i < 16; i = i + 1) { v4[i] = addr[i]; }
                addr = v4;
            }
        }
        int rc = SysConnect(sock, addr, addr.Length);
        if (rc != 0) { Socket.CaptureLastError(); }
        return rc;
    }

    // 发起非阻塞连接，然后在 IO reactor 上挂起
    // 直到连接确定。成功返回 0，失败返回非零错误
    // 码（SO_ERROR，如拒绝/不可达；无错误码时为 -1）
    // 。要求套接字为非阻塞。
    // reactor 的可写就绪唤醒可能早于挂起的连接
    // 确定（尤其是 Windows，零字节发送探测会提前完成，
    // 连接失败通过异常集合报告），因此
    // 每次唤醒后用 ConnectStatus 检查结果，仍在进行中时
    // 稍作延迟再轮询。
    // 把 IP 文本解析为 sockaddr 用的 IPv4 整数地址
    // （0.0.0.0/空串 → 0）。字面量 IP 直接用 inet_addr；
    // 主机名通过异步 DNS 解析（<see cref="ResolveAsync"/>），
    // 在后台线程执行，不会阻塞事件循环。
    private static async int AsyncResolveIp(string ip) {
        if (ip == "0.0.0.0" || ip == "") {
            return 0;
        }
        int ipAddr = InetAddr(ip);
        if (ipAddr == 0 - 1) {
            ipAddr = await Socket.ResolveAsync(ip);
        }
        return ipAddr;
    }

    // 连接到 `ip:port`，默认截止 120 秒。针对黑洞地址无法唤醒 reactor
    // 的场景，与带超时的重载共用同一条退避轮询路径，超时返回 -3（套接字留给调用方关闭）。
    // 需要不同时限的调用方请用四参重载（timeoutMs <= 0 表示真正无截止）。
    public static async int ConnectAsync(nint sock, string ip, int port) {
        return await Socket.ConnectAsync(sock, ip, port, NetConstants.TimeoutLongConnectMs);
    }

    // 受 <paramref name="timeoutMs"/> 限制的 ConnectAsync：在时限内
    // 连接既未成功也未失败时返回 -3
    // （黑洞地址永远不唤醒 reactor，因此无超时重载
    // 会永远挂起）。非正超时表示"无
    // 截止时间"，转而使用 reactor 驱动的重载。
    // 连接挂起期间用 ConnectStatus 轮询结果，
    // 并递增延迟，而非等待可写就绪：reactor 唤醒
    // 无法取消，因此截止时间只能由本协程拥有的定时器
    // 观察。套接字留给调用方关闭。
    public static async int ConnectAsync(nint sock, string ip, int port, int timeoutMs) {
        byte[] addr = await Socket.BuildSockAddrAsync(ip, port);
        if (addr == null) {
            Socket.MarkResolveFailed(true);
            return -1;
        }
        int family = Socket.SockAddrFamily(addr, addr.Length);
        if (family == 0) { return -1; }
        return await Socket.ConnectSockAddrAsync(sock, addr,
            Socket.IsV6Family(family) ? 28 : 16, timeoutMs);
    }


    // 同步发送数据。
    public static int Send(nint sock, string data, int len) {
        return (int)ReactorSend(sock, data, len, 0);
    }

    // 挂起直到可写，然后发送；部分写入时重新等待，
    // 直到 <paramref name="len"/> 字节全部发送或对端关闭。
    // 返回已发送字节数。要求套接字为非阻塞。
    // 二进制安全：未发送的剩余部分放在独立缓冲区中重建，
    // 用下标拷贝而非 <c>data + totalSent</c> 指针运算。在
    // 字符串上这会变成拼接，并在第一个 NUL
    // 字节处截断，损坏任何含 NUL 的负载（如 MQTT 包）。
    // 急切发送：先尝试非阻塞发送，仅在套接字会阻塞时
    // 才等待 reactor（部分写入 / 发送缓冲区已满）
    // 。不拥塞的套接字上，整个负载一次系统调用即发出
    // 且无需挂起，省去每条消息一次 reactor 往返。
    public static async int SendAsync(nint sock, string data, int len) {
        int totalSent = 0;
        while (totalSent < len) {
            int sent = (int)ReactorSendPtr(sock, (nint)data + (nint)totalSent, (long)(len - totalSent), 0);
            if (sent > 0) {
                totalSent = totalSent + sent;
            } else if (sent == 0) {
                return totalSent;
            } else if (sent == -1) {
                // 会阻塞：等待套接字可写后重试。
                await Socket.WriteReady(sock);
            } else {
                // 致命错误（对端重置/中止、broken pipe 等）。
                return totalSent;
            }
        }
        return totalSent;
    }

    // 异步发送字节数组切片。零堆内存分配与零额外拷贝。
    public static async int SendAsync(nint sock, byte[] data, int len) {
        return await Socket.SendBytesAsync(sock, data, 0, len);
    }

    // 异步发送字节数组指定偏移和长度的切片。零堆内存分配与零额外拷贝。
    public static async int SendBytesAsync(nint sock, byte[] data, int offset, int len) {
        if (data == null || offset < 0 || len <= 0 || offset + len > data.Length) { return 0; }
        int totalSent = 0;
        while (totalSent < len) {
            int sent = (int)ReactorSendPtr(sock, (nint)data + (nint)offset + (nint)totalSent, (long)(len - totalSent), 0);
            if (sent > 0) {
                totalSent = totalSent + sent;
            } else if (sent == 0) {
                return totalSent;
            } else if (sent == -1) {
                await Socket.WriteReady(sock);
            } else {
                return totalSent;
            }
        }
        return totalSent;
    }

    // 异步发送裸内存指针区域。零堆分配与零内存拷贝。
    public static async int SendPtrAsync(nint sock, nint ptr, int len) {
        if (ptr == (nint)0 || len <= 0) { return 0; }
        int totalSent = 0;
        while (totalSent < len) {
            int sent = (int)ReactorSendPtr(sock, ptr + (nint)totalSent, (long)(len - totalSent), 0);
            if (sent > 0) {
                totalSent = totalSent + sent;
            } else if (sent == 0) {
                return totalSent;
            } else if (sent == -1) {
                await Socket.WriteReady(sock);
            } else {
                return totalSent;
            }
        }
        return totalSent;
    }

    // 异步发送 StringView 视图。零堆分配与零内存拷贝。
    public static async int SendViewAsync(nint sock, StringView view) {
        return await Socket.SendPtrAsync(sock, view.ptr, view.length);
    }

    // 发送字符串（自动计算长度）。
    public static int SendString(nint sock, string data) {
        int len = (int)strlen(data);
        return Send(sock, data, len);
    }

    // 异步发送整串字符串（长度由 strlen 计算）。
    public static async int SendStringAsync(nint sock, string data) {
        int len = (int)strlen(data);
        int r = await SendAsync(sock, data, len);
        return r;
    }

    // 同步接收数据。
    public static int Recv(nint sock, string buf, int bufSize) {
        return (int)ReactorRecv(sock, buf, bufSize, 0);
    }

    // 异步接收数据到字节数组，避免中间字符串分配与拷贝。正常读到返回实际字节数，对端关闭返回 0。
    public static async int RecvBytesAsync(nint sock, byte[] buf, int maxLen) {
        if (buf == null || maxLen <= 0) { return 0; }
        int n = await Socket.RecvOv(sock, buf, maxLen);
        if (n < 0) { return 0; }
        return n;
    }

    // 异步接收数据到字节数组，受 timeoutMs 限制。在 IO reactor 上挂起直到有数据到达或超时。
    // 超时返回 -1；对端关闭返回 0；正常返回读取字节数。
    public static async int RecvBytesAsync(nint sock, byte[] buf, int maxLen, int timeoutMs) {
        if (buf == null || maxLen <= 0) { return 0; }
        if (timeoutMs <= 0) {
            return await Socket.RecvBytesAsync(sock, buf, maxLen);
        }
        int n = await Socket.RecvToOv(sock, buf, maxLen, timeoutMs);
        if (n < 0) {
            Socket.MarkRecvTimeout(true);
            return -1;
        }
        Socket.MarkRecvTimeout(false);
        return n;
    }

    // 异步接收数据到裸指针内存，零中间字符串与零额外拷贝。正常读到返回实际字节数，对端关闭返回 0。
    public static async int RecvPtrAsync(nint sock, nint ptr, int maxLen) {
        if (ptr == (nint)0 || maxLen <= 0) { return 0; }
        int n = await Socket.RecvOv(sock, ptr, maxLen);
        if (n < 0) { return 0; }
        return n;
    }

    // 在 IO reactor 上挂起直到可读，然后最多接收
    // <paramref name="bufSize"/> 字节。返回以 NUL 结尾的
    // 字符串（对端关闭/EOF 时为空）。需要非阻塞套接字。
    public static async string RecvAsync(nint sock, int bufSize) {
        byte[] buf = new byte[bufSize + 1];
        // 使用真正的重叠接收（RecvOv），而非可读性探测
        // 加同步 recv。零字节的 WSARecv 可读性探测可能在
        // 无数据等待时就立即完成，使 ReadReady + ReactorRecv
        // 误把 WSAEWOULDBLOCK 当作对端关闭，在对端数据
        // 尚未到达时就返回空。RecvOv 向 buf 投递真正的 WSARecv，
        // 只有读到数据（或对端关闭）时才完成。
        int n = await Socket.RecvOv(sock, buf, bufSize);
        if (n < 0) { n = 0; }
        return buf.ToStr(0, n);
    }

    // 受 <paramref name="timeoutMs"/> 限制的 RecvAsync：时限内
    // 没有数据到达时返回空串（用 LastRecvTimedOut 与对端关闭区分）。
    // 非正超时表示"不设截止时间"，转而使用 reactor 驱动的重载。
    // RecvToOv 把真正的接收与截止时间一起交给 reactor 竞速：谁先到
    // 谁交付（数据/对端关闭交付字节数，超时交付 -1），接收胜出时
    // reactor 自己撤掉截止时间，超时胜出时撤掉在途接收。纯事件驱动
    // ——挂起的协程不再按 1→16ms 周期生成轮询帧，高并发突发下就绪
    // 队列不再被灌爆。
    public static async string RecvAsync(nint sock, int bufSize, int timeoutMs) {
        if (timeoutMs <= 0) {
            string plain = await Socket.RecvAsync(sock, bufSize);
            return plain;
        }
        byte[] buf = new byte[bufSize + 1];
        int n = await Socket.RecvToOv(sock, buf, bufSize, timeoutMs);
        if (n < 0) {
            // 截止时间到了：撤收。-1 只在超时分支出现，不会混入 0（对端关闭）。
            Socket.MarkRecvTimeout(true);
            return "";
        }
        Socket.MarkRecvTimeout(false);
        return buf.ToStr(0, n);
    }

    // 本协程最近一次带超时的接收是因超时放弃、而非对端
    // 关闭时为 true。通过同步辅助函数写入，因为在 async 方法内给
    // 静态变量赋值会被按值捕获。
    public static bool LastRecvTimedOut() {
        if (Socket.tlRecvTimedOut == null) { return false; }
        return Socket.tlRecvTimedOut.Value;
    }

    private static ThreadLocal<bool> tlRecvTimedOut = new ThreadLocal<bool>();

    // 更新 LastRecvTimedOut 报告的标志（见带超时 RecvAsync）。
    private static void MarkRecvTimeout(bool timedOut) {
        if (Socket.tlRecvTimedOut != null) {
            Socket.tlRecvTimedOut.Value = timedOut;
        }
    }

    // 挂起直到可读，然后最多接收 <paramref
    // name="bufSize"/> 字节到调用方提供的缓冲区，在接收
    // 字节数处补 NUL。返回读取的字节数（对端关闭时为 0）。让
    // keep-alive 连接在多个请求间复用同一个缓冲区，而不是
    // 每个请求都重新分配并清零一块（最大 64KB）缓冲区。
    public static async int RecvIntoAsync(nint sock, string buf, int bufSize) {
        int n = await Socket.RecvOv(sock, buf, bufSize);
        if (n > 0) {
            buf[n] = 0;
            return n;
        }
        buf[0] = 0;
        return 0;
    }

    // 接收数据到缓冲区（返回字符串）。
    public static string Receive(nint sock, int bufSize) {
        byte[] buf = new byte[bufSize + 1];
        int n = Recv(sock, buf, bufSize);
        if (n < 0) { n = 0; }
        return buf.ToStr(0, n);
    }

    // 发送一个 UDP 数据报（同步解析地址，含 IPv6）。
    public static int SendTo(nint sock, string data, int len, string ip, int port) {
        byte[] addr = BuildSockAddr(ip, port);
        return SysSendTo(sock, data, len, 0, addr, addr.Length);
    }

    // 挂起直到可写，然后发送一个 UDP 数据报。需要
    // 非阻塞套接字。主机名通过异步 DNS 解析（<see
    // cref="BuildSockAddrAsync"/>），不会阻塞事件循环。
    public static async int SendToAsync(nint sock, string data, int len, string ip, int port) {
        byte[] addr = await Socket.BuildSockAddrAsync(ip, port);
        if (addr == null) { return -1; }
        await Socket.WriteReady(sock);
        return SysSendTo(sock, data, len, 0, addr, addr.Length);
    }

    // 接收一个 UDP 数据报。
    public static string RecvFrom(nint sock, int bufSize) {
        byte[] buf = new byte[bufSize + 1];
        // 32 字节缓冲容纳 sockaddr_storage：IPv6 对端地址是
        // 28 字节 sockaddr_in6，16 字节的 sockaddr_in 缓冲会被
        // recvfrom 写穿（堆损坏）。
        byte[] fromAddr = new byte[32];
        byte[] fromLen = new byte[4];
        fromLen[0] = 32;
        int n = SysRecvFrom(sock, buf, bufSize, 0, fromAddr, fromLen);
        // recvfrom 是 ws2_32 的原始导入，返回 C `int`；-1 错误会
        // 以 0xFFFFFFFF 零扩展返回。对低 32 位做符号归一化，使
        // 下面的错误检查能看到真正的负数而不是约 4G（否则会让
        // Substring 复制远超缓冲区——造成堆损坏）。
        if (n > 2147483647) { n = n - 4294967296; }
        if (n < 0 && Pal.Network.IsUdpResetError(Pal.Network.GetLastSocketError())) {
            n = SysRecvFrom(sock, buf, bufSize, 0, fromAddr, fromLen);
            if (n > 2147483647) { n = n - 4294967296; }
        }
        if (n < 0) { n = 0; }
        return buf.ToStr(0, n);
    }

    // 接收 UDP 数据报到调用方提供的缓冲区，返回
    // 字节数（出错/无数据时为 0）。用于二进制数据报：
    // 字符串版本用 strlen 计算长度，会在第一个 NUL
    // 字节处截断。
    public static int RecvFromInto(nint sock, byte[] buf, int bufSize) {
        byte[] fromAddr = new byte[32];
        byte[] fromLen = new byte[4];
        fromLen[0] = 32;
        int n = SysRecvFrom(sock, buf, bufSize, 0, fromAddr, fromLen);
        // 对低 32 位做符号归一化（见 RecvFrom）。
        if (n > 2147483647) { n = n - 4294967296; }
        if (n < 0 && Pal.Network.IsUdpResetError(Pal.Network.GetLastSocketError())) {
            n = SysRecvFrom(sock, buf, bufSize, 0, fromAddr, fromLen);
            if (n > 2147483647) { n = n - 4294967296; }
        }
        if (n < 0) { n = 0; }
        if (n > 0) {
            int port = ((fromAddr[2] & 255) << 8) + (fromAddr[3] & 255);
            string ip = Socket.SockAddrIpText(fromAddr);
            Socket.SetLastPeer(ip, port);
        } else {
            Socket.SetLastPeer("", 0);
        }
        return n;
    }

    // 在 IO reactor 上挂起直到有数据报可用，然后
    // 接收数据报。需要非阻塞套接字。
    public static async string RecvFromAsync(nint sock, int bufSize) {
        await Socket.ReadReady(sock);
        string result = RecvFrom(sock, bufSize);
        return result;
    }

    // 最近一次 RecvFromPeer/RecvFromPeerAsync 收到数据报的发送方地址。
    // 采用 ThreadLocal 隔离，杜绝跨线程/跨协程串流。
    private static ThreadLocal<string> tlLastPeerIp = new ThreadLocal<string>();
    private static ThreadLocal<int> tlLastPeerPort = new ThreadLocal<int>();

    private static void SetLastPeer(string ip, int port) {
        if (Socket.tlLastPeerIp != null) { Socket.tlLastPeerIp.Value = ip; }
        if (Socket.tlLastPeerPort != null) { Socket.tlLastPeerPort.Value = port; }
    }

    // 最近一次通过 RecvFromPeer / RecvFromPeerAsync
    // 收到数据报的发送方 IPv4/IPv6 地址。
    public static string PeerIp() {
        if (Socket.tlLastPeerIp == null) { return ""; }
        string ip = Socket.tlLastPeerIp.Value;
        return ip != null ? ip : "";
    }

    // 最近一次通过 RecvFromPeer / RecvFromPeerAsync
    // 收到数据报的发送方 UDP 端口。
    public static int PeerPort() {
        if (Socket.tlLastPeerPort == null) { return 0; }
        return Socket.tlLastPeerPort.Value;
    }

    // 接收一个 UDP 数据报并记录发送方地址，以便
    // 服务器回信（见 PeerIp/PeerPort）。返回负载（出错/关闭时
    // 为空 ""）。
    public static string RecvFromPeer(nint sock, int bufSize) {
        byte[] buf = new byte[bufSize + 1];
        // 32 字节容纳 sockaddr_in6（28 字节）；IPv6 对端地址
        // 会让 16 字节缓冲被 recvfrom 写穿。
        byte[] fromAddr = new byte[32];
        byte[] fromLen = new byte[4];
        fromLen[0] = 32;
        int n = SysRecvFrom(sock, buf, bufSize, 0, fromAddr, fromLen);
        // 对低 32 位做符号归一化（见 RecvFrom）。
        if (n > 2147483647) { n = n - 4294967296; }
        if (n < 0) { n = 0; }
        if (n > 0) {
            // 端口在 sockaddr_in / sockaddr_in6 的同一偏移（2），
            // 均为网络字节序；地址文本由 C 端按族格式化。
            int port = ((fromAddr[2] & 255) << 8) + (fromAddr[3] & 255);
            string ip = Socket.SockAddrIpText(fromAddr);
            Socket.SetLastPeer(ip, port);
        } else {
            Socket.SetLastPeer("", 0);
        }
        return buf.ToStr(0, n);
    }

    // 挂起直到数据报到达，接收并记录
    // 发送方地址（见 PeerIp/PeerPort）。需要非阻塞套接字。
    public static async string RecvFromPeerAsync(nint sock, int bufSize) {
        await Socket.ReadReady(sock);
        string result = RecvFromPeer(sock, bufSize);
        return result;
    }

    // 将主机名解析为 IPv4 地址，字节序与
    // <c>inet_addr</c> 一致（第一段在低字节），无法
    // 解析时返回 0。通过运行时 C shim 调用 gethostbyname/AF_INET，
    // 避免在 Zan 代码中硬编码 hostent 布局。
    public static int ResolveIpv4(string hostname) {
        return Socket.NativeResolveIpv4(hostname);
    }

    // 异步将主机名解析为 IPv4 地址（返回值与
    // <see cref="ResolveIpv4"/> 相同：0 表示失败）。解析在
    // 后台线程执行，协程在 IO reactor 上挂起直到完成，不会
    // 阻塞事件循环——ConnectAsync 用它替代同步解析。
    [Intrinsic]
    public static async int ResolveAsync(string hostname) {
        return await Socket.ResolveAsync(hostname);
    }

    // 将主机名解析为 IP 地址。若无法解析则返回 ""；
    // 否则返回原主机名。
    private static string Resolve(string hostname) {
        if (Socket.NativeResolveIpv4(hostname) == 0) { return ""; }
        return hostname;
    }

    // 远端 IP 地址文本。拷贝语义：返回的托管字符串拥有自己的
    // 字节，不受线程共享格式化缓冲或 await 后协程迁移的影响
    // （此前直接采纳原生指针，WebApp 存下 ctx.RemoteIp 后会被
    // 下一个连接的调用悄悄改写——限流键因此被污染）。
    public static string RemoteIp(nint sock) {
        nint buf = NativeMemory.Alloc(64);  // INET6_ADDRSTRLEN 上限
        if (buf == 0) { return ""; }
        return IpTextFromNative(buf, NativePeerIpInto(sock, buf, 64));
    }

    // 最近一次失败的套接字系统调用的平台错误码：
    // Windows 的 WSAGetLastError，POSIX 的 errno。供失败路径
    // 构造诊断信息——之前 CreateTcp/Bind/Listen 的失败
    // 被静默吞掉，调用方只知道操作失败了。
    public static int LastSocketError() {
        if (Socket.tlLastError == null) { return 0; }
        return Socket.tlLastError.Value;
    }

    // WSAGetLastError / errno 是线程局部的，且会被任何后续
    // FFI 调用覆盖——哪怕是一次成功的 closesocket 也会清零。
    // 失败路径往往在读取错误码之前还要关闭 fd 清理资源，因此
    // 错误码必须在失败检查点（上述调用返回失败时）立即捕获，
    // 而不是事后查询。LastSocketError() 返回的就是这个缓存。
    // 采用 ThreadLocal 严格隔离各线程/协程错误状态。
    private static ThreadLocal<int> tlLastError = new ThreadLocal<int>();
    private static ThreadLocal<bool> tlResolveFailed = new ThreadLocal<bool>();

    // 失败检查点处立即捕获平台错误码（见 lastError 上的说明）。
    public static void CaptureLastError() {
        if (Socket.tlLastError != null) {
            Socket.tlLastError.Value = Pal.Network.GetLastSocketError();
        }
    }

    public static void SetLastError(int error) {
        if (Socket.tlLastError != null) {
            Socket.tlLastError.Value = error;
        }
    }

    // 最近一次解析是否失败（BuildSockAddrAsync / ConnectAsync 置位）。
    private static bool LastResolveFailed() {
        if (Socket.tlResolveFailed == null) { return false; }
        return Socket.tlResolveFailed.Value;
    }

    // 更新 LastResolveFailed 报告的标志。
    private static void MarkResolveFailed(bool failed) {
        if (Socket.tlResolveFailed != null) {
            Socket.tlResolveFailed.Value = failed;
        }
    }

    // IPv4 文本 → 整数（字节序与 <c>inet_addr</c> 一致，第一段在低
    // 字节），再按点分十进制的高位在前重排为 0..4294967295；
    // 解析失败返回 -1（255.255.255.255 例外，inet_addr 对它返回 -1
    // 但它是合法地址）。
    public static long Ipv4ToLong(string ip) {
        int address = InetAddr(ip);
        if (address == 0 - 1 && ip != "255.255.255.255") { return -1; }
        return (long)(address & 255) * 16777216
            + (long)((address >> 8) & 255) * 65536
            + (long)((address >> 16) & 255) * 256
            + (long)((address >> 24) & 255);
    }

    // Ipv4ToLong 的逆变换：0..4294967295 → 点分十进制；越界返回 ""。
    public static string LongToIpv4(long ipValue) {
        if (ipValue < 0 || ipValue > 4294967295) { return ""; }
        return Convert.ToString((ipValue >> 24) & 255) + "."
            + Convert.ToString((ipValue >> 16) & 255) + "."
            + Convert.ToString((ipValue >> 8) & 255) + "."
            + Convert.ToString(ipValue & 255);
    }

    // 套接字是否仍然存活；false 表示
    // 已被关闭（例如监听器被 Stop() 关闭）。
    public static bool IsOpen(nint sock) {
        return SocketAlive(sock) != 0;
    }

    // 用 select() 以零超时检查套接字是否可读。
    public static bool IsReadable(nint sock) {
        return ReactorReady(sock, 0) > 0;
    }

    // 用 select() 以零超时检查套接字是否可写。
    public static bool IsWritable(nint sock) {
        return ReactorReady(sock, 1) > 0;
    }
}
