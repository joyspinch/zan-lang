using System;
using System.Net.Sockets;

namespace System.Net;

// IP 地址工具与基础验证防线（RFC 791 IPv4 / RFC 4291 IPv6）。
public class IPAddress {
    public static const string Any          = "0.0.0.0";
    public static const string Loopback     = "127.0.0.1";
    public static const string Broadcast    = "255.255.255.255";
    public static const string IPv6Any      = "::";
    public static const string IPv6Loopback = "::1";

    // 检查字符串是否为严格的点分十进制 IPv4 地址（RFC 791 / RFC 1123）。
    // 强制四段校验（每段 0..255），禁止前导零（防八进制歧义混淆攻击），
    // 杜绝空段、连续点号与超出范围的伪 IP。
    public static bool IsIPv4(string str) {
        if (str == null || str.Length < 7 || str.Length > 15) { return false; }
        int part = 0;
        int octet = 0;
        int digits = 0;
        int len = str.Length;
        for (int i = 0; i <= len; i = i + 1) {
            bool atEnd = (i == len);
            int c = atEnd ? 46 : (str[i] & 255);
            if (c == 46) { // '.'
                if (digits == 0 || octet > 255 || part > 3) { return false; }
                part = part + 1;
                octet = 0;
                digits = 0;
            } else {
                if (c < 48 || c > 57 || digits >= 3) { return false; }
                // 禁止非零多位数带前导 0 (防八进制混淆解析)
                if (digits > 0 && octet == 0) { return false; }
                octet = octet * 10 + (c - 48);
                digits = digits + 1;
            }
        }
        return part == 4;
    }

    // 检查字符串是否为规范的 IPv6 地址格式（RFC 4291 / RFC 5952）。
    // 支持标准 8 组 16 进制、单次 "::" 零压缩表示法。
    public static bool IsIPv6(string str) {
        if (str == null || str.Length < 2 || str.Length > 39) { return false; }
        int colonCount = 0;
        int doubleColon = -1;
        int groupDigits = 0;
        int groups = 0;
        int len = str.Length;

        // 查找 "::" 压缩与非法三冒号 ":::"
        if (str.IndexOf(":::", 0) >= 0) { return false; }
        int dcIdx = str.IndexOf("::", 0);
        if (dcIdx >= 0) {
            // 不能出现多个 "::"
            if (str.IndexOf("::", dcIdx + 2) >= 0) { return false; }
            doubleColon = dcIdx;
        }

        // 逐字符校验：仅允许 16 进制字符和 ':'
        for (int i = 0; i <= len; i = i + 1) {
            bool atEnd = (i == len);
            int c = atEnd ? 58 : (str[i] & 255);
            if (c == 58) { // ':'
                colonCount = colonCount + 1;
                if (groupDigits > 0) {
                    groups = groups + 1;
                    groupDigits = 0;
                }
            } else {
                bool isHex = (c >= 48 && c <= 57) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102);
                if (!isHex || groupDigits >= 4) { return false; }
                groupDigits = groupDigits + 1;
            }
        }

        if (doubleColon >= 0) {
            // 有 "::" 压缩，组数必须小于等于 7
            return groups <= 7;
        } else {
            // 无 "::" 压缩，必须恰好 8 组、7 个分隔冒号（加上结尾哨兵共 8 次）
            return groups == 8 && colonCount == 8;
        }
    }

    // 检查 IP 是否为本地环回地址（127.0.0.0/8 或 ::1）。
    public static bool IsLoopback(string ip) {
        if (ip == null || ip.Length == 0) { return false; }
        if (ip == "::1" || ip == "0:0:0:0:0:0:0:1") { return true; }
        if (ip.StartsWith("127.")) {
            return IPAddress.IsIPv4(ip);
        }
        return false;
    }
}
