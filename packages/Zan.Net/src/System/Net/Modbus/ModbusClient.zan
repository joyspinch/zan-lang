using System;
using System.Net.Sockets;
using System.Threading;
using System.Collections.Generic;

namespace System.Net.Modbus;

// Modbus TCP 客户端（默认端口 502，协程友好）：按 MBAP 长度前缀重组帧并串行化单连接事务。
// 寄存器值为 16 位（0..65535），地址为基于 0 的协议地址（"40001" 对应 0）。
public class ModbusClient : IDisposable {
    private TcpClient conn;
    private int unitId;
    private int nextTid;
    private bool connected;
    private bool closed;
    private bool busy;
    private Queue<AsyncGate> waiters;
    private string lastError;

    // 构造
    public ModbusClient() {
        this.unitId = 1;
        this.nextTid = 1;
        this.connected = false;
        this.closed = false;
        this.busy = false;
        this.waiters = new Queue<AsyncGate>();
        this.lastError = "";
    }

    // 连接 Modbus TCP 端点（unit 为单元/从站 id，直连 TCP 设备通常为 1）。
    public static async ModbusClient ConnectAsync(string host, int port, int unit) {
        ModbusClient m = new ModbusClient();
        m.unitId = unit;
        m.conn = await TcpClient.ConnectAsync(host, port);
        if (m.conn != null) { m.connected = true; }
        return m;
    }

    // 连接是否仍可用（对端关闭或帧错误后为 false）。
    public bool IsConnected() { return this.connected; }

    // 上一次交换的失败原因（成功时为 ""）。
    public string LastError() { return this.lastError; }

    // 关闭连接并安全唤醒所有排队等待的协程（幂等）。
    // 不在此处提前清 busy：仍在执行中的事务会在 finally 释放，唤醒的等待者见 closed=true 后直接退出。
    public void Close() {
        TcpClient c = null;
        lock (this) {
            this.closed = true;
            this.connected = false;
            c = this.conn;
            this.conn = null;
            while (this.waiters != null && this.waiters.Count() > 0) {
                AsyncGate g = this.waiters.Dequeue();
                g.Signal();
            }
        }
        if (c != null) { c.Close(); }
    }

    // 实现 IDisposable 接口，释放网络与等待门资源。
    public void Dispose() {
        this.Close();
    }

    // 跨多次 recv 精确读取 need 字节；对端关闭或出错时置 connected=false 并返回已读缓冲。
    private async byte[] ReadBytesAsync(int need) {
        if (need <= 0) { return new byte[1]; }
        byte[] buf = new byte[need + 1];
        byte[] tmp = new byte[need + 1];
        nint sock = this.conn.GetSocket();
        int got = 0;
        while (got < need) {
            await Socket.ReadReady(sock);
            int n = Socket.Recv(sock, tmp, need - got);
            if (n == -1) {
                // EWOULDBLOCK / 虚假就绪，继续等待
                continue;
            }
            if (n <= 0) {
                this.connected = false;
                return buf;
            }
            NativeMemory.Copy((nint)buf + (nint)got, (nint)tmp, n);
            got = got + n;
        }
        return buf;
    }

    private async bool AcquireLock() {
        AsyncGate g = null;
        lock (this) {
            if (this.closed || !this.connected) { return false; }
            if (!this.busy) {
                this.busy = true;
                return true;
            }
            g = new AsyncGate();
            if (this.waiters == null) { this.waiters = new Queue<AsyncGate>(); }
            this.waiters.Enqueue(g);
        }
        await g.Wait();
        g.Close();
        lock (this) {
            if (this.closed || !this.connected) {
                if (this.waiters != null && this.waiters.Count() > 0) {
                    AsyncGate next = this.waiters.Dequeue();
                    next.Signal();
                } else if (!this.closed) {
                    this.busy = false;
                }
                return false;
            }
        }
        return true;
    }

    private void ReleaseLock() {
        lock (this) {
            if (!this.closed && this.waiters != null && this.waiters.Count() > 0) {
                AsyncGate g = this.waiters.Dequeue();
                g.Signal();
            } else {
                this.busy = false;
            }
        }
    }

    // 互斥串行化的请求/响应往返（发送 MBAP + PDU，接收应答 PDU）。
    private async byte[] TransactAsync(byte[] pdu, int pduLen) {
        if (!await this.AcquireLock()) {
            return this.FailFrame("connection closed", false);
        }
        try {
            return await this.TransactInternalAsync(pdu, pduLen);
        } finally {
            this.ReleaseLock();
        }
    }

    private byte[] FailFrame(string err, bool disconnect) {
        this.lastError = err;
        if (disconnect) { this.connected = false; }
        return new byte[1];
    }

    private async byte[] TransactInternalAsync(byte[] pdu, int pduLen) {
        this.lastError = "";
        if (!this.connected) {
            return this.FailFrame("not connected", false);
        }
        int tid = this.nextTid & 65535;
        this.nextTid = (this.nextTid % 65535) + 1;

        byte[] req = new byte[7 + pduLen];
        req[0] = (byte)((tid >> 8) & 255);
        req[1] = (byte)(tid & 255);
        req[2] = 0;                              // 协议标识
        req[3] = 0;
        req[4] = (byte)(((pduLen + 1) >> 8) & 255);
        req[5] = (byte)((pduLen + 1) & 255);
        req[6] = (byte)(this.unitId);
        if (pduLen > 0) {
            NativeMemory.Copy((nint)req + (nint)7, (nint)pdu, pduLen);
        }
        int _s = await this.conn.SendBytesAsync(req, 7 + pduLen);

        byte[] mbap = await ReadBytesAsync(7);
        if (!this.connected) {
            return this.FailFrame("connection closed", false);
        }
        int respTid = ((mbap[0] & 255) << 8) + (mbap[1] & 255);
        if (respTid != tid) {
            return this.FailFrame("transaction id mismatch", true);
        }
        int proto = ((mbap[2] & 255) << 8) + (mbap[3] & 255);
        if (proto != 0) {
            return this.FailFrame("bad protocol id", true);
        }
        int len = ((mbap[4] & 255) << 8) + (mbap[5] & 255);
        if (len < 2 || len > 260) {
            return this.FailFrame("bad frame length", true);
        }
        int respUnit = mbap[6] & 255;
        if (respUnit != this.unitId) {
            return this.FailFrame("unit id mismatch", true);
        }
        // MBAP 长度计入 unit id + PDU；unit id 已在 mbap[6] 读取。
        byte[] body = await ReadBytesAsync(len - 1);
        if (!this.connected) {
            return this.FailFrame("connection closed", false);
        }
        int expectedFc = pdu[0] & 255;
        int respFc = body[0] & 255;
        // body[0] 为功能码回显；0x80 位表示异常应答。
        if ((respFc & 128) != 0) {
            int exCode = len - 1 >= 2 ? (body[1] & 255) : 0;
            return this.FailFrame("exception code " + Convert.ToString(exCode), false);
        }
        if (respFc != expectedFc) {
            return this.FailFrame("function code mismatch", true);
        }
        byte[] outb = new byte[len];
        if (len > 1) {
            NativeMemory.Copy((nint)outb, (nint)body, len - 1);
        }
        return outb;
    }

    // 线圈（fc 1）与离散输入（fc 2）共用的读取器：
    // 每个位对应一个 0/1 int；失败时返回空列表（见 LastError）。
    private async List<int> ReadBitsAsync(int fc, int addr, int count) {
        byte[] pdu = new byte[5];
        pdu[0] = (byte)(fc);
        pdu[1] = (byte)((addr >> 8) & 255);
        pdu[2] = (byte)(addr & 255);
        pdu[3] = (byte)((count >> 8) & 255);
        pdu[4] = (byte)(count & 255);
        byte[] r = await TransactAsync(pdu, 5);
        List<int> vals = new List<int>();
        if (this.lastError.Length > 0 || r == null || r.Length < 2) { return vals; }
        int nBytes = r[1] & 255;
        int available = r.Length - 2;
        int validBytes = nBytes < available ? nBytes : available;
        for (int k = 0; k < count && (k / 8) < validBytes; k = k + 1) {
            int b = r[2 + k / 8] & 255;
            vals.Add((b >> (k % 8)) & 1);
        }
        return vals;
    }

    // 保持（fc 3）与输入（fc 4）寄存器共用的读取器：
    // 每个寄存器为 16 位大端值；失败时返回空列表（见 LastError）。
    private async List<int> ReadRegsAsync(int fc, int addr, int count) {
        byte[] pdu = new byte[5];
        pdu[0] = (byte)(fc);
        pdu[1] = (byte)((addr >> 8) & 255);
        pdu[2] = (byte)(addr & 255);
        pdu[3] = (byte)((count >> 8) & 255);
        pdu[4] = (byte)(count & 255);
        byte[] r = await TransactAsync(pdu, 5);
        List<int> vals = new List<int>();
        if (this.lastError.Length > 0 || r == null || r.Length < 2) { return vals; }
        int nBytes = r[1] & 255;
        int available = r.Length - 2;
        int validBytes = nBytes < available ? nBytes : available;
        for (int k = 0; k < count && (k * 2 + 1) < validBytes; k = k + 1) {
            vals.Add(((r[2 + k * 2] & 255) << 8) + (r[3 + k * 2] & 255));
        }
        return vals;
    }

    // 读取线圈（功能码 1）：每个线圈对应一个 0/1 int。
    public async List<int> ReadCoilsAsync(int addr, int count) {
        if (addr < 0 || addr > 65535 || count < 1 || count > 2000) {
            this.lastError = "invalid arguments";
            return new List<int>();
        }
        List<int> r = await ReadBitsAsync(1, addr, count);
        return r;
    }

    // 读取离散输入（功能码 2）：每个输入对应一个 0/1 int。
    public async List<int> ReadDiscreteAsync(int addr, int count) {
        if (addr < 0 || addr > 65535 || count < 1 || count > 2000) {
            this.lastError = "invalid arguments";
            return new List<int>();
        }
        List<int> r = await ReadBitsAsync(2, addr, count);
        return r;
    }

    // 读取保持寄存器（功能码 3）。
    public async List<int> ReadHoldingAsync(int addr, int count) {
        if (addr < 0 || addr > 65535 || count < 1 || count > 125) {
            this.lastError = "invalid arguments";
            return new List<int>();
        }
        List<int> r = await ReadRegsAsync(3, addr, count);
        return r;
    }

    // 读取输入寄存器（功能码 4）。
    public async List<int> ReadInputAsync(int addr, int count) {
        if (addr < 0 || addr > 65535 || count < 1 || count > 125) {
            this.lastError = "invalid arguments";
            return new List<int>();
        }
        List<int> r = await ReadRegsAsync(4, addr, count);
        return r;
    }

    // 写入单个线圈（功能码 5）。成功返回 1，失败返回 0
    // （详见 LastError）。
    public async int WriteCoilAsync(int addr, bool on) {
        if (addr < 0 || addr > 65535) {
            this.lastError = "invalid arguments";
            return 0;
        }
        byte[] pdu = new byte[5];
        pdu[0] = 5;
        pdu[1] = (byte)((addr >> 8) & 255);
        pdu[2] = (byte)(addr & 255);
        if (on) { pdu[3] = 255; } else { pdu[3] = 0; }
        pdu[4] = 0;
        byte[] _r = await TransactAsync(pdu, 5);
        if (this.lastError.Length > 0) { return 0; }
        return 1;
    }

    // 写入单个保持寄存器（功能码 6）。成功返回 1，
    // 失败返回 0（详见 LastError）。
    public async int WriteRegisterAsync(int addr, int val) {
        if (addr < 0 || addr > 65535 || val < 0 || val > 65535) {
            this.lastError = "invalid arguments";
            return 0;
        }
        byte[] pdu = new byte[5];
        pdu[0] = 6;
        pdu[1] = (byte)((addr >> 8) & 255);
        pdu[2] = (byte)(addr & 255);
        pdu[3] = (byte)((val >> 8) & 255);
        pdu[4] = (byte)(val & 255);
        byte[] _r = await TransactAsync(pdu, 5);
        if (this.lastError.Length > 0) { return 0; }
        return 1;
    }

    // 批量写入保持寄存器（功能码 16）。成功返回 1，
    // 失败返回 0（详见 LastError）。
    public async int WriteRegistersAsync(int addr, List<int> values) {
        if (values == null || values.Count < 1 || values.Count > 123 || addr < 0 || addr > 65535) {
            this.lastError = "invalid arguments";
            return 0;
        }
        int n = values.Count;
        byte[] pdu = new byte[6 + n * 2];
        pdu[0] = 16;
        pdu[1] = (byte)((addr >> 8) & 255);
        pdu[2] = (byte)(addr & 255);
        pdu[3] = (byte)((n >> 8) & 255);
        pdu[4] = (byte)(n & 255);
        pdu[5] = (byte)(n * 2);
        for (int i = 0; i < n; i = i + 1) {
            pdu[6 + i * 2] = (byte)((values[i] >> 8) & 255);
            pdu[7 + i * 2] = (byte)(values[i] & 255);
        }
        byte[] _r = await TransactAsync(pdu, 6 + n * 2);
        if (this.lastError.Length > 0) { return 0; }
        return 1;
    }

    // 批量写入线圈（功能码 15 / 0x0F，Modbus Application Protocol V1.1b3 §6.11）。
    // values 中每个元素非零表示线圈置 1 (ON)，0 表示置 0 (OFF)。
    // 成功返回 1，失败返回 0（详见 LastError）。
    public async int WriteCoilsAsync(int addr, List<int> values) {
        if (values == null || values.Count < 1 || values.Count > 1968 || addr < 0 || addr > 65535) {
            this.lastError = "invalid arguments";
            return 0;
        }
        int count = values.Count;
        int byteCount = (count + 7) / 8;
        byte[] pdu = new byte[6 + byteCount];
        pdu[0] = 15;
        pdu[1] = (byte)((addr >> 8) & 255);
        pdu[2] = (byte)(addr & 255);
        pdu[3] = (byte)((count >> 8) & 255);
        pdu[4] = (byte)(count & 255);
        pdu[5] = (byte)(byteCount & 255);
        for (int i = 0; i < byteCount; i = i + 1) {
            pdu[6 + i] = 0;
        }
        for (int i = 0; i < count; i = i + 1) {
            if (values[i] != 0) {
                int byteIdx = 6 + (i / 8);
                int bitOffset = i % 8;
                pdu[byteIdx] = (byte)((pdu[byteIdx] & 255) | (1 << bitOffset));
            }
        }
        byte[] _r = await TransactAsync(pdu, 6 + byteCount);
        if (this.lastError.Length > 0) { return 0; }
        return 1;
    }
}
