using System;
using System.Net.Mqtt;

namespace System.Net;

/// <summary>
/// MQTT 协议分片：把 mqtt 端口的连接交给内置
/// MqttBroker.Global() 处理，从 Worker.zan 外迁为独立类。应用调用一次
/// WorkerMqtt.Install() 本文件才进编译图（并连带拉入 Mqtt 全家——
/// broker + client 约 1300 行），纯 HTTP 服务不背 MQTT。mqtt 协议没有
/// 应用回调。槽反转与独立类（不写 partial Worker）的理由见
/// Worker.ProtoEntryFn 的文档。
/// </summary>
class WorkerMqtt {
    /// 核心契约与语义定义。
    /// 核心契约与语义定义。
    static void Install() {
        Worker.mqttEntry = WorkerMqtt.HandleMqtt;
        // 自动接入跨进程共享总线（多 Worker 进程模型下透明共享广播）
        MqttBroker.Global().EnableSharedBus("zan_mqtt_worker_bus");
    }

    /// <summary>进程退出前的拆卸入口：解除协议分片并停机/清空
    /// 进程级 broker。静态 mqttEntry 与 MqttBroker.inst 是泄漏
    /// 探测里的保持根，退出前需显式拆卸避免残留。</summary>
    static void Uninstall() {
        Worker.mqttEntry = null;
        MqttBroker.TeardownGlobal();
    }

    /// 把连接交给内置的 MqttBroker.Global() 处理。
    static async void HandleMqtt(Worker w, nint clientSock) {
        Worker.BumpStat();
        try {
            await MqttBroker.Global().HandleConnection(clientSock);
        } finally {
            w.DropConn();
        }
    }
}
