using System;
using System.Net.Sockets;
using System.Threading;

namespace System.Net.Coap;

// CoAP 方法/响应码（RFC 7252 第 12.1 节）。
public class CoapClient {
    public string host;
    public int port;
    int nextMsgId;
    // RFC 7252 默认值；SetTimeout 按比例调整初始 ACK 窗口。
    int ackTimeoutMs;
    int maxRetransmit;

    // 为一个 CoAP 端点创建客户端。
    public CoapClient(string host, int port) {
        this.host = host;
        this.port = port;
        this.nextMsgId = 1;
        this.ackTimeoutMs = 2000;
        this.maxRetransmit = 4;
    }

    // 设置初始 ACK 超时（每次重传翻倍）以及
    // 重传次数。最坏等待时间为 timeoutMs * (2^retries - 1)。
    public CoapClient SetTimeout(int timeoutMs, int retries) {
        if (timeoutMs > 0) { this.ackTimeoutMs = timeoutMs; }
        if (retries >= 0) { this.maxRetransmit = retries; }
        return this;
    }

    // GET 一个资源路径，如 "sensors/temp"。
    public async CoapResponse GetAsync(string path) {
        CoapResponse r = await RequestAsync(CoapCode.GET, path, "");
        return r;
    }

    // 向资源路径 POST 一个负载。
    public async CoapResponse PostAsync(string path, string payload) {
        CoapResponse r = await RequestAsync(CoapCode.POST, path, payload);
        return r;
    }

    // 向资源路径 PUT 一个负载。
    public async CoapResponse PutAsync(string path, string payload) {
        CoapResponse r = await RequestAsync(CoapCode.PUT, path, payload);
        return r;
    }

    // DELETE 一个资源路径。
    public async CoapResponse DeleteAsync(string path) {
        CoapResponse r = await RequestAsync(CoapCode.DELETE, path, "");
        return r;
    }

    // 构建一个 CON 请求数据报：4 字节头部、2 字节 token、
    // Uri-Path 选项（按 '/' 分隔的每个段一个），然后是 0xFF + payload。
    // 实际长度写入 <paramref name="outLen"/>[0]。
    public byte[] BuildRequest(int code, string path, string payload, int msgId,
                        int tok, List<int> outLen) {
        byte[] p = new byte[4 + 2 + 4 + path.Length * 2 + 32 + 1 + payload.Length + 8];
        int o = 0;
        p[o] = (byte)((1 << 6) + (0 << 4) + 2);  // ver=1, type=CON, tkl=2
        o = o + 1;
        p[o] = (byte)(code);
        o = o + 1;
        p[o] = (byte)((msgId >> 8) & 255);
        o = o + 1;
        p[o] = (byte)(msgId & 255);
        o = o + 1;
        p[o] = (byte)((tok >> 8) & 255);
        o = o + 1;
        p[o] = (byte)(tok & 255);
        o = o + 1;

        // Uri-Path（选项 11），每个段重复一次；delta 依次为 11、0。
        // RFC 7252 §3.1 扩展长度编码：segLen >= 269 时占 2 字节（值 14 + 16 位整数）。
        int prevOpt = 0;
        int segStart = 0;
        for (int i = 0; i <= path.Length; i = i + 1) {
            bool atEnd = i == path.Length;
            bool atSep = false;
            if (!atEnd) { atSep = (path[i] & 255) == 47; }
            if (atEnd || atSep) {
                int segLen = i - segStart;
                if (segLen > 0) {
                    int delta = 11 - prevOpt;
                    prevOpt = 11;
                    if (segLen < 13) {
                        p[o] = (byte)((delta << 4) + segLen);
                        o = o + 1;
                    } else if (segLen < 269) {
                        p[o] = (byte)((delta << 4) + 13);
                        o = o + 1;
                        p[o] = (byte)(segLen - 13);
                        o = o + 1;
                    } else {
                        p[o] = (byte)((delta << 4) + 14);
                        o = o + 1;
                        int ext = segLen - 269;
                        p[o] = (byte)((ext >> 8) & 255);
                        o = o + 1;
                        p[o] = (byte)(ext & 255);
                        o = o + 1;
                    }
                    int k = segStart;
                    while (k < i) {
                        p[o] = (byte)(path[k]);
                        o = o + 1;
                        k = k + 1;
                    }
                }
                segStart = i + 1;
            }
        }

        if (payload.Length > 0) {
            p[o] = 255;
            o = o + 1;
            for (int k2 = 0; k2 < payload.Length; k2 = k2 + 1) {
                p[o] = (byte)(payload[k2]);
                o = o + 1;
            }
        }
        outLen.Add(o);
        return p;
    }

    // 解析响应数据报（<paramref name="d"/> 中有
    // <paramref name="n"/> 个有效字节）。数据报不属于本次请求
    // （message id 与 token 均不匹配）或只是空 ACK 时返回 null。
    private static CoapResponse ParseResponse(byte[] d, int n, int msgId, int tok) {
        if (n < 4) { return null; }
        int tkl = d[0] & 15;
        int code = d[1] & 255;
        int mid = ((d[2] & 255) << 8) + (d[3] & 255);
        int o = 4;
        int rtok = 0;
        for (int t = 0; t < tkl && o < n; t = t + 1) {
            rtok = (rtok << 8) + (d[o] & 255);
            o = o + 1;
        }
        bool ours = mid == msgId || (tkl == 2 && rtok == tok);
        if (!ours) { return null; }
        if (code == 0) { return null; }  // 空 ACK：真正的应答稍后到达

        // 跳过选项直到负载标记。
        while (o < n && (d[o] & 255) != 255) {
            int b = d[o] & 255;
            o = o + 1;
            int delta = (b >> 4) & 15;
            int len = b & 15;
            if (delta == 15 || len == 15) { return null; }
            if (delta == 13) {
                if (o >= n) { return null; }
                o = o + 1;
            } else if (delta == 14) {
                if (o + 1 >= n) { return null; }
                o = o + 2;
            }
            if (len == 13) {
                if (o >= n) { return null; }
                len = 13 + (d[o] & 255);
                o = o + 1;
            } else if (len == 14) {
                if (o + 1 >= n) { return null; }
                len = 269 + ((d[o] & 255) << 8) + (d[o + 1] & 255);
                o = o + 2;
            }
            o = o + len;
            if (o > n) { return null; }
        }
        string payload = "";
        if (o < n && (d[o] & 255) == 255 && o + 1 < n) {
            payload = d.ToStr(o + 1, n - o - 1);
        }
        return new CoapResponse(code, payload);
    }

    // 发送一个可确认请求并等待匹配的
    // 响应，按 RFC 7252 重传。当所有重试都超时，返回 code 为 0
    // （ok=false）的响应。
    async CoapResponse RequestAsync(int code, string path, string payload) {
        UdpClient udp = new UdpClient();
        int msgId = this.nextMsgId & 65535;
        this.nextMsgId = this.nextMsgId + 1;
        byte[] rtokBytes = RandomNumberGenerator.GetBytes(2);
        int tok = 0;
        if (rtokBytes != null) {
            tok = ((rtokBytes[0] & 255) << 8) | (rtokBytes[1] & 255);
        } else {
            tok = (msgId * 31 + 7) & 65535;
        }
        List<int> lenBox = new List<int>();
        byte[] pkt = BuildRequest(code, path, payload, msgId, tok, lenBox);
        int pktLen = lenBox[0];

        int attempt = 0;
        int window = this.ackTimeoutMs;
        CoapResponse result = null;
        byte[] rb = new byte[2048];
        while (result == null && attempt <= this.maxRetransmit) {
            int _s = await udp.SendBytesToAsync(pkt, pktLen, this.host, this.port);
            long start = Stopwatch.GetMilliseconds();
            while (result == null
                   && Stopwatch.GetMilliseconds() - start < window) {
                if (Socket.IsReadable(udp.GetSocket())) {
                    int rn = udp.RecvBytesFrom(rb, 2048);
                    result = CoapClient.ParseResponse(rb, rn, msgId, tok);
                } else {
                    await Task.Delay(20);
                }
            }
            attempt = attempt + 1;
            window = window * 2;
        }
        udp.Close();
        if (result == null) { result = new CoapResponse(0, ""); }
        return result;
    }
}
