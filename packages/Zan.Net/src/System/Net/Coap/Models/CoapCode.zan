using System;

namespace System.Net.Coap;

public class CoapCode {
    // GET（0.01）。
    public static const int GET = 1;  // 0.01
    // POST（0.02）。
    public static const int POST = 2;  // 0.02
    // PUT（0.03）。
    public static const int PUT = 3;  // 0.03
    // DELETE（0.04）。
    public static const int DELETE = 4;  // 0.04
}

// 解析后的 CoAP 响应：<c>code</c> 为 class.detail 字节
// （如 69 = 2.05 Content、132 = 4.04 Not Found），<c>payload</c> 为
// 0xFF 标记之后的字节（无则为 ""），2.xx 类时 <c>ok</c> 为 true；
// <c>CodeText</c> 以带点形式输出，供日志使用。
