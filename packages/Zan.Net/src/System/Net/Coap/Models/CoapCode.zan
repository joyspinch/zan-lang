using System;

namespace System.Net.Coap;

public class CoapCode {
    // 方法请求码（Method Codes，RFC 7252 §12.1.1）
    public static const int GET = 1;        // 0.01
    public static const int POST = 2;       // 0.02
    public static const int PUT = 3;        // 0.03
    public static const int DELETE = 4;     // 0.04

    // 成功响应码（Success 2.xx，RFC 7252 §12.1.2）
    public static const int Created = 65;   // 2.01 Created
    public static const int Deleted = 66;   // 2.02 Deleted
    public static const int Valid = 67;     // 2.03 Valid
    public static const int Changed = 68;   // 2.04 Changed
    public static const int Content = 69;   // 2.05 Content

    // 客户端错误码（Client Error 4.xx）
    public static const int BadRequest = 128;        // 4.00 Bad Request
    public static const int Unauthorized = 129;      // 4.01 Unauthorized
    public static const int BadOption = 130;         // 4.02 Bad Option
    public static const int Forbidden = 131;         // 4.03 Forbidden
    public static const int NotFound = 132;          // 4.04 Not Found
    public static const int MethodNotAllowed = 133;  // 4.05 Method Not Allowed

    // 服务端错误码（Server Error 5.xx）
    public static const int InternalServerError = 160; // 5.00 Internal Server Error
    public static const int BadGateway = 162;          // 5.02 Bad Gateway
    public static const int ServiceUnavailable = 163;  // 5.03 Service Unavailable
    public static const int GatewayTimeout = 164;      // 5.04 Gateway Timeout
}
