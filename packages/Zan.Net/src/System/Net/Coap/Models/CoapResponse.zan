using System;

namespace System.Net.Coap;

public class CoapResponse {
    public int code;
    public string payload;
    public bool ok;

    public CoapResponse(int code, string payload) {
        this.code = code;
        this.payload = payload;
        this.ok = (code >> 5) == 2;
    }

    // 响应码的 "2.05" 式带点渲染。
    public string CodeText() {
        return Convert.ToString(this.code >> 5) + "."
            + CoapResponse.Two(this.code & 31);
    }

    // 协议类别判定（RFC 7252 §3: Class = code >> 5）
    public bool IsSuccess() { return (this.code >> 5) == 2; }
    public bool IsClientError() { return (this.code >> 5) == 4; }
    public bool IsServerError() { return (this.code >> 5) == 5; }

    // 两位十进制渲染（detail 部分不足两位补零）。
    public static string Two(int v) {
        if (v < 10) { return "0" + Convert.ToString(v); }
        return Convert.ToString(v);
    }
}
