using System;
using System.Collections.Generic;
using System.IO;
using System.Text;

namespace System.Net.Mqtt;

// MQTT 预写日志（Write-Ahead Log, WAL）与崩溃持久化恢复引擎。
// 职责：
// 1. 保留消息（Retained Messages）磁盘持久化：写入/更新/删除前先落盘，Broker 重启后 100% 恢复。
// 2. QoS 1 与 QoS 2 飞行中未确认报文持久化：客户端断开重连或 Broker 宕机重启后无缝重发。
// 3. 采用 Base64 编码的主题与载荷序列化，天然二进制安全，彻底规避分隔符冲突与 CRLF 注入。
// 4. 定期快照压缩（Checkpoint），消除已覆盖的保留消息与已确认的飞行状态，防止日志无界膨胀。
public class MqttWal {
    public string filePath;
    public int uncheckpointedCount;
    public int checkpointInterval;

    public MqttWal(string filePath) {
        this.filePath = filePath;
        this.uncheckpointedCount = 0;
        this.checkpointInterval = 1000;
    }

    // 设置快照压缩触发间隔（记录条数）。
    public void SetCheckpointInterval(int interval) {
        if (interval > 0) {
            this.checkpointInterval = interval;
        }
    }

    // 将单行日志追加写入 WAL 文件。
    public void Append(string line) {
        lock (this) {
            try {
                File.AppendAllText(this.filePath, line);
                this.uncheckpointedCount = this.uncheckpointedCount + 1;
            } catch (Exception ex) {
                // 磁盘写故障安全防御，不向上抛出阻断核心通信
            }
        }
    }

    // 记录保留消息写入/更新：RS|<b64_topic>|<qos>|<b64_payload>\n
    public void LogRetainSet(string topic, int qos, string payload) {
        if (topic == null) { return; }
        if (payload == null) { payload = ""; }
        string bTopic = Convert.ToBase64String(topic.ToBytes());
        string bPayload = Convert.ToBase64String(payload.ToBytes());
        string line = "RS|" + bTopic + "|" + Convert.ToString(qos) + "|" + bPayload + "\n";
        this.Append(line);
    }

    // 记录保留消息清除：RD|<b64_topic>\n
    public void LogRetainDelete(string topic) {
        if (topic == null) { return; }
        string bTopic = Convert.ToBase64String(topic.ToBytes());
        string line = "RD|" + bTopic + "\n";
        this.Append(line);
    }

    // 记录 QoS 1/2 飞行中消息追加：QA|<b64_clientId>|<packetId>|<qos>|<b64_topic>|<b64_payload>\n
    public void LogInflightAdd(string clientId, int packetId, int qos, string topic, string payload) {
        if (clientId == null || topic == null) { return; }
        if (payload == null) { payload = ""; }
        string bClient = Convert.ToBase64String(clientId.ToBytes());
        string bTopic = Convert.ToBase64String(topic.ToBytes());
        string bPayload = Convert.ToBase64String(payload.ToBytes());
        string line = "QA|" + bClient + "|" + Convert.ToString(packetId) + "|" + Convert.ToString(qos)
            + "|" + bTopic + "|" + bPayload + "\n";
        this.Append(line);
    }

    // 记录 QoS 1/2 飞行中消息确认消除（PUBACK / PUBCOMP）：QK|<b64_clientId>|<packetId>\n
    public void LogInflightAck(string clientId, int packetId) {
        if (clientId == null) { return; }
        string bClient = Convert.ToBase64String(clientId.ToBytes());
        string line = "QK|" + bClient + "|" + Convert.ToString(packetId) + "\n";
        this.Append(line);
    }

    // 从磁盘重放 WAL 日志，恢复保留消息与飞行中未确认消息列表。
    public bool Recover(List<MqttRetainedMessage> outRetained, List<MqttInflightMessage> outInflight) {
        if (outRetained == null || outInflight == null) { return false; }
        lock (this) {
            if (!File.Exists(this.filePath)) {
                return true;
            }
            try {
                List<string> lines = File.ReadAllLines(this.filePath);
                for (int i = 0; i < lines.Count; i = i + 1) {
                    string line = lines[i];
                    if (line.Length < 3) { continue; }
                    List<string> parts = MqttWal.SplitPipe(line);
                    if (parts.Count < 2) { continue; }
                    string op = parts[0];
                    if (op == "RS" && parts.Count >= 4) {
                        string topic = MqttWal.DecodeString(parts[1]);
                        int qos = MqttWal.ParseInt(parts[2]);
                        string payload = MqttWal.DecodeString(parts[3]);
                        bool found = false;
                        for (int k = 0; k < outRetained.Count; k = k + 1) {
                            if (outRetained[k].topic == topic) {
                                outRetained[k].payload = payload;
                                outRetained[k].payloadLen = payload.Length;
                                outRetained[k].qos = qos;
                                found = true;
                                break;
                            }
                        }
                        if (!found) {
                            outRetained.Add(new MqttRetainedMessage(topic, payload, payload.Length, qos));
                        }
                    } else if (op == "RD" && parts.Count >= 2) {
                        string topic = MqttWal.DecodeString(parts[1]);
                        for (int k = outRetained.Count - 1; k >= 0; k = k - 1) {
                            if (outRetained[k].topic == topic) {
                                outRetained.RemoveAt(k);
                                break;
                            }
                        }
                    } else if (op == "QA" && parts.Count >= 6) {
                        string clientId = MqttWal.DecodeString(parts[1]);
                        int packetId = MqttWal.ParseInt(parts[2]);
                        int qos = MqttWal.ParseInt(parts[3]);
                        string topic = MqttWal.DecodeString(parts[4]);
                        string payload = MqttWal.DecodeString(parts[5]);
                        outInflight.Add(new MqttInflightMessage(clientId, packetId, qos, topic, payload, payload.Length));
                    } else if (op == "QK" && parts.Count >= 3) {
                        string clientId = MqttWal.DecodeString(parts[1]);
                        int packetId = MqttWal.ParseInt(parts[2]);
                        for (int k = outInflight.Count - 1; k >= 0; k = k - 1) {
                            if (outInflight[k].clientId == clientId && outInflight[k].packetId == packetId) {
                                outInflight.RemoveAt(k);
                                break;
                            }
                        }
                    }
                }
                return true;
            } catch (Exception ex) {
                return false;
            }
        }
    }

    // 快照压缩（Checkpoint）：将内存中最新的有效状态原子落盘，替换旧日志，收缩文件尺寸。
    public void Checkpoint(List<MqttRetainedMessage> retained, List<MqttInflightMessage> inflight) {
        if (retained == null || inflight == null) { return; }
        lock (this) {
            string tmpPath = this.filePath + ".checkpoint.tmp";
            try {
                StringBuilder sb = new StringBuilder();
                for (int i = 0; i < retained.Count; i = i + 1) {
                    MqttRetainedMessage r = retained[i];
                    string bTopic = Convert.ToBase64String(r.topic.ToBytes());
                    string bPayload = Convert.ToBase64String(r.payload.ToBytes());
                    sb.Append("RS|");
                    sb.Append(bTopic);
                    sb.Append("|");
                    sb.Append(Convert.ToString(r.qos));
                    sb.Append("|");
                    sb.Append(bPayload);
                    sb.Append("\n");
                }
                for (int j = 0; j < inflight.Count; j = j + 1) {
                    MqttInflightMessage m = inflight[j];
                    string bClient = Convert.ToBase64String(m.clientId.ToBytes());
                    string bTopic = Convert.ToBase64String(m.topic.ToBytes());
                    string bPayload = Convert.ToBase64String(m.payload.ToBytes());
                    sb.Append("QA|");
                    sb.Append(bClient);
                    sb.Append("|");
                    sb.Append(Convert.ToString(m.packetId));
                    sb.Append("|");
                    sb.Append(Convert.ToString(m.qos));
                    sb.Append("|");
                    sb.Append(bTopic);
                    sb.Append("|");
                    sb.Append(bPayload);
                    sb.Append("\n");
                }
                File.WriteAllText(tmpPath, sb.ToString());
                if (File.Exists(this.filePath)) {
                    File.Delete(this.filePath);
                }
                File.Move(tmpPath, this.filePath);
                this.uncheckpointedCount = 0;
            } catch (Exception ex) {
                Console.WriteLine("[mqtt-wal] compaction failed: " + ex.Message);
                if (File.Exists(tmpPath)) {
                    try { File.Delete(tmpPath); } catch (Exception _e2) {}
                }
            }
        }
    }

    public void Flush() {
        // AppendAllText 每次调用均完成 close 与系统刷新
    }

    // 安全切分按竖线分隔的行字段。
    public static List<string> SplitPipe(string s) {
        List<string> parts = new List<string>();
        if (s == null) { return parts; }
        int start = 0;
        int len = s.Length;
        for (int i = 0; i < len; i = i + 1) {
            if ((s[i] & 255) == 124) { // '|'
                parts.Add(s.Substring(start, i - start));
                start = i + 1;
            }
        }
        if (start <= len) {
            parts.Add(s.Substring(start, len - start));
        }
        return parts;
    }

    // 安全将 Base64 字符串解码为原始文本。
    public static string DecodeString(string b64) {
        if (b64 == null || b64.Length == 0) { return ""; }
        byte[] b = Convert.FromBase64String(b64);
        if (b == null || b.Length == 0) { return ""; }
        return b.ToStr(0, b.Length);
    }

    // 安全解析非负整数。
    public static int ParseInt(string s) {
        if (s == null || s.Length == 0) { return 0; }
        int val = 0;
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (c >= 48 && c <= 57) {
                val = val * 10 + (c - 48);
            }
        }
        return val;
    }
}
