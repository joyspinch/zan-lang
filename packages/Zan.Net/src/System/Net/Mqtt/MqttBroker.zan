using System;
using System.Net.Sockets;
using System.Net.Http;
using System.Text;
using System.Json;

namespace System.Net.Mqtt;

// 客户端 CONNECT 身份鉴权委托（RFC/OASIS MQTT v3.1.1 §3.1.3.4-§3.1.3.5）
// 返回 true 放行连接，返回 false 回复 CONNACK 0x04 (Bad user name or password) 并断开连接。
public delegate bool MqttAuthHandler(string clientId, string username, string password);

// 消息到达/发布拦截钩子（用于数据流转、规则审计或外部 Webhook 异步派发）。
public delegate void MqttMessageHook(string clientId, string topic, string payload, int qos, bool retain);

// 会话订阅的主题过滤器及授予的 QoS 实体记录。
public class MqttBroker : IDisposable {
    public List<MqttSession> sessions;
    public List<MqttTopicStat> topics;
    public List<MqttRetainedMessage> retainedMessages;
    public List<MqttInflightMessage> inflightMessages;
    public MqttWal wal;
    public MqttAuthHandler authHandler;
    public MqttMessageHook messageHook;
    private bool keepAliveRunning;
    private MqttSharedBus sharedBus;
    private Dictionary<string, MqttTopicStat> topicMap;
    private Dictionary<string, MqttRetainedMessage> retainedMap;

    private int nextId;
    private int startedAt;
    private int totalConnections;
    private int msgsIn;
    private int msgsOut;
    private int bytesIn;
    private int bytesOut;

    // 内部构造：空会话表与主题表；经 Global()/Use() 使用。
    public MqttBroker(string host, int port) {
        this.sessions = new List<MqttSession>();
        this.topics = new List<MqttTopicStat>();
        this.retainedMessages = new List<MqttRetainedMessage>();
        this.inflightMessages = new List<MqttInflightMessage>();
        this.topicMap = new Dictionary<string, MqttTopicStat>();
        this.retainedMap = new Dictionary<string, MqttRetainedMessage>();
        this.wal = null;
        this.authHandler = null;
        this.messageHook = null;
        this.keepAliveRunning = false;
        this.nextId = 0;
        this.startedAt = MqttBroker.Now();
        this.totalConnections = 0;
        this.msgsIn = 0;
        this.msgsOut = 0;
        this.bytesIn = 0;
        this.bytesOut = 0;
    }

    // 同步 retainedMap 以兼容外部直接修改或 WAL 恢复 retainedMessages 列表。
    private void EnsureRetainedMapSynced() {
        if (this.retainedMap.Count == this.retainedMessages.Count) { return; }
        this.retainedMap.Clear();
        for (int i = 0; i < this.retainedMessages.Count; i = i + 1) {
            MqttRetainedMessage r = this.retainedMessages[i];
            this.retainedMap[r.topic] = r;
        }
    }

    private void EnsureTopicMapSynced() {
        if (this.topicMap.Count == this.topics.Count) { return; }
        this.topicMap.Clear();
        for (int i = 0; i < this.topics.Count; i = i + 1) {
            MqttTopicStat t = this.topics[i];
            this.topicMap[t.name] = t;
        }
    }

    // 设置客户端连接鉴权委托
    public void SetAuthHandler(MqttAuthHandler handler) {
        this.authHandler = handler;
    }

    // 设置消息到达与发布拦截钩子
    public void SetMessageHook(MqttMessageHook hook) {
        this.messageHook = hook;
    }

    // 启用磁盘预写日志（WAL）与崩溃恢复引擎。
    // 启动时自动从 WAL 文件重放并恢复所有保留消息和 QoS 1/2 飞行中未确认消息；
    // 后续保留消息变更与飞行中消息状态将追加到磁盘。
    public bool EnableWal(string walFilePath) {
        this.wal = new MqttWal(walFilePath);
        bool ok = this.wal.Recover(this.retainedMessages, this.inflightMessages);
        this.retainedMap.Clear();
        for (int i = 0; i < this.retainedMessages.Count; i = i + 1) {
            MqttRetainedMessage r = this.retainedMessages[i];
            this.retainedMap[r.topic] = r;
        }
        return ok;
    }

    // 执行快照压缩收缩 WAL 文件尺寸。
    public void CheckpointWal() {
        if (this.wal != null) {
            this.wal.Checkpoint(this.retainedMessages, this.inflightMessages);
        }
    }

    // 记录 QoS 1/2 待确认报文到飞行状态与 WAL。
    public void TrackInflight(string clientId, int packetId, int qos, string topic, string payload) {
        if (clientId == null || clientId.Length == 0) { return; }
        if (this.wal != null) {
            this.wal.LogInflightAdd(clientId, packetId, qos, topic, payload);
        }
        this.inflightMessages.Add(new MqttInflightMessage(clientId, packetId, qos, topic, payload, payload.Length));
    }

    // 确认消除已完成的 QoS 1/2 飞行中消息（收到 PUBACK 或 PUBCOMP）。
    public void AcknowledgeInflight(string clientId, int packetId) {
        if (this.wal != null) {
            this.wal.LogInflightAck(clientId, packetId);
        }
        for (int i = this.inflightMessages.Count - 1; i >= 0; i = i - 1) {
            MqttInflightMessage m = this.inflightMessages[i];
            if (m.clientId == clientId && m.packetId == packetId) {
                this.inflightMessages.RemoveAt(i);
                break;
            }
        }
    }

    // 墙上时钟秒；用于管理快照中的时间戳。
    public static int Now() { return (int)(DateTime.GetCurrentUnixMilliseconds() / 1000L); }

    // 供 Worker 集成使用的共享实例（"mqtt" 协议的 worker 会将
    // 每个接受的连接路由到这里）；首次调用时惰性创建。
    private static MqttBroker inst;
    // 进程级共享实例的取用入口：未 Use 时惰性创建默认 broker。
    public static MqttBroker Global() {
        if (inst == null) { inst = new MqttBroker("", 0); }
        return inst;
    }

    // 将此 broker 发布为进程级实例，使 HTTP
    // 控制器无需层层传递即可读取其注册表。
    public void UseAsGlobal() {
        inst = this;
    }
    public static void Use(MqttBroker b) {
        if (b != null) { b.UseAsGlobal(); }
        else { inst = null; }
    }
    // 进程级共享实例（未 Use 时返回惰性创建的默认实例）。
    public static MqttBroker Instance() { return MqttBroker.Global(); }

    // 进程退出前的拆卸入口：停掉共享总线轮询并清空
    // 注册表，再解除进程级实例。静态 inst 是 broker 及其
    // sessions/topics/retained 列表在泄漏探测里的保持根，
    // 退出前需显式拆卸避免残留。
    public static void TeardownGlobal() {
        if (inst != null) {
            inst.Shutdown();
            inst = null;
        }
    }

    // 停机：停 KeepAlive 巡检协程（其帧持有 this，不置
    // 停止标志它就永生，broker 及列表在退出泄漏探测里恒可达）、
    // 停总线轮询、断开并清空全部会话/统计/保留消息。可随后
    // TeardownGlobal 一并解除静态实例。
    public void Shutdown() {
        this.keepAliveRunning = false;
        if (this.sharedBus != null) {
            this.sharedBus.Stop();
            this.sharedBus = null;
        }
        for (int i = 0; i < this.sessions.Count; i = i + 1) {
            this.sessions[i].alive = false;
        }
        this.sessions.Clear();
        this.topics.Clear();
        this.topicMap.Clear();
        this.retainedMessages.Clear();
        this.retainedMap.Clear();
        this.inflightMessages.Clear();
        if (this.wal != null) {
            this.wal.Flush();
        }
    }

    public void Stop() {
        this.Shutdown();
    }

    public void Dispose() {
        this.Stop();
    }

    // 当前连接的客户端数。
    public int Count() { return this.sessions.Count; }

    // ---- 主题匹配：带 + / # 通配符的过滤器 vs 具体主题 ----

    // 过滤器是否匹配具体主题：`#` 仅可位于过滤器末尾并匹配剩余所有层，`+` 匹配单层，
    // MQTT 3.1.1 §4.7.2: `$` 开头系统主题不匹配 `#` 或 `+` 开头的通配符过滤器。
    public static bool TopicMatches(string filter, string topic) {
        if (filter == null || topic == null || filter.Length == 0 || topic.Length == 0) {
            return false;
        }
        int fLen = filter.Length;
        int tLen = topic.Length;
        // MQTT 3.1.1 §4.7.2: '$' 开头主题不得匹配首字符为 '+' 或 '#' 的过滤器
        if ((topic[0] & 255) == 36 && ((filter[0] & 255) == 35 || (filter[0] & 255) == 43)) {
            return false;
        }
        if (filter == topic) { return true; }
        if (fLen == 1 && (filter[0] & 255) == 35) { return true; }
        int fPos = 0;
        int tPos = 0;
        while (fPos <= fLen) {
            int fEnd = fPos;
            while (fEnd < fLen && (filter[fEnd] & 255) != 47) {
                fEnd = fEnd + 1;
            }
            int fSegLen = fEnd - fPos;
            // MQTT 3.1.1 §4.7.1.2: `#` 必须是过滤器最后一段（后面不能再有 '/'）
            if (fSegLen == 1 && (filter[fPos] & 255) == 35) {
                return fEnd == fLen;
            }
            if (tPos > tLen) {
                return false;
            }
            int tEnd = tPos;
            while (tEnd < tLen && (topic[tEnd] & 255) != 47) {
                tEnd = tEnd + 1;
            }
            // 非 `+` 段需逐字节相等
            if (!(fSegLen == 1 && (filter[fPos] & 255) == 43)) {
                int tSegLen = tEnd - tPos;
                if (fSegLen != tSegLen) { return false; }
                for (int k = 0; k < fSegLen; k = k + 1) {
                    if ((filter[fPos + k] & 255) != (topic[tPos + k] & 255)) {
                        return false;
                    }
                }
            }
            fPos = fEnd + 1;
            tPos = tEnd + 1;
        }
        return tPos > tLen;
    }

    // ---- 报文构建器 ----

    // 构建 QoS 0 的 PUBLISH 报文（固定头 + varint 剩余长度 +
    // 2 字节主题长度 + 主题 + 载荷；载荷可含 NUL，按 len 原生内存精确拷贝）。
    private static byte[] BuildPublish(string topic, string payload, int payloadLen) {
        int topicLen = topic != null ? topic.Length : 0;
        int remainLen = 2 + topicLen + payloadLen;
        // Varint 剩余长度（最多 2 字节即可覆盖 16383，对
        // 64 KB 的读取足够；为保险起见编码最多 3 字节）。
        byte[] packet = new byte[remainLen + 5];
        int offset = 0;
        packet[offset] = (byte)(MqttPacketType.PUBLISH << 4);
        offset = offset + 1;
        int rl = remainLen;
        while (true) {
            int digit = rl & 127;
            rl = rl >> 7;
            if (rl > 0) {
                packet[offset] = (byte)(digit | 128);
            } else {
                packet[offset] = (byte)digit;
            }
            offset = offset + 1;
            if (rl == 0) { break; }
        }
        packet[offset] = (byte)((topicLen >> 8) & 255);
        offset = offset + 1;
        packet[offset] = (byte)(topicLen & 255);
        offset = offset + 1;
        if (topicLen > 0) {
            NativeMemory.PutString((nint)packet, offset, topic, topicLen);
            offset = offset + topicLen;
        }
        if (payloadLen > 0 && payload != null) {
            NativeMemory.PutString((nint)packet, offset, payload, payloadLen);
            offset = offset + payloadLen;
        }
        return packet;
    }

    // 构建带 Retain 标记的 PUBLISH 报文。
    private static byte[] BuildPublishRetain(string topic, string payload, int payloadLen) {
        byte[] packet = BuildPublish(topic, payload, payloadLen);
        packet[0] = (byte)((packet[0] & 255) | 1);
        return packet;
    }

    // 存储或清除保留消息（payloadLen == 0 时按规范删除对应主题的保留消息）。
    // 工业级上限防护：单条保留消息 payload 限制最大 64KB，总保留消息条数上限 4096 条，
    // 超过上限时拒绝新主题存入，防止恶意客户端发布大量随机主题耗尽 Broker 堆内存。
    private void SaveRetained(string topic, string payload, int payloadLen, int qos) {
        this.EnsureRetainedMapSynced();
        MqttRetainedMessage existing = null;
        if (this.retainedMap.TryGetValue(topic, out existing)) {
            if (payloadLen == 0) {
                this.retainedMap.Remove(topic);
                for (int i = this.retainedMessages.Count - 1; i >= 0; i = i - 1) {
                    if (this.retainedMessages[i].topic == topic) {
                        this.retainedMessages.RemoveAt(i);
                        break;
                    }
                }
                if (this.wal != null) {
                    this.wal.LogRetainDelete(topic);
                }
                return;
            }
            int keep = payloadLen;
            if (keep > 65536) { keep = 65536; }
            existing.payload = keep < payload.Length ? payload.Substring(0, keep) : payload;
            existing.payloadLen = keep;
            existing.qos = qos;
            if (this.wal != null) {
                this.wal.LogRetainSet(topic, qos, existing.payload);
            }
            return;
        }
        if (payloadLen > 0) {
            if (this.retainedMessages.Count >= 4096) { return; }
            int keep = payloadLen;
            if (keep > 65536) { keep = 65536; }
            string safePayload = keep < payload.Length ? payload.Substring(0, keep) : payload;
            MqttRetainedMessage entry = new MqttRetainedMessage(topic, safePayload, keep, qos);
            this.retainedMessages.Add(entry);
            this.retainedMap[topic] = entry;
            if (this.wal != null) {
                this.wal.LogRetainSet(topic, qos, safePayload);
            }
        }
    }

    // 同一报文的线上总长（1 固定头 + varint 长度 + 剩余），
    // 供发送方统计字节用，不必实际构建报文。
    private int PublishPacketLen(string topic, int payloadLen) {
        int topicLen = topic != null ? topic.Length : 0;
        int remainLen = 2 + topicLen + payloadLen;
        int varint = 1;
        int rl = remainLen >> 7;
        while (rl > 0) { varint = varint + 1; rl = rl >> 7; }
        return 1 + varint + remainLen;
    }

    // ---- 扇出分发 ----

    // 启用跨进程共享内存消息总线（基于 SharedTable）。
    // 在 Worker 多进程模型下，消息不仅推送到当前 Worker 的本地订阅者，
    // 还会通过跨进程共享内存总线广播给其他 Worker 进程中的订阅者。
    public void EnableSharedBus(string busName) {
        if (this.sharedBus != null) { return; }
        this.sharedBus = new MqttSharedBus(this, busName, 1024);
        this.sharedBus.StartPolling();
    }

    // 将消息投递给本进程内所有过滤器匹配
    // <paramref name="topic"/> 的存活会话。返回接收者数量。
    // 采用非阻塞直接发送优先策略，避免单连接拥塞挂起整个广播循环。
    // 发送失败或断开的连接立即标记清理。
    public async int PublishLocal(string topic, string payload, int payloadLen) {
        if (this.sessions.Count == 0) { return 0; }
        byte[] packet = BuildPublish(topic, payload, payloadLen);
        int packetLen = this.PublishPacketLen(topic, payloadLen);
        int receivers = 0;
        for (int i = 0; i < this.sessions.Count; i = i + 1) {
            MqttSession sess = this.sessions[i];
            if (sess.alive) {
                bool match = false;
                for (int j = 0; j < sess.subscriptions.Count; j = j + 1) {
                    if (TopicMatches(sess.subscriptions[j].filter, topic)) { match = true; break; }
                }
                if (match) {
                    // 非阻塞同步写入，不挂起当前广播协程：
                    // 当客户端写缓冲区满时快速跳过，短写或 0 字节写入会破坏帧边界故立即断开。
                    int n = Socket.Send(sess.sock, packet, packetLen);
                    if (n == packetLen) {
                        receivers = receivers + 1;
                        sess.msgsOut = sess.msgsOut + 1;
                        this.msgsOut = this.msgsOut + 1;
                        this.bytesOut = this.bytesOut + packetLen;
                    } else if (n >= 0) {
                        sess.alive = false;
                        Socket.ShutdownBoth(sess.sock);
                    }
                }
            }
        }
        return receivers;
    }

    // 分发消息：先投递给本进程内匹配的会话，若启用了跨进程共享总线，
    // 则同时广播至总线同步到其他 Worker 进程。
    private async int PublishToSubscribers(string topic, string payload, int payloadLen) {
        int receivers = await this.PublishLocal(topic, payload, payloadLen);
        if (this.sharedBus != null) {
            this.sharedBus.Broadcast(topic, payload, payloadLen);
        }
        return receivers;
    }

    // ---- 管理 API ----

    // 将消息记录到其主题下（消息计数 + 最后一条
    // 负载），首次使用时创建主题条目。主题表设上限：不设的话
    // 恶意客户端发布无限多不同的主题即可让 broker 内存无界
    // 增长（每个条目还保留整条 lastPayload）。达到上限后新主题
    // 不再建条目，已有主题的计数照常累加。
    private void Touch(string topic, string payload) {
        this.EnsureTopicMapSynced();
        MqttTopicStat existing = null;
        if (this.topicMap.TryGetValue(topic, out existing)) {
            existing.messages = existing.messages + 1;
            int keep = payload.Length;
            if (keep > 4096) {
                existing.lastPayload = payload.Substring(0, 4096);
            } else {
                existing.lastPayload = payload;
            }
            return;
        }
        // 最多跟踪 4096 个主题；足够运维观测用，且上界明确。
        if (this.topics.Count >= 4096) { return; }
        MqttTopicStat t = new MqttTopicStat(topic);
        t.messages = 1;
        int k = payload.Length;
        t.lastPayload = k > 4096 ? payload.Substring(0, 4096) : payload;
        this.topics.Add(t);
        this.topicMap[topic] = t;
    }

    // 管理端注入：以 broker 自身身份发布消息，
    // 并返回送达的订阅者数量。刻意保持同步——
    // 它会向其他客户端写入，而这些协程正停靠在可读性上，
    // 因此使用直接的非阻塞 send，而非可 await 的路径。
    public int Publish(string topic, string payload) {
        return this.Publish(topic, payload, 0, false);
    }

    // 增强发布接口：支持指定 QoS 与 Retain 标记。
    public int Publish(string topic, string payload, int qos, bool retain) {
        if (topic == null || topic.Length == 0) { return 0; }
        if (payload == null) { payload = ""; }
        int payloadLen = payload.Length;
        this.msgsIn = this.msgsIn + 1;
        this.bytesIn = this.bytesIn + payloadLen;
        this.Touch(topic, payload);
        if (retain) {
            this.SaveRetained(topic, payload, payloadLen, qos);
        }
        if (this.messageHook != null) {
            this.messageHook("", topic, payload, qos, retain);
        }
        if (this.sessions.Count == 0) { return 0; }
        byte[] packet = BuildPublish(topic, payload, payloadLen);
        int packetLen = this.PublishPacketLen(topic, payloadLen);
        int sent = 0;
        int i = 0;
        while (i < this.sessions.Count) {
            MqttSession sess = this.sessions[i];
            i = i + 1;
            if (!sess.alive) { continue; }
            if (!this.Matches(sess, topic)) { continue; }
            int n = Socket.Send(sess.sock, packet, packetLen);
            if (n == packetLen) {
                sent = sent + 1;
                sess.msgsOut = sess.msgsOut + 1;
                this.msgsOut = this.msgsOut + 1;
                this.bytesOut = this.bytesOut + packetLen;
            } else if (n >= 0) {
                sess.alive = false;
                Socket.ShutdownBoth(sess.sock);
            }
        }
        return sent;
    }

    // 该会话的任一过滤器是否匹配主题。
    public bool Matches(MqttSession sess, string topic) {
        for (int j = 0; j < sess.subscriptions.Count; j = j + 1) {
            if (TopicMatches(sess.subscriptions[j].filter, topic)) { return true; }
        }
        return false;
    }

    // 按 MQTT 客户端 id 强制断开客户端。
    public bool Kick(string clientId) {
        for (int i = 0; i < this.sessions.Count; i = i + 1) {
            MqttSession sess = this.sessions[i];
            if (sess.clientId == clientId) {
                sess.alive = false;
                // shutdown 而非 close：直接关闭描述符会让停靠在该
                // 套接字上的属主协程永远无法恢复（见 Socket.ShutdownBoth
                // 的说明）。属主协程在 EOF 后自行把会话从表里摘除
                // 并关闭 fd。
                Socket.ShutdownBoth(sess.sock);
                this.sessions.RemoveAt(i);
                return true;
            }
        }
        return false;
    }

    // 全部会话的订阅总数。
    public int SubsTotal() {
        int n = 0;
        for (int i = 0; i < this.sessions.Count; i = i + 1) {
            n = n + this.sessions[i].subscriptions.Count;
        }
        return n;
    }

    // 已连接客户端列表的管理 JSON。
    public string ClientsJson() {
        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < this.sessions.Count; i = i + 1) {
            MqttSession c = this.sessions[i];
            JsonValue o = JsonValue.NewObject();
            o.Put("id", JsonValue.NewInt((long)c.id));
            o.Put("client_id", JsonValue.NewStr(c.clientId));
            o.Put("addr", JsonValue.NewStr(c.addr));
            o.Put("connected_at", JsonValue.NewInt((long)c.connectedAt));
            o.Put("keepalive", JsonValue.NewInt((long)c.keepAlive));
            o.Put("subs", JsonValue.NewInt((long)c.subscriptions.Count));
            o.Put("msgs_in", JsonValue.NewInt((long)c.msgsIn));
            o.Put("msgs_out", JsonValue.NewInt((long)c.msgsOut));
            arr.items.Add(o);
        }
        return arr.ToJson();
    }

    // 返回一个客户端及其订阅，未知时返回 ""。
    public string ClientDetailJson(string clientId) {
        for (int i = 0; i < this.sessions.Count; i = i + 1) {
            MqttSession c = this.sessions[i];
            if (c.clientId == clientId) {
                JsonValue o = JsonValue.NewObject();
                o.Put("id", JsonValue.NewInt((long)c.id));
                o.Put("client_id", JsonValue.NewStr(c.clientId));
                o.Put("addr", JsonValue.NewStr(c.addr));
                o.Put("connected_at", JsonValue.NewInt((long)c.connectedAt));
                o.Put("msgs_in", JsonValue.NewInt((long)c.msgsIn));
                o.Put("msgs_out", JsonValue.NewInt((long)c.msgsOut));
                JsonValue subs = JsonValue.NewArray();
                for (int j = 0; j < c.subscriptions.Count; j = j + 1) {
                    JsonValue f = JsonValue.NewObject();
                    f.Put("filter", JsonValue.NewStr(c.subscriptions[j].filter));
                    f.Put("qos", JsonValue.NewInt((long)c.subscriptions[j].qos));
                    subs.items.Add(f);
                }
                o.Put("subscriptions", subs);
                return o.ToJson();
            }
        }
        return "";
    }

    // 全部订阅（按客户端平铺）的管理 JSON。
    public string SubscriptionsJson() {
        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < this.sessions.Count; i = i + 1) {
            MqttSession c = this.sessions[i];
            for (int j = 0; j < c.subscriptions.Count; j = j + 1) {
                JsonValue o = JsonValue.NewObject();
                o.Put("client_id", JsonValue.NewStr(c.clientId));
                o.Put("filter", JsonValue.NewStr(c.subscriptions[j].filter));
                o.Put("qos", JsonValue.NewInt((long)c.subscriptions[j].qos));
                arr.items.Add(o);
            }
        }
        return arr.ToJson();
    }

    // 已见主题列表（名称/计数/最后负载）的管理 JSON。
    public string TopicsJson() {
        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < this.topics.Count; i = i + 1) {
            MqttTopicStat t = this.topics[i];
            JsonValue o = JsonValue.NewObject();
            o.Put("topic", JsonValue.NewStr(t.name));
            o.Put("messages", JsonValue.NewInt((long)t.messages));
            o.Put("last", JsonValue.NewStr(t.lastPayload));
            arr.items.Add(o);
        }
        return arr.ToJson();
    }

    // broker 吞吐量快照。
    public string MetricsJson() {
        int uptime = MqttBroker.Now() - this.startedAt;
        JsonValue o = JsonValue.NewObject();
        o.Put("uptime_sec", JsonValue.NewInt((long)uptime));
        o.Put("clients_connected", JsonValue.NewInt((long)this.sessions.Count));
        o.Put("clients_total", JsonValue.NewInt((long)this.totalConnections));
        o.Put("subscriptions", JsonValue.NewInt((long)this.SubsTotal()));
        o.Put("topics", JsonValue.NewInt((long)this.topics.Count));
        o.Put("messages_in", JsonValue.NewInt((long)this.msgsIn));
        o.Put("messages_out", JsonValue.NewInt((long)this.msgsOut));
        o.Put("bytes_in", JsonValue.NewInt((long)this.bytesIn));
        o.Put("bytes_out", JsonValue.NewInt((long)this.bytesOut));
        return o.ToJson();
    }

    // 全部保留消息的管理 JSON。
    public string RetainedJson() {
        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < this.retainedMessages.Count; i = i + 1) {
            MqttRetainedMessage r = this.retainedMessages[i];
            JsonValue o = JsonValue.NewObject();
            o.Put("topic", JsonValue.NewStr(r.topic));
            o.Put("payload", JsonValue.NewStr(r.payload));
            o.Put("len", JsonValue.NewInt((long)r.payloadLen));
            o.Put("qos", JsonValue.NewInt((long)r.qos));
            arr.items.Add(o);
        }
        return arr.ToJson();
    }

    // 清除指定主题的保留消息；topic 为空时清除所有。
    public bool ClearRetained(string topic) {
        bool cleared = false;
        if (topic == null || topic.Length == 0) {
            if (this.retainedMessages.Count > 0) {
                cleared = true;
                if (this.wal != null) {
                    for (int i = 0; i < this.retainedMessages.Count; i = i + 1) {
                        this.wal.LogRetainDelete(this.retainedMessages[i].topic);
                    }
                }
                this.retainedMessages.Clear();
                this.retainedMap.Clear();
            }
            return cleared;
        }
        this.retainedMap.Remove(topic);
        for (int i = this.retainedMessages.Count - 1; i >= 0; i = i - 1) {
            if (this.retainedMessages[i].topic == topic) {
                this.retainedMessages.RemoveAt(i);
                if (this.wal != null) {
                    this.wal.LogRetainDelete(topic);
                }
                cleared = true;
                break;
            }
        }
        return cleared;
    }

    // 启动 KeepAlive 心跳定时巡检协程（MQTT-3.1.2.10）。
    // 每 1 秒轮询一次所有已连接的存活会话；若客户端声明的 keepAlive > 0，
    // 且距上次收到任何报文已超过 1.5 * keepAlive 秒，则判定对端假死/异常离线，
    // 主动调用 Socket.ShutdownBoth 唤醒并终止挂起的读取协程，
    // 触发会话自动清理与 LWT 遗嘱广播。
    public async void EnsureKeepAliveInspector() {
        if (this.keepAliveRunning) { return; }
        this.keepAliveRunning = true;
        // 100ms 观察步长 ×10 计满才扫表：扫表周期仍是 1s，但停机
        // 置标志后帧最迟 100ms 就能看到并退出，测试的泵等待
        // （200ms）来得及让它完成——1s 的 Delay 会让帧在退出时
        // 仍停靠在 Delay 上导致 broker 被帧钉住。
        int tick = 0;
        while (this.keepAliveRunning) {
            await Task.Delay(100);
            tick = tick + 1;
            if (tick < 10) { continue; }
            tick = 0;
            int now = MqttBroker.Now();
            for (int i = 0; i < this.sessions.Count; i = i + 1) {
                MqttSession s = this.sessions[i];
                if (s.alive && s.connected && s.keepAlive > 0) {
                    if (now - s.lastSeen > s.keepAlive + s.keepAlive / 2) {
                        s.alive = false;
                        Socket.ShutdownBoth(s.sock);
                    }
                }
            }
        }
    }

    // 在已接受的套接字上服务一个 MQTT 客户端，直到其
    // 断开。"mqtt" 协议的 Worker 用它服务每个客户端连接。
    // 清理走 finally：钩子代码（PUBLISH/SUBSCRIBE 分支）抛出时
    // 也不能把会话留在表里或泄漏套接字。
    public async void HandleConnection(nint sock) {
        this.EnsureKeepAliveInspector();
        try {
            await this.HandleConnectionInner(sock);
        } finally {
            Socket.Close(sock);
        }
    }

    private async bool HandleConnectPacket(nint sock, MqttPacket pkt, MqttSession sess) {
        if (sess.connected) { return false; }
        if (pkt.flags != 0) { return false; } // MQTT-2.2.2-1: CONNECT 固定头 flags 必须为 0
        int remainLen = pkt.bodyLen;
        byte[] body = pkt.body;
        if (remainLen < 10) { return false; } // MQTT-3.1.2-1: 协议变长头至少 10 字节
        // 校验协议名 (0x00 0x04 'M' 'Q' 'T' 'T')
        if (body[0] != 0 || body[1] != 4 || body[2] != 77 || body[3] != 81 || body[4] != 84 || body[5] != 84) {
            return false;
        }
        if (body[6] != 4) {
            // MQTT-3.1.2-2: 不支持的协议级别回复 CONNACK 0x01 并断连
            byte[] unacc = new byte[4];
            unacc[0] = (byte)(MqttPacketType.CONNACK << 4);
            unacc[1] = 2;
            unacc[2] = 0;
            unacc[3] = 1;
            int _un = await Socket.SendAsync(sock, unacc, 4);
            return false;
        }
        int connFlags = body[7] & 255;
        if ((connFlags & 1) != 0) { return false; } // MQTT-3.1.2-3: 保留位 bit 0 必须为 0
        sess.cleanSession = (connFlags & 2) != 0;
        sess.willFlag = (connFlags & 4) != 0;
        sess.willQos = (connFlags >> 3) & 3;
        sess.willRetain = (connFlags & 32) != 0;
        if (!sess.willFlag && (sess.willQos != 0 || sess.willRetain)) { return false; }
        if (sess.willFlag && sess.willQos == 3) { return false; }
        sess.connected = true;
        sess.keepAlive = ((body[8] & 255) << 8) + (body[9] & 255);
        int cur = 10;
        if (cur + 2 > remainLen) { return false; }
        int wireIdLen = ((body[cur] & 255) << 8) + (body[cur + 1] & 255);
        cur = cur + 2;
        if (cur + wireIdLen > remainLen) { return false; }
        int keepIdLen = wireIdLen > 128 ? 128 : wireIdLen;
        sess.clientId = body.ToStr(cur, keepIdLen);
        cur = cur + wireIdLen;
        if (sess.willFlag) {
            if (cur + 2 > remainLen) { return false; }
            int wtLen = ((body[cur] & 255) << 8) + (body[cur + 1] & 255);
            cur = cur + 2;
            if (wtLen <= 0 || cur + wtLen > remainLen) { return false; }
            sess.willTopic = body.ToStr(cur, wtLen);
            cur = cur + wtLen;
            if (cur + 2 > remainLen) { return false; }
            int wmLen = ((body[cur] & 255) << 8) + (body[cur + 1] & 255);
            cur = cur + 2;
            if (cur + wmLen > remainLen) { return false; }
            sess.willMessage = body.ToStr(cur, wmLen);
            cur = cur + wmLen;
        }
        bool hasUser = (connFlags & 128) != 0;
        bool hasPass = (connFlags & 64) != 0;
        if (!hasUser && hasPass) { return false; } // MQTT-3.1.2-22: password flag must be 0 if username flag is 0
        if (hasUser) {
            if (cur + 2 > remainLen) { return false; }
            int uLen = ((body[cur] & 255) << 8) + (body[cur + 1] & 255);
            cur = cur + 2;
            if (cur + uLen > remainLen) { return false; }
            sess.username = body.ToStr(cur, uLen);
            cur = cur + uLen;
        }
        if (hasPass) {
            if (cur + 2 > remainLen) { return false; }
            int pLen = ((body[cur] & 255) << 8) + (body[cur + 1] & 255);
            cur = cur + 2;
            if (cur + pLen > remainLen) { return false; }
            sess.password = body.ToStr(cur, pLen);
            cur = cur + pLen;
        }
        if (sess.clientId.Length == 0) {
            sess.clientId = "anon-" + Convert.ToString(sess.id);
        }
        if (this.authHandler != null && !this.authHandler(sess.clientId, sess.username, sess.password)) {
            byte[] unauth = new byte[4];
            unauth[0] = (byte)(MqttPacketType.CONNACK << 4);
            unauth[1] = 2;
            unauth[2] = 0;
            unauth[3] = 4; // 0x04: Bad user name or password (MQTT 3.1.1 §3.2.2.3)
            int _una = await Socket.SendAsync(sock, unauth, 4);
            return false;
        }
        for (int s = this.sessions.Count - 1; s >= 0; s = s - 1) {
            MqttSession old = this.sessions[s];
            if (old != sess && old.clientId == sess.clientId) {
                old.alive = false;
                Socket.ShutdownBoth(old.sock);
                this.sessions.RemoveAt(s);
            }
        }
        this.totalConnections = this.totalConnections + 1;
        this.sessions.Add(sess);
        byte[] connack = new byte[4];
        connack[0] = (byte)(MqttPacketType.CONNACK << 4);
        connack[1] = 2;
        connack[2] = 0;
        connack[3] = 0; // 已接受
        int _c = await Socket.SendAsync(sock, connack, 4);
        return true;
    }

    private async bool HandlePublishPacket(nint sock, MqttPacket pkt, int b0, MqttSession sess) {
        int remainLen = pkt.bodyLen;
        byte[] body = pkt.body;
        if (remainLen < 2) { return false; }
        int qos = (b0 >> 1) & 3;
        if (qos == 3) { return false; } // MQTT-3.3.1-4: QoS 两个 bit 不能同时为 1
        bool dup = (b0 & 8) != 0;
        if (qos == 0 && dup) { return false; } // MQTT-3.3.1-2: QoS 为 0 时 DUP 必须为 0
        int topicLen = ((body[0] & 255) << 8) + (body[1] & 255);
        int offset = 2 + topicLen;
        if (topicLen <= 0 || offset > remainLen
                || (qos > 0 && offset + 2 > remainLen)) { return false; }
        string topic = body.ToStr(2, topicLen);
        bool badTopic = false;
        for (int ti = 0; ti < topic.Length; ti = ti + 1) {
            int c = topic[ti] & 255;
            if (c == 43 || c == 35) { badTopic = true; break; }
        }
        if (badTopic) { return false; }
        int pid = 0;
        if (qos > 0) {
            pid = ((body[offset] & 255) << 8) + (body[offset + 1] & 255);
            offset = offset + 2;
        }
        int payloadLen = remainLen - offset;
        string payload = body.ToStr(offset, payloadLen);
        sess.msgsIn = sess.msgsIn + 1;
        this.msgsIn = this.msgsIn + 1;
        this.bytesIn = this.bytesIn + payloadLen;
        this.Touch(topic, payload);
        bool retain = (b0 & 1) != 0;
        if (retain) {
            this.SaveRetained(topic, payload, payloadLen, qos);
        }
        if (this.messageHook != null) {
            this.messageHook(sess.clientId, topic, payload, qos, retain);
        }
        int _r = await this.PublishToSubscribers(topic, payload, payloadLen);
        if (qos == 1) {
            byte[] puback = new byte[5];
            puback[0] = (byte)(MqttPacketType.PUBACK << 4);
            puback[1] = 2;
            puback[2] = (byte)((pid >> 8) & 255);
            puback[3] = (byte)(pid & 255);
            int _a = await Socket.SendAsync(sock, puback, 4);
        } else if (qos == 2) {
            byte[] pubrec = new byte[5];
            pubrec[0] = (byte)(MqttPacketType.PUBREC << 4);
            pubrec[1] = 2;
            pubrec[2] = (byte)((pid >> 8) & 255);
            pubrec[3] = (byte)(pid & 255);
            int _r2 = await Socket.SendAsync(sock, pubrec, 4);
        }
        return true;
    }

    private async bool HandleSubscribePacket(nint sock, MqttPacket pkt, MqttSession sess, int maxFilters) {
        if (pkt.flags != 2) { return false; } // MQTT-3.8.1-1: SUBSCRIBE 固定头 bits 3,2,1,0 必须为 0010
        int remainLen = pkt.bodyLen;
        byte[] body = pkt.body;
        if (remainLen < 2) { return false; } // 包标识 2 字节
        bool quotaExceeded = sess.subscriptions.Count >= maxFilters;
        int pid = ((body[0] & 255) << 8) + (body[1] & 255);
        int offset = 2;
        List<int> grantedQos = new List<int>();
        List<string> newlySubscribedFilters = new List<string>();
        bool malformed = false;
        while (offset < remainLen) {
            if (offset + 2 > remainLen) { malformed = true; break; }
            int fLen = ((body[offset] & 255) << 8) + (body[offset + 1] & 255);
            offset = offset + 2;
            if (fLen <= 0 || offset + fLen + 1 > remainLen) { malformed = true; break; }
            string filter = body.ToStr(offset, fLen);
            offset = offset + fLen;
            int reqQos = body[offset] & 255;
            offset = offset + 1;
            // MQTT-3.8.3-4: 请求 QoS 高 6 位必须为 0 且值只能为 0/1/2
            if (reqQos > 2) { malformed = true; break; }
            if (quotaExceeded) {
                grantedQos.Add(128);
                continue;
            }
            bool replaced = false;
            for (int e = 0; e < sess.subscriptions.Count; e = e + 1) {
                if (sess.subscriptions[e].filter == filter) {
                    sess.subscriptions[e].qos = reqQos;
                    replaced = true;
                    break;
                }
            }
            if (!replaced) {
                sess.subscriptions.Add(new MqttSubscription(filter, reqQos));
                newlySubscribedFilters.Add(filter);
                if (sess.subscriptions.Count >= maxFilters) {
                    quotaExceeded = true;
                }
            }
            grantedQos.Add(reqQos);
        }
        if (malformed || grantedQos.Count == 0) { return false; }
        int ackRemainLen = 2 + grantedQos.Count;
        int varintLen = MqttClient.RemainLenBytes(ackRemainLen);
        int ackLen = 1 + varintLen + ackRemainLen;
        byte[] suback = new byte[ackLen + 1];
        suback[0] = (byte)(MqttPacketType.SUBACK << 4);
        int ackOffset = 1 + MqttClient.WriteRemainLen(suback, 1, ackRemainLen);
        suback[ackOffset] = (byte)((pid >> 8) & 255);
        suback[ackOffset + 1] = (byte)(pid & 255);
        ackOffset = ackOffset + 2;
        for (int g = 0; g < grantedQos.Count; g = g + 1) {
            suback[ackOffset + g] = (byte)grantedQos[g];
        }
        int _s = await Socket.SendAsync(sock, suback, ackLen);
        if (newlySubscribedFilters.Count > 0 && this.retainedMessages.Count > 0) {
            List<MqttRetainedMessage> toSend = new List<MqttRetainedMessage>();
            for (int sf = 0; sf < newlySubscribedFilters.Count; sf = sf + 1) {
                string nFilter = newlySubscribedFilters[sf];
                for (int rm = 0; rm < this.retainedMessages.Count; rm = rm + 1) {
                    MqttRetainedMessage msg = this.retainedMessages[rm];
                    if (MqttBroker.TopicMatches(nFilter, msg.topic)) {
                        toSend.Add(msg);
                    }
                }
            }
            for (int k = 0; k < toSend.Count; k = k + 1) {
                MqttRetainedMessage msg = toSend[k];
                byte[] rpkt = MqttBroker.BuildPublishRetain(msg.topic, msg.payload, msg.payloadLen);
                int rpktLen = this.PublishPacketLen(msg.topic, msg.payloadLen);
                int _sent = await Socket.SendAsync(sess.sock, rpkt, rpktLen);
            }
        }
        return true;
    }

    private async bool HandleUnsubscribePacket(nint sock, MqttPacket pkt, MqttSession sess) {
        if (pkt.flags != 2) { return false; } // MQTT-3.10.1-1: UNSUBSCRIBE 固定头 bits 3,2,1,0 必须为 0010
        int remainLen = pkt.bodyLen;
        byte[] body = pkt.body;
        if (remainLen < 2) { return false; } // 包标识 2 字节
        int pid = ((body[0] & 255) << 8) + (body[1] & 255);
        int offset = 2;
        bool malformed = false;
        int filterCount = 0;
        while (offset < remainLen) {
            if (offset + 2 > remainLen) { malformed = true; break; }
            int fLen = ((body[offset] & 255) << 8) + (body[offset + 1] & 255);
            offset = offset + 2;
            if (fLen <= 0 || offset + fLen > remainLen) { malformed = true; break; }
            string filter = body.ToStr(offset, fLen);
            offset = offset + fLen;
            filterCount = filterCount + 1;
            int k = 0;
            while (k < sess.subscriptions.Count) {
                if (sess.subscriptions[k].filter == filter) {
                    sess.subscriptions.RemoveAt(k);
                } else {
                    k = k + 1;
                }
            }
        }
        if (malformed || filterCount == 0) { return false; }
        byte[] unsuback = new byte[5];
        unsuback[0] = (byte)(MqttPacketType.UNSUBACK << 4);
        unsuback[1] = 2;
        unsuback[2] = (byte)((pid >> 8) & 255);
        unsuback[3] = (byte)(pid & 255);
        int _u = await Socket.SendAsync(sock, unsuback, 4);
        return true;
    }

    // HandleConnection 的主体；注意此时套接字的关闭统一由
    // HandleConnection 的 finally 负责，本方法不自行 Close。
    private async void HandleConnectionInner(nint sock) {
        MqttSession sess = new MqttSession(sock);
        this.nextId = this.nextId + 1;
        sess.id = this.nextId;
        sess.addr = "fd:" + Convert.ToString(sock);
        sess.connectedAt = MqttBroker.Now();
        sess.lastSeen = sess.connectedAt;

        // 单会话订阅上限：每个过滤器在每次 PUBLISH 扇出时都要做
        // 主题匹配（逐层切分 + 比较），不设上限时一个客户端可以
        // 通过海量 SUBSCRIBE 把全 broker 的扇出拖成 CPU 饱和。
        // MQTT 合法客户端很少需要几十个以上的过滤器。
        int maxFilters = 128;

        MqttReader reader = new MqttReader(sock);
        bool active = true;
        while (active) {
            MqttPacket pkt = await reader.ReadPacketAsync();
            if (pkt == null) { break; }
            sess.lastSeen = MqttBroker.Now();
            int b0 = (pkt.packetType << 4) | (pkt.flags & 15);
            int remainLen = pkt.bodyLen;
            byte[] body = pkt.body;
            int packetType = pkt.packetType;

            // MQTT-3.1.0-1: 客户端建立连接后发送的首个报文必须是 CONNECT，否则断开连接
            if (!sess.connected && packetType != MqttPacketType.CONNECT) {
                break;
            }

            if (packetType == MqttPacketType.CONNECT) {
                if (!await this.HandleConnectPacket(sock, pkt, sess)) { break; }
            } else if (packetType == MqttPacketType.PUBLISH) {
                if (!await this.HandlePublishPacket(sock, pkt, b0, sess)) { break; }
            } else if (packetType == MqttPacketType.SUBSCRIBE) {
                if (!await this.HandleSubscribePacket(sock, pkt, sess, maxFilters)) { break; }
            } else if (packetType == MqttPacketType.UNSUBSCRIBE) {
                if (!await this.HandleUnsubscribePacket(sock, pkt, sess)) { break; }
            } else if (packetType == MqttPacketType.PINGREQ) {
                if (pkt.flags != 0 || remainLen != 0) { break; } // MQTT-3.12.1-1: flags=0, 无载荷
                byte[] pong = new byte[3];
                pong[0] = (byte)(MqttPacketType.PINGRESP << 4);
                pong[1] = 0;
                int _p = await Socket.SendAsync(sock, pong, 2);
            } else if (packetType == MqttPacketType.DISCONNECT) {
                if (pkt.flags != 0 || remainLen != 0) { break; } // MQTT-3.14.1-1: flags=0, 无载荷
                sess.receivedDisconnect = true;
                active = false;
            } else if (packetType == MqttPacketType.PUBREL) {
                if (pkt.flags != 2 || remainLen != 2) { break; } // MQTT-3.6.1-1: PUBREL flags=0010 且剩余长度恒为 2
                int relPid = ((body[0] & 255) << 8) + (body[1] & 255);
                byte[] pubcomp = new byte[5];
                pubcomp[0] = (byte)(MqttPacketType.PUBCOMP << 4);
                pubcomp[1] = 2;
                pubcomp[2] = (byte)((relPid >> 8) & 255);
                pubcomp[3] = (byte)(relPid & 255);
                int _cp = await Socket.SendAsync(sock, pubcomp, 4);
            } else if (packetType == MqttPacketType.PUBACK || packetType == MqttPacketType.PUBREC || packetType == MqttPacketType.PUBCOMP) {
                if (pkt.flags != 0 || remainLen != 2) { break; } // MQTT-2.2.2: 确认类报文 flags=0 且剩余长度恒为 2
                // 收到确认类报文，更新会话最后活跃时间
                sess.lastSeen = MqttBroker.Now();
                int ackPid = ((body[0] & 255) << 8) + (body[1] & 255);
                this.AcknowledgeInflight(sess.clientId, ackPid);
            } else {
                // 未知或保留控制报文类型（如 0 或 15），按协议违规断连
                break;
            }

            // keepalive 强制（MQTT-3.1.2.10）：客户端声明 keepAlive > 0
            // 后，超过 1.5 倍时间没有任何字节即挂断。只对已 CONNECT 的
            // 会话生效；shutdown 而非 close，停靠在 RecvOv 上的本协程
            // 会读到 EOF 并走上面的正常清理路径。
            if (active && sess.connected && sess.keepAlive > 0) {
                int now = MqttBroker.Now();
                if (now - sess.lastSeen > sess.keepAlive + sess.keepAlive / 2) {
                    Socket.ShutdownBoth(sock);
                    break;
                }
            }
        }

        sess.alive = false;
        for (int k2 = 0; k2 < this.sessions.Count; k2 = k2 + 1) {
            if (this.sessions[k2] == sess) {
                this.sessions.RemoveAt(k2);
                break;
            }
        }
        if (!sess.receivedDisconnect && sess.willFlag && sess.willTopic.Length > 0) {
            await this.PublishToSubscribers(sess.willTopic, sess.willMessage, sess.willMessage.Length);
            if (sess.willRetain) {
                this.SaveRetained(sess.willTopic, sess.willMessage, sess.willMessage.Length, sess.willQos);
            }
        }
    }
}
