using System;
using System.Collections.Generic;
using System.Net.Sockets;
using System.Threading;

namespace System.Net.Mqtt;

// MQTT v3.1.1 客户端（支持全双工、并发发布与协程安全收发）。
public class MqttClient : IDisposable {
    TcpClient conn;
    MqttReader reader;
    string clientId;
    string host;
    int port;
    bool connected;
    int nextPacketId;
    int keepAlive;
    string willTopic;
    string willMessage;
    int willQos;
    bool willRetain;
    bool hasWill;
    List<MqttPacket> pendingPackets;

    Mutex stateLock;
    bool sendBusy;
    List<AsyncGate> sendWaiters;
    bool recvBusy;
    List<AsyncGate> recvWaiters;

    [DllImport("crt")]
    private static extern long strlen(string str);

    // 构造未连接的客户端；连接通过 <see cref="ConnectAsync"/> 建立。
    public MqttClient() {
        this.clientId = "";
        this.host = "";
        this.port = 1883;
        this.connected = false;
        this.nextPacketId = 1;
        this.keepAlive = 60;
        this.willTopic = "";
        this.willMessage = "";
        this.willQos = 0;
        this.willRetain = false;
        this.hasWill = false;
        this.pendingPackets = new List<MqttPacket>();
        this.stateLock = new Mutex();
        this.sendBusy = false;
        this.sendWaiters = new List<AsyncGate>();
        this.recvBusy = false;
        this.recvWaiters = new List<AsyncGate>();
    }

    // 设置客户端遗嘱（LWT）属性，在连接建立前配置。
    public void SetWill(string topic, string message, int qos, bool retain) {
        this.willTopic = topic;
        this.willMessage = message;
        this.willQos = qos;
        this.willRetain = retain;
        this.hasWill = true;
    }

    // 线程安全分配下一个报文标识符（Packet Identifier，1-65535）。
    int GetNextPacketId() {
        this.stateLock.WaitOne();
        int pid = this.nextPacketId;
        this.nextPacketId = this.nextPacketId + 1;
        if (this.nextPacketId > 65535) {
            this.nextPacketId = 1;
        }
        this.stateLock.ReleaseMutex();
        return pid;
    }

    // ---- 发送互斥锁（协程所有权直接移交，杜绝并发插队与出站报文碎片交错） ----
    void WakeSendWaiters() {
        this.stateLock.WaitOne();
        this.sendBusy = false;
        while (this.sendWaiters.Count > 0) {
            AsyncGate g = this.sendWaiters[0];
            this.sendWaiters.RemoveAt(0);
            g.Signal();
        }
        this.stateLock.ReleaseMutex();
    }

    async bool AcquireSendAsync() {
        AsyncGate g = null;
        this.stateLock.WaitOne();
        if (!this.connected || this.conn == null) {
            this.stateLock.ReleaseMutex();
            return false;
        }
        if (!this.sendBusy && this.sendWaiters.Count == 0) {
            this.sendBusy = true;
            this.stateLock.ReleaseMutex();
            return true;
        }
        g = new AsyncGate();
        this.sendWaiters.Add(g);
        this.stateLock.ReleaseMutex();

        await g.Wait();
        g.Close();

        this.stateLock.WaitOne();
        if (!this.connected || this.conn == null) {
            if (this.sendWaiters.Count > 0) {
                AsyncGate next = this.sendWaiters[0];
                this.sendWaiters.RemoveAt(0);
                next.Signal();
            } else {
                this.sendBusy = false;
            }
            this.stateLock.ReleaseMutex();
            return false;
        }
        this.stateLock.ReleaseMutex();
        return true;
    }

    void ReleaseSend() {
        this.stateLock.WaitOne();
        if (this.sendWaiters.Count > 0) {
            AsyncGate next = this.sendWaiters[0];
            this.sendWaiters.RemoveAt(0);
            next.Signal();
        } else {
            this.sendBusy = false;
        }
        this.stateLock.ReleaseMutex();
    }

    // 在出站互斥保护下串行发送完整报文，消除 TCP 碎片交织。
    async int SendBytesLockedAsync(byte[] packet, int length) {
        if (packet == null || length <= 0) { return 0; }
        if (!await this.AcquireSendAsync()) { return -1; }
        int sent = -1;
        if (this.connected && this.conn != null) {
            sent = await this.conn.SendBytesAsync(packet, length);
        }
        this.ReleaseSend();
        return sent;
    }

    // ---- 接收互斥锁（串行化底层 MqttReader，杜绝缓冲区指针撕裂与乱序错位） ----
    void WakeRecvWaiters() {
        this.stateLock.WaitOne();
        this.recvBusy = false;
        while (this.recvWaiters.Count > 0) {
            AsyncGate g = this.recvWaiters[0];
            this.recvWaiters.RemoveAt(0);
            g.Signal();
        }
        this.stateLock.ReleaseMutex();
    }

    async bool AcquireRecvAsync() {
        AsyncGate g = null;
        this.stateLock.WaitOne();
        if (!this.connected || this.conn == null) {
            this.stateLock.ReleaseMutex();
            return false;
        }
        if (!this.recvBusy && this.recvWaiters.Count == 0) {
            this.recvBusy = true;
            this.stateLock.ReleaseMutex();
            return true;
        }
        g = new AsyncGate();
        this.recvWaiters.Add(g);
        this.stateLock.ReleaseMutex();

        await g.Wait();
        g.Close();

        this.stateLock.WaitOne();
        if (!this.connected || this.conn == null) {
            if (this.recvWaiters.Count > 0) {
                AsyncGate next = this.recvWaiters[0];
                this.recvWaiters.RemoveAt(0);
                next.Signal();
            } else {
                this.recvBusy = false;
            }
            this.stateLock.ReleaseMutex();
            return false;
        }
        this.stateLock.ReleaseMutex();
        return true;
    }

    void ReleaseRecv() {
        this.stateLock.WaitOne();
        if (this.recvWaiters.Count > 0) {
            AsyncGate next = this.recvWaiters[0];
            this.recvWaiters.RemoveAt(0);
            next.Signal();
        } else {
            this.recvBusy = false;
        }
        this.stateLock.ReleaseMutex();
    }

    // 校验报文是否满足期望类型与报文标识符（PID）。
    bool MatchPacket(MqttPacket pkt, int expectedType, int expectedPid) {
        if (pkt == null) { return false; }
        if (expectedType < 0) { return true; }
        if (pkt.packetType != expectedType) { return false; }
        if (expectedPid < 0) { return true; }
        if (pkt.packetType == MqttPacketType.PUBLISH) {
            int qos = (pkt.flags >> 1) & 3;
            if (qos == 0 || pkt.body == null || pkt.bodyLen < 4) { return false; }
            int topicLen = ((pkt.body[0] & 255) << 8) | (pkt.body[1] & 255);
            int offset = 2 + topicLen;
            if (offset + 2 > pkt.bodyLen) { return false; }
            int pid = ((pkt.body[offset] & 255) << 8) | (pkt.body[offset + 1] & 255);
            return pid == expectedPid;
        }
        if (pkt.bodyLen >= 2 && pkt.body != null) {
            int pid = ((pkt.body[0] & 255) << 8) | (pkt.body[1] & 255);
            return pid == expectedPid;
        }
        return false;
    }

    // 从待处理缓冲队列中原子弹出满足期望的报文。
    MqttPacket PopPending(int expectedType, int expectedPid) {
        this.stateLock.WaitOne();
        if (this.pendingPackets == null || this.pendingPackets.Count == 0) {
            this.stateLock.ReleaseMutex();
            return null;
        }
        for (int i = 0; i < this.pendingPackets.Count; i = i + 1) {
            MqttPacket pkt = this.pendingPackets[i];
            if (this.MatchPacket(pkt, expectedType, expectedPid)) {
                this.pendingPackets.RemoveAt(i);
                this.stateLock.ReleaseMutex();
                return pkt;
            }
        }
        this.stateLock.ReleaseMutex();
        return null;
    }

    // 向待处理队列原子放入报文。
    void PushPending(MqttPacket pkt) {
        if (pkt == null) { return; }
        this.stateLock.WaitOne();
        if (this.pendingPackets == null) {
            this.pendingPackets = new List<MqttPacket>();
        }
        if (this.pendingPackets.Count >= 1024) {
            // 待处理缓冲上限（1024条），淘汰最旧的未消费报文，防止长连接内存无界泄漏
            this.pendingPackets.RemoveAt(0);
        }
        this.pendingPackets.Add(pkt);
        this.stateLock.ReleaseMutex();
    }

    // MQTT "remaining length" varint 编码所需的字节数（1-4）。
    public static int RemainLenBytes(int remainLen) {
        int n = 1;
        int rl = remainLen >> 7;
        while (rl > 0) {
            n = n + 1;
            rl = rl >> 7;
        }
        return n;
    }

    // 把 "remaining length" 编码为 MQTT varint 写入
    // <paramref name="packet"/> 的 <paramref name="offset"/> 处，
    // 返回写入的字节数（1-4）。此前各报文构建器把 remainLen
    // 截进单字节，报文一旦超过 127 字节就违反协议、让 broker
    // 端的 varint 解码从此错位。
    public static int WriteRemainLen(byte[] packet, int offset, int remainLen) {
        int rl = remainLen;
        int written = 0;
        while (true) {
            int digit = rl & 127;
            rl = rl >> 7;
            if (rl > 0) {
                packet[offset + written] = (byte)(digit | 128);
            } else {
                packet[offset + written] = (byte)digit;
                break;
            }
            written = written + 1;
        }
        return written + 1;
    }

    // 从待处理缓冲队列或底层网络流中获取下一个数据报文。
    async MqttPacket NextPacketAsync() {
        return await this.DrainExpectedPacketAsync(-1, -1);
    }

    // 等待指定类型与 PID 的控制报文（如 PUBACK / SUBACK / UNSUBACK / PUBREC / PUBCOMP）。
    // 在等待过程中，如果收到 PUBLISH 或其他协程的 ACK，将其暂存到 pendingPackets 队列中，
    // 防止在确认到达之前丢失并发下发的业务消息；收到 PINGREQ 自动回 PINGRESP。
    async MqttPacket DrainExpectedPacketAsync(int expectedType, int expectedPid) {
        while (this.connected) {
            MqttPacket cached = this.PopPending(expectedType, expectedPid);
            if (cached != null) {
                return cached;
            }
            if (!await this.AcquireRecvAsync()) {
                return null;
            }
            // 拿锁后二次检查，防止排队等待期间其他协程已将报文读入并暂存
            cached = this.PopPending(expectedType, expectedPid);
            if (cached != null) {
                this.ReleaseRecv();
                return cached;
            }

            if (this.reader == null) {
                this.ReleaseRecv();
                return null;
            }

            MqttPacket pkt = await this.reader.ReadPacketAsync();
            if (pkt == null) {
                this.stateLock.WaitOne();
                this.connected = false;
                this.stateLock.ReleaseMutex();
                this.ReleaseRecv();
                this.WakeRecvWaiters();
                this.WakeSendWaiters();
                return null;
            }

            if (pkt.packetType == MqttPacketType.PINGREQ) {
                byte[] pong = new byte[2];
                pong[0] = (byte)(MqttPacketType.PINGRESP << 4);
                pong[1] = 0;
                await this.SendBytesLockedAsync(pong, 2);
                this.ReleaseRecv();
                continue;
            } else if (pkt.packetType == MqttPacketType.PUBREL && expectedType != MqttPacketType.PUBREL) {
                int rpid = 0;
                if (pkt.bodyLen >= 2 && pkt.body != null) {
                    rpid = ((pkt.body[0] & 255) << 8) + (pkt.body[1] & 255);
                }
                byte[] pubcomp = new byte[4];
                pubcomp[0] = (byte)(MqttPacketType.PUBCOMP << 4);
                pubcomp[1] = 2;
                pubcomp[2] = (byte)((rpid >> 8) & 255);
                pubcomp[3] = (byte)(rpid & 255);
                await this.SendBytesLockedAsync(pubcomp, 4);
                this.ReleaseRecv();
                continue;
            } else if (pkt.packetType == MqttPacketType.PINGRESP && expectedType != MqttPacketType.PINGRESP) {
                this.ReleaseRecv();
                continue;
            }

            if (this.MatchPacket(pkt, expectedType, expectedPid)) {
                this.ReleaseRecv();
                return pkt;
            }

            this.PushPending(pkt);
            this.ReleaseRecv();
        }
        return null;
    }

    // 读取并丢弃一个完整控制报文，返回其报文类型以保持流帧同步。
    async int DrainPacketAsync() {
        MqttPacket pkt = await this.DrainExpectedPacketAsync(-1, -1);
        if (pkt == null) { return -1; }
        return pkt.packetType;
    }

    // 连接 broker 并执行 MQTT CONNECT/CONNACK
    // 握手，每个网络步骤都在 IO reactor 上挂起。
    public static async MqttClient ConnectAsync(string host, int port, string clientId) {
        return await MqttClient.ConnectAsync(host, port, clientId, "", "", 0, false);
    }

    // 带遗嘱（LWT）配置连接 broker 并执行 MQTT CONNECT/CONNACK 握手。
    public static async MqttClient ConnectAsync(string host, int port, string clientId, string willTopic, string willMessage, int willQos, bool willRetain) {
        return await MqttClient.ConnectAsync(host, port, clientId, 60, willTopic, willMessage, willQos, willRetain);
    }

    // 带遗嘱（LWT）与自定义 KeepAlive 秒数连接 broker 并执行 MQTT CONNECT/CONNACK 握手。
    public static async MqttClient ConnectAsync(string host, int port, string clientId, int keepAlive, string willTopic, string willMessage, int willQos, bool willRetain) {
        MqttClient mqtt = new MqttClient();
        mqtt.host = host;
        mqtt.port = port;
        mqtt.clientId = clientId;
        if (keepAlive > 0) {
            mqtt.keepAlive = keepAlive;
        }
        if (willTopic != null && willTopic.Length > 0) {
            mqtt.SetWill(willTopic, willMessage, willQos, willRetain);
        }

        mqtt.conn = await TcpClient.ConnectAsync(host, port);
        // 连接失败/超时按文档返回 null：保持 connected=false 由调用方检查。
        if (mqtt.conn == null) { return mqtt; }

        mqtt.reader = new MqttReader(mqtt.conn.GetSocket());

        byte[] packet = mqtt.BuildConnectPacket();
        int sent = await mqtt.conn.SendBytesAsync(packet, packet.Length);

        // CONNACK：固定头（2 字节）+ 可变头（2 字节）；
        // body 的第 2 字节为连接返回码（0 = 已接受）。
        MqttPacket ack = await mqtt.reader.ReadPacketAsync();
        if (ack == null || ack.packetType != MqttPacketType.CONNACK) {
            mqtt.connected = false;
            return mqtt;
        }
        if (ack.bodyLen >= 2 && ack.body != null) {
            int returnCode = ack.body[1] & 255;
            if (returnCode == 0) {
                mqtt.connected = true;
            }
        }
        return mqtt;
    }

    // 发布消息，在 IO reactor 上挂起。QoS 1 时
    // 还会等待 PUBACK。返回已发送的字节数。
    public async int PublishAsync(string topic, string message, int qos) {
        return await this.PublishAsync(topic, message, qos, false);
    }

    // 发布消息并指定 retain 标志，在 IO reactor 上挂起。
    public async int PublishAsync(string topic, string message, int qos, bool retain) {
        int topicLen = (int)strlen(topic);
        int msgLen = (int)strlen(message);

        int byte0 = (MqttPacketType.PUBLISH << 4);
        if (qos > 0) {
            byte0 = byte0 + (qos << 1);
        }
        if (retain) {
            byte0 = byte0 | 1;
        }

        int remainLen = 2 + topicLen + msgLen;
        if (qos > 0) {
            remainLen = remainLen + 2;
        }

        byte[] packet = new byte[1 + MqttClient.RemainLenBytes(remainLen) + remainLen];
        int offset = 0;
        packet[offset] = (byte)(byte0);
        offset = offset + 1;
        offset = offset + MqttClient.WriteRemainLen(packet, offset, remainLen);

        packet[offset] = (byte)((topicLen >> 8) & 255);
        offset = offset + 1;
        packet[offset] = (byte)(topicLen & 255);
        offset = offset + 1;

        int i = 0;
        for (; i < topicLen; i = i + 1) {
            packet[offset] = (byte)(topic[i]);
            offset = offset + 1;
        }

        int pid = 0;
        if (qos > 0) {
            pid = this.GetNextPacketId();
            packet[offset] = (byte)((pid >> 8) & 255);
            offset = offset + 1;
            packet[offset] = (byte)(pid & 255);
            offset = offset + 1;
        }

        i = 0;
        while (i < msgLen) {
            packet[offset] = (byte)(message[i]);
            offset = offset + 1;
            i = i + 1;
        }

        int sent = await this.SendBytesLockedAsync(packet, offset);
        if (sent <= 0) { return -1; }

        if (qos == MqttQos.AtLeastOnce) {
            MqttPacket acked = await this.DrainExpectedPacketAsync(MqttPacketType.PUBACK, pid);
        } else if (qos == MqttQos.ExactlyOnce) {
            // QoS 2 严格四步往返握手：
            // 1. 等待 broker 返回 PUBREC (5)
            MqttPacket rec = await this.DrainExpectedPacketAsync(MqttPacketType.PUBREC, pid);
            if (rec != null && rec.packetType == MqttPacketType.PUBREC) {
                // 2. 发送 PUBREL (6)，固定头必须带 flags=0010 (0x62)
                byte[] pubrel = new byte[4];
                pubrel[0] = 98;  // 0x62 (type=6, flags=0010)
                pubrel[1] = 2;
                pubrel[2] = (byte)((pid >> 8) & 255);
                pubrel[3] = (byte)(pid & 255);
                await this.SendBytesLockedAsync(pubrel, 4);
                // 3. 等待 broker 返回 PUBCOMP (7)
                MqttPacket comp = await this.DrainExpectedPacketAsync(MqttPacketType.PUBCOMP, pid);
            }
        }

        return sent;
    }

    // 以原生字节数组切片发布二进制消息，彻底杜绝包含 NUL 字节时被截断。在 IO reactor 上挂起。
    public async int PublishBytesAsync(string topic, byte[] payload, int offset, int count, int qos, bool retain) {
        if (payload == null || offset < 0 || count < 0 || offset + count > payload.Length) { return -1; }
        int topicLen = (int)strlen(topic);
        int msgLen = count;

        int byte0 = (MqttPacketType.PUBLISH << 4);
        if (qos > 0) {
            byte0 = byte0 + (qos << 1);
        }
        if (retain) {
            byte0 = byte0 | 1;
        }

        int remainLen = 2 + topicLen + msgLen;
        if (qos > 0) {
            remainLen = remainLen + 2;
        }

        byte[] packet = new byte[1 + MqttClient.RemainLenBytes(remainLen) + remainLen];
        int poffset = 0;
        packet[poffset] = (byte)(byte0);
        poffset = poffset + 1;
        poffset = poffset + MqttClient.WriteRemainLen(packet, poffset, remainLen);

        packet[poffset] = (byte)((topicLen >> 8) & 255);
        poffset = poffset + 1;
        packet[poffset] = (byte)(topicLen & 255);
        poffset = poffset + 1;

        int i = 0;
        for (; i < topicLen; i = i + 1) {
            packet[poffset] = (byte)(topic[i]);
            poffset = poffset + 1;
        }

        int pid = 0;
        if (qos > 0) {
            pid = this.GetNextPacketId();
            packet[poffset] = (byte)((pid >> 8) & 255);
            poffset = poffset + 1;
            packet[poffset] = (byte)(pid & 255);
            poffset = poffset + 1;
        }

        if (msgLen > 0) {
            NativeMemory.Copy((nint)packet + (nint)poffset, (nint)payload + (nint)offset, msgLen);
            poffset = poffset + msgLen;
        }

        int sent = await this.SendBytesLockedAsync(packet, poffset);
        if (sent <= 0) { return -1; }

        if (qos == MqttQos.AtLeastOnce) {
            MqttPacket acked = await this.DrainExpectedPacketAsync(MqttPacketType.PUBACK, pid);
        } else if (qos == MqttQos.ExactlyOnce) {
            MqttPacket rec = await this.DrainExpectedPacketAsync(MqttPacketType.PUBREC, pid);
            if (rec != null && rec.packetType == MqttPacketType.PUBREC) {
                byte[] pubrel = new byte[4];
                pubrel[0] = 98;
                pubrel[1] = 2;
                pubrel[2] = (byte)((pid >> 8) & 255);
                pubrel[3] = (byte)(pid & 255);
                await this.SendBytesLockedAsync(pubrel, 4);
                MqttPacket comp = await this.DrainExpectedPacketAsync(MqttPacketType.PUBCOMP, pid);
            }
        }

        return sent;
    }

    // 以原生字节数组发布完整二进制消息。
    public async int PublishBytesAsync(string topic, byte[] payload, int qos, bool retain) {
        if (payload == null) { return -1; }
        return await this.PublishBytesAsync(topic, payload, 0, payload.Length, qos, retain);
    }

    // 订阅主题并等待 SUBACK，在 IO
    // reactor 上挂起。返回已发送的字节数。
    public async int SubscribeAsync(string topic, int qos) {
        int topicLen = (int)strlen(topic);
        int pid = this.GetNextPacketId();

        int remainLen = 2 + 2 + topicLen + 1;
        byte[] packet = new byte[1 + MqttClient.RemainLenBytes(remainLen) + remainLen];
        int offset = 0;

        packet[offset] = (byte)((MqttPacketType.SUBSCRIBE << 4) + 2);
        offset = offset + 1;
        offset = offset + MqttClient.WriteRemainLen(packet, offset, remainLen);

        packet[offset] = (byte)((pid >> 8) & 255);
        offset = offset + 1;
        packet[offset] = (byte)(pid & 255);
        offset = offset + 1;

        packet[offset] = (byte)((topicLen >> 8) & 255);
        offset = offset + 1;
        packet[offset] = (byte)(topicLen & 255);
        offset = offset + 1;

        for (int i = 0; i < topicLen; i = i + 1) {
            packet[offset] = (byte)(topic[i]);
            offset = offset + 1;
        }

        packet[offset] = (byte)(qos);
        offset = offset + 1;

        int sent = await this.SendBytesLockedAsync(packet, offset);
        if (sent <= 0) { return -1; }
        MqttPacket acked = await this.DrainExpectedPacketAsync(MqttPacketType.SUBACK, pid);
        return sent;
    }

    // 取消订阅主题并等待 UNSUBACK，在
    // IO reactor 上挂起。返回已发送的字节数。
    public async int UnsubscribeAsync(string topic) {
        int topicLen = (int)strlen(topic);
        int pid = this.GetNextPacketId();

        int remainLen = 2 + 2 + topicLen;
        byte[] packet = new byte[1 + MqttClient.RemainLenBytes(remainLen) + remainLen];
        int offset = 0;

        packet[offset] = (byte)((MqttPacketType.UNSUBSCRIBE << 4) + 2);
        offset = offset + 1;
        offset = offset + MqttClient.WriteRemainLen(packet, offset, remainLen);

        packet[offset] = (byte)((pid >> 8) & 255);
        offset = offset + 1;
        packet[offset] = (byte)(pid & 255);
        offset = offset + 1;

        packet[offset] = (byte)((topicLen >> 8) & 255);
        offset = offset + 1;
        packet[offset] = (byte)(topicLen & 255);
        offset = offset + 1;

        for (int i = 0; i < topicLen; i = i + 1) {
            packet[offset] = (byte)(topic[i]);
            offset = offset + 1;
        }

        int sent = await this.SendBytesLockedAsync(packet, offset);
        if (sent <= 0) { return -1; }
        MqttPacket acked = await this.DrainExpectedPacketAsync(MqttPacketType.UNSUBACK, pid);
        return sent;
    }

    // 等待下一个传入的 PUBLISH 并返回其负载，
    // 在 IO reactor 上挂起直到数据到达。对 broker 的
    // PINGREQ 透明响应，并继续等待真正的消息。
    public async string ReceiveAsync() {
        if (!this.connected) { return ""; }
        while (this.connected) {
            MqttPacket pkt = await this.DrainExpectedPacketAsync(MqttPacketType.PUBLISH, -1);
            if (pkt == null) {
                return "";
            }

            int byte0 = (pkt.packetType << 4) | (pkt.flags & 15);
            int remainLen = pkt.bodyLen;
            byte[] body = pkt.body;

            if (remainLen < 2) { return ""; }
            int topicLen = ((body[0] & 255) << 8) + (body[1] & 255);
            int offset = 2 + topicLen;

            int qos = (byte0 >> 1) & 3;
            int incomingPid = 0;
            if (qos > 0) {
                if (offset + 2 > remainLen) { this.connected = false; return ""; }
                incomingPid = ((body[offset] & 255) << 8) + (body[offset + 1] & 255);
                offset = offset + 2;
            }

            // 主题/包标识越界说明对端错位（或恶意）：
            // 此时流已不可信，断开并返回空。
            if (offset > remainLen) {
                this.connected = false;
                return "";
            }

            if (qos == 1) {
                byte[] puback = new byte[4];
                puback[0] = (byte)(MqttPacketType.PUBACK << 4);
                puback[1] = 2;
                puback[2] = (byte)((incomingPid >> 8) & 255);
                puback[3] = (byte)(incomingPid & 255);
                await this.SendBytesLockedAsync(puback, 4);
            } else if (qos == 2) {
                byte[] pubrec = new byte[4];
                pubrec[0] = (byte)(MqttPacketType.PUBREC << 4);
                pubrec[1] = 2;
                pubrec[2] = (byte)((incomingPid >> 8) & 255);
                pubrec[3] = (byte)(incomingPid & 255);
                await this.SendBytesLockedAsync(pubrec, 4);
            }

            int payloadLen = remainLen - offset;
            return body.ToStr(offset, payloadLen);
        }
        return "";
    }

    // 等待下一个传入的 PUBLISH 并返回其原生二进制负载，彻底杜绝包含 NUL 字节时被截断。
    // 在 IO reactor 上挂起直到数据到达。对端关闭或出错时返回 null。
    public async byte[] ReceiveBytesAsync() {
        if (!this.connected) { return null; }
        while (this.connected) {
            MqttPacket pkt = await this.DrainExpectedPacketAsync(MqttPacketType.PUBLISH, -1);
            if (pkt == null) {
                return null;
            }

            int byte0 = (pkt.packetType << 4) | (pkt.flags & 15);
            int remainLen = pkt.bodyLen;
            byte[] body = pkt.body;

            if (remainLen < 2) { return null; }
            int topicLen = ((body[0] & 255) << 8) + (body[1] & 255);
            int offset = 2 + topicLen;

            int qos = (byte0 >> 1) & 3;
            int incomingPid = 0;
            if (qos > 0) {
                if (offset + 2 > remainLen) { this.connected = false; return null; }
                incomingPid = ((body[offset] & 255) << 8) + (body[offset + 1] & 255);
                offset = offset + 2;
            }

            if (offset > remainLen) {
                this.connected = false;
                return null;
            }

            if (qos == 1) {
                byte[] puback = new byte[4];
                puback[0] = (byte)(MqttPacketType.PUBACK << 4);
                puback[1] = 2;
                puback[2] = (byte)((incomingPid >> 8) & 255);
                puback[3] = (byte)(incomingPid & 255);
                await this.SendBytesLockedAsync(puback, 4);
            } else if (qos == 2) {
                byte[] pubrec = new byte[4];
                pubrec[0] = (byte)(MqttPacketType.PUBREC << 4);
                pubrec[1] = 2;
                pubrec[2] = (byte)((incomingPid >> 8) & 255);
                pubrec[3] = (byte)(incomingPid & 255);
                await this.SendBytesLockedAsync(pubrec, 4);
            }

            int payloadLen = remainLen - offset;
            byte[] res = new byte[payloadLen];
            if (payloadLen > 0) {
                NativeMemory.Copy((nint)res, (nint)body + (nint)offset, payloadLen);
            }
            return res;
        }
        return null;
    }

    // 发送 PINGREQ 保活，在 IO reactor 上挂起。
    // 返回已发送的字节数。
    public async int PingAsync() {
        byte[] packet = new byte[2];
        packet[0] = (byte)(MqttPacketType.PINGREQ << 4);
        packet[1] = 0;
        int sent = await this.SendBytesLockedAsync(packet, 2);
        return sent;
    }

    // 发送 DISCONNECT 并关闭连接，在 IO
    // reactor 上等待发送完成。返回已发送的字节数。
    public async int DisconnectAsync() {
        byte[] packet = new byte[2];
        packet[0] = (byte)(MqttPacketType.DISCONNECT << 4);
        packet[1] = 0;
        int sent = await this.SendBytesLockedAsync(packet, 2);
        this.Abort();
        return sent;
    }

    // 强制断开底层连接（不发送 DISCONNECT 报文），用于模拟客户端异常断开并触发遗嘱消息（LWT）。
    public void Abort() {
        this.stateLock.WaitOne();
        this.connected = false;
        if (this.conn != null) {
            this.conn.Close();
        }
        this.stateLock.ReleaseMutex();
        this.WakeSendWaiters();
        this.WakeRecvWaiters();
    }

    public void Dispose() {
        this.Abort();
        this.stateLock.Close();
    }

    // 连接是否仍存活：CONNACK 返回码为 0 后为 true，
    // 对端关闭或 <see cref="DisconnectAsync"/> 后为 false。
    public bool IsConnected() {
        return this.connected;
    }

    // 编码 CONNECT 报文：协议名 "MQTT"、协议级别 4（3.1.1）、
    // clean session 标志、遗嘱标志与载荷、keepAlive 秒数与 client id。
    byte[] BuildConnectPacket() {
        int flags = 2;  // CleanSession
        int willTopicLen = 0;
        int willMsgLen = 0;
        if (this.hasWill) {
            flags = flags | 4;
            flags = flags | ((this.willQos & 3) << 3);
            if (this.willRetain) {
                flags = flags | 32;
            }
            willTopicLen = (int)strlen(this.willTopic);
            willMsgLen = (int)strlen(this.willMessage);
        }

        int clientIdLen = (int)strlen(this.clientId);
        int remainLen = 10 + 2 + clientIdLen;
        if (this.hasWill) {
            remainLen = remainLen + 2 + willTopicLen + 2 + willMsgLen;
        }

        byte[] packet = new byte[1 + MqttClient.RemainLenBytes(remainLen) + remainLen];
        int offset = 0;

        packet[offset] = (byte)(MqttPacketType.CONNECT << 4);
        offset = offset + 1;
        offset = offset + MqttClient.WriteRemainLen(packet, offset, remainLen);

        packet[offset] = 0;
        offset = offset + 1;
        packet[offset] = 4;
        offset = offset + 1;
        packet[offset] = 77;
        offset = offset + 1;
        packet[offset] = 81;
        offset = offset + 1;
        packet[offset] = 84;
        offset = offset + 1;
        packet[offset] = 84;
        offset = offset + 1;

        packet[offset] = 4;
        offset = offset + 1;

        packet[offset] = (byte)flags;
        offset = offset + 1;

        packet[offset] = (byte)((this.keepAlive >> 8) & 255);
        offset = offset + 1;
        packet[offset] = (byte)(this.keepAlive & 255);
        offset = offset + 1;

        packet[offset] = (byte)((clientIdLen >> 8) & 255);
        offset = offset + 1;
        packet[offset] = (byte)(clientIdLen & 255);
        offset = offset + 1;

        for (int i = 0; i < clientIdLen; i = i + 1) {
            packet[offset] = (byte)(this.clientId[i]);
            offset = offset + 1;
        }

        if (this.hasWill) {
            packet[offset] = (byte)((willTopicLen >> 8) & 255);
            offset = offset + 1;
            packet[offset] = (byte)(willTopicLen & 255);
            offset = offset + 1;
            for (int i = 0; i < willTopicLen; i = i + 1) {
                packet[offset] = (byte)(this.willTopic[i]);
                offset = offset + 1;
            }

            packet[offset] = (byte)((willMsgLen >> 8) & 255);
            offset = offset + 1;
            packet[offset] = (byte)(willMsgLen & 255);
            offset = offset + 1;
            for (int i = 0; i < willMsgLen; i = i + 1) {
                packet[offset] = (byte)(this.willMessage[i]);
                offset = offset + 1;
            }
        }

        return packet;
    }
}
