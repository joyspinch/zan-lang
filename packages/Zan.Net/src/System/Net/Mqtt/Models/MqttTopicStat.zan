using System;
using System.Collections.Generic;
using System.Net.Sockets;

namespace System.Net.Mqtt;

public class MqttTopicStat {
    public string name;
    public int messages;
    public string lastPayload;

    public MqttTopicStat(string name) {
        this.name = name;
        this.messages = 0;
        this.lastPayload = "";
    }
}
