using System;
using System.Collections.Generic;
using System.Net.Sockets;

namespace System.Net.Mqtt;

public class MqttSession {
    public int id;
    public nint sock;
    public string clientId;
    public string addr;
    public List<MqttSubscription> subscriptions;
    public bool alive;
    public bool connected;
    public int connectedAt;
    public int keepAlive;
    // 最近一次收到该会话任何字节的时间（墙上时钟秒）；
    // keepAlive > 0 时超过 1.5 倍即按协议挂断。
    public int lastSeen;
    public int msgsIn;
    public int msgsOut;
    public bool cleanSession;
    public bool willFlag;
    public int willQos;
    public bool willRetain;
    public string willTopic;
    public string willMessage;
    public bool receivedDisconnect;

    // 内部构造：未 CONNECT 的裸会话，id/clientId 在握手时填。
    public MqttSession(nint sock) {
        this.id = 0;
        this.sock = sock;
        this.clientId = "";
        this.addr = "";
        this.subscriptions = new List<MqttSubscription>();
        this.alive = true;
        this.connected = false;
        this.connectedAt = 0;
        this.keepAlive = 0;
        this.lastSeen = 0;
        this.msgsIn = 0;
        this.msgsOut = 0;
        this.cleanSession = true;
        this.willFlag = false;
        this.willQos = 0;
        this.willRetain = false;
        this.willTopic = "";
        this.willMessage = "";
        this.receivedDisconnect = false;
    }
}

// 为主题保留的最新消息（Retained Message）。
