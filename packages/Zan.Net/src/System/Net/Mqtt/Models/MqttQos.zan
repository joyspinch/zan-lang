using System;
using System.Collections.Generic;
using System.Net.Sockets;

namespace System.Net.Mqtt;

public class MqttQos {
    // 至多一次：不确认、不重传。
    public static const int AtMostOnce = 0;
    // 至少一次：发送后等待 PUBACK。
    public static const int AtLeastOnce = 1;
    // 恰好一次（协议 QoS 2；本客户端发送后并不等待确认，
    // 实际处理与 QoS 0 相同）。
    public static const int ExactlyOnce = 2;
}

// MQTT v3.1.1 客户端。
// 对协程友好：每个网络操作都是 <c>async</c> 方法，
// 通过 <see cref="TcpClient"/> await 底层非阻塞套接字，因此
// 协程内使用的 MQTT 客户端会在 IO reactor 上挂起（将 worker
// 让给其他协程），而不会在等待 broker 应答或传入 PUBLISH 时
// 阻塞操作系统线程。
// 用法：
// int d = await c.DisconnectAsync();
