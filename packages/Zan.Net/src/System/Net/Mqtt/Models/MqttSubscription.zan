using System;
using System.Collections.Generic;
using System.Net.Sockets;

namespace System.Net.Mqtt;

class MqttSubscription {
    string filter;
    int qos;
    MqttSubscription(string filter, int qos) {
        this.filter = filter;
        this.qos = qos;
    }
}

// broker 持有的单个已连接 MQTT 客户端会话：其套接字、客户端 id
// 与当前生效的主题过滤器。
