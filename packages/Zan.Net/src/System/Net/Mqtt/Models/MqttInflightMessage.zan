using System;

namespace System.Net.Mqtt;

// QoS 1 与 QoS 2 飞行中待确认消息条目。
// 用于持久化会话断线恢复与 Broker 崩溃时通过 WAL 恢复未送达/未确认的消息。
public class MqttInflightMessage {
    public string clientId;
    public int packetId;
    public int qos;
    public string topic;
    public string payload;
    public int payloadLen;

    public MqttInflightMessage(string clientId, int packetId, int qos, string topic, string payload, int payloadLen) {
        this.clientId = clientId;
        this.packetId = packetId;
        this.qos = qos;
        this.topic = topic;
        this.payload = payload;
        this.payloadLen = payloadLen;
    }
}
