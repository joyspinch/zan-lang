using System;
using System.Collections.Generic;
using System.Net.Sockets;

namespace System.Net.Mqtt;

public class MqttPacketType {
    // 连接请求。
    public static const int CONNECT = 1;
    // 连接确认。
    public static const int CONNACK = 2;
    // 发布消息。
    public static const int PUBLISH = 3;
    // QoS 1 发布确认。
    public static const int PUBACK = 4;
    // QoS 2 发布已收到（第二阶段）。
    public static const int PUBREC = 5;
    // QoS 2 发布释放（第三阶段）。
    public static const int PUBREL = 6;
    // QoS 2 发布完成（第四阶段）。
    public static const int PUBCOMP = 7;
    // 订阅请求。
    public static const int SUBSCRIBE = 8;
    // 订阅确认。
    public static const int SUBACK = 9;
    // 退订请求。
    public static const int UNSUBSCRIBE = 10;
    // 退订确认。
    public static const int UNSUBACK = 11;
    // 保活请求。
    public static const int PINGREQ = 12;
    // 保活响应。
    public static const int PINGRESP = 13;
    // 断开连接。
    public static const int DISCONNECT = 14;
}

// MQTT QoS 服务等级（编码进 PUBLISH 固定头）。
