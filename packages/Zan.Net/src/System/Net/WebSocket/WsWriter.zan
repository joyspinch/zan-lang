using System;
using System.Collections.Generic;
using System.Net.Sockets;
using System.Net.Tls;

namespace System.Net.WebSocket;

public class WsWriter {
    public byte[] buf;
    public int len;
    public int cap;

    // 内部构造：64KiB 输出缓冲。
    public WsWriter() {
        this.cap = 65536;
        this.buf = new byte[this.cap + 1];
        this.len = 0;
    }

    // 扩展输出缓冲到至少 need 字节（防 32 位翻倍溢出死循环）。
    public void Ensure(int need) {
        if (need <= 0 || need <= this.cap) { return; }
        int nc = this.cap > 0 ? this.cap : 1024;
        while (nc < need) {
            if (nc > 1073741823) { nc = need; break; }
            nc = nc * 2;
        }
        byte[] nb = new byte[nc + 1];
        if (this.len > 0) {
            NativeMemory.Copy((nint)nb, (nint)this.buf, this.len);
        }
        this.buf = nb;
        this.cap = nc;
    }

    // 追加编码后帧的 `n` 个字节。
    public void Append(string data, int n) {
        if (data == null || n <= 0) { return; }
        if (n > 2147483646 - this.len) {
            throw new InvalidOperationException("WsWriter buffer size overflow");
        }
        this.Ensure(this.len + n);
        NativeMemory.PutString((nint)this.buf, this.len, data, n);
        this.len = this.len + n;
    }

    // 缓冲中是否有待发字节。
    public bool Pending() {
        return this.len > 0;
    }

    // 把缓冲内容作为一次 send 全部写出并重置。
    // 返回写出字节数；-1 表示连接已死。Socket.SendAsync 内部
    // 已循环补发，返回值小于请求长度属于对端重置/中止等致命错误，返回 -1。
    public async int Flush(TcpClient client) {
        if (this.len == 0) { return 0; }
        if (client == null) { this.len = 0; return -1; }
        int want = this.len;
        int n = await client.SendBytesAsync(this.buf, want);
        this.len = 0;
        if (n < want) { return -1; }
        return n;
    }

    // 通过 TLS 流循环写出全部缓冲帧并重置；写入不完整或流为空返回 -1。
    public async int FlushTls(TlsStream stream) {
        if (this.len == 0) { return 0; }
        if (stream == null) { this.len = 0; return -1; }
        int want = this.len;
        int totalSent = 0;
        while (totalSent < want) {
            int n = await stream.SendBytesAsync(this.buf, totalSent, want - totalSent);
            if (n <= 0) {
                this.len = 0;
                return -1;
            }
            totalSent = totalSent + n;
        }
        this.len = 0;
        return totalSent;
    }
}

// RFC 6455 §5.4 分片消息重组器：fin=0 的数据帧开启消息，continuation 帧追加，fin=1 交付。
// 负载按显式长度累积（帧字节可能含 NUL），累计超过 maxLen 时返回 -2（由调用方按 1009 关闭）。
