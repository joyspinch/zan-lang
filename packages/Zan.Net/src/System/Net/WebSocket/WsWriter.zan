using System;
using System.Collections.Generic;
using System.Net.Sockets;

namespace System.Net.WebSocket;

public class WsWriter {
    public byte[] buf;
    public int len;
    public int cap;

    // 内部构造：64KiB 输出缓冲。
    public WsWriter() {
        this.cap = 65536;
        this.buf = new byte[this.cap + 1];
        this.len = 0;
    }

    // 扩展输出缓冲到至少 need 字节。
    public void Ensure(int need) {
        if (need <= this.cap) { return; }
        int nc = this.cap * 2;
        while (nc < need) { nc = nc * 2; }
        byte[] nb = new byte[nc + 1];
        if (this.len > 0) {
            NativeMemory.Copy((nint)nb, (nint)this.buf, this.len);
        }
        this.buf = nb;
        this.cap = nc;
    }

    // 追加编码后帧的 `n` 个字节。
    public void Append(string data, int n) {
        if (n <= 0) { return; }
        this.Ensure(this.len + n);
        NativeMemory.PutString((nint)this.buf, this.len, data, n);
        this.len = this.len + n;
    }

    // 缓冲中是否有待发字节。
    public bool Pending() {
        return this.len > 0;
    }

    // 把缓冲内容作为一次 send 全部写出并重置。
    // 返回写出字节数；-1 表示连接已死。Socket.SendAsync 内部
    // 已循环补发，返回值小于请求长度属于对端重置/中止等致命错误，返回 -1。
    public async int Flush(TcpClient client) {
        if (this.len == 0) { return 0; }
        int want = this.len;
        int n = await client.SendBytesAsync(this.buf, want);
        this.len = 0;
        if (n < want) { return 0 - 1; }
        return n;
    }
}

// RFC 6455 §5.4 分片消息重组器：fin=0 的数据帧开始一条消息，
// opcode 0 的 continuation 帧追加负载，fin=1 交付。此前三条
// 服务器/客户端路径都把 continuation 帧静默丢弃——大消息被
// 发送方分片后内容直接丢失且无任何报错。
// // 负载按显式长度累积（帧字节可能含 NUL），累计超过 maxLen
// 时返回 -2，由调用方按 1009 关闭连接。
