using System;
using System.Net.Sockets;
using System.Net.Http;
using System.Net.Tls;
using System.Text;
using System.Security.Cryptography;
using System.Collections.Generic;
using System.Runtime.Intrinsics;
using System.Threading;

namespace System.Net.WebSocket;

// WebSocket 帧操作码（opcode）。
public class WebSocketClient : IDisposable {
    TcpClient conn;
    bool connected;
    string host;
    int port;
    string path;
    // 握手与帧共用一个带显式长度的累积缓冲（WsReader）。
    // 此前用字符串拼接攒帧：Zan 字符串按 NUL 结尾计长，
    // 二进制帧负载里的 NUL 会让帧长判断、Substring 切片
    // 全部错位；且无缓冲上限，对端可慢慢撑爆内存。
    WsReader reader;
    WsAssembler asm;
    bool sendBusy;
    List<AsyncGate> sendWaiters;
    int lastOpcode;
    int lastLen;
    byte[] lastBinary;

    // 构造未连接客户端；经 ConnectAsync 使用。
    public WebSocketClient() {
        this.connected = false;
        this.host = "";
        this.port = 0;
        this.path = "/";
        this.reader = null;
        this.asm = new WsAssembler(16777216);
        this.sendBusy = false;
        this.sendWaiters = new List<AsyncGate>();
        this.lastOpcode = 0;
        this.lastLen = 0;
        this.lastBinary = null;
    }

    // 发起 ws://host:port/path 握手（随机 Sec-WebSocket-Key，校验
    // Sec-WebSocket-Accept）。绝不返回 null：连接/握手失败时返回
    // 一个 connected=false 的对象，用 IsConnected() 判断成败（失败
    // 路径已顺手关闭底层连接）。
    public static async WebSocketClient ConnectAsync(string host, int port, string path) {
        return await WebSocketClient.ConnectAsyncHeaders(host, port, path, null);
    }

    // 带自定义握手头的连接。`headers` 里每一项是一个完整的
    // 头行（如 "Authorization: Bearer xxx"），原样追加在标准握手头
    // 之后——授权在升级前生效的 MVC 路由（needsAuth 检查先于
    // WsUpgrade）没有它就永远 401。行内出现 CR/LF/NUL/DEL 一律
    // 拒绝并按握手失败返回（头注入会伪造额外头/截断握手块），
    // 其余字节不校验——值里写什么由调用方负责。
    public static async WebSocketClient ConnectAsyncHeaders(string host, int port,
            string path, List<string> headers) {
        WebSocketClient ws = new WebSocketClient();
        ws.host = host;
        ws.port = port;
        ws.path = path;

        if (!WsHandshake.SafeRequestPart(host, false)
            || !WsHandshake.SafeRequestPart(path, false)) { return ws; }
        ws.conn = await TcpClient.ConnectAsync(host, port);
        // 连接失败/超时按文档返回 null：解引用是空对象虚调用，进程
        // SIGSEGV。保持 connected=false 由 IsConnected() 检查。
        if (ws.conn == null) { return ws; }

        // RFC 6455 要求客户端握手的 key 是随机的；此前硬编码 RFC 样例
        // nonce，可预测且部分服务器/代理会拒绝重复值。
        byte[] keyBytes = RandomNumberGenerator.GetBytes(16);
        if (keyBytes == null) { ws.conn.Close(); return ws; }
        string key = Base64.Encode(keyBytes, 16);

        StringBuilder sb = new StringBuilder();
        sb.Append("GET ");
        sb.Append(path);
        sb.Append(" HTTP/1.1\r\n");
        sb.Append("Host: ");
        sb.Append(host);
        sb.Append("\r\n");
        sb.Append("Upgrade: websocket\r\n");
        sb.Append("Connection: Upgrade\r\n");
        sb.Append("Sec-WebSocket-Key: ");
        sb.Append(key);
        sb.Append("\r\n");
        sb.Append("Sec-WebSocket-Version: 13\r\n");
        if (headers != null) {
            int hn = headers.Count;
            for (int i = 0; i < hn; i = i + 1) {
                string line = headers[i];
                bool safe = true;
                int ll = line.Length;
                for (int j = 0; j < ll; j = j + 1) {
                    int c = line[j] & 255;
                    if (c == 13 || c == 10 || c == 0 || c == 127) {
                        safe = false;
                        break;
                    }
                }
                if (!safe) { ws.conn.Close(); return ws; }
                sb.Append(line);
                sb.Append("\r\n");
            }
        }
        sb.Append("\r\n");
        await ws.conn.SendAsync(sb.ToString());

        // 响应头可能被 TCP 分段；头之后的字节已是帧（可能含 NUL）。
        // 全部落进 reader 的显式长度缓冲，按字节扫描头部结束标记。
        // 握手接收受 30 秒空闲窗口约束：接受了连接却一个字节不发
        // 的服务端不能再永久钉住本协程（数据阶段的空闲等待仍不设限）。
        ws.reader = new WsReader(ws.conn.GetSocket());
        HttpDeadlineToken watch = HttpDeadline.Arm(ws.conn.GetSocket(), 30000);
        int headerEnd = -1;
        while (headerEnd < 0) {
            if (ws.reader.Buffered() > 65536) {
                HttpDeadline.Disarm(watch);
                ws.conn.Close();
                return ws;
            }
            int n = await ws.reader.FillMore();
            if (n == 0) {
                HttpDeadline.Disarm(watch);
                ws.conn.Close();
                return ws;
            }
            if (HttpDeadline.Expired(watch)) {
                HttpDeadline.Disarm(watch);
                ws.conn.Close();
                return ws;
            }
            headerEnd = ws.reader.FindHeaderEnd();
        }
        HttpDeadline.Disarm(watch);
        string head = ws.reader.Slice(headerEnd);
        string acceptSource = key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";
        string expectedAccept = Base64.Encode(
            Sha1.Hash(acceptSource, acceptSource.Length), 20);
        if (!WsHandshake.ValidResponse(head, expectedAccept)) {
            ws.conn.Close();
            return ws;
        }
        ws.reader.Consume(headerEnd + 4);
        ws.connected = true;

        return ws;
    }

    async void AcquireSend() {
        while (this.sendBusy) {
            AsyncGate g = new AsyncGate();
            this.sendWaiters.Add(g);
            await g.Wait();
            g.Close();
        }
        this.sendBusy = true;
    }

    void ReleaseSend() {
        this.sendBusy = false;
        if (this.sendWaiters.Count > 0) {
            AsyncGate g = this.sendWaiters[0];
            this.sendWaiters.RemoveAt(0);
            g.Signal();
        }
    }

    // 客户端方向统一发送入口：掩码 + 正确的帧长 + 协程互斥串行发送，
    // 彻底消除心跳与并发业务数据帧交叉交错损坏。返回 false 表示连接已不可用。
    async bool SendFrame(int opcode, string payload, int payloadLen) {
        if (!this.connected || this.conn == null || payload == null || payloadLen < 0
            || payloadLen > 16777216
            || (opcode >= 8 && (payloadLen > 125 || opcode > WsOpcode.Pong))
            || (opcode < 0 || opcode > WsOpcode.Pong)) { return false; }
        await this.AcquireSend();
        try {
            WsFrame frame = WsFrame.RawFrame(opcode, payload, payloadLen);
            byte[] encoded = frame.EncodeMasked();
            int total = WsFrame.HeaderLen(payloadLen) + 4 + payloadLen;
            int n = await this.conn.SendBytesAsync(encoded, total);
            if (n <= 0) { this.connected = false; return false; }
            return true;
        } finally {
            this.ReleaseSend();
        }
    }

    // 客户端方向原生字节数组发送入口：掩码 + 帧长 + 协程互斥串行发送。
    async bool SendFrameBytes(int opcode, byte[] payload, int offset, int payloadLen) {
        if (!this.connected || this.conn == null || payload == null || offset < 0 || payloadLen < 0
            || offset + payloadLen > payload.Length
            || payloadLen > 16777216
            || (opcode >= 8 && (payloadLen > 125 || opcode > WsOpcode.Pong))
            || (opcode < 0 || opcode > WsOpcode.Pong)) { return false; }
        await this.AcquireSend();
        try {
            WsFrame frame = WsFrame.RawBytes(opcode, payload, offset, payloadLen);
            byte[] encoded = frame.EncodeMasked();
            int total = WsFrame.HeaderLen(payloadLen) + 4 + payloadLen;
            int n = await this.conn.SendBytesAsync(encoded, total);
            if (n <= 0) { this.connected = false; return false; }
            return true;
        } finally {
            this.ReleaseSend();
        }
    }

    // 发送一条 Text 消息（fire-and-forget，失败仅置 disconnected）。
    public async void SendText(string text) {
        await this.SendFrame(WsOpcode.Text, text, text.Length);
    }

    // 发送一条二进制消息（data 可含 NUL，len 为精确字节数）。
    public async void SendBinary(string data, int len) {
        await this.SendFrame(WsOpcode.Binary, data, len);
    }

    // 发送一条二进制消息（byte[] 原生切片，无需经过字符串中转）。
    public async void SendBinary(byte[] data, int offset, int len) {
        await this.SendFrameBytes(WsOpcode.Binary, data, offset, len);
    }

    // 发送一条完整二进制消息。
    public async void SendBinary(byte[] data) {
        if (data == null) { return; }
        await this.SendFrameBytes(WsOpcode.Binary, data, 0, data.Length);
    }

    // 发送空 Ping 帧（对端的 Pong 由 RecvText 静默消费）。
    public async void Ping() {
        await this.SendFrame(WsOpcode.Ping, "", 0);
    }

    // 上一次成功接收并交付的消息操作码（WsOpcode.Text 或 WsOpcode.Binary）。
    public int LastOpcode() { return this.lastOpcode; }

    // 上一次成功接收并交付的消息精确字节数。
    public int LastLength() { return this.lastLen; }

    // 挂起直到下一个文本/二进制消息。Ping 以 Pong 应答后
    // 继续循环；分片消息重组到 fin 后整条交付；Close 或断开
    // 返回 ""。
    public async string RecvText() {
        return await this.RecvText(0);
    }

    // 带空闲窗口的 RecvText：时限内没有任何帧到达时返回 ""
    // ——连接未断，IsConnected() 仍为 true，已收到的半截帧留在
    // 缓冲区里下次接着读；这正是心跳调用方的判据（超时 → Ping()
    // → 继续 RecvText(timeout)）。真正的断开（对端关闭帧/EOF/协议
    // 错误）会 CloseNow，IsConnected() 变 false。timeoutMs 非正表示
    // 不限时。空数据消息与空闲超时都返回 ""，无法区分——协议上
    // 不发空消息（发心跳用 Ping）就没有歧义。
    public async string RecvText(int timeoutMs) {
        while (this.connected) {
            int total = this.reader.FrameSize();
            while (total < 0) {
                if (total == -2 || total == -3) { this.CloseNow(); return ""; }
                int n = await this.reader.FillMore(timeoutMs);
                if (n == 0) { this.CloseNow(); return ""; }
                if (n < 0) { return ""; }   // 空闲窗口到，连接保持
                total = this.reader.FrameSize();
            }
            WsFrame frame = this.reader.TakeFrame(total);
            if (!WsFrame.ValidInbound(frame, false)) {
                // RFC 6455：客户端收到的服务端帧不得掩码，且 RSV、控制帧
                // 和关闭负载必须满足协议约束。
                this.CloseNow();
                return "";
            }
            if (frame.opcode == WsOpcode.Close) {
                await this.SendFrame(WsOpcode.Close, "", 0);
                this.CloseNow();
                return "";
            }
            if (frame.opcode == WsOpcode.Ping) {
                await this.SendFrame(WsOpcode.Pong, frame.payload, frame.payloadLen);
                continue;
            }
            if (frame.opcode == WsOpcode.Pong) { continue; }
            // 数据帧：分片消息在 fin 时整条交付——此前 continuation
            // 帧被静默丢弃。
            int feed = this.asm.Feed(frame);
            if (feed < 0) { this.CloseNow(); return ""; }
            if (feed == 0) { continue; }
            if (!this.asm.ValidComplete()) {
                this.CloseNow();
                return "";
            }
            this.lastOpcode = this.asm.MessageOpcode();
            this.lastLen = this.asm.MessageLen();
            this.lastBinary = null;
            return this.asm.Complete();
        }
        return "";
    }

    // 挂起直到下一个文本/二进制消息。返回未截断的原生 byte[]，
    // 彻底消除二进制消息中 NUL 字符被字符串截断的隐患；Close 或断开返回 null。
    public async byte[] RecvBinary() {
        return await this.RecvBinary(0);
    }

    // 带空闲窗口的原生二进制消息接收。
    public async byte[] RecvBinary(int timeoutMs) {
        while (this.connected) {
            int total = this.reader.FrameSize();
            while (total < 0) {
                if (total == -2 || total == -3) { this.CloseNow(); return null; }
                int n = await this.reader.FillMore(timeoutMs);
                if (n == 0) { this.CloseNow(); return null; }
                if (n < 0) { return null; }
                total = this.reader.FrameSize();
            }
            WsFrame frame = this.reader.TakeFrame(total);
            if (!WsFrame.ValidInbound(frame, false)) {
                this.CloseNow();
                return null;
            }
            if (frame.opcode == WsOpcode.Close) {
                await this.SendFrame(WsOpcode.Close, "", 0);
                this.CloseNow();
                return null;
            }
            if (frame.opcode == WsOpcode.Ping) {
                await this.SendFrame(WsOpcode.Pong, frame.payload, frame.payloadLen);
                continue;
            }
            if (frame.opcode == WsOpcode.Pong) { continue; }
            int feed = this.asm.Feed(frame);
            if (feed < 0) { this.CloseNow(); return null; }
            if (feed == 0) { continue; }
            if (!this.asm.ValidComplete()) {
                this.CloseNow();
                return null;
            }
            this.lastOpcode = this.asm.MessageOpcode();
            this.lastLen = this.asm.MessageLen();
            byte[] bytes = this.asm.CompleteBytes();
            this.lastBinary = bytes;
            return bytes;
        }
        return null;
    }

    // 立即断开（不发关闭帧）；RecvText 之后返回 ""。
    public void CloseNow() {
        this.connected = false;
        if (this.conn != null) { this.conn.Close(); }
    }

    // 协礼关闭：先发空关闭帧再断开。
    public async void Close() {
        if (this.connected) {
            await this.SendFrame(WsOpcode.Close, "", 0);
        }
        this.CloseNow();
    }

    // 释放资源（实现 IDisposable）。
    public void Dispose() {
        this.CloseNow();
    }

    // 握手是否成功且连接未断。
    public bool IsConnected() {
        return this.connected;
    }
}
