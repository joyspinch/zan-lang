using System;
using System.Collections.Generic;
using System.Net.Sockets;
using System.Net.Http;
using System.Net.Tls;
using System.Text;
using System.Security.Cryptography;
using System.Threading;

namespace System.Net.WebSocket.Secure;

// 处理一条已解码的文本/二进制消息；返回值会发回客户端（为 null 或空串则不发送）。
public async delegate string WssMessageHandler(string message);

// 包含连接上下文的 WSS 消息处理器（可访问 conn.SendAsync / conn.CloseAsync 等）
public async delegate string WssContextMessageHandler(WssConnection conn, string message);

// WSS 客户端连接/断开事件处理器
public async delegate void WssConnectionHandler(WssConnection conn);

// 单条活跃 TLS WebSocket (wss://) 客户端连接上下文
public class WssConnection : IDisposable {
    public nint sock;
    public TlsStream stream;
    public bool connected;
    private Mutex sendLock;

    public WssConnection(nint sock, TlsStream stream) {
        this.sock = sock;
        this.stream = stream;
        this.connected = true;
        this.sendLock = new Mutex();
    }

    // 异步发送文本帧（RFC 6455 Opcode 1）
    public async int SendAsync(string text) {
        if (!this.connected || text == null) { return -1; }
        byte[] payload = text.ToBytes();
        WsFrame frame = WsFrame.RawFrame(WsOpcode.Text, payload, payload.Length);
        byte[] encoded = frame.Encode();
        int frameLen = WsFrame.HeaderLen(payload.Length) + payload.Length;

        this.sendLock.WaitOne();
        try {
            int r = await this.stream.SendAsync(encoded, frameLen);
            return r;
        } finally {
            this.sendLock.ReleaseMutex();
        }
    }

    // 异步发送二进制帧（RFC 6455 Opcode 2）
    public async int SendBytesAsync(byte[] data, int len) {
        if (!this.connected || data == null || len <= 0) { return -1; }
        WsFrame frame = WsFrame.RawFrame(WsOpcode.Binary, data, len);
        byte[] encoded = frame.Encode();
        int frameLen = WsFrame.HeaderLen(len) + len;

        this.sendLock.WaitOne();
        try {
            int r = await this.stream.SendAsync(encoded, frameLen);
            return r;
        } finally {
            this.sendLock.ReleaseMutex();
        }
    }

    // 发送 Ping 探活帧（RFC 6455 Opcode 9）
    public async void PingAsync() {
        if (!this.connected) { return; }
        WsFrame ping = WsFrame.RawFrame(WsOpcode.Ping, new byte[0], 0);
        byte[] encoded = ping.Encode();

        this.sendLock.WaitOne();
        try {
            await this.stream.SendAsync(encoded, 2);
        } catch (Exception ex) {
        } finally {
            this.sendLock.ReleaseMutex();
        }
    }

    // 发送正常关闭帧（RFC 6455 Opcode 8）并优雅断开连接
    public async void CloseAsync() {
        if (!this.connected) { return; }
        this.connected = false;
        WsFrame close = WsFrame.CloseFrame();
        byte[] encoded = close.Encode();

        this.sendLock.WaitOne();
        try {
            await this.stream.SendAsync(encoded, 2);
        } catch (Exception ex) {
        } finally {
            this.sendLock.ReleaseMutex();
            if (this.stream != null) { this.stream.Close(); }
            if (this.sock >= 0) { Socket.Close(this.sock); this.sock = -1; }
        }
    }

    public void Dispose() {
        this.connected = false;
        if (this.stream != null) { this.stream.Close(); }
        if (this.sock >= 0) { Socket.Close(this.sock); this.sock = -1; }
    }
}

// 基于 TLS 的 WebSocket（wss://）高性能服务器。
// 具备完整 RFC 6455 掩码校验、16MiB 分片防爆重组、Ping-Pong 回显、优雅双向关闭握手、
// 连接生命周期管理与多端全局并发广播能力。
public class WssServer : IDisposable {
    public TcpListener listener;
    public TlsContext tls;
    public string host;
    public int port;
    public bool running;
    public int activeConnections;
    public int maxConnections;
    public int requestTimeoutMs;
    public WssMessageHandler messageHandler;
    public WssContextMessageHandler contextHandler;
    public WssConnectionHandler connectHandler;
    public WssConnectionHandler closeHandler;
    public List<WssConnection> connections;
    private Mutex connLock;

    public WssServer(string host, int port) {
        this.host = host;
        this.port = port;
        this.running = false;
        this.activeConnections = 0;
        this.maxConnections = 10000;
        this.requestTimeoutMs = 30000;
        this.messageHandler = null;
        this.contextHandler = null;
        this.connectHandler = null;
        this.closeHandler = null;
        this.tls = null;
        this.connections = new List<WssConnection>();
        this.connLock = new Mutex();
    }

    // 从 PEM 证书链和 PEM 私钥创建
    // wss 服务器。证书/私钥无法加载时返回 null。
    public static WssServer Create(string host, int port, string certFile, string keyFile) {
        WssServer server = new WssServer(host, port);
        server.tls = TlsContext.CreateServer(certFile, keyFile);
        if (server.tls == null) {
            return null;
        }
        return server;
    }

    // 注册每消息处理器；其返回值会发回
    // 客户端。不注册时回退到 <see cref="OnMessage(string)"/>
    // （子类重写路径，与 Worker 的 onMessage 同款）。
    public WssServer OnMessage(WssMessageHandler handler) {
        this.messageHandler = handler;
        return this;
    }

    public WssServer OnContextMessage(WssContextMessageHandler handler) {
        this.contextHandler = handler;
        return this;
    }

    public WssServer OnConnect(WssConnectionHandler handler) {
        this.connectHandler = handler;
        return this;
    }

    public WssServer OnClose(WssConnectionHandler handler) {
        this.closeHandler = handler;
        return this;
    }

    // 设置最大并发连接数；超限连接立即关闭（TLS 连接各持
    // SSL/BIO 与缓冲，必须设闸）。
    public WssServer SetMaxConnections(int max) {
        this.maxConnections = max;
        return this;
    }

    // 设置 TLS 握手及 Upgrade 头的超时（毫秒）。默认 30 秒；
    // 非正值禁用超时，建立连接后的帧循环不受此限制。
    public WssServer SetTimeout(int ms) {
        this.requestTimeoutMs = ms;
        return this;
    }

    // 开始接受连接并逐条派发处理协程；running 置位后阻塞循环，
    // 直到 Stop() 被调用（从其他协程）。
    public async void Start() {
        Socket.Initialize();
        this.listener = new TcpListener(this.host, this.port);
        this.listener.Start();
        this.running = true;

        while (this.running) {
            nint clientSock = await this.listener.AcceptAsync();
            if (clientSock >= 0) {
                if (this.activeConnections >= this.maxConnections) {
                    // 与 HttpServer/HttpsServer 同闸：超限直接挂断。
                    Socket.Close(clientSock);
                    continue;
                }
                this.activeConnections = this.activeConnections + 1;
                Task.Spawn(HandleConnection(clientSock));
            }
        }
    }

    private void AddConnection(WssConnection conn) {
        this.connLock.WaitOne();
        try {
            this.connections.Add(conn);
        } finally {
            this.connLock.ReleaseMutex();
        }
    }

    private void RemoveConnection(WssConnection conn) {
        this.connLock.WaitOne();
        try {
            for (int i = 0; i < this.connections.Count; i = i + 1) {
                if (this.connections[i] == conn) {
                    this.connections.RemoveAt(i);
                    break;
                }
            }
        } finally {
            this.connLock.ReleaseMutex();
        }
    }

    // 向当前所有活跃 WSS 客户端广播文本消息
    public void Broadcast(string message) {
        if (message == null || message.Length == 0) { return; }
        this.connLock.WaitOne();
        try {
            for (int i = 0; i < this.connections.Count; i = i + 1) {
                WssConnection c = this.connections[i];
                if (c.connected) {
                    Task.Spawn(c.SendAsync(message));
                }
            }
        } finally {
            this.connLock.ReleaseMutex();
        }
    }

    // 请求停止接受连接并优雅断开所有客户端；在途连接处理完当前消息后自然收尾。
    public void Stop() {
        this.running = false;
        if (this.listener != null) {
            this.listener.Stop();
        }
        this.connLock.WaitOne();
        try {
            for (int i = 0; i < this.connections.Count; i = i + 1) {
                this.connections[i].CloseAsync();
            }
            this.connections.Clear();
        } finally {
            this.connLock.ReleaseMutex();
        }
    }

    public void Dispose() {
        this.Stop();
    }

    // 单条连接的生命周期：TLS 握手 → WebSocket Upgrade（缺 Upgrade
    // 或 Sec-WebSocket-Key 时回 400）→ 帧循环（Ping→Pong、Close 应答
    // 并断开、协议违规回 1002/1009 关闭帧）；每条消息交
    // OnMessageInternal，返回值按原 opcode 发回。任何退出路径都
    // 关闭流与 socket 并归还连接计数——清理在 finally 中执行：
    // 处理器抛出的异常会跳过顺序清理，泄漏 fd/SSL 与计数
    // （计数漂移会让服务器在 maxConnections 处永久拒绝新连接）。
    private async void HandleConnection(nint clientSock) {
        try {
            await this.HandleConnectionInner(clientSock);
        } finally {
            this.activeConnections = this.activeConnections - 1;
        }
    }

    // HandleConnection 的服务体；计数归还见 HandleConnection 的 finally。
    private async void HandleConnectionInner(nint clientSock) {
        Socket.SetNonBlocking(clientSock);
        // TLS 协商也必须受配置的时限约束，不能只给 Upgrade 头设限。
        TlsStream stream = await TlsStream.AcceptAsync(this.tls, clientSock,
            this.requestTimeoutMs);
        if (stream == null) {
            Socket.Close(clientSock);
            return;
        }

        HttpDeadlineToken watch = HttpDeadline.Arm(clientSock, this.requestTimeoutMs);
        WssConnection conn = null;
        try {
            // 握手与后续帧共用一个 WsReader（TLS 字节源）：握手可能被
            // TLS 记录边界拆开，而与握手同批到达的首帧字节可能含 NUL
            // ——一律按显式字节数累积与扫描。
            WsReader reader = WsReader.WrapTls(stream);
            int headerEnd = -1;
            bool alive = true;
            while (alive) {
                headerEnd = reader.FindHeaderEnd();
                if (HttpDeadline.Expired(watch)) { alive = false; break; }
                if (headerEnd >= 0) { break; }
                if (reader.Buffered() > 65536) {
                    alive = false;
                    break;
                }
                int n = await reader.FillMore();
                if (n <= 0 || HttpDeadline.Expired(watch)) { alive = false; }
            }
            if (!alive) { return; }

            string head = reader.Slice(headerEnd + 4);
            if (HttpDeadline.Expired(watch)) { return; }
            HttpRequest req = HttpRequest.Parse(head);

            if (!WsHandshake.Valid(req)) {
                string badData = "HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\nConnection: close\r\n\r\n";
                int _e = await stream.SendAsync(badData, badData.Length);
                return;
            }
            string wsKey = req.GetHeader("Sec-WebSocket-Key");
            string acceptKey = Encoding.WebSocketAccept(wsKey);

            StringBuilder sb = new StringBuilder();
            sb.Append("HTTP/1.1 101 Switching Protocols\r\n");
            sb.Append("Upgrade: websocket\r\n");
            sb.Append("Connection: Upgrade\r\n");
            sb.Append("Sec-WebSocket-Accept: ");
            sb.Append(acceptKey);
            sb.Append("\r\n\r\n");
            string hs = sb.ToString();
            if (HttpDeadline.Expired(watch)) { return; }
            int _h = await stream.SendAsync(hs, hs.Length);
            bool timedOut = HttpDeadline.Expired(watch);
            HttpDeadline.Disarm(watch);
            watch = null;
            if (_h < 0 || timedOut) { return; }

            // 与升级请求同批到达的首批帧已留在 reader 里，跳过握手
            // 字节继续使用即可。
            reader.Consume(headerEnd + 4);
            conn = new WssConnection(clientSock, stream);
            this.AddConnection(conn);
            if (this.connectHandler != null) {
                await this.connectHandler(conn);
            }

            WsAssembler asm = new WsAssembler(reader.MaxLen());
            while (conn.connected) {
                int total = reader.FrameSize();
                while (total < 0) {
                    if (total == -2 || total == -3) {
                        // -2 = 帧长编码违规（1002）；-3 = 消息过大（1009）。
                        byte[] enc = WsFrame.CloseFrameWithCode(total == -3 ? 1009 : 1002).Encode();
                        int _v = await stream.SendAsync(enc, 4);
                        conn.connected = false;
                        break;
                    }
                    int n = await reader.FillMore();
                    if (n <= 0) {
                        conn.connected = false;
                        break;
                    }
                    total = reader.FrameSize();
                }
                if (!conn.connected) { break; }

                WsFrame frame = reader.TakeFrame(total);

                // RFC 6455 入站帧门禁：统一复用公共校验，包含 RSV、掩码、
                // 控制帧边界、保留 opcode 与 Close code/reason UTF-8。
                if (!WsFrame.ValidInbound(frame, true)) {
                    byte[] enc = WsFrame.CloseFrameWithCode(1002).Encode();
                    int _v = await stream.SendAsync(enc, 4);
                    conn.connected = false;
                    break;
                }
                if (frame.opcode == WsOpcode.Ping) {
                    // §5.5.3：Pong 原样带回 Ping 的应用数据。
                    WsFrame pong = WsFrame.RawFrame(WsOpcode.Pong, frame.payload, frame.payloadLen);
                    byte[] encoded = pong.Encode();
                    int _p = await stream.SendAsync(encoded, WsFrame.HeaderLen(frame.payloadLen) + frame.payloadLen);
                    continue;
                }
                if (frame.opcode == WsOpcode.Pong) { continue; }
                if (frame.opcode == WsOpcode.Close) {
                    WsFrame closeResp = WsFrame.CloseFrame();
                    byte[] encoded = closeResp.Encode();
                    int _c = await stream.SendAsync(encoded, 2);
                    conn.connected = false;
                    break;
                }
                // 数据帧：分片消息在 fin 时整条交付——此前 continuation
                // 帧被静默丢弃。
                int feed = asm.Feed(frame);
                if (feed < 0) {
                    byte[] enc = WsFrame.CloseFrameWithCode(feed == -2 ? 1009 : 1002).Encode();
                    int _v = await stream.SendAsync(enc, 4);
                    conn.connected = false;
                    break;
                }
                if (feed == 0) { continue; }
                if (!asm.ValidComplete()) {
                    byte[] encUtf = WsFrame.CloseFrameWithCode(1007).Encode();
                    int _u = await stream.SendAsync(encUtf, 4);
                    conn.connected = false;
                    break;
                }

                int msgOpcode = asm.MessageOpcode();
                string message = asm.Complete();
                string response = null;
                if (this.contextHandler != null) {
                    response = await this.contextHandler(conn, message);
                } else {
                    response = await OnMessageInternal(message);
                }

                if (response != null && response.Length > 0 && conn.connected) {
                    if (response.Length > 16777216) {
                        byte[] encBig = WsFrame.CloseFrameWithCode(1009).Encode();
                        int _big = await stream.SendAsync(encBig, 4);
                        conn.connected = false;
                        break;
                    }
                    int respLen = response.Length;
                    WsFrame respFrame = WsFrame.BinaryFrame(response, respLen);
                    respFrame.opcode = msgOpcode;
                    byte[] respEnc = respFrame.Encode();
                    int sent = await stream.SendAsync(respEnc, WsFrame.HeaderLen(respLen) + respLen);
                    if (sent < 0) { conn.connected = false; }
                }
            }
        } finally {
            HttpDeadline.Disarm(watch);
            if (conn != null) {
                this.RemoveConnection(conn);
                if (this.closeHandler != null) {
                    try {
                        await this.closeHandler(conn);
                    } catch (Exception ex) {}
                }
                conn.Dispose();
            } else {
                if (stream != null) { stream.Close(); }
                Socket.Close(clientSock);
            }
        }
    }

    // 每消息分发：注册了委托走委托，否则走可重写的 OnMessage。
    private async string OnMessageInternal(string message) {
        WssMessageHandler handler = this.messageHandler;
        if (handler != null) {
            return await handler(message);
        }
        return await OnMessage(message);
    }

    // 子类重写路径：未注册委托时每条消息走这里，
    // 返回值发回客户端（默认原样 echo）。
    private async string OnMessage(string message) {
        return message;
    }
}
