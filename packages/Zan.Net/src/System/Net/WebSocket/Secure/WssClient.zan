using System;
using System.Net.Sockets;
using System.Net.Tls;
using System.Net.Http;
using System.Net.WebSocket;
using System.Security.Cryptography;

namespace System.Net.WebSocket.Secure;

// 基于 TLS 的 RFC 6455 WebSocket 客户端，客户端帧带掩码。
public class WssClient : IDisposable {

    private TcpClient conn;
    private TlsContext context;
    private TlsStream stream;
    private string host;
    private string path;
    // 握手与帧共用一个带显式长度的累积缓冲（WsReader）。
    // 此前用字符串拼接攒帧：帧负载里的 NUL 会让按 strlen 计长
    // 的帧长判断与切片全部错位。
    private WsReader reader;
    private WsClientSession session;

    // 构造未连接客户端；经 ConnectAsync 使用。
    public WssClient() {
        this.host = "";
        this.path = "/";
        this.reader = null;
        this.session = new WsClientSession();
    }

    // 发起 wss://host:port/path 握手：TCP 连接 → TLS 握手（带 SNI
    // 与证书校验）→ WebSocket Upgrade（随机 key，校验 Sec-WebSocket-
    // Accept）。绝不返回 null：任何一步失败都返回 connected=false
    // 的对象（失败路径已清理连接/上下文），用 IsConnected() 判断。
    public static async WssClient ConnectAsync(string host, int port, string path) {
        return await WssClient.ConnectContextAsync(host, port, path, null);
    }

    // An explicitly configured context is owned by this connection, including
    // failures before TLS starts. Public connections always use system trust.
    internal static async WssClient ConnectContextAsync(string host, int port, string path,
            TlsContext context) {
        WssClient client = new WssClient();
        client.context = context;
        client.host = host;
        client.path = path;
        if (!WsHandshake.SafeRequestPart(host, false)
            || !WsHandshake.SafeRequestPart(path, false)) { client.CloseNow(); return client; }
        client.conn = await TcpClient.ConnectAsync(host, port);
        if (client.conn == null) { client.CloseNow(); return client; }
        if (client.context == null) { client.context = TlsContext.CreateClient(); }
        if (client.context == null) { client.CloseNow(); return client; }
        client.stream = await TlsStream.ConnectAsync(client.context,
                                                      client.conn.Sock(), host);
        if (client.stream == null) {
            client.CloseNow(); return client;
        }

        byte[] keyBytes = RandomNumberGenerator.GetBytes(16);
        if (keyBytes == null || keyBytes.Length < 16) {
            client.CloseNow();
            return client;
        }
        string key = Base64.Encode(keyBytes, 16);
        string request = "GET " + path + " HTTP/1.1\r\n"
            + "Host: " + host + "\r\n"
            + "Upgrade: websocket\r\n"
            + "Connection: Upgrade\r\n"
            + "Sec-WebSocket-Key: " + key + "\r\n"
            + "Sec-WebSocket-Version: 13\r\n\r\n";
        int sent = await client.stream.SendAsync(request, request.Length);
        if (sent <= 0) { client.CloseNow(); return client; }

        // 响应头可能被 TLS 记录边界拆开；头之后的字节已是帧
        // （可能含 NUL）。全部落进 reader 的显式长度缓冲。握手接收
        // 受 30 秒空闲窗口约束，与明文 ws 客户端一致。
        client.reader = WsReader.WrapTls(client.stream);
        HttpDeadlineToken watch = HttpDeadline.Arm(client.conn.Sock(), 30000);
        int headerEnd = -1;
        while (headerEnd < 0) {
            if (!WsHandshake.HeaderWithinLimit(-1, client.reader.Buffered())) {
                HttpDeadline.Disarm(watch);
                client.CloseNow();
                return client;
            }
            int n = await client.reader.FillMore();
            if (n == 0) {
                HttpDeadline.Disarm(watch);
                client.CloseNow();
                return client;
            }
            if (HttpDeadline.Expired(watch)) {
                HttpDeadline.Disarm(watch);
                client.CloseNow();
                return client;
            }
            headerEnd = client.reader.FindHeaderEnd();
            if (!WsHandshake.HeaderWithinLimit(headerEnd, client.reader.Buffered())) {
                HttpDeadline.Disarm(watch);
                client.CloseNow();
                return client;
            }
        }
        HttpDeadline.Disarm(watch);
        string head = client.reader.Slice(headerEnd);
        string acceptSource = key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";
        string expectedAccept = Base64.Encode(
            Sha1.Hash(acceptSource, acceptSource.Length), 20);
        if (!WsHandshake.ValidResponse(head, expectedAccept)) {
            client.CloseNow();
            return client;
        }
        client.reader.Consume(headerEnd + 4);
        client.session.Open(client.conn, client.stream, client.context, client.reader);
        client.conn = null;
        client.reader = null;
        client.stream = null;
        client.context = null;
        return client;
    }

    // 握手是否成功且连接未断。
    public bool IsConnected() { return this.session.IsConnected(); }

    // 发送一条 Text 消息（fire-and-forget；发送失败会就地断开）。
    public async void SendText(string text) {
        await this.session.SendFrame(WsOpcode.Text, text, text.Length);
    }

    // 发送一条二进制消息（bytes 可含 NUL，len 为精确字节数）。
    public async void SendBinary(string bytes, int len) {
        await this.session.SendFrame(WsOpcode.Binary, bytes, len);
    }

    // 发送一条二进制消息（byte[] 原生切片，无需经过字符串中转）。
    public async void SendBinary(byte[] bytes, int offset, int len) {
        await this.session.SendFrameBytes(WsOpcode.Binary, bytes, offset, len);
    }

    // 发送一条完整二进制消息。
    public async void SendBinary(byte[] bytes) {
        if (bytes == null) { return; }
        await this.session.SendFrameBytes(WsOpcode.Binary, bytes, 0, bytes.Length);
    }

    // 发送空 Ping 帧（对端的 Pong 由 RecvText 静默消费）。
    public async void Ping() { await this.session.SendFrame(WsOpcode.Ping, "", 0); }

    // 上一次成功接收并交付的消息操作码（WsOpcode.Text 或 WsOpcode.Binary）。
    public int LastOpcode() { return this.session.LastOpcode(); }

    // 上一次成功接收并交付的消息精确字节数。
    public int LastLength() { return this.session.LastLength(); }

    // 挂起直到下一个文本/二进制消息（分片消息重组到 fin 后整条
    // 交付；Ping 以 Pong 应答后继续；Close、协议错误（-2/-3）或
    // 断开返回 ""）。
    public async string RecvText() {
        return await this.session.RecvText(0);
    }

    // 挂起直到下一个文本/二进制消息。返回未截断的原生 byte[]，
    // 彻底消除二进制消息中 NUL 字符被字符串截断的隐患；Close 或断开返回 null。
    public async byte[] RecvBinary() {
        return await this.session.RecvBinary(0);
    }

    // 协礼关闭：先发空关闭帧（未连接时跳过），随后无条件断开并
    // 释放 TLS 流与上下文；重复调用安全。
    public async void Close() {
        await this.session.Close();
        this.CloseNow();
    }

    // 立即断开并释放全部句柄（TLS 流、连接、上下文、reader）。
    public void CloseNow() {
        this.session.CloseNow();
        if (this.stream != null) { this.stream.Close(); this.stream = null; }
        if (this.conn != null) { this.conn.Close(); this.conn = null; }
        if (this.context != null) { this.context.Free(); this.context = null; }
        this.reader = null;
    }

    public void Dispose() {
        this.CloseNow();
    }

    // 从响应头文本里取单个头值（ASCII 大小写不敏感，跳过状态行，
}
