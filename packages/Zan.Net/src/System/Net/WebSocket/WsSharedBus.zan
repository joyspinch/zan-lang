// 核心契约与语义定义。

using System;
using System.Diagnostics;
using System.Threading;

namespace System.Net.WebSocket;

// 跨进程 WebSocket 共享消息总线事件接收接口。
interface IWsSharedBusConsumer {
    void OnSharedBusMessage(int targetType, string channel, int targetId, string payload, int payloadLen);
}

// 基于 SharedTable 共享内存环形缓冲区的跨进程 WebSocket/长连接消息总线。
// 零外部依赖，基于系统共享内存（Windows MMF / POSIX shm）提供极高吞吐的
// 跨 Worker 进程事件分发：
// targetType = 0: 全局广播（向所有 worker 的所有连接广播）
// targetType = 1: 频道/房间广播（向所有 worker 中加入指定 channel 的连接广播）
// targetType = 2: 定向投递（向特定 connection ID 所在 worker 精准单播）
// 并提供跨进程实时的集群连接总数原子计数（ClusterConnCount）。
class WsSharedBus {
    SharedTable busTable;
    string name;
    int ringCapacity;
    long lastReadSeq;
    bool running;
    int pid;
    long busNonce;
    static long nonceCounter = 0;

    public WsSharedBus(string name, int ringCapacity) {
        this.name = name;
        this.ringCapacity = ringCapacity;
        this.lastReadSeq = 0;
        this.running = false;
        this.pid = ProcessHost.Pid();
        nonceCounter = nonceCounter + 1;
        this.busNonce = nonceCounter;
        this.InitTable();
    }

    void InitTable() {
        SharedTable table = SharedTable.Open(this.name);
        if (table != null && table.IsOpen()) {
            this.busTable = table;
        } else {
            table = new SharedTable(this.name, this.ringCapacity + 16);
            table.KeySize(32);
            table.ColumnInt("targetType");
            table.ColumnString("channel", 64);
            table.ColumnInt("targetId");
            table.ColumnString("payload", 4096);
            table.ColumnInt("payloadLen");
            table.ColumnInt("seq");
            table.ColumnInt("srcPid");
            table.ColumnInt("srcBus");
            // OnConnChange/GetTotalConnCount 走自增列：列必须在建表时声明，
            // 否则 zan_find_column 落空、Increment/GetInt 双双静默得 0。
            table.ColumnInt("totalConns");
            if (table.Create()) {
                this.busTable = table;
            } else {
                this.busTable = SharedTable.Open(this.name);
            }
        }
    }

    public bool IsAvailable() {
        return this.busTable != null && this.busTable.IsOpen();
    }

    // 发布跨进程全局广播消息。
    public void PublishBroadcast(string payload, int payloadLen) {
        this.PublishInternal(0, "", 0, payload, payloadLen);
    }

    // 发布跨进程频道/房间广播消息。
    public void PublishChannel(string channel, string payload, int payloadLen) {
        this.PublishInternal(1, channel, 0, payload, payloadLen);
    }

    // 发布跨进程针对指定连接 ID 的定向投递消息。
    public void PublishDirect(int targetId, string payload, int payloadLen) {
        this.PublishInternal(2, "", targetId, payload, payloadLen);
    }

    void PublishInternal(int targetType, string channel, int targetId, string payload, int payloadLen) {
        if (!this.IsAvailable()) { return; }
        long seq = this.busTable.Increment("bus_meta", "seq", 1);
        int slot = (int)(seq % (long)this.ringCapacity);
        string key = "slot_" + Convert.ToString(slot);
        this.busTable.SetInt(key, "targetType", (long)targetType);
        this.busTable.SetString(key, "channel", channel);
        this.busTable.SetInt(key, "targetId", (long)targetId);
        this.busTable.SetString(key, "payload", payload);
        this.busTable.SetInt(key, "payloadLen", (long)payloadLen);
        this.busTable.SetInt(key, "srcPid", (long)this.pid);
        this.busTable.SetInt(key, "srcBus", this.busNonce);
        this.busTable.SetInt(key, "seq", seq);
    }

    // 增减全局在线连接数统计。
    public void OnConnChange(int delta) {
        if (!this.IsAvailable()) { return; }
        this.busTable.Increment("bus_meta", "totalConns", (long)delta);
    }

    // 获取集群跨 Worker 实时在线连接总数。
    public int GetTotalConnCount() {
        if (!this.IsAvailable()) { return 0; }
        long val = this.busTable.GetInt("bus_meta", "totalConns");
        if (val < 0) { return 0; }
        return (int)val;
    }

    // 启动后台轮询协程，监听其他 Worker 发来的跨进程消息。
    // 必须是同步方法：Zan 的 async 方法体在首次调度泵时才启动，
    // 若把快照写进 async 体，调用点与首次泵之间发布的消息会被当旧序号跳过。
    // 快照必须在调用点急切完成，循环体晚一点启动无所谓。
    public void StartPolling(IWsSharedBusConsumer consumer) {
        if (this.running || !this.IsAvailable() || consumer == null) { return; }
        this.running = true;
        this.lastReadSeq = this.busTable.GetInt("bus_meta", "seq");
        this.PollLoop(consumer);
    }

    private async void PollLoop(IWsSharedBusConsumer consumer) {
        while (this.running) {
            long head = this.busTable.GetInt("bus_meta", "seq");
            if (head > this.lastReadSeq) {
                long start = this.lastReadSeq + 1;
                if (head - start >= (long)this.ringCapacity) {
                    start = head - (long)this.ringCapacity + 1;
                }
                while (start <= head) {
                    int slot = (int)(start % (long)this.ringCapacity);
                    string key = "slot_" + Convert.ToString(slot);
                    long slotSeq = this.busTable.GetInt(key, "seq");
                    if (slotSeq == start) {
                        int srcPid = (int)this.busTable.GetInt(key, "srcPid");
                        long srcBus = this.busTable.GetInt(key, "srcBus");
                        // 自过滤按 (pid, 实例 nonce) 判定：同进程多 worker 各持
                        // 独立实例必须互相收到消息，只按 pid 会把同进程节点全滤掉。
                        if (srcPid != this.pid || srcBus != this.busNonce) {
                            int targetType = (int)this.busTable.GetInt(key, "targetType");
                            string channel = this.busTable.GetString(key, "channel");
                            int targetId = (int)this.busTable.GetInt(key, "targetId");
                            string payload = this.busTable.GetString(key, "payload");
                            int payloadLen = (int)this.busTable.GetInt(key, "payloadLen");
                            consumer.OnSharedBusMessage(targetType, channel, targetId, payload, payloadLen);
                        }
                    }
                    start = start + 1;
                }
                this.lastReadSeq = head;
            }
            await Task.Delay(10);
        }
    }

    public void Stop() {
        this.running = false;
    }
}
