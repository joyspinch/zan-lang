using System;
using System.Collections.Generic;
using System.Net.Sockets;

namespace System.Net.WebSocket;

public class WsReader {
    public nint sock;
    // 非空时字节源为 TLS 明文流（wss），否则直接从 sock 读取。
    public TlsStream tlsSrc;
    public byte[] buf;
    public int len;
    public int cap;
    public byte[] tmp;
    // 下一个未读帧的游标。已消费的帧通过向前移动游标跳过；
    // 仅当需要读取更多字节时才压缩缓冲区，
    // 这样一批管道帧只需一次搬移，而不是每帧一次。
    public int start;
    // 单条消息的缓冲上限：对端声明的帧总长超过它时按
    // 协议错误拒绝（FrameSize 返回 -3），而不是把内存
    // 无限翻倍——远端声明一个 2GB 的帧再慢慢滴字节，
    // 即可把无上限的 Ensure 撑到 OOM。
    public int maxLen;

    // 内部构造：64KiB 缓冲、消息上限 16 MiB；经 new / WrapTls 使用。
    public WsReader(nint sock) {
        this.sock = sock;
        this.tlsSrc = null;
        this.cap = 65536;
        this.buf = new byte[this.cap + 1];
        this.len = 0;
        this.start = 0;
        this.tmp = new byte[65537];
        this.maxLen = 16777216;   // 16 MiB，与 MQTT broker 单包上限一致
    }

    // 以 TLS 明文流为字节源的读取器（wss 连接）。
    public static WsReader WrapTls(TlsStream stream) {
        // 套接字句柄无用但字段必须一致：FillMore 走 tlsSrc 分支。
        WsReader r = new WsReader((nint)0);
        r.tlsSrc = stream;
        return r;
    }

    // 调整单条消息的缓冲上限（字节）。
    public void SetMaxLen(int max) { this.maxLen = max; }

    // 单条消息的缓冲上限（字节）。
    public int MaxLen() { return this.maxLen; }

    // 缓冲中未读字节数。
    public int Buffered() { return this.len - this.start; }

    // 把未读字节移到开头，使游标归零。
    public void Compact() {
        if (this.start == 0) { return; }
        int rem = this.len - this.start;
        if (rem > 0) {
            NativeMemory.Copy((nint)this.buf, (nint)this.buf + (nint)this.start, rem);
        }
        this.len = rem;
        this.start = 0;
    }

    // 用已从套接字读到的字节初始化缓冲区。
    // 同时服务 HTTP 与 WebSocket 的端口会自行读取握手，可能连带读入
    // 首批帧，这些字节不能丢失。
    public void Prime(string data, int n) {
        if (n <= 0) { return; }
        this.Ensure(this.len + n);
        NativeMemory.PutString((nint)this.buf, this.len, data, n);
        this.len = this.len + n;
    }

    // 扩展累积缓冲区，使其至少容纳 `need` 个字节。
    public void Ensure(int need) {
        if (need <= this.cap) { return; }
        int maxCap = this.maxLen + 65536;
        if (need > maxCap) {
            need = maxCap;
        }
        int nc = this.cap * 2;
        if (nc < 65536) { nc = 65536; }
        while (nc < need) {
            if (nc > 1073741824 / 2) {
                nc = 1073741824;
                break;
            }
            nc = nc * 2;
        }
        if (nc > maxCap) { nc = maxCap; }
        byte[] nb = new byte[nc + 1];
        if (this.len > 0) {
            NativeMemory.Copy((nint)nb, (nint)this.buf, this.len);
        }
        this.buf = nb;
        this.cap = nc;
    }

    // 挂起在 reactor 上直到可读，然后把收到的字节
    // 追加进缓冲区。返回读取的字节数；0 表示对端已关闭（EOF）。
    public async int FillMore() {
        int got = 0;
        this.Compact();
        while (got == 0) {
            if (this.tlsSrc != null) {
                // TLS 字节源：解密后的明文落入 tmp 并按显式字节数
                // 追加（帧负载可能含 NUL，绝不依赖 strlen）。
                int tn = await this.tlsSrc.RecvIntoAsync(this.tmp, 65536);
                if (tn <= 0) { return 0; }
                this.Ensure(this.len + tn);
                NativeMemory.Copy((nint)this.buf + (nint)this.len, (nint)this.tmp, tn);
                this.len = this.len + tn;
                got = tn;
                continue;
            }
            await Socket.ReadReady(this.sock);
            int n = 0;
            if (this.len == 0) {
                // 快路径：缓冲区为空（常见的每 recv 一帧的情况）——
                // 直接接收进缓冲区，无需中间拷贝。
                n = Socket.Recv(this.sock, this.buf, this.cap);
                if (n > 0) {
                    this.len = n;
                    got = n;
                } else if (n == 0 || n <= -2) {
                    return 0;
                }
            } else {
                // 缓冲区已有字节（部分帧/合并帧）：先收进
                // 临时缓冲区再追加。
                n = Socket.Recv(this.sock, this.tmp, 65536);
                if (n > 0) {
                    this.Ensure(this.len + n);
                    NativeMemory.Copy((nint)this.buf + (nint)this.len, (nint)this.tmp, n);
                    this.len = this.len + n;
                    got = n;
                } else if (n == 0 || n <= -2) {
                    return 0;
                }
            }
            // n == -1：EWOULDBLOCK/虚假唤醒——再次等待可读。
        }
        return got;
    }

    // 带空闲窗口的 FillMore：时限内没有任何字节到达时返回
    // -1（连接未断，帧缓冲里已收到的半截字节原样保留，下次接着
    // 读）；数据/对端关闭的语义与 FillMore 相同（>0 = 字节数，
    // 0 = EOF）。timeoutMs 非正表示不限时，等价于 FillMore()。
    // // 实现走 Socket.RecvToOv——把接收与截止时间一起交给 reactor
    // 竞速（超时交付 -1，不 shutdown 套接字），而不是 HttpDeadline
    // 的手法：后者靠 ShutdownBoth 挂断唤醒，用一次连接就废一次，
    // 撑不起「每 15 秒空闲窗口到期就 Ping 一下再继续收」的长连接
    // 心跳循环。TLS 源分支没有对等的带截止时间原语，退化为不限时
    // （wss 心跳调用方应改用上层 Ping/Pong 探活）。
    public async int FillMore(int timeoutMs) {
        if (timeoutMs <= 0 || this.tlsSrc != null) {
            return await this.FillMore();
        }
        this.Compact();
        int n = 0;
        if (this.len == 0) {
            // 快路径：缓冲区为空（常见的每 recv 一帧的情况）——
            // 直接接收进缓冲区，无需中间拷贝。
            n = await Socket.RecvToOv(this.sock, this.buf, this.cap, timeoutMs);
            if (n > 0) { this.len = n; }
            return n < 0 ? 0 - 1 : n;
        }
        // 缓冲区已有字节（部分帧/合并帧）：先收进临时缓冲区再追加。
        n = await Socket.RecvToOv(this.sock, this.tmp, 65536, timeoutMs);
        if (n > 0) {
            this.Ensure(this.len + n);
            NativeMemory.Copy((nint)this.buf + (nint)this.len, (nint)this.tmp, n);
            this.len = this.len + n;
        }
        return n < 0 ? 0 - 1 : n;
    }

    // 缓冲区头部帧的总字节长度；若完整帧尚未全部缓冲
    // 则返回 -1。返回 -2 = 协议违规（64 位长度的高 32 位非零，
    // RFC 要求连接失败）；-3 = 帧总长超过 maxLen（消息过大）。
    // 调用方对 -2/-3 都必须关闭而非继续等待。
    public int FrameSize() {
        int s = this.start;
        int avail = this.len - s;
        if (avail < 2) { return -1; }
        int b0 = this.buf[s] & 255;
        int opcode = b0 & 15;
        bool fin = (b0 & 128) != 0;
        int b1 = this.buf[s + 1] & 255;
        bool masked = (b1 & 128) != 0;
        int payloadLen = b1 & 127;
        if (opcode >= 8) {
            // RFC 6455 §5.5: 控制帧禁止分片且载荷 <= 125
            if (!fin || payloadLen > 125) { return -2; }
        }
        int offset = 2;
        if (payloadLen == 126) {
            if (avail < 4) { return -1; }
            payloadLen = ((this.buf[s + 2] & 255) << 8) + (this.buf[s + 3] & 255);
            offset = 4;
        } else if (payloadLen == 127) {
            if (avail < 10) { return -1; }
            if ((this.buf[s + 2] & 255) != 0 || (this.buf[s + 3] & 255) != 0
                || (this.buf[s + 4] & 255) != 0 || (this.buf[s + 5] & 255) != 0
                || (this.buf[s + 6] & 128) != 0) {
                return -2;
            }
            payloadLen = ((this.buf[s + 6] & 255) << 24) +
                         ((this.buf[s + 7] & 255) << 16) +
                         ((this.buf[s + 8] & 255) << 8) + (this.buf[s + 9] & 255);
            if (payloadLen < 0) { return -2; }
            offset = 10;
        }
        int maskLen = 0;
        if (masked) { maskLen = 4; }
        int total = offset + maskLen + payloadLen;
        if (total < 0) { return -2; }
        if (total > this.maxLen) { return -3; }
        if (avail < total) { return -1; }
        return total;
    }

    // 解码游标处的帧（长度由 FrameSize 给出），并
    // 越过该帧。
    public WsFrame TakeFrame(int total) {
        WsFrame frame = WsFrame.DecodeAt(this.buf, this.start, total);
        this.Consume(total);
        return frame;
    }

    // 在缓冲的未读字节里扫描 HTTP 头部结束标记
    // （CRLFCRLF）。借助 AVX2 向量化 IndexOf 快速跳过普通字节。
    // 返回相对游标的偏移；未找到返回 -1。
    // 握手与首帧常在同一段到达，而帧字节可能含 NUL，
    // 因此扫描必须按字节下标进行，不能走字符串长度。
    public int FindHeaderEnd() {
        int last = this.len - 4;
        int i = this.start;
        while (i <= last) {
            int pos = MemoryExtensions.IndexOf(this.buf, (byte)13, i, last + 1 - i);
            if (pos < 0 || pos > last) {
                return 0 - 1;
            }
            if ((this.buf[pos + 1] & 255) == 10
                && (this.buf[pos + 2] & 255) == 13
                && (this.buf[pos + 3] & 255) == 10) {
                return pos - this.start;
            }
            i = pos + 1;
        }
        return 0 - 1;
    }

    // 取出游标处 n 个字节，作为显式长度的字符串
    // （不推进游标）。零额外堆分配拷贝。
    public string Slice(int n) {
        if (n <= 0) { return ""; }
        return this.buf.ToStr(this.start, n);
    }

    // 把外部收到的字节（例如 TLS 流解密出的明文）
    // 追加到累积缓冲区，绕过套接字。
    public void Append(string data, int n) {
        if (n <= 0) { return; }
        this.Compact();
        this.Ensure(this.len + n);
        NativeMemory.PutString((nint)this.buf, this.len, data, n);
        this.len = this.len + n;
    }

    // 跳过游标处的帧以丢弃它。
    public void Consume(int total) {
        this.start = this.start + total;
        if (this.start >= this.len) {
            this.start = 0;
            this.len = 0;
        }
    }
}

// 供连续应答帧使用的二进制安全输出缓冲区。
// // 每帧一次 send() 比编码一帧更贵：每 recv 携带 64 个管道帧时，
// echo 路径把时间全花在系统调用上（满载内核约 13 万消息/秒，
// 而 tcp 路径一次写入回显整个 recv，达 680 万/秒）。
// 在更多完整帧已缓冲时累积响应，
// 待读取方无帧可读时再一次性刷出。
