using System;
using System.Collections.Generic;
using System.Net.Sockets;

namespace System.Net.WebSocket;

public class WsFrame {
    public int opcode;
    public string payload;
    public byte[] payloadBytes;
    public int payloadOffset;
    public int payloadLen;
    public bool fin;
    public bool masked;
    public int rsv;

    public WsFrame() {
        this.opcode = WsOpcode.Text;
        this.payload = "";
        this.payloadBytes = null;
        this.payloadOffset = 0;
        this.payloadLen = 0;
        this.fin = true;
        this.masked = false;
        this.rsv = 0;
    }

    public static WsFrame TextFrame(string data) {
        return WsFrame.RawFrame(WsOpcode.Text, data, data.Length);
    }

    public static WsFrame BinaryFrame(string data, int len) {
        return WsFrame.RawFrame(WsOpcode.Binary, data, len);
    }

    public static WsFrame CloseFrame() { return WsFrame.RawFrame(WsOpcode.Close, "", 0); }

    public static WsFrame CloseFrameWithCode(int code) {
        byte[] p = new byte[3];
        p[0] = (byte)((code >> 8) & 255);
        p[1] = (byte)(code & 255);
        return WsFrame.RawFrame(WsOpcode.Close, p.ToStr(0, 2), 2);
    }

    public static WsFrame PingFrame() { return WsFrame.RawFrame(WsOpcode.Ping, "", 0); }
    public static WsFrame PongFrame() { return WsFrame.RawFrame(WsOpcode.Pong, "", 0); }

    public static WsFrame RawFrame(int opcode, string payload, int payloadLen) {
        WsFrame f = new WsFrame();
        f.opcode = opcode;
        f.payload = payload;
        f.payloadLen = payloadLen;
        return f;
    }

    public static WsFrame RawBytes(int opcode, byte[] payload, int offset, int payloadLen) {
        WsFrame f = new WsFrame();
        f.opcode = opcode;
        f.payloadBytes = payload;
        f.payloadOffset = offset;
        f.payloadLen = payloadLen;
        return f;
    }

    public static int HeaderLen(int payloadLen) {
        if (payloadLen > 65535) { return 10; }
        if (payloadLen > 125) { return 4; }
        return 2;
    }

    private int WriteHeader(byte[] buf, int maskBit) {
        buf[0] = (byte)(128 + this.opcode);
        if (this.payloadLen > 65535) {
            buf[1] = (byte)(maskBit + 127);
            buf[2] = 0; buf[3] = 0; buf[4] = 0; buf[5] = 0;
            buf[6] = (byte)((this.payloadLen >> 24) & 255);
            buf[7] = (byte)((this.payloadLen >> 16) & 255);
            buf[8] = (byte)((this.payloadLen >> 8) & 255);
            buf[9] = (byte)(this.payloadLen & 255);
            return 10;
        }
        if (this.payloadLen > 125) {
            buf[1] = (byte)(maskBit + 126);
            buf[2] = (byte)((this.payloadLen >> 8) & 255);
            buf[3] = (byte)(this.payloadLen & 255);
            return 4;
        }
        buf[1] = (byte)(maskBit + this.payloadLen);
        return 2;
    }

    private void WritePayload(byte[] buf, int offset) {
        if (this.payloadLen <= 0) { return; }
        if (this.payloadBytes != null) {
            NativeMemory.Copy((nint)buf + (nint)offset, (nint)this.payloadBytes + (nint)this.payloadOffset, this.payloadLen);
        } else {
            NativeMemory.PutString((nint)buf, offset, this.payload, this.payloadLen);
        }
    }

    private static void XorMask(byte[] buf, int offset, int len, long m0, long m1, long m2, long m3) {
        if (len <= 0) { return; }
        long k32 = m0 | (m1 << 8) | (m2 << 16) | (m3 << 24);
        long k64 = k32 | (k32 << 32);
        Vector256 mask256 = Vector256.Create(k64, k64, k64, k64);
        Vector128 mask128 = Vector128.Create(k64, k64);
        int i = 0;
        while (i + 32 <= len) {
            Vector256 v = Vector256.Load(buf, offset + i);
            Vector256.Store(buf, offset + i, Vector256.Xor(v, mask256));
            i = i + 32;
        }
        while (i + 16 <= len) {
            Vector128 v128 = Vector128.Load(buf, offset + i);
            Vector128.Store(buf, offset + i, Vector128.Xor(v128, mask128));
            i = i + 16;
        }
        int sm0 = (int)m0; int sm1 = (int)m1; int sm2 = (int)m2; int sm3 = (int)m3;
        while (i + 4 <= len) {
            buf[offset + i] = (byte)((buf[offset + i] & 255) ^ sm0);
            buf[offset + i + 1] = (byte)((buf[offset + i + 1] & 255) ^ sm1);
            buf[offset + i + 2] = (byte)((buf[offset + i + 2] & 255) ^ sm2);
            buf[offset + i + 3] = (byte)((buf[offset + i + 3] & 255) ^ sm3);
            i = i + 4;
        }
        if (i < len) {
            buf[offset + i] = (byte)((buf[offset + i] & 255) ^ sm0);
            i = i + 1;
            if (i < len) {
                buf[offset + i] = (byte)((buf[offset + i] & 255) ^ sm1);
                i = i + 1;
                if (i < len) {
                    buf[offset + i] = (byte)((buf[offset + i] & 255) ^ sm2);
                }
            }
        }
    }

    public byte[] Encode() {
        int headerLen = WsFrame.HeaderLen(this.payloadLen);
        byte[] buf = new byte[headerLen + this.payloadLen + 1];
        this.WriteHeader(buf, 0);
        this.WritePayload(buf, headerLen);
        return buf;
    }

    public byte[] EncodeMasked() {
        int headerLen = WsFrame.HeaderLen(this.payloadLen) + 4;
        byte[] buf = new byte[headerLen + this.payloadLen + 1];
        int pos = this.WriteHeader(buf, 128);

        byte[] mask = RandomNumberGenerator.GetBytes(4);
        if (mask == null) {
            long seed = Stopwatch.GetTimestamp();
            mask = new byte[5];
            mask[0] = (byte)(seed & 255);
            mask[1] = (byte)((seed >> 8) & 255);
            mask[2] = (byte)((seed >> 16) & 255);
            mask[3] = (byte)((seed >> 24) & 255);
            if (mask[0] == 0 && mask[1] == 0 && mask[2] == 0 && mask[3] == 0) { mask[0] = 1; }
        }
        for (int m = 0; m < 4; m = m + 1) { buf[pos + m] = mask[m]; }
        pos = pos + 4;
        this.WritePayload(buf, pos);
        WsFrame.XorMask(buf, pos, this.payloadLen,
            (long)(mask[0] & 255), (long)(mask[1] & 255), (long)(mask[2] & 255), (long)(mask[3] & 255));
        return buf;
    }

    // 严禁拿 data.Length（strlen）当边界：帧字节可含 NUL（如 continuation opcode=0），一律以 frameLen 判界。
    public static WsFrame DecodeAt(string data, int offset0, int frameLen) {
        WsFrame f = new WsFrame();
        if (frameLen < 2) { return f; }
        int dataEnd = offset0 + frameLen;

        int byte0 = data[offset0] & 255;
        int byte1 = data[offset0 + 1] & 255;
        f.fin = (byte0 & 128) != 0;
        f.rsv = byte0 & 112;
        f.opcode = byte0 & 15;
        f.masked = (byte1 & 128) != 0;

        if (f.rsv != 0 || (f.opcode >= 3 && f.opcode <= 7) || (f.opcode >= 11 && f.opcode <= 15)) {
            f.opcode = WsOpcode.Close;
            return f;
        }
        int payloadLen = byte1 & 127;
        if (f.opcode >= 8 && (!f.fin || payloadLen > 125)) {
            f.opcode = WsOpcode.Close;
            return f;
        }
        int offset = offset0 + 2;
        if (payloadLen == 126) {
            if (offset0 + 4 > dataEnd) { f.opcode = WsOpcode.Close; return f; }
            payloadLen = ((data[offset0 + 2] & 255) << 8) + (data[offset0 + 3] & 255);
            if (payloadLen < 126) { f.opcode = WsOpcode.Close; return f; }
            offset = offset0 + 4;
        } else if (payloadLen == 127) {
            if (offset0 + 10 > dataEnd) { f.opcode = WsOpcode.Close; return f; }
            if ((data[offset0 + 2] & 255) != 0 || (data[offset0 + 3] & 255) != 0
                || (data[offset0 + 4] & 255) != 0 || (data[offset0 + 5] & 255) != 0
                || (data[offset0 + 6] & 128) != 0) {
                f.opcode = WsOpcode.Close;
                return f;
            }
            payloadLen = ((data[offset0 + 6] & 255) << 24) + ((data[offset0 + 7] & 255) << 16)
                + ((data[offset0 + 8] & 255) << 8) + (data[offset0 + 9] & 255);
            if (payloadLen < 65536) { f.opcode = WsOpcode.Close; return f; }
            offset = offset0 + 10;
        }

        if (f.masked && offset + 4 > dataEnd) { f.opcode = WsOpcode.Close; return f; }
        f.payloadLen = payloadLen;

        int avail = dataEnd - offset - (f.masked ? 4 : 0);
        int copyLen = payloadLen < avail ? payloadLen : avail;
        if (copyLen < 0) { copyLen = 0; }

        if (f.masked) {
            long m0 = (long)(data[offset] & 255);
            long m1 = (long)(data[offset + 1] & 255);
            long m2 = (long)(data[offset + 2] & 255);
            long m3 = (long)(data[offset + 3] & 255);
            offset = offset + 4;
            byte[] payload = new byte[copyLen + 1];
            if (copyLen > 0) {
                NativeMemory.Copy((nint)payload, (nint)data + (nint)offset, copyLen);
                WsFrame.XorMask(payload, 0, copyLen, m0, m1, m2, m3);
            }
            f.payload = payload.ToStr(0, copyLen);
        } else {
            f.payload = data.Substring(offset, copyLen);
        }
        return f;
    }

    public bool IsValidInbound(bool requireMasked) {
        if (this.rsv != 0 || this.masked != requireMasked) { return false; }
        if ((this.opcode >= 3 && this.opcode <= 7) || (this.opcode >= 11 && this.opcode <= 15)) { return false; }
        if (this.opcode >= 8 && (!this.fin || this.payloadLen > 125 || !this.IsValidControlPayload())) {
            return false;
        }
        return true;
    }

    public static bool ValidInbound(WsFrame frame, bool requireMasked) {
        return frame != null && frame.IsValidInbound(requireMasked);
    }

    public bool IsValidControlPayload() {
        if (this.opcode != WsOpcode.Close) { return true; }
        if (this.payloadLen == 1) { return false; }
        if (this.payloadLen == 0) { return true; }
        if (this.payload == null || this.payloadLen < 2) { return false; }
        int code = ((this.payload[0] & 255) << 8) | (this.payload[1] & 255);
        if (!((code >= 1000 && code <= 1003)
            || (code >= 1007 && code <= 1011)
            || (code >= 3000 && code <= 4999))) { return false; }
        if (this.payloadLen > 2) {
            return WsFrame.ValidUtf8(this.payload.Substring(2), this.payloadLen - 2);
        }
        return true;
    }

    public static bool ValidControlPayload(WsFrame frame) {
        return frame != null && frame.IsValidControlPayload();
    }

    public static bool ValidUtf8(string text, int len) {
        if (text == null || len < 0) { return false; }
        int i = 0;
        while (i < len) {
            int b0 = text[i] & 255;
            if (b0 <= 0x7f) { i = i + 1; continue; }
            if (b0 >= 0xc2 && b0 <= 0xdf) {
                if (i + 1 >= len) { return false; }
                int b1 = text[i + 1] & 255;
                if (b1 < 0x80 || b1 > 0xbf) { return false; }
                i = i + 2; continue;
            }
            if (b0 >= 0xe0 && b0 <= 0xef) {
                if (i + 2 >= len) { return false; }
                int b1 = text[i + 1] & 255; int b2 = text[i + 2] & 255;
                if (b2 < 0x80 || b2 > 0xbf
                    || (b0 == 0xe0 && b1 < 0xa0)
                    || (b0 == 0xed && b1 > 0x9f)
                    || b1 < 0x80 || b1 > 0xbf) { return false; }
                i = i + 3; continue;
            }
            if (b0 >= 0xf0 && b0 <= 0xf4) {
                if (i + 3 >= len) { return false; }
                int b1 = text[i + 1] & 255; int b2 = text[i + 2] & 255;
                int b3 = text[i + 3] & 255;
                if (b2 < 0x80 || b2 > 0xbf || b3 < 0x80 || b3 > 0xbf
                    || (b0 == 0xf0 && b1 < 0x90)
                    || (b0 == 0xf4 && b1 > 0x8f)
                    || b1 < 0x80 || b1 > 0xbf) { return false; }
                i = i + 4; continue;
            }
            return false;
        }
        return true;
    }
}
