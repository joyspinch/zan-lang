using System;
using System.Collections.Generic;
using System.Net.Sockets;

namespace System.Net.WebSocket;

public class WsOpcode {
    // 分片消息的后续帧（RFC 6455 §5.4）。
    public static const int Continuation = 0;
    // UTF-8 文本消息。
    public static const int Text = 1;
    // 二进制消息。
    public static const int Binary = 2;
    // 连接关闭（含 2 字节状态码负载）。
    public static const int Close = 8;
    // 心跳探测（负载原样由 Pong 回）。
    public static const int Ping = 9;
    // 心跳应答。
    public static const int Pong = 10;
}
