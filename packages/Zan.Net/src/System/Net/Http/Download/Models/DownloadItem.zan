using System;
using System.Collections.Generic;

namespace System.Net.Http.Download;

public class DownloadItem {
    string host;
    int port;
    bool tls;
    // ExternalTarget 规范化后的完整 URL；真正连接前再按策略复核。
    string targetUrl;
    // 请求行里的路径（含查询串），如 "/app/plus2.exe"。
    string path;
    // 界面上显示的名字，默认取 URL 的最后一段。
    string name;
    // 落盘路径（断点续传就以这个文件已有的字节数为断点）。
    string localPath;
    // 期望的 SHA-1（40 位十六进制），"" = 不校验。
    string sha1;
    // 期望的字节数，0 = 未知（只影响总体百分比的估算）。
    long size;
    // 解压/安装目标目录，"" = 下载完就算完。
    string extractTo;
    // 自定义安装步骤，null = 按扩展名走默认解压。
    DownloadInstallFn installer;

    // 内部构造：默认 https 443；经 FromUrl 使用。
    public DownloadItem() {
        this.host = "";
        this.port = 443;
        this.tls = true;
        this.targetUrl = "";
        this.path = "/";
        this.name = "";
        this.localPath = "";
        this.sha1 = "";
        this.size = 0;
        this.extractTo = "";
        this.installer = null;
    }

    // 从 `http(s)://host[:port]/path` 建一个条目；URL 解析不出
    // 主机时返回 null。
    public static DownloadItem FromUrl(string url, string localPath) {
        DownloadItem it = new DownloadItem();
        if (!it.SetUrl(url)) { return null; }
        it.localPath = localPath;
        return it;
    }

    // 解析 URL 到 host/port/tls/path，成功返回 true。解析本身只负责
    // 拒绝畸形目标；HTTPS、私网和 loopback 的远程策略在真正建连前由
    // <see cref="ExternalTargetPolicy"/> 复核，这样离线模型 fixture 仍能解析本地 URL。
    public bool SetUrl(string url) {
        ExternalTarget target = ExternalTarget.Parse(url);
        if (target == null) { return false; }
        this.host = target.Host();
        this.port = target.Port();
        this.tls = target.IsTls();
        this.targetUrl = target.Canonical();
        this.path = target.Path() + target.Query();
        if (this.name == "") { this.name = DownloadItem.LastSegment(this.path); }
        return true;
    }

    // 要校验的 SHA-1（40 位十六进制）；可链式调用。
    public DownloadItem WithSha1(string hex) {
        this.sha1 = hex.ToLower();
        return this;
    }

    // 期望的字节数，用于在第一块正文到达前就给出总体进度。
    // 可链式调用。
    public DownloadItem WithSize(long bytes) {
        this.size = bytes;
        return this;
    }

    // 下载完成后解压/安装到 <paramref name="dir"/>：归档类型按
    // 落盘文件的扩展名判定（.tar.bz2 / .tbz2 / .tar / .zip），其余扩展名
    // 直接把文件复制过去。可链式调用。
    public DownloadItem WithExtractTo(string dir) {
        this.extractTo = dir;
        return this;
    }

    // 下载完成后由 <paramref name="fn"/> 安装，而不是按扩展名
    // 解压（归档里要剥顶层目录、要打就绪标记之类的，交给调用方自己做）。
    // 可链式调用。
    public DownloadItem WithInstaller(DownloadInstallFn fn) {
        this.installer = fn;
        return this;
    }

    // 界面上显示的名字；可链式调用。
    public DownloadItem WithName(string n) {
        this.name = n;
        return this;
    }

    // 落盘路径（自定义安装步骤要用它找下好的文件）。
    public string LocalPath() { return this.localPath; }

    // 界面上显示的名字。
    public string Name() { return this.name; }

    // 解压/安装目标目录，"" = 没有。
    public string ExtractTo() { return this.extractTo; }

    // HttpClient 写进度用的伴生文件。
    public string ProgressFile() {
        return this.localPath + ".progress";
    }

    // 路径的最后一段（文件名）。
    public static string LastSegment(string p) {
        int at = 0 - 1;
        for (int i = 0; i < p.Length; i = i + 1) {
            if ((p[i] & 255) == 47) { at = i; }
        }
        if (at < 0) { return p; }
        return p.Substring(at + 1, p.Length - at - 1);
    }
}
