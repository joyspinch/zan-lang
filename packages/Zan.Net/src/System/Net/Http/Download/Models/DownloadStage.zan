using System;
using System.Collections.Generic;

namespace System.Net.Http.Download;

public class DownloadStage {
    // 刚创建，尚未开跑。
    public static const int Idle = 0;
    // 正在传输某个条目。
    public static const int Download = 1;
    // 正在核对 SHA-1。
    public static const int Verify = 2;
    // 正在解压/安装。
    public static const int Extract = 3;
    // 全部条目成功。
    public static const int Done = 4;
    // 失败收工（原因见 DownloadJob.Error）。
    public static const int Failed = 5;
    // 被调用方取消。
    public static const int Cancelled = 6;

    // 阶段的中文提示；宿主自己管界面语言时不用它，直接按阶段码
    // 出自己的文案。
    public static string Text(int stage) {
        if (stage == DownloadStage.Download) { return "正在下载"; }
        if (stage == DownloadStage.Verify) { return "正在校验"; }
        if (stage == DownloadStage.Extract) { return "正在解压安装"; }
        if (stage == DownloadStage.Done) { return "已完成"; }
        if (stage == DownloadStage.Failed) { return "失败"; }
        if (stage == DownloadStage.Cancelled) { return "已取消"; }
        return "准备中";
    }
}

// 要下载的一个文件：源地址、落盘路径，以及可选的 SHA-1
// 校验与解压目标。<see cref="DownloadJob"/> 按加入顺序逐个处理。
