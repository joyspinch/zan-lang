using System;
using System.Collections.Generic;

namespace System.Net.Http;

public class HttpDeadline {
    public static List<HttpDeadlineSlot> slots = new List<HttpDeadlineSlot>();
    public static List<int> freeSlots = new List<int>();
    public static bool sweeping = false;
    public static int activeCount = 0;
    // 仅作扫描器的缓存；Touch 会先刷新它，不能使用上一次 sweep 的旧值。
    public static long nowMs = 0;

    // 注册一个连接并返回带 generation 的 token；
    // 截止时间被禁用（timeoutMs <= 0）时返回 null。
    public static HttpDeadlineToken Arm(nint sock, int timeoutMs) {
        return HttpDeadline.Arm(sock, timeoutMs, 0);
    }

    // 注册阶段 deadline，并可附带从 Arm 时刻起的 total budget。
    // totalMs <= 0 表示不设总预算。
    public static HttpDeadlineToken Arm(nint sock, int timeoutMs, int totalMs) {
        if (timeoutMs <= 0 && totalMs <= 0) { return null; }
        List<HttpDeadlineSlot> s = HttpDeadline.slots;
        if (s == null) { return null; }
        lock (s) {
            nowMs = Stopwatch.GetMilliseconds();
            int phase = timeoutMs;
            if (phase <= 0) { phase = totalMs; }
            if (totalMs > 0 && phase > totalMs) { phase = totalMs; }
            int slot;
            int n = freeSlots.Count;
            if (n > 0) {
                slot = freeSlots[n - 1];
                freeSlots.RemoveAt(n - 1);
                HttpDeadlineSlot old = s[slot];
                old.generation = old.generation + 1;
                if (old.generation <= 0) { old.generation = 1; }
                old.sock = sock;
                old.deadline = nowMs + phase;
                old.fired = false;
                old.active = true;
                old.totalDeadline = totalMs > 0 ? nowMs + totalMs : 0;
                old.deadlineMs.Store(old.deadline);
                old.firedFlag.Store(0);
                old.stateGen.Store((((long)old.generation) << 1) | (long)1);
            } else {
                HttpDeadlineSlot created = new HttpDeadlineSlot(sock, nowMs + phase);
                if (totalMs > 0) { created.totalDeadline = nowMs + totalMs; }
                s.Add(created);
                slot = s.Count - 1;
            }
            activeCount = activeCount + 1;
            HttpDeadlineSlot slotObj = s[slot];
            HttpDeadlineToken token = new HttpDeadlineToken(slot,
                slotObj.generation, slotObj);
            if (!sweeping) {
                // sweeping 只在锁内读写；StopSweeping 在发现新连接时会
                // 重新启动扫描器，避免最后一次 sweep 与 Arm 之间丢唤醒。
                sweeping = true;
                Task.Spawn(HttpDeadline.Sweep());
            }
            return token;
        }
    }

    // 为 token 重启阶段窗口。阶段预算为非正值时仍保留
    // total deadline；不能因为关闭某一阶段而把总截止时间一并关闭。
    public static void Touch(HttpDeadlineToken token, int timeoutMs) {
        if (token == null || token.disarmed) { return; }
        HttpDeadlineSlot fast = token.slotRef;
        if (fast != null) {
            long expectedGen = (((long)token.generation) << 1) | (long)1;
            if (fast.stateGen.Load() != expectedGen) { return; }
            if (fast.firedFlag.Load() != 0) { return; }
            long now = Stopwatch.GetMilliseconds();
            long curDeadline = fast.deadlineMs.Load();
            if (now >= curDeadline) {
                nint sock = fast.sock;
                if (fast.stateGen.Load() == expectedGen
                    && fast.firedFlag.CompareExchange(0, 1) == 0) {
                    fast.deadlineMs.Store(now + 3600000);
                    if (sock >= 0) { Socket.ShutdownBoth(sock); }
                }
                return;
            }
            long next = 0;
            if (timeoutMs > 0) { next = now + (long)timeoutMs; }
            if (fast.totalDeadline > 0
                && (next <= 0 || next > fast.totalDeadline)) {
                next = fast.totalDeadline;
            }
            if (next <= 0) { return; }
            if (next != curDeadline) {
                fast.deadlineMs.Store(next);
            }
            return;
        }
        List<HttpDeadlineSlot> s = HttpDeadline.slots;
        if (s == null) { return; }
        nint expiredSock = -1;
        lock (s) {
            if (token.disarmed || token.slot < 0 || token.slot >= s.Count) { return; }
            HttpDeadlineSlot slot = s[token.slot];
            if (!slot.active || slot.generation != token.generation) { return; }
            // Sweep 已经触发时不能被阶段切换重新武装；否则发送阶段
            // 的超时可能在 await 返回后被 Touch 清掉。
            if (slot.fired || slot.firedFlag.Load() != 0) { return; }
            nowMs = Stopwatch.GetMilliseconds();
            // 在扫描器尚未轮到本槽位时也要观察到过期，避免一次迟到的
            // 收包把已经耗尽的窗口重新推到未来。
            long cur = slot.deadlineMs.Load();
            if (nowMs >= cur) {
                if (slot.firedFlag.CompareExchange(0, 1) == 0) {
                    slot.deadline = nowMs + 3600000;
                    slot.deadlineMs.Store(slot.deadline);
                    slot.fired = true;
                    expiredSock = slot.sock;
                }
            } else {
                long next = 0;
                if (timeoutMs > 0) { next = nowMs + timeoutMs; }
                if (slot.totalDeadline > 0
                    && (next <= 0 || next > slot.totalDeadline)) {
                    next = slot.totalDeadline;
                }
                if (next <= 0) { return; }
                slot.deadline = next;
                slot.deadlineMs.Store(next);
                slot.fired = false;
            }
        }
        if (expiredSock >= 0) { Socket.ShutdownBoth(expiredSock); }
    }

    // 当扫描器已对 token 执行挂断时返回 true。
    // 必须在 Disarm 前查询。
    public static bool Expired(HttpDeadlineToken token) {
        if (token == null || token.disarmed) { return false; }
        HttpDeadlineSlot fast = token.slotRef;
        if (fast != null) {
            long expectedGen = (((long)token.generation) << 1) | (long)1;
            return fast.stateGen.Load() == expectedGen && fast.firedFlag.Load() != 0;
        }
        List<HttpDeadlineSlot> s = HttpDeadline.slots;
        if (s == null) { return false; }
        lock (s) {
            if (token.disarmed || token.slot < 0 || token.slot >= s.Count) { return false; }
            HttpDeadlineSlot slot = s[token.slot];
            return slot.active && slot.generation == token.generation
                && (slot.fired || slot.firedFlag.Load() != 0);
        }
    }

    // 连接结束时释放 token；重复释放安全，旧 token 不能释放新连接。
    public static void Disarm(HttpDeadlineToken token) {
        if (token == null) { return; }
        List<HttpDeadlineSlot> s = HttpDeadline.slots;
        if (s == null) { return; }
        lock (s) {
            if (token.disarmed) { return; }
            token.disarmed = true;
            if (token.slot < 0 || token.slot >= s.Count) { return; }
            HttpDeadlineSlot slot = s[token.slot];
            if (!slot.active || slot.generation != token.generation) { return; }
            slot.stateGen.Store(((long)slot.generation) << 1);
            slot.active = false;
            slot.sock = -1;
            slot.fired = false;
            slot.firedFlag.Store(0);
            activeCount = activeCount - 1;
            freeSlots.Add(token.slot);
        }
    }

    // 单次扫描：刷新粗粒度时钟并对过期连接执行挂断
    // （shutdown 而非 close，见类文档）。返回是否仍有活动 token。
    public static bool SweepOnce() {
        List<HttpDeadlineSlot> s = HttpDeadline.slots;
        if (s == null) { return false; }
        List<nint> expired = null;
        bool hasActive = false;
        lock (s) {
            nowMs = Stopwatch.GetMilliseconds();
            int n = s.Count;
            for (int i = 0; i < n; i = i + 1) {
                HttpDeadlineSlot slot = s[i];
                nint sock = slot.sock;
                if (slot.active && sock >= 0 && slot.firedFlag.Load() == 0) {
                    long cur = slot.deadlineMs.Load();
                    if (nowMs >= cur && slot.firedFlag.CompareExchange(0, 1) == 0) {
                        // fired 保持到归属者查询/Disarm；generation 防止旧 token
                        // 在槽位复用后误触碰新连接。
                        slot.deadline = nowMs + 3600000;
                        slot.deadlineMs.Store(slot.deadline);
                        slot.fired = true;
                        if (expired == null) { expired = new List<nint>(); }
                        expired.Add(sock);
                    }
                }
            }
            hasActive = activeCount > 0;
        }
        // 在锁外执行系统调用 shutdown，避免阻塞其他连接的 Arm/Disarm。
        if (expired != null) {
            for (int i = 0; i < expired.Count; i = i + 1) {
                Socket.ShutdownBoth(expired[i]);
            }
        }
        return hasActive;
    }

    // 每秒扫描一次的常驻协程；只在有活动 token 时存活。
    // SweepOnce 返回 false 后仍需在锁内再确认一次 activeCount，
    // 避免 Arm 与扫描器退出之间丢失唤醒。
    public static async void Sweep() {
        while (true) {
            await Task.Delay(1000);
            List<HttpDeadlineSlot> s = HttpDeadline.slots;
            if (s == null) { return; }
            bool live = HttpDeadline.SweepOnce();
            if (live) { continue; }
            lock (s) {
                if (activeCount > 0) { continue; }
                sweeping = false;
                return;
            }
        }
    }
}
