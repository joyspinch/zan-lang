using System;

namespace System.Net.Http;

// 分块传输（RFC 9112 §7.1）的帧格式：每块是
// "<长度(十六进制)>\r\n<数据>\r\n"，整个正文以 "0\r\n\r\n" 收尾
// （0 块之后是可选的 trailer，空 trailer 就是那个空行）。
//
// 服务端（HttpServer / HttpsServer）用它写分块响应，客户端侧的
// 解码器按同一格式解析——帧格式只在这里定义一份，两边各写一套
// 迟早会在"长度前缀是大写还是小写""结束块要不要带 trailer"上分叉。
public class HttpChunkWriter {
    // 块长度的十六进制文本（小写、不带 "0x" 前缀、无前导零）。
    // 长度是非负 int：4 字节大端足够（int 上限 2^31-1）。
    public static string HexLength(int len) {
        if (len <= 0) { return "0"; }
        byte[] b = new byte[4];
        b[0] = (byte)((len >> 24) & 255);
        b[1] = (byte)((len >> 16) & 255);
        b[2] = (byte)((len >> 8) & 255);
        b[3] = (byte)(len & 255);
        string hex = Convert.ToHexString(b, 0, 4);
        int start = 0;
        while (start < 7 && hex[start] == '0') { start = start + 1; }
        return hex.Substring(start, 8 - start);
    }

    // 块前缀 "<长度>\r\n" 的字节形式。
    public static byte[] FramePrefix(int len) {
        return (HttpChunkWriter.HexLength(len) + "\r\n").ToBytes();
    }

    // 块数据之后的分隔符 "\r\n"。
    public static byte[] FrameSuffix() {
        return "\r\n".ToBytes();
    }

    // 结束块 "0\r\n\r\n"（0 块 + 空 trailer）。
    public static byte[] Terminator() {
        return "0\r\n\r\n".ToBytes();
    }
}
