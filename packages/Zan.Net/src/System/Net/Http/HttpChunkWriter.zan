using System;

namespace System.Net.Http;

// 分块传输（RFC 9112 §7.1）的帧格式：每块是
// "<长度(十六进制)>\r\n<数据>\r\n"，整个正文以 "0\r\n\r\n" 收尾
// （0 块之后是可选的 trailer，空 trailer 就是那个空行）。
//
// 服务端（HttpServer / HttpsServer）用它写分块响应，客户端侧的
// 解码器按同一格式解析——帧格式只在这里定义一份，两边各写一套
// 迟早会在"长度前缀是大写还是小写""结束块要不要带 trailer"上分叉。
public class HttpChunkWriter {
    // 块长度的十六进制文本（小写、不带 "0x" 前缀、无前导零）。
    // 长度是非负 int：单次栈/数组格式化，消除 byte[4]+ToHexString+Substring 三重分配。
    public static string HexLength(int len) {
        if (len <= 0) { return "0"; }
        byte[] buf = new byte[8];
        int p = 8;
        int v = len;
        while (v > 0) {
            p = p - 1;
            int d = v & 15;
            buf[p] = (byte)(d < 10 ? 48 + d : 87 + d);
            v = v >> 4;
        }
        return buf.ToStr(p, 8 - p);
    }

    // 块前缀 "<长度>\r\n" 的字节形式（单次数组分配直接写入）。
    public static byte[] FramePrefix(int len) {
        if (len <= 0) { return new byte[] { 48, 13, 10 }; }
        int tmp = len;
        int digits = 0;
        while (tmp > 0) {
            digits = digits + 1;
            tmp = tmp >> 4;
        }
        byte[] outb = new byte[digits + 2];
        int p = digits;
        int v = len;
        while (v > 0) {
            p = p - 1;
            int d = v & 15;
            outb[p] = (byte)(d < 10 ? 48 + d : 87 + d);
            v = v >> 4;
        }
        outb[digits] = 13;
        outb[digits + 1] = 10;
        return outb;
    }

    // 块数据之后的分隔符 "\r\n"。
    public static byte[] FrameSuffix() {
        return new byte[] { 13, 10 };
    }

    // 结束块 "0\r\n\r\n"（0 块 + 空 trailer）。
    public static byte[] Terminator() {
        return new byte[] { 48, 13, 10, 13, 10 };
    }
}
