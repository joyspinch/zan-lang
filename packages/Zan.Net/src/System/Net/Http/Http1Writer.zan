using System;
using System.Net.Sockets;

namespace System.Net.Http;

public async delegate int Http1SendViewFn(StringView view);

// Sends HTTP bytes after the transport is selected. It does not own or
// expose a socket, and the plaintext path need not load the TLS package.
public class Http1Writer {
    private Http1SendViewFn send;
    private int maxSegment;
    private nint directSock;
    private bool nonBlocking;

    public Http1Writer(Http1SendViewFn send) {
        this.send = send;
        this.maxSegment = 0;
        this.directSock = -1;
        this.nonBlocking = false;
    }

    public Http1Writer(Http1SendViewFn send, int maxSegment) {
        this.send = send;
        this.maxSegment = maxSegment;
        this.directSock = -1;
        this.nonBlocking = false;
    }

    public Http1Writer(Http1SendViewFn send, int maxSegment, nint directSock) {
        this.send = send;
        this.maxSegment = maxSegment;
        this.directSock = directSock;
        this.nonBlocking = false;
    }

    public bool TrySendViewSync(StringView view, out int sent) {
        if (this.directSock < 0 || this.maxSegment > 0) {
            sent = 0;
            return false;
        }
        if (view.ptr == (nint)0 || view.length <= 0) {
            sent = 0;
            return true;
        }
        if (!this.nonBlocking) {
            Socket.SetNonBlocking(this.directSock);
            this.nonBlocking = true;
        }
        int totalSent = 0;
        int len = view.length;
        while (totalSent < len) {
            int n = (int)Socket.ReactorSendPtr(this.directSock, view.ptr + (nint)totalSent,
                (long)(len - totalSent), 0);
            if (n > 0) {
                totalSent = totalSent + n;
            } else if (n == 0) {
                sent = totalSent;
                return true;
            } else if (n == -1) {
                sent = totalSent;
                return false;
            } else {
                sent = totalSent;
                return true;
            }
        }
        sent = totalSent;
        return true;
    }

    public async int SendViewAsync(StringView view) {
        if (this.maxSegment <= 0 || view.length <= this.maxSegment) {
            return await this.send(view);
        }
        int offset = 0;
        while (offset < view.length) {
            int count = view.length - offset;
            if (count > this.maxSegment) { count = this.maxSegment; }
            StringView part = view.Slice(offset, count);
            int sent = await this.send(part);
            if (sent != count) { return -1; }
            offset = offset + count;
        }
        return offset;
    }

    public async int SendTextAsync(string text) {
        StringView view = StringView.FromString(text);
        return await this.SendViewAsync(view);
    }

    public async int SendBytesAsync(byte[] data, int offset, int count) {
        StringView view = StringView.FromBytes(data, offset, count);
        return await this.SendViewAsync(view);
    }

    public async int SendFrameAsync(byte[] data, int count) {
        return await this.SendBytesAsync(data, 0, count);
    }
}
