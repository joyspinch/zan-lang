using System;

namespace System.Net.Http;

public async delegate int Http1SendViewFn(StringView view);

// Sends HTTP bytes after the transport is selected. It does not own or
// expose a socket, and the plaintext path need not load the TLS package.
public class Http1Writer {
    private Http1SendViewFn send;
    private int maxSegment;

    public Http1Writer(Http1SendViewFn send, int maxSegment = 0) {
        this.send = send;
        this.maxSegment = maxSegment;
    }

    public async int SendViewAsync(StringView view) {
        if (this.maxSegment <= 0 || view.length <= this.maxSegment) {
            return await this.send(view);
        }
        int offset = 0;
        while (offset < view.length) {
            int count = view.length - offset;
            if (count > this.maxSegment) { count = this.maxSegment; }
            StringView part = view.Slice(offset, count);
            int sent = await this.send(part);
            if (sent != count) { return -1; }
            offset = offset + count;
        }
        return offset;
    }

    public async int SendTextAsync(string text) {
        StringView view = StringView.FromString(text);
        return await this.SendViewAsync(view);
    }

    public async int SendBytesAsync(byte[] data, int offset, int count) {
        StringView view = StringView.FromBytes(data, offset, count);
        return await this.SendViewAsync(view);
    }

    public async int SendFrameAsync(byte[] data, int count) {
        return await this.SendBytesAsync(data, 0, count);
    }
}
