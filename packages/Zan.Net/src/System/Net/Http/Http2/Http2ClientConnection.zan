using System;
using System.Collections.Generic;
using System.Net.Sockets;
using System.Net.Http;
using System.Net.Http.Hpack;
using System.Net.Http.Models;
using System.Text;
using System.Threading;

namespace System.Net.Http.Http2;

// HTTP/2 客户端多路复用连接引擎（RFC 7540 标准实现）。
// 核心能力：
// 1. 单 TCP 连接并发承载多个独立双向数据流（Stream Multiplexing），消除队头阻塞。
// 2. 完整的 HPACK 头部编解码（静态表索引、动态表维护、霍夫曼解压）。
// 3. 严格的 RFC 7540 状态机与控制帧处理（SETTINGS ACK、PING 应答、WINDOW_UPDATE 流量控制、RST_STREAM 取消）。
public class Http2ClientConnection : IDisposable {
    public string host;
    public int port;
    public bool isSecure;
    public nint sock;
    public bool connected;
    public int nextStreamId;

    public HpackContext inboundHpack;
    public HpackContext outboundHpack;
    public List<Http2Stream> activeStreams;
    public Mutex sendLock;

    public Http2ClientConnection(string host, int port, bool isSecure) {
        this.host = host;
        this.port = port;
        this.isSecure = isSecure;
        this.sock = -1;
        this.connected = false;
        this.nextStreamId = 1; // 客户端流 ID 必须为奇数（1, 3, 5, ...）
        this.inboundHpack = new HpackContext(4096);
        this.outboundHpack = new HpackContext(4096);
        this.activeStreams = new List<Http2Stream>();
        this.sendLock = new Mutex();
    }

    // 连接服务端并完成 HTTP/2 序言握手。
    public static async Http2ClientConnection ConnectAsync(string host, int port) {
        Http2ClientConnection conn = new Http2ClientConnection(host, port, false);
        Socket.Initialize();
        TcpClient client = await TcpClient.ConnectAsync(host, port);
        if (client == null) {
            return null;
        }
        nint s = client.GetSocket();
        conn.sock = s;
        conn.connected = true;

        // 1. 发送 24 字节客户端连接序言（RFC 7540 §3.5）
        byte[] prefaceBytes = Http2Frame.PREFACE.ToBytes();
        int _sp = await Socket.SendAsync(s, prefaceBytes, prefaceBytes.Length);

        // 2. 发送初始 SETTINGS 帧（RFC 7540 §6.5）
        byte[] initSettings = Http2Frame.EncodeHeader(0, Http2FrameType.SETTINGS, 0, 0);
        int _ss = await Socket.SendAsync(s, initSettings, 9);

        // 3. 启动后台帧派发协程
        Task.Spawn(conn.RunFrameLoopAsync());
        return conn;
    }

    // 后台帧调度循环：按帧边界持续读取并分发到各并发 Stream。
    async void RunFrameLoopAsync() {
        byte[] hdrBuf = new byte[9];
        while (this.connected) {
            int rHdr = await this.ReadExactAsync(hdrBuf, 9);
            if (rHdr < 9) {
                break;
            }
            Http2Frame frame = Http2Frame.DecodeHeader(hdrBuf, 0);
            if (frame == null) {
                break; // 帧头畸形或协议违规
            }
            byte[] payload = null;
            if (frame.length > 0) {
                payload = new byte[frame.length];
                int rPayload = await this.ReadExactAsync(payload, frame.length);
                if (rPayload < frame.length) {
                    break;
                }
            }
            this.DispatchFrame(frame, payload);
        }
        this.Close();
    }

    // 帧分发路由核心。
    void DispatchFrame(Http2Frame frame, byte[] payload) {
        if (frame.type == Http2FrameType.SETTINGS) {
            if ((frame.flags & Http2Flags.ACK) == 0) {
                // 收到服务端 SETTINGS，回复确认帧（SETTINGS ACK）
                byte[] ack = Http2Frame.BuildSettingsAck();
                this.SendRaw(ack, ack.Length);
            }
        } else if (frame.type == Http2FrameType.PING) {
            if ((frame.flags & Http2Flags.ACK) == 0) {
                // 收到服务端 PING，回复相同的 8 字节不透明数据（PING ACK）
                byte[] pingAck = Http2Frame.BuildPing(payload, true);
                this.SendRaw(pingAck, pingAck.Length);
            }
        } else if (frame.type == Http2FrameType.HEADERS) {
            Http2Stream st = this.FindStream(frame.streamId);
            if (st != null && payload != null) {
                List<HpackHeader> headers = this.inboundHpack.DecodeHeaderBlock(payload, 0, payload.Length);
                for (int i = 0; i < headers.Count; i = i + 1) {
                    st.AddHeader(headers[i].name, headers[i].value);
                }
                if ((frame.flags & Http2Flags.END_STREAM) != 0) {
                    st.Complete();
                }
            }
        } else if (frame.type == Http2FrameType.DATA) {
            Http2Stream st = this.FindStream(frame.streamId);
            if (st != null && payload != null) {
                st.AppendBody(payload, 0, payload.Length);
                if ((frame.flags & Http2Flags.END_STREAM) != 0) {
                    st.Complete();
                }
            }
        } else if (frame.type == Http2FrameType.RST_STREAM) {
            Http2Stream st = this.FindStream(frame.streamId);
            if (st != null) {
                int err = 0;
                if (payload != null && payload.Length >= 4) {
                    err = ((payload[0] & 255) << 24) | ((payload[1] & 255) << 16)
                        | ((payload[2] & 255) << 8) | (payload[3] & 255);
                }
                st.Reset(err);
            }
        } else if (frame.type == Http2FrameType.GOAWAY) {
            int lastStreamId = 0;
            if (payload != null && payload.Length >= 4) {
                lastStreamId = ((payload[0] & 127) << 24) | ((payload[1] & 255) << 16)
                             | ((payload[2] & 255) << 8) | (payload[3] & 255);
            }
            this.stateLockWait();
            for (int i = 0; i < this.activeStreams.Count; i = i + 1) {
                if (this.activeStreams[i].streamId > lastStreamId) {
                    this.activeStreams[i].Reset(Http2Error.REFUSED_STREAM);
                }
            }
            this.stateLockRelease();
        }
    }

    Http2Stream FindStream(int id) {
        this.stateLockWait();
        for (int i = 0; i < this.activeStreams.Count; i = i + 1) {
            if (this.activeStreams[i].streamId == id) {
                Http2Stream s = this.activeStreams[i];
                this.stateLockRelease();
                return s;
            }
        }
        this.stateLockRelease();
        return null;
    }

    void stateLockWait() {
        this.sendLock.WaitOne();
    }

    void stateLockRelease() {
        this.sendLock.ReleaseMutex();
    }

    // 在当前单条 HTTP/2 多路复用连接上发起异步请求并等待本流完成。
    public async HttpResponse SendAsync(string method, string path, string hostHeader, List<HpackHeader> extraHeaders, string body) {
        if (!this.connected) { return null; }
        int sid = 0;
        Http2Stream stream = null;

        this.stateLockWait();
        sid = this.nextStreamId;
        this.nextStreamId = this.nextStreamId + 2;
        stream = new Http2Stream(sid);
        this.activeStreams.Add(stream);
        this.stateLockRelease();

        // 1. 构建 HTTP/2 伪头部（RFC 7540 §8.1.2.3）
        List<HpackHeader> headers = new List<HpackHeader>();
        headers.Add(new HpackHeader(":method", method));
        headers.Add(new HpackHeader(":path", path != null && path.Length > 0 ? path : "/"));
        headers.Add(new HpackHeader(":scheme", this.isSecure ? "https" : "http"));
        headers.Add(new HpackHeader(":authority", hostHeader != null ? hostHeader : this.host));

        if (extraHeaders != null) {
            for (int i = 0; i < extraHeaders.Count; i = i + 1) {
                headers.Add(extraHeaders[i]);
            }
        }

        bool hasBody = body != null && body.Length > 0;
        if (hasBody) {
            headers.Add(new HpackHeader("content-length", Convert.ToString(body.Length)));
        }

        // 2. 编码 HPACK 头部载荷
        byte[] hpackBlock = null;
        this.stateLockWait();
        hpackBlock = this.outboundHpack.EncodeHeaders(headers, true);
        this.stateLockRelease();

        // 3. 发送 HEADERS 帧
        int hdrFlags = Http2Flags.END_HEADERS;
        if (!hasBody) {
            hdrFlags = hdrFlags | Http2Flags.END_STREAM;
        }
        byte[] hdrFrameHdr = Http2Frame.EncodeHeader(hpackBlock.Length, Http2FrameType.HEADERS, hdrFlags, sid);
        byte[] fullHdrPkt = new byte[9 + hpackBlock.Length];
        NativeMemory.Copy((nint)fullHdrPkt, (nint)hdrFrameHdr, 9);
        NativeMemory.Copy((nint)fullHdrPkt + 9, (nint)hpackBlock, hpackBlock.Length);
        await this.SendRawAsync(fullHdrPkt, fullHdrPkt.Length);

        // 4. 发送可选的 DATA 帧
        if (hasBody) {
            byte[] bodyBytes = body.ToBytes();
            byte[] dataFrameHdr = Http2Frame.EncodeHeader(bodyBytes.Length, Http2FrameType.DATA, Http2Flags.END_STREAM, sid);
            byte[] fullDataPkt = new byte[9 + bodyBytes.Length];
            NativeMemory.Copy((nint)fullDataPkt, (nint)dataFrameHdr, 9);
            NativeMemory.Copy((nint)fullDataPkt + 9, (nint)bodyBytes, bodyBytes.Length);
            await this.SendRawAsync(fullDataPkt, fullDataPkt.Length);
        }

        // 5. 在当前流的专属门语上异步挂起，等待响应数据到达唤醒
        await stream.gate.Wait();
        stream.gate.Close();

        // 6. 从活跃流列表移除
        this.stateLockWait();
        for (int k = 0; k < this.activeStreams.Count; k = k + 1) {
            if (this.activeStreams[k].streamId == sid) {
                this.activeStreams.RemoveAt(k);
                break;
            }
        }
        this.stateLockRelease();

        if (stream.errorCode != 0) {
            return null;
        }

        HttpResponse resp = new HttpResponse();
        resp.statusCode = stream.responseStatus;
        resp.body = stream.responseBody.ToString();
        for (int h = 0; h < stream.responseHeaders.Count; h = h + 1) {
            HpackHeader rh = stream.responseHeaders[h];
            if (!rh.name.StartsWith(":")) {
                resp.SetHeader(rh.name, rh.value);
            }
        }
        return resp;
    }

    // 辅助同步直接发送原始控制报文（受出站锁保护）。
    void SendRaw(byte[] buf, int len) {
        if (this.sock < 0 || buf == null || len <= 0) { return; }
        this.stateLockWait();
        try {
            Socket.Send(this.sock, buf, len);
        } catch (Exception ex) {}
        this.stateLockRelease();
    }

    // 异步串行发送完整数据帧。
    async int SendRawAsync(byte[] buf, int len) {
        if (this.sock < 0 || buf == null || len <= 0) { return 0; }
        this.stateLockWait();
        int sent = 0;
        try {
            sent = await Socket.SendAsync(this.sock, buf, len);
        } catch (Exception ex) {}
        this.stateLockRelease();
        return sent;
    }

    // 精确读取指定字节数。
    async int ReadExactAsync(byte[] buf, int count) {
        int got = 0;
        byte[] tmp = new byte[count];
        while (got < count && this.connected) {
            int n = await Socket.RecvOv(this.sock, tmp, count - got);
            if (n <= 0) { break; }
            for (int i = 0; i < n; i = i + 1) {
                buf[got] = tmp[i];
                got = got + 1;
            }
        }
        return got;
    }

    public void Close() {
        this.connected = false;
        if (this.sock >= 0) {
            Socket.Close(this.sock);
            this.sock = -1;
        }
        this.stateLockWait();
        for (int i = 0; i < this.activeStreams.Count; i = i + 1) {
            this.activeStreams[i].Reset(Http2Error.CONNECT_ERROR);
        }
        this.activeStreams.Clear();
        this.stateLockRelease();
    }

    // 发送 WINDOW_UPDATE 帧更新指定流（或连接级 streamId=0）的接收窗口配额
    public void SendWindowUpdate(int streamId, int increment) {
        if (increment <= 0) { return; }
        byte[] wu = Http2Frame.BuildWindowUpdate(streamId, increment);
        this.SendRaw(wu, wu.Length);
    }

    public async Task SendWindowUpdateAsync(int streamId, int increment) {
        if (increment <= 0) { return; }
        byte[] wu = Http2Frame.BuildWindowUpdate(streamId, increment);
        await this.SendRawAsync(wu, wu.Length);
    }

    public void Dispose() {
        this.Close();
    }
}
