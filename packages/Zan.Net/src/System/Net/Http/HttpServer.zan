using System;
using System.Collections.Generic;
using System.Net;
using System.Net.Sockets;
using System.Net.Http;
using System.Net.Http.Http2;
using System.Threading;

namespace System.Net.Http;

// 处理解析后的请求并生成要发送的响应。
// 异步声明，使处理器可以等待 I/O（Db/Redis 等）而不阻塞
// 连接的协程或 worker 事件循环。
public async delegate HttpResponse HttpRequestHandler(HttpRequest request);

// 基于协程的 HTTP/1.1 服务器：System.Net.Worker 之上的 http 门面。
// 每个客户端连接由各自的协程服务，Workers(n) 在 n 个进程中
// 运行同一服务器（Linux/macOS 用 SO_REUSEPORT，Windows 用 master accept
// 加 WSADuplicateSocket 移交），与 workerman 的
// $worker->count 一致。
// 用法：
// ```zan
// async HttpResponse Handle(HttpRequest req) {
//     if (req.path == "/") { return HttpResponse.Text("ok"); }
//     return HttpResponse.NotFound();
// }
// HttpServer server = new HttpServer("127.0.0.1", 8080);
// server.Workers(4);
// server.OnRequest(Handle);
// Task.Spawn(server.Start());
// ```
// 连接循环（ServeConnection）是
// HTTP/1.1 帧解析与限制在本包中的唯一实现；Worker 的 "http" 协议
// 运行同一份代码，两者不会产生偏差。
public class HttpServer : IDisposable {
    private TcpListener listener;
    public string host;
    public int port;
    private bool running;
    public int maxConnections;
    public int maxConnectionsPerIp;
    public int activeConnections;
    private List<nint> activeSockets;
    private Dictionary<nint, string> socketIps;
    private Dictionary<string, int> ipConnections;
    private int requestTimeout;
    private int maxRequestBytes;
    private int maxHeaderBytes;
    public int workerCount;
    private HttpRequestHandler requestHandler;

    // 创建未启动的服务器；用 OnRequest / Workers 等配置后调用 Start。
    public HttpServer(string host, int port) {
        this.host = host;
        this.port = port;
        this.running = false;
        this.maxConnections = NetConstants.DefaultMaxConnections;
        this.maxConnectionsPerIp = NetConstants.DefaultMaxConnectionsPerIp;
        this.activeConnections = 0;
        this.activeSockets = new List<nint>();
        this.socketIps = new Dictionary<nint, string>();
        this.ipConnections = new Dictionary<string, int>();
        this.requestTimeout = NetConstants.TimeoutRequestMs;
        this.maxRequestBytes = NetConstants.DefaultMaxRequestBytes;
        this.maxHeaderBytes = NetConstants.DefaultMaxHeaderBytes;
        this.workerCount = 1;
        this.requestHandler = null;
    }

    // 设置最大并发连接数。
    public HttpServer SetMaxConnections(int max) {
        if (max < 1) { max = 1; }
        if (max > 1000000) { max = 1000000; }
        this.maxConnections = max;
        return this;
    }

    // 设置单个 IP 允许的最大并发连接数（0 表示不限制）。
    // 防止单客户端建立巨量连接耗尽服务端连接槽（Connection Slot Exhaustion）。
    public HttpServer SetMaxConnectionsPerIp(int max) {
        if (max < 0) { max = 0; }
        if (max > 100000) { max = 100000; }
        this.maxConnectionsPerIp = max;
        return this;
    }

    // 设置请求超时时间（毫秒）。
    public HttpServer SetTimeout(int ms) {
        if (ms < 1) { ms = 1; }
        if (ms > 86400000) { ms = 86400000; }
        this.requestTimeout = ms;
        return this;
    }

    // 设置单个请求的最大可接受大小（字节，
    // 请求头 + 请求体）。超过该大小的请求会返回 413，
    // 并关闭连接，防止客户端用
    // 无限制的请求耗尽内存。上限钳在 1 GiB：再大时帧解析里的
    // `headerEnd + bodyLen` 会 int 回绕，判限失效而放行超额请求；
    // 下限 1 KiB 避免 0/负数让每个请求都被 413。
    public HttpServer SetMaxRequestBytes(int bytes) {
        if (bytes < NetConstants.BufferSmall) { bytes = NetConstants.BufferSmall; }
        if (bytes > NetConstants.MaxRequestBytesCeiling) { bytes = NetConstants.MaxRequestBytesCeiling; }
        this.maxRequestBytes = bytes;
        return this;
    }

    // 设置请求头块的最大大小（字节）。
    // 客户端若持续发送请求头却不带结束空行，
    // 会在缓冲区增长到整请求上限前
    // 收到 431 并被断开连接。
    public HttpServer SetMaxHeaderBytes(int bytes) {
        if (bytes < 256) { bytes = 256; }
        if (bytes > 16777216) { bytes = 16777216; }
        this.maxHeaderBytes = bytes;
        return this;
    }

    // 服务该端口的进程数（对应 workerman 的
    // $worker->count）。1（默认）表示在本进程内服务。
    public HttpServer Workers(int count) {
        this.workerCount = count;
        return this;
    }

    // 返回请求头块结束位置之后的索引（即
    // <paramref name="buf"/> 中第一个请求的请求体首字节），
    // 若请求头的结束空行尚未到达则返回 -1。
    // 同时识别 CRLF（\r\n\r\n）与单独 LF（\n\n）分隔符。
    public static int FindHeaderEnd(string buf) {
        int len = buf.Length;
        for (int i = 0; i < len; i = i + 1) {
            if ((buf[i] & 255) == 10) {
                // "\n\n"
                if (i + 1 < len && (buf[i + 1] & 255) == 10) {
                    return i + 2;
                }
                // "\n\r\n"
                if (i + 2 < len && (buf[i + 1] & 255) == 13 && (buf[i + 2] & 255) == 10) {
                    return i + 3;
                }
            }
        }
        return -1;
    }

    // 注册每个传入请求都会调用的处理器。
    // 设置后取代默认的占位响应。
    public HttpServer OnRequest(HttpRequestHandler handler) {
        this.requestHandler = handler;
        return this;
    }

    // 启动服务器。当 Workers(n>1) 时，将监听器交给
    // System.Net.Worker，由其创建并监管 n 个进程；否则
    // 在本进程运行 accept 循环。服务器运行期间不会返回；
    // 每次 accept 以及每个连接上的读取都在 IO reactor 上挂起，
    // 而非忙等。
    public async void Start() {
        if (this.workerCount > 1) {
            Worker w = new Worker("http", this.host, this.port);
            w.count = this.workerCount;
            w.onHttpRequest = this.requestHandler;
            w.SetMaxConnections(this.maxConnections);
            w.SetHttpLimits(this.maxHeaderBytes, this.maxRequestBytes, this.requestTimeout);
            await Worker.RunAll();
            return;
        }

        Socket.Initialize();
        this.listener = new TcpListener(this.host, this.port);
        this.listener.Start();
        this.running = true;

        while (this.running) {
            nint clientSock = await this.listener.AcceptAsync();
            if (clientSock >= 0) {
                Socket.SetNoDelay(clientSock);
                if (!this.TryAcquireConnection(clientSock)) {
                    // 超过上限：返回 503 并挂断，而不是为无法服务的连接
                    // 堆积协程和缓冲区。
                    Task.Spawn(HttpServer.RejectOverloaded(clientSock));
                } else {
                    // 每个连接用独立协程处理，使 accept 循环
                    // 持续接受新连接，而不是一次只服务一个客户端。
                    Task.Spawn(HandleConnection(clientSock));
                }
            }
        }
    }

    // 互斥申请连接槽位，避免并发 Accept 与断连竞争撕裂 activeSockets 列表。
    private bool TryAcquireConnection(nint clientSock) {
        lock (this) {
            if (this.activeConnections >= this.maxConnections) {
                return false;
            }
            if (this.maxConnectionsPerIp > 0) {
                string ip = Socket.RemoteIp(clientSock);
                if (ip != null && ip.Length > 0) {
                    int cur = 0;
                    if (this.ipConnections.ContainsKey(ip)) {
                        cur = this.ipConnections[ip];
                    }
                    if (cur >= this.maxConnectionsPerIp) {
                        return false;
                    }
                    this.ipConnections[ip] = cur + 1;
                    this.socketIps[clientSock] = ip;
                }
            }
            this.activeConnections = this.activeConnections + 1;
            this.activeSockets.Add(clientSock);
            return true;
        }
    }

    // 互斥释放连接槽位。
    private void ReleaseConnection(nint clientSock) {
        lock (this) {
            this.activeConnections = this.activeConnections - 1;
            if (this.activeSockets != null) {
                this.activeSockets.Remove(clientSock);
            }
            if (this.socketIps != null && this.socketIps.ContainsKey(clientSock)) {
                string ip = this.socketIps[clientSock];
                this.socketIps.Remove(clientSock);
                if (this.ipConnections != null && this.ipConnections.ContainsKey(ip)) {
                    int c = this.ipConnections[ip] - 1;
                    if (c <= 0) {
                        this.ipConnections.Remove(ip);
                    } else {
                        this.ipConnections[ip] = c;
                    }
                }
            }
        }
    }

    // 超过 maxConnections 时对下游回 503（Connection: close）并关闭。
    // 使用 HttpDeadline 设定 3 秒硬超时并用 finally 闭环关闭连接，
    // 防止慢客户端故意不收包导致 RejectOverloaded 协程挂起与句柄泄露。
    private static async void RejectOverloaded(nint clientSock) {
        HttpDeadlineToken watch = HttpDeadline.Arm(clientSock, NetConstants.TimeoutHardRejectMs);
        TcpClient client = TcpClient.FromSocket(clientSock);
        try {
            HttpResponse busy = HttpResponse.WithStatus(503, "Service Unavailable",
                "server busy");
            busy = busy.SetKeepAlive(false);
            StringBuilder rsb = HttpBufferPool.Rent();
            busy.WriteTo(rsb);
            int _s = await client.SendViewAsync(rsb.AsView());
            HttpBufferPool.Return(rsb);
        } catch (Exception _ex) {
            // 发送失败直接丢弃，进入 finally 关闭套接字
        } finally {
            HttpDeadline.Disarm(watch);
            client.Close();
        }
    }

    // 处理单个客户端连接。连接计数必须在 finally 中归还：
    // 处理器抛出的异常会跳过顺序清理，泄漏的计数会让服务器在
    // maxConnections 处永久 503。
    private async void HandleConnection(nint clientSock) {
        try {
            await HttpServer.ServeConnection(clientSock, this.requestHandler,
                this.maxHeaderBytes, this.maxRequestBytes, this.requestTimeout);
        } finally {
            this.ReleaseConnection(clientSock);
        }
    }

    // 将一个 HTTP/1.1 连接服务到底：帧解析（分段
    // 读取、按 Content-Length 精确读取请求体、流水线）、keep-alive，以及
    // 防止恶意客户端耗尽进程的各项限制，并分发到
    // 这是 stdlib 中唯一的 HTTP 连接循环：HttpServer 与 Worker 的
    // "http" 协议都运行它，因此帧解析的修复与加固
    // 对两者同样生效。以下限制都在违规字节被缓冲前强制生效：
    // 431——请求头块超过 <paramref name="maxHeaderBytes"/>；
    // 413——请求超过 <paramref name="maxRequestBytes"/>，
    // 依据 Content-Length 判定，而非在缓冲完请求体之后；
    // 挂断——请求未在 <paramref name="timeoutMs"/> 内完成
    // （slowloris 防护：截止时间按请求单独设定，
    // 不会因零散到达的字节而刷新）。
    public static async void ServeConnection(nint clientSock, HttpRequestHandler handler,
                                      int maxHeaderBytes, int maxRequestBytes,
                                      int timeoutMs) {
        await HttpServer.ServePrimed(clientSock, handler, "",
            maxHeaderBytes, maxRequestBytes, timeoutMs);
    }

    // 用于首字节已被读取的套接字的 ServeConnection：
    // 将 `pending` 放回流头部。同时服务 HTTP 与 WebSocket 的端口
    // 需要先查看请求头部才能确定协议类型，
    // 并把已消费的字节交给本函数。
    public static async void ServePrimed(nint clientSock, HttpRequestHandler handler,
                                  string pending,
                                  int maxHeaderBytes, int maxRequestBytes,
                                  int timeoutMs) {
        // 拆包交给 HttpFramer：它按显式字节数攒未消费的字节，因此
        // 跨包到达的头部、跨包到达的正文、一个包里的多条流水线请求、
        // 以及含 NUL 的二进制正文都能精确定界（字符串拼接按 strlen
        // 定长，二进制正文会在第一个 NUL 处截断，声明的
        // Content-Length 就永远读不满）。
        HttpFramer framer = HttpFramer.Create(clientSock);
        framer.Prime(pending, pending.Length);
        await HttpServer.ServeFramed(clientSock, handler, framer,
            maxHeaderBytes, maxRequestBytes, timeoutMs);
    }

    // 原生字节数组重载：将已读前缀放回流头部。完全二进制安全，杜绝 NUL 截断。
    public static async void ServePrimedBytes(nint clientSock, HttpRequestHandler handler,
                                       byte[] pending, int pendingLen,
                                       int maxHeaderBytes, int maxRequestBytes,
                                       int timeoutMs) {
        HttpFramer framer = HttpFramer.Create(clientSock);
        if (pending != null && pendingLen > 0) {
            framer.PrimeBytes(pending, 0, pendingLen);
        }
        await HttpServer.ServeFramed(clientSock, handler, framer,
            maxHeaderBytes, maxRequestBytes, timeoutMs);
    }

    // 已经用 <see cref="HttpFramer"/> 读过若干字节的连接
    // （如 WebSocket 端口先读握手头部）交回 HTTP 循环：拆包器连同
    // 其中未消费的字节一并交接，无需把字节转成字符串再放回——
    // 二进制正文在这一步转换里会被 NUL 截断。
    public static async void ServeFramed(nint clientSock, HttpRequestHandler handler,
                                  HttpFramer framer,
                                  int maxHeaderBytes, int maxRequestBytes,
                                  int timeoutMs) {
        HttpDeadlineToken watch = HttpDeadline.Arm(clientSock, timeoutMs);
        try {
            await HttpServer.ServeFramedCore(clientSock, handler, framer,
                maxHeaderBytes, maxRequestBytes, timeoutMs, watch);
        } finally {
            HttpDeadline.Disarm(watch);
        }
    }

    // HTTP 连接循环本体：读头块 → 解析 → 读正文 → 分发
    // 处理器 → 按字节长度发响应，keep-alive 循环；431/413/400/501
    // 拒绝响应在此统一发送并关闭连接。
    public static async int ServeFramedCore(nint clientSock, HttpRequestHandler handler,
                                  HttpFramer framer,
                                  int maxHeaderBytes, int maxRequestBytes,
                                  int timeoutMs, HttpDeadlineToken watch) {
        TcpClient client = TcpClient.FromSocket(clientSock);
        // 处理器抛出的异常会跳过顺序清理语句（见
        // 与待处理缓冲、连接 fd、deadline 槽位都会泄漏。cleanup 交给
        // finally，正常路径与异常路径共用同一份释放代码。
        try {
            return await HttpServer.ServeFramedInner(clientSock, handler, framer,
                maxHeaderBytes, maxRequestBytes, timeoutMs, watch, client);
        } finally {
            HttpDeadline.Disarm(watch);
            framer.Dispose();
            client.Close();
        }
    }

    // Compatibility entry point for an already framed TCP connection.
    public static async int ServeFramedInner(nint clientSock, HttpRequestHandler handler,
                                  HttpFramer framer,
                                  int maxHeaderBytes, int maxRequestBytes,
                                  int timeoutMs, HttpDeadlineToken watch,
                                  TcpClient client) {
        Http1Writer writer = new Http1Writer(client.SendViewAsync);
        return await HttpServer.ServeHttp1Session(handler, framer, writer,
            maxHeaderBytes, maxRequestBytes, timeoutMs, watch,
            "<h1>Zan HTTP Server</h1><p>Register a handler with OnRequest.</p>");
    }

    // The caller owns the connection and deadline. This loop only sees the
    // transport's HTTP bytes, regardless of whether they came through TLS.
    public static async int ServeHttp1Session(HttpRequestHandler handler, HttpFramer framer,
            Http1Writer writer, int maxHeaderBytes, int maxRequestBytes, int timeoutMs,
            HttpDeadlineToken watch, string defaultBody) {
        int reject = 0;
        while (true) {
            HttpDeadline.Touch(watch, timeoutMs);
            int headerEnd = await framer.ReadHead(maxHeaderBytes);
            if (Worker.IsDebug()) {
                Worker.Dbg("http readHead=" + Convert.ToString(headerEnd));
            }
            if (headerEnd == -431) { reject = 431; break; }
            if (headerEnd <= 0) { break; }

            HttpRequest request = HttpRequest.Parse(framer.Head(headerEnd), headerEnd);
            if (Worker.IsDebug()) {
                Worker.Dbg("http parsed " + request.method + " " + request.path
                    + " status=" + Convert.ToString(request.parseStatus));
            }
            // The existing HTTP/2 entry accepts a byte writer and the same
            // framer, including bytes buffered after the preface's first line.
            if (request.method == "PRI" && request.path == "*" && request.version == "HTTP/2.0") {
                framer.Consume(headerEnd);
                return await Http2ServerConnection.ServeTlsAsync(writer.SendFrameAsync, handler,
                    framer, maxHeaderBytes, maxRequestBytes, timeoutMs);
            }
            if (request.parseStatus != 0) { reject = request.parseStatus; break; }
            if (headerEnd > maxRequestBytes || request.contentLength > maxRequestBytes - headerEnd) {
                reject = 413;
                break;
            }
            HttpDeadline.Touch(watch, timeoutMs);
            int bodyStatus = await framer.ReadBody(request, maxRequestBytes - headerEnd);
            if (bodyStatus > 0) { reject = bodyStatus; break; }
            if (bodyStatus < 0) { break; }
            framer.Consume(framer.RequestBytes());
            bool keepAlive = request.keepAlive;
            Worker.BumpStat();

            HttpDeadline.Touch(watch, timeoutMs);
            HttpResponse response = null;
            if (handler == null) {
                response = HttpResponse.Ok(defaultBody);
            } else {
                try {
                    response = await handler(request);
                } catch (Exception e) {
                    // Request boundary: report details only in the server log.
                    Console.WriteLine("[http] handler exception on " + request.method
                        + " " + request.path + ": " + e.Message);
                }
            }
            if (response == null) {
                response = HttpResponse.ServerError("internal error");
                keepAlive = false;
            }
            response.SetKeepAlive(keepAlive);
            bool sent = false;
            try {
                sent = await HttpServer.WriteHttp1Response(writer, response, request);
            } finally {
                response.Dispose();
            }
            if (!sent) { break; }
            Worker.BumpSent();
            if (!keepAlive) { break; }
        }

        HttpResponse failure = HttpServer.Rejection(reject);
        if (failure != null) {
            failure.SetKeepAlive(false);
            try {
                bool sent = await HttpServer.WriteHttp1Response(writer, failure, null);
            } finally {
                failure.Dispose();
            }
        }
        return 0;
    }

    private static HttpResponse Rejection(int status) {
        if (status == 431) {
            return HttpResponse.WithStatus(431, "Request Header Fields Too Large", "header block exceeds limit");
        }
        if (status == 413) {
            return HttpResponse.WithStatus(413, "Payload Too Large", "request exceeds limit");
        }
        if (status == 400) {
            return HttpResponse.WithStatus(400, "Bad Request", "malformed request framing");
        }
        if (status == 501) {
            return HttpResponse.WithStatus(501, "Not Implemented", "Transfer-Encoding is not supported");
        }
        return null;
    }

    private static async bool WriteHttp1Response(Http1Writer writer, HttpResponse response, HttpRequest request) {
        int status = response.statusCode;
        bool omitBody = (request != null && request.method == "HEAD")
            || (status >= 100 && status < 200) || status == 204 || status == 304;
        bool binary = response.IsBinary();
        StringBuilder sb = HttpBufferPool.Rent();
        try {
            if (omitBody || binary || response.framingChunked) { response.WriteHeadersTo(sb); }
            else { response.WriteTo(sb); }
            StringView wire = sb.AsView();
            int sent = await writer.SendViewAsync(wire);
            if (sent != wire.length) { return false; }
        } finally {
            HttpBufferPool.Return(sb);
        }
        if (omitBody) { return true; }
        if (response.framingChunked) {
            while (true) {
                byte[] piece = null;
                if (response.chunkSource != null) {
                    try {
                        piece = await response.chunkSource();
                    } catch (Exception e) {
                        // Headers are already on the wire. Closing without the
                        // terminator marks this response as incomplete.
                        string target = request != null ? " on " + request.method + " " + request.path : "";
                        Console.WriteLine("[http] chunk source exception" + target + ": " + e.Message);
                        return false;
                    }
                }
                if (piece == null || piece.Length == 0) { break; }
                string prefix = HttpChunkWriter.HexLength(piece.Length) + "\r\n";
                int prefixSent = await writer.SendTextAsync(prefix);
                if (prefixSent != prefix.Length) { return false; }
                int pieceSent = await writer.SendFrameAsync(piece, piece.Length);
                if (pieceSent != piece.Length) { return false; }
                string suffix = "\r\n";
                int suffixSent = await writer.SendTextAsync(suffix);
                if (suffixSent != suffix.Length) { return false; }
            }
            string term = "0\r\n\r\n";
            int termSent = await writer.SendTextAsync(term);
            return termSent == term.Length;
        }
        if (binary) {
            int count = response.BodyLength();
            if (count > 0) {
                int sent = await writer.SendFrameAsync(response.bodyBytes, count);
                return sent == count;
            }
        }
        return true;
    }

    // 停止服务器。
    public void Stop() {
        this.running = false;
        if (this.listener != null) {
            this.listener.Stop();
        }
        lock (this) {
            if (this.activeSockets != null) {
                for (int i = 0; i < this.activeSockets.Count; i = i + 1) {
                    Socket.Close(this.activeSockets[i]);
                }
                this.activeSockets.Clear();
            }
            this.activeConnections = 0;
        }
    }

    public void Dispose() {
        this.Stop();
    }

    // 返回当前活动连接数。
    public int GetActiveConnections() {
        lock (this) {
            return this.activeConnections;
        }
    }

    // 返回服务器是否正在运行。
    public bool IsRunning() {
        return this.running;
    }
}
