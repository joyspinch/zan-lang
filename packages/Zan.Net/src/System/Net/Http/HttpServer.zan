using System;
using System.Net;
using System.Net.Sockets;
using System.Net.Http;
using System.Threading;

namespace System.Net.Http;

// 处理解析后的请求并生成要发送的响应。
// 异步声明，使处理器可以等待 I/O（Db/Redis 等）而不阻塞
// 连接的协程或 worker 事件循环。
public async delegate HttpResponse HttpRequestHandler(HttpRequest request);

// 基于协程的 HTTP/1.1 服务器：System.Net.Worker 之上的 http 门面。
// 每个客户端连接由各自的协程服务，Workers(n) 在 n 个进程中
// 运行同一服务器（Linux/macOS 用 SO_REUSEPORT，Windows 用 master accept
// 加 WSADuplicateSocket 移交），与 workerman 的
// $worker->count 一致。
// 用法：
// server.Workers(4);
// }
// if (req.path == "/") {
// }
// }
// 连接循环（ServeConnection）是
// HTTP/1.1 帧解析与限制在 stdlib 中的唯一实现；Worker 的 "http" 协议
// 运行同一份代码，两者不会产生偏差。
public class HttpServer : IDisposable {
    TcpListener listener;
    string host;
    int port;
    bool running;
    int maxConnections;
    int activeConnections;
    int requestTimeout;
    int maxRequestBytes;
    int maxHeaderBytes;
    int workerCount;
    HttpRequestHandler requestHandler;

    // 创建未启动的服务器；用 OnRequest / Workers 等配置后调用 Start。
    public HttpServer(string host, int port) {
        this.host = host;
        this.port = port;
        this.running = false;
        this.maxConnections = 10000;
        this.activeConnections = 0;
        this.requestTimeout = 30000;
        this.maxRequestBytes = 1048576;
        this.maxHeaderBytes = 16384;
        this.workerCount = 1;
        this.requestHandler = null;
    }

    // 设置最大并发连接数。
    public HttpServer SetMaxConnections(int max) {
        if (max < 1) { max = 1; }
        if (max > 1000000) { max = 1000000; }
        this.maxConnections = max;
        return this;
    }

    // 设置请求超时时间（毫秒）。
    public HttpServer SetTimeout(int ms) {
        if (ms < 1) { ms = 1; }
        if (ms > 86400000) { ms = 86400000; }
        this.requestTimeout = ms;
        return this;
    }

    // 设置单个请求的最大可接受大小（字节，
    // 请求头 + 请求体）。超过该大小的请求会返回 413，
    // 并关闭连接，防止客户端用
    // 无限制的请求耗尽内存。上限钳在 1 GiB：再大时帧解析里的
    // `headerEnd + bodyLen` 会 int 回绕，判限失效而放行超额请求；
    // 下限 1 KiB 避免 0/负数让每个请求都被 413。
    public HttpServer SetMaxRequestBytes(int bytes) {
        if (bytes < 1024) { bytes = 1024; }
        if (bytes > 1073741824) { bytes = 1073741824; }
        this.maxRequestBytes = bytes;
        return this;
    }

    // 设置请求头块的最大大小（字节）。
    // 客户端若持续发送请求头却不带结束空行，
    // 会在缓冲区增长到整请求上限前
    // 收到 431 并被断开连接。
    public HttpServer SetMaxHeaderBytes(int bytes) {
        if (bytes < 256) { bytes = 256; }
        if (bytes > 16777216) { bytes = 16777216; }
        this.maxHeaderBytes = bytes;
        return this;
    }

    // 服务该端口的进程数（对应 workerman 的
    // $worker->count）。1（默认）表示在本进程内服务。
    public HttpServer Workers(int count) {
        this.workerCount = count;
        return this;
    }

    // 返回请求头块结束位置之后的索引（即
    // <paramref name="buf"/> 中第一个请求的请求体首字节），
    // 若请求头的结束空行尚未到达则返回 -1。
    // 同时识别 CRLF（\r\n\r\n）与单独 LF（\n\n）分隔符。
    public static int FindHeaderEnd(string buf) {
        int len = buf.Length;
        for (int i = 0; i < len; i = i + 1) {
            if ((buf[i] & 255) == 10) {
                // "\n\n"
                if (i + 1 < len && (buf[i + 1] & 255) == 10) {
                    return i + 2;
                }
                // "\n\r\n"
                if (i + 2 < len && (buf[i + 1] & 255) == 13 && (buf[i + 2] & 255) == 10) {
                    return i + 3;
                }
            }
        }
        return -1;
    }

    // 注册每个传入请求都会调用的处理器。
    // 设置后取代默认的占位响应。
    public HttpServer OnRequest(HttpRequestHandler handler) {
        this.requestHandler = handler;
        return this;
    }

    // 启动服务器。当 Workers(n>1) 时，将监听器交给
    // System.Net.Worker，由其创建并监管 n 个进程；否则
    // 在本进程运行 accept 循环。服务器运行期间不会返回；
    // 每次 accept 以及每个连接上的读取都在 IO reactor 上挂起，
    // 而非忙等。
    public async void Start() {
        if (this.workerCount > 1) {
            Worker w = new Worker("http", this.host, this.port);
            w.count = this.workerCount;
            w.onHttpRequest = this.requestHandler;
            w.SetMaxConnections(this.maxConnections);
            w.SetHttpLimits(this.maxHeaderBytes, this.maxRequestBytes, this.requestTimeout);
            await Worker.RunAll();
            return;
        }

        Socket.Initialize();
        this.listener = new TcpListener(this.host, this.port);
        this.listener.Start();
        this.running = true;

        while (this.running) {
            nint clientSock = await this.listener.AcceptAsync();
            if (clientSock >= 0) {
                Socket.SetNoDelay(clientSock);
                if (this.activeConnections >= this.maxConnections) {
                    // 超过上限：返回 503 并挂断，而不是为无法服务的连接
                    // 堆积协程和缓冲区。
                    Task.Spawn(HttpServer.RejectOverloaded(clientSock));
                } else {
                    this.activeConnections = this.activeConnections + 1;
                    // 每个连接用独立协程处理，使 accept 循环
                    // 持续接受新连接，而不是一次只服务一个客户端。
                    Task.Spawn(HandleConnection(clientSock));
                }
            }
        }
    }

    // 超过 maxConnections 时对下游回 503（Connection: close）并关闭。
    // 使用 HttpDeadline 设定 3 秒硬超时并用 finally 闭环关闭连接，
    // 防止慢客户端故意不收包导致 RejectOverloaded 协程挂起与句柄泄露。
    static async void RejectOverloaded(nint clientSock) {
        HttpDeadlineToken watch = HttpDeadline.Arm(clientSock, 3000);
        TcpClient client = TcpClient.FromSocket(clientSock);
        try {
            HttpResponse busy = HttpResponse.WithStatus(503, "Service Unavailable",
                "server busy");
            busy = busy.SetKeepAlive(false);
            int _s = await client.SendAsync(busy.Build());
        } catch (Exception _ex) {
            // 发送失败直接丢弃，进入 finally 关闭套接字
        } finally {
            HttpDeadline.Disarm(watch);
            client.Close();
        }
    }

    // 处理单个客户端连接。连接计数必须在 finally 中归还：
    // 处理器抛出的异常会跳过顺序清理，泄漏的计数会让服务器在
    // maxConnections 处永久 503。
    async void HandleConnection(nint clientSock) {
        try {
            await HttpServer.ServeConnection(clientSock, this.requestHandler,
                this.maxHeaderBytes, this.maxRequestBytes, this.requestTimeout);
        } finally {
            this.activeConnections = this.activeConnections - 1;
        }
    }

    // 将一个 HTTP/1.1 连接服务到底：帧解析（分段
    // 读取、按 Content-Length 精确读取请求体、流水线）、keep-alive，以及
    // 防止恶意客户端耗尽进程的各项限制，并分发到
    // 这是 stdlib 中唯一的 HTTP 连接循环：HttpServer 与 Worker 的
    // "http" 协议都运行它，因此帧解析的修复与加固
    // 对两者同样生效。以下限制都在违规字节被缓冲前强制生效：
    // 431——请求头块超过 <paramref name="maxHeaderBytes"/>；
    // 413——请求超过 <paramref name="maxRequestBytes"/>，
    // 依据 Content-Length 判定，而非在缓冲完请求体之后；
    // 挂断——请求未在 <paramref name="timeoutMs"/> 内完成
    // （slowloris 防护：截止时间按请求单独设定，
    // 不会因零散到达的字节而刷新）。
    public static async void ServeConnection(nint clientSock, HttpRequestHandler handler,
                                      int maxHeaderBytes, int maxRequestBytes,
                                      int timeoutMs) {
        await HttpServer.ServePrimed(clientSock, handler, "",
            maxHeaderBytes, maxRequestBytes, timeoutMs);
    }

    // 用于首字节已被读取的套接字的 ServeConnection：
    // 将 `pending` 放回流头部。同时服务 HTTP 与 WebSocket 的端口
    // 需要先查看请求头部才能确定协议类型，
    // 并把已消费的字节交给本函数。
    public static async void ServePrimed(nint clientSock, HttpRequestHandler handler,
                                  string pending,
                                  int maxHeaderBytes, int maxRequestBytes,
                                  int timeoutMs) {
        // 拆包交给 HttpFramer：它按显式字节数攒未消费的字节，因此
        // 跨包到达的头部、跨包到达的正文、一个包里的多条流水线请求、
        // 以及含 NUL 的二进制正文都能精确定界（字符串拼接按 strlen
        // 定长，二进制正文会在第一个 NUL 处截断，声明的
        // Content-Length 就永远读不满）。
        HttpFramer framer = HttpFramer.Create(clientSock);
        framer.Prime(pending, pending.Length);
        await HttpServer.ServeFramed(clientSock, handler, framer,
            maxHeaderBytes, maxRequestBytes, timeoutMs);
    }

    // 原生字节数组重载：将已读前缀放回流头部。完全二进制安全，杜绝 NUL 截断。
    public static async void ServePrimedBytes(nint clientSock, HttpRequestHandler handler,
                                       byte[] pending, int pendingLen,
                                       int maxHeaderBytes, int maxRequestBytes,
                                       int timeoutMs) {
        HttpFramer framer = HttpFramer.Create(clientSock);
        if (pending != null && pendingLen > 0) {
            framer.PrimeBytes(pending, 0, pendingLen);
        }
        await HttpServer.ServeFramed(clientSock, handler, framer,
            maxHeaderBytes, maxRequestBytes, timeoutMs);
    }

    // 已经用 <see cref="HttpFramer"/> 读过若干字节的连接
    // （如 WebSocket 端口先读握手头部）交回 HTTP 循环：拆包器连同
    // 其中未消费的字节一并交接，无需把字节转成字符串再放回——
    // 二进制正文在这一步转换里会被 NUL 截断。
    public static async void ServeFramed(nint clientSock, HttpRequestHandler handler,
                                  HttpFramer framer,
                                  int maxHeaderBytes, int maxRequestBytes,
                                  int timeoutMs) {
        HttpDeadlineToken watch = HttpDeadline.Arm(clientSock, timeoutMs);
        try {
            await HttpServer.ServeFramedCore(clientSock, handler, framer,
                maxHeaderBytes, maxRequestBytes, timeoutMs, watch);
        } finally {
            HttpDeadline.Disarm(watch);
        }
    }

    // HTTP 连接循环本体：读头块 → 解析 → 读正文 → 分发
    // 处理器 → 按字节长度发响应，keep-alive 循环；431/413/400/501
    // 拒绝响应在此统一发送并关闭连接。
    public static async int ServeFramedCore(nint clientSock, HttpRequestHandler handler,
                                  HttpFramer framer,
                                  int maxHeaderBytes, int maxRequestBytes,
                                  int timeoutMs, HttpDeadlineToken watch) {
        TcpClient client = TcpClient.FromSocket(clientSock);
        // 处理器抛出的异常会跳过顺序清理语句（见
        // 与待处理缓冲、连接 fd、deadline 槽位都会泄漏。cleanup 交给
        // finally，正常路径与异常路径共用同一份释放代码。
        try {
            return await HttpServer.ServeFramedInner(clientSock, handler, framer,
                maxHeaderBytes, maxRequestBytes, timeoutMs, watch, client);
        } finally {
            HttpDeadline.Disarm(watch);
            framer.Dispose();
            client.Close();
        }
    }

    // ServeFramedCore 的循环体；释放见 ServeFramedCore 的 finally。
    public static async int ServeFramedInner(nint clientSock, HttpRequestHandler handler,
                                  HttpFramer framer,
                                  int maxHeaderBytes, int maxRequestBytes,
                                  int timeoutMs, HttpDeadlineToken watch,
                                  TcpClient client) {
        bool keepAlive = true;
        int reject = 0;

        while (keepAlive) {
            // 每个请求使用新的截止时间：连接可在 keep-alive 请求之间
            // 空闲，但一旦开始收到字节，整个请求必须
            // 落在窗口时间内。
            HttpDeadline.Touch(watch, timeoutMs);

            // 1) 一直读取，直到完整请求头块到达。
            int headerEnd = await framer.ReadHead(maxHeaderBytes);
            System.Net.Worker.Dbg("http readHead=" + Convert.ToString(headerEnd));
            if (headerEnd == -431) { reject = 431; break; }
            if (headerEnd <= 0) { keepAlive = false; break; }

            // 2) 只解析一次：此时请求头已完整，每个请求头字段
            // 都是最终值；只有请求体可能仍在传输中。然后
            // 继续读取，直到请求体声明的字节数全部到齐。
            HttpRequest request = HttpRequest.Parse(framer.Head(headerEnd),
                                                   headerEnd);
            System.Net.Worker.Dbg("http parsed " + request.method + " "
                + request.path + " status=" + Convert.ToString(request.parseStatus));
            // 定界失败（Content-Length 溢出/重复不一致、非数字、
            // 未实现的 Transfer-Encoding 等）→ 拒绝，不切分正文：
            // 剩余字节可能是走私的伪装请求，绝不能进入下轮。
            if (request.parseStatus != 0) {
                reject = request.parseStatus;
                break;
            }
            int bodyLen = request.contentLength;
            if (bodyLen < 0) { bodyLen = 0; }
            if (bodyLen > maxRequestBytes - headerEnd) { reject = 413; break; }
            // 3) 正文到齐（分块编码在此解码），随后精确丢弃本请求的
            // 字节，剩余字节即下一条流水线请求的开头。
            int bodyStatus = await framer.ReadBody(request,
                maxRequestBytes - headerEnd);
            if (bodyStatus > 0) { reject = bodyStatus; break; }
            if (bodyStatus < 0) { keepAlive = false; break; }
            framer.Consume(framer.RequestBytes());
            keepAlive = request.keepAlive;
            Worker.BumpStat();

            HttpResponse response = null;
            if (handler != null) {
                // 用户处理器不受框架信任：抛出的异常若放任展开会跳过
                // 本轮响应并把连接直接撕断（客户端看到 000/EOF 而非
                // 500），还会让 keep-alive 循环整个退出。兜成 500 后
                // 连接照常存活；nextKeepAlive 置 false 防状态错位。
                try {
                    response = await handler(request);
                } catch (Exception e) {
                    // 记录到 stderr（Worker 默认把输出重定向进日志文件）。
                    Console.WriteLine("[http] handler exception on "
                        + request.method + " " + request.path + ": " + e.Message);
                    response = HttpResponse.ServerError("internal error");
                    keepAlive = false;
                }
            } else {
                response = HttpResponse.Ok(
                    "<h1>Zan HTTP Server</h1><p>Register a handler with OnRequest.</p>");
            }
            response = response.SetKeepAlive(keepAlive);

            // 按字节长度发送：SendAsync 用 strlen 定长，正文里的 NUL
            // 会把响应截断（下载二进制文件、返回带 NUL 的日志片段时
            // 客户端只收到半个报文）。Content-Length 与发送长度必须
            // 取自同一处（BodyLength）。二进制正文单独发一次，因为它
            // 无法拼进以 NUL 结尾的字符串里。
            // HEAD 与 1xx/204/304 响应禁止在线路上发送任何正文字节。
            bool statusBodyless = (response.statusCode >= 100 && response.statusCode < 200)
                || response.statusCode == 204
                || response.statusCode == 304;
            bool omitBody = (request != null && request.method == "HEAD") || statusBodyless;

            if (omitBody) {
                string head = response.BuildHeaders();
                int _h0 = await client.SendBytesAsync(head, head.Length);
            } else if (response.framingChunked) {
                // 分块传输：先发头部（Transfer-Encoding: chunked，不带
                // Content-Length），再逐块取正文写出。块边界必须在线路
                // 上一致，所以长度前缀、数据、分隔符分三次写出——
                // Socket.SendAsync 是"写完"语义，不会短写，拼一次发
                // 反而多一次拷贝。
                // 分支条件是 framingChunked 而不是"有正文来源"：空正文
                // 也要走这条路径（发完头部写结束块），否则客户端会一直
                // 等一个永远不来的结束块。
                string head = response.BuildHeaders();
                int _h3 = await client.SendBytesAsync(head, head.Length);
                bool complete = true;
                while (true) {
                    byte[] piece = null;
                    if (response.chunkSource != null) {
                        try {
                            piece = await response.chunkSource();
                        } catch (Exception e) {
                            // 头部已经发出，改不了状态码：只能断开连接。
                            // 不写结束块就是明确的"正文被截断"标记，客户端
                            // 读到没有结束块的流会报错，不会把半截正文当成
                            // 完整响应。
                            Console.WriteLine("[http] chunk source exception on "
                                + request.method + " " + request.path + ": "
                                + e.Message);
                            complete = false;
                            break;
                        }
                    }
                    if (piece == null || piece.Length == 0) { break; }
                    byte[] prefix = HttpChunkWriter.FramePrefix(piece.Length);
                    int _p1 = await client.SendBytesAsync(prefix, 0, prefix.Length);
                    int _p2 = await client.SendBytesAsync(piece, 0, piece.Length);
                    byte[] suffix = HttpChunkWriter.FrameSuffix();
                    int _p3 = await client.SendBytesAsync(suffix, 0, suffix.Length);
                }
                if (complete) {
                    byte[] term = HttpChunkWriter.Terminator();
                    int _t = await client.SendBytesAsync(term, 0, term.Length);
                } else {
                    // 连接不能复用：客户端还等着结束块，下一轮请求的
                    // 字节会被当成这一响应的正文。
                    keepAlive = false;
                }
            } else if (response.IsBinary()) {
                string head = response.BuildHeaders();
                int _h2 = await client.SendBytesAsync(head, head.Length);
                int blen = response.BodyLength();
                if (blen > 0) {
                    int _b2 = await client.SendBytesAsync(response.bodyBytes, blen);
                }
            } else {
                string responseData = response.Build();
                int _sent = await client.SendBytesAsync(responseData, responseData.Length);
                System.Net.Worker.Dbg("http sent bytes=" + Convert.ToString(_sent)
                    + " status=" + Convert.ToString(response.statusCode));
            }
            response.Dispose();
            response = null;
            Worker.BumpSent();

            if (!keepAlive) {
                break;
            }
        }

        if (reject == 431) {
            HttpResponse big = HttpResponse.WithStatus(431,
                "Request Header Fields Too Large", "header block exceeds limit");
            big = big.SetKeepAlive(false);
            string body = big.Build();
            int _h = await client.SendBytesAsync(body, body.Length);
        } else if (reject == 413) {
            HttpResponse tooLarge = HttpResponse.WithStatus(413, "Payload Too Large",
                "request exceeds limit");
            tooLarge = tooLarge.SetKeepAlive(false);
            string body = tooLarge.Build();
            int _s = await client.SendBytesAsync(body, body.Length);
        } else if (reject == 400) {
            // 定界冲突/畸形长度：请求走私拒绝。必须关闭连接——
            // 缓冲区里可能还有伪装成下一条请求的剩余正文。
            HttpResponse bad = HttpResponse.WithStatus(400, "Bad Request",
                "malformed request framing");
            bad = bad.SetKeepAlive(false);
            string body = bad.Build();
            int _b = await client.SendBytesAsync(body, body.Length);
        } else if (reject == 501) {
            HttpResponse nai = HttpResponse.WithStatus(501, "Not Implemented",
                "Transfer-Encoding is not supported");
            nai = nai.SetKeepAlive(false);
            string body = nai.Build();
            int _n = await client.SendBytesAsync(body, body.Length);
        }

        return 0;
    }

    // 停止服务器。
    public void Stop() {
        this.running = false;
        if (this.listener != null) {
            this.listener.Stop();
        }
    }

    public void Dispose() {
        this.Stop();
    }

    // 返回当前活动连接数。
    public int GetActiveConnections() {
        return this.activeConnections;
    }

    // 返回服务器是否正在运行。
    public bool IsRunning() {
        return this.running;
    }
}

// Arm 返回的截止时间句柄：记录槽位下标与 generation，供 Disarm 使用。
