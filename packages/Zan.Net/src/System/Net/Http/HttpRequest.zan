using System;
using System.Text;

namespace System.Net.Http;

// HTTP 请求的表示与解析器。
// 从 TCP 数据解析原始 HTTP/1.1 请求。
public class HttpRequest {
    public string method;
    public string path;
    public string version;
    public string body;
    public string rawHeaders;
    public string queryString;
    public string host;
    public string contentType;
    // 解析时顺带捕获的两个请求级头部。头部块的每次按名查找都要重扫
    // 一遍整块字节，而这两个头部是服务器每个请求都要问的（认证：
    // Authorization / 会话 cookie），所以和 host/contentType 一样在
    // 唯一的那次扫描里就取出来，GetHeader 直接命中。
    public string authorization;
    public string cookie;
    public string userAgent;
    public int contentLength;
    public bool keepAlive;
    // 正文的真实字节数。字符串以 NUL 结尾，body.Length 只数到第一个
    // NUL，二进制请求体（上传、protobuf、压缩内容）会因此被截断，
    // 所以长度单独记录，凡按长度处理正文的地方都用它。
    public int bodyLength;
    // 请求体采用分块传输编码（Transfer-Encoding: chunked）。头部解析
    // 只负责识别它：解码要读取头部之后的字节，是连接循环
    // （HttpFramer）的职责。
    public bool chunked;
    // 头部块结束之后的字节下标，即正文首字节在 raw 中的位置。
    // 流水线连接上其后的字节是"本请求正文 + 下一条请求"，只有按
    // contentLength 精确切分才不会把下一条请求吞进正文。
    public int bodyStart;
    // 请求定界/头部解析失败的原因（HTTP 状态码；0 = 正常）。
    // 服务器在信任 contentLength 切分正文之前必须检查它——
    // 回绕的 Content-Length、重复且不一致的 Content-Length、
    // 未实现的 Transfer-Encoding 都是请求走私的入口。
    public int parseStatus;

    // 零拷贝视图支持：原始报文及路径/查询切片偏移与长度
    public string raw;
    public int pathOffset;
    public int pathLength;
    public int queryOffset;
    public int queryLength;

    // 默认构造：HTTP/1.1 keep-alive 的默认状态，由 Parse 使用。
    public HttpRequest() {
        this.raw = "";
        this.pathOffset = 0;
        this.pathLength = 0;
        this.queryOffset = 0;
        this.queryLength = 0;
        this.method = "";
        this.path = "";
        this.version = "HTTP/1.1";
        this.body = "";
        this.rawHeaders = "";
        this.queryString = "";
        this.host = "";
        this.contentType = "";
        this.authorization = "";
        this.cookie = "";
        this.userAgent = "";
        this.contentLength = 0;
        this.keepAlive = true;
        this.bodyLength = 0;
        this.chunked = false;
        this.bodyStart = 0;
        this.parseStatus = 0;
    }

    // 是否为可选空白（SP / HTAB，RFC 7230 OWS）。
    private static bool IsOws(int c) {
        return c == 32 || c == 9;
    }

    // [start, stop) 起点跳过 RFC 7230 OWS（SP / HTAB）。
    private static int TrimOwsStart(string raw, int start, int stop) {
        while (start < stop && HttpRequest.IsOws(raw[start] & 255)) {
            start = start + 1;
        }
        return start;
    }

    // [start, stop) 终点回退 RFC 7230 OWS（SP / HTAB）。
    private static int TrimOwsStop(string raw, int start, int stop) {
        while (stop > start && HttpRequest.IsOws(raw[stop - 1] & 255)) {
            stop = stop - 1;
        }
        return stop;
    }

    // 把原始 HTTP 请求字符串解析为 HttpRequest。
    // 按字节下标扫描（<c>raw[i] &amp; 255</c>），而不是
    // <c>raw.Substring(i, 1)</c>。后者每检查一个字节都会在堆上分配一个
    // 单字符字符串，因此旧解析器每个请求要做 O(请求大小) 次分配；
    // 本实现原地遍历缓冲区，只分配
    // 实际提取的那几个字段。
    public static HttpRequest Parse(string raw) {
        return HttpRequest.Parse(raw, raw.Length);
    }

    // 把 <paramref name="raw"/> 开头的 <paramref name="rawLen"/>
    // 个字节解析为请求。字节数由调用方给出：连接循环从套接字
    // 得到的是精确计数，而 <c>raw.Length</c> 会在正文的第一个 NUL
    // 处停下，据此切分正文会把二进制上传截断。
    // 解析 HTTP 请求行：抽取请求方法、路径、查询串与协议版本。
    private static bool ParseRequestLine(HttpRequest req, string raw, int len, out int lineEnd) {
        lineEnd = 0;
        for (; lineEnd < len && (raw[lineEnd] & 255) != 10; lineEnd = lineEnd + 1) {
        }
        if (lineEnd >= len || lineEnd == 0 || (raw[lineEnd - 1] & 255) != 13) {
            return false;
        }
        int rlEnd = lineEnd - 1;
        for (int ri = 0; ri < rlEnd; ri = ri + 1) {
            int b = raw[ri] & 255;
            if (b < 32 && b != 9 || b == 127) {
                return false;
            }
        }

        int sp1 = 0;
        while (sp1 < rlEnd && !HttpRequest.IsOws(raw[sp1] & 255)) {
            sp1 = sp1 + 1;
        }
        if (sp1 == 3) {
            int b0 = raw[0] & 255;
            int b1 = raw[1] & 255;
            int b2 = raw[2] & 255;
            if (b0 == 71 && b1 == 69 && b2 == 84) { req.method = "GET"; }
            else if (b0 == 80 && b1 == 85 && b2 == 84) { req.method = "PUT"; }
            else { req.method = raw.Substring(0, sp1); }
        } else if (sp1 == 4) {
            int b0 = raw[0] & 255;
            int b1 = raw[1] & 255;
            int b2 = raw[2] & 255;
            int b3 = raw[3] & 255;
            if (b0 == 80 && b1 == 79 && b2 == 83 && b3 == 84) { req.method = "POST"; }
            else if (b0 == 72 && b1 == 69 && b2 == 65 && b3 == 68) { req.method = "HEAD"; }
            else { req.method = raw.Substring(0, sp1); }
        } else if (sp1 == 6 && HttpRequest.RegionIs(raw, 0, sp1, "delete")) {
            req.method = "DELETE";
        } else if (sp1 == 7 && HttpRequest.RegionIs(raw, 0, sp1, "options")) {
            req.method = "OPTIONS";
        } else if (sp1 == 5 && HttpRequest.RegionIs(raw, 0, sp1, "patch")) {
            req.method = "PATCH";
        } else {
            req.method = raw.Substring(0, sp1);
        }
        int pathStart = HttpRequest.TrimOwsStart(raw, sp1, rlEnd);
        int sp2 = pathStart;
        while (sp2 < rlEnd && !HttpRequest.IsOws(raw[sp2] & 255)) {
            sp2 = sp2 + 1;
        }
        int pathEnd = sp2;
        int versionStart = HttpRequest.TrimOwsStart(raw, sp2, rlEnd);
        int versionStop = HttpRequest.TrimOwsStop(raw, versionStart, rlEnd);
        int vLen = versionStop - versionStart;
        if (vLen == 8 && HttpRequest.RegionIs(raw, versionStart, versionStop, "http/1.1")) {
            req.version = "HTTP/1.1";
        } else if (vLen == 8 && HttpRequest.RegionIs(raw, versionStart, versionStop, "http/1.0")) {
            req.version = "HTTP/1.0";
        } else if (versionStart < versionStop) {
            req.version = raw.Substring(versionStart, versionStop - versionStart);
        } else {
            return false;
        }
        if (req.method.Length == 0 || pathStart >= pathEnd) {
            return false;
        }

        // 拆分路径和查询字符串
        int qmark = pathStart;
        bool foundQ = false;
        while (qmark < pathEnd) {
            if ((raw[qmark] & 255) == 63) {
                foundQ = true;
                break;
            }
            qmark = qmark + 1;
        }
        if (foundQ) {
            req.pathOffset = pathStart;
            int plen = qmark - pathStart;
            req.pathLength = plen;
            req.queryOffset = qmark + 1;
            int qlen = pathEnd - qmark - 1;
            req.queryLength = qlen;
            if (plen == 1 && (raw[pathStart] & 255) == 47) {
                req.path = "/";
            } else if (plen == 0) {
                req.path = "";
            } else {
                req.path = raw.Substring(pathStart, plen);
            }
            if (qlen == 0) {
                req.queryString = "";
            } else {
                req.queryString = raw.Substring(qmark + 1, qlen);
            }
        } else {
            req.pathOffset = pathStart;
            int plen = pathEnd - pathStart;
            req.pathLength = plen;
            req.queryOffset = 0;
            req.queryLength = 0;
            if (plen == 1 && (raw[pathStart] & 255) == 47) {
                req.path = "/";
            } else if (plen == 0) {
                req.path = "";
            } else {
                req.path = raw.Substring(pathStart, plen);
            }
            req.queryString = "";
        }
        return true;
    }

    // 解析请求头块：验证语法、提取核心字段并检查走私定界。返回正文起始下标，失败置 parseStatus 返回 -1。
    private static int ParseHeadersBlock(HttpRequest req, string raw, int len, int pos,
            out bool clSeen, out bool teSeen, out int hostCount, out bool connClose, out bool connKeep,
            out int headersStart, out int headersStop) {
        headersStart = pos;
        headersStop = pos;
        clSeen = false;
        teSeen = false;
        hostCount = 0;
        connClose = false;
        connKeep = false;
        long clAcc = 0;
        long firstCl = 0;
        bool headersEnded = false;

        while (pos < len) {
            int hEnd = pos;
            while (hEnd < len && (raw[hEnd] & 255) != 10) {
                hEnd = hEnd + 1;
            }
            if (hEnd >= len || hEnd == pos || (raw[hEnd - 1] & 255) != 13) {
                req.parseStatus = 400;
                return -1;
            }
            int lineStop = hEnd - 1;
            if (lineStop == pos) {
                pos = hEnd + 1;
                headersEnded = true;
                break;
            }
            headersStop = lineStop;

            for (int hi = pos; hi < lineStop; hi = hi + 1) {
                int hb = raw[hi] & 255;
                if ((hb < 32 && hb != 9) || hb == 127) {
                    req.parseStatus = 400;
                    return -1;
                }
            }
            int colonPos = pos;
            while (colonPos < lineStop && (raw[colonPos] & 255) != 58) {
                colonPos = colonPos + 1;
            }
            if (colonPos >= lineStop || colonPos == pos) {
                req.parseStatus = 400;
                return -1;
            }

            bool obfuscated = false;
            for (int si = pos; si < colonPos; si = si + 1) {
                int sc = raw[si] & 255;
                bool token = (sc >= 48 && sc <= 57)
                    || (sc >= 65 && sc <= 90) || (sc >= 97 && sc <= 122)
                    || sc == 33 || sc == 35 || sc == 36 || sc == 37
                    || sc == 38 || sc == 39 || sc == 42 || sc == 43
                    || sc == 45 || sc == 46 || sc == 94 || sc == 95
                    || sc == 96 || sc == 124 || sc == 126;
                if (!token) { obfuscated = true; break; }
            }
            if (obfuscated) {
                req.parseStatus = 400;
                return -1;
            }
            int vStart = HttpRequest.TrimOwsStart(raw, colonPos + 1, lineStop);
            int vStop = HttpRequest.TrimOwsStop(raw, vStart, lineStop);
            int nameLen = colonPos - pos;

            if (nameLen == 4 && RegionIs(raw, pos, colonPos, "host")) {
                hostCount = hostCount + 1;
                if (hostCount > 1 || vStart == vStop) { req.parseStatus = 400; }
                req.host = raw.Substring(vStart, vStop - vStart);
            } else if (nameLen == 12 && RegionIs(raw, pos, colonPos, "content-type")) {
                req.contentType = raw.Substring(vStart, vStop - vStart);
            } else if (nameLen == 13 && RegionIs(raw, pos, colonPos, "authorization")) {
                if (req.authorization.Length == 0) {
                    req.authorization = raw.Substring(vStart, vStop - vStart);
                }
            } else if (nameLen == 6 && RegionIs(raw, pos, colonPos, "cookie")) {
                if (req.cookie.Length == 0) {
                    req.cookie = raw.Substring(vStart, vStop - vStart);
                }
            } else if (nameLen == 10 && RegionIs(raw, pos, colonPos, "user-agent")) {
                if (req.userAgent.Length == 0) {
                    req.userAgent = raw.Substring(vStart, vStop - vStart);
                }
            } else if (nameLen == 14 && RegionIs(raw, pos, colonPos, "content-length")) {
                clAcc = 0;
                bool bad = vStart == vStop;
                int di = vStart;
                while (di < vStop) {
                    int d = raw[di] & 255;
                    if (d < 48 || d > 57) { bad = true; break; }
                    clAcc = clAcc * 10 + (d - 48);
                    if (clAcc > 2147483647) { bad = true; break; }
                    di = di + 1;
                }
                if (bad) {
                    bool overflow = vStart != vStop;
                    int ci = vStart;
                    while (ci < vStop) {
                        int dd = raw[ci] & 255;
                        if (dd < 48 || dd > 57) { overflow = false; break; }
                        ci = ci + 1;
                    }
                    if (overflow) {
                        req.parseStatus = 413;
                    } else {
                        req.parseStatus = 400;
                    }
                } else if (clSeen) {
                    if (firstCl != clAcc) { req.parseStatus = 400; }
                } else {
                    clSeen = true;
                    firstCl = clAcc;
                    req.contentLength = (int)clAcc;
                }
            } else if (nameLen == 17 && RegionIs(raw, pos, colonPos, "transfer-encoding")) {
                req.chunked = !teSeen && HttpRequest.RegionIs(raw, vStart, vStop, "chunked");
                teSeen = true;
            } else if (nameLen == 10 && RegionIs(raw, pos, colonPos, "connection")) {
                int t = vStart;
                while (t < lineStop) {
                    int tEnd = t;
                    while (tEnd < lineStop && (raw[tEnd] & 255) != 44) {
                        tEnd = tEnd + 1;
                    }
                    int tStop = HttpRequest.TrimOwsStop(raw, t, tEnd);
                    t = HttpRequest.TrimOwsStart(raw, t, tStop);
                    if (RegionIs(raw, t, tStop, "close")) { connClose = true; }
                    if (RegionIs(raw, t, tStop, "keep-alive")) { connKeep = true; }
                    t = tEnd + 1;
                    t = HttpRequest.TrimOwsStart(raw, t, lineStop);
                }
            }
            pos = hEnd + 1;
        }
        if (!headersEnded) {
            req.parseStatus = 400;
            return -1;
        }
        return pos;
    }

    // 裁决请求语义、校验 RFC 7230 定界共存规则并切分正文。
    private static void FinalizeBodyAndSemantics(HttpRequest req, string raw, int len, int pos,
            bool clSeen, bool teSeen, int hostCount, bool connClose, bool connKeep,
            int headersStart, int headersStop) {
        if (RegionIs(req.version, 0, req.version.Length, "http/1.0")) {
            req.keepAlive = connKeep;
        } else {
            req.keepAlive = !connClose;
        }
        if (teSeen && req.parseStatus == 0) {
            if (clSeen) {
                req.parseStatus = 400;
                req.chunked = false;
            } else if (!req.chunked) {
                req.parseStatus = 501;
            }
        }
        if (req.version != "HTTP/1.1" && req.version != "HTTP/1.0") {
            req.parseStatus = 400;
        }
        if (req.version == "HTTP/1.1" && hostCount != 1) {
            req.parseStatus = 400;
        }
        if (headersStop > headersStart) {
            req.rawHeaders = raw.Substring(headersStart, headersStop - headersStart);
        }

        req.bodyStart = pos;
        if (pos < len && !req.chunked) {
            int avail = len - pos;
            int take = avail;
            if (clSeen && req.contentLength < avail) { take = req.contentLength; }
            req.body = raw.Substring(pos, take);
            req.bodyLength = take;
        }
    }

    // 把 raw 开头的 rawLen 个字节解析为请求。
    public static HttpRequest Parse(string raw, int rawLen) {
        HttpRequest req = new HttpRequest();
        req.raw = raw;
        int len = rawLen;
        if (len < 0) { len = 0; }
        if (len == 0) { return req; }

        int lineEnd = 0;
        if (!HttpRequest.ParseRequestLine(req, raw, len, out lineEnd)) {
            req.parseStatus = 400;
            return req;
        }

        bool clSeen = false;
        bool teSeen = false;
        int hostCount = 0;
        bool connClose = false;
        bool connKeep = false;
        int headersStart = 0;
        int headersStop = 0;
        int pos = HttpRequest.ParseHeadersBlock(req, raw, len, lineEnd + 1,
            out clSeen, out teSeen, out hostCount, out connClose, out connKeep,
            out headersStart, out headersStop);
        if (pos < 0) {
            return req;
        }

        HttpRequest.FinalizeBodyAndSemantics(req, raw, len, pos,
            clSeen, teSeen, hostCount, connClose, connKeep,
            headersStart, headersStop);
        return req;
    }

    // 当 raw[pos..stop) 与 name 相等（ASCII 大小写不敏感）时为 true
    // （name 必须为小写）。无内存分配的头部匹配。
    private static bool RegionIs(string raw, int pos, int stop, string name) {
        if (stop - pos != name.Length) { return false; }
        for (int i = 0; pos + i < stop; i = i + 1) {
            int c = raw[pos + i] & 255;
            if (c >= 65 && c <= 90) { c = c + 32; }
            if (c != (name[i] & 255)) { return false; }
        }
        return true;
    }

    // 当 name 与 lower（须为小写字面量）相等（ASCII 大小写不敏感）
    // 时为 true。不分配：用于按名查找头部前的常见头部判定。
    private static bool NameIs(string name, string lower) {
        if (name.Length != lower.Length) { return false; }
        int n = lower.Length;
        for (int i = 0; i < n; i = i + 1) {
            int c = name[i] & 255;
            if (c >= 65 && c <= 90) { c = c + 32; }
            if (c != (lower[i] & 255)) { return false; }
        }
        return true;
    }

    // 与 <see cref="RegionIs"/> 相同，但 name 的大小写也不敏感——
    // 调用方传进来的名字不保证是小写，而把它 ToLower 一份只为比较，
    // 等于每次查找都在堆上分配一个副本。
    private static bool RegionIsCi(string raw, int pos, int stop, string name) {
        if (stop - pos != name.Length) { return false; }
        for (int i = 0; pos + i < stop; i = i + 1) {
            int c = raw[pos + i] & 255;
            if (c >= 65 && c <= 90) { c = c + 32; }
            int d = name[i] & 255;
            if (d >= 65 && d <= 90) { d = d + 32; }
            if (c != d) { return false; }
        }
        return true;
    }

    // 按名称获取某个头部值（大小写不敏感）。
    public string GetHeader(string name) {
        // 解析时已捕获的头部不必重扫头部块。
        if (HttpRequest.NameIs(name, "authorization")) { return this.authorization; }
        if (HttpRequest.NameIs(name, "cookie")) { return this.cookie; }
        if (HttpRequest.NameIs(name, "user-agent")) { return this.userAgent; }
        // 在 rawHeaders 中搜索（按字节扫描；只分配返回值本身）
        int pos = 0;
        int len = this.rawHeaders.Length;
        while (pos < len) {
            int lineEnd = pos;
            while (lineEnd < len && (this.rawHeaders[lineEnd] & 255) != 10) {
                lineEnd = lineEnd + 1;
            }
            int lineStop = lineEnd;
            if (lineStop > pos && (this.rawHeaders[lineStop - 1] & 255) == 13) { lineStop = lineStop - 1; }
            int colonPos = pos;
            while (colonPos < lineStop && (this.rawHeaders[colonPos] & 255) != 58) {
                colonPos = colonPos + 1;
            }
            if (colonPos < lineStop) {
                if (RegionIsCi(this.rawHeaders, pos, colonPos, name)) {
                    int vStart = HttpRequest.TrimOwsStart(this.rawHeaders,
                        colonPos + 1, lineStop);
                    int vStop = HttpRequest.TrimOwsStop(this.rawHeaders,
                        vStart, lineStop);
                    return this.rawHeaders.Substring(vStart, vStop - vStart);
                }
            }
            pos = lineEnd + 1;
        }
        return "";
    }

    // 零分配视图辅助：直接返回路径的 StringView 视图。
    public StringView PathView() {
        if (this.raw == null || this.pathLength <= 0) {
            if (this.path != null && this.path.Length > 0) {
                return this.path.AsView();
            }
            return StringView.Empty();
        }
        return this.raw.AsView(this.pathOffset, this.pathLength);
    }

    // 零分配视图辅助：直接返回 HTTP 方法的 StringView 视图。
    public StringView MethodView() {
        return StringView.FromString(this.method);
    }

    // 零分配视图辅助：直接返回查询字符串的 StringView 视图。
    public StringView QueryView() {
        if (this.raw == null || this.queryLength <= 0) {
            if (this.queryString != null && this.queryString.Length > 0) {
                return this.queryString.AsView();
            }
            return StringView.Empty();
        }
        return this.raw.AsView(this.queryOffset, this.queryLength);
    }

    // 按名称获取某个头部值的 16 字节只读切片视图（StringView，完全零堆内存分配）。
    public StringView GetHeaderView(string name) {
        if (HttpRequest.NameIs(name, "authorization")) {
            return StringView.FromString(this.authorization);
        }
        if (HttpRequest.NameIs(name, "cookie")) {
            return StringView.FromString(this.cookie);
        }
        if (HttpRequest.NameIs(name, "user-agent")) {
            return StringView.FromString(this.userAgent);
        }
        if (this.rawHeaders == null || this.rawHeaders.Length == 0) {
            return StringView.Empty();
        }
        int pos = 0;
        int len = this.rawHeaders.Length;
        while (pos < len) {
            int lineEnd = pos;
            while (lineEnd < len && (this.rawHeaders[lineEnd] & 255) != 10) {
                lineEnd = lineEnd + 1;
            }
            int lineStop = lineEnd;
            if (lineStop > pos && (this.rawHeaders[lineStop - 1] & 255) == 13) { lineStop = lineStop - 1; }
            int colonPos = pos;
            while (colonPos < lineStop && (this.rawHeaders[colonPos] & 255) != 58) {
                colonPos = colonPos + 1;
            }
            if (colonPos < lineStop) {
                if (RegionIsCi(this.rawHeaders, pos, colonPos, name)) {
                    int vStart = HttpRequest.TrimOwsStart(this.rawHeaders, colonPos + 1, lineStop);
                    int vStop = HttpRequest.TrimOwsStop(this.rawHeaders, vStart, lineStop);
                    if (vStart >= vStop) { return StringView.Empty(); }
                    return new StringView((nint)this.rawHeaders + (nint)vStart, vStop - vStart);
                }
            }
            pos = lineEnd + 1;
        }
        return StringView.Empty();
    }

    // 按名称获取某个头部值的只读切片视图（零堆内存分配）。
    // 若未找到，返回长度为 0 的空 ReadOnlySpan<char>。
    public ReadOnlySpan<char> GetHeaderSpan(string name) {
        if (HttpRequest.NameIs(name, "authorization")) {
            return this.authorization.AsSpan();
        }
        if (HttpRequest.NameIs(name, "cookie")) {
            return this.cookie.AsSpan();
        }
        if (HttpRequest.NameIs(name, "user-agent")) {
            return this.userAgent.AsSpan();
        }
        if (this.rawHeaders == null || this.rawHeaders.Length == 0) {
            return "".AsSpan();
        }
        int pos = 0;
        int len = this.rawHeaders.Length;
        while (pos < len) {
            int lineEnd = pos;
            while (lineEnd < len && (this.rawHeaders[lineEnd] & 255) != 10) {
                lineEnd = lineEnd + 1;
            }
            int lineStop = lineEnd;
            if (lineStop > pos && (this.rawHeaders[lineStop - 1] & 255) == 13) { lineStop = lineStop - 1; }
            int colonPos = pos;
            while (colonPos < lineStop && (this.rawHeaders[colonPos] & 255) != 58) {
                colonPos = colonPos + 1;
            }
            if (colonPos < lineStop) {
                if (RegionIsCi(this.rawHeaders, pos, colonPos, name)) {
                    int vStart = HttpRequest.TrimOwsStart(this.rawHeaders,
                        colonPos + 1, lineStop);
                    int vStop = HttpRequest.TrimOwsStop(this.rawHeaders,
                        vStart, lineStop);
                    if (vStop > vStart) {
                        return this.rawHeaders.AsSpan().Slice(vStart, vStop - vStart);
                    }
                    return "".AsSpan();
                }
            }
            pos = lineEnd + 1;
        }
        return "".AsSpan();
    }

    // 判定是否存在指定名称的请求头（零堆内存分配）。
    public bool HasHeader(string name) {
        return this.GetHeaderSpan(name).Length > 0;
    }

    // 零分配判定指定头部的值是否与 target 完全匹配（大小写敏感）。
    public bool HeaderSpanEquals(string name, string target) {
        ReadOnlySpan<char> span = this.GetHeaderSpan(name);
        if (span.Length != target.Length) { return false; }
        for (int i = 0; i < span.Length; i = i + 1) {
            if (span[i] != target[i]) { return false; }
        }
        return true;
    }

    // 零分配判定指定头部的值是否以 prefix 开头。
    public bool HeaderSpanStartsWith(string name, string prefix) {
        ReadOnlySpan<char> span = this.GetHeaderSpan(name);
        if (span.Length < prefix.Length) { return false; }
        for (int i = 0; i < prefix.Length; i = i + 1) {
            if (span[i] != prefix[i]) { return false; }
        }
        return true;
    }

    // 比对 raw[pos..stop) 与 str 是否逐字节完全匹配（零分配）。
    private static bool RegionExact(string raw, int pos, int stop, string str) {
        if (stop - pos != str.Length) { return false; }
        for (int i = 0; pos + i < stop; i = i + 1) {
            if ((raw[pos + i] & 255) != (str[i] & 255)) { return false; }
        }
        return true;
    }

    // 按名称获取查询参数值（值已 url 解码，与
    // <see cref="GetFormField"/> 一致）。采用零分配切片匹配，未命中项不产生任何堆分配。
    public string GetQueryParam(string name) {
        if (this.queryString.Length == 0 || name.Length == 0) { return ""; }
        int pos = 0;
        int len = this.queryString.Length;
        string qs = this.queryString;
        while (pos < len) {
            int eqPos = pos;
            while (eqPos < len) {
                int c = qs[eqPos] & 255;
                if (c == 61 || c == 38) { break; }  // '=' or '&'
                eqPos = eqPos + 1;
            }
            bool match = HttpRequest.RegionExact(qs, pos, eqPos, name);
            if (eqPos < len && (qs[eqPos] & 255) == 61) {
                int valEnd = eqPos + 1;
                while (valEnd < len && (qs[valEnd] & 255) != 38) {  // '&'
                    valEnd = valEnd + 1;
                }
                if (match) {
                    return Encoding.UrlDecode(qs.Substring(eqPos + 1, valEnd - eqPos - 1));
                }
                pos = valEnd + 1;
            } else {
                if (match) {
                    return "";
                }
                pos = eqPos + 1;
            }
        }
        return "";
    }

    // 从 application/x-www-form-urlencoded 正文中读取字段，
    // 对值做 url 解码。相当于 GetQueryParam 的 POST 正文版；
    // 采用零拷贝切片匹配，字段不存在时返回 ""，且不分配任何字符串。
    public string GetFormField(string name) {
        string b = this.body;
        int pos = 0;
        int len = b.Length;
        if (len == 0 || name.Length == 0) { return ""; }
        while (pos < len) {
            int amp = pos;
            while (amp < len && (b[amp] & 255) != 38) { amp = amp + 1; }
            int eq = pos;
            while (eq < amp && (b[eq] & 255) != 61) { eq = eq + 1; }
            if (eq < amp) {
                if (HttpRequest.RegionExact(b, pos, eq, name)) {
                    return Encoding.UrlDecode(b.Substring(eq + 1, amp - eq - 1));
                }
            } else {
                if (HttpRequest.RegionExact(b, pos, amp, name)) {
                    return "";
                }
            }
            pos = amp + 1;
        }
        return "";
    }

    // 构建用于发送的 HTTP 请求字符串。
    public static string Build(string method, string path, string host, string body) {
        StringBuilder sb = new StringBuilder();
        sb.Append(method);
        sb.Append(" ");
        sb.Append(path);
        sb.Append(" HTTP/1.1\r\n");
        sb.Append("Host: ");
        sb.Append(host);
        sb.Append("\r\n");
        if (body.Length > 0) {
            sb.Append("Content-Length: ");
            sb.Append(body.Length);
            sb.Append("\r\n");
            sb.Append("Content-Type: application/x-www-form-urlencoded\r\n");
        }
        sb.Append("Connection: keep-alive\r\n");
        sb.Append("\r\n");
        if (body.Length > 0) {
            sb.Append(body);
        }
        return sb.ToString();
    }

    // 构建 GET 请求。
    public static string BuildGet(string path, string host) {
        return Build("GET", path, host, "");
    }

    // 构建 POST 请求。
    public static string BuildPost(string path, string host, string body) {
        return Build("POST", path, host, body);
    }

    // 获取请求的 User-Agent 标头值。
    public string UserAgent() {
        return this.userAgent;
    }

    // 一次性解析所有查询参数为键值对字典（零多余反序列化）。
    public Dict<string, string> GetQueryParams() {
        Dict<string, string> map = new Dict<string, string>();
        if (this.queryString.Length == 0) { return map; }
        int pos = 0;
        int len = this.queryString.Length;
        string qs = this.queryString;
        while (pos < len) {
            int eqPos = pos;
            while (eqPos < len) {
                int c = qs[eqPos] & 255;
                if (c == 61 || c == 38) { break; }
                eqPos = eqPos + 1;
            }
            string key = Encoding.UrlDecode(qs.Substring(pos, eqPos - pos));
            if (eqPos < len && (qs[eqPos] & 255) == 61) {
                int valEnd = eqPos + 1;
                while (valEnd < len && (qs[valEnd] & 255) != 38) { valEnd = valEnd + 1; }
                string val = Encoding.UrlDecode(qs.Substring(eqPos + 1, valEnd - eqPos - 1));
                map[key] = val;
                pos = valEnd + 1;
            } else {
                map[key] = "";
                pos = eqPos + 1;
            }
        }
        return map;
    }

    // 一次性解析所有 application/x-www-form-urlencoded 正文字段为键值对字典。
    public Dict<string, string> GetFormFields() {
        Dict<string, string> map = new Dict<string, string>();
        string b = this.body;
        int len = b.Length;
        if (len == 0) { return map; }
        int pos = 0;
        while (pos < len) {
            int amp = pos;
            while (amp < len && (b[amp] & 255) != 38) { amp = amp + 1; }
            int eq = pos;
            while (eq < amp && (b[eq] & 255) != 61) { eq = eq + 1; }
            if (eq < amp) {
                string key = Encoding.UrlDecode(b.Substring(pos, eq - pos));
                string val = Encoding.UrlDecode(b.Substring(eq + 1, amp - eq - 1));
                map[key] = val;
            } else {
                string key = Encoding.UrlDecode(b.Substring(pos, amp - pos));
                map[key] = "";
            }
            pos = amp + 1;
        }
        return map;
    }

    // HTTP 请求方法断言辅助
    public bool IsGet() { return this.method == "GET"; }
    public bool IsPost() { return this.method == "POST"; }
    public bool IsPut() { return this.method == "PUT"; }
    public bool IsDelete() { return this.method == "DELETE"; }
    public bool IsPatch() { return this.method == "PATCH"; }
    public bool IsHead() { return this.method == "HEAD"; }
    public bool IsOptions() { return this.method == "OPTIONS"; }

    // 从 Cookie 请求头中读取单个 cookie 值；不存在返回 ""。
    public string GetCookie(string name) {
        if (name == null || name.Length == 0) { return ""; }
        string cookieHdr = this.GetHeader("Cookie");
        if (cookieHdr.Length == 0) { return ""; }
        int len = cookieHdr.Length;
        int pos = 0;
        while (pos < len) {
            while (pos < len && ((cookieHdr[pos] & 255) == 32 || (cookieHdr[pos] & 255) == 59)) {
                pos = pos + 1;
            }
            int eq = pos;
            while (eq < len && (cookieHdr[eq] & 255) != 61 && (cookieHdr[eq] & 255) != 59) {
                eq = eq + 1;
            }
            if (eq < len && (cookieHdr[eq] & 255) == 61) {
                int semi = eq + 1;
                while (semi < len && (cookieHdr[semi] & 255) != 59) {
                    semi = semi + 1;
                }
                string key = cookieHdr.Substring(pos, eq - pos).Trim();
                if (key == name) {
                    return cookieHdr.Substring(eq + 1, semi - eq - 1).Trim();
                }
                pos = semi + 1;
            } else {
                pos = eq + 1;
            }
        }
        return "";
    }

    // 一次性解析所有 Cookie 为键值对字典。
    public Dict<string, string> GetCookies() {
        Dict<string, string> map = new Dict<string, string>();
        string cookieHdr = this.GetHeader("Cookie");
        if (cookieHdr.Length == 0) { return map; }
        int len = cookieHdr.Length;
        int pos = 0;
        while (pos < len) {
            while (pos < len && ((cookieHdr[pos] & 255) == 32 || (cookieHdr[pos] & 255) == 59)) {
                pos = pos + 1;
            }
            int eq = pos;
            while (eq < len && (cookieHdr[eq] & 255) != 61 && (cookieHdr[eq] & 255) != 59) {
                eq = eq + 1;
            }
            if (eq < len && (cookieHdr[eq] & 255) == 61) {
                int semi = eq + 1;
                while (semi < len && (cookieHdr[semi] & 255) != 59) {
                    semi = semi + 1;
                }
                string key = cookieHdr.Substring(pos, eq - pos).Trim();
                string val = cookieHdr.Substring(eq + 1, semi - eq - 1).Trim();
                if (key.Length > 0) {
                    map[key] = val;
                }
                pos = semi + 1;
            } else {
                pos = eq + 1;
            }
        }
        return map;
    }

    // 从 Authorization 请求头中解析 Bearer 令牌 (RFC 6750 §2.1)。若非 Bearer 认证则返回 ""。
    public string GetBearerToken() {
        string auth = this.authorization;
        if (auth == null || auth.Length <= 7) { return ""; }
        if (auth.StartsWith("Bearer ") || auth.StartsWith("bearer ")) {
            return auth.Substring(7).Trim();
        }
        return "";
    }

    // 从 Authorization 请求头中解析 HTTP Basic 认证凭据 (RFC 7617)。成功返回 true 并输出用户名与密码。
    public bool TryGetBasicAuth(out string username, out string password) {
        username = "";
        password = "";
        string auth = this.authorization;
        if (auth == null || auth.Length <= 6) { return false; }
        if (!auth.StartsWith("Basic ") && !auth.StartsWith("basic ")) {
            return false;
        }
        string b64 = auth.Substring(6).Trim();
        if (b64.Length == 0) { return false; }
        try {
            byte[] bytes = Convert.FromBase64String(b64);
            if (bytes == null || bytes.Length == 0) { return false; }
            string decoded = bytes.ToStr(0, bytes.Length);
            int colon = decoded.IndexOf(":");
            if (colon < 0) {
                username = decoded;
                password = "";
                return true;
            }
            username = decoded.Substring(0, colon);
            password = decoded.Substring(colon + 1);
            return true;
        } catch (Exception ex) {
            return false;
        }
    }
}
