using System;
using System.Collections.Generic;

namespace System.Net.Http;

class HttpRoute {
    string method;
    string path;
    string response;

    // 私有构造：由 HttpRouter 的注册方法创建。
    HttpRoute(string method, string path, string response) {
        this.method = method;
        this.path = path;
        this.response = response;
    }
}

// 简单的 HTTP 路由器，用于将路径映射到处理器。
