using System;
using System.Collections.Generic;

namespace System.Net.Http;

public class HttpDeadlineSlot {
    public nint sock;
    public long deadline;
    public int generation;
    public bool active;
    public bool fired;
    public long totalDeadline;

    // 新槽位：generation 从 1 起，槽位复用时递增。
    public HttpDeadlineSlot(nint sock, long deadline) {
        this.sock = sock;
        this.deadline = deadline;
        this.generation = 1;
        this.active = true;
        this.fired = false;
        this.totalDeadline = 0;
    }
}
