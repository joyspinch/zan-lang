using System;
using System.Collections.Generic;

namespace System.Net.Http;

public class HttpDeadlineToken {
    public int slot;
    public int generation;
    public bool disarmed;

    // token 记录槽位下标与创建时的 generation，
    // 用于槽位复用后旧 token 不再误操作新连接。
    public HttpDeadlineToken(int slot, int generation) {
        this.slot = slot;
        this.generation = generation;
        this.disarmed = false;
    }

    // 传输异常可能在到达显式清理点之前就把请求展开掉；此时槽位保持武装，
    // 由 HttpDeadline.Sweep 扫描器到期挂断兜底（generation 保证旧 token
    // 不误伤复用后的新连接）。正常路径仍然显式 Disarm，Disarm 幂等，
    // 两条路径都安全。
}

// 槽位表中的一条：连接套接字、阶段/总截止时间与 generation。
