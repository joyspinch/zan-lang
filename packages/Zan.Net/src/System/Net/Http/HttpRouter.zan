using System;
using System.Collections.Generic;
using System.Text;

namespace System.Net.Http;

public class HttpRouter {
    List<HttpRoute> routes;

    // 创建空路由表。
    public HttpRouter() {
        this.routes = new List<HttpRoute>();
    }

    // 注册一条 GET 路由。
    public HttpRouter Get(string path, string responseBody) {
        this.routes.Add(new HttpRoute("GET", path, responseBody));
        return this;
    }

    // 注册一条 POST 路由。
    public HttpRouter Post(string path, string responseBody) {
        this.routes.Add(new HttpRoute("POST", path, responseBody));
        return this;
    }

    // 注册一条 PUT 路由。
    public HttpRouter Put(string path, string responseBody) {
        this.routes.Add(new HttpRoute("PUT", path, responseBody));
        return this;
    }

    // 注册一条 DELETE 路由。
    public HttpRouter Delete(string path, string responseBody) {
        this.routes.Add(new HttpRoute("DELETE", path, responseBody));
        return this;
    }

    // 注册一条 PATCH 路由 (RFC 5789)。
    public HttpRouter Patch(string path, string responseBody) {
        this.routes.Add(new HttpRoute("PATCH", path, responseBody));
        return this;
    }

    // 注册一条 HEAD 路由 (RFC 7231 §4.3.2)。
    public HttpRouter Head(string path, string responseBody) {
        this.routes.Add(new HttpRoute("HEAD", path, responseBody));
        return this;
    }

    // 注册一条 OPTIONS 路由 (RFC 7231 §4.3.7)。
    public HttpRouter Options(string path, string responseBody) {
        this.routes.Add(new HttpRoute("OPTIONS", path, responseBody));
        return this;
    }

    // 注册适用于任意方法的路由。
    public HttpRouter Route(string method, string path, string responseBody) {
        this.routes.Add(new HttpRoute(method, path, responseBody));
        return this;
    }

    // 将请求匹配到已注册的路由。
    // 若路径完全匹配但请求方法不被允许，返回 405 Method Not Allowed 并携带 Allow 头部 (RFC 7231 §6.5.5)。
    // 若路径未匹配，返回 404 Not Found。
    public HttpResponse Match(HttpRequest request) {
        StringView pv = request.PathView();
        bool pathMatched = false;
        StringBuilder allowSb = new StringBuilder();
        foreach (HttpRoute r in this.routes) {
            if (pv.Equals(r.path)) {
                pathMatched = true;
                if (r.method == request.method || r.method == "*") {
                    return HttpResponse.Ok(r.response);
                }
                if (r.method != "*") {
                    string m = r.method;
                    string currentAllow = allowSb.ToString();
                    if (currentAllow.IndexOf(m) < 0) {
                        if (allowSb.Length > 0) {
                            allowSb.Append(", ");
                        }
                        allowSb.Append(m);
                    }
                }
            }
        }
        if (pathMatched) {
            return HttpResponse.MethodNotAllowed(allowSb.ToString());
        }
        return HttpResponse.NotFound();
    }
}
