using System;
using System.Net.Http;

namespace System.Net.Http.Client;

public partial class HttpClient {
    private async HttpResponse RequestPooledAsync(string method, string path, string body) {
        HttpConnectionPool requestPool = this.pool;
        bool retryStale = method == "GET" || method == "HEAD";
        while (true) {
            PooledHttpConnection channel = null;
            try {
                channel = await requestPool.RentOrPermitAsync(this.ConnectBudget());
            } catch (HttpRequestException e) {
                // A pool wait timeout may fall back to a one-shot request.
                if (requestPool.AllowsOverflow()) {
                    return await this.RequestUnpooledAsync(method, path, body);
                }
                throw e;
            }
            bool reused = channel != null;
            if (!reused) {
                try {
                    channel = await this.OpenChannel(true);
                } finally {
                    if (channel == null) { requestPool.ReleasePermit(); }
                }
                if (channel == null) { this.FailConnect(); }
            }

            HttpDeadlineToken watch = null;
            bool keep = false;
            try {
                string req = this.BuildRequest(method, path, body, false);
                watch = HttpDeadline.Arm(channel.conn.Sock(), this.WriteBudget(), this.TotalBudget());
                int sent = await this.WriteTextRequest(channel, req);
                if (sent != req.Length) {
                    if (HttpDeadline.Expired(watch)) { this.FailTimeout(); }
                    throw new HttpRequestException("request write failed");
                }
                HttpResponse resp = await this.ReadFramedResponse(channel.framer, path,
                    method, watch, false);
                if (resp == null) {
                    // Preserve the single stale-idle replay for GET/HEAD only.
                    if (!reused || !retryStale) { this.FailMissingResponse(watch); }
                } else {
                    keep = HttpClient.CanReuseResponse(resp, method)
                        && channel.framer.Pending() == 0;
                    return resp;
                }
            } finally {
                HttpDeadline.Disarm(watch);
                requestPool.Return(channel, keep);
            }
            retryStale = false;
        }
    }

    private static bool CanReuseResponse(HttpResponse resp, string method) {
        if (resp.statusCode == 101) { return false; }
        if (!HttpClient.ResponseHasNoBody(resp, method)
            && !resp.framingChunked && !resp.framingHasLength) { return false; }
        // Check every Connection field; any close token ends persistence.
        for (int i = 0; i < resp.headers.Count; i = i + 1) {
            string field = resp.headers[i];
            int colon = field.IndexOf(":");
            if (colon <= 0 || field.Substring(0, colon).ToLower() != "connection") { continue; }
            string value = field.Substring(colon + 1);
            int from = 0;
            while (from < value.Length) {
                int comma = value.IndexOf(",", from);
                int stop = comma < 0 ? value.Length : comma;
                if (value.Substring(from, stop - from).Trim().ToLower() == "close") { return false; }
                if (comma < 0) { break; }
                from = comma + 1;
            }
        }
        return true;
    }
}
