using System;
using System.IO;
using System.Net.Http;

namespace System.Net.Http.Client;

// HttpClient.Bytes.zan - 二进制安全请求传输 (SendBytesAsync) 与流式文件上传 (UploadFileRawAsync / SendBytesBodyAsync)
public partial class HttpClient {
    // 二进制安全的一次性请求。通道与 <see cref="SendAsync"/>
    // 相同（Connection: close，读至对端关闭或定界完成），但请求正文
    // 按显式字节长度发送（strlen 定长的发送会在内嵌 NUL 处截断，
    // TLS 变体本就按 req.Length 发送，这里对齐），响应全程按
    // 显式字节数组装（<see cref="HttpFramer"/> + ByteBuffer）：
    // 正文里的 NUL 不会把响应截断，结果的 bodyBytes/bodyBytesLen
    // 有效，<see cref="HttpResponse.IsBinary"/> 与
    // <see cref="HttpResponse.BodyLength"/> 据此工作。适合图片、
    // 字体等二进制资源的下载与上传；文本响应照常可用 body 读取。
    // 绑定 policy 时按同一规则跟随重定向（3xx 原样返回仍是默认）。
    public async HttpResponse SendBytesAsync(string method, string path, string body) {
        int bodyLen = body != null ? body.Length : 0;
        return await this.SendBytesAsync(method, path, body, bodyLen);
    }

    // 发送原始字节正文（带显式字节长度，二进制安全，可含 NUL 字节）。
    public async HttpResponse SendBytesAsync(string method, string path, string body, int bodyLen) {
        this.ResetTotalBudget();
        this.CheckRequestLimit(bodyLen);
        this.CheckTargetPolicy();
        HttpResponse resp = await this.SendBytesOnce(method, path, body, null, bodyLen);
        if (this.callPolicy != null && this.callPolicy.MaxRedirects() > 0) {
            resp = await this.FollowBytesFromResponse(method, path, body,
                HttpClient.SendBytesOnceAsync, resp);
        }
        return this.ApplyContentEncoding(resp);
    }

    // 发送原始字节数组（带显式字节长度，二进制安全，零中转字符串拷贝）。
    public async HttpResponse SendBytesAsync(string method, string path, byte[] body, int bodyLen) {
        this.ResetTotalBudget();
        this.CheckRequestLimit((long)bodyLen);
        this.CheckTargetPolicy();
        HttpResponse direct = await this.SendBytesOnce(method, path, null, body, bodyLen);
        return this.ApplyContentEncoding(direct);
    }

    // 流式上传本地文件作为请求正文（适用于 PUT / POST 原始文件上传，如 WebDAV、对象存储等），
    // 单句柄 64KB 流式直发，零中转整文件内存分配，支持超 2GB 大文件。
    public async HttpResponse UploadFileRawAsync(string method, string path, string localPath, string contentType) {
        long fileLen = File.GetSize64(localPath);
        if (fileLen < 0) {
            throw new FileNotFoundException("Could not open file: " + localPath);
        }
        this.ResetTotalBudget();
        this.CheckTargetPolicy();
        this.CheckRequestLimit(fileLen);
        if (contentType != null && contentType.Length > 0 && !this.HasHeaderName("Content-Type")) {
            this.SetHeader("Content-Type", contentType);
        }
        return await this.SendBytesBodyAsync(method, path, "", localPath, fileLen, "", fileLen);
    }

    // 一次真实上线：SendBytesAsync 的无重定向主体，同时作为
    // FollowBytesFromResponse 的驱动回调。method 随驱动签名显式传递：
    // 重定向改写（301/302/303 → GET）后驱动端据此发空 GET。
    private static async HttpResponse SendBytesOnceAsync(HttpClient client,
            string method, string path, string body) {
        int bodyLen = body != null ? body.Length : 0;
        return await client.SendBytesOnce(method, path, body, null, bodyLen);
    }

    private async HttpResponse SendBytesOnce(string method, string path, string body,
            byte[] rawBody, int bodyLen) {
        string req = this.BuildRequestHead(method, path, bodyLen, true);
        PooledHttpConnection channel = await this.OpenChannel(true);
        if (channel == null) { this.FailConnect(); }
        HttpDeadlineToken watch = null;
        try {
            watch = HttpDeadline.Arm(channel.conn.Sock(), this.WriteBudget(), this.TotalBudget());
            int sent = await this.WriteStringBytes(channel, req, req.Length);
            if (sent != req.Length) { throw new HttpRequestException("request write failed"); }
            if (bodyLen > 0 && (rawBody != null || body != null)) {
                int written = 0;
                if (rawBody != null) { written = await this.WriteRawBytes(channel, rawBody, bodyLen); }
                else { written = await this.WriteStringBytes(channel, body, bodyLen); }
                if (written != bodyLen) {
                    throw new HttpRequestException("request body write failed");
                }
            }
            HttpResponse resp = await this.ReadFramedResponse(channel.framer, path, method, watch, true);
            if (resp == null) { this.FailMissingResponse(watch); }
            return resp;
        } finally {
            HttpDeadline.Disarm(watch);
            channel.Dispose();
        }
    }

    // Upload in three parts over the same one-shot channel: multipart prefix,
    // file chunks, and multipart suffix. Raw uploads use empty prefix/suffix.
    private async HttpResponse SendBytesBodyAsync(string method, string path,
            string head, string localPath, long fileLen, string tail, long total) {
        this.CheckRequestLimit(total);
        this.CheckTargetPolicy();
        string req = this.BuildRequestHead(method, path, total, true);
        PooledHttpConnection channel = await this.OpenChannel(true);
        if (channel == null) { this.FailConnect(); }
        HttpDeadlineToken watch = null;
        try {
            watch = HttpDeadline.Arm(channel.conn.Sock(), this.WriteBudget(), this.TotalBudget());
            int sent = await this.WriteStringBytes(channel, req, req.Length);
            if (sent != req.Length) { throw new HttpRequestException("upload write failed"); }
            int prefix = await this.WriteStringBytes(channel, head, head.Length);
            if (prefix != head.Length) { throw new HttpRequestException("upload write failed"); }
            this.UploadTick((long)(req.Length + head.Length), total);
            nint fp = fopen(localPath, "rb");
            if (fp == 0) { throw new FileNotFoundException("Could not open file: " + localPath); }
            try {
                long offset = 0;
                byte[] chunk = new byte[65536];
                while (offset < fileLen) {
                    long want = fileLen - offset;
                    if (want > 65536) { want = 65536; }
                    int got = (int)fread(chunk, 1, want, fp);
                    if (got < (int)want) {
                        throw new HttpRequestException("file shrank while being uploaded: " + localPath);
                    }
                    int written = await this.WriteRawBytes(channel, chunk, got);
                    if (written != got) { throw new HttpRequestException("upload write failed"); }
                    HttpDeadline.Touch(watch, this.WriteBudget());
                    offset = offset + (long)got;
                    this.UploadTick((long)(req.Length + head.Length) + offset, total);
                }
            } finally {
                fclose(fp);
            }
            int suffix = await this.WriteStringBytes(channel, tail, tail.Length);
            if (suffix != tail.Length) { throw new HttpRequestException("upload write failed"); }
            this.UploadTick(total, total);
            HttpResponse resp = await this.ReadFramedResponse(channel.framer, path, method, watch, true);
            if (resp == null) { this.FailMissingResponse(watch); }
            return resp;
        } finally {
            HttpDeadline.Disarm(watch);
            channel.Dispose();
        }
    }
}
