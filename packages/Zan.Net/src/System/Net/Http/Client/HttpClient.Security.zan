using System;
using System.Collections.Generic;
using System.Net.Sockets;
using System.Net.Http;
using System.Net.External;

namespace System.Net.Http.Client;

// HttpClient.Security.zan - 传输安全(SPKI公钥固定/双向证书认证)、响应内容解码(Content-Encoding)与探针治理
public partial class HttpClient {
    // First use and setters share a mutex: pooled connections always retain the
    // security configuration with which they were opened. Close never unfreezes.
    private void RequireMutableSecurity() {
        if (this.securityFrozen) {
            throw new InvalidOperationException("HTTP security configuration is frozen after first use");
        }
    }

    private void FreezeSecurity() {
        this.securityGate.WaitOne();
        try { this.securityFrozen = true; }
        finally { this.securityGate.ReleaseMutex(); }
    }

    // Copy both on input and output; external mutation cannot alter idle-pool policy.
    private static ExternalCallPolicy CopyCallPolicy(ExternalCallPolicy source) {
        if (source == null) { return null; }
        ExternalCallPolicy copy = ExternalCallPolicy.Default()
            .ConnectTimeout(source.ConnectTimeoutMs()).WriteTimeout(source.WriteTimeoutMs())
            .ReadTimeout(source.ReadTimeoutMs()).IdleTimeout(source.IdleTimeoutMs())
            .RequestLimit(source.MaxRequestBytes()).ResponseLimit(source.MaxResponseBytes())
            .ErrorLimit(source.MaxErrorBytes()).StreamLimit(source.MaxStreamBytes())
            .Redirects(source.MaxRedirects()).RetryAttempts(source.RetryAttempts())
            .RetryBackoff(source.RetryBackoffMs())
            .RetryNetwork(source.CanRetry("GET", false, 0));
        if (source.TotalTimeoutMs() > 0) { copy.TotalTimeout(source.TotalTimeoutMs()); }
        else { copy.NoTotalTimeout(); }
        if (source.LocalHttpOnly()) { copy.AllowLocalHttp(); }
        else if (source.AllowsLoopback()) { copy.AllowLoopback(); }
        if (source.AllowsPrivate()) { copy.AllowPrivate(); }
        if (source.IsIdempotent()) { copy.Idempotent(source.IdempotencyKey()); }
        return copy;
    }

    // Must enforce maxDecodedBytes DURING decoding, before excess allocation or
    // output. Return null/throw on exhaustion. Every encoding layer gets a budget.
    public HttpClient SetBoundedContentDecoder(HttpBoundedContentDecoder fn) {
        this.boundedContentDecoder = fn;
        return this;
    }

    public static void SetDefaultBoundedContentDecoder(HttpBoundedContentDecoder fn) {
        HttpClient.defaultBoundedContentDecoder = fn;
    }

    // 拆分 Content-Encoding 的取值：可能是逗号分隔的多段
    // （"gzip, br"——按发送顺序逐层编码）。空段丢掉。
    private static List<string> SplitCodings(string header) {
        List<string> out2 = new List<string>();
        if (header == null) { return out2; }
        int pos = 0;
        int len = header.Length;
        while (pos <= len) {
            int comma = header.IndexOf(",", pos);
            int stop = comma < 0 ? len : comma;
            string one = header.Substring(pos, stop - pos).Trim().ToLower();
            if (one.Length > 0) { out2.Add(one); }
            if (comma < 0) { break; }
            pos = comma + 1;
        }
        return out2;
    }

    // 按 Content-Encoding 解码响应正文。没有编码、或响应本来就没有
    // 正文（1xx/204/304）时原样返回。
    //
    // 编码是**按发送顺序逐层套上去**的，解码要反过来：先解最后一层。
    // 解码器没装 → 报错并说清缺什么；解码失败（返回 null）→ 报错。
    // 两种情况都不把压缩字节当正文交出去。
    private HttpResponse ApplyContentEncoding(HttpResponse resp) {
        if (resp == null) { return resp; }
        int status = resp.statusCode;
        if (status >= 100 && status < 200) { return resp; }
        if (status == 204 || status == 304) { return resp; }
        string header = resp.GetHeader("Content-Encoding");
        List<string> codings = HttpClient.SplitCodings(header);
        if (codings.Count == 0) { return resp; }
        bool identityOnly = true;
        for (int i = 0; i < codings.Count; i = i + 1) {
            if (codings[i] != "identity") { identityOnly = false; }
        }
        if (identityOnly) { return resp; }
        // 没有正文就没有可解码的东西（HEAD 响应、空正文 200 都属这类）。
        // 此时不报错——一个"空的 gzip 正文"和"根本没发正文"在线路上
        // 分不开，硬解只会得到一个假失败。
        if (resp.body == null || resp.body.Length == 0) { return resp; }
        HttpBoundedContentDecoder decoder = this.boundedContentDecoder;
        if (decoder == null) {
            decoder = HttpClient.defaultBoundedContentDecoder;
        }
        if (decoder == null) {
            throw new HttpRequestException("response is " + header
                + "-encoded but no content decoder with a decode budget is configured");
        }
        bool wasBinary = resp.IsBinary();
        int encodedLength = wasBinary ? resp.bodyBytesLen : resp.body.Length;
        int limit = this.ResponseLimit();
        if (encodedLength < 0 || encodedLength > limit
            || (wasBinary && (resp.bodyBytes == null || encodedLength > resp.bodyBytes.Length))) {
            throw new HttpRequestException("encoded response body exceeds budget or has invalid length");
        }
        // ToBytes uses strlen: copy the tracked count, preserving embedded NUL.
        byte[] cur = new byte[encodedLength];
        for (int j = 0; j < encodedLength; j = j + 1) {
            cur[j] = wasBinary ? resp.bodyBytes[j] : (byte)resp.body[j];
        }
        for (int i = codings.Count - 1; i >= 0; i = i - 1) {
            string coding = codings[i];
            if (coding == "identity") { continue; }
            byte[] decoded = decoder(coding, cur, limit);
            if (decoded == null || decoded.Length > limit) {
                throw new HttpRequestException("failed to decode or over-budget "
                    + coding + " response decode");
            }
            cur = decoded;
        }
        resp.body = cur.ToStr(0, cur.Length);
        if (wasBinary) {
            resp.bodyBytes = cur;
            resp.bodyBytesLen = cur.Length;
        } else {
            resp.bodyBytes = null;
            resp.bodyBytesLen = 0;
        }
        resp.contentDecoded = true;
        resp.contentEncoding = header.Trim().ToLower();
        return resp;
    }

    // 探针非空时上报一次进度；装探针的调用点在发送循环里，成本只有
    // 一次空判 + 一次委托调用。对 >2GB 上传安全钳制在 32 位上限，防溢出。
    private void UploadTick(long sentBytes, long totalBytes) {
        if (this.uploadProbe != null) {
            int sent = sentBytes > 2147483647 ? 2147483647 : (int)sentBytes;
            int total = totalBytes > 2147483647 ? 2147483647 : (int)totalBytes;
            this.uploadProbe(sent, total);
        }
    }

    // 最近一次二进制下载失败的阶段诊断；成功或尚未下载时为空。
    public string LastDownloadError() {
        return this.lastDownloadError;
    }

    // 更新 LastDownloadError 报告的阶段诊断。
    private void SetDownloadError(string error) {
        this.lastDownloadError = error;
    }

    // 探针是否要求收工（没装探针时恒为 false）。
    private bool CancelRequested() {
        if (this.cancelProbe == null) { return false; }
        return this.cancelProbe();
    }

    // 固定一个受信任的服务器公钥：其 DER SubjectPublicKeyInfo 的
    // base64 SHA-256 值。一旦设置了任意固定值，握手就会拒绝
    // 公钥不匹配任何固定值的服务器，即使其证书
    // 本可被系统信任——从而阻止 MITM 代理。调用两次可为轮换
    // 固定一个备用密钥。
    public HttpClient PinPublicKey(string spkiSha256Base64) {
        this.securityGate.WaitOne();
        try {
            this.RequireMutableSecurity();
            if (spkiSha256Base64 == null || spkiSha256Base64.Length == 0) {
                throw new ArgumentException("TLS public key pin must not be empty");
            }
            if (this.tlsPins == null) { this.tlsPins = new List<string>(); }
            this.tlsPins.Add(spkiSha256Base64);
            this.pinningEnabled = true;
            this.useTls = true;
            return this;
        } finally { this.securityGate.ReleaseMutex(); }
    }

    // 仅开发用的应急通道，放宽固定限制，使本地
    // 代理或自签名开发服务器可用。由 ZAN_DEV 保护，因此发布
    // 构建会将其编译掉并始终强制执行已配置的固定值。
    public HttpClient DisablePinning() {
        this.securityGate.WaitOne();
        try {
            this.RequireMutableSecurity();
            #if ZAN_DEV
            this.pinningEnabled = false;
            #endif
            return this;
        } finally { this.securityGate.ReleaseMutex(); }
    }

    // 将已配置的固定值复制到新建的客户端上下文上并
    // 启用强制。当固定被禁用或未配置时不执行任何操作。
    private void ApplyPinning(TlsContext ctx) {
        if (!this.pinningEnabled || this.tlsPins == null) { return; }
        for (int i = 0; i < this.tlsPins.Count; i = i + 1) {
            ctx.AddPin(this.tlsPins[i]);
        }
        ctx.RequirePinning(true);
    }

    // Reserved compatibility API. Client authentication is not implemented;
    // reject at configuration rather than silently making an anonymous request.
    public HttpClient SetClientCertificate(string certFile, string keyFile) {
        throw new NotSupportedException("TLS client certificate authentication is not implemented");
    }
}
