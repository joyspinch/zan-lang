using System;
using System.IO;
using System.Text;
using System.Diagnostics;
using System.Collections.Generic;
using System.Net.Sockets;
using System.Net.Http;
using System.Net.Tls;
using System.Net.External;
using System.Threading;

namespace System.Net.Http.Client;

// HttpClient.Files.zan - 大文件分块上传、multipart 表单编码与多段断点续传下载
public partial class HttpClient {
    // 当 `s` 末尾字节等于 `suf` 时返回 true（ASCII 大小写不敏感）。
    private static bool EndsWithCi(string s, string suf) {
        int sl = s.Length;
        int fl = suf.Length;
        if (sl < fl) { return false; }
        return HttpClient.AsciiNameEquals(s.Substring(sl - fl, fl), suf, fl);
    }

    // multipart 的 name/filename 原样进入 Content-Disposition 的引号内：
    // 含 CR/LF/NUL/DEL 会注入额外头字段或提前结束头部，含引号会逃出
    // 引号串。非法即抛，与 WebDavClient.ValidateHeader 同一防线。
    public static void ValidateMultipartToken(string what, string value) {
        if (value.Length == 0) {
            throw new ArgumentException("multipart " + what + " is empty");
        }
        for (int i = 0; i < value.Length; i = i + 1) {
            int ch = value[i] & 255;
            if (ch == 0 || ch == 10 || ch == 13 || ch == 127 || ch == 34) {
                throw new ArgumentException("multipart " + what + " is invalid");
            }
        }
    }

    // 将文件后缀映射为 content type，默认 octet-stream。
    private static string GuessMime(string name) {
        if (HttpClient.EndsWithCi(name, ".png")) { return "image/png"; }
        if (HttpClient.EndsWithCi(name, ".jpg")
            || HttpClient.EndsWithCi(name, ".jpeg")) { return "image/jpeg"; }
        if (HttpClient.EndsWithCi(name, ".gif")) { return "image/gif"; }
        if (HttpClient.EndsWithCi(name, ".txt")) { return "text/plain"; }
        if (HttpClient.EndsWithCi(name, ".json")) { return "application/json"; }
        if (HttpClient.EndsWithCi(name, ".pdf")) { return "application/pdf"; }
        return "application/octet-stream";
    }

    // 从响应头文本里取单个字符串头（大小写不敏感，从行首匹配），
    // 例如 HeadHeader(head, "Location")。不存在时返回 ""。下载通道
    // 不走 HttpResponse.Parse（头部与正文共享一次手写读取），重定向
    // 的 Location 就在这里解析。
    private static string HeadHeader(string head, string lowerName) {
        int n = head.Length;
        int nl = lowerName.Length;
        for (int i = 0; i + nl <= n; i = i + 1) {
            if ((i == 0 || (head[i - 1] & 255) == 10)
                && i + nl < n && (head[i + nl] & 255) == 58
                && HttpClient.AsciiNameEquals(head.Substring(i, nl), lowerName, nl)) {
                int j = i + nl;
                while (j < n && ((head[j] & 255) == 32 || (head[j] & 255) == 58)) {
                    j = j + 1;
                }
                int end = i;
                while (end < n && (head[end] & 255) != 10) { end = end + 1; }
                if (end > j && (head[end - 1] & 255) == 13) { end = end - 1; }
                if (end > j) { return head.Substring(j, end - j); }
                return "";
            }
        }
        return "";
    }

    // 读取 64 位整数值的响应头（大小写不敏感，从行首匹配），
    // 例如 HeaderLong(head, "content-length")。不存在时返回 0。
    public static long HeaderLong(string head, string lowerName) {
        int n = head.Length;
        int nl = lowerName.Length;
        for (int i = 0; i + nl <= n; i = i + 1) {
            if ((i == 0 || (head[i - 1] & 255) == 10)
                && i + nl < n && (head[i + nl] & 255) == 58
                && HttpClient.AsciiNameEquals(head.Substring(i, nl), lowerName, nl)) {
                int j = i + nl;
                while (j < n && ((head[j] & 255) == 32 || (head[j] & 255) == 58)) {
                    j = j + 1;
                }
                long v = 0;
                bool any = false;
                while (j < n && (head[j] & 255) >= 48 && (head[j] & 255) <= 57) {
                    v = v * 10 + (long)((head[j] & 255) - 48);
                    j = j + 1;
                    any = true;
                }
                if (any) { return v; }
            }
        }
        return 0;
    }

    // 读取整数值的响应头（大小写不敏感，从行首匹配），
    // 例如 HeaderInt(head, "content-length")。不存在时返回 0。
    private static int HeaderInt(string head, string lowerName) {
        return (int)HttpClient.HeaderLong(head, lowerName);
    }

    // 从 "Content-Range: bytes X-Y/Z" 头取得资源总大小（Z 值），
    // 无该头时返回 0。支持 64 位大文件。
    public static long RangeTotal(string head) {
        int n = head.Length;
        string key = "content-range";
        int kl = key.Length;
        int idx = 0 - 1;
        int i = 0;
        while (i + kl <= n) {
            if ((i == 0 || (head[i - 1] & 255) == 10)
                && HttpClient.AsciiNameEquals(head.Substring(i, kl), key, kl)) {
                idx = i;
                break;
            }
            i = i + 1;
        }
        if (idx < 0) { return 0; }
        int slash = HttpClient.IndexOf(head, "/", idx);
        if (slash < 0) { return 0; }
        long v = 0;
        bool any = false;
        int j = slash + 1;
        while (j < n && (head[j] & 255) >= 48 && (head[j] & 255) <= 57) {
            v = v * 10 + (long)((head[j] & 255) - 48);
            j = j + 1;
            any = true;
        }
        if (any) { return v; }
        return 0;
    }

    private static bool RangeAlreadyComplete(string head, long have) {
        string range = HttpClient.HeadHeader(head, "content-range").Trim();
        if (!range.StartsWith("bytes */")) { return false; }
        string digits = range.Substring(8);
        if (digits.Length == 0) { return false; }
        long total = 0;
        for (int i = 0; i < digits.Length; i = i + 1) {
            int d = digits[i] & 255;
            if (d < 48 || d > 57) { return false; }
            total = total * 10 + (long)(d - 48);
        }
        return have > 0 && total == have;
    }

    // 将本地文件作为 multipart/form-data 的单个字段上传到
    // <paramref name="path"/>（<paramref name="field"/> 是表单名，
    // <paramref name="fileName"/> 是上报给服务器的文件名）。
    // 会将整个文件读入内存，适合中等大小的文件。返回解析后的
    // 响应。注意正文经 ReadAllText 读取，只适合文本文件；
    // 二进制内容（图片、字体等）请用
    public async HttpResponse UploadFileAsync(string path, string field,
            string localPath, string fileName) {
        int fileLen = File.GetSize(localPath);
        if (fileLen < 0) {
            throw new FileNotFoundException("Could not open file: "
                + localPath);
        }
        if (this.callPolicy != null
            && fileLen > this.callPolicy.MaxRequestBytes()) {
            this.CheckRequestLimit(fileLen);
        }
        HttpClient.ValidateMultipartToken("field name", field);
        HttpClient.ValidateMultipartToken("file name", fileName);
        string fileData = File.ReadAllText(localPath);
        string boundary = "----ZanFormBoundary"
            + Convert.ToString(fileData.Length) + "z" + Convert.ToString(field.Length);
        StringBuilder sb = new StringBuilder();
        sb.Append("--");
        sb.Append(boundary);
        sb.Append("\r\n");
        sb.Append("Content-Disposition: form-data; name=\"");
        sb.Append(field);
        sb.Append("\"; filename=\"");
        sb.Append(fileName);
        sb.Append("\"\r\n");
        sb.Append("Content-Type: ");
        sb.Append(HttpClient.GuessMime(fileName));
        sb.Append("\r\n\r\n");
        sb.Append(fileData);
        sb.Append("\r\n--");
        sb.Append(boundary);
        sb.Append("--\r\n");
        string bodyStr = sb.ToString();
        if (!this.HasHeaderName("Content-Type")) {
            this.SetHeader("Content-Type",
                "multipart/form-data; boundary=" + boundary);
        }
        string raw = await this.RequestAsync("POST", path, bodyStr);
        return HttpResponse.Parse(raw);
    }

    // 字节安全的 multipart/form-data 上传：
    // <paramref name="localPath"/> 按原始字节分块读取上线
    // （<see cref="UploadFileAsync"/> 走 ReadAllText，二进制内容会
    // 损坏），ASCII 头尾与文件字节都按显式字节长度发送，
    // Content-Length 与发送长度取自同一处，内嵌 NUL 原样到达。
    // <paramref name="field"/> 是表单名，<paramref name="fileName"/>
    // 是上报给服务器的文件名。传输层失败抛
    // <see cref="HttpRequestException"/>，HTTP 状态由调用方检查；
    // 进度（已上线字节/总字节）经 <see cref="SetUploadProbe"/> 上报。
    public async HttpResponse UploadFileBytesAsync(string path, string field,
            string localPath, string fileName) {
        long fileLen = File.GetSize64(localPath);
        if (fileLen < 0) {
            throw new FileNotFoundException("Could not open file: "
                + localPath);
        }
        this.ResetTotalBudget();
        HttpClient.ValidateMultipartToken("field name", field);
        HttpClient.ValidateMultipartToken("file name", fileName);
        string boundary = "----ZanFormBoundary"
            + Convert.ToString(fileLen) + "z" + Convert.ToString(field.Length);
        string head = "--" + boundary + "\r\n"
            + "Content-Disposition: form-data; name=\"" + field
            + "\"; filename=\"" + fileName + "\"\r\n"
            + "Content-Type: " + HttpClient.GuessMime(fileName) + "\r\n\r\n";
        string tail = "\r\n--" + boundary + "--\r\n";
        long total = (long)head.Length + fileLen + (long)tail.Length;
        this.CheckTargetPolicy();
        this.CheckRequestLimit(total);
        if (!this.HasHeaderName("Content-Type")) {
            this.SetHeader("Content-Type",
                "multipart/form-data; boundary=" + boundary);
        }
        // 先完整发送 multipart 首跳，再仅对安全改写的 GET 跟随重定向。
        HttpResponse resp;
        if (this.useTls) {
            resp = await this.SendBytesBodyTlsAsync("POST", path, head,
                                                    localPath, fileLen,
                                                    tail, total);
        } else {
            resp = await this.SendBytesBodyAsync("POST", path, head,
                                                 localPath, fileLen,
                                                 tail, total);
        }
        if (this.callPolicy != null && this.callPolicy.MaxRedirects() > 0) {
            return await this.FollowBytesFromResponse("POST", path, "",
                HttpClient.UploadBytesOnceAsync, resp);
        }
        return resp;
    }

    // 将 <paramref name="path"/> 下载到
    // <paramref name="localPath"/>，可续传中断的下载。
    // 超时是空闲窗口（每收到一个 chunk 就重新计时），因此
    // 慢速网络上的大文件不会在传输中途被中止。它会发送
    // `Range: bytes=<existing>-`，使支持范围请求（HTTP 206）的服务器
    // 从本地文件已下载到的位置继续，而不是重新开始；
    // 忽略该头的服务器（200）会从头开始，416 表示
    // 文件已完整下载。进度（"<received>/<total>"）会
    // 随字节到达写入 <paramref name="progressFile"/>。绑定了
    // <see cref="ExternalCallPolicy"/> 且 `Redirects(n)>0` 时，
    // 3xx 会按策略逐跳跟随（每跳重审目标、共享同一总预算、防环）；
    // 未启用时 3xx 仍按错误状态拒绝落盘。返回当前磁盘上的字节数，
    // 连接/握手失败时返回 -1。
    public async int DownloadRangeToFileAsync(string path, string localPath,
            string progressFile) {
        this.SetDownloadError("");
        this.ResetTotalBudget();
        List<string> visited = new List<string>();
        string initial = this.CanonicalRequestTarget(path);
        if (initial.Length > 0) { visited.Add(initial); }
        return await this.DownloadRangeOnceAsync(path, localPath,
            progressFile, visited, 0);
    }

    // DownloadRangeToFileAsync 的单次尝试体：3xx 且 policy
    // 显式启用（Redirects>0）且未到跳数上限时，在派生的下一跳
    // 客户端上递归重开整段下载——have 从本地文件重建，Range 行为
    // 逐跳一致。visited/hops 由入口初始化，跨跳共享防循环。
    public async int DownloadRangeOnceAsync(string path, string localPath,
            string progressFile, List<string> visited, int hops) {
        this.SetDownloadError("");
        int bodyLimit = 0;
        if (this.callPolicy != null) { bodyLimit = this.callPolicy.MaxBodyBytes(); }
        if (this.callPolicy != null) {
            bool targetOk = ExternalTargetPolicy.IsClientAllowed(this.host,
                this.port, this.useTls,
                this.callPolicy.AllowsLoopback(),
                this.callPolicy.AllowsHttp(),
                this.callPolicy.LocalHttpOnly());
            if (!targetOk) {
                this.SetDownloadError("external target is not allowed");
                return 0 - 1;
            }
        }
        int have = 0;
        nint probe = fopen(localPath, "rb");
        if (probe != 0) {
            fseek(probe, 0, 2);
            have = ftell(probe);
            fclose(probe);
        }
        if (bodyLimit > 0 && have > bodyLimit) {
            this.SetDownloadError("已有文件超过 " + Convert.ToString(bodyLimit) + " bytes");
            return 0 - 1;
        }

        Socket.Initialize();
        TcpClient conn = await this.ConnectTarget();
        if (conn == null) { return 0 - 1; }
        TlsStream stream = null;
        TlsContext ctx = null;
        if (this.useTls) {
            if (this.clientCertificateFile.Length > 0
                && this.clientPrivateKeyFile.Length > 0) {
                ctx = TlsContext.CreateClientWithCertificate(
                    this.clientCertificateFile, this.clientPrivateKeyFile);
            } else {
                ctx = TlsContext.CreateClient();
            }
            if (ctx == null) {
                string tlsError3 = TlsStream.LastError();
                if (tlsError3 == "") { tlsError3 = "TLS 上下文初始化失败"; }
                this.SetDownloadError(tlsError3);
                conn.Close();
                return 0 - 1;
            }
            if (!this.verifyTls) { ctx.DisableVerify(); }
            this.ApplyPinning(ctx);
            stream = await this.ConnectTls(ctx, conn.Sock());
            if (stream == null) {
                string tlsHandshakeError3 = TlsStream.LastError();
                if (tlsHandshakeError3 == "") {
                    tlsHandshakeError3 = "TLS 握手失败";
                }
                this.SetDownloadError(tlsHandshakeError3);
                conn.Close();
                ctx.Free();
                return 0 - 1;
            }
        }

        HttpDeadlineToken watch = HttpDeadline.Arm(conn.Sock(), this.WriteBudget(), this.TotalBudget());
        string req = this.BuildDownloadRequest(path, (long)have);
        int sent = 0;
        if (this.useTls) { sent = await stream.SendAsync(req, req.Length); }
        else { sent = await conn.SendAsync(req); }
        if (sent != req.Length) {
            this.SetDownloadError("下载请求发送失败");
            HttpDeadline.Disarm(watch);
            if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
            else { conn.Close(); }
            return 0 - 1;
        }
        HttpDeadline.Touch(watch, this.ReadBudget());

        string head = "";
        int hb = 0 - 1;
        while (hb < 0 && head.Length < 262144) {
            string c;
            if (this.useTls) { c = await stream.RecvAsync(65536); }
            else { c = await conn.RecvAsync(65536); }
            if (c.Length == 0) { break; }
            int scanFrom = head.Length - 3;
            if (scanFrom < 0) { scanFrom = 0; }
            head = head + c;
            hb = HttpClient.IndexOf(head, "\r\n\r\n", scanFrom);
            HttpDeadline.Touch(watch, this.IdleBudget());
        }

        if (hb < 0) {
            this.SetDownloadError("响应头不完整");
            HttpDeadline.Disarm(watch);
            if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
            else { conn.Close(); }
            return 0 - 1;
        }

        string headOnly = head.Substring(0, hb);
        int status = HttpClient.HeadStatus(headOnly);
        bool chunked = HttpClient.HeadIsChunked(headOnly);
        string pending = head.Substring(hb + 4, head.Length - hb - 4);
        head = "";

        if (status == 416) {
            bool complete = HttpClient.RangeAlreadyComplete(headOnly, (long)have);
            HttpDeadline.Disarm(watch);
            if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
            else { conn.Close(); }
            if (!complete) {
                this.SetDownloadError("416 Content-Range does not match local file");
                return 0 - 1;
            }
            File.WriteAllText(progressFile,
                Convert.ToString(have) + "/" + Convert.ToString(have));
            return have;
        }

        if (status >= 300 && status < 400) {
            bool wantHop = this.callPolicy != null
                && this.callPolicy.MaxRedirects() > 0
                && hops < this.callPolicy.MaxRedirects()
                && (status == 301 || status == 302 || status == 303
                    || status == 307 || status == 308);
            if (!wantHop) {
                this.SetDownloadError("HTTP 响应状态码 "
                    + Convert.ToString(status));
                HttpDeadline.Disarm(watch);
                if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
                else { conn.Close(); }
                return 0 - 1;
            }
            string location = HttpClient.HeadHeader(head, "Location");
            if (HttpResponse.HasCrlf(location)) {
                this.SetDownloadError("redirect Location header injection rejected");
                HttpDeadline.Disarm(watch);
                if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
                else { conn.Close(); }
                return 0 - 1;
            }
            // 相对引用按当前请求路径解析（下载通道同样是 GET 幂等重放）。
            ExternalTarget target = ExternalTarget.Parse(
                HttpClient.ResolveLocation(path, location, this.useTls,
                    this.host, this.port));
            string canonical = target != null ? target.Canonical() : "";
            if (target == null || canonical.Length == 0
                || visited.Contains(canonical)) {
                this.SetDownloadError("redirect target is invalid or repeated");
                HttpDeadline.Disarm(watch);
                if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
                else { conn.Close(); }
                return 0 - 1;
            }
            visited.Add(canonical);
            // 下载是 GET（幂等），301/302/303/307/308 都原样重放；跨
            // origin 时敏感头（Authorization/Cookie 等）已被
            // RedirectNextClient 过滤。中转客户端是一次性连接。
            bool sameOrigin = this.RedirectHost() == target.Host()
                && this.port == target.Port()
                && this.useTls == target.IsTls();
            HttpDeadline.Disarm(watch);
            if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
            else { conn.Close(); }
            HttpClient next = this.RedirectNextClient(this, target,
                sameOrigin, false);
            return await next.DownloadRangeOnceAsync(
                target.Path() + target.Query(), localPath, progressFile,
                visited, hops + 1);
        }
        if (status < 200 || status >= 300) {
            this.SetDownloadError("HTTP 响应状态码 " + Convert.ToString(status));
            HttpDeadline.Disarm(watch);
            if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
            else { conn.Close(); }
            return 0 - 1;
        }

        bool resume = status == 206;
        int total = (int)HttpClient.RangeTotal(head);
        int written = 0;
        if (resume) {
            written = have;
            if (total <= 0) {
                int cl = HttpClient.HeaderInt(head, "content-length");
                if (cl > 0) { total = have + cl; }
            }
        } else {
            have = 0;
            if (total <= 0) { total = HttpClient.HeaderInt(head, "content-length"); }
        }

        if (bodyLimit > 0 && (written > bodyLimit
                || (total > 0 && total > bodyLimit))) {
            this.SetDownloadError("响应正文超过 " + Convert.ToString(bodyLimit) + " bytes");
            HttpDeadline.Disarm(watch);
            if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
            else { conn.Close(); }
            return 0 - 1;
        }
        string mode = "wb";
        if (resume) { mode = "ab"; }
        nint outfp = fopen(localPath, mode);
        if (outfp == 0) {
            HttpDeadline.Disarm(watch);
            if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
            else { conn.Close(); }
            return 0 - 1;
        }

        bool finished = false;
        while (!finished) {
            if (chunked) {
                bool progressed = true;
                while (progressed) {
                    progressed = false;
                    int crlf = HttpClient.IndexOf(pending, "\r\n", 0);
                    if (crlf >= 0) {
                        int size = HttpClient.ParseHex(pending.Substring(0, crlf));
                        if (size < 0) {
                            // 坏的块大小行（超限/非法）：停止分块消费，
                            // 剩余缓冲按原样落盘后结束。
                            break;
                        }
                        if (size == 0) {
                            finished = true;
                            progressed = false;
                        } else {
                            int need = crlf + 2 + size + 2;
                            if (pending.Length >= need) {
                                string piece = pending.Substring(crlf + 2, size);
                                if (bodyLimit > 0 && written > bodyLimit - piece.Length) {
                                    fclose(outfp);
                                    this.SetDownloadError("响应正文超过 " + Convert.ToString(bodyLimit) + " bytes");
                                    HttpDeadline.Disarm(watch);
                                    if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
                                    else { conn.Close(); }
                                    return 0 - 1;
                                }
                                fwrite(piece, 1, piece.Length, outfp);
                                written = written + piece.Length;
                                File.WriteAllText(progressFile,
                                    Convert.ToString(written) + "/" + Convert.ToString(total));
                                pending = pending.Substring(need, pending.Length - need);
                                progressed = true;
                            }
                        }
                    }
                }
            } else {
                if (pending.Length > 0) {
                    if (bodyLimit > 0 && written > bodyLimit - pending.Length) {
                        fclose(outfp);
                        this.SetDownloadError("响应正文超过 " + Convert.ToString(bodyLimit) + " bytes");
                        HttpDeadline.Disarm(watch);
                        if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
                        else { conn.Close(); }
                        return 0 - 1;
                    }
                    fwrite(pending, 1, pending.Length, outfp);
                    written = written + pending.Length;
                    File.WriteAllText(progressFile,
                        Convert.ToString(written) + "/" + Convert.ToString(total));
                    pending = "";
                }
                if (total > 0 && written >= total) { finished = true; }
            }

            if (!finished) {
                string c;
                if (this.useTls) { c = await stream.RecvAsync(65536); }
                else { c = await conn.RecvAsync(65536); }
                if (c.Length == 0) { finished = true; }
                else {
                    pending = pending + c;
                    HttpDeadline.Touch(watch, this.IdleBudget());
                }
            }
        }

        fclose(outfp);
        bool late = HttpDeadline.Expired(watch);
        HttpDeadline.Disarm(watch);
        if (this.useTls) {
            stream.Close();
            conn.Close();
            ctx.Free();
        } else {
            conn.Close();
        }

        File.WriteAllText(progressFile,
            Convert.ToString(written) + "/" + Convert.ToString(total));
        if (late) {
            this.SetDownloadError("下载正文超时");
            return 0 - 1;
        }
        if (total > 0 && written < total) {
            this.SetDownloadError("下载正文不完整");
            return 0 - 1;
        }
        return written;
    }

    // 64 位大文件下载（支持 >2GB 文件断点续传）：
    // 进度写入 progressFile（格式："<bytes>/<total>"）。
    // 内部调用 <see cref="DownloadBinaryToFileAsync(string, string, string)"/>，
    // 在同路径下创建隐藏的临时进度文件。
    public async long DownloadBinaryToFileAsync(string path, string localPath) {
        string progressFile = localPath + ".download.progress";
        long r = await this.DownloadBinaryToFileAsync(path, localPath,
            progressFile);
        File.Delete(progressFile);
        return r;
    }

    // 64 位大文件下载的带进度文件重载：
    // 支持按 64 位整型跟踪下载进度，通过
    // <see cref="DownloadBinaryOnceAsync"/> 发起单次可续传请求。
    public async long DownloadBinaryToFileAsync(string path, string localPath,
            string progressFile) {
        this.SetDownloadError("");
        this.ResetTotalBudget();
        List<string> visited = new List<string>();
        string initial = this.CanonicalRequestTarget(path);
        if (initial.Length > 0) { visited.Add(initial); }
        return await this.DownloadBinaryOnceAsync(path, localPath,
            progressFile, visited, 0);
    }

    // 64 位二进制文件下载的单次尝试体：
    // 支持 Content-Range 断点续传，直接将二进制数据写入磁盘文件，
    // 杜绝将大文件完整读入内存导致的 OOM。支持 3xx 重定向追踪。
    public async long DownloadBinaryOnceAsync(string path, string localPath,
            string progressFile, List<string> visited, int hops) {
        this.SetDownloadError("");
        long bodyLimit = 0;
        if (this.callPolicy != null) { bodyLimit = (long)this.callPolicy.MaxBodyBytes(); }
        if (this.callPolicy != null) {
            bool targetOk = ExternalTargetPolicy.IsClientAllowed(this.host,
                this.port, this.useTls,
                this.callPolicy.AllowsLoopback(),
                this.callPolicy.AllowsHttp(),
                this.callPolicy.LocalHttpOnly());
            if (!targetOk) {
                this.SetDownloadError("external target is not allowed");
                return 0 - 1;
            }
        }
        long have = File.GetSize64(localPath);
        if (have < 0) { have = 0; }
        if (bodyLimit > 0 && have > bodyLimit) {
            this.SetDownloadError("已有文件超过 " + Convert.ToString(bodyLimit) + " bytes");
            return 0 - 1;
        }

        Socket.Initialize();
        TcpClient conn = await this.ConnectTarget();
        if (conn == null) { return 0 - 1; }
        TlsStream stream = null;
        TlsContext ctx = null;
        if (this.useTls) {
            if (this.clientCertificateFile.Length > 0
                && this.clientPrivateKeyFile.Length > 0) {
                ctx = TlsContext.CreateClientWithCertificate(
                    this.clientCertificateFile, this.clientPrivateKeyFile);
            } else {
                ctx = TlsContext.CreateClient();
            }
            if (ctx == null) {
                string tlsError4 = TlsStream.LastError();
                if (tlsError4 == "") { tlsError4 = "TLS 上下文初始化失败"; }
                this.SetDownloadError(tlsError4);
                conn.Close();
                return 0 - 1;
            }
            if (!this.verifyTls) { ctx.DisableVerify(); }
            this.ApplyPinning(ctx);
            stream = await this.ConnectTls(ctx, conn.Sock());
            if (stream == null) {
                string tlsHandshakeError4 = TlsStream.LastError();
                if (tlsHandshakeError4 == "") {
                    tlsHandshakeError4 = "TLS 握手失败";
                }
                this.SetDownloadError(tlsHandshakeError4);
                conn.Close();
                ctx.Free();
                return 0 - 1;
            }
        }

        HttpDeadlineToken watch = HttpDeadline.Arm(conn.Sock(), this.WriteBudget(), this.TotalBudget());
        string req = this.BuildDownloadRequest(path, have);
        if (this.callPolicy != null && (long)req.Length > this.callPolicy.MaxRequestBytes()) {
            this.SetDownloadError("请求体超限");
            HttpDeadline.Disarm(watch);
            if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
            else { conn.Close(); }
            return 0 - 1;
        }
        int sentReq = 0;
        if (this.useTls) { sentReq = await stream.SendAsync(req, req.Length); }
        else { sentReq = await conn.SendAsync(req); }
        if (sentReq != req.Length) {
            this.SetDownloadError("下载请求发送失败");
            HttpDeadline.Disarm(watch);
            if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
            else { conn.Close(); }
            return 0 - 1;
        }
        HttpDeadline.Touch(watch, this.ReadBudget());

        // 头部是 ASCII，逐字节读到 CRLFCRLF 为止——这样正文的第一个
        // 字节仍留在连接里，不会和头部一起被读进字符串。
        string one = HttpClient.NewBuffer(2);
        StringBuilder head = new StringBuilder();
        int seen = 0;
        int hlen = 0;
        bool endOfHead = false;
        bool closed = false;
        int lastHeadGot = 0;
        while (!endOfHead && !closed && hlen < 262144) {
            int got;
            if (this.useTls) { got = await stream.RecvIntoAsync(one, 1); }
            else { got = await Socket.RecvIntoAsync(conn.Sock(), one, 1); }
            lastHeadGot = got;
            if (got <= 0) { closed = true; }
            else {
                int c = one[0] & 255;
                head.Append(one.Substring(0, 1));
                hlen = hlen + 1;
                if (c == 13 && (seen == 0 || seen == 2)) { seen = seen + 1; }
                else if (c == 10 && (seen == 1 || seen == 3)) { seen = seen + 1; }
                else { seen = 0; }
                if (seen == 4) { endOfHead = true; }
                HttpDeadline.Touch(watch, this.IdleBudget());
            }
        }
        if (!endOfHead) {
            if (HttpDeadline.Expired(watch)) {
                this.SetDownloadError("读取响应头超时");
            } else if (lastHeadGot < 0) {
                this.SetDownloadError("读取响应头失败");
            } else {
                this.SetDownloadError("响应头不完整");
            }
            HttpDeadline.Disarm(watch);
            if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
            else { conn.Close(); }
            return 0 - 1;
        }
        string headText = head.ToString();
        int status = HttpClient.HeadStatus(headText);
        if (HttpClient.HeadIsChunked(headText)) {
            this.SetDownloadError("响应使用了不支持的 chunked 传输");
            HttpDeadline.Disarm(watch);
            if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
            else { conn.Close(); }
            return 0 - 1;
        }
        // 下载通道不解码内容编码（与 Range 通道同一口径）：落盘的要是
        // 一段 gzip，调用方拿到的就是压缩过的文件。明确报错。
        string downloadEnc = HttpClient.HeadHeader(headText, "Content-Encoding");
        if (downloadEnc != null && downloadEnc.Length > 0
            && downloadEnc.Trim().ToLower() != "identity") {
            this.SetDownloadError("下载响应带 " + downloadEnc
                + " 内容编码，下载通道不解码");
            HttpDeadline.Disarm(watch);
            if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
            else { conn.Close(); }
            return 0 - 1;
        }

        if (status == 416) {
            bool complete = HttpClient.RangeAlreadyComplete(headText, have);
            HttpDeadline.Disarm(watch);
            if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
            else { conn.Close(); }
            if (!complete) {
                this.SetDownloadError("416 Content-Range does not match local file");
                return 0 - 1;
            }
            File.WriteAllText(progressFile,
                Convert.ToString(have) + "/" + Convert.ToString(have));
            return have;
        }
        // 3xx 的重定向跟随语义与 DownloadRangeOnceAsync 一致：仅 GET
        // （幂等）原样重放，防环、每跳重审目标、共享 totalDeadlineUs；
        // 未启用或超限时按错误状态拒绝落盘。
        if (status >= 300 && status < 400) {
            bool wantHop = this.callPolicy != null
                && this.callPolicy.MaxRedirects() > 0
                && hops < this.callPolicy.MaxRedirects()
                && (status == 301 || status == 302 || status == 303
                    || status == 307 || status == 308);
            if (!wantHop) {
                this.SetDownloadError("HTTP 响应状态码 "
                    + Convert.ToString(status));
                HttpDeadline.Disarm(watch);
                if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
                else { conn.Close(); }
                return 0 - 1;
            }
            string location = HttpClient.HeadHeader(headText, "Location");
            if (HttpResponse.HasCrlf(location)) {
                this.SetDownloadError("redirect Location header injection rejected");
                HttpDeadline.Disarm(watch);
                if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
                else { conn.Close(); }
                return 0 - 1;
            }
            // 相对引用按当前请求路径解析（下载通道同样是 GET 幂等重放）。
            ExternalTarget target = ExternalTarget.Parse(
                HttpClient.ResolveLocation(path, location, this.useTls,
                    this.host, this.port));
            string canonical = target != null ? target.Canonical() : "";
            if (target == null || canonical.Length == 0
                || visited.Contains(canonical)) {
                this.SetDownloadError("redirect target is invalid or repeated");
                HttpDeadline.Disarm(watch);
                if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
                else { conn.Close(); }
                return 0 - 1;
            }
            visited.Add(canonical);
            bool sameOrigin = this.RedirectHost() == target.Host()
                && this.port == target.Port()
                && this.useTls == target.IsTls();
            HttpDeadline.Disarm(watch);
            if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
            else { conn.Close(); }
            HttpClient next = this.RedirectNextClient(this, target,
                sameOrigin, false);
            return await next.DownloadBinaryOnceAsync(
                target.Path() + target.Query(), localPath, progressFile,
                visited, hops + 1);
        }
        if (status < 200 || status >= 300) {
            this.SetDownloadError("HTTP 响应状态码 "
                + Convert.ToString(status));
            HttpDeadline.Disarm(watch);
            if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
            else { conn.Close(); }
            return 0 - 1;
        }

        bool resume = status == 206;
        long total = HttpClient.RangeTotal(headText);
        long written = 0;
        if (resume) {
            written = have;
            if (total <= 0) {
                long cl = HttpClient.HeaderLong(headText, "content-length");
                if (cl > 0) { total = have + cl; }
            }
        } else {
            have = 0;
            if (total <= 0) {
                total = HttpClient.HeaderLong(headText, "content-length");
            }
        }

        if (bodyLimit > 0 && (written > bodyLimit
                || (total > 0 && total > bodyLimit))) {
            this.SetDownloadError("响应正文超过 " + Convert.ToString(bodyLimit) + " bytes");
            HttpDeadline.Disarm(watch);
            if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
            else { conn.Close(); }
            return 0 - 1;
        }
        string mode = "wb";
        if (resume) { mode = "ab"; }
        nint outfp = fopen(localPath, mode);
        if (outfp == 0) {
            this.SetDownloadError("无法打开本地归档文件");
            HttpDeadline.Disarm(watch);
            if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
            else { conn.Close(); }
            return 0 - 1;
        }

        string buf = HttpClient.NewBuffer(65537);
        bool finished = false;
        bool cancelled = false;
        int lastBodyN = 0;
        long lastReport = 0 - 1;
        long lastReportMs = 0;
        while (!finished) {
            int n;
            if (this.useTls) { n = await stream.RecvIntoAsync(buf, 65536); }
            else { n = await Socket.RecvIntoAsync(conn.Sock(), buf, 65536); }
            lastBodyN = n;
            if (n <= 0) { finished = true; }
            else {
                if (bodyLimit > 0 && written > bodyLimit - n) {
                    fclose(outfp);
                    this.SetDownloadError("响应正文超过 " + Convert.ToString(bodyLimit) + " bytes");
                    HttpDeadline.Disarm(watch);
                    if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
                    else { conn.Close(); }
                    return 0 - 1;
                }
                long w = fwrite(buf, 1, n, outfp);
                if (w < n) { finished = true; }
                written = written + w;
                // 进度以时间为主、字节为辅：每 200ms（或每 1 MB）刷一次，
                // 慢链路上界面也在动——只按字节报的话 100 KB/s 的链路
                // 十秒才动一格，看着像卡死。
                long nowMs = Stopwatch.GetMilliseconds();
                if (lastReport < 0 || written - lastReport >= 1048576
                        || nowMs - lastReportMs >= 200) {
                    File.WriteAllText(progressFile,
                        Convert.ToString(written) + "/" + Convert.ToString(total));
                    lastReport = written;
                    lastReportMs = nowMs;
                }
                if (total > 0 && written >= total) { finished = true; }
                if (!HttpDeadline.Expired(watch)) {
                    HttpDeadline.Touch(watch, this.IdleBudget());
                }
                // 块边界上优雅退出：已写入的字节都是完整的，下一轮
                // 同一个调用会从这里接着下。
                if (!finished && this.CancelRequested()) {
                    finished = true;
                    cancelled = true;
                }
            }
        }
        fclose(outfp);

        bool late = HttpDeadline.Expired(watch);
        HttpDeadline.Disarm(watch);
        if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
        else { conn.Close(); }
        File.WriteAllText(progressFile,
            Convert.ToString(written) + "/" + Convert.ToString(total));
        if (cancelled) { return 0 - 2; }
        if (late) {
            this.SetDownloadError("读取归档正文超时");
            return 0 - 1;
        }
        if (total > 0 && written < total) {
            if (lastBodyN < 0) {
                this.SetDownloadError("读取归档正文失败");
            } else {
                this.SetDownloadError("归档正文不完整");
            }
            return 0 - 1;
        }
        return written;
    }

    // 分配一个可写的 ARC 托管字节缓冲区（内容为空格）。
    // 原始 calloc 块不带字符串引用计数头，交给 ARC 会出错。
    private static string NewBuffer(int size) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < size; i = i + 1) { sb.Append(" "); }
        return sb.ToString();
    }
}
