using System;
using System.IO;
using System.Diagnostics;
using System.Net.Sockets;
using System.Net.Http;
using System.Net.Tls;
using System.Threading;

namespace System.Net.Http.Client;

// 单条池化管理的 HTTP/HTTPS 持久连接封装。
public class HttpConnectionPool : IDisposable {
    private int maxConnections;
    private int maxIdleConnections;
    private long idleTimeoutMs;
    private long maxLifetimeMs;
    private nint mtx;
    private List<PooledHttpConnection> idleList;
    private int activeCount;
    private Gate gate;
    private bool allowOverflow;
    private bool disposed;
    private long statRented;
    private long statReused;
    private long statCreated;
    private long statWaitTimeouts;

    public HttpConnectionPool(int maxConnections, int maxIdleConnections, long idleTimeoutMs, long maxLifetimeMs) {
        this.maxConnections = maxConnections > 0 ? maxConnections : 32;
        this.maxIdleConnections = maxIdleConnections > 0 ? maxIdleConnections : 16;
        this.idleTimeoutMs = idleTimeoutMs > 0 ? idleTimeoutMs : 60000;
        this.maxLifetimeMs = maxLifetimeMs > 0 ? maxLifetimeMs : 300000;
        this.mtx = Mutex.Create();
        this.idleList = new List<PooledHttpConnection>();
        this.activeCount = 0;
        this.gate = new Gate();
        this.allowOverflow = false;
        this.disposed = false;
        this.statRented = 0;
        this.statReused = 0;
        this.statCreated = 0;
        this.statWaitTimeouts = 0;
    }

    public static HttpConnectionPool CreateDefault() {
        return new HttpConnectionPool(32, 16, 60000, 300000);
    }

    public int MaxConnections() { return this.maxConnections; }
    public int MaxIdleConnections() { return this.maxIdleConnections; }
    public long IdleTimeoutMs() { return this.idleTimeoutMs; }
    public long MaxLifetimeMs() { return this.maxLifetimeMs; }
    public bool AllowsOverflow() { return this.allowOverflow; }
    public void SetAllowOverflow(bool allow) { this.allowOverflow = allow; }

    public void SetLimits(int maxConnections, int maxIdleConnections, long idleTimeoutMs, long maxLifetimeMs) {
        if (this.mtx == 0) { return; }
        Mutex.Lock(this.mtx);
        try {
            if (maxConnections > 0) { this.maxConnections = maxConnections; }
            if (maxIdleConnections > 0) { this.maxIdleConnections = maxIdleConnections; }
            if (idleTimeoutMs > 0) { this.idleTimeoutMs = idleTimeoutMs; }
            if (maxLifetimeMs > 0) { this.maxLifetimeMs = maxLifetimeMs; }
        } finally {
            Mutex.Unlock(this.mtx);
        }
    }

    // 异步租借空闲连接或获取新建连接许可。
    // 1. 若有健康空闲连接，直接返回复用；
    // 2. 若当前存活连接数未达 maxConnections，成功申请 1 个创建许可并返回 null（由调用方建连，失败须调 ReleasePermit）；
    // 3. 若并发连接数已满，挂起在协程 Gate 上排队等待其他请求归还连接或释放槽位；
    // 4. 若在 timeoutMs 内未等到可用槽位且未开启 allowOverflow，抛出 HttpRequestException 熔断，杜绝无界溢出创建连接击穿下游；
    //    若开启了 allowOverflow，在排队超时后返回 null 且不计入 pool 计数（降级为单次无池化连接）。
    public async PooledHttpConnection RentOrPermitAsync(int timeoutMs) {
        if (this.mtx == 0 || this.disposed) {
            throw new InvalidOperationException("HttpConnectionPool is closed or disposed");
        }
        long budget = timeoutMs > 0 ? (long)timeoutMs : 10000L;
        long startMs = Stopwatch.GetMilliseconds();
        while (true) {
            if (this.mtx == 0 || this.disposed) {
                throw new InvalidOperationException("HttpConnectionPool is closed or disposed");
            }
            PooledHttpConnection idle = this.TryRentIdle();
            if (idle != null) {
                return idle;
            }
            if (this.TryAcquirePermit()) {
                return null;
            }
            long elapsed = Stopwatch.GetMilliseconds() - startMs;
            long remain = budget - elapsed;
            if (remain <= 0) {
                Mutex.Lock(this.mtx);
                try {
                    this.statWaitTimeouts = this.statWaitTimeouts + 1;
                } finally {
                    Mutex.Unlock(this.mtx);
                }
                throw new HttpRequestException("connection pool wait timeout: all "
                    + Convert.ToString(this.maxConnections) + " connections are busy");
            }
            int waitMs = remain > 2000L ? 2000 : (int)remain;
            if (this.gate != null) {
                await this.gate.Wait(waitMs);
            } else {
                await Task.Delay(20);
            }
        }
    }

    // 租借一条可用的空闲连接（若存在且未过期）
    public PooledHttpConnection TryRentIdle() {
        if (this.mtx == 0) { return null; }
        List<PooledHttpConnection> expired = new List<PooledHttpConnection>();
        PooledHttpConnection chosen = null;
        Mutex.Lock(this.mtx);
        try {
            long idleUs = this.idleTimeoutMs * 1000L;
            long lifeUs = this.maxLifetimeMs * 1000L;
            while (this.idleList.Count > 0) {
                int lastIdx = this.idleList.Count - 1;
                PooledHttpConnection conn = this.idleList[lastIdx];
                this.idleList.RemoveAt(lastIdx);
                if (conn.IsExpired(idleUs, lifeUs) || !conn.IsHealthy()) {
                    expired.Add(conn);
                    continue;
                }
                this.activeCount = this.activeCount + 1;
                this.statReused = this.statReused + 1;
                this.statRented = this.statRented + 1;
                chosen = conn;
                break;
            }
        } finally {
            Mutex.Unlock(this.mtx);
        }
        for (int i = 0; i < expired.Count; i = i + 1) {
            expired[i].Dispose();
        }
        if (expired.Count > 0 && this.gate != null) {
            this.gate.Signal();
        }
        return chosen;
    }

    // 是否允许创建新连接（并发连接数未达上限）
    public bool TryAcquirePermit() {
        if (this.mtx == 0) { return false; }
        Mutex.Lock(this.mtx);
        try {
            if (this.activeCount + this.idleList.Count < this.maxConnections) {
                this.activeCount = this.activeCount + 1;
                this.statCreated = this.statCreated + 1;
                this.statRented = this.statRented + 1;
                return true;
            }
            return false;
        } finally {
            Mutex.Unlock(this.mtx);
        }
    }

    // 归还或销毁连接
    public void Return(PooledHttpConnection conn, bool reusable) {
        if (conn == null) { return; }
        if (this.mtx == 0) {
            conn.Dispose();
            return;
        }
        bool needDispose = false;
        Mutex.Lock(this.mtx);
        try {
            if (this.activeCount > 0) {
                this.activeCount = this.activeCount - 1;
            }
            long idleUs = this.idleTimeoutMs * 1000L;
            long lifeUs = this.maxLifetimeMs * 1000L;
            if (reusable && !conn.IsExpired(idleUs, lifeUs) && conn.IsHealthy() && this.idleList.Count < this.maxIdleConnections) {
                conn.Touch();
                this.idleList.Add(conn);
            } else {
                needDispose = true;
            }
        } finally {
            Mutex.Unlock(this.mtx);
        }
        if (needDispose) {
            conn.Dispose();
        }
        if (this.gate != null) {
            this.gate.Signal();
        }
    }

    // 撤销创建许可（建连失败时回退计数）
    public void ReleasePermit() {
        if (this.mtx == 0) { return; }
        Mutex.Lock(this.mtx);
        try {
            if (this.activeCount > 0) {
                this.activeCount = this.activeCount - 1;
            }
        } finally {
            Mutex.Unlock(this.mtx);
        }
        if (this.gate != null) {
            this.gate.Signal();
        }
    }

    // 清理所有池化连接
    public void CloseAll() {
        if (this.mtx == 0) { return; }
        List<PooledHttpConnection> toClose = new List<PooledHttpConnection>();
        Mutex.Lock(this.mtx);
        try {
            for (int i = 0; i < this.idleList.Count; i = i + 1) {
                toClose.Add(this.idleList[i]);
            }
            this.idleList.Clear();
            this.activeCount = 0;
        } finally {
            Mutex.Unlock(this.mtx);
        }
        for (int i = 0; i < toClose.Count; i = i + 1) {
            toClose[i].Dispose();
        }
        if (this.gate != null) {
            this.gate.SignalAll();
        }
    }

    public int ActiveCount() {
        if (this.mtx == 0) { return 0; }
        Mutex.Lock(this.mtx);
        try {
            return this.activeCount;
        } finally {
            Mutex.Unlock(this.mtx);
        }
    }

    public int IdleCount() {
        if (this.mtx == 0) { return 0; }
        Mutex.Lock(this.mtx);
        try {
            return this.idleList.Count;
        } finally {
            Mutex.Unlock(this.mtx);
        }
    }

    public long TotalRented() {
        if (this.mtx == 0) { return this.statRented; }
        Mutex.Lock(this.mtx);
        try { return this.statRented; } finally { Mutex.Unlock(this.mtx); }
    }

    public long TotalReused() {
        if (this.mtx == 0) { return this.statReused; }
        Mutex.Lock(this.mtx);
        try { return this.statReused; } finally { Mutex.Unlock(this.mtx); }
    }

    public long TotalCreated() {
        if (this.mtx == 0) { return this.statCreated; }
        Mutex.Lock(this.mtx);
        try { return this.statCreated; } finally { Mutex.Unlock(this.mtx); }
    }

    public long TotalWaitTimeouts() {
        if (this.mtx == 0) { return this.statWaitTimeouts; }
        Mutex.Lock(this.mtx);
        try { return this.statWaitTimeouts; } finally { Mutex.Unlock(this.mtx); }
    }

    // 彻底销毁连接池，清理所有存活连接并释放互斥量底层系统句柄
    public void Dispose() {
        this.disposed = true;
        if (this.mtx != 0) {
            this.CloseAll();
            Mutex.Destroy(this.mtx);
            this.mtx = 0;
        }
        if (this.gate != null) {
            this.gate.SignalAll();
            this.gate.Close();
            this.gate = null;
        }
    }
}
