using System;
using System.Threading;

namespace System.Net.Http.Client;

public class SseSink {
    private string path;
    private string donePath;
    private nint fp;
    // 分段保存 chunk 避免长流每拍 buf+=piece 造成 O(n²) 拷贝，也便于 Since 增量读取。
    private List<string> parts;
    private int cut;
    private string attempt;
    private string done;
    private int total;
    private bool aborted;
    private bool overflowed;
    private int maxBytes;
    private int responseStatus;
    private string responseHeaders;
    private string responseErrorBody;
    private Gate ready;
    private nint lockHandle;

    [DllImport("crt", EntryPoint = "zan_file_fopen")]
    private static extern nint fopen(string path, string mode);

    [DllImport("crt", EntryPoint = "fclose")]
    private static extern int fclose(nint fp);

    [DllImport("crt", EntryPoint = "fwrite")]
    private static extern long fwrite(string buf, long size, long count, nint fp);

    private static SseSink Create(string outFile, string doneFile) {
        SseSink s = new SseSink();
        s.path = outFile;
        s.donePath = doneFile;
        s.fp = 0;
        s.parts = new List<string>();
        s.cut = 0;
        s.attempt = "";
        s.done = "";
        s.total = 0;
        s.aborted = false;
        s.overflowed = false;
        s.maxBytes = 0;
        s.responseStatus = 0;
        s.responseHeaders = "";
        s.responseErrorBody = "";
        s.lockHandle = Mutex.Create();
        s.ready = new Gate();
        return s;
    }

    public static SseSink ToFile(string outFile, string doneFile) { return SseSink.Create(outFile, doneFile); }
    public static SseSink ToMemory() { return SseSink.Create("", ""); }

    public void Begin() {
        Mutex.Lock(this.lockHandle);
        if (this.fp != 0) { SseSink.fclose(this.fp); this.fp = 0; }
        this.parts = new List<string>();
        this.cut = 0;
        this.attempt = "";
        this.done = "";
        this.total = 0;
        this.aborted = false;
        this.overflowed = false;
        this.maxBytes = 0;
        this.responseStatus = 0;
        this.responseHeaders = "";
        this.responseErrorBody = "";
        Mutex.Unlock(this.lockHandle);
        if (this.path != "") {
            nint t = SseSink.fopen(this.path, "wb");
            if (t != 0) { SseSink.fclose(t); }
            this.fp = SseSink.fopen(this.path, "ab");
        }
    }

    public void SetMaxBytes(int bytes) {
        Mutex.Lock(this.lockHandle);
        this.maxBytes = bytes > 0 ? bytes : 0;
        Mutex.Unlock(this.lockHandle);
    }

    public void Write(string piece) { this.TryWrite(piece); }

    public bool TryWrite(string piece) {
        if (piece.Length == 0) { return true; }
        bool signal = false;
        bool overflow = false;
        int limit = 0;
        Mutex.Lock(this.lockHandle);
        bool stopped = this.aborted || this.overflowed || this.attempt.Length > 0;
        int maxCap = this.maxBytes > 0 ? this.maxBytes : 1073741824;
        if (!stopped && this.total > maxCap - piece.Length) {
            this.overflowed = true;
            overflow = true;
            limit = maxCap;
        } else if (!stopped && this.path != "") {
            if (this.fp != 0) {
                long _w = SseSink.fwrite(piece, 1, piece.Length, this.fp);
                this.total = this.total + piece.Length;
            }
            Mutex.Unlock(this.lockHandle);
            return true;
        } else if (!stopped) {
            this.parts.Add(piece);
            this.total = this.total + piece.Length;
            signal = true;
        }
        Mutex.Unlock(this.lockHandle);
        if (overflow) {
            this.Finish("err: stream exceeds " + Convert.ToString(limit) + " bytes");
            return false;
        }
        if (signal && this.ready != null) { this.ready.Signal(); }
        return !stopped;
    }

    private void StopWith(bool isAbort, string marker) {
        Mutex.Lock(this.lockHandle);
        bool already = this.aborted || this.overflowed || this.attempt.Length > 0;
        if (!already) {
            if (isAbort) { this.aborted = true; }
            else { this.overflowed = true; }
        }
        Mutex.Unlock(this.lockHandle);
        if (!already) { this.Finish(marker); }
    }

    public void Abort() { this.StopWith(true, "err: cancelled"); }
    public void Overflow() { this.StopWith(false, "err: stream limit exceeded"); }

    public bool Aborted() {
        Mutex.Lock(this.lockHandle);
        bool v = this.aborted;
        Mutex.Unlock(this.lockHandle);
        return v;
    }

    public bool Overflowed() {
        Mutex.Lock(this.lockHandle);
        bool v = this.overflowed;
        Mutex.Unlock(this.lockHandle);
        return v;
    }

    public void SetResponse(int status, string headers, string errorBody) {
        Mutex.Lock(this.lockHandle);
        this.responseStatus = status;
        this.responseHeaders = headers;
        this.responseErrorBody = errorBody;
        Mutex.Unlock(this.lockHandle);
    }

    public int ResponseStatus() {
        Mutex.Lock(this.lockHandle);
        int s = this.responseStatus;
        Mutex.Unlock(this.lockHandle);
        return s;
    }

    public string ResponseHeaders() {
        Mutex.Lock(this.lockHandle);
        string s = this.responseHeaders;
        Mutex.Unlock(this.lockHandle);
        return s;
    }

    public string ResponseErrorBody() {
        Mutex.Lock(this.lockHandle);
        string s = this.responseErrorBody;
        Mutex.Unlock(this.lockHandle);
        return s;
    }

    // 调用者必须已持有 lockHandle。
    private string Join(int from) {
        StringBuilder sb = new StringBuilder();
        for (int i = from; i < this.parts.Count; i = i + 1) {
            sb.Append(this.parts[i]);
        }
        return sb.ToString();
    }

    public void Finish(string marker) {
        Mutex.Lock(this.lockHandle);
        if (this.attempt.Length > 0) {
            Mutex.Unlock(this.lockHandle);
            return;
        }
        if (this.fp != 0) { SseSink.fclose(this.fp); this.fp = 0; }
        this.attempt = marker;
        if (this.path != "") { this.done = marker; }
        Mutex.Unlock(this.lockHandle);
        if (this.donePath != "") {
            nint dp = SseSink.fopen(this.donePath, "ab");
            if (dp != 0) {
                long _w = SseSink.fwrite(marker, 1, marker.Length, dp);
                SseSink.fclose(dp);
            }
        }
        if (this.ready != null) { this.ready.Signal(); }
    }

    public string Attempt() {
        Mutex.Lock(this.lockHandle);
        string s = this.attempt;
        Mutex.Unlock(this.lockHandle);
        return s;
    }

    public void Publish(string marker) {
        Mutex.Lock(this.lockHandle);
        this.done = marker;
        Mutex.Unlock(this.lockHandle);
    }

    public string All() {
        Mutex.Lock(this.lockHandle);
        string s = this.Join(0);
        Mutex.Unlock(this.lockHandle);
        return s;
    }

    // 仅复制自上次 Since 以来新增的片段，保留历史内容供 All 读取。
    public string Since() {
        Mutex.Lock(this.lockHandle);
        string s = this.Join(this.cut);
        this.cut = this.parts.Count;
        Mutex.Unlock(this.lockHandle);
        return s;
    }

    public string Take() {
        Mutex.Lock(this.lockHandle);
        string s = this.Join(0);
        this.parts = new List<string>();
        this.cut = 0;
        Mutex.Unlock(this.lockHandle);
        return s;
    }

    private async SseDelivery TakeCoCore(int timeoutMs, bool withTimeout) {
        while (true) {
            Mutex.Lock(this.lockHandle);
            bool has = this.parts.Count > 0;
            bool fin = this.attempt.Length > 0;
            string s = "";
            if (has) {
                s = this.Join(0);
                this.parts = new List<string>();
                this.cut = 0;
            }
            Mutex.Unlock(this.lockHandle);
            if (has || fin) {
                SseDelivery d = new SseDelivery();
                d.data = s;
                d.finished = fin;
                return d;
            }
            if (withTimeout) {
                await this.ready.Wait(timeoutMs);
            } else {
                await this.ready.Wait();
            }
        }
    }

    public async SseDelivery TakeCo() { return await this.TakeCoCore(0, false); }
    public async SseDelivery TakeCo(int timeoutMs) { return await this.TakeCoCore(timeoutMs, true); }

    public string Done() {
        Mutex.Lock(this.lockHandle);
        string s = this.done;
        Mutex.Unlock(this.lockHandle);
        return s;
    }

    public int Total() {
        Mutex.Lock(this.lockHandle);
        int n = this.total;
        Mutex.Unlock(this.lockHandle);
        return n;
    }

    // 不提前 Close ready 门：TakeCo(timeoutMs) 遗留的看门狗协程到期仍会 signal，交由 ARC 随 sink 回收。
    public void Dispose() {
        if (this.fp != 0) { SseSink.fclose(this.fp); this.fp = 0; }
        this.ready = null;
        if (this.lockHandle != 0) {
            Mutex.Destroy(this.lockHandle);
            this.lockHandle = 0;
        }
    }
}
