using System;

namespace System.Net.Http.Client;

// 一条已存储的 cookie。缺少 PSL 时显式 Domain 也只回给响应主机；
// <c>hostOnly</c> 控制回放时是否允许匹配子域。
// <c>expires</c> 为 0 表示会话 cookie（进程内一直有效）。
public class CookieJar {
    private const int MaxCookies = 3000;
    private List<Cookie> items;
    private int expiringCount;

    // 内部构造：空存储；经 HttpClient.UseCookies() 创建。
    public CookieJar() {
        this.items = new List<Cookie>();
        this.expiringCount = 0;
    }

    // RFC 6265 §5.2: 仅裁剪 SP (0x20) 与 HTAB (0x09)，禁止静默吞掉 CR/LF 等控制字符。
    private static bool IsTrimWs(int c) {
        return c == 32 || c == 9;
    }

    // ASCII 快速转小写：已全小写时零分配原样返回。
    private static string ToLowerFast(string s) {
        if (s == null || s.Length == 0) { return ""; }
        int n = s.Length;
        nint sp = (nint)s;
        Span<byte> sb = new Span<byte>(sp, n);
        int firstUpper = -1;
        for (int i = 0; i < n; i = i + 1) {
            int c = sb[i] & 255;
            if (c >= 65 && c <= 90) { firstUpper = i; break; }
        }
        if (firstUpper < 0) { return s; }
        byte[] buf = new byte[n];
        if (firstUpper > 0) { NativeMemory.Copy((nint)buf, sp, firstUpper); }
        for (int i = firstUpper; i < n; i = i + 1) {
            int c = sb[i] & 255;
            buf[i] = (byte)((c >= 65 && c <= 90) ? (c + 32) : c);
        }
        return NativeMemory.GetString((nint)buf, 0, n);
    }

    private static string ToLowerSlice(nint sp, Span<byte> sb, int start, int len) {
        if (len <= 0) { return ""; }
        int firstUpper = -1;
        for (int i = 0; i < len; i = i + 1) {
            int c = sb[start + i] & 255;
            if (c >= 65 && c <= 90) { firstUpper = i; break; }
        }
        if (firstUpper < 0) { return NativeMemory.GetString(sp, start, len); }
        byte[] buf = new byte[len];
        if (firstUpper > 0) { NativeMemory.Copy((nint)buf, sp + (nint)start, firstUpper); }
        for (int i = firstUpper; i < len; i = i + 1) {
            int c = sb[start + i] & 255;
            buf[i] = (byte)((c >= 65 && c <= 90) ? (c + 32) : c);
        }
        return NativeMemory.GetString((nint)buf, 0, len);
    }

    private static bool EqLowerSlice(Span<byte> sb, int start, int len, string lower) {
        if (len != lower.Length) { return false; }
        for (int i = 0; i < len; i = i + 1) {
            int c = sb[start + i] & 255;
            if (c >= 65 && c <= 90) { c = c + 32; }
            if (c != (lower[i] & 255)) { return false; }
        }
        return true;
    }

    private static long NowUnixSeconds() {
        return DateTime.GetCurrentUnixMilliseconds() / 1000L;
    }

    // 已存储的 cookie 条数（过期的不计）。
    public int Count() {
        lock (this) {
            this.DropExpired();
            return this.items.Count;
        }
    }

    // 按名字取值，没有则返回空串。
    public string Get(string name) {
        lock (this) {
            this.DropExpired();
            int n = this.items.Count;
            for (int i = 0; i < n; i = i + 1) {
                if (this.items[i].Name() == name) { return this.items[i].Value(); }
            }
            return "";
        }
    }

    // 按名字删除，删掉了返回 true。
    public bool Remove(string name) {
        lock (this) {
            int n = this.items.Count;
            for (int i = 0; i < n; i = i + 1) {
                if (this.items[i].Name() == name) {
                    if (this.items[i].Expires() > 0) {
                        this.expiringCount = this.expiringCount - 1;
                    }
                    this.items.RemoveAt(i);
                    return true;
                }
            }
            return false;
        }
    }

    // 清空存储。
    public void Clear() {
        lock (this) {
            this.items.Clear();
            this.expiringCount = 0;
        }
    }

    // 吸收一条 Set-Cookie 头的值（不含头名字），<paramref name="host"/> 和
    // <paramref name="requestPath"/> 是发出该请求的主机与路径，用于补齐
    // 缺失的 Domain / Path。Max-Age=0 或已过去的 Expires 表示删除，
    // 同名同域同路径的旧值被覆盖。
    public void SetCookie(string host, string requestPath, string setCookieValue) {
        if (setCookieValue == null || setCookieValue.Length == 0) { return; }
        string h = CookieJar.ToLowerFast(host);
        string defPath = CookieJar.DefaultPath(requestPath);
        int n = setCookieValue.Length;
        nint sp = (nint)setCookieValue;
        lock (this) {
            this.SetCookieSlice(h, defPath, sp, new Span<byte>(sp, n), 0, n);
        }
    }

    private static bool IsSafeCookieBytes(Span<byte> sb, int start, int end, bool isName) {
        for (int i = start; i < end; i = i + 1) {
            int c = sb[i] & 255;
            if (c < 32 || c == 127 || c == 59) { return false; }
            if (isName && (c == 32 || c == 61)) { return false; }
        }
        return true;
    }

    // 严格按 RFC 6265 §5.2.2 解析 Max-Age：仅允许可选 '-' 加纯数字，非法返回 false（忽略而非删除），溢出饱和截断。
    private static bool TryParseMaxAge(Span<byte> sb, int start, int end, out long age) {
        age = 0L;
        if (start >= end) { return false; }
        int i = start;
        bool neg = false;
        if ((sb[i] & 255) == 45) {
            neg = true;
            i = i + 1;
        }
        if (i >= end) { return false; }
        long val = 0L;
        long maxSafe = 3153600000L; // 100 年上限，防 now + age 溢出
        while (i < end) {
            int ch = sb[i] & 255;
            if (ch < 48 || ch > 57) { return false; }
            if (val < maxSafe) {
                val = val * 10L + (long)(ch - 48);
                if (val > maxSafe) { val = maxSafe; }
            }
            i = i + 1;
        }
        age = neg ? (0L - val) : val;
        return true;
    }

    // 零子串原地解析单条 Set-Cookie 值切片 [valStart, valEnd)。
    private void SetCookieSlice(string h, string defPath, nint sp, Span<byte> sb, int valStart, int valEnd) {
        int semi = NativeMemory.Find(sp, valStart, 59, valEnd - valStart); // ';'
        int pairEnd = semi >= 0 ? semi : valEnd;
        int eq = NativeMemory.Find(sp, valStart, 61, pairEnd - valStart); // '='
        if (eq <= valStart) { return; }

        int ns = valStart;
        int ne = eq;
        while (ns < ne && CookieJar.IsTrimWs(sb[ns] & 255)) { ns = ns + 1; }
        while (ne > ns && CookieJar.IsTrimWs(sb[ne - 1] & 255)) { ne = ne - 1; }
        if (ns >= ne) { return; }

        int vs = eq + 1;
        int ve = pairEnd;
        while (vs < ve && CookieJar.IsTrimWs(sb[vs] & 255)) { vs = vs + 1; }
        while (ve > vs && CookieJar.IsTrimWs(sb[ve - 1] & 255)) { ve = ve - 1; }
        if (!CookieJar.IsSafeCookieBytes(sb, ns, ne, true)
            || !CookieJar.IsSafeCookieBytes(sb, vs, ve, false)) {
            return;
        }

        string name = NativeMemory.GetString(sp, ns, ne - ns);
        string val = vs < ve ? NativeMemory.GetString(sp, vs, ve - vs) : "";
        Cookie c = new Cookie(name, val);
        c.domain = h;
        c.path = defPath;

        bool deleted = false;
        long nowCache = 0L;
        int pos = semi;
        while (pos >= 0 && pos < valEnd) {
            int next = NativeMemory.Find(sp, pos + 1, 59, valEnd - (pos + 1));
            int segEnd = next >= 0 ? next : valEnd;
            int as0 = pos + 1;
            int ae0 = segEnd;
            pos = next;
            while (as0 < ae0 && CookieJar.IsTrimWs(sb[as0] & 255)) { as0 = as0 + 1; }
            while (ae0 > as0 && CookieJar.IsTrimWs(sb[ae0 - 1] & 255)) { ae0 = ae0 - 1; }
            if (as0 >= ae0) { continue; }

            int aeq = NativeMemory.Find(sp, as0, 61, ae0 - as0);
            int ks = as0;
            int ke = aeq >= 0 ? aeq : ae0;
            while (ke > ks && CookieJar.IsTrimWs(sb[ke - 1] & 255)) { ke = ke - 1; }
            int klen = ke - ks;

            int avs = aeq >= 0 ? aeq + 1 : ae0;
            int ave = ae0;
            if (aeq >= 0) {
                while (avs < ave && CookieJar.IsTrimWs(sb[avs] & 255)) { avs = avs + 1; }
            }
            int avlen = ave - avs;

            if (klen == 4 && CookieJar.EqLowerSlice(sb, ks, 4, "path")) {
                if (avlen > 0 && (sb[avs] & 255) == 47) {
                    c.path = NativeMemory.GetString(sp, avs, avlen);
                }
            } else if (klen == 6) {
                int fc = sb[ks] & 255;
                if (fc >= 65 && fc <= 90) { fc = fc + 32; }
                if (fc == 100 && CookieJar.EqLowerSlice(sb, ks, 6, "domain")) {
                    if (avlen > 0) {
                        int ds = avs;
                        int dlen = avlen;
                        if ((sb[ds] & 255) == 46) { ds = ds + 1; dlen = dlen - 1; }
                        string d = CookieJar.ToLowerSlice(sp, sb, ds, dlen);
                        if (!CookieJar.DomainAttributeOk(h, d)) {
                            return;
                        }
                        c.domain = d;
                        c.hostOnly = true;
                    }
                } else if (fc == 115 && CookieJar.EqLowerSlice(sb, ks, 6, "secure")) {
                    c.secure = true;
                }
            } else if (klen == 8 && CookieJar.EqLowerSlice(sb, ks, 8, "httponly")) {
                c.httpOnly = true;
            } else if (klen == 7) {
                int fc = sb[ks] & 255;
                if (fc >= 65 && fc <= 90) { fc = fc + 32; }
                if (fc == 109 && CookieJar.EqLowerSlice(sb, ks, 7, "max-age")) {
                    long age = 0L;
                    if (CookieJar.TryParseMaxAge(sb, avs, ave, out age)) {
                        if (age <= 0L) { deleted = true; }
                        else {
                            if (nowCache == 0L) { nowCache = CookieJar.NowUnixSeconds(); }
                            c.expires = nowCache + age;
                        }
                    }
                } else if (fc == 101 && CookieJar.EqLowerSlice(sb, ks, 7, "expires")) {
                    long at = CookieJar.ParseHttpDateSlice(sb, avs, ave);
                    if (at > 0) {
                        if (nowCache == 0L) { nowCache = CookieJar.NowUnixSeconds(); }
                        if (at <= nowCache) { deleted = true; }
                        else { c.expires = at; }
                    }
                }
            }
        }

        int cnt = this.items.Count;
        string cName = c.name;
        string cDomain = c.domain;
        string cPath = c.path;
        for (int i = 0; i < cnt; i = i + 1) {
            Cookie old = this.items[i];
            if (old.name == cName && old.domain == cDomain && old.path == cPath) {
                if (old.expires > 0) {
                    this.expiringCount = this.expiringCount - 1;
                }
                this.items.RemoveAt(i);
                break;
            }
        }
        if (!deleted) {
            if (this.items.Count >= MaxCookies) {
                this.DropExpired();
                if (this.items.Count >= MaxCookies) {
                    if (this.items[0].expires > 0) {
                        this.expiringCount = this.expiringCount - 1;
                    }
                    this.items.RemoveAt(0);
                }
            }
            this.items.Add(c);
            if (c.expires > 0) {
                this.expiringCount = this.expiringCount + 1;
            }
        }
    }

    // 该请求应带的 Cookie 头值（"a=1; b=2"），没有匹配的 cookie 则为空串。
    // <paramref name="secureChannel"/> 为 false 时标了 Secure 的 cookie 不外发。
    // 顺序按 RFC 6265：路径长的在前，同长度按写入顺序。
    public string HeaderValue(string host, string requestPath, bool secureChannel) {
        lock (this) {
        this.DropExpired();
        int n = this.items.Count;
        if (n == 0) { return ""; }
        string h = CookieJar.ToLowerFast(host);

        // 零分配计算路径切片长度（剥离 '?' / '#'）
        int pLen = 0;
        string pSrc = "/";
        if (requestPath != null && requestPath.Length > 0) {
            int rl = requestPath.Length;
            nint rp = (nint)requestPath;
            int cut = NativeMemory.IndexOfAny(rp, rl, 63, 35); // '?' or '#'
            if (cut < 0) { cut = rl; }
            if (cut > 0) {
                pSrc = requestPath;
                pLen = cut;
            } else {
                pLen = 1;
            }
        } else {
            pLen = 1;
        }

        Span<byte> hSpan = h.Length > 0 ? new Span<byte>((nint)h, h.Length) : new Span<byte>(0, 0);
        Span<byte> pSpan = new Span<byte>((nint)pSrc, pLen);

        Cookie[] hit = null;
        int hc = 0;
        Cookie firstHit = null;
        for (int i = 0; i < n; i = i + 1) {
            Cookie c = this.items[i];
            if (c.secure && !secureChannel) { continue; }
            if (!CookieJar.DomainMatchesSpan(h, hSpan, c.domain, c.hostOnly)) { continue; }
            if (!CookieJar.PathMatchesSpan(pSpan, pLen, c.path)) { continue; }
            if (firstHit == null) {
                firstHit = c;
            } else {
                if (hit == null) {
                    hit = new Cookie[n];
                    hit[0] = firstHit;
                    hc = 1;
                }
                hit[hc] = c;
                hc = hc + 1;
            }
        }
        if (firstHit == null) { return ""; }
        if (hit == null) {
            string cn = firstHit.name;
            string cv = firstHit.Value();
            int total1 = cn.Length + 1 + cv.Length;
            byte[] b1 = new byte[total1];
            nint bp1 = (nint)b1;
            NativeMemory.PutString(bp1, 0, cn, cn.Length);
            b1[cn.Length] = 61; // '='
            if (cv.Length > 0) { NativeMemory.PutString(bp1, cn.Length + 1, cv, cv.Length); }
            return NativeMemory.GetString(bp1, 0, total1);
        }

        // 插入排序：路径长度降序，相等时保持写入顺序（稳定）。
        for (int i = 1; i < hc; i = i + 1) {
            Cookie cur = hit[i];
            int curLen = cur.path.Length;
            int j = i - 1;
            while (j >= 0 && hit[j].path.Length < curLen) {
                hit[j + 1] = hit[j];
                j = j - 1;
            }
            hit[j + 1] = cur;
        }

        int total = (hc - 1) * 2; // "; "
        for (int i = 0; i < hc; i = i + 1) {
            Cookie ck = hit[i];
            total = total + ck.name.Length + 1 + ck.Value().Length;
        }
        byte[] outb = new byte[total];
        nint op = (nint)outb;
        int oPos = 0;
        for (int i = 0; i < hc; i = i + 1) {
            if (i > 0) {
                outb[oPos] = 59; // ';'
                outb[oPos + 1] = 32; // ' '
                oPos = oPos + 2;
            }
            Cookie ck = hit[i];
            string cn = ck.name;
            string cv = ck.Value();
            if (cn.Length > 0) { NativeMemory.PutString(op, oPos, cn, cn.Length); oPos = oPos + cn.Length; }
            outb[oPos] = 61; // '='
            oPos = oPos + 1;
            if (cv.Length > 0) { NativeMemory.PutString(op, oPos, cv, cv.Length); oPos = oPos + cv.Length; }
        }
        return NativeMemory.GetString(op, 0, total);
        }
    }

    // 从一段响应头里吸收所有 Set-Cookie 行。<paramref name="head"/> 是
    // 状态行 + 头部（到空行为止即可，多给了也无妨）。
    public void AbsorbHead(string host, string requestPath, string head) {
        if (head == null || head.Length == 0) { return; }
        lock (this) {
        string hLower = null;
        string defPath = null;
        int pos = 0;
        int len = head.Length;
        nint hp = (nint)head;
        Span<byte> hb = new Span<byte>(hp, len);
        while (pos < len) {
            int nl = NativeMemory.Find(hp, pos, 10, len - pos);
            int end = nl < 0 ? len : nl;
            int stop = end;
            if (stop > pos && (hb[stop - 1] & 255) == 13) { stop = stop - 1; }
            int lineLen = stop - pos;
            if (lineLen == 0) { return; }
            if (lineLen > 11 && (hb[pos + 10] & 255) == 58
                    && CookieJar.EqLowerSlice(hb, pos, 10, "set-cookie")) {
                if (hLower == null) {
                    hLower = CookieJar.ToLowerFast(host);
                    defPath = CookieJar.DefaultPath(requestPath);
                }
                int vs = pos + 11;
                int ve = stop;
                while (vs < ve && CookieJar.IsTrimWs(hb[vs] & 255)) { vs = vs + 1; }
                while (ve > vs && CookieJar.IsTrimWs(hb[ve - 1] & 255)) { ve = ve - 1; }
                if (vs < ve) {
                    this.SetCookieSlice(hLower, defPath, hp, hb, vs, ve);
                }
            }
            pos = end + 1;
        }
        }
    }

    // 丢掉已过期的条目（无过期条目时 O(1) 跳过系统时钟调用）。
    private void DropExpired() {
        if (this.expiringCount <= 0) { return; }
        long now = CookieJar.NowUnixSeconds();
        int i = 0;
        while (i < this.items.Count) {
            long at = this.items[i].Expires();
            if (at > 0 && at <= now) {
                this.items.RemoveAt(i);
                this.expiringCount = this.expiringCount - 1;
            } else {
                i = i + 1;
            }
        }
    }

    // 零 Substring 域名后缀匹配。
    private static bool DomainMatchesSpan(string host, Span<byte> hSpan, string domain, bool hostOnly) {
        if (host == domain) { return true; }
        if (hostOnly) { return false; }
        int hl = host.Length;
        int dl = domain.Length;
        if (hl <= dl) { return false; }
        int off = hl - dl;
        if ((hSpan[off - 1] & 255) != 46) { return false; }
        Span<byte> dSpan = new Span<byte>((nint)domain, dl);
        for (int i = 0; i < dl; i = i + 1) {
            if (hSpan[off + i] != dSpan[i]) { return false; }
        }
        return true;
    }

    private static bool DomainAttributeOk(string host, string domain) {
        if (domain.Length == 0 || host.Length == 0) { return false; }
        if (CookieJar.IsIpHost(host)) { return false; }
        if (host != domain) { return false; }
        return NativeMemory.Find((nint)domain, 0, 46, domain.Length) >= 0;
    }

    // host 是否是 IP 字面量：IPv4 四段全数字，或含 ':' 的 IPv6。
    private static bool IsIpHost(string host) {
        int dots = 0;
        int n = host.Length;
        bool numeric = n > 0;
        for (int i = 0; i < n; i = i + 1) {
            int c = host[i] & 255;
            if (c == 46) { dots = dots + 1; continue; }
            if (c == 58) { return true; }  // ':' -> IPv6
            if (c < 48 || c > 57) { numeric = false; }
        }
        return numeric && dots == 3;
    }

    // RFC 6265 的 path-match（零 Substring 字节前缀比较）。
    private static bool PathMatchesSpan(Span<byte> pSpan, int pLen, string cookiePath) {
        int cl = cookiePath.Length;
        if (cl == 0 || pLen < cl) { return false; }
        if (pLen > cl && (cookiePath[cl - 1] & 255) != 47 && (pSpan[cl] & 255) != 47) {
            return false;
        }
        Span<byte> cSpan = new Span<byte>((nint)cookiePath, cl);
        for (int i = 0; i < cl; i = i + 1) {
            if (pSpan[i] != cSpan[i]) { return false; }
        }
        return true;
    }

    // RFC 6265 的 default-path：请求路径去掉最后一段（"/a/b" -> "/a"）。
    private static string DefaultPath(string requestPath) {
        if (requestPath == null || requestPath.Length == 0) { return "/"; }
        int rl = requestPath.Length;
        nint rp = (nint)requestPath;
        int cut = NativeMemory.IndexOfAny(rp, rl, 63, 35); // '?' or '#'
        if (cut < 0) { cut = rl; }
        if (cut == 0 || (requestPath[0] & 255) != 47) { return "/"; }
        int last = -1;
        for (int i = cut - 1; i >= 0; i = i - 1) {
            if ((requestPath[i] & 255) == 47) { last = i; break; }
        }
        if (last <= 0) { return "/"; }
        return NativeMemory.GetString(rp, 0, last);
    }

    // 零列表分配单遍解析 HTTP 日期（RFC 1123 / RFC 850 / asctime）-> Unix 秒。
    private static long ParseHttpDateSlice(Span<byte> sb, int start, int end) {
        int day = -1;
        int month = -1;
        int year = -1;
        int hour = 0;
        int minute = 0;
        int second = 0;
        bool haveTime = false;

        int i = start;
        while (i < end) {
            while (i < end) {
                int ch = sb[i] & 255;
                if (ch != 32 && ch != 44 && ch != 45 && ch != 9) { break; }
                i = i + 1;
            }
            if (i >= end) { break; }
            int ts = i;
            bool hasColon = false;
            bool allDigits = true;
            while (i < end) {
                int ch = sb[i] & 255;
                if (ch == 32 || ch == 44 || ch == 45 || ch == 9) { break; }
                if (ch == 58) { hasColon = true; allDigits = false; }
                else if (ch < 48 || ch > 57) { allDigits = false; }
                i = i + 1;
            }
            int te = i;
            int tlen = te - ts;

            if (hasColon) {
                if (!haveTime) {
                    int p = ts;
                    int c1 = -1;
                    int c2 = -1;
                    while (p < te) {
                        if ((sb[p] & 255) == 58) {
                            if (c1 < 0) { c1 = p; }
                            else if (c2 < 0) { c2 = p; break; }
                        }
                        p = p + 1;
                    }
                    if (c1 >= ts) {
                        hour = (int)CookieJar.ParseLongSlice(sb, ts, c1);
                        int mEnd = c2 >= 0 ? c2 : te;
                        minute = (int)CookieJar.ParseLongSlice(sb, c1 + 1, mEnd);
                        if (c2 >= 0) {
                            int sEnd = c2 + 1;
                            while (sEnd < te && (sb[sEnd] & 255) != 58) { sEnd = sEnd + 1; }
                            second = (int)CookieJar.ParseLongSlice(sb, c2 + 1, sEnd);
                        }
                        haveTime = true;
                    }
                }
                continue;
            }

            if (allDigits) {
                long n = CookieJar.ParseLongSlice(sb, ts, te);
                if (tlen >= 3) { year = (int)n; }
                else if (day < 0) { day = (int)n; }
                else if (year < 0) {
                    if (n >= 70) { year = (int)(1900 + n); } else { year = (int)(2000 + n); }
                }
                continue;
            }

            if (tlen >= 3) {
                int m = CookieJar.MonthOfSlice(sb, ts);
                if (m > 0) { month = m; }
            }
        }

        if (day < 1 || month < 1 || year < 1601) { return 0; }
        return (long)DateTime.DaysFromCivil(year, month, day) * 86400L
            + (long)hour * 3600L + (long)minute * 60L + (long)second;
    }

    // 3 字母月份缩写首字母跳表（零 Substring/ToLower）。
    private static int MonthOfSlice(Span<byte> sb, int ts) {
        int c0 = sb[ts] & 255;
        int c1 = sb[ts + 1] & 255;
        int c2 = sb[ts + 2] & 255;
        if (c0 >= 65 && c0 <= 90) { c0 = c0 + 32; }
        if (c1 >= 65 && c1 <= 90) { c1 = c1 + 32; }
        if (c2 >= 65 && c2 <= 90) { c2 = c2 + 32; }
        int key = (c0 << 16) | (c1 << 8) | c2;
        switch (key) {
            case 6971758: return 1;  // "jan"
            case 6710626: return 2;  // "feb"
            case 7168370: return 3;  // "mar"
            case 6385778: return 4;  // "apr"
            case 7168377: return 5;  // "may"
            case 6976878: return 6;  // "jun"
            case 6976876: return 7;  // "jul"
            case 6387047: return 8;  // "aug"
            case 7562608: return 9;  // "sep"
            case 7299956: return 10; // "oct"
            case 7237494: return 11; // "nov"
            case 6579555: return 12; // "dec"
            default:      return 0;
        }
    }

    // 解析切片内十进制整数（可带前导负号），非数字处停止；无数字为 0。
    private static long ParseLongSlice(Span<byte> sb, int start, int end) {
        long n = 0;
        bool neg = false;
        int i = start;
        if (i < end && (sb[i] & 255) == 45) { neg = true; i = i + 1; }
        while (i < end) {
            int ch = sb[i] & 255;
            if (ch < 48 || ch > 57) { break; }
            n = n * 10L + (long)(ch - 48);
            i = i + 1;
        }
        return neg ? (0L - n) : n;
    }
}
