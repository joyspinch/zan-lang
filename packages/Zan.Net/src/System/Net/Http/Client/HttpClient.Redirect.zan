using System;
using System.Collections.Generic;
using System.Net.Sockets;
using System.Net.Http;
using System.Net.External;

namespace System.Net.Http.Client;

// HttpClient.Redirect.zan - RFC 3986 / RFC 9110 HTTP 重定向解析、防环、头继承与逐跳重放驱动
public partial class HttpClient {
    // RFC 3986 §5.3：把 Location 按"当前请求 URL"解析成绝对 URL。
    // basePath 是最近一次请求的路径（含 query），scheme/host/port 取自
    // 当前客户端。片段（#）不随请求发送，先剥掉。
    //
    // 绝对地址原样返回；其余按引用类型拼接：
    //   //host/path  → scheme 相对（继承 scheme，换 authority）
    //   /path        → 同 origin 的绝对路径
    //   ?query       → 同 path，换 query
    //   path         → 相对当前 path 的最后一段之前拼接
    // 解析结果仍要过 ExternalTarget.Parse 的同一套校验（scheme 白名单、
    // 主机名合法性、端口范围），所以这里不放松任何安全边界。
    private static string ResolveLocation(string basePath, string location,
            bool useTls, string host, int port) {
        if (location == null) { return null; }
        string loc = location;
        int hash = loc.IndexOf("#");
        if (hash >= 0) { loc = loc.Substring(0, hash); }
        if (loc.Length == 0) { return null; }
        if (loc.StartsWith("http://") || loc.StartsWith("https://")) {
            return loc;
        }
        string scheme = useTls ? "https" : "http";
        string authority = host;
        int defaultPort = useTls ? 443 : 80;
        if (port != defaultPort) {
            authority = authority + ":" + Convert.ToString(port);
        }
        if (loc.StartsWith("//")) { return scheme + ":" + loc; }
        string origin = scheme + "://" + authority;
        if (loc.StartsWith("/")) { return origin + loc; }
        string baseUri = basePath == null || basePath.Length == 0 ? "/" : basePath;
        int bq = baseUri.IndexOf("?");
        if (bq >= 0) { baseUri = baseUri.Substring(0, bq); }
        if (loc.StartsWith("?")) { return origin + baseUri + loc; }
        // 相对路径：取 base 最后一个 "/" 之前的目录做前缀。
        int cut = baseUri.LastIndexOf("/");
        string dir = cut >= 0 ? baseUri.Substring(0, cut + 1) : "/";
        return origin + dir + loc;
    }

    // 本客户端 host 的小写形式，剥掉 IPv6 字面量的方括号；
    // 与 ExternalTarget.Host() 比较重定向是否同源。
    private string RedirectHost() {
        string h = this.host.ToLower();
        if (h.StartsWith("[") && h.EndsWith("]")) {
            return h.Substring(1, h.Length - 2);
        }
        return h;
    }

    // 本客户端当前请求目标的规范 URL（scheme://host[:port]/path），
    // 供重定向防环的 visited 集合使用；解析失败返回 ""。
    private string CanonicalRequestTarget(string requestPath) {
        string authority = this.host;
        if (authority.IndexOf(":") >= 0 && !authority.StartsWith("[")) {
            authority = "[" + authority + "]";
        }
        string scheme = this.useTls ? "https" : "http";
        string url = scheme + "://" + authority;
        int defaultPort = this.useTls ? 443 : 80;
        if (this.port != defaultPort) {
            url = url + ":" + Convert.ToString(this.port);
        }
        if (requestPath == null || requestPath.Length == 0) {
            url = url + "/";
        } else {
            url = url + requestPath;
        }
        ExternalTarget t = ExternalTarget.Parse(url);
        if (t == null) { return ""; }
        return t.Canonical();
    }

    // 同下，默认不丢弃实体类头。
    private bool IsRedirectHeader(string line, bool sameOrigin) {
        return this.IsRedirectHeader(line, sameOrigin, false);
    }

    // 重定向下一跳是否继承该默认头：Host/Range 永不继承；
    // dropEntity 时实体类头（Content-Length/Transfer-Encoding/Expect/
    // Content-Type/Content-Encoding/Content-MD5/Trailer）不继承；
    // 跨 origin 时敏感凭据头（Authorization/Cookie/Proxy-Authorization）
    // 不继承。
    private bool IsRedirectHeader(string line, bool sameOrigin, bool dropEntity) {
        int colon = line.IndexOf(":");
        if (colon <= 0) { return false; }
        string name = line.Substring(0, colon).Trim().ToLower();
        if (name == "host" || name == "range") { return false; }
        if (dropEntity && (name == "content-length"
            || name == "transfer-encoding" || name == "expect"
            || name == "content-type" || name == "content-encoding"
            || name == "content-md5" || name == "trailer")) {
            return false;
        }
        if (!sameOrigin && (name == "authorization" || name == "cookie"
            || name == "proxy-authorization")) { return false; }
        return true;
    }

    // 下一跳是否值得继续跟随：响应必须是 3xx 重定向、policy
    // 已绑定且仍有跳数。Location 头的 CRLF 注入防线在这里统一落地：
    // 带折行的 Location 直接拒绝（与其传给 ExternalTarget.Parse 让它
    // 以文本校验失败，不如显式报注入拒绝）。
    private bool RedirectWanted(HttpResponse response, int hops) {
        int code = response.statusCode;
        if (code != 301 && code != 302 && code != 303
            && code != 307 && code != 308) { return false; }
        if (this.callPolicy == null || this.callPolicy.MaxRedirects() <= 0) {
            return false;
        }
        return hops < this.callPolicy.MaxRedirects();
    }

    // 3xx 响应里的 307/308 重放守卫与 301/302/303 动作改写。
    // nextMethod 为改写结果；返回 false 表示该响应不允许自动重放
    // （调用方原样返回 3xx）。
    //
    // sameOrigin 只影响 307/308：这两种码按 RFC 9110 保留方法与请求
    // 正文，而重放正文等于把请求体再送一次——同源是同一个站点，跨源
    // 就是把数据交给另一个站点，与 Authorization/Cookie 跨源剥离是
    // 同一道防线，所以跨源的 307/308 仍然拒绝。
    private bool RedirectReplay(string method, int code, bool sameOrigin,
            out string nextMethod) {
        nextMethod = method;
        if (code == 303) {
            if (method == "POST") {
                nextMethod = "GET";
            } else if (method != "GET" && method != "HEAD") {
                return false;
            }
        } else if ((code == 301 || code == 302)
            && method != "GET" && method != "HEAD") {
            if (method != "POST") { return false; }
            nextMethod = "GET";
        } else if ((code == 307 || code == 308)
            && method != "GET" && method != "HEAD") {
            if (!sameOrigin) { return false; }
        }
        return true;
    }

    // 为重定向的下一跳派生客户端：继承 TLS/验证/固定值/证书/
    // 策略/超时/cookie 与共享 totalDeadlineUs，按 sameOrigin 与动作改写
    // 过滤默认头。中转客户端是一次性连接（kaEnabled=false），池仍归
    // 发起客户端独有。
    private HttpClient RedirectNextClient(HttpClient current, ExternalTarget target,
            bool sameOrigin, bool dropEntityHeaders) {
        HttpClient next = new HttpClient(target.Host(), target.Port());
        next.kaEnabled = false;
        next.useTls = target.IsTls();
        next.verifyTls = current.verifyTls;
        next.clientCertificateFile = current.clientCertificateFile;
        next.clientPrivateKeyFile = current.clientPrivateKeyFile;
        next.tlsPins = current.tlsPins;
        next.pinningEnabled = current.pinningEnabled;
        next.certPolicy = current.certPolicy;
        next.callPolicy = current.callPolicy;
        next.timeout = current.timeout;
        next.totalDeadlineUs = current.totalDeadlineUs;
        next.jar = current.jar;
        next.uploadProbe = current.uploadProbe;
        next.defaultHeaders = new List<string>();
        for (int hi = 0; hi < current.defaultHeaders.Count; hi = hi + 1) {
            string h = current.defaultHeaders[hi];
            if (next.IsRedirectHeader(h, sameOrigin, dropEntityHeaders)) {
                next.defaultHeaders.Add(h);
            }
        }
        return next;
    }

    // 字节通道（SendBytesAsync/UploadFileBytesAsync/下载）共用的
    // 重定向跟随循环。driver 在当前客户端上按给定方法发出一次请求并返回
    // 响应；本方法在拿到 3xx 时按 policy 解析绝对 Location、改写动作、
    // 跨 origin 清敏感头，并在派生的下一跳客户端上重放 driver。非 3xx
    // 原样返回。301/302/303 的动作改写同时把请求正文清空——字节通道
    // 的实体无法安全降级重放，下载驱动的 Range 语义由驱动端用 method
    // 参数表达。
    private async HttpResponse FollowBytesRedirects(string method, string path,
            string body, HttpBytesDriver driver) {
        this.ArmTotalBudget();
        HttpResponse resp = await driver(this, method, path, body);
        return await this.FollowBytesFromResponse(method, path, body, driver, resp);
    }

    private async HttpResponse FollowBytesFromResponse(string method, string path,
            string body, HttpBytesDriver driver, HttpResponse resp) {
        if (!this.RedirectWanted(resp, 0)) { return resp; }
        List<string> visited = new List<string>();
        string initial = this.CanonicalRequestTarget(path);
        if (initial.Length > 0) { visited.Add(initial); }
        HttpClient current = this;
        string currentMethod = method;
        // 最近一次请求的实际路径（不含 origin），相对 Location 按它解析。
        string currentPath = path;
        int hops = 0;
        while (current.RedirectWanted(resp, hops)) {
            int code = resp.statusCode;
            string location = resp.GetHeader("Location");
            if (HttpResponse.HasCrlf(location)) {
                current.DropAlive();
                throw new HttpRequestException(
                    "redirect Location header injection rejected");
            }
            // 相对引用按当前请求 URL 解析（与文本通道同一套规则）。
            string resolved = HttpClient.ResolveLocation(currentPath, location,
                current.useTls, current.host, current.port);
            ExternalTarget target = ExternalTarget.Parse(resolved);
            if (target == null || visited.Contains(target.Canonical())) {
                current.DropAlive();
                throw new HttpRequestException(
                    "redirect target is invalid or repeated");
            }
            visited.Add(target.Canonical());
            if (current.useTls && !target.IsTls()) {
                current.DropAlive();
                throw new HttpRequestException(
                    "insecure redirect: HTTPS to HTTP downgrade forbidden");
            }
            bool sameOrigin = current.RedirectHost() == target.Host()
                && current.port == target.Port()
                && current.useTls == target.IsTls();
            string nextMethod = "";
            if (!current.RedirectReplay(currentMethod, code, sameOrigin,
                    out nextMethod)) {
                current.DropAlive();
                throw new HttpRequestException("unsafe redirect replay");
            }
            bool dropEntityHeaders = nextMethod != currentMethod;
            if (current == this) { current.DropAlive(); }
            HttpClient next = current.RedirectNextClient(current, target,
                sameOrigin, dropEntityHeaders);
            // 动作改写（301/302/303 → GET）后字节通道的请求正文一律
            // 丢弃；下载通道的驱动端用同一 body 参数携带 Range 行为，
            // 改写后的 GET 原样续传（Range 不匹配时服务器返回 200
            // 全量，与"重定向后重新下载"一致）。
            string nextReq = nextMethod == currentMethod ? body : "";
            resp = await driver(next, nextMethod,
                target.Path() + target.Query(), nextReq);
            current = next;
            currentMethod = nextMethod;
            currentPath = target.Path() + target.Query();
            hops = hops + 1;
        }
        return resp;
    }
}
