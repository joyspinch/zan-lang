using System;

namespace System.Net.Http.Client;

public class Cookie {
    public string name;
    public string cookieValue;
    public string domain;
    public string path;
    public bool hostOnly;
    public bool secure;
    public bool httpOnly;
    public long expires;

    // 内部构造：域/路径等属性由 SetCookie 按 Set-Cookie 参数补齐。
    public Cookie(string name, string cookieValue) {
        this.name = name;
        this.cookieValue = cookieValue;
        this.domain = "";
        this.path = "/";
        this.hostOnly = true;
        this.secure = false;
        this.httpOnly = false;
        this.expires = 0;
    }

    // cookie 名。
    public string Name() { return this.name; }

    // cookie 值。
    public string Value() { return this.cookieValue; }

    // 生效域（小写）。
    public string Domain() { return this.domain; }

    // 生效路径。
    public string Path() { return this.path; }

    // 是否仅 HTTPS 通道外发。
    public bool Secure() { return this.secure; }

    // 是否标记 HttpOnly（防止客户端脚本通过 DOM 读取）。
    public bool HttpOnly() { return this.httpOnly; }

    // 过期时刻（Unix 秒），0 表示会话 cookie。
    public long Expires() { return this.expires; }
}
