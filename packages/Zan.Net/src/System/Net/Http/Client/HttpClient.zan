using System;
using System.IO;
using System.Net.Sockets;
using System.Net.Http;
using System.Net.Tls;
using System.Net.External;
using System.Threading;
using System.Diagnostics;

namespace System.Net.Http.Client;

// 取消探针：返回 true 表示调用方已经不要这个传输了。
// 见 <see cref="HttpClient.SetCancelProbe"/>。
public delegate bool HttpCancelFn();

// 上传进度探针：随字节上线推进（sentBytes/totalBytes）。
// 在传输所在的 worker 线程上回调，GUI 调用方需自行封送回 UI 线程。
// 见 <see cref="HttpClient.SetUploadProbe"/>。
public delegate void HttpUploadProgressFn(int sentBytes, int totalBytes);

// 内容编码解码器：按 Content-Encoding 的值解码响应正文（gzip /
// deflate 等）。返回 null 表示解码失败或不支持该编码。
// 见 <see cref="HttpClient.SetContentDecoder"/>。
public delegate byte[] HttpContentDecoder(string encoding, byte[] data);

// 字节通道的重定向驱动：在给定客户端上以指定方法发出一次
// 请求并返回响应。HttpClient 的字节重定向循环以它为回调在当前/下一跳
// 客户端上重放；方法由循环按 301/302/303 改写规则传入。
public async delegate HttpResponse HttpBytesDriver(HttpClient client, string method,
    string path, string body);

// HTTP 客户端，支持 GET、POST、PUT、DELETE，走纯 TCP 或 TLS
// （通过 CreateHttps / UseTls 使用 https）。
// <c>SetTimeout</c> 是强制性的，而非建议性的：连接阶段受
// 带截止时间轮询的非阻塞连接限制，发送/接收阶段受共享的
// <see cref="HttpDeadline"/> 清扫器限制，它对迟到的套接字执行挂起，使
// 挂起的协程被唤醒并报告超时。清扫器每秒运行一次，
// 因此有效粒度约 1 秒（30 秒超时会在 30 到 31 秒之间触发）
// ；<c>SetTimeout(0)</c> 完全禁用截止时间。
// 状态行可通过 <see cref="SendAsync"/> 获取，它返回
// 解析后的 <see cref="HttpResponse"/>；各动词辅助方法仍只返回
// 响应体。客户端不缓存上次响应的任何内容，因此单个
// 客户端可被多个协程同时使用。
// 连接复用：同一客户端串行的请求默认复用一条 keep-alive 连接
// （HTTP/1.1 持久连接），省去每个请求的三次握手；空闲连接被对端
// 回收时换新连接重试一次，对调用方不可见。同一时刻只允许一个
// 请求占用复用连接，并发请求各自走一次性 Connection: close 通道，
// 互不干扰。对端宣布 close、EOF 定界的响应、以及 <see cref="Close"/>
// 都会终结复用。<see cref="DisableKeepAlive"/> 可整体退回旧行为。
// 错误模型（三类 API，三种约定，调用前先认清用的是哪一类）：
// 1. 请求/动词方法（<see cref="SendAsync"/> 及 Get/Post 等动词）：
// 传输层失败一律抛 <see cref="HttpRequestException"/>——连接、TLS
// 握手、超时、响应中途断开都在其中。HTTP 状态本身不是错误：
// 到达的响应（含 4xx/5xx）正常返回，状态码由调用方检查。
// 2. 文件下载方法（<see cref="DownloadRangeToFileAsync"/> /
// <see cref="DownloadBinaryToFileAsync"/>）：不抛错，以负数哨兵
// 返回——-1 = 连接/握手失败或响应不完整（文本见
// <see cref="GetLastError"/>），-2 = 取消探针触发（已收字节保留，
// 可续传）；成功返回落盘字节数。
// 3. 探测路径（<see cref="SseSink"/> 系）：绝不抛错，每次尝试以
// "ok" 或 "err: ..." 标记结束，便于轮询方统一判别。
public partial class HttpClient : IDisposable {
    string host;
    int port;
    int timeout;
    bool useTls;
    bool verifyTls;
    string clientCertificateFile;
    string clientPrivateKeyFile;
    List<string> defaultHeaders;
    // 公钥固定：接受的服务器 SPKI SHA-256 固定值（base64）以及
    // 是否强制执行。正式版构建中强制保持开启；
    // 下面的开发开关在发布二进制中会被编译掉。
    List<string> tlsPins;
    bool pinningEnabled;
    // 证书策略：链/主机名校验不通过时逐连接裁决（见 SetCertPolicy）。
    CertPolicyFn certPolicy;
    // cookie 存储；null = 不参与 cookie（Set-Cookie 只留在响应头里）。
    CookieJar jar;
    // 取消探针；null = 不可取消（见 SetCancelProbe）。
    HttpCancelFn cancelProbe;
    // 上传进度探针；null = 不报进度（见 SetUploadProbe）。
    HttpUploadProgressFn uploadProbe;
    // 内容解码器；null = 不解码（见 SetContentDecoder）。没装解码器又
    // 碰上带 Content-Encoding 的响应时直接报错，不把压缩字节当正文。
    HttpContentDecoder contentDecoder;
    // 全局默认的内容解码器：逐个客户端装配太啰嗦时装一次。
    static HttpContentDecoder defaultContentDecoder;
    // 共享外部调用预算；null 使用兼容的客户端 timeout 行为。
    ExternalCallPolicy callPolicy;
    string lastDownloadError;
    // 跨跳共享的绝对总截止时间（Socket.NativeMonotonicUs() 时基，微秒）。
    // 0 = 未武装：无 policy 的客户端保持旧的"每跳各自 timeout"语义；
    // 绑定 policy 的客户端在公共入口武装一次，重定向每一跳继承同一
    // 时刻，阶段/总预算取总剩余时间的较小值——多跳链路、慢速滴流都
    // 无法把一次外呼拖过 policy 的 total。
    long totalDeadlineUs;
    // ---- keep-alive 连接复用（见 RequestAliveAsync）----
    HttpFramer ka;  // 非空 = 池中有一条空闲可复用的连接
    TcpClient kaConn;
    TlsStream kaTls;
    TlsContext kaCtx;
    bool kaBusy;  // 在途请求标志：并发请求退回一次性通道
    bool kaEnabled;
    HttpConnectionPool pool;
    string traceParent;

    [DllImport("crt")]
    private static extern nint fopen(string path, string mode);

    [DllImport("crt")]
    private static extern int fputs(string str, nint fp);

    [DllImport("crt")]
    private static extern int fclose(nint fp);

    // 上传/断点续传下载用的二进制安全文件 IO（字符串按长度跟踪，
    // 因此 fwrite/fread 移动原始字节，包括 NUL）。
    [DllImport("crt")]
    private static extern long fwrite(string buf, long size, long count, nint fp);

    [DllImport("crt")]
    private static extern long fread(byte[] buf, long size, long count, nint fp);

    [DllImport("crt")]
    private static extern int fseek(nint fp, int offset, int origin);

    [DllImport("crt")]
    private static extern int ftell(nint fp);

    // 为指定的主机和端口创建 HTTP 客户端。
    HttpClient(string host, int port) {
        this.host = host;
        this.port = port;
        this.timeout = 30000;
        this.useTls = false;
        this.verifyTls = true;
        this.clientCertificateFile = "";
        this.clientPrivateKeyFile = "";
        this.defaultHeaders = new List<string>();
        this.tlsPins = null;
        this.pinningEnabled = false;
        this.certPolicy = null;
        this.jar = null;
        this.cancelProbe = null;
        this.callPolicy = null;
        this.lastDownloadError = "";
        this.totalDeadlineUs = 0;
        this.ka = null;
        this.kaConn = null;
        this.kaTls = null;
        this.kaCtx = null;
        this.kaBusy = false;
        this.kaEnabled = true;
        this.pool = HttpConnectionPool.CreateDefault();
        this.traceParent = "";
    }

    // 为指定的主机和端口创建 HTTPS 客户端。
    public static HttpClient CreateHttps(string host, int port) {
        HttpClient client = new HttpClient(host, port);
        client.useTls = true;
        return client;
    }

    // 为此客户端启用 TLS（https）。
    public HttpClient UseTls() {
        this.useTls = true;
        return this;
    }

    // 禁用服务器证书校验（仅用于开发/
    // 自签名服务器）。
    public HttpClient DisableTlsVerify() {
        this.verifyTls = false;
        return this;
    }

    // 设置证书策略：链/主机名校验不通过（verify_result
    // != 0）时以 (verifyResult, 对端证书文本) 调用，返回 true 放行
    // 本次连接，false 拒绝（拒绝原因带证书文本）。校验本身不关——
    // 与 DisableTlsVerify 的整体放开不同，每个连接都过策略，
    // 典型用途是老系统缺根证书时按已知签发者（GlobalSign/
    // Certum 签发的 Alibaba 证书）放行。
    public HttpClient SetCertPolicy(CertPolicyFn fn) {
        this.certPolicy = fn;
        return this;
    }

    // 客户端 TLS 上下文（客户端证书/策略统一在此挂上）。
    public TlsContext ClientTlsContext() {
        TlsContext ctx;
        if (this.clientCertificateFile.Length > 0
            && this.clientPrivateKeyFile.Length > 0) {
            ctx = TlsContext.CreateClientWithCertificate(
                this.clientCertificateFile, this.clientPrivateKeyFile);
        } else {
            ctx = TlsContext.CreateClient();
        }
        if (ctx != null && this.certPolicy != null) {
            ctx.SetCertPolicy(this.certPolicy);
        }
        return ctx;
    }

    // 为此客户端启用 cookie：响应里的 Set-Cookie 被存下来，
    // 后续请求按域名/路径/Secure 规则自动带上 Cookie 头。调用方自己用
    // <see cref="SetHeader"/> 写的 Cookie 头优先，存储不会覆盖它。
    public HttpClient UseCookies() {
        if (this.jar == null) { this.jar = new CookieJar(); }
        return this;
    }

    // 本客户端的 cookie 存储，未启用时为 null。
    public CookieJar Cookies() {
        return this.jar;
    }

    // 装上取消探针：长下载在每收到一块正文后问它一次，
    // 返回 true 就在块边界收工。传 null 取消装配。
    // 探针在驱动请求的那个线程上被调用（下载跑在工作线程时就是工作
    // 线程），因此它只应读一个共享标志，不要在里面做别的事。已落盘的
    // 字节会保留，下一次调用同一个 <see cref="DownloadBinaryToFileAsync"/>
    // 会用 Range 从断点续下。
    public HttpClient SetCancelProbe(HttpCancelFn f) {
        this.cancelProbe = f;
        return this;
    }

    // 安装上传进度探针：请求正文（头部、文件分块、尾部）
    // 每上线一段就回调一次（sentBytes/totalBytes，二者与
    // Content-Length 取自同一处）。探针在驱动请求的线程上被调用
    // （上传跑在工作线程时就是工作线程），只应更新共享进度并封送
    // 回 UI，不要在里面做别的事。目前 <see cref="UploadFileBytesAsync"/>
    // 汇报进度；其余请求不装探针。
    public HttpClient SetUploadProbe(HttpUploadProgressFn f) {
        this.uploadProbe = f;
        return this;
    }

    // 装上内容解码器：响应带 Content-Encoding（gzip / deflate 等）时，
    // 客户端把正文解码后再交给调用方，解码后的正文长度与内容才是
    // 调用方看到的那一份。
    //
    // 解码器是**注入**的：gzip/deflate 的编解码实现住在压缩包里，
    // 网络包不能硬依赖压缩包——压缩包不装，网络包就连带编译不过。
    // 压缩包提供现成的桥，装上即可：
    //     http.SetContentDecoder(System.IO.Compression.ContentCoding.Decode);
    //
    // 没装解码器又碰上带编码的响应时**直接报错**，不把压缩字节当正文
    // 悄悄返回——那样调用方拿到的是一堆乱码，却没有任何提示。
    public HttpClient SetContentDecoder(HttpContentDecoder fn) {
        this.contentDecoder = fn;
        return this;
    }

    // 全局默认的内容解码器：应用里客户端很多、逐个装配太啰嗦时在这里
    // 装一次，没有单独设置解码器的客户端都用它。单个客户端的
    // SetContentDecoder 优先。
    public static void SetDefaultContentDecoder(HttpContentDecoder fn) {
        HttpClient.defaultContentDecoder = fn;
    }

    // 本客户端实际使用的解码器（自己的优先，其次全局默认）。
    HttpContentDecoder Decoder() {
        if (this.contentDecoder != null) { return this.contentDecoder; }
        return HttpClient.defaultContentDecoder;
    }

    // 拆分 Content-Encoding 的取值：可能是逗号分隔的多段
    // （"gzip, br"——按发送顺序逐层编码）。空段丢掉。
    static List<string> SplitCodings(string header) {
        List<string> out2 = new List<string>();
        if (header == null) { return out2; }
        int pos = 0;
        int len = header.Length;
        while (pos <= len) {
            int comma = header.IndexOf(",", pos);
            int stop = comma < 0 ? len : comma;
            string one = header.Substring(pos, stop - pos).Trim().ToLower();
            if (one.Length > 0) { out2.Add(one); }
            if (comma < 0) { break; }
            pos = comma + 1;
        }
        return out2;
    }

    // 按 Content-Encoding 解码响应正文。没有编码、或响应本来就没有
    // 正文（1xx/204/304）时原样返回。
    //
    // 编码是**按发送顺序逐层套上去**的，解码要反过来：先解最后一层。
    // 解码器没装 → 报错并说清缺什么；解码失败（返回 null）→ 报错。
    // 两种情况都不把压缩字节当正文交出去。
    HttpResponse ApplyContentEncoding(HttpResponse resp) {
        if (resp == null) { return resp; }
        int status = resp.statusCode;
        if (status >= 100 && status < 200) { return resp; }
        if (status == 204 || status == 304) { return resp; }
        string header = resp.GetHeader("Content-Encoding");
        List<string> codings = HttpClient.SplitCodings(header);
        if (codings.Count == 0) { return resp; }
        bool identityOnly = true;
        for (int i = 0; i < codings.Count; i = i + 1) {
            if (codings[i] != "identity") { identityOnly = false; }
        }
        if (identityOnly) { return resp; }
        // 没有正文就没有可解码的东西（HEAD 响应、空正文 200 都属这类）。
        // 此时不报错——一个"空的 gzip 正文"和"根本没发正文"在线路上
        // 分不开，硬解只会得到一个假失败。
        if (resp.body == null || resp.body.Length == 0) { return resp; }
        HttpContentDecoder decoder = this.Decoder();
        if (decoder == null) {
            throw new HttpRequestException("response is " + header
                + "-encoded but no content decoder is configured");
        }
        bool wasBinary = resp.IsBinary();
        byte[] cur = resp.body.ToBytes();
        for (int i = codings.Count - 1; i >= 0; i = i - 1) {
            string coding = codings[i];
            if (coding == "identity") { continue; }
            byte[] decoded = decoder(coding, cur);
            if (decoded == null) {
                throw new HttpRequestException("failed to decode "
                    + coding + "-encoded response body");
            }
            cur = decoded;
        }
        resp.body = cur.ToStr(0, cur.Length);
        if (wasBinary) {
            resp.bodyBytes = cur;
            resp.bodyBytesLen = cur.Length;
        } else {
            resp.bodyBytes = null;
            resp.bodyBytesLen = 0;
        }
        resp.contentDecoded = true;
        resp.contentEncoding = header.Trim().ToLower();
        return resp;
    }

    // 探针非空时上报一次进度；装探针的调用点在发送循环里，成本只有
    // 一次空判 + 一次委托调用。对 >2GB 上传安全钳制在 32 位上限，防溢出。
    void UploadTick(long sentBytes, long totalBytes) {
        if (this.uploadProbe != null) {
            int sent = sentBytes > 2147483647 ? 2147483647 : (int)sentBytes;
            int total = totalBytes > 2147483647 ? 2147483647 : (int)totalBytes;
            this.uploadProbe(sent, total);
        }
    }

    // 最近一次二进制下载失败的阶段诊断；成功或尚未下载时为空。
    string LastDownloadError() {
        return this.lastDownloadError;
    }

    // 更新 LastDownloadError 报告的阶段诊断。
    void SetDownloadError(string error) {
        this.lastDownloadError = error;
    }

    // 探针是否要求收工（没装探针时恒为 false）。
    bool CancelRequested() {
        if (this.cancelProbe == null) { return false; }
        return this.cancelProbe();
    }

    // 固定一个受信任的服务器公钥：其 DER SubjectPublicKeyInfo 的
    // base64 SHA-256 值。一旦设置了任意固定值，握手就会拒绝
    // 公钥不匹配任何固定值的服务器，即使其证书
    // 本可被系统信任——从而阻止 MITM 代理。调用两次可为轮换
    // 固定一个备用密钥。
    public HttpClient PinPublicKey(string spkiSha256Base64) {
        if (this.tlsPins == null) { this.tlsPins = new List<string>(); }
        this.tlsPins.Add(spkiSha256Base64);
        this.pinningEnabled = true;
        this.useTls = true;
        return this;
    }

    // 仅开发用的应急通道，放宽固定限制，使本地
    // 代理或自签名开发服务器可用。由 ZAN_DEV 保护，因此发布
    // 构建会将其编译掉并始终强制执行已配置的固定值。
    public HttpClient DisablePinning() {
        #if ZAN_DEV
        this.pinningEnabled = false;
        #endif
        return this;
    }

    // 将已配置的固定值复制到新建的客户端上下文上并
    // 启用强制。当固定被禁用或未配置时不执行任何操作。
    void ApplyPinning(TlsContext ctx) {
        if (!this.pinningEnabled || this.tlsPins == null) { return; }
        for (int i = 0; i < this.tlsPins.Count; i = i + 1) {
            ctx.AddPin(this.tlsPins[i]);
        }
        ctx.RequirePinning(true);
    }

    // 配置 PEM 证书链和匹配的 PEM 私钥，
    // 用于双向 TLS 客户端认证。
    public HttpClient SetClientCertificate(string certFile, string keyFile) {
        this.clientCertificateFile = certFile;
        this.clientPrivateKeyFile = keyFile;
        this.useTls = true;
        return this;
    }

    // 为所有请求添加默认头。名字或值含 CR/LF/NUL/DEL
    // （会注入额外头字段或提前结束头部）、或名字含冒号（可夹带出
    // 第二个头字段）时不添加——与 HttpResponse.SetHeader 同一防线。
    public HttpClient SetHeader(string name, string headerValue) {
        if (!HttpResponse.IsValidHeader(name, headerValue)) { return this; }
        string lower = name.ToLower();
        // 请求头与分块传输帧由 BuildRequestHead 生成，调用方可覆盖连接模式。
        if (lower == "content-length" || lower == "transfer-encoding"
            || lower == "connection" || lower == "host") { return this; }
        this.defaultHeaders.Add(name + ": " + headerValue);
        return this;
    }

    // 设置请求超时时间（毫秒）：连接阶段和
    // 请求/响应阶段各有独立的窗口。小于等于 0
    // 则禁用超时（协程会一直等待对端
    // ，永无返回）。
    public HttpClient SetTimeout(int ms) {
        this.timeout = ms;
        return this;
    }

    // 绑定统一外部调用预算。连接/读写仍复用现有 HTTP
    // 实现；请求/响应大小和重试能力由调用方按 policy 显式声明。
    public HttpClient SetCallPolicy(ExternalCallPolicy policy) {
        this.callPolicy = policy;
        if (policy != null) {
            this.timeout = policy.TotalTimeoutMs();
        }
        // 新策略立刻生效：丢掉上一策略武装的总截止时间，下一次请求
        // 按新 total 重新武装。
        this.totalDeadlineUs = 0;
        return this;
    }

    // 当前外部调用预算；未绑定时返回 null。
    ExternalCallPolicy CallPolicy() {
        return this.callPolicy;
    }

    // 绑定 policy 后，目标必须在建连前通过同一个 URL/地址策略；
    // 这样图片、下载、上传和 AI 即使误用了裸 host API，也不会绕过
    // ExternalTargetPolicy。DNS 多地址复核仍由 socket 层继续补齐。
    // 不允许时抛 HttpRequestException。
    void CheckTargetPolicy() {
        if (this.callPolicy == null) { return; }
        bool ok = ExternalTargetPolicy.IsClientAllowed(this.host, this.port,
            this.useTls, this.callPolicy.AllowsLoopback(),
            this.callPolicy.AllowsHttp(), this.callPolicy.LocalHttpOnly());
        if (!ok) {
            throw new HttpRequestException("external target is not allowed: "
                + this.host + ":" + Convert.ToString(this.port));
        }
    }

    // 绑定 policy 后，正文在建连前按统一 max request bytes 拒绝，
    // 避免副作用请求已经上线。超限时抛 HttpRequestException。
    void CheckRequestLimit(long bodyBytes) {
        if (this.callPolicy == null) { return; }
        long limit = (long)this.callPolicy.MaxRequestBytes();
        if (limit > 0 && bodyBytes > limit) {
            throw new HttpRequestException(
                "request body exceeds " + Convert.ToString(limit) + " bytes");
        }
    }

    // HttpFramer 的响应正文上限：无 policy 时沿用此前的 64 MiB，
    // 有 policy 时由调用方显式预算覆盖。
    int ResponseLimit() {
        if (this.callPolicy == null) { return 67108864; }
        int limit = this.callPolicy.MaxResponseBytes();
        if (limit > 0) { return limit; }
        return 67108864;
    }

    // 将阶段预算与总预算取较小值。返回值 <= 0 表示该阶段不设截止时间；
    // policy 的四类 timeout 因而不会再被 SetCallPolicy 的 total 值静默覆盖。
    // totalDeadlineUs 已武装时，阶段预算还要再与"总剩余时间"取较小值：
    // 重定向每一跳继承同一个绝对时刻，任何通道都无法超出共享 total。
    int BudgetMin(int phaseMs) {
        if (this.callPolicy == null) { return this.timeout; }
        int total = this.callPolicy.TotalTimeoutMs();
        if (phaseMs > 0 && total > 0) { phaseMs = phaseMs < total ? phaseMs : total; }
        else if (phaseMs <= 0) { phaseMs = total; }
        if (this.totalDeadlineUs > 0 && phaseMs > 0) {
            long remainMs = (this.totalDeadlineUs - Socket.NativeMonotonicUs())
                / 1000;
            if (remainMs < 1) { remainMs = 1; }
            if (phaseMs > remainMs) { phaseMs = (int)remainMs; }
        }
        return phaseMs;
    }

    // 绑定 policy 后的连接阶段预算；未绑定时退回客户端 timeout。
    int ConnectBudget() {
        if (this.callPolicy == null) { return this.timeout; }
        return this.BudgetMin(this.callPolicy.ConnectTimeoutMs());
    }
    // 绑定 policy 后的写阶段预算；未绑定时退回客户端 timeout。
    int WriteBudget() {
        if (this.callPolicy == null) { return this.timeout; }
        return this.BudgetMin(this.callPolicy.WriteTimeoutMs());
    }
    // 绑定 policy 后的读阶段预算；未绑定时退回客户端 timeout。
    int ReadBudget() {
        if (this.callPolicy == null) { return this.timeout; }
        return this.BudgetMin(this.callPolicy.ReadTimeoutMs());
    }
    // 绑定 policy 后的流式空闲窗口预算（SSE/下载逐块续期）；未绑定时退回客户端 timeout。
    int IdleBudget() {
        if (this.callPolicy == null) { return this.timeout; }
        return this.BudgetMin(this.callPolicy.IdleTimeoutMs());
    }
    // TLS 握手预算，与连接阶段共用同一档。
    int HandshakeBudget() {
        return this.ConnectBudget();
    }
    // 绑定 policy 后的总预算（已扣除总截止时间的已耗部分）；
    // 未绑定时返回 0（表示无总截止）。
    int TotalBudget() {
        if (this.callPolicy == null) { return 0; }
        int total = this.callPolicy.TotalTimeoutMs();
        if (this.totalDeadlineUs > 0 && total > 0) {
            long remainMs = (this.totalDeadlineUs - Socket.NativeMonotonicUs())
                / 1000;
            if (remainMs < 1) { remainMs = 1; }
            if (total > remainMs) { total = (int)remainMs; }
        }
        return total;
    }

    // 武装（或重置）跨跳共享的绝对总截止时间。绑定 policy 的请求通道
    // 入口调用；total <= 0 时不武装，保持该通道各自预算的旧行为。
    // 已武装时不重置：一次外呼（含 UploadFileBytesAsync 先行武装、
    // 通道随后调用）从第一跳起点计时，重定向各跳继承同一时刻。
    void ArmTotalBudget() {
        if (this.callPolicy == null) {
            this.totalDeadlineUs = 0;
            return;
        }
        if (this.totalDeadlineUs > 0) { return; }
        int total = this.callPolicy.TotalTimeoutMs();
        this.totalDeadlineUs = total > 0
            ? Socket.NativeMonotonicUs() + total * 1000L
            : 0;
    }

    // 每个公共入口重新武装；只有内部重定向跳数继承已有截止时间。
    void ResetTotalBudget() {
        this.totalDeadlineUs = 0;
        this.ArmTotalBudget();
    }

    // 关闭复用的 keep-alive 连接（若在）。客户端仍可继续
    // 使用：下一次请求会重新建立连接。进程退出前或长寿命客户端
    // 空闲时调用，避免悬挂的半开连接。
    public void Close() {
        this.DropAlive();
        if (this.pool != null) { this.pool.CloseAll(); }
    }

    public void Dispose() {
        this.Close();
    }

    // 禁用连接复用：每个请求各建一条连接并在响应后关闭
    // （与旧版行为一致）。返回自身以便链式调用。
    public HttpClient DisableKeepAlive() {
        this.kaEnabled = false;
        this.DropAlive();
        if (this.pool != null) { this.pool.CloseAll(); }
        return this;
    }

    // 丢弃池中的连接。连接可能已被对端半关或处于错误状态，
    // 因此四个句柄都要收干净；幂等，可在任何时候调用。
    void DropAlive() {
        if (this.ka != null) { this.ka.Dispose(); }
        this.ka = null;
        if (this.kaTls != null) { this.kaTls.Close(); }
        this.kaTls = null;
        if (this.kaConn != null) { this.kaConn.Close(); }
        this.kaConn = null;
        if (this.kaCtx != null) { this.kaCtx.Free(); }
        this.kaCtx = null;
        if (this.pool != null) { this.pool.CloseAll(); }
    }

    // 配置底层弹性连接池规格与生命周期参数。
    public HttpClient SetConnectionPool(int maxConnections, int maxIdleConnections, long idleTimeoutMs, long maxLifetimeMs) {
        if (this.pool == null) {
            this.pool = new HttpConnectionPool(maxConnections, maxIdleConnections, idleTimeoutMs, maxLifetimeMs);
        } else {
            this.pool.SetLimits(maxConnections, maxIdleConnections, idleTimeoutMs, maxLifetimeMs);
        }
        return this;
    }

    // 获取底层连接池实例。
    public HttpConnectionPool ConnectionPool() {
        return this.pool;
    }

    // 设置出站分布式链路追踪 traceparent 头部。
    public HttpClient SetTraceParent(string tp) {
        this.traceParent = tp != null ? tp : "";
        return this;
    }

    // 获取当前配置的出站 traceparent 头部。
    public string TraceParent() {
        return this.traceParent;
    }

    // 当 <see cref="SetHeader"/> 已提供过一个名字
    // （ASCII 大小写不敏感）匹配的头部时返回 true。这样 BuildRequest 可以只保留
    // 调用者自选的 Content-Type，而非总是强制表单编码。
    bool HasHeaderName(string name) {
        int nlen = name.Length;
        for (int i = 0; i < this.defaultHeaders.Count; i = i + 1) {
            string h = this.defaultHeaders[i];
            // "Name: value" —— 名字后必须紧跟冒号。
            if (h.Length > nlen && (h[nlen] & 255) == 58
                && HttpClient.AsciiNameEquals(h, name, nlen)) {
                return true;
            }
        }
        return false;
    }

    // 将 <paramref name="hay"/> 的前 <paramref name="n"/> 个字节与 <paramref name="name"/> 做
    // ASCII 大小写不敏感的相等比较。
    private static bool AsciiNameEquals(string hay, string name, int n) {
        for (int i = 0; i < n; i = i + 1) {
            int a = hay[i] & 255;
            int b = name[i] & 255;
            if (a >= 65 && a <= 90) { a = a + 32; }
            if (b >= 65 && b <= 90) { b = b + 32; }
            if (a != b) { return false; }
        }
        return true;
    }

    // 构建原始 HTTP/1.1 请求文本。<paramref name="close"/> 选择帧结构：
    // true 发 Connection: close 并读至对端关闭（读至 EOF 的调用方）；
    // false 发 Connection: keep-alive，供连接复用路径使用。
    // 请求头部半区：请求行 + Host + 默认头 + Content-Length +
    // Cookie + Connection + 空行。bodyLen <= 0 时不写 Content-Length，
    // 与旧 BuildRequest 的空正文行为一致。二进制正文的调用方
    // （SendBytesBodyAsync/SendBytesBodyTlsAsync）拿到头部后把
    // 文件字节单独按显式长度发送。
    // 请求目标（request-target）是否可安全写入请求行：CR/LF/NUL/DEL
    // 会把一行撕成两行（请求行注入/第二个请求），空格会把请求行切成
    // 多个 token。SetHeader 有同一防线；请求行是调用方字符串进入
    // 报文的另一入口，不能漏。
    private static bool IsRequestTargetSafe(string path) {
        if (path == null || path.Length == 0) { return false; }
        for (int i = 0; i < path.Length; i = i + 1) {
            int c = path[i] & 255;
            if (c <= 32 || c >= 127) { return false; }
        }
        return true;
    }

    private static bool IsMethodSafe(string method) {
        if (method == null || method.Length == 0) { return false; }
        return HttpResponse.HeaderFramingSafe(true, method);
    }

    private static bool IsHostSafe(string host) {
        if (host == null || host.Length == 0) { return false; }
        for (int i = 0; i < host.Length; i = i + 1) {
            int c = host[i] & 255;
            if (c <= 32 || c >= 127 || c == 47 || c == 92 || c == 64) {
                return false;
            }
        }
        return true;
    }

    // 构建请求头部半区；bodyLen<=0 时不写 Content-Length。支持 64 位大请求体。
    string BuildRequestHead(string method, string path, long bodyLen,
                            bool close) {
        if (!HttpClient.IsMethodSafe(method) || !HttpClient.IsHostSafe(this.host)
            || !HttpClient.IsRequestTargetSafe(path)) {
            throw new HttpRequestException("invalid HTTP method, host or request target");
        }
        StringBuilder sb = new StringBuilder();
        sb.Append(method);
        sb.Append(" ");
        sb.Append(path);
        sb.Append(" HTTP/1.1\r\n");
        if (!this.HasHeaderName("Host")) {
            sb.Append("Host: ");
            sb.Append(this.host);
            if ((this.useTls && this.port != 443) || (!this.useTls && this.port != 80)) {
                sb.Append(":");
                sb.Append(this.port);
            }
            sb.Append("\r\n");
        }

        for (int i = 0; i < this.defaultHeaders.Count; i = i + 1) {
            sb.Append(this.defaultHeaders[i]);
            sb.Append("\r\n");
        }

        // 策略声明了幂等键、而调用方没自己设置该头时，把它发出去。
        // 不发出去的话服务端无从按键去重，"可重试"也就没有幂等前提
        // ——策略里的键只是本地的一个标记。
        if (this.callPolicy != null && this.callPolicy.IsIdempotent()
            && !this.HasHeaderName("Idempotency-Key")) {
            sb.Append("Idempotency-Key: ");
            sb.Append(this.callPolicy.IdempotencyKey());
            sb.Append("\r\n");
        }

        if (bodyLen > 0) {
            sb.Append("Content-Length: ");
            sb.Append(bodyLen);
            sb.Append("\r\n");
            // 仅当调用者尚未设置 Content-Type 时才使用
            if (!this.HasHeaderName("Content-Type")) {
                sb.Append("Content-Type: application/x-www-form-urlencoded\r\n");
            }
        }

        if (this.jar != null && !this.HasHeaderName("Cookie")) {
            string cookies = this.jar.HeaderValue(this.host, path, this.useTls);
            if (cookies.Length > 0) {
                sb.Append("Cookie: ");
                sb.Append(cookies);
                sb.Append("\r\n");
            }
        }

        if (close) {
            sb.Append("Connection: close\r\n");
        } else {
            sb.Append("Connection: keep-alive\r\n");
        }

        if (!this.HasHeaderName("traceparent")) {
            string tp = this.traceParent;
            if (tp == null || tp.Length == 0) {
                if (Activity.Current != null) {
                    tp = Activity.Current.ToTraceParent();
                }
            }
            if (tp != null && tp.Length > 0) {
                sb.Append("traceparent: ");
                sb.Append(tp);
                sb.Append("\r\n");
            }
        }
        sb.Append("\r\n");
        return sb.ToString();
    }

    // BuildRequestHead 加上文本正文（一次性通道用）。
    string BuildRequest(string method, string path, string body, bool close) {
        string head = this.BuildRequestHead(method, path, body.Length, close);
        if (body.Length > 0) {
            return head + body;
        }
        return head;
    }

    // 下载请求沿用统一 method/host/path/header 注入校验，只额外插入
    // Range 字段；Range 不从调用方原文拼接进请求行，支持 64 位大文件断点。
    string BuildDownloadRequest(string path, long have) {
        string head = this.BuildRequestHead("GET", path, 0, true);
        if (have <= 0) { return head; }
        int end = head.Length - 2;
        return head.Substring(0, end) + "Range: bytes="
            + Convert.ToString(have) + "-\r\n\r\n";
    }

    // 把响应里的 Set-Cookie 交给存储。未启用 cookie 时什么都不做，
    // 所以调用点不必自己判空。
    void AbsorbCookies(string path, string raw) {
        if (this.jar == null) { return; }
        this.jar.AbsorbHead(this.host, path, raw);
    }

    // 报告连接失败，区分被拒绝的连接与超时耗尽的截止时间。
    void FailConnect() {
        if (TcpClient.LastConnectTimedOut()) {
            throw new HttpRequestException("Connect to " + this.host + ":"
                + Convert.ToString(this.port) + " timed out after "
                + Convert.ToString(this.timeout) + "ms");
        }
        throw new HttpRequestException("Could not connect to " + this.host
            + ":" + Convert.ToString(this.port));
    }

    // 报告请求截止时间耗尽（清扫器已挂起
    // 套接字，这结束了调用者的读取循环）。
    void FailTimeout() {
        throw new HttpRequestException("Request to " + this.host + ":"
            + Convert.ToString(this.port) + " timed out after "
            + Convert.ToString(this.timeout) + "ms");
    }

    // 单次 DNS 解析并在 TcpClient 中遍历 A/AAAA 记录尝试连接。
    async TcpClient ConnectTarget() {
        // 保持旧版 host/port 构造函数与本地测试服务器兼容。
        bool allowLoopback = this.callPolicy == null
            || this.callPolicy.AllowsLoopback();
        return await TcpClient.ConnectAsync(this.host, this.port,
            this.ConnectBudget(), allowLoopback);
    }

    // 执行请求并按策略逐跳处理重定向。默认策略的跳数为 0，
    // 因而返回原始 3xx；显式启用时只接受绝对 HTTP(S) Location。
    // 相对 Location 和循环会拒绝；到达显式跳数上限时返回当前 3xx，
    // 不会猜测另一个目标，也不会继续发出请求。逐跳规则（跳数/防环/
    // 动作改写/下一跳派生）与字节通道共用同一组 helper
    async string RequestAsync(string method, string path, string body) {
        this.ResetTotalBudget();
        string raw = await this.RequestOnceWithRetry(method, path, body);
        if (this.callPolicy == null || this.callPolicy.MaxRedirects() <= 0) {
            return raw;
        }
        List<string> visited = new List<string>();
        string initial = this.CanonicalRequestTarget(path);
        if (initial.Length > 0) { visited.Add(initial); }
        HttpClient current = this;
        string currentMethod = method;
        string currentBody = body;
        // 最近一次请求的实际路径（不含 origin），相对 Location 按它解析。
        string currentPath = path;
        int hops = 0;
        while (true) {
            HttpResponse response = HttpResponse.Parse(raw);
            if (!this.RedirectWanted(response, hops)) { return raw; }
            int code = response.statusCode;
            string location = response.GetHeader("Location");
            if (HttpResponse.HasCrlf(location)) {
                current.DropAlive();
                throw new HttpRequestException(
                    "redirect Location header injection rejected");
            }
            // Location 可能是相对引用（RFC 3986 §4.2）：按当前请求
            // 的 URL 解析成绝对地址再走同一套目标校验。
            string resolved = HttpClient.ResolveLocation(currentPath, location,
                current.useTls, current.host, current.port);
            ExternalTarget target = ExternalTarget.Parse(resolved);
            if (target == null || visited.Contains(target.Canonical())) {
                current.DropAlive();
                throw new HttpRequestException(
                    "redirect target is invalid or repeated");
            }
            visited.Add(target.Canonical());
            bool sameOrigin = current.RedirectHost() == target.Host()
                && current.port == target.Port()
                && current.useTls == target.IsTls();
            string nextMethod = "";
            if (!current.RedirectReplay(currentMethod, code, sameOrigin,
                    out nextMethod)) {
                current.DropAlive();
                throw new HttpRequestException("unsafe redirect replay");
            }
            bool dropEntityHeaders = nextMethod != currentMethod;
            if (current == this) { current.DropAlive(); }
            HttpClient next = current.RedirectNextClient(current, target,
                sameOrigin, dropEntityHeaders);
            // 动作改写（301/302/303 → GET）后请求正文一律丢弃。
            string nextBody = nextMethod == currentMethod ? currentBody : "";
            raw = await next.RequestOnceWithRetry(nextMethod,
                target.Path() + target.Query(), nextBody);
            current = next;
            currentMethod = nextMethod;
            currentBody = nextBody;
            currentPath = target.Path() + target.Query();
            hops = hops + 1;
        }
    }

    // RFC 3986 §5.3：把 Location 按"当前请求 URL"解析成绝对 URL。
    // basePath 是最近一次请求的路径（含 query），scheme/host/port 取自
    // 当前客户端。片段（#）不随请求发送，先剥掉。
    //
    // 绝对地址原样返回；其余按引用类型拼接：
    //   //host/path  → scheme 相对（继承 scheme，换 authority）
    //   /path        → 同 origin 的绝对路径
    //   ?query       → 同 path，换 query
    //   path         → 相对当前 path 的最后一段之前拼接
    // 解析结果仍要过 ExternalTarget.Parse 的同一套校验（scheme 白名单、
    // 主机名合法性、端口范围），所以这里不放松任何安全边界。
    static string ResolveLocation(string basePath, string location,
            bool useTls, string host, int port) {
        if (location == null) { return null; }
        string loc = location;
        int hash = loc.IndexOf("#");
        if (hash >= 0) { loc = loc.Substring(0, hash); }
        if (loc.Length == 0) { return null; }
        if (loc.StartsWith("http://") || loc.StartsWith("https://")) {
            return loc;
        }
        string scheme = useTls ? "https" : "http";
        string authority = host;
        int defaultPort = useTls ? 443 : 80;
        if (port != defaultPort) {
            authority = authority + ":" + Convert.ToString(port);
        }
        if (loc.StartsWith("//")) { return scheme + ":" + loc; }
        string origin = scheme + "://" + authority;
        if (loc.StartsWith("/")) { return origin + loc; }
        string baseUri = basePath == null || basePath.Length == 0 ? "/" : basePath;
        int bq = baseUri.IndexOf("?");
        if (bq >= 0) { baseUri = baseUri.Substring(0, bq); }
        if (loc.StartsWith("?")) { return origin + baseUri + loc; }
        // 相对路径：取 base 最后一个 "/" 之前的目录做前缀。
        int cut = baseUri.LastIndexOf("/");
        string dir = cut >= 0 ? baseUri.Substring(0, cut + 1) : "/";
        return origin + dir + loc;
    }

    // 本客户端 host 的小写形式，剥掉 IPv6 字面量的方括号；
    // 与 ExternalTarget.Host() 比较重定向是否同源。
    string RedirectHost() {
        string h = this.host.ToLower();
        if (h.StartsWith("[") && h.EndsWith("]")) {
            return h.Substring(1, h.Length - 2);
        }
        return h;
    }

    // 本客户端当前请求目标的规范 URL（scheme://host[:port]/path），
    // 供重定向防环的 visited 集合使用；解析失败返回 ""。
    string CanonicalRequestTarget(string requestPath) {
        string authority = this.host;
        if (authority.IndexOf(":") >= 0 && !authority.StartsWith("[")) {
            authority = "[" + authority + "]";
        }
        string scheme = this.useTls ? "https" : "http";
        string url = scheme + "://" + authority;
        int defaultPort = this.useTls ? 443 : 80;
        if (this.port != defaultPort) {
            url = url + ":" + Convert.ToString(this.port);
        }
        if (requestPath == null || requestPath.Length == 0) {
            url = url + "/";
        } else {
            url = url + requestPath;
        }
        ExternalTarget t = ExternalTarget.Parse(url);
        if (t == null) { return ""; }
        return t.Canonical();
    }

    // 同下，默认不丢弃实体类头。
    bool IsRedirectHeader(string line, bool sameOrigin) {
        return this.IsRedirectHeader(line, sameOrigin, false);
    }

    // 重定向下一跳是否继承该默认头：Host/Range 永不继承；
    // dropEntity 时实体类头（Content-Length/Transfer-Encoding/Expect/
    // Content-Type/Content-Encoding/Content-MD5/Trailer）不继承；
    // 跨 origin 时敏感凭据头（Authorization/Cookie/Proxy-Authorization）
    // 不继承。
    bool IsRedirectHeader(string line, bool sameOrigin, bool dropEntity) {
        int colon = line.IndexOf(":");
        if (colon <= 0) { return false; }
        string name = line.Substring(0, colon).Trim().ToLower();
        if (name == "host" || name == "range") { return false; }
        if (dropEntity && (name == "content-length"
            || name == "transfer-encoding" || name == "expect"
            || name == "content-type" || name == "content-encoding"
            || name == "content-md5" || name == "trailer")) {
            return false;
        }
        if (!sameOrigin && (name == "authorization" || name == "cookie"
            || name == "proxy-authorization")) { return false; }
        return true;
    }

    // 下一跳是否值得继续跟随：响应必须是 3xx 重定向、policy
    // 已绑定且仍有跳数。Location 头的 CRLF 注入防线在这里统一落地：
    // 带折行的 Location 直接拒绝（与其传给 ExternalTarget.Parse 让它
    // 以文本校验失败，不如显式报注入拒绝）。
    bool RedirectWanted(HttpResponse response, int hops) {
        int code = response.statusCode;
        if (code != 301 && code != 302 && code != 303
            && code != 307 && code != 308) { return false; }
        if (this.callPolicy == null || this.callPolicy.MaxRedirects() <= 0) {
            return false;
        }
        return hops < this.callPolicy.MaxRedirects();
    }

    // 3xx 响应里的 307/308 重放守卫与 301/302/303 动作改写。
    // nextMethod 为改写结果；返回 false 表示该响应不允许自动重放
    // （调用方原样返回 3xx）。
    //
    // sameOrigin 只影响 307/308：这两种码按 RFC 9110 保留方法与请求
    // 正文，而重放正文等于把请求体再送一次——同源是同一个站点，跨源
    // 就是把数据交给另一个站点，与 Authorization/Cookie 跨源剥离是
    // 同一道防线，所以跨源的 307/308 仍然拒绝。
    bool RedirectReplay(string method, int code, bool sameOrigin,
            out string nextMethod) {
        nextMethod = method;
        if (code == 303) {
            if (method == "POST") {
                nextMethod = "GET";
            } else if (method != "GET" && method != "HEAD") {
                return false;
            }
        } else if ((code == 301 || code == 302)
            && method != "GET" && method != "HEAD") {
            if (method != "POST") { return false; }
            nextMethod = "GET";
        } else if ((code == 307 || code == 308)
            && method != "GET" && method != "HEAD") {
            if (!sameOrigin) { return false; }
        }
        return true;
    }

    // 为重定向的下一跳派生客户端：继承 TLS/验证/固定值/证书/
    // 策略/超时/cookie 与共享 totalDeadlineUs，按 sameOrigin 与动作改写
    // 过滤默认头。中转客户端是一次性连接（kaEnabled=false），池仍归
    // 发起客户端独有。
    HttpClient RedirectNextClient(HttpClient current, ExternalTarget target,
            bool sameOrigin, bool dropEntityHeaders) {
        HttpClient next = new HttpClient(target.Host(), target.Port());
        next.kaEnabled = false;
        next.useTls = target.IsTls();
        next.verifyTls = current.verifyTls;
        next.clientCertificateFile = current.clientCertificateFile;
        next.clientPrivateKeyFile = current.clientPrivateKeyFile;
        next.tlsPins = current.tlsPins;
        next.pinningEnabled = current.pinningEnabled;
        next.certPolicy = current.certPolicy;
        next.callPolicy = current.callPolicy;
        next.timeout = current.timeout;
        next.totalDeadlineUs = current.totalDeadlineUs;
        next.jar = current.jar;
        next.uploadProbe = current.uploadProbe;
        next.defaultHeaders = new List<string>();
        for (int hi = 0; hi < current.defaultHeaders.Count; hi = hi + 1) {
            string h = current.defaultHeaders[hi];
            if (next.IsRedirectHeader(h, sameOrigin, dropEntityHeaders)) {
                next.defaultHeaders.Add(h);
            }
        }
        return next;
    }

    // 字节通道（SendBytesAsync/UploadFileBytesAsync/下载）共用的
    // 重定向跟随循环。driver 在当前客户端上按给定方法发出一次请求并返回
    // 响应；本方法在拿到 3xx 时按 policy 解析绝对 Location、改写动作、
    // 跨 origin 清敏感头，并在派生的下一跳客户端上重放 driver。非 3xx
    // 原样返回。301/302/303 的动作改写同时把请求正文清空——字节通道
    // 的实体无法安全降级重放，下载驱动的 Range 语义由驱动端用 method
    // 参数表达。
    async HttpResponse FollowBytesRedirects(string method, string path,
            string body, HttpBytesDriver driver) {
        this.ArmTotalBudget();
        HttpResponse resp = await driver(this, method, path, body);
        return await this.FollowBytesFromResponse(method, path, body, driver, resp);
    }

    async HttpResponse FollowBytesFromResponse(string method, string path,
            string body, HttpBytesDriver driver, HttpResponse resp) {
        if (!this.RedirectWanted(resp, 0)) { return resp; }
        List<string> visited = new List<string>();
        string initial = this.CanonicalRequestTarget(path);
        if (initial.Length > 0) { visited.Add(initial); }
        HttpClient current = this;
        string currentMethod = method;
        // 最近一次请求的实际路径（不含 origin），相对 Location 按它解析。
        string currentPath = path;
        int hops = 0;
        while (current.RedirectWanted(resp, hops)) {
            int code = resp.statusCode;
            string location = resp.GetHeader("Location");
            if (HttpResponse.HasCrlf(location)) {
                current.DropAlive();
                throw new HttpRequestException(
                    "redirect Location header injection rejected");
            }
            // 相对引用按当前请求 URL 解析（与文本通道同一套规则）。
            string resolved = HttpClient.ResolveLocation(currentPath, location,
                current.useTls, current.host, current.port);
            ExternalTarget target = ExternalTarget.Parse(resolved);
            if (target == null || visited.Contains(target.Canonical())) {
                current.DropAlive();
                throw new HttpRequestException(
                    "redirect target is invalid or repeated");
            }
            visited.Add(target.Canonical());
            bool sameOrigin = current.RedirectHost() == target.Host()
                && current.port == target.Port()
                && current.useTls == target.IsTls();
            string nextMethod = "";
            if (!current.RedirectReplay(currentMethod, code, sameOrigin,
                    out nextMethod)) {
                current.DropAlive();
                throw new HttpRequestException("unsafe redirect replay");
            }
            bool dropEntityHeaders = nextMethod != currentMethod;
            if (current == this) { current.DropAlive(); }
            HttpClient next = current.RedirectNextClient(current, target,
                sameOrigin, dropEntityHeaders);
            // 动作改写（301/302/303 → GET）后字节通道的请求正文一律
            // 丢弃；下载通道的驱动端用同一 body 参数携带 Range 行为，
            // 改写后的 GET 原样续传（Range 不匹配时服务器返回 200
            // 全量，与"重定向后重新下载"一致）。
            string nextReq = nextMethod == currentMethod ? body : "";
            resp = await driver(next, nextMethod,
                target.Path() + target.Query(), nextReq);
            current = next;
            currentMethod = nextMethod;
            currentPath = target.Path() + target.Query();
            hops = hops + 1;
        }
        return resp;
    }

    // 发送 HTTP 请求并返回原始响应。当连接（或 TLS 握手）失败
    // 或请求未在超时内完成时，抛出
    // HttpRequestException。
    // 连接在请求文本构建之前建立，因此
    // 连接失败抛出时，本帧内没有存活的分配。
    // 默认走 keep-alive 复用通道（同一客户端同时只允许一个在途
    // 请求）；已有请求在途时，并发调用退回一次性 Connection: close
    // 通道，各自读到对端关闭为止。
    void ValidateTextResponse(string raw, string method) {
        int end = HttpClient.IndexOf(raw, "\r\n\r\n", 0);
        if (end < 0) {
            throw new HttpRequestException("connection closed before a response arrived");
        }
        string head = raw.Substring(0, end + 4);
        int code = HttpClient.HeadStatus(head);
        if (code < 100) {
            throw new HttpRequestException("invalid response status line");
        }
        HttpResponse frame = HttpResponse.Parse(head);
        if (frame.statusCode < 100 || !frame.ParseFraming()) {
            throw new HttpRequestException("response framing malformed");
        }
        if (method == "HEAD" || code == 204 || code == 304) { return; }
        if (frame.framingHasLength
            && raw.Length - head.Length < frame.framingLength) {
            throw new HttpRequestException(
                "connection closed in the middle of the response body");
        }
    }

    async string RequestOnceAsync(string method, string path, string body) {
        this.CheckRequestLimit(body.Length);
        this.CheckTargetPolicy();
        if (this.kaEnabled && this.pool != null) {
            string alive = await this.RequestPooledAsync(method, path, body);
            return alive;
        }
        return await this.RequestUnpooledAsync(method, path, body);
    }

    // 一次请求（含策略允许的重试）。
    //
    // 默认策略 retryAttempts=0，直接透传给 RequestOnceAsync；开启
    // RetryNetwork + RetryAttempts 后，是否重试一律由
    // ExternalCallPolicy.CanRetry 判定（幂等门禁 + 状态码白名单），
    // 退避随尝试次数线性递增。
    //
    // 只捕获 HttpRequestException：传输层的连接失败、超时、对端关闭、
    // 帧格式错都归这一种，而编程错误（空引用之类）不会被误当成网络
    // 抖动重试。
    async string RequestOnceWithRetry(string method, string path, string body) {
        ExternalCallPolicy policy = this.callPolicy;
        if (policy == null || policy.RetryAttempts() <= 0) {
            return await this.RequestOnceAsync(method, path, body);
        }
        // requestStarted 的口径：GET/HEAD 无副作用；声明过幂等键的
        // 方法重放安全；其余方法保守视为可能已产生副作用，不重试。
        bool requestStarted = !HttpClient.SideEffectFreeMethod(method)
            && !policy.IsIdempotent();
        int maxAttempts = policy.RetryAttempts();
        int attempt = 0;
        while (true) {
            string raw = "";
            int status = 0;
            HttpRequestException failure = null;
            try {
                raw = await this.RequestOnceAsync(method, path, body);
                status = HttpResponse.Parse(raw).statusCode;
            } catch (HttpRequestException ex) {
                failure = ex;
                status = 0;
            }
            if (attempt < maxAttempts
                && policy.CanRetry(method, requestStarted, status)) {
                attempt = attempt + 1;
                // 退避时间算在总预算里：totalDeadlineUs 由外层统一
                // 约束，不因为重试而延长。
                int wait = policy.RetryBackoffMs() * attempt;
                if (wait > 0) { await Task.Delay(wait); }
                continue;
            }
            if (failure != null) { throw failure; }
            return raw;
        }
    }

    // GET/HEAD 不产生副作用，可安全重放。
    static bool SideEffectFreeMethod(string method) {
        if (method == null) { return false; }
        string m = method.ToUpper();
        return m == "GET" || m == "HEAD";
    }

    async string RequestUnpooledAsync(string method, string path, string body) {
        if (this.useTls) {
            string raw = await RequestTlsAsync(method, path, body);
            return raw;
        }

        TcpClient conn = await this.ConnectTarget();
        if (conn == null) {
            FailConnect();
        }
        // 从这里起，截止时间由清扫器接管：接受连接后
        // 就沉默不语的对端会让本协程永久挂起，
        // 因为 reactor 唤醒无法取消。
        HttpDeadlineToken watch = HttpDeadline.Arm(conn.Sock(), this.WriteBudget(), this.TotalBudget());
        string requestData = BuildRequest(method, path, body, true);
        int _sent = await conn.SendAsync(requestData);
        if (_sent != requestData.Length) {
            HttpDeadline.Disarm(watch);
            conn.Close();
            requestData = "";
            throw new HttpRequestException("request write failed");
        }
        requestData = "";
        HttpDeadline.Touch(watch, this.ReadBudget());

        // 读取响应。chunk 被提到循环外并在之后清空，
        // 因为超时是通过 `throw` 展开的，而它不会
        // 释放存活的局部变量——包括循环作用域内的
        StringBuilder respSb = new StringBuilder();
        int responseBytes = 0;
        int responseLimit = this.ResponseLimit();
        bool reading = true;
        string chunk = "";
        while (reading) {
            chunk = await conn.RecvAsync(65536);
            if (chunk.Length == 0) {
                reading = false;
            } else {
                if (responseBytes > responseLimit - chunk.Length) {
                    chunk = "";
                    respSb = null;
                    HttpDeadline.Disarm(watch);
                    conn.Close();
                    conn = null;
                    throw new HttpRequestException(
                        "response exceeds " + Convert.ToString(responseLimit)
                        + " bytes");
                }
                respSb.Append(chunk);
                responseBytes = responseBytes + chunk.Length;
            }
        }
        chunk = "";

        string result = respSb.ToString();
        respSb = null;
        bool late = HttpDeadline.Expired(watch);
        HttpDeadline.Disarm(watch);
        conn.Close();
        conn = null;
        if (late) {
            // 在展开前丢弃不完整的响应和连接：
            // throw 时仍存活的局部变量不会被释放
            result = "";
            method = "";
            path = "";
            body = "";
            FailTimeout();
        }
        this.ValidateTextResponse(result, method);
        this.AbsorbCookies(path, result);
        return result;
    }

    // 建立一条全新的 TLS 连接（连接或握手失败时抛出 HttpRequestException，
    // 且发生在任何请求分配之前），然后发送
    // 请求并读取完整响应（Connection: close 帧结构）。
    // 一次性 TLS 请求：新建 TLS 连接后发送请求并读取完整响应。
    async string RequestTlsAsync(string method, string path, string body) {
        Socket.Initialize();
        TcpClient conn = await this.ConnectTarget();
        if (conn == null) {
            FailConnect();
        }
        TlsContext ctx;
        if (this.clientCertificateFile.Length > 0
            && this.clientPrivateKeyFile.Length > 0) {
            ctx = TlsContext.CreateClientWithCertificate(
                this.clientCertificateFile, this.clientPrivateKeyFile);
        } else {
            ctx = TlsContext.CreateClient();
        }
        if (ctx != null && this.certPolicy != null) {
            ctx.SetCertPolicy(this.certPolicy);
        }
        if (ctx == null) {
            conn.Close();
            string tlsError = TlsStream.LastError();
            if (tlsError == "") { tlsError = "TLS 上下文初始化失败"; }
            throw new HttpRequestException(tlsError);
        }
        if (!this.verifyTls) {
            ctx.DisableVerify();
        }
        this.ApplyPinning(ctx);
        TlsStream stream = await this.ConnectTls(ctx, conn.Sock());
        if (stream == null) {
            conn.Close();
            ctx.Free();
            string tlsHandshakeError = TlsStream.LastError();
            if (tlsHandshakeError == "") {
                tlsHandshakeError = "TLS 握手失败";
            }
            throw new HttpRequestException(tlsHandshakeError);
        }

        // 握手已完成；像普通路径那样，用相同方式约束
        // 数据交换本身。
        HttpDeadlineToken watch = HttpDeadline.Arm(conn.Sock(), this.WriteBudget(), this.TotalBudget());
        string requestData = BuildRequest(method, path, body, true);
        int _sent = await stream.SendAsync(requestData, requestData.Length);
        if (_sent != requestData.Length) {
            HttpDeadline.Disarm(watch);
            stream.Close();
            conn.Close();
            ctx.Free();
            requestData = "";
            throw new HttpRequestException("request write failed");
        }
        HttpDeadline.Touch(watch, this.ReadBudget());

        StringBuilder respSb = new StringBuilder();
        int responseBytes = 0;
        int responseLimit = this.ResponseLimit();
        bool reading = true;
        string chunk = "";
        while (reading) {
            chunk = await stream.RecvAsync(65536);
            if (chunk.Length == 0) {
                reading = false;
            } else {
                if (responseBytes > responseLimit - chunk.Length) {
                    chunk = "";
                    respSb = null;
                    HttpDeadline.Disarm(watch);
                    stream.Close();
                    conn.Close();
                    ctx.Free();
                    throw new HttpRequestException(
                        "response exceeds " + Convert.ToString(responseLimit)
                        + " bytes");
                }
                respSb.Append(chunk);
                responseBytes = responseBytes + chunk.Length;
            }
        }
        chunk = "";

        string result = respSb.ToString();
        respSb = null;
        bool late = HttpDeadline.Expired(watch);
        HttpDeadline.Disarm(watch);
        stream.Close();
        conn.Close();
        ctx.Free();
        stream = null;
        conn = null;
        ctx = null;
        if (late) {
            result = "";
            requestData = "";
            method = "";
            path = "";
            body = "";
            FailTimeout();
        }
        this.ValidateTextResponse(result, method);
        this.AbsorbCookies(path, result);
        return result;
    }

    // TLS 握手也必须挂到同一个 deadline sweep：TlsStream 的 timeout 参数
    // 负责阶段预算，watch 负责唤醒可能停在 ReadReady 的 reactor 协程。
    // 清扫器挂断套接字后握手通常以普通失败收场（stream == null），
    // 因此过期判断必须先于 stream 判空，否则超时会被报成一般握手失败。
    // 在同一 deadline 清扫下执行 TLS 握手；超时返回 null。
    async TlsStream ConnectTls(TlsContext ctx, nint sock) {
        HttpDeadlineToken watch = HttpDeadline.Arm(sock,
            this.HandshakeBudget(), this.TotalBudget());
        TlsStream stream = await TlsStream.ConnectAsync(ctx, sock, this.host,
            this.HandshakeBudget());
        bool late = HttpDeadline.Expired(watch);
        HttpDeadline.Disarm(watch);
        if (late) {
            if (stream != null) { stream.Close(); }
            TlsStream.SetLastError("TLS 握手超时");
            return null;
        }
        return stream;
    }

    // keep-alive 请求：复用池中的连接，直到对端宣布关闭。同一客户端
    // 同时只允许一个在途请求（kaBusy 拦截，并发请求走一次性通道）；
    // 空闲连接被对端回收时，换一条新连接透明地重试一次。
    // keep-alive 复用通道的请求入口；同一客户端同时只允许一个在途请求。
    async string RequestAliveAsync(string method, string path, string body) {
        this.kaBusy = true;
        string raw = "";
        try {
            raw = await this.RequestAliveCore(method, path, body);
        } catch (Exception __alive) {
            this.kaBusy = false;
            throw;
        }
        this.kaBusy = false;
        return raw;
    }

    // 复用通道的实际收发。响应组装用 StringBuilder 按显式长度拼接：
    // 二进制正文里的 NUL 不能让 a+b 的 strlen 语义把响应截断。
    // 复用通道的实际收发；响应按显式长度拼接，二进制正文不被截断。
    async string RequestAliveCore(string method, string path, string body) {
        int attempt = 0;
        while (true) {
            attempt = attempt + 1;
            bool reused = this.ka != null;
            if (!reused) {
                this.DropAlive();
                bool ok = await this.ConnectAlive();
                if (!ok) {
                    FailConnect();
                }
            }
            HttpDeadlineToken watch = HttpDeadline.Arm(this.kaConn.Sock(),
                this.WriteBudget(), this.TotalBudget());
            string req = this.BuildRequest(method, path, body, false);
            int _sent;
            if (this.kaTls != null) {
                _sent = await this.kaTls.SendAsync(req, req.Length);
            } else {
                _sent = await this.kaConn.SendAsync(req);
            }
            if (_sent != req.Length) {
                bool writeLate = HttpDeadline.Expired(watch);
                HttpDeadline.Disarm(watch);
                this.DropAlive();
                req = "";
                if (writeLate) { FailTimeout(); }
                throw new HttpRequestException("request write failed");
            }
            HttpDeadline.Touch(watch, this.ReadBudget());
            int he = 0;
            string head = "";
            while (true) {
                he = await this.ka.ReadHead(65536);
                if (he == 0 && reused && attempt == 1
                    && (method == "GET" || method == "HEAD")) {
                    HttpDeadline.Disarm(watch);
                    this.DropAlive();
                    break;
                }
                if (he == 0) {
                    bool late = HttpDeadline.Expired(watch);
                    HttpDeadline.Disarm(watch);
                    this.DropAlive();
                    req = "";
                    if (late) {
                        method = "";
                        path = "";
                        body = "";
                        FailTimeout();
                    }
                    throw new HttpRequestException(
                        "connection closed before a response arrived");
                }
                if (he < 0) {
                    HttpDeadline.Disarm(watch);
                    this.DropAlive();
                    req = "";
                    throw new HttpRequestException(
                        "response header block exceeds 65536 bytes");
                }
                head = this.ka.Head(he);
                int interim = HttpClient.HeadStatus(head);
                if (interim >= 100 && interim < 200 && interim != 101) {
                    // 1xx（101 除外）是同一请求的临时响应；只消费其
                    // 头部，绝不能把它当最终响应返回或再次发送请求。
                    this.ka.Consume(he);
                    continue;
                }
                break;
            }
            if (he == 0 && reused && attempt == 1
                && (method == "GET" || method == "HEAD")) { continue; }
            HttpResponse probe = HttpResponse.Parse(head);
            if (probe.statusCode < 100 || !probe.ParseFraming()) {
                HttpDeadline.Disarm(watch);
                this.DropAlive();
                req = "";
                throw new HttpRequestException("response framing malformed");
            }
            bool serverClose = HttpClient.HeadSaysClose(head);
            // 204/304 与 HEAD 的响应没有正文，不能按 Content-Length
            // 或 EOF 去等。
            bool noBody = probe.statusCode == 204 || probe.statusCode == 304
                || method == "HEAD";
            string bodyOut = "";
            bool keep = false;
            if (noBody) {
                this.ka.Consume(he);
                keep = !serverClose;
            } else if (probe.framingChunked || probe.framingHasLength) {
                int st = await this.ka.ReadResponseBody(probe, he,
                    this.ResponseLimit());
                if (st == 0) {
                    bodyOut = probe.body;
                    this.ka.Consume(this.ka.RequestBytes());
                    keep = !serverClose;
                } else if (st == -1) {
                    // 对端在正文中途关闭。与头部前关闭不同，响应已开始
                    // 到达，说明服务器处理过这个请求，因此不重试
                    // （重试非幂等请求可能重复执行）。
                    bool late = HttpDeadline.Expired(watch);
                    HttpDeadline.Disarm(watch);
                    this.DropAlive();
                    req = "";
                    if (late) {
                        method = "";
                        path = "";
                        body = "";
                        FailTimeout();
                    }
                    throw new HttpRequestException(
                        "connection closed in the middle of the response body");
                } else if (st == 413) {
                    HttpDeadline.Disarm(watch);
                    this.DropAlive();
                    req = "";
                    throw new HttpRequestException(
                        "response body exceeds " + Convert.ToString(
                            this.ResponseLimit()) + " bytes");
                } else {
                    HttpDeadline.Disarm(watch);
                    this.DropAlive();
                    req = "";
                    throw new HttpRequestException(
                        "malformed chunked response body");
                }
            } else {
                // 没有 Content-Length 也没有分块：EOF 定界——读到对端
                // 关闭为止，这样的连接不再复用。
                StringBuilder rest = new StringBuilder();
                int limit = this.ResponseLimit();
                int bodyCount = this.ka.Pending() - he;
                if (bodyCount > limit) {
                    HttpDeadline.Disarm(watch);
                    this.DropAlive();
                    req = "";
                    throw new HttpRequestException(
                        "response body exceeds " + Convert.ToString(limit)
                        + " bytes");
                }
                if (bodyCount > 0) {
                    rest.Append(this.ka.Slice(he, bodyCount));
                }
                int pend = this.ka.Pending();
                this.ka.Consume(pend);
                while (!this.ka.Closed()) {
                    int n = await this.ka.Fill();
                    if (n > 0) {
                        if (bodyCount > limit - n) {
                            this.DropAlive();
                            req = "";
                            HttpDeadline.Disarm(watch);
                            throw new HttpRequestException(
                                "response body exceeds " + Convert.ToString(limit)
                                + " bytes");
                        }
                        rest.Append(this.ka.Slice(0, n));
                        bodyCount = bodyCount + n;
                        this.ka.Consume(n);
                    }
                }
                bodyOut = rest.ToString();
                keep = false;
            }
            bool late2 = HttpDeadline.Expired(watch);
            HttpDeadline.Disarm(watch);
            if (!keep || late2) { this.DropAlive(); }
            if (late2) {
                bodyOut = "";
                head = "";
                req = "";
                method = "";
                path = "";
                body = "";
                FailTimeout();
            }
            StringBuilder rsb = new StringBuilder();
            rsb.Append(head);
            rsb.Append(bodyOut);
            string result = rsb.ToString();
            this.ValidateTextResponse(result, method);
            this.AbsorbCookies(path, result);
            return result;
        }
    }

    // 为池化通道创建底层物理连接（明文 TCP 或 TLS 握手），连接失败返回 null。
    async PooledHttpConnection CreatePooledConnection() {
        TcpClient conn = await this.ConnectTarget();
        if (conn == null) { return null; }
        if (!this.useTls) {
            HttpFramer framer = HttpFramer.Create(conn.Sock());
            return new PooledHttpConnection(conn, null, null, framer);
        }
        Socket.Initialize();
        TlsContext ctx;
        if (this.clientCertificateFile.Length > 0
            && this.clientPrivateKeyFile.Length > 0) {
            ctx = TlsContext.CreateClientWithCertificate(
                this.clientCertificateFile, this.clientPrivateKeyFile);
        } else {
            ctx = TlsContext.CreateClient();
        }
        if (ctx != null && this.certPolicy != null) {
            ctx.SetCertPolicy(this.certPolicy);
        }
        if (ctx == null) {
            conn.Close();
            string tlsError = TlsStream.LastError();
            if (tlsError == "") { tlsError = "TLS 上下文初始化失败"; }
            throw new HttpRequestException(tlsError);
        }
        if (!this.verifyTls) {
            ctx.DisableVerify();
        }
        this.ApplyPinning(ctx);
        TlsStream stream = await this.ConnectTls(ctx, conn.Sock());
        if (stream == null) {
            conn.Close();
            ctx.Free();
            string tlsHandshakeError = TlsStream.LastError();
            if (tlsHandshakeError == "") {
                tlsHandshakeError = "TLS 握手失败";
            }
            throw new HttpRequestException(tlsHandshakeError);
        }
        HttpFramer framer = HttpFramerTls.Create(stream);
        return new PooledHttpConnection(conn, stream, ctx, framer);
    }

    // 弹性连接池收发核心：租借复用连接，并发多连接自动扩容，远端静默断开透明重试。
    async string RequestPooledAsync(string method, string path, string body) {
        int attempt = 0;
        while (true) {
            attempt = attempt + 1;
            bool reused = false;
            PooledHttpConnection conn = this.pool.TryRentIdle();
            if (conn != null) {
                reused = true;
            } else {
                bool permit = this.pool.TryAcquirePermit();
                if (!permit) {
                    return await this.RequestUnpooledAsync(method, path, body);
                }
                conn = await this.CreatePooledConnection();
                if (conn == null) {
                    this.pool.ReleasePermit();
                    FailConnect();
                }
            }

            HttpDeadlineToken watch = HttpDeadline.Arm(conn.conn.Sock(),
                this.WriteBudget(), this.TotalBudget());
            string req = this.BuildRequest(method, path, body, false);
            int _sent = 0;
            if (conn.tls != null) {
                _sent = await conn.tls.SendAsync(req, req.Length);
            } else {
                _sent = await conn.conn.SendAsync(req);
            }
            if (_sent != req.Length) {
                bool writeLate = HttpDeadline.Expired(watch);
                HttpDeadline.Disarm(watch);
                this.pool.Return(conn, false);
                req = "";
                if (writeLate) { FailTimeout(); }
                throw new HttpRequestException("request write failed");
            }

            HttpDeadline.Touch(watch, this.ReadBudget());
            int he = 0;
            string head = "";
            while (true) {
                he = await conn.framer.ReadHead(65536);
                if (he == 0 && reused && attempt == 1
                    && (method == "GET" || method == "HEAD")) {
                    HttpDeadline.Disarm(watch);
                    this.pool.Return(conn, false);
                    break;
                }
                if (he == 0) {
                    bool late = HttpDeadline.Expired(watch);
                    HttpDeadline.Disarm(watch);
                    this.pool.Return(conn, false);
                    req = "";
                    if (late) {
                        method = "";
                        path = "";
                        body = "";
                        FailTimeout();
                    }
                    throw new HttpRequestException(
                        "connection closed before a response arrived");
                }
                if (he < 0) {
                    HttpDeadline.Disarm(watch);
                    this.pool.Return(conn, false);
                    req = "";
                    throw new HttpRequestException(
                        "response header block exceeds 65536 bytes");
                }
                head = conn.framer.Head(he);
                int interim = HttpClient.HeadStatus(head);
                if (interim >= 100 && interim < 200 && interim != 101) {
                    conn.framer.Consume(he);
                    continue;
                }
                break;
            }

            if (he == 0 && reused && attempt == 1
                && (method == "GET" || method == "HEAD")) {
                continue;
            }

            HttpResponse probe = HttpResponse.Parse(head);
            if (probe.statusCode < 100 || !probe.ParseFraming()) {
                HttpDeadline.Disarm(watch);
                this.pool.Return(conn, false);
                req = "";
                throw new HttpRequestException("response framing malformed");
            }
            bool serverClose = HttpClient.HeadSaysClose(head);
            bool noBody = probe.statusCode == 204 || probe.statusCode == 304
                || method == "HEAD";
            string bodyOut = "";
            bool keep = false;
            if (noBody) {
                conn.framer.Consume(he);
                keep = !serverClose;
            } else if (probe.framingChunked || probe.framingHasLength) {
                int st = await conn.framer.ReadResponseBody(probe, he,
                    this.ResponseLimit());
                if (st == 0) {
                    bodyOut = probe.body;
                    conn.framer.Consume(conn.framer.RequestBytes());
                    keep = !serverClose;
                } else if (st == -1) {
                    bool late = HttpDeadline.Expired(watch);
                    HttpDeadline.Disarm(watch);
                    this.pool.Return(conn, false);
                    req = "";
                    if (late) {
                        method = "";
                        path = "";
                        body = "";
                        FailTimeout();
                    }
                    throw new HttpRequestException(
                        "connection closed in the middle of the response body");
                } else if (st == 413) {
                    HttpDeadline.Disarm(watch);
                    this.pool.Return(conn, false);
                    req = "";
                    throw new HttpRequestException(
                        "response body exceeds " + Convert.ToString(
                            this.ResponseLimit()) + " bytes");
                } else {
                    HttpDeadline.Disarm(watch);
                    this.pool.Return(conn, false);
                    req = "";
                    throw new HttpRequestException(
                        "malformed chunked response body");
                }
            } else {
                StringBuilder rest = new StringBuilder();
                int limit = this.ResponseLimit();
                int bodyCount = conn.framer.Pending() - he;
                if (bodyCount > limit) {
                    HttpDeadline.Disarm(watch);
                    this.pool.Return(conn, false);
                    req = "";
                    throw new HttpRequestException(
                        "response body exceeds " + Convert.ToString(limit)
                        + " bytes");
                }
                if (bodyCount > 0) {
                    rest.Append(conn.framer.Slice(he, bodyCount));
                }
                int pend = conn.framer.Pending();
                conn.framer.Consume(pend);
                while (!conn.framer.Closed()) {
                    int n = await conn.framer.Fill();
                    if (n > 0) {
                        if (bodyCount > limit - n) {
                            this.pool.Return(conn, false);
                            req = "";
                            HttpDeadline.Disarm(watch);
                            throw new HttpRequestException(
                                "response body exceeds " + Convert.ToString(limit)
                                + " bytes");
                        }
                        rest.Append(conn.framer.Slice(0, n));
                        bodyCount = bodyCount + n;
                        conn.framer.Consume(n);
                    }
                }
                bodyOut = rest.ToString();
                keep = false;
            }

            bool late2 = HttpDeadline.Expired(watch);
            HttpDeadline.Disarm(watch);
            this.pool.Return(conn, keep && !late2);
            if (late2) {
                bodyOut = "";
                head = "";
                req = "";
                method = "";
                path = "";
                body = "";
                FailTimeout();
            }
            StringBuilder rsb = new StringBuilder();
            rsb.Append(head);
            rsb.Append(bodyOut);
            string result = rsb.ToString();
            this.ValidateTextResponse(result, method);
            this.AbsorbCookies(path, result);
            return result;
        }
    }

    // 为复用通道建立底层连接（明文或 TLS 握手）。返回 false 表示
    // 连接失败（调用方 FailConnect() 报告）；TLS 失败直接抛出，
    // 错误文本与一次性通道一致。
    // 为复用通道建立底层连接（明文或 TLS 握手）；连接失败返回 false。
    async bool ConnectAlive() {
        TcpClient conn = await this.ConnectTarget();
        if (conn == null) { return false; }
        if (!this.useTls) {
            this.kaConn = conn;
            this.ka = HttpFramer.Create(conn.Sock());
            return true;
        }
        Socket.Initialize();
        TlsContext ctx;
        if (this.clientCertificateFile.Length > 0
            && this.clientPrivateKeyFile.Length > 0) {
            ctx = TlsContext.CreateClientWithCertificate(
                this.clientCertificateFile, this.clientPrivateKeyFile);
        } else {
            ctx = TlsContext.CreateClient();
        }
        if (ctx != null && this.certPolicy != null) {
            ctx.SetCertPolicy(this.certPolicy);
        }
        if (ctx == null) {
            conn.Close();
            string tlsError = TlsStream.LastError();
            if (tlsError == "") { tlsError = "TLS 上下文初始化失败"; }
            throw new HttpRequestException(tlsError);
        }
        if (!this.verifyTls) {
            ctx.DisableVerify();
        }
        this.ApplyPinning(ctx);
        TlsStream stream = await this.ConnectTls(ctx, conn.Sock());
        if (stream == null) {
            conn.Close();
            ctx.Free();
            string tlsHandshakeError = TlsStream.LastError();
            if (tlsHandshakeError == "") {
                tlsHandshakeError = "TLS 握手失败";
            }
            throw new HttpRequestException(tlsHandshakeError);
        }
        this.kaConn = conn;
        this.kaTls = stream;
        this.kaCtx = ctx;
        this.ka = HttpFramerTls.Create(stream);
        return true;
    }

    // 头部块里是否声明了 Content-Length。HttpRequest.Parse 把缺失的
    // Content-Length 记为 0，与"声明为 0"无法区分，所以要在头部
    // 文本里找（头部块是 ASCII，整体小写后按行首匹配）。
    private static bool HeadHasContentLength(string head) {
        return head.ToLower().Contains("\ncontent-length:");
    }

    // 头部块是否带 Connection: close（按逗号 token、OWS 和大小写解析）。
    private static bool HeadSaysClose(string head) {
        if (head == null) { return false; }
        int pos = 0;
        while (pos < head.Length) {
            int end = head.IndexOf("\n", pos);
            if (end < 0) { end = head.Length; }
            int stop = end;
            if (stop > pos && (head[stop - 1] & 255) == 13) { stop = stop - 1; }
            int colon = head.IndexOf(":", pos);
            if (colon > pos && colon < stop) {
                string name = head.Substring(pos, colon - pos).ToLower();
                if (name == "connection") {
                    int v = colon + 1;
                    while (v < stop) {
                        while (v < stop && ((head[v] & 255) == 32 || (head[v] & 255) == 9 || (head[v] & 255) == 44)) { v = v + 1; }
                        int token = v;
                        while (v < stop && (head[v] & 255) != 44) { v = v + 1; }
                        int tokenEnd = v;
                        while (tokenEnd > token && ((head[tokenEnd - 1] & 255) == 32 || (head[tokenEnd - 1] & 255) == 9)) { tokenEnd = tokenEnd - 1; }
                        if (tokenEnd - token == 5 && head.Substring(token, 5).ToLower() == "close") { return true; }
                        if (v < stop) { v = v + 1; }
                    }
                }
            }
            pos = end + 1;
        }
        return false;
    }

    // 发送请求并返回解析后的响应，使调用者可以看到
    // 状态行和头部，而不只是正文：来自网关的 502
    // 与一个负载古怪的 200 响应本来无法区分。
    async HttpResponse SendAsync(string method, string path, string body) {
        string raw = await RequestAsync(method, path, body);
        return this.ApplyContentEncoding(HttpResponse.Parse(raw));
    }

    // 二进制安全的一次性请求。通道与 <see cref="SendAsync"/>
    // 相同（Connection: close，读至对端关闭或定界完成），但请求正文
    // 按显式字节长度发送（strlen 定长的发送会在内嵌 NUL 处截断，
    // TLS 变体本就按 req.Length 发送，这里对齐），响应全程按
    // 显式字节数组装（<see cref="HttpFramer"/> + ByteBuffer）：
    // 正文里的 NUL 不会把响应截断，结果的 bodyBytes/bodyBytesLen
    // 有效，<see cref="HttpResponse.IsBinary"/> 与
    // <see cref="HttpResponse.BodyLength"/> 据此工作。适合图片、
    // 字体等二进制资源的下载与上传；文本响应照常可用 body 读取。
    // 绑定 policy 时按同一规则跟随重定向（3xx 原样返回仍是默认）。
    async HttpResponse SendBytesAsync(string method, string path, string body) {
        int bodyLen = body != null ? body.Length : 0;
        return await this.SendBytesAsync(method, path, body, bodyLen);
    }

    // 发送原始字节正文（带显式字节长度，二进制安全，可含 NUL 字节）。
    async HttpResponse SendBytesAsync(string method, string path, string body, int bodyLen) {
        this.ResetTotalBudget();
        this.CheckRequestLimit(bodyLen);
        this.CheckTargetPolicy();
        if (this.callPolicy == null || this.callPolicy.MaxRedirects() <= 0) {
            HttpResponse direct = await HttpClient.SendBytesOnceWithLenAsync(this,
                method, path, body, bodyLen);
            return this.ApplyContentEncoding(direct);
        }
        HttpResponse followed = await this.FollowBytesRedirects(method, path, body,
            HttpClient.SendBytesOnceAsync);
        return this.ApplyContentEncoding(followed);
    }

    // 发送原始字节数组（带显式字节长度，二进制安全，零中转字符串拷贝）。
    async HttpResponse SendBytesAsync(string method, string path, byte[] body, int bodyLen) {
        this.ResetTotalBudget();
        this.CheckRequestLimit((long)bodyLen);
        this.CheckTargetPolicy();
        HttpResponse direct = await HttpClient.SendBytesOnceWithRawBytesAsync(this,
            method, path, body, bodyLen);
        return this.ApplyContentEncoding(direct);
    }

    // 流式上传本地文件作为请求正文（适用于 PUT / POST 原始文件上传，如 WebDAV、对象存储等），
    // 单句柄 64KB 流式直发，零中转整文件内存分配，支持超 2GB 大文件。
    async HttpResponse UploadFileRawAsync(string method, string path, string localPath, string contentType) {
        long fileLen = File.GetSize64(localPath);
        if (fileLen < 0) {
            throw new FileNotFoundException("Could not open file: " + localPath);
        }
        this.ResetTotalBudget();
        this.CheckTargetPolicy();
        this.CheckRequestLimit(fileLen);
        if (contentType != null && contentType.Length > 0 && !this.HasHeaderName("Content-Type")) {
            this.SetHeader("Content-Type", contentType);
        }
        HttpResponse resp;
        if (this.useTls) {
            resp = await this.SendBytesBodyTlsAsync(method, path, "", localPath, fileLen, "", fileLen);
        } else {
            resp = await this.SendBytesBodyAsync(method, path, "", localPath, fileLen, "", fileLen);
        }
        return resp;
    }

    // 一次真实上线：SendBytesAsync 的无重定向主体，同时作为
    // FollowBytesRedirects 的驱动回调。method 随驱动签名显式传递：
    // 重定向改写（301/302/303 → GET）后驱动端据此发空 GET。
    static async HttpResponse SendBytesOnceAsync(HttpClient client,
            string method, string path, string body) {
        int bodyLen = body != null ? body.Length : 0;
        return await HttpClient.SendBytesOnceWithLenAsync(client, method, path, body, bodyLen);
    }

    static async HttpResponse SendBytesOnceWithRawBytesAsync(HttpClient client,
            string method, string path, byte[] body, int bodyLen) {
        if (client.useTls) {
            HttpResponse tResp = await client.SendBytesTlsWithRawBytesAsync(method, path,
                                                                body, bodyLen);
            return tResp;
        }
        TcpClient conn = await client.ConnectTarget();
        if (conn == null) { client.FailConnect(); }
        HttpDeadlineToken watch = HttpDeadline.Arm(conn.Sock(), client.WriteBudget(), client.TotalBudget());
        string reqHead = client.BuildRequestHead(method, path, (long)bodyLen, true);
        int _sent = await conn.SendBytesAsync(reqHead, reqHead.Length);
        if (_sent != reqHead.Length) {
            HttpDeadline.Disarm(watch);
            conn.Close();
            throw new HttpRequestException("request write failed");
        }
        if (bodyLen > 0 && body != null) {
            int _b = await conn.SendBytesAsync(body, bodyLen);
            if (_b != bodyLen) {
                HttpDeadline.Disarm(watch);
                conn.Close();
                throw new HttpRequestException("request body write failed");
            }
        }
        HttpDeadline.Touch(watch, client.ReadBudget());
        HttpResponse resp = await client.ReadFramedResponse(conn, path, method,
                                                          watch, null, null);
        return resp;
    }

    static async HttpResponse SendBytesOnceWithLenAsync(HttpClient client,
            string method, string path, string body, int bodyLen) {
        if (client.useTls) {
            HttpResponse tResp = await client.SendBytesTlsWithLenAsync(method, path,
                                                                body, bodyLen);
            return tResp;
        }
        TcpClient conn = await client.ConnectTarget();
        if (conn == null) { client.FailConnect(); }
        HttpDeadlineToken watch = HttpDeadline.Arm(conn.Sock(), client.WriteBudget(), client.TotalBudget());
        string reqHead = client.BuildRequestHead(method, path, bodyLen, true);
        int _sent = await conn.SendBytesAsync(reqHead, reqHead.Length);
        if (_sent != reqHead.Length) {
            HttpDeadline.Disarm(watch);
            conn.Close();
            throw new HttpRequestException("request write failed");
        }
        if (bodyLen > 0 && body != null) {
            int _b = await conn.SendBytesAsync(body, bodyLen);
            if (_b != bodyLen) {
                HttpDeadline.Disarm(watch);
                conn.Close();
                throw new HttpRequestException("request body write failed");
            }
        }
        HttpDeadline.Touch(watch, client.ReadBudget());
        HttpResponse resp = await client.ReadFramedResponse(conn, path, method,
                                                          watch, null, null);
        return resp;
    }

    // SendBytesAsync / SendBytesTlsAsync / SendBytesBodyAsync 共用的
    // 响应读取：从已发出请求的连接上按 HttpFramer 组装解析后的响应，
    // 超时/对端关闭/超限走异常路径。stream/ctx 非 null 表示 TLS 通道，
    // 清理时随连接一并关闭。
    async HttpResponse ReadFramedResponse(TcpClient conn, string path,
            string method, HttpDeadlineToken watch, TlsStream stream, TlsContext ctx) {
        // 请求已上线，后续响应等待使用 read phase，而非 write phase。
        HttpDeadline.Touch(watch, this.ReadBudget());
        HttpFramer fr;
        if (stream != null) {
            fr = HttpFramerTls.Create(stream);
        } else {
            fr = HttpFramer.Create(conn.Sock());
        }
        int he = 0;
        string head = "";
        while (true) {
            he = await fr.ReadHead(65536);
            if (he == 0) {
                bool lateHead = HttpDeadline.Expired(watch);
                HttpDeadline.Disarm(watch);
                this.CloseChannel(conn, fr, stream, ctx);
                if (lateHead) { FailTimeout(); }
                throw new HttpRequestException(
                    "connection closed before a response arrived");
            }
            if (he < 0) {
                HttpDeadline.Disarm(watch);
                this.CloseChannel(conn, fr, stream, ctx);
                throw new HttpRequestException(
                    "response header block exceeds 65536 bytes");
            }
            head = fr.Head(he);
            int interim = HttpClient.HeadStatus(head);
            if (interim >= 100 && interim < 200 && interim != 101) {
                fr.Consume(he);
                continue;
            }
            break;
        }
        HttpResponse resp = HttpResponse.Parse(head);
        if (resp.statusCode < 100 || !resp.ParseFraming()) {
            HttpDeadline.Disarm(watch);
            this.CloseChannel(conn, fr, stream, ctx);
            throw new HttpRequestException("response framing malformed");
        }
        bool noBody = resp.statusCode == 204 || resp.statusCode == 304
            || method == "HEAD";
        if (!noBody) {
            if (resp.framingChunked || resp.framingHasLength) {
                int st = await fr.ReadResponseBody(resp, he,
                    this.ResponseLimit());
                if (st == -1) {
                    bool lateBody = HttpDeadline.Expired(watch);
                    HttpDeadline.Disarm(watch);
                    this.CloseChannel(conn, fr, stream, ctx);
                    if (lateBody) { FailTimeout(); }
                    throw new HttpRequestException(
                        "connection closed in the middle of the response body");
                }
                if (st == 413) {
                    HttpDeadline.Disarm(watch);
                    this.CloseChannel(conn, fr, stream, ctx);
                    throw new HttpRequestException(
                        "response body exceeds " + Convert.ToString(
                            this.ResponseLimit()) + " bytes");
                }
                if (st != 0) {
                    HttpDeadline.Disarm(watch);
                    this.CloseChannel(conn, fr, stream, ctx);
                    throw new HttpRequestException(
                        "malformed chunked response body");
                }
                int n = resp.bodyBytesLen;
                byte[] outb = new byte[n + 1];
                if (n > 0 && resp.body != null) {
                    NativeMemory.PutString((nint)outb, 0, resp.body, n);
                }
                resp.bodyBytes = outb;
            } else {
                // 没有 Content-Length 也没有分块：EOF 定界，读到对端
                // 关闭为止，按字节累积。
                ByteBuffer acc = ByteBuffer.Alloc(8192);
                int limit = this.ResponseLimit();
                int pend = fr.Pending();
                int initial = pend - he;
                if (initial > limit) {
                    acc.Free();
                    HttpDeadline.Disarm(watch);
                    this.CloseChannel(conn, fr, stream, ctx);
                    throw new HttpRequestException(
                        "response body exceeds " + Convert.ToString(limit)
                        + " bytes");
                }
                if (initial > 0) {
                    acc.WriteRaw(fr.Slice(he, initial), initial);
                }
                fr.Consume(pend);
                while (!fr.Closed()) {
                    int nb = await fr.Fill();
                    if (nb > 0) {
                        if (acc.Length() > limit - nb) {
                            acc.Free();
                            HttpDeadline.Disarm(watch);
                            this.CloseChannel(conn, fr, stream, ctx);
                            throw new HttpRequestException(
                                "response body exceeds " + Convert.ToString(limit)
                                + " bytes");
                        }
                        acc.WriteRaw(fr.Slice(0, nb), nb);
                        fr.Consume(nb);
                    }
                }
                int total = acc.Length();
                byte[] oute = acc.ToBytes();
                resp.body = acc.ToStr();
                acc.Free();
                resp.bodyBytes = oute;
                resp.bodyBytesLen = total;
            }
        }
        bool late = HttpDeadline.Expired(watch);
        HttpDeadline.Disarm(watch);
        this.CloseChannel(conn, fr, stream, ctx);
        if (late) {
            FailTimeout();
        }
        this.AbsorbCookies(path, head);
        return resp;
    }

    // 响应读取后的统一通道清理：先拆 framer，再关 TLS 流（如有）、
    // 连接，最后释放 TLS 上下文——与既有各变体的清理次序一致。
    // fr 允许为 null（请求尚未发完就放弃时还没有 framer）。
    void CloseChannel(TcpClient conn, HttpFramer fr, TlsStream stream,
                      TlsContext ctx) {
        if (fr != null) { fr.Dispose(); }
        if (stream != null) { stream.Close(); }
        conn.Close();
        if (ctx != null) { ctx.Free(); }
    }

    // SendBytesAsync 的 TLS 变体：握手与一次性通道一致，只是读取
    // 走 HttpFramerTls.Create（TlsStream.RecvIntoAsync 同样给出
    // 精确字节数）。
    async HttpResponse SendBytesTlsAsync(string method, string path,
                                         string body) {
        int bodyLen = body != null ? body.Length : 0;
        return await this.SendBytesTlsWithLenAsync(method, path, body, bodyLen);
    }

    async HttpResponse SendBytesTlsWithLenAsync(string method, string path,
                                                string body, int bodyLen) {
        Socket.Initialize();
        TcpClient conn = await this.ConnectTarget();
        if (conn == null) { FailConnect(); }
        TlsContext ctx;
        if (this.clientCertificateFile.Length > 0
            && this.clientPrivateKeyFile.Length > 0) {
            ctx = TlsContext.CreateClientWithCertificate(
                this.clientCertificateFile, this.clientPrivateKeyFile);
        } else {
            ctx = TlsContext.CreateClient();
        }
        if (ctx != null && this.certPolicy != null) {
            ctx.SetCertPolicy(this.certPolicy);
        }
        if (ctx == null) {
            conn.Close();
            string tlsError = TlsStream.LastError();
            if (tlsError == "") { tlsError = "TLS 上下文初始化失败"; }
            throw new HttpRequestException(tlsError);
        }
        if (!this.verifyTls) {
            ctx.DisableVerify();
        }
        this.ApplyPinning(ctx);
        TlsStream stream = await this.ConnectTls(ctx, conn.Sock());
        if (stream == null) {
            conn.Close();
            ctx.Free();
            string tlsHandshakeError = TlsStream.LastError();
            if (tlsHandshakeError == "") {
                tlsHandshakeError = "TLS 握手失败";
            }
            throw new HttpRequestException(tlsHandshakeError);
        }
        HttpDeadlineToken watch = HttpDeadline.Arm(conn.Sock(), this.WriteBudget(), this.TotalBudget());
        string reqHead = this.BuildRequestHead(method, path, bodyLen, true);
        int _sent = await stream.SendAsync(reqHead, reqHead.Length);
        if (_sent != reqHead.Length) {
            HttpDeadline.Disarm(watch);
            stream.Close();
            conn.Close();
            ctx.Free();
            throw new HttpRequestException("request write failed");
        }
        if (bodyLen > 0 && body != null) {
            int _b = await stream.SendAsync(body, bodyLen);
            if (_b != bodyLen) {
                HttpDeadline.Disarm(watch);
                stream.Close();
                conn.Close();
                ctx.Free();
                throw new HttpRequestException("request body write failed");
            }
        }
        HttpResponse resp = await this.ReadFramedResponse(conn, path, method,
                                                          watch, stream, ctx);
        return resp;
    }

    async HttpResponse SendBytesTlsWithRawBytesAsync(string method, string path,
                                                    byte[] body, int bodyLen) {
        Socket.Initialize();
        TcpClient conn = await this.ConnectTarget();
        if (conn == null) { FailConnect(); }
        TlsContext ctx;
        if (this.clientCertificateFile.Length > 0
            && this.clientPrivateKeyFile.Length > 0) {
            ctx = TlsContext.CreateClientWithCertificate(
                this.clientCertificateFile, this.clientPrivateKeyFile);
        } else {
            ctx = TlsContext.CreateClient();
        }
        if (ctx != null && this.certPolicy != null) {
            ctx.SetCertPolicy(this.certPolicy);
        }
        if (ctx == null) {
            conn.Close();
            string tlsError = TlsStream.LastError();
            if (tlsError == "") { tlsError = "TLS 上下文初始化失败"; }
            throw new HttpRequestException(tlsError);
        }
        if (!this.verifyTls) {
            ctx.DisableVerify();
        }
        this.ApplyPinning(ctx);
        TlsStream stream = await this.ConnectTls(ctx, conn.Sock());
        if (stream == null) {
            conn.Close();
            ctx.Free();
            string tlsHandshakeError = TlsStream.LastError();
            if (tlsHandshakeError == "") {
                tlsHandshakeError = "TLS 握手失败";
            }
            throw new HttpRequestException(tlsHandshakeError);
        }
        HttpDeadlineToken watch = HttpDeadline.Arm(conn.Sock(), this.WriteBudget(), this.TotalBudget());
        string reqHead = this.BuildRequestHead(method, path, (long)bodyLen, true);
        int _sent = await stream.SendAsync(reqHead, reqHead.Length);
        if (_sent != reqHead.Length) {
            HttpDeadline.Disarm(watch);
            stream.Close();
            conn.Close();
            ctx.Free();
            throw new HttpRequestException("request write failed");
        }
        if (bodyLen > 0 && body != null) {
            int _b = await stream.SendBytesAsync(body, bodyLen);
            if (_b != bodyLen) {
                HttpDeadline.Disarm(watch);
                stream.Close();
                conn.Close();
                ctx.Free();
                throw new HttpRequestException("request body write failed");
            }
        }
        HttpResponse resp = await this.ReadFramedResponse(conn, path, method,
                                                          watch, stream, ctx);
        return resp;
    }

    // UploadFileBytesAsync 的明文通道：头部 + 文件字节 + 尾部三段式，
    // 每段按显式字节长度发送——strlen 定长的 SendAsync 会把内嵌 NUL
    // 后的正文截掉；Content-Length（total）与各段发送长度取自同一处
    // （与 HttpServer 发送二进制响应同一纪律）。单句柄流式读取，
    // 文件按 64KB 分块读取上线，进度探针随字节推进。绑定 policy 时接入字节重定向链：
    // 3xx 原样返回仍是默认；301/302/303 改写为 GET 后实体不重放
    // （multipart 上传无法降级），由驱动端发空 GET。
    async HttpResponse SendBytesBodyAsync(string method, string path,
            string head, string localPath, long fileLen, string tail,
            long total) {
        this.CheckRequestLimit(total);
        this.CheckTargetPolicy();
        TcpClient conn = await this.ConnectTarget();
        if (conn == null) { FailConnect(); }
        HttpDeadlineToken watch = HttpDeadline.Arm(conn.Sock(), this.WriteBudget(), this.TotalBudget());
        string req = this.BuildRequestHead(method, path, total, true);
        int _h = await conn.SendBytesAsync(req, req.Length);
        int _m = await conn.SendBytesAsync(head, head.Length);
        if (_h != req.Length || _m != head.Length) {
            HttpDeadline.Disarm(watch);
            conn.Close();
            throw new HttpRequestException("upload write failed");
        }
        this.UploadTick((long)(req.Length + head.Length), total);
        nint fp = fopen(localPath, "rb");
        if (fp == 0) {
            HttpDeadline.Disarm(watch);
            conn.Close();
            throw new FileNotFoundException("Could not open file: " + localPath);
        }
        long offset = 0;
        byte[] chunk = new byte[65536];
        while (offset < fileLen) {
            long want = fileLen - offset;
            if (want > 65536) { want = 65536; }
            int got = (int)fread(chunk, 1, want, fp);
            if (got < (int)want) {
                fclose(fp);
                HttpDeadline.Disarm(watch);
                this.CloseChannel(conn, null, null, null);
                throw new HttpRequestException(
                    "file shrank while being uploaded: " + localPath);
            }
            int _c = await conn.SendBytesAsync(chunk, got);
            if (_c != got) {
                fclose(fp);
                HttpDeadline.Disarm(watch);
                conn.Close();
                throw new HttpRequestException("upload write failed");
            }
            HttpDeadline.Touch(watch, this.WriteBudget());
            offset = offset + (long)got;
            this.UploadTick((long)(req.Length + head.Length) + offset, total);
        }
        fclose(fp);
        int _t = await conn.SendBytesAsync(tail, tail.Length);
        if (_t != tail.Length) {
            HttpDeadline.Disarm(watch);
            conn.Close();
            throw new HttpRequestException("upload write failed");
        }
        this.UploadTick(total, total);
        HttpDeadline.Touch(watch, this.ReadBudget());
        HttpResponse resp = await this.ReadFramedResponse(conn, path, method,
                                                          watch, null, null);
        return resp;
    }

    // 上传通道的重定向驱动回调：只发一次真实上线。重定向跟随中动作用
    // method 参数表达（改写后的 GET 不带实体）；原动作 POST 的实体分块
    // 无法通过该回调重放——multipart 边界态头尾在 307/308 才需要原样
    // 重传，而 307/308 重放由 RedirectReplay 直接拒绝（非 GET/HEAD），
    // 因此实体分块只存在于首发路径。
    static async HttpResponse UploadBytesOnceAsync(HttpClient client,
            string method, string path, string body) {
        if (client.useTls) {
            HttpResponse tResp = await client.SendBytesTlsAsync(method, path,
                                                                body);
            return tResp;
        }
        TcpClient conn = await client.ConnectTarget();
        if (conn == null) { client.FailConnect(); }
        HttpDeadlineToken watch = HttpDeadline.Arm(conn.Sock(), client.WriteBudget(), client.TotalBudget());
        string req = client.BuildRequest(method, path, body, true);
        int _sent = await conn.SendBytesAsync(req, req.Length);
        if (_sent != req.Length) {
            HttpDeadline.Disarm(watch);
            conn.Close();
            throw new HttpRequestException("request write failed");
        }
        HttpDeadline.Touch(watch, client.ReadBudget());
        HttpResponse resp = await client.ReadFramedResponse(conn, path, method,
                                                          watch, null, null);
        return resp;
    }

    // UploadFileBytesAsync 的 TLS 变体：握手同 SendBytesTlsAsync，
    // 三段式正文按显式长度发送，单句柄流式读取，读取走 HttpFramerTls.Create。
    async HttpResponse SendBytesBodyTlsAsync(string method, string path,
            string head, string localPath, long fileLen, string tail,
            long total) {
        this.CheckRequestLimit(total);
        this.CheckTargetPolicy();
        Socket.Initialize();
        TcpClient conn = await this.ConnectTarget();
        if (conn == null) { FailConnect(); }
        TlsContext ctx;
        if (this.clientCertificateFile.Length > 0
            && this.clientPrivateKeyFile.Length > 0) {
            ctx = TlsContext.CreateClientWithCertificate(
                this.clientCertificateFile, this.clientPrivateKeyFile);
        } else {
            ctx = TlsContext.CreateClient();
        }
        if (ctx != null && this.certPolicy != null) {
            ctx.SetCertPolicy(this.certPolicy);
        }
        if (ctx == null) {
            conn.Close();
            string tlsError = TlsStream.LastError();
            if (tlsError == "") { tlsError = "TLS 上下文初始化失败"; }
            throw new HttpRequestException(tlsError);
        }
        if (!this.verifyTls) {
            ctx.DisableVerify();
        }
        this.ApplyPinning(ctx);
        TlsStream stream = await this.ConnectTls(ctx, conn.Sock());
        if (stream == null) {
            conn.Close();
            ctx.Free();
            string tlsHandshakeError = TlsStream.LastError();
            if (tlsHandshakeError == "") {
                tlsHandshakeError = "TLS 握手失败";
            }
            throw new HttpRequestException(tlsHandshakeError);
        }
        HttpDeadlineToken watch = HttpDeadline.Arm(conn.Sock(), this.WriteBudget(), this.TotalBudget());
        string req = this.BuildRequestHead(method, path, total, true);
        int _h = await stream.SendAsync(req, req.Length);
        int _m = await stream.SendAsync(head, head.Length);
        if (_h != req.Length || _m != head.Length) {
            HttpDeadline.Disarm(watch);
            stream.Close();
            conn.Close();
            ctx.Free();
            throw new HttpRequestException("upload write failed");
        }
        this.UploadTick((long)(req.Length + head.Length), total);
        nint fp = fopen(localPath, "rb");
        if (fp == 0) {
            HttpDeadline.Disarm(watch);
            this.CloseChannel(conn, null, stream, ctx);
            throw new FileNotFoundException("Could not open file: " + localPath);
        }
        long offset = 0;
        byte[] chunk = new byte[65536];
        while (offset < fileLen) {
            long want = fileLen - offset;
            if (want > 65536) { want = 65536; }
            int got = (int)fread(chunk, 1, want, fp);
            if (got < (int)want) {
                fclose(fp);
                HttpDeadline.Disarm(watch);
                this.CloseChannel(conn, null, stream, ctx);
                throw new HttpRequestException(
                    "file shrank while being uploaded: " + localPath);
            }
            int _c = await stream.SendBytesAsync(chunk, got);
            if (_c != got) {
                fclose(fp);
                HttpDeadline.Disarm(watch);
                stream.Close();
                conn.Close();
                ctx.Free();
                throw new HttpRequestException("upload write failed");
            }
            HttpDeadline.Touch(watch, this.WriteBudget());
            offset = offset + (long)got;
            this.UploadTick((long)(req.Length + head.Length) + offset, total);
        }
        fclose(fp);
        int _t = await stream.SendAsync(tail, tail.Length);
        if (_t != tail.Length) {
            HttpDeadline.Disarm(watch);
            stream.Close();
            conn.Close();
            ctx.Free();
            throw new HttpRequestException("upload write failed");
        }
        this.UploadTick(total, total);
        HttpDeadline.Touch(watch, this.ReadBudget());
        HttpResponse resp = await this.ReadFramedResponse(conn, path, method,
                                                          watch, stream, ctx);
        return resp;
    }
}
