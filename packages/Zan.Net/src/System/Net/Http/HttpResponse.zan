using System;

namespace System.Net.Http;

/// <summary>
/// HTTP 响应的构建器与解析器。
/// </summary>
class HttpResponse {
    int statusCode;
    string statusText;
    string body;
    /// 二进制正文（与 body 二选一）。Zan 字符串以 NUL 结尾，
    /// 无法携带任意字节，因此图片/可执行文件等正文走 byte[]。
    byte[] bodyBytes;
    int bodyBytesLen;
    string contentType;
    List<string> headers;
    bool keepAlive;
    int framingLength;
    bool framingHasLength;
    bool framingChunked;

    /// <summary>私有构造：200 / keep-alive 的默认状态，由各静态工厂使用。</summary>
    HttpResponse() {
        this.statusCode = 200;
        this.statusText = "OK";
        this.body = "";
        this.bodyBytes = null;
        this.bodyBytesLen = 0;
        this.contentType = "text/html";
        this.headers = new List<string>();
        this.keepAlive = true;
        this.framingLength = 0;
        this.framingHasLength = false;
        this.framingChunked = false;
    }

    /// <summary>用给定正文创建 200 OK 响应。</summary>
    static HttpResponse Ok(string body) {
        HttpResponse resp = new HttpResponse();
        resp.body = body;
        return resp;
    }

    /// <summary>创建 JSON 响应。</summary>
    static HttpResponse Json(string jsonBody) {
        HttpResponse resp = new HttpResponse();
        resp.body = jsonBody;
        resp.contentType = "application/json";
        return resp;
    }

    /// <summary>创建纯文本响应。</summary>
    static HttpResponse Text(string text) {
        HttpResponse resp = new HttpResponse();
        resp.body = text;
        resp.contentType = "text/plain";
        return resp;
    }

    /// <summary>
    /// 用二进制正文创建响应。正文按 <paramref name="len"/> 字节
    /// 原样发送，内嵌 NUL 不会截断报文。
    /// </summary>
    static HttpResponse Bytes(byte[] data, int len, string ct) {
        HttpResponse resp = new HttpResponse();
        resp.bodyBytes = data;
        resp.bodyBytesLen = len;
        resp.contentType = ct;
        return resp;
    }

    /// <summary>正文字节数（文本或二进制）。</summary>
    int BodyLength() {
        if (this.bodyBytes != null) { return this.bodyBytesLen; }
        return this.body.Length;
    }

    /// <summary>正文是否为二进制缓冲区。</summary>
    bool IsBinary() { return this.bodyBytes != null; }

    /// <summary>字符串是否含 CR/LF（头部注入检查用）。</summary>
    static bool HasCrlf(string s) {
        return s.IndexOf("\r") >= 0 || s.IndexOf("\n") >= 0;
    }

    /// <summary>头部名/值是否不含会破坏报文分帧或被下游误读的字符：
    /// 值禁所有控制字符（HTAB 除外）与 DEL——只禁 NUL/CR/LF 会让
    /// 0x01 这类 CTL 溜进报文，宽容下游可能按不同规则切分；名字另禁
    /// 冒号——否则可夹带出第二个头字段（头注入）。名字按 HTTP token
    /// 字符集判定。
    /// <paramref name="isName"/> 为 true 时按名字判定。</summary>
    static bool HeaderFramingSafe(bool isName, string s) {
        for (int i = 0; i < s.Length; i = i + 1) {
            int ch = s[i] & 255;
            if (isName) {
                if (!((ch >= 48 && ch <= 57)
                    || (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122)
                    || ch == 33 || ch == 35 || ch == 36 || ch == 37
                    || ch == 38 || ch == 39 || ch == 42 || ch == 43
                    || ch == 45 || ch == 46 || ch == 94 || ch == 95
                    || ch == 96 || ch == 124 || ch == 126)) { return false; }
            } else {
                if (ch == 127 || (ch < 32 && ch != 9)) { return false; }
            }
        }
        return true;
    }

    /// <summary>头部名与值是否可安全写入：名字非空且无冒号，两者都
    /// 不含分帧字符。请求侧（HttpClient）与响应侧共用同一防线。</summary>
    static bool IsValidHeader(string name, string value) {
        return name.Length > 0 && HttpResponse.HeaderFramingSafe(true, name)
            && HttpResponse.HeaderFramingSafe(false, value);
    }

    /// <summary>创建重定向响应。Location 不允许注入折行；非法值
    /// 被保守拒绝，不产生一个可被下游解释的重定向头。</summary>
    static HttpResponse Redirect(string url) {
        HttpResponse resp = new HttpResponse();
        if (HttpResponse.HasCrlf(url)) {
            resp.statusCode = 400;
            resp.statusText = "Bad Request";
            resp.body = "";
            return resp;
        }
        resp.statusCode = 302;
        resp.statusText = "Found";
        resp.headers.Add("Location: " + url);
        return resp;
    }

    /// <summary>创建 404 Not Found 响应。</summary>
    static HttpResponse NotFound() {
        HttpResponse resp = new HttpResponse();
        resp.statusCode = 404;
        resp.statusText = "Not Found";
        resp.body = "<h1>404 Not Found</h1>";
        return resp;
    }

    /// <summary>创建 500 Internal Server Error 响应。message 原样进入
    /// HTML 正文，先做 HTML 转义：消息里常含异常文本、URL 或用户
    /// 输入片段，未转义就是把反射型 XSS 内置在错误页里。</summary>
    static HttpResponse ServerError(string message) {
        HttpResponse resp = new HttpResponse();
        resp.statusCode = 500;
        resp.statusText = "Internal Server Error";
        resp.body = "<h1>500 Internal Server Error</h1><p>"
            + HttpResponse.EscapeHtmlText(message) + "</p>";
        return resp;
    }

    /// 最小 HTML 实体转义（& < > " '），供内嵌消息进正文用。
    static string EscapeHtmlText(string text) {
        if (text == null) { return ""; }
        int len = text.Length;
        StringBuilder html = null;
        int last = 0;
        for (int i = 0; i < len; i = i + 1) {
            int c = text[i] & 255;
            string esc = null;
            if (c == 38) { esc = "&amp;"; }
            else if (c == 60) { esc = "&lt;"; }
            else if (c == 62) { esc = "&gt;"; }
            else if (c == 34) { esc = "&quot;"; }
            else if (c == 39) { esc = "&#39;"; }
            if (esc != null) {
                if (html == null) { html = new StringBuilder(); }
                if (i > last) { html.Append(text.Substring(last, i - last)); }
                html.Append(esc);
                last = i + 1;
            }
        }
        if (html == null) { return text; }
        if (last < len) { html.Append(text.Substring(last, len - last)); }
        return html.ToString();
    }

    /// <summary>用自定义状态码创建响应。</summary>
    static HttpResponse WithStatus(int code, string text, string body) {
        HttpResponse resp = new HttpResponse();
        resp.statusCode = code;
        if (!HttpResponse.HasCrlf(text)) { resp.statusText = text; }
        resp.body = body;
        return resp;
    }

    /// <summary>主动释放响应持有的头部存储。</summary>
    void Dispose() {
        if (this.headers != null) {
            this.headers.Clear();
            this.headers = null;
        }
        this.bodyBytes = null;
        this.bodyBytesLen = 0;
    }

    /// <summary>设置响应头。定界与连接模式由 BuildHeadersSb 唯一生成；
    /// 拒绝这些保留字段，避免客户端看到相互矛盾的长度或分块边界。</summary>
    HttpResponse SetHeader(string name, string headerValue) {
        if (!HttpResponse.IsValidHeader(name, headerValue)) {
            return this;
        }
        string lower = name.ToLower();
        if (lower == "content-length" || lower == "transfer-encoding"
            || lower == "connection") { return this; }
        this.headers.Add(name + ": " + headerValue);
        return this;
    }

    /// <summary>Returns one response header by name. Header names are
    /// case-insensitive as required by HTTP; an absent header returns "".</summary>
    string GetHeader(string name) {
        if (name.Length == 0 || this.headers == null) { return ""; }
        string want = name.ToLower();
        for (int i = 0; i < this.headers.Count; i = i + 1) {
            string line = this.headers[i];
            int colon = line.IndexOf(":");
            if (colon <= 0) { continue; }
            string got = line.Substring(0, colon).Trim().ToLower();
            if (got == want) { return line.Substring(colon + 1).Trim(); }
        }
        return "";
    }

    /// <summary>设置 content type。</summary>
    HttpResponse SetContentType(string ct) {
        if (!HttpResponse.HasCrlf(ct)) { this.contentType = ct; }
        return this;
    }

    /// <summary>设置连接模式。</summary>
    HttpResponse SetKeepAlive(bool keep) {
        this.keepAlive = keep;
        return this;
    }

    /// <summary>
    /// 构建包含状态行与所有头部的 StringBuilder（含结尾空行 CRLF）。
    /// </summary>
    StringBuilder BuildHeadersSb() {
        StringBuilder sb = new StringBuilder();
        sb.Append("HTTP/1.1 ");
        if (this.statusCode == 200) {
            sb.Append("200");
        } else {
            sb.Append(Convert.ToString(this.statusCode));
        }
        sb.Append(" ");
        sb.Append(this.statusText);
        sb.Append("\r\n");

        sb.Append("Content-Type: ");
        sb.Append(this.contentType);
        sb.Append("\r\n");

        sb.Append("Content-Length: ");
        sb.Append(Convert.ToString(this.BodyLength()));
        sb.Append("\r\n");

        if (this.keepAlive) {
            sb.Append("Connection: keep-alive\r\n");
        } else {
            sb.Append("Connection: close\r\n");
        }

        sb.Append("Server: Zan/1.0\r\n");

        for (int i = 0; i < this.headers.Count; i = i + 1) {
            sb.Append(this.headers[i]);
            sb.Append("\r\n");
        }

        sb.Append("\r\n");
        return sb;
    }

    /// <summary>
    /// 只序列化状态行与头部（含结尾空行）。二进制正文时
    /// 调用方先发这个字符串，再按字节发 <c>bodyBytes</c>。
    /// </summary>
    string BuildHeaders() {
        return this.BuildHeadersSb().ToString();
    }

    /// <summary>
    /// 将响应序列化为原始 HTTP 响应字符串。仅适用于文本正文；
    /// 头部与正文在同一个 StringBuilder 内完成拼装，消除二次大内存分配。
    /// 二进制正文请用 <see cref="BuildHeaders"/> + <c>bodyBytes</c>。
    /// </summary>
    string Build() {
        if (this.body == null || this.body.Length == 0) {
            return this.BuildHeaders();
        }
        StringBuilder sb = this.BuildHeadersSb();
        sb.Append(this.body);
        return sb.ToString();
    }

    /// <summary>是否为可选空白（SP / HTAB，RFC 7230 OWS）。</summary>
    static bool IsOws(int c) {
        return c == 32 || c == 9;
    }

    /// <summary>[start, stop) 起点跳过 OWS，返回首个非 OWS 字节下标。</summary>
    static int TrimOwsStart(string s, int start, int stop) {
        while (start < stop && HttpResponse.IsOws(s[start] & 255)) {
            start = start + 1;
        }
        return start;
    }

    /// <summary>[start, stop) 终点回退 OWS，返回尾后第一个非 OWS 下标。</summary>
    static int TrimOwsStop(string s, int start, int stop) {
        while (stop > start && HttpResponse.IsOws(s[stop - 1] & 255)) {
            stop = stop - 1;
        }
        return stop;
    }

    /// <summary>Parse response framing independently from the strict request
    /// parser. Conflicting/invalid lengths and unsupported transfer codings
    /// fail closed before any body is read.</summary>
    bool ParseFraming() {
        bool sawTe = false;
        string encoding = "";
        for (int i = 0; i < this.headers.Count; i = i + 1) {
            string line = this.headers[i];
            int colon = line.IndexOf(":");
            if (colon <= 0) { continue; }
            string name = line.Substring(0, colon).ToLower();
            string value = line.Substring(colon + 1).Trim();
            if (name == "content-length") {
                if (value.Length == 0) { return false; }
                long length = 0;
                for (int j = 0; j < value.Length; j = j + 1) {
                    int digit = value[j] & 255;
                    if (digit < 48 || digit > 57) { return false; }
                    int digitValue = digit - 48;
                    if (length > (2147483647 - digitValue) / 10) { return false; }
                    length = length * 10 + digitValue;
                }
                if (this.framingHasLength && this.framingLength != (int)length) {
                    return false;
                }
                this.framingHasLength = true;
                this.framingLength = (int)length;
            } else if (name == "transfer-encoding") {
                if (sawTe || value.Length == 0) { return false; }
                sawTe = true;
                encoding = value.ToLower();
            }
        }
        if (sawTe && this.framingHasLength) { return false; }
        if (sawTe && encoding != "chunked") { return false; }
        this.framingChunked = sawTe;
        return true;
    }

    /// <summary>状态行严格校验：HTTP/1.0|HTTP/1.1 + 至少一个 OWS +
    /// 三位状态码（1xx-5xx）+ 可选 OWS reason（不含控制字符，HTAB
    /// 除外）。版本与状态码间缺 OWS、状态码带后缀（"HTTP/1.1x 200"）
    /// 或 600+ 一律拒绝——否则状态码可被下游按不同切分方式读出。</summary>
    static bool ValidStatusLine(string line) {
        if (line.Length < 12) { return false; }
        string ver = line.Substring(0, 8);
        if (ver != "HTTP/1.0" && ver != "HTTP/1.1") { return false; }
        if (!HttpResponse.IsOws(line[8] & 255)) { return false; }
        int codeStart = HttpResponse.TrimOwsStart(line, 8, line.Length);
        if (codeStart + 3 > line.Length) { return false; }
        int first = (line[codeStart] & 255) - 48;
        if (first < 1 || first > 5) { return false; }
        for (int i = codeStart; i < codeStart + 3; i = i + 1) {
            int c = line[i] & 255;
            if (c < 48 || c > 57) { return false; }
        }
        if (codeStart + 3 < line.Length) {
            int c4 = line[codeStart + 3] & 255;
            if (c4 >= 48 && c4 <= 57) { return false; }
        }
        for (int i = codeStart + 3; i < line.Length; i = i + 1) {
            int c = line[i] & 255;
            if ((c < 32 && c != 9) || c == 127) { return false; }
        }
        return true;
    }

    /// <summary>解析原始 HTTP 响应（客户端用法）。状态行、字段行或
    /// 分帧不合法时返回 statusCode=0 的空响应——合法状态码恒 >= 100，
    /// 调用方以 <100 判定拒收并断开链路；绝不把畸形报文解释成
    /// "200 空响应"（响应错位的起点）。</summary>
    static HttpResponse Parse(string raw) {
        HttpResponse resp = new HttpResponse();
        if (raw == null) { resp.statusCode = 0; return resp; }
        int len = raw.Length;
        int lineEnd = raw.IndexOf("\r\n");
        if (lineEnd < 0) { resp.statusCode = 0; return resp; }
        string statusLine = raw.Substring(0, lineEnd);
        if (!HttpResponse.ValidStatusLine(statusLine)) {
            resp.statusCode = 0;
            return resp;
        }
        int codeStart = HttpResponse.TrimOwsStart(statusLine, 8,
            statusLine.Length);
        resp.statusCode = ((statusLine[codeStart] & 255) - 48) * 100
            + ((statusLine[codeStart + 1] & 255) - 48) * 10
            + ((statusLine[codeStart + 2] & 255) - 48);
        if (codeStart + 3 < statusLine.Length) {
            int rs = HttpResponse.TrimOwsStart(statusLine, codeStart + 3,
                statusLine.Length);
            int rstop = HttpResponse.TrimOwsStop(statusLine, rs,
                statusLine.Length);
            resp.statusText = rs < rstop
                ? statusLine.Substring(rs, rstop - rs) : "";
        } else {
            resp.statusText = "";
        }

        // 头部逐行到空行；无冒号、冒号前空白、含控制字符的行整体拒收，
        // 不再静默跳过（跳过正是走私头存活的缝隙）。
        int pos = lineEnd + 2;
        bool ended = false;
        while (pos < len) {
            int hEnd = raw.IndexOf("\r\n", pos);
            if (hEnd < 0) { resp.statusCode = 0; return resp; }
            if (hEnd == pos) { pos = hEnd + 2; ended = true; break; }
            string headerLine = raw.Substring(pos, hEnd - pos);
            int colon = headerLine.IndexOf(":");
            if (colon <= 0
                || !HttpResponse.HeaderFramingSafe(true,
                    headerLine.Substring(0, colon))
                || !HttpResponse.HeaderFramingSafe(false,
                    headerLine.Substring(colon + 1))) {
                resp.statusCode = 0;
                return resp;
            }
            resp.headers.Add(headerLine);
            string name = headerLine.Substring(0, colon).ToLower();
            if (name == "content-type") {
                int valueStart = HttpResponse.TrimOwsStart(headerLine,
                    colon + 1, headerLine.Length);
                int valueStop = HttpResponse.TrimOwsStop(headerLine,
                    valueStart, headerLine.Length);
                resp.contentType = headerLine.Substring(valueStart,
                    valueStop - valueStart);
            }
            pos = hEnd + 2;
        }
        if (!ended || !resp.ParseFraming()) {
            resp.statusCode = 0;
            return resp;
        }
        if (pos < len) { resp.body = raw.Substring(pos); }
        return resp;
    }
}
