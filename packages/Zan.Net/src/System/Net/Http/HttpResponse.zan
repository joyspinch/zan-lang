using System;

namespace System.Net.Http;

// 分块传输的正文来源：服务器发出响应头后反复调用它取下一段正文，
// 返回 null 或空数组表示正文结束（服务器随后写结束块收尾）。
public async delegate byte[] HttpChunkSource();

// HTTP 响应的构建器与解析器。
public class HttpResponse : IDisposable {
    public int statusCode;
    public string statusText;
    public string body;
    // 二进制正文（与 body 二选一）。
    public byte[] bodyBytes;
    public int bodyBytesLen;
    public string contentType;
    public List<string> headers;
    public bool keepAlive;
    public int framingLength;
    public bool framingHasLength;
    public bool framingChunked;
    public HttpChunkSource chunkSource;
    public bool contentDecoded;
    public string contentEncoding;

    public HttpResponse() {
        this.statusCode = 200;
        this.statusText = "OK";
        this.body = "";
        this.bodyBytes = null;
        this.bodyBytesLen = 0;
        this.contentType = "text/html";
        this.headers = new List<string>();
        this.keepAlive = true;
        this.framingLength = 0;
        this.framingHasLength = false;
        this.framingChunked = false;
        this.chunkSource = null;
        this.contentDecoded = false;
        this.contentEncoding = "";
    }

    public static HttpResponse Ok(string body) {
        HttpResponse resp = new HttpResponse();
        resp.body = body;
        return resp;
    }

    public static HttpResponse Json(string jsonBody) {
        HttpResponse resp = new HttpResponse();
        resp.body = jsonBody;
        resp.contentType = "application/json";
        return resp;
    }

    public static HttpResponse Text(string text) {
        HttpResponse resp = new HttpResponse();
        resp.body = text;
        resp.contentType = "text/plain";
        return resp;
    }

    public static HttpResponse Html(string html) {
        HttpResponse resp = new HttpResponse();
        resp.body = html;
        resp.contentType = "text/html";
        return resp;
    }

    public static HttpResponse Bytes(byte[] data, int len, string ct) {
        HttpResponse resp = new HttpResponse();
        resp.bodyBytes = data;
        resp.bodyBytesLen = len;
        resp.contentType = ct;
        return resp;
    }

    public int BodyLength() {
        if (this.bodyBytes != null) { return this.bodyBytesLen; }
        return this.body.Length;
    }

    public bool IsBinary() { return this.bodyBytes != null; }

    public static bool HasCrlf(string s) {
        if (s == null || s.Length == 0) { return false; }
        return NativeMemory.IndexOfAny((nint)s, s.Length, 13, 10) >= 0;
    }

    internal static bool HeaderFramingSafe(bool isName, string s) {
        if (s == null) { return false; }
        return HttpResponse.HeaderFramingSafeRange(isName, s, 0, s.Length);
    }

    internal static bool HeaderFramingSafeRange(bool isName, string s, int start, int end) {
        if (isName) {
            for (int i = start; i < end; i = i + 1) {
                int ch = s[i] & 255;
                if (!((ch >= 97 && ch <= 122) || (ch >= 65 && ch <= 90) || ch == 45
                    || (ch >= 48 && ch <= 57) || ch == 95 || ch == 46
                    || ch == 33 || ch == 35 || ch == 36 || ch == 37
                    || ch == 38 || ch == 39 || ch == 42 || ch == 43
                    || ch == 94 || ch == 96 || ch == 124 || ch == 126)) { return false; }
            }
            return true;
        }
        for (int i = start; i < end; i = i + 1) {
            int ch = s[i] & 255;
            if (ch == 127 || (ch < 32 && ch != 9)) { return false; }
        }
        return true;
    }

    public static bool IsValidHeader(string name, string value) {
        return name != null && name.Length > 0 && HttpResponse.HeaderFramingSafe(true, name)
            && HttpResponse.HeaderFramingSafe(false, value);
    }

    public static HttpResponse Redirect(string url) {
        HttpResponse resp = new HttpResponse();
        if (url == null || url.Length == 0 || HttpResponse.HasCrlf(url)) {
            resp.statusCode = 400;
            resp.statusText = "Bad Request";
            resp.body = "";
            return resp;
        }
        resp.statusCode = 302;
        resp.statusText = "Found";
        resp.headers.Add("Location: " + url);
        return resp;
    }

    public static HttpResponse MovedPermanently(string url) {
        HttpResponse resp = new HttpResponse();
        if (url == null || url.Length == 0 || HttpResponse.HasCrlf(url)) {
            resp.statusCode = 400;
            resp.statusText = "Bad Request";
            resp.body = "";
            return resp;
        }
        resp.statusCode = 301;
        resp.statusText = "Moved Permanently";
        resp.headers.Add("Location: " + url);
        return resp;
    }

    public static HttpResponse TemporaryRedirect(string url) {
        HttpResponse resp = new HttpResponse();
        if (url == null || url.Length == 0 || HttpResponse.HasCrlf(url)) {
            resp.statusCode = 400;
            resp.statusText = "Bad Request";
            resp.body = "";
            return resp;
        }
        resp.statusCode = 307;
        resp.statusText = "Temporary Redirect";
        resp.headers.Add("Location: " + url);
        return resp;
    }

    public static HttpResponse PermanentRedirect(string url) {
        HttpResponse resp = new HttpResponse();
        if (url == null || url.Length == 0 || HttpResponse.HasCrlf(url)) {
            resp.statusCode = 400;
            resp.statusText = "Bad Request";
            resp.body = "";
            return resp;
        }
        resp.statusCode = 308;
        resp.statusText = "Permanent Redirect";
        resp.headers.Add("Location: " + url);
        return resp;
    }

    public static HttpResponse Created(string location, string body) {
        HttpResponse resp = new HttpResponse();
        resp.statusCode = 201;
        resp.statusText = "Created";
        resp.body = body != null ? body : "";
        if (location != null && location.Length > 0 && !HttpResponse.HasCrlf(location)) {
            resp.headers.Add("Location: " + location);
        }
        return resp;
    }

    public static HttpResponse NoContent() {
        HttpResponse resp = new HttpResponse();
        resp.statusCode = 204;
        resp.statusText = "No Content";
        resp.body = "";
        return resp;
    }

    public static HttpResponse BadRequest(string message) {
        HttpResponse resp = new HttpResponse();
        resp.statusCode = 400;
        resp.statusText = "Bad Request";
        string msgHtml = (message != null && message.Length > 0) ? "<p>" + HttpResponse.EscapeHtmlText(message) + "</p>" : "";
        resp.body = "<h1>400 Bad Request</h1>" + msgHtml;
        return resp;
    }

    public static HttpResponse Unauthorized(string realm) {
        HttpResponse resp = new HttpResponse();
        resp.statusCode = 401;
        resp.statusText = "Unauthorized";
        resp.body = "<h1>401 Unauthorized</h1>";
        if (realm != null && realm.Length > 0 && HttpResponse.HeaderFramingSafe(false, realm)) {
            bool safeQuoted = true;
            for (int i = 0; i < realm.Length; i = i + 1) {
                int c = realm[i] & 255;
                if (c == 34 || c == 92) { safeQuoted = false; break; }
            }
            if (safeQuoted) {
                resp.headers.Add("WWW-Authenticate: Basic realm=\"" + realm + "\"");
            }
        }
        return resp;
    }

    public static HttpResponse Forbidden(string message) {
        HttpResponse resp = new HttpResponse();
        resp.statusCode = 403;
        resp.statusText = "Forbidden";
        string msgHtml = (message != null && message.Length > 0) ? "<p>" + HttpResponse.EscapeHtmlText(message) + "</p>" : "";
        resp.body = "<h1>403 Forbidden</h1>" + msgHtml;
        return resp;
    }

    public static HttpResponse NotFound() {
        HttpResponse resp = new HttpResponse();
        resp.statusCode = 404;
        resp.statusText = "Not Found";
        resp.body = "<h1>404 Not Found</h1>";
        return resp;
    }

    public static HttpResponse MethodNotAllowed(string allow) {
        HttpResponse resp = new HttpResponse();
        resp.statusCode = 405;
        resp.statusText = "Method Not Allowed";
        resp.body = "<h1>405 Method Not Allowed</h1>";
        if (allow != null && allow.Length > 0 && !HttpResponse.HasCrlf(allow)) {
            resp.headers.Add("Allow: " + allow);
        }
        return resp;
    }

    public static HttpResponse Conflict(string message) {
        HttpResponse resp = new HttpResponse();
        resp.statusCode = 409;
        resp.statusText = "Conflict";
        string msgHtml = (message != null && message.Length > 0) ? "<p>" + HttpResponse.EscapeHtmlText(message) + "</p>" : "";
        resp.body = "<h1>409 Conflict</h1>" + msgHtml;
        return resp;
    }

    public static HttpResponse ServerError(string message) {
        HttpResponse resp = new HttpResponse();
        resp.statusCode = 500;
        resp.statusText = "Internal Server Error";
        string m = message != null ? message : "";
        int len = m.Length;
        int extra = 0;
        for (int i = 0; i < len; i = i + 1) {
            int c = m[i] & 255;
            if (c == 38 || c == 39) { extra = extra + 4; }
            else if (c == 60 || c == 62) { extra = extra + 3; }
            else if (c == 34) { extra = extra + 5; }
        }
        // 单缓冲直出 "<h1>500 Internal Server Error</h1><p>" + escaped + "</p>"
        byte[] buf = new byte[37 + len + extra + 4];
        nint dst = (nint)buf;
        NativeMemory.Copy(dst, (nint)"<h1>500 Internal Server Error</h1><p>", 37);
        int pos = 37;
        if (extra == 0) {
            if (len > 0) { NativeMemory.Copy(dst + (nint)pos, (nint)m, len); pos = pos + len; }
        } else {
            nint src = (nint)m;
            int last = 0;
            for (int i = 0; i < len; i = i + 1) {
                int c = m[i] & 255;
                if (c == 38 || c == 60 || c == 62 || c == 34 || c == 39) {
                    if (i > last) { NativeMemory.Copy(dst + (nint)pos, src + (nint)last, i - last); pos = pos + (i - last); }
                    if (c == 38) { buf[pos] = 38; buf[pos+1] = 97; buf[pos+2] = 109; buf[pos+3] = 112; buf[pos+4] = 59; pos = pos + 5; }
                    else if (c == 60) { buf[pos] = 38; buf[pos+1] = 108; buf[pos+2] = 116; buf[pos+3] = 59; pos = pos + 4; }
                    else if (c == 62) { buf[pos] = 38; buf[pos+1] = 103; buf[pos+2] = 116; buf[pos+3] = 59; pos = pos + 4; }
                    else if (c == 34) { buf[pos] = 38; buf[pos+1] = 113; buf[pos+2] = 117; buf[pos+3] = 111; buf[pos+4] = 116; buf[pos+5] = 59; pos = pos + 6; }
                    else { buf[pos] = 38; buf[pos+1] = 35; buf[pos+2] = 51; buf[pos+3] = 57; buf[pos+4] = 59; pos = pos + 5; }
                    last = i + 1;
                }
            }
            if (len > last) { NativeMemory.Copy(dst + (nint)pos, src + (nint)last, len - last); pos = pos + (len - last); }
        }
        buf[pos] = 60; buf[pos+1] = 47; buf[pos+2] = 112; buf[pos+3] = 62; pos = pos + 4;
        resp.body = NativeMemory.GetString(dst, 0, pos);
        return resp;
    }

    private static string EscapeHtmlText(string text) {
        if (text == null) { return ""; }
        int len = text.Length;
        int extra = 0;
        for (int i = 0; i < len; i = i + 1) {
            int c = text[i] & 255;
            if (c == 38 || c == 39) { extra = extra + 4; }
            else if (c == 60 || c == 62) { extra = extra + 3; }
            else if (c == 34) { extra = extra + 5; }
        }
        if (extra == 0) { return text; }
        byte[] buf = new byte[len + extra];
        nint dst = (nint)buf;
        nint src = (nint)text;
        int pos = 0;
        int last = 0;
        for (int i = 0; i < len; i = i + 1) {
            int c = text[i] & 255;
            if (c == 38 || c == 60 || c == 62 || c == 34 || c == 39) {
                int run = i - last;
                if (run > 0) { NativeMemory.Copy(dst + (nint)pos, src + (nint)last, run); pos = pos + run; }
                if (c == 38) { buf[pos] = 38; buf[pos+1] = 97; buf[pos+2] = 109; buf[pos+3] = 112; buf[pos+4] = 59; pos = pos + 5; }
                else if (c == 60) { buf[pos] = 38; buf[pos+1] = 108; buf[pos+2] = 116; buf[pos+3] = 59; pos = pos + 4; }
                else if (c == 62) { buf[pos] = 38; buf[pos+1] = 103; buf[pos+2] = 116; buf[pos+3] = 59; pos = pos + 4; }
                else if (c == 34) { buf[pos] = 38; buf[pos+1] = 113; buf[pos+2] = 117; buf[pos+3] = 111; buf[pos+4] = 116; buf[pos+5] = 59; pos = pos + 6; }
                else { buf[pos] = 38; buf[pos+1] = 35; buf[pos+2] = 51; buf[pos+3] = 57; buf[pos+4] = 59; pos = pos + 5; }
                last = i + 1;
            }
        }
        if (len > last) { NativeMemory.Copy(dst + (nint)pos, src + (nint)last, len - last); pos = pos + (len - last); }
        return NativeMemory.GetString(dst, 0, pos);
    }

    public static HttpResponse WithStatus(int code, string text, string body) {
        HttpResponse resp = new HttpResponse();
        resp.statusCode = code;
        if (!HttpResponse.HasCrlf(text)) { resp.statusText = text; }
        resp.body = body;
        return resp;
    }

    public void Dispose() {
        if (this.headers != null) {
            this.headers.Clear();
            this.headers = null;
        }
        this.bodyBytes = null;
        this.bodyBytesLen = 0;
        this.chunkSource = null;
    }

    // 设置响应头：全内联 token/值校验 + 长度预筛保留字段 + 单缓冲拼装（零跨单元调用）。
    public HttpResponse SetHeader(string name, string headerValue) {
        if (name == null || headerValue == null) { return this; }
        int nl = name.Length;
        if (nl == 0) { return this; }
        for (int i = 0; i < nl; i = i + 1) {
            int ch = name[i] & 255;
            if (!((ch >= 97 && ch <= 122) || (ch >= 65 && ch <= 90) || ch == 45
                || (ch >= 48 && ch <= 57) || ch == 95 || ch == 46
                || ch == 33 || ch == 35 || ch == 36 || ch == 37
                || ch == 38 || ch == 39 || ch == 42 || ch == 43
                || ch == 94 || ch == 96 || ch == 124 || ch == 126)) { return this; }
        }
        int vl = headerValue.Length;
        for (int i = 0; i < vl; i = i + 1) {
            int ch = headerValue[i] & 255;
            if (ch == 127 || (ch < 32 && ch != 9)) { return this; }
        }
        if (nl == 14) {
            if (((name[0] & 255) | 32) == 99 && ((name[7] & 255)) == 45
                && ((name[8] & 255) | 32) == 108 && ((name[13] & 255) | 32) == 104
                && HttpResponse.EqualsAsciiIgnoreCaseRange(name, 0, 14, "content-length")) { return this; }
        } else if (nl == 17) {
            if (((name[0] & 255) | 32) == 116 && ((name[8] & 255)) == 45
                && HttpResponse.EqualsAsciiIgnoreCaseRange(name, 0, 17, "transfer-encoding")) { return this; }
        } else if (nl == 10) {
            if (((name[0] & 255) | 32) == 99 && ((name[9] & 255) | 32) == 110
                && HttpResponse.EqualsAsciiIgnoreCaseRange(name, 0, 10, "connection")) { return this; }
        }
        byte[] buf = new byte[nl + 2 + vl];
        nint dst = (nint)buf;
        NativeMemory.Copy(dst, (nint)name, nl);
        buf[nl] = 58;
        buf[nl + 1] = 32;
        if (vl > 0) { NativeMemory.Copy(dst + (nint)(nl + 2), (nint)headerValue, vl); }
        this.headers.Add(NativeMemory.GetString(dst, 0, nl + 2 + vl));
        return this;
    }

    // 为响应添加 Set-Cookie 头 (RFC 6265)，严格拦截 ';'/'='/CTL 防属性与 CRLF 注入。
    public HttpResponse SetCookie(string name, string val, string path, int maxAge, bool secure, bool httpOnly) {
        if (name == null || name.Length == 0 || val == null) { return this; }
        for (int i = 0; i < name.Length; i = i + 1) {
            int c = name[i] & 255;
            if (c <= 32 || c >= 127 || c == 59 || c == 61) { return this; }
        }
        for (int i = 0; i < val.Length; i = i + 1) {
            int c = val[i] & 255;
            if (c < 32 || c >= 127 || c == 59) { return this; }
        }
        bool hasPath = false;
        if (path != null && path.Length > 0) {
            hasPath = true;
            for (int i = 0; i < path.Length; i = i + 1) {
                int c = path[i] & 255;
                if (c < 32 || c >= 127 || c == 59) { return this; }
            }
        }
        int total = 12 + name.Length + 1 + val.Length + (hasPath ? 7 + path.Length : 0)
            + (maxAge >= 0 ? 22 : 0) + (secure ? 8 : 0) + (httpOnly ? 10 : 0);
        byte[] buf = new byte[total];
        nint dst = (nint)buf;
        NativeMemory.Copy(dst, (nint)"Set-Cookie: ", 12);
        int pos = 12;
        NativeMemory.Copy(dst + (nint)pos, (nint)name, name.Length); pos = pos + name.Length;
        buf[pos] = 61; pos = pos + 1;
        if (val.Length > 0) { NativeMemory.Copy(dst + (nint)pos, (nint)val, val.Length); pos = pos + val.Length; }
        if (hasPath) {
            NativeMemory.Copy(dst + (nint)pos, (nint)"; Path=", 7); pos = pos + 7;
            NativeMemory.Copy(dst + (nint)pos, (nint)path, path.Length); pos = pos + path.Length;
        }
        if (maxAge >= 0) {
            NativeMemory.Copy(dst + (nint)pos, (nint)"; Max-Age=", 10); pos = pos + 10;
            if (maxAge == 0) { buf[pos] = 48; pos = pos + 1; }
            else {
                long x = (long)maxAge;
                int s = pos;
                while (x > 0L) { buf[pos] = (byte)(48L + (x % 10L)); pos = pos + 1; x = x / 10L; }
                int lo = s; int hi = pos - 1;
                while (lo < hi) { byte t = buf[lo]; buf[lo] = buf[hi]; buf[hi] = t; lo = lo + 1; hi = hi - 1; }
            }
        }
        if (secure) { NativeMemory.Copy(dst + (nint)pos, (nint)"; Secure", 8); pos = pos + 8; }
        if (httpOnly) { NativeMemory.Copy(dst + (nint)pos, (nint)"; HttpOnly", 10); pos = pos + 10; }
        this.headers.Add(NativeMemory.GetString(dst, 0, pos));
        return this;
    }

    private static bool EqualsAsciiIgnoreCaseRange(string s, int start, int stop, string target) {
        if (target == null || stop - start != target.Length) { return false; }
        int tlen = target.Length;
        for (int i = 0; i < tlen; i = i + 1) {
            int a = s[start + i] & 255;
            int b = target[i] & 255;
            if (a >= 65 && a <= 90) { a = a + 32; }
            if (b >= 65 && b <= 90) { b = b + 32; }
            if (a != b) { return false; }
        }
        return true;
    }

    public string GetHeader(string name) {
        if (name == null || name.Length == 0 || this.headers == null) { return ""; }
        int hc = this.headers.Count;
        int targetLen = name.Length;
        int firstLow = name[0] & 255;
        if (firstLow >= 65 && firstLow <= 90) { firstLow = firstLow + 32; }
        for (int i = 0; i < hc; i = i + 1) {
            string line = this.headers[i];
            int lineLen = line.Length;
            int colon = NativeMemory.Find((nint)line, 0, 58, lineLen);
            if (colon <= 0) { continue; }
            int l = 0;
            int r = colon;
            while (l < r && (line[l] & 255) <= 32) { l = l + 1; }
            while (r > l && (line[r - 1] & 255) <= 32) { r = r - 1; }
            if (r - l != targetLen) { continue; }
            int c0 = line[l] & 255;
            if (c0 >= 65 && c0 <= 90) { c0 = c0 + 32; }
            if (c0 != firstLow) { continue; }
            bool eq = true;
            for (int k = 1; k < targetLen; k = k + 1) {
                int a = line[l + k] & 255;
                int b = name[k] & 255;
                if (a >= 65 && a <= 90) { a = a + 32; }
                if (b >= 65 && b <= 90) { b = b + 32; }
                if (a != b) { eq = false; break; }
            }
            if (eq) {
                int vs = colon + 1;
                int ve = lineLen;
                while (vs < ve && (line[vs] & 255) <= 32) { vs = vs + 1; }
                while (ve > vs && (line[ve - 1] & 255) <= 32) { ve = ve - 1; }
                return vs < ve ? line.Substring(vs, ve - vs) : "";
            }
        }
        return "";
    }

    public HttpResponse SetContentType(string ct) {
        if (!HttpResponse.HasCrlf(ct)) { this.contentType = ct; }
        return this;
    }

    public HttpResponse SetKeepAlive(bool keep) {
        this.keepAlive = keep;
        return this;
    }

    public HttpResponse SetChunked(HttpChunkSource source) {
        this.chunkSource = source;
        this.framingChunked = true;
        return this;
    }

    public HttpResponse SetChunked() { return this.SetChunked(null); }

    public void WriteHeadersTo(StringBuilder sb) {
        int code = this.statusCode;
        if (code == 200 && this.statusText == "OK") {
            sb.Append("HTTP/1.1 200 OK\r\n");
        } else if (code == 404 && this.statusText == "Not Found") {
            sb.Append("HTTP/1.1 404 Not Found\r\n");
        } else if (code == 500 && this.statusText == "Internal Server Error") {
            sb.Append("HTTP/1.1 500 Internal Server Error\r\n");
        } else {
            sb.Append("HTTP/1.1 ");
            sb.Append(code);
            sb.Append(" ");
            sb.Append(this.statusText);
            sb.Append("\r\n");
        }

        if (this.contentType == "application/json") {
            sb.Append("Content-Type: application/json\r\n");
        } else if (this.contentType == "text/html") {
            sb.Append("Content-Type: text/html\r\n");
        } else if (this.contentType == "text/plain") {
            sb.Append("Content-Type: text/plain\r\n");
        } else {
            sb.Append("Content-Type: ");
            sb.Append(this.contentType);
            sb.Append("\r\n");
        }

        bool statusForbidsContentLength = (code >= 100 && code < 200) || code == 204;
        if (this.framingChunked && !statusForbidsContentLength) {
            sb.Append("Transfer-Encoding: chunked\r\n");
        } else if (!statusForbidsContentLength) {
            int blen = this.BodyLength();
            if (blen == 0) {
                sb.Append("Content-Length: 0\r\n");
            } else {
                sb.Append("Content-Length: ");
                sb.Append(blen);
                sb.Append("\r\n");
            }
        }

        if (this.keepAlive) {
            sb.Append("Connection: keep-alive\r\nServer: Zan/1.0\r\n");
        } else {
            sb.Append("Connection: close\r\nServer: Zan/1.0\r\n");
        }

        for (int i = 0; i < this.headers.Count; i = i + 1) {
            sb.Append(this.headers[i]);
            sb.Append("\r\n");
        }

        sb.Append("\r\n");
    }

    public void WriteTo(StringBuilder sb) {
        this.WriteHeadersTo(sb);
        if (!this.framingChunked && this.body != null && this.body.Length > 0) {
            sb.Append(this.body);
        }
    }

    // 单缓冲全内联直出 HTTP 响应报文（零跨单元辅助调用）。
    private string BuildDirect(bool includeBody) {
        int code = this.statusCode;
        string st = this.statusText != null ? this.statusText : "";
        string ct = this.contentType != null ? this.contentType : "";
        bool forbidsCl = (code >= 100 && code < 200) || code == 204;
        int blen = this.bodyBytes != null ? this.bodyBytesLen : (this.body != null ? this.body.Length : 0);
        int hc = this.headers.Count;
        int hdrBytes = 0;
        for (int i = 0; i < hc; i = i + 1) { hdrBytes = hdrBytes + this.headers[i].Length + 2; }
        int bodyCopyLen = (includeBody && !this.framingChunked && this.body != null) ? this.body.Length : 0;

        int total = 128 + st.Length + ct.Length + hdrBytes + bodyCopyLen;
        byte[] buf = new byte[total];
        nint dst = (nint)buf;
        int pos = 0;

        if (code == 200 && st == "OK") {
            NativeMemory.Copy(dst, (nint)"HTTP/1.1 200 OK\r\n", 17); pos = 17;
        } else {
            NativeMemory.Copy(dst, (nint)"HTTP/1.1 ", 9); pos = 9;
            if (code == 0) { buf[pos] = 48; pos = pos + 1; }
            else {
                long x = (long)code;
                if (x < 0L) { buf[pos] = 45; pos = pos + 1; x = -x; }
                int s = pos;
                while (x > 0L) { buf[pos] = (byte)(48L + (x % 10L)); pos = pos + 1; x = x / 10L; }
                int lo = s; int hi = pos - 1;
                while (lo < hi) { byte t = buf[lo]; buf[lo] = buf[hi]; buf[hi] = t; lo = lo + 1; hi = hi - 1; }
            }
            buf[pos] = 32; pos = pos + 1;
            if (st.Length > 0) { NativeMemory.Copy(dst + (nint)pos, (nint)st, st.Length); pos = pos + st.Length; }
            buf[pos] = 13; buf[pos + 1] = 10; pos = pos + 2;
        }

        NativeMemory.Copy(dst + (nint)pos, (nint)"Content-Type: ", 14); pos = pos + 14;
        if (ct.Length > 0) { NativeMemory.Copy(dst + (nint)pos, (nint)ct, ct.Length); pos = pos + ct.Length; }
        buf[pos] = 13; buf[pos + 1] = 10; pos = pos + 2;

        if (this.framingChunked && !forbidsCl) {
            NativeMemory.Copy(dst + (nint)pos, (nint)"Transfer-Encoding: chunked\r\n", 28); pos = pos + 28;
        } else if (!forbidsCl) {
            NativeMemory.Copy(dst + (nint)pos, (nint)"Content-Length: ", 16); pos = pos + 16;
            if (blen == 0) { buf[pos] = 48; pos = pos + 1; }
            else {
                long x = (long)blen;
                int s = pos;
                while (x > 0L) { buf[pos] = (byte)(48L + (x % 10L)); pos = pos + 1; x = x / 10L; }
                int lo = s; int hi = pos - 1;
                while (lo < hi) { byte t = buf[lo]; buf[lo] = buf[hi]; buf[hi] = t; lo = lo + 1; hi = hi - 1; }
            }
            buf[pos] = 13; buf[pos + 1] = 10; pos = pos + 2;
        }

        if (this.keepAlive) {
            NativeMemory.Copy(dst + (nint)pos, (nint)"Connection: keep-alive\r\nServer: Zan/1.0\r\n", 41);
            pos = pos + 41;
        } else {
            NativeMemory.Copy(dst + (nint)pos, (nint)"Connection: close\r\nServer: Zan/1.0\r\n", 36);
            pos = pos + 36;
        }

        for (int i = 0; i < hc; i = i + 1) {
            string h = this.headers[i];
            int hlen = h.Length;
            if (hlen > 0) { NativeMemory.Copy(dst + (nint)pos, (nint)h, hlen); pos = pos + hlen; }
            buf[pos] = 13; buf[pos + 1] = 10; pos = pos + 2;
        }
        buf[pos] = 13; buf[pos + 1] = 10; pos = pos + 2;

        if (bodyCopyLen > 0) {
            NativeMemory.Copy(dst + (nint)pos, (nint)this.body, bodyCopyLen);
            pos = pos + bodyCopyLen;
        }
        return NativeMemory.GetString(dst, 0, pos);
    }

    public string BuildHeaders() { return this.BuildDirect(false); }
    public string Build() { return this.BuildDirect(!this.framingChunked); }

    public bool ParseFraming() {
        bool sawTe = false;
        bool teChunked = false;
        int hc = this.headers.Count;
        for (int i = 0; i < hc; i = i + 1) {
            string line = this.headers[i];
            int lineLen = line.Length;
            int colon = NativeMemory.Find((nint)line, 0, 58, lineLen);
            if (colon <= 0) { continue; }
            if (colon == 14 && HttpResponse.EqualsAsciiIgnoreCaseRange(line, 0, 14, "content-length")) {
                int vs = colon + 1;
                int ve = lineLen;
                while (vs < ve && (line[vs] & 255) <= 32) { vs = vs + 1; }
                while (ve > vs && (line[ve - 1] & 255) <= 32) { ve = ve - 1; }
                if (vs >= ve) { return false; }
                long length = 0;
                for (int j = vs; j < ve; j = j + 1) {
                    int digit = line[j] & 255;
                    if (digit < 48 || digit > 57) { return false; }
                    int dv = digit - 48;
                    if (length > (2147483647 - dv) / 10) { return false; }
                    length = length * 10 + dv;
                }
                if (this.framingHasLength && this.framingLength != (int)length) { return false; }
                this.framingHasLength = true;
                this.framingLength = (int)length;
            } else if (colon == 17 && HttpResponse.EqualsAsciiIgnoreCaseRange(line, 0, 17, "transfer-encoding")) {
                int vs = colon + 1;
                int ve = lineLen;
                while (vs < ve && (line[vs] & 255) <= 32) { vs = vs + 1; }
                while (ve > vs && (line[ve - 1] & 255) <= 32) { ve = ve - 1; }
                if (sawTe || vs >= ve) { return false; }
                sawTe = true;
                teChunked = HttpResponse.EqualsAsciiIgnoreCaseRange(line, vs, ve, "chunked");
            }
        }
        if (sawTe && this.framingHasLength) { return false; }
        if (sawTe && !teChunked) { return false; }
        this.framingChunked = sawTe;
        return true;
    }

    // 解析原始 HTTP 响应（全内联单遍扫描：零状态行临时子串、零二次全头扫描、零跨单元辅助调用）。
    public static HttpResponse Parse(string raw) {
        HttpResponse resp = new HttpResponse();
        if (raw == null) { resp.statusCode = 0; return resp; }
        int len = raw.Length;
        if (len < 14) { resp.statusCode = 0; return resp; }
        nint ptr = (nint)raw;

        int lineEnd = -1;
        int scan0 = 0;
        while (scan0 < len) {
            int nl = NativeMemory.Find(ptr, scan0, 10, len - scan0);
            if (nl < 0) { break; }
            if (nl > 0 && (raw[nl - 1] & 255) == 13) { lineEnd = nl - 1; break; }
            scan0 = nl + 1;
        }
        if (lineEnd < 12) { resp.statusCode = 0; return resp; }

        if ((raw[0] & 255) != 72 || (raw[1] & 255) != 84 || (raw[2] & 255) != 84
            || (raw[3] & 255) != 80 || (raw[4] & 255) != 47 || (raw[5] & 255) != 49
            || (raw[6] & 255) != 46) {
            resp.statusCode = 0; return resp;
        }
        int minor = raw[7] & 255;
        if (minor != 48 && minor != 49) { resp.statusCode = 0; return resp; }
        int sep8 = raw[8] & 255;
        if (sep8 != 32 && sep8 != 9) { resp.statusCode = 0; return resp; }
        int codeStart = 8;
        while (codeStart < lineEnd && ((raw[codeStart] & 255) == 32 || (raw[codeStart] & 255) == 9)) {
            codeStart = codeStart + 1;
        }
        if (codeStart + 3 > lineEnd) { resp.statusCode = 0; return resp; }
        int d0 = (raw[codeStart] & 255) - 48;
        int d1 = (raw[codeStart + 1] & 255) - 48;
        int d2 = (raw[codeStart + 2] & 255) - 48;
        if (d0 < 1 || d0 > 5 || d1 < 0 || d1 > 9 || d2 < 0 || d2 > 9) {
            resp.statusCode = 0; return resp;
        }
        if (codeStart + 3 < lineEnd) {
            int c4 = raw[codeStart + 3] & 255;
            if (c4 >= 48 && c4 <= 57) { resp.statusCode = 0; return resp; }
            for (int k = codeStart + 3; k < lineEnd; k = k + 1) {
                int ch = raw[k] & 255;
                if ((ch < 32 && ch != 9) || ch == 127) { resp.statusCode = 0; return resp; }
            }
        }

        resp.statusCode = d0 * 100 + d1 * 10 + d2;
        if (codeStart + 3 < lineEnd) {
            int rs = codeStart + 3;
            while (rs < lineEnd && ((raw[rs] & 255) == 32 || (raw[rs] & 255) == 9)) { rs = rs + 1; }
            int rstop = lineEnd;
            while (rstop > rs && ((raw[rstop - 1] & 255) == 32 || (raw[rstop - 1] & 255) == 9)) { rstop = rstop - 1; }
            int rlen = rstop - rs;
            if (rlen == 2 && (raw[rs] & 255) == 79 && (raw[rs + 1] & 255) == 75) {
                resp.statusText = "OK";
            } else {
                resp.statusText = rlen > 0 ? raw.Substring(rs, rlen) : "";
            }
        } else {
            resp.statusText = "";
        }

        int pos = lineEnd + 2;
        bool ended = false;
        bool sawTe = false;
        bool teChunked = false;
        bool framingBad = false;
        while (pos < len) {
            int hEnd = -1;
            int scan = pos;
            while (scan < len) {
                int nl = NativeMemory.Find(ptr, scan, 10, len - scan);
                if (nl < 0) { break; }
                if (nl > pos && (raw[nl - 1] & 255) == 13) { hEnd = nl - 1; break; }
                scan = nl + 1;
            }
            if (hEnd < 0) { resp.statusCode = 0; return resp; }
            if (hEnd == pos) { pos = hEnd + 2; ended = true; break; }

            int colon = NativeMemory.Find(ptr, pos, 58, hEnd - pos);
            if (colon <= pos) { resp.statusCode = 0; return resp; }

            // 内联头部名 token 校验
            for (int k = pos; k < colon; k = k + 1) {
                int ch = raw[k] & 255;
                if (!((ch >= 97 && ch <= 122) || (ch >= 65 && ch <= 90) || ch == 45
                    || (ch >= 48 && ch <= 57) || ch == 95 || ch == 46
                    || ch == 33 || ch == 35 || ch == 36 || ch == 37
                    || ch == 38 || ch == 39 || ch == 42 || ch == 43
                    || ch == 94 || ch == 96 || ch == 124 || ch == 126)) {
                    resp.statusCode = 0; return resp;
                }
            }
            // 内联头部值 CTL 校验
            for (int k = colon + 1; k < hEnd; k = k + 1) {
                int ch = raw[k] & 255;
                if (ch == 127 || (ch < 32 && ch != 9)) {
                    resp.statusCode = 0; return resp;
                }
            }

            resp.headers.Add(raw.Substring(pos, hEnd - pos));

            int nameLen = colon - pos;
            if (nameLen == 12) {
                if (((raw[pos] & 255) | 32) == 99 && ((raw[pos + 1] & 255) | 32) == 111
                    && ((raw[pos + 2] & 255) | 32) == 110 && ((raw[pos + 3] & 255) | 32) == 116
                    && ((raw[pos + 4] & 255) | 32) == 101 && ((raw[pos + 5] & 255) | 32) == 110
                    && ((raw[pos + 6] & 255) | 32) == 116 && (raw[pos + 7] & 255) == 45
                    && ((raw[pos + 8] & 255) | 32) == 116 && ((raw[pos + 9] & 255) | 32) == 121
                    && ((raw[pos + 10] & 255) | 32) == 112 && ((raw[pos + 11] & 255) | 32) == 101) {
                    int vs = colon + 1;
                    int ve = hEnd;
                    while (vs < ve && ((raw[vs] & 255) == 32 || (raw[vs] & 255) == 9)) { vs = vs + 1; }
                    while (ve > vs && ((raw[ve - 1] & 255) == 32 || (raw[ve - 1] & 255) == 9)) { ve = ve - 1; }
                    resp.contentType = raw.Substring(vs, ve - vs);
                }
            } else if (nameLen == 14 && !framingBad) {
                if (((raw[pos] & 255) | 32) == 99 && ((raw[pos + 1] & 255) | 32) == 111
                    && ((raw[pos + 2] & 255) | 32) == 110 && ((raw[pos + 3] & 255) | 32) == 116
                    && ((raw[pos + 4] & 255) | 32) == 101 && ((raw[pos + 5] & 255) | 32) == 110
                    && ((raw[pos + 6] & 255) | 32) == 116 && (raw[pos + 7] & 255) == 45
                    && ((raw[pos + 8] & 255) | 32) == 108 && ((raw[pos + 9] & 255) | 32) == 101
                    && ((raw[pos + 10] & 255) | 32) == 110 && ((raw[pos + 11] & 255) | 32) == 103
                    && ((raw[pos + 12] & 255) | 32) == 116 && ((raw[pos + 13] & 255) | 32) == 104) {
                    int vs = colon + 1;
                    int ve = hEnd;
                    while (vs < ve && (raw[vs] & 255) <= 32) { vs = vs + 1; }
                    while (ve > vs && (raw[ve - 1] & 255) <= 32) { ve = ve - 1; }
                    if (vs >= ve) {
                        framingBad = true;
                    } else {
                        long cl = 0;
                        bool okNum = true;
                        for (int j = vs; j < ve; j = j + 1) {
                            int dg = raw[j] & 255;
                            if (dg < 48 || dg > 57) { okNum = false; break; }
                            int dv = dg - 48;
                            if (cl > (2147483647 - dv) / 10) { okNum = false; break; }
                            cl = cl * 10 + dv;
                        }
                        if (!okNum) { framingBad = true; }
                        else if (resp.framingHasLength && resp.framingLength != (int)cl) { framingBad = true; }
                        else { resp.framingHasLength = true; resp.framingLength = (int)cl; }
                    }
                }
            } else if (nameLen == 17 && !framingBad) {
                if (((raw[pos] & 255) | 32) == 116 && (raw[pos + 8] & 255) == 45
                    && HttpResponse.EqualsAsciiIgnoreCaseRange(raw, pos, colon, "transfer-encoding")) {
                    int vs = colon + 1;
                    int ve = hEnd;
                    while (vs < ve && (raw[vs] & 255) <= 32) { vs = vs + 1; }
                    while (ve > vs && (raw[ve - 1] & 255) <= 32) { ve = ve - 1; }
                    if (sawTe || vs >= ve) {
                        framingBad = true;
                    } else {
                        sawTe = true;
                        teChunked = (ve - vs == 7)
                            && ((raw[vs] & 255) | 32) == 99 && ((raw[vs + 1] & 255) | 32) == 104
                            && ((raw[vs + 2] & 255) | 32) == 117 && ((raw[vs + 3] & 255) | 32) == 110
                            && ((raw[vs + 4] & 255) | 32) == 107 && ((raw[vs + 5] & 255) | 32) == 101
                            && ((raw[vs + 6] & 255) | 32) == 100;
                    }
                }
            }
            pos = hEnd + 2;
        }
        if (!ended || framingBad || (sawTe && resp.framingHasLength) || (sawTe && !teChunked)) {
            resp.statusCode = 0;
            return resp;
        }
        resp.framingChunked = sawTe;
        if (pos < len) { resp.body = raw.Substring(pos); }
        return resp;
    }
}
