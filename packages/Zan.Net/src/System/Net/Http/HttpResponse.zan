using System;

namespace System.Net.Http;

// 分块传输的正文来源：服务器发出响应头后反复调用它取下一段正文，
// 返回 null 或空数组表示正文结束（服务器随后写结束块收尾）。
//
// 逐段产出而不是先拼出整个正文，是"长度未知也能开流"的前提：
// SSE、大文件下载、逐 token 的模型输出都能在第一段到达时就发出去。
public async delegate byte[] HttpChunkSource();

// HTTP 响应的构建器与解析器。
public class HttpResponse : IDisposable {
    public int statusCode;
    public string statusText;
    public string body;
    // 二进制正文（与 body 二选一）。Zan 字符串以 NUL 结尾，
    // 无法携带任意字节，因此图片/可执行文件等正文走 byte[]。
    public byte[] bodyBytes;
    public int bodyBytesLen;
    public string contentType;
    public List<string> headers;
    public bool keepAlive;
    public int framingLength;
    public bool framingHasLength;
    // 正文是否按分块传输编码定界。客户端解析时由 ParseFraming 置位，
    // 服务端发送时由 SetChunked 置位——同一个字段在两端是同一件事：
    // "这份响应的正文是分块framed的"。
    public bool framingChunked;
    // 分块正文来源（非 null 时以分块传输编码发送正文）。
    public HttpChunkSource chunkSource;
    // 正文是否已按 Content-Encoding 解码（gzip / deflate 等）。
    public bool contentDecoded;
    // 生效的内容编码名（未解码时为空串）。
    public string contentEncoding;

    // 默认构造：200 / keep-alive 的默认状态，由各静态工厂使用。
    public HttpResponse() {
        this.statusCode = 200;
        this.statusText = "OK";
        this.body = "";
        this.bodyBytes = null;
        this.bodyBytesLen = 0;
        this.contentType = "text/html";
        this.headers = new List<string>();
        this.keepAlive = true;
        this.framingLength = 0;
        this.framingHasLength = false;
        this.framingChunked = false;
        this.chunkSource = null;
        this.contentDecoded = false;
        this.contentEncoding = "";
    }

    // 用给定正文创建 200 OK 响应。
    public static HttpResponse Ok(string body) {
        HttpResponse resp = new HttpResponse();
        resp.body = body;
        return resp;
    }

    // 创建 JSON 响应。
    public static HttpResponse Json(string jsonBody) {
        HttpResponse resp = new HttpResponse();
        resp.body = jsonBody;
        resp.contentType = "application/json";
        return resp;
    }

    // 创建纯文本响应。
    public static HttpResponse Text(string text) {
        HttpResponse resp = new HttpResponse();
        resp.body = text;
        resp.contentType = "text/plain";
        return resp;
    }

    // 用二进制正文创建响应。正文按 <paramref name="len"/> 字节
    // 原样发送，内嵌 NUL 不会截断报文。
    public static HttpResponse Bytes(byte[] data, int len, string ct) {
        HttpResponse resp = new HttpResponse();
        resp.bodyBytes = data;
        resp.bodyBytesLen = len;
        resp.contentType = ct;
        return resp;
    }

    // 正文字节数（文本或二进制）。
    public int BodyLength() {
        if (this.bodyBytes != null) { return this.bodyBytesLen; }
        return this.body.Length;
    }

    // 正文是否为二进制缓冲区。
    public bool IsBinary() { return this.bodyBytes != null; }

    // 字符串是否含 CR/LF（头部注入检查用）。
    public static bool HasCrlf(string s) {
        return s.IndexOf("\r") >= 0 || s.IndexOf("\n") >= 0;
    }

    // 头部名/值是否不含会破坏报文分帧或被下游误读的字符：
    // 值禁所有控制字符（HTAB 除外）与 DEL——只禁 NUL/CR/LF 会让
    // 0x01 这类 CTL 溜进报文，宽容下游可能按不同规则切分；名字另禁
    // 冒号——否则可夹带出第二个头字段（头注入）。名字按 HTTP token
    // 字符集判定。
    // <paramref name="isName"/> 为 true 时按名字判定。
    internal static bool HeaderFramingSafe(bool isName, string s) {
        for (int i = 0; i < s.Length; i = i + 1) {
            int ch = s[i] & 255;
            if (isName) {
                if (!((ch >= 48 && ch <= 57)
                    || (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122)
                    || ch == 33 || ch == 35 || ch == 36 || ch == 37
                    || ch == 38 || ch == 39 || ch == 42 || ch == 43
                    || ch == 45 || ch == 46 || ch == 94 || ch == 95
                    || ch == 96 || ch == 124 || ch == 126)) { return false; }
            } else {
                if (ch == 127 || (ch < 32 && ch != 9)) { return false; }
            }
        }
        return true;
    }

    // 头部名与值是否可安全写入：名字非空且无冒号，两者都
    // 不含分帧字符。请求侧（HttpClient）与响应侧共用同一防线。
    public static bool IsValidHeader(string name, string value) {
        return name.Length > 0 && HttpResponse.HeaderFramingSafe(true, name)
            && HttpResponse.HeaderFramingSafe(false, value);
    }

    // 创建重定向响应。Location 不允许注入折行；非法值
    // 被保守拒绝，不产生一个可被下游解释的重定向头。
    public static HttpResponse Redirect(string url) {
        HttpResponse resp = new HttpResponse();
        if (HttpResponse.HasCrlf(url)) {
            resp.statusCode = 400;
            resp.statusText = "Bad Request";
            resp.body = "";
            return resp;
        }
        resp.statusCode = 302;
        resp.statusText = "Found";
        resp.headers.Add("Location: " + url);
        return resp;
    }

    // 创建 404 Not Found 响应。
    public static HttpResponse NotFound() {
        HttpResponse resp = new HttpResponse();
        resp.statusCode = 404;
        resp.statusText = "Not Found";
        resp.body = "<h1>404 Not Found</h1>";
        return resp;
    }

    // 创建 500 Internal Server Error 响应。message 原样进入
    // HTML 正文，先做 HTML 转义：消息里常含异常文本、URL 或用户
    // 输入片段，未转义就是把反射型 XSS 内置在错误页里。
    public static HttpResponse ServerError(string message) {
        HttpResponse resp = new HttpResponse();
        resp.statusCode = 500;
        resp.statusText = "Internal Server Error";
        resp.body = "<h1>500 Internal Server Error</h1><p>"
            + HttpResponse.EscapeHtmlText(message) + "</p>";
        return resp;
    }

    // 最小 HTML 实体转义（& < > " '），供内嵌消息进正文用。
    private static string EscapeHtmlText(string text) {
        if (text == null) { return ""; }
        int len = text.Length;
        StringBuilder html = null;
        int last = 0;
        for (int i = 0; i < len; i = i + 1) {
            int c = text[i] & 255;
            string esc = null;
            if (c == 38) { esc = "&amp;"; }
            else if (c == 60) { esc = "&lt;"; }
            else if (c == 62) { esc = "&gt;"; }
            else if (c == 34) { esc = "&quot;"; }
            else if (c == 39) { esc = "&#39;"; }
            if (esc != null) {
                if (html == null) { html = new StringBuilder(); }
                if (i > last) { html.Append(text.Substring(last, i - last)); }
                html.Append(esc);
                last = i + 1;
            }
        }
        if (html == null) { return text; }
        if (last < len) { html.Append(text.Substring(last, len - last)); }
        return html.ToString();
    }

    // 用自定义状态码创建响应。
    public static HttpResponse WithStatus(int code, string text, string body) {
        HttpResponse resp = new HttpResponse();
        resp.statusCode = code;
        if (!HttpResponse.HasCrlf(text)) { resp.statusText = text; }
        resp.body = body;
        return resp;
    }

    // 主动释放响应持有的头部存储。
    public void Dispose() {
        if (this.headers != null) {
            this.headers.Clear();
            this.headers = null;
        }
        this.bodyBytes = null;
        this.bodyBytesLen = 0;
        this.chunkSource = null;
    }

    // 设置响应头。定界与连接模式由 BuildHeadersSb 唯一生成；
    // 拒绝这些保留字段，避免客户端看到相互矛盾的长度或分块边界。
    public HttpResponse SetHeader(string name, string headerValue) {
        if (!HttpResponse.IsValidHeader(name, headerValue)) {
            return this;
        }
        string lower = name.ToLower();
        if (lower == "content-length" || lower == "transfer-encoding"
            || lower == "connection") { return this; }
        this.headers.Add(name + ": " + headerValue);
        return this;
    }

    public string GetHeader(string name) {
        if (name.Length == 0 || this.headers == null) { return ""; }
        string want = name.ToLower();
        for (int i = 0; i < this.headers.Count; i = i + 1) {
            string line = this.headers[i];
            int colon = line.IndexOf(":");
            if (colon <= 0) { continue; }
            string got = line.Substring(0, colon).Trim().ToLower();
            if (got == want) { return line.Substring(colon + 1).Trim(); }
        }
        return "";
    }

    // 设置 content type。
    public HttpResponse SetContentType(string ct) {
        if (!HttpResponse.HasCrlf(ct)) { this.contentType = ct; }
        return this;
    }

    // 设置连接模式。
    public HttpResponse SetKeepAlive(bool keep) {
        this.keepAlive = keep;
        return this;
    }

    // 改用分块传输编码发送正文：正文由 source 逐段产出，服务器在
    // 发出响应头（Transfer-Encoding: chunked，不带 Content-Length）
    // 之后反复取下一段并按块写出。source 为 null 时只发一个空正文
    // （立即写结束块）。source 返回空数组同样表示正文结束。
    //
    // 之前设在 body / bodyBytes 上的正文会被忽略——分块路径只认 source。
    //
    // 分块传输与 Content-Length 互斥（RFC 9112 §6.1）：两者同时出现
    // 的响应客户端必须拒收，所以这里由服务器独占定界方式的决定权，
    // SetHeader 也拒收外部塞进来的 transfer-encoding。
    public HttpResponse SetChunked(HttpChunkSource source) {
        this.chunkSource = source;
        this.framingChunked = true;
        return this;
    }

    // 空的分块正文：只发响应头与结束块（正文长度为零，但仍走分块定界）。
    public HttpResponse SetChunked() {
        return this.SetChunked(null);
    }

    // 将状态行与所有头部写入给定的 StringBuilder（含结尾空行 CRLF）。
    public void WriteHeadersTo(StringBuilder sb) {
        sb.Append("HTTP/1.1 ");
        int code = this.statusCode;
        if (code == 200) { sb.Append("200"); }
        else if (code == 404) { sb.Append("404"); }
        else if (code == 500) { sb.Append("500"); }
        else if (code == 400) { sb.Append("400"); }
        else if (code == 401) { sb.Append("401"); }
        else if (code == 403) { sb.Append("403"); }
        else if (code == 302) { sb.Append("302"); }
        else if (code == 301) { sb.Append("301"); }
        else if (code == 204) { sb.Append("204"); }
        else if (code == 405) { sb.Append("405"); }
        else if (code == 413) { sb.Append("413"); }
        else if (code == 429) { sb.Append("429"); }
        else if (code == 431) { sb.Append("431"); }
        else { sb.Append(code); }
        sb.Append(" ");
        sb.Append(this.statusText);
        sb.Append("\r\n");

        sb.Append("Content-Type: ");
        sb.Append(this.contentType);
        sb.Append("\r\n");

        bool statusForbidsContentLength = (this.statusCode >= 100 && this.statusCode < 200)
            || this.statusCode == 204;
        // 分块传输与 Content-Length 互斥：只发其中一个。1xx/204/304
        // 既不能有正文也不能有传输编码，两个头都不发。
        if (this.framingChunked && !statusForbidsContentLength) {
            sb.Append("Transfer-Encoding: chunked\r\n");
        } else if (!statusForbidsContentLength) {
            int blen = this.BodyLength();
            if (blen == 0) {
                sb.Append("Content-Length: 0\r\n");
            } else {
                sb.Append("Content-Length: ");
                sb.Append(blen);
                sb.Append("\r\n");
            }
        }

        if (this.keepAlive) {
            sb.Append("Connection: keep-alive\r\n");
        } else {
            sb.Append("Connection: close\r\n");
        }

        sb.Append("Server: Zan/1.0\r\n");

        for (int i = 0; i < this.headers.Count; i = i + 1) {
            sb.Append(this.headers[i]);
            sb.Append("\r\n");
        }

        sb.Append("\r\n");
    }

    // 将整个响应（状态行、头部及文本正文）直接写入指定的 StringBuilder。
    // 供网络层零拷贝 AsView 直出，彻底消除中间 string 堆分配与内存拷贝。
    public void WriteTo(StringBuilder sb) {
        this.WriteHeadersTo(sb);
        if (!this.framingChunked && this.body != null && this.body.Length > 0) {
            sb.Append(this.body);
        }
    }

    // 只序列化状态行与头部（含结尾空行）。二进制正文时
    // 调用方先发这个字符串，再按字节发 <c>bodyBytes</c>。
    public string BuildHeaders() {
        StringBuilder sb = HttpBufferPool.Rent();
        this.WriteHeadersTo(sb);
        string res = sb.ToString();
        HttpBufferPool.Return(sb);
        return res;
    }

    // 将响应序列化为原始 HTTP 响应字符串。仅适用于文本正文；
    // 头部与正文在同一个 StringBuilder 内完成拼装，消除二次大内存分配。
    // 二进制正文请用 <see cref="BuildHeaders"/> + <c>bodyBytes</c>。
    public string Build() {
        if (this.framingChunked) {
            // 分块定界的正文只能由分块路径按帧写出。Build 拼出来的
            // "头 + 裸正文"是一份没有分帧的报文，客户端按 chunked 解析
            // 必然错位——这里只给头部，宁可让对端等到超时，也不能发一份
            // 会被误解析的正文。
            return this.BuildHeaders();
        }
        if (this.body == null || this.body.Length == 0) {
            return this.BuildHeaders();
        }
        StringBuilder sb = HttpBufferPool.Rent();
        this.WriteHeadersTo(sb);
        sb.Append(this.body);
        string res = sb.ToString();
        HttpBufferPool.Return(sb);
        return res;
    }

    // 是否为可选空白（SP / HTAB，RFC 7230 OWS）。
    private static bool IsOws(int c) {
        return c == 32 || c == 9;
    }

    // [start, stop) 起点跳过 OWS，返回首个非 OWS 字节下标。
    private static int TrimOwsStart(string s, int start, int stop) {
        while (start < stop && HttpResponse.IsOws(s[start] & 255)) {
            start = start + 1;
        }
        return start;
    }

    // [start, stop) 终点回退 OWS，返回尾后第一个非 OWS 下标。
    private static int TrimOwsStop(string s, int start, int stop) {
        while (stop > start && HttpResponse.IsOws(s[stop - 1] & 255)) {
            stop = stop - 1;
        }
        return stop;
    }

    bool ParseFraming() {
        bool sawTe = false;
        string encoding = "";
        for (int i = 0; i < this.headers.Count; i = i + 1) {
            string line = this.headers[i];
            int colon = line.IndexOf(":");
            if (colon <= 0) { continue; }
            string name = line.Substring(0, colon).ToLower();
            string value = line.Substring(colon + 1).Trim();
            if (name == "content-length") {
                if (value.Length == 0) { return false; }
                long length = 0;
                for (int j = 0; j < value.Length; j = j + 1) {
                    int digit = value[j] & 255;
                    if (digit < 48 || digit > 57) { return false; }
                    int digitValue = digit - 48;
                    if (length > (2147483647 - digitValue) / 10) { return false; }
                    length = length * 10 + digitValue;
                }
                if (this.framingHasLength && this.framingLength != (int)length) {
                    return false;
                }
                this.framingHasLength = true;
                this.framingLength = (int)length;
            } else if (name == "transfer-encoding") {
                if (sawTe || value.Length == 0) { return false; }
                sawTe = true;
                encoding = value.ToLower();
            }
        }
        if (sawTe && this.framingHasLength) { return false; }
        if (sawTe && encoding != "chunked") { return false; }
        this.framingChunked = sawTe;
        return true;
    }

    // 状态行严格校验：HTTP/1.0|HTTP/1.1 + 至少一个 OWS +
    // 三位状态码（1xx-5xx）+ 可选 OWS reason（不含控制字符，HTAB
    // 除外）。版本与状态码间缺 OWS、状态码带后缀（"HTTP/1.1x 200"）
    // 或 600+ 一律拒绝——否则状态码可被下游按不同切分方式读出。
    private static bool ValidStatusLine(string line) {
        if (line.Length < 12) { return false; }
        string ver = line.Substring(0, 8);
        if (ver != "HTTP/1.0" && ver != "HTTP/1.1") { return false; }
        if (!HttpResponse.IsOws(line[8] & 255)) { return false; }
        int codeStart = HttpResponse.TrimOwsStart(line, 8, line.Length);
        if (codeStart + 3 > line.Length) { return false; }
        int first = (line[codeStart] & 255) - 48;
        if (first < 1 || first > 5) { return false; }
        for (int i = codeStart; i < codeStart + 3; i = i + 1) {
            int c = line[i] & 255;
            if (c < 48 || c > 57) { return false; }
        }
        if (codeStart + 3 < line.Length) {
            int c4 = line[codeStart + 3] & 255;
            if (c4 >= 48 && c4 <= 57) { return false; }
        }
        for (int i = codeStart + 3; i < line.Length; i = i + 1) {
            int c = line[i] & 255;
            if ((c < 32 && c != 9) || c == 127) { return false; }
        }
        return true;
    }

    // 解析原始 HTTP 响应（客户端用法）。状态行、字段行或
    // 分帧不合法时返回 statusCode=0 的空响应——合法状态码恒 >= 100，
    // 调用方以 <100 判定拒收并断开链路；绝不把畸形报文解释成
    // "200 空响应"（响应错位的起点）。
    public static HttpResponse Parse(string raw) {
        HttpResponse resp = new HttpResponse();
        if (raw == null) { resp.statusCode = 0; return resp; }
        int len = raw.Length;
        int lineEnd = raw.IndexOf("\r\n");
        if (lineEnd < 0) { resp.statusCode = 0; return resp; }
        string statusLine = raw.Substring(0, lineEnd);
        if (!HttpResponse.ValidStatusLine(statusLine)) {
            resp.statusCode = 0;
            return resp;
        }
        int codeStart = HttpResponse.TrimOwsStart(statusLine, 8,
            statusLine.Length);
        resp.statusCode = ((statusLine[codeStart] & 255) - 48) * 100
            + ((statusLine[codeStart + 1] & 255) - 48) * 10
            + ((statusLine[codeStart + 2] & 255) - 48);
        if (codeStart + 3 < statusLine.Length) {
            int rs = HttpResponse.TrimOwsStart(statusLine, codeStart + 3,
                statusLine.Length);
            int rstop = HttpResponse.TrimOwsStop(statusLine, rs,
                statusLine.Length);
            resp.statusText = rs < rstop
                ? statusLine.Substring(rs, rstop - rs) : "";
        } else {
            resp.statusText = "";
        }

        // 头部逐行到空行；无冒号、冒号前空白、含控制字符的行整体拒收，
        // 不再静默跳过（跳过正是走私头存活的缝隙）。
        int pos = lineEnd + 2;
        bool ended = false;
        while (pos < len) {
            int hEnd = raw.IndexOf("\r\n", pos);
            if (hEnd < 0) { resp.statusCode = 0; return resp; }
            if (hEnd == pos) { pos = hEnd + 2; ended = true; break; }
            string headerLine = raw.Substring(pos, hEnd - pos);
            int colon = headerLine.IndexOf(":");
            if (colon <= 0
                || !HttpResponse.HeaderFramingSafe(true,
                    headerLine.Substring(0, colon))
                || !HttpResponse.HeaderFramingSafe(false,
                    headerLine.Substring(colon + 1))) {
                resp.statusCode = 0;
                return resp;
            }
            resp.headers.Add(headerLine);
            string name = headerLine.Substring(0, colon).ToLower();
            if (name == "content-type") {
                int valueStart = HttpResponse.TrimOwsStart(headerLine,
                    colon + 1, headerLine.Length);
                int valueStop = HttpResponse.TrimOwsStop(headerLine,
                    valueStart, headerLine.Length);
                resp.contentType = headerLine.Substring(valueStart,
                    valueStop - valueStart);
            }
            pos = hEnd + 2;
        }
        if (!ended || !resp.ParseFraming()) {
            resp.statusCode = 0;
            return resp;
        }
        if (pos < len) { resp.body = raw.Substring(pos); }
        return resp;
    }
}
