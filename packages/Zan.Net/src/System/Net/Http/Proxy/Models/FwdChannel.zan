using System;
using System.Collections.Generic;
using System.Net.Sockets;

namespace System.Net.Http.Proxy;

public class FwdChannel {
    public nint sock;
    public TlsStream tls;
    public TlsContext ctx;
    public bool closed;
    // 明文接收的空闲截止（毫秒；0 = 不设限）。转发器实例级配置，
    // 通道创建时注入，避免读进程级全局导致的实例间串扰。
    public int idleMs;

    // 构造：用 <see cref="OfSocket"/> / <see cref="OfTls"/> 创建。
    public FwdChannel(nint sock, TlsStream tls, TlsContext ctx, int idleMs) {
        this.sock = sock;
        this.tls = tls;
        this.ctx = ctx;
        this.closed = false;
        this.idleMs = idleMs;
    }

    // 明文 TCP 链路。
    public static FwdChannel OfSocket(nint sock, int idleMs) {
        return new FwdChannel(sock, null, null, idleMs);
    }

    // TLS 链路；`ctx` 由本链路持有，关闭时释放。
    public static FwdChannel OfTls(nint sock, TlsStream tls, TlsContext ctx, int idleMs) {
        return new FwdChannel(sock, tls, ctx, idleMs);
    }

    // 本次到达的字节，最多 `max`；对端关闭或出错时为空串。
    public async string RecvAsync(int max) {
        if (this.closed) { return ""; }
        if (this.tls != null) {
            return await this.tls.RecvAsync(max);
        }
        // 空闲截止：对端迟迟不发数据时让出连接，而不是永久占用
        // 协程 + 套接字（慢速客户端 / 卡死的上游正是这样拖死
        // 转发器的——类文档一直声称有这个行为）。TLS 侧待运行时
        // 提供带截止的解密接收后同样接入。
        int idle = this.idleMs;
        if (idle > 0) {
            return await Socket.RecvAsync(this.sock, max, idle);
        }
        return await Socket.RecvAsync(this.sock, max);
    }

    // 写出整段 `data`；成功返回写出的字节数，
    // 对端提前关闭时返回已写出的部分长度。消除 Substring 分配并确保二进制安全。
    public async int SendAllAsync(string data) {
        if (data == null || this.closed) { return 0; }
        int total = data.Length;
        if (total == 0) { return 0; }
        HttpDeadlineToken watch = HttpDeadline.Arm(this.sock, this.idleMs);
        try {
            int n;
            if (this.tls != null) {
                n = await this.tls.SendAsync(data, total);
            } else {
                n = await Socket.SendAsync(this.sock, data, total);
            }
            if (HttpDeadline.Expired(watch) || n <= 0) { return 0; }
            return n;
        } finally {
            HttpDeadline.Disarm(watch);
        }
    }

    // 接收原始字节到 data，返回真实字节数；0 表示关闭或失败。
    // 不经 string.Length/strlen，正文中的 NUL 不会被当成 EOF。
    public async int RecvBytesAsync(byte[] data, int max) {
        if (this.closed || data == null || max <= 0) { return 0; }
        int want = max;
        if (want > data.Length) { want = data.Length; }
        HttpDeadlineToken watch = HttpDeadline.Arm(this.sock, this.idleMs);
        try {
            int n;
            if (this.tls != null) {
                n = await this.tls.RecvBytesAsync(data, 0, want);
            } else {
                n = await Socket.RecvBytesAsync(this.sock, data, want);
            }
            if (HttpDeadline.Expired(watch)) { return 0; }
            return n > 0 ? n : 0;
        } finally {
            HttpDeadline.Disarm(watch);
        }
    }

    // 发送字节数组切片，部分写入时继续发送；返回实际发送数。
    public async int SendAllBytesAsync(byte[] data, int offset, int len) {
        if (this.closed || data == null || offset < 0 || len <= 0
            || offset > data.Length || len > data.Length - offset) { return 0; }
        int sent = 0;
        HttpDeadlineToken watch = HttpDeadline.Arm(this.sock, this.idleMs);
        try {
            while (sent < len) {
                int n;
                if (this.tls != null) {
                    n = await this.tls.SendBytesAsync(data, offset + sent, len - sent);
                } else {
                    n = await Socket.SendBytesAsync(this.sock, data, offset + sent, len - sent);
                }
                if (HttpDeadline.Expired(watch) || n <= 0) { return sent; }
                sent = sent + n;
                HttpDeadline.Touch(watch, this.idleMs);
            }
            return sent;
        } finally {
            HttpDeadline.Disarm(watch);
        }
    }

    // 关闭链路（幂等）。TLS 链路同时释放流与上下文。
    public void Close() {
        if (this.closed) { return; }
        this.closed = true;
        if (this.tls != null) {
            this.tls.Close();
            this.tls = null;
        }
        if (this.sock >= 0) {
            #if WINDOWS
            // 隧道两端是两个方向泵共享的 fd：一个方向读到 EOF 退出时
            // 会顺手关掉对端还挂着的套接字，而 Windows 的 closesocket
            // 不给挂起的重叠 recv 投递完成包，兄弟泵就永远停在 await
            // 上导致整条链路被记为仍可达。
            // 先 CancelIoEx 让挂起者以 0 字节复位再关——与
            // TcpListener.Stop / TcpClient.Close 同一模式。
            Socket.ShutdownBoth(this.sock);
            #endif
            Socket.Close(this.sock);
            this.sock = -1;
        }
        if (this.ctx != null) {
            this.ctx.Free();
            this.ctx = null;
        }
    }

    // 链路是否已关闭。
    public bool IsClosed() {
        return this.closed;
    }

    // 调整空闲截止（毫秒；0 = 不设截止）。隧道在
    // <see cref="Tunnel"/> 入口把两条链路都切到 0。
    public void SetIdleMs(int ms) {
        this.idleMs = ms;
    }

    // 半关闭：只对套接字做双向 shutdown，不释放描述符。
    // 隧道的对端方向泵可能还挂在本链路的读上——直接 Close 会把
    // 它脚下的 fd 抽掉（Windows 上 select 对已关闭的句柄不再报
    // 可读，轮询式接收从此永远等不到任何事件）；shutdown 让
    // 对端下一轮探测立即看到可读、recv 返回 0（EOF 语义）正常
    // 退出，由它在自己的退出路径里做完整的 Close。
    public void Shutdown() {
        if (this.closed) { return; }
        if (this.sock >= 0) {
            Socket.ShutdownBoth(this.sock);
        }
    }

    // 底层套接字（连接池用它做零阻塞的存活检查）。
    public nint Sock() {
        return this.sock;
    }
}
