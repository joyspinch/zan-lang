using System;
using System.Collections.Generic;
using System.Net.Sockets;

namespace System.Net.Http.Proxy;

public class FwdPooledItem {
    public FwdChannel ch;
    public long expiry;
    public FwdPooledItem(FwdChannel ch, long expiry) {
        this.ch = ch;
        this.expiry = expiry;
    }
}
