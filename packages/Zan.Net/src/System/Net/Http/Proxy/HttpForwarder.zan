using System;
using System.IO;
using System.Net;
using System.Net.External;
using System.Net.Sockets;
using System.Net.Tls;
using System.Threading;

namespace System.Net.Http.Proxy;

// 转发链路的一端：明文套接字或 TLS 流。两种传输的收发
// 接口在此统一，转发逻辑因此只写一遍，而不是每处都判断
// http/https。
// <see cref="RecvAsync"/> 返回本次真正到达的字节（对端关闭
// 时为空串），<see cref="SendAllAsync"/> 循环直到整段写出，
// 因此调用方永远不必自己处理部分写。
public partial class HttpForwarder : IDisposable {
    private string listenHost;
    private int listenPort;
    private string upHost;
    private int upPort;
    private bool upTls;
    private bool verifyTls;
    private bool allowConnect;
    private int timeoutMs;
    private int maxHeadBytes;
    private int chunkBytes;
    private int maxConnections;
    private int active;
    private bool running;
    private TcpListener listener;
    // 明文链路接收的空闲截止（毫秒；0 = 不设限），实例级配置，
    // 由 Start 之后建立的每条 FwdChannel 在创建时取走。
    private int recvIdleMs;
    // 上游 keep-alive：pool 为 null 即每请求一连。
    private FwdPool pool;
    private int maxIdleUp;
    private int idleUpMs;

    // `upstream` 可写为 <c>https://host[:port]</c>、
    // <c>http://host[:port]</c> 或 <c>host:port</c>（无协议时按
    // 明文 http，缺端口时 https 用 443、http 用 80）。
    public HttpForwarder(string listenHost, int listenPort, string upstream) {
        this.listenHost = listenHost;
        this.listenPort = listenPort;
        this.upTls = false;
        this.upHost = "";
        this.upPort = 80;
        this.verifyTls = true;
        this.allowConnect = true;
        this.timeoutMs = 300000;
        this.maxHeadBytes = 65536;
        this.chunkBytes = 65536;
        this.maxConnections = 4096;
        this.active = 0;
        this.running = false;
        this.listener = null;
        this.recvIdleMs = 300000;
        this.maxIdleUp = 64;
        this.idleUpMs = 55000;
        this.pool = new FwdPool(this.maxIdleUp, this.idleUpMs);
        this.ParseUpstream(upstream);
    }

    // 解析 upstream 字符串为上游 host、port 与 TLS 标志。
    // authority 用 bracket-aware 严格解析（复用 ExternalTarget 的
    // 端口/IPv6 校验形状）：支持 [IPv6]:port，拒绝未闭合括号、
    // 非数字端口、0、大于 65535 与 host:80junk 这类前缀数字——
    // 旧 ParseInt 按"数字前缀即端口"接受畸形值，端口可能静默
    // 变成另一个目标。
    private void ParseUpstream(string upstream) {
        string rest = upstream;
        if (HttpForwarder.StartsWith(rest, "https://")) {
            this.upTls = true;
            this.upPort = 443;
            rest = rest.Substring(8, rest.Length - 8);
        } else if (HttpForwarder.StartsWith(rest, "http://")) {
            this.upTls = false;
            this.upPort = 80;
            rest = rest.Substring(7, rest.Length - 7);
        }
        int slash = HttpForwarder.IndexOf(rest, "/", 0);
        if (slash >= 0) { rest = rest.Substring(0, slash); }
        if (rest.Length == 0) { return; }
        string host = rest;
        if (HttpForwarder.StartsWith(rest, "[")) {
            int close = HttpForwarder.IndexOf(rest, "]", 0);
            if (close < 0) { return; }
            string inner = rest.Substring(1, close - 1);
            // 方括号形式按 RFC 3986 只承载 IPv6 字面量，直接复用
            // ExternalTarget 的严格校验；非法 IPv6 拒绝整个 upstream。
            if (!ExternalTarget.ValidIPv6(inner)) { return; }
            host = inner;
            if (close + 1 < rest.Length) {
                int port = HttpForwarder.PortOf(rest, close + 1);
                if (port > 0) {
                    this.upPort = port;
                } else if (port < 0) {
                    return;
                }
            }
        } else {
            if (rest.IndexOf("[") >= 0 || rest.IndexOf("]") >= 0) { return; }
            int colon = HttpForwarder.LastIndexOf(rest, ":");
            if (colon > 0) {
                int port = HttpForwarder.PortOf(rest, colon);
                if (port > 0) {
                    this.upPort = port;
                    host = rest.Substring(0, colon);
                } else if (port < 0) {
                    return;
                }
            } else if (colon == 0) {
                return;
            }
            // 裸 IPv6（"::1"）与 LastIndexOf 切分天然歧义，一律要求
            // 方括号形式——冒号进 host 就是拒绝信号。
            if (host.Length == 0 || host.IndexOf(":") >= 0
                || !HttpForwarder.IsAuthorityByte(host)) {
                return;
            }
        }
        this.upHost = host;
    }

    // authority 主机部分（无方括号形态）只允许 DNS 名与 IPv4 字面量
    // 字节：空格、控制字符、user@、路径分隔符都会被 Socket.ConnectAsync
    // 或 Host 改写解释成别的目标。IPv6 一律走方括号 + ValidIPv6；
    // IDN 必须先转 punycode。
    private static bool IsAuthorityByte(string h) {
        for (int i = 0; i < h.Length; i = i + 1) {
            int c = h[i] & 255;
            if (!((c >= 48 && c <= 57) || (c >= 65 && c <= 90)
                || (c >= 97 && c <= 122) || c == 45 || c == 46)) {
                return false;
            }
        }
        return h.Length > 0;
    }

    // upstream 的 ":端口" 解析：1-65535 返回端口，未写返回 0，
    // 畸形（非数字、0、>65535、>5 位）返回 -1——调用方按 -1 拒绝
    // 整个 upstream，不再按数字前缀猜。
    private static int PortOf(string authority, int at) {
        if (at >= authority.Length) { return 0; }
        if (authority[at] != ':') { return -1; }
        string p = authority.Substring(at + 1, authority.Length - at - 1);
        if (p.Length == 0 || p.Length > 5) { return -1; }
        int n = 0;
        for (int i = 0; i < p.Length; i = i + 1) {
            int c = p[i] & 255;
            if (c < 48 || c > 57) { return -1; }
            n = n * 10 + c - 48;
        }
        if (n < 1 || n > 65535) { return -1; }
        return n;
    }

    // 空闲超时（毫秒）：两个方向都这么久没有字节
    // 才判定链路失效。流式响应之间的静默间隔可能很长，
    // 因此默认 5 分钟。同时更新明文链路的接收截止——
    // 此前该值只作用于连接建立，注释承诺的空闲判定从未生效，
    // 慢速客户端/卡死上游会永久占用协程与套接字。
    // 钳在 1ms-24h：0/负数会让空闲判定失效（协程永久挂起），
    // 过大的值同样不可恢复。
    public HttpForwarder SetTimeout(int ms) {
        if (ms < 1) { ms = 1; }
        if (ms > 86400000) { ms = 86400000; }
        this.timeoutMs = ms;
        this.recvIdleMs = ms;
        return this;
    }

    // 单次搬运的块大小（字节）。钳在 1KiB-1MiB：过小是
    // 每块一次系统调用的放大器，过大则每连接白白占住一块缓冲。
    public HttpForwarder SetChunkBytes(int bytes) {
        if (bytes < 1024) { bytes = 1024; }
        if (bytes > 1048576) { bytes = 1048576; }
        this.chunkBytes = bytes;
        return this;
    }

    // 请求/响应头块的上限（字节）。钳在 1KiB-1MiB：
    // 下限防 0/负数让所有请求立即失败，上限防每连接无界缓冲。
    public HttpForwarder SetMaxHeadBytes(int bytes) {
        if (bytes < 1024) { bytes = 1024; }
        if (bytes > 1048576) { bytes = 1048576; }
        this.maxHeadBytes = bytes;
        return this;
    }

    // 最大并发连接数。钳在 1-1000000：0/负数会拒绝所有
    // 连接（拒绝路径本身不递减计数，等于永久自锁）。
    public HttpForwarder SetMaxConnections(int max) {
        if (max < 1) { max = 1; }
        if (max > 1000000) { max = 1000000; }
        this.maxConnections = max;
        return this;
    }

    // 上游空闲链路上限与空闲存活时长（毫秒）。
    // 存活时长应短于上游自己的 keep-alive 超时，否则每次复用
    // 都要先碰一下已被对端关掉的链路。两值都钳界：
    // maxIdle 1-4096、idleMs 1-86400000。
    public HttpForwarder SetUpstreamKeepAlive(int maxIdle, int idleMs) {
        if (maxIdle < 1) { maxIdle = 1; }
        if (maxIdle > 4096) { maxIdle = 4096; }
        if (idleMs < 1) { idleMs = 1; }
        if (idleMs > 86400000) { idleMs = 86400000; }
        this.maxIdleUp = maxIdle;
        this.idleUpMs = idleMs;
        if (this.pool != null) { this.pool.CloseAll(); }
        this.pool = new FwdPool(maxIdle, idleMs);
        return this;
    }

    // 关掉上游连接复用，退回“每请求一连 + Connection:
    // close”的旧行为（上游对 keep-alive 处理有问题时的逃生口）。
    public HttpForwarder DisableUpstreamKeepAlive() {
        if (this.pool != null) {
            this.pool.CloseAll();
            this.pool = null;
        }
        return this;
    }

    // 上游连接池（未启用复用时为 null）：命中/未命中
    // 次数与当前空闲数可直接报给监控。
    public FwdPool UpstreamPool() {
        return this.pool;
    }

    // 不校验上游证书（自签名上游/抓包调试用）。
    public HttpForwarder DisableTlsVerify() {
        this.verifyTls = false;
        return this;
    }

    // 禁用 CONNECT 隧道（默认允许，指向配置的上游）。
    public HttpForwarder DenyConnect() {
        this.allowConnect = false;
        return this;
    }

    // 上游是否为 https。
    public bool UpstreamTls() {
        return this.upTls;
    }

    // 停止 accept 循环（已建立的连接自然收尾）。
    public void Stop() {
        this.running = false;
        if (this.listener != null) {
            this.listener.Stop();
        }
        if (this.pool != null) { this.pool.CloseAll(); }
    }

    public void Dispose() {
        this.Stop();
    }

    // 启动 accept 循环。每个下游连接在独立协程里转发，因此
    // 一路慢速流式响应不会挡住其他连接。运行期间不返回。
    public async void Start() {
        Socket.Initialize();
        this.listener = new TcpListener(this.listenHost, this.listenPort);
        this.listener.Start();
        this.running = true;
        while (this.running) {
            nint client = await this.listener.AcceptAsync();
            if (client < 0) { break; }
            Socket.SetNoDelay(client);
            if (this.active >= this.maxConnections) {
                Task.Spawn(HttpForwarder.RejectBusy(client));
            } else {
                this.active = this.active + 1;
                Task.Spawn(this.Serve(client));
            }
        }
    }

    // 超过并发上限时对下游回 503 并关闭。
    private static async void RejectBusy(nint clientSock) {
        FwdChannel ch = FwdChannel.OfSocket(clientSock, 0);
        int _n = await ch.SendAllAsync(
            "HTTP/1.1 503 Service Unavailable\r\nContent-Length: 11\r\n"
            + "Connection: close\r\n\r\nforwarder busy");
        ch.Close();
    }

    // 单条下游连接的生命周期：转发一次后递减并发计数。
    private async void Serve(nint clientSock) {
        try {
            await this.ServeOnce(clientSock);
        } finally {
            this.active = this.active - 1;
        }
    }

    // 转发一个下游连接：读请求头 → 连上游 → 边收边转
    // 请求体 → 上游响应头即刻回传 → 边收边转响应体。
    private async void ServeOnce(nint clientSock) {
        FwdChannel client = FwdChannel.OfSocket(clientSock, this.recvIdleMs);
        FwdReader creader = new FwdReader(client, this.chunkBytes);
        string head = await creader.ReadHeadAsync(this.maxHeadBytes);
        if (head.Length == 0) {
            client.Close();
            return;
        }
        string method = HttpForwarder.MethodOf(head);
        if (!HttpForwarder.IsRequestValid(head)
            || (HttpForwarder.HeaderValue(head, "expect").Length > 0
                && !HttpForwarder.HasHeaderToken(head, "expect", "100-continue"))) {
            int _bad = await client.SendAllAsync(
                "HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\n"
                + "Connection: close\r\n\r\n");
            client.Close();
            return;
        }
        if (method == "CONNECT") {
            if (!this.allowConnect) {
                int _d = await client.SendAllAsync(
                    "HTTP/1.1 405 Method Not Allowed\r\nContent-Length: 0\r\n"
                    + "Connection: close\r\n\r\n");
                client.Close();
                return;
            }
            await this.ServeConnect(client, creader);
            return;
        }

        // 上游链路优先从池里拿（省一次 TCP+TLS 握手）。
        bool pooled = false;
        FwdChannel up = null;
        if (this.pool != null) {
            up = this.pool.Take();
            pooled = up != null;
        }
        if (up == null) { up = await this.ConnectUpstream(); }
        if (up == null) {
            int _b = await client.SendAllAsync(
                "HTTP/1.1 502 Bad Gateway\r\nContent-Length: 15\r\n"
                + "Connection: close\r\n\r\nupstream failed");
            client.Close();
            return;
        }

        string peer = Socket.RemoteIp(clientSock);
        string upHead = this.RewriteRequestHead(head, peer);
        // 无正文的请求可以原样重发：复用链路在"存活检查"与"真正
        // 发送"之间被上游关掉是 keep-alive 固有的竞态，换条新链路
        // 重发一次就能盖住；带正文的请求不行（正文是从下游流式
        // 搬过来的，无法回放）。
        bool replayable = pooled && !HttpForwarder.HasRequestBody(head);
        int sent = await up.SendAllAsync(upHead);
        if (sent < upHead.Length) {
            up.Close();
            up = null;
            if (replayable) {
                pooled = false;
                up = await this.ConnectUpstream();
                if (up != null) {
                    sent = await up.SendAllAsync(upHead);
                    if (sent < upHead.Length) { up.Close(); up = null; }
                }
            }
            if (up == null) {
                int _r = await client.SendAllAsync(
                    "HTTP/1.1 502 Bad Gateway\r\nContent-Length: 15\r\n"
                    + "Connection: close\r\n\r\nupstream failed");
                client.Close();
                return;
            }
        }

        FwdReader ureader = new FwdReader(up, this.chunkBytes);
        string rhead = "";
        bool expectContinue = HttpForwarder.HasHeaderToken(head, "expect", "100-continue")
            && HttpForwarder.HasRequestBody(head);
        if (expectContinue) {
            rhead = await ureader.ReadHeadAsync(this.maxHeadBytes);
            while (rhead.Length > 0 && HttpForwarder.StatusOf(rhead) >= 100
                && HttpForwarder.StatusOf(rhead) < 200
                && HttpForwarder.StatusOf(rhead) != 101) {
                if (!HttpForwarder.IsResponseHeadValid(rhead)
                    || !HttpForwarder.IsBodyFramingValid(rhead, false)) { break; }
                int interim = await client.SendAllAsync(HttpForwarder.RewriteResponseHead(rhead, false));
                if (interim <= 0) { up.Close(); client.Close(); return; }
                if (HttpForwarder.StatusOf(rhead) == 100) { rhead = ""; break; }
                rhead = await ureader.ReadHeadAsync(this.maxHeadBytes);
            }
        }
        bool reqComplete = !expectContinue || rhead.Length == 0;
        if (rhead.Length == 0) {
            long reqBodyMoved = await HttpForwarder.PumpBody(creader, up, head, true, this.chunkBytes);
            if (HttpForwarder.HeadIsChunked(head)) {
                if (reqBodyMoved < 0) { reqComplete = false; }
            } else {
                long reqCl = HttpForwarder.ContentLengthOf(head);
                if (reqCl > 0 && reqBodyMoved != reqCl) { reqComplete = false; }
            }
            rhead = await ureader.ReadHeadAsync(this.maxHeadBytes);
        }
        while (rhead.Length > 0 && HttpForwarder.StatusOf(rhead) >= 100
            && HttpForwarder.StatusOf(rhead) < 200
            && HttpForwarder.StatusOf(rhead) != 101) {
            if (!HttpForwarder.IsResponseHeadValid(rhead)
                || !HttpForwarder.IsBodyFramingValid(rhead, false)) { break; }
            int interim = await client.SendAllAsync(HttpForwarder.RewriteResponseHead(rhead, false));
            if (interim <= 0) { up.Close(); client.Close(); return; }
            rhead = await ureader.ReadHeadAsync(this.maxHeadBytes);
        }
        if (rhead.Length == 0 && replayable) {
            // 同一个竞态的另一种表现：头部写进了内核缓冲区，但对端
            // 其实已经在关连接，于是读到的是 EOF 而不是响应。
            up.Close();
            pooled = false;
            up = await this.ConnectUpstream();
            if (up != null) {
                int s2 = await up.SendAllAsync(upHead);
                if (s2 < upHead.Length) {
                    up.Close();
                    up = null;
                } else {
                    ureader = new FwdReader(up, this.chunkBytes);
                    rhead = await ureader.ReadHeadAsync(this.maxHeadBytes);
                }
            }
        }
        if (up == null || rhead.Length == 0) {
            int _g = await client.SendAllAsync(
                "HTTP/1.1 502 Bad Gateway\r\nContent-Length: 17\r\n"
                + "Connection: close\r\n\r\nno upstream reply");
            if (up != null) { up.Close(); }
            client.Close();
            return;
        }
        if (!HttpForwarder.IsResponseHeadValid(rhead)
            || HttpForwarder.StatusOf(rhead) < 100
            || !HttpForwarder.IsBodyFramingValid(rhead, false)
            || !HttpForwarder.AreConnectionTokensValid(rhead)) {
            int _badResponse = await client.SendAllAsync(
                "HTTP/1.1 502 Bad Gateway\r\nContent-Length: 0\r\n"
                + "Connection: close\r\n\r\n");
            up.Close();
            client.Close();
            return;
        }
        // 响应头立刻回传：下游据此开始渲染（SSE 客户端要拿到
        // Content-Type: text/event-stream 才会进入事件循环）。
        int status = HttpForwarder.StatusOf(rhead);
        string requestedUpgrade = HttpForwarder.Lower(
            HttpForwarder.HeaderValue(head, "upgrade"));
        bool switched = status == 101 && HttpForwarder.HasHeaderToken(head, "connection", "upgrade")
            && HttpForwarder.IsToken(requestedUpgrade)
            && HttpForwarder.HasHeaderToken(rhead, "connection", "upgrade")
            && HttpForwarder.Lower(HttpForwarder.HeaderValue(rhead, "upgrade"))
                == requestedUpgrade;
        if (status == 101 && !switched) {
            int _invalidSwitch = await client.SendAllAsync(
                "HTTP/1.1 502 Bad Gateway\r\nContent-Length: 0\r\n"
                + "Connection: close\r\n\r\n");
            up.Close(); client.Close(); return;
        }
        string downHead = HttpForwarder.RewriteResponseHead(rhead, switched);
        int hs = await client.SendAllAsync(downHead);
        if (hs < downHead.Length) {
            up.Close();
            client.Close();
            return;
        }

        if (switched) {
            // 协议已切换（WebSocket）：之后是双向裸字节。
            await HttpForwarder.Tunnel(client, creader, up, ureader,
                                       this.chunkBytes);
            return;
        }
        // 204/304/1xx 与 HEAD 的响应按定义没有正文：这里不能再等
        // "搬到对端关闭"，否则复用链路上会一直挂到空闲超时。
        bool noBody = HttpForwarder.RespHasNoBody(method, status);
        long moved = 0;
        if (!noBody) {
            moved = await HttpForwarder.PumpBody(ureader, client, rhead, false,
                                                 this.chunkBytes);
        }
        // 只有"请求体完整发出 + 响应结尾能被帧格式确定 + 链路上没有剩余字节"时才归还：
        // 否则下一个请求会读到上一条响应的尾巴或与上游未完成的请求脱节（请求/响应走私）。
        bool reusable = this.pool != null && !up.IsClosed()
            && reqComplete
            && HttpForwarder.RespKeepsAlive(rhead)
            && (noBody || HttpForwarder.RespSelfDelimited(rhead))
            && ureader.Drained();
        if (reusable && !noBody) {
            if (moved < 0) {
                // 分块流未读到终结块（或长度非法）。
                reusable = false;
            } else if (!HttpForwarder.HeadIsChunked(rhead)) {
                long want = HttpForwarder.ContentLengthOf(rhead);
                if (want >= 0 && moved != want) { reusable = false; }
            }
        }
        if (reusable) {
            this.pool.Give(up);
        } else {
            up.Close();
        }
        client.Close();
    }

    // CONNECT：连上游后回 200，然后双向裸字节对拷
    // （TLS 直通，转发器不解密）。
    private async void ServeConnect(FwdChannel client, FwdReader creader) {
        TcpClient conn = await TcpClient.ConnectAsync(this.upHost, this.upPort,
                                                      this.timeoutMs);
        if (conn == null) {
            int _b = await client.SendAllAsync(
                "HTTP/1.1 502 Bad Gateway\r\nContent-Length: 0\r\n"
                + "Connection: close\r\n\r\n");
            client.Close();
            return;
        }
        nint sock = conn.Sock();
        Socket.SetNoDelay(sock);
        FwdChannel up = FwdChannel.OfSocket(sock, this.recvIdleMs);
        int _o = await client.SendAllAsync(
            "HTTP/1.1 200 Connection Established\r\n\r\n");
        FwdReader ureader = new FwdReader(up, this.chunkBytes);
        await HttpForwarder.Tunnel(client, creader, up, ureader,
                                   this.chunkBytes);
    }

    // 建立上游连接（必要时完成 TLS 握手）。连接走
    // TcpClient.ConnectAsync：按解析结果的地址族逐条建连——
    // 此前裸 AF_INET 套接字连 IPv6 上游（[::1]）恒失败；
    // 上游是运营者配置的目标，回环上游（本地 sidecar/测试）合法。
    private async FwdChannel ConnectUpstream() {
        TcpClient conn = await TcpClient.ConnectAsync(this.upHost, this.upPort,
                                                      this.timeoutMs);
        if (conn == null) { return null; }
        nint sock = conn.Sock();
        Socket.SetNoDelay(sock);
        if (!this.upTls) {
            return FwdChannel.OfSocket(sock, this.recvIdleMs);
        }
        TlsContext ctx = TlsContext.CreateClient();
        if (ctx == null) {
            Socket.Close(sock);
            return null;
        }
        if (!this.verifyTls) { ctx.DisableVerify(); }
        TlsStream stream = await TlsStream.ConnectAsync(ctx, sock, this.upHost, this.timeoutMs);
        if (stream == null) {
            Socket.Close(sock);
            ctx.Free();
            return null;
        }
        return FwdChannel.OfTls(sock, stream, ctx, this.recvIdleMs);
    }

    // 改写请求头：Host 指向上游、剥离逐跳头部、
    // 追加 X-Forwarded-For，并要求上游按请求关闭连接。
    // 对 Transfer-Encoding: chunked 的请求保留该头部，确保上游
    // 能正确解析后续 chunk 正文。
    private string RewriteRequestHead(string head, string peer) {
        List<string> lines = HttpForwarder.HeadLines(head);
        string outHead = "";
        string hostValue = this.upHost;
        // IPv6 字面量在 Host 头里必须带方括号（RFC 3986）；upHost
        // 存的是去括号形式，改写时还原。
        if (hostValue.IndexOf(":") >= 0) { hostValue = "[" + hostValue + "]"; }
        if ((this.upTls && this.upPort != 443)
            || (!this.upTls && this.upPort != 80)) {
            hostValue = hostValue + ":" + Convert.ToString(this.upPort);
        }
        bool chunked = HttpForwarder.HeadIsChunked(head);
        bool upgrade = HttpForwarder.HasHeaderToken(head, "connection", "upgrade")
            && HttpForwarder.HeaderValue(head, "upgrade").Length > 0;
        for (int i = 0; i < lines.Count; i = i + 1) {
            string line = lines[i];
            if (i == 0) { outHead = outHead + line + "\r\n"; continue; }
            string name = HttpForwarder.LowerName(line);
            if (name == "host" || name == "transfer-encoding"
                || name == "x-forwarded-for") { continue; }
            if (HttpForwarder.IsHopByHop(name)
                || HttpForwarder.HasHeaderToken(head, "connection", name)
                || HttpForwarder.HasHeaderToken(head, "proxy-connection", name)) { continue; }
            outHead = outHead + line + "\r\n";
        }
        outHead = outHead + "Host: " + hostValue + "\r\n";
        if (chunked) { outHead = outHead + "Transfer-Encoding: chunked\r\n"; }
        if (peer.Length > 0) {
            outHead = outHead + "X-Forwarded-For: " + peer + "\r\n";
        }
        if (upgrade) {
            outHead = outHead + "Upgrade: " + HttpForwarder.HeaderValue(head, "upgrade")
                + "\r\nConnection: Upgrade\r\n\r\n";
        } else if (this.pool != null) {
            outHead = outHead + "Connection: keep-alive\r\n\r\n";
        } else {
            outHead = outHead + "Connection: close\r\n\r\n";
        }
        return outHead;
    }

    // 请求头声明了正文（Content-Length &gt; 0 或 chunked）。
    // 无正文的请求才可以在复用链路失效时原样重发。
    private static bool HasRequestBody(string head) {
        if (HttpForwarder.HeadIsChunked(head)) { return true; }
        return HttpForwarder.ContentLengthOf(head) > 0;
    }

    // 该响应按定义没有正文：1xx、204、304，以及对
    // HEAD 的应答（后者即使带 Content-Length 也不发正文）。
    private static bool RespHasNoBody(string method, int status) {
        if (method == "HEAD") { return true; }
        if (status == 204 || status == 304) { return true; }
        return status >= 100 && status < 200;
    }

    // 响应的结尾可由帧格式自行确定（chunked 或
    // Content-Length），而不是靠连接关闭。
    private static bool RespSelfDelimited(string head) {
        if (HttpForwarder.HeadIsChunked(head)) { return true; }
        return HttpForwarder.ContentLengthOf(head) >= 0;
    }

    // 上游愿意保持这条链路：HTTP/1.1 且 Connection 里没有
    // close。HTTP/1.0 响应默认关闭，不复用。
    private static bool RespKeepsAlive(string head) {
        if (!HttpForwarder.StartsWith(head, "HTTP/1.1")) { return false; }
        string conn = HttpForwarder.Lower(
            HttpForwarder.HeaderValue(head, "connection"));
        List<string> parts = HttpForwarder.SplitCsv(conn);
        for (int i = 0; i < parts.Count; i = i + 1) {
            if (parts[i] == "close") { return false; }
        }
        return true;
    }

    // 改写响应头：剥离逐跳头部并标明连接将关闭。
    // Transfer-Encoding 保留（分块帧原样透传给下游）。
    private static string RewriteResponseHead(string head, bool switched) {
        List<string> lines = HttpForwarder.HeadLines(head);
        string outHead = "";
        for (int i = 0; i < lines.Count; i = i + 1) {
            string line = lines[i];
            if (i == 0) { outHead = outHead + line + "\r\n"; continue; }
            string name = HttpForwarder.LowerName(line);
            if (HttpForwarder.IsHopByHop(name)
                || HttpForwarder.HasHeaderToken(head, "connection", name)
                || HttpForwarder.HasHeaderToken(head, "proxy-connection", name)) { continue; }
            outHead = outHead + line + "\r\n";
        }
        if (HttpForwarder.HeadIsChunked(head)) {
            outHead = outHead + "Transfer-Encoding: chunked\r\n";
        }
        if (switched) {
            outHead = outHead + "Upgrade: " + HttpForwarder.HeaderValue(head, "upgrade")
                + "\r\nConnection: Upgrade\r\n\r\n";
        } else if (HttpForwarder.StatusOf(head) >= 100
            && HttpForwarder.StatusOf(head) < 200) {
            outHead = outHead + "\r\n";
        } else {
            outHead = outHead + "Connection: close\r\n\r\n";
        }
        return outHead;
    }

    // 按 `head` 声明的帧格式把正文从 `src` 搬到 `dst`，每收到
    // 一块立即写出：
    // Transfer-Encoding: chunked —— 逐块转发，见到 0 块与尾部结束；
    // Content-Length: n         —— 精确转发 n 字节；
    // 两者都没有                 —— 请求侧视为无正文，
    // 响应侧一直转发到上游关闭
    // （SSE / 无长度的流式响应）。
    private static async long PumpBody(FwdReader src, FwdChannel dst, string head,
            bool isRequest, int chunkBytes) {
        if (HttpForwarder.HeadIsChunked(head)) {
            return await HttpForwarder.PumpChunked(src, dst, head, chunkBytes);
        }
        long len = HttpForwarder.ContentLengthOf(head);
        // 非法 Content-Length：不应到达这里，作为防御按无正文处理
        if (len == -2) { return -1; }
        if (len > 0) {
            return await HttpForwarder.PumpExact(src, dst, len, chunkBytes);
        }
        if (len == 0) { return 0; }
        if (isRequest) { return 0; }
        return await HttpForwarder.PumpToEof(src, dst, chunkBytes);
    }

    // 精确搬运 `n` 字节。
    private static async long PumpExact(FwdReader src, FwdChannel dst, long n,
            int chunkBytes) {
        long left = n;
        byte[] data = new byte[chunkBytes];
        while (left > 0) {
            int want = chunkBytes;
            if (left < (long)want) { want = (int)left; }
            int got = await src.ReadSomeBytesAsync(data, want);
            if (got <= 0) { return n - left; }
            int w = await dst.SendAllBytesAsync(data, 0, got);
            if (w < got) { return n - left; }
            left = left - (long)got;
        }
        return n;
    }

    // 一直搬运到源端关闭（无 Content-Length 的流式响应）。
    private static async long PumpToEof(FwdReader src, FwdChannel dst, int chunkBytes) {
        long total = 0;
        byte[] data = new byte[chunkBytes];
        while (true) {
            int got = await src.ReadSomeBytesAsync(data, chunkBytes);
            if (got <= 0) { return total; }
            int w = await dst.SendAllBytesAsync(data, 0, got);
            if (w < got) { return total; }
            total = total + (long)got;
        }
        return total;
    }

    // 逐块搬运分块编码：长度行原样透传，随后转发该块
    // 的数据与 CRLF；0 长度块后转发尾部直到空行结束。逐块转发
    // 正是流式聊天在下游能立刻显示的原因。
    // 返回搬运的数据字节数；未读到终结块就中断（对端先关、分块头
    // 非法、下游写失败）时返回 -1：这条链路停在了帧中间，不能再
    // 留给下一个请求用。
    private static async long PumpChunked(FwdReader src, FwdChannel dst, string head,
            int chunkBytes) {
        long total = 0;
        while (true) {
            string sizeLine = await src.ReadLineAsync(chunkBytes);
            if (sizeLine.Length == 0) { return -1; }
            long size = HttpForwarder.ParseChunkSize(sizeLine);
            if (size < 0) { return -1; }
            int w = await dst.SendAllAsync(sizeLine);
            if (w < sizeLine.Length) { return -1; }
            if (size == 0) {
                // trailer 不计入正文长度，单行及总量都必须单独限额。
                int trailerBytes = 0;
                while (true) {
                    string trailer = await src.ReadLineAsync(8192);
                    if (trailer.Length == 0 || trailerBytes + trailer.Length > 8192) {
                        return -1;
                    }
                    if (trailer != "\r\n" && !HttpForwarder.IsTrailerLineValid(trailer, head)) {
                        return -1;
                    }
                    trailerBytes = trailerBytes + trailer.Length;
                    int tw = await dst.SendAllAsync(trailer);
                    if (tw < trailer.Length) { return -1; }
                    if (trailer == "\r\n") { return total; }
                }
            }
            long moved = await HttpForwarder.PumpExact(src, dst, size, chunkBytes);
            if (moved < size) { return -1; }
            int cr = await src.ReadByteAsync();
            if (cr != 13) { return -1; }
            int lf = await src.ReadByteAsync();
            if (lf != 10) { return -1; }
            if (await dst.SendAllAsync("\r\n") < 2) { return -1; }
            total = total + moved;
        }
        return total;
    }

    // 双向裸字节隧道（CONNECT、101 Upgrade）。任一方向
    // 结束就关闭两端，另一方向随即收到 EOF 退出，因此
    // WhenAll 不会卡在半关闭的链路上。
    private static async void Tunnel(FwdChannel a, FwdReader ar, FwdChannel b,
            FwdReader br, int chunkBytes) {
        // 隧道切到无空闲截止的接收：连接建立后的沉默对隧道语义毫无
        // 意义（SSH/TLS 长时间单向空闲是常态），沿用请求级的
        // recvIdleMs 会把无流量的隧道在超时后掐断；而且带截止的
        // 接收在 Windows 上靠轮询循环实现，对端方向退出后 shutdown
        // 掉共享 fd 时它探不出闭合。无截止接收是真正挂起的重叠
        // 操作，teardown 的 CancelIoEx 能把它以 0 字节（EOF）唤醒。
        a.SetIdleMs(0);
        b.SetIdleMs(0);
        byte[] pending = new byte[chunkBytes];
        int count = ar.TakeBufferedBytes(pending, chunkBytes);
        while (count > 0) {
            int written = await b.SendAllBytesAsync(pending, 0, count);
            if (written < count) { a.Close(); b.Close(); return; }
            count = ar.TakeBufferedBytes(pending, chunkBytes);
        }
        count = br.TakeBufferedBytes(pending, chunkBytes);
        while (count > 0) {
            int written = await a.SendAllBytesAsync(pending, 0, count);
            if (written < count) { a.Close(); b.Close(); return; }
            count = br.TakeBufferedBytes(pending, chunkBytes);
        }
        List<long> tasks = new List<long>();
        tasks.Add(Task.Spawn(HttpForwarder.PumpUntilClose(a, b, chunkBytes)));
        tasks.Add(Task.Spawn(HttpForwarder.PumpUntilClose(b, a, chunkBytes)));
        await Task.WhenAll(tasks);
    }

    // 隧道单向的搬运：读到 EOF 或写失败即退出并关闭两端，
    // 让另一方向也随之收到 EOF。
    private static async void PumpUntilClose(FwdChannel src, FwdChannel dst,
            int chunkBytes) {
        byte[] data = new byte[chunkBytes];
        while (true) {
            int got = await src.RecvBytesAsync(data, chunkBytes);
            if (got <= 0) { break; }
            int w = await dst.SendAllBytesAsync(data, 0, got);
            if (w < got) { break; }
        }
        // 自己这一侧完整关闭；对端方向只 shutdown——它可能还挂在
        // dst 的读上（轮询式带超时接收对已关闭的 fd 永远探不到
        // 事件），shutdown 让它以 EOF 正常退出并亲手 Close 这条链路。
        src.Close();
        dst.Shutdown();
    }

    // ---- 头部解析辅助 ------------------------------------------------
}
