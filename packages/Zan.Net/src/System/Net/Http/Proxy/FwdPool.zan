using System;
using System.Collections.Generic;
using System.Net.Sockets;

namespace System.Net.Http.Proxy;

// 转发器单上游无键空闲连接池（复用已握手的 TCP/TLS 链路；借出前零超时检测可读/关闭以淘汰半关连接；
// 所有列表与套接字关闭均在 lock(items) 临界区内同步完成）。
public class FwdPool : IDisposable {
    private List<FwdPooledItem> items;
    private int maxIdle;
    private int idleMs;
    private long hits;
    private long misses;

    // 创建空池（空闲链路上限 maxIdle 条、空闲存活 idleMs 毫秒）。
    public FwdPool(int maxIdle, int idleMs) {
        this.items = new List<FwdPooledItem>();
        this.maxIdle = maxIdle;
        this.idleMs = idleMs;
        this.hits = 0;
        this.misses = 0;
    }

    // 取一条可用的空闲链路，没有则返回 null（调用方新建）。
    public FwdChannel Take() {
        lock (items) {
            long now = Stopwatch.GetMilliseconds();
            while (this.items.Count > 0) {
                int last = this.items.Count - 1;
                FwdPooledItem it = this.items[last];
                this.items.RemoveAt(last);
                if (now > it.expiry || it.ch.IsClosed()
                    || !Socket.IsOpen(it.ch.Sock())
                    || Socket.IsReadable(it.ch.Sock())) {
                    it.ch.Close();
                } else {
                    this.hits = this.hits + 1;
                    return it.ch;
                }
            }
            this.misses = this.misses + 1;
            return null;
        }
    }

    // 归还一条仍然干净的链路（响应已按声明的长度读完）。
    // 池满时直接关闭，空闲链路数因此有上界。
    public void Give(FwdChannel ch) {
        if (ch == null) { return; }
        if (ch.IsClosed()) { return; }
        lock (items) {
            if (this.items.Count >= this.maxIdle) {
                ch.Close();
                return;
            }
            this.items.Add(new FwdPooledItem(ch, Stopwatch.GetMilliseconds() + (long)this.idleMs));
        }
    }

    // 关闭所有空闲链路（转发器停止时调用）。
    public void CloseAll() {
        lock (items) {
            for (int i = 0; i < this.items.Count; i = i + 1) {
                this.items[i].ch.Close();
            }
            this.items.Clear();
        }
    }

    public void Dispose() {
        this.CloseAll();
    }

    // 复用成功的次数（省下的握手数）。
    public long Hits() { return this.hits; }

    // 池中无可用链路、必须新建的次数。
    public long Misses() { return this.misses; }

    // 当前空闲链路数。
    public int IdleCount() {
        lock (items) {
            return this.items.Count;
        }
    }
}
