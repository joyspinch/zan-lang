using System;
using System.Collections.Generic;
using System.Net.Sockets;

namespace System.Net.Http.Proxy;

// 上游连接池：转发器只有一个上游（host:port + 是否 TLS），因此
// 池子不需要键，一条空闲链路对下一个请求总是可用的。
// 意义在于握手：转发 AI 接口时每个请求都要一次 TCP 三次握手加
// 一次 TLS 握手（跨机房是毫秒级，比转发本身贵一到两个数量级），
// 而复用一条已握手的链路把这部分降到零。
// 借出前用 <c>select()</c> 零超时检查一次：空闲链路上"可读"只
// 意味着对端已关闭或发来了不属于任何请求的字节，两种都不可再用，
// 直接丢弃。上游在检查与发送之间关闭的竞态由调用方兜底
// （无正文的请求换新连接重发一次）。
// 池表是转发器实例级的，而连接协程可能落在不同 worker 线程上，
// 因此每处访问都在 <c>lock (items)</c> 内；临界区里只有列表操作与
// 关闭套接字，不含 await。
class FwdPool {
    List<FwdPooledItem> items;
    int maxIdle;
    int idleMs;
    long hits;
    long misses;

    // 创建空池：空闲链路上限 <paramref name="maxIdle"/> 条、
    // 空闲存活 <paramref name="idleMs"/> 毫秒。
    FwdPool(int maxIdle, int idleMs) {
        this.items = new List<FwdPooledItem>();
        this.maxIdle = maxIdle;
        this.idleMs = idleMs;
        this.hits = 0;
        this.misses = 0;
    }

    // 取一条可用的空闲链路，没有则返回 null（调用方新建）。
    FwdChannel Take() {
        lock (items) {
            long now = Stopwatch.GetMilliseconds();
            while (this.items.Count > 0) {
                int last = this.items.Count - 1;
                FwdPooledItem it = this.items[last];
                this.items.RemoveAt(last);
                if (now > it.expiry || it.ch.IsClosed()
                    || !Socket.IsOpen(it.ch.Sock())
                    || Socket.IsReadable(it.ch.Sock())) {
                    it.ch.Close();
                } else {
                    this.hits = this.hits + 1;
                    return it.ch;
                }
            }
            this.misses = this.misses + 1;
            return null;
        }
    }

    // 归还一条仍然干净的链路（响应已按声明的长度读完）。
    // 池满时直接关闭，空闲链路数因此有上界。
    void Give(FwdChannel ch) {
        if (ch == null) { return; }
        if (ch.IsClosed()) { return; }
        lock (items) {
            if (this.items.Count >= this.maxIdle) {
                ch.Close();
                return;
            }
            this.items.Add(new FwdPooledItem(ch, Stopwatch.GetMilliseconds() + (long)this.idleMs));
        }
    }

    // 关闭所有空闲链路（转发器停止时调用）。
    void CloseAll() {
        lock (items) {
            for (int i = 0; i < this.items.Count; i = i + 1) {
                this.items[i].ch.Close();
            }
            this.items.Clear();
        }
    }

    // 复用成功的次数（省下的握手数）。
    long Hits() { return this.hits; }

    // 池中无可用链路、必须新建的次数。
    long Misses() { return this.misses; }

    // 当前空闲链路数。
    int IdleCount() {
        lock (items) {
            return this.items.Count;
        }
    }
}

// 带前瞻缓冲的链路读取器：协议头按文本读，正文按真实字节数读。
// 同包到达的正文留在 ByteBuffer 中，不能用 strlen 截断 NUL。
