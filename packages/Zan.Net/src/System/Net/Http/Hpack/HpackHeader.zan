using System;

namespace System.Net.Http.Hpack;

// HPACK 键值对条目（RFC 7541）。
public class HpackHeader {
    public string name;
    public string value;

    public HpackHeader(string name, string value) {
        this.name = name != null ? name : "";
        this.value = value != null ? value : "";
    }

    // RFC 7541 §4.1: 条目尺寸 = name 字节长度 + value 字节长度 + 32 字节元数据开销
    public int Size() {
        return this.name.Length + this.value.Length + 32;
    }
}
