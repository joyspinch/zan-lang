using System;
using System.Collections.Generic;

namespace System.Net.Http.Hpack;

// RFC 7541 附录 A: HPACK 静态表（61 个预定义头部字段，索引 1..61）。
public class HpackStaticTable {
    private static List<HpackHeader> entries;

    private static void EnsureInit() {
        if (entries != null) { return; }
        List<HpackHeader> list = new List<HpackHeader>();
        // 下标 0 占位，使静态表索引对齐 RFC 7541 1-based 定义
        list.Add(new HpackHeader("", ""));
        list.Add(new HpackHeader(":authority", ""));
        list.Add(new HpackHeader(":method", "GET"));
        list.Add(new HpackHeader(":method", "POST"));
        list.Add(new HpackHeader(":path", "/"));
        list.Add(new HpackHeader(":path", "/index.html"));
        list.Add(new HpackHeader(":scheme", "http"));
        list.Add(new HpackHeader(":scheme", "https"));
        list.Add(new HpackHeader(":status", "200"));
        list.Add(new HpackHeader(":status", "204"));
        list.Add(new HpackHeader(":status", "206"));
        list.Add(new HpackHeader(":status", "304"));
        list.Add(new HpackHeader(":status", "400"));
        list.Add(new HpackHeader(":status", "404"));
        list.Add(new HpackHeader(":status", "500"));
        list.Add(new HpackHeader("accept-charset", ""));
        list.Add(new HpackHeader("accept-encoding", "gzip, deflate"));
        list.Add(new HpackHeader("accept-language", ""));
        list.Add(new HpackHeader("accept-ranges", ""));
        list.Add(new HpackHeader("accept", ""));
        list.Add(new HpackHeader("access-control-allow-origin", ""));
        list.Add(new HpackHeader("age", ""));
        list.Add(new HpackHeader("allow", ""));
        list.Add(new HpackHeader("authorization", ""));
        list.Add(new HpackHeader("cache-control", ""));
        list.Add(new HpackHeader("content-disposition", ""));
        list.Add(new HpackHeader("content-encoding", ""));
        list.Add(new HpackHeader("content-language", ""));
        list.Add(new HpackHeader("content-length", ""));
        list.Add(new HpackHeader("content-location", ""));
        list.Add(new HpackHeader("content-range", ""));
        list.Add(new HpackHeader("content-type", ""));
        list.Add(new HpackHeader("cookie", ""));
        list.Add(new HpackHeader("date", ""));
        list.Add(new HpackHeader("etag", ""));
        list.Add(new HpackHeader("expect", ""));
        list.Add(new HpackHeader("expires", ""));
        list.Add(new HpackHeader("from", ""));
        list.Add(new HpackHeader("host", ""));
        list.Add(new HpackHeader("if-match", ""));
        list.Add(new HpackHeader("if-modified-since", ""));
        list.Add(new HpackHeader("if-none-match", ""));
        list.Add(new HpackHeader("if-range", ""));
        list.Add(new HpackHeader("if-unmodified-since", ""));
        list.Add(new HpackHeader("last-modified", ""));
        list.Add(new HpackHeader("link", ""));
        list.Add(new HpackHeader("location", ""));
        list.Add(new HpackHeader("max-forwards", ""));
        list.Add(new HpackHeader("proxy-authenticate", ""));
        list.Add(new HpackHeader("proxy-authorization", ""));
        list.Add(new HpackHeader("range", ""));
        list.Add(new HpackHeader("referer", ""));
        list.Add(new HpackHeader("refresh", ""));
        list.Add(new HpackHeader("retry-after", ""));
        list.Add(new HpackHeader("server", ""));
        list.Add(new HpackHeader("set-cookie", ""));
        list.Add(new HpackHeader("strict-transport-security", ""));
        list.Add(new HpackHeader("transfer-encoding", ""));
        list.Add(new HpackHeader("user-agent", ""));
        list.Add(new HpackHeader("vary", ""));
        list.Add(new HpackHeader("via", ""));
        list.Add(new HpackHeader("www-authenticate", ""));
        entries = list;
    }

    public static int Count() {
        EnsureInit();
        return 61;
    }

    // 根据 1..61 索引获取条目，无效索引返回 null。
    public static HpackHeader Get(int index) {
        EnsureInit();
        if (index < 1 || index > 61) { return null; }
        return entries[index];
    }

    // 在静态表中查找匹配条目：
    // 若完全匹配（name 与 value 均相同），返回该索引（1..61）；
    // 若仅 name 匹配，outNameIndex[0] 记录该索引并继续查找是否有完全匹配；
    // 最终无完全匹配时返回 0。
    public static int Find(string name, string value, List<int> outNameIndex) {
        EnsureInit();
        int nameMatch = 0;
        for (int i = 1; i <= 61; i = i + 1) {
            HpackHeader e = entries[i];
            if (e.name == name) {
                if (e.value == value) {
                    return i; // 找到完全匹配
                }
                if (nameMatch == 0) {
                    nameMatch = i; // 记录第一个 name 匹配
                }
            }
        }
        if (outNameIndex != null && nameMatch > 0) {
            outNameIndex.Add(nameMatch);
        }
        return 0;
    }

    // 拆卸静态表缓存，防止常驻静态根阻断进程退出泄漏探测。
    public static void Teardown() {
        if (entries != null) {
            entries.Clear();
            entries = null;
        }
    }
}
