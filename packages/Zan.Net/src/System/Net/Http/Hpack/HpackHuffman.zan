using System;
using System.Collections.Generic;

namespace System.Net.Http.Hpack;

// HPACK 霍夫曼解码树内部节点。
public class HpackHuffmanNode {
    public int symbol;
    public HpackHuffmanNode left;
    public HpackHuffmanNode right;

    public HpackHuffmanNode() {
        this.symbol = -1;
        this.left = null;
        this.right = null;
    }
}

