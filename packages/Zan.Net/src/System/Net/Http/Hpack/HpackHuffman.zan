        HpackHuffmanNode r = new HpackHuffmanNode();
        for (int sym = 0; sym < 257; sym = sym + 1) {
            int c = codes[sym];
            int l = lens[sym];
            HpackHuffmanNode curr = r;
            for (int b = l - 1; b >= 0; b = b - 1) {
                int bit = (c >> b) & 1;
                if (bit == 0) {
                    if (curr.left == null) { curr.left = new HpackHuffmanNode(); }
                    curr = curr.left;
                } else {
                    if (curr.right == null) { curr.right = new HpackHuffmanNode(); }
                    curr = curr.right;
                }
            }
            curr.symbol = sym;
        }
        root = r;
    }

    // 将输入字节流通过霍夫曼树解码为原始文本（RFC 7541 §5.2）。
    // 若霍夫曼码非法或包含 EOS 符号，返回 null。
    public static string Decode(byte[] buf, int offset, int length) {
        if (buf == null || offset < 0 || length < 0 || offset + length > buf.Length) { return null; }
        if (length == 0) { return ""; }
        EnsureInit();
        HpackHuffmanNode curr = root;
        byte[] outBuf = new byte[length * 4 + 8];
        int outLen = 0;
        for (int i = 0; i < length; i = i + 1) {
            int b = buf[offset + i] & 255;
            for (int bitPos = 7; bitPos >= 0; bitPos = bitPos - 1) {
                int bit = (b >> bitPos) & 1;
                curr = bit == 0 ? curr.left : curr.right;
                if (curr == null) { return null; }
                if (curr.symbol >= 0) {
                    if (curr.symbol == 256) { return null; } // RFC 7541: EOS 符号不能作为字符
                    if (outLen >= outBuf.Length) {
                        byte[] bigger = new byte[outBuf.Length * 2];
                        NativeMemory.Copy((nint)bigger, (nint)outBuf, outLen);
                        outBuf = bigger;
                    }
                    outBuf[outLen] = (byte)curr.symbol;
                    outLen = outLen + 1;
                    curr = root;
                }
            }
        }
        return outBuf.ToStr(0, outLen);
    }

    // 将字符串编码为 RFC 7541 霍夫曼字节数组（末尾以全 1 的 EOS 前缀填充）。
    public static byte[] Encode(string s) {
        if (s == null || s.Length == 0) { return new byte[0]; }
        EnsureInit();
        List<int> bytesList = new List<int>();
        long accum = 0;
        int accumBits = 0;
        for (int i = 0; i < s.Length; i = i + 1) {
            int ch = s[i] & 255;
            int c = codes[ch];
            int l = lens[ch];
            accum = (accum << l) | (long)c;
            accumBits = accumBits + l;
            while (accumBits >= 8) {
                accumBits = accumBits - 8;
                bytesList.Add((int)((accum >> accumBits) & 255));
            }
        }
        if (accumBits > 0) {
            int pad = 8 - accumBits;
            accum = (accum << pad) | (long)((1 << pad) - 1);
            bytesList.Add((int)(accum & 255));
        }
        byte[] res = new byte[bytesList.Count];
        for (int k = 0; k < bytesList.Count; k = k + 1) {
            res[k] = (byte)bytesList[k];
        }
        return res;
    }

    // 拆卸霍夫曼解码树与编码表静态缓存，防止常驻静态根阻断进程退出泄漏探测。
    public static void Teardown() {
        root = null;
        if (codes != null) {
            codes.Clear();
            codes = null;
        }
        if (lens != null) {
            lens.Clear();
            lens = null;
        }
    }
}
