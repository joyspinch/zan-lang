using System;
using System.IO;
using System.Collections.Generic;

namespace System.Net.Http.Hpack;

// RFC 7541 HPACK 编码与解码上下文环境（包含动态表、头部匹配、整数与字符串编解码）。
public class HpackContext {
    public List<HpackHeader> dynamicTable;
    public int maxTableSize;
    public int currentTableSize;
    private int allowedTableSize;
    public int maxHeaderBytes = 65536;
    public int maxHeaderCount = 128;
    private bool decodeFailed;

    public HpackContext(int maxTableSize) {
        this.dynamicTable = new List<HpackHeader>();
        this.maxTableSize = maxTableSize >= 0 ? maxTableSize : 4096;
        this.allowedTableSize = this.maxTableSize;
        this.currentTableSize = 0;
    }

    public HpackContext() {
        this.dynamicTable = new List<HpackHeader>();
        this.maxTableSize = 4096;
        this.allowedTableSize = 4096;
        this.currentTableSize = 0;
    }

    // 设置动态表最大字节上限（并触发超额淘汰）。
    public void SetMaxTableSize(int newSize) {
        this.allowedTableSize = newSize >= 0 ? newSize : 0;
        this.maxTableSize = this.allowedTableSize;
        this.EvictToMax(this.maxTableSize);
    }

    private void EvictToMax(int limit) {
        while (this.currentTableSize > limit && this.dynamicTable.Count > 0) {
            int lastIdx = this.dynamicTable.Count - 1;
            HpackHeader oldest = this.dynamicTable[lastIdx];
            this.currentTableSize = this.currentTableSize - oldest.Size();
            this.dynamicTable.RemoveAt(lastIdx);
        }
    }

    // 向动态表插入新条目（FIFO：插入表头 0，即索引 62 处）。
    public void AddHeader(string name, string value) {
        HpackHeader entry = new HpackHeader(name, value);
        int entrySize = entry.Size();
        if (entrySize > this.maxTableSize) {
            // 单条目超过表上限：按 RFC 7541 §4.3 清空全表
            this.dynamicTable.Clear();
            this.currentTableSize = 0;
            return;
        }
        this.EvictToMax(this.maxTableSize - entrySize);
        this.dynamicTable.Add(entry);
        for (int i = this.dynamicTable.Count - 1; i > 0; i = i - 1) {
            this.dynamicTable[i] = this.dynamicTable[i - 1];
        }
        this.dynamicTable[0] = entry;
        this.currentTableSize = this.currentTableSize + entrySize;
    }

    // 根据 1-based 索引检索静态表（1..61）或动态表（62..）。
    public HpackHeader GetHeader(int index) {
        if (index >= 1 && index <= 61) {
            return HpackStaticTable.Get(index);
        }
        int dynamicIdx = index - 62;
        if (dynamicIdx >= 0 && dynamicIdx < this.dynamicTable.Count) {
            return this.dynamicTable[dynamicIdx];
        }
        return null;
    }

    // 在静态表与动态表中查找完全匹配（返回非 0 索引）或仅名称匹配（outNameIndex 记录首个匹配）。
    public int Find(string name, string value, List<int> outNameIndex) {
        List<int> staticName = new List<int>();
        int exactStatic = HpackStaticTable.Find(name, value, staticName);
        if (exactStatic > 0) {
            return exactStatic;
        }
        int firstNameIdx = staticName.Count > 0 ? staticName[0] : 0;

        for (int i = 0; i < this.dynamicTable.Count; i = i + 1) {
            HpackHeader e = this.dynamicTable[i];
            if (e.name == name) {
                if (e.value == value) {
                    return 62 + i;
                }
                if (firstNameIdx == 0) {
                    firstNameIdx = 62 + i;
                }
            }
        }
        if (outNameIndex != null && firstNameIdx > 0) {
            outNameIndex.Add(firstNameIdx);
        }
        return 0;
    }

    // RFC 7541 §5.1: 变长整数编码
    public static void EncodeInt(List<int> outBytes, int initialByte, int prefixBits, int val) {
        int maxPrefix = (1 << prefixBits) - 1;
        if (val < maxPrefix) {
            outBytes.Add(initialByte | val);
            return;
        }
        outBytes.Add(initialByte | maxPrefix);
        val = val - maxPrefix;
        while (val >= 128) {
            outBytes.Add((val & 127) | 128);
            val = val >> 7;
        }
        outBytes.Add(val);
    }

    // RFC 7541 §5.1: 变长整数解码
    public static int DecodeInt(byte[] buf, List<int> pos, int prefixBits) {
        return HpackContext.ReadInt(buf, pos, prefixBits, buf == null ? 0 : buf.Length);
    }
    private static int ReadInt(byte[] buf, List<int> pos, int bits, int end) {
        if (buf == null || pos == null || pos.Count == 0 || bits < 1 || bits > 8) { throw new IOException("Invalid HPACK integer"); }
        int p = pos[0];
        if (p < 0 || end > buf.Length || p >= end) { throw new IOException("Truncated HPACK integer"); }
        int mask = (1 << bits) - 1;
        long value = buf[p] & mask;
        p = p + 1;
        if (value == mask) {
            int shift = 0;
            while (true) {
                if (p >= end || shift > 28) { throw new IOException("Invalid HPACK integer"); }
                int part = buf[p] & 255;
                p = p + 1;
                value = value + ((long)(part & 127) << shift);
                if (value > 2147483647) { throw new IOException("HPACK integer overflow"); }
                if ((part & 128) == 0) { break; }
                shift = shift + 7;
            }
        }
        pos[0] = p;
        return (int)value;
    }

    // RFC 7541 §5.2: 字符串字面量编码
    public static void EncodeString(List<int> outBytes, string s, bool useHuffman) {
        if (s == null) { s = ""; }
        if (useHuffman) {
            byte[] huff = HpackHuffman.Encode(s);
            if (huff.Length < s.Length) {
                // H = 1 (bit 7 为 1)
                HpackContext.EncodeInt(outBytes, 128, 7, huff.Length);
                for (int i = 0; i < huff.Length; i = i + 1) {
                    outBytes.Add(huff[i] & 255);
                }
                return;
            }
        }
        // H = 0
        HpackContext.EncodeInt(outBytes, 0, 7, s.Length);
        for (int j = 0; j < s.Length; j = j + 1) {
            outBytes.Add(s[j] & 255);
        }
    }

    // RFC 7541 §5.2: 字符串字面量解码
    public static string DecodeString(byte[] buf, List<int> pos) {
        return HpackContext.ReadString(buf, pos, buf == null ? 0 : buf.Length, 65536);
    }
    private static string ReadString(byte[] buf, List<int> pos, int end, int budget) {
        if (buf == null || pos == null || pos.Count == 0 || pos[0] < 0 || pos[0] >= end) { throw new IOException("Truncated HPACK string"); }
        bool huffman = (buf[pos[0]] & 128) != 0;
        int count = HpackContext.ReadInt(buf, pos, 7, end);
        int p = pos[0];
        if (count > end - p || count > budget || budget < 0) { throw new IOException("HPACK string limit"); }
        string value = huffman ? HpackHuffman.Decode(buf, p, count) : buf.ToStr(p, count);
        if (value == null || value.Length > budget) { throw new IOException("Invalid HPACK string"); }
        pos[0] = p + count;
        return value;
    }
    // A failed block poisons the context; partially updated compression state cannot be reused.
    public List<HpackHeader> DecodeHeaderBlock(byte[] buf, int offset, int length) {
        if (this.decodeFailed) { throw new IOException("Failed HPACK context"); }
        try { return this.DecodeBlock(buf, offset, length); }
        catch (Exception ex) {
            this.decodeFailed = true;
            throw new IOException("Invalid HPACK block: " + ex.Message);
        }
    }
    private List<HpackHeader> DecodeBlock(byte[] buf, int offset, int length) {
        if (buf == null || offset < 0 || length < 0 || offset > buf.Length || length > buf.Length - offset || length > this.maxHeaderBytes) { throw new IOException("HPACK block limit"); }
        List<HpackHeader> headers = new List<HpackHeader>();
        List<int> pos = new List<int>();
        pos.Add(offset);
        int end = offset + length;
        int bytes = 0;
        bool fields = false;
        while (pos[0] < end) {
            int first = buf[pos[0]] & 255;
            if ((first & 224) == 32) {
                int size = HpackContext.ReadInt(buf, pos, 5, end);
                if (fields || size > this.allowedTableSize) { throw new IOException("Invalid HPACK table update"); }
                this.maxTableSize = size;
                this.EvictToMax(size);
                continue;
            }
            if (headers.Count >= this.maxHeaderCount) { throw new IOException("HPACK field count limit"); }
            fields = true;
            string name = "";
            string value = "";
            bool indexed = (first & 128) != 0;
            bool insert = (first & 192) == 64;
            int index = HpackContext.ReadInt(buf, pos, indexed ? 7 : (insert ? 6 : 4), end);
            if (index > 0) {
                HpackHeader entry = this.GetHeader(index);
                if (entry == null) { throw new IOException("Invalid HPACK index"); }
                name = entry.name;
                if (indexed) { value = entry.value; }
            } else {
                if (indexed) { throw new IOException("Zero HPACK index"); }
                name = HpackContext.ReadString(buf, pos, end, this.maxHeaderBytes - bytes);
            }
            if (!indexed) { value = HpackContext.ReadString(buf, pos, end, this.maxHeaderBytes - bytes - name.Length); }
            if (name.Length == 0 || name.Length + value.Length + 32 > this.maxHeaderBytes - bytes) { throw new IOException("HPACK header list limit"); }
            bytes = bytes + name.Length + value.Length + 32;
            if (insert) { this.AddHeader(name, value); }
            headers.Add(new HpackHeader(name, value));
        }
        return headers;
    }

    // 编码一组头部字段为 HPACK 字节流（采用紧凑且标准的增量索引策略）。
    public byte[] EncodeHeaders(List<HpackHeader> headers, bool useHuffman) {
        if (headers == null || headers.Count == 0) { return new byte[0]; }
        List<int> bytesList = new List<int>();

        for (int i = 0; i < headers.Count; i = i + 1) {
            HpackHeader h = headers[i];
            List<int> nameBox = new List<int>();
            int exactIdx = this.Find(h.name, h.value, nameBox);
            if (exactIdx > 0) {
                // 完全命中：以 Indexed Header Field (1xxxxxxx, prefix 7) 编码
                HpackContext.EncodeInt(bytesList, 128, 7, exactIdx);
            } else if (nameBox.Count > 0 && nameBox[0] > 0) {
                // 名称命中：以 Literal Header Field with Incremental Indexing (01xxxxxx, prefix 6) 编码
                int nameIdx = nameBox[0];
                HpackContext.EncodeInt(bytesList, 64, 6, nameIdx);
                HpackContext.EncodeString(bytesList, h.value, useHuffman);
                this.AddHeader(h.name, h.value);
            } else {
                // 全新头部：Literal with Incremental Indexing (01000000, index 0)
                HpackContext.EncodeInt(bytesList, 64, 6, 0);
                HpackContext.EncodeString(bytesList, h.name, useHuffman);
                HpackContext.EncodeString(bytesList, h.value, useHuffman);
                this.AddHeader(h.name, h.value);
            }
        }

        byte[] res = new byte[bytesList.Count];
        for (int k = 0; k < bytesList.Count; k = k + 1) {
            res[k] = (byte)bytesList[k];
        }
        return res;
    }
}
