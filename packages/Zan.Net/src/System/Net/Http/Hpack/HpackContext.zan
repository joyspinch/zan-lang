using System;
using System.IO;
using System.Collections.Generic;

namespace System.Net.Http.Hpack;

// RFC 7541 HPACK 编码与解码上下文环境（包含动态表、头部匹配、整数与字符串编解码）。
public class HpackContext {
    public List<HpackHeader> dynamicTable;
    public int maxTableSize;
    public int currentTableSize;
    private int allowedTableSize;
    public int maxHeaderBytes = 65536;
    public int maxHeaderCount = 128;
    private bool decodeFailed;
    // O(1) 动态表名称哈希链索引（单调递增序号 + 环形 prevSeq，零额外堆分配，严格保持 RFC 7541 最小索引优先）。
    private long insertSeq;
    private int indexedCount;
    private int ringCap;
    private int ringMask;
    private long[] bucketHead;
    private long[] prevSeq;

    public HpackContext(int maxTableSize) {
        this.dynamicTable = new List<HpackHeader>();
        this.maxTableSize = maxTableSize >= 0 ? maxTableSize : 4096;
        this.allowedTableSize = this.maxTableSize;
        this.currentTableSize = 0;
    }

    public HpackContext() {
        this.dynamicTable = new List<HpackHeader>();
        this.maxTableSize = 4096;
        this.allowedTableSize = 4096;
        this.currentTableSize = 0;
    }

    private static int HashBucket(string name) {
        if (name == null) { return 0; }
        int h = 5381;
        int len = name.Length;
        for (int i = 0; i < len; i = i + 1) {
            h = ((h << 5) + h) ^ (name[i] & 255);
        }
        return (h ^ (h >> 8) ^ (h >> 16)) & 255;
    }

    private void RebuildDynIndex() {
        int dynCount = this.dynamicTable.Count;
        int needCap = this.ringCap < 256 ? 256 : this.ringCap;
        while (needCap <= dynCount) { needCap = needCap * 2; }
        if (this.bucketHead == null) {
            this.bucketHead = new long[256];
        } else {
            for (int k = 0; k < 256; k = k + 1) { this.bucketHead[k] = 0L; }
        }
        if (this.prevSeq == null || this.ringCap != needCap) {
            this.prevSeq = new long[needCap];
            this.ringCap = needCap;
            this.ringMask = needCap - 1;
        }
        if (this.insertSeq < (long)dynCount) {
            this.insertSeq = (long)dynCount;
        }
        long curSeq = this.insertSeq;
        long mask = (long)this.ringMask;
        // 从最旧条目（大索引）到最新条目（小索引）回填，保证桶头指向最新（最小动态索引）。
        for (int i = dynCount - 1; i >= 0; i = i - 1) {
            HpackHeader e = this.dynamicTable[i];
            int b = HpackContext.HashBucket(e.name);
            long seq = curSeq - (long)i;
            this.prevSeq[(int)(seq & mask)] = this.bucketHead[b];
            this.bucketHead[b] = seq;
        }
        this.indexedCount = dynCount;
    }

    // 设置动态表最大字节上限（并触发超额淘汰）。
    public void SetMaxTableSize(int newSize) {
        this.allowedTableSize = newSize >= 0 ? newSize : 0;
        this.maxTableSize = this.allowedTableSize;
        this.EvictToMax(this.maxTableSize);
    }

    private void EvictToMax(int limit) {
        while (this.currentTableSize > limit && this.dynamicTable.Count > 0) {
            int lastIdx = this.dynamicTable.Count - 1;
            HpackHeader oldest = this.dynamicTable[lastIdx];
            this.currentTableSize = this.currentTableSize - oldest.Size();
            this.dynamicTable.RemoveAt(lastIdx);
        }
        this.indexedCount = this.dynamicTable.Count;
    }

    // 向动态表插入新条目（FIFO：插入表头 0，即索引 62 处）。
    public void AddHeader(string name, string value) {
        HpackHeader entry = new HpackHeader(name, value);
        int entrySize = entry.Size();
        if (entrySize > this.maxTableSize) {
            // 单条目超过表上限：按 RFC 7541 §4.3 清空全表
            this.dynamicTable.Clear();
            this.currentTableSize = 0;
            this.indexedCount = 0;
            return;
        }
        this.EvictToMax(this.maxTableSize - entrySize);
        this.dynamicTable.Add(entry);
        for (int i = this.dynamicTable.Count - 1; i > 0; i = i - 1) {
            this.dynamicTable[i] = this.dynamicTable[i - 1];
        }
        this.dynamicTable[0] = entry;
        this.currentTableSize = this.currentTableSize + entrySize;

        int newCount = this.dynamicTable.Count;
        this.insertSeq = this.insertSeq + 1L;
        if (this.bucketHead == null || newCount >= this.ringCap) {
            this.RebuildDynIndex();
        } else {
            int b = HpackContext.HashBucket(name);
            int slot = (int)(this.insertSeq & (long)this.ringMask);
            this.prevSeq[slot] = this.bucketHead[b];
            this.bucketHead[b] = this.insertSeq;
            this.indexedCount = newCount;
        }
    }

    // 根据 1-based 索引检索静态表（1..61）或动态表（62..）。
    public HpackHeader GetHeader(int index) {
        if (index >= 1 && index <= 61) {
            return HpackStaticTable.Get(index);
        }
        int dynamicIdx = index - 62;
        if (dynamicIdx >= 0 && dynamicIdx < this.dynamicTable.Count) {
            return this.dynamicTable[dynamicIdx];
        }
        return null;
    }

    // 在静态表与动态表中查找完全匹配（返回非 0 索引）或仅名称匹配（outNameIdx 输出首个匹配，O(1) 哈希链查找）。
    private int FindFast(string name, string value, out int outNameIdx) {
        int firstNameIdx = 0;
        int exactStatic = HpackStaticTable.FindFast(name, value, out firstNameIdx);
        if (exactStatic > 0) {
            outNameIdx = firstNameIdx;
            return exactStatic;
        }
        int dynCount = this.dynamicTable.Count;
        if (dynCount == 0) {
            outNameIdx = firstNameIdx;
            return 0;
        }
        if (this.bucketHead == null || dynCount != this.indexedCount) {
            this.RebuildDynIndex();
        }
        long curSeq = this.insertSeq;
        long minValid = curSeq - (long)dynCount + 1L;
        int b = HpackContext.HashBucket(name);
        long seq = this.bucketHead[b];
        long mask = (long)this.ringMask;
        while (seq >= minValid) {
            int i = (int)(curSeq - seq);
            HpackHeader e = this.dynamicTable[i];
            if (e.name == name) {
                if (e.value == value) {
                    outNameIdx = 62 + i;
                    return 62 + i;
                }
                if (firstNameIdx == 0) {
                    firstNameIdx = 62 + i;
                }
            }
            seq = this.prevSeq[(int)(seq & mask)];
        }
        outNameIdx = firstNameIdx;
        return 0;
    }

    // 在静态表与动态表中查找完全匹配（返回非 0 索引）或仅名称匹配（outNameIndex 记录首个匹配）。
    public int Find(string name, string value, List<int> outNameIndex) {
        int nameIdx = 0;
        int exact = this.FindFast(name, value, out nameIdx);
        if (exact > 0) { return exact; }
        if (outNameIndex != null && nameIdx > 0) {
            outNameIndex.Add(nameIdx);
        }
        return 0;
    }

    // RFC 7541 §5.1: 变长整数编码
    public static void EncodeInt(List<int> outBytes, int initialByte, int prefixBits, int val) {
        int maxPrefix = (1 << prefixBits) - 1;
        if (val < maxPrefix) {
            outBytes.Add(initialByte | val);
            return;
        }
        outBytes.Add(initialByte | maxPrefix);
        val = val - maxPrefix;
        while (val >= 128) {
            outBytes.Add((val & 127) | 128);
            val = val >> 7;
        }
        outBytes.Add(val);
    }

    // RFC 7541 §5.1: 变长整数解码
    public static int DecodeInt(byte[] buf, List<int> pos, int prefixBits) {
        return HpackContext.ReadInt(buf, pos, prefixBits, buf == null ? 0 : buf.Length);
    }
    private static int ReadIntRef(byte[] buf, ref int p, int bits, int end) {
        if (buf == null || bits < 1 || bits > 8) { throw new IOException("Invalid HPACK integer"); }
        if (p < 0 || end > buf.Length || p >= end) { throw new IOException("Truncated HPACK integer"); }
        int mask = (1 << bits) - 1;
        long value = buf[p] & mask;
        p = p + 1;
        if (value == mask) {
            int shift = 0;
            while (true) {
                if (p >= end || shift > 28) { throw new IOException("Invalid HPACK integer"); }
                int part = buf[p] & 255;
                p = p + 1;
                value = value + ((long)(part & 127) << shift);
                if (value > 2147483647) { throw new IOException("HPACK integer overflow"); }
                if ((part & 128) == 0) { break; }
                shift = shift + 7;
            }
        }
        return (int)value;
    }

    private static int ReadInt(byte[] buf, List<int> pos, int bits, int end) {
        if (pos == null || pos.Count == 0) { throw new IOException("Invalid HPACK integer"); }
        int p = pos[0];
        int res = HpackContext.ReadIntRef(buf, ref p, bits, end);
        pos[0] = p;
        return res;
    }

    // RFC 7541 §5.2: 字符串字面量编码
    public static void EncodeString(List<int> outBytes, string s, bool useHuffman) {
        if (s == null) { s = ""; }
        if (useHuffman) {
            int hlen = HpackHuffman.EncodedLength(s);
            if (hlen < s.Length) {
                byte[] huff = new byte[hlen];
                HpackHuffman.EncodeInto(s, huff, 0);
                // H = 1 (bit 7 为 1)
                HpackContext.EncodeInt(outBytes, 128, 7, hlen);
                for (int i = 0; i < hlen; i = i + 1) {
                    outBytes.Add(huff[i] & 255);
                }
                return;
            }
        }
        // H = 0
        HpackContext.EncodeInt(outBytes, 0, 7, s.Length);
        for (int j = 0; j < s.Length; j = j + 1) {
            outBytes.Add(s[j] & 255);
        }
    }

    private static byte[] EnsureBufRoom(byte[] buf, int pos, int extra) {
        int need = pos + extra;
        if (need <= buf.Length) { return buf; }
        int c = buf.Length * 2;
        while (c < need) { c = c * 2; }
        byte[] grown = new byte[c];
        NativeMemory.Copy((nint)grown, (nint)buf, pos);
        return grown;
    }

    private static byte[] WriteIntBuf(byte[] buf, ref int pos, int initialByte, int prefixBits, int val) {
        buf = HpackContext.EnsureBufRoom(buf, pos, 8);
        int maxPrefix = (1 << prefixBits) - 1;
        if (val < maxPrefix) {
            buf[pos] = (byte)(initialByte | val);
            pos = pos + 1;
            return buf;
        }
        buf[pos] = (byte)(initialByte | maxPrefix);
        pos = pos + 1;
        val = val - maxPrefix;
        while (val >= 128) {
            buf[pos] = (byte)((val & 127) | 128);
            pos = pos + 1;
            val = val >> 7;
        }
        buf[pos] = (byte)val;
        pos = pos + 1;
        return buf;
    }

    private static byte[] WriteStringBuf(byte[] buf, ref int pos, string s, bool useHuffman) {
        if (s == null) { s = ""; }
        int slen = s.Length;
        if (useHuffman && slen > 0) {
            int hlen = HpackHuffman.EncodedLength(s);
            if (hlen < slen) {
                buf = HpackContext.WriteIntBuf(buf, ref pos, 128, 7, hlen);
                buf = HpackContext.EnsureBufRoom(buf, pos, hlen);
                HpackHuffman.EncodeInto(s, buf, pos);
                pos = pos + hlen;
                return buf;
            }
        }
        buf = HpackContext.WriteIntBuf(buf, ref pos, 0, 7, slen);
        if (slen > 0) {
            buf = HpackContext.EnsureBufRoom(buf, pos, slen);
            NativeMemory.PutString((nint)buf, pos, s, slen);
            pos = pos + slen;
        }
        return buf;
    }

    // RFC 7541 §5.2: 字符串字面量解码
    public static string DecodeString(byte[] buf, List<int> pos) {
        return HpackContext.ReadString(buf, pos, buf == null ? 0 : buf.Length, 65536);
    }

    private static string ReadStringRef(byte[] buf, ref int p, int end, int budget) {
        if (buf == null || p < 0 || p >= end) { throw new IOException("Truncated HPACK string"); }
        bool huffman = (buf[p] & 128) != 0;
        int count = HpackContext.ReadIntRef(buf, ref p, 7, end);
        if (count > end - p || count > budget || budget < 0) { throw new IOException("HPACK string limit"); }
        string value = huffman ? HpackHuffman.Decode(buf, p, count) : buf.ToStr(p, count);
        if (value == null || value.Length > budget) { throw new IOException("Invalid HPACK string"); }
        p = p + count;
        return value;
    }

    private static string ReadString(byte[] buf, List<int> pos, int end, int budget) {
        if (pos == null || pos.Count == 0) { throw new IOException("Truncated HPACK string"); }
        int p = pos[0];
        string value = HpackContext.ReadStringRef(buf, ref p, end, budget);
        pos[0] = p;
        return value;
    }
    // A failed block poisons the context; partially updated compression state cannot be reused.
    public List<HpackHeader> DecodeHeaderBlock(byte[] buf, int offset, int length) {
        if (this.decodeFailed) { throw new IOException("Failed HPACK context"); }
        try { return this.DecodeBlock(buf, offset, length); }
        catch (Exception ex) {
            this.decodeFailed = true;
            throw new IOException("Invalid HPACK block: " + ex.Message);
        }
    }
    private List<HpackHeader> DecodeBlock(byte[] buf, int offset, int length) {
        if (buf == null || offset < 0 || length < 0 || offset > buf.Length || length > buf.Length - offset || length > this.maxHeaderBytes) { throw new IOException("HPACK block limit"); }
        List<HpackHeader> headers = new List<HpackHeader>();
        int pos = offset;
        int end = offset + length;
        int bytes = 0;
        bool fields = false;
        while (pos < end) {
            int first = buf[pos] & 255;
            if ((first & 224) == 32) {
                int size = HpackContext.ReadIntRef(buf, ref pos, 5, end);
                if (fields || size > this.allowedTableSize) { throw new IOException("Invalid HPACK table update"); }
                this.maxTableSize = size;
                this.EvictToMax(size);
                continue;
            }
            if (headers.Count >= this.maxHeaderCount) { throw new IOException("HPACK field count limit"); }
            fields = true;
            string name = "";
            string value = "";
            bool indexed = (first & 128) != 0;
            bool insert = (first & 192) == 64;
            int index = HpackContext.ReadIntRef(buf, ref pos, indexed ? 7 : (insert ? 6 : 4), end);
            if (index > 0) {
                HpackHeader entry = this.GetHeader(index);
                if (entry == null) { throw new IOException("Invalid HPACK index"); }
                name = entry.name;
                if (indexed) { value = entry.value; }
            } else {
                if (indexed) { throw new IOException("Zero HPACK index"); }
                name = HpackContext.ReadStringRef(buf, ref pos, end, this.maxHeaderBytes - bytes);
            }
            if (!indexed) { value = HpackContext.ReadStringRef(buf, ref pos, end, this.maxHeaderBytes - bytes - name.Length); }
            if (name.Length == 0 || name.Length + value.Length + 32 > this.maxHeaderBytes - bytes) { throw new IOException("HPACK header list limit"); }
            bytes = bytes + name.Length + value.Length + 32;
            if (insert) { this.AddHeader(name, value); }
            headers.Add(new HpackHeader(name, value));
        }
        return headers;
    }

    // 编码一组头部字段为 HPACK 字节流（零 List<int> 装箱，直接写入连续 byte[]）。
    public byte[] EncodeHeaders(List<HpackHeader> headers, bool useHuffman) {
        if (headers == null || headers.Count == 0) { return new byte[0]; }
        int hCount = headers.Count;
        byte[] outBuf = new byte[hCount * 32 + 64];
        int pos = 0;

        for (int i = 0; i < hCount; i = i + 1) {
            HpackHeader h = headers[i];
            int nameIdx = 0;
            int exactIdx = this.FindFast(h.name, h.value, out nameIdx);
            if (exactIdx > 0) {
                // 完全命中：以 Indexed Header Field (1xxxxxxx, prefix 7) 编码
                outBuf = HpackContext.WriteIntBuf(outBuf, ref pos, 128, 7, exactIdx);
            } else if (nameIdx > 0) {
                // 名称命中：以 Literal Header Field with Incremental Indexing (01xxxxxx, prefix 6) 编码
                outBuf = HpackContext.WriteIntBuf(outBuf, ref pos, 64, 6, nameIdx);
                outBuf = HpackContext.WriteStringBuf(outBuf, ref pos, h.value, useHuffman);
                this.AddHeader(h.name, h.value);
            } else {
                // 全新头部：Literal with Incremental Indexing (01000000, index 0)
                outBuf = HpackContext.WriteIntBuf(outBuf, ref pos, 64, 6, 0);
                outBuf = HpackContext.WriteStringBuf(outBuf, ref pos, h.name, useHuffman);
                outBuf = HpackContext.WriteStringBuf(outBuf, ref pos, h.value, useHuffman);
                this.AddHeader(h.name, h.value);
            }
        }

        if (pos == outBuf.Length) { return outBuf; }
        byte[] res = new byte[pos];
        if (pos > 0) { NativeMemory.Copy((nint)res, (nint)outBuf, pos); }
        return res;
    }
}
