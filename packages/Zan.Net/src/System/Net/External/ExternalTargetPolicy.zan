using System;

namespace System.Net.External;

/// <summary>外部 HTTP(S) 目标的默认安全策略。解析目标与执行连接分离：
/// 域名目标还必须在传输层解析全部 A/AAAA 并逐一复核，不能仅凭这里的
/// hostname 字符串放行。</summary>
class ExternalTargetPolicy {
    /// <summary>默认远程策略：只允许 HTTPS，并拒绝已知危险的字面量地址。
    /// 域名的 DNS 地址审核由传输层继续完成。</summary>
    static bool IsAllowed(string url) {
        return ExternalTargetPolicy.IsAllowedTarget(
            ExternalTarget.Parse(url), false, false);
    }

    /// <summary>本地开发策略：只额外放行 loopback，并仍要求调用方显式
    /// 使用此入口；不会因为 hostname 包含 localhost 就自动放行。</summary>
    static bool IsLocalAllowed(string url) {
        ExternalTarget t = ExternalTarget.Parse(url);
        return ExternalTargetPolicy.IsLocalTarget(t, true);
    }

    /// IsAllowed 的目标级判定：必须是 loopback 字面量目标；
    /// allowHttp 为 false 时还要求 TLS。
    static bool IsLocalTarget(ExternalTarget t, bool allowHttp) {
        if (t == null || !t.IsLoopback()) { return false; }
        if (!allowHttp && !t.IsTls()) { return false; }
        return t.IsLiteral();
    }

    /// <summary>按规范化目标做精确 provider allowlist 匹配。传入的
    /// expected 必须是固定 canonical URL，而不是用户可配置的后缀。</summary>
    static bool AllowExact(string url, string expected) {
        ExternalTarget t = ExternalTarget.Parse(url);
        if (t == null || !ExternalTargetPolicy.IsAllowedTarget(t, false, false)) {
            return false;
        }
        if (expected == null) { return false; }
        return t.Canonical() == expected;
    }

    /// <summary>本地 endpoint 的精确匹配。loopback 放行只在此类显式
    /// helper 中发生，不会改变默认远程策略。</summary>
    static bool AllowExactLocal(string url, string expected) {
        ExternalTarget t = ExternalTarget.Parse(url);
        if (t == null || !ExternalTargetPolicy.IsLocalTarget(t, true)) {
            return false;
        }
        if (expected == null) { return false; }
        return t.Canonical() == expected;
    }

    /// <summary>为显式 host/port allowlist 提供边界安全的比较；不会把
    /// evil.example.com 当成 example.com 的匹配项。</summary>
    static bool AllowHostPort(string url, string host, int port, bool tls) {
        ExternalTarget t = ExternalTarget.Parse(url);
        if (t == null || !ExternalTargetPolicy.IsAllowedTarget(t, false, false)) {
            return false;
        }
        if (host == null || host.Length == 0) { return false; }
        if (t.Host() != host.ToLower()) { return false; }
        return t.Port() == port && t.IsTls() == tls;
    }

    /// <summary>目标已解析后应用策略。allowLoopback 和 allowHttp 都必须
    /// 由受信调用方显式传入；生产默认值均为 false。</summary>
    static bool IsAllowedTarget(ExternalTarget t, bool allowLoopback,
                                bool allowHttp) {
        if (t == null) { return false; }
        if (!allowHttp && !t.IsTls()) { return false; }
        if (t.IsLiteral() && !t.IsSafeLiteral()) {
            // 明文本地开发例外必须是明确的 loopback literal；不能用
            // allowHttp 把任意公网 HTTP 目标一并放行。
            return allowLoopback && t.IsLoopback()
                && (t.IsTls() || allowHttp);
        }
        if (t.IsLoopback()) {
            return allowLoopback && (t.IsTls() || allowHttp);
        }
        if (!t.IsTls() && allowLoopback) { return false; }
        return true;
    }

    /// <summary>对已知 IPv4 字面量做 SSRF 分类。仅返回“可作为公网候选”
    /// 的结果；域名仍必须经过 DNS 全地址检查。</summary>
    static bool IsPublicIPv4(string host) {
        ExternalTarget t = ExternalTarget.Parse("https://" + host + "/");
        return t != null && t.IsLiteral() && t.IsSafeLiteral();
    }

    /// <summary>把已拆出的 host/port 重新组成一个严格目标并执行策略。
    /// 这是 HttpClient 的连接前门：调用方不能只验证 hostname 字符串后再
    /// 绕过 URL 策略。IPv6 host 由此处补上 authority 所需的方括号。</summary>
    static bool IsClientAllowed(string host, int port, bool tls,
                                bool allowLoopback, bool allowHttp,
                                bool localHttpOnly) {
        if (host == null || host.Length == 0 || port < 1 || port > 65535) {
            return false;
        }
        string authority = host;
        if (host.IndexOf(":") >= 0 && !host.StartsWith("[")) {
            authority = "[" + host + "]";
        }
        string scheme = tls ? "https" : "http";
        string url = scheme + "://" + authority + ":"
            + Convert.ToString(port) + "/";
        ExternalTarget t = ExternalTarget.Parse(url);
        if (t == null) { return false; }
        if (localHttpOnly && (!t.IsTls())
            && (!t.IsLiteral() || !t.IsLoopback())) { return false; }
        return ExternalTargetPolicy.IsAllowedTarget(t, allowLoopback, allowHttp);
    }

    /// <summary>loopback 只接受明确的 IPv4 127/8 或 ::1 字面量。</summary>
    static bool IsLoopback(string host) {
        ExternalTarget t = ExternalTarget.Parse("http://" + host + "/");
        return t != null && t.IsLoopback();
    }
}
