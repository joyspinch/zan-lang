using System;

namespace System.Net.External;

/// <summary>一次外部调用的有限预算。该类只保存策略，不启动线程、不执行
/// 网络请求；传输层应在每个阶段检查 total/idle deadline 与字节预算。</summary>
class ExternalCallPolicy {
    int connectTimeoutMs;
    int writeTimeoutMs;
    int readTimeoutMs;
    int idleTimeoutMs;
    int totalTimeoutMs;
    int maxRequestBytes;
    int maxResponseBytes;
    int maxErrorBytes;
    int maxStreamBytes;
    int maxRedirects;
    int retryAttempts;
    int retryBackoffMs;
    bool allowHttp;
    bool allowLoopback;
    bool localHttpOnly;
    bool retryNetworkErrors;
    bool idempotent;
    string idempotencyKey;

    ExternalCallPolicy() {
        this.connectTimeoutMs = 10000;
        this.writeTimeoutMs = 10000;
        this.readTimeoutMs = 30000;
        this.idleTimeoutMs = 30000;
        this.totalTimeoutMs = 60000;
        this.maxRequestBytes = 8 * 1024 * 1024;
        this.maxResponseBytes = 16 * 1024 * 1024;
        this.maxErrorBytes = 64 * 1024;
        this.maxStreamBytes = 32 * 1024 * 1024;
        this.maxRedirects = 0;
        this.retryAttempts = 0;
        this.retryBackoffMs = 250;
        this.allowHttp = false;
        this.allowLoopback = false;
        this.localHttpOnly = false;
        this.retryNetworkErrors = false;
        this.idempotent = false;
        this.idempotencyKey = "";
    }

    /// <summary>安全的远程请求默认值：HTTPS、无 loopback、无重定向、无
    /// 自动重试，适合 POST/副作用调用。</summary>
    static ExternalCallPolicy Default() { return new ExternalCallPolicy(); }

    /// <summary>建立 TCP 连接的超时（毫秒）。非法值（≤0）被忽略。</summary>
    ExternalCallPolicy ConnectTimeout(int ms) {
        if (ms > 0) { this.connectTimeoutMs = ms; }
        return this;
    }
    /// <summary>发送请求正文的写超时（毫秒）。非法值被忽略。</summary>
    ExternalCallPolicy WriteTimeout(int ms) {
        if (ms > 0) { this.writeTimeoutMs = ms; }
        return this;
    }
    /// <summary>单次阻塞读的超时（毫秒）。非法值被忽略。</summary>
    ExternalCallPolicy ReadTimeout(int ms) {
        if (ms > 0) { this.readTimeoutMs = ms; }
        return this;
    }
    /// <summary>两次有数据到达之间的最大间隔（毫秒）；超时判定连接停滞。
    /// 非法值被忽略。</summary>
    ExternalCallPolicy IdleTimeout(int ms) {
        if (ms > 0) { this.idleTimeoutMs = ms; }
        return this;
    }
    /// <summary>整次调用（含重试与重定向）的总预算（毫秒）。非法值被忽略。</summary>
    ExternalCallPolicy TotalTimeout(int ms) {
        if (ms > 0) { this.totalTimeoutMs = ms; }
        return this;
    }
    /// <summary>请求正文最大字节数。非法值被忽略。</summary>
    ExternalCallPolicy RequestLimit(int bytes) {
        if (bytes > 0) { this.maxRequestBytes = bytes; }
        return this;
    }
    /// <summary>缓冲式响应正文最大字节数。非法值被忽略。</summary>
    ExternalCallPolicy ResponseLimit(int bytes) {
        if (bytes > 0) { this.maxResponseBytes = bytes; }
        return this;
    }
    /// <summary>错误响应体最大读取字节数。非法值被忽略。</summary>
    ExternalCallPolicy ErrorLimit(int bytes) {
        if (bytes > 0) { this.maxErrorBytes = bytes; }
        return this;
    }
    /// <summary>流式读取（下载）最大字节数。非法值被忽略。</summary>
    ExternalCallPolicy StreamLimit(int bytes) {
        if (bytes > 0) { this.maxStreamBytes = bytes; }
        return this;
    }
    /// <summary>允许的最大重定向次数，范围 0-10；范围外被忽略。
    /// 默认 0 表示不跟随重定向。</summary>
    ExternalCallPolicy Redirects(int count) {
        if (count >= 0 && count <= 10) { this.maxRedirects = count; }
        return this;
    }
    /// <summary>是否允许网络错误重试。仅是开关；实际能否重试还须通过
    /// CanRetry 的幂等门禁。</summary>
    ExternalCallPolicy RetryNetwork(bool enabled) {
        this.retryNetworkErrors = enabled;
        return this;
    }
    /// <summary>最大重试次数，范围 0-3；范围外被忽略。</summary>
    ExternalCallPolicy RetryAttempts(int count) {
        if (count >= 0 && count <= 3) { this.retryAttempts = count; }
        return this;
    }
    /// <summary>重试前的退避间隔（毫秒），范围 0-30000；范围外被忽略。</summary>
    ExternalCallPolicy RetryBackoff(int ms) {
        if (ms >= 0 && ms <= 30000) { this.retryBackoffMs = ms; }
        return this;
    }
    /// <summary>同时放行明文 HTTP 与 loopback，且限定只能访问本地 HTTP
    /// （远程目标仍须 HTTPS）。三个标志联动设置，用于本地开发/自托管
    /// 服务场景；默认策略下不可用。</summary>
    ExternalCallPolicy AllowLocalHttp() {
        this.allowHttp = true;
        this.allowLoopback = true;
        this.localHttpOnly = true;
        return this;
    }
    /// <summary>额外放行 loopback 目标（127/8、::1）。不改变 HTTP 明文
    /// 限制——loopback 上发 HTTPS 仍按目标 scheme 校验。</summary>
    ExternalCallPolicy AllowLoopback() {
        this.allowLoopback = true;
        return this;
    }
    /// <summary>声明该调用幂等并携带幂等键（如 Idempotency-Key 头）。
    /// 这是非 GET/HEAD 请求获得重试资格的唯一途径。key 传 null 视为
    /// 空串（有幂等标志但无键，CanRetry 仍拒绝）。</summary>
    ExternalCallPolicy Idempotent(string key) {
        this.idempotent = true;
        this.idempotencyKey = key == null ? "" : key;
        return this;
    }

    /// 已配置的连接超时（毫秒）。
    int ConnectTimeoutMs() { return this.connectTimeoutMs; }
    /// 已配置的写超时（毫秒）。
    int WriteTimeoutMs() { return this.writeTimeoutMs; }
    /// 已配置的单次读超时（毫秒）。
    int ReadTimeoutMs() { return this.readTimeoutMs; }
    /// 已配置的空闲超时（毫秒）。
    int IdleTimeoutMs() { return this.idleTimeoutMs; }
    /// 已配置的总预算（毫秒）。
    int TotalTimeoutMs() { return this.totalTimeoutMs; }
    /// 已配置的请求正文上限（字节）。
    int MaxRequestBytes() { return this.maxRequestBytes; }
    /// 已配置的缓冲式响应上限（字节）。
    int MaxResponseBytes() { return this.maxResponseBytes; }
    /// 已配置的错误正文上限（字节）。
    int MaxErrorBytes() { return this.maxErrorBytes; }
    /// 已配置的流式读取上限（字节）。
    int MaxStreamBytes() { return this.maxStreamBytes; }

    /// <summary>一次性正文（下载/图片）可使用的统一上限：取响应和
    /// 流预算中已配置的较小值；两者都未配置时返回 0。</summary>
    int MaxBodyBytes() {
        int a = this.maxResponseBytes;
        int b = this.maxStreamBytes;
        if (a > 0 && b > 0) { return a < b ? a : b; }
        if (a > 0) { return a; }
        return b > 0 ? b : 0;
    }

    /// 已配置的最大重定向次数。
    int MaxRedirects() { return this.maxRedirects; }
    /// 已配置的最大重试次数。
    int RetryAttempts() { return this.retryAttempts; }
    /// 已配置的重试退避（毫秒）。
    int RetryBackoffMs() { return this.retryBackoffMs; }
    /// 是否放行明文 HTTP。
    bool AllowsHttp() { return this.allowHttp; }
    /// 是否放行 loopback 目标。
    bool AllowsLoopback() { return this.allowLoopback; }
    /// 是否限定只能访问本地 HTTP（远程仍须 HTTPS）。
    bool LocalHttpOnly() { return this.localHttpOnly; }
    /// 是否声明了幂等。
    bool IsIdempotent() { return this.idempotent; }
    /// 已配置的幂等键（可能为空串）。
    string IdempotencyKey() { return this.idempotencyKey; }

    /// <summary>只有明确声明幂等，且请求尚未产生副作用时，网络错误才可
    /// 重试。POST 没有幂等键时永远返回 false。</summary>
    /// <summary>重试判定门禁。requestStarted=true（请求已被对端接收，
    /// 可能已产生副作用）一律不可重试。GET/HEAD 在连接失败（0）或
    /// 5xx 时可重试；其余方法须已声明幂等且幂等键非空，且状态码为
    /// 0/408/429/5xx 之一。statusCode 为 0 表示网络层失败、无响应。</summary>
    bool CanRetry(string method, bool requestStarted, int statusCode) {
        if (requestStarted || !this.retryNetworkErrors || this.retryAttempts <= 0) {
            return false;
        }
        if (method == null) { return false; }
        string m = method.ToUpper();
        if (m == "GET" || m == "HEAD") { return statusCode == 0 || statusCode >= 500; }
        return this.idempotent && this.idempotencyKey.Length > 0
            && (statusCode == 0 || statusCode == 408 || statusCode == 429
                || statusCode >= 500);
    }
}
