using System;
using System.Net.Sockets;
using System.Net.Http;
using System.Net.Tls;

namespace System.Net.Https;

// 基于协程的 HTTPS（HTTP/1.1 over TLS）服务器。编程模型与
// <see cref="HttpServer"/> 相同，每个连接通过
// <see cref="TlsStream"/> 进行 TLS 加密。
// 用法：
// server.OnRequest(HandleRequest);
public class HttpsServer : IDisposable {
    public TcpListener listener;
    public TlsContext tls;
    public string host;
    public int port;
    public bool running;
    public int activeConnections;
    public int maxConnections;
    public int maxRequestBytes;
    public int maxHeaderBytes;
    public int requestTimeoutMs;
    public HttpRequestHandler requestHandler;

    public HttpsServer(string host, int port) {
        this.host = host;
        this.port = port;
        this.running = false;
        this.activeConnections = 0;
        this.maxConnections = 10000;
        this.maxRequestBytes = 1048576;
        this.maxHeaderBytes = 16384;
        this.requestTimeoutMs = 30000;
        this.requestHandler = null;
        this.tls = null;
    }

    // 从 PEM 证书链与 PEM 私钥创建 HTTPS 服务器；
    // 证书/私钥无法加载时返回 null。
    public static HttpsServer Create(string host, int port, string certFile, string keyFile) {
        HttpsServer server = new HttpsServer(host, port);
        server.tls = TlsContext.CreateServer(certFile, keyFile);
        if (server.tls == null) {
            return null;
        }
        // The listener dispatches both versions; negotiate h2 before accepting its preface.
        if (server.tls.alpnProtocols.Count == 0) {
            server.tls.alpnProtocols.Add("h2");
            server.tls.alpnProtocols.Add("http/1.1");
        }
        return server;
    }

    // 设置单个请求的最大可接受大小（字节），
    // （请求头 + 请求体）。
    public HttpsServer SetMaxRequestBytes(int bytes) {
        this.maxRequestBytes = bytes;
        return this;
    }

    // 设置请求头块的最大字节数，超过则返回 431。
    public HttpsServer SetMaxHeaderBytes(int bytes) {
        this.maxHeaderBytes = bytes;
        return this;
    }

    // 设置读取请求头和请求体的截止时间（毫秒）。
    // 0 表示禁用。默认 30 秒。
    public HttpsServer SetTimeout(int ms) {
        this.requestTimeoutMs = ms;
        return this;
    }

    // 注册每个传入请求都会调用的处理器。
    public HttpsServer OnRequest(HttpRequestHandler handler) {
        this.requestHandler = handler;
        return this;
    }

    // 启动 HTTPS 服务器事件循环。持续运行，在协程上
    // 接受并处理连接。
    public async void Start() {
        Socket.Initialize();
        this.listener = new TcpListener(this.host, this.port);
        this.listener.Start();
        this.running = true;

        while (this.running) {
            nint clientSock = await this.listener.AcceptAsync();
            if (clientSock >= 0) {
                if (this.activeConnections >= this.maxConnections) {
                    // 与 HttpServer 同闸：TLS 连接各持 SSL/BIO 与缓冲，
                    // 超限连接直接挂断，不为它做握手/堆协程。
                    Socket.Close(clientSock);
                    continue;
                }
                this.activeConnections = this.activeConnections + 1;
                Task.Spawn(HandleConnection(clientSock));
            }
        }
    }

    // 设置最大并发连接数；超过上限的连接立即关闭（回 503 之前
    // 不做 TLS 握手——每个 TLS 连接都持有 SSL/BIO 与缓冲，必须像
    // HttpServer 一样设闸）。
    public HttpsServer SetMaxConnections(int max) {
        this.maxConnections = max;
        return this;
    }

    // 停止接受新连接：关闭监听套接字让挂起在
    // AcceptAsync 上的协程立即返回（只置 running 标志要等到
    // 下一条连接到达才会生效）。已建立的连接自然收尾。
    public void Stop() {
        this.running = false;
        if (this.listener != null) {
            this.listener.Stop();
        }
    }

    public void Dispose() {
        this.Stop();
    }

    private async void HandleConnection(nint clientSock) {
        try {
            Socket.SetNonBlocking(clientSock);
            TlsStream stream;
            if (this.requestTimeoutMs > 0) {
                stream = await TlsStream.AcceptAsync(this.tls, clientSock, this.requestTimeoutMs);
            } else {
                stream = await TlsStream.AcceptAsync(this.tls, clientSock);
            }
            if (stream == null) { return; }

            HttpDeadlineToken watch = HttpDeadline.Arm(clientSock, this.requestTimeoutMs);
            HttpFramer framer = HttpFramerTls.Create(stream);
            try {
                Http1Writer writer = HttpFramerTls.CreateWriter(stream);
                await HttpServer.ServeHttp1Session(this.requestHandler, framer, writer,
                    this.maxHeaderBytes, this.maxRequestBytes, this.requestTimeoutMs, watch,
                    "<h1>Zan HTTPS Server</h1><p>Override ProcessRequest to handle routes.</p>");
            } finally {
                HttpDeadline.Disarm(watch);
                framer.Dispose();
                stream.Close();
            }
        } finally {
            Socket.Close(clientSock);
            this.activeConnections = this.activeConnections - 1;
        }
    }
}
