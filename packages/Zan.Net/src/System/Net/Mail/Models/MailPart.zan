using System;
using System.Text;
using System.Net.Sockets;
using System.Net.Tls;
using System.Security.Cryptography;

namespace System.Net.Mail;

// 邮件正文的一个部分（MIME part）：纯文本或 HTML，
// 或者一个附件（attachment，带文件名）。
public class MailPart {
    // 0 纯文本，1 HTML，2 附件。
    public int kind;
    public string content;
    public string fileName;

    public MailPart() {
        this.kind = 0;
        this.content = "";
        this.fileName = "";
    }

    // 纯文本正文部分。
    public static MailPart Text(string content) {
        MailPart p = new MailPart();
        p.kind = 0;
        p.content = content;
        return p;
    }

    // HTML 正文部分。
    public static MailPart Html(string content) {
        MailPart p = new MailPart();
        p.kind = 1;
        p.content = content;
        return p;
    }

    // 附件部分：content 为文件字节，fileName 是收件方看到的文件名。
    public static MailPart Attachment(byte[] content, string fileName) {
        MailPart p = new MailPart();
        p.kind = 2;
        p.content = Base64.Encode(content);
        p.fileName = fileName;
        return p;
    }
}
