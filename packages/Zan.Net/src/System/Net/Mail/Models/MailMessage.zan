using System;

namespace System.Net.Mail;

// 一封待发送的邮件：信封（发件人/收件人/主题）与正文部分列表。
public class MailMessage {
    public string from;
    public List<string> to;
    public List<string> cc;
    public List<string> bcc;
    public string subject;
    public List<MailPart> parts;
    // 附加头（例如 "Reply-To: x@y"），逐行原样输出。
    public List<string> extraHeaders;

    public MailMessage() {
        this.from = "";
        this.to = new List<string>();
        this.cc = new List<string>();
        this.bcc = new List<string>();
        this.subject = "";
        this.parts = new List<MailPart>();
        this.extraHeaders = new List<string>();
    }

    // 设置发件人地址。
    public MailMessage From(string addr) {
        this.from = addr;
        return this;
    }

    // 添加收件人。
    public MailMessage To(string addr) {
        this.to.Add(addr);
        return this;
    }

    // 添加抄送。
    public MailMessage Cc(string addr) {
        this.cc.Add(addr);
        return this;
    }

    // 添加密送（只进信封 RCPT，不进正文头）。
    public MailMessage Bcc(string addr) {
        this.bcc.Add(addr);
        return this;
    }

    // 设置主题。
    public MailMessage Subject(string subject) {
        this.subject = subject;
        return this;
    }

    // 追加正文部分（纯文本 / HTML / 附件，见 MailPart）。
    public MailMessage AddPart(MailPart part) {
        this.parts.Add(part);
        return this;
    }

    // 便捷方法：追加纯文本正文。
    public MailMessage Body(string text) {
        return this.AddPart(MailPart.Text(text));
    }

    // 便捷方法：追加 HTML 正文。
    public MailMessage HtmlBody(string html) {
        return this.AddPart(MailPart.Html(html));
    }

    // 便捷方法：追加附件。
    public MailMessage Attach(byte[] data, string fileName) {
        return this.AddPart(MailPart.Attachment(data, fileName));
    }

    // 追加一个附加头（完整一行，不含 CRLF）。
    public MailMessage Header(string line) {
        this.extraHeaders.Add(line);
        return this;
    }
}
