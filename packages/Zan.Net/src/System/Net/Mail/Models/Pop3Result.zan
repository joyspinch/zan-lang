using System;

namespace System.Net.Mail;

// POP3 会话操作结果（RFC 1939）。
public class Pop3Result {
    public bool ok;
    public string message;
    public string stage;
    public int count;
    public int totalBytes;

    public Pop3Result() {
        this.ok = false;
        this.message = "";
        this.stage = "";
        this.count = 0;
        this.totalBytes = 0;
    }

    public static Pop3Result Ok(string msg) {
        Pop3Result r = new Pop3Result();
        r.ok = true;
        r.message = msg;
        return r;
    }

    public static Pop3Result Fail(string stage, string msg) {
        Pop3Result r = new Pop3Result();
        r.ok = false;
        r.stage = stage;
        r.message = msg;
        return r;
    }
}
