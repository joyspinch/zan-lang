using System;
using System.Text;

namespace System.Net.Mail;

// SMTP 会话的结果：成功与否、每一步响应与诊断信息。
public class SmtpResult {
    public bool ok;
    // 会话终止时的最后一条 SMTP 响应（多行合并为 \n 分隔）。
    public string lastResponse;
    public int lastCode;
    // 出错阶段的人话描述（连接/握手/认证/信封/正文/退出）。
    public string stage;

    public SmtpResult() {
        this.ok = false;
        this.lastResponse = "";
        this.lastCode = 0;
        this.stage = "";
    }

    public static SmtpResult Fail(string stage, int code, string resp) {
        SmtpResult r = new SmtpResult();
        r.ok = false;
        r.stage = stage;
        r.lastCode = code;
        r.lastResponse = resp;
        return r;
    }
}
