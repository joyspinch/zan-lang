using System;

namespace System.Net.Tls;

class TlsByteReader {
    byte[] data;
    int pos;
    int limit;

    TlsByteReader(byte[] data, int offset, int length) {
        this.data = data;
        this.pos = offset;
        this.limit = offset + length;
        if (this.limit > data.Length) { this.limit = data.Length; }
    }

    int Remaining() { return this.limit - this.pos; }
    int Offset() { return this.pos; }
    bool Has(int count) { return this.pos + count <= this.limit; }

    int ReadU8() {
        if (!this.Has(1)) { return -1; }
        int v = this.data[this.pos] & 255;
        this.pos = this.pos + 1;
        return v;
    }

    int ReadU16() {
        if (!this.Has(2)) { return -1; }
        int v = ((this.data[this.pos] & 255) << 8) | (this.data[this.pos + 1] & 255);
        this.pos = this.pos + 2;
        return v;
    }

    int ReadU24() {
        if (!this.Has(3)) { return -1; }
        int v = ((this.data[this.pos] & 255) << 16) | ((this.data[this.pos + 1] & 255) << 8) | (this.data[this.pos + 2] & 255);
        this.pos = this.pos + 3;
        return v;
    }

    byte[] ReadBytes(int count) {
        if (count < 0 || !this.Has(count)) { return null; }
        byte[] b = new byte[count];
        for (int i = 0; i < count; i = i + 1) {
            b[i] = (byte)(this.data[this.pos + i] & 255);
        }
        this.pos = this.pos + count;
        return b;
    }

    void Skip(int count) {
        this.pos = this.pos + count;
        if (this.pos > this.limit) { this.pos = this.limit; }
    }
}

// 动态字节数组构建器。
// 动态字节数组构建器（带双指针滑动窗口，消除高频前缀消费带来的 O(N) 内存拷贝开销）。
