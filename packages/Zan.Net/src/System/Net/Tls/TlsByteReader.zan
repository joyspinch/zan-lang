using System;

namespace System.Net.Tls;

public class TlsByteReader {
    public byte[] data;
    public int pos;
    public int limit;

    public TlsByteReader(byte[] data, int offset, int length) {
        this.data = data;
        if (data == null) {
            this.pos = 0;
            this.limit = 0;
            return;
        }
        int dlen = data.Length;
        int off = offset;
        if (off < 0) { off = 0; }
        if (off > dlen) { off = dlen; }
        this.pos = off;

        int len = length;
        if (len < 0) { len = 0; }
        int maxAvail = dlen - off;
        if (len > maxAvail) { len = maxAvail; }
        this.limit = off + len;
    }

    public int Remaining() {
        int rem = this.limit - this.pos;
        return rem > 0 ? rem : 0;
    }
    public int Offset() { return this.pos; }
    public bool Has(int count) {
        if (count < 0) { return false; }
        return count <= this.limit - this.pos;
    }

    public int ReadU8() {
        if (!this.Has(1)) { return -1; }
        int v = this.data[this.pos] & 255;
        this.pos = this.pos + 1;
        return v;
    }

    public int ReadU16() {
        if (!this.Has(2)) { return -1; }
        int v = ((this.data[this.pos] & 255) << 8) | (this.data[this.pos + 1] & 255);
        this.pos = this.pos + 2;
        return v;
    }

    public int ReadU24() {
        if (!this.Has(3)) { return -1; }
        int v = ((this.data[this.pos] & 255) << 16) | ((this.data[this.pos + 1] & 255) << 8) | (this.data[this.pos + 2] & 255);
        this.pos = this.pos + 3;
        return v;
    }

    public byte[] ReadBytes(int count) {
        if (count < 0 || !this.Has(count)) { return null; }
        byte[] b = new byte[count];
        for (int i = 0; i < count; i = i + 1) {
            b[i] = (byte)(this.data[this.pos + i] & 255);
        }
        this.pos = this.pos + count;
        return b;
    }

    public void Skip(int count) {
        if (count <= 0) { return; }
        int rem = this.limit - this.pos;
        if (count >= rem) {
            this.pos = this.limit;
        } else {
            this.pos = this.pos + count;
        }
    }
}
