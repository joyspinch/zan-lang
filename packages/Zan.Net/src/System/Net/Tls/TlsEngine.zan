using System;
using System.IO;
using System.Security.Cryptography;

namespace System.Net.Tls;

// 字节数组大端序安全读取器。
public partial class TlsEngine {
    #if WINDOWS
    [DllImport("crt", EntryPoint = "zan_io_crypto_windows_ssl_policy")]
    private static extern int WindowsSslPolicy(nint certs, int totalLen, int count, nint host, int hostLen);
    #endif

    // 状态常量
    public static int StateInitial = 0;
    public static int StateClientHelloSent = 1;
    public static int StateTls13Handshake = 2;
    public static int StateTls12Handshake = 3;
    public static int StateTls12WaitingFinished = 4;
    public static int StateServerWaitingClientHello = 5;
    public static int StateServerTls13WaitingFinished = 6;
    public static int StateServerTls12WaitingClientKeyExchange = 7;
    public static int StateServerTls12WaitingFinished = 8;
    public static int StateConnected = 9;
    public static int StateClosed = 10;
    public static int StateFailed = 11;
    public static int MaxPreAuthHandshakeBytes = 262144;

    public string host;
    public bool disableVerify;
    public bool disableTls13;
    public List<string> pins;
    public bool pinRequired;
    public CertPolicyFn certPolicy;
    public List<X509Certificate> trustedCerts;

    public bool isServer;
    public string certFile;
    public string keyFile;
    public X509Certificate cachedCert;
    public List<X509Certificate> certChain;
    public RsaKey cachedKey;
    public EcKey cachedEcKey;
    public bool clientAdvertised0805;
    public bool clientAdvertised0403;
    public static int MaxServerChainCerts = 8;
    public static int MaxServerChainDerBytes = 131072;

    public int state;
    public string lastError;
    public long verifyResult;
    public string peerCertText;
    // Windows 桥接诊断码（非 Windows 恒 0）：1=系统信任，0=输入/环境拒绝，
    // 负值=具体失败分类（见 zan_io_crypto_windows_ssl_policy 契约）
    public int osTrustDiag;
    public X509Certificate peerCert;
    public List<X509Certificate> peerChain;
    public bool peerAuthenticated;
    public bool handshakeSignatureVerified;
    public bool receivedEncryptedExtensions;
    public int preAuthHandshakeBytes;
    public bool requireOcspStapling;
    public OcspResponse stapledOcsp;
    public bool clientOfferedStatusRequest;
    public byte[] serverOcspResponse;
    public List<string> clientAlpnList;
    public List<string> serverAlpnList;
    public string negotiatedAlpn;

    public int negotiatedVersion;
    public int negotiatedCipherSuite;
    public byte[] clientRandom;
    public byte[] serverRandom;
    public byte[] sessionId;
    public byte[] clientX25519Priv;
    public byte[] clientX25519Pub;
    public byte[] serverX25519Pub;

    // TLS 1.3 临时密钥材料
    public byte[] handshakeSecret;
    public byte[] clientHsTraffic;
    public byte[] serverHsTraffic;
    public byte[] clientAppTrafficSecret;
    public byte[] clientAppKeyPending;
    public byte[] clientAppIvPending;

    // TLS 1.2 密钥材料
    public byte[] tls12MasterSecret;
    public byte[] transcriptHashBeforeFinished;
    public byte[] tls12ClientWriteKey;
    public byte[] tls12ClientWriteIv;
    public byte[] tls12ServerWriteKey;
    public byte[] tls12ServerWriteIv;

    public TlsTranscript transcript;
    public TlsCipherState readCipher;
    public TlsCipherState writeCipher;

    // 网络与应用缓冲区
    public TlsByteWriter inNet;  // 接收到的网络原始密文
    public TlsByteWriter outNet;  // 待发送到网络的密文记录
    public TlsByteWriter appReadBuf;  // 已解密的应用层明文
    public TlsByteWriter handshakeBuf;  // 可跨 TLS record 的握手消息缓冲
    public byte[] recHeader;
    public List<int> recType;

    public TlsEngine(string host, bool disableVerify, bool disableTls13, List<string> pins, bool pinRequired, CertPolicyFn certPolicy, List<X509Certificate> trustedCerts, bool isServer, string certFile, string keyFile) {
        this.host = host;
        this.disableVerify = disableVerify;
        this.disableTls13 = disableTls13;
        this.pins = pins;
        this.pinRequired = pinRequired;
        this.certPolicy = certPolicy;
        this.trustedCerts = trustedCerts;
        this.isServer = isServer;
        this.certFile = certFile;
        this.keyFile = keyFile;
        this.cachedCert = null;
        this.certChain = null;
        this.cachedKey = null;
        this.cachedEcKey = null;
        this.clientAdvertised0805 = false;
        this.clientAdvertised0403 = false;
        this.state = StateInitial;
        this.lastError = "";
        this.verifyResult = 0;
        this.osTrustDiag = 0;
        this.peerCertText = "";
        this.peerCert = null;
        this.peerChain = new List<X509Certificate>();
        this.peerAuthenticated = false;
        this.handshakeSignatureVerified = false;
        this.receivedEncryptedExtensions = false;
        this.preAuthHandshakeBytes = 0;
        this.requireOcspStapling = false;
        this.stapledOcsp = null;
        this.clientOfferedStatusRequest = false;
        this.serverOcspResponse = null;
        this.clientAlpnList = new List<string>();
        this.serverAlpnList = new List<string>();
        this.negotiatedAlpn = "";

        this.negotiatedVersion = 0;
        this.negotiatedCipherSuite = 0;
        this.transcript = new TlsTranscript();
        this.readCipher = null;
        this.writeCipher = null;

        this.inNet = new TlsByteWriter();
        this.outNet = new TlsByteWriter();
        this.appReadBuf = new TlsByteWriter();
        this.handshakeBuf = new TlsByteWriter();
        this.recHeader = new byte[5];
        this.recType = new List<int>();
        this.recType.Add(0);
    }

    public void SetCredentials(X509Certificate cert, RsaKey key, EcKey ecKey) {
        this.cachedCert = cert;
        this.cachedKey = key;
        this.cachedEcKey = ecKey;
    }

    // 服务端证书链：叶子在前、中间证书随后。链中每张 DER 都
    // 有效且总长受限；为空或不合法时保留 SetCredentials 的单证书回退。
    public void SetCertChain(List<X509Certificate> chain) {
        if (chain == null || chain.Count == 0) { return; }
        int total = 0;
        for (int i = 0; i < chain.Count; i = i + 1) {
            X509Certificate cert = chain[i];
            if (cert == null || cert.RawDer() == null) { return; }
            total = total + cert.RawDerLen();
            if (total > MaxServerChainDerBytes) { return; }
        }
        this.certChain = chain;
        this.cachedCert = chain[0];
    }

    // 待发送的服务端证书列表（叶子在前）；无链时退回单证书。
    public List<X509Certificate> SendChain() {
        if (this.certChain != null && this.certChain.Count > 0) { return this.certChain; }
        if (this.cachedCert == null) { return null; }
        List<X509Certificate> single = new List<X509Certificate>();
        single.Add(this.cachedCert);
        return single;
    }

    public int OutNetLength() { return this.outNet.Length(); }
    public byte[] OutNetBuffer() { return this.outNet.Buffer(); }
    public int OutNetHead() { return this.outNet.Head(); }
    public void DropOutNet(int count) { this.outNet.RemovePrefix(count); }

    public bool IsConnected() { return this.state == StateConnected; }
    public bool IsClosed() { return this.state == StateClosed || this.state == StateFailed; }
    public string LastError() { return this.lastError; }
    public long VerifyResult() { return this.verifyResult; }
    // Windows 系统信任桥接的诊断码（1=信任，0=输入/环境拒绝，负值=失败分类）
    public int OsTrustDiag() { return this.osTrustDiag; }
    public string PeerCertificateText() { return this.peerCertText; }
    public X509Certificate PeerCertificate() { return this.peerCert; }
    public int NegotiatedVersion() { return this.negotiatedVersion; }

    public static byte[] RandomBytes(int n) {
        byte[] b = new byte[n];
        if (RandomNumberGenerator.Fill(b, n) != n) { return null; }
        return b;
    }

    public byte[] DeriveX25519Shared(byte[] privateKey, byte[] peerPublic, string error) {
        byte[] shared = Curve25519.ScalarMult(privateKey, peerPublic);
        if (shared == null || shared.Length != 32) {
            this.Fail(error);
            return null;
        }
        int nonzero = 0;
        for (int i = 0; i < 32; i = i + 1) {
            nonzero = nonzero | (shared[i] & 255);
        }
        if (nonzero == 0) {
            this.Fail(error);
            return null;
        }
        return shared;
    }

    public static byte[] GenerateX25519(out byte[] publicKey) {
        publicKey = null;
        byte[] priv = RandomBytes(32);
        if (priv == null) { return null; }
        priv[0] = (byte)(priv[0] & 248);
        priv[31] = (byte)((priv[31] & 127) | 64);
        publicKey = Curve25519.GetPublicKey(priv);
        return publicKey == null ? null : priv;
    }

    public void SetAlpnProtocols(List<string> protos) {
        if (this.isServer) {
            this.serverAlpnList = protos;
        } else {
            this.clientAlpnList = protos;
        }
    }

    public string GetNegotiatedAlpn() {
        return this.negotiatedAlpn;
    }

    public void SelectAlpn() {
        if (this.serverAlpnList == null || this.clientAlpnList == null) { return; }
        for (int i = 0; i < this.serverAlpnList.Count; i = i + 1) {
            string sp = this.serverAlpnList[i];
            for (int j = 0; j < this.clientAlpnList.Count; j = j + 1) {
                if (sp == this.clientAlpnList[j]) {
                    this.negotiatedAlpn = sp;
                    return;
                }
            }
        }
    }

    // 启动 TLS 握手。客户端产出 ClientHello 记录，服务端置待接收状态。
    public void StartHandshake() {
        if (this.state != StateInitial) { return; }

        if (this.isServer) {
            this.state = StateServerWaitingClientHello;
            return;
        }

        this.clientRandom = RandomBytes(32);
        this.sessionId = RandomBytes(32);
        byte[] pubKey = null;
        this.clientX25519Priv = GenerateX25519(out pubKey);
        this.clientX25519Pub = pubKey;
        if (this.clientRandom == null || this.sessionId == null || this.clientX25519Priv == null || pubKey == null) {
            this.Fail("TLS 随机数或 X25519 密钥生成失败"); return;
        }

        byte[] chPayload = this.BuildClientHello();
        if (chPayload == null) {
            this.Fail("构建 ClientHello 失败");
            return;
        }

        this.preAuthHandshakeBytes = chPayload.Length;
        this.transcript.Update(chPayload);

        // 外部记录头采用 TLS 1.0 (0x0301) 保证旧中间盒兼容性 (RFC 8446 D.4)
        byte[] rec = TlsRecord.FormatPlaintext(TlsRecord.ContentTypeHandshake, TlsRecord.VersionTls10, chPayload, 0, chPayload.Length);
        if (rec != null) {
            this.outNet.WriteBytes(rec);
        }

        this.state = StateClientHelloSent;
    }

    // 向引擎灌入网络层读到的原始数据字节。
    public void FeedNetwork(byte[] data, int offset, int len) {
        if (data == null || len <= 0 || offset < 0 || offset > data.Length || len > data.Length - offset) { return; }
        this.inNet.WriteBytes(data, offset, len);
    }

    // 从引擎取出待发送至网络的加密数据字节。
    public byte[] DrainNetwork() {
        if (this.outNet.Length() == 0) { return null; }
        byte[] bytes = this.outNet.ToArray();
        this.outNet.RemovePrefix(bytes.Length);
        return bytes;
    }

    // 驱动握手与记录处理状态机前进。返回 1 表示握手已完成，0 表示需继续从网络读入数据，-1 表示出错。
    public int Step() {
        if (this.state == StateFailed) { return -1; }
        if (this.state == StateInitial) {
            this.StartHandshake();
        }

        while (true) {
            int netLen = this.inNet.Length();
            if (netLen < 5) {
                // 不足一个 TLS 记录头
                return this.state == StateConnected ? 1 : 0;
            }

            int ctype = this.inNet.PeekU8(0);
            int rver = this.inNet.PeekU16(1);
            int rlen = this.inNet.PeekU16(3);

            if (rver < TlsRecord.VersionTls10 || rver > TlsRecord.VersionTls12) {
                this.Fail("不支持的 TLS 记录版本");
                return -1;
            }
            if (ctype != TlsRecord.ContentTypeChangeCipherSpec
                && ctype != TlsRecord.ContentTypeAlert
                && ctype != TlsRecord.ContentTypeHandshake
                && ctype != TlsRecord.ContentTypeApplicationData) {
                this.Fail("不支持的 TLS 记录类型");
                return -1;
            }
            if (rlen < 0 || rlen > 20000) {
                this.Fail("非法 TLS 记录长度: " + rlen);
                return -1;
            }

            if (netLen < 5 + rlen) {
                // 记录尚未接收完整，等待网络灌入更多字节
                return this.state == StateConnected ? 1 : 0;
            }

            // 零额外中转拷贝，直接从 inNet 内部滑动缓冲区切出 header 与 payload
            byte[] inBuf = this.inNet.Buffer();
            int inHead = this.inNet.Head();
            NativeMemory.Copy(this.recHeader, (nint)inBuf + (nint)inHead, 5);

            int pOffset = inHead + 5;
            this.inNet.RemovePrefix(5 + rlen);

            int prevState = this.state;
            int res = this.ProcessRecord(ctype, this.recHeader, inBuf, pOffset, rlen);
            if (res < 0) { return -1; }
            if (prevState != StateConnected && this.state == StateConnected) {
                // 刚完成握手，立即返回 1 提示调用方握手完毕
                return 1;
            }
        }

        return this.state == StateConnected ? 1 : 0;
    }

    int ProcessRecord(int ctype, byte[] header, byte[] inBuf, int pOffset, int pLen) {
        // 1. Alert 处理。RFC 5246 §7.2：Alert 载荷恰好 2 字节；非 2 字节
        // 属畸形报文——静默忽略会让对端用零碎/超长告警探测记录层状态。
        if (ctype == TlsRecord.ContentTypeAlert && this.readCipher == null) {
            if (pLen != 2) {
                this.Fail("TLS 告警长度非法: " + pLen);
                return -1;
            }
            int level = inBuf[pOffset] & 255;
            int desc = inBuf[pOffset + 1] & 255;
            if (desc == TlsRecord.AlertCloseNotify) {
                this.state = StateClosed;
                return 0;
            }
            this.Fail("对端发送 TLS 告警: level=" + level + ", desc=" + desc);
            return -1;
        }

        // 2. ChangeCipherSpec 处理。RFC 5246 §7.1 / RFC 8446 §5.8：载荷
        // 恰 1 字节且值为 1；状态不匹配的 CCS 一律拒绝而不是静默吞掉。
        if (ctype == TlsRecord.ContentTypeChangeCipherSpec) {
            if (pLen != 1 || (inBuf[pOffset] & 255) != 1) {
                this.Fail("ChangeCipherSpec 载荷非法");
                return -1;
            }
            if (this.negotiatedVersion == TlsRecord.VersionTls13 || this.state == StateTls13Handshake || this.state == StateClientHelloSent || this.state == StateServerTls13WaitingFinished) {
                // TLS 1.3 中间盒兼容性虚拟 CCS 包，忽略跳过
                return 0;
            }
            if (!this.isServer && this.state == StateTls12WaitingFinished) {
                if (this.readCipher != null) {
                    this.Fail("重复的 ChangeCipherSpec");
                    return -1;
                }
                if (this.tls12ServerWriteKey == null || this.tls12ServerWriteIv == null) {
                    this.Fail("TLS 1.2 读密钥未就绪即收到 ChangeCipherSpec");
                    return -1;
                }
                this.readCipher = new TlsCipherState(TlsRecord.VersionTls12, this.tls12ServerWriteKey, this.tls12ServerWriteIv);
                return 0;
            }
            if (this.isServer && this.state == StateServerTls12WaitingFinished) {
                if (this.readCipher != null) {
                    this.Fail("重复的 ChangeCipherSpec");
                    return -1;
                }
                if (this.tls12ClientWriteKey == null || this.tls12ClientWriteIv == null) {
                    this.Fail("TLS 1.2 读密钥未就绪即收到 ChangeCipherSpec");
                    return -1;
                }
                this.readCipher = new TlsCipherState(TlsRecord.VersionTls12, this.tls12ClientWriteKey, this.tls12ClientWriteIv);
                return 0;
            }
            this.Fail("意外的 ChangeCipherSpec");
            return -1;
        }

        // 3. 加密记录解密 (readCipher != null) - 零切片分配，直接传入底层滑动窗口指针与偏移
        if (this.readCipher != null) {
            this.recType[0] = 0;
            byte[] pt = this.readCipher.Decrypt(header, inBuf, pOffset, pLen, this.recType);
            if (pt == null) {
                this.Fail("TLS 记录 AEAD 解密或 MAC 校验失败");
                return -1;
            }

            int innerType = this.recType[0];
            if (innerType == TlsRecord.ContentTypeAlert) {
                // 与明文告警同口径：恰 2 字节，否则按畸形断开——3 字节的
                // [1,0,0] 曾被当成 close_notify 处理。
                if (pt.Length != 2) {
                    this.Fail("TLS 加密告警长度非法");
                    return -1;
                }
                if ((pt[1] & 255) == TlsRecord.AlertCloseNotify) {
                    this.state = StateClosed;
                    return 0;
                }
                this.Fail("对端发送加密 TLS 告警");
                return -1;
            } else if (innerType == TlsRecord.ContentTypeApplicationData) {
                if (this.state != StateConnected || (!this.isServer && !this.disableVerify && !this.peerAuthenticated)) {
                    this.Fail("TLS 应用数据早于对端身份认证");
                    return -1;
                }
                this.appReadBuf.WriteBytes(pt);
                return 0;
            } else if (innerType == TlsRecord.ContentTypeHandshake) {
                return this.ProcessHandshakePayload(pt);
            }
            this.Fail("TLS 加密记录类型非法");
            return -1;
        }

        // 4. 明文 Handshake 记录
        if (ctype == TlsRecord.ContentTypeHandshake) {
            byte[] payload = new byte[pLen];
            if (pLen > 0) {
                NativeMemory.Copy(payload, (nint)inBuf + (nint)pOffset, pLen);
            }
            return this.ProcessHandshakePayload(payload);
        }

        return 0;
    }

    int ProcessHandshakePayload(byte[] data) {
        if (data == null || data.Length == 0) { return 0; }
        if (this.state != StateConnected) {
            if (this.preAuthHandshakeBytes > MaxPreAuthHandshakeBytes - data.Length) {
                this.Fail("TLS 认证前握手消息超出大小上限");
                return -1;
            }
            this.preAuthHandshakeBytes = this.preAuthHandshakeBytes + data.Length;
        }
        this.handshakeBuf.WriteBytes(data);
        while (this.handshakeBuf.Length() >= 4) {
            int msgLen = this.handshakeBuf.PeekU8(1) * 65536
                + this.handshakeBuf.PeekU8(2) * 256
                + this.handshakeBuf.PeekU8(3);
            if (msgLen < 0 || msgLen > MaxPreAuthHandshakeBytes - 4) {
                this.Fail("非法握手消息体长度");
                return -1;
            }
            int total = 4 + msgLen;
            if (this.handshakeBuf.Length() < total) { return 0; }
            byte[] fullMsg = new byte[total];
            NativeMemory.Copy(fullMsg, (nint)this.handshakeBuf.Buffer() + (nint)this.handshakeBuf.Head(), total);
            this.handshakeBuf.RemovePrefix(total);
            byte[] msgBody = new byte[msgLen];
            if (msgLen > 0) { NativeMemory.Copy(msgBody, (nint)fullMsg + 4, msgLen); }
            int r = this.ProcessOneHandshakeMessage(fullMsg[0] & 255, fullMsg, msgBody);
            if (r < 0) { return -1; }
        }
        return 0;
    }

    int ProcessOneHandshakeMessage(int msgType, byte[] fullMsg, byte[] body) {
        if (msgType == TlsRecord.HandshakeClientHello) {
            return this.HandleClientHello(fullMsg, body);
        } else if (msgType == TlsRecord.HandshakeServerHello) {
            return this.HandleServerHello(fullMsg, body);
        } else if (msgType == TlsRecord.HandshakeEncryptedExtensions) {
            if (this.isServer || this.state != StateTls13Handshake || this.receivedEncryptedExtensions
                || this.peerCert != null || body.Length < 2) {
                this.Fail("意外的 TLS 1.3 EncryptedExtensions");
                return -1;
            }
            TlsByteReader extensions = new TlsByteReader(body, 0, body.Length);
            if (extensions.ReadU16() != extensions.Remaining()) {
                this.Fail("EncryptedExtensions 长度不匹配"); return -1;
            }
            List<int> seen = new List<int>();
            while (extensions.Remaining() > 0) {
                if (!extensions.Has(4)) { this.Fail("EncryptedExtensions 截断"); return -1; }
                int kind = extensions.ReadU16();
                int size = extensions.ReadU16();
                if (!extensions.Has(size) || seen.Contains(kind)
                    || this.host == null || this.host.Length == 0) {
                    this.Fail("EncryptedExtensions 无效或未请求的扩展"); return -1;
                }
                if (kind == 0) {
                    // server_name 确认：必须为空。
                    if (size != 0) { this.Fail("EncryptedExtensions server_name 非空"); return -1; }
                    extensions.Skip(size);
                } else if (kind == 10) {
                    // supported_groups：RFC 8446 允许服务端在 EE 中回送
                    // （openssl 3.2+ 默认发送）。仅校验结构并忽略内容——
                    // 本栈只支持 X25519，协商已在 ServerHello 完成。
                    if (size < 4 || (size & 1) != 0) {
                        this.Fail("EncryptedExtensions supported_groups 非法"); return -1;
                    }
                    int n = extensions.ReadU16();
                    if (n + 2 != size || (n & 1) != 0) {
                        this.Fail("EncryptedExtensions supported_groups 非法"); return -1;
                    }
                    for (int gi = 0; gi < n; gi = gi + 2) { extensions.ReadU16(); }
                } else if (kind == 16) {
                    // application_layer_protocol_negotiation (RFC 7301 §3.1)
                    if (size < 3) {
                        this.Fail("EncryptedExtensions ALPN 长度非法"); return -1;
                    }
                    int listLen = extensions.ReadU16();
                    if (listLen + 2 != size) {
                        this.Fail("EncryptedExtensions ALPN 列表长度非法"); return -1;
                    }
                    int pLen = extensions.ReadU8();
                    if (pLen + 1 != listLen || !extensions.Has(pLen)) {
                        this.Fail("EncryptedExtensions ALPN 协议名截断"); return -1;
                    }
                    byte[] pBytes = extensions.ReadBytes(pLen);
                    this.negotiatedAlpn = pBytes.ToStr(0, pLen);
                } else {
                    this.Fail("EncryptedExtensions 含未支持扩展: " + kind); return -1;
                }
                seen.Add(kind);
            }
            this.receivedEncryptedExtensions = true;
            this.transcript.Update(fullMsg);
            return 0;
        } else if (msgType == TlsRecord.HandshakeCertificate) {
            if (!this.isServer && this.negotiatedVersion == TlsRecord.VersionTls13 && !this.receivedEncryptedExtensions) {
                this.Fail("TLS 1.3 Certificate 早于 EncryptedExtensions"); return -1;
            }
            return this.HandleCertificate(fullMsg, body);
        } else if (msgType == TlsRecord.HandshakeCertificateStatus) {
            return this.HandleCertificateStatus(fullMsg, body);
        } else if (msgType == TlsRecord.HandshakeCertificateVerify) {
            return this.HandleCertificateVerify(fullMsg, body);
        } else if (msgType == TlsRecord.HandshakeServerKeyExchange) {
            return this.HandleServerKeyExchange(fullMsg, body);
        } else if (msgType == TlsRecord.HandshakeServerHelloDone) {
            return this.HandleServerHelloDone(fullMsg, body);
        } else if (msgType == TlsRecord.HandshakeClientKeyExchange) {
            return this.HandleClientKeyExchange(fullMsg, body);
        } else if (msgType == TlsRecord.HandshakeFinished) {
            if (this.isServer) {
                return this.HandleServerFinished(fullMsg, body);
            } else {
                return this.HandleFinished(fullMsg, body);
            }
        } else if (msgType == TlsRecord.HandshakeNewSessionTicket) {
            // RFC 5077 §3.3 / RFC 8446 §4.6.1：
            // 服务端发出的 NewSessionTicket 在 TLS 1.2 中位于 Finished 之前，
            // 必须计入握手 transcript，否则随后 Finished 校验的 verify_data 必败。
            this.transcript.Update(fullMsg);
            return 0;
        } else if (msgType == TlsRecord.HandshakeKeyUpdate) {
            // RFC 8446 §4.6.3：KeyUpdate 要求双方滚动流量密钥；未实现却
            // 静默忽略会让对端切换写密钥后本端所有记录解密失败，连接
            // 必然错位——显式拒绝并断开，绝不假装收到。
            this.Fail("未支持 TLS 1.3 KeyUpdate");
            return -1;
        }
        return 0;
    }


    // 客户端握手状态机（ServerHello、证书链提取与校验、ServerKeyExchange、Finished 等）见 TlsEngine.Client.zan
    // 服务端握手状态机（ClientHello、握手加密协商、ServerStartTls12/13、Finished 发送等）见 TlsEngine.Server.zan


    /* ---- 数据收发 (Application Data) ---- */

    // 加密应用数据指针并零拷贝直写到待发网络缓冲区，按 16KB 分片封装为 TLS 记录。
    public int SendAppData(nint dataPtr, int len) {
        if (this.state != StateConnected || this.writeCipher == null) {
            this.Fail("TLS 连接未就绪，无法发送数据");
            return -1;
        }
        if (len <= 0) { return 0; }
        int sent = 0;
        while (sent < len) {
            int chunk = len - sent;
            if (chunk > 16384) { chunk = 16384; }
            int recLen = this.writeCipher.RecordLen(chunk);
            this.outNet.EnsureCap(recLen);
            int encLen = this.writeCipher.EncryptToBuf(
                TlsRecord.ContentTypeApplicationData,
                dataPtr + (nint)sent,
                chunk,
                this.outNet.Buffer(),
                this.outNet.Head() + this.outNet.Length()
            );
            if (encLen <= 0) {
                this.Fail("应用数据记录加密失败");
                return -1;
            }
            this.outNet.Advance(encLen);
            sent = sent + chunk;
        }
        return sent;
    }

    // 加密应用数据字节数组并放入待发网络缓冲区。
    public int SendAppData(byte[] data, int offset, int len) {
        if (data == null || offset < 0 || len < 0 || offset + len > data.Length) { return -1; }
        return this.SendAppData((nint)data + (nint)offset, len);
    }

    // 加密应用数据字符串并放入待发网络缓冲区。
    public int SendAppData(string data, int offset, int len) {
        if (data == null || offset < 0 || len < 0 || offset + len > data.Length) { return -1; }
        return this.SendAppData((nint)data + (nint)offset, len);
    }

    // 从已解密的应用缓冲区提取明文数据到字节数组。
    public int RecvAppData(byte[] outBuf, int offset, int maxLen) {
        if (outBuf == null || offset < 0 || maxLen <= 0 || offset > outBuf.Length) { return 0; }
        if (this.appReadBuf.Length() == 0) {
            if (this.state == StateClosed) { return 0; }
            return 0;  // 无数据可读
        }
        int avail = this.appReadBuf.Length();
        int maxAllowed = outBuf.Length - offset;
        int toRead = avail > maxLen ? maxLen : avail;
        if (toRead > maxAllowed) { toRead = maxAllowed; }
        if (toRead > 0) {
            NativeMemory.Copy((nint)outBuf + (nint)offset, (nint)this.appReadBuf.Buffer() + (nint)this.appReadBuf.Head(), toRead);
            this.appReadBuf.RemovePrefix(toRead);
        }
        return toRead;
    }

    // 从已解密的应用缓冲区提取明文数据到原生字符串/内存切片。
    public int RecvAppData(string outBuf, int offset, int maxLen) {
        if (outBuf == null || offset < 0 || maxLen <= 0 || offset > outBuf.Length) { return 0; }
        if (this.appReadBuf.Length() == 0) {
            if (this.state == StateClosed) { return 0; }
            return 0;  // 无数据可读
        }
        int avail = this.appReadBuf.Length();
        int maxAllowed = outBuf.Length - offset;
        int toRead = avail > maxLen ? maxLen : avail;
        if (toRead > maxAllowed) { toRead = maxAllowed; }
        if (toRead > 0) {
            NativeMemory.Copy((nint)outBuf + (nint)offset, (nint)this.appReadBuf.Buffer() + (nint)this.appReadBuf.Head(), toRead);
            this.appReadBuf.RemovePrefix(toRead);
        }
        return toRead;
    }

    public int AvailableAppData() {
        return this.appReadBuf.Length();
    }

    public void Fail(string msg) {
        this.lastError = msg;
        this.state = StateFailed;
    }

    /* ---- ClientHello 报文组装 ---- */

    public byte[] BuildClientHello() {
        TlsByteWriter w = new TlsByteWriter();

        // 1. 握手层头留白 (4 字节)
        w.WriteU8(TlsRecord.HandshakeClientHello);  // 1
        w.WriteU24(0);  // 长度占位

        // 2. legacy_version (0x0303)
        w.WriteU16(TlsRecord.VersionTls12);

        // 3. random (32 bytes)
        w.WriteBytes(this.clientRandom);

        // 4. legacy_session_id (32 bytes)
        w.WriteU8(32);
        w.WriteBytes(this.sessionId);

        // 5. cipher_suites
        if (this.disableTls13) {
            w.WriteU16(4);
            w.WriteU16(0xc02f);  // TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
            w.WriteU16(0xc02b);  // TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
        } else {
            w.WriteU16(6);
            w.WriteU16(0x1301);  // TLS_AES_128_GCM_SHA256
            w.WriteU16(0xc02f);  // TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
            w.WriteU16(0xc02b);  // TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
        }

        // 6. legacy_compression_methods (0x01, 0x00)
        w.WriteU8(1);
        w.WriteU8(0);

        // 7. extensions
        TlsByteWriter extWriter = new TlsByteWriter();

        // 7.1 server_name (SNI)
        if (this.host != null && this.host.Length > 0) {
            extWriter.WriteU16(0);  // ext type 0 (server_name)
            int hostLen = this.host.Length;
            extWriter.WriteU16(hostLen + 5);
            extWriter.WriteU16(hostLen + 3);
            extWriter.WriteU8(0);  // name_type: host_name
            extWriter.WriteU16(hostLen);
            for (int i = 0; i < hostLen; i = i + 1) {
                extWriter.WriteU8(this.host[i] & 255);
            }
        }

        // 7.2 supported_groups (0x000a): X25519 (0x001d), secp256r1 (0x0017)
        extWriter.WriteU16(10);
        extWriter.WriteU16(6);
        extWriter.WriteU16(4);
        extWriter.WriteU16(0x001d);  // X25519
        extWriter.WriteU16(0x0017);  // secp256r1

        // 7.3 ec_point_formats (0x000b): uncompressed (0)
        extWriter.WriteU16(11);
        extWriter.WriteU16(2);
        extWriter.WriteU8(1);
        extWriter.WriteU8(0);

        // 7.4 signature_algorithms (0x000d)
        extWriter.WriteU16(13);
        extWriter.WriteU16(10);
        extWriter.WriteU16(8);
        extWriter.WriteU16(0x0804);  // rsa_pss_rsae_sha256
        extWriter.WriteU16(0x0805);  // ecdsa_secp256r1_sha256
        extWriter.WriteU16(0x0401);  // rsa_pkcs1_sha256 (TLS 1.2 only)
        extWriter.WriteU16(0x0403);  // ecdsa_sha256 (TLS 1.2 与 TLS 1.3 均可)

        // 7.5 TLS 1.3 专属扩展: supported_versions (0x002b) + key_share (0x0033)
        if (!this.disableTls13) {
            // supported_versions
            extWriter.WriteU16(43);  // 0x002b
            extWriter.WriteU16(5);
            extWriter.WriteU8(4);
            extWriter.WriteU16(TlsRecord.VersionTls13);  // 0x0304
            extWriter.WriteU16(TlsRecord.VersionTls12);  // 0x0303

            // key_share
            extWriter.WriteU16(51);  // 0x0033
            extWriter.WriteU16(38);  // 2 (client_shares length) + 2 (group) + 2 (key_exchange length) + 32
            extWriter.WriteU16(36);
            extWriter.WriteU16(0x001d);  // X25519
            extWriter.WriteU16(32);
            extWriter.WriteBytes(this.clientX25519Pub);
        }

        // 7.6 status_request (0x0005) - OCSP Stapling (RFC 6066 §8)
        extWriter.WriteU16(5);
        extWriter.WriteU16(5);
        extWriter.WriteU8(1);   // ocsp (1)
        extWriter.WriteU16(0);  // responder_id_list length = 0
        extWriter.WriteU16(0);  // request_extensions length = 0

        // 7.7 alpn (0x0010) - RFC 7301
        if (this.clientAlpnList != null && this.clientAlpnList.Count > 0) {
            int totalProtoBytes = 0;
            for (int i = 0; i < this.clientAlpnList.Count; i = i + 1) {
                totalProtoBytes = totalProtoBytes + 1 + this.clientAlpnList[i].Length;
            }
            extWriter.WriteU16(16); // 0x0010
            extWriter.WriteU16(totalProtoBytes + 2);
            extWriter.WriteU16(totalProtoBytes);
            for (int j = 0; j < this.clientAlpnList.Count; j = j + 1) {
                string proto = this.clientAlpnList[j];
                extWriter.WriteU8(proto.Length);
                extWriter.WriteBytes(proto.ToBytes());
            }
        }

        w.WriteU16(extWriter.Length());
        w.WriteBytes(extWriter.ToArray());

        // 回填 ClientHello 握手报文总长度
        int bodyLen = w.Length() - 4;
        byte[] res = w.ToArray();
        res[1] = (byte)((bodyLen >> 16) & 255);
        res[2] = (byte)((bodyLen >> 8) & 255);
        res[3] = (byte)(bodyLen & 255);

        return res;
    }
}
