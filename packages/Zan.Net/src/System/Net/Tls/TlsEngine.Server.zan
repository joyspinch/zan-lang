using System;
using System.Collections.Generic;
using System.IO;
using System.Security.Cryptography;

namespace System.Net.Tls;

// TlsEngine.Server.zan - 服务端 TLS 1.2 / TLS 1.3 握手状态机实现
// 包含 ClientHello 解析、密钥交换协商、ServerStartTls12/13、Finished 发送
public partial class TlsEngine {
    /* ---- 服务端握手实现 ---- */

    int HandleClientHello(byte[] fullMsg, byte[] body) {
        if (!this.isServer || this.state != StateServerWaitingClientHello) {
            this.Fail("意外的 ClientHello"); return -1;
        }
        TlsByteReader r = new TlsByteReader(body, 0, body.Length);
        if (!r.Has(35)) { this.Fail("ClientHello 过短"); return -1; }
        int clientVer = r.ReadU16();
        this.clientRandom = r.ReadBytes(32);
        int sidLen = r.ReadU8();
        if (sidLen > 32 || !r.Has(sidLen + 2)) { this.Fail("ClientHello session_id 非法"); return -1; }
        this.sessionId = r.ReadBytes(sidLen);

        int csLen = r.ReadU16();
        if (csLen < 2 || (csLen & 1) != 0 || !r.Has(csLen + 1)) {
            this.Fail("ClientHello cipher_suites 非法"); return -1;
        }
        bool suite13 = false;
        bool suite12 = false;
        for (int i = 0; i < csLen; i = i + 2) {
            int suite = r.ReadU16();
            if (suite == 0x1301) { suite13 = true; }
            if (suite == 0xc02f || suite == 0xc02b) { suite12 = true; }
        }
        int compLen = r.ReadU8();
        if (compLen != 1 || !r.Has(1) || r.ReadU8() != 0) {
            this.Fail("ClientHello compression_methods 非法"); return -1;
        }

        bool offered13 = false;
        bool offered12 = false;
        bool hasVersions = false;
        bool hasShares = false;
        bool hasSigAlgs = false;
        bool hasGroups = false;
        bool sig13 = false;
        bool sig13Ec = false;
        bool sig12 = false;
        bool sig12Ec = false;
        bool groupX25519 = false;
        byte[] clientShare = null;
        List<int> seenExtensions = new List<int>();
        if (r.Remaining() > 0) {
            if (!r.Has(2)) { this.Fail("ClientHello extensions 长度非法"); return -1; }
            int extTotal = r.ReadU16();
            if (extTotal != r.Remaining()) { this.Fail("ClientHello extensions 长度不匹配"); return -1; }
            while (r.Remaining() > 0) {
                if (!r.Has(4)) { this.Fail("ClientHello extension 截断"); return -1; }
                int extType = r.ReadU16();
                int extLen = r.ReadU16();
                if (!r.Has(extLen)) { this.Fail("ClientHello extension 长度非法"); return -1; }
                if (seenExtensions.Contains(extType)) { this.Fail("ClientHello extension 重复"); return -1; }
                seenExtensions.Add(extType);
                int extEnd = r.Offset() + extLen;
                if (extType == 43) {  // supported_versions
                    if (hasVersions || extLen < 3) { this.Fail("supported_versions 非法"); return -1; }
                    hasVersions = true;
                    int n = r.ReadU8();
                    if (n < 2 || (n & 1) != 0 || n + 1 != extLen) { this.Fail("supported_versions 列表非法"); return -1; }
                    for (int i = 0; i < n; i = i + 2) {
                        int v = r.ReadU16();
                        if (v == TlsRecord.VersionTls13) { offered13 = true; }
                        if (v == TlsRecord.VersionTls12) { offered12 = true; }
                    }
                } else if (extType == 13) {  // signature_algorithms
                    if (hasSigAlgs || extLen < 4) { this.Fail("signature_algorithms 非法"); return -1; }
                    hasSigAlgs = true;
                    int n = r.ReadU16();
                    if (n < 2 || (n & 1) != 0 || n + 2 != extLen) { this.Fail("signature_algorithms 列表非法"); return -1; }
                    for (int i = 0; i < n; i = i + 2) {
                        int scheme = r.ReadU16();
                        if (scheme == 0x0804) { sig13 = true; }
                        if (scheme == 0x0805) { sig13Ec = true; this.clientAdvertised0805 = true; }
                        if (scheme == 0x0401) { sig12 = true; }
                        if (scheme == 0x0403) { sig12Ec = true; this.clientAdvertised0403 = true; }
                    }
                } else if (extType == 10) {  // supported_groups
                    if (hasGroups || extLen < 4) { this.Fail("supported_groups 非法"); return -1; }
                    hasGroups = true;
                    int n = r.ReadU16();
                    if (n < 2 || (n & 1) != 0 || n + 2 != extLen) { this.Fail("supported_groups 列表非法"); return -1; }
                    for (int i = 0; i < n; i = i + 2) { if (r.ReadU16() == 0x001d) { groupX25519 = true; } }
                } else if (extType == 51) {  // key_share
                    if (hasShares || extLen < 2) { this.Fail("key_share 非法"); return -1; }
                    hasShares = true;
                    int n = r.ReadU16();
                    if (n + 2 != extLen) { this.Fail("key_share 列表非法"); return -1; }
                    while (r.Offset() < extEnd) {
                        if (extEnd - r.Offset() < 4) { this.Fail("key_share 条目截断"); return -1; }
                        int group = r.ReadU16();
                        int klen = r.ReadU16();
                        if (klen > extEnd - r.Offset()) { this.Fail("key_share 长度非法"); return -1; }
                        if (group == 0x001d) {
                            if (clientShare != null || klen != 32) { this.Fail("X25519 key_share 非法"); return -1; }
                            clientShare = r.ReadBytes(klen);
                        } else { r.Skip(klen); }
                    }
                } else if (extType == 16) {  // alpn (0x0010)
                    if (extLen >= 2) {
                        int listLen = r.ReadU16();
                        int aEnd = r.Offset() + listLen;
                        if (aEnd <= extEnd) {
                            while (r.Offset() < aEnd) {
                                int pLen = r.ReadU8();
                                if (pLen <= 0 || r.Offset() + pLen > aEnd) { break; }
                                byte[] pBytes = r.ReadBytes(pLen);
                                this.clientAlpnList.Add(pBytes.ToStr(0, pLen));
                            }
                        }
                    }
                }
                if (r.Offset() > extEnd) { this.Fail("ClientHello extension 越界"); return -1; }
                r.Skip(extEnd - r.Offset());
            }
        }
        if (!hasVersions) { offered12 = clientVer == TlsRecord.VersionTls12; }
        if (clientVer != TlsRecord.VersionTls12) { this.Fail("ClientHello legacy_version 不受支持"); return -1; }
        // 服务端按自身证书叶子公钥类型挑客户端广告过的方案：EC 公钥只认
        // ECDSA 方案（TLS 1.3 的 0x0805/0x0403 均可，TLS 1.2 仅 0x0403），
        // RSA 公钥只认 RSA 方案；不匹配按无共同算法拒绝。
        bool srvSig13 = sig13;
        bool srvSig12 = sig12;
        if (this.cachedCert != null && this.cachedCert.HasEcKey()) {
            srvSig13 = sig13Ec || sig12Ec;
            srvSig12 = sig12Ec;
        }
        this.transcript.Update(fullMsg);
        if (!this.disableTls13 && offered13 && suite13 && srvSig13 && groupX25519 && clientShare != null) {
            return this.ServerStartTls13(clientShare);
        }
        if (offered12 && suite12 && srvSig12 && groupX25519) { return this.ServerStartTls12(); }
        this.Fail("ClientHello 无共同 TLS 版本、套件、X25519 或签名算法");
        return -1;
    }

    int ServerStartTls13(byte[] clientShare) {
        this.negotiatedVersion = TlsRecord.VersionTls13;
        this.negotiatedCipherSuite = 0x1301;  // TLS_AES_128_GCM_SHA256
        this.clientX25519Pub = clientShare;

        // 生成服务端 X25519 临时密钥
        byte[] serverPub = null;
        this.clientX25519Priv = GenerateX25519(out serverPub);
        this.serverX25519Pub = serverPub;
        this.serverRandom = RandomBytes(32);
        if (this.clientX25519Priv == null || serverPub == null || this.serverRandom == null) {
            this.Fail("TLS 1.3 随机数或 X25519 密钥生成失败"); return -1;
        }

        // 构造 ServerHello
        TlsByteWriter sh = new TlsByteWriter();
        sh.WriteU8(TlsRecord.HandshakeServerHello);
        sh.WriteU24(0);  // placeholder
        int shStart = sh.Length();

        sh.WriteU16(TlsRecord.VersionTls12);  // legacy_version 0x0303
        sh.WriteBytes(this.serverRandom);
        sh.WriteU8(this.sessionId.Length);
        sh.WriteBytes(this.sessionId);
        sh.WriteU16(this.negotiatedCipherSuite);
        sh.WriteU8(0);  // compression: null

        // extensions
        TlsByteWriter exts = new TlsByteWriter();
        // supported_versions
        exts.WriteU16(43);
        exts.WriteU16(2);
        exts.WriteU16(TlsRecord.VersionTls13);
        // key_share
        exts.WriteU16(51);
        exts.WriteU16(36);
        exts.WriteU16(0x001d);  // X25519
        exts.WriteU16(32);
        exts.WriteBytes(serverPub);

        sh.WriteU16(exts.Length());
        sh.WriteBytes(exts.ToArray());

        int shBodyLen = sh.Length() - shStart;
        byte[] shBytes = sh.ToArray();
        shBytes[1] = (byte)((shBodyLen >> 16) & 255);
        shBytes[2] = (byte)((shBodyLen >> 8) & 255);
        shBytes[3] = (byte)(shBodyLen & 255);

        this.transcript.Update(shBytes);

        byte[] recSH = TlsRecord.FormatPlaintext(TlsRecord.ContentTypeHandshake, TlsRecord.VersionTls12, shBytes, 0, shBytes.Length);
        this.outNet.WriteBytes(recSH);

        byte[] dummyCcs = new byte[1]; dummyCcs[0] = 1;
        byte[] recCCS = TlsRecord.FormatPlaintext(TlsRecord.ContentTypeChangeCipherSpec, TlsRecord.VersionTls12, dummyCcs, 0, 1);
        this.outNet.WriteBytes(recCCS);

        // 计算 X25519 共享密钥；低阶点产生的全零结果必须拒绝。
        byte[] sharedSecret = this.DeriveX25519Shared(
            this.clientX25519Priv,
            this.clientX25519Pub,
            "TLS 1.3 X25519 密钥协商失败");
        if (sharedSecret == null) { return -1; }

        // 派生 TLS 1.3 握手流量密钥
        byte[] zeros32 = new byte[32];
        byte[] earlySecret = Hkdf.Extract(null, zeros32);
        byte[] emptyHash = Sha256.Hash(new byte[0], 0);
        byte[] derivedSecret = Hkdf.ExpandLabel(earlySecret, "derived", emptyHash, 32);
        this.handshakeSecret = Hkdf.Extract(derivedSecret, sharedSecret);

        byte[] helloHash = this.transcript.CurrentHash();
        this.clientHsTraffic = Hkdf.ExpandLabel(this.handshakeSecret, "c hs traffic", helloHash, 32);
        this.serverHsTraffic = Hkdf.ExpandLabel(this.handshakeSecret, "s hs traffic", helloHash, 32);

        byte[] serverHsKey = Hkdf.ExpandLabel(this.serverHsTraffic, "key", null, 16);
        byte[] serverHsIv = Hkdf.ExpandLabel(this.serverHsTraffic, "iv", null, 12);
        byte[] clientHsKey = Hkdf.ExpandLabel(this.clientHsTraffic, "key", null, 16);
        byte[] clientHsIv = Hkdf.ExpandLabel(this.clientHsTraffic, "iv", null, 12);

        this.writeCipher = new TlsCipherState(TlsRecord.VersionTls13, serverHsKey, serverHsIv);
        this.readCipher = new TlsCipherState(TlsRecord.VersionTls13, clientHsKey, clientHsIv);

        // 构造并发送 EncryptedExtensions (0x08)
        this.SelectAlpn();
        TlsByteWriter eeExtWriter = new TlsByteWriter();
        if (this.negotiatedAlpn != null && this.negotiatedAlpn.Length > 0) {
            int pLen = this.negotiatedAlpn.Length;
            eeExtWriter.WriteU16(16); // alpn
            eeExtWriter.WriteU16(pLen + 3);
            eeExtWriter.WriteU16(pLen + 1);
            eeExtWriter.WriteU8(pLen);
            eeExtWriter.WriteBytes(this.negotiatedAlpn.ToBytes());
        }
        byte[] eeExtBytes = eeExtWriter.ToArray();
        byte[] eeMsg = new byte[4 + 2 + eeExtBytes.Length];
        eeMsg[0] = (byte)TlsRecord.HandshakeEncryptedExtensions;
        int eeBodyLen = 2 + eeExtBytes.Length;
        eeMsg[1] = (byte)((eeBodyLen >> 16) & 255);
        eeMsg[2] = (byte)((eeBodyLen >> 8) & 255);
        eeMsg[3] = (byte)(eeBodyLen & 255);
        eeMsg[4] = (byte)((eeExtBytes.Length >> 8) & 255);
        eeMsg[5] = (byte)(eeExtBytes.Length & 255);
        if (eeExtBytes.Length > 0) {
            NativeMemory.Copy((nint)eeMsg + 6, (nint)eeExtBytes, eeExtBytes.Length);
        }
        this.transcript.Update(eeMsg);
        byte[] recEE = this.writeCipher.Encrypt(TlsRecord.ContentTypeHandshake, eeMsg, 0, eeMsg.Length);
        this.outNet.WriteBytes(recEE);

        // 读取证书（叶子 + 中间证书的完整链，总长受限）
        List<X509Certificate> sendChain = this.SendChain();
        if (sendChain == null) {
            X509Certificate probe = this.cachedCert;
            if (probe == null && this.certFile != null && File.Exists(this.certFile)) {
                probe = X509Certificate.FromPemFile(this.certFile);
                this.cachedCert = probe;
            }
            sendChain = this.SendChain();
        }
        if (sendChain == null || sendChain[0].RawDer() == null) {
            this.Fail("服务端证书解析失败: " + this.certFile);
            return -1;
        }

        TlsByteWriter certMsg = new TlsByteWriter();
        certMsg.WriteU8(TlsRecord.HandshakeCertificate);
        certMsg.WriteU24(0);
        int cstart = certMsg.Length();
        certMsg.WriteU8(0);  // req_context len = 0
        int entriesLen = 0;
        for (int i = 0; i < sendChain.Count; i = i + 1) {
            int extraExt = 0;
            if (i == 0 && this.serverOcspResponse != null) {
                extraExt = 4 + 4 + this.serverOcspResponse.Length;
            }
            entriesLen = entriesLen + 3 + sendChain[i].RawDerLen()
                + 2 + extraExt;  // 每条目后的扩展向量长度
        }
        certMsg.WriteU24(entriesLen);
        for (int i = 0; i < sendChain.Count; i = i + 1) {
            byte[] der = sendChain[i].RawDer();
            int derLen = sendChain[i].RawDerLen();
            certMsg.WriteU24(derLen);
            certMsg.WriteBytes(der, 0, derLen);
            if (i == 0 && this.serverOcspResponse != null) {
                int ocspExtDataLen = 4 + this.serverOcspResponse.Length;
                certMsg.WriteU16(4 + ocspExtDataLen);
                certMsg.WriteU16(5); // status_request (0x0005)
                certMsg.WriteU16(ocspExtDataLen);
                certMsg.WriteU8(1);  // ocsp (1)
                certMsg.WriteU24(this.serverOcspResponse.Length);
                certMsg.WriteBytes(this.serverOcspResponse);
            } else {
                certMsg.WriteU16(0);  // extensions length = 0
            }
        }
        int certBodyLen = certMsg.Length() - cstart;
        byte[] certBytes = certMsg.ToArray();
        certBytes[1] = (byte)((certBodyLen >> 16) & 255);
        certBytes[2] = (byte)((certBodyLen >> 8) & 255);
        certBytes[3] = (byte)(certBodyLen & 255);

        this.transcript.Update(certBytes);
        byte[] recCert = this.writeCipher.Encrypt(TlsRecord.ContentTypeHandshake, certBytes, 0, certBytes.Length);
        this.outNet.WriteBytes(recCert);

        byte[] cvInput = new byte[130];
        for (int sp = 0; sp < 64; sp = sp + 1) { cvInput[sp] = 32; }
        string cvLabel = "TLS 1.3, server CertificateVerify";
        for (int i = 0; i < 33; i = i + 1) { cvInput[64 + i] = (byte)(cvLabel[i] & 255); }
        cvInput[97] = 0;
        byte[] cvHash = this.transcript.CurrentHash();
        if (cvHash == null || cvHash.Length != 32) { this.Fail("CertificateVerify transcript 摘要失败"); return -1; }
        NativeMemory.Copy((nint)cvInput + 98, cvHash, 32);

        // 服务端按自身证书叶子公钥类型选方案（CV 用叶子私钥签名，与证书
        // 的 issuer 签名算法无关）：EC 公钥选 ECDSA-SHA256 方案（RFC
        // 8446 §4.2.3 要求用客户端广告过的方案：优先 0x0403=ecdsa_sha256，
        // 未广告时回落 0x0805=ecdsa_secp256r1_sha256），RSA 公钥
        // rsa_pss_rsae_sha256；无对应私钥一律失败。
        bool ecCert = this.cachedCert != null && this.cachedCert.HasEcKey();
        byte[] sigBytes = null;
        int cvScheme = 0;
        if (ecCert) {
            if (this.clientAdvertised0403) {
                cvScheme = 0x0403;
            } else if (this.clientAdvertised0805) {
                cvScheme = 0x0805;
            } else {
                this.Fail("客户端未广告任何 ECDSA 签名方案");
                return -1;
            }
            EcKey ecKey = this.cachedEcKey;
            if (ecKey == null) {
                string privKeyPem = "";
                if (this.keyFile != null && File.Exists(this.keyFile)) { privKeyPem = File.ReadAllText(this.keyFile); }
                ecKey = EcKey.FromPrivatePem(privKeyPem);
            }
            if (ecKey == null) {
                this.Fail("服务端 EC 私钥加载失败: " + this.keyFile);
                return -1;
            }
            sigBytes = ecKey.SignSha256Det(cvInput.ToStr(0, 130), 130);
        } else {
            RsaKey rsaKey = this.cachedKey;
            if (rsaKey == null) {
                string privKeyPem = "";
                if (this.keyFile != null && File.Exists(this.keyFile)) { privKeyPem = File.ReadAllText(this.keyFile); }
                rsaKey = RsaKey.FromPrivatePem(privKeyPem);
            }
            if (rsaKey == null || !rsaKey.HasPrivateKey()) {
                this.Fail("服务端私钥加载失败: " + this.keyFile);
                return -1;
            }
            sigBytes = rsaKey.SignPssSha256Raw(cvInput, 130);
            cvScheme = 0x0804;
        }
        if (sigBytes == null) {
            this.Fail("CertificateVerify 签名失败");
            return -1;
        }

        TlsByteWriter cvMsg = new TlsByteWriter();
        cvMsg.WriteU8(TlsRecord.HandshakeCertificateVerify);
        cvMsg.WriteU24(4 + sigBytes.Length);
        cvMsg.WriteU16(cvScheme);
        cvMsg.WriteU16(sigBytes.Length);
        cvMsg.WriteBytes(sigBytes);
        byte[] cvBytes = cvMsg.ToArray();
        this.transcript.Update(cvBytes);
        byte[] recCV = this.writeCipher.Encrypt(TlsRecord.ContentTypeHandshake, cvBytes, 0, cvBytes.Length);
        this.outNet.WriteBytes(recCV);

        // 构造 Server Finished
        byte[] sFinishedKey = Hkdf.ExpandLabel(this.serverHsTraffic, "finished", null, 32);
        byte[] sVerifyData = Hmac.Sha256(sFinishedKey, 32, this.transcript.CurrentHash(), 32);

        TlsByteWriter sFinMsg = new TlsByteWriter();
        sFinMsg.WriteU8(TlsRecord.HandshakeFinished);
        sFinMsg.WriteU24(32);
        sFinMsg.WriteBytes(sVerifyData);
        byte[] sFinBytes = sFinMsg.ToArray();

        this.transcript.Update(sFinBytes);
        byte[] recFin = this.writeCipher.Encrypt(TlsRecord.ContentTypeHandshake, sFinBytes, 0, sFinBytes.Length);
        this.outNet.WriteBytes(recFin);

        // 派生应用流量密钥
        byte[] derivedSecret2 = Hkdf.ExpandLabel(this.handshakeSecret, "derived", emptyHash, 32);
        byte[] masterSecret = Hkdf.Extract(derivedSecret2, zeros32);

        byte[] finHash = this.transcript.CurrentHash();
        byte[] clientAppTraffic = Hkdf.ExpandLabel(masterSecret, "c ap traffic", finHash, 32);
        byte[] serverAppTraffic = Hkdf.ExpandLabel(masterSecret, "s ap traffic", finHash, 32);

        byte[] serverAppKey = Hkdf.ExpandLabel(serverAppTraffic, "key", null, 16);
        byte[] serverAppIv = Hkdf.ExpandLabel(serverAppTraffic, "iv", null, 12);
        byte[] clientAppKey = Hkdf.ExpandLabel(clientAppTraffic, "key", null, 16);
        byte[] clientAppIv = Hkdf.ExpandLabel(clientAppTraffic, "iv", null, 12);

        this.writeCipher = new TlsCipherState(TlsRecord.VersionTls13, serverAppKey, serverAppIv);
        this.clientAppKeyPending = clientAppKey;
        this.clientAppIvPending = clientAppIv;

        this.state = StateServerTls13WaitingFinished;
        return 0;
    }

    int ServerStartTls12() {
        this.negotiatedVersion = TlsRecord.VersionTls12;
        // 套件与证书叶子公钥类型绑定：EC 公钥 ECDHE_ECDSA(0xc02b)，
        // RSA 公钥 ECDHE_RSA(0xc02f)。
        bool tls12EcCert = this.cachedCert != null && this.cachedCert.HasEcKey();
        if (tls12EcCert) {
            this.negotiatedCipherSuite = 0xc02b;  // TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
        } else {
            this.negotiatedCipherSuite = 0xc02f;  // TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
        }
        this.serverRandom = RandomBytes(32);
        if (this.serverRandom == null) { this.Fail("TLS 1.2 随机数生成失败"); return -1; }

        // 1. ServerHello
        this.SelectAlpn();
        TlsByteWriter shExt = new TlsByteWriter();
        if (this.negotiatedAlpn != null && this.negotiatedAlpn.Length > 0) {
            int pLen = this.negotiatedAlpn.Length;
            shExt.WriteU16(16); // alpn
            shExt.WriteU16(pLen + 3);
            shExt.WriteU16(pLen + 1);
            shExt.WriteU8(pLen);
            shExt.WriteBytes(this.negotiatedAlpn.ToBytes());
        }
        byte[] shExtBytes = shExt.ToArray();
        int extTotal = shExtBytes.Length > 0 ? 2 + shExtBytes.Length : 0;

        TlsByteWriter sh = new TlsByteWriter();
        sh.WriteU8(TlsRecord.HandshakeServerHello);
        sh.WriteU24(38 + this.sessionId.Length + extTotal);
        sh.WriteU16(TlsRecord.VersionTls12);
        sh.WriteBytes(this.serverRandom);
        sh.WriteU8(this.sessionId.Length);
        sh.WriteBytes(this.sessionId);
        sh.WriteU16(this.negotiatedCipherSuite);
        sh.WriteU8(0);
        if (extTotal > 0) {
            sh.WriteU16(shExtBytes.Length);
            sh.WriteBytes(shExtBytes);
        }
        byte[] shBytes = sh.ToArray();
        this.transcript.Update(shBytes);
        byte[] recSH = TlsRecord.FormatPlaintext(TlsRecord.ContentTypeHandshake, TlsRecord.VersionTls12, shBytes, 0, shBytes.Length);
        this.outNet.WriteBytes(recSH);

        // 2. Certificate（叶子 + 中间证书的完整链，总长受限）
        List<X509Certificate> sendChain = this.SendChain();
        if (sendChain == null) {
            X509Certificate probe = this.cachedCert;
            if (probe == null && this.certFile != null && File.Exists(this.certFile)) {
                probe = X509Certificate.FromPemFile(this.certFile);
                this.cachedCert = probe;
            }
            sendChain = this.SendChain();
        }
        if (sendChain == null || sendChain[0].RawDer() == null) {
            this.Fail("服务端缺少证书文件: " + this.certFile);
            return -1;
        }
        TlsByteWriter certMsg = new TlsByteWriter();
        certMsg.WriteU8(TlsRecord.HandshakeCertificate);
        certMsg.WriteU24(0);
        int cstart = certMsg.Length();
        int entriesLen = 0;
        for (int i = 0; i < sendChain.Count; i = i + 1) {
            entriesLen = entriesLen + 3 + sendChain[i].RawDerLen();
        }
        certMsg.WriteU24(entriesLen);
        for (int i = 0; i < sendChain.Count; i = i + 1) {
            byte[] der = sendChain[i].RawDer();
            int derLen = sendChain[i].RawDerLen();
            certMsg.WriteU24(derLen);
            certMsg.WriteBytes(der, 0, derLen);
        }
        int certBodyLen = certMsg.Length() - cstart;
        byte[] certBytes = certMsg.ToArray();
        certBytes[1] = (byte)((certBodyLen >> 16) & 255);
        certBytes[2] = (byte)((certBodyLen >> 8) & 255);
        certBytes[3] = (byte)(certBodyLen & 255);
        this.transcript.Update(certBytes);
        byte[] recCert = TlsRecord.FormatPlaintext(TlsRecord.ContentTypeHandshake, TlsRecord.VersionTls12, certBytes, 0, certBytes.Length);
        this.outNet.WriteBytes(recCert);

        // 若配置了 OCSP Stapling 响应，发送 CertificateStatus 握手报文 (RFC 6066 §8)
        if (this.serverOcspResponse != null) {
            TlsByteWriter csMsg = new TlsByteWriter();
            csMsg.WriteU8(TlsRecord.HandshakeCertificateStatus);
            csMsg.WriteU24(1 + 3 + this.serverOcspResponse.Length);
            csMsg.WriteU8(1);  // ocsp (1)
            csMsg.WriteU24(this.serverOcspResponse.Length);
            csMsg.WriteBytes(this.serverOcspResponse);
            byte[] csBytes = csMsg.ToArray();
            this.transcript.Update(csBytes);
            byte[] recCs = TlsRecord.FormatPlaintext(TlsRecord.ContentTypeHandshake, TlsRecord.VersionTls12, csBytes, 0, csBytes.Length);
            this.outNet.WriteBytes(recCs);
        }

        // 3. ServerKeyExchange (X25519)
        byte[] serverPub = null;
        this.clientX25519Priv = GenerateX25519(out serverPub);
        this.serverX25519Pub = serverPub;
        if (this.clientX25519Priv == null || serverPub == null) {
            this.Fail("TLS 1.2 X25519 密钥生成失败"); return -1;
        }

        byte[] paramsBytes = new byte[36];
        paramsBytes[0] = 3;  // named_curve
        paramsBytes[1] = 0; paramsBytes[2] = 0x1d;  // X25519
        paramsBytes[3] = 32;
        for (int i = 0; i < 32; i = i + 1) { paramsBytes[4 + i] = serverPub[i]; }

        byte[] toSign = new byte[100];
        for (int i = 0; i < 32; i = i + 1) { toSign[i] = this.clientRandom[i]; }
        for (int i = 0; i < 32; i = i + 1) { toSign[32 + i] = this.serverRandom[i]; }
        for (int i = 0; i < 36; i = i + 1) { toSign[64 + i] = paramsBytes[i]; }

        // 与 TLS 1.3 同一分派：EC 证书 ecdsa_sha256(0x0403)，RSA 证书
        // rsa_pkcs1_sha256(0x0401)；无对应私钥一律失败。
        bool ecCert = this.cachedCert != null && this.cachedCert.SigIsEcdsa();
        byte[] sigBytes = null;
        int skeScheme = 0;
        if (ecCert) {
            EcKey ecKey = this.cachedEcKey;
            if (ecKey == null) {
                string privKeyPem = "";
                if (this.keyFile != null && File.Exists(this.keyFile)) { privKeyPem = File.ReadAllText(this.keyFile); }
                ecKey = EcKey.FromPrivatePem(privKeyPem);
            }
            if (ecKey == null) {
                this.Fail("服务端 EC 私钥加载失败: " + this.keyFile);
                return -1;
            }
            sigBytes = ecKey.SignSha256Det(toSign.ToStr(0, 100), 100);
            skeScheme = 0x0403;
        } else {
            RsaKey rsaKey = this.cachedKey;
            if (rsaKey == null) {
                string privKeyPem = "";
                if (this.keyFile != null && File.Exists(this.keyFile)) { privKeyPem = File.ReadAllText(this.keyFile); }
                rsaKey = RsaKey.FromPrivatePem(privKeyPem);
            }
            if (rsaKey == null || !rsaKey.HasPrivateKey()) {
                this.Fail("服务端私钥加载失败: " + this.keyFile);
                return -1;
            }
            sigBytes = rsaKey.SignSha256Raw(toSign.ToStr(0, 100), 100);
            skeScheme = 0x0401;
        }
        if (sigBytes == null) {
            this.Fail("ServerKeyExchange 签名失败");
            return -1;
        }

        TlsByteWriter skeMsg = new TlsByteWriter();
        skeMsg.WriteU8(TlsRecord.HandshakeServerKeyExchange);
        skeMsg.WriteU24(36 + 4 + sigBytes.Length);
        skeMsg.WriteBytes(paramsBytes);
        skeMsg.WriteU16(skeScheme);
        skeMsg.WriteU16(sigBytes.Length);
        skeMsg.WriteBytes(sigBytes);
        byte[] skeBytes = skeMsg.ToArray();
        this.transcript.Update(skeBytes);
        byte[] recSKE = TlsRecord.FormatPlaintext(TlsRecord.ContentTypeHandshake, TlsRecord.VersionTls12, skeBytes, 0, skeBytes.Length);
        this.outNet.WriteBytes(recSKE);

        // 4. ServerHelloDone
        byte[] shdBytes = new byte[4];
        shdBytes[0] = (byte)TlsRecord.HandshakeServerHelloDone;
        shdBytes[1] = 0; shdBytes[2] = 0; shdBytes[3] = 0;
        this.transcript.Update(shdBytes);
        byte[] recSHD = TlsRecord.FormatPlaintext(TlsRecord.ContentTypeHandshake, TlsRecord.VersionTls12, shdBytes, 0, 4);
        this.outNet.WriteBytes(recSHD);

        this.state = StateServerTls12WaitingClientKeyExchange;
        return 0;
    }

    int HandleClientKeyExchange(byte[] fullMsg, byte[] body) {
        if (this.state != StateServerTls12WaitingClientKeyExchange) { return 0; }
        TlsByteReader r = new TlsByteReader(body, 0, body.Length);
        int klen = r.ReadU8();
        if (klen != 32 || r.Remaining() != 32) {
            this.Fail("非法 ClientKeyExchange X25519 密钥长度");
            return -1;
        }
        this.clientX25519Pub = r.ReadBytes(32);
        this.transcript.Update(fullMsg);

        // 计算 PreMasterSecret；低阶点产生的全零结果必须拒绝。
        byte[] pms = this.DeriveX25519Shared(
            this.clientX25519Priv,
            this.clientX25519Pub,
            "TLS 1.2 X25519 密钥协商失败");
        if (pms == null) { return -1; }

        // 派生 TLS 1.2 MasterSecret (48 bytes)
        byte[] seed = new byte[64];
        for (int i = 0; i < 32; i = i + 1) { seed[i] = this.clientRandom[i]; }
        for (int i = 0; i < 32; i = i + 1) { seed[32 + i] = this.serverRandom[i]; }
        this.tls12MasterSecret = Hkdf.Tls12Prf(pms, "master secret", seed, 48);

        // 派生 KeyBlock
        byte[] kbSeed = new byte[64];
        for (int i = 0; i < 32; i = i + 1) { kbSeed[i] = this.serverRandom[i]; }
        for (int i = 0; i < 32; i = i + 1) { kbSeed[32 + i] = this.clientRandom[i]; }
        byte[] keyBlock = Hkdf.Tls12Prf(this.tls12MasterSecret, "key expansion", kbSeed, 40);

        byte[] cKey = new byte[16];
        byte[] sKey = new byte[16];
        byte[] cIv = new byte[4];
        byte[] sIv = new byte[4];
        for (int i = 0; i < 16; i = i + 1) { cKey[i] = keyBlock[i]; }
        for (int i = 0; i < 16; i = i + 1) { sKey[i] = keyBlock[16 + i]; }
        for (int i = 0; i < 4; i = i + 1) { cIv[i] = keyBlock[32 + i]; }
        for (int i = 0; i < 4; i = i + 1) { sIv[i] = keyBlock[36 + i]; }

        this.tls12ClientWriteKey = cKey;
        this.tls12ClientWriteIv = cIv;
        this.tls12ServerWriteKey = sKey;
        this.tls12ServerWriteIv = sIv;

        this.state = StateServerTls12WaitingFinished;
        return 0;
    }

    int HandleServerFinished(byte[] fullMsg, byte[] body) {
        if (this.negotiatedVersion == TlsRecord.VersionTls13) {
            byte[] clientFinishedKey = Hkdf.ExpandLabel(this.clientHsTraffic, "finished", null, 32);
            byte[] th = this.transcript.CurrentHash();
            byte[] expectedVerifyData = Hmac.Sha256(clientFinishedKey, 32, th, 32);

            if (body.Length != 32 || expectedVerifyData == null) {
                this.Fail("TLS 1.3 Client Finished 长度不符");
                return -1;
            }
            int diff = 0;
            for (int i = 0; i < 32; i = i + 1) {
                diff = diff | ((body[i] & 255) ^ (expectedVerifyData[i] & 255));
            }
            if (diff != 0) {
                this.Fail("TLS 1.3 Client Finished 校验失败");
                return -1;
            }

            this.transcript.Update(fullMsg);
            this.readCipher = new TlsCipherState(TlsRecord.VersionTls13, this.clientAppKeyPending, this.clientAppIvPending);
            this.state = StateConnected;
            return 1;
        } else {
            byte[] th = this.transcript.CurrentHash();
            byte[] expectedVerifyData = Hkdf.Tls12Prf(this.tls12MasterSecret, "client finished", th, 12);
            if (body.Length != 12 || expectedVerifyData == null) {
                this.Fail("TLS 1.2 Client Finished 长度不符");
                return -1;
            }
            int diff = 0;
            for (int i = 0; i < 12; i = i + 1) {
                diff = diff | ((body[i] & 255) ^ (expectedVerifyData[i] & 255));
            }
            if (diff != 0) {
                this.Fail("TLS 1.2 Client Finished 校验失败");
                return -1;
            }

            this.transcript.Update(fullMsg);

            // 服务端发送 ChangeCipherSpec
            byte[] ccs = new byte[1]; ccs[0] = 1;
            byte[] ccsRec = TlsRecord.FormatPlaintext(TlsRecord.ContentTypeChangeCipherSpec, TlsRecord.VersionTls12, ccs, 0, 1);
            this.outNet.WriteBytes(ccsRec);

            // 激活服务端加密
            this.writeCipher = new TlsCipherState(TlsRecord.VersionTls12, this.tls12ServerWriteKey, this.tls12ServerWriteIv);

            // 服务端发送 Finished
            byte[] th2 = this.transcript.CurrentHash();
            byte[] sVerifyData = Hkdf.Tls12Prf(this.tls12MasterSecret, "server finished", th2, 12);

            byte[] finishedMsg = new byte[4 + 12];
            finishedMsg[0] = (byte)TlsRecord.HandshakeFinished;
            finishedMsg[1] = 0; finishedMsg[2] = 0; finishedMsg[3] = 12;
            for (int i = 0; i < 12; i = i + 1) { finishedMsg[4 + i] = sVerifyData[i]; }

            this.transcript.Update(finishedMsg);
            byte[] encFin = this.writeCipher.Encrypt(TlsRecord.ContentTypeHandshake, finishedMsg, 0, finishedMsg.Length);
            this.outNet.WriteBytes(encFin);

            this.state = StateConnected;
            return 1;
        }
    }
}
