using System;

namespace System.Net.Tls;

public class TlsCipherState {
    public int version;
    public byte[] key;
    public byte[] iv;
    public long seq;
    public byte[] gcmCtx;
    public bool hasCtx;
    public byte[] nonceBuf;
    public byte[] seqBuf;
    public byte[] aadBuf;
    public byte[] decBuf;

    public TlsCipherState(int version, byte[] key, byte[] iv) {
        this.version = version;
        this.key = key;
        this.iv = iv;
        this.seq = 0;
        this.gcmCtx = new byte[512];
        this.nonceBuf = new byte[12];
        this.seqBuf = new byte[8];
        this.aadBuf = new byte[13];
        this.decBuf = new byte[18432];
        long initRes = NativeMemory.AesGcmInit(this.gcmCtx, 512, key, 128);
        this.hasCtx = (initRes == 0);
    }

    public int Version() { return this.version; }
    public long SequenceNumber() { return this.seq; }

    public int RecordLen(int plainLen) {
        if (this.version == TlsRecord.VersionTls13) {
            return plainLen + 22;  // 5 + (plainLen + 1) + 16
        } else {
            return plainLen + 29;  // 5 + 8 + plainLen + 16
        }
    }

    // 直写加密并封装为完整 TLS 记录（含 5 字节记录头）。返回写入的记录总字节数，失败返回 -1。
    public int EncryptToBuf(int contentType, nint dataPtr, int len, byte[] outBuf, int outOffset) {
        if (outBuf == null || len < 0 || outOffset < 0) { return -1; }
        if (this.version == TlsRecord.VersionTls13) {
            return this.EncryptTls13ToBuf(contentType, dataPtr, len, outBuf, outOffset);
        } else {
            return this.EncryptTls12ToBuf(contentType, dataPtr, len, outBuf, outOffset);
        }
    }

    // 加密明文负载并封装为完整 TLS 记录（含 5 字节记录头）。
    public byte[] Encrypt(int contentType, byte[] data, int offset, int len) {
        if (data == null || offset < 0 || len < 0 || offset + len > data.Length) { return null; }
        int recLen = this.RecordLen(len);
        byte[] record = new byte[recLen];
        int written = this.EncryptToBuf(contentType, (nint)data + (nint)offset, len, record, 0);
        if (written <= 0) { return null; }
        return record;
    }

    // 解密 TLS 记录密文负载，剥离认证标签与填充，产出原始明文与真实 ContentType。
    public byte[] Decrypt(byte[] header, byte[] payload, int pOffset, int pLen, List<int> outContentType) {
        if (header == null || header.Length < 5 || payload == null || pOffset < 0 || pLen < 0 || pOffset + pLen > payload.Length) {
            return null;
        }
        if (this.version == TlsRecord.VersionTls13) {
            return this.DecryptTls13(header, payload, pOffset, pLen, outContentType);
        } else {
            return this.DecryptTls12(header, payload, pOffset, pLen, outContentType);
        }
    }

    /* ---- TLS 1.2 记录层加解密 (RFC 5246 / RFC 5288) ---- */

    public int EncryptTls12ToBuf(int contentType, nint dataPtr, int len, byte[] outBuf, int outOffset) {
        int payloadLen = 8 + len + 16;
        int totalRecLen = 5 + payloadLen;
        if (outOffset + totalRecLen > outBuf.Length) { return -1; }

        nint outPtr = (nint)outBuf + (nint)outOffset;

        // 1. 外部记录头 (5 字节)
        outBuf[outOffset + 0] = (byte)(contentType & 255);
        outBuf[outOffset + 1] = 3;
        outBuf[outOffset + 2] = 3;
        outBuf[outOffset + 3] = (byte)((payloadLen >> 8) & 255);
        outBuf[outOffset + 4] = (byte)(payloadLen & 255);

        // 2. 8 字节 explicitNonce
        TlsRecord.WriteSeq64(this.seqBuf, 0, this.seq);
        NativeMemory.Copy(outPtr + 5, this.seqBuf, 8);

        // 3. 12 字节 Nonce: 4 字节 implicit_iv || 8 字节 explicit_nonce
        for (int i = 0; i < 4; i = i + 1) { this.nonceBuf[i] = (byte)(this.iv[i] & 255); }
        for (int i = 0; i < 8; i = i + 1) { this.nonceBuf[4 + i] = (byte)(this.seqBuf[i] & 255); }

        // 4. 13 字节 AAD
        TlsRecord.WriteSeq64(this.aadBuf, 0, this.seq);
        this.aadBuf[8] = (byte)(contentType & 255);
        this.aadBuf[9] = 3;
        this.aadBuf[10] = 3;
        this.aadBuf[11] = (byte)((len >> 8) & 255);
        this.aadBuf[12] = (byte)(len & 255);

        nint ctPtr = outPtr + 13;
        nint tagPtr = ctPtr + (nint)len;

        long hwRes = -1;
        if (this.hasCtx) {
            hwRes = NativeMemory.AesGcmEncryptCtx(this.gcmCtx, this.nonceBuf, this.aadBuf, 13, dataPtr, (long)len, ctPtr, tagPtr);
        } else {
            hwRes = NativeMemory.AesGcmEncrypt(this.key, 128, this.nonceBuf, this.aadBuf, 13, dataPtr, (long)len, ctPtr, tagPtr);
        }
        if (hwRes < 0) {
            byte[] pt = new byte[len];
            if (len > 0 && dataPtr != 0) { NativeMemory.Copy(pt, dataPtr, len); }
            byte[] tag = new byte[16];
            byte[] ct = AesGcm.Encrypt(this.key, 16, this.nonceBuf, this.aadBuf, 13, pt, len, tag);
            if (ct == null) { return -1; }
            NativeMemory.Copy(ctPtr, ct, len);
            NativeMemory.Copy(tagPtr, tag, 16);
        }

        this.seq = this.seq + 1;
        return totalRecLen;
    }

    public byte[] DecryptTls12(byte[] header, byte[] payload, int pOffset, int pLen, List<int> outContentType) {
        // 负载结构: explicitNonce(8) || ct(ctLen) || tag(16)
        if (pLen < 24) { return null; }
        int ctLen = pLen - 24;

        // 1. 提取 8 字节 explicit_nonce 并构造 12 字节 Nonce
        NativeMemory.Copy(this.nonceBuf, this.iv, 4);
        NativeMemory.Copy((nint)this.nonceBuf + 4, (nint)payload + (nint)pOffset, 8);

        // 2. 构造 13 字节 AAD
        TlsRecord.WriteSeq64(this.aadBuf, 0, this.seq);
        this.aadBuf[8] = (byte)(header[0] & 255);
        this.aadBuf[9] = 3;
        this.aadBuf[10] = 3;
        this.aadBuf[11] = (byte)((ctLen >> 8) & 255);
        this.aadBuf[12] = (byte)(ctLen & 255);

        nint ctPtr = (nint)payload + (nint)pOffset + 8;
        nint tagPtr = ctPtr + (nint)ctLen;

        byte[] pt = new byte[ctLen];
        long hwRes = -1;
        if (this.hasCtx) {
            hwRes = NativeMemory.AesGcmDecryptCtx(this.gcmCtx, this.nonceBuf, this.aadBuf, 13, ctPtr, (long)ctLen, tagPtr, pt);
        } else {
            hwRes = NativeMemory.AesGcmDecrypt(this.key, 128, this.nonceBuf, this.aadBuf, 13, ctPtr, (long)ctLen, tagPtr, pt);
        }
        if (hwRes < 0) {
            if (hwRes == -2) { return null; }
            byte[] ct = new byte[ctLen];
            if (ctLen > 0) { NativeMemory.Copy(ct, ctPtr, ctLen); }
            byte[] tag = new byte[16];
            NativeMemory.Copy(tag, tagPtr, 16);
            List<int> ok = new List<int>(); ok.Add(0);
            pt = AesGcm.Decrypt(this.key, 16, this.nonceBuf, this.aadBuf, 13, ct, ctLen, tag, ok);
            if (pt == null || ok[0] != -1) { return null; }
        }

        outContentType[0] = header[0] & 255;
        this.seq = this.seq + 1;
        return pt;
    }

    /* ---- TLS 1.3 记录层加解密 (RFC 8446 §5.2 / §5.3) ---- */

    public int EncryptTls13ToBuf(int contentType, nint dataPtr, int len, byte[] outBuf, int outOffset) {
        int innerLen = len + 1;
        int payloadLen = innerLen + 16;
        int totalRecLen = 5 + payloadLen;
        if (outOffset + totalRecLen > outBuf.Length) { return -1; }

        nint outPtr = (nint)outBuf + (nint)outOffset;

        // 1. 外部记录头 (5 字节)
        outBuf[outOffset + 0] = (byte)TlsRecord.ContentTypeApplicationData;  // 23
        outBuf[outOffset + 1] = 3;
        outBuf[outOffset + 2] = 3;
        outBuf[outOffset + 3] = (byte)((payloadLen >> 8) & 255);
        outBuf[outOffset + 4] = (byte)(payloadLen & 255);

        // 2. 将明文拷贝到内部明文位置 (outPtr + 5)，末尾追加 contentType
        nint ptPtr = outPtr + 5;
        if (len > 0 && dataPtr != 0) {
            NativeMemory.Copy(ptPtr, dataPtr, len);
        }
        outBuf[outOffset + 5 + len] = (byte)(contentType & 255);

        // 3. 构造 12 字节 Nonce: 12 字节 IV ^ (64 位大端 seq 放在低 8 字节)
        NativeMemory.Copy(this.nonceBuf, this.iv, 12);
        TlsRecord.WriteSeq64(this.seqBuf, 0, this.seq);
        for (int i = 0; i < 8; i = i + 1) {
            this.nonceBuf[4 + i] = (byte)((this.nonceBuf[4 + i] & 255) ^ (this.seqBuf[i] & 255));
        }

        // 4. AAD 即 5 字节外部记录头
        nint tagPtr = ptPtr + (nint)innerLen;

        long hwRes = -1;
        if (this.hasCtx) {
            hwRes = NativeMemory.AesGcmEncryptCtx(this.gcmCtx, this.nonceBuf, outPtr, 5, ptPtr, (long)innerLen, ptPtr, tagPtr);
        } else {
            hwRes = NativeMemory.AesGcmEncrypt(this.key, 128, this.nonceBuf, outPtr, 5, ptPtr, (long)innerLen, ptPtr, tagPtr);
        }
        if (hwRes < 0) {
            byte[] pt = new byte[innerLen];
            NativeMemory.Copy(pt, ptPtr, innerLen);
            byte[] tag = new byte[16];
            byte[] ct = AesGcm.Encrypt(this.key, 16, this.nonceBuf, outBuf, 5, pt, innerLen, tag);
            if (ct == null) { return -1; }
            NativeMemory.Copy(ptPtr, ct, innerLen);
            NativeMemory.Copy(tagPtr, tag, 16);
        }

        this.seq = this.seq + 1;
        return totalRecLen;
    }

    public byte[] DecryptTls13(byte[] header, byte[] payload, int pOffset, int pLen, List<int> outContentType) {
        // 负载结构: ct(ctLen) || tag(16)
        if (pLen < 17) { return null; }
        int ctLen = pLen - 16;

        // 1. 构造 12 字节 Nonce
        NativeMemory.Copy(this.nonceBuf, this.iv, 12);
        TlsRecord.WriteSeq64(this.seqBuf, 0, this.seq);
        for (int i = 0; i < 8; i = i + 1) {
            this.nonceBuf[4 + i] = (byte)((this.nonceBuf[4 + i] & 255) ^ (this.seqBuf[i] & 255));
        }

        // 2. 提取 ct 与 tag 指针并一体化解密
        nint ctPtr = (nint)payload + (nint)pOffset;
        nint tagPtr = ctPtr + (nint)ctLen;

        byte[] inner = this.decBuf;
        if (inner == null || inner.Length < ctLen) {
            inner = new byte[ctLen + 1024];
            this.decBuf = inner;
        }
        long hwRes = -1;
        if (this.hasCtx) {
            hwRes = NativeMemory.AesGcmDecryptCtx(this.gcmCtx, this.nonceBuf, header, 5, ctPtr, (long)ctLen, tagPtr, inner);
        } else {
            hwRes = NativeMemory.AesGcmDecrypt(this.key, 128, this.nonceBuf, header, 5, ctPtr, (long)ctLen, tagPtr, inner);
        }
        if (hwRes < 0) {
            if (hwRes == -2) { return null; }
            byte[] ct = new byte[ctLen];
            if (ctLen > 0) { NativeMemory.Copy(ct, ctPtr, ctLen); }
            byte[] tag = new byte[16];
            NativeMemory.Copy(tag, tagPtr, 16);
            List<int> ok = new List<int>(); ok.Add(0);
            byte[] decSoftware = AesGcm.Decrypt(this.key, 16, this.nonceBuf, header, 5, ct, ctLen, tag, ok);
            if (decSoftware == null || ok[0] != -1) { return null; }
            if (ctLen > 0) { NativeMemory.Copy(inner, decSoftware, ctLen); }
        }

        // 3. 剥离尾部填充 0x00，定位真实 ContentType
        int realTypeIdx = ctLen - 1;
        while (realTypeIdx >= 0 && (inner[realTypeIdx] & 255) == 0) {
            realTypeIdx = realTypeIdx - 1;
        }
        if (realTypeIdx < 0) { return null; }  // 全是 0x00，无真实 ContentType

        int realType = inner[realTypeIdx] & 255;
        outContentType[0] = realType;

        byte[] pt = new byte[realTypeIdx];
        if (realTypeIdx > 0) {
            NativeMemory.Copy(pt, inner, realTypeIdx);
        }

        this.seq = this.seq + 1;
        return pt;
    }
}
