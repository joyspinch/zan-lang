using System;

namespace System.Net.Tls;

public class TlsTranscript {
    public TlsByteWriter writer;

    public TlsTranscript() {
        this.writer = new TlsByteWriter();
    }

    public void Update(byte[] msg, int offset, int len) {
        this.writer.WriteBytes(msg, offset, len);
    }

    public void Update(byte[] msg) {
        if (msg == null) { return; }
        this.writer.WriteBytes(msg, 0, msg.Length);
    }

    public byte[] CurrentHash() {
        byte[] all = this.writer.ToArray();
        return Sha256.Hash(all, all.Length);
    }
}
