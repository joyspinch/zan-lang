using System;

namespace System.Net.Tls;

public class TlsByteWriter {
    public byte[] buf;
    public int head;
    public int len;

    public TlsByteWriter() {
        this.buf = new byte[256];
        this.head = 0;
        this.len = 0;
    }

    public void EnsureCap(int extra) {
        if (extra <= 0) { return; }
        if (extra > 1073741824 || this.len > 1073741824 - extra) { return; }
        int need = this.len + extra;
        // 如果尾部空间不够，但 head 前面积压了空隙，先原地位移滑动窗口
        if (this.head > 0 && this.head + need > this.buf.Length) {
            if (this.len > 0) {
                NativeMemory.Copy(this.buf, (nint)this.buf + (nint)this.head, this.len);
            }
            this.head = 0;
        }
        if (this.head + need <= this.buf.Length) { return; }
        int newCap = this.buf.Length;
        if (newCap < 256) { newCap = 256; }
        while (newCap < need && newCap < 1073741824) {
            if (newCap > 536870912) { newCap = 1073741824; break; }
            newCap = newCap * 2;
        }
        if (newCap < need) { newCap = need + 256; }
        byte[] n = new byte[newCap];
        if (this.len > 0) {
            NativeMemory.Copy(n, (nint)this.buf + (nint)this.head, this.len);
        }
        this.buf = n;
        this.head = 0;
    }

    public void WriteU8(int v) {
        this.EnsureCap(1);
        this.buf[this.head + this.len] = (byte)(v & 255);
        this.len = this.len + 1;
    }

    public void WriteU16(int v) {
        this.EnsureCap(2);
        int pos = this.head + this.len;
        this.buf[pos] = (byte)((v >> 8) & 255);
        this.buf[pos + 1] = (byte)(v & 255);
        this.len = this.len + 2;
    }

    public void WriteU24(int v) {
        this.EnsureCap(3);
        int pos = this.head + this.len;
        this.buf[pos] = (byte)((v >> 16) & 255);
        this.buf[pos + 1] = (byte)((v >> 8) & 255);
        this.buf[pos + 2] = (byte)(v & 255);
        this.len = this.len + 3;
    }

    public void WriteBytes(byte[] b, int offset, int count) {
        if (b == null || count <= 0 || offset < 0 || offset > b.Length || count > b.Length - offset) { return; }
        this.EnsureCap(count);
        if (this.head + this.len + count > this.buf.Length) { return; }
        NativeMemory.Copy((nint)this.buf + (nint)(this.head + this.len), (nint)b + (nint)offset, count);
        this.len = this.len + count;
    }

    public void WriteBytes(byte[] b) {
        if (b == null) { return; }
        this.WriteBytes(b, 0, b.Length);
    }

    public int Length() { return this.len; }
    public int Head() { return this.head; }
    public byte[] Buffer() { return this.buf; }

    public void Advance(int count) {
        if (count > 0 && count <= this.buf.Length - this.head - this.len) {
            this.len = this.len + count;
        }
    }

    public int PeekU8(int off) {
        if (off < 0 || off >= this.len) { return -1; }
        return (int)(this.buf[this.head + off] & 255);
    }

    public int PeekU16(int off) {
        if (off < 0 || off + 1 >= this.len) { return -1; }
        int pos = this.head + off;
        return ((int)(this.buf[pos] & 255) << 8) | (int)(this.buf[pos + 1] & 255);
    }

    public byte[] ToArray() {
        byte[] res = new byte[this.len];
        if (this.len > 0) {
            NativeMemory.Copy(res, (nint)this.buf + (nint)this.head, this.len);
        }
        return res;
    }

    public void RemovePrefix(int count) {
        if (count <= 0) { return; }
        if (count >= this.len) {
            this.head = 0;
            this.len = 0;
            return;
        }
        this.head = this.head + count;
        this.len = this.len - count;
        if (this.len == 0) {
            this.head = 0;
        }
    }
}
