using System;
using System.IO;
using System.Net.Sockets;
using System.Net.Http;
using System.Security.Cryptography;

namespace System.Net.Tls;

// 证书策略委托：客户端握手后若链/主机名校验不通过（verifyResult != 0），
// 以 (verifyResult, 对端证书文本) 调用；返回 true 放行本次连接，false 拒绝。
// 证书文本形如 "issuer=/CN=.../O=... subject=/CN=example.com"。
public delegate bool CertPolicyFn(long verifyResult, string certText);

// 纯 Zan 原生 TLS 上下文。
// 记录与握手无 OpenSSL 依赖；Windows 客户端系统信任经 Crypt32 SSL 链策略验证。
public class TlsStream : IDisposable {
    [DllImport("crt", EntryPoint = "zan_monotonic_us")]
    private static extern long MonotonicUs();

    TlsEngine engine;
    nint sock;
    bool open;
    HttpDeadlineToken watch;
    byte[] scratch;
    static int SCRATCH = 65536;

    byte[] pendingOut;
    int pendingLen;
    static string lastError = "";

    private static int Norm(int v) {
        if (v > 2147483647) { return v - 4294967296; }
        return v;
    }

    public static string LastError() {
        return TlsStream.lastError;
    }

    public static void SetLastError(string error) {
        TlsStream.lastError = error;
    }

    public static bool ValidReceiveRange(int bufferLength, int offset, int max) {
        return bufferLength >= 0 && offset >= 0 && max >= 0
            && offset <= bufferLength && max <= bufferLength - offset;
    }

    TlsStream() {
        this.engine = null;
        this.sock = -1;
        this.open = false;
        this.watch = null;
        this.scratch = null;
        this.pendingOut = null;
        this.pendingLen = 0;
    }

    private static TlsStream Setup(TlsContext ctx, nint sock, string host) {
        if (ctx == null) { TlsStream.SetLastError("TLS 上下文缺失"); return null; }
        #if !WINDOWS
        if (!ctx.server && ctx.verify && ctx.certPolicy == null
            && (ctx.trustedCerts == null || ctx.trustedCerts.Count == 0)) {
            TlsStream.SetLastError("TLS 系统信任根不可用；需显式 AddTrustedCert 配置 CA");
            return null;
        }
        #endif
        TlsStream s = new TlsStream();
        s.engine = new TlsEngine(host, !ctx.verify, ctx.disableTls13, ctx.pins, ctx.pinRequired, ctx.certPolicy, ctx.trustedCerts, ctx.server, ctx.certFile, ctx.keyFile);
        s.engine.SetCredentials(ctx.cachedCert, ctx.cachedKey, ctx.cachedEcKey);
        s.engine.SetCertChain(ctx.cachedChain);
        s.sock = sock;
        s.scratch = new byte[SCRATCH + 1];
        s.open = true;
        return s;
    }

    // 服务器端：接受客户端连接并执行 TLS 握手。
    public static async TlsStream AcceptAsync(TlsContext ctx, nint sock) {
        return await TlsStream.AcceptAsync(ctx, sock, 30000);
    }

    public static async TlsStream AcceptAsync(TlsContext ctx, nint sock, int timeoutMs) {
        TlsStream s = Setup(ctx, sock, "");
        if (s == null) { return null; }
        int ok = await s.HandshakeAsync(timeoutMs);
        if (ok != 1) {
            s.Close();
            return null;
        }
        return s;
    }

    // 客户端：连接对端服务器并执行 TLS 握手。
    public static async TlsStream ConnectAsync(TlsContext ctx, nint sock, string host) {
        return await TlsStream.ConnectAsync(ctx, sock, host, 30000);
    }

    public static async TlsStream ConnectAsync(TlsContext ctx, nint sock, string host, int timeoutMs) {
        TlsStream.SetLastError("");
        TlsStream s = Setup(ctx, sock, host);
        if (s == null) {
            if (TlsStream.LastError() == "") { TlsStream.SetLastError("TLS 引擎初始化失败"); }
            return null;
        }

        s.engine.StartHandshake();
        int ok = await s.HandshakeAsync(timeoutMs);
        if (ok != 1) {
            if (TlsStream.LastError() == "") {
                TlsStream.SetLastError(s.engine.LastError());
            }
            s.Close();
            return null;
        }
        return s;
    }

    // 分步握手（传输封装协议，如 MS-TDS）

    public static TlsStream ConnectStepped(TlsContext ctx, nint sock, string host) {
        TlsStream.SetLastError("");
        TlsStream s = TlsStream.SetupStepped(ctx, sock, host);
        if (s == null) {
            if (TlsStream.LastError() == "") { TlsStream.SetLastError("TLS 引擎初始化失败"); }
            return null;
        }
        s.engine.StartHandshake();
        return s;
    }

    public static TlsStream AcceptStepped(TlsContext ctx, nint sock) {
        TlsStream.SetLastError("");
        TlsStream s = TlsStream.SetupStepped(ctx, sock, "");
        if (s == null) {
            if (TlsStream.LastError() == "") { TlsStream.SetLastError("TLS 引擎初始化失败"); }
            return null;
        }
        return s;
    }

    private static TlsStream SetupStepped(TlsContext ctx, nint sock, string host) {
        TlsStream s = Setup(ctx, sock, host);
        if (s == null) { return null; }
        s.pendingOut = new byte[SCRATCH * 2 + 1];
        s.pendingLen = 0;
        return s;
    }

    int HandshakePump() {
        if (!this.open || this.engine == null) { return -1; }
        int r = this.engine.Step();
        byte[] pending = this.engine.DrainNetwork();
        if (pending != null && pending.Length > 0) {
            this.EnsurePending(pending.Length);
            NativeMemory.Copy((nint)this.pendingOut + (nint)this.pendingLen, pending, pending.Length);
            this.pendingLen = this.pendingLen + pending.Length;
        }
        if (r == 1) { return 1; }
        if (r < 0) { return -1; }
        return 0;
    }

    string HandshakeDrain() {
        if (this.pendingOut == null || this.pendingLen <= 0) { return ""; }
        string out1 = this.pendingOut.ToStr(0, this.pendingLen);
        this.pendingLen = 0;
        return out1;
    }

    void HandshakeFeed(string data) {
        if (data == null || data.Length == 0 || !this.open || this.engine == null) { return; }
        byte[] b = new byte[data.Length];
        NativeMemory.Copy(b, data, data.Length);
        this.engine.FeedNetwork(b, 0, b.Length);
    }

    void EnsurePending(int extra) {
        if (this.pendingOut == null) {
            this.pendingOut = new byte[extra + 256];
            this.pendingLen = 0;
            return;
        }
        if (this.pendingLen + extra <= this.pendingOut.Length) { return; }
        int size = this.pendingOut.Length * 2;
        while (this.pendingLen + extra > size) { size = size * 2; }
        byte[] nb = new byte[size + 1];
        if (this.pendingLen > 0) {
            NativeMemory.Copy(nb, this.pendingOut, this.pendingLen);
        }
        this.pendingOut = nb;
    }

    // 获取当前连接对端证书的描述文本（形如 issuer=... subject=...）。
    string PeerCertificateText() {
        if (this.engine == null) { return ""; }
        return this.engine.PeerCertificateText();
    }

    private static string SpkiPinOf(TlsStream stream) {
        if (stream == null || stream.engine == null) { return ""; }
        X509Certificate cert = stream.engine.PeerCertificate();
        if (cert == null) { return ""; }
        return cert.SpkiSha256Pin();
    }

    async int FlushOutAsync() {
        if (!this.open || this.engine == null) { return -1; }
        while (this.engine.OutNetLength() > 0) {
            int toSend = this.engine.OutNetLength();
            int sent = Norm(await Socket.SendBytesAsync(
                this.sock,
                this.engine.OutNetBuffer(),
                this.engine.OutNetHead(),
                toSend
            ));
            if (!this.open) { return -1; }
            if (sent <= 0) { return -1; }
            this.engine.DropOutNet(sent);
        }
        return 0;
    }

    async int PumpInAsync() {
        if (!this.open || this.engine == null) { return -1; }
        int n = await Socket.RecvBytesAsync(this.sock, this.scratch, SCRATCH);
        if (n < 0) { return -1; }
        if (n == 0) { return 0; }
        this.engine.FeedNetwork(this.scratch, 0, n);
        return n;
    }

    async int HandshakeAsync(int timeoutMs) {
        if (timeoutMs > 0) {
            this.watch = HttpDeadline.Arm(this.sock, timeoutMs);
        }
        long deadlineUs = 0;
        if (timeoutMs > 0) { deadlineUs = MonotonicUs() + (long)timeoutMs * 1000; }

        while (true) {
            int flushed = await this.FlushOutAsync();
            if (flushed < 0) { return this.EndHandshakeWatch(-1); }

            int r = this.engine.Step();
            flushed = await this.FlushOutAsync();
            if (flushed < 0) { return this.EndHandshakeWatch(-1); }

            if (r == 1) { return this.EndHandshakeWatch(1); }
            if (r < 0) {
                TlsStream.SetLastError(this.engine.LastError());
                return this.EndHandshakeWatch(-1);
            }
            if (timeoutMs > 0 && MonotonicUs() >= deadlineUs) {
                TlsStream.SetLastError("TLS 握手超时");
                return this.EndHandshakeWatch(-2);
            }

            int n = await this.PumpInAsync();
            if (n <= 0) {
                if (n == 0) { TlsStream.SetLastError("对端在握手期间关闭了连接"); }
                return this.EndHandshakeWatch(-1);
            }
        }
        return -1;
    }

    int EndHandshakeWatch(int result) {
        HttpDeadline.Disarm(this.watch);
        this.watch = null;
        return result;
    }

    // 接收解密后的应用字节（最多 max）。正常关闭或出错时返回空串。
    async string RecvAsync(int max) {
        return await this.RecvAppDataAsync(max);
    }

    // 带总时限的接收：整个读取过程共享一个绝对截止时间（不按块续期）。
    // 上游永久挂起时截止时间一到，HttpDeadline 清扫器会挂断套接字，
    // 阻塞中的读被唤醒成 0 字节，读取循环自然结束并返回空串——
    // 调用方不会因对端沉默而永远等下去。
    // timeoutMs <= 0 表示不设时限，等价于无超时重载。
    public async string RecvAsync(int max, int timeoutMs) {
        if (timeoutMs <= 0) { return await this.RecvAsync(max); }
        if (!this.open || this.engine == null || max <= 0) { return ""; }
        // 武装令牌复用 this.watch：Close() 里的 Disarm 因此仍能兜住
        // 读协程被异常展开、来不及走 finally 的情况。
        this.watch = HttpDeadline.Arm(this.sock, timeoutMs);
        try {
            return await this.RecvAppDataAsync(max);
        } finally {
            HttpDeadline.Disarm(this.watch);
            this.watch = null;
        }
    }

    // 读取解密后的应用字节直到有数据或连接结束。
    // 有无超时两个重载共用这一份循环，避免两条路径在语义上分叉。
    async string RecvAppDataAsync(int max) {
        if (!this.open || this.engine == null || max <= 0) { return ""; }
        int want = max;
        if (want > SCRATCH) { want = SCRATCH; }

        while (true) {
            int step = this.engine.Step();
            if (step < 0) { return ""; }

            int avail = this.engine.AvailableAppData();
            if (avail > 0) {
                int toRead = avail > want ? want : avail;
                byte[] b = new byte[toRead];
                int read = this.engine.RecvAppData(b, 0, toRead);
                if (read > 0) {
                    return b.ToStr(0, read);
                }
            }

            if (this.engine.IsClosed()) { return ""; }

            int flushed = await this.FlushOutAsync();
            if (flushed < 0) { return ""; }

            int got = await this.PumpInAsync();
            if (got <= 0) { return ""; }
        }
        return "";
    }

    // 接收解密后的字节到调用方提供的缓冲区。正常关闭返回 0，出错返回 -1。
    async int RecvIntoAsync(string buf, int max) {
        if (!this.open || this.engine == null || buf == null || max < 0) { return -1; }
        if (max == 0) { return 0; }
        while (true) {
            int step = this.engine.Step();
            if (step < 0) { return -1; }

            int avail = this.engine.AvailableAppData();
            if (avail > 0) {
                int toRead = avail > max ? max : avail;
                int read = this.engine.RecvAppData(buf, 0, toRead);
                if (read > 0) {
                    return read;
                }
            }

            if (this.engine.IsClosed()) { return 0; }

            int flushed = await this.FlushOutAsync();
            if (flushed < 0) { return -1; }

            int got = await this.PumpInAsync();
            if (got == 0) { return 0; }
            if (got < 0) { return -1; }
        }
        return -1;
    }

    // 接收解密后的字节到调用方提供的字节数组。正常关闭返回 0，出错返回 -1。
    async int RecvBytesAsync(byte[] buf, int offset, int max) {
        if (!this.open || this.engine == null || buf == null) { return -1; }
        if (!TlsStream.ValidReceiveRange(buf.Length, offset, max)) { return -1; }
        if (max == 0) { return 0; }
        while (true) {
            int step = this.engine.Step();
            if (step < 0) { return -1; }

            int avail = this.engine.AvailableAppData();
            if (avail > 0) {
                int toRead = avail > max ? max : avail;
                int read = this.engine.RecvAppData(buf, offset, toRead);
                if (read > 0) {
                    return read;
                }
            }

            if (this.engine.IsClosed()) { return 0; }

            int flushed = await this.FlushOutAsync();
            if (flushed < 0) { return -1; }

            int got = await this.PumpInAsync();
            if (got == 0) { return 0; }
            if (got < 0) { return -1; }
        }
        return -1;
    }

    // 加密并发送 len 字节字符串数据。零中间分配直达底层网络缓冲。成功返回明文字节数，失败返回 -1。
    public async int SendAsync(string data, int len) {
        if (!this.open || this.engine == null) { return -1; }
        int r = this.engine.SendAppData(data, 0, len);
        if (r < 0) { return -1; }
        int flushed = await this.FlushOutAsync();
        if (flushed < 0) { return -1; }
        return len;
    }

    // 加密并发送字节数组前 len 字节。零中间分配直达底层网络缓冲。成功返回明文字节数，失败返回 -1。
    public async int SendAsync(byte[] data, int len) {
        return await this.SendBytesAsync(data, 0, len);
    }

    // 加密并发送字节数组前 len 字节。零中间分配直达底层网络缓冲。成功返回明文字节数，失败返回 -1。
    public async int SendBytesAsync(byte[] data, int len) {
        return await this.SendBytesAsync(data, 0, len);
    }

    // 加密并发送字节数组切片。零中间分配直达底层网络缓冲。成功返回明文字节数，失败返回 -1。
    public async int SendBytesAsync(byte[] data, int offset, int len) {
        if (!this.open || this.engine == null) { return -1; }
        int r = this.engine.SendAppData(data, offset, len);
        if (r < 0) { return -1; }
        int flushed = await this.FlushOutAsync();
        if (flushed < 0) { return -1; }
        return len;
    }

    // 加密并发送完整字节数组。
    public async int SendBytesAsync(byte[] data) {
        if (data == null) { return -1; }
        return await this.SendBytesAsync(data, 0, data.Length);
    }

    // 发送整个字符串（其 .Length 个字节）。
    public async int SendStringAsync(string data) {
        return await SendAsync(data, data.Length);
    }

    // 关闭 TLS 连接。
    public void Close() {
        HttpDeadline.Disarm(this.watch);
        this.watch = null;
        this.open = false;
        this.engine = null;
    }

    public void Dispose() {
        this.Close();
    }
}
