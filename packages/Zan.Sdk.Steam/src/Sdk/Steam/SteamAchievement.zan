using System;
using System.Json;

namespace Sdk.Steam;

// GetSchemaForGame 返回的单条成就定义。
public class SteamAchievement {
    public string Name;
    public string DisplayName;
    public string Description;
    public bool Hidden;
    public string Icon;
    public string IconGray;

    public SteamAchievement(string name, string displayName, string description,
                     bool hidden, string icon, string iconGray) {
        this.Name = name;
        this.DisplayName = displayName;
        this.Description = description;
        this.Hidden = hidden;
        this.Icon = icon;
        this.IconGray = iconGray;
    }

    public static SteamAchievement From(JsonValue v) {
        return new SteamAchievement(
            v.Str("name", ""),
            v.Str("displayName", ""),
            v.Str("description", ""),
            v.Int("hidden", 0) != 0,
            v.Str("icon", ""),
            v.Str("icongray", ""));
    }
}
