using System;
using System.Json;

namespace Sdk.Steam;

/// <summary>
/// GetSchemaForGame 返回的单条成就定义。
/// </summary>
class SteamAchievement {
    /// <summary>成就的 API 名称（SetAchievement / 探针统计用）。</summary>
    public string Name;

    /// <summary>展示名称。</summary>
    public string DisplayName;

    /// <summary>描述；隐藏成就未解锁时 Steam 可能不给。</summary>
    public string Description;

    /// <summary>1 = 解锁前隐藏。</summary>
    public bool Hidden;

    /// <summary>解锁后的图标 URL。</summary>
    public string Icon;

    /// <summary>未解锁的灰色图标 URL。</summary>
    public string IconGray;

    SteamAchievement(string name, string displayName, string description,
                     bool hidden, string icon, string iconGray) {
        this.Name = name;
        this.DisplayName = displayName;
        this.Description = description;
        this.Hidden = hidden;
        this.Icon = icon;
        this.IconGray = iconGray;
    }

    /// <summary>从 availableGameStats.achievements[] 的一个元素解析。</summary>
    static SteamAchievement From(JsonValue v) {
        bool hidden = false;
        JsonValue h = v.Get("hidden");
        if (h != null) { hidden = h.AsInt(0) != 0; }
        return new SteamAchievement(
            SteamAchievement.Text(v, "name"),
            SteamAchievement.Text(v, "displayName"),
            SteamAchievement.Text(v, "description"),
            hidden,
            SteamAchievement.Text(v, "icon"),
            SteamAchievement.Text(v, "icongray"));
    }

    static string Text(JsonValue v, string key) {
        JsonValue x = v.Get(key);
        if (x == null) { return ""; }
        return x.AsString("");
    }
}
