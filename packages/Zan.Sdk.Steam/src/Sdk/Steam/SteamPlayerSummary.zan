using System;
using System.Json;

namespace Sdk.Steam;

// GetPlayerSummaries 返回的单个玩家资料。
// 字段可用性取决于对方隐私设置：私密资料里 personastate 恒为 0，
// realname / timecreated / loccountrycode 等可选字段可能整体缺失，
// 一律用空串 / 0 / 1970 兜底，不做二次猜测。
class SteamPlayerSummary {
    // 64 位 SteamID（字符串形式）。
    public string SteamId;

    // 玩家昵称。
    public string PersonaName;

    // 资料页 URL。
    public string ProfileUrl;

    // 32x32 头像 URL。
    public string Avatar;

    // 184x184 头像 URL。
    public string AvatarFull;

    // 在线状态：0 离线 / 1 在线 / 2 忙碌 / 3 离开 / 4 打盹 / 5 想交易 / 6 想玩。
    public int PersonaState;

    // 资料可见性：3 公开，其余为受限（1 私密 / 2 好友可见等）。
    public int CommunityVisibilityState;

    // 最后一次离线的 Unix 时间（秒）；从未上线过为 0。
    public long LastLogOff;

    // 注册时间 Unix 时间（秒）；隐私受限时为 0。
    public long TimeCreated;

    // 正在游玩的游戏名（不在游戏中为空串）。
    public string GameExtraInfo;

    // 正在游玩的游戏 AppId（不在游戏中为 0）。
    public long GameId;

    // ISO 3166 国家码（未知为空串）。
    public string LocCountryCode;

    SteamPlayerSummary() {
        this.SteamId = "";
        this.PersonaName = "";
        this.ProfileUrl = "";
        this.Avatar = "";
        this.AvatarFull = "";
        this.PersonaState = 0;
        this.CommunityVisibilityState = 0;
        this.LastLogOff = 0;
        this.TimeCreated = 0;
        this.GameExtraInfo = "";
        this.GameId = 0;
        this.LocCountryCode = "";
    }

    // 从 players[] 的一个元素解析。
    static SteamPlayerSummary From(JsonValue v) {
        SteamPlayerSummary p = new SteamPlayerSummary();
        p.SteamId = SteamPlayerSummary.Text(v, "steamid");
        p.PersonaName = SteamPlayerSummary.Text(v, "personaname");
        p.ProfileUrl = SteamPlayerSummary.Text(v, "profileurl");
        p.Avatar = SteamPlayerSummary.Text(v, "avatar");
        p.AvatarFull = SteamPlayerSummary.Text(v, "avatarfull");
        p.PersonaState = SteamPlayerSummary.Num(v, "personastate");
        p.CommunityVisibilityState =
            SteamPlayerSummary.Num(v, "communityvisibilitystate");
        p.LastLogOff = SteamPlayerSummary.Num64(v, "lastlogoff");
        p.TimeCreated = SteamPlayerSummary.Num64(v, "timecreated");
        p.GameExtraInfo = SteamPlayerSummary.Text(v, "gameextrainfo");
        p.GameId = SteamPlayerSummary.Num64(v, "gameid");
        p.LocCountryCode = SteamPlayerSummary.Text(v, "loccountrycode");
        return p;
    }

    // Steam 对 64 位整数以字符串返回；数字/字符串两种形态都要接住。
    static string Text(JsonValue v, string key) {
        JsonValue x = v.Get(key);
        if (x == null) { return ""; }
        return x.AsString("");
    }

    static int Num(JsonValue v, string key) {
        JsonValue x = v.Get(key);
        if (x == null) { return 0; }
        return x.AsInt(0);
    }

    static long Num64(JsonValue v, string key) {
        JsonValue x = v.Get(key);
        if (x == null) { return 0; }
        return x.AsLong(0);
    }
}
