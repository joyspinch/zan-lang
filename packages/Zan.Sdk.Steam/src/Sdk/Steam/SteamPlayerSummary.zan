using System;
using System.Json;

namespace Sdk.Steam;

// GetPlayerSummaries 返回的单个玩家资料（缺失字段兜底为空串或 0）。
public class SteamPlayerSummary {
    public string SteamId;
    public string PersonaName;
    public string ProfileUrl;
    public string Avatar;
    public string AvatarFull;
    // 在线状态：0 离线 / 1 在线 / 2 忙碌 / 3 离开 / 4 打盹 / 5 想交易 / 6 想玩。
    public int PersonaState;
    // 资料可见性：3 公开，其余受限。
    public int CommunityVisibilityState;
    public long LastLogOff;
    public long TimeCreated;
    public string GameExtraInfo;
    public long GameId;
    public string LocCountryCode;

    public SteamPlayerSummary() {
        this.SteamId = "";
        this.PersonaName = "";
        this.ProfileUrl = "";
        this.Avatar = "";
        this.AvatarFull = "";
        this.PersonaState = 0;
        this.CommunityVisibilityState = 0;
        this.LastLogOff = 0;
        this.TimeCreated = 0;
        this.GameExtraInfo = "";
        this.GameId = 0;
        this.LocCountryCode = "";
    }

    public static SteamPlayerSummary From(JsonValue v) {
        SteamPlayerSummary p = new SteamPlayerSummary();
        if (v == null) { return p; }
        p.SteamId = v.Str("steamid", "");
        p.PersonaName = v.Str("personaname", "");
        p.ProfileUrl = v.Str("profileurl", "");
        p.Avatar = v.Str("avatar", "");
        p.AvatarFull = v.Str("avatarfull", "");
        p.PersonaState = v.Int("personastate", 0);
        p.CommunityVisibilityState = v.Int("communityvisibilitystate", 0);
        p.LastLogOff = v.Long("lastlogoff", 0);
        p.TimeCreated = v.Long("timecreated", 0);
        p.GameExtraInfo = v.Str("gameextrainfo", "");
        p.GameId = v.Long("gameid", 0);
        p.LocCountryCode = v.Str("loccountrycode", "");
        return p;
    }
}
