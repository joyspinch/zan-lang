using System;
using System.Json;

namespace Sdk.Steam;

/// <summary>
/// GetOwnedGames 返回的单款游戏。
/// </summary>
class SteamOwnedGame {
    /// <summary>AppId。</summary>
    public int AppId;

    /// <summary>游戏名（include_appinfo=false 或隐私受限时为空串）。</summary>
    public string Name;

    /// <summary>累计游玩分钟数。</summary>
    public int PlaytimeForeverMinutes;

    /// <summary>最近两周游玩分钟数；长期未玩缺失，为 0。</summary>
    public int Playtime2WeeksMinutes;

    /// <summary>最后一次游玩的 Unix 时间（秒）；旧响应或隐私受限时为 0。</summary>
    public long RTimeLastPlayed;

    SteamOwnedGame(int appId, string name, int playtimeForever,
                   int playtime2Weeks, long rtimeLastPlayed) {
        this.AppId = appId;
        this.Name = name;
        this.PlaytimeForeverMinutes = playtimeForever;
        this.Playtime2WeeksMinutes = playtime2Weeks;
        this.RTimeLastPlayed = rtimeLastPlayed;
    }

    /// <summary>从 response.games[] 的一个元素解析。</summary>
    static SteamOwnedGame From(JsonValue v) {
        return new SteamOwnedGame(
            SteamOwnedGame.Num(v, "appid"),
            SteamOwnedGame.Text(v, "name"),
            SteamOwnedGame.Num(v, "playtime_forever"),
            SteamOwnedGame.Num(v, "playtime_2weeks"),
            SteamOwnedGame.Num64(v, "rtime_last_played"));
    }

    static string Text(JsonValue v, string key) {
        JsonValue x = v.Get(key);
        if (x == null) { return ""; }
        return x.AsString("");
    }

    static int Num(JsonValue v, string key) {
        JsonValue x = v.Get(key);
        if (x == null) { return 0; }
        return x.AsInt(0);
    }

    static long Num64(JsonValue v, string key) {
        JsonValue x = v.Get(key);
        if (x == null) { return 0; }
        return x.AsLong(0);
    }
}
