using System;
using System.Json;

namespace Sdk.Steam;

// GetOwnedGames 返回的单款游戏。
public class SteamOwnedGame {
    public int AppId;
    public string Name;
    public int PlaytimeForeverMinutes;
    public int Playtime2WeeksMinutes;
    public long RTimeLastPlayed;

    public SteamOwnedGame(int appId, string name, int playtimeForever,
                   int playtime2Weeks, long rtimeLastPlayed) {
        this.AppId = appId;
        this.Name = name;
        this.PlaytimeForeverMinutes = playtimeForever;
        this.Playtime2WeeksMinutes = playtime2Weeks;
        this.RTimeLastPlayed = rtimeLastPlayed;
    }

    public static SteamOwnedGame From(JsonValue v) {
        return new SteamOwnedGame(
            v.Int("appid", 0),
            v.Str("name", ""),
            v.Int("playtime_forever", 0),
            v.Int("playtime_2weeks", 0),
            v.Long("rtime_last_played", 0));
    }
}
