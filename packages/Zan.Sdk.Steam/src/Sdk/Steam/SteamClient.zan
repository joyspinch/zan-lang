using System;
using System.Text;
using System.Json;
using System.Net;
using System.Net.Http;
using System.Net.Http.Client;
using System.Net.External;

namespace Sdk.Steam;

// Steamworks Web API（api.steampowered.com）客户端。
// 失败一律抛 SteamException；AuthenticateUserTicketAsync 须使用发行商 Web API key。
public class SteamClient {
    static string DEFAULT_HOST = "api.steampowered.com";
    static int DEFAULT_PORT = 443;

    string key;
    int appId;
    string host;
    int port;
    int timeoutMs;
    bool plainHttp;
    ExternalCallPolicy callPolicy;

    public SteamClient(string key, int appId) {
        this.key = key;
        this.appId = appId;
        this.host = SteamClient.DEFAULT_HOST;
        this.port = SteamClient.DEFAULT_PORT;
        this.timeoutMs = 30000;
        this.plainHttp = false;
        this.callPolicy = ExternalCallPolicy.Default();
    }

    // 仅关闭 TLS，目标仍受 ExternalCallPolicy 约束（本地回环须配 AllowLocalHttp）。
    public SteamClient PlainHttpMode() {
        this.plainHttp = true;
        return this;
    }

    public SteamClient Server(string host, int port) {
        this.host = host;
        this.port = port;
        return this;
    }

    public SteamClient Timeout(int ms) {
        this.timeoutMs = ms;
        return this;
    }

    public SteamClient WithCallPolicy(ExternalCallPolicy policy) {
        this.callPolicy = policy == null ? ExternalCallPolicy.Default() : policy;
        return this;
    }

    public ExternalCallPolicy CallPolicy() {
        return this.callPolicy;
    }

    // ---- ISteamUserStats ------------------------------------------------------

    // 查询当前在线人数（ISteamUserStats/GetNumberOfCurrentPlayers/v1，无需 key）。
    public async SteamResponse GetNumberOfCurrentPlayersAsync() {
        string path = "/ISteamUserStats/GetNumberOfCurrentPlayers/v1"
            + "?appid=" + Convert.ToString(this.appId);
        return await this.SendAsync("GET", path, "", "");
    }

    // 查询游戏成就与统计 Schema（ISteamUserStats/GetSchemaForGame/v2）。
    public async SteamResponse GetSchemaForGameAsync(string language) {
        string path = "/ISteamUserStats/GetSchemaForGame/v2"
            + "?key=" + Encoding.UrlEncode(this.key)
            + "&appid=" + Convert.ToString(this.appId);
        if (language.Length > 0) {
            path = path + "&l=" + Encoding.UrlEncode(language);
        }
        return await this.SendAsync("GET", path, "", "");
    }

    // 上报成就与统计（ISteamUserStats/SetUserStatsForGame/v1）；成就按 1/0 上报。
    public async SteamResponse SetUserStatsForGameAsync(JsonValue stats, int count) {
        if (stats == null || !stats.IsObject()) {
            throw new SteamException("client.paramError",
                "stats 必须是 JSON 对象，如 {\"achieved\":1}", "");
        }
        if (count <= 0) {
            throw new SteamException("client.paramError", "count 必须 > 0", "");
        }
        StringBuilder body = new StringBuilder();
        body.Append("key="); body.Append(Encoding.UrlEncode(this.key));
        body.Append("&appid="); body.Append(Convert.ToString(this.appId));
        int added = 0;
        for (int i = 0; i < stats.Count() && added < count; i = i + 1) {
            string name = stats.KeyAt(i);
            int value = stats.ValAt(i) != null ? stats.ValAt(i).AsInt(0) : 0;
            if (name.Length == 0) { continue; }
            body.Append("&stats["); body.Append(Encoding.UrlEncode(name));
            body.Append("]="); body.Append(Convert.ToString(value));
            added = added + 1;
        }
        return await this.SendAsync("POST", "/ISteamUserStats/SetUserStatsForGame/v1",
            body.ToString(), "application/x-www-form-urlencoded");
    }

    // ---- ISteamUser -----------------------------------------------------------

    // 批量查询玩家资料（ISteamUser/GetPlayerSummaries/v0002，单次上限 100）。
    public async SteamResponse GetPlayerSummariesAsync(List<string> steamIds) {
        if (steamIds == null || steamIds.Count == 0) {
            throw new SteamException("client.paramError", "steamIds 不能为空", "");
        }
        if (steamIds.Count > 100) {
            throw new SteamException("client.paramError",
                "steamIds 一次最多 100 个（Steam 限制）", "");
        }
        StringBuilder ids = new StringBuilder();
        for (int i = 0; i < steamIds.Count; i = i + 1) {
            if (i > 0) { ids.Append(","); }
            ids.Append(steamIds[i]);
        }
        string path = "/ISteamUser/GetPlayerSummaries/v0002"
            + "?key=" + Encoding.UrlEncode(this.key)
            + "&steamids=" + Encoding.UrlEncode(ids.ToString());
        return await this.SendAsync("GET", path, "", "");
    }

    // ---- ISteamUserAuth -------------------------------------------------------

    // 服务端校验客户端票据（ISteamUserAuth/AuthenticateUserTicket/v1，须发行商 key）。
    public async SteamTicketResult AuthenticateUserTicketAsync(string ticket,
                                                        string identity) {
        if (ticket.Length == 0) {
            throw new SteamException("client.paramError", "ticket 不能为空", "");
        }
        string body = "key=" + Encoding.UrlEncode(this.key)
            + "&appid=" + Convert.ToString(this.appId)
            + "&ticket=" + Encoding.UrlEncode(ticket);
        if (identity.Length > 0) {
            body = body + "&identity=" + Encoding.UrlEncode(identity);
        }
        SteamResponse resp = await this.SendAsync("POST",
            "/ISteamUserAuth/AuthenticateUserTicket/v1", body,
            "application/x-www-form-urlencoded");
        return SteamTicketResult.Parse(resp.Value);
    }

    // ---- IPlayerService -------------------------------------------------------

    // 查询玩家拥有的游戏（IPlayerService/GetOwnedGames/v0001）。
    public async SteamResponse GetOwnedGamesAsync(string steamId, bool includeAppInfo,
                                           bool includeFreeGames,
                                           List<int> appIds) {
        if (steamId.Length == 0) {
            throw new SteamException("client.paramError", "steamId 不能为空", "");
        }
        StringBuilder path = new StringBuilder();
        path.Append("/IPlayerService/GetOwnedGames/v0001?key=");
        path.Append(Encoding.UrlEncode(this.key));
        path.Append("&steamid="); path.Append(Encoding.UrlEncode(steamId));
        path.Append("&include_appinfo="); path.Append(includeAppInfo ? "1" : "0");
        path.Append("&include_played_free_games="); path.Append(includeFreeGames ? "1" : "0");
        if (appIds != null) {
            for (int i = 0; i < appIds.Count; i = i + 1) {
                path.Append("&appids_filter["); path.Append(Convert.ToString(i));
                path.Append("]="); path.Append(Convert.ToString(appIds[i]));
            }
        }
        return await this.SendAsync("GET", path.ToString(), "", "");
    }

    // ---- 便捷列表解析 ---------------------------------------------------------

    public async List<SteamPlayerSummary> GetPlayersAsync(List<string> steamIds) {
        SteamResponse resp = await this.GetPlayerSummariesAsync(steamIds);
        List<SteamPlayerSummary> players = new List<SteamPlayerSummary>();
        JsonValue arr = resp.Value.PathGet("response.players");
        if (arr == null || !arr.IsArray()) { return players; }
        for (int i = 0; i < arr.Count(); i = i + 1) {
            players.Add(SteamPlayerSummary.From(arr.At(i)));
        }
        return players;
    }

    public async List<SteamAchievement> GetAchievementsSchemaAsync(string language) {
        SteamResponse resp = await this.GetSchemaForGameAsync(language);
        List<SteamAchievement> items = new List<SteamAchievement>();
        JsonValue arr = resp.Value.PathGet("game.availableGameStats.achievements");
        if (arr == null || !arr.IsArray()) { return items; }
        for (int i = 0; i < arr.Count(); i = i + 1) {
            items.Add(SteamAchievement.From(arr.At(i)));
        }
        return items;
    }

    public async List<SteamOwnedGame> GetOwnedGameListAsync(string steamId,
                                                     bool includeAppInfo,
                                                     bool includeFreeGames) {
        SteamResponse resp = await this.GetOwnedGamesAsync(steamId,
            includeAppInfo, includeFreeGames, null);
        List<SteamOwnedGame> games = new List<SteamOwnedGame>();
        JsonValue arr = resp.Value.PathGet("response.games");
        if (arr == null || !arr.IsArray()) { return games; }
        for (int i = 0; i < arr.Count(); i = i + 1) {
            games.Add(SteamOwnedGame.From(arr.At(i)));
        }
        return games;
    }

    // ---- 传输 ------------------------------------------------------------------

    private async SteamResponse SendAsync(string method, string path,
                                          string body, string contentType) {
        try {
            using (HttpClient http = new HttpClient(this.host, this.port)) {
                if (!this.plainHttp) { http.UseTls(); }
                http.SetTimeout(this.timeoutMs);
                http.SetCallPolicy(this.callPolicy);
                if (contentType.Length > 0) {
                    http.SetHeader("Content-Type", contentType);
                }
                using (HttpResponse parsed = await http.SendAsync(method, path, body)) {
                    return SteamResponse.Parse(parsed.statusCode, parsed.body);
                }
            }
        } catch (SteamException e) {
            throw e;
        } catch (Exception e) {
            throw new SteamException("client.networkError", e.Message, "");
        }
    }
}
