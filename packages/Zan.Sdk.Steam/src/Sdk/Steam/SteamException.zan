using System;

namespace Sdk.Steam;

// Steam Web API 异常。Code 取值：client.paramError / client.networkError / client.badResponse / http.<status> / auth.<EResult>。
public class SteamException : Exception {
    public string Code;
    public string Body;

    public SteamException(string code, string message, string body) {
        this.Code = code;
        this.Body = body;
        Message = code + ": " + message;
    }
}
