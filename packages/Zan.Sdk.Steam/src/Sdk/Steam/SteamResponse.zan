using System;
using System.Json;

namespace Sdk.Steam;

// Steam Web API 响应；HTTP 非 2xx 或 JSON 非法时直接抛 SteamException。
public class SteamResponse {
    public string Data;
    public int StatusCode;
    public JsonValue Value;

    public SteamResponse(string data, int statusCode, JsonValue v) {
        this.Data = data;
        this.StatusCode = statusCode;
        this.Value = v;
    }

    public static SteamResponse Parse(int statusCode, string body) {
        string rawBody = body != null ? body : "";
        if (statusCode < 200 || statusCode >= 300) {
            throw new SteamException("http." + Convert.ToString(statusCode),
                "Steam Web API 返回 HTTP " + Convert.ToString(statusCode), rawBody);
        }
        JsonValue root = null;
        try {
            root = JsonValue.Parse(rawBody);
        } catch (Exception e) {
            throw new SteamException("client.badResponse", e != null && e.Message != null ? e.Message : "invalid json", rawBody);
        }
        if (root == null || !root.IsObject()) {
            throw new SteamException("client.badResponse",
                "响应不是合法的 JSON 对象", rawBody);
        }
        return new SteamResponse(root.ToJson(), statusCode, root);
    }

    public string Str(string path, string dflt) {
        if (this.Value == null) { return dflt; }
        return this.Value.PathStr(path, dflt);
    }

    public int Int(string path, int dflt) {
        if (this.Value == null) { return dflt; }
        return this.Value.PathInt(path, dflt);
    }

    public long Long(string path, long dflt) {
        if (this.Value == null) { return dflt; }
        JsonValue v = this.Value.PathGet(path);
        if (v == null) { return dflt; }
        // Steam 64 位整数常以字符串返回，同时兼容数字形态；非法串回落 dflt。
        if (v.IsString()) {
            long parsed = 0L;
            if (!long.TryParse(v.AsString(""), out parsed)) { return dflt; }
            return parsed;
        }
        return v.AsLong(dflt);
    }

    public bool Bool(string path, bool dflt) {
        if (this.Value == null) { return dflt; }
        JsonValue v = this.Value.PathGet(path);
        if (v == null) { return dflt; }
        return v.AsBool(dflt);
    }
}
