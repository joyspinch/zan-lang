using System;

namespace Zan.Mvc.Admin.Attributes;

/// <summary>
/// 声明细粒度权限需求特性。
/// 挂在 Controller 或 Action 上，未授权时拦截并返回 403。
/// </summary>
public class RequirePermissionAttribute : Attribute {
    public string Key { get; set; } = "";
    public string Title { get; set; } = "";

    public RequirePermissionAttribute(string key = "", string title = "") {
        this.Key = key;
        this.Title = title;
    }
}
