using System;

namespace Zan.Mvc.Admin.Attributes;

/// <summary>
/// 声明式后台操作与菜单特性。
/// 标记在 Action 方法上，指示该接口是否作为侧边栏可见菜单、排序权重、绑定的业务权限键。
/// </summary>
public class AdminActionAttribute : Attribute {
    public string Key { get; set; } = "";
    public string Title { get; set; } = "";
    public string Route { get; set; } = "";
    public bool IsMenu { get; set; } = false;
    public int Order { get; set; } = 100;
    public string Perm { get; set; } = "";

    public AdminActionAttribute(string key = "", string title = "", string route = "", bool isMenu = false, int order = 100, string perm = "") {
        this.Key = key;
        this.Title = title;
        this.Route = route;
        this.IsMenu = isMenu;
        this.Order = order;
        this.Perm = perm;
    }
}
