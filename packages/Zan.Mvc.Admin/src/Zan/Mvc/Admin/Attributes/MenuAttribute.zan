using System;

namespace Zan.Mvc.Admin.Attributes;

/// <summary>
/// 声明式菜单特性。
/// 可标记在 Controller 类（代表该控制器的根菜单项）或 Action 方法上，指示其在侧边栏中展示的标题、图标与排序权重。
/// </summary>
public class MenuAttribute : Attribute {
    public string Title { get; set; } = "";
    public string Icon { get; set; } = "file";
    public int Order { get; set; } = 100;
    public string Key { get; set; } = "";
    public bool IsMenu { get; set; } = true;

    public MenuAttribute(string title = "", string icon = "file", int order = 100, string key = "", bool isMenu = true) {
        this.Title = title;
        this.Icon = icon;
        this.Order = order;
        this.Key = key;
        this.IsMenu = isMenu;
    }
}
