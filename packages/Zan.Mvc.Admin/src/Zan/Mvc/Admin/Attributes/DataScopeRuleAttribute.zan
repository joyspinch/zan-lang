using System;

namespace Zan.Mvc.Admin.Attributes;

/// <summary>
/// 声明此查询受数据范围（部门/本人隔离）管控。
/// 挂在 Controller 或 Action 上，通知 BaseDao 自动注入所属部门或负责人限制。
/// </summary>
public class DataScopeRuleAttribute : Attribute {
    public string DeptColumn { get; set; } = "dept_id";
    public string OwnerColumn { get; set; } = "owner_id";

    public DataScopeRuleAttribute(string deptColumn = "dept_id", string ownerColumn = "owner_id") {
        this.DeptColumn = deptColumn;
        this.OwnerColumn = ownerColumn;
    }
}
