using System;

namespace Zan.Mvc.Admin.Attributes;

/// <summary>
/// 声明式后台业务模块特性。
/// 标记在 Controller 类上，指示其所属的管理中台业务分组、图标与排序权重。
/// 启动时由元数据扫描引擎自动收拢，免去手动注册。
/// </summary>
public class AdminModuleAttribute : Attribute {
    public string Key { get; set; } = "";
    public string Title { get; set; } = "";
    public string Icon { get; set; } = "grid";
    public int Order { get; set; } = 100;

    public AdminModuleAttribute(string key = "", string title = "", string icon = "grid", int order = 100) {
        this.Key = key;
        this.Title = title;
        this.Icon = icon;
        this.Order = order;
    }
}
