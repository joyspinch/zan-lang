using System;
using System.IO;
using System.Web;
using System.Data;
using System.Data.Sqlite;
using Zan.Mvc.Admin.Model;
using Zan.Mvc.Admin.Web;

namespace Zan.Mvc.Admin.Installer;

public class DbConfig {
    public string type;
    public string path;
    public DbConfig() {
        this.type = "sqlite";
        this.path = "data/app.db";
    }
}

public class AppSectionConfig {
    public string name;
    public bool installed;
    public AppSectionConfig() {
        this.name = "Zan Admin Platform";
        this.installed = true;
    }
}

public class AppConfigFile {
    public DbConfig db;
    public AppSectionConfig app;
    public AppConfigFile() {
        this.db = new DbConfig();
        this.app = new AppSectionConfig();
    }
}

/// <summary>
/// 安装向导 Web 控制器。
/// 首次启动提供多步骤配置与检测，执行完毕后写入 install.lock 触发全系统永久熔断。
/// 彻底废弃手写 JSON 拼装，全部由编译器强类型序列化驱动。
/// </summary>
public class InstallController : Controller {
    [HttpGet]
    [Route("/install")]
    public void Index() {
        if (InstallGateMiddleware.IsInstalled()) {
            this.Fail(404, "404", "系统已完成安装，安装向导已永久熔断关闭。");
            return;
        }

        string html = GetInstallerHtml();
        this.Html(html);
    }

    [HttpPost]
    [Route("/install/api/probe")]
    public void ApiProbe() {
        if (InstallGateMiddleware.IsInstalled()) {
            this.Fail(403, "403", "已安装");
            return;
        }

        SystemProbeResult probe = SystemProbe.Check();
        this.Json(Json.Serialize<SystemProbeResult>(probe));
    }

    [HttpPost]
    [Route("/install/api/submit")]
    public void ApiSubmit() {
        if (InstallGateMiddleware.IsInstalled()) {
            this.Fail(403, "403", "已安装");
            return;
        }

        string dbPath = this.In("dbPath");
        if (dbPath.Length == 0) {
            dbPath = "data/app.db";
        }
        string adminUser = this.In("adminUser");
        if (adminUser.Length == 0) {
            adminUser = "admin";
        }
        string adminPass = this.In("adminPass");
        if (adminPass.Length < 6) {
            this.SendJson("9999", "管理员密码长度不能小于 6 位");
            return;
        }

        // 确保目录存在
        string dir = Path.GetDirectoryName(dbPath);
        if (dir.Length > 0 && !Directory.Exists(dir)) {
            Directory.CreateDirectory(dir);
        }

        try {
            SqliteConnection conn = SqliteConnection.Open(dbPath);
            if (!conn.IsConnected()) {
                this.SendJson("9999", "打开数据库失败: " + dbPath);
                return;
            }
            string err;
            bool ok = SchemaMigrator.ExecuteInstall(conn, adminUser, adminPass, out err);
            conn.Close();
            if (!ok) {
                this.SendJson("9999", "DDL 执行失败: " + err);
                return;
            }

            // 写入配置文件（强类型 DTO 编译器自动序列化）
            if (!Directory.Exists("config")) {
                Directory.CreateDirectory("config");
            }
            AppConfigFile cfg = new AppConfigFile();
            cfg.db.path = dbPath.Replace("\\", "/");
            cfg.app.installed = true;

            File.WriteAllText("config/app.json", Json.Serialize<AppConfigFile>(cfg));

            // 写入 install.lock 物理安全锁
            string lockContent = "Installed at " + DateTime.UtcNow().ToString() + " by " + adminUser + "\n";
            File.WriteAllText(InstallGateMiddleware.LOCK_FILE, lockContent);

            this.SendJson("0000", "安装成功！");
        } catch (Exception ex) {
            this.SendJson("9999", "安装异常: " + ex.Message);
        }
    }

    private void SendJson(string code, string msg) {
        ApiResponse resp = new ApiResponse();
        resp.code = code;
        resp.msg = msg;
        this.Json(Json.Serialize<ApiResponse>(resp));
    }

    private string GetInstallerHtml() {
        return "<!DOCTYPE html><html lang=\"zh-CN\"><head><meta charset=\"UTF-8\"><title>系统初始安装向导</title>"
            + "<style>"
            + "body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#0f172a;color:#f8fafc;display:flex;justify-content:center;align-items:center;min-height:100vh;margin:0;}"
            + ".box{background:#1e293b;border:1px solid #334155;border-radius:12px;padding:32px;width:100%;max-width:540px;box-shadow:0 10px 25px rgba(0,0,0,0.5);}"
            + "h1{font-size:22px;margin-bottom:8px;color:#38bdf8;}"
            + "p{color:#94a3b8;font-size:13px;line-height:1.6;}"
            + ".item{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid #334155;font-size:14px;}"
            + ".tag-ok{color:#34d399;font-weight:600;}"
            + ".input-group{margin:16px 0;display:flex;flex-direction:column;gap:6px;}"
            + "label{font-size:13px;color:#cbd5e1;}"
            + "input{background:#0f172a;border:1px solid #475569;border-radius:6px;padding:8px 12px;color:#fff;font-size:14px;}"
            + "button{background:#3b82f6;color:#fff;border:none;border-radius:6px;padding:10px 16px;font-size:14px;font-weight:600;cursor:pointer;margin-top:12px;width:100%;}"
            + "button:hover{background:#2563eb;}"
            + "</style></head><body>"
            + "<div class=\"box\">"
            + "<h1>🚀 系统初始安装向导</h1>"
            + "<p>检测到系统未完成初始配置。完成以下向导即可自动初始化系统 Schema、管理员凭据与安全熔断锁。</p>"
            + "<div id=\"step1\">"
            + "<h3>第一步：基础设施探针</h3>"
            + "<div id=\"probeList\">正在检测环境...</div>"
            + "<button id=\"btnNext\" style=\"display:none\" onclick=\"goStep2()\">下一步：配置参数</button>"
            + "</div>"
            + "<div id=\"step2\" style=\"display:none;\">"
            + "<h3>第二步：初始化管理员与数据库</h3>"
            + "<div class=\"input-group\"><label>数据库存储路径 (SQLite)</label><input id=\"dbPath\" value=\"data/app.db\" /></div>"
            + "<div class=\"input-group\"><label>初始管理员账号</label><input id=\"adminUser\" value=\"admin\" /></div>"
            + "<div class=\"input-group\"><label>初始管理员密码 (>= 6位)</label><input id=\"adminPass\" type=\"password\" value=\"admin123\" /></div>"
            + "<button onclick=\"submitInstall()\">确认安装并锁定</button>"
            + "</div>"
            + "</div>"
            + "<script>"
            + "fetch('/install/api/probe', {method:'POST'}).then(r=>r.json()).then(res=>{"
            + "  let el = document.getElementById('probeList'); el.innerHTML='';"
            + "  (res.items || []).forEach(it=>{"
            + "    el.innerHTML += '<div class=\"item\"><span>'+it.name+'</span><span class=\"tag-ok\">'+it.current+'</span></div>';"
            + "  });"
            + "  if(res.allPassed) document.getElementById('btnNext').style.display='block';"
            + "});"
            + "function goStep2(){ document.getElementById('step1').style.display='none'; document.getElementById('step2').style.display='block'; }"
            + "function submitInstall(){"
            + "  let p = new URLSearchParams();"
            + "  p.append('dbPath', document.getElementById('dbPath').value);"
            + "  p.append('adminUser', document.getElementById('adminUser').value);"
            + "  p.append('adminPass', document.getElementById('adminPass').value);"
            + "  fetch('/install/api/submit', {method:'POST', body:p}).then(r=>r.json()).then(res=>{"
            + "    if(res.code==='0000'){ alert('初始化安装成功！正在重定向到后台登录页...'); window.location.href='/admin/login'; }"
            + "    else { alert('安装失败: '+res.msg); }"
            + "  });"
            + "}"
            + "</script></body></html>";
    }
}
