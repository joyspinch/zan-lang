using System;
using System.IO;
using System.Web;
using System.Data;
using System.Data.Sqlite;
using Zan.Mvc.Admin.Model;
using Zan.Mvc.Admin.Web;
using Zan.Mvc.Admin.UI;

namespace Zan.Mvc.Admin.Installer;

public class DbConfig {
    public string type;
    public string path;
    public DbConfig() {
        this.type = "sqlite";
        this.path = "data/app.db";
    }
}

public class AppSectionConfig {
    public string name;
    public bool installed;
    public AppSectionConfig() {
        this.name = "Zan Admin Platform";
        this.installed = true;
    }
}

public class AppConfigFile {
    public DbConfig db;
    public AppSectionConfig app;
    public AppConfigFile() {
        this.db = new DbConfig();
        this.app = new AppSectionConfig();
    }
}

/// <summary>
/// 安装向导 Web 控制器。
/// 首次启动提供多步骤配置与检测，执行完毕后写入 install.lock 触发全系统永久熔断。
/// 彻底废弃手写 JSON 拼装，全部由编译器强类型序列化驱动。
/// </summary>
public class InstallController : Controller {
    [HttpGet]
    [Route("/install")]
    public void Index() {
        if (InstallGateMiddleware.IsInstalled()) {
            this.Fail(404, "404", "系统已完成安装，安装向导已永久熔断关闭。");
            return;
        }

        string html = AdminViewEngine.Render("Install.html");
        this.Html(html);
    }

    [HttpPost]
    [Route("/install/api/probe")]
    public void ApiProbe() {
        if (InstallGateMiddleware.IsInstalled()) {
            this.Fail(403, "403", "已安装");
            return;
        }

        SystemProbeResult probe = SystemProbe.Check();
        this.Json(Json.Serialize<SystemProbeResult>(probe));
    }

    [HttpPost]
    [Route("/install/api/submit")]
    public void ApiSubmit() {
        if (InstallGateMiddleware.IsInstalled()) {
            this.Fail(403, "403", "已安装");
            return;
        }

        string dbPath = this.In("dbPath");
        if (dbPath.Length == 0) {
            dbPath = "data/app.db";
        }
        string adminUser = this.In("adminUser");
        if (adminUser.Length == 0) {
            adminUser = "admin";
        }
        string adminPass = this.In("adminPass");
        if (adminPass.Length < 6) {
            this.SendJson("9999", "管理员密码长度不能小于 6 位");
            return;
        }

        // 确保目录存在
        string dir = Path.GetDirectoryName(dbPath);
        if (dir.Length > 0 && !Directory.Exists(dir)) {
            Directory.CreateDirectory(dir);
        }

        try {
            SqliteConnection conn = SqliteConnection.Open(dbPath);
            if (!conn.IsConnected()) {
                this.SendJson("9999", "打开数据库失败: " + dbPath);
                return;
            }
            string err;
            bool ok = SchemaMigrator.ExecuteInstall(conn, adminUser, adminPass, out err);
            conn.Close();
            if (!ok) {
                this.SendJson("9999", "DDL 执行失败: " + err);
                return;
            }

            // 写入配置文件（强类型 DTO 编译器自动序列化）
            if (!Directory.Exists("config")) {
                Directory.CreateDirectory("config");
            }
            AppConfigFile cfg = new AppConfigFile();
            cfg.db.path = dbPath.Replace("\\", "/");
            cfg.app.installed = true;

            File.WriteAllText("config/app.json", Json.Serialize<AppConfigFile>(cfg));

            // 写入 install.lock 物理安全锁
            string lockContent = "Installed at " + DateTime.UtcNow().ToString() + " by " + adminUser + "\n";
            File.WriteAllText(InstallGateMiddleware.LOCK_FILE, lockContent);

            this.SendJson("0000", "安装成功！");
        } catch (Exception ex) {
            this.SendJson("9999", "安装异常: " + ex.Message);
        }
    }

    private void SendJson(string code, string msg) {
        ApiResponse resp = new ApiResponse();
        resp.code = code;
        resp.msg = msg;
        this.Json(Json.Serialize<ApiResponse>(resp));
    }
}
