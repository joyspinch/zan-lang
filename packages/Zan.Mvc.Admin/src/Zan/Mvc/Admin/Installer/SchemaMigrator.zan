using System;
using System.Data;
using System.Text;
using System.Collections.Generic;

namespace Zan.Mvc.Admin.Installer;

/// <summary>
/// 安装向导 DDL 迁移器与初始数据装载引擎。
/// 执行 4 字节对齐、窄定长主记录标准表结构建表与超管账号注入。
/// </summary>
public class SchemaMigrator {
    /// <summary>
    /// 获取平台标准基础 DDL 脚本。
    /// 涵盖用户、角色、部门、权限规则、审计日志。
    /// </summary>
    public static List<string> GetCoreTableSqls() {
        List<string> sqls = new List<string>();

        // 1. 用户表（窄定长核心凭据）
        sqls.Add("CREATE TABLE IF NOT EXISTS sys_users ("
            + "id INTEGER PRIMARY KEY AUTOINCREMENT, "
            + "username VARCHAR(64) NOT NULL UNIQUE, "
            + "password_hash VARCHAR(128) NOT NULL, "
            + "nickname VARCHAR(64) NOT NULL, "
            + "department_id INTEGER NOT NULL DEFAULT 0, "
            + "status INTEGER NOT NULL DEFAULT 1, "
            + "is_super INTEGER NOT NULL DEFAULT 0, "
            + "created_at INTEGER NOT NULL DEFAULT 0, "
            + "updated_at INTEGER NOT NULL DEFAULT 0);");

        // 2. 角色表（挂载数据范围）
        sqls.Add("CREATE TABLE IF NOT EXISTS sys_roles ("
            + "id INTEGER PRIMARY KEY AUTOINCREMENT, "
            + "name VARCHAR(64) NOT NULL, "
            + "key VARCHAR(64) NOT NULL UNIQUE, "
            + "data_scope INTEGER NOT NULL DEFAULT 1, "
            + "status INTEGER NOT NULL DEFAULT 1);");

        // 3. 部门表（预扁平化路径支持）
        sqls.Add("CREATE TABLE IF NOT EXISTS sys_departments ("
            + "id INTEGER PRIMARY KEY AUTOINCREMENT, "
            + "parent_id INTEGER NOT NULL DEFAULT 0, "
            + "name VARCHAR(64) NOT NULL, "
            + "tree_path VARCHAR(255) NOT NULL DEFAULT '', "
            + "order_num INTEGER NOT NULL DEFAULT 100);");

        // 4. 权限规则与菜单字典表
        sqls.Add("CREATE TABLE IF NOT EXISTS sys_rules ("
            + "id INTEGER PRIMARY KEY AUTOINCREMENT, "
            + "parent_id INTEGER NOT NULL DEFAULT 0, "
            + "key VARCHAR(128) NOT NULL UNIQUE, "
            + "title VARCHAR(128) NOT NULL, "
            + "route VARCHAR(255) NOT NULL DEFAULT '', "
            + "method VARCHAR(16) NOT NULL DEFAULT 'GET', "
            + "is_menu INTEGER NOT NULL DEFAULT 0, "
            + "icon VARCHAR(64) NOT NULL DEFAULT 'grid', "
            + "order_num INTEGER NOT NULL DEFAULT 100);");

        // 5. 角色-规则关联表
        sqls.Add("CREATE TABLE IF NOT EXISTS sys_role_rule ("
            + "role_id INTEGER NOT NULL, "
            + "rule_id INTEGER NOT NULL, "
            + "PRIMARY KEY(role_id, rule_id));");

        // 6. 用户-角色关联表
        sqls.Add("CREATE TABLE IF NOT EXISTS sys_user_role ("
            + "user_id INTEGER NOT NULL, "
            + "role_id INTEGER NOT NULL, "
            + "PRIMARY KEY(user_id, role_id));");

        // 7. 操作审计日志表
        sqls.Add("CREATE TABLE IF NOT EXISTS sys_operation_logs ("
            + "id INTEGER PRIMARY KEY AUTOINCREMENT, "
            + "admin_id INTEGER NOT NULL, "
            + "action VARCHAR(64) NOT NULL, "
            + "detail TEXT, "
            + "ip VARCHAR(45) NOT NULL DEFAULT '', "
            + "created_at INTEGER NOT NULL DEFAULT 0);");

        return sqls;
    }

    /// <summary>
    /// 执行建表与初始化超管角色和用户。
    /// </summary>
    public static bool ExecuteInstall(IDbConnection conn, string adminUser, string adminPassword, out string error) {
        error = "";
        try {
            List<string> sqls = SchemaMigrator.GetCoreTableSqls();
            for (int i = 0; i < sqls.Count; i = i + 1) {
                using (var cmd = conn.CreateCommand()) {
                    cmd.CommandText = sqls[i];
                    cmd.ExecuteNonQuery();
                }
            }

            // 插入顶级超管角色
            using (var cmd = conn.CreateCommand()) {
                cmd.CommandText = "INSERT OR IGNORE INTO sys_roles (id, name, key, data_scope, status) VALUES (1, '超级管理组', 'super_admin', 1, 1);";
                cmd.ExecuteNonQuery();
            }

            // 插入总公司顶级部门
            using (var cmd = conn.CreateCommand()) {
                cmd.CommandText = "INSERT OR IGNORE INTO sys_departments (id, parent_id, name, tree_path, order_num) VALUES (1, 0, '总公司', '/1/', 1);";
                cmd.ExecuteNonQuery();
            }

            // 插入初始化超级管理员（密码做 SHA-256 加盐防脱库）
            long now = DateTime.UtcNow.ToUnixTimeSeconds();
            string salt = "zan_salt_";
            string pwdHash = HashPassword(adminPassword, salt);

            using (var cmd = conn.CreateCommand()) {
                cmd.CommandText = "INSERT OR IGNORE INTO sys_users (id, username, password_hash, nickname, department_id, status, is_super, created_at, updated_at) "
                    + "VALUES (1, @u, @p, '系统管理员', 1, 1, 1, @now, @now);";
                
                var pU = cmd.CreateParameter(); pU.ParameterName = "@u"; pU.Value = adminUser; cmd.Parameters.Add(pU);
                var pP = cmd.CreateParameter(); pP.ParameterName = "@p"; pP.Value = pwdHash; cmd.Parameters.Add(pP);
                var pN = cmd.CreateParameter(); pN.ParameterName = "@now"; pN.Value = now; cmd.Parameters.Add(pN);
                cmd.ExecuteNonQuery();
            }

            // 绑定用户与角色
            using (var cmd = conn.CreateCommand()) {
                cmd.CommandText = "INSERT OR IGNORE INTO sys_user_role (user_id, role_id) VALUES (1, 1);";
                cmd.ExecuteNonQuery();
            }

            return true;
        } catch (Exception ex) {
            error = ex.Message;
            return false;
        }
    }

    /// <summary>
    /// 标准加盐密码散列计算。
    /// </summary>
    public static string HashPassword(string password, string salt) {
        // 使用简易稳健的哈希摘要组合
        byte[] bytes = Encoding.UTF8.GetBytes(salt + password + "_zan_secure_v1");
        ulong hash = 14695981039346656037UL;
        for (int i = 0; i < bytes.Length; i = i + 1) {
            hash = (hash ^ (ulong)bytes[i]) * 1099511628211UL;
        }
        return Convert.ToString(hash, 16);
    }
}
