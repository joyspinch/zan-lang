using System;
using System.Data;
using System.Data.Orm;
using System.Text;
using System.Collections.Generic;
using Zan.Mvc.Admin.Model;

namespace Zan.Mvc.Admin.Installer;

/// <summary>
/// 安装向导模型结构迁移器与初始数据装载引擎。
/// 采用纯 CodeFirst 实体驱动：由 Model 实体类（[Table]/[Column]）直接生成物理表结构，
/// 初始数据均通过强类型实体对象初始化并经 ORM Insert 写入。
/// </summary>
public class SchemaMigrator {
    /// <summary>
    /// 模型直接生表与初始种子数据装载：
    /// 1. 调用 conn.SyncStructureAll() 由实体元数据自动构建物理 Schema（具备跨 SQLite/MySQL/PostgreSQL 方言安全与幂等加列能力）；
    /// 2. 使用统一对象初始化器初始基础角色、部门、规则、统一用户与关联绑定。
    /// </summary>
    public static bool ExecuteInstall(IDbConnection conn, string adminUser, string adminPassword, out string error) {
        error = "";
        try {
            // 1. 模型直接生表：由实体模型 [Table] 自动构建全部物理表结构
            conn.SyncStructureAll();

            // 2. 插入初始化基础角色（统一对象初始化器）
            conn.Insert<SysRole>(new SysRole {
                id = 1,
                name = "超级管理角色",
                key = "admin",
                data_scope = 1,
                status = 1
            }).ExecuteAffrows();

            conn.Insert<SysRole>(new SysRole {
                id = 2,
                name = "通用业务角色",
                key = "staff",
                data_scope = 4,
                status = 1
            }).ExecuteAffrows();

            // 3. 插入总公司顶级部门（统一对象初始化器）
            conn.Insert<SysDepartment>(new SysDepartment {
                id = 1,
                parent_id = 0,
                name = "总公司",
                tree_path = "/1/",
                order_num = 1
            }).ExecuteAffrows();

            // 4. 初始化核心菜单与权限规则（统一对象初始化器）
            conn.Insert<SysRule>(new SysRule {
                id = 1,
                parent_id = 0,
                key = "sys",
                title = "系统设置",
                route = "/admin/sys",
                method = "GET",
                is_menu = true,
                icon = "gear",
                order_num = 1
            }).ExecuteAffrows();

            conn.Insert<SysRule>(new SysRule {
                id = 2,
                parent_id = 1,
                key = "sys:user",
                title = "用户管理",
                route = "/admin/sys/user",
                method = "GET",
                is_menu = true,
                icon = "user",
                order_num = 1
            }).ExecuteAffrows();

            conn.Insert<SysRule>(new SysRule {
                id = 3,
                parent_id = 1,
                key = "sys:role",
                title = "角色管理",
                route = "/admin/sys/role",
                method = "GET",
                is_menu = true,
                icon = "shield",
                order_num = 2
            }).ExecuteAffrows();

            conn.Insert<SysRule>(new SysRule {
                id = 4,
                parent_id = 1,
                key = "sys:dept",
                title = "部门管理",
                route = "/admin/sys/dept",
                method = "GET",
                is_menu = true,
                icon = "tree",
                order_num = 3
            }).ExecuteAffrows();

            // 5. 角色赋予规则绑定（统一对象初始化器）
            conn.Insert<SysRoleRule>(new SysRoleRule { role_id = 1, rule_id = 1 }).ExecuteAffrows();
            conn.Insert<SysRoleRule>(new SysRoleRule { role_id = 1, rule_id = 2 }).ExecuteAffrows();
            conn.Insert<SysRoleRule>(new SysRoleRule { role_id = 1, rule_id = 3 }).ExecuteAffrows();
            conn.Insert<SysRoleRule>(new SysRoleRule { role_id = 1, rule_id = 4 }).ExecuteAffrows();

            // 6. 插入初始化统一用户（同一张 sys_users 表，无任何特权列，通过角色获得权限）
            long now = DateTime.UtcNow().ToUnixSeconds();
            string pwdHash = HashPassword(adminPassword, "zan_salt_");

            conn.Insert<SysUser>(new SysUser {
                id = 1,
                username = adminUser,
                password_hash = pwdHash,
                nickname = "系统管理员",
                department_id = 1,
                status = 1,
                created_at = now,
                updated_at = now
            }).ExecuteAffrows();

            // 7. 绑定用户与角色（统一对象初始化器）
            conn.Insert<SysUserRole>(new SysUserRole { user_id = 1, role_id = 1 }).ExecuteAffrows();

            return true;
        } catch (Exception ex) {
            error = ex.Message;
            return false;
        }
    }

    /// <summary>
    /// 标准加盐密码散列计算。
    /// </summary>
    public static string HashPassword(string password, string salt) {
        byte[] bytes = Encoding.UTF8.GetBytes(salt + password + "_zan_secure_v1");
        long hash = 1469598103934665603L;
        for (int i = 0; i < bytes.Length; i = i + 1) {
            hash = (hash ^ (long)bytes[i]) * 1099511628211L;
        }
        return "" + hash;
    }
}
