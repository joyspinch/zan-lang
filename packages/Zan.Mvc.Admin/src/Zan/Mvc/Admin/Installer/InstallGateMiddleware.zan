using System;
using System.IO;
using System.Web;

namespace Zan.Mvc.Admin.Installer;

public class InstallGateMiddleware {
    public static string LockFilePath = "_scratch/admin_demo_data/install.lock";

    public static bool Handle(HttpContext ctx) {
        if (File.Exists(LockFilePath)) {
            return true;
        }
        if (ctx.path.StartsWith("/admin/install") || ctx.path.StartsWith("/static")) {
            return true;
        }
        ctx.Redirect("/admin/install");
        return false;
    }
}
