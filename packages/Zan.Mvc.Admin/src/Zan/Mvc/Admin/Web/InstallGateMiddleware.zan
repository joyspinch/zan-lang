using System;
using System.IO;

namespace Zan.Mvc.Admin.Web;

/// <summary>
/// 安装锁状态守卫。
/// 检查根目录下的 install.lock 文件。
/// 未安装时重定向至 /install；已安装后永久熔断 /install 入口，确保生产部署安全。
/// </summary>
public class InstallGateMiddleware {
    public const string LOCK_FILE = "install.lock";
    public static string LockFilePath = "install.lock";

    /// <summary>
    /// 系统是否已完成初始安装。
    /// </summary>
    public static bool IsInstalled() {
        return File.Exists(LockFilePath) || (LockFilePath != LOCK_FILE && File.Exists(LOCK_FILE));
    }

    /// <summary>
    /// 校验当前请求路径是否允许通行。
    /// </summary>
    /// <param name="path">当前请求的 URL 路径</param>
    /// <param name="outRedirect">若需要重定向，返回目标地址</param>
    /// <returns>0: 正常放行; 302: 需重定向; 404: 永久熔断禁止访问</returns>
    public static int Check(string path, out string outRedirect) {
        outRedirect = "";
        bool installed = InstallGateMiddleware.IsInstalled();

        if (!installed) {
            // 未安装：除 /install/* 与静态资源外，一律重定向至 /install
            if (!path.StartsWith("/install") && !path.StartsWith("/static") && !path.StartsWith("/assets")) {
                outRedirect = "/install";
                return 302;
            }
            return 0; // 放行至安装向导
        }

        // 已安装：禁止再度访问 /install
        if (path.StartsWith("/install")) {
            return 404; // 永久熔断
        }

        return 0; // 正常放行
    }
}
