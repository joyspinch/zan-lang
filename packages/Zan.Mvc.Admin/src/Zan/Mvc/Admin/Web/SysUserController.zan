using System;
using System.Collections.Generic;
using System.Text;
using System.Web;
using System.Json;
using Zan.Mvc.Admin.Model;
using Zan.Mvc.Admin.UI;
using Zan.Mvc.Admin.Security;

namespace Zan.Mvc.Admin.Web;

/// <summary>
/// 系统管理员用户管理控制器。
/// 严格执行超级管理员（ID: 1 与 admin）物理防删与不可禁用安全策略。
/// </summary>
[Route("/admin/system/user")]
[Custom(Authorization = CustomAuthorization.Grant, IsMenu = true, Icon = "user", Perm = PermBit.View)]
[Description("用户管理")]
public class SysUserController : CrudController<SysUser> {
    public SysUserController() {
    }

    protected override TableConfig BuildTableConfig() {
        TableConfig cfg = new TableConfig();
        cfg.Conf.SetKey("id", "用户管理");
        cfg.AddColumn("id", "ID", "number", 60, true, false)
           .AddColumn("username", "登录账号", "input", 120, true, false)
           .AddColumn("nickname", "用户昵称", "input", 140, true, true)
           .AddColumn("mobile", "手机号码", "input", 120, true, true)
           .AddColumn("email", "电子邮箱", "input", 160, true, true)
           .AddColumn("status", "账号状态", "dict", 90, true, true)
           .AddColumn("last_login_time", "最后登录时间", "time", 150, true, false)
           .AddColumn("last_login_ip", "最后登录IP", "input", 120, false, false)
           .AddFilter("username", "登录账号", "Input", "输入用户名搜索")
           .AddFilter("nickname", "用户昵称", "Input", "输入昵称搜索")
           .AddTool("添加用户", "Add", "用户", "Primary", false, "600px", "450px")
           .AddTool("批量删除", "Delete", "用户", "Error", true, "400px", "260px")
           .AddTool("导出用户", "Export", "用户", "Default", false, "", "");
        return cfg;
    }

    protected override FormView BuildFormView() {
        FormView form = new FormView("用户信息");
        form.AddField("username", "登录账号", "input", true, "请输入登录账号 (英文字母/数字)", 12)
            .AddField("nickname", "用户昵称", "input", true, "请输入用户真实姓名或昵称", 12)
            .AddField("password", "初始密码", "password", true, "请输入初始登录密码", 12)
            .AddField("mobile", "手机号码", "input", false, "选填，11位手机号码", 6)
            .AddField("email", "电子邮箱", "input", false, "选填，有效电子邮箱", 6)
            .AddField("status", "账号状态", "radio", true, "1:正常,0:禁用", 12);
        return form;
    }

    protected override string OnPage(int page, int pageSize) {
        List<SysUser> list = this.SysUser.OrderBy("id DESC").Page(page, pageSize).ToList();
        int total = this.SysUser.Count();
        SysUserPagedResult res = new SysUserPagedResult(total, list);
        return Json.Serialize<SysUserPagedResult>(res);
    }

    protected override bool OnSave(string body) {
        string username = this.Ctx().form.Get("username");
        string nickname = this.Ctx().form.Get("nickname");
        string password = this.Ctx().form.Get("password");
        string mobile = this.Ctx().form.Get("mobile");
        string email = this.Ctx().form.Get("email");
        string statusStr = this.Ctx().form.Get("status");

        if (username.Length == 0 || password.Length == 0) {
            return false;
        }

        SysUser exist = this.SysUser.W("username = ?").P(username).First();
        if (exist != null) {
            return false;
        }

        string salt = PasswordSecurity.GenerateSalt(16);
        string hash = PasswordSecurity.HashPassword(password, salt);

        SysUser u = new SysUser();
        u.username = username;
        u.nickname = nickname.Length > 0 ? nickname : username;
        u.password_hash = hash;
        u.salt = salt;
        u.mobile = mobile;
        u.email = email;
        u.status = 1;
        if (statusStr.Length > 0) {
            try { u.status = Convert.ToInt32(statusStr); } catch (Exception ex) {}
        }
        u.created_at = DateTime.UtcNow().ToUnixSeconds();

        return this.SysUser.Insert(u).ExecuteAffrows() > 0;
    }

    protected override bool OnDelete(int id) {
        if (id == 1) {
            return false;
        }
        SysUser u = this.SysUser.W("id = ?").Pi(id).First();
        if (u != null && u.username == "admin") {
            return false;
        }
        this.SysUserRole.Delete().W("user_id = ?").Pi(id).ExecuteAffrows();
        return this.SysUser.Delete().W("id = ?").Pi(id).ExecuteAffrows() > 0;
    }

    protected override bool OnBatchDelete(List<int> ids) {
        bool ok = true;
        for (int i = 0; i < ids.Count; i = i + 1) {
            int id = ids[i];
            if (id == 1) { continue; }
            SysUser u = this.SysUser.W("id = ?").Pi(id).First();
            if (u != null && u.username == "admin") { continue; }
            this.SysUserRole.Delete().W("user_id = ?").Pi(id).ExecuteAffrows();
            if (this.SysUser.Delete().W("id = ?").Pi(id).ExecuteAffrows() <= 0) {
                ok = false;
            }
        }
        return ok;
    }

    protected override bool OnField(int id, string field, string value) {
        if (id == 1 && field == "status" && value == "0") {
            return false;
        }
        if (field == "status") {
            int st = 1;
            try { st = Convert.ToInt32(value); } catch (Exception ex) {}
            return this.SysUser.Update().SetI("status", st).W("id = ?").Pi(id).ExecuteAffrows() > 0;
        }
        return this.SysUser.Update().SetS(field, value).W("id = ?").Pi(id).ExecuteAffrows() > 0;
    }

    [HttpPost]
    [Route("/admin/system/user/resetpass")]
    public void ResetPass() {
        string idStr = this.Ctx().form.Get("id");
        int id = 0;
        try { id = Convert.ToInt32(idStr); } catch (Exception ex) {}
        if (id <= 0) {
            this.JsonFail("用户 ID 不合法");
            return;
        }

        SysUser u = this.SysUser.W("id = ?").Pi(id).First();
        if (u == null) {
            this.JsonFail("指定用户不存在");
            return;
        }

        string newPass = "123456";
        string salt = PasswordSecurity.GenerateSalt(16);
        string hash = PasswordSecurity.HashPassword(newPass, salt);
        this.SysUser.Update().SetS("password_hash", hash).SetS("salt", salt).W("id = ?").Pi(id).ExecuteAffrows();

        this.AuditLog("ResetPassword", "重置用户密码 (UID: " + Convert.ToString(id) + ")");
        this.JsonSuccess("密码已成功重置为 123456");
    }

    [HttpGet]
    [Route("/admin/system/user/roles")]
    public void UserRoles() {
        string idStr = this.Ctx().query.Get("id");
        if (idStr.Length == 0) {
            idStr = this.Ctx().query.Get("user_id");
        }
        int id = 0;
        try { id = Convert.ToInt32(idStr); } catch (Exception ex) {}

        List<SysRole> allRoles = this.SysRole.W("status = 1").OrderBy("id ASC").ToList();
        List<SysUserRole> userRoles = this.SysUserRole.W("user_id = ?").Pi(id).ToList();

        Dict<int, bool> checkedMap = new Dict<int, bool>();
        for (int i = 0; i < userRoles.Count; i = i + 1) {
            checkedMap.Add(userRoles[i].role_id, true);
        }

        StringBuilder sb = new StringBuilder();
        sb.Append("[");
        for (int i = 0; i < allRoles.Count; i = i + 1) {
            if (i > 0) { sb.Append(","); }
            SysRole r = allRoles[i];
            bool isChecked = checkedMap.ContainsKey(r.id);
            sb.Append("{");
            sb.Append("\"id\":");
            sb.Append(Convert.ToString(r.id));
            sb.Append(",");
            sb.Append("\"name\":\"");
            sb.Append(r.name);
            sb.Append("\",");
            sb.Append("\"remark\":\"");
            sb.Append(r.remark);
            sb.Append("\",");
            sb.Append("\"checked\":");
            sb.Append(isChecked ? "true" : "false");
            sb.Append("}");
        }
        sb.Append("]");

        this.JsonSuccessData(sb.ToString());
    }

    [HttpPost]
    [Route("/admin/system/user/saveroles")]
    public void SaveUserRoles() {
        string idStr = this.Ctx().form.Get("id");
        string roleIdsStr = this.Ctx().form.Get("role_ids");

        int id = 0;
        try { id = Convert.ToInt32(idStr); } catch (Exception ex) {}
        if (id <= 0) {
            this.JsonFail("用户 ID 不合法");
            return;
        }

        // 先清理该用户原有的全部角色关联
        this.SysUserRole.Delete().W("user_id = ?").Pi(id).ExecuteAffrows();

        // 重新批量插入
        if (roleIdsStr.Length > 0) {
            List<string> parts = roleIdsStr.Split(",");
            for (int i = 0; i < parts.Count; i = i + 1) {
                try {
                    int rid = Convert.ToInt32(parts[i]);
                    if (rid > 0) {
                        SysUserRole ur = new SysUserRole();
                        ur.user_id = id;
                        ur.role_id = rid;
                        this.SysUserRole.Insert(ur).ExecuteAffrows();
                    }
                } catch (Exception ex) {}
            }
        }

        this.AuditLog("SaveUserRoles", "更新用户角色分配 (UID: " + Convert.ToString(id) + ")");
        this.JsonSuccess("角色分配已生效");
    }
}
