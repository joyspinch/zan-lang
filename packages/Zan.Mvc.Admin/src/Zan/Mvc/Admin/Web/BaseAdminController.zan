using System;
using System.Text;
using System.Web;
using System.Collections.Generic;
using System.Json;
using Zan.Mvc.Admin.Model;
using Zan.Mvc.Admin.Security;
using Zan.Mvc.Admin.Validation;

namespace Zan.Mvc.Admin.Web;

/// <summary>
/// 企业级统一后台控制器基类。
/// 内置：请求耗时监控、统一上下文维护、强类型 JSON 响应封装、页面片段判断（X-Fragment）。
/// 所有业务中台（ERP、WMS、CRM 等）后台管理控制器均继承此类。
/// </summary>
public abstract class BaseAdminController : Controller {
    protected AdminContext Context;

    public BaseAdminController() {
        this.Context = new AdminContext();
    }

    /// <summary>是否为局部刷新/弹窗加载的 Fragment 请求</summary>
    protected bool IsFragment() {
        return this.Ctx().Header("X-Fragment").Length > 0;
    }

    /// <summary>当前操作人 ID</summary>
    protected int CurrentAdminId {
        get {
            if (this.Context != null && this.Context.AdminId > 0) {
                return this.Context.AdminId;
            }
            if (this.Ctx() != null) {
                string uidStr = this.Ctx().Cookie("zan_admin_uid");
                if (uidStr.Length > 0) {
                    return Convert.ToInt32(uidStr);
                }
            }
            return 0;
        }
    }

    /// <summary>当前操作人生效的数据范围</summary>
    protected DataScope CurrentDataScope {
        get {
            if (this.Context != null && this.Context.DataScope != null) {
                return this.Context.DataScope;
            }
            return DataScope.All();
        }
    }

    /// <summary>页面重定向</summary>
    protected void Redirect(string url) {
        this.Ctx().Redirect(url);
    }

    /// <summary>
    /// 标准统一成功 JSON 响应（强类型 DTO 编译器自动序列化）。
    /// </summary>
    protected void JsonSuccess(string msg = "操作成功") {
        if (this.Ctx() != null) {
            ApiResponse r = ApiResponse.Ok(msg);
            this.Json(Json.Serialize<ApiResponse>(r));
        }
    }

    /// <summary>
    /// 标准统一成功 JSON 响应（带数据载荷）。
    /// </summary>
    protected void JsonSuccessData(string data, string msg = "操作成功") {
        if (this.Ctx() != null) {
            ApiResponse r = ApiResponse.OkData(data, msg);
            this.Json(Json.Serialize<ApiResponse>(r));
        }
    }

    /// <summary>
    /// 标准统一失败 JSON 响应（强类型 DTO 编译器自动序列化）。
    /// </summary>
    protected void JsonFail(string msg = "操作失败", string code = "9999") {
        if (this.Ctx() != null) {
            ApiResponse r = ApiResponse.Fail(msg, code);
            this.Json(Json.Serialize<ApiResponse>(r));
        }
    }

    /// <summary>
    /// 结构化参数校验助手（字典版）。失败自动阻断并输出 4001 错误。
    /// </summary>
    protected bool Validate(BaseValidator validator, Dict<string, string> data, string scene = "") {
        if (validator == null || data == null) { return true; }
        ValidateResult res = validator.Check(data, scene);
        if (!res.IsOk()) {
            this.JsonFail(res.GetFirstError(), "4001");
            return false;
        }
        return true;
    }

    /// <summary>
    /// 结构化参数校验助手（JSON 版）。失败自动阻断并输出 4001 错误。
    /// </summary>
    protected bool ValidateJson(BaseValidator validator, JsonValue json, string scene = "") {
        if (validator == null || json == null) { return true; }
        ValidateResult res = validator.CheckJson(json, scene);
        if (!res.IsOk()) {
            this.JsonFail(res.GetFirstError(), "4001");
            return false;
        }
        return true;
    }

    /// <summary>
    /// 接口访问防刷与高频限流检查。
    /// 超过限流阈值自动拦截输出 4029 并返回 false。
    /// </summary>
    protected bool CheckRateLimit(string actionKey, int maxPerWindow = 60, int windowSeconds = 60) {
        if (this.Ctx() == null) { return true; }
        string ip = this.Ctx().RemoteIp();
        string key = ip + ":" + actionKey;
        if (!AdminRateLimiter.Check(key, maxPerWindow, windowSeconds)) {
            this.AuditLog("RateLimit", "触发高频请求阻断: " + key);
            this.JsonFail("请求过于频繁，请稍后再试", "4029");
            return false;
        }
        return true;
    }

    /// <summary>
    /// 获取或生成当前会话的 CSRF 防御令牌
    /// </summary>
    protected string GetCsrfToken() {
        if (this.Ctx() == null) { return ""; }
        string token = this.Ctx().Cookie(CsrfGuard.CookieName);
        if (token.Length == 0) {
            token = CsrfGuard.GenerateToken(this.CurrentAdminId, "admin_session");
            this.Ctx().SetCookieJs(CsrfGuard.CookieName, token, 86400);
        }
        return token;
    }

    /// <summary>
    /// 验证客户端提交的 CSRF 令牌。
    /// 优先从 Header (X-CSRF-Token) 提取，其次从表单 (_csrf) 提取。
    /// 校验失败自动输出 4032 拦截错误并返回 false。
    /// </summary>
    protected bool VerifyCsrf() {
        if (this.Ctx() == null) { return true; }
        // GET/HEAD/OPTIONS 不执行 CSRF 校验
        string m = this.Ctx().method;
        if (m == "GET" || m == "HEAD" || m == "OPTIONS") {
            return true;
        }

        string clientToken = this.Ctx().Header(CsrfGuard.HeaderName);
        if (clientToken.Length == 0) {
            clientToken = this.In(CsrfGuard.FormFieldName);
        }

        string expectedToken = this.Ctx().Cookie(CsrfGuard.CookieName);
        if (!CsrfGuard.ValidateToken(clientToken, expectedToken)) {
            this.AuditLog("SecurityAlert", "非法 CSRF 请求拦截: " + this.Ctx().path);
            this.JsonFail("安全校验失败：CSRF 令牌无效或已过期", "4032");
            return false;
        }
        return true;
    }

    /// <summary>
    /// 记录业务审计日志。
    /// </summary>
    protected void AuditLog(string action, string detail) {
        int uid = this.CurrentAdminId;
        Console.WriteLine("[AUDIT] User: " + Convert.ToString(uid) + " | Action: " + action + " | " + detail);
    }
}
