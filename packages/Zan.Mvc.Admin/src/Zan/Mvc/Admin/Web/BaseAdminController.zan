using System;
using System.IO;
using System.Data;
using System.Web;
using System.Json;
using Zan.Mvc.Admin;
using Zan.Mvc.Admin.Model;
using Zan.Mvc.Admin.Security;

namespace Zan.Mvc.Admin.Web;

/// <summary>
/// 管理后台基础控制器。
/// 挂载 __Conn() 与 this.Db 激发编译器类型化 ORM 访问器；
/// 规范化统一 JSON 应答与操作审计日志记录。
/// </summary>
public class BaseAdminController : Controller {
    public IDbConnection __Conn() {
        return AdminApp.Db;
    }

    public IDbConnection Db {
        get { return AdminApp.Db; }
    }

    public int CurrentAdminId {
        get {
            string token = this.Ctx().Cookie(AdminSessionToken.CookieName);
            int uid = AdminSessionToken.Verify(token);
            if (uid > 0) { return uid; }
            return 0;
        }
    }

    public void JsonSuccess(string msg = "操作成功") {
        this.Ctx().contentType = "application/json; charset=utf-8";
        this.Ctx().body = "{\"code\":0,\"msg\":\"" + msg + "\"}";
        this.Ctx().ended = true;
    }

    public void JsonSuccessData(string jsonSnippet, string msg = "操作成功") {
        this.Ctx().contentType = "application/json; charset=utf-8";
        this.Ctx().body = "{\"code\":0,\"msg\":\"" + msg + "\",\"data\":" + jsonSnippet + "}";
        this.Ctx().ended = true;
    }

    public void JsonFail(string msg = "操作失败", string code = "1") {
        this.Ctx().contentType = "application/json; charset=utf-8";
        this.Ctx().body = "{\"code\":" + code + ",\"msg\":\"" + msg + "\"}";
        this.Ctx().ended = true;
    }

    public void AuditLog(string action, string detail) {
        try {
            int uid = this.CurrentAdminId;
            if (uid > 0) {
                IDbConnection db = this.Db;
                if (db != null) {
                    SysOperationLog log = new SysOperationLog();
                    log.user_id = uid;
                    log.action = action;
                    log.detail = detail;
                    log.ip = this.Ctx().RemoteIp();
                    log.created_at = DateTime.UtcNow().ToUnixSeconds();
                    db.Insert<SysOperationLog>(log).ExecuteAffrows();
                }
            }
        } catch (Exception ex) {}
    }

    public string LoadView(string viewName) {
        string[] candidates = new string[] {
            "packages/Zan.Mvc.Admin/assets/views/" + viewName + ".html",
            "assets/views/" + viewName + ".html",
            "views/" + viewName + ".html"
        };
        for (int i = 0; i < candidates.Length; i = i + 1) {
            if (File.Exists(candidates[i])) {
                return File.ReadAllText(candidates[i]);
            }
        }
        return "<h1>视图不存在: " + viewName + "</h1>";
    }
}
