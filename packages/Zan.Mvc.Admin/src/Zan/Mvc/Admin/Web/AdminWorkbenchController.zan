using System;
using System.Collections.Generic;
using System.Data;
using System.Web;
using Zan.Mvc.Admin.Dao;
using Zan.Mvc.Admin.Model;
using Zan.Mvc.Admin.Security;

namespace Zan.Mvc.Admin.Web;

/// <summary>
/// 统一管理后台工作台控制器。
/// 负责主界面 Shell、动态菜单拉取与当前操作人基本信息加载。
/// </summary>
public class AdminWorkbenchController : BaseAdminController {
    [HttpGet]
    [Route("/admin")]
    [Route("/admin/index")]
    public void Index() {
        string uidStr = this.Ctx().Cookie("zan_admin_uid");
        if (uidStr.Length == 0) {
            this.Redirect("/admin/login");
            return;
        }
        int uid = Convert.ToInt32(uidStr);
        if (uid <= 0) {
            this.Redirect("/admin/login");
            return;
        }

        string nickname = this.Ctx().Cookie("zan_admin_nick");
        if (nickname.Length == 0) { nickname = "管理员"; }

        string html = "<!DOCTYPE html><html lang=\"zh-CN\"><head><meta charset=\"UTF-8\"><title>Zan 企业级管理工作台</title>"
            + "<style>"
            + ":root{--bg-body:#0f172a;--bg-side:#1e293b;--bg-card:#182234;--border:#334155;--primary:#38bdf8;--text:#f8fafc;--muted:#94a3b8;}"
            + "*{box-sizing:border-box;margin:0;padding:0;}"
            + "body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:var(--bg-body);color:var(--text);display:flex;height:100vh;overflow:hidden;}"
            + ".sidebar{width:230px;background:var(--bg-side);border-right:1px solid var(--border);display:flex;flex-direction:column;flex-shrink:0;}"
            + ".brand{padding:18px;font-size:16px;font-weight:700;color:var(--primary);border-bottom:1px solid var(--border);display:flex;align-items:center;gap:8px;}"
            + ".menu-list{flex:1;overflow-y:auto;padding:12px 8px;}"
            + ".menu-item{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:6px;color:var(--muted);text-decoration:none;font-size:13px;margin-bottom:4px;transition:all .2s;cursor:pointer;}"
            + ".menu-item:hover, .menu-item.active{background:rgba(56,189,248,0.1);color:var(--primary);font-weight:500;}"
            + ".main-panel{flex:1;display:flex;flex-direction:column;overflow:hidden;}"
            + ".topbar{height:52px;background:var(--bg-side);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 20px;}"
            + ".user-badge{display:flex;align-items:center;gap:12px;font-size:13px;color:var(--muted);}"
            + ".user-badge a{color:#ef4444;text-decoration:none;font-size:12px;}"
            + ".tab-bar{height:38px;background:var(--bg-card);border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 12px;gap:6px;overflow-x:auto;}"
            + ".tab{padding:4px 12px;border-radius:4px;background:var(--bg-side);border:1px solid var(--border);font-size:12px;color:var(--muted);cursor:pointer;display:inline-flex;align-items:center;gap:6px;}"
            + ".tab.active{background:var(--primary);color:#0f172a;font-weight:600;border-color:var(--primary);}"
            + ".viewport{flex:1;background:var(--bg-body);position:relative;}"
            + "iframe{width:100%;height:100%;border:none;}"
            + "</style>"
            + "<script src=\"/static/zan/js/core/event-bus.js\"></script>"
            + "<script src=\"/static/zan/js/core/tabs.js\"></script>"
            + "</head><body>"
            + "<div class=\"sidebar\">"
            + "<div class=\"brand\">⚡ Zan 管理工作台</div>"
            + "<div class=\"menu-list\" id=\"menuContainer\">正在加载可见菜单...</div>"
            + "</div>"
            + "<div class=\"main-panel\">"
            + "<div class=\"topbar\">"
            + "<div style=\"font-size:13px;color:var(--muted);\">企业级 MVC 架构中台</div>"
            + "<div class=\"user-badge\"><span>欢迎，" + nickname + "</span><a href=\"/admin/logout\">[退出]</a></div>"
            + "</div>"
            + "<div class=\"tab-bar\" id=\"tabBar\">"
            + "<div class=\"tab active\" onclick=\"openTab('工作台', '/admin/dashboard')\">工作台</div>"
            + "</div>"
            + "<div class=\"viewport\"><iframe id=\"contentFrame\" src=\"/admin/dashboard\"></iframe></div>"
            + "</div>"
            + "<script>"
            + "function openTab(title, url){"
            + "  document.getElementById('contentFrame').src = url;"
            + "}"
            + "fetch('/admin/api/menus').then(r=>r.json()).then(res=>{"
            + "  let el = document.getElementById('menuContainer'); el.innerHTML='';"
            + "  (res.data || []).forEach(m=>{"
            + "    let item = document.createElement('div'); item.className='menu-item';"
            + "    item.textContent = m.title;"
            + "    item.onclick = function(){ openTab(m.title, m.route); };"
            + "    el.appendChild(item);"
            + "  });"
            + "});"
            + "</script></body></html>";

        this.Html(html);
    }

    [HttpGet]
    [Route("/admin/dashboard")]
    public void DashboardView() {
        string html = "<!DOCTYPE html><html lang=\"zh-CN\"><head><meta charset=\"UTF-8\">"
            + "<style>body{background:#0f172a;color:#f8fafc;font-family:sans-serif;padding:24px;}"
            + ".cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin-top:20px;}"
            + ".card{background:#1e293b;border:1px solid #334155;border-radius:8px;padding:20px;}"
            + ".num{font-size:26px;color:#38bdf8;font-weight:700;margin-top:8px;}"
            + "</style></head><body>"
            + "<h2>系统概览工作台</h2>"
            + "<p style=\"color:#94a3b8;margin-top:6px;font-size:13px;\">基于 Zan.Mvc.Admin 强类型架构，实体 DAO 泛型驱动。</p>"
            + "<div class=\"cards\">"
            + "<div class=\"card\"><div>系统用户数</div><div class=\"num\" id=\"userCount\">-</div></div>"
            + "<div class=\"card\"><div>组织部门数</div><div class=\"num\" id=\"deptCount\">-</div></div>"
            + "<div class=\"card\"><div>系统角色数</div><div class=\"num\" id=\"roleCount\">-</div></div>"
            + "</div>"
            + "<script>"
            + "fetch('/admin/api/stats').then(r=>r.json()).then(res=>{"
            + "  if(res.code==='0000'){"
            + "    document.getElementById('userCount').textContent = res.data.users;"
            + "    document.getElementById('deptCount').textContent = res.data.depts;"
            + "    document.getElementById('roleCount').textContent = res.data.roles;"
            + "  }"
            + "});"
            + "</script></body></html>";

        this.Html(html);
    }

    [HttpGet]
    [Route("/admin/api/menus")]
    public void ApiMenus() {
        string uidStr = this.Ctx().Cookie("zan_admin_uid");
        if (uidStr.Length == 0) {
            this.JsonFail("未登录", "401");
            return;
        }
        int uid = Convert.ToInt32(uidStr);
        if (uid <= 0) {
            this.JsonFail("未登录", "401");
            return;
        }

        IDbConnection conn = AdminApp.Db;
        if (conn == null) {
            conn = AdminApp.OpenDb();
        }

        List<SysRule> menus = UserAuthService.GetUserMenuTree(conn, uid);
        this.Json(Json.Serialize<List<SysRule>>(menus));
    }

    [HttpGet]
    [Route("/admin/api/stats")]
    public void ApiStats() {
        IDbConnection conn = AdminApp.Db;
        if (conn == null) {
            conn = AdminApp.OpenDb();
        }

        SysUserDao userDao = SysUserDao.Of(conn);
        SysDepartmentDao deptDao = SysDepartmentDao.Of(conn);
        SysRoleDao roleDao = SysRoleDao.Of(conn);

        int users = userDao.Count();
        int depts = deptDao.Count();
        int roles = roleDao.Count();

        this.Json("{\"code\":\"0000\",\"data\":{\"users\":" + Convert.ToString(users) + ",\"depts\":" + Convert.ToString(depts) + ",\"roles\":" + Convert.ToString(roles) + "}}");
    }
}
