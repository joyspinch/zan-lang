using System;
using System.Collections.Generic;
using System.Data;
using System.Web;
using Zan.Mvc.Admin.Dao;
using Zan.Mvc.Admin.Model;
using Zan.Mvc.Admin.Security;
using Zan.Mvc.Admin.UI;

namespace Zan.Mvc.Admin.Web;

/// <summary>
/// 统一管理后台工作台控制器。
/// 负责主界面 Shell、动态菜单拉取与当前操作人基本信息加载。
/// </summary>
public class AdminWorkbenchController : BaseAdminController {
    [HttpGet]
    [Route("/admin")]
    [Route("/admin/index")]
    public void Index() {
        string uidStr = this.Ctx().Cookie("zan_admin_uid");
        if (uidStr.Length == 0) {
            this.Redirect("/admin/login");
            return;
        }
        int uid = Convert.ToInt32(uidStr);
        if (uid <= 0) {
            this.Redirect("/admin/login");
            return;
        }

        string nickname = this.Ctx().Cookie("zan_admin_nick");
        if (nickname.Length == 0) { nickname = "管理员"; }

        Dict<string, string> vars = new Dict<string, string>();
        vars["nickname"] = nickname;
        string html = AdminViewEngine.Render("Workbench.html", vars);
        this.Html(html);
    }

    [HttpGet]
    [Route("/admin/dashboard")]
    public void DashboardView() {
        string html = AdminViewEngine.Render("Dashboard.html");
        this.Html(html);
    }

    [HttpGet]
    [Route("/admin/api/menus")]
    public void ApiMenus() {
        string uidStr = this.Ctx().Cookie("zan_admin_uid");
        if (uidStr.Length == 0) {
            this.JsonFail("未登录", "401");
            return;
        }
        int uid = Convert.ToInt32(uidStr);
        if (uid <= 0) {
            this.JsonFail("未登录", "401");
            return;
        }

        IDbConnection conn = AdminApp.Db;
        if (conn == null) {
            conn = AdminApp.OpenDb();
        }

        List<SysRule> menus = UserAuthService.GetUserMenuTree(conn, uid);
        this.Json(Json.Serialize<List<SysRule>>(menus));
    }

    [HttpGet]
    [Route("/admin/api/stats")]
    public void ApiStats() {
        IDbConnection conn = AdminApp.Db;
        if (conn == null) {
            conn = AdminApp.OpenDb();
        }

        SysUserDao userDao = SysUserDao.Of(conn);
        SysDepartmentDao deptDao = SysDepartmentDao.Of(conn);
        SysRoleDao roleDao = SysRoleDao.Of(conn);

        int users = userDao.Count();
        int depts = deptDao.Count();
        int roles = roleDao.Count();

        AdminStatsDto dto = new AdminStatsDto(users, depts, roles);
        AdminStatsResponse resp = new AdminStatsResponse(dto);
        this.Json(Json.Serialize<AdminStatsResponse>(resp));
    }
}
