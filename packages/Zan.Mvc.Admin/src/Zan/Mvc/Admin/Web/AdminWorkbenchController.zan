using System;
using System.Collections.Generic;
using System.Text;
using System.Web;
using System.Json;
using System.Diagnostics;
using Zan.Mvc.Admin.Model;
using Zan.Mvc.Admin.Security;

namespace Zan.Mvc.Admin.Web;

/// <summary>
/// 管理后台统一工作台与全局服务控制器。
/// 提供动态菜单构建、系统运行时诊断指标监控、个人中心信息查询与修改密码能力。
/// </summary>
[Route("/admin")]
[Custom(Authorization = CustomAuthorization.Grant, IsMenu = true, Icon = "gauge")]
[Description("控制台")]
public class AdminWorkbenchController : BaseAdminController {

    [HttpGet]
    public void Index() {
        int uid = this.CurrentAdminId;
        if (uid <= 0) {
            this.Ctx().Redirect("/admin/login");
            return;
        }
        string html = this.LoadView("Workbench");
        this.Ctx().Html(html);
    }

    [HttpGet]
    [Route("/admin/api/menus")]
    public void ApiMenus() {
        int uid = this.CurrentAdminId;
        if (uid <= 0) {
            this.JsonFail("未登录", "401");
            return;
        }

        List<SysRule> rules = UserAuthService.Instance.GetUserMenuTree(uid);

        // 组织多级树形菜单 JSON
        StringBuilder sb = new StringBuilder();
        sb.Append("[");

        // 1. 查找所有顶层节点 (pid == 0)
        List<SysRule> roots = new List<SysRule>();
        for (int i = 0; i < rules.Count; i = i + 1) {
            if (rules[i].pid == 0) {
                roots.Add(rules[i]);
            }
        }

        for (int i = 0; i < roots.Count; i = i + 1) {
            if (i > 0) { sb.Append(","); }
            SysRule root = roots[i];
            sb.Append("{");
            sb.Append("\"id\":");
            sb.Append(Convert.ToString(root.id));
            sb.Append(",");
            sb.Append("\"title\":\"");
            sb.Append(root.title);
            sb.Append("\",");
            sb.Append("\"icon\":\"");
            sb.Append(root.icon);
            sb.Append("\",");
            sb.Append("\"path\":\"");
            sb.Append(root.route);
            sb.Append("\",");
            sb.Append("\"children\":[");

            // 查找子节点
            int childCount = 0;
            for (int j = 0; j < rules.Count; j = j + 1) {
                if (rules[j].pid == root.id) {
                    if (childCount > 0) { sb.Append(","); }
                    SysRule child = rules[j];
                    sb.Append("{");
                    sb.Append("\"id\":");
                    sb.Append(Convert.ToString(child.id));
                    sb.Append(",");
                    sb.Append("\"title\":\"");
                    sb.Append(child.title);
                    sb.Append("\",");
                    sb.Append("\"icon\":\"");
                    sb.Append(child.icon);
                    sb.Append("\",");
                    sb.Append("\"path\":\"");
                    sb.Append(child.route);
                    sb.Append("\"");
                    sb.Append("}");
                    childCount = childCount + 1;
                }
            }
            sb.Append("]}");
        }
        sb.Append("]");

        this.JsonSuccessData(sb.ToString());
    }

    [HttpGet]
    [Route("/admin/api/stats")]
    public void ApiStats() {
        int uid = this.CurrentAdminId;
        if (uid <= 0) {
            this.JsonFail("未登录", "401");
            return;
        }

        long uptime = 0;
        int activeConn = 0;
        long memBytes = ServerMetrics.MemoryRssBytes();
        double memMb = (double)memBytes / (1024.0 * 1024.0);

        StringBuilder sb = new StringBuilder();
        sb.Append("{");
        sb.Append("\"uptime\":");
        sb.Append(Convert.ToString(uptime));
        sb.Append(",");
        sb.Append("\"active_connections\":");
        sb.Append(Convert.ToString(activeConn));
        sb.Append(",");
        sb.Append("\"memory_mb\":");
        sb.Append(Convert.ToString(memMb));
        sb.Append(",");
        sb.Append("\"db_status\":\"Online\",");
        sb.Append("\"server_time\":");
        sb.Append(Convert.ToString(DateTime.UtcNow().ToUnixSeconds()));
        sb.Append("}");

        this.JsonSuccessData(sb.ToString());
    }

    [HttpGet]
    [Route("/admin/api/profile")]
    public void ApiProfile() {
        int uid = this.CurrentAdminId;
        if (uid <= 0) {
            this.JsonFail("未登录", "401");
            return;
        }

        List<SysUser> list = this.SysUser.W("id = ?").Pi(uid).ToList();
        if (list.Count == 0) {
            this.JsonFail("用户不存在, uid=" + Convert.ToString(uid) + ", count=" + Convert.ToString(list.Count));
            return;
        }

        SysUser u = list[0];
        SysUserProfileDto dto = new SysUserProfileDto();
        dto.id = u.id;
        dto.username = u.username;
        dto.nickname = u.nickname;
        dto.avatar = u.avatar;
        dto.email = u.email;
        dto.mobile = u.mobile;

        string json = Json.Serialize<SysUserProfileDto>(dto);
        this.JsonSuccessData(json);
    }

    [HttpPost]
    [Route("/admin/api/password")]
    public void ApiChangePassword() {
        int uid = this.CurrentAdminId;
        if (uid <= 0) {
            this.JsonFail("未登录", "401");
            return;
        }

        string oldPass = this.Ctx().form.Get("old_password");
        string newPass = this.Ctx().form.Get("new_password");

        if (oldPass.Length == 0 || newPass.Length == 0) {
            this.JsonFail("原密码与新密码均不能为空");
            return;
        }
        if (newPass.Length < 6) {
            this.JsonFail("新密码长度不能少于6位");
            return;
        }

        List<SysUser> list = this.SysUser.W("id = ?").Pi(uid).ToList();
        if (list.Count == 0) {
            this.JsonFail("用户不存在");
            return;
        }

        SysUser u = list[0];
        if (!PasswordSecurity.VerifyPassword(oldPass, u.password_hash, u.salt)) {
            this.JsonFail("原密码验证失败，请重新输入");
            return;
        }

        string newSalt = PasswordSecurity.GenerateSalt(16);
        string newHash = PasswordSecurity.HashPassword(newPass, newSalt);

        u.password_hash = newHash;
        u.salt = newSalt;
        this.SysUser.Update(u).ExecuteAffrows();

        this.AuditLog("ChangePassword", "修改账号密码 (UID: " + Convert.ToString(uid) + ")");
        this.JsonSuccess("密码修改成功，下次登录请使用新密码");
    }
}
