using System;
using System.Collections.Generic;
using System.Data;
using System.Diagnostics;
using System.Text;
using System.Web;
using Zan.Mvc.Admin.Dao;
using Zan.Mvc.Admin.Model;
using Zan.Mvc.Admin.Security;
using Zan.Mvc.Admin.UI;

namespace Zan.Mvc.Admin.Web;

/// <summary>
/// 统一管理后台工作台控制器。
/// 负责主界面 Shell、动态菜单拉取与当前操作人基本信息加载。
/// </summary>
public class AdminWorkbenchController : BaseAdminController {
    [HttpGet]
    [Route("/admin")]
    [Route("/admin/index")]
    public void Index() {
        string uidStr = this.Ctx().Cookie("zan_admin_uid");
        if (uidStr.Length == 0) {
            this.Redirect("/admin/login");
            return;
        }
        int uid = Convert.ToInt32(uidStr);
        if (uid <= 0) {
            this.Redirect("/admin/login");
            return;
        }

        string nickname = this.Ctx().Cookie("zan_admin_nick");
        if (nickname.Length == 0) { nickname = "管理员"; }

        Dict<string, string> vars = new Dict<string, string>();
        vars["nickname"] = nickname;
        string html = AdminViewEngine.Render("Workbench.html", vars);
        this.Html(html);
    }

    [HttpGet]
    [Route("/admin/dashboard")]
    public void DashboardView() {
        string html = AdminViewEngine.Render("Dashboard.html");
        this.Html(html);
    }

    [HttpGet]
    [Route("/admin/api/menus")]
    public void ApiMenus() {
        string uidStr = this.Ctx().Cookie("zan_admin_uid");
        if (uidStr.Length == 0) {
            this.JsonFail("未登录", "401");
            return;
        }
        int uid = Convert.ToInt32(uidStr);
        if (uid <= 0) {
            this.JsonFail("未登录", "401");
            return;
        }

        IDbConnection conn = AdminApp.Db;
        if (conn == null) {
            conn = AdminApp.OpenDb();
        }

        List<SysRule> menus = UserAuthService.GetUserMenuTree(conn, uid);
        this.Json(Json.Serialize<List<SysRule>>(menus));
    }

    [HttpGet]
    [Route("/admin/api/stats")]
    public void ApiStats() {
        IDbConnection conn = AdminApp.Db;
        if (conn == null) {
            conn = AdminApp.OpenDb();
        }

        SysUserDao userDao = SysUserDao.Of(conn);
        SysDepartmentDao deptDao = SysDepartmentDao.Of(conn);
        SysRoleDao roleDao = SysRoleDao.Of(conn);
        SysLoginLogDao loginLogDao = SysLoginLogDao.Of(conn);
        SysOperationLogDao opLogDao = SysOperationLogDao.Of(conn);

        int users = userDao.Count();
        int depts = deptDao.Count();
        int roles = roleDao.Count();

        ServerMetrics m = ServerMetrics.Global();
        string snapJson = m.SnapshotJson();
        List<ServerErrorDoc> errs = m.RecentErrors(50);
        string errsJson = Json.Serialize<List<ServerErrorDoc>>(errs);
        List<SysLoginLog> recentLogins = loginLogDao.Recent(30);
        List<SysOperationLog> recentOps = opLogDao.Recent(30);
        string loginsJson = Json.Serialize<List<SysLoginLog>>(recentLogins);
        string opsJson = Json.Serialize<List<SysOperationLog>>(recentOps);

        StringBuilder sb = new StringBuilder();
        sb.Append("{\"code\":\"0000\",\"msg\":\"ok\",\"data\":{");
        sb.Append("\"users\":");
        sb.Append(Convert.ToString(users));
        sb.Append(",\"depts\":");
        sb.Append(Convert.ToString(depts));
        sb.Append(",\"roles\":");
        sb.Append(Convert.ToString(roles));
        sb.Append(",\"metrics\":");
        sb.Append(snapJson);
        sb.Append(",\"recent_errors\":");
        sb.Append(errsJson);
        sb.Append(",\"recent_login_logs\":");
        sb.Append(loginsJson);
        sb.Append(",\"recent_operation_logs\":");
        sb.Append(opsJson);
        sb.Append("}}");
        this.Json(sb.ToString());
    }

    [HttpGet]
    [Route("/admin/api/monitor/series")]
    public void ApiMonitorSeries() {
        string secStr = this.Ctx().Query("seconds");
        int seconds = 60;
        if (secStr.Length > 0) {
            seconds = Convert.ToInt32(secStr);
        }
        if (seconds <= 0) { seconds = 60; }
        if (seconds > 300) { seconds = 300; }
        this.Json(ServerMetrics.Global().SeriesJson(seconds));
    }

    [HttpGet]
    [Route("/admin/api/monitor/errors")]
    public void ApiMonitorErrors() {
        List<ServerErrorDoc> errs = ServerMetrics.Global().RecentErrors(100);
        this.Json(Json.Serialize<List<ServerErrorDoc>>(errs));
    }

    [HttpGet]
    [Route("/admin/api/monitor/top_requests")]
    public void ApiMonitorTopRequests() {
        this.Json(ServerMetrics.Global().TopReqJson(50).ToJson());
    }

    [HttpGet]
    [Route("/admin/api/monitor/top_sql")]
    public void ApiMonitorTopSql() {
        this.Json(ServerMetrics.Global().TopSqlJson(50).ToJson());
    }

    [HttpGet]
    [Route("/admin/api/monitor/logs/login")]
    public void ApiMonitorLogsLogin() {
        IDbConnection conn = AdminApp.Db;
        if (conn == null) { conn = AdminApp.OpenDb(); }
        List<SysLoginLog> list = SysLoginLogDao.Of(conn).Recent(100);
        this.Json(Json.Serialize<List<SysLoginLog>>(list));
    }

    [HttpGet]
    [Route("/admin/api/monitor/logs/operation")]
    public void ApiMonitorLogsOperation() {
        IDbConnection conn = AdminApp.Db;
        if (conn == null) { conn = AdminApp.OpenDb(); }
        List<SysOperationLog> list = SysOperationLogDao.Of(conn).Recent(100);
        this.Json(Json.Serialize<List<SysOperationLog>>(list));
    }
}
