using System;
using System.Collections.Generic;
using System.Text;
using System.Web;
using System.Json;
using Zan.Mvc.Admin.Model;
using Zan.Mvc.Admin.UI;

namespace Zan.Mvc.Admin.Web;

/// <summary>
/// 系统登录日志审计控制器
/// </summary>
[Route("/admin/monitor/loginlog")]
[Custom(Authorization = CustomAuthorization.Grant, IsMenu = true, Icon = "history", Perm = PermBit.View)]
[Description("登录日志")]
public class SysLoginLogController : CrudController<SysLoginLog> {
    public SysLoginLogController() : base() {
    }

    protected override TableConfig BuildTableConfig() {
        TableConfig cfg = new TableConfig();
        cfg.Conf.SetKey("id", "登录日志");
        cfg.AddColumn("id", "ID", "number", 60, true, false)
           .AddColumn("username", "登录账号", "input", 120, true, false)
           .AddColumn("ip", "客户端IP", "input", 130, false, false)
           .AddColumn("status", "结果", "dict", 80, true, false)
           .AddColumn("message", "提示消息", "input", 160, false, false)
           .AddColumn("user_agent", "浏览器终端", "input", 240, false, false)
           .AddColumn("created_at", "登录时间", "time", 150, true, false)
           .AddFilter("username", "登录账号", "Input", "搜索用户名")
           .AddTool("批量删除", "Delete", "日志", "Error", true, "400px", "260px")
           .AddTool("导出日志", "Export", "日志", "Default", false, "", "");
        return cfg;
    }

    protected override string OnPage(int page, int pageSize) {
        List<SysLoginLog> list = this.SysLoginLog.OrderBy("id DESC").Page(page, pageSize).ToList();
        int total = this.SysLoginLog.Count();
        SysLoginLogPagedResult res = new SysLoginLogPagedResult(total, list);
        return Json.Serialize<SysLoginLogPagedResult>(res);
    }

    protected override bool OnDelete(int id) {
        return this.SysLoginLog.Delete().W("id = ?").Pi(id).ExecuteAffrows() > 0;
    }

    protected override bool OnBatchDelete(List<int> ids) {
        if (ids.Count == 0) { return true; }
        for (int i = 0; i < ids.Count; i = i + 1) {
            this.SysLoginLog.Delete().W("id = ?").Pi(ids[i]).ExecuteAffrows();
        }
        return true;
    }
}
