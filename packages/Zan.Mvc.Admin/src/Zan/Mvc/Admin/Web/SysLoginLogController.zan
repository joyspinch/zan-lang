using System;
using System.Collections.Generic;
using System.Data;
using System.Web;
using Zan.Mvc.Admin.Dao;
using Zan.Mvc.Admin.Model;
using Zan.Mvc.Admin.UI;
using Zan.Mvc.Admin.Attributes;
using Zan.Mvc.Admin.Security;

namespace Zan.Mvc.Admin.Web;

/// <summary>
/// 系统登录日志控制器。
/// 继承自企业级通用 CRUD 微内核基类 CrudController<SysLoginLog>。
/// 专职负责系统各终端登录审计、身份校验轨迹与暴力破解防御回溯。
/// </summary>
[Description("登录日志")]
[AdminAction(Icon = "log-in", Order = 5)]
public class SysLoginLogController : CrudController<SysLoginLog> {
    private SysLoginLogDao dao;

    public SysLoginLogController(IDbConnection db = null) : base(db != null ? db : GetDb()) {
        this.dao = SysLoginLogDao.Of(this.db);
    }

    private static IDbConnection GetDb() {
        IDbConnection db = AdminApp.Db;
        if (db == null) {
            db = AdminApp.OpenDb();
        }
        return db;
    }

    /// <summary>声明登录审计日志表格规格与列字段</summary>
    protected override TableConfig BuildTableConfig() {
        TableConfig cfg = new TableConfig();
        cfg.Conf.SetKey("id", "登录日志");
        cfg.AddColumn("id", "ID", "number", 60, true, false)
           .AddColumn("user_id", "用户ID", "number", 70, true, false)
           .AddColumn("username", "登录账号", "text", 120, true, false)
           .AddColumn("ip", "登录IP", "text", 130, false, false)
           .AddColumn("status", "登录结果", "tag", 90, true, false)
           .AddColumn("message", "详情与原因", "text", 200, false, false)
           .AddColumn("user_agent", "客户端/浏览器", "text", 220, false, false)
           .AddColumn("created_at", "登录时间", "datetime", 160, true, false)
           .AddFilter("username", "登录账号", "Input", "请输入登录用户名")
           .AddFilter("ip", "IP地址", "Input", "请输入登录IP")
           .AddTool("导出数据", "Export", "日志", "Default", false, "", "");
        return cfg;
    }

    /// <summary>审计日志导出数据源</summary>
    protected override List<Dict<string, string>> OnExportRows() {
        List<SysLoginLog> all = this.dao.Page(1, 2000);
        List<Dict<string, string>> rows = new List<Dict<string, string>>();
        for (int i = 0; i < all.Count; i = i + 1) {
            SysLoginLog log = all[i];
            Dict<string, string> row = new Dict<string, string>();
            row["id"] = Convert.ToString(log.id);
            row["user_id"] = Convert.ToString(log.user_id);
            row["username"] = log.username;
            row["ip"] = log.ip;
            row["status"] = log.status == 1 ? "成功" : "失败";
            row["message"] = log.message;
            row["user_agent"] = log.user_agent;
            row["created_at"] = DateTime.FromUnixSeconds(log.created_at).ToString();
            rows.Add(row);
        }
        return rows;
    }

    /// <summary>声明日志详情规格（登录日志只读）</summary>
    protected override FormView BuildFormView() {
        FormView form = new FormView("登录日志");
        form.AddField("username", "登录账号", "input", true, "账号", 12)
            .AddField("ip", "登录IP", "input", true, "IP", 12)
            .AddField("message", "反馈原因", "input", true, "原因", 12)
            .AddField("user_agent", "终端UA", "textarea", true, "UA", 12);
        return form;
    }

    /// <summary>分页查询日志列表</summary>
    protected override string OnPage(int page, int pageSize) {
        List<SysLoginLog> all = this.dao.Page(page, pageSize);
        int total = this.dao.Count();
        LoginLogPagedResult res = new LoginLogPagedResult(total, all);
        return Json.Serialize<LoginLogPagedResult>(res);
    }

    /// <summary>登录日志由系统自动记录，禁止前端手动插入</summary>
    protected override int OnInsert(SysLoginLog entity) {
        return 0;
    }

    /// <summary>登录日志防篡改不可变，禁止更新</summary>
    protected override int OnUpdate(SysLoginLog entity) {
        return 0;
    }

    /// <summary>单条删除日志记录</summary>
    protected override void OnDelete(int id) {
        this.dao.DeleteById(id);
    }
}
