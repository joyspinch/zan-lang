using System;
using System.Data;
using System.Web;
using Zan.Mvc.Admin.Dao;
using Zan.Mvc.Admin.Model;
using Zan.Mvc.Admin.Installer;
using Zan.Mvc.Admin.UI;

namespace Zan.Mvc.Admin.Web;

/// <summary>
/// 统一管理后台身份认证控制器。
/// 提供登录界面、凭据校验、Session 绑定与注销登出。
/// </summary>
public class AdminAuthController : BaseAdminController {
    [HttpGet]
    [Route("/admin/login")]
    public void LoginPage() {
        string redirectUrl;
        if (InstallGateMiddleware.Check(this.Ctx().path, out redirectUrl) == 302) {
            this.Redirect("/install");
            return;
        }

        string html = AdminViewEngine.Render("Login.html");
        this.Html(html);
    }

    [HttpPost]
    [Route("/admin/api/login")]
    public void ApiLogin() {
        string username = this.In("username");
        string password = this.In("password");

        if (username.Length == 0 || password.Length == 0) {
            this.JsonFail("用户名和密码不能为空");
            return;
        }

        IDbConnection conn = AdminApp.Db;
        if (conn == null) {
            conn = AdminApp.OpenDb();
        }

        SysUserDao userDao = SysUserDao.Of(conn);
        SysUser user = userDao.FindByUsername(username);

        if (user == null) {
            this.JsonFail("用户名或密码错误");
            return;
        }

        string expectedHash = SchemaMigrator.HashPassword(password, "zan_salt_");
        if (user.password_hash != expectedHash) {
            this.JsonFail("用户名或密码错误");
            return;
        }

        if (user.status != 1) {
            this.JsonFail("该账号已被停用，请联系超级管理员");
            return;
        }

        // 写入登录状态 Cookie (有效 24 小时)
        this.Ctx().SetCookie("zan_admin_uid", Convert.ToString(user.id), 86400);
        this.Ctx().SetCookie("zan_admin_name", user.username, 86400);
        this.Ctx().SetCookie("zan_admin_nick", user.nickname, 86400);

        this.JsonSuccess("登录成功");
    }

    [HttpGet]
    [Route("/admin/logout")]
    public void Logout() {
        this.Ctx().SetCookie("zan_admin_uid", "", 0);
        this.Ctx().SetCookie("zan_admin_name", "", 0);
        this.Ctx().SetCookie("zan_admin_nick", "", 0);
        this.Redirect("/admin/login");
    }
}
