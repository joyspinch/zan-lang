using System;
using System.Data;
using System.Web;
using Zan.Mvc.Admin.Dao;
using Zan.Mvc.Admin.Model;
using Zan.Mvc.Admin.Installer;
using Zan.Mvc.Admin.UI;

namespace Zan.Mvc.Admin.Web;

/// <summary>
/// 统一管理后台身份认证控制器。
/// 提供登录界面、凭据校验、Session 绑定与注销登出。
/// </summary>
public class AdminAuthController : BaseAdminController {
    [HttpGet]
    [Route("/admin/login")]
    public void LoginPage() {
        string redirectUrl;
        if (InstallGateMiddleware.Check(this.Ctx().path, out redirectUrl) == 302) {
            this.Redirect("/install");
            return;
        }

        string html = AdminViewEngine.Render("Login.html");
        this.Html(html);
    }

    [HttpPost]
    [Route("/admin/api/login")]
    public void ApiLogin() {
        // 登录接口防暴力破解：单 IP 每分钟最多 10 次尝试
        if (!this.CheckRateLimit("Login", 10, 60)) {
            return;
        }

        string username = this.In("username");
        string password = this.In("password");

        if (username.Length == 0 || password.Length == 0) {
            JsonValue jv = this.Ctx().JsonBody();
            if (jv != null && jv.IsObject()) {
                JsonValue ju = jv.Get("username");
                if (ju != null) { username = ju.AsString(""); }
                JsonValue jp = jv.Get("password");
                if (jp != null) { password = jp.AsString(""); }
            }
        }

        if (username.Length == 0 || password.Length == 0) {
            this.JsonFail("用户名和密码不能为空");
            return;
        }

        IDbConnection conn = AdminApp.Db;
        if (conn == null) {
            conn = AdminApp.OpenDb();
        }

        SysUserDao userDao = SysUserDao.Of(conn);
        SysUser user = userDao.FindByUsername(username);

        string ip = this.Ctx().RemoteIp();
        string ua = this.Ctx().Header("User-Agent");

        if (user == null) {
            SysLoginLogDao.Of(conn).Record(0, username, ip, ua, 0, "用户名不存在");
            this.AuditLog("LoginFailed", "用户名不存在尝试: " + username);
            this.JsonFail("用户名或密码错误");
            return;
        }

        string expectedHash = SchemaMigrator.HashPassword(password, "zan_salt_");
        if (user.password_hash != expectedHash) {
            SysLoginLogDao.Of(conn).Record(user.id, username, ip, ua, 0, "登录密码错误");
            this.AuditLog("LoginFailed", "密码错误尝试: " + username);
            this.JsonFail("用户名或密码错误");
            return;
        }

        if (user.status != 1) {
            SysLoginLogDao.Of(conn).Record(user.id, username, ip, ua, 0, "账号已被停用");
            this.JsonFail("该账号已被停用，请联系超级管理员");
            return;
        }

        // 写入登录状态 Cookie (有效 24 小时) 与 CSRF 令牌
        this.Ctx().SetCookie("zan_admin_uid", Convert.ToString(user.id), 86400);
        this.Ctx().SetCookie("zan_admin_name", user.username, 86400);
        this.Ctx().SetCookie("zan_admin_nick", user.nickname, 86400);
        string csrf = CsrfGuard.GenerateToken(user.id, "admin_session");
        this.Ctx().SetCookieJs(CsrfGuard.CookieName, csrf, 86400);

        SysLoginLogDao.Of(conn).Record(user.id, user.username, ip, ua, 1, "登录成功");
        this.AuditLog("Login", "用户登录成功: " + username);
        this.JsonSuccess("登录成功");
    }

    [HttpGet]
    [Route("/admin/logout")]
    public void Logout() {
        string uidStr = this.Ctx().Cookie("zan_admin_uid");
        string uname = this.Ctx().Cookie("zan_admin_name");
        int uid = uidStr.Length > 0 ? Convert.ToInt32(uidStr) : 0;
        string ip = this.Ctx().RemoteIp();
        string ua = this.Ctx().Header("User-Agent");
        IDbConnection conn = AdminApp.Db;
        if (conn == null) { conn = AdminApp.OpenDb(); }
        if (conn != null && uid > 0) {
            SysLoginLogDao.Of(conn).Record(uid, uname, ip, ua, 1, "主动退出登录");
        }
        this.Ctx().SetCookie("zan_admin_uid", "", 0);
        this.Ctx().SetCookie("zan_admin_name", "", 0);
        this.Ctx().SetCookie("zan_admin_nick", "", 0);
        this.Redirect("/admin/login");
    }
}
