using System;
using System.Collections.Generic;
using Zan.Mvc.Admin.Security;

namespace Zan.Mvc.Admin.Web;

/// <summary>
/// 请求执行上下文（统一用户模型，无任何 hardcoded 管理员特权）。
/// 无论是系统管理操作还是普通业务流转，行为与可见菜单均完全由 RoleIds 与 DataScope 驱动。
/// </summary>
public class AdminContext {
    public int UserId;               // 当前登录用户唯一 ID
    public string Username;          // 当前用户名
    public string Nickname;          // 用户姓名/昵称
    public int DeptId;               // 当前所属部门 ID
    public List<int> RoleIds;        // 当前用户持有的角色 ID 列表
    public DataScope DataScope;      // 当前生效的数据范围
    public long RequestTime;         // 请求开始 Unix 秒时间戳

    public int AdminId {
        get { return this.UserId; }
        set { this.UserId = value; }
    }

    public AdminContext() {
        this.UserId = 0;
        this.Username = "";
        this.Nickname = "";
        this.DeptId = 0;
        this.RoleIds = new List<int>();
        this.DataScope = DataScope.Empty(0);
        this.RequestTime = DateTime.UtcNow().ToUnixSeconds();
    }
}
