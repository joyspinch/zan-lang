using System;
using Zan.Mvc.Admin.Security;

namespace Zan.Mvc.Admin.Web;

/// <summary>
/// 后台当前请求的安全与执行上下文。
/// 业务控制器与服务层仅由此处获取操作人信息，严禁直接抓取底层 HTTP Request。
/// </summary>
public class AdminContext {
    public int AdminId;              // 当前登录用户 ID
    public string Username;          // 当前用户名
    public int RoleId;               // 当前角色 ID
    public int DeptId;               // 当前所属部门 ID
    public bool IsSuper;             // 是否为超级管理员
    public DataScope DataScope;      // 当前生效的数据范围
    public long RequestTime;         // 请求开始 Unix 秒时间戳

    public AdminContext() {
        this.AdminId = 0;
        this.Username = "";
        this.RoleId = 0;
        this.DeptId = 0;
        this.IsSuper = false;
        this.DataScope = DataScope.Empty(0);
        this.RequestTime = DateTime.UtcNow.ToUnixTimeSeconds();
    }
}
