using System;
using System.Collections.Generic;
using System.Text;
using System.Web;
using System.Json;
using Zan.Mvc.Admin.Model;
using Zan.Mvc.Admin.UI;

namespace Zan.Mvc.Admin.Web;

/// <summary>
/// 系统规则与菜单管理控制器
/// </summary>
[Route("/admin/system/rule")]
[Custom(Authorization = CustomAuthorization.Grant, IsMenu = true, Icon = "list-tree", Perm = PermBit.View)]
[Description("菜单权限")]
public class SysRuleController : CrudController<SysRule> {
    public SysRuleController() : base() {
    }

    protected override TableConfig BuildTableConfig() {
        TableConfig cfg = new TableConfig();
        cfg.Conf.SetKey("id", "菜单权限");
        cfg.AddColumn("id", "ID", "number", 60, true, false)
           .AddColumn("pid", "父级ID", "number", 70, true, true)
           .AddColumn("title", "菜单名称", "input", 150, true, true)
           .AddColumn("name", "规则标识", "input", 150, true, true)
           .AddColumn("route", "路由路径", "input", 180, true, true)
           .AddColumn("icon", "图标", "input", 100, false, true)
           .AddColumn("ismenu", "菜单显示", "dict", 90, true, true)
           .AddColumn("weigh", "排序", "number", 70, true, true)
           .AddColumn("status", "状态", "dict", 80, true, true)
           .AddFilter("title", "菜单名称", "Input", "搜索菜单名称")
           .AddTool("添加规则", "Add", "规则", "Primary", false, "600px", "480px")
           .AddTool("批量删除", "Delete", "规则", "Error", true, "400px", "260px")
           .AddTool("导出规则", "Export", "规则", "Default", false, "", "");
        return cfg;
    }

    protected override FormView BuildFormView() {
        FormView form = new FormView("菜单规则");
        form.AddField("pid", "父级节点", "number", true, "0 为顶级节点", 12)
            .AddField("title", "规则标题", "input", true, "显示在菜单上的名称", 12)
            .AddField("name", "唯一标识", "input", true, "例如: system/user", 12)
            .AddField("route", "路由路径", "input", false, "例如: /admin/system/user", 12)
            .AddField("icon", "图标类名", "input", false, "例如: user, shield, settings", 12)
            .AddField("ismenu", "作为菜单项", "radio", true, "1:是,0:否", 6)
            .AddField("weigh", "排序权重", "number", true, "0", 6)
            .AddField("status", "状态", "radio", true, "1:启用,0:停用", 12);
        return form;
    }

    protected override string OnPage(int page, int pageSize) {
        List<SysRule> list = this.SysRule.OrderBy("weigh DESC, id ASC").Page(page, pageSize).ToList();
        int total = this.SysRule.Count();
        SysRulePagedResult res = new SysRulePagedResult(total, list);
        return Json.Serialize<SysRulePagedResult>(res);
    }

    protected override bool OnDelete(int id) {
        return this.SysRule.Delete().W("id = ?").Pi(id).ExecuteAffrows() > 0;
    }

    protected override bool OnBatchDelete(List<int> ids) {
        if (ids.Count == 0) { return true; }
        for (int i = 0; i < ids.Count; i = i + 1) {
            this.SysRule.Delete().W("id = ?").Pi(ids[i]).ExecuteAffrows();
        }
        return true;
    }

    protected override bool OnSave(string body) {
        string title = this.Ctx().form.Get("title");
        string name = this.Ctx().form.Get("name");
        string route = this.Ctx().form.Get("route");
        string icon = this.Ctx().form.Get("icon");
        string pidStr = this.Ctx().form.Get("pid");
        string ismenuStr = this.Ctx().form.Get("ismenu");
        string weighStr = this.Ctx().form.Get("weigh");
        string statusStr = this.Ctx().form.Get("status");

        if (title.Length == 0 || name.Length == 0) { return false; }

        SysRule r = new SysRule();
        r.title = title;
        r.name = name;
        r.route = route;
        r.icon = icon;
        if (pidStr.Length > 0) { try { r.pid = Convert.ToInt32(pidStr); } catch (Exception ex) {} }
        if (ismenuStr.Length > 0) { try { r.ismenu = Convert.ToInt32(ismenuStr); } catch (Exception ex) {} }
        if (weighStr.Length > 0) { try { r.weigh = Convert.ToInt32(weighStr); } catch (Exception ex) {} }
        r.status = 1;
        if (statusStr.Length > 0) { try { r.status = Convert.ToInt32(statusStr); } catch (Exception ex) {} }
        r.created_at = DateTime.UtcNow().ToUnixSeconds();
        return this.SysRule.Insert(r).ExecuteAffrows() > 0;
    }

    protected override bool OnField(int id, string field, string value) {
        if (field == "title" || field == "name" || field == "route" || field == "icon") {
            return this.SysRule.Update().SetS(field, value).W("id = ?").Pi(id).ExecuteAffrows() > 0;
        }
        int iv = 0;
        try { iv = Convert.ToInt32(value); } catch (Exception ex) {}
        return this.SysRule.Update().SetI(field, iv).W("id = ?").Pi(id).ExecuteAffrows() > 0;
    }
}
