using System;
using System.Collections.Generic;
using System.Text;
using System.Web;
using System.Json;
using Zan.Mvc.Admin.Model;
using Zan.Mvc.Admin.UI;

namespace Zan.Mvc.Admin.Web;

/// <summary>
/// 组织机构部门管理控制器
/// </summary>
[Route("/admin/system/dept")]
[Custom(Authorization = CustomAuthorization.Grant, IsMenu = true, Icon = "building", Perm = PermBit.View)]
[Description("部门管理")]
public class SysDepartmentController : CrudController<SysDepartment> {
    public SysDepartmentController() : base() {
    }

    protected override TableConfig BuildTableConfig() {
        TableConfig cfg = new TableConfig();
        cfg.Conf.SetKey("id", "部门管理");
        cfg.AddColumn("id", "ID", "number", 60, true, false)
           .AddColumn("pid", "上级部门ID", "number", 90, true, true)
           .AddColumn("name", "部门名称", "input", 180, true, true)
           .AddColumn("weigh", "排序", "number", 80, true, true)
           .AddColumn("status", "状态", "dict", 80, true, true)
           .AddColumn("created_at", "创建时间", "time", 150, true, false)
           .AddFilter("name", "部门名称", "Input", "搜索部门名称")
           .AddTool("添加部门", "Add", "部门", "Primary", false, "500px", "320px")
           .AddTool("批量删除", "Delete", "部门", "Error", true, "400px", "260px")
           .AddTool("导出部门", "Export", "部门", "Default", false, "", "");
        return cfg;
    }

    protected override FormView BuildFormView() {
        FormView form = new FormView("部门信息");
        form.AddField("pid", "上级部门", "number", true, "0 为顶级部门", 12)
            .AddField("name", "部门名称", "input", true, "请输入部门名称", 12)
            .AddField("weigh", "排序权重", "number", true, "0", 6)
            .AddField("status", "部门状态", "radio", true, "1:正常,0:停用", 6);
        return form;
    }

    protected override string OnPage(int page, int pageSize) {
        List<SysDepartment> list = this.SysDepartment.OrderBy("weigh DESC, id ASC").Page(page, pageSize).ToList();
        int total = this.SysDepartment.Count();
        SysDepartmentPagedResult res = new SysDepartmentPagedResult(total, list);
        return Json.Serialize<SysDepartmentPagedResult>(res);
    }

    protected override bool OnDelete(int id) {
        return this.SysDepartment.Delete().W("id = ?").Pi(id).ExecuteAffrows() > 0;
    }

    protected override bool OnBatchDelete(List<int> ids) {
        if (ids.Count == 0) { return true; }
        for (int i = 0; i < ids.Count; i = i + 1) {
            this.SysDepartment.Delete().W("id = ?").Pi(ids[i]).ExecuteAffrows();
        }
        return true;
    }

    protected override bool OnSave(string body) {
        string name = this.Ctx().form.Get("name");
        string pidStr = this.Ctx().form.Get("pid");
        string weighStr = this.Ctx().form.Get("weigh");
        string statusStr = this.Ctx().form.Get("status");

        if (name.Length == 0) { return false; }
        SysDepartment d = new SysDepartment();
        d.name = name;
        if (pidStr.Length > 0) { try { d.pid = Convert.ToInt32(pidStr); } catch (Exception ex) {} }
        if (weighStr.Length > 0) { try { d.weigh = Convert.ToInt32(weighStr); } catch (Exception ex) {} }
        d.status = 1;
        if (statusStr.Length > 0) { try { d.status = Convert.ToInt32(statusStr); } catch (Exception ex) {} }
        d.created_at = DateTime.UtcNow().ToUnixSeconds();
        return this.SysDepartment.Insert(d).ExecuteAffrows() > 0;
    }

    protected override bool OnField(int id, string field, string value) {
        if (field == "name") {
            return this.SysDepartment.Update().SetS("name", value).W("id = ?").Pi(id).ExecuteAffrows() > 0;
        }
        int iv = 0;
        try { iv = Convert.ToInt32(value); } catch (Exception ex) {}
        return this.SysDepartment.Update().SetI(field, iv).W("id = ?").Pi(id).ExecuteAffrows() > 0;
    }
}
