using System;
using System.Collections.Generic;
using System.Data;
using System.Web;
using Zan.Mvc.Admin.Dao;
using Zan.Mvc.Admin.Model;
using Zan.Mvc.Admin.UI;
using Zan.Mvc.Admin.Attributes;
using Zan.Mvc.Admin.Security;

namespace Zan.Mvc.Admin.Web;

/// <summary>
/// 组织架构部门管理控制器。
/// 继承自企业级通用 CRUD 微内核基类 CrudController<SysDepartment>。
/// 负责维护企业多层级部门组织树、预扁平化树形路径 tree_path 计算与排序权重。
/// </summary>
[AdminModule(Key = "sys", Title = "系统管理", Icon = "setting", Order = 1)]
[AdminAction(Key = "sys:dept", Title = "部门管理", IsMenu = true, Icon = "apartment", Order = 3)]
[Description("部门管理")]
public class SysDepartmentController : CrudController<SysDepartment> {
    private SysDepartmentDao dao;

    public SysDepartmentController(IDbConnection db = null) : base(db != null ? db : GetDb()) {
        this.dao = SysDepartmentDao.Of(this.db);
    }

    private static IDbConnection GetDb() {
        IDbConnection db = AdminApp.Db;
        if (db == null) {
            db = AdminApp.OpenDb();
        }
        return db;
    }

    /// <summary>声明部门表格规格、列定义与操作栏</summary>
    protected override TableConfig BuildTableConfig() {
        TableConfig cfg = new TableConfig();
        cfg.Conf.SetKey("id", "组织部门");
        cfg.Conf.treeData = true;
        cfg.AddColumn("id", "ID", "number", 60, true, false)
           .AddColumn("name", "部门名称", "input", 180, true, true)
           .AddColumn("parent_id", "上级部门", "number", 90, true, false)
           .AddColumn("tree_path", "层级路径", "text", 140, false, false)
           .AddColumn("order_num", "排序权重", "number", 90, true, true)
           .AddFilter("name", "部门名称", "Input", "请输入部门名称搜索")
           .AddTool("新增部门", "Add", "部门", "Primary", false, "500px", "360px")
           .AddTool("批量删除", "Delete", "部门", "Error", true, "400px", "260px");
        return cfg;
    }

    /// <summary>声明部门新增与编辑表单规格</summary>
    protected override FormView BuildFormView() {
        FormView form = new FormView("组织部门");
        form.AddField("name", "部门名称", "input", true, "请输入部门名称", 12)
            .AddField("parent_id", "上级部门编号", "number", true, "0 表示顶级部门", 12)
            .AddField("order_num", "排序权重", "number", true, "数字越小越靠前", 12);
        return form;
    }

    /// <summary>部门分页检索业务逻辑</summary>
    protected override string OnPage(int page, int pageSize) {
        List<SysDepartment> all = this.dao.Page(page, pageSize);
        int total = this.dao.Count();
        DepartmentPagedResult res = new DepartmentPagedResult(total, all);
        return Json.Serialize<DepartmentPagedResult>(res);
    }

    /// <summary>新增部门业务保存并自动计算 tree_path</summary>
    protected override int OnInsert(SysDepartment entity) {
        if (entity.name.Length == 0) {
            return 0;
        }
        if (entity.order_num <= 0) {
            entity.order_num = 100;
        }
        int aff = this.dao.Insert(entity);
        if (aff > 0 && entity.id > 0) {
            // 计算预扁平化树路径
            string path = "/" + Convert.ToString(entity.id) + "/";
            if (entity.parent_id > 0) {
                SysDepartment parent = this.dao.FindById(entity.parent_id);
                if (parent != null) {
                    path = parent.tree_path + Convert.ToString(entity.id) + "/";
                }
            }
            entity.tree_path = path;
            this.dao.Update(entity);
        }
        return aff;
    }

    /// <summary>更新部门业务保存</summary>
    protected override int OnUpdate(SysDepartment entity) {
        SysDepartment d = this.dao.FindById(entity.id);
        if (d == null) {
            return 0;
        }
        d.name = entity.name;
        d.order_num = entity.order_num;
        d.parent_id = entity.parent_id;
        string path = "/" + Convert.ToString(entity.id) + "/";
        if (entity.parent_id > 0) {
            SysDepartment parent = this.dao.FindById(entity.parent_id);
            if (parent != null) {
                path = parent.tree_path + Convert.ToString(entity.id) + "/";
            }
        }
        d.tree_path = path;
        return this.dao.Update(d);
    }

    /// <summary>删除部门业务（含下级部门防护）</summary>
    protected override void OnDelete(int id) {
        if (id == 1) {
            return; // 保护根部门
        }
        List<SysDepartment> children = this.dao.FindChildren(id);
        if (children.Count > 0) {
            return; // 存在下级部门时拒绝级联误删
        }
        this.dao.DeleteById(id);
    }

    /// <summary>行内即时修改字段安全落地</summary>
    protected override bool OnField(int id, string fieldName, string fieldValue) {
        SysDepartment d = this.dao.FindById(id);
        if (d == null) {
            return false;
        }
        if (fieldName == "name") {
            d.name = fieldValue;
        } else if (fieldName == "order_num") {
            d.order_num = Convert.ToInt32(fieldValue);
        } else {
            return false;
        }
        return this.dao.Update(d) > 0;
    }
}
