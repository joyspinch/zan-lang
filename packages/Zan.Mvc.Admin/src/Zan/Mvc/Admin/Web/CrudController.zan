using System;
using System.Collections.Generic;
using System.Text;
using System.Web;
using System.Json;
using Zan.Mvc.Admin.UI;

namespace Zan.Mvc.Admin.Web;

/// <summary>
/// 通用业务 CRUD 控制器基类。
/// 开箱即用提供：配置获取、数据分页、表单定义、行内即时编辑、删除、批量删除与数据导出。
/// </summary>
public class CrudController<T> : BaseAdminController {
    public CrudController() {
    }

    [HttpGet]
    public virtual void Index() {
        string html = this.LoadView("DataGrid");
        this.Ctx().Html(html);
    }

    [HttpGet]
    public virtual void Conf() {
        TableConfig cfg = this.BuildTableConfig();
        this.Ctx().contentType = "application/json; charset=utf-8";
        this.Ctx().body = cfg.ToJson();
        this.Ctx().ended = true;
    }

    [HttpGet]
    public virtual void List() {
        int page = 1;
        int limit = 15;
        string pStr = this.Ctx().query.Get("page");
        string lStr = this.Ctx().query.Get("limit");
        if (pStr.Length > 0) {
            try { page = Convert.ToInt32(pStr); } catch (Exception ex) {}
        }
        if (lStr.Length > 0) {
            try { limit = Convert.ToInt32(lStr); } catch (Exception ex) {}
        }
        if (page < 1) { page = 1; }
        if (limit < 1) { limit = 15; }

        string json = this.OnPage(page, limit);
        this.Ctx().contentType = "application/json; charset=utf-8";
        this.Ctx().body = json;
        this.Ctx().ended = true;
    }

    [HttpGet]
    public virtual void AddConf() {
        FormView form = this.BuildFormView();
        this.Ctx().contentType = "application/json; charset=utf-8";
        this.Ctx().body = form.ToJson();
        this.Ctx().ended = true;
    }

    [HttpGet]
    public virtual void EditConf() {
        string idStr = this.Ctx().query.Get("id");
        int id = 0;
        try { id = Convert.ToInt32(idStr); } catch (Exception ex) {}
        string json = this.OnEditConf(id);
        this.Ctx().contentType = "application/json; charset=utf-8";
        this.Ctx().body = json;
        this.Ctx().ended = true;
    }

    [HttpPost]
    public virtual void Save() {
        string body = this.Ctx().request.body;
        bool ok = this.OnSave(body);
        if (ok) {
            this.JsonSuccess("保存成功");
        } else {
            this.JsonFail("保存失败");
        }
    }

    [HttpPost]
    public virtual void Field() {
        string idStr = this.Ctx().form.Get("id");
        string field = this.Ctx().form.Get("field");
        string value = this.Ctx().form.Get("value");

        int id = 0;
        try { id = Convert.ToInt32(idStr); } catch (Exception ex) {}
        if (id <= 0 || field.Length == 0) {
            this.JsonFail("参数错误");
            return;
        }

        bool ok = this.OnField(id, field, value);
        if (ok) {
            this.AuditLog("UpdateField", "更新字段 " + field + " = " + value + " (ID: " + Convert.ToString(id) + ")");
            this.JsonSuccess("修改成功");
        } else {
            this.JsonFail("修改失败");
        }
    }

    [HttpPost]
    public virtual void Delete() {
        string idStr = this.Ctx().form.Get("id");
        int id = 0;
        try { id = Convert.ToInt32(idStr); } catch (Exception ex) {}
        if (id <= 0) {
            this.JsonFail("无效的记录 ID");
            return;
        }

        bool ok = this.OnDelete(id);
        if (ok) {
            this.AuditLog("Delete", "删除记录 ID: " + Convert.ToString(id));
            this.JsonSuccess("删除成功");
        } else {
            this.JsonFail("删除失败");
        }
    }

    [HttpPost]
    public virtual void BatchDelete() {
        string idsStr = this.Ctx().form.Get("ids");
        if (idsStr.Length == 0) {
            this.JsonFail("请选择需要删除的记录");
            return;
        }

        List<int> ids = new List<int>();
        List<string> parts = idsStr.Split(",");
        for (int i = 0; i < parts.Count; i = i + 1) {
            try {
                int id = Convert.ToInt32(parts[i]);
                if (id > 0) { ids.Add(id); }
            } catch (Exception ex) {}
        }

        if (ids.Count == 0) {
            this.JsonFail("未指定合法的删除记录");
            return;
        }

        bool ok = this.OnBatchDelete(ids);
        if (ok) {
            this.AuditLog("BatchDelete", "批量删除记录: " + idsStr);
            this.JsonSuccess("批量删除成功");
        } else {
            this.JsonFail("部分记录删除失败");
        }
    }

    [HttpGet]
    public virtual void Export() {
        this.Ctx().contentType = "text/csv; charset=utf-8";
        this.Ctx().SetHeader("Content-Disposition", "attachment; filename=\"export.csv\"");
        this.Ctx().body = "\xEF\xBB\xBF" + this.OnExport();
        this.Ctx().ended = true;
    }

    protected virtual TableConfig BuildTableConfig() {
        return new TableConfig();
    }

    protected virtual FormView BuildFormView() {
        return new FormView();
    }

    protected virtual string OnPage(int page, int pageSize) {
        return "{\"total\":0,\"rows\":[]}";
    }

    protected virtual string OnEditConf(int id) {
        FormView form = this.BuildFormView();
        return form.ToJson();
    }

    protected virtual bool OnSave(string body) {
        return true;
    }

    protected virtual bool OnField(int id, string field, string value) {
        return true;
    }

    protected virtual bool OnDelete(int id) {
        return true;
    }

    protected virtual bool OnBatchDelete(List<int> ids) {
        return true;
    }

    protected virtual string OnExport() {
        return "id,name\n";
    }
}
