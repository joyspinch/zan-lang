using System;
using System.Web;
using System.Data;
using System.Data.Excel;
using System.Collections.Generic;
using Zan.Mvc.Admin.Attributes;
using Zan.Mvc.Admin.UI;
using Zan.Mvc.Admin.Data;
using Zan.Mvc.Admin.Security;
using Zan.Mvc.Admin.Model;
using Zan.Mvc.Admin.Validation;

namespace Zan.Mvc.Admin.Web;

/// <summary>
/// 通用企业级业务中台 CRUD 控制器微内核基类。
/// 深度践行“配置下发，配置保存”中台架构哲学：
/// 1. 端点标准化：
///    - Conf (视图配置下发与三级合并)
///    - SaveConf (可视化设计差异持久化)
///    - List (统一分页检索与数据范围隔离)
///    - AddConf / EditConf (动态表单规格下发)
///    - AddSave / EditSave (强类型实体增改保存)
///    - Field (行内单元格即时编辑与安全熔断)
///    - Delete / BatchDelete (单记录与批量删除)
/// 2. 彻底消灭样板代码：业务控制器无需手写模板、手拼 SQL 或维护重复端点，仅需继承本类并声明 TableConfig 与 FormView。
/// 3. 安全防护熔断：内置 FieldSecurityGuard，严防越权篡改核心字段。
/// </summary>
public abstract class CrudController<TEntity> : BaseAdminController {
    protected IDbConnection db;
    protected TableConfig tableConfig;
    protected FormView formView;

    public CrudController(IDbConnection db) {
        this.db = db;
        this.tableConfig = null;
        this.formView = null;
    }

    // =========================================================================
    // 业务生命周期钩子（开箱即用默认实现，子类可按需重写）
    // =========================================================================

    /// <summary>
    /// 子类重写：声明表格基础配置（列定义、筛选器、快捷工具栏）。
    /// 默认提供标准 ID 列、新增与批量删除快捷工具。
    /// </summary>
    protected virtual TableConfig BuildTableConfig() {
        TableConfig cfg = new TableConfig();
        cfg.Conf.SetKey("id", "数据列表");
        cfg.AddColumn("id", "ID", "number", 80, true, false);
        cfg.AddTool("添加", "Add", "数据", "Primary", false, "600px", "400px");
        cfg.AddTool("批量删除", "Delete", "数据", "Error", true, "400px", "260px");
        cfg.AddTool("导出数据", "Export", "数据", "Default", false, "", "");
        return cfg;
    }

    /// <summary>
    /// 子类重写：声明通用表单基础规格（字段类型、验证规则、下拉选项、栅格布局）。
    /// </summary>
    protected virtual FormView BuildFormView() {
        FormView form = new FormView("编辑表单");
        return form;
    }

    /// <summary>
    /// 子类重写：执行分页检索并返回 PagedResult JSON 字符串（由具体实体控制器具化序列化）
    /// </summary>
    protected virtual string OnPage(int page, int pageSize) {
        return "";
    }

    /// <summary>
    /// 子类重写：获取待导出的数据行（字典键对应字段名）。默认返回空列表或由子类提供实现。
    /// </summary>
    protected virtual List<Dict<string, string>> OnExportRows() {
        return new List<Dict<string, string>>();
    }

    /// <summary>
    /// 子类重写：新增保存业务落地钩子（默认通过 ORM 自动插入）
    /// </summary>
    protected virtual int OnInsert(TEntity entity) {
        if (this.db == null || entity == null) { return 0; }
        return this.db.Insert<TEntity>(entity).ExecuteAffrows();
    }

    /// <summary>
    /// 子类重写：编辑保存业务落地钩子（默认通过 ORM 自动全字段更新）
    /// </summary>
    protected virtual int OnUpdate(TEntity entity) {
        if (this.db == null || entity == null) { return 0; }
        return this.db.Update<TEntity>().SetSource(entity).ExecuteAffrows();
    }

    /// <summary>
    /// 子类重写：单记录删除钩子（默认通过 ORM 自动按主键删除）
    /// </summary>
    protected virtual void OnDelete(int id) {
        if (this.db == null || id <= 0) { return; }
        this.db.Delete<TEntity>().W("id = ?").Pi(id).ExecuteAffrows();
    }

    /// <summary>
    /// 子类重写：批量删除钩子（默认通过 ORM 自动按 ID 数组向量化删除）
    /// </summary>
    protected virtual int OnBatchDelete(List<int> ids) {
        if (this.db == null || ids == null || ids.Count == 0) { return 0; }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < ids.Count; i = i + 1) {
            if (i > 0) { sb.Append(", "); }
            sb.Append("?");
        }
        return this.db.Delete<TEntity>()
            .W("id IN (" + sb.ToString() + ")")
            .InI(ids)
            .ExecuteAffrows();
    }

    /// <summary>
    /// 子类重写：行内单元格即时修改业务落地钩子（通过实体或 ORM 安全更新）
    /// </summary>
    protected virtual bool OnField(int id, string fieldName, string fieldValue) {
        return false;
    }

    /// <summary>
    /// 子类重写：提供结构化数据验证器（AddSave / EditSave 自动执行校验）
    /// </summary>
    protected virtual BaseValidator GetValidator() {
        return null;
    }

    // =========================================================================
    // 配置解析与三级合并引擎
    // =========================================================================

    /// <summary>
    /// 获取当前路由下的生效表格配置（代码基线 ⊕ 数据库持久化差异）
    /// </summary>
    public TableConfig GetTableConfig(string route = "") {
        if (this.tableConfig == null) {
            this.tableConfig = this.BuildTableConfig();
        }
        string r = route;
        if (r.Length == 0 && this.Ctx() != null) {
            r = this.Ctx().path;
        }
        if (r.Length > 0) {
            string diffJson = ConfigStorage.GetConfig(this.db, r);
            if (diffJson.Length > 0) {
                this.tableConfig.ApplyDiff(diffJson);
            }
        }
        return this.tableConfig;
    }

    /// <summary>
    /// 获取当前表单规格
    /// </summary>
    public FormView GetFormView() {
        if (this.formView == null) {
            this.formView = this.BuildFormView();
        }
        return this.formView;
    }

    // =========================================================================
    // 标准化中台 CRUD 协议端点
    // =========================================================================

    /// <summary>
    /// 端点 0：默认首页/网格视图入口（约定路由根路径，如 /admin/sys/dept）
    /// </summary>
    public virtual void Index() {
        if (this.Ctx() != null && (this.In("format") == "json" || this.Ctx().Header("X-Requested-With") == "XMLHttpRequest")) {
            this.Conf();
            return;
        }
        string curRoute = this.Ctx() != null ? this.Ctx().path : "";
        TableConfig cfg = this.GetTableConfig(curRoute);
        Dict<string, string> vars = new Dict<string, string>();
        vars["schemaJson"] = cfg.ToJson();
        string html = AdminViewEngine.Render("DataGrid.html", vars);
        this.Html(html);
    }

    /// <summary>
    /// 新增记录表单页面视图入口
    /// </summary>
    public virtual void Add() {
        FormView view = this.GetFormView();
        Dict<string, string> vars = new Dict<string, string>();
        vars["formSchemaJson"] = view.ToJson();
        string html = AdminViewEngine.Render("FormView.html", vars);
        this.Html(html);
    }

    /// <summary>
    /// 编辑记录表单页面视图入口
    /// </summary>
    public virtual void Edit() {
        FormView view = this.GetFormView();
        Dict<string, string> vars = new Dict<string, string>();
        vars["formSchemaJson"] = view.ToJson();
        string html = AdminViewEngine.Render("FormView.html", vars);
        this.Html(html);
    }

    /// <summary>
    /// 端点 1：下发数据网格与检索配置（支持三级合并）
    /// </summary>
    public virtual void Conf(string route = "") {
        TableConfig cfg = this.GetTableConfig(route);
        ApiResponse r = ApiResponse.OkData(cfg.ToJson(), "ok");
        if (this.Ctx() != null) {
            this.Json(Json.Serialize<ApiResponse>(r));
        }
    }

    /// <summary>
    /// 端点 2：保存前端可视化调整（列宽、排序、隐藏、设计器）的差异配置
    /// </summary>
    public virtual void SaveConf(string route, string diffJson) {
        if (route == null || route.Length == 0 || diffJson == null || diffJson.Length == 0) {
            this.JsonFail("路由与配置内容不能为空", "4001");
            return;
        }
        ConfigStorage.SaveConfig(this.db, route, diffJson);
        this.AuditLog("SaveConf", "保存表格视图配置: " + route);
        this.JsonSuccess("视图配置已保存");
    }

    /// <summary>
    /// 端点 3：标准分页数据检索（对接通用 DataTable / 前端网格）
    /// </summary>
    public virtual void List() {
        int page = 1;
        int pageSize = 20;
        if (this.Ctx() != null) {
            page = this.InInt("page", 1);
            pageSize = this.InInt("pageSize", 20);
        }
        string dataJson = this.OnPage(page, pageSize);
        if (dataJson != null && dataJson.Length > 0) {
            this.JsonSuccessData(dataJson);
        } else {
            this.JsonFail("分页查询未配置或实现", "5003");
        }
    }

    /// <summary>
    /// 端点 4：下发新增表单规格 Schema
    /// </summary>
    public virtual void AddConf() {
        FormView view = this.GetFormView();
        ApiResponse r = ApiResponse.OkData(view.ToJson(), "ok");
        if (this.Ctx() != null) {
            this.Json(Json.Serialize<ApiResponse>(r));
        }
    }

    /// <summary>
    /// 端点 5：下发编辑表单规格 Schema
    /// </summary>
    public virtual void EditConf() {
        FormView view = this.GetFormView();
        ApiResponse r = ApiResponse.OkData(view.ToJson(), "ok");
        if (this.Ctx() != null) {
            this.Json(Json.Serialize<ApiResponse>(r));
        }
    }

    /// <summary>
    /// 端点 6：通用新增保存
    /// </summary>
    public virtual void AddSave(TEntity entity) {
        if (!this.VerifyCsrf()) { return; }
        if (!this.CheckRateLimit("AddSave", 30, 60)) { return; }
        if (entity == null) {
            this.JsonFail("提交数据不能为空", "4002");
            return;
        }
        BaseValidator validator = this.GetValidator();
        if (validator != null && this.Ctx() != null) {
            JsonValue j = this.Ctx().JsonBody();
            if (j != null && !this.ValidateJson(validator, j, "add")) {
                return;
            }
        }
        int aff = this.OnInsert(entity);
        if (aff > 0) {
            this.AuditLog("AddSave", "新增实体成功");
            this.JsonSuccess("新增成功");
        } else {
            this.JsonFail("新增失败", "5001");
        }
    }

    /// <summary>
    /// 端点 7：通用编辑保存
    /// </summary>
    public virtual void EditSave(TEntity entity) {
        if (!this.VerifyCsrf()) { return; }
        if (!this.CheckRateLimit("EditSave", 60, 60)) { return; }
        if (entity == null) {
            this.JsonFail("提交数据不能为空", "4002");
            return;
        }
        BaseValidator validator = this.GetValidator();
        if (validator != null && this.Ctx() != null) {
            JsonValue j = this.Ctx().JsonBody();
            if (j != null && !this.ValidateJson(validator, j, "edit")) {
                return;
            }
        }
        int aff = this.OnUpdate(entity);
        if (aff > 0) {
            this.AuditLog("EditSave", "更新实体成功");
            this.JsonSuccess("保存成功");
        } else {
            this.JsonFail("保存失败或数据无变化", "5002");
        }
    }

    /// <summary>
    /// 端点 8：单元格行内即时修改（安全熔断保护）
    /// 严禁越权修改密码、金额、部门、主键等高危列。通过子类 OnField 业务钩子安全落地。
    /// </summary>
    public virtual void Field(int id, string fieldName, string fieldValue) {
        if (!this.VerifyCsrf()) { return; }
        if (!this.CheckRateLimit("Field", 120, 60)) { return; }
        TableConfig cfg = this.GetTableConfig();
        if (!FieldSecurityGuard.CanInlineEdit(fieldName, cfg)) {
            this.AuditLog("SecurityAlert", "非法越权尝试修改受保护字段: " + fieldName);
            this.JsonFail("安全拦截：字段 '" + fieldName + "' 不支持即时修改", "4031");
            return;
        }
        BaseValidator validator = this.GetValidator();
        if (validator != null) {
            Dict<string, string> fieldMap = new Dict<string, string>();
            fieldMap[fieldName] = fieldValue;
            if (!this.Validate(validator, fieldMap, "")) {
                return;
            }
        }

        bool ok = this.OnField(id, fieldName, fieldValue);
        if (ok) {
            this.AuditLog("FieldUpdate", "更新字段 " + fieldName + " 为 " + fieldValue + " (ID: " + Convert.ToString(id) + ")");
            this.JsonSuccess("修改成功");
        } else {
            this.JsonFail("修改失败，记录不存在或业务未支持", "4041");
        }
    }

    /// <summary>
    /// 端点 9：单记录删除
    /// </summary>
    public virtual void Delete(int id) {
        if (!this.VerifyCsrf()) { return; }
        if (!this.CheckRateLimit("Delete", 30, 60)) { return; }
        this.OnDelete(id);
        this.AuditLog("Delete", "删除记录 ID: " + Convert.ToString(id));
        this.JsonSuccess("删除成功");
    }

    /// <summary>
    /// 端点 10：批量删除（支持逗号分隔 ID 串）
    /// </summary>
    public virtual void BatchDelete(string ids) {
        if (!this.VerifyCsrf()) { return; }
        if (!this.CheckRateLimit("BatchDelete", 20, 60)) { return; }
        if (ids == null || ids.Length == 0) {
            this.JsonFail("请选择需要删除的记录", "4003");
            return;
        }
        List<string> parts = ids.Split(",");
        List<int> idList = new List<int>();
        for (int i = 0; i < parts.Count; i = i + 1) {
            string part = parts[i].Trim();
            if (part.Length > 0) {
                int id = Convert.ToInt32(part);
                if (id > 0) {
                    idList.Add(id);
                }
            }
        }
        if (idList.Count == 0) {
            this.JsonFail("有效记录 ID 为空", "4003");
            return;
        }
        int count = this.OnBatchDelete(idList);
        this.AuditLog("BatchDelete", "批量删除 " + Convert.ToString(count) + " 条记录: " + ids);
        this.JsonSuccess("成功删除 " + Convert.ToString(count) + " 条数据");
    }

    /// <summary>
    /// 端点 11：通用数据导出
    /// 支持双重导出格式：
    /// 1. 默认 RFC 4180 标准 CSV，首部注入 UTF-8 BOM 解决 Excel 打开中文乱码；
    /// 2. 当 URL 参数携带 format=xlsx 或 format=excel 时，自动流式生成原生 .xlsx 压缩二进制包输出。
    /// 支持按当前 TableConfig 列规格自动对齐字段，数据源由子类 OnExportRows() 生命周期钩子提供。
    /// </summary>
    public virtual void Export() {
        if (!this.CheckRateLimit("Export", 10, 60)) { return; }

        string fmt = "";
        if (this.Ctx() != null) {
            fmt = this.Ctx().Query("format").ToLower();
        }
        if (fmt == "xlsx" || fmt == "excel") {
            this.ExportXlsx();
            return;
        }

        TableConfig cfg = this.GetTableConfig();
        List<Dict<string, string>> rows = this.OnExportRows();

        StringBuilder sb = new StringBuilder();
        // 注入 UTF-8 BOM (\uFEFF)
        sb.Append("\uFEFF");

        // 1. 生成表头
        for (int i = 0; i < cfg.Columns.Count; i = i + 1) {
            TableColumn col = cfg.Columns[i];
            if (i > 0) { sb.Append(","); }
            sb.Append(this.EscapeCsv(col.headerName));
        }
        sb.Append("\r\n");

        // 2. 生成每一行数据
        for (int r = 0; r < rows.Count; r = r + 1) {
            Dict<string, string> row = rows[r];
            for (int c = 0; c < cfg.Columns.Count; c = c + 1) {
                TableColumn col = cfg.Columns[c];
                if (c > 0) { sb.Append(","); }
                string val = "";
                if (row != null && row.ContainsKey(col.field)) {
                    val = row[col.field];
                }
                sb.Append(this.EscapeCsv(val));
            }
            sb.Append("\r\n");
        }

        this.AuditLog("Export", "导出 CSV 数据报表, 共 " + Convert.ToString(rows.Count) + " 行");

        if (this.Ctx() != null) {
            this.Ctx().SetHeader("Content-Type", "text/csv; charset=utf-8");
            this.Ctx().SetHeader("Content-Disposition", "attachment; filename=\"export_" + Convert.ToString(DateTime.Now().ToUnixSeconds()) + ".csv\"");
            this.Text(sb.ToString());
        }
    }

    /// <summary>
    /// 端点 12：生成原生 Microsoft Excel (.xlsx) OpenXML 二进制格式报表
    /// 基于 stdlib 中的 System.Data.Excel.XlsxBook 纯 Zan 压缩生成器，原生兼容 Office 与 WPS
    /// </summary>
    public virtual void ExportXlsx() {
        if (!this.CheckRateLimit("Export", 10, 60)) { return; }
        TableConfig cfg = this.GetTableConfig();
        List<Dict<string, string>> rows = this.OnExportRows();

        List<List<string>> matrix = new List<List<string>>();
        List<string> header = new List<string>();
        for (int i = 0; i < cfg.Columns.Count; i = i + 1) {
            header.Add(cfg.Columns[i].headerName);
        }
        matrix.Add(header);

        for (int r = 0; r < rows.Count; r = r + 1) {
            Dict<string, string> row = rows[r];
            List<string> line = new List<string>();
            for (int c = 0; c < cfg.Columns.Count; c = c + 1) {
                TableColumn col = cfg.Columns[c];
                string val = "";
                if (row != null && row.ContainsKey(col.field)) {
                    val = row[col.field];
                }
                line.Add(val);
            }
            matrix.Add(line);
        }

        XlsxBook book = XlsxBook.FromText(matrix, true);
        byte[] bytes = book.SaveToBytes();

        this.AuditLog("ExportXlsx", "导出 Excel (.xlsx) 原生报表, 共 " + Convert.ToString(rows.Count) + " 行");

        if (this.Ctx() != null) {
            this.Ctx().SetHeader("Content-Disposition", "attachment; filename=\"export_" + Convert.ToString(DateTime.Now().ToUnixSeconds()) + ".xlsx\"");
            this.Ctx().Binary("application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", bytes, bytes.Length);
        }
    }

    /// <summary>
    /// 对 CSV 字段内容按 RFC 4180 标准进行转义
    /// </summary>
    protected virtual string EscapeCsv(string val) {
        if (val == null) { return "\"\""; }
        bool needQuotes = false;
        if (val.Contains(",") || val.Contains("\"") || val.Contains("\n") || val.Contains("\r")) {
            needQuotes = true;
        }
        string escaped = val.Replace("\"", "\"\"");
        if (needQuotes) {
            return "\"" + escaped + "\"";
        }
        return escaped;
    }
}

/// <summary>
/// 兼容别名：历史代码中习惯写成 CurdController 的场景无缝平滑兼容。
/// </summary>
public abstract class CurdController<TEntity> : CrudController<TEntity> {
    public CurdController(IDbConnection db) : base(db) {
    }
}
