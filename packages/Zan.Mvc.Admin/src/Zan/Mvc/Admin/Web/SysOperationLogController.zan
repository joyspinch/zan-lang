using System;
using System.Collections.Generic;
using System.Text;
using System.Web;
using System.Json;
using Zan.Mvc.Admin.Model;
using Zan.Mvc.Admin.UI;

namespace Zan.Mvc.Admin.Web;

/// <summary>
/// 系统操作审计日志控制器
/// </summary>
[Route("/admin/monitor/oplog")]
[Custom(Authorization = CustomAuthorization.Grant, IsMenu = true, Icon = "file-text", Perm = PermBit.View)]
[Description("操作日志")]
public class SysOperationLogController : CrudController<SysOperationLog> {
    public SysOperationLogController() : base() {
    }

    protected override TableConfig BuildTableConfig() {
        TableConfig cfg = new TableConfig();
        cfg.Conf.SetKey("id", "操作日志");
        cfg.AddColumn("id", "ID", "number", 60, true, false)
           .AddColumn("user_id", "操作人UID", "number", 90, true, false)
           .AddColumn("action", "操作动作", "input", 150, true, false)
           .AddColumn("detail", "详细记录", "input", 260, false, false)
           .AddColumn("ip", "IP地址", "input", 130, false, false)
           .AddColumn("created_at", "操作时间", "time", 150, true, false)
           .AddFilter("action", "操作动作", "Input", "搜索动作")
           .AddTool("批量删除", "Delete", "日志", "Error", true, "400px", "260px")
           .AddTool("导出日志", "Export", "日志", "Default", false, "", "");
        return cfg;
    }

    protected override string OnPage(int page, int pageSize) {
        List<SysOperationLog> list = this.SysOperationLog.OrderBy("id DESC").Page(page, pageSize).ToList();
        int total = this.SysOperationLog.Count();
        SysOperationLogPagedResult res = new SysOperationLogPagedResult(total, list);
        return Json.Serialize<SysOperationLogPagedResult>(res);
    }

    protected override bool OnDelete(int id) {
        return this.SysOperationLog.Delete().W("id = ?").Pi(id).ExecuteAffrows() > 0;
    }

    protected override bool OnBatchDelete(List<int> ids) {
        if (ids.Count == 0) { return true; }
        for (int i = 0; i < ids.Count; i = i + 1) {
            this.SysOperationLog.Delete().W("id = ?").Pi(ids[i]).ExecuteAffrows();
        }
        return true;
    }
}
