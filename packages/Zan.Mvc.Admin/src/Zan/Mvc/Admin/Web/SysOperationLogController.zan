using System;
using System.Collections.Generic;
using System.Data;
using System.Web;
using Zan.Mvc.Admin.Dao;
using Zan.Mvc.Admin.Model;
using Zan.Mvc.Admin.UI;
using Zan.Mvc.Admin.Attributes;
using Zan.Mvc.Admin.Security;

namespace Zan.Mvc.Admin.Web;

/// <summary>
/// 系统操作审计日志控制器。
/// 继承自企业级通用 CRUD 微内核基类 CrudController<SysOperationLog>。
/// 专职负责系统各业务模块操作审计记录检索、回溯与归档清理。
/// </summary>
[Description("操作日志")]
[AdminAction(Icon = "file-text", Order = 4)]
public class SysOperationLogController : CrudController<SysOperationLog> {
    private SysOperationLogDao dao;

    public SysOperationLogController(IDbConnection db = null) : base(db != null ? db : GetDb()) {
        this.dao = SysOperationLogDao.Of(this.db);
    }

    private static IDbConnection GetDb() {
        IDbConnection db = AdminApp.Db;
        if (db == null) {
            db = AdminApp.OpenDb();
        }
        return db;
    }

    /// <summary>声明操作审计日志表格规格与列字段</summary>
    protected override TableConfig BuildTableConfig() {
        TableConfig cfg = new TableConfig();
        cfg.Conf.SetKey("id", "操作日志");
        cfg.AddColumn("id", "ID", "number", 60, true, false)
           .AddColumn("admin_id", "操作人ID", "number", 80, true, false)
           .AddColumn("action", "操作动作", "text", 130, true, false)
           .AddColumn("detail", "操作详情", "text", 260, false, false)
           .AddColumn("ip", "请求IP", "text", 120, false, false)
           .AddColumn("created_at", "操作时间", "datetime", 160, true, false)
           .AddFilter("action", "操作动作", "Input", "请输入动作名称")
           .AddFilter("ip", "IP地址", "Input", "请输入操作人IP")
           .AddTool("批量删除", "Delete", "日志", "Error", true, "400px", "260px");
        return cfg;
    }

    /// <summary>声明日志详情规格（审计日志只读，不可手动通过表单新增）</summary>
    protected override FormView BuildFormView() {
        FormView form = new FormView("操作日志");
        form.AddField("action", "操作动作", "input", true, "动作", 12)
            .AddField("detail", "操作详情", "textarea", true, "详情", 12)
            .AddField("ip", "操作IP", "input", true, "IP", 12);
        return form;
    }

    /// <summary>分页查询日志列表</summary>
    protected override string OnPage(int page, int pageSize) {
        List<SysOperationLog> all = this.dao.Page(page, pageSize);
        int total = this.dao.Count();
        OperationLogPagedResult res = new OperationLogPagedResult(total, all);
        return Json.Serialize<OperationLogPagedResult>(res);
    }

    /// <summary>审计日志由系统自动记录，禁止前端手动插入</summary>
    protected override int OnInsert(SysOperationLog entity) {
        return 0;
    }

    /// <summary>审计日志防篡改不可变，禁止更新</summary>
    protected override int OnUpdate(SysOperationLog entity) {
        return 0;
    }

    /// <summary>单条删除日志记录</summary>
    protected override void OnDelete(int id) {
        this.dao.DeleteById(id);
    }
}
