using System;
using System.Json;

namespace Zan.Mvc.Admin.Model;

public class ApiResponse {
    public int code;
    public string msg;
    public string data;

    public ApiResponse() {
        this.code = 0;
        this.msg = "";
        this.data = "";
    }

    public ApiResponse(int code, string msg, string data = "") {
        this.code = code;
        this.msg = msg;
        this.data = data;
    }
}
