using System;

namespace Zan.Mvc.Admin.Model;

/// <summary>
/// 标准统一 API 响应对象（强类型 DTO，由编译器自动生成序列化器）。
/// 彻底替代手动拼接字符串或 JsonValue 动态组装，享受全量 IDE 自动补全与类型检查。
/// </summary>
public class ApiResponse {
    public string code;
    public string msg;
    public string data;

    public ApiResponse() {
        this.code = "0000";
        this.msg = "";
        this.data = "";
    }

    public static ApiResponse Ok(string msg = "操作成功") {
        ApiResponse r = new ApiResponse();
        r.code = "0000";
        r.msg = msg;
        r.data = "";
        return r;
    }

    public static ApiResponse Fail(string msg = "操作失败", string code = "9999") {
        ApiResponse r = new ApiResponse();
        r.code = code;
        r.msg = msg;
        r.data = "";
        return r;
    }
}
