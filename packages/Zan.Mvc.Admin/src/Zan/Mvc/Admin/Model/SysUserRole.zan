using System;
using System.Data.Orm;

namespace Zan.Mvc.Admin.Model;

/// <summary>
/// 用户-角色映射实体（CodeFirst 模型映射 sys_user_role 表）。
/// </summary>
[Table(Name = "sys_user_role")]
[Index(Name = "ix_sys_user_role_role", Fields = "role_id")]
public class SysUserRole {
    [Column(IsPrimary = true)]
    public int user_id;
    [Column(IsPrimary = true)]
    public int role_id;

    public SysUserRole() {
        this.user_id = 0;
        this.role_id = 0;
    }
}
