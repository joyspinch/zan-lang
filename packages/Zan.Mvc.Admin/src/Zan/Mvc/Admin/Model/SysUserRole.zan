using System;
using System.Data.Orm;

namespace Zan.Mvc.Admin.Model;

/// <summary>
/// 用户-角色关联实体
/// </summary>
[Table("sys_user_roles")]
public class SysUserRole {
    [Column("id", IsPrimaryKey = true, IsIdentity = true)]
    public int id;

    [Column("user_id")]
    public int user_id;

    [Column("role_id")]
    public int role_id;

    public SysUserRole() {
        this.id = 0;
        this.user_id = 0;
        this.role_id = 0;
    }
}
