using System;
using System.Data.Orm;

namespace Zan.Mvc.Admin.Model;

/// <summary>
/// 系统部门实体
/// </summary>
[Table("sys_departments")]
public class SysDepartment {
    [Column("id", IsPrimaryKey = true, IsIdentity = true)]
    public int id;

    [Column("pid")]
    public int pid;

    [Column("name")]
    public string name;

    [Column("weigh")]
    public int weigh;

    [Column("status")]
    public int status;

    [Column("created_at")]
    public long created_at;

    public SysDepartment() {
        this.id = 0;
        this.pid = 0;
        this.name = "";
        this.weigh = 0;
        this.status = 1;
        this.created_at = 0;
    }
}
