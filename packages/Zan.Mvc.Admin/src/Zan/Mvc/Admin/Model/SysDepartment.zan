using System;
using System.Data.Orm;

namespace Zan.Mvc.Admin.Model;

/// <summary>
/// 部门组织实体（CodeFirst 模型映射 sys_departments 表）。
/// 支持预扁平化树形路径与排序。
/// </summary>
[Table(Name = "sys_departments")]
[Index(Name = "ix_sys_depts_parent", Fields = "parent_id")]
[Index(Name = "ix_sys_depts_path", Fields = "tree_path")]
public class SysDepartment {
    [Column(IsIdentity = true, IsPrimary = true)]
    public int id;
    public int parent_id;
    [Column(StringLength = 64)]
    public string name;
    [Column(StringLength = 255)]
    public string tree_path;
    public int order_num;

    public SysDepartment() {
        this.id = 0;
        this.parent_id = 0;
        this.name = "";
        this.tree_path = "";
        this.order_num = 100;
    }
}
