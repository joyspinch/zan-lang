using System;
using System.Data.Orm;

namespace Zan.Mvc.Admin.Model;

/// <summary>
/// 角色-权限关联实体
/// </summary>
[Table("sys_role_rules")]
public class SysRoleRule {
    [Column("id", IsPrimaryKey = true, IsIdentity = true)]
    public int id;

    [Column("role_id")]
    public int role_id;

    [Column("rule_id")]
    public int rule_id;

    public SysRoleRule() {
        this.id = 0;
        this.role_id = 0;
        this.rule_id = 0;
    }
}
