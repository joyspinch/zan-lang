using System;
using System.Data.Orm;

namespace Zan.Mvc.Admin.Model;

/// <summary>
/// 角色-权限规则映射实体（CodeFirst 模型映射 sys_role_rule 表）。
/// </summary>
[Table(Name = "sys_role_rule")]
public class SysRoleRule {
    [Column(IsPrimary = true)]
    public int role_id;
    [Column(IsPrimary = true)]
    public int rule_id;

    public SysRoleRule() {
        this.role_id = 0;
        this.rule_id = 0;
    }
}
