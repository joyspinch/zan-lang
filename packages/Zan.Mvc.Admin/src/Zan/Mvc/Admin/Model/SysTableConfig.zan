using System;
using System.Data.Orm;

namespace Zan.Mvc.Admin.Model;

/// <summary>
/// 表格与表单视图个性化配置实体（ORM 映射表 sys_table_configs）。
/// 纯实体驱动，模型生表，杜绝手写 DDL 与 raw SQL。
/// </summary>
[Table(Name = "sys_table_configs")]
[Index(Name = "ux_sys_tblcfg_route", Fields = "route", IsUnique = true)]
public class SysTableConfig {
    [Column(IsIdentity = true, IsPrimary = true)]
    public int id;
    [Column(StringLength = 128)]
    public string route;
    public string config_json;
    public long updated_at;

    public SysTableConfig() {
        this.id = 0;
        this.route = "";
        this.config_json = "";
        this.updated_at = 0;
    }
}
