using System;
using System.Data.Orm;

namespace Zan.Mvc.Admin.Model;

/// <summary>
/// 系统管理员用户实体
/// </summary>
[Table("sys_users")]
public class SysUser {
    [Column("id", IsPrimaryKey = true, IsIdentity = true)]
    public int id;

    [Column("username")]
    public string username;

    [Column("nickname")]
    public string nickname;

    [Column("password_hash")]
    public string password_hash;

    [Column("salt")]
    public string salt;

    [Column("dept_id")]
    public int dept_id;

    [Column("mobile")]
    public string mobile;

    [Column("email")]
    public string email;

    [Column("avatar")]
    public string avatar;

    [Column("status")]
    public int status;

    [Column("created_at")]
    public long created_at;

    [Column("last_login_time")]
    public long last_login_time;

    [Column("last_login_ip")]
    public string last_login_ip;

    public SysUser() {
        this.id = 0;
        this.username = "";
        this.nickname = "";
        this.password_hash = "";
        this.salt = "";
        this.dept_id = 0;
        this.mobile = "";
        this.email = "";
        this.avatar = "";
        this.status = 1;
        this.created_at = 0;
        this.last_login_time = 0;
        this.last_login_ip = "";
    }
}
