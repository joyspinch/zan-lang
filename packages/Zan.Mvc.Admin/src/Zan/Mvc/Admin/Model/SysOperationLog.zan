using System;
using System.Data.Orm;

namespace Zan.Mvc.Admin.Model;

/// <summary>
/// 系统操作审计日志实体
/// </summary>
[Table("sys_operation_logs")]
public class SysOperationLog {
    [Column("id", IsPrimaryKey = true, IsIdentity = true)]
    public int id;

    [Column("user_id")]
    public int user_id;

    [Column("action")]
    public string action;

    [Column("detail")]
    public string detail;

    [Column("ip")]
    public string ip;

    [Column("created_at")]
    public long created_at;

    public SysOperationLog() {
        this.id = 0;
        this.user_id = 0;
        this.action = "";
        this.detail = "";
        this.ip = "";
        this.created_at = 0;
    }
}
