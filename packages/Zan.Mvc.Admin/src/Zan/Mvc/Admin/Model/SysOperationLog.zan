using System;
using System.Data.Orm;

namespace Zan.Mvc.Admin.Model;

/// <summary>
/// 操作审计日志实体（CodeFirst 模型映射 sys_operation_logs 表）。
/// </summary>
[Table(Name = "sys_operation_logs")]
public class SysOperationLog {
    [Column(IsIdentity = true, IsPrimary = true)]
    public int id;
    public int admin_id;
    [Column(StringLength = 64)]
    public string action;
    public string detail;
    [Column(StringLength = 45)]
    public string ip;
    public long created_at;

    public SysOperationLog() {
        this.id = 0;
        this.admin_id = 0;
        this.action = "";
        this.detail = "";
        this.ip = "";
        this.created_at = 0;
    }
}
