using System;
using System.Collections.Generic;
using System.Data.Orm;

namespace Zan.Mvc.Admin.Model;

/// <summary>
/// 权限规则与菜单实体（CodeFirst 模型映射 sys_rules 表）。
/// 支持多级树形自关联，用户可见菜单由绑定的角色规则动态计算。
/// </summary>
[Table(Name = "sys_rules")]
[Index(Name = "ux_sys_rules_key", Fields = "key", IsUnique = true)]
[Index(Name = "ix_sys_rules_parent", Fields = "parent_id")]
[Index(Name = "ix_sys_rules_route_method", Fields = "route,method")]
public class SysRule {
    [Column(IsIdentity = true, IsPrimary = true)]
    public int id;
    public int parent_id;
    [Column(StringLength = 128)]
    public string key;
    [Column(StringLength = 128)]
    public string title;
    [Column(StringLength = 255)]
    public string route;
    [Column(StringLength = 16)]
    public string method;
    public bool is_menu;
    [Column(StringLength = 64)]
    public string icon;
    public int order_num;
    public List<SysRule> children;

    public SysRule() {
        this.id = 0;
        this.parent_id = 0;
        this.key = "";
        this.title = "";
        this.route = "";
        this.method = "GET";
        this.is_menu = false;
        this.icon = "grid";
        this.order_num = 100;
        this.children = new List<SysRule>();
    }
}
