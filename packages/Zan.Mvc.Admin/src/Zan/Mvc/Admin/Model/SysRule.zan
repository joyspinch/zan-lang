using System;
using System.Data.Orm;

namespace Zan.Mvc.Admin.Model;

/// <summary>
/// 系统规则与菜单权限实体
/// </summary>
[Table("sys_rules")]
public class SysRule {
    [Column("id", IsPrimaryKey = true, IsIdentity = true)]
    public int id;

    [Column("pid")]
    public int pid;

    [Column("name")]
    public string name;

    [Column("title")]
    public string title;

    [Column("icon")]
    public string icon;

    [Column("route")]
    public string route;

    [Column("component")]
    public string component;

    [Column("ismenu")]
    public int ismenu;

    [Column("weigh")]
    public int weigh;

    [Column("status")]
    public int status;

    [Column("created_at")]
    public long created_at;

    public SysRule() {
        this.id = 0;
        this.pid = 0;
        this.name = "";
        this.title = "";
        this.icon = "";
        this.route = "";
        this.component = "";
        this.ismenu = 1;
        this.weigh = 0;
        this.status = 1;
        this.created_at = 0;
    }
}
