using System;
using System.Data.Orm;

namespace Zan.Mvc.Admin.Model;

/// <summary>
/// 系统角色实体
/// </summary>
[Table("sys_roles")]
public class SysRole {
    [Column("id", IsPrimaryKey = true, IsIdentity = true)]
    public int id;

    [Column("name")]
    public string name;

    [Column("remark")]
    public string remark;

    [Column("status")]
    public int status;

    [Column("created_at")]
    public long created_at;

    public SysRole() {
        this.id = 0;
        this.name = "";
        this.remark = "";
        this.status = 1;
        this.created_at = 0;
    }
}
