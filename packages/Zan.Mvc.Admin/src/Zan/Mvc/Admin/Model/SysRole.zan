using System;
using System.Data.Orm;

namespace Zan.Mvc.Admin.Model;

/// <summary>
/// 角色实体（CodeFirst 模型映射 sys_roles 表）。
/// 挂载 5 级数据范围 DataScope 与权限规则关联。
/// </summary>
[Table(Name = "sys_roles")]
[Index(Name = "ux_sys_roles_key", Fields = "key", IsUnique = true)]
[Index(Name = "ix_sys_roles_status", Fields = "status")]
public class SysRole {
    [Column(IsIdentity = true, IsPrimary = true)]
    public int id;
    [Column(StringLength = 64)]
    public string name;
    [Column(StringLength = 64)]
    public string key;
    public int data_scope;
    public int status;

    public SysRole() {
        this.id = 0;
        this.name = "";
        this.key = "";
        this.data_scope = 1;
        this.status = 1;
    }
}
