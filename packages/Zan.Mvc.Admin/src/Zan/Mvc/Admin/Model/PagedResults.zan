/// <summary>
/// 工作台统计指标载荷 DTO。
/// </summary>
public class AdminStatsDto {
    public int users;
    public int depts;
    public int roles;

    public AdminStatsDto() {
        this.users = 0;
        this.depts = 0;
        this.roles = 0;
    }

    public AdminStatsDto(int users, int depts, int roles) {
        this.users = users;
        this.depts = depts;
        this.roles = roles;
    }
}

/// <summary>
/// 工作台统计指标响应 DTO。
/// </summary>
public class AdminStatsResponse {
    public string code;
    public string msg;
    public AdminStatsDto data;

    public AdminStatsResponse() {
        this.code = "0000";
        this.msg = "ok";
        this.data = new AdminStatsDto();
    }

    public AdminStatsResponse(AdminStatsDto data) {
        this.code = "0000";
        this.msg = "ok";
        this.data = data;
    }
}
