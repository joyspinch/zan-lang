using System;
using System.Collections.Generic;

namespace Zan.Mvc.Admin.Model;

/// <summary>
/// 用户分页检索响应 DTO（强类型编译器生成序列化）。
/// </summary>
public class UserPagedResult {
    public int total;
    public List<SysUser> items;

    public UserPagedResult() {
        this.total = 0;
        this.items = new List<SysUser>();
    }

    public UserPagedResult(int total, List<SysUser> items) {
        this.total = total;
        this.items = items;
    }
}

