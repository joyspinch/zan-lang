public class SysUserProfileDto {
    public int id;
    public string username;
    public string nickname;
    public string avatar;
    public string email;
    public string mobile;

    public SysUserProfileDto() {
        this.id = 0;
        this.username = "";
        this.nickname = "";
        this.avatar = "";
        this.email = "";
        this.mobile = "";
    }
}

public class SysRuleTreeNodeDto {
    public int id;
    public int pid;
    public string title;
    public string name;
    public bool is_menu;
    public bool is_checked;
    public List<SysRuleTreeNodeDto> children;

    public SysRuleTreeNodeDto() {
        this.id = 0;
        this.pid = 0;
        this.title = "";
        this.name = "";
        this.is_menu = false;
        this.is_checked = false;
        this.children = new List<SysRuleTreeNodeDto>();
    }
}
