using System;
using System.Collections.Generic;

namespace Zan.Mvc.Admin.Model;

public class SysUserPagedResult {
    public int total;
    public List<SysUser> rows;

    public SysUserPagedResult() {
        this.total = 0;
        this.rows = new List<SysUser>();
    }

    public SysUserPagedResult(int total, List<SysUser> rows) {
        this.total = total;
        this.rows = rows;
    }
}

