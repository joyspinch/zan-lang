using System;
using System.Data.Orm;

namespace Zan.Mvc.Admin.Model;

/// <summary>
/// 系统登录与认证审计日志实体（CodeFirst 模型映射 sys_login_logs 表）。
/// 记录每次登录与退出尝试，包含成功与失败原因，使恶意爆破与未授权探测无所遁形。
/// </summary>
[Table(Name = "sys_login_logs")]
[Index(Name = "ix_sys_login_user_created", Fields = "user_id,created_at")]
[Index(Name = "ix_sys_login_username", Fields = "username")]
public class SysLoginLog {
    [Column(IsIdentity = true, IsPrimary = true)]
    public int id;
    public int user_id;
    [Column(StringLength = 64)]
    public string username;
    [Column(StringLength = 64)]
    public string ip;
    [Column(StringLength = 255)]
    public string user_agent;
    public int status; // 1=成功, 0=失败
    [Column(StringLength = 255)]
    public string message;
    public long created_at;

    public SysLoginLog() {
        this.id = 0;
        this.user_id = 0;
        this.username = "";
        this.ip = "";
        this.user_agent = "";
        this.status = 1;
        this.message = "";
        this.created_at = 0;
    }
}
