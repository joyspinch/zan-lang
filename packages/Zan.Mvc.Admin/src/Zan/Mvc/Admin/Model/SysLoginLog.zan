using System;
using System.Data.Orm;

namespace Zan.Mvc.Admin.Model;

/// <summary>
/// 系统登录日志实体
/// </summary>
[Table("sys_login_logs")]
public class SysLoginLog {
    [Column("id", IsPrimaryKey = true, IsIdentity = true)]
    public int id;

    [Column("username")]
    public string username;

    [Column("ip")]
    public string ip;

    [Column("user_agent")]
    public string user_agent;

    [Column("status")]
    public int status;

    [Column("message")]
    public string message;

    [Column("created_at")]
    public long created_at;

    public SysLoginLog() {
        this.id = 0;
        this.username = "";
        this.ip = "";
        this.user_agent = "";
        this.status = 1;
        this.message = "";
        this.created_at = 0;
    }
}
