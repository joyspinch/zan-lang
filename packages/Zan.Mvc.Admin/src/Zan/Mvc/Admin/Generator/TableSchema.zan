using System;
using System.Collections.Generic;

namespace Zan.Mvc.Admin.Generator;

/// <summary>
/// 列元数据定义与 UI/校验推导模型。
/// </summary>
public class ColumnMeta {
    public string name;
    public string sqlType;
    public string zanType;
    public string title;
    public bool isPk;
    public bool isIdentity;
    public bool isNullable;
    public string component;
    public bool isRequired;
    public int width;
    public string ruleExpr;

    public ColumnMeta() {
        this.name = "";
        this.sqlType = "";
        this.zanType = "string";
        this.title = "";
        this.isPk = false;
        this.isIdentity = false;
        this.isNullable = true;
        this.component = "Input";
        this.isRequired = false;
        this.width = 120;
        this.ruleExpr = "";
    }
}

/// <summary>
/// 表元数据定义与业务模型。
/// </summary>
public class TableMeta {
    public string tableName;
    public string entityName;
    public string title;
    public string pkColumn;
    public List<ColumnMeta> columns;

    public TableMeta() {
        this.tableName = "";
        this.entityName = "";
        this.title = "";
        this.pkColumn = "id";
        this.columns = new List<ColumnMeta>();
    }

    public void AddColumn(ColumnMeta col) {
        if (col != null) {
            this.columns.Add(col);
            if (col.isPk) {
                this.pkColumn = col.name;
            }
        }
    }
}
