using System;
using System.Collections.Generic;
using System.Json;

namespace Zan.Mvc.Admin.UI;

/// <summary>
/// 下拉框/单选框选项项
/// </summary>
public class FormOption {
    public string key;
    public string value;

    public FormOption() {
        this.key = "";
        this.value = "";
    }

    public FormOption(string key, string value) {
        this.key = key;
        this.value = value;
    }
}

/// <summary>
/// 表单字段规格定义（强类型 DTO，支持 Json.Serialize 自动绑定）
/// </summary>
public class FormField {
    public string name;
    public string label;
    public string type;        // text, number, select, textarea, switch, password, date
    public string defaultValue;
    public bool required;
    public string placeholder;
    public int span;           // 栅格跨度 (12 为半行, 24 为整行)
    public string dictKey;     // 字典数据源标识
    public List<FormOption> options;

    public FormField() {
        this.name = "";
        this.label = "";
        this.type = "text";
        this.required = false;
        this.placeholder = "";
        this.defaultValue = "";
        this.span = 24;
        this.dictKey = "";
        this.options = new List<FormOption>();
    }

    public FormField(string name, string label, string type = "text", bool required = false, string placeholder = "", int span = 24, string dictKey = "") {
        this.name = name;
        this.label = label;
        this.type = type;
        this.required = required;
        this.placeholder = placeholder;
        this.defaultValue = "";
        this.span = span;
        this.dictKey = dictKey;
        this.options = new List<FormOption>();
    }

    public FormField AddOption(string key, string val) {
        this.options.Add(new FormOption(key, val));
        return this;
    }
}

/// <summary>
/// FormView 强类型动态表单原语。
/// 业务控制器声明表单字段与规则，通过 Json.Serialize 一行完成标准 Schema 转换。
/// 对接前端动态表单与设计器（FormDesigner）。
/// </summary>
public class FormView {
    public string title;
    public string submitUrl;
    public string method;
    public string width;
    public int labelWidth;
    public List<FormField> fields;

    public FormView() {
        this.title = "编辑表单";
        this.submitUrl = "";
        this.method = "POST";
        this.width = "600px";
        this.labelWidth = 100;
        this.fields = new List<FormField>();
    }

    public FormView(string title, string submitUrl = "", string method = "POST", string width = "600px") {
        this.title = title;
        this.submitUrl = submitUrl;
        this.method = method;
        this.width = width;
        this.labelWidth = 100;
        this.fields = new List<FormField>();
    }

    public FormView AddField(string name, string label, string type = "text", bool required = false, string placeholder = "", int span = 24, string dictKey = "") {
        this.fields.Add(new FormField(name, label, type, required, placeholder, span, dictKey));
        return this;
    }

    public FormView AddSelectField(string name, string label, List<FormOption> options, bool required = false, int span = 24) {
        var f = new FormField(name, label, "select", required, "", span);
        f.options = options;
        this.fields.Add(f);
        return this;
    }

    /// <summary>转换为标准 Schema JSON 字符串</summary>
    public string ToJson() {
        return Json.Serialize<FormView>(this);
    }

    /// <summary>兼容别名</summary>
    public string ToSchemaJson() {
        return this.ToJson();
    }
}
