using System;
using System.Collections.Generic;
using System.Text;

namespace Zan.Mvc.Admin.UI;

/// <summary>
/// 表单字段规格定义
/// </summary>
public class FormField {
    public string Name;
    public string Label;
    public string Type;        // text, number, select, textarea, switch, password, date
    public string DefaultValue;
    public bool Required;
    public string Placeholder;
    public Dictionary<string, string> Options;

    public FormField(string name, string label, string type = "text", bool required = false, string placeholder = "") {
        this.Name = name;
        this.Label = label;
        this.Type = type;
        this.Required = required;
        this.Placeholder = placeholder;
        this.DefaultValue = "";
        this.Options = new Dictionary<string, string>();
    }

    public FormField AddOption(string key, string val) {
        this.Options[key] = val;
        return this;
    }
}

/// <summary>
/// FormView 强类型表单原语。
/// 业务增删改控制器只需声明字段与验证约束，前端通过通用 FormView 模板完成双向绑定与异步提交。
/// </summary>
public class FormView {
    public string Title;
    public string SubmitUrl;
    public string Method;
    public List<FormField> Fields;

    public FormView(string title, string submitUrl, string method = "POST") {
        this.Title = title;
        this.SubmitUrl = submitUrl;
        this.Method = method;
        this.Fields = new List<FormField>();
    }

    public FormView AddField(string name, string label, string type = "text", bool required = false, string placeholder = "") {
        this.Fields.Add(new FormField(name, label, type, required, placeholder));
        return this;
    }

    public FormView AddSelectField(string name, string label, Dictionary<string, string> options, bool required = false) {
        var f = new FormField(name, label, "select", required);
        f.Options = options;
        this.Fields.Add(f);
        return this;
    }

    /// <summary>
    /// 序列化为前端表单引擎可消费的标准 Schema JSON
    /// </summary>
    public string ToSchemaJson() {
        StringBuilder sb = new StringBuilder();
        sb.Append("{");
        sb.Append("\"title\":\"" + this.Title + "\",");
        sb.Append("\"submitUrl\":\"" + this.SubmitUrl + "\",");
        sb.Append("\"method\":\"" + this.Method + "\",");
        
        sb.Append("\"fields\":[");
        for (int i = 0; i < this.Fields.Count; i = i + 1) {
            var f = this.Fields[i];
            if (i > 0) sb.Append(",");
            sb.Append("{\"name\":\"" + f.Name + "\",\"label\":\"" + f.Label + "\",\"type\":\"" + f.Type + "\",\"required\":" + (f.Required ? "true" : "false") + ",\"placeholder\":\"" + f.Placeholder + "\",\"options\":{");
            int optIdx = 0;
            foreach (string optKey in f.Options.Keys) {
                if (optIdx > 0) sb.Append(",");
                sb.Append("\"" + optKey + "\":\"" + f.Options[optKey] + "\"");
                optIdx = optIdx + 1;
            }
            sb.Append("}}");
        }
        sb.Append("]");

        sb.Append("}");
        return sb.ToString();
    }
}
