using System;
using System.Collections.Generic;
using System.Json;

namespace Zan.Mvc.Admin.UI;

public class FormFieldDef {
    public string name;
    public string label;
    public string type;
    public bool required;
    public string placeholder;
    public int span;

    public FormFieldDef() {
        this.name = "";
        this.label = "";
        this.type = "input";
        this.required = false;
        this.placeholder = "";
        this.span = 12;
    }

    public FormFieldDef(string name, string label, string type, bool required, string placeholder, int span) {
        this.name = name;
        this.label = label;
        this.type = type;
        this.required = required;
        this.placeholder = placeholder;
        this.span = span;
    }
}

public class FormView {
    public string title;
    public List<FormFieldDef> fields;

    public FormView() {
        this.title = "";
        this.fields = new List<FormFieldDef>();
    }

    public FormView(string title) {
        this.title = title;
        this.fields = new List<FormFieldDef>();
    }

    public FormView AddField(string name, string label, string type = "input", bool required = false, string placeholder = "", int span = 12) {
        this.fields.Add(new FormFieldDef(name, label, type, required, placeholder, span));
        return this;
    }

    public string ToJson() {
        return Json.Serialize<FormView>(this);
    }
}
