using System;
using System.Collections.Generic;
using System.Json;

namespace Zan.Mvc.Admin.UI;

/// <summary>
/// 下拉框/单选框选项项
/// </summary>
public class FormOption {
    public string key;
    public string value;

    public FormOption() {
        this.key = "";
        this.value = "";
    }

    public FormOption(string key, string value) {
        this.key = key;
        this.value = value;
    }
}

/// <summary>
/// 表单字段规格定义（强类型 DTO，支持 Json.Serialize 自动绑定）
/// </summary>
public class FormField {
    public string name;
    public string label;
    public string type;        // text, number, select, textarea, switch, password, date
    public string defaultValue;
    public bool required;
    public string placeholder;
    public List<FormOption> options;

    public FormField() {
        this.name = "";
        this.label = "";
        this.type = "text";
        this.required = false;
        this.placeholder = "";
        this.defaultValue = "";
        this.options = new List<FormOption>();
    }

    public FormField(string name, string label, string type = "text", bool required = false, string placeholder = "") {
        this.name = name;
        this.label = label;
        this.type = type;
        this.required = required;
        this.placeholder = placeholder;
        this.defaultValue = "";
        this.options = new List<FormOption>();
    }

    public FormField AddOption(string key, string val) {
        this.options.Add(new FormOption(key, val));
        return this;
    }
}

/// <summary>
/// FormView 强类型表单原语。
/// 业务控制器声明表单字段与规则，通过 Json.Serialize 一行完成标准 Schema 转换。
/// 杜绝循环手拼 JSON 字符串与手工 key 字符串设值。
/// </summary>
public class FormView {
    public string title;
    public string submitUrl;
    public string method;
    public List<FormField> fields;

    public FormView() {
        this.title = "";
        this.submitUrl = "";
        this.method = "POST";
        this.fields = new List<FormField>();
    }

    public FormView(string title, string submitUrl, string method = "POST") {
        this.title = title;
        this.submitUrl = submitUrl;
        this.method = method;
        this.fields = new List<FormField>();
    }

    public FormView AddField(string name, string label, string type = "text", bool required = false, string placeholder = "") {
        this.fields.Add(new FormField(name, label, type, required, placeholder));
        return this;
    }

    public FormView AddSelectField(string name, string label, List<FormOption> options, bool required = false) {
        var f = new FormField(name, label, "select", required);
        f.options = options;
        this.fields.Add(f);
        return this;
    }

    /// <summary>
    /// 一行代码自动序列化为标准 Schema JSON
    /// </summary>
    public string ToSchemaJson() {
        return Json.Serialize<FormView>(this);
    }
}
