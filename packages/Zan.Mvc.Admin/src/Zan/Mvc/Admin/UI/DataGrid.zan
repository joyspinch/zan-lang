using System;
using System.Collections.Generic;
using System.Json;

namespace Zan.Mvc.Admin.UI;

/// <summary>
/// 表格列定义（强类型 DTO，支持 Json.Serialize 自动绑定）
/// </summary>
public class DataGridColumn {
    public string field;
    public string title;
    public int width;
    public string align;       // left, center, right
    public bool sortable;
    public string formatter;   // text, badge, datetime, money, action

    public DataGridColumn() {
        this.field = "";
        this.title = "";
        this.width = 0;
        this.align = "left";
        this.sortable = false;
        this.formatter = "text";
    }

    public DataGridColumn(string field, string title, int width = 0, string align = "left", string formatter = "text") {
        this.field = field;
        this.title = title;
        this.width = width;
        this.align = align;
        this.sortable = false;
        this.formatter = formatter;
    }
}

/// <summary>
/// 表格顶部搜索/过滤项定义
/// </summary>
public class DataGridFilter {
    public string field;
    public string label;
    public string type;        // text, select, date, daterange
    public string placeholder;

    public DataGridFilter() {
        this.field = "";
        this.label = "";
        this.type = "text";
        this.placeholder = "";
    }

    public DataGridFilter(string field, string label, string type = "text", string placeholder = "") {
        this.field = field;
        this.label = label;
        this.type = type;
        this.placeholder = placeholder;
    }
}

/// <summary>
/// 表格操作按钮定义（支持行级操作与顶部全局操作）
/// </summary>
public class DataGridAction {
    public string title;
    public string icon;
    public string actionType;  // dialog, drawer, post, link, delete
    public string url;
    public string color;       // primary, success, warning, danger, default
    public string perm;        // 权限点

    public DataGridAction() {
        this.title = "";
        this.icon = "";
        this.actionType = "dialog";
        this.url = "";
        this.color = "primary";
        this.perm = "";
    }

    public DataGridAction(string title, string url, string actionType = "dialog", string icon = "", string color = "primary", string perm = "") {
        this.title = title;
        this.url = url;
        this.actionType = actionType;
        this.icon = icon;
        this.color = color;
        this.perm = perm;
    }
}

/// <summary>
/// DataGrid 强类型数据网格原语。
/// 业务控制器声明列结构与操作，基于编译器内置 Json.Serialize 直接完成标准化 Schema 序列化。
/// 拒绝手写拼接与硬编码 key 赋值，具备完整 IDE 静态补全与类型检查。
/// </summary>
public class DataGrid {
    public string title;
    public string apiUrl;
    public bool enablePagination;
    public int pageSize;
    public List<DataGridColumn> columns;
    public List<DataGridFilter> filters;
    public List<DataGridAction> topActions;
    public List<DataGridAction> rowActions;

    public DataGrid() {
        this.title = "";
        this.apiUrl = "";
        this.enablePagination = true;
        this.pageSize = 20;
        this.columns = new List<DataGridColumn>();
        this.filters = new List<DataGridFilter>();
        this.topActions = new List<DataGridAction>();
        this.rowActions = new List<DataGridAction>();
    }

    public DataGrid(string title, string apiUrl) {
        this.title = title;
        this.apiUrl = apiUrl;
        this.enablePagination = true;
        this.pageSize = 20;
        this.columns = new List<DataGridColumn>();
        this.filters = new List<DataGridFilter>();
        this.topActions = new List<DataGridAction>();
        this.rowActions = new List<DataGridAction>();
    }

    public DataGrid AddColumn(string field, string title, int width = 0, string align = "left", string formatter = "text") {
        this.columns.Add(new DataGridColumn(field, title, width, align, formatter));
        return this;
    }

    public DataGrid AddFilter(string field, string label, string type = "text", string placeholder = "") {
        this.filters.Add(new DataGridFilter(field, label, type, placeholder));
        return this;
    }

    public DataGrid AddTopAction(string title, string url, string actionType = "dialog", string icon = "", string color = "primary", string perm = "") {
        this.topActions.Add(new DataGridAction(title, url, actionType, icon, color, perm));
        return this;
    }

    public DataGrid AddRowAction(string title, string url, string actionType = "dialog", string icon = "", string color = "primary", string perm = "") {
        this.rowActions.Add(new DataGridAction(title, url, actionType, icon, color, perm));
        return this;
    }

    /// <summary>
    /// 一行代码自动序列化为标准 Schema JSON，零手工字符串拼接、零手工 key 设值
    /// </summary>
    public string ToSchemaJson() {
        return Json.Serialize<DataGrid>(this);
    }
}
