using System;
using System.Collections.Generic;
using System.Json;

namespace Zan.Mvc.Admin.UI;

/// <summary>
/// 表格列定义契约（与现代前端数据网格 / zan-grid 协议对齐）。
/// </summary>
public class TableColumn {
    public string field;          // 字段键名
    public string headerName;     // 表头标题
    public string type;           // text, number, input, dict, date, button
    public int width;             // 列宽 (px)
    public bool sortable;         // 是否支持排序
    public bool editable;         // 是否支持行内即时编辑
    public string dictKey;        // 字典键名 (type=dict 时生效)
    public bool hidden;           // 是否隐藏该列
    public int order;             // 列排序优先级

    public TableColumn() {
        this.field = "";
        this.headerName = "";
        this.type = "text";
        this.width = 120;
        this.sortable = false;
        this.editable = false;
        this.dictKey = "";
        this.hidden = false;
        this.order = 0;
    }

    public TableColumn(string field, string headerName, string type = "text", int width = 120, bool sortable = false, bool editable = false) {
        this.field = field;
        this.headerName = headerName;
        this.type = type;
        this.width = width;
        this.sortable = sortable;
        this.editable = editable;
        this.dictKey = "";
        this.hidden = false;
        this.order = 0;
    }
}

/// <summary>
/// 表格顶部及快捷筛选器定义契约。
/// </summary>
public class TableFilter {
    public string field;          // 过滤字段名
    public string name;           // 筛选标签显示名
    public string type;           // Input, Select, DateRange, Number
    public string placeholder;    // 占位提示文案
    public string dictKey;        // 字典数据源标识 (type=Select 时)

    public TableFilter() {
        this.field = "";
        this.name = "";
        this.type = "Input";
        this.placeholder = "";
        this.dictKey = "";
    }

    public TableFilter(string field, string name, string type = "Input", string placeholder = "", string dictKey = "") {
        this.field = field;
        this.name = name;
        this.type = type;
        this.placeholder = placeholder;
        this.dictKey = dictKey;
    }
}

/// <summary>
/// 工具栏操作按钮定义契约（结合弹窗规格）。
/// </summary>
public class TableTool {
    public string name;           // 按钮文案 (如: "添加", "批量删除")
    public string action;         // 触发动作 (Add, Delete, Dict, Custom)
    public string showName;       // 实体展示名 (如: "订单")
    public string type;           // 按钮色彩/风格 (Primary, Default, Error)
    public bool needRow;          // 是否需要先选中数据行
    public string width;          // 弹窗默认宽度 (如: "600px")
    public string height;         // 弹窗默认高度 (如: "420px")

    public TableTool() {
        this.name = "";
        this.action = "";
        this.showName = "";
        this.type = "Default";
        this.needRow = false;
        this.width = "500px";
        this.height = "350px";
    }

    public TableTool(string name, string action, string showName, string type = "Default", bool needRow = false, string width = "500px", string height = "350px") {
        this.name = name;
        this.action = action;
        this.showName = showName;
        this.type = type;
        this.needRow = needRow;
        this.width = width;
        this.height = height;
    }
}

/// <summary>
/// 表格全局基础特性配置。
/// </summary>
public class TableConf {
    public bool showPages;        // 是否分页
    public int pageSize;          // 默认每页条数
    public string pageSizes;      // 可选分页档位
    public string innerKey;       // 主键字段名 (如: id, order_no)
    public string innerName;      // 主键对应的代表性显示列名 (如: title, customer_name)
    public bool export;           // 是否允许导出 Excel
    public bool treeData;         // 是否为树形递归表格

    public TableConf() {
        this.showPages = true;
        this.pageSize = 20;
        this.pageSizes = "10,20,50,100,200";
        this.innerKey = "id";
        this.innerName = "名称";
        this.export = true;
        this.treeData = false;
    }
}

/// <summary>
/// 列表完整配置契约（通过 PUT /api/.../Conf 下发给前端）。
/// 支持三级 Diff 配置合并，既保留代码模型基线，又支持前端拖拽列宽/隐藏列后持久化覆盖。
/// </summary>
public class TableConfig {
    public TableConf Conf;
    public List<TableColumn> Columns;
    public List<TableFilter> Filters;
    public List<TableTool> Tools;

    public TableConfig() {
        this.Conf = new TableConf();
        this.Columns = new List<TableColumn>();
        this.Filters = new List<TableFilter>();
        this.Tools = new List<TableTool>();
    }

    /// <summary>添加或追加列定义</summary>
    public TableConfig AddColumn(string field, string headerName, string type = "text", int width = 120, bool sortable = false, bool editable = false) {
        this.Columns.Add(new TableColumn(field, headerName, type, width, sortable, editable));
        return this;
    }

    /// <summary>添加过滤筛选条件</summary>
    public TableConfig AddFilter(string field, string name, string type = "Input", string placeholder = "", string dictKey = "") {
        this.Filters.Add(new TableFilter(field, name, type, placeholder, dictKey));
        return this;
    }

    /// <summary>添加工具栏按钮</summary>
    public TableConfig AddTool(string name, string action, string showName, string type = "Default", bool needRow = false, string width = "500px", string height = "350px") {
        this.Tools.Add(new TableTool(name, action, showName, type, needRow, width, height));
        return this;
    }

    /// <summary>获取列定义（不存在返回 null）</summary>
    public TableColumn GetColumn(string field) {
        for (int i = 0; i < this.Columns.Count; i = i + 1) {
            if (this.Columns[i].field == field) {
                return this.Columns[i];
            }
        }
        return null;
    }

    /// <summary>判定某字段是否允许行内即时编辑</summary>
    public bool IsColumnEditable(string field) {
        TableColumn col = this.GetColumn(field);
        if (col == null) {
            return false;
        }
        return col.editable && !col.hidden;
    }

    /// <summary>
    /// 将前端持久化保存的差异配置（Diff JSON）动态合并到代码基线上。
    /// 格式支持：{ "columns": { "customer_name": { "width": 260, "hidden": false, "order": 1 } }, "pageSize": 50 }
    /// </summary>
    public void ApplyDiff(string diffJson) {
        if (diffJson == null || diffJson.Length == 0) {
            return;
        }
        JsonValue root = JsonValue.Parse(diffJson);
        if (root == null) {
            return;
        }

        // 1. 合并分页覆盖
        if (root.Has("pageSize")) {
            this.Conf.pageSize = root.Int("pageSize", this.Conf.pageSize);
        }

        // 2. 合并列定制 (width, hidden, order)
        if (root.Has("columns")) {
            JsonValue cols = root.Get("columns");
            if (cols != null) {
                for (int i = 0; i < this.Columns.Count; i = i + 1) {
                    TableColumn col = this.Columns[i];
                    if (cols.Has(col.field)) {
                        JsonValue custom = cols.Get(col.field);
                        if (custom != null) {
                            if (custom.Has("width")) {
                                col.width = custom.Int("width", col.width);
                            }
                            if (custom.Has("hidden")) {
                                JsonValue h = custom.Get("hidden");
                                if (h != null) {
                                    col.hidden = h.AsBool(col.hidden);
                                }
                            }
                            if (custom.Has("order")) {
                                col.order = custom.Int("order", col.order);
                            }
                        }
                    }
                }
            }
        }
    }

    /// <summary>转换为标准 JSON</summary>
    public string ToJson() {
        return Json.Serialize<TableConfig>(this);
    }
}
