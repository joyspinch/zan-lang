using System;
using System.Collections.Generic;
using System.Json;

namespace Zan.Mvc.Admin.UI;

public class ColumnDef {
    public string field;
    public string title;
    public string type;
    public int width;
    public bool sortable;
    public bool editable;

    public ColumnDef() {
        this.field = "";
        this.title = "";
        this.type = "input";
        this.width = 120;
        this.sortable = false;
        this.editable = false;
    }

    public ColumnDef(string field, string title, string type, int width, bool sortable, bool editable) {
        this.field = field;
        this.title = title;
        this.type = type;
        this.width = width;
        this.sortable = sortable;
        this.editable = editable;
    }
}

public class FilterDef {
    public string field;
    public string title;
    public string type;
    public string placeholder;

    public FilterDef() {
        this.field = "";
        this.title = "";
        this.type = "input";
        this.placeholder = "";
    }

    public FilterDef(string field, string title, string type, string placeholder) {
        this.field = field;
        this.title = title;
        this.type = type;
        this.placeholder = placeholder;
    }
}

public class ToolDef {
    public string title;
    public string action;
    public string target;
    public string theme;
    public bool needConfirm;
    public string width;
    public string height;

    public ToolDef() {
        this.title = "";
        this.action = "";
        this.target = "";
        this.theme = "Default";
        this.needConfirm = false;
        this.width = "";
        this.height = "";
    }

    public ToolDef(string title, string action, string target, string theme, bool needConfirm, string width, string height) {
        this.title = title;
        this.action = action;
        this.target = target;
        this.theme = theme;
        this.needConfirm = needConfirm;
        this.width = width;
        this.height = height;
    }
}

public class TableKeyConf {
    public string primaryKey;
    public string title;

    public TableKeyConf() {
        this.primaryKey = "id";
        this.title = "";
    }

    public void SetKey(string pk, string title) {
        this.primaryKey = pk;
        this.title = title;
    }
}

public class TableConfig {
    public TableKeyConf Conf;
    public List<ColumnDef> Columns;
    public List<FilterDef> Filters;
    public List<ToolDef> Tools;

    public TableConfig() {
        this.Conf = new TableKeyConf();
        this.Columns = new List<ColumnDef>();
        this.Filters = new List<FilterDef>();
        this.Tools = new List<ToolDef>();
    }

    public TableConfig AddColumn(string field, string title, string type = "input", int width = 120, bool sortable = false, bool editable = false) {
        this.Columns.Add(new ColumnDef(field, title, type, width, sortable, editable));
        return this;
    }

    public TableConfig AddFilter(string field, string title, string type = "input", string placeholder = "") {
        this.Filters.Add(new FilterDef(field, title, type, placeholder));
        return this;
    }

    public TableConfig AddTool(string title, string action, string target = "", string theme = "Default", bool needConfirm = false, string width = "", string height = "") {
        this.Tools.Add(new ToolDef(title, action, target, theme, needConfirm, width, height));
        return this;
    }

    public string ToJson() {
        return Json.Serialize<TableConfig>(this);
    }
}
