using System;
using System.IO;
using System.Collections.Generic;
using System.Text;

namespace Zan.Mvc.Admin.UI;

/// <summary>
/// 中台通用模板视图加载与轻量渲染引擎。
/// 将 HTML 页面从后端 Zan 代码中彻底解耦，统一存放在 assets/views/ 目录。
/// 支持开发期热重载与模板变量插值（{{key}}）。
/// </summary>
public class AdminViewEngine {
    private static Dict<string, string> _cache = new Dict<string, string>();

    /// <summary>
    /// 读取并渲染指定模板视图
    /// </summary>
    public static string Render(string viewName, Dict<string, string> vars = null) {
        string tpl = LoadTemplate(viewName);
        if (vars == null || tpl.Length == 0) {
            return tpl;
        }

        StringBuilder sb = new StringBuilder();
        // 遍历变量并替换
        List<string> keys = vars.Keys;
        string res = tpl;
        for (int i = 0; i < keys.Count; i = i + 1) {
            string k = keys[i];
            string placeholder = "{{" + k + "}}";
            string val = vars[k];
            res = res.Replace(placeholder, val);
        }
        return res;
    }

    /// <summary>
    /// 定位模板物理路径并读取文本内容
    /// </summary>
    private static string LoadTemplate(string viewName) {
        // 多路径容错探测：优先包内 assets/views/，其次工作区 assets/views/
        string[] candidates = new string[] {
            "packages/Zan.Mvc.Admin/assets/views/" + viewName,
            "assets/views/" + viewName,
            viewName
        };

        for (int i = 0; i < candidates.Length; i = i + 1) {
            string path = candidates[i];
            if (File.Exists(path)) {
                try {
                    return File.ReadAllText(path);
                } catch (Exception ex) {
                }
            }
        }

        return "<!-- Template not found: " + viewName + " -->";
    }
}
