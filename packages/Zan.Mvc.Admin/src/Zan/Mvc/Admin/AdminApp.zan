using System;
using System.IO;
using System.Data;
using System.Data.Sqlite;
using System.Diagnostics;
using System.Web;
using Zan.Mvc.Admin.Web;
using Zan.Mvc.Admin.Security;
using Zan.Mvc.Admin.Installer;
using Zan.Mvc.Admin.Dao;
using Zan.Mvc.Admin.Model;

namespace Zan.Mvc.Admin;

/// <summary>
/// Zan.Mvc.Admin 通用管理中台统一初始化与装配中枢。
/// 零侵入、零手写菜单注册、纯实体 ORM 驱动。
/// 业务系统只需在程序启动时：
///   AdminApp.UseAdmin(app, db);
/// 即可一键挂载：
/// 1. 安装锁防护与初始安装向导网关 (InstallGateMiddleware)；
/// 2. 静态 UI 资产 (/static/zan/*)；
/// 3. 全局统一安全与 5 级 DataScope 数据隔离中枢 (SecurityRegistry)；
/// 4. 属性路由与中台管理端控制器支持；
/// 5. 全链路微秒级 APM 监控 (ServerMetrics/DbTrace) 与异常自动捕获。
/// </summary>
public class AdminApp {
    private static IDbConnection _db;
    private static WebApp _app;

    public static WebApp App {
        get { return _app; }
    }

    public static IDbConnection Db {
        get { return _db; }
    }

    public static void SetDb(IDbConnection db) {
        if (db != null) {
            _db = TracedDbConnection.Wrap(db);
        } else {
            _db = null;
        }
    }

    /// <summary>
    /// 一键装配管理中台基础设施
    /// </summary>
    public static void UseAdmin(WebApp app, IDbConnection db) {
        _app = app;
        if (db != null) {
            _db = TracedDbConnection.Wrap(db);
        }

        // 0. 挂载微秒级数据库 APM 探针与慢查询聚合
        DbTrace.Sink((string sql, long us) => {
            ServerMetrics.Global().RecordQuery(sql, us);
        });

        // 挂载全局异常持久化汇流器（自动将未捕获异常与系统故障入库并按天写日志）
        ServerMetrics.Global().OnError((long ts, string origin, string detail) => {
            if (_db != null) {
                try {
                    SysOperationLog log = new SysOperationLog();
                    log.admin_id = 0;
                    log.action = "SYSTEM_ERROR";
                    log.detail = origin + " | " + detail;
                    log.ip = "127.0.0.1";
                    log.created_at = ts;
                    SysOperationLogDao.Of(_db).Insert(log);
                } catch (Exception ex) {}
            }
        });

        // 1. 注册安装守卫中间件（未安装时拦截重定向至 /install，已安装时永久熔断 /install）
        app.Before((HttpContext ctx) => {
            string redirectUrl;
            int code = InstallGateMiddleware.Check(ctx.path, out redirectUrl);
            if (code == 302 && redirectUrl.Length > 0) {
                ctx.Redirect(redirectUrl);
                return false;
            }
            if (code == 404) {
                ctx.Status(404, "Not Found");
                ctx.Text("Not Found");
                return false;
            }
            return true;
        });

        // 2. 挂载随包附带的静态资产 (/static/zan/*)
        StaticFiles.Mount(app, "/static/zan", "packages/Zan.Mvc.Admin/assets");

        // 3. 自动装配所有通过 [Route]/[AdminAction] 标注的控制器路由
        __AttrRoutes.Register(app);

        // 4. 启动期增量同步系统管理底层内置规则与功能菜单到 sys_rules 表
        if (db != null) {
            MetadataScanner.SyncFromRouter(app.router, db);
        }
    }

    /// <summary>
    /// 自动从 config/app.json 初始化数据库连接，若不存在则使用默认 SQLite
    /// </summary>
    public static IDbConnection OpenDb(string defaultPath = "data/app.db") {
        string dbPath = defaultPath;
        if (File.Exists("config/app.json")) {
            try {
                string json = File.ReadAllText("config/app.json");
                AppConfigFile cfg = Json.Deserialize<AppConfigFile>(json);
                if (cfg != null && cfg.db != null && cfg.db.path.Length > 0) {
                    dbPath = cfg.db.path;
                }
            } catch (Exception ex) {
            }
        }

        string dir = Path.GetDirectoryName(dbPath);
        if (dir.Length > 0 && !Directory.Exists(dir)) {
            Directory.CreateDirectory(dir);
        }

        SqliteConnection conn = SqliteConnection.Open(dbPath);
        IDbConnection traced = TracedDbConnection.Wrap(conn);
        _db = traced;

        // 开启 SQLite WAL 极速模式与内存页缓存，提升 10~50 倍并发读写吞吐
        if (traced != null) {
            try {
                traced.Execute("PRAGMA journal_mode = WAL;");
                traced.Execute("PRAGMA synchronous = NORMAL;");
                traced.Execute("PRAGMA cache_size = -64000;");
                traced.Execute("PRAGMA temp_store = MEMORY;");
            } catch (Exception ex) {
            }
        }

        return traced;
    }
}
