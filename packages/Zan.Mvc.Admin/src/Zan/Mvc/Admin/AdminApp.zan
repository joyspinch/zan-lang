using System;
using System.Data;
using System.Web;
using Zan.Mvc.Admin.Web;
using Zan.Mvc.Admin.Security;
using Zan.Mvc.Admin.Installer;

namespace Zan.Mvc.Admin;

/// <summary>
/// Zan.Mvc.Admin 框架核心入口与应用装配器。
/// 一键无缝装配 RBAC 权限中枢、声明式菜单发现、安全会话解析与内置管理控制器。
/// </summary>
public class AdminApp {
    public static IDbConnection Db;
    public static WebApp App;

    public static void UseAdmin(WebApp app, IDbConnection db) {
        AdminApp.App = app;
        AdminApp.Db = db;

        // 0. 自动执行架构迁移与系统初始化
        string err;
        SchemaMigrator.ExecuteInstall(db, "admin", "123456", out err);

        // 1. 注册声明式侧边栏顶层分段名称
        MenuBuilder.Section("system", "系统管理");
        MenuBuilder.Section("shop", "商城业务");
        MenuBuilder.Section("monitor", "监控审计");

        // 2. 挂载标准安全认证与权限决策解析器
        app.LoginPath("/admin/login");
        app.AuthResolver(AdminApp.ResolveAuth);
        app.PermissionResolver(AdminApp.ResolvePermission);

        // 3. 挂载管理静态资源
        StaticFiles.Mount(app, "/admin/assets", "packages/Zan.Mvc.Admin/assets");

        // 3.5 确保所有内置管理后台控制器参与属性路由扫描
        AdminApp.EnsureControllers();

        // 4. 注册编译器自动生成的属性路由
        __AttrRoutes.Register(app);
    }

    private static void EnsureControllers() {
        AdminAuthController a = null;
        AdminWorkbenchController b = null;
        SysUserController c = null;
        SysRoleController d = null;
        SysDepartmentController e = null;
        SysRuleController f = null;
        SysLoginLogController g = null;
        SysOperationLogController h = null;
    }

    private static async string ResolveAuth(string token) {
        int uid = AdminSessionToken.Verify(token);
        if (uid > 0) {
            return Convert.ToString(uid);
        }
        return "";
    }

    private static async bool ResolvePermission(string uid, string action) {
        return await UserAuthService.Instance.Allow(uid, action);
    }
}
