using System;
using System.IO;
using System.Json;
using System.Management;
using System.Diagnostics;
using System.Collections.Generic;

namespace Zan.Mvc.Admin.Diagnostics;

/// <summary>
/// 非阻塞主机 CPU 负载采样器。
/// 基于连续调用间的内核时间/用户时间差值计算百分比，绝不调用 Sleep 阻塞工作线程。
/// </summary>
class HostCpuSampler {
    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "GetSystemTimes")]
    static extern int WinGetSystemTimes(nint times);
    #endif

    static long lastIdle = 0;
    static long lastKernel = 0;
    static long lastUser = 0;
    static int lastPercent = 0;

    public static int SamplePercent() {
        #if WINDOWS
        nint t = NativeMemory.Alloc(24);
        WinGetSystemTimes(t);
        Span<long> q = new Span<long>(t, 3);
        long idle = q[0];
        long kernel = q[1];
        long user = q[2];
        NativeMemory.Free(t);

        if (lastIdle > 0) {
            long dIdle = idle - lastIdle;
            long dKernel = kernel - lastKernel;
            long dUser = user - lastUser;
            long dTotal = dKernel + dUser;
            if (dTotal > 0) {
                long pct = (dTotal - dIdle) * 100 / dTotal;
                if (pct < 0) { pct = 0; }
                if (pct > 100) { pct = 100; }
                lastPercent = (int)pct;
            }
        }
        lastIdle = idle;
        lastKernel = kernel;
        lastUser = user;
        return lastPercent;
        #elif LINUX
        try {
            string txt = File.ReadAllText("/proc/stat");
            int eol = txt.IndexOf("\n");
            if (eol > 0) {
                string line = txt.Substring(0, eol);
                string[] parts = line.Split(" ");
                long total = 0;
                long idle = 0;
                int field = 0;
                for (int i = 0; i < parts.Length; i = i + 1) {
                    string tok = parts[i].Trim();
                    if (tok.Length > 0) {
                        if (field >= 1) {
                            long v = Convert.ToInt64(tok);
                            total = total + v;
                            if (field == 4 || field == 5) { idle = idle + v; }
                        }
                        field = field + 1;
                    }
                }
                if (lastKernel > 0) {
                    long dTotal = total - lastKernel;
                    long dIdle = idle - lastIdle;
                    if (dTotal > 0) {
                        long pct = (dTotal - dIdle) * 100 / dTotal;
                        if (pct < 0) { pct = 0; }
                        if (pct > 100) { pct = 100; }
                        lastPercent = (int)pct;
                    }
                }
                lastKernel = total;
                lastIdle = idle;
            }
        } catch (Exception) {}
        return lastPercent;
        #else
        return 0;
        #endif
    }
}

/// <summary>
/// 服务器操作系统、物理硬件（CPU/内存/磁盘）与运行环境统一聚合器。
/// </summary>
public class ServerHostInfo {
    /// <summary>
    /// 获取完整的系统与硬件指标 JSON 树。
    /// </summary>
    public static JsonValue SnapshotJson() {
        JsonValue root = JsonValue.NewObject();

        // 1. 操作系统信息
        JsonValue os = JsonValue.NewObject();
        string osName = SystemInfo.OsName();
        if (osName.Length == 0) { osName = OperatingSystem.Platform; }
        os.Put("name", JsonValue.NewStr(osName));
        os.Put("kernel", JsonValue.NewStr(SystemInfo.KernelVersion()));
        os.Put("computer_name", JsonValue.NewStr(SystemInfo.ComputerName()));
        os.Put("user_name", JsonValue.NewStr(SystemInfo.UserName()));
        long uptimeSec = SystemInfo.UptimeSeconds();
        os.Put("uptime_seconds", JsonValue.NewNum(Convert.ToString(uptimeSec)));
        os.Put("uptime_text", JsonValue.NewStr(FormatUptime(uptimeSec)));
        os.Put("platform", JsonValue.NewStr(OperatingSystem.Platform));
        os.Put("system_dir", JsonValue.NewStr(SystemInfo.SystemDirectory()));
        root.Put("os", os);

        // 2. 处理器（CPU）信息
        JsonValue cpu = JsonValue.NewObject();
        string cpuBrand = Cpu.Brand();
        if (cpuBrand.Length == 0) { cpuBrand = "Generic CPU"; }
        cpu.Put("brand", JsonValue.NewStr(cpuBrand));
        cpu.Put("vendor", JsonValue.NewStr(Cpu.Vendor()));
        int cores = Cpu.LogicalCores();
        if (cores <= 0) { cores = 1; }
        cpu.Put("cores", JsonValue.NewNum(Convert.ToString(cores)));
        cpu.Put("frequency_mhz", JsonValue.NewNum(Convert.ToString(Cpu.FrequencyMHz())));
        int cpuUsage = HostCpuSampler.SamplePercent();
        cpu.Put("usage_percent", JsonValue.NewNum(Convert.ToString(cpuUsage)));
        root.Put("cpu", cpu);

        // 3. 内存（Memory）快照
        JsonValue memory = JsonValue.NewObject();
        try {
            MemoryStatus mem = Memory.GetStatus();
            memory.Put("total_phys_bytes", JsonValue.NewNum(Convert.ToString(mem.totalPhys)));
            memory.Put("avail_phys_bytes", JsonValue.NewNum(Convert.ToString(mem.availPhys)));
            long usedPhys = mem.totalPhys - mem.availPhys;
            if (usedPhys < 0) { usedPhys = 0; }
            memory.Put("used_phys_bytes", JsonValue.NewNum(Convert.ToString(usedPhys)));
            memory.Put("usage_percent", JsonValue.NewNum(Convert.ToString(mem.usagePercent)));
            memory.Put("total_page_file", JsonValue.NewNum(Convert.ToString(mem.totalPageFile)));
            memory.Put("avail_page_file", JsonValue.NewNum(Convert.ToString(mem.availPageFile)));
            memory.Put("is_low", JsonValue.NewBool(mem.IsLow()));
        } catch (Exception) {
            memory.Put("total_phys_bytes", JsonValue.NewNum("0"));
            memory.Put("avail_phys_bytes", JsonValue.NewNum("0"));
            memory.Put("used_phys_bytes", JsonValue.NewNum("0"));
            memory.Put("usage_percent", JsonValue.NewNum("0"));
            memory.Put("is_low", JsonValue.NewBool(false));
        }
        root.Put("memory", memory);

        // 4. 磁盘驱动器与分区（Storage）
        JsonValue disks = JsonValue.NewArray();
        try {
            List<DiskUsage> drives = Storage.Drives();
            for (int i = 0; i < drives.Count; i = i + 1) {
                DiskUsage d = drives[i];
                JsonValue disk = JsonValue.NewObject();
                disk.Put("name", JsonValue.NewStr(d.name));
                disk.Put("total_bytes", JsonValue.NewNum(Convert.ToString(d.totalBytes)));
                disk.Put("free_bytes", JsonValue.NewNum(Convert.ToString(d.freeBytes)));
                disk.Put("avail_bytes", JsonValue.NewNum(Convert.ToString(d.availBytes)));
                long usedDisk = d.totalBytes - d.freeBytes;
                if (usedDisk < 0) { usedDisk = 0; }
                disk.Put("used_bytes", JsonValue.NewNum(Convert.ToString(usedDisk)));
                disk.Put("usage_percent", JsonValue.NewNum(Convert.ToString(d.UsagePercent())));
                disks.Append(disk);
            }
        } catch (Exception) {}
        root.Put("disks", disks);

        // 5. 运行时与服务环境（Runtime）
        JsonValue rt = JsonValue.NewObject();
        rt.Put("zan_version", JsonValue.NewStr(ZanVersion.Text()));
        rt.Put("pid", JsonValue.NewNum(Convert.ToString(Environment.ProcessId)));
        rt.Put("process_path", JsonValue.NewStr(Environment.ProcessPath));
        rt.Put("server_time", JsonValue.NewNum(Convert.ToString(DateTime.UtcNow().ToUnixSeconds())));
        root.Put("runtime", rt);

        return root;
    }

    /// <summary>
    /// 格式化系统运行时长。
    /// </summary>
    private static string FormatUptime(long seconds) {
        if (seconds <= 0) { return "刚启动"; }
        long days = seconds / 86400;
        long hours = (seconds % 86400) / 3600;
        long mins = (seconds % 3600) / 60;
        long secs = seconds % 60;

        string res = "";
        if (days > 0) { res = res + Convert.ToString(days) + "天 "; }
        if (hours > 0 || days > 0) { res = res + Convert.ToString(hours) + "小时 "; }
        if (mins > 0 || hours > 0 || days > 0) { res = res + Convert.ToString(mins) + "分 "; }
        res = res + Convert.ToString(secs) + "秒";
        return res;
    }
}
