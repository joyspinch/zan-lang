using System;
using System.Collections.Generic;
using Zan.Mvc.Admin.Security;

namespace Zan.Mvc.Admin.Data;

/// <summary>
/// 数据范围 SQL 条件生成器。
/// 根据当前线程上下文持有的 DataScope 规则，自动生成参数化的 WHERE 过滤片段。
/// 彻底消除业务代码手拼 SQL 或循环过滤导致的漏权漏洞。
/// </summary>
public class ScopeFilter {
    /// <summary>
    /// 生成符合当前数据范围的参数化 SQL 过滤条件。
    /// </summary>
    /// <param name="scope">当前用户的数据范围</param>
    /// <param name="alias">表别名（如 "t"）</param>
    /// <param name="deptCol">部门字段名（默认 "dept_id"）</param>
    /// <param name="ownerCol">负责人/创建者字段名（默认 "owner_id"）</param>
    /// <param name="outParams">用于收集参数化值的字典</param>
    public static string BuildWhere(DataScope scope, string alias, string deptCol, string ownerCol, Dictionary<string, object> outParams) {
        if (scope == null || scope.IsAll()) {
            return ""; // 全量权限：不追加任何限制
        }

        string prefix = alias.Length > 0 ? alias + "." : "";

        // 1. 仅限本人
        if (scope.IsSelf()) {
            string paramKey = "scope_owner_id";
            if (outParams != null) {
                outParams[paramKey] = scope.UserId;
            }
            return prefix + ownerCol + " = @" + paramKey;
        }

        // 2. 本部门
        if (scope.Mode == DataScope.DEPT) {
            string paramKey = "scope_dept_id";
            if (outParams != null) {
                outParams[paramKey] = scope.DeptId;
            }
            return prefix + deptCol + " = @" + paramKey;
        }

        // 3. 本部门及下级 / 自定义部门集合
        if (scope.Mode == DataScope.DEPT_TREE || scope.Mode == DataScope.CUSTOM) {
            List<int> deptIds = scope.GetDeptIdList();
            if (deptIds.Count == 0) {
                return "1 = 0"; // 无合法部门，快速熔断
            }

            if (deptIds.Count == 1) {
                string paramKey = "scope_single_dept";
                if (outParams != null) {
                    outParams[paramKey] = deptIds[0];
                }
                return prefix + deptCol + " = @" + paramKey;
            }

            List<string> paramPlaceholders = new List<string>();
            for (int i = 0; i < deptIds.Count; i = i + 1) {
                string pName = "scope_dept_" + Convert.ToString(i);
                if (outParams != null) {
                    outParams[pName] = deptIds[i];
                }
                paramPlaceholders.Add("@" + pName);
            }
            return prefix + deptCol + " IN (" + string.Join(", ", paramPlaceholders) + ")";
        }

        return "";
    }
}
