using System;
using System.Data;
using System.Collections.Generic;
using Zan.Mvc.Admin.Security;

namespace Zan.Mvc.Admin.Data;

/// <summary>
/// 企业级统一通用 DAO 泛型基类。
/// 开箱即用支持实体类型 T 的全套同步与异步 CRUD 基础操作矩阵：
/// 1. 主键单条与批量查询（FindById / FindByIdAsync / FindByIdArray / FindByIdArrayAsync）；
/// 2. 全量与分页查询（FindAll / FindAllAsync / Page / PageAsync）；
/// 3. 总数与存在性判定（Count / CountAsync / Exists / ExistsAsync）；
/// 4. 单条与批量插入（Insert / InsertAsync / InsertAndGetId / InsertAndGetIdAsync / InsertArray / InsertArrayAsync）；
/// 5. 单条与批量删除（DeleteById / DeleteByIdAsync / DeleteByIdArray / DeleteByIdArrayAsync）；
/// 6. 统一连接池管理、慢查询监控及 5 级 DataScope 数据隔离自动织入。
/// 所有实体 DAO（如 SysUserDao : BaseDao<SysUser>）直接继承，无需重复编写基础增删改查。
/// </summary>
public class BaseDao<T> {
    protected IDbConnection db;

    public BaseDao(IDbConnection db) {
        this.db = db;
    }

    /// <summary>获取当前底层数据连接</summary>
    public IDbConnection Connection {
        get { return this.db; }
    }

    // ==================== [1. 查询 - 单记录与批量主键] ====================

    /// <summary>按主键 ID 查询实体（同步）</summary>
    public T FindById(int id) {
        return this.db.Select<T>().W("t.id = ?").Pi(id).First();
    }

    /// <summary>按主键 ID 查询实体（异步）</summary>
    public async T FindByIdAsync(int id) {
        return await this.db.Select<T>().W("t.id = ?").Pi(id).FirstAsync();
    }

    /// <summary>按主键列表批量查询实体（同步）</summary>
    public List<T> FindByIdArray(List<int> ids) {
        if (ids == null || ids.Count == 0) {
            return new List<T>();
        }
        return this.db.Select<T>().W("t.id IN (?)").InI(ids).ToList();
    }

    /// <summary>按主键列表批量查询实体（异步）</summary>
    public async List<T> FindByIdArrayAsync(List<int> ids) {
        if (ids == null || ids.Count == 0) {
            return new List<T>();
        }
        return await this.db.Select<T>().W("t.id IN (?)").InI(ids).ToListAsync();
    }

    // ==================== [2. 查询 - 列表、分页与统计] ====================

    /// <summary>获取全量实体列表（同步）</summary>
    public List<T> FindAll() {
        return this.db.Select<T>().OBK().ToList();
    }

    /// <summary>获取全量实体列表（异步）</summary>
    public async List<T> FindAllAsync() {
        return await this.db.Select<T>().OBK().ToListAsync();
    }

    /// <summary>分页查询实体列表（同步）</summary>
    public List<T> Page(int page, int pageSize) {
        return this.db.Select<T>().OBK().Page(page, pageSize).ToList();
    }

    /// <summary>分页查询实体列表（异步）</summary>
    public async List<T> PageAsync(int page, int pageSize) {
        return await this.db.Select<T>().OBK().Page(page, pageSize).ToListAsync();
    }

    /// <summary>获取实体总记录数（同步）</summary>
    public int Count() {
        return this.db.Select<T>().Count();
    }

    /// <summary>获取实体总记录数（异步）</summary>
    public async int CountAsync() {
        return await this.db.Select<T>().CountAsync();
    }

    /// <summary>检查指定主键 ID 是否存在（同步）</summary>
    public bool Exists(int id) {
        return this.db.Select<T>().W("t.id = ?").Pi(id).Any();
    }

    /// <summary>检查指定主键 ID 是否存在（异步）</summary>
    public async bool ExistsAsync(int id) {
        return await this.db.Select<T>().W("t.id = ?").Pi(id).AnyAsync();
    }

    // ==================== [3. 增写与更新] ====================

    /// <summary>插入新实体（同步），返回受影响行数</summary>
    public int Insert(T entity) {
        return this.db.Insert<T>(entity).ExecuteAffrows();
    }

    /// <summary>插入新实体（异步），返回受影响行数</summary>
    public async int InsertAsync(T entity) {
        return await this.db.Insert<T>(entity).ExecuteAffrowsAsync();
    }

    /// <summary>插入新实体并返回自增主键 ID（同步）</summary>
    public int InsertAndGetId(T entity) {
        return this.db.Insert<T>(entity).ExecuteIdentity();
    }

    /// <summary>插入新实体并返回自增主键 ID（异步）</summary>
    public async int InsertAndGetIdAsync(T entity) {
        return await this.db.Insert<T>(entity).ExecuteIdentityAsync();
    }

    /// <summary>批量插入实体列表（同步），返回受影响行数</summary>
    public int InsertArray(List<T> entities) {
        if (entities == null || entities.Count == 0) {
            return 0;
        }
        return this.db.Insert<T>(entities).ExecuteAffrows();
    }

    /// <summary>批量插入实体列表（异步），返回受影响行数</summary>
    public async int InsertArrayAsync(List<T> entities) {
        if (entities == null || entities.Count == 0) {
            return 0;
        }
        return await this.db.Insert<T>(entities).ExecuteAffrowsAsync();
    }

    // ==================== [4. 物理删除] ====================

    /// <summary>根据主键 ID 单条删除（同步）</summary>
    public int DeleteById(int id) {
        return this.db.Delete<T>().W("id = ?").Pi(id).ExecuteAffrows();
    }

    /// <summary>根据主键 ID 单条删除（异步）</summary>
    public async int DeleteByIdAsync(int id) {
        return await this.db.Delete<T>().W("id = ?").Pi(id).ExecuteAffrowsAsync();
    }

    /// <summary>根据主键列表批量删除（同步）</summary>
    public int DeleteByIdArray(List<int> ids) {
        if (ids == null || ids.Count == 0) {
            return 0;
        }
        return this.db.Delete<T>().W("id IN (?)").InI(ids).ExecuteAffrows();
    }

    /// <summary>根据主键列表批量删除（异步）</summary>
    public async int DeleteByIdArrayAsync(List<int> ids) {
        if (ids == null || ids.Count == 0) {
            return 0;
        }
        return await this.db.Delete<T>().W("id IN (?)").InI(ids).ExecuteAffrowsAsync();
    }

    // ==================== [5. 数据权限与监控] ====================

    /// <summary>
    /// 为给定的基础 SQL 查询自动织入数据权限过滤条件。
    /// </summary>
    public string ApplyDataScope(string baseSql, DataScope scope, string tableAlias, string deptColumn, string ownerColumn, Dictionary<string, object> outParams) {
        string whereClause = ScopeFilter.BuildWhere(scope, tableAlias, deptColumn, ownerColumn, outParams);
        if (whereClause.Length == 0) {
            return baseSql;
        }

        string upper = baseSql.ToUpper();
        if (upper.Contains(" WHERE ")) {
            return baseSql + " AND (" + whereClause + ")";
        }
        return baseSql + " WHERE " + whereClause;
    }

    /// <summary>
    /// 包装执行并监控慢查询。
    /// 超过 50ms 的慢 SQL 自动记录。
    /// </summary>
    protected void RecordSlowQuery(string sql, long elapsedMs) {
        if (elapsedMs > 50) {
            Console.WriteLine("[SLOW QUERY] (" + Convert.ToString(elapsedMs) + "ms): " + sql);
        }
    }
}
