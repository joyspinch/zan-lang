using System;
using System.Data;
using System.Collections.Generic;
using Zan.Mvc.Admin.Model;

namespace Zan.Mvc.Admin.Data;

/// <summary>
/// 表格与表单视图个性化配置持久化存储引擎。
/// 管理 sys_table_configs 系统表，支持前端拖拽列宽、隐藏列、表单设计器布局微调的无感持久化。
/// 全流程实体模型驱动（SyncStructure / Select / Insert / Update），内置内存高速缓存，杜绝手写 SQL。
/// </summary>
public class ConfigStorage {
    private static Dictionary<string, string> MemoryCache = new Dictionary<string, string>();
    private static bool TableInitialized = false;

    /// <summary>确保配置持久化表结构就绪（CodeFirst 自动模型生表）</summary>
    public static void EnsureTable(IDbConnection db) {
        if (TableInitialized) {
            return;
        }
        db.SyncStructure<SysTableConfig>();
        TableInitialized = true;
    }

    /// <summary>获取指定路由的持久化自定义配置（优先命中内存缓存）</summary>
    public static string GetConfig(IDbConnection db, string route) {
        if (route == null || route.Length == 0) {
            return "";
        }
        if (MemoryCache.ContainsKey(route)) {
            return MemoryCache[route];
        }

        EnsureTable(db);
        SysTableConfig item = db.Select<SysTableConfig>().Where(c => c.route == route).First();
        string json = "";
        if (item != null) {
            json = item.config_json;
        }

        MemoryCache[route] = json;
        return json;
    }

    /// <summary>保存或更新指定路由的个性化差异配置（同步更新内存缓存）</summary>
    public static void SaveConfig(IDbConnection db, string route, string diffJson) {
        if (route == null || route.Length == 0) {
            return;
        }
        EnsureTable(db);
        long now = DateTime.UtcNow().ToUnixSeconds();

        SysTableConfig exist = db.Select<SysTableConfig>().Where(c => c.route == route).First();
        if (exist != null) {
            exist.config_json = diffJson;
            exist.updated_at = now;
            db.Update<SysTableConfig>().SetSource(exist).ExecuteAffrows();
        } else {
            SysTableConfig conf = new SysTableConfig();
            conf.route = route;
            conf.config_json = diffJson;
            conf.updated_at = now;
            db.Insert<SysTableConfig>(conf).ExecuteAffrows();
        }

        // 同步刷新内存缓存
        MemoryCache[route] = diffJson;
    }

    /// <summary>清除指定路由或全量配置缓存</summary>
    public static void ClearCache(string route = "") {
        if (route.Length == 0) {
            MemoryCache.Clear();
        } else if (MemoryCache.ContainsKey(route)) {
            MemoryCache.Remove(route);
        }
    }
}
