using System;
using System.Data;
using System.Collections.Generic;
using Zan.Mvc.Admin.Data;
using Zan.Mvc.Admin.Model;

namespace Zan.Mvc.Admin.Dao;

/// <summary>
/// 权限规则与菜单数据访问对象（DAO）。
/// 继承自通用泛型基类 BaseDao<SysRule>，开箱即得全量同步与异步 CRUD 矩阵。
/// 专职处理系统菜单树检索、权限标识 key 查询等业务。
/// </summary>
public class SysRuleDao : BaseDao<SysRule> {
    public SysRuleDao(IDbConnection db) : base(db) {
    }

    /// <summary>
    /// 工厂构造方法
    /// </summary>
    public static SysRuleDao Of(IDbConnection db) {
        return new SysRuleDao(db);
    }

    // ==================== [规则与菜单业务查询] ====================

    /// <summary>按唯一权限标识 key 查询规则（同步）</summary>
    public SysRule FindByKey(string key) {
        return this.db.Select<SysRule>()
            .W("t.key = ?")
            .P(key)
            .First();
    }

    /// <summary>按唯一权限标识 key 查询规则（异步）</summary>
    public async SysRule FindByKeyAsync(string key) {
        return await this.db.Select<SysRule>()
            .W("t.key = ?")
            .P(key)
            .FirstAsync();
    }

    /// <summary>获取全量菜单项（is_menu = true，按 order_num 升序排列）（同步）</summary>
    public List<SysRule> FindAllMenus() {
        return this.db.Select<SysRule>()
            .W("t.is_menu = 1")
            .OB("order_num")
            .ToList();
    }

    /// <summary>获取全量菜单项（is_menu = true，按 order_num 升序排列）（异步）</summary>
    public async List<SysRule> FindAllMenusAsync() {
        return await this.db.Select<SysRule>()
            .W("t.is_menu = 1")
            .OB("order_num")
            .ToListAsync();
    }

    /// <summary>按父级 ID 获取直属子级规则（同步）</summary>
    public List<SysRule> FindChildren(int parentId) {
        return this.db.Select<SysRule>()
            .W("t.parent_id = ?")
            .Pi(parentId)
            .OB("order_num")
            .ToList();
    }
}
