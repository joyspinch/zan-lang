using System;
using System.Data;
using System.Data.Orm;
using System.Collections.Generic;
using Zan.Mvc.Admin.Model;
using Zan.Mvc.Admin.Data;

namespace Zan.Mvc.Admin.Dao;

/// <summary>
/// 登录审计日志数据访问对象。
/// 继承自通用泛型基类 BaseDao<SysLoginLog>。
/// </summary>
public class SysLoginLogDao : BaseDao<SysLoginLog> {
    public SysLoginLogDao(IDbConnection db) : base(db) {
    }

    public static SysLoginLogDao Of(IDbConnection db) {
        return new SysLoginLogDao(db);
    }

    /// <summary>
    /// 快捷记入一条登录/认证日志
    /// </summary>
    public void Record(int userId, string username, string ip, string userAgent, int status, string message) {
        try {
            SysLoginLog log = new SysLoginLog();
            log.user_id = userId;
            log.username = username != null ? username : "";
            log.ip = ip != null ? ip : "";
            log.user_agent = userAgent != null ? userAgent : "";
            log.status = status;
            log.message = message != null ? message : "";
            log.created_at = DateTime.UtcNow().ToUnixSeconds();
            this.Insert(log);
        } catch (Exception ex) {
            Console.WriteLine("[WARN] Record login log failed: " + ex.Message);
        }
    }

    public List<SysLoginLog> Page(int page, int pageSize) {
        int skip = (page - 1) * pageSize;
        if (skip < 0) { skip = 0; }
        return this.db.Select<SysLoginLog>()
            .OrderByDescending(l => l.id)
            .Skip(skip)
            .Limit(pageSize)
            .ToList();
    }

    public List<SysLoginLog> Recent(int limit) {
        return this.db.Select<SysLoginLog>()
            .OrderByDescending(l => l.id)
            .Limit(limit)
            .ToList();
    }
}
