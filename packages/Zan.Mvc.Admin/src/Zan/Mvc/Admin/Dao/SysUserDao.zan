using System;
using System.Data;
using System.Collections.Generic;
using Zan.Mvc.Admin.Data;
using Zan.Mvc.Admin.Model;

namespace Zan.Mvc.Admin.Dao;

/// <summary>
/// 统一用户数据访问对象（DAO）。
/// 继承自通用泛型基类 BaseDao<SysUser>，开箱即得完整的同步与异步 CRUD 矩阵：
/// - FindById / FindByIdAsync
/// - FindByIdArray / FindByIdArrayAsync
/// - FindAll / FindAllAsync
/// - Page / PageAsync
/// - Count / CountAsync
/// - Exists / ExistsAsync
/// - Insert / InsertAsync
/// - InsertAndGetId / InsertAndGetIdAsync
/// - InsertArray / InsertArrayAsync
/// - DeleteById / DeleteByIdAsync
/// - DeleteByIdArray / DeleteByIdArrayAsync
///
/// 子类只需专注于用户专属业务查询（FindByUsername, FindByDepartment, ExistsUsername 等），
/// 彻底告别大量重复冗余的样板代码。
/// </summary>
public class SysUserDao : BaseDao<SysUser> {
    public SysUserDao(IDbConnection db) : base(db) {
    }

    /// <summary>
    /// 工厂构造方法
    /// </summary>
    public static SysUserDao Of(IDbConnection db) {
        return new SysUserDao(db);
    }

    // ==================== [用户专属业务查询] ====================

    /// <summary>根据用户名查找用户（登录认证）（同步）</summary>
    public SysUser FindByUsername(string username) {
        return this.db.Select<SysUser>()
            .W("t.username = ?")
            .P(username)
            .First();
    }

    /// <summary>根据用户名查找用户（登录认证）（异步）</summary>
    public async SysUser FindByUsernameAsync(string username) {
        return await this.db.Select<SysUser>()
            .W("t.username = ?")
            .P(username)
            .FirstAsync();
    }

    /// <summary>按部门获取用户列表（同步）</summary>
    public List<SysUser> FindByDepartment(int departmentId) {
        return this.db.Select<SysUser>()
            .W("t.department_id = ?")
            .Pi(departmentId)
            .ToList();
    }

    /// <summary>按部门获取用户列表（异步）</summary>
    public async List<SysUser> FindByDepartmentAsync(int departmentId) {
        return await this.db.Select<SysUser>()
            .W("t.department_id = ?")
            .Pi(departmentId)
            .ToListAsync();
    }

    /// <summary>检查用户名是否已存在（同步）</summary>
    public bool ExistsUsername(string username) {
        return this.db.Select<SysUser>()
            .W("t.username = ?")
            .P(username)
            .Any();
    }

    /// <summary>检查用户名是否已存在（异步）</summary>
    public async bool ExistsUsernameAsync(string username) {
        return await this.db.Select<SysUser>()
            .W("t.username = ?")
            .P(username)
            .AnyAsync();
    }
}
