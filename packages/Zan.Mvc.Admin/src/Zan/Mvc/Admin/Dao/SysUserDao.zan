using System;
using System.Data;
using System.Data.Orm;
using System.Collections.Generic;
using Zan.Mvc.Admin.Data;
using Zan.Mvc.Admin.Model;

namespace Zan.Mvc.Admin.Dao;

/// <summary>
/// 统一用户数据访问对象（DAO）。
/// 具备完整的同步与异步基础 CRUD 方法矩阵与工厂构造能力：
/// 1. 工厂方法 Of(db) 快速初始化；
/// 2. 单条与批量主键查询（FindById / FindByIdArray，分同步与异步）；
/// 3. 分页与条件列表（Page / FindAll，分同步与异步）；
/// 4. 单条自增插入与批量插入（Insert / InsertAndGetId / InsertArray，分同步与异步）；
/// 5. 单条与批量主键物理删除（DeleteById / DeleteByIdArray，分同步与异步）；
/// 6. 纯 ORM 强类型绑定，杜绝底层游标列索引（res.GetInt）硬取值。
/// </summary>
public class SysUserDao : BaseDao {
    public SysUserDao(IDbConnection db) : base(db) {
    }

    /// <summary>
    /// 工厂构造方法
    /// </summary>
    public static SysUserDao Of(IDbConnection db) {
        return new SysUserDao(db);
    }

    // ==================== [1. 查询 - 单记录与批量主键] ====================

    /// <summary>按主键 ID 查询用户（同步）</summary>
    public SysUser FindById(int id) {
        return this.db.Select<SysUser>()
            .Where(u => u.id == id)
            .First();
    }

    /// <summary>按主键 ID 查询用户（异步）</summary>
    public async SysUser FindByIdAsync(int id) {
        return await this.db.Select<SysUser>()
            .Where(u => u.id == id)
            .FirstAsync();
    }

    /// <summary>按主键数组批量查询用户列表（同步）</summary>
    public List<SysUser> FindByIdArray(List<int> ids) {
        if (ids == null || ids.Count == 0) {
            return new List<SysUser>();
        }
        return this.db.Select<SysUser>()
            .Where(u => u.id.In(ids))
            .ToList();
    }

    /// <summary>按主键数组批量查询用户列表（异步）</summary>
    public async List<SysUser> FindByIdArrayAsync(List<int> ids) {
        if (ids == null || ids.Count == 0) {
            return new List<SysUser>();
        }
        return await this.db.Select<SysUser>()
            .Where(u => u.id.In(ids))
            .ToListAsync();
    }

    /// <summary>根据用户名查找用户（登录认证）（同步）</summary>
    public SysUser FindByUsername(string username) {
        return this.db.Select<SysUser>()
            .Where(u => u.username == username)
            .First();
    }

    /// <summary>根据用户名查找用户（登录认证）（异步）</summary>
    public async SysUser FindByUsernameAsync(string username) {
        return await this.db.Select<SysUser>()
            .Where(u => u.username == username)
            .FirstAsync();
    }

    /// <summary>按部门获取用户列表（同步）</summary>
    public List<SysUser> FindByDepartment(int departmentId) {
        return this.db.Select<SysUser>()
            .Where(u => u.department_id == departmentId)
            .ToList();
    }

    /// <summary>按部门获取用户列表（异步）</summary>
    public async List<SysUser> FindByDepartmentAsync(int departmentId) {
        return await this.db.Select<SysUser>()
            .Where(u => u.department_id == departmentId)
            .ToListAsync();
    }

    // ==================== [2. 查询 - 列表、分页与统计] ====================

    /// <summary>获取全量用户列表（同步）</summary>
    public List<SysUser> FindAll() {
        return this.db.Select<SysUser>()
            .OrderBy(u => u.id)
            .ToList();
    }

    /// <summary>获取全量用户列表（异步）</summary>
    public async List<SysUser> FindAllAsync() {
        return await this.db.Select<SysUser>()
            .OrderBy(u => u.id)
            .ToListAsync();
    }

    /// <summary>分页查询用户列表（同步）</summary>
    public List<SysUser> Page(int page, int pageSize) {
        return this.db.Select<SysUser>()
            .OrderBy(u => u.id)
            .Page(page, pageSize)
            .ToList();
    }

    /// <summary>分页查询用户列表（异步）</summary>
    public async List<SysUser> PageAsync(int page, int pageSize) {
        return await this.db.Select<SysUser>()
            .OrderBy(u => u.id)
            .Page(page, pageSize)
            .ToListAsync();
    }

    /// <summary>获取用户总记录数（同步）</summary>
    public long Count() {
        return this.db.Select<SysUser>().Count();
    }

    /// <summary>获取用户总记录数（异步）</summary>
    public async long CountAsync() {
        return await this.db.Select<SysUser>().CountAsync();
    }

    /// <summary>检查指定主键 ID 是否存在（同步）</summary>
    public bool Exists(int id) {
        return this.db.Select<SysUser>().Where(u => u.id == id).Any();
    }

    /// <summary>检查指定主键 ID 是否存在（异步）</summary>
    public async bool ExistsAsync(int id) {
        return await this.db.Select<SysUser>().Where(u => u.id == id).AnyAsync();
    }

    /// <summary>检查用户名是否已存在（同步）</summary>
    public bool ExistsUsername(string username) {
        return this.db.Select<SysUser>().Where(u => u.username == username).Any();
    }

    /// <summary>检查用户名是否已存在（异步）</summary>
    public async bool ExistsUsernameAsync(string username) {
        return await this.db.Select<SysUser>().Where(u => u.username == username).AnyAsync();
    }

    // ==================== [3. 增写与更新] ====================

    /// <summary>插入新用户（同步），返回受影响行数</summary>
    public int Insert(SysUser user) {
        return this.db.Insert<SysUser>(user).ExecuteAffrows();
    }

    /// <summary>插入新用户（异步），返回受影响行数</summary>
    public async int InsertAsync(SysUser user) {
        return await this.db.Insert<SysUser>(user).ExecuteAffrowsAsync();
    }

    /// <summary>插入新用户并返回自增主键 ID（同步）</summary>
    public int InsertAndGetId(SysUser user) {
        return this.db.Insert<SysUser>(user).ExecuteIdentity();
    }

    /// <summary>插入新用户并返回自增主键 ID（异步）</summary>
    public async int InsertAndGetIdAsync(SysUser user) {
        return await this.db.Insert<SysUser>(user).ExecuteIdentityAsync();
    }

    /// <summary>批量插入用户列表（同步），返回受影响行数</summary>
    public int InsertArray(List<SysUser> users) {
        if (users == null || users.Count == 0) {
            return 0;
        }
        return this.db.Insert<SysUser>(users).ExecuteAffrows();
    }

    /// <summary>批量插入用户列表（异步），返回受影响行数</summary>
    public async int InsertArrayAsync(List<SysUser> users) {
        if (users == null || users.Count == 0) {
            return 0;
        }
        return await this.db.Insert<SysUser>(users).ExecuteAffrowsAsync();
    }

    /// <summary>更新用户信息（同步），返回受影响行数</summary>
    public int Update(SysUser user) {
        return this.db.Update<SysUser>().SetSource(user).ExecuteAffrows();
    }

    /// <summary>更新用户信息（异步），返回受影响行数</summary>
    public async int UpdateAsync(SysUser user) {
        return await this.db.Update<SysUser>().SetSource(user).ExecuteAffrowsAsync();
    }

    // ==================== [4. 物理删除] ====================

    /// <summary>根据主键 ID 单条删除（同步）</summary>
    public int DeleteById(int id) {
        return this.db.Delete<SysUser>()
            .Where(u => u.id == id)
            .ExecuteAffrows();
    }

    /// <summary>根据主键 ID 单条删除（异步）</summary>
    public async int DeleteByIdAsync(int id) {
        return await this.db.Delete<SysUser>()
            .Where(u => u.id == id)
            .ExecuteAffrowsAsync();
    }

    /// <summary>根据主键数组批量删除（同步）</summary>
    public int DeleteByIdArray(List<int> ids) {
        if (ids == null || ids.Count == 0) {
            return 0;
        }
        return this.db.Delete<SysUser>()
            .Where(u => u.id.In(ids))
            .ExecuteAffrows();
    }

    /// <summary>根据主键数组批量删除（异步）</summary>
    public async int DeleteByIdArrayAsync(List<int> ids) {
        if (ids == null || ids.Count == 0) {
            return 0;
        }
        return await this.db.Delete<SysUser>()
            .Where(u => u.id.In(ids))
            .ExecuteAffrowsAsync();
    }
}
