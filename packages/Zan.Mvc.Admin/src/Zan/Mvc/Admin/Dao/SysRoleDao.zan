using System;
using System.Data;
using System.Collections.Generic;
using Zan.Mvc.Admin.Data;
using Zan.Mvc.Admin.Model;

namespace Zan.Mvc.Admin.Dao;

/// <summary>
/// 角色数据访问对象（DAO）。
/// 继承自通用泛型基类 BaseDao<SysRole>，获得表级通用操作。
/// 专职处理角色主键操作、角色标识校验、角色-规则多对多关系绑定等业务逻辑。
/// </summary>
public class SysRoleDao : BaseDao<SysRole> {
    public SysRoleDao(IDbConnection db) : base(db) {
    }

    /// <summary>工厂构造方法</summary>
    public static SysRoleDao Of(IDbConnection db) {
        return new SysRoleDao(db);
    }

    // ==================== [主键精确操作（类型安全 Lambda）] ====================

    /// <summary>按主键 ID 获取单个角色（同步）</summary>
    public SysRole FindById(int id) {
        return this.db.Select<SysRole>()
            .Where(r => r.id == id)
            .First();
    }

    /// <summary>按主键 ID 获取单个角色（异步）</summary>
    public async SysRole FindByIdAsync(int id) {
        return await this.db.Select<SysRole>()
            .Where(r => r.id == id)
            .FirstAsync();
    }

    /// <summary>按主键 ID 判定角色是否存在（同步）</summary>
    public bool Exists(int id) {
        return this.db.Select<SysRole>()
            .Where(r => r.id == id)
            .Any();
    }

    /// <summary>按主键 ID 判定角色是否存在（异步）</summary>
    public async bool ExistsAsync(int id) {
        return await this.db.Select<SysRole>()
            .Where(r => r.id == id)
            .AnyAsync();
    }

    /// <summary>按主键 ID 删除角色（同步）</summary>
    public int DeleteById(int id) {
        return this.db.Delete<SysRole>()
            .Where(r => r.id == id)
            .ExecuteAffrows();
    }

    /// <summary>按主键 ID 删除角色（异步）</summary>
    public async int DeleteByIdAsync(int id) {
        return await this.db.Delete<SysRole>()
            .Where(r => r.id == id)
            .ExecuteAffrowsAsync();
    }

    // ==================== [角色业务查询与关系维护] ====================

    /// <summary>按唯一标识 key 查询角色（同步）</summary>
    public SysRole FindByKey(string key) {
        return this.db.Select<SysRole>()
            .Where(r => r.key == key)
            .First();
    }

    /// <summary>按唯一标识 key 查询角色（异步）</summary>
    public async SysRole FindByKeyAsync(string key) {
        return await this.db.Select<SysRole>()
            .Where(r => r.key == key)
            .FirstAsync();
    }

    /// <summary>查询指定角色绑定的全部权限规则 ID 列表</summary>
    public List<int> GetRuleIdsByRoleId(int roleId) {
        List<SysRoleRule> bindings = this.db.Select<SysRoleRule>()
            .Where(rr => rr.role_id == roleId)
            .ToList();

        List<int> result = new List<int>();
        for (int i = 0; i < bindings.Count; i = i + 1) {
            result.Add(bindings[i].rule_id);
        }
        return result;
    }

    /// <summary>更新角色权限规则绑定（全量替换）</summary>
    public void SetRoleRules(int roleId, List<int> ruleIds) {
        // 1. 删除旧绑定（Lambda 表达式）
        this.db.Delete<SysRoleRule>()
            .Where(rr => rr.role_id == roleId)
            .ExecuteAffrows();

        // 2. 插入新绑定
        if (ruleIds != null && ruleIds.Count > 0) {
            List<SysRoleRule> rows = new List<SysRoleRule>();
            for (int i = 0; i < ruleIds.Count; i = i + 1) {
                SysRoleRule rr = new SysRoleRule();
                rr.role_id = roleId;
                rr.rule_id = ruleIds[i];
                rows.Add(rr);
            }
            this.db.Insert<SysRoleRule>(rows).ExecuteAffrows();
        }
    }
}
