using System;
using System.Data;
using System.Collections.Generic;
using Zan.Mvc.Admin.Data;
using Zan.Mvc.Admin.Model;

namespace Zan.Mvc.Admin.Dao;

/// <summary>
/// 操作审计日志数据访问对象（DAO）。
/// 继承自通用泛型基类 BaseDao<SysOperationLog>，开箱即得全量同步与异步 CRUD 矩阵。
/// 专职处理操作审计写入、按操作人检索与分页等业务。
/// </summary>
public class SysOperationLogDao : BaseDao<SysOperationLog> {
    public SysOperationLogDao(IDbConnection db) : base(db) {
    }

    /// <summary>
    /// 工厂构造方法
    /// </summary>
    public static SysOperationLogDao Of(IDbConnection db) {
        return new SysOperationLogDao(db);
    }

    // ==================== [审计日志快捷写入与查询] ====================

    /// <summary>快速记录一条操作日志（异步）</summary>
    public async int LogAsync(int adminId, string action, string detail, string ip) {
        SysOperationLog log = new SysOperationLog();
        log.admin_id = adminId;
        log.action = action;
        log.detail = detail;
        log.ip = ip;
        log.created_at = DateTime.UtcNow().ToUnixSeconds();
        return await this.InsertAsync(log);
    }

    /// <summary>快速记录一条操作日志（同步）</summary>
    public int Log(int adminId, string action, string detail, string ip) {
        SysOperationLog log = new SysOperationLog();
        log.admin_id = adminId;
        log.action = action;
        log.detail = detail;
        log.ip = ip;
        log.created_at = DateTime.UtcNow().ToUnixSeconds();
        return this.Insert(log);
    }

    /// <summary>按操作人分页检索日志列表（同步）</summary>
    public List<SysOperationLog> PageByAdmin(int adminId, int page, int pageSize) {
        return this.db.Select<SysOperationLog>()
            .Where(l => l.admin_id == adminId)
            .OBD("id")
            .Page(page, pageSize)
            .ToList();
    }
}
