using System;
using System.Data;
using System.Collections.Generic;
using Zan.Mvc.Admin.Data;
using Zan.Mvc.Admin.Model;

namespace Zan.Mvc.Admin.Dao;

/// <summary>
/// 部门数据访问对象（DAO）。
/// 继承自通用泛型基类 BaseDao<SysDepartment>，获得表级通用操作。
/// 专职处理部门主键操作、组织架构树、预扁平化树路径 (tree_path) 范围检索等业务。
/// </summary>
public class SysDepartmentDao : BaseDao<SysDepartment> {
    public SysDepartmentDao(IDbConnection db) : base(db) {
    }

    /// <summary>工厂构造方法</summary>
    public static SysDepartmentDao Of(IDbConnection db) {
        return new SysDepartmentDao(db);
    }

    // ==================== [主键精确操作（类型安全 Lambda）] ====================

    /// <summary>按主键 ID 获取单个部门（同步）</summary>
    public SysDepartment FindById(int id) {
        return this.db.Select<SysDepartment>()
            .Where(d => d.id == id)
            .First();
    }

    /// <summary>按主键 ID 获取单个部门（异步）</summary>
    public async SysDepartment FindByIdAsync(int id) {
        return await this.db.Select<SysDepartment>()
            .Where(d => d.id == id)
            .FirstAsync();
    }

    /// <summary>按主键 ID 判定部门是否存在（同步）</summary>
    public bool Exists(int id) {
        return this.db.Select<SysDepartment>()
            .Where(d => d.id == id)
            .Any();
    }

    /// <summary>按主键 ID 判定部门是否存在（异步）</summary>
    public async bool ExistsAsync(int id) {
        return await this.db.Select<SysDepartment>()
            .Where(d => d.id == id)
            .AnyAsync();
    }

    /// <summary>按主键 ID 删除部门（同步）</summary>
    public int DeleteById(int id) {
        return this.db.Delete<SysDepartment>()
            .Where(d => d.id == id)
            .ExecuteAffrows();
    }

    /// <summary>按主键 ID 删除部门（异步）</summary>
    public async int DeleteByIdAsync(int id) {
        return await this.db.Delete<SysDepartment>()
            .Where(d => d.id == id)
            .ExecuteAffrowsAsync();
    }

    // ==================== [部门组织架构查询] ====================

    /// <summary>按上级 ID 获取直接下级子部门列表（同步）</summary>
    public List<SysDepartment> FindChildren(int parentId) {
        return this.db.Select<SysDepartment>()
            .Where(d => d.parent_id == parentId)
            .OB("order_num")
            .ToList();
    }

    /// <summary>按上级 ID 获取直接下级子部门列表（异步）</summary>
    public async List<SysDepartment> FindChildrenAsync(int parentId) {
        return await this.db.Select<SysDepartment>()
            .Where(d => d.parent_id == parentId)
            .OB("order_num")
            .ToListAsync();
    }

    /// <summary>
    /// 基于预扁平化树路径前缀检索子树中所有部门（包含自身与全部层级下级）。
    /// 满足 DataScope.DeptAndChildren 5 级数据范围的高性能 O(1) 索引过滤。
    /// </summary>
    public List<SysDepartment> FindSubTree(string treePathPrefix) {
        return this.db.Select<SysDepartment>()
            .Where(d => d.tree_path.StartsWith(treePathPrefix))
            .OB("tree_path")
            .ToList();
    }
}
