using System;
using System.Data;
using System.Collections.Generic;
using Zan.Mvc.Admin.Data;
using Zan.Mvc.Admin.Model;

namespace Zan.Mvc.Admin.Dao;

/// <summary>
/// 部门数据访问对象（DAO）。
/// 继承自通用泛型基类 BaseDao<SysDepartment>，开箱即得全量同步与异步 CRUD 矩阵。
/// 专职处理组织架构树、预扁平化树路径 (tree_path) 范围检索等业务。
/// </summary>
public class SysDepartmentDao : BaseDao<SysDepartment> {
    public SysDepartmentDao(IDbConnection db) : base(db) {
    }

    /// <summary>
    /// 工厂构造方法
    /// </summary>
    public static SysDepartmentDao Of(IDbConnection db) {
        return new SysDepartmentDao(db);
    }

    // ==================== [部门组织架构查询] ====================

    /// <summary>按上级 ID 获取直接下级子部门列表（同步）</summary>
    public List<SysDepartment> FindChildren(int parentId) {
        return this.db.Select<SysDepartment>()
            .W("t.parent_id = ?")
            .Pi(parentId)
            .OB("order_num")
            .ToList();
    }

    /// <summary>按上级 ID 获取直接下级子部门列表（异步）</summary>
    public async List<SysDepartment> FindChildrenAsync(int parentId) {
        return await this.db.Select<SysDepartment>()
            .W("t.parent_id = ?")
            .Pi(parentId)
            .OB("order_num")
            .ToListAsync();
    }

    /// <summary>
    /// 基于预扁平化树路径前缀检索子树中所有部门（包含自身与全部层级下级）。
    /// 满足 DataScope.DeptAndChildren 5 级数据范围的高性能 O(1) 索引过滤。
    /// </summary>
    public List<SysDepartment> FindSubTree(string treePathPrefix) {
        return this.db.Select<SysDepartment>()
            .W("t.tree_path LIKE ?")
            .P(treePathPrefix + "%")
            .OB("tree_path")
            .ToList();
    }
}
