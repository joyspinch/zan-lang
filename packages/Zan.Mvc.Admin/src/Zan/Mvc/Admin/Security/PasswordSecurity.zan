using System;
using System.Text;
using System.Security.Cryptography;

namespace Zan.Mvc.Admin.Security;

/// <summary>
/// 加盐安全密码散列与时序恒定校验器
/// </summary>
public class PasswordSecurity {
    private static const string HexDigits = "0123456789abcdef";

    public static string ToHex(byte[] bytes) {
        if (bytes == null) { return ""; }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < bytes.Length; i = i + 1) {
            int b = bytes[i] & 255;
            sb.Append(HexDigits[(b >> 4) & 15]);
            sb.Append(HexDigits[b & 15]);
        }
        return sb.ToString();
    }

    public static string GenerateSalt(int len = 16) {
        Random rnd = new Random();
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < len; i = i + 1) {
            int idx = rnd.Between(0, 16);
            sb.Append(HexDigits[idx]);
        }
        return sb.ToString();
    }

    public static string HashPassword(string password, string salt) {
        string raw = password + ":" + salt;
        byte[] hash = Sha256.Hash(raw, raw.Length);
        return ToHex(hash);
    }

    public static bool VerifyPassword(string password, string hash, string salt) {
        if (password == null || hash == null || salt == null) { return false; }
        string calculated = HashPassword(password, salt);
        return ConstantTimeEquals(calculated, hash);
    }

    public static bool ConstantTimeEquals(string a, string b) {
        if (a == null || b == null) { return false; }
        if (a.Length != b.Length) { return false; }
        int diff = 0;
        for (int i = 0; i < a.Length; i = i + 1) {
            diff = diff | ((a[i] & 255) ^ (b[i] & 255));
        }
        return diff == 0;
    }
}
