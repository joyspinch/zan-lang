using System;
using System.Collections.Generic;
using Zan.Mvc.Admin.UI;

namespace Zan.Mvc.Admin.Security;

/// <summary>
/// 字段级安全防护熔断器。
/// 在执行单元格即时修改、开关切换（POST Field）时，杜绝水平越权篡改敏感字段（主键、密码、金额、部门归属、角色等）。
/// </summary>
public class FieldSecurityGuard {
    // 强制禁止外部直接通过轻量 Field 接口修改的高危黑名单
    private static List<string> SensitiveFields = new List<string> {
        "id", "password_hash", "salt", "role_id", "department_id", "created_at", "is_delete"
    };

    /// <summary>
    /// 校验某个字段是否允许执行行内修改
    /// </summary>
    public static bool CanInlineEdit(string fieldName, TableConfig config) {
        if (fieldName == null || fieldName.Length == 0) {
            return false;
        }

        string lower = fieldName.ToLower();
        for (int i = 0; i < SensitiveFields.Count; i = i + 1) {
            if (SensitiveFields[i] == lower) {
                return false; // 严禁越权修改核心高危字段
            }
        }

        // 字段必须在当前界面的 Columns 配置中被显式标记为 editable = true
        if (config != null) {
            return config.IsColumnEditable(fieldName);
        }

        return false;
    }
}
