using System;
using System.Collections.Generic;

namespace Zan.Mvc.Admin.Security;

/// <summary>
/// 紧凑型权限与菜单节点（严格 4 字节整数对齐，单事实源）。
/// 用于内存中高速 O(1) 路由权限索引与后台侧边栏菜单树渲染。
/// </summary>
public class PermNode {
    public int Id;                     // 唯一整数自增 ID（4 字节）
    public int ParentId;               // 父级节点 ID（4 字节，0 为顶层模块）
    public uint PermMask;              // 权限位掩码（位运算判权，4 字节）
    public int Order;                  // 排序权重（4 字节）
    public bool IsMenu;                // 是否为前台可见菜单（1 字节）
    public string Key;                 // 稳定权限标识（如 "erp.purchase.view"）
    public string Title;               // 菜单/权限显示标题
    public string Route;               // 绑定的 HTTP 路径（如 "/admin/erp/purchase"）
    public string Method;              // 绑定的 HTTP 动词（GET / POST / *）
    public string Icon;                // 菜单图标标识
    public List<PermNode> Children;    // 子菜单/子权限集合

    public PermNode() {
        this.Id = 0;
        this.ParentId = 0;
        this.PermMask = 0;
        this.Order = 100;
        this.IsMenu = false;
        this.Key = "";
        this.Title = "";
        this.Route = "";
        this.Method = "GET";
        this.Icon = "grid";
        this.Children = new List<PermNode>();
    }

    public PermNode(int id, int parentId, string key, string title, string route, bool isMenu = false, string icon = "grid", int order = 100) {
        this.Id = id;
        this.ParentId = parentId;
        this.PermMask = 0;
        this.Order = order;
        this.IsMenu = isMenu;
        this.Key = key;
        this.Title = title;
        this.Route = route;
        this.Method = "GET";
        this.Icon = icon;
        this.Children = new List<PermNode>();
    }

    public PermNode(int id, int parentId, string key, string title, string method, string route, uint permMask, bool isMenu = false, string icon = "grid", int order = 100) {
        this.Id = id;
        this.ParentId = parentId;
        this.PermMask = permMask;
        this.Order = order;
        this.IsMenu = isMenu;
        this.Key = key;
        this.Title = title;
        this.Route = route;
        this.Method = method;
        this.Icon = icon;
        this.Children = new List<PermNode>();
    }
}
