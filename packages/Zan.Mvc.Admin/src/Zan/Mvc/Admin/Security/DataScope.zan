using System;
using System.Collections.Generic;

namespace Zan.Mvc.Admin.Security;

/// <summary>
/// 企业级 5 级数据范围管控契约与上下文对象。
/// 彻底废除手写线性 for 循环与字符串逗号拼接，改用常数时间 O(1) 字典/哈希查找。
/// </summary>
public class DataScope {
    // 5 级数据权限范围枚举（4 字节整数）
    public static int ALL = 1;           // 1. 全部数据权限（高管/超管）
    public static int DEPT = 2;          // 2. 本部门数据权限（部门经理）
    public static int DEPT_TREE = 3;     // 3. 本部门及下级部门（大区总监）
    public static int SELF = 4;          // 4. 仅本人负责数据（普通员工/销售）
    public static int CUSTOM = 5;        // 5. 自定义指定部门集合（多部门主管）

    public int Mode;                     // 当前生效范围模式
    public int UserId;                   // 当前操作人 ID
    public int DeptId;                   // 当前操作人所属部门 ID
    public Dictionary<int, bool> DeptMap;// 部门白名单哈希索引 (O(1) 快速检索，拒绝线性遍历)

    public DataScope() {
        this.Mode = DataScope.SELF;
        this.UserId = 0;
        this.DeptId = 0;
        this.DeptMap = new Dictionary<int, bool>();
    }

    public DataScope(int mode, int userId, int deptId) {
        this.Mode = mode;
        this.UserId = userId;
        this.DeptId = deptId;
        this.DeptMap = new Dictionary<int, bool>();
    }

    /// <summary>是否具备全量数据权限</summary>
    public bool IsAll() {
        return this.Mode == DataScope.ALL;
    }

    /// <summary>是否仅限本人数据</summary>
    public bool IsSelf() {
        return this.Mode == DataScope.SELF;
    }

    /// <summary>是否按部门限制（本部门、下级或自定义）</summary>
    public bool IsDeptBounded() {
        return this.Mode == DataScope.DEPT || this.Mode == DataScope.DEPT_TREE || this.Mode == DataScope.CUSTOM;
    }

    /// <summary>
    /// O(1) 单步判定当前数据行是否在当前用户的可见范围内。
    /// 拒绝并行 List 遍历，单行毫秒级吞吐。
    /// </summary>
    public bool Covers(int rowUserId, int rowDepartmentId) {
        if (this.Mode == DataScope.ALL) {
            return true;
        }
        if (this.Mode == DataScope.SELF) {
            return rowUserId > 0 && rowUserId == this.UserId;
        }
        if (this.Mode == DataScope.DEPT) {
            return rowDepartmentId > 0 && rowDepartmentId == this.DeptId;
        }
        if (this.Mode == DataScope.DEPT_TREE || this.Mode == DataScope.CUSTOM) {
            return this.DeptMap.ContainsKey(rowDepartmentId);
        }
        return false;
    }

    /// <summary>构造全通配数据范围（超管）</summary>
    public static DataScope Everything(int userId) {
        DataScope sc = new DataScope();
        sc.Mode = DataScope.ALL;
        sc.UserId = userId;
        return sc;
    }

    /// <summary>构造空数据范围（无权或禁用）</summary>
    public static DataScope Empty(int userId) {
        DataScope sc = new DataScope();
        sc.Mode = DataScope.SELF;
        sc.UserId = 0 - 1; // 永远无法匹配合法用户 ID
        return sc;
    }

    /// <summary>构造本部门数据范围</summary>
    public static DataScope ForDepartment(int userId, int deptId) {
        DataScope sc = new DataScope();
        sc.Mode = DataScope.DEPT;
        sc.UserId = userId;
        sc.DeptId = deptId;
        sc.DeptMap[deptId] = true;
        return sc;
    }

    /// <summary>构造部门集合数据范围（下级或自定义）</summary>
    public static DataScope ForDepartmentTree(int userId, int deptId, List<int> deptIds) {
        DataScope sc = new DataScope();
        sc.Mode = DataScope.DEPT_TREE;
        sc.UserId = userId;
        sc.DeptId = deptId;
        for (int i = 0; i < deptIds.Count; i = i + 1) {
            sc.DeptMap[deptIds[i]] = true;
        }
        return sc;
    }

    /// <summary>获取可访问的部门 ID 列表（用于 SQL IN 查询构建）</summary>
    public List<int> GetDeptIdList() {
        List<int> list = new List<int>();
        if (this.Mode == DataScope.DEPT && this.DeptId > 0) {
            list.Add(this.DeptId);
            return list;
        }
        foreach (int id in this.DeptMap.Keys) {
            list.Add(id);
        }
        return list;
    }
}
