using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Mvc.Admin.Model;

namespace Zan.Mvc.Admin.Security;

/// <summary>
/// RBAC 用户授权与规则权限计算中枢。
/// 严格基于编译期表访问器 this.SysUserRole / this.SysRoleRule / this.SysRule 执行单次批量 IN 查询，
/// 杜绝循环查库与 N+1 递归，内存哈希索引 O(1) 判定。
/// </summary>
public class UserAuthService {
    public static UserAuthService Instance = new UserAuthService();

    public IDbConnection __Conn() {
        return AdminApp.Db;
    }

    public bool IsSuperAdmin(int uid) {
        if (uid == 1) { return true; }
        List<SysUserRole> userRoles = this.SysUserRole.W("user_id = ?").Pi(uid).ToList();
        if (userRoles.Count == 0) { return false; }
        for (int i = 0; i < userRoles.Count; i = i + 1) {
            int rid = userRoles[i].role_id;
            List<SysRole> roles = this.SysRole.W("id = ? AND name = 'admin'").Pi(rid).ToList();
            if (roles.Count > 0) { return true; }
        }
        return false;
    }

    public List<SysRule> GetUserRules(int uid) {
        if (this.IsSuperAdmin(uid)) {
            return this.SysRule.W("status = 1").OrderBy("weigh ASC, id ASC").ToList();
        }

        List<SysUserRole> userRoles = this.SysUserRole.W("user_id = ?").Pi(uid).ToList();
        if (userRoles.Count == 0) {
            return new List<SysRule>();
        }

        string roleIdsStr = "";
        for (int i = 0; i < userRoles.Count; i = i + 1) {
            if (i > 0) { roleIdsStr = roleIdsStr + ","; }
            roleIdsStr = roleIdsStr + Convert.ToString(userRoles[i].role_id);
        }

        List<SysRoleRule> roleRules = this.SysRoleRule.W("role_id IN (" + roleIdsStr + ")").ToList();
        if (roleRules.Count == 0) {
            return new List<SysRule>();
        }

        Dict<int, bool> ruleIdMap = new Dict<int, bool>();
        string ruleIdsStr = "";
        int added = 0;
        for (int i = 0; i < roleRules.Count; i = i + 1) {
            int rid = roleRules[i].rule_id;
            if (!ruleIdMap.ContainsKey(rid)) {
                ruleIdMap.Add(rid, true);
                if (added > 0) { ruleIdsStr = ruleIdsStr + ","; }
                ruleIdsStr = ruleIdsStr + Convert.ToString(rid);
                added = added + 1;
            }
        }

        if (ruleIdsStr.Length == 0) {
            return new List<SysRule>();
        }

        return this.SysRule.W("id IN (" + ruleIdsStr + ") AND status = 1").OrderBy("weigh ASC, id ASC").ToList();
    }

    public List<SysRule> GetUserMenuTree(int uid) {
        if (this.IsSuperAdmin(uid)) {
            return this.SysRule.W("status = 1 AND ismenu = 1").OrderBy("weigh ASC, id ASC").ToList();
        }

        List<SysRule> userRules = this.GetUserRules(uid);
        List<SysRule> menuRules = new List<SysRule>();
        Dict<int, bool> idMap = new Dict<int, bool>();

        for (int i = 0; i < userRules.Count; i = i + 1) {
            SysRule r = userRules[i];
            if (r.ismenu == 1) {
                menuRules.Add(r);
                idMap.Add(r.id, true);
            }
        }

        // 收集所有缺失的父级节点，使用单次批量 IN 查询补齐
        string missingPidStr = "";
        int missingCount = 0;
        for (int i = 0; i < menuRules.Count; i = i + 1) {
            int pid = menuRules[i].pid;
            if (pid > 0 && !idMap.ContainsKey(pid)) {
                idMap.Add(pid, true);
                if (missingCount > 0) { missingPidStr = missingPidStr + ","; }
                missingPidStr = missingPidStr + Convert.ToString(pid);
                missingCount = missingCount + 1;
            }
        }

        if (missingPidStr.Length > 0) {
            List<SysRule> parents = this.SysRule.W("id IN (" + missingPidStr + ") AND status = 1").ToList();
            for (int i = 0; i < parents.Count; i = i + 1) {
                menuRules.Add(parents[i]);
            }
        }

        return menuRules;
    }

    public async bool Allow(string uidStr, string action) {
        if (action == null || action.Length == 0) { return true; }
        if (uidStr == null || uidStr.Length == 0) { return false; }

        int uid = 0;
        try {
            uid = Convert.ToInt32(uidStr);
        } catch (Exception ex) {
            return false;
        }

        if (uid <= 0) { return false; }
        if (this.IsSuperAdmin(uid)) { return true; }

        List<SysRule> rules = this.GetUserRules(uid);
        for (int i = 0; i < rules.Count; i = i + 1) {
            SysRule r = rules[i];
            if (r.name == action || r.route == action) {
                return true;
            }
            if (action.StartsWith(r.route) && r.route.Length > 1) {
                return true;
            }
        }

        return false;
    }
}
