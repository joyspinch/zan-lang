using System;
using System.Collections.Generic;

namespace Zan.Mvc.Admin.Security;

class RateLimitBucket {
    public long WindowStartSec;
    public int Count;

    public RateLimitBucket(long startSec) {
        this.WindowStartSec = startSec;
        this.Count = 1;
    }
}

/// <summary>
/// 纯内存高性能滑动窗口防刷限流器。
/// 适用于敏感写操作（登录、密码重置、批量删除、敏感配置修改）与高频 API。
/// 内存受控：超过阈值自动淘汰过期桶，单请求无磁盘与外部网络开销。
/// </summary>
public class AdminRateLimiter {
    private static object _lock = new object();
    private static Dictionary<string, RateLimitBucket> _buckets = new Dictionary<string, RateLimitBucket>();
    private static long _lastCleanupSec = 0;

    /// <summary>
    /// 检查指定维度（如 IP:Action 或 AdminId:Action）在窗口期内是否超限。
    /// 未超限则计数并返回 true；已超限返回 false。
    /// </summary>
    public static bool Check(string key, int maxRequests, int windowSeconds = 60) {
        if (key == null || key.Length == 0 || maxRequests <= 0) {
            return true;
        }

        long nowSec = DateTime.Now().ToUnixSeconds();

        lock (_lock) {
            // 每 60 秒或字典过大（> 2000 个桶）时触发惰性过期回收
            if (nowSec - _lastCleanupSec > 60 || _buckets.Count > 2000) {
                CleanupExpired(nowSec, windowSeconds);
                _lastCleanupSec = nowSec;
            }

            RateLimitBucket bucket = null;
            if (_buckets.TryGetValue(key, out bucket)) {
                if (nowSec - bucket.WindowStartSec < (long)windowSeconds) {
                    if (bucket.Count >= maxRequests) {
                        return false; // 触发限流阻断
                    }
                    bucket.Count = bucket.Count + 1;
                    return true;
                } else {
                    // 窗口过期，重置新窗口
                    bucket.WindowStartSec = nowSec;
                    bucket.Count = 1;
                    return true;
                }
            } else {
                if (_buckets.Count >= 5000) {
                    // 安全上限保护：防止恶意伪造海量 IP 打爆内存
                    return false;
                }
                _buckets.Add(key, new RateLimitBucket(nowSec));
                return true;
            }
        }
    }

    /// <summary>
    /// 清理已过期的限流桶
    /// </summary>
    private static void CleanupExpired(long nowSec, int defaultWindowSec) {
        List<string> expiredKeys = new List<string>();
        foreach (KeyValuePair<string, RateLimitBucket> kv in _buckets) {
            if (nowSec - kv.Value.WindowStartSec > (long)(defaultWindowSec * 2)) {
                expiredKeys.Add(kv.Key);
            }
        }
        for (int i = 0; i < expiredKeys.Count; i = i + 1) {
            _buckets.Remove(expiredKeys[i]);
        }
    }

    /// <summary>
    /// 手工重置或清除指定键（如登录成功后解除验证码计数）
    /// </summary>
    public static void Reset(string key) {
        lock (_lock) {
            if (_buckets.ContainsKey(key)) {
                _buckets.Remove(key);
            }
        }
    }
}
