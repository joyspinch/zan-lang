using System;
using System.Collections.Generic;
using System.Json;

namespace Zan.Mvc.Admin.Validation;

/// <summary>
/// 结构化参数校验结果。
/// 包含首个阻断错误与全量字段错误明细，便于前端高亮具体输入框。
/// </summary>
public class ValidateResult {
    private bool ok;
    private string firstError;
    private string firstField;
    private Dict<string, string> errors;

    public ValidateResult() {
        this.ok = true;
        this.firstError = "";
        this.firstField = "";
        this.errors = new Dict<string, string>();
    }

    public bool IsOk() { return this.ok; }
    public string GetFirstError() { return this.firstError; }
    public string GetFirstField() { return this.firstField; }
    public Dict<string, string> GetErrors() { return this.errors; }

    public void AddError(string field, string message) {
        this.ok = false;
        if (this.firstError.Length == 0) {
            this.firstError = message;
            this.firstField = field;
        }
        if (!this.errors.ContainsKey(field)) {
            this.errors.Add(field, message);
        }
    }

    public string ToJson() {
        JsonValue obj = JsonValue.NewObject();
        obj.PutBool("ok", this.ok);
        obj.PutStr("first_error", this.firstError);
        obj.PutStr("first_field", this.firstField);

        JsonValue errObj = JsonValue.NewObject();
        foreach (string k in this.errors.Keys) {
            string msg;
            if (this.errors.TryGetValue(k, out msg)) {
                errObj.PutStr(k, msg);
            }
        }
        obj.Put("errors", errObj);
        return obj.ToJson();
    }
}
