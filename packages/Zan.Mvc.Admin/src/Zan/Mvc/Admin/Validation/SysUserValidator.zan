using System;
using System.Collections.Generic;

namespace Zan.Mvc.Admin.Validation;

/// <summary>
/// 系统用户结构化校验器。
/// 严格遵循开箱即用规范，区分新增场景（add）与编辑场景（edit）。
/// </summary>
public class SysUserValidator : BaseValidator {
    public SysUserValidator() {
        this.Rule("username", "require|min:3|max:32", "用户名不能为空|用户名不能少于3位|用户名不能超过32位");
        this.Rule("password_hash", "min:6", "密码长度不能少于6位");
        this.Rule("nickname", "max:32", "昵称长度不能超过32位");
        this.Rule("status", "in:0,1", "状态值必须为0或1");

        // 新增场景：username 必填
        this.Scene("add", "username,password_hash,nickname,status");
        // 编辑场景：密码选填（留空表示不修改）
        this.Scene("edit", "username,password_hash,nickname,status");
    }
}
