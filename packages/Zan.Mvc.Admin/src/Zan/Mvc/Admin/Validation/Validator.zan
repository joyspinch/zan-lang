using System;
using System.Collections.Generic;
using System.Text.RegularExpressions;

namespace Zan.Mvc.Admin.Validation;

/// <summary>
/// 结构化参数校验器内核引擎。
/// 提供常用业务断言、正则与格式校验，支持链式调用与规则管道解析。
/// </summary>
public class Validator {
    private ValidateResult result;
    private string currentField;
    private string currentVal;

    public Validator() {
        this.result = new ValidateResult();
        this.currentField = "";
        this.currentVal = "";
    }

    public ValidateResult Result { get { return this.result; } }

    /// <summary>开始校验指定字段</summary>
    public Validator Field(string field, string val) {
        this.currentField = field;
        this.currentVal = val != null ? val : "";
        return this;
    }

    /// <summary>必填校验</summary>
    public Validator Require(string message = "") {
        if (this.currentVal.Length == 0) {
            string msg = message.Length > 0 ? message : this.currentField + " 不能为空";
            this.result.AddError(this.currentField, msg);
        }
        return this;
    }

    /// <summary>最小长度校验（留空跳过，与 Require 配合）</summary>
    public Validator MinLen(int min, string message = "") {
        if (this.currentVal.Length > 0 && this.currentVal.Length < min) {
            string msg = message.Length > 0 ? message : this.currentField + " 长度不能少于 " + Convert.ToString(min) + " 位";
            this.result.AddError(this.currentField, msg);
        }
        return this;
    }

    /// <summary>最大长度校验</summary>
    public Validator MaxLen(int max, string message = "") {
        if (this.currentVal.Length > max) {
            string msg = message.Length > 0 ? message : this.currentField + " 长度不能超过 " + Convert.ToString(max) + " 位";
            this.result.AddError(this.currentField, msg);
        }
        return this;
    }

    /// <summary>数值最小值校验</summary>
    public Validator Min(double min, string message = "") {
        if (this.currentVal.Length > 0) {
            double v = Convert.ToDouble(this.currentVal);
            if (v < min) {
                string msg = message.Length > 0 ? message : this.currentField + " 不能小于 " + Convert.ToString(min);
                this.result.AddError(this.currentField, msg);
            }
        }
        return this;
    }

    /// <summary>数值最大值校验</summary>
    public Validator Max(double max, string message = "") {
        if (this.currentVal.Length > 0) {
            double v = Convert.ToDouble(this.currentVal);
            if (v > max) {
                string msg = message.Length > 0 ? message : this.currentField + " 不能大于 " + Convert.ToString(max);
                this.result.AddError(this.currentField, msg);
            }
        }
        return this;
    }

    /// <summary>手机号格式校验（11位数字，1开头）</summary>
    public Validator Mobile(string message = "") {
        if (this.currentVal.Length > 0) {
            bool ok = this.currentVal.Length == 11 && this.currentVal.StartsWith("1");
            if (ok) {
                for (int i = 0; i < 11; i = i + 1) {
                    string ch = this.currentVal.Substring(i, 1);
                    if (ch < "0" || ch > "9") { ok = false; break; }
                }
            }
            if (!ok) {
                string msg = message.Length > 0 ? message : this.currentField + " 格式不合法";
                this.result.AddError(this.currentField, msg);
            }
        }
        return this;
    }

    /// <summary>邮箱格式校验</summary>
    public Validator Email(string message = "") {
        if (this.currentVal.Length > 0) {
            int at = this.currentVal.IndexOf("@");
            int dot = this.currentVal.LastIndexOf(".");
            if (at <= 0 || dot <= at + 1 || dot >= this.currentVal.Length - 1) {
                string msg = message.Length > 0 ? message : this.currentField + " 邮箱格式不正确";
                this.result.AddError(this.currentField, msg);
            }
        }
        return this;
    }

    /// <summary>枚举白名单校验（例如: "0,1"）</summary>
    public Validator In(string allowedCsv, string message = "") {
        if (this.currentVal.Length > 0) {
            List<string> parts = allowedCsv.Split(",");
            bool found = false;
            for (int i = 0; i < parts.Count; i = i + 1) {
                if (parts[i].Trim() == this.currentVal) {
                    found = true;
                    break;
                }
            }
            if (!found) {
                string msg = message.Length > 0 ? message : this.currentField + " 不是允许的取值";
                this.result.AddError(this.currentField, msg);
            }
        }
        return this;
    }

    /// <summary>正整数校验 (> 0)</summary>
    public Validator Positive(string message = "") {
        if (this.currentVal.Length > 0) {
            int v = Convert.ToInt32(this.currentVal);
            if (v <= 0) {
                string msg = message.Length > 0 ? message : this.currentField + " 必须为正整数";
                this.result.AddError(this.currentField, msg);
            }
        }
        return this;
    }

    /// <summary>自定义正则校验</summary>
    public Validator Regex(string pattern, string message = "") {
        if (this.currentVal.Length > 0 && pattern.Length > 0) {
            System.Text.RegularExpressions.Regex re = System.Text.RegularExpressions.Regex.Compile(pattern);
            if (!re.IsMatch(this.currentVal)) {
                string msg = message.Length > 0 ? message : this.currentField + " 格式校验未通过";
                this.result.AddError(this.currentField, msg);
            }
        }
        return this;
    }

    /// <summary>执行单条规则管道断言（如 "require|min:3|max:10"）</summary>
    public static void ApplyRule(Validator v, string field, string val, string ruleExpr, string messageExpr = "") {
        v.Field(field, val);
        List<string> rules = ruleExpr.Split("|");
        List<string> msgs = messageExpr.Length > 0 ? messageExpr.Split("|") : new List<string>();

        for (int i = 0; i < rules.Count; i = i + 1) {
            string r = rules[i].Trim();
            if (r.Length == 0) { continue; }
            string customMsg = i < msgs.Count ? msgs[i].Trim() : "";

            if (r == "require") {
                v.Require(customMsg);
            } else if (r.StartsWith("min:")) {
                int min = Convert.ToInt32(r.Substring(4));
                v.MinLen(min, customMsg);
            } else if (r.StartsWith("max:")) {
                int max = Convert.ToInt32(r.Substring(4));
                v.MaxLen(max, customMsg);
            } else if (r.StartsWith("in:")) {
                string csv = r.Substring(3);
                v.In(csv, customMsg);
            } else if (r == "mobile") {
                v.Mobile(customMsg);
            } else if (r == "email") {
                v.Email(customMsg);
            } else if (r == "positive") {
                v.Positive(customMsg);
            }
        }
    }
}
