using System;
using System.Collections.Generic;
using System.Numerics;
using System.Text;

namespace Testing.Fixtures;

// 语义化假数据（门面层）：人名、邮箱、地址、公司、句子、颜色……
//
// **为什么单独一层**：Bogus / AutoFixture 的价值不在"随机数"，而在"随机出来
// 的东西像真的"——邮箱有 @、域名有后缀、电话是号码、地址有街道和门牌。测试
// 里造一个 `test@test.com` 当邮箱，格式化与校验的分支就永远走不到。
//
// **数据表是内联的小词表**：不是英语母语语料的复刻，够测试用即可。词表放成
// 静态数组会在进程退出时留下一份不释放的 rc 集合（见路线图 §7 的已知缺陷），
// 所以这里改成每次调用现造数组——测试数据生成不在热路径上。
//
// **不生成"看起来能用的"敏感数据**：信用卡号用保留的测试卡号段，手机号用
// 保留的测试号段，免得假数据被误当成真数据发出去。
//
// **并发**：非线程安全（复用同一个随机源）。
public class FixtureText {
    private FixtureRandom random;
    private RandomExt rng;
    private byte[] scratch;

    public FixtureText(FixtureRandom random) {
        this.random = random != null ? random : new FixtureRandom();
        this.rng = this.random.rng;
        this.scratch = new byte[256];
    }

    private void EnsureScratch(int need) {
        if (this.scratch.Length < need) {
            this.scratch = new byte[need];
        }
    }

    // 名。
    public string FirstName() {
        return FixtureText.FirstNameAt(this.rng.NextInt(0, 20));
    }

    // 姓。
    public string LastName() {
        return FixtureText.LastNameAt(this.rng.NextInt(0, 20));
    }

    // 姓名（姓 + 名）。
    public string FullName() {
        string last = FixtureText.LastNameAt(this.rng.NextInt(0, 20));
        string first = FixtureText.FirstNameAt(this.rng.NextInt(0, 20));
        int ll = last.Length;
        int fl = first.Length;
        nint bp = (nint)this.scratch;
        NativeMemory.Copy(bp, (nint)last, ll);
        NativeMemory.Copy(bp + (nint)ll, (nint)first, fl);
        return NativeMemory.GetString(bp, 0, ll + fl);
    }

    // 登录名（小写字母与数字，5..12 位）。
    public string UserName() {
        return this.random.Alphanumeric(5, 12);
    }

    private static int WriteAlnum(Span<byte> buf, int di, RandomExt r, int minLen, int maxLen) {
        int len = r.NextInt(minLen, maxLen + 1);
        for (int i = 0; i < len; i = i + 1) {
            int v = r.NextInt(0, 36);
            buf[di] = (byte)(v < 26 ? 97 + v : 48 + (v - 26));
            di = di + 1;
        }
        return di;
    }

    private static int WriteIntSmall(Span<byte> buf, int di, int v) {
        if (v >= 100) {
            int d0 = v / 100;
            int rem = v - d0 * 100;
            int d1 = rem / 10;
            buf[di] = (byte)(48 + d0);
            buf[di + 1] = (byte)(48 + d1);
            buf[di + 2] = (byte)(48 + (rem - d1 * 10));
            return di + 3;
        }
        if (v >= 10) {
            int d1 = v / 10;
            buf[di] = (byte)(48 + d1);
            buf[di + 1] = (byte)(48 + (v - d1 * 10));
            return di + 2;
        }
        buf[di] = (byte)(48 + v);
        return di + 1;
    }

    // 邮箱（`名.姓@域名` 形态）。
    public string Email() {
        nint bp = (nint)this.scratch;
        Span<byte> buf = new Span<byte>(bp, 40);
        int di = FixtureText.WriteAlnum(buf, 0, this.rng, 5, 12);
        buf[di] = 64;
        di = FixtureText.WriteAlnum(buf, di + 1, this.rng, 4, 10);
        buf[di] = 46;
        di = di + 1;
        string tld = FixtureText.TldAt(this.rng.NextInt(0, 6));
        int tl = tld.Length;
        NativeMemory.Copy(bp + (nint)di, (nint)tld, tl);
        return NativeMemory.GetString(bp, 0, di + tl);
    }

    // 域名（`词.后缀` 形态）。
    public string Domain() {
        nint bp = (nint)this.scratch;
        Span<byte> buf = new Span<byte>(bp, 24);
        int di = FixtureText.WriteAlnum(buf, 0, this.rng, 4, 10);
        buf[di] = 46;
        di = di + 1;
        string tld = FixtureText.TldAt(this.rng.NextInt(0, 6));
        int tl = tld.Length;
        NativeMemory.Copy(bp + (nint)di, (nint)tld, tl);
        return NativeMemory.GetString(bp, 0, di + tl);
    }

    // URL（https）。
    public string Url() {
        nint bp = (nint)this.scratch;
        Span<byte> buf = new Span<byte>(bp, 64);
        RandomExt r = this.rng;
        NativeMemory.Copy(bp, (nint)"https://", 8);
        int di = FixtureText.WriteAlnum(buf, 8, r, 4, 10);
        buf[di] = 46;
        di = di + 1;
        string tld = FixtureText.TldAt(r.NextInt(0, 6));
        int tl = tld.Length;
        NativeMemory.Copy(bp + (nint)di, (nint)tld, tl);
        di = di + tl;
        buf[di] = 47;
        di = di + 1;
        int count = r.NextInt(2, 5);
        for (int i = 0; i < count; i = i + 1) {
            if (i > 0) { buf[di] = 45; di = di + 1; }
            string w = FixtureText.WordAt(r.NextInt(0, 20));
            int wl = w.Length;
            NativeMemory.Copy(bp + (nint)di, (nint)w, wl);
            di = di + wl;
        }
        return NativeMemory.GetString(bp, 0, di);
    }

    // 国际电话号码（保留测试号段 + 假号）。
    public string PhoneNumber() {
        nint bp = (nint)this.scratch;
        Span<byte> buf = new Span<byte>(bp, 15);
        RandomExt r = this.rng;
        NativeMemory.Copy(bp, (nint)"+1-555-", 7);
        buf[7] = (byte)(48 + r.NextInt(0, 10));
        buf[8] = (byte)(48 + r.NextInt(0, 10));
        buf[9] = (byte)(48 + r.NextInt(0, 10));
        buf[10] = 45;
        buf[11] = (byte)(48 + r.NextInt(0, 10));
        buf[12] = (byte)(48 + r.NextInt(0, 10));
        buf[13] = (byte)(48 + r.NextInt(0, 10));
        buf[14] = (byte)(48 + r.NextInt(0, 10));
        return NativeMemory.GetString(bp, 0, 15);
    }

    // 街道地址。
    public string StreetAddress() {
        int num = this.rng.NextInt(1, 999);
        string street = FixtureText.StreetAt(this.rng.NextInt(0, 10));
        int sl = street.Length;
        nint bp = (nint)this.scratch;
        Span<byte> buf = new Span<byte>(bp, 20);
        int di = FixtureText.WriteIntSmall(buf, 0, num);
        buf[di] = 32;
        di = di + 1;
        NativeMemory.Copy(bp + (nint)di, (nint)street, sl);
        di = di + sl;
        buf[di] = 32;
        buf[di + 1] = 83;
        buf[di + 2] = 116;
        return NativeMemory.GetString(bp, 0, di + 3);
    }

    // 城市。
    public string City() {
        return FixtureText.CityAt(this.rng.NextInt(0, 15));
    }

    // 国家。
    public string Country() {
        return FixtureText.CountryAt(this.rng.NextInt(0, 10));
    }

    // 邮政编码（5 位数字）。
    public string ZipCode() {
        return this.random.Digits(5);
    }

    // 公司名。
    public string Company() {
        string w = FixtureText.CompanyWordAt(this.rng.NextInt(0, 10));
        string s = FixtureText.CompanySuffixAt(this.rng.NextInt(0, 6));
        int wl = w.Length;
        int sl = s.Length;
        nint bp = (nint)this.scratch;
        Span<byte> buf = new Span<byte>(bp, wl + 1 + sl);
        NativeMemory.Copy(bp, (nint)w, wl);
        buf[wl] = 32;
        NativeMemory.Copy(bp + (nint)(wl + 1), (nint)s, sl);
        return NativeMemory.GetString(bp, 0, wl + 1 + sl);
    }

    // 一个句子（3..12 个词，带句号）。
    public string Sentence() {
        RandomExt r = this.rng;
        int count = r.NextInt(3, 13);
        nint bp = (nint)this.scratch;
        Span<byte> buf = new Span<byte>(bp, 100);
        int di = 0;
        for (int i = 0; i < count; i = i + 1) {
            if (i > 0) { buf[di] = 32; di = di + 1; }
            string w = FixtureText.WordAt(r.NextInt(0, 20));
            int wl = w.Length;
            NativeMemory.Copy(bp + (nint)di, (nint)w, wl);
            di = di + wl;
        }
        buf[di] = 46;
        return NativeMemory.GetString(bp, 0, di + 1);
    }

    // 一段话（若干句子）。
    public string Paragraph(int sentences) {
        if (sentences <= 0) { return ""; }
        long needL = (long)sentences * 97L;
        if (needL > 67108864L) {
            throw new FixtureException(FixtureError.InvalidArgument, "",
                "FixtureText.Paragraph: sentences exceeds limit");
        }
        int need = (int)needL;
        this.EnsureScratch(need);
        nint bp = (nint)this.scratch;
        Span<byte> buf = new Span<byte>(bp, need);
        RandomExt r = this.rng;
        int di = 0;
        for (int s = 0; s < sentences; s = s + 1) {
            if (s > 0) { buf[di] = 32; di = di + 1; }
            int count = r.NextInt(3, 13);
            for (int i = 0; i < count; i = i + 1) {
                if (i > 0) { buf[di] = 32; di = di + 1; }
                string w = FixtureText.WordAt(r.NextInt(0, 20));
                int wl = w.Length;
                NativeMemory.Copy(bp + (nint)di, (nint)w, wl);
                di = di + wl;
            }
            buf[di] = 46;
            di = di + 1;
        }
        return NativeMemory.GetString(bp, 0, di);
    }

    // 若干个词（空格分隔）。
    public string Words(int count) {
        if (count <= 0) { return ""; }
        long needL = (long)count * 8L;
        if (needL > 67108864L) {
            throw new FixtureException(FixtureError.InvalidArgument, "",
                "FixtureText.Words: count exceeds limit");
        }
        int need = (int)needL;
        this.EnsureScratch(need);
        nint bp = (nint)this.scratch;
        Span<byte> buf = new Span<byte>(bp, need);
        RandomExt r = this.rng;
        int di = 0;
        for (int i = 0; i < count; i = i + 1) {
            if (i > 0) { buf[di] = 32; di = di + 1; }
            string w = FixtureText.WordAt(r.NextInt(0, 20));
            int wl = w.Length;
            NativeMemory.Copy(bp + (nint)di, (nint)w, wl);
            di = di + wl;
        }
        return NativeMemory.GetString(bp, 0, di);
    }

    // URL 友好的短标识（kebab-case）。
    public string Slug() {
        RandomExt r = this.rng;
        int count = r.NextInt(2, 5);
        nint bp = (nint)this.scratch;
        Span<byte> buf = new Span<byte>(bp, 36);
        int di = 0;
        for (int i = 0; i < count; i = i + 1) {
            if (i > 0) { buf[di] = 45; di = di + 1; }
            string w = FixtureText.WordAt(r.NextInt(0, 20));
            int wl = w.Length;
            NativeMemory.Copy(bp + (nint)di, (nint)w, wl);
            di = di + wl;
        }
        return NativeMemory.GetString(bp, 0, di);
    }

    // 十六进制颜色（`#rrggbb`）。
    public string ColorHex() {
        nint bp = (nint)this.scratch;
        Span<byte> buf = new Span<byte>(bp, 7);
        RandomExt r = this.rng;
        buf[0] = 35;
        for (int i = 1; i < 7; i = i + 1) {
            int v = r.NextInt(0, 16);
            buf[i] = (byte)(v < 10 ? 48 + v : 87 + v);
        }
        return NativeMemory.GetString(bp, 0, 7);
    }

    // 语义化版本号（`1.2.3`）。
    public string SemanticVersion() {
        int a = this.rng.NextInt(0, 5);
        int b = this.rng.NextInt(0, 20);
        int c = this.rng.NextInt(0, 30);
        nint bp = (nint)this.scratch;
        Span<byte> buf = new Span<byte>(bp, 8);
        buf[0] = (byte)(48 + a);
        buf[1] = 46;
        int di = FixtureText.WriteIntSmall(buf, 2, b);
        buf[di] = 46;
        di = FixtureText.WriteIntSmall(buf, di + 1, c);
        return NativeMemory.GetString(bp, 0, di);
    }

    // 信用卡号（**保留的测试卡号段**，不生成可真实扣款的号）。
    //
    // 4242 开头是支付网关公开的测试卡号段；这里再拼 12 位随机数字，够跑
    // Luhn 校验与长度校验，但不会撞上真实卡号。
    public string CreditCardNumber() {
        nint bp = (nint)this.scratch;
        Span<byte> buf = new Span<byte>(bp, 16);
        RandomExt r = this.rng;
        buf[0] = 52; buf[1] = 50; buf[2] = 52; buf[3] = 50;
        for (int i = 4; i < 16; i = i + 1) {
            buf[i] = (byte)(48 + r.NextInt(0, 10));
        }
        return NativeMemory.GetString(bp, 0, 16);
    }

    // 零堆分配静态字面量分发（无 static string[] 退出残余，零 GC/ARC 分配）。
    private static string WordAt(int i) {
        switch (i) {
            case 0: return "data";
            case 1: return "network";
            case 2: return "signal";
            case 3: return "buffer";
            case 4: return "kernel";
            case 5: return "module";
            case 6: return "packet";
            case 7: return "router";
            case 8: return "server";
            case 9: return "client";
            case 10: return "token";
            case 11: return "cache";
            case 12: return "stream";
            case 13: return "record";
            case 14: return "engine";
            case 15: return "bridge";
            case 16: return "worker";
            case 17: return "queue";
            case 18: return "index";
            default: return "graph";
        }
    }

    private static string FirstNameAt(int i) {
        switch (i) {
            case 0: return "伟";
            case 1: return "芳";
            case 2: return "娜";
            case 3: return "秀英";
            case 4: return "敏";
            case 5: return "静";
            case 6: return "丽";
            case 7: return "强";
            case 8: return "磊";
            case 9: return "洋";
            case 10: return "艳";
            case 11: return "勇";
            case 12: return "军";
            case 13: return "杰";
            case 14: return "娟";
            case 15: return "涛";
            case 16: return "明";
            case 17: return "超";
            case 18: return "秀兰";
            default: return "霞";
        }
    }

    private static string LastNameAt(int i) {
        switch (i) {
            case 0: return "王";
            case 1: return "李";
            case 2: return "张";
            case 3: return "刘";
            case 4: return "陈";
            case 5: return "杨";
            case 6: return "黄";
            case 7: return "赵";
            case 8: return "吴";
            case 9: return "周";
            case 10: return "徐";
            case 11: return "孙";
            case 12: return "马";
            case 13: return "朱";
            case 14: return "胡";
            case 15: return "郭";
            case 16: return "何";
            case 17: return "高";
            case 18: return "林";
            default: return "罗";
        }
    }

    private static string CityAt(int i) {
        switch (i) {
            case 0: return "北京";
            case 1: return "上海";
            case 2: return "广州";
            case 3: return "深圳";
            case 4: return "杭州";
            case 5: return "成都";
            case 6: return "武汉";
            case 7: return "西安";
            case 8: return "南京";
            case 9: return "重庆";
            case 10: return "天津";
            case 11: return "苏州";
            case 12: return "青岛";
            case 13: return "长沙";
            default: return "郑州";
        }
    }

    private static string CountryAt(int i) {
        switch (i) {
            case 0: return "中国";
            case 1: return "日本";
            case 2: return "韩国";
            case 3: return "美国";
            case 4: return "德国";
            case 5: return "法国";
            case 6: return "英国";
            case 7: return "加拿大";
            case 8: return "澳大利亚";
            default: return "新加坡";
        }
    }

    private static string StreetAt(int i) {
        switch (i) {
            case 0: return "Main";
            case 1: return "Oak";
            case 2: return "Pine";
            case 3: return "Maple";
            case 4: return "Cedar";
            case 5: return "Elm";
            case 6: return "Sunset";
            case 7: return "Highland";
            case 8: return "River";
            default: return "Lake";
        }
    }

    private static string CompanyWordAt(int i) {
        switch (i) {
            case 0: return "Blue";
            case 1: return "Silver";
            case 2: return "North";
            case 3: return "Quantum";
            case 4: return "Iron";
            case 5: return "Vertex";
            case 6: return "Lumen";
            case 7: return "Orbit";
            case 8: return "Summit";
            default: return "Cobalt";
        }
    }

    private static string CompanySuffixAt(int i) {
        switch (i) {
            case 0: return "Labs";
            case 1: return "Systems";
            case 2: return "Works";
            case 3: return "Group";
            case 4: return "Technologies";
            default: return "Dynamics";
        }
    }

    private static string TldAt(int i) {
        switch (i) {
            case 0: return "com";
            case 1: return "net";
            case 2: return "org";
            case 3: return "io";
            case 4: return "dev";
            default: return "example";
        }
    }
}
