using System;
using Gui;

namespace Gui.Component;

// 统一嵌入式浏览器引擎契约（WebView / CefBrowser / FirefoxBrowser 共享）。
// 宿主可通过 IBrowserView / BrowserBoxBase 在三种引擎间零改动切换。
public interface IBrowserView : IDisposable {
    void Navigate(string target);
    void Back();
    void Forward();
    void Reload();
    void Stop();
    bool CanGoBack();
    bool CanGoForward();
    bool IsLoading();
    int LastStatus();
    string CurrentUrl();
    string CurrentTitle();
    void Hide();
    void Destroy();
    UiEvent NavStartEvent();
    UiEvent NavCompleteEvent();
    UiEvent TitleChangedEvent();
    UiEvent LoadingChangedEvent();
    BrowserNativeEntry AttachNative(App app, Control box);
    void PaintView(App app, int x, int y, int w, int h);
}
