using System;
using System.IO;
using System.IO.Compression;
using System.Json;
using System.Diagnostics;
using System.Management;
using System.Net.Http.Client;
using System.Net.External;
using System.Security.Cryptography;
using System.Net.Http.Download;

namespace Gui.Component.CefBrowser;

public partial class CefRuntime {
    // ---------------------------------------------------------------- 安装

    // 确保本地有可用的 CEF 运行时，返回其目录；失败返回 ""
    // （原因见 <see cref="Error"/>）。已装好时不联网。
    public static async string EnsureAsync() {
        CefRuntime.lastError = "";
        string have = CefRuntime.Installed();
        if (have != "") { return have; }

        string localPath = CefOptions.ArchivePath();
        if (localPath != "") {
            CefArchive local = CefRuntime.ReadLocalArchive(localPath);
            if (local == null) { return ""; }
            string localDir = CefRuntime.RuntimeDir(local.cefVersion);
            if (CefRuntime.IsReady(localDir)) { return localDir; }
            if (!CefRuntime.Install(localPath, localDir, local.cefVersion)) {
                return "";
            }
            return localDir;
        }
        CefArchive a = await CefRuntime.ResolveAsync();
        if (a == null) { return ""; }
        string dir = CefRuntime.RuntimeDir(a.cefVersion);
        if (CefRuntime.IsReady(dir)) { return dir; }

        string archive = CefRuntime.DownloadDir() + "/" + a.fileName;
        bool got = await CefRuntime.DownloadArchiveAsync(a, archive);
        if (!got) { return ""; }
        if (!CefRuntime.Install(archive, dir, a.cefVersion)) { return ""; }
        return dir;
    }

    // ------------------------------------------- 带进度界面的自举（DownloadJob）

    // 准备阶段选中的目标目录与版本：worker 线程上先写、随后同一个线程上的
    // 安装步骤再读（DownloadJob 是单任务语义，见其类注释）。
    public static string pendingDir;
    public static string pendingVersion;

    // 把运行时自举做成一个通用下载任务，好让宿主用
    // <see cref="DownloadDialog"/> 显示进度：
    // <code>
    // job.Start();
    // DownloadDialog.Show(app, "正在准备浏览器运行时", job);
    // // 任务成功后：CefRuntime.EnsuredDir() 就是运行时目录
    // </code>
    // 启动阶段没有主窗口时，<see cref="CefBootstrap.StartAsync"/> 会自动把
    // 同一个任务交给独立的 <see cref="DownloadDialog"/>；宿主也可以自行
    // 组合任务与进度窗。
    // 「下哪个归档」仍然由本类决定（优先查内置表、必要时联网拉索引），
    // 解压/剥顶层目录/打就绪标记也仍然走本类的 <c>Install</c>——任务层只管
    // 传输、校验与进度。已经装好时任务不下载任何东西，直接以“已完成”收工。
    public static DownloadJob NewEnsureJob() {
        DownloadJob job = new DownloadJob();
        job.SetPrepare(CefRuntime.PrepareJob);
        return job;
    }

    // 任务的准备回调（跑在工作线程上）：确定归档并加条目；
    // 本机归档模式直接安装，不产生下载条目。
    public static bool PrepareJob(DownloadJob job) {
        CefRuntime.lastError = "";
        CefRuntime.pendingDir = "";
        CefRuntime.pendingVersion = "";
        if (CefRuntime.Installed() != "") { return true; }
        string localPath = CefOptions.ArchivePath();
        if (localPath != "") {
            CefArchive local = CefRuntime.ReadLocalArchive(localPath);
            if (local == null) { return false; }
            CefRuntime.pendingDir = CefRuntime.RuntimeDir(local.cefVersion);
            CefRuntime.pendingVersion = local.cefVersion;
            if (CefRuntime.IsReady(CefRuntime.pendingDir)) { return true; }
            return CefRuntime.Install(localPath, CefRuntime.pendingDir,
                CefRuntime.pendingVersion);
        }
        CefArchive a = await CefRuntime.ResolveAsync();
        if (a == null) { return false; }
        string dir = CefRuntime.RuntimeDir(a.cefVersion);
        CefRuntime.pendingDir = dir;
        CefRuntime.pendingVersion = a.cefVersion;
        if (CefRuntime.IsReady(dir)) { return true; }
        CefHttpEndpoint endpoint = CefRuntime.Endpoint();
        if (endpoint == null) { return false; }
        ExternalCallPolicy archivePolicy = CefRuntime.ArchivePolicy();
        if (!ExternalTargetPolicy.IsClientAllowed(endpoint.host, endpoint.port,
                endpoint.tls, archivePolicy.AllowsLoopback(),
                archivePolicy.AllowsHttp(), archivePolicy.LocalHttpOnly())) {
            CefRuntime.Fail("CEF 归档地址未通过 HTTPS 外部调用策略："
                + CefRuntime.BaseUrl());
            return false;
        }
        if (a.size <= 0 || a.size > archivePolicy.MaxBodyBytes()) {
            CefRuntime.Fail("CEF 归档大小超出安全预算：" + a.fileName);
            return false;
        }
        Directory.CreateDirectoryRecursive(CefRuntime.DownloadDir());
        string archive = CefRuntime.DownloadDir() + "/" + a.fileName;
        DownloadItem it = DownloadItem.FromUrl(
            CefRuntime.ArchiveUrl(a), archive);
        if (it == null) {
            CefRuntime.Fail("CEF 归档地址异常：" + a.fileName);
            return false;
        }
        job.Add(it.WithSha1(a.sha1).WithSize(a.size).WithName(a.fileName)
            .WithInstaller(CefRuntime.InstallItem));
        return true;
    }

    // 任务的安装步骤（跑在工作线程上）：CEF 的归档要剥掉顶层
    // 目录、要打就绪标记，所以不能用任务层按扩展名的默认解压。
    public static bool InstallItem(DownloadItem it) {
        return CefRuntime.Install(it.LocalPath(), CefRuntime.pendingDir,
            CefRuntime.pendingVersion);
    }

    // <see cref="NewEnsureJob"/> 的任务成功收工后，运行时所在
    // 目录；没装好时 ""。
    public static string EnsuredDir() {
        string have = CefRuntime.Installed();
        if (have != "") { return have; }
        if (CefRuntime.pendingDir == null) { return ""; }
        if (CefRuntime.pendingDir == "") { return ""; }
        if (!CefRuntime.IsReady(CefRuntime.pendingDir)) { return ""; }
        return CefRuntime.pendingDir;
    }

    // 把 DownloadJob 的失败状态翻译成 CEF 自举错误；优先使用
    // 准备阶段写入的 CefRuntime.Error，下载器没有该上下文时回退到
    // DownloadJob.Error。
    public static string EnsureJobError(DownloadJob job) {
        string detail = CefRuntime.Error();
        if (detail == "" && job != null) { detail = job.Error(); }
        if (job != null && job.Stage() == DownloadStage.Cancelled) {
            return "下载已取消";
        }
        if (detail == "") { return "下载任务失败"; }
        if (job != null && job.FailedStage() == DownloadStage.Verify) {
            return detail + CefRuntime.Sha1EscapeHint();
        }
        if (job != null && job.FailedStage() == DownloadStage.Download) {
            return detail + CefRuntime.DownloadEscapeHint();
        }
        return detail;
    }

    // 下载归档（断点续传）并按官方 SHA-1 校验；校验不过会
    // 重下一次。
    public static async bool DownloadArchiveAsync(CefArchive a, string archive) {
        Directory.CreateDirectoryRecursive(CefRuntime.DownloadDir());
        if (File.Exists(archive) && Sha1.VerifyFile(archive, a.sha1)) {
            return true;
        }
        CefHttpEndpoint endpoint = CefRuntime.Endpoint();
        if (endpoint == null) { return false; }
        HttpClient client = endpoint.tls
            ? HttpClient.CreateHttps(endpoint.host, endpoint.port)
            : new HttpClient(endpoint.host, endpoint.port);
        client.SetCallPolicy(CefRuntime.ArchivePolicy());
        client.SetTimeout(120000);
        long lastN = 0 - 1;
        bool transferred = false;
        for (int attempt = 0; attempt < 2; attempt = attempt + 1) {
            lastN = await client.DownloadBinaryToFileAsync(
                CefRuntime.BasePath(a.Path()), archive, archive + ".progress");
            if (lastN > 0) {
                transferred = true;
                if (Sha1.VerifyFile(archive, a.sha1)) { return true; }
            }
            // 半截或损坏：清掉后整包重下。
            if (File.Exists(archive)) { File.Delete(archive); }
        }
        if (lastN <= 0) {
            CefRuntime.Fail("CEF 归档下载失败（传输返回 "
                + Convert.ToString(lastN) + "，检查网络与代理）："
                + CefRuntime.ArchiveUrl(a)
                + "；下载阶段：" + client.LastDownloadError()
                + CefRuntime.DownloadEscapeHint());
        } else if (transferred) {
            CefRuntime.Fail("CEF 归档 SHA-1 校验失败（期望 " + a.sha1
                + "，已重下一次仍不匹配）：" + CefRuntime.ArchiveUrl(a)
                + CefRuntime.Sha1EscapeHint());
        }
        return false;
    }

    // 下载进度（"已收/总计" 字节），未在下载时返回 ""。
    public static string Progress(string fileName) {
        if (fileName == null || fileName == "") { return ""; }
        string p = CefRuntime.DownloadDir() + "/" + fileName + ".progress";
        if (!File.Exists(p)) { return ""; }
        return File.ReadAllText(p).Trim();
    }

    // 解压 .tar.bz2 归档到运行时目录并打上就绪标记：归档里
    // 只有一层 cef_binary_… 顶层目录，会被剥掉。
    public static bool Install(string archive, string dir, string cefVersion) {
        Directory.CreateDirectoryRecursive(CefRuntime.DownloadDir());
        string tar = CefRuntime.DownloadDir() + "/" + Path.GetFileName(archive)
            + ".tar";
        string staging = dir + ".tmp";
        Directory.DeleteRecursive(staging);
        Directory.DeleteRecursive(dir);
        if (!BZip2.DecompressFile(archive, tar)) {
            CefRuntime.Fail("CEF 归档 bzip2 解压失败：" + archive);
            File.Delete(tar);
            return false;
        }
        int n = Tar.ExtractFile(tar, staging);
        File.Delete(tar);
        if (n <= 0) {
            CefRuntime.Fail("CEF 归档 tar 解包失败：" + archive);
            Directory.DeleteRecursive(staging);
            return false;
        }
        string src = staging;
        List<string> subs = Directory.GetDirectories(staging);
        List<string> tops = Directory.GetFiles(staging);
        if (subs.Count == 1 && tops.Count == 0) {
            src = staging + "/" + subs[0];
        }
        Directory.CreateDirectoryRecursive(CefRuntime.ParentDir(dir));
        File.Move(src, dir);
        string res = CefRuntime.ResourcesDir(dir);
        if (!Directory.Exists(res)) {
            CefRuntime.Fail("CEF 归档内容异常：缺少 " + res + "（" + archive
                + "）");
            Directory.DeleteRecursive(staging);
            return false;
        }
        Directory.DeleteRecursive(staging);
        CefRuntime.MarkExecutables(dir);
        CefRuntime.StageResources(dir);
        File.WriteAllText(dir + "/" + CefRuntime.ReadyMarker(), cefVersion);
        return true;
    }

    // 把 Resources/ 的内容复制到 Release/：Chromium 只按 libcef
    // 所在目录找 icudtl.dat，不看 resources_dir_path，所以运行时的资源
    // 必须和二进制同目录（macOS 的 framework 布局自带资源，跳过）。
    public static void StageResources(string dir) {
        #if MACOS
        #else
        string rel = dir + "/Release";
        string res = CefRuntime.ResourcesDir(dir);
        if (!Directory.Exists(rel) || !Directory.Exists(res)) { return; }
        CefRuntime.CopyTree(res, rel);
        #endif
    }

    // 递归复制目录内容（已存在的同名文件会被覆盖）。
    public static void CopyTree(string src, string dst) {
        Directory.CreateDirectoryRecursive(dst);
        List<string> files = Directory.GetFileNames(src);
        for (int i = 0; i < files.Count; i = i + 1) {
            File.Copy(src + "/" + files[i], dst + "/" + files[i]);
        }
        List<string> subs = Directory.GetDirectories(src);
        for (int j = 0; j < subs.Count; j = j + 1) {
            CefRuntime.CopyTree(src + "/" + subs[j], dst + "/" + subs[j]);
        }
    }

    // POSIX 上给 Release/ 下的产物补上可执行位（tar 里的 mode
    // 已经带了，这里只是兜底 helper 进程能起来）。
    public static void MarkExecutables(string dir) {
        #if WINDOWS
        #else
        CefRuntime.MarkExecutablesIn(dir + "/Release");
        // mac 上二进制不在 Release/ 里，而在 framework 内部；其他平台上
        // 这两个目录不存在，helper 直接返回。
        string fw = dir + "/" + CefRuntime.FrameworkSubdir();
        CefRuntime.MarkExecutablesIn(fw);
        CefRuntime.MarkExecutablesIn(fw + "/Libraries");
        #endif
    }

    // 给一个目录里（不递归）看起来是可执行文件/动态库的项补上
    // 可执行位。
    public static void MarkExecutablesIn(string dir) {
        #if WINDOWS
        #else
        if (!Directory.Exists(dir)) { return; }
        List<string> files = Directory.GetFileNames(dir);
        for (int i = 0; i < files.Count; i = i + 1) {
            string name = files[i];
            if (name.EndsWith(".so") || name.EndsWith(".dylib")
                || name.IndexOf(".") < 0 || name.EndsWith("Helper")) {
                File.SetExecutable(dir + "/" + name, true);
            }
        }
        #endif
    }

    // ---------------------------------------------------------- 小工具

    // 把归档文件名转成 URL 路径片段（"+" → "%2B"）。
    public static string UrlEncode(string name) {
        if (name == null) { return ""; }
        if (name.IndexOf("+") < 0 && name.IndexOf(" ") < 0) { return name; }
        return name.Replace("+", "%2B").Replace(" ", "%20");
    }

    // 把版本串里不适合做目录名的字符换成 "-"。
    public static string SafeVersion(string v) {
        if (v == null) { return ""; }
        int len = v.Length;
        bool hasBad = false;
        for (int i = 0; i < len; i = i + 1) {
            int c = v[i] & 255;
            bool ok = (c >= 48 && c <= 57) || (c >= 97 && c <= 122)
                || (c >= 65 && c <= 90) || c == 46 || c == 45 || c == 95;
            if (!ok) { hasBad = true; break; }
        }
        if (!hasBad) { return v; }
        StringBuilder sb = new StringBuilder();
        int start = 0;
        for (int i = 0; i < len; i = i + 1) {
            int c = v[i] & 255;
            bool ok = (c >= 48 && c <= 57) || (c >= 97 && c <= 122)
                || (c >= 65 && c <= 90) || c == 46 || c == 45 || c == 95;
            if (!ok) {
                if (i > start) {
                    sb.Append(v.Substring(start, i - start));
                }
                sb.Append("-");
                start = i + 1;
            }
        }
        if (start < len) {
            sb.Append(v.Substring(start, len - start));
        }
        return sb.ToString();
    }

    // 比较两个目录名里的版本，a 是否比 b 新（按点分数字段）。
    public static bool VersionNewer(string a, string b) {
        if (a == null || a == "") { return false; }
        if (b == null || b == "") { return true; }
        int ia = 0;
        int ib = 0;
        while (ia < a.Length || ib < b.Length) {
            int na = 0 - 1;
            int nb = 0 - 1;
            int ja = ia;
            while (ja < a.Length && (a[ja] & 255) >= 48 && (a[ja] & 255) <= 57) {
                if (na < 0) { na = 0; }
                int da = (a[ja] & 255) - 48;
                if (na > 214748364 || (na == 214748364 && da > 7)) { na = 2147483647; }
                else { na = na * 10 + da; }
                ja = ja + 1;
            }
            int jb = ib;
            while (jb < b.Length && (b[jb] & 255) >= 48 && (b[jb] & 255) <= 57) {
                if (nb < 0) { nb = 0; }
                int db = (b[jb] & 255) - 48;
                if (nb > 214748364 || (nb == 214748364 && db > 7)) { nb = 2147483647; }
                else { nb = nb * 10 + db; }
                jb = jb + 1;
            }
            if (na != nb) { return na > nb; }
            if (na < 0) { return false; }
            ia = ja + 1;
            ib = jb + 1;
            if (ia > a.Length) { ia = a.Length; }
            if (ib > b.Length) { ib = b.Length; }
            if (ja >= a.Length && jb >= b.Length) { return false; }
        }
        return false;
    }

    // 取前导十进制数字组成的整数；一个数字都没有返回 -1。
    public static int ParseInt(string s) {
        if (s == null) { return 0 - 1; }
        int v = 0;
        bool any = false;
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { break; }
            int d = c - 48;
            if (v > 214748364 || (v == 214748364 && d > 7)) { return 2147483647; }
            v = v * 10 + d;
            any = true;
        }
        if (!any) { return 0 - 1; }
        return v;
    }

    // 反斜杠归一为正斜杠并去掉尾部斜杠（根 "/" 保留）。
    public static string Slashes(string p) {
        if (p == null) { return ""; }
        string s = p;
        if (s.IndexOf("\\") >= 0) {
            s = s.Replace("\\", "/");
        }
        while (s.Length > 1 && s.EndsWith("/")) {
            s = s.Substring(0, s.Length - 1);
        }
        return s;
    }

    // 路径的父目录（最后一个分隔符之前的部分）；没有分隔符或
    // 分隔符在首位时返回 "."。
    public static string ParentDir(string path) {
        if (path == null || path == "") { return "."; }
        int cut = 0 - 1;
        for (int i = 0; i < path.Length; i = i + 1) {
            int c = path[i] & 255;
            if (c == 47 || c == 92) { cut = i; }
        }
        if (cut <= 0) { return "."; }
        return path.Substring(0, cut);
    }

    // from 之前最近的一个 '{'。
    public static int PrevBrace(string s, int from) {
        if (s == null || s.Length == 0 || from < 0) { return 0 - 1; }
        if (from >= s.Length) { from = s.Length - 1; }
        for (int i = from; i >= 0; i = i - 1) {
            int c = s[i] & 255;
            if (c == 123) { return i; }
            if (c == 125 || c == 91 || c == 93) { return 0 - 1; }
        }
        return 0 - 1;
    }

    // 与 open 处 '{' 配对的 '}'，考虑字符串字面量与转义。
    public static int MatchBrace(string s, int open) {
        if (s == null || open < 0 || open >= s.Length) { return 0 - 1; }
        int depth = 0;
        bool inStr = false;
        bool esc = false;
        for (int i = open; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (inStr) {
                if (esc) { esc = false; }
                else if (c == 92) { esc = true; }
                else if (c == 34) { inStr = false; }
                continue;
            }
            if (c == 34) { inStr = true; }
            else if (c == 123) { depth = depth + 1; }
            else if (c == 125) {
                depth = depth - 1;
                if (depth == 0) { return i; }
            }
        }
        return 0 - 1;
    }
}
