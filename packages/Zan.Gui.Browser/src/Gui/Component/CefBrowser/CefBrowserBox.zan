using System;
using Gui;
using Gui.Component;

namespace Gui.Component.CefBrowser;

// 可摆放的 Chromium (CEF) 浏览器控件（继承三引擎共享外壳 BrowserBoxBase）。
public class CefBrowserBox : BrowserBoxBase {
    public override Control CreateCloneShell() { return new CefBrowserBox(); }
    public CefBrowser view;

    public CefBrowserBox() {
        this.InitBrowserBox("cefbrowser");
        this.view = new CefBrowser();
    }

    public override IBrowserView BrowserView() { return this.view; }
    public CefBrowser View() { return this.view; }
    public override string Kind() { return "CefBrowserBox"; }
}
