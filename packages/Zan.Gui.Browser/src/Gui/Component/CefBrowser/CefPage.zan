using System.Json;
using System;

namespace Gui.Component.CefBrowser;

// 页面级常用钩子：下载、JS 对话框、console 输出。都建在
// <see cref="CefCdp"/> 上（这些能力 CDP 全都有，不需要再加原生 handler），
// 所以任何 CDP 域/事件都能用 <see cref="CefCdp.On"/> 自己接，这里只是把最常
// 用的三件事收成一行调用。
// <code>
// 核心契约与语义定义。
// page.AutoDismissDialogs(true);   // alert/confirm 一律确定，避免页面卡住
// 核心契约与语义定义。
// </code>
class CefPage {
    CefCdp cdp;
    bool pageOn;
    bool dialogAccept;
    bool dialogAuto;

    CefPage(CefCdp channel) {
        cdp = channel;
        pageOn = false;
        dialogAccept = true;
        dialogAuto = false;
    }

    // Page 域的事件要先 enable。
    void EnsurePage() {
        if (pageOn) { return; }
        cdp.Enable("Page");
        pageOn = true;
    }

    // ---- 下载 -------------------------------------------------------------

    // 允许下载并落到 <paramref name="dir"/>；
    // <paramref name="onEvent"/> 非空时同时订阅
    // `Browser.downloadWillBegin` / `Browser.downloadProgress`（带
    // guid/url/文件名/进度/状态）。默认 Chromium 在无 UI 的嵌入场景里是拒绝
    // 下载的，所以不调这个就不会有文件落盘。
    void AllowDownloads(string dir, CdpEventFn onEvent) {
        if (onEvent != null) {
            cdp.On("Browser.downloadWillBegin", onEvent);
            cdp.On("Browser.downloadProgress", onEvent);
        }
        JsonValue p = JsonValue.NewObject();
        p.PutStr("behavior", "allow");
        p.PutStr("downloadPath", dir);
        p.PutBool("eventsEnabled", true);
        cdp.Send("Browser.setDownloadBehavior", p.ToJson(), null);
    }

    // 拒绝一切下载。
    void DenyDownloads() {
        JsonValue p = JsonValue.NewObject();
        p.PutStr("behavior", "deny");
        cdp.Send("Browser.setDownloadBehavior", p.ToJson(), null);
    }

    // 取消一个正在进行的下载（guid 来自下载事件）。
    void CancelDownload(string guid) {
        JsonValue p = JsonValue.NewObject();
        p.PutStr("guid", guid);
        cdp.Send("Browser.cancelDownload", p.ToJson(), null);
    }

    // ---- JS 对话框 --------------------------------------------------------

    // 自动应答 alert/confirm/prompt/beforeunload：
    // <paramref name="accept"/> 为 true 时点「确定」，否则「取消」。
    // 嵌入式浏览器里这些对话框默认没人应答，页面会一直停在那儿。
    void AutoDismissDialogs(bool accept) {
        dialogAccept = accept;
        EnsurePage();
        if (dialogAuto) { return; }
        dialogAuto = true;
        cdp.On("Page.javascriptDialogOpening", (json) => {
            cdp.Send("Page.handleJavaScriptDialog",
                     dialogAccept ? "{\"accept\":true}" : "{\"accept\":false}",
                     null);
        });
    }

    // 自己应答一个打开着的对话框（配合
    // <see cref="CefCdp.On"/> 订阅 `Page.javascriptDialogOpening` 时用）；
    // <paramref name="promptText"/> 只对 prompt 有意义。
    void AnswerDialog(bool accept, string promptText) {
        JsonValue p = JsonValue.NewObject();
        p.PutBool("accept", accept);
        if (promptText != "") { p.PutStr("promptText", promptText); }
        cdp.Send("Page.handleJavaScriptDialog", p.ToJson(), null);
    }

    // ---- console / 页面日志 ----------------------------------------------

    // 订阅页面 console：`Runtime.consoleAPICalled`（console.log 一族）
    // 与 `Log.entryAdded`（浏览器自己的告警，如 CSP、404）。
    void OnConsole(CdpEventFn onEvent) {
        cdp.On("Runtime.consoleAPICalled", onEvent);
        cdp.On("Log.entryAdded", onEvent);
        cdp.Enable("Runtime");
        cdp.Enable("Log");
    }

    // 订阅未捕获异常（`Runtime.exceptionThrown`）。
    void OnException(CdpEventFn onEvent) {
        cdp.On("Runtime.exceptionThrown", onEvent);
        cdp.Enable("Runtime");
    }

    // ---- 网络 -------------------------------------------------------------

    // 订阅请求/响应（`Network.requestWillBeSent`、
    // `Network.responseReceived`、`Network.loadingFailed`）。要改写或拦截请求
    // 得用 Fetch 域，自己 <see cref="CefCdp.On"/> + `Fetch.continueRequest`。
    void OnNetwork(CdpEventFn onEvent) {
        cdp.On("Network.requestWillBeSent", onEvent);
        cdp.On("Network.responseReceived", onEvent);
        cdp.On("Network.loadingFailed", onEvent);
        cdp.Enable("Network");
    }

    // 覆盖 User-Agent（空串还原）。
    void SetUserAgent(string ua) {
        cdp.Enable("Network");
        JsonValue p = JsonValue.NewObject();
        p.PutStr("userAgent", ua);
        cdp.Send("Network.setUserAgentOverride", p.ToJson(), null);
    }

    // 附加 HTTP 头（JSON 对象，如
    // `{"X-Token":"abc"}`）；`{}` 清空。
    void SetExtraHeaders(string headersJson) {
        cdp.Enable("Network");
        JsonValue p = JsonValue.NewObject();
        p.PutJson("headers", headersJson);
        cdp.Send("Network.setExtraHTTPHeaders", p.ToJson(), null);
    }
}
