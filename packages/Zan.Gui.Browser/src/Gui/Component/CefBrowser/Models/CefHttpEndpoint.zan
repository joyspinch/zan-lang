using System;
using System.IO;
using System.IO.Compression;
using System.Json;
using System.Diagnostics;
using System.Management;
using System.Net.Http.Client;
using System.Net.External;
using System.Security.Cryptography;
using System.Net.Http.Download;

namespace Gui.Component.CefBrowser;

// 镜像基址解析结果。
public class CefHttpEndpoint {
    public string host;
    public int port;
    public bool tls;
    public string prefix;

    // 全空端点。
    public CefHttpEndpoint() {
        this.host = "";
        this.port = 0;
        this.tls = false;
        this.prefix = "";
    }
}
