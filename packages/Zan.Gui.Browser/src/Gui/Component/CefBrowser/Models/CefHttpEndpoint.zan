using System;
using System.IO;
using System.IO.Compression;
using System.Json;
using System.Diagnostics;
using System.Management;
using System.Net.Http.Client;
using System.Net.External;
using System.Security.Cryptography;
using System.Net.Http.Download;

namespace Gui.Component.CefBrowser;

// 镜像基址解析结果。
class CefHttpEndpoint {
    string host;
    int port;
    bool tls;
    string prefix;

    // 全空端点。
    CefHttpEndpoint() {
        this.host = "";
        this.port = 0;
        this.tls = false;
        this.prefix = "";
    }
}
