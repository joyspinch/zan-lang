using System;
using System.IO;
using System.IO.Compression;
using System.Json;
using System.Diagnostics;
using System.Management;
using System.Net.Http.Client;
using System.Net.External;
using System.Security.Cryptography;
using System.Net.Http.Download;

namespace Gui.Component.CefBrowser;

// CEF 官方构建索引里的一个归档条目。
public class CefArchive {
    // 完整 CEF 版本，如
    // "109.1.18+gf1c41e4+chromium-109.0.5414.120"。
    public string cefVersion;
    // 对应的 Chromium 版本。
    public string chromiumVersion;
    // 官方平台标识，如 "windows64"。
    public string platform;
    // 归档文件名（.tar.bz2）。
    public string fileName;
    // 官方给出的 SHA-1（小写十六进制）。
    public string sha1;
    // 归档字节数。
    public long size;

    // 全空的归档条目。
    public CefArchive() {
        this.cefVersion = "";
        this.chromiumVersion = "";
        this.platform = "";
        this.fileName = "";
        this.sha1 = "";
        this.size = 0;
    }

    // 该归档的请求路径（"+" 已按 URL 规则转义）。
    public string Path() {
        return "/" + CefRuntime.UrlEncode(this.fileName);
    }
}
