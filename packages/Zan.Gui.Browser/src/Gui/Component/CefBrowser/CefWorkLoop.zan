using Gui;

namespace Gui.Component.CefBrowser;

// Root-owned turn state survives individual BrowserNativeLoop retirement without
// a process-static collection retaining Apps or leaving ARC allocations at exit.
public class CefWorkLoop : AppLoopParticipant, AppLoopService {
    public weak App Root;
    int lastWorkTurn;

    public string ServiceKey() { return "Gui.Component.CefBrowser.CefWorkLoop"; }
    public int NextDeadline() { return -1; }
    public void Tick(App app, int now) { }

    public static CefWorkLoop For(App root) {
        AppLoopParticipant existing = root.FindLoopService("Gui.Component.CefBrowser.CefWorkLoop");
        if (existing is CefWorkLoop) { return (CefWorkLoop)existing; }
        CefWorkLoop loop = new CefWorkLoop();
        loop.Root = root;
        root.RegisterLoopParticipant(root, loop);
        return loop;
    }

    public bool TryEnter(int turn) {
        // Compatibility/close work outside a turn must not erase a live turn's
        // claim: a reentrant Stopped callback may pump between sibling services.
        if (turn == 0) { return true; }
        if (lastWorkTurn == turn) { return false; }
        lastWorkTurn = turn;
        return true;
    }
}
