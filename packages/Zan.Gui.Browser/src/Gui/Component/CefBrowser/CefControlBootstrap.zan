using Gui;
using Gui.Component.CefBrowser;

namespace Gui.Component.CefBrowser;

// CEF 家族的 HeavyControls 注册入口。IDE、浏览器示例等真正用到
// CefBrowserBox 的宿主在启动时调用一次 <see cref="Install"/>（放在
// Main 最前，与 CefBootstrap.RunHelper 同一位置约定）；不调用的程序
// 里整个 CEF 家族被 globaldce 删光，发布不再携带 zan_cef/zan_cef109
// DLL（bundle 的 "if CefBackend_" 前缀条件不再命中）。
class CefControlBootstrap {
    static bool installed;

    static void Install() {
        if (installed) { return; }
        installed = true;
        HeavyControls.Register("CefBrowserBox", MakeCefBrowserBox);
    }

    static Control MakeCefBrowserBox(string kind) {
        if (kind == "CefBrowserBox") { return new CefBrowserBox(); }
        return null;
    }
}
