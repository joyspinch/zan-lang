using System.Json;
using System;

namespace Gui.Component.CefBrowser;

// Cookie 读写，走 CDP（<see cref="CefCdp"/>）。回复是异步到达的，所以每个
// 查询都带一个回调：
// <code>
// CefCookies ck = web.Cookies();
// 核心契约与语义定义。
// </code>
// 值都是 CDP 的原始 JSON（Network.Cookie 结构），因为 Cookie 的字段还在随
// Chromium 演进（SameParty、partitionKey…），包一层强类型只会挡住新字段。
// Cookie 存在 profile 目录里（<see cref="CefOptions.profileDir"/>），
// 由 Chromium 自己落盘，不需要显式 flush。
class CefCookies {
    CefCdp cdp;
    bool networkOn;

    CefCookies(CefCdp channel) {
        cdp = channel;
        networkOn = false;
    }

    // Network 域的 Cookie 命令要先 enable。
    void EnsureNetwork() {
        if (networkOn) { return; }
        cdp.Enable("Network");
        networkOn = true;
    }

    // 全部 Cookie（浏览器级）。回调收到
    // 核心契约与语义定义。
    int GetAll(CdpEventFn onResult) {
        return cdp.Send("Storage.getCookies", "{}", onResult);
    }

    // 某些 URL 下可见的 Cookie；<paramref name="urls"/> 为空表示当前
    // 页面。
    int GetForUrl(string url, CdpEventFn onResult) {
        EnsureNetwork();
        string p = "{}";
        if (url != "") {
            JsonValue q = JsonValue.NewObject();
            JsonValue urls = JsonValue.NewArray();
            urls.AppendStr(url);
            q.Put("urls", urls);
            p = q.ToJson();
        }
        return cdp.Send("Network.getCookies", p, onResult);
    }

    // 按 domain/path 写一个 Cookie（会话 Cookie：不带 expires）。
    int Set(string name, string value, string domain, string path,
            bool secure) {
        return SetJson(CefCookies.Param(name, value, domain, path, secure,
                                        "", 0 - 1));
    }

    // 按 domain/path 写一个持久 Cookie，
    // <paramref name="expiresUnixSeconds"/> 是绝对过期时间（UNIX 秒）。
    int SetPersistent(string name, string value, string domain, string path,
                      bool secure, long expiresUnixSeconds) {
        return SetJson(CefCookies.Param(name, value, domain, path, secure, "",
                                        expiresUnixSeconds));
    }

    // 按 URL 写一个 Cookie（domain/path 由 URL 推出）。
    int SetForUrl(string url, string name, string value) {
        return SetJson(CefCookies.Param(name, value, "", "", false, url,
                                        0 - 1));
    }

    // 写一个自己拼的 Network.CookieParam JSON（要用上 Chromium 的新
    // 字段时）。
    int SetJson(string cookieParamJson) {
        JsonValue cookies = JsonValue.NewArray();
        cookies.AppendJson(cookieParamJson);
        JsonValue p = JsonValue.NewObject();
        p.Put("cookies", cookies);
        return cdp.Send("Storage.setCookies", p.ToJson(), null);
    }

    // 删除匹配 name + domain 的 Cookie。
    int Delete(string name, string domain) {
        EnsureNetwork();
        JsonValue p = JsonValue.NewObject();
        p.PutStr("name", name);
        p.PutStr("domain", domain);
        return cdp.Send("Network.deleteCookies", p.ToJson(), null);
    }

    // 删除某个 URL 下匹配 name 的 Cookie。
    int DeleteForUrl(string name, string url) {
        EnsureNetwork();
        JsonValue p = JsonValue.NewObject();
        p.PutStr("name", name);
        p.PutStr("url", url);
        return cdp.Send("Network.deleteCookies", p.ToJson(), null);
    }

    // 清空全部 Cookie。
    int Clear() {
        return cdp.Send("Storage.clearCookies", "{}", null);
    }

    // 拼一条 Network.CookieParam。url 非空时用 url 形式，否则
    // domain/path；expires &lt; 0 表示会话 Cookie。树构建产出，转义交给
    // ToJson。
    static string Param(string name, string value, string domain, string path,
                        bool secure, string url, long expires) {
        JsonValue p = JsonValue.NewObject();
        p.PutStr("name", name);
        p.PutStr("value", value);
        if (url != "") { p.PutStr("url", url); }
        if (domain != "") { p.PutStr("domain", domain); }
        if (path != "") { p.PutStr("path", path); }
        if (secure) { p.PutBool("secure", true); }
        if (expires >= 0) { p.PutInt("expires", expires); }
        return p.ToJson();
    }
}
