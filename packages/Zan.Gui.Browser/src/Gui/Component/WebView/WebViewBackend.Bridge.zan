using System;
using System.Diagnostics;

namespace Gui.Component.WebView;

public partial class WebViewBackend {
    // ------------------------------------------------ JS ↔ 原生（可选能力）
    // 这些入口是后加的：交叉链接只能解析仓库里那份已提交的
    // libzan_gui.dylib（由 Mac 上的 CI 构建）的导出表，直接 DllImport
    // 新符号会让 --publish macos-* 链接失败。所以按 Interop.Symbol 的
    // 既有用法在运行时探测——旧运行时上表现为「不支持」，而不是启动即崩。

    #if MACOS || ANDROID
    public static nint guiMod = 0;
    public static bool guiTried = false;
    public static nint addr_addHandler = 0;
    public static nint addr_removeHandler = 0;
    public static nint addr_takeMessage = 0;
    public static nint addr_msgPending = 0;
    public static nint addr_msgDropped = 0;
    public static nint addr_addScript = 0;
    public static nint addr_addStyle = 0;
    public static nint addr_removeScripts = 0;
    public static nint addr_evalAsync = 0;
    public static nint addr_clearData = 0;
    public static nint addr_setClip = 0;
    public static nint addr_setZoom = 0;

    // 解析 zan_gui 里可选的 WKWebView 桥接入口。zan_gui 已被主程序加载，
    // dlopen 只是拿到同一个镜像的句柄：先按可执行文件同目录找（发布包把
    // dylib 放在 exe 旁边），再交给加载器按名字找。Android 上同一组入口
    // 由 libzan_gui.so 提供（系统 WebView 后端，gui_runtime_android.c）。
    public static void ResolveBridge() {
        if (WebViewBackend.guiTried) { return; }
        WebViewBackend.guiTried = true;
        string dir = ProcessHost.AppDir();
        #if ANDROID
        string libName = "/libzan_gui.so";
        #else
        string libName = "/libzan_gui.dylib";
        #endif
        if (dir != "") {
            WebViewBackend.guiMod = Interop.Load(dir + libName);
        }
        #if ANDROID
        if (WebViewBackend.guiMod == 0) {
            WebViewBackend.guiMod = Interop.Load("libzan_gui.so");
        }
        #else
        if (WebViewBackend.guiMod == 0) {
            WebViewBackend.guiMod = Interop.Load("libzan_gui.dylib");
        }
        #endif
        #if !WINDOWS
        if (WebViewBackend.guiMod == 0) {
            WebViewBackend.guiMod = Interop.PosixLoad(null, Interop.RtldNowLocal());
        }
        #endif
        nint m = WebViewBackend.guiMod;
        if (m == 0) { return; }
        WebViewBackend.addr_addHandler =
            Interop.Symbol(m, "zan_gui_webview_add_handler");
        WebViewBackend.addr_removeHandler =
            Interop.Symbol(m, "zan_gui_webview_remove_handler");
        WebViewBackend.addr_takeMessage =
            Interop.Symbol(m, "zan_gui_webview_take_message");
        WebViewBackend.addr_msgPending =
            Interop.Symbol(m, "zan_gui_webview_msg_pending");
        WebViewBackend.addr_msgDropped =
            Interop.Symbol(m, "zan_gui_webview_msg_dropped");
        WebViewBackend.addr_addScript =
            Interop.Symbol(m, "zan_gui_webview_add_script");
        WebViewBackend.addr_addStyle =
            Interop.Symbol(m, "zan_gui_webview_add_style");
        WebViewBackend.addr_removeScripts =
            Interop.Symbol(m, "zan_gui_webview_remove_scripts");
        WebViewBackend.addr_evalAsync =
            Interop.Symbol(m, "zan_gui_webview_eval_async");
        WebViewBackend.addr_clearData =
            Interop.Symbol(m, "zan_gui_webview_clear_data");
        WebViewBackend.addr_setClip =
            Interop.Symbol(m, "zan_gui_webview_set_clip");
        WebViewBackend.addr_setZoom =
            Interop.Symbol(m, "zan_gui_webview_set_zoom");
    }
    #endif

    // 当前平台/运行时是否支持 JS→native 的消息桥。Windows 走
    // WebView2 的 WebMessageReceived（shim 对齐 window.webkit 语义）；
    // macOS/Android 由 zan_gui 运行时提供桥接入口时为 true。
    public static bool HasBridge() {
        #if WINDOWS
        return true;
        #elif MACOS || ANDROID
        WebViewBackend.ResolveBridge();
        return WebViewBackend.addr_addHandler != 0
            && WebViewBackend.addr_takeMessage != 0;
        #else
        return false;
        #endif
    }

    // 注册 window.webkit.messageHandlers.<name> 消息通道；
    // 页面 postMessage 的内容随后用 TakeMessage 逐条取。运行时
    // 不支持时返回 false。
    public static bool AddHandler(int h, string handlerName) {
        #if WINDOWS
        WebView2 w = WebView2.Get(h);
        return w != null && w.AddHandler(handlerName);
        #elif MACOS || ANDROID
        WebViewBackend.ResolveBridge();
        if (WebViewBackend.addr_addHandler == 0) { return false; }
        WvNameFn f = (WvNameFn)WebViewBackend.addr_addHandler;
        return f(h, handlerName) != 0;
        #else
        return false;
        #endif
    }

    // 撤掉 AddHandler 注册的消息通道；不支持时为空操作。
    public static void RemoveHandler(int h, string handlerName) {
        #if WINDOWS
        WebView2 w = WebView2.Get(h);
        if (w != null) { w.RemoveHandler(handlerName); }
        #elif MACOS || ANDROID
        WebViewBackend.ResolveBridge();
        if (WebViewBackend.addr_removeHandler == 0) { return; }
        WvNameVoidFn f = (WvNameVoidFn)WebViewBackend.addr_removeHandler;
        f(h, handlerName);
        #endif
    }

    // 队列里最早的一条消息，格式 "<handler>\t<body>"；空队列为 ""。
    public static string TakeMessage(int h) {
        #if WINDOWS
        WebView2 w = WebView2.Get(h);
        return w == null ? "" : w.TakeMessage();
        #elif MACOS || ANDROID
        WebViewBackend.ResolveBridge();
        if (WebViewBackend.addr_takeMessage == 0) { return ""; }
        WvStrIntFn f = (WvStrIntFn)WebViewBackend.addr_takeMessage;
        return f(h);
        #else
        return "";
        #endif
    }

    // 消息队列里还没取走的条数（不支持为 0）。
    public static int PendingMessages(int h) {
        #if WINDOWS
        WebView2 w = WebView2.Get(h);
        return w == null ? 0 : w.PendingMessages();
        #elif MACOS || ANDROID
        WebViewBackend.ResolveBridge();
        if (WebViewBackend.addr_msgPending == 0) { return 0; }
        WvIntIntFn f = (WvIntIntFn)WebViewBackend.addr_msgPending;
        return f(h);
        #else
        return 0;
        #endif
    }

    // 因队列满而被丢掉的消息数（宿主没及时取走）。
    public static int DroppedMessages(int h) {
        #if WINDOWS
        WebView2 w = WebView2.Get(h);
        return w == null ? 0 : w.DroppedMessages();
        #elif MACOS || ANDROID
        WebViewBackend.ResolveBridge();
        if (WebViewBackend.addr_msgDropped == 0) { return 0; }
        WvIntIntFn f = (WvIntIntFn)WebViewBackend.addr_msgDropped;
        return f(h);
        #else
        return 0;
        #endif
    }

    // 每页可注入脚本：每次导航都重新执行；atEnd=true 在
    // 文档解析完后跑（DOM 就绪），false 在文档开始前跑。注册失败
    // （含运行时不支持）返回 false。
    public static bool AddScript(int h, string js, bool atEnd) {
        #if WINDOWS
        WebView2 w = WebView2.Get(h);
        return w != null && w.InjectScript(js, atEnd);
        #elif MACOS || ANDROID
        WebViewBackend.ResolveBridge();
        if (WebViewBackend.addr_addScript == 0) { return false; }
        WvScriptFn f = (WvScriptFn)WebViewBackend.addr_addScript;
        int at = 0;
        if (atEnd) { at = 1; }
        return f(h, js, at) != 0;
        #else
        return false;
        #endif
    }

    // 为当前页注入一段 CSS（每次导航后仍生效）；注册失败（含运行时
    // 不支持）返回 false。
    public static bool AddStyle(int h, string css) {
        #if WINDOWS
        WebView2 w = WebView2.Get(h);
        return w != null && w.InjectStyle(css);
        #elif MACOS || ANDROID
        WebViewBackend.ResolveBridge();
        if (WebViewBackend.addr_addStyle == 0) { return false; }
        WvNameFn f = (WvNameFn)WebViewBackend.addr_addStyle;
        return f(h, css) != 0;
        #else
        return false;
        #endif
    }

    // 撤掉全部注入脚本与样式；不支持时为空操作。
    public static void RemoveScripts(int h) {
        #if WINDOWS
        WebView2 w = WebView2.Get(h);
        if (w != null) { w.ClearScripts(); }
        #elif MACOS || ANDROID
        WebViewBackend.ResolveBridge();
        if (WebViewBackend.addr_removeScripts == 0) { return; }
        WvVoidIntFn f = (WvVoidIntFn)WebViewBackend.addr_removeScripts;
        f(h);
        #endif
    }

    // 不等待结果的 Native→JS 调用（Eval 会泵消息等
    // 返回值，从绘制/事件回调里调不合适）；运行时没有这个入口时
    // 退回同步 Eval。
    public static void EvalAsync(int h, string js) {
        #if WINDOWS
        WebView2 w = WebView2.Get(h);
        if (w != null) { w.EvalAsync(js); return; }
        #elif MACOS || ANDROID
        WebViewBackend.ResolveBridge();
        if (WebViewBackend.addr_evalAsync != 0) {
            WvNameVoidFn f = (WvNameVoidFn)WebViewBackend.addr_evalAsync;
            f(h, js);
            return;
        }
        #endif
        string ignored = WebViewBackend.Eval(h, js);
    }

    // 清掉该视图数据仓的全部网站数据（Cookie、缓存、
    // localStorage…）。Windows 上运行时带 Profile2 接口时走
    // ClearBrowsingData(ALL_SITE)，否则退化为只清 Cookie；macOS/Android
    // 运行时不支持时同样退化。
    public static void ClearData(int h) {
        #if WINDOWS
        WebView2 w = WebView2.Get(h);
        if (w != null && w.ClearBrowsingData()) { return; }
        #elif MACOS || ANDROID
        WebViewBackend.ResolveBridge();
        if (WebViewBackend.addr_clearData != 0) {
            WvVoidIntFn f = (WvVoidIntFn)WebViewBackend.addr_clearData;
            f(h);
            return;
        }
        #endif
        WebViewBackend.ClearCookies(h);
    }

    // 整页缩放，percent 为百分数（100 = 原大）。macOS/Android
    // 需运行时带 set_zoom 入口（旧库没有时为空操作）。
    public static void SetZoom(int h, int percent) {
        #if WINDOWS
        WebView2 w = WebView2.Get(h);
        if (w != null) { w.SetZoom(percent); }
        #elif MACOS || ANDROID
        WebViewBackend.ResolveBridge();
        if (WebViewBackend.addr_setZoom == 0) { return; }
        WvZoomIntFn f = (WvZoomIntFn)WebViewBackend.addr_setZoom;
        f(h, percent);
        #endif
    }

    // 为当前页打开 DevTools。Windows 直接开窗口；macOS 由
    // 创建时的 developerExtrasEnabled 支持右键检查，无程序化入口，
    // 因而为空操作。
    public static void OpenDevTools(int h) {
        #if WINDOWS
        WebView2 w = WebView2.Get(h);
        if (w != null) { w.OpenDevTools(); }
        #endif
    }

    // 设置是否允许开发者工具（F12、快捷键及检查元素）。
    // Windows 走 ICoreWebView2Settings，macOS/Android 走原生桥接设置。
    public static void SetDevToolsEnabled(int h, bool enabled) {
        #if WINDOWS
        WebView2 w = WebView2.Get(h);
        if (w != null) { w.SetDevToolsEnabled(enabled); }
        #elif MACOS || ANDROID
        zan_gui_webview_set_devtools_enabled(h, enabled ? 1 : 0);
        #endif
    }

    // 设置是否允许默认右键上下文菜单。
    // Windows 走 ICoreWebView2Settings，macOS/Android 走原生桥接设置。
    public static void SetContextMenuEnabled(int h, bool enabled) {
        #if WINDOWS
        WebView2 w = WebView2.Get(h);
        if (w != null) { w.SetContextMenuEnabled(enabled); }
        #elif MACOS || ANDROID
        zan_gui_webview_set_context_menu_enabled(h, enabled ? 1 : 0);
        #endif
    }

    // 取走上一帧记下的新窗口就地加载目标（无则为 ""）。每帧
    // 由 Render 轮询：window.open/target=_blank 被接管后在下一帧落到
    // 本视图导航，避免在事件回调内重入导航。
    public static string DrainWindowNav(int h) {
        #if WINDOWS
        WebView2 w = WebView2.Get(h);
        return w == null ? "" : w.DrainWindowNav();
        #elif MACOS || ANDROID
        return "";
        #else
        return "";
        #endif
    }

    // 设置底层原生网络响应监听器（URL、HTTP状态码、正文字符串）。
    public static void SetResourceResponseHandler(int h, Action<string, int, string> handler) {
        #if WINDOWS
        WebView2 w = WebView2.Get(h);
        if (w != null) {
            w.onResourceResponse = handler;
        }
        #endif
    }
}

public delegate int WvNameFn(int h, string name);
public delegate void WvNameVoidFn(int h, string name);
public delegate string WvStrIntFn(int h);
public delegate int WvIntIntFn(int h);
public delegate void WvVoidIntFn(int h);
public delegate int WvScriptFn(int h, string js, int atEnd);
public delegate void WvZoomIntFn(int h, int percent);
