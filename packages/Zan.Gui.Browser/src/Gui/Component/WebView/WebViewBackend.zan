using System;
using System.Diagnostics;

namespace Gui.Component.WebView;

// WebView 控件驱动的扁平句柄 API，映射到平台
// 所拥有的任何引擎上。
// Windows 上的引擎是 Edge WebView2，在 Zan（WebView2.zan）中
// 直接针对其 COM 接口实现——无需原生垫片。macOS 上由 zan_gui
// 运行时提供 WKWebView；Android 上同一组 zan_gui_webview_*
// 入口由 libzan_gui.so 提供，落在系统 android.webkit.WebView
// 上（gui_runtime_android.c + APK shell 里的 ZanWeb Java 桥）。
// 没有可嵌入引擎的平台走
// 下面的回退路径：Create 返回 0，控件绘制自己的
// 占位符，因此完全不引用任何原生符号。
public partial class WebViewBackend {
    #if MACOS || ANDROID
    [DllImport("zan_gui")]
    public static extern int zan_gui_webview_create(nint hwnd, string profileId);
    [DllImport("zan_gui")]
    public static extern void zan_gui_webview_destroy(int h);
    [DllImport("zan_gui")]
    public static extern void zan_gui_webview_set_frame(int h, int x, int y, int w, int hh);
    [DllImport("zan_gui")]
    public static extern void zan_gui_webview_set_visible(int h, int visible);
    [DllImport("zan_gui")]
    public static extern void zan_gui_webview_navigate(int h, string url);
    [DllImport("zan_gui")]
    public static extern void zan_gui_webview_load_html(int h, string html, string baseUrl);
    [DllImport("zan_gui")]
    public static extern void zan_gui_webview_back(int h);
    [DllImport("zan_gui")]
    public static extern void zan_gui_webview_forward(int h);
    [DllImport("zan_gui")]
    public static extern void zan_gui_webview_reload(int h);
    [DllImport("zan_gui")]
    public static extern void zan_gui_webview_stop(int h);
    [DllImport("zan_gui")]
    public static extern int zan_gui_webview_can_go_back(int h);
    [DllImport("zan_gui")]
    public static extern int zan_gui_webview_can_go_forward(int h);
    [DllImport("zan_gui")]
    public static extern int zan_gui_webview_is_loading(int h);
    [DllImport("zan_gui")]
    public static extern int zan_gui_webview_nav_seq(int h);
    [DllImport("zan_gui")]
    public static extern int zan_gui_webview_last_status(int h);
    [DllImport("zan_gui")]
    public static extern string zan_gui_webview_get_url(int h);
    [DllImport("zan_gui")]
    public static extern string zan_gui_webview_get_title(int h);
    [DllImport("zan_gui")]
    public static extern string zan_gui_webview_last_request(int h);
    [DllImport("zan_gui")]
    public static extern string zan_gui_webview_eval(int h, string js);
    [DllImport("zan_gui")]
    public static extern string zan_gui_webview_get_cookies(int h, string url);
    [DllImport("zan_gui")]
    public static extern void zan_gui_webview_set_cookie(int h, string url,
                                                  string cookieName,
                                                  string cookieValue);
    [DllImport("zan_gui")]
    public static extern void zan_gui_webview_clear_cookies(int h);
    [DllImport("zan_gui")]
    public static extern void zan_gui_webview_set_devtools_enabled(int h, int enabled);
    [DllImport("zan_gui")]
    public static extern void zan_gui_webview_set_context_menu_enabled(int h, int enabled);
    #endif

    // 创建以窗口句柄为父的视图，返回句柄。profileId 隔离
    // Cookie/缓存（""=默认配置）。平台没有可嵌入引擎时返回 0，
    // 后续所有调用均为安全空操作；无效句柄同样被忽略。
    public static int Create(nint hwnd, string profileId) {
        #if WINDOWS
        return WebView2.Create(hwnd, profileId);
        #elif MACOS || ANDROID
        return WebViewBackend.zan_gui_webview_create(hwnd, profileId);
        #else
        return 0;
        #endif
    }

    // 销毁视图并释放原生资源；无效句柄被忽略。
    public static void Destroy(int h) {
        #if WINDOWS
        WebView2 w = WebView2.Get(h);
        if (w != null) { w.Dispose(); }
        #elif MACOS || ANDROID
        WebViewBackend.zan_gui_webview_destroy(h);
        #endif
    }

    // 把原生视图摆到客户区坐标 (x,y,w,hh)（逻辑像素，平台自行按 DPI
    // 折算）；无效句柄被忽略。
    public static void SetFrame(int h, int x, int y, int w, int hh) {
        #if WINDOWS
        WebView2 v = WebView2.Get(h);
        if (v != null) { v.SetFrame(x, y, w, hh); }
        #elif MACOS || ANDROID
        WebViewBackend.zan_gui_webview_set_frame(h, x, y, w, hh);
        #endif
    }

    // 显示或隐藏原生视图；无效句柄被忽略。
    public static void SetVisible(int h, bool visible) {
        #if WINDOWS
        WebView2 w = WebView2.Get(h);
        if (w != null) { w.SetVisible(visible); }
        #elif MACOS || ANDROID
        int v = 0;
        if (visible) { v = 1; }
        WebViewBackend.zan_gui_webview_set_visible(h, v);
        #endif
    }

    // 把本帧未被遮挡的区域下发给原生视图。`spec` 是
    // "x,y,w,h;..." 的矩形并集（客户区坐标），"" = 完全被盖住，
    // 应该隐藏。签名匹配 Gui.NativeClipFn，由 WebView.Render 登记给
    // App，帧末统一回调（委托是纯函数指针，所以这里是静态方法）。
    public static void ApplyClip(int h, string spec) {
        #if WINDOWS
        WebView2 v = WebView2.Get(h);
        if (v != null) { v.SetClip(spec); }
        #elif MACOS || ANDROID
        // 原生视图是 OS 兄弟层，分区裁剪由 zan_gui 提供完
        // 备实现（macOS: gui_runtime_mac.m；Android:
        // gui_runtime_android.c）。但交叉链接只能解析仓库里
        // 已提交的 libzan_gui（由对应平台构建）的导出表，直接
        // DllImport 会让还没重建库的 --publish 链接失败。所以
        // 和下面那批桥接入口一样在运行时探测：有就真裁，没有就退回
        // set_visible 的“全遮住才隐藏”。
        WebViewBackend.ResolveBridge();
        if (WebViewBackend.addr_setClip != 0) {
            WvNameVoidFn f = (WvNameVoidFn)WebViewBackend.addr_setClip;
            f(h, spec);
            return;
        }
        WebViewBackend.zan_gui_webview_set_visible(h, spec == "" ? 0 : 1);
        #endif
    }

    // 映射虚拟域名到本地虚拟资产目录（像 Tauri 一样通过 https://app.local/* 访问，无需开放任何 TCP 端口）。
    public static bool SetVirtualHostNameToFolderMapping(int h, string hostName, string folderPath) {
        #if WINDOWS
        WebView2 w = WebView2.Get(h);
        if (w != null) { return w.SetVirtualHostNameToFolderMapping(hostName, folderPath); }
        return false;
        #else
        return false;
        #endif
    }

