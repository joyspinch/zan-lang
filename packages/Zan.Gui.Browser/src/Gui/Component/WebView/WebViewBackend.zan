    // 异步获取 `url` 匹配域名的 Cookie（协程挂起，零消息泵，不阻塞 GUI 线程）。
    public static async string GetCookiesAsync(int h, string url, int timeoutMs = 5000) {
        #if WINDOWS
        WebView2 w = WebView2.Get(h);
        if (w == null) { return ""; }
        string res = await w.GetCookiesAsync(url, timeoutMs);
        return res;
        #elif MACOS || ANDROID
        return WebViewBackend.zan_gui_webview_get_cookies(h, url);
        #else
        return "";
        #endif
    }

    // 异步获取强类型 Cookie 实体列表（零中间字符串，原生包含完整 Name/Value/Domain/Path）。
    public static async List<WebCookie> GetCookieListAsync(int h, string url, int timeoutMs = 5000) {
        #if WINDOWS
        WebView2 w = WebView2.Get(h);
        if (w == null) { return new List<WebCookie>(); }
        List<WebCookie> res = await w.GetCookieListAsync(url, timeoutMs);
        return res;
        #elif MACOS || ANDROID
        List<WebCookie> list = new List<WebCookie>();
        string ckStr = WebViewBackend.zan_gui_webview_get_cookies(h, url);
        if (ckStr != "") {
            string defDomain = ".taobao.com";
            if (url != "") {
                int p = url.IndexOf("://");
                string hp = p >= 0 ? url.Substring(p + 3) : url;
                int sl = hp.IndexOf("/");
                if (sl >= 0) { hp = hp.Substring(0, sl); }
                int cl = hp.IndexOf(":");
                if (cl >= 0) { hp = hp.Substring(0, cl); }
                if (hp != "") {
                    int dot = hp.IndexOf(".");
                    if (dot >= 0 && hp.LastIndexOf(".") > dot) {
                        defDomain = hp.Substring(dot);
                    } else if (dot >= 0) {
                        defDomain = "." + hp;
                    } else {
                        defDomain = hp;
                    }
                }
            }
            List<string> pairs = ckStr.Split(";");
            for (int i = 0; i < pairs.Count; i = i + 1) {
                string seg = pairs[i].Trim();
                int at = seg.IndexOf("=");
                if (at > 0) {
                    string k = seg.Substring(0, at).Trim();
                    string v = seg.Substring(at + 1).Trim();
                    if (k != "") {
                        list.Add(new WebCookie(k, v, defDomain, "/"));
                    }
                }
            }
        }
        return list;
        #else
        return new List<WebCookie>();
        #endif
    }

    // 异步获取 `url` 匹配域名的 Cookie 详情（name\tvalue\tdomain\tpath\n）。
    public static async string GetCookieDetailsAsync(int h, string url, int timeoutMs = 5000) {
        #if WINDOWS
        WebView2 w = WebView2.Get(h);
        if (w == null) { return ""; }
        string res = await w.GetCookieDetailsAsync(url, timeoutMs);
        return res;
        #else
        return "";
        #endif
    }

