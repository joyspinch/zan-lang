    // 同步执行 JS 并取返回值（非阻塞，禁止在 GUI 线程跑消息泵）。
    // 如需异步等待计算结果，请优先使用 <see cref="EvalWithResultAsync"/>。失败或无引擎返回 ""。
    public static string Eval(int h, string js) {
        #if WINDOWS
        WebView2 w = WebView2.Get(h);
        if (w == null) { return ""; }
        return w.Eval(js);
        #elif MACOS || ANDROID
        return WebViewBackend.zan_gui_webview_eval(h, js);
        #else
        return "";
        #endif
    }

    // 异步执行 JS 并等待其返回值（协程挂起，零消息泵，不阻塞 GUI 线程）。
    public static async string EvalWithResultAsync(int h, string js, int timeoutMs = 5000) {
        #if WINDOWS
        WebView2 w = WebView2.Get(h);
        if (w == null) { return ""; }
        string res = await w.EvalWithResultAsync(js, timeoutMs);
        return res;
        #elif MACOS || ANDROID
        return WebViewBackend.zan_gui_webview_eval(h, js);
        #else
        return "";
        #endif
    }

    // 异步等待 WebView 引擎完全就绪（控制器创建与事件绑定完成）。
    public static async bool EnsureReadyAsync(int h, int timeoutMs = 15000) {
        #if WINDOWS
        WebView2 w = WebView2.Get(h);
        if (w == null) { return false; }
        bool ok = await w.EnsureReadyAsync(timeoutMs);
        return ok;
        #else
        return true;
        #endif
    }

    // 取 `url` 匹配域名的 Cookie（"name=value; ..." 形式；无/失败为 ""）。
    public static string GetCookies(int h, string url) {
