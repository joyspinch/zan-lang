using System;
using Gui;

namespace Gui.Component.WebView;

public partial class WebView2 {
    // ---- 操作 ----

    // 把视图摆到客户区的 [x,y,w,h]：宿主子窗口移到该位置，
    // controller 在宿主内部铺满。每帧都会调，所以矩形未变时不
    // 重复下发（put_Bounds 会触发一次重布局）。
    public void SetFrame(int x, int y, int w, int h) {
        if (ctrl == 0) { return; }
        if (frameSet && x == fx && y == fy && w == fw && h == fh) { return; }
        fx = x;
        fy = y;
        fw = w;
        fh = h;
        frameSet = true;
        if (host != 0) {
            WebView2.SetWindowPos(host, 0, x, y, w, h, 4 | 16);
        }
        nint rect = NativeMemory.Alloc(16);
        new Span<int>(rect, 1)[0] = 0;
        new Span<int>(rect + 4, 1)[0] = 0;
        new Span<int>(rect + 8, 1)[0] = w;
        new Span<int>(rect + 12, 1)[0] = h;
        // 在 Windows x64 ABI 中，16 字节的 RECT 按地址传递。
        Com.Call1(ctrl, WebView2.SlotPutBounds(), rect);
        NativeMemory.Free(rect);
        // 宿主换了尺寸，上一帧的区域已经对不上了。
        clipSet = false;
    }

    // 显示或隐藏：put_IsVisible 加宿主子窗口 SW_SHOWNOACTIVATE/SW_HIDE
    // （出现不抢焦点）。状态未变时不重复下发。
    public void SetVisible(bool visible) {
        if (ctrl == 0) { return; }
        if (visibleSet && visible == this.visible) { return; }
        this.visible = visible;
        visibleSet = true;
        int v = 0;
        if (visible) { v = 1; }
        Com.Call1(ctrl, WebView2.SlotPutIsVisible(), v);
        if (host != 0) {
            // SW_SHOWNOACTIVATE / SW_HIDE：网页出现不得抢焦点。
            int cmd = 0;
            if (visible) { cmd = 4; }
            WebView2.ShowWindow(host, cmd);
        }
    }

    // 把本帧未被遮挡的区域（"x,y,w,h;..."，客户区坐标）下发给
    // 宿主子窗口。区域为空则隐藏；刚好盖满自身矩形则去掉区域
    // （SetWindowRgn(0)），没有弹层时不给系统多余的剪裁负担。
    public void SetClip(string spec) {
        if (ctrl == 0) { return; }
        if (spec.Length == 0) {
            this.SetVisible(false);
            return;
        }
        if (clipSet && spec == clipSpec) {
            this.SetVisible(true);
            return;
        }
        clipSpec = spec;
        clipSet = true;
        if (host != 0) {
            nint rgn = 0;
            bool whole = false;
            List<string> parts = spec.Split(";");
            for (int i = 0; i < parts.Count; i = i + 1) {
                List<string> n = parts[i].Split(",");
                if (n.Count < 4) { continue; }
                // 宿主窗口坐标：区域相对宿主自身的左上角。
                int l = Convert.ToInt32(n[0]) - fx;
                int t = Convert.ToInt32(n[1]) - fy;
                int r = l + Convert.ToInt32(n[2]);
                int b = t + Convert.ToInt32(n[3]);
                if (parts.Count == 1 && l <= 0 && t <= 0
                        && r >= fw && b >= fh) {
                    whole = true;
                }
                nint piece = WebView2.CreateRectRgn(l, t, r, b);
                if (piece == 0) { continue; }
                if (rgn == 0) {
                    rgn = piece;
                } else {
                    WebView2.CombineRgn(rgn, rgn, piece, 2);  // RGN_OR
                    WebView2.DeleteObject(piece);
                }
            }
            if (whole) {
                if (rgn != 0) { WebView2.DeleteObject(rgn); }
                WebView2.SetWindowRgn(host, 0, true);
            } else if (rgn != 0) {
                // 成功后区域归系统所有，不能再 DeleteObject。
                WebView2.SetWindowRgn(host, rgn, true);
            }
        }
        this.SetVisible(true);
    }

    // 导航到 target；core 未就绪时记入 pendingInitUrl 等就绪后自动导航。
    //
    // WebView2 的入口有 UI 线程亲和：async 体由后台协程池驱动，不在 GUI
    // 线程上，跨线程调用直接回 UI_E_WRONG_THREAD（0x802A000C）——导航
    // 静默失败，页面停在 about:blank。经 Dispatcher 投回 UI 线程发起。
    public void Navigate(string target) {
        if (core == 0) {
            pendingInitUrl = target;
            return;
        }
        WebView2.IssueOnUi(() => {
            if (core == 0) { return; }
            nint u = Wide.Of(target);
            int hr = Com.Call1(core, WebView2.SlotNavigate(), u);
            if (!Com.Ok(hr)) {
                Console.WriteLine("[WV2] Navigate failed hr="
                    + Convert.ToString(hr) + " url=" + target);
            }
            Wide.Free(u);
        });
    }

    // WebView2 没有带 base-url 的 NavigateToString 形式，因此 `baseUrl`
    // 被接受但忽略。控制器（core）是异步创建的：core 未就绪时把载荷挂起，
    // 等就绪回调里再导航——直接丢掉的话页面会停在 about:blank（正文空白
    // 且不报任何错）。
    //
    // 同 Navigate：入口有 UI 线程亲和，跨线程发起会被拒（UI_E_WRONG_THREAD），
    // 正文因此永远是空白——投回 UI 线程再发起。
    public void LoadHtml(string html, string baseUrl) {
        if (core == 0) {
            pendingHtml = html;
            pendingHtmlBase = baseUrl;
            return;
        }
        WebView2.IssueOnUi(() => {
            if (core == 0) { return; }
            nint h = Wide.Of(html);
            int hr = Com.Call1(core, WebView2.SlotNavigateToString(), h);
            if (!Com.Ok(hr)) {
                // 以前这里吞掉 HRESULT：正文没装上时页面停在 about:blank，
                // 宿主只看到"空白"，看不到任何原因。
                Console.WriteLine("[WV2] NavigateToString failed hr="
                    + Convert.ToString(hr) + " bytes="
                    + Convert.ToString(html == null ? 0 : html.Length));
            }
            Wide.Free(h);
        });
    }

    // 映射虚拟域名到本地虚拟资产目录（像 Tauri 一样通过 https://app.local/* 访问，无需开放任何 TCP 端口）。
    public bool SetVirtualHostNameToFolderMapping(string hostName, string folderPath) {
        if (core == 0) { return false; }
        nint v3 = Com.Query(core, WebView2.IidWebView2_3());
        if (v3 == 0) { return false; }
        nint hostW = Wide.Of(hostName);
        nint pathW = Wide.Of(folderPath);
        // accessKind: 1 = COREWEBVIEW2_HOST_RESOURCE_ACCESS_KIND_ALLOW
        int hr = Com.Call3(v3, WebView2.SlotSetVirtualHostMapping(), hostW, pathW, (nint)1);
        Wide.Free(hostW);
        Wide.Free(pathW);
        Com.Release(v3);
        return Com.Ok(hr);
    }

    // 历史后退一页（core 未就绪为空操作）。
    public void Back() { Com.Call0(core, WebView2.SlotGoBack()); }
    // 历史前进一页。
    public void Forward() { Com.Call0(core, WebView2.SlotGoForward()); }
    // 重新加载当前页。
    public void Reload() { Com.Call0(core, WebView2.SlotReload()); }
    // 停止当前加载。
    public void StopLoading() { Com.Call0(core, WebView2.SlotStop()); }

    // 能否后退。
    public bool CanGoBack() {
        return Com.GetInt(core, WebView2.SlotCanGoBack()) != 0;
    }
    // 能否前进。
    public bool CanGoForward() {
        return Com.GetInt(core, WebView2.SlotCanGoForward()) != 0;
    }
    // 是否正在加载（NavigationStarting 置位、Completed 复位）。
    public bool IsLoading() { return loading; }
    // 最近一次 OnNavigationStarting 捕获的目标 URL（导航发起即记录，
    // 供挂起导航消费逻辑使用）。
    public string LastRequest() { return lastRequest; }

    // 导航序号与近似 HTTP 状态（事件域，不经 COM 往返）。
    public int NavSeq() { return navSeq; }
    // 近似 HTTP 状态：成功 200，失败 400+WebView2 错误枚举；无导航为 0。
    public int LastStatus() { return lastStatus; }

    // 实时从核心对象读取当前 URL/标题（同时刷新事件缓存值）。
    public string GetUrl() {
        if (core != 0) { url = Com.GetString(core, WebView2.SlotGetSource()); }
        return url;
    }

    // 实时从核心对象读取当前页面标题（同时刷新事件缓存值）。
    public string GetTitle() {
        if (core != 0) {
            title = Com.GetString(core, WebView2.SlotGetDocumentTitle());
        }
        return title;
    }

    // 把 COM 发起投回 UI 线程：get_CookieManager/ExecuteScript 等
    // WebView2 入口有 UI 线程亲和（跨线程调用直接回 UI_E_WRONG_THREAD，
    // 即 0x802A000C），而 async 体由后台协程池驱动、不在 GUI 线程上——
    // 经 Dispatcher 投回，由 GUI 帧循环 DrainPosts 消费。Dispatcher
    // 未初始化（headless 探针）或队列满时 Post 失败，退化为就地发起。
    public static void IssueOnUi(Action issue) {
        if (!Dispatcher.Post(issue)) { issue(); }
    }

    // 异步运行 JavaScript 并等待其 JSON 结果（协程挂起，零消息泵，不卡死
    // GUI 线程）。发起经 IssueOnUi 投回 UI 线程，完成回调本就在 UI 线程
    // 点亮 evalGate。
    public async string EvalWithResultAsync(string js, int timeoutMs = 5000) {
        if (core == 0) { return ""; }
        evalResult = "";
        nint sink = this.Sink((nint)WebView2.OnScriptCompleted);
        evalGate = new Gate();
        WebView2.IssueOnUi(() => {
            nint script = Wide.Of(js);
            int hr = Com.Call2(core, WebView2.SlotExecuteScript(), script, sink);
            Wide.Free(script);
            if (!Com.Ok(hr)) {
                Console.WriteLine("[WV2] ExecuteScript hr=" + Convert.ToString(hr));
                evalGate.Signal();
            }
        });
        await evalGate.Wait(timeoutMs);
        return evalResult;
    }

    // 运行 JavaScript 并返回就绪的 JSON 结果（非阻塞，禁止在 GUI 线程跑消息泵）。
    // 如需异步等待计算结果，请优先使用 <see cref="EvalWithResultAsync"/>。
    public string Eval(string js) {
        if (core == 0) { return ""; }
        nint sink = this.Sink((nint)WebView2.OnScriptCompleted);
        nint script = Wide.Of(js);
        evalResult = "";
        Com.Call2(core, WebView2.SlotExecuteScript(), script, sink);
        Wide.Free(script);
        return evalResult;
    }

    // 共享的空结果完成处理器：EvalAsync/ClearBrowsingData 等不需要
    // 返回值的异步调用共用一个（无状态，随进程存活，不逐调用分配）。
    public static nint voidSink;
    public static nint VoidSink() {
        if (WebView2.voidSink == 0) {
            ComVtbl v = ComVtbl.Create(4);
            v.Add((nint)WebView2.OnQueryInterface);
            v.Add((nint)WebView2.OnAddRef);
            v.Add((nint)WebView2.OnRelease);
            v.Add((nint)WebView2.OnVoidCompleted);
            WebView2.voidSink = v.Build();
        }
        return WebView2.voidSink;
    }

    // 空结果回调（COM）：结果串归引擎所有（见 OnDocScriptAdded 注），
    // 不释放、无状态。
    public static int OnVoidCompleted(nint self, int hr, nint json) {
        return 0;
    }

    // 发射后不管的 Native→JS：不泵消息等返回值，绘制/事件回调里也
    // 能安全调用。
    public void EvalAsync(string js) {
        if (core == 0 || js == "") { return; }
        nint script = Wide.Of(js);
        Com.Call2(core, WebView2.SlotExecuteScript(), script, WebView2.VoidSink());
        Wide.Free(script);
    }

    // ---- JS→native 消息桥 ---------------------------------------------
    // .postMessage(x)。WebView2 的原生通道是 window.chrome.webview，因此
    // 每注册一个通道就注入一条 shim 脚本做形变；消息正文带 "名\t正文"
    // 前缀入队，TakeMessage 逐条取走。

    public int HandlerIndex(string name) {
        if (handlers == null) { return -1; }
        for (int i = 0; i < handlers.Count; i = i + 1) {
            if (handlers[i].name == name) { return i; }
        }
        return -1;
    }

    // 注册消息通道（原生视图创建前后皆可调用；创建前由 WebView 控件
    // 挂起，创建时补上）。同一通道重复注册为幂等成功。
    public bool AddHandler(string name) {
        if (core == 0 || name == "") { return false; }
        if (HandlerIndex(name) >= 0) { return true; }
        string id = this.AddDocScript(WebView2.ShimScript(name));
        if (id == "") { return false; }
        if (handlers == null) { handlers = new List<WebViewHandlerEntry>(); }
        handlers.Add(new WebViewHandlerEntry(name, id));
        return true;
    }

    // 撤掉消息通道：移除 shim 脚本（对之后的页面生效），名字出活跃表
    // （当前页残留的 shim 再 postMessage 也会被名字检查挡下）。
    public void RemoveHandler(string name) {
        int i = HandlerIndex(name);
        if (i < 0) { return; }
        string id = handlers[i].shimId;
        handlers.RemoveAt(i);
        if (core != 0 && id != "") {
            nint sid = Wide.Of(id);
            Com.Call1(core, WebView2.SlotRemoveDocScript(), sid);
            Wide.Free(sid);
        }
    }

    public void PushMessage(string line) {
        if (msgQ == null) { msgQ = new List<string>(); }
        if (msgQ.Count >= 128) {
            msgQ.RemoveAt(0);
            msgDrops = msgDrops + 1;
        }
        msgQ.Add(line);
    }

    public string TakeMessage() {
        if (msgQ == null || msgQ.Count == 0) { return ""; }
        string m = msgQ[0];
        msgQ.RemoveAt(0);
        return m;
    }

    public int PendingMessages() {
        return msgQ == null ? 0 : msgQ.Count;
    }

    public int DroppedMessages() { return msgDrops; }

    // ---- 文档级脚本/CSS 注入 -------------------------------------------

    // AddScriptToExecuteOnDocumentCreated 的一次调用：非阻塞向引擎注册（零消息泵），
    // 回调到达后自动记录脚本 id。
    public string AddDocScript(string js) {
        if (core == 0 || js == "") { return ""; }
        nint sink = this.Sink((nint)WebView2.OnDocScriptAdded);
        nint code = Wide.Of(js);
        pendingScriptId = "";
        int hr = Com.Call2(core, WebView2.SlotAddDocScript(), code, sink);
        Wide.Free(code);
        return "";
    }

    // 每次导航都注入的脚本：atEnd=true 包一层 readyState 门，文档解析完
    // 再跑（WebView2 只有"任何脚本之前"一档，document-end 语义由此
    // 仿真；脚本包在闭包里，页面可见的全局需显式挂到 window 上）。
    public bool InjectScript(string js, bool atEnd) {
        if (js == "") { return false; }
        this.AddDocScript(atEnd ? WebView2.DeferToDomReady(js)
                                : js);
        return true;
    }

    // 每次导航都注入的 CSS：包成 <style> 追加脚本（与 macOS 后端同构）。
    public bool InjectStyle(string css) {
        if (css == "") { return false; }
        string js = "(function(){var s=document.createElement('style');"
                  + "s.textContent=" + WebView2.JsQuote(css) + ";"
                  + "(document.head||document.documentElement)"
                  + ".appendChild(s);})();";
        return this.InjectScript(js, true);
    }

    // 撤掉全部 InjectScript/InjectStyle 注入（消息桥 shim 不受影响，
    // 与 macOS 的 removeAllUserScripts 语义一致）。
    public void ClearScripts() {
        if (scriptIds == null) { return; }
        for (int i = 0; i < scriptIds.Count; i = i + 1) {
            string id = scriptIds[i];
            if (id == "") { continue; }
            nint sid = Wide.Of(id);
            Com.Call1(core, WebView2.SlotRemoveDocScript(), sid);
            Wide.Free(sid);
        }
        scriptIds = new List<string>();
    }

    // JS 字符串字面量（带双引号）：转义反斜杠、引号与控制字符，防注入
    // 进的文本破坏脚本结构。
    public static string JsQuote(string s) {
        char bs = (char)92;
        char q = (char)34;
        char nl = (char)10;
        char cr = (char)13;
        char tab = (char)9;
        string outp = "" + q;
        for (int i = 0; i < s.Length; i = i + 1) {
            char ch = s[i];
            if (ch == bs) { outp = outp + "" + bs + bs; }
            else if (ch == q) { outp = outp + "" + bs + q; }
            else if (ch == nl) { outp = outp + "" + bs + "n"; }
            else if (ch == cr) { outp = outp + "" + bs + "r"; }
            else if (ch == tab) { outp = outp + "" + bs + "t"; }
            else { outp = outp + s.Substring(i, 1); }
        }
        return outp + q;
    }

    // <name> 通道的 shim：把 WebView2 的 window.chrome.webview 桥包装成
    // 与 macOS 同形的 window.webkit.messageHandlers.<name>.postMessage。
    // 字符串原样传递，其他类型 JSON 序列化，两端正文语义一致。
    public static string ShimScript(string name) {
        char tab = (char)9;
        string q = WebView2.JsQuote(name);
        return "(function(){var w=window.webkit=window.webkit||{};"
             + "var m=w.messageHandlers=w.messageHandlers||{};"
             + "m[" + q + "]={postMessage:function(x){"
             + "try{window.chrome.webview.postMessage(" + q
             + "+" + WebView2.JsQuote("" + tab)
             + "+(typeof x==='string'?x:JSON.stringify(x)));}catch(e){}}};})();";
    }

    // document-end 语义仿真：解析未完挂 DOMContentLoaded，否则立即执行。
    public static string DeferToDomReady(string js) {
        return "(function(){var f=function(){" + js + "};"
             + "if(document.readyState==='loading'){"
             + "document.addEventListener('DOMContentLoaded',f);}else{f();}})();";
    }

    // ---- 缩放 / DevTools / 站点数据 ------------------------------------

    // 整页缩放，percent 为百分数（100 = 原大）。旧运行时缺 ZoomFactor
    // 的情形不需处理：槽位自首个公开版即存在。
    public void SetZoom(int percent) {
        if (ctrl == 0 || percent <= 0) { return; }
        WvPutZoomFn put = (WvPutZoomFn)Com.Slot(ctrl,
                                                WebView2.SlotPutZoomFactor());
        if (put != null) { put(ctrl, percent / 100.0); }
    }

    // 为当前页打开 DevTools 窗口（发布给最终用户的程序不必携带）。
    public void OpenDevTools() {
        if (core != 0) { Com.Call0(core, WebView2.SlotOpenDevTools()); }
    }

    // 清掉本视图数据仓的全部网站数据（Cookie、DOM 存储、缓存、
    // Service Worker）。需要较新的运行时（ICoreWebView2Profile2）；
    // 不可用时返回 false，调用方退化为只清 Cookie。
    public bool ClearBrowsingData() {
        if (core == 0) { return false; }
        nint c13 = Com.Query(core, WebView2.IidWebView2_13());
        if (c13 == 0) { return false; }
        nint profile = Com.Get(c13, WebView2.SlotGetProfile());
        Com.Release(c13);
        if (profile == 0) { return false; }
        nint p2 = Com.Query(profile, WebView2.IidProfile2());
        Com.Release(profile);
        if (p2 == 0) { return false; }
        int hr = Com.Call2(p2, WebView2.SlotClearBrowsingData(),
                           (nint)WebView2.DataKindsAllSite(), WebView2.VoidSink());
        Com.Release(p2);
        return Com.Ok(hr);
    }

    // 取走上一帧新窗口请求记下的就地加载目标（无则为 ""）。由每帧的
    // 轮询调用，把 window.open/target=_blank 落到本视图导航。
    public string DrainWindowNav() {
        string uri = pendingWindowNav;
        pendingWindowNav = "";
        return uri;
    }

    // 设置是否允许开发者工具（F12、快捷键及检查元素）
    public void SetDevToolsEnabled(bool enabled) {
        devToolsEnabled = enabled;
        devToolsSet = true;
        this.ApplySettings();
    }

    // 设置是否允许默认右键上下文菜单
    public void SetContextMenuEnabled(bool enabled) {
        contextMenuEnabled = enabled;
        contextMenuSet = true;
        this.ApplySettings();
    }

    // 同步设置到底层 ICoreWebView2Settings
    public void ApplySettings() {
        if (core == 0) { return; }
        nint settings = Com.Get(core, WebView2.SlotGetSettings());
        if (settings == 0) { return; }
        if (devToolsSet) {
            Com.Call1(settings, WebView2.SlotPutAreDevToolsEnabled(), devToolsEnabled ? 1 : 0);
        }
        if (contextMenuSet) {
            Com.Call1(settings, WebView2.SlotPutAreDefaultContextMenusEnabled(), contextMenuEnabled ? 1 : 0);
        }
        Com.Release(settings);
    }

    // ICoreWebView2_2 带有 Cookie 管理器；较旧的运行时
    // 则不产生任何 Cookie。
    public nint Cookies() {
        if (core == 0) { return 0; }
        nint c2 = Com.Query(core, WebView2.IidWebView2_2());
        if (c2 == 0) {
            Console.WriteLine("[WV2] Query IidWebView2_2 failed, c2=0!");
            return 0;
        }
        nint cell = NativeMemory.Alloc(8);
        new Span<long>(cell, 1)[0] = 0;
        int hr = Com.Call1(c2, WebView2.SlotGetCookieManager(), cell);
        nint cm = new Span<long>(cell, 1)[0];
        NativeMemory.Free(cell);
        Com.Release(c2);
        if (!Com.Ok(hr) || cm == 0) {
            Console.WriteLine("[WV2] SlotGetCookieManager failed hr=" + Convert.ToString(hr) + " cm=" + Convert.ToString((long)cm));
            return 0;
        }
        return cm;
    }

    // 异步读取 `forUrl` 匹配域名的 Cookie 并在回调到达时恢复（协程挂起，
    // 零消息泵，不卡死 GUI 线程）。发起经 IssueOnUi 投回 UI 线程（下同）。
    public async string GetCookiesAsync(string forUrl, int timeoutMs = 5000) {
        nint sink = this.Sink((nint)WebView2.OnCookiesCompleted);
        cookieResult = "";
        cookieGate = new Gate();
        WebView2.IssueOnUi(() => {
            nint cm = this.Cookies();
            if (cm == 0) {
                Console.WriteLine("[WV2] Cookies() returned 0!");
                cookieGate.Signal();
                return;
            }
            nint u = 0;
            if (forUrl != "") { u = Wide.Of(forUrl); }
            int hr = Com.Call2(cm, WebView2.SlotGetCookies(), u, sink);
            if (u != 0) { Wide.Free(u); }
            Com.Release(cm);
            if (!Com.Ok(hr)) {
                Console.WriteLine("[WV2] SlotGetCookies hr=" + Convert.ToString(hr));
                cookieGate.Signal();
            }
        });
        await cookieGate.Wait(timeoutMs);
        return cookieResult;
    }

    // 异步读取 `forUrl` 匹配域名的 Cookie 详情列表（name\tvalue\tdomain\tpath\n）。
    public async string GetCookieDetailsAsync(string forUrl, int timeoutMs = 5000) {
        nint sink = this.Sink((nint)WebView2.OnCookiesCompleted);
        cookieResult = "";
        cookieDetailsResult = "";
        cookieGate = new Gate();
        WebView2.IssueOnUi(() => {
            nint cm = this.Cookies();
            if (cm == 0) {
                Console.WriteLine("[WV2] Cookies() returned 0!");
                cookieGate.Signal();
                return;
            }
            nint u = 0;
            if (forUrl != "") { u = Wide.Of(forUrl); }
            int hr = Com.Call2(cm, WebView2.SlotGetCookies(), u, sink);
            if (u != 0) { Wide.Free(u); }
            Com.Release(cm);
            if (!Com.Ok(hr)) {
                Console.WriteLine("[WV2] SlotGetCookies hr=" + Convert.ToString(hr));
                cookieGate.Signal();
            }
        });
        await cookieGate.Wait(timeoutMs);
        return cookieDetailsResult;
    }

    // 异步读取强类型 Cookie 对象列表（零字符串中转，包含完整 Name/Value/Domain/Path）。
    public async List<WebCookie> GetCookieListAsync(string forUrl = "", int timeoutMs = 5000) {
        nint sink = this.Sink((nint)WebView2.OnCookiesCompleted);
        cookieResult = "";
        cookieDetailsResult = "";
        cookieListResult = new List<WebCookie>();
        cookieGate = new Gate();
        WebView2.IssueOnUi(() => {
            nint cm = this.Cookies();
            if (cm == 0) {
                Console.WriteLine("[WV2] Cookies() returned 0!");
                cookieGate.Signal();
                return;
            }
            nint u = 0;
            if (forUrl != "") { u = Wide.Of(forUrl); }
            int hr = Com.Call2(cm, WebView2.SlotGetCookies(), u, sink);
            if (u != 0) { Wide.Free(u); }
            Com.Release(cm);
            if (!Com.Ok(hr)) {
                Console.WriteLine("[WV2] SlotGetCookies hr=" + Convert.ToString(hr));
                cookieGate.Signal();
            }
        });
        await cookieGate.Wait(timeoutMs);
        return cookieListResult;
    }

    // `forUrl` 的 Cookie，形如 "name=value; ..."；"" 表示整个存储。
    // 读取当前缓存（非阻塞，禁止在 GUI 线程跑消息泵）。如需等待最新 Cookie，请使用 <see cref="GetCookiesAsync"/>。
    public string GetCookies(string forUrl) {
        nint cm = this.Cookies();
        if (cm == 0) { return cookieResult; }
        nint sink = this.Sink((nint)WebView2.OnCookiesCompleted);
        nint u = 0;
        if (forUrl != "") { u = Wide.Of(forUrl); }
        Com.Call2(cm, WebView2.SlotGetCookies(), u, sink);
        if (u != 0) { Wide.Free(u); }
        Com.Release(cm);
        return cookieResult;
    }

    // WebView2 按主机和路径而非 URL 存储 Cookie，因此
    // 从 `forUrl` 提取主机，并把 Cookie 写到站点根路径。
    //
    // core 未就绪（控制器还在环境创建回调里）时先排队：Cookie 罐随
    // core 一起才有，落罐后首屏导航才带得上登录态。
    public void SetCookie(string forUrl, string cookieName, string cookieValue) {
        if (core == 0) {
            if (pendingCookies == null) {
                pendingCookies = new List<PendingCookieItem>();
            }
            pendingCookies.Add(new PendingCookieItem(forUrl, cookieName, cookieValue));
            return;
        }
        if (!this.WriteCookie(forUrl, cookieName, cookieValue)) {
            // Cookie 管理器同样有 UI 线程亲和：跨线程调用拿不到管理器
            // （get_CookieManager 回 UI_E_WRONG_THREAD），投回 UI 线程再试。
            WebView2.IssueOnUi(() => {
                this.WriteCookie(forUrl, cookieName, cookieValue);
            });
        }
    }

    // 把一枚 Cookie 写进 Cookie 罐（主机取自 forUrl，路径固定 "/"）。
    // 写入成功返回 true；拿不到 Cookie 管理器时返回 false。
    public bool WriteCookie(string forUrl, string cookieName, string cookieValue) {
        nint cm = this.Cookies();
        if (cm == 0) { return false; }
        string host = WebView2.HostOf(forUrl);
        if (host != "") {
            nint n = Wide.Of(cookieName);
            nint val = Wide.Of(cookieValue);
            nint d = Wide.Of(host);
            nint p = Wide.Of("/");
            nint cell = NativeMemory.Alloc(8);
            new Span<long>(cell, 1)[0] = 0;
            int hr = Com.Call5(cm, WebView2.SlotCreateCookie(), n, val, d, p, cell);
            nint cookie = new Span<long>(cell, 1)[0];
            NativeMemory.Free(cell);
            if (Com.Ok(hr) && cookie != 0) {
                Com.Call1(cm, WebView2.SlotAddOrUpdateCookie(), cookie);
                Com.Release(cookie);
            }
            Wide.Free(n);
            Wide.Free(val);
            Wide.Free(d);
            Wide.Free(p);
        }
        Com.Release(cm);
        return true;
    }

    // 清空该 profile 数据仓的全部 Cookie（运行时无 Cookie 管理器
    // 时为空操作）。
    public void ClearCookies() {
        nint cm = this.Cookies();
        if (cm == 0) { return; }
        Com.Call0(cm, WebView2.SlotDeleteAllCookies());
        Com.Release(cm);
    }

    // URL 的主机部分：去掉协议、路径、查询和端口。
    public static string HostOf(string url) {
        int n = url.Length;
        int start = 0;
        int i = 0;
        while (i + 2 < n) {
            if (url[i] == ':' && url[i + 1] == '/' && url[i + 2] == '/') {
                start = i + 3;
                i = n;
            } else {
                i = i + 1;
            }
        }
        string host = "";
        i = start;
        while (i < n) {
            char ch = url[i];
            if (ch == '/' || ch == '?' || ch == '#' || ch == ':') { return host; }
            host = host + url.Substring(i, 1);
            i = i + 1;
        }
        return host;
    }

    // 释放 COM 引用、关闭控制器并销毁宿主子窗口与回调对象。
    public void Dispose() {
        if (core != 0) {
            this.Unsubscribe(WebView2.SlotRemoveNavigationCompleted(), navToken);
            this.Unsubscribe(WebView2.SlotRemoveNavigationStarting(), startToken);
            this.Unsubscribe(WebView2.SlotRemoveSourceChanged(), srcToken);
            this.Unsubscribe(WebView2.SlotRemoveWebMessage(), msgToken);
            this.Unsubscribe(WebView2.SlotRemoveNewWindow(), winToken);
            if (respToken != 0) {
                nint c2 = Com.Query(core, WebView2.IidWebView2_2());
                if (c2 != 0) {
                    this.UnsubscribeCore2(c2, WebView2.SlotRemoveWebResourceResponseReceived(), respToken);
                    Com.Release(c2);
                }
                respToken = 0;
            }
            Com.Release(core);
            core = 0;
        }
        if (ctrl != 0) {
            Com.Call0(ctrl, WebView2.SlotControllerClose());
            Com.Release(ctrl);
            ctrl = 0;
        }
        if (env != 0) {
            Com.Release(env);
            env = 0;
        }
        if (host != 0) {
            WebView2.DestroyWindow(host);
            host = 0;
        }
    }

}
