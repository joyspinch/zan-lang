using System;
using Gui;

namespace Gui.Component.WebView;

// WebView2 消息通道与注入脚本绑定实体（消除 handlerNames/shimIds 平行列表反模式）。
class WebViewHandlerEntry {
    public string name;
    public string shimId;

    public WebViewHandlerEntry(string name, string shimId) {
        this.name = name != null ? name : "";
        this.shimId = shimId != null ? shimId : "";
    }
}
