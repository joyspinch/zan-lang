using System;
using Gui;

namespace Gui.Component.WebView;

// 挂起的 Cookie 写入项（原生视图/引擎未就绪时暂存）。
//
// 为什么需要它：网页视图的原生实例是异步建出来的（WebView2 的 core
// 要等环境创建回调才拿到），而 Cookie 是网页端唯一的登录凭据。创建
// 前调 SetCookie 若直接丢弃，"先种登录态再打开页面"这条用法就废了
// ——后台网页于是落到登录页。排队后由创建流程在首次导航之前补上。
public class PendingCookieItem {
    public string url;
    public string name;
    public string value;

    public PendingCookieItem(string u, string n, string v) {
        this.url = u != null ? u : "";
        this.name = n != null ? n : "";
        this.value = v != null ? v : "";
    }
}
