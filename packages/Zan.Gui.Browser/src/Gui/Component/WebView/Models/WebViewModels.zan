using System;
using Gui;
namespace Gui.Component.WebView;

// 挂起的 Cookie 写入项（原生视图/引擎未就绪时暂存）。
//
// 为什么需要它：网页视图的原生实例是异步建出来的（WebView2 的 core
// 要等环境创建回调才拿到），而 Cookie 是网页端唯一的登录凭据。创建
// 前调 SetCookie 若直接丢弃，"先种登录态再打开页面"这条用法就废了
// ——后台网页于是落到登录页。排队后由创建流程在首次导航之前补上。
public class PendingCookieItem {
    public string url;
    public string name;
    public string value;

    public PendingCookieItem(string u, string n, string v) {
        this.url = u != null ? u : "";
        this.name = n != null ? n : "";
        this.value = v != null ? v : "";
    }
}

// 挂起的脚本注入项强类型实体（消除 "0"/"1" + js 字符串拼接反模式）。
public class PendingScriptItem {
    public string script;
    public bool atDocumentEnd;

    public PendingScriptItem(string script, bool atDocumentEnd) {
        this.script = script != null ? script : "";
        this.atDocumentEnd = atDocumentEnd;
    }
}

// 强类型 Web Cookie 实体对象（完全对齐现代化强类型设计，避免字符串序列化/拆解）。
public class WebCookie {
    public string name;
    public string value;
    public string domain;
    public string path;
    public double expires;
    public bool isHttpOnly;
    public bool isSecure;

    public WebCookie() {
        this.name = "";
        this.value = "";
        this.domain = "";
        this.path = "/";
        this.expires = 0.0;
        this.isHttpOnly = false;
        this.isSecure = false;
    }

    public WebCookie(string n, string v, string d = "", string p = "/") {
        this.name = n != null ? n : "";
        this.value = v != null ? v : "";
        this.domain = d != null ? d : "";
        this.path = p != null ? p : "/";
        this.expires = 0.0;
        this.isHttpOnly = false;
        this.isSecure = false;
    }
}

// WebView2 消息通道与注入脚本绑定实体（消除 handlerNames/shimIds 平行列表反模式）。
public class WebViewHandlerEntry {
    public string name;
    public string shimId;

    public WebViewHandlerEntry(string name, string shimId) {
        this.name = name != null ? name : "";
        this.shimId = shimId != null ? shimId : "";
    }
}

// 异步网络响应读取上下文实体
public class WvResponseContext {
    public int id;
    public int handle;
    public string url;
    public int status;
    public nint sink;

    public WvResponseContext(int id, int handle, string url, int status, nint sink) {
        this.id = id;
        this.handle = handle;
        this.url = url != null ? url : "";
        this.status = status;
        this.sink = sink;
    }
}
