using System;
using Gui;

namespace Gui.Component.WebView;

// 异步网络响应读取上下文实体
public class WvResponseContext {
    public int id;
    public int handle;
    public string url;
    public int status;
    public nint sink;

    public WvResponseContext(int id, int handle, string url, int status, nint sink) {
        this.id = id;
        this.handle = handle;
        this.url = url;
        this.status = status;
        this.sink = sink;
    }
}
