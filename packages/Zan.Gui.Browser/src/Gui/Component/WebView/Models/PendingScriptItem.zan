using System;
using Gui;

namespace Gui.Component.WebView;

// 挂起的脚本注入项强类型实体（消除 "0"/"1" + js 字符串拼接反模式）。
public class PendingScriptItem {
    public string script;
    public bool atDocumentEnd;

    public PendingScriptItem(string script, bool atDocumentEnd) {
        this.script = script != null ? script : "";
        this.atDocumentEnd = atDocumentEnd;
    }
}
