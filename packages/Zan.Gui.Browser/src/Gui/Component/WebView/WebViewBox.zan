using System;
using Gui;
using Gui.Component;

namespace Gui.Component.WebView;

// 可摆放的原生 WebView 控件（继承三引擎共享外壳 BrowserBoxBase）。
public class WebViewBox : BrowserBoxBase {
    public override Control CreateCloneShell() { return new WebViewBox(); }
    public WebView view;

    public WebViewBox() : this("") { }

    public WebViewBox(string profileId) {
        this.InitBrowserBox("webview");
        this.view = new WebView(profileId);
    }

    public override IBrowserView BrowserView() { return this.view; }
    public WebView View() { return this.view; }
    public void SetZoom(int percent) { this.view.SetZoom(percent); }
    public void OpenDevTools() { this.view.OpenDevTools(); }
}
