using System;
using Gui;

namespace Gui.Component.WebView;

/// ICoreWebView2CreateCoreWebView2EnvironmentCompletedHandler::Invoke 及其
/// 控制器/脚本孪生签名：(this, HRESULT, result)。
delegate int WvResultFn(nint self, int hr, nint result);
/// 事件处理器：(this, sender, args)。
delegate int WvEventFn(nint self, nint sender, nint args);
/// IUnknown::QueryInterface：(this, riid, ppv)，返回 HRESULT。
delegate int WvQueryInterfaceFn(nint self, nint riid, nint ppv);
/// IUnknown::AddRef/Release 孪生：(this)，返回名义引用计数。
delegate int WvRefFn(nint self);
/// CreateCoreWebView2EnvironmentWithOptions，加载器唯一的扁平导出。
delegate int WvCreateEnvFn(nint browserFolder, nint userDataFolder,
                           nint options, nint handler);
/// GetAvailableCoreWebView2BrowserVersionString 的调用形式：查系统
/// 已安装运行时的版本号。
delegate int WvGetVersionFn(nint folder, nint version);
/// ICoreWebView2Controller::put_ZoomFactor：双精度缩放系数按值传递
/// （x64 ABI 走 xmm 寄存器，不能用指针型委托代替）。
delegate int WvPutZoomFn(nint self, double zoom);

/// <summary>
/// WebView2 消息通道与注入脚本绑定实体（消除 handlerNames/shimIds 平行列表反模式）。
/// </summary>
class WebViewHandlerEntry {
    public string name;
    public string shimId;

    public WebViewHandlerEntry(string name, string shimId) {
        this.name = name != null ? name : "";
        this.shimId = shimId != null ? shimId : "";
    }
}

/// <summary>
/// Edge WebView2，由 Zan 直接驱动。
/// WebView2 是 COM API：除加载器唯一的扁平导出外，其余都是
/// vtable 分发，其异步调用把结果交给调用方实现的
/// COM 对象。这两者都可用本语言表达——`Com.Call*`
/// 调用 vtable 槽，`ComVtbl` 用 Zan 方法构建回调对象——
/// 因此该后端不需要任何原生垫片。
/// 实例通过小整数句柄寻址：回调必须是静态的
/// （它们必须是普通函数地址），每个回调把句柄放在其 COM 对象的
/// 状态字中，事件正是借此找回它的视图。
/// </summary>
class WebView2 {
    // 宿主子窗口用到的 user32/gdi32。WebView2 的可视层挂在它被
    // 创建时指定的父窗口上，因此每个视图都拿一个自己的子 HWND
    // 当宿主：这样才能按区域裁剪（SetWindowRgn），让右键菜单、
    // 下拉、模态对话框显示在网页之上，而不是被网页盖住。
    #if WINDOWS
    [DllImport("user32", EntryPoint = "CreateWindowExW")]
    static extern nint CreateWindowExW(int exStyle, nint cls, nint title,
                                       int style, int x, int y, int w, int h,
                                       nint parent, nint menu, nint inst,
                                       nint param);
    [DllImport("user32", EntryPoint = "DestroyWindow")]
    static extern int DestroyWindow(nint hwnd);
    [DllImport("user32", EntryPoint = "SetWindowPos")]
    static extern int SetWindowPos(nint hwnd, nint after, int x, int y,
                                   int w, int h, int flags);
    [DllImport("user32", EntryPoint = "ShowWindow")]
    static extern int ShowWindow(nint hwnd, int cmd);
    [DllImport("user32", EntryPoint = "SetWindowRgn")]
    static extern int SetWindowRgn(nint hwnd, nint rgn, bool redraw);
    [DllImport("gdi32", EntryPoint = "CreateRectRgn")]
    static extern nint CreateRectRgn(int l, int t, int r, int b);
    [DllImport("gdi32", EntryPoint = "CombineRgn")]
    static extern int CombineRgn(nint dst, nint src1, nint src2, int mode);
    [DllImport("gdi32", EntryPoint = "DeleteObject")]
    static extern int DeleteObject(nint obj);
    #else
    static nint CreateWindowExW(int exStyle, nint cls, nint title,
                                int style, int x, int y, int w, int h,
                                nint parent, nint menu, nint inst,
                                nint param) { return 0; }
    static int DestroyWindow(nint hwnd) { return 0; }
    static int SetWindowPos(nint hwnd, nint after, int x, int y,
                            int w, int h, int flags) { return 0; }
    static int ShowWindow(nint hwnd, int cmd) { return 0; }
    static int SetWindowRgn(nint hwnd, nint rgn, bool redraw) { return 0; }
    static nint CreateRectRgn(int l, int t, int r, int b) { return 0; }
    static int CombineRgn(nint dst, nint src1, nint src2, int mode) { return 0; }
    static int DeleteObject(nint obj) { return 0; }
    #endif

    static List<WebView2> views;
    static nint loader;
    static nint createEnv;
    static bool comReady;

    int handle;
    /// 本视图独占的宿主子窗口（WebView2 controller 的父窗口）。
    nint host;
    nint env;
    nint ctrl;
    nint core;
    nint envSink;
    nint ctlSink;
    nint navSink;
    nint startSink;
    nint srcSink;
    long navToken;
    long startToken;
    long srcToken;
    long msgToken;
    long winToken;
    int navSeq;
    int lastStatus;
    bool loading;
    string url;
    string title;
    string lastRequest;
    string evalResult;
    string cookieResult;
    string cookieDetailsResult;
    List<WebCookie> cookieListResult;
    // JS→native 消息桥：页面 postMessage 进入有界队列，宿主逐帧取走。
    List<string> msgQ;
    int msgDrops;
    List<WebViewHandlerEntry> handlers;
    // InjectScript/InjectStyle 注册的文档级脚本 id（ClearInjected 撤用）。
    List<string> scriptIds;
    string pendingScriptId;
    // 新窗口请求的就地加载目标：事件回调里不导航（避免在回调内重入），
    // 记下目标由下一帧的轮询消费。
    string pendingWindowNav;
    nint msgSink;
    nint winSink;
    PumpGate gate;
    bool ready;
    bool initFailed;
    Gate readyGate;
    Gate evalGate;
    Gate cookieGate;
    string pendingInitUrl;
    // 最近下发的位置/裁剪/可见性。put_Bounds 与 SetWindowRgn 每帧
    // 重复下发既浪费又会让网页闪烁，因此只在真的变化时才调用。
    int fx;
    int fy;
    int fw;
    int fh;
    bool frameSet;
    string clipSpec;
    bool clipSet;
    bool visible;
    bool visibleSet;
    bool devToolsEnabled;
    bool contextMenuEnabled;
    bool devToolsSet;
    bool contextMenuSet;

    /// ICoreWebView2 的 vtable 槽。
    /// 槽 3：get_Settings，读取当前环境设置接口 ICoreWebView2Settings。
    static int SlotGetSettings() { return 3; }
    /// ICoreWebView2Settings 的 vtable 槽。
    /// 槽 11：get_AreDevToolsEnabled
    static int SlotGetAreDevToolsEnabled() { return 11; }
    /// 槽 12：put_AreDevToolsEnabled
    static int SlotPutAreDevToolsEnabled() { return 12; }
    /// 槽 13：get_AreDefaultContextMenusEnabled
    static int SlotGetAreDefaultContextMenusEnabled() { return 13; }
    /// 槽 14：put_AreDefaultContextMenusEnabled
    static int SlotPutAreDefaultContextMenusEnabled() { return 14; }
    /// 槽 4：get_Source，读取当前页面 URI。
    static int SlotGetSource() { return 4; }
    /// 槽 5：Navigate，导航到指定 URI。
    static int SlotNavigate() { return 5; }
    /// 槽 6：NavigateToString，导航到 HTML 字符串。
    static int SlotNavigateToString() { return 6; }
    /// 槽 7：add_NavigationStarting，订阅导航开始事件，返回订阅令牌。
    static int SlotAddNavigationStarting() { return 7; }
    /// 槽 8：remove_NavigationStarting，按令牌退订导航开始事件。
    static int SlotRemoveNavigationStarting() { return 8; }
    /// 槽 11：add_SourceChanged，订阅源地址变化事件，返回订阅令牌。
    static int SlotAddSourceChanged() { return 11; }
    /// 槽 12：remove_SourceChanged，按令牌退订源地址变化事件。
    static int SlotRemoveSourceChanged() { return 12; }
    /// 槽 15：add_NavigationCompleted，订阅导航完成事件，返回订阅令牌。
    static int SlotAddNavigationCompleted() { return 15; }
    /// 槽 16：remove_NavigationCompleted，按令牌退订导航完成事件。
    static int SlotRemoveNavigationCompleted() { return 16; }
    /// 槽 29：ExecuteScript，在页面执行 JavaScript，结果经回调异步返回。
    static int SlotExecuteScript() { return 29; }
    /// 槽 31：Reload，重新加载当前页。
    static int SlotReload() { return 31; }
    /// 槽 38：CanGoBack，查询历史记录能否后退。
    static int SlotCanGoBack() { return 38; }
    /// 槽 39：CanGoForward，查询历史记录能否前进。
    static int SlotCanGoForward() { return 39; }
    /// 槽 40：GoBack，后退一条历史记录。
    static int SlotGoBack() { return 40; }
    /// 槽 41：GoForward，前进一条历史记录。
    static int SlotGoForward() { return 41; }
    /// 槽 43：Stop，停止当前正在进行的导航。
    static int SlotStop() { return 43; }
    /// 槽 48：get_DocumentTitle，读取页面标题。
    static int SlotGetDocumentTitle() { return 48; }
    /// ICoreWebView2_2 接口虚函数 get_CookieManager（继承 ICoreWebView2，槽位 66）。
    static int SlotGetCookieManager() { return 66; }
    /// ICoreWebView2_2 的接口 IID，QueryInterface 取 Cookie 管理器时使用。
    static string IidWebView2_2() {
        return "9E8F0CF8-E670-4B5E-B2BC-73E061E3184C";
    }
    /// ICoreWebView2Controller 的 vtable 槽。
    /// 槽 4：put_IsVisible，设置网页视图是否可见。
    static int SlotPutIsVisible() { return 4; }
    /// 槽 6：put_Bounds，设置渲染区域矩形。
    static int SlotPutBounds() { return 6; }
    /// 槽 24：Close，关闭控制器并拆掉网页宿主窗口。
    static int SlotControllerClose() { return 24; }
    /// 槽 25：get_CoreWebView2，取核心 ICoreWebView2 指针。
    static int SlotGetCoreWebView2() { return 25; }
    /// ICoreWebView2Environment 的 vtable 槽。
    /// 槽 3：CreateCoreWebView2Controller，为宿主 HWND 异步创建控制器。
    static int SlotCreateController() { return 3; }
    /// ICoreWebView2CookieManager 的 vtable 槽。
    /// 槽 3：CreateCookie，按名称/值/域/路径异步构造 Cookie 对象。
    static int SlotCreateCookie() { return 3; }
    /// 槽 5：GetCookies，按 URI 异步取 Cookie 列表。
    static int SlotGetCookies() { return 5; }
    /// 槽 6：AddOrUpdateCookie，把 Cookie 写入容器（不存在则新增）。
    static int SlotAddOrUpdateCookie() { return 6; }
    /// 槽 10：DeleteAllCookies，清空全部 Cookie。
    static int SlotDeleteAllCookies() { return 10; }
    /// ICoreWebView2Cookie / CookieList 的 vtable 槽。
    /// ICoreWebView2Cookie 槽 3：get_Name，读 Cookie 名。
    static int SlotCookieName() { return 3; }
    /// ICoreWebView2Cookie 槽 4：get_Value，读 Cookie 值。
    static int SlotCookieValue() { return 4; }
    /// ICoreWebView2Cookie 槽 6：get_Domain，读所属域名。
    static int SlotCookieDomain() { return 6; }
    /// ICoreWebView2Cookie 槽 7：get_Path，读路径。
    static int SlotCookiePath() { return 7; }
    /// ICoreWebView2CookieList 槽 3：get_Count，读列表长度。
    static int SlotCookieCount() { return 3; }
    /// ICoreWebView2CookieList 槽 4：按下标异步取 Cookie。
    static int SlotCookieAt() { return 4; }
    /// ICoreWebView2NavigationCompletedEventArgs 的 vtable 槽。
    /// 槽 3：get_IsSuccess，导航是否成功完成。
    static int SlotIsSuccess() { return 3; }
    /// 槽 4：get_WebErrorStatus，读取失败时的错误码。
    static int SlotWebErrorStatus() { return 4; }
    /// ICoreWebView2NavigationStartingEventArgs 的 vtable 槽。
    /// 槽 3：get_Uri，读取本次导航的目标 URI。
    static int SlotArgsUri() { return 3; }

    /// ICoreWebView2 的 vtable 槽（27..51 一段，官方 WebView2.h 实数）。
    /// 槽 27：AddScriptToExecuteOnDocumentCreated，注册每次导航（文档任何
    /// 脚本之前）执行的脚本，完成回调回传脚本 id。
    static int SlotAddDocScript() { return 27; }
    /// 槽 28：RemoveScriptToExecuteOnDocumentCreated，按 id 撤掉注入脚本。
    static int SlotRemoveDocScript() { return 28; }
    /// 槽 34：add_WebMessageReceived，订阅页面 window.chrome.webview
    /// .postMessage 事件。
    static int SlotAddWebMessage() { return 34; }
    /// 槽 35：remove_WebMessageReceived，按令牌退订页面消息事件。
    static int SlotRemoveWebMessage() { return 35; }
    /// 槽 44：add_NewWindowRequested，订阅新开窗口/ target=_blank 请求。
    static int SlotAddNewWindow() { return 44; }
    /// 槽 45：remove_NewWindowRequested，按令牌退订新开窗口事件。
    static int SlotRemoveNewWindow() { return 45; }
    /// 槽 51：OpenDevToolsWindow，为当前页打开 DevTools 窗口。
    static int SlotOpenDevTools() { return 51; }

    /// ICoreWebView2Controller 的 vtable 槽。
    /// 槽 8：put_ZoomFactor，整页缩放（1.0 = 100%）。
    static int SlotPutZoomFactor() { return 8; }

    /// ICoreWebView2WebMessageReceivedEventArgs 的 vtable 槽。
    /// 槽 5：TryGetWebMessageAsString，取消息正文（字符串原文或 JSON）。
    static int SlotTryGetWebMessage() { return 5; }
    /// ICoreWebView2NewWindowRequestedEventArgs 的 vtable 槽。
    /// 槽 3：get_Uri，读取新窗口要加载的目标 URI。
    static int SlotNewWinUri() { return 3; }
    /// 槽 6：put_Handled，声明宿主已接管新窗口请求（阻止弹原生窗口）。
    static int SlotNewWinHandled() { return 6; }

    /// ICoreWebView2_13 的 IID，取 ICoreWebView2Profile 时用。
    static string IidWebView2_13() {
        return "F75F09A8-667E-4983-88D6-C8773F315E84";
    }
    /// ICoreWebView2_13 的 vtable 槽 3：get_Profile。
    static int SlotGetProfile() { return 3; }
    /// ICoreWebView2Profile2 的 IID，取 ClearBrowsingData 时用。
    static string IidProfile2() {
        return "FA740D4B-5EAE-4344-A8AD-74BE31925397";
    }
    /// ICoreWebView2Profile2 的 vtable 槽 3：ClearBrowsingData(kinds, handler)。
    static int SlotClearBrowsingData() { return 3; }
    /// COREWEBVIEW2_BROWSING_DATA_KINDS_ALL_SITE：Cookie、各类 DOM 存储、
    /// 磁盘缓存与 Service Worker（"退出登录并忘记我"的取值）。
    static int DataKindsAllSite() { return 0x80; }

    /// 全部存活视图的静态表（惰性创建；下标 0 对应句柄 1）。
    static List<WebView2> All() {
        if (WebView2.views == null) { WebView2.views = new List<WebView2>(); }
        return WebView2.views;
    }

    /// 句柄 1..n 寻址静态视图列表；0 或越界返回 null。
    static WebView2 Get(int h) {
        List<WebView2> all = WebView2.All();
        if (h <= 0 || h > all.Count) { return null; }
        return all[h - 1];
    }

    /// 存在 WebView2Loader.dll 和运行时环境时为 true。
    static bool IsAvailable() {
        if (WebView2.createEnv != 0) { return true; }
        if (WebView2.loader == 0) {
            WebView2.loader = Interop.Load("WebView2Loader.dll");
        }
        if (WebView2.loader == 0) { return false; }
        WebView2.createEnv = Interop.Symbol(
            WebView2.loader, "CreateCoreWebView2EnvironmentWithOptions");
        return WebView2.createEnv != 0;
    }

    /// <summary>系统已安装的 WebView2 运行时版本号；无加载器或无运行时
    /// 为 ""。注意方向：这是同步方法调用的出参（CoTaskMemAlloc），要
    /// 释放——与完成回调参数"只读"的规矩相反。</summary>
    static string RuntimeVersion() {
        if (!WebView2.IsAvailable()) { return ""; }
        nint fn = Interop.Symbol(WebView2.loader,
            "GetAvailableCoreWebView2BrowserVersionString");
        if (fn == 0) { return ""; }
        WvGetVersionFn call = (WvGetVersionFn)fn;
        nint cell = NativeMemory.Alloc(8);
        new Span<long>(cell, 1)[0] = 0;
        int hr = call(0, cell);
        nint s = new Span<long>(cell, 1)[0];
        NativeMemory.Free(cell);
        if (!Com.Ok(hr) || s == 0) { return ""; }
        string v = Wide.Read(s);
        Com.Free(s);
        return v;
    }

    /// 创建以 `hwnd` 为父窗口的视图，按 `profileId` 隔离（共享同一 id 的视图
    /// 共享 Cookie 和存储）。WebView2 缺失或创建失败时返回 0，
    /// 调用方回退到占位符。
    static int Create(nint hwnd, string profileId) {
        if (hwnd == 0) { return 0; }
        if (!WebView2.IsAvailable()) { return 0; }
        if (!WebView2.comReady) {
            Com.Initialize();
            WebView2.comReady = true;
        }

        WebView2 w = new WebView2();
        w.host = 0;
        w.env = 0;
        w.ctrl = 0;
        w.core = 0;
        w.frameSet = false;
        w.clipSpec = "";
        w.clipSet = false;
        w.visible = false;
        w.visibleSet = false;
        w.navSeq = 0;
        w.lastStatus = 0;
        w.loading = false;
        w.url = "";
        w.title = "";
        w.lastRequest = "";
        w.evalResult = "";
        w.cookieResult = "";
        w.msgQ = new List<string>();
        w.msgDrops = 0;
        w.handlers = new List<WebViewHandlerEntry>();
        w.scriptIds = new List<string>();
        w.pendingScriptId = "";
        w.pendingWindowNav = "";
        w.gate = new PumpGate();
        w.ready = false;
        w.initFailed = false;
        w.readyGate = new Gate();
        w.evalGate = new Gate();
        w.cookieGate = new Gate();
        w.pendingInitUrl = "";

        List<WebView2> all = WebView2.All();
        all.Add(w);
        w.handle = all.Count;

        if (!w.Start(hwnd, profileId)) {
            w.Dispose();
            return 0;
        }
        return w.handle;
    }

    /// 构建这些 API 所需的四槽 IUnknown+Invoke 回调对象之一，
    /// 并打上本视图句柄的标签。
    nint Sink(nint invoke) {
        ComVtbl v = ComVtbl.Create(4);
        v.Add((nint)WebView2.OnQueryInterface);
        v.Add((nint)WebView2.OnAddRef);
        v.Add((nint)WebView2.OnRelease);
        v.Add(invoke);
        nint obj = v.Build();
        v.SetState(handle);
        return obj;
    }

    /// 本视图的宿主子窗口：一个不做事的 STATIC 子窗口，WebView2
    /// 的可视层就长在它里。多一层宿主主要为了裁剪：子窗口可以用
    /// SetWindowRgn 按区域露出/遮住，而 put_Bounds 只能给一个矩形；
    /// 同时也让多个标签各自拥有一个能单独寻址的 HWND。
    /// 创建时不带 WS_VISIBLE：第一帧结算出可见区域后才显示。
    static nint CreateHost(nint parent) {
        nint cls = Wide.Of("STATIC");
        nint text = Wide.Of("");
        // WS_CHILD | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
        int style = 0x40000000 | 0x02000000 | 0x04000000;
        nint h = WebView2.CreateWindowExW(0, cls, text, style, 0, 0, 0, 0,
                                         parent, 0, 0, 0);
        Wide.Free(cls);
        Wide.Free(text);
        return h;
    }

    /// 启动序列：建宿主子窗口 → 异步发起 Environment 创建流水线（非阻塞，零消息泵）→
    /// 待 OnController 回调触发后由主消息循环自然挂载 core 并应用几何。
    bool Start(nint hwnd, string profileId) {
        host = WebView2.CreateHost(hwnd);
        if (host == 0) {
            initFailed = true;
            return false;
        }
        envSink = this.Sink((nint)WebView2.OnEnvironment);
        nint folder = Wide.Of(WebView2.ProfileDir(profileId));
        WvCreateEnvFn create = (WvCreateEnvFn)WebView2.createEnv;
        ready = false;
        initFailed = false;
        gate.Reset();
        readyGate = new Gate();
        int hr = create(0, folder, 0, envSink);
        Wide.Free(folder);
        if (!Com.Ok(hr)) {
            initFailed = true;
            return false;
        }

        // 以隐藏和空白状态启动；不阻塞等待，待 OnController 回调触发后
        // 自动完成 AttachCore 并下发控件排队的真实边界和可见性。
        this.SetFrame(0, 0, 0, 0);
        this.SetVisible(false);
        return true;
    }

    /// 在 Controller 回调就绪后挂载事件并应用排队的几何与状态。
    void AttachCore() {
        if (core == 0) { return; }
        navSink = this.Sink((nint)WebView2.OnNavigationCompleted);
        navToken = this.Subscribe(WebView2.SlotAddNavigationCompleted(), navSink);
        startSink = this.Sink((nint)WebView2.OnNavigationStarting);
        startToken = this.Subscribe(WebView2.SlotAddNavigationStarting(), startSink);
        srcSink = this.Sink((nint)WebView2.OnSourceChanged);
        srcToken = this.Subscribe(WebView2.SlotAddSourceChanged(), srcSink);
        msgSink = this.Sink((nint)WebView2.OnWebMessageReceived);
        msgToken = this.Subscribe(WebView2.SlotAddWebMessage(), msgSink);
        winSink = this.Sink((nint)WebView2.OnNewWindowRequested);
        winToken = this.Subscribe(WebView2.SlotAddNewWindow(), winSink);

        this.ApplySettings();

        // 应用就绪前由控件排队的几何尺寸和可见性
        if (frameSet) {
            this.SetFrame(fx, fy, fw, fh);
        }
        if (visibleSet) {
            this.SetVisible(visible);
        }
        if (clipSet) {
            this.SetClip(clipSpec);
        }

        // 刷新在就绪前添加的 message handler
        if (handlers != null && handlers.Count > 0) {
            for (int i = 0; i < handlers.Count; i = i + 1) {
                this.AddDocScript(WebView2.ShimScript(handlers[i].name));
            }
        }

        // 执行就绪前 pending 的导航
        if (pendingInitUrl != "") {
            this.Navigate(pendingInitUrl);
            pendingInitUrl = "";
        }
    }

    /// 异步等待 WebView2 完全就绪（协程挂起，零消息泵，不阻塞 GUI 线程）。
    async bool EnsureReadyAsync(int timeoutMs = 15000) {
        if (ready) { return true; }
        if (initFailed) { return false; }
        await readyGate.Wait(timeoutMs);
        return ready;
    }

    /// add_* 接受处理器和一个 EventRegistrationToken 输出参数；
    /// 稍后 remove_* 需要的就是这个 token。
    long Subscribe(int slot, nint sink) {
        nint token = NativeMemory.Alloc(8);
        new Span<long>(token, 1)[0] = 0;
        Com.Call2(core, slot, sink, token);
        long t = new Span<long>(token, 1)[0];
        NativeMemory.Free(token);
        return t;
    }

    /// remove_* 撤销订阅：token 装进 8 字节临时单元按地址传给 COM。
    void Unsubscribe(int slot, long token) {
        nint cell = NativeMemory.Alloc(8);
        new Span<long>(cell, 1)[0] = token;
        // token 是按值传递的结构体；8 字节时它在寄存器中传递，
        // 因此其值就是参数。
        Com.Call1(core, slot, (nint)token);
        NativeMemory.Free(cell);
    }

    /// %LOCALAPPDATA%\ZanGui\WebView2\<profile>；WebView2 按此文件夹
    /// 划分 Cookie 和存储，这正是配置文件隔离的原理。
    static string ProfileDir(string profileId) {
        string userEnv = Interop.EnvVar("WEBVIEW2_USER_DATA_FOLDER");
        if (userEnv != "") { return userEnv; }
        string id = profileId;
        if (id == "") { id = "default"; }
        string safe = "";
        for (int i = 0; i < id.Length; i = i + 1) {
            char ch = id[i];
            if (WebView2.IsSafeChar(ch)) { safe = safe + id.Substring(i, 1); }
            else { safe = safe + "_"; }
        }
        string root = Interop.EnvVar("LOCALAPPDATA");
        if (root == "") { root = Interop.EnvVar("TEMP"); }
        return root + "\\ZanGui\\WebView2\\" + safe;
    }

    /// 保证配置文件文件夹是单个安全的路径段。
    static bool IsSafeChar(char ch) {
        if (ch >= 'a' && ch <= 'z') { return true; }
        if (ch >= 'A' && ch <= 'Z') { return true; }
        if (ch >= '0' && ch <= '9') { return true; }
        if (ch == '-' || ch == '_') { return true; }
        return false;
    }

    // ---- 回调（普通函数地址；视图通过句柄查找）----

    /// WebView2 只索取它拿到的接口，因此对任何 riid 都返回
    /// `this` 是完成处理器惯常的应答方式。
    static int OnQueryInterface(nint self, nint riid, nint ppv) {
        if (ppv == 0) { return Com.Fail(); }
        new Span<long>(ppv, 1)[0] = self;
        return 0;
    }

    /// 回调对象与视图同生命周期，因此引用计数只是名义上的。
    static int OnAddRef(nint self) { return 2; }
    /// Release 回调：恒返回 1；回调对象随视图一起释放，不单独回收。
    static int OnRelease(nint self) { return 1; }

    /// Environment 创建完成回调（COM）：成功则保留 env 引用，
    /// 并立刻发起 Controller 的异步创建（无需消息泵轮询等待）。
    static int OnEnvironment(nint self, int hr, nint result) {
        WebView2 w = WebView2.Get(ComVtbl.State(self));
        if (w == null) { return 0; }
        if (Com.Ok(hr) && result != 0) {
            w.env = Com.Keep(result);
            w.ctlSink = w.Sink((nint)WebView2.OnController);
            int chr = Com.Call2(w.env, WebView2.SlotCreateController(), w.host, w.ctlSink);
            if (!Com.Ok(chr)) {
                w.initFailed = true;
                w.gate.Signal();
                w.readyGate.Signal();
            }
        } else {
            w.initFailed = true;
            w.gate.Signal();
            w.readyGate.Signal();
        }
        return 0;
    }

    /// Controller 创建完成回调（COM）：成功则保留 ctrl 并取 core，
    /// 自动挂载事件与设置，唤醒等待方，零阻塞完成就绪。
    static int OnController(nint self, int hr, nint result) {
        WebView2 w = WebView2.Get(ComVtbl.State(self));
        if (w == null) { return 0; }
        if (Com.Ok(hr) && result != 0) {
            w.ctrl = Com.Keep(result);
            w.core = Com.Get(w.ctrl, WebView2.SlotGetCoreWebView2());
            w.AttachCore();
            w.ready = true;
        } else {
            w.initFailed = true;
        }
        w.gate.Signal();
        w.readyGate.Signal();
        return 0;
    }

    /// 导航开始回调（COM）：记录目标 URL 到 lastRequest，置 loading
    /// （完成时由 OnNavigationCompleted 解除）。
    static int OnNavigationStarting(nint self, nint sender, nint args) {
        WebView2 w = WebView2.Get(ComVtbl.State(self));
        if (w == null) { return 0; }
        if (args != 0) {
            w.lastRequest = Com.GetString(args, WebView2.SlotArgsUri());
        }
        w.loading = true;
        return 0;
    }

    /// 导航完成回调（COM）：记录近似 HTTP 状态（成功 200，失败
    /// 400+WebView2 错误枚举）、URL/标题，navSeq 自增解除 loading。
    static int OnNavigationCompleted(nint self, nint sender, nint args) {
        WebView2 w = WebView2.Get(ComVtbl.State(self));
        if (w == null) { return 0; }
        if (args != 0) {
            int ok = Com.GetInt(args, WebView2.SlotIsSuccess());
            int status = Com.GetInt(args, WebView2.SlotWebErrorStatus());
            // 以近似 HTTP 的状态报告：加载成功为 200，
            // 否则为 400 + WebView2 错误枚举，调用方可区分
            // 各类失败而无需 WebView2 专属词汇。
            if (ok != 0) { w.lastStatus = 200; }
            else { w.lastStatus = 400 + status; }
        }
        if (sender != 0) {
            w.url = Com.GetString(sender, WebView2.SlotGetSource());
            w.title = Com.GetString(sender, WebView2.SlotGetDocumentTitle());
        }
        w.loading = false;
        w.navSeq = w.navSeq + 1;
        return 0;
    }

    /// SPA 导航无需完整加载即可改变 URL；此回调保持 Url()
    /// 的真实性。
    static int OnSourceChanged(nint self, nint sender, nint args) {
        WebView2 w = WebView2.Get(ComVtbl.State(self));
        if (w == null) { return 0; }
        if (sender != 0) {
            w.url = Com.GetString(sender, WebView2.SlotGetSource());
        }
        w.navSeq = w.navSeq + 1;
        return 0;
    }

    /// 页面消息回调（COM）：window.chrome.webview.postMessage 的正文
    /// （shim 已带 "通道名\t正文" 前缀）进有界队列，宿主逐帧取走。
    static int OnWebMessageReceived(nint self, nint sender, nint args) {
        WebView2 w = WebView2.Get(ComVtbl.State(self));
        if (w == null) { return 0; }
        if (args != 0) {
            string line = Com.GetString(args, WebView2.SlotTryGetWebMessage());
            if (line != "") { w.PushMessage(line); }
        }
        return 0;
    }

    /// 新窗口请求回调（COM）：与 macOS 后端同策略——接管请求、在本视图
    /// 就地加载目标地址，不弹原生窗口。回调里只记目标，导航由下一帧的
    /// 轮询消费（避免在事件回调内重入导航）。
    static int OnNewWindowRequested(nint self, nint sender, nint args) {
        WebView2 w = WebView2.Get(ComVtbl.State(self));
        if (w == null) { return 0; }
        if (args != 0) {
            string uri = Com.GetString(args, WebView2.SlotNewWinUri());
            Com.Call1(args, WebView2.SlotNewWinHandled(), (nint)1);
            if (uri != "") { w.pendingWindowNav = uri; }
        }
        return 0;
    }

    /// AddScriptToExecuteOnDocumentCreated 完成回调（COM）：记下脚本 id
    /// （Remove 用），唤醒 gate。id 串归引擎所有、回调返回后失效，只读
    /// 不释放——按 CoTaskMemFree 释放会触发堆损坏（实测）。
    static int OnDocScriptAdded(nint self, int hr, nint id) {
        WebView2 w = WebView2.Get(ComVtbl.State(self));
        if (w == null) { return 0; }
        if (Com.Ok(hr) && id != 0) {
            string sid = Wide.Read(id);
            if (sid != "") {
                w.pendingScriptId = sid;
                w.scriptIds.Add(sid);
            }
        }
        w.gate.Signal();
        return 0;
    }

    /// Eval 完成回调（COM）：成功则记下 JSON 结果，唤醒 Eval 的 gate。
    /// 结果串归引擎所有（见 OnDocScriptAdded 注），不能释放。
    static int OnScriptCompleted(nint self, int hr, nint json) {
        WebView2 w = WebView2.Get(ComVtbl.State(self));
        if (w == null) { return 0; }
        if (Com.Ok(hr)) { w.evalResult = Wide.Read(json); }
        w.gate.Signal();
        w.evalGate.Signal();
        return 0;
    }

    /// GetCookies 完成回调（COM）：序列化 Cookie 列表到 cookieResult，
    /// 唤醒 gate。list 与完成回调的其他参数一样归引擎所有，不得
    /// Release（过释放会让后续 COM 调用在 STA 里挂死，实测）。
    static int OnCookiesCompleted(nint self, int hr, nint list) {
        WebView2 w = WebView2.Get(ComVtbl.State(self));
        if (w == null) { return 0; }
        if (Com.Ok(hr) && list != 0) {
            w.cookieResult = WebView2.Serialize(list);
            w.cookieDetailsResult = WebView2.SerializeDetails(list);
            w.cookieListResult = WebView2.ExtractCookies(list);
        }
        w.gate.Signal();
        w.cookieGate.Signal();
        return 0;
    }

    /// 将 Cookie 列表呈现为 "name=value; name2=value2"。
    static string Serialize(nint list) {
        int n = Com.GetInt(list, WebView2.SlotCookieCount());
        string outp = "";
        for (int i = 0; i < n; i = i + 1) {
            nint cell = NativeMemory.Alloc(8);
            new Span<long>(cell, 1)[0] = 0;
            int hr = Com.Call2(list, WebView2.SlotCookieAt(), i, cell);
            nint cookie = new Span<long>(cell, 1)[0];
            NativeMemory.Free(cell);
            if (Com.Ok(hr) && cookie != 0) {
                string name = Com.GetString(cookie, WebView2.SlotCookieName());
                string val = Com.GetString(cookie, WebView2.SlotCookieValue());
                if (name != "") {
                    if (outp != "") { outp = outp + "; "; }
                    outp = outp + name + "=" + val;
                }
                Com.Release(cookie);
            }
        }
        return outp;
    }

    /// 将 Cookie 列表呈现为包含完整信息的制表符分隔行（每行一个：name\tvalue\tdomain\tpath\n）。
    static string SerializeDetails(nint list) {
        int n = Com.GetInt(list, WebView2.SlotCookieCount());
        string outp = "";
        for (int i = 0; i < n; i = i + 1) {
            nint cell = NativeMemory.Alloc(8);
            new Span<long>(cell, 1)[0] = 0;
            int hr = Com.Call2(list, WebView2.SlotCookieAt(), i, cell);
            nint cookie = new Span<long>(cell, 1)[0];
            NativeMemory.Free(cell);
            if (Com.Ok(hr) && cookie != 0) {
                string name = Com.GetString(cookie, WebView2.SlotCookieName());
                string val = Com.GetString(cookie, WebView2.SlotCookieValue());
                string dom = Com.GetString(cookie, WebView2.SlotCookieDomain());
                string path = Com.GetString(cookie, WebView2.SlotCookiePath());
                if (name != "") {
                    outp = outp + name + "\t" + val + "\t" + dom + "\t" + path + "\n";
                }
                Com.Release(cookie);
            }
        }
        return outp;
    }

    /// 直接从 COM 接口解构出强类型 List<WebCookie>，零中间字符串，完全保留所有原生字段。
    static List<WebCookie> ExtractCookies(nint list) {
        List<WebCookie> result = new List<WebCookie>();
        if (list == 0) { return result; }
        int n = Com.GetInt(list, WebView2.SlotCookieCount());
        for (int i = 0; i < n; i = i + 1) {
            nint cell = NativeMemory.Alloc(8);
            new Span<long>(cell, 1)[0] = 0;
            int hr = Com.Call2(list, WebView2.SlotCookieAt(), i, cell);
            nint cookie = new Span<long>(cell, 1)[0];
            NativeMemory.Free(cell);
            if (Com.Ok(hr) && cookie != 0) {
                string name = Com.GetString(cookie, WebView2.SlotCookieName());
                string val = Com.GetString(cookie, WebView2.SlotCookieValue());
                string dom = Com.GetString(cookie, WebView2.SlotCookieDomain());
                string path = Com.GetString(cookie, WebView2.SlotCookiePath());
                if (name != "") {
                    result.Add(new WebCookie(name, val, dom, path));
                }
                Com.Release(cookie);
            }
        }
        return result;
    }

    // ---- 操作 ----

    /// 把视图摆到客户区的 [x,y,w,h]：宿主子窗口移到该位置，
    /// controller 在宿主内部铺满。每帧都会调，所以矩形未变时不
    /// 重复下发（put_Bounds 会触发一次重布局）。
    void SetFrame(int x, int y, int w, int h) {
        if (ctrl == 0) { return; }
        if (frameSet && x == fx && y == fy && w == fw && h == fh) { return; }
        fx = x;
        fy = y;
        fw = w;
        fh = h;
        frameSet = true;
        if (host != 0) {
            // SWP_NOZORDER | SWP_NOACTIVATE
            WebView2.SetWindowPos(host, 0, x, y, w, h, 4 | 16);
        }
        nint rect = NativeMemory.Alloc(16);
        new Span<int>(rect, 1)[0] = 0;
        new Span<int>(rect + 4, 1)[0] = 0;
        new Span<int>(rect + 8, 1)[0] = w;
        new Span<int>(rect + 12, 1)[0] = h;
        // 在 Windows x64 ABI 中，16 字节的 RECT 按地址传递。
        Com.Call1(ctrl, WebView2.SlotPutBounds(), rect);
        NativeMemory.Free(rect);
        // 宿主换了尺寸，上一帧的区域已经对不上了。
        clipSet = false;
    }

    /// 显示或隐藏：put_IsVisible 加宿主子窗口 SW_SHOWNOACTIVATE/SW_HIDE
    /// （出现不抢焦点）。状态未变时不重复下发。
    void SetVisible(bool visible) {
        if (ctrl == 0) { return; }
        if (visibleSet && visible == this.visible) { return; }
        this.visible = visible;
        visibleSet = true;
        int v = 0;
        if (visible) { v = 1; }
        Com.Call1(ctrl, WebView2.SlotPutIsVisible(), v);
        if (host != 0) {
            // SW_SHOWNOACTIVATE / SW_HIDE：网页出现不得抢焦点。
            int cmd = 0;
            if (visible) { cmd = 4; }
            WebView2.ShowWindow(host, cmd);
        }
    }

    /// 把本帧未被遮挡的区域（"x,y,w,h;..."，客户区坐标）下发给
    /// 宿主子窗口。区域为空则隐藏；刚好盖满自身矩形则去掉区域
    /// （SetWindowRgn(0)），没有弹层时不给系统多余的剪裁负担。
    void SetClip(string spec) {
        if (ctrl == 0) { return; }
        if (spec.Length == 0) {
            this.SetVisible(false);
            return;
        }
        if (clipSet && spec == clipSpec) {
            this.SetVisible(true);
            return;
        }
        clipSpec = spec;
        clipSet = true;
        if (host != 0) {
            nint rgn = 0;
            bool whole = false;
            List<string> parts = spec.Split(";");
            for (int i = 0; i < parts.Count; i = i + 1) {
                List<string> n = parts[i].Split(",");
                if (n.Count < 4) { continue; }
                // 宿主窗口坐标：区域相对宿主自身的左上角。
                int l = Convert.ToInt32(n[0]) - fx;
                int t = Convert.ToInt32(n[1]) - fy;
                int r = l + Convert.ToInt32(n[2]);
                int b = t + Convert.ToInt32(n[3]);
                if (parts.Count == 1 && l <= 0 && t <= 0
                        && r >= fw && b >= fh) {
                    whole = true;
                }
                nint piece = WebView2.CreateRectRgn(l, t, r, b);
                if (piece == 0) { continue; }
                if (rgn == 0) {
                    rgn = piece;
                } else {
                    WebView2.CombineRgn(rgn, rgn, piece, 2);  // RGN_OR
                    WebView2.DeleteObject(piece);
                }
            }
            if (whole) {
                if (rgn != 0) { WebView2.DeleteObject(rgn); }
                WebView2.SetWindowRgn(host, 0, true);
            } else if (rgn != 0) {
                // 成功后区域归系统所有，不能再 DeleteObject。
                WebView2.SetWindowRgn(host, rgn, true);
            }
        }
        this.SetVisible(true);
    }

    /// 导航到 target；core 未就绪时记入 pendingInitUrl 等就绪后自动导航。
    void Navigate(string target) {
        if (core == 0) {
            pendingInitUrl = target;
            return;
        }
        nint u = Wide.Of(target);
        Com.Call1(core, WebView2.SlotNavigate(), u);
        Wide.Free(u);
    }

    /// WebView2 没有带 base-url 的 NavigateToString 形式，因此 `baseUrl`
    /// 被接受但忽略。
    void LoadHtml(string html, string baseUrl) {
        if (core == 0) { return; }
        nint h = Wide.Of(html);
        Com.Call1(core, WebView2.SlotNavigateToString(), h);
        Wide.Free(h);
    }

    /// 历史后退一页（core 未就绪为空操作）。
    void Back() { Com.Call0(core, WebView2.SlotGoBack()); }
    /// 历史前进一页。
    void Forward() { Com.Call0(core, WebView2.SlotGoForward()); }
    /// 重新加载当前页。
    void Reload() { Com.Call0(core, WebView2.SlotReload()); }
    /// 停止当前加载。
    void StopLoading() { Com.Call0(core, WebView2.SlotStop()); }

    /// 能否后退。
    bool CanGoBack() {
        return Com.GetInt(core, WebView2.SlotCanGoBack()) != 0;
    }
    /// 能否前进。
    bool CanGoForward() {
        return Com.GetInt(core, WebView2.SlotCanGoForward()) != 0;
    }
    /// 是否正在加载（NavigationStarting 置位、Completed 复位）。
    bool IsLoading() { return loading; }
    /// 最近一次 OnNavigationStarting 捕获的目标 URL（导航发起即记录，
    /// 供挂起导航消费逻辑使用）。
    string LastRequest() { return lastRequest; }

    /// 导航序号与近似 HTTP 状态（事件域，不经 COM 往返）。
    int NavSeq() { return navSeq; }
    /// 近似 HTTP 状态：成功 200，失败 400+WebView2 错误枚举；无导航为 0。
    int LastStatus() { return lastStatus; }

    /// 实时从核心对象读取当前 URL/标题（同时刷新事件缓存值）。
    string GetUrl() {
        if (core != 0) { url = Com.GetString(core, WebView2.SlotGetSource()); }
        return url;
    }

    /// 实时从核心对象读取当前页面标题（同时刷新事件缓存值）。
    string GetTitle() {
        if (core != 0) {
            title = Com.GetString(core, WebView2.SlotGetDocumentTitle());
        }
        return title;
    }

    /// 把 COM 发起投回 UI 线程：get_CookieManager/ExecuteScript 等
    /// WebView2 入口有 UI 线程亲和（跨线程调用直接回 UI_E_WRONG_THREAD，
    /// 即 0x802A000C），而 async 体由后台协程池驱动、不在 GUI 线程上——
    /// 经 Dispatcher 投回，由 GUI 帧循环 DrainPosts 消费。Dispatcher
    /// 未初始化（headless 探针）或队列满时 Post 失败，退化为就地发起。
    static void IssueOnUi(Action issue) {
        if (!Dispatcher.Post(issue)) { issue(); }
    }

    /// 异步运行 JavaScript 并等待其 JSON 结果（协程挂起，零消息泵，不卡死
    /// GUI 线程）。发起经 IssueOnUi 投回 UI 线程，完成回调本就在 UI 线程
    /// 点亮 evalGate。
    async string EvalWithResultAsync(string js, int timeoutMs = 5000) {
        if (core == 0) { return ""; }
        evalResult = "";
        nint sink = this.Sink((nint)WebView2.OnScriptCompleted);
        evalGate = new Gate();
        WebView2.IssueOnUi(() => {
            nint script = Wide.Of(js);
            int hr = Com.Call2(core, WebView2.SlotExecuteScript(), script, sink);
            Wide.Free(script);
            if (!Com.Ok(hr)) {
                Console.WriteLine("[WV2] ExecuteScript hr=" + Convert.ToString(hr));
                evalGate.Signal();
            }
        });
        await evalGate.Wait(timeoutMs);
        return evalResult;
    }

    /// 运行 JavaScript 并返回就绪的 JSON 结果（非阻塞，禁止在 GUI 线程跑消息泵）。
    /// 如需异步等待计算结果，请优先使用 <see cref="EvalWithResultAsync"/>。
    string Eval(string js) {
        if (core == 0) { return ""; }
        nint sink = this.Sink((nint)WebView2.OnScriptCompleted);
        nint script = Wide.Of(js);
        evalResult = "";
        Com.Call2(core, WebView2.SlotExecuteScript(), script, sink);
        Wide.Free(script);
        return evalResult;
    }

    /// 共享的空结果完成处理器：EvalAsync/ClearBrowsingData 等不需要
    /// 返回值的异步调用共用一个（无状态，随进程存活，不逐调用分配）。
    static nint voidSink;
    static nint VoidSink() {
        if (WebView2.voidSink == 0) {
            ComVtbl v = ComVtbl.Create(4);
            v.Add((nint)WebView2.OnQueryInterface);
            v.Add((nint)WebView2.OnAddRef);
            v.Add((nint)WebView2.OnRelease);
            v.Add((nint)WebView2.OnVoidCompleted);
            WebView2.voidSink = v.Build();
        }
        return WebView2.voidSink;
    }

    /// 空结果回调（COM）：结果串归引擎所有（见 OnDocScriptAdded 注），
    /// 不释放、无状态。
    static int OnVoidCompleted(nint self, int hr, nint json) {
        return 0;
    }

    /// 发射后不管的 Native→JS：不泵消息等返回值，绘制/事件回调里也
    /// 能安全调用。
    void EvalAsync(string js) {
        if (core == 0 || js == "") { return; }
        nint script = Wide.Of(js);
        Com.Call2(core, WebView2.SlotExecuteScript(), script, WebView2.VoidSink());
        Wide.Free(script);
    }

    // ---- JS→native 消息桥 ---------------------------------------------
    // 页面侧 API 与 macOS 对齐：window.webkit.messageHandlers.<name>
    // .postMessage(x)。WebView2 的原生通道是 window.chrome.webview，因此
    // 每注册一个通道就注入一条 shim 脚本做形变；消息正文带 "名\t正文"
    // 前缀入队，TakeMessage 逐条取走。

    int HandlerIndex(string name) {
        if (handlers == null) { return -1; }
        for (int i = 0; i < handlers.Count; i = i + 1) {
            if (handlers[i].name == name) { return i; }
        }
        return -1;
    }

    /// 注册消息通道（原生视图创建前后皆可调用；创建前由 WebView 控件
    /// 挂起，创建时补上）。同一通道重复注册为幂等成功。
    bool AddHandler(string name) {
        if (core == 0 || name == "") { return false; }
        if (HandlerIndex(name) >= 0) { return true; }
        string id = this.AddDocScript(WebView2.ShimScript(name));
        if (id == "") { return false; }
        if (handlers == null) { handlers = new List<WebViewHandlerEntry>(); }
        handlers.Add(new WebViewHandlerEntry(name, id));
        return true;
    }

    /// 撤掉消息通道：移除 shim 脚本（对之后的页面生效），名字出活跃表
    /// （当前页残留的 shim 再 postMessage 也会被名字检查挡下）。
    void RemoveHandler(string name) {
        int i = HandlerIndex(name);
        if (i < 0) { return; }
        string id = handlers[i].shimId;
        handlers.RemoveAt(i);
        if (core != 0 && id != "") {
            nint sid = Wide.Of(id);
            Com.Call1(core, WebView2.SlotRemoveDocScript(), sid);
            Wide.Free(sid);
        }
    }

    void PushMessage(string line) {
        if (msgQ == null) { msgQ = new List<string>(); }
        if (msgQ.Count >= 128) {
            msgQ.RemoveAt(0);
            msgDrops = msgDrops + 1;
        }
        msgQ.Add(line);
    }

    string TakeMessage() {
        if (msgQ == null || msgQ.Count == 0) { return ""; }
        string m = msgQ[0];
        msgQ.RemoveAt(0);
        return m;
    }

    int PendingMessages() {
        return msgQ == null ? 0 : msgQ.Count;
    }

    int DroppedMessages() { return msgDrops; }

    // ---- 文档级脚本/CSS 注入 -------------------------------------------

    /// AddScriptToExecuteOnDocumentCreated 的一次调用：非阻塞向引擎注册（零消息泵），
    /// 回调到达后自动记录脚本 id。
    string AddDocScript(string js) {
        if (core == 0 || js == "") { return ""; }
        nint sink = this.Sink((nint)WebView2.OnDocScriptAdded);
        nint code = Wide.Of(js);
        pendingScriptId = "";
        int hr = Com.Call2(core, WebView2.SlotAddDocScript(), code, sink);
        Wide.Free(code);
        return "";
    }

    /// 每次导航都注入的脚本：atEnd=true 包一层 readyState 门，文档解析完
    /// 再跑（WebView2 只有"任何脚本之前"一档，document-end 语义由此
    /// 仿真；脚本包在闭包里，页面可见的全局需显式挂到 window 上）。
    bool InjectScript(string js, bool atEnd) {
        if (js == "") { return false; }
        this.AddDocScript(atEnd ? WebView2.DeferToDomReady(js)
                                : js);
        return true;
    }

    /// 每次导航都注入的 CSS：包成 <style> 追加脚本（与 macOS 后端同构）。
    bool InjectStyle(string css) {
        if (css == "") { return false; }
        string js = "(function(){var s=document.createElement('style');"
                  + "s.textContent=" + WebView2.JsQuote(css) + ";"
                  + "(document.head||document.documentElement)"
                  + ".appendChild(s);})();";
        return this.InjectScript(js, true);
    }

    /// 撤掉全部 InjectScript/InjectStyle 注入（消息桥 shim 不受影响，
    /// 与 macOS 的 removeAllUserScripts 语义一致）。
    void ClearScripts() {
        if (scriptIds == null) { return; }
        for (int i = 0; i < scriptIds.Count; i = i + 1) {
            string id = scriptIds[i];
            if (id == "") { continue; }
            nint sid = Wide.Of(id);
            Com.Call1(core, WebView2.SlotRemoveDocScript(), sid);
            Wide.Free(sid);
        }
        scriptIds = new List<string>();
    }

    /// JS 字符串字面量（带双引号）：转义反斜杠、引号与控制字符，防注入
    /// 进的文本破坏脚本结构。
    static string JsQuote(string s) {
        char bs = (char)92;
        char q = (char)34;
        char nl = (char)10;
        char cr = (char)13;
        char tab = (char)9;
        string outp = "" + q;
        for (int i = 0; i < s.Length; i = i + 1) {
            char ch = s[i];
            if (ch == bs) { outp = outp + "" + bs + bs; }
            else if (ch == q) { outp = outp + "" + bs + q; }
            else if (ch == nl) { outp = outp + "" + bs + "n"; }
            else if (ch == cr) { outp = outp + "" + bs + "r"; }
            else if (ch == tab) { outp = outp + "" + bs + "t"; }
            else { outp = outp + s.Substring(i, 1); }
        }
        return outp + q;
    }

    /// <name> 通道的 shim：把 WebView2 的 window.chrome.webview 桥包装成
    /// 与 macOS 同形的 window.webkit.messageHandlers.<name>.postMessage。
    /// 字符串原样传递，其他类型 JSON 序列化，两端正文语义一致。
    static string ShimScript(string name) {
        char tab = (char)9;
        string q = WebView2.JsQuote(name);
        return "(function(){var w=window.webkit=window.webkit||{};"
             + "var m=w.messageHandlers=w.messageHandlers||{};"
             + "m[" + q + "]={postMessage:function(x){"
             + "try{window.chrome.webview.postMessage(" + q
             + "+" + WebView2.JsQuote("" + tab)
             + "+(typeof x==='string'?x:JSON.stringify(x)));}catch(e){}}};})();";
    }

    /// document-end 语义仿真：解析未完挂 DOMContentLoaded，否则立即执行。
    static string DeferToDomReady(string js) {
        return "(function(){var f=function(){" + js + "};"
             + "if(document.readyState==='loading'){"
             + "document.addEventListener('DOMContentLoaded',f);}else{f();}})();";
    }

    // ---- 缩放 / DevTools / 站点数据 ------------------------------------

    /// 整页缩放，percent 为百分数（100 = 原大）。旧运行时缺 ZoomFactor
    /// 的情形不需处理：槽位自首个公开版即存在。
    void SetZoom(int percent) {
        if (ctrl == 0 || percent <= 0) { return; }
        WvPutZoomFn put = (WvPutZoomFn)Com.Slot(ctrl,
                                                WebView2.SlotPutZoomFactor());
        if (put != null) { put(ctrl, percent / 100.0); }
    }

    /// 为当前页打开 DevTools 窗口（发布给最终用户的程序不必携带）。
    void OpenDevTools() {
        if (core != 0) { Com.Call0(core, WebView2.SlotOpenDevTools()); }
    }

    /// 清掉本视图数据仓的全部网站数据（Cookie、DOM 存储、缓存、
    /// Service Worker）。需要较新的运行时（ICoreWebView2Profile2）；
    /// 不可用时返回 false，调用方退化为只清 Cookie。
    bool ClearBrowsingData() {
        if (core == 0) { return false; }
        nint c13 = Com.Query(core, WebView2.IidWebView2_13());
        if (c13 == 0) { return false; }
        nint profile = Com.Get(c13, WebView2.SlotGetProfile());
        Com.Release(c13);
        if (profile == 0) { return false; }
        nint p2 = Com.Query(profile, WebView2.IidProfile2());
        Com.Release(profile);
        if (p2 == 0) { return false; }
        int hr = Com.Call2(p2, WebView2.SlotClearBrowsingData(),
                           (nint)WebView2.DataKindsAllSite(), WebView2.VoidSink());
        Com.Release(p2);
        return Com.Ok(hr);
    }

    /// 取走上一帧新窗口请求记下的就地加载目标（无则为 ""）。由每帧的
    /// 轮询调用，把 window.open/target=_blank 落到本视图导航。
    string DrainWindowNav() {
        string uri = pendingWindowNav;
        pendingWindowNav = "";
        return uri;
    }

    /// 设置是否允许开发者工具（F12、快捷键及检查元素）
    void SetDevToolsEnabled(bool enabled) {
        devToolsEnabled = enabled;
        devToolsSet = true;
        this.ApplySettings();
    }

    /// 设置是否允许默认右键上下文菜单
    void SetContextMenuEnabled(bool enabled) {
        contextMenuEnabled = enabled;
        contextMenuSet = true;
        this.ApplySettings();
    }

    /// 同步设置到底层 ICoreWebView2Settings
    void ApplySettings() {
        if (core == 0) { return; }
        nint settings = Com.Get(core, WebView2.SlotGetSettings());
        if (settings == 0) { return; }
        if (devToolsSet) {
            Com.Call1(settings, WebView2.SlotPutAreDevToolsEnabled(), devToolsEnabled ? 1 : 0);
        }
        if (contextMenuSet) {
            Com.Call1(settings, WebView2.SlotPutAreDefaultContextMenusEnabled(), contextMenuEnabled ? 1 : 0);
        }
        Com.Release(settings);
    }

    /// ICoreWebView2_2 带有 Cookie 管理器；较旧的运行时
    /// 则不产生任何 Cookie。
    nint Cookies() {
        if (core == 0) { return 0; }
        nint c2 = Com.Query(core, WebView2.IidWebView2_2());
        if (c2 == 0) {
            Console.WriteLine("[WV2] Query IidWebView2_2 failed, c2=0!");
            return 0;
        }
        nint cell = NativeMemory.Alloc(8);
        new Span<long>(cell, 1)[0] = 0;
        int hr = Com.Call1(c2, WebView2.SlotGetCookieManager(), cell);
        nint cm = new Span<long>(cell, 1)[0];
        NativeMemory.Free(cell);
        Com.Release(c2);
        if (!Com.Ok(hr) || cm == 0) {
            Console.WriteLine("[WV2] SlotGetCookieManager failed hr=" + Convert.ToString(hr) + " cm=" + Convert.ToString((long)cm));
            return 0;
        }
        return cm;
    }

    /// 异步读取 `forUrl` 匹配域名的 Cookie 并在回调到达时恢复（协程挂起，
    /// 零消息泵，不卡死 GUI 线程）。发起经 IssueOnUi 投回 UI 线程（下同）。
    async string GetCookiesAsync(string forUrl, int timeoutMs = 5000) {
        nint sink = this.Sink((nint)WebView2.OnCookiesCompleted);
        cookieResult = "";
        cookieGate = new Gate();
        WebView2.IssueOnUi(() => {
            nint cm = this.Cookies();
            if (cm == 0) {
                Console.WriteLine("[WV2] Cookies() returned 0!");
                cookieGate.Signal();
                return;
            }
            nint u = 0;
            if (forUrl != "") { u = Wide.Of(forUrl); }
            int hr = Com.Call2(cm, WebView2.SlotGetCookies(), u, sink);
            if (u != 0) { Wide.Free(u); }
            Com.Release(cm);
            if (!Com.Ok(hr)) {
                Console.WriteLine("[WV2] SlotGetCookies hr=" + Convert.ToString(hr));
                cookieGate.Signal();
            }
        });
        await cookieGate.Wait(timeoutMs);
        return cookieResult;
    }

    /// 异步读取 `forUrl` 匹配域名的 Cookie 详情列表（name\tvalue\tdomain\tpath\n）。
    async string GetCookieDetailsAsync(string forUrl, int timeoutMs = 5000) {
        nint sink = this.Sink((nint)WebView2.OnCookiesCompleted);
        cookieResult = "";
        cookieDetailsResult = "";
        cookieGate = new Gate();
        WebView2.IssueOnUi(() => {
            nint cm = this.Cookies();
            if (cm == 0) {
                Console.WriteLine("[WV2] Cookies() returned 0!");
                cookieGate.Signal();
                return;
            }
            nint u = 0;
            if (forUrl != "") { u = Wide.Of(forUrl); }
            int hr = Com.Call2(cm, WebView2.SlotGetCookies(), u, sink);
            if (u != 0) { Wide.Free(u); }
            Com.Release(cm);
            if (!Com.Ok(hr)) {
                Console.WriteLine("[WV2] SlotGetCookies hr=" + Convert.ToString(hr));
                cookieGate.Signal();
            }
        });
        await cookieGate.Wait(timeoutMs);
        return cookieDetailsResult;
    }

    /// 异步读取强类型 Cookie 对象列表（零字符串中转，包含完整 Name/Value/Domain/Path）。
    async List<WebCookie> GetCookieListAsync(string forUrl = "", int timeoutMs = 5000) {
        nint sink = this.Sink((nint)WebView2.OnCookiesCompleted);
        cookieResult = "";
        cookieDetailsResult = "";
        cookieListResult = new List<WebCookie>();
        cookieGate = new Gate();
        WebView2.IssueOnUi(() => {
            nint cm = this.Cookies();
            if (cm == 0) {
                Console.WriteLine("[WV2] Cookies() returned 0!");
                cookieGate.Signal();
                return;
            }
            nint u = 0;
            if (forUrl != "") { u = Wide.Of(forUrl); }
            int hr = Com.Call2(cm, WebView2.SlotGetCookies(), u, sink);
            if (u != 0) { Wide.Free(u); }
            Com.Release(cm);
            if (!Com.Ok(hr)) {
                Console.WriteLine("[WV2] SlotGetCookies hr=" + Convert.ToString(hr));
                cookieGate.Signal();
            }
        });
        await cookieGate.Wait(timeoutMs);
        return cookieListResult;
    }

    /// `forUrl` 的 Cookie，形如 "name=value; ..."；"" 表示整个存储。
    /// 读取当前缓存（非阻塞，禁止在 GUI 线程跑消息泵）。如需等待最新 Cookie，请使用 <see cref="GetCookiesAsync"/>。
    string GetCookies(string forUrl) {
        nint cm = this.Cookies();
        if (cm == 0) { return cookieResult; }
        nint sink = this.Sink((nint)WebView2.OnCookiesCompleted);
        nint u = 0;
        if (forUrl != "") { u = Wide.Of(forUrl); }
        Com.Call2(cm, WebView2.SlotGetCookies(), u, sink);
        if (u != 0) { Wide.Free(u); }
        Com.Release(cm);
        return cookieResult;
    }

    /// WebView2 按主机和路径而非 URL 存储 Cookie，因此
    /// 从 `forUrl` 提取主机，并把 Cookie 写到站点根路径。
    void SetCookie(string forUrl, string cookieName, string cookieValue) {
        nint cm = this.Cookies();
        if (cm == 0) { return; }
        string host = WebView2.HostOf(forUrl);
        if (host != "") {
            nint n = Wide.Of(cookieName);
            nint val = Wide.Of(cookieValue);
            nint d = Wide.Of(host);
            nint p = Wide.Of("/");
            nint cell = NativeMemory.Alloc(8);
            new Span<long>(cell, 1)[0] = 0;
            int hr = Com.Call5(cm, WebView2.SlotCreateCookie(), n, val, d, p, cell);
            nint cookie = new Span<long>(cell, 1)[0];
            NativeMemory.Free(cell);
            if (Com.Ok(hr) && cookie != 0) {
                Com.Call1(cm, WebView2.SlotAddOrUpdateCookie(), cookie);
                Com.Release(cookie);
            }
            Wide.Free(n);
            Wide.Free(val);
            Wide.Free(d);
            Wide.Free(p);
        }
        Com.Release(cm);
    }

    /// 清空该 profile 数据仓的全部 Cookie（运行时无 Cookie 管理器
    /// 时为空操作）。
    void ClearCookies() {
        nint cm = this.Cookies();
        if (cm == 0) { return; }
        Com.Call0(cm, WebView2.SlotDeleteAllCookies());
        Com.Release(cm);
    }

    /// URL 的主机部分：去掉协议、路径、查询和端口。
    static string HostOf(string url) {
        int n = url.Length;
        int start = 0;
        int i = 0;
        while (i + 2 < n) {
            if (url[i] == ':' && url[i + 1] == '/' && url[i + 2] == '/') {
                start = i + 3;
                i = n;
            } else {
                i = i + 1;
            }
        }
        string host = "";
        i = start;
        while (i < n) {
            char ch = url[i];
            if (ch == '/' || ch == '?' || ch == '#' || ch == ':') { return host; }
            host = host + url.Substring(i, 1);
            i = i + 1;
        }
        return host;
    }

    /// 释放 COM 引用、关闭控制器并销毁宿主子窗口与回调对象。
    void Dispose() {
        if (core != 0) {
            this.Unsubscribe(WebView2.SlotRemoveNavigationCompleted(), navToken);
            this.Unsubscribe(WebView2.SlotRemoveNavigationStarting(), startToken);
            this.Unsubscribe(WebView2.SlotRemoveSourceChanged(), srcToken);
            this.Unsubscribe(WebView2.SlotRemoveWebMessage(), msgToken);
            this.Unsubscribe(WebView2.SlotRemoveNewWindow(), winToken);
            Com.Release(core);
            core = 0;
        }
        if (ctrl != 0) {
            Com.Call0(ctrl, WebView2.SlotControllerClose());
            Com.Release(ctrl);
            ctrl = 0;
        }
        if (env != 0) {
            Com.Release(env);
            env = 0;
        }
        if (host != 0) {
            WebView2.DestroyWindow(host);
            host = 0;
        }
    }
}
