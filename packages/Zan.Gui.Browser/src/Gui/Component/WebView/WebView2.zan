using System;
using Gui;

namespace Gui.Component.WebView;

// ICoreWebView2CreateCoreWebView2EnvironmentCompletedHandler::Invoke 及其
// 控制器/脚本孪生签名：(this, HRESULT, result)。
public delegate int WvResultFn(nint self, int hr, nint result);
// 事件处理器：(this, sender, args)。
public delegate int WvEventFn(nint self, nint sender, nint args);
// IUnknown::QueryInterface：(this, riid, ppv)，返回 HRESULT。
public delegate int WvQueryInterfaceFn(nint self, nint riid, nint ppv);
// IUnknown::AddRef/Release 孪生：(this)，返回名义引用计数。
public delegate int WvRefFn(nint self);
// CreateCoreWebView2EnvironmentWithOptions，加载器唯一的扁平导出。
public delegate int WvCreateEnvFn(nint browserFolder, nint userDataFolder,
                           nint options, nint handler);
// GetAvailableCoreWebView2BrowserVersionString 的调用形式：查系统
// 已安装运行时的版本号。
public delegate int WvGetVersionFn(nint folder, nint version);
// ICoreWebView2Controller::put_ZoomFactor：双精度缩放系数按值传递
// （x64 ABI 走 xmm 寄存器，不能用指针型委托代替）。
public delegate int WvPutZoomFn(nint self, double zoom);

// Edge WebView2，由 Zan 直接驱动。
// WebView2 是 COM API：除加载器唯一的扁平导出外，其余都是
// vtable 分发，其异步调用把结果交给调用方实现的
// COM 对象。这两者都可用本语言表达——`Com.Call*`
// 调用 vtable 槽，`ComVtbl` 用 Zan 方法构建回调对象——
// 因此该后端不需要任何原生垫片。
// 实例通过小整数句柄寻址：回调必须是静态的
// （它们必须是普通函数地址），每个回调把句柄放在其 COM 对象的
// 状态字中，事件正是借此找回它的视图。
public partial class WebView2 {
    // 宿主子窗口用到的 user32/gdi32。WebView2 的可视层挂在它被
    // 创建时指定的父窗口上，因此每个视图都拿一个自己的子 HWND
    // 当宿主：这样才能按区域裁剪（SetWindowRgn），让右键菜单、
    // 下拉、模态对话框显示在网页之上，而不是被网页盖住。
    #if WINDOWS
    [DllImport("user32", EntryPoint = "CreateWindowExW")]
    public static extern nint CreateWindowExW(int exStyle, nint cls, nint title,
                                       int style, int x, int y, int w, int h,
                                       nint parent, nint menu, nint inst,
                                       nint param);
    [DllImport("user32", EntryPoint = "DestroyWindow")]
    public static extern int DestroyWindow(nint hwnd);
    [DllImport("user32", EntryPoint = "SetWindowPos")]
    public static extern int SetWindowPos(nint hwnd, nint after, int x, int y,
                                   int w, int h, int flags);
    [DllImport("user32", EntryPoint = "ShowWindow")]
    public static extern int ShowWindow(nint hwnd, int cmd);
    [DllImport("user32", EntryPoint = "SetWindowRgn")]
    public static extern int SetWindowRgn(nint hwnd, nint rgn, bool redraw);
    [DllImport("gdi32", EntryPoint = "CreateRectRgn")]
    public static extern nint CreateRectRgn(int l, int t, int r, int b);
    [DllImport("gdi32", EntryPoint = "CombineRgn")]
    public static extern int CombineRgn(nint dst, nint src1, nint src2, int mode);
    [DllImport("gdi32", EntryPoint = "DeleteObject")]
    public static extern int DeleteObject(nint obj);
    #else
    public static nint CreateWindowExW(int exStyle, nint cls, nint title,
                                int style, int x, int y, int w, int h,
                                nint parent, nint menu, nint inst,
                                nint param) { return 0; }
    public static int DestroyWindow(nint hwnd) { return 0; }
    public static int SetWindowPos(nint hwnd, nint after, int x, int y,
                            int w, int h, int flags) { return 0; }
    public static int ShowWindow(nint hwnd, int cmd) { return 0; }
    public static int SetWindowRgn(nint hwnd, nint rgn, bool redraw) { return 0; }
    public static nint CreateRectRgn(int l, int t, int r, int b) { return 0; }
    public static int CombineRgn(nint dst, nint src1, nint src2, int mode) { return 0; }
    public static int DeleteObject(nint obj) { return 0; }
    #endif

