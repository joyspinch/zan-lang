    public static int DataKindsAllSite() { return 0x80; }

    // 全部存活视图的静态表（惰性创建；下标 0 对应句柄 1）。
    public static List<WebView2> All() {
        if (WebView2.views == null) { WebView2.views = new List<WebView2>(); }
        return WebView2.views;
    }

    // 句柄 1..n 寻址静态视图列表；0 或越界返回 null。
    public static WebView2 Get(int h) {
        List<WebView2> all = WebView2.All();
        if (h <= 0 || h > all.Count) { return null; }
        return all[h - 1];
    }

    // 存在 WebView2Loader.dll 和运行时环境时为 true。
    public static bool IsAvailable() {
        if (WebView2.createEnv != 0) { return true; }
        if (WebView2.loader == 0) {
            WebView2.loader = Interop.Load("WebView2Loader.dll");
        }
        if (WebView2.loader == 0) { return false; }
        WebView2.createEnv = Interop.Symbol(
            WebView2.loader, "CreateCoreWebView2EnvironmentWithOptions");
        return WebView2.createEnv != 0;
    }

    // 系统已安装的 WebView2 运行时版本号；无加载器或无运行时
    // 为 ""。注意方向：这是同步方法调用的出参（CoTaskMemAlloc），要
    // 释放——与完成回调参数"只读"的规矩相反。
    public static string RuntimeVersion() {
        if (!WebView2.IsAvailable()) { return ""; }
        nint fn = Interop.Symbol(WebView2.loader,
            "GetAvailableCoreWebView2BrowserVersionString");
        if (fn == 0) { return ""; }
        WvGetVersionFn call = (WvGetVersionFn)fn;
        nint cell = NativeMemory.Alloc(8);
        new Span<long>(cell, 1)[0] = 0;
        int hr = call(0, cell);
        nint s = new Span<long>(cell, 1)[0];
        NativeMemory.Free(cell);
        if (!Com.Ok(hr) || s == 0) { return ""; }
        string v = Wide.Read(s);
        Com.Free(s);
        return v;
    }

    // 创建以 `hwnd` 为父窗口的视图，按 `profileId` 隔离（共享同一 id 的视图
    // 共享 Cookie 和存储）。WebView2 缺失或创建失败时返回 0，
    // 调用方回退到占位符。
    public static int Create(nint hwnd, string profileId) {
        if (hwnd == 0) { return 0; }
        if (!WebView2.IsAvailable()) { return 0; }
        if (!WebView2.comReady) {
            Com.Initialize();
            WebView2.comReady = true;
        }

        WebView2 w = new WebView2();
        w.host = 0;
        w.env = 0;
        w.ctrl = 0;
        w.core = 0;
        w.frameSet = false;
        w.clipSpec = "";
        w.clipSet = false;
        w.visible = false;
        w.visibleSet = false;
        w.navSeq = 0;
        w.lastStatus = 0;
        w.loading = false;
        w.url = "";
        w.title = "";
        w.lastRequest = "";
        w.evalResult = "";
        w.cookieResult = "";
        w.msgQ = new List<string>();
        w.msgDrops = 0;
        w.handlers = new List<WebViewHandlerEntry>();
        w.scriptIds = new List<string>();
        w.pendingScriptId = "";
        w.pendingWindowNav = "";
        w.ready = false;
        w.initFailed = false;
        w.readyGate = new Gate();
        w.evalGate = new Gate();
        w.cookieGate = new Gate();
        w.pendingInitUrl = "";
        w.pendingHtml = "";
        w.pendingHtmlBase = "";
        w.pendingCookies = new List<PendingCookieItem>();

        List<WebView2> all = WebView2.All();
        all.Add(w);
        w.handle = all.Count;

        if (!w.Start(hwnd, profileId)) {
            w.Dispose();
            return 0;
        }
        return w.handle;
    }

    // 构建这些 API 所需的四槽 IUnknown+Invoke 回调对象之一，
    // 并打上本视图句柄的标签。
    public nint Sink(nint invoke) {
        ComVtbl v = ComVtbl.Create(4);
        v.Add((nint)WebView2.OnQueryInterface);
        v.Add((nint)WebView2.OnAddRef);
        v.Add((nint)WebView2.OnRelease);
        v.Add(invoke);
        nint obj = v.Build();
        v.SetState(handle);
        return obj;
    }

    // 本视图的宿主子窗口：一个不做事的 STATIC 子窗口，WebView2
    // 的可视层就长在它里。多一层宿主主要为了裁剪：子窗口可以用
    // SetWindowRgn 按区域露出/遮住，而 put_Bounds 只能给一个矩形；
    // 同时也让多个标签各自拥有一个能单独寻址的 HWND。
    // 创建时不带 WS_VISIBLE：第一帧结算出可见区域后才显示。
    public static nint CreateHost(nint parent) {
        nint cls = Wide.Of("STATIC");
        nint text = Wide.Of("");
        // WS_CHILD | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
        int style = 0x40000000 | 0x02000000 | 0x04000000;
        nint h = WebView2.CreateWindowExW(0, cls, text, style, 0, 0, 0, 0,
                                         parent, 0, 0, 0);
        Wide.Free(cls);
        Wide.Free(text);
        return h;
    }

    // 启动序列：建宿主子窗口 → 异步发起 Environment 创建流水线（非阻塞，零消息泵）→
    // 待 OnController 回调触发后由主消息循环自然挂载 core 并应用几何。
    public bool Start(nint hwnd, string profileId) {
        host = WebView2.CreateHost(hwnd);
        if (host == 0) {
            initFailed = true;
            return false;
        }
        envSink = this.Sink((nint)WebView2.OnEnvironment);
        nint folder = Wide.Of(WebView2.ProfileDir(profileId));
        WvCreateEnvFn create = (WvCreateEnvFn)WebView2.createEnv;
        ready = false;
        initFailed = false;
        readyGate = new Gate();
        int hr = create(0, folder, 0, envSink);
        Wide.Free(folder);
        if (!Com.Ok(hr)) {
            initFailed = true;
            return false;
        }

        // 以隐藏和空白状态启动；不阻塞等待，待 OnController 回调触发后
        // 自动完成 AttachCore 并下发控件排队的真实边界和可见性。
        this.SetFrame(0, 0, 0, 0);
        this.SetVisible(false);
        return true;
    }

    // 在 Controller 回调就绪后挂载事件并应用排队的几何与状态。
    public void AttachCore() {
        if (core == 0) { return; }
        navSink = this.Sink((nint)WebView2.OnNavigationCompleted);
        navToken = this.Subscribe(WebView2.SlotAddNavigationCompleted(), navSink);
        startSink = this.Sink((nint)WebView2.OnNavigationStarting);
        startToken = this.Subscribe(WebView2.SlotAddNavigationStarting(), startSink);
        srcSink = this.Sink((nint)WebView2.OnSourceChanged);
        srcToken = this.Subscribe(WebView2.SlotAddSourceChanged(), srcSink);
        msgSink = this.Sink((nint)WebView2.OnWebMessageReceived);
        msgToken = this.Subscribe(WebView2.SlotAddWebMessage(), msgSink);
        winSink = this.Sink((nint)WebView2.OnNewWindowRequested);
        winToken = this.Subscribe(WebView2.SlotAddNewWindow(), winSink);

        nint c2 = Com.Query(core, WebView2.IidWebView2_2());
        if (c2 != 0) {
            respSink = this.Sink((nint)WebView2.OnWebResourceResponseReceived);
            respToken = this.SubscribeCore2(c2, WebView2.SlotAddWebResourceResponseReceived(), respSink);
            Com.Release(c2);
        }

        this.ApplySettings();

        // 应用就绪前由控件排队的几何尺寸和可见性
        if (frameSet) {
            this.SetFrame(fx, fy, fw, fh);
        }
        if (visibleSet) {
            this.SetVisible(visible);
        }
        if (clipSet) {
            this.SetClip(clipSpec);
        }

        // 刷新在就绪前添加的 message handler
        if (handlers != null && handlers.Count > 0) {
            for (int i = 0; i < handlers.Count; i = i + 1) {
                this.AddDocScript(WebView2.ShimScript(handlers[i].name));
            }
        }

        // 先把排队的 Cookie 落罐，再消费挂起的导航：首屏必须带着
        // 登录态（网页视图只能靠 Cookie 认证，没有请求头可继承）。
        if (pendingCookies != null && pendingCookies.Count > 0) {
            List<PendingCookieItem> cookies = pendingCookies;
            pendingCookies = new List<PendingCookieItem>();
            for (int i = 0; i < cookies.Count; i = i + 1) {
                PendingCookieItem pc = cookies[i];
                this.WriteCookie(pc.url, pc.name, pc.value);
            }
        }

        // 执行就绪前 pending 的导航
        if (pendingInitUrl != "") {
            this.Navigate(pendingInitUrl);
            pendingInitUrl = "";
        }
        // 执行就绪前 pending 的 HTML 载荷（HTML 优先于 URL：两者都挂起
        // 时以最后挂起的那个为准，HTML 是「就地装载」）。
        if (pendingHtml != "") {
            string h = pendingHtml;
            string b = pendingHtmlBase;
            pendingHtml = "";
            pendingHtmlBase = "";
            this.LoadHtml(h, b);
        }
    }

    // 异步等待 WebView2 完全就绪（协程挂起，零消息泵，不阻塞 GUI 线程）。
    public async bool EnsureReadyAsync(int timeoutMs = 15000) {
        if (ready) { return true; }
        if (initFailed) { return false; }
        await readyGate.Wait(timeoutMs);
        return ready;
    }

    // add_* 接受处理器和一个 EventRegistrationToken 输出参数；
    // 稍后 remove_* 需要的就是这个 token。
    public long Subscribe(int slot, nint sink) {
        nint token = NativeMemory.Alloc(8);
        new Span<long>(token, 1)[0] = 0;
        Com.Call2(core, slot, sink, token);
        long t = new Span<long>(token, 1)[0];
        NativeMemory.Free(token);
        return t;
    }

    // remove_* 撤销订阅：token 装进 8 字节临时单元按地址传给 COM。
    public void Unsubscribe(int slot, long token) {
        nint cell = NativeMemory.Alloc(8);
        new Span<long>(cell, 1)[0] = token;
        // token 是按值传递的结构体；8 字节时它在寄存器中传递，
        // 因此其值就是参数。
        Com.Call1(core, slot, (nint)token);
        NativeMemory.Free(cell);
    }

    public long SubscribeCore2(nint iface, int slot, nint sink) {
        nint token = NativeMemory.Alloc(8);
        new Span<long>(token, 1)[0] = 0;
        Com.Call2(iface, slot, sink, token);
        long t = new Span<long>(token, 1)[0];
        NativeMemory.Free(token);
        return t;
    }

    public void UnsubscribeCore2(nint iface, int slot, long token) {
        nint cell = NativeMemory.Alloc(8);
        new Span<long>(cell, 1)[0] = token;
        Com.Call1(iface, slot, (nint)token);
        NativeMemory.Free(cell);
    }

    // %LOCALAPPDATA%\ZanGui\WebView2\<profile>；WebView2 按此文件夹
    // 划分 Cookie 和存储，这正是配置文件隔离的原理。
    public static string ProfileDir(string profileId) {
        string userEnv = Interop.EnvVar("WEBVIEW2_USER_DATA_FOLDER");
        if (userEnv != "") { return userEnv; }
        string id = profileId;
        if (id == "") { id = "default"; }
        string safe = "";
        for (int i = 0; i < id.Length; i = i + 1) {
            char ch = id[i];
            if (WebView2.IsSafeChar(ch)) { safe = safe + id.Substring(i, 1); }
            else { safe = safe + "_"; }
        }
        string root = Interop.EnvVar("LOCALAPPDATA");
        if (root == "") { root = Interop.EnvVar("TEMP"); }
        return root + "\\ZanGui\\WebView2\\" + safe;
    }

    // 保证配置文件文件夹是单个安全的路径段。
    public static bool IsSafeChar(char ch) {
        if (ch >= 'a' && ch <= 'z') { return true; }
        if (ch >= 'A' && ch <= 'Z') { return true; }
        if (ch >= '0' && ch <= '9') { return true; }
        if (ch == '-' || ch == '_') { return true; }
        return false;
    }


}
