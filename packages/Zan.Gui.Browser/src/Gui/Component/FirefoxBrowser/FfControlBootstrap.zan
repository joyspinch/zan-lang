using Gui;

namespace Gui.Component.FirefoxBrowser;

// Firefox 家族的 HeavyControls 注册入口。IDE、浏览器示例等真正用到
// FfBrowserBox 的宿主在启动时调用一次 <see cref="Install"/>（放在
// Main 最前，与 CefControlBootstrap.Install 同一位置约定）；不调用的
// 程序里整个 Firefox 家族被 globaldce 删光，发布不携带任何相关代码
// （本家族纯 Zan 实现，没有原生 DLL 需要裁剪，这里只是保持与
// CefControlBootstrap/WebViewBootstrap 同型的注册入口）。
public class FfControlBootstrap {
    public static bool installed;

    public static void Install() {
        if (FfControlBootstrap.installed) { return; }
        FfControlBootstrap.installed = true;
        HeavyControls.Register("FfBrowserBox", FfControlBootstrap.MakeFfBrowserBox);
    }

    public static Control MakeFfBrowserBox(string kind) {
        if (kind == "FfBrowserBox") { return new FfBrowserBox(); }
        return null;
    }
}
