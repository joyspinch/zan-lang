using System;
using System.IO;
using System.Net.Http.Download;
using Gui.Component.Downloader;

namespace Gui.Component.FirefoxBrowser;

// Firefox 的启动自举入口：先按既有发现链找本机 Firefox（ZAN_FF_EXE →
// 注册表 → 标准目录），找不到就解析官方最新版本号 → DownloadJob 下载 →
// 静默安装到用户级缓存，全程带 <see cref="DownloadDialog"/> 进度窗
// （ZAN_FF_DOWNLOAD_UI=0 或窗口创建失败时回退静默路径）。
// 宿主在 Main 里（同步，因为进度窗走泵驱动等待，主线程在泵里转）：
// <code>
// string exe = FfBootstrap.Ensure();
// if (exe == "") { Console.WriteLine(FfRuntime.lastError); return 1; }
// </code>
// 关键：独立进度窗的等待必须用泵驱动（<see cref="ChildWindow.PumpStandaloneUntilKeepOpen"/>，
// 内部 host.PumpSafe() 每帧泵 Win32 消息），不能用 Task.Delay 空转——
// 那样窗口的消息没人分发，Windows 判定未响应。
public class FfBootstrap {
    // 确保本机有可用的 Firefox：发现 → 缓存 → 下载安装。
    // 返回 Firefox 可执行文件路径；失败 ""（<see cref="FfRuntime.lastError"/>，
    // 失败详情也会经 FfRuntime.Fail 写入）。
    // 有进度窗时本方法在泵里阻塞直到任务收工（窗口全程响应）；
    // 静默路径（ZAN_FF_DOWNLOAD_UI=0 / 开窗失败）靠 worker 轮询。
    public static async string EnsureAsync() {
        string exe = FfHost.FindFirefoxExe();
        if (exe != "") { return exe; }
        exe = FfRuntime.InstalledExe();
        if (exe != "") { return exe; }
        // 版本解析在主线程先做（此刻还没开进度窗，await 无泵问题）。
        string ver = await FfRuntime.ResolveVersionAsync();
        if (ver == "") { return ""; }
        DownloadJob job = FfRuntime.NewEnsureJob(ver);
        DownloadDialog dlg = null;
        bool wantUi = Interop.EnvVar("ZAN_FF_DOWNLOAD_UI") != "0";
        if (wantUi) {
            try {
                dlg = DownloadDialog.OpenStandalone("正在准备 Firefox", job);
            } catch (Exception) {
                // 无显示器/无 Gui 宿主：回退到下面的静默路径。
                dlg = null;
            }
        }
        job.Start();
        bool ok = false;
        if (dlg != null && dlg.IsOpen()) {
            dlg.SetIntro("首次运行会从 Mozilla 官方源下载 Firefox（约 60~90MB）"
                + "并安装到用户级缓存，之后不再下载。");
            // 泵驱动等待：host.PumpSafe() 每圈分发 Win32 消息，窗口
            // 全程响应；进度条由对话框的 AfterFrame 每帧刷新。
            dlg.PumpStandaloneUntilKeepOpen(() => { return job.Running(); });
            ok = job.Succeeded();
            dlg.Close();
        } else {
            // 窗口没开成（无显示器/锁屏会话）：静默等完。必须用异步
            // 延时而不是 Thread.Sleep——下载协程的续体要靠本线程驱动
            // reactor，阻塞主线程会把 worker 一起饿死。
            while (job.Running()) {
                job.Poll();
                await Task.Delay(100);
            }
            ok = job.Succeeded();
        }
        if (!ok) {
            FfRuntime.Fail("Firefox 自举失败：" + FfBootstrap.JobError(job));
            return "";
        }
        exe = FfRuntime.EnsuredExe();
        if (exe == "") {
            FfRuntime.Fail("Firefox 自举失败：" + FfRuntime.lastError);
        }
        return exe;
    }

    // 供 Gui 宿主自组进度窗的任务构造：已装好/能发现本机 Firefox 时
    // 返回 null（无需下载）。宿主在主线程先 await 本方法解析版本，
    // 再 DownloadDialog.Show + job.Start()——Show 与 Start 之间不要
    // 夹 await（窗口在主线程上开，泵才会有人喂）。
    public static async DownloadJob NewRuntimeJobAsync() {
        string exe = FfHost.FindFirefoxExe();
        if (exe != "") { return null; }
        if (FfRuntime.InstalledExe() != "") { return null; }
        string ver = await FfRuntime.ResolveVersionAsync();
        if (ver == "") { return null; }
        return FfRuntime.NewEnsureJob(ver);
    }

    // 翻译 DownloadJob 的失败状态；准备/安装阶段写的 FfRuntime.Error
    // 优先，任务层状态兜底。
    public static string JobError(DownloadJob job) {
        string detail = FfRuntime.lastError;
        if (detail == "" && job != null) { detail = job.Error(); }
        if (job != null && job.Stage() == DownloadStage.Cancelled) {
            return "下载已取消";
        }
        if (detail == "" && job != null) {
            return "下载任务失败（阶段 " + job.FailedStage() + "）";
        }
        return detail;
    }
}
