using System;

namespace Gui.Component.FirefoxBrowser;

// Firefox 嵌入的路径与启动配置，代码级入口。与 CefOptions 同构：
// 每一项都有环境变量对应物（运维/调试时不改代码就能改），优先级
// 显式字段 > 环境变量 > 默认值；空字符串表示「没设」。
// <code>
// FfOptions o = new FfOptions();
// o.exePath = "D:/apps/firefox/firefox.exe"; // 自备 Firefox，跳过自动发现
// o.showChrome = true;                        // 保留 Firefox 自己的工具栏
// FfOptions.Use(o);
// </code>
public class FfOptions {
    // Firefox 可执行文件的绝对路径（对应 ZAN_FF_EXE）。设了就跳过
    // 注册表/标准目录自动发现。
    public string exePath;
    // profile 根目录（对应 ZAN_FF_PROFILE_ROOT）。每个 FfBrowser 实例
    // 在它下面各建一个独立 profile 子目录（-no-remote 多开的前提）。
    // 默认在平台缓存根（%LOCALAPPDATA%/Zan/ff、~/.cache/zan/ff、
    // ~/Library/Caches/Zan/ff）。
    public string profileRoot;
    // Marionette 控制端口（对应 ZAN_FF_PORT）。0 = 每个实例自动挑一个
    // 空闲端口（默认行为）。
    public int port;
    // 保留 Firefox 自己的界面（标签栏/地址栏）。默认 false：写
    // userChrome.css 把 #navigator-toolbox 藏掉，让窗口只剩网页内容，
    // 视觉上才是「嵌入了一个浏览器视图」而不是「飘着一个小 Firefox」。
    // 地址栏藏掉后 Ctrl+L、Ctrl+T 等快捷键仍可用。
    public bool showChrome;
    // 追加的 Firefox 命令行参数（对应 ZAN_FF_ARGS），空格分隔，
    // 由调用方保证合法。
    public string extraArgs;

    public static FfOptions current;

    // 构造全默认配置：自动发现、自动端口、chromeless。
    public FfOptions() {
        this.exePath = "";
        this.profileRoot = "";
        this.port = 0;
        this.showChrome = false;
        this.extraArgs = "";
    }

    // 让后续所有 Firefox 嵌入调用使用这份配置。
    public static void Use(FfOptions options) { FfOptions.current = options; }

    // 当前生效的配置（没设过时是一份全空的，即纯环境变量/默认行为）；
    // 就地改它的字段也算生效。
    public static FfOptions Current() {
        if (FfOptions.current == null) {
            FfOptions.current = new FfOptions();
        }
        return FfOptions.current;
    }

    // 显式配置优先，其次环境变量，都没有则 ""。
    public static string Pick(string configured, string envName) {
        if (configured != "") { return configured; }
        return Interop.EnvVar(envName);
    }

    // 生效的 Firefox 可执行路径（<see cref="exePath"/> 或 ZAN_FF_EXE）。
    public static string ExePath() {
        return FfOptions.Pick(FfOptions.Current().exePath, "ZAN_FF_EXE");
    }

    // 生效的 profile 根目录（<see cref="profileRoot"/> 或
    // ZAN_FF_PROFILE_ROOT），空串表示用平台缓存根。
    public static string ProfileRoot() {
        return FfOptions.Pick(FfOptions.Current().profileRoot,
                              "ZAN_FF_PROFILE_ROOT");
    }

    // 生效的 Marionette 端口（<see cref="port"/> 或 ZAN_FF_PORT），
    // 0 = 自动挑空闲端口。
    public static int Port() {
        string env = Interop.EnvVar("ZAN_FF_PORT");
        if (FfOptions.Current().port > 0) { return FfOptions.Current().port; }
        if (env != "") { return env.ToInt32(); }
        return 0;
    }

    // 是否保留 Firefox 自带工具栏（<see cref="showChrome"/>；环境变量
    // ZAN_FF_CHROME=1 可从外部打开，不能从外部关掉已显式打开的）。
    public static bool ShowChrome() {
        if (FfOptions.Current().showChrome) { return true; }
        return Interop.EnvVar("ZAN_FF_CHROME") == "1";
    }

    // 生效的追加参数（<see cref="extraArgs"/> 或 ZAN_FF_ARGS）。
    public static string ExtraArgs() {
        return FfOptions.Pick(FfOptions.Current().extraArgs, "ZAN_FF_ARGS");
    }
}
