using System;
using Gui;

namespace Gui.Component.FirefoxBrowser;

/// <summary>
/// 可摆放的火狐 Gecko 浏览器控件：把原生 Gecko 视口包成一个普通的保留式 Control。
/// 支持嵌入多标签页容器（Tabs）、面板布局（Panel）、设计器属性与 AI 智能体直接调用。
/// </summary>
public class FirefoxBrowserBox : Control {
    public FirefoxBrowser view;
    public string startUrl;
    public bool navigated;

    public FirefoxBrowserBox(int userContextId, FingerprintProfile profile) {
        this.InitControl("firefoxbrowser", 5);
        this.view = new FirefoxBrowser(userContextId, profile);
        this.startUrl = "";
        this.navigated = false;
    }

    public FirefoxBrowserBox(int userContextId) : this(userContextId, null) { }

    public FirefoxBrowserBox(string url) : this(0, null) {
        this.startUrl = url;
    }

    public FirefoxBrowserBox() : this(0, null) { }

    public FirefoxBrowser View() {
        return this.view;
    }

    public FirefoxAgentTab GetAgent() {
        return this.view.GetAgent();
    }

    public void SetStartUrl(string u) {
        this.startUrl = u;
        if (this.navigated && u != "") {
            this.view.Navigate(u);
        }
    }

    public string StartUrl() {
        return this.startUrl;
    }

    public void Navigate(string target) {
        this.navigated = true;
        this.view.Navigate(target);
    }

    public void Back() { this.view.Back(); }
    public void Forward() { this.view.Forward(); }
    public void Reload() { this.view.Reload(); }
    public void Hide() { this.view.Hide(); }

    public void Destroy() {
        this.view.Destroy();
        if (this.parent != null) {
            this.parent.Remove(this);
        }
    }

    public string CurrentUrl() { return this.view.CurrentUrl(); }
    public string CurrentTitle() { return this.view.CurrentTitle(); }
    public bool CanGoBack() { return this.view.CanGoBack(); }
    public bool CanGoForward() { return this.view.CanGoForward(); }

    public override string Kind() { return "FirefoxBrowserBox"; }

    public override void OnPaint(App app) {
        if (this.bw <= 0 || this.bh <= 0) {
            this.view.Hide();
            return;
        }
        if (!this.navigated && this.startUrl != "") {
            this.navigated = true;
            this.view.Navigate(this.startUrl);
        }
        this.view.Render(app, this.bx, this.by, this.bw, this.bh);
    }
}
