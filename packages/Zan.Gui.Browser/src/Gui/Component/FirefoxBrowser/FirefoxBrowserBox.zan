using System;
using Gui;
using Gui.Component;

namespace Gui.Component.FirefoxBrowser;

// 可摆放的火狐 Gecko 浏览器控件（继承三引擎共享外壳 BrowserBoxBase）。
public class FirefoxBrowserBox : BrowserBoxBase {
    public override Control CreateCloneShell() { return new FirefoxBrowserBox(); }
    public FirefoxBrowser view;

    public FirefoxBrowserBox(int userContextId, FingerprintProfile profile, GeckoViewConfig config) {
        this.InitBrowserBox("firefoxbrowser");
        this.view = new FirefoxBrowser(userContextId, profile, config);
    }

    public FirefoxBrowserBox(int userContextId, FingerprintProfile profile)
        : this(userContextId, profile, GeckoViewConfig.CreateDefault()) { }

    public FirefoxBrowserBox(int userContextId) : this(userContextId, null) { }

    public FirefoxBrowserBox(string url) : this(0, null) {
        this.startUrl = url != null ? url : "";
    }

    public FirefoxBrowserBox() : this(0, null) { }

    public override IBrowserView BrowserView() { return this.view; }
    public FirefoxBrowser View() { return this.view; }
    public FirefoxAgentTab GetAgent() { return this.view != null ? this.view.GetAgent() : null; }

    public void SyncBounds(App app) {
        if (this.bw > 0 && this.bh > 0) {
            this.UpdateBrowser(app);
        }
    }
}
