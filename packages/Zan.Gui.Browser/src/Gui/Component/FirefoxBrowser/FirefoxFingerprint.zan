using System;
using System.IO;
using System.Collections.Generic;
using System.Text;

namespace Gui.Component.FirefoxBrowser;

/// <summary>
/// 硬件指纹防关联档案 (FingerprintProfile)
/// 提供开箱即用、链式按需装配的防关联环境
/// </summary>
public class FingerprintProfile {
    public bool enabled;
    public int seed;
    public bool canvasNoise;
    public bool audioNoise;
    public int hardwareConcurrency;
    public int deviceMemory;
    public int screenWidth;
    public int screenHeight;
    public int screenAvailWidth;
    public int screenAvailHeight;
    public double devicePixelRatio;
    public int colorDepth;
    public int pixelDepth;
    public string language;
    public List<string> languages;
    public string timezone;
    public int timezoneOffset;
    public string webglVendor;
    public string webglRenderer;
    public string userAgent;
    public string platform;
    public string proxyServer;
    public string proxyType;
    public string proxyUsername;
    public string proxyPassword;
    public string customUserPrefs;

    public FingerprintProfile() {
        this.enabled = true;
        this.seed = 1000001;
        this.canvasNoise = true;
        this.audioNoise = true;
        this.hardwareConcurrency = 16;
        this.deviceMemory = 8;
        this.screenWidth = 1920;
        this.screenHeight = 1080;
        this.screenAvailWidth = 1920;
        this.screenAvailHeight = 1040;
        this.devicePixelRatio = 1.0;
        this.colorDepth = 24;
        this.pixelDepth = 24;
        this.language = "en-US";
        this.languages = new List<string>();
        this.languages.Add("en-US");
        this.languages.Add("en");
        this.timezone = "America/New_York";
        this.timezoneOffset = 240;
        this.webglVendor = "Google Inc. (NVIDIA)";
        this.webglRenderer = "ANGLE (NVIDIA, NVIDIA GeForce RTX 3070 Direct3D11 vs_5_0 ps_5_0, D3D11-30.0.14.7141)";
        this.userAgent = "";
        this.platform = "Win32";
        this.proxyServer = "";
        this.proxyType = "socks5";
        this.proxyUsername = "";
        this.proxyPassword = "";
        this.customUserPrefs = "";
    }

    public FingerprintProfile WithSeed(int s) {
        this.seed = s;
        return this;
    }

    public FingerprintProfile WithHardware(int cores, int memGb) {
        this.hardwareConcurrency = cores;
        this.deviceMemory = memGb;
        return this;
    }

    public FingerprintProfile WithScreen(int w, int h, double dpr) {
        this.screenWidth = w;
        this.screenHeight = h;
        this.screenAvailWidth = w;
        this.screenAvailHeight = (h > 40) ? (h - 40) : h;
        this.devicePixelRatio = dpr;
        return this;
    }

    public FingerprintProfile WithLocale(string lang, List<string> langs) {
        string safeLang = lang != null ? lang : "";
        this.language = safeLang;
        if (langs != null && langs.Count > 0) {
            this.languages = langs;
        } else {
            this.languages = new List<string>();
            this.languages.Add(safeLang);
        }
        return this;
    }

    public FingerprintProfile WithTimezone(string tz, int offsetMinutes) {
        this.timezone = tz != null ? tz : "";
        this.timezoneOffset = offsetMinutes;
        return this;
    }

    public FingerprintProfile WithWebGL(string vendor, string renderer) {
        this.webglVendor = vendor != null ? vendor : "";
        this.webglRenderer = renderer != null ? renderer : "";
        return this;
    }

    public FingerprintProfile WithUserAgent(string ua, string plat) {
        this.userAgent = ua != null ? ua : "";
        if (plat != null && plat != "") {
            this.platform = plat;
        }
        return this;
    }

    public FingerprintProfile WithProxy(string server, string proto = "socks5", string user = "", string pass = "") {
        this.proxyServer = server != null ? server : "";
        this.proxyType = (proto != null && proto != "") ? proto : "socks5";
        this.proxyUsername = user != null ? user : "";
        this.proxyPassword = pass != null ? pass : "";
        return this;
    }

    public FingerprintProfile WithCustomPrefs(string prefs) {
        this.customUserPrefs = prefs != null ? prefs : "";
        return this;
    }

    public static FingerprintProfile CleanDefault() {
        FingerprintProfile p = new FingerprintProfile();
        p.enabled = false;
        p.canvasNoise = false;
        p.audioNoise = false;
        return p;
    }

    public static FingerprintProfile GenerateForStore(int storeId) {
        FingerprintProfile p = new FingerprintProfile();
        p.seed = 1000000 + storeId * 107;
        p.hardwareConcurrency = (storeId % 2 == 0) ? 8 : 16;
        p.deviceMemory = (storeId % 2 == 0) ? 16 : 8;
        if (storeId % 3 == 0) {
            p.screenWidth = 2560;
            p.screenHeight = 1440;
            p.screenAvailWidth = 2560;
            p.screenAvailHeight = 1400;
            p.devicePixelRatio = 1.25;
        } else {
            p.screenWidth = 1920;
            p.screenHeight = 1080;
            p.screenAvailWidth = 1920;
            p.screenAvailHeight = 1040;
            p.devicePixelRatio = 1.0;
        }
        if (storeId % 2 == 1) {
            p.timezone = "America/Los_Angeles";
            p.timezoneOffset = 420;
        } else {
            p.timezone = "America/New_York";
            p.timezoneOffset = 240;
        }
        return p;
    }

    static void AppendJsonStr(StringBuilder sb, string v) {
        sb.Append("\"");
        if (v != null) { Encoding.JsonEscapeTo(sb, v); }
        sb.Append("\"");
    }

    public string ToJson() {
        string dprStr = "1.0";
        if (this.devicePixelRatio == 1.0) { dprStr = "1.0"; }
        else if (this.devicePixelRatio == 1.25) { dprStr = "1.25"; }
        else if (this.devicePixelRatio == 1.5) { dprStr = "1.5"; }
        else if (this.devicePixelRatio == 2.0) { dprStr = "2.0"; }
        else if (this.devicePixelRatio > 0.0 && this.devicePixelRatio < 100.0) {
            dprStr = Convert.ToString(this.devicePixelRatio);
        }

        StringBuilder sb = new StringBuilder();
        sb.Append("{\"enabled\":"); sb.Append(this.enabled ? "true" : "false");
        sb.Append(",\"seed\":"); sb.Append(this.seed.ToString());
        sb.Append(",\"canvasNoise\":"); sb.Append(this.canvasNoise ? "true" : "false");
        sb.Append(",\"audioNoise\":"); sb.Append(this.audioNoise ? "true" : "false");
        sb.Append(",\"hardwareConcurrency\":"); sb.Append(this.hardwareConcurrency.ToString());
        sb.Append(",\"deviceMemory\":"); sb.Append(this.deviceMemory.ToString());
        sb.Append(",\"screenWidth\":"); sb.Append(this.screenWidth.ToString());
        sb.Append(",\"screenHeight\":"); sb.Append(this.screenHeight.ToString());
        sb.Append(",\"screenAvailWidth\":"); sb.Append(this.screenAvailWidth.ToString());
        sb.Append(",\"screenAvailHeight\":"); sb.Append(this.screenAvailHeight.ToString());
        sb.Append(",\"devicePixelRatio\":"); sb.Append(dprStr);
        sb.Append(",\"colorDepth\":"); sb.Append(this.colorDepth.ToString());
        sb.Append(",\"pixelDepth\":"); sb.Append(this.pixelDepth.ToString());
        sb.Append(",\"language\":"); AppendJsonStr(sb, this.language);
        sb.Append(",\"languages\":[");
        if (this.languages != null) {
            for (int i = 0; i < this.languages.Count; i = i + 1) {
                if (i > 0) { sb.Append(","); }
                AppendJsonStr(sb, this.languages[i]);
            }
        }
        sb.Append("],\"timezone\":"); AppendJsonStr(sb, this.timezone);
        sb.Append(",\"timezoneOffset\":"); sb.Append(this.timezoneOffset.ToString());
        sb.Append(",\"webglVendor\":"); AppendJsonStr(sb, this.webglVendor);
        sb.Append(",\"webglRenderer\":"); AppendJsonStr(sb, this.webglRenderer);
        sb.Append(",\"userAgent\":"); AppendJsonStr(sb, this.userAgent);
        sb.Append(",\"platform\":"); AppendJsonStr(sb, this.platform);
        sb.Append("}");
        return sb.ToString();
    }
}

/// <summary>
/// 浏览器视图全维度运行与性能高级配置 (对应底层 C-ABI GeckoViewConfig)
/// </summary>
public struct GeckoViewConfig {
    public uint structSize;
    public bool headless;
    public bool enableWebrtc;
    public bool enableImages;
    public bool enableJavascript;
    public bool muteAudio;
    public bool antiThrottling;
    public int minBackgroundTimeoutMs;
    public int frameRate;
    public int memoryCacheMb;
    public int diskCacheMb;
    public int surfaceCacheKb;
    public int processCount;
    public bool disableBatteryApi;
    public bool disableFontsEnumeration;
    public string proxyServer;
    public string proxyType;
    public string proxyUsername;
    public string proxyPassword;
    public string customUserPrefs;
    public string customCliArgs;
    public nint fpConfig;

    /// <summary>
    /// 获取默认自洽配置 (防关联、极速调度、单进程紧凑)
    /// </summary>
    public static GeckoViewConfig CreateDefault() {
        GeckoViewConfig c = new GeckoViewConfig();
        c.structSize = 96;
        c.headless = false;
        c.enableWebrtc = false;
        c.enableImages = true;
        c.enableJavascript = true;
        c.muteAudio = false;
        c.antiThrottling = true;
        c.minBackgroundTimeoutMs = 4;
        c.frameRate = 60;
        c.memoryCacheMb = 16;
        c.diskCacheMb = 50;
        c.surfaceCacheKb = 65536;
        c.processCount = 1;
        c.disableBatteryApi = true;
        c.disableFontsEnumeration = true;
        c.proxyServer = "";
        c.proxyType = "socks5";
        c.proxyUsername = "";
        c.proxyPassword = "";
        c.customUserPrefs = "";
        c.customCliArgs = "";
        c.fpConfig = 0;
        return c;
    }
}
