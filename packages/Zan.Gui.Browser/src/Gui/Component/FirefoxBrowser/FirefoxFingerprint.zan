using System;
using System.IO;

namespace Gui.Component.FirefoxBrowser;

/// <summary>
/// 硬件指纹防关联档案 (FingerprintProfile)
/// 提供开箱即用、链式按需装配的防关联环境
/// </summary>
public class FingerprintProfile {
    public bool enabled;
    public int seed;
    public bool canvasNoise;
    public bool audioNoise;
    public int hardwareConcurrency;
    public int deviceMemory;
    public int screenWidth;
    public int screenHeight;
    public int screenAvailWidth;
    public int screenAvailHeight;
    public double devicePixelRatio;
    public int colorDepth;
    public int pixelDepth;
    public string language;
    public List<string> languages;
    public string timezone;
    public int timezoneOffset;
    public string webglVendor;
    public string webglRenderer;
    public string userAgent;
    public string platform;

    public FingerprintProfile() {
        this.enabled = true;
        this.seed = 1000001;
        this.canvasNoise = true;
        this.audioNoise = true;
        this.hardwareConcurrency = 16;
        this.deviceMemory = 8;
        this.screenWidth = 1920;
        this.screenHeight = 1080;
        this.screenAvailWidth = 1920;
        this.screenAvailHeight = 1040;
        this.devicePixelRatio = 1.0;
        this.colorDepth = 24;
        this.pixelDepth = 24;
        this.language = "en-US";
        this.languages = new List<string>();
        this.languages.Add("en-US");
        this.languages.Add("en");
        this.timezone = "America/New_York";
        this.timezoneOffset = 240;
        this.webglVendor = "Google Inc. (NVIDIA)";
        this.webglRenderer = "ANGLE (NVIDIA, NVIDIA GeForce RTX 3070 Direct3D11 vs_5_0 ps_5_0, D3D11-30.0.14.7141)";
        this.userAgent = "";
        this.platform = "Win32";
    }

    public FingerprintProfile WithSeed(int s) {
        this.seed = s;
        return this;
    }

    public FingerprintProfile WithHardware(int cores, int memGb) {
        this.hardwareConcurrency = cores;
        this.deviceMemory = memGb;
        return this;
    }

    public FingerprintProfile WithScreen(int w, int h, double dpr) {
        this.screenWidth = w;
        this.screenHeight = h;
        this.screenAvailWidth = w;
        this.screenAvailHeight = (h > 40) ? (h - 40) : h;
        this.devicePixelRatio = dpr;
        return this;
    }

    public FingerprintProfile WithLocale(string lang, List<string> langs) {
        this.language = lang;
        if (langs != null && langs.Count > 0) {
            this.languages = langs;
        } else {
            this.languages = new List<string>();
            this.languages.Add(lang);
        }
        return this;
    }

    public FingerprintProfile WithTimezone(string tz, int offsetMinutes) {
        this.timezone = tz;
        this.timezoneOffset = offsetMinutes;
        return this;
    }

    public FingerprintProfile WithWebGL(string vendor, string renderer) {
        this.webglVendor = vendor;
        this.webglRenderer = renderer;
        return this;
    }

    public FingerprintProfile WithUserAgent(string ua, string plat) {
        this.userAgent = ua;
        if (plat != null && plat != "") {
            this.platform = plat;
        }
        return this;
    }

    public static FingerprintProfile CleanDefault() {
        FingerprintProfile p = new FingerprintProfile();
        p.enabled = false;
        p.canvasNoise = false;
        p.audioNoise = false;
        return p;
    }

    public static FingerprintProfile GenerateForStore(int storeId) {
        FingerprintProfile p = new FingerprintProfile();
        p.seed = 1000000 + storeId * 107;
        p.hardwareConcurrency = (storeId % 2 == 0) ? 8 : 16;
        p.deviceMemory = (storeId % 2 == 0) ? 16 : 8;
        if (storeId % 3 == 0) {
            p.screenWidth = 2560;
            p.screenHeight = 1440;
            p.screenAvailWidth = 2560;
            p.screenAvailHeight = 1400;
            p.devicePixelRatio = 1.25;
        } else {
            p.screenWidth = 1920;
            p.screenHeight = 1080;
            p.screenAvailWidth = 1920;
            p.screenAvailHeight = 1040;
            p.devicePixelRatio = 1.0;
        }
        if (storeId % 2 == 1) {
            p.timezone = "America/Los_Angeles";
            p.timezoneOffset = 420;
        } else {
            p.timezone = "America/New_York";
            p.timezoneOffset = 240;
        }
        return p;
    }

    public string ToJson() {
        string langsJson = "[";
        if (this.languages != null) {
            for (int i = 0; i < this.languages.Count; i = i + 1) {
                if (i > 0) langsJson = langsJson + ",";
                langsJson = langsJson + "\"" + this.languages[i] + "\"";
            }
        }
        langsJson = langsJson + "]";

        string dprStr = (this.devicePixelRatio == 1.0) ? "1.0" :
                        (this.devicePixelRatio == 1.25) ? "1.25" :
                        (this.devicePixelRatio == 1.5) ? "1.5" :
                        (this.devicePixelRatio == 2.0) ? "2.0" : "1.0";

        return "{" +
            "\"enabled\":" + (this.enabled ? "true" : "false") + "," +
            "\"seed\":" + this.seed.ToString() + "," +
            "\"canvasNoise\":" + (this.canvasNoise ? "true" : "false") + "," +
            "\"audioNoise\":" + (this.audioNoise ? "true" : "false") + "," +
            "\"hardwareConcurrency\":" + this.hardwareConcurrency.ToString() + "," +
            "\"deviceMemory\":" + this.deviceMemory.ToString() + "," +
            "\"screenWidth\":" + this.screenWidth.ToString() + "," +
            "\"screenHeight\":" + this.screenHeight.ToString() + "," +
            "\"screenAvailWidth\":" + this.screenAvailWidth.ToString() + "," +
            "\"screenAvailHeight\":" + this.screenAvailHeight.ToString() + "," +
            "\"devicePixelRatio\":" + dprStr + "," +
            "\"colorDepth\":" + this.colorDepth.ToString() + "," +
            "\"pixelDepth\":" + this.pixelDepth.ToString() + "," +
            "\"language\":\"" + this.language + "\"," +
            "\"languages\":" + langsJson + "," +
            "\"timezone\":\"" + this.timezone + "\"," +
            "\"timezoneOffset\":" + this.timezoneOffset.ToString() + "," +
            "\"webglVendor\":\"" + this.webglVendor + "\"," +
            "\"webglRenderer\":\"" + this.webglRenderer + "\"," +
            "\"userAgent\":\"" + this.userAgent + "\"," +
            "\"platform\":\"" + this.platform + "\"" +
        "}";
    }
}
