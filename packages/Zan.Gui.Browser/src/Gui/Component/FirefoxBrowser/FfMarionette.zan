using System;
using System.Json;
using System.Net.Sockets;

namespace Gui.Component.FirefoxBrowser;

// Firefox 内置的 Marionette 远程控制协议客户端（-marionette 打开，
// 默认监听 127.0.0.1:marionette.port）。
// 帧格式是 Marionette protocol 3：`<十进制长度>:<JSON 文本>`。连接建立后
// 服务器先发一帧握手 `{"applicationType":"gecko","marionetteProtocol":3}`；
// 之后客户端发 `[0,<id>,"<命令名>",<参数对象或null>]`，服务器回
// `[1,<id>,<错误对象或null>,<结果>]`。
// 本类只允许在 FfHost 的后台工作线程上使用——TcpClient 的同步收发是
// 阻塞语义，不能进 UI 帧循环；UI 线程只读 FfInstance 的互斥快照。
public class FfMarionette {
    public TcpClient sock;
    // 收流缓冲：一帧可能被 TCP 拆成多次 Recv，也可能一次 Recv 带出
    // 多帧，这里攒着按帧切。
    public string pending;
    public int nextId;
    public string lastError;
    // WebDriver 会话 id（NewSession 建立；Firefox 重启后要重建）。
    public string sessionId;

    // 连接 127.0.0.1:port 并完成握手。Firefox 要到主窗口阶段才监听
    // 端口，所以在 timeoutMs 内反复重试。失败返回 null（lastError 说明
    // 原因）。
    public static FfMarionette Connect(int port, int timeoutMs) {
        Stopwatch sw = Stopwatch.StartNew();
        string err = "";
        while (sw.ElapsedMilliseconds() < timeoutMs) {
            // 不走 TcpClient.Connect：它忽略连接失败码（被拒绝也返回
            // connected 对象），死 socket 上的同步 Recv 会永久阻塞。
            // 直接用 Socket.Connect 的返回值判断成败。
            Socket.Initialize();
            nint s = Socket.CreateTcp();
            int rc = Socket.Connect(s, "127.0.0.1", port);
            if (rc != 0) {
                Socket.Close(s);
                Thread.Sleep(150);
                continue;
            }
            FfMarionette m = new FfMarionette();
            m.sock = TcpClient.FromSocket(s);
            m.pending = "";
            m.nextId = 1;
            m.lastError = "";
            m.sessionId = "";
            // 握手帧：内容目前只有 applicationType/marionetteProtocol，
            // 读掉即可。同步 Connect 不校验连接结果（被拒绝也返回
            // connected），握手读帧正好把死连接验出来：失败就关掉重试。
            string hello = m.ReadFrame(2000);
            if (hello == null) {
                m.Close();
                Thread.Sleep(150);
                continue;
            }
            // 裸 Marionette 没有 geckodriver 代劳，WebDriver:* 命令前要
            // 自己建会话（geckodriver 的 HTTP 端点翻译的就是这一条）。
            if (!m.NewSession()) {
                m.Close();
                Thread.Sleep(150);
                continue;
            }
            return m;
        }
        if (err != "") { FfMarionette.staticError = "连接失败：" + err; }
        else { FfMarionette.staticError = "连接超时（Firefox 未在监听 Marionette 端口）"; }
        return null;
    }

    // Connect 失败时给全局的说明（供 FfHost 写进 inst.error）。
    public static string staticError = "";

    // 已连接且未被对端关闭。
    public bool IsAlive() {
        return this.sock != null && this.sock.IsConnected();
    }

    // 建 WebDriver 会话（裸 Marionette 直连时必须，geckodriver 平时
    // 代劳的就是这一条）。成功记 sessionId。
    public bool NewSession() {
        JsonValue r = this.Command("WebDriver:NewSession", "{}");
        if (r == null) { return false; }
        JsonValue sid = r.Get("sessionId");
        this.sessionId = sid != null ? sid.AsString("") : "";
        return true;
    }

    // 发命令并等回复。失败返回 null（lastError 说明原因）。
    // paramsJson 为 "" 时发送 null 参数。会话因 Firefox 重启等原因
    // 失效时（"session does not exist"）自动重建会话并重试一次。
    public JsonValue Command(string name, string paramsJson) {
        JsonValue r = this.CommandOnce(name, paramsJson);
        if (r == null && this.lastError.IndexOf("session does not exist") >= 0) {
            if (this.NewSession()) {
                r = this.CommandOnce(name, paramsJson);
            }
        }
        return r;
    }

    // Command 的单次尝试（无会话重建）。
    JsonValue CommandOnce(string name, string paramsJson) {
        if (!this.IsAlive()) {
            this.lastError = "连接已断开";
            return null;
        }
        if (paramsJson == "") { paramsJson = "null"; }
        string payload = "[0," + this.nextId + ",\"" + name + "\"," + paramsJson + "]";
        this.nextId = this.nextId + 1;
        string frame = payload.Length + ":" + payload;
        int sent = 0;
        try {
            sent = this.sock.Send(frame);
        } catch (SocketException e) {
            this.lastError = "发送失败：" + e.Message;
            return null;
        }
        if (sent <= 0) {
            this.lastError = "发送失败（连接已断）";
            return null;
        }
        while (true) {
            string resp = this.ReadFrame(30000);
            if (resp == null) {
                if (this.lastError == "") { this.lastError = "等待回复超时"; }
                return null;
            }
            JsonValue arr = JsonValue.ParseOrStr(resp);
            if (!arr.IsArray() || arr.Count() < 4) {
                this.lastError = "坏帧：" + resp;
                return null;
            }
            // 只认 [1, id, ...] 的回复帧；遇到别的（极少见的事件帧）跳过。
            if (arr.At(0).AsInt(0) != 1) { continue; }
            JsonValue error = arr.At(2);
            if (!error.IsNull()) {
                JsonValue msgVal = error.Get("message");
                string msg = msgVal != null ? msgVal.AsString("") : "";
                if (msg == "") {
                    JsonValue errVal = error.Get("error");
                    msg = errVal != null ? errVal.AsString("unknown") : "unknown";
                }
                this.lastError = msg;
                return null;
            }
            this.lastError = "";
            return arr.At(3);
        }
    }

    // ---- 常用命令的薄包装 ----------------------------------------------
    // 裸 Marionette 的回复载荷形态不统一：标量结果多带老 JSON-wire 的
    // {"value":...} 包装（GetCurrentURL/GetTitle/ExecuteScript），数组与
    // 对象结果直接就是载荷本体（GetWindowHandles/NewSession）。以下
    // 取值助手两种形态都接。

    // 安全取结果：字符串本体或 {"value":...} 包装都认。
    static string ValueStr(JsonValue r, string dflt) {
        if (r == null) { return dflt; }
        if (r.IsString()) { return r.AsString(dflt); }
        JsonValue v = r.Get("value");
        if (v == null) { return dflt; }
        return v.AsString(dflt);
    }

    // 当前 URL。失败 ""。
    public string GetUrl() {
        return FfMarionette.ValueStr(this.Command("WebDriver:GetCurrentURL", ""), "");
    }

    // 当前文档标题。失败 ""。
    public string GetTitle() {
        return FfMarionette.ValueStr(this.Command("WebDriver:GetTitle", ""), "");
    }

    // 导航当前窗口到 url。
    public bool Navigate(string url) {
        JsonValue p = JsonValue.NewObject();
        p.PutStr("url", url);
        return this.Command("WebDriver:Navigate", p.ToJson()) != null;
    }

    public bool Back() { return this.Command("WebDriver:Back", "") != null; }
    public bool Forward() { return this.Command("WebDriver:Forward", "") != null; }
    public bool Refresh() { return this.Command("WebDriver:Refresh", "") != null; }

    // 停止当前加载（等价地址栏的 X）：没有任何 WebDriver 命令对应，
    // 用 page 载入 data:blank 打断不可取——改为窗口级 stop：
    // Marionette 没有直接命令，v1 退化为 no-op（页面加载通常很快）。
    public bool Stop() { return false; }

    // 当前窗口的 document.readyState。
    public string ReadyState() {
        JsonValue p = JsonValue.NewObject();
        p.PutStr("script", "return document.readyState;");
        JsonValue r = this.Command("WebDriver:ExecuteScript", p.ToJson());
        return FfMarionette.ValueStr(r, "");
    }

    // 页内执行 JS，返回其 JSON 序列化结果（失败 null）。可能是
    // {"value":...} 包装或本体。
    public JsonValue ExecuteScript(string code) {
        JsonValue p = JsonValue.NewObject();
        p.PutStr("script", code);
        JsonValue r = this.Command("WebDriver:ExecuteScript", p.ToJson());
        if (r == null) { return null; }
        JsonValue v = r.Get("value");
        return v != null ? v : r;
    }

    // 所有顶层窗口句柄（回复可能是裸数组或 {"value":[...]} 包装）。
    public List<string> WindowHandles() {
        List<string> outp = new List<string>();
        JsonValue r = this.Command("WebDriver:GetWindowHandles", "");
        if (r == null) { return outp; }
        JsonValue v = r;
        if (!v.IsArray()) {
            JsonValue w = r.Get("value");
            if (w == null || !w.IsArray()) { return outp; }
            v = w;
        }
        for (int i = 0; i < v.Count(); i = i + 1) {
            outp.Add(v.At(i).AsString(""));
        }
        return outp;
    }

    // 把命令上下文切到指定窗口（参数名是 handle，不是 name）。
    public bool SwitchToWindow(string handle) {
        JsonValue p = JsonValue.NewObject();
        p.PutStr("handle", handle);
        return this.Command("WebDriver:SwitchToWindow", p.ToJson()) != null;
    }

    // 关闭当前窗口（用于收尾，避免留下 Firefox 进程）。
    public void CloseWindow() {
        this.Command("WebDriver:CloseWindow", "");
    }

    // ---- 流式读帧 ------------------------------------------------------

    // 读一帧 JSON 文本；timeoutMs 内凑不齐或对端关闭返回 null。
    // Zan 的同步 Recv 没有截止时间参数，这里用「先轮询再读」近似：
    // 连接本地回环、服务器必然回帧，真实场景要么立刻有数据要么连接
    // 已死；阻塞 recv 在死连接上会被对端 FIN 唤醒，不会永久挂起
    // （Firefox 崩溃时内核关闭套接字）。超时是防御性的：给一半时间
    // 轮询缓冲，凑不齐就放弃本次等待。
    public string ReadFrame(int timeoutMs) {
        Stopwatch sw = Stopwatch.StartNew();
        while (true) {
            string frame = FfMarionette.TakeFrame(this.pending);
            if (frame != null) {
                this.pending = FfMarionette.restPending;
                return frame;
            }
            if (sw.ElapsedMilliseconds() > timeoutMs) {
                return null;
            }
            string chunk = "";
            try {
                chunk = this.sock.Recv(65536);
            } catch (SocketException e) {
                this.lastError = "接收失败：" + e.Message;
                return null;
            }
            if (chunk == null || chunk.Length == 0) {
                this.lastError = "连接已关闭";
                return null;
            }
            this.pending = this.pending + chunk;
        }
    }

    // TakeFrame 的跨调用剩余缓冲（Zan 无出参，用静态字段带出；
    // 本类只在单个工作线程上使用，无并发问题）。
    public static string restPending = "";

    // 从缓冲里切出第一帧：`<len>:<payload>`。凑不齐返回 null。
    static string TakeFrame(string buf) {
        int colon = buf.IndexOf(":");
        if (colon <= 0) { return null; }
        int len = buf.Substring(0, colon).ToInt32();
        if (len <= 0) { return null; }
        if (buf.Length < colon + 1 + len) { return null; }
        FfMarionette.restPending = buf.Substring(colon + 1 + len,
                                                 buf.Length - colon - 1 - len);
        return buf.Substring(colon + 1, len);
    }

    // 关闭连接。
    public void Close() {
        if (this.sock != null) {
            this.sock.Close();
            this.sock = null;
        }
        this.pending = "";
    }
}
