using System;
using Gui;
using Gui.Component;
using Gui.Widget;

namespace Gui.Component.FirefoxBrowser;

/// <summary>
/// 火狐 Gecko 进程内嵌入式浏览器对象
/// 承载 C-ABI 视口句柄、生命周期、智能体代理与渲染裁剪
/// </summary>
public class FirefoxBrowser {
    public BrowserNativeEntry nativeEntry;
    string nativeTarget = "";
    string nativeHtml = "";
    string nativeBase = "";
    int nativeRevision;
    bool nativeDestroyed;

    public BrowserNativeEntry AttachNative(App app, Control box) {
        if (nativeDestroyed || app == null || !app.isRunning) { return null; }
        if (nativeEntry != null && !nativeEntry.retired && nativeEntry.loop != null
            && nativeEntry.loop.host == app) {
            if (box != null) { nativeEntry.AttachBox(box); }
            return nativeEntry;
        }
        if (nativeEntry != null && !nativeEntry.retired) { nativeEntry.Retire(app); }
        BrowserNativeLoop service = BrowserNativeLoop.For(app);
        BrowserNativeEntry entry = new BrowserNativeEntry();
        entry.engine = 3;
        entry.firefox = this;
        entry.loop = service;
        if (box != null) { entry.AttachBox(box); }
        nativeEntry = entry;
        service.Add(entry);
        return entry;
    }

    public void ReleaseNative() {
        nativeRevision = nativeRevision + 1;
        if (handle != 0) {
            this.Hide();
            if (viewId > 0) { NativeLayer.Forget(viewId); }
            if (FirefoxCore.PfnDestroy != 0) { GeckoActionFn destroy = (GeckoActionFn)FirefoxCore.PfnDestroy; destroy(handle); }
        }
        handle = 0; viewId = 0; created = false; agent = null;
        if (nativeEntry != null) { nativeEntry.ForgetHandle(); }
    }

    public nint handle;
    public int contextId;
    public FingerprintProfile fingerprint;
    public GeckoViewConfig viewConfig;
    public string initialUrl;

    public UiEvent NavStart;
    public UiEvent NavComplete;
    public UiEvent TitleChanged;
    public UiEvent LoadingChanged;

    FirefoxAgentTab agent;
    bool created;
    public int viewId;
    string pendingUrl;
    string lastTitle;
    string lastUrl;
    int lastX;
    int lastY;
    int lastW;
    int lastH;
    bool lastVisible;
    int boundSyncFrames;

    public FirefoxBrowser(int userContextId, FingerprintProfile profile, GeckoViewConfig config) {
        this.handle = 0;
        this.contextId = userContextId;
        this.fingerprint = (profile != null) ? profile : FingerprintProfile.CleanDefault();
        this.viewConfig = config;
        this.initialUrl = "";
        this.pendingUrl = "";
        this.lastTitle = "";
        this.lastUrl = "";
        this.created = false;
        this.lastX = -1;
        this.lastY = -1;
        this.lastW = -1;
        this.lastH = -1;
        this.lastVisible = false;
        this.boundSyncFrames = 0;

        this.NavStart = new UiEvent();
        this.NavComplete = new UiEvent();
        this.TitleChanged = new UiEvent();
        this.LoadingChanged = new UiEvent();
    }

    public FirefoxBrowser(int userContextId, FingerprintProfile profile) : this(userContextId, profile, GeckoViewConfig.CreateDefault()) { }

    public FirefoxBrowser() : this(0, null, GeckoViewConfig.CreateDefault()) { }

    public FirefoxAgentTab GetAgent() {
        if (this.agent == null && this.handle != 0) {
            this.agent = new FirefoxAgentTab(this.handle, this.contextId);
        }
        return this.agent;
    }

    public void Navigate(string target) {
        nativeTarget = target;
        nativeHtml = "";
        this.pendingUrl = target;
        if (this.handle != 0 && FirefoxCore.PfnNavigate != 0) {
            GeckoNavigateFn fn = (GeckoNavigateFn)FirefoxCore.PfnNavigate;
            fn(this.handle, target);
        }
    }

    public void Back() {
        if (this.handle != 0 && FirefoxCore.PfnGoBack != 0) {
            GeckoActionFn fn = (GeckoActionFn)FirefoxCore.PfnGoBack;
            fn(this.handle);
        }
    }

    public void Forward() {
        if (this.handle != 0 && FirefoxCore.PfnGoForward != 0) {
            GeckoActionFn fn = (GeckoActionFn)FirefoxCore.PfnGoForward;
            fn(this.handle);
        }
    }

    public void Reload() {
        if (this.handle != 0 && FirefoxCore.PfnReload != 0) {
            GeckoActionFn fn = (GeckoActionFn)FirefoxCore.PfnReload;
            fn(this.handle);
        }
    }

    public void Hide() {
        if (nativeEntry != null) { nativeEntry.RequestHide(); }
        if (this.viewId > 0) {
            FirefoxCore.ApplyClip(this.viewId, "");
        }
        if (this.handle != 0 && this.lastVisible) {
            this.lastVisible = false;
            if (FirefoxCore.PfnSetVisible != 0) {
                GeckoVisibleFn fn = (GeckoVisibleFn)FirefoxCore.PfnSetVisible;
                fn(this.handle, false);
            }
        }
    }

    public void Destroy() {
        nativeDestroyed = true;
        BrowserNativeEntry previous = nativeEntry;
        if (previous != null && !previous.retired) { previous.Retire(null); }
        else { this.ReleaseNative(); }
        nativeEntry = null;
    }

    public string CurrentUrl() {
        if (this.handle != 0 && FirefoxCore.PfnGetUrl != 0) {
            GeckoGetStringFn fn = (GeckoGetStringFn)FirefoxCore.PfnGetUrl;
            return fn(this.handle);
        }
        return this.pendingUrl;
    }

    public string CurrentTitle() {
        if (this.handle != 0 && FirefoxCore.PfnGetTitle != 0) {
            GeckoGetStringFn fn = (GeckoGetStringFn)FirefoxCore.PfnGetTitle;
            return fn(this.handle);
        }
        return "";
    }

    public bool CanGoBack() {
        if (this.handle != 0 && FirefoxCore.PfnCanGoBack != 0) {
            GeckoGetBoolFn fn = (GeckoGetBoolFn)FirefoxCore.PfnCanGoBack;
            return fn(this.handle);
        }
        return false;
    }

    public bool CanGoForward() {
        if (this.handle != 0 && FirefoxCore.PfnCanGoForward != 0) {
            GeckoGetBoolFn fn = (GeckoGetBoolFn)FirefoxCore.PfnCanGoForward;
            return fn(this.handle);
        }
        return false;
    }

    public void Render(App app, int x, int y, int w, int h) {
        if (app == null) { app = App.FrameApp(); }
        BrowserNativeEntry entry = this.AttachNative(app, null);
        if (entry != null) { entry.SetBounds(x, y, w, h); }
        this.Paint(app, x, y, w, h);
    }

    public void Update(App app, int x, int y, int w, int h) {
        this.PrepareNative(app, x, y, w, h);
        this.PollNative(app);
    }

    public void PrepareNative(App app, int x, int y, int w, int h) {
        if (!this.created) {
            this.EnsureCreated(app, x, y, w, h);
        }
        if (this.handle == 0) return;

        bool boundsChanged = (x != this.lastX || y != this.lastY || w != this.lastW || h != this.lastH);
        if (boundsChanged || this.boundSyncFrames < 180) {
            this.boundSyncFrames = this.boundSyncFrames + 1;
            this.lastX = x;
            this.lastY = y;
            this.lastW = w;
            this.lastH = h;
            if (FirefoxCore.PfnSetBounds != 0) {
                GeckoBoundsFn bfn = (GeckoBoundsFn)FirefoxCore.PfnSetBounds;
                bfn(this.handle, x, y, w, h);
            }
            if (this.viewId == 0 && FirefoxCore.PfnGetViewId != 0) {
                GeckoGetIntFn vidFn = (GeckoGetIntFn)FirefoxCore.PfnGetViewId;
                this.viewId = vidFn(this.handle);
            }
        }

        if (this.viewId <= 0) {
            if (!this.lastVisible) {
                this.lastVisible = true;
                if (FirefoxCore.PfnSetVisible != 0) {
                    GeckoVisibleFn vfn = (GeckoVisibleFn)FirefoxCore.PfnSetVisible;
                    vfn(this.handle, true);
                }
            }
        }

    }

    public void PollNative(App app) {
        if (nativeDestroyed || handle == 0) { return; }
        int generation = nativeRevision;
        nint expected = handle;
        string curT = this.CurrentTitle();
        if (curT != "" && curT != this.lastTitle) {
            this.lastTitle = curT;
            this.TitleChanged.Raise(); if (nativeRevision != generation || handle != expected || nativeDestroyed || (nativeEntry != null && !nativeEntry.IsCurrent(app))) { return; }
        }

        string curU = this.CurrentUrl();
        if (curU != "" && curU != this.lastUrl) {
            this.lastUrl = curU;
            this.NavComplete.Raise(); if (nativeRevision != generation || handle != expected || nativeDestroyed || (nativeEntry != null && !nativeEntry.IsCurrent(app))) { return; }
        }
        }

    public void Paint(App app, int x, int y, int w, int h) {
        if (nativeEntry != null && !nativeEntry.shown) { return; }
        if (app != null && this.handle != 0 && this.viewId > 0 && w > 0 && h > 0) {
            NativeLayer.Register(app, this.viewId, x, y, w, h, FirefoxCore.ApplyClip);
        }
    }

    void EnsureCreated(App app, int x, int y, int w, int h) {
        if (nativeDestroyed) { return; }
        if (app == null) { app = App.FrameApp(); }
        BrowserNativeEntry creationEntry = this.AttachNative(app, null);
        if (creationEntry == null) { return; }
        creationEntry.SetBounds(x, y, w, h);
        try {
        if (this.created) return;
        this.created = true;

        if (!FirefoxCore.EnsureLoaded()) return;

        nint parentHwnd = 0;
        if (app != null && app.window != null) {
            parentHwnd = app.window.GetHandle();
        }

        if (FirefoxCore.PfnInit != 0) {
            GeckoInitFn initFn = (GeckoInitFn)FirefoxCore.PfnInit;
            initFn(parentHwnd);
        }

        if (this.viewConfig.structSize > 0 && FirefoxCore.PfnCreateViewEx != 0) {
            GeckoCreateViewExFn cfn = (GeckoCreateViewExFn)FirefoxCore.PfnCreateViewEx;
            string profileDir = "profiles/store_" + this.contextId.ToString();
            this.handle = cfn(
                parentHwnd, x, y, w, h, profileDir, ref this.viewConfig
            );
            if (this.handle != 0 && this.pendingUrl != "") {
                this.Navigate(this.pendingUrl);
            }
        } else if (FirefoxCore.PfnCreateWithContext != 0) {
            GeckoCreateWithContextFn cfn = (GeckoCreateWithContextFn)FirefoxCore.PfnCreateWithContext;
            string start = (this.pendingUrl != "") ? this.pendingUrl : "about:blank";
            this.handle = cfn(
                parentHwnd, x, y, w, h, start, this.contextId,
                this.fingerprint.webglVendor, this.fingerprint.webglRenderer,
                this.fingerprint.timezone, this.fingerprint.userAgent
            );

            if (this.handle != 0 && FirefoxCore.PfnSetFingerprint != 0) {
                GeckoSetFingerprintFn fpFn = (GeckoSetFingerprintFn)FirefoxCore.PfnSetFingerprint;
                fpFn(this.handle, this.fingerprint.ToJson());
            }

            if (this.handle != 0 && FirefoxCore.PfnGetViewId != 0) {
                GeckoGetIntFn vidFn = (GeckoGetIntFn)FirefoxCore.PfnGetViewId;
                this.viewId = vidFn(this.handle);
            }
        }
            } finally { creationEntry.CaptureHandle(); }
    }
}
