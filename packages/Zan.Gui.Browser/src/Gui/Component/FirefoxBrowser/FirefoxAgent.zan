using System;
using System.IO;
using System.Collections.Generic;

namespace Gui.Component.FirefoxBrowser;

// 语义交互元素 (面向 AI Agent 的压缩结构)
public class PageElement {
    public string Ref;       // 紧凑索引，如 "e1", "e2"
    public string Tag;       // HTML 标签，如 "button", "input"
    public string Type;      // input 类型，如 "text", "password"
    public string Text;      // 元素文本或 placeholder
    public string Selector;  // CSS 选择器
    public int X;
    public int Y;
    public int W;
    public int H;

    public PageElement() {
        this.Ref = "";
        this.Tag = "";
        this.Type = "";
        this.Text = "";
        this.Selector = "";
        this.X = 0;
        this.Y = 0;
        this.W = 0;
        this.H = 0;
    }
}

// 页面语义快照 (经由 Token 降噪后的结构化表示)
public class PageSnapshot {
    public string Title;
    public string Url;
    public List<PageElement> Elements;

    public PageSnapshot() {
        this.Title = "";
        this.Url = "";
        this.Elements = new List<PageElement>();
    }

    public string ToPromptText() {
        string res = "=== 页面语义状态快照 ===\n";
        res = res + "页面标题: " + this.Title + "\n";
        res = res + "当前网址: " + this.Url + "\n";
        res = res + "可交互元素列表 (共 " + this.Elements.Count.ToString() + " 项):\n";
        for (int i = 0; i < this.Elements.Count; i = i + 1) {
            PageElement el = this.Elements[i];
            string typeInfo = (el.Type != "") ? (" type=\"" + el.Type + "\"") : "";
            res = res + "  [" + el.Ref + "] <" + el.Tag + typeInfo + "> \"" + el.Text + "\"\n";
        }
        res = res + "========================";
        return res;
    }

    public static PageSnapshot FromJson(string json) {
        PageSnapshot snap = new PageSnapshot();
        if (json == null || json == "") return snap;

        snap.Title = ExtractJsonString(json, "\"title\":\"");
        snap.Url = ExtractJsonString(json, "\"url\":\"");

        int elemIdx = json.IndexOf("\"elements\":[");
        if (elemIdx < 0) return snap;

        int cur = elemIdx + 11;
        while (cur < json.Length) {
            int startObj = json.IndexOf("{", cur);
            if (startObj < 0) break;
            int endObj = json.IndexOf("}", startObj);
            if (endObj < 0) break;

            string objStr = json.Substring(startObj, endObj - startObj + 1);
            PageElement el = new PageElement();
            el.Ref = ExtractJsonString(objStr, "\"ref\":\"");
            el.Tag = ExtractJsonString(objStr, "\"tag\":\"");
            el.Type = ExtractJsonString(objStr, "\"type\":\"");
            el.Text = ExtractJsonString(objStr, "\"text\":\"");
            el.Selector = ExtractJsonString(objStr, "\"selector\":\"");
            el.X = ExtractJsonInt(objStr, "\"x\":");
            el.Y = ExtractJsonInt(objStr, "\"y\":");
            el.W = ExtractJsonInt(objStr, "\"w\":");
            el.H = ExtractJsonInt(objStr, "\"h\":");

            snap.Elements.Add(el);
            cur = endObj + 1;
        }

        return snap;
    }

    static string ExtractJsonString(string src, string key) {
        int k = src.IndexOf(key);
        if (k < 0) return "";
        int s = k + key.Length;
        int e = src.IndexOf("\"", s);
        if (e < 0) return "";
        return src.Substring(s, e - s);
    }

    static int ExtractJsonInt(string src, string key) {
        int k = src.IndexOf(key);
        if (k < 0) return 0;
        int s = k + key.Length;
        int e = s;
        while (e < src.Length) {
            char c = src[e];
            if ((c >= '0' && c <= '9') || c == '-') {
                e = e + 1;
            } else {
                break;
            }
        }
        if (e > s) {
            return int.Parse(src.Substring(s, e - s));
        }
        return 0;
    }
}

// 面向大模型 AI Agent 的强类型标签页控制接口
public class FirefoxAgentTab {
    nint viewHandle;
    int contextId;
    int nextEvalId;

    public FirefoxAgentTab(nint handle, int userContextId) {
        this.viewHandle = handle;
        this.contextId = userContextId;
        this.nextEvalId = 1000;
    }

    public nint GetHandle() { return this.viewHandle; }
    public int GetContextId() { return this.contextId; }

    public void Navigate(string url) {
        if (this.viewHandle == 0 || FirefoxCore.PfnNavigate == 0) return;
        GeckoNavigateFn fn = (GeckoNavigateFn)FirefoxCore.PfnNavigate;
        fn(this.viewHandle, url);
    }

    public string Title() {
        if (this.viewHandle == 0 || FirefoxCore.PfnGetTitle == 0) return "";
        GeckoGetStringFn fn = (GeckoGetStringFn)FirefoxCore.PfnGetTitle;
        return fn(this.viewHandle);
    }

    public string Url() {
        if (this.viewHandle == 0 || FirefoxCore.PfnGetUrl == 0) return "";
        GeckoGetStringFn fn = (GeckoGetStringFn)FirefoxCore.PfnGetUrl;
        return fn(this.viewHandle);
    }

    public int SendSnapshot() {
        return this.ExecuteScriptAsync("window.ZanAgent ? ZanAgent.snapshot() : ''");
    }

    public int SendFill(string targetRefOrSel, string text) {
        string clean = text.Replace("'", "\\'");
        string js = "window.ZanAgent ? ZanAgent.fill('" + targetRefOrSel + "', '" + clean + "') : false";
        return this.ExecuteScriptAsync(js);
    }

    public int SendClick(string targetRefOrSel) {
        string js = "window.ZanAgent ? ZanAgent.click('" + targetRefOrSel + "') : false";
        return this.ExecuteScriptAsync(js);
    }

    public int SendRunBatch(string batchScript) {
        return this.ExecuteScriptAsync(batchScript);
    }

    public int ExecuteScriptAsync(string script) {
        if (this.viewHandle == 0 || FirefoxCore.PfnExecuteScript == 0) return -1;
        this.nextEvalId = this.nextEvalId + 1;
        int id = this.nextEvalId;
        GeckoExecuteScriptFn fn = (GeckoExecuteScriptFn)FirefoxCore.PfnExecuteScript;
        fn(this.viewHandle, script, id);
        return id;
    }

    public bool IsDone(int evalId) {
        if (FirefoxCore.PfnGetLastEvalId == 0) return false;
        GeckoGetIntFn fn = (GeckoGetIntFn)FirefoxCore.PfnGetLastEvalId;
        return fn(this.viewHandle) == evalId;
    }

    public string GetResult() {
        if (FirefoxCore.PfnGetLastEvalResult == 0) return "";
        GeckoGetStringFn fn = (GeckoGetStringFn)FirefoxCore.PfnGetLastEvalResult;
        return fn(this.viewHandle);
    }

    public bool GetSuccess() {
        if (FirefoxCore.PfnGetLastEvalSuccess == 0) return false;
        GeckoGetBoolFn fn = (GeckoGetBoolFn)FirefoxCore.PfnGetLastEvalSuccess;
        return fn(this.viewHandle);
    }

    // 核心异步非阻塞求值 (基于 await Task.Delay 协程挂起，零线程开销，让出事件循环)
    public async Task<string> EvalAsync(string script, int timeoutMs = 8000) {
        int id = this.ExecuteScriptAsync(script);
        if (id < 0) return "";
        int elapsed = 0;
        while (elapsed < timeoutMs) {
            if (this.IsDone(id)) {
                return this.GetResult();
            }
            await Task.Delay(16);
            elapsed = elapsed + 16;
        }
        return "";
    }

    // 异步获取页面交互快照 (面向 AI Agent 的压缩语义树，Token 节省 90%)
    public async Task<PageSnapshot> SnapshotAsync(int timeoutMs = 8000) {
        string res = await this.EvalAsync("ZanAgent.snapshot();", timeoutMs);
        return PageSnapshot.FromJson(res);
    }

    // 异步智能拟人点击 (三次贝塞尔轨迹 + 菲茨定律加减速 + 悬停 + 物理按压时长 + 遮挡探测)
    public async Task<bool> ClickAsync(string refOrSel, int timeoutMs = 8000) {
        string clean = refOrSel.Replace("'", "\\'");
        string script = "ZanAgent.click('" + clean + "');";
        string res = await this.EvalAsync(script, timeoutMs);
        return res == "true" || res == "ok";
    }

    // 异步智能表单直填 (穿透 React/Vue 双向绑定 Setter 并派发完整 InputEvent)
    public async Task<bool> FillAsync(string refOrSel, string text, int timeoutMs = 8000) {
        string cleanSel = refOrSel.Replace("'", "\\'");
        string cleanText = text.Replace("'", "\\'");
        string script = "ZanAgent.fill('" + cleanSel + "', '" + cleanText + "');";
        string res = await this.EvalAsync(script, timeoutMs);
        return res == "true" || res == "ok";
    }

    // 异步拟人逐字敲击 (模拟人类击键时序与高斯分布节奏抖动，突破前端击键生物识别)
    public async Task<bool> TypeAsync(string refOrSel, string text, int timeoutMs = 12000) {
        string cleanSel = refOrSel.Replace("'", "\\'");
        string cleanText = text.Replace("'", "\\'");
        string script = "ZanAgent.type('" + cleanSel + "', '" + cleanText + "');";
        string res = await this.EvalAsync(script, timeoutMs);
        return res == "true" || res == "ok";
    }

    // 异步平滑鼠标移动 (三次贝塞尔曲线 + 菲茨加减速 + 生理微震颤)
    public async Task<bool> MouseMoveAsync(string target, int timeoutMs = 8000) {
        string clean = target.Replace("'", "\\'");
        string script = "ZanAgent.mouseMove('" + clean + "');";
        string res = await this.EvalAsync(script, timeoutMs);
        return res == "true" || res == "ok";
    }

    // 异步滑块验证码拖拽 (非匀速物理加速+减速+微波浪 Y 轴微动)
    public async Task<bool> DragAsync(string target, int offsetX, int offsetY = 0, int timeoutMs = 8000) {
        string clean = target.Replace("'", "\\'");
        string script = "ZanAgent.drag('" + clean + "', " + offsetX.ToString() + ", " + offsetY.ToString() + ");";
        string res = await this.EvalAsync(script, timeoutMs);
        return res == "true" || res == "ok";
    }

    // 异步抗网页改版选项匹配 (Picker-Rank 7级平滑阶梯，支持原生与现代化框架自定义 Select)
    public async Task<string> SelectOptionAsync(string target, string wanted, int timeoutMs = 8000) {
        string cleanTarget = target.Replace("'", "\\'");
        string cleanWanted = wanted.Replace("'", "\\'");
        string script = "ZanAgent.selectOption('" + cleanTarget + "', '" + cleanWanted + "');";
        return await this.EvalAsync(script, timeoutMs);
    }

    // 异步真实可见文本提取 (过滤 -9999px / clip 等防爬虫蜜罐文本陷阱)
    public async Task<string> VisibleTextAsync(string target, int timeoutMs = 8000) {
        string clean = target.Replace("'", "\\'");
        string script = "ZanAgent.visibleText('" + clean + "');";
        return await this.EvalAsync(script, timeoutMs);
    }

    // 异步多行结构化批量采集 (一次性抽取多行数据为 JSON，0 次多余 IPC 开销)
    public async Task<string> ReadRowsAsync(string rowSelector, string fieldMapJson, int limit = 100, int timeoutMs = 10000) {
        string cleanRow = rowSelector.Replace("'", "\\'");
        string script = "ZanAgent.readRows('" + cleanRow + "', " + fieldMapJson + ", { limit: " + limit.ToString() + " });";
        return await this.EvalAsync(script, timeoutMs);
    }

    // 异步结果驱动全分支竞速等待状态机 (成功/报错/消失/跳转全分支竞速，抛弃低效 Sleep)
    public async Task<string> WaitForOutcomeAsync(string success = "", string error = "", string gone = "", string url = "", int timeoutMs = 10000) {
        string script = "ZanAgent.waitForOutcome({";
        bool hasField = false;
        if (success != "") { script = script + " success: '" + success.Replace("'", "\\'") + "'"; hasField = true; }
        if (error != "") { if (hasField) script = script + ","; script = script + " error: '" + error.Replace("'", "\\'") + "'"; hasField = true; }
        if (gone != "") { if (hasField) script = script + ","; script = script + " gone: '" + gone.Replace("'", "\\'") + "'"; hasField = true; }
        if (url != "") { if (hasField) script = script + ","; script = script + " url: '" + url.Replace("'", "\\'") + "'"; hasField = true; }
        if (hasField) script = script + ",";
        script = script + " timeoutMs: " + timeoutMs.ToString() + " });";
        return await this.EvalAsync(script, timeoutMs + 1000);
    }

    // 异步平滑页面滚动
    public async Task<bool> ScrollAsync(int dy, int timeoutMs = 5000) {
        string script = "ZanAgent.scroll(" + dy.ToString() + ");";
        string res = await this.EvalAsync(script, timeoutMs);
        return res == "true" || res == "ok";
    }

    // 异步注入内存级网络 Mock 响应 (离线注入响应、解密脱壳或替换验证码图片)
    public async Task<bool> MockResourceAsync(string urlPattern, string responseBody, string contentType = "application/json", int timeoutMs = 5000) {
        string cleanPat = urlPattern.Replace("'", "\\'");
        string cleanBody = responseBody.Replace("'", "\\'");
        string cleanType = contentType.Replace("'", "\\'");
        string script = "ZanAgent.mockResource('" + cleanPat + "', '" + cleanBody + "', '" + cleanType + "');";
        string res = await this.EvalAsync(script, timeoutMs);
        return res == "true" || res == "ok";
    }

    // 异步清除所有内存级网络 Mock 拦截
    public async Task<bool> ClearMocksAsync(int timeoutMs = 5000) {
        string res = await this.EvalAsync("ZanAgent.clearMocks();", timeoutMs);
        return res == "true" || res == "ok";
    }
}
