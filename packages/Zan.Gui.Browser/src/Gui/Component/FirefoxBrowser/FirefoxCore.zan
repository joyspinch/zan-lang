using System;
using System.IO;

namespace Gui.Component.FirefoxBrowser;

public delegate bool GeckoInitFn(nint hostHwnd);
public delegate void GeckoSetHostWindowFn(nint hostHwnd);
public delegate nint GeckoCreateWithContextFn(
    nint parentHwnd, int x, int y, int w, int h,
    string initialUrl, int userContextId,
    string webglVendor, string webglRenderer,
    string timezone, string userAgent);
public delegate void GeckoBoundsFn(nint viewHandle, int x, int y, int w, int h);
public delegate void GeckoVisibleFn(nint viewHandle, bool visible);
public delegate void GeckoNavigateFn(nint viewHandle, string url);
public delegate void GeckoActionFn(nint viewHandle);
public delegate void GeckoVoidFn();
public delegate void GeckoClipByIdFn(int viewId, string spec);
public delegate int GeckoGetViewIdFn(nint viewHandle);
public delegate void GeckoExecuteScriptFn(nint viewHandle, string script, int evalId);
public delegate void GeckoClickElementFn(nint viewHandle, string selector, int evalId);
public delegate void GeckoTypeTextFn(nint viewHandle, string selector, string text, int evalId);
public delegate string GeckoGetStringFn(nint viewHandle);
public delegate bool GeckoGetBoolFn(nint viewHandle);
public delegate int GeckoGetIntFn(nint viewHandle);
public delegate void GeckoSetFingerprintFn(nint viewHandle, string configJson);

/// <summary>
/// 火狐内核 C-ABI 动态链接直连驱动
/// </summary>
public class FirefoxCore {
    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "SetDllDirectoryA")]
    public static extern bool SetDllDirectoryA(string path);
    #endif

    public static nint XulMod = 0;
    static bool loaded = false;

    public static nint PfnInit = 0;
    public static nint PfnSetHostWindow = 0;
    public static nint PfnCreateWithContext = 0;
    public static nint PfnSetBounds = 0;
    public static nint PfnSetVisible = 0;
    public static nint PfnNavigate = 0;
    public static nint PfnGoBack = 0;
    public static nint PfnGoForward = 0;
    public static nint PfnReload = 0;
    public static nint PfnDestroy = 0;
    public static nint PfnSetClipById = 0;
    public static nint PfnGetViewId = 0;
    public static nint PfnExecuteScript = 0;
    public static nint PfnClickElement = 0;
    public static nint PfnTypeText = 0;
    public static nint PfnGetTitle = 0;
    public static nint PfnGetUrl = 0;
    public static nint PfnCanGoBack = 0;
    public static nint PfnCanGoForward = 0;
    public static nint PfnGetLastEvalResult = 0;
    public static nint PfnGetLastEvalId = 0;
    public static nint PfnGetLastEvalSuccess = 0;
    public static nint PfnSetFingerprint = 0;
    public static nint PfnGetFingerprint = 0;
    public static nint PfnShrinkMemory = 0;

    public static bool EnsureLoaded() {
        if (loaded) return XulMod != 0;
        loaded = true;

        string[] searchPaths = new string[] {
            "D:/project/firefox/obj-x86_64-pc-windows-msvc/dist/bin",
            "D:/project/firefox/dist/zan-browser-windows-x64",
            "./",
            "./bin",
            "../dist/zan-browser-windows-x64"
        };

        for (int i = 0; i < searchPaths.Length; i = i + 1) {
            string p = searchPaths[i];
            string xulPath = Path.Combine(p, "xul.dll");
            if (File.Exists(xulPath)) {
                #if WINDOWS
                SetDllDirectoryA(p);
                #endif
                XulMod = Interop.Load(xulPath);
                if (XulMod != 0) {
                    Console.WriteLine("[FirefoxCore] Loaded xul from: " + xulPath);
                    ResolveSymbols();
                    return true;
                }
            }
        }

        XulMod = Interop.Load("xul.dll");
        if (XulMod != 0) {
            ResolveSymbols();
            return true;
        }

        return false;
    }

    static void ResolveSymbols() {
        PfnInit = Interop.Symbol(XulMod, "Gecko_Init");
        PfnSetHostWindow = Interop.Symbol(XulMod, "Gecko_SetHostWindow");
        PfnCreateWithContext = Interop.Symbol(XulMod, "Gecko_CreateWebViewWithContext");
        PfnSetBounds = Interop.Symbol(XulMod, "Gecko_SetBounds");
        Console.WriteLine("[FirefoxCore] Symbols resolved.");
        PfnSetVisible = Interop.Symbol(XulMod, "Gecko_SetVisible");
        PfnNavigate = Interop.Symbol(XulMod, "Gecko_Navigate");
        PfnGoBack = Interop.Symbol(XulMod, "Gecko_GoBack");
        PfnGoForward = Interop.Symbol(XulMod, "Gecko_GoForward");
        PfnReload = Interop.Symbol(XulMod, "Gecko_Reload");
        PfnDestroy = Interop.Symbol(XulMod, "Gecko_DestroyWebView");
        PfnSetClipById = Interop.Symbol(XulMod, "Gecko_SetClipById");
        PfnGetViewId = Interop.Symbol(XulMod, "Gecko_GetViewId");
        PfnExecuteScript = Interop.Symbol(XulMod, "Gecko_ExecuteScript");
        PfnClickElement = Interop.Symbol(XulMod, "Gecko_ClickElement");
        PfnTypeText = Interop.Symbol(XulMod, "Gecko_TypeText");
        PfnGetTitle = Interop.Symbol(XulMod, "Gecko_GetTitle");
        PfnGetUrl = Interop.Symbol(XulMod, "Gecko_GetUrl");
        PfnCanGoBack = Interop.Symbol(XulMod, "Gecko_CanGoBack");
        PfnCanGoForward = Interop.Symbol(XulMod, "Gecko_CanGoForward");
        PfnGetLastEvalResult = Interop.Symbol(XulMod, "Gecko_GetLastEvalResult");
        PfnGetLastEvalId = Interop.Symbol(XulMod, "Gecko_GetLastEvalId");
        PfnGetLastEvalSuccess = Interop.Symbol(XulMod, "Gecko_GetLastEvalSuccess");
        PfnSetFingerprint = Interop.Symbol(XulMod, "Gecko_SetFingerprint");
        PfnGetFingerprint = Interop.Symbol(XulMod, "Gecko_GetFingerprint");
        PfnShrinkMemory = Interop.Symbol(XulMod, "Gecko_ShrinkMemory");
    }

    public static void ApplyClip(int viewId, string spec) {
        if (viewId <= 0 || PfnSetClipById == 0) return;
        GeckoClipByIdFn fn = (GeckoClipByIdFn)PfnSetClipById;
        fn(viewId, spec);
    }
}
