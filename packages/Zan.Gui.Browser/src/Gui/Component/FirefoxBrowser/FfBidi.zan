using System;
using System.IO;
using System.Json;
using System.Text;
using System.Threading;

namespace Gui.Component.FirefoxBrowser;

// BiDi 事件回调（method 名 + 原始 JSON 文本）。
public delegate void FfBidiEventFn(string method, string paramsJson);

// WebDriver BiDi 客户端：Firefox 用 --remote-debugging-port 打开的
// WebSocket 端点（ws://127.0.0.1:<port>/session），是 Mozilla 力推的
// 新一代自动化协议（Marionette 的继任者）。
// 线程模型：一条读线程把所有进站消息塞进 inbox；调用线程发命令、
// 从 inbox 里等匹配 id 的回复，期间到的 soared 事件转给
// <see cref="eventSink"/>。整个客户端同一时刻只允许一个命令线程。
public class FfBidi {
    public FfWs ws;
    public int nextId = 1;
    public string sessionId;
    public string lastError;
    public FfBidiEventFn eventSink;
    public bool disposed;

    public BlockingQueue<string> inbox;
    // Connect 失败时给全局的说明。
    public static string staticError = "";

    // 连接并准备就绪（不建会话；会话用 <see cref="NewSession"/>）。
    public static FfBidi Connect(int port, int timeoutMs) {
        FfWs ws = FfWs.Connect("127.0.0.1", port, "/session", timeoutMs);
        if (ws == null) {
            FfBidi.staticError = "WebSocket 连接超时（Firefox 未在监听 "
                + port + "）";
            return null;
        }
        FfBidi b = new FfBidi();
        b.ws = ws;
        b.inbox = new BlockingQueue<string>();
        b.disposed = false;
        Thread.Start(() => { FfBidi.ReadLoop(b); });
        return b;
    }

    // 读线程主体：WS 文本帧 → inbox。
    static void ReadLoop(FfBidi b) {
        while (!b.disposed) {
            string msg = b.ws.RecvText();
            if (msg == null) {
                b.inbox.Complete();
                return;
            }
            b.inbox.Enqueue(msg);
        }
    }

    // 发命令并等回复（timeoutMs 截止）。回复到达前顺便分派事件。
    // 失败返回 null（lastError 说明原因）。
    public JsonValue Command(string method, string paramsJson, int timeoutMs) {
        if (!this.ws.open) {
            this.lastError = "连接已关闭";
            return null;
        }
        int id = this.nextId;
        this.nextId = id + 1;
        string msg = "{\"id\":" + id + ",\"method\":\"" + method
            + "\",\"params\":" + (paramsJson == "" ? "{}" : paramsJson) + "}";
        if (!this.ws.SendText(msg)) {
            this.lastError = this.ws.lastError;
            return null;
        }
        Stopwatch sw = Stopwatch.StartNew();
        while (sw.ElapsedMilliseconds() < timeoutMs) {
            string raw = this.inbox.DequeueFor(100);
            if (raw == null || raw == "") { continue; }
            JsonValue v = JsonValue.ParseOrStr(raw);
            JsonValue vid = v.Get("id");
            if (vid == null || vid.AsInt(0 - 1) != id) {
                this.Dispatch(v, raw);
                continue;
            }
            JsonValue err = v.Get("error");
            if (err != null && !err.IsNull()) {
                // BiDi 的错误回复是顶层字段：{"error":"...", "message":"..."}。
                if (err.IsString()) {
                    JsonValue m = v.Get("message");
                    this.lastError = err.AsString("unknown")
                        + (m != null ? "：" + m.AsString("") : "");
                } else {
                    JsonValue m = err.Get("message");
                    this.lastError = m != null ? m.AsString("unknown") : "unknown";
                }
                return null;
            }
            this.lastError = "";
            return v.Get("result");
        }
        this.lastError = "等待回复超时：" + method;
        return null;
    }

    // 纯收事件跑 ms 毫秒（不发包），每条进站消息都转给 eventSink。
    public void Drain(int ms) {
        Stopwatch sw = Stopwatch.StartNew();
        while (sw.ElapsedMilliseconds() < ms) {
            string raw = this.inbox.DequeueFor(50);
            if (raw == null || raw == "") { continue; }
            this.Dispatch(JsonValue.ParseOrStr(raw), raw);
        }
    }

    void Dispatch(JsonValue v, string raw) {
        if (this.eventSink == null) { return; }
        JsonValue m = v.Get("method");
        if (m == null) { return; }
        this.eventSink(m.AsString(""), raw);
    }

    // ---- 常用命令的薄包装 ----------------------------------------------

    // 建 BiDi 会话（连接后的第一条命令；capabilities 必须是对象）。
    public bool NewSession() {
        JsonValue caps = JsonValue.NewObject();
        JsonValue always = JsonValue.NewObject();
        caps.Put("alwaysMatch", always);
        JsonValue p = JsonValue.NewObject();
        p.Put("capabilities", caps);
        JsonValue r = this.Command("session.new", p.ToJson(), 15000);
        if (r == null) { return false; }
        JsonValue sid = r.Get("sessionId");
        this.sessionId = sid != null ? sid.AsString("") : "";
        return true;
    }

    // 订阅事件（事件名列表，如 browsingContext.domContentLoaded /
    // log.entryAdded；不传 contexts 订阅全部上下文）。
    public bool Subscribe(string eventNames) {
        StringBuilder p = new StringBuilder();
        p.Append("{\"events\":" + eventNames + "}");
        return this.Command("session.subscribe", p.ToString(), 10000) != null;
    }

    // 顶层浏览上下文 id（getTree 第一个节点的 context）。
    public string TopContext() {
        JsonValue r = this.Command("browsingContext.getTree", "{}", 10000);
        if (r == null) { return ""; }
        JsonValue contexts = r.Get("contexts");
        if (contexts == null || !contexts.IsArray() || contexts.Count() < 1) {
            return "";
        }
        JsonValue first = contexts.At(0);
        JsonValue cid = first != null ? first.Get("context") : null;
        return cid != null ? cid.AsString("") : "";
    }

    // 导航（wait: "complete" = 等加载完成）。
    public bool Navigate(string context, string url) {
        JsonValue p = JsonValue.NewObject();
        p.PutStr("context", context);
        p.PutStr("url", url);
        p.PutStr("wait", "complete");
        return this.Command("browsingContext.navigate", p.ToJson(), 30000) != null;
    }

    // 页内求值，返回脚本结果的 JSON 文本（失败 ""）。
    // 这版 Firefox 要求 awaitPromise 必传（布尔）。
    public string Evaluate(string context, string expression) {
        JsonValue p = JsonValue.NewObject();
        p.PutStr("expression", expression);
        p.PutBool("awaitPromise", false);
        JsonValue target = JsonValue.NewObject();
        target.PutStr("context", context);
        p.Put("target", target);
        JsonValue r = this.Command("script.evaluate", p.ToJson(), 15000);
        if (r == null) { return ""; }
        // BiDi 的 script.evaluate 回复形如
        // {type:"success", result:{type:"string", value:"..."}, realm:...}。
        JsonValue inner = r.Get("result");
        if (inner == null) { return ""; }
        JsonValue val = inner.Get("value");
        return val != null ? val.ToJson() : inner.ToJson();
    }

    // 抓当前页面截图（PNG base64）落盘。
    public bool CaptureScreenshot(string context, string filePath) {
        JsonValue p = JsonValue.NewObject();
        p.PutStr("context", context);
        JsonValue r = this.Command("browsingContext.captureScreenshot",
                                   p.ToJson(), 20000);
        if (r == null) { return false; }
        JsonValue data = r.Get("data");
        if (data == null) { return false; }
        byte[] png = Convert.FromBase64String(data.AsString(""));
        if (png == null || png.Length == 0) { return false; }
        File.WriteAllBytes(filePath, png);
        return true;
    }

    // ---- Cookies（storage 模块）----------------------------------------

    // 取当前分区的全部 Cookie，回复形如
    // {cookies:[{name,value,domain,path,size,secure,httpOnly,sameSite,expiry}]}。
    public JsonValue GetCookies() {
        return this.Command("storage.getCookies", "{}", 10000);
    }

    // 写（或覆盖）一个 Cookie。expires 为 Unix 秒；<=0 表示会话 Cookie。
    // 同名同域同路径再写一个已过期的 expires 即等于删除。
    public bool SetCookie(string name, string value, string domain,
                          string path, bool secure, bool httpOnly,
                          string sameSite, long expires) {
        JsonValue c = JsonValue.NewObject();
        c.PutStr("name", name);
        // 新版 BiDi 的 cookie.value 是 Bytes 结构：{type, value}。
        JsonValue val = JsonValue.NewObject();
        val.PutStr("type", "string");
        val.PutStr("value", value);
        c.Put("value", val);
        if (domain != "") { c.PutStr("domain", domain); }
        if (path != "") { c.PutStr("path", path); }
        c.PutBool("secure", secure);
        c.PutBool("httpOnly", httpOnly);
        if (sameSite != "") { c.PutStr("sameSite", sameSite); }
        if (expires > 0) { c.PutInt("expires", expires); }
        JsonValue p = JsonValue.NewObject();
        p.Put("cookie", c);
        return this.Command("storage.setCookie", p.ToJson(), 10000) != null;
    }

    // 删一个页面域下的 Cookie（走 document.cookie 的 Max-Age=0 经典
    // 语义）。storage.setCookie 的"过期重写"在这版 Firefox 上不删
    // （实测原条目原地不动），所以删除只能借页面 JS。name/path 由
    // 调用方保证不含单引号。
    public bool DeletePageCookie(string context, string name, string path) {
        JsonValue p = JsonValue.NewObject();
        p.PutStr("expression",
            "document.cookie = '" + name + "=; Max-Age=0; path=" + path + "'");
        p.PutBool("awaitPromise", false);
        JsonValue target = JsonValue.NewObject();
        target.PutStr("context", context);
        p.Put("target", target);
        return this.Command("script.evaluate", p.ToJson(), 15000) != null;
    }

    // ---- 网络监听与拦截（network 模块）---------------------------------
    // 监听不需要专门 API：session.subscribe 订阅
    // network.beforeRequestSent / responseStarted / responseCompleted，
    // 事件从 eventSink 流出。拦截用下面的三件套。

    // 装请求拦截器，返回 intercept id（失败 ""）。phasesJson /
    // urlPatternsJson 都是 JSON 数组文本，例如：
    //   phases:  ["beforeRequestSent"]
    //   patterns: [{"type":"pattern","hostname":"example.com"}]
    // 注意 urlPattern 的 "string" 类型是精确匹配（不允许 * 通配），
    // 通配要走 "pattern" 结构化类型。
    public string AddIntercept(string phasesJson, string urlPatternsJson) {
        JsonValue p = JsonValue.NewObject();
        p.PutJson("phases", phasesJson);
        p.PutJson("urlPatterns", urlPatternsJson);
        JsonValue r = this.Command("network.addIntercept", p.ToJson(), 10000);
        if (r == null) { return ""; }
        JsonValue v = r.Get("intercept");
        return v != null ? v.AsString("") : "";
    }

    // 放行一个被拦截的请求。
    public bool ContinueRequest(string requestId) {
        JsonValue p = JsonValue.NewObject();
        p.PutStr("request", requestId);
        return this.Command("network.continueRequest", p.ToJson(), 10000) != null;
    }

    // 摘掉拦截器。
    public bool RemoveIntercept(string intercept) {
        JsonValue p = JsonValue.NewObject();
        p.PutStr("intercept", intercept);
        return this.Command("network.removeIntercept", p.ToJson(), 10000) != null;
    }

    // 结束会话并让 Firefox 退出（browser.close 是协议里的优雅关停）。
    public void Shutdown() {
        this.Command("browser.close", "{}", 10000);
        this.Disconnect();
    }

    // 只断开连接（不关 Firefox）。
    public void Disconnect() {
        this.disposed = true;
        if (this.ws != null) {
            this.ws.Close();
            this.ws = null;
        }
    }
}
