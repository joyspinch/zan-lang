using System;
using System.Text;

namespace Gui.Component;

// 浏览器组件 URL 补全与数据转义公共工具类。
// 收拢 CefBrowser / FfBrowser / WebView 三家重复实现的协议探测与 data: URL 转义。
public class BrowserUrl {
    // 导航目标补全：没有协议前缀的裸地址加 `https://`。
    public static string Normalize(string target) {
        if (target == "") { return ""; }
        if (BrowserUrl.HasScheme(target)) { return target; }
        return "https://" + target;
    }

    // 是否带协议前缀（"://"，或 data:/about: 这类无 // 的 scheme）。
    public static bool HasScheme(string s) {
        int n = s.Length;
        for (int i = 0; i + 2 < n; i = i + 1) {
            if (s[i] == ':' && s[i + 1] == '/' && s[i + 2] == '/') { return true; }
        }
        if (s.StartsWith("data:")) { return true; }
        if (s.StartsWith("about:")) { return true; }
        return false;
    }

    // data: URL 里必须转义的字符（其余按 UTF-8 原样传，Chromium 与 Gecko 均接受）。
    public static string UrlEscape(string s) {
        if (s == null) { return ""; }
        int len = s.Length;
        bool hasBad = false;
        for (int j = 0; j < len; j = j + 1) {
            int c = s[j] & 255;
            if (c == 35 || c == 37 || c == 38 || c == 63 || c == 32) {
                hasBad = true;
                break;
            }
        }
        if (!hasBad) { return s; }
        StringBuilder sb = new StringBuilder();
        int start = 0;
        for (int i = 0; i < len; i = i + 1) {
            int c = s[i] & 255;
            if (c == 35 || c == 37 || c == 38 || c == 63 || c == 32) {
                if (i > start) {
                    sb.Append(s.Substring(start, i - start));
                }
                if (c == 35) { sb.Append("%23"); }
                else if (c == 37) { sb.Append("%25"); }
                else if (c == 38) { sb.Append("%26"); }
                else if (c == 63) { sb.Append("%3F"); }
                else { sb.Append("%20"); }
                start = i + 1;
            }
        }
        if (start < len) {
            sb.Append(s.Substring(start, len - start));
        }
        return sb.ToString();
    }
}
