using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Component;

// 三引擎共享的保留式浏览器控件外壳（WebViewBox / CefBrowserBox / FirefoxBrowserBox 基类）。
// 统一管理起始 URL 消费、导航转发、设计器属性、导航语义事件、原生宿主边界同步与绘制转发。
public class BrowserBoxBase : Control {
    public string startUrl;
    public bool navigated;

    protected void InitBrowserBox(string styleType) {
        this.InitControl(styleType);
        this.startUrl = "";
        this.navigated = false;
    }

    public virtual IBrowserView BrowserView() { return null; }

    public void SetStartUrl(string u) {
        this.startUrl = u != null ? u : "";
        IBrowserView v = this.BrowserView();
        if (this.navigated && this.startUrl != "" && v != null) { v.Navigate(this.startUrl); }
    }

    public string StartUrl() { return this.startUrl; }

    public void Navigate(string target) {
        this.navigated = true;
        IBrowserView v = this.BrowserView();
        if (v != null) { v.Navigate(target); }
    }

    public void Back() { IBrowserView v = this.BrowserView(); if (v != null) { v.Back(); } }
    public void Forward() { IBrowserView v = this.BrowserView(); if (v != null) { v.Forward(); } }
    public void Reload() { IBrowserView v = this.BrowserView(); if (v != null) { v.Reload(); } }
    public void Stop() { IBrowserView v = this.BrowserView(); if (v != null) { v.Stop(); } }
    public bool CanGoBack() { IBrowserView v = this.BrowserView(); return v != null && v.CanGoBack(); }
    public bool CanGoForward() { IBrowserView v = this.BrowserView(); return v != null && v.CanGoForward(); }
    public bool IsLoading() { IBrowserView v = this.BrowserView(); return v != null && v.IsLoading(); }
    public int LastStatus() { IBrowserView v = this.BrowserView(); return v != null ? v.LastStatus() : 0; }
    public string CurrentUrl() { IBrowserView v = this.BrowserView(); return v != null ? v.CurrentUrl() : ""; }
    public string CurrentTitle() { IBrowserView v = this.BrowserView(); return v != null ? v.CurrentTitle() : ""; }
    public void Hide() { IBrowserView v = this.BrowserView(); if (v != null) { v.Hide(); } }

    public void Destroy() {
        IBrowserView v = this.BrowserView();
        if (v != null) { v.Destroy(); }
        if (this.parent != null) { this.parent.Remove(this); }
    }

    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("url", "Start URL").Also("placeholder").Field("startUrl"));
        return ps;
    }

    [Event]
    public UiEvent NavStart { get { IBrowserView v = this.BrowserView(); return v != null ? v.NavStartEvent() : null; } }
    [Event]
    public UiEvent NavComplete { get { IBrowserView v = this.BrowserView(); return v != null ? v.NavCompleteEvent() : null; } }
    [Event]
    public UiEvent TitleChanged { get { IBrowserView v = this.BrowserView(); return v != null ? v.TitleChangedEvent() : null; } }
    [Event]
    public UiEvent LoadingChanged { get { IBrowserView v = this.BrowserView(); return v != null ? v.LoadingChangedEvent() : null; } }

    public void ConsumeStartUrl() {
        IBrowserView v = this.BrowserView();
        if (!this.navigated && this.startUrl != "" && v != null) {
            this.navigated = true;
            v.Navigate(this.startUrl);
        }
    }

    public void UpdateBrowser(App app) {
        app = this.ResolveApp(app);
        IBrowserView v = this.BrowserView();
        if (v == null) { return; }
        BrowserNativeEntry entry = v.AttachNative(app, this);
        if (entry != null) { entry.SetBounds(this.bx, this.by, this.bw, this.bh); }
    }

    public override void Arrange(int x, int y, int w, int h) {
        base.Arrange(x, y, w, h);
        App app = this.FindApp();
        if (app != null) { this.UpdateBrowser(app); }
    }

    public override void OnPaint(App app) {
        app = this.ResolveApp(app);
        IBrowserView v = this.BrowserView();
        if (v != null && this.bw > 0 && this.bh > 0) {
            v.PaintView(app, this.bx, this.by, this.bw, this.bh);
        }
    }
}
