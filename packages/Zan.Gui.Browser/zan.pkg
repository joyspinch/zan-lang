name = "Zan.Gui.Browser"
version = "1.0.0"
description = "In-app web browsers for Zan Gui: WebViewBox on the system WebView (WebView2/WebKitGTK), CefBrowserBox on the Chromium Embedded Framework, and FfBrowserBox hosting a real Firefox process with Marionette control, with CDP control, cookie and fingerprint management"
