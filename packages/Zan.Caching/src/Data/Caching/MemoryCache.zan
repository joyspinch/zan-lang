using System;
using System.Collections.Generic;
using System.Threading;

namespace Data.Caching;

// 异步缓存工厂委托。
public async delegate T CacheFactoryAsync<T>();

// 进程内 LRU + TTL 缓存。O(1) 命中、O(1) 淘汰、稳态零堆分配。
//
// 语义：
//   * TValue 必须是引用类型（string / 类 / JsonValue）。命中判断以 null
//     为未命中信号，值类型请用 MemoryCache<string> 存文本形态。
//   * 默认**不加锁**（单线程/协程内使用最快）。跨线程共享时用
//     MemoryCache<TValue>.Synchronized(...) 建，或先 UseLock()。
//   * TTL 用 Stopwatch 单调微秒，不受系统时钟回拨影响。
//   * capacity > 0 时按 LRU 淘汰；capacity == 0 表示不限制条目数
//     （仍然会清 TTL 过期项）。
//   * 过期是**惰性**的：Get 命中时发现自己过期会就地清除并算未命中；
//     不访问的过期项由 Sweep() 主动回收（进程内缓存不必开定时器）。
public class MemoryCache<TValue> : IDisposable {
    private List<CacheEntry<TValue>> slots;
    private Dict<string, int> index;
    private int used;        // 占用槽位数
    private int freeHead;    // 空闲槽链表头，-1 = 无
    private int head;        // LRU 头（最近使用）
    private int tail;        // LRU 尾（最久未用，先淘汰）
    private int capacity;    // 0 = 不限
    private long ttlUs;      // 0 = 不过期
    private bool sliding;
    private bool locked;
    private object gate;
    private CacheStats stats;

    public MemoryCache() {
        this.slots = new List<CacheEntry<TValue>>();
        this.index = new Dict<string, int>();
        this.used = 0;
        this.freeHead = -1;
        this.head = -1;
        this.tail = -1;
        this.capacity = 0;
        this.ttlUs = 0;
        this.sliding = false;
        this.locked = false;
        this.gate = new object();
        this.stats = new CacheStats();
    }

    // 跨线程共享的写法。capacity/ttlMs 传 0 表示不限/不过期。
    public static MemoryCache<TValue> Synchronized(int capacity, long ttlMs) {
        MemoryCache<TValue> c = new MemoryCache<TValue>();
        c.SetCapacity(capacity);
        c.SetTtl(ttlMs);
        c.UseLock();
        return c;
    }

    // 打开内部互斥锁。必须在任何并发访问之前调用。
    public void UseLock() {
        this.locked = true;
    }

    // 释放底层资源（幂等；改用受管对象锁后无需销毁原生句柄，避免并发 UAF）。
    public void Dispose() {
    }

    private static long NowUs() { return Stopwatch.GetMicroseconds(); }

    private static long ToTtlUs(long ttlMs) {
        if (ttlMs <= 0L) { return 0L; }
        if (ttlMs > 9223372036854775L) { return 9223372036854775000L; }
        return ttlMs * 1000L;
    }

    private static long AddTtlUs(long now, long deltaUs) {
        if (deltaUs <= 0L) { return 0L; }
        if (now > 9223372036854775807L - deltaUs) { return 9223372036854775807L; }
        return now + deltaUs;
    }

    // ---- 配置 ----

    public void SetCapacity(int maxEntries) {
        if (this.locked) {
            lock (this.gate) { this.SetCapacityCore(maxEntries); }
            return;
        }
        this.SetCapacityCore(maxEntries);
    }

    private void SetCapacityCore(int maxEntries) {
        if (maxEntries < 0) { maxEntries = 0; }
        this.capacity = maxEntries;
        while (this.capacity > 0 && this.used > this.capacity) {
            this.EvictTail();
        }
    }

    // 固定 TTL（写入时刻起算）。
    public void SetTtl(long ttlMs) {
        if (this.locked) {
            lock (this.gate) {
                this.ttlUs = MemoryCache<TValue>.ToTtlUs(ttlMs);
                this.sliding = false;
            }
            return;
        }
        this.ttlUs = MemoryCache<TValue>.ToTtlUs(ttlMs);
        this.sliding = false;
    }

    // 滑动 TTL（每次命中续期）。
    public void SetSlidingTtl(long ttlMs) {
        if (this.locked) {
            lock (this.gate) {
                this.ttlUs = MemoryCache<TValue>.ToTtlUs(ttlMs);
                this.sliding = ttlMs > 0;
            }
            return;
        }
        this.ttlUs = MemoryCache<TValue>.ToTtlUs(ttlMs);
        this.sliding = ttlMs > 0;
    }

    public int Capacity() {
        if (this.locked) {
            lock (this.gate) { return this.capacity; }
        }
        return this.capacity;
    }

    public long TtlMs() {
        if (this.locked) {
            lock (this.gate) { return this.ttlUs / 1000L; }
        }
        return this.ttlUs / 1000L;
    }

    public bool IsSliding() {
        if (this.locked) {
            lock (this.gate) { return this.sliding; }
        }
        return this.sliding;
    }

    public int Count() {
        if (this.locked) {
            lock (this.gate) { return this.used; }
        }
        return this.used;
    }

    // ---- 读写 ----

    // 命中返回值，未命中返回 null（值类型不适用，见类注释）。
    public TValue Get(string key) {
        if (this.locked) {
            lock (this.gate) { return this.GetCore(key); }
        }
        return this.GetCore(key);
    }

    private TValue GetCore(string key) {
        if (key == null) {
            this.stats.misses = this.stats.misses + 1;
            return null;
        }
        int i = -1;
        if (!this.index.TryGetValue(key, out i)) {
            this.stats.misses = this.stats.misses + 1;
            return null;
        }
        CacheEntry<TValue> entry = this.slots[i];
        long exp = entry.expiresAtUs;
        if (exp != 0L) {
            long now = MemoryCache<TValue>.NowUs();
            if (now >= exp) {
                this.DropSlot(i);
                this.stats.expirations = this.stats.expirations + 1;
                this.stats.misses = this.stats.misses + 1;
                return null;
            }
            entry.touchedUs = now;
            if (this.sliding && this.ttlUs > 0L) {
                entry.expiresAtUs = MemoryCache<TValue>.AddTtlUs(now, this.ttlUs);
            }
        }
        this.stats.hits = this.stats.hits + 1;
        if (this.head != i) {
            this.Unlink(i);
            this.LinkHead(i);
        }
        return entry.value;
    }

    // 获取缓存项；若未命中则通过 factory 生成并按配置的默认 TTL 回填缓存后返回。
    public TValue GetOrCreate(string key, Func<TValue> factory) {
        return this.GetOrCreate(key, this.TtlMs(), factory);
    }

    // 获取缓存项；若未命中则通过 factory 生成并按指定 ttlMs 回填缓存后返回。
    public TValue GetOrCreate(string key, long ttlMs, Func<TValue> factory) {
        if (key == null) { return null; }
        TValue existing = this.Get(key);
        if (existing != null) {
            return existing;
        }
        if (factory == null) {
            return null;
        }
        TValue created = factory();
        if (created != null) {
            this.Set(key, created, ttlMs);
        }
        return created;
    }

    // 异步获取缓存项；若未命中则通过异步 factory 生成并按配置的默认 TTL 回填缓存后返回。
    public async TValue GetOrCreateAsync(string key, CacheFactoryAsync<TValue> factory) {
        return await this.GetOrCreateAsync(key, this.TtlMs(), factory);
    }

    // 异步获取缓存项；若未命中则通过异步 factory 生成并按指定 ttlMs 回填缓存后返回。
    public async TValue GetOrCreateAsync(string key, long ttlMs, CacheFactoryAsync<TValue> factory) {
        if (key == null) { return null; }
        TValue existing = this.Get(key);
        if (existing != null) {
            return existing;
        }
        if (factory == null) {
            return null;
        }
        TValue created = await factory();
        if (created != null) {
            this.Set(key, created, ttlMs);
        }
        return created;
    }

    // 存在性判断，不续期、不计命中、不动 LRU（探针/探活专用）。
    public bool Contains(string key) {
        if (this.locked) {
            lock (this.gate) { return this.ContainsCore(key); }
        }
        return this.ContainsCore(key);
    }

    private bool ContainsCore(string key) {
        if (key == null) { return false; }
        int i = -1;
        if (!this.index.TryGetValue(key, out i)) { return false; }
        if (this.slots[i].expiresAtUs != 0L
            && MemoryCache<TValue>.NowUs() >= this.slots[i].expiresAtUs) {
            this.DropSlot(i);
            this.stats.expirations = this.stats.expirations + 1;
            return false;
        }
        return true;
    }

    // 按构造时配置的 TTL 写入（单次加锁读取默认 TTL 并写入，消除竞态）。
    public void Set(string key, TValue value) {
        if (this.locked) {
            lock (this.gate) { this.SetCoreUs(key, value, this.ttlUs); }
            return;
        }
        this.SetCoreUs(key, value, this.ttlUs);
    }

    // ttlMs <= 0 表示该条不过期（覆盖默认 TTL）。
    public void Set(string key, TValue value, long ttlMs) {
        long deltaUs = MemoryCache<TValue>.ToTtlUs(ttlMs);
        if (this.locked) {
            lock (this.gate) { this.SetCoreUs(key, value, deltaUs); }
            return;
        }
        this.SetCoreUs(key, value, deltaUs);
    }

    private void SetCoreUs(string key, TValue value, long deltaUs) {
        if (key == null) { return; }
        // null 是未命中哨兵：写入 null 视为移除，避免 Contains==true 与 Get==null 语义撕裂
        if (value == null) {
            this.RemoveCore(key);
            return;
        }
        long now = 0L;
        long expiresAt = 0L;
        if (deltaUs > 0L) {
            now = MemoryCache<TValue>.NowUs();
            expiresAt = MemoryCache<TValue>.AddTtlUs(now, deltaUs);
        }
        int i = -1;
        if (this.index.TryGetValue(key, out i)) {
            CacheEntry<TValue> entry = this.slots[i];
            entry.value = value;
            entry.expiresAtUs = expiresAt;
            entry.touchedUs = now;
            if (this.head != i) {
                this.Unlink(i);
                this.LinkHead(i);
            }
            this.stats.sets = this.stats.sets + 1;
            return;
        }
        if (this.capacity > 0 && this.used >= this.capacity) {
            this.EvictTail();
        }
        int s = this.AllocSlot();
        CacheEntry<TValue> slot = this.slots[s];
        slot.key = key;
        slot.value = value;
        slot.expiresAtUs = expiresAt;
        slot.touchedUs = now;
        this.LinkHead(s);
        this.index.Add(key, s);
        this.used = this.used + 1;
        this.stats.sets = this.stats.sets + 1;
    }

    // 移除并返回原值；不存在返回 null。
    public TValue TryRemove(string key) {
        if (this.locked) {
            lock (this.gate) { return this.TryRemoveCore(key); }
        }
        return this.TryRemoveCore(key);
    }

    private TValue TryRemoveCore(string key) {
        if (key == null) { return null; }
        int i = -1;
        if (!this.index.TryGetValue(key, out i)) {
            return null;
        }
        CacheEntry<TValue> entry = this.slots[i];
        long exp = entry.expiresAtUs;
        if (exp != 0L && MemoryCache<TValue>.NowUs() >= exp) {
            this.DropSlot(i);
            this.stats.expirations = this.stats.expirations + 1;
            return null;
        }
        TValue v = entry.value;
        this.DropSlot(i);
        this.stats.removes = this.stats.removes + 1;
        return v;
    }

    public bool Remove(string key) {
        if (this.locked) {
            lock (this.gate) { return this.RemoveCore(key); }
        }
        return this.RemoveCore(key);
    }

    private bool RemoveCore(string key) {
        if (key == null) { return false; }
        int i = -1;
        if (!this.index.TryGetValue(key, out i)) {
            return false;
        }
        long exp = this.slots[i].expiresAtUs;
        if (exp != 0L && MemoryCache<TValue>.NowUs() >= exp) {
            this.DropSlot(i);
            this.stats.expirations = this.stats.expirations + 1;
            return false;
        }
        this.DropSlot(i);
        this.stats.removes = this.stats.removes + 1;
        return true;
    }

    public void Clear() {
        if (this.locked) {
            lock (this.gate) { this.ClearCore(); }
            return;
        }
        this.ClearCore();
    }

    private void ClearCore() {
        int n = this.slots.Count;
        this.index.Clear();
        if (this.capacity == 0 && n > 256) {
            // 无界缓存在 Clear 时归还峰值槽位，防止内存长期滞留
            this.slots.Clear();
            this.freeHead = -1;
        } else {
            int i = 0;
            while (i < n) {
                this.slots[i].key = "";
                this.slots[i].value = null;
                this.slots[i].expiresAtUs = 0;
                this.slots[i].touchedUs = 0;
                this.slots[i].prev = -1;
                this.slots[i].next = (i + 1 < n) ? i + 1 : -1;
                i = i + 1;
            }
            this.freeHead = n > 0 ? 0 : -1;
        }
        this.head = -1;
        this.tail = -1;
        this.used = 0;
    }

    // 回收所有已过期的槽位，返回回收个数（沿活跃 LRU 链表 O(used) 原地遍历，零临时分配）。
    public int Sweep() {
        if (this.locked) {
            lock (this.gate) { return this.SweepCore(); }
        }
        return this.SweepCore();
    }

    private int SweepCore() {
        if (this.used == 0 || this.head < 0) {
            return 0;
        }
        long now = MemoryCache<TValue>.NowUs();
        int swept = 0;
        List<CacheEntry<TValue>> sl = this.slots;
        int cur = this.head;
        while (cur >= 0) {
            CacheEntry<TValue> e = sl[cur];
            int next = e.next;
            long exp = e.expiresAtUs;
            if (exp != 0L && now >= exp) {
                this.DropSlot(cur);
                this.stats.expirations = this.stats.expirations + 1;
                swept = swept + 1;
            }
            cur = next;
        }
        return swept;
    }

    public CacheStats Stats() {
        if (this.locked) {
            lock (this.gate) { return this.StatsCore(); }
        }
        return this.StatsCore();
    }

    private CacheStats StatsCore() {
        CacheStats s = new CacheStats();
        s.hits = this.stats.hits;
        s.misses = this.stats.misses;
        s.evictions = this.stats.evictions;
        s.expirations = this.stats.expirations;
        s.sets = this.stats.sets;
        s.removes = this.stats.removes;
        return s;
    }

    // ---- 内部：槽位与 LRU ----

    private int AllocSlot() {
        if (this.freeHead >= 0) {
            int s = this.freeHead;
            CacheEntry<TValue> e = this.slots[s];
            this.freeHead = e.next;
            e.prev = -1;
            e.next = -1;
            return s;
        }
        CacheEntry<TValue> ne = new CacheEntry<TValue>();
        this.slots.Add(ne);
        return this.slots.Count - 1;
    }

    private void FreeSlot(int i) {
        CacheEntry<TValue> e = this.slots[i];
        e.key = "";
        e.value = null;
        e.expiresAtUs = 0;
        e.touchedUs = 0;
        e.prev = -1;
        e.next = this.freeHead;
        this.freeHead = i;
        this.used = this.used - 1;
    }

    private void DropSlot(int i) {
        this.index.Remove(this.slots[i].key);
        this.Unlink(i);
        this.FreeSlot(i);
    }

    private void EvictTail() {
        if (this.tail < 0) { return; }
        int t = this.tail;
        this.DropSlot(t);
        this.stats.evictions = this.stats.evictions + 1;
    }

    private void LinkHead(int i) {
        CacheEntry<TValue> e = this.slots[i];
        e.prev = -1;
        e.next = this.head;
        if (this.head >= 0) { this.slots[this.head].prev = i; }
        this.head = i;
        if (this.tail < 0) { this.tail = i; }
    }

    private void Unlink(int i) {
        CacheEntry<TValue> e = this.slots[i];
        int p = e.prev;
        int nx = e.next;
        if (p >= 0) { this.slots[p].next = nx; } else { this.head = nx; }
        if (nx >= 0) { this.slots[nx].prev = p; } else { this.tail = p; }
        e.prev = -1;
        e.next = -1;
    }
}
