using System;

namespace System.Caching;

// 缓存槽位。key == "" 表示空槽——槽位复用（空闲链表），
// 缓存写满一轮后不再新分配条目，稳态下零堆分配。
public class CacheEntry<TValue> {
    public string key;
    public TValue value;
    // 绝对过期时刻（Stopwatch 单调微秒）。0 = 永不过期。
    public long expiresAtUs;
    // 最近一次命中的单调时刻，仅用于诊断。
    public long touchedUs;
    // LRU 双向链表：槽位下标，-1 = 无。空闲槽复用 next 串成空闲链表。
    public int prev;
    public int next;

    public CacheEntry() {
        this.key = "";
        this.expiresAtUs = 0;
        this.touchedUs = 0;
        this.prev = -1;
        this.next = -1;
    }
}
