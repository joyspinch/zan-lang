namespace System.Caching;

// 缓存计数器快照。调用方拿到的是拷贝，后续缓存活动不影响它。
public class CacheStats {
    public long hits;
    public long misses;
    public long evictions;    // 容量淘汰（LRU 尾部）
    public long expirations;  // TTL 到期清除
    public long sets;
    public long removes;

    public CacheStats() {
        this.hits = 0;
        this.misses = 0;
        this.evictions = 0;
        this.expirations = 0;
        this.sets = 0;
        this.removes = 0;
    }

    // 命中率，无访问记录时返回 0。
    public double HitRate() {
        long total = this.hits + this.misses;
        if (total == 0) { return 0.0; }
        return (double)this.hits / (double)total;
    }

    // 供日志/监控直接落一行文本，避免各处自己拼格式。
    public string Line() {
        return "cache hits=" + Convert.ToString(this.hits)
            + " misses=" + Convert.ToString(this.misses)
            + " evict=" + Convert.ToString(this.evictions)
            + " expire=" + Convert.ToString(this.expirations);
    }
}
