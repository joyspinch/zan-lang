using System;

namespace Game.Board;

// 某一指令序号处的对局完整快照：棋盘与回合状态均为深拷贝，
// 用于悔棋/回滚；由 BoardMatch.Snapshot 创建。
public class BoardSnapshot {
    public GridBoard board;
    public TurnState turn;
    public int sequence;

    public BoardSnapshot(
        GridBoard board,
        TurnState turn,
        int sequence
    ) {
        this.board = board.Clone();
        this.turn = turn.Clone();
        this.sequence = sequence;
    }

    // 快照时的棋盘（只读视图，修改它不影响原对局）。
    public GridBoard Board() { return this.board; }
    // 快照时的回合状态。
    public TurnState Turn() { return this.turn; }
    // 快照时的指令顺序号。
    public int Sequence() { return this.sequence; }
}
