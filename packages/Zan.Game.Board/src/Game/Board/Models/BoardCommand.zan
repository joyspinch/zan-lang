using System;

namespace Game.Board;

// 可序列化的玩家意图。Type、Value 与 Payload 的含义由规则决定
// ；标准字段涵盖网格移动及卡牌/技能指令。
public class BoardCommand {
    public string type;
    public int player;
    public int fromX;
    public int fromY;
    public int toX;
    public int toY;
    public int amount;
    public string payload;
    public int sequence;

    // 工厂：place 指令——把格子值 cellValue 放到 (x, y)。
    public static BoardCommand Place(int player, int x, int y, int cellValue) {
        return new BoardCommand(
            "place", player, -1, -1, x, y, cellValue, "");
    }

    // 工厂：move 指令——把棋子从 (fromX, fromY) 移到 (toX, toY)。
    public static BoardCommand Move(
        int player,
        int fromX,
        int fromY,
        int toX,
        int toY
    ) {
        return new BoardCommand(
            "move", player, fromX, fromY, toX, toY, 0, "");
    }

    // 工厂：自定义 action 指令——type 为规则层自定的类型标签，
    // 携带数值 amount 与字符串 payload，不含坐标。
    public static BoardCommand Action(
        string type,
        int player,
        int amount,
        string payload
    ) {
        return new BoardCommand(
            type, player, -1, -1, -1, -1, amount, payload);
    }

    public BoardCommand(
        string type,
        int player,
        int fromX,
        int fromY,
        int toX,
        int toY,
        int amount,
        string payload
    ) {
        this.type = type;
        this.player = player;
        this.fromX = fromX;
        this.fromY = fromY;
        this.toX = toX;
        this.toY = toY;
        this.amount = amount;
        this.payload = payload;
        this.sequence = 0;
    }

    // 指令类型标签（"place"/"move" 或 Action 传入的自定义类型）。
    public string Type() { return this.type; }
    // 发起指令的玩家编号。
    public int Player() { return this.player; }
    // 起点 X（place/action 类为 -1）。
    public int FromX() { return this.fromX; }
    // 起点 Y（place/action 类为 -1）。
    public int FromY() { return this.fromY; }
    // 终点 X（action 类为 -1）。
    public int ToX() { return this.toX; }
    // 终点 Y（action 类为 -1）。
    public int ToY() { return this.toY; }
    // 数值参数（place 为格子值，action 为 amount）。
    public int Value() { return this.amount; }
    // 附加字符串（place/move 为空串）。
    public string Payload() { return this.payload; }
    // 应用顺序号（由 BoardMatch.TryApply 分配，从 1 递增）。
    public int Sequence() { return this.sequence; }
    // 由对局在应用成功时回填顺序号；外部一般不应调用。
    public void SetSequence(int sequence) { this.sequence = sequence; }
}
