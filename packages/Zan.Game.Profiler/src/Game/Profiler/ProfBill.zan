using System;

namespace Game.Profiler;

// prof 走廊的**账单行格式**（契约）。
//
// **为什么要有契约**：逐段计时的账单现在只往 stdout 打，人只能肉眼看；没有
// 稳定格式，账单就没法进 CI、没法回归、没法被别的工具读。本包给账单一个
// 明确格式，并且**写端与读端是同一份定义**——采集端打出来的行，解析端一定
// 认得。
//
// 行的形状：
//
//     prof frame=12 scope=update ms=3.210
//     prof frame=12 scope=render ms=9.870
//     prof frame=12 total=16.700
//
// 规则：
//   - 前缀固定 "prof "；后面是空格分隔的 key=value。
//   - `frame` 必填（帧号，整数）。
//   - 一行要么是"某个分段"（scope + ms），要么是"整帧"（total），不能同时。
//   - scope 名不许带空格，字符集限 `[A-Za-z0-9_.:-]`——账单是空格分隔的，
//     名字里带空格就没法解析（分隔不开）。
//   - 未知 key 忽略（前向兼容：以后加 key 不用改旧解析器）。
//   - 毫秒值固定 3 位小数（`ProfNum.Fixed`）——报告与账单要对得上，位数必须
//     固定，不能是"最短往返表示"。
public class ProfBill {
    // 账单行前缀。
    public static string Prefix() { return "prof "; }

    // 分段行：prof frame=12 scope=update ms=3.210
    public static string ScopeLine(long frame, string scope, double ms) {
        return "prof frame=" + frame.ToString() + " scope=" + scope + " ms=" + ProfNum.Fixed(ms, 3);
    }

    // 整帧行：prof frame=12 total=16.700
    public static string TotalLine(long frame, double ms) {
        return "prof frame=" + frame.ToString() + " total=" + ProfNum.Fixed(ms, 3);
    }

    // 分段名是否合法：非空，字符集 `[A-Za-z0-9_.:-]`。
    public static bool IsScopeName(string name) {
        if (name == null || name.Length == 0) { return false; }
        for (int i = 0; i < name.Length; i = i + 1) {
            int c = name[i] & 255;
            bool digit = c >= 48 && c <= 57;          // 0-9
            bool upper = c >= 65 && c <= 90;          // A-Z
            bool lower = c >= 97 && c <= 122;         // a-z
            bool punct = c == 95 || c == 46 || c == 58 || c == 45;  // _ . : -
            if (!digit && !upper && !lower && !punct) { return false; }
        }
        return true;
    }
}
