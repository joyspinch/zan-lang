using System;

namespace Game.Profiler;

// 帧剖析的异常。
//
// **异常 + 错误码两个通道**：人看 `Message`（异常自带），程序看 `error`。
// 调用方要能**按原因分支**——账单行坏了要"跳过这行继续"，分段没闭合要
// "补一个 EndScope 再收工"，预算给错了要"改调用方"。合成一句话会让这些
// 分支都做不了。
public class ProfilerException : Exception {
    // 错误码。
    public ProfError error;

    public ProfilerException(ProfError error, string text) : base(text) {
        this.error = error;
    }

    // 带细节的构造：细节拼进消息（调用方要展示给人看时不必自己拼）。
    public ProfilerException(ProfError error, string text, string detail) : base(ProfilerException.Combine(text, detail)) {
        this.error = error;
    }

    // 消息与细节的拼接（只能在 base(...) 里算，所以提成静态方法）。
    static string Combine(string text, string detail) {
        if (detail == null || detail.Length == 0) { return text; }
        return text + ": " + detail;
    }

    // 错误码的英文名（调试输出用；不依赖枚举的字符串格式化行为）。
    public string ErrorName() {
        if (this.error == ProfError.None) { return "None"; }
        if (this.error == ProfError.InvalidBudget) { return "InvalidBudget"; }
        if (this.error == ProfError.InvalidScopeName) { return "InvalidScopeName"; }
        if (this.error == ProfError.ScopeNotClosed) { return "ScopeNotClosed"; }
        if (this.error == ProfError.FrameNotOpen) { return "FrameNotOpen"; }
        if (this.error == ProfError.FrameAlreadyOpen) { return "FrameAlreadyOpen"; }
        if (this.error == ProfError.MalformedLine) { return "MalformedLine"; }
        if (this.error == ProfError.EmptySample) { return "EmptySample"; }
        return "Unknown";
    }
}
