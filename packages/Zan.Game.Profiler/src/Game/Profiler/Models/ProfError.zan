namespace Game.Profiler;

// 帧剖析的错误原因（可区分的错误码）。
//
// **为什么要错误码**：剖析失败的原因差别很大——"账单行写坏了"是采集端的
// 格式问题，"分段没闭合"是采集端的时序问题，"帧预算不合法"是调用方给错
// 参数了。合成一句话会让调用方没法分别处理：账单坏了要跳过那行继续，
// 参数给错了要立刻改代码。
public enum ProfError {
    // 没有错误。
    None = 0,
    // 帧预算不合法（<= 0 毫秒）。
    InvalidBudget = 1,
    // 分段名不合法（空名 / 含非法字符 / 含空格）。
    InvalidScopeName = 2,
    // EndScope 时没有开着的分段（分段没闭合，或多闭合了一次）。
    ScopeNotClosed = 3,
    // EndFrame 时没有开着的帧。
    FrameNotOpen = 4,
    // BeginFrame 时上一帧还没关。
    FrameAlreadyOpen = 5,
    // 账单行格式不对（缺 frame / 缺 ms / 数值解析失败 / scope 名非法）。
    MalformedLine = 6,
    // 要分析的样本是空的。
    EmptySample = 7,
}
