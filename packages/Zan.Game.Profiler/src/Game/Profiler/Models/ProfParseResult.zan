using System;
using System.Collections.Generic;

namespace Game.Profiler;

// 解析一份账单的结果。
//
// **坏行不抛异常**：账单是往 stdout 打的，里面混着游戏自己的日志是常态，
// 某一行的数值写坏了也常见。解析器把坏行**跳过并计数**，好行照常解析——
// 一份账单里有一行坏了，不该让整份账单作废。
public class ProfParseResult {
    // 解析出的帧（按帧号升序）。
    public List<FrameSample> frames;
    // 跳过的坏行数。
    public int skipped;
    // 第一个坏行对应的错误码（没有坏行时是 None）。
    public ProfError firstError;

    public ProfParseResult() {
        this.frames = new List<FrameSample>();
        this.skipped = 0;
        this.firstError = ProfError.None;
    }

    public int FrameCount() { return this.frames.Count; }
}
