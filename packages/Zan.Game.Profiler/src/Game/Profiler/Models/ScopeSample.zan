namespace Game.Profiler;

// 帧内的一个分段计时。
//
// **同名分段会合并**：一帧里 `update` 被调用 3 次，账单里就是 3 行
// `scope=update`；解析后合成一条——`ms` 累加，`calls` 记次数。热点分析要按
// "这个分段在帧里一共花了多少"排序，不是按"最长的那一次"排序，所以必须合并。
public class ScopeSample {
    // 分段名（账单里的 scope=）。
    public string name;
    // 该帧内这个分段的累计耗时（毫秒）。
    public double ms;
    // 该帧内这个分段被计了多少次。
    public int calls;

    public ScopeSample(string name, double ms) {
        this.name = name;
        this.ms = ms;
        this.calls = 1;
    }

    // 合并另一个同名分段的耗时（次数 +1）。
    public void Add(double moreMs) {
        this.ms = this.ms + moreMs;
        this.calls = this.calls + 1;
    }
}
