namespace System.Security.Permissions;

// 跨平台设备能力与敏感权限枚举
public enum DeviceCapability {
    Camera         = 1, // 摄像头
    Microphone     = 2, // 麦克风/录音
    LocationFine   = 3, // 精确 GPS 定位
    LocationCoarse = 4, // 粗略网络/基站定位
    StorageRead    = 5, // 外部/相册存储读取
    StorageWrite   = 6, // 外部/相册存储写入
    Notification   = 7, // 推送通知
    Bluetooth      = 8  // 蓝牙外设访问
}
