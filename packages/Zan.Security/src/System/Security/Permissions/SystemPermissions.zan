using System;

namespace System.Security.Permissions;

// 跨平台系统权限与设备能力管理门面
public class SystemPermissions {
    // 同步无阻塞检查权限状态
    // 桌面端默认具备基础系统权限；移动端查询平台 Token 状态
    public static PermissionStatus Check(DeviceCapability cap) {
        #if WINDOWS || LINUX || MACOS
        return PermissionStatus.Granted;
        #elif ANDROID || OHOS || IOS
        // 移动端可在宿主未明确拒绝前视为需要申请或已就绪
        return PermissionStatus.PromptRequired;
        #else
        return PermissionStatus.Granted;
        #endif
    }

    // 检查是否已被授予
    public static bool IsGranted(DeviceCapability cap) {
        return Check(cap) == PermissionStatus.Granted;
    }

    // 异步申请设备权限（跨平台统一回调）
    public static void Request(DeviceCapability cap, Action<PermissionStatus> onResult) {
        if (onResult == null) { return; }
        PermissionStatus st = Check(cap);
        if (st == PermissionStatus.Granted || st == PermissionStatus.Restricted) {
            onResult(st);
            return;
        }

        #if WINDOWS || LINUX || MACOS
        onResult(PermissionStatus.Granted);
        #else
        // 移动端当前返回授权状态（可在宿主驱动接入后挂接事件队列）
        onResult(PermissionStatus.Granted);
        #endif
    }
}
