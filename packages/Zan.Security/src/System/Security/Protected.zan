using System;
using System.Threading;
namespace System.Security;

// 面向内存扫描器可能针对的值的防篡改整数（分数、
// 金币、黄金）。明文从不存储：它以 XOR 掩码形式与
// 冗余的反向副本一起存放，因此工具在内存中找到并覆写该数值时，
// 会破坏这一不变式，<see cref="Get"/> 将触发防护。请
// 只用于少数值得保护的值，而不是每帧的热点计算。
public class Protected {
    int mask;  // value ^ KEY
    int chk;  // ~(value ^ KEY)

    public Protected() {}

    // 混淆用的固定 XOR 密钥（非加密材料，只为让明文不直接落内存）。
    private static int Key() { return 1719923209; }

    // 创建一个初始化为 <paramref name="v"/> 的受保护值。
    public static Protected Of(int v) {
        Protected p = new Protected();
        p.Set(v);
        return p;
    }

    // 存储新值并刷新完整性校验。
    public void Set(int v) {
        this.mask = v ^ Protected.Key();
        this.chk = ~this.mask;
    }

    // 返回存储的值；若两份副本不一致则触发防护
    // （即内存被外部修改）。
    public int Get() {
        if ((this.mask ^ this.chk) != -1) { Guard.Trip(); }
        return this.mask ^ Protected.Key();
    }

    // 将 <paramref name="d"/> 加到存储的值上。
    public void Add(int d) { this.Set(this.Get() + d); }
}
