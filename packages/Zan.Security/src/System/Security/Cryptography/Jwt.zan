using System;
using System.Interop;
using System.Json;
using System.Text;
namespace System.Security.Cryptography;

// 紧凑 JWS 令牌的 JSON Web Token 辅助函数。支持 HS256 和 RS256；
// 不安全（`none`）令牌及一切未被请求的算法都会被拒绝。解析
// 使用调用方提供的 Unix 时间戳，因此 exp/nbf 校验结果是确定性的。
// 预期的 issuer/audience 为空字符串时，仅禁用各自的校验。
public class Jwt {
    // 令牌总长上限（128 KiB）。
    public static int maxTokenSize() { return 131072; }
    // header 段解码后字节上限（8 KiB）。
    public static int maxHeaderSize() { return 8192; }
    // payload 段解码后字节上限（64 KiB）。
    public static int maxPayloadSize() { return 65536; }

    // Base64Url 字母表（RFC 4648 §5，`-_` 代替 `+/`，无填充）。
    public static string urlAlphabet() {
        return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
    }

    // Base64Url 字符 -> 6 位值；非法字符返回 -1。
    public static int urlDigit(int c) {
        if (c >= 65 && c <= 90) { return c - 65; }
        if (c >= 97 && c <= 122) { return c - 71; }
        if (c >= 48 && c <= 57) { return c + 4; }
        if (c == 45) { return 62; }
        if (c == 95) { return 63; }
        return -1;
    }

    // 将恰好 <paramref name="len"/> 字节编码为无填充的 RFC 4648 Base64Url（4 倍展开）。
    public static string Base64UrlEncode(string bytes, int len) {
        if (bytes == null || len <= 0 || len > bytes.Length) { return ""; }
        string a = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
        int rem = len % 3;
        int outLen = (len / 3) * 4 + (rem == 0 ? 0 : (rem == 1 ? 2 : 3));
        byte[] outBuf = new byte[outLen];
        int di = 0;
        int i = 0;
        while (i + 12 <= len) {
            int n0 = ((bytes[i] & 255) << 16) | ((bytes[i + 1] & 255) << 8) | (bytes[i + 2] & 255);
            int n1 = ((bytes[i + 3] & 255) << 16) | ((bytes[i + 4] & 255) << 8) | (bytes[i + 5] & 255);
            int n2 = ((bytes[i + 6] & 255) << 16) | ((bytes[i + 7] & 255) << 8) | (bytes[i + 8] & 255);
            int n3 = ((bytes[i + 9] & 255) << 16) | ((bytes[i + 10] & 255) << 8) | (bytes[i + 11] & 255);
            outBuf[di]      = (byte)(a[(n0 >> 18) & 63] & 255);
            outBuf[di + 1]  = (byte)(a[(n0 >> 12) & 63] & 255);
            outBuf[di + 2]  = (byte)(a[(n0 >> 6) & 63] & 255);
            outBuf[di + 3]  = (byte)(a[n0 & 63] & 255);
            outBuf[di + 4]  = (byte)(a[(n1 >> 18) & 63] & 255);
            outBuf[di + 5]  = (byte)(a[(n1 >> 12) & 63] & 255);
            outBuf[di + 6]  = (byte)(a[(n1 >> 6) & 63] & 255);
            outBuf[di + 7]  = (byte)(a[n1 & 63] & 255);
            outBuf[di + 8]  = (byte)(a[(n2 >> 18) & 63] & 255);
            outBuf[di + 9]  = (byte)(a[(n2 >> 12) & 63] & 255);
            outBuf[di + 10] = (byte)(a[(n2 >> 6) & 63] & 255);
            outBuf[di + 11] = (byte)(a[n2 & 63] & 255);
            outBuf[di + 12] = (byte)(a[(n3 >> 18) & 63] & 255);
            outBuf[di + 13] = (byte)(a[(n3 >> 12) & 63] & 255);
            outBuf[di + 14] = (byte)(a[(n3 >> 6) & 63] & 255);
            outBuf[di + 15] = (byte)(a[n3 & 63] & 255);
            di = di + 16;
            i = i + 12;
        }
        while (i + 3 <= len) {
            int n = ((bytes[i] & 255) << 16) | ((bytes[i + 1] & 255) << 8) | (bytes[i + 2] & 255);
            outBuf[di]     = (byte)(a[(n >> 18) & 63] & 255);
            outBuf[di + 1] = (byte)(a[(n >> 12) & 63] & 255);
            outBuf[di + 2] = (byte)(a[(n >> 6) & 63] & 255);
            outBuf[di + 3] = (byte)(a[n & 63] & 255);
            di = di + 4;
            i = i + 3;
        }
        if (rem == 1) {
            int n = (bytes[i] & 255) << 16;
            outBuf[di]     = (byte)(a[(n >> 18) & 63] & 255);
            outBuf[di + 1] = (byte)(a[(n >> 12) & 63] & 255);
        } else if (rem == 2) {
            int n = ((bytes[i] & 255) << 16) | ((bytes[i + 1] & 255) << 8);
            outBuf[di]     = (byte)(a[(n >> 18) & 63] & 255);
            outBuf[di + 1] = (byte)(a[(n >> 12) & 63] & 255);
            outBuf[di + 2] = (byte)(a[(n >> 6) & 63] & 255);
        }
        return outBuf.ToStr(0, outLen);
    }

    // 严格解码无填充的 Base64Url。outLen[0] 为字节数，输入格式错误时为 -1。
    public static byte[] Base64UrlDecode(string text, List<int> outLen) {
        if (text == null) {
            if (outLen != null && outLen.Count > 0) { outLen[0] = -1; }
            return new byte[0];
        }
        int len = text.Length;
        if ((len & 3) == 1) {
            if (outLen != null && outLen.Count > 0) { outLen[0] = -1; }
            return new byte[len];
        }
        int maxDecoded = (len * 3) / 4 + 4;
        byte[] result = new byte[maxDecoded];
        long written = NativeMemory.Base64Decode(result, text, (long)len);
        if (written >= 0) {
            if (outLen != null && outLen.Count > 0) { outLen[0] = (int)written; }
            return result;
        }
        if (outLen != null && outLen.Count > 0) { outLen[0] = -1; }
        return new byte[len];
    }

    // 从 `from` 起第一个 '.' 的下标；没有则 -1。
    private static int dotAt(string token, int from) {
        int i = from;
        while (i < token.Length) {
            if ((token[i] & 255) == 46) { return i; }
            i = i + 1;
        }
        return -1;
    }

    // 常量时间比较（长度差也并入累积差），防签名校验的时序侧信道。
    public static bool fixedEquals(string actual, int actualLen, string expected, int expectedLen) {
        int diff = actualLen ^ expectedLen;
        for (int i = 0; i < expectedLen; i = i + 1) {
            int a = 0;
            if (i < actualLen) { a = actual[i] & 255; }
            diff = diff | (a ^ (expected[i] & 255));
        }
        return diff == 0;
    }

    // JSON 树中对象层是否存在重复键（重复键会改变语义，按非法拒绝）。
    public static bool hasDuplicateKeys(JsonValue node) {
        if (node.IsObject()) {
            for (int i = 0; i < node.Count(); i = i + 1) {
                string key = node.KeyAt(i);
                for (int j = 0; j < i; j = j + 1) {
                    if (node.KeyAt(j) == key) { return true; }
                }
                if (Jwt.hasDuplicateKeys(node.ValAt(i))) { return true; }
            }
        } else if (node.IsArray()) {
            for (int i = 0; i < node.Count(); i = i + 1) {
                if (Jwt.hasDuplicateKeys(node.At(i))) { return true; }
            }
        }
        return false;
    }

    private static bool keysEqual(JsonDoc doc, JsonPair p1, JsonPair p2) {
        if (p1.keyLen != p2.keyLen) { return false; }
        int len = p1.keyLen;
        if (len == 0) { return true; }
        if (p1.keyStart >= 0 && p2.keyStart >= 0) {
            byte[] buf = doc.buf;
            int s1 = p1.keyStart;
            int s2 = p2.keyStart;
            if (buf[s1] != buf[s2] || buf[s1 + len - 1] != buf[s2 + len - 1]) {
                return false;
            }
            for (int m = 1; m < len - 1; m = m + 1) {
                if (buf[s1 + m] != buf[s2 + m]) { return false; }
            }
            return true;
        }
        string k1 = p1.keyStart >= 0 ? doc.src.Substring(p1.keyStart, len) : doc.escPool[p1.keyLen];
        string k2 = p2.keyStart >= 0 ? doc.src.Substring(p2.keyStart, len) : doc.escPool[p2.keyLen];
        return k1 == k2;
    }

    // JsonDoc 中对象层是否存在重复键（单向链表遍历 + 首尾快筛 + 基元结构剪枝，零堆分配）。
    public static bool hasDuplicateKeysDoc(JsonDoc doc, int node) {
        if (doc == null || node < 0 || node >= doc.slotCount) { return false; }
        int k = doc.KindAt(node);
        if (k == 5) {
            int p1 = (int)(doc.slots[node].a >> 8);
            while (p1 >= 0) {
                JsonPair pair1 = doc.pairs[p1];
                int p2 = pair1.nextPair;
                while (p2 >= 0) {
                    JsonPair pair2 = doc.pairs[p2];
                    if (Jwt.keysEqual(doc, pair1, pair2)) { return true; }
                    p2 = pair2.nextPair;
                }
                if (pair1.valueSlot >= 0) {
                    int vk = doc.KindAt(pair1.valueSlot);
                    if (vk >= 4 && Jwt.hasDuplicateKeysDoc(doc, pair1.valueSlot)) {
                        return true;
                    }
                }
                p1 = pair1.nextPair;
            }
        } else if (k == 4) {
            int child = doc.FirstChild(node);
            int count = doc.Count(node);
            for (int i = 0; i < count; i = i + 1) {
                if (child >= 0) {
                    int ck = doc.KindAt(child);
                    if (ck >= 4 && Jwt.hasDuplicateKeysDoc(doc, child)) { return true; }
                    child = doc.NextSibling(child);
                }
            }
        }
        return false;
    }

    // 读 JWT NumericDate（纯数字串）到 result[0]；非数字或溢出 long 时
    // 返回 false。
    private static bool readNumericDate(JsonValue node, List<long> result) {
        if (node == null || !node.IsNumber()) { return false; }
        if (node.numIsInt && node.numI >= 0) {
            result[0] = node.numI;
            return true;
        }
        string raw = node.AsString("");
        if (raw.Length == 0) { return false; }
        long number = 0;
        for (int i = 0; i < raw.Length; i = i + 1) {
            int digit = (raw[i] & 255) - 48;
            if (digit < 0 || digit > 9) { return false; }
            if (number > 922337203685477580 ||
                (number == 922337203685477580 && digit > 7)) { return false; }
            number = number * 10 + (long)digit;
        }
        result[0] = number;
        return true;
    }

    // 基于 JsonDoc 的零分配 NumericDate 读取。
    private static bool readNumericDateDoc(JsonDoc doc, int slot, List<long> result) {
        if (slot < 0 || doc == null || doc.KindAt(slot) != 2) { return false; }
        int rawKind = (int)(doc.slots[slot].a & 255);
        if (rawKind == 2 && doc.slots[slot].b >= 0L) {
            result[0] = doc.slots[slot].b;
            return true;
        }
        string raw = doc.StrAt(slot, "");
        if (raw.Length == 0) { return false; }
        long number = 0;
        for (int i = 0; i < raw.Length; i = i + 1) {
            int digit = (raw[i] & 255) - 48;
            if (digit < 0 || digit > 9) { return false; }
            if (number > 922337203685477580L ||
                (number == 922337203685477580L && digit > 7)) { return false; }
            number = number * 10 + (long)digit;
        }
        result[0] = number;
        return true;
    }

    // 构造校验失败的 JwtToken：valid=false，error 为固定文案，无内容。
    private static JwtToken fail(string error) {
        JwtToken result = new JwtToken();
        result.valid = false;
        result.error = error;
        result.headerJson = "";
        result.payloadJson = "";
        return result;
    }

    // 拆分三段式令牌并解码：限长、Base64Url、JSON 对象、重复键与
    // header.alg 必须恰为 `algorithm`；失败返回带错误文案的 token。
    private static JwtToken parseParts(string token, string algorithm) {
        if (token == null) { return Jwt.fail("null token"); }
        if (token.Length > Jwt.maxTokenSize()) { return Jwt.fail("token too large"); }
        int first = Jwt.dotAt(token, 0);
        int second = -1;
        if (first >= 0) { second = Jwt.dotAt(token, first + 1); }
        if (first <= 0 || second <= first + 1 || second >= token.Length - 1
            || Jwt.dotAt(token, second + 1) >= 0) {
            return Jwt.fail("malformed token");
        }
        if (first > 10923 || second - first - 1 > 87382) {
            return Jwt.fail("jwt part too large");
        }
        List<int> len = new List<int>(); len.Add(0);
        byte[] headerBytes = Jwt.Base64UrlDecode(token.Substring(0, first), len);
        if (len[0] < 0) { return Jwt.fail("malformed base64url"); }
        if (len[0] > Jwt.maxHeaderSize()) { return Jwt.fail("header too large"); }
        string headerJson = headerBytes.ToStr(0, len[0]);
        byte[] payloadBytes = Jwt.Base64UrlDecode(token.Substring(first + 1, second - first - 1), len);
        if (len[0] < 0) { return Jwt.fail("malformed base64url"); }
        if (len[0] > Jwt.maxPayloadSize()) { return Jwt.fail("payload too large"); }
        string payloadJson = payloadBytes.ToStr(0, len[0]);
        JwtToken result = new JwtToken();
        result.headerJson = headerJson;
        result.payloadJson = payloadJson;
        try {
            result.headerDoc = JsonDoc.Parse(headerJson);
            result.payloadDoc = JsonDoc.Parse(payloadJson);
        } catch (JsonException e) {
            return Jwt.fail("malformed json");
        }
        if (result.headerDoc == null || result.headerDoc.root < 0 || result.headerDoc.KindAt(result.headerDoc.root) != 5
            || result.payloadDoc == null || result.payloadDoc.root < 0 || result.payloadDoc.KindAt(result.payloadDoc.root) != 5) {
            return Jwt.fail("jwt json must be objects");
        }
        if (Jwt.hasDuplicateKeysDoc(result.headerDoc, result.headerDoc.root) || Jwt.hasDuplicateKeysDoc(result.payloadDoc, result.payloadDoc.root)) {
            return Jwt.fail("duplicate json key");
        }
        int algSlot = result.headerDoc.Get(result.headerDoc.root, "alg");
        if (algSlot < 0 || result.headerDoc.KindAt(algSlot) != 3 || result.headerDoc.StrAt(algSlot, "") != algorithm) {
            return Jwt.fail("algorithm rejected");
        }
        result.error = "";
        return result;
    }

    // 按调用方提供的 now 校验 exp/nbf（NumericDate）与 iss/aud
    // （空串关闭对应校验）；通过返回 ""，否则返回错误文案。
    private static string validateClaims(JwtToken token, long now, string issuer, string audience) {
        JsonDoc payload = token.payloadDoc;
        if (payload == null || payload.root < 0) { return "malformed json"; }
        int root = payload.root;
        List<long> numericDate = new List<long>(); numericDate.Add(0);
        int expSlot = payload.Get(root, "exp");
        if (expSlot >= 0) {
            if (!Jwt.readNumericDateDoc(payload, expSlot, numericDate)) { return "invalid exp"; }
            if (now >= numericDate[0]) { return "token expired"; }
        }
        int nbfSlot = payload.Get(root, "nbf");
        if (nbfSlot >= 0) {
            if (!Jwt.readNumericDateDoc(payload, nbfSlot, numericDate)) { return "invalid nbf"; }
            if (now < numericDate[0]) { return "token not active"; }
        }
        if (issuer != null && issuer.Length > 0) {
            int issSlot = payload.Get(root, "iss");
            if (issSlot < 0 || payload.KindAt(issSlot) != 3 || payload.StrAt(issSlot, "") != issuer) {
                return "issuer mismatch";
            }
        }
        if (audience != null && audience.Length > 0) {
            int audSlot = payload.Get(root, "aud");
            bool match = false;
            if (audSlot >= 0 && payload.KindAt(audSlot) == 3) {
                match = payload.StrAt(audSlot, "") == audience;
            } else if (audSlot >= 0 && payload.KindAt(audSlot) == 4) {
                int child = payload.FirstChild(audSlot);
                int count = payload.Count(audSlot);
                for (int i = 0; i < count; i = i + 1) {
                    if (payload.KindAt(child) == 3 && payload.StrAt(child, "") == audience) {
                        match = true;
                    }
                    child = payload.NextSibling(child);
                }
            }
            if (!match) { return "audience mismatch"; }
        }
        return "";
    }

    static const string Hs256Header = "{\"alg\":\"HS256\",\"typ\":\"JWT\"}";
    static const string Rs256Header = "{\"alg\":\"RS256\",\"typ\":\"JWT\"}";

    // 由对象形式的 payload JSON 和带字节数的密钥创建 HS256 紧凑 JWT。
    public static string CreateHs256(string payloadJson, string secret, int secretLen) {
        if (payloadJson == null || secret == null || secretLen < 0 || secretLen > secret.Length
            || payloadJson.Length > Jwt.maxPayloadSize()) { return ""; }
        JsonDoc doc = null;
        try { doc = JsonDoc.Parse(payloadJson); } catch (Exception e) { return ""; }
        if (doc == null || doc.root < 0 || doc.KindAt(doc.root) != 5 || Jwt.hasDuplicateKeysDoc(doc, doc.root)) { return ""; }
        string header = Jwt.Hs256Header;
        string signing = Jwt.Base64UrlEncode(header, header.Length) + "."
            + Jwt.Base64UrlEncode(payloadJson, payloadJson.Length);
        byte[] mac = Hmac.Sha256Mac(secret, secretLen, signing, signing.Length);
        return signing + "." + Jwt.Base64UrlEncode(mac, 32);
    }

    // 仅解析并校验 HS256，然后对照显式输入验证 exp、nbf、iss 和 aud。
    public static JwtToken ParseHs256(string token, string secret, int secretLen,
        long now, string issuer, string audience) {
        if (token == null || secret == null || secretLen < 0 || secretLen > secret.Length) {
            return Jwt.fail("invalid parameters");
        }
        JwtToken result = Jwt.parseParts(token, "HS256");
        if (result.error.Length > 0) { return result; }
        int second = Jwt.dotAt(token, Jwt.dotAt(token, 0) + 1);
        string signing = token.Substring(0, second);
        string sigText = token.Substring(second + 1, token.Length - second - 1);
        List<int> sigLen = new List<int>(); sigLen.Add(0);
        byte[] signature = Jwt.Base64UrlDecode(sigText, sigLen);
        byte[] expected = Hmac.Sha256Mac(secret, secretLen, signing, signing.Length);
        if (sigLen[0] < 0 || !Jwt.fixedEquals(signature, sigLen[0], expected, 32)) {
            return Jwt.fail("signature mismatch");
        }
        string claimError = Jwt.validateClaims(result, now, issuer, audience);
        if (claimError.Length > 0) { return Jwt.fail(claimError); }
        result.valid = true;
        return result;
    }

    // 用 RSA 私钥创建 RS256 紧凑 JWT；密钥无法签名时返回空。
    public static string CreateRs256(string payloadJson, RsaKey privateKey) {
        if (payloadJson == null || privateKey == null || payloadJson.Length > Jwt.maxPayloadSize()) { return ""; }
        JsonDoc doc = null;
        try { doc = JsonDoc.Parse(payloadJson); } catch (Exception e) { return ""; }
        if (doc == null || doc.root < 0 || doc.KindAt(doc.root) != 5 || Jwt.hasDuplicateKeysDoc(doc, doc.root)) { return ""; }
        string header = Jwt.Rs256Header;
        string signing = Jwt.Base64UrlEncode(header, header.Length) + "."
            + Jwt.Base64UrlEncode(payloadJson, payloadJson.Length);
        string signatureBase64 = privateKey.SignSha256(signing);
        if (signatureBase64.Length == 0) { return ""; }
        List<int> sigLen = new List<int>(); sigLen.Add(0);
        byte[] signature = Base64.Decode(signatureBase64, sigLen);
        return signing + "." + Jwt.Base64UrlEncode(signature, sigLen[0]);
    }

    // 仅解析并校验 RS256，然后对照显式输入验证 exp、nbf、iss 和 aud。
    public static JwtToken ParseRs256(string token, RsaKey publicKey,
        long now, string issuer, string audience) {
        if (token == null || publicKey == null) { return Jwt.fail("invalid parameters"); }
        JwtToken result = Jwt.parseParts(token, "RS256");
        if (result.error.Length > 0) { return result; }
        int second = Jwt.dotAt(token, Jwt.dotAt(token, 0) + 1);
        string signing = token.Substring(0, second);
        string sigText = token.Substring(second + 1, token.Length - second - 1);
        List<int> sigLen = new List<int>(); sigLen.Add(0);
        byte[] signature = Jwt.Base64UrlDecode(sigText, sigLen);
        if (sigLen[0] < 0 || !publicKey.VerifySha256(signing, Base64.Encode(signature, sigLen[0]))) {
            return Jwt.fail("signature mismatch");
        }
        string claimError = Jwt.validateClaims(result, now, issuer, audience);
        if (claimError.Length > 0) { return Jwt.fail(claimError); }
        result.valid = true;
        return result;
    }
}
