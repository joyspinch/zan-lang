using System;

namespace System.Security.Cryptography;

// Secp256k1 椭圆曲线 ECDSA 签名实体，包含 (r, s, v) 及以太坊特化的低 s 防延展表示。
public class Secp256k1Signature {

    public byte[] R; // 32 字节大端标量 r
    public byte[] S; // 32 字节大端标量 s (必须满足 s <= n/2)
    public int V;    // 恢复标识符 (0 或 1，未经 EIP-155 变换)

    public Secp256k1Signature(byte[] r, byte[] s, int v) {
        R = new byte[32];
        S = new byte[32];
        if (r != null && r.Length == 32) {
            for (int i = 0; i < 32; i = i + 1) { R[i] = r[i]; }
        }
        if (s != null && s.Length == 32) {
            for (int i = 0; i < 32; i = i + 1) { S[i] = s[i]; }
        }
        V = v;
    }

    // 输出 65 字节紧凑字节数组 (R || S || V)
    public byte[] ToCompactBytes() {
        byte[] b = new byte[65];
        for (int i = 0; i < 32; i = i + 1) {
            b[i] = R[i];
            b[32 + i] = S[i];
        }
        b[64] = (byte)(V & 255);
        return b;
    }

    // 输出标准的 130 字符小写十六进制字符串（带 0x 前缀）
    public string ToHex() {
        return "0x" + Hex.Encode(ToCompactBytes(), 65);
    }

    // 从 65 字节十六进制字符串解析 (带或不带 0x)
    public static Secp256k1Signature Parse(string hex) {
        if (hex == null) { return null; }
        string clean = hex.Trim();
        if (clean.StartsWith("0x") || clean.StartsWith("0X")) {
            clean = clean.Substring(2);
        }
        if (clean.Length != 130) { return null; }
        byte[] raw = Hex.Decode(clean, 130);
        if (raw == null || raw.Length != 65) { return null; }

        byte[] r = new byte[32];
        byte[] s = new byte[32];
        for (int i = 0; i < 32; i = i + 1) {
            r[i] = raw[i];
            s[i] = raw[32 + i];
        }
        int v = raw[64] & 255;
        // 如果 v 是 27 或 28 (Legacy 格式)，转为 0 或 1
        if (v == 27 || v == 28) {
            v = v - 27;
        }
        return new Secp256k1Signature(r, s, v);
    }
}
