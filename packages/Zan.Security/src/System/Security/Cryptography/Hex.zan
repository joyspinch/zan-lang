using System;

namespace System.Security.Cryptography;

// 原始字节缓冲区的小写十六进制编解码。
public class Hex {
    private static string EncodePtr(nint src, int len) {
        string digits = "0123456789abcdef";
        nint p = NativeMemory.Alloc(2 * len + 1);
        Span<byte> inSp = new Span<byte>(src, len);
        Span<byte> sp = new Span<byte>(p, 2 * len + 1);
        for (int i = 0; i < len; i = i + 1) {
            int v = inSp[i] & 255;
            sp[2 * i] = (byte)(digits[v >> 4] & 255);
            sp[2 * i + 1] = (byte)(digits[v & 15] & 255);
        }
        string r = NativeMemory.GetString(p, 0, 2 * len);
        NativeMemory.Free(p);
        return r;
    }

    // 将 buf 的前 len 字节编码为小写十六进制字符串。
    public static string Encode(string buf, int len) {
        if (buf == null || len <= 0) { return ""; }
        if (len > buf.Length) { len = buf.Length; }
        return EncodePtr(buf, len);
    }

    // 将 byte[] 缓冲区的前 len 字节编码为小写十六进制字符串。
    public static string Encode(byte[] buf, int len) {
        if (buf == null || len <= 0) { return ""; }
        if (len > buf.Length) { len = buf.Length; }
        return EncodePtr((nint)buf, len);
    }

    // 将整个 byte[] 缓冲区编码为小写十六进制字符串。
    public static string Encode(byte[] buf) {
        if (buf == null) { return ""; }
        return Encode(buf, buf.Length);
    }

    // 单个十六进制字符转数值（0-9、a-f、A-F）；其余字符返回 0（不报错）。
    private static int nibble(int c) {
        if (c >= 48 && c <= 57) { return c - 48; }
        if (c >= 97 && c <= 102) { return c - 87; }
        if (c >= 65 && c <= 70) { return c - 55; }
        return 0;
    }

    // 将十六进制字符串解码为 hex.Length / 2 字节的缓冲区。
    public static byte[] Decode(string hex) {
        if (hex == null) { return new byte[0]; }
        return Decode(hex, hex.Length);
    }

    public static byte[] Decode(string hex, int hexLen) {
        if (hex == null || hexLen <= 0) { return new byte[0]; }
        if (hexLen > hex.Length) { hexLen = hex.Length; }
        int n = hexLen / 2;
        byte[] outb = new byte[n];
        for (int i = 0; i < n; i = i + 1) {
            outb[i] = ((nibble(hex[2*i] & 255) << 4) | nibble(hex[2*i+1] & 255)) & 255;
        }
        return outb;
    }
}
