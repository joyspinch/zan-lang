using System;

namespace System.Security.Cryptography;

/// <summary>对原始字节缓冲区进行小写十六进制编解码
/// （Zan 字符串当作字节数组使用）。</summary>
class Hex {

    /// <summary>将 <paramref name="buf"/> 的 <paramref name="len"/> 字节
    /// 编码为小写十六进制字符串。预分配 2×len 缓冲按 Span 0 分配直写。</summary>
    static string Encode(string buf, int len) {
        if (buf == null || len <= 0) { return ""; }
        if (len > buf.Length) { len = buf.Length; }
        string digits = "0123456789abcdef";
        // 2×len hex chars + NUL terminator, written in place
        nint p = NativeMemory.Alloc(2 * len + 1);
        Span<byte> sp = new Span<byte>(p, 2 * len + 1);
        for (int i = 0; i < len; i = i + 1) {
            int v = buf[i] & 255;
            sp[2 * i] = (byte)(digits[v >> 4] & 255);
            sp[2 * i + 1] = (byte)(digits[v & 15] & 255);
        }
        string r = NativeMemory.GetString(p, 0, 2 * len);
        NativeMemory.Free(p);
        return r;
    }

    /// <summary>将 byte[] 缓冲区的指定前缀编码为小写十六进制字符串。</summary>
    static string Encode(byte[] buf, int len) {
        if (buf == null || len <= 0) { return ""; }
        if (len > buf.Length) { len = buf.Length; }
        string digits = "0123456789abcdef";
        nint p = NativeMemory.Alloc(2 * len + 1);
        Span<byte> sp = new Span<byte>(p, 2 * len + 1);
        for (int i = 0; i < len; i = i + 1) {
            int v = buf[i] & 255;
            sp[2 * i] = (byte)(digits[v >> 4] & 255);
            sp[2 * i + 1] = (byte)(digits[v & 15] & 255);
        }
        string r = NativeMemory.GetString(p, 0, 2 * len);
        NativeMemory.Free(p);
        return r;
    }

    /// <summary>将整个 byte[] 缓冲区编码为小写十六进制字符串。</summary>
    static string Encode(byte[] buf) {
        if (buf == null) { return ""; }
        return Encode(buf, buf.Length);
    }

    /// 单个十六进制字符转数值（0-9、a-f、A-F）；其余字符返回 0（不报错）。
    static int nibble(int c) {
        if (c >= 48 && c <= 57) { return c - 48; }
        if (c >= 97 && c <= 102) { return c - 87; }
        if (c >= 65 && c <= 70) { return c - 55; }
        return 0;
    }

    /// <summary>将十六进制字符串解码为
    /// <c>hex.Length / 2</c> 字节的缓冲区。</summary>
    static byte[] Decode(string hex) {
        int n = hex.Length / 2;
        byte[] outb = new byte[n];
        for (int i = 0; i < n; i = i + 1) {
            outb[i] = ((nibble(hex[2*i] & 255) << 4) | nibble(hex[2*i+1] & 255)) & 255;
        }
        return outb;
    }
}
