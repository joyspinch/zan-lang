using System;

namespace System.Security.Cryptography;

// PBKDF2（RFC 2898 / RFC 8018）口令派生（基于 HMAC-SHA256，堆外缓冲零托管分配）。
public class Pbkdf2 {
    // 零托管分配计算 SHA-256 并直接写入 dst（32 字节）；无硬件路径时回退纯 Zan SHA-256。
    private static void Sha256ToPtr(nint src, int len, nint dst) {
        if (len < 0) { len = 0; }
        if (NativeMemory.Sha256Into(src, (long)len, dst) >= 0) { return; }
        byte[] h = Sha256.Hash(NativeMemory.GetString(src, 0, len), len);
        NativeMemory.Copy(dst, (nint)h, 32);
    }

    // 派生 dkLen 字节（任意正值，按 32 字节块补齐截取），
    // 返回原始字节串（GetString 语义，可含任意字节）。
    public static string Derive(string password, int passLen, string salt,
                         int saltLen, int iterations, int dkLen) {
        if (iterations < 1 || dkLen < 1) { return ""; }
        if (passLen < 0) { passLen = 0; }
        if (saltLen < 0) { saltLen = 0; }

        /* HMAC 键块：≤64 字节补零，更长先摘要。内层消息取
           max(saltLen+4, 32)：首轮是盐||块序号，之后每轮是 32 字节 U。
           inner+64 与 outer+64 严格不相交，直接乒乓直写，迭代主循环零堆分配、零拷贝。 */
        int msgMax = saltLen + 4;
        if (msgMax < 32) { msgMax = 32; }
        int dkAlloc = ((dkLen + 31) / 32) * 32;
        nint k0 = NativeMemory.Alloc(64);
        nint inner = NativeMemory.Alloc(64 + msgMax);
        nint outer = NativeMemory.Alloc(96);
        nint dk = NativeMemory.Alloc(dkAlloc);
        try {
            NativeMemory.Fill(k0, 0, 64);
            if (passLen > 64) {
                Pbkdf2.Sha256ToPtr((nint)password, passLen, k0);
            } else if (passLen > 0 && password != null) {
                NativeMemory.PutString(k0, 0, password, passLen);
            }
            Span<byte> ks = new Span<byte>(k0, 64);
            Span<byte> ib = new Span<byte>(inner, 64 + msgMax);
            Span<byte> ob = new Span<byte>(outer, 96);
            Span<byte> db = new Span<byte>(dk, dkAlloc);
            for (int i = 0; i < 64; i = i + 1) {
                int v = ks[i] & 255;
                ib[i] = (byte)(v ^ 0x36);
                ob[i] = (byte)(v ^ 0x5c);
            }

            nint innerMsg = inner + (nint)64;
            nint outerMsg = outer + (nint)64;
            int blocks = (dkLen + 31) / 32;
            for (int blk = 1; blk <= blocks; blk = blk + 1) {
                if (saltLen > 0 && salt != null) {
                    NativeMemory.PutString(inner, 64, salt, saltLen);
                }
                ib[64 + saltLen] = (byte)((blk >> 24) & 255);
                ib[64 + saltLen + 1] = (byte)((blk >> 16) & 255);
                ib[64 + saltLen + 2] = (byte)((blk >> 8) & 255);
                ib[64 + saltLen + 3] = (byte)(blk & 255);
                int off = (blk - 1) * 32;

                // 第 0 轮：U1 = HMAC(P, S || INT(blk))，结果直落 inner+64，作为第 1 轮输入
                Pbkdf2.Sha256ToPtr(inner, 64 + saltLen + 4, outerMsg);
                Pbkdf2.Sha256ToPtr(outer, 96, innerMsg);
                for (int i = 0; i < 32; i = i + 1) {
                    db[off + i] = ib[64 + i];
                }

                // 后续轮次：inner+64 已持有上一轮 U，乒乓直写 outer+64 -> inner+64
                for (int it = 1; it < iterations; it = it + 1) {
                    if (NativeMemory.Sha256Into(inner, 96L, outerMsg) < 0) {
                        Pbkdf2.Sha256ToPtr(inner, 96, outerMsg);
                    }
                    if (NativeMemory.Sha256Into(outer, 96L, innerMsg) < 0) {
                        Pbkdf2.Sha256ToPtr(outer, 96, innerMsg);
                    }
                    for (int i = 0; i < 32; i = i + 1) {
                        db[off + i] = (byte)((db[off + i] & 255) ^ (ib[64 + i] & 255));
                    }
                }
            }
            return NativeMemory.GetString(dk, 0, dkLen);
        } finally {
            NativeMemory.Free(k0);
            NativeMemory.Free(inner);
            NativeMemory.Free(outer);
            NativeMemory.Free(dk);
        }
    }

    // 口令存取的标准出口：派生 32 字节并以小写 hex 返回
    // （64 字符）。
    public static string Hex(string password, string salt, int iterations) {
        string raw = Pbkdf2.Derive(password, password.Length, salt,
            salt.Length, iterations, 32);
        return System.Security.Cryptography.Hex.Encode(raw, 32);
    }

    public static byte[] DeriveBytes(string password, string salt, int iterations, int dkLen) {
        string raw = Pbkdf2.Derive(password, password.Length, salt, salt.Length, iterations, dkLen);
        if (raw == null) { return new byte[0]; }
        return raw.ToBytes();
    }
}
