using System;

namespace System.Security.Cryptography;

/// <summary>PBKDF2（RFC 2898 / RFC 8018）口令派生，基于 HMAC-SHA256。
/// 与 <see cref="Hmac"/> 的纯托管路径不同，这里把 iPad/oPad 键块在堆外
/// 备好，之后每轮只有两次 <see cref="NativeMemory.Sha256"/> 原生调用
/// （内层 64+msgLen、外层 96 字节），中间字节全部经 Span 直读直写，
/// 零托管堆分配——10 万轮约 0.2s，登录专用路径可承受。六万轮是
/// 登录体验与离线爆破成本的折中；调参无需迁移：盐与轮数随结果落库。
/// </summary>
class Pbkdf2 {
    /// NativeMemory.Sha256 的可空安全包装：本机无 SHA 硬件路径时经
    /// GetString 拷出缓冲、走纯 Zan 摘要（仅回退路径多一次 memcpy）。
    static string Sha256Of(nint p, int len) {
        if (len < 0) { len = 0; }
        string hw = NativeMemory.Sha256(p, len);
        if (hw != null) { return hw; }
        return Sha256.Hash(NativeMemory.GetString(p, 0, len), len);
    }

    /// <summary>派生 dkLen 字节（任意正值，按 32 字节块补齐截取），
    /// 返回原始字节串（GetString 语义，可含任意字节）。</summary>
    static string Derive(string password, int passLen, string salt,
                         int saltLen, int iterations, int dkLen) {
        if (iterations < 1 || dkLen < 1) { return ""; }
        if (passLen < 0) { passLen = 0; }
        if (saltLen < 0) { saltLen = 0; }

        /* HMAC 键块：≤64 字节补零，更长先摘要。内层消息取
           max(saltLen+4, 32)：首轮是盐||块序号，之后每轮是 32 字节 U。 */
        int msgMax = saltLen + 4;
        if (msgMax < 32) { msgMax = 32; }
        nint k0 = NativeMemory.Alloc(64);
        nint inner = NativeMemory.Alloc(64 + msgMax);
        nint outer = NativeMemory.Alloc(96);
        nint dk = NativeMemory.Alloc(((dkLen + 31) / 32) * 32);
        try {
            NativeMemory.Fill(k0, 0, 64);
            if (passLen > 64) {
                string hk = Pbkdf2.Sha256Of(password, passLen);
                Span<byte> kb = new Span<byte>(k0, 64);
                for (int i = 0; i < 32; i = i + 1) {
                    kb[i] = (byte)(hk[i] & 255);
                }
            } else {
                NativeMemory.PutString(k0, 0, password, passLen);
            }
            Span<byte> ks = new Span<byte>(k0, 64);
            Span<byte> ib = new Span<byte>(inner, 64 + msgMax);
            Span<byte> ob = new Span<byte>(outer, 96);
            Span<byte> db = new Span<byte>(dk, ((dkLen + 31) / 32) * 32);
            for (int i = 0; i < 64; i = i + 1) {
                int v = ks[i] & 255;
                ib[i] = (byte)(v ^ 0x36);
                ob[i] = (byte)(v ^ 0x5c);
            }

            int blocks = (dkLen + 31) / 32;
            for (int blk = 1; blk <= blocks; blk = blk + 1) {
                NativeMemory.PutString(inner, 64, salt, saltLen);
                int be = blk;
                ib[64 + saltLen] = (byte)((be >> 24) & 255);
                ib[64 + saltLen + 1] = (byte)((be >> 16) & 255);
                ib[64 + saltLen + 2] = (byte)((be >> 8) & 255);
                ib[64 + saltLen + 3] = (byte)(be & 255);
                int msgLen = saltLen + 4;
                int off = (blk - 1) * 32;
                for (int it = 0; it < iterations; it = it + 1) {
                    if (it > 0) {
                        /* 消息换为上一轮 U（outer+64 处的 32 字节摘要）。*/
                        for (int i = 0; i < 32; i = i + 1) {
                            ib[64 + i] = ob[64 + i];
                        }
                        msgLen = 32;
                    }
                    string ih = Pbkdf2.Sha256Of(inner, 64 + msgLen);
                    for (int i = 0; i < 32; i = i + 1) {
                        ob[64 + i] = (byte)(ih[i] & 255);
                    }
                    string u = Pbkdf2.Sha256Of(outer, 96);
                    for (int i = 0; i < 32; i = i + 1) {
                        /* u 回写外层消息位：下一轮 HMAC 的消息就是它。*/
                        ob[64 + i] = (byte)(u[i] & 255);
                        int acc = db[off + i] & 255;
                        db[off + i] = (byte)(acc ^ (u[i] & 255));
                    }
                }
            }
            return NativeMemory.GetString(dk, 0, dkLen);
        } finally {
            NativeMemory.Free(k0);
            NativeMemory.Free(inner);
            NativeMemory.Free(outer);
            NativeMemory.Free(dk);
        }
    }

    /// <summary>口令存取的标准出口：派生 32 字节并以小写 hex 返回
    /// （64 字符）。</summary>
    static string Hex(string password, string salt, int iterations) {
        string raw = Pbkdf2.Derive(password, password.Length, salt,
            salt.Length, iterations, 32);
        return Hex.Encode(raw, 32);
    }
}
