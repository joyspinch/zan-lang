using System;

namespace System.Security.Cryptography;

/// <summary>任意精度非负整数，使用 32 位 limb 存储
/// 以小端序（limb 0 为最低有效位）存放在 List&lt;long&gt; 中。足以支持
/// RSA 与 SM2 的比较、加减乘、Montgomery 模幂运算和
/// 模逆。每个 limb 取值在 [0, 2^32) 内，两个 limb 的乘积
/// 作为位模式可放入有符号 64 位 long，所有高字
/// 提取均通过 Bits.Shr64 使用逻辑（而非算术）移位。</summary>
class BigInt {
    List<long> d;   // limb 数组，小端序，基 2^32；已修剪（无高位零 limb）

    /// 由 limb 列表构造并修剪高位零。
    static BigInt make(List<long> limbs) {
        BigInt b = new BigInt();
        b.d = limbs;
        b.trim();
        return b;
    }

    /// 去掉高位零 limb（至少保留一位）。
    void trim() {
        while (this.d.Count > 1 && this.d[this.d.Count - 1] == 0) {
            this.d.RemoveAt(this.d.Count - 1);
        }
    }

    /// limb 个数。
    int count() { return this.d.Count; }
    /// 第 i 个 limb（越界返回 0；按 32 位无符号解释）。
    long limb(int i) { if (i < this.d.Count) { return this.d[i] & 4294967295; } return 0; }
    /// 是否为零。
    bool isZero() { return this.d.Count == 1 && this.d[0] == 0; }

    /// 值 0。
    static BigInt zero() { List<long> z = new List<long>(); z.Add(0); return make(z); }
    /// 值 1。
    static BigInt one()  { List<long> z = new List<long>(); z.Add(1); return make(z); }

    /// <summary>从大端序字节缓冲区构建 BigInt。</summary>
    /// 大端序字节缓冲区 → BigInt（RSA/SM2 整数编码的标准字节序）。
    static BigInt FromBytesBE(string buf, int len) {
        List<long> limbs = new List<long>();
        int i = len - 1;
        int shift = 0; long cur = 0;
        while (i >= 0) {
            cur = cur | (((long)(buf[i] & 255)) << shift);
            shift = shift + 8;
            if (shift == 32) { limbs.Add(cur & 4294967295); cur = 0; shift = 0; }
            i = i - 1;
        }
        if (shift > 0) { limbs.Add(cur & 4294967295); }
        if (limbs.Count == 0) { limbs.Add(0); }
        return make(limbs);
    }

    /// <summary>序列化为恰好 <paramref name="outLen"/> 字节的大端序缓冲区
    /// （左侧补零；过小时截断高位字节）。</summary>
    /// 序列化为无符号大端整数（0 ≤ v &lt; 256^outLen）；过小时高位补零，
    /// 过大时静默截断高位——调用方需保证 outLen 足够容纳。
    byte[] ToBytesBE(int outLen) {
        byte[] outb = new byte[outLen];
        for (int i = 0; i < outLen; i = i + 1) {
            int byteIndex = i;                       // 0 = 最高有效位
            int pos = outLen - 1 - byteIndex;        // 自最低有效位起的字节位置
            int limbIdx = pos / 4;
            int within = (pos % 4) * 8;
            outb[byteIndex] = (this.limb(limbIdx) >> within) & 255;
        }
        return outb;
    }

    /// 比较：a > b 返回 1，a < b 返回 -1，相等返回 0。
    static int cmp(BigInt a, BigInt b) {
        int na = a.count(); int nb = b.count();
        if (na != nb) { if (na > nb) { return 1; } return -1; }
        int i = na - 1;
        while (i >= 0) {
            long x = a.limb(i); long y = b.limb(i);
            if (x != y) { if (x > y) { return 1; } return -1; }
            i = i - 1;
        }
        return 0;
    }

    /// 无符号加法。
    static BigInt add(BigInt a, BigInt b) {
        int n = a.count(); if (b.count() > n) { n = b.count(); }
        List<long> r = new List<long>();
        long carry = 0; 
        for (int i = 0; i < n; i = i + 1) {
            long s = a.limb(i) + b.limb(i) + carry;
            r.Add(s & 4294967295);
            carry = Bits.Shr64(s, 32);
        }
        if (carry != 0) { r.Add(carry & 4294967295); }
        return make(r);
    }

    /// 无符号减法 a - b；要求 a >= b（否则借位下溢）。
    static BigInt sub(BigInt a, BigInt b) {
        List<long> r = new List<long>();
        long borrow = 0;  int n = a.count();
        for (int i = 0; i < n; i = i + 1) {
            long s = a.limb(i) - b.limb(i) - borrow;
            if (s < 0) { s = s + 4294967296; borrow = 1; } else { borrow = 0; }
            r.Add(s & 4294967295);
        }
        return make(r);
    }

    /// 无符号乘法（教科书 O(n²)，limb 基 2^32）。
    static BigInt mul(BigInt a, BigInt b) {
        int na = a.count(); int nb = b.count();
        List<long> r = new List<long>();
        int i = 0; for (; i < na + nb; i = i + 1) { r.Add(0); }
        i = 0;
        while (i < na) {
            long carry = 0;  long ai = a.limb(i);
            for (int j = 0; j < nb; j = j + 1) {
                long cur = (r[i+j] & 4294967295) + ai * b.limb(j) + carry;
                r[i+j] = cur & 4294967295;
                carry = Bits.Shr64(cur, 32);
            }
            r[i+nb] = (r[i+nb] & 4294967295) + carry;
            i = i + 1;
        }
        return make(r);
    }

    /// -n[0]^{-1} mod 2^32（Montgomery 参数 n'，Newton 迭代求出）。
    static long montInv(long n0) {
        long inv = 1; 
        for (int i = 0; i < 5; i = i + 1) {
            long t = (n0 * inv) & 4294967295;
            t = (2 - t) & 4294967295;
            inv = (inv * t) & 4294967295;
        }
        return (4294967296 - inv) & 4294967295;
    }

    /// Montgomery 乘积：a * b * R^{-1} mod n，R = 2^(32k)。要求 a、b < n。
    static BigInt montMul(BigInt a, BigInt b, BigInt n, long n0inv) {
        int k = n.count();
        List<long> t = new List<long>();
         for (int z = 0; z < k + 2; z = z + 1) { t.Add(0); }
        for (int i = 0; i < k; i = i + 1) {
            long carry = 0; long bi = b.limb(i); int j = 0;
            for (; j < k; j = j + 1) {
                long cur = (t[j] & 4294967295) + a.limb(j) * bi + carry;
                t[j] = cur & 4294967295;
                carry = Bits.Shr64(cur, 32);
            }
            long cur2 = (t[k] & 4294967295) + carry;
            t[k] = cur2 & 4294967295;
            t[k+1] = Bits.Shr64(cur2, 32);

            long m = ((t[0] & 4294967295) * n0inv) & 4294967295;
            long c2 = (t[0] & 4294967295) + m * n.limb(0);
            carry = Bits.Shr64(c2, 32);
            j = 1;
            while (j < k) {
                long cur = (t[j] & 4294967295) + m * n.limb(j) + carry;
                t[j-1] = cur & 4294967295;
                carry = Bits.Shr64(cur, 32);
                j = j + 1;
            }
            long c3 = (t[k] & 4294967295) + carry;
            t[k-1] = c3 & 4294967295;
            t[k] = (t[k+1] & 4294967295) + Bits.Shr64(c3, 32);
            t[k+1] = 0;
        }
        List<long> rl = new List<long>();
         for (int q = 0; q < k; q = q + 1) { rl.Add(t[q] & 4294967295); }
        rl.Add(t[k] & 4294967295);
        BigInt res = make(rl);
        if (cmp(res, n) >= 0) { res = sub(res, n); }
        return res;
    }

    /// 通过反复翻倍计算 2^(bits) mod n
    static BigInt pow2mod(int bits, BigInt n) {
        BigInt x = one();
        for (int i = 0; i < bits; i = i + 1) {
            x = add(x, x);
            if (cmp(x, n) >= 0) { x = sub(x, n); }
        }
        return x;
    }

    /// 有效位长（0 计为 1 位）。
    int bitLength() {
        int hi = this.count() - 1;
        long top = this.limb(hi);
        int bits = hi * 32; long t = top;
        while (t > 0) { bits = bits + 1; t = Bits.Shr64(t, 1); }
        if (bits == 0) { return 1; }
        return bits;
    }

    /// 第 idx 位的值（0 起，低位在前）。
    int getBit(int idx) {
        int limbIdx = idx / 32; int within = idx % 32;
        long b = Bits.Shr64(this.limb(limbIdx), within) & 1;
        if (b == 1) { return 1; }
        return 0;
    }

    /// 模幂 base^exp mod n（Montgomery 阶梯，n 必须为奇数——RSA/SM2
    /// 的模数均满足）。要求 base &lt; n；返回值已约减到 [0, n)。
    static BigInt ModPow(BigInt g, BigInt exp, BigInt n) {
        if (n.isZero()) { return zero(); }
        int k = n.count();
        long n0inv = montInv(n.limb(0));
        BigInt r2 = pow2mod(64 * k, n);            // R^2 mod n
        BigInt baseM = montMul(g, r2, n, n0inv);    // base * R mod n
        BigInt result = pow2mod(32 * k, n);         // R mod n（Montgomery 域中等于 1）
        int bits = exp.bitLength();
        int i = bits - 1;
        while (i >= 0) {
            result = montMul(result, result, n, n0inv);
            if (exp.getBit(i) == 1) { result = montMul(result, baseM, n, n0inv); }
            i = i - 1;
        }
        BigInt one1 = one();
        return montMul(result, one1, n, n0inv);     // 从 Montgomery 域转换出来
    }

    /// 用二进制扩展欧几里得算法求模逆 a^{-1} mod m（m 无需为素数）。
    /// 不可逆（gcd(a,m) ≠ 1）时返回零。
    static BigInt ModInverse(BigInt a, BigInt m) {
        // 费马小定理不通用（m 可能非素数）；改用扩展欧几里得算法处理
        // 以 (value, negative?) 对表示的有符号数。
        BigInt oldR = a; BigInt r = m;
        BigInt oldS = one(); BigInt s = zero();
        bool oldSneg = false; bool sneg = false;
        while (!r.isZero()) {
            List<BigInt> qr = divmod(oldR, r);
            BigInt q = qr[0]; BigInt rem = qr[1];
            oldR = r; r = rem;
            // (oldS, s) = (s, oldS - q*s)
            BigInt qs = mul(q, s);
            BigInt ns; bool nsneg;
            // 带符号计算 oldS - q*s
            List<bool> sgn = new List<bool>();
            ns = subSigned(oldS, oldSneg, qs, sneg, sgn);
            nsneg = sgn[0];
            oldS = s; oldSneg = sneg;
            s = ns; sneg = nsneg;
        }
        if (cmp(oldR, one()) != 0) { return zero(); }   // gcd != 1
        if (oldSneg) { return sub(m, mod(oldS, m)); }
        return mod(oldS, m);
    }

    /// 有符号减法 a(符号 aneg) - b(符号 bneg)；返回绝对值，符号写入 out[0]
    static BigInt subSigned(BigInt a, bool aneg, BigInt b, bool bneg, List<bool> outNeg) {
        if (aneg == bneg) {
            // 同号时的 a - b：绝对值之差
            int c = cmp(a, b);
            if (c >= 0) { outNeg.Add(aneg); return sub(a, b); }
            outNeg.Add(!aneg); return sub(b, a);
        }
        // 异号时：a - b = a + |b|，符号取 a 的符号
        outNeg.Add(aneg);
        return add(a, b);
    }

    /// 教科书式长除法：返回 [商, 余数]
    static List<BigInt> divmod(BigInt a, BigInt b) {
        List<BigInt> outp = new List<BigInt>();
        if (cmp(a, b) < 0) { outp.Add(zero()); outp.Add(a); return outp; }
        BigInt q = zero(); BigInt rem = zero();
        int bits = a.bitLength();
        int i = bits - 1;
        while (i >= 0) {
            rem = add(rem, rem);                    // rem <<= 1
            if (a.getBit(i) == 1) { rem = add(rem, one()); }
            if (cmp(rem, b) >= 0) {
                rem = sub(rem, b);
                q = setBit(q, i);
            }
            i = i - 1;
        }
        outp.Add(q); outp.Add(rem);
        return outp;
    }

    /// a mod m（经 divmod 取余数）。
    static BigInt mod(BigInt a, BigInt m) {
        List<BigInt> qr = divmod(a, m);
        return qr[1];
    }

    /// 返回第 idx 位置 1 的副本。
    static BigInt setBit(BigInt x, int idx) {
        int limbIdx = idx / 32; int within = idx % 32;
        List<long> l = new List<long>();
         int need = limbIdx + 1;
        for (int i = 0; i < x.count() || i < need; i = i + 1) { l.Add(x.limb(i)); }
        long one = 1;
        l[limbIdx] = (l[limbIdx] | (one << within)) & 4294967295;
        return make(l);
    }
}
