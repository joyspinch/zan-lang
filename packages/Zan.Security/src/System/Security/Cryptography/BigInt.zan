using System;
using System.Interop;

namespace System.Security.Cryptography;

// 任意精度非负整数，使用 32 位 limb 存储
// 以小端序（limb 0 为最低有效位）存放在 List&lt;long&gt; 中。足以支持
// RSA 与 SM2 的比较、加减乘、Montgomery 模幂运算和
// 模逆。每个 limb 取值在 [0, 2^32) 内，两个 limb 的乘积
// 作为位模式可放入有符号 64 位 long，乘累加通过 ulong 原地进位无溢出完成。
public class BigInt {
    List<long> d;   // limb 数组，小端序，基 2^32；已修剪（无高位零 limb）

    // 由 limb 列表构造并修剪高位零。
    public static BigInt make(List<long> limbs) {
        BigInt b = new BigInt();
        b.d = limbs;
        b.trim();
        return b;
    }

    // 去掉高位零 limb（至少保留一位）。
    public void trim() {
        while (this.d.Count > 1 && this.d[this.d.Count - 1] == 0) {
            this.d.RemoveAt(this.d.Count - 1);
        }
    }

    // limb 个数。
    public int count() { return this.d.Count; }
    // 第 i 个 limb（越界返回 0；按 32 位无符号解释）。
    public long limb(int i) { if (i < this.d.Count) { return this.d[i] & 4294967295; } return 0; }
    // 是否为零。
    public bool isZero() { return this.d.Count == 1 && this.d[0] == 0; }

    // 值 0。
    public static BigInt zero() { List<long> z = new List<long>(); z.Add(0); return make(z); }
    // 值 1。
    public static BigInt one()  { List<long> z = new List<long>(); z.Add(1); return make(z); }

    private static BigInt makeFromArr(long[] arr, int n) {
        while (n > 1 && arr[n - 1] == 0L) { n = n - 1; }
        List<long> limbs = new List<long>();
        limbs.Reserve(n);
        for (int i = 0; i < n; i = i + 1) { limbs.Add(arr[i]); }
        BigInt b = new BigInt();
        b.d = limbs;
        return b;
    }

    // 从大端序字节缓冲区构建 BigInt。
    // 大端序字节缓冲区 → BigInt（RSA/SM2 整数编码的标准字节序）。
    public static BigInt FromBytesBE(string buf, int len) {
        if (len <= 0) { return zero(); }
        List<long> limbs = new List<long>();
        limbs.Reserve((len + 3) / 4);
        int i = len - 1;
        int shift = 0; long cur = 0L;
        while (i >= 0) {
            cur = cur | (((long)(buf[i] & 255)) << shift);
            shift = shift + 8;
            if (shift == 32) { limbs.Add(cur & 4294967295L); cur = 0L; shift = 0; }
            i = i - 1;
        }
        if (shift > 0) { limbs.Add(cur & 4294967295L); }
        if (limbs.Count == 0) { limbs.Add(0L); }
        return make(limbs);
    }

    // 序列化为恰好 <paramref name="outLen"/> 字节的大端序缓冲区
    // （左侧补零；过小时截断高位字节）。
    public byte[] ToBytesBE(int outLen) {
        byte[] outb = new byte[outLen];
        List<long> dd = this.d;
        int dl = dd.Count;
        for (int i = 0; i < outLen; i = i + 1) {
            int pos = outLen - 1 - i;
            int limbIdx = pos >> 2;
            int within = (pos & 3) << 3;
            long w = limbIdx < dl ? (dd[limbIdx] & 4294967295L) : 0L;
            outb[i] = (byte)((w >> within) & 255L);
        }
        return outb;
    }

    // 比较：a > b 返回 1，a < b 返回 -1，相等返回 0。
    public static int cmp(BigInt a, BigInt b) {
        List<long> da = a.d; List<long> db = b.d;
        int na = da.Count; int nb = db.Count;
        if (na != nb) { return na > nb ? 1 : -1; }
        for (int i = na - 1; i >= 0; i = i - 1) {
            long x = da[i] & 4294967295L;
            long y = db[i] & 4294967295L;
            if (x != y) { return x > y ? 1 : -1; }
        }
        return 0;
    }

    // 无符号加法。
    public static BigInt add(BigInt a, BigInt b) {
        List<long> da = a.d; List<long> db = b.d;
        int na = da.Count; int nb = db.Count;
        int n = na > nb ? na : nb;
        List<long> r = new List<long>();
        r.Reserve(n + 1);
        ulong carry = 0;
        for (int i = 0; i < n; i = i + 1) {
            ulong av = i < na ? (ulong)(da[i] & 4294967295L) : 0;
            ulong bv = i < nb ? (ulong)(db[i] & 4294967295L) : 0;
            ulong s = av + bv + carry;
            r.Add((long)(s & 4294967295UL));
            carry = s >> 32;
        }
        if (carry != 0) { r.Add((long)carry); }
        return make(r);
    }

    // 无符号减法 a - b；要求 a >= b（否则借位下溢）。
    public static BigInt sub(BigInt a, BigInt b) {
        List<long> da = a.d; List<long> db = b.d;
        int na = da.Count; int nb = db.Count;
        List<long> r = new List<long>();
        r.Reserve(na);
        long borrow = 0L;
        for (int i = 0; i < na; i = i + 1) {
            long av = da[i] & 4294967295L;
            long bv = i < nb ? (db[i] & 4294967295L) : 0L;
            long s = av - bv - borrow;
            if (s < 0L) { s = s + 4294967296L; borrow = 1L; } else { borrow = 0L; }
            r.Add(s);
        }
        return make(r);
    }

    // 无符号乘法（教科书 O(n²)，limb 基 2^32，ulong 进位零函数调用）。
    public static BigInt mul(BigInt a, BigInt b) {
        List<long> da = a.d; List<long> db = b.d;
        int na = da.Count; int nb = db.Count;
        long[] r = new long[na + nb];
        for (int i = 0; i < na; i = i + 1) {
            ulong ai = (ulong)(da[i] & 4294967295L);
            if (ai == 0) { continue; }
            ulong carry = 0;
            for (int j = 0; j < nb; j = j + 1) {
                ulong cur = (ulong)r[i + j] + ai * (ulong)(db[j] & 4294967295L) + carry;
                r[i + j] = (long)(cur & 4294967295UL);
                carry = cur >> 32;
            }
            r[i + nb] = (long)((ulong)r[i + nb] + carry);
        }
        return makeFromArr(r, na + nb);
    }

    // -n[0]^{-1} mod 2^32（Montgomery 参数 n'，Newton 迭代求出）。
    private static ulong montInv(ulong n0) {
        ulong inv = 1;
        for (int i = 0; i < 5; i = i + 1) {
            ulong t = (n0 * inv) & 4294967295UL;
            t = (2UL - t) & 4294967295UL;
            inv = (inv * t) & 4294967295UL;
        }
        return (4294967296UL - inv) & 4294967295UL;
    }

    // 原地 Montgomery 乘积：dst = a * b * R^{-1} mod n，零中间分配。
    private static void montMulInto(long[] dst, long[] a, long[] b, long[] n, int k, ulong n0inv, long[] t) {
        NativeMemory.Fill((nint)t, 0, (k + 2) * 8);
        for (int i = 0; i < k; i = i + 1) {
            ulong carry = 0;
            ulong bi = (ulong)b[i];
            for (int j = 0; j < k; j = j + 1) {
                ulong cur = (ulong)t[j] + (ulong)a[j] * bi + carry;
                t[j] = (long)(cur & 4294967295UL);
                carry = cur >> 32;
            }
            ulong cur2 = (ulong)t[k] + carry;
            t[k] = (long)(cur2 & 4294967295UL);
            t[k + 1] = (long)(cur2 >> 32);

            ulong m = ((ulong)t[0] * n0inv) & 4294967295UL;
            ulong c2 = (ulong)t[0] + m * (ulong)n[0];
            carry = c2 >> 32;
            for (int j = 1; j < k; j = j + 1) {
                ulong cur = (ulong)t[j] + m * (ulong)n[j] + carry;
                t[j - 1] = (long)(cur & 4294967295UL);
                carry = cur >> 32;
            }
            ulong c3 = (ulong)t[k] + carry;
            t[k - 1] = (long)(c3 & 4294967295UL);
            t[k] = (long)((ulong)t[k + 1] + (c3 >> 32));
            t[k + 1] = 0L;
        }
        bool ge = t[k] != 0L;
        if (!ge) {
            ge = true;
            for (int i = k - 1; i >= 0; i = i - 1) {
                if (t[i] != n[i]) {
                    ge = t[i] > n[i];
                    break;
                }
            }
        }
        if (ge) {
            long borrow = 0L;
            for (int i = 0; i < k; i = i + 1) {
                long s = t[i] - n[i] - borrow;
                if (s < 0L) { s = s + 4294967296L; borrow = 1L; } else { borrow = 0L; }
                dst[i] = s;
            }
        } else {
            for (int i = 0; i < k; i = i + 1) { dst[i] = t[i]; }
        }
    }

    // 通过原地翻倍计算 2^(bits) mod n（写入 k 长度数组 dst）
    private static void pow2modArr(long[] dst, int bits, long[] n, int k) {
        NativeMemory.Fill((nint)dst, 0, k * 8);
        dst[0] = 1L;
        for (int b = 0; b < bits; b = b + 1) {
            ulong carry = 0;
            for (int i = 0; i < k; i = i + 1) {
                ulong s = ((ulong)dst[i] << 1) | carry;
                dst[i] = (long)(s & 4294967295UL);
                carry = s >> 32;
            }
            bool ge = carry != 0;
            if (!ge) {
                ge = true;
                for (int i = k - 1; i >= 0; i = i - 1) {
                    if (dst[i] != n[i]) {
                        ge = dst[i] > n[i];
                        break;
                    }
                }
            }
            if (ge) {
                long borrow = 0L;
                for (int i = 0; i < k; i = i + 1) {
                    long s = dst[i] - n[i] - borrow;
                    if (s < 0L) { s = s + 4294967296L; borrow = 1L; } else { borrow = 0L; }
                    dst[i] = s;
                }
            }
        }
    }

    // 有效位长（0 计为 1 位）。
    int bitLength() {
        int hi = this.d.Count - 1;
        ulong top = (ulong)(this.d[hi] & 4294967295L);
        int bits = hi * 32;
        while (top > 0) { bits = bits + 1; top = top >> 1; }
        if (bits == 0) { return 1; }
        return bits;
    }

    // 第 idx 位的值（0 起，低位在前）。
    int getBit(int idx) {
        int limbIdx = idx >> 5;
        if (limbIdx >= this.d.Count) { return 0; }
        return (int)(((ulong)(this.d[limbIdx] & 4294967295L) >> (idx & 31)) & 1UL);
    }

    // 模幂 base^exp mod n（恒定时间 Montgomery 阶梯算法，全程零临时分配）。
    public static BigInt ModPow(BigInt g, BigInt exp, BigInt n) {
        if (n.isZero() || (n.d.Count == 1 && (n.d[0] & 4294967295L) == 1L)) { return zero(); }
        if (cmp(g, n) >= 0) { g = mod(g, n); }
        int k = n.d.Count;
        long[] nd = new long[k];
        for (int i = 0; i < k; i = i + 1) { nd[i] = n.d[i] & 4294967295L; }
        ulong n0inv = montInv((ulong)nd[0]);

        long[] r2 = new long[k];
        pow2modArr(r2, 64 * k, nd, k);
        long[] r0 = new long[k];
        pow2modArr(r0, 32 * k, nd, k);

        long[] ga = new long[k];
        int gl = g.d.Count < k ? g.d.Count : k;
        for (int i = 0; i < gl; i = i + 1) { ga[i] = g.d[i] & 4294967295L; }

        long[] t = new long[k + 2];
        long[] r1 = new long[k];
        montMulInto(r1, ga, r2, nd, k, n0inv, t);

        long[] tmp0 = new long[k];
        long[] tmp1 = new long[k];
        int bits = exp.bitLength();
        for (int i = bits - 1; i >= 0; i = i - 1) {
            int bit = exp.getBit(i);
            if (bit == 0) {
                montMulInto(tmp1, r0, r1, nd, k, n0inv, t);
                montMulInto(tmp0, r0, r0, nd, k, n0inv, t);
            } else {
                montMulInto(tmp0, r0, r1, nd, k, n0inv, t);
                montMulInto(tmp1, r1, r1, nd, k, n0inv, t);
            }
            long[] sw0 = r0; r0 = tmp0; tmp0 = sw0;
            long[] sw1 = r1; r1 = tmp1; tmp1 = sw1;
        }

        long[] oneArr = new long[k];
        oneArr[0] = 1L;
        long[] outArr = new long[k];
        montMulInto(outArr, r0, oneArr, nd, k, n0inv, t);
        return makeFromArr(outArr, k);
    }

    // 用扩展欧几里得算法求模逆 a^{-1} mod m（m 无需为素数）。
    // 不可逆（gcd(a,m) ≠ 1）时返回零。
    public static BigInt ModInverse(BigInt a, BigInt m) {
        BigInt oldR = a; BigInt r = m;
        BigInt oldS = one(); BigInt s = zero();
        bool oldSneg = false; bool sneg = false;
        while (!r.isZero()) {
            BigInt rem;
            BigInt q = divmodOut(oldR, r, out rem);
            oldR = r; r = rem;
            BigInt qs = mul(q, s);
            bool nsneg;
            BigInt ns = subSignedOut(oldS, oldSneg, qs, sneg, out nsneg);
            oldS = s; oldSneg = sneg;
            s = ns; sneg = nsneg;
        }
        if (cmp(oldR, one()) != 0) { return zero(); }
        if (oldSneg) { return sub(m, mod(oldS, m)); }
        return mod(oldS, m);
    }

    private static BigInt subSignedOut(BigInt a, bool aneg, BigInt b, bool bneg, out bool outNeg) {
        if (aneg == bneg) {
            int c = cmp(a, b);
            if (c >= 0) { outNeg = aneg; return sub(a, b); }
            outNeg = !aneg; return sub(b, a);
        }
        outNeg = aneg;
        return add(a, b);
    }

    // 转换为 16 位无符号小端半字数组（大整数 Knuth D 除法用）。
    private static int len16(BigInt x) {
        int c = x.d.Count;
        int n = c * 2;
        if (n > 1 && ((x.d[c - 1] & 4294967295L) >> 16) == 0L) { n = n - 1; }
        return n;
    }

    private static long[] to16(BigInt x, int n16) {
        long[] arr = new long[n16];
        List<long> xd = x.d;
        int c = xd.Count;
        for (int i = 0; i < c; i = i + 1) {
            long w = xd[i] & 4294967295L;
            arr[2 * i] = w & 65535L;
            if (2 * i + 1 < n16) { arr[2 * i + 1] = (w >> 16) & 65535L; }
        }
        return arr;
    }

    private static BigInt from16(long[] d16, int n16) {
        int n32 = (n16 + 1) >> 1;
        if (n32 <= 0) { return zero(); }
        List<long> limbs = new List<long>();
        limbs.Reserve(n32);
        for (int i = 0; i < n16; i = i + 2) {
            long lo = d16[i] & 65535L;
            long hi = (i + 1 < n16) ? (d16[i + 1] & 65535L) : 0L;
            limbs.Add(lo | (hi << 16));
        }
        return make(limbs);
    }

    // Knuth Algorithm D（基 2^16）：返回商，余数写入 outRem。
    private static BigInt divmodOut(BigInt a, BigInt b, out BigInt outRem) {
        if (b.isZero()) { outRem = zero(); return zero(); }
        if (cmp(a, b) < 0) { outRem = a; return zero(); }
        int m = len16(a);
        int n = len16(b);
        long[] u = to16(a, m);
        long[] v = to16(b, n);
        if (n == 1) {
            long d0 = v[0];
            long[] qd = new long[m];
            long rem = 0L;
            for (int i = m - 1; i >= 0; i = i - 1) {
                long cur = (rem << 16) + u[i];
                qd[i] = cur / d0;
                rem = cur - qd[i] * d0;
            }
            List<long> rl = new List<long>();
            rl.Add(rem);
            outRem = make(rl);
            return from16(qd, m);
        }
        int shift = 0;
        long top = v[n - 1];
        while (top < 32768L) { top = top << 1; shift = shift + 1; }
        long[] vn = new long[n];
        long[] un = new long[m + 1];
        if (shift == 0) {
            NativeMemory.Copy((nint)vn, (nint)v, n * 8);
            NativeMemory.Copy((nint)un, (nint)u, m * 8);
        } else {
            long carry = 0L;
            for (int i = 0; i < n; i = i + 1) {
                long w = (v[i] << shift) | carry;
                vn[i] = w & 65535L;
                carry = w >> 16;
            }
            carry = 0L;
            for (int i = 0; i < m; i = i + 1) {
                long w = (u[i] << shift) | carry;
                un[i] = w & 65535L;
                carry = w >> 16;
            }
            un[m] = carry;
        }
        int qlen = m - n + 1;
        long[] qd = new long[qlen];
        long vnTop = vn[n - 1];
        long vnSec = vn[n - 2];
        for (int j = m - n; j >= 0; j = j - 1) {
            long num = (un[j + n] << 16) + un[j + n - 1];
            long qhat = num / vnTop;
            long rhat = num - qhat * vnTop;
            while (qhat >= 65536L || (rhat < 65536L && qhat * vnSec > ((rhat << 16) + un[j + n - 2]))) {
                qhat = qhat - 1L;
                rhat = rhat + vnTop;
            }
            long borrow = 0L;
            for (int i = 0; i < n; i = i + 1) {
                long p = qhat * vn[i] + borrow;
                long pLo = p & 65535L;
                long pHi = p >> 16;
                long diff = un[j + i] - pLo;
                if (diff < 0L) {
                    un[j + i] = diff + 65536L;
                    borrow = pHi + 1L;
                } else {
                    un[j + i] = diff;
                    borrow = pHi;
                }
            }
            if (un[j + n] < borrow) {
                qd[j] = qhat - 1L;
                long carry = 0L;
                for (int i = 0; i < n; i = i + 1) {
                    long s = un[j + i] + vn[i] + carry;
                    un[j + i] = s & 65535L;
                    carry = s >> 16;
                }
                un[j + n] = (un[j + n] - borrow + carry) & 65535L;
            } else {
                qd[j] = qhat;
                un[j + n] = un[j + n] - borrow;
            }
        }
        long[] rd = new long[n];
        if (shift == 0) {
            NativeMemory.Copy((nint)rd, (nint)un, n * 8);
        } else {
            long remCarry = 0L;
            int rshift = 16 - shift;
            for (int i = n - 1; i >= 0; i = i - 1) {
                rd[i] = ((un[i] >> shift) | remCarry) & 65535L;
                remCarry = (un[i] << rshift) & 65535L;
            }
        }
        outRem = from16(rd, n);
        return from16(qd, qlen);
    }

    // a mod m（经 divmod 取余数）。
    public static BigInt mod(BigInt a, BigInt m) {
        BigInt rem;
        divmodOut(a, m, out rem);
        return rem;
    }
}
