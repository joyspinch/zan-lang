using System;
using System.Interop;

namespace System.Security.Cryptography;

// NIST P-256（secp256r1，RFC 5480）上的 ECDSA，内部域与点运算委托
// EcField256（8x32-bit 定长 Limb + FIPS 186-4 Solinas 约简 + 4-bit 2-Comb G 表 + Shamir 双标量乘）。
// 验签按 FIPS 186-4：e 为 SHA-256 摘要的 256 位整数，R = u1*G + u2*Q，
// 比较 v = x_R mod n 与 r。签名为 RFC 6979 确定性 k（HMAC-SHA256），
// 签名以 DER SEQUENCE{r INTEGER, s INTEGER} 传输（RFC 5480 / TLS 语义），
// 解析严格：长度必须精确耗尽、INTEGER 定长、1 ≤ r,s < n。
public class Ecdsa {

    static string NHEX = "FFFFFFFF00000000FFFFFFFFFFFFFFFFBCE6FAADA7179E84F3B9CAC2FC632551";

    static BigInt N;
    static bool ready = false;
    static object initLock = new object();

    private static BigInt hb(string h) { return BigInt.FromBytesBE(Hex.Decode(h), h.Length / 2); }

    private static void init() {
        if (ready) { return; }
        lock (Ecdsa.initLock) {
            if (ready) { return; }
            N = hb(NHEX);
            EcField256.GetCurve(EcField256.CurveP256);
            ready = true;
        }
    }

    // 从 src 的 off 起取 len 字节切片并按大端读入 BigInt。
    private static BigInt sliceBE(byte[] src, int off, int len) {
        byte[] b = new byte[len];
        if (len > 0) { NativeMemory.Copy((nint)b, (nint)src + off, len); }
        return BigInt.FromBytesBE(b, len);
    }

    // 标量运算，模 N
    private static BigInt nmod(BigInt x) { return BigInt.mod(x, N); }
    private static BigInt nmul(BigInt x, BigInt y) { return BigInt.mod(BigInt.mul(x, y), N); }
    private static BigInt ninv(BigInt x) { return BigInt.ModInverse(x, N); }

    // 从 32 字节大端私钥标量派生非压缩公钥 0x04||X||Y（65 字节）。
    // 标量不在 [1, n-1] 时返回 null。
    public static byte[] PublicKeyOf(byte[] d32) {
        init();
        if (d32 == null || d32.Length != 32) { return null; }
        EcCurveData cd = EcField256.GetCurve(EcField256.CurveP256);
        long[] d = new long[8];
        EcField256.FromBytesBE(d32, 0, d);
        if (EcField256.IsZero(d) || EcField256.Cmp(d, cd.N) >= 0) { return null; }

        long[] ox = new long[8];
        long[] oy = new long[8];
        if (!EcField256.ScalarMulG(EcField256.CurveP256, d, ox, oy)) { return null; }

        byte[] outb = new byte[65];
        outb[0] = 4;
        EcField256.ToBytesBE(ox, outb, 1);
        EcField256.ToBytesBE(oy, outb, 33);
        return outb;
    }

    // 校验非压缩公钥点 0x04||X||Y 确实落在曲线上（y² ≡ x³ - 3x + b
    // (mod p)）且坐标 < p。错误格式、无穷远点一律拒绝。
    public static bool ValidPublicKey(byte[] point, int len) {
        init();
        if (point == null || len != 65 || (point[0] & 255) != 4) { return false; }
        long[] x = new long[8];
        long[] y = new long[8];
        EcField256.FromBytesBE(point, 1, x);
        EcField256.FromBytesBE(point, 33, y);
        return EcField256.IsOnCurve(EcField256.CurveP256, x, y);
    }

    // 严格解析 DER ECDSA 签名 SEQUENCE{r INTEGER, s INTEGER}：
    // 长度精确耗尽、INTEGER 至少 1 字节且不超过 33 字节（32 字节值最多
    // 一个补符号零）、1 ≤ r,s < n。成功时 r/s 追加到 outRs。
    public static bool ParseSigDer(byte[] sig, int sigLen, List<BigInt> outRs) {
        init();
        if (sig == null || outRs == null || sigLen < 8 || sigLen > 72 || sigLen > sig.Length) { return false; }
        if ((sig[0] & 255) != 48) { return false; }
        int seqLen = sig[1] & 255;
        if (seqLen != sigLen - 2) { return false; }
        int pos = 2;
        if ((sig[pos] & 255) != 2) { return false; }
        int rLen = sig[pos + 1] & 255;
        // 至少为后续 s 的 tag(1)+len(1)+value(>=1) 留出 3 字节，并校验规范正 DER INTEGER 编码。
        if (rLen < 1 || rLen > 33 || pos + 2 + rLen + 3 > sigLen) { return false; }
        int r0 = sig[pos + 2] & 255;
        if ((r0 & 128) != 0) { return false; }
        if (rLen > 1 && r0 == 0 && ((sig[pos + 3] & 255) & 128) == 0) { return false; }
        BigInt r = sliceBE(sig, pos + 2, rLen);
        pos = pos + 2 + rLen;
        if ((sig[pos] & 255) != 2) { return false; }
        int sLen = sig[pos + 1] & 255;
        if (sLen < 1 || sLen > 33 || pos + 2 + sLen != sigLen) { return false; }
        int s0 = sig[pos + 2] & 255;
        if ((s0 & 128) != 0) { return false; }
        if (sLen > 1 && s0 == 0 && ((sig[pos + 3] & 255) & 128) == 0) { return false; }
        BigInt s = sliceBE(sig, pos + 2, sLen);
        if (BigInt.cmp(r, BigInt.one()) < 0 || BigInt.cmp(r, N) >= 0) { return false; }
        if (BigInt.cmp(s, BigInt.one()) < 0 || BigInt.cmp(s, N) >= 0) { return false; }
        outRs.Add(r);
        outRs.Add(s);
        return true;
    }

    // 最小长度 DER INTEGER 编码（ECDSA r/s 恒正），高位为 1 时补 0x00，
    // 写入 outb 的 off 偏移，返回写入的字节数。
    private static int writeInt(byte[] outb, int off, BigInt v) {
        int bits = v.bitLength();
        int len = bits == 0 ? 1 : (bits + 7) / 8;
        byte[] be = v.ToBytesBE(len);
        int pad = (len > 0 && (be[0] & 255) >= 128) ? 1 : 0;
        outb[off] = 2;
        outb[off + 1] = (byte)(len + pad);
        if (pad == 1) { outb[off + 2] = 0; }
        if (len > 0) { NativeMemory.Copy((nint)outb + off + 2 + pad, (nint)be, len); }
        return 2 + pad + len;
    }

    // r/s BigInt 编码为 DER SEQUENCE 签名（调用方已保证 1 ≤ r,s < n）。
    public static byte[] EncodeSigDer(BigInt r, BigInt s, List<int> outLen) {
        byte[] tmp = new byte[2 * (2 + 33)];
        int a = writeInt(tmp, 0, r);
        int b = writeInt(tmp, a, s);
        int bodyLen = a + b;
        int total = 2 + bodyLen;
        byte[] outb = new byte[total];
        outb[0] = 48;
        outb[1] = (byte)bodyLen;
        if (bodyLen > 0) { NativeMemory.Copy((nint)outb + 2, (nint)tmp, bodyLen); }
        outLen[0] = total;
        return outb;
    }

    // HMAC-SHA256 的 byte[] 便捷封装（消息为若干段一次性拼接）。
    private static byte[] hmac256(byte[] key, byte[] p1, byte[] p2, byte[] p3, byte[] p4) {
        int l1 = p1.Length;
        int l2 = p2 == null ? 0 : p2.Length;
        int l3 = p3 == null ? 0 : p3.Length;
        int l4 = p4 == null ? 0 : p4.Length;
        int total = l1 + l2 + l3 + l4;
        byte[] msg = new byte[total];
        int pos = 0;
        if (l1 > 0) { NativeMemory.Copy((nint)msg + pos, (nint)p1, l1); pos = pos + l1; }
        if (l2 > 0) { NativeMemory.Copy((nint)msg + pos, (nint)p2, l2); pos = pos + l2; }
        if (l3 > 0) { NativeMemory.Copy((nint)msg + pos, (nint)p3, l3); pos = pos + l3; }
        if (l4 > 0) { NativeMemory.Copy((nint)msg + pos, (nint)p4, l4); }
        return Hmac.Compute(Hmac.SHA256, key.ToStr(0, key.Length), key.Length, msg.ToStr(0, total), total);
    }

    // RFC 6979（HMAC-SHA256）确定性 nonce 直接完成 ECDSA-P256-SHA256
    // 签名。msg 为待签数据，d32 为 32 字节大端私钥标量。返回 DER 签名，
    // outLen[0] 接收长度。私钥越界返回 null。
    public static byte[] SignSha256Det(string msg, int msgLen, byte[] d32, List<int> outLen) {
        init();
        if (d32 == null || d32.Length != 32) { return null; }
        EcCurveData cd = EcField256.GetCurve(EcField256.CurveP256);
        long[] dl = new long[8];
        EcField256.FromBytesBE(d32, 0, dl);
        if (EcField256.IsZero(dl) || EcField256.Cmp(dl, cd.N) >= 0) { return null; }
        BigInt dv = BigInt.FromBytesBE(d32, 32);

        byte[] h1 = Sha256.Hash(msg, msgLen);
        byte[] h1m = nmod(BigInt.FromBytesBE(h1, 32)).ToBytesBE(32);
        byte[] v = new byte[32];
        byte[] k = new byte[32];
        for (int i = 0; i < 32; i = i + 1) { v[i] = 1; k[i] = 0; }
        byte[] zero = new byte[1];
        byte[] oneb = new byte[1]; oneb[0] = 1;

        k = hmac256(k, v, zero, d32, h1m);
        byte[] t = hmac256(k, v, null, null, null);
        NativeMemory.Copy((nint)v, (nint)t, 32);
        k = hmac256(k, v, oneb, d32, h1m);
        t = hmac256(k, v, null, null, null);
        NativeMemory.Copy((nint)v, (nint)t, 32);

        long[] kl = new long[8];
        long[] rx = new long[8];
        long[] ry = new long[8];
        BigInt ei = BigInt.FromBytesBE(h1, 32);

        while (true) {
            t = hmac256(k, v, null, null, null);
            NativeMemory.Copy((nint)v, (nint)t, 32);
            EcField256.FromBytesBE(v, 0, kl);
            if (!EcField256.IsZero(kl) && EcField256.Cmp(kl, cd.N) < 0) {
                if (EcField256.ScalarMulG(EcField256.CurveP256, kl, rx, ry)) {
                    BigInt r = nmod(EcField256.ToBigInt(rx));
                    if (!r.isZero()) {
                        BigInt kb = BigInt.FromBytesBE(v, 32);
                        // s = k⁻¹(e + r·d) mod n
                        BigInt s = nmul(ninv(kb), nmod(BigInt.add(ei, nmul(r, dv))));
                        if (!s.isZero()) {
                            return EncodeSigDer(r, s, outLen);
                        }
                    }
                }
            }
            k = hmac256(k, v, zero, null, null);
            t = hmac256(k, v, null, null, null);
            NativeMemory.Copy((nint)v, (nint)t, 32);
        }
    }

    // 用 P-256 公钥（px32/py32，各 32 字节大端）校验消息的
    // DER ECDSA-SHA256 签名。任何格式错误都按无效处理。
    public static bool VerifySha256(string msg, int msgLen, byte[] sig, int sigLen, byte[] px32, byte[] py32) {
        init();
        if (px32 == null || py32 == null || px32.Length != 32 || py32.Length != 32) { return false; }
        long[] qx = new long[8];
        long[] qy = new long[8];
        EcField256.FromBytesBE(px32, 0, qx);
        EcField256.FromBytesBE(py32, 0, qy);
        if (!EcField256.IsOnCurve(EcField256.CurveP256, qx, qy)) { return false; }

        List<BigInt> rs = new List<BigInt>();
        if (!ParseSigDer(sig, sigLen, rs)) { return false; }
        BigInt r = rs[0];
        BigInt s = rs[1];
        byte[] h = Sha256.Hash(msg, msgLen);
        BigInt e = BigInt.FromBytesBE(h, 32);
        BigInt w = ninv(s);
        BigInt u1 = nmul(e, w);
        BigInt u2 = nmul(r, w);

        long[] u1l = new long[8];
        long[] u2l = new long[8];
        EcField256.FromBigInt(u1, u1l);
        EcField256.FromBigInt(u2, u2l);

        long[] rx = new long[8];
        long[] ry = new long[8];
        if (!EcField256.ShamirMul(EcField256.CurveP256, u1l, u2l, qx, qy, rx, ry)) { return false; }
        BigInt v = nmod(EcField256.ToBigInt(rx));
        return BigInt.cmp(v, r) == 0;
    }
}
