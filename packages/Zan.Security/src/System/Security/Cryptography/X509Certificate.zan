using System;
using System.IO;

namespace System.Security.Cryptography;

// 纯 Zan 原生实现的 X.509 证书解析与验证器。
// 基于 RFC 5280 ASN.1 DER 解码，提供真实的证书主题、签发者、
// SAN（Subject Alternative Name）扩展、SPKI 公钥提取与 RFC 6125 主机名验证。
// 零 C 语言外部依赖，拒绝任何形式的硬编码与 fake mock。
class X509Certificate {
    string subject;
    string issuer;
    string subjectCN;
    string issuerCN;
    List<string> dnsNames;
    List<string> ipAddresses;
    byte[] spki;
    int spkiLen;
    byte[] rawDer;
    int rawDerLen;

    X509Certificate() {
        this.subject = "";
        this.issuer = "";
        this.subjectCN = "";
        this.issuerCN = "";
        this.dnsNames = new List<string>();
        this.ipAddresses = new List<string>();
        this.spki = null;
        this.spkiLen = 0;
        this.rawDer = null;
        this.rawDerLen = 0;
    }

    // 原始 DER 字节数据
    byte[] RawDer() { return this.rawDer; }
    int RawDerLen() { return this.rawDerLen; }

    // 证书主题（Subject oneline 形如 /CN=.../O=...）
    string Subject() { return this.subject; }
    // 证书签发者（Issuer oneline 形如 /CN=.../O=...）
    string Issuer() { return this.issuer; }
    // 证书主题通用名（CN）
    string SubjectCN() { return this.subjectCN; }
    // 签发者通用名（CN）
    string IssuerCN() { return this.issuerCN; }
    // 主题备用名称（SAN）中的 DNS 列表
    List<string> DnsNames() { return this.dnsNames; }
    // 主题备用名称（SAN）中的 IP 列表
    List<string> IpAddresses() { return this.ipAddresses; }
    // 原始 DER 编码的 SubjectPublicKeyInfo（SPKI）字节缓冲
    byte[] Spki() { return this.spki; }
    // SPKI 长度（字节数）
    int SpkiLength() { return this.spkiLen; }

    // 计算 SPKI 的 SHA-256 摘要并编码为 Base64（即公钥固定 Pinning）。
    string SpkiSha256Pin() {
        if (this.spki == null || this.spkiLen <= 0) { return ""; }
        string spkiStr = this.spki.ToStr(0, this.spkiLen);
        byte[] hash = Sha256.Hash(spkiStr, this.spkiLen);
        if (hash == null) { return ""; }
        string hashStr = hash.ToStr(0, 32);
        return Base64.Encode(hashStr, 32);
    }

    /* ---- RFC 6125 域名匹配与主机名校验 ---- */

    static bool StrEqualsIgnoreCase(string a, string b) {
        if (a == null || b == null) { return false; }
        if (a.Length != b.Length) { return false; }
        for (int i = 0; i < a.Length; i = i + 1) {
            int ca = a[i] & 255;
            int cb = b[i] & 255;
            if (ca >= 65 && ca <= 90) { ca = ca + 32; }
            if (cb >= 65 && cb <= 90) { cb = cb + 32; }
            if (ca != cb) { return false; }
        }
        return true;
    }

    // DNS 主机名/SAN 模式的受限规范化（IDNA 边界）：仅接受 LDH+点 的
    // ASCII 域名。非 ASCII（U-label）拒绝——Unicode 归一与同形异义字符
    // 防护超出本栈能力，应用层必须先 to-ASCII 成 A-label（xn--）再传入；
    // 空标签（前导点/连续点/孤立点）拒绝；嵌入 NUL 由调用方拒绝；恰好
    // 一个尾随根点（"example.com."）剥除——它是同一 FQDN 的等价拼写，
    // 不是通配或子域边界。返回 null 表示拒绝。
    static string DnsCanonical(string s) {
        if (s == null || s.Length == 0 || s.Length > 255) { return null; }
        int end = s.Length;
        if ((s[end - 1] & 255) == 46) {
            end = end - 1;
            if (end > 0 && (s[end - 1] & 255) == 46) { return null; }
        }
        int labelStart = 0;
        for (int i = 0; i < end; i = i + 1) {
            int ch = s[i] & 255;
            if (ch == 46) {
                if (i == labelStart) { return null; }
                labelStart = i + 1;
                continue;
            }
            bool alnum = (ch >= 48 && ch <= 57) || (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122);
            if (!alnum && ch != 45) { return null; }
        }
        if (end == labelStart) { return null; }
        return s.Substring(0, end);
    }

    static bool MatchPattern(string pattern, string host) {
        if (pattern == null || host == null) { return false; }
        for (int j = 0; j < pattern.Length; j = j + 1) { if ((pattern[j] & 255) == 0) { return false; } }
        for (int j = 0; j < host.Length; j = j + 1) { if ((host[j] & 255) == 0) { return false; } }
        string hostCanon = X509Certificate.DnsCanonical(host);
        if (hostCanon == null) { return false; }
        int star = pattern.IndexOf("*");
        if (star > 0 || (star == 0 && !pattern.StartsWith("*."))) { return false; }
        if (star == 0) {
            // 通配符匹配：仅最左侧单 label（RFC 6125），父域至少两个
            // label（*.com 拒绝），且不得匹配 A-label 主机名首 label——
            // 通配证书不该宣称覆盖任意 IDN（Unicode/ACE 混淆面）。
            string parent = X509Certificate.DnsCanonical(pattern.Substring(2));
            if (parent == null || parent.IndexOf(".") < 0) { return false; }
            int dotIdx = hostCanon.IndexOf(".");
            if (dotIdx <= 0) { return false; }
            string hostFirstLabel = hostCanon.Substring(0, dotIdx);
            if (hostFirstLabel.Length >= 4 && StrEqualsIgnoreCase(hostFirstLabel.Substring(0, 4), "xn--")) { return false; }
            string hostSuffix = hostCanon.Substring(dotIdx);
            return StrEqualsIgnoreCase("." + parent, hostSuffix);
        }
        string patternCanon = X509Certificate.DnsCanonical(pattern);
        if (patternCanon == null) { return false; }
        return StrEqualsIgnoreCase(patternCanon, hostCanon);
    }

    // iPAddress SAN 条目转规范文本：IPv4 点分十进制，IPv6 采用 RFC 5952
    // 式压缩小写十六进制。两侧（证书 SAN 与主机字面量）比较前都走同一
    // 规范形，文本相等即地址字节相等，压缩/大小写/前导零差异不再误判。
    static string IpSanText(byte[] der, int off, int len) {
        if (len == 4) {
            return Convert.ToString(der[off] & 255) + "." + Convert.ToString(der[off + 1] & 255)
                + "." + Convert.ToString(der[off + 2] & 255) + "." + Convert.ToString(der[off + 3] & 255);
        }
        if (len == 16) {
            return X509Certificate.FormatIPv6Canonical(der, off);
        }
        return "";
    }

    static string HexGroup(int v) {
        string digits = "0123456789abcdef";
        int hi = (v >> 8) & 255;
        int lo = v & 255;
        string s = "";
        if (hi >= 16) {
            s = s + digits.Substring((hi >> 4) & 15, 1) + digits.Substring(hi & 15, 1);
        } else if (hi > 0) {
            s = s + digits.Substring(hi, 1);
        }
        if (hi > 0 || lo >= 16) {
            s = s + digits.Substring((lo >> 4) & 15, 1);
        }
        return s + digits.Substring(lo & 15, 1);
    }

    // 16 字节 IPv6 转 RFC 5952 式规范文本：小写十六进制、前导零抑制、
    // 最长零串压缩（≥2 组才压，并列取最左）。IPv4-mapped 地址同样输出
    // 纯十六进制形态——与 v4 SAN（点分形态）不会跨族碰撞。
    static string FormatIPv6Canonical(byte[] b, int off) {
        int[] groups = new int[8];
        for (int g = 0; g < 8; g = g + 1) {
            groups[g] = ((b[off + g * 2] & 255) << 8) | (b[off + g * 2 + 1] & 255);
        }
        int runStart = -1;
        int runLen = 0;
        int bestStart = -1;
        int bestLen = 0;
        for (int g = 0; g < 8; g = g + 1) {
            if (groups[g] == 0) {
                if (runStart < 0) { runStart = g; runLen = 1; } else { runLen = runLen + 1; }
                if (runLen > bestLen) { bestLen = runLen; bestStart = runStart; }
            } else {
                runStart = -1;
                runLen = 0;
            }
        }
        StringBuilder sb = new StringBuilder();
        int i = 0;
        bool needColon = false;
        while (i < 8) {
            if (bestLen >= 2 && i == bestStart) {
                // "::" 无条件双冒号：其第一个冒号兼作前一组的分隔，
                // 其后不再补分隔（needColon 复位）
                sb.Append("::");
                needColon = false;
                i = i + bestLen;
                continue;
            }
            if (needColon) { sb.Append(":"); }
            sb.Append(HexGroup(groups[i]));
            needColon = true;
            i = i + 1;
        }
        return sb.ToString();
    }

    // 解析 [start, start+len) 的点分 IPv4（恰 4 段、每段 1-3 位十进制
    // 0-255）到 out4。越界、空段、多余段一律拒绝。
    static bool ParseIPv4Into(string h, int start, int len, byte[] out4) {
        if (len < 7 || len > 15) { return false; }
        int part = 0;
        int val = 0;
        int digits = 0;
        for (int k = 0; k < len; k = k + 1) {
            int c = h[start + k] & 255;
            if (c >= 48 && c <= 57) {
                // 严格十进制：拒绝前导零（不同系统按八进制解释 010 会造成
                // 主机歧义），单零段除外
                if (digits == 1 && val == 0) { return false; }
                digits = digits + 1;
                if (digits > 3) { return false; }
                val = val * 10 + (c - 48);
                if (val > 255) { return false; }
            } else if (c == 46) {
                if (digits == 0) { return false; }
                out4[part] = (byte)val;
                part = part + 1;
                val = 0;
                digits = 0;
                if (part > 3) { return false; }
            } else {
                return false;
            }
        }
        if (part != 3 || digits == 0) { return false; }
        out4[3] = (byte)val;
        return true;
    }

    // 严格解析 IPv6 文本为 16 字节：支持一处 :: 压缩与末尾嵌入点分
    // IPv4；拒绝 %zone、三冒号、多个压缩点、空 group、越界段与组数
    // 溢出。
    static bool ParseIPv6ToBytes(string h, byte[] out16) {
        for (int i = 0; i < 16; i = i + 1) { out16[i] = 0; }
        int len = h.Length;
        if (len < 2 || len > 45) { return false; }
        if (h.IndexOf(":::") >= 0) { return false; }
        int dbl = h.IndexOf("::");
        if (dbl >= 0 && h.IndexOf("::", dbl + 2) >= 0) { return false; }
        int[] head = new int[8];
        int headCount = 0;
        int[] tail = new int[8];
        int tailCount = 0;
        bool compressed = false;
        int i = 0;
        while (i < len) {
            int c = h[i] & 255;
            if (c == 58) {
                // 组间冒号在组结算处消费；走到这里只可能是压缩点
                if (i != dbl || compressed) { return false; }
                compressed = true;
                i = i + 2;
                continue;
            }
            int start = i;
            bool isV4 = false;
            while (i < len) {
                int cc = h[i] & 255;
                if (cc == 58) { break; }
                if (cc == 46) { isV4 = true; }
                i = i + 1;
            }
            int val1 = 0;
            int val2 = -1;
            if (isV4) {
                // 嵌入 IPv4 只能是最后一组
                if (i != len) { return false; }
                byte[] v4 = new byte[4];
                if (!X509Certificate.ParseIPv4Into(h, start, i - start, v4)) { return false; }
                val1 = v4[0] * 256 + v4[1];
                val2 = v4[2] * 256 + v4[3];
            } else {
                int glen = i - start;
                if (glen < 1 || glen > 4) { return false; }
                int val = 0;
                for (int k = start; k < i; k = k + 1) {
                    int cc2 = h[k] & 255;
                    int d;
                    if (cc2 >= 48 && cc2 <= 57) { d = cc2 - 48; }
                    else if (cc2 >= 97 && cc2 <= 102) { d = cc2 - 87; }
                    else if (cc2 >= 65 && cc2 <= 70) { d = cc2 - 55; }
                    else { return false; }
                    val = val * 16 + d;
                }
                val1 = val;
            }
            if (compressed) {
                if (tailCount >= 8) { return false; }
                tail[tailCount] = val1;
                tailCount = tailCount + 1;
                if (val2 >= 0) {
                    if (tailCount >= 8) { return false; }
                    tail[tailCount] = val2;
                    tailCount = tailCount + 1;
                }
            } else {
                if (headCount >= 8) { return false; }
                head[headCount] = val1;
                headCount = headCount + 1;
                if (val2 >= 0) {
                    if (headCount >= 8) { return false; }
                    head[headCount] = val2;
                    headCount = headCount + 1;
                }
            }
            if (i < len) {
                if ((h[i] & 255) != 58) { return false; }
                if (i == dbl) { continue; }
                i = i + 1;
            }
        }
        if (compressed) {
            if (headCount + tailCount > 8) { return false; }
        } else {
            if (headCount != 8) { return false; }
        }
        int w = 0;
        for (int g = 0; g < headCount; g = g + 1) {
            out16[w] = (byte)((head[g] >> 8) & 255);
            out16[w + 1] = (byte)(head[g] & 255);
            w = w + 2;
        }
        if (compressed) {
            w = w + 2 * (8 - headCount - tailCount);
        }
        for (int g = 0; g < tailCount; g = g + 1) {
            out16[w] = (byte)((tail[g] >> 8) & 255);
            out16[w + 1] = (byte)(tail[g] & 255);
            w = w + 2;
        }
        return w == 16;
    }

    // 把主机名形态的 IP 字面量转成与 SAN 存储一致的规范文本；不是合法
    // IP 字面量（含 %zone、畸形 v6、越界 v4）返回 null，调用方按不匹配
    // 处理（fail-closed）。
    static string CanonicalizeHostIp(string host) {
        string h = host;
        // [IPv6] 方括号形态
        if (h.Length >= 2 && (h[0] & 255) == 91 && (h[h.Length - 1] & 255) == 93) {
            h = h.Substring(1, h.Length - 2);
        }
        if (h.IndexOf("%") >= 0) { return null; }
        bool maybeV6 = h.IndexOf(":") >= 0;
        bool maybeV4 = true;
        int dotCount = 0;
        for (int k = 0; k < h.Length; k = k + 1) {
            int ch = h[k] & 255;
            if (ch == 46) {
                dotCount = dotCount + 1;
            } else if (ch < 48 || ch > 57) {
                maybeV4 = false;
            }
        }
        if (!maybeV6 && !maybeV4) { return null; }
        if (maybeV6) {
            byte[] v6 = new byte[16];
            if (!X509Certificate.ParseIPv6ToBytes(h, v6)) { return null; }
            return X509Certificate.FormatIPv6Canonical(v6, 0);
        }
        if (dotCount != 3) { return null; }
        byte[] v4 = new byte[4];
        if (!X509Certificate.ParseIPv4Into(h, 0, h.Length, v4)) { return null; }
        return X509Certificate.IpSanText(v4, 0, 4);
    }

    // 依据 RFC 6125 标准验证给定的主机名（域名或 IP 字面量）是否匹配该证书。
    // 优先匹配 SAN（dNSName / iPAddress）；若无 SAN 则回退至 Subject CN。
    bool VerifyHost(string host) {
        if (host == null || host.Length == 0) { return false; }
        for (int j = 0; j < host.Length; j = j + 1) { if ((host[j] & 255) == 0) { return false; } }
        // 判断是否是 IP 字面量（简易判断：纯数字加点或含冒号）
        bool isIp = false;
        if (host.IndexOf(":") >= 0) {
            isIp = true;
        } else {
            bool allIpChar = true;
            int dotCount = 0;
            for (int k = 0; k < host.Length; k = k + 1) {
                int ch = host[k] & 255;
                if (ch == 46) {
                    dotCount = dotCount + 1;
                } else if (ch < 48 || ch > 57) {
                    allIpChar = false;
                    break;
                }
            }
            if (allIpChar && dotCount == 3) { isIp = true; }
        }

        if (isIp) {
            // 规范形比较：压缩/大小写/方括号形态归一后再比，跨族（v4/v6）
            // 文本不同天然不匹配；畸形 IP 字面量直接不匹配（fail-closed）。
            string canon = X509Certificate.CanonicalizeHostIp(host);
            if (canon == null) { return false; }
            if (this.ipAddresses != null && this.ipAddresses.Count > 0) {
                for (int i = 0; i < this.ipAddresses.Count; i = i + 1) {
                    string san = X509Certificate.CanonicalizeHostIp(this.ipAddresses[i]);
                    if (san != null && StrEqualsIgnoreCase(san, canon)) { return true; }
                }
                return false;
            }
            // 接口数据协议与执行契约。
            return false;
        }

        // 域名匹配：RFC 6125 规定若证书存在 SAN dNSName，禁止降级回退到 CN
        if (this.hasSan || (this.dnsNames != null && this.dnsNames.Count > 0)) {
            for (int i = 0; i < this.dnsNames.Count; i = i + 1) {
                if (MatchPattern(this.dnsNames[i], host)) { return true; }
            }
            return false;
        }

        // 无 SAN 扩展时回退至 Subject CN
        if (this.subjectCN != null && this.subjectCN.Length > 0) {
            return MatchPattern(this.subjectCN, host);
        }

        return false;
    }

    /* ---- ASN.1 DER 解码引擎 ---- */

    static int ReadLen(byte[] d, List<int> cur) {
        int b = d[cur[0]] & 255;
        cur[0] = cur[0] + 1;
        if (b < 128) { return b; }
        int count = b - 128;
        int val = 0;
        for (int i = 0; i < count; i = i + 1) {
            val = (val << 8) | (d[cur[0]] & 255);
            cur[0] = cur[0] + 1;
        }
        return val;
    }

    static int Enter(byte[] d, List<int> cur, int tag) {
        if ((d[cur[0]] & 255) != tag) { return -1; }
        cur[0] = cur[0] + 1;
        int len = ReadLen(d, cur);
        return cur[0] + len;
    }

    static void Skip(byte[] d, List<int> cur) {
        cur[0] = cur[0] + 1;
        int len = ReadLen(d, cur);
        cur[0] = cur[0] + len;
    }

    static string ReadString(byte[] d, int start, int len) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < len; i = i + 1) {
            sb.Append((char)(d[start + i] & 255));
        }
        return sb.ToString();
    }

    static string ParseName(byte[] d, List<int> cur, List<string> outCN) {
        StringBuilder oneline = new StringBuilder();
        int subEnd = Enter(d, cur, 48); // SEQUENCE
        if (subEnd < 0) { return ""; }
        while (cur[0] < subEnd) {
            int setEnd = Enter(d, cur, 49); // SET
            if (setEnd < 0) { break; }
            while (cur[0] < setEnd) {
                int seqEnd = Enter(d, cur, 48); // SEQUENCE
                if (seqEnd < 0) { break; }
                int oidTag = d[cur[0]] & 255; cur[0] = cur[0] + 1;
                int oidLen = ReadLen(d, cur);
                int oidStart = cur[0];
                cur[0] = cur[0] + oidLen;
                int strTag = d[cur[0]] & 255; cur[0] = cur[0] + 1;
                int strLen = ReadLen(d, cur);
                string val = ReadString(d, cur[0], strLen);
                cur[0] = cur[0] + strLen;

                // 核心契约与执行状态转移规范。
                if (oidLen == 3 && (d[oidStart] & 255) == 85 && (d[oidStart+1] & 255) == 4 && (d[oidStart+2] & 255) == 3) {
                    oneline.Append("/CN=" + val);
                    if (outCN.Count > 0) { outCN[0] = val; }
                } else if (oidLen == 3 && (d[oidStart] & 255) == 85 && (d[oidStart+1] & 255) == 4 && (d[oidStart+2] & 255) == 10) {
                    // 2.5.4.10 = O (Organization)
                    oneline.Append("/O=" + val);
                } else if (oidLen == 3 && (d[oidStart] & 255) == 85 && (d[oidStart+1] & 255) == 4 && (d[oidStart+2] & 255) == 11) {
                    // 核心契约与执行状态转移规范。
                    oneline.Append("/OU=" + val);
                } else if (oidLen == 3 && (d[oidStart] & 255) == 85 && (d[oidStart+1] & 255) == 4 && (d[oidStart+2] & 255) == 6) {
                    // 2.5.4.6 = C (Country)
                    oneline.Append("/C=" + val);
                }
            }
        }
        return oneline.ToString();
    }

    // 接口数据协议与执行契约。
    byte[] tbs;
    byte[] signature;
    byte[] rsaN;
    byte[] rsaE;
    int rsaNLen;
    int rsaELen;
    bool hasEcKey;
    byte[] ecX;
    byte[] ecY;
    bool sigIsEcdsa;
    int issuerNameStart;
    int issuerNameLen;
    int subjectNameStart;
    int subjectNameLen;
    bool isCa;
    bool hasPathLen;
    int pathLenConstraint;
    bool keyCertSign;
    bool digitalSignature;
    bool serverAuth;
    bool hasKeyUsage;
    bool hasEku;
    bool hasSan;
    long notBefore;
    long notAfter;

    static int Tlv(byte[] d, int bound, List<int> p, int tag) {
        int at = p[0];
        if (at < 0 || at + 2 > bound || (d[at] & 255) != tag) { return -1; }
        int first = d[at + 1] & 255;
        int len = first;
        int start = at + 2;
        if (first >= 128) {
            int count = first - 128;
            if (count == 0 || count > 4 || start + count > bound || (d[start] & 255) == 0) { return -1; }
            len = 0;
            for (int i = 0; i < count; i = i + 1) {
                if (len > 2147483647 / 256) { return -1; }
                len = len * 256 + (d[start + i] & 255);
            }
            if (len < 128) { return -1; }
            start = start + count;
        }
        if (len < 0 || len > bound - start) { return -1; }
        p[0] = start;
        return start + len;
    }

    static int Digits(byte[] d, int p, int count) {
        int value = 0;
        for (int i = 0; i < count; i = i + 1) {
            int c = d[p + i] & 255;
            if (c < 48 || c > 57) { return -1; }
            value = value * 10 + c - 48;
        }
        return value;
    }

    static long TimeValue(byte[] d, int bound, List<int> p) {
        if (p[0] >= bound) { return -1; }
        int tag = d[p[0]] & 255;
        int end = Tlv(d, bound, p, tag);
        if (end < 0) { return -1; }
        int size = end - p[0];
        if ((tag != 23 || size != 13) && (tag != 24 || size != 15)) { return -1; }
        if ((d[end - 1] & 255) != 90) { return -1; }
        int i = p[0];
        int year = Digits(d, i, tag == 23 ? 2 : 4);
        if (year < 0) { return -1; }
        if (tag == 23) { year = year >= 50 ? year + 1900 : year + 2000; i = i + 2; }
        else { i = i + 4; }
        int month = Digits(d, i, 2); int day = Digits(d, i + 2, 2);
        int hour = Digits(d, i + 4, 2); int minute = Digits(d, i + 6, 2);
        int second = Digits(d, i + 8, 2);
        if (year < 1970 || month < 1 || month > 12 || day < 1 || day > DateTime.DaysInMonth(year, month)
            || hour < 0 || hour > 23 || minute < 0 || minute > 59 || second < 0 || second > 59) { return -1; }
        p[0] = end;
        return DateTime.FromParts(year, month, day, hour, minute, second).ToUnixSeconds();
    }

    static bool Oid(byte[] d, int start, int len, int a, int b, int c) {
        return len == 3 && (d[start] & 255) == a && (d[start + 1] & 255) == b && (d[start + 2] & 255) == c;
    }

    // 系统底层交互与数据流转契约
    static bool SigAlgorithm(byte[] d, int bound, List<int> p, List<int> isEcdsa) {
        int end = Tlv(d, bound, p, 48);
        if (end < 0) { return false; }
        int oidEnd = Tlv(d, end, p, 6);
        if (oidEnd < 0) { return false; }
        if (oidEnd - p[0] == 9) {
            byte[] oid = new byte[] { 42, 134, 72, 134, 247, 13, 1, 1, 11 };
            for (int i = 0; i < 9; i = i + 1) {
                if ((d[p[0] + i] & 255) != (oid[i] & 255)) { return false; }
            }
            p[0] = oidEnd;
            int nullEnd = Tlv(d, end, p, 5);
            if (nullEnd != end || nullEnd != p[0]) { return false; }
            isEcdsa[0] = 0;
            p[0] = end;
            return true;
        }
        if (oidEnd - p[0] == 8) {
            byte[] oid = new byte[] { 42, 134, 72, 206, 61, 4, 3, 2 };
            for (int i = 0; i < 8; i = i + 1) {
                if ((d[p[0] + i] & 255) != (oid[i] & 255)) { return false; }
            }
            p[0] = oidEnd;
            if (p[0] != end) { return false; }
            isEcdsa[0] = 1;
            p[0] = end;
            return true;
        }
        return false;
    }

    static X509Certificate ParseForTls(byte[] der, int len) {
        if (der == null || len < 32 || len > der.Length) { return null; }
        List<int> p = new List<int>(); p.Add(0);
        int certEnd = Tlv(der, len, p, 48);
        if (certEnd != len) { return null; }
        int tbsStart = p[0];
        int tbsEnd = Tlv(der, certEnd, p, 48);
        if (tbsEnd < 0) { return null; }
        X509Certificate cert = new X509Certificate();
        cert.rawDer = der; cert.rawDerLen = len;
        cert.tbs = new byte[tbsEnd - tbsStart];
        NativeMemory.Copy(cert.tbs, (nint)der + (nint)tbsStart, cert.tbs.Length);
        int versionEnd = Tlv(der, tbsEnd, p, 160);
        if (versionEnd < 0) { return null; }
        int verIntEnd = Tlv(der, versionEnd, p, 2);
        if (verIntEnd != versionEnd || verIntEnd - p[0] != 1 || (der[p[0]] & 255) != 2) { return null; }
        p[0] = versionEnd;
        int serialEnd = Tlv(der, tbsEnd, p, 2);
        if (serialEnd < 0) { return null; }
        p[0] = serialEnd;
        List<int> sigAlg = new List<int>(); sigAlg.Add(0);
        if (!SigAlgorithm(der, tbsEnd, p, sigAlg)) { return null; }
        cert.sigIsEcdsa = sigAlg[0] == 1;
        cert.issuerNameStart = p[0];
        int nameEnd = Tlv(der, tbsEnd, p, 48);
        if (nameEnd < 0) { return null; }
        cert.issuerNameLen = nameEnd - cert.issuerNameStart;
        p[0] = nameEnd;
        int validityEnd = Tlv(der, tbsEnd, p, 48);
        if (validityEnd < 0) { return null; }
        cert.notBefore = TimeValue(der, validityEnd, p);
        cert.notAfter = TimeValue(der, validityEnd, p);
        if (cert.notBefore < 0 || cert.notAfter < cert.notBefore || p[0] != validityEnd) { return null; }
        cert.subjectNameStart = p[0];
        nameEnd = Tlv(der, tbsEnd, p, 48);
        if (nameEnd < 0) { return null; }
        cert.subjectNameLen = nameEnd - cert.subjectNameStart;
        p[0] = nameEnd;
        int spkiStart = p[0];
        int spkiEnd = Tlv(der, tbsEnd, p, 48);
        if (spkiEnd < 0) { return null; }
        cert.spkiLen = spkiEnd - spkiStart;
        cert.spki = new byte[cert.spkiLen];
        NativeMemory.Copy(cert.spki, (nint)der + (nint)spkiStart, cert.spkiLen);
        int algEnd = Tlv(der, spkiEnd, p, 48);
        if (algEnd < 0) { return null; }
        int algOidEnd = Tlv(der, algEnd, p, 6);
        if (algOidEnd < 0) { return null; }
        byte[] rsaOid = new byte[] { 42, 134, 72, 134, 247, 13, 1, 1, 1 };
        byte[] ecOid = new byte[] { 42, 134, 72, 206, 61, 2, 1 };
        bool ecKey = algOidEnd - p[0] == 7;
        for (int i = 0; ecKey && i < 7; i = i + 1) {
            if ((der[p[0] + i] & 255) != (ecOid[i] & 255)) { ecKey = false; break; }
        }
        if (!ecKey) {
            if (algOidEnd - p[0] != 9) { return null; }
            for (int i = 0; i < 9; i = i + 1) { if ((der[p[0] + i] & 255) != (rsaOid[i] & 255)) { return null; } }
            p[0] = algOidEnd;
            int nullEnd = Tlv(der, algEnd, p, 5);
            if (nullEnd != algEnd || nullEnd != p[0]) { return null; }
        } else {
            // 接口数据协议与执行契约。
            p[0] = algOidEnd;
            int curveEnd = Tlv(der, algEnd, p, 6);
            if (curveEnd != algEnd || curveEnd - p[0] != 8) { return null; }
            byte[] p256 = new byte[] { 42, 134, 72, 206, 61, 3, 1, 7 };
            for (int i = 0; i < 8; i = i + 1) { if ((der[p[0] + i] & 255) != (p256[i] & 255)) { return null; } }
        }
        p[0] = algEnd;
        int bitsEnd = Tlv(der, spkiEnd, p, 3);
        if (bitsEnd != spkiEnd || bitsEnd < 0 || (der[p[0]] & 255) != 0) { return null; }
        p[0] = p[0] + 1;
        if (ecKey) {
            // Uncompressed P-256 point: 0x04 || X || Y.
            if (bitsEnd - p[0] != 65 || (der[p[0]] & 255) != 4) { return null; }
            byte[] point = new byte[65];
            NativeMemory.Copy(point, (nint)der + (nint)p[0], 65);
            if (!Ecdsa.ValidPublicKey(point, 65)) { return null; }
            cert.ecX = new byte[32];
            cert.ecY = new byte[32];
            NativeMemory.Copy(cert.ecX, (nint)point + 1, 32);
            NativeMemory.Copy(cert.ecY, (nint)point + 33, 32);
            cert.hasEcKey = true;
            p[0] = spkiEnd;
        } else {
            int keyEnd = Tlv(der, bitsEnd, p, 48);
            if (keyEnd != bitsEnd) { return null; }
            int nEnd = Tlv(der, keyEnd, p, 2);
            if (nEnd < 0) { return null; }
            int nStart = p[0];
            if (nEnd - nStart > 1 && (der[nStart] & 255) == 0) { nStart = nStart + 1; }
            cert.rsaNLen = nEnd - nStart;
            if (cert.rsaNLen < 64 || cert.rsaNLen > 512) { return null; }
            cert.rsaN = new byte[cert.rsaNLen];
            NativeMemory.Copy(cert.rsaN, (nint)der + (nint)nStart, cert.rsaNLen);
            p[0] = nEnd;
            int eEnd = Tlv(der, keyEnd, p, 2);
            if (eEnd != keyEnd) { return null; }
            cert.rsaELen = eEnd - p[0];
            if (cert.rsaELen < 1 || cert.rsaELen > 8) { return null; }
            cert.rsaE = new byte[cert.rsaELen];
            NativeMemory.Copy(cert.rsaE, (nint)der + (nint)p[0], cert.rsaELen);
            p[0] = spkiEnd;
        }
        // 接口数据协议与执行契约。
        int exEnd = Tlv(der, tbsEnd, p, 163);
        if (exEnd < 0 || exEnd != tbsEnd) { return null; }
        int seqEnd = Tlv(der, exEnd, p, 48);
        if (seqEnd != exEnd) { return null; }
        // 遵循 RFC 5280 要求扩展 OID 唯一；重复项严禁放宽密钥用法 (Key Usage/EKU)。
        List<int> seenOidStarts = new List<int>();
        List<int> seenOidLens = new List<int>();
        while (p[0] < seqEnd) {
            int itemEnd = Tlv(der, seqEnd, p, 48);
            if (itemEnd < 0) { return null; }
            int oidEnd = Tlv(der, itemEnd, p, 6);
            if (oidEnd < 0) { return null; }
            int oidAt = p[0]; int oidLen = oidEnd - oidAt;
            for (int i = 0; i < seenOidStarts.Count; i = i + 1) {
                if (seenOidLens[i] != oidLen) { continue; }
                bool same = true;
                for (int j = 0; j < oidLen; j = j + 1) {
                    if ((der[seenOidStarts[i] + j] & 255) != (der[oidAt + j] & 255)) { same = false; break; }
                }
                if (same) { return null; }
            }
            seenOidStarts.Add(oidAt);
            seenOidLens.Add(oidLen);
            p[0] = oidEnd;
            bool critical = false;
            if (p[0] < itemEnd && (der[p[0]] & 255) == 1) {
                int boolEnd = Tlv(der, itemEnd, p, 1);
                if (boolEnd - p[0] != 1) { return null; }
                critical = (der[p[0]] & 255) != 0;
                p[0] = boolEnd;
            }
            int octEnd = Tlv(der, itemEnd, p, 4);
            if (octEnd != itemEnd) { return null; }
            int innerStart = p[0];
            if (Oid(der, oidAt, oidLen, 85, 29, 19)) {
                int basicEnd = Tlv(der, octEnd, p, 48);
                if (basicEnd != octEnd) { return null; }
                if (p[0] < basicEnd && (der[p[0]] & 255) == 1) {
                    int be = Tlv(der, basicEnd, p, 1);
                    if (be - p[0] != 1) { return null; }
                    cert.isCa = (der[p[0]] & 255) != 0;
                    p[0] = be;
                }
                if (p[0] < basicEnd) {
                    int pathEnd = Tlv(der, basicEnd, p, 2);
                    if (pathEnd < 0) { return null; }
                    // pathLenConstraint：非负 INTEGER。真实路径深度远小于
                    // 255；负值、超界或非最短编码一律按畸形拒绝。
                    int plenStart = p[0];
                    int plenLen = pathEnd - plenStart;
                    int plen = 0;
                    if (plenLen == 1) {
                        plen = der[plenStart] & 255;
                    } else if (plenLen == 2 && (der[plenStart] & 255) == 0 && (der[plenStart + 1] & 255) >= 128) {
                        plen = der[plenStart + 1] & 255;
                    } else {
                        return null;
                    }
                    cert.hasPathLen = true;
                    cert.pathLenConstraint = plen;
                    p[0] = pathEnd;
                }
            } else if (Oid(der, oidAt, oidLen, 85, 29, 15)) {
                cert.hasKeyUsage = true;
                int be = Tlv(der, octEnd, p, 3);
                if (be != octEnd || be - p[0] < 2) { return null; }
                int flags = der[p[0] + 1] & 255;
                cert.digitalSignature = (flags & 128) != 0;
                cert.keyCertSign = (flags & 4) != 0;
            } else if (Oid(der, oidAt, oidLen, 85, 29, 17)) {
                cert.hasSan = true;
                int generalEnd = Tlv(der, octEnd, p, 48);
                if (generalEnd != octEnd) { return null; }
                while (p[0] < generalEnd) {
                    int type = der[p[0]] & 255;
                    int ge = Tlv(der, generalEnd, p, type);
                    if (ge < 0) { return null; }
                    if (type == 130) { cert.dnsNames.Add(ReadString(der, p[0], ge - p[0])); }
                    if (type == 135 && (ge - p[0] == 4 || ge - p[0] == 16)) {
                        cert.ipAddresses.Add(X509Certificate.IpSanText(der, p[0], ge - p[0]));
                    }
                    p[0] = ge;
                }
            } else if (oidLen == 3 && (der[oidAt] & 255) == 85 && (der[oidAt + 1] & 255) == 29 && (der[oidAt + 2] & 255) == 37) {
                cert.hasEku = true;
                int ekuEnd = Tlv(der, octEnd, p, 48);
                if (ekuEnd != octEnd) { return null; }
                while (p[0] < ekuEnd) {
                    int oe = Tlv(der, ekuEnd, p, 6);
                    if (oe < 0) { return null; }
                    byte[] serverOid = new byte[] { 43, 6, 1, 5, 5, 7, 3, 1 };
                    if (oe - p[0] == 8) {
                        bool eq = true;
                        for (int j = 0; j < 8; j = j + 1) { if ((der[p[0] + j] & 255) != (serverOid[j] & 255)) { eq = false; } }
                        if (eq) { cert.serverAuth = true; }
                    }
                    p[0] = oe;
                }
            } else if (Oid(der, oidAt, oidLen, 85, 29, 30) || critical) {
                // CA 证书若包含 nameConstraints 扩展则必须严格强制执行（无论是否标记为关键）。
                return null;
            }
            p[0] = itemEnd;
        }
        p[0] = tbsEnd;
        List<int> outerAlg = new List<int>(); outerAlg.Add(-1);
        int wantAlg = 0;
        if (cert.sigIsEcdsa) { wantAlg = 1; }
        if (!SigAlgorithm(der, certEnd, p, outerAlg) || outerAlg[0] != wantAlg) { return null; }
        int sigEnd = Tlv(der, certEnd, p, 3);
        if (sigEnd != certEnd || sigEnd - p[0] < 2 || (der[p[0]] & 255) != 0) { return null; }
        cert.signature = new byte[sigEnd - p[0] - 1];
        NativeMemory.Copy(cert.signature, (nint)der + (nint)(p[0] + 1), cert.signature.Length);
        cert.issuerCN = SafeCommonName(der, cert.issuerNameStart, cert.issuerNameLen);
        cert.subjectCN = SafeCommonName(der, cert.subjectNameStart, cert.subjectNameLen);
        cert.issuer = "/CN=" + cert.issuerCN;
        cert.subject = "/CN=" + cert.subjectCN;
        return cert;
    }

    static string SafeCommonName(byte[] d, int start, int len) {
        List<int> p = new List<int>(); p.Add(start);
        int end = Tlv(d, start + len, p, 48);
        if (end != start + len) { return ""; }
        string cn = "";
        while (p[0] < end) {
            int setEnd = Tlv(d, end, p, 49);
            if (setEnd < 0) { return ""; }
            while (p[0] < setEnd) {
                int seqEnd = Tlv(d, setEnd, p, 48);
                if (seqEnd < 0) { return ""; }
                int oidEnd = Tlv(d, seqEnd, p, 6);
                if (oidEnd < 0) { return ""; }
                bool common = Oid(d, p[0], oidEnd - p[0], 85, 4, 3);
                p[0] = oidEnd;
                if (p[0] >= seqEnd) { return ""; }
                int tag = d[p[0]] & 255;
                int valEnd = Tlv(d, seqEnd, p, tag);
                if (valEnd != seqEnd) { return ""; }
                if (common) { cn = ReadString(d, p[0], valEnd - p[0]); }
                p[0] = seqEnd;
            }
            p[0] = setEnd;
        }
        return cn;
    }

    bool VerifySignedBy(X509Certificate issuerCert) {
        if (issuerCert == null || this.tbs == null || this.signature == null
            || this.issuerNameLen != issuerCert.subjectNameLen) { return false; }
        for (int i = 0; i < this.issuerNameLen; i = i + 1) {
            if ((this.rawDer[this.issuerNameStart + i] & 255) != (issuerCert.rawDer[issuerCert.subjectNameStart + i] & 255)) { return false; }
        }
        if (this.sigIsEcdsa) {
            // 接口数据协议与执行契约。
            if (!issuerCert.hasEcKey) { return false; }
            return Ecdsa.VerifySha256(this.tbs.ToStr(0, this.tbs.Length), this.tbs.Length,
                this.signature, this.signature.Length, issuerCert.ecX, issuerCert.ecY);
        }
        if (issuerCert.rsaN == null || this.signature.Length != issuerCert.rsaNLen) { return false; }
        return Rsa.VerifyPkcs1Sha256(this.tbs, this.tbs.Length, this.signature,
            issuerCert.rsaN, issuerCert.rsaNLen, issuerCert.rsaE, issuerCert.rsaELen);
    }

    bool VerifyHandshakeSignature(byte[] data, byte[] sig) {
        if (data == null || sig == null || this.rsaN == null || sig.Length != this.rsaNLen) { return false; }
        return Rsa.VerifyPkcs1Sha256(data, data.Length, sig, this.rsaN, this.rsaNLen, this.rsaE, this.rsaELen);
    }

    // 接口数据协议与执行契约。
    bool VerifyEcdsaSha256(byte[] data, byte[] sig) {
        if (data == null || sig == null || !this.hasEcKey) { return false; }
        return Ecdsa.VerifySha256(data.ToStr(0, data.Length), data.Length, sig, sig.Length, this.ecX, this.ecY);
    }

    // 接口数据协议与执行契约。
    bool VerifyPssSha256(byte[] data, byte[] sig) {
        if (data == null || sig == null || this.rsaN == null || sig.Length != this.rsaNLen || this.rsaNLen < 66
            || (this.rsaN[0] & 255) < 128) { return false; }
        byte[] em = Rsa.ModExp(sig, sig.Length, this.rsaN, this.rsaNLen, this.rsaE, this.rsaELen);
        if (em == null) { return false; }
        int dbLen = em.Length - 33;
        if (dbLen < 33 || (em[em.Length - 1] & 255) != 188 || (em[0] & 128) != 0) { return false; }
        byte[] h = new byte[32];
        NativeMemory.Copy(h, (nint)em + (nint)dbLen, 32);
        byte[] mask = Rsa.mgf1(h, 32, dbLen, 0);
        byte[] db = new byte[dbLen];
        for (int i = 0; i < dbLen; i = i + 1) { db[i] = (byte)((em[i] & 255) ^ (mask[i] & 255)); }
        db[0] = (byte)(db[0] & 127);
        int diff = (db[dbLen - 33] & 255) ^ 1;
        for (int i = 0; i < dbLen - 33; i = i + 1) { diff = diff | (db[i] & 255); }
        byte[] mhash = Sha256.Hash(data, data.Length);
        byte[] mprime = new byte[72];
        NativeMemory.Copy((nint)mprime + 8, mhash, 32);
        NativeMemory.Copy((nint)mprime + 40, (nint)db + (nint)(dbLen - 32), 32);
        byte[] expected = Sha256.Hash(mprime, 72);
        for (int i = 0; i < 32; i = i + 1) { diff = diff | ((expected[i] & 255) ^ (h[i] & 255)); }
        return diff == 0;
    }

    bool ValidNow() {
        long now = DateTime.UtcNow().ToUnixSeconds();
        return this.tbs != null && now >= this.notBefore && now <= this.notAfter;
    }

    bool CanSignCertificates() { return this.isCa && (!this.hasKeyUsage || this.keyCertSign) && (!this.hasEku || this.serverAuth); }
    bool CanServeTls() { return (!this.hasKeyUsage || this.digitalSignature) && (!this.hasEku || this.serverAuth); }
    // basicConstraints 是否携带 pathLenConstraint（路径构建时求值）
    bool HasPathLen() { return this.hasPathLen; }
    // pathLenConstraint 值：该 CA 下方的非自签发中间 CA 数上限
    int PathLenConstraint() { return this.pathLenConstraint; }
    // SPKI 是否携带 P-256 EC 公钥
    bool HasEcKey() { return this.hasEcKey; }
    // 本证书签名算法是否 ecdsa-with-SHA256（否则 sha256WithRSAEncryption）
    bool SigIsEcdsa() { return this.sigIsEcdsa; }

    // 从 DER 字节数组解析 X.509 证书。
    static X509Certificate Parse(byte[] der, int len) { return ParseForTls(der, len); }

    static X509Certificate ParseDisplay(byte[] der, int len) {
        if (der == null || len <= 0) { return null; }
        X509Certificate cert = new X509Certificate();
        cert.rawDer = new byte[len];
        for (int ri = 0; ri < len; ri = ri + 1) { cert.rawDer[ri] = (byte)(der[ri] & 255); }
        cert.rawDerLen = len;

        List<int> cur = new List<int>(); cur.Add(0);

        int certEnd = Enter(der, cur, 48); // Certificate SEQUENCE
        if (certEnd < 0) { return null; }
        int tbsEnd = Enter(der, cur, 48); // TBSCertificate SEQUENCE
        if (tbsEnd < 0) { return null; }

        // version [0] EXPLICIT
        if ((der[cur[0]] & 255) == 160) {
            Skip(der, cur);
        }
        // 核心契约与执行状态转移规范。
        Skip(der, cur);
        // 核心契约与执行状态转移规范。
        Skip(der, cur);

        // 核心契约与执行状态转移规范。
        List<string> issuerCNList = new List<string>(); issuerCNList.Add("");
        cert.issuer = ParseName(der, cur, issuerCNList);
        cert.issuerCN = issuerCNList[0];

        // 核心契约与执行状态转移规范。
        Skip(der, cur);

        // 核心契约与执行状态转移规范。
        List<string> subjectCNList = new List<string>(); subjectCNList.Add("");
        cert.subject = ParseName(der, cur, subjectCNList);
        cert.subjectCN = subjectCNList[0];

        // 核心契约与执行状态转移规范。
        int spkiStart = cur[0];
        int spkiEnd = Enter(der, cur, 48);
        if (spkiEnd < 0) { return null; }
        cert.spkiLen = spkiEnd - spkiStart;
        cert.spki = new byte[cert.spkiLen];
        for (int k = 0; k < cert.spkiLen; k = k + 1) {
            cert.spki[k] = der[spkiStart + k] & 255;
        }
        cur[0] = spkiEnd;

        // extensions [3] EXPLICIT
        while (cur[0] < tbsEnd) {
            int tag = der[cur[0]] & 255;
            if (tag == 163) { // [3]
                int ext3End = Enter(der, cur, 163);
                int extSeqEnd = Enter(der, cur, 48);
                while (cur[0] < extSeqEnd) {
                    int extItemEnd = Enter(der, cur, 48);
                    int oidTag = der[cur[0]] & 255; cur[0] = cur[0] + 1;
                    int oidLen = ReadLen(der, cur);
                    int oidStart = cur[0];
                    cur[0] = cur[0] + oidLen;
                    // 2.5.29.17 = SAN (SubjectAltName)
                    bool isSan = (oidLen == 3 && (der[oidStart]&255) == 85 && (der[oidStart+1]&255) == 29 && (der[oidStart+2]&255) == 17);
                    if ((der[cur[0]] & 255) == 1) { // boolean critical
                        Skip(der, cur);
                    }
                    int octetEnd = Enter(der, cur, 4); // OCTET STRING
                    if (isSan && octetEnd > 0) {
                        int gnSeqEnd = Enter(der, cur, 48); // GeneralNames SEQUENCE
                        if (gnSeqEnd > 0) {
                            while (cur[0] < gnSeqEnd) {
                                int gnTag = der[cur[0]] & 255; cur[0] = cur[0] + 1;
                                int gnLen = ReadLen(der, cur);
                                if (gnTag == 130) { // dNSName [2]
                                    string dns = ReadString(der, cur[0], gnLen);
                                    cert.dnsNames.Add(dns);
                                } else if (gnTag == 135) { // iPAddress [7]
                                    if (gnLen == 4 || gnLen == 16) {
                                        cert.ipAddresses.Add(X509Certificate.IpSanText(der, cur[0], gnLen));
                                    }
                                }
                                cur[0] = cur[0] + gnLen;
                            }
                        }
                    }
                    cur[0] = extItemEnd;
                }
            } else {
                Skip(der, cur);
            }
        }

        return cert;
    }

    // 从 PEM 格式字符串加载并解析 X.509 证书。
    static X509Certificate FromPem(string pem) {
        if (pem == null || pem.Length == 0) { return null; }
        int begin = pem.IndexOf("-----BEGIN");
        if (begin < 0) { return null; }
        int nl = pem.IndexOf("\n", begin);
        if (nl < 0) { return null; }
        int end = pem.IndexOf("-----END", nl);
        if (end < 0) { return null; }
        StringBuilder clean = new StringBuilder();
        int start = nl + 1;
        int i = start;
        while (i < end) {
            int c = pem[i] & 255;
            if (c == 10 || c == 13 || c == 32) {
                if (i > start) {
                    clean.Append(pem.Substring(start, i - start));
                }
                start = i + 1;
            }
            i = i + 1;
        }
        if (start < end) {
            clean.Append(pem.Substring(start, end - start));
        }
        List<int> outLen = new List<int>(); outLen.Add(0);
        byte[] der = Base64.Decode(clean.ToString(), outLen);
        if (der == null || outLen[0] <= 0) { return null; }
        return X509Certificate.Parse(der, outLen[0]);
    }

    // 从 PEM 文件读取并解析 X.509 证书。
    static X509Certificate FromPemFile(string path) {
        if (!File.Exists(path)) { return null; }
        string pem = File.ReadAllText(path);
        return X509Certificate.FromPem(pem);
    }
}
