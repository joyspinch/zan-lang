using System;

namespace System.Security.Cryptography;

// GB/T 32907-2016 SM4（中国国家分组密码标准）：128 位分组，128 位密钥，32 轮迭代。
// 100% 纯 Zan 自举实现，提供单分组 ECB 以及 CBC 模式。
// 消除所有堆分配，采用原位寄存器轮转与零 C 依赖。
public class Sm4 {
    static int[] CK;
    static bool inited = false;

    private static int RotL32(int x, int n) {
        return (int)(((uint)x << n) | ((uint)x >> (32 - n)));
    }

    private static int RotL8(int v, int n) {
        return (((v << n) | (v >> (8 - n))) & 255);
    }

    private static void InitTables() {
        if (inited) { return; }

        CK = new int[32];
        for (int i = 0; i < 32; i = i + 1) {
            int w = 0;
            for (int j = 0; j < 4; j = j + 1) {
                w = (w << 8) | (((4 * i + j) * 7) & 255);
            }
            CK[i] = w;
        }

        inited = true;
    }

    // —— S 盒恒定时间核心（B-ID85）——
    // 曾用静态 S-box 数组直查（缓存时序侧信道可还原密钥/明文）。现与运行时
    // C 版（rt_hw_accel.c）、AESNI 硬件路径同一同构分解：
    //   S(x) = M2( AES_S( M1(x) ) ⊕ 0x0f )
    // M1/M2 为 4→8 位仿射（位选择实现，无查表无分支）；AES_S 为
    // GF(2^8) mod x^8+x^4+x^3+x+1 的恒定时间逆（Itoh 链 15 乘）+ 仿射 0x63。
    // 全程固定轮数、按位掩码选择，无数据相关分支与查表。

    // 位选择仿射（4→8 位）：r = c ^ XOR d[i]·bit_i(v)
    private static int Sel4(int c, int d0, int d1, int d2, int d3, int v) {
        int r = c;
        r ^= d0 & (0 - (v & 1));
        r ^= d1 & (0 - ((v >> 1) & 1));
        r ^= d2 & (0 - ((v >> 2) & 1));
        r ^= d3 & (0 - ((v >> 3) & 1));
        return r;
    }

    // GF(2^8) mod x^8+x^4+x^3+x+1 恒定时间乘（固定 8 轮移位-规约）
    private static int GfMul8(int a, int b) {
        int r = 0;
        for (int i = 0; i < 8; i = i + 1) {
            r ^= a & (0 - (b & 1));
            int hi = (a >> 7) & 1;
            a = ((a << 1) & 255) ^ (0x1b & (0 - hi));
            b = (b >> 1) & 255;
        }
        return r & 255;
    }

    // 域内逆：x^254 = x^(250+4)，Itoh 链（固定 15 次域乘），x=0 归 0
    private static int GfInv8(int x) {
        int x2 = GfMul8(x, x);
        int x4 = GfMul8(x2, x2);
        int x3 = GfMul8(x2, x);
        int x6 = GfMul8(x3, x3);
        int x7 = GfMul8(x6, x);
        int x14 = GfMul8(x7, x7);
        int x15 = GfMul8(x14, x);
        int x30 = GfMul8(x15, x15);
        int x31 = GfMul8(x30, x);
        int x62 = GfMul8(x31, x31);
        int x124 = GfMul8(x62, x62);
        int x125 = GfMul8(x124, x);
        int x250 = GfMul8(x125, x125);
        int x252 = GfMul8(x250, x2);
        int x254 = GfMul8(x252, x2);
        int nz = ((x | (0 - x)) >> 31) & 1;   // x≠0 → 1
        return x254 & (0 - nz);
    }

    // AES S-box（恒定时间）：域逆 + 仿射 0x63
    private static int AesSboxCt(int u) {
        int v = GfInv8(u);
        return (v ^ RotL8(v, 1) ^ RotL8(v, 2) ^ RotL8(v, 3) ^ RotL8(v, 4) ^ 0x63) & 255;
    }

    // SM4 S-box（恒定时间）：M1 → AES_S ⊕0x0f → M2（M2 低半字节取反）
    private static int SboxCt(int x) {
        int u = (Sel4(0x00, 0xa2, 0x49, 0x09, 0x12, (x >> 4) & 15)
               ^ Sel4(0x01, 0x06, 0x73, 0xe5, 0x56, x & 15)) & 255;
        int v = (AesSboxCt(u) ^ 0x0f) & 255;
        return (Sel4(0x00, 0xdc, 0xaf, 0xdd, 0xbf, (v >> 4) & 15)
              ^ Sel4(0x34, 0x3c, 0xa9, 0xfa, 0xb6, (~v) & 15)) & 255;
    }

    // 非线性变换 τ：32 位字逐字节过 S 盒
    private static int Tau(int a) {
        return ((SboxCt((a >> 24) & 255) << 24) |
                (SboxCt((a >> 16) & 255) << 16) |
                (SboxCt((a >> 8) & 255) << 8) |
                SboxCt(a & 255));
    }

    // 轮函数线性变换 L：B ^ B<<<2 ^ B<<<10 ^ B<<<18 ^ B<<<24
    private static int LTrans(int b) {
        return b ^ RotL32(b, 2) ^ RotL32(b, 10) ^ RotL32(b, 18) ^ RotL32(b, 24);
    }

    // 密钥扩展线性变换 L'：B ^ B<<<13 ^ B<<<23
    private static int LpTrans(int b) {
        return b ^ RotL32(b, 13) ^ RotL32(b, 23);
    }

    // 派生 32 个轮密钥
    private static int[] KeySchedule(string key, bool forDecrypt) {
        InitTables();
        int[] fk = new int[] { -1548633402, 1453994832, 1736282519, -1301273892 };  // 0xa3b1bac6, 0x56aa3350, 0x677d9197, 0xb27022dc——fk[0] 曾误写 -1548633390（低字节 0xd2≠0xc6），GB/T KAT 暴露

        int[] k = new int[36];
        for (int i = 0; i < 4; i = i + 1) {
            int w = ((key[i * 4] & 255) << 24) | ((key[i * 4 + 1] & 255) << 16) | ((key[i * 4 + 2] & 255) << 8) | (key[i * 4 + 3] & 255);
            k[i] = w ^ fk[i];
        }

        int[] rk = new int[32];
        for (int i = 0; i < 32; i = i + 1) {
            int t = k[i + 1] ^ k[i + 2] ^ k[i + 3] ^ CK[i];
            int nk = k[i] ^ LpTrans(Tau(t));
            k[i + 4] = nk;
            rk[i] = nk;
        }

        if (forDecrypt) {
            int[] rev = new int[32];
            for (int i = 0; i < 32; i = i + 1) {
                rev[i] = rk[31 - i];
            }
            return rev;
        }

        return rk;
    }

    // 单分组 32 轮加解密核心（零堆分配）
    private static void CryptBlock(string in16, int inOff, byte[] out16, int outOff, int[] rk) {
        int x0 = ((in16[inOff + 0] & 255) << 24) | ((in16[inOff + 1] & 255) << 16) | ((in16[inOff + 2] & 255) << 8) | (in16[inOff + 3] & 255);
        int x1 = ((in16[inOff + 4] & 255) << 24) | ((in16[inOff + 5] & 255) << 16) | ((in16[inOff + 6] & 255) << 8) | (in16[inOff + 7] & 255);
        int x2 = ((in16[inOff + 8] & 255) << 24) | ((in16[inOff + 9] & 255) << 16) | ((in16[inOff + 10] & 255) << 8) | (in16[inOff + 11] & 255);
        int x3 = ((in16[inOff + 12] & 255) << 24) | ((in16[inOff + 13] & 255) << 16) | ((in16[inOff + 14] & 255) << 8) | (in16[inOff + 15] & 255);

        for (int i = 0; i < 32; i = i + 1) {
            int t = x1 ^ x2 ^ x3 ^ rk[i];
            int nextX = x0 ^ LTrans(Tau(t));
            x0 = x1;
            x1 = x2;
            x2 = x3;
            x3 = nextX;
        }

        // 输出为反序: x3, x2, x1, x0
        out16[outOff + 0] = (byte)((x3 >> 24) & 255); out16[outOff + 1] = (byte)((x3 >> 16) & 255); out16[outOff + 2] = (byte)((x3 >> 8) & 255); out16[outOff + 3] = (byte)(x3 & 255);
        out16[outOff + 4] = (byte)((x2 >> 24) & 255); out16[outOff + 5] = (byte)((x2 >> 16) & 255); out16[outOff + 6] = (byte)((x2 >> 8) & 255); out16[outOff + 7] = (byte)(x2 & 255);
        out16[outOff + 8] = (byte)((x1 >> 24) & 255); out16[outOff + 9] = (byte)((x1 >> 16) & 255); out16[outOff + 10] = (byte)((x1 >> 8) & 255); out16[outOff + 11] = (byte)(x1 & 255);
        out16[outOff + 12] = (byte)((x0 >> 24) & 255); out16[outOff + 13] = (byte)((x0 >> 16) & 255); out16[outOff + 14] = (byte)((x0 >> 8) & 255); out16[outOff + 15] = (byte)(x0 & 255);
    }

    // 加密单个 16 字节分组。返回新的 16 字节缓冲区。
    public static byte[] EncryptBlock(string key, string in16) {
        if (key == null || in16 == null) { return null; }
        int[] rk = KeySchedule(key, false);
        byte[] o = new byte[16];
        CryptBlock(in16, 0, o, 0, rk);
        return o;
    }

    // 解密单个 16 字节分组。返回新的 16 字节缓冲区。
    public static byte[] DecryptBlock(string key, string in16) {
        if (key == null || in16 == null) { return null; }
        int[] rk = KeySchedule(key, true);
        byte[] o = new byte[16];
        CryptBlock(in16, 0, o, 0, rk);
        return o;
    }

    // 带 PKCS#7 填充的 SM4-CBC 加密。
    public static byte[] EncryptCbc(string key, string iv, string data, int len, List<int> outLen) {
        if (key == null || iv == null || outLen == null) {
            if (outLen != null) { outLen[0] = -1; }
            return null;
        }
        if (len < 0 || (len > 0 && data == null)) {
            outLen[0] = -1;
            return null;
        }

        if (key.Length == 16 && iv.Length >= 16) {
            int pad = 16 - (len % 16);
            int tot = len + pad;
            byte[] outb = new byte[tot];
            long res = NativeMemory.Sm4CbcEncrypt(outb, data, (long)len, key, iv);
            if (res >= 0) {
                outLen[0] = (int)res;
                return outb;
            }
        }

        int[] rk = KeySchedule(key, false);
        int padVal = 16 - (len % 16);
        int total = len + padVal;
        byte[] outb = new byte[total];

        byte[] blk = new byte[16];
        for (int i = 0; i < 16; i = i + 1) { blk[i] = (byte)(iv[i] & 255); }

        int off = 0;
        while (off < total) {
            for (int j = 0; j < 16; j = j + 1) {
                int b;
                if (off + j < len) {
                    b = data[off + j] & 255;
                } else {
                    b = padVal;
                }
                blk[j] = (byte)((blk[j] & 255) ^ b);
            }
            string blkStr = blk;
            CryptBlock(blkStr, 0, outb, off, rk);
            for (int j = 0; j < 16; j = j + 1) {
                blk[j] = outb[off + j];
            }
            off = off + 16;
        }

        outLen[0] = total;
        return outb;
    }

    // SM4-CBC 解密，去除 PKCS#7 填充。常数时间校验填充。
    public static byte[] DecryptCbc(string key, string iv, string data, int len, List<int> outLen) {
        if (key == null || iv == null || outLen == null) {
            if (outLen != null) { outLen[0] = -1; }
            return null;
        }
        if (len <= 0 || (len % 16) != 0 || data == null) {
            outLen[0] = -1;
            return null;
        }

        if (key.Length == 16 && iv.Length >= 16) {
            byte[] outb = new byte[len];
            long res = NativeMemory.Sm4CbcDecrypt(outb, data, (long)len, key, iv);
            if (res >= 0) {
                int plainLen = (int)res;
                outLen[0] = plainLen;
                byte[] resBytes = new byte[plainLen];
                for (int i = 0; i < plainLen; i = i + 1) { resBytes[i] = outb[i]; }
                return resBytes;
            }
            outLen[0] = -1;
            return null;
        }

        int[] rk = KeySchedule(key, true);
        byte[] outb = new byte[len];
        byte[] prev = new byte[16];
        for (int i = 0; i < 16; i = i + 1) { prev[i] = (byte)(iv[i] & 255); }

        byte[] dec = new byte[16];
        int off = 0;
        while (off < len) {
            string decStr = dec;
            CryptBlock(data, off, dec, 0, rk);
            for (int j = 0; j < 16; j = j + 1) {
                outb[off + j] = (byte)((dec[j] & 255) ^ (prev[j] & 255));
                prev[j] = (byte)(data[off + j] & 255);
            }
            off = off + 16;
        }

        // 常数时间校验 PKCS#7 填充
        int padVal = outb[len - 1] & 255;
        int bad = 0;
        if (padVal < 1 || padVal > 16) { bad = 1; }

        for (int i = 0; i < 16; i = i + 1) {
            int idx = len - 1 - i;
            int diff = (outb[idx] & 255) ^ padVal;
            int inPad = 0;
            if (i < padVal) { inPad = 1; }
            if (inPad == 1 && diff != 0) { bad = bad | 1; }
        }

        if (bad != 0) {
            outLen[0] = -1;
            return null;
        }

        int plainLen = len - padVal;
        outLen[0] = plainLen;
        byte[] res = new byte[plainLen];
        for (int i = 0; i < plainLen; i = i + 1) { res[i] = outb[i]; }
        return res;
    }
}
