using System;

namespace System.Security.Cryptography;

/// <summary>GB/T 32907-2016 SM4（中国国家分组密码标准）：128 位分组，128 位密钥，32 轮迭代。
/// 100% 纯 Zan 自举实现，提供单分组 ECB 以及 CBC 模式。
/// 消除所有堆分配，采用原位寄存器轮转与零 C 依赖。</summary>
class Sm4 {
    static int[] Sbox;
    static int[] CK;
    static bool inited = false;

    static int RotL32(int x, int n) {
        return (int)(((uint)x << n) | ((uint)x >> (32 - n)));
    }

    static void InitTables() {
        if (inited) { return; }
        string hex = "d690e9fecce13db716b614c228fb2c05"
                   + "2b679a762abe04c3aa44132649860699"
                   + "9c4250f491ef987a33540b43edcfac62"
                   + "e4b31ca9c908e89580df94fa758f3fa6"
                   + "4707a7fcf37317ba83593c19e6854fa8"
                   + "686b81b27164da8bf8eb0f4b70569d35"
                   + "1e240e5e6358d1a225227c3b01217887"
                   + "d40046579fd327524c3602e7a0c4c89e"
                   + "eabf8ad240c738b5a3f7f2cef96115a1"
                   + "e0ae5da49b341a55ad933230f58cb1e3"
                   + "1df6e22e8266ca60c02923ab0d534e6f"
                   + "d5db3745defd8e2f03ff6a726d6c5b51"
                   + "8d1baf92bbddbc7f11d95c411f105ad8"
                   + "0ac13188a5cd7bbd2d74d012b8e5b4b0"
                   + "8969974a0c96777e65b9f109c56ec684"
                   + "18f07dec3adc4d2079ee5f3ed7cb3948";

        byte[] sbBytes = Hex.Decode(hex);
        Sbox = new int[256];
        for (int i = 0; i < 256; i = i + 1) {
            Sbox[i] = sbBytes[i] & 255;
        }

        CK = new int[32];
        for (int i = 0; i < 32; i = i + 1) {
            int w = 0;
            for (int j = 0; j < 4; j = j + 1) {
                w = (w << 8) | (((4 * i + j) * 7) & 255);
            }
            CK[i] = w;
        }

        inited = true;
    }

    /// 非线性变换 τ：32 位字逐字节过 S 盒
    static int Tau(int a) {
        return ((Sbox[(a >> 24) & 255] << 24) |
                (Sbox[(a >> 16) & 255] << 16) |
                (Sbox[(a >> 8) & 255] << 8) |
                Sbox[a & 255]);
    }

    /// 轮函数线性变换 L：B ^ B<<<2 ^ B<<<10 ^ B<<<18 ^ B<<<24
    static int LTrans(int b) {
        return b ^ RotL32(b, 2) ^ RotL32(b, 10) ^ RotL32(b, 18) ^ RotL32(b, 24);
    }

    /// 密钥扩展线性变换 L'：B ^ B<<<13 ^ B<<<23
    static int LpTrans(int b) {
        return b ^ RotL32(b, 13) ^ RotL32(b, 23);
    }

    /// 派生 32 个轮密钥
    static int[] KeySchedule(string key, bool forDecrypt) {
        InitTables();
        int[] fk = new int[] { -1548633390, 1453994832, 1736282519, -1301273892 };  // 0xa3b1bac6, 0x56aa3350, 0x677d9197, 0xb27022dc

        int[] k = new int[36];
        for (int i = 0; i < 4; i = i + 1) {
            int w = ((key[i * 4] & 255) << 24) | ((key[i * 4 + 1] & 255) << 16) | ((key[i * 4 + 2] & 255) << 8) | (key[i * 4 + 3] & 255);
            k[i] = w ^ fk[i];
        }

        int[] rk = new int[32];
        for (int i = 0; i < 32; i = i + 1) {
            int t = k[i + 1] ^ k[i + 2] ^ k[i + 3] ^ CK[i];
            int nk = k[i] ^ LpTrans(Tau(t));
            k[i + 4] = nk;
            rk[i] = nk;
        }

        if (forDecrypt) {
            int[] rev = new int[32];
            for (int i = 0; i < 32; i = i + 1) {
                rev[i] = rk[31 - i];
            }
            return rev;
        }

        return rk;
    }

    /// 单分组 32 轮加解密核心（零堆分配）
    static void CryptBlock(string in16, int inOff, byte[] out16, int outOff, int[] rk) {
        int x0 = ((in16[inOff + 0] & 255) << 24) | ((in16[inOff + 1] & 255) << 16) | ((in16[inOff + 2] & 255) << 8) | (in16[inOff + 3] & 255);
        int x1 = ((in16[inOff + 4] & 255) << 24) | ((in16[inOff + 5] & 255) << 16) | ((in16[inOff + 6] & 255) << 8) | (in16[inOff + 7] & 255);
        int x2 = ((in16[inOff + 8] & 255) << 24) | ((in16[inOff + 9] & 255) << 16) | ((in16[inOff + 10] & 255) << 8) | (in16[inOff + 11] & 255);
        int x3 = ((in16[inOff + 12] & 255) << 24) | ((in16[inOff + 13] & 255) << 16) | ((in16[inOff + 14] & 255) << 8) | (in16[inOff + 15] & 255);

        for (int i = 0; i < 32; i = i + 1) {
            int t = x1 ^ x2 ^ x3 ^ rk[i];
            int nextX = x0 ^ LTrans(Tau(t));
            x0 = x1;
            x1 = x2;
            x2 = x3;
            x3 = nextX;
        }

        // 输出为反序: x3, x2, x1, x0
        out16[outOff + 0] = (byte)((x3 >> 24) & 255); out16[outOff + 1] = (byte)((x3 >> 16) & 255); out16[outOff + 2] = (byte)((x3 >> 8) & 255); out16[outOff + 3] = (byte)(x3 & 255);
        out16[outOff + 4] = (byte)((x2 >> 24) & 255); out16[outOff + 5] = (byte)((x2 >> 16) & 255); out16[outOff + 6] = (byte)((x2 >> 8) & 255); out16[outOff + 7] = (byte)(x2 & 255);
        out16[outOff + 8] = (byte)((x1 >> 24) & 255); out16[outOff + 9] = (byte)((x1 >> 16) & 255); out16[outOff + 10] = (byte)((x1 >> 8) & 255); out16[outOff + 11] = (byte)(x1 & 255);
        out16[outOff + 12] = (byte)((x0 >> 24) & 255); out16[outOff + 13] = (byte)((x0 >> 16) & 255); out16[outOff + 14] = (byte)((x0 >> 8) & 255); out16[outOff + 15] = (byte)(x0 & 255);
    }

    /// <summary>加密单个 16 字节分组。返回新的 16 字节缓冲区。</summary>
    static byte[] EncryptBlock(string key, string in16) {
        if (key == null || in16 == null) { return null; }
        int[] rk = KeySchedule(key, false);
        byte[] o = new byte[16];
        CryptBlock(in16, 0, o, 0, rk);
        return o;
    }

    /// <summary>解密单个 16 字节分组。返回新的 16 字节缓冲区。</summary>
    static byte[] DecryptBlock(string key, string in16) {
        if (key == null || in16 == null) { return null; }
        int[] rk = KeySchedule(key, true);
        byte[] o = new byte[16];
        CryptBlock(in16, 0, o, 0, rk);
        return o;
    }

    /// <summary>带 PKCS#7 填充的 SM4-CBC 加密。</summary>
    static byte[] EncryptCbc(string key, string iv, string data, int len, List<int> outLen) {
        if (key == null || iv == null || outLen == null) {
            if (outLen != null) { outLen[0] = -1; }
            return null;
        }
        if (len < 0 || (len > 0 && data == null)) {
            outLen[0] = -1;
            return null;
        }

        if (key.Length == 16 && iv.Length >= 16) {
            int pad = 16 - (len % 16);
            int tot = len + pad;
            byte[] outb = new byte[tot];
            long res = NativeMemory.Sm4CbcEncrypt(outb, data, (long)len, key, iv);
            if (res >= 0) {
                outLen[0] = (int)res;
                return outb;
            }
        }

        int[] rk = KeySchedule(key, false);
        int padVal = 16 - (len % 16);
        int total = len + padVal;
        byte[] outb = new byte[total];

        byte[] blk = new byte[16];
        for (int i = 0; i < 16; i = i + 1) { blk[i] = (byte)(iv[i] & 255); }

        int off = 0;
        while (off < total) {
            for (int j = 0; j < 16; j = j + 1) {
                int b;
                if (off + j < len) {
                    b = data[off + j] & 255;
                } else {
                    b = padVal;
                }
                blk[j] = (byte)((blk[j] & 255) ^ b);
            }
            string blkStr = blk;
            CryptBlock(blkStr, 0, outb, off, rk);
            for (int j = 0; j < 16; j = j + 1) {
                blk[j] = outb[off + j];
            }
            off = off + 16;
        }

        outLen[0] = total;
        return outb;
    }

    /// <summary>SM4-CBC 解密，去除 PKCS#7 填充。常数时间校验填充。</summary>
    static byte[] DecryptCbc(string key, string iv, string data, int len, List<int> outLen) {
        if (key == null || iv == null || outLen == null) {
            if (outLen != null) { outLen[0] = -1; }
            return null;
        }
        if (len <= 0 || (len % 16) != 0 || data == null) {
            outLen[0] = -1;
            return null;
        }

        if (key.Length == 16 && iv.Length >= 16) {
            byte[] outb = new byte[len];
            long res = NativeMemory.Sm4CbcDecrypt(outb, data, (long)len, key, iv);
            if (res >= 0) {
                int plainLen = (int)res;
                outLen[0] = plainLen;
                byte[] resBytes = new byte[plainLen];
                for (int i = 0; i < plainLen; i = i + 1) { resBytes[i] = outb[i]; }
                return resBytes;
            }
            outLen[0] = -1;
            return null;
        }

        int[] rk = KeySchedule(key, true);
        byte[] outb = new byte[len];
        byte[] prev = new byte[16];
        for (int i = 0; i < 16; i = i + 1) { prev[i] = (byte)(iv[i] & 255); }

        byte[] dec = new byte[16];
        int off = 0;
        while (off < len) {
            string decStr = dec;
            CryptBlock(data, off, dec, 0, rk);
            for (int j = 0; j < 16; j = j + 1) {
                outb[off + j] = (byte)((dec[j] & 255) ^ (prev[j] & 255));
                prev[j] = (byte)(data[off + j] & 255);
            }
            off = off + 16;
        }

        // 常数时间校验 PKCS#7 填充
        int padVal = outb[len - 1] & 255;
        int bad = 0;
        if (padVal < 1 || padVal > 16) { bad = 1; }

        for (int i = 0; i < 16; i = i + 1) {
            int idx = len - 1 - i;
            int diff = (outb[idx] & 255) ^ padVal;
            int inPad = 0;
            if (i < padVal) { inPad = 1; }
            if (inPad == 1 && diff != 0) { bad = bad | 1; }
        }

        if (bad != 0) {
            outLen[0] = -1;
            return null;
        }

        int plainLen = len - padVal;
        outLen[0] = plainLen;
        byte[] res = new byte[plainLen];
        for (int i = 0; i < plainLen; i = i + 1) { res[i] = outb[i]; }
        return res;
    }
}
