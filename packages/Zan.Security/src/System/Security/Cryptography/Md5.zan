using System;
using System.IO;
using System.Numerics;

namespace System.Security.Cryptography;

// RFC 1321 MD5 哈希算法。
// 100% 纯 Zan 自举实现，消除循环内部堆分配，采用原位分块与小端寄存器轮转。
// 仅供遗留/互操作场景使用；不具有抗碰撞性。
class Md5 {
    static int[] K;
    static int[] S;
    static bool inited = false;

    static void InitTables() {
        if (inited) { return; }
        K = new int[] {
            -680876936, -389564586, 606105819, -1044525330,
            -176418897, 1200080426, -1473231341, -45705983,
            1770035416, -1958414417, -42063, -1990404162,
            1804603682, -40341101, -1502002290, 1236535329,
            -165796510, -1069501632, 643717713, -373897302,
            -701558691, 38016083, -660478335, -405537848,
            568446438, -1019803690, -187363961, 1163531501,
            -1444681467, -51403784, 1735328473, -1926607734,
            -378558, -2022574463, 1839030562, -35309556,
            -1530992060, 1272893353, -155497632, -1094730640,
            681279174, -358537222, -722521979, 76029189,
            -640364487, -421815835, 530742520, -995338651,
            -198630844, 1126891415, -1416354905, -57434055,
            1700485571, -1894986606, -1051523, -2054922799,
            1873313359, -30611744, -1560198380, 1309151649,
            -145523070, -1120210379, 718787259, -343485551
        };

        S = new int[] {
            7, 12, 17, 22, 7, 12, 17, 22,
            7, 12, 17, 22, 7, 12, 17, 22,
            5, 9, 14, 20, 5, 9, 14, 20,
            5, 9, 14, 20, 5, 9, 14, 20,
            4, 11, 16, 23, 4, 11, 16, 23,
            4, 11, 16, 23, 4, 11, 16, 23,
            6, 10, 15, 21, 6, 10, 15, 21,
            6, 10, 15, 21, 6, 10, 15, 21
        };

        inited = true;
    }

    static int RotL32(int x, int n) {
        return (int)(((uint)x << n) | ((uint)x >> (32 - n)));
    }

    // 计算 MD5；返回新分配的 16 字节摘要。
    // MD5 没有任何硬件指令引擎（x86/ARM 均无），纯 Zan 是唯一实现。
    static byte[] Hash(string msg, int len) {
        if (len < 0) { return null; }
        if (len > 0 && msg == null) { return null; }
        InitTables();

        int a0 = 1732584193; int b0 = -271733879; int c0 = -1732584194; int d0 = 271733878;

        int[] M = new int[16];
        int blocks = len / 64;

        for (int bl = 0; bl < blocks; bl = bl + 1) {
            int off = bl * 64;
            for (int t = 0; t < 16; t = t + 1) {
                int j = off + t * 4;
                M[t] = (msg[j] & 255) | ((msg[j + 1] & 255) << 8) | ((msg[j + 2] & 255) << 16) | ((msg[j + 3] & 255) << 24);
            }

            int A = a0; int B = b0; int C = c0; int D = d0;
            for (int t = 0; t < 64; t = t + 1) {
                int F; int g;
                if (t < 16) {
                    F = (B & C) | ((~B) & D);
                    g = t;
                } else if (t < 32) {
                    F = (D & B) | ((~D) & C);
                    g = (5 * t + 1) % 16;
                } else if (t < 48) {
                    F = B ^ C ^ D;
                    g = (3 * t + 5) % 16;
                } else {
                    F = C ^ (B | (~D));
                    g = (7 * t) % 16;
                }

                F = F + A + K[t] + M[g];
                A = D;
                D = C;
                C = B;
                B = B + BitOperations.RotateLeft(F, S[t]);
            }

            a0 = a0 + A;
            b0 = b0 + B;
            c0 = c0 + C;
            d0 = d0 + D;
        }

        // 填充尾块 (Padding)
        int rem = len - blocks * 64;
        byte[] tail = new byte[128];
        for (int i = 0; i < rem; i = i + 1) {
            tail[i] = (byte)(msg[blocks * 64 + i] & 255);
        }
        tail[rem] = 128;
        int tailPadBlocks = 1;
        if (rem >= 56) {
            tailPadBlocks = 2;
        }
        int totalTailBytes = tailPadBlocks * 64;
        long bits = (long)len * 8;
        int bi = totalTailBytes - 8;
        tail[bi + 0] = (byte)(bits & 255);
        tail[bi + 1] = (byte)((bits >> 8) & 255);
        tail[bi + 2] = (byte)((bits >> 16) & 255);
        tail[bi + 3] = (byte)((bits >> 24) & 255);
        tail[bi + 4] = (byte)((bits >> 32) & 255);
        tail[bi + 5] = (byte)((bits >> 40) & 255);
        tail[bi + 6] = (byte)((bits >> 48) & 255);
        tail[bi + 7] = (byte)((bits >> 56) & 255);

        for (int tb = 0; tb < tailPadBlocks; tb = tb + 1) {
            int toff = tb * 64;
            for (int t = 0; t < 16; t = t + 1) {
                int j = toff + t * 4;
                M[t] = (tail[j] & 255) | ((tail[j + 1] & 255) << 8) | ((tail[j + 2] & 255) << 16) | ((tail[j + 3] & 255) << 24);
            }

            int A = a0; int B = b0; int C = c0; int D = d0;
            for (int t = 0; t < 64; t = t + 1) {
                int F; int g;
                if (t < 16) {
                    F = (B & C) | ((~B) & D);
                    g = t;
                } else if (t < 32) {
                    F = (D & B) | ((~D) & C);
                    g = (5 * t + 1) % 16;
                } else if (t < 48) {
                    F = B ^ C ^ D;
                    g = (3 * t + 5) % 16;
                } else {
                    F = C ^ (B | (~D));
                    g = (7 * t) % 16;
                }

                F = F + A + K[t] + M[g];
                A = D;
                D = C;
                C = B;
                B = B + BitOperations.RotateLeft(F, S[t]);
            }

            a0 = a0 + A;
            b0 = b0 + B;
            c0 = c0 + C;
            d0 = d0 + D;
        }

        byte[] o = new byte[16];
        wLE(o, 0, a0); wLE(o, 4, b0); wLE(o, 8, c0); wLE(o, 12, d0);
        return o;
    }

    // 计算 byte[] 数据的 MD5；返回新分配的 16 字节摘要。
    static byte[] Hash(byte[] msg, int len) {
        if (msg == null || len <= 0) {
            string empty = "";
            return Hash(empty, 0);
        }
        string s = msg;
        return Hash(s, len);
    }

    // 计算整个 byte[] 的 MD5；返回新分配的 16 字节摘要。
    static byte[] Hash(byte[] msg) {
        if (msg == null) { return Hash(new byte[0], 0); }
        return Hash(msg, msg.Length);
    }

    // 计算 byte[] 数据的 MD5 并直接返回 32 位小写十六进制字符串。
    static string HashToHex(byte[] msg) {
        byte[] h = Hash(msg);
        return Hex.Encode(h);
    }

    // 计算文件的 MD5 并返回 32 位小写十六进制字符串。若文件不存在抛异常。
    static string HashFile(string path) {
        byte[] data = File.ReadAllBytes(path);
        return HashToHex(data);
    }

    // 按小端序把 32 位字 v 写入 b 偏移 o 处的 4 个字节。
    static void wLE(byte[] b, int o, int v) {
        b[o] = (byte)(v & 255);
        b[o + 1] = (byte)((v >> 8) & 255);
        b[o + 2] = (byte)((v >> 16) & 255);
        b[o + 3] = (byte)((v >> 24) & 255);
    }
}
