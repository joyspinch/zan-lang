using System;
using System.Runtime.Intrinsics;
using System.Runtime.Intrinsics.X86;

namespace System.Security.Cryptography;

/// <summary>
/// CRC-32C（Castagnoli，多项式 0x82F63B78）。
/// 工业级现代标准（ZanDB、RocksDB、Kafka、iSCSI、SCTP）。
/// 当输入为连续内存或字节数组时，优先使用底层 NativeMemory.Crc32C 硬件加速。
/// </summary>
public static class Crc32C {
    static int[] table;

    // 0x82F63B78 反射多项式
    static int Poly = -2097792136;  // (int)0x82F63B78
    static int AllOnes = -1;

    static int[] Table() {
        if (Crc32C.table != null) { return Crc32C.table; }
        int[] t = new int[256];
        for (int i = 0; i < 256; i = i + 1) {
            int c = i;
            for (int k = 0; k < 8; k = k + 1) {
                if ((c & 1) != 0) {
                    c = (int)((uint)c >> 1) ^ Crc32C.Poly;
                } else {
                    c = (int)((uint)c >> 1);
                }
            }
            t[i] = c;
        }
        Crc32C.table = t;
        return t;
    }

    /// <summary>对 byte[] 计算 CRC-32C。若硬件支持 SSE4.2 则自动走单周期硬件加速。</summary>
    public static int Compute(byte[] data, int offset, int len, int crc) {
        if (data == null || len <= 0) return crc;
        /* 跨平台硬件快路径（x86 SSE4.2 / ARMv8 CRC 指令）：运行时内核按
           8/4/2/1 字节块流水整段缓冲。-1 = 无硬件，落回下方路径。 */
        long hw = NativeMemory.Crc32CUpdate((long)(crc ^ Crc32C.AllOnes), data, (long)len);
        if (hw >= 0) {
            return (int)(hw ^ 4294967295);
        }
        if (Cpu.HasSse42) {
            uint c = (uint)(crc ^ Crc32C.AllOnes);
            int i = 0;
            int limit8 = len - 8;
            while (i <= limit8) {
                int baseIdx = offset + i;
                long w = ((long)data[baseIdx] & 255) |
                         (((long)data[baseIdx + 1] & 255) << 8) |
                         (((long)data[baseIdx + 2] & 255) << 16) |
                         (((long)data[baseIdx + 3] & 255) << 24) |
                         (((long)data[baseIdx + 4] & 255) << 32) |
                         (((long)data[baseIdx + 5] & 255) << 40) |
                         (((long)data[baseIdx + 6] & 255) << 48) |
                         (((long)data[baseIdx + 7] & 255) << 56);
                c = (uint)Sse42.Crc32((ulong)c, (ulong)w);
                i += 8;
            }
            while (i < len) {
                c = Sse42.Crc32(c, data[offset + i]);
                i++;
            }
            return (int)(c ^ (uint)Crc32C.AllOnes);
        }

        int[] t = Crc32C.Table();
        int sc = crc ^ Crc32C.AllOnes;
        for (int i = 0; i < len; i = i + 1) {
            sc = (int)((uint)sc >> 8) ^ t[(sc ^ data[offset + i]) & 255];
        }
        return sc ^ Crc32C.AllOnes;
    }

    /// <summary>对整个 byte[] 计算 CRC-32C。</summary>
    public static int Compute(byte[] data) {
        if (data == null || data.Length == 0) return 0;
        return Crc32C.Compute(data, 0, data.Length, 0);
    }
}
