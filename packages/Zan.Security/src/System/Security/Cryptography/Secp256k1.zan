using System;
using System.Interop;

namespace System.Security.Cryptography;

// SECG secp256k1 椭圆曲线密码学实现（Koblitz 曲线 SEC 2 标准，比特币与以太坊基石）。
// 曲线方程：y^2 = x^3 + 7 (mod p)，a = 0, b = 7。
// 内部域与点运算委托 EcField256（8x32-bit 定长 Limb + 伪梅森快速约简 + 4-bit 2-Comb G 表 + Shamir 双标量乘）。
public class Secp256k1 {

    static string PHEX  = "FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEFFFFFC2F";
    static string NHEX  = "FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141";

    static BigInt P;
    static BigInt N;
    static BigInt HALF_N;
    static bool ready = false;

    private static BigInt hb(string h) {
        return BigInt.FromBytesBE(Hex.Decode(h), 32);
    }

    private static void init() {
        if (ready) { return; }
        P = hb(PHEX);
        N = hb(NHEX);
        // HALF_N = N / 2 (用于 EIP-2 低 s 防延展性归约)
        HALF_N = hb("7FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF5D576E7357A4501DDFE92F46681B20A0");
        EcField256.GetCurve(EcField256.CurveSecp256k1);
        ready = true;
    }

    // 模 N 标量运算
    private static BigInt nmod(BigInt x) { return BigInt.mod(x, N); }
    private static BigInt nmul(BigInt x, BigInt y) { return BigInt.mod(BigInt.mul(x, y), N); }
    private static BigInt ninv(BigInt x) { return BigInt.ModInverse(x, N); }

    // 从 32 字节大端私钥派生 64 字节未压缩公钥坐标 (X || Y)，不带 0x04 前缀。
    public static byte[] GetPublicKeyRaw(byte[] privKey32) {
        init();
        if (privKey32 == null || privKey32.Length != 32) { return null; }
        long[] d = new long[8];
        EcField256.FromBytesBE(privKey32, 0, d);
        EcCurveData cd = EcField256.GetCurve(EcField256.CurveSecp256k1);
        if (EcField256.IsZero(d) || EcField256.Cmp(d, cd.N) >= 0) { return null; }

        long[] ox = new long[8];
        long[] oy = new long[8];
        if (!EcField256.ScalarMulG(EcField256.CurveSecp256k1, d, ox, oy)) { return null; }

        byte[] outb = new byte[64];
        EcField256.ToBytesBE(ox, outb, 0);
        EcField256.ToBytesBE(oy, outb, 32);
        return outb;
    }

    // 派生 65 字节完整未压缩公钥（带 0x04 头部）
    public static byte[] GetPublicKeyUncompressed(byte[] privKey32) {
        byte[] raw = GetPublicKeyRaw(privKey32);
        if (raw == null) { return null; }
        byte[] outb = new byte[65];
        outb[0] = 4;
        NativeMemory.Copy((nint)outb + 1, (nint)raw, 64);
        return outb;
    }

    // 校验公钥点是否合法地落在 secp256k1 曲线上
    public static bool VerifyPublicKey(byte[] raw64) {
        init();
        if (raw64 == null || raw64.Length != 64) { return false; }
        long[] x = new long[8];
        long[] y = new long[8];
        EcField256.FromBytesBE(raw64, 0, x);
        EcField256.FromBytesBE(raw64, 32, y);
        return EcField256.IsOnCurve(EcField256.CurveSecp256k1, x, y);
    }

    private static byte[] hmac256(byte[] key, byte[] p1, byte[] p2, byte[] p3, byte[] p4) {
        int l1 = p1.Length;
        int l2 = p2 == null ? 0 : p2.Length;
        int l3 = p3 == null ? 0 : p3.Length;
        int l4 = p4 == null ? 0 : p4.Length;
        int total = l1 + l2 + l3 + l4;
        byte[] msg = new byte[total];
        int pos = 0;
        if (l1 > 0) { NativeMemory.Copy((nint)msg + pos, (nint)p1, l1); pos = pos + l1; }
        if (l2 > 0) { NativeMemory.Copy((nint)msg + pos, (nint)p2, l2); pos = pos + l2; }
        if (l3 > 0) { NativeMemory.Copy((nint)msg + pos, (nint)p3, l3); pos = pos + l3; }
        if (l4 > 0) { NativeMemory.Copy((nint)msg + pos, (nint)p4, l4); }
        return Hmac.Compute(Hmac.SHA256, key.ToStr(0, key.Length), key.Length, msg.ToStr(0, total), total);
    }

    // RFC 6979 确定性生成针对 32 字节消息哈希的 ECDSA 签名，并强制应用低 s 防延展规范。
    public static Secp256k1Signature Sign(byte[] hash32, byte[] privKey32) {
        init();
        if (hash32 == null || hash32.Length != 32 || privKey32 == null || privKey32.Length != 32) {
            return null;
        }
        EcCurveData cd = EcField256.GetCurve(EcField256.CurveSecp256k1);
        long[] dl = new long[8];
        EcField256.FromBytesBE(privKey32, 0, dl);
        if (EcField256.IsZero(dl) || EcField256.Cmp(dl, cd.N) >= 0) {
            return null;
        }
        BigInt d = BigInt.FromBytesBE(privKey32, 32);

        BigInt e = nmod(BigInt.FromBytesBE(hash32, 32));
        byte[] em = e.ToBytesBE(32);

        byte[] v = new byte[32];
        byte[] k = new byte[32];
        for (int i = 0; i < 32; i = i + 1) { v[i] = 1; k[i] = 0; }

        byte[] zero = new byte[1];
        byte[] oneb = new byte[1]; oneb[0] = 1;

        k = hmac256(k, v, zero, privKey32, em);
        byte[] t = hmac256(k, v, null, null, null);
        NativeMemory.Copy((nint)v, (nint)t, 32);

        k = hmac256(k, v, oneb, privKey32, em);
        t = hmac256(k, v, null, null, null);
        NativeMemory.Copy((nint)v, (nint)t, 32);

        long[] kl = new long[8];
        long[] rx = new long[8];
        long[] ry = new long[8];

        while (true) {
            t = hmac256(k, v, null, null, null);
            NativeMemory.Copy((nint)v, (nint)t, 32);
            EcField256.FromBytesBE(v, 0, kl);

            if (!EcField256.IsZero(kl) && EcField256.Cmp(kl, cd.N) < 0) {
                if (EcField256.ScalarMulG(EcField256.CurveSecp256k1, kl, rx, ry)) {
                    BigInt r = nmod(EcField256.ToBigInt(rx));
                    if (!r.isZero()) {
                        BigInt kb = BigInt.FromBytesBE(v, 32);
                        // s = k^-1 * (e + r * d) mod n
                        BigInt s = nmul(ninv(kb), nmod(BigInt.add(e, nmul(r, d))));
                        if (!s.isZero()) {
                            // 基础恢复位 v: 取点 R 的 y 坐标奇偶性 (0 为偶, 1 为奇)
                            int recId = (int)(ry[0] & 1L);

                            // 低 s 防延展规范: 如果 s > n/2，则将 s 翻转为 n - s，并反转恢复奇偶性
                            if (BigInt.cmp(s, HALF_N) > 0) {
                                s = BigInt.sub(N, s);
                                recId = 1 - recId;
                            }

                            return new Secp256k1Signature(r.ToBytesBE(32), s.ToBytesBE(32), recId);
                        }
                    }
                }
            }

            k = hmac256(k, v, zero, null, null);
            t = hmac256(k, v, null, null, null);
            NativeMemory.Copy((nint)v, (nint)t, 32);
        }
    }

    // 从 32 字节哈希和签名 (r, s, v) 中恢复未压缩公钥原始坐标 (64 字节)
    public static byte[] RecoverPublicKey(byte[] hash32, Secp256k1Signature sig) {
        init();
        if (hash32 == null || hash32.Length != 32 || sig == null) { return null; }
        if (sig.V < 0 || sig.V > 3) { return null; }

        EcCurveData cd = EcField256.GetCurve(EcField256.CurveSecp256k1);
        long[] xl = new long[8];
        long[] sl = new long[8];
        EcField256.FromBytesBE(sig.R, 0, xl);
        EcField256.FromBytesBE(sig.S, 0, sl);
        if (EcField256.IsZero(xl) || EcField256.Cmp(xl, cd.N) >= 0) { return null; }
        if (EcField256.IsZero(sl) || EcField256.Cmp(sl, cd.N) >= 0) { return null; }
        if (EcField256.Cmp(xl, cd.P) >= 0) { return null; }

        // 2. 求解 y^2 = x^3 + 7 (mod p) 的平方根: y = (x^3 + 7)^((p+1)/4) mod p
        long[] p = cd.P;
        long[] prod = new long[16];
        long[] tmp = new long[8];
        long[] rhs = new long[8];
        long[] yl = new long[8];
        long[] seven = new long[8]; seven[0] = 7L;

        EcField256.FeSqr(0, p, tmp, xl, prod);
        EcField256.FeMul(0, p, rhs, tmp, xl, prod);
        EcField256.FeAdd(rhs, rhs, seven, p);
        EcField256.SecpSqrt(yl, rhs);

        // 验证平方根有效性
        EcField256.FeSqr(0, p, tmp, yl, prod);
        if (EcField256.Cmp(tmp, rhs) != 0) {
            return null;
        }

        // 3. 根据 v (低位奇偶性) 匹配 y 的正负
        int isOdd = (int)(yl[0] & 1L);
        int targetOdd = sig.V & 1;
        if (isOdd != targetOdd && !EcField256.IsZero(yl)) {
            EcField256.FeSub(yl, p, yl, p);
        }

        // 4. 计算 Q = r^-1 * (s * R - e * G) = u1 * G + u2 * R（Shamir 联合双标量乘）
        BigInt r = BigInt.FromBytesBE(sig.R, 32);
        BigInt s = BigInt.FromBytesBE(sig.S, 32);
        BigInt e = nmod(BigInt.FromBytesBE(hash32, 32));
        BigInt rInv = ninv(r);
        BigInt u1 = nmod(BigInt.sub(N, nmul(e, rInv)));
        BigInt u2 = nmul(s, rInv);

        long[] u1l = new long[8];
        long[] u2l = new long[8];
        EcField256.FromBigInt(u1, u1l);
        EcField256.FromBigInt(u2, u2l);

        long[] qx = new long[8];
        long[] qy = new long[8];
        if (!EcField256.ShamirMul(EcField256.CurveSecp256k1, u1l, u2l, xl, yl, qx, qy)) {
            return null;
        }

        byte[] pub = new byte[64];
        EcField256.ToBytesBE(qx, pub, 0);
        EcField256.ToBytesBE(qy, pub, 32);
        return pub;
    }
}
