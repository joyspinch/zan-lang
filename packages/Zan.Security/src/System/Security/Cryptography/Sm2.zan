using System;
using System.Interop;

namespace System.Security.Cryptography;

// SM2 公钥密码（GB/T 32918 / GM/T 0003），基于标准 256 位素数曲线。
// 内部域与点运算委托 EcField256（8x32-bit 定长 Limb + SM2 Solinas 快速约简 +
// 4-bit 2-Comb G 表 + 4-bit 窗口 / Shamir 双标量乘）。提供密钥派生（d*G）、
// SM2 数字签名（用 ZA 用户哈希签名/验签）以及 C1C3C2 形式的 SM2 公钥加密。
// 安全注意：Sign 的秘密数 k 必须不可预测——生产调用方应传 zero() 让内部以 CSPRNG 选取。
public class Sm2 {

    static string NHEX = "FFFFFFFEFFFFFFFFFFFFFFFFFFFFFFFF7203DF6B21C6052B53BBF40939D54123";

    static BigInt N;
    static bool ready = false;

    private static BigInt hb(string h) { return BigInt.FromBytesBE(Hex.Decode(h), h.Length / 2); }

    private static void init() {
        if (ready) { return; }
        N = hb(NHEX);
        EcField256.GetCurve(EcField256.CurveSm2);
        ready = true;
    }

    // 标量运算，模 N
    private static BigInt nmod(BigInt x) { return BigInt.mod(x, N); }
    private static BigInt nsub(BigInt x, BigInt y) { return BigInt.mod(BigInt.add(x, BigInt.sub(N, BigInt.mod(y, N))), N); }
    private static BigInt nmul(BigInt x, BigInt y) { return BigInt.mod(BigInt.mul(x, y), N); }
    private static BigInt ninv(BigInt x) { return BigInt.ModInverse(x, N); }

    // 构造仿射点列表 [x, y, z]（保持与既有返回格式兼容）
    private static List<BigInt> pt(BigInt x, BigInt y, BigInt z) {
        List<BigInt> r = new List<BigInt>();
        r.Add(x); r.Add(y); r.Add(z);
        return r;
    }

    private static void scalarToLimbs(BigInt k, long[] dst) {
        BigInt kr = BigInt.cmp(k, N) >= 0 ? nmod(k) : k;
        EcField256.FromBigInt(kr, dst);
    }

    // 从私钥标量派生公钥点（d*G）。
    // 返回仿射坐标 [x, y, 1]，各 32 字节 BigInt。
    public static List<BigInt> PublicKey(BigInt d) {
        init();
        long[] dl = new long[8];
        scalarToLimbs(d, dl);
        long[] ox = new long[8];
        long[] oy = new long[8];
        if (!EcField256.ScalarMulG(EcField256.CurveSm2, dl, ox, oy)) {
            return pt(BigInt.zero(), BigInt.zero(), BigInt.zero());
        }
        return pt(EcField256.ToBigInt(ox), EcField256.ToBigInt(oy), BigInt.one());
    }

    // 把 v 的大端 32 字节写入 dst 的 off 处（Zan string 按字节写入）。
    private static void writeBE32(string dst, int off, BigInt v) {
        byte[] b = v.ToBytesBE(32);
        NativeMemory.Copy((nint)dst + off, (nint)b, 32);
    }

    // SM2 签名。e 为 ZA||M 摘要；k 为每次签名使用的秘密数，
    // 取值 [1, n-1]。将 r 写入 outSig[0..31]，s 写入 outSig[32..63]。
    public static void Sign(BigInt e, BigInt d, BigInt k, string outSig) {
        init();
        if (k.isZero()) {
            byte[] rb = RandomNumberGenerator.GetBytes(32);
            if (rb == null) {
                writeBE32(outSig, 0, BigInt.zero());
                writeBE32(outSig, 32, BigInt.zero());
                return;
            }
            k = BigInt.add(BigInt.mod(BigInt.FromBytesBE(rb, 32),
                                      BigInt.sub(N, BigInt.one())), BigInt.one());
        }
        BigInt inv1d = ninv(nmod(BigInt.add(BigInt.one(), d)));
        long[] kl = new long[8];
        long[] px = new long[8];
        long[] py = new long[8];
        int tries = 0;
        while (tries < 100) {
            scalarToLimbs(k, kl);
            if (EcField256.ScalarMulG(EcField256.CurveSm2, kl, px, py)) {
                BigInt r = nmod(BigInt.add(e, EcField256.ToBigInt(px)));
                BigInt s = nmul(inv1d, nsub(k, nmul(r, d)));
                if (!(r.isZero()) && !(s.isZero())) {
                    writeBE32(outSig, 0, r);
                    writeBE32(outSig, 32, s);
                    return;
                }
            }
            k = nmod(BigInt.add(k, BigInt.one()));
            if (k.isZero()) { k = BigInt.one(); }
            tries = tries + 1;
        }
        writeBE32(outSig, 0, BigInt.zero());
        writeBE32(outSig, 32, BigInt.zero());
    }

    // 用公钥 (px,py) 校验摘要 e 上的 SM2 签名 (r,s)。有效时返回 true。
    public static bool Verify(BigInt e, BigInt px, BigInt py, BigInt r, BigInt s) {
        init();
        if (BigInt.cmp(r, BigInt.one()) < 0 || BigInt.cmp(r, N) >= 0) { return false; }
        if (BigInt.cmp(s, BigInt.one()) < 0 || BigInt.cmp(s, N) >= 0) { return false; }
        BigInt t = nmod(BigInt.add(r, s));
        if (t.isZero()) { return false; }

        EcCurveData cd = EcField256.GetCurve(EcField256.CurveSm2);
        long[] qx = new long[8];
        long[] qy = new long[8];
        EcField256.FromBigInt(px, qx);
        EcField256.FromBigInt(py, qy);
        if (EcField256.Cmp(qx, cd.P) >= 0 || EcField256.Cmp(qy, cd.P) >= 0) { return false; }

        long[] sl = new long[8];
        long[] tl = new long[8];
        EcField256.FromBigInt(s, sl);
        EcField256.FromBigInt(t, tl);

        long[] ax = new long[8];
        long[] ay = new long[8];
        if (!EcField256.ShamirMul(EcField256.CurveSm2, sl, tl, qx, qy, ax, ay)) { return false; }

        BigInt R = nmod(BigInt.add(e, EcField256.ToBigInt(ax)));
        return BigInt.cmp(R, r) == 0;
    }

    // GB/T 32918.4 中的 KDF（复用单块输入缓冲，避免每 32 字节重复分配与拷贝 z）
    private static byte[] kdf(string z, int zLen, int klen) {
        byte[] outb = new byte[klen];
        if (klen <= 0) { return outb; }
        byte[] buf = new byte[zLen + 4];
        if (zLen > 0) { NativeMemory.Copy((nint)buf, (nint)z, zLen); }
        int ct = 1; int pos = 0;
        while (pos < klen) {
            buf[zLen] = (byte)((ct >> 24) & 255); buf[zLen + 1] = (byte)((ct >> 16) & 255);
            buf[zLen + 2] = (byte)((ct >> 8) & 255); buf[zLen + 3] = (byte)(ct & 255);
            byte[] h = Sm3.Hash(buf, zLen + 4);
            int take = klen - pos;
            if (take > 32) { take = 32; }
            NativeMemory.Copy((nint)outb + (nint)pos, (nint)h, take);
            pos = pos + take;
            ct = ct + 1;
        }
        return outb;
    }

    // SM2 公钥加密（C1C3C2，C1 带 0x04 前缀）。
    // k 为每条消息的秘密数。outLen[0] 接收密文长度。
    public static byte[] Encrypt(string msg, int msgLen, BigInt px, BigInt py, BigInt k, List<int> outLen) {
        init();
        long[] kl = new long[8];
        scalarToLimbs(k, kl);

        long[] c1x = new long[8]; long[] c1y = new long[8];
        EcField256.ScalarMulG(EcField256.CurveSm2, kl, c1x, c1y);

        long[] qx = new long[8]; long[] qy = new long[8];
        EcField256.FromBigInt(px, qx);
        EcField256.FromBigInt(py, qy);

        long[] kpx = new long[8]; long[] kpy = new long[8];
        EcField256.ScalarMulAffine(EcField256.CurveSm2, kl, qx, qy, kpx, kpy);

        byte[] z = new byte[64];
        EcField256.ToBytesBE(kpx, z, 0);
        EcField256.ToBytesBE(kpy, z, 32);
        byte[] t = kdf(z, 64, msgLen);

        int total = 1 + 64 + 32 + msgLen;
        byte[] outb = new byte[total];
        outb[0] = 4;
        EcField256.ToBytesBE(c1x, outb, 1);
        EcField256.ToBytesBE(c1y, outb, 33);

        // C3 = SM3(x2 || M || y2)
        byte[] c3in = new byte[64 + msgLen];
        EcField256.ToBytesBE(kpx, c3in, 0);
        if (msgLen > 0) { NativeMemory.Copy((nint)c3in + 32, (nint)msg, msgLen); }
        EcField256.ToBytesBE(kpy, c3in, 32 + msgLen);
        byte[] c3 = Sm3.Hash(c3in, 64 + msgLen);
        NativeMemory.Copy((nint)outb + 65, (nint)c3, 32);

        // C2 = M xor t
        for (int i = 0; i < msgLen; i = i + 1) {
            outb[97 + i] = (byte)((msg[i] & 255) ^ (t[i] & 255));
        }
        outLen[0] = total;
        return outb;
    }

    // 对 C1C3C2 密文（C1 带 0x04 前缀）进行 SM2 解密。严格校验 C1 落在曲线上、
    // KDF 输出非全零与 C3 摘要匹配；校验失败时清零明文缓冲、置 outLen[0] = -1 并返回 null。
    public static byte[] Decrypt(string cph, int cphLen, BigInt d, List<int> outLen) {
        init();
        if (outLen == null || outLen.Count == 0) { return null; }
        if (cph == null || cphLen <= 97 || cphLen > cph.Length || (cph[0] & 255) != 4) {
            outLen[0] = -1;
            return null;
        }
        int msgLen = cphLen - 97;
        long[] x1 = new long[8];
        long[] y1 = new long[8];
        EcField256.FromStringBE(cph, 1, x1);
        EcField256.FromStringBE(cph, 33, y1);

        // GB/T 32918.4 步骤 B1：验证 C1 ∈ E(Fp)（y1² ≡ x1³ + A*x1 + B (mod P)），防无效曲线攻击
        if (!EcField256.IsOnCurve(EcField256.CurveSm2, x1, y1)) {
            outLen[0] = -1;
            return null;
        }

        long[] dl = new long[8];
        scalarToLimbs(d, dl);
        long[] kpx = new long[8];
        long[] kpy = new long[8];
        if (!EcField256.ScalarMulAffine(EcField256.CurveSm2, dl, x1, y1, kpx, kpy)) {
            outLen[0] = -1;
            return null;
        }

        byte[] z = new byte[64];
        EcField256.ToBytesBE(kpx, z, 0);
        EcField256.ToBytesBE(kpy, z, 32);
        byte[] t = kdf(z, 64, msgLen);

        int tNonZero = 0;
        byte[] m = new byte[msgLen];
        for (int i = 0; i < msgLen; i = i + 1) {
            int tb = t[i] & 255;
            tNonZero = tNonZero | tb;
            m[i] = (byte)((cph[97 + i] & 255) ^ tb);
        }
        if (tNonZero == 0) {
            NativeMemory.Fill((nint)m, 0, msgLen);
            outLen[0] = -1;
            return null;
        }

        // 校验 C3
        byte[] c3in = new byte[64 + msgLen];
        EcField256.ToBytesBE(kpx, c3in, 0);
        if (msgLen > 0) { NativeMemory.Copy((nint)c3in + 32, (nint)m, msgLen); }
        EcField256.ToBytesBE(kpy, c3in, 32 + msgLen);
        byte[] c3 = Sm3.Hash(c3in, 64 + msgLen);
        int diff = 0;
        for (int i = 0; i < 32; i = i + 1) {
            diff = diff | ((c3[i] & 255) ^ (cph[65 + i] & 255));
        }
        if (diff != 0) {
            NativeMemory.Fill((nint)m, 0, msgLen);
            outLen[0] = -1;
            return null;
        }
        outLen[0] = msgLen;
        return m;
    }
}
