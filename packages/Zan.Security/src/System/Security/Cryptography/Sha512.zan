using System;
using System.Numerics;

namespace System.Security.Cryptography;

// 纯 Zan 实现的 SHA-512（FIPS 180-4）。使用原生 long[] + 硬件 BitOperations.RotateRight
// 内建指令，零热点循环 List 装箱与辅助函数开销。
public class Sha512 {

    static string KHEX = "";
    static string HHEX = "6a09e667f3bcc908bb67ae8584caa73b3c6ef372fe94f82ba54ff53a5f1d36f1510e527fade682d19b05688c2b3e6c1f1f83d9abfb41bd6b5be0cd19137e2179";

    static long[] K;
    static long[] H0;
    static bool ready = false;

    // 把十六进制串中第 idx 个 64 位字（16 个 hex 字符）解析为 long。
    // 对外可见：SHA-384 共用本压缩函数，仅初始值与输出长度不同。
    internal static long Word64(string h, int idx) {
        long v = 0; int bo = idx * 16;
        for (int i = 0; i < 16; i = i + 1) {
            int c = h[bo + i] & 255;
            int d = (c >= 48 && c <= 57) ? (c - 48) : (c - 87);
            v = (v << 4) | (long)d;
        }
        return v;
    }

    // 惰性装载 80 个轮常量 K 与初始哈希 H0（幂等）。
    private static void init() {
        if (ready) { return; }
        long[] ka = new long[80];
        for (int i = 0; i < 80; i = i + 1) { ka[i] = Word64(KHEX, i); }
        long[] ha = new long[8];
        for (int i = 0; i < 8; i = i + 1) { ha[i] = Word64(HHEX, i); }
        K = ka;
        H0 = ha;
        ready = true;
    }

    // 对 msg 的前 len 字节计算 64 字节 SHA-512 摘要。
    public static byte[] Hash(string msg, int len) {
        if (len < 0 || (len > 0 && msg == null)) { return null; }
        nint src = (len > 0 && msg != null) ? (nint)msg : (nint)"";
        byte[] hw = NativeMemory.Sha512Bytes(src, (long)len);
        if (hw != null) {
            return hw;
        }
        init();
        return HashCore(msg, len, H0);
    }

    private static void CompressBlock(long[] st, long[] w, long[] kArr) {
        for (int t = 16; t < 80; t = t + 1) {
            long w15 = w[t - 15];
            long sv0 = BitOperations.RotateRight(w15, 1) ^ BitOperations.RotateRight(w15, 8) ^ (long)((ulong)w15 >> 7);
            long w2 = w[t - 2];
            long sv1 = BitOperations.RotateRight(w2, 19) ^ BitOperations.RotateRight(w2, 61) ^ (long)((ulong)w2 >> 6);
            w[t] = w[t - 16] + sv0 + w[t - 7] + sv1;
        }
        long a = st[0]; long b = st[1]; long c = st[2]; long d = st[3];
        long e = st[4]; long f = st[5]; long g = st[6]; long hh = st[7];
        for (int t = 0; t < 80; t = t + 1) {
            long s1 = BitOperations.RotateRight(e, 14) ^ BitOperations.RotateRight(e, 18) ^ BitOperations.RotateRight(e, 41);
            long ch = (e & f) ^ ((~e) & g);
            long t1 = hh + s1 + ch + kArr[t] + w[t];
            long s0 = BitOperations.RotateRight(a, 28) ^ BitOperations.RotateRight(a, 34) ^ BitOperations.RotateRight(a, 39);
            long maj = (a & b) ^ (a & c) ^ (b & c);
            long t2 = s0 + maj;
            hh = g; g = f; f = e; e = d + t1;
            d = c; c = b; b = a; a = t1 + t2;
        }
        st[0] = st[0] + a; st[1] = st[1] + b; st[2] = st[2] + c; st[3] = st[3] + d;
        st[4] = st[4] + e; st[5] = st[5] + f; st[6] = st[6] + g; st[7] = st[7] + hh;
    }

    private static void LoadBlockBytes(byte[] src, int baseOff, long[] w) {
        for (int t = 0; t < 16; t = t + 1) {
            int off = baseOff + (t << 3);
            w[t] = ((long)(src[off] & 255) << 56)
                 | ((long)(src[off + 1] & 255) << 48)
                 | ((long)(src[off + 2] & 255) << 40)
                 | ((long)(src[off + 3] & 255) << 32)
                 | ((long)(src[off + 4] & 255) << 24)
                 | ((long)(src[off + 5] & 255) << 16)
                 | ((long)(src[off + 6] & 255) << 8)
                 | (long)(src[off + 7] & 255);
        }
    }

    // 纯 Zan 流式压缩路径（字节数组版，零整消息拷贝）：以给定初始哈希值计算 64 字节 SHA-512 状态。
    internal static byte[] HashCoreBytes(byte[] data, int len, long[] h0) {
        if (len < 0 || (len > 0 && data == null) || h0 == null || h0.Length < 8) { return null; }
        init();
        long[] kArr = K;
        long[] st = new long[8];
        for (int i = 0; i < 8; i = i + 1) { st[i] = h0[i]; }
        long[] w = new long[80];
        int off = 0;
        while (off + 128 <= len) {
            LoadBlockBytes(data, off, w);
            CompressBlock(st, w, kArr);
            off = off + 128;
        }
        int rem = len - off;
        int tailBlocks = rem + 17 <= 128 ? 1 : 2;
        int tailLen = tailBlocks * 128;
        byte[] tail = new byte[tailLen];
        if (rem > 0) {
            NativeMemory.Copy((nint)tail, (nint)data + off, rem);
        }
        tail[rem] = 0x80;
        long bitLen = (long)len * 8L;
        WriteBE64(tail, tailLen - 8, bitLen);
        LoadBlockBytes(tail, 0, w);
        CompressBlock(st, w, kArr);
        if (tailBlocks == 2) {
            LoadBlockBytes(tail, 128, w);
            CompressBlock(st, w, kArr);
        }
        byte[] outb = new byte[64];
        WriteBE64(outb, 0, st[0]);  WriteBE64(outb, 8, st[1]);
        WriteBE64(outb, 16, st[2]); WriteBE64(outb, 24, st[3]);
        WriteBE64(outb, 32, st[4]); WriteBE64(outb, 40, st[5]);
        WriteBE64(outb, 48, st[6]); WriteBE64(outb, 56, st[7]);
        return outb;
    }

    // 纯 Zan 流式压缩路径（字符串版，零整消息拷贝）：
    // SHA-384 复用同一压缩函数（初始值不同，输出截取前 48 字节）。
    internal static byte[] HashCore(string msg, int len, long[] h0) {
        if (len < 0 || (len > 0 && msg == null) || h0 == null || h0.Length < 8) { return null; }
        init();
        long[] kArr = K;
        long[] st = new long[8];
        for (int i = 0; i < 8; i = i + 1) { st[i] = h0[i]; }
        long[] w = new long[80];
        int off = 0;
        while (off + 128 <= len) {
            for (int t = 0; t < 16; t = t + 1) {
                int p = off + (t << 3);
                w[t] = ((long)(msg[p] & 255) << 56)
                     | ((long)(msg[p + 1] & 255) << 48)
                     | ((long)(msg[p + 2] & 255) << 40)
                     | ((long)(msg[p + 3] & 255) << 32)
                     | ((long)(msg[p + 4] & 255) << 24)
                     | ((long)(msg[p + 5] & 255) << 16)
                     | ((long)(msg[p + 6] & 255) << 8)
                     | (long)(msg[p + 7] & 255);
            }
            CompressBlock(st, w, kArr);
            off = off + 128;
        }
        int rem = len - off;
        int tailBlocks = rem + 17 <= 128 ? 1 : 2;
        int tailLen = tailBlocks * 128;
        byte[] tail = new byte[tailLen];
        for (int i = 0; i < rem; i = i + 1) {
            tail[i] = (byte)(msg[off + i] & 255);
        }
        tail[rem] = 0x80;
        long bitLen = (long)len * 8L;
        WriteBE64(tail, tailLen - 8, bitLen);
        LoadBlockBytes(tail, 0, w);
        CompressBlock(st, w, kArr);
        if (tailBlocks == 2) {
            LoadBlockBytes(tail, 128, w);
            CompressBlock(st, w, kArr);
        }
        byte[] outb = new byte[64];
        WriteBE64(outb, 0, st[0]);  WriteBE64(outb, 8, st[1]);
        WriteBE64(outb, 16, st[2]); WriteBE64(outb, 24, st[3]);
        WriteBE64(outb, 32, st[4]); WriteBE64(outb, 40, st[5]);
        WriteBE64(outb, 48, st[6]); WriteBE64(outb, 56, st[7]);
        return outb;
    }

    private static void WriteBE64(byte[] b, int o, long v) {
        b[o]     = (byte)((v >> 56) & 255);
        b[o + 1] = (byte)((v >> 48) & 255);
        b[o + 2] = (byte)((v >> 40) & 255);
        b[o + 3] = (byte)((v >> 32) & 255);
        b[o + 4] = (byte)((v >> 24) & 255);
        b[o + 5] = (byte)((v >> 16) & 255);
        b[o + 6] = (byte)((v >> 8) & 255);
        b[o + 7] = (byte)(v & 255);
    }

    public static byte[] Hash(byte[] msg, int len) {
        if (msg == null || len <= 0) {
            return Hash("", 0);
        }
        if (len > msg.Length) { len = msg.Length; }
        byte[] hw = NativeMemory.Sha512Bytes((nint)msg, (long)len);
        if (hw != null) {
            return hw;
        }
        init();
        return HashCoreBytes(msg, len, H0);
    }

    public static byte[] Hash(byte[] msg) {
        if (msg == null) { return Hash(new byte[0], 0); }
        return Hash(msg, msg.Length);
    }

    public static byte[] Hash(string msg) {
        if (msg == null) { return Hash("", 0); }
        return Hash(msg, msg.Length);
    }
}
