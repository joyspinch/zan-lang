using System;
using System.Numerics;

namespace System.Security.Cryptography;

// 纯 Zan 实现的 SHA-512（FIPS 180-4）。使用原生 long[] + 硬件 BitOperations.RotateRight
// 内建指令，零热点循环 List 装箱与辅助函数开销。
public class Sha512 {

    static string KHEX = "";
    static string HHEX = "6a09e667f3bcc908bb67ae8584caa73b3c6ef372fe94f82ba54ff53a5f1d36f1510e527fade682d19b05688c2b3e6c1f1f83d9abfb41bd6b5be0cd19137e2179";

    static long[] K;
    static long[] H0;
    static bool ready = false;

    // 把十六进制串中第 idx 个 64 位字（16 个 hex 字符）解析为 long。
    // 对外可见：SHA-384 共用本压缩函数，仅初始值与输出长度不同。
    internal static long Word64(string h, int idx) {
        long v = 0; int bo = idx * 16;
        for (int i = 0; i < 16; i = i + 1) {
            int c = h[bo + i] & 255;
            int d = (c >= 48 && c <= 57) ? (c - 48) : (c - 87);
            v = (v << 4) | (long)d;
        }
        return v;
    }

    // 惰性装载 80 个轮常量 K 与初始哈希 H0（幂等）。
    private static void init() {
        if (ready) { return; }
        long[] ka = new long[80];
        for (int i = 0; i < 80; i = i + 1) { ka[i] = Word64(KHEX, i); }
        long[] ha = new long[8];
        for (int i = 0; i < 8; i = i + 1) { ha[i] = Word64(HHEX, i); }
        K = ka;
        H0 = ha;
        ready = true;
    }

    // 对 msg 的前 len 字节计算 64 字节 SHA-512 摘要。
    public static byte[] Hash(string msg, int len) {
        if (len < 0 || (len > 0 && msg == null)) { return null; }
        nint src = (len > 0 && msg != null) ? (nint)msg : (nint)"";
        byte[] hw = NativeMemory.Sha512Bytes(src, (long)len);
        if (hw != null) {
            return hw;
        }
        init();
        return HashCore(msg, len, H0);
    }

    // 纯 Zan 压缩路径：以给定初始哈希值计算 64 字节 SHA-512 状态。
    // SHA-384 复用同一压缩函数（初始值不同，输出截取前 48 字节）。
    internal static byte[] HashCore(string msg, int len, long[] h0) {
        if (len < 0 || (len > 0 && msg == null) || h0 == null || h0.Length < 8) { return null; }
        init();
        long[] kArr = K;
        // 填充后的长度：128 的倍数，末尾带 16 字节长度字段
        int totalBlocks = ((len + 16) / 128) + 1;
        int padded = totalBlocks * 128;
        byte[] m = new byte[padded];
        if (len > 0 && msg != null) {
            NativeMemory.PutString((nint)m, 0, msg, len);
        }
        m[len] = 0x80;
        // 128 位大端序比特长度；仅使用低 64 位
        long bitLen = (long)len * 8;
        m[padded - 8] = (byte)((bitLen >> 56) & 255);
        m[padded - 7] = (byte)((bitLen >> 48) & 255);
        m[padded - 6] = (byte)((bitLen >> 40) & 255);
        m[padded - 5] = (byte)((bitLen >> 32) & 255);
        m[padded - 4] = (byte)((bitLen >> 24) & 255);
        m[padded - 3] = (byte)((bitLen >> 16) & 255);
        m[padded - 2] = (byte)((bitLen >> 8) & 255);
        m[padded - 1] = (byte)(bitLen & 255);

        long h0v = h0[0]; long h1v = h0[1]; long h2v = h0[2]; long h3v = h0[3];
        long h4v = h0[4]; long h5v = h0[5]; long h6v = h0[6]; long h7v = h0[7];
        long[] w = new long[80];

        for (int blk = 0; blk < totalBlocks; blk = blk + 1) {
            int baseOff = blk * 128;
            for (int t = 0; t < 16; t = t + 1) {
                int off = baseOff + t * 8;
                w[t] = ((long)(m[off] & 255) << 56)
                     | ((long)(m[off + 1] & 255) << 48)
                     | ((long)(m[off + 2] & 255) << 40)
                     | ((long)(m[off + 3] & 255) << 32)
                     | ((long)(m[off + 4] & 255) << 24)
                     | ((long)(m[off + 5] & 255) << 16)
                     | ((long)(m[off + 6] & 255) << 8)
                     | (long)(m[off + 7] & 255);
            }
            for (int t = 16; t < 80; t = t + 1) {
                long w15 = w[t - 15];
                long sv0 = BitOperations.RotateRight(w15, 1) ^ BitOperations.RotateRight(w15, 8) ^ (long)((ulong)w15 >> 7);
                long w2 = w[t - 2];
                long sv1 = BitOperations.RotateRight(w2, 19) ^ BitOperations.RotateRight(w2, 61) ^ (long)((ulong)w2 >> 6);
                w[t] = w[t - 16] + sv0 + w[t - 7] + sv1;
            }
            long a = h0v; long bb = h1v; long c = h2v; long d = h3v;
            long e = h4v; long f = h5v; long g = h6v; long hh = h7v;
            for (int t = 0; t < 80; t = t + 1) {
                long ch = (e & f) ^ ((~e) & g);
                long bs1 = BitOperations.RotateRight(e, 14) ^ BitOperations.RotateRight(e, 18) ^ BitOperations.RotateRight(e, 41);
                long temp1 = hh + bs1 + ch + kArr[t] + w[t];
                long maj = (a & bb) ^ (a & c) ^ (bb & c);
                long bs0 = BitOperations.RotateRight(a, 28) ^ BitOperations.RotateRight(a, 34) ^ BitOperations.RotateRight(a, 39);
                long temp2 = bs0 + maj;
                hh = g; g = f; f = e; e = d + temp1;
                d = c; c = bb; bb = a; a = temp1 + temp2;
            }
            h0v = h0v + a; h1v = h1v + bb; h2v = h2v + c; h3v = h3v + d;
            h4v = h4v + e; h5v = h5v + f; h6v = h6v + g; h7v = h7v + hh;
        }

        byte[] outb = new byte[64];
        WriteBE64(outb, 0, h0v);  WriteBE64(outb, 8, h1v);
        WriteBE64(outb, 16, h2v); WriteBE64(outb, 24, h3v);
        WriteBE64(outb, 32, h4v); WriteBE64(outb, 40, h5v);
        WriteBE64(outb, 48, h6v); WriteBE64(outb, 56, h7v);
        return outb;
    }

    private static void WriteBE64(byte[] b, int o, long v) {
        b[o]     = (byte)((v >> 56) & 255);
        b[o + 1] = (byte)((v >> 48) & 255);
        b[o + 2] = (byte)((v >> 40) & 255);
        b[o + 3] = (byte)((v >> 32) & 255);
        b[o + 4] = (byte)((v >> 24) & 255);
        b[o + 5] = (byte)((v >> 16) & 255);
        b[o + 6] = (byte)((v >> 8) & 255);
        b[o + 7] = (byte)(v & 255);
    }

    public static byte[] Hash(byte[] msg, int len) {
        if (msg == null || len <= 0) {
            string empty = "";
            return Hash(empty, 0);
        }
        string s = msg;
        return Hash(s, len);
    }

    public static byte[] Hash(byte[] msg) {
        if (msg == null) { return Hash(new byte[0], 0); }
        return Hash(msg, msg.Length);
    }

    public static byte[] Hash(string msg) {
        if (msg == null) { return Hash("", 0); }
        return Hash(msg, msg.Length);
    }
}
