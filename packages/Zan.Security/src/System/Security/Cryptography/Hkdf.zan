using System;

namespace System.Security.Cryptography;

// 基于 HMAC-SHA256 的 HKDF（RFC 5869）：先提取后扩展的密钥
// 派生。用于从单一主密钥派生各用途的子密钥，这样
// 泄漏的子密钥永远不会暴露主密钥或兄弟子密钥。
public class Hkdf {
    // HKDF-Extract：PRK = HMAC-SHA256(salt, ikm)。返回 32 字节。
    public static byte[] Extract(string salt, int saltLen, string ikm, int ikmLen) {
        return Hmac.Sha256Mac(salt, saltLen, ikm, ikmLen);
    }

    // HKDF-Expand：基于 prk 与 info 派生 outLen 字节（最多 8160，符合 RFC 5869 255*HashLen 上限）。
    private static byte[] ExpandCore(string prk, int prkLen, string info, int infoLen, int outLen) {
        if (outLen <= 0 || outLen > 8160) { return null; }
        if (prk == null || prkLen <= 0 || prkLen > prk.Length) { return null; }
        if (infoLen < 0 || (infoLen > 0 && (info == null || infoLen > info.Length))) { return null; }
        if (infoLen > 2147483591 - 33) { return null; }
        byte[] outb = new byte[outLen];
        byte[] t = null;
        int tLen = 0;
        int pos = 0;
        int counter = 1;
        while (pos < outLen) {
            byte[] msg = new byte[tLen + infoLen + 1];
            for (int i = 0; i < tLen; i = i + 1) { msg[i] = t[i] & 255; }
            for (int i = 0; i < infoLen; i = i + 1) { msg[tLen + i] = info[i] & 255; }
            msg[tLen + infoLen] = counter & 255;
            t = Hmac.Compute(0, prk, prkLen, msg, tLen + infoLen + 1);
            if (t == null || t.Length < 32) { return null; }
            tLen = 32;
            for (int j = 0; j < 32 && pos < outLen; j = j + 1) { outb[pos] = t[j] & 255; pos = pos + 1; }
            counter = counter + 1;
        }
        return outb;
    }

    // HKDF-Expand：由 32 字节 PRK 和 info 派生 outLen 字节（最多 8160）。
    public static byte[] Expand(string prk, string info, int infoLen, int outLen) {
        if (prk == null || prk.Length < 32) { return null; }
        return ExpandCore(prk, 32, info, infoLen, outLen);
    }

    // 一步调用的 HKDF：先 Extract 再 Expand。
    public static byte[] Derive(string salt, int saltLen, string ikm, int ikmLen, string info, int infoLen, int outLen) {
        byte[] prk = Extract(salt, saltLen, ikm, ikmLen);
        return Expand(prk, info, infoLen, outLen);
    }

    // 一步调用的 HKDF（字节数组重载）：先 Extract 再 Expand。
    public static byte[] Derive(byte[] salt, byte[] ikm, byte[] info, int outLen) {
        byte[] prk = Extract(salt, ikm);
        return Expand(prk, info, outLen);
    }

    // HKDF-Extract（字节数组重载）。
    public static byte[] Extract(byte[] salt, byte[] ikm) {
        int sLen = (salt == null) ? 0 : salt.Length;
        int iLen = (ikm == null) ? 0 : ikm.Length;
        return Hmac.Sha256(salt, sLen, ikm, iLen);
    }

    // HKDF-Expand（字节数组重载）。
    public static byte[] Expand(byte[] prk, byte[] info, int outLen) {
        int infoLen = (info == null) ? 0 : info.Length;
        int prkLen = (prk == null) ? 0 : prk.Length;
        return ExpandCore(prk, prkLen, info, infoLen, outLen);
    }

    // 标签自动追加 "tls13 " 前缀并按 uint16 length + opaque label + opaque context 编码。
    public static byte[] ExpandLabel(byte[] secret, string label, byte[] context, int length) {
        if (length <= 0 || length > 65535) { return null; }
        string prefix = "tls13 ";
        int labelLen = prefix.Length + ((label == null) ? 0 : label.Length);
        int ctxLen = (context == null) ? 0 : context.Length;
        if (labelLen > 255 || ctxLen > 255) { return null; }
        byte[] hkdfLabel = new byte[2 + 1 + labelLen + 1 + ctxLen];

        hkdfLabel[0] = (byte)((length >> 8) & 255);
        hkdfLabel[1] = (byte)(length & 255);
        hkdfLabel[2] = (byte)(labelLen & 255);

        for (int i = 0; i < prefix.Length; i = i + 1) {
            hkdfLabel[3 + i] = (byte)(prefix[i] & 255);
        }
        if (label != null) {
            for (int i = 0; i < label.Length; i = i + 1) {
                hkdfLabel[3 + prefix.Length + i] = (byte)(label[i] & 255);
            }
        }
        int off = 3 + labelLen;
        hkdfLabel[off] = (byte)(ctxLen & 255);
        off = off + 1;
        if (context != null) {
            for (int i = 0; i < ctxLen; i = i + 1) {
                hkdfLabel[off + i] = (byte)(context[i] & 255);
            }
        }

        return Expand(secret, hkdfLabel, length);
    }

    // RFC 5246 TLS 1.2 PRF-SHA256 伪随机函数：P_SHA256(secret, label + seed)，派生 outLen 字节。
    public static byte[] Tls12Prf(byte[] secret, string label, byte[] seed, int outLen) {
        if (outLen < 0) { return null; }
        if (outLen == 0) { return new byte[0]; }
        int labelLen = (label == null) ? 0 : label.Length;
        int seedLen = (seed == null) ? 0 : seed.Length;
        if (labelLen > 2147483647 - seedLen) { return null; }
        byte[] seedTotal = new byte[labelLen + seedLen];
        for (int i = 0; i < labelLen; i = i + 1) {
            seedTotal[i] = (byte)(label[i] & 255);
        }
        for (int i = 0; i < seedLen; i = i + 1) {
            seedTotal[labelLen + i] = (byte)(seed[i] & 255);
        }

        byte[] outb = new byte[outLen];
        int secLen = (secret == null) ? 0 : secret.Length;
        byte[] a = Hmac.Sha256(secret, secLen, seedTotal, seedTotal.Length);  // A(1) = HMAC(secret, seed)
        if (a == null) { return null; }
        int pos = 0;

        while (pos < outLen) {
            // A(i) + seedTotal
            byte[] blockInput = new byte[a.Length + seedTotal.Length];
            for (int i = 0; i < a.Length; i = i + 1) { blockInput[i] = a[i]; }
            for (int i = 0; i < seedTotal.Length; i = i + 1) { blockInput[a.Length + i] = seedTotal[i]; }

            byte[] p = Hmac.Sha256(secret, secLen, blockInput, blockInput.Length);
            if (p == null || p.Length == 0) { return null; }
            for (int i = 0; i < p.Length && pos < outLen; i = i + 1) {
                outb[pos] = p[i];
                pos = pos + 1;
            }

            // A(i+1) = HMAC(secret, A(i))
            a = Hmac.Sha256(secret, secLen, a, a.Length);
            if (a == null) { return null; }
        }

        return outb;
    }
}
