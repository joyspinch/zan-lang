using System;
using System.Numerics;

namespace System.Security.Cryptography;

// 哈希/加密原语共用的位操作辅助函数。
// 底层直接映射至 CPU 硬件单周期循环移位指令（ROL/ROR）。
public class Bits {
    // 32 位循环左移。
    public static int Rotl32(int x, int n) {
        return BitOperations.RotateLeft(x, n);
    }

    // 32 位循环右移。
    public static int Rotr32(int x, int n) {
        return BitOperations.RotateRight(x, n);
    }

    // 64 位值的逻辑（无符号）右移：直接通过 ulong 单指令完成。
    public static long Shr64(long x, int n) {
        if (n <= 0) { return x; }
        if (n >= 64) { return 0; }
        return (long)((ulong)x >> n);
    }

    // 64 位循环右移（SHA-512 使用）。
    public static long Rotr64(long x, int n) {
        return BitOperations.RotateRight(x, n);
    }
}
