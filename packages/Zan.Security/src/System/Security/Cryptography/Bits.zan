using System;
using System.Numerics;

namespace System.Security.Cryptography;

/// <summary>哈希/加密原语共用的位操作辅助函数。
/// 底层直接映射至 CPU 硬件单周期循环移位指令（ROL/ROR）。</summary>
class Bits {
    /// <summary>32 位循环左移。</summary>
    static int Rotl32(int x, int n) {
        return BitOperations.RotateLeft(x, n);
    }

    /// <summary>32 位循环右移。</summary>
    static int Rotr32(int x, int n) {
        return BitOperations.RotateRight(x, n);
    }

    /// <summary>64 位值的逻辑（无符号）右移。Zan 的 <c>&gt;&gt;</c>
    /// 是算术右移，因此需将符号扩展出的高位掩掉。</summary>
    static long Shr64(long x, int n) {
        if (n <= 0) { return x; }
        if (n >= 64) { return 0; }
        long one = 1;
        long mask = (one << (64 - n)) - 1;
        return (x >> n) & mask;
    }

    /// <summary>64 位循环右移（SHA-512 使用）。</summary>
    static long Rotr64(long x, int n) {
        return BitOperations.RotateRight(x, n);
    }
}
