using System;

namespace System.Security.Cryptography;

// FIPS 180-4 SHA-384 安全哈希算法。SHA-384 与 SHA-512 共用同一压缩
// 函数，差别只在初始哈希值与输出长度：SHA-384 取 64 字节状态的前
// 48 字节。100% 纯 Zan 实现，零热点循环堆分配。
public class Sha384 {
    static string HHEX = "cbbb9d5dc1059ed8629a292a367cd5079159015a3070dd17152fecd8f70e593967332667ffc00b318eb44a8768581511db0c2e0d64f98fa747b5481dbefa4fa4";
    static List<long> H0;
    static bool ready = false;

    // 惰性装载 8 个初始哈希字（幂等）。
    private static void init() {
        if (ready) { return; }
        H0 = new List<long>();
        int i = 0; while (i < 8) { H0.Add(Sha512.Word64(HHEX, i)); i = i + 1; }
        ready = true;
    }

    // 对 <paramref name="len"/> 字节计算 SHA-384，返回 48 字节摘要。
    public static byte[] Hash(string msg, int len) {
        if (len < 0 || (len > 0 && msg == null)) { return null; }
        init();
        byte[] state = Sha512.HashCore(msg, len, H0);
        if (state == null || state.Length < 48) { return null; }
        byte[] outb = new byte[48];
        for (int i = 0; i < 48; i = i + 1) { outb[i] = state[i] & 255; }
        return outb;
    }

    public static byte[] Hash(byte[] msg, int len) {
        if (msg == null || len <= 0) {
            string empty = "";
            return Hash(empty, 0);
        }
        string s = msg;
        return Hash(s, len);
    }

    public static byte[] Hash(byte[] msg) {
        if (msg == null) { return Hash(new byte[0], 0); }
        return Hash(msg, msg.Length);
    }

    public static byte[] Hash(string msg) {
        if (msg == null) { return Hash("", 0); }
        return Hash(msg, msg.Length);
    }
}
