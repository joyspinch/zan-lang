using System;
using System.Json;
using System.Text;
namespace System.Security.Cryptography;

// 已解码的 JWT 及其签名与声明校验结果。
public class JwtToken {
    public bool valid;
    public string error;
    public string headerJson;
    public string payloadJson;
    public JsonValue header;
    public JsonValue payload;

    public JwtToken() {
        this.valid = false;
        this.error = "";
        this.headerJson = "";
        this.payloadJson = "";
        this.header = null;
        this.payload = null;
    }

    // 仅当结构、算法、签名、JSON 及所请求的声明全部有效时才为 true。
    public bool IsValid() { return valid; }

    // 令牌有效时返回空字符串，否则返回固定的校验错误信息。
    public string Error() { return error; }

    // 解码后的紧凑 header JSON，解码失败时为空字符串。
    public string HeaderJson() { return headerJson; }

    // 解码后的紧凑 payload JSON，解码失败时为空字符串。
    public string PayloadJson() { return payloadJson; }

    // 解析后的 header 对象，解码或 JSON 解析失败时为 null。
    public JsonValue Header() { return header; }

    // 解析后的声明对象，解码或 JSON 解析失败时为 null。
    public JsonValue Payload() { return payload; }
}

// 紧凑 JWS 令牌的 JSON Web Token 辅助函数。支持 HS256 和 RS256；
// 不安全（`none`）令牌及一切未被请求的算法都会被拒绝。解析
// 使用调用方提供的 Unix 时间戳，因此 exp/nbf 校验结果是确定性的。
// 预期的 issuer/audience 为空字符串时，仅禁用各自的校验。
