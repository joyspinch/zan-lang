using System;
using System.Json;
using System.Text;
namespace System.Security.Cryptography;

// 已解码的 JWT 及其签名与声明校验结果。
public class JwtToken {
    public bool valid;
    public string error;
    public string headerJson;
    public string payloadJson;
    public JsonDoc headerDoc;
    public JsonDoc payloadDoc;
    public JsonValue header;
    public JsonValue payload;

    public JwtToken() {
        this.valid = false;
        this.error = "";
        this.headerJson = "";
        this.payloadJson = "";
        this.headerDoc = null;
        this.payloadDoc = null;
        this.header = null;
        this.payload = null;
    }

    // 仅当结构、算法、签名、JSON 及所请求的声明全部有效时才为 true。
    public bool IsValid() { return valid; }

    // 令牌有效时返回空字符串，否则返回固定的校验错误信息。
    public string Error() { return error; }

    // 解码后的紧凑 header JSON，解码失败时为空字符串。
    public string HeaderJson() { return headerJson; }

    // 解码后的紧凑 payload JSON，解码失败时为空字符串。
    public string PayloadJson() { return payloadJson; }

    // 解码后的 header JsonDoc 平面磁带对象（零 DOM 堆分配），解码失败时为 null。
    public JsonDoc HeaderDoc() { return headerDoc; }

    // 解码后的声明 JsonDoc 平面磁带对象（零 DOM 堆分配），解码失败时为 null。
    public JsonDoc PayloadDoc() { return payloadDoc; }

    // 解析后的 header 对象（惰性解析以保证向后兼容），解码或 JSON 解析失败时为 null。
    public JsonValue Header() {
        if (this.header == null && this.headerJson.Length > 0) {
            try { this.header = JsonValue.Parse(this.headerJson); } catch (Exception e) { this.header = null; }
        }
        return header;
    }

    // 解析后的声明对象（惰性解析以保证向后兼容），解码或 JSON 解析失败时为 null。
    public JsonValue Payload() {
        if (this.payload == null && this.payloadJson.Length > 0) {
            try { this.payload = JsonValue.Parse(this.payloadJson); } catch (Exception e) { this.payload = null; }
        }
        return payload;
    }
}
