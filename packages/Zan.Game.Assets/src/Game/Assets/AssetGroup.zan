using System;
using System.Collections.Generic;

namespace Game.Assets;

// 资源组：一次加载/卸载一批资源。
//
// 游戏里最常见的资源边界就是"一个场景"：进场景时把该场景
// 的贴图/音频/配置一起拉进来，出场景时一起卸掉。资源组
// 就是这个边界的一等公民。
//
// 组是**清单层面的划分**（按 id 前缀），不是运行期的额外结构——
// 所以组不持有资源，资源也不持有组，两边没有 ARC 环。
public class AssetGroup {
    // 组名。
    private string name;
    // 组内资源 id（清单里挑出来的）。
    private List<string> ids;

    public AssetGroup(string name, List<string> ids) {
        this.name = name != null ? name : "";
        this.ids = new List<string>();
        if (ids != null) {
            for (int i = 0; i < ids.Count; i = i + 1) {
                this.ids.Add(ids[i]);
            }
        }
    }

    // 组名。
    public string Name() {
        return this.name;
    }

    // 组内资源 id（按加入顺序）。
    public List<string> Ids() {
        return this.ids;
    }

    // 组内资源数。
    public int Count() {
        return this.ids.Count;
    }

    // 从清单里按 id 前缀挑出一个组。
    //
    // 前缀是**路径式**的（"ui/hud/"），不是子串匹配——
    // "ui/" 不该命中 "ui2/xxx"。
    public static AssetGroup FromPrefix(AssetManifest manifest, string name, string prefix) {
        List<string> ids = new List<string>();
        if (manifest != null && prefix != null) {
            List<AssetEntry> entries = manifest.Entries();
            for (int i = 0; i < entries.Count; i = i + 1) {
                if (entries[i].id.StartsWith(prefix)) {
                    ids.Add(entries[i].id);
                }
            }
        }
        return new AssetGroup(name, ids);
    }

    // 从清单里按 id 精确列出组成一个组。
    public static AssetGroup FromIds(AssetManifest manifest, string name, List<string> ids) {
        List<string> picked = new List<string>();
        if (manifest != null && ids != null) {
            for (int i = 0; i < ids.Count; i = i + 1) {
                if (manifest.Contains(ids[i])) {
                    picked.Add(ids[i]);
                }
            }
        }
        return new AssetGroup(name, picked);
    }

    // 整组加载（依赖由 store 递归兑现）。返回实际加载的条数。
    public int LoadAll(AssetStore store) {
        if (store == null) { return 0; }
        int n = 0;
        for (int i = 0; i < this.ids.Count; i = i + 1) {
            store.Acquire(this.ids[i]);
            n = n + 1;
        }
        return n;
    }

    // 整组释放（必须与 LoadAll 一一对应，否则会 underflow）。
    public int ReleaseAll(AssetStore store) {
        if (store == null) { return 0; }
        int n = 0;
        // 逆序释放：先卸依赖者，再卸被依赖的。
        for (int i = this.ids.Count - 1; i >= 0; i = i - 1) {
            store.Release(this.ids[i]);
            n = n + 1;
        }
        return n;
    }
}
