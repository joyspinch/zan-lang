namespace Game.Assets;

// 资源来源：把清单里的 path 变成字节。
//
// 清单与来源解耦——同一份清单既能配文件系统（开发期），
// 也能配打包文件（发布后），还能配内存（测试、远端注入）。
public interface IAssetProvider {
    // 读一个资源。成功写出参并返回 true；没有或读失败返回 false
    // （失败原因由实现自己区分，不要在这里抛——上层要的是
    // "能不能拿到"，具体是缺文件还是坏了，交给各自的调用点判断）。
    bool TryRead(string path, out byte[] data);

    // 资源是否存在于本源（用于预检，避免真的去读一遍）。
    bool Exists(string path);
}
