using System;
using System.Collections.Generic;

namespace Game.Assets;

// 资源处理器：把字节解码成强类型对象。
//
// **编译期定型，零反射**：解码器是按具体类型注册的
//（AssetLoader.Register<Texture>(...)），不是"按类型名查方法"。
// 代价是每种资源类型要写一行注册；换来的是解码路径完全静态，
// 一次运行期查表都不会有。
public delegate T AssetDecoder<T>(byte[] data);

public class AssetLoader {
    // 清单。
    private AssetManifest manifest;
    // 存储。
    private AssetStore store;

    public AssetLoader(AssetManifest manifest, AssetStore store) {
        this.manifest = manifest != null ? manifest : new AssetManifest();
        this.store = store != null ? store : new AssetStore(this.manifest);
    }

    // 存储。
    public AssetStore Store() {
        return this.store;
    }

    // 清单。
    public AssetManifest Manifest() {
        return this.manifest;
    }

    // 取资源并解码成 T。
    //
    // 解码器没注册时抛 ArgumentException——"用哪种类型解码"
    // 是调用点的事，库不猜。
    public T Load<T>(string id, AssetDecoder<T> decoder) {
        if (decoder == null) {
            throw new ArgumentException("decoder is null for asset: " + id);
        }
        byte[] data = this.store.Acquire(id);
        try {
            return decoder(data);
        } catch (AssetException) {
            throw;
        } catch (Exception e) {
            throw new AssetException(AssetError.ReadFailed, id,
                "decode failed for '" + id + "': " + e.Message);
        }
    }

    // 只取字节不解码。
    public byte[] LoadBytes(string id) {
        return this.store.Acquire(id);
    }

    // 释放（对应一次 Load）。
    public void Release(string id) {
        this.store.Release(id);
    }
}
