using System;
using System.Collections.Generic;

namespace Game.Assets;

// 资源清单里的一条：某个 id 对应什么文件、什么种类、依赖谁。
//
// 清单是**声明式**的：它只描述"有什么"，不描述"怎么加载"。
// 加载由 IAssetProvider 决定（文件系统 / 内存 / 打包文件），
// 同一份清单可以配不同 provider——这就是"清单与来源解耦"。
public class AssetEntry {
    // 资源 id（清单内唯一）。
    public string id;
    // 资源种类。
    public AssetKind kind;
    // 提供者侧的路径（对文件系统是相对路径，对打包文件是包内名）。
    public string path;
    // 直接依赖的 id 列表（加载本资源前必须先加载它们）。
    public List<string> depends;
    // 字节数（0 = 未知，由提供者报）。
    public long size;

    public AssetEntry(string id, AssetKind kind, string path) {
        this.id = id != null ? id : "";
        this.kind = kind;
        this.path = path != null ? path : "";
        this.depends = new List<string>();
        this.size = 0L;
    }

    // 加一条直接依赖。
    public AssetEntry Depends(string otherId) {
        if (otherId == null || otherId == "") { return this; }
        if (!this.depends.Contains(otherId)) {
            this.depends.Add(otherId);
        }
        return this;
    }
}
