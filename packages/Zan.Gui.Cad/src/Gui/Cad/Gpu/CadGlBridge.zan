using System;

namespace Gui.Cad.Gpu;

// 原生 OpenGL 3.3 Core / GLES 3.0 / WebGL 2.0 函数指针委托（绑定 zan_gl_api 指针表）
internal delegate void CadGlUintFn(uint a);
internal delegate void CadGlByteFn(byte a);
internal delegate uint CadGlUintRetUintFn(uint a);
internal delegate nint CadGlUintRetPtrFn(uint a);
internal delegate void CadGlTwoUintFn(uint a, uint b);
internal delegate void CadGlFourUintFn(uint a, uint b, uint c, uint d);
internal delegate void CadGlFourIntFn(int a, int b, int c, int d);
internal delegate void CadGlIntFn(int a);
internal delegate void CadGlFourFloatFn(float a, float b, float c, float d);
internal delegate void CadGlTwoFloatFn(float a, float b);
internal delegate void CadGlUintIntFn(uint a, int b);
internal delegate void CadGlGetIntFn(uint pname, nint data);
internal delegate void CadGlDrawArraysFn(uint mode, int first, int count);
internal delegate void CadGlDrawArraysInstFn(uint mode, int first, int count, int primcount);
internal delegate void CadGlDrawElementsFn(uint mode, int count, uint type, nint indices);
internal delegate void CadGlReadPixelsFn(int x, int y, int w, int h, uint fmt, uint type, nint pixels);
internal delegate int CadGlGetLocFn(uint prog, nint name);
internal delegate void CadGlUniform1iFn(int loc, int v0);
internal delegate void CadGlUniform2fFn(int loc, float v0, float v1);
internal delegate void CadGlUniform4fFn(int loc, float v0, float v1, float v2, float v3);
internal delegate void CadGlUniformVecFn(int loc, int count, nint ptr);
internal delegate void CadGlUniformMat4Fn(int loc, int count, byte transpose, nint ptr);
internal delegate void CadGlGenDelFn(int n, nint ids);
internal delegate void CadGlBufferDataFn(uint target, nint size, nint data, uint usage);
internal delegate void CadGlVertexAttribPtrFn(uint idx, int size, uint type, byte norm, int stride, nint offset);
internal delegate void CadGlRbStorageFn(uint target, uint internalFmt, int w, int h);
internal delegate void CadGlRbStorageMsFn(uint target, int samples, uint internalFmt, int w, int h);
internal delegate void CadGlFboRbFn(uint target, uint attachment, uint rbTarget, uint renderbuffer);
internal delegate void CadGlBlitFboFn(int sx0, int sy0, int sx1, int sy1, int dx0, int dy0, int dx1, int dy1, uint mask, uint filter);

internal struct CadGpuFrame {
    public nint ApiPtr;
    public uint Framebuffer;
    public int Width;
    public int Height;
    public int ClipX;
    public int ClipY;
    public int ClipW;
    public int ClipH;
    public ulong Epoch;
}

internal sealed class CadGlApi {
    public nint RawPtr;

    public CadGlUintFn Enable;
    public CadGlUintFn Disable;
    public CadGlTwoUintFn BlendFunc;
    public CadGlFourUintFn BlendFuncSeparate;
    public CadGlFourIntFn Viewport;
    public CadGlFourIntFn Scissor;
    public CadGlFourFloatFn ClearColor;
    public CadGlUintFn Clear;
    public CadGlUintIntFn PixelStorei;
    public CadGlUintRetPtrFn GetString;
    public CadGlDrawArraysFn DrawArrays;
    public CadGlDrawElementsFn DrawElements;
    public CadGlUintFn DepthFunc;
    public CadGlReadPixelsFn ReadPixels;
    public CadGlUintFn UseProgram;
    public CadGlUintFn DeleteProgram;
    public CadGlGetLocFn GetUniformLocation;
    public CadGlUniform1iFn Uniform1i;
    public CadGlUniform2fFn Uniform2f;
    public CadGlUniformVecFn Uniform3fv;
    public CadGlUniform4fFn Uniform4f;
    public CadGlUniformMat4Fn UniformMatrix4fv;
    public CadGlGenDelFn GenBuffers;
    public CadGlGenDelFn DeleteBuffers;
    public CadGlTwoUintFn BindBuffer;
    public CadGlBufferDataFn BufferData;
    public CadGlGenDelFn GenVertexArrays;
    public CadGlGenDelFn DeleteVertexArrays;
    public CadGlUintFn BindVertexArray;
    public CadGlUintFn EnableVertexAttribArray;
    public CadGlVertexAttribPtrFn VertexAttribPointer;
    public CadGlTwoUintFn VertexAttribDivisor;
    public CadGlGenDelFn GenFramebuffers;
    public CadGlGenDelFn DeleteFramebuffers;
    public CadGlTwoUintFn BindFramebuffer;
    public CadGlGenDelFn GenRenderbuffers;
    public CadGlGenDelFn DeleteRenderbuffers;
    public CadGlTwoUintFn BindRenderbuffer;
    public CadGlRbStorageFn RenderbufferStorage;
    public CadGlFboRbFn FramebufferRenderbuffer;
    public CadGlUintRetUintFn CheckFramebufferStatus;
    public CadGlBlitFboFn BlitFramebuffer;
    public CadGlDrawArraysInstFn DrawArraysInstanced;
    public CadGlTwoFloatFn PolygonOffset;
    public CadGlByteFn DepthMask;
    public CadGlUintFn CullFace;
    public CadGlIntFn ClearStencil;
    public CadGlRbStorageMsFn RenderbufferStorageMultisample;
    public CadGlGetIntFn GetIntegerv;
    public CadGlUniformVecFn Uniform4fv;

    public bool HasBlendFuncSeparate;
    public bool HasGetString;
    public bool HasBlitFramebuffer;
    public bool HasDrawArraysInstanced;
    public bool HasPolygonOffset;
    public bool HasDepthMask;
    public bool HasCullFace;
    public bool HasClearStencil;
    public bool HasRenderbufferStorageMultisample;
    public bool HasGetIntegerv;
    public bool HasUniform4fv;
}

internal static class CadGlConst {
    public const uint Lines = 0x0001u;
    public const uint Triangles = 0x0004u;
    public const uint Less = 0x0201u;
    public const uint SrcAlpha = 0x0302u;
    public const uint OneMinusSrcAlpha = 0x0303u;
    public const uint One = 1u;
    public const uint Back = 0x0405u;
    public const uint CullFace = 0x0B44u;
    public const uint DepthTest = 0x0B71u;
    public const uint Blend = 0x0BE2u;
    public const uint ScissorTest = 0x0C11u;
    public const uint PackAlignment = 0x0D05u;
    public const uint UnsignedByte = 0x1401u;
    public const uint UnsignedInt = 0x1405u;
    public const uint Float = 0x1406u;
    public const uint Rgba = 0x1908u;
    public const uint Version = 0x1F02u;
    public const uint Nearest = 0x2600u;
    public const uint DepthBufferBit = 0x00000100u;
    public const uint StencilBufferBit = 0x00000400u;
    public const uint ColorBufferBit = 0x00004000u;
    public const uint PolygonOffsetFill = 0x8037u;
    public const uint Rgba8 = 0x8058u;
    public const uint DepthStencilAttachment = 0x821Au;
    public const uint ArrayBuffer = 0x8892u;
    public const uint ElementArrayBuffer = 0x8893u;
    public const uint StaticDraw = 0x88E4u;
    public const uint DynamicDraw = 0x88E8u;
    public const uint Depth24Stencil8 = 0x88F0u;
    public const uint ReadFramebuffer = 0x8CA8u;
    public const uint DrawFramebuffer = 0x8CA9u;
    public const uint FramebufferComplete = 0x8CD5u;
    public const uint ColorAttachment0 = 0x8CE0u;
    public const uint Framebuffer = 0x8D40u;
    public const uint Renderbuffer = 0x8D41u;
    public const uint MaxSamples = 0x8D57u;
}

internal static class CadGlBridge {
    private static CadGlApi cachedApi;
    private static nint scratchFrameBuf;
    private static nint scratchU32Buf;
    private static nint scratchI32Buf;
    private static nint scratchNameBuf;

    [DllImport("zan_gui")]
    private static extern int zan_gui_gpu_begin(int surfaceId, nint frameOut);

    [DllImport("zan_gui")]
    private static extern void zan_gui_gpu_end(int surfaceId);

    [DllImport("zan_gui")]
    private static extern uint zan_gui_gpu_program(string vertex, string fragment);

    [DllImport("zan_gui")]
    private static extern nint zan_gui_surface_bitmap(int surfaceId);

    [DllImport("zan_gui")]
    private static extern void zan_gui_fill_rect(int surfaceId, int x, int y, int w, int h, int color);

    [DllImport("zan_gui")]
    private static extern void zan_gui_draw_line(int surfaceId, int x0, int y0, int x1, int y1, int color, int thickness);

    [DllImport("zan_gui")]
    private static extern void zan_gui_draw_circle(int surfaceId, int cx, int cy, int radius, int color, int thickness);

    [DllImport("zan_gui")]
    private static extern void zan_gui_fill_circle(int surfaceId, int cx, int cy, int radius, int color);

    public static int PtrSize() {
#if WASM
        return 4;
#else
        return 8;
#endif
    }

    private static nint Slot(nint apiPtr, int index) {
        int ps = CadGlBridge.PtrSize();
        return new Span<nint>(apiPtr + (nint)(index * ps), 1)[0];
    }

    public static bool GpuBegin(int surfaceId, out CadGpuFrame frame) {
        frame = new CadGpuFrame();
        if (CadGlBridge.scratchFrameBuf == 0) {
            CadGlBridge.scratchFrameBuf = NativeMemory.Alloc(64);
        }
        NativeMemory.Fill(CadGlBridge.scratchFrameBuf, 0, 64);
        int ok = CadGlBridge.zan_gui_gpu_begin(surfaceId, CadGlBridge.scratchFrameBuf);
        if (ok == 0) {
            return false;
        }
        int ps = CadGlBridge.PtrSize();
        nint buf = CadGlBridge.scratchFrameBuf;
        frame.ApiPtr = new Span<nint>(buf, 1)[0];
        frame.Framebuffer = new Span<uint>(buf + (nint)ps, 1)[0];
        frame.Width = new Span<int>(buf + (nint)(ps + 4), 1)[0];
        frame.Height = new Span<int>(buf + (nint)(ps + 8), 1)[0];
        frame.ClipX = new Span<int>(buf + (nint)(ps + 12), 1)[0];
        frame.ClipY = new Span<int>(buf + (nint)(ps + 16), 1)[0];
        frame.ClipW = new Span<int>(buf + (nint)(ps + 20), 1)[0];
        frame.ClipH = new Span<int>(buf + (nint)(ps + 24), 1)[0];
        int epochOff = ps == 8 ? 40 : 32;
        frame.Epoch = new Span<ulong>(buf + (nint)epochOff, 1)[0];
        return frame.ApiPtr != 0;
    }

    public static void GpuEnd(int surfaceId) {
        CadGlBridge.zan_gui_gpu_end(surfaceId);
    }

    public static uint GpuProgram(string vertex, string fragment) {
        return CadGlBridge.zan_gui_gpu_program(vertex, fragment);
    }

    public static bool TryGetSurfaceSize(int surfaceId, out int w, out int h) {
        nint p = CadGlBridge.zan_gui_surface_bitmap(surfaceId);
        if (p == 0) {
            w = 0;
            h = 0;
            return false;
        }
        int ps = CadGlBridge.PtrSize();
        w = new Span<int>(p + (nint)ps, 1)[0];
        h = new Span<int>(p + (nint)(ps + 4), 1)[0];
        return w > 0 && h > 0;
    }

    public static void CpuFillRect(int surfaceId, int x, int y, int w, int h, int argb) {
        CadGlBridge.zan_gui_fill_rect(surfaceId, x, y, w, h, argb);
    }

    public static void CpuDrawLine(int surfaceId, int x0, int y0, int x1, int y1, int argb, int thickness) {
        CadGlBridge.zan_gui_draw_line(surfaceId, x0, y0, x1, y1, argb, thickness);
    }

    public static void CpuDrawCircle(int surfaceId, int cx, int cy, int radius, int argb, int thickness) {
        CadGlBridge.zan_gui_draw_circle(surfaceId, cx, cy, radius, argb, thickness);
    }

    public static void CpuFillCircle(int surfaceId, int cx, int cy, int radius, int argb) {
        CadGlBridge.zan_gui_fill_circle(surfaceId, cx, cy, radius, argb);
    }

    public static CadGlApi Bind(nint apiPtr) {
        if (CadGlBridge.cachedApi != null && CadGlBridge.cachedApi.RawPtr == apiPtr) {
            return CadGlBridge.cachedApi;
        }
        CadGlApi g = new CadGlApi();
        g.RawPtr = apiPtr;
        g.Enable = (CadGlUintFn)CadGlBridge.Slot(apiPtr, 0);
        g.Disable = (CadGlUintFn)CadGlBridge.Slot(apiPtr, 1);
        g.BlendFunc = (CadGlTwoUintFn)CadGlBridge.Slot(apiPtr, 2);
        nint pBfs = CadGlBridge.Slot(apiPtr, 3);
        g.HasBlendFuncSeparate = pBfs != 0;
        if (pBfs != 0) { g.BlendFuncSeparate = (CadGlFourUintFn)pBfs; }
        g.Viewport = (CadGlFourIntFn)CadGlBridge.Slot(apiPtr, 4);
        g.Scissor = (CadGlFourIntFn)CadGlBridge.Slot(apiPtr, 5);
        g.ClearColor = (CadGlFourFloatFn)CadGlBridge.Slot(apiPtr, 6);
        g.Clear = (CadGlUintFn)CadGlBridge.Slot(apiPtr, 7);
        g.PixelStorei = (CadGlUintIntFn)CadGlBridge.Slot(apiPtr, 8);
        nint pGetStr = CadGlBridge.Slot(apiPtr, 12);
        g.HasGetString = pGetStr != 0;
        if (pGetStr != 0) { g.GetString = (CadGlUintRetPtrFn)pGetStr; }
        g.DrawArrays = (CadGlDrawArraysFn)CadGlBridge.Slot(apiPtr, 13);
        g.DrawElements = (CadGlDrawElementsFn)CadGlBridge.Slot(apiPtr, 14);
        g.DepthFunc = (CadGlUintFn)CadGlBridge.Slot(apiPtr, 16);
        g.ReadPixels = (CadGlReadPixelsFn)CadGlBridge.Slot(apiPtr, 17);
        g.UseProgram = (CadGlUintFn)CadGlBridge.Slot(apiPtr, 29);
        g.DeleteProgram = (CadGlUintFn)CadGlBridge.Slot(apiPtr, 30);
        g.GetUniformLocation = (CadGlGetLocFn)CadGlBridge.Slot(apiPtr, 31);
        g.Uniform1i = (CadGlUniform1iFn)CadGlBridge.Slot(apiPtr, 33);
        g.Uniform2f = (CadGlUniform2fFn)CadGlBridge.Slot(apiPtr, 34);
        g.Uniform3fv = (CadGlUniformVecFn)CadGlBridge.Slot(apiPtr, 35);
        g.Uniform4f = (CadGlUniform4fFn)CadGlBridge.Slot(apiPtr, 36);
        g.UniformMatrix4fv = (CadGlUniformMat4Fn)CadGlBridge.Slot(apiPtr, 37);
        g.GenBuffers = (CadGlGenDelFn)CadGlBridge.Slot(apiPtr, 38);
        g.DeleteBuffers = (CadGlGenDelFn)CadGlBridge.Slot(apiPtr, 39);
        g.BindBuffer = (CadGlTwoUintFn)CadGlBridge.Slot(apiPtr, 40);
        g.BufferData = (CadGlBufferDataFn)CadGlBridge.Slot(apiPtr, 41);
        g.GenVertexArrays = (CadGlGenDelFn)CadGlBridge.Slot(apiPtr, 42);
        g.DeleteVertexArrays = (CadGlGenDelFn)CadGlBridge.Slot(apiPtr, 43);
        g.BindVertexArray = (CadGlUintFn)CadGlBridge.Slot(apiPtr, 44);
        g.EnableVertexAttribArray = (CadGlUintFn)CadGlBridge.Slot(apiPtr, 45);
        g.VertexAttribPointer = (CadGlVertexAttribPtrFn)CadGlBridge.Slot(apiPtr, 46);
        g.VertexAttribDivisor = (CadGlTwoUintFn)CadGlBridge.Slot(apiPtr, 47);
        g.GenFramebuffers = (CadGlGenDelFn)CadGlBridge.Slot(apiPtr, 56);
        g.DeleteFramebuffers = (CadGlGenDelFn)CadGlBridge.Slot(apiPtr, 57);
        g.BindFramebuffer = (CadGlTwoUintFn)CadGlBridge.Slot(apiPtr, 58);
        g.GenRenderbuffers = (CadGlGenDelFn)CadGlBridge.Slot(apiPtr, 60);
        g.DeleteRenderbuffers = (CadGlGenDelFn)CadGlBridge.Slot(apiPtr, 61);
        g.BindRenderbuffer = (CadGlTwoUintFn)CadGlBridge.Slot(apiPtr, 62);
        g.RenderbufferStorage = (CadGlRbStorageFn)CadGlBridge.Slot(apiPtr, 63);
        g.FramebufferRenderbuffer = (CadGlFboRbFn)CadGlBridge.Slot(apiPtr, 64);
        g.CheckFramebufferStatus = (CadGlUintRetUintFn)CadGlBridge.Slot(apiPtr, 65);
        nint pBlit = CadGlBridge.Slot(apiPtr, 66);
        g.HasBlitFramebuffer = pBlit != 0;
        if (pBlit != 0) { g.BlitFramebuffer = (CadGlBlitFboFn)pBlit; }
        nint pDai = CadGlBridge.Slot(apiPtr, 67);
        g.HasDrawArraysInstanced = pDai != 0;
        if (pDai != 0) { g.DrawArraysInstanced = (CadGlDrawArraysInstFn)pDai; }
        nint pPoly = CadGlBridge.Slot(apiPtr, 68);
        g.HasPolygonOffset = pPoly != 0;
        if (pPoly != 0) { g.PolygonOffset = (CadGlTwoFloatFn)pPoly; }
        nint pDm = CadGlBridge.Slot(apiPtr, 69);
        g.HasDepthMask = pDm != 0;
        if (pDm != 0) { g.DepthMask = (CadGlByteFn)pDm; }
        nint pCf = CadGlBridge.Slot(apiPtr, 71);
        g.HasCullFace = pCf != 0;
        if (pCf != 0) { g.CullFace = (CadGlUintFn)pCf; }
        nint pCs = CadGlBridge.Slot(apiPtr, 76);
        g.HasClearStencil = pCs != 0;
        if (pCs != 0) { g.ClearStencil = (CadGlIntFn)pCs; }
        nint pRbm = CadGlBridge.Slot(apiPtr, 77);
        g.HasRenderbufferStorageMultisample = pRbm != 0;
        if (pRbm != 0) { g.RenderbufferStorageMultisample = (CadGlRbStorageMsFn)pRbm; }
        nint pGi = CadGlBridge.Slot(apiPtr, 78);
        g.HasGetIntegerv = pGi != 0;
        if (pGi != 0) { g.GetIntegerv = (CadGlGetIntFn)pGi; }
        nint pU4v = CadGlBridge.Slot(apiPtr, 80);
        g.HasUniform4fv = pU4v != 0;
        if (pU4v != 0) { g.Uniform4fv = (CadGlUniformVecFn)pU4v; }
        CadGlBridge.cachedApi = g;
        return g;
    }

    public static bool IsGlesVersion(CadGlApi gl) {
#if ANDROID || OHOS
        return true;
#else
        if (gl == null || !gl.HasGetString) { return false; }
        nint verPtr = gl.GetString(CadGlConst.Version);
        if (verPtr == 0) { return false; }
        Span<byte> b = new Span<byte>(verPtr, 64);
        int len = 0;
        while (len < 64 && b[len] != 0) { len = len + 1; }
        for (int i = 0; i + 9 <= len; i = i + 1) {
            if (b[i] == 79 && b[i + 1] == 112 && b[i + 2] == 101 && b[i + 3] == 110
                && b[i + 4] == 71 && b[i + 5] == 76 && b[i + 6] == 32
                && b[i + 7] == 69 && b[i + 8] == 83) {
                return true;
            }
        }
        return false;
#endif
    }

    public static void SetAlphaBlend(CadGlApi gl) {
        gl.Enable(CadGlConst.Blend);
        if (gl.HasBlendFuncSeparate) {
            gl.BlendFuncSeparate(CadGlConst.SrcAlpha, CadGlConst.OneMinusSrcAlpha,
                                 CadGlConst.One, CadGlConst.OneMinusSrcAlpha);
        } else {
            gl.BlendFunc(CadGlConst.SrcAlpha, CadGlConst.OneMinusSrcAlpha);
        }
    }

    public static int UniformLoc(CadGlApi gl, uint prog, string name) {
        if (prog == 0u || name == null) { return -1; }
        if (CadGlBridge.scratchNameBuf == 0) {
            CadGlBridge.scratchNameBuf = NativeMemory.Alloc(128);
        }
        int len = name.Length;
        if (len > 126) { len = 126; }
        Span<byte> buf = new Span<byte>(CadGlBridge.scratchNameBuf, 128);
        for (int i = 0; i < len; i = i + 1) {
            buf[i] = (byte)name[i];
        }
        buf[len] = 0;
        return gl.GetUniformLocation(prog, CadGlBridge.scratchNameBuf);
    }

    public static uint GenOne(CadGlGenDelFn genFn) {
        if (CadGlBridge.scratchU32Buf == 0) {
            CadGlBridge.scratchU32Buf = NativeMemory.Alloc(8);
        }
        Span<uint> s = new Span<uint>(CadGlBridge.scratchU32Buf, 1);
        s[0] = 0u;
        genFn(1, CadGlBridge.scratchU32Buf);
        return s[0];
    }

    public static void DeleteOne(CadGlGenDelFn delFn, uint id) {
        if (id == 0u) { return; }
        if (CadGlBridge.scratchU32Buf == 0) {
            CadGlBridge.scratchU32Buf = NativeMemory.Alloc(8);
        }
        new Span<uint>(CadGlBridge.scratchU32Buf, 1)[0] = id;
        delFn(1, CadGlBridge.scratchU32Buf);
    }

    public static int GetInt(CadGlApi gl, uint pname, int fallback) {
        if (gl == null || !gl.HasGetIntegerv) { return fallback; }
        if (CadGlBridge.scratchI32Buf == 0) {
            CadGlBridge.scratchI32Buf = NativeMemory.Alloc(8);
        }
        Span<int> s = new Span<int>(CadGlBridge.scratchI32Buf, 1);
        s[0] = fallback;
        gl.GetIntegerv(pname, CadGlBridge.scratchI32Buf);
        return s[0];
    }
}
