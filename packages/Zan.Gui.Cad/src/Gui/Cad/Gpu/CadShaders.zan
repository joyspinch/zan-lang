using System;

namespace Gui.Cad.Gpu;

// 跨平台 2D/3D CAD GPU 着色器（兼容 OpenGL 3.3 Core / GLES 3.0 / WebGL 2.0）
internal static class CadShaders {
    public static string GlslHeader(CadGlApi gl) {
        if (CadGlBridge.IsGlesVersion(gl)) {
            return "#version 300 es\nprecision highp float;\nprecision highp int;\n";
        }
        return "#version 330 core\n";
    }

    // 1. 无限工程栅格与世界坐标轴（0 顶点全屏绘制，RTE 相机锚点免大坐标抖动）
    public static string VsGrid() {
        return "void main() {\n"
            + "    vec2 p = vec2((gl_VertexID == 1 || gl_VertexID == 4 || gl_VertexID == 5) ? 1.0 : -1.0,\n"
            + "                  (gl_VertexID == 2 || gl_VertexID == 3 || gl_VertexID == 5) ? 1.0 : -1.0);\n"
            + "    gl_Position = vec4(p, 0.0, 1.0);\n"
            + "}\n";
    }

    public static string FsGrid() {
        return "uniform vec2 uViewport;\n"
            + "uniform vec4 uClip;\n"
            + "uniform vec4 uGridParam;\n"
            + "uniform vec4 uGridOrigin;\n"
            + "uniform vec4 uBgColor;\n"
            + "uniform vec4 uMinorColor;\n"
            + "uniform vec4 uMajorColor;\n"
            + "uniform vec4 uAxisXColor;\n"
            + "uniform vec4 uAxisYColor;\n"
            + "out vec4 o_color;\n"
            + "float grid_line_cov(float coord, float step_px, float half_w) {\n"
            + "    if (step_px < 2.0) return 0.0;\n"
            + "    float m = mod(coord, step_px);\n"
            + "    float d = min(m, step_px - m);\n"
            + "    return clamp(half_w + 0.5 - d, 0.0, 1.0);\n"
            + "}\n"
            + "void main() {\n"
            + "    vec2 p = vec2(gl_FragCoord.x, uViewport.y - gl_FragCoord.y);\n"
            + "    if (p.x < uClip.x || p.y < uClip.y || p.x >= uClip.z || p.y >= uClip.w) discard;\n"
            + "    float minor_px = uGridParam.x;\n"
            + "    float major_px = minor_px * max(uGridParam.y, 1.0);\n"
            + "    vec2 rel = p - uViewport * 0.5;\n"
            + "    vec2 minor_c = vec2(rel.x + uGridParam.z, -rel.y + uGridParam.w);\n"
            + "    vec2 major_c = vec2(rel.x + uGridOrigin.z, -rel.y + uGridOrigin.w);\n"
            + "    float cov_min = max(grid_line_cov(minor_c.x, minor_px, 0.5),\n"
            + "                        grid_line_cov(minor_c.y, minor_px, 0.5));\n"
            + "    float cov_maj = max(grid_line_cov(major_c.x, major_px, 0.6),\n"
            + "                        grid_line_cov(major_c.y, major_px, 0.6));\n"
            + "    vec4 col = uBgColor;\n"
            + "    if (cov_min > 0.0) {\n"
            + "        float a = uMinorColor.a * cov_min;\n"
            + "        col.rgb = mix(col.rgb, uMinorColor.rgb, a);\n"
            + "        col.a = a + col.a * (1.0 - a);\n"
            + "    }\n"
            + "    if (cov_maj > 0.0) {\n"
            + "        float a = uMajorColor.a * cov_maj;\n"
            + "        col.rgb = mix(col.rgb, uMajorColor.rgb, a);\n"
            + "        col.a = a + col.a * (1.0 - a);\n"
            + "    }\n"
            + "    float dx_axis = abs(p.y - uGridOrigin.y);\n"
            + "    float dy_axis = abs(p.x - uGridOrigin.x);\n"
            + "    float cx = clamp(1.25 - dx_axis, 0.0, 1.0);\n"
            + "    float cy = clamp(1.25 - dy_axis, 0.0, 1.0);\n"
            + "    if (cx > 0.0) { col.rgb = mix(col.rgb, uAxisXColor.rgb, uAxisXColor.a * cx); col.a = max(col.a, cx); }\n"
            + "    if (cy > 0.0) { col.rgb = mix(col.rgb, uAxisYColor.rgb, uAxisYColor.a * cy); col.a = max(col.a, cy); }\n"
            + "    o_color = col;\n"
            + "}\n";
    }

    // 2. 2D 保留式实例化解析线段（48 B/实例：屏幕/物理线宽、虚线/点划线/端点帽、RTE、拾取 ID）
    public static string VsLine2D() {
        return "uniform vec2 uViewport;\n"
            + "uniform vec2 uRteOffset;\n"
            + "uniform vec3 uCam;\n"
            + "uniform int uPickMode;\n"
            + "layout(location = 0) in vec4 a_seg;\n"
            + "layout(location = 1) in vec4 a_style;\n"
            + "layout(location = 2) in vec4 a_color;\n"
            + "out vec2 v_local;\n"
            + "flat out float v_len;\n"
            + "flat out float v_half_w;\n"
            + "flat out float v_flags;\n"
            + "flat out float v_dash;\n"
            + "flat out float v_id;\n"
            + "flat out vec4 v_color;\n"
            + "vec2 world_to_screen(vec2 w) {\n"
            + "    vec2 p = w + uRteOffset;\n"
            + "    vec2 r = vec2(p.x * uCam.y - p.y * uCam.z, p.x * uCam.z + p.y * uCam.y);\n"
            + "    return vec2(uViewport.x * 0.5 + r.x * uCam.x, uViewport.y * 0.5 - r.y * uCam.x);\n"
            + "}\n"
            + "void main() {\n"
            + "    vec2 s0 = world_to_screen(a_seg.xy);\n"
            + "    vec2 s1 = world_to_screen(a_seg.zw);\n"
            + "    int flg = int(a_style.y + 0.5);\n"
            + "    float w_px = ((flg & 1) != 0) ? max(a_style.x * uCam.x, 1.0) : max(a_style.x, 1.0);\n"
            + "    if (uPickMode != 0) w_px = max(w_px, 6.0);\n"
            + "    float hw = w_px * 0.5;\n"
            + "    float pad = hw + 1.5;\n"
            + "    vec2 d = s1 - s0;\n"
            + "    float len = length(d);\n"
            + "    vec2 dir = (len > 1e-4) ? (d / len) : vec2(1.0, 0.0);\n"
            + "    vec2 nrm = vec2(-dir.y, dir.x);\n"
            + "    float u = (gl_VertexID == 1 || gl_VertexID == 4 || gl_VertexID == 5) ? 1.0 : 0.0;\n"
            + "    float v = (gl_VertexID == 2 || gl_VertexID == 3 || gl_VertexID == 5) ? 1.0 : -1.0;\n"
            + "    float along = mix(-pad, len + pad, u);\n"
            + "    float perp = v * pad;\n"
            + "    vec2 sp = s0 + dir * along + nrm * perp;\n"
            + "    v_local = vec2(along, perp);\n"
            + "    v_len = len;\n"
            + "    v_half_w = hw;\n"
            + "    v_flags = a_style.y;\n"
            + "    v_dash = a_style.w;\n"
            + "    v_id = a_style.z;\n"
            + "    v_color = a_color;\n"
            + "    vec2 ndc = vec2(sp.x / uViewport.x * 2.0 - 1.0, 1.0 - sp.y / uViewport.y * 2.0);\n"
            + "    gl_Position = vec4(ndc, 0.0, 1.0);\n"
            + "}\n";
    }

    public static string FsLine2D() {
        return "uniform vec2 uViewport;\n"
            + "uniform vec4 uClip;\n"
            + "uniform int uPickMode;\n"
            + "in vec2 v_local;\n"
            + "flat in float v_len;\n"
            + "flat in float v_half_w;\n"
            + "flat in float v_flags;\n"
            + "flat in float v_dash;\n"
            + "flat in float v_id;\n"
            + "flat in vec4 v_color;\n"
            + "out vec4 o_color;\n"
            + "vec4 encode_id(float idf) {\n"
            + "    int id = int(idf + 0.5);\n"
            + "    return vec4(float(id & 255) / 255.0,\n"
            + "                float((id >> 8) & 255) / 255.0,\n"
            + "                float((id >> 16) & 255) / 255.0, 1.0);\n"
            + "}\n"
            + "void main() {\n"
            + "    vec2 p = vec2(gl_FragCoord.x, uViewport.y - gl_FragCoord.y);\n"
            + "    if (p.x < uClip.x || p.y < uClip.y || p.x >= uClip.z || p.y >= uClip.w) discard;\n"
            + "    int flg = int(v_flags + 0.5);\n"
            + "    int cap = (flg >> 4) & 3;\n"
            + "    float sd;\n"
            + "    if (cap == 1) {\n"
            + "        vec2 q = vec2(max(-v_local.x, v_local.x - v_len), abs(v_local.y) - v_half_w);\n"
            + "        sd = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0);\n"
            + "    } else if (cap == 2) {\n"
            + "        vec2 q = vec2(max(-v_local.x - v_half_w, v_local.x - v_len - v_half_w), abs(v_local.y) - v_half_w);\n"
            + "        sd = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0);\n"
            + "    } else {\n"
            + "        float cx = clamp(v_local.x, 0.0, v_len);\n"
            + "        sd = length(v_local - vec2(cx, 0.0)) - v_half_w;\n"
            + "    }\n"
            + "    float cov = clamp(0.5 - sd, 0.0, 1.0);\n"
            + "    if (cov <= 0.0) discard;\n"
            + "    if (uPickMode != 0) {\n"
            + "        if (v_id <= 0.5) discard;\n"
            + "        o_color = encode_id(v_id);\n"
            + "        return;\n"
            + "    }\n"
            + "    int ltype = (flg >> 1) & 7;\n"
            + "    if (ltype != 0 && v_dash > 2.0) {\n"
            + "        float t = mod(max(v_local.x, 0.0), v_dash) / v_dash;\n"
            + "        float on = 1.0;\n"
            + "        if (ltype == 1) on = (t < 0.62) ? 1.0 : 0.0;\n"
            + "        else if (ltype == 2) on = (t < 0.22) ? 1.0 : 0.0;\n"
            + "        else if (ltype == 3) on = (t < 0.52 || (t > 0.68 && t < 0.82)) ? 1.0 : 0.0;\n"
            + "        else if (ltype == 4) on = (t < 0.66 || (t > 0.76 && t < 0.88)) ? 1.0 : 0.0;\n"
            + "        if (on < 0.5) discard;\n"
            + "    }\n"
            + "    o_color = vec4(v_color.rgb, v_color.a * cov);\n"
            + "}\n";
    }

    // 3. 2D 保留式实例化解析圆 / 圆弧 / 椭圆弧（56 B/实例，支持填充/描边/角度裁剪/拾取 ID）
    public static string VsArc2D() {
        return "uniform vec2 uViewport;\n"
            + "uniform vec2 uRteOffset;\n"
            + "uniform vec3 uCam;\n"
            + "uniform int uPickMode;\n"
            + "layout(location = 0) in vec4 a_geom;\n"
            + "layout(location = 1) in vec4 a_arc;\n"
            + "layout(location = 2) in vec4 a_color;\n"
            + "layout(location = 3) in vec2 a_meta;\n"
            + "out vec2 v_epos;\n"
            + "flat out vec2 v_rad;\n"
            + "flat out vec4 v_arc;\n"
            + "flat out vec4 v_color;\n"
            + "flat out float v_id;\n"
            + "void main() {\n"
            + "    vec2 p = a_geom.xy + uRteOffset;\n"
            + "    vec2 r = vec2(p.x * uCam.y - p.y * uCam.z, p.x * uCam.z + p.y * uCam.y);\n"
            + "    vec2 sc = vec2(uViewport.x * 0.5 + r.x * uCam.x, uViewport.y * 0.5 - r.y * uCam.x);\n"
            + "    float rx_px = abs(a_geom.z) * uCam.x;\n"
            + "    float ry_px = abs(a_geom.w) * uCam.x;\n"
            + "    int flg = int(a_meta.x + 0.5);\n"
            + "    float w_px = ((flg & 1) != 0) ? max(a_arc.w * uCam.x, 1.0) : max(a_arc.w, 1.0);\n"
            + "    if (uPickMode != 0) w_px = max(w_px, 6.0);\n"
            + "    float hw = w_px * 0.5;\n"
            + "    float pad = hw + 2.0;\n"
            + "    float bx = rx_px + pad, by = ry_px + pad;\n"
            + "    float u = (gl_VertexID == 1 || gl_VertexID == 4 || gl_VertexID == 5) ? 1.0 : -1.0;\n"
            + "    float v = (gl_VertexID == 2 || gl_VertexID == 3 || gl_VertexID == 5) ? 1.0 : -1.0;\n"
            + "    vec2 eloc = vec2(u * bx, v * by);\n"
            + "    float ang = a_arc.x + atan(uCam.z, uCam.y);\n"
            + "    float ca = cos(ang), sa = sin(ang);\n"
            + "    vec2 scr_off = vec2(eloc.x * ca - eloc.y * sa, -(eloc.x * sa + eloc.y * ca));\n"
            + "    vec2 sp = sc + scr_off;\n"
            + "    v_epos = eloc;\n"
            + "    v_rad = vec2(max(rx_px, 0.5), max(ry_px, 0.5));\n"
            + "    v_arc = vec4(a_arc.y, a_arc.z, hw, a_meta.x);\n"
            + "    v_color = a_color;\n"
            + "    v_id = a_meta.y;\n"
            + "    vec2 ndc = vec2(sp.x / uViewport.x * 2.0 - 1.0, 1.0 - sp.y / uViewport.y * 2.0);\n"
            + "    gl_Position = vec4(ndc, 0.0, 1.0);\n"
            + "}\n";
    }

    public static string FsArc2D() {
        return "uniform vec2 uViewport;\n"
            + "uniform vec4 uClip;\n"
            + "uniform int uPickMode;\n"
            + "in vec2 v_epos;\n"
            + "flat in vec2 v_rad;\n"
            + "flat in vec4 v_arc;\n"
            + "flat in vec4 v_color;\n"
            + "flat in float v_id;\n"
            + "out vec4 o_color;\n"
            + "vec4 encode_id(float idf) {\n"
            + "    int id = int(idf + 0.5);\n"
            + "    return vec4(float(id & 255) / 255.0,\n"
            + "                float((id >> 8) & 255) / 255.0,\n"
            + "                float((id >> 16) & 255) / 255.0, 1.0);\n"
            + "}\n"
            + "void main() {\n"
            + "    vec2 p = vec2(gl_FragCoord.x, uViewport.y - gl_FragCoord.y);\n"
            + "    if (p.x < uClip.x || p.y < uClip.y || p.x >= uClip.z || p.y >= uClip.w) discard;\n"
            + "    int flg = int(v_arc.w + 0.5);\n"
            + "    bool filled = ((flg & 8) != 0);\n"
            + "    float sd;\n"
            + "    if (abs(v_rad.x - v_rad.y) < 0.05) {\n"
            + "        float d = length(v_epos) - v_rad.x;\n"
            + "        sd = filled ? d : (abs(d) - v_arc.z);\n"
            + "    } else {\n"
            + "        vec2 q = v_epos / v_rad;\n"
            + "        float k0 = length(q);\n"
            + "        float k1 = length(v_epos / (v_rad * v_rad));\n"
            + "        float d = (k1 > 1e-6) ? (k0 * (k0 - 1.0) / k1) : -min(v_rad.x, v_rad.y);\n"
            + "        sd = filled ? d : (abs(d) - v_arc.z);\n"
            + "    }\n"
            + "    float sweep = v_arc.y;\n"
            + "    if (abs(sweep) < 6.2830) {\n"
            + "        float theta = atan(v_epos.y / v_rad.y, v_epos.x / v_rad.x);\n"
            + "        float rel = mod(theta - v_arc.x, 6.2831853);\n"
            + "        float sw = sweep >= 0.0 ? sweep : -sweep;\n"
            + "        if (sweep < 0.0) rel = mod(v_arc.x - theta, 6.2831853);\n"
            + "        if (rel > sw) {\n"
            + "            if (filled) discard;\n"
            + "            float a_end = v_arc.x + sweep;\n"
            + "            vec2 e0 = vec2(cos(v_arc.x) * v_rad.x, sin(v_arc.x) * v_rad.y);\n"
            + "            vec2 e1 = vec2(cos(a_end) * v_rad.x, sin(a_end) * v_rad.y);\n"
            + "            sd = min(length(v_epos - e0), length(v_epos - e1)) - v_arc.z;\n"
            + "        }\n"
            + "    }\n"
            + "    float cov = clamp(0.5 - sd, 0.0, 1.0);\n"
            + "    if (cov <= 0.0) discard;\n"
            + "    if (uPickMode != 0) {\n"
            + "        if (v_id <= 0.5) discard;\n"
            + "        o_color = encode_id(v_id);\n"
            + "        return;\n"
            + "    }\n"
            + "    o_color = vec4(v_color.rgb, v_color.a * cov);\n"
            + "}\n";
    }

    // 4. 2D 保留式三角化多边形填充与工程 Hatch 剖面线（pos2 + color4 + meta2: entity_id, hatch_mode）
    public static string VsFill2D() {
        return "uniform vec2 uViewport;\n"
            + "uniform vec2 uRteOffset;\n"
            + "uniform vec3 uCam;\n"
            + "layout(location = 0) in vec2 a_pos;\n"
            + "layout(location = 1) in vec4 a_color;\n"
            + "layout(location = 2) in vec2 a_meta;\n"
            + "out vec4 v_color;\n"
            + "out vec2 v_world;\n"
            + "flat out vec2 v_meta;\n"
            + "void main() {\n"
            + "    vec2 p = a_pos + uRteOffset;\n"
            + "    vec2 r = vec2(p.x * uCam.y - p.y * uCam.z, p.x * uCam.z + p.y * uCam.y);\n"
            + "    vec2 sp = vec2(uViewport.x * 0.5 + r.x * uCam.x, uViewport.y * 0.5 - r.y * uCam.x);\n"
            + "    v_color = a_color;\n"
            + "    v_world = sp;\n"
            + "    v_meta = a_meta;\n"
            + "    vec2 ndc = vec2(sp.x / uViewport.x * 2.0 - 1.0, 1.0 - sp.y / uViewport.y * 2.0);\n"
            + "    gl_Position = vec4(ndc, 0.0, 1.0);\n"
            + "}\n";
    }

    public static string FsFill2D() {
        return "uniform vec2 uViewport;\n"
            + "uniform vec4 uClip;\n"
            + "uniform int uPickMode;\n"
            + "in vec4 v_color;\n"
            + "in vec2 v_world;\n"
            + "flat in vec2 v_meta;\n"
            + "out vec4 o_color;\n"
            + "vec4 encode_id(float idf) {\n"
            + "    int id = int(idf + 0.5);\n"
            + "    return vec4(float(id & 255) / 255.0,\n"
            + "                float((id >> 8) & 255) / 255.0,\n"
            + "                float((id >> 16) & 255) / 255.0, 1.0);\n"
            + "}\n"
            + "void main() {\n"
            + "    vec2 p = vec2(gl_FragCoord.x, uViewport.y - gl_FragCoord.y);\n"
            + "    if (p.x < uClip.x || p.y < uClip.y || p.x >= uClip.z || p.y >= uClip.w) discard;\n"
            + "    if (uPickMode != 0) {\n"
            + "        if (v_meta.x <= 0.5) discard;\n"
            + "        o_color = encode_id(v_meta.x);\n"
            + "        return;\n"
            + "    }\n"
            + "    int hmode = int(v_meta.y + 0.5);\n"
            + "    float alpha = v_color.a;\n"
            + "    if (hmode > 0) {\n"
            + "        float step_px = 10.0;\n"
            + "        float d = 100.0;\n"
            + "        if (hmode == 1 || hmode == 3) { float m = mod(v_world.x + v_world.y, step_px); d = min(d, min(m, step_px - m)); }\n"
            + "        if (hmode == 2 || hmode == 3) { float m = mod(v_world.x - v_world.y, step_px); d = min(d, min(m, step_px - m)); }\n"
            + "        if (hmode == 4) { float m = mod(v_world.y, step_px); d = min(d, min(m, step_px - m)); }\n"
            + "        if (hmode == 5) { float m = mod(v_world.x, step_px); d = min(d, min(m, step_px - m)); }\n"
            + "        float line = clamp(1.1 - d, 0.0, 1.0);\n"
            + "        if (line <= 0.01) discard;\n"
            + "        alpha *= line;\n"
            + "    }\n"
            + "    o_color = vec4(v_color.rgb, alpha);\n"
            + "}\n";
    }

    // 5. 3D CAD B-Rep 实体着色器（32 位索引、工业三点光照、双面法线翻转、6 实时剖切面、选中高亮、拾取 ID）
    public static string VsSolid3D() {
        return "uniform mat4 uMvp;\n"
            + "uniform mat4 uModel;\n"
            + "layout(location = 0) in vec3 a_pos;\n"
            + "layout(location = 1) in vec3 a_normal;\n"
            + "layout(location = 2) in vec4 a_color;\n"
            + "out vec3 v_world;\n"
            + "out vec3 v_normal;\n"
            + "out vec4 v_color;\n"
            + "void main() {\n"
            + "    vec4 wp = uModel * vec4(a_pos, 1.0);\n"
            + "    v_world = wp.xyz;\n"
            + "    v_normal = mat3(uModel) * a_normal;\n"
            + "    v_color = a_color;\n"
            + "    gl_Position = uMvp * vec4(a_pos, 1.0);\n"
            + "}\n";
    }

    public static string FsSolid3D() {
        return "uniform vec4 uTint;\n"
            + "uniform vec4 uClipPlanes[6];\n"
            + "uniform int uClipCount;\n"
            + "uniform int uFlags;\n"
            + "uniform int uPickMode;\n"
            + "uniform int uEntityId;\n"
            + "in vec3 v_world;\n"
            + "in vec3 v_normal;\n"
            + "in vec4 v_color;\n"
            + "out vec4 o_color;\n"
            + "void main() {\n"
            + "    for (int i = 0; i < 6; i++) {\n"
            + "        if (i >= uClipCount) break;\n"
            + "        if (dot(v_world, uClipPlanes[i].xyz) + uClipPlanes[i].w < 0.0) discard;\n"
            + "    }\n"
            + "    if (uPickMode != 0) {\n"
            + "        if (uEntityId <= 0) discard;\n"
            + "        o_color = vec4(float(uEntityId & 255) / 255.0,\n"
            + "                       float((uEntityId >> 8) & 255) / 255.0,\n"
            + "                       float((uEntityId >> 16) & 255) / 255.0, 1.0);\n"
            + "        return;\n"
            + "    }\n"
            + "    vec3 n = normalize(v_normal);\n"
            + "    if (!gl_FrontFacing) n = -n;\n"
            + "    vec3 l_key = normalize(vec3(0.45, 0.78, 0.55));\n"
            + "    vec3 l_fill = normalize(vec3(-0.65, 0.35, -0.45));\n"
            + "    vec3 l_rim = normalize(vec3(0.0, -0.5, -0.85));\n"
            + "    float d_key = max(dot(n, l_key), 0.0) * 0.55 + (dot(n, l_key) * 0.5 + 0.5) * 0.15;\n"
            + "    float d_fill = max(dot(n, l_fill), 0.0) * 0.22;\n"
            + "    float d_rim = max(dot(n, l_rim), 0.0) * 0.12;\n"
            + "    float shade = clamp(0.24 + d_key + d_fill + d_rim, 0.15, 1.12);\n"
            + "    vec3 base = v_color.rgb * uTint.rgb;\n"
            + "    vec3 rgb = base * shade;\n"
            + "    if ((uFlags & 4) != 0) rgb = mix(rgb, vec3(1.0, 0.62, 0.12), 0.42);\n"
            + "    float alpha = v_color.a * uTint.a;\n"
            + "    if ((uFlags & 8) != 0) alpha *= 0.35;\n"
            + "    o_color = vec4(clamp(rgb, 0.0, 1.0), alpha);\n"
            + "}\n";
    }

    // 6. 3D CAD 拓扑锐边 / 线框着色器（支持 6 实时剖切面、选中高亮与拾取 ID）
    public static string VsEdge3D() {
        return "uniform mat4 uMvp;\n"
            + "uniform mat4 uModel;\n"
            + "layout(location = 0) in vec3 a_pos;\n"
            + "layout(location = 1) in vec4 a_color;\n"
            + "out vec3 v_world;\n"
            + "out vec4 v_color;\n"
            + "void main() {\n"
            + "    vec4 wp = uModel * vec4(a_pos, 1.0);\n"
            + "    v_world = wp.xyz;\n"
            + "    v_color = a_color;\n"
            + "    gl_Position = uMvp * vec4(a_pos, 1.0);\n"
            + "}\n";
    }

    public static string FsEdge3D() {
        return "uniform vec4 uEdgeColor;\n"
            + "uniform vec4 uClipPlanes[6];\n"
            + "uniform int uClipCount;\n"
            + "uniform int uFlags;\n"
            + "uniform int uPickMode;\n"
            + "uniform int uEntityId;\n"
            + "in vec3 v_world;\n"
            + "in vec4 v_color;\n"
            + "out vec4 o_color;\n"
            + "void main() {\n"
            + "    for (int i = 0; i < 6; i++) {\n"
            + "        if (i >= uClipCount) break;\n"
            + "        if (dot(v_world, uClipPlanes[i].xyz) + uClipPlanes[i].w < 0.0) discard;\n"
            + "    }\n"
            + "    if (uPickMode != 0) {\n"
            + "        if (uEntityId <= 0) discard;\n"
            + "        o_color = vec4(float(uEntityId & 255) / 255.0,\n"
            + "                       float((uEntityId >> 8) & 255) / 255.0,\n"
            + "                       float((uEntityId >> 16) & 255) / 255.0, 1.0);\n"
            + "        return;\n"
            + "    }\n"
            + "    vec4 c = vec4(v_color.rgb * uEdgeColor.rgb, v_color.a * uEdgeColor.a);\n"
            + "    if ((uFlags & 4) != 0) c.rgb = vec3(1.0, 0.72, 0.15);\n"
            + "    o_color = c;\n"
            + "}\n";
    }
}
