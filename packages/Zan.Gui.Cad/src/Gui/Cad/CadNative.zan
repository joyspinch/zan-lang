using System;

namespace Gui.Cad;

internal static class CadNative {
    [DllImport("zan_gui")]
    internal static extern int zan_gui_cad_is_gpu(int surfaceId);

    [DllImport("zan_gui")]
    internal static extern int zan_gui_cad_max_samples();

    [DllImport("zan_gui")]
    internal static extern int zan_gui_cad_layer2d_create();

    [DllImport("zan_gui")]
    internal static extern void zan_gui_cad_layer2d_destroy(int layerId);

    [DllImport("zan_gui")]
    internal static extern void zan_gui_cad_layer2d_set_origin(int layerId, double ox, double oy);

    [DllImport("zan_gui")]
    internal static extern int zan_gui_cad_layer2d_upload_lines(int layerId, nint data, int count);

    [DllImport("zan_gui")]
    internal static extern int zan_gui_cad_layer2d_upload_arcs(int layerId, nint data, int count);

    [DllImport("zan_gui")]
    internal static extern int zan_gui_cad_layer2d_upload_fills(int layerId, nint verts, int vcount, nint indices, int icount);

    [DllImport("zan_gui")]
    internal static extern void zan_gui_cad_layer2d_draw(int surfaceId, int layerId, double camX, double camY, double zoom, double rotRad);

    [DllImport("zan_gui")]
    internal static extern void zan_gui_cad_draw_grid2d(
        int surfaceId, double camX, double camY, double zoom,
        double minorWorldStep, int majorEvery,
        int bgArgb, int minorArgb, int majorArgb, int axisXArgb, int axisYArgb);

    [DllImport("zan_gui")]
    internal static extern int zan_gui_cad_mesh3d_create();

    [DllImport("zan_gui")]
    internal static extern void zan_gui_cad_mesh3d_destroy(int meshId);

    [DllImport("zan_gui")]
    internal static extern int zan_gui_cad_mesh3d_upload_faces(int meshId, nint verts, int vcount, nint indices, int icount);

    [DllImport("zan_gui")]
    internal static extern int zan_gui_cad_mesh3d_upload_edges(int meshId, nint verts, int vcount, nint indices, int icount);

    [DllImport("zan_gui")]
    internal static extern int zan_gui_cad_3d_begin(
        int surfaceId, int x, int y, int w, int h,
        int clearArgb, int msaaSamples, nint viewProj16);

    [DllImport("zan_gui")]
    internal static extern void zan_gui_cad_3d_set_clip_planes(nint planes4f, int count);

    [DllImport("zan_gui")]
    internal static extern void zan_gui_cad_3d_draw_mesh(
        int meshId, nint model16, int faceTintArgb, int edgeArgb, int flags, int entityId);

    [DllImport("zan_gui")]
    internal static extern void zan_gui_cad_3d_end(int surfaceId);

    [DllImport("zan_gui")]
    internal static extern int zan_gui_cad_pick_begin(int surfaceId, int px, int py, int radiusPx);

    [DllImport("zan_gui")]
    internal static extern void zan_gui_cad_pick_layer2d(int layerId, double camX, double camY, double zoom, double rotRad);

    [DllImport("zan_gui")]
    internal static extern void zan_gui_cad_pick_3d_begin(int vx, int vy, int vw, int vh, nint viewProj16);

    [DllImport("zan_gui")]
    internal static extern void zan_gui_cad_pick_mesh3d(int meshId, nint model16, int entityId);

    [DllImport("zan_gui")]
    internal static extern int zan_gui_cad_pick_end();
}
