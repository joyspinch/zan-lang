using System;
using Gui.Cad.Gpu;

namespace Gui.Cad;

// 纯 Zan CAD 渲染入口转发层（零 zan_gui_cad_* C 依赖，经通用 zan_gui_gpu_* 帧契约直驱 GL 3.3 / GLES 3.0 / WebGL 2.0 + CPU 回退）
internal static class CadNative {
    internal static int zan_gui_cad_is_gpu(int surfaceId) {
        return CadGpuEngine.IsGpu(surfaceId);
    }

    internal static int zan_gui_cad_max_samples() {
        return CadGpuEngine.MaxSamples();
    }

    internal static int zan_gui_cad_layer2d_create() {
        return CadGpuEngine.Layer2DCreate();
    }

    internal static void zan_gui_cad_layer2d_destroy(int layerId) {
        CadGpuEngine.Layer2DDestroy(layerId);
    }

    internal static void zan_gui_cad_layer2d_set_origin(int layerId, double ox, double oy) {
        CadGpuEngine.Layer2DSetOrigin(layerId, ox, oy);
    }

    internal static int zan_gui_cad_layer2d_upload_lines(int layerId, nint data, int count) {
        return CadGpuEngine.Layer2DUploadLines(layerId, data, count);
    }

    internal static int zan_gui_cad_layer2d_upload_arcs(int layerId, nint data, int count) {
        return CadGpuEngine.Layer2DUploadArcs(layerId, data, count);
    }

    internal static int zan_gui_cad_layer2d_upload_fills(int layerId, nint verts, int vcount, nint indices, int icount) {
        return CadGpuEngine.Layer2DUploadFills(layerId, verts, vcount, indices, icount);
    }

    internal static void zan_gui_cad_layer2d_draw(int surfaceId, int layerId, double camX, double camY, double zoom, double rotRad) {
        CadGpuEngine.Layer2DDraw(surfaceId, layerId, camX, camY, zoom, rotRad);
    }

    internal static void zan_gui_cad_draw_grid2d(
        int surfaceId, double camX, double camY, double zoom,
        double minorWorldStep, int majorEvery,
        int bgArgb, int minorArgb, int majorArgb, int axisXArgb, int axisYArgb) {
        CadGpuEngine.DrawGrid2D(
            surfaceId, camX, camY, zoom,
            minorWorldStep, majorEvery,
            bgArgb, minorArgb, majorArgb, axisXArgb, axisYArgb);
    }

    internal static int zan_gui_cad_mesh3d_create() {
        return CadGpuEngine.Mesh3DCreate();
    }

    internal static void zan_gui_cad_mesh3d_destroy(int meshId) {
        CadGpuEngine.Mesh3DDestroy(meshId);
    }

    internal static int zan_gui_cad_mesh3d_upload_faces(int meshId, nint verts, int vcount, nint indices, int icount) {
        return CadGpuEngine.Mesh3DUploadFaces(meshId, verts, vcount, indices, icount);
    }

    internal static int zan_gui_cad_mesh3d_upload_edges(int meshId, nint verts, int vcount, nint indices, int icount) {
        return CadGpuEngine.Mesh3DUploadEdges(meshId, verts, vcount, indices, icount);
    }

    internal static int zan_gui_cad_3d_begin(
        int surfaceId, int x, int y, int w, int h,
        int clearArgb, int msaaSamples, nint viewProj16) {
        return CadGpuEngine.Begin3D(
            surfaceId, x, y, w, h, clearArgb, msaaSamples, viewProj16);
    }

    internal static void zan_gui_cad_3d_set_clip_planes(nint planes4f, int count) {
        CadGpuEngine.SetClipPlanes3D(planes4f, count);
    }

    internal static void zan_gui_cad_3d_draw_mesh(
        int meshId, nint model16, int faceTintArgb, int edgeArgb, int flags, int entityId) {
        CadGpuEngine.DrawMesh3D(meshId, model16, faceTintArgb, edgeArgb, flags, entityId);
    }

    internal static void zan_gui_cad_3d_end(int surfaceId) {
        CadGpuEngine.End3D(surfaceId);
    }

    internal static int zan_gui_cad_pick_begin(int surfaceId, int px, int py, int radiusPx) {
        return CadGpuEngine.PickBegin(surfaceId, px, py, radiusPx);
    }

    internal static void zan_gui_cad_pick_layer2d(int layerId, double camX, double camY, double zoom, double rotRad) {
        CadGpuEngine.PickLayer2D(layerId, camX, camY, zoom, rotRad);
    }

    internal static void zan_gui_cad_pick_3d_begin(int vx, int vy, int vw, int vh, nint viewProj16) {
        CadGpuEngine.PickBegin3D(vx, vy, vw, vh, viewProj16);
    }

    internal static void zan_gui_cad_pick_mesh3d(int meshId, nint model16, int entityId) {
        CadGpuEngine.PickMesh3D(meshId, model16, entityId);
    }

    internal static int zan_gui_cad_pick_end() {
        return CadGpuEngine.PickEnd();
    }
}
