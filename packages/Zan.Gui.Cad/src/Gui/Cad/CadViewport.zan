using System;

namespace Gui.Cad;

public static class CadViewport {
    private static nint scratchVpMat;
    private static nint scratchClipBuf;

    private static nint EnsureVpMat() {
        if (CadViewport.scratchVpMat == 0) {
            CadViewport.scratchVpMat = NativeMemory.Alloc(64);
        }
        return CadViewport.scratchVpMat;
    }

    private static nint EnsureClipBuf() {
        if (CadViewport.scratchClipBuf == 0) {
            CadViewport.scratchClipBuf = NativeMemory.Alloc(6 * 4 * 4);
        }
        return CadViewport.scratchClipBuf;
    }

    public static bool IsGpuAccelerated(int surfaceId) {
        return CadNative.zan_gui_cad_is_gpu(surfaceId) != 0;
    }

    public static int MaxMsaaSamples() {
        return CadNative.zan_gui_cad_max_samples();
    }

    public static void DrawGrid2D(
        int surfaceId, CadCamera2D cam, double minorWorldStep, int majorEvery,
        int bgArgb, int minorArgb, int majorArgb, int axisXArgb, int axisYArgb) {
        CadNative.zan_gui_cad_draw_grid2d(
            surfaceId, cam.CenterX, cam.CenterY, cam.Zoom,
            minorWorldStep, majorEvery,
            bgArgb, minorArgb, majorArgb, axisXArgb, axisYArgb);
    }

    public static bool Begin3D(
        int surfaceId, int x, int y, int w, int h,
        int clearArgb, int msaaSamples, CadCamera3D cam) {
        nint vp = CadViewport.EnsureVpMat();
        cam.BuildViewProj(w, h, vp);
        return CadNative.zan_gui_cad_3d_begin(
            surfaceId, x, y, w, h, clearArgb, msaaSamples, vp) != 0;
    }

    public static void ClearClipPlanes() {
        CadNative.zan_gui_cad_3d_set_clip_planes(0, 0);
    }

    public static void SetClipPlane(float nx, float ny, float nz, float d) {
        nint buf = CadViewport.EnsureClipBuf();
        Span<float> p = new Span<float>(buf, 4);
        p[0] = nx; p[1] = ny; p[2] = nz; p[3] = d;
        CadNative.zan_gui_cad_3d_set_clip_planes(buf, 1);
    }

    public static void SetClipPlanes(nint planes4f, int count) {
        CadNative.zan_gui_cad_3d_set_clip_planes(planes4f, count);
    }

    public static void DrawMesh3D(
        CadMesh3D mesh, nint modelMat16, int faceTintArgb, int edgeArgb, int flags, int entityId) {
        int h = mesh.Handle();
        if (h <= 0) { return; }
        mesh.Upload();
        CadNative.zan_gui_cad_3d_draw_mesh(h, modelMat16, faceTintArgb, edgeArgb, flags, entityId);
    }

    public static void End3D(int surfaceId) {
        CadNative.zan_gui_cad_3d_end(surfaceId);
    }

    public static bool PickBegin(int surfaceId, int px, int py, int radiusPx) {
        return CadNative.zan_gui_cad_pick_begin(surfaceId, px, py, radiusPx) != 0;
    }

    public static void PickLayer2D(CadLayer2D layer, CadCamera2D cam) {
        int h = layer.Handle();
        if (h <= 0) { return; }
        layer.Upload();
        CadNative.zan_gui_cad_pick_layer2d(h, cam.CenterX, cam.CenterY, cam.Zoom, cam.RotationRad);
    }

    public static void PickBegin3D(int vx, int vy, int vw, int vh, CadCamera3D cam) {
        nint vp = CadViewport.EnsureVpMat();
        cam.BuildViewProj(vw, vh, vp);
        CadNative.zan_gui_cad_pick_3d_begin(vx, vy, vw, vh, vp);
    }

    public static void PickMesh3D(CadMesh3D mesh, nint modelMat16, int entityId) {
        int h = mesh.Handle();
        if (h <= 0) { return; }
        mesh.Upload();
        CadNative.zan_gui_cad_pick_mesh3d(h, modelMat16, entityId);
    }

    public static int PickEnd() {
        return CadNative.zan_gui_cad_pick_end();
    }
}
