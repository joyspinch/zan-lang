using System;
using Gui;
using Gui.Cad;

namespace Gui.Cad.CanvasBridge;

public static class CadCanvas {
    public static bool IsGpuAccelerated(Canvas canvas) {
        return CadViewport.IsGpuAccelerated(canvas.SurfaceId());
    }

    public static void DrawGrid2D(
        Canvas canvas, CadCamera2D cam, double minorWorldStep, int majorEvery,
        int bgArgb, int minorArgb, int majorArgb, int axisXArgb, int axisYArgb) {
        CadViewport.DrawGrid2D(
            canvas.SurfaceId(), cam, minorWorldStep, majorEvery,
            bgArgb, minorArgb, majorArgb, axisXArgb, axisYArgb);
    }

    public static void DrawLayer2D(Canvas canvas, CadLayer2D layer, CadCamera2D cam) {
        layer.Draw(canvas.SurfaceId(), cam);
    }

    public static bool Begin3D(
        Canvas canvas, int x, int y, int w, int h,
        int clearArgb, int msaaSamples, CadCamera3D cam) {
        return CadViewport.Begin3D(canvas.SurfaceId(), x, y, w, h, clearArgb, msaaSamples, cam);
    }

    public static void End3D(Canvas canvas) {
        CadViewport.End3D(canvas.SurfaceId());
    }

    public static bool PickBegin(Canvas canvas, int px, int py, int radiusPx) {
        return CadViewport.PickBegin(canvas.SurfaceId(), px, py, radiusPx);
    }
}
