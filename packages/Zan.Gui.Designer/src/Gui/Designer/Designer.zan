    // 把字段 extra["props"] 直通表落到真控件上（画布预览用）：
    // 预览件每帧新建，逐键 SetProp；控件不认的键走基类 fallback
    // 退化为样式类，无副作用。
    static void ApplyFieldProps(Control ctl, FormField f) {
        if (ctl == null || f.extra == null) { return; }
        JsonValue props = f.extra.Get("props");
        if (props == null || !props.IsObject()) { return; }
        for (int i = 0; i < props.Count(); i = i + 1) {
            ctl.SetProp(props.KeyAt(i), props.ValAt(i).AsString(""));
        }
    }

    // 预览树上应用组件属性：与运行期注册表（UserComponentRegistry.
    // ApplyProps）共用同一语义——实例值优先，缺省取声明里的 def，
    // 落到目标控件（预览树按组件文档原名查找）。实例值存
    // f.extra 的 "props" 直通对象。
    void ApplyCompProps(Control root, JsonValue compRoot, FormField f) {
        JsonValue inst = f.extra == null ? null : f.extra.Get("props");
        UserComponentRegistry.ApplyProps(root, compRoot, inst);
    }

    // 引用节点画布预览的构建缓存：组件文档只在代次变化时
    // 重建（SetUserComponents / 尺寸变化 / 实例属性变化），
    // 其余帧复用整棵 FormBuilder 树只重渲染。找不到组件或
    // 解析失败返回 null，调用方退回占位块。新构建的树按声明
    // 接线预览分发，缓存命中直接复用已接线的树。
    Control PvCompCtl(App app, FormField f, int w, int h) {
        if (f.customKind == "") { return null; }
        string doc = this.UserCompJson(f.customKind);
        if (doc == "") { return null; }
        string instFp = "";
        if (f.extra != null) {
            JsonValue ip = f.extra.Get("props");
            if (ip != null) { instFp = ip.PrettyToJson(); }
        }
        string key = Convert.ToString(pvCompGen) + "|" + f.customKind
            + "|" + Convert.ToString(w) + "x" + Convert.ToString(h)
            + "|" + instFp;
        for (int i = 0; i < pvCompCache.Count; i = i + 1) {
            if (pvCompCache[i].key == key) { return pvCompCache[i].control; }
        }
        JsonValue root = JsonValue.ParseLenient(doc);
        if (root == null) { return null; }
        Control ctl = FormBuilder.Build(root);
        this.ApplyCompProps(ctl, root, f);
        this.ApplyPreviewFormSize(ctl, root.Int("formSize", 1));
        this.WirePreviewEvents(app, ctl);
        // 宿主设计稿在引用节点上声明的 on<Event>：组件文档里没有，
        // 单独绑到树的根控件（运行期 WireNode 解析的就是这批）。
        for (int i = 0; i < f.events.Count; i = i + 1) {
            string fe = f.events[i].key;
            string fh = f.events[i].val;
            if (fe == "" || fh == "") { continue; }
            ctl.BindEventS(fe, (Control s) => { this.PvFlash(app, fe, fh, s); });
        }
        pvCompCache.Add(new PreviewControlCache(key, ctl));
        if (pvCompCache.Count > 64) {
            pvCompCache.Clear();
        }
        return ctl;
    }

    // 给预览真控件树按声明绑定分发反馈：ChildWindow.
    // WireNode 的设计器版——处理器名没有注册表可解析，改成状态条
    // 闪现反馈。基类 FireCommon 只给有订阅的控件注册命中区
    // （`!On.Any()` 即返回），所以绑定本身就让"点了没反应"的
    // 声明控件变成可点的活预览。闭包按迭代捕获，
    // 循环内绑定各拿各的 evt/hn。
    void WirePreviewEvents(App app, Control root) {
        if (root == null) { return; }
        for (int i = 0; i < root.events.Count; i = i + 1) {
            string evt = root.events[i].key;
            string hn = root.events[i].val;
            if (evt == "" || hn == "") { continue; }
            root.BindEventS(evt, (Control s) => { this.PvFlash(app, evt, hn, s); });
        }
        for (int j = 0; j < root.children.Count; j = j + 1) {
            this.WirePreviewEvents(app, root.children[j]);
        }
    }

    // 预览态事件分发反馈：状态条闪现 "事件 → 处理器名"，sender
    // 非空时附控件种类。预览里声明的处理器没有真身可调，这条
    // 反馈本身就是"这里会触发"的所见即所得。
    void PvFlash(App app, string evt, string hname, Control sender) {
        string who = "";
        if (sender != null) { who = " · " + sender.Kind(); }
        msg = Designer.T("preview ", "预览 ") + evt + " → " + hname + who;
        if (app != null) { app.RequestRedraw(); }
    }

    // 添加运行期注册（HeavyControls）的自定义组件
    // 到表单/活动容器，与内置组件的 AddField 对应。
    void AddCustomField(string kind) {
        this.DropDeadRefs();
        FormField f = FormField.NewCustom(kind, seq);
        seq = seq + 1;
        if (activeContainer != null) {
            f.childTab = 0;
            if (activeContainer.kind == "Tabs") {
                f.childTab = Designer.TabActivePage(activeContainer);
            }
            activeContainer.kids.Add(f);
        } else {
            fields.Add(f);
        }
        sel = f;
        inspTab = 0;
        msg = Designer.T("added ", "已添加 ") + kind;
    }

    // 当 `inner` 位于 `owner` 子树的任意位置时返回 true。
    bool InSubtree(FormField owner, FormField inner) {
        if (ContainsRef(owner.kids, inner)) { return true; }
        for (int i = 0; i < owner.kids.Count; i = i + 1) {
            if (InSubtree(owner.kids[i], inner)) { return true; }
        }
        return false;
    }

    // 列表中是否含该组件引用。
    bool ContainsRef(List<FormField> lst, FormField target) {
        for (int i = 0; i < lst.Count; i = i + 1) {
            if (lst[i] == target) { return true; }
        }
        return false;
    }

    // 组件在列表中的下标，不存在时 -1。
    int IndexIn(List<FormField> lst, FormField f) {
        for (int i = 0; i < lst.Count; i = i + 1) {
            if (lst[i] == f) { return i; }
        }
        return -1;
    }

    // 把 `target` 作为子级的容器；若 target 是
    // 顶层字段（或未找到）则返回 null。递归查找。
    FormField ParentContainerOf(FormField target) {
        if (ContainsRef(fields, target)) { return null; }
        return FindOwner(fields, target);
    }

    // 递归查找把 target 作为直接子级的容器，找不到返回 null。
    FormField FindOwner(List<FormField> lst, FormField target) {
        for (int i = 0; i < lst.Count; i = i + 1) {
            FormField f = lst[i];
            if (ContainsRef(f.kids, target)) { return f; }
            FormField r = FindOwner(f.kids, target);
            if (r != null) { return r; }
        }
        return null;
    }

    // 重建不含 `target` 的 `lst`（列表中间位置的 RemoveAt 在其他地方使用，
    // 但重建与下方的 Insert 规避方案保持一致）。
    List<FormField> ListRemove(List<FormField> lst, FormField target) {
        List<FormField> nl = new List<FormField>();
        for (int i = 0; i < lst.Count; i = i + 1) {
            if (lst[i] != target) { nl.Add(lst[i]); }
        }
        return nl;
    }

    // 把 `from` 处的元素移动到 `to`，通过 Add 重建（
    // 运行时在列表中间 Insert 会溢出缓冲区并破坏堆）。
    List<FormField> ListMove(List<FormField> lst, int from, int to) {
        if (from < 0 || from >= lst.Count) { return lst; }
        FormField mv = lst[from];
        List<FormField> rest = new List<FormField>();
        int i = 0;
        for (; i < lst.Count; i = i + 1) {
            if (i != from) { rest.Add(lst[i]); }
        }
        if (to < 0) { to = 0; }
        if (to > rest.Count) { to = rest.Count; }
        List<FormField> nl = new List<FormField>();
        i = 0;
        while (i < rest.Count) {
            if (i == to) { nl.Add(mv); }
            nl.Add(rest[i]);
            i = i + 1;
        }
        if (to >= rest.Count) { nl.Add(mv); }
        return nl;
    }

    // 把选中项在同级列表内上/下移动 delta 个位置（先压撤销栈）。
    void MoveSel(int delta) {
        if (sel == null) { return; }
        this.PushUndo();
        FormField pc = ParentContainerOf(sel);
        if (pc == null) {
            int idx = IndexIn(fields, sel);
            if (idx < 0) { return; }
            int to = idx + delta;
            if (to < 0) { to = 0; }
            if (to >= fields.Count) { to = fields.Count - 1; }
            if (to != idx) {
                List<FormField> moved = ListMove(fields, idx, to);
                this.ReorderDesignContent(null, fields, moved);
                fields = moved;
            }
        } else {
            int idx = IndexIn(pc.kids, sel);
            if (idx < 0) { return; }
            int to = idx + delta;
            if (to < 0) { to = 0; }
            if (to >= pc.kids.Count) { to = pc.kids.Count - 1; }
            if (to != idx) {
                List<FormField> moved = ListMove(pc.kids, idx, to);
                this.ReorderDesignContent(pc, pc.kids, moved);
                pc.kids = moved;
            }
        }
    }

    // 插入 `nf`，使其最终位于顶层列表的 `at` 索引处。
    void InsertFieldAt(int at, FormField nf) {
        if (at < 0) { at = 0; }
        if (at > fields.Count) { at = fields.Count; }
        List<FormField> nl = new List<FormField>();
        for (int i = 0; i < fields.Count; i = i + 1) {
            if (i == at) { nl.Add(nf); }
            nl.Add(fields[i]);
        }
        if (at >= fields.Count) { nl.Add(nf); }
        fields = nl;
    }

    // 组件是否在多选里（主选中项或附加项）。
    bool IsExtraSel(FormField f) {
        for (int i = 0; i < freeExtra.Count; i = i + 1) {
            if (freeExtra[i] == f) { return true; }
        }
        return false;
    }

    // 把组件加入/移出多选的附加选中项（Ctrl+点击）。
    void ToggleExtraSel(FormField f) {
        List<FormField> keep = new List<FormField>();
        bool found = false;
        for (int i = 0; i < freeExtra.Count; i = i + 1) {
            if (freeExtra[i] == f) { found = true; }
            else { keep.Add(freeExtra[i]); }
        }
        if (!found) { keep.Add(f); }
        freeExtra = keep;
    }

    // 清空多选的附加选中项。
    void ClearExtraSel() { freeExtra = new List<FormField>(); }

    // 全选当前画布所有组件
    void SelectAll() {
        if (fields == null || fields.Count == 0) { return; }
        sel = fields[0];
        freeExtra = new List<FormField>();
        for (int i = 1; i < fields.Count; i = i + 1) {
            freeExtra.Add(fields[i]);
        }
        msg = Designer.T("selected all components (", "已全选组件 (")
            + Convert.ToString(fields.Count) + ")";
    }

    // 全选当前设计中所有与当前选中项同类型的组件（支持跨容器多层遍历）
    void SelectAllOfSameType() {
        if (sel == null) { return; }
        int targetType = sel.ftype;
        string targetCustom = sel.customKind;
        List<FormField> matches = new List<FormField>();
        this.CollectSameTypeFields(fields, targetType, targetCustom, matches);
        if (matches.Count <= 1) {
            msg = Designer.T("No more components of type: ", "未找到更多同类组件: ") + FormField.TypeName(targetType);
            return;
        }
        ClearExtraSel();
        sel = matches[0];
        for (int i = 1; i < matches.Count; i = i + 1) {
            freeExtra.Add(matches[i]);
        }
        this.SyncFreeSelBase();
        msg = Designer.T("Selected all ", "已全选所有 ") + FormField.TypeName(targetType)
            + " (" + Convert.ToString(matches.Count) + ")";
        if (this.hostApp != null) { this.hostApp.RequestRedraw(); }
    }

    void CollectSameTypeFields(List<FormField> list, int ft, string custom, List<FormField> outMatches) {
        if (list == null) { return; }
        for (int i = 0; i < list.Count; i = i + 1) {
            FormField f = list[i];
            if (f != null && !f.locked) {
                if (f.ftype == ft && (ft != 100 || f.customKind == custom)) {
                    outMatches.Add(f);
                }
                if (f.kids != null && f.kids.Count > 0) {
                    this.CollectSameTypeFields(f.kids, ft, custom, outMatches);
                }
            }
        }
    }

    // 把多选里其余成员的宽/高设成主选中项的（0=等宽，1=等高，2=等宽且等高），
    // 自动解除旧约束并持久化至设计文档。
    void SizeSelGroup(int mode) {
        if (sel == null || freeExtra.Count == 0) { return; }
        this.PushUndo();
        int baseW = sel.LayoutW();
        int baseH = sel.LayoutH();
        for (int i = 0; i < freeExtra.Count; i = i + 1) {
            FormField f = freeExtra[i];
            if (f == null || f.locked) { continue; }
            this.DesignMakeFloat(f);
            if (mode == 0 || mode == 2) {
                if (!f.IsFullWidthBanner() && !f.IsFixedWidth()) {
                    int minW = FormField.MinSafeWOf(f.ftype);
                    int w = baseW;
                    if (w < minW) { w = minW; }
                    f.fw = w;
                }
            }
            if (mode == 1 || mode == 2) {
                if (!f.IsFixedHeight()) {
                    int minH = FormField.MinSafeHOf(f.ftype);
                    int h = baseH;
                    if (h < minH) { h = minH; }
                    f.fh = h;
                }
            }
            this.DesignDeclareRect(f);
        }
        if (mode == 0) { msg = Designer.T("matched width", "已统一宽度"); }
        else if (mode == 1) { msg = Designer.T("matched height", "已统一高度"); }
        else { msg = Designer.T("matched size", "已统一宽高"); }
        this.MarkDocDirty();
    }

    // 多选批量属性修改：当主选中组件在属性面板被修改时，将通用几何、盒模型与排版定位属性批量同步给其它选中组件
    void SyncBatchProps(FormField primary, string key) {
        if (primary == null || freeExtra == null || freeExtra.Count == 0 || key == "") { return; }
        if (key == "name" || key == "label" || key == "bind" || key == "component") { return; }
        for (int i = 0; i < freeExtra.Count; i = i + 1) {
            FormField f = freeExtra[i];
            if (f == null || f == primary || f.locked) { continue; }
            if (key == "w") {
                if (!f.IsFullWidthBanner()) { f.fw = primary.fw; }
            } else if (key == "h") {
                f.fh = primary.fh;
            } else if (key == "margin") {
                f.margin = primary.margin;
            } else if (key == "padding") {
                f.padding = primary.padding;
            } else if (key == "gap" && FormField.IsContainerOf(f.ftype)) {
                f.gap = primary.gap;
            } else if (key == "flexDir" && FormField.IsContainerOf(f.ftype)) {
                f.flexDir = primary.flexDir;
            } else if (key == "justify" && FormField.IsContainerOf(f.ftype)) {
                f.justify = primary.justify;
            } else if (key == "alignItems" && FormField.IsContainerOf(f.ftype)) {
                f.alignItems = primary.alignItems;
            } else if (key == "flexWrap" && FormField.IsContainerOf(f.ftype)) {
                f.flexWrap = primary.flexWrap;
            } else if (key == "position") {
                f.position = primary.position;
                if (f.position == 1) {
                    f.dockSide = 0;
                    if (f.fw <= 0) { f.fw = f.LayoutW() > 0 ? f.LayoutW() : 120; }
                    if (f.fh <= 0) { f.fh = FormField.DefaultHFor(f.ftype); }
                }
            } else if (key == "dock") {
                f.dockSide = primary.dockSide;
            } else if (key == "flexGrow") {
                f.flexGrow = primary.flexGrow;
            } else if (key == "anchor") {
                f.anchor = primary.anchor;
            } else if (key == "span") {
                f.span = primary.span;
            } else if (key == "required") {
                f.required = primary.required;
            } else if (key == "wrap") {
                f.wrap = primary.wrap;
            } else if (key == "orient") {
                f.tabOrient = primary.tabOrient;
            } else if (key == "disabled") {
                f.disabled = primary.disabled;
            } else if (key == "visible") {
                f.visible = primary.visible;
            } else if (key == "tooltip") {
                f.tooltipText = primary.tooltipText;
            } else if (key == "locked") {
                f.locked = primary.locked;
            }
            this.DesignDeclareRect(f);
        }
        this.MarkDocDirty();
        this.msg = Designer.T("Batch updated: ", "已批量同步属性: ") + key + " (" + Convert.ToString(freeExtra.Count + 1) + ")";
        if (this.hostApp != null) { this.hostApp.RequestRedraw(); }
    }

    // 多选批量操作：一键切换所有选中项锁定状态
    void BatchToggleLock() {
        if (sel == null) { return; }
        this.PushUndoAction(Designer.T("toggle lock", "切换锁定"));
        bool anyUnlocked = !sel.locked;
        for (int i = 0; i < freeExtra.Count; i = i + 1) {
            if (freeExtra[i] != null && !freeExtra[i].locked) { anyUnlocked = true; break; }
        }
        bool targetLocked = anyUnlocked;
        sel.locked = targetLocked;
        for (int i = 0; i < freeExtra.Count; i = i + 1) {
            if (freeExtra[i] != null) { freeExtra[i].locked = targetLocked; }
        }
        this.MarkDocDirty();
        int total = 1 + freeExtra.Count;
        msg = targetLocked ?
            Designer.T("Locked " + Convert.ToString(total) + " items", "已批量锁定 " + Convert.ToString(total) + " 个组件") :
            Designer.T("Unlocked " + Convert.ToString(total) + " items", "已批量解锁 " + Convert.ToString(total) + " 个组件");
        if (this.hostApp != null) { this.hostApp.RequestRedraw(); }
    }

    // 多选批量操作：一键设置所有选中项外边距
    void BatchSetMargins(int val) {
        if (sel == null) { return; }
        this.PushUndoAction(Designer.T("batch margins", "批量外边距"));
        sel.margin = val;
        this.DesignDeclareRect(sel);
        for (int i = 0; i < freeExtra.Count; i = i + 1) {
            FormField f = freeExtra[i];
            if (f != null && !f.locked) {
                f.margin = val;
                this.DesignDeclareRect(f);
            }
        }
        this.MarkDocDirty();
        msg = Designer.T("Batch set margin: ", "已批量设置外边距: ") + Convert.ToString(val) + "px";
        if (this.hostApp != null) { this.hostApp.RequestRedraw(); }
    }

    // 多选批量操作：一键清空所有选中项外边距
    void BatchResetMargins() {
        this.BatchSetMargins(0);
    }

    // 多选批量操作：一键设置所有选中项内边距
    void BatchSetPadding(int val) {
        if (sel == null) { return; }
        this.PushUndoAction(Designer.T("batch padding", "批量内边距"));
        sel.padding = val;
        this.DesignDeclareRect(sel);
        for (int i = 0; i < freeExtra.Count; i = i + 1) {
            FormField f = freeExtra[i];
            if (f != null && !f.locked) {
                f.padding = val;
                this.DesignDeclareRect(f);
            }
        }
        this.MarkDocDirty();
        msg = Designer.T("Batch set padding: ", "已批量设置内边距: ") + Convert.ToString(val) + "px";
        if (this.hostApp != null) { this.hostApp.RequestRedraw(); }
    }

    // 多选批量操作：一键清空所有选中项内边距
    void BatchResetPadding() {
        this.BatchSetPadding(0);
    }

    // 多选批量操作：一键统一设置定位模式（0: 流式 Flow, 1: 浮动 Float）
    void BatchSetPosition(int pos) {
        if (sel == null) { return; }
        this.PushUndoAction(Designer.T("batch position", "批量排版模式"));
        if (pos == 1) { this.DesignMakeFloat(sel); }
        else { sel.position = 0; sel.fx = 0; sel.fy = 0; }
        this.DesignDeclareRect(sel);
        for (int i = 0; i < freeExtra.Count; i = i + 1) {
            FormField f = freeExtra[i];
            if (f != null && !f.locked) {
                if (pos == 1) { this.DesignMakeFloat(f); }
                else { f.position = 0; f.fx = 0; f.fy = 0; }
                this.DesignDeclareRect(f);
            }
        }
        this.MarkDocDirty();
        msg = (pos == 1) ? Designer.T("Set all to Float (Absolute)", "已批量设为浮动定位") : Designer.T("Set all to Flow (Flex)", "已批量设为流式排版");
        if (this.hostApp != null) { this.hostApp.RequestRedraw(); }
    }

    // 多选批量操作：一键将所有选中项设为流式并自动撑满高度 (Fill Remaining Height)
    void BatchFillHeight() {
        if (sel == null) { return; }
        this.PushUndoAction(Designer.T("batch fill height", "批量撑满高度"));
        sel.position = 0;
        sel.flexGrow = 1;
        sel.fh = 0;
        this.DesignDeclareRect(sel);
        for (int i = 0; i < freeExtra.Count; i = i + 1) {
            FormField f = freeExtra[i];
            if (f != null && !f.locked) {
                f.position = 0;
                f.flexGrow = 1;
                f.fh = 0;
                this.DesignDeclareRect(f);
            }
        }
        this.MarkDocDirty();
        int total = 1 + freeExtra.Count;
        msg = Designer.T("Set " + Convert.ToString(total) + " items to Fill Height", "已批量设为自动撑满高度 (" + Convert.ToString(total) + " 项)");
        if (this.hostApp != null) { this.hostApp.RequestRedraw(); }
    }

    // 组件是否具有界面展示文本/标签属性（优先原地编辑显示文字，而非后端变量名）
    static bool HasDisplayText(FormField f) {
        if (f == null) { return false; }
        if (f.label != "") { return true; }
        int ft = f.ftype;
        return ft == 1 || ft == 20 || ft == 15 || ft == 16 || ft == 2 || ft == 3 || ft == 28
            || ft == 39 || ft == 18 || ft == 25 || ft == 7 || ft == 48 || ft == 58 || ft == 59;
    }

    // F2 / 双击 原地快捷编辑：智能区分界面显示文本 (label) 与代码变量名 (fname)
    void StartInlineRename() {
        if (sel == null) { return; }
        inlineRenaming = true;
        inlineRenameFocusNeeded = true;
        bool isText = Designer.HasDisplayText(sel);
        if (inlineRenameInput == null) {
            inlineRenameInput = new Input("");
        }
        string initText = "";
        if (isText) {
            initText = sel.label != "" ? sel.label : FormField.TypeName(sel.ftype);
            inlineRenameInput.hint = Designer.T("Edit Display Text", "编辑显示文本");
            msg = Designer.T("Editing Text (Enter to commit, Esc to cancel)...", "正在编辑显示文本（回车确认，Esc取消）...");
        } else {
            initText = sel.fname;
            inlineRenameInput.hint = Designer.T("Rename Variable", "修改变量名");
            msg = Designer.T("Renaming (Enter to commit, Esc to cancel)...", "正在重命名变量（回车确认，Esc取消）...");
        }
        inlineRenameInput.SetText(initText);
        if (this.hostApp != null) { this.hostApp.RequestRedraw(); }
    }

    void CommitInlineRename() {
        if (!inlineRenaming || sel == null) { inlineRenaming = false; return; }
        string val = StyleSheet.Trim(inlineRenameInput.GetText());
        if (val != "") {
            this.PushUndo();
            if (Designer.HasDisplayText(sel)) {
                sel.label = val;
                this.DesignDeclareRect(sel);
                msg = Designer.T("Text updated: ", "已更新文本: ") + val;
            } else {
                if (val != sel.fname && !this.UsedFieldName(sel, val)) {
                    renamedOldField = sel.fname;
                    renamedNewField = val;
                    sel.fname = val;
                    sel.name = val;
                    msg = Designer.T("Renamed variable: ", "已重命名变量: ") + val;
                }
            }
            this.MarkDocDirty();
        }
        inlineRenaming = false;
        if (this.hostApp != null) { this.hostApp.RequestRedraw(); }
    }

    void CancelInlineRename() {
        inlineRenaming = false;
        msg = Designer.T("Rename cancelled", "已取消重命名");
        if (this.hostApp != null) { this.hostApp.RequestRedraw(); }
    }

    // 把选中项移到同级的最前/最后（1=置顶，0=置底）。
    // 在 Retained GUI 中，列表末尾项最后绘制（处于最上层），列表头部项最先绘制（处于最底层）。
    void SelToEdge(int top) {
        if (sel == null) { return; }
        FormField pc = ParentContainerOf(sel);
        List<FormField> list = fields;
        if (pc != null) { list = pc.kids; }
        int idx = IndexIn(list, sel);
        if (idx < 0) { return; }
        int to = list.Count - 1;
        if (top != 0) { to = 0; }
        if (to == idx) { return; }
        this.PushUndo();
        List<FormField> moved = ListMove(list, idx, to);
        this.ReorderDesignContent(pc, list, moved);
        if (pc == null) { fields = moved; } else { pc.kids = moved; }
    }

    // 复制选中项（支持多选批量创建副本），副本在容器局部坐标偏移 16px 并成为新的选中组。
    void DuplicateSel() {
        if (sel == null) { return; }
        this.PushUndo();
        List<FormField> targets = new List<FormField>();
        targets.Add(sel);
        for (int i = 0; i < freeExtra.Count; i = i + 1) {
            FormField ef = freeExtra[i];
            if (ef != null && ef != sel && !targets.Contains(ef)) {
                targets.Add(ef);
            }
        }
        List<FormField> newCopies = new List<FormField>();
        for (int i = 0; i < targets.Count; i = i + 1) {
            FormField orig = targets[i];
            FormField nf = this.FieldFromJson(this.FieldJson(orig));
            nf.fx = orig.fx + 16;
            nf.fy = orig.fy + 16;
            nf.fw = orig.fw;
            nf.fh = orig.fh;
            this.RenameFresh(nf);
            FormField pc = ParentContainerOf(orig);
            if (pc == null) { fields.Add(nf); } else { pc.kids.Add(nf); }
            this.DesignDeclareRect(nf);
            newCopies.Add(nf);
        }
        if (newCopies.Count > 0) {
            ClearExtraSel();
            sel = newCopies[0];
            for (int i = 1; i < newCopies.Count; i = i + 1) {
                freeExtra.Add(newCopies[i]);
            }
            this.SyncFreeSelBase();
            this.MarkDocDirty();
            if (newCopies.Count == 1) {
                msg = Designer.T("duplicated", "已创建副本");
            } else {
                msg = Designer.T("duplicated ", "已创建副本 ") + Convert.ToString(newCopies.Count) + Designer.T(" component(s)", " 个组件");
            }
        }
    }

    // --- 撤销 / 重做（整份设计 JSON 快照，同场景设计器） ----------

    // 记录当前设计；在任何修改前调用。当前状态和栈顶相同
    // （上一次压栈后设计没真正变过）时不重复压栈。
    void PushUndo() {
        this.PushUndoAction("");
    }

    void PushUndoAction(string action) {
        string j = this.SaveJson();
        if (undoStack.Count > 0 && undoStack[undoStack.Count - 1] == j) {
            if (action != "" && undoActionStack.Count > 0) {
                undoActionStack[undoActionStack.Count - 1] = action;
            }
            return;
        }
        string act = action != "" ? action : (pendingUndoAction != "" ? pendingUndoAction : Designer.T("change", "修改"));
        pendingUndoAction = "";
        undoStack.Add(j);
        undoActionStack.Add(act);
        if (undoStack.Count > 60) {
            undoStack.RemoveAt(0);
            if (undoActionStack.Count > 0) { undoActionStack.RemoveAt(0); }
        }
        redoStack = new List<string>();
        redoActionStack = new List<string>();
        this.MarkDocDirty();
    }

    // 拖拽/缩放结束（或任何「压了栈但没改成」的操作收尾）时调用：
    // 设计和栈顶一致说明这次操作没有实际改动，把栈顶退掉，
    // 免得 Ctrl+Z 第一脚踩空。
    void PopUndoIfUnchanged() {
        if (undoStack.Count > 0 && undoStack[undoStack.Count - 1] == this.SaveJson()) {
            undoStack.RemoveAt(undoStack.Count - 1);
            if (undoActionStack.Count > 0) {
                undoActionStack.RemoveAt(undoActionStack.Count - 1);
            }
        }
    }

    // 撤销：当前设计压入重做栈，载入撤销栈顶；栈空时仅提示。
    // 恢复快照必须走 ApplyJson——LoadJson 会清空两个历史栈，
    // 一步撤销之后整个历史就没了。
    void Undo() {
        if (undoStack.Count == 0) {
            msg = Designer.T("nothing to undo", "没有可撤销的操作");
            return;
        }
        redoStack.Add(this.SaveJson());
        string act = Designer.T("change", "修改");
        if (undoActionStack.Count > 0) {
            act = undoActionStack[undoActionStack.Count - 1];
            undoActionStack.RemoveAt(undoActionStack.Count - 1);
        }
        redoActionStack.Add(act);
        string j = undoStack[undoStack.Count - 1];
        undoStack.RemoveAt(undoStack.Count - 1);
        this.ApplyJson(j);
        this.SyncFreeSelBase();
        msg = Designer.T("undone: ", "已撤销: ") + act + " (" + Designer.T("remaining ", "剩余 ") + Convert.ToString(undoStack.Count) + Designer.T(" steps", " 步") + ")";
    }

    // 重做：当前设计压入撤销栈，载入重做栈顶；栈空时仅提示。
    void Redo() {
        if (redoStack.Count == 0) {
            msg = Designer.T("nothing to redo", "没有可重做的操作");
            return;
        }
        undoStack.Add(this.SaveJson());
        string act = Designer.T("change", "修改");
        if (redoActionStack.Count > 0) {
            act = redoActionStack[redoActionStack.Count - 1];
            redoActionStack.RemoveAt(redoActionStack.Count - 1);
        }
        undoActionStack.Add(act);
        string j = redoStack[redoStack.Count - 1];
        redoStack.RemoveAt(redoStack.Count - 1);
        this.ApplyJson(j);
        this.SyncFreeSelBase();
        msg = Designer.T("redone: ", "已重做: ") + act + " (" + Designer.T("remaining ", "剩余 ") + Convert.ToString(redoStack.Count) + Designer.T(" steps", " 步") + ")";
    }

    // --- 剪贴板：复制 / 粘贴选中项（容器连子级一起） --------------

    // 复制选中项（含多选）为 FieldJson 片段列表；无选中时仅提示。
    void CopySel() {
        if (sel == null) {
            msg = Designer.T("nothing to copy", "没有可复制的内容");
            return;
        }
        List<FormField> all = new List<FormField>();
        all.Add(sel);
        for (int i = 0; i < freeExtra.Count; i = i + 1) {
            if (freeExtra[i] != sel) { all.Add(freeExtra[i]); }
        }
        clipFields = new List<string>();
        for (int i = 0; i < all.Count; i = i + 1) {
            clipFields.Add(this.FieldJson(all[i]).PrettyToJson());
        }
        msg = Designer.T("copied ", "已复制 ")
            + Convert.ToString(clipFields.Count)
            + Designer.T(" component(s)", " 个组件");
    }

    // 粘贴的组件整组换新名字（含容器子级），避免和原组件、
    // 以及代码后置里的字段撞名。
    void RenameFresh(FormField f) {
        f.fname = FormField.TypeKey(f.ftype) + Convert.ToString(seq);
        f.name = f.fname;
        seq = seq + 1;
        for (int i = 0; i < f.kids.Count; i = i + 1) {
            this.RenameFresh(f.kids[i]);
        }
    }

    // 粘贴到原父容器（没有选中就贴到顶层），整组偏移 16px，
    // 贴完的组成为新的选中组。
    void PasteClip() {
        if (clipFields == null || clipFields.Count == 0) {
            msg = Designer.T("clipboard is empty", "剪贴板是空的");
            return;
        }
        this.PushUndo();
        FormField pc = null;
        if (sel != null) { pc = ParentContainerOf(sel); }
        List<FormField> list = fields;
        if (pc != null) { list = pc.kids; }
        this.ClearExtraSel();
        sel = null;
        for (int i = 0; i < clipFields.Count; i = i + 1) {
            JsonValue o = JsonValue.ParseLenient(clipFields[i]);
            if (o == null || !o.IsObject()) { continue; }
            FormField nf = this.FieldFromJson(o);
            nf.fx = nf.fx + 16;
            nf.fy = nf.fy + 16;
            this.RenameFresh(nf);
            list.Add(nf);
            if (sel == null) { sel = nf; } else { freeExtra.Add(nf); }
        }
        if (pc != null) { activeContainer = pc; }
        inspTab = 0;
        msg = Designer.T("pasted ", "已粘贴 ")
            + Convert.ToString(clipFields.Count)
            + Designer.T(" component(s)", " 个组件");
    }

    // 方向键微调整个多选组（自由布局；Shift=1px）。
    void NudgeSel(int dx, int dy) {
        if (sel == null) { return; }
        this.PushUndo();
        this.NudgeOne(sel, dx, dy);
        for (int i = 0; i < freeExtra.Count; i = i + 1) {
            FormField ef = freeExtra[i];
            if (ef == null || ef.locked) { continue; }
            this.NudgeOne(ef, dx, dy);
        }
    }

    // 单个组件按像素增量微调并钳制到非负坐标。
    void NudgeOne(FormField f, int dx, int dy) {
        if (f == null || f.locked) { return; }
        this.DesignMakeFloat(f);
        f.fx = f.fx + dx;
        f.fy = f.fy + dy;
        if (f.fx < 0) { f.fx = 0; }
        if (f.fy < 0) { f.fy = 0; }
        this.DesignDeclareRect(f);
        this.MarkDocDirty();
    }

    void ResizeSelByKey(int dw, int dh) {
        if (sel == null || sel.locked) { return; }
        this.PushUndo();
        this.ResizeOneByKey(sel, dw, dh);
        for (int i = 0; i < freeExtra.Count; i = i + 1) {
            FormField ef = freeExtra[i];
            if (ef == null || ef.locked) { continue; }
            this.ResizeOneByKey(ef, dw, dh);
        }
        msg = Designer.T("resized: ", "已调整尺寸: ") + Convert.ToString(sel.fw) + "x" + Convert.ToString(sel.fh);
    }

    void ResizeOneByKey(FormField f, int dw, int dh) {
        if (f == null || f.locked) { return; }
        this.DesignMakeFloat(f);
        if (dw != 0) {
            f.fw = f.fw + dw;
            if (f.fw < 8) { f.fw = 8; }
        }
        if (dh != 0) {
            f.fh = f.fh + dh;
            if (f.fh < 8) { f.fh = 8; }
        }
        this.DesignDeclareRect(f);
        this.MarkDocDirty();
    }

    // 锁定/解锁整个多选：以主选中项的状态取反，其余成员跟随，
    // 这样一组组件的锁定状态始终一致。
    void ToggleLockSel() {
        if (sel == null) { return; }
        this.PushUndo();
        bool on = !sel.locked;
        sel.locked = on;
        for (int i = 0; i < freeExtra.Count; i = i + 1) {
            freeExtra[i].locked = on;
        }
        if (on) { msg = Designer.T("locked", "已锁定"); }
        else { msg = Designer.T("unlocked", "已解锁"); }
    }

    // 删除整个多选：先删附加项，再删主选中项。
    // 无论从功能区按钮还是 Delete 键触发，都走这里，
    // 保证多选里的每一个都被删掉（而不是只删主选中项）。
    void DeleteSelGroup() {
        if (sel != null || freeExtra.Count > 0) { this.PushUndo(); }
        dropContainer = null;
        activeContainer = null;
        dragging = false;
        dragFromPalette = false;
        dragMoved = false;
        dragIndex = -1;
        List<FormField> extra = freeExtra;
        freeExtra = new List<FormField>();
        int n = 0;
        for (int i = 0; i < extra.Count; i = i + 1) {
            FormField f = extra[i];
            if (f == null || f == sel) { continue; }
            FormField pc = ParentContainerOf(f);
            if (pc == null) { fields = ListRemove(fields, f); }
            else { pc.kids = ListRemove(pc.kids, f); }
            n = n + 1;
        }
        DeleteSel();
        if (n > 0) {
            msg = Designer.T("deleted selection", "已删除选中的组件");
        }
    }

    // 一键成组：把多选的所有组件收纳进一个新的 Panel 容器 (Ctrl+G)，智能识别公共宿主容器与层级持久化
    void GroupSel() {
        if (sel == null || freeExtra == null || freeExtra.Count == 0) { return; }
        this.PushUndo();
        List<FormField> all = new List<FormField>();
        all.Add(sel);
        for (int i = 0; i < freeExtra.Count; i = i + 1) {
            all.Add(freeExtra[i]);
        }
        FormField commonParent = ParentContainerOf(all[0]);
        bool sameParent = true;
        for (int i = 1; i < all.Count; i = i + 1) {
            if (ParentContainerOf(all[i]) != commonParent) {
                sameParent = false;
                break;
            }
        }
        if (!sameParent) {
            commonParent = null;
        }

        int minX = 0;
        int minY = 0;
        int maxX = 0;
        int maxY = 0;
        if (commonParent != null) {
            minX = all[0].fx;
            minY = all[0].fy;
            maxX = all[0].fx + all[0].fw;
            maxY = all[0].fy + all[0].fh;
            for (int i = 1; i < all.Count; i = i + 1) {
                FormField f = all[i];
                if (f.fx < minX) { minX = f.fx; }
                if (f.fy < minY) { minY = f.fy; }
                int r = f.fx + f.fw;
                int b = f.fy + f.fh;
                if (r > maxX) { maxX = r; }
                if (b > maxY) { maxY = b; }
            }
        } else {
            minX = this.DesignWorldX(all[0]);
            minY = this.DesignWorldY(all[0]);
            maxX = minX + all[0].fw;
            maxY = minY + all[0].fh;
            for (int i = 1; i < all.Count; i = i + 1) {
                FormField f = all[i];
                int wx = this.DesignWorldX(f);
                int wy = this.DesignWorldY(f);
                if (wx < minX) { minX = wx; }
                if (wy < minY) { minY = wy; }
                int r = wx + f.fw;
                int b = wy + f.fh;
                if (r > maxX) { maxX = r; }
                if (b > maxY) { maxY = b; }
            }
        }

        int pad = 12;
        int groupW = maxX - minX + pad * 2;
        int groupH = maxY - minY + pad * 2;
        if (groupW < 60) { groupW = 60; }
        if (groupH < 40) { groupH = 40; }

        FormField grp = FormField.New(15, seq);
        seq = seq + 1;
        grp.fname = "panel" + Convert.ToString(seq);
        grp.name = grp.fname;
        grp.fx = minX;
        grp.fy = minY;
        grp.fw = groupW;
        grp.fh = groupH;
        grp.position = 1;
        grp.kids = new List<FormField>();

        for (int i = 0; i < all.Count; i = i + 1) {
            FormField f = all[i];
            FormField pc = ParentContainerOf(f);
            if (pc == null) { fields = ListRemove(fields, f); }
            else { pc.kids = ListRemove(pc.kids, f); }
            if (commonParent != null) {
                f.fx = f.fx - minX + pad;
                f.fy = f.fy - minY + pad;
            } else {
                f.fx = this.DesignWorldX(f) - minX + pad;
                f.fy = this.DesignWorldY(f) - minY + pad;
            }
            grp.kids.Add(f);
            this.DesignDeclareRect(f);
        }

        if (commonParent == null) {
            fields.Add(grp);
        } else {
            commonParent.kids.Add(grp);
        }
        this.DesignDeclareRect(grp);
        this.ClearExtraSel();
        sel = grp;
        activeContainer = grp;
        this.MarkDocDirty();
        msg = Designer.T("Grouped ", "已成组 ") + Convert.ToString(all.Count) + Designer.T(" components into ", " 个组件至 ") + grp.fname;
        if (this.hostApp != null) { this.hostApp.RequestRedraw(); }
    }

    // 一键解散成组：把当前选中容器解散，将其子组件提取回上一层 (Ctrl+Shift+G) 并重新声明持久化
    void UngroupSel() {
        if (sel == null || !FormField.IsContainerOf(sel.ftype) || sel.kids == null || sel.kids.Count == 0) {
            return;
        }
        this.PushUndo();
        FormField grp = sel;
        int baseX = grp.fx;
        int baseY = grp.fy;
        List<FormField> children = grp.kids;
        FormField pc = ParentContainerOf(grp);
        if (pc == null) { fields = ListRemove(fields, grp); }
        else { pc.kids = ListRemove(pc.kids, grp); }

        this.ClearExtraSel();
        sel = null;
        for (int i = 0; i < children.Count; i = i + 1) {
            FormField child = children[i];
            child.fx = baseX + child.fx;
            child.fy = baseY + child.fy;
            if (pc == null) { fields.Add(child); }
            else { pc.kids.Add(child); }
            this.DesignDeclareRect(child);
            if (sel == null) { sel = child; }
            else { freeExtra.Add(child); }
        }
        this.MarkDocDirty();
        msg = Designer.T("Ungrouped ", "已解散成组: ") + grp.fname + " (" + Convert.ToString(children.Count) + ")";
        if (this.hostApp != null) { this.hostApp.RequestRedraw(); }
    }

    // 删除主选中项，并清掉多选与可能引用它的交互状态
    // （避免悬空引用崩溃）。
    void DeleteSel() {
        if (sel == null) {
            // 即使没有主选中项，也把残留的多选和交互状态清干净，
            // 避免后续帧引用已删对象或向 freeExtra 加入 null。
            freeExtra = new List<FormField>();
            return;
        }
        FormField pc = ParentContainerOf(sel);
        if (pc == null) {
            fields = ListRemove(fields, sel);
        } else {
            pc.kids = ListRemove(pc.kids, sel);
        }
        sel = null;
        selPrev = null;
        activeContainer = null;
        // 清掉可能引用已删组件的交互状态，避免悬空引用崩溃。
        rowsEdField = null;
        propsEdField = null;
        freeExtra = new List<FormField>();
        freeDragging = false;
        freeResizing = false;
        freeMarquee = false;
        msg = Designer.T("deleted field", "已删除组件");
    }

    // 剪切选中组件到剪贴板并从画布移除。
    void CutSel() {
        if (sel == null) { return; }
        this.CopySel();
        this.DeleteSelGroup();
        msg = Designer.T("cut", "已剪切");
    }

    // 将选中组件移至其容器/根列表的顶层（最上方绘制）。
    void BringToFront() {
        if (sel == null) { return; }
        FormField pc = ParentContainerOf(sel);
        List<FormField> list = fields;
        if (pc != null) { list = pc.kids; }
        int idx = list.IndexOf(sel);
        if (idx >= 0 && idx < list.Count - 1) {
            this.PushUndo();
            list.RemoveAt(idx);
            list.Add(sel);
            msg = Designer.T("brought to front", "已置于顶层");
        }
    }

    // 将选中组件移至其容器/根列表的底层（最下方绘制）。
    void SendToBack() {
        if (sel == null) { return; }
        FormField pc = ParentContainerOf(sel);
        List<FormField> list = fields;
        if (pc != null) { list = pc.kids; }
        int idx = list.IndexOf(sel);
        if (idx > 0) {
            this.PushUndo();
            list.RemoveAt(idx);
            list.Insert(0, sel);
            msg = Designer.T("sent to back", "已置于底层");
        }
    }

    // 将选中组件移出容器并提升至窗口顶层（根层）
    void MoveSelToRoot() {
        if (sel == null) { return; }
        FormField curP = ParentContainerOf(sel);
        if (curP == null) { return; }
        this.PushUndo();
        curP.kids = ListRemove(curP.kids, sel);
        DesignPreviewNode node = this.PreviewNode(sel);
        if (node != null && node.control != null) {
            sel.fx = this.DesignLogical(node.control.bx);
            sel.fy = this.DesignLogical(node.control.by);
        }
        fields.Add(sel);
        this.activeContainer = null;
        msg = Designer.T("moved to form root", "已移至窗口根层");
        this.MarkDocDirty();
    }

    // 将选中组件移入指定容器
    void MoveSelInto(FormField destContainer) {
        if (sel == null || destContainer == null || sel == destContainer) { return; }
        FormField curP = ParentContainerOf(sel);
        if (curP == destContainer) { return; }
        this.PushUndo();
        if (curP == null) {
            fields = ListRemove(fields, sel);
        } else {
            curP.kids = ListRemove(curP.kids, sel);
        }
        if (destContainer.kids == null) { destContainer.kids = new List<FormField>(); }
        DesignPreviewNode pnode = this.PreviewNode(destContainer);
        DesignPreviewNode snode = this.PreviewNode(sel);
        if (pnode != null && pnode.control != null && snode != null && snode.control != null) {
            sel.fx = this.DesignLogical(snode.control.bx - pnode.control.bx);
            sel.fy = this.DesignLogical(snode.control.by - pnode.control.by);
            if (sel.fx < 0) { sel.fx = 12; }
            if (sel.fy < 0) { sel.fy = 12; }
        }
        destContainer.kids.Add(sel);
        this.activeContainer = destContainer;
        msg = Designer.T("moved into ", "已移入 ") + destContainer.fname;
        this.MarkDocDirty();
    }

    // 大纲树一键全部展开/折叠所有目录节点
    void OutlineExpandAll(bool expand) {
        if (outlineTv == null) { return; }
        if (expand) { outlineTv.ExpandAll(); }
        else { outlineTv.CollapseAll(); }
        if (this.hostApp != null) { this.hostApp.RequestRedraw(); }
    }

    // 打开快速组件插入浮动面板 (Spotlight Quick Insert)
    void OpenQuickInsert(App app) {
        quickInsertOpen = true;
        quickInsertInput.SetText("");
        quickInsertLastQ = "";
        quickInsertSelIdx = 0;
        quickInsertX = app.mouseX;
        quickInsertY = app.mouseY;
        quickInsertDesX = 40;
        quickInsertDesY = 40;
        if (sel != null) {
            quickInsertDesX = sel.fx + 24;
            quickInsertDesY = sel.fy + 24;
        }
        this.FilterQuickInsert("");
        quickInsertInput.Focus();
    }

    // 过滤候选组件列表
    void FilterQuickInsert(string q) {
        quickInsertMatches = new List<int>();
        quickInsertLastQ = q;
        if (q == "") {
            quickInsertMatches.Add(-1); // Preset: Classic App
            quickInsertMatches.Add(-2); // Preset: Split Workspace
            quickInsertMatches.Add(-3); // Preset: Form Row
            quickInsertMatches.Add(-4); // Preset: Dialog Actions
            quickInsertMatches.Add(15); // Button
            quickInsertMatches.Add(0);  // Input
            quickInsertMatches.Add(18); // Card
            quickInsertMatches.Add(23); // Table
            quickInsertMatches.Add(36); // Tabs
            quickInsertMatches.Add(45); // Panel
            quickInsertMatches.Add(58); // ToolStrip
            quickInsertMatches.Add(73); // Flex
            quickInsertMatches.Add(6);  // Select
            quickInsertMatches.Add(4);  // Radio
            quickInsertMatches.Add(5);  // Checkbox
            quickInsertMatches.Add(14); // RichText
            quickInsertMatches.Add(59); // StatusBar
            quickInsertMatches.Add(60); // Splitter
            return;
        }

        // 预设复合模板快速匹配
        string lowerQ = q.ToLower();
        if (Designer.Contains(lowerQ, "preset") || Designer.Contains(lowerQ, "骨架") || Designer.Contains(lowerQ, "模板")
                || Designer.Contains(lowerQ, "app") || Designer.Contains(lowerQ, "main") || Designer.Contains(lowerQ, "tool")) {
            quickInsertMatches.Add(-1);
        }
        if (Designer.Contains(lowerQ, "preset") || Designer.Contains(lowerQ, "骨架") || Designer.Contains(lowerQ, "模板")
                || Designer.Contains(lowerQ, "split") || Designer.Contains(lowerQ, "side") || Designer.Contains(lowerQ, "分栏")) {
            quickInsertMatches.Add(-2);
        }
        if (Designer.Contains(lowerQ, "preset") || Designer.Contains(lowerQ, "骨架") || Designer.Contains(lowerQ, "模板")
                || Designer.Contains(lowerQ, "form") || Designer.Contains(lowerQ, "row") || Designer.Contains(lowerQ, "表单")) {
            quickInsertMatches.Add(-3);
        }
        if (Designer.Contains(lowerQ, "preset") || Designer.Contains(lowerQ, "骨架") || Designer.Contains(lowerQ, "模板")
                || Designer.Contains(lowerQ, "dialog") || Designer.Contains(lowerQ, "action") || Designer.Contains(lowerQ, "弹窗") || Designer.Contains(lowerQ, "底")) {
            quickInsertMatches.Add(-4);
        }

        for (int ft = 0; ft <= 85; ft = ft + 1) {
            string name = FormField.TypeName(ft);
            string desc = this.FieldDesc(ft);
            if (Designer.Contains(name, q) || Designer.Contains(desc, q)) {
                quickInsertMatches.Add(ft);
                if (quickInsertMatches.Count >= 20) { break; }
            }
        }
        if (quickInsertSelIdx >= quickInsertMatches.Count) {
            quickInsertSelIdx = 0;
        }
    }

    // 提交并生成选中的组件或预设骨架
    void CommitQuickInsert(int ft) {
        quickInsertOpen = false;
        if (ft < 0) {
            this.InsertStarterPreset(-ft);
            return;
        }
        this.AddField(ft);
        if (sel != null && layoutMode == 1) {
            sel.fx = quickInsertDesX;
            sel.fy = quickInsertDesY;
            this.DesignDeclareRect(sel);
        }
        msg = Designer.T("inserted: ", "已插入: ") + FormField.TypeName(ft);
        this.MarkDocDirty();
    }

    // 绘制快速组件插入浮动面板 (Quick Insert Spotlight HUD)
    void RenderQuickInsert(App app, Canvas c, Theme t, int screenW, int screenH) {
        if (!quickInsertOpen) { return; }
        int w = app.Scale(320);
        int itemH = app.Scale(28);
        int headerH = app.Scale(42);
        int maxItems = 7;
        int listCount = quickInsertMatches.Count;
        if (listCount > maxItems) { listCount = maxItems; }
        int h = headerH + listCount * itemH + app.Scale(12);

        int qx = quickInsertX;
        int qy = quickInsertY;
        if (qx + w > screenW - app.Scale(16)) { qx = screenW - w - app.Scale(16); }
        if (qy + h > screenH - app.Scale(16)) { qy = screenH - h - app.Scale(16); }
        if (qx < app.Scale(16)) { qx = app.Scale(16); }
        if (qy < app.Scale(16)) { qy = app.Scale(16); }

        int fs = Style.FontFallback(app, "small");
        int fsTiny = Style.FontFallback(app, "tiny");
        if (fsTiny <= 0) { fsTiny = fs; }

        // 面板要占住自己这块：先注册阻挡区，下面的组件树/检查器/
        // 功能区就不会再收到落在面板上的点击（此前面板只是画出来，
        // 点一行会「既插入组件、又换了下面树里的选中项」）。
        // 阻挡区先于面板内的输入框注册，输入框仍能点。
        app.BlockHitsRect(qx, qy, w, h);

        int bg = Style.Full(app, "designer", "", "", Style.SNormal()).BgOr(0);
        int border = Style.Part(app, "designer", "accent", "", "", "", Style.SNormal()).BorderOr(0);
        int shadow = Style.Part(app, "designer", "shadow", "", "", "", Style.SNormal()).BgOr(0);

        c.FillRoundRect(qx + 2, qy + 2, w, h, app.Scale(8), shadow);
        c.FillRoundRect(qx, qy, w, h, app.Scale(8), bg);
        c.DrawRoundRect(qx, qy, w, h, app.Scale(8), border, 1);

        int inX = qx + app.Scale(10);
        int inY = qy + app.Scale(8);
        int inW = w - app.Scale(20);
        int inH = app.Scale(26);
        quickInsertInput.Render(app, inX, inY, inW, inH);

        string curQ = quickInsertInput.GetText();
        if (curQ != quickInsertLastQ) {
            this.FilterQuickInsert(curQ);
        }

        int lineY = inY + inH + app.Scale(6);
        c.FillRect(qx + app.Scale(8), lineY, w - app.Scale(16), 1, Style.Fade(border, 40));

        int ly = lineY + app.Scale(4);
        int hoveredItem = 0 - 1;
        for (int i = 0; i < listCount; i = i + 1) {
            int ft = quickInsertMatches[i];
            int iy = ly + i * itemH;
            bool isSel = (i == quickInsertSelIdx);
            bool isHov = InRect(app.mouseX, app.mouseY, qx + app.Scale(6), iy, w - app.Scale(12), itemH);
            if (isHov) { hoveredItem = i; }

            if (isSel || isHov) {
                int fillCol = isSel ? Style.Part(app, "designer", "accent", "", "", "", Style.SNormal()).BgOr(0)
                                    : Style.Fade(border, 30);
                c.FillRoundRect(qx + app.Scale(6), iy, w - app.Scale(12), itemH - app.Scale(2), app.Scale(4), fillCol);
            }

            int textCol = isSel ? Style.Part(app, "designer", "badge", "", "", "", Style.SNormal()).FgOr(0)
                                : Style.Part(app, "designer", "text", "", "", "", Style.SNormal()).FgOr(0);
            int descCol = isSel ? textCol : Style.Part(app, "designer", "hint", "", "", "", Style.SNormal()).FgOr(0);

            string iconName = "layout";
            string name = "";
            string desc = "";
            if (ft < 0) {
                if (ft == -1) {
                    name = Designer.T("Preset: Classic App", "预设: 经典主窗口");
                    desc = Designer.T("Toolbar + Content + StatusBar", "工具栏 + 内容工作区 + 状态栏");
                    iconName = "layout";
                } else if (ft == -2) {
                    name = Designer.T("Preset: Split Workspace", "预设: 左右分栏工作区");
                    desc = Designer.T("Sidebar Left + Main View Fill", "左侧导航栏 + 右侧主工作区");
                    iconName = "split";
                } else if (ft == -3) {
                    name = Designer.T("Preset: Standard Form Row", "预设: 标准表单行");
                    desc = Designer.T("Label + Input Fill + Button", "标签 + 输入框撑满 + 操作按钮");
                    iconName = "input";
                } else if (ft == -4) {
                    name = Designer.T("Preset: Dialog Actions", "预设: 对话框底部操作栏");
                    desc = Designer.T("Right-aligned Cancel + OK", "右对齐 取消 + 确定按钮排");
                    iconName = "button";
                }
            } else {
                iconName = this.FieldIcon(ft);
                name = FormField.TypeName(ft);
                desc = this.FieldDesc(ft);
            }
            c.DrawGlyphIn(iconName, qx + app.Scale(14), iy + app.Scale(5), app.Scale(16), app.Scale(16), app.Scale(14), textCol);
            c.DrawText(qx + app.Scale(36), iy + app.Scale(5), name, textCol, fs);

            int nw = Canvas.MeasureText(name, fs);
            c.DrawText(qx + app.Scale(44) + nw, iy + app.Scale(6), " · " + desc, descCol, fsTiny);

            if (isHov && app.EventKind() == 3) {
                this.CommitQuickInsert(ft);
                // 这次点击属于「插入组件」这一个手势：认领掉，面板
                // 底下的组件树/检查器不再收到同一次释放。
                app.ClaimClick();
                app.RequestRedraw();
                return;
            }
        }
        if (hoveredItem >= 0) {
            quickInsertSelIdx = hoveredItem;
        }

        if (app.EventKind() == 4) {
            int kc = app.window.EventKeyCode();
            if (kc == 38) {
                if (quickInsertMatches.Count > 0) {
                    quickInsertSelIdx = (quickInsertSelIdx - 1 + quickInsertMatches.Count) % quickInsertMatches.Count;
                    app.RequestRedraw();
                }
            } else if (kc == 40) {
                if (quickInsertMatches.Count > 0) {
                    quickInsertSelIdx = (quickInsertSelIdx + 1) % quickInsertMatches.Count;
                    app.RequestRedraw();
                }
            } else if (kc == 13) {
                if (quickInsertSelIdx >= 0 && quickInsertSelIdx < quickInsertMatches.Count) {
                    this.CommitQuickInsert(quickInsertMatches[quickInsertSelIdx]);
                    app.RequestRedraw();
                }
            } else if (kc == 27) {
                quickInsertOpen = false;
                app.RequestRedraw();
            }
        }
    }

    // 绘制设计器快捷键速查面板 (CheatSheet HUD)
    void RenderKeymapHelp(App app, Canvas c, Theme t, int screenW, int screenH) {
        if (!keymapHelpOpen) { return; }
        int maskCol = Style.Fade(0, 140);
        c.FillRect(0, 0, screenW, screenH, maskCol);
        // 这层变暗是模态：铺全窗阻挡区，面板底下的一切（组件树、
        // 检查器、功能区按钮）都不得再收到点击。此前只是画出来，
        // 点 X 会「既关掉面板、又顺手点了 X 底下的工具栏按钮」。
        app.BlockHitsBelow();

        int w = app.Scale(560);
        int h = app.Scale(500);
        int x = (screenW - w) / 2;
        int y = (screenH - h) / 2;

        if (app.EventKind() == 2 && app.window.EventButton() == 0) {
            if (!InRect(app.mouseX, app.mouseY, x, y, w, h)) {
                keymapHelpOpen = false;
                app.RequestRedraw();
                return;
            }
        }

        int bg = Style.Full(app, "designer", "", "", Style.SNormal()).BgOr(0);
        int border = Style.Part(app, "designer", "accent", "", "", "", Style.SNormal()).BorderOr(0);
        int shadow = Style.Part(app, "designer", "shadow", "", "", "", Style.SNormal()).BgOr(0);

        c.FillRoundRect(x + 4, y + 4, w, h, app.Scale(10), shadow);
        c.FillRoundRect(x, y, w, h, app.Scale(10), bg);
        c.DrawRoundRect(x, y, w, h, app.Scale(10), border, 1);

        int fsTitle = Style.FontFallback(app, "normal");
        int fs = Style.FontFallback(app, "small");
        int fsTiny = Style.FontFallback(app, "tiny");
        if (fsTiny <= 0) { fsTiny = fs; }

        int titleCol = Style.Part(app, "designer", "text", "", "", "", Style.SNormal()).FgOr(0);
        int hintCol = Style.Part(app, "designer", "hint", "", "", "", Style.SNormal()).FgOr(0);
        int accentCol = Style.Part(app, "designer", "accent", "", "", "", Style.SNormal()).BgOr(0);

        c.DrawText(x + app.Scale(20), y + app.Scale(16), Designer.T("Keyboard Shortcuts Guide", "设计器快捷键速查指南"), titleCol, fsTitle);
        int closeW = app.Scale(24);
        int closeH = app.Scale(24);
        int closeX = x + w - app.Scale(36);
        int closeY = y + app.Scale(14);
        bool closeHov = InRect(app.mouseX, app.mouseY, closeX, closeY, closeW, closeH);
        if (closeHov) {
            c.FillRoundRect(closeX, closeY, closeW, closeH, app.Scale(4), Style.Fade(border, 40));
            if (app.EventKind() == 3) {
                keymapHelpOpen = false;
                app.RequestRedraw();
                return;
            }
        }
        c.DrawText(closeX + app.Scale(7), closeY + app.Scale(3), "x", hintCol, fs);

        int lineY = y + app.Scale(48);
        c.FillRect(x + app.Scale(16), lineY, w - app.Scale(32), 1, Style.Fade(border, 40));

        int col1X = x + app.Scale(20);
        int col2X = x + w / 2 + app.Scale(10);
        int colW = w / 2 - app.Scale(30);

        int curY = lineY + app.Scale(14);
        c.DrawText(col1X, curY, Designer.T("Component & Edit", "组件与常用编辑"), accentCol, fs);
        curY = curY + app.Scale(22);

        this.DrawShortcutRow(app, c, col1X, curY, colW, "Ctrl+I", Designer.T("Spotlight Quick Insert", "快捷插入组件面板"), fs, fsTiny, titleCol, hintCol, border);
        curY = curY + app.Scale(24);
        this.DrawShortcutRow(app, c, col1X, curY, colW, "Ctrl+X / C / V", Designer.T("Cut / Copy / Paste", "剪切 / 复制 / 粘贴"), fs, fsTiny, titleCol, hintCol, border);
        curY = curY + app.Scale(24);
        this.DrawShortcutRow(app, c, col1X, curY, colW, "Ctrl+Shift+H / V", Designer.T("Distribute H / V", "水平均分 / 垂直均分"), fs, fsTiny, titleCol, hintCol, border);
        curY = curY + app.Scale(24);
        this.DrawShortcutRow(app, c, col1X, curY, colW, "Ctrl+D", Designer.T("Duplicate Component", "创建副本"), fs, fsTiny, titleCol, hintCol, border);
        curY = curY + app.Scale(24);
        this.DrawShortcutRow(app, c, col1X, curY, colW, "F2 / DoubleClick", Designer.T("Rename Inline", "原地编辑文案 / 属性"), fs, fsTiny, titleCol, hintCol, border);
        curY = curY + app.Scale(24);
        this.DrawShortcutRow(app, c, col1X, curY, colW, "Ctrl+L", Designer.T("Lock / Unlock", "锁定 / 解锁"), fs, fsTiny, titleCol, hintCol, border);
        curY = curY + app.Scale(24);
        this.DrawShortcutRow(app, c, col1X, curY, colW, "Ctrl+G", Designer.T("Group", "一键成组"), fs, fsTiny, titleCol, hintCol, border);
        curY = curY + app.Scale(24);
        this.DrawShortcutRow(app, c, col1X, curY, colW, "Ctrl+Shift+G", Designer.T("Ungroup", "解散成组"), fs, fsTiny, titleCol, hintCol, border);
        curY = curY + app.Scale(24);
        this.DrawShortcutRow(app, c, col1X, curY, colW, "Del / Backspace", Designer.T("Delete Selected", "删除选中组件"), fs, fsTiny, titleCol, hintCol, border);
        curY = curY + app.Scale(24);
        this.DrawShortcutRow(app, c, col1X, curY, colW, "Ctrl+Z / Ctrl+Y", Designer.T("Undo / Redo", "撤销 / 重做"), fs, fsTiny, titleCol, hintCol, border);

        curY = lineY + app.Scale(14);
        c.DrawText(col2X, curY, Designer.T("Canvas & Navigation", "图层与视口漫游"), accentCol, fs);
        curY = curY + app.Scale(22);

        this.DrawShortcutRow(app, c, col2X, curY, colW, "Ctrl + Wheel", Designer.T("Smooth Zoom (Anchor)", "光标锚点平滑缩放"), fs, fsTiny, titleCol, hintCol, border);
        curY = curY + app.Scale(24);
        this.DrawShortcutRow(app, c, col2X, curY, colW, "Space / MidDrag", Designer.T("Pan Viewport", "抓手平移画布"), fs, fsTiny, titleCol, hintCol, border);
        curY = curY + app.Scale(24);
        this.DrawShortcutRow(app, c, col2X, curY, colW, "Alt Hover", Designer.T("Measure Spacing", "测量控件外间距标尺"), fs, fsTiny, titleCol, hintCol, border);
        curY = curY + app.Scale(24);
        this.DrawShortcutRow(app, c, col2X, curY, colW, "Alt + Drag", Designer.T("Clone Component", "拖拽快速克隆副本"), fs, fsTiny, titleCol, hintCol, border);
        curY = curY + app.Scale(24);
        this.DrawShortcutRow(app, c, col2X, curY, colW, "Shift + Drag", Designer.T("Axis Constrained Move", "正交水平/垂直平移锁定"), fs, fsTiny, titleCol, hintCol, border);
        curY = curY + app.Scale(24);
        this.DrawShortcutRow(app, c, col2X, curY, colW, "PageUp / Down", Designer.T("Z-Order Move", "上移 / 下移一层"), fs, fsTiny, titleCol, hintCol, border);
        curY = curY + app.Scale(24);
        this.DrawShortcutRow(app, c, col2X, curY, colW, "Ctrl + ↑ / ↓", Designer.T("Reorder Sibling", "同级前后调序"), fs, fsTiny, titleCol, hintCol, border);
        curY = curY + app.Scale(24);
        this.DrawShortcutRow(app, c, col2X, curY, colW, "Ctrl+Home / End", Designer.T("Bring to Front / Back", "置于顶层 / 置于底层"), fs, fsTiny, titleCol, hintCol, border);
        curY = curY + app.Scale(24);
        this.DrawShortcutRow(app, c, col2X, curY, colW, "Arrows", Designer.T("Nudge Move (1px/10px)", "微调位置 (步长1/10px)"), fs, fsTiny, titleCol, hintCol, border);
        curY = curY + app.Scale(24);
        this.DrawShortcutRow(app, c, col2X, curY, colW, "Alt + Arrows", Designer.T("Resize Step (1px/10px)", "微调尺寸 (步长1/10px)"), fs, fsTiny, titleCol, hintCol, border);
        curY = curY + app.Scale(24);
        this.DrawShortcutRow(app, c, col2X, curY, colW, "Ctrl+R", Designer.T("Toggle Pixel Rulers", "显示 / 隐藏像素标尺"), fs, fsTiny, titleCol, hintCol, border);
        curY = curY + app.Scale(24);
        this.DrawShortcutRow(app, c, col2X, curY, colW, "Ctrl+;", Designer.T("Toggle Guide Lines", "显示 / 隐藏参考线"), fs, fsTiny, titleCol, hintCol, border);
        curY = curY + app.Scale(24);
        this.DrawShortcutRow(app, c, col2X, curY, colW, "Ctrl+0 / Ctrl+1", Designer.T("Zoom 100% / Fit", "缩放 100% / 铺满视口"), fs, fsTiny, titleCol, hintCol, border);
        curY = curY + app.Scale(24);
        this.DrawShortcutRow(app, c, col2X, curY, colW, "Esc", Designer.T("Cancel / Close", "取消选择 / 关闭弹窗"), fs, fsTiny, titleCol, hintCol, border);

        int botY = y + h - app.Scale(28);
        c.DrawText(x + app.Scale(20), botY, Designer.T("Press Esc or click outside to close", "按 Esc 或点击外部即可关闭本指南"), hintCol, fsTiny);

        if (app.EventKind() == 4) {
            int kc = app.window.EventKeyCode();
            if (kc == 27 || kc == 112) {
                keymapHelpOpen = false;
                app.RequestRedraw();
            }
        }
    }

    void DrawShortcutRow(App app, Canvas c, int rx, int ry, int rw, string key, string desc, int fs, int fsTiny, int textCol, int hintCol, int border) {
        int kw = Canvas.MeasureText(key, fsTiny) + app.Scale(10);
        int kh = app.Scale(18);
        c.FillRoundRect(rx, ry, kw, kh, app.Scale(3), Style.Fade(border, 30));
        c.DrawRoundRect(rx, ry, kw, kh, app.Scale(3), Style.Fade(border, 60), 1);
        c.DrawText(rx + app.Scale(5), ry + app.Scale(2), key, textCol, fsTiny);
        c.DrawText(rx + kw + app.Scale(8), ry + app.Scale(2), desc, hintCol, fsTiny);
    }

    // 快捷设置选中组件的排版与锚定方式（Flex 流式 vs 浮动与锚点）。
    void SetSelLayoutMode(int posMode, int anchorMode) {
        if (sel == null) { return; }
        this.PushUndo();
        sel.position = posMode;
        sel.anchor = anchorMode;
        if (posMode == 0) {
            msg = Designer.T("layout: flow", "排版: Flex 流式");
        } else {
            if (anchorMode == 10) {
                msg = Designer.T("layout: float stretch", "排版: 浮动铺满");
            } else if (anchorMode == 1) {
                msg = Designer.T("layout: float top-left", "排版: 浮动左上");
            } else if (anchorMode == 3) {
                msg = Designer.T("layout: float top-right", "排版: 浮动右上");
            } else if (anchorMode == 7) {
                msg = Designer.T("layout: float bottom-left", "排版: 浮动左下");
            } else if (anchorMode == 9) {
                msg = Designer.T("layout: float bottom-right", "排版: 浮动右下");
            } else {
                msg = Designer.T("layout: float", "排版: 浮动自由");
            }
        }
    }

    // 快捷设置选中组件的 Dock 停靠模式
    void SetSelDockMode(int dockSide) {
        if (sel == null) { return; }
        this.PushUndoAction(Designer.T("set dock", "设置停靠方式"));
        sel.dockSide = dockSide;
        if (dockSide > 0) {
            sel.position = 0;
            sel.fx = 0;
            sel.fy = 0;
        }
        this.DesignDeclareRect(sel);
        this.MarkDocDirty();
        string dsName = "None";
        if (dockSide == 1) { dsName = "Top"; }
        else if (dockSide == 2) { dsName = "Bottom"; }
        else if (dockSide == 3) { dsName = "Left"; }
        else if (dockSide == 4) { dsName = "Right"; }
        else if (dockSide == 5) { dsName = "Fill"; }
        msg = Designer.T("Dock set: ", "停靠方式: ") + dsName;
    }

    // 全流式模式下一键撑满剩余高度 (Fill Height: flexGrow=1, fh=0)
    void SetSelFillHeight() {
        if (sel == null) { return; }
        this.PushUndoAction(Designer.T("fill height", "撑满剩余高度"));
        sel.position = 0;
        sel.flexGrow = 1;
        sel.fh = 0;
        this.DesignDeclareRect(sel);
        this.MarkDocDirty();
        msg = Designer.T("Height: Fill (Grow=1)", "高度: 撑满剩余高度 (Grow=1)");
    }

    // 全流式模式下一键自适应内容高度 (Auto Height: flexGrow=0, fh=0)
    void SetSelAutoHeight() {
        if (sel == null) { return; }
        this.PushUndoAction(Designer.T("auto height", "内容自适应高度"));
        sel.position = 0;
        sel.flexGrow = 0;
        sel.fh = 0;
        this.DesignDeclareRect(sel);
        this.MarkDocDirty();
        msg = Designer.T("Height: Auto (Fit Content)", "高度: 内容自适应 (fh=0)");
    }

    List<string> CanvasMenuLabels() {
        List<string> r = new List<string>();
        if (sel != null) {
            bool isMulti = (freeExtra != null && freeExtra.Count > 0);
            if (isMulti) {
                // 多选控件时的 Visual Studio 标准上下文菜单
                r.Add(Designer.T("Cut", "剪切") + "  Ctrl+X");
                r.Add(Designer.T("Copy", "复制") + "  Ctrl+C");
                r.Add(Designer.T("Delete", "删除") + "  Del");
                r.Add("-");
                r.Add(Designer.T("Align Left", "← 左对齐"));
                r.Add(Designer.T("Align Center H", "| 水平居中"));
                r.Add(Designer.T("Align Right", "→ 右对齐"));
                r.Add(Designer.T("Align Top", "↑ 顶对齐"));
                r.Add(Designer.T("Align Middle V", "- 垂直居中"));
                r.Add(Designer.T("Align Bottom", "↓ 底对齐"));
                r.Add("-");
                r.Add(Designer.T("Match Width", "↔ 等宽"));
                r.Add(Designer.T("Match Height", "↕ 等高"));
                r.Add(Designer.T("Match Size", "⤢ 等尺寸"));
                r.Add("-");
                r.Add(Designer.T("Distribute Horizontally", "⇹ 水平均分"));
                r.Add(Designer.T("Distribute Vertically", "⇳ 垂直均分"));
                r.Add("-");
                r.Add(Designer.T("Group", "成组") + "  Ctrl+G");
                r.Add("-");
                if (sel.locked) { r.Add(Designer.T("Unlock", "解锁") + "  Ctrl+L"); }
                else { r.Add(Designer.T("Lock", "锁定") + "  Ctrl+L"); }
                r.Add("-");
                r.Add(Designer.T("Properties", "属性") + "  F4");
            } else {
                // 单选控件时的 Visual Studio 标准上下文菜单
                if (Designer.CanNavigateCodeBehind(sel)) {
                    r.Add(Designer.T("View Code", "查看代码") + "  F7");
                    r.Add("-");
                }
                r.Add(Designer.T("Cut", "剪切") + "  Ctrl+X");
                r.Add(Designer.T("Copy", "复制") + "  Ctrl+C");
                r.Add(Designer.T("Paste", "粘贴") + "  Ctrl+V");
                r.Add(Designer.T("Delete", "删除") + "  Del");
                r.Add("-");
                r.Add(Designer.T("Rename", "重命名") + "  F2");
                r.Add(Designer.T("Duplicate", "创建副本") + "  Ctrl+D");
                if (FormField.IsContainerOf(sel.ftype) && sel.kids != null && sel.kids.Count > 0) {
                    r.Add(Designer.T("Ungroup", "解散成组") + "  Ctrl+Shift+G");
                }
                r.Add("-");
                r.Add(Designer.T("Bring to Front", "置于顶层") + "  Ctrl+Home");
                r.Add(Designer.T("Bring Forward", "上移一层") + "  PageUp");
                r.Add(Designer.T("Send Backward", "下移一层") + "  PageDown");
                r.Add(Designer.T("Send to Back", "置于底层") + "  Ctrl+End");
                r.Add("-");
                if (sel.locked) { r.Add(Designer.T("Unlock", "解锁") + "  Ctrl+L"); }
                else { r.Add(Designer.T("Lock", "锁定") + "  Ctrl+L"); }
                r.Add("-");
                r.Add(Designer.T("Properties", "属性") + "  F4");
            }
        } else {
            // 空白画布 (Form 根节点) 时的 Visual Studio 标准上下文菜单
            r.Add(Designer.T("View Code", "查看代码") + "  F7");
            r.Add("-");
            r.Add(Designer.T("Paste", "粘贴") + "  Ctrl+V");
            r.Add(Designer.T("Select All", "全选") + "  Ctrl+A");
            r.Add("-");
            if (snapGrid) { r.Add(Designer.T("Disable Snap", "关闭网格吸附")); }
            else { r.Add(Designer.T("Enable Snap", "开启网格吸附")); }
            if (showRulers) { r.Add(Designer.T("Hide Pixel Rulers", "隐藏像素标尺") + "  Ctrl+R"); }
            else { r.Add(Designer.T("Show Pixel Rulers", "显示像素标尺") + "  Ctrl+R"); }
            r.Add("-");
            r.Add(Designer.T("Lock All Controls", "锁定所有控件"));
            r.Add("-");
            r.Add(Designer.T("Properties", "属性") + "  F4");
        }
        return r;
    }

    void HandleCanvasMenu(App app, int cc) {
        List<string> items = this.CanvasMenuLabels();
        if (cc < 0 || cc >= items.Count) { return; }
        string it = items[cc];
        if (it == "" || it == "-") { return; }
        if (sel != null) {
            if (it.StartsWith(Designer.T("View Code", "查看代码"))) {
                if (Designer.CanNavigateCodeBehind(sel)) {
                    string defEv = Designer.DefaultEventName(sel);
                    string h = sel.GetHandler(defEv);
                    if (h == "") {
                        h = Designer.SuggestHandler(sel, defEv);
                        sel.SetHandler(defEv, h);
                    }
                    this.RequestOpenCodeBehindHandler(h);
                }
            }
            else if (it.StartsWith(Designer.T("Cut", "剪切"))) { this.CutSel(); }
            else if (it.StartsWith(Designer.T("Copy", "复制"))) { this.CopySel(); }
            else if (it.StartsWith(Designer.T("Paste", "粘贴"))) { this.PasteClip(); }
            else if (it.StartsWith(Designer.T("Delete", "删除"))) { this.DeleteSelGroup(); }
            else if (it.StartsWith(Designer.T("Rename", "重命名"))) { this.StartInlineRename(); }
            else if (it.StartsWith(Designer.T("Duplicate", "创建副本"))) { this.DuplicateSel(); }
            else if (it.StartsWith(Designer.T("Group", "成组"))) { this.GroupSel(); }
            else if (it.StartsWith(Designer.T("Ungroup", "解散成组"))) { this.UngroupSel(); }
            else if (it.StartsWith(Designer.T("Align Left", "← 左对齐"))) { this.AlignSelGroup(0); }
            else if (it.StartsWith(Designer.T("Align Center H", "| 水平居中"))) { this.AlignSelGroup(1); }
            else if (it.StartsWith(Designer.T("Align Right", "→ 右对齐"))) { this.AlignSelGroup(2); }
            else if (it.StartsWith(Designer.T("Align Top", "↑ 顶对齐"))) { this.AlignSelGroup(3); }
            else if (it.StartsWith(Designer.T("Align Middle V", "- 垂直居中"))) { this.AlignSelGroup(4); }
            else if (it.StartsWith(Designer.T("Align Bottom", "↓ 底对齐"))) { this.AlignSelGroup(5); }
            else if (it.StartsWith(Designer.T("Match Width", "↔ 等宽"))) { this.SizeSelGroup(0); }
            else if (it.StartsWith(Designer.T("Match Height", "↕ 等高"))) { this.SizeSelGroup(1); }
            else if (it.StartsWith(Designer.T("Match Size", "⤢ 等尺寸"))) { this.SizeSelGroup(2); }
            else if (it.StartsWith(Designer.T("Distribute Horizontally", "⇹ 水平均分"))) { this.DistributeSelGroup(0); }
            else if (it.StartsWith(Designer.T("Distribute Vertically", "⇳ 垂直均分"))) { this.DistributeSelGroup(1); }
            else if (it.StartsWith(Designer.T("Bring to Front", "置于顶层"))) { this.SelToEdge(1); }
            else if (it.StartsWith(Designer.T("Bring Forward", "上移一层"))) { this.MoveSel(1); }
            else if (it.StartsWith(Designer.T("Send Backward", "下移一层"))) { this.MoveSel(0 - 1); }
            else if (it.StartsWith(Designer.T("Send to Back", "置于底层"))) { this.SelToEdge(0); }
            else if (it.StartsWith(Designer.T("Unlock", "解锁")) || it.StartsWith(Designer.T("Lock", "锁定"))) { this.ToggleLockSel(); }
            else if (it.StartsWith(Designer.T("Properties", "属性"))) {
                this.inspTab = 0;
                app.RequestRedraw();
            }
        } else {
            if (it.StartsWith(Designer.T("View Code", "查看代码"))) {
                this.RequestOpenCodeBehindHandler("");
            }
            else if (it.StartsWith(Designer.T("Paste", "粘贴"))) { this.PasteClip(); }
            else if (it.StartsWith(Designer.T("Select All", "全选"))) {
                this.ClearExtraSel();
                if (fields != null && fields.Count > 0) {
                    sel = fields[0];
                    for (int i = 1; i < fields.Count; i = i + 1) {
                        freeExtra.Add(fields[i]);
                    }
                    this.SyncFreeSelBase();
                    app.RequestRedraw();
                }
            }
            else if (it.StartsWith(Designer.T("Disable Snap", "关闭网格吸附")) || it.StartsWith(Designer.T("Enable Snap", "开启网格吸附"))) {
                snapGrid = !snapGrid;
                app.RequestRedraw();
            }
            else if (it.StartsWith(Designer.T("Hide Pixel Rulers", "隐藏像素标尺")) || it.StartsWith(Designer.T("Show Pixel Rulers", "显示像素标尺"))) {
                showRulers = !showRulers;
                app.RequestRedraw();
            }
            else if (it.StartsWith(Designer.T("Lock All Controls", "锁定所有控件"))) {
                if (fields != null) {
                    for (int i = 0; i < fields.Count; i = i + 1) {
                        fields[i].locked = true;
                    }
                    msg = Designer.T("All controls locked", "已锁定所有控件");
                    app.RequestRedraw();
                }
            }
            else if (it.StartsWith(Designer.T("Properties", "属性"))) {
                this.inspTab = 0;
                this.sel = null;
                app.RequestRedraw();
            }
        }
    }

    // --- 顶层布局 ----------------------------------------------------

    // 每帧入口：基于 Path Hash ID 作用域绘制整个设计器，
    // 确保即时模式控件每帧获得稳定唯一的层级路径 ID，
    // 与保留式长生命周期控件（Input 等）完全物理隔离。
    void Render(App app, int x, int y, int w, int h) {
        app.PushId("Designer");
        if (rowsEdField != null) { app.PushId("RowsEditor"); }
        else if (propsEdField != null) { app.PushId("PropsEditor"); }
        RenderPinned(app, x, y, w, h);
        if (rowsEdField != null || propsEdField != null) { app.PopId(); }
        app.PopId();
    }

    // 宿主把组件面板和属性面板画进自己的 dock 面板里。
    // 分别使用独立的作用域隔离，两面板互不影响。
    void RenderHostPanels(App app, Rect toolRect, Rect propRect) {
        hostPanels = true;
        Canvas c = app.canvas;
        Theme t = app.theme;
        if (toolRect != null && toolRect.width > 1 && toolRect.height > 1 && toolRect.x > -1000) {
            app.PushId("DesignerPalette");
            RenderPalette(app, c, t, toolRect.x, toolRect.y, toolRect.width, toolRect.height);
            app.PopId();
        }
        if (propRect != null && propRect.width > 1 && propRect.height > 1 && propRect.x > -1000) {
            app.PushId("DesignerInspector");
            RenderInspector(app, c, t, propRect.x, propRect.y, propRect.width, propRect.height);
            app.PopId();
        }
    }

    // 设计器本体的一帧：功能区、画布（或 JSON 抽屉）、组件托盘、
    // 左右面板与状态栏；处理键盘快捷键、拖拽收尾、工具箱
    // tooltip、拖拽幽灵块与缩放下拉菜单。
    void RenderPinned(App app, int x, int y, int w, int h) {
        this.hostApp = app;
        Canvas c = app.canvas;
        Theme t = app.theme;
        int statusH = app.Scale(32);
        int top = y + app.Scale(6);
        int bot = y + h - statusH - app.Scale(4);

        // 三栏宽度跟着宿主面板走：宿主窄了先按比例压缩面板和
        // 检查器，压不动就收起来，绝不把内容画到面板外。
        int pad = app.Scale(12);
        // 功能区横跨整个设计器（不只是画布那一栏），
        // 这样命令有地方排，也不会挤到画布上。
        int barH = this.RibbonH(app);
        int bodyY = top + barH + app.Scale(6);
        int palX = x + pad;
        int avail = w - pad * 5;
        if (avail < app.Scale(80)) { avail = app.Scale(80); }
        int palW = app.Scale(176);
        int inspW = app.Scale(288);
        if (hostPanels) { palW = 0; inspW = 0; avail = w - pad * 2; }
        int minCan = app.Scale(220);
        // 宿主模式（hostPanels）下两栏都归零，"按比例压缩"整段没有意义：
        // 跳过它（分母 sum = palW + inspW = 0，除法没有意义——窄区会
        // 除零，把整个 IDE 崩掉）。画布照可用宽度铺满即可。
        // 非宿主模式下 sum = Scale(176) + Scale(288) 恒为正，除法安全。
        if (!hostPanels && palW + inspW + minCan > avail) {
            int side = avail - minCan;
            if (side < 0) { side = 0; }
            int sum = palW + inspW;
            palW = side * palW / sum;
            inspW = side - palW;
            if (palW < app.Scale(130)) { inspW = inspW + palW; palW = 0; }
            if (inspW < app.Scale(190)) { palW = palW + inspW; inspW = 0; }
            if (palW > 0 && palW < app.Scale(130)) { palW = 0; }
        }
        int canW = avail - palW - inspW;
        if (canW < app.Scale(80)) { canW = app.Scale(80); }
        int canX = palX + pad;
        if (palW > 0) { canX = palX + palW + pad; }
        if (hostPanels) { canX = palX; }
        int inspX = canX + canW + pad;
        int bodyH = bot - bodyY;

        // 设计器整体裁剪在宿主给的矩形内。
        c.PushClip(x, y, w, h);
        RenderRibbon(app, c, t, palX, top, w - pad * 2);

        int ek = app.EventKind();
        // 拖拽进行中跟踪指针；实际放置由
        // RenderForm 解析（它掌握行几何）。
        if (dragging && ek == 1) {
            if (app.mouseX != dragMouseX || app.mouseY != dragMouseY) { dragMoved = true; }
            dragMouseX = app.mouseX;
            dragMouseY = app.mouseY;
            app.RequestRedraw();
        }

        hoverFt = -1;
        // 键盘编辑：Delete 删除选中组，Ctrl+Z/Y 撤销重做，
        // Ctrl+C/V 复制粘贴，Ctrl+D 复制副本，方向键按网格步长
        // 微调整组（Shift = 1px，仅自由布局）。文本框持有键盘
        // 焦点时全部忽略，避免影响输入。Ctrl+字母以控制码到达
        // （^Z=26 ^Y=25 ^C=3 ^V=22 ^D=4），和场景设计器一致。
        // 大编辑弹窗开着时整块让位：弹窗里的 Delete/方向键归
        // 弹窗的行/键列表，不能同时改到画布选中的组件。
        if (!preview && app.focus.focusedId < 0 && !app.PointerCaptured()
                && !this.BigEditorOpen()) {
            if (ek == 6) {
                int cc = app.window.EventKeyCode();
                if (cc == 1) { this.SelectAll(); app.RequestRedraw(); }
                else if (cc == 26) { this.Undo(); app.RequestRedraw(); }
                else if (cc == 25) { this.Redo(); app.RequestRedraw(); }
                else if (cc == 24 && sel != null) { this.CutSel(); app.RequestRedraw(); }
                else if (cc == 3) { this.CopySel(); app.RequestRedraw(); }
                else if (cc == 22) { this.PasteClip(); app.RequestRedraw(); }
                else if (cc == 4 && sel != null) { this.DuplicateSel(); app.RequestRedraw(); }
                else if (cc == 12 && sel != null) { this.ToggleLockSel(); app.RequestRedraw(); }
            } else if (ek == 4) {
                int kc = app.window.EventKeyCode();
                bool hasCtrl = Modifiers.HasCtrl(app.window.EventMods());
                bool hasShift = Modifiers.HasShift(app.window.EventMods());
                if (hasCtrl && (kc == 90 || kc == 122) && !hasShift) {
                    this.Undo();
                    app.RequestRedraw();
                } else if (hasCtrl && ((kc == 89 || kc == 121) || ((kc == 90 || kc == 122) && hasShift))) {
                    this.Redo();
                    app.RequestRedraw();
                } else if (hasCtrl && (kc == 65 || kc == 97)) {
                    this.SelectAll();
                    app.RequestRedraw();
                } else if (hasCtrl && (kc == 88 || kc == 120) && sel != null) {
                    this.CutSel();
                    app.RequestRedraw();
                } else if (hasCtrl && (kc == 67 || kc == 99)) {
                    this.CopySel();
                    app.RequestRedraw();
                } else if (hasCtrl && (kc == 86 || kc == 118)) {
                    if (hasShift) {
                        this.DistributeSelGroup(1);
                    } else {
                        this.PasteClip();
                    }
                    app.RequestRedraw();
                } else if (hasCtrl && hasShift && (kc == 72 || kc == 104)) {
                    this.DistributeSelGroup(0);
                    app.RequestRedraw();
                } else if (hasCtrl && (kc == 68 || kc == 100) && sel != null) {
                    this.DuplicateSel();
                    app.RequestRedraw();
                } else if (hasCtrl && (kc == 76 || kc == 108) && sel != null) {
                    this.ToggleLockSel();
                    app.RequestRedraw();
                } else if (hasCtrl && (kc == 73 || kc == 105)) {
                    this.OpenQuickInsert(app);
                    app.RequestRedraw();
                } else if (hasCtrl && (kc == 82 || kc == 114)) {
                    showRulers = !showRulers;
                    app.RequestRedraw();
                } else if (hasCtrl && (kc == 186 || kc == 59)) {
                    showGuides = !showGuides;
                    app.RequestRedraw();
                } else if (hasCtrl && (kc == 48 || kc == 96)) {
                    winZoom = 1000;
                    freePanX = 0;
                    freePanY = 0;
                    msg = Designer.T("zoom: 100%", "缩放: 100%");
                    app.RequestRedraw();
                } else if (hasCtrl && (kc == 49 || kc == 97)) {
                    winZoom = 0;
                    freePanX = 0;
                    freePanY = 0;
                    msg = Designer.T("zoom: fit to window", "缩放: 适应窗口大小");
                    app.RequestRedraw();
                } else if (hasCtrl && (kc == 187 || kc == 61)) {
                    int curZ = winZoom;
                    if (curZ <= 0) { curZ = lastFitPct; }
                    curZ = curZ + 100;
                    if (curZ > 2000) { curZ = 2000; }
                    winZoom = curZ;
                    msg = Designer.T("zoom: ", "缩放: ") + Convert.ToString(winZoom / 10) + "%";
                    app.RequestRedraw();
                } else if (hasCtrl && (kc == 189 || kc == 45 || kc == 173)) {
                    int curZ = winZoom;
                    if (curZ <= 0) { curZ = lastFitPct; }
                    curZ = curZ - 100;
                    if (curZ < 250) { curZ = 250; }
                    winZoom = curZ;
                    msg = Designer.T("zoom: ", "缩放: ") + Convert.ToString(winZoom / 10) + "%";
                    app.RequestRedraw();
                } else if (kc == 112) {
                    keymapHelpOpen = !keymapHelpOpen;
                    app.RequestRedraw();
                } else if (kc == 191 && !hasCtrl) {
                    keymapHelpOpen = !keymapHelpOpen;
                    app.RequestRedraw();
                } else if (hasCtrl && (kc == 71 || kc == 103)) {
                    if (hasShift) { this.UngroupSel(); }
                    else { this.GroupSel(); }
                    app.RequestRedraw();
                } else if (kc == 32) {
                    spacePressed = true;
                    app.RequestRedraw();
                } else if (inlineRenaming && kc == 13) {
                    this.CommitInlineRename();
                } else if (inlineRenaming && kc == 27) {
                    this.CancelInlineRename();
                } else if (kc == 113 && sel != null) {
                    this.StartInlineRename();
                } else if (kc == 27) {
                    if (sel != null || (freeExtra != null && freeExtra.Count > 0)) {
                        sel = null;
                        this.ClearExtraSel();
                        app.RequestRedraw();
                    }
                } else if ((kc == 46 || kc == 8) && sel != null) {
                    DeleteSelGroup();
                    app.RequestRedraw();
                } else if (kc == 33 && sel != null) {
                    MoveSel(1);
                    msg = Designer.T("moved forward", "上移一层");
                    app.RequestRedraw();
                } else if (kc == 34 && sel != null) {
                    MoveSel(0 - 1);
                    msg = Designer.T("moved back", "下移一层");
                    app.RequestRedraw();
                } else if (kc == 36 && Modifiers.HasCtrl(app.window.EventMods()) && sel != null) {
                    this.SelToEdge(1);
                    msg = Designer.T("brought to front", "已置顶");
                    app.RequestRedraw();
                } else if (kc == 35 && Modifiers.HasCtrl(app.window.EventMods()) && sel != null) {
                    this.SelToEdge(0);
                    msg = Designer.T("sent to back", "已置底");
                    app.RequestRedraw();
                } else if (sel != null && kc >= 37 && kc <= 40) {
                    bool hasCtrlKey = Modifiers.HasCtrl(app.window.EventMods());
                    if (hasCtrlKey) {
                        if (kc == 37 || kc == 38) {
                            this.MoveSel(0 - 1);
                            msg = Designer.T("reordered backward", "同级调序: 向前移动一位");
                        } else if (kc == 39 || kc == 40) {
                            this.MoveSel(1);
                            msg = Designer.T("reordered forward", "同级调序: 向后移动一位");
                        }
                        app.RequestRedraw();
                    } else if (sel.position == 0) {
                        bool hasAlt = Modifiers.HasAlt(app.window.EventMods());
                        if (hasAlt) {
                            int step = 1;
                            if (Modifiers.HasShift(app.window.EventMods())) {
                                step = 8;
                                if (snapGrid && gridSize > 0) { step = gridSize; }
                            }
                            int dw = 0;
                            int dh = 0;
                            if (kc == 37) { dw = 0 - step; }
                            else if (kc == 39) { dw = step; }
                            else if (kc == 38) { dh = 0 - step; }
                            else if (kc == 40) { dh = step; }
                            this.ResizeSelByKey(dw, dh);
                        } else {
                            if (kc == 37 || kc == 38) {
                                this.MoveSel(0 - 1);
                                msg = Designer.T("flow reordered backward", "流式调序: 向前移动一位");
                            } else if (kc == 39 || kc == 40) {
                                this.MoveSel(1);
                                msg = Designer.T("flow reordered forward", "流式调序: 向后移动一位");
                            }
                        }
                        app.RequestRedraw();
                    } else {
                        int step = 1;
                        if (Modifiers.HasShift(app.window.EventMods())) {
                            step = 8;
                            if (snapGrid && gridSize > 0) { step = gridSize; }
                        }
                        bool hasAlt = Modifiers.HasAlt(app.window.EventMods());
                        if (hasAlt) {
                            int dw = 0;
                            int dh = 0;
                            if (kc == 37) { dw = 0 - step; }
                            else if (kc == 39) { dw = step; }
                            else if (kc == 38) { dh = 0 - step; }
                            else if (kc == 40) { dh = step; }
                            this.ResizeSelByKey(dw, dh);
                        } else {
                            int ndx = 0;
                            int ndy = 0;
                            if (kc == 37) { ndx = 0 - step; }
                            else if (kc == 39) { ndx = step; }
                            else if (kc == 38) { ndy = 0 - step; }
                            else if (kc == 40) { ndy = step; }
                            this.NudgeSel(ndx, ndy);
                        }
                        app.RequestRedraw();
                    }
                    app.RequestRedraw();
                }
            } else if (ek == 5) {
                int kc = app.window.EventKeyCode();
                if (kc == 32) {
                    spacePressed = false;
                    app.RequestRedraw();
                }
            }
        }
        if (jsonOpen) {
            RenderJsonPanel(app, c, t, canX, bodyY, canW, bodyH);
        } else {
            // 画布下方的 WinForms 风格组件托盘：非可视
            // 组件（右键菜单、图层、定时器、弹窗等）放在这里，
            // 而不占用被设计窗口内的空间。
            int trayH = app.Scale(46);
            RenderForm(app, c, t, canX, bodyY, canW, bodyH - trayH - app.Scale(8));
            RenderTray(app, c, t, canX, bodyY + bodyH - trayH, canW, trayH);
            if (inlineRenaming && sel != null) {
                int rw = app.Scale(260);
                int rh = app.Scale(36);
                int rx = canX + app.Scale(16);
                int ry = bodyY + app.Scale(16);
                if (lastSelViewRect != null && lastSelViewRect.width > 0 && lastSelViewRect.height > 0) {
                    rx = lastSelViewRect.x + (lastSelViewRect.width - rw) / 2;
                    ry = lastSelViewRect.y - rh - app.Scale(6);
                    if (ry < bodyY + app.Scale(8)) {
                        ry = lastSelViewRect.y + lastSelViewRect.height + app.Scale(6);
                    }
                    if (rx < canX + app.Scale(8)) { rx = canX + app.Scale(8); }
                    if (rx + rw > canX + canW - app.Scale(8)) { rx = canX + canW - rw - app.Scale(8); }
                    if (ry + rh > bodyY + bodyH - app.Scale(8)) { ry = bodyY + bodyH - rh - app.Scale(8); }
                }
                c.FillRoundRect(rx, ry, rw, rh, t.borderRadiusSmall,
                    Style.Part(app, "designer", "shadow", "", "", "", Style.SNormal()).BgOr(0));
                c.FillRoundRect(rx - 1, ry - 1, rw, rh, t.borderRadiusSmall,
                    Style.Part(app, "designer", "panel", "", "", "", Style.SNormal()).BgOr(0));
                c.DrawRoundRect(rx - 1, ry - 1, rw, rh, t.borderRadiusSmall,
                    Style.Part(app, "designer", "accent", "", "", "", Style.SNormal()).BorderOr(0), 1);
                int btnW = app.Scale(44);
                int inW = rw - btnW * 2 - app.Scale(20);
                inlineRenameInput.Render(app, rx + app.Scale(6), ry + app.Scale(4), inW, rh - app.Scale(8));
                if (inlineRenameFocusNeeded) {
                    inlineRenameInput.Focus();
                    inlineRenameInput.SelectAll();
                    inlineRenameFocusNeeded = false;
                }
                int okId = SmallBtn(app, Designer.T("OK", "确定"), 1, rx + inW + app.Scale(8), ry + app.Scale(4), btnW);
                int cancelId = SmallBtn(app, Designer.T("Cancel", "取消"), 0, rx + inW + btnW + app.Scale(12), ry + app.Scale(4), btnW);
                if (Ui.Clicked(app, okId)) {
                    this.CommitInlineRename();
                }
                if (Ui.Clicked(app, cancelId)) {
                    this.CancelInlineRename();
                }
            }
        }
        if (palW > 0) { RenderPalette(app, c, t, palX, bodyY, palW, bodyH); }
        if (inspW > 0) { RenderInspector(app, c, t, inspX, bodyY, inspW, bodyH); }
        if (hostPanels) { inspX = palX + avail; }
        RenderStatus(app, c, t, palX, bot, inspX + inspW - palX, statusH);

        // 在表单外结束的拖拽直接取消。指针没动过就是一次点击，
        // 按工具箱的点击添加处理。
        if (dragging && ek == 3) {
            if (dragFromPalette && !dragMoved) { this.PalClickRelease(); }
            palClickPending = false;
            dragging = false;
            dragFromPalette = false;
            dragMoved = false;
            dragIndex = -1;
            dragUserComp = -1;
            dropContainer = null;
            app.RequestRedraw();
        }

        // 面板 tooltip（名称 + 描述），绘制在所有面板之上。
        if (hoverFt >= 0 && !dragging) {
            Tooltip.RenderRich(app, hoverX, hoverY,
                FormField.TypeName(hoverFt), FieldDesc(hoverFt));
        }
        // 拖拽时跟随光标的幽灵块——无论是从面板拖出的
        // 新字段还是被重排的现有行——这样
        // 始终清楚正在拖哪个组件。
        if (dragging && dragMoved) {
            int gkind = dragKind;
            if (!dragFromPalette && dragIndex >= 0 && dragIndex < fields.Count) {
                gkind = fields[dragIndex].ftype;
            }
            string gl = FormField.TypeName(gkind);
            if (gkind == 200 && dragUserComp >= 0 && dragUserComp < userComps.Count) {
                gl = userComps[dragUserComp].name;
                gkind = 18;
            }
            int gh = app.Scale(26);
            int icoW = app.Scale(22);
            int gw = icoW + Canvas.MeasureText(gl, Style.FontFallback(app, "small")) + app.Scale(16);
            int gx = dragMouseX + app.Scale(8);
            int gy = dragMouseY - gh / 2;
            c.FillRoundRect(gx + 1, gy + 2, gw, gh, t.borderRadiusSmall,
                Style.Part(app, "designer", "shadow", "", "", "", Style.SNormal()).BgOr(0));
            c.FillRoundRect(gx, gy, gw, gh, t.borderRadiusSmall, Style.Part(app, "designer", "accent", "", "", "", Style.SNormal()).BgOr(0));
            c.DrawGlyphIn(FieldIcon(gkind), gx + app.Scale(4), gy, icoW, gh,
                Style.FontFallback(app, "small"), Style.Part(app, "designer", "badge", "", "", "", Style.SNormal()).FgOr(0));
            c.DrawText(gx + icoW + app.Scale(4), gy + app.Scale(6), gl, Style.Part(app, "designer", "badge", "", "", "", Style.SNormal()).FgOr(0), Style.FontFallback(app, "small"));
        }

        // 缩放下拉菜单（50%–200%）：画在所有面板之上。开启的
        // 那一帧忽略触发点击（zoomMenuArm），选中档位后设 winZoom。
        if (zoomMenuOpen && rowsEdField == null && propsEdField == null) {
            int zc = ContextMenu.Render(app, zoomMenuX, zoomMenuY, this.ZoomMenuLabels());
            if (!zoomMenuArm) {
                zoomMenuArm = true;
                app.RequestRedraw();
            } else if (zc == 0 - 2) {
                zoomMenuOpen = false;
                app.RequestRedraw();
            } else if (zc >= 0) {
                List<int> zps = this.ZoomPresets();
                if (zc < zps.Count) { winZoom = zps[zc]; }
                zoomMenuOpen = false;
                app.RequestRedraw();
            }
        }

        // 功能区溢出菜单：条带放不下的命令收进「»」的弹出菜单，
        // 画在所有面板之上。arm 跳过打开当帧的那次点击。
        if (ribbonMenuOpen && rowsEdField == null && propsEdField == null) {
            int rc = ContextMenu.Render(app, ribbonMenuX, ribbonMenuY, ribbonMenuLabels);
            if (!ribbonMenuArm) {
                ribbonMenuArm = true;
                app.RequestRedraw();
            } else if (rc == 0 - 2) {
                ribbonMenuOpen = false;
                Ribbon.SetOverflowMenuOpen(false);
                app.RequestRedraw();
            } else if (rc >= 0) {
                ribbonMenuOpen = false;
                Ribbon.SetOverflowMenuOpen(false);
                app.RequestRedraw();
                if (rc < ribbonMenuActs.Count) {
                    this.RunRibbon(app, ribbonMenuActs[rc]);
                }
            }
        }

        if (dpiMenuOpen && rowsEdField == null && propsEdField == null) {
            int dc = ContextMenu.Render(app, dpiMenuX, dpiMenuY, this.DpiMenuLabels());
            if (!dpiMenuArm) {
                dpiMenuArm = true;
                app.RequestRedraw();
            } else if (dc == 0 - 2) {
                dpiMenuOpen = false;
                app.RequestRedraw();
            } else if (dc >= 0) {
                List<int> dps = this.DpiPresets();
                if (dc < dps.Count) { this.SetDesignTargetDpi(app, dps[dc]); }
                dpiMenuOpen = false;
                app.RequestRedraw();
            }
        }

        // 画板右键上下文菜单：画在所有面板之上。
        if (canvasMenuOpen && rowsEdField == null && propsEdField == null) {
            int cc = ContextMenu.Render(app, canvasMenuX, canvasMenuY, this.CanvasMenuLabels());
            if (!canvasMenuArm) {
                canvasMenuArm = true;
                app.RequestRedraw();
            } else if (cc == 0 - 2) {
                canvasMenuOpen = false;
                app.RequestRedraw();
            } else if (cc >= 0) {
                this.HandleCanvasMenu(app, cc);
                canvasMenuOpen = false;
                app.RequestRedraw();
            }
        }
        c.PopClip();

        if (quickInsertOpen) {
            this.RenderQuickInsert(app, c, t, app.canvas.Width(), app.canvas.Height());
        }
        if (keymapHelpOpen) {
            this.RenderKeymapHelp(app, c, t, app.canvas.Width(), app.canvas.Height());
        }

        // 弹窗式大编辑器画在裁剪区之外的最上层：Layer.Modal 的遮罩
        // 与居中坐标都是全画布的，裁在设计器矩形里会把遮罩裁成
        // 一块，宿主面板一窄弹窗边缘也被截掉。
        if (rowsEdField != null) { this.RenderRowsEditor(app, c, t); }
        else if (propsEdField != null) { this.RenderPropsEditor(app, c, t); }
    }

    // --- 工具栏 -------------------------------------------------------------

    // 开启 HTML 预览时替代画布显示的只读抽屉：渲染 SaveHtml()
    // 的落盘内容，回答"这个设计存出来是什么样"。设计改动在画布
    // 和检查器上做——P7a 之后 JSON 只是内部模型，这里不给它
    // 编辑入口（原 Apply→LoadJson 通道已删）。
    void RenderJsonPanel(App app, Canvas c, Theme t, int x, int y, int w, int h) {
        int fs = Style.FontFallback(app, "small");
        c.FillRoundRect(x, y, w, h, app.Scale(6), Style.Part(app, "designer", "panel", "", "", "", Style.SNormal()).BgOr(0));
        c.DrawRoundRect(x, y, w, h, app.Scale(6), Style.Part(app, "designer", "panel", "", "", "", Style.SNormal()).BorderOr(0), 1);
        int pad = app.Scale(12);
        int ix = x + pad;
        int iw = w - pad * 2;
        int iy = y + app.Scale(10);
        c.DrawText(ix, iy, Designer.T(".html DESIGN DOC  ·  read-only preview", ".html 设计稿  ·  只读预览"), Style.Part(app, "designer", "hint", "", "", "", Style.SNormal()).FgOr(0), fs);
        iy = iy + app.Scale(24);
        int btnH = app.Scale(30);
        int taH = y + h - iy - btnH - app.Scale(20);
        if (taH < app.Scale(80)) { taH = app.Scale(80); }
        jsonArea.Render(app, ix, iy, iw, taH);
        int by = iy + taH + app.Scale(8);
        int dumpId = SmallBtn(app, Designer.T("Refresh", "刷新"), 0,
            ix, by, app.Scale(80));
        if (Ui.Clicked(app, dumpId)) {
            jsonArea.SetText(SaveHtml());
            msg = Designer.T("refreshed the .html preview from the current design", "已根据当前设计刷新 .html 预览");
        }
        int closeId = SmallBtn(app, Designer.T("Close", "关闭"), 0,
            ix + iw - app.Scale(70), by, app.Scale(70));
        if (Ui.Clicked(app, closeId)) { jsonOpen = false; }
    }

    // --- 字段面板 / 大纲树 -------------------------------------------------

    // 组件工具箱与大纲树选项卡：
    // palTab == 0: 组件工具箱 TreeView（分组与组件叶子）
    // palTab == 1: 组件大纲树 TreeView（文档完整树状嵌套结构与即时选中）
    void RenderPalette(App app, Canvas c, Theme t, int px, int py, int pw, int ph) {
        if (pw < 20 || ph < 20) { return; }
        int tabH = app.Scale(28);
        int tabW = (pw - app.Scale(6)) / 2;
        int bType = 0; if (palTab == 0) { bType = 1; }
        int oType = 0; if (palTab == 1) { oType = 1; }
        int bId = SmallBtn(app, Designer.T("Palette", "组件库"), bType, px, py, tabW);
        int oId = SmallBtn(app, Designer.T("Outline", "大纲树"), oType, px + tabW + app.Scale(6), py, tabW);
        if (Ui.Clicked(app, bId) && palTab != 0) { palTab = 0; app.RequestRedraw(); }
        if (Ui.Clicked(app, oId) && palTab != 1) { palTab = 1; app.RequestRedraw(); }

        // 即时搜索过滤输入框：支持快速检索组件库与大纲树节点
        int searchH = app.Scale(24);
        int searchY = py + tabH + app.Scale(4);
        filterInput.Render(app, px, searchY, pw, searchH);

        int barH = 0;
        if (palTab == 1) {
            barH = app.Scale(26);
            int barY = searchY + searchH + app.Scale(4);
            int nBtns = 6;
            int gap = app.Scale(3);
            int btnW = (pw - gap * (nBtns - 1)) / nBtns;
            int curX = px;

            // 1. 同级向上移动（大纲树视觉上移一位）
            int upId = SmallIconBtn(app, "chevron-up", 0, curX, barY, btnW);
            curX = curX + btnW + gap;
            if (Ui.Clicked(app, upId)) {
                this.MoveSel(-1);
                this.EnsureOutline();
                app.RequestRedraw();
            }

            // 2. 同级向下移动（大纲树视觉下移一位）
            int downId = SmallIconBtn(app, "chevron-down", 0, curX, barY, btnW);
            curX = curX + btnW + gap;
            if (Ui.Clicked(app, downId)) {
                this.MoveSel(1);
                this.EnsureOutline();
                app.RequestRedraw();
            }

            // 3. 锁定 / 解锁
            string lockIcon = (sel != null && sel.locked) ? "lock" : "unlock";
            int lockId = SmallIconBtn(app, lockIcon, 0, curX, barY, btnW);
            curX = curX + btnW + gap;
            if (Ui.Clicked(app, lockId)) {
                this.ToggleLockSel();
                this.EnsureOutline();
                app.RequestRedraw();
            }

            // 4. 删除
            int delId = SmallIconBtn(app, "trash", 0, curX, barY, btnW);
            curX = curX + btnW + gap;
            if (Ui.Clicked(app, delId)) {
                this.DeleteSelGroup();
                this.EnsureOutline();
                app.RequestRedraw();
            }

            // 5. 全部展开
            int expId = SmallIconBtn(app, "plus", 0, curX, barY, btnW);
            curX = curX + btnW + gap;
            if (Ui.Clicked(app, expId)) { this.OutlineExpandAll(true); }

            // 6. 全部折叠
            int colId = SmallIconBtn(app, "minus", 0, curX, barY, btnW);
            if (Ui.Clicked(app, colId)) { this.OutlineExpandAll(false); }
        }

        int bodyY = searchY + searchH + app.Scale(4) + barH;
        int bodyH = ph - (bodyY - py);
        if (bodyH < 20) { return; }
        if (palTab == 0) {
            this.EnsurePalette();
            palTv.RenderInside(app, new Rect(px, bodyY, pw, bodyH));
        } else {
            this.EnsureOutline();
            outlineTv.RenderInside(app, new Rect(px, bodyY, pw, bodyH));
            if (!preview && !dragging && app.EventKind() == 2 && app.window.EventButton() == 1
                    && InRect(app.mouseX, app.mouseY, px, bodyY, pw, bodyH)) {
                if (sel != null) {
                    canvasMenuOpen = true;
                    canvasMenuArm = false;
                    canvasMenuX = app.mouseX;
                    canvasMenuY = app.mouseY;
                    app.RequestRedraw();
                }
            }
        }
    }

    void EnsureOutline() {
        if (outlineTv == null) {
            outlineNodes = new List<TreeNode>();
            outlineFields = new List<FormField>();
            outlineTv = new TreeView();
            outlineTv.WithFilter(filterInput);
            outlineTv.Empty = Designer.T("No components match.", "没有匹配的组件。");
            outlineTv.OnSelect(() => { this.OnOutlineSelect(); });
            outlineTv.OnActivate(() => {
                if (this.sel != null && Designer.HasDisplayText(this.sel)) {
                    this.StartInlineRename();
                }
            });
            outlineTv.OnContext(() => { this.OnOutlineContext(); });
        }
        string q = filterInput.GetText();
        this.BuildOutline(q);
        outlineTv.Bind(outlineNodes);
        this.SyncOutlineSelection();
    }

    bool FieldOrDescendantMatches(FormField f, string q) {
        if (f == null) { return false; }
        if (q == "") { return true; }
        if (Designer.Contains(f.fname, q) || Designer.Contains(f.label, q)
            || Designer.Contains(FormField.TypeName(f.ftype), q)) {
            return true;
        }
        if (f.kids != null) {
            for (int i = 0; i < f.kids.Count; i = i + 1) {
                if (this.FieldOrDescendantMatches(f.kids[i], q)) { return true; }
            }
        }
        return false;
    }

    void BuildOutline(string q) {
        outlineNodes = new List<TreeNode>();
        outlineFields = new List<FormField>();

        // 根节点：Form 窗口本体
        string rootLbl = Designer.T("Form (Window)", "窗口 (Form)");
        if (winTitle != "") { rootLbl = rootLbl + " · " + winTitle; }
        TreeNode rootNode = TreeNode.Dir(rootLbl, 0, true);
        rootNode.icon = "window";
        rootNode.payload = "root";
        outlineNodes.Add(rootNode);
        outlineFields.Add(null);

        this.AddOutlineChildren(null, 1, q);
    }

    void AddOutlineChildren(FormField parent, int depth, string q) {
        List<FormField> list = parent == null ? fields : parent.kids;
        if (list == null) { return; }
        for (int i = 0; i < list.Count; i = i + 1) {
            FormField f = list[i];
            if (f == null) { continue; }
            if (q != "" && !this.FieldOrDescendantMatches(f, q)) {
                continue;
            }
            string name = f.fname;
            if (name == "") { name = FormField.TypeName(f.ftype); }
            string lbl = name + " (" + FormField.TypeName(f.ftype) + ")";
            if (f.label != "" && f.label != name) {
                lbl = lbl + " · " + f.label;
            }
            if (f.dockSide == 1) { lbl = lbl + " [Top]"; }
            else if (f.dockSide == 2) { lbl = lbl + " [Bottom]"; }
            else if (f.dockSide == 3) { lbl = lbl + " [Left]"; }
            else if (f.dockSide == 4) { lbl = lbl + " [Right]"; }
            else if (f.dockSide == 5) { lbl = lbl + " [Fill]"; }
            else if (f.position == 1) { lbl = lbl + " [Float]"; }

            if (f.locked) { lbl = lbl + " [Locked]"; }
            if (f == this.activeContainer) { lbl = lbl + " [★ Active]"; }

            bool isContainer = FormField.IsContainerOf(f.ftype) || (f.kids != null && f.kids.Count > 0);
            TreeNode node;
            if (isContainer) {
                node = TreeNode.Dir(lbl, depth, true);
            } else {
                node = TreeNode.FileIcon(lbl, depth, this.FieldIcon(f.ftype));
            }
            node.payload = f.fname;
            outlineNodes.Add(node);
            outlineFields.Add(f);

            if (isContainer) {
                this.AddOutlineChildren(f, depth + 1, q);
            }
        }
    }

    void OnOutlineSelect() {
        if (outlineSyncing || outlineTv == null) { return; }
        int idx = outlineTv.SelectedIndex();
        if (idx < 0 || idx >= outlineFields.Count) { return; }
        FormField target = outlineFields[idx];
        outlineSyncing = true;
        this.ClearExtraSel();
        this.sel = target;
        this.inspTab = 0;
        if (target != null) {
            if (this.DesignCanContain(target)) { this.activeContainer = target; }
            else { this.activeContainer = DesignOwnerOf(target); }
            this.msg = Designer.T("selected: ", "已选中：") + target.fname;
        } else {
            this.activeContainer = null;
            this.msg = Designer.T("selected window root", "已选中窗口根节点");
        }
        outlineSyncing = false;
    }

    void OnOutlineContext() {
        if (outlineTv == null) { return; }
        int row = outlineTv.ContextRow();
        if (row >= 0 && row < outlineFields.Count) {
            FormField target = outlineFields[row];
            this.ClearExtraSel();
            this.sel = target;
            this.inspTab = 0;
            if (target != null) {
                if (this.DesignCanContain(target)) { this.activeContainer = target; }
                else { this.activeContainer = DesignOwnerOf(target); }
                this.msg = Designer.T("selected: ", "已选中：") + target.fname;
            } else {
                this.activeContainer = null;
                this.msg = Designer.T("selected window root", "已选中窗口根节点");
            }
            this.SyncOutlineSelection();
        }
        canvasMenuOpen = true;
        canvasMenuArm = false;
        canvasMenuX = outlineTv.ContextX();
        canvasMenuY = outlineTv.ContextY();
        if (this.hostApp != null) { this.hostApp.RequestRedraw(); }
    }

    void SyncOutlineSelection() {
        if (outlineSyncing || outlineTv == null || outlineFields == null) { return; }
        int targetIdx = 0;
        if (sel != null) {
            for (int i = 1; i < outlineFields.Count; i = i + 1) {
                if (outlineFields[i] == sel) { targetIdx = i; break; }
            }
        }
        if (targetIdx > 0 && targetIdx < outlineNodes.Count) {
            int d = outlineNodes[targetIdx].depth;
            int j = targetIdx - 1;
            while (j >= 0) {
                if (outlineNodes[j].depth < d) {
                    if (outlineNodes[j].isDir) {
                        outlineNodes[j].expanded = true;
                    }
                    d = outlineNodes[j].depth;
                }
                j = j - 1;
            }
        }
        if (outlineTv.SelectedIndex() != targetIdx) {
            outlineSyncing = true;
            outlineTv.SelectIndex(targetIdx);
            outlineSyncing = false;
        }
    }

    // 惰性创建工具箱 TreeView，并在过滤串或用户组件数量变化时重建节点。
    void EnsurePalette() {
        if (palTv == null) {
            palNodes = new List<TreeNode>();
            palItems = new List<PaletteItem>();
            palTv = new TreeView();
            palTv.WithFilter(filterInput);
            palTv.Empty = Designer.T("No components match.", "没有匹配的组件。");
            palTv.OnSelect(() => { this.PalActivate(); });
            palTv.OnPress(() => { this.PalPress(); });
            palTv.OnExpand(() => { this.PalFoldNote(false); });
            palTv.OnCollapse(() => { this.PalFoldNote(true); });
            palBuilt = false;
            palBuiltQ = "";
            palBuiltUser = 0 - 1;
        }
        string q = filterInput.GetText();
        if (!palBuilt || q != palBuiltQ || userComps.Count != palBuiltUser) {
            this.BuildPalette(q);
            palBuilt = true;
            palBuiltQ = q;
            palBuiltUser = userComps.Count;
            palTv.Bind(palNodes);
        }
    }

    // 重建工具箱节点。过滤串非空时是一层扁平的匹配结果，
    // 否则是按类别分组的两层树。
    void BuildPalette(string q) {
        palNodes = new List<TreeNode>();
        palItems = new List<PaletteItem>();
        if (q != "") {
            for (int ft = 0; ft <= FormField.MaxType(); ft = ft + 1) {
                if (this.MatchesFilter(ft, q)) {
                    this.PalLeaf(FormField.TypeName(ft), FieldIcon(ft), ft, "", 0);
                }
            }
            for (int k = 0; k < userComps.Count; k = k + 1) {
                if (Designer.Contains(userComps[k].name, q)) {
                    this.PalLeaf(userComps[k].name, "layout", 200,
                        userComps[k].name, 0);
                }
            }
            return;
        }
        this.PalGroup(Designer.T("Basic", "基础"), 0, 8);
        this.PalGroup(Designer.T("Advanced", "高级"), 8, 15);
        this.PalGroup(Designer.T("Layout", "布局"), 15, 18);
        this.PalGroup(Designer.T("Display", "展示"), 18, 28);
        this.PalGroup(Designer.T("Feedback", "反馈"), 28, 34);
        this.PalGroup(Designer.T("Navigation", "导航"), 34, 40);
        this.PalGroup(Designer.T("Display+", "展示+"), 40, 47);
        this.PalGroup(Designer.T("Feedback+", "反馈+"), 47, 53);
        this.PalGroup(Designer.T("More", "更多"), 53, 55);
        this.PalGroup(Designer.T("Non-visual", "功能组件"), 55, 58);
        this.PalGroup(Designer.T("Shell", "窗口外壳"), 58, 62);
        this.PalGroup(Designer.T("Industrial", "工控"), 62, 72);
        this.PalGroup(Designer.T("Web", "网页"), 72, 73);
        this.PalGroup(Designer.T("Extended", "扩展"), 73, 86);
        if (userComps.Count > 0) {
            this.PalDir(Designer.T("My Components", "我的组件"));
            for (int k = 0; k < userComps.Count; k = k + 1) {
                this.PalLeaf(userComps[k].name, "layout", 200,
                    userComps[k].name, 1);
            }
        }
    }

    // 添加一个分组目录及其 [lo, hi) 类型区间内的组件叶子。
    void PalGroup(string title, int lo, int hi) {
        this.PalDir(title);
        for (int ft = lo; ft < hi; ft = ft + 1) {
            this.PalLeaf(FormField.TypeName(ft), FieldIcon(ft), ft, "", 1);
        }
    }

    // 添加一个分组目录节点（折叠状态按标题跨帧记忆）。
    void PalDir(string title) {
        palNodes.Add(TreeNode.Dir(title, 0, !this.PalFolded(title)));
        palItems.Add(new PaletteItem(0 - 1, ""));
    }

    // 添加一个组件叶子节点（palItems 与行下标一一对应）。
    void PalLeaf(string label, string icon, int kind, string custom, int depth) {
        palNodes.Add(TreeNode.FileIcon(label, depth, icon));
        palItems.Add(new PaletteItem(kind, custom));
    }

    // 事件涉及的行是组件叶子时返回其下标，否则返回 -1。
    int PalLeafRow() {
        int row = palTv.ContextRow();
        if (preview) { return 0 - 1; }
        if (row < 0 || row >= palItems.Count) { return 0 - 1; }
        if (palNodes[row].isDir) { return 0 - 1; }
        return row;
    }

    // 按名查找用户组件下标，不存在时 -1。
    int UserCompIndex(string name) {
        for (int k = 0; k < userComps.Count; k = k + 1) {
            if (userComps[k].name == name) { return k; }
        }
        return 0 - 1;
    }

    // 单击工具箱里的组件即添加一个；随后清掉选中，
    // 这样连点同一行可以连续添加。实际添加发生在抬起时
    // （见 PalClickRelease），因为按下这一刻还分不清点击和拖拽。
    void PalActivate() {
        int row = this.PalLeafRow();
        if (row < 0) { return; }
        palClickKind = palItems[row].kind;
        palClickCustom = palItems[row].custom;
        palClickPending = true;
        palTv.ClearSelection();
    }

    // 在工具箱上按下又原地抬起：这是一次点击，添加组件。
    void PalClickRelease() {
        if (!palClickPending) { return; }
        palClickPending = false;
        if (palClickKind == 200) {
            int k = this.UserCompIndex(palClickCustom);
            if (k >= 0) { AddUserComponent(k); }
        } else if (palClickCustom != "") {
            AddCustomField(palClickCustom);
        } else {
            AddField(palClickKind);
        }
    }

    // 在组件行上按下即开始一次拖拽，拖到画布上放开即添加。
    void PalPress() {
        int row = this.PalLeafRow();
        if (row < 0) { return; }
        dragging = true;
        dragFromPalette = true;
        dragMoved = false;
        dragKind = palItems[row].kind;
        dragCustomKind = "";
        dragUserComp = 0 - 1;
        if (dragKind == 200) {
            dragUserComp = this.UserCompIndex(palItems[row].custom);
        } else if (palItems[row].custom != "") {
            dragCustomKind = palItems[row].custom;
        }
        dragMouseX = palTv.ContextX();
        dragMouseY = palTv.ContextY();
    }

    // 记住分组的折叠状态，重建节点后仍然保留。
    void PalFoldNote(bool folded) {
        int row = palTv.ContextRow();
        if (row < 0 || row >= palNodes.Count) { return; }
        string title = palNodes[row].label;
        if (this.PalFolded(title) != folded) { this.PalToggleFold(title); }
    }

    // 当字段类型的 key 或显示名包含过滤关键字时为 true。
    bool MatchesFilter(int ft, string q) {
        if (q == "") { return true; }
        return Designer.Contains(FormField.TypeKey(ft), q)
            || Designer.Contains(FormField.TypeName(ft), q);
    }

    // 已折叠的分组标题。折叠状态按标题记住，跨帧保留。
    bool PalFolded(string title) {
        for (int i = 0; i < palFolded.Count; i = i + 1) {
            if (palFolded[i] == title) { return true; }
        }
        return false;
    }

    // 切换分组标题的折叠记忆。
    void PalToggleFold(string title) {
        for (int i = 0; i < palFolded.Count; i = i + 1) {
            if (palFolded[i] == title) {
                palFolded = ListRemoveStr(palFolded, i);
                return;
            }
        }
        palFolded.Add(title);
    }

    // 重建不含 idx 处元素的字符串列表（与 ListMove 同一规避）。
    static List<string> ListRemoveStr(List<string> src, int idx) {
        List<string> outl = new List<string>();
        for (int i = 0; i < src.Count; i = i + 1) {
            if (i != idx) { outl.Add(src[i]); }
        }
        return outl;
    }

    // 点是否在矩形内（含右/下边界）。
    bool InRect(int mx, int my, int x, int y, int w, int h) {
        return mx >= x && mx <= x + w && my >= y && my <= y + h;
    }

    // WinForms 风格组件托盘：表单上的每个非可视组件
    // 在此显示为一个小块。点击选中它，其属性和
    // 事件即可在检查器中编辑；选中的小块会高亮。
    void RenderTray(App app, Canvas c, Theme t, int x, int y, int w, int h) {
        int fs = Style.FontFallback(app, "small");
        c.FillRoundRect(x, y, w, h, app.Scale(6), Style.Part(app, "designer", "panel", "", "", "", Style.SNormal()).BgOr(0));
        c.DrawRoundRect(x, y, w, h, app.Scale(6), Style.Part(app, "designer", "panel", "", "", "", Style.SNormal()).BorderOr(0), 1);
        bool overTray = dragging && dragFromPalette
            && FormField.IsNonVisualOf(dragKind)
            && InRect(dragMouseX, dragMouseY, x, y, w, h);
        if (overTray) { c.DrawRect(x, y, w, h, Style.Part(app, "designer", "accent", "", "", "", Style.SNormal()).BgOr(0), 2); }
        int bx = x + app.Scale(10);
        int by = y + (h - app.Scale(28)) / 2;
        bool any = false;
        for (int i = 0; i < fields.Count; i = i + 1) {
            FormField f = fields[i];
            if (f.IsNonVisual()) {
                any = true;
                string nm = f.fname;
                if (nm == "") { nm = FormField.TypeName(f.ftype); }
                int ty = 0;
                if (!preview && f == sel) { ty = 1; }
                int bid = app.focus.AllocId();
                Button b = new Button { wid = bid, Text = nm, Icon = FieldIcon(f.ftype),
                                        Class = "small " + Style.TypeClass(ty) };
                int bw = Canvas.MeasureText(nm, fs) + app.Scale(44);
                int id = b.Render(app, bx, by, bw);
                if (!preview && Ui.Clicked(app, id)) {
                    sel = f;
                    activeContainer = null;
                    inspTab = 0;
                    app.RequestRedraw();
                }
                bx = bx + bw + app.Scale(8);
            }
        }
        if (!any) {
            c.DrawText(bx, Canvas.CenterTextY(y, h, fs),
                Designer.T("Component tray — context menus, layers, timers and other non-visual components land here.",
                    "组件托盘 —— 右键菜单、Layer、定时器等功能组件会放在这里。"),
                Style.Part(app, "designer", "hint", "", "", "", Style.SNormal()).FgOr(0), fs);
        }
        // 把非可视字段的拖拽放到托盘任意位置即可添加。
        if (overTray && app.EventKind() == 3) {
            activeContainer = null;
            AddField(dragKind);
            dragging = false;
            dragFromPalette = false;
            dragMoved = false;
            dropContainer = null;
            app.RequestRedraw();
        }
    }

    // 把字段的列跨度限制到合法的 1..24 网格范围。
    int ClampSpan(int sp) {
        if (sp < 1) { return 24; }
        if (sp > 24) { return 24; }
        return sp;
    }

