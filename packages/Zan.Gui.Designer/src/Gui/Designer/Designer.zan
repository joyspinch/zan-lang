        this.dragFromPalette = false;
        this.dragCustomKind = "";
        this.dragMoved = false;
        this.dragKind = 0;
        this.dragIndex = -1;
        this.dropIndex = -1;
        this.dropY = 0;
        this.dragMouseX = 0;
        this.dragMouseY = 0;
        this.dropContainer = null;
        this.dragUserComp = -1;
        this.hoverFt = -1;
        this.hoverX = 0;
        this.hoverY = 0;
        this.propGrid = new PropertyGrid();
        WeakReference<Designer> w = new WeakReference<Designer>(this);
        this.propGrid.OnBeforeChange((string propKey) => {
            Designer self = w.Target;
            if (self == null) { return; }
            if (self.sel != null) {
                self.GateInspectorUndo("pg|" + self.sel.fname + "|" + propKey);
            }
        });
        this.propGrid.OnChange(() => {
            Designer self = w.Target;
            if (self == null) { return; }
            if (self.sel != null) {
                string chKey = self.propGrid.ChangedKey();
                if (chKey == "position") {
                    if (self.sel.position == 1) {
                        self.sel.dockSide = 0;
                        if (self.sel.fw <= 0) { self.sel.fw = self.sel.LayoutW() > 0 ? self.sel.LayoutW() : 120; }
                        if (self.sel.fh <= 0) { self.sel.fh = FormField.DefaultHFor(self.sel.ftype); }
                    } else if (self.sel.position == 0) {
                        if (self.sel.dockSide == 0 && self.layoutMode == 1) {
                            self.sel.dockSide = 1;
                        }
                    }
                } else if (chKey == "dock") {
                    if (self.sel.ftype == 58 || self.sel.kind == "ToolStrip") {
                        int idx = self.propGrid.GetInt("dock", 0);
                        self.sel.dockSide = (idx == 1) ? 2 : 1;
                        self.sel.position = 0;
                    } else if (self.sel.ftype == 59 || self.sel.kind == "StatusBar") {
                        self.sel.dockSide = 2;
                        self.sel.position = 0;
                    } else {
                        if (self.sel.dockSide > 0) {
                            self.sel.position = 0;
                        } else {
                            if (self.layoutMode == 1) {
                                self.sel.position = 1;
                            }
                        }
                    }
                    self.ApplyResizeToFields(self.fields, self.winW, self.winH, 0, 0);
                } else if (chKey == "flexWrap") {
                    self.sel.flexWrap = self.propGrid.Value("flexWrap") == "true";
                } else if (chKey == "w" || chKey == "h") {
                    self.ApplyResizeToFields(self.fields, self.winW, self.winH, 0, 0);
                }
                self.DesignDeclareRect(self.sel);
                if (self.freeExtra != null && self.freeExtra.Count > 0) {
                    self.SyncBatchProps(self.sel, chKey);
                }
            } else {
                string chKey = self.propGrid.ChangedKey();
                if (chKey == "width" || chKey == "height") {
                    int nw = self.propGrid.GetInt("width", self.winW);
                    int nh = self.propGrid.GetInt("height", self.winH);
                    self.ApplyDesignSize(nw, nh);
                } else if (chKey == "title") {
                    if (self.winTitleInput != null) {
                        self.winTitleInput.SetText(self.winTitle);
                    }
                } else if (chKey == "layoutMode") {
                    self.SetLayoutMode(self.layoutMode);
                }
            }
            self.MarkDocDirty();
        });
        this.inspKeySeq = 0;
        this.optInput = new Input(Designer.T("new option", "新选项"));
        this.optFieldInput = new Input(Designer.T("field", "字段"));
        this.evtInput = new Input(Designer.T("handler", "处理器"));
        this.evtEditing = "";
        this.candidateHandlers = new List<string>();
