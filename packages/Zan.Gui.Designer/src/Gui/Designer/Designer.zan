    // 把工具箱滚到末尾。
    void ScrollPaletteToEnd() {
        this.EnsurePalette();
        palTv.ScrollToEnd();
    }

    // 可选的示例内容，让新建的设计器不是空表单——
    // 包含一个 Card 和带嵌套组件的 Tabs 容器，让组合 /
    // 标签切换行为开箱即可见。
    void Seed(App app) {
        activeContainer = null;
        AddField(0); fields[fields.Count - 1].span = 12;
        AddField(2); fields[fields.Count - 1].span = 12;
        AddField(3); fields[fields.Count - 1].span = 8;
        AddField(6); fields[fields.Count - 1].span = 8;
        AddField(7); fields[fields.Count - 1].span = 8;

        // 带嵌套子级的 Card 容器。
        activeContainer = null;
        AddField(18);
        AddField(15);
        AddField(0);

        // Tabs 容器：标签 1 放表格 + 统计，标签 2 放 alert。
        activeContainer = null;
        AddField(36);
        AddField(23);
        AddField(22);
        if (activeContainer != null) { activeContainer.uiState.Set(1); }
        AddField(28);
        if (activeContainer != null) { activeContainer.uiState.Set(0); }

        // 一个全宽图表。
        activeContainer = null;
        AddField(43);

        activeContainer = null;
        sel = null;
        selPrev = null;
        inspTab = 0;
    }

    // --- 字段变更 ------------------------------------------------------

    // `f` 是否还挂在设计树上。删除组件后 activeContainer /
    // dropContainer 这类引用可能指向已经被删掉的容器，往里加组件
    // 会得到一个谁也看不见、也存不下去的字段。
    bool FieldAlive(List<FormField> lst, FormField f) {
        for (int i = 0; i < lst.Count; i = i + 1) {
            if (lst[i] == f) { return true; }
            if (this.FieldAlive(lst[i].kids, f)) { return true; }
        }
        return false;
    }

    // 丢弃指向已删组件的容器引用。
    void DropDeadRefs() {
        if (activeContainer != null && !this.FieldAlive(fields, activeContainer)) {
            activeContainer = null;
        }
        if (dropContainer != null && !this.FieldAlive(fields, dropContainer)) {
            dropContainer = null;
        }
        if (sel != null && !this.FieldAlive(fields, sel)) {
            sel = null;
            selPrev = null;
            freeExtra = new List<FormField>();
        }
    }

    // 添加新组件。有活动容器时组件会嵌套进去（Tabs 则进入活动
    // 标签页）；否则追加到顶层表单。添加容器后会把它设为活动
    // 容器，可以立刻往里面放置组件。
    void AddField(int ftype) {
        this.PushUndo();
        this.DropDeadRefs();
        FormField f = FormField.New(ftype, seq);
        seq = seq + 1;
        if (FormField.IsNonVisualOf(ftype)) {
            // 非可视组件始终位于顶层：画布下方的
            // 托盘展示它们，从不放进容器。
            fields.Add(f);
            sel = f;
            inspTab = 0;
            msg = Designer.T("added ", "已添加 ") + FormField.TypeName(ftype);
            return;
        }
        if (layoutMode == 1) {
            f.fw = DefaultFreeW(f);
            f.fh = DefaultFreeH(f);
            this.PlaceFree(f, activeContainer, 40 + (seq % 10) * 16 + f.fw / 2, 40 + (seq % 10) * 16 + f.fh / 2);
            if (f.IsContainer()) { activeContainer = f; }
            msg = Designer.T("added ", "已添加 ") + FormField.TypeName(ftype);
            return;
        }
        if (activeContainer != null) {
            f.childTab = 0;
            if (activeContainer.kind == "Tabs") {
                f.childTab = Designer.TabActivePage(activeContainer);
            }
            activeContainer.kids.Add(f);
        } else {
            fields.Add(f);
        }
        sel = f;
        inspTab = 0;
        if (f.IsContainer()) { activeContainer = f; }
        msg = Designer.T("added ", "已添加 ") + FormField.TypeName(ftype);
    }

    // 一键插入工业级常用界面骨架复合模板 (Starter Layout Presets)：
    // 1 = 经典主窗口 (Toolbar Top + Content Fill + StatusBar Bottom)
    // 2 = 左右双栏工作台 (Sidebar Left + Workspace Fill)
    // 3 = 标准水平表单行 (Label + Input Fill + Action Button)
    // 4 = 对话框底部操作栏 (ActionBar Bottom + Right-aligned Cancel/OK Buttons)
    void InsertStarterPreset(int presetId) {
        this.PushUndo();
        this.DropDeadRefs();
        FormField targetParent = activeContainer;
        if (targetParent == null && sel != null && FormField.IsContainerOf(sel.ftype)) {
            targetParent = sel;
        }

        if (presetId == 1) {
            // 经典主窗口骨架 (Toolbar Top + Content Fill + StatusBar Bottom)
            FormField tb = FormField.New(58, seq); seq = seq + 1;
            tb.label = Designer.T("Toolbar", "工具栏");
            tb.dockSide = 1; // Top
            tb.position = 0;
            tb.fh = 34;
            tb.fw = winW;
            tb.fx = 0;
            tb.fy = 0;
            tb.options = new List<string>();
            tb.options.Add(Designer.T("New", "新建"));
            tb.options.Add(Designer.T("Open", "打开"));
            tb.options.Add(Designer.T("Save", "保存"));
            tb.options.Add("|");
            tb.options.Add(Designer.T("Run", "运行"));

            FormField content = FormField.New(45, seq); seq = seq + 1;
            content.label = Designer.T("Main Content", "主内容区");
            content.dockSide = 5; // Fill
            content.position = 0;
            content.flexGrow = 1;
            content.fh = 0;
            content.fw = 0;
            content.flexDir = 0; // Col
            content.padding = 12;
            content.gap = 8;

            FormField card = FormField.New(18, seq); seq = seq + 1;
            card.label = Designer.T("Workspace Card", "工作区面板");
            card.flexGrow = 1;
            card.fh = 0;
            content.kids.Add(card);

            FormField sb = FormField.New(59, seq); seq = seq + 1;
            sb.label = Designer.T("Ready", "就绪");
            sb.dockSide = 2; // Bottom
            sb.position = 0;
            sb.fh = 24;
            sb.fw = winW;
            sb.fx = 0;
            sb.fy = (this.winChrome ? (winH - 32) : winH) - sb.fh;
            if (sb.fy < 0) { sb.fy = 0; }

            if (targetParent != null) {
                targetParent.kids.Add(tb);
                targetParent.kids.Add(content);
                targetParent.kids.Add(sb);
            } else {
                fields.Add(tb);
                fields.Add(content);
                fields.Add(sb);
            }
            sel = content;
            activeContainer = content;
            msg = Designer.T("Inserted: Classic App Skeleton", "已插入: 经典主窗口骨架 (Toolbar + Content + StatusBar)");
        } else if (presetId == 2) {
            // 左右双栏工作台 (Sidebar Left + Workspace Fill)
            FormField split = FormField.New(45, seq); seq = seq + 1;
            split.label = Designer.T("Workspace Container", "分栏工作区");
            split.dockSide = 5; // Fill
            split.position = 0;
            split.flexGrow = 1;
            split.fh = 0;
            split.fw = 0;
            split.flexDir = 1; // Row
            split.padding = 0;
            split.gap = 0;

            FormField side = FormField.New(45, seq); seq = seq + 1;
            side.label = Designer.T("Sidebar", "侧边栏");
            side.dockSide = 3; // Left
            side.position = 0;
            side.fw = 220;
            side.fh = 0;
            side.flexGrow = 0;
            side.flexDir = 0; // Col
            side.padding = 10;
            side.gap = 6;

            FormField navLbl = FormField.New(15, seq); seq = seq + 1;
            navLbl.label = Designer.T("Navigation", "导航目录");
            navLbl.fw = 0;
            navLbl.fh = 24;
            side.kids.Add(navLbl);

            FormField navTree = FormField.New(25, seq); seq = seq + 1;
            navTree.flexGrow = 1;
            navTree.fh = 0;
            side.kids.Add(navTree);

            FormField mainArea = FormField.New(45, seq); seq = seq + 1;
            mainArea.label = Designer.T("Main View", "主视口");
            mainArea.dockSide = 5; // Fill
            mainArea.position = 0;
            mainArea.fw = 0;
            mainArea.fh = 0;
            mainArea.flexGrow = 1;
            mainArea.flexDir = 0; // Col
            mainArea.padding = 16;
            mainArea.gap = 12;

            split.kids.Add(side);
            split.kids.Add(mainArea);

            if (targetParent != null) {
                targetParent.kids.Add(split);
            } else {
                fields.Add(split);
            }
            sel = split;
            activeContainer = mainArea;
            msg = Designer.T("Inserted: Split Workspace", "已插入: 左右双栏工作区 (Sidebar + Main View)");
        } else if (presetId == 3) {
            // 标准水平表单行 (Label + Input Fill + Action Button)
            FormField row = FormField.New(45, seq); seq = seq + 1;
            row.label = Designer.T("Form Row", "表单行");
            row.position = 0;
            row.fh = 36;
            row.fw = 0;
            row.flexDir = 1; // Row
            row.alignItems = 1; // Center
            row.padding = 4;
            row.gap = 8;

            FormField lbl = FormField.New(15, seq); seq = seq + 1;
            lbl.label = Designer.T("Field Name:", "配置字段:");
            lbl.fw = 80;
            lbl.fh = 24;

            FormField inp = FormField.New(0, seq); seq = seq + 1;
            inp.placeholder = Designer.T("Please enter value...", "请输入内容...");
            inp.fw = 0;
            inp.fh = 28;
            inp.flexGrow = 1; // 填满行宽度

            FormField btn = FormField.New(15, seq); seq = seq + 1;
            btn.label = Designer.T("Apply", "确认操作");
            btn.fw = 76;
            btn.fh = 28;

            row.kids.Add(lbl);
            row.kids.Add(inp);
            row.kids.Add(btn);

            if (targetParent != null) {
                targetParent.kids.Add(row);
            } else {
                fields.Add(row);
            }
            sel = row;
            msg = Designer.T("Inserted: Standard Form Row", "已插入: 标准表单行 (Label + Input Fill + Button)");
        } else if (presetId == 4) {
            // 对话框底部操作栏 (ActionBar Bottom + Right-aligned Cancel/OK Buttons)
            FormField bar = FormField.New(45, seq); seq = seq + 1;
            bar.label = Designer.T("Dialog Actions", "底部操作栏");
            bar.dockSide = 2; // Bottom
            bar.position = 0;
            bar.fh = 46;
            bar.fw = 0;
            bar.flexDir = 1; // Row
            bar.justify = 2; // End (靠右)
            bar.alignItems = 1; // Center
            bar.padding = 8;
            bar.gap = 8;

            FormField btnCancel = FormField.New(15, seq); seq = seq + 1;
            btnCancel.label = Designer.T("Cancel", "取消");
            btnCancel.fw = 72;
            btnCancel.fh = 28;

            FormField btnOk = FormField.New(15, seq); seq = seq + 1;
            btnOk.label = Designer.T("OK", "确定");
            btnOk.fw = 72;
            btnOk.fh = 28;

            bar.kids.Add(btnCancel);
            bar.kids.Add(btnOk);

            if (targetParent != null) {
                targetParent.kids.Add(bar);
            } else {
                fields.Add(bar);
            }
            sel = bar;
            msg = Designer.T("Inserted: Dialog Action Buttons", "已插入: 对话框底部操作栏 (Cancel + OK)");
        }
        this.MarkDocDirty();
        if (this.hostApp != null) { this.hostApp.RequestRedraw(); }
    }

    // 宿主 IDE 提供从表单配对的 code-behind 文件
    // 扫描出的可绑定变量名（见检查器的绑定路径选择器）。
    void SetBindVars(List<string> vars) {
        bindVars = vars;
        bindPickOpen = false;
    }

    // 宿主 IDE 提供从表单配对的 code-behind 文件
    // 扫描出的候选事件处理器方法清单（用于检查器事件下拉推荐）。
    void SetCandidateHandlers(List<string> handlers) {
        if (handlers == null) { candidateHandlers = new List<string>(); }
        else { candidateHandlers = handlers; }
    }

    // 宿主 IDE 提供项目保存的用户组件（每个组件一个实体，
    // 来自 components/*.zcomp）。组件文档可能随时被重新加载
    // 或保存，引用节点据此作废预览缓存。
    void SetUserComponents(List<UserComponent> comps) {
        userComps = comps;
        UserComponentRegistry.SetAll(comps);
        pvCompGen = pvCompGen + 1;
        this.MarkDocDirty();
    }

    // 组件名对应的 .zcomp 文档原文；不存在返回 ""。
    string UserCompJson(string name) {
        for (int i = 0; i < userComps.Count; i = i + 1) {
            if (userComps[i].name == name) { return userComps[i].json; }
        }
        return "";
    }

    // 用户请求把当前设计保存为可复用组件后，恰好返回一次 true；
    // 宿主 IDE 持久化它并重新加载列表。
    bool ConsumeSaveComponent() {
        if (saveCompRequested) { saveCompRequested = false; return true; }
        return false;
    }

    // 表单名称输入框的当前文本（宿主保存组件时用作文件名）。
    string FormNameText() {
        return formNameInput.GetText();
    }

    // 双击引用节点后恰好返回一次组件名（"" 表示无请求）；宿主
    // 打开 components/<名>.zcomp 文档本身供编辑。
    string ConsumeOpenComponent() {
        if (openCompRequested) {
            openCompRequested = false;
            return openCompName;
        }
        return "";
    }

    // 双击普通字段/控件后恰好返回一次控件名称（"" 表示无请求）；宿主
    // 自动切换到 code-behind（.zan）源码并定位/生成事件桩。
    string ConsumeOpenCodeBehind() {
        if (openCodeBehindRequested) {
            openCodeBehindRequested = false;
            return openCodeBehindField;
        }
        return "";
    }

    // 消费控件重命名事件：返回 "旧名:新名"，供宿主 IDE 同步更新 code-behind 源码。
    string ConsumeRenamedField() {
        if (renamedOldField != "" && renamedNewField != "") {
            string r = renamedOldField + ":" + renamedNewField;
            renamedOldField = "";
            renamedNewField = "";
            return r;
        }
        return "";
    }

    // 在表单上放置一个已保存用户组件的**引用**节点：设计文档里
    // 只写 {"kind":名,"ref":名,...}——组件设计的每次进化自动
    // 跟随所有实例（WinForms UserControl 语义），要改内部就打开
    // 组件本身，检查器提供「解包为内联副本」作逃生门。默认矩形
    // 取组件文档自己的画布尺寸（winW/winH），缺省 240x一行高。
    // 画布预览按组件文档用 FormBuilder 建真控件渲染。
    void AddUserComponent(int k) {
        if (k < 0 || k >= userComps.Count) { return; }
        this.DropDeadRefs();
        FormField f = FormField.NewCustom(userComps[k].name, seq);
        seq = seq + 1;
        f.compRef = true;
        JsonValue doc = JsonValue.ParseLenient(userComps[k].json);
        int dw = 240;
        int dh = 0;
        if (doc != null) {
            dw = doc.Int("winW", 240);
            dh = doc.Int("winH", 0);
        }
        if (dw < 60) { dw = 60; } else if (dw > 2000) { dw = 2000; }
        if (dh <= 0) { dh = f.RowUnits(); }
        if (dh < 28) { dh = 28; } else if (dh > 2000) { dh = 2000; }
        f.fw = dw;
        f.fh = dh;
        if (activeContainer != null) {
            f.childTab = 0;
            if (activeContainer.kind == "Tabs") {
                f.childTab = Designer.TabActivePage(activeContainer);
            }
            activeContainer.kids.Add(f);
        } else {
            fields.Add(f);
        }
        sel = f;
        inspTab = 0;
        msg = Designer.T("added ", "已添加 ") + userComps[k].name
            + Designer.T(" (reference)", "（引用）");
    }

    // 「解包为内联副本」：把引用节点换成组件文档的字段树
    // （单容器文档直接换成那个容器，多字段的包一层同名
    // Card），首节点继承引用的矩形/停靠/跨度。解包后的副本
    // 与组件脱钩，之后组件进化不再跟随。
    void UnpackUserComponent(FormField f) {
        string doc = this.UserCompJson(f.customKind);
        if (doc == "") {
            msg = Designer.T("component not found: ", "找不到组件：")
                + f.customKind;
            return;
        }
        List<FormField> parsed = this.ParseComponentFields(doc);
        if (parsed.Count == 0) {
            msg = Designer.T("component has no fields: ", "组件没有字段：")
                + f.customKind;
            return;
        }
        this.PushUndo();
        List<FormField> host = fields;
        FormField owner = this.ParentContainerOf(f);
        if (owner != null) { host = owner.kids; }
        int idx = IndexIn(host, f);
        if (idx < 0) { return; }
        FormField head = null;
        if (parsed.Count == 1 && parsed[0].IsContainer()) {
            head = parsed[0];
        } else {
            head = FormField.New(18, seq);
            seq = seq + 1;
            head.label = f.customKind;
            head.kids = parsed;
            for (int ci = 0; ci < parsed.Count; ci = ci + 1) { parsed[ci].childTab = 0; }
        }
        head.fname = f.fname;
        head.name = f.name;
        head.fx = f.fx;
        head.fy = f.fy;
        head.fw = f.fw;
        head.fh = f.fh;
        head.dockSide = f.dockSide;
        head.span = f.span;
        head.childTab = f.childTab;
        host[idx] = head;
        sel = head;
        msg = Designer.T("unpacked ", "已解包 ") + f.customKind;
    }

    // 组件文档根上声明的对外属性（"props":[{key,label,kind,
    // target,prop,def}]，v1 只消费 text 型），解析进强类型实体缓存，
    // 缓存键为 组件名|代次。组件没声明或文档缺失时表为空。
    void EnsureCompPropDecls(string compName) {
        string id = compName + "|" + Convert.ToString(pvCompGen);
        if (compPropFor == id) { return; }
        compPropFor = id;
        compPropDecls.Clear();
        string doc = this.UserCompJson(compName);
        if (doc == "") { return; }
        JsonValue root = JsonValue.ParseLenient(doc);
        if (root == null) { return; }
        JsonValue decls = root.Get("props");
        if (decls == null || !decls.IsArray()) { return; }
        for (int i = 0; i < decls.Count(); i = i + 1) {
            JsonValue dd = decls.At(i);
            if (dd == null || !dd.IsObject()) { continue; }
            string key = dd.Str("key", "");
            string target = dd.Str("target", "");
            if (key == "" || target == "") { continue; }
            compPropDecls.Add(new CompPropDecl(key, dd.Str("label", key), dd.Str("def", "")));
        }
    }

    // 引用节点实例值读/写：存 f.extra 的 "props" 直通对象
    // （"props" 不在 IsModeledKey 里，SaveJson/LoadJson 原样
    // 透传，GenForm 展开时落给目标内部控件）。
    static string CompPropValue(FormField f, string key, string def) {
        if (f.extra == null) { return def; }
        JsonValue props = f.extra.Get("props");
        if (props == null || !props.IsObject()) { return def; }
        return props.Str(key, def);
    }

    static void SetCompPropValue(FormField f, string key, string val) {
        if (f.extra == null) { f.extra = JsonValue.NewObject(); }
        JsonValue props = f.extra.Get("props");
        if (props == null || !props.IsObject()) {
            props = JsonValue.NewObject();
            f.extra.Put("props", props);
        }
        props.Set(key, JsonValue.NewStr(val));
    }

    // 告警横幅语义词 → Layer 通知类型（2 info / 3 success /
    // 4 warning / 5 error）；数字串与角色词都认，其余落 info。
    static int AlertLevelOf(string spec) {
        if (spec == "success" || spec == "3") { return 3; }
        if (spec == "warning" || spec == "4") { return 4; }
        if (spec == "error" || spec == "5") { return 5; }
        return 2;
    }

    // 把 props 直通表里的 `from` 键改名为 `to`（值随迁）。三种情况
    // 拒绝并原样返回 false：`to` 已存在（先 Drop 再 Set 会把已有
    // 键的值静默覆盖掉——改名是编辑意图，吞别人的值属于数据丢
    // 失，调用方可用 HasCompProp 预检给出提示）、`from` 不存在、
    // from == to。返回是否真的发生了改名。
    static bool RenameCompProp(FormField f, string from, string to) {
        if (from == to) { return false; }
        if (HasCompProp(f, to)) { return false; }
        if (!HasCompProp(f, from)) { return false; }
        string val = Designer.CompPropValue(f, from, "");
        Designer.DropCompProp(f, from);
        Designer.SetCompPropValue(f, to, val);
        return true;
    }

    // 从 props 直通表里删掉 `key`（不存在则无操作）。
    static void DropCompProp(FormField f, string key) {
        if (f.extra == null) { return; }
        JsonValue props = f.extra.Get("props");
        if (props == null || !props.IsObject()) { return; }
        props.Remove(key);
    }

    // 识别属性是否为布尔型（以 Switch 开关进行展示与编辑）。
    static bool IsBoolProp(string key, string label, string val) {
        if (label.IndexOf("(true/false)") >= 0 || label.IndexOf("(false/true)") >= 0) {
            return true;
        }
        if (val == "true" || val == "false") {
            return true;
        }
        if (key == "round" || key == "loading" || key == "striped" || key == "rowNumbers"
            || key == "selectable" || key == "summary" || key == "filterRow" || key == "statusBar"
            || key == "groupPanel" || key == "allowAddRow" || key == "autoplay" || key == "showIndicator"
            || key == "range" || key == "vertical" || key == "reverse" || key == "stepMark"
            || key == "tooltip" || key == "showTooltip" || key == "keyboard" || key == "allowHalf"
            || key == "clearable" || key == "filterable" || key == "indeterminate" || key == "bordered"
            || key == "closable" || key == "checkable" || key == "clickable" || key == "showTotal"
            || key == "jumper" || key == "blink" || key == "grid" || key == "sign"
            || key == "dot" || key == "autoFill" || key == "oneWay" || key == "searchable"
            || key == "checks" || key == "multi" || key == "reorder" || key == "expandable"
            || key == "showAdd" || key == "mask" || key == "readonly") {
            return true;
        }
        return false;
    }

    // 清理属性标签中用于提示类型的冗余后缀（例如 "(true/false)"），
    // 使设计器属性面板的 Label 干净利落，不被无谓文字挤占。
    static string CleanPropLabel(string rawLabel) {
        string clean = rawLabel;
        int tfIdx = clean.IndexOf("(true/false)");
        if (tfIdx >= 0) {
            clean = clean.Substring(0, tfIdx);
        } else {
            int ftIdx = clean.IndexOf("(false/true)");
            if (ftIdx >= 0) {
                clean = clean.Substring(0, ftIdx);
            }
        }
        int p1 = clean.IndexOf("(");
        int p2 = clean.IndexOf(")");
        if (p1 >= 0 && p2 > p1) {
            string inner = clean.Substring(p1 + 1, p2 - p1 - 1);
            if (inner.Contains("/")) {
                clean = clean.Substring(0, p1);
            }
        }
        return StyleSheet.Trim(clean);
    }

    // 从属性提示标签提取枚举选项（如 "Type (primary/info/success)" -> ["", "primary", "info", "success"]）。
    // 第一个为 ""（默认/清空），方便重置为缺省样式。
    static List<string> ExtractPropOptions(string rawLabel) {
        List<string> res = new List<string>();
        if (rawLabel == null) { return res; }
        if (rawLabel.Contains("(true/false)") || rawLabel.Contains("(false/true)")) {
            return res;
        }
        int p1 = rawLabel.IndexOf("(");
        int p2 = rawLabel.IndexOf(")");
        if (p1 < 0 || p2 <= p1) { return res; }
        string inner = rawLabel.Substring(p1 + 1, p2 - p1 - 1);
        if (!inner.Contains("/")) { return res; }
        List<string> parts = inner.Split("/");
        if (parts.Count < 2) { return res; }
        res.Add(""); // 缺省项
        for (int i = 0; i < parts.Count; i = i + 1) {
            string itm = StyleSheet.Trim(parts[i]);
            // 剔除包含中文或等号说明（例如 "0=cold"）的非纯净枚举
            if (itm != "" && !itm.Contains("=") && !itm.Contains(" ") && !res.Contains(itm)) {
                res.Add(itm);
            }
        }
        if (res.Count <= 2) { res.Clear(); } // 至少有2个及以上有效备选项
        return res;
    }

    // 清洗字符生成合法的标识符片段（严格限制为 ASCII 字母、数字和下划线，避免中文或特殊字符导致编译器报语法错误）
    static string CleanIdentifier(string s) {
        if (s == null) { return ""; }
        // 针对 GUI 常见高频中文动作做自然英文映射
        string src = s;
        if (src.Contains("粘贴")) { src = src.Replace("粘贴", "Paste"); }
        if (src.Contains("复制")) { src = src.Replace("复制", "Copy"); }
        if (src.Contains("剪切")) { src = src.Replace("剪切", "Cut"); }
        if (src.Contains("撤销")) { src = src.Replace("撤销", "Undo"); }
        if (src.Contains("重做")) { src = src.Replace("重做", "Redo"); }
        if (src.Contains("全选")) { src = src.Replace("全选", "SelectAll"); }
        if (src.Contains("保存")) { src = src.Replace("保存", "Save"); }
        if (src.Contains("新建")) { src = src.Replace("新建", "New"); }
        if (src.Contains("打开")) { src = src.Replace("打开", "Open"); }
        if (src.Contains("关闭")) { src = src.Replace("关闭", "Close"); }
        if (src.Contains("删除")) { src = src.Replace("删除", "Delete"); }
        if (src.Contains("查找")) { src = src.Replace("查找", "Find"); }
        if (src.Contains("替换")) { src = src.Replace("替换", "Replace"); }
        if (src.Contains("刷新")) { src = src.Replace("刷新", "Refresh"); }
        if (src.Contains("设置")) { src = src.Replace("设置", "Settings"); }
        if (src.Contains("帮助")) { src = src.Replace("帮助", "Help"); }
        if (src.Contains("确定")) { src = src.Replace("确定", "Ok"); }
        if (src.Contains("取消")) { src = src.Replace("取消", "Cancel"); }
        if (src.Contains("退出")) { src = src.Replace("退出", "Exit"); }
        if (src.Contains("运行")) { src = src.Replace("运行", "Run"); }
        if (src.Contains("调试")) { src = src.Replace("调试", "Debug"); }
        if (src.Contains("停止")) { src = src.Replace("停止", "Stop"); }
        if (src.Contains("重置")) { src = src.Replace("重置", "Reset"); }
        if (src.Contains("清除")) { src = src.Replace("清除", "Clear"); }
        if (src.Contains("清空")) { src = src.Replace("清空", "Clear"); }
        if (src.Contains("导出")) { src = src.Replace("导出", "Export"); }
        if (src.Contains("导入")) { src = src.Replace("导入", "Import"); }
        if (src.Contains("添加")) { src = src.Replace("添加", "Add"); }
        if (src.Contains("移除")) { src = src.Replace("移除", "Remove"); }
        if (src.Contains("编辑")) { src = src.Replace("编辑", "Edit"); }
        if (src.Contains("查看")) { src = src.Replace("查看", "View"); }
        if (src.Contains("关于")) { src = src.Replace("关于", "About"); }
        if (src.Contains("搜索")) { src = src.Replace("搜索", "Search"); }
        if (src.Contains("下载")) { src = src.Replace("下载", "Download"); }
        if (src.Contains("上传")) { src = src.Replace("上传", "Upload"); }
        if (src.Contains("提交")) { src = src.Replace("提交", "Submit"); }
        if (src.Contains("确认")) { src = src.Replace("确认", "Confirm"); }
        if (src.Contains("应用")) { src = src.Replace("应用", "Apply"); }
        if (src.Contains("开始")) { src = src.Replace("开始", "Start"); }
        if (src.Contains("暂停")) { src = src.Replace("暂停", "Pause"); }
        if (src.Contains("继续")) { src = src.Replace("继续", "Resume"); }
        if (src.Contains("重试")) { src = src.Replace("重试", "Retry"); }

        string res = "";
        for (int i = 0; i < src.Length; i = i + 1) {
            int ch = src[i];
            // 只允许 ASCII 字母 A-Z, a-z, 数字 0-9, 下划线 _
            if ((ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || (ch >= 48 && ch <= 57) || ch == 95) {
                res = res + src.Substring(i, 1);
            }
        }
        if (res.Length == 0) { res = "Item"; }
        int first = res[0];
        if (first >= 48 && first <= 57) {
            res = "_" + res;
        }
        return res;
    }

    // 判定是否为资源/图片路径属性（提供文件浏览拾取器）
    static bool IsAssetProp(string key) {
        if (key == null) { return false; }
        return key == "src" || key == "image" || key == "avatar" || key == "asset"
            || key == "filePath" || key.EndsWith("Path") || key.EndsWith("Image");
    }

    // 判定是否为颜色属性（给真取色器）
    static bool IsColorProp(string key) {
        if (key == null) { return false; }
        return key == "color" || key == "textColor" || key == "bgColor"
            || key == "backgroundColor" || key == "borderColor"
            || key == "fill" || key == "stroke"
            || key == "tint" || key == "accent"
            || key == "dark" || key == "light"
            || key.EndsWith("Color");
    }

    // 颜色属性取值文本 → 颜色。解析不出（非字面色，如 var(--x)）
    // 返回未设置色（None）。十进制整数字面按历史形态（打包色）读。
    static Color ParseColorValue(string text) {
        if (text == null) { return Color.None(); }
        string t = text.Trim();
        if (t == "") { return Color.None(); }
        if (PropSpec.IsIntText(t)) {
            int p = Convert.ToInt32(t);
            return Color.FromRGBA((p >> 16) & 255, (p >> 8) & 255, p & 255,
                                  (p >> 24) & 255);
        }
        return Color.Parse(t);
    }

    // 打包色 → 颜色属性取值文本（CSS 规范形：#rrggbb，半透明时
    // #aarrggbb）。与 STYLE 通道、控件 PropSpec 认的形态一致。
    static string ColorValueText(int packed) {
        int a = (packed >> 24) & 255;
        int r = (packed >> 16) & 255;
        int g = (packed >> 8) & 255;
        int b = packed & 255;
        Color c = Color.FromRGBA(r, g, b, a);
        return c.ToCss();
    }

    // 内置组件的直通属性行：kind → "键|双语标签" 列表。值存
    // f.extra["props"]——与引用节点实例值同一张直通表，GenForm
    // 泛化发射 SetProp、画布预览经 ApplyFieldProps 落到真控件。
    // 只列设计期有意义的形态/展示属性；运行态开关（如 Countdown
    // 的 active）不进来。键全部取自各控件 Props()/SetExtra 的
