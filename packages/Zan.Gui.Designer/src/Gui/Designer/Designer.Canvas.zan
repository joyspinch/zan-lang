namespace Gui.Designer;

partial class Designer {

    // 大纲树一键全部展开/折叠所有目录节点
    void OutlineExpandAll(bool expand) {
        if (outlineTv == null) { return; }
        if (expand) { outlineTv.ExpandAll(); }
        else { outlineTv.CollapseAll(); }
        if (this.hostApp != null) { this.hostApp.RequestRedraw(); }
    }

    // 打开快速组件插入浮动面板 (Spotlight Quick Insert)
    void OpenQuickInsert(App app) {
        quickInsertOpen = true;
        quickInsertInput.SetText("");
        quickInsertLastQ = "";
        quickInsertSelIdx = 0;
        quickInsertDesX = 40;
        quickInsertDesY = 40;
        if (sel != null) {
            quickInsertDesX = sel.fx + 24;
            quickInsertDesY = sel.fy + 24;
        }
        this.FilterQuickInsert("");
        this.EnsureQuickInsertWindow(app);
    }

    // 过滤候选组件列表
    void FilterQuickInsert(string q) {
        quickInsertMatches = new List<int>();
        quickInsertLastQ = q;
        if (q == "") {
            quickInsertMatches.Add(-1); // Preset: Classic App
            quickInsertMatches.Add(-2); // Preset: Split Workspace
            quickInsertMatches.Add(-3); // Preset: Form Row
            quickInsertMatches.Add(-4); // Preset: Dialog Actions
            quickInsertMatches.Add(15); // Button
            quickInsertMatches.Add(0);  // Input
            quickInsertMatches.Add(18); // Card
            quickInsertMatches.Add(23); // Table
            quickInsertMatches.Add(36); // Tabs
            quickInsertMatches.Add(45); // Panel
            quickInsertMatches.Add(58); // ToolStrip
            quickInsertMatches.Add(73); // Flex
            quickInsertMatches.Add(6);  // Select
            quickInsertMatches.Add(4);  // Radio
            quickInsertMatches.Add(5);  // Checkbox
            quickInsertMatches.Add(14); // RichText
            quickInsertMatches.Add(59); // StatusBar
            quickInsertMatches.Add(60); // Splitter
            return;
        }

        // 预设复合模板快速匹配
        string lowerQ = q.ToLower();
        if (Designer.Contains(lowerQ, "preset") || Designer.Contains(lowerQ, "骨架") || Designer.Contains(lowerQ, "模板")
                || Designer.Contains(lowerQ, "app") || Designer.Contains(lowerQ, "main") || Designer.Contains(lowerQ, "tool")) {
            quickInsertMatches.Add(-1);
        }
        if (Designer.Contains(lowerQ, "preset") || Designer.Contains(lowerQ, "骨架") || Designer.Contains(lowerQ, "模板")
                || Designer.Contains(lowerQ, "split") || Designer.Contains(lowerQ, "side") || Designer.Contains(lowerQ, "分栏")) {
            quickInsertMatches.Add(-2);
        }
        if (Designer.Contains(lowerQ, "preset") || Designer.Contains(lowerQ, "骨架") || Designer.Contains(lowerQ, "模板")
                || Designer.Contains(lowerQ, "form") || Designer.Contains(lowerQ, "row") || Designer.Contains(lowerQ, "表单")) {
            quickInsertMatches.Add(-3);
        }
        if (Designer.Contains(lowerQ, "preset") || Designer.Contains(lowerQ, "骨架") || Designer.Contains(lowerQ, "模板")
                || Designer.Contains(lowerQ, "dialog") || Designer.Contains(lowerQ, "action") || Designer.Contains(lowerQ, "弹窗") || Designer.Contains(lowerQ, "底")) {
            quickInsertMatches.Add(-4);
        }

        for (int ft = 0; ft <= 85; ft = ft + 1) {
            string name = FormField.TypeName(ft);
            string desc = this.FieldDesc(ft);
            if (Designer.Contains(name, q) || Designer.Contains(desc, q)) {
                quickInsertMatches.Add(ft);
                if (quickInsertMatches.Count >= 20) { break; }
            }
        }
        if (quickInsertSelIdx >= quickInsertMatches.Count) {
            quickInsertSelIdx = 0;
        }
    }

    // 提交并生成选中的组件或预设骨架
    void CommitQuickInsert(int ft) {
        quickInsertOpen = false;
        if (quickInsertWin != null) { quickInsertWin.open = false; }
        if (hostApp != null) { hostApp.RequestRedraw(); }
        if (ft < 0) {
            this.InsertStarterPreset(-ft);
            return;
        }
        this.AddField(ft);
        if (sel != null && layoutMode == 1) {
            sel.fx = quickInsertDesX;
            sel.fy = quickInsertDesY;
            this.DesignDeclareRect(sel);
        }
        msg = Designer.T("inserted: ", "已插入: ") + FormField.TypeName(ft);
        this.MarkDocDirty();
    }

    // Popups share Layer's retained controls, layout, focus and dismissal lifecycle.
    void EnsureQuickInsertWindow(App app) {
        if (!quickInsertOpen || quickInsertWin != null) { return; }
        Flex body = Flex.Column();
        body.Add(quickInsertInput);
        quickInsertResults = Flex.Column();
        body.Add(quickInsertResults);
        quickInsertWin = this.NewEditorWindow(app, 480, 360, Designer.T("Quick insert", "快捷插入"));
        quickInsertWin.view = body;
        quickInsertWin.Open(app);
        this.RefreshQuickInsertResults();
        quickInsertInput.Focus();
    }

    void RefreshQuickInsertResults() {
        if (quickInsertResults == null) { return; }
        while (quickInsertResults.ChildCount() > 0) { quickInsertResults.Remove(quickInsertResults.ChildAt(0)); }
        int count = quickInsertMatches.Count;
        if (count > 7) { count = 7; }
        for (int i = 0; i < count; i = i + 1) {
            int kind = quickInsertMatches[i];
            string text = kind >= 0 ? FormField.TypeName(kind) : "";
            if (kind == -1) { text = Designer.T("Preset: Classic App", "预设: 经典主窗口"); }
            else if (kind == -2) { text = Designer.T("Preset: Split Workspace", "预设: 左右分栏工作区"); }
            else if (kind == -3) { text = Designer.T("Preset: Standard Form Row", "预设: 标准表单行"); }
            else if (kind == -4) { text = Designer.T("Preset: Dialog Actions", "预设: 对话框底部操作栏"); }
            DesignerCommandAction action = this.EnsureDesignerAction("quick.pick", kind);
            Button button = new Button(text);
            button.name = "quick.pick:" + Convert.ToString(kind);
            button.ClassName = i == quickInsertSelIdx ? "small primary" : "small";
            button.Click.Add(action.Run);
            quickInsertResults.Add(button);
        }
    }

    void EnsureKeymapHelpWindow(App app) {
        if (!keymapHelpOpen || keymapHelpWin != null) { return; }
        Flex columns = Flex.Row();
        Flex edit = Flex.Column();
        Flex canvas = Flex.Column();
        columns.Add(edit); columns.Add(canvas);
        this.AddShortcutRow(edit, "Ctrl+I", Designer.T("Quick insert", "快捷插入"));
        this.AddShortcutRow(edit, "Ctrl+X / C / V", Designer.T("Cut / Copy / Paste", "剪切 / 复制 / 粘贴"));
        this.AddShortcutRow(edit, "Ctrl+Shift+H / V", Designer.T("Distribute H / V", "水平均分 / 垂直均分"));
        this.AddShortcutRow(edit, "Ctrl+D", Designer.T("Duplicate", "创建副本"));
        this.AddShortcutRow(edit, "F2 / DoubleClick", Designer.T("Rename inline", "原地编辑文案"));
        this.AddShortcutRow(edit, "Ctrl+L", Designer.T("Lock / Unlock", "锁定 / 解锁"));
        this.AddShortcutRow(edit, "Ctrl+G", Designer.T("Group", "成组"));
        this.AddShortcutRow(edit, "Ctrl+Shift+G", Designer.T("Ungroup", "解散组"));
        this.AddShortcutRow(edit, "Del / Backspace", Designer.T("Delete", "删除选中"));
        this.AddShortcutRow(edit, "Ctrl+Z / Y", Designer.T("Undo / Redo", "撤销 / 重做"));
        this.AddShortcutRow(canvas, "Ctrl+Wheel", Designer.T("Zoom at pointer", "光标锚点缩放"));
        this.AddShortcutRow(canvas, "Space / MidDrag", Designer.T("Pan viewport", "平移画布"));
        this.AddShortcutRow(canvas, "Alt hover", Designer.T("Measure spacing", "测量间距"));
        this.AddShortcutRow(canvas, "Alt+Drag", Designer.T("Clone component", "拖拽克隆"));
        this.AddShortcutRow(canvas, "Shift+Drag", Designer.T("Constrain axis", "锁定轴向"));
        this.AddShortcutRow(canvas, "PageUp / Down", Designer.T("Z order", "调整层级"));
        this.AddShortcutRow(canvas, "Ctrl+Up / Down", Designer.T("Reorder sibling", "同级调序"));
        this.AddShortcutRow(canvas, "Ctrl+Home / End", Designer.T("Front / Back", "置顶 / 置底"));
        this.AddShortcutRow(canvas, "Arrows / Alt+Arrows", Designer.T("Nudge / Resize", "微调位置 / 尺寸"));
        this.AddShortcutRow(canvas, "Ctrl+R / Ctrl+;", Designer.T("Rulers / Guides", "标尺 / 参考线"));
        this.AddShortcutRow(canvas, "Ctrl+0 / Ctrl+1", Designer.T("100% / Fit", "原大 / 适配"));
        keymapHelpWin = this.NewEditorWindow(app, 720, 480, Designer.T("Keyboard Shortcuts Guide", "设计器快捷键指南"));
        keymapHelpWin.view = columns;
        keymapHelpWin.Open(app);
    }

    void AddShortcutRow(Flex column, string key, string text) {
        column.Add(new Label(key + "  ·  " + text));
    }

    // 快捷设置选中组件的排版与锚定方式（Flex 流式 vs 浮动与锚点）。
    void SetSelLayoutMode(int posMode, int anchorMode) {
        if (sel == null) { return; }
        this.PushUndo();
        sel.position = posMode;
        sel.anchor = anchorMode;
        if (posMode == 0) {
            msg = Designer.T("layout: flow", "排版: Flex 流式");
        } else {
            if (anchorMode == 10) {
                msg = Designer.T("layout: float stretch", "排版: 浮动铺满");
            } else if (anchorMode == 1) {
                msg = Designer.T("layout: float top-left", "排版: 浮动左上");
            } else if (anchorMode == 3) {
                msg = Designer.T("layout: float top-right", "排版: 浮动右上");
            } else if (anchorMode == 7) {
                msg = Designer.T("layout: float bottom-left", "排版: 浮动左下");
            } else if (anchorMode == 9) {
                msg = Designer.T("layout: float bottom-right", "排版: 浮动右下");
            } else {
                msg = Designer.T("layout: float", "排版: 浮动自由");
            }
        }
    }

    // 快捷设置选中组件的 Dock 停靠模式
    void SetSelDockMode(int dockSide) {
        if (sel == null) { return; }
        this.PushUndoAction(Designer.T("set dock", "设置停靠方式"));
        sel.dockSide = dockSide;
        if (dockSide > 0) {
            sel.position = 0;
            sel.fx = 0;
            sel.fy = 0;
        }
        this.DesignDeclareRect(sel);
        this.MarkDocDirty();
        string dsName = "None";
        if (dockSide == 1) { dsName = "Top"; }
        else if (dockSide == 2) { dsName = "Bottom"; }
        else if (dockSide == 3) { dsName = "Left"; }
        else if (dockSide == 4) { dsName = "Right"; }
        else if (dockSide == 5) { dsName = "Fill"; }
        msg = Designer.T("Dock set: ", "停靠方式: ") + dsName;
    }

    // 全流式模式下一键撑满剩余高度 (Fill Height: flexGrow=1, fh=0)
    void SetSelFillHeight() {
        if (sel == null) { return; }
        this.PushUndoAction(Designer.T("fill height", "撑满剩余高度"));
        sel.position = 0;
        sel.flexGrow = 1;
        sel.fh = 0;
        this.DesignDeclareRect(sel);
        this.MarkDocDirty();
        msg = Designer.T("Height: Fill (Grow=1)", "高度: 撑满剩余高度 (Grow=1)");
    }

    // 全流式模式下一键自适应内容高度 (Auto Height: flexGrow=0, fh=0)
    void SetSelAutoHeight() {
        if (sel == null) { return; }
        this.PushUndoAction(Designer.T("auto height", "内容自适应高度"));
        sel.position = 0;
        sel.flexGrow = 0;
        sel.fh = 0;
        this.DesignDeclareRect(sel);
        this.MarkDocDirty();
        msg = Designer.T("Height: Auto (Fit Content)", "高度: 内容自适应 (fh=0)");
    }

