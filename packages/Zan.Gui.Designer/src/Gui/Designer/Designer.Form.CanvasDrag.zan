using System;
using System.Collections.Generic;
using System.Json;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Backend;

namespace Gui.Designer;

// Designer 模块：画布拖拽移动、调整尺寸、框选、抬起收尾与 HUD/参考线渲染
partial class Designer {
    void HandleCanvasDragMove(App app, bool free, int ek, int ox, int oy, int psMilli) {
        if (!preview && freeDragging && free && ek == 1 && sel != null) {
            int mDesX = (app.mouseX - ox) * 1000 / psMilli;
            int mDesY = (app.mouseY - oy) * 1000 / psMilli;
            if (!freeDragHasMoved) {
                int dx = mDesX - freeDragStartX;
                int dy = mDesY - freeDragStartY;
                if (dx >= 4 || dx <= 0 - 4 || dy >= 4 || dy <= 0 - 4) {
                    if (Modifiers.HasAlt(app.window.EventMods())) {
                        // 按住 Alt 拖拽：原地复制克隆副本并拖动新副本 (Alt+Drag Clone)
                        this.DuplicateSel();
                        msg = Designer.T("Alt+Drag: Cloned component", "Alt+拖拽: 已克隆副本并移动");
                    } else {
                        this.PushUndo();
                    }
                    this.DesignBeginMove();
                    freeDragHasMoved = true;
                }
            }
            if (freeDragHasMoved && designMoves != null) {
                int baseX = this.DesignEditOriginX(sel);
                int baseY = this.DesignEditOriginY(sel);
                int left = mDesX - freeDragDx;
                int top = mDesY - freeDragDy;
                if (snapGrid && gridSize > 0) {
                    left = baseX + (left - baseX + gridSize / 2) / gridSize * gridSize;
                    top = baseY + (top - baseY + gridSize / 2) / gridSize * gridSize;
                }
                freeGuideX = 0 - 1;
                freeGuideY = 0 - 1;
                if (showGuides && !Modifiers.HasAlt(app.window.EventMods())) {
                    int tol = this.FreeSnapTol(app, psMilli);
                    List<int> rx = Designer.SnapAxis(left - baseX, designDragWidth,
                        this.FreeSnapLines(true, sel), tol);
                    List<int> ry = Designer.SnapAxis(top - baseY, designDragHeight,
                        this.FreeSnapLines(false, sel), tol);
                    left = rx[0] + baseX;
                    top = ry[0] + baseY;
                    if (rx[1] >= 0) { freeGuideX = rx[1] + baseX; }
                    if (ry[1] >= 0) { freeGuideY = ry[1] + baseY; }
                }
                int dx = left - designDragLeft;
                int dy = top - designDragTop;

                // Shift 键正交轴向平移锁定：大位移轴锁定，另一轴位移清零
                if (Modifiers.HasShift(app.window.EventMods())) {
                    int absDx = dx < 0 ? 0 - dx : dx;
                    int absDy = dy < 0 ? 0 - dy : dy;
                    if (absDx >= absDy) {
                        dy = 0;
                        msg = Designer.T("Shift: Locked to Horizontal", "Shift: 锁定水平平移");
                    } else {
                        dx = 0;
                        msg = Designer.T("Shift: Locked to Vertical", "Shift: 锁定垂直平移");
                    }
                }

                for (int i = 0; i < designMoves.Count; i = i + 1) {
                    DesignMoveStart move = designMoves[i];
                    bool isStatusBar = (move.field.ftype == 59 || move.field.kind == "StatusBar");
                    bool isToolStrip = (move.field.ftype == 58 || move.field.kind == "ToolStrip");
                    if (move.field.dockSide == 1 || isToolStrip) {
                        move.field.dockSide = 1;
                        move.field.position = 0;
                        move.field.fx = 0;
                        move.field.fy = 0;
                        move.field.fw = winW;
                    } else if (move.field.dockSide == 2 || isStatusBar) {
                        move.field.dockSide = 2;
                        move.field.position = 0;
                        move.field.fx = 0;
                        move.field.fw = winW;
                        if (move.field.fh <= 0) { move.field.fh = FormField.DefaultHFor(move.field.ftype); }
                        move.field.fy = this.DesignRootContentHeight() - move.field.fh;
                        if (move.field.fy < 0) { move.field.fy = 0; }
                    } else if (move.field.IsFullWidthBanner()) {
                        move.field.fx = 0;
                        move.field.fy = move.y + dy - this.DesignEditOriginY(move.field);
                    } else {
                        move.field.fx = move.x + dx - this.DesignEditOriginX(move.field);
                        move.field.fy = move.y + dy - this.DesignEditOriginY(move.field);
                    }
                    if (move.field.fx < 0) { move.field.fx = 0; }
                    if (move.field.fy < 0) { move.field.fy = 0; }
                    this.DesignDeclareRect(move.field);
                }
                this.MarkDocDirty();
            }
            app.RequestRedraw();
        }

        // Resize 使用按下时的真实起点与指针增量，对边不会随下一帧布局漂移。
    }

    void HandleCanvasResizeMove(App app, bool free, int ek, int ox, int oy, int psMilli) {
        if (!preview && freeResizing && free && ek == 1 && sel != null) {
            int dx = (app.mouseX - ox) * 1000 / psMilli - designResizeMouseX;
            int dy = (app.mouseY - oy) * 1000 / psMilli - designResizeMouseY;
            if (!designResizeMoved && (dx != 0 || dy != 0)) {
                this.PushUndo();
                if (multiResizeStarts != null && multiResizeStarts.Count > 1) {
                    for (int mi = 0; mi < multiResizeStarts.Count; mi = mi + 1) {
                        this.DesignMakeFloat(multiResizeStarts[mi].field);
                    }
                } else {
                    this.DesignMakeFloat(sel);
                }
                designResizeMoved = true;
            }
            if (designResizeMoved) {
                int left = designResizeLeft;
                int top = designResizeTop;
                int right = designResizeRight;
                int bottom = designResizeBottom;
                int hn = freeResizeH;
                bool moveL = hn == 0 || hn == 6 || hn == 7;
                bool moveT = hn == 0 || hn == 1 || hn == 2;
                bool moveR = hn == 2 || hn == 3 || hn == 4;
                bool moveB = hn == 4 || hn == 5 || hn == 6;
                bool isMulti = (multiResizeStarts != null && multiResizeStarts.Count > 1);

                if (!isMulti && sel.IsFullWidthBanner()) {
                    moveL = false;
                    moveR = false;
                }
                if (!isMulti && sel.IsFixedHeight()) {
                    moveT = false;
                    moveB = false;
                }
                if (moveL) { left = left + dx; }
                if (moveT) { top = top + dy; }
                if (moveR) { right = right + dx; }
                if (moveB) { bottom = bottom + dy; }
                int baseX = this.DesignEditOriginX(sel);
                int baseY = this.DesignEditOriginY(sel);
                if (snapGrid && gridSize > 0) {
                    if (moveL) { left = baseX + (left - baseX + gridSize / 2) / gridSize * gridSize; }
                    if (moveR) { right = baseX + (right - baseX + gridSize / 2) / gridSize * gridSize; }
                    if (moveT) { top = baseY + (top - baseY + gridSize / 2) / gridSize * gridSize; }
                    if (moveB) { bottom = baseY + (bottom - baseY + gridSize / 2) / gridSize * gridSize; }
                }
                freeGuideX = 0 - 1;
                freeGuideY = 0 - 1;
                if (showGuides && !Modifiers.HasAlt(app.window.EventMods())) {
                    int tol = this.FreeSnapTol(app, psMilli);
                    if (moveL || moveR) {
                        List<int> r = Designer.SnapAxis((moveL ? left : right) - baseX, 0,
                            this.FreeSnapLines(true, sel), tol);
                        if (moveL) { left = r[0] + baseX; } else { right = r[0] + baseX; }
                        if (r[1] >= 0) { freeGuideX = r[1] + baseX; }
                    }
                    if (moveT || moveB) {
                        List<int> r = Designer.SnapAxis((moveT ? top : bottom) - baseY, 0,
                            this.FreeSnapLines(false, sel), tol);
                        if (moveT) { top = r[0] + baseY; } else { bottom = r[0] + baseY; }
                        if (r[1] >= 0) { freeGuideY = r[1] + baseY; }
                    }
                }
                if (isMulti) {
                    // 多选联合等比 / 自由比例缩放
                    int origW = designResizeRight - designResizeLeft;
                    int origH = designResizeBottom - designResizeTop;
                    int newW = right - left;
                    int newH = bottom - top;
                    if (newW < 20) { newW = 20; }
                    if (newH < 20) { newH = 20; }
                    // Shift 等比约束
                    if (Modifiers.HasShift(app.window.EventMods()) && (hn == 0 || hn == 2 || hn == 4 || hn == 6)) {
                        if (origW > 0 && origH > 0) {
                            newH = origH * newW / origW;
                            if (hn == 0 || hn == 2) { top = bottom - newH; }
                            else { bottom = top + newH; }
                        }
                    }
                    for (int mi = 0; mi < multiResizeStarts.Count; mi = mi + 1) {
                        MultiResizeItem it = multiResizeStarts[mi];
                        int relX = it.x - designResizeLeft;
                        int relY = it.y - designResizeTop;
                        int newX = origW > 0 ? left + relX * newW / origW : left;
                        int newY = origH > 0 ? top + relY * newH / origH : top;
                        int newFieldW = origW > 0 ? it.w * newW / origW : it.w;
                        int newFieldH = origH > 0 ? it.h * newH / origH : it.h;
                        if (newFieldW < 10) { newFieldW = 10; }
                        if (newFieldH < 10) { newFieldH = 10; }
                        int itBaseX = this.DesignEditOriginX(it.field);
                        int itBaseY = this.DesignEditOriginY(it.field);
                        bool isItemSb = (it.field.ftype == 59 || it.field.kind == "StatusBar");
                        bool isItemTs = (it.field.ftype == 58 || it.field.kind == "ToolStrip");
                        if (isItemSb) {
                            it.field.dockSide = 2;
                            it.field.position = 0;
                            it.field.fx = 0;
                            it.field.fw = winW;
                            if (it.field.fh <= 0) { it.field.fh = FormField.DefaultHFor(it.field.ftype); }
                            it.field.fy = this.DesignRootContentHeight() - it.field.fh;
                            if (it.field.fy < 0) { it.field.fy = 0; }
                        } else if (isItemTs) {
                            if (it.field.dockSide == 0) { it.field.dockSide = 1; }
                            it.field.position = 0;
                            it.field.fx = 0;
                            it.field.fw = winW;
                            if (it.field.dockSide == 1) { it.field.fy = 0; }
                            else if (it.field.dockSide == 2) {
                                if (it.field.fh <= 0) { it.field.fh = FormField.DefaultHFor(it.field.ftype); }
                                it.field.fy = this.DesignRootContentHeight() - it.field.fh;
                                if (it.field.fy < 0) { it.field.fy = 0; }
                            }
                        } else {
                            it.field.fx = newX - itBaseX;
                            it.field.fy = newY - itBaseY;
                            it.field.fw = newFieldW;
                            it.field.fh = newFieldH;
                        }
                        this.DesignDeclareRect(it.field);
                    }
                    this.MarkDocDirty();
                } else {
                    int minW = 8;
                    int minH = 8;
                    DesignPreviewNode sizeNode = this.PreviewNode(sel);
                    Control sized = sizeNode != null ? sizeNode.control : null;
                    if (sized != null && sized.computedStyle != null) {
                        Control host = this.DesignParentHost(sel);
                        int availW = host != null ? host.bw : 0;
                        int availH = host != null ? host.bh : 0;
                        int insetW = sized.StyleInsetL() + sized.StyleInsetR();
                        int insetH = sized.StyleInsetT() + sized.StyleInsetB();
                        int cssW = sized.computedStyle.ClampWIn(availW, 0);
                        int cssH = sized.computedStyle.ClampHIn(availH, 0);
                        if (sized.computedStyle.boxSizing == 1) {
                            cssW = cssW + insetW;
                            cssH = cssH + insetH;
                        }
                        if (cssW < insetW) { cssW = insetW; }
                        if (cssH < insetH) { cssH = insetH; }
                        int logicalW = this.DesignLogical(cssW);
                        int logicalH = this.DesignLogical(cssH);
                        if (minW < logicalW) { minW = logicalW; }
                        if (minH < logicalH) { minH = logicalH; }
                    }
                    if (right - left < minW) {
                        if (moveL) { left = right - minW; } else { right = left + minW; }
                    }
                    if (bottom - top < minH) {
                        if (moveT) { top = bottom - minH; } else { bottom = top + minH; }
                    }
                    if (sel.IsFullWidthBanner()) {
                        Rect content = this.DesignContentRect(this.DesignParentHost(sel));
                        int hostW = this.DesignLogical(content.width);
                        if (hostW <= 0) { hostW = sel.LayoutW(); }
                        left = baseX;
                        right = baseX + hostW;
                    }
                    if (sel.IsFixedHeight()) {
                        bottom = top + FormField.DefaultHFor(sel.ftype);
                    }
                    bool isSb = (sel.ftype == 59 || sel.kind == "StatusBar");
                    bool isTs = (sel.ftype == 58 || sel.kind == "ToolStrip");
                    if (isSb) {
                        sel.dockSide = 2;
                        sel.position = 0;
                        sel.fx = 0;
                        sel.fw = winW;
                        if (sel.fh <= 0) { sel.fh = FormField.DefaultHFor(sel.ftype); }
                        sel.fy = this.DesignRootContentHeight() - sel.fh;
                        if (sel.fy < 0) { sel.fy = 0; }
                    } else if (isTs) {
                        if (sel.dockSide == 0) { sel.dockSide = 1; }
                        sel.position = 0;
                        sel.fx = 0;
                        sel.fw = winW;
                        if (sel.dockSide == 1) { sel.fy = 0; }
                        else if (sel.dockSide == 2) {
                            if (sel.fh <= 0) { sel.fh = FormField.DefaultHFor(sel.ftype); }
                            sel.fy = this.DesignRootContentHeight() - sel.fh;
                            if (sel.fy < 0) { sel.fy = 0; }
                        }
                    } else {
                        sel.fx = left - baseX;
                        sel.fy = top - baseY;
                        if (sel.fx < 0) { sel.fx = 0; }
                        if (sel.fy < 0) { sel.fy = 0; }
                        sel.fw = right - left;
                        sel.fh = bottom - top;
                    }
                    this.DesignDeclareRect(sel);
                    this.MarkDocDirty();
                }
            }
            app.RequestRedraw();
        }

        // 框选：拉框时画出选框，松开时选中与框相交的顶层组件。
    }

    void HandleCanvasMarquee(App app, Canvas c, int ek, int ox, int oy, int psMilli) {
        if (!preview && freeMarquee) {
            int mqx = freeMqSX;
            int mqy = freeMqSY;
            int mqw = app.mouseX - freeMqSX;
            int mqh = app.mouseY - freeMqSY;
            if (mqw < 0) { mqx = app.mouseX; mqw = 0 - mqw; }
            if (mqh < 0) { mqy = app.mouseY; mqh = 0 - mqh; }
            if (ek == 1) { app.RequestRedraw(); }
            int mqAcc = Style.Part(app, "designer", "accent", "", "", "", Style.SNormal()).BgOr(0);
            if (c != null) {
                c.FillRect(mqx, mqy, mqw, mqh, Style.Fade(mqAcc, 80));
                c.DrawRect(mqx, mqy, mqw, mqh, mqAcc, 1);
            }
            if (ek == 3) {
                int selL = this.DesignPointerPx(mqx, ox, psMilli);
                int selT = this.DesignPointerPx(mqy, oy, psMilli);
                int selR = this.DesignPointerPx(mqx + mqw, ox, psMilli);
                int selB = this.DesignPointerPx(mqy + mqh, oy, psMilli);
                this.ClearExtraSel();
                sel = null;
                // 递归收集：容器里的子组件同样框得中（Tabs 只看
                // 当前页），和场景设计器、点选的行为一致。
                List<FormField> got = new List<FormField>();
                this.MarqueeCollect(fields, selL, selT, selR, selB, got);
                for (int gi = 0; gi < got.Count; gi = gi + 1) {
                    if (this.HasAncestorIn(got[gi], got)) { continue; }
                    if (sel == null) { sel = got[gi]; } else { freeExtra.Add(got[gi]); }
                }
                // 框选也改变选中项：基必须跟着重算，否则框选中的
                // 嵌套子级一拖就按旧基（通常是画布原点）瞬移。
                this.SyncFreeSelBase();
                freeMarquee = false;
                if (sel != null) {
                    msg = Designer.T("selected ", "已选中 ")
                        + Convert.ToString(freeExtra.Count + 1)
                        + Designer.T(" component(s)", " 个组件");
                }
                app.RequestRedraw();
            }
        }

        // 任意位置松开指针即结束拖拽/调整大小/平移，并撤掉参考线。
    }

    void HandleCanvasPointerUp(App app, bool locked, int inX, int inY, int inW, int inH) {
        // 指针没动过（一次点击）的话设计没变，把按下时压的栈退掉。
        // Only the retained canvas PointerUp callback may complete its gesture.
        if (!locked && canvasInputDispatch) {
            if (!dragging && (freeDragHasMoved || designResizeMoved)) { this.PopUndoIfUnchanged(); }
            freeDragging = false;
            freeDragHasMoved = false;
            freeResizing = false;
            designResizeMoved = false;
            multiResizeStarts = null;
            designMoves = null;
            freePanning = false;
            this.freeGuideX = 0 - 1;
            this.freeGuideY = 0 - 1;
            app.RequestRedraw();
        }

        // 磁吸参考线与智能吸附坐标 HUD：
    }

    void RenderCanvasHudsAndGuides(App app, Canvas c, int ox, int oy, int psMilli, int cw2, int ch2) {
        // 贯穿画布的高亮竖线 / 横线，并在边缘浮动坐标 Badge；
        // 拖拽过程中在当前控件角落浮动尺寸与坐标 HUD。
        int accentColor = Style.Part(app, "designer", "accent", "", "", "", Style.SNormal()).BgOr(0);
        int badgeFg = Style.Part(app, "designer", "badge", "", "", "", Style.SNormal()).FgOr(0);
        int fsTiny = Style.FontFallback(app, "tiny");
        if (fsTiny <= 0) { fsTiny = Style.FontFallback(app, "small"); }

        if (!preview && this.freeGuideX >= 0) {
            int gxp = ox + this.freeGuideX * psMilli / 1000;
            c.FillRect(gxp, oy, 1, ch2, accentColor);
            string txtX = "X: " + Convert.ToString(this.freeGuideX);
            int twX = Canvas.MeasureText(txtX, fsTiny) + app.Scale(8);
            int thX = app.Scale(16);
            int bxX = gxp + app.Scale(4);
            if (bxX + twX > ox + cw2) { bxX = gxp - twX - app.Scale(4); }
            int byX = oy + app.Scale(4);
            c.FillRoundRect(bxX, byX, twX, thX, app.Scale(3), accentColor);
            c.DrawText(bxX + app.Scale(4), byX + app.Scale(2), txtX, badgeFg, fsTiny);
        }
        if (!preview && this.freeGuideY >= 0) {
            int gyp = oy + this.freeGuideY * psMilli / 1000;
            c.FillRect(ox, gyp, cw2, 1, accentColor);
            string txtY = "Y: " + Convert.ToString(this.freeGuideY);
            int twY = Canvas.MeasureText(txtY, fsTiny) + app.Scale(8);
            int thY = app.Scale(16);
            int bxY = ox + app.Scale(4);
            int byY = gyp + app.Scale(4);
            if (byY + thY > oy + ch2) { byY = gyp - thY - app.Scale(4); }
            c.FillRoundRect(bxY, byY, twY, thY, app.Scale(3), accentColor);
            c.DrawText(bxY + app.Scale(4), byY + app.Scale(2), txtY, badgeFg, fsTiny);
        }

        // 拖拽/缩放实时几何状态浮动 HUD
        if (!preview && sel != null && ((freeDragging && freeDragHasMoved) || (freeResizing && designResizeMoved))) {
            string hudTxt = Convert.ToString(sel.fx) + ", " + Convert.ToString(sel.fy)
                + " · " + Convert.ToString(sel.fw) + "x" + Convert.ToString(sel.fh);
            int hudW = Canvas.MeasureText(hudTxt, fsTiny) + app.Scale(12);
            int hudH = app.Scale(18);
            int hudX = app.mouseX + app.Scale(12);
            int hudY = app.mouseY + app.Scale(16);
            if (hudX + hudW > ox + cw2) { hudX = app.mouseX - hudW - app.Scale(8); }
            if (hudY + hudH > oy + ch2) { hudY = app.mouseY - hudH - app.Scale(8); }
            c.FillRoundRect(hudX + 1, hudY + 1, hudW, hudH, app.Scale(4),
                Style.Part(app, "designer", "shadow", "", "", "", Style.SNormal()).BgOr(0));
            c.FillRoundRect(hudX, hudY, hudW, hudH, app.Scale(4),
                Style.Part(app, "designer", "accent", "", "", "", Style.SNormal()).BgOr(0));
            c.DrawText(hudX + app.Scale(6), hudY + app.Scale(2), hudTxt, badgeFg, fsTiny);
        }

        // Alt 键悬停间距测量标尺 (Alt Spacing Inspection)：
        // 当按住 Alt 且有选中项 sel，光标悬停在另一个控件 hoverField 上时，
        // 动态绘制两者在世界坐标系下的间距连线与数字标尺。
        if (!preview && sel != null && hoverField != null && hoverField != sel
                && Modifiers.HasAlt(app.window.EventMods())
                && !freeDragging && !freeResizing && !freePanning) {
            Rect r1 = this.DesignViewRect(sel, ox, oy, psMilli);
            Rect r2 = this.DesignViewRect(hoverField, ox, oy, psMilli);
            int mCol = Style.Part(app, "designer", "accent", "", "", "", Style.SNormal()).BgOr(0);
            int lineCol = Style.Fade(mCol, 20);

            // 绘制 hoverField 高亮外框
            c.DrawRect(r2.x, r2.y, r2.width, r2.height, mCol, 1);

            int x1 = r1.x; int y1 = r1.y; int w1 = r1.width; int h1 = r1.height;
            int x2 = r2.x; int y2 = r2.y; int w2 = r2.width; int h2 = r2.height;

            // 水平间距：r2 在 r1 右侧
            if (x2 > x1 + w1) {
                int gapX = (x2 - (x1 + w1)) * 1000 / psMilli;
                int ly = (y1 + h1 / 2 + y2 + h2 / 2) / 2;
                c.FillRect(x1 + w1, ly, x2 - (x1 + w1), 1, lineCol);
                string gt = Convert.ToString(gapX);
                int gtw = Canvas.MeasureText(gt, fsTiny) + app.Scale(6);
                int gth = app.Scale(14);
                int gtx = (x1 + w1 + x2) / 2 - gtw / 2;
                int gty = ly - gth / 2;
                c.FillRoundRect(gtx, gty, gtw, gth, app.Scale(2), mCol);
                c.DrawText(gtx + app.Scale(3), gty + app.Scale(1), gt, badgeFg, fsTiny);
            } else if (x1 > x2 + w2) { // 水平间距：r2 在 r1 左侧
                int gapX = (x1 - (x2 + w2)) * 1000 / psMilli;
                int ly = (y1 + h1 / 2 + y2 + h2 / 2) / 2;
                c.FillRect(x2 + w2, ly, x1 - (x2 + w2), 1, lineCol);
                string gt = Convert.ToString(gapX);
                int gtw = Canvas.MeasureText(gt, fsTiny) + app.Scale(6);
                int gth = app.Scale(14);
                int gtx = (x2 + w2 + x1) / 2 - gtw / 2;
                int gty = ly - gth / 2;
                c.FillRoundRect(gtx, gty, gtw, gth, app.Scale(2), mCol);
                c.DrawText(gtx + app.Scale(3), gty + app.Scale(1), gt, badgeFg, fsTiny);
            }

            // 垂直间距：r2 在 r1 下方
            if (y2 > y1 + h1) {
                int gapY = (y2 - (y1 + h1)) * 1000 / psMilli;
                int lx = (x1 + w1 / 2 + x2 + w2 / 2) / 2;
                c.FillRect(lx, y1 + h1, 1, y2 - (y1 + h1), lineCol);
                string gt = Convert.ToString(gapY);
                int gtw = Canvas.MeasureText(gt, fsTiny) + app.Scale(6);
                int gth = app.Scale(14);
                int gtx = lx - gtw / 2;
                int gty = (y1 + h1 + y2) / 2 - gth / 2;
                c.FillRoundRect(gtx, gty, gtw, gth, app.Scale(2), mCol);
                c.DrawText(gtx + app.Scale(3), gty + app.Scale(1), gt, badgeFg, fsTiny);
            } else if (y1 > y2 + h2) { // 垂直间距：r2 在 r1 上方
                int gapY = (y1 - (y2 + h2)) * 1000 / psMilli;
                int lx = (x1 + w1 / 2 + x2 + w2 / 2) / 2;
                c.FillRect(lx, y2 + h2, 1, y1 - (y2 + h2), lineCol);
                string gt = Convert.ToString(gapY);
                int gtw = Canvas.MeasureText(gt, fsTiny) + app.Scale(6);
                int gth = app.Scale(14);
                int gtx = lx - gtw / 2;
                int gty = (y2 + h2 + y1) / 2 - gth / 2;
                c.FillRoundRect(gtx, gty, gtw, gth, app.Scale(2), mCol);
                c.DrawText(gtx + app.Scale(3), gty + app.Scale(1), gt, badgeFg, fsTiny);
            }
        } else if (!preview && sel != null && Modifiers.HasAlt(app.window.EventMods())
                && !freeDragging && !freeResizing && !freePanning) {
            // Alt 悬停在空白处或父容器上时，动态测量当前组件相对父容器四边的内缩距离（Parent Inset Guides）
            FormField p = this.DesignOwnerOf(sel);
            Rect rParent = null;
            if (p != null) {
                Control host = this.DesignSlot(p, sel.childTab);
                Rect pContent = this.DesignContentRect(host);
                rParent = new Rect(ox + this.DesignViewPx(pContent.x, psMilli),
                    oy + this.DesignViewPx(pContent.y, psMilli),
                    this.DesignViewPx(pContent.width, psMilli),
                    this.DesignViewPx(pContent.height, psMilli));
            } else {
                rParent = new Rect(ox, oy, cw2, ch2);
            }
            Rect r1 = this.DesignViewRect(sel, ox, oy, psMilli);
            int mCol = Style.Part(app, "designer", "accent", "", "", "", Style.SNormal()).BgOr(0);
            int lineCol = Style.Fade(mCol, 30);
            c.DrawRect(rParent.x, rParent.y, rParent.width, rParent.height, lineCol, 1);

            int x1 = r1.x; int y1 = r1.y; int w1 = r1.width; int h1 = r1.height;
            int px = rParent.x; int py = rParent.y; int pw = rParent.width; int ph = rParent.height;

            // 1. 顶部距离 (Top Inset)
            if (y1 > py) {
                int padT = (y1 - py) * 1000 / psMilli;
                int lx = x1 + w1 / 2;
                c.FillRect(lx, py, 1, y1 - py, lineCol);
                string gt = Convert.ToString(padT);
                int gtw = Canvas.MeasureText(gt, fsTiny) + app.Scale(6);
                int gth = app.Scale(14);
                int gtx = lx - gtw / 2;
                int gty = (py + y1) / 2 - gth / 2;
                c.FillRoundRect(gtx, gty, gtw, gth, app.Scale(2), mCol);
                c.DrawText(gtx + app.Scale(3), gty + app.Scale(1), gt, badgeFg, fsTiny);
            }

            // 2. 底部距离 (Bottom Inset)
            if (py + ph > y1 + h1) {
                int padB = ((py + ph) - (y1 + h1)) * 1000 / psMilli;
                int lx = x1 + w1 / 2;
                c.FillRect(lx, y1 + h1, 1, (py + ph) - (y1 + h1), lineCol);
                string gt = Convert.ToString(padB);
                int gtw = Canvas.MeasureText(gt, fsTiny) + app.Scale(6);
                int gth = app.Scale(14);
                int gtx = lx - gtw / 2;
                int gty = (y1 + h1 + py + ph) / 2 - gth / 2;
                c.FillRoundRect(gtx, gty, gtw, gth, app.Scale(2), mCol);
                c.DrawText(gtx + app.Scale(3), gty + app.Scale(1), gt, badgeFg, fsTiny);
            }

            // 3. 左侧距离 (Left Inset)
            if (x1 > px) {
                int padL = (x1 - px) * 1000 / psMilli;
                int ly = y1 + h1 / 2;
                c.FillRect(px, ly, x1 - px, 1, lineCol);
                string gt = Convert.ToString(padL);
                int gtw = Canvas.MeasureText(gt, fsTiny) + app.Scale(6);
                int gth = app.Scale(14);
                int gtx = (px + x1) / 2 - gtw / 2;
                int gty = ly - gth / 2;
                c.FillRoundRect(gtx, gty, gtw, gth, app.Scale(2), mCol);
                c.DrawText(gtx + app.Scale(3), gty + app.Scale(1), gt, badgeFg, fsTiny);
            }

            // 4. 右侧距离 (Right Inset)
            if (px + pw > x1 + w1) {
                int padR = ((px + pw) - (x1 + w1)) * 1000 / psMilli;
                int ly = y1 + h1 / 2;
                c.FillRect(x1 + w1, ly, (px + pw) - (x1 + w1), 1, lineCol);
                string gt = Convert.ToString(padR);
                int gtw = Canvas.MeasureText(gt, fsTiny) + app.Scale(6);
                int gth = app.Scale(14);
                int gtx = (x1 + w1 + px + pw) / 2 - gtw / 2;
                int gty = ly - gth / 2;
                c.FillRoundRect(gtx, gty, gtw, gth, app.Scale(2), mCol);
                c.DrawText(gtx + app.Scale(3), gty + app.Scale(1), gt, badgeFg, fsTiny);
            }
        }

        // 画布辅助参考线 (Canvas Guide Lines)
    }
}
