using System;
using System.Collections.Generic;
using System.Json;
using Gui;
using Gui.Backend;
using Gui.Widget;

namespace Gui.Designer;

partial class Designer {
    int rowsListH;
    Rect rowsListBounds;
    Rect propsListBounds;
    int rowsMaxScroll;
    int propsMaxScroll;

    void DesignerDialogInput(int kind, Control body, RoutedEventArgs e) {
        App app = hostApp;
        if (app == null || e == null || kind < 0 || kind > 1) { return; }
        Rect list = kind == 0 ? rowsListBounds : propsListBounds;
        if (e.eventName == "Wheel" && list != null
                && this.InRect(e.x, e.y, list.x, list.y, list.width, list.height)) {
            int scroll = (kind == 0 ? rowsScroll : propsScroll) - e.delta * app.Scale(40) / 120;
            int maximum = kind == 0 ? rowsMaxScroll : propsMaxScroll;
            if (maximum < 0) { maximum = 0; }
            if (scroll < 0) { scroll = 0; } if (scroll > maximum) { scroll = maximum; }
            if (kind == 0) { rowsScroll = scroll; } else { propsScroll = scroll; }
            e.Handle(); app.RequestRedraw(); return;
        }
        if (e.eventName != "KeyDown" || e.originalSource is Input) { return; }
        if (kind == 0) {
            if (e.keyCode == 46) { this.RunRowsCommand("rows.delete", 0); }
            else if (e.keyCode == 38) { this.RunRowsCommand("rows.up", 0); }
            else if (e.keyCode == 40) { this.RunRowsCommand("rows.down", 0); }
            else { return; }
        } else {
            if (e.keyCode == 46) { this.RunPropsCommand("props.delete", 0); }
            else if (e.keyCode == 38) { this.RunPropsCommand("props.select", propsEdSel - 1); }
            else if (e.keyCode == 40) { this.RunPropsCommand("props.select", propsEdSel + 1); }
            else { return; }
        }
        e.Handle(); app.RequestRedraw();
    }

    void BeginDesignerControlPaint() { designerControlSeen = designerControlSeen + 1; }

    void FinishDesignerControlPaint() {
        if (designerActions == null) { return; }
        for (int i = 0; i < designerActions.Count; i = i + 1) {
            DesignerCommandAction action = designerActions[i];
            if (action == null) { continue; }
            Control control = action.control;
            if (control != null && action.seen != designerControlSeen) { control.Visible = false; }
        }
    }

    DesignerCommandAction EnsureDesignerAction(string command, int value) {
        if (designerActions == null) { designerActions = new List<DesignerCommandAction>(); }
        for (int i = 0; i < designerActions.Count; i = i + 1) {
            DesignerCommandAction existing = designerActions[i];
            if (existing != null && existing.command == command && existing.value == value) { return existing; }
        }
        DesignerCommandAction created = new DesignerCommandAction();
        created.owner = this; created.command = command; created.value = value;
        designerActions.Add(created);
        return created;
    }

    void RetainDesignerControl(DesignerCommandAction action, Control control) {
        if (action == null || control == null) { return; }
        action.control = control; action.seen = designerControlSeen;
        control.name = action.command + ":" + Convert.ToString(action.value);
        control.Visible = true;
        Control host = designerSurface;
        if (action.command.StartsWith("rows.") && rowsWin != null && rowsWin.view != null) { host = rowsWin.view; }
        else if (action.command.StartsWith("props.") && propsWin != null && propsWin.view != null) { host = propsWin.view; }
        else if (action.command.StartsWith("icon.") && iconWin != null && iconWin.view != null) { host = iconWin.view; }
        if (host != null && control.parent != host) {
            if (control.parent != null) { control.parent.Remove(control); }
            host.Add(control);
        }
    }

    Button DesignerButton(App app, string text, string iconName, int type, int x, int y, int w, int h,
            string command, int value, bool circle) {
        if (app == null) { return null; }
        if (w < 0) { w = 0; }
        DesignerCommandAction action = this.EnsureDesignerAction(command, value);
        Button button = action.control as Button;
        if (button == null) {
            button = new Button();
            button.Click.Add(action.Run);
        }
        action.text = iconName != "" ? iconName : text;
        button.Text = text; button.Icon = iconName;
        button.ClassName = (circle ? "circle " : "") + "small " + Style.TypeClass(type);
        this.RetainDesignerControl(action, button);
        button.MeasureTree(app);
        int actualH = h > 0 ? h : (button.prefH > 0 ? button.prefH : app.Scale(28));
        button.Arrange(x, y, w, actualH);
        button.RenderTree(app);
        return button;
    }

    Button SmallBtn(App app, string text, int type, int x, int y, int w, string command) {
        return this.DesignerButton(app, text, "", type, x, y, w, 0, command, 0, false);
    }

    Button SmallIconBtn(App app, string iconName, int type, int x, int y, int w, string command) {
        return this.DesignerButton(app, "", iconName, type, x, y, w, 0, command, 0, true);
    }

    Control DesignerRow(App app, int x, int y, int w, int h, string command, int value) {
        if (w < 0) { w = 0; }
        if (h < 0) { h = 0; }
        DesignerCommandAction action = this.EnsureDesignerAction(command, value);
        Control row = action.control;
        if (row == null || row is Button) {
            row = new Control();
            row.OnRouted(action.Pointer);
        }
        row.ClassName = "designer-list-row";
        this.RetainDesignerControl(action, row);
        row.Arrange(x, y, w, h);
        return row;
    }

    bool DesignerCommandPointer(string command, int value, Control sender, RoutedEventArgs e) {
        App app = hostApp;
        if (e == null) { return false; }
        if (command == "quick.input" && e.eventName == "KeyDown") {
            int count = quickInsertMatches != null ? quickInsertMatches.Count : 0;
            if (count > 7) { count = 7; }
            if ((e.keyCode == 38 || e.keyCode == 40) && count > 0) {
                quickInsertSelIdx = (quickInsertSelIdx + count + (e.keyCode == 38 ? -1 : 1)) % count;
                this.RefreshQuickInsertResults();
            } else if (e.keyCode == 13 && quickInsertSelIdx >= 0 && quickInsertSelIdx < count) {
                this.CommitQuickInsert(quickInsertMatches[quickInsertSelIdx]);
            } else { return false; }
            e.Handle(); if (app != null) { app.RequestRedraw(); } return true;
        }
        return false;
    }

    void RunDesignerCommand(string command, int value, string text) {
        if (command == null || command == "") { return; }
        App app = hostApp;
        if (command == "quick.filter") {
            if (quickInsertInput != null) { this.FilterQuickInsert(quickInsertInput.GetText()); }
            this.RefreshQuickInsertResults();
            if (app != null) { app.RequestRedraw(); }
            return;
        }
        if (command == "quick.pick") { this.CommitQuickInsert(value); return; }
        if (command == "inline.ok") { this.CommitInlineRename(); return; }
        if (command == "inline.cancel") { this.CancelInlineRename(); return; }
        if (command == "json.refresh") {
            if (jsonArea != null) { jsonArea.SetText(SaveHtml()); }
            msg = Designer.T("refreshed the .html preview from the current design", "已根据当前设计刷新 .html 预览");
            return;
        }
        if (command == "json.close") { jsonOpen = false; if (app != null) { app.RequestRedraw(); } return; }
        if (command == "multi.align") { this.AlignSelGroup(value); return; }
        if (command == "multi.distribute") { this.DistributeSelGroup(value); return; }
        if (command == "multi.gap") { this.DistributeSelWithGap(value, 8); return; }
        if (command == "multi.size") { this.SizeSelGroup(value); return; }
        if (command == "palette.tab") { palTab = value; if (app != null) { app.RequestRedraw(); } return; }
        if (command == "outline.expand") { this.OutlineExpandAll(true); return; }
        if (command == "outline.collapse") { this.OutlineExpandAll(false); return; }
        if (command == "outline.up" || command == "outline.down") {
            this.MoveSel(command == "outline.up" ? 0 - 1 : 1); this.EnsureOutline();
            if (app != null) { app.RequestRedraw(); } return;
        }
        if (command == "outline.lock") {
            this.ToggleLockSel(); this.EnsureOutline(); if (app != null) { app.RequestRedraw(); } return;
        }
        if (command == "outline.delete") {
            this.DeleteSelGroup(); this.EnsureOutline(); if (app != null) { app.RequestRedraw(); } return;
        }
        if (command == "tray.select" && fields != null && value >= 0 && value < fields.Count && fields[value] != null) {
            this.ClearExtraSel(); sel = fields[value]; inspTab = 0;
            activeContainer = null;
            this.SyncOutlineSelection();
            msg = Designer.T("selected: ", "已选中：") + sel.fname;
            if (app != null) { app.RequestRedraw(); }
            return;
        }
        if (command == "status.undo") { if (undoStack != null && undoStack.Count > 0) { this.Undo(); } return; }
        if (command == "status.redo") { if (redoStack != null && redoStack.Count > 0) { this.Redo(); } return; }
        if (command == "status.zoom-out" || command == "status.zoom-in") {
            int zoom = winZoom <= 0 ? lastFitPct : winZoom;
            zoom = zoom + (command == "status.zoom-in" ? 100 : 0 - 100);
            if (zoom < 250) { zoom = 250; } if (zoom > 2000) { zoom = 2000; }
            winZoom = zoom; if (app != null) { app.RequestRedraw(); } return;
        }
        if (command == "status.zoom-reset" || command == "status.zoom-fit") {
            winZoom = command == "status.zoom-fit" ? 0 : 1000; freePanX = 0; freePanY = 0;
            if (app != null) { app.RequestRedraw(); } return;
        }
        if (command == "status.help") {
            keymapHelpOpen = !keymapHelpOpen;
            if (app != null) { this.EnsureKeymapHelpWindow(app); app.RequestRedraw(); }
            return;
        }
        if (command == "icon.pick") {
            if (iconPickTarget != null) {
                this.PushUndo();
                iconPickTarget.SetText(text);
                if (iconPickTarget == iconHolder) { rowEdField = text; }
            }
            if (iconWin != null) { iconWin.open = false; }
            iconWin = null; iconPickTarget = null;
            if (app != null) { app.RequestRedraw(); }
            return;
        }
        if (command == "rows.close" || command == "props.close") { this.CloseBigEditors(); return; }
        if (command.StartsWith("rows.")) { this.RunRowsCommand(command, value); return; }
        if (command.StartsWith("props.")) { this.RunPropsCommand(command, value); }
    }

    void RunRowsCommand(string command, int value) {
        FormField field = rowsEdField; App app = hostApp;
        if (field == null) { return; }
        bool table = field.ftype == 23 || field.ftype == 41;
        bool tool = field.ftype == 58; bool ribbon = field.ftype == 53;
        int slot = app != null ? app.Scale(30) : 30;
        if (command == "rows.add") {
            this.PushUndo();
            string def = table ? Designer.T("New column", "新列") : Designer.T("New option", "新选项");
            if (tool || ribbon) { def = Designer.T("New item", "新项"); }
            field.AddOption(def); rowsEdSel = field.OptionCount() - 1; rowsEdSelPrev = 0 - 1;
        } else if (command == "rows.duplicate" && rowsEdSel >= 0 && rowsEdSel < field.OptionCount()) {
            this.PushUndo(); int source = rowsEdSel;
            field.AddOption(field.OptionAt(rowsEdSel)); field.MoveOption(field.OptionCount() - 1, rowsEdSel + 1);
            Designer.CopyColEntry(field, source, rowsEdSel + 1); Designer.CopyToolItemEntry(field, source, rowsEdSel + 1);
            rowsEdSel = rowsEdSel + 1; rowsEdSelPrev = 0 - 1;
        } else if (command == "rows.delete" && rowsEdSel >= 0 && rowsEdSel < field.OptionCount()) {
            this.PushUndo(); this.RemoveOptionFixup(field, rowsEdSel);
            if (rowsEdSel > field.OptionCount() - 1) { rowsEdSel = field.OptionCount() - 1; }
            rowsEdSelPrev = 0 - 1;
        } else if ((command == "rows.up" && rowsEdSel > 0 && rowsEdSel < field.OptionCount())
                || (command == "rows.down" && rowsEdSel >= 0 && rowsEdSel < field.OptionCount() - 1)) {
            this.PushUndo(); int target = rowsEdSel + (command == "rows.up" ? 0 - 1 : 1);
            this.MoveOptionFixup(field, rowsEdSel, target); rowsEdSel = target; rowsEdSelPrev = 0 - 1;
        } else if (command == "rows.select" && value >= 0 && value < field.OptionCount()) {
            rowsEdSel = value; rowsEdSelPrev = 0 - 1;
        } else if (command == "rows.pick" && (tool || ribbon)) {
            if (iconHolder != null) {
                iconHolder.SetText(rowEdField);
                this.OpenIconPicker(app, iconHolder);
            }
        } else if (command == "rows.tool-nav" && tool) {
            string target = StyleSheet.Trim(toolEdClick);
            if (target == "") {
                string baseName = field.fname != "" ? field.fname : "Tool";
                string itemName = StyleSheet.Trim(rowEdTitle);
                if (itemName == "") { itemName = "Item" + Convert.ToString(rowsEdSel + 1); }
                target = "On" + Designer.CleanIdentifier(baseName) + Designer.CleanIdentifier(itemName) + "Click";
                toolEdClick = target; this.WriteBackToolItem(app, field);
            }
            this.RequestOpenCodeBehindHandler(target);
        } else if (command == "rows.col-nav" && table) {
            string target = StyleSheet.Trim(colEdClick);
            if (target == "") {
                string baseName = field.fname != "" ? field.fname : "Table";
                string colName = StyleSheet.Trim(rowEdField);
                if (colName == "") { colName = StyleSheet.Trim(rowEdTitle); }
                if (colName == "") { colName = "Col" + Convert.ToString(rowsEdSel + 1); }
                target = "On" + Designer.CleanIdentifier(baseName) + Designer.CleanIdentifier(colName) + "CellClick";
                colEdClick = target; this.WriteBackCol(app, field);
            }
            this.RequestOpenCodeBehindHandler(target);
        } else { return; }
        this.EnsureSelVisible(field.OptionCount(), slot, rowsListH);
        if (app != null) { app.RequestRedraw(); }
    }

    void RunPropsCommand(string command, int value) {
        FormField field = propsEdField; App app = hostApp;
        if (field == null) { return; }
        int count = 0;
        if (field.extra != null) {
            JsonValue props = field.extra.Get("props");
            if (props != null && props.IsObject()) { count = props.Count(); }
        }
        if (command == "props.add") {
            this.PushUndo(); string key = "prop"; int next = 1;
            while (Designer.HasCompProp(field, key)) { next = next + 1; key = "prop" + Convert.ToString(next); }
            Designer.SetCompPropValue(field, key, ""); propsEdSel = count; propsEdSelPrev = 0 - 1;
        } else if (command == "props.delete" && propsEdSel >= 0 && propsEdSel < count && field.extra != null) {
            this.PushUndo(); JsonValue props = field.extra.Get("props");
            if (props != null && props.IsObject() && propsEdSel < props.Count()) {
                Designer.DropCompProp(field, props.KeyAt(propsEdSel));
            }
            if (propsEdSel > count - 2) { propsEdSel = count - 2; }
            propsEdSelPrev = 0 - 1;
        } else if (command == "props.select" && value >= 0 && value < count) {
            propsEdSel = value; propsEdSelPrev = 0 - 1;
        } else { return; }
        if (app != null) { app.RequestRedraw(); }
    }
}
