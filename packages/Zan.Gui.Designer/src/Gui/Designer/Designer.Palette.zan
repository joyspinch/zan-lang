    // 渲染一个小按钮（高 28）并返回其 id。检查器各处使用，
    // 让控件能放进紧凑的行内。使用 AllocId() 保证即时模式每帧稳定 id
    // 且与保留式持久控件（Input 等，>=1000000）完全隔离。
    int SmallBtn(App app, string text, int type, int x, int y, int w) {
        int id = app.focus.AllocId();
        Button b = new Button { wid = id, Text = text, Class = "small " + Style.TypeClass(type) };
        return b.Render(app, x, y, w);
    }

    // 小号（高 28）纯图标按钮——尺寸与 SmallBtn 相同，但
    // 标签是矢量 Icon 字形而非文本字符。
    int SmallIconBtn(App app, string iconName, int type, int x, int y, int w) {
        int id = app.focus.AllocId();
        Button b = new Button { wid = id, Icon = iconName,
                                Class = "circle small " + Style.TypeClass(type) };
        return b.Render(app, x, y, w);
    }

    // 小号（高 28）带矢量图标与文本的按钮
    int SmallBtnWithIcon(App app, string iconName, string text, int type, int x, int y, int w) {
        int id = app.focus.AllocId();
        Button b = new Button { wid = id, Icon = iconName, Text = text,
                                Class = "small " + Style.TypeClass(type) };
        return b.Render(app, x, y, w);
    }

    // 统一微型（22x22 标准尺寸）行内关闭按钮，用于属性面板各列表项，带独立边框与微底色，防误触点歪。
    int MiniCloseBtn(App app, int x, int y, int size) {
        int id = app.focus.AllocId();
        int sz = (size > 0) ? size : app.Scale(22);
        int ox = x + (size - sz) / 2;
        int oy = y + (size - sz) / 2;
        bool hov = app.focus.IsHovered(id);
        int bg = hov ? app.theme.bgHover : app.theme.bgSecondary;
        int border = hov ? Style.Part(app, "designer", "accent", "", "error", "", Style.SNormal()).BgOr(app.theme.primary) : app.theme.borderSecondary;
        int r = app.theme.borderRadiusSmall > 0 ? app.theme.borderRadiusSmall : app.Scale(3);
        app.canvas.FillRoundRect(ox, oy, sz, sz, r, bg);
        app.canvas.DrawRoundRect(ox, oy, sz, sz, r, border, 1);
        int iconFg = hov ? Style.Part(app, "designer", "accent", "", "error", "", Style.SNormal()).BgOr(app.theme.textPrimary) : app.theme.textTertiary;
        app.canvas.DrawGlyphIn("close", ox, oy, sz, sz, app.Scale(11), iconFg);
        app.hitTester.RegisterRect(id, ox, oy, sz, sz, 0);
        return id;
    }

    // 统一微型（22x22 标准尺寸）行内箭头按钮（上移/下移排序），带独立边框与微底色
    int MiniArrowBtn(App app, string glyph, int x, int y, int size, bool enabled) {
        int id = app.focus.AllocId();
        int sz = (size > 0) ? size : app.Scale(22);
        int ox = x + (size - sz) / 2;
        int oy = y + (size - sz) / 2;
        int r = app.theme.borderRadiusSmall > 0 ? app.theme.borderRadiusSmall : app.Scale(3);
        if (!enabled) {
            int disBg = app.theme.bgSecondary;
            int disBorder = app.theme.borderSecondary;
            int iconFg = app.theme.textTertiary;
            app.canvas.FillRoundRect(ox, oy, sz, sz, r, disBg);
            app.canvas.DrawRoundRect(ox, oy, sz, sz, r, disBorder, 1);
            app.canvas.DrawGlyphIn(glyph, ox, oy, sz, sz, app.Scale(10), iconFg);
            return id;
        }
        bool hov = app.focus.IsHovered(id);
        int bg = hov ? app.theme.bgHover : app.theme.bgSecondary;
        int border = hov ? app.theme.primary : app.theme.borderSecondary;
        int fg = hov ? app.theme.textPrimary : app.theme.textSecondary;
        app.canvas.FillRoundRect(ox, oy, sz, sz, r, bg);
        app.canvas.DrawRoundRect(ox, oy, sz, sz, r, border, 1);
        app.canvas.DrawGlyphIn(glyph, ox, oy, sz, sz, app.Scale(10), fg);
        app.hitTester.RegisterRect(id, ox, oy, sz, sz, 0);
        return id;
    }

    // 统一微型（22x22 标准尺寸）行内闪电事件快捷按钮（点击前往/生成事件代码，已绑定时高亮）
    int MiniZapBtn(App app, int x, int y, int size, bool hasBinding) {
        int id = app.focus.AllocId();
        int sz = (size > 0) ? size : app.Scale(22);
        int ox = x + (size - sz) / 2;
        int oy = y + (size - sz) / 2;
        int r = app.theme.borderRadiusSmall > 0 ? app.theme.borderRadiusSmall : app.Scale(3);
        bool hov = app.focus.IsHovered(id);
        int bg = hov ? app.theme.bgHover : app.theme.bgSecondary;
        int border = hasBinding ? app.theme.primary : (hov ? app.theme.primary : app.theme.borderSecondary);
        app.canvas.FillRoundRect(ox, oy, sz, sz, r, bg);
        app.canvas.DrawRoundRect(ox, oy, sz, sz, r, border, 1);
        int iconFg = hasBinding
            ? Style.Part(app, "designer", "accent", "", "success", "", Style.SNormal()).BgOr(app.theme.primary)
            : (hov ? app.theme.textPrimary : app.theme.textTertiary);
        app.canvas.DrawGlyphIn("zap", ox, oy, sz, sz, app.Scale(11), iconFg);
        app.hitTester.RegisterRect(id, ox, oy, sz, sz, 0);
        return id;
    }

    // 迷你（高 18-20）文本胶囊操作按钮，用于分组标题右侧等紧凑区域，严格对齐无下沉遮挡
    int MiniTextBtn(App app, string text, int x, int y, int w, int h) {
        int id = app.focus.AllocId();
        bool hov = app.focus.IsHovered(id);
        int bg = hov ? app.theme.bgHover : app.theme.bgSecondary;
        int border = hov ? app.theme.primary : app.theme.borderSecondary;
        int fg = hov ? app.theme.primary : app.theme.textSecondary;
        int r = app.Scale(3);
        app.canvas.FillRoundRect(x, y, w, h, r, bg);
        app.canvas.DrawRoundRect(x, y, w, h, r, border, 1);
        int fs = Style.FontFallback(app, "tiny");
        if (fs <= 0) { fs = Style.FontFallback(app, "small"); }
        int tw = Canvas.MeasureText(text, fs);
        int tx = x + (w - tw) / 2;
        int ty = y + (h - app.Scale(12)) / 2;
        app.canvas.DrawText(tx, ty, text, fg, fs);
        app.hitTester.RegisterRect(id, x, y, w, h, 0);
        return id;
    }

    // --- 弹窗式大编辑器 -----------------------------------------------------
    // 属性面板只有 ~288 逻辑像素宽，options 每行塞不下「标题 +
    // 数据字段」两个输入框，ToolStrip 的完整项语法（标题:图标、
    // > 靠右、- 分隔条）更是没法逐段编辑。选中组件后从检查器
    // 打开这里：居中模态（Layer.Modal 同款遮罩/命中拦截），表格
    // 行编辑，宽屏装得下全部列。

    // 检查器「OPTIONS/COLUMNS」区头部的打开按钮：把选中组件
}
