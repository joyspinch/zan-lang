using System;
using System.Collections.Generic;
using System.Json;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Backend;
using Gui.Markup;

namespace Gui.Designer;

partial class Designer {
    // palTab == 1: 组件大纲树 TreeView（文档完整树状嵌套结构与即时选中）
    void RenderPalette(App app, Canvas c, Theme t, int px, int py, int pw, int ph) {
        if (pw < 20 || ph < 20) { return; }
        int tabH = app.Scale(28);
        int tabW = (pw - app.Scale(6)) / 2;
        int bType = 0; if (palTab == 0) { bType = 1; }
        int oType = 0; if (palTab == 1) { oType = 1; }
        int bId = SmallBtn(app, Designer.T("Palette", "组件库"), bType, px, py, tabW);
        int oId = SmallBtn(app, Designer.T("Outline", "大纲树"), oType, px + tabW + app.Scale(6), py, tabW);
        if (Ui.Clicked(app, bId) && palTab != 0) { palTab = 0; app.RequestRedraw(); }
        if (Ui.Clicked(app, oId) && palTab != 1) { palTab = 1; app.RequestRedraw(); }

        // 即时搜索过滤输入框：支持快速检索组件库与大纲树节点
        int searchH = app.Scale(24);
        int searchY = py + tabH + app.Scale(4);
        filterInput.Render(app, px, searchY, pw, searchH);

        int barH = 0;
        if (palTab == 1) {
            barH = app.Scale(26);
            int barY = searchY + searchH + app.Scale(4);
            int nBtns = 6;
            int gap = app.Scale(3);
            int btnW = (pw - gap * (nBtns - 1)) / nBtns;
            int curX = px;

            // 1. 同级向上移动（大纲树视觉上移一位）
            int upId = SmallIconBtn(app, "chevron-up", 0, curX, barY, btnW);
            curX = curX + btnW + gap;
            if (Ui.Clicked(app, upId)) {
                this.MoveSel(-1);
                this.EnsureOutline();
                app.RequestRedraw();
            }

            // 2. 同级向下移动（大纲树视觉下移一位）
            int downId = SmallIconBtn(app, "chevron-down", 0, curX, barY, btnW);
            curX = curX + btnW + gap;
            if (Ui.Clicked(app, downId)) {
                this.MoveSel(1);
                this.EnsureOutline();
                app.RequestRedraw();
            }

            // 3. 锁定 / 解锁
            string lockIcon = (sel != null && sel.locked) ? "lock" : "unlock";
            int lockId = SmallIconBtn(app, lockIcon, 0, curX, barY, btnW);
            curX = curX + btnW + gap;
            if (Ui.Clicked(app, lockId)) {
                this.ToggleLockSel();
                this.EnsureOutline();
                app.RequestRedraw();
            }

            // 4. 删除
            int delId = SmallIconBtn(app, "trash", 0, curX, barY, btnW);
            curX = curX + btnW + gap;
            if (Ui.Clicked(app, delId)) {
                this.DeleteSelGroup();
                this.EnsureOutline();
                app.RequestRedraw();
            }

            // 5. 全部展开
            int expId = SmallIconBtn(app, "plus", 0, curX, barY, btnW);
            curX = curX + btnW + gap;
            if (Ui.Clicked(app, expId)) { this.OutlineExpandAll(true); }

            // 6. 全部折叠
            int colId = SmallIconBtn(app, "minus", 0, curX, barY, btnW);
            if (Ui.Clicked(app, colId)) { this.OutlineExpandAll(false); }
        }

        int bodyY = searchY + searchH + app.Scale(4) + barH;
        int bodyH = ph - (bodyY - py);
        if (bodyH < 20) { return; }
        if (palTab == 0) {
            this.EnsurePalette();
            palTv.RenderInside(app, new Rect(px, bodyY, pw, bodyH));
        } else {
            this.EnsureOutline();
            outlineTv.RenderInside(app, new Rect(px, bodyY, pw, bodyH));
            if (!preview && !dragging && app.EventKind() == 2 && app.window.EventButton() == 1
                    && InRect(app.mouseX, app.mouseY, px, bodyY, pw, bodyH)) {
                if (sel != null) {
                    canvasMenuOpen = true;
                    canvasMenuArm = false;
                    canvasMenuX = app.mouseX;
                    canvasMenuY = app.mouseY;
                    app.RequestRedraw();
                }
            }
        }
    }

    void EnsureOutline() {
        if (outlineTv == null) {
            outlineNodes = new List<TreeNode>();
            outlineFields = new List<FormField>();
            outlineTv = new TreeView();
            outlineTv.WithFilter(filterInput);
            outlineTv.Empty = Designer.T("No components match.", "没有匹配的组件。");
            outlineTv.OnSelect(() => { this.OnOutlineSelect(); });
            outlineTv.OnActivate(() => {
                if (this.sel != null && Designer.HasDisplayText(this.sel)) {
                    this.StartInlineRename();
                }
            });
            outlineTv.OnContext(() => { this.OnOutlineContext(); });
        }
        string q = filterInput.GetText();
        this.BuildOutline(q);
        outlineTv.Bind(outlineNodes);
        this.SyncOutlineSelection();
    }

    bool FieldOrDescendantMatches(FormField f, string q) {
        if (f == null) { return false; }
        if (q == "") { return true; }
        if (Designer.Contains(f.fname, q) || Designer.Contains(f.label, q)
            || Designer.Contains(FormField.TypeName(f.ftype), q)) {
            return true;
        }
        if (f.kids != null) {
            for (int i = 0; i < f.kids.Count; i = i + 1) {
                if (this.FieldOrDescendantMatches(f.kids[i], q)) { return true; }
            }
        }
        return false;
    }

    void BuildOutline(string q) {
        outlineNodes = new List<TreeNode>();
        outlineFields = new List<FormField>();

        // 根节点：Form 窗口本体
        string rootLbl = Designer.T("Form (Window)", "窗口 (Form)");
        if (winTitle != "") { rootLbl = rootLbl + " · " + winTitle; }
        TreeNode rootNode = TreeNode.Dir(rootLbl, 0, true);
        rootNode.icon = "window";
        rootNode.payload = "root";
        outlineNodes.Add(rootNode);
        outlineFields.Add(null);

        this.AddOutlineChildren(null, 1, q);
    }

    void AddOutlineChildren(FormField parent, int depth, string q) {
        List<FormField> list = parent == null ? fields : parent.kids;
        if (list == null) { return; }
        for (int i = 0; i < list.Count; i = i + 1) {
            FormField f = list[i];
            if (f == null) { continue; }
            if (q != "" && !this.FieldOrDescendantMatches(f, q)) {
                continue;
            }
            string name = f.fname;
            if (name == "") { name = FormField.TypeName(f.ftype); }
            string lbl = name + " (" + FormField.TypeName(f.ftype) + ")";
            if (f.label != "" && f.label != name) {
                lbl = lbl + " · " + f.label;
            }
            if (f.dockSide == 1) { lbl = lbl + " [Top]"; }
            else if (f.dockSide == 2) { lbl = lbl + " [Bottom]"; }
            else if (f.dockSide == 3) { lbl = lbl + " [Left]"; }
            else if (f.dockSide == 4) { lbl = lbl + " [Right]"; }
            else if (f.dockSide == 5) { lbl = lbl + " [Fill]"; }
            else if (f.position == 1) { lbl = lbl + " [Float]"; }

            if (f.locked) { lbl = lbl + " [Locked]"; }
            if (f == this.activeContainer) { lbl = lbl + " [★ Active]"; }

            bool isContainer = FormField.IsContainerOf(f.ftype) || (f.kids != null && f.kids.Count > 0);
            TreeNode node;
            if (isContainer) {
                node = TreeNode.Dir(lbl, depth, true);
            } else {
                node = TreeNode.FileIcon(lbl, depth, this.FieldIcon(f.ftype));
            }
            node.payload = f.fname;
            outlineNodes.Add(node);
            outlineFields.Add(f);

            if (isContainer) {
                this.AddOutlineChildren(f, depth + 1, q);
            }
        }
    }

    void OnOutlineSelect() {
        if (outlineSyncing || outlineTv == null) { return; }
        int idx = outlineTv.SelectedIndex();
        if (idx < 0 || idx >= outlineFields.Count) { return; }
        FormField target = outlineFields[idx];
        outlineSyncing = true;
        this.ClearExtraSel();
        this.sel = target;
        this.inspTab = 0;
        if (target != null) {
            if (this.DesignCanContain(target)) { this.activeContainer = target; }
            else { this.activeContainer = DesignOwnerOf(target); }
            this.msg = Designer.T("selected: ", "已选中：") + target.fname;
        } else {
            this.activeContainer = null;
            this.msg = Designer.T("selected window root", "已选中窗口根节点");
        }
        outlineSyncing = false;
    }

    void OnOutlineContext() {
        if (outlineTv == null) { return; }
        int row = outlineTv.ContextRow();
        if (row >= 0 && row < outlineFields.Count) {
            FormField target = outlineFields[row];
            this.ClearExtraSel();
            this.sel = target;
            this.inspTab = 0;
            if (target != null) {
                if (this.DesignCanContain(target)) { this.activeContainer = target; }
                else { this.activeContainer = DesignOwnerOf(target); }
                this.msg = Designer.T("selected: ", "已选中：") + target.fname;
            } else {
                this.activeContainer = null;
                this.msg = Designer.T("selected window root", "已选中窗口根节点");
            }
            this.SyncOutlineSelection();
        }
        canvasMenuOpen = true;
        canvasMenuArm = false;
        canvasMenuX = outlineTv.ContextX();
        canvasMenuY = outlineTv.ContextY();
        if (this.hostApp != null) { this.hostApp.RequestRedraw(); }
    }

    void SyncOutlineSelection() {
        if (outlineSyncing || outlineTv == null || outlineFields == null) { return; }
        int targetIdx = 0;
        if (sel != null) {
            for (int i = 1; i < outlineFields.Count; i = i + 1) {
                if (outlineFields[i] == sel) { targetIdx = i; break; }
            }
        }
        if (targetIdx > 0 && targetIdx < outlineNodes.Count) {
            int d = outlineNodes[targetIdx].depth;
            int j = targetIdx - 1;
            while (j >= 0) {
                if (outlineNodes[j].depth < d) {
                    if (outlineNodes[j].isDir) {
                        outlineNodes[j].expanded = true;
                    }
                    d = outlineNodes[j].depth;
                }
                j = j - 1;
            }
        }
        if (outlineTv.SelectedIndex() != targetIdx) {
            outlineSyncing = true;
            outlineTv.SelectIndex(targetIdx);
            outlineSyncing = false;
        }
    }

    // 惰性创建工具箱 TreeView，并在过滤串或用户组件数量变化时重建节点。
    void EnsurePalette() {
        if (palTv == null) {
            palNodes = new List<TreeNode>();
            palItems = new List<PaletteItem>();
            palTv = new TreeView();
            palTv.WithFilter(filterInput);
            palTv.Empty = Designer.T("No components match.", "没有匹配的组件。");
            palTv.OnSelect(() => { this.PalActivate(); });
            palTv.OnPress(() => { this.PalPress(); });
            palTv.OnExpand(() => { this.PalFoldNote(false); });
            palTv.OnCollapse(() => { this.PalFoldNote(true); });
            palBuilt = false;
            palBuiltQ = "";
            palBuiltUser = 0 - 1;
        }
        string q = filterInput.GetText();
        if (!palBuilt || q != palBuiltQ || userComps.Count != palBuiltUser) {
            this.BuildPalette(q);
            palBuilt = true;
            palBuiltQ = q;
            palBuiltUser = userComps.Count;
            palTv.Bind(palNodes);
        }
    }

    // 重建工具箱节点。过滤串非空时是一层扁平的匹配结果，
    // 否则是按类别分组的两层树。
    void BuildPalette(string q) {
        palNodes = new List<TreeNode>();
        palItems = new List<PaletteItem>();
        if (q != "") {
            for (int ft = 0; ft <= FormField.MaxType(); ft = ft + 1) {
                if (this.MatchesFilter(ft, q)) {
                    this.PalLeaf(FormField.TypeName(ft), FieldIcon(ft), ft, "", 0);
                }
            }
            for (int k = 0; k < userComps.Count; k = k + 1) {
                if (Designer.Contains(userComps[k].name, q)) {
                    this.PalLeaf(userComps[k].name, "layout", 200,
                        userComps[k].name, 0);
                }
            }
            return;
        }
        this.PalGroup(Designer.T("Basic", "基础"), 0, 8);
        this.PalGroup(Designer.T("Advanced", "高级"), 8, 15);
        this.PalGroup(Designer.T("Layout", "布局"), 15, 18);
        this.PalGroup(Designer.T("Display", "展示"), 18, 28);
        this.PalGroup(Designer.T("Feedback", "反馈"), 28, 34);
        this.PalGroup(Designer.T("Navigation", "导航"), 34, 40);
        this.PalGroup(Designer.T("Display+", "展示+"), 40, 47);
        this.PalGroup(Designer.T("Feedback+", "反馈+"), 47, 53);
        this.PalGroup(Designer.T("More", "更多"), 53, 55);
        this.PalGroup(Designer.T("Non-visual", "功能组件"), 55, 58);
        this.PalGroup(Designer.T("Shell", "窗口外壳"), 58, 62);
        this.PalGroup(Designer.T("Industrial", "工控"), 62, 72);
        this.PalGroup(Designer.T("Web", "网页"), 72, 73);
        this.PalGroup(Designer.T("Extended", "扩展"), 73, 86);
        if (userComps.Count > 0) {
            this.PalDir(Designer.T("My Components", "我的组件"));
            for (int k = 0; k < userComps.Count; k = k + 1) {
                this.PalLeaf(userComps[k].name, "layout", 200,
                    userComps[k].name, 1);
            }
        }
    }

    // 添加一个分组目录及其 [lo, hi) 类型区间内的组件叶子。
    void PalGroup(string title, int lo, int hi) {
        this.PalDir(title);
        for (int ft = lo; ft < hi; ft = ft + 1) {
            this.PalLeaf(FormField.TypeName(ft), FieldIcon(ft), ft, "", 1);
        }
    }

    // 添加一个分组目录节点（折叠状态按标题跨帧记忆）。
    void PalDir(string title) {
        palNodes.Add(TreeNode.Dir(title, 0, !this.PalFolded(title)));
        palItems.Add(new PaletteItem(0 - 1, ""));
    }

    // 添加一个组件叶子节点（palItems 与行下标一一对应）。
    void PalLeaf(string label, string icon, int kind, string custom, int depth) {
        palNodes.Add(TreeNode.FileIcon(label, depth, icon));
        palItems.Add(new PaletteItem(kind, custom));
    }

    // 事件涉及的行是组件叶子时返回其下标，否则返回 -1。
    int PalLeafRow() {
        int row = palTv.ContextRow();
        if (preview) { return 0 - 1; }
        if (row < 0 || row >= palItems.Count) { return 0 - 1; }
        if (palNodes[row].isDir) { return 0 - 1; }
        return row;
    }

    // 按名查找用户组件下标，不存在时 -1。
    int UserCompIndex(string name) {
        for (int k = 0; k < userComps.Count; k = k + 1) {
            if (userComps[k].name == name) { return k; }
        }
        return 0 - 1;
    }

    // 单击工具箱里的组件即添加一个；随后清掉选中，
    // 这样连点同一行可以连续添加。实际添加发生在抬起时
    // （见 PalClickRelease），因为按下这一刻还分不清点击和拖拽。
    void PalActivate() {
        int row = this.PalLeafRow();
        if (row < 0) { return; }
        palClickKind = palItems[row].kind;
        palClickCustom = palItems[row].custom;
        palClickPending = true;
        palTv.ClearSelection();
    }

    // 在工具箱上按下又原地抬起：这是一次点击，添加组件。
    void PalClickRelease() {
        if (!palClickPending) { return; }
        palClickPending = false;
        if (palClickKind == 200) {
            int k = this.UserCompIndex(palClickCustom);
            if (k >= 0) { AddUserComponent(k); }
        } else if (palClickCustom != "") {
            AddCustomField(palClickCustom);
        } else {
            AddField(palClickKind);
        }
    }

    // 在组件行上按下即开始一次拖拽，拖到画布上放开即添加。
    void PalPress() {
        int row = this.PalLeafRow();
        if (row < 0) { return; }
        dragging = true;
        dragFromPalette = true;
        dragMoved = false;
        dragKind = palItems[row].kind;
        dragCustomKind = "";
        dragUserComp = 0 - 1;
        if (dragKind == 200) {
            dragUserComp = this.UserCompIndex(palItems[row].custom);
        } else if (palItems[row].custom != "") {
            dragCustomKind = palItems[row].custom;
        }
        dragMouseX = palTv.ContextX();
        dragMouseY = palTv.ContextY();
    }

    // 记住分组的折叠状态，重建节点后仍然保留。
    void PalFoldNote(bool folded) {
        int row = palTv.ContextRow();
        if (row < 0 || row >= palNodes.Count) { return; }
        string title = palNodes[row].label;
        if (this.PalFolded(title) != folded) { this.PalToggleFold(title); }
    }

    // 当字段类型的 key 或显示名包含过滤关键字时为 true。
    bool MatchesFilter(int ft, string q) {
        if (q == "") { return true; }
        return Designer.Contains(FormField.TypeKey(ft), q)
            || Designer.Contains(FormField.TypeName(ft), q);
    }

    // 已折叠的分组标题。折叠状态按标题记住，跨帧保留。
    bool PalFolded(string title) {
        for (int i = 0; i < palFolded.Count; i = i + 1) {
            if (palFolded[i] == title) { return true; }
        }
        return false;
    }

    // 切换分组标题的折叠记忆。
    void PalToggleFold(string title) {
        for (int i = 0; i < palFolded.Count; i = i + 1) {
            if (palFolded[i] == title) {
                palFolded = ListRemoveStr(palFolded, i);
                return;
            }
        }
        palFolded.Add(title);
    }

    // 重建不含 idx 处元素的字符串列表（与 ListMove 同一规避）。
    static List<string> ListRemoveStr(List<string> src, int idx) {
        List<string> outl = new List<string>();
        for (int i = 0; i < src.Count; i = i + 1) {
            if (i != idx) { outl.Add(src[i]); }
        }
        return outl;
    }

    // 点是否在矩形内（含右/下边界）。
    bool InRect(int mx, int my, int x, int y, int w, int h) {
        return mx >= x && mx <= x + w && my >= y && my <= y + h;
    }

    // WinForms 风格组件托盘：表单上的每个非可视组件
    // 在此显示为一个小块。点击选中它，其属性和
    // 事件即可在检查器中编辑；选中的小块会高亮。
    void RenderTray(App app, Canvas c, Theme t, int x, int y, int w, int h) {
        int fs = Style.FontFallback(app, "small");
        c.FillRoundRect(x, y, w, h, app.Scale(6), Style.Part(app, "designer", "panel", "", "", "", Style.SNormal()).BgOr(0));
        c.DrawRoundRect(x, y, w, h, app.Scale(6), Style.Part(app, "designer", "panel", "", "", "", Style.SNormal()).BorderOr(0), 1);
        bool overTray = dragging && dragFromPalette
            && FormField.IsNonVisualOf(dragKind)
            && InRect(dragMouseX, dragMouseY, x, y, w, h);
        if (overTray) { c.DrawRect(x, y, w, h, Style.Part(app, "designer", "accent", "", "", "", Style.SNormal()).BgOr(0), 2); }
        int bx = x + app.Scale(10);
        int by = y + (h - app.Scale(28)) / 2;
        bool any = false;
        for (int i = 0; i < fields.Count; i = i + 1) {
            FormField f = fields[i];
            if (f.IsNonVisual()) {
                any = true;
                string nm = f.fname;
                if (nm == "") { nm = FormField.TypeName(f.ftype); }
                int ty = 0;
                if (!preview && f == sel) { ty = 1; }
                int bid = app.focus.AllocId();
                Button b = new Button { wid = bid, Text = nm, Icon = FieldIcon(f.ftype),
                                        Class = "small " + Style.TypeClass(ty) };
                int bw = Canvas.MeasureText(nm, fs) + app.Scale(44);
                int id = b.Render(app, bx, by, bw);
                if (!preview && Ui.Clicked(app, id)) {
                    sel = f;
                    activeContainer = null;
                    inspTab = 0;
                    app.RequestRedraw();
                }
                bx = bx + bw + app.Scale(8);
            }
        }
        if (!any) {
            c.DrawText(bx, Canvas.CenterTextY(y, h, fs),
                Designer.T("Component tray — context menus, layers, timers and other non-visual components land here.",
                    "组件托盘 —— 右键菜单、Layer、定时器等功能组件会放在这里。"),
                Style.Part(app, "designer", "hint", "", "", "", Style.SNormal()).FgOr(0), fs);
        }
        // 把非可视字段的拖拽放到托盘任意位置即可添加。
        if (overTray && app.EventKind() == 3) {
            activeContainer = null;
            AddField(dragKind);
            dragging = false;
            dragFromPalette = false;
            dragMoved = false;
            dropContainer = null;
            app.RequestRedraw();
        }
    }

    // 把字段的列跨度限制到合法的 1..24 网格范围。
    int ClampSpan(int sp) {
        if (sp < 1) { return 24; }
        if (sp > 24) { return 24; }
        return sp;
    }

    // 面板悬停 tooltip 中显示的一行描述。
    string FieldDesc(int ft) {
        if (ft == 0) { return Designer.T("Single-line text input", "单行文本输入框"); }
        if (ft == 1) { return Designer.T("Multi-line text area", "多行文本域"); }
        if (ft == 2) { return Designer.T("Masked password input", "密码输入框"); }
        if (ft == 3) { return Designer.T("Numeric stepper input", "数字步进输入框"); }
        if (ft == 4) { return Designer.T("Single choice from options", "单选项"); }
        if (ft == 5) { return Designer.T("Multiple choice from options", "多选项"); }
        if (ft == 6) { return Designer.T("Dropdown selector", "下拉选择器"); }
        if (ft == 7) { return Designer.T("On / off toggle", "开 / 关开关"); }
        if (ft == 8) { return Designer.T("Star rating", "星级评分"); }
        if (ft == 9) { return Designer.T("Value slider", "滑块"); }
        if (ft == 10) { return Designer.T("Date picker", "日期选择器"); }
        if (ft == 11) { return Designer.T("Time picker", "时间选择器"); }
        if (ft == 12) { return Designer.T("File upload area", "文件上传区域"); }
        if (ft == 13) { return Designer.T("Colour picker", "颜色选择器"); }
        if (ft == 14) { return Designer.T("Rich text editor", "富文本编辑器"); }
        if (ft == 15) { return Designer.T("Section heading text", "章节标题文本"); }
        if (ft == 16) { return Designer.T("Static paragraph text", "静态段落文本"); }
