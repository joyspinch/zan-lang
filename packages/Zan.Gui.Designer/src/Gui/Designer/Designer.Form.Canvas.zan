using System;
using System.Collections.Generic;
using System.Json;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Backend;

namespace Gui.Designer;

partial class Designer {
    // 设计画布：信箱式窗口 + 网格 + 字段 + 场景设计器那套交互
    // 模型（选择 / 拖拽 / 框选 / 抓手平移 / 缩放 / 面板放置）。
    // 表单（自动吸附）和自由窗口共用这一份实现。
    void RenderDesignCanvas(App app, Canvas c, Theme t, int cx, int cy, int cw, int ch) {
        if (app == null || c == null || cw <= 0 || ch <= 0) { return; }
        int fs = Style.FontFallback(app, "small");
        bool free = layoutMode == 1;
        // 浮层窗口（大编辑器、右键菜单、快速插入或帮助）开着时画布的裸指针路径整体让位：
        // 窗口矩形只护得住走命中测试的控件，选中/拖拽/滚轮这些直接读指针
        // 事件的路径会从浮层底下穿透到画布，因此必须联合锁定。
        bool locked = this.BigEditorOpen() || canvasMenuOpen || quickInsertOpen || keymapHelpOpen
            || zoomMenuOpen || dpiMenuOpen || ribbonMenuOpen || activeEventDropdown != ""
            || app.HasOverlays();
        c.FillRoundRect(cx, cy, cw, ch, app.Scale(6), Style.Full(app, "designer", "", "", Style.SNormal()).BgOr(0));
        c.DrawRoundRect(cx, cy, cw, ch, app.Scale(6), Style.Full(app, "designer", "", "", Style.SNormal()).BorderOr(0), 1);

        // 只由独立 Form 按目标窗口尺寸/DPI 量测布局，视图比例不进入树。
        if (!this.PrepareDesignPreview(app) || !this.PreviewHasLayout()) {
            hoverField = null;
            tabHits = new List<TabHeaderHit>();
            c.DrawText(cx + app.Scale(12), cy + app.Scale(10),
                Designer.T("Preview unavailable", "预览暂不可用"),
                Style.Part(app, "designer", "hint", "", "", "", Style.SNormal()).FgOr(0), fs);
            return;
        }
        int dw = winW < 40 ? 40 : winW;
        int dh = winH < 40 ? 40 : winH;
        DesignerCanvasInput geometry = canvasInput != null ? canvasInput : new DesignerCanvasInput();
        this.UpdateCanvasGeometry(app, cx, cy, cw, ch, geometry);
        int inX = geometry.inX; int inY = geometry.inY; int inW = geometry.inW; int inH = geometry.inH;
        int ox = geometry.ox; int oy = geometry.oy; int psMilli = geometry.ps;
        int cw2 = geometry.viewW; int ch2 = geometry.viewH;
        c.PushClip(inX, inY, inW, inH);
        this.PaintDesignPreview(c, ox, oy, cw2, ch2);
        if (UiDriver.Active()) {
            UiDriver.SetProbe("designer", this.DesignPreviewProbe(ox, oy, cw2, ch2));
        }

        c.PushClip(ox, oy, cw2, ch2);
        this.RegisterDesignTabs(ox, oy, psMilli);
        this.UpdateCanvasHover(app, locked, ox, oy, cw2, ch2, inX, inY, inW, inH, psMilli);
        this.RenderCanvasGrid(app, c, free, ox, oy, psMilli, dw, dh);
        if (!preview && fields != null) {
            for (int i = 0; i < fields.Count; i = i + 1) {
                this.RenderDesignOverlay(app, c, fields[i], ox, oy, psMilli);
            }
            this.RenderMultiSelBounds(app, c, ox, oy, psMilli);
        }
        c.PopClip();

        this.HandleCanvasDropTarget(app, c, t, locked, free, 0, inX, inY, inW, inH,
            ox, oy, psMilli, dw, cw2, ch2);
        if (freePanning) { Window.SetCursor(1); }
        this.HandleCanvasMarquee(app, c, 0, ox, oy, psMilli);
        this.RenderCanvasHudsAndGuides(app, c, ox, oy, psMilli, cw2, ch2);

        if (!preview && showGuides) {
            this.RenderCanvasGuides(app, c, inX, inY, inW, inH, ox, oy, psMilli, dw, dh);
        }
        if (!preview && showRulers) {
            this.DrawCanvasRulers(app, c, inX, inY, inW, inH, ox, oy, psMilli, dw, dh, sel);
        }

        c.PopClip();
    }

    void HandleCanvasZoom(App app, bool locked, int inX, int inY, int inW, int inH, int ox, int oy, Canvas source) {
        if (app == null || app.window == null) { return; }
        // Ctrl+滚轮以光标所在的设计物理位置为锚点平滑缩放画布（Fit 从
        // 实际适配比例起步，因此从 Fit 缩出时平滑且无漂移）。
        // 编辑器窗口开着时让位（locked），滚轮别穿透到画布。
        if (!locked && InRect(app.mouseX, app.mouseY, inX, inY, inW, inH)
                && Modifiers.HasCtrl(app.window.EventMods())) {
            if (canvasInputDispatch) {
                int wdelta = app.window.EventKeyCode();
                int z = winZoom;
                if (z <= 0) { z = lastFitPct; }
                int oldZ = z;
                if (wdelta > 0) { z = z + 100; }
                else if (wdelta < 0) { z = z - 100; }
                if (z < 250) { z = 250; }
                if (z > 2000) { z = 2000; }
                if (z != oldZ) {
                    int oldPs = oldZ * this.DesignDpi() / 100;
                    int newPs = z * this.DesignDpi() / 100;
                    if (source != null && oldPs > 0 && newPs > 0) {
                        int cw2New = this.DesignViewPx(source.Width(), newPs);
                        int ch2New = this.DesignViewPx(source.Height(), newPs);
                        int relXOld = app.mouseX - ox;
                        int relYOld = app.mouseY - oy;
                        int relXNew = relXOld * newPs / oldPs;
                        int relYNew = relYOld * newPs / oldPs;
                        freePanX = relXNew - (app.mouseX - (inX + (inW - cw2New) / 2));
                        freePanY = relYNew - (app.mouseY - (inY + (inH - ch2New) / 2));
                    }
                    winZoom = z;
                    app.RequestRedraw();
                }
            }
        } else if (!locked && !preview && InRect(app.mouseX, app.mouseY, inX, inY, inW, inH)) {
            // 普通滚轮垂直平移，Shift+滚轮水平平移。
            if (canvasInputDispatch) {
                int wdelta = app.window.EventKeyCode();
                int step = app.Scale(48);
                if (Modifiers.HasShift(app.window.EventMods())) {
                    if (wdelta > 0) { freePanX = freePanX - step; }
                    else if (wdelta < 0) { freePanX = freePanX + step; }
                } else {
                    if (wdelta > 0) { freePanY = freePanY - step; }
                    else if (wdelta < 0) { freePanY = freePanY + step; }
                }
                app.RequestRedraw();
            }
        }

    }

    void HandleCanvasMiddlePan(App app, bool locked, int ek, int inX, int inY, int inW, int inH) {
        if (app == null || app.window == null) { return; }
        // 抓手：中键在视口任意处按下即抓住画布拖动，
        // 和场景设计器一致（左键留给选择和框选）。
        if (!locked && ek == 2 && app.window.EventButton() == 2
                && InRect(app.mouseX, app.mouseY, inX, inY, inW, inH)) {
            freePanning = true;
            freePanSX = app.mouseX;
            freePanSY = app.mouseY;
            freePanOX = freePanX;
            freePanOY = freePanY;
        }

    }

    void UpdateCanvasHover(App app, bool locked, int ox, int oy, int cw2, int ch2, int inX, int inY, int inW, int inH, int psMilli) {
        if (app == null) { return; }
        if (!locked && !preview && InRect(app.mouseX, app.mouseY, ox, oy, cw2, ch2)
                && InRect(app.mouseX, app.mouseY, inX, inY, inW, inH)
                && !dragging && !freeDragging && !freePanning) {
            FormField picked = this.DesignPickView(app.mouseX, app.mouseY, ox, oy, psMilli);
            if (picked != hoverField) {
                hoverField = picked;
                app.RequestRedraw();
            }
        } else if (hoverField != null) {
            hoverField = null;
            app.RequestRedraw();
        }
    }

    void RenderCanvasGrid(App app, Canvas c, bool free, int ox, int oy, int psMilli, int dw, int dh) {
        if (app == null || c == null || psMilli <= 0) { return; }
        if (!preview && showGrid && gridSize > 0 && free) {
            int step = gridSize;
            int minStep = app.Scale(6);
            if (minStep < 1) { minStep = 1; }
            while (step < 100000 && step * psMilli / 1000 < minStep) { step = step * 2; }
            int gridCol = Style.Part(app, "designer", "grid", "", "", "", Style.SNormal()).BgOr(0);
            if (gridCol == 0) {
                gridCol = Style.Fade(Style.Part(app, "designer", "hint", "", "", "", Style.SNormal()).FgOr(0), 85);
            } else {
                gridCol = Style.Fade(gridCol, 90);
            }
            int dotSz = app.Scale(2);
            if (dotSz < 1) { dotSz = 1; }
            for (int gy = 0; gy <= dh; gy = gy + step) {
                int py = oy + gy * psMilli / 1000;
                for (int gx = 0; gx <= dw; gx = gx + step) {
                    bool hitLeaf = false;
                    if (fields != null) {
                        for (int fi = 0; fi < fields.Count; fi = fi + 1) {
                            FormField f = fields[fi];
                            if (f != null && !f.IsContainer() && gx >= f.fx && gx < f.fx + f.fw && gy >= f.fy && gy < f.fy + f.fh) {
                                hitLeaf = true;
                                break;
                            }
                        }
                    }
                    if (!hitLeaf) {
                        c.FillRect(ox + gx * psMilli / 1000, py, dotSz, dotSz, gridCol);
                    }
                }
            }
        }
    }

    void HandleCanvasDropTarget(App app, Canvas c, Theme t, bool locked, bool free, int ek, int inX, int inY, int inW, int inH, int ox, int oy, int psMilli, int dw, int cw2, int ch2) {
        if (app == null || psMilli <= 0) { return; }
        // 放置目标：自由布局落在光标处；流式布局解析插入位置
        // 或指针下的容器，并画出插入线。自由画布拖拽（面板拖入或
        // 画布内拖动）给光标下的容器描边预告落点；画布内拖动松手
        // 即换父——组件从此可以拖进/拖出容器，坐标自动换算。
        if (!locked && !preview && free) {
            if (dragging && dragFromPalette && ek == 3
                    && InRect(app.mouseX, app.mouseY, inX, inY, inW, inH)
                    && InRect(app.mouseX, app.mouseY, ox, oy, cw2, ch2)) {
                int mDesX = (app.mouseX - ox) * 1000 / psMilli;
                int mDesY = (app.mouseY - oy) * 1000 / psMilli;
                DropFreePalette(mDesX, mDesY, this.DesignPointerPx(app.mouseX, ox, psMilli),
                    this.DesignPointerPx(app.mouseY, oy, psMilli));
            } else if (dragging && dragFromPalette) {
                if (c != null) {
                    this.DrawFreeDropHi(app, c, ox, oy, psMilli,
                        this.FreeDropContainerDevice(this.DesignPointerPx(app.mouseX, ox, psMilli),
                            this.DesignPointerPx(app.mouseY, oy, psMilli)));
                }
            } else if (freeDragging && freeDragHasMoved && sel != null) {
                FormField cont = this.FreeDropContainerDevice(this.DesignPointerPx(app.mouseX, ox, psMilli),
                        this.DesignPointerPx(app.mouseY, oy, psMilli));
                FormField currentParent = this.DesignOwnerOf(sel);
                bool invalidDrop = false;
                if (cont != null) {
                    if (cont == sel || this.DesignInSubtree(sel, cont)) { invalidDrop = true; }
                    if (freeExtra != null) {
                        for (int ei = 0; ei < freeExtra.Count; ei = ei + 1) {
                            FormField ef = freeExtra[ei];
                            if (ef != null && (cont == ef || this.DesignInSubtree(ef, cont))) {
                                invalidDrop = true;
                                break;
                            }
                        }
                    }
                }
                if (invalidDrop) {
                    cont = currentParent;
                }
                if (cont != null) {
                    this.FlowDropTarget(app, c, t, ox, oy, psMilli, dw);
                } else if (c != null && cont == null && currentParent != null) {
                    this.DrawFreeDropRootHi(app, c, ox, oy, psMilli, cw2, ch2);
                }
                if (ek == 3) {
                    // 只在画布内松手才换父：拖到画布外（工具条/检查器
                    // 上）松手不算拖出，免得组件被意外拽成顶层。
                    if (InRect(app.mouseX, app.mouseY, ox, oy, cw2, ch2)
                            && InRect(app.mouseX, app.mouseY, inX, inY, inW, inH)) {
                        this.FreeReparentSel(cont);
                    }
                    app.RequestRedraw();
                }
            }
        } else if (!locked && !preview && !free && dragging && (dragFromPalette || dragMoved)
                && InRect(app.mouseX, app.mouseY, inX, inY, inW, inH)
                && InRect(app.mouseX, app.mouseY, ox, oy, cw2, ch2)) {
            this.FlowDropTarget(app, c, t, ox, oy, psMilli, dw);
            if (ek == 3) { DropField(); app.RequestRedraw(); }
        }

    }

    bool HandleCanvasHandMode(App app, bool locked, int ek, int inX, int inY, int inW, int inH) {
        bool activeHand = freeHand || spacePressed;
        if (activeHand) { freeDragging = false; freeResizing = false; freeMarquee = false; }
        if (app == null || app.window == null) { return activeHand; }
        if (!locked && activeHand && InRect(app.mouseX, app.mouseY, inX, inY, inW, inH)) {
            Window.SetCursor(1);
            if (ek == 2 && app.window.EventButton() == 0) {
                if (app.focus != null) { app.focus.ClearFocus(); }
                freePanning = true;
                freePanSX = app.mouseX;
                freePanSY = app.mouseY;
                freePanOX = freePanX;
                freePanOY = freePanY;
            }
        }
        return activeHand;
    }

    void HandleCanvasContextMenu(App app, bool locked, bool activeHand, int ek, int inX, int inY, int inW, int inH, int ox, int oy, int psMilli, int cw2, int ch2) {
        if (app == null || app.window == null || psMilli <= 0) { return; }
        // 画板右键菜单触发：在画板内右键点击，命中控件则选中该控件并弹出上下文菜单，点在空白处则弹出全局画布菜单
        if (!locked && !preview && !activeHand && !dragging && ek == 2 && app.window.EventButton() == 1
                && InRect(app.mouseX, app.mouseY, inX, inY, inW, inH)) {
            if (app.focus != null) { app.focus.ClearFocus(); }
            FormField hit = InRect(app.mouseX, app.mouseY, ox, oy, cw2, ch2)
                ? this.DesignPickView(app.mouseX, app.mouseY, ox, oy, psMilli) : null;
            if (hit != null) {
                if (hit != sel && !this.IsExtraSel(hit)) {
                    this.ClearExtraSel();
                    sel = hit;
                    inspTab = 0;
                    if (this.DesignCanContain(hit)) { activeContainer = hit; }
                    else { activeContainer = DesignOwnerOf(hit); }
                }
                canvasMenuHit = hit;
            } else {
                this.ClearExtraSel();
                sel = null;
                canvasMenuHit = null;
            }
            this.OpenCanvasMenu(app, app.mouseX, app.mouseY);
            app.RequestRedraw();
        }

        // 指针按下：选中的调整大小手柄优先，否则选择并
    }

    void HandleCanvasPointerDown(App app, bool locked, bool activeHand, bool free, int ek, int inX, int inY, int inW, int inH, int ox, int oy, int psMilli, int cw2, int ch2) {
        if (app == null || app.window == null || psMilli <= 0) { return; }
        // 开始拖拽；按在空白处清除选择。编辑器窗口开着时让位。
        if (!locked && !activeHand && !dragging && ek == 2 && app.window.EventButton() == 0
                && InRect(app.mouseX, app.mouseY, inX, inY, inW, inH)) {
            if (app.focus != null && canvasInput != null) {
                app.focus.SetFocused(canvasInput.WidgetId(), canvasInput);
            }
            bool started = false;
            // 拖拽基先对齐当前选中项：框选/撤销/换父之后存的旧基
            // 会让手柄命中测试与随后的拖拽全部错位。
            if (free) { this.SyncFreeSelBase(); }
            TabHeaderHit th = preview || !InRect(app.mouseX, app.mouseY, ox, oy, cw2, ch2) ? null
                : this.PickTabHeader(app.mouseX, app.mouseY, ox, oy, psMilli);
            if (th != null && th.tabs != null) {
                // 点页签就是翻页：顺带把这个 Tabs 设为活动容器，
                // 接着添加/放下的组件落在正看着的这一页上。
                if (th.tabs.uiState != null) { th.tabs.uiState.Set(th.page); }
                sel = th.tabs;
                inspTab = 0;
                activeContainer = th.tabs;
                this.ClearExtraSel();
                this.MarkDocDirty();
                msg = Designer.T("tab ", "标签页 ") + Convert.ToString(th.page + 1);
                started = true;
            }
            if (!started && !preview && free && sel != null && !sel.locked && this.DesignVisible(sel)) {
                List<FormField> mItems = this.GetMultiSelItems();
                if (mItems != null && mItems.Count > 1) {
                    Rect mw = this.GetMultiSelWorldRect(mItems);
                    if (mw != null) {
                        int sx = ox + mw.x * psMilli / 1000;
                        int sy = oy + mw.y * psMilli / 1000;
                        int sw2 = mw.width * psMilli / 1000;
                        int sh2 = mw.height * psMilli / 1000;
                        int hs = app.Scale(10);
                        for (int hn = 0; hn < 8 && !started; hn = hn + 1) {
                            int hx = FreeHandleX(hn, sx, sw2);
                            int hy = FreeHandleY(hn, sy, sh2);
                            if (InRect(app.mouseX, app.mouseY, hx - hs, hy - hs, hs * 2, hs * 2)) {
                                freeResizing = true;
                                freeResizeH = hn;
                                designResizeMoved = false;
                                designResizeMouseX = (app.mouseX - ox) * 1000 / psMilli;
                                designResizeMouseY = (app.mouseY - oy) * 1000 / psMilli;
                                designResizeLeft = mw.x;
                                designResizeTop = mw.y;
                                designResizeRight = mw.x + mw.width;
                                designResizeBottom = mw.y + mw.height;
                                multiResizeStarts = new List<MultiResizeItem>();
                                for (int mi = 0; mi < mItems.Count; mi = mi + 1) {
                                    FormField mf = mItems[mi];
                                    if (mf == null) { continue; }
                                    multiResizeStarts.Add(new MultiResizeItem(mf,
                                        this.DesignWorldX(mf), this.DesignWorldY(mf),
                                        mf.LayoutW(), mf.LayoutH()));
                                }
                                started = true;
                            }
                        }
                    }
                } else {
                    Rect selected = this.DesignViewRect(sel, ox, oy, psMilli);
                    if (selected != null) {
                        int sx = selected.x;
                        int sy = selected.y;
                        int sw2 = selected.width;
                        int sh2 = selected.height;
                        int hs = app.Scale(10);
                        int nearest = -1;
                        int distance = hs * hs * 2 + 1;
                        for (int hn = 0; hn < 8; hn = hn + 1) {
                            if (!Designer.FreeHandleAllowed(sel, hn)) { continue; }
                            int hx = FreeHandleX(hn, sx, sw2);
                            int hy = FreeHandleY(hn, sy, sh2);
                            int dx = app.mouseX - hx; int dy = app.mouseY - hy;
                            int squared = dx * dx + dy * dy;
                            if (InRect(app.mouseX, app.mouseY, hx - hs, hy - hs, hs * 2, hs * 2)
                                    && squared < distance) { nearest = hn; distance = squared; }
                        }
                        if (nearest >= 0) {
                                freeResizing = true;
                                freeResizeH = nearest;
                                designResizeMoved = false;
                                designResizeMouseX = (app.mouseX - ox) * 1000 / psMilli;
                                designResizeMouseY = (app.mouseY - oy) * 1000 / psMilli;
                                designResizeLeft = this.DesignWorldX(sel);
                                designResizeTop = this.DesignWorldY(sel);
                                designResizeRight = designResizeLeft + sel.LayoutW();
                                designResizeBottom = designResizeTop + sel.LayoutH();
                                multiResizeStarts = null;
                                started = true;
                        }
                    }
                }
            }
            if (!started && preview) { started = true; }
            if (!started) {
                int mDesX = (app.mouseX - ox) * 1000 / psMilli;
                int mDesY = (app.mouseY - oy) * 1000 / psMilli;
                FormField hit = InRect(app.mouseX, app.mouseY, ox, oy, cw2, ch2)
                ? this.DesignPickView(app.mouseX, app.mouseY, ox, oy, psMilli) : null;
                bool ctrl = Modifiers.HasCtrl(app.window.EventMods());
                if (hit != null && ctrl) {
                    // Ctrl+点击：加入/移出多选（第一个点中的成为主选中项）。
                    if (sel == null) { sel = hit; }
                    else if (hit != sel) { this.ToggleExtraSel(hit); }
                } else if (hit != null) {
                    // 按住多选中的任一成员整组一起拖。
                    if (hit != sel && !this.IsExtraSel(hit)) {
                        this.ClearExtraSel();
                    } else if (hit != sel && this.IsExtraSel(hit)) {
                        this.ToggleExtraSel(hit);
                        if (sel != null && freeExtra != null) { freeExtra.Add(sel); }
                    }
                    sel = hit;
                    inspTab = 0;
                    if (this.DesignCanContain(hit)) { activeContainer = hit; }
                    else { activeContainer = DesignOwnerOf(hit); }
                    this.SyncOutlineSelection();
                    if (hit.locked) {
                        // 锁定：选得中、改得了属性，就是拖不动。
                        msg = Designer.T("Component is locked — press Ctrl+L to unlock", "组件已锁定 (按 Ctrl+L 解锁)");
                    } else if (free) {
                        // 记录拖拽预备状态与起点坐标，只有产生真实位移时才解除停靠与压 Undo 栈，
                        // 避免单纯点击或切换属性时误将组件的“填充/停靠”还原为自由定位。
                        freeDragging = true;
                        freeDragStartX = mDesX;
                        freeDragStartY = mDesY;
                        freeDragHasMoved = false;
                        designDragLeft = this.DesignWorldX(hit);
                        designDragTop = this.DesignWorldY(hit);
                        designDragWidth = hit.LayoutW();
                        designDragHeight = hit.LayoutH();
                        freeDragDx = mDesX - designDragLeft;
                        freeDragDy = mDesY - designDragTop;
                    } else {
                        // 流式布局：拖动就是重排（拖到容器上则移入）。
                        int ti = IndexIn(fields, this.TopLevelOf(hit));
                        if (ti >= 0) {
                            this.PushUndo();
                            dragging = true;
                            dragFromPalette = false;
                            dragMoved = false;
                            dragIndex = ti;
                            dragMouseX = app.mouseX;
                            dragMouseY = app.mouseY;
                        }
                    }
                } else {
                    // 按在空白处拉框选（松开时选中框到的组件），
                    // 和场景设计器一致；平移用中键或设计窗口外的空白。
                    sel = null;
                    activeContainer = null;
                    if (!ctrl) { this.ClearExtraSel(); }
                    freeMarquee = true;
                    freeMqSX = app.mouseX;
                    freeMqSY = app.mouseY;
                }
            }
            app.RequestRedraw();
        }

        // 平移拖拽：跟随指针移动视口。
    }
}
