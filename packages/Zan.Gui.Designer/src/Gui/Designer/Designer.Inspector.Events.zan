using System;
using Gui.Widget;
using Gui;
using System.Json;

namespace Gui.Designer;

partial class Designer {
    List<PropSpec> WindowSpecs() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Section(Designer.T("WINDOW", "窗口")));
        PropSpec ti = PropSpec.Text("title", Designer.T("Title", "标题"));
        ti.str = winTitle;
        ti.tip = Designer.T("Text shown in the window's title bar and taskbar.",
            "显示在窗口标题栏和任务栏的文字。");
        ps.Add(ti);
        // 目标设备画像：桌面自由尺寸（宽高可编辑），锁定类设备
        // （手机/平板/电视/车机/穿戴）的画布由画像给出，宽高行
        // 收起，只保留画像允许的横竖屏切换。镜像下标每帧从模型
        // 同步，PropertyGrid 经绑定写回后由渲染后差量应用。
        devSelIdx = DeviceProfile.IndexOfId(device);
        devOrient = 0;
        if (winW > winH) { devOrient = 1; }
        List<string> devOpts = new List<string>();
        List<DeviceProfile> dps = DeviceProfile.All();
        for (int di = 0; di < dps.Count; di = di + 1) {
            devOpts.Add(Designer.T(dps[di].Label("en"), dps[di].Label("zh")));
        }
        PropSpec dv = PropSpec.Enum("device", Designer.T("Target device", "目标设备"), devOpts);
        dv.num = devSelIdx;
        dv.tip = Designer.T(
            "Design canvas contract: Desktop is free-size; locked devices pin the canvas to their profile viewport (only the declared orientation may change).",
            "设计画布契约：桌面自由尺寸；锁定类设备把画布钉在画像基准视口上，只允许声明的横竖屏切换。");
        ps.Add(dv);
        DeviceProfile curDev = DeviceProfile.At(devSelIdx);
        bool devLocked = curDev != null && curDev.Locked();
        if (devLocked) {
            if (curDev.Rotatable()) {
                List<string> orOpts = new List<string>{
                    Designer.T("Portrait", "竖屏"), Designer.T("Landscape", "横屏") };
                PropSpec oro = PropSpec.Enum("orient", Designer.T("Orientation", "方向"), orOpts);
                oro.num = devOrient;
                oro.tip = Designer.T(
                    "Portrait or landscape viewport of the locked device profile.",
                    "锁定设备画像的竖屏 / 横屏基准视口。");
                ps.Add(oro);
            }
        } else {
            PropSpec ww = PropSpec.Int("width", Designer.T("Width", "宽度 (W)")).Half();
            ww.num = winW;
            ww.Step(10, 100, 4000);
            ww.tip = Designer.T("Window width in pixels.", "窗口宽度（像素）。");
            ps.Add(ww);
            PropSpec wh = PropSpec.Int("height", Designer.T("Height", "高度 (H)")).Half();
            wh.num = winH;
            wh.Step(10, 100, 4000);
            wh.tip = Designer.T("Window height in pixels.", "窗口高度（像素）。");
            ps.Add(wh);
        }
        PropSpec rz = PropSpec.Bool("resizable", Designer.T("Resizable", "可调整大小"));
        rz.flag = winResizable;
        rz.tip = Designer.T("Allow the user to drag the window edges to resize it.",
            "允许用户拖动窗口边缘调整大小。");
        ps.Add(rz);
        PropSpec tm = PropSpec.Bool("topMost", Designer.T("Always on top", "保持置顶 (TopMost)"));
        tm.flag = winTopMost;
        tm.tip = Designer.T("Keep the window on top of other windows.", "保持窗口始终在最前端（置顶）。");
        ps.Add(tm);
        PropSpec mw = PropSpec.Int("minWidth", Designer.T("Min width", "最小宽")).Half();
        mw.num = winMinWidth;
        mw.Step(10, 0, 4000);
        mw.tip = Designer.T("Minimum window width in pixels (0 for default).", "窗口最小允许宽度（像素，0 为默认）。");
        ps.Add(mw);
        PropSpec mh = PropSpec.Int("minHeight", Designer.T("Min height", "最小高")).Half();
        mh.num = winMinHeight;
        mh.Step(10, 0, 4000);
        mh.tip = Designer.T("Minimum window height in pixels (0 for default).", "窗口最小允许高度（像素，0 为默认）。");
        ps.Add(mh);
        PropSpec tw = PropSpec.Bool("tool", Designer.T("Tool window", "工具窗口"));
        tw.flag = winTool;
        tw.tip = Designer.T(
            "Tool window: thin title bar, no taskbar button -- for palettes/dialogs.",
            "工具窗口：细标题栏、不占任务栏，适合调色板/对话框。");
        ps.Add(tw);
        PropSpec ct = PropSpec.Bool("center", Designer.T("Center on show", "显示时居中"));
        ct.flag = winCenter;
        ct.tip = Designer.T(
            "Center the window on screen when shown; turn off to set Position X/Y.",
            "显示时居中窗口；关闭后可手动设置位置 X/Y。");
        ps.Add(ct);
        if (!winCenter) {
            PropSpec pxs = PropSpec.Int("posX", Designer.T("Position X", "位置 X")).Half();
            pxs.num = winPosX;
            pxs.Step(10, 0 - 4000, 4000);
            pxs.tip = Designer.T("Window left position on screen (pixels).",
                "窗口在屏幕上的左边位置（像素）。");
            ps.Add(pxs);
            PropSpec pys = PropSpec.Int("posY", Designer.T("Position Y", "位置 Y")).Half();
            pys.num = winPosY;
            pys.Step(10, 0 - 4000, 4000);
            pys.tip = Designer.T("Window top position on screen (pixels).",
                "窗口在屏幕上的顶边位置（像素）。");
            ps.Add(pys);
        }
        PropSpec gl = PropSpec.Bool("glass", Designer.T("Frosted glass", "毛玻璃效果"));
        gl.flag = winGlass;
        gl.tip = Designer.T(
            "Frosted-glass (acrylic) window background that blurs what's behind it.",
            "毛玻璃（亚克力）窗口背景，会模糊窗口后方内容。");
        ps.Add(gl);
        // 窗口轮廓：异形窗口按像素 alpha 合成，设计画布预览形状，
        // 自定义形状（winShape == 3）是以 JSON 编写的区域并集，
        // 只能在 JSON 抽屉里编辑。
        List<string> shapeOpts = new List<string>{
            Designer.T("Rect", "矩形"),
            Designer.T("Rounded", "圆角"),
            Designer.T("Ellipse", "圆形"),
            Designer.T("Custom", "自定义") };
        PropSpec sh = PropSpec.Enum("shape", Designer.T("Window shape", "窗口形状"), shapeOpts);
        sh.num = winShape;
        sh.tip = Designer.T(
            "Window outline: Rect, Rounded, Ellipse, or Custom (a JSON union of regions edited in the JSON drawer).",
            "窗口轮廓：矩形、圆角、圆形或自定义（在 JSON 抽屉里编辑的区域并集）。");
        ps.Add(sh);
        if (winShape == 1) {
            if (winShapeRadius <= 0) { winShapeRadius = 12; }
            PropSpec rr = PropSpec.Int("radius", Designer.T("Corner radius", "圆角半径"));
            rr.num = winShapeRadius;
            rr.Step(2, 0, 80);
            rr.tip = Designer.T("Corner radius in pixels for the rounded window shape.",
                "圆角窗口的圆角半径（像素）。");
            ps.Add(rr);
        }
        if (winShape != 0) {
            PropSpec sd = PropSpec.Int("shadow", Designer.T("Shadow (px)", "阴影大小（像素）"));
            sd.num = winShadow;
            sd.Step(2, 0, 40);
            sd.tip = Designer.T("Window shadow blur extent in pixels (0 for none).",
                "窗口外围柔和阴影大小（像素，0 为无阴影）。");
            ps.Add(sd);
        }
        PropSpec ch = PropSpec.Bool("chrome", Designer.T("Title bar", "标题栏"));
        ch.flag = winChrome;
        ch.tip = Designer.T(
            "Show the native title bar; turn off for a borderless/custom-chrome window.",
            "显示原生标题栏；关闭则为无边框/自绘标题栏窗口。");
        ps.Add(ch);
        PropSpec op = PropSpec.Int("opacity", Designer.T("Opacity (10-100)", "不透明度（10-100）"));
        op.num = winOpacity;
        op.Step(5, 10, 100);
        op.tip = Designer.T(
            "Whole-window opacity, 10 (nearly transparent) to 100 (opaque).",
            "整个窗口的不透明度，10（几乎透明）到 100（不透明）。");
        ps.Add(op);

        ps.Add(PropSpec.Section(Designer.T("LAYOUT", "布局")));
        List<string> lmodeOpts = new List<string>{
            Designer.T("Flow (Flex)", "流式排版 (Flex)"),
            Designer.T("Free (Absolute / Dock)", "自由画布 (绝对定位 / 停靠)") };
        PropSpec lm = PropSpec.Enum("layoutMode", Designer.T("Layout mode", "排版模式"), lmodeOpts);
        lm.num = layoutMode;
        lm.tip = Designer.T(
            "Flow uses CSS Flexbox layout; Free uses WinForms-style absolute coordinates and Dock.",
            "流式采用弹性流式排版（自动流式流动）；自由画布采用 WinForms 风格的绝对定位坐标与 Dock 停靠。");
        ps.Add(lm);

        List<string> posOpts = new List<string>{
            Designer.T("Left", "左"), Designer.T("Right", "右"), Designer.T("Top", "上") };
        PropSpec lp = PropSpec.Enum("labelPos", Designer.T("Label position", "标签位置"), posOpts);
        lp.num = labelPos;
        lp.tip = Designer.T(
            "Where each field's label sits relative to its editor: Left, Right, or Top.",
            "每个字段的标签相对编辑器的位置：左、右或上。");
        ps.Add(lp);
        List<string> szOpts = new List<string>{
            Designer.T("Large", "大"), Designer.T("Default", "默认"), Designer.T("Small", "小") };
        PropSpec sz = PropSpec.Enum("size", Designer.T("Control size", "控件大小"), szOpts);
        sz.num = formSize;
        sz.tip = Designer.T(
            "Overall control density for the whole form: Large, Default, or Small.",
            "整个表单的控件密度：大、默认或小。");
        ps.Add(sz);
        PropSpec lw = PropSpec.Int("labelWidth", Designer.T("Label width", "标签宽度"));
        lw.num = labelWidth;
        lw.Step(5, 40, 400);
        lw.tip = Designer.T(
            "Fixed width (pixels) reserved for field labels when the label sits on the left.",
            "标签在左侧时为字段标签预留的固定宽度（像素）。");
        ps.Add(lw);
        PropSpec st = PropSpec.Bool("hideStar", Designer.T("Hide required star", "隐藏必填星号"));
        st.flag = hideStar;
        st.tip = Designer.T(
            "Hide the red asterisk that marks required fields.",
            "隐藏标记必填字段的红色星号。");
        ps.Add(st);
        return ps;
    }

    // 根 Window 的属性选项卡：属性行交给 PropertyGrid，
    // 这里只留「保存为组件」和自定义形状的只读提示。
    int RenderWindowProps(App app, Canvas c, Theme t, int ix, int iy, int iw) {
        if (sel != selPrev) { selPrev = sel; inspKeySeq = inspKeySeq + 1; }
        // 绑定键带上锁定状态：设备在自由/锁定之间切换时行集合
        // 会变（宽高行 ↔ 方向行），键变化强制重建编辑器。
        string bindKey = "win" + Convert.ToString(inspKeySeq);
        DeviceProfile bindDev = DeviceProfile.ById(device);
        if (bindDev != null && bindDev.Locked()) { bindKey = bindKey + "l"; }
        propGrid.Bind(bindKey, this.WindowSpecs());
        int gh = propGrid.ContentHeight(app);
        propGrid.RenderInside(app, new Rect(ix, iy, iw, gh));
        iy = iy + gh;
        if (gh > 0) {
            iy = iy + app.Scale(InspectorMetrics.GapStack);
        }
        // 每种尺寸保留自己的自由画布布局（断点矩形），所以宽高
        // 经由 ApplyDesignSize 处理，而不是仅仅调整窗口大小。
        ApplyDesignSize(winW, winH);
        // 目标设备/方向的差量应用：WindowSpecs 每帧把镜像下标
        // 同步成模型值，PropertyGrid 经绑定写回用户的新选择，
        // 这里与模型不一致即本帧发生了改动。
        if (devSelIdx != DeviceProfile.IndexOfId(device)) {
            this.ApplyDevice(DeviceProfile.At(devSelIdx));
        } else {
            DeviceProfile nowDev = DeviceProfile.ById(device);
            if (nowDev != null && nowDev.Rotatable()) {
                int curOrient = 0;
                if (winW > winH) { curOrient = 1; }
                if (devOrient != curOrient) {
                    this.ApplyDesignSize(nowDev.CanvasW(devOrient),
                                         nowDev.CanvasH(devOrient));
                    string orName = Designer.T("portrait", "竖屏");
                    if (devOrient == 1) { orName = Designer.T("landscape", "横屏"); }
                    msg = Designer.T("orientation: ", "方向：") + orName;
                }
            }
        }
        // 锁定类设备：画布尺寸只读说明（宽高行已收起）。
        DeviceProfile capDev = DeviceProfile.ById(device);
        if (capDev != null && capDev.Locked()) {
            Label dl = new Label(Designer.T("Canvas ", "画布 ")
                + Convert.ToString(winW) + " × " + Convert.ToString(winH)
                + Designer.T(" (locked by device)", "（由设备锁定）"));
            dl.Class = "tertiary small";
            dl.RenderInside(app, new Rect(ix, iy, iw, app.Scale(18)));
            iy = iy + app.Scale(18) + app.Scale(InspectorMetrics.GapStack);
        }
        // 手机/平板是重排型目标：自由画布把布局钉死在一个宽高比
        // 上，与"同一设计适配多种屏幕"冲突。非阻断提示，游戏等
        // 固定场景仍可继续用自由画布。
        if ((device == "phone" || device == "tablet") && layoutMode == 1) {
            Label wl = new Label(Designer.T(
                "Prefer flow layout (wrap/span) for multi-size targets.",
                "多尺寸目标建议流式布局（wrap/span）。"));
            wl.Class = "secondary small";
            wl.RenderInside(app, new Rect(ix, iy, iw, app.Scale(18)));
            iy = iy + app.Scale(18) + app.Scale(InspectorMetrics.GapStack);
        }

        if (winShape == 3) {
            Label sl = new Label(Designer.T("Union of regions (JSON)", "区域并集（JSON）"));
            sl.Class = "secondary small";
            sl.RenderInside(app, new Rect(ix, iy, iw, app.Scale(18)));
            iy = iy + app.Scale(18) + app.Scale(InspectorMetrics.GapMicro);
            Label sv = new Label(winShapeSpec);
            sv.Class = "tertiary small";
            sv.RenderInside(app, new Rect(ix, iy, iw, app.Scale(20)));
            iy = iy + app.Scale(20) + app.Scale(InspectorMetrics.GapStack);
        }

        // 把整个设计窗口保存为可复用的项目组件；
        // 宿主 IDE 会持久化它，之后它会出现在"我的组件"下。
        int scId = SmallBtn(app, Designer.T("Save as component", "保存为组件"), 1, ix, iy, iw);
        if (Ui.Clicked(app, scId)) {
            saveCompRequested = true;
            msg = Designer.T("saving as component…", "正在保存为组件…");
        }
        iy = iy + app.Scale(InspectorMetrics.RowHeight) + app.Scale(InspectorMetrics.GapSection);
        return iy;
    }

    // 应用目标设备画像选择（属性面板 device 行的差量落点）：
    // 锁定类设备把画布切到画像视口（允许横竖屏时保持当前
    // 方向）并关掉 resizable——移动端运行时窗口就是整块表面；
    // 桌面恢复自由尺寸（device 清空，即文档缺省）。
    void ApplyDevice(DeviceProfile dp) {
        if (dp == null) { return; }
        if (!dp.Locked()) {
            device = "";
            winResizable = true;
            // winRound 是画像自属状态（只有圆表盘画像置位）：切回
            // 桌面必须一并清掉，否则 watch→桌面会留下一个可拉伸的
            // 椭圆窗口。
            winRound = false;
            msg = Designer.T("target device: desktop (free size)",
                "目标设备：桌面（自由尺寸）");
            return;
        }
        device = dp.Id();
        int or2 = devOrient;
        if (!dp.Rotatable()) { or2 = 0; }
        this.ApplyDesignSize(dp.CanvasW(or2), dp.CanvasH(or2));
        winResizable = false;
        winRound = dp.Round();
        msg = Designer.T("target device: " + dp.Label("en"),
            "目标设备：" + dp.Label("zh"));
    }

    void SyncEventRows(bool root, FormField sel) {
        string targetId = root ? "win" : (sel.fname + "|" + Convert.ToString(sel.ftype) + "|" + Convert.ToString(sel.OptionCount()));
        if (eventEditRowsTarget == targetId && eventEditRows != null && eventEditRows.Count > 0) {
            return;
        }
        eventEditRowsTarget = targetId;
        eventEditRows = new List<EventEditRow>();
        if (root) {
            List<string> evs = Designer.WindowEventNames();
            for (int i = 0; i < evs.Count; i = i + 1) {
                string ev = evs[i];
                string cat = Designer.EventCategory(ev);
                string val = WinGetHandler(ev);
                string sug = "OnWindow" + ev;
                eventEditRows.Add(new EventEditRow("win:" + ev, ev, cat, val, sug, true, ev, 0 - 1));
            }
        } else {
            List<string> evs = sel.Events();
            for (int i = 0; i < evs.Count; i = i + 1) {
                string ev = evs[i];
                string cat = Designer.EventCategory(ev);
                string val = sel.GetHandler(ev);
                string sug = Designer.SuggestHandler(sel, ev);
                eventEditRows.Add(new EventEditRow("fld:" + ev, ev, cat, val, sug, false, ev, 0 - 1));
            }
            if (sel.ftype == 58 && sel.OptionCount() > 0) {
                for (int oi = 0; oi < sel.OptionCount(); oi = oi + 1) {
                    string raw = sel.OptionAt(oi);
                    if (raw == "-") { continue; }
                    string itmTitle = raw;
                    if (itmTitle.Length > 0 && (itmTitle[0] & 255) == 62) { itmTitle = itmTitle.Substring(1); }
                    int cp = itmTitle.IndexOf(":");
                    if (cp >= 0) { itmTitle = itmTitle.Substring(0, cp); }
                    if (itmTitle == "") { itmTitle = "Item" + Convert.ToString(oi + 1); }
                    string val = Designer.GetToolItemClick(sel, oi);
                    string baseName = sel.fname != "" ? sel.fname : "Tool";
                    string sug = "On" + Designer.CleanIdentifier(baseName)
                        + Designer.CleanIdentifier(itmTitle) + "Click";
                    eventEditRows.Add(new EventEditRow("tool:" + Convert.ToString(oi), itmTitle + ".Click", "Tool", val, sug, false, "", oi));
                }
            }
        }
    }

    // 事件选项卡：采用标准 IDE 规范的可编辑下拉框（EventComboBox）
    // 支持直接手打名称、下拉选择 code-behind 已有方法、双击生成/定位代码桩
    int RenderEventsTab(App app, Canvas c, Theme t, int ix, int iy, int iw) {
        int fs = Style.FontFallback(app, "small");
        bool root = (sel == null);
        this.SyncEventRows(root, sel);

        int rowH = app.Scale(InspectorMetrics.RowHeight);
        List<string> groups = Designer.EventGroups();
        EventEditRow activeDropdownRow = null;

        for (int gi = 0; gi < groups.Count; gi = gi + 1) {
            string grp = groups[gi];
            int cnt = 0;
            for (int k = 0; k < eventEditRows.Count; k = k + 1) {
                if (eventEditRows[k].category == grp) { cnt = cnt + 1; }
            }
            if (cnt == 0) { continue; }

            c.DrawText(ix, iy, Designer.GroupLabel(grp) + "  (" + Convert.ToString(cnt) + ")",
                Style.Part(app, "designer", "label", "", "", "", Style.SNormal()).FgOr(0), fs);
            iy = iy + app.Scale(InspectorMetrics.RowHeightCompact);

            for (int k = 0; k < eventEditRows.Count; k = k + 1) {
                EventEditRow er = eventEditRows[k];
                if (er.category != grp) { continue; }

                if (activeEventDropdown == er.key) {
                    activeDropdownRow = er;
                }

                bool rowHover = InRect(app.mouseX, app.mouseY, ix, iy, iw, rowH);
                if (rowHover) {
                    c.FillRoundRect(ix, iy, iw, rowH, app.Scale(3),
                        Style.Part(app, "designer", "toolbar", "", "", "", Style.SHover()).BgOr(0));
                }

                int labelW = app.Scale(96);
                if (labelW > iw * 38 / 100) { labelW = iw * 38 / 100; }
                if (labelW < app.Scale(60)) { labelW = app.Scale(60); }

                // 标题命中区（双击直接定位/生成事件代码，符合 VS 交互）
                app.hitTester.RegisterRect(er.labelHitId, ix, iy, labelW, rowH, 0);

                string fittedTitle = Ellipsis.Fit(er.title, labelW - app.Scale(4), fs);
                c.DrawText(ix + app.Scale(2), iy + app.Scale(6), fittedTitle,
                    Style.Part(app, "designer", "value", "", "", "", Style.SNormal()).FgOr(0), fs);

                int dropBtnW = app.Scale(InspectorMetrics.DropdownButtonWidth);
                int rightX = ix + labelW + app.Scale(4);
                int rightW = (ix + iw) - rightX;
                if (rightW < dropBtnW + app.Scale(40)) {
                    labelW = iw - dropBtnW - app.Scale(40) - app.Scale(4);
                    if (labelW < app.Scale(36)) { labelW = app.Scale(36); }
                    rightX = ix + labelW + app.Scale(4);
                    rightW = (ix + iw) - rightX;
                }
                int inpW = rightW - dropBtnW;
                if (inpW < app.Scale(24)) { inpW = app.Scale(24); }

                // 纯正 VS 组合框 ComboBox：输入框占据主要宽度，右侧无缝嵌入下拉箭头，严格防溢出遮挡
                er.input.Render(app, rightX, iy, inpW, rowH);

                // 监听手工键入变更
                string curTyped = er.input.GetText().Trim();
                if (curTyped != er.shadow) {
                    er.shadow = curTyped;
                    this.GateInspectorUndo("evt|" + er.key);
                    if (er.isRoot) { WinSetHandler(er.rawEv, curTyped); }
                    else if (er.toolIdx >= 0) { Designer.SetToolItemClick(sel, er.toolIdx, curTyped); }
                    else { sel.SetHandler(er.rawEv, curTyped); }
                    this.MarkDocDirty();
                    app.RequestRedraw();
                }

                // 下拉展开/收起按钮 [▾]（内嵌在输入框右侧边缘，融为一体式 ComboBox）
                int dropX = rightX + inpW;
                app.hitTester.RegisterRect(er.dropBtnId, dropX, iy, dropBtnW, rowH, 0);
                bool dropHover = InRect(app.mouseX, app.mouseY, dropX, iy, dropBtnW, rowH);
                int dropBg = (activeEventDropdown == er.key)
                    ? Style.Part(app, "designer", "panel", "", "", "", Style.SActive()).BgOr(0)
                    : (dropHover ? Style.Part(app, "designer", "field", "", "", "", Style.SHover()).BgOr(0)
                                 : Style.Part(app, "designer", "field", "", "", "", Style.SNormal()).BgOr(0));
                c.FillRoundRect(dropX, iy, dropBtnW, rowH, app.Scale(2), dropBg);
                c.DrawRoundRect(dropX, iy, dropBtnW, rowH, app.Scale(2),
                    Style.Part(app, "designer", "field", "", "", "", Style.SNormal()).BorderOr(0), 1);
                c.DrawGlyphIn("chevron-down", dropX, iy, dropBtnW, rowH, app.Scale(10),
                    Style.Part(app, "designer", "label", "", "", "", Style.SNormal()).FgOr(0));

                if (Ui.Clicked(app, er.dropBtnId)) {
                    if (activeEventDropdown == er.key) {
                        activeEventDropdown = "";
                    } else {
                        activeEventDropdown = er.key;
                        eventDropdownX = rightX;
                        eventDropdownY = iy + rowH + app.Scale(2);
                        eventDropdownW = rightW;
                    }
                    app.RequestRedraw();
                }

                // 双击事件行或双击输入框：直接前往/生成事件代码（对齐 VS 经典体验）
                bool triggerAct = Ui.DoubleClicked(app, er.labelHitId)
                    || Ui.DoubleClicked(app, er.input.WidgetId());
                if (triggerAct) {
                    this.BarrierInspectorUndo();
                    string target = er.input.GetText().Trim();
                    if (target == "") {
                        target = er.sug;
                        er.input.SetText(target);
                        er.shadow = target;
                        if (er.isRoot) { WinSetHandler(er.rawEv, target); }
                        else if (er.toolIdx >= 0) { Designer.SetToolItemClick(sel, er.toolIdx, target); }
                        else { sel.SetHandler(er.rawEv, target); }
                        this.MarkDocDirty();
                    }
                    this.RequestOpenCodeBehindHandler(target);
                }

                iy = iy + rowH + app.Scale(InspectorMetrics.GapInline);
            }
            iy = iy + app.Scale(InspectorMetrics.GapStack);
        }

        return iy + app.Scale(InspectorMetrics.GapSection);
    }

    // 绘制事件绑定可编辑下拉框的顶级弹出层（在检查器裁剪区外绘制，防边缘裁剪与遮挡）
    void RenderEventDropdownOverlay(App app, Canvas c, Theme t, int fs) {
        if (activeEventDropdown == "" || eventEditRows == null) { return; }
        EventEditRow aer = null;
        for (int k = 0; k < eventEditRows.Count; k = k + 1) {
            if (eventEditRows[k].key == activeEventDropdown) {
                aer = eventEditRows[k];
                break;
            }
        }
        if (aer == null) { return; }

        List<string> popItems = new List<string>();
        popItems.Add(Designer.T("(None / Clear)", "(无 / 清除事件)"));
        popItems.Add(aer.sug + " " + Designer.T("(Recommended)", "(推荐新建)"));
        if (candidateHandlers != null) {
            for (int ci = 0; ci < candidateHandlers.Count; ci = ci + 1) {
                string ch = candidateHandlers[ci];
                if (ch != aer.sug && !popItems.Contains(ch)) {
                    popItems.Add(ch);
                }
            }
        }

        int itemH = app.Scale(InspectorMetrics.RowHeight);
        int popPad = app.Scale(InspectorMetrics.PaddingCard);
        int popH = popItems.Count * itemH + popPad;
        int popX = eventDropdownX;
        int popY = eventDropdownY;
        int popW = eventDropdownW;
        if (popW < app.Scale(160)) { popW = app.Scale(160); }

        // 视口下边缘边界防护：超出屏幕底部则向上弹出
        if (app.canvas != null && popY + popH > app.canvas.Height() - app.Scale(20)) {
            popY = eventDropdownY - popH - app.Scale(InspectorMetrics.RowHeight);
        }

        // 浮层高阶卡片质感：阴影外框与实心背景
        c.FillRoundRect(popX - 2, popY - 2, popW + 4, popH + 4, app.Scale(5),
            Style.Part(app, "designer", "panel", "", "", "", Style.SNormal()).BorderOr(0));
        c.FillRoundRect(popX, popY, popW, popH, app.Scale(4),
            Style.Part(app, "designer", "panel", "", "", "", Style.SNormal()).BgOr(0));
        c.DrawRoundRect(popX, popY, popW, popH, app.Scale(4),
            Style.Part(app, "designer", "accent", "", "", "", Style.SNormal()).BgOr(0), 1);

        // 下拉要占住自己这块：先注册阻挡区（条目随后注册、盖过它），
        // 面板底下的属性行/画布就不会再收到落在下拉上的点击。
        app.BlockHitsRect(popX, popY, popW, popH);

        int py = popY + app.Scale(InspectorMetrics.GapInline);
        for (int pi = 0; pi < popItems.Count; pi = pi + 1) {
            string itText = popItems[pi];
            bool itHover = InRect(app.mouseX, app.mouseY, popX, py, popW, itemH);
            if (itHover) {
                c.FillRoundRect(popX + app.Scale(2), py, popW - app.Scale(4), itemH, app.Scale(3),
                    Style.Part(app, "designer", "toolbar", "", "", "", Style.SHover()).BgOr(0));
            }
            int itColor = (pi == 0)
                ? Style.Part(app, "designer", "hint", "", "", "", Style.SNormal()).FgOr(0)
                : (pi == 1 ? Style.Part(app, "designer", "accent", "", "success", "", Style.SNormal()).BgOr(0)
                           : Style.Part(app, "designer", "value", "", "", "", Style.SNormal()).FgOr(0));
            int textY = py + (itemH - fs) / 2;
            c.DrawText(popX + app.Scale(InspectorMetrics.GapStack), textY,
                Ellipsis.Fit(itText, popW - app.Scale(16), fs), itColor, fs);

            int popItemId = app.focus.AllocId();
            app.hitTester.RegisterRect(popItemId, popX, py, popW, itemH, 0);
            if (Ui.Clicked(app, popItemId)) {
                this.BarrierInspectorUndo();
                string chosen = (pi == 0) ? "" : (pi == 1 ? aer.sug : itText);
                aer.input.SetText(chosen);
                aer.shadow = chosen;
                if (aer.isRoot) { WinSetHandler(aer.rawEv, chosen); }
                else if (aer.toolIdx >= 0) { Designer.SetToolItemClick(sel, aer.toolIdx, chosen); }
                else { sel.SetHandler(aer.rawEv, chosen); }
                this.MarkDocDirty();
                activeEventDropdown = "";
                app.RequestRedraw();
            }
            py = py + itemH;
        }

        // 点击弹层外部收起
        if (app.pointerDown && !InRect(app.mouseX, app.mouseY, popX, popY, popW, popH)) {
            activeEventDropdown = "";
            app.RequestRedraw();
        }
    }

    // 根 Window 的可设计事件（生命周期/尺寸/焦点/键盘）。
    static List<string> WindowEventNames() {
        List<string> e = new List<string>{
            "Load", "Show", "Hide", "Closing", "Close",
            "Resize", "Move", "Minimize", "Maximize", "Restore",
            "Activate", "Deactivate",
            "KeyDown", "KeyUp" };
        return e;
    }

    // 根 Window 的事件 ev 已绑定的处理器名，没绑过为 ""。
    string WinGetHandler(string ev) {
        for (int i = 0; i < winEvents.Count; i = i + 1) {
            if (winEvents[i].key == ev) { return winEvents[i].val; }
        }
        return "";
    }

    // 设置根 Window 事件 ev 的处理器名；winEvents 里没有该键时追加。
    void WinSetHandler(string ev, string h) {
        for (int i = 0; i < winEvents.Count; i = i + 1) {
            if (winEvents[i].key == ev) { winEvents[i].val = h; return; }
        }
        winEvents.Add(new EventBinding(ev, h));
    }

    // 事件名的逻辑类别，事件选项卡据此把长列表
    // 分组到可读标题之下而不是溢出。
    static string EventCategory(string ev) {
        if (ev == "Click" || ev == "DoubleClick" || ev == "RightClick"
            || ev == "MouseDown" || ev == "MouseUp" || ev == "Enter"
            || ev == "Leave" || ev == "Move" || ev == "Wheel" || ev == "Tap"
            || ev == "LongPress" || ev == "Swipe" || ev == "Hover") { return "Pointer"; }
        if (ev == "KeyDown" || ev == "KeyUp" || ev == "KeyPress") { return "Keyboard"; }
        if (ev == "Focus" || ev == "Blur" || ev == "Activate"
            || ev == "Deactivate") { return "Focus"; }
        if (ev == "DragStart" || ev == "Drag" || ev == "DragEnd" || ev == "Drop"
            || ev == "DragEnter" || ev == "DragLeave") { return "Drag & Drop"; }
        if (ev == "Resize" || ev == "Show" || ev == "Hide" || ev == "Open"
            || ev == "Close" || ev == "Closing" || ev == "Load"
            || ev == "Minimize" || ev == "Maximize" || ev == "Restore") { return "Lifecycle"; }
        return "Value & Data";
    }

    // 事件类别标题的显示标签。类别键保持
    // 英文（按字符串相等匹配）；只有事件选项卡中
    // 显示的标题文本被翻译。
    static string GroupLabel(string grp) {
        if (grp == "Pointer") { return Designer.T("Pointer", "指针"); }
        if (grp == "Keyboard") { return Designer.T("Keyboard", "键盘"); }
        if (grp == "Focus") { return Designer.T("Focus", "焦点"); }
        if (grp == "Drag & Drop") { return Designer.T("Drag & Drop", "拖放"); }
        if (grp == "Lifecycle") { return Designer.T("Lifecycle", "生命周期"); }
        if (grp == "Value & Data") { return Designer.T("Value & Data", "值与数据"); }
        if (grp == "Tool") { return Designer.T("Tool Items Click", "工具条项点击"); }
        return grp;
    }

    // 事件选项卡的类别显示顺序。
    static List<string> EventGroups() {
        List<string> g = new List<string>{
            "Pointer", "Keyboard", "Focus",
            "Drag & Drop", "Lifecycle", "Value & Data", "Tool" };
        return g;
    }

    // 面板过滤器使用的区分大小写子串测试（它匹配
    // 小写类型键，因此小写查询即可）。
    static bool Contains(string hay, string needle) {
        if (needle.Length == 0) { return true; }
        if (hay.Length < needle.Length) { return false; }
        for (int i = 0; i + needle.Length <= hay.Length; i = i + 1) {
            if (hay.Substring(i, needle.Length) == needle) { return true; }
        }
        return false;
    }

    // --- 状态栏 ----

    // 渲染底部状态栏：组件总数、当前选中、活动容器（Tabs 带页号）、
    // 当前缩放（含「适应」）和最近一条提示消息。
    void RenderStatus(App app, Canvas c, Theme t, int x, int y, int w, int h) {
        int fs = Style.FontFallback(app, "small");
        string s = Convert.ToString(fields.Count) + Designer.T(" fields", " 个组件");
        if (sel != null) {
            s = s + Designer.T("   ·   selected: ", "   ·   已选中：") + FormField.TypeName(sel.ftype) + " '" + sel.fname + "'";
            if (freeExtra != null && freeExtra.Count > 0) {
                s = s + " (+" + Convert.ToString(freeExtra.Count) + ")";
            }
            s = s + " [" + Convert.ToString(sel.fx) + ", " + Convert.ToString(sel.fy) + "  " + Convert.ToString(sel.fw) + "×" + Convert.ToString(sel.fh) + "]";
        } else {
            s = s + Designer.T("   ·   window: ", "   ·   窗口：") + "[" + Convert.ToString(winW) + "×" + Convert.ToString(winH) + "]";
        }
        if (activeContainer != null) {
            s = s + Designer.T("   ·   adding into: ", "   ·   添加到：") + FormField.TypeName(activeContainer.ftype);
            if (activeContainer.kind == "Tabs") {
                s = s + Designer.T(" tab ", " 标签页 ") + Convert.ToString(activeContainer.uiState.Get() + 1);
            }
        }
        int zpm = winZoom;
        if (zpm <= 0) { zpm = lastFitPct; }
        string zt = Convert.ToString(zpm / 10) + "%";
        if (winZoom <= 0) { zt = Designer.T("fit ", "适应 ") + zt; }
        s = s + Designer.T("   ·   zoom: ", "   ·   缩放：") + zt;

        int ctrlW = app.Scale(342);
        int infoW = w - ctrlW - app.Scale(12);
        if (infoW < app.Scale(80)) { infoW = app.Scale(80); }
        int textH = Canvas.FontHeight(fs);
        int ty = y + (h - textH) / 2;
        c.PushClip(x, y, infoW, h);
        c.DrawText(x, ty, s + "     ·     " + msg,
            Style.Part(app, "designer", "hint", "", "", "", Style.SNormal()).FgOr(0), fs);
        c.PopClip();

        int bx = x + w - ctrlW;
        int btnH = app.theme.heightSmall;
        int by = y + (h - btnH) / 2;

        string uLbl = undoStack != null && undoStack.Count > 0 ? ("↶ (" + Convert.ToString(undoStack.Count) + ")") : "↶";
        string rLbl = redoStack != null && redoStack.Count > 0 ? ("↷ (" + Convert.ToString(redoStack.Count) + ")") : "↷";

        int undoW = app.Scale(48);
        int undoType = (undoStack != null && undoStack.Count > 0) ? 1 : 0;
        int undoBtn = SmallBtn(app, uLbl, undoType, bx, by, undoW);
        if (Ui.Clicked(app, undoBtn)) {
            if (undoStack != null && undoStack.Count > 0) {
                this.Undo();
                app.RequestRedraw();
            }
        }
        bx = bx + undoW + app.Scale(4);

        int redoW = app.Scale(48);
        int redoType = (redoStack != null && redoStack.Count > 0) ? 1 : 0;
        int redoBtn = SmallBtn(app, rLbl, redoType, bx, by, redoW);
        if (Ui.Clicked(app, redoBtn)) {
            if (redoStack != null && redoStack.Count > 0) {
                this.Redo();
                app.RequestRedraw();
            }
        }
        bx = bx + redoW + app.Scale(8);

        int btnW = app.Scale(26);
        int zmBtn = SmallBtn(app, "-", 0, bx, by, btnW);
        if (Ui.Clicked(app, zmBtn)) {
            int z = winZoom <= 0 ? lastFitPct : winZoom;
            z = z - 100;
            if (z < 250) { z = 250; }
            winZoom = z;
            app.RequestRedraw();
        }
        bx = bx + btnW + app.Scale(4);

        int pctW = app.Scale(58);
        int rstBtn = SmallBtn(app, zt, 0, bx, by, pctW);
        if (Ui.Clicked(app, rstBtn)) {
            winZoom = 1000;
            freePanX = 0;
            freePanY = 0;
            app.RequestRedraw();
        }
        bx = bx + pctW + app.Scale(4);

        int zpBtn = SmallBtn(app, "+", 0, bx, by, btnW);
        if (Ui.Clicked(app, zpBtn)) {
            int z = winZoom <= 0 ? lastFitPct : winZoom;
            z = z + 100;
            if (z > 2000) { z = 2000; }
            winZoom = z;
            app.RequestRedraw();
        }
        bx = bx + btnW + app.Scale(4);

        int fitW = app.Scale(46);
        int fitBtn = SmallBtn(app, Designer.T("Fit", "适应"), winZoom <= 0 ? 1 : 0, bx, by, fitW);
        if (Ui.Clicked(app, fitBtn)) {
            winZoom = 0;
            freePanX = 0;
            freePanY = 0;
            app.RequestRedraw();
        }
        bx = bx + fitW + app.Scale(6);

        int helpW = app.Scale(24);
        int helpBtn = SmallBtn(app, "?", keymapHelpOpen ? 1 : 0, bx, by, helpW);
        if (Ui.Clicked(app, helpBtn)) {
            keymapHelpOpen = !keymapHelpOpen;
            app.RequestRedraw();
        }
    }

    // --- 持久化（JSON）----

    // 把整个表单序列化为人类可编辑的 JSON 文档：表单
    // 配置加有序的 "fields" 数组。这是交换格式——
    // 手工编辑 JSON 再加载回去即可重新配置表单，
    // 设计器完全由数据驱动。与 LoadJson 往返兼容。
    // required,change,options:[...] } ] }
}
