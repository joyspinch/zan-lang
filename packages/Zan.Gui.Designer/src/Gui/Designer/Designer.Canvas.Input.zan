using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Gui.Backend;

namespace Gui.Designer;

partial class Designer {
    FormField canvasPressField;
    FormField canvasClickField;
    bool canvasSameClickField;

    bool HandleCanvasKey(App app, RoutedEventArgs e) {
        if (app == null || e == null || preview || this.BigEditorOpen() || this.CanvasInputLocked()
        || (e.eventName != "KeyDown" && e.eventName != "KeyUp" && e.eventName != "TextInput")) { return false; }
        if (e.eventName == "TextInput") {
            int cc = e.keyCode;
            if (cc == 1) { this.SelectAll(); app.RequestRedraw(); }
            else if (cc == 26) { this.Undo(); app.RequestRedraw(); }
            else if (cc == 25) { this.Redo(); app.RequestRedraw(); }
            else if (cc == 24 && sel != null) { this.CutSel(); app.RequestRedraw(); }
            else if (cc == 3) { this.CopySel(); app.RequestRedraw(); }
            else if (cc == 22) { this.PasteClip(); app.RequestRedraw(); }
            else if (cc == 4 && sel != null) { this.DuplicateSel(); app.RequestRedraw(); }
            else if (cc == 12 && sel != null) { this.ToggleLockSel(); app.RequestRedraw(); }
        } else if (e.eventName == "KeyDown") {
            int kc = e.keyCode;
            bool hasCtrl = Modifiers.HasCtrl(e.modifiers);
            bool hasShift = Modifiers.HasShift(e.modifiers);
            if (hasCtrl && (kc == 90 || kc == 122) && !hasShift) {
                this.Undo();
                app.RequestRedraw();
            } else if (hasCtrl && ((kc == 89 || kc == 121) || ((kc == 90 || kc == 122) && hasShift))) {
                this.Redo();
                app.RequestRedraw();
            } else if (hasCtrl && (kc == 65 || kc == 97)) {
                this.SelectAll();
                app.RequestRedraw();
            } else if (hasCtrl && (kc == 88 || kc == 120) && sel != null) {
                this.CutSel();
                app.RequestRedraw();
            } else if (hasCtrl && (kc == 67 || kc == 99)) {
                this.CopySel();
                app.RequestRedraw();
            } else if (hasCtrl && (kc == 86 || kc == 118)) {
                if (hasShift) {
                    this.DistributeSelGroup(1);
                } else {
                    this.PasteClip();
                }
                app.RequestRedraw();
            } else if (hasCtrl && hasShift && (kc == 72 || kc == 104)) {
                this.DistributeSelGroup(0);
                app.RequestRedraw();
            } else if (hasCtrl && (kc == 68 || kc == 100) && sel != null) {
                this.DuplicateSel();
                app.RequestRedraw();
            } else if (hasCtrl && (kc == 76 || kc == 108) && sel != null) {
                this.ToggleLockSel();
                app.RequestRedraw();
            } else if (hasCtrl && (kc == 73 || kc == 105)) {
                this.OpenQuickInsert(app);
                app.RequestRedraw();
            } else if (hasCtrl && (kc == 82 || kc == 114)) {
                showRulers = !showRulers;
                app.RequestRedraw();
            } else if (hasCtrl && (kc == 186 || kc == 59)) {
                showGuides = !showGuides;
                app.RequestRedraw();
            } else if (hasCtrl && (kc == 48 || kc == 96)) {
                winZoom = 1000;
                freePanX = 0;
                freePanY = 0;
                msg = Designer.T("zoom: 100%", "缩放: 100%");
                app.RequestRedraw();
            } else if (hasCtrl && (kc == 49 || kc == 97)) {
                winZoom = 0;
                freePanX = 0;
                freePanY = 0;
                msg = Designer.T("zoom: fit to window", "缩放: 适应窗口大小");
                app.RequestRedraw();
            } else if (hasCtrl && (kc == 187 || kc == 61)) {
                int curZ = winZoom;
                if (curZ <= 0) { curZ = lastFitPct; }
                curZ = curZ + 100;
                if (curZ > 2000) { curZ = 2000; }
                winZoom = curZ;
                msg = Designer.T("zoom: ", "缩放: ") + Convert.ToString(winZoom / 10) + "%";
                app.RequestRedraw();
            } else if (hasCtrl && (kc == 189 || kc == 45 || kc == 173)) {
                int curZ = winZoom;
                if (curZ <= 0) { curZ = lastFitPct; }
                curZ = curZ - 100;
                if (curZ < 250) { curZ = 250; }
                winZoom = curZ;
                msg = Designer.T("zoom: ", "缩放: ") + Convert.ToString(winZoom / 10) + "%";
                app.RequestRedraw();
            } else if (kc == 112) {
                keymapHelpOpen = !keymapHelpOpen;
                this.EnsureKeymapHelpWindow(app);
                app.RequestRedraw();
            } else if (kc == 191 && !hasCtrl) {
                keymapHelpOpen = !keymapHelpOpen;
                this.EnsureKeymapHelpWindow(app);
                app.RequestRedraw();
            } else if (hasCtrl && (kc == 71 || kc == 103)) {
                if (hasShift) { this.UngroupSel(); }
                else { this.GroupSel(); }
                app.RequestRedraw();
            } else if (kc == 32) {
                spacePressed = true;
                app.RequestRedraw();
            } else if (inlineRenaming && kc == 13) {
                this.CommitInlineRename();
            } else if (inlineRenaming && kc == 27) {
                this.CancelInlineRename();
            } else if (kc == 113 && sel != null) {
                this.StartInlineRename();
            } else if (kc == 27) {
                if (sel != null || (freeExtra != null && freeExtra.Count > 0)) {
                    sel = null;
                    this.ClearExtraSel();
                    app.RequestRedraw();
                }
            } else if ((kc == 46 || kc == 8) && sel != null) {
                DeleteSelGroup();
                app.RequestRedraw();
            } else if (kc == 33 && sel != null) {
                MoveSel(1);
                msg = Designer.T("moved forward", "上移一层");
                app.RequestRedraw();
            } else if (kc == 34 && sel != null) {
                MoveSel(0 - 1);
                msg = Designer.T("moved back", "下移一层");
                app.RequestRedraw();
            } else if (kc == 36 && Modifiers.HasCtrl(e.modifiers) && sel != null) {
                this.SelToEdge(1);
                msg = Designer.T("brought to front", "已置顶");
                app.RequestRedraw();
            } else if (kc == 35 && Modifiers.HasCtrl(e.modifiers) && sel != null) {
                this.SelToEdge(0);
                msg = Designer.T("sent to back", "已置底");
                app.RequestRedraw();
            } else if (sel != null && kc >= 37 && kc <= 40) {
                bool hasCtrlKey = Modifiers.HasCtrl(e.modifiers);
                if (hasCtrlKey) {
                    if (kc == 37 || kc == 38) {
                        this.MoveSel(0 - 1);
                        msg = Designer.T("reordered backward", "同级调序: 向前移动一位");
                    } else if (kc == 39 || kc == 40) {
                        this.MoveSel(1);
                        msg = Designer.T("reordered forward", "同级调序: 向后移动一位");
                    }
                    app.RequestRedraw();
                } else if (sel.position == 0) {
                    bool hasAlt = Modifiers.HasAlt(e.modifiers);
                    if (hasAlt) {
                        int step = 1;
                        if (Modifiers.HasShift(e.modifiers)) {
                            step = 8;
                            if (snapGrid && gridSize > 0) { step = gridSize; }
                        }
                        int dw = 0;
                        int dh = 0;
                        if (kc == 37) { dw = 0 - step; }
                        else if (kc == 39) { dw = step; }
                        else if (kc == 38) { dh = 0 - step; }
                        else if (kc == 40) { dh = step; }
                        this.ResizeSelByKey(dw, dh);
                    } else {
                        if (kc == 37 || kc == 38) {
                            this.MoveSel(0 - 1);
                            msg = Designer.T("flow reordered backward", "流式调序: 向前移动一位");
                        } else if (kc == 39 || kc == 40) {
                            this.MoveSel(1);
                            msg = Designer.T("flow reordered forward", "流式调序: 向后移动一位");
                        }
                    }
                    app.RequestRedraw();
                } else {
                    int step = 1;
                    if (Modifiers.HasShift(e.modifiers)) {
                        step = 8;
                        if (snapGrid && gridSize > 0) { step = gridSize; }
                    }
                    bool hasAlt = Modifiers.HasAlt(e.modifiers);
                    if (hasAlt) {
                        int dw = 0;
                        int dh = 0;
                        if (kc == 37) { dw = 0 - step; }
                        else if (kc == 39) { dw = step; }
                        else if (kc == 38) { dh = 0 - step; }
                        else if (kc == 40) { dh = step; }
                        this.ResizeSelByKey(dw, dh);
                    } else {
                        int ndx = 0;
                        int ndy = 0;
                        if (kc == 37) { ndx = 0 - step; }
                        else if (kc == 39) { ndx = step; }
                        else if (kc == 38) { ndy = 0 - step; }
                        else if (kc == 40) { ndy = step; }
                        this.NudgeSel(ndx, ndy);
                    }
                    app.RequestRedraw();
                }
                app.RequestRedraw();
            }
        } else if (e.eventName == "KeyUp") {
            int kc = e.keyCode;
            if (kc == 32) {
                spacePressed = false;
                app.RequestRedraw();
            }
        }
        e.Handle();
        return true;
    }

    bool CanvasInputLocked() {
        App app = this.hostApp;
        return this.BigEditorOpen() || inlineRenaming || canvasMenuOpen || quickInsertOpen || keymapHelpOpen
        || zoomMenuOpen || dpiMenuOpen || ribbonMenuOpen || activeEventDropdown != ""
        || (app != null && app.HasOverlays());
    }

    public void InitializeCanvasInput(App app) {
        if (app == null || canvasInput != null) { return; }
        hostApp = app;
        canvasInput = new DesignerCanvasInput(); canvasInput.owner = this;
        canvasView = new UiViewScope(app, this, canvasInput);
        UiViewActions action = canvasView.Action("canvas", canvasInput);
        canvasInput.OnRouted(action.Pointer);
        canvasInputHost = new ControlInputHost(canvasInput);
    }

    // Keep the preparation registration alive while hidden, but retire the input subtree.
    public void SuspendCanvasInput() {
        canvasHostRect = null;
        if (canvasInput != null) { canvasInput.ready = false; }
        if (canvasInputHost != null) { canvasInputHost.Hide(); }
        this.CancelCanvasGesture();
    }

    // The host supplies its current region during preparation, before hit testing.
    public void PrepareCanvasInput(App app, Rect region) {
        if (app == null || region == null || region.width <= 0 || region.height <= 0) {
            this.RetireCanvasInput(); return;
        }
        App prevApp = this.hostApp;
        if (canvasView != null && (prevApp != app || !canvasView.IsActive())) { this.RetireCanvasInput(); }
        hostApp = app;
        canvasHostRect = region;
        this.InitializeCanvasInput(app);
        if (canvasInputHost != null) { canvasInputHost.Bind(app); }
        if (designerSurfaceHost != null) { designerSurfaceHost.Bind(app); }
        if (designerSurface != null) { designerSurface.Arrange(region.x, region.y, region.width, region.height); }
        this.PrepareView(canvasView, app);
    }

    public void RetireCanvasInput() {
        DesignerCanvasInput old = canvasInput;
        UiViewScope view = canvasView;
        ControlInputHost input = canvasInputHost;
        canvasInput = null; canvasView = null; canvasInputHost = null; canvasHostRect = null;
        if (old != null) { old.ready = false; old.owner = null; }
        if (view != null) { view.Retire(); }
        if (input != null) { input.Hide(); }
        if (designerSurfaceHost != null) { designerSurfaceHost.Hide(); }
        this.CancelCanvasGesture();
    }

    public void PrepareView(UiViewScope view, App app) {
        if (this.PrepareInspectorView(view, app)) { return; }
        if (app == null || view != canvasView || canvasInput == null || canvasHostRect == null) { return; }
        DesignerCanvasInput preparing = canvasInput;
        this.SyncEditorWindowState();
        // 模态弹层每帧绘制遮罩时会把焦点重写到遮罩 id 上
        //（App.BlockHitsBelow），快捷插入输入框的键盘焦点帧尾即被夺走。
        // prepare 相每帧重申，输入相的按键（方向键/回车/文本）才能路由回
        // 输入框；与画布指针按下路径对 canvasInput 的 SetFocused 同一先例。
        if (app.focus != null && quickInsertOpen
        && quickInsertWin != null && quickInsertWin.open && quickInsertInput != null) {
            app.focus.SetFocused(quickInsertInput.WidgetId(), quickInsertInput);
        }
        canvasInput.ready = false;
        if (jsonOpen || this.CanvasInputLocked()) {
            app.CancelInputSubtree(canvasInput);
            return;
        }
        Rect region = this.CanvasRegion(app, canvasHostRect);
        if (region.width <= 0 || region.height <= 0 || !this.PrepareDesignPreview(app)
        || !this.PreviewHasLayout()) { return; }
        if (canvasInput != preparing || canvasView != view || !view.IsActive()) { return; }
        this.UpdateCanvasGeometry(app, region.x, region.y, region.width, region.height, canvasInput);
        if (!view.Layout(region.x, region.y, region.width, region.height)) { return; }
        this.RegisterDesignTabs(canvasInput.ox, canvasInput.oy, canvasInput.ps);
        canvasInput.ready = true;
    }

    public void ViewAction(string name, Control sender) {
        if (this.InspectorAction(name, sender)) { return; }
    }

    public void ViewPointer(Control sender, RoutedEventArgs e) {
        if (this.InspectorPointer(sender, e)) { return; }
        DesignerCanvasInput input = canvasInput;
        App app = hostApp;
        if (input == null || app == null || e == null || sender != input) { return; }
        if (e.eventName == "PointerCancel") { this.CancelCanvasGesture(); return; }
        if (!input.ready || this.CanvasInputLocked()) { return; }
        if (this.HandleCanvasKey(app, e)) { return; }
        if (!freeHand && !spacePressed && this.HandleCanvasGuideInput(app, e, input)) { return; }
        if (e.eventName == "Click") {
            if (!canvasClickBlocked && canvasSameClickField && !preview && !freeHand
            && !spacePressed && e.isDoubleClick) {
                FormField hit = this.DesignPickView(e.x, e.y, input.ox, input.oy, input.ps);
                if (hit != null && hit == canvasClickField && this.DesignVisible(hit)) {
                    sel = hit;
                    if (sel.compRef) {
                        openCompName = sel.customKind; openCompRequested = true;
                        msg = Designer.T("opening component ", "打开组件 ") + sel.customKind;
                    } else if (Modifiers.HasCtrl(e.modifiers)) {
                        if (Designer.CanNavigateCodeBehind(sel)) {
                            string ev = Designer.DefaultEventName(sel);
                            string handler = sel.GetHandler(ev);
                            if (handler == "") {
                                this.PushUndo();
                                handler = Designer.SuggestHandler(sel, ev); sel.SetHandler(ev, handler);
                                this.MarkDocDirty();
                            }
                            this.RequestOpenCodeBehindHandler(handler);
                        }
                    } else if (Designer.HasDisplayText(sel)) { this.StartInlineRename(); }
                    app.RequestRedraw();
                }
            }
            e.Handle(); return;
        }
        bool pointerEvent = e.eventName == "PointerDown" || e.eventName == "PointerMove"
        || e.eventName == "PointerUp" || e.eventName == "Wheel";
        bool keyEvent = e.eventName == "KeyDown" || e.eventName == "KeyUp" || e.eventName == "TextInput";
        if (preview && (pointerEvent || keyEvent) && !freeHand && !spacePressed && !freePanning
        && !(e.eventName == "Wheel" && Modifiers.HasCtrl(e.modifiers))
        && (app.window == null || app.window.EventButton() != 2)) {
            bool inside = this.InRect(e.x, e.y, input.ox, input.oy, input.viewW, input.viewH);
            this.ProcessDesignPreviewInput(app, this.DesignPointerPx(e.x, input.ox, input.ps),
            this.DesignPointerPx(e.y, input.oy, input.ps), inside);
            if (canvasInput != input) { return; }
            if (e.eventName == "PointerDown") { app.CapturePointer(input, true); }
            if (e.eventName == "PointerUp" && app.GetCapturedPointer() == input) { app.ReleasePointerCapture(); }
            e.Handle(); return;
        }
        if (e.eventName == "Wheel") {
            Canvas pvCanvas = (pvDocForm != null && pvDocForm.GetApp() != null) ? pvDocForm.GetApp().canvas : null;
            if (pvCanvas != null) {
                canvasInputDispatch = true;
                try {
                    this.HandleCanvasZoom(app, false, input.inX, input.inY, input.inW, input.inH,
                    input.ox, input.oy, pvCanvas);
                } finally { canvasInputDispatch = false; }
            }
            e.Handle(); return;
        }
        int kind = 0;
        if (e.eventName == "PointerDown") { kind = 2; }
        else if (e.eventName == "PointerMove") { kind = 1; }
        else if (e.eventName == "PointerUp") { kind = 3; }
        else { return; }
        canvasInputDispatch = true;
        try {
            bool free = layoutMode == 1;
            if (kind == 2) {
                canvasClickBlocked = false;
                canvasPressField = this.DesignPickView(e.x, e.y, input.ox, input.oy, input.ps);
                this.HandleCanvasMiddlePan(app, false, kind, input.inX, input.inY, input.inW, input.inH);
                bool hand = this.HandleCanvasHandMode(app, false, kind, input.inX, input.inY, input.inW, input.inH);
                this.HandleCanvasContextMenu(app, false, hand, kind, input.inX, input.inY, input.inW, input.inH,
                input.ox, input.oy, input.ps, input.viewW, input.viewH);
                if (this.CanvasInputLocked()) { return; }
                this.HandleCanvasPointerDown(app, false, hand, free, kind, input.inX, input.inY, input.inW, input.inH,
                input.ox, input.oy, input.ps, input.viewW, input.viewH);
                if (freeDragging || freeResizing || freeMarquee || freePanning || dragging) {
                    app.CapturePointer(e.originalSource, true);
                }
            }
            if (kind == 1) {
                if (dragging) {
                    if (app.mouseX != dragMouseX || app.mouseY != dragMouseY) { dragMoved = true; }
                    dragMouseX = app.mouseX; dragMouseY = app.mouseY;
                }
                if (freePanning) {
                    freePanX = freePanOX - (e.x - freePanSX); freePanY = freePanOY - (e.y - freePanSY);
                }
                this.HandleCanvasDragMove(app, free, kind, input.ox, input.oy, input.ps);
                this.HandleCanvasResizeMove(app, free, kind, input.ox, input.oy, input.ps);
            }
            if (kind == 3) {
                FormField released = this.DesignPickView(e.x, e.y, input.ox, input.oy, input.ps);
                canvasClickBlocked = canvasPressField != released || freeDragHasMoved || designResizeMoved
                || dragMoved || freePanning || freeResizing || freeMarquee || dragFromPalette;
                canvasSameClickField = canvasClickField == released;
                canvasClickField = canvasClickBlocked ? null : released;
                canvasPressField = null;
                Rect region = canvasHostRect != null ? this.CanvasRegion(app, canvasHostRect) : null;
                if (region != null && dragging && dragFromPalette && FormField.IsNonVisualOf(dragKind)
                && this.InRect(e.x, e.y, region.x, region.y + region.height + app.Scale(8), region.width, app.Scale(46))) {
                    activeContainer = null; this.AddField(dragKind); palClickPending = false;
                    dragging = false; dragFromPalette = false; dragMoved = false; dropContainer = null;
                } else {
                    this.HandleCanvasDropTarget(app, null, app.theme, false, free, kind,
                    input.inX, input.inY, input.inW, input.inH, input.ox, input.oy, input.ps,
                    winW, input.viewW, input.viewH);
                }
                this.HandleCanvasMarquee(app, null, kind, input.ox, input.oy, input.ps);
                this.HandleCanvasPointerUp(app, false, input.inX, input.inY, input.inW, input.inH);
                this.FinishCanvasFlowDrag(app);
                Control captured = app.GetCapturedPointer();
                if (captured != null && input.ContainsHostedControl(captured)) { app.ReleasePointerCapture(); }
            }
            app.RequestRedraw();
            // Ordinary Up continues into the App's committed Click synthesis.
            if (kind != 3 || canvasClickBlocked) { e.Handle(); }
        } finally { canvasInputDispatch = false; }
    }

    Rect CanvasRegion(App app, Rect host) {
        if (app == null || host == null) { return new Rect(0, 0, 0, 0); }
        int pad = app.Scale(12);
        int avail = host.width - pad * 5;
        if (avail < app.Scale(80)) { avail = app.Scale(80); }
        int palW = app.Scale(176); int inspW = app.Scale(288);
        if (hostPanels) { palW = 0; inspW = 0; avail = host.width - pad * 2; }
        int minCan = app.Scale(220);
        if (!hostPanels && palW + inspW + minCan > avail) {
            int side = avail - minCan;
            if (side < 0) { side = 0; }
            int sum = palW + inspW;
            if (sum > 0) { palW = side * palW / sum; }
            inspW = side - palW;
            if (palW < app.Scale(130)) { inspW = inspW + palW; palW = 0; }
            if (inspW < app.Scale(190)) { palW = palW + inspW; inspW = 0; }
            if (palW > 0 && palW < app.Scale(130)) { palW = 0; }
        }
        int width = avail - palW - inspW;
        if (width < app.Scale(80)) { width = app.Scale(80); }
        int left = host.x + pad + pad;
        if (palW > 0) { left = host.x + pad + palW + pad; }
        if (hostPanels) { left = host.x + pad; }
        int top = host.y + app.Scale(6) + this.RibbonH(app) + app.Scale(6);
        int bottom = host.y + host.height - app.Scale(32) - app.Scale(4);
        int regH = bottom - top - app.Scale(46) - app.Scale(8);
        if (regH < 0) { regH = 0; }
        return new Rect(left, top, width, regH);
    }

    void CancelCanvasGesture() {
        canvasPressField = null; canvasClickField = null; canvasSameClickField = false;
        canvasClickBlocked = true;
        draggingGuideAxis = -1; draggingGuideIdx = -1;
        freeDragging = false; freeDragHasMoved = false; freeResizing = false; designResizeMoved = false;
        freePanning = false; freeMarquee = false; dragging = false; dragMoved = false; dragFromPalette = false;
        multiResizeStarts = null; designMoves = null; freeGuideX = -1; freeGuideY = -1;
    }

    void FinishCanvasFlowDrag(App app) {
        if (!dragging) { return; }
        if (dragFromPalette && !dragMoved) { this.PalClickRelease(); }
        palClickPending = false; dragging = false; dragFromPalette = false; dragMoved = false;
        dragIndex = -1; dragUserComp = -1; dropContainer = null;
        if (app != null) { app.RequestRedraw(); }
    }
    void UpdateCanvasGeometry(App app, int cx, int cy, int cw, int ch, DesignerCanvasInput input) {
        if (app == null || input == null || pvDocForm == null || pvDocForm.GetApp() == null) { return; }
        Canvas source = pvDocForm.GetApp().canvas;
        if (source == null) { return; }
        int srcW = source.Width();
        int srcH = source.Height();
        if (srcW < 1) { srcW = 1; }
        if (srcH < 1) { srcH = 1; }

        int inX = cx + app.Scale(12);
        int inY = cy + app.Scale(10);
        int inW = cw - app.Scale(24);
        int inH = ch - app.Scale(20);
        if (inW < 20) { inW = 20; }
        if (inH < 20) { inH = 20; }

        int psMilli;
        int effZoom = winZoom;
        if (effZoom <= 0) {
            int fitX = inW * 1000 / srcW;
            int fitY = inH * 1000 / srcH;
            effZoom = fitX;
            if (fitY < effZoom) { effZoom = fitY; }
            if (effZoom > 1000) { effZoom = 1000; }
        }
        if (effZoom < 250) { effZoom = 250; }
        if (effZoom > 2000) { effZoom = 2000; }
        lastFitPct = effZoom;
        psMilli = effZoom * this.DesignDpi() / 100;
        if (psMilli < 1) { psMilli = 1; }
        int cw2 = this.DesignViewPx(srcW, psMilli);
        int ch2 = this.DesignViewPx(srcH, psMilli);

        int panMaxX = (cw2 - inW) / 2 + inW / 2;
        int panMaxY = (ch2 - inH) / 2 + inH / 2;
        if (panMaxX < inW / 2) { panMaxX = inW / 2; }
        if (panMaxY < inH / 2) { panMaxY = inH / 2; }
        if (freePanX > panMaxX) { freePanX = panMaxX; }
        if (freePanX < 0 - panMaxX) { freePanX = 0 - panMaxX; }
        if (freePanY > panMaxY) { freePanY = panMaxY; }
        if (freePanY < 0 - panMaxY) { freePanY = 0 - panMaxY; }
        int ox = inX + (inW - cw2) / 2 - freePanX;
        int oy = inY + (inH - ch2) / 2 - freePanY;

        input.inX = inX; input.inY = inY; input.inW = inW; input.inH = inH;
        input.ox = ox; input.oy = oy; input.ps = psMilli; input.viewW = cw2; input.viewH = ch2;
    }

}
