using System;
using Gui.Widget;
using Gui;
using System.Json;

namespace Gui.Designer;

partial class Designer {
    Panel inspectorCardsRoot;
    Label inspectorCardsBatchTitle;
    List<DesignerInspectorCardAction> inspectorCardsActions;
    List<FormField> inspectorCardsSelection;
    weak App inspectorCardsApp;
    weak UiViewScope inspectorCardsScope;
    weak FormField inspectorCardsTarget;
    weak Control inspectorCardsHost;
    int inspectorCardsGeneration;
    int inspectorCardsKeySequence;
    int inspectorCardsCategory;
    int inspectorCardsType;
    string inspectorCardsKind;

    // Called by the Inspector's existing preparation phase, before Measure/Arrange.
    // A stable target/selection/category keeps the actual buttons and subscriptions.
    public void PrepareInspectorCards(App app, FormField field, Control host) {
        UiViewScope scope = inspectorView;
        if (app == null || field == null || host == null || field != sel || inspTab != 0
                || scope == null || !scope.IsActive() || inspectorApp != app) {
            this.RetireInspectorCards(); return;
        }
        bool current = inspectorCardsRoot != null && inspectorCardsApp == app && inspectorCardsScope == scope
            && inspectorCardsTarget == field && inspectorCardsHost == host
            && inspectorCardsKeySequence == inspKeySeq && inspectorCardsCategory == inspCategory
            && inspectorCardsType == field.ftype && inspectorCardsKind == field.kind
            && this.InspectorCardsSelectionMatches();
        if (!current) {
            int generation = inspectorCardsGeneration + 1;
            this.RetireInspectorCards();
            // Removing a focused/captured old subtree can call application code.
            if (inspectorCardsGeneration != generation || inspectorCardsRoot != null
                    || inspectorView != scope || !scope.IsActive() || inspectorApp != app
                    || field != sel || inspTab != 0) { return; }
            inspectorCardsApp = app; inspectorCardsScope = scope; inspectorCardsTarget = field;
            inspectorCardsHost = host; inspectorCardsKeySequence = inspKeySeq;
            inspectorCardsCategory = inspCategory; inspectorCardsType = field.ftype; inspectorCardsKind = field.kind;
            inspectorCardsSelection = new List<FormField>();
            if (freeExtra != null) {
                for (int i = 0; i < freeExtra.Count; i = i + 1) { inspectorCardsSelection.Add(freeExtra[i]); }
            }
            inspectorCardsActions = new List<DesignerInspectorCardAction>();
            inspectorCardsRoot = Panel.Column();
            inspectorCardsRoot.name = "inspector-cards";
            inspectorCardsRoot.SetProp("style", "flex:0 0 auto;min-width:0;padding:0;gap:var(--gap-medium);");
            this.BuildInspectorCards(field);
        }
        this.SyncInspectorCards(field);
        Panel root = inspectorCardsRoot;
        if (root != null && root.parent != host) { host.Add(root); }
    }

    public void RetireInspectorCards() {
        Panel previous = inspectorCardsRoot;
        inspectorCardsGeneration = inspectorCardsGeneration + 1;
        inspectorCardsRoot = null; inspectorCardsBatchTitle = null; inspectorCardsActions = null;
        inspectorCardsSelection = null; inspectorCardsTarget = null; inspectorCardsHost = null;
        inspectorCardsScope = null; inspectorCardsApp = null; inspectorCardsKind = "";
        // Invalidate actions before releasing input; cancellation may reenter preparation.
        if (previous != null && previous.parent != null) { previous.parent.Remove(previous); }
    }

    bool InspectorCardsSelectionMatches() {
        if (inspectorCardsSelection == null) { return false; }
        int count = freeExtra == null ? 0 : freeExtra.Count;
        if (inspectorCardsSelection.Count != count) { return false; }
        for (int i = 0; i < count; i = i + 1) {
            if (inspectorCardsSelection[i] != freeExtra[i]) { return false; }
        }
        return true;
    }

    Panel InspectorCardsPanel(string name) {
        Panel panel = new Panel("designer-inspector-card"); panel.name = name;
        panel.SetProp("style", "display:flex;flex-direction:column;flex:0 0 auto;min-width:0;padding:var(--padding-small);gap:var(--gap-medium);background:var(--bg-secondary);border:1px solid var(--border-secondary);border-radius:var(--radius-small);");
        inspectorCardsRoot.Add(panel); return panel;
    }

    Flex InspectorCardsRow(Control parent) {
        Flex row = Flex.Row();
        row.SetProp("style", "flex:0 0 auto;min-width:0;gap:var(--gap-small);align-items:center;");
        parent.Add(row); return row;
    }

    Label InspectorCardsLabel(Control parent, string text) {
        Label label = new Label(text); label.Class = "tertiary tiny";
        label.SetProp("style", "flex-shrink:0;"); parent.Add(label); return label;
    }

    Button InspectorCardsButton(Control parent, string text, string command, int value) {
        Button button = new Button(text); button.Class = "secondary small";
        button.name = "inspector-card-" + command + "-" + Convert.ToString(value);
        button.SetProp("style", "flex:1;min-width:0;");
        DesignerInspectorCardAction action = new DesignerInspectorCardAction();
        action.owner = this; action.view = inspectorCardsScope; action.target = inspectorCardsTarget;
        action.sender = button; action.generation = inspectorCardsGeneration;
        action.keySequence = inspectorCardsKeySequence; action.command = command; action.value = value;
        inspectorCardsActions.Add(action); button.OnClick(action.Run); parent.Add(button); return button;
    }

    void InspectorCardsPresets(Control parent, string label, string command, List<int> values) {
        Flex row = this.InspectorCardsRow(parent);
        Label caption = this.InspectorCardsLabel(row, label);
        caption.SetProp("style", label.Length <= 2 ? "flex:0 0 auto;width:24px;" : "flex:0 0 auto;width:44px;");
        for (int i = 0; i < values.Count; i = i + 1) {
            int value = values[i];
            this.InspectorCardsButton(row, Convert.ToString(value), command, value);
        }
    }

    void BuildInspectorCards(FormField field) {
        bool batch = inspectorCardsSelection.Count > 0;
        if (batch) {
            Panel card = this.InspectorCardsPanel("inspector-card-batch");
            inspectorCardsBatchTitle = this.InspectorCardsLabel(card, ""); inspectorCardsBatchTitle.Class = "secondary small";
            this.InspectorCardsLabel(card, Designer.T("Size/Margin/Position changes sync to all selected", "修改尺寸、内外边距与定位将自动同步"));
            Flex row = this.InspectorCardsRow(card);
            this.InspectorCardsButton(row, Designer.T("Lock", "锁定"), "batch-lock", 0);
            this.InspectorCardsButton(row, Designer.T("Fill H", "撑满高"), "batch-fill-height", 0);
            this.InspectorCardsButton(row, "", "batch-position", 0);
            this.InspectorCardsPresets(card, "Mg (px)", "batch-margin", new List<int>{ 0, 4, 8, 12, 16 });
            this.InspectorCardsPresets(card, "Pad (px)", "batch-padding", new List<int>{ 0, 8, 12, 16, 24 });
            return;
        }
        if (inspCategory == 0 || inspCategory == 2) {
            Panel card = this.InspectorCardsPanel("inspector-card-layout");
            bool status = field.ftype == 59 || field.kind == "StatusBar";
            bool tools = field.ftype == 58 || field.kind == "ToolStrip";
            if (status) {
                this.InspectorCardsLabel(card, Designer.T("Fixed to Bottom (Dock.Bottom)", "固底状态栏 (固定贴紧窗口底部)"));
                Flex row = this.InspectorCardsRow(card);
                this.InspectorCardsButton(row, "24px (紧凑)", "status-height", 24);
                this.InspectorCardsButton(row, "28px (标准)", "status-height", 28);
                this.InspectorCardsButton(row, "32px (宽条)", "status-height", 32);
            } else if (tools) {
                Flex dock = this.InspectorCardsRow(card);
                this.InspectorCardsButton(dock, Designer.T("Top (Default)", "顶部停靠 (Top)"), "tools-dock", 1);
                this.InspectorCardsButton(dock, Designer.T("Bottom", "底部停靠 (Bottom)"), "tools-dock", 2);
                Flex heights = this.InspectorCardsRow(card);
                this.InspectorCardsButton(heights, "28px (紧凑)", "tools-height", 28);
                this.InspectorCardsButton(heights, "32px (标准)", "tools-height", 32);
                this.InspectorCardsButton(heights, "40px (大栏)", "tools-height", 40);
            } else {
                Flex modes = this.InspectorCardsRow(card);
                this.InspectorCardsButton(modes, Designer.T("Fill H", "撑满高"), "fill-height", 0);
                this.InspectorCardsButton(modes, Designer.T("0 Auto H", "0 自适应"), "auto-height", 0);
                this.InspectorCardsButton(modes, "", "position", 0);
                Flex top = this.InspectorCardsRow(card);
                this.InspectorCardsButton(top, "Top (顶)", "dock", 1);
                this.InspectorCardsButton(top, "Fill (铺满)", "dock", 5);
                this.InspectorCardsButton(top, "Bottom (底)", "dock", 2);
                Flex bottom = this.InspectorCardsRow(card);
                this.InspectorCardsButton(bottom, "Left (左)", "dock", 3);
                this.InspectorCardsButton(bottom, "None (无)", "dock", 0);
                this.InspectorCardsButton(bottom, "Right (右)", "dock", 4);
            }
            if (FormField.IsContainerOf(field.ftype)) {
                Panel container = this.InspectorCardsPanel("inspector-card-container");
                Flex direction = this.InspectorCardsRow(container);
                this.InspectorCardsButton(direction, Designer.T("Column", "纵向 (Col)"), "direction", 0);
                this.InspectorCardsButton(direction, Designer.T("Row", "横向 (Row)"), "direction", 1);
                this.InspectorCardsPresets(container, "Gap:", "gap", new List<int>{ 0, 4, 8, 12, 16 });
                this.InspectorCardsPresets(container, "Pad:", "container-padding", new List<int>{ 0, 8, 12, 16, 24 });
            }
        }
        if (!FormField.IsNonVisualOf(field.ftype) && inspCategory == 2) {
            Panel sizes = this.InspectorCardsPanel("inspector-card-size");
            Flex first = this.InspectorCardsRow(sizes);
            Flex width = Flex.Column(); width.SetProp("style", "flex:1;min-width:0;"); first.Add(width);
            Flex height = Flex.Column(); height.SetProp("style", "flex:1;min-width:0;"); first.Add(height);
            this.InspectorCardsPresets(width, "W", "width", new List<int>{ 0, 80, 160, 240 });
            this.InspectorCardsPresets(height, "H", "height", new List<int>{ 0, 24, 32, 40 });
            Flex second = this.InspectorCardsRow(sizes);
            Flex margin = Flex.Column(); margin.SetProp("style", "flex:1;min-width:0;"); second.Add(margin);
            Flex padding = Flex.Column(); padding.SetProp("style", "flex:1;min-width:0;"); second.Add(padding);
            this.InspectorCardsPresets(margin, "Mg", "margin", new List<int>{ 0, 4, 8, 16 });
            this.InspectorCardsPresets(padding, "Pd", "padding", new List<int>{ 0, 4, 8, 16 });
        }
    }

    void SyncInspectorCards(FormField field) {
        if (inspectorCardsBatchTitle != null) {
            int total = inspectorCardsSelection.Count + 1;
            inspectorCardsBatchTitle.SetProp("text", Designer.T("Batch Editing (" + Convert.ToString(total) + " items)",
                "多选批量编辑 (共 " + Convert.ToString(total) + " 项)"));
        }
        for (int i = 0; i < inspectorCardsActions.Count; i = i + 1) {
            DesignerInspectorCardAction action = inspectorCardsActions[i]; Button button = action.sender;
            if (button == null) { continue; }
            string command = action.command; int value = action.value; bool selected = false;
            if (command == "batch-position") {
                button.SetProp("text", field.position == 1 ? Designer.T("Flow", "转流式") : Designer.T("Float", "转浮动"));
            } else if (command == "position") {
                button.SetProp("text", field.position == 1 ? Designer.T("To Flow", "转流式") : Designer.T("To Float", "转浮动"));
                selected = field.position == 1;
            } else if (command == "fill-height") { selected = field.position == 0 && field.flexGrow > 0 && field.fh == 0; }
            else if (command == "auto-height") { selected = field.position == 0 && field.flexGrow == 0 && field.fh == 0; }
            else if (command == "status-height") { selected = field.fh == value || (field.fh <= 0 && value == 28); }
            else if (command == "tools-height") { selected = field.fh == value || (field.fh <= 0 && value == 32); }
            else if (command == "tools-dock") { selected = value == 2 ? field.dockSide == 2 : field.dockSide != 2; }
            else if (command == "dock") { selected = field.dockSide == value; }
            else if (command == "direction") { selected = field.flexDir == value; }
            else if (command == "gap") { selected = field.gap == value; }
            else if (command == "container-padding" || command == "padding") { selected = field.padding == value; }
            else if (command == "width") { selected = field.fw == value; }
            else if (command == "height") { selected = field.fh == value; }
            else if (command == "margin") { selected = field.margin == value; }
            button.Class = selected ? "primary small" : "secondary small";
        }
    }

    bool InspectorCardActionCurrent(DesignerInspectorCardAction action) {
        if (action == null || inspectorCardsRoot == null || inspectorCardsActions == null
                || !inspectorCardsActions.Contains(action)
                || action.owner != this || action.generation != inspectorCardsGeneration
                || action.keySequence != inspKeySeq || inspectorCardsKeySequence != inspKeySeq
                || action.view != inspectorCardsScope || action.view != inspectorView
                || action.target == null || action.target != inspectorCardsTarget || action.target != sel
                || inspectorCardsApp == null || inspectorCardsApp != inspectorApp
                || inspectorView == null || !inspectorView.IsActive() || inspectorRegion == null
                || inspectorRoot == null || !inspectorRoot.visible || inspTab != 0
                || inspCategory != inspectorCardsCategory || sel.ftype != inspectorCardsType || sel.kind != inspectorCardsKind
                || inspectorCardsHost == null || inspectorCardsRoot.parent != inspectorCardsHost
                || !inspectorRoot.ContainsInputControl(inspectorCardsRoot) || !this.InspectorCardsSelectionMatches()) { return false; }
        Button sender = action.sender;
        return sender != null && inspectorCardsRoot.ContainsInputControl(sender);
    }

    // Invoked from the standard routed Button Click subscription, never from Paint.
    public void InvokeInspectorCardAction(DesignerInspectorCardAction action) {
        if (!this.InspectorCardActionCurrent(action)) { return; }
        App app = inspectorCardsApp; FormField field = action.target;
        string command = action.command; int value = action.value;
        if (command.StartsWith("batch-")) {
            if (command == "batch-lock") { this.BatchToggleLock(); }
            else if (command == "batch-fill-height") { this.BatchFillHeight(); }
            else if (command == "batch-position") { this.BatchSetPosition(field.position == 1 ? 0 : 1); }
            else if (command == "batch-margin") { this.BatchSetMargins(value); }
            else if (command == "batch-padding") { this.BatchSetPadding(value); }
        } else {
            string gate = "";
            if (command == "status-height") { gate = "sbh|" + field.fname + "|" + Convert.ToString(value); }
            else if (command == "tools-dock") { gate = (value == 2 ? "tsBot|" : "tsTop|") + field.fname; }
            else if (command == "tools-height") { gate = "tsh|" + field.fname + "|" + Convert.ToString(value); }
            else if (command == "fill-height") { gate = "fillh|" + field.fname; }
            else if (command == "auto-height") { gate = "autoh|" + field.fname; }
            else if (command == "position") { gate = (field.position == 1 ? "posflow|" : "posfloat|") + field.fname; }
            else if (command == "dock") { gate = "dock|" + field.fname + "|" + Convert.ToString(value); }
            else if (command == "direction") { gate = "dir" + Convert.ToString(value) + "|" + field.fname; }
            else if (command == "gap") { gate = "gap|" + field.fname; }
            else if (command == "container-padding") { gate = "pad|" + field.fname; }
            else if (command == "width") { gate = "fw|" + field.fname; }
            else if (command == "height") { gate = "fh|" + field.fname; }
            else if (command == "margin") { gate = "margin|" + field.fname; }
            else if (command == "padding") { gate = "padding|" + field.fname; }
            if (gate == "") { return; }
            this.GateInspectorUndo(gate);
            bool declareRect = true;
            if (command == "status-height") {
                field.fh = value; field.dockSide = 2; field.position = 0;
                msg = Designer.T("StatusBar height set: ", "已设置状态栏高度: ") + this.InspectorCardHeightLabel(command, value);
            } else if (command == "tools-dock") {
                field.dockSide = value; field.position = 0;
                msg = value == 2 ? Designer.T("ToolStrip docked to Bottom", "工具条已置底") : Designer.T("ToolStrip docked to Top", "工具条已置顶");
            } else if (command == "tools-height") {
                field.fh = value; field.position = 0;
                msg = Designer.T("ToolStrip height set: ", "已设置工具条高度: ") + this.InspectorCardHeightLabel(command, value);
            } else if (command == "fill-height" || command == "auto-height") {
                field.position = 0; field.flexGrow = command == "fill-height" ? 1 : 0; field.fh = 0;
                msg = command == "fill-height" ? Designer.T("Set to Fill Height", "已设为自动撑满高度") : Designer.T("Set to Auto Height", "已设为自适应内容高度");
            } else if (command == "position") {
                if (field.position == 1) {
                    field.position = 0; field.fx = 0; field.fy = 0;
                    msg = Designer.T("Switched to Flow Layout", "已转为流式排版");
                } else {
                    this.DesignMakeFloat(field); declareRect = false;
                    msg = Designer.T("Switched to Float (Absolute)", "已转为浮动定位");
                }
            } else if (command == "dock") {
                field.dockSide = value;
                if (value > 0) { field.position = 0; field.fx = 0; field.fy = 0; }
                msg = Designer.T("Dock set: ", "已设置停靠方式: ") + this.InspectorCardDockLabel(value);
            } else if (command == "direction") { field.flexDir = value; declareRect = false; }
            else if (command == "gap") {
                field.gap = value; declareRect = false;
                if (field.designSource != null) { field.designSource.Set("gap", JsonValue.NewNum(Convert.ToString(value))); }
            } else if (command == "container-padding" || command == "padding") {
                field.padding = value; declareRect = command == "padding";
                if (field.designSource != null) { field.designSource.Set("padding", JsonValue.NewNum(Convert.ToString(value))); }
            } else if (command == "width") { field.fw = value; }
            else if (command == "height") { field.fh = value; }
            else if (command == "margin") {
                field.margin = value;
                if (field.designSource != null) { field.designSource.Set("margin", JsonValue.NewNum(Convert.ToString(value))); }
            }
            if (declareRect) { this.DesignDeclareRect(field); }
            this.MarkDocDirty();
        }
        if (this.InspectorCardActionCurrent(action)) { this.SyncInspectorCards(field); }
        app.RequestRedraw();
    }

    string InspectorCardHeightLabel(string command, int value) {
        if (command == "status-height") {
            if (value == 24) { return "24px (紧凑)"; }
            if (value == 28) { return "28px (标准)"; }
            return "32px (宽条)";
        }
        if (value == 28) { return "28px (紧凑)"; }
        if (value == 32) { return "32px (标准)"; }
        return "40px (大栏)";
    }

    string InspectorCardDockLabel(int side) {
        if (side == 1) { return "Top (顶)"; }
        if (side == 2) { return "Bottom (底)"; }
        if (side == 3) { return "Left (左)"; }
        if (side == 4) { return "Right (右)"; }
        if (side == 5) { return "Fill (铺满)"; }
        return "None (无)";
    }
}
