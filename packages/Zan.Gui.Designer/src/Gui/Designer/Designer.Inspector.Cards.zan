using System;
using Gui.Widget;
using Gui;
using System.Json;

namespace Gui.Designer;

partial class Designer {
    int RenderInspectorCards(App app, Canvas c, Theme t, FormField f, int ix, int iy, int iw) {
        int fs = Style.FontFallback(app, "small");
        // 多选批量编辑状态卡片与高频快捷操作栏
        if (freeExtra != null && freeExtra.Count > 0) {
            int nTotal = freeExtra.Count + 1;
            int cardPad = app.Scale(InspectorMetrics.PaddingCard);
            int rowH = app.Scale(InspectorMetrics.RowHeight);
            int gapStack = app.Scale(InspectorMetrics.GapStack);
            int gapInline = app.Scale(InspectorMetrics.GapInline);
            int cardBg = Style.Part(app, "designer", "toolbar", "", "", "", Style.SNormal()).BgOr(0);
            int cardBorder = Style.Part(app, "designer", "toolbar", "", "", "", Style.SNormal()).BorderOr(0);
            int titleCol = Style.Part(app, "designer", "hint", "", "", "", Style.SNormal()).FgOr(0);
            int hintCol = Style.Part(app, "designer", "propTip", "", "", "", Style.SNormal()).FgOr(0);
            int fsTiny = Style.FontFallback(app, "tiny");

            // 计算卡片高度：顶部标题与提示(约36px) + 3行按钮(3 * rowH) + 3个垂直gap + 上下内边距(2 * cardPad)
            int cardH = cardPad * 2 + app.Scale(36) + rowH * 3 + gapStack * 2;
            c.FillRoundRect(ix, iy, iw, cardH, app.Scale(4), cardBg);
            c.DrawRoundRect(ix, iy, iw, cardH, app.Scale(4), cardBorder, 1);

            int subY = iy + cardPad;
            string bTitle = Designer.T("Batch Editing (" + Convert.ToString(nTotal) + " items)", "多选批量编辑 (共 " + Convert.ToString(nTotal) + " 项)");
            c.DrawText(ix + cardPad, subY + app.Scale(2), bTitle, titleCol, fs);
            string bHint = Designer.T("Size/Margin/Position changes sync to all selected", "修改尺寸、内外边距与定位将自动同步");
            c.DrawText(ix + cardPad, subY + app.Scale(20), bHint, hintCol, fsTiny);

            subY = subY + app.Scale(36) + gapStack;
            int nBtns = 3;
            int btnW = (iw - cardPad * 2 - gapInline * (nBtns - 1)) / nBtns;
            int curBx = ix + cardPad;

            int bLockId = this.SmallBtnWithIcon(app, "lock", Designer.T("Lock", "锁定"), 0, curBx, subY, btnW);
            if (Ui.Clicked(app, bLockId)) { this.BatchToggleLock(); }
            curBx = curBx + btnW + gapInline;

            int bFillHId = this.SmallBtnWithIcon(app, "arrow-autofit-height", Designer.T("Fill H", "撑满高"), 0, curBx, subY, btnW);
            if (Ui.Clicked(app, bFillHId)) { this.BatchFillHeight(); }
            curBx = curBx + btnW + gapInline;

            string posTxt = sel.position == 1 ? Designer.T("Flow", "转流式") : Designer.T("Float", "转浮动");
            int bPosId = SmallBtn(app, posTxt, 0, curBx, subY, btnW);
            if (Ui.Clicked(app, bPosId)) { this.BatchSetPosition(sel.position == 1 ? 0 : 1); }

            // Row 2: 批量外边距快捷档位 Mg (px): [0] [4] [8] [12] [16]
            subY = subY + rowH + gapStack;
            int lblW = app.Scale(44);
            c.DrawText(ix + cardPad, subY + app.Scale(5), "Mg (px)", hintCol, fsTiny);
            int gBtnW = (iw - cardPad * 2 - lblW - gapInline * 5) / 5;
            if (gBtnW < app.Scale(20)) { gBtnW = app.Scale(20); }
            int curMx = ix + cardPad + lblW;
            List<int> mVals = new List<int>{ 0, 4, 8, 12, 16 };
            for (int mi = 0; mi < mVals.Count; mi = mi + 1) {
                int mv = mVals[mi];
                int bid = SmallBtn(app, Convert.ToString(mv), 0, curMx, subY, gBtnW);
                if (Ui.Clicked(app, bid)) { this.BatchSetMargins(mv); }
                curMx = curMx + gBtnW + gapInline;
            }

            // Row 3: 批量内边距快捷档位 Pad (px): [0] [8] [12] [16] [24]
            subY = subY + rowH + gapStack;
            c.DrawText(ix + cardPad, subY + app.Scale(5), "Pad (px)", hintCol, fsTiny);
            int curPx = ix + cardPad + lblW;
            List<int> pVals = new List<int>{ 0, 8, 12, 16, 24 };
            for (int pi = 0; pi < pVals.Count; pi = pi + 1) {
                int pv = pVals[pi];
                int bid = SmallBtn(app, Convert.ToString(pv), 0, curPx, subY, gBtnW);
                if (Ui.Clicked(app, bid)) { this.BatchSetPadding(pv); }
                curPx = curPx + gBtnW + gapInline;
            }

            iy = iy + cardH + gapStack;
        }

        // 单选高频布局与停靠快捷操作卡片（一键高度撑满/自适应/转浮动/转流式 + Dock停靠快速切换）
        if ((freeExtra == null || freeExtra.Count == 0) && (inspCategory == 0 || inspCategory == 2)) {
            bool isSb = (f.ftype == 59 || f.kind == "StatusBar");
            bool isTs = (f.ftype == 58 || f.kind == "ToolStrip");
            int cardPad = app.Scale(InspectorMetrics.PaddingCard);
            int rowH = app.Scale(InspectorMetrics.RowHeight);
            int gapStack = app.Scale(InspectorMetrics.GapStack);
            int gapInline = app.Scale(InspectorMetrics.GapInline);
            int cardBg = Style.Part(app, "designer", "toolbar", "", "", "", Style.SNormal()).BgOr(0);
            int cardBorder = Style.Part(app, "designer", "toolbar", "", "", "", Style.SNormal()).BorderOr(0);
            int hintCol = Style.Part(app, "designer", "propTip", "", "", "", Style.SNormal()).FgOr(0);
            int fsTiny = Style.FontFallback(app, "tiny");

            int cardH = isSb ? (cardPad * 2 + app.Scale(20) + rowH + gapStack)
                       : (isTs ? (cardPad * 2 + rowH * 2 + gapStack)
                               : (cardPad * 2 + rowH * 3 + gapStack * 2));

            c.FillRoundRect(ix, iy, iw, cardH, app.Scale(4), cardBg);
            c.DrawRoundRect(ix, iy, iw, cardH, app.Scale(4), cardBorder, 1);

            int subY = iy + cardPad;

            if (isSb) {
                // 状态栏专用面板：锁定底部，提供标准高度快捷切换，杜绝破坏固底
                c.DrawText(ix + cardPad, subY + app.Scale(2), Designer.T("⚓ Fixed to Bottom (Dock.Bottom)", "⚓ 固底状态栏 (固定贴紧窗口底部)"), hintCol, fsTiny);
                subY = subY + app.Scale(20) + gapStack;
                int hBtnW = (iw - cardPad * 2 - gapInline * 2) / 3;
                List<string> sbHLabels = new List<string>{ "24px (紧凑)", "28px (标准)", "32px (宽条)" };
                List<int> sbHVals = new List<int>{ 24, 28, 32 };
                for (int hi = 0; hi < 3; hi = hi + 1) {
                    int val = sbHVals[hi];
                    int isCur = (f.fh == val || (f.fh <= 0 && val == 28)) ? 1 : 0;
                    int bid = SmallBtn(app, sbHLabels[hi], isCur, ix + cardPad + hi * (hBtnW + gapInline), subY, hBtnW);
                    if (Ui.Clicked(app, bid)) {
                        this.GateInspectorUndo("sbh|" + f.fname + "|" + Convert.ToString(val));
                        f.fh = val;
                        f.dockSide = 2;
                        f.position = 0;
                        this.DesignDeclareRect(f);
                        this.MarkDocDirty();
                        msg = Designer.T("StatusBar height set: ", "已设置状态栏高度: ") + sbHLabels[hi];
                        app.RequestRedraw();
                    }
                }
            } else if (isTs) {
                // 工具栏专用面板：仅允许置顶/置底，杜绝浮动
                int dockBtnW = (iw - cardPad * 2 - gapInline) / 2;
                int bTopId = this.SmallBtnWithIcon(app, "arrow-up", Designer.T("Top (Default)", "顶部停靠 (Top)"), f.dockSide != 2 ? 1 : 0, ix + cardPad, subY, dockBtnW);
                if (Ui.Clicked(app, bTopId)) {
                    this.GateInspectorUndo("tsTop|" + f.fname);
                    f.dockSide = 1;
                    f.position = 0;
                    this.DesignDeclareRect(f);
                    this.MarkDocDirty();
                    msg = Designer.T("ToolStrip docked to Top", "工具条已置顶");
                    app.RequestRedraw();
                }
                int bBotId = this.SmallBtnWithIcon(app, "arrow-down", Designer.T("Bottom", "底部停靠 (Bottom)"), f.dockSide == 2 ? 1 : 0, ix + cardPad + dockBtnW + gapInline, subY, dockBtnW);
                if (Ui.Clicked(app, bBotId)) {
                    this.GateInspectorUndo("tsBot|" + f.fname);
                    f.dockSide = 2;
                    f.position = 0;
                    this.DesignDeclareRect(f);
                    this.MarkDocDirty();
                    msg = Designer.T("ToolStrip docked to Bottom", "工具条已置底");
                    app.RequestRedraw();
                }
                subY = subY + rowH + gapStack;
                int hBtnW = (iw - cardPad * 2 - gapInline * 2) / 3;
                List<string> tsHLabels = new List<string>{ "28px (紧凑)", "32px (标准)", "40px (大栏)" };
                List<int> tsHVals = new List<int>{ 28, 32, 40 };
                for (int hi = 0; hi < 3; hi = hi + 1) {
                    int val = tsHVals[hi];
                    int isCur = (f.fh == val || (f.fh <= 0 && val == 32)) ? 1 : 0;
                    int bid = SmallBtn(app, tsHLabels[hi], isCur, ix + cardPad + hi * (hBtnW + gapInline), subY, hBtnW);
                    if (Ui.Clicked(app, bid)) {
                        this.GateInspectorUndo("tsh|" + f.fname + "|" + Convert.ToString(val));
                        f.fh = val;
                        f.position = 0;
                        this.DesignDeclareRect(f);
                        this.MarkDocDirty();
                        msg = Designer.T("ToolStrip height set: ", "已设置工具条高度: ") + tsHLabels[hi];
                        app.RequestRedraw();
                    }
                }
            } else {
                int topBtnW = (iw - cardPad * 2 - gapInline * 2) / 3;

                int bFillId = this.SmallBtnWithIcon(app, "arrow-autofit-height", Designer.T("Fill H", "撑满高"), f.position == 0 && f.flexGrow > 0 && f.fh == 0 ? 1 : 0, ix + cardPad, subY, topBtnW);
                if (Ui.Clicked(app, bFillId)) {
                    this.GateInspectorUndo("fillh|" + f.fname);
                    f.position = 0;
                    f.flexGrow = 1;
                    f.fh = 0;
                    this.DesignDeclareRect(f);
                    this.MarkDocDirty();
                    msg = Designer.T("Set to Fill Height", "已设为自动撑满高度");
                    app.RequestRedraw();
                }

                int bAutoId = SmallBtn(app, Designer.T("0 Auto H", "0 自适应"), f.position == 0 && f.flexGrow == 0 && f.fh == 0 ? 1 : 0, ix + cardPad + topBtnW + gapInline, subY, topBtnW);
                if (Ui.Clicked(app, bAutoId)) {
                    this.GateInspectorUndo("autoh|" + f.fname);
                    f.position = 0;
                    f.flexGrow = 0;
                    f.fh = 0;
                    this.DesignDeclareRect(f);
                    this.MarkDocDirty();
                    msg = Designer.T("Set to Auto Height", "已设为自适应内容高度");
                    app.RequestRedraw();
                }

                string modeLabel = (f.position == 1) ? Designer.T("➔ To Flow", "➔ 转流式") : Designer.T("✦ To Float", "✦ 转浮动");
                int bModeId = SmallBtn(app, modeLabel, f.position == 1 ? 1 : 0, ix + cardPad + (topBtnW + gapInline) * 2, subY, topBtnW);
                if (Ui.Clicked(app, bModeId)) {
                    if (f.position == 1) {
                        this.GateInspectorUndo("posflow|" + f.fname);
                        f.position = 0;
                        f.fx = 0;
                        f.fy = 0;
                        this.DesignDeclareRect(f);
                        this.MarkDocDirty();
                        msg = Designer.T("Switched to Flow Layout", "已转为流式排版");
                    } else {
                        this.GateInspectorUndo("posfloat|" + f.fname);
                        this.DesignMakeFloat(f);
                        this.MarkDocDirty();
                        msg = Designer.T("Switched to Float (Absolute)", "已转为浮动定位");
                    }
                    app.RequestRedraw();
                }
                subY = subY + rowH + gapStack;

                // 停靠方式快捷切换 (Dock: 两行标准栅格 3+3 排列，宽裕舒适杜绝单行挤压)
                int dBtnW = (iw - cardPad * 2 - gapInline * 2) / 3;
                List<string> r1Labels = new List<string>{ "Top (顶)", "Fill (铺满)", "Bottom (底)" };
                List<int> r1Sides = new List<int>{ 1, 5, 2 };
                for (int di = 0; di < 3; di = di + 1) {
                    int ds = r1Sides[di];
                    int isCur = (f.dockSide == ds) ? 1 : 0;
                    int bid = SmallBtn(app, r1Labels[di], isCur, ix + cardPad + di * (dBtnW + gapInline), subY, dBtnW);
                    if (Ui.Clicked(app, bid)) {
                        this.GateInspectorUndo("dock|" + f.fname + "|" + Convert.ToString(ds));
                        f.dockSide = ds;
                        if (ds > 0) {
                            f.position = 0;
                            f.fx = 0;
                            f.fy = 0;
                        }
                        this.DesignDeclareRect(f);
                        this.MarkDocDirty();
                        msg = Designer.T("Dock set: ", "已设置停靠方式: ") + r1Labels[di];
                        app.RequestRedraw();
                    }
                }
                subY = subY + rowH + gapStack;
                List<string> r2Labels = new List<string>{ "Left (左)", "None (无)", "Right (右)" };
                List<int> r2Sides = new List<int>{ 3, 0, 4 };
                for (int di = 0; di < 3; di = di + 1) {
                    int ds = r2Sides[di];
                    int isCur = (f.dockSide == ds) ? 1 : 0;
                    int bid = SmallBtn(app, r2Labels[di], isCur, ix + cardPad + di * (dBtnW + gapInline), subY, dBtnW);
                    if (Ui.Clicked(app, bid)) {
                        this.GateInspectorUndo("dock|" + f.fname + "|" + Convert.ToString(ds));
                        f.dockSide = ds;
                        if (ds > 0) {
                            f.position = 0;
                            f.fx = 0;
                            f.fy = 0;
                        }
                        this.DesignDeclareRect(f);
                        this.MarkDocDirty();
                        msg = Designer.T("Dock set: ", "已设置停靠方式: ") + r2Labels[di];
                        app.RequestRedraw();
                    }
                }
            }

            iy = iy + cardH + gapStack;
        }

        // 容器专属常驻排版快捷工具栏（流向切换、Gap子间距与Padding内边距快捷档位）
        if (FormField.IsContainerOf(f.ftype) && (freeExtra == null || freeExtra.Count == 0) && (inspCategory == 0 || inspCategory == 2)) {
            int cardPad = app.Scale(InspectorMetrics.PaddingCard);
            int rowH = app.Scale(InspectorMetrics.RowHeight);
            int gapStack = app.Scale(InspectorMetrics.GapStack);
            int gapInline = app.Scale(InspectorMetrics.GapInline);
            int cardH = cardPad * 2 + rowH * 3 + gapStack * 2;
            int cardBg = Style.Part(app, "designer", "toolbar", "", "", "", Style.SNormal()).BgOr(0);
            int cardBorder = Style.Part(app, "designer", "toolbar", "", "", "", Style.SNormal()).BorderOr(0);
            c.FillRoundRect(ix, iy, iw, cardH, app.Scale(4), cardBg);
            c.DrawRoundRect(ix, iy, iw, cardH, app.Scale(4), cardBorder, 1);

            // Row 1: 方向切换 [ ⬇ 纵向 (Column) ] [ ➔ 横向 (Row) ]
            int dirBtnW = (iw - cardPad * 2 - gapInline) / 2;
            int dirY = iy + cardPad;
            int bColId = this.SmallBtnWithIcon(app, "arrow-down", Designer.T("Column", "纵向 (Col)"), f.flexDir == 0 ? 1 : 0, ix + cardPad, dirY, dirBtnW);
            if (Ui.Clicked(app, bColId)) {
                this.GateInspectorUndo("dir0|" + f.fname);
                f.flexDir = 0;
                this.MarkDocDirty();
                if (this.hostApp != null) { this.hostApp.RequestRedraw(); }
            }
            int bRowId = this.SmallBtnWithIcon(app, "arrow-right", Designer.T("Row", "横向 (Row)"), f.flexDir == 1 ? 1 : 0, ix + cardPad + dirBtnW + gapInline, dirY, dirBtnW);
            if (Ui.Clicked(app, bRowId)) {
                this.GateInspectorUndo("dir1|" + f.fname);
                f.flexDir = 1;
                this.MarkDocDirty();
                if (this.hostApp != null) { this.hostApp.RequestRedraw(); }
            }

            // Row 2: 子间距 Gap 快捷档位: Gap [0] [4] [8] [12] [16]
            int gapY = dirY + rowH + gapStack;
            int lblW = app.Scale(36);
            int fsTiny = Style.FontFallback(app, "tiny");
            int hintCol = Style.Part(app, "designer", "hint", "", "", "", Style.SNormal()).FgOr(0);
            c.DrawText(ix + cardPad, gapY + app.Scale(5), "Gap:", hintCol, fsTiny);
            int gapValsW = iw - cardPad * 2 - lblW;
            int nGapBtns = 5;
            int gBtnW = (gapValsW - gapInline * (nGapBtns - 1)) / nGapBtns;
            int curGx = ix + cardPad + lblW;
            List<int> gVals = new List<int>{ 0, 4, 8, 12, 16 };
            for (int gi = 0; gi < gVals.Count; gi = gi + 1) {
                int gv = gVals[gi];
                int bid = SmallBtn(app, Convert.ToString(gv), f.gap == gv ? 1 : 0, curGx, gapY, gBtnW);
                if (Ui.Clicked(app, bid)) {
                    this.GateInspectorUndo("gap|" + f.fname);
                    f.gap = gv;
                    if (f.designSource != null) {
                        f.designSource.Set("gap", JsonValue.NewNum(Convert.ToString(gv)));
                    }
                    this.MarkDocDirty();
                    if (this.hostApp != null) { this.hostApp.RequestRedraw(); }
                }
                curGx = curGx + gBtnW + gapInline;
            }

            // Row 3: 内边距 Pad 快捷档位: Pad [0] [8] [12] [16] [24]
            int padY = gapY + rowH + gapStack;
            c.DrawText(ix + cardPad, padY + app.Scale(5), "Pad:", hintCol, fsTiny);
            int curPx = ix + cardPad + lblW;
            List<int> pVals = new List<int>{ 0, 8, 12, 16, 24 };
            for (int pi = 0; pi < pVals.Count; pi = pi + 1) {
                int pv = pVals[pi];
                int bid = SmallBtn(app, Convert.ToString(pv), f.padding == pv ? 1 : 0, curPx, padY, gBtnW);
                if (Ui.Clicked(app, bid)) {
                    this.GateInspectorUndo("pad|" + f.fname);
                    f.padding = pv;
                    if (f.designSource != null) {
                        f.designSource.Set("padding", JsonValue.NewNum(Convert.ToString(pv)));
                    }
                    this.MarkDocDirty();
                    if (this.hostApp != null) { this.hostApp.RequestRedraw(); }
                }
                curPx = curPx + gBtnW + gapInline;
            }

            iy = iy + cardH + gapStack;
        }

        // 常用物理尺寸快捷预设卡片 (仅在布局分类 inspCategory == 2 下展开辅助排版，双列并排紧凑布局)
        if (!FormField.IsNonVisualOf(f.ftype) && (freeExtra == null || freeExtra.Count == 0) && inspCategory == 2) {
            int cardPad = app.Scale(InspectorMetrics.PaddingCard);
            int rowH = app.Scale(InspectorMetrics.RowHeight);
            int gapStack = app.Scale(InspectorMetrics.GapStack);
            int gapInline = app.Scale(InspectorMetrics.GapInline);
            int cardH = cardPad * 2 + rowH * 2 + gapStack;
            int cardBg = Style.Part(app, "designer", "toolbar", "", "", "", Style.SNormal()).BgOr(0);
            int cardBorder = Style.Part(app, "designer", "toolbar", "", "", "", Style.SNormal()).BorderOr(0);
            c.FillRoundRect(ix, iy, iw, cardH, app.Scale(4), cardBg);
            c.DrawRoundRect(ix, iy, iw, cardH, app.Scale(4), cardBorder, 1);

            int fsTiny = Style.FontFallback(app, "tiny");
            if (fsTiny <= 0) { fsTiny = Style.FontFallback(app, "small"); }
            int hintCol = Style.Part(app, "designer", "hint", "", "", "", Style.SNormal()).FgOr(0);

            int colGap = gapStack;
            int halfW = (iw - cardPad * 2 - colGap) / 2;
            int lblW = app.Scale(24);
            int gBtnW = (halfW - lblW - gapInline * 3) / 4;
            if (gBtnW < app.Scale(16)) { gBtnW = app.Scale(16); }

            // Row 1: Left: W (Auto, 80, 160, 240) | Right: H (Auto, 24, 32, 40)
            int row1Y = iy + cardPad;

            // Left: Width
            c.DrawText(ix + cardPad, row1Y + app.Scale(5), "W", hintCol, fsTiny);
            int curWx = ix + cardPad + lblW;
            List<int> wVals = new List<int>{ 0, 80, 160, 240 };
            for (int wi = 0; wi < wVals.Count; wi = wi + 1) {
                int wv = wVals[wi];
                string wLabel = wv == 0 ? "0" : Convert.ToString(wv);
                int bid = SmallBtn(app, wLabel, f.fw == wv ? 1 : 0, curWx, row1Y, gBtnW);
                if (Ui.Clicked(app, bid)) {
                    this.GateInspectorUndo("fw|" + f.fname);
                    f.fw = wv;
                    this.DesignDeclareRect(f);
                    this.MarkDocDirty();
                    if (this.hostApp != null) { this.hostApp.RequestRedraw(); }
                }
                curWx = curWx + gBtnW + gapInline;
            }

            // Right: Height
            int rColX = ix + cardPad + halfW + colGap;
            c.DrawText(rColX, row1Y + app.Scale(5), "H", hintCol, fsTiny);
            int curHx = rColX + lblW;
            List<int> hVals = new List<int>{ 0, 24, 32, 40 };
            for (int hi = 0; hi < hVals.Count; hi = hi + 1) {
                int hv = hVals[hi];
                string hLabel = hv == 0 ? "0" : Convert.ToString(hv);
                int bid = SmallBtn(app, hLabel, f.fh == hv ? 1 : 0, curHx, row1Y, gBtnW);
                if (Ui.Clicked(app, bid)) {
                    this.GateInspectorUndo("fh|" + f.fname);
                    f.fh = hv;
                    this.DesignDeclareRect(f);
                    this.MarkDocDirty();
                    if (this.hostApp != null) { this.hostApp.RequestRedraw(); }
                }
                curHx = curHx + gBtnW + gapInline;
            }

            // Row 2: Left: Mg (0, 4, 8, 16) | Right: Pd (0, 4, 8, 16)
            int row2Y = row1Y + rowH + gapStack;

            // Left: Margin
            c.DrawText(ix + cardPad, row2Y + app.Scale(5), "Mg", hintCol, fsTiny);
            int curMx = ix + cardPad + lblW;
            List<int> mVals = new List<int>{ 0, 4, 8, 16 };
            for (int mi = 0; mi < mVals.Count; mi = mi + 1) {
                int mv = mVals[mi];
                int bid = SmallBtn(app, Convert.ToString(mv), f.margin == mv ? 1 : 0, curMx, row2Y, gBtnW);
                if (Ui.Clicked(app, bid)) {
                    this.GateInspectorUndo("margin|" + f.fname);
                    f.margin = mv;
                    if (f.designSource != null) {
                        f.designSource.Set("margin", JsonValue.NewNum(Convert.ToString(mv)));
                    }
                    this.DesignDeclareRect(f);
                    this.MarkDocDirty();
                    if (this.hostApp != null) { this.hostApp.RequestRedraw(); }
                }
                curMx = curMx + gBtnW + gapInline;
            }

            // Right: Padding
            c.DrawText(rColX, row2Y + app.Scale(5), "Pd", hintCol, fsTiny);
            int curPx = rColX + lblW;
            List<int> pVals = new List<int>{ 0, 4, 8, 16 };
            for (int pi = 0; pi < pVals.Count; pi = pi + 1) {
                int pv = pVals[pi];
                int bid = SmallBtn(app, Convert.ToString(pv), f.padding == pv ? 1 : 0, curPx, row2Y, gBtnW);
                if (Ui.Clicked(app, bid)) {
                    this.GateInspectorUndo("padding|" + f.fname);
                    f.padding = pv;
                    if (f.designSource != null) {
                        f.designSource.Set("padding", JsonValue.NewNum(Convert.ToString(pv)));
                    }
                    this.DesignDeclareRect(f);
                    this.MarkDocDirty();
                    if (this.hostApp != null) { this.hostApp.RequestRedraw(); }
                }
                curPx = curPx + gBtnW + gapInline;
            }

            iy = iy + cardH + gapStack;
        }
        return iy;
    }
}
