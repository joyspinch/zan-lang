using System;
using Gui.Widget;
using Gui;
using System.Json;

namespace Gui.Designer;

// 设计器部分：属性检查器（逐字段编辑器、双向
// 同步）和设计 JSON 序列化。
partial class Designer {
    // 渲染右侧检查器面板：目标名 + 属性/事件选项卡对，可滚动主体
    // 按选项卡分派到 RenderEventsTab / RenderWindowProps /
    // RenderFieldProps（滚轮滚动，内容高度取上一帧测量值）。
    void RenderInspector(App app, Canvas c, Theme t, int x, int y, int w, int h) {
        if (w < 20 || h < 20) { return; }
        int fs = Style.FontFallback(app, "small");
        c.FillRoundRect(x, y, w, h, app.Scale(6), Style.Part(app, "designer", "panel", "", "", "", Style.SNormal()).BgOr(0));
        c.DrawRoundRect(x, y, w, h, app.Scale(6), Style.Part(app, "designer", "panel", "", "", "", Style.SNormal()).BorderOr(0), 1);
        int ix = x + app.Scale(InspectorMetrics.PaddingPanel);
        int iw = w - app.Scale(InspectorMetrics.PaddingPanel * 2);

        // 固定头部：正在编辑的对象 + 属性/事件
        // 选项卡对。目标是选中的组件；未选中任何内容时
        // 是根 Window。
        bool root = (sel == null);
        int hy = y + app.Scale(10);
        string target = Designer.T("WINDOW", "窗口") + "  ·  " + winTitle;
        if (!root) {
            string tn = FormField.TypeName(sel.ftype);
            if (sel.IsCustom()) { tn = sel.kind; }
            target = Designer.T("COMPONENT", "组件") + "  ·  " + tn;
            if (freeExtra != null && freeExtra.Count > 0) {
                target = target + " " + Designer.T("(+" + Convert.ToString(freeExtra.Count) + " selected)", "(+" + Convert.ToString(freeExtra.Count) + " 个已选)");
            }
        }
        c.DrawText(ix, hy, Ellipsis.Fit(target, iw, fs), Style.Part(app, "designer", "hint", "", "", "", Style.SNormal()).FgOr(0), fs);
        hy = hy + app.Scale(18);

        int tabW = (iw - app.Scale(6)) / 2;
        int pType = 0; if (inspTab == 0) { pType = 1; }
        int eType = 0; if (inspTab == 1) { eType = 1; }
        int pId = SmallBtn(app, Designer.T("Properties", "属性"), pType, ix, hy, tabW);
        int eId = SmallBtn(app, Designer.T("Events", "事件"), eType,
            ix + tabW + app.Scale(6), hy, tabW);
        if (Ui.Clicked(app, pId) && inspTab != 0) { inspTab = 0; inspScroll = 0; }
        if (Ui.Clicked(app, eId) && inspTab != 1) { inspTab = 1; inspScroll = 0; }
        hy = hy + app.Scale(InspectorMetrics.TabButtonHeight) + app.Scale(InspectorMetrics.GapStack);

        if (inspTab == 0 && !root) {
            List<string> catLabels = new List<string>{
                Designer.T("All", "全部"),
                Designer.T("Basic", "基础"),
                Designer.T("Layout", "布局"),
                Designer.T("Style", "样式"),
                Designer.T("Data", "数据")
            };
            int nCats = catLabels.Count;
            int catGap = app.Scale(InspectorMetrics.GapMicro);
            int catBtnW = (iw - catGap * (nCats - 1)) / nCats;
            int curCx = ix;
            for (int ci = 0; ci < nCats; ci = ci + 1) {
                int cType = 0;
                if (inspCategory == ci) { cType = 1; }
                int catId = SmallBtn(app, catLabels[ci], cType, curCx, hy, catBtnW);
                if (Ui.Clicked(app, catId) && inspCategory != ci) {
                    inspCategory = ci;
                    inspScroll = 0;
                    app.RequestRedraw();
                }
                curCx = curCx + catBtnW + catGap;
            }
            hy = hy + app.Scale(InspectorMetrics.TabButtonHeight) + app.Scale(InspectorMetrics.GapStack);
        }

        // 工业级即时属性/事件过滤搜索框
        if (inspFilterInput != null) {
            int searchH = app.Scale(InspectorMetrics.SearchInputHeight);
            inspFilterInput.Render(app, ix, hy, iw, searchH);
            hy = hy + searchH + app.Scale(InspectorMetrics.GapStack);
        }

        // 可滚动主体。内容高度取上一帧（inspContentH）的测量值，
        // 因此较高的属性/分组事件列表可以滚动。
        int bodyY = hy;
        int bodyH = y + h - bodyY - app.Scale(InspectorMetrics.GapStack);
        int maxScroll = inspContentH - bodyH;
        if (maxScroll < 0) { maxScroll = 0; }
        if (InRect(app.mouseX, app.mouseY, x, bodyY, w, bodyH)) {
            if (app.CaptureWheel(x, bodyY, w, bodyH)) {
                int delta = app.window.EventKeyCode();
                inspScroll = inspScroll - delta * app.Scale(40) / 120;
                app.RequestRedraw();
            }
        }
        if (inspScroll < 0) { inspScroll = 0; }
        if (inspScroll > maxScroll) { inspScroll = maxScroll; }

        c.PushClip(x + 1, bodyY, w - 2, bodyH);
        int iy = bodyY - inspScroll;
        int startY = iy;
        if (inspTab == 1) {
            iy = RenderEventsTab(app, c, t, ix, iy, iw);
        } else if (root) {
            iy = RenderWindowProps(app, c, t, ix, iy, iw);
        } else {
            SyncEditors(sel);
            iy = RenderFieldProps(app, c, t, sel, ix, iy, iw);
        }
        inspContentH = iy - startY;
        c.PopClip();

        if (maxScroll > 0) {
            Scrollbar.RenderVertical(app, x + w - app.Scale(7), bodyY,
                bodyH, inspContentH, inspScroll);
        }

        if (inspTab == 1) {
            this.RenderEventDropdownOverlay(app, c, t, fs);
        }
    }

    // 撤销会话状态：即时模式输入框每键一变，不能逐键压整档
    // 快照。同一编辑会话（同一输入框连续编辑）只在第一处变更
    // 前压一次；会话键变化（换输入框/换目标）才允许再压。
    string undoSession;
    bool undoSessionPushed;

    // 连续编辑的撤销会话守卫：会话首变时压栈（调用方随后写值，
    // 快照因此落在变更之前），后续键入不再压。
    void GateInspectorUndo(string sessionKey) {
        if (sessionKey != undoSession) {
            undoSession = sessionKey;
            undoSessionPushed = false;
        }
        if (!undoSessionPushed) {
            this.PushUndo();
            undoSessionPushed = true;
        }
    }

    // 离散命令（单击按钮/开关）用：每次调用必压一次栈，并结束
    // 当前编辑会话——命令之后的第一笔键入重新起会话。
    void BarrierInspectorUndo() {
        undoSession = "";
        undoSessionPushed = false;
        this.PushUndo();
    }

    // 选区变化时重置选项 / 事件编辑器（普通属性行直接
    // 绑定字段，不需要手动同步）。
    void SyncEditors(FormField f) {
        if (f == selPrev) { return; }
        selPrev = f;
        inspKeySeq = inspKeySeq + 1;
        optInput.SetText("");
        // 表格的行实体（extra["of"]）读进检查器暂存，属性表经
        // 绑定写 ofEd，渲染后差量写回 extra。
        ofEd = "";
        if (f.extra != null) { ofEd = f.extra.Str("of", ""); }
        List<string> evs = f.Events();
        if (evs.Count > 0) { evtEditing = evs[0]; } else { evtEditing = ""; }
        evtInput.SetText(f.GetHandler(evtEditing));
    }

    // 为事件建议委托方法名，例如字段 "amount" +
    // "Change" -> "OnAmountChange"。过滤非 ASCII 字符与空格，保证生成合法 C 风格标识符。
    static string SuggestHandler(FormField f, string ev) {
        string src = f.fname;
        if (src == "") { src = FormField.TypeName(f.ftype); }
        string id = Designer.CleanIdentifier(src);
        if (id == "" || id == "Item") { id = FormField.TypeName(f.ftype); }
        id = Designer.CleanIdentifier(id);
        string cleanEv = Designer.CleanIdentifier(ev);
        return "On" + id + cleanEv;
    }

    // 选中组件的属性列表：只声明要编辑哪些字段，
    // 行的标签 / 编辑器 / 滚动全由 PropertyGrid 完成。
    List<PropSpec> FieldSpecs(FormField f) {
        List<PropSpec> allSpecs = this.AllFieldSpecs(f);
        string q = inspFilterInput != null ? inspFilterInput.GetText().Trim() : "";
        bool hasFilter = q != "";
        List<PropSpec> filtered = new List<PropSpec>();
        for (int i = 0; i < allSpecs.Count; i = i + 1) {
            PropSpec s = allSpecs[i];
            if (hasFilter) {
                if (s.kind == 5) { continue; }
                if (Designer.Contains(s.key, q) || Designer.Contains(s.label, q)) {
                    filtered.Add(s);
                }
                continue;
            }
            if (inspCategory == 0) {
                filtered.Add(s);
                continue;
            }
            if (s.kind == 5) { continue; }
            int cat = 1;
            string k = s.key;
            if (k == "name" || k == "label" || k == "placeholder" || k == "component" || k == "pvOff") {
                cat = 1;
            } else if (k == "dock" || k == "position" || k == "flexGrow" || k == "anchor" || k == "x" || k == "y" || k == "w" || k == "h" || k == "margin" || k == "padding" || k == "gap" || k == "flexDir" || k == "justify" || k == "alignItems" || k == "flexWrap" || k == "span") {
                cat = 2;
            } else if (k == "bind" || k == "bindProp" || k == "of") {
                cat = 3;
            } else if (k == "required" || k == "wrap" || k == "orient" || k == "defOn" || k == "disabled" || k == "visible" || k == "tooltip") {
                cat = 4;
            }
            if (inspCategory == cat) {
                filtered.Add(s);
            }
        }
        return filtered;
    }

    static bool IsInputWidget(FormField f) {
        if (f == null) { return false; }
        // 只有数据输入型控件（输入框、多行文本框、下拉框、单选/复选框、数字框、日期选择、颜色选择等）才需要占位符与必填校验
        // 栏条、容器、展示、按钮类（ToolStrip, StatusBar, Tabs, Panel, Button, Divider, DataGrid, Ribbon 等）坚决不出现
        if (f.ftype == 58 || f.ftype == 59 || f.ftype == 2 || f.ftype == 3 || f.ftype == 18
                || f.kind == "ToolStrip" || f.kind == "StatusBar" || f.kind == "Tabs"
                || f.kind == "Panel" || f.kind == "Button" || f.kind == "Divider"
                || f.kind == "DataGrid" || f.kind == "Timeline" || f.kind == "Tree"
                || f.kind == "SplitPanel" || f.kind == "Ribbon") {
            return false;
        }
        string k = f.kind.ToLower();
        return f.ftype == 0 || f.ftype == 1 || f.ftype == 6 || f.ftype == 7 || f.ftype == 8
            || f.ftype == 14 || f.ftype == 15 || f.ftype == 16
            || k == "input" || k == "textarea" || k == "password" || k == "select"
            || k == "selectbox" || k == "checkbox" || k == "radio" || k == "inputnumber"
            || k == "datepicker" || k == "timepicker" || k == "colorpicker" || k == "upload"
            || k == "inputotp" || k == "autocomplete";
    }

    List<PropSpec> AllFieldSpecs(FormField f) {
        List<PropSpec> ps = new List<PropSpec>();

        // 1. 标识与常用 (VS 规范首置：Name 与 Label 最核心)
        ps.Add(PropSpec.Section(Designer.T("IDENTITY / COMMON", "标识与常用")));
        PropSpec nm = PropSpec.Text("name", Designer.T("Name", "名称 (Name)"));
        nm.str = f.fname;
        nm.tip = Designer.T(
            "The control's variable name; code references the control by it.",
            "控件的变量名，代码里通过它引用该控件；改名会同步设计器树节点。");
        ps.Add(nm);

        PropSpec lbl = PropSpec.Text("label", Designer.T("Label / Text", "显示文本 (Label)"));
        lbl.str = f.label;
        lbl.tip = Designer.T("Text shown on or next to this control.",
            "控件上显示或紧邻显示的标题与文字内容。");
        ps.Add(lbl);

        // 占位文本仅属于输入型控件，栏条与容器绝不混淆展示
        if (IsInputWidget(f)) {
            PropSpec ph = PropSpec.Text("placeholder", Designer.T("Placeholder", "占位文本"));
            ph.str = f.placeholder;
            ph.tip = Designer.T("Grey hint text shown when the input is empty.",
                "输入框为空时显示的灰色提示文字。");
            ps.Add(ph);
        }

        if (f.IsCustom()) {
            PropSpec ck = PropSpec.Text("component", Designer.T("Component", "组件类型"));
            ck.str = f.customKind;
            ps.Add(ck);
        }
        if (f.compRef) {
            PropSpec pv = PropSpec.Bool("pvOff", Designer.T("Canvas preview", "画布预览"));
            pv.flag = f.pvPreview;
            pv.tip = Designer.T(
                "Render the referenced component's real widgets on the canvas; turn off to show a placeholder chip.",
                "在画布上按组件设计渲染真控件预览；关闭后显示占位块。");
            ps.Add(pv);
        }

        // 2. 布局与几何 (VS WinForms/WPF 布局大类)
        ps.Add(PropSpec.Section(Designer.T("LAYOUT", "布局与几何")));
        bool isStatusBar = (f.ftype == 59 || f.kind == "StatusBar");
        bool isToolStrip = (f.ftype == 58 || f.kind == "ToolStrip");
        if (isStatusBar) {
            f.dockSide = 2;
            f.position = 0;
            f.fx = 0;
            f.anchor = 0;
            List<string> dockOpts = new List<string>{ Designer.T("Bottom (Locked)", "底部停靠 (固定固底)") };
            PropSpec pdock = PropSpec.Enum("dock", Designer.T("Dock", "停靠方式 (Dock)"), dockOpts);
            pdock.num = 0;
            pdock.tip = Designer.T("StatusBar is permanently docked to the bottom edge of the window.", "状态栏作为顶层窗口结构组件，固定停靠于窗口最底部，不可浮动或改向。");
            ps.Add(pdock);

            PropSpec ph = PropSpec.Int("h", Designer.T("Height", "高度 (Height)"));
            if (f.fh <= 0) { f.fh = FormField.DefaultHFor(f.ftype); }
            ph.num = f.fh;
            ph.Step(2, 16, 200);
            ph.tip = Designer.T("Height of the status bar in pixels.", "状态栏高度（像素）。");
            ps.Add(ph);

            PropSpec ppd = PropSpec.Int("padding", Designer.T("Padding", "内边距 (Padding)"));
            ppd.num = f.padding;
            ppd.Step(1, 0, 100);
            ppd.tip = Designer.T("Inner padding in pixels.", "控件内部边距（像素）。");
            ps.Add(ppd);
        } else if (isToolStrip) {
            if (f.dockSide == 0) { f.dockSide = 1; }
            f.position = 0;
            f.fx = 0;
            f.anchor = 0;
            List<string> dockOpts = new List<string>{
                Designer.T("Top (Default)", "顶部停靠 (Top)"),
                Designer.T("Bottom", "底部停靠 (Bottom)") };
            PropSpec pdock = PropSpec.Enum("dock", Designer.T("Dock", "停靠方式 (Dock)"), dockOpts);
            pdock.num = (f.dockSide == 2) ? 1 : 0;
            pdock.tip = Designer.T("ToolStrip dock edge (Top by default, or Bottom).", "工具条停靠边（默认置顶 Top，也可置底 Bottom）。");
            ps.Add(pdock);

            PropSpec ph = PropSpec.Int("h", Designer.T("Height", "高度 (Height)"));
            if (f.fh <= 0) { f.fh = FormField.DefaultHFor(f.ftype); }
            ph.num = f.fh;
            ph.Step(2, 16, 200);
            ph.tip = Designer.T("Height of the tool strip in pixels.", "工具条高度（像素）。");
            ps.Add(ph);

            PropSpec ppd = PropSpec.Int("padding", Designer.T("Padding", "内边距 (Padding)"));
            ppd.num = f.padding;
            ppd.Step(1, 0, 100);
            ppd.tip = Designer.T("Inner padding in pixels.", "控件内部边距（像素）。");
            ps.Add(ppd);
        } else {
            // 停靠方式（Dock）：VS 最核心的布局属性，置顶
            List<string> dockOpts = new List<string>{
                Designer.T("None", "无 (常规)"),
                Designer.T("Top", "顶部停靠 (Top)"),
                Designer.T("Bottom", "底部停靠 (Bottom)"),
                Designer.T("Left", "左侧停靠 (Left)"),
                Designer.T("Right", "右侧停靠 (Right)"),
                Designer.T("Fill", "铺满余量 (Fill)") };
            PropSpec pdock = PropSpec.Enum("dock", Designer.T("Dock", "停靠方式 (Dock)"), dockOpts);
            pdock.num = f.dockSide;
            pdock.tip = Designer.T("Dock to container edge (Top for ToolStrip, Bottom for StatusBar, Fill to stretch).",
                "停靠到父容器边缘：顶栏选 Top 避免被遮挡，底栏选 Bottom，主内容区选 Fill 自动铺满剩余空间。");
            ps.Add(pdock);

            // 排版定位模式：Flex 流式 vs 浮动自由定位
            List<string> posOpts = new List<string>{
                Designer.T("Flow (Flex)", "流式 (Flex)"), Designer.T("Float (Absolute)", "浮动 (绝对定位)") };
            PropSpec pmode = PropSpec.Enum("position", Designer.T("Position", "定位模式 (Position)"), posOpts);
            pmode.num = f.position;
            pmode.tip = Designer.T("Flow follows parent Flex layout; Float positions freely using offsets or dock/anchors.",
                "流式参与父级 Flex 排版；浮动脱离文档流自由定位或锚定对齐。");
            ps.Add(pmode);

        // 弹性权重（仅 Flow 流式模式有效）
        if (f.position == 0) {
            PropSpec fg = PropSpec.Int("flexGrow", Designer.T("Fill / Grow", "填充撑满 (Grow)"));
            fg.num = f.flexGrow;
            fg.Step(1, 0, 10);
            fg.tip = Designer.T("Flex grow factor: set to 1 to automatically fill remaining vertical/horizontal space; 0 for fixed or auto.",
                "Flex 主轴弹性分配因子：设为 1 即可自动填满剩余空间（全流式撑满高度/宽度）；0 为固定或自适应。");
            ps.Add(fg);
        }

        // 锚点对齐（九宫格对齐，游戏HUD/悬浮窗/边缘固定）
        if (f.position == 1) {
            List<string> ancOpts = new List<string>{
                Designer.T("None", "无"), Designer.T("TopLeft", "左上角"),
                Designer.T("TopCenter", "顶部居中"), Designer.T("TopRight", "右上角"),
                Designer.T("CenterLeft", "左侧居中"), Designer.T("Center", "居中对齐"),
                Designer.T("CenterRight", "右侧居中"), Designer.T("BottomLeft", "左下角"),
                Designer.T("BottomCenter", "底部居中"), Designer.T("BottomRight", "右下角"),
                Designer.T("Stretch", "全屏铺满") };
            PropSpec anc = PropSpec.Enum("anchor", Designer.T("Anchor", "锚点对齐 (Anchor)"), ancOpts);
            anc.num = f.anchor;
            anc.tip = Designer.T("Anchors control to viewport corner or center; keeps layout stable across resolutions.",
                "锚定到视口角点或中心；游戏小地图固定右上角、血条固定左上角、快捷栏固定底部居中。");
            ps.Add(anc);

            // 自由画布：设计空间的绝对位置 / 尺寸。
            PropSpec px = PropSpec.Int("x", "X").Half();
            px.num = f.fx;
            px.Step(5, 0 - 4000, 4000);
            px.tip = Designer.T(
                "X of the control's top-left corner (pixels, relative to the design canvas/anchor).",
                "浮动定位时控件相对参考锚点的 X 偏移（像素）。");
            ps.Add(px);
            PropSpec py = PropSpec.Int("y", "Y").Half();
            py.num = f.fy;
            py.Step(5, 0 - 4000, 4000);
            py.tip = Designer.T(
                "Y of the control's top-left corner (pixels, relative to the design canvas/anchor).",
                "浮动定位时控件相对参考锚点的 Y 偏移（像素）。");
            ps.Add(py);
        }
        if (layoutMode == 1 || f.position == 1 || f.fw > 0 || f.fh > 0) {
            PropSpec pw = PropSpec.Int("w", Designer.T("Width", "宽 (W)")).Half();
            pw.num = f.fw;
            pw.Step(5, 0, 4000);
            pw.tip = Designer.T(
                "Control width in pixels (0 = auto-fit content).",
                "控件宽度（像素，0 为内容自适应）。");
            ps.Add(pw);
            PropSpec phh = PropSpec.Int("h", Designer.T("Height", "高 (H)")).Half();
            phh.num = f.fh;
            phh.Step(5, 0, 4000);
            phh.tip = Designer.T(
                "Control height in pixels (0 = auto-fill remaining height when Fill/Grow > 0).",
                "控件高度（像素）。全流式排版下设为 0 且 Fill/Grow=1 即可自动撑满容器剩余高度。");
            ps.Add(phh);

            // 盒模型快捷属性（Margin 外边距 / Padding 内边距）
            PropSpec pmg = PropSpec.Int("margin", Designer.T("Margin", "外边距")).Half();
            pmg.num = f.margin;
            pmg.Step(1, 0, 200);
            pmg.tip = Designer.T("Outer spacing in pixels around the control.", "控件外围边距（像素）。");
            ps.Add(pmg);

            PropSpec ppd = PropSpec.Int("padding", Designer.T("Padding", "内边距")).Half();
            ppd.num = f.padding;
            ppd.Step(1, 0, 200);
            ppd.tip = Designer.T("Inner padding in pixels.", "控件内部边距（像素）。");
            ps.Add(ppd);

            if (FormField.IsContainerOf(f.ftype)) {
                PropSpec pgp = PropSpec.Int("gap", Designer.T("Gap", "子间距 (Gap)"));
                pgp.num = f.gap;
                pgp.Step(1, 0, 100);
                pgp.tip = Designer.T("Spacing in pixels between child controls.", "容器内部子控件之间的间距（像素）。");
                ps.Add(pgp);

                List<string> dirOpts = new List<string>{
                    Designer.T("Column (Vertical)", "纵向排列 (Column)"),
                    Designer.T("Row (Horizontal)", "横向排列 (Row)") };
                PropSpec pdir = PropSpec.Enum("flexDir", Designer.T("Direction", "排列方向"), dirOpts);
                pdir.num = f.flexDir;
                pdir.tip = Designer.T("Child flow direction: Column (vertical stacked) or Row (horizontal side-by-side).",
                    "子控件流向：纵向堆叠（常规表单/列表）或横向并排（操作栏/工具排）。");
                ps.Add(pdir);

                List<string> jusOpts = new List<string>{
                    Designer.T("Start", "起始对齐 (Start)"),
                    Designer.T("Center", "居中对齐 (Center)"),
                    Designer.T("End", "末尾对齐 (End)"),
                    Designer.T("Space Between", "两端分散 (Space Between)") };
                PropSpec pjus = PropSpec.Enum("justify", Designer.T("Justify", "主轴对齐"), jusOpts).Half();
                pjus.num = f.justify;
                pjus.tip = Designer.T("Main-axis child alignment.", "子控件在主轴上的对齐与间距分配方式。");
                ps.Add(pjus);

                List<string> aliOpts = new List<string>{
                    Designer.T("Start", "起始对齐 (Start)"),
                    Designer.T("Center", "居中对齐 (Center)"),
                    Designer.T("End", "末尾对齐 (End)"),
                    Designer.T("Stretch", "拉伸铺满 (Stretch)") };
                PropSpec pali = PropSpec.Enum("alignItems", Designer.T("Align Items", "交叉轴对齐"), aliOpts).Half();
                pali.num = f.alignItems;
                pali.tip = Designer.T("Cross-axis child alignment.", "子控件在交叉轴（垂直于主轴方向）上的对齐方式。");
                ps.Add(pali);

                PropSpec pwr = PropSpec.Bool("flexWrap", Designer.T("Wrap", "自动换行"));
                pwr.flag = f.flexWrap;
                pwr.tip = Designer.T("Wrap children to next line when exceeding container width.", "超出容器宽度时自动折行排列。");
                ps.Add(pwr);
            }
        } else {
            // 24 列网格上的字段宽度。
            PropSpec sp = PropSpec.Int("span", Designer.T("Span / 24", "跨度 / 24"));
            sp.num = f.span;
            sp.Step(1, 1, 24);
            sp.tip = Designer.T(
                "How many of the 24 grid columns this field occupies (1-24); larger span = wider control. Responsive grid layout.",
                "该字段在 24 列网格中占几列（1-24）；跨度越大控件越宽。用于响应式栅格布局。");
            ps.Add(sp);
        }
        }

        // 3. 数据与绑定 (VS 数据大类)
        ps.Add(PropSpec.Section(Designer.T("DATA", "数据与绑定")));
        string bindLbl = Designer.T("Bind path", "绑定路径");
        if (f.ftype == 23 || f.ftype == 41) { bindLbl = Designer.T("Data source", "数据源"); }
        PropSpec bd = PropSpec.Text("bind", bindLbl);
        bd.str = f.bindPath;
        bd.tip = Designer.T(
            "Two-way data-binding path; the control's value stays in sync with this variable.",
            "双向数据绑定的字段路径，控件值与该变量自动同步。");
        ps.Add(bd);
        PropSpec bpr = PropSpec.Text("bindProp", Designer.T("Bind prop", "绑定属性"));
        bpr.str = f.bindProp;
        bpr.tip = Designer.T(
            "Which property to bind (e.g. text/value/checked); empty uses the default.",
            "绑定到控件的哪个属性（如 text/value/checked），留空用默认属性。");
        ps.Add(bpr);
        if (f.ftype == 23 || f.ftype == 41) {
            PropSpec ofr = PropSpec.Text("of",
                Designer.T("Row entity (of)", "行实体 (of)"));
            ofr.str = ofEd;
            ofr.tip = Designer.T(
                "Row entity type for declarative columns; column accessors read its fields (required for typed/editable columns).",
                "声明式列的行实体类型；列访问器读取它的字段（列配了类型/可编辑时必填）。");
            ps.Add(ofr);
        }

        // 4. 行为与状态 (VS 行为大类)
        ps.Add(PropSpec.Section(Designer.T("BEHAVIOR", "行为与状态")));
        PropSpec dis = PropSpec.Bool("disabled", Designer.T("Disabled", "禁用状态"));
        dis.flag = f.disabled;
        dis.tip = Designer.T("Disable user interaction with this control.", "禁用该控件的用户交互。");
        ps.Add(dis);

        PropSpec vis = PropSpec.Bool("visible", Designer.T("Visible", "是否可见"));
        vis.flag = f.visible;
        vis.tip = Designer.T("Initial visibility of this control.", "控件初始是否可见。");
        ps.Add(vis);

        PropSpec ttp = PropSpec.Text("tooltip", Designer.T("Tooltip", "气泡提示 (Tooltip)"));
        ttp.str = f.tooltipText;
        ttp.tip = Designer.T("Hover tooltip text displayed for this control.", "鼠标悬停在控件上时显示的提示文本。");
        ps.Add(ttp);

        // 必填校验只适用于数据输入型组件，栏条与容器坚决不展示
        if (IsInputWidget(f)) {
            PropSpec req = PropSpec.Bool("required", Designer.T("Required", "必填校验"));
            req.flag = f.required;
            req.tip = Designer.T(
                "Mark as required: form validation rejects an empty value here.",
                "标记为必填：表单校验时该项不能为空。");
            ps.Add(req);
        }
        if (f.ftype == 15 || f.ftype == 16) {
            PropSpec wr = PropSpec.Bool("wrap", Designer.T("Wrap text", "自动换行"));
            wr.flag = f.wrap;
            wr.tip = Designer.T(
                "Wrap long text onto multiple lines instead of clipping it.",
                "文本超出宽度时自动换行，而不是截断。");
            ps.Add(wr);
        }
        if (f.kind == "Tabs") {
            List<string> orbOpts = new List<string>{
                Designer.T("Horizontal", "横向"), Designer.T("Vertical", "纵向") };
            PropSpec orb = PropSpec.Enum("orient", Designer.T("Tab bar", "标签条方向"), orbOpts);
            orb.num = f.tabOrient;
            orb.tip = Designer.T(
                "Place the tab header across the top or along the left side; the page area yields the rail accordingly.",
                "标签条横排在顶部，或纵排在左侧；页面区相应让出轨道宽度。");
            ps.Add(orb);

            int tabCnt = f.OptionCount();
            if (tabCnt < 1) { tabCnt = 1; }
            List<string> pgOpts = new List<string>();
            for (int pi = 0; pi < tabCnt; pi = pi + 1) {
                pgOpts.Add(Convert.ToString(pi + 1) + ". " + Designer.TabPageTitle(f, pi));
            }
            PropSpec curPg = PropSpec.Enum("activePage", Designer.T("Active page", "当前活动页"), pgOpts);
            int curIdx = f.uiState.Get();
            if (curIdx < 0 || curIdx >= tabCnt) { curIdx = 0; }
            curPg.num = curIdx;
            curPg.tip = Designer.T(
                "Currently displayed tab page in designer; child controls will be placed in this page.",
                "设计器中当前激活展示的选项卡页面；新拖放或粘贴的子控件将放入此页面中。");
            ps.Add(curPg);
        }
        if (f.ftype == 7) {
            PropSpec don = PropSpec.Bool("defOn", Designer.T("Default on", "默认开启"));
            don.flag = f.defOn;
            ps.Add(don);
        }
        // 挂上默认值（VS 的"恢复默认值"）：以同类型干净实例为准。
        DesignerDefaults.Apply(ps, f);
        return ps;
    }

    // 颜色行建器：给行配一个真取色器（ColorPicker）。色块就是
    // 它的触发条——皮肤透明底 + 当前色，点开是 SV 面板 + 色相/
    // 透明度条 + RGBA/HEX/HSL/HSB 输入行（Naive UI n-color-picker
    // 那套）。初值取当前文本；非字面色（var(--x) 等）解析不出就
    // 留在黑色，等用户自己挑。
    void InitColorPicker(CompPropEditRow er, string curVal) {
        ColorPicker cp = new ColorPicker(0xFF000000);
        cp.Mode = "hex";
        Color c = Designer.ParseColorValue(curVal);
        if (!c.IsNone()) {
            cp.SetColor(c.ToARGB());
        }
        er.cpick = cp;
        er.cpickVal = cp.Value();
    }

    // 颜色属性行：文本框 + 真取色器色块。
    // 两条写回路径：
    //   文本 → 属性：用户手改文本（文本是权威，解析不出就只更新
    //     文本，不动取色器）。
    //   取色器 → 属性：用户在弹层里拖了色盘，取色器模型值变了，
    //     把它翻成 CSS 颜色文本写回。靠每帧比对模型值发现，不用
    //     事件——弹层在覆盖阶段绘制，事件要等下一帧才到。
    void RenderColorPropRow(App app, Canvas c, FormField f, CompPropEditRow er,
                             int ix, int iy, int iw, int labelW, int rowH,
                             string gate) {
        int swatchW = app.Scale(28);
        int inpW = iw - labelW - swatchW - app.Scale(4);
        er.input.Render(app, ix + labelW, iy, inpW, rowH);
        int sx = ix + labelW + inpW + app.Scale(4);
        ColorPicker cp = er.cpick;
        if (cp == null) { return; }
        string cur = er.input.GetText();
        Color parsed = Designer.ParseColorValue(cur);
        bool literal = !parsed.IsNone();
        if (cur != er.shadow && literal) {
            cp.SetColor(parsed.ToARGB());
            er.cpickVal = cp.Value();
        }
        int pv = cp.Value();
        if (pv != er.cpickVal) {
            er.cpickVal = pv;
            cur = Designer.ColorValueText(pv);
            er.input.SetText(cur);
        }
        // 色块 = 取色器触发条（透明底 + 当前色圆角块）。
        cp.RenderIn(app, sx, iy, swatchW, rowH);
        if (!literal) {
            // 非字面色（var(--x) / 命名色等）：斜杠标记"这不是字面
            // 颜色"，免得色块上那点旧色被当成真值。
            c.DrawLine(sx + app.Scale(3), iy + app.Scale(3),
                       sx + swatchW - app.Scale(3), iy + rowH - app.Scale(3),
                       Style.Part(app, "designer", "field", "", "", "",
                                  Style.SNormal()).BorderOr(0), app.Scale(1));
        }
        if (cur != er.shadow) {
            this.GateInspectorUndo(gate);
            SetCompPropValue(f, er.key, cur);
            this.MarkDocDirty();
            er.shadow = cur;
            app.RequestRedraw();
        }
    }

    // 选中组件的属性选项卡（不含事件——它们在事件选项卡）。
    // 属性行交给 PropertyGrid，这里只处理绑定选择器、选项表
    // 这些语义动作。返回最后一行之后的 y，供主体滚动。
}
