using Gui.Backend;
using Gui.Component;
using Gui.Widget;
using Gui;
using System.Collections.Generic;
using System.Json;
using System;

namespace Gui.Designer;

public class ColumnConfig {
    public int width;
    public int align;      // 0 = 缺省/左, 1 = 中, 2 = 右
    public int type;       // 0 = 缺省/文本, 1 = num, 2 = real, 3 = bool, 4 = date
    public bool sortable;
    public bool resizable;
    public bool editable;
    public int decimals;
    public string money;
    public bool percent;
    public string prefix;
    public string suffix;
    public bool grouped;
    public int summary;    // 0 = 无, 1 = sum, 2 = avg, 3 = min, 4 = max, 5 = count
    public int pin;        // 0 = 无, 1 = left, 2 = right
    public string band;
    public string click;

    public ColumnConfig() {
        this.width = 0;
        this.align = 0;
        this.type = 0;
        this.sortable = true;
        this.resizable = true;
        this.editable = false;
        this.decimals = 2;
        this.money = "";
        this.percent = false;
        this.prefix = "";
        this.suffix = "";
        this.grouped = false;
        this.summary = 0;
        this.pin = 0;
        this.band = "";
        this.click = "";
    }

    // 从原始 JsonValue 对象反序列化并构造 ColumnConfig 强类型实体。
    static ColumnConfig FromJson(JsonValue e) {
        ColumnConfig cfg = new ColumnConfig();
        if (e == null || !e.IsObject()) { return cfg; }
        cfg.width = e.Int("width", 0);
        string al = e.Str("align", "");
        if (al == "center") { cfg.align = 1; }
        else if (al == "right") { cfg.align = 2; }
        string tp = e.Str("type", "");
        if (tp == "num") { cfg.type = 1; }
        else if (tp == "real") { cfg.type = 2; }
        else if (tp == "bool") { cfg.type = 3; }
        else if (tp == "date") { cfg.type = 4; }
        JsonValue sv = e.Get("sortable");
        if (sv != null && sv.IsBool()) { cfg.sortable = sv.AsBool(true); }
        JsonValue rv = e.Get("resizable");
        if (rv != null && rv.IsBool()) { cfg.resizable = rv.AsBool(true); }
        JsonValue ev = e.Get("editable");
        if (ev != null && ev.IsBool()) { cfg.editable = ev.AsBool(false); }
        cfg.decimals = e.Int("decimals", 2);
        cfg.money = e.Str("money", "");
        JsonValue pv = e.Get("percent");
        if (pv != null && pv.IsBool()) { cfg.percent = pv.AsBool(false); }
        cfg.prefix = e.Str("prefix", "");
        cfg.suffix = e.Str("suffix", "");
        JsonValue gv = e.Get("grouped");
        if (gv != null && gv.IsBool()) { cfg.grouped = gv.AsBool(false); }
        if (Designer.ColBool(e, "sum")) { cfg.summary = 1; }
        else if (Designer.ColBool(e, "avg")) { cfg.summary = 2; }
        else if (Designer.ColBool(e, "min")) { cfg.summary = 3; }
        else if (Designer.ColBool(e, "max")) { cfg.summary = 4; }
        else if (Designer.ColBool(e, "count")) { cfg.summary = 5; }
        string pin = e.Str("pin", "");
        if (pin == "left") { cfg.pin = 1; }
        else if (pin == "right") { cfg.pin = 2; }
        cfg.band = e.Str("band", "");
        cfg.click = e.Str("click", "");
        return cfg;
    }

    // 将 ColumnConfig 强类型实体导出为落盘属性字典（不存默认值，保持最小体积）。
    JsonValue ToJsonObject() {
        JsonValue o = JsonValue.NewObject();
        if (this.width > 0) {
            o.Set("width", JsonValue.NewNum(Convert.ToString(this.width)));
        }
        if (this.align == 1) { o.Set("align", JsonValue.NewStr("center")); }
        else if (this.align == 2) { o.Set("align", JsonValue.NewStr("right")); }
        if (this.type == 1) { o.Set("type", JsonValue.NewStr("num")); }
        else if (this.type == 2) { o.Set("type", JsonValue.NewStr("real")); }
        else if (this.type == 3) { o.Set("type", JsonValue.NewStr("bool")); }
        else if (this.type == 4) { o.Set("type", JsonValue.NewStr("date")); }
        if (!this.sortable) { o.Set("sortable", JsonValue.NewBool(false)); }
        if (!this.resizable) { o.Set("resizable", JsonValue.NewBool(false)); }
        if (this.editable) { o.Set("editable", JsonValue.NewBool(true)); }
        if (this.type == 2 && this.decimals != 2) {
            o.Set("decimals", JsonValue.NewNum(Convert.ToString(this.decimals)));
        }
        if (StyleSheet.Trim(this.money) != "") {
            o.Set("money", JsonValue.NewStr(StyleSheet.Trim(this.money)));
        }
        if (this.percent) { o.Set("percent", JsonValue.NewBool(true)); }
        if (StyleSheet.Trim(this.prefix) != "") {
            o.Set("prefix", JsonValue.NewStr(StyleSheet.Trim(this.prefix)));
        }
        if (StyleSheet.Trim(this.suffix) != "") {
            o.Set("suffix", JsonValue.NewStr(StyleSheet.Trim(this.suffix)));
        }
        if (this.grouped) { o.Set("grouped", JsonValue.NewBool(true)); }
        if (this.summary == 1) { o.Set("sum", JsonValue.NewBool(true)); }
        else if (this.summary == 2) { o.Set("avg", JsonValue.NewBool(true)); }
        else if (this.summary == 3) { o.Set("min", JsonValue.NewBool(true)); }
        else if (this.summary == 4) { o.Set("max", JsonValue.NewBool(true)); }
        else if (this.summary == 5) { o.Set("count", JsonValue.NewBool(true)); }
        if (this.pin == 1) { o.Set("pin", JsonValue.NewStr("left")); }
        else if (this.pin == 2) { o.Set("pin", JsonValue.NewStr("right")); }
        if (StyleSheet.Trim(this.band) != "") {
            o.Set("band", JsonValue.NewStr(StyleSheet.Trim(this.band)));
        }
        if (StyleSheet.Trim(this.click) != "") {
            o.Set("click", JsonValue.NewStr(StyleSheet.Trim(this.click)));
        }
        return o;
    }
}

public class CompPropDecl {
    public string key;
    public string label;
    public string def;

    public CompPropDecl(string key, string label, string def) {
        this.key = key != null ? key : "";
        this.label = label != null ? label : "";
        this.def = def != null ? def : "";
    }
}

public class CompPropEditRow {
    public string key;
    public string label;
    public bool isBool;
    public bool isEnum;
    public bool isIcon;
    public bool isAsset;
    public bool isColor;
    public Input input;
    public Switch sw;
    public SelectBox pick;
    public string shadow;
    // 颜色行的真取色器（色块即它的触发条）：点开是 SV 面板 +
    // 色相/透明度条 + RGBA/HEX/HSL/HSB 输入行。
    public ColorPicker cpick;
    // 取色器当前模型值（打包 0xAARRGGBB）。每帧与取色器比对，
    // 变了就说明用户在弹层里改了色——写回属性值靠它，不靠事件
    // （弹层在覆盖阶段绘制，事件要等下一帧才到）。
    public int cpickVal;
    public PropKind propKind;
    public PropValueKind propValueKind;
    public string propText;
    public int propNumber;
    public bool propFlag;
    public FormField docField;
    public string docKey;
    public string docDefault;
    public bool docHasDefault;
    public List<string> docOptions;

    public string DocText {
        get { return this.ReadDocValue(); }
        set { this.WriteDocValue(value); }
    }

    public int DocNumber {
        get { return this.ReadDocNumber(); }
        set { this.WriteDocNumber(value); }
    }

    public bool DocFlag {
        get { return PropSpec.IsOn(this.ReadDocValue()); }
        set { this.WriteDocValue(value ? "true" : "false"); }
    }

    private string ReadDocValue() {
        if (docField == null || docKey == "") { return docHasDefault ? docDefault : ""; }
        JsonValue extra = docField.extra;
        if (extra == null) { return docHasDefault ? docDefault : ""; }
        JsonValue props = extra.Get("props");
        if (props == null || !props.IsObject() || !props.Has(docKey)) {
            return docHasDefault ? docDefault : "";
        }
        return props.Str(docKey, "");
    }

    private int ReadDocNumber() {
        string value = this.ReadDocValue();
        if (propKind == PropKind.Enum && propValueKind != PropValueKind.Int) {
            for (int i = 0; i < docOptions.Count; i = i + 1) {
                if (docOptions[i] == value) { return i; }
            }
            return 0;
        }
        return PropSpec.IsIntText(value) ? Convert.ToInt32(value) : 0;
    }

    private void WriteDocValue(string value) {
        if (docField == null || docKey == "") { return; }
        if (docField.extra == null) { docField.extra = JsonValue.NewObject(); }
        JsonValue props = docField.extra.Get("props");
        if (props == null || !props.IsObject()) {
            props = JsonValue.NewObject();
            docField.extra.Set("props", props);
        }
        props.Set(docKey, JsonValue.NewStr(value != null ? value : ""));
    }

    private void WriteDocNumber(int value) {
        if (propKind == PropKind.Enum && propValueKind != PropValueKind.Int) {
            if (value >= 0 && value < docOptions.Count) {
                this.WriteDocValue(docOptions[value]);
            }
            return;
        }
        this.WriteDocValue(Convert.ToString(value));
    }

    public CompPropEditRow(string key, string label, bool isBool, Input input, Switch sw, string shadow) {
        this.key = key != null ? key : "";
        this.label = label != null ? label : "";
        this.isBool = isBool;
        this.isEnum = false;
        this.isIcon = false;
        this.isAsset = false;
        this.isColor = false;
        this.input = input;
        this.sw = sw;
        this.pick = null;
        this.shadow = shadow != null ? shadow : "";
        this.cpick = null;
        this.cpickVal = 0;
        this.propKind = PropKind.Text;
        this.propValueKind = PropValueKind.Text;
        this.propText = "";
        this.propNumber = 0;
        this.propFlag = false;
        this.docField = null;
        this.docKey = "";
        this.docDefault = "";
        this.docHasDefault = false;
        this.docOptions = new List<string>();
    }

}

public class DesignMoveStart {
    public FormField field;
