using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Backend;

namespace Gui.Designer;

public class TabHeaderHit {
    public FormField tabs;
    public int page;
    public int x;
    public int y;
    public int w;
    public int h;

    public TabHeaderHit(FormField tabs, int page, int x, int y, int w, int h) {
        this.tabs = tabs;
        this.page = page;
        this.x = x;
        this.y = y;
        this.w = w;
        this.h = h;
    }
}

// 作者字段与真实预览控件的映射；原点取自运行时父内容框。
