using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Backend;

namespace Gui.Designer;

public class MultiResizeItem {
    public FormField field;
    public int x;
    public int y;
    public int w;
    public int h;
    public MultiResizeItem(FormField field, int x, int y, int w, int h) {
        this.field = field;
        this.x = x;
        this.y = y;
        this.w = w;
        this.h = h;
    }
}

