using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Backend;

namespace Gui.Designer;

public class PreviewControlCache {
    public string key;
    public Control control;

    public PreviewControlCache(string key, Control control) {
        this.key = key != null ? key : "";
        this.control = control;
    }
}

