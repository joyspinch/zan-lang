using System;
using Gui;
using Gui.Widget;
namespace Gui.Designer;

class DesignerRibbonAction {
    public weak Designer Owner;
    public weak Ribbon Ribbon;
    public weak App Host;
    public List<string> Commands;
    public void Run() {
        Designer designer = Owner;
        Ribbon ribbon = Ribbon;
        App app = Host;
        if (designer == null || ribbon == null || app == null) { return; }
        int index = ribbon.lastAct;
        if (index >= 0 && index < Commands.Count) { designer.RunRibbon(app, Commands[index]); }
    }
}
