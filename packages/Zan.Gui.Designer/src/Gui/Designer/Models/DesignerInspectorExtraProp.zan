using Gui;
using Gui.Widget;

namespace Gui.Designer;

// Component declarations and builtin picker bridges have their own retained editors.
// Builtin typed property values remain exclusively owned by FieldSpecs/PropertyGrid.
public class DesignerInspectorExtraProp {
    internal string key;
    internal string fallback;
    internal string shadow;
    internal Flex root;
    internal Input input;
    internal Switch toggle;
    internal SelectBox select;
    internal ColorPicker color;
    internal bool builtin;
    internal int colorShadow;
    internal bool iconPickerPending;
    internal DesignerInspectorExtraAction action;
}
