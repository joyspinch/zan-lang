using System;
using Gui;
using Gui.Widget;

namespace Gui.Designer;

// Menu configuration borrows its business owner; each instance keeps its opening target.
class DesignerMenu : ContextMenu {
    public weak Designer Owner;
    public int MenuKind;
    public weak App Host;
    public FormField Target;
    public List<FormField> Targets;
    public List<string> Commands;

    public DesignerMenu() {
        DesignerMenuAction action = new DesignerMenuAction();
        action.Owner = this;
        ActionSelected.AddS(action.Run);
    }

    public override void OnPopupDismissed() {
        base.OnPopupDismissed();
        Designer owner = Owner;
        if (owner != null) { owner.DesignerMenuClosed(this); }
    }
}
