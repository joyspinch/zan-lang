using System;
using Gui;

namespace Gui.Designer;

class DesignerMenuAction {
    public weak DesignerMenu Owner;
    public void Run(Control sender) {
        DesignerMenu menu = Owner;
        if (menu == null) { return; }
        Designer designer = menu.Owner;
        if (designer != null) { designer.DesignerMenuSelected(menu); }
    }
}
