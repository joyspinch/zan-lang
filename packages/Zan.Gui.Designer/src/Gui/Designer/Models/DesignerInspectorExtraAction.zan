using Gui;

namespace Gui.Designer;

// Subscriptions and delayed actions borrow every endpoint, including their sender.
public class DesignerInspectorExtraAction {
    internal weak Designer owner;
    internal weak UiViewScope scope;
    internal weak FormField target;
    internal weak Control sender;
    internal weak Control section;
    internal int epoch;
    internal int keySequence;
    internal int category;
    internal int sectionEpoch;
    internal int index;
    internal string command;
    internal string value;

    public void Run() {
        Designer current = owner;
        UiViewScope view = scope;
        if (current != null && view != null && view.IsActive()) {
            current.InvokeInspectorExtraAction(this);
        }
    }
}
