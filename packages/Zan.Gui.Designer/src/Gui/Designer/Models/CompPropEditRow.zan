using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Backend;

namespace Gui.Designer;

public class CompPropEditRow {
    public string key;
    public string label;
    public bool isBool;
    public bool isEnum;
    public bool isIcon;
    public bool isAsset;
    public bool isColor;
    public Input input;
    public Switch sw;
    public SelectBox pick;
    public string shadow;
    // 颜色行的真取色器（色块即它的触发条）：点开是 SV 面板 +
    // 色相/透明度条 + RGBA/HEX/HSL/HSB 输入行。
    public ColorPicker cpick;
    // 取色器当前模型值（打包 0xAARRGGBB）。每帧与取色器比对，
    // 变了就说明用户在弹层里改了色——写回属性值靠它，不靠事件
    // （弹层在覆盖阶段绘制，事件要等下一帧才到）。
    public int cpickVal;

    public CompPropEditRow(string key, string label, bool isBool, Input input, Switch sw, string shadow) {
        this.key = key != null ? key : "";
        this.label = label != null ? label : "";
        this.isBool = isBool;
        this.isEnum = false;
        this.isIcon = false;
        this.isAsset = false;
        this.isColor = false;
        this.input = input;
        this.sw = sw;
        this.pick = null;
        this.shadow = shadow != null ? shadow : "";
        this.cpick = null;
        this.cpickVal = 0;
    }
}
