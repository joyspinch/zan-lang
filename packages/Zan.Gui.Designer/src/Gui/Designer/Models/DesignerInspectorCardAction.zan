using Gui;
using Gui.Widget;

namespace Gui.Designer;

// Like UiViewActions, a persistent subscription borrows its view and sender.
// The Cards generation additionally fences target/selection changes within that view.
public class DesignerInspectorCardAction {
    internal weak Designer owner;
    internal weak UiViewScope view;
    internal weak FormField target;
    internal weak Button sender;
    internal int generation;
    internal int keySequence;
    internal string command;
    internal int value;

    public void Run() {
        Designer current = owner;
        UiViewScope scope = view;
        if (current != null && scope != null && scope.IsActive()) {
            current.InvokeInspectorCardAction(this);
        }
    }
}
