using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Backend;

namespace Gui.Designer;

public class CompPropDecl {
    public string key;
    public string label;
    public string def;

    public CompPropDecl(string key, string label, string def) {
        this.key = key != null ? key : "";
        this.label = label != null ? label : "";
        this.def = def != null ? def : "";
    }
}
