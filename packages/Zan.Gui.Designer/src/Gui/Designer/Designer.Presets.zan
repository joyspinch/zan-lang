using System;
using System.Collections.Generic;
using System.Json;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Backend;
using Gui.Markup;

namespace Gui.Designer;

partial class Designer {
    void InsertStarterPreset(int presetId) {
        if (presetId < 1 || presetId > 4) { return; }
        this.PushUndo();
        this.DropDeadRefs();
        FormField targetParent = activeContainer;
        if (targetParent == null && sel != null && FormField.IsContainerOf(sel.ftype)) {
            targetParent = sel;
        }

        if (presetId == 1) {
            // 三行网格由 CSS 分配剩余空间，工具栏和状态栏不参与几何手算。
            FormField shell = FormField.New(45, seq); seq = seq + 1;
            shell.label = Designer.T("Application Layout", "主窗口布局");
            shell.fw = 0; shell.fh = 0; shell.span = 0;
            shell.dockSide = 5;
            shell.styleText = "position:absolute;left:0;top:0;right:0;bottom:0;"
                + "display:grid;grid-template-columns:minmax(0,1fr);"
                + "grid-template-rows:34px minmax(0,1fr) 24px;padding:0;gap:0";
            FormField tb = FormField.New(58, seq); seq = seq + 1;
            tb.label = Designer.T("Toolbar", "工具栏");
            tb.dockSide = 0;
            tb.span = 0;
            tb.position = 0;
            tb.fh = 34;
            tb.fw = 0;
            tb.styleText = "grid-column:1;grid-row:1;height:34px;min-width:0;min-height:0";
            tb.options = new List<string>();
            tb.options.Add(Designer.T("New", "新建"));
            tb.options.Add(Designer.T("Open", "打开"));
            tb.options.Add(Designer.T("Save", "保存"));
            tb.options.Add("|");
            tb.options.Add(Designer.T("Run", "运行"));

            FormField content = FormField.New(45, seq); seq = seq + 1;
            content.label = Designer.T("Main Content", "主内容区");
            content.dockSide = 0;
            content.span = 0;
            content.position = 0;
            content.styleText = "grid-column:1;grid-row:2;min-width:0;min-height:0;"
                + "display:flex;flex-direction:column;padding:12px;gap:8px";
            content.flexGrow = 1;
            content.fh = 0;
            content.fw = 0;
            content.flexDir = 0; // Col
            content.padding = 12;
            content.gap = 8;

            FormField card = FormField.New(18, seq); seq = seq + 1;
            card.label = Designer.T("Workspace Card", "工作区面板");
            card.flexGrow = 1;
            card.fw = 0;
            card.fh = 0;
            card.span = 0;
            card.styleText = "flex-grow:1;min-width:0;min-height:0";
            content.kids.Add(card);

            FormField sb = FormField.New(59, seq); seq = seq + 1;
            sb.label = Designer.T("Ready", "就绪");
            sb.dockSide = 0;
            sb.span = 0;
            sb.position = 0;
            sb.fh = 24;
            sb.fw = 0;
            sb.styleText = "grid-column:1;grid-row:3;height:24px;min-width:0;min-height:0";
            shell.kids.Add(tb);
            shell.kids.Add(content);
            shell.kids.Add(sb);
            if (targetParent != null) {
                targetParent.kids.Add(shell);
            } else {
                fields.Add(shell);
            }
            sel = content;
            activeContainer = content;
            msg = Designer.T("Inserted: Classic App Skeleton", "已插入: 经典主窗口骨架 (Toolbar + Content + StatusBar)");
        } else if (presetId == 2) {
            // 左右双栏工作台 (Sidebar Left + Workspace Fill)
            FormField split = FormField.New(45, seq); seq = seq + 1;
            split.label = Designer.T("Workspace Container", "分栏工作区");
            split.dockSide = 5;
            split.span = 0;
            split.position = 0;
            split.styleText = "position:absolute;left:0;top:0;right:0;bottom:0;"
                + "display:grid;grid-template-columns:220px minmax(0,1fr);"
                + "grid-template-rows:minmax(0,1fr);padding:0;gap:0";
            split.flexGrow = 1;
            split.fh = 0;
            split.fw = 0;
            split.flexDir = 1; // Row
            split.padding = 0;
            split.gap = 0;

            FormField side = FormField.New(45, seq); seq = seq + 1;
            side.label = Designer.T("Sidebar", "侧边栏");
            side.dockSide = 0;
            side.span = 0;
            side.position = 0;
            side.fw = 220;
            side.fh = 0;
            side.styleText = "grid-column:1;grid-row:1;width:220px;min-width:0;min-height:0;"
                + "display:flex;flex-direction:column;padding:10px;gap:6px";
            side.flexGrow = 0;
            side.flexDir = 0; // Col
            side.padding = 10;
            side.gap = 6;

            FormField navLbl = FormField.New(15, seq); seq = seq + 1;
            navLbl.label = Designer.T("Navigation", "导航目录");
            navLbl.fw = 0;
            navLbl.span = 0;
            navLbl.fh = 24;
            side.kids.Add(navLbl);

            FormField navTree = FormField.New(25, seq); seq = seq + 1;
            navTree.flexGrow = 1;
            navTree.span = 0;
            navTree.fh = 0;
            navTree.styleText = "height:auto;flex-grow:1;min-height:0";
            side.kids.Add(navTree);

            FormField mainArea = FormField.New(45, seq); seq = seq + 1;
            mainArea.label = Designer.T("Main View", "主视口");
            mainArea.dockSide = 0;
            mainArea.span = 0;
            mainArea.position = 0;
            mainArea.styleText = "grid-column:2;grid-row:1;min-width:0;min-height:0;"
                + "display:flex;flex-direction:column;padding:16px;gap:12px";
            mainArea.fw = 0;
            mainArea.fh = 0;
            mainArea.flexGrow = 1;
            mainArea.flexDir = 0; // Col
            mainArea.padding = 16;
            mainArea.gap = 12;

            split.kids.Add(side);
            split.kids.Add(mainArea);

            if (targetParent != null) {
                targetParent.kids.Add(split);
            } else {
                fields.Add(split);
            }
            sel = split;
            activeContainer = mainArea;
            msg = Designer.T("Inserted: Split Workspace", "已插入: 左右双栏工作区 (Sidebar + Main View)");
        } else if (presetId == 3) {
            // 标准水平表单行 (Label + Input Fill + Action Button)
            FormField row = FormField.New(45, seq); seq = seq + 1;
            row.label = Designer.T("Form Row", "表单行");
            row.position = 0;
            row.fh = 36;
            row.fw = 0;
            row.flexDir = 1; // Row
            row.alignItems = 1; // Center
            row.padding = 4;
            row.gap = 8;

            FormField lbl = FormField.New(15, seq); seq = seq + 1;
            lbl.label = Designer.T("Field Name:", "配置字段:");
            lbl.fw = 80;
            lbl.fh = 24;

            FormField inp = FormField.New(0, seq); seq = seq + 1;
            inp.placeholder = Designer.T("Please enter value...", "请输入内容...");
            inp.fw = 0;
            inp.fh = 28;
            inp.flexGrow = 1; // 填满行宽度

            FormField btn = FormField.New(15, seq); seq = seq + 1;
            btn.label = Designer.T("Apply", "确认操作");
            btn.fw = 76;
            btn.fh = 28;

            row.kids.Add(lbl);
            row.kids.Add(inp);
            row.kids.Add(btn);

            if (targetParent != null) {
                targetParent.kids.Add(row);
            } else {
                fields.Add(row);
            }
            sel = row;
            msg = Designer.T("Inserted: Standard Form Row", "已插入: 标准表单行 (Label + Input Fill + Button)");
        } else if (presetId == 4) {
            // 对话框底部操作栏 (ActionBar Bottom + Right-aligned Cancel/OK Buttons)
            FormField bar = FormField.New(45, seq); seq = seq + 1;
            bar.label = Designer.T("Dialog Actions", "底部操作栏");
            bar.dockSide = 2; // Bottom
            bar.position = 0;
            bar.fh = 46;
            bar.fw = 0;
            bar.flexDir = 1; // Row
            bar.justify = 2; // End (靠右)
            bar.alignItems = 1; // Center
            bar.padding = 8;
            bar.gap = 8;

            FormField btnCancel = FormField.New(15, seq); seq = seq + 1;
            btnCancel.label = Designer.T("Cancel", "取消");
            btnCancel.fw = 72;
            btnCancel.fh = 28;

            FormField btnOk = FormField.New(15, seq); seq = seq + 1;
            btnOk.label = Designer.T("OK", "确定");
            btnOk.fw = 72;
            btnOk.fh = 28;

            bar.kids.Add(btnCancel);
            bar.kids.Add(btnOk);

            if (targetParent != null) {
                targetParent.kids.Add(bar);
            } else {
                fields.Add(bar);
            }
            sel = bar;
            msg = Designer.T("Inserted: Dialog Action Buttons", "已插入: 对话框底部操作栏 (Cancel + OK)");
        }
        this.MarkDocDirty();
        App app = this.hostApp;
        if (app != null) { app.RequestRedraw(); }
    }

}
