using System;
using Gui.Widget;
using Gui;
using System.Json;

namespace Gui.Designer;

partial class Designer {
    int RenderFieldProps(App app, Canvas c, Theme t, FormField f, int ix, int iy, int iw) {
        int fs = Style.FontFallback(app, "small");

        // 委托高频快捷操作栏与多选/停靠/排版卡片
        iy = this.RenderInspectorCards(app, c, t, f, ix, iy, iw);

        propGrid.Bind("fld" + Convert.ToString(inspKeySeq), this.FieldSpecs(f));
        int gh = propGrid.ContentHeight(app);
        propGrid.RenderInside(app, new Rect(ix, iy, iw, gh));
        iy = iy + gh;
        if (gh > 0) {
            iy = iy + app.Scale(8);
        }
        // 名称是代码后置的变量名：与其它组件重名会生成重复字段，
        // 等到编译才报错。PropertyGrid 已经把新名字写进 f.fname，
        // 撞名时回退到上一个唯一名并提示。
        if (f.fname != f.name && f.fname.Length > 0 && this.UsedFieldName(f, f.fname)) {
            f.fname = f.name;
            msg = Designer.T("name already used: ", "名称已被使用：")
                + propGrid.ChangedKey() + " -> " + f.name;
            app.RequestRedraw();
        }
        if (f.name != "" && f.fname != "" && f.name != f.fname) {
            renamedOldField = f.name;
            renamedNewField = f.fname;
        }
        if (f.ftype == 59 || f.kind == "StatusBar") {
            f.dockSide = 2;
            f.position = 0;
            f.fx = 0;
            f.anchor = 0;
            if (f.fh <= 0) { f.fh = FormField.DefaultHFor(f.ftype); }
        } else if (f.ftype == 58 || f.kind == "ToolStrip") {
            if (f.dockSide == 0) { f.dockSide = 1; }
            f.position = 0;
            f.fx = 0;
            f.anchor = 0;
            if (f.fh <= 0) { f.fh = FormField.DefaultHFor(f.ftype); }
        }
        if (f.dockSide > 0 && f.position == 1) {
            // 用户显式将组件切为 Float 绝对定位时，自动重置 dockSide 为 0 (None)，解除停靠绑定
            f.dockSide = 0;
        }
        if (f.kind == "Tabs") {
            int curActive = f.uiState.Get();
            int tabCount = f.OptionCount();
            if (tabCount < 1) { tabCount = 1; }
            if (curActive < 0 || curActive >= tabCount) {
                f.uiState.Set(0);
            }
        }
        f.name = f.fname;
        if (f.span < 1) { f.span = 1; }
        if (f.span > 24) { f.span = 24; }
        // 行实体写回 extra["of"]：空值且原来也没设就不动文档。
        if (f.ftype == 23 || f.ftype == 41) {
            string ofCur = f.extra == null ? "" : f.extra.Str("of", "");
            string ofNew = StyleSheet.Trim(ofEd);
            if (ofNew != ofCur) {
                this.GateInspectorUndo("of|" + Convert.ToString(inspKeySeq));
                if (f.extra == null) { f.extra = JsonValue.NewObject(); }
                if (ofNew == "") { Designer.DropKey(f.extra, "of"); }
                else { f.extra.Put("of", JsonValue.NewStr(ofNew)); }
                app.RequestRedraw();
            }
        }

        // STYLE（CSS 声明行）：一行一条声明，与元素 style 属性同一
        // 语义（键: 值）。每帧重组回 f.styleText（空行跳过），画布
        // 预览下一帧经 FormBuilder.FromField → SetProp("style") 即时
        // 生效；落盘走 "style" 键。v1 限制：值里带分号会被拆行，
        // 见 SplitDecls 台账。
        if (inspCategory == 0 || inspCategory == 3) {
            string styId = "style|" + f.fname + "|"
                + Convert.ToString(inspKeySeq);
            if (styleEditFor != styId) {
                styleEditFor = styId;
                styleInputs = new List<Input>();
                List<string> decls = Designer.SplitDecls(f.styleText);
                for (int si = 0; si < decls.Count; si = si + 1) {
                    Input sin = new Input("");
                    sin.SetText(decls[si]);
                    styleInputs.Add(sin);
                }
            }
            Label slb = new Label(Designer.T("STYLE (CSS)", "样式（CSS）"));
            slb.Class = "tertiary small";
            slb.RenderInside(app, new Rect(ix, iy, iw, app.Scale(18)));
            iy = iy + app.Scale(18) + app.Scale(InspectorMetrics.GapStack);
            for (int si = 0; si < styleInputs.Count; ) {
                int btnW = app.Scale(InspectorMetrics.ActionButtonSize);
                int rowH = app.Scale(InspectorMetrics.RowHeight);
                int gap = app.Scale(InspectorMetrics.GapMicro);
                styleInputs[si].Render(app, ix, iy, iw - btnW - gap, rowH);
                int rmStyId = MiniCloseBtn(app, ix + iw - btnW, iy + (rowH - btnW) / 2, btnW);
                if (Ui.Clicked(app, rmStyId)) {
                    this.BarrierInspectorUndo();
                    styleInputs.RemoveAt(si);
                    app.RequestRedraw();
                    continue;   // 不前进 iy：下一行顶上被删行的位置
                }
                iy = iy + rowH + app.Scale(InspectorMetrics.GapInline);
                si = si + 1;
            }
            string joined = "";
            for (int si = 0; si < styleInputs.Count; si = si + 1) {
                string t = StyleSheet.Trim(styleInputs[si].GetText());
                if (t == "") { continue; }
                if (joined.Length > 0) { joined = joined + "; "; }
                joined = joined + t;
            }
            if (joined != f.styleText) {
                this.GateInspectorUndo("style|" + styId);
                f.styleText = joined;
                app.RequestRedraw();
            }
            int addStyId = SmallBtn(app, Designer.T("+ Declaration", "+ 声明"),
                1, ix, iy, app.Scale(84));
            if (Ui.Clicked(app, addStyId)) {
                styleInputs.Add(new Input(""));
                app.RequestRedraw();
            }
            // 常用 CSS 快速预设标签（点击即可插入规范的 CSS 属性与标准 token）
            int cGap = app.Scale(InspectorMetrics.GapInline);
            int chipW = (iw - app.Scale(88) - cGap * 5) / 5;
            if (chipW < app.Scale(36)) { chipW = app.Scale(36); }
            int curCx = ix + app.Scale(88);
            List<string> pNames = new List<string>{ "底色", "字色", "圆角", "边框", "阴影" };
            List<string> pVals = new List<string>{
                "background: var(--bg-secondary)",
                "color: var(--primary)",
                "border-radius: 6",
                "border: 1 var(--border-primary)",
                "box-shadow: 0 4 12 rgba(0,0,0,0.2)"
            };
            for (int pi = 0; pi < pNames.Count && curCx + chipW <= ix + iw; pi = pi + 1) {
                int pid = SmallBtn(app, "+" + pNames[pi], 0, curCx, iy, chipW);
                if (Ui.Clicked(app, pid)) {
                    Input pin = new Input("");
                    pin.SetText(pVals[pi]);
                    styleInputs.Add(pin);
                    app.RequestRedraw();
                }
                curCx = curCx + chipW + cGap;
            }
            iy = iy + app.Scale(InspectorMetrics.RowHeight) + app.Scale(InspectorMetrics.GapStack);
        }

        // 内置组件的直通属性行：值存 extra["props"]（不在
        // IsModeledKey 里，SaveJson/LoadJson 原样透传），挂载时
        // 泛化发射 SetProp，画布预览经 ApplyFieldProps
        // 同步。引用节点走下面的 COMPONENT PROPS（声明的 target
        // 是组件内部控件），内置件的键就是控件 SetProp 认的名字。
        if (!f.compRef && (inspCategory == 0 || inspCategory == 1 || inspCategory == 3)) {
            List<string> brows = Designer.BuiltinPropRows(f.kind);
            if (brows != null) {
                string browId = "builtin|" + f.fname + "|" + f.kind
                    + "|" + Convert.ToString(pvCompGen);
                if (compPropEditFor != browId) {
                    compPropEditFor = browId;
                    compPropEditRows = new List<CompPropEditRow>();
                    for (int bi = 0; bi < brows.Count; bi = bi + 1) {
                        int bar = brows[bi].IndexOf("|");
                        string key = brows[bi].Substring(0, bar);
                        string rawLabel = brows[bi].Substring(bar + 1);
                        string curVal = CompPropValue(f, key, "");
                        bool isBool = Designer.IsBoolProp(key, rawLabel, curVal);
                        if (isBool) {
                            Switch sw = new Switch();
                            sw.Size = "small";
                            sw.SetOn(PropSpec.IsOn(curVal));
                            compPropEditRows.Add(new CompPropEditRow(key, rawLabel, true, null, sw, sw.IsOn() ? "true" : "false"));
                        } else {
                            List<string> opts = Designer.ExtractPropOptions(rawLabel);
                            if (opts.Count > 0) {
                                SelectBox sb = SelectBox.FromOptions(opts, "");
                                sb.Size = "small";
                                sb.SetSelectedByText(curVal);
                                CompPropEditRow er = new CompPropEditRow(key, rawLabel, false, null, null, curVal);
                                er.isEnum = true;
                                er.pick = sb;
                                compPropEditRows.Add(er);
                            } else {
                                Input pin = new Input("");
                                pin.SetText(curVal);
                                CompPropEditRow er = new CompPropEditRow(key, rawLabel, false, pin, null, pin.GetText());
                                if (key == "icon") { er.isIcon = true; }
                                else if (Designer.IsAssetProp(key)) { er.isAsset = true; }
                                else if (Designer.IsColorProp(key)) {
                                    er.isColor = true;
                                    this.InitColorPicker(er, curVal);
                                }
                                compPropEditRows.Add(er);
                            }
                        }
                    }
                }
                Label blb = new Label(Designer.T("WIDGET PROPS", "组件属性"));
                blb.Class = "tertiary small";
                int pbtnW = app.Scale(56);
                int pbtnH = app.Scale(InspectorMetrics.ActionButtonSize);
                int pbtnX = ix + iw - pbtnW;
                int pbtnY = iy + (app.Scale(18) - pbtnH) / 2;
                blb.RenderInside(app, new Rect(ix, iy, iw - pbtnW - app.Scale(6), app.Scale(18)));
                int pbigId = this.MiniTextBtn(app, Designer.T("Edit…", "编辑…"), pbtnX, pbtnY, pbtnW, pbtnH);
                if (Ui.Clicked(app, pbigId)) { this.OpenPropsEditor(app, f); }
                iy = iy + app.Scale(18) + app.Scale(InspectorMetrics.GapStack);

                int labelW = app.Scale(116);
                if (labelW > iw * 52 / 100) { labelW = iw * 52 / 100; }
                if (labelW < app.Scale(80)) { labelW = app.Scale(80); }

                for (int bi = 0; bi < compPropEditRows.Count; bi = bi + 1) {
                    CompPropEditRow er = compPropEditRows[bi];
                    string cleanLabel = Designer.CleanPropLabel(er.label);

                    int rowH = app.Scale(InspectorMetrics.RowHeight);
                    bool rowHover = InRect(app.mouseX, app.mouseY, ix, iy, iw, rowH);
                    if (rowHover) {
                        c.FillRoundRect(ix, iy, iw, rowH, app.Scale(3), Style.Part(app, "designer", "toolbar", "", "", "", Style.SHover()).BgOr(0));
                    }

                    Label brl = new Label(cleanLabel);
                    brl.Class = "secondary small";
                    brl.RenderInside(app, new Rect(ix, iy, labelW, rowH));

                    if (er.isBool) {
                        Switch sw = er.sw;
                        int swH = app.Scale(18);
                        int swY = iy + (rowH - swH) / 2;
                        sw.Render(app, ix + labelW + app.Scale(6), swY);
                        bool isSwOn = sw.IsOn();
                        string bcur = isSwOn ? "true" : "false";
                        if (bcur != er.shadow) {
                            this.BarrierInspectorUndo();
                            SetCompPropValue(f, er.key, bcur);
                            this.MarkDocDirty();
                            er.shadow = bcur;
                            app.RequestRedraw();
                        }
                    } else if (er.isEnum) {
                        er.pick.Render(app, ix + labelW, iy, iw - labelW);
                        string bcur = er.pick.SelectedText();
                        if (bcur != er.shadow) {
                            this.GateInspectorUndo("bprop|" + browId + "|" + er.key);
                            SetCompPropValue(f, er.key, bcur);
                            this.MarkDocDirty();
                            er.shadow = bcur;
                            app.RequestRedraw();
                        }
                    } else if (er.isIcon) {
                        int icBtnW = app.Scale(36);
                        int inpW = iw - labelW - icBtnW - app.Scale(4);
                        er.input.Render(app, ix + labelW, iy, inpW, rowH);
                        int pickBtnId = SmallBtn(app, Designer.T("pick", "图标"), 0,
                            ix + labelW + inpW + app.Scale(4), iy, icBtnW);
                        if (Ui.Clicked(app, pickBtnId)) {
                            this.OpenIconPicker(app, er.input);
                        }
                        string bcur = er.input.GetText();
                        if (bcur != er.shadow) {
                            this.GateInspectorUndo("bprop|" + browId + "|" + er.key);
                            SetCompPropValue(f, er.key, bcur);
                            this.MarkDocDirty();
                            er.shadow = bcur;
                            app.RequestRedraw();
                        }
                    } else if (er.isAsset) {
                        int astBtnW = app.Scale(36);
                        int inpW = iw - labelW - astBtnW - app.Scale(4);
                        er.input.Render(app, ix + labelW, iy, inpW, rowH);
                        int pickBtnId = SmallBtn(app, Designer.T("browse", "浏览"), 0,
                            ix + labelW + inpW + app.Scale(4), iy, astBtnW);
                        if (Ui.Clicked(app, pickBtnId)) {
                            this.OpenAssetPicker(app, er.input);
                        }
                        string bcur = er.input.GetText();
                        if (bcur != er.shadow) {
                            this.GateInspectorUndo("bprop|" + browId + "|" + er.key);
                            SetCompPropValue(f, er.key, bcur);
                            this.MarkDocDirty();
                            er.shadow = bcur;
                            app.RequestRedraw();
                        }
                    } else if (er.isColor) {
                        this.RenderColorPropRow(app, c, f, er, ix, iy, iw,
                            labelW, rowH, "bprop|" + browId + "|" + er.key);
                    } else {
                        er.input.Render(app, ix + labelW, iy,
                            iw - labelW, rowH);
                        string bcur = er.input.GetText();
                        if (bcur != er.shadow) {
                            this.GateInspectorUndo("bprop|" + browId
                                + "|" + er.key);
                            SetCompPropValue(f, er.key, bcur);
                            this.MarkDocDirty();
                            er.shadow = bcur;
                            app.RequestRedraw();
                        }
                    }
                    iy = iy + rowH + app.Scale(InspectorMetrics.GapInline);
                }
                iy = iy + app.Scale(InspectorMetrics.GapStack);
            }
        }

        // 引用节点的逃生门：解包成内联副本后即可就地改内部
        // （代价是与组件脱钩，组件进化不再跟随）。
        if (f.compRef && (inspCategory == 0 || inspCategory == 1 || inspCategory == 3)) {
            int ubId = SmallBtn(app, Designer.T("Unpack to inline copy", "解包为内联副本"),
                0, ix, iy, iw);
            if (Ui.Clicked(app, ubId)) {
                this.UnpackUserComponent(f);
                app.RequestRedraw();
            }
            iy = iy + app.Scale(34);

            // 组件声明的对外属性（v1 文本型）：每行一个输入框，
            // 实例值写入 f.extra 的 "props" 直通表——随 SaveJson
            // 进设计文档，挂载展开时落给目标内部控件；画布
            // 预览同步应用。目标名/声明都来自组件文档根。
            this.EnsureCompPropDecls(f.customKind);
            if (compPropDecls.Count > 0) {
                string rowId = f.fname + "|" + f.customKind
                    + "|" + Convert.ToString(pvCompGen);
                if (compPropEditFor != rowId) {
                    compPropEditFor = rowId;
                    compPropEditRows = new List<CompPropEditRow>();
                    for (int pi = 0; pi < compPropDecls.Count; pi = pi + 1) {
                        CompPropDecl decl = compPropDecls[pi];
                        string curVal = CompPropValue(f, decl.key, decl.def);
                        bool isBool = Designer.IsBoolProp(decl.key, decl.label, curVal) || decl.def == "true" || decl.def == "false";
                        if (isBool) {
                            Switch sw = new Switch();
                            sw.Size = "small";
                            sw.SetOn(PropSpec.IsOn(curVal));
                            compPropEditRows.Add(new CompPropEditRow(decl.key, decl.label, true, null, sw, sw.IsOn() ? "true" : "false"));
                        } else {
                            List<string> opts = Designer.ExtractPropOptions(decl.label);
                            if (opts.Count > 0) {
                                SelectBox sb = SelectBox.FromOptions(opts, "");
                                sb.Size = "small";
                                sb.SetSelectedByText(curVal);
                                CompPropEditRow er = new CompPropEditRow(decl.key, decl.label, false, null, null, curVal);
                                er.isEnum = true;
                                er.pick = sb;
                                compPropEditRows.Add(er);
                            } else {
                                Input pin = new Input("");
                                pin.SetText(curVal);
                                CompPropEditRow er = new CompPropEditRow(decl.key, decl.label, false, pin, null, pin.GetText());
                                if (decl.key == "icon") { er.isIcon = true; }
                                else if (Designer.IsAssetProp(decl.key)) { er.isAsset = true; }
                                else if (Designer.IsColorProp(decl.key)) {
                                    er.isColor = true;
                                    this.InitColorPicker(er, curVal);
                                }
                                compPropEditRows.Add(er);
                            }
                        }
                    }
                }
                Label pl = new Label(Designer.T("COMPONENT PROPS", "组件属性"));
                pl.Class = "tertiary small";
                pl.RenderInside(app, new Rect(ix, iy, iw, app.Scale(18)));
                iy = iy + app.Scale(18) + app.Scale(InspectorMetrics.GapStack);

                int labelW = app.Scale(116);
                if (labelW > iw * 52 / 100) { labelW = iw * 52 / 100; }
                if (labelW < app.Scale(80)) { labelW = app.Scale(80); }

                for (int pi = 0; pi < compPropEditRows.Count; pi = pi + 1) {
                    CompPropEditRow er = compPropEditRows[pi];
                    string cleanLabel = Designer.CleanPropLabel(er.label);
                    int rowH = app.Scale(InspectorMetrics.RowHeight);
                    bool rowHover = InRect(app.mouseX, app.mouseY, ix, iy, iw, rowH);
                    if (rowHover) {
                        c.FillRoundRect(ix, iy, iw, rowH, app.Scale(3), Style.Part(app, "designer", "toolbar", "", "", "", Style.SHover()).BgOr(0));
                    }

                    Label rl = new Label(cleanLabel);
                    rl.Class = "secondary small";
                    rl.RenderInside(app, new Rect(ix, iy, labelW, rowH));

                    if (er.isBool) {
                        Switch sw = er.sw;
                        int swH = app.Scale(18);
                        int swY = iy + (rowH - swH) / 2;
                        sw.Render(app, ix + labelW + app.Scale(6), swY);
                        bool isSwOn = sw.IsOn();
                        string cur = isSwOn ? "true" : "false";
                        if (cur != er.shadow) {
                            this.BarrierInspectorUndo();
                            SetCompPropValue(f, er.key, cur);
                            er.shadow = cur;
                            app.RequestRedraw();
                        }
                    } else if (er.isEnum) {
                        er.pick.Render(app, ix + labelW, iy, iw - labelW);
                        string cur = er.pick.SelectedText();
                        if (cur != er.shadow) {
                            this.GateInspectorUndo("cprop|" + rowId + "|" + er.key);
                            SetCompPropValue(f, er.key, cur);
                            er.shadow = cur;
                            app.RequestRedraw();
                        }
                    } else if (er.isIcon) {
                        int icBtnW = app.Scale(36);
                        int inpW = iw - labelW - icBtnW - app.Scale(4);
                        er.input.Render(app, ix + labelW, iy, inpW, rowH);
                        int pickBtnId = SmallBtn(app, Designer.T("pick", "图标"), 0,
                            ix + labelW + inpW + app.Scale(4), iy, icBtnW);
                        if (Ui.Clicked(app, pickBtnId)) {
                            this.OpenIconPicker(app, er.input);
                        }
                        string cur = er.input.GetText();
                        if (cur != er.shadow) {
                            this.GateInspectorUndo("cprop|" + rowId + "|" + er.key);
                            SetCompPropValue(f, er.key, cur);
                            er.shadow = cur;
                            app.RequestRedraw();
                        }
                    } else if (er.isAsset) {
                        int astBtnW = app.Scale(36);
                        int inpW = iw - labelW - astBtnW - app.Scale(4);
                        er.input.Render(app, ix + labelW, iy, inpW, rowH);
                        int pickBtnId = SmallBtn(app, Designer.T("browse", "浏览"), 0,
                            ix + labelW + inpW + app.Scale(4), iy, astBtnW);
                        if (Ui.Clicked(app, pickBtnId)) {
                            this.OpenAssetPicker(app, er.input);
                        }
                        string cur = er.input.GetText();
                        if (cur != er.shadow) {
                            this.GateInspectorUndo("cprop|" + rowId + "|" + er.key);
                            SetCompPropValue(f, er.key, cur);
                            er.shadow = cur;
                            app.RequestRedraw();
                        }
                    } else if (er.isColor) {
                        this.RenderColorPropRow(app, c, f, er, ix, iy, iw,
                            labelW, rowH, "cprop|" + rowId + "|" + er.key);
                    } else {
                        er.input.Render(app, ix + labelW, iy,
                            iw - labelW, rowH);
                        string cur = er.input.GetText();
                        if (cur != er.shadow) {
                            this.GateInspectorUndo("cprop|" + rowId
                                + "|" + er.key);
                            SetCompPropValue(f, er.key, cur);
                            er.shadow = cur;
                            app.RequestRedraw();
                        }
                    }
                    iy = iy + rowH + app.Scale(InspectorMetrics.GapInline);
                }
                iy = iy + app.Scale(InspectorMetrics.GapStack);
            }
        }

        // 双向绑定选择器：从配对的代码文件扫描出的变量。
        if (bindVars.Count > 0 && (inspCategory == 0 || inspCategory == 4)) {
            Label bvl = new Label(Designer.T("BINDING", "数据绑定"));
            bvl.Class = "tertiary small";
            bvl.RenderInside(app, new Rect(ix, iy, app.Scale(80), app.Scale(InspectorMetrics.RowHeight)));
            string pickLbl = Designer.T("Pick from code ▾", "从代码选择 ▾");
            if (bindPickOpen) { pickLbl = Designer.T("Pick from code ▴", "从代码选择 ▴"); }
            int pkId = SmallBtn(app, pickLbl, 0, ix + app.Scale(84), iy, iw - app.Scale(84));
            if (Ui.Clicked(app, pkId)) {
                bindPickOpen = !bindPickOpen;
                app.RequestRedraw();
            }
            iy = iy + app.Scale(InspectorMetrics.RowHeight) + app.Scale(InspectorMetrics.GapStack);
            if (bindPickOpen) {
                for (int bvi = 0; bvi < bindVars.Count; bvi = bvi + 1) {
                    int bvType = 0;
                    if (bindVars[bvi] == f.bindPath) { bvType = 1; }
                    int bvId = SmallBtn(app, bindVars[bvi], bvType,
                        ix + app.Scale(84), iy, iw - app.Scale(84));
                    if (Ui.Clicked(app, bvId)) {
                        f.bindPath = bindVars[bvi];
                        bindPickOpen = false;
                        msg = Designer.T("bound to ", "已绑定 ") + f.bindPath;
                        app.RequestRedraw();
                    }
                    iy = iy + app.Scale(InspectorMetrics.RowHeight) + app.Scale(InspectorMetrics.GapInline);
                }
            }
        }

        if (f.UsesOptions() && (inspCategory == 0 || inspCategory == 1 || inspCategory == 4)) {
            bool table = (f.ftype == 23 || f.ftype == 41);
            bool toolStrip = (f.ftype == 58);
            iy = iy + app.Scale(8);
            string head = Designer.T("OPTIONS", "选项");
            if (table) { head = Designer.T("COLUMNS", "列配置"); }
            else if (toolStrip) { head = Designer.T("TOOL ITEMS", "工具条项"); }

            Label hl = new Label(head);
            hl.Class = "tertiary small";
            int obtnW = app.Scale(56);
            int obtnH = app.Scale(22);
            int obtnX = ix + iw - obtnW;
            int obtnY = iy + (app.Scale(22) - obtnH) / 2;
            hl.RenderInside(app, new Rect(ix, iy, iw - obtnW - app.Scale(6), app.Scale(22)));
            int bigId = this.MiniTextBtn(app, Designer.T("Edit…", "编辑…"), obtnX, obtnY, obtnW, obtnH);
            if (Ui.Clicked(app, bigId)) { this.OpenRowsEditor(app, f); }
            iy = iy + app.Scale(22) + app.Scale(8);

            // =================================================================
            // 工业级结构化微型表格（Table Layout）：
            // 规整表头 [ # | 标题 | 绑定/字段 | 操作 ] 与单元格网格严格对齐
            // =================================================================
            int thH = app.Scale(InspectorMetrics.RowHeightCompact);
            int colIdxW = app.Scale(InspectorMetrics.RowHeightCompact);
            int btnSz = app.Scale(InspectorMetrics.ActionButtonSize);
            int btnGap = app.Scale(InspectorMetrics.GapMicro);
            int btnCount = toolStrip ? 5 : 4;
            int actionsColW = btnCount * btnSz + (btnCount - 1) * btnGap;
            int colBindW = (toolStrip || table) ? app.Scale(58) : 0;
            int colTitleW = iw - colIdxW - colBindW - actionsColW - app.Scale(InspectorMetrics.GapStack);
            if (colTitleW < app.Scale(40)) { colTitleW = app.Scale(40); }

            // 1. 表头绘制 (Table Header)
            c.FillRoundRect(ix, iy, iw, thH, app.Scale(3), app.theme.bgSecondary);
            c.DrawRoundRect(ix, iy, iw, thH, app.Scale(3), app.theme.borderSecondary, 1);
            int thFs = Style.FontFallback(app, "tiny");
            if (thFs <= 0) { thFs = Style.FontFallback(app, "small"); }
            int thFg = app.theme.textTertiary;
            int thY = iy + (thH - app.Scale(12)) / 2;

            // 表头 - # 序号
            int idxHdrW = Canvas.MeasureText("#", thFs);
            c.DrawText(ix + (colIdxW - idxHdrW) / 2, thY, "#", thFg, thFs);
            c.DrawLine(ix + colIdxW, iy + app.Scale(3), ix + colIdxW, iy + thH - app.Scale(3), app.theme.borderSecondary, 1);

            // 表头 - 标题
            string thTitle = table ? Designer.T("Title", "标题") : Designer.T("Text", "文本");
            c.DrawText(ix + colIdxW + app.Scale(6), thY, thTitle, thFg, thFs);

            // 表头 - 绑定 / 字段
            if (colBindW > 0) {
                int bindThX = ix + colIdxW + colTitleW + app.Scale(4);
                c.DrawLine(bindThX - app.Scale(2), iy + app.Scale(3), bindThX - app.Scale(2), iy + thH - app.Scale(3), app.theme.borderSecondary, 1);
                string thBind = toolStrip ? Designer.T("Event", "事件") : Designer.T("Field", "字段");
                c.DrawText(bindThX + app.Scale(4), thY, thBind, thFg, thFs);
            }

            // 表头 - 操作
            int actThX = ix + iw - actionsColW;
            c.DrawLine(actThX - app.Scale(4), iy + app.Scale(3), actThX - app.Scale(4), iy + thH - app.Scale(3), app.theme.borderSecondary, 1);
            c.DrawText(actThX, thY, Designer.T("Actions", "操作"), thFg, thFs);

            iy = iy + thH + app.Scale(InspectorMetrics.GapMicro);

            // 2. 表体数据行绘制 (Data Rows)
            for (int oi = 0; oi < f.OptionCount(); oi = oi + 1) {
                string rawOpt = f.OptionAt(oi);
                string tClick = "";
                if (toolStrip) {
                    tClick = Designer.GetToolItemClick(f, oi);
                }
                string disp = rawOpt;
                string colFld = "";
                if (table) {
                    disp = Designer.ColTitle(rawOpt);
                    colFld = Designer.ColField(rawOpt);
                }

                int rowH = app.Scale(InspectorMetrics.RowHeight);
                bool rowHover = InRect(app.mouseX, app.mouseY, ix, iy, iw, rowH);

                // 行背景与微斑马纹
                if (rowHover) {
                    c.FillRoundRect(ix, iy, iw, rowH, app.Scale(3), app.theme.bgHover);
                } else if (oi % 2 == 1) {
                    c.FillRoundRect(ix, iy, iw, rowH, app.Scale(3), app.theme.bgSecondary);
                }
                c.DrawLine(ix, iy + rowH, ix + iw, iy + rowH, app.theme.borderSecondary, 1);

                // 双击整行文本区域：快速前往事件/打开弹窗编辑
                int rowHitId = app.focus.AllocId();
                int rowTextW = iw - actionsColW - app.Scale(4);
                app.hitTester.RegisterRect(rowHitId, ix, iy, rowTextW, rowH, 0);
                if (Ui.DoubleClicked(app, rowHitId)) {
                    if (toolStrip && rawOpt != "-") {
                        this.EnsureToolItemHandlerAndOpen(f, oi, rawOpt);
                    } else {
                        this.OpenRowsEditorAt(app, f, oi);
                    }
                }

                int midY = iy + (rowH - app.Scale(14)) / 2;

                // 单元格 1：序号（居中）
                string idxStr = Convert.ToString(oi + 1);
                int idxTw = Canvas.MeasureText(idxStr, thFs);
                c.DrawText(ix + (colIdxW - idxTw) / 2, midY, idxStr, app.theme.textTertiary, thFs);
                c.DrawLine(ix + colIdxW, iy + app.Scale(4), ix + colIdxW, iy + rowH - app.Scale(4), app.theme.borderSecondary, 1);

                // 单元格 2：标题或分隔项
                int titleX = ix + colIdxW + app.Scale(6);
                if (toolStrip && rawOpt == "-") {
                    int sepW = colTitleW + colBindW;
                    int lineY = iy + rowH / 2;
                    c.DrawLine(titleX, lineY, titleX + sepW - app.Scale(8), lineY, app.theme.borderSecondary, 1);
                    string sepTxt = Designer.T("── Separator ──", "── 分隔条 ──");
                    int stw = Canvas.MeasureText(sepTxt, thFs);
                    c.DrawText(titleX + (sepW - stw) / 2, midY, sepTxt, app.theme.textTertiary, thFs);
                } else {
                    int fsNorm = Style.FontFallback(app, "small");
                    string fitTitle = Ellipsis.Fit(disp, colTitleW - app.Scale(6), fsNorm);
                    int titleFg = rowHover ? app.theme.textPrimary : app.theme.textSecondary;
                    c.DrawText(titleX, midY, fitTitle, titleFg, fsNorm);

                    // 单元格 3：绑定徽章 / 字段
                    if (colBindW > 0) {
                        int bindX = ix + colIdxW + colTitleW + app.Scale(4);
                        c.DrawLine(bindX - app.Scale(2), iy + app.Scale(4), bindX - app.Scale(2), iy + rowH - app.Scale(4), app.theme.borderSecondary, 1);
                        if (toolStrip) {
                            if (tClick != "") {
                                string fitClick = Ellipsis.Fit("@" + tClick, colBindW - app.Scale(6), thFs);
                                int bindFg = Style.Part(app, "designer", "accent", "", "success", "", Style.SNormal()).BgOr(app.theme.primary);
                                c.DrawText(bindX + app.Scale(4), midY, fitClick, bindFg, thFs);
                            } else {
                                c.DrawText(bindX + app.Scale(4), midY, "-", app.theme.textTertiary, thFs);
                            }
                        } else if (table) {
                            if (colFld != "") {
                                string fitFld = Ellipsis.Fit(colFld, colBindW - app.Scale(6), thFs);
                                c.DrawText(bindX + app.Scale(4), midY, fitFld, app.theme.primary, thFs);
                            } else {
                                c.DrawText(bindX + app.Scale(4), midY, "-", app.theme.textTertiary, thFs);
                            }
                        }
                    }
                }

                // 单元格 4：操作按钮列（统一 22x22px 标准盒模型，防误触点歪）
                int curBtnX = ix + iw - actionsColW;
                int btnY = iy + (rowH - btnSz) / 2;

                if (toolStrip) {
                    if (rawOpt != "-") {
                        int zapId = this.MiniZapBtn(app, curBtnX, btnY, btnSz, tClick != "");
                        if (Ui.Clicked(app, zapId)) {
                            this.EnsureToolItemHandlerAndOpen(f, oi, rawOpt);
                        }
                    }
                    curBtnX = curBtnX + btnSz + btnGap;
                }

                int edId = MiniArrowBtn(app, "edit", curBtnX, btnY, btnSz, true);
                if (Ui.Clicked(app, edId)) {
                    this.OpenRowsEditorAt(app, f, oi);
                }
                curBtnX = curBtnX + btnSz + btnGap;

                int upId = MiniArrowBtn(app, "chevron-up", curBtnX, btnY, btnSz, oi > 0);
                if (oi > 0 && Ui.Clicked(app, upId)) {
                    this.PushUndo();
                    MoveOptionFixup(f, oi, oi - 1);
                }
                curBtnX = curBtnX + btnSz + btnGap;

                int dnId = MiniArrowBtn(app, "chevron-down", curBtnX, btnY, btnSz, oi < f.OptionCount() - 1);
                if (oi < f.OptionCount() - 1 && Ui.Clicked(app, dnId)) {
                    this.PushUndo();
                    MoveOptionFixup(f, oi, oi + 1);
                }
                curBtnX = curBtnX + btnSz + btnGap;

                int rmId = MiniCloseBtn(app, curBtnX, btnY, btnSz);
                if (Ui.Clicked(app, rmId)) {
                    this.PushUndo();
                    RemoveOptionFixup(f, oi);
                }

                iy = iy + rowH + app.Scale(2);
            }

            iy = iy + app.Scale(InspectorMetrics.GapInline);

            // 3. 底部快速追加输入栏（高度规范统一 28px，右侧 Add 按钮统一高度与标准间距）
            int addBtnW = app.Scale(48);
            int addGap = app.Scale(InspectorMetrics.GapInline);
            int rowH = app.Scale(InspectorMetrics.RowHeight);
            if (table) {
                int inputTotalW = iw - addBtnW - addGap;
                int half = (inputTotalW - addGap) / 2;
                optInput.Render(app, ix, iy, half, rowH);
                optFieldInput.Render(app, ix + half + addGap, iy, half, rowH);
                int addId = SmallBtn(app, Designer.T("Add", "添加"), 1, ix + iw - addBtnW, iy, addBtnW);
                if (Ui.Clicked(app, addId) && optInput.GetText() != "") {
                    string col = optInput.GetText();
                    if (optFieldInput.GetText() != "") { col = col + ":" + optFieldInput.GetText(); }
                    f.AddOption(col);
                    optInput.SetText("");
                    optFieldInput.SetText("");
                }
            } else {
                int inpW = iw - addBtnW - addGap;
                optInput.Render(app, ix, iy, inpW, rowH);
                int addId = SmallBtn(app, Designer.T("Add", "添加"), 1, ix + iw - addBtnW, iy, addBtnW);
                if (Ui.Clicked(app, addId) && optInput.GetText() != "") {
                    f.AddOption(optInput.GetText());
                    optInput.SetText("");
                }
            }
            iy = iy + rowH + app.Scale(InspectorMetrics.GapStack);
        }
        return iy + app.Scale(InspectorMetrics.GapInline);
    }

    // 从 `f` 中移除选项 `oi` 并修复依赖状态，
    // UI 永远不会索引超出缩小后的列表（旧的直接 RemoveOptionAt 可能
    // 让 Tabs 容器的活动标签/子标签超出范围）。
    void RemoveOptionFixup(FormField f, int oi) {
        f.RemoveOptionAt(oi);
        // 列属性条目跟着走（extra["columns"] 与 options 下标对齐）。
        Designer.RemoveColEntry(f, oi);
        Designer.RemoveToolItemEntry(f, oi);
        if (f.kind == "Tabs") {
            for (int ki = 0; ki < f.kids.Count; ki = ki + 1) {
                if (f.kids[ki].childTab == oi) { f.kids[ki].childTab = 0; }
                else if (f.kids[ki].childTab > oi) { f.kids[ki].childTab = f.kids[ki].childTab - 1; }
            }
        }
        if (f.uiState.Get() >= f.OptionCount() || f.uiState.Get() < 0) { f.uiState.Set(0); }
        this.MarkDocDirty();
    }

    // 移动 `f` 中的选项 `from` 到 `to`，并同步更新关联的列配置、工具项以及 Tabs 容器子控件插槽
    void MoveOptionFixup(FormField f, int from, int to) {
        if (from < 0 || from >= f.OptionCount() || to < 0 || to >= f.OptionCount() || from == to) { return; }
        f.MoveOption(from, to);
        Designer.MoveColEntry(f, from, to);
        Designer.MoveToolItemEntry(f, from, to);
        if (f.kind == "Tabs") {
            for (int ki = 0; ki < f.kids.Count; ki = ki + 1) {
                int cur = f.kids[ki].childTab;
                if (cur == from) {
                    f.kids[ki].childTab = to;
                } else if (from < to && cur > from && cur <= to) {
                    f.kids[ki].childTab = cur - 1;
                } else if (from > to && cur >= to && cur < from) {
                    f.kids[ki].childTab = cur + 1;
                }
            }
            int act = f.uiState.Get();
            if (act == from) {
                f.uiState.Set(to);
            } else if (from < to && act > from && act <= to) {
                f.uiState.Set(act - 1);
            } else if (from > to && act >= to && act < from) {
                f.uiState.Set(act + 1);
            }
        }
        this.MarkDocDirty();
    }

    // 确保工具条子项拥有合法事件方法名并请求宿主 IDE 打开/生成对应代码桩
    void EnsureToolItemHandlerAndOpen(FormField f, int oi, string rawOpt) {
        string target = Designer.GetToolItemClick(f, oi);
        if (target == "") {
            string baseName = f.fname != "" ? f.fname : "Tool";
            string itmName = rawOpt;
            if (itmName.Length > 0 && (itmName[0] & 255) == 62) { itmName = itmName.Substring(1); }
            int cp = itmName.IndexOf(":");
            if (cp >= 0) { itmName = itmName.Substring(0, cp); }
            if (itmName == "") { itmName = "Item" + Convert.ToString(oi + 1); }
            target = "On" + Designer.CleanIdentifier(baseName)
                + Designer.CleanIdentifier(itmName) + "Click";
            Designer.SetToolItemClick(f, oi, target);
            this.MarkDocDirty();
        }
        this.RequestOpenCodeBehindHandler(target);
    }

    // 表格列选项的显示标题（"标题:字段"约定）。
    static string ColTitle(string opt) {
        int p = Designer.IndexOfColon(opt);
        if (p < 0) { return opt; }
        return opt.Substring(0, p);
    }

    // 表格列选项的数据字段键（未声明时为 ""）。
    static string ColField(string opt) {
        int p = Designer.IndexOfColon(opt);
        if (p < 0) { return ""; }
        return opt.Substring(p + 1, opt.Length - p - 1);
    }

    // s 中第一个冒号的下标，没有则 -1（"标题:字段" 约定的分隔符）。
    static int IndexOfColon(string s) {
        for (int i = 0; i < s.Length; i = i + 1) {
            if (s.Substring(i, 1) == ":") { return i; }
        }
        return -1;
    }

    // 内联声明文本按 ";" 拆成声明行（STYLE 编辑器逐行显示用）：
    // 去首尾空白、丢空行。v1 限制：值里带分号（如 content:";"）
    // 会被拆开——设计期样式里极罕见，遇上的手工编辑 JSON 画布。
    static List<string> SplitDecls(string s) {
        List<string> rows = new List<string>();
        if (s == null) { return rows; }
        List<string> parts = s.Split(";");
        for (int i = 0; i < parts.Count; i = i + 1) {
            string t = StyleSheet.Trim(parts[i]);
            if (t != "") { rows.Add(t); }
        }
        return rows;
    }

    // 根 Window 的属性列表：窗口装饰（标题 / 尺寸 / 标志）以及
    // 应用于其内带标签输入行的共享布局默认值。
}
