using System;
using Gui;
using Gui.Widget;

namespace Gui.Designer;

partial class Designer {
    DesignerMenu NewDesignerMenu(App app, int kind) {
        this.CloseDesignerMenus();
        hostApp = app;
        DesignerMenu menu = new DesignerMenu();
        menu.Owner = this;
        menu.Host = app;
        menu.MenuKind = kind;
        menu.Target = sel;
        menu.Targets = new List<FormField>();
        if (freeExtra != null) {
            for (int i = 0; i < freeExtra.Count; i = i + 1) { menu.Targets.Add(freeExtra[i]); }
        }
        return menu;
    }

    void CloseDesignerMenus() {
        this.HideDesignerMenu(zoomMenuCtl);
        this.HideDesignerMenu(dpiMenuCtl);
        this.HideDesignerMenu(ribbonMenuCtl);
        this.HideDesignerMenu(canvasMenuCtl);
        zoomMenuOpen = false; dpiMenuOpen = false; ribbonMenuOpen = false; canvasMenuOpen = false;
    }

    void HideDesignerMenu(ContextMenu menu) {
        if (menu == null) { return; }
        App app = menu.FindApp();
        if (app != null && app.overlayHost != null) { app.overlayHost.Hide(menu); }
    }

    void DesignerMenuClosed(DesignerMenu menu) {
        if (zoomMenuCtl == menu) { zoomMenuOpen = false; }
        if (dpiMenuCtl == menu) { dpiMenuOpen = false; }
        if (ribbonMenuCtl == menu) { ribbonMenuOpen = false; }
        if (canvasMenuCtl == menu) { canvasMenuOpen = false; }
    }

    void OpenZoomMenu(App app, int x, int y) {
        if (app == null) { return; }
        DesignerMenu menu = this.NewDesignerMenu(app, 1);
        List<string> labels = this.ZoomMenuLabels();
        List<int> values = this.ZoomPresets();
        for (int i = 0; i < labels.Count; i = i + 1) {
            menu.AddItem(MenuItem.Item(labels[i], "", values[i]));
        }
        zoomMenuCtl = menu; zoomMenuOpen = true;
        menu.ShowAt(app, x, y);
    }

    void OpenDpiMenu(App app, int x, int y) {
        if (app == null) { return; }
        DesignerMenu menu = this.NewDesignerMenu(app, 2);
        List<string> labels = this.DpiMenuLabels();
        List<int> values = this.DpiPresets();
        for (int i = 0; i < labels.Count; i = i + 1) {
            menu.AddItem(MenuItem.Item(labels[i], "", values[i]));
        }
        dpiMenuCtl = menu; dpiMenuOpen = true;
        menu.ShowAt(app, x, y);
    }

    void OpenRibbonMenu(App app, int x, int y, List<string> labels, List<string> commands) {
        if (app == null || labels == null || commands == null) { return; }
        DesignerMenu menu = this.NewDesignerMenu(app, 3);
        menu.Commands = new List<string>();
        for (int i = 0; i < labels.Count && i < commands.Count; i = i + 1) {
            menu.Commands.Add(commands[i]);
            if (ContextMenu.IsSep(labels[i])) { menu.AddSeparator(); }
            else { menu.AddItem(MenuItem.Item(labels[i], "", i)); }
        }
        ribbonMenuCtl = menu; ribbonMenuOpen = true;
        menu.ShowAt(app, x, y);
    }

    void OpenCanvasMenu(App app, int x, int y) {
        if (app == null) { return; }
        DesignerMenu menu = this.NewDesignerMenu(app, 4);
        List<MenuItem> entries = this.CanvasMenuItems();
        for (int i = 0; i < entries.Count; i = i + 1) { menu.AddItem(entries[i]); }
        canvasMenuCtl = menu; canvasMenuOpen = true;
        menu.ShowAt(app, x, y);
    }

    bool MenuTargetInDocument(FormField target) {
        if (target == null) { return true; }
        for (int i = 0; i < fields.Count; i = i + 1) {
            if (fields[i] == target || this.DesignInSubtree(fields[i], target)) { return true; }
        }
        return false;
    }

    void DesignerMenuSelected(DesignerMenu menu) {
        int action = menu.TakeAction();
        App app = menu.Host;
        if (action < 0 || app == null) { return; }
        if (menu.MenuKind == 1) { winZoom = action; }
        else if (menu.MenuKind == 2) { this.SetDesignTargetDpi(app, action); }
        else {
            if (!this.MenuTargetInDocument(menu.Target)) { return; }
            for (int i = 0; i < menu.Targets.Count; i = i + 1) {
                if (!this.MenuTargetInDocument(menu.Targets[i])) { return; }
            }
            sel = menu.Target;
            this.ClearExtraSel();
            for (int i = 0; i < menu.Targets.Count; i = i + 1) { freeExtra.Add(menu.Targets[i]); }
            this.SyncFreeSelBase();
            if (menu.MenuKind == 3) {
                if (action < menu.Commands.Count) { this.RunRibbon(app, menu.Commands[action]); }
            } else { this.HandleCanvasAction(app, action); }
        }
        app.RequestRedraw();
    }
}
