using System;
using Gui;
using Gui.Widget;

namespace Gui.Designer;

partial class Designer {
    string InspectorOptionsShape(FormField field) {
        if (field == null) { return ""; }
        string shape = "";
        for (int i = 0; i < field.OptionCount(); i = i + 1) {
            string option = field.OptionAt(i);
            if (option == null) { option = ""; }
            string click = Designer.GetToolItemClick(field, i);
            if (click == null) { click = ""; }
            shape = shape + Convert.ToString(option.Length) + ":" + option
                + "|" + Convert.ToString(click.Length) + ":" + click + ";";
        }
        return shape;
    }

    void BuildInspectorOptions(FormField field) {
        inspectorExtrasOptions = this.InspectorExtraColumn(inspectorExtrasRoot, "inspector-options");
        bool table = field.ftype == 23 || field.ftype == 41;
        bool tools = field.ftype == 58;
        Flex heading = this.InspectorExtraRow(inspectorExtrasOptions, "inspector-options-heading");
        string text = table ? Designer.T("COLUMNS", "列配置") : Designer.T("OPTIONS", "选项");
        if (tools) { text = Designer.T("TOOL ITEMS", "工具条项"); }
        Label title = this.InspectorExtraLabel(heading, text, true);
        title.Class = "tertiary small";
        this.InspectorExtraButton(heading, "inspector-options-dialog", Designer.T("Edit…", "编辑…"), "option-dialog", 0, "");
        Flex header = this.InspectorExtraRow(inspectorExtrasOptions, "inspector-options-header");
        header.Class = "designer-inspector-table-header";
        header.SetProp("style", "flex:0 0 auto;min-width:0;gap:var(--gap-small);align-items:center;background:var(--bg-secondary);border-bottom:1px solid var(--border-secondary);");
        Label index = this.InspectorExtraLabel(header, "#", false);
        index.Prefer(InspectorMetrics.RowHeightCompact, InspectorMetrics.RowHeight);
        index.SetProp("style", "flex-shrink:0;text-align:center;");
        this.InspectorExtraLabel(header, table ? Designer.T("Title", "标题") : Designer.T("Text", "文本"), true);
        if (table || tools) {
            Label bind = this.InspectorExtraLabel(header, tools ? Designer.T("Event", "事件") : Designer.T("Field", "字段"), false);
            bind.Prefer(58, InspectorMetrics.RowHeight);
        }
        Label actions = this.InspectorExtraLabel(header, Designer.T("Actions", "操作"), false);
        int count = tools ? 5 : 4;
        actions.Prefer(count * InspectorMetrics.ActionButtonSize + (count - 1) * InspectorMetrics.GapInline, InspectorMetrics.RowHeight);
        inspectorExtrasOptionRows = this.InspectorExtraColumn(inspectorExtrasOptions, "inspector-option-rows");
        this.RebuildInspectorOptionRows(field);
        Flex append = this.InspectorExtraRow(inspectorExtrasOptions, "inspector-option-append-row");
        inspectorExtrasAppend = new Input(table ? Designer.T("Title", "标题") : Designer.T("Option", "选项"));
        inspectorExtrasAppend.name = "inspector-option-append";
        inspectorExtrasAppend.Size = "small";
        inspectorExtrasAppend.SetProp("style", "flex:1;min-width:0;");
        append.Add(inspectorExtrasAppend);
        if (table) {
            inspectorExtrasAppendField = new Input(Designer.T("Field", "字段"));
            inspectorExtrasAppendField.name = "inspector-option-append-field";
            inspectorExtrasAppendField.Size = "small";
            inspectorExtrasAppendField.SetProp("style", "flex:1;min-width:0;");
            append.Add(inspectorExtrasAppendField);
        }
        this.InspectorExtraButton(append, "inspector-option-add", Designer.T("Add", "添加"), "option-append", 0, "");
        DesignerInspectorExtraAction submit = this.InspectorExtraAction(inspectorExtrasAppend, append, "option-append", 0, "");
        inspectorExtrasAppend.BindEvent("Submit", submit.Run);
    }

    void RebuildInspectorOptionRows(FormField field) {
        if (field == null || inspectorExtrasOptionRows == null) { return; }
        int epoch = inspectorExtrasEpoch;
        int rowEpoch = inspectorExtrasOptionsEpoch + 1;
        inspectorExtrasOptionsEpoch = rowEpoch;
        this.RetireInspectorExtraActions("option-row-");
        Flex host = inspectorExtrasOptionRows;
        host.RemoveAll();
        if (epoch != inspectorExtrasEpoch || rowEpoch != inspectorExtrasOptionsEpoch || host != inspectorExtrasOptionRows) { return; }
        inspectorExtrasOptionsShape = this.InspectorOptionsShape(field);
        bool table = field.ftype == 23 || field.ftype == 41;
        bool tools = field.ftype == 58;
        for (int i = 0; i < field.OptionCount(); i = i + 1) {
            this.BuildInspectorOptionRow(field, i, table, tools);
        }
    }

    void BuildInspectorOptionRow(FormField field, int i, bool table, bool tools) {
        string suffix = Convert.ToString(i);
        Flex row = this.InspectorExtraRow(inspectorExtrasOptionRows, "inspector-option-row-" + suffix);
        row.Class = i % 2 == 0 ? "designer-inspector-table-row" : "designer-inspector-table-row alternate";
        string background = i % 2 == 0 ? "" : "background:var(--bg-secondary);";
        row.SetProp("style", "flex:0 0 auto;min-width:0;gap:var(--gap-small);align-items:center;border-bottom:1px solid var(--border-secondary);" + background);
        Label index = this.InspectorExtraLabel(row, Convert.ToString(i + 1), false);
        index.Prefer(InspectorMetrics.RowHeightCompact, InspectorMetrics.RowHeight);
        index.SetProp("style", "flex-shrink:0;text-align:center;");
        bool separator = Designer.RowIsSep(field, i);
        string text = separator ? Designer.T("── Separator ──", "── 分隔条 ──") : Designer.RowMainText(field, i);
        Label title = this.InspectorExtraLabel(row, text, true);
        title.name = "inspector-option-title-" + suffix;
        string eventName = tools && !separator ? "option-row-handler" : "option-row-edit";
        DesignerInspectorExtraAction open = this.InspectorExtraAction(title, row, eventName, i, field.OptionAt(i));
        title.OnDoubleClick(open.Run);
        DesignerInspectorExtraAction number = this.InspectorExtraAction(index, row, eventName, i, field.OptionAt(i));
        index.OnDoubleClick(number.Run);
        if (table || tools) {
            string value = tools ? Designer.GetToolItemClick(field, i) : Designer.ColField(field.OptionAt(i));
            if (tools && value != "") { value = "@" + value; }
            if (value == "") { value = "—"; }
            Label bind = this.InspectorExtraLabel(row, separator ? "" : value, false);
            bind.Class = "tertiary tiny";
            bind.Prefer(58, InspectorMetrics.RowHeight);
            bind.SetProp("style", "flex-shrink:0;overflow:hidden;");
            bind.OnDoubleClick(open.Run);
        }
        Flex actions = Flex.Row();
        actions.SetProp("style", "flex-shrink:0;gap:var(--gap-small);align-items:center;");
        row.Add(actions);
        if (tools) {
            Button handler = this.InspectorOptionButton(actions, "handler", i, "zap", "option-row-handler", field.OptionAt(i));
            handler.Disabled = separator;
            handler.Tip = Designer.T("Generate / open handler", "生成 / 打开事件");
        }
        Button edit = this.InspectorOptionButton(actions, "edit", i, "edit", "option-row-edit", field.OptionAt(i));
        edit.Tip = Designer.T("Edit row", "编辑行");
        Button up = this.InspectorOptionButton(actions, "up", i, "chevron-up", "option-row-up", field.OptionAt(i));
        up.Disabled = i == 0;
        Button down = this.InspectorOptionButton(actions, "down", i, "chevron-down", "option-row-down", field.OptionAt(i));
        down.Disabled = i == field.OptionCount() - 1;
        this.InspectorOptionButton(actions, "remove", i, "x", "option-row-remove", field.OptionAt(i));
    }

    Button InspectorOptionButton(Control host, string name, int index, string icon, string command, string value) {
        Button button = this.InspectorExtraButton(host, "inspector-option-" + name + "-" + Convert.ToString(index), "", command, index, value);
        button.Icon = icon;
        button.Prefer(InspectorMetrics.ActionButtonSize, InspectorMetrics.ActionButtonSize);
        button.SetProp("style", "flex-shrink:0;padding:0;background:var(--bg-secondary);border:1px solid var(--border-secondary);");
        return button;
    }

    void InvokeInspectorOptionAction(DesignerInspectorExtraAction action) {
        if (action == null) { return; }
        FormField field = action.target;
        App app = inspectorExtrasApp;
        if (field == null) { return; }
        string command = action.command;
        if (command == "option-dialog") { this.OpenRowsEditor(app, field); return; }
        if (command == "option-append") {
            if (inspectorExtrasAppend == null) { return; }
            string value = inspectorExtrasAppend.GetText();
            if (value == "") { return; }
            if (inspectorExtrasAppendField != null && inspectorExtrasAppendField.GetText() != "") {
                value = value + ":" + inspectorExtrasAppendField.GetText();
            }
            this.BarrierInspectorUndo();
            if (!this.InspectorExtraActionCurrent(action)) { return; }
            field.AddOption(value);
            if (inspectorExtrasAppend != null) { inspectorExtrasAppend.SetText(""); }
            if (inspectorExtrasAppendField != null) { inspectorExtrasAppendField.SetText(""); }
            this.MarkDocDirty();
            this.RebuildInspectorOptionRows(field);
            return;
        }
        int index = action.index;
        if (index < 0 || index >= field.OptionCount() || field.OptionAt(index) != action.value) { return; }
        if (command == "option-row-edit") { this.OpenRowsEditorAt(app, field, index); return; }
        if (command == "option-row-handler") {
            if (field.ftype != 58 || Designer.RowIsSep(field, index)) { return; }
            if (Designer.GetToolItemClick(field, index) == "") { this.BarrierInspectorUndo(); }
            if (!this.InspectorExtraActionCurrent(action)) { return; }
            this.EnsureToolItemHandlerAndOpen(field, index, field.OptionAt(index));
            return;
        }
        if (command == "option-row-up" && index == 0) { return; }
        if (command == "option-row-down" && index == field.OptionCount() - 1) { return; }
        this.BarrierInspectorUndo();
        if (!this.InspectorExtraActionCurrent(action)) { return; }
        if (command == "option-row-up") { this.MoveOptionFixup(field, index, index - 1); }
        else if (command == "option-row-down") { this.MoveOptionFixup(field, index, index + 1); }
        else if (command == "option-row-remove") { this.RemoveOptionFixup(field, index); }
        this.RebuildInspectorOptionRows(field);
    }
}
