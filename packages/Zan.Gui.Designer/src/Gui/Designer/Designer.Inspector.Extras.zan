using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

namespace Gui.Designer;

partial class Designer {
    Panel inspectorExtrasRoot;
    Flex inspectorExtrasCardsHost;
    Flex inspectorExtrasStyle;
    Flex inspectorExtrasStyleRows;
    Flex inspectorExtrasProps;
    Flex inspectorExtrasOptions;
    Flex inspectorExtrasOptionRows;
    SelectBox inspectorExtrasBinding;
    Input inspectorExtrasAppend;
    Input inspectorExtrasAppendField;
    List<Input> inspectorExtrasStyleInputs;
    List<DesignerInspectorExtraProp> inspectorExtrasPropRows;
    List<DesignerInspectorExtraAction> inspectorExtrasActions;
    weak App inspectorExtrasApp;
    weak UiViewScope inspectorExtrasScope;
    weak FormField inspectorExtrasTarget;
    weak Control inspectorExtrasHost;
    int inspectorExtrasEpoch;
    int inspectorExtrasKey;
    int inspectorExtrasCategory;
    int inspectorExtrasStyleEpoch;
    int inspectorExtrasOptionsEpoch;
    string inspectorExtrasShape;
    string inspectorExtrasStyleShadow;
    string inspectorExtrasOptionsShape;

    string InspectorExtrasShape(FormField field) {
        if (field == null) { return ""; }
        string shape = field.kind + "|" + Convert.ToString(field.ftype) + "|"
            + Convert.ToString(field.compRef) + "|" + field.customKind + "|" + Convert.ToString(pvCompGen);
        if (bindVars != null) {
            for (int i = 0; i < bindVars.Count; i = i + 1) {
                if (bindVars[i] == null) { continue; }
                shape = shape + "|" + Convert.ToString(bindVars[i].Length) + ":" + bindVars[i];
            }
        }
        return shape;
    }

    bool InspectorExtrasSessionCurrent() {
        FormField field = inspectorExtrasTarget;
        Control curHost = inspectorExtrasHost;
        UiViewScope curScope = inspectorExtrasScope;
        App curExtrasApp = inspectorExtrasApp;
        App curInspApp = inspectorApp;
        return field != null && field == sel && inspTab == 0 && inspCategory == inspectorExtrasCategory
            && inspectorExtrasKey == inspKeySeq && inspectorExtrasRoot != null
            && curHost != null && inspectorExtrasRoot.parent == curHost
            && curScope != null && curScope == inspectorView && curScope.IsActive()
            && curExtrasApp != null && curExtrasApp == curInspApp && inspectorRegion != null
            && inspectorRoot != null && inspectorRoot.visible && inspectorExtrasRoot.visible
            && inspectorExtrasShape == this.InspectorExtrasShape(field)
            && (this.ContainsRef(fields, field) || this.ParentContainerOf(field) != null);
    }

    public void PrepareInspectorFieldExtras(App app, FormField field, Control host) {
        UiViewScope scope = inspectorView;
        App curInspApp = inspectorApp;
        if (app == null || field == null || host == null || field != sel || inspTab != 0
                || scope == null || !scope.IsActive() || curInspApp != app) {
            this.RetireInspectorFieldExtras(); return;
        }
        int inputGeneration = inspectorInputGeneration;
        string shape = this.InspectorExtrasShape(field);
        App curExtrasApp = inspectorExtrasApp;
        UiViewScope curExtrasScope = inspectorExtrasScope;
        FormField curExtrasTarget = inspectorExtrasTarget;
        Control curExtrasHost = inspectorExtrasHost;
        bool current = inspectorExtrasRoot != null && curExtrasApp == app && curExtrasScope == scope
            && curExtrasTarget == field && curExtrasHost == host && inspectorExtrasKey == inspKeySeq
            && inspectorExtrasCategory == inspCategory && inspectorExtrasShape == shape;
        if (!current) {
            int epoch = inspectorExtrasEpoch + 1;
            this.RetireInspectorFieldExtras();
            App afterInspApp = inspectorApp;
            if (inspectorInputGeneration != inputGeneration || inspectorExtrasEpoch != epoch
                    || inspectorExtrasRoot != null || inspectorView != scope
                    || !scope.IsActive() || afterInspApp != app || field != sel || inspTab != 0) { return; }
            inspectorExtrasApp = app;
            inspectorExtrasScope = scope;
            inspectorExtrasTarget = field;
            inspectorExtrasHost = host;
            inspectorExtrasKey = inspKeySeq;
            inspectorExtrasCategory = inspCategory;
            inspectorExtrasShape = shape;
            inspectorExtrasActions = new List<DesignerInspectorExtraAction>();
            inspectorExtrasPropRows = new List<DesignerInspectorExtraProp>();
            inspectorExtrasRoot = new Panel("designer-inspector-extras");
            inspectorExtrasRoot.name = "inspector-extras";
            inspectorExtrasRoot.SetProp("style", "display:flex;flex-direction:column;flex:0 0 auto;min-width:0;padding:0;gap:var(--gap-large);");
            inspectorExtrasCardsHost = Flex.Column();
            inspectorExtrasCardsHost.name = "inspector-cards-host";
            inspectorExtrasCardsHost.SetProp("style", "flex:0 0 auto;min-width:0;");
            inspectorExtrasRoot.Add(inspectorExtrasCardsHost);
            this.BuildInspectorExtraSections(field);
        }
        Panel root = inspectorExtrasRoot;
        if (root == null) { return; }
        if (root.parent != host) { host.Add(root); }
        if (!this.InspectorExtrasSessionCurrent()) { return; }
        int preparedEpoch = inspectorExtrasEpoch;
        this.PrepareInspectorCards(app, field, inspectorExtrasCardsHost);
        if (preparedEpoch != inspectorExtrasEpoch || !this.InspectorExtrasSessionCurrent()) { return; }
        if (inspectorExtrasStyle != null && inspectorExtrasStyleShadow != field.styleText) {
            this.RebuildInspectorStyleRows(field);
        }
        if (preparedEpoch != inspectorExtrasEpoch || !this.InspectorExtrasSessionCurrent()) { return; }
        this.SyncInspectorExtraProps(field);
        if (preparedEpoch != inspectorExtrasEpoch || !this.InspectorExtrasSessionCurrent()) { return; }
        if (inspectorExtrasBinding != null) {
            inspectorExtrasBinding.SetSelectedByText(field.BindingCount > 0 ? field.BindingAt(0).Path : "");
        }
        if (inspectorExtrasOptions != null && inspectorExtrasOptionsShape != this.InspectorOptionsShape(field)) {
            this.RebuildInspectorOptionRows(field);
        }
    }

    public void RetireInspectorFieldExtras() {
        Panel previous = inspectorExtrasRoot;
        List<DesignerInspectorExtraProp> props = inspectorExtrasPropRows;
        inspectorExtrasEpoch = inspectorExtrasEpoch + 1;
        inspectorExtrasRoot = null;
        inspectorExtrasTarget = null;
        inspectorExtrasHost = null;
        inspectorExtrasScope = null;
        inspectorExtrasApp = null;
        inspectorExtrasCardsHost = null;
        inspectorExtrasStyle = null;
        inspectorExtrasStyleRows = null;
        inspectorExtrasProps = null;
        inspectorExtrasOptions = null;
        inspectorExtrasOptionRows = null;
        inspectorExtrasBinding = null;
        inspectorExtrasAppend = null;
        inspectorExtrasAppendField = null;
        inspectorExtrasPropRows = null;
        inspectorExtrasActions = null;
        inspectorExtrasStyleInputs = null;
        inspectorExtrasShape = "";
        inspectorExtrasOptionsShape = "";
        // Invalidate before Remove releases focus/capture and can invoke user code.
        if (props != null) {
            for (int i = 0; i < props.Count; i = i + 1) {
                if (props[i] == null) { continue; }
                if (iconPickTarget == props[i].input) {
                    iconPickTarget = null;
                    if (iconWin != null) { iconWin.open = false; iconWin = null; }
                }
                if (assetPickTarget == props[i].input) {
                    assetPickTarget = null;
                    if (assetPicker != null) {
                        assetPicker.Accepted.Clear();
                        DesignerAssetPickerAction completion = new DesignerAssetPickerAction();
                        completion.owner = this;
                        assetPicker.Accepted.Add(completion.Run);
                    }
                }
            }
        }
        this.RetireInspectorCards();
        if (previous != null && previous.parent != null) { previous.parent.Remove(previous); }
    }

    Flex InspectorExtraColumn(Control parent, string name) {
        Flex column = Flex.Column();
        column.name = name;
        column.SetProp("style", "flex:0 0 auto;min-width:0;gap:var(--gap-medium);");
        parent.Add(column);
        return column;
    }

    Flex InspectorExtraRow(Control parent, string name) {
        Flex row = Flex.Row();
        row.name = name;
        row.Prefer(0, InspectorMetrics.RowHeight);
        row.SetProp("style", "flex:0 0 auto;min-width:0;gap:var(--gap-small);align-items:center;");
        parent.Add(row);
        return row;
    }

    Label InspectorExtraLabel(Control parent, string text, bool grow) {
        Label label = new Label(text);
        label.Class = "secondary small";
        if (grow) { label.SetProp("style", "flex:1;min-width:0;overflow:hidden;"); }
        else { label.SetProp("style", "flex-shrink:0;"); }
        parent.Add(label);
        return label;
    }

    DesignerInspectorExtraAction InspectorExtraAction(Control sender, Control section, string command, int index, string value) {
        DesignerInspectorExtraAction action = new DesignerInspectorExtraAction();
        action.owner = this;
        action.scope = inspectorExtrasScope;
        action.target = inspectorExtrasTarget;
        action.sender = sender;
        action.section = section;
        action.epoch = inspectorExtrasEpoch;
        action.keySequence = inspKeySeq;
        action.category = inspCategory;
        action.index = index;
        action.command = command;
        action.value = value;
        if (command.StartsWith("style-")) { action.sectionEpoch = inspectorExtrasStyleEpoch; }
        if (command.StartsWith("option-")) { action.sectionEpoch = inspectorExtrasOptionsEpoch; }
        inspectorExtrasActions.Add(action);
        return action;
    }

    Button InspectorExtraButton(Control parent, string name, string text, string command, int index, string value) {
        Button button = new Button(text);
        button.name = name;
        button.Class = "secondary small";
        button.SetProp("style", "flex-shrink:0;min-width:0;");
        parent.Add(button);
        DesignerInspectorExtraAction action = this.InspectorExtraAction(button, parent, command, index, value);
        button.OnClick(action.Run);
        return button;
    }

    void BuildInspectorExtraSections(FormField field) {
        if (inspCategory == 0 || inspCategory == 3) { this.BuildInspectorStyle(field); }
        if (inspCategory == 0 || inspCategory == 1 || inspCategory == 3) {
            this.BuildInspectorExtraProps(field);
        }
        if ((inspCategory == 0 || inspCategory == 4) && bindVars != null && bindVars.Count > 0) {
            Flex row = this.InspectorExtraRow(inspectorExtrasRoot, "inspector-binding-row");
            this.InspectorExtraLabel(row, Designer.T("BINDING", "数据绑定"), false);
            List<string> values = new List<string>();
            values.Add("");
            for (int i = 0; i < bindVars.Count; i = i + 1) { values.Add(bindVars[i]); }
            inspectorExtrasBinding = SelectBox.FromOptions(values, Designer.T("Pick from code", "从代码选择"));
            inspectorExtrasBinding.name = "inspector-binding";
            inspectorExtrasBinding.Size = "small";
            inspectorExtrasBinding.SetProp("style", "flex:1;min-width:0;");
            row.Add(inspectorExtrasBinding);
            DesignerInspectorExtraAction action = this.InspectorExtraAction(inspectorExtrasBinding, row, "binding", 0, "");
            inspectorExtrasBinding.OnChange(action.Run);
        }
        if (field.UsesOptions() && (inspCategory == 0 || inspCategory == 1 || inspCategory == 4)) {
            this.BuildInspectorOptions(field);
        }
    }

    bool InspectorExtraActionCurrent(DesignerInspectorExtraAction action) {
        if (action == null || action.command == null || inspectorExtrasActions == null) { return false; }
        Designer owner = action.owner;
        UiViewScope actScope = action.scope;
        UiViewScope curScope = inspectorExtrasScope;
        FormField target = action.target;
        FormField curTarget = inspectorExtrasTarget;
        if (owner != this || actScope != curScope || target == null || target != curTarget
                || action.epoch != inspectorExtrasEpoch
                || action.keySequence != inspKeySeq || action.category != inspCategory
                || !this.InspectorExtrasSessionCurrent() || !inspectorExtrasActions.Contains(action)) { return false; }
        Control sender = action.sender;
        Control section = action.section;
        if (sender == null || section == null || !sender.visible || sender.IsDisabled()) { return false; }
        if (inspectorRoot == null || inspectorExtrasRoot == null
                || !inspectorRoot.ContainsInputControl(inspectorExtrasRoot)
                || !inspectorExtrasRoot.ContainsInputControl(section)) { return false; }
        if (sender.parent == null && !action.command.StartsWith("prop-")) { return false; }
        if (sender.parent != null && !section.ContainsInputControl(sender)) { return false; }
        if (action.command.StartsWith("style-") && inspectorExtrasStyleShadow != target.styleText) { return false; }
        if (action.command.StartsWith("style-row-") && action.sectionEpoch != inspectorExtrasStyleEpoch) { return false; }
        if (action.command.StartsWith("option-row-") && (action.sectionEpoch != inspectorExtrasOptionsEpoch
                || inspectorExtrasOptionsShape != this.InspectorOptionsShape(target))) { return false; }
        return true;
    }

    public void InvokeInspectorExtraAction(DesignerInspectorExtraAction action) {
        if (!this.InspectorExtraActionCurrent(action)) { return; }
        FormField field = action.target;
        App app = inspectorExtrasApp;
        if (field == null) { return; }
        string command = action.command;
        if (command.StartsWith("style-")) { this.InvokeInspectorStyleAction(action); }
        else if (command.StartsWith("prop-")) { this.InvokeInspectorPropAction(action); }
        else if (command.StartsWith("option-")) { this.InvokeInspectorOptionAction(action); }
        else if (command == "props-dialog") { this.OpenPropsEditor(app, field); }
        else if (command == "unpack") {
            this.UnpackUserComponent(field);
            if (sel != field) { this.MarkDocDirty(); this.RetireInspectorFieldExtras(); }
        } else if (command == "binding" && inspectorExtrasBinding != null) {
            string value = inspectorExtrasBinding.SelectedText();
            string current = field.BindingCount > 0 ? field.BindingAt(0).Path : "";
            if (current != value) {
                this.BarrierInspectorUndo();
                if (!this.InspectorExtraActionCurrent(action)) { return; }
                if (value == "") { field.RemoveBindingAt(0); }
                else if (field.BindingCount > 0) { field.SetBindingPath(0, value); }
                else { field.BindPath(value); }
                msg = Designer.T("bound to ", "已绑定 ") + value;
                this.MarkDocDirty();
            }
        }
        if (app != null) { app.RequestRedraw(); }
    }
}
