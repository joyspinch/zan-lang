using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

namespace Gui.Designer;

partial class Designer {
    Panel inspectorRoot;
    Label inspectorTitle;
    Flex inspectorTabs;
    Flex inspectorCategories;
    List<Button> inspectorCategoryButtons;
    Button inspectorPropertiesTab;
    Button inspectorEventsTab;
    ScrollColumn inspectorBody;
    Flex inspectorFieldExtras;
    Flex inspectorWindowExtras;
    Label inspectorDeviceHint;
    Label inspectorLayoutHint;
    Label inspectorShapeHint;
    Label inspectorShapeValue;
    Button inspectorSaveComponent;
    List<DesignerInspectorEventRow> inspectorEventViews;
    UiViewScope inspectorView;
    ControlInputHost inspectorInputHost;
    weak App inspectorApp;
    weak FormField inspectorTarget;
    Rect inspectorRegion;
    string inspectorBodyKey;
    string inspectorEventSignature;
    bool inspectorReady;
    int inspectorInputGeneration;

    // Callback-bearing tree/input operations may synchronously prepare a new scope or target.
    bool InspectorInputCurrent(int generation, UiViewScope view, Control root, App app, FormField target) {
        return inspectorInputGeneration == generation && inspectorView == view && inspectorRoot == root
            && inspectorApp == app && sel == target
            && (view == null || root == null || !root.visible || view.IsActive());
    }
    UiViewActions inspectorEventTextAction;
    UiViewActions inspectorEventPickAction;
    UiViewActions inspectorEventJumpAction;
    UiViewActions inspectorEventOpenAction;
    UiViewActions inspectorEventCloseAction;

    public Control InspectorInputRoot() { return inspectorRoot; }

    public void InitializeInspectorInput(App app) {
        if (app == null) { return; }
        if (inspectorView != null && (inspectorApp != app || !inspectorView.IsActive())) {
            int retiring = inspectorInputGeneration + 1;
            this.RetireInspectorInput();
            if (inspectorInputGeneration != retiring || inspectorRoot != null) { return; }
        }
        if (inspectorRoot != null) { return; }
        inspectorInputGeneration = inspectorInputGeneration + 1;
        inspectorApp = app;
        inspectorRoot = new Panel("designer-inspector");
        inspectorRoot.SetProp("style", "display:flex;flex-direction:column;padding:var(--padding-medium);gap:var(--gap-medium);overflow:hidden;");
        inspectorTitle = new Label(""); inspectorTitle.Class = "tertiary small";
        inspectorTitle.name = "inspector-target";
        inspectorTabs = Flex.Row(); inspectorTabs.Gap(InspectorMetrics.GapInline);
        inspectorPropertiesTab = new Button(Designer.T("Properties", "属性"));
        inspectorPropertiesTab.name = "inspector-properties"; inspectorPropertiesTab.Grow();
        inspectorEventsTab = new Button(Designer.T("Events", "事件"));
        inspectorEventsTab.name = "inspector-events"; inspectorEventsTab.Grow();
        inspectorTabs.Add(inspectorPropertiesTab); inspectorTabs.Add(inspectorEventsTab);
        inspectorCategories = Flex.Row(); inspectorCategories.Gap(InspectorMetrics.GapMicro);
        inspectorCategoryButtons = new List<Button>();
        List<string> categories = new List<string>{ Designer.T("All", "全部"),
            Designer.T("Basic", "基础"), Designer.T("Layout", "布局"),
            Designer.T("Style", "样式"), Designer.T("Data", "数据") };
        for (int i = 0; i < categories.Count; i = i + 1) {
            Button button = new Button(categories[i]); button.Grow();
            button.name = "inspector-category-" + Convert.ToString(i);
            inspectorCategoryButtons.Add(button); inspectorCategories.Add(button);
        }
        inspectorBody = new ScrollColumn(); inspectorBody.name = "inspector-body"; inspectorBody.Grow();
        inspectorFieldExtras = Flex.Column(); inspectorFieldExtras.Gap(InspectorMetrics.GapStack);
        inspectorFieldExtras.name = "inspector-field-extras";
        inspectorWindowExtras = Flex.Column(); inspectorWindowExtras.Gap(InspectorMetrics.GapStack);
        inspectorDeviceHint = new Label(""); inspectorDeviceHint.Class = "tertiary small";
        inspectorLayoutHint = new Label(Designer.T("Prefer flow layout (wrap/span) for multi-size targets.",
            "多尺寸目标建议流式布局（wrap/span）。")); inspectorLayoutHint.Class = "secondary small";
        inspectorShapeHint = new Label(Designer.T("Union of regions (JSON)", "区域并集（JSON）"));
        inspectorShapeHint.Class = "secondary small";
        inspectorShapeValue = new Label(""); inspectorShapeValue.Class = "tertiary small";
        inspectorSaveComponent = new Button(Designer.T("Save as component", "保存为组件"));
        inspectorSaveComponent.Class = "primary small"; inspectorSaveComponent.name = "inspector-save-component";
        inspectorTitle.SetProp("style", "flex-shrink:0;");
        inspectorTabs.SetProp("style", "flex-shrink:0;");
        inspectorCategories.SetProp("style", "flex-shrink:0;");
        inspFilterInput.SetProp("style", "flex-shrink:0;");
        inspectorBody.SetProp("style", "flex:1;min-height:0;");
        inspectorRoot.Add(inspectorTitle); inspectorRoot.Add(inspectorTabs);
        inspectorRoot.Add(inspectorCategories);
        int initializing = inspectorInputGeneration; Panel initializingRoot = inspectorRoot;
        initializingRoot.Add(inspFilterInput);
        if (inspectorInputGeneration != initializing || inspectorRoot != initializingRoot) { return; }
        initializingRoot.Add(inspectorBody);
        if (inspectorInputGeneration != initializing || inspectorRoot != initializingRoot) { return; }
        inspectorEventViews = new List<DesignerInspectorEventRow>();
        inspectorView = new UiViewScope(app, this, inspectorRoot);
        inspectorEventTextAction = inspectorView.Action("inspector-event-text", null);
        inspectorEventPickAction = inspectorView.Action("inspector-event-pick", null);
        inspectorEventJumpAction = inspectorView.Action("inspector-event-jump", null);
        inspectorEventOpenAction = inspectorView.Action("inspector-event-open", null);
        inspectorEventCloseAction = inspectorView.Action("inspector-event-close", null);
        inspectorInputHost = new ControlInputHost(inspectorRoot);
        inspectorPropertiesTab.OnClick(inspectorView.Action("inspector-properties", inspectorPropertiesTab).Run);
        inspectorEventsTab.OnClick(inspectorView.Action("inspector-events", inspectorEventsTab).Run);
        for (int i = 0; i < inspectorCategoryButtons.Count; i = i + 1) {
            Button button = inspectorCategoryButtons[i];
            button.OnClick(inspectorView.Action("inspector-category", button).Run);
        }
        inspFilterInput.OnChange(inspectorView.Action("inspector-filter", inspFilterInput).Run);
        inspectorSaveComponent.OnClick(inspectorView.Action("inspector-save", inspectorSaveComponent).Run);
        inspectorBodyKey = ""; inspectorEventSignature = "";
        inspectorRoot.visible = false;
    }

    // The embedded host shares CanvasRegion's three-column calculation.
    public Rect InspectorRegion(App app, Rect host) {
        if (app == null || host == null || hostPanels || host.width <= 0 || host.height <= 0) { return null; }
        Rect canvas = this.CanvasRegion(app, host);
        int left = canvas.x + canvas.width + app.Scale(12);
        int width = host.x + host.width - app.Scale(24) - left;
        int height = host.y + host.height - app.Scale(32) - app.Scale(4) - canvas.y;
        if (width < 20 || height < 20) { return null; }
        return new Rect(left, canvas.y, width, height);
    }

    public void PrepareInspectorInput(App app, Rect region) {
        if (app == null || region == null || region.width < 20 || region.height < 20) {
            this.SuspendInspectorInput(); return;
        }
        if (inspectorView != null && (inspectorApp != app || !inspectorView.IsActive())) {
            int retiring = inspectorInputGeneration + 1;
            this.RetireInspectorInput();
            if (inspectorInputGeneration != retiring || inspectorRoot != null) { return; }
        }
        this.InitializeInspectorInput(app);
        UiViewScope view = inspectorView; Panel root = inspectorRoot; FormField target = sel;
        if (view == null || !view.IsActive() || root == null || inspectorApp != app) { return; }
        int generation = inspectorInputGeneration + 1; inspectorInputGeneration = generation;
        inspectorRegion = region; root.visible = true;
        inspectorInputHost.Bind(app);
        if (!this.InspectorInputCurrent(generation, view, root, app, target)) { return; }
        this.PrepareInspectorView(view, app);
    }

    public void SuspendInspectorInput() {
        if (inspectorRegion == null && !inspectorReady && inspectorRoot != null && !inspectorRoot.visible) { return; }
        int generation = inspectorInputGeneration + 1; inspectorInputGeneration = generation;
        UiViewScope view = inspectorView; Panel root = inspectorRoot; App app = inspectorApp; FormField target = sel;
        ScrollColumn body = inspectorBody; ControlInputHost input = inspectorInputHost;
        inspectorReady = false; inspectorRegion = null;
        if (root != null) { root.visible = false; }
        if (input != null) { input.Hide(); }
        if (!this.InspectorInputCurrent(generation, view, root, app, target)) { return; }
        if (body != null && !this.SetInspectorChildren(body, new List<Control>())) { return; }
        this.RetireInspectorFieldExtras();
        if (!this.InspectorInputCurrent(generation, view, root, app, target)) { return; }
        if (propGrid != null) { propGrid.Bind("retired", new List<PropSpec>()); }
        if (!this.InspectorInputCurrent(generation, view, root, app, target)) { return; }
        inspectorEventViews = new List<DesignerInspectorEventRow>(); inspectorEventGroupLabels = null;
        eventEditRows = new List<EventEditRow>(); eventEditRowsTarget = "";
        inspectorEventSignature = ""; inspectorBodyKey = ""; inspectorTarget = null;
        inspKeySeq = inspKeySeq + 1;
        undoSession = ""; undoSessionPushed = false;
        activeEventDropdown = "";
    }

    public void RetireInspectorInput() {
        int generation = inspectorInputGeneration + 1; inspectorInputGeneration = generation;
        UiViewScope view = inspectorView; ControlInputHost input = inspectorInputHost;
        Panel root = inspectorRoot; App app = inspectorApp; FormField target = sel;
        inspectorReady = false;
        if (root != null) { root.visible = false; }
        this.RetireInspectorFieldExtras();
        if (!this.InspectorInputCurrent(generation, view, root, app, target)) { return; }
        if (propGrid != null) { propGrid.Bind("retired", new List<PropSpec>()); }
        if (!this.InspectorInputCurrent(generation, view, root, app, target)) { return; }
        List<Control> previousChildren = new List<Control>();
        if (root != null) {
            for (int i = 0; i < root.ChildCount(); i = i + 1) { previousChildren.Add(root.ChildAt(i)); }
        }
        inspectorView = null; inspectorInputHost = null;
        eventEditRows = new List<EventEditRow>(); eventEditRowsTarget = "";
        undoSession = ""; undoSessionPushed = false; inspKeySeq = inspKeySeq + 1;
        inspectorRoot = null; inspectorRegion = null; inspectorApp = null; inspectorTarget = null;
        inspectorEventViews = null; inspectorEventGroupLabels = null;
        inspectorEventTextAction = null; inspectorEventPickAction = null; inspectorEventJumpAction = null;
        inspectorEventOpenAction = null; inspectorEventCloseAction = null;
        inspectorBody = null; inspectorFieldExtras = null;
        inspectorWindowExtras = null; inspectorBodyKey = ""; inspectorEventSignature = "";
        inspectorTitle = null; inspectorTabs = null; inspectorCategories = null;
        inspectorCategoryButtons = null; inspectorPropertiesTab = null; inspectorEventsTab = null;
        inspectorDeviceHint = null; inspectorLayoutHint = null; inspectorShapeHint = null;
        inspectorShapeValue = null; inspectorSaveComponent = null;
        activeEventDropdown = "";
        // From here cleanup owns only captured old objects; callbacks may install a new scope.
        if (view != null) { view.Retire(); }
        if (input != null) { input.Hide(); }
        if (inspectorInputGeneration != generation) { return; }
        for (int i = 0; i < previousChildren.Count; i = i + 1) {
            Control child = previousChildren[i];
            if (child.parent == root) { root.Remove(child); }
            if (inspectorInputGeneration != generation) { return; }
        }
    }

    void ResetInspectorScroll() {
        undoSession = ""; undoSessionPushed = false;
        inspectorBodyKey = "";
        if (inspectorBody != null) { inspectorBody.SetScrollTop(0); }
    }

    // Reconcile only structural changes. Kept children retain focus, capture and editor identity.
    bool SetInspectorChildren(Control parent, List<Control> children) {
        int generation = inspectorInputGeneration;
        UiViewScope view = inspectorView; Control root = inspectorRoot; App app = inspectorApp; FormField target = sel;
        List<Control> previous = new List<Control>();
        for (int i = 0; i < parent.ChildCount(); i = i + 1) { previous.Add(parent.ChildAt(i)); }
        for (int i = previous.Count - 1; i >= 0; i = i - 1) {
            Control child = previous[i];
            if (!children.Contains(child) && child.parent == parent) { parent.Remove(child); }
            if (!this.InspectorInputCurrent(generation, view, root, app, target)) { return false; }
        }
        for (int i = 0; i < children.Count; i = i + 1) {
            Control child = children[i];
            if (child.parent != parent) { parent.Add(child); }
            if (!this.InspectorInputCurrent(generation, view, root, app, target)) { return false; }
            parent.MoveChild(child, i);
            if (!this.InspectorInputCurrent(generation, view, root, app, target)) { return false; }
        }
        return true;
    }

    public bool PrepareInspectorView(UiViewScope view, App app) {
        if (view != inspectorView) { return false; }
        inspectorReady = false;
        if (view == null || !view.IsActive() || inspectorApp != app || inspectorRegion == null
                || inspectorRoot == null || !inspectorRoot.visible) { return true; }
        int generation = inspectorInputGeneration + 1; inspectorInputGeneration = generation;
        Control root = inspectorRoot; FormField target = sel; Rect region = inspectorRegion;
        bool targetChanged = inspectorTarget != target;
        if (targetChanged) {
            this.RetireInspectorFieldExtras();
            if (!this.InspectorInputCurrent(generation, view, root, app, target)) { return true; }
            propGrid.Bind("retired", new List<PropSpec>());
            if (!this.InspectorInputCurrent(generation, view, root, app, target)) { return true; }
            inspectorTarget = target; inspectorEventSignature = ""; this.ResetInspectorScroll();
            if (!this.InspectorInputCurrent(generation, view, root, app, target)) { return true; }
        }
        string title = Designer.T("WINDOW", "窗口") + "  ·  " + winTitle;
        if (sel != null) {
            string kind = sel.IsCustom() ? sel.kind : FormField.TypeName(sel.ftype);
            title = Designer.T("COMPONENT", "组件") + "  ·  " + kind;
            if (freeExtra != null && freeExtra.Count > 0) {
                title = title + Designer.T(" (+", " (+") + Convert.ToString(freeExtra.Count)
                    + Designer.T(" selected)", " 个已选)");
            }
        }
        inspectorTitle.SetProp("text", title);
        inspectorPropertiesTab.Class = inspTab == 0 ? "primary small" : "secondary small";
        inspectorEventsTab.Class = inspTab == 1 ? "primary small" : "secondary small";
        inspectorCategories.visible = inspTab == 0 && sel != null;
        for (int i = 0; i < inspectorCategoryButtons.Count; i = i + 1) {
            inspectorCategoryButtons[i].Class = inspCategory == i ? "primary small" : "secondary small";
        }
        string filter = inspFilterInput.GetText().Trim().ToLower();
        string bodyKey = Convert.ToString(inspTab) + "|" + Convert.ToString(inspCategory) + "|" + filter;
        if (inspectorBodyKey != bodyKey) {
            inspectorBody.SetScrollTop(0);
            if (!this.InspectorInputCurrent(generation, view, root, app, target)) { return true; }
            inspectorBodyKey = bodyKey;
        }
        if (inspTab == 1) {
            this.RetireInspectorFieldExtras();
            if (!this.InspectorInputCurrent(generation, view, root, app, target)) { return true; }
            if (!this.PrepareInspectorEvents(app, filter)) { return true; }
        } else {
            List<Control> children = new List<Control>(); children.Add(propGrid);
            if (sel == null) {
                if (selPrev != null || targetChanged) { selPrev = null; inspKeySeq = inspKeySeq + 1; }
                string key = "win" + Convert.ToString(inspKeySeq);
                DeviceProfile profile = DeviceProfile.ById(device);
                if (profile != null && profile.Locked()) { key = key + "l"; }
                propGrid.Bind(key, this.FilterWindowInspectorSpecs(filter));
                if (!this.InspectorInputCurrent(generation, view, root, app, target)) { return true; }
                if (!this.PrepareWindowInspectorExtras()) { return true; }
                children.Add(inspectorWindowExtras);
            } else {
                this.SyncEditors(target);
                propGrid.Bind("fld" + Convert.ToString(inspKeySeq), this.FieldSpecs(target));
                if (!this.InspectorInputCurrent(generation, view, root, app, target)) { return true; }
                this.PrepareInspectorFieldExtras(app, target, inspectorFieldExtras);
                if (!this.InspectorInputCurrent(generation, view, root, app, target)) { return true; }
                children.Add(inspectorFieldExtras);
            }
            if (!this.SetInspectorChildren(inspectorBody, children)) { return true; }
        }
        if (!this.InspectorInputCurrent(generation, view, root, app, target) || !view.IsActive()
                || inspectorRegion != region) { return true; }
        bool ready = view.Layout(region.x, region.y, region.width, region.height);
        if (this.InspectorInputCurrent(generation, view, root, app, target) && inspectorRegion == region) {
            inspectorReady = ready;
        }
        return true;
    }

    List<PropSpec> FilterWindowInspectorSpecs(string filter) {
        List<PropSpec> specs = this.WindowSpecs();
        if (filter == "") { return specs; }
        List<PropSpec> selected = new List<PropSpec>();
        for (int i = 0; i < specs.Count; i = i + 1) {
            PropSpec spec = specs[i];
            if (spec.key.ToLower().Contains(filter) || spec.label.ToLower().Contains(filter)) { selected.Add(spec); }
        }
        return selected;
    }

    bool PrepareWindowInspectorExtras() {
        List<Control> children = new List<Control>();
        DeviceProfile profile = DeviceProfile.ById(device);
        if (profile != null && profile.Locked()) {
            inspectorDeviceHint.SetProp("text", Designer.T("Canvas ", "画布 ") + Convert.ToString(winW) + " × "
                + Convert.ToString(winH) + Designer.T(" (locked by device)", "（由设备锁定）"));
            children.Add(inspectorDeviceHint);
        }
        if ((device == "phone" || device == "tablet") && layoutMode == 1) { children.Add(inspectorLayoutHint); }
        if (winShape == 3) {
            inspectorShapeValue.SetProp("text", winShapeSpec); children.Add(inspectorShapeHint); children.Add(inspectorShapeValue);
        }
        children.Add(inspectorSaveComponent);
        return this.SetInspectorChildren(inspectorWindowExtras, children);
    }

    public bool InspectorAction(string name, Control sender) {
        if (!name.StartsWith("inspector-")) { return false; }
        if (inspectorView == null || !inspectorView.IsActive() || inspectorRegion == null || inspectorRoot == null
                || !inspectorRoot.visible) { return true; }
        inspectorInputGeneration = inspectorInputGeneration + 1;
        if (name == "inspector-properties" || name == "inspector-events") {
            int tab = name == "inspector-events" ? 1 : 0;
            if (inspTab != tab) { inspTab = tab; activeEventDropdown = ""; this.ResetInspectorScroll(); }
        } else if (name == "inspector-category") {
            for (int i = 0; i < inspectorCategoryButtons.Count; i = i + 1) {
                if (sender == inspectorCategoryButtons[i] && inspCategory != i) {
                    inspCategory = i; this.ResetInspectorScroll(); break;
                }
            }
        } else if (name == "inspector-filter") { this.ResetInspectorScroll(); }
        else if (name == "inspector-save" && inspTab == 0 && sel == null) {
            saveCompRequested = true; msg = Designer.T("saving as component…", "正在保存为组件…");
        } else { this.InspectorEventAction(name, sender); }
        return true;
    }

    public bool InspectorPointer(Control sender, RoutedEventArgs args) { return false; }
}
