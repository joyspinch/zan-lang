using System;

namespace System.IO;

// 路径操作工具。完整路径按当前工作目录解析，不要求目标存在；
// Windows 的完整路径与临时目录查询使用 UTF-16 系统接口。
class Path {
    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "GetTempPathW")]
    static extern int WinGetTempPath(int bufLen, nint buf);

    [DllImport("kernel32", EntryPoint = "GetFullPathNameW")]
    static extern int WinGetFullPathName(nint path, int bufLen, nint buf, nint filePart);
    #endif

    // 最后一个分隔符之后的索引，没有分隔符时为 0。
    static int AfterLastSeparator(string path) {
        for (int i = path.Length - 1; i >= 0; i = i - 1) {
            if (Path.IsDirectorySeparator(path[i] & 255)) { return i + 1; }
        }
        return 0;
    }

    // 从路径中返回文件名（含扩展名）。
    static string GetFileName(string path) {
        int start = Path.AfterLastSeparator(path);
        if (start == 0) { return path; }
        return path.Substring(start, path.Length - start);
    }

    // 返回扩展名（含点）。
    static string GetExtension(string path) {
        string fname = Path.GetFileName(path);
        int dot = fname.LastIndexOf(".");
        if (dot < 0) { return ""; }
        return fname.Substring(dot, fname.Length - dot);
    }

    // 平台目录分隔符。
    static string Separator() {
        #if WINDOWS
        return "\\";
        #else
        return "/";
        #endif
    }

    // 拼接路径；第二个路径有根时直接返回它，空路径不添加分隔符。
    // 保留输入中的分隔符，仅在连接处缺少分隔符时添加一个。
    static string Combine(string path1, string path2) {
        if (path1 == null || path2 == null) {
            throw new ArgumentException("path must not be null");
        }
        if (path2.Length == 0) { return path1; }
        if (path1.Length == 0 || Path.IsPathRooted(path2)) { return path2; }
        int last = path1[path1.Length - 1] & 255;
        if (Path.IsDirectorySeparator(last)) { return path1 + path2; }
        return path1 + Path.Separator() + path2;
    }

    // 检查路径是否有根。Windows 的盘符相对路径（C:foo）也有根，
    // 但仍需要当前目录解析；POSIX 只有 / 是分隔符。
    static bool IsPathRooted(string path) {
        if (path == null || path.Length == 0) { return false; }
        if (Path.IsDirectorySeparator(path[0] & 255)) { return true; }
        #if WINDOWS
        if (path.Length >= 2 && (path[1] & 255) == 58) {
            int drive = path[0] & 255;
            return (drive >= 65 && drive <= 90) || (drive >= 97 && drive <= 122);
        }
        #endif
        return false;
    }

    private static bool IsDirectorySeparator(int c) {
        if (c == 47) { return true; }
        #if WINDOWS
        return c == 92;
        #else
        return false;
        #endif
    }

    // 按当前工作目录解析完整路径，不要求文件或目录存在。
    // 空路径或含 NUL 的路径抛 ArgumentException，系统查询失败抛 IOException。
    static string GetFullPath(string path) {
        if (path == null || path.Length == 0) {
            throw new ArgumentException("path must not be empty");
        }
        for (int i = 0; i < path.Length; i = i + 1) {
            if ((path[i] & 255) == 0) {
                throw new ArgumentException("path must not contain NUL");
            }
        }
        #if WINDOWS
        nint input = Wide.Of(path);
        try {
            int size = 256;
            while (true) {
                nint buf = NativeMemory.Alloc(size * 2);
                try {
                    int n = Path.WinGetFullPathName(input, size, buf, 0);
                    if (n <= 0) { throw new IOException("Could not resolve full path: " + path); }
                    if (n < size) { return Wide.Read(buf); }
                    if (n >= 1073741823) { throw new IOException("Full path is too long"); }
                    size = n + 1;
                } finally {
                    NativeMemory.Free(buf);
                }
            }
        } finally {
            Wide.Free(input);
        }
        #else
        string full = path;
        if (!Path.IsPathRooted(full)) {
            string cwd = Directory.GetCurrentDirectory();
            if (cwd == null || !Path.IsPathRooted(cwd)) {
                throw new IOException("Could not get current directory");
            }
            full = Path.Combine(cwd, full);
        }
        // 不调用 realpath：新文件也可解析，反斜杠与符号链接不改变词法路径。
        List<string> parts = new List<string>();
        int start = 0;
        for (int i = 0; i <= full.Length; i = i + 1) {
            if (i < full.Length && (full[i] & 255) != 47) { continue; }
            string part = full.Substring(start, i - start);
            start = i + 1;
            if (part == "" || part == ".") { continue; }
            if (part == "..") {
                if (parts.Count > 0) { parts.RemoveAt(parts.Count - 1); }
            } else {
                parts.Add(part);
            }
        }
        StringBuilder sb = new StringBuilder();
        sb.Append("/");
        for (int i = 0; i < parts.Count; i = i + 1) {
            if (i > 0) { sb.Append("/"); }
            sb.Append(parts[i]);
        }
        if (parts.Count > 0 && full.EndsWith("/")) { sb.Append("/"); }
        return sb.ToString();
        #endif
    }

    // 返回路径的目录部分。
    static string GetDirectoryName(string path) {
        int start = Path.AfterLastSeparator(path);
        if (start == 0) { return ""; }
        return path.Substring(0, start - 1);
    }

    // 返回不含扩展名的文件名。
    static string GetFileNameWithoutExtension(string path) {
        string fname = Path.GetFileName(path);
        int dot = fname.LastIndexOf(".");
        if (dot < 0) { return fname; }
        return fname.Substring(0, dot);
    }

    // 更改路径字符串的扩展名。
    static string ChangeExtension(string path, string extension) {
        int dot = path.LastIndexOf(".");
        int sepAt = Path.AfterLastSeparator(path);
        if (dot < sepAt) { dot = -1; }
        if (dot < 0) { return path + extension; }
        return path.Substring(0, dot) + extension;
    }

    // 检查路径是否带扩展名。
    static bool HasExtension(string path) {
        return Path.GetExtension(path) != "";
    }

    // 获取带末尾目录分隔符的系统临时目录路径；Windows 查询失败返回空串。
    static string GetTempPath() {
        #if WINDOWS
        int size = 256;
        while (true) {
            nint buf = NativeMemory.Alloc(size * 2);
            try {
                int n = Path.WinGetTempPath(size, buf);
                if (n <= 0) { return ""; }
                if (n < size) {
                    string t = Wide.Read(buf);
                    if (t.Length == 0 || t.EndsWith("\\") || t.EndsWith("/")) { return t; }
                    return t + "\\";
                }
                if (n >= 1073741823) { return ""; }
                size = n + 1;
            } finally {
                NativeMemory.Free(buf);
            }
        }
        #else
        string t = Interop.EnvVar("TMPDIR");
        if (t == "") { return "/tmp/"; }
        if (t.EndsWith("/")) { return t; }
        return t + "/";
        #endif
    }

    // 将路径分隔符规范化为平台分隔符。
    static string Normalize(string path) {
        if (path == null) { return ""; }
        string sep = Path.Separator();
        if (sep == "\\") {
            if (path.IndexOf("/") < 0) { return path; }
            return path.Replace("/", "\\");
        } else {
            if (path.IndexOf("\\") < 0) { return path; }
            return path.Replace("\\", "/");
        }
    }

    // 返回从 relativeTo 目录到 path 的相对路径（等同于现代 C# 的 Path.GetRelativePath）。
    // 两者按段拆分；公共前缀被去掉，剩余部分用 "../" 跳转连接。Windows 盘符不区分大小写比较。
    static string GetRelativePath(string relativeTo, string path) {
        string sep = "/";
        if (Path.IndexOf(relativeTo, "\\", 0) >= 0 || Path.IndexOf(path, "\\", 0) >= 0) {
            sep = "\\";
        }
        List<string> a = Path.SplitSegments(relativeTo);
        List<string> b = Path.SplitSegments(path);
        int common = 0;
        for (; common < a.Count && common < b.Count && Path.Same(a[common], b[common]); common = common + 1) {
        }
        List<string> parts = new List<string>();
        int up = a.Count - common;
        int k = 0;
        for (; k < up; k = k + 1) {
            parts.Add("..");
        }
        int j = common;
        while (j < b.Count) {
            parts.Add(b[j]);
            j = j + 1;
        }
        if (parts.Count == 0) { return "."; }
        StringBuilder sb = new StringBuilder();
        k = 0;
        while (k < parts.Count) {
            if (k > 0) { sb.Append(sep); }
            sb.Append(parts[k]);
            k = k + 1;
        }
        return sb.ToString();
    }

    // 规范化路径并解析 . 与 .. 段（"a/./b/../c" -> "a/c"）。
    // 无法解析的前导 .. 会保留。分隔符按输入原样保留。
    static string Clean(string path) {
        if (path == null || path.Length == 0) { return ""; }
        string sep = "/";
        if (Path.IndexOf(path, "\\", 0) >= 0) { sep = "\\"; }
        int c0 = path[0] & 255;
        bool rooted = (c0 == 47 || c0 == 92 || (path.Length > 1 && (path[1] & 255) == 58));
        List<string> segs = Path.SplitSegments(path);
        List<string> outSegs = new List<string>();
        int i = 0;
        for (; i < segs.Count; i = i + 1) {
            string seg = segs[i];
            if (seg == "." || seg == "") {
                // 跳过
            } else if (seg == "..") {
                if (outSegs.Count > 0 && outSegs[outSegs.Count - 1] != "..") {
                    outSegs.RemoveAt(outSegs.Count - 1);
                } else if (!rooted) {
                    outSegs.Add("..");
                }
            } else {
                outSegs.Add(seg);
            }
        }
        StringBuilder sb = new StringBuilder();
        i = 0;
        while (i < outSegs.Count) {
            if (i > 0) { sb.Append(sep); }
            sb.Append(outSegs[i]);
            i = i + 1;
        }
        return sb.ToString();
    }

    // 当 path 匹配 glob 模式 pattern 时为真。两者都接受
    // / 或 \ 分隔符。* 匹配单个路径段内，? 匹配一个字符，** 匹配零个或多个路径段。
    static bool IsMatch(string pattern, string path) {
        List<string> pat = Path.SplitSegments(pattern);
        List<string> pth = Path.SplitSegments(path);
        return Path.MatchSegments(pat, 0, pth, 0);
    }

    // 当 path 是 dir 的目录前缀（或等于 dir）时为真，
    // 在 Windows 上按段不区分大小写比较。
    static bool IsUnder(string dir, string path) {
        List<string> a = Path.SplitSegments(dir);
        List<string> b = Path.SplitSegments(path);
        if (b.Count < a.Count) { return false; }
        for (int i = 0; i < a.Count; i = i + 1) {
            if (!Path.Same(a[i], b[i])) { return false; }
        }
        return true;
    }

    // 按段递归匹配；"**" 消耗零个或多个路径段。
    static bool MatchSegments(List<string> pat, int pi, List<string> pth, int ti) {
        if (pi >= pat.Count) { return ti >= pth.Count; }
        string p = pat[pi];
        if (p == "**") {
            for (int k = 0; ti + k <= pth.Count; k = k + 1) {
                if (Path.MatchSegments(pat, pi + 1, pth, ti + k)) { return true; }
            }
            return false;
        }
        if (ti >= pth.Count) { return false; }
        if (!Path.SegmentMatch(p, pth[ti])) { return false; }
        return Path.MatchSegments(pat, pi + 1, pth, ti + 1);
    }

    // 单段通配符匹配：'*' 匹配任意字符序列，'?' 匹配单个字符。
    // Windows 上不区分大小写。
    static bool SegmentMatch(string pattern, string segment) {
        return Path.SegMatch(pattern, 0, segment, 0);
    }

    // 单段匹配的回溯实现；连续 '*' 合并后尝试任意长度。
    static bool SegMatch(string pat, int pi, string seg, int si) {
        if (pi >= pat.Length) { return si >= seg.Length; }
        int pc = pat[pi] & 255;
        if (pc == 42) { // '*'
            while (pi < pat.Length && (pat[pi] & 255) == 42) { pi = pi + 1; }
            for (int k = 0; si + k <= seg.Length; k = k + 1) {
                if (Path.SegMatch(pat, pi, seg, si + k)) { return true; }
            }
            return false;
        }
        if (si >= seg.Length) { return false; }
        if (pc == 63) { // '?'
            return Path.SegMatch(pat, pi + 1, seg, si + 1);
        }
        if (!Path.CharEqual(pc, seg[si] & 255)) { return false; }
        return Path.SegMatch(pat, pi + 1, seg, si + 1);
    }

    // 按 '/' 或 '\' 拆分路径（根路径保留空段）。
    static List<string> SplitSegments(string path) {
        List<string> segs = new List<string>();
        if (path == null) { return segs; }
        int len = path.Length;
        int last = 0;
        for (int i = 0; i < len; i = i + 1) {
            int c = path[i] & 255;
            if (c == 47 || c == 92) {
                segs.Add(path.Substring(last, i - last));
                last = i + 1;
            }
        }
        segs.Add(path.Substring(last, len - last));
        return segs;
    }

    // 段比较；Windows 上不区分大小写。
    static bool Same(string a, string b) {
        #if WINDOWS
        return a.ToLower() == b.ToLower();
        #else
        return a == b;
        #endif
    }

    // 单字符比较；Windows 上不区分大小写。
    static bool CharEqual(int a, int b) {
        if (a == b) { return true; }
        #if WINDOWS
        if (a >= 65 && a <= 90) { a = a + 32; }
        if (b >= 65 && b <= 90) { b = b + 32; }
        return a == b;
        #else
        return false;
        #endif
    }

    // 从 from 起查找子串；没有时返回 -1。
    static int IndexOf(string hay, string needle, int from) {
        if (hay == null || needle == null) { return -1; }
        if (from < 0) { from = 0; }
        if (from > hay.Length) { return -1; }
        return hay.IndexOf(needle, from);
    }
}
