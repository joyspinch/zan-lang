using System;
using System.IO;

namespace System.IO;

/// <summary>
/// 常见的用户/系统文件夹，以及环境变量访问。
///
/// Windows 主目录与应用数据目录通过环境变量解析，桌面/文档/下载
/// 使用主目录下的默认位置；Linux 遵循 XDG 与 user-dirs.dirs 重定向；
/// macOS 应用数据使用 ~/Library/Application Support。查询不创建目录，
/// 无法解析时返回“”。
///
/// 核心契约与语义定义。
/// 核心契约与语义定义。
/// </summary>
class KnownFolders {
    /// 用户主目录（Windows：%USERPROFILE%；POSIX：$HOME）。
    static string Home() {
        #if WINDOWS
        string p = Interop.EnvVar("USERPROFILE");
        if (p != "") { return p; }
        return Interop.EnvVar("HOMEDRIVE") + Interop.EnvVar("HOMEPATH");
        #else
        return Interop.EnvVar("HOME");
        #endif
    }

    /// 用户桌面文件夹；Linux 遵循 user-dirs.dirs。
    static string Desktop() {
        #if LINUX
        return KnownFolders.XdgUserDirectory("XDG_DESKTOP_DIR", "Desktop");
        #else
        return KnownFolders.HomeChild("Desktop");
        #endif
    }

    /// 用户文档文件夹；Linux 遵循 user-dirs.dirs。
    static string Documents() {
        #if LINUX
        return KnownFolders.XdgUserDirectory("XDG_DOCUMENTS_DIR", "Documents");
        #else
        return KnownFolders.HomeChild("Documents");
        #endif
    }

    /// 用户下载文件夹；Linux 遵循 user-dirs.dirs。
    static string Downloads() {
        #if LINUX
        return KnownFolders.XdgUserDirectory("XDG_DOWNLOAD_DIR", "Downloads");
        #else
        return KnownFolders.HomeChild("Downloads");
        #endif
    }

    /// 用户配置/应用数据（Windows：%APPDATA%；Linux：XDG_CONFIG_HOME
    /// 或 ~/.config；macOS：~/Library/Application Support，无漫游/本地之分）。
    static string AppData() {
        #if WINDOWS
        return Interop.EnvVar("APPDATA");
        #elif MACOS
        return KnownFolders.HomeChild("Library/Application Support");
        #else
        return KnownFolders.XdgBaseDirectory("XDG_CONFIG_HOME", ".config");
        #endif
    }

    /// 本地应用数据（Windows：%LOCALAPPDATA%；Linux：XDG_DATA_HOME
    /// 或 ~/.local/share；macOS：~/Library/Application Support）。
    static string LocalAppData() {
        #if WINDOWS
        return Interop.EnvVar("LOCALAPPDATA");
        #elif MACOS
        return KnownFolders.HomeChild("Library/Application Support");
        #else
        return KnownFolders.XdgBaseDirectory("XDG_DATA_HOME", ".local/share");
        #endif
    }

    private static string HomeChild(string name) {
        string home = KnownFolders.Home();
        if (home == "") { return ""; }
        return Path.Combine(home, name);
    }

    #if !WINDOWS && !MACOS
    private static string XdgBaseDirectory(string variable, string fallback) {
        string path = Interop.EnvVar(variable);
        // XDG 要求绝对路径；相对环境值无效，不能随工作目录漂移。
        if (path.StartsWith("/")) { return path; }
        return KnownFolders.HomeChild(fallback);
    }
    #endif

    #if LINUX
    private static string XdgUserDirectory(string variable, string fallback) {
        string home = KnownFolders.Home();
        string config = KnownFolders.AppData();
        string result = "";
        if (config.StartsWith("/")) {
            string file = Path.Combine(config, "user-dirs.dirs");
            try {
                List<string> lines = File.ReadAllLines(file);
                for (int i = 0; i < lines.Count; i = i + 1) {
                    string line = lines[i].Trim();
                    if (line == "" || line.StartsWith("#")) { continue; }
                    int eq = line.IndexOf("=");
                    if (eq < 0 || line.Substring(0, eq).Trim() != variable) { continue; }
                    string value = KnownFolders.XdgUserValue(
                        line.Substring(eq + 1, line.Length - eq - 1).Trim(), home);
                    if (value != "") { result = value; }
                }
            } catch (IOException ex) {
                // 可选配置缺失或不可读时使用默认目录，不创建或执行配置。
            }
        }
        if (result != "") { return result; }
        return KnownFolders.HomeChild(fallback);
    }

    private static string XdgUserValue(string text, string home) {
        if (text.Length < 2 || (text[0] & 255) != 34) { return ""; }
        int start = 1;
        StringBuilder sb = new StringBuilder();
        if (text.StartsWith("\"$HOME")) {
            if (home == "" || text.Length < 7) { return ""; }
            int afterHome = text[6] & 255;
            if (afterHome != 47 && afterHome != 34) { return ""; }
            sb.Append(home);
            start = 6;
        } else if ((text[1] & 255) != 47) {
            return "";
        }
        int chunk = start;
        for (int i = start; i < text.Length; i = i + 1) {
            int c = text[i] & 255;
            if (c == 34) {
                if (i > chunk) { sb.Append(text.Substring(chunk, i - chunk)); }
                string rest = text.Substring(i + 1, text.Length - i - 1).Trim();
                if (rest != "" && !rest.StartsWith("#")) { return ""; }
                string value = sb.ToString();
                return value.StartsWith("/") ? value : "";
            }
            // 只解 HOME 与双引号中的转义，不执行 shell 变量或命令替换。
            if (c == 36 || c == 96) { return ""; }
            if (c == 92) {
                if (i + 1 >= text.Length) { return ""; }
                int next = text[i + 1] & 255;
                if (next == 34 || next == 36 || next == 96 || next == 92) {
                    if (i > chunk) { sb.Append(text.Substring(chunk, i - chunk)); }
                    sb.Append(text.Substring(i + 1, 1));
                    i = i + 1;
                    chunk = i + 1;
                }
            }
        }
        return "";
    }
    #endif

    /// 系统临时目录（Windows：%TEMP%/%TMP%；
    /// POSIX：$TMPDIR 或 /tmp）。
    static string Temp() {
        string t = Interop.EnvVar("TEMP");
        if (t == "") { t = Interop.EnvVar("TMP"); }
        #if !WINDOWS
        if (t == "") { t = Interop.EnvVar("TMPDIR"); }
        if (t == "") { t = "/tmp"; }
        #endif
        return t;
    }

    /// 当前用户名（Windows：%USERNAME%；POSIX：$USER 或 $LOGNAME）。
    static string UserName() {
        string u = Interop.EnvVar("USERNAME");
        if (u == "") { u = Interop.EnvVar("USER"); }
        if (u == "") { u = Interop.EnvVar("LOGNAME"); }
        return u;
    }

    /// 计算机名（Windows：%COMPUTERNAME%；POSIX：$HOSTNAME）。
    static string ComputerName() {
        string n = Interop.EnvVar("COMPUTERNAME");
        if (n == "") { n = Interop.EnvVar("HOSTNAME"); }
        return n;
    }

    /// 读取环境变量；未设置时返回“”。
    static string GetEnv(string name) {
        return Interop.EnvVar(name);
    }

    /// 为当前进程（及其子进程）设置环境变量。
    /// 空值表示删除该变量（Windows 的 SetEnvironmentVariableW
    /// 对空串指针是设成空串，真正删除必须传 NULL；POSIX
    /// 用 unsetenv，两平台行为一致）。
    static void SetEnv(string name, string val) {
        #if WINDOWS
        nint wname = Wide.Of(name);
        nint fn = Interop.Entry("kernel32.dll", "SetEnvironmentVariableW");
        if (fn != 0) {
            SetEnvironmentVariableWFn call = (SetEnvironmentVariableWFn)fn;
            if (val == "") {
                call(wname, 0);   // NULL 删除变量
            } else {
                nint wvalue = Wide.Of(val);
                call(wname, wvalue);
                Wide.Free(wvalue);
            }
        }
        Wide.Free(wname);
        #else
        if (val == "") {
            KnownFolders.PosixUnsetenv(name);
        } else {
            KnownFolders.PosixSetenv(name, val, 1);
        }
        #endif
    }

    /// <summary>从进程环境展开 <c>%NAME%</c>（Windows）或 <c>$NAME</c>
    /// （POSIX）标记。未知标记
    /// 原样保留。Windows 下与 cmd.exe 语义一致（ExpandEnvironmentStringsW）。</summary>
    static string Expand(string text) {
        if (text == null || text.Length == 0) { return ""; }
        #if WINDOWS
        if (text.IndexOf("%") < 0) { return text; }
        StringBuilder sb = new StringBuilder();
        int len = text.Length;
        int i = 0;
        int last = 0;
        while (i < len) {
            if ((text[i] & 255) == 37) { // '%'
                if (i > last) { sb.Append(text.Substring(last, i - last)); }
                int close = KnownFolders.IndexOf(text, "%", i + 1);
                if (close > i + 1) {
                    string name = text.Substring(i + 1, close - i - 1);
                    string v = KnownFolders.GetEnv(name);
                    if (v != "") {
                        sb.Append(v);
                    } else {
                        sb.Append("%" + name + "%");
                    }
                    i = close + 1;
                } else {
                    sb.Append("%");
                    i = i + 1;
                }
                last = i;
            } else {
                i = i + 1;
            }
        }
        if (last < len) { sb.Append(text.Substring(last, len - last)); }
        return sb.ToString();
        #else
        if (text.IndexOf("$") < 0) { return text; }
        StringBuilder sb = new StringBuilder();
        int len = text.Length;
        int i = 0;
        int last = 0;
        while (i < len) {
            if ((text[i] & 255) == 36) { // '$'
                if (i > last) { sb.Append(text.Substring(last, i - last)); }
                int end = i + 1;
                while (end < len) {
                    int c = text[end] & 255;
                    bool alpha = (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
                                 || (c >= 48 && c <= 57) || c == 95; // '_'
                    if (!alpha) { break; }
                    end = end + 1;
                }
                if (end > i + 1) {
                    string name = text.Substring(i + 1, end - i - 1);
                    string v = KnownFolders.GetEnv(name);
                    if (v != "") {
                        sb.Append(v);
                    } else {
                        sb.Append("$" + name);
                    }
                    i = end;
                } else {
                    sb.Append("$");
                    i = i + 1;
                }
                last = i;
            } else {
                i = i + 1;
            }
        }
        if (last < len) { sb.Append(text.Substring(last, len - last)); }
        return sb.ToString();
        #endif
    }

    /// 从 from 起查找子串；没有时返回 -1。
    static int IndexOf(string hay, string needle, int from) {
        if (hay == null || needle == null) { return -1; }
        if (from < 0) { from = 0; }
        if (from > hay.Length) { return -1; }
        return hay.IndexOf(needle, from);
    }

    #if !WINDOWS
    // 系统底层交互与数据流转契约
    // 缺第三个参数时 x86-64 SysV 的 edx 是调用点残留的垃圾值，
    // overwrite 随机 → 有时覆盖、有时不覆盖，行为不可复现。
    [DllImport("crt", EntryPoint = "setenv")]
    static extern int PosixSetenv(string name, string value, int overwrite);

    [DllImport("crt", EntryPoint = "unsetenv")]
    static extern int PosixUnsetenv(string name);
    #endif
}

#if WINDOWS
/// <summary>SetEnvironmentVariableW 的函数指针签名（经 Interop.Entry 取用）。</summary>
delegate int SetEnvironmentVariableWFn(nint name, nint val);
#endif

