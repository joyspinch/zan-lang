using System;
using System.IO;
using System.Threading;

namespace System.IO.Watch;

// <see cref="DirectoryWatcher"/> 上报的文件系统变化类型。
public class FileChange {
    // 条目新增。
    public static int Added() { return 1; }
    // 条目删除。
    public static int Removed() { return 2; }
    // 内容修改（写入时间或大小变化）。
    public static int Modified() { return 3; }
}
