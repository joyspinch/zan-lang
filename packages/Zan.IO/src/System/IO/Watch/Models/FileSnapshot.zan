using System;
using System.IO;
using System.Threading;

namespace System.IO.Watch;

// 快照里的一条目记录：名称 + 最后写入时间 + 大小。
public class FileSnapshot {
    public string name;
    public long lastWriteTime;
    public long size;

    // 构造一条快照记录。
    public FileSnapshot(string name, long lastWriteTime, long size) {
        this.name = name;
        this.lastWriteTime = lastWriteTime;
        this.size = size;
    }
}
