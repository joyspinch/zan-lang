using System;
using System.Interop;

namespace System.IO;

// 基于可增长的堆外缓冲区的 <see cref="Stream"/>——测试中
// 用作 FileStream 的内存替身，也是用流式代码构造
// 字节载荷、再交给 socket 或文件的方式：
// MemoryStream ms = MemoryStream.Alloc(64);
// ms.Write("hello");
// ms.Close();
// 读写共用同一个游标（与 System.IO.MemoryStream 相同）：写入
// 越过末尾会扩展缓冲区，Length 记录最高水位。
// <see cref="Close"/> 释放缓冲区。
public class MemoryStream : Stream {
    nint data;
    int capacity;
    int length;
    int pos;

    // 构造空流（默认分配 256 字节初始缓冲区）。
    public MemoryStream() {
        this.capacity = 256;
        this.data = NativeMemory.Alloc(this.capacity);
        this.length = 0;
        this.pos = 0;
    }

    // 指定初始容量构造空流。
    public MemoryStream(int initialCapacity) {
        int cap = initialCapacity;
        if (cap < 16) { cap = 16; }
        this.capacity = cap;
        this.data = NativeMemory.Alloc(cap);
        if (this.data == 0) {
            throw new IOException("MemoryStream: out of memory allocating "
                + cap + " bytes");
        }
        this.length = 0;
        this.pos = 0;
    }

    // 基于托管字节数组初始化流。
    public MemoryStream(byte[] bytes) {
        int cap = bytes != null ? bytes.Length : 0;
        if (cap < 16) { cap = 16; }
        this.capacity = cap;
        this.data = NativeMemory.Alloc(cap);
        this.length = 0;
        this.pos = 0;
        if (bytes != null && bytes.Length > 0) {
            NativeMemory.Copy(this.data, (nint)bytes, bytes.Length);
            this.length = bytes.Length;
        }
    }

    // 给定初始容量的空可写流。
    public static MemoryStream Alloc(int initialCapacity) {
        return new MemoryStream(initialCapacity);
    }

    // 基于 `s` 字节副本的流，位置为 0
    // （二进制安全：内嵌 NUL 字节会保留）。
    public static MemoryStream FromStr(string s) {
        int n = s.Length;
        MemoryStream ms = MemoryStream.Alloc(n + 1);
        NativeMemory.PutString(ms.data, 0, s, n);
        ms.length = n;
        return ms;
    }

    // 基于原始地址处 `count` 字节副本的流。
    public static MemoryStream FromRaw(nint src, int count) {
        MemoryStream ms = MemoryStream.Alloc(count + 1);
        NativeMemory.Copy(ms.data, src, count);
        ms.length = count;
        return ms;
    }

    // 目前已写入的字节，以二进制安全字符串返回。
    public string ToStr() {
        if (this.length <= 0) { return ""; }
        return NativeMemory.GetString(this.data, 0, this.length);
    }

    // 将整个流内容提取为独立的托管字节数组
    public byte[] ToArray() {
        if (this.length <= 0 || this.data == 0) {
            return new byte[0];
        }
        byte[] arr = new byte[this.length];
        NativeMemory.Copy((nint)arr, this.data, this.length);
        return arr;
    }

    // 写入托管字节数组切片
    public void WriteBytes(byte[] buffer, int offset, int count) {
        if (this.capacity == 0 || buffer == null || count <= 0) { return; }
        if (offset < 0 || offset + count > buffer.Length) { return; }
        this.Grow(this.pos + count);
        NativeMemory.Copy(this.data + this.pos, (nint)buffer + offset, count);
        this.pos = this.pos + count;
        if (this.pos > this.length) {
            this.length = this.pos;
        }
    }

    // 读取数据到托管字节数组切片
    public int ReadBytes(byte[] buffer, int offset, int count) {
        if (this.capacity == 0 || buffer == null || count <= 0) { return 0; }
        if (offset < 0 || offset + count > buffer.Length) { return 0; }
        if (this.pos >= this.length) { return 0; }
        int avail = this.length - this.pos;
        int toRead = count < avail ? count : avail;
        NativeMemory.Copy((nint)buffer + offset, this.data + this.pos, toRead);
        this.pos = this.pos + toRead;
        return toRead;
    }

    // 底层缓冲区地址，用于零拷贝 FFI。写入导致缓冲区增长后
    // 以及 Close 之后失效。
    public nint Raw() { return this.data; }

    // 扩容到至少 needed 字节（倍增策略）；分配失败抛 IOException。
    void Grow(int needed) {
        if (needed <= this.capacity) { return; }
        int cap = this.capacity;
        if (cap < 16) { cap = 16; }
        while (cap < needed) {
            cap = cap * 2;
        }
        nint bigger = NativeMemory.Alloc(cap);
        if (bigger == 0) {
            throw new IOException("MemoryStream: out of memory growing to "
                + cap + " bytes");
        }
        if (this.length > 0) {
            NativeMemory.Copy(bigger, this.data, this.length);
        }
        if (this.capacity > 0) {
            NativeMemory.Free(this.data);
        }
        this.data = bigger;
        this.capacity = cap;
    }

    // 未 Close 时为 true。
    public override bool CanRead() { return this.capacity > 0; }

    // 未 Close 时为 true。
    public override bool CanWrite() { return this.capacity > 0; }

    // 未 Close 时为 true。
    public override bool CanSeek() { return this.capacity > 0; }

    // 已写入的最高水位字节数。
    public override long Length() { return this.length; }

    // 当前读写位置。
    public override long Position() { return this.pos; }

    // origin 0=开头 1=当前位置 2=末尾；目标钳制到不小于 0，
    // 返回新位置。
    public override long Seek(long offset, int origin) {
        long target = offset;
        if (origin == 1) { target = this.pos + offset; }
        else if (origin == 2) { target = this.length + offset; }
        if (target < 0) { target = 0; }
        this.pos = (int)target;
        return this.pos;
    }

    // 清空内容并回到开头；保留缓冲区。
    public void Clear() {
        this.length = 0;
        this.pos = 0;
    }

    // 读取最多 count 字节到 buf，返回实际读取数（末尾为 0）。
    public override int ReadInto(nint buf, int count) {
        if (this.capacity == 0 || count <= 0) { return 0; }
        int avail = this.length - this.pos;
        if (avail <= 0) { return 0; }
        int n = count;
        if (n > avail) { n = avail; }
        NativeMemory.Copy(buf, this.data + this.pos, n);
        this.pos = this.pos + n;
        return n;
    }

    // 从 buf 追加 count 字节（必要时扩容），推进位置与最高水位；
    // 成功时总是返回 count。
    public override int WriteFrom(nint buf, int count) {
        if (count <= 0) { return 0; }
        this.Grow(this.pos + count);
        NativeMemory.Copy(this.data + this.pos, buf, count);
        this.pos = this.pos + count;
        if (this.pos > this.length) {
            this.length = this.pos;
        }
        return count;
    }

    public override void Flush() { }

    // 释放缓冲区；重复调用安全。
    public override void Close() {
        if (this.capacity > 0) {
            NativeMemory.Free(this.data);
            this.data = 0;
            this.capacity = 0;
            this.length = 0;
            this.pos = 0;
        }
    }

    public override void Dispose() {
        this.Close();
    }
}
