namespace System.IO.Compression;

// zstd 帧层：帧头、块循环、内容校验和、可跳过帧。
//
// 帧结构（RFC 8878 §3.1.1）：
//   Magic(4) + Frame_Header(2..14) + Data_Block* + [Content_Checksum(4)]
//
// 一份输入里可以有多个帧（解压结果首尾相接），也可以夹着可跳过帧
// （元数据，解码时直接跳过）。
public class ZstdFrame {
    // zstd 帧魔数（小端 28 B5 2F FD）。
    public static byte[] MAGIC = new byte[] { 0x28, 0xB5, 0x2F, 0xFD };
    // 可跳过帧的魔数区间（小端 50..5F 2A 4D 18）。
    public static int SKIP_MAGIC_LOW = 0x184D2A50;
    public static int SKIP_MAGIC_HIGH = 0x184D2A5F;
    // 块大小的上限（规范固定 128 KB）。
    public static int BLOCK_MAX = 131072;

    // 读 4 字节（小端）。
    static int ReadLE32(byte[] d, int p) {
        return (d[p] & 255) | ((d[p + 1] & 255) << 8)
            | ((d[p + 2] & 255) << 16) | ((d[p + 3] & 255) << 24);
    }

    // 读 len 字节（小端，1/2/4/8）。
    static long ReadLE(byte[] d, int p, int len) {
        long v = 0;
        for (int i = len - 1; i >= 0; i = i - 1) {
            v = (v << 8) | (d[p + i] & 255);
        }
        return v;
    }

    // 解码整个输入（可能含多个帧与可跳过帧）。
    // 失败抛 ZstdException。
    public static byte[] Decode(byte[] src) {
        if (src == null) {
            throw new ZstdException(ZstdError.NotZstd, "zstd: null input");
        }
        ZstdBuffer sink = new ZstdBuffer();
        int pos = 0;
        while (pos < src.Length) {
            if (pos + 4 > src.Length) {
                throw new ZstdException(ZstdError.Truncated, "zstd: trailing bytes are not a frame");
            }
            int magic = ReadLE32(src, pos);
            if (magic >= ZstdFrame.SKIP_MAGIC_LOW && magic <= ZstdFrame.SKIP_MAGIC_HIGH) {
                // 可跳过帧：整段忽略
                if (pos + 8 > src.Length) {
                    throw new ZstdException(ZstdError.Truncated, "zstd: skippable frame truncated");
                }
                int size = ReadLE32(src, pos + 4);
                if (size < 0) {
                    throw new ZstdException(ZstdError.Truncated, "zstd: skippable frame size out of range");
                }
                long next = (long)pos + 8 + (long)size;
                if (next > src.Length) {
                    throw new ZstdException(ZstdError.Truncated, "zstd: skippable frame truncated");
                }
                pos = (int)next;
                continue;
            }
            if (src[pos] != ZstdFrame.MAGIC[0] || src[pos + 1] != ZstdFrame.MAGIC[1]
                || src[pos + 2] != ZstdFrame.MAGIC[2] || src[pos + 3] != ZstdFrame.MAGIC[3]) {
                throw new ZstdException(ZstdError.NotZstd, "zstd: bad magic number");
            }
            pos = ZstdFrame.DecodeFrame(src, pos, sink);
        }
        return sink.ToArray();
    }

    // 解码一个 zstd 帧（src[pos] 是魔数），结果追加进 sink。
    // 返回帧结束后的位置。
    static int DecodeFrame(byte[] src, int pos, ZstdBuffer sink) {
        int p = pos + 4;
        if (p >= src.Length) {
            throw new ZstdException(ZstdError.Truncated, "zstd: frame header truncated");
        }
        int fhd = src[p] & 255;
        p = p + 1;
        int fcsFlag = (fhd >> 6) & 3;
        bool singleSeg = ((fhd >> 5) & 1) != 0;
        bool hasChecksum = ((fhd >> 2) & 1) != 0;
        int didFlag = fhd & 3;
        if (((fhd >> 3) & 1) != 0) {
            throw new ZstdException(ZstdError.BadFrameHeader, "zstd: reserved bit set in frame header");
        }
        long windowSize = 0;
        if (!singleSeg) {
            if (p >= src.Length) {
                throw new ZstdException(ZstdError.Truncated, "zstd: window descriptor truncated");
            }
            int wd = src[p] & 255;
            p = p + 1;
            int exp = (wd >> 3) & 31;
            int mant = wd & 7;
            int wlog = 10 + exp;
            if (wlog > 41) {
                throw new ZstdException(ZstdError.BadFrameHeader, "zstd: window size out of range");
            }
            long wb = 1L << wlog;
            windowSize = wb + (wb / 8) * mant;
        }
        int didSize = 0;
        if (didFlag == 1) { didSize = 1; }
        else if (didFlag == 2) { didSize = 2; }
        else if (didFlag == 3) { didSize = 4; }
        if (didSize > 0) {
            if (p + didSize > src.Length) {
                throw new ZstdException(ZstdError.Truncated, "zstd: dictionary id truncated");
            }
            long did = ZstdFrame.ReadLE(src, p, didSize);
            if (did != 0) {
                throw new ZstdException(ZstdError.DictionaryRequired,
                    "zstd: frame requires a dictionary, which this decoder does not support");
            }
            p = p + didSize;
        }
        int fcsSize = 0;
        if (fcsFlag == 0) { fcsSize = singleSeg ? 1 : 0; }
        else if (fcsFlag == 1) { fcsSize = 2; }
        else if (fcsFlag == 2) { fcsSize = 4; }
        else { fcsSize = 8; }
        long fcs = -1;
        if (fcsSize > 0) {
            if (p + fcsSize > src.Length) {
                throw new ZstdException(ZstdError.Truncated, "zstd: frame content size truncated");
            }
            fcs = ZstdFrame.ReadLE(src, p, fcsSize);
            if (fcsSize == 2) { fcs = fcs + 256; }
            p = p + fcsSize;
        }
        if (singleSeg) {
            windowSize = fcs;
        }
        int frameStart = sink.Length();
        ZstdBlockDecoder dec = new ZstdBlockDecoder(sink, frameStart, windowSize);
        int blockMax = ZstdFrame.BLOCK_MAX;
        if (windowSize < (long)blockMax) {
            blockMax = (int)windowSize;
        }
        while (true) {
            if (p + 3 > src.Length) {
                throw new ZstdException(ZstdError.Truncated, "zstd: block header truncated");
            }
            int bh = (src[p] & 255) | ((src[p + 1] & 255) << 8) | ((src[p + 2] & 255) << 16);
            p = p + 3;
            bool last = (bh & 1) != 0;
            int btype = (bh >> 1) & 3;
            int bsize = bh >> 3;
            if (btype == 3) {
                throw new ZstdException(ZstdError.BadBlock, "zstd: reserved block type");
            }
            dec.DecodeBlock(src, p, bsize, btype, blockMax);
            p = p + (btype == 1 ? 1 : bsize);
            if (last) { break; }
        }
        long produced = (long)sink.Length() - (long)frameStart;
        if (fcs >= 0 && produced != fcs) {
            throw new ZstdException(ZstdError.SizeMismatch,
                "zstd: decoded size does not match the frame content size");
        }
        if (hasChecksum) {
            if (p + 4 > src.Length) {
                throw new ZstdException(ZstdError.Truncated, "zstd: content checksum truncated");
            }
            int stored = ZstdFrame.ReadLE32(src, p);
            p = p + 4;
            long h = ZstdXxH64.Compute(sink.Raw(), frameStart, (int)produced);
            int actual = (int)(h & 0xFFFFFFFFL);
            if (actual != stored) {
                throw new ZstdException(ZstdError.ChecksumMismatch,
                    "zstd: content checksum mismatch");
            }
        }
        return p;
    }
}
