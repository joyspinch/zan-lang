using System;
using System.IO;

namespace System.IO.Compression;

// tar 归档中的一个条目。
public class TarEntry {
    // 归档内的路径，使用正斜杠，目录以 "/" 结尾。
    public string name;
    // 文件内容（目录条目为 null）。
    public byte[] data;
    // 目录条目为 true。
    public bool isDirectory;
    // POSIX 权限（文件默认 0644，目录默认 0755）。
    public int mode;
    // Unix 修改时间（秒）；0 表示未设置。
    public long mtime;

    // 构造文件条目（isDirectory 默认 false，mode/mtime 为 0）。
    public TarEntry(string name) {
        this.name = name;
    }

    public TarEntry(string name, byte[] data) {
        this.name = name;
        this.data = data;
    }
}
