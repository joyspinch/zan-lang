using System;
using System.IO;

namespace System.IO.Compression;

// zip 归档中的一个条目。
public class ZipEntry {
    // 归档内的路径，使用正斜杠，目录以 "/" 结尾。
    public string name;
    // 文件内容（目录条目为 null）。
    public byte[] data;
    // 目录条目为 true。
    public bool isDirectory;
    // 由 Zip.Read / Zip.Extract 填充：
    // 压缩方法：0 = stored，8 = deflate。
    public int method;
    // 未压缩数据的 CRC-32。
    public int crc32;
    // 压缩后字节数。
    public int compressedSize;
    // 未压缩字节数。
    public int uncompressedSize;
    // 本地文件头在归档中的偏移（-1 表示未知，需扫描定位）。
    public int localHeaderOffset;

    // 构造文件条目（isDirectory 默认 false，数据待填）。
    public ZipEntry(string name) {
        this.name = name;
        this.localHeaderOffset = 0 - 1;
    }

    public ZipEntry(string name, byte[] data) {
        this.name = name;
        this.data = data;
        this.localHeaderOffset = 0 - 1;
    }
}
