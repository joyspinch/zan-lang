using System;
using System.IO;

namespace System.IO.Compression;

// zip 归档中的一个条目。
public class ZipEntry {
    // 归档内的路径，使用正斜杠，目录以 "/" 结尾。
    public string name;
    // 文件内容（目录条目为 null）。
    public byte[] data;
    // 目录条目为 true。
    public bool isDirectory;
    // 由 Zip.Read / Zip.Extract 填充：
    // 压缩方法：0 = stored，8 = deflate。
    public int method;
    // 未压缩数据的 CRC-32。
    public int crc32;
    // 压缩后字节数。
    public int compressedSize;
    // 未压缩字节数。
    public int uncompressedSize;
    // 本地文件头在归档中的偏移（-1 表示未知，需扫描定位）。
    public int localHeaderOffset;
    // 内部预压缩静态载荷缓存（仅当 level 一致时由 Zip.Create 直接复用，输出与实时压缩逐比特一致）。
    internal byte[] precompressed;
    internal int precompressedCrc;
    internal int precompressedLevel;

    // 构造文件条目（isDirectory 默认 false，数据待填）。
    public ZipEntry(string name) {
        this.name = name;
        this.localHeaderOffset = 0 - 1;
        this.precompressed = null;
        this.precompressedCrc = 0;
        this.precompressedLevel = -1;
    }

    public ZipEntry(string name, byte[] data) {
        this.name = name;
        this.data = data;
        this.localHeaderOffset = 0 - 1;
        this.precompressed = null;
        this.precompressedCrc = 0;
        this.precompressedLevel = -1;
    }

    // 构造带预压缩载荷的只读文件条目（Zip.Create 在 level 一致时直接复用压缩字节与 CRC-32）。
    public static ZipEntry Precompressed(string name, byte[] data, byte[] compressed, int crc32, int level) {
        ZipEntry e = new ZipEntry(name, data);
        e.precompressed = compressed;
        e.precompressedCrc = crc32;
        e.precompressedLevel = level;
        return e;
    }
}
