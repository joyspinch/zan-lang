using System;
using System.IO;

namespace System.IO.Compression;

// zip 归档中的一个条目。
public class ZipEntry {
    // 归档内的路径，使用正斜杠，目录以 "/" 结尾。
    public string name;
    // 文件内容（目录条目为 null）。
    public byte[] data;
    // 目录条目为 true。
    public bool isDirectory;
    // 由 Zip.Read / Zip.Extract 填充：
    // 压缩方法：0 = stored，8 = deflate。
    public int method;
    // 未压缩数据的 CRC-32。
    public int crc32;
    // 压缩后字节数。
    public int compressedSize;
    // 未压缩字节数。
    public int uncompressedSize;

    // 构造文件条目（isDirectory 默认 false，数据待填）。
    public ZipEntry(string name) {
        this.name = name;
    }

    public ZipEntry(string name, byte[] data) {
        this.name = name;
        this.data = data;
    }
}

// ZIP 归档读写器（PKZIP，无加密，支持 stored + deflate
// 条目）。可与所有标准解压工具互通（Windows 资源管理器、
// .NET ZipArchive、Python zipfile、7-Zip、Info-ZIP 等）。不依赖
