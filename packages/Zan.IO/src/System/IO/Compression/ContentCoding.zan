using System;

namespace System.IO.Compression;

// 压缩包提供预算感知的解码桥，网络包不反向依赖压缩实现。
// http.SetBoundedContentDecoder(ContentCoding.DecodeBounded);
public class ContentCoding {
    // 独立解码使用包级硬上限；HTTP 调用方必须传递自己的响应预算。
    public static byte[] Decode(string encoding, byte[] data) {
        return ContentCoding.DecodeBounded(encoding, data, 268435456);
    }

    // 不支持、格式损坏或输出超过预算均返回 null。
    public static byte[] DecodeBounded(string encoding, byte[] data, int maxOut) {
        if (encoding == null || data == null || maxOut <= 0 || maxOut > 268435456) { return null; }
        string enc = encoding.Trim().ToLower();
        if (enc == "gzip" || enc == "x-gzip") {
            return GZip.DecompressBounded(data, maxOut);
        }
        if (enc == "deflate") {
            return ContentCoding.InflateDeflate(data, maxOut);
        }
        return null;
    }

    // HTTP deflate 兼容 zlib 包装与裸流；包装必须完整且校验通过。
    private static byte[] InflateDeflate(byte[] data, int maxOut) {
        int offset = 0;
        int length = data.Length;
        bool zlib = false;
        if (length >= 2) {
            int cmf = data[0] & 255;
            int flg = data[1] & 255;
            zlib = (cmf & 15) == 8 && ((cmf * 256 + flg) % 31) == 0;
            if (zlib) {
                if ((cmf >> 4) > 7 || (flg & 32) != 0 || length < 6) { return null; }
                offset = 2;
                length = length - 6;
            }
        }
        int consumed = 0;
        byte[] decoded = Deflate.InflateConsumed(data, offset, length, maxOut, ref consumed);
        if (decoded == null || consumed != length) { return null; }
        if (zlib) {
            int a = 1;
            int b = 0;
            for (int i = 0; i < decoded.Length; i = i + 1) {
                a = (a + (decoded[i] & 255)) % 65521;
                b = (b + a) % 65521;
            }
            int trailer = data.Length - 4;
            if ((data[trailer] & 255) != (b >> 8) || (data[trailer + 1] & 255) != (b & 255)
                || (data[trailer + 2] & 255) != (a >> 8) || (data[trailer + 3] & 255) != (a & 255)) {
                return null;
            }
        }
        return decoded;
    }
}
