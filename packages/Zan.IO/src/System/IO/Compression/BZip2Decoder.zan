using System;
using System.IO;

namespace System.IO.Compression;

// 纯 Zan 实现的 bzip2 流式/内存解压器（不依赖 libbz2，校验块 CRC）。
// 每次解压新建一个实例；压缩请使用 Deflate / GZip。
public class BZip2Decoder {
    [DllImport("crt", EntryPoint = "zan_file_fopen")]
    private static extern nint PlatFopen(string path, string mode);
    [DllImport("crt", EntryPoint = "fread")]
    private static extern long PlatFread(byte[] buf, long size, long count, nint fp);
    [DllImport("crt", EntryPoint = "fwrite")]
    private static extern long PlatFwrite(byte[] buf, long size, long count, nint fp);
    [DllImport("crt", EntryPoint = "fclose")]
    private static extern int PlatFclose(nint fp);

    static int MaxAlphaSize = 258;
    static int MaxGroups = 6;
    static int MaxCodeLen = 23;
    static int GroupSize = 50;
    static int FastBits = 10;
    static int FastSize = 1024;
    static int[] sharedCrcTable = null;

    // ---- 输入（文件或内存）----
    nint fp;
    byte[] inBuf;
    int inLen;
    int inPos;
    byte[] memSrc;
    ulong bitBuf;
    int bitCnt;
    bool inEof;

    // ---- 输出（文件或内存）----
    nint ofp;
    byte[] outBuf;
    int outPos;
    List<byte[]> memOut;
    long outTotal;

    // ---- 每块状态 ----
    int[] tt;
    int[] unzftab;
    int[] cftab;
    byte[] seqToUnseq;
    byte[] mtf;
    int[] selector;
    int[] len;  // MaxGroups * MaxAlphaSize（扁平）
    int[] limit;  // MaxGroups * (MaxCodeLen + 2)
    int[] baseTab;  // 同上
    int[] perm;  // MaxGroups * MaxAlphaSize
    int[] minLens;
    int[] fastLut;  // MaxGroups * FastSize: (bitLen << 16) | sym，0 表示长码回退
    int[] crcTable;
    int blockCrc;
    int combinedCrc;
    bool failed;

    // 构造解码器：分配固定大小的输入/输出缓冲并建 CRC 表；
    // 实际解压经 RunMemory / RunFile 驱动。
    public BZip2Decoder() {
        this.fp = 0;
        this.ofp = 0;
        this.inBuf = null;
        this.inLen = 0;
        this.inPos = 0;
        this.memSrc = null;
        this.bitBuf = 0UL;
        this.bitCnt = 0;
        this.inEof = false;
        this.outBuf = null;
        this.outPos = 0;
        this.memOut = null;
        this.outTotal = 0;
        this.failed = false;
        this.blockCrc = 0;
        this.combinedCrc = 0;
        this.unzftab = new int[256];
        this.cftab = new int[257];
        this.seqToUnseq = new byte[256];
        this.mtf = new byte[256];
        this.selector = null;
        this.len = new int[MaxGroups * MaxAlphaSize];
        this.limit = new int[MaxGroups * (MaxCodeLen + 2)];
        this.baseTab = new int[MaxGroups * (MaxCodeLen + 2)];
        this.perm = new int[MaxGroups * MaxAlphaSize];
        this.minLens = new int[MaxGroups];
        this.fastLut = new int[MaxGroups * FastSize];
        this.tt = null;
        if (BZip2Decoder.sharedCrcTable == null) {
            BZip2Decoder.sharedCrcTable = BZip2Decoder.BuildCrcTable();
        }
        this.crcTable = BZip2Decoder.sharedCrcTable;
    }

    // ---- CRC（bzip2 用的是 MSB-first 的 CRC-32/MPEG 变体）----

    // 构建 CRC-32/MPEG（MSB-first，多项式 0x04C11DB7）查表。
    private static int[] BuildCrcTable() {
        int[] t = new int[256];
        for (int i = 0; i < 256; i = i + 1) {
            int c = i << 24;
            for (int k = 0; k < 8; k = k + 1) {
                if ((c & -2147483648) != 0) {
                    c = (c << 1) ^ 79764919;  // 0x04C11DB7
                } else {
                    c = c << 1;
                }
            }
            t[i] = c;
        }
        return t;
    }

    // 把一个字节滚入当前块的 CRC。
    void CrcUpdate(int b) {
        int idx = ((this.blockCrc >> 24) ^ (b & 255)) & 255;
        this.blockCrc = (this.blockCrc << 8) ^ this.crcTable[idx];
    }

    // ---- 位读取（MSB-first）----

    // 文件模式下从输入文件填满读缓冲；内存模式或读不到数据返回 false。
    bool Refill() {
        if (this.memSrc != null) {
            return false;  // 内存模式只有一段输入
        }
        if (this.fp == 0) { return false; }
        long got = BZip2Decoder.PlatFread(this.inBuf, 1, this.inBuf.Length, this.fp);
        if (got <= 0) {
            this.inEof = true;
            return false;
        }
        this.inLen = (int)got;
        this.inPos = 0;
        return true;
    }

    // 读下一个输入字节；输入耗尽返回 -1。
    int NextByte() {
        if (this.inPos >= this.inLen) {
            if (!this.Refill()) { return -1; }
        }
        int b = this.inBuf[this.inPos] & 255;
        this.inPos = this.inPos + 1;
        return b;
    }

    // 批量填满 64 位位缓冲（至多 56 位）。
    void RefillBits() {
        byte[] buf = this.inBuf;
        int ip = this.inPos;
        int il = this.inLen;
        ulong bb = this.bitBuf;
        int bc = this.bitCnt;
        while (bc <= 56) {
            if (ip >= il) {
                this.inPos = ip;
                this.bitBuf = bb;
                this.bitCnt = bc;
                if (!this.Refill()) { return; }
                buf = this.inBuf;
                ip = this.inPos;
                il = this.inLen;
            }
            bb = (bb << 8) | (ulong)(buf[ip] & 255);
            ip = ip + 1;
            bc = bc + 8;
        }
        this.inPos = ip;
        this.bitBuf = bb;
        this.bitCnt = bc;
    }

    // 读取 n（1..24）位；输入耗尽返回 -1。
    int GetBits(int n) {
        if (this.bitCnt < n) {
            this.RefillBits();
            if (this.bitCnt < n) {
                this.failed = true;
                return -1;
            }
        }
        int shift = this.bitCnt - n;
        int v = (int)((this.bitBuf >> shift) & ((1UL << n) - 1UL));
        this.bitCnt = shift;
        return v;
    }

    // 读 1 位。
    int GetBit() {
        return this.GetBits(1);
    }

    // 32 位字段（CRC）分两次读，避免 (1 << 32) 溢出。
    int GetInt32() {
        int hi = this.GetBits(16);
        int lo = this.GetBits(16);
        if (hi < 0 || lo < 0) { return 0; }
        return (hi << 16) | lo;
    }

    // ---- 输出 ----

    // 输出一个字节（输出缓冲写满时自动 FlushOut）。
    void Emit(int b) {
        if (this.failed) { return; }
        this.outBuf[this.outPos] = (byte)(b & 255);
        this.outPos = this.outPos + 1;
        if (this.outPos == this.outBuf.Length) {
            this.FlushOut();
        }
    }

    // 冲出输出缓冲：文件模式写盘（短写标记失败），内存模式流式执行 2 GB 上限防解压炸弹 OOM。
    void FlushOut() {
        if (this.outPos == 0 || this.failed) { return; }
        this.outTotal = this.outTotal + this.outPos;
        if (this.ofp != 0) {
            long w = BZip2Decoder.PlatFwrite(this.outBuf, 1, this.outPos, this.ofp);
            if (w != (long)this.outPos) { this.failed = true; }
        } else {
            if (this.outTotal > 2147483000L) {
                this.failed = true;
                this.outPos = 0;
                return;
            }
            byte[] chunk = new byte[this.outPos];
            NativeMemory.Copy((nint)chunk, (nint)this.outBuf, this.outPos);
            this.memOut.Add(chunk);
        }
        this.outPos = 0;
    }

    // ---- 驱动 ----

    // 内存内解压：解析整个流并拼接输出；数据无效、解码失败或
    // 输出超过约 2 GB 时返回 null。
    public byte[] RunMemory(byte[] data) {
        if (data == null || data.Length < 4) { return null; }
        this.memSrc = data;
        this.inBuf = data;
        this.inLen = data.Length;
        this.inPos = 0;
        int obCap = data.Length * 8;
        if (obCap < 4096) { obCap = 4096; }
        if (obCap > 262144) { obCap = 262144; }
        this.outBuf = new byte[obCap];
        this.memOut = new List<byte[]>();
        if (!this.Decode()) { return null; }
        // 拼接输出块（单块零拷贝直返）。
        long total = this.outTotal;
        if (total > 2147483000) { return null; }  // 内存模式上限
        if (this.memOut.Count == 1) { return this.memOut[0]; }
        byte[] all = new byte[(int)total];
        int pos = 0;
        for (int i = 0; i < this.memOut.Count; i = i + 1) {
            byte[] c = this.memOut[i];
            if (c.Length > 0) {
                NativeMemory.Copy((nint)all + (nint)pos, (nint)c, c.Length);
                pos = pos + c.Length;
            }
        }
        return all;
    }

    // 流式解压 srcPath 到 dstPath；源或目标打不开、解码失败时
    // 返回 false（目标文件可能已写出部分内容）。
    public bool RunFile(string srcPath, string dstPath) {
        this.inBuf = new byte[65536];
        this.outBuf = new byte[262144];
        this.fp = BZip2Decoder.PlatFopen(srcPath, "rb");
        if (this.fp == 0) { return false; }
        this.ofp = BZip2Decoder.PlatFopen(dstPath, "wb");
        if (this.ofp == 0) {
            BZip2Decoder.PlatFclose(this.fp);
            this.fp = 0;
            return false;
        }
        bool ok = false;
        try {
            ok = this.Decode();
        } finally {
            if (this.ofp != 0) {
                BZip2Decoder.PlatFclose(this.ofp);
                this.ofp = 0;
            }
            if (this.fp != 0) {
                BZip2Decoder.PlatFclose(this.fp);
                this.fp = 0;
            }
        }
        return ok;
    }

    // 解析流头部与所有块。
    bool Decode() {
        int b0 = this.NextByte();
        int b1 = this.NextByte();
        int b2 = this.NextByte();
        int lvl = this.NextByte();
        if (b0 != 66 || b1 != 90 || b2 != 104) { return false; }  // "BZh"
        if (lvl < 49 || lvl > 57) { return false; }  // '1'..'9'
        int blockSize = (lvl - 48) * 100000;
        // 按需初始分配 tt：小块免去 3.6 MiB 全量清零，大块按需倍增至 blockSize。
        int initTt = this.memSrc != null ? this.inLen * 8 : 65536;
        if (initTt < 4096) { initTt = 4096; }
        if (initTt > blockSize) { initTt = blockSize; }
        this.tt = new int[initTt];
        this.combinedCrc = 0;
        bool more = true;
        while (more) {
            // 块魔数（48 位）：压缩块 0x314159265359，流结束 0x177245385090。
            int m1 = this.GetBits(24);
            int m2 = this.GetBits(24);
            if (this.failed) { return false; }
            if (m1 == 3227993 && m2 == 2511705) {  // 0x314159 265359
                if (!this.DecodeBlock(blockSize)) { return false; }
            } else if (m1 == 1536581 && m2 == 3690640) {  // 0x177245 385090
                int streamCrc = this.GetInt32();
                if (streamCrc != this.combinedCrc) { return false; }
                more = false;
            } else {
                return false;
            }
        }
        this.FlushOut();
        return !this.failed;
    }

    // 解码一个压缩块：符号表 → Huffman → MTF/RLE2 → 逆 BWT → RLE1。
    bool DecodeBlock(int blockSize) {
        int wantCrc = this.GetInt32();
        int randomized = this.GetBit();
        if (randomized != 0) { return false; }  // 0.9.0 之前的随机化块
        int origPtr = this.GetBits(24);
        if (this.failed) { return false; }

        // --- 使用的字节集合 ---
        int inUse16 = this.GetBits(16);
        int nInUse = 0;
        for (int i = 0; i < 16; i = i + 1) {
            if ((inUse16 & (1 << (15 - i))) == 0) { continue; }
            int bits = this.GetBits(16);
            for (int j = 0; j < 16; j = j + 1) {
                if ((bits & (1 << (15 - j))) != 0) {
                    this.seqToUnseq[nInUse] = (byte)(i * 16 + j);
                    nInUse = nInUse + 1;
                }
            }
        }
        if (this.failed || nInUse == 0) { return false; }
        int alphaSize = nInUse + 2;

        // --- 组与选择器 ---
        int nGroups = this.GetBits(3);
        int nSelectors = this.GetBits(15);
        if (nGroups < 2 || nGroups > MaxGroups) { return false; }
        if (nSelectors < 1 || nSelectors > 18002) { return false; }
        if (this.selector == null || this.selector.Length < nSelectors) {
            this.selector = new int[nSelectors];
        }
        int[] pos = new int[MaxGroups];
        for (int i = 0; i < nSelectors; i = i + 1) {
            int j = 0;
            int bit = this.GetBit();
            while (bit == 1) {
                j = j + 1;
                if (j >= nGroups) { return false; }
                bit = this.GetBit();
            }
            if (bit < 0) { return false; }
            this.selector[i] = j;
        }
        for (int i = 0; i < nGroups; i = i + 1) { pos[i] = i; }
        for (int i = 0; i < nSelectors; i = i + 1) {
            int v = this.selector[i];
            int tmp = pos[v];
            while (v > 0) {
                pos[v] = pos[v - 1];
                v = v - 1;
            }
            pos[0] = tmp;
            this.selector[i] = tmp;
        }

        // --- 各组的码长（delta 编码）---
        for (int t = 0; t < nGroups; t = t + 1) {
            int curr = this.GetBits(5);
            for (int i = 0; i < alphaSize; i = i + 1) {
                bool run = true;
                while (run) {
                    if (curr < 1 || curr > 20) { return false; }
                    int b = this.GetBit();
                    if (b < 0) { return false; }
                    if (b == 0) {
                        run = false;
                    } else {
                        int b2 = this.GetBit();
                        if (b2 < 0) { return false; }
                        if (b2 == 0) { curr = curr + 1; } else { curr = curr - 1; }
                    }
                }
                this.len[t * MaxAlphaSize + i] = curr;
            }
        }
        for (int t = 0; t < nGroups; t = t + 1) {
            if (!this.BuildDecodeTables(t, alphaSize)) { return false; }
        }

        // --- MTF / RLE2 解码（内联位缓冲、10-bit 前缀直查与内联长码回退，消除逐符号方法调用与字段溢出）---
        int eob = alphaSize - 1;
        for (int i = 0; i < 256; i = i + 1) { this.unzftab[i] = 0; }
        for (int i = 0; i < nInUse; i = i + 1) { this.mtf[i] = this.seqToUnseq[i]; }
        int nblock = 0;
        int groupNo = -1;
        int groupPos = 0;
        int gSel = 0;
        int fbase = 0;
        int runLen = 0;
        int runBit = 0;
        int[] ttArr = this.tt;
        int ttCap = ttArr.Length;
        byte[] mtfArr = this.mtf;
        int[] unzf = this.unzftab;
        int[] selArr = this.selector;
        int[] lut = this.fastLut;
        int[] limArr = this.limit;
        int[] baseArr = this.baseTab;
        int[] permArr = this.perm;
        int[] minArr = this.minLens;
        byte[] ibuf = this.inBuf;
        int ipos = this.inPos;
        int ilen = this.inLen;
        ulong bbuf = this.bitBuf;
        int bcnt = this.bitCnt;
        while (true) {
            if (groupPos == 0) {
                groupNo = groupNo + 1;
                if (groupNo >= nSelectors) {
                    this.bitBuf = bbuf; this.bitCnt = bcnt; this.inPos = ipos;
                    return false;
                }
                groupPos = GroupSize;
                gSel = selArr[groupNo];
                fbase = gSel * FastSize;
            }
            groupPos = groupPos - 1;
            if (bcnt < FastBits) {
                while (bcnt <= 32 && ipos + 3 < ilen) {
                    ulong w = (((ulong)(ibuf[ipos] & 255)) << 24)
                        | (((ulong)(ibuf[ipos + 1] & 255)) << 16)
                        | (((ulong)(ibuf[ipos + 2] & 255)) << 8)
                        | ((ulong)(ibuf[ipos + 3] & 255));
                    bbuf = (bbuf << 32) | w;
                    ipos = ipos + 4;
                    bcnt = bcnt + 32;
                }
                while (bcnt <= 56 && ipos < ilen) {
                    bbuf = (bbuf << 8) | (ulong)(ibuf[ipos] & 255);
                    ipos = ipos + 1;
                    bcnt = bcnt + 8;
                }
                if (bcnt < FastBits && this.fp != 0) {
                    this.bitBuf = bbuf; this.bitCnt = bcnt; this.inPos = ipos;
                    this.RefillBits();
                    bbuf = this.bitBuf; bcnt = this.bitCnt; ipos = this.inPos; ilen = this.inLen;
                }
            }
            int sym = -1;
            if (bcnt >= FastBits) {
                int peek = (int)((bbuf >> (bcnt - FastBits)) & 1023UL);
                int entry = lut[fbase + peek];
                if (entry != 0) {
                    bcnt = bcnt - (entry >> 16);
                    sym = entry & 65535;
                }
            }
            if (sym < 0) {
                // 内联长码（>10 bit）或流尾（<10 bit）canonical Huffman 解码，零方法调用。
                if (bcnt < MaxCodeLen && ipos < ilen) {
                    while (bcnt <= 32 && ipos + 3 < ilen) {
                        ulong w = (((ulong)(ibuf[ipos] & 255)) << 24)
                            | (((ulong)(ibuf[ipos + 1] & 255)) << 16)
                            | (((ulong)(ibuf[ipos + 2] & 255)) << 8)
                            | ((ulong)(ibuf[ipos + 3] & 255));
                        bbuf = (bbuf << 32) | w;
                        ipos = ipos + 4;
                        bcnt = bcnt + 32;
                    }
                    while (bcnt <= 56 && ipos < ilen) {
                        bbuf = (bbuf << 8) | (ulong)(ibuf[ipos] & 255);
                        ipos = ipos + 1;
                        bcnt = bcnt + 8;
                    }
                }
                int lbase = gSel * (MaxCodeLen + 2);
                int zn = minArr[gSel];
                if (bcnt < zn) {
                    this.bitBuf = bbuf; this.bitCnt = bcnt; this.inPos = ipos;
                    sym = this.DecodeSlowSymbol(gSel);
                    bbuf = this.bitBuf; bcnt = this.bitCnt; ipos = this.inPos; ilen = this.inLen;
                    if (sym < 0) { return false; }
                } else {
                    bcnt = bcnt - zn;
                    int zvec = (int)((bbuf >> bcnt) & ((1UL << zn) - 1UL));
                    while (zn <= MaxCodeLen && zvec > limArr[lbase + zn]) {
                        zn = zn + 1;
                        if (bcnt == 0) {
                            while (bcnt <= 56 && ipos < ilen) {
                                bbuf = (bbuf << 8) | (ulong)(ibuf[ipos] & 255);
                                ipos = ipos + 1;
                                bcnt = bcnt + 8;
                            }
                            if (bcnt == 0) {
                                if (this.fp != 0) {
                                    this.bitBuf = bbuf; this.bitCnt = bcnt; this.inPos = ipos;
                                    this.RefillBits();
                                    bbuf = this.bitBuf; bcnt = this.bitCnt; ipos = this.inPos; ilen = this.inLen;
                                }
                                if (bcnt == 0) {
                                    this.bitBuf = bbuf; this.bitCnt = bcnt; this.inPos = ipos;
                                    this.failed = true;
                                    return false;
                                }
                            }
                        }
                        bcnt = bcnt - 1;
                        zvec = (zvec << 1) | (int)((bbuf >> bcnt) & 1UL);
                    }
                    if (zn > MaxCodeLen) {
                        this.bitBuf = bbuf; this.bitCnt = bcnt; this.inPos = ipos;
                        return false;
                    }
                    int idx = zvec - baseArr[lbase + zn];
                    if (idx < 0 || idx >= MaxAlphaSize) {
                        this.bitBuf = bbuf; this.bitCnt = bcnt; this.inPos = ipos;
                        return false;
                    }
                    sym = permArr[gSel * MaxAlphaSize + idx];
                }
            }
            if (sym == eob) { break; }
            if (sym == 0 || sym == 1) {
                // RUNA / RUNB：二进制增量编码的重复次数。
                runLen = runLen + ((sym + 1) << runBit);
                runBit = runBit + 1;
                if (runBit > 30) {
                    this.bitBuf = bbuf; this.bitCnt = bcnt; this.inPos = ipos;
                    return false;
                }
            } else {
                if (runLen > 0) {
                    int ch = mtfArr[0] & 255;
                    int need = nblock + runLen;
                    if (need > blockSize) {
                        this.bitBuf = bbuf; this.bitCnt = bcnt; this.inPos = ipos;
                        return false;
                    }
                    if (need > ttCap) {
                        ttArr = this.GrowTt(ttArr, nblock, need, blockSize);
                        ttCap = ttArr.Length;
                    }
                    unzf[ch] = unzf[ch] + runLen;
                    for (int k = 0; k < runLen; k = k + 1) {
                        ttArr[nblock + k] = ch;
                    }
                    nblock = need;
                    runLen = 0;
                    runBit = 0;
                }
                // sym-1 为 MTF 列表中的位置。
                int j = sym - 1;
                if (j >= nInUse) {
                    this.bitBuf = bbuf; this.bitCnt = bcnt; this.inPos = ipos;
                    return false;
                }
                byte tmp = mtfArr[j];
                if (j >= 16) {
                    NativeMemory.Copy((nint)mtfArr + 1, (nint)mtfArr, j);
                } else {
                    while (j > 0) {
                        mtfArr[j] = mtfArr[j - 1];
                        j = j - 1;
                    }
                }
                mtfArr[0] = tmp;
                int ch2 = tmp & 255;
                if (nblock >= blockSize) {
                    this.bitBuf = bbuf; this.bitCnt = bcnt; this.inPos = ipos;
                    return false;
                }
                if (nblock >= ttCap) {
                    ttArr = this.GrowTt(ttArr, nblock, nblock + 1, blockSize);
                    ttCap = ttArr.Length;
                }
                unzf[ch2] = unzf[ch2] + 1;
                ttArr[nblock] = ch2;
                nblock = nblock + 1;
            }
        }
        this.bitBuf = bbuf;
        this.bitCnt = bcnt;
        this.inPos = ipos;
        if (runLen > 0) {
            int ch = mtfArr[0] & 255;
            int need = nblock + runLen;
            if (need > blockSize) { return false; }
            if (need > ttCap) {
                ttArr = this.GrowTt(ttArr, nblock, need, blockSize);
                ttCap = ttArr.Length;
            }
            unzf[ch] = unzf[ch] + runLen;
            for (int k = 0; k < runLen; k = k + 1) {
                ttArr[nblock + k] = ch;
            }
            nblock = need;
        }
        if (nblock == 0 || origPtr >= nblock) { return false; }

        // --- 逆 BWT：把后继指针塞进 tt 的高位 ---
        int[] cf = this.cftab;
        cf[0] = 0;
        for (int i = 0; i < 256; i = i + 1) { cf[i + 1] = this.unzftab[i]; }
        for (int i = 1; i < 257; i = i + 1) { cf[i] = cf[i] + cf[i - 1]; }
        for (int i = 0; i < nblock; i = i + 1) {
            int ch = ttArr[i] & 255;
            int p = cf[ch];
            ttArr[p] = ttArr[p] | (i << 8);
            cf[ch] = p + 1;
        }

        // --- RLE1 解码 + CRC（局部变量化消除每字节方法调用与字段读写）---
        int crc = -1;  // 0xFFFFFFFF
        int[] crcTab = this.crcTable;
        byte[] obuf = this.outBuf;
        int obufLen = obuf.Length;
        int opos = this.outPos;
        int tPos = ttArr[origPtr] >> 8;
        int left = nblock;
        int prev = -1;
        int runCount = 0;
        while (left > 0) {
            tPos = ttArr[tPos];
            int ch = tPos & 255;
            tPos = tPos >> 8;
            left = left - 1;
            if (runCount == 4) {
                // 该字节是额外重复的次数（0..251）。
                byte pb = (byte)(prev & 255);
                for (int k = 0; k < ch; k = k + 1) {
                    crc = (crc << 8) ^ crcTab[((crc >> 24) ^ prev) & 255];
                    obuf[opos] = pb;
                    opos = opos + 1;
                    if (opos == obufLen) {
                        this.outPos = opos;
                        this.FlushOut();
                        opos = 0;
                    }
                }
                runCount = 0;
                prev = -1;
                continue;
            }
            if (ch == prev) {
                runCount = runCount + 1;
            } else {
                runCount = 1;
                prev = ch;
            }
            crc = (crc << 8) ^ crcTab[((crc >> 24) ^ ch) & 255];
            obuf[opos] = (byte)ch;
            opos = opos + 1;
            if (opos == obufLen) {
                this.outPos = opos;
                this.FlushOut();
                opos = 0;
            }
        }
        this.outPos = opos;
        this.blockCrc = crc;
        int got = (crc ^ -1);
        if (got != wantCrc) { return false; }
        this.combinedCrc = ((this.combinedCrc << 1) | ((this.combinedCrc >> 31) & 1))
            ^ got;
        return !this.failed;
    }

    // 按需扩容 tt 数组（倍增上限为 blockSize）。
    int[] GrowTt(int[] cur, int used, int need, int blockSize) {
        int ncap = cur.Length;
        while (ncap < need) {
            ncap = ncap * 2;
            if (ncap > blockSize) { ncap = blockSize; break; }
        }
        int[] nxt = new int[ncap];
        if (used > 0) {
            NativeMemory.Copy((nint)nxt, (nint)cur, used * 4);
        }
        this.tt = nxt;
        return nxt;
    }

    // bzip2 的 hbCreateDecodeTables：为一个组构建 limit/base/perm 与 10-bit 前缀直查表。
    bool BuildDecodeTables(int t, int alphaSize) {
        int lbase = t * (MaxCodeLen + 2);
        int lenBase = t * MaxAlphaSize;
        int pbase = t * MaxAlphaSize;
        int fbase = t * FastSize;
        int minLen = 32;
        int maxLen = 0;
        int[] cnt = new int[MaxCodeLen + 2];
        int[] lenArr = this.len;
        for (int i = 0; i < alphaSize; i = i + 1) {
            int l = lenArr[lenBase + i];
            if (l > maxLen) { maxLen = l; }
            if (l < minLen) { minLen = l; }
            if (l >= 0 && l <= MaxCodeLen) {
                cnt[l + 1] = cnt[l + 1] + 1;
            }
        }
        if (minLen < 1 || maxLen > MaxCodeLen) { return false; }
        this.minLens[t] = minLen;
        for (int i = 1; i < MaxCodeLen + 2; i = i + 1) {
            cnt[i] = cnt[i] + cnt[i - 1];
        }
        // 单遍计数排序构建 perm（O(alphaSize) 取代 O(maxLen * alphaSize)）。
        int[] writePos = new int[MaxCodeLen + 2];
        for (int i = 0; i < MaxCodeLen + 2; i = i + 1) {
            writePos[i] = cnt[i];
            this.limit[lbase + i] = 0;
            this.baseTab[lbase + i] = cnt[i];
        }
        int[] permArr = this.perm;
        for (int i = 0; i < alphaSize; i = i + 1) {
            int l = lenArr[lenBase + i];
            int wp = writePos[l];
            permArr[pbase + wp] = i;
            writePos[l] = wp + 1;
        }
        NativeMemory.Fill((nint)this.fastLut + fbase * 4, 0, FastSize * 4);
        int vec = 0;
        int pp2 = 0;
        int[] lut = this.fastLut;
        for (int l = minLen; l <= maxLen; l = l + 1) {
            int countL = cnt[l + 1] - cnt[l];
            if (l <= FastBits && countL > 0) {
                int shift = FastBits - l;
                int span = 1 << shift;
                int lenTag = l << 16;
                for (int k = 0; k < countL; k = k + 1) {
                    int entry = lenTag | permArr[pbase + pp2];
                    int slot = fbase + ((vec + k) << shift);
                    for (int m = 0; m < span; m = m + 1) {
                        lut[slot + m] = entry;
                    }
                    pp2 = pp2 + 1;
                }
            } else {
                pp2 = pp2 + countL;
            }
            vec = vec + countL;
            this.limit[lbase + l] = vec - 1;
            vec = vec << 1;
        }
        for (int l = minLen + 1; l <= maxLen; l = l + 1) {
            this.baseTab[lbase + l] =
                ((this.limit[lbase + l - 1] + 1) << 1) - this.baseTab[lbase + l];
        }
        return true;
    }

    // 长码（> 9 bit）或流尾剩余位不足 9 bit 时的标准 canonical Huffman 解码回退。
    int DecodeSlowSymbol(int gSel) {
        int lbase = gSel * (MaxCodeLen + 2);
        int zn = this.minLens[gSel];
        int zvec = this.GetBits(zn);
        if (zvec < 0) { return -1; }
        while (zn <= MaxCodeLen && zvec > this.limit[lbase + zn]) {
            zn = zn + 1;
            int b = this.GetBit();
            if (b < 0) { return -1; }
            zvec = (zvec << 1) | b;
        }
        if (zn > MaxCodeLen) { return -1; }
        int idx = zvec - this.baseTab[lbase + zn];
        if (idx < 0 || idx >= MaxAlphaSize) { return -1; }
        return this.perm[gSel * MaxAlphaSize + idx];
    }
}
