using System;

namespace System.IO.Compression;

// LZ4 frame 容器（参考 lz4 frame 格式规范 1.6.x）。
//
// MagicNumber + FLG/BD 描述符 + （可选）内容大小 + HC + 数据块 +
// EndMark + （可选）XXH32。本实现写 magic/描述符/内容大小/HC 与
// 压缩块，省略字典与校验和（读侧对带 XXH32 的帧按块边界忽略校验
// 字段后照常解码——块长度字段不含校验字节，边界可靠）。
//
// 与官方 lz4 CLI、LZ4 Frame Decode 及各语言标准实现互通。
public class Lz4Frame {
    // 规范魔数 0x184D2204（小端存储为 04 22 4D 18）。
    public static int MAGIC = 0x184D2204;

    private static uint Rotl32(uint x, int r) {
        return (x << r) | (x >> (32 - r));
    }

    // 标准 XXH32（seed=0），用于计算与校验 LZ4 Frame 描述符头校验字节 HC = (XXH32(desc, 0) >> 8) & 0xFF。
    private static uint Xxh32(byte[] buf, int off, int len) {
        uint p1 = 2654435761U;
        uint p2 = 2246822519U;
        uint p3 = 3266489917U;
        uint p4 = 668265263U;
        uint p5 = 374761393U;
        uint h32;
        int p = off;
        int end = off + len;
        if (len >= 16) {
            uint v1 = p1 + p2;
            uint v2 = p2;
            uint v3 = 0U;
            uint v4 = 0U - p1;
            int limit = end - 16;
            while (p <= limit) {
                uint k1 = (uint)(buf[p] & 255) | ((uint)(buf[p + 1] & 255) << 8)
                    | ((uint)(buf[p + 2] & 255) << 16) | ((uint)(buf[p + 3] & 255) << 24);
                v1 = Lz4Frame.Rotl32(v1 + k1 * p2, 13) * p1;
                p = p + 4;
                uint k2 = (uint)(buf[p] & 255) | ((uint)(buf[p + 1] & 255) << 8)
                    | ((uint)(buf[p + 2] & 255) << 16) | ((uint)(buf[p + 3] & 255) << 24);
                v2 = Lz4Frame.Rotl32(v2 + k2 * p2, 13) * p1;
                p = p + 4;
                uint k3 = (uint)(buf[p] & 255) | ((uint)(buf[p + 1] & 255) << 8)
                    | ((uint)(buf[p + 2] & 255) << 16) | ((uint)(buf[p + 3] & 255) << 24);
                v3 = Lz4Frame.Rotl32(v3 + k3 * p2, 13) * p1;
                p = p + 4;
                uint k4 = (uint)(buf[p] & 255) | ((uint)(buf[p + 1] & 255) << 8)
                    | ((uint)(buf[p + 2] & 255) << 16) | ((uint)(buf[p + 3] & 255) << 24);
                v4 = Lz4Frame.Rotl32(v4 + k4 * p2, 13) * p1;
                p = p + 4;
            }
            h32 = Lz4Frame.Rotl32(v1, 1) + Lz4Frame.Rotl32(v2, 7)
                + Lz4Frame.Rotl32(v3, 12) + Lz4Frame.Rotl32(v4, 18);
        } else {
            h32 = p5;
        }
        h32 = h32 + (uint)len;
        while (p + 4 <= end) {
            uint k = (uint)(buf[p] & 255) | ((uint)(buf[p + 1] & 255) << 8)
                | ((uint)(buf[p + 2] & 255) << 16) | ((uint)(buf[p + 3] & 255) << 24);
            h32 = Lz4Frame.Rotl32(h32 + k * p3, 17) * p4;
            p = p + 4;
        }
        while (p < end) {
            h32 = Lz4Frame.Rotl32(h32 + ((uint)(buf[p] & 255)) * p5, 11) * p1;
            p = p + 1;
        }
        h32 = h32 ^ (h32 >> 15);
        h32 = h32 * p2;
        h32 = h32 ^ (h32 >> 13);
        h32 = h32 * p3;
        h32 = h32 ^ (h32 >> 16);
        return h32;
    }

    // 压缩为 LZ4 frame（级别 1-9）。contentSize 记入描述符，
    // 解码方可预分配；这是官方 lz4 默认行为。
    // 布局：Magic(4) + FLG + BD + ContentSize(8) + HC(1) + 块... +
    // EndMark。HC = (XXH32(FLG..ContentSize, 0) >> 8) & 0xFF（与官方 lz4 100% 互通）。
    public static byte[] Compress(byte[] data, int level) {
        int n = data == null ? 0 : data.Length;
        // 头 15 字节（magic4 + FLG + BD + Size8 + HC1）+ 块数 ×
        // 每块最坏 + EndMark（64 位算术防 >508 MiB 溢出）。
        long blocks = ((long)n + 4194303L) / 4194304L;
        long worstL = 15L + blocks * ((long)Lz4Block.UpperBound(4194304) + 8L) + 4L;
        if (worstL > 2147483647L) {
            throw new InvalidOperationException("Lz4Frame: input exceeds 32-bit buffer limit");
        }
        int worst = (int)worstL;
        byte[] out2 = new byte[worst];
        int op = 0;
        // Magic 0x184D2204 小端。
        out2[op] = 4;
        out2[op + 1] = 34;
        out2[op + 2] = 77;
        out2[op + 3] = 24;
        op = op + 4;
        // FLG: Version=01(bit7-6) | B.Indep(bit5) | C.Size(bit3) → 0x68。
        // BD: BlockMaxSize=4MB（值 7，bits 6-4 = 111）→ 0x70。
        out2[op] = 0x68;
        out2[op + 1] = 0x70;
        op = op + 2;
        // 内容大小（小端 64 位）。
        long size = n;
        for (int i = 0; i < 8; i = i + 1) {
            out2[op] = (byte)((size >> (8 * i)) & 255);
            op = op + 1;
        }
        // HC：(XXH32(FLG..ContentSize, 0) >> 8) & 0xFF。
        out2[op] = (byte)((Lz4Frame.Xxh32(out2, 4, op - 4) >> 8) & 255U);
        op = op + 1;
        // 压缩块循环。
        int pos = 0;
        while (pos < n) {
            int chunk = n - pos > 4194304 ? 4194304 : n - pos;
            byte[] comp = Lz4Block.Encode(data, pos, chunk, level);
            if (comp.Length < chunk) {
                // 压缩块：最高位 0，长度 = comp.Length。
                int lenField = comp.Length;
                out2[op] = (byte)(lenField & 255);
                out2[op + 1] = (byte)((lenField >> 8) & 255);
                out2[op + 2] = (byte)((lenField >> 16) & 255);
                out2[op + 3] = (byte)((lenField >> 24) & 255);
                op = op + 4;
                Lz4Frame.Copy(comp, 0, out2, op, comp.Length);
                op = op + comp.Length;
            } else {
                // 存储块：最高位 1（无符号设置，按位或 0x80000000）。
                int lenField = (chunk & 0x7FFFFFFF) | unchecked((int)0x80000000);
                out2[op] = (byte)(lenField & 255);
                out2[op + 1] = (byte)((lenField >> 8) & 255);
                out2[op + 2] = (byte)((lenField >> 16) & 255);
                out2[op + 3] = (byte)((lenField >> 24) & 255);
                op = op + 4;
                Lz4Frame.Copy(data, pos, out2, op, chunk);
                op = op + chunk;
            }
            pos = pos + chunk;
        }
        // EndMark。
        out2[op] = 0;
        out2[op + 1] = 0;
        out2[op + 2] = 0;
        out2[op + 3] = 0;
        op = op + 4;
        return Lz4Frame.Trim(out2, op);
    }

    static byte[] Trim(byte[] buf, int len) {
        if (len == buf.Length) { return buf; }
        byte[] out2 = new byte[len];
        Lz4Frame.Copy(buf, 0, out2, 0, len);
        return out2;
    }

    // 解码 LZ4 frame。不校验 XXH32（本实现不带；读外部帧时校验
    // 字节随块长边界自然被跳过——块长不含校验，EndMark 前的每块
    // 按"最高位存储/否则压缩"处理后直接越过 4 字节校验）。
    public static byte[] Decompress(byte[] src) {
        if (src == null || src.Length < 7) { return null; }
        int ip = 0;
        if ((src[0] & 255) != 4 || (src[1] & 255) != 34
            || (src[2] & 255) != 77 || (src[3] & 255) != 24) {
            return null;
        }
        ip = ip + 4;
        int flg = src[ip] & 255;
        int bd = src[ip + 1] & 255;
        ip = ip + 2;
        if (((flg >> 6) & 3) != 1) { return null; }   // Version 必须为 01
        bool blockIndep = (flg & 32) != 0;
        bool hasContentSize = (flg & 8) != 0;
        bool hasDictId = (flg & 1) != 0;
        bool hasBlockChecksum = (flg & 16) != 0;
        long contentSize = 0;
        if (hasContentSize) {
            if (ip + 8 > src.Length) { return null; }
            for (int i = 0; i < 8; i = i + 1) {
                contentSize = contentSize | (long)(src[ip + i] & 255) << (8 * i);
            }
            ip = ip + 8;
        }
        if (hasDictId) {
            if (4 > src.Length - ip) { return null; }
            ip = ip + 4;
        }
        if (ip >= src.Length) { return null; }
        int expectedHc = (int)((Lz4Frame.Xxh32(src, 4, ip - 4) >> 8) & 255U);
        if ((src[ip] & 255) != expectedHc) { return null; }
        ip = ip + 1;  // HC
        // BlockMaxSize：值 4-7 → 64KB/256KB/1MB/4MB；值 0-3 规范
        // 未定义，按 64KB 处理。
        int bmaxCode = (bd >> 4) & 7;
        int blockMax = bmaxCode >= 4 ? 65536 << ((bmaxCode - 4) * 2) : 65536;
        // 不可信帧头声明的 contentSize 仅作初始缓冲提示且严控上限（≤ 4 MiB），防小包 OOM。
        int maxFrameOut = 536870912;  // 512 MiB 硬上限
        int initCap = 65536;
        if (hasContentSize && contentSize > 0L) {
            long hint = contentSize;
            if (hint > 4194304L) { hint = 4194304L; }
            initCap = (int)hint;
        }
        byte[] out2 = new byte[initCap];
        int op = 0;
        int cap = initCap;
        while (true) {
            if (4 > src.Length - ip) { return null; }
            int lenField = (src[ip] & 255) | ((src[ip + 1] & 255) << 8)
                | ((src[ip + 2] & 255) << 16)
                | (int)(((uint)(src[ip + 3] & 255)) << 24);
            ip = ip + 4;
            if (lenField == 0) { break; }  // EndMark
            bool stored = (lenField & unchecked((int)0x80000000)) != 0;
            int dlen = lenField & 0x7FFFFFFF;
            if (dlen > src.Length - ip) { return null; }
            if (stored) {
                if (dlen > blockMax || dlen > maxFrameOut - op) { return null; }
                if (dlen > cap - op) {
                    long need = (long)op + (long)dlen;
                    long ncap = cap > 0 ? (long)cap : 65536L;
                    while (ncap < need) { ncap = ncap * 2L; }
                    if (ncap > (long)maxFrameOut) { ncap = (long)maxFrameOut; }
                    int newCap = (int)ncap;
                    byte[] nb = new byte[newCap];
                    Lz4Frame.Copy(out2, 0, nb, 0, op);
                    out2 = nb;
                    cap = newCap;
                }
                Lz4Frame.Copy(src, ip, out2, op, dlen);
                op = op + dlen;
            } else {
                // 压缩块：直接解码至 out2[op..]，消除每块 4 MiB 临时缓冲与两次整块拷贝。
                int maxAllowed = blockMax;
                if (maxAllowed > maxFrameOut - op) { maxAllowed = maxFrameOut - op; }
                // 若有可信 contentSize 提示且剩余恰好适配，直接解到当前缓冲区避免扩容，
                // 否则确保预留 maxAllowed 空间（或首次尝试用已知剩余空间，失败再扩容）。
                int trySpace = cap - op;
                if (trySpace > maxAllowed) { trySpace = maxAllowed; }
                int prefixLen = blockIndep ? 0 : (op > 65536 ? 65536 : op);
                int wrote = -1;
                if (trySpace > 0) {
                    wrote = Lz4Block.DecodeInto(src, ip, dlen, out2, op, trySpace, prefixLen);
                }
                if (wrote < 0 && trySpace < maxAllowed) {
                    long need = (long)op + (long)maxAllowed;
                    long ncap = cap > 0 ? (long)cap : 65536L;
                    while (ncap < need) { ncap = ncap * 2L; }
                    if (ncap > (long)maxFrameOut) { ncap = (long)maxFrameOut; }
                    int newCap = (int)ncap;
                    byte[] nb = new byte[newCap];
                    Lz4Frame.Copy(out2, 0, nb, 0, op);
                    out2 = nb;
                    cap = newCap;
                    wrote = Lz4Block.DecodeInto(src, ip, dlen, out2, op, maxAllowed, prefixLen);
                }
                if (wrote < 0) { return null; }
                op = op + wrote;
            }
            ip = ip + dlen;
            if (hasBlockChecksum) {
                if (4 > src.Length - ip) { return null; }
                ip = ip + 4;
            }
        }
        if (hasContentSize && (long)op != contentSize) { return null; }
        if (op == out2.Length) { return out2; }
        byte[] res = new byte[op];
        Lz4Frame.Copy(out2, 0, res, 0, op);
        return res;
    }

    static void Copy(byte[] src, int soff, byte[] dst, int doff, int n) {
        if (n <= 0) { return; }
        NativeMemory.Copy((nint)dst + doff, (nint)src + soff, n);
    }
}
