using System;

namespace System.IO.Compression;

// zstd 解码失败的原因（可区分的错误码）。
//
// **为什么要错误码**：zstd 帧的失败原因差别很大——"不是 zstd 数据"是调用方
// 传错了文件，"校验和不符"是数据在传输中损坏，"偏移越界"是帧被截断或被
// 恶意构造，"需要字典"是调用方漏传字典。合成一句话会让调用方没法分别处理
// （"校验和不符"要重试或报警，"不是 zstd 数据"要换格式探测，"偏移越界"要
// 当作不可信输入丢掉）。
public enum ZstdError {
    // 没有错误。
    None = 0,
    // 魔数不对：输入不是 zstd 数据。
    NotZstd = 1,
    // 数据被截断（帧头/块/校验和没读够）。
    Truncated = 2,
    // 帧头非法（保留位非零、字段越界、窗口大小离谱）。
    BadFrameHeader = 3,
    // 帧声明了字典 ID——本实现只支持无字典的帧。
    DictionaryRequired = 4,
    // 块类型非法（保留类型 3）或块大小越界。
    BadBlock = 5,
    // 字面量段非法（头部字段越界、类型不自洽）。
    BadLiterals = 6,
    // Huffman 树描述或码流非法（权重不构成树、码流没读干净）。
    BadHuffman = 7,
    // FSE 表描述非法（归一化计数不成立、精度超限）。
    BadFse = 8,
    // 序列段非法（序列数/压缩模式/位流越界）。
    BadSequences = 9,
    // 偏移越界（超过窗口大小或超过本帧已解压的数据）。
    BadOffset = 10,
    // 内容校验和（XXH64）与声明不符——数据在传输中损坏或被篡改。
    ChecksumMismatch = 11,
    // 解压后的大小与帧头声明的 Frame_Content_Size 不符。
    SizeMismatch = 12,
    // 内部错误（不应该发生；出现即说明实现里有 bug）。
    Internal = 13,
}

// zstd 解码失败时抛出的异常。
//
// 带**错误码**，调用方可以按 <see cref="ZstdError"/> 分支处理，而不用去
// 解析消息文本。
public class ZstdException : Exception {
    // 失败原因（可区分的错误码）。
    public ZstdError Code;

    // 以错误码与描述性消息构造。
    public ZstdException(ZstdError code, string message) {
        this.Code = code;
        Message = message;
    }
}
