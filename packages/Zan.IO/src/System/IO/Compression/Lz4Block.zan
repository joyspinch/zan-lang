using System;

namespace System.IO.Compression;

// LZ4 block 压缩（参考 lz4 块格式规范 v1.0）。
//
// 实现的是规范要求的解码器全集与一个务实的编码器：
// 哈希表 16 位、单步匹配、64KB 窗口内的 last-match 贪心扩展。
// 产出任何符合规范的 LZ4 解码器（含本类 Decode）都能还原。
// 压缩比与官方 lz4 快速档有差距，但速度特性一致——
// 面向 Kafka / ZanDb / DataFrame 的"能压就行、快最重要"场景。
public class Lz4Block {
    // 哈希表容量（2 的幂）。64K 桶 × 4 字节 int = 256KB 临时表，
    // 与 Deflate 编码器的表开销同量级。
    public static int HASH_LOG = 16;
    public static int HASH_SIZE = 65536;
    public static int MIN_MATCH = 4;
    // 单块上限（规范）：压缩后块不得超过该值，否则视为不可压。
    public static int MAX_BLOCK_BYTES = 16777216;
    public static int MAX_INPUT_FOR_BLOCK = 2113929216;

    // ---- 解码 ----

    // 直接解码一个 LZ4 block 到目标缓冲区 dst[dstOffset .. dstOffset + maxOut)；
    // 成功返回写出的字节数，越界或格式损坏返回 -1。
    public static int DecodeInto(byte[] src, int offset, int len, byte[] dst, int dstOffset, int maxOut) {
        return Lz4Block.DecodeInto(src, offset, len, dst, dstOffset, maxOut, 0);
    }

    // 支持前置历史窗口 prefixLen（用于 LZ4 linked blocks，matchOff 可回溯至 dstOffset - prefixLen）。
    public static int DecodeInto(byte[] src, int offset, int len, byte[] dst, int dstOffset, int maxOut, int prefixLen) {
        if (src == null || dst == null || len < 0 || offset < 0 || offset > src.Length - len
            || dstOffset < 0 || maxOut < 0 || dstOffset > dst.Length - maxOut) {
            return -1;
        }
        if (prefixLen < 0) { prefixLen = 0; }
        if (prefixLen > dstOffset) { prefixLen = dstOffset; }
        if (len == 0) { return 0; }
        if (maxOut == 0) { return -1; }
        nint outPtr = (nint)dst + dstOffset;
        nint srcPtr = (nint)src;
        int ip = offset;
        int end = offset + len;
        int op = 0;
        while (ip < end) {
            int token = src[ip] & 255;
            ip = ip + 1;
            int litLen = (token >> 4) & 15;
            if (litLen == 15) {
                while (true) {
                    if (ip >= end) { return -1; }
                    int b = src[ip] & 255;
                    ip = ip + 1;
                    if (b > maxOut - op - litLen || b > end - ip - litLen) { return -1; }
                    litLen = litLen + b;
                    if (b != 255) { break; }
                }
            }
            if (litLen > 0) {
                if (litLen > end - ip || litLen > maxOut - op) { return -1; }
                if (litLen < 16) {
                    int dOff = dstOffset + op;
                    for (int k = 0; k < litLen; k = k + 1) {
                        dst[dOff + k] = src[ip + k];
                    }
                } else {
                    NativeMemory.Copy(outPtr + op, srcPtr + ip, litLen);
                }
                op = op + litLen;
                ip = ip + litLen;
            }
            if (ip >= end) { break; }
            if (2 > end - ip) { return -1; }
            int matchOff = (src[ip] & 255) + ((src[ip + 1] & 255) << 8);
            ip = ip + 2;
            if (matchOff == 0 || matchOff > op + prefixLen) { return -1; }
            int matchLen = (token & 15) + 4;
            if (matchLen > maxOut - op) { return -1; }
            if ((token & 15) == 15) {
                while (true) {
                    if (ip >= end) { return -1; }
                    int b = src[ip] & 255;
                    ip = ip + 1;
                    if (b > maxOut - op - matchLen) { return -1; }
                    matchLen = matchLen + b;
                    if (b != 255) { break; }
                }
            }
            if (matchLen > maxOut - op) { return -1; }
            int mp = op - matchOff;
            if (matchOff >= matchLen) {
                if (matchLen < 16) {
                    int dOff = dstOffset + op;
                    int sOff = dstOffset + mp;
                    for (int k = 0; k < matchLen; k = k + 1) {
                        dst[dOff + k] = dst[sOff + k];
                    }
                } else {
                    NativeMemory.Copy(outPtr + op, outPtr + mp, matchLen);
                }
                op = op + matchLen;
            } else if (matchOff == 1) {
                NativeMemory.Fill(outPtr + op, dst[dstOffset + mp] & 255, matchLen);
                op = op + matchLen;
            } else {
                int done = 0;
                while (done < matchOff && done < matchLen) {
                    dst[dstOffset + op] = dst[dstOffset + mp];
                    op = op + 1;
                    mp = mp + 1;
                    done = done + 1;
                }
                while (done < matchLen) {
                    int step = matchLen - done > done ? done : matchLen - done;
                    NativeMemory.Copy(outPtr + op, outPtr + op - done, step);
                    op = op + step;
                    done = done + step;
                }
            }
        }
        return op;
    }

    // 解码一个 LZ4 block。dst 已知大小时用 maxOut 限制（防恶意
    // 输入撑爆内存）；超出返回 null。输出不足是错误（截断）。
    public static byte[] Decode(byte[] src, int offset, int len, int maxOut) {
        if (src == null || len < 0 || offset < 0 || offset > src.Length - len || maxOut < 0) {
            return null;
        }
        if (len == 0) {
            return new byte[0];
        }
        if (maxOut == 0) {
            return null;
        }
        byte[] out2 = new byte[maxOut];
        int op = Lz4Block.DecodeInto(src, offset, len, out2, 0, maxOut);
        if (op < 0) { return null; }
        return Lz4Block.Trim(out2, op);
    }

    static byte[] Trim(byte[] buf, int len) {
        if (len == buf.Length) { return buf; }
        byte[] out2 = new byte[len];
        Lz4Block.CopyBytes(out2, 0, buf, 0, len);
        return out2;
    }

    static void CopyBytes(byte[] dst, int doff, byte[] src, int soff, int n) {
        if (n <= 0) { return; }
        NativeMemory.Copy((nint)dst + doff, (nint)src + soff, n);
    }

    // ---- 编码 ----

    // 压缩一个 block。level 1-9 影响匹配尝试的扩展上限（越大
    // 压缩比越高、越慢）。数据不可压时输出可能大于输入——调用方
    // 可用 EncodedSize 判断是否回退存储。
    public static byte[] Encode(byte[] src, int level) {
        if (src == null) { return new byte[0]; }
        return Lz4Block.Encode(src, 0, src.Length, level);
    }

    // 压缩 src[offset, offset+len) 切片（frame 分块复用）。
    public static byte[] Encode(byte[] src, int offset, int len, int level) {
        int n = len;
        if (src == null || offset < 0 || len < 0 || offset + len > src.Length) {
            return new byte[0];
        }
        if (n == 0) { return new byte[0]; }
        // 空 / 太短输入直接走"仅字面量"的退化块（合法且最小）。
        if (n < MIN_MATCH + 1) {
            return Lz4Block.LiteralsOnly(src, offset, n);
        }
        int maxOut = Lz4Block.UpperBound(n);
        byte[] out2 = new byte[maxOut + 8];
        // 自适应哈希表尺寸：小块免去 256 KiB 分配与清零，大块保留 64K 桶高命中率。
        int hashLog = 16;
        if (n <= 256) { hashLog = 8; }
        else if (n <= 1024) { hashLog = 10; }
        else if (n <= 4096) { hashLog = 12; }
        else if (n <= 16384) { hashLog = 14; }
        int hashSize = 1 << hashLog;
        int hashShift = 32 - hashLog;
        int[] table = new int[hashSize];
        NativeMemory.Fill((nint)table, 255, hashSize * 4);
        int op = 0;
        int anchor = 0;
        int ip = 0;
        int baseOff = offset;
        int mflimit = n - MIN_MATCH;
        int maxChain = Lz4Block.ChainLength(level);
        // LZ4 标准失配加速：不可压区逐步加大探针步长（1 + (miss >> 6)），命中后清零。
        int miss = 0;
        while (ip <= mflimit) {
            int p0 = baseOff + ip;
            int cur4 = (src[p0] & 255) | ((src[p0 + 1] & 255) << 8)
                | ((src[p0 + 2] & 255) << 16) | ((src[p0 + 3] & 255) << 24);
            int h = (int)(((uint)cur4 * 2654435761U) >> hashShift);
            int cand = table[h];
            table[h] = ip;
            if (cand < 0 || ip - cand > 65535) {
                ip = ip + 1 + (miss >> 6);
                miss = miss + 1;
                continue;
            }
            int q0 = baseOff + cand;
            int cand4 = (src[q0] & 255) | ((src[q0 + 1] & 255) << 8)
                | ((src[q0 + 2] & 255) << 16) | ((src[q0 + 3] & 255) << 24);
            if (cand4 != cur4) {
                ip = ip + 1 + (miss >> 6);
                miss = miss + 1;
                continue;
            }
            miss = 0;
            // 找到 4 字节匹配：token 低 4 位承载 matchLen-4 的低段，
            // 再写字面量段。
            int litLen = ip - anchor;
            // 扩展匹配：从候选位重叠续比（重叠复制合法，解码器
            // 逐字节展开，可越过 match 起点）；maxChain 限步数。
            int matchLen = MIN_MATCH;
            int limit = ip + maxChain < n ? ip + maxChain : n;
            int p = p0 + MIN_MATCH;
            int q = q0 + MIN_MATCH;
            int pEnd = baseOff + limit;
            while (p + 4 <= pEnd) {
                int w1 = (src[p] & 255) | ((src[p + 1] & 255) << 8)
                    | ((src[p + 2] & 255) << 16) | ((src[p + 3] & 255) << 24);
                int w2 = (src[q] & 255) | ((src[q + 1] & 255) << 8)
                    | ((src[q + 2] & 255) << 16) | ((src[q + 3] & 255) << 24);
                if (w1 != w2) { break; }
                p = p + 4;
                q = q + 4;
                matchLen = matchLen + 4;
            }
            while (p < pEnd && src[p] == src[q]) {
                p = p + 1;
                q = q + 1;
                matchLen = matchLen + 1;
            }
            int ext = matchLen - MIN_MATCH;  // 不含初始 4 的部分
            int low = ext >= 15 ? 15 : ext;
            op = Lz4Block.WriteToken(out2, op, src, baseOff + anchor, litLen, low);
            // 格式顺序：token → 字面量 → 2 字节 offset → matchLen 扩展。
            int off = ip - cand;
            out2[op] = (byte)(off & 255);
            out2[op + 1] = (byte)((off >> 8) & 255);
            op = op + 2;
            if (ext >= 15) {
                op = Lz4Block.WriteMatchLen(out2, op, ext);
            }
            ip = ip + matchLen;
            anchor = ip;
            // 跳过哈希污染区，加速。
            ip = ip + 1;
        }
        // 尾部字面量。
        if (anchor < n) {
            int litLen = n - anchor;
            op = Lz4Block.WriteToken(out2, op, src, baseOff + anchor, litLen, 0);
        }
        return Lz4Block.Trim(out2, op);
    }

    static int ChainLength(int level) {
        if (level >= 9) { return 4096; }
        if (level >= 7) { return 512; }
        if (level >= 5) { return 128; }
        if (level >= 3) { return 32; }
        return 8;
    }

    // 只写字面量的退化块（尾段专用语义由 Encode 主循环维护；
    // 这里用于极短输入，作为唯一序列）。
    static byte[] LiteralsOnly(byte[] src, int offset, int len) {
        int maxOut = Lz4Block.UpperBound(len);
        byte[] out2 = new byte[maxOut + 8];
        int op = Lz4Block.WriteToken(out2, 0, src, offset, len, 0);
        return Lz4Block.Trim(out2, op);
    }

    // 写一个序列头 + 字面量，返回新的 op。matchLenHalf 是 token
    // 低 4 位（后续可用 WriteMatchLen 续写扩展）。
    static int WriteToken(byte[] out2, int op, byte[] src, int anchor,
                          int litLen, int matchLenHalf) {
        int high = litLen >= 15 ? 15 : litLen;
        out2[op] = (byte)((high << 4) | matchLenHalf);
        op = op + 1;        if (litLen >= 15) {
            int rest = litLen - 15;
            while (rest >= 255) {
                out2[op] = 255;
                op = op + 1;
                rest = rest - 255;
            }
            out2[op] = (byte)rest;
            op = op + 1;
        }
        if (litLen < 16) {
            for (int k = 0; k < litLen; k = k + 1) {
                out2[op + k] = src[anchor + k];
            }
        } else {
            NativeMemory.Copy((nint)out2 + op, (nint)src + anchor, litLen);
        }
        return op + litLen;
    }

    // 写匹配长度扩展字节（ext >= 15 时的后续 255 连发段；低段
    // 已融入 token，由 Encode 保证只在 ext >= 15 时调用）。
    static int WriteMatchLen(byte[] out2, int op, int ext) {
        int rest = ext - 15;
        while (rest >= 255) {
            out2[op] = 255;
            op = op + 1;
            rest = rest - 255;
        }
        out2[op] = (byte)rest;
        return op + 1;
    }

    static int Hash4(byte[] src, int i) {
        // 乘法哈希取高 16 位（Fibonacci 哈希家族，uint 逻辑右移）。
        int v = Lz4Block.Read4(src, i);
        return (int)(((uint)(v * 265443576)) >> 16) & (Lz4Block.HASH_SIZE - 1);
    }

    static int Read4(byte[] src, int i) {
        return (src[i] & 255) | ((src[i + 1] & 255) << 8)
            | ((src[i + 2] & 255) << 16) | ((src[i + 3] & 255) << 24);
    }

    // 压缩输出的最坏上界（规范公式）：n + n/255 + 16。
    public static int UpperBound(int n) {
        return n + n / 255 + 16;
    }
}
