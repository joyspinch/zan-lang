using System;
using System.IO;

namespace System.IO.Compression;

// ustar tar 读写与流式解包（支持 ustar prefix 与 GNU 'L' 长文件名及防逃逸校验）。
public class Tar {
    [DllImport("crt", EntryPoint = "zan_file_fopen")]
    private static extern nint PlatFopen(string path, string mode);

    [DllImport("crt", EntryPoint = "fread")]
    private static extern long PlatFread(byte[] buf, long size, long count, nint fp);

    [DllImport("crt", EntryPoint = "fwrite")]
    private static extern long PlatFwrite(byte[] buf, long size, long count, nint fp);

    [DllImport("crt", EntryPoint = "fclose")]
    private static extern int PlatFclose(nint fp);

    // 在内存中构建 tar 归档（mode==0 时文件取 0644、目录取 0755；结尾附两个 512 字节零块）。
    public static byte[] Create(List<TarEntry> entries) {
        if (entries == null) { return new byte[1024]; }
        long total64 = 1024L;
        for (int i = 0; i < entries.Count; i = i + 1) {
            TarEntry e = entries[i];
            if (e == null) { continue; }
            long dlen = (e.data == null) ? 0L : (long)e.data.Length;
            long padded = ((dlen + 511L) / 512L) * 512L;
            total64 = total64 + 512L + padded;
            if (total64 > 2147483647L) {
                throw new IOException("Tar.Create: archive size exceeds 2 GiB limit");
            }
        }
        byte[] out2 = new byte[(int)total64];
        int pos = 0;
        for (int i = 0; i < entries.Count; i = i + 1) {
            TarEntry e = entries[i];
            if (e == null) { continue; }
            Tar.WriteHeader(out2, pos, e);
            pos = pos + 512;
            if (e.data != null && e.data.Length > 0) {
                NativeMemory.Copy((nint)out2 + (nint)pos, (nint)e.data, e.data.Length);
                pos = pos + (int)((((long)e.data.Length + 511L) / 512L) * 512L);
            }
        }
        return out2;
    }

    // 读取 tar 归档全部条目；校验和不符或 size 越界返回 null。
    public static List<TarEntry> Read(byte[] tar) {
        List<TarEntry> entries = new List<TarEntry>();
        int pos = 0;
        while (pos + 512 <= tar.Length) {
            if (tar[pos] == 0) {
                if (Tar.IsZeroBlock(tar, pos)) { break; }
                pos = pos + 512;
                continue;
            }
            int stored = Tar.ParseOctal(tar, pos + 148, 8);
            int computed = Tar.HeaderSum(tar, pos);
            if (stored != computed) { return null; }
            string name = Tar.ReadStr(tar, pos, 100);
            string prefix = Tar.ReadStr(tar, pos + 345, 155);
            if (prefix.Length > 0) { name = prefix + "/" + name; }
            long size = Tar.ParseSize(tar, pos + 124);
            int type = tar[pos + 156] & 255;
            // 用 long 做越界检查，防止 (size + 511) 的 32 位溢出绕过边界。
            if (size < 0) { return null; }
            long dataLen = ((size + 511) / 512) * 512;
            if ((long)pos + 512 + dataLen > tar.Length) { return null; }
            TarEntry e = new TarEntry(name);
            e.mode = Tar.ParseOctal(tar, pos + 100, 8);
            e.mtime = Tar.ParseSize(tar, pos + 136);
            if (type == 53) {
                e.isDirectory = true;
            } else if (type == 0 || type == 48) {
                int isz = (int)size;
                e.data = new byte[isz];
                if (isz > 0) {
                    NativeMemory.Copy((nint)e.data, (nint)tar + (nint)(pos + 512), isz);
                }
            } else {
                e.isDirectory = false;
                e.data = null;
            }
            entries.Add(e);
            pos = pos + 512 + (int)dataLen;
        }
        return entries;
    }

    // 写出 512 字节 ustar 头部（>100 字节按最靠前 '/' 拆进 prefix<=155 + name<=100）。
    private static void WriteHeader(byte[] b, int off, TarEntry e) {
        string name = e.name;
        string prefix = "";
        if (name.Length > 100) {
            int split = -1;
            for (int i = 0; i < name.Length && i <= 155; i = i + 1) {
                if ((name[i] & 255) == 47 && name.Length - i - 1 <= 100) {
                    split = i;
                    break;
                }
            }
            if (split > 0) {
                prefix = name.Substring(0, split);
                name = name.Substring(split + 1, name.Length - split - 1);
            } else {
                name = name.Substring(0, 100);
            }
        }
        Tar.WriteStrZeroed(b, off, name, 100);
        Tar.WriteOctal(b, off + 100, e.mode == 0 ? (e.isDirectory ? 493 : 420) : e.mode, 8);
        Tar.WriteOctal(b, off + 108, 0, 8);
        Tar.WriteOctal(b, off + 116, 0, 8);
        int size = (e.isDirectory || e.data == null) ? 0 : e.data.Length;
        Tar.WriteOctal(b, off + 124, size, 12);
        Tar.WriteOctal(b, off + 136, e.mtime, 12);
        NativeMemory.Fill((nint)b + (nint)(off + 148), 32, 8);
        b[off + 156] = (byte)(e.isDirectory ? 53 : 48);
        b[off + 257] = 117; b[off + 258] = 115; b[off + 259] = 116; b[off + 260] = 97; b[off + 261] = 114;
        b[off + 265] = 48; b[off + 266] = 48;
        Tar.WriteOctal(b, off + 329, 0, 8);
        Tar.WriteOctal(b, off + 337, 0, 8);
        if (prefix.Length > 0) {
            Tar.WriteStrZeroed(b, off + 345, prefix, 155);
        }
        int sum = Tar.HeaderSum(b, off);
        Tar.WriteOctal(b, off + 148, sum, 8);
    }

    // 头部校验和：512 字节求和，校验和字段本身按 8 个
    // 空格（0x20 = 256）计入；拆分为两段无分支 Span<byte> 4 路展开累加。
    private static int HeaderSum(byte[] b, int off) {
        Span<byte> s = new Span<byte>((nint)b + (nint)off, 512);
        int sum = 256;
        int i = 0;
        while (i < 148) {
            sum = sum + (s[i] & 255) + (s[i + 1] & 255) + (s[i + 2] & 255) + (s[i + 3] & 255);
            i = i + 4;
        }
        i = 156;
        while (i < 512) {
            sum = sum + (s[i] & 255) + (s[i + 1] & 255) + (s[i + 2] & 255) + (s[i + 3] & 255);
            i = i + 4;
        }
        return sum;
    }

    // off 处起 512 字节是否全为零（Span<long> 64 位 8 字节批量判零）。
    private static bool IsZeroBlock(byte[] b, int off) {
        Span<long> w = new Span<long>((nint)b + (nint)off, 64);
        for (int i = 0; i < 64; i = i + 1) {
            if (w[i] != 0L) { return false; }
        }
        return true;
    }

    // 写入已清零缓冲区的定长字符串字段（省去重复 Fill 0）。
    private static void WriteStrZeroed(byte[] b, int off, string s, int maxLen) {
        int n = s.Length;
        if (n > maxLen) { n = maxLen; }
        if (n > 0) {
            NativeMemory.Copy((nint)b + (nint)off, (nint)s, n);
        }
    }

    // 把字符串写入定长字段：超出截断，尾部以 NUL 补齐。
    private static void WriteStr(byte[] b, int off, string s, int maxLen) {
        int n = s.Length;
        if (n > maxLen) { n = maxLen; }
        if (n > 0) {
            NativeMemory.Copy((nint)b + (nint)off, (nint)s, n);
        }
        if (n < maxLen) {
            NativeMemory.Fill((nint)b + (nint)(off + n), 0, maxLen - n);
        }
    }

    // 读取定长字段中 NUL 之前的字符串（SIMD memchr 查找 NUL）。
    private static string ReadStr(byte[] b, int off, int maxLen) {
        if (maxLen <= 0 || b[off] == 0) { return ""; }
        int hit = NativeMemory.Find((nint)b, off, 0, maxLen);
        int len = hit < 0 ? maxLen : (hit - off);
        if (len == 0) { return ""; }
        return b.ToStr(off, len);
    }

    // POSIX 八进制字段（右对齐、末字节 NUL、高位补空格，零分配直写）。
    private static void WriteOctal(byte[] b, int off, long v, int fieldLen) {
        Span<byte> s = new Span<byte>((nint)b + (nint)off, fieldLen);
        int pos = fieldLen - 2;
        long val = v;
        while (val > 0 && pos >= 0) {
            s[pos] = (byte)(48 + (int)(val & 7));
            val = val >> 3;
            pos = pos - 1;
        }
        while (pos >= 0) {
            s[pos] = 32;
            pos = pos - 1;
        }
        s[fieldLen - 1] = 0;
    }

    // 解析八进制字段（忽略空格与非八进制字符；仅用于 int 范围字段，size 请用 ParseSize）。
    private static int ParseOctal(byte[] b, int off, int fieldLen) {
        Span<byte> s = new Span<byte>((nint)b + (nint)off, fieldLen);
        int v = 0;
        for (int i = 0; i < fieldLen; i = i + 1) {
            int c = s[i] & 255;
            if (c >= 48 && c <= 55) {
                v = (v << 3) | (c - 48);
            }
        }
        return v;
    }

    // 12 位八进制大数值字段（size/mtime）：用 long 累计防止 32 位截断绕过边界。
    private static long ParseSize(byte[] b, int off) {
        Span<byte> s = new Span<byte>((nint)b + (nint)off, 12);
        long v = 0;
        for (int i = 0; i < 12; i = i + 1) {
            int c = s[i] & 255;
            if (c >= 48 && c <= 55) {
                v = (v << 3) | (long)(c - 48);
            }
        }
        return v;
    }

    // 流式解包 tar 到目录（64 KiB 分块，支持 ustar prefix 与 GNU 'L' 长名）；损坏或越界返回 -1。
    public static int ExtractFile(string tarPath, string destDir) {
        nint fp = PlatFopen(tarPath, "rb");
        if (fp == 0) { return -1; }
        string root = destDir;
        if (!root.EndsWith("/") && !root.EndsWith("\\")) { root = root + "/"; }
        Directory.CreateDirectoryRecursive(root);

        byte[] hdr = new byte[512];
        byte[] buf = new byte[65536];
        string longName = "";
        int count = 0;
        int failed = 0;
        bool more = true;
        try {
            while (more) {
                long got = PlatFread(hdr, 1, 512, fp);
                if (got <= 0) {
                    more = false;
                } else if (got < 512) {
                    failed = 1; more = false;
                } else if (Tar.IsZeroBlock(hdr, 0)) {
                    more = false;
                } else if (Tar.ParseOctal(hdr, 148, 8) != Tar.HeaderSum(hdr, 0)) {
                    failed = 1; more = false;
                } else {
                    string name = Tar.ReadStr(hdr, 0, 100);
                    string prefix = Tar.ReadStr(hdr, 345, 155);
                    if (prefix.Length > 0) { name = prefix + "/" + name; }
                    if (longName.Length > 0) { name = longName; longName = ""; }
                    long size = Tar.ParseSize(hdr, 124);
                    int mode = Tar.ParseOctal(hdr, 100, 8);
                    int type = hdr[156] & 255;
                    long pad = ((size + 511) / 512) * 512 - size;

                    if (size < 0) {
                        failed = 1; more = false;
                    } else if (type == 76) {
                        longName = Tar.ReadName(fp, buf, size);
                        if (longName == null) { failed = 1; more = false; }
                        else if (!Tar.SkipBytes(fp, buf, pad)) { failed = 1; more = false; }
                    } else if (!Tar.SafeName(name)) {
                        failed = 1; more = false;
                    } else if (type == 53 || name.EndsWith("/")) {
                        Directory.CreateDirectoryRecursive(root + name);
                        count = count + 1;
                        if (!Tar.SkipBytes(fp, buf, size + pad)) { failed = 1; more = false; }
                    } else if (type == 0 || type == 48) {
                        string outPath = root + name;
                        int slash = Tar.LastSlash(outPath);
                        if (slash > 0) {
                            Directory.CreateDirectoryRecursive(outPath.Substring(0, slash));
                        }
                        if (!Tar.WriteMember(fp, buf, outPath, size)) {
                            failed = 1; more = false;
                        } else {
                            count = count + 1;
                            if ((mode & 73) != 0) { File.SetExecutable(outPath, true); }
                            if (!Tar.SkipBytes(fp, buf, pad)) { failed = 1; more = false; }
                        }
                    } else {
                        if (!Tar.SkipBytes(fp, buf, size + pad)) { failed = 1; more = false; }
                    }
                }
            }
        } finally {
            PlatFclose(fp);
        }
        if (failed != 0) { return -1; }
        return count;
    }

    // 路径防逃逸检查：须为相对路径、无盘符/冒号、无 NUL、无 ".." 段。
    public static bool SafeName(string name) {
        if (name == null || name.Length == 0) { return false; }
        int c0 = name[0] & 255;
        if (c0 == 47 || c0 == 92) { return false; }
        int n = name.Length;
        int seg = 0;
        for (int i = 0; i <= n; i = i + 1) {
            int c = i < n ? (name[i] & 255) : 47;
            if (c == 0 || c == 58) { return false; }
            if (c == 47 || c == 92) {
                if (i - seg == 2 && (name[seg] & 255) == 46 && (name[seg+1] & 255) == 46) {
                    return false;
                }
                seg = i + 1;
            }
        }
        return true;
    }

    // 路径中最后一个 '/' 或 '\' 的下标；没有时为 -1。
    public static int LastSlash(string path) {
        int last = -1;
        for (int i = 0; i < path.Length; i = i + 1) {
            int c = path[i] & 255;
            if (c == 47 || c == 92) { last = i; }
        }
        return last;
    }

    // 把条目数据（size 字节）按 64 KiB 分块写到 outPath；
    // 打不开目标文件或读写出错返回 false（目标文件可能已截断）。
    private static bool WriteMember(nint fp, byte[] buf, string outPath, long size) {
        nint ofp = PlatFopen(outPath, "wb");
        if (ofp == 0) { return false; }
        long left = size;
        bool ok = true;
        try {
            while (ok && left > 0) {
                long want = left > 65536 ? 65536 : left;
                long got = PlatFread(buf, 1, want, fp);
                if (got <= 0) { ok = false; }
                else {
                    long put = PlatFwrite(buf, 1, got, ofp);
                    if (put != got) { ok = false; }
                    left = left - got;
                }
            }
        } finally {
            PlatFclose(ofp);
        }
        return ok;
    }

    // 读取 GNU 长名条目的数据（NUL 结尾的路径）；异常时返回 null。
    private static string ReadName(nint fp, byte[] buf, long size) {
        if (size <= 0 || size > 65536) { return null; }
        long got = PlatFread(buf, 1, size, fp);
        if (got != size) { return null; }
        return Tar.ReadStr(buf, 0, (int)size);
    }

    // 顺序读入并丢弃 count 字节（含 512 对齐填充）；读到文件尾返回 false。
    private static bool SkipBytes(nint fp, byte[] buf, long count) {
        long left = count;
        while (left > 0) {
            long want = left > 65536 ? 65536 : left;
            long got = PlatFread(buf, 1, want, fp);
            if (got <= 0) { return false; }
            left = left - got;
        }
        return true;
    }
}
