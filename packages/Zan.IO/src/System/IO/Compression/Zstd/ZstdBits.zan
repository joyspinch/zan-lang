using System;
using System.Numerics;

namespace System.IO.Compression;

// zstd 用到的两种位流读取器。
//
// **两种方向别搞混**：FSE 表描述（归一化计数）是**正向**读的——从字节流的
// 开头往后读，字节内低位先读；FSE 码流与 Huffman 码流是**反向**读的——从
// 字节流的末尾往前读，字节内高位先读。RFC 8878 §4.1 与 §4.2 分别描述了
// 这两种方向，搞混会得到"能解码但结果全错"的数据。
//
// 反向流还有一条容易踩的规矩：最后一个字节的**最高置位 bit 是结束标记**
// （end mark），它上面的 0 是填充位，两者都要跳过；所以最后一个字节真正
// 携带数据的是结束标记**下面**的那些位。
public class ZstdBits {
    // 返回 floor(log2(v))（v 必须 ≥ 1）。
    public static int HighBit(int v) {
        if (v <= 1) { return 0; }
        return 31 - BitOperations.LeadingZeroCount((uint)v);
    }

    // 把 v 的低 bits 位反转（bits ≤ 32）。
    public static int Reverse(int v, int bits) {
        int r = 0;
        for (int i = 0; i < bits; i = i + 1) {
            r = (r << 1) | (v & 1);
            v = v >> 1;
        }
        return r;
    }
}

// 反向位流读取器（FSE 码流 / Huffman 码流，64 位左对齐累加器）。
//
// 读序：从**最后一个字节**开始往前；每个字节内从 bit7 读到 bit0。
// **先读到的位是结果值的最高位**。
//
// 越界读取不抛异常：缺失的位按 0 处理（与参考实现一致——FSE 权重解码
// 正是靠"多出来的位当作 0"来判定解码结束），但会记下 Overrun 供调用方
// 检查"码流是否被读干净"。
public class ZstdBackBits {
    byte[] data;
    int start;
    int bytePos; // 下一个待载入的字节下标（从 end-2 递减至 start）
    int total;   // 可读的总位数
    int cur;     // 已读位数
    ulong bitBuf;
    int bitCount;
    bool bad;    // 区间非法（空区间，或末字节为 0——没有结束标记）

    // 建立读取器，区间为 data[start, end)。
    public ZstdBackBits(byte[] src, int start, int end) {
        this.data = src;
        this.start = start;
        this.bytePos = start - 1;
        this.total = 0;
        this.cur = 0;
        this.bitBuf = 0UL;
        this.bitCount = 0;
        this.bad = true;
        if (end > start && end <= src.Length && start >= 0) {
            int last = src[end - 1] & 255;
            if (last != 0) {
                int p = ZstdBits.HighBit(last);
                this.total = p + (end - start - 1) * 8;
                this.bad = false;
                this.bytePos = end - 2;
                if (p > 0) {
                    this.bitBuf = ((ulong)(last & ((1 << p) - 1))) << (64 - p);
                    this.bitCount = p;
                }
                this.Refill();
            }
        }
    }

    public void Refill() {
        byte[] d = this.data;
        int st = this.start;
        int bp = this.bytePos;
        int bc = this.bitCount;
        ulong bb = this.bitBuf;
        while (bc <= 32 && bp - 3 >= st) {
            ulong w = (((ulong)(d[bp] & 255)) << 24)
                | (((ulong)(d[bp - 1] & 255)) << 16)
                | (((ulong)(d[bp - 2] & 255)) << 8)
                | ((ulong)(d[bp - 3] & 255));
            bb = bb | (w << (32 - bc));
            bc = bc + 32;
            bp = bp - 4;
        }
        while (bc <= 56 && bp >= st) {
            bb = bb | (((ulong)(d[bp] & 255)) << (56 - bc));
            bc = bc + 8;
            bp = bp - 1;
        }
        this.bytePos = bp;
        this.bitCount = bc;
        this.bitBuf = bb;
    }

    // 区间非法（无法作为码流读取）。
    public bool Bad() {
        return this.bad;
    }

    // 剩余可读位数。
    public int Remaining() {
        return this.total - this.cur;
    }

    // 是否读过头（多读过的位按 0 处理）。
    public bool Overrun() {
        return this.cur > this.total;
    }

    // 窥视接下来的 n 位（不推进游标）。n ≤ 32。
    public int Peek(int n) {
        if (n <= 0) { return 0; }
        if (this.bitCount < n && this.bytePos >= this.start) {
            this.Refill();
        }
        return (int)(this.bitBuf >> (64 - n));
    }

    // 跳过 n 位。
    public void Skip(int n) {
        if (n <= 0) { return; }
        if (this.bitCount < n && this.bytePos >= this.start) {
            this.Refill();
        }
        this.cur = this.cur + n;
        if (n < this.bitCount) {
            this.bitBuf = this.bitBuf << n;
            this.bitCount = this.bitCount - n;
        } else {
            this.bitBuf = 0UL;
            this.bitCount = 0;
        }
    }

    // 读 n 位（先读到的位是最高位）。
    public int Read(int n) {
        if (n <= 0) { return 0; }
        if (this.bitCount < n && this.bytePos >= this.start) {
            this.Refill();
        }
        int v = (int)(this.bitBuf >> (64 - n));
        this.cur = this.cur + n;
        if (n < this.bitCount) {
            this.bitBuf = this.bitBuf << n;
            this.bitCount = this.bitCount - n;
        } else {
            this.bitBuf = 0UL;
            this.bitCount = 0;
        }
        return v;
    }
}

// 正向位流读取器（FSE 表描述，64 位右对齐累加器）。
//
// 读序：从区间开头往后；每个字节内**低位先读**；先读到的位是结果值的
// **最低位**。
public class ZstdFwdBits {
    byte[] data;
    int bytePos;
    int end;
    int bit;   // 已读的绝对位偏移
    ulong bitBuf;
    int bitCount;

    // 建立读取器，区间为 data[start, end)。
    public ZstdFwdBits(byte[] src, int start, int end) {
        this.data = src;
        this.bytePos = start;
        this.end = end;
        this.bit = 0;
        this.bitBuf = 0UL;
        this.bitCount = 0;
        this.Refill();
    }

    void Refill() {
        byte[] d = this.data;
        int e = this.end;
        int bp = this.bytePos;
        int bc = this.bitCount;
        ulong bb = this.bitBuf;
        while (bc <= 56 && bp < e) {
            if (bp >= 0) {
                bb = bb | (((ulong)(d[bp] & 255)) << bc);
            }
            bc = bc + 8;
            bp = bp + 1;
        }
        this.bytePos = bp;
        this.bitCount = bc;
        this.bitBuf = bb;
    }

    // 窥视接下来的 n 位（不推进游标）。n ≤ 24。
    public int Peek(int n) {
        if (n <= 0) { return 0; }
        if (this.bitCount < n && this.bytePos < this.end) {
            this.Refill();
        }
        return (int)(this.bitBuf & ((1UL << n) - 1UL));
    }

    // 跳过 n 位。
    public void Skip(int n) {
        if (n <= 0) { return; }
        if (this.bitCount < n && this.bytePos < this.end) {
            this.Refill();
        }
        this.bit = this.bit + n;
        if (n < this.bitCount) {
            this.bitBuf = this.bitBuf >> n;
            this.bitCount = this.bitCount - n;
        } else {
            this.bitBuf = 0UL;
            this.bitCount = 0;
        }
    }

    // 读 n 位（先读到的位是最低位）。
    public int Read(int n) {
        int v = this.Peek(n);
        this.Skip(n);
        return v;
    }

    // 已消耗的字节数（向上取整——最后一个字节里没用完的位算作已消耗）。
    public int BytesUsed() {
        return (this.bit + 7) / 8;
    }
}
