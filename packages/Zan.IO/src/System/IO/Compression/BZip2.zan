using System;
using System.IO;

namespace System.IO.Compression;

// 纯 Zan 实现的 bzip2 解压（.bz2 / .tar.bz2）—— 不依赖 libbz2 或任何
// 外部依赖，可在所有平台运行。
// 只实现解压：bzip2 归档在互操作场景里（CEF 运行时、Linux 源码包）
// 只需要读。压缩侧请用 <see cref="Deflate"/> / <see cref="GZip"/>。
// BZip2.DecompressFile("cef.tar.bz2", "cef.tar");   // 流式，内存恒定
// 每个块的 CRC 都会校验，因此损坏的归档会被拒绝（返回 null /
// false）而不是产出垃圾数据。
public class BZip2 {
    // 解压内存中的 .bz2 数据；损坏或不支持时返回 null。
    public static byte[] Decompress(byte[] data) {
        BZip2Decoder d = new BZip2Decoder();
        return d.RunMemory(data);
    }

    // 把 `srcPath`（.bz2）流式解压到 `dstPath`；
    // 内存占用与文件大小无关。成功返回 true。
    public static bool DecompressFile(string srcPath, string dstPath) {
        BZip2Decoder d = new BZip2Decoder();
        return d.RunFile(srcPath, dstPath);
    }
}

