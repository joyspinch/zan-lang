namespace System.IO;

// 指定操作系统打开文件的方式（完全对齐 C# .NET 的 FileMode）。
enum FileMode {
    // 指定操作系统应创建新文件。如果文件已存在，将引发异常。
    CreateNew = 1,
    // 指定操作系统应创建新文件。如果文件已存在，将被截断并覆盖。
    Create = 2,
    // 指定操作系统应打开现有文件。如果文件不存在，将引发 FileNotFoundException。
    Open = 3,
    // 指定操作系统应打开文件（如果存在）；否则，应创建新文件。
    OpenOrCreate = 4,
    // 指定操作系统应打开现有文件。文件一旦打开就被截断为零字节。
    Truncate = 5,
    // 若文件存在则打开并在末尾追加，或创建新文件。
    Append = 6,
}
