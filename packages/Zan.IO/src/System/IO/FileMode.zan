namespace System.IO;

/// <summary>
/// 指定操作系统打开文件的方式（完全对齐 C# .NET 的 FileMode）。
/// </summary>
enum FileMode {
    /// <summary>指定操作系统应创建新文件。如果文件已存在，将引发异常。</summary>
    CreateNew = 1,
    /// <summary>指定操作系统应创建新文件。如果文件已存在，将被截断并覆盖。</summary>
    Create = 2,
    /// <summary>指定操作系统应打开现有文件。如果文件不存在，将引发 FileNotFoundException。</summary>
    Open = 3,
    /// <summary>指定操作系统应打开文件（如果存在）；否则，应创建新文件。</summary>
    OpenOrCreate = 4,
    /// <summary>指定操作系统应打开现有文件。文件一旦打开就被截断为零字节。</summary>
    Truncate = 5,
    /// <summary>若文件存在则打开并在末尾追加，或创建新文件。</summary>
    Append = 6,
}
