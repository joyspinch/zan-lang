using System;
using System.IO;

namespace System.IO;

// INI 文件读写器。节为 <c>[Name]</c>，条目为
// <c>key=value</c>，<c>;</c> 和 <c>#</c> 开头为注释，空行
// 被忽略。键和值会去除首尾空白；值中可包含 <c>=</c>。
// 可从文本（内存中）或文件解析，也可保存回两者。
public class IniFile {
    public List<IniSection> sections = new List<IniSection>();

    public IniFile() {}

    private static bool IsTrimWs(int c) {
        return c == 32 || (c >= 9 && c <= 13);
    }

    // 将给定文本解析为内存中的 INI（零 SplitLines / 零逐行临时串，memchr 按行直扫）。
    public static IniFile Parse(string text) {
        IniFile ini = new IniFile();
        if (text == null || text.Length == 0) { return ini; }
        IniSection cur = null;
        int len = text.Length;
        nint tPtr = (nint)text;
        Span<byte> tbuf = new Span<byte>(tPtr, len);
        int pos = 0;
        // 剥离可选 UTF-8 BOM (EF BB BF)，防止首节名或键名被污染。
        if (len >= 3 && (tbuf[0] & 255) == 0xEF && (tbuf[1] & 255) == 0xBB && (tbuf[2] & 255) == 0xBF) {
            pos = 3;
        }
        while (pos < len) {
            int nl = NativeMemory.Find(tPtr, pos, 10, len - pos);
            int lineEnd = nl < 0 ? len : nl;
            int s = pos;
            int e = lineEnd;
            pos = nl < 0 ? len : nl + 1;
            while (s < e && IniFile.IsTrimWs(tbuf[s] & 255)) { s = s + 1; }
            while (e > s && IniFile.IsTrimWs(tbuf[e - 1] & 255)) { e = e - 1; }
            if (s >= e) { continue; }
            int head = tbuf[s] & 255;
            if (head == 59 || head == 35) {
                // 注释 (';' or '#')
            } else if (head == 91) {  // '['
                int close = NativeMemory.Find(tPtr, s + 1, 93, e - (s + 1));
                if (close > s + 1) {
                    int ns = s + 1;
                    int ne = close;
                    while (ns < ne && IniFile.IsTrimWs(tbuf[ns] & 255)) { ns = ns + 1; }
                    while (ne > ns && IniFile.IsTrimWs(tbuf[ne - 1] & 255)) { ne = ne - 1; }
                    cur = new IniSection();
                    cur.name = ns < ne ? NativeMemory.GetString(tPtr, ns, ne - ns) : "";
                    ini.sections.Add(cur);
                }
            } else {
                int eq = NativeMemory.Find(tPtr, s, 61, e - s);
                if (eq > s) {
                    int ks = s;
                    int ke = eq;
                    while (ke > ks && IniFile.IsTrimWs(tbuf[ke - 1] & 255)) { ke = ke - 1; }
                    int vs = eq + 1;
                    int ve = e;
                    while (vs < ve && IniFile.IsTrimWs(tbuf[vs] & 255)) { vs = vs + 1; }
                    IniEntry entry = new IniEntry();
                    entry.key = ks < ke ? NativeMemory.GetString(tPtr, ks, ke - ks) : "";
                    entry.text = vs < ve ? NativeMemory.GetString(tPtr, vs, ve - vs) : "";
                    if (cur == null) {
                        cur = new IniSection();
                        cur.name = "";
                        ini.sections.Add(cur);
                    }
                    cur.entries.Add(entry);
                }
            }
        }
        return ini;
    }

    // 读取并解析 `path` 处的文件。文件不存在时返回
    // 空的 INI。
    public static IniFile Load(string path) {
        if (!File.Exists(path)) { return new IniFile(); }
        return IniFile.Parse(File.ReadAllText(path));
    }

    // 在节中查找键。节或键不存在时返回
    // `fallback`。
    public string GetString(string section, string key, string fallback) {
        IniEntry e = this.Find(section, key);
        if (e == null) { return fallback; }
        return e.text;
    }

    // 数值查找；缺失或非合法 32 位有符号十进制整数时返回 `fallback`。
    public int GetInt(string section, string key, int fallback) {
        IniEntry e = this.Find(section, key);
        if (e == null) { return fallback; }
        int v = 0;
        if (!IniFile.TryParseInt(e.text, out v)) { return fallback; }
        return v;
    }

    // 设置字符串值，必要时创建节/键。
    // 新节追加在末尾；新键追加在所属
    // 节内。已有键保持原有位置。
    public void SetString(string section, string key, string val) {
        IniSection sec = this.EnsureSection(section);
        for (int i = 0; i < sec.entries.Count; i = i + 1) {
            if (sec.entries[i].key == key) {
                sec.entries[i].text = val;
                return;
            }
        }
        IniEntry e = new IniEntry();
        e.key = key;
        e.text = val;
        sec.entries.Add(e);
    }

    // 设置整数值（以十进制文本存储）。
    public void SetInt(string section, string key, int val) {
        this.SetString(section, key, Convert.ToString(val));
    }

    // 删除键。键存在时返回 true。
    public bool RemoveKey(string section, string key) {
        IniSection sec = this.FindSection(section);
        if (sec == null) { return false; }
        for (int i = 0; i < sec.entries.Count; i = i + 1) {
            if (sec.entries[i].key == key) {
                sec.entries.RemoveAt(i);
                return true;
            }
        }
        return false;
    }

    // 删除整个节（含其所有键）。节存在时返回 true。
    public bool RemoveSection(string section) {
        for (int i = 0; i < this.sections.Count; i = i + 1) {
            if (this.sections[i].name == section) {
                this.sections.RemoveAt(i);
                return true;
            }
        }
        return false;
    }

    // 所有节的名称（按文件顺序）。
    public List<string> EnumSections() {
        List<string> names = new List<string>();
        for (int i = 0; i < this.sections.Count; i = i + 1) {
            names.Add(this.sections[i].name);
        }
        return names;
    }

    // 节的键列表（按文件顺序）；节不存在时为空。
    public List<string> EnumKeys(string section) {
        List<string> keys = new List<string>();
        IniSection sec = this.FindSection(section);
        if (sec == null) { return keys; }
        for (int i = 0; i < sec.entries.Count; i = i + 1) {
            keys.Add(sec.entries[i].key);
        }
        return keys;
    }

    // 剥离节名/键/值中的换行与空字节，防止序列化时注入伪造节或条目。
    private static string SanitizeLineField(string s, bool stripBrackets) {
        if (s == null || s.Length == 0) { return ""; }
        bool dirty = false;
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (c == 0 || c == 10 || c == 13 || (stripBrackets && (c == 91 || c == 93))) {
                dirty = true;
                break;
            }
        }
        if (!dirty) { return s; }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (c == 0 || c == 10 || c == 13 || (stripBrackets && (c == 91 || c == 93))) {
                continue;
            }
            sb.Append((char)c);
        }
        return sb.ToString();
    }

    // 将 INI 序列化为文本。
    public string ToText() {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < this.sections.Count; i = i + 1) {
            IniSection sec = this.sections[i];
            if (sec.name != null && sec.name != "") {
                sb.Append("[");
                sb.Append(IniFile.SanitizeLineField(sec.name, true));
                sb.Append("]\n");
            }
            for (int k = 0; k < sec.entries.Count; k = k + 1) {
                IniEntry entry = sec.entries[k];
                sb.Append(IniFile.SanitizeLineField(entry.key, false));
                sb.Append("=");
                sb.Append(IniFile.SanitizeLineField(entry.text, false));
                sb.Append("\n");
            }
        }
        return sb.ToString();
    }

    // 将 INI 写回 `path`。
    public void Save(string path) {
        File.WriteAllText(path, this.ToText());
    }

    // 查找节中的键；节或键不存在时返回 null。
    private IniEntry Find(string section, string key) {
        IniSection sec = this.FindSection(section);
        if (sec == null) { return null; }
        for (int i = 0; i < sec.entries.Count; i = i + 1) {
            if (sec.entries[i].key == key) { return sec.entries[i]; }
        }
        return null;
    }

    // 只查找不创建：节不存在时返回 null。
    private IniSection FindSection(string name) {
        for (int i = 0; i < this.sections.Count; i = i + 1) {
            if (this.sections[i].name == name) { return this.sections[i]; }
        }
        return null;
    }

    // 返回节，不存在时创建（追加到末尾）。
    private IniSection EnsureSection(string name) {
        IniSection existing = this.FindSection(name);
        if (existing != null) { return existing; }
        IniSection sec = new IniSection();
        sec.name = name;
        this.sections.Add(sec);
        return sec;
    }

    // 按 \n 拆行并去掉行尾 \r；末尾无换行符的行也计入。
    private static List<string> SplitLines(string text) {
        List<string> lines = new List<string>();
        if (text == null || text.Length == 0) { return lines; }
        int len = text.Length;
        int start = 0;
        for (int i = 0; i < len; i = i + 1) {
            int c = text[i] & 255;
            if (c == 10) {  // '\n'
                int end = i;
                if (end > start && (text[end - 1] & 255) == 13) {
                    end = end - 1;
                }
                lines.Add(text.Substring(start, end - start));
                start = i + 1;
            }
        }
        if (start < len) {
            int end = len;
            if (end > start && (text[end - 1] & 255) == 13) {
                end = end - 1;
            }
            lines.Add(text.Substring(start, end - start));
        }
        return lines;
    }

    // 解析 32 位有符号十进制整数（支持正负号与溢出拦截）。
    private static bool TryParseInt(string s, out int result) {
        result = 0;
        if (s == null || s.Length == 0) { return false; }
        int i = 0;
        bool neg = false;
        int c0 = s[0] & 255;
        if (c0 == 45) { neg = true; i = 1; }
        else if (c0 == 43) { i = 1; }
        if (i >= s.Length) { return false; }
        long acc = 0L;
        long limit = neg ? 2147483648L : 2147483647L;
        for (; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (c < 0x30 || c > 0x39) { return false; }
            acc = acc * 10L + (long)(c - 0x30);
            if (acc > limit) { return false; }
        }
        result = neg ? (int)(0L - acc) : (int)acc;
        return true;
    }
}

