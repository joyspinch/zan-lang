using System;

namespace System.IO;

// 基于 <see cref="Stream"/> 的缓冲文本写入：可向文件追加行，
// 而不必像 File.AppendAllText 那样重写整个文件（这正是它目前的代价）。
// 核心契约与语义定义。
// w.WriteLine("started");
// w.Close();
// 写入内容先在内存中累积，当缓冲区填满、
// 调用 <see cref="Flush"/> 或 <see cref="Close"/> 时才真正写入流——因此必须
// 关闭（或刷新）writer 后输出才会真正存在。若本 writer 打开了底层
// 流，则 Close 会将其一并关闭。
class StreamWriter : IDisposable {
    Stream stream;
    bool owns;
    StringBuilder buf;
    int buffered;
    int limit;
    string newline;

    StreamWriter() {
        this.stream = null;
        this.owns = false;
        this.buf = new StringBuilder();
        this.buffered = 0;
        this.limit = 8192;
        this.newline = "\n";
    }

    // 写入现有流（不由本 writer 关闭）。
    static StreamWriter Wrap(Stream s) {
        StreamWriter w = new StreamWriter();
        w.stream = s;
        return w;
    }

    // 创建或截断文件用于写入。
    StreamWriter(string path) : this() {
        this.stream = FileStream.Open(path, "w+b");
        this.owns = true;
    }

    // 打开文件用于追加，不存在则创建。
    static StreamWriter Append(string path) {
        StreamWriter w = new StreamWriter();
        w.stream = FileStream.Append(path);
        w.owns = true;
        return w;
    }

    // 正在写入的流。
    Stream BaseStream() { return this.stream; }

    // 设置 WriteLine 追加的行终止符（默认
    // 为 "\n"）。
    StreamWriter SetNewLine(string nl) {
        this.newline = nl;
        return this;
    }

    // 追加文本。
    StreamWriter Write(string text) {
        if (text.Length > 0) {
            this.buf.Append(text);
            this.buffered = this.buffered + text.Length;
            if (this.buffered >= this.limit) {
                this.Flush();
            }
        }
        return this;
    }

    // 追加文本，并附带行终止符。
    StreamWriter WriteLine(string text) {
        return this.Write(text + this.newline);
    }

    // 仅追加一个行终止符。
    StreamWriter WriteEmptyLine() {
        return this.Write(this.newline);
    }

    // 将所有缓冲内容交给流。
    void Flush() {
        if (this.buffered > 0 && this.stream != null) {
            string data = this.buf.ToString();
            this.stream.Write(data);
            this.stream.Flush();
            this.buf = new StringBuilder();
            this.buffered = 0;
        } else if (this.stream != null) {
            this.stream.Flush();
        }
    }

    // 刷新后，若本 writer 打开了底层
    // 流，则关闭该流。
    void Close() {
        this.Flush();
        if (this.owns && this.stream != null) {
            this.stream.Close();
        }
        this.stream = null;
    }

    // 释放 writer 占用的资源（实现 IDisposable，等同于 Close）。
    void Dispose() {
        this.Close();
    }
}
