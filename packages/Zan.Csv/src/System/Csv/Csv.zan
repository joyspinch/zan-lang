using System;

namespace System.Csv;

/// <summary>
/// RFC 4180 CSV 解析与写出（原先分散在 System.Text / System.Data 的
/// 两份实现合并于此，API 取两者并集）。
/// 解析按字节进行（Zan 字符串即 UTF-8 字节），多字节字符原样保留：
/// - 字段分隔符默认逗号（ParseSep 可指定，如 TSV 用制表符）；
/// 记录分隔符为 CRLF、LF 或 CR；
/// - 引号字段（以 '"' 起始）可包含分隔符与换行，'"' 转义为两个 '"'；
/// 字段中途出现的引号（ab"cd）按字面字符收下（宽松解析）；
/// - 输入开头的 UTF-8 BOM（EF BB BF）被剥除；
/// - 末尾的记录分隔符不产生空记录；文本结束后无换行的最后一条
/// 记录正常收尾；
/// - 字段两侧的空白按规范属于字段本身，不做裁剪。
/// 写出与解析严格互逆：含分隔符、引号或换行的字段加引号，
/// 字段内引号翻倍；Serialize 每条记录以 '\n' 结尾。
/// 安全提示（CSV 公式注入）：Parse/写出均不做任何中和——以 = + - @ 起头
/// 的字段原样保留（已拍板：写出侧保持数据原样，不前置撇号、不改字节），
/// 是数据还是公式、落表前是否中和，属于调用方的 API 决策。把含不可信
/// 数据的 CSV 直接导入 Excel/WPS/LibreOffice 时，这些单元格会被当
/// 公式执行（历史上有 =CMD|'/C calc'!A0 一类 DDE 攻击）。不可信数据
/// 勿直接进电子表格：落表前先审计/转义这些前缀，或导出为带前导
/// 撇号等中性形式。
/// CsvTable t = Csv.Parse(File.ReadAllText("data.csv"));
/// CsvTable tsv = Csv.ParseSep(text, "\t");
/// List<string> cells = Csv.ParseRow("1,\"a,b\",3");
/// string line = Csv.RowToText(fields);
/// string all = Csv.Serialize(rows);
/// </summary>
class Csv {
    /// 单条记录的字段数上限：超出抛 ArgumentException（防畸形/恶意
    /// 输入按字节膨胀撑爆内存）。公开可调——确有超宽记录的场景在
    /// 解析前调大。
    public static int MaxFieldsPerRecord = 1000000;

    /// 一次解析的总记录数上限（表头不计）：超出抛 ArgumentException。
    /// 对齐 d4139b46 反序列化侧的 100 万量级防线。公开可调。
    public static int MaxRecords = 1000000;

    /// 记录收口：字段数/总记录数超上限抛 ArgumentException，然后
    /// 首记录归表头、其余归 rows。
    static void FinishRecord(CsvTable t, List<string> rec) {
        if (rec.Count > Csv.MaxFieldsPerRecord) {
            throw new ArgumentException("CSV record has too many fields ("
                + Convert.ToString(rec.Count) + " > "
                + Convert.ToString(Csv.MaxFieldsPerRecord) + ")");
        }
        if (t.header.Count == 0 && t.rows.Count == 0) {
            t.header = rec;  // 首记录即表头
            return;
        }
        if (t.rows.Count >= Csv.MaxRecords) {
            throw new ArgumentException("CSV input has too many records ("
                + Convert.ToString(t.rows.Count + 1) + " > "
                + Convert.ToString(Csv.MaxRecords) + ")");
        }
        t.rows.Add(rec);
    }

    /// <summary>解析整段 CSV 文本为表：调用方约定首记录为表头
    /// （本层不做该假设）。空文本返回零行表。</summary>
    static CsvTable Parse(string text) {
        return Csv.ParseSep(text, ",");
    }

    /// <summary>使用自定义分隔符（单个字符）解析；分隔符为空或
    /// 是引号/换行这类会破坏语法的字符时回退为逗号。</summary>
    static CsvTable ParseSep(string text, string separator) {
        CsvTable t = new CsvTable();
        if (text == null) { return t; }
        int sep = 44;
        if (separator != null && separator.Length > 0) {
            sep = separator[0] & 255;
            if (sep == 34 || sep == 13 || sep == 10) { sep = 44; }
        }
        int n = text.Length;
        int i = 0;
        if (n >= 3 && (text[0] & 255) == 239 && (text[1] & 255) == 187
            && (text[2] & 255) == 191) {
            i = 3;  // UTF-8 BOM
        }
        List<string> rec = new List<string>();
        StringBuilder sb = new StringBuilder();
        bool dirty = false;  // 当前记录已有内容
        while (i < n) {
            int c = text[i] & 255;
            if (c == 34) {  // '"'
                if (sb.Length == 0) {
                    // 字段起始的引号：进入引号模式直到配对的闭引号。
                    dirty = true;
                    i = i + 1;
                    while (i < n) {
                        int q = text[i] & 255;
                        if (q == 34) {
                            if (i + 1 < n && (text[i + 1] & 255) == 34) {
                                sb.Append("\"");
                                i = i + 2;
                            } else {
                                i = i + 1;
                                break;
                            }
                        } else {
                            int start = i;
                            while (i < n && (text[i] & 255) != 34) {
                                i = i + 1;
                            }
                            sb.Append(text.Substring(start, i - start));
                        }
                    }
                } else {
                    // 字段中途的引号（ab"cd）：按规范外字符原样收下。
                    sb.Append("\"");
                    i = i + 1;
                    dirty = true;
                }
                continue;
            }
            if (c == sep) {  // 字段结束
                rec.Add(sb.ToString());
                sb.Clear();
                dirty = true;
                i = i + 1;
                continue;
            }
            if (c == 13 || c == 10) {  // CR/LF 记录结束
                if (c == 13 && i + 1 < n && (text[i + 1] & 255) == 10) {
                    i = i + 2;
                } else {
                    i = i + 1;
                }
                rec.Add(sb.ToString());
                sb.Clear();
                Csv.FinishRecord(t, rec);
                rec = new List<string>();
                dirty = false;
                continue;
            }
            int begin = i;
            while (i < n) {
                int d = text[i] & 255;
                if (d == sep || d == 13 || d == 10 || d == 34) { break; }
                i = i + 1;
            }
            sb.Append(text.Substring(begin, i - begin));
            dirty = true;
        }
        if (dirty) {
            rec.Add(sb.ToString());
            Csv.FinishRecord(t, rec);  // 无换行收尾的单记录文本
        }
        return t;
    }

    /// <summary>解析单行记录（无引号内换行的场景，如命令行工具的
    /// CSV 输出）。单记录文本没有表头概念，首记录按数据返回；
    /// 空行或 null 返回空列表。</summary>
    static List<string> ParseRow(string line) {
        if (line == null) { return new List<string>(); }
        CsvTable t = Csv.Parse(line);
        if (t.rows.Count > 0) { return t.rows[0]; }
        if (t.header.Count > 0) { return t.header; }
        return new List<string>();
    }

    /// <summary>写出单个字段：含逗号、引号或换行时加引号，
    /// 字段内引号翻倍；其余原样返回。null 视为空字段。</summary>
    static string Escape(string field) {
        return Csv.EscapeSep(field, ",");
    }

    /// <summary>同 Escape，但针对自定义分隔符判断是否需要加引号
    /// （多字符分隔符用子串匹配）。</summary>
    static string EscapeSep(string field, string separator) {
        if (field == null) { return ""; }
        int flen = field.Length;
        int sepChar = (separator != null && separator.Length == 1) ? (separator[0] & 255) : -1;
        bool needQuote = false;
        if (sepChar >= 0) {
            for (int i = 0; i < flen; i = i + 1) {
                int c = field[i] & 255;
                if (c == sepChar || c == 34 || c == 10 || c == 13) {
                    needQuote = true;
                    break;
                }
            }
        } else {
            if (separator != null && field.IndexOf(separator, 0) >= 0) { needQuote = true; }
            else if (field.IndexOf("\"", 0) >= 0 || field.IndexOf("\n", 0) >= 0 || field.IndexOf("\r", 0) >= 0) { needQuote = true; }
        }
        if (!needQuote) { return field; }
        StringBuilder sb = new StringBuilder();
        sb.Append("\"");
        int last = 0;
        for (int i = 0; i < flen; i = i + 1) {
            if ((field[i] & 255) == 34) {
                if (i > last) { sb.Append(field.Substring(last, i - last)); }
                sb.Append("\"\"");
                last = i + 1;
            }
        }
        if (last < flen) { sb.Append(field.Substring(last, flen - last)); }
        sb.Append("\"");
        return sb.ToString();
    }

    /// <summary>把一条记录写为一行（逗号分隔，不含行尾换行符）。</summary>
    static string RowToText(List<string> fields) {
        return Csv.RowToTextSep(fields, ",");
    }

    /// <summary>把一条记录写为一行（自定义分隔符，不含行尾换行符）。</summary>
    static string RowToTextSep(List<string> fields, string separator) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < fields.Count; i = i + 1) {
            if (i > 0) { sb.Append(separator); }
            sb.Append(Csv.EscapeSep(fields[i], separator));
        }
        return sb.ToString();
    }

    /// <summary>把行列表序列化为 CSV 文本（逗号分隔），每条记录
    /// 以 '\n' 结尾。</summary>
    static string Serialize(List<List<string>> rows) {
        return Csv.SerializeSep(rows, ",");
    }

    /// <summary>把行列表序列化为 CSV 文本（自定义分隔符），每条
    /// 记录以 '\n' 结尾。</summary>
    static string SerializeSep(List<List<string>> rows, string separator) {
        StringBuilder sb = new StringBuilder();
        for (int r = 0; r < rows.Count; r = r + 1) {
            sb.Append(Csv.RowToTextSep(rows[r], separator));
            sb.Append("\n");
        }
        return sb.ToString();
    }
}

/// <summary>一次 CSV 解析的结果：调用方约定 header 为首记录，
/// rows 为其后各记录（本层不做该假设，两者都是普通记录）。</summary>
class CsvTable {
    /// 首记录（约定为表头）。
    List<string> header;
    /// 其余各记录；每条记录的字段数可能与表头不一致（宽松解析）。
    List<List<string>> rows;

    CsvTable() {
        this.header = new List<string>();
        this.rows = new List<List<string>>();
    }

    /// 表头记录（未解析出任何记录时为空列表）。
    List<string> Header() { return this.header; }

    /// 数据记录列表。
    List<List<string>> Rows() { return this.rows; }

    /// 数据行数（不含表头）。
    int RowCount() { return this.rows.Count; }

    /// <summary>按表头名取整列；名字不存在时返回 null。
    /// 只在行数一致的规整表上有列语义。</summary>
    List<string> Column(string name) {
        int at = -1;
        for (int i = 0; i < this.header.Count; i = i + 1) {
            if (this.header[i] == name) { at = i; break; }
        }
        if (at < 0) { return null; }
        List<string> col = new List<string>();
        for (int r = 0; r < this.rows.Count; r = r + 1) {
            List<string> row = this.rows[r];
            if (at < row.Count) { col.Add(row[at]); }
            else { col.Add(""); }
        }
        return col;
    }
}
