using System;

namespace System.Csv;

public class CsvTable {
    // 首记录（约定为表头）。
    public List<string> header;
    // 其余各记录；每条记录的字段数可能与表头不一致（宽松解析）。
    public List<List<string>> rows;

    public CsvTable() {
        this.header = new List<string>();
        this.rows = new List<List<string>>();
    }

    // 表头记录（未解析出任何记录时为空列表）。
    public List<string> Header() { return this.header; }

    // 数据记录列表。
    public List<List<string>> Rows() { return this.rows; }

    // 数据行数（不含表头）。
    public int RowCount() { return this.rows.Count; }

    // 按表头名取整列；名字不存在时返回 null。
    // 只在行数一致的规整表上有列语义。
    public List<string> Column(string name) {
        int at = -1;
        for (int i = 0; i < this.header.Count; i = i + 1) {
            if (this.header[i] == name) { at = i; break; }
        }
        if (at < 0) { return null; }
        List<string> col = new List<string>();
        for (int r = 0; r < this.rows.Count; r = r + 1) {
            List<string> row = this.rows[r];
            if (at < row.Count) { col.Add(row[at]); }
            else { col.Add(""); }
        }
        return col;
    }
}
