using System;
using System.Collections.Generic;
using System.Test;
using System.Csv;

// Zan.Csv 包的无头测试：解析/序列化往返、引号转义、分隔符变体、边界形状。
class CsvRoundTripTests {
    static void Main() {
        Test.Group("parse");
        Test.Run("header-and-rows", () => {
            CsvTable t = Csv.Parse("name,age\nalice,30\nbob,25\n");
            Assert.Equal("name", t.Header()[0], "header0");
            Assert.Equal("age", t.Header()[1], "header1");
            Assert.Equal(2, t.RowCount(), "row-count");
            Assert.Equal("alice", t.Rows()[0][0], "row0-col0");
            Assert.Equal("30", t.Rows()[0][1], "row0-col1");
            Assert.Equal("25", t.Rows()[1][1], "row1-col1");
        });

        Test.Run("column-access", () => {
            CsvTable t = Csv.Parse("id,city\n1,北京\n2,上海\n");
            List<string> cities = t.Column("city");
            Assert.NotNull(cities, "col-nonnull");
            if (cities == null) { return; }
            Assert.Equal(2, cities.Count, "col-len");
            Assert.Equal("北京", cities[0], "col0");
            Assert.Equal("上海", cities[1], "col1");
        });

        Test.Run("empty-and-single-cell", () => {
            CsvTable t = Csv.Parse("a,b,c\n,,\n");
            Assert.Equal(1, t.RowCount(), "one-row");
            Assert.Equal("", t.Rows()[0][0], "empty-first");
            Assert.Equal(3, t.Rows()[0].Count, "three-cells");
        });

        Test.Group("quoting");
        Test.Run("quoted-comma-and-embedded-quotes", () => {
            List<string> row = Csv.ParseRow("\"a,b\",\"say \"\"hi\"\"\",3");
            Assert.Equal(3, row.Count, "field-count");
            Assert.Equal("a,b", row[0], "comma-kept");
            Assert.Equal("say \"hi\"", row[1], "quotes-kept");
            Assert.Equal("3", row[2], "plain");
        });

        Test.Run("escaped-roundtrip", () => {
            string field = "line1,line2 \"q\"";
            string esc = Csv.Escape(field);
            List<string> back = Csv.ParseRow(esc);
            Assert.Equal(1, back.Count, "one-field");
            Assert.Equal(field, back[0], "field-survives");
        });

        Test.Group("serialize");
        Test.Run("serialize-parse-roundtrip", () => {
            List<List<string>> rows = new List<List<string>>();
            List<string> r0 = new List<string>();
            r0.Add("h1");
            r0.Add("h2");
            List<string> r1 = new List<string>();
            r1.Add("v,1");
            r1.Add("v\"2\"");
            rows.Add(r0);
            rows.Add(r1);
            string text = Csv.Serialize(rows);
            CsvTable t = Csv.Parse(text);
            Assert.Equal("h1", t.Header()[0], "h1");
            Assert.Equal("v,1", t.Rows()[0][0], "v1");
            Assert.Equal("v\"2\"", t.Rows()[0][1], "v2");
        });

        Test.Group("separator");
        Test.Run("semicolon-variant", () => {
            CsvTable t = Csv.ParseSep("a;b\n1;2\n", ";");
            Assert.Equal("b", t.Header()[1], "header-b");
            Assert.Equal("2", t.Rows()[0][1], "row-cell");
        });

        Test.Run("escaped-sep-roundtrip", () => {
            // 首记录按表头收（Parse 的约定），单记录文本从 Header 取回。
            string esc = Csv.EscapeSep("x;y", ";");
            CsvTable t = Csv.ParseSep(esc + "\n", ";");
            Assert.Equal(0, t.RowCount(), "single-record-is-header");
            Assert.Equal("x;y", t.Header()[0], "sep-kept");
        });

        Test.Run("blank-line-is-empty-record", () => {
            // 语义钉住：空行是一个单空字段记录，不是被跳过。
            CsvTable t = Csv.Parse("a,b\n1,2\n\n3,4\n");
            Assert.Equal(3, t.RowCount(), "three-rows");
            Assert.Equal(1, t.Rows()[1].Count, "blank-one-cell");
        });

        Test.Run("row-to-text", () => {
            List<string> fields = new List<string>();
            fields.Add("p");
            fields.Add("q,r");
            string line = Csv.RowToText(fields);
            List<string> back = Csv.ParseRow(line);
            Assert.Equal(2, back.Count, "back-count");
            Assert.Equal("q,r", back[1], "back-field");
        });

        Test.Finish();
    }
}
