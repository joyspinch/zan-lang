using System;
using System.IO;
using System.Security.Cryptography;
namespace System.Resources;

// 一条已解析的 index 记录：条目名哈希、负载偏移
// 与大小，以及每条目 IV 和 GCM tag。用一个实体代替五个
// 按 index 对齐的并行列表。
public class PackIndexEntry {
    public byte[] hash;  // 名称的 16 字节截断 SHA-256
    public int off;  // 文件内的负载偏移
    public int size;  // 负载字节长度
    public byte[] iv;  // 每条目 AES-GCM IV
    public byte[] tag;  // 每条目 AES-GCM tag

    // 构造 index 记录。
    public PackIndexEntry(byte[] hash, int off, int size, byte[] iv, byte[] tag) {
        this.hash = hash;
        this.off = off;
        this.size = size;
        this.iv = iv;
        this.tag = tag;
    }
}
