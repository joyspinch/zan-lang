using System;
using System.IO;
using System.Security.Cryptography;
namespace System.Resources;

// 一个已入队的 pack 条目：名称、原始字节负载与
// 负载长度。用一个实体代替并行的 name/data/len 列表。
public class ResourceEntry {
    public string name;
    public string data;
    public int len;

    // 构造条目。
    public ResourceEntry(string name, string data, int len) {
        this.name = name;
        this.data = data;
        this.len = len;
    }
}
