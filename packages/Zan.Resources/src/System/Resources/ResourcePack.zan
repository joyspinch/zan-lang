using System;
using System.Collections.Generic;
using System.IO;
using System.Security.Cryptography;
namespace System.Resources;

// 加密资源包读取器。格式见 ResourcePackWriter。
// Open() 在提供条目前先校验 index 签名与真实性；
// Read() 会重新派生每条目密钥，并通过 GCM tag 拒绝
// 被篡改的负载。
public class ResourcePack {
    public string path;
    public string masterKey;
    public byte[] packId;
    public int count;
    public List<PackIndexEntry> index;
    private Dictionary<string, int> indexMap;

    // ---- 共享辅助（writer 同样使用）----

    // 写入 4 字节不透明 magic 与混淆后的版本字节（`1 ^ 165`）。
    public static void writeMagic(byte[] hdr) {
        // 不透明的非 ASCII magic + 混淆后的版本字节
        hdr[0] = 199; hdr[1] = 17; hdr[2] = 158; hdr[3] = 66;
        hdr[4] = (byte)(1 ^ 165);
    }

    // 校验头部 magic 与版本字节。
    public static bool checkMagic(string hdr) {
        if (hdr == null || hdr.Length < 5) { return false; }
        if ((hdr[0] & 255) != 199) { return false; }
        if ((hdr[1] & 255) != 17) { return false; }
        if ((hdr[2] & 255) != 158) { return false; }
        if ((hdr[3] & 255) != 66) { return false; }
        return ((hdr[4] & 255) ^ 165) == 1;
    }

    // 按大端序写入 32 位整数。
    public static void storeBE32(byte[] buf, int off, int v) {
        if (buf == null || off < 0 || off > buf.Length - 4) { return; }
        buf[off] = (byte)((v >> 24) & 255);
        buf[off + 1] = (byte)((v >> 16) & 255);
        buf[off + 2] = (byte)((v >> 8) & 255);
        buf[off + 3] = (byte)(v & 255);
    }

    // 按大端序读取 32 位整数。
    public static int loadBE32(string buf, int off) {
        if (buf == null || off < 0 || off > buf.Length - 4) { return 0; }
        return ((buf[off] & 255) << 24) | ((buf[off + 1] & 255) << 16)
             | ((buf[off + 2] & 255) << 8) | (buf[off + 3] & 255);
    }

    // 按大端序写入 64 位整数。
    public static void storeBE64(byte[] buf, int off, int v) {
        ResourcePack.StoreBE64Long(buf, off, (long)v);
    }

    // 按大端序写入 64 位长整数。
    public static void StoreBE64Long(byte[] buf, int off, long v) {
        if (buf == null || off < 0 || off > buf.Length - 8) { return; }
        for (int i = 0; i < 8; i = i + 1) { buf[off + i] = (byte)(Bits.Shr64(v, 8 * (7 - i)) & 255L); }
    }

    // 按大端序读取 8 字节为 64 位长整数。
    public static long LoadBE64Long(string buf, int off) {
        if (buf == null || off < 0 || off > buf.Length - 8) { return 0L; }
        long v = 0L;
        for (int i = 0; i < 8; i = i + 1) { v = (v << 8) | (long)(buf[off + i] & 255); }
        return v;
    }

    // 按大端序读取 8 字节为整数。
    public static int loadBE64(string buf, int off) {
        return (int)ResourcePack.LoadBE64Long(buf, off);
    }

    // 条目名的截断 SHA-256（16 字节）。pack 中只存
    // 这个哈希，因此无法从文件列出条目名。
    public static byte[] nameHash(string name) {
        if (name == null) { name = ""; }
        byte[] h = Sha256.Hash(name, name.Length);
        byte[] t = new byte[17];
        for (int i = 0; i < 16; i = i + 1) { t[i] = h[i]; }
        return t;
    }

    // index 加密密钥：HKDF(salt=packId, ikm=masterKey, info="ZRIX")，32 字节。
    public static byte[] indexKey(string masterKey, byte[] packId) {
        if (masterKey == null || masterKey.Length < 32 || packId == null || packId.Length < 16) { return null; }
        return Hkdf.Derive(packId, 16, masterKey, 32, "ZRIX", 4, 32);
    }

    // 条目密钥：HKDF(salt=packId, ikm=masterKey, info="ZREN"+名称哈希)，
    // 32 字节；每条目独立，单个条目密钥泄露不波及其他条目。
    public static byte[] entryKey(string masterKey, byte[] packId, byte[] nh) {
        if (masterKey == null || masterKey.Length < 32 || packId == null || packId.Length < 16 || nh == null || nh.Length < 16) { return null; }
        byte[] info = new byte[21];
        info[0] = 90; info[1] = 82; info[2] = 69; info[3] = 78;  // "ZREN"
        for (int i = 0; i < 16; i = i + 1) { info[4 + i] = nh[i]; }
        return Hkdf.Derive(packId, 16, masterKey, 32, info, 20, 32);
    }

    // 由两份 XOR 分片重组密钥，使真实密钥永不
    // 以单一字面量出现在二进制中。
    public static byte[] MixKey(string a, string b, int len) {
        if (a == null || b == null || len < 0 || a.Length < len || b.Length < len) { return null; }
        byte[] k = new byte[len + 1];
        for (int i = 0; i < len; i = i + 1) { k[i] = (byte)((a[i] & 255) ^ (b[i] & 255)); }
        return k;
    }

    // 打开 pack 并认证其 index。<paramref name="nHex"/>
    // 与 <paramref name="eHex"/> 是 RSA 公钥模数/指数（十六进制），
    // 用于校验 index 签名；两参数均传 null 则接受未签名的 pack。
    // <paramref name="err"/>[0]：0 正常，1 IO/magic 错误，2 认证失败，3 签名错误。
    public static ResourcePack Open(string path, string masterKey, string nHex, string eHex, List<int> err) {
        if (err == null || err.Count == 0) { return null; }
        err[0] = 1;
        if (path == null || masterKey == null || masterKey.Length < 32) { return null; }
        long fsz = File.GetSize64(path);
        if (fsz < 57L) { return null; }
        byte[] hdr = File.ReadBytes(path, 0, 57);
        if (hdr == null || hdr.Length < 57 || !checkMagic(hdr)) { return null; }
        int idxLen = loadBE32(hdr, 49);
        int sigLen = loadBE32(hdr, 53);
        long dataStartL = 57L + (long)idxLen + (long)sigLen;
        if (idxLen < 4 || sigLen < 0 || dataStartL > fsz) { return null; }

        byte[] packId = new byte[17];
        byte[] idxIv = new byte[13];
        byte[] idxTag = new byte[17];
        for (int i = 0; i < 16; i = i + 1) { packId[i] = hdr[5 + i]; }
        for (int i = 0; i < 12; i = i + 1) { idxIv[i] = hdr[21 + i]; }
        for (int i = 0; i < 16; i = i + 1) { idxTag[i] = hdr[33 + i]; }

        byte[] idxCt = File.ReadBytes(path, 57, idxLen);
        if (idxCt == null || idxCt.Length < idxLen) { return null; }
        byte[] ik = indexKey(masterKey, packId);
        if (ik == null) {
            err[0] = 2;
            return null;
        }
        List<int> ok = new List<int>(); ok.Add(0);
        byte[] idx = AesGcm.Decrypt(ik, 32, idxIv, hdr, 21, idxCt, idxLen, idxTag, ok);
        if (ok[0] == 0 || idx == null || idx.Length < idxLen) {
            err[0] = 2;
            return null;
        }

        if (nHex != null || eHex != null) {
            bool sigOk = false;
            if (nHex != null && eHex != null) {
                int k = nHex.Length / 2;
                int eLen = eHex.Length / 2;
                if (sigLen > 0 && k > 0 && eLen > 0 && sigLen == k
                    && (nHex.Length & 1) == 0 && (eHex.Length & 1) == 0) {
                    byte[] sig = File.ReadBytes(path, 57 + idxLen, sigLen);
                    if (sig != null && sig.Length >= sigLen) {
                        byte[] nBuf = Hex.Decode(nHex);
                        byte[] eBuf = Hex.Decode(eHex);
                        if (nBuf != null && eBuf != null && nBuf.Length >= k && eBuf.Length >= eLen) {
                            sigOk = Rsa.VerifyPkcs1Sha256(idx, idxLen, sig, nBuf, k, eBuf, eLen);
                        }
                    }
                }
            }
            if (!sigOk) {
                err[0] = 3;
                return null;
            }
        }

        int cnt = loadBE32(idx, 0);
        if (cnt < 0 || 4L + 61L * (long)cnt > (long)idxLen) {
            err[0] = 2;
            return null;
        }
        ResourcePack p = new ResourcePack();
        p.path = path;
        p.masterKey = masterKey;
        p.packId = packId;
        p.count = cnt;
        p.index = new List<PackIndexEntry>();
        p.indexMap = new Dictionary<string, int>();
        for (int i = 0; i < p.count; i = i + 1) {
            int rec = 4 + 61 * i;
            long offL = ResourcePack.LoadBE64Long(idx, rec + 16);
            long szL = ResourcePack.LoadBE64Long(idx, rec + 24);
            if (offL < dataStartL || szL < 0L || offL > 2147483647L || szL > 2147483647L || offL + szL > fsz) {
                err[0] = 2;
                return null;
            }
            int off = (int)offL;
            int sz = (int)szL;
            byte[] nh = new byte[17];
            byte[] iv = new byte[13];
            byte[] tg = new byte[17];
            for (int j = 0; j < 16; j = j + 1) { nh[j] = idx[rec + j]; }
            for (int j = 0; j < 12; j = j + 1) { iv[j] = idx[rec + 33 + j]; }
            for (int j = 0; j < 16; j = j + 1) { tg[j] = idx[rec + 45 + j]; }
            p.index.Add(new PackIndexEntry(nh, off, sz, iv, tg));
            string hk = Hex.Encode(nh, 16);
            if (!p.indexMap.ContainsKey(hk)) {
                p.indexMap.Add(hk, i);
            }
        }
        err[0] = 0;
        return p;
    }

    // 返回 pack 内条目数。
    public int Count() { return this.count; }

    // 按名称哈希 O(1) 查找条目下标（命中后再逐字节比对 16 字节哈希），未找到返回 -1。
    private int FindIndex(string name) {
        if (name == null) { return -1; }
        byte[] nh = nameHash(name);
        if (this.indexMap != null) {
            int idx;
            if (this.indexMap.TryGetValue(Hex.Encode(nh, 16), out idx)) {
                byte[] h = this.index[idx].hash;
                int diff = 0;
                for (int j = 0; j < 16; j = j + 1) { diff = diff | ((h[j] & 255) ^ (nh[j] & 255)); }
                if (diff == 0) { return idx; }
            }
            return -1;
        }
        for (int i = 0; i < this.count; i = i + 1) {
            byte[] h = this.index[i].hash;
            int diff = 0;
            for (int j = 0; j < 16; j = j + 1) { diff = diff | ((h[j] & 255) ^ (nh[j] & 255)); }
            if (diff == 0) { return i; }
        }
        return -1;
    }

    // 名称是否存在于 pack。
    public bool Contains(string name) { return this.FindIndex(name) >= 0; }

    // 返回条目负载的字节数；名称未知返回 -1。
    public int SizeOf(string name) {
        int i = this.FindIndex(name);
        if (i < 0) { return -1; }
        return this.index[i].size;
    }

    // 按需解密一个条目（只从磁盘读取该条目）。
    // 返回明文并设置 <paramref name="outLen"/>[0]；
    // 若名称未知或数据认证失败，
    // 则返回 null（outLen 为 -1）。
    public byte[] Read(string name, List<int> outLen) {
        if (outLen == null || outLen.Count == 0) { return null; }
        outLen[0] = -1;
        int i = this.FindIndex(name);
        if (i < 0) { return null; }
        PackIndexEntry e = this.index[i];
        int sz = e.size;
        byte[] ct = File.ReadBytes(this.path, e.off, sz);
        if (ct == null || ct.Length < sz) { return null; }
        byte[] ek = entryKey(this.masterKey, this.packId, e.hash);
        if (ek == null) { return null; }
        List<int> ok = new List<int>(); ok.Add(0);
        byte[] pt = AesGcm.Decrypt(ek, 32, e.iv, e.hash, 16, ct, sz, e.tag, ok);
        if (ok[0] == 0 || pt == null || pt.Length < sz) { return null; }
        outLen[0] = sz;
        return pt;
    }
}
