using System;
using System.IO;
using System.Security.Cryptography;
namespace System.Resources;

// 加密资源包（.zrp）写入器。
// 布局（私有格式，没有主密钥则完全不可读）：
// [0..3]   magic（4 个不透明字节，非 ASCII）
// [4]      version（混淆后的版本号）
// [5..20]  packId —— 16 个随机字节，每个 pack 唯一
// [21..32] index 的 IV（12 字节）
// [33..48] index 的 GCM tag（16 字节）
// [49..52] index 密文长度（BE32）
// [53..56] 签名长度（BE32，0 表示无签名）
// [...]    index 密文，然后是 RSA 签名，最后是各条目负载
// index（条目表）由主密钥与 packId 经 HKDF 派生的密钥做 AES-256-GCM 加密，
// 再签名（RSASSA-PKCS1-v1_5 / SHA-256），
// 因此即使攻击者拿到主密钥、却拿不到私钥，
// 重打包或调换条目的文件也会被拒绝。
// 条目名只存截断的 SHA-256 哈希；每个条目
// 用各自 HKDF 派生的密钥加密，因此一个条目密钥泄露
// 不会波及其他条目或主密钥。
class ResourcePackWriter {
    [DllImport("crt")] static extern nint fopen(string path, string mode);
    [DllImport("crt")] static extern long fwrite(string buf, long size, long count, nint fp);
    [DllImport("crt")] static extern int fclose(nint fp);

    List<ResourceEntry> entries;

    // 构造写入器（空 pack，条目经 Add 入队）。
    ResourcePackWriter() {
        this.entries = new List<ResourceEntry>();
    }

    // 入队一个条目。<paramref name="data"/> 是原始字节，
    // 长度显式传入（Zan 字符串就是字节缓冲区）。
    void Add(string name, string data, int len) {
        this.entries.Add(new ResourceEntry(name, data, len));
    }

    // 写入 pack。<paramref name="masterKey"/> 为 32 字节。
    // <paramref name="nHex"/>/<paramref name="dHex"/> 是 RSA 模数与
    // 私钥指数（十六进制），用于 index 签名；传 null 可跳过签名。
    // 成功返回 true。
    bool Write(string path, string masterKey, string nHex, string dHex) {
        int count = this.entries.Count;
        int sigLen = 0;
        byte[] nBuf = null;
        byte[] dBuf = null;
        if (nHex != null && dHex != null) {
            nBuf = Hex.Decode(nHex);
            dBuf = Hex.Decode(dHex);
            sigLen = nHex.Length / 2;
        }

        byte[] packId = RandomNumberGenerator.GetBytes(16);
        byte[] idxIv = RandomNumberGenerator.GetBytes(12);
        if (packId == null || idxIv == null) { return false; }

        int idxLen = 4 + 61 * count;
        int dataStart = 57 + idxLen + sigLen;

        // 在规划负载偏移的同时构建明文 index。
        byte[] idx = new byte[idxLen + 1];
        ResourcePack.storeBE32(idx, 0, count);
        List<byte[]> ivs = new List<byte[]>();
        int off = dataStart;
        int i = 0;
        for (; i < count; i = i + 1) {
            byte[] nh = ResourcePack.nameHash(this.entries[i].name);
            byte[] iv = RandomNumberGenerator.GetBytes(12);
            if (iv == null) { return false; }
            ivs.Add(iv);
            int rec = 4 + 61 * i;
            int j = 0;
            for (; j < 16; j = j + 1) { idx[rec + j] = nh[j]; }
            ResourcePack.storeBE64(idx, rec + 16, off);
            ResourcePack.storeBE64(idx, rec + 24, this.entries[i].len);
            idx[rec + 32] = 0;  // 标志位（bit0 保留给压缩）
            j = 0;
            while (j < 12) { idx[rec + 33 + j] = iv[j]; j = j + 1; }
            // tag 在下方加密后写入
            off = off + this.entries[i].len;
        }

        // 用各自派生的密钥加密每个负载。
        List<byte[]> cts = new List<byte[]>();
        i = 0;
        while (i < count) {
            byte[] nh = ResourcePack.nameHash(this.entries[i].name);
            byte[] ek = ResourcePack.entryKey(masterKey, packId, nh);
            byte[] tag = new byte[17];
            byte[] ct = AesGcm.Encrypt(ek, 32, ivs[i], nh, 16, this.entries[i].data, this.entries[i].len, tag);
            cts.Add(ct);
            int rec = 4 + 61 * i;
            for (int j = 0; j < 16; j = j + 1) { idx[rec + 45 + j] = tag[j]; }
            i = i + 1;
        }

        // 先对明文 index 签名，再加密。
        byte[] sig = null;
        if (sigLen > 0) {
            sig = Rsa.SignPkcs1Sha256(idx, idxLen, nBuf, sigLen, dBuf, sigLen);
        }

        byte[] hdr = new byte[58];
        ResourcePack.writeMagic(hdr);
        i = 0;
        while (i < 16) { hdr[5 + i] = packId[i]; i = i + 1; }
        i = 0;
        while (i < 12) { hdr[21 + i] = idxIv[i]; i = i + 1; }
        ResourcePack.storeBE32(hdr, 49, idxLen);
        ResourcePack.storeBE32(hdr, 53, sigLen);

        byte[] ik = ResourcePack.indexKey(masterKey, packId);
        byte[] idxTag = new byte[17];
        byte[] idxCt = AesGcm.Encrypt(ik, 32, idxIv, hdr, 21, idx, idxLen, idxTag);
        i = 0;
        while (i < 16) { hdr[33 + i] = idxTag[i]; i = i + 1; }

        nint fp = fopen(path, "wb");
        if (fp == 0) { return false; }
        fwrite(hdr, 1, 57, fp);
        fwrite(idxCt, 1, idxLen, fp);
        if (sigLen > 0) { fwrite(sig, 1, sigLen, fp); }
        i = 0;
        while (i < count) { fwrite(cts[i], 1, this.entries[i].len, fp); i = i + 1; }
        fclose(fp);
        return true;
    }
}

// 一条已解析的 index 记录：条目名哈希、负载偏移
// 与大小，以及每条目 IV 和 GCM tag。用一个实体代替五个
// 按 index 对齐的并行列表。
