using System;
using System.Collections.Generic;
using System.IO;
using System.Security.Cryptography;
namespace System.Resources;

// 加密资源包（.zrp）写入器。
// 布局（私有格式，没有主密钥则完全不可读）：
// [0..3]   magic（4 个不透明字节，非 ASCII）
// [4]      version（混淆后的版本号）
// [5..20]  packId —— 16 个随机字节，每个 pack 唯一
// [21..32] index 的 IV（12 字节）
// [33..48] index 的 GCM tag（16 字节）
// [49..52] index 密文长度（BE32）
// [53..56] 签名长度（BE32，0 表示无签名）
// [...]    index 密文，然后是 RSA 签名，最后是各条目负载
// index（条目表）由主密钥与 packId 经 HKDF 派生的密钥做 AES-256-GCM 加密，
// 再签名（RSASSA-PKCS1-v1_5 / SHA-256），
// 因此即使攻击者拿到主密钥、却拿不到私钥，
// 重打包或调换条目的文件也会被拒绝。
// 条目名只存截断的 SHA-256 哈希；每个条目
// 用各自 HKDF 派生的密钥加密，因此一个条目密钥泄露
// 不会波及其他条目或主密钥。
public class ResourcePackWriter {
    [DllImport("crt", EntryPoint = "zan_file_fopen")] static extern nint fopen(string path, string mode);
    [DllImport("crt")] static extern long fwrite(string buf, long size, long count, nint fp);
    [DllImport("crt")] static extern int fclose(nint fp);
    [DllImport("crt", EntryPoint = "zan_file_remove")] static extern int removeFile(string path);
    [DllImport("crt", EntryPoint = "zan_file_rename")] static extern int renameFile(string oldname, string newname);

    public List<ResourceEntry> entries;

    // 构造写入器（空 pack，条目经 Add 入队）。
    public ResourcePackWriter() {
        this.entries = new List<ResourceEntry>();
    }

    // 入队一个条目（data 为原始字节，长度显式传入）。
    public void Add(string name, string data, int len) {
        this.entries.Add(new ResourceEntry(name, data, len));
    }

    // 写入 pack（masterKey 为 32 字节；nHex/dHex 为 RSA 十六进制参数用于 index 签名，传 null 可跳过）。
    public bool Write(string path, string masterKey, string nHex, string dHex) {
        if (path == null || masterKey == null || masterKey.Length < 32) { return false; }
        int count = this.entries.Count;
        long idxLenL = 4L + 61L * (long)count;
        if (count < 0 || idxLenL > 2147483647L) { return false; }
        int sigLen = 0;
        byte[] nBuf = null;
        byte[] dBuf = null;
        if (nHex != null || dHex != null) {
            if (nHex == null || dHex == null || (nHex.Length & 1) != 0 || (dHex.Length & 1) != 0) {
                return false;
            }
            sigLen = nHex.Length / 2;
            int dLen = dHex.Length / 2;
            if (sigLen <= 0 || dLen <= 0) { return false; }
            nBuf = Hex.Decode(nHex);
            dBuf = Hex.Decode(dHex);
            if (nBuf == null || dBuf == null || nBuf.Length < sigLen || dBuf.Length < dLen) {
                return false;
            }
        }

        byte[] packId = RandomNumberGenerator.GetBytes(16);
        byte[] idxIv = RandomNumberGenerator.GetBytes(12);
        if (packId == null || idxIv == null) { return false; }

        int idxLen = (int)idxLenL;
        long dataStartL = 57L + idxLenL + (long)sigLen;
        if (dataStartL > 2147483647L) { return false; }

        // 单趟构建明文 index 并用各自 HKDF 派生密钥加密负载。
        byte[] idx = new byte[idxLen + 1];
        ResourcePack.storeBE32(idx, 0, count);
        List<byte[]> cts = new List<byte[]>();
        Dictionary<string, bool> seenNames = new Dictionary<string, bool>();
        long off = dataStartL;
        for (int i = 0; i < count; i = i + 1) {
            ResourceEntry entry = this.entries[i];
            if (entry == null || entry.name == null || entry.len < 0) { return false; }
            if (entry.len > 0 && (entry.data == null || entry.data.Length < entry.len)) { return false; }
            if (off + (long)entry.len > 2147483647L) { return false; }
            byte[] nh = ResourcePack.nameHash(entry.name);
            string hk = Hex.Encode(nh, 16);
            if (seenNames.ContainsKey(hk)) { return false; }
            seenNames.Add(hk, true);
            byte[] iv = RandomNumberGenerator.GetBytes(12);
            if (iv == null) { return false; }

            int rec = 4 + 61 * i;
            for (int j = 0; j < 16; j = j + 1) { idx[rec + j] = nh[j]; }
            ResourcePack.StoreBE64Long(idx, rec + 16, off);
            ResourcePack.StoreBE64Long(idx, rec + 24, (long)entry.len);
            idx[rec + 32] = 0;  // 标志位（bit0 保留给压缩）
            for (int j = 0; j < 12; j = j + 1) { idx[rec + 33 + j] = iv[j]; }

            byte[] ek = ResourcePack.entryKey(masterKey, packId, nh);
            if (ek == null) { return false; }
            byte[] tag = new byte[17];
            string entryData = entry.data != null ? entry.data : "";
            byte[] ct = AesGcm.Encrypt(ek, 32, iv, nh, 16, entryData, entry.len, tag);
            if (ct == null || ct.Length < entry.len) { return false; }
            cts.Add(ct);
            for (int j = 0; j < 16; j = j + 1) { idx[rec + 45 + j] = tag[j]; }
            off = off + (long)entry.len;
        }

        // 先对明文 index 签名，再加密。
        byte[] sig = null;
        if (sigLen > 0) {
            int dLen = dHex.Length / 2;
            sig = Rsa.SignPkcs1Sha256(idx, idxLen, nBuf, sigLen, dBuf, dLen);
            if (sig == null || sig.Length < sigLen) { return false; }
        }

        byte[] hdr = new byte[58];
        ResourcePack.writeMagic(hdr);
        for (int i = 0; i < 16; i = i + 1) { hdr[5 + i] = packId[i]; }
        for (int i = 0; i < 12; i = i + 1) { hdr[21 + i] = idxIv[i]; }
        ResourcePack.storeBE32(hdr, 49, idxLen);
        ResourcePack.storeBE32(hdr, 53, sigLen);

        byte[] ik = ResourcePack.indexKey(masterKey, packId);
        if (ik == null) { return false; }
        byte[] idxTag = new byte[17];
        byte[] idxCt = AesGcm.Encrypt(ik, 32, idxIv, hdr, 21, idx, idxLen, idxTag);
        if (idxCt == null || idxCt.Length < idxLen) { return false; }
        for (int i = 0; i < 16; i = i + 1) { hdr[33 + i] = idxTag[i]; }

        string tmpPath = path + ".tmp." + Hex.Encode(packId, 8);
        nint fp = fopen(tmpPath, "wb");
        if (fp == 0) { return false; }
        bool writeOk = false;
        try {
            if (fwrite(hdr, 1, 57, fp) != 57L) { return false; }
            if (idxLen > 0 && fwrite(idxCt, 1, idxLen, fp) != (long)idxLen) { return false; }
            if (sigLen > 0 && fwrite(sig, 1, sigLen, fp) != (long)sigLen) { return false; }
            for (int i = 0; i < count; i = i + 1) {
                int elen = this.entries[i].len;
                if (elen > 0 && fwrite(cts[i], 1, elen, fp) != (long)elen) { return false; }
            }
            writeOk = true;
        } finally {
            if (fclose(fp) != 0) { writeOk = false; }
        }
        if (!writeOk) {
            removeFile(tmpPath);
            return false;
        }
        if (renameFile(tmpPath, path) != 0) {
            // Windows 上目标已存在时 rename 可能失败，删除旧目标再重试一次。
            removeFile(path);
            if (renameFile(tmpPath, path) != 0) {
                removeFile(tmpPath);
                return false;
            }
        }
        return true;
    }
}
