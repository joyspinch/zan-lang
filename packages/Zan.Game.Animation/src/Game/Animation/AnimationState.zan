using System;

namespace Game.Animation;

// 状态机里的一个状态：绑一段动作片段，加上播放方式。
//
// **为什么状态与片段分开**：同一段片段常常在几个状态里用（"待机"与"战斗待机"
// 用同一个 clip，只是速度不同）。把 clip 挂在状态上，片段就能复用。
public class AnimationState {
    // 状态名（状态机内唯一）。
    public string Name;
    // 绑定的动作片段（可以为空——空状态只作为转移的落点）。
    public AnimationClip Clip;
    // 是否循环播放。
    public bool Loop;
    // 播放速度倍率。
    public float Speed;

    public AnimationState(string name, AnimationClip clip) {
        this.Name = name != null ? name : "";
        this.Clip = clip;
        this.Loop = true;
        this.Speed = 1.0f;
    }

    // 状态名。
    public string StateName { get { return this.Name; } }
    // 播放速度倍率。
    public float PlaySpeed { get { return this.Speed; } set { this.Speed = value; } }
    // 是否循环播放。
    public bool IsLooping { get { return this.Loop; } set { this.Loop = value; } }
}
