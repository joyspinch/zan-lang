using System;

namespace Game.Animation;

// 动画库的错误。
//
// **为什么一律抛异常**：动画数据一旦错了（骨骼下标越界、轨道指向不存在的
// 骨骼、状态机跳到不存在的状态），继续跑只会得到"角色姿势诡异、动作不接"
// 这种没法定位的症状。宁可当场炸掉并带上原因——错误的姿势会一路污染下游的
// 蒙皮顶点与碰撞体，事后查起来成本高得多。
public class AnimationException : Exception {
    public AnimationException(string message) : base(message) { }
}
