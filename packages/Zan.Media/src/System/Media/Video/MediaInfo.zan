using System;

namespace System.Media.Video;

// 媒体文件/流元数据快照（强类型实体）。
public class MediaInfo {
    public string Source = "";
    public bool IsValid = false;
    public bool HasVideo = false;
    public bool HasAudio = false;
    public int Width = 0;
    public int Height = 0;
    public long DurationMs = 0;
    public int FpsNum = 0;
    public int FpsDen = 1;
    public long Bitrate = 0;
    public long FrameCount = 0;
    public string VideoCodec = "";
    public string AudioCodec = "";
    public int AudioSampleRate = 0;
    public int AudioChannels = 0;

    public double Fps {
        get {
            if (this.FpsDen <= 0) return 0.0;
            return (double)this.FpsNum / (double)this.FpsDen;
        }
    }
}

// 进程内零外部 CLI 依赖的媒体探测入口（直通 libavformat）。
public class MediaProbe {
    public static MediaInfo Probe(string url) {
        MediaInfo info = new MediaInfo();
        info.Source = url == null ? "" : url;
        if (url == null || url == "") return info;

        nint h = VideoNative.zan_video_open(url);
        if (h == 0) return info;
        try {
            info.IsValid = true;
            info.HasVideo = VideoNative.zan_video_has_video(h) != 0;
            info.HasAudio = VideoNative.zan_video_has_audio(h) != 0;
            info.Width = VideoNative.zan_video_width(h);
            info.Height = VideoNative.zan_video_height(h);
            info.DurationMs = VideoNative.zan_video_duration_ms(h);
            info.FpsNum = VideoNative.zan_video_fps_num(h);
            info.FpsDen = VideoNative.zan_video_fps_den(h);
            info.Bitrate = VideoNative.zan_video_bitrate(h);
            info.FrameCount = VideoNative.zan_video_frame_count(h);
            info.VideoCodec = VideoNative.zan_video_video_codec(h);
            info.AudioCodec = VideoNative.zan_video_audio_codec(h);
            info.AudioSampleRate = VideoNative.zan_video_audio_sample_rate(h);
            info.AudioChannels = VideoNative.zan_video_audio_channels(h);
            return info;
        } finally {
            VideoNative.zan_video_close(h);
        }
    }
}
