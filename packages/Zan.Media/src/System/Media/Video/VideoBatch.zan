using System;
using System.Collections.Generic;
using System.IO;
using System.Threading;
using System.Drawing;
using System.Drawing.Imaging;

namespace System.Media.Video;

public enum VideoBatchTaskKind {
    Transcode = 0,
    ExtractThumbnail = 1,
    ContactSheet = 2,
    ExtractAudio = 3
}

public delegate void VideoBatchProgressCallback(int completed, int total, string inputPath, bool succeeded);

// 批量视频处理任务配置。
public class VideoBatchOptions {
    public string InputDirectory = "";
    public bool Recursive = false;
    public List<string> InputFiles = null;
    public string OutputDirectory = "";
    public VideoBatchTaskKind TaskKind = VideoBatchTaskKind.Transcode;
    public string OutputExtension = ".mp4";

    // 转码参数
    public TranscodeOptions Transcode = new TranscodeOptions();

    // 抽封面 / 雪碧图参数
    public long ThumbnailTimestampMs = 1000;
    public int ThumbnailWidth = 320;
    public int ThumbnailHeight = 180;
    public ImageFormat ThumbnailFormat = ImageFormat.Jpeg;
    public int ThumbnailQuality = 88;
    public int SheetCols = 3;
    public int SheetRows = 3;
    public int SheetGap = 4;

    // 抽音轨参数
    public string AudioCodec = "aac";
    public string AudioBitrate = "128k";

    public int Concurrency = 1;
    public VideoBatchProgressCallback OnProgress = null;
}

public class VideoBatchItemResult {
    public string InputPath = "";
    public string OutputPath = "";
    public bool Succeeded = false;
    public string Error = "";
}

public class VideoBatchResult {
    public int Total = 0;
    public int Succeeded = 0;
    public int Failed = 0;
    public List<VideoBatchItemResult> Items = new List<VideoBatchItemResult>();
}

// 多线程/单线程视频目录批处理管线（无 GUI 依赖）。
public class VideoBatch {
    public static bool IsSupportedVideoExtension(string path) {
        string ext = Path.GetExtension(path);
        if (ext == null || ext == "") return false;
        string lower = ext.ToLower();
        return lower == ".mp4" || lower == ".mkv" || lower == ".mov"
            || lower == ".avi" || lower == ".webm" || lower == ".flv"
            || lower == ".ts" || lower == ".m4v" || lower == ".wmv";
    }

    public static VideoBatchResult Run(VideoBatchOptions options) {
        VideoBatchResult result = new VideoBatchResult();
        if (options == null || options.OutputDirectory == null || options.OutputDirectory == "") {
            return result;
        }
        Directory.CreateDirectoryRecursive(options.OutputDirectory);

        List<string> files = new List<string>();
        if (options.InputFiles != null && options.InputFiles.Count > 0) {
            for (int i = 0; i < options.InputFiles.Count; i = i + 1) {
                files.Add(options.InputFiles[i]);
            }
        } else if (options.InputDirectory != null && options.InputDirectory != ""
                   && Directory.Exists(options.InputDirectory)) {
            List<string> found = Directory.GetFiles(options.InputDirectory, "*", options.Recursive);
            for (int i = 0; i < found.Count; i = i + 1) {
                if (VideoBatch.IsSupportedVideoExtension(found[i])) {
                    files.Add(found[i]);
                }
            }
        }

        int total = files.Count;
        result.Total = total;
        if (total == 0) return result;

        // 并发写入前预分配无碰撞输出路径，防止不同子目录同名文件互相覆写。
        string[] outputPaths = VideoBatch.ResolveOutputPaths(files, options);
        VideoBatchItemResult[] slots = new VideoBatchItemResult[total];
        int workers = options.Concurrency;
        if (workers < 1) workers = 1;
        if (workers > total) workers = total;
        if (workers > 8) workers = 8;

        if (workers == 1) {
            for (int i = 0; i < total; i = i + 1) {
                VideoBatchItemResult item = VideoBatch.ProcessOne(files[i], outputPaths[i], options);
                slots[i] = item;
                if (options.OnProgress != null) {
                    options.OnProgress(i + 1, total, item.InputPath, item.Succeeded);
                }
            }
        } else {
            nint nextIdx = AtomicInt.NativeCreate(0);
            nint doneCount = AtomicInt.NativeCreate(0);
            nint activeWorkers = AtomicInt.NativeCreate(0);
            try {
                if (nextIdx == 0 || doneCount == 0 || activeWorkers == 0) {
                    throw new InvalidOperationException("VideoBatch: failed to allocate native atomics");
                }
                for (int w = 0; w < workers; w = w + 1) {
                    AtomicInt.NativeAdd(activeWorkers, 1);
                    bool started = false;
                    try {
                        started = Thread.Start(() => {
                            try {
                                while (true) {
                                    int idx = (int)AtomicInt.NativeAdd(nextIdx, 1) - 1;
                                    if (idx >= total) break;
                                    VideoBatchItemResult item = VideoBatch.ProcessOne(files[idx], outputPaths[idx], options);
                                    slots[idx] = item;
                                    int done = (int)AtomicInt.NativeAdd(doneCount, 1);
                                    if (options.OnProgress != null) {
                                        try {
                                            options.OnProgress(done, total, item.InputPath, item.Succeeded);
                                        } catch (Exception ex) { }
                                    }
                                }
                            } finally {
                                AtomicInt.NativeAdd(activeWorkers, -1);
                            }
                        });
                    } finally {
                        if (!started) {
                            AtomicInt.NativeAdd(activeWorkers, -1);
                        }
                    }
                }
            } finally {
                // 等待所有已启动工作线程退出后再销毁原生 AtomicInt，防止中途启动异常触发 UAF。
                if (activeWorkers != 0) {
                    while (AtomicInt.NativeLoad(activeWorkers) > 0) {
                        Thread.Sleep(5);
                    }
                    AtomicInt.NativeDestroy(activeWorkers);
                }
                if (doneCount != 0) { AtomicInt.NativeDestroy(doneCount); }
                if (nextIdx != 0) { AtomicInt.NativeDestroy(nextIdx); }
            }
        }

        for (int i = 0; i < total; i = i + 1) {
            VideoBatchItemResult item = slots[i];
            if (item == null) {
                item = new VideoBatchItemResult();
                item.InputPath = files[i];
                item.Error = "worker aborted";
            }
            result.Items.Add(item);
            if (item.Succeeded) { result.Succeeded = result.Succeeded + 1; }
            else { result.Failed = result.Failed + 1; }
        }
        return result;
    }

    private static string[] ResolveOutputPaths(List<string> files, VideoBatchOptions opt) {
        int total = files.Count;
        string[] paths = new string[total];
        Dict<string, int> used = new Dict<string, int>();
        string suffix = "";
        string ext = "";
        if (opt.TaskKind == VideoBatchTaskKind.ExtractThumbnail) {
            ext = ImageBatch.ExtensionForFormat(opt.ThumbnailFormat);
        } else if (opt.TaskKind == VideoBatchTaskKind.ContactSheet) {
            suffix = "_sheet";
            ext = ImageBatch.ExtensionForFormat(opt.ThumbnailFormat);
        } else if (opt.TaskKind == VideoBatchTaskKind.ExtractAudio) {
            ext = (opt.OutputExtension == null || opt.OutputExtension == "") ? ".m4a" : opt.OutputExtension;
        } else {
            ext = (opt.OutputExtension == null || opt.OutputExtension == "") ? ".mp4" : opt.OutputExtension;
        }
        for (int i = 0; i < total; i = i + 1) {
            string stem = Path.GetFileNameWithoutExtension(files[i]);
            if (stem == null || stem == "") { stem = "item_" + Convert.ToString(i); }
            string candidate = Path.Combine(opt.OutputDirectory, stem + suffix + ext);
            string key = candidate.ToLower();
            int seq = 2;
            while (used.ContainsKey(key)) {
                candidate = Path.Combine(opt.OutputDirectory,
                    stem + "_" + Convert.ToString(seq) + suffix + ext);
                key = candidate.ToLower();
                seq = seq + 1;
            }
            used.Add(key, 1);
            paths[i] = candidate;
        }
        return paths;
    }

    private static VideoBatchItemResult ProcessOne(string inputPath, string outputPath, VideoBatchOptions opt) {
        VideoBatchItemResult res = new VideoBatchItemResult();
        res.InputPath = inputPath;
        res.OutputPath = outputPath;

        if (opt.TaskKind == VideoBatchTaskKind.ExtractThumbnail) {
            ImageBuffer frame = VideoDecoder.ExtractFrame(
                inputPath, opt.ThumbnailTimestampMs, opt.ThumbnailWidth, opt.ThumbnailHeight);
            if (frame.IsEmpty) {
                frame.Dispose();
                res.Error = "extract frame failed";
                return res;
            }
            try {
                res.Succeeded = frame.Save(res.OutputPath, opt.ThumbnailFormat, opt.ThumbnailQuality);
                if (!res.Succeeded) res.Error = "save thumbnail failed";
            } finally {
                frame.Dispose();
            }
            return res;
        }

        if (opt.TaskKind == VideoBatchTaskKind.ContactSheet) {
            ImageBuffer sheet = VideoProcessor.BuildContactSheet(
                inputPath, opt.SheetCols, opt.SheetRows,
                opt.ThumbnailWidth, opt.ThumbnailHeight, opt.SheetGap, (int)0xFF141418);
            if (sheet.IsEmpty) {
                sheet.Dispose();
                res.Error = "build contact sheet failed";
                return res;
            }
            try {
                res.Succeeded = sheet.Save(res.OutputPath, opt.ThumbnailFormat, opt.ThumbnailQuality);
                if (!res.Succeeded) res.Error = "save contact sheet failed";
            } finally {
                sheet.Dispose();
            }
            return res;
        }

        if (opt.TaskKind == VideoBatchTaskKind.ExtractAudio) {
            string exe = opt.Transcode != null ? opt.Transcode.FfmpegExecutable : "ffmpeg";
            MediaProcessResult pr = VideoProcessor.ExtractAudio(
                inputPath, res.OutputPath, opt.AudioCodec, opt.AudioBitrate, exe);
            res.Succeeded = pr.Succeeded;
            res.Error = pr.Error;
            return res;
        }

        // Default: Transcode
        MediaProcessResult tr = VideoProcessor.Transcode(inputPath, res.OutputPath, opt.Transcode);
        res.Succeeded = tr.Succeeded;
        res.Error = tr.Error;
        return res;
    }
}
