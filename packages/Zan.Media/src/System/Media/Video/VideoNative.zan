using System;

namespace System.Media.Video;

// 独立 zan_video 原生驱动桥（运行时动态加载 FFmpeg 6/7/8 共享库）。
public class VideoNative {
    // 显式指定 FFmpeg 共享库所在目录（优先于环境变量 ZAN_FFMPEG_DIR 与系统路径）。
    public static bool SetFfmpegDirectory(string dir) {
        if (dir == null || dir == "") return false;
        return VideoNative.zan_video_set_ffmpeg_dir(dir) != 0;
    }

    // 检查本机是否成功加载 FFmpeg 共享库。
    public static bool IsAvailable() {
        return VideoNative.zan_video_is_available() != 0;
    }

    public static string Version() {
        return VideoNative.zan_video_version();
    }

    public static string LastError() {
        return VideoNative.zan_video_last_error();
    }

    [DllImport("zan_video")]
    static extern int zan_video_set_ffmpeg_dir(string dir);

    [DllImport("zan_video")]
    static extern int zan_video_is_available();

    [DllImport("zan_video")]
    static extern string zan_video_version();

    [DllImport("zan_video")]
    static extern string zan_video_last_error();

    [DllImport("zan_video")]
    static extern nint zan_video_open(string url);

    [DllImport("zan_video")]
    static extern void zan_video_close(nint handle);

    [DllImport("zan_video")]
    static extern int zan_video_width(nint handle);

    [DllImport("zan_video")]
    static extern int zan_video_height(nint handle);

    [DllImport("zan_video")]
    static extern long zan_video_duration_ms(nint handle);

    [DllImport("zan_video")]
    static extern int zan_video_fps_num(nint handle);

    [DllImport("zan_video")]
    static extern int zan_video_fps_den(nint handle);

    [DllImport("zan_video")]
    static extern long zan_video_bitrate(nint handle);

    [DllImport("zan_video")]
    static extern long zan_video_frame_count(nint handle);

    [DllImport("zan_video")]
    static extern int zan_video_has_video(nint handle);

    [DllImport("zan_video")]
    static extern int zan_video_has_audio(nint handle);

    [DllImport("zan_video")]
    static extern int zan_video_audio_sample_rate(nint handle);

    [DllImport("zan_video")]
    static extern int zan_video_audio_channels(nint handle);

    [DllImport("zan_video")]
    static extern string zan_video_video_codec(nint handle);

    [DllImport("zan_video")]
    static extern string zan_video_audio_codec(nint handle);

    [DllImport("zan_video")]
    static extern int zan_video_step(nint handle);

    [DllImport("zan_video")]
    static extern int zan_video_copy_video_argb(nint handle, nint dst, int dstW, int dstH, int dstStride);

    [DllImport("zan_video")]
    static extern long zan_video_video_pts_ms(nint handle);

    [DllImport("zan_video")]
    static extern nint zan_video_audio_pcm_ptr(nint handle);

    [DllImport("zan_video")]
    static extern int zan_video_audio_samples(nint handle);

    [DllImport("zan_video")]
    static extern long zan_video_audio_pts_ms(nint handle);

    [DllImport("zan_video")]
    static extern int zan_video_seek_ms(nint handle, long targetMs);

    [DllImport("zan_video")]
    static extern int zan_video_extract_frame_argb(string url, long timestampMs, nint dst, int dstW, int dstH);
}
