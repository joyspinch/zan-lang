using System;
using System.Collections.Generic;

namespace Messaging.RabbitMQ;

// AMQP 0-9-1 Basic 内容头元数据属性集（RFC 规范标准 14 项属性）。
public class BasicProperties {
    public string contentType;
    public string contentEncoding;
    public Dictionary<string, string> headers;
    public int deliveryMode; // 1: Non-persistent, 2: Persistent
    public int priority;
    public string correlationId;
    public string replyTo;
    public string expiration;
    public string messageId;
    public long timestamp;
    public string type;
    public string userId;
    public string appId;
    public string clusterId;

    public BasicProperties() {
        this.contentType = "text/plain";
        this.contentEncoding = "utf-8";
        this.headers = new Dictionary<string, string>();
        this.deliveryMode = 2; // 默认持久化
        this.priority = 0;
        this.correlationId = "";
        this.replyTo = "";
        this.expiration = "";
        this.messageId = "";
        this.timestamp = 0;
        this.type = "";
        this.userId = "";
        this.appId = "";
        this.clusterId = "";
    }

    public static BasicProperties CreateDefault() {
        return new BasicProperties();
    }

    // 编码属性标志位与变长属性体
    public void Encode(AmqpWriter w) {
        int flags = 0;
        if (this.contentType != null && this.contentType.Length > 0) { flags = flags | 32768; }
        if (this.contentEncoding != null && this.contentEncoding.Length > 0) { flags = flags | 16384; }
        if (this.headers != null && this.headers.Count > 0) { flags = flags | 8192; }
        if (this.deliveryMode > 0) { flags = flags | 4096; }
        if (this.priority > 0) { flags = flags | 2048; }
        if (this.correlationId != null && this.correlationId.Length > 0) { flags = flags | 1024; }
        if (this.replyTo != null && this.replyTo.Length > 0) { flags = flags | 512; }
        if (this.expiration != null && this.expiration.Length > 0) { flags = flags | 256; }
        if (this.messageId != null && this.messageId.Length > 0) { flags = flags | 128; }
        if (this.timestamp > 0) { flags = flags | 64; }
        if (this.type != null && this.type.Length > 0) { flags = flags | 32; }
        if (this.userId != null && this.userId.Length > 0) { flags = flags | 16; }
        if (this.appId != null && this.appId.Length > 0) { flags = flags | 8; }
        if (this.clusterId != null && this.clusterId.Length > 0) { flags = flags | 4; }

        w.WriteShort(flags);

        if ((flags & 32768) != 0) { w.WriteShortString(this.contentType); }
        if ((flags & 16384) != 0) { w.WriteShortString(this.contentEncoding); }
        if ((flags & 8192) != 0) { w.WriteTable(this.headers); }
        if ((flags & 4096) != 0) { w.WriteOctet(this.deliveryMode); }
        if ((flags & 2048) != 0) { w.WriteOctet(this.priority); }
        if ((flags & 1024) != 0) { w.WriteShortString(this.correlationId); }
        if ((flags & 512) != 0) { w.WriteShortString(this.replyTo); }
        if ((flags & 256) != 0) { w.WriteShortString(this.expiration); }
        if ((flags & 128) != 0) { w.WriteShortString(this.messageId); }
        if ((flags & 64) != 0) { w.WriteLongLong(this.timestamp); }
        if ((flags & 32) != 0) { w.WriteShortString(this.type); }
        if ((flags & 16) != 0) { w.WriteShortString(this.userId); }
        if ((flags & 8) != 0) { w.WriteShortString(this.appId); }
        if ((flags & 4) != 0) { w.WriteShortString(this.clusterId); }
    }

    // 从读取器解码
    public static BasicProperties Decode(AmqpReader r) {
        BasicProperties p = new BasicProperties();
        if (r.Remaining() < 2) { return p; }
        int flags = r.ReadShort();
        if ((flags & 32768) != 0) { p.contentType = r.ReadShortString(); }
        if ((flags & 16384) != 0) { p.contentEncoding = r.ReadShortString(); }
        if ((flags & 8192) != 0) { p.headers = r.ReadTable(); }
        if ((flags & 4096) != 0) { p.deliveryMode = r.ReadOctet(); }
        if ((flags & 2048) != 0) { p.priority = r.ReadOctet(); }
        if ((flags & 1024) != 0) { p.correlationId = r.ReadShortString(); }
        if ((flags & 512) != 0) { p.replyTo = r.ReadShortString(); }
        if ((flags & 256) != 0) { p.expiration = r.ReadShortString(); }
        if ((flags & 128) != 0) { p.messageId = r.ReadShortString(); }
        if ((flags & 64) != 0) { p.timestamp = r.ReadLongLong(); }
        if ((flags & 32) != 0) { p.type = r.ReadShortString(); }
        if ((flags & 16) != 0) { p.userId = r.ReadShortString(); }
        if ((flags & 8) != 0) { p.appId = r.ReadShortString(); }
        if ((flags & 4) != 0) { p.clusterId = r.ReadShortString(); }
        return p;
    }
}
