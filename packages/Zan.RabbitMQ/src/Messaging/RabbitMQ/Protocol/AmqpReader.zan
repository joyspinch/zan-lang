using System;
using System.Collections.Generic;
using System.Buffers.Binary;

namespace Messaging.RabbitMQ;

// AMQP 0-9-1 二进制大端序数据反序列化读取器。
// 底层委托至 System.Buffers.Binary.BinaryBufferReader 高性能流式原语。
public class AmqpReader {
    private BinaryBufferReader reader;
    private int bitMask;
    private int bitPos;

    public AmqpReader(byte[] buf) {
        this.reader = new BinaryBufferReader(buf);
        this.bitMask = 0;
        this.bitPos = 8;
    }

    public AmqpReader(byte[] buf, int offset, int length) {
        this.reader = new BinaryBufferReader(buf, offset, length);
        this.bitMask = 0;
        this.bitPos = 8;
    }

    public int Offset() { return this.reader.Position(); }
    public int Remaining() { return this.reader.Remaining(); }
    public bool HasRemaining() { return this.reader.HasRemaining(); }

    public int ReadOctet() {
        this.bitPos = 8;
        return this.reader.ReadUInt8();
    }

    public int ReadShort() {
        this.bitPos = 8;
        return this.reader.ReadUInt16BE();
    }

    public int ReadLong() {
        this.bitPos = 8;
        return this.reader.ReadInt32BE();
    }

    public long ReadLongLong() {
        this.bitPos = 8;
        return this.reader.ReadInt64BE();
    }

    public string ReadShortString() {
        this.bitPos = 8;
        int len = this.reader.ReadUInt8();
        if (len <= 0) { return ""; }
        return this.reader.ReadStringUtf8(len);
    }

    public string ReadLongString() {
        this.bitPos = 8;
        int len = this.reader.ReadInt32BE();
        if (len <= 0) { return ""; }
        return this.reader.ReadStringUtf8(len);
    }

    public byte[] ReadBytes(int count) {
        this.bitPos = 8;
        return this.reader.ReadBytes(count);
    }

    public bool ReadBit() {
        if (this.bitPos >= 8) {
            if (this.reader.Remaining() <= 0) { return false; }
            this.bitMask = this.reader.ReadUInt8();
            this.bitPos = 0;
        }
        bool val = (this.bitMask & (1 << this.bitPos)) != 0;
        this.bitPos = this.bitPos + 1;
        return val;
    }

    // 解析 AMQP Field Table 字段表
    public Dictionary<string, string> ReadTable() {
        this.bitPos = 8;
        Dictionary<string, string> table = new Dictionary<string, string>();
        int tblLen = this.ReadLong();
        if (tblLen <= 0 || tblLen > this.reader.Remaining()) {
            return table;
        }
        int tblEnd = this.reader.Position() + tblLen;
        while (this.reader.Position() < tblEnd) {
            string key = this.ReadShortString();
            if (this.reader.Position() >= tblEnd) { break; }
            int typeTag = this.ReadOctet();
            if (typeTag == 83) { // 'S': Long String
                string val = this.ReadLongString();
                table[key] = val;
            } else if (typeTag == 115) { // 's': Short String
                string val = this.ReadShortString();
                table[key] = val;
            } else if (typeTag == 73) { // 'I': Signed 32-bit int
                int val = this.ReadLong();
                table[key] = Convert.ToString(val);
            } else if (typeTag == 108) { // 'l': Signed 64-bit int
                long val = this.ReadLongLong();
                table[key] = Convert.ToString(val);
            } else if (typeTag == 116) { // 't': Boolean
                int val = this.ReadOctet();
                table[key] = val != 0 ? "true" : "false";
            } else if (typeTag == 70) { // 'F': Field Table
                Dictionary<string, string> sub = this.ReadTable();
                table[key] = "[table]";
            } else if (typeTag == 84) { // 'T': Timestamp
                long val = this.ReadLongLong();
                table[key] = Convert.ToString(val);
            } else if (typeTag == 86) { // 'V': Void
                table[key] = "";
            } else {
                // 跳过未知类型（尽可能保守容错）
                break;
            }
        }
        if (this.reader.Position() < tblEnd) {
            this.reader.Seek(tblEnd);
        }
        return table;
    }
}
