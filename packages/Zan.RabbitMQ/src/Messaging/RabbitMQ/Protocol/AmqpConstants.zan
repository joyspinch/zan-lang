    public static const int METHOD_CONNECTION_TUNE_OK = 31;
    public static const int METHOD_CONNECTION_OPEN = 40;
    public static const int METHOD_CONNECTION_OPEN_OK = 41;
    public static const int METHOD_CONNECTION_CLOSE = 50;
    public static const int METHOD_CONNECTION_CLOSE_OK = 51;

    // ---- Channel 方法 ----
