namespace Messaging.RabbitMQ;

// AMQP 0-9-1 协议标准常量集（RFC规范硬编码，全不可变编译期常量）。
public class AmqpConstants {
    // ---- 协议头部 ----
    public static const string PROTOCOL_HEADER = "AMQP\x00\x00\x09\x01";
    public static const int DEFAULT_PORT = 5672;
    public static const int DEFAULT_TLS_PORT = 5671;

    // ---- 帧类型 (Frame Types) ----
    public static const int FRAME_METHOD = 1;
    public static const int FRAME_HEADER = 2;
    public static const int FRAME_BODY = 3;
    public static const int FRAME_HEARTBEAT = 8;
    public static const int FRAME_END = 206; // 0xCE

    // ---- 类标识 (Class IDs) ----
    public static const int CLASS_CONNECTION = 10;
    public static const int CLASS_CHANNEL = 20;
    public static const int CLASS_EXCHANGE = 40;
    public static const int CLASS_QUEUE = 50;
    public static const int CLASS_BASIC = 60;
    public static const int CLASS_CONFIRM = 85;
    public static const int CLASS_TX = 90;

    // ---- Connection 方法 ----
