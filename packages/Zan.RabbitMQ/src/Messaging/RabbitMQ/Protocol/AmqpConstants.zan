    public static const int METHOD_EXCHANGE_DECLARE_OK = 11;
    public static const int METHOD_EXCHANGE_DELETE = 20;
    public static const int METHOD_EXCHANGE_DELETE_OK = 21;
    public static const int METHOD_EXCHANGE_BIND = 30;
    public static const int METHOD_EXCHANGE_BIND_OK = 31;
    public static const int METHOD_EXCHANGE_UNBIND = 40;
    public static const int METHOD_EXCHANGE_UNBIND_OK = 41;

    // ---- Queue 方法 ----
