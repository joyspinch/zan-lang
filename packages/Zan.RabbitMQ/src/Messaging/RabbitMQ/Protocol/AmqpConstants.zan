    public static const int METHOD_QUEUE_UNBIND_OK = 51;

    // ---- Basic 方法 ----
    public static const int METHOD_BASIC_QOS = 10;
    public static const int METHOD_BASIC_QOS_OK = 11;
    public static const int METHOD_BASIC_CONSUME = 20;
    public static const int METHOD_BASIC_CONSUME_OK = 21;
    public static const int METHOD_BASIC_CANCEL = 30;
    public static const int METHOD_BASIC_CANCEL_OK = 31;
    public static const int METHOD_BASIC_PUBLISH = 40;
