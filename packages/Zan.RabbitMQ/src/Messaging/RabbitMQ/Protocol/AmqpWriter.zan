using System;
using System.Collections.Generic;
using System.Buffers.Binary;

namespace Messaging.RabbitMQ;

// AMQP 0-9-1 二进制大端序数据编码写入器。
// 底层委托至 System.Buffers.Binary.BinaryBufferWriter 高性能流式原语。
public class AmqpWriter {
    private BinaryBufferWriter writer;

    public AmqpWriter() {
        this.writer = new BinaryBufferWriter(256);
    }

    public AmqpWriter(int initialCap) {
        this.writer = new BinaryBufferWriter(initialCap);
    }

    public int Length() {
        return this.writer.Length();
    }

    public void Ensure(int count) {
        this.writer.EnsureCapacity(count);
    }

    public void WriteOctet(int val) {
        this.FlushBits();
        this.writer.WriteUInt8(val);
    }

    public void WriteShort(int val) {
        this.FlushBits();
        this.writer.WriteInt16BE(val);
    }

    public void WriteLong(int val) {
        this.FlushBits();
        this.writer.WriteInt32BE(val);
    }

    public void WriteLongLong(long val) {
        this.FlushBits();
        this.writer.WriteInt64BE(val);
    }

    public void WriteShortString(string s) {
        this.FlushBits();
        if (s == null || s.Length == 0) {
            this.writer.WriteUInt8(0);
            return;
        }
        int slen = s.Length;
        if (slen > 255) { slen = 255; }
        this.writer.WriteUInt8(slen);
        if (slen == s.Length) {
            this.writer.WriteStringUtf8(s);
        } else {
            this.writer.WriteStringUtf8(s.Substring(0, slen));
        }
    }

    public void WriteLongString(string s) {
        this.FlushBits();
        if (s == null) {
            this.writer.WriteInt32BE(0);
            return;
        }
        this.writer.WriteInt32BE(s.Length);
        if (s.Length > 0) {
            this.writer.WriteStringUtf8(s);
        }
    }

    public void WriteBytes(byte[] data, int dataLen) {
        this.FlushBits();
        if (data == null || dataLen <= 0) { return; }
        this.writer.WriteBytes(data, 0, dataLen);
    }

    public void WriteBit(bool bit) {
        // AMQP 0-9-1 规范规定位打包为 LSB-first（从 bit 0 往 bit 7 排布）
        this.writer.WriteBitLSB(bit);
    }

    public void FlushBits() {
        this.writer.FlushBits();
    }

    // 写入标准 AMQP Field Table (嵌套表)
    public void WriteTable(Dictionary<string, string> table) {
        this.FlushBits();
        if (table == null || table.Count == 0) {
            this.WriteLong(0);
            return;
        }
        AmqpWriter tw = new AmqpWriter();
        List<string> keys = table.Keys;
        for (int i = 0; i < keys.Count; i = i + 1) {
            string k = keys[i];
            string v = table[k];
            tw.WriteShortString(k);
            tw.WriteOctet(83); // 'S' -> Long String
            tw.WriteLongString(v);
        }
        byte[] tb = tw.ToBytes();
        this.WriteLong(tb.Length);
        this.WriteBytes(tb, tb.Length);
    }

    public byte[] ToBytes() {
        this.FlushBits();
        return this.writer.ToArray();
    }
}
