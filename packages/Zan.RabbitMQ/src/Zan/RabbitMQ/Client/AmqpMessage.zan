using System;

namespace Zan.RabbitMQ;

// AMQP 接收到的完整投递消息封装。
public class AmqpMessage {
    public string exchange;
    public string routingKey;
    public string consumerTag;
    public long deliveryTag;
    public bool redelivered;
    public BasicProperties properties;
    public byte[] bodyBytes;
    public int bodyLen;

    public AmqpMessage() {
        this.exchange = "";
        this.routingKey = "";
        this.consumerTag = "";
        this.deliveryTag = 0;
        this.redelivered = false;
        this.properties = new BasicProperties();
        this.bodyBytes = null;
        this.bodyLen = 0;
    }

    public string Body() {
        if (this.bodyBytes == null || this.bodyLen <= 0) { return ""; }
        return NativeMemory.GetString((nint)this.bodyBytes, 0, this.bodyLen);
    }

    public byte[] BodyBytes() {
        return this.bodyBytes;
    }

    public int BodyLength() {
        return this.bodyLen;
    }
}
