using System;

namespace Zan.RabbitMQ;

// AMQP 消息消费异步处理委托。
public async delegate void AmqpMessageHandler(AmqpChannel channel, AmqpMessage msg);

// 消费者注册与回调绑定模型。
public class AmqpConsumer {
    public string queue;
    public string consumerTag;
    public bool autoAck;
    public AmqpMessageHandler handler;

    public AmqpConsumer(string queue, string consumerTag, bool autoAck, AmqpMessageHandler handler) {
        this.queue = queue;
        this.consumerTag = consumerTag;
        this.autoAck = autoAck;
        this.handler = handler;
    }
}
