using System;
using System.Collections.Generic;

namespace Zan.RabbitMQ;

// AMQP 0-9-1 二进制大端序数据编码写入器。
public class AmqpWriter {
    private byte[] buf;
    private int len;
    private int cap;
    private int bitMask;
    private int bitPos;

    public AmqpWriter() {
        this.cap = 256;
        this.buf = new byte[this.cap];
        this.len = 0;
        this.bitMask = 0;
        this.bitPos = 0;
    }

    public AmqpWriter(int initialCap) {
        this.cap = initialCap > 16 ? initialCap : 16;
        this.buf = new byte[this.cap];
        this.len = 0;
        this.bitMask = 0;
        this.bitPos = 0;
    }

    public int Length() {
        return this.len;
    }

    public void Ensure(int count) {
        if (this.len + count <= this.cap) { return; }
        int nextCap = this.cap * 2;
        while (nextCap < this.len + count) {
            nextCap = nextCap * 2;
        }
        byte[] nb = new byte[nextCap];
        if (this.len > 0) {
            NativeMemory.Copy((nint)nb, (nint)this.buf, this.len);
        }
        this.buf = nb;
        this.cap = nextCap;
    }

    public void WriteOctet(int val) {
        this.FlushBits();
        this.Ensure(1);
        this.buf[this.len] = (byte)(val & 255);
        this.len = this.len + 1;
    }

    public void WriteShort(int val) {
        this.FlushBits();
        this.Ensure(2);
        this.buf[this.len] = (byte)((val >> 8) & 255);
        this.buf[this.len + 1] = (byte)(val & 255);
        this.len = this.len + 2;
    }

    public void WriteLong(int val) {
        this.FlushBits();
        this.Ensure(4);
        this.buf[this.len] = (byte)((val >> 24) & 255);
        this.buf[this.len + 1] = (byte)((val >> 16) & 255);
        this.buf[this.len + 2] = (byte)((val >> 8) & 255);
        this.buf[this.len + 3] = (byte)(val & 255);
        this.len = this.len + 4;
    }

    public void WriteLongLong(long val) {
        this.FlushBits();
        this.Ensure(8);
        this.buf[this.len] = (byte)((val >> 56) & 255);
        this.buf[this.len + 1] = (byte)((val >> 48) & 255);
        this.buf[this.len + 2] = (byte)((val >> 40) & 255);
        this.buf[this.len + 3] = (byte)((val >> 32) & 255);
        this.buf[this.len + 4] = (byte)((val >> 24) & 255);
        this.buf[this.len + 5] = (byte)((val >> 16) & 255);
        this.buf[this.len + 6] = (byte)((val >> 8) & 255);
        this.buf[this.len + 7] = (byte)(val & 255);
        this.len = this.len + 8;
    }

    public void WriteShortString(string s) {
        this.FlushBits();
        if (s == null || s.Length == 0) {
            this.WriteOctet(0);
            return;
        }
        int slen = s.Length;
        if (slen > 255) { slen = 255; }
        this.Ensure(1 + slen);
        this.buf[this.len] = (byte)slen;
        this.len = this.len + 1;
        NativeMemory.PutString((nint)this.buf, this.len, s, slen);
        this.len = this.len + slen;
    }

    public void WriteLongString(string s) {
        this.FlushBits();
        if (s == null) {
            this.WriteLong(0);
            return;
        }
        int slen = s.Length;
        this.WriteLong(slen);
        if (slen > 0) {
            this.Ensure(slen);
            NativeMemory.PutString((nint)this.buf, this.len, s, slen);
            this.len = this.len + slen;
        }
    }

    public void WriteBytes(byte[] data, int dataLen) {
        this.FlushBits();
        if (data == null || dataLen <= 0) { return; }
        this.Ensure(dataLen);
        NativeMemory.Copy((nint)this.buf + (nint)this.len, (nint)data, dataLen);
        this.len = this.len + dataLen;
    }

    public void WriteBit(bool bit) {
        if (this.bitPos == 0) {
            this.Ensure(1);
            this.buf[this.len] = 0;
            this.len = this.len + 1;
        }
        if (bit) {
            this.buf[this.len - 1] = (byte)(this.buf[this.len - 1] | (1 << this.bitPos));
        }
        this.bitPos = this.bitPos + 1;
        if (this.bitPos >= 8) {
            this.bitPos = 0;
        }
    }

    public void FlushBits() {
        this.bitPos = 0;
    }

    // 写入标准 AMQP Field Table (嵌套表)
    public void WriteTable(Dictionary<string, string> table) {
        this.FlushBits();
        if (table == null || table.Count == 0) {
            this.WriteLong(0);
            return;
        }
        AmqpWriter tw = new AmqpWriter();
        List<string> keys = table.Keys;
        for (int i = 0; i < keys.Count; i = i + 1) {
            string k = keys[i];
            string v = table[k];
            tw.WriteShortString(k);
            tw.WriteOctet(83); // 'S' -> Long String
            tw.WriteLongString(v);
        }
        byte[] tb = tw.ToBytes();
        this.WriteLong(tb.Length);
        this.WriteBytes(tb, tb.Length);
    }

    public byte[] ToBytes() {
        this.FlushBits();
        byte[] res = new byte[this.len];
        if (this.len > 0) {
            NativeMemory.Copy((nint)res, (nint)this.buf, this.len);
        }
        return res;
    }
}
