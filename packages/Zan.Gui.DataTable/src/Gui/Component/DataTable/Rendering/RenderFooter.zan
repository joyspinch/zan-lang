using System;
using Gui;
using Gui.Widget;
using Gui.Backend;

namespace Gui.Component.DataTable;

// DataTable 渲染管道分层：页脚区域、置底固定行、汇总行、分页器、选区统计状态栏与滚动条交互。
public partial class DataTable {
    public static void RenderFooter(App app, int x, int y, int viewW, int viewH,
    DataTableFrame f, DataTableBodyLayout lay,
    List<DataColumn> cols, DataSource src,
    DataTableState st) {
        DataTable.RenderFooter(app, x, y, viewW, viewH, f, lay, cols, src, st, null);
    }

    internal static void RenderFooter(App app, int x, int y, int viewW, int viewH,
    DataTableFrame f, DataTableBodyLayout lay,
    List<DataColumn> cols, DataSource src,
    DataTableState st, SelectionStatistics selection) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        bool touchUi = app.TouchDevice();

        int numW = f.numW;
        int selW = f.selW;
        int gridColor = f.gridColor;
        int clipRight = f.clipRight;
        int firstDataX = f.firstDataX;
        int rowH = f.rowH;
        int fs = f.fs;
        int pinnedW = f.pinnedW;
        int pinnedRW = f.pinnedRW;
        int bandX = f.bandX;
        int bandW = f.bandW;
        int bandNatW = f.bandNatW;
        int maxScrollX = f.maxScrollX;
        int rightX = f.rightX;
        List<FrameColumn> viewportColumns = f.viewportColumns;

        int total = lay.total;
        int summaryH = lay.summaryH;
        int pagerH = lay.pagerH;
        int statusBarH = lay.statusBarH;
        int bottomPinnedH = lay.bottomPinnedH;
        int bodyTop = lay.bodyTop;
        int bodyH = lay.bodyH;
        int visRows = lay.visRows;
        int start = lay.start;

        DataTableStyleSnapshot ss = f.styles != null ? f.styles : DataTableStyleSnapshot.Create(app);
        StyleBox sHint = ss.hint;
        StyleBox sCellBox = ss.cellBox;
        StyleBox sFooter = ss.footer;
        StyleBox sSbar = ss.scrollbar;
        StyleBox sSbarHover = ss.scrollbarHover;

        // ---------------- 置底固定行 (Pinned Bottom Rows) ----------------
        if (st.pinnedBottomRows != null && st.pinnedBottomRows.Count > 0) {
            for (int pbi = 0; pbi < st.pinnedBottomRows.Count; pbi = pbi + 1) {
                int pby = (bodyTop + bodyH) + pbi * rowH;
                DataTable.RenderPinnedRow(app, x, pby, viewW, rowH, numW, selW, cols,
                st.pinnedBottomRows[pbi], st, viewportColumns,
                firstDataX, bandX, bandW, rightX, pinnedW, pinnedRW,
                clipRight, gridColor, "📌", ss);
            }
        }

        // ---------------- 汇总（总计）行 ----------------
        if (st.showSummary) {
            int sumY = bodyTop + bodyH + bottomPinnedH;
            c.FillRect(x + 1, sumY, viewW - 2, summaryH, sFooter.BgOr(0));
            c.FillRect(x + 1, sumY, viewW - 2, 1, gridColor);
            if (st.showRowNum || st.showSelect) {
                c.DrawTextCentered(x, sumY, numW + selW, summaryH, "Σ", sHint.FgOr(0), Style.FontFallback(app, "small"));
            }
            int sBand = -1;
            for (int soi = 0; soi < viewportColumns.Count; soi = soi + 1) {
                FrameColumn summaryColumn = viewportColumns[soi];
                int sc = summaryColumn.column;
                int cw = st.dispW[sc];
                if (summaryColumn.band != sBand) {
                    if (sBand >= 0) { c.PopClip(); }
                    sBand = summaryColumn.band;
                    DataTable.PushBandClip(c, sBand, firstDataX, bandX, bandW, rightX,
                    pinnedW, pinnedRW, sumY, summaryH, clipRight);
                }
                int sx = summaryColumn.x;
                bool sumHover = DataTable.PointerEligible(app, st)
                && app.mouseX >= sx && app.mouseX < sx + cw
                && app.mouseY >= sumY && app.mouseY < sumY + summaryH;
                if (sumHover || (st.sumCtxOpen && st.sumCtxCol == sc)) {
                    c.FillRect(sx, sumY + 1, cw, summaryH - 1, ss.headerHover.BgOr(0));
                }
                string stxt = "";
                if (st.aggregates != null && sc < st.aggregates.Count) {
                    stxt = st.aggregates[sc].summaryText;
                } else if (sc < st.summaryText.Count) {
                    stxt = st.summaryText[sc];
                }
                if (stxt.Length > 0) {
                    int pad = t.paddingSmall;
                    string shown = DataTable.Truncate(stxt, fs, cw - pad * 2);
                    int tw = Canvas.MeasureText(shown, fs);
                    int tx = sx + pad;
                    if (cols[sc].align == 2) { tx = sx + cw - pad - tw; }
                    else if (cols[sc].align == 1) { tx = sx + (cw - tw) / 2; }
                    int ty = Canvas.CenterTextY(sumY, summaryH, fs);
                    c.DrawText(tx, ty, shown, sCellBox.FgOr(0), fs);
                }
            }
            if (sBand >= 0) { c.PopClip(); }
        }

        // ---------------- 分页器页脚 ----------------
        if (st.paged) {
            int fY = bodyTop + bodyH + bottomPinnedH + summaryH;
            c.FillRect(x + 1, fY, viewW - 2, pagerH, sFooter.BgOr(0));
            c.FillRect(x + 1, fY, viewW - 2, 1, gridColor);
            int totalPages = 1;
            if (total > 0) { totalPages = (total + visRows - 1) / visRows; }
            int cur = st.pageModel.Get();
            Pagination pager = st.inputControls != null ? st.inputControls.pager : null;
            if (pager != null) { pager.RenderTree(app); }
            int pgY = fY + (pagerH - t.heightMedium) / 2;
            int from = (cur - 1) * visRows + 1;
            int to = cur * visRows;
            if (to > total) { to = total; }
            if (total == 0) { from = 0; }
            string info = Convert.ToString(from) + "-" + Convert.ToString(to) + " / " + Convert.ToString(total);
            c.DrawText(x + t.paddingMedium, Canvas.CenterTextY(pgY, t.heightMedium, Style.FontFallback(app, "small")), info, sHint.FgOr(0), Style.FontFallback(app, "small"));
        }

        // ---------------- 状态栏 ----------------
        if (st.showStatusBar) {
            int sbY = bodyTop + bodyH + bottomPinnedH + summaryH + pagerH;
            c.FillRect(x + 1, sbY, viewW - 2, statusBarH, sFooter.BgOr(0));
            c.FillRect(x + 1, sbY, viewW - 2, 1, gridColor);
            int sbFs = Style.FontFallback(app, "small");
            int sbTy = Canvas.CenterTextY(sbY, statusBarH, sbFs);

            DataTableInputControls controls = st.inputControls;
            if (controls != null) {
                c.DrawText(x + t.paddingMedium, sbTy, controls.statusText, sFooter.FgOr(0), sbFs);
                for (int fi = 0; fi < controls.footerChips.Count; fi = fi + 1) {
                    DataTableInputRegion chip = controls.footerChips[fi];
                    int visual = chip.IsHovered(app) ? Style.SHover() : Style.SNormal();
                    StyleBox skin = Style.Part(app, "datatable", "chip", "", "rule", "", visual);
                    c.FillRoundRect(chip.bx, chip.by, chip.bw, chip.bh, chip.bh / 2, skin.BgOr(0));
                    c.DrawTextCentered(chip.bx, chip.by, chip.bw - app.Scale(12), chip.bh,
                    chip.filterChip.Text(), skin.FgOr(0), sbFs);
                    c.DrawTextCentered(chip.bx + chip.bw - app.Scale(14), chip.by, app.Scale(12), chip.bh,
                    "×", skin.FgOr(0), sbFs);
                }
            }

            if (DataTable.HasRange(st) || DataTable.HasMulti(st)) {
                if (selection == null) { selection = new SelectionStatistics(true, false); }
                selection.Read(st, cols, src);
                int rsum = selection.footerSum;
                int rcount = selection.footerCount;
                if (rcount > 0) {
                    int ravg = rsum / rcount;
                    string rangeInfo = DataTable.T("Sum", "选区求和:") + " " + Convert.ToString(rsum)
                    + "    " + DataTable.T("Average", "平均:") + " " + Convert.ToString(ravg)
                    + "    " + DataTable.T("Cells", "单元格:") + " " + Convert.ToString(rcount);
                    int rw = Canvas.MeasureText(rangeInfo, sbFs);
                    c.DrawText(x + viewW - t.paddingMedium - rw, sbTy, rangeInfo, sFooter.FgOr(0), sbFs);
                }
            }
        }

        // ---------------- 垂直/水平滚动条 ----------------

        // 垂直滚动条
        if (!st.paged && total > visRows && visRows > 0) {
            int sbW = app.Scale(8);
            int sbX = x + viewW - sbW - app.Scale(2);
            int trackY = bodyTop + app.Scale(2);
            int trackH = bodyH - app.Scale(4);
            int thumbH = (int)((long)trackH * (long)visRows / (long)total);
            if (thumbH < app.Scale(24)) { thumbH = app.Scale(24); }
            int maxStart = total - visRows;
            int thumbY = trackY;
            if (maxStart > 0) { thumbY = trackY + (int)((long)(trackH - thumbH) * (long)start / (long)maxStart); }

            bool sbHover = DataTable.PointerEligible(app, st)
            && app.mouseX >= sbX && app.mouseX < sbX + sbW && app.mouseY >= trackY && app.mouseY < trackY + trackH;
            int thumbColor = sSbar.BgOr(0);
            if (sbHover || st.dragVbar) { thumbColor = sSbarHover.BgOr(0); }
            c.FillRoundRect(sbX, thumbY, sbW, thumbH, sbW / 2, thumbColor);

        }

        // 水平滚动条
        if (maxScrollX > 0) {
            int hbH = app.Scale(8);
            int hbY = bodyTop + bodyH - hbH - app.Scale(2);
            int htrackX = bandX + app.Scale(2);
            int htrackW = bandW - app.Scale(4);
            if (htrackW < app.Scale(24)) { htrackW = app.Scale(24); }
            int thumbW = (int)((long)htrackW * (long)bandW / (long)bandNatW);
            if (thumbW < app.Scale(24)) { thumbW = app.Scale(24); }
            int thumbX = htrackX + (int)((long)(htrackW - thumbW) * (long)st.scrollX / (long)maxScrollX);

            bool hbHover = DataTable.PointerEligible(app, st)
            && app.mouseX >= htrackX && app.mouseX < htrackX + htrackW && app.mouseY >= hbY && app.mouseY < hbY + hbH;
            int hbColor = sSbar.BgOr(0);
            if (hbHover || st.dragHbar) { hbColor = sSbarHover.BgOr(0); }
            c.FillRoundRect(thumbX, hbY, thumbW, hbH, hbH / 2, hbColor);

        }

    }
}
