using System;
using Gui;
using Gui.Widget;
using Gui.Backend;

namespace Gui.Component.DataTable;

// DataTable 渲染管道分层：键盘导航、查找条与筛选行按键拦截、指针选区拖拽映射与悬停提示。
public partial class DataTable {
    public static void CommitEditAndAdvance(DataTableState st, List<DataColumn> cols,
    DataSource src, List<FrameColumn> frameColumns, int visRows, int dataViewW,
    int pinnedW, bool shiftHeld, bool isTab) {
        int prevSlot = st.hitOrder;
        int prevRow = st.editRow;
        if (prevSlot < 0 || prevSlot >= DataTable.DispCount(st)
            || DataTable.DispKind(st, prevSlot) != 0 || DataTable.DispRowOf(st, prevSlot) != prevRow) {
            int dc = DataTable.DispCount(st);
            for (int s = 0; s < dc; s = s + 1) {
                if (DataTable.DispKind(st, s) == 0 && DataTable.DispRowOf(st, s) == prevRow) {
                    prevSlot = s;
                    break;
                }
            }
        }
        int curCol = st.editCol;
        DataTable.CommitEdit(st, cols, src);
        if (st.editing) { return; }
        int delta = shiftHeld ? -1 : 1;
        int nextSlot;
        int nextCol;
        if (isTab) {
            int visIdx = -1;
            if (frameColumns != null) {
                for (int vi = 0; vi < frameColumns.Count; vi = vi + 1) {
                    if (frameColumns[vi].column == curCol) { visIdx = vi; break; }
                }
            }
            nextSlot = prevSlot;
            if (frameColumns != null && frameColumns.Count > 0 && visIdx >= 0) {
                int nextVis = visIdx + delta;
                if (nextVis >= frameColumns.Count) {
                    nextVis = 0;
                    nextSlot = DataTable.NextDataSlot(st, prevSlot + 1, 1);
                } else if (nextVis < 0) {
                    nextVis = frameColumns.Count - 1;
                    nextSlot = DataTable.NextDataSlot(st, prevSlot - 1, -1);
                }
                nextCol = frameColumns[nextVis].column;
            } else {
                nextCol = curCol + delta;
                if (nextCol >= cols.Count) {
                    nextCol = 0;
                    nextSlot = DataTable.NextDataSlot(st, prevSlot + 1, 1);
                } else if (nextCol < 0) {
                    nextCol = cols.Count - 1;
                    nextSlot = DataTable.NextDataSlot(st, prevSlot - 1, -1);
                }
            }
        } else {
            nextCol = curCol;
            nextSlot = DataTable.NextDataSlot(st, prevSlot + delta, delta);
        }
        if (nextSlot >= 0 && nextCol >= 0 && nextCol < cols.Count) {
            DataTable.MoveCursor(st, src, nextSlot, nextCol, false);
            DataTable.ScrollSlotIntoView(st, nextSlot, visRows);
            if (isTab) {
                DataTable.ScrollColIntoView(st, frameColumns, nextCol, dataViewW, pinnedW);
            }
            st.CellClick.Raise(st.host);
        }
    }

    internal static void HandleBodyInput(App app, int x, int y, int viewW, int viewH,
    DataTableFrame f, DataTableBodyLayout lay,
    List<DataColumn> cols, DataSource src,
    DataTableState st, RoutedEventArgs e) {
        int evt = e.eventName == "PointerDown" ? 2 : (e.eventName == "PointerUp" ? 3
        : (e.eventName == "PointerMove" ? 1 : (e.eventName == "KeyDown" ? 4
        : (e.eventName == "TextInput" ? 6 : 0))));
        Canvas c = app.canvas;
        Theme t = app.theme;
        bool touchUi = app.TouchDevice();

        int numW = f.numW;
        int selW = f.selW;
        int clipRight = f.clipRight;
        int firstDataX = f.firstDataX;
        int dataViewW = f.dataViewW;
        int rowH = f.rowH;
        int fs = f.fs;
        int headerH = f.headerH;
        int pinnedW = f.pinnedW;
        List<FrameColumn> frameColumns = f.columns;

        int total = lay.total;
        int filterRowH = lay.filterRowH;
        int bodyTop = lay.bodyTop;
        int bodyH = lay.bodyH;
        int visRows = lay.visRows;
        int start = lay.start;

        // ---------------- 表格体指针交互 ----------------
        int ptrOi = -1;
        if (e.y >= bodyTop && e.y < bodyTop + bodyH && e.x >= x && e.x < clipRight) {
            int rr2 = (e.y - bodyTop) / rowH;
            if (rr2 >= 0 && rr2 < visRows && (start + rr2) < total) { ptrOi = start + rr2; }
            if (ptrOi >= 0 && DataTable.DispKind(st, ptrOi) == 2) { ptrOi = -1; }
        }
        int ptrCol = -1;
        if (ptrOi >= 0 && e.x >= firstDataX) {
            for (int i = f.viewportColumns.Count - 1; i >= 0; i = i - 1) {
                FrameColumn column = f.viewportColumns[i];
                int left = Math.Max(column.x, f.BandClipLeft(column.band));
                int right = Math.Min(column.x + st.dispW[column.column], f.BandClipRight(column.band));
                if (e.x >= left && e.x < right) {
                    ptrCol = column.column;
                    break;
                }
            }
        }

        int ek = evt;
        int eb = app.window.EventButton();
        int emods = e.modifiers;

        // ---------------- 内联编辑器按键处理 ----------------
        if (st.editing) {
            DataColumn ecol = cols[st.editCol];
            bool shiftHeld = Modifiers.HasShift(emods);
            if (ek == 6) {
                int code = e.keyCode;
                if (code == 13) {
                    DataTable.CommitEditAndAdvance(st, cols, src, frameColumns, visRows, dataViewW, pinnedW, shiftHeld, false);
                }
                else if (code == 27) { DataTable.CancelEdit(st); }
                else if (code == 9) {
                    DataTable.CommitEditAndAdvance(st, cols, src, frameColumns, visRows, dataViewW, pinnedW, shiftHeld, true);
                }
                else if (code == 8) {
                    if (st.editCur > 0) {
                        int startp = Text.PrevCharStart(st.editBuf, st.editCur);
                        st.editBuf = Text.DeleteBefore(st.editBuf, st.editCur);
                        st.editCur = startp;
                        st.editError = "";
                        if (ecol.editorKind == 1) { DataTable.RefreshChoices(st, ecol); }
                    }
                } else {
                    string ch = Text.CharStr(code);
                    if (ch.Length > 0) {
                        st.editBuf = Text.InsertAt(st.editBuf, st.editCur, ch);
                        st.editCur = st.editCur + ch.Length;
                        st.editError = "";
                        if (ecol.editorKind == 1) {
                            st.edPopOpen = true;
                            DataTable.RefreshChoices(st, ecol);
                        }
                    }
                }
                app.RequestRedraw();
                ek = 0;
            } else if (ek == 4) {
                int kc = e.keyCode;
                bool consumed = true;
                if (kc == 38 || kc == 40) {
                    int dir = 1;
                    if (kc == 38) { dir = -1; }
                    if (ecol.editorKind == 1) {
                        st.edPopOpen = true;
                        DataTable.MoveChoice(st, dir);
                    } else if (ecol.editorKind == 2) {
                        DataTable.CalendarStep(st, ecol, dir * 7);
                    } else if (ecol.editorKind == 3) {
                        st.editBuf = DataTable.StepValue(ecol, st.editBuf, 0 - dir);
                        st.editCur = st.editBuf.Length;
                        st.editError = "";
                    } else { consumed = false; }
                } else if (kc == 27) {
                    if (st.edPopOpen) { st.edPopOpen = false; }
                    else { DataTable.CancelEdit(st); }
                } else if (kc == 13) {
                    DataTable.CommitEditAndAdvance(st, cols, src, frameColumns, visRows, dataViewW, pinnedW, shiftHeld, false);
                }
                else if (kc == 9) {
                    DataTable.CommitEditAndAdvance(st, cols, src, frameColumns, visRows, dataViewW, pinnedW, shiftHeld, true);
                }
                else if (kc == 37) {
                    if (ecol.editorKind == 2) { DataTable.CalendarStep(st, ecol, -1); }
                    else if (st.editCur > 0) { st.editCur = Text.PrevCharStart(st.editBuf, st.editCur); }
                } else if (kc == 39) {
                    if (ecol.editorKind == 2) { DataTable.CalendarStep(st, ecol, 1); }
                    else if (st.editCur < st.editBuf.Length) { st.editCur = Text.NextCharEnd(st.editBuf, st.editCur); }
                } else if (kc == 33 && ecol.editorKind == 2) { st.edCalMonth = st.edCalMonth - 1; }
                else if (kc == 34 && ecol.editorKind == 2) { st.edCalMonth = st.edCalMonth + 1; }
                else if (kc == 36) { st.editCur = 0; }
                else if (kc == 35) { st.editCur = st.editBuf.Length; }
                else if (kc == 46) {
                    if (st.editCur < st.editBuf.Length) {
                        st.editBuf = Text.RemoveAt(st.editBuf, st.editCur);
                        st.editError = "";
                        if (ecol.editorKind == 1) { DataTable.RefreshChoices(st, ecol); }
                    }
                } else { consumed = false; }
                app.RequestRedraw();
                if (consumed) { ek = 0; }
            }
        }

        if (!st.editing && ek == 4 && (emods & 1) != 0
        && e.keyCode == 70) {
            DataTable.OpenFind(st);
            ek = 0;
            app.RequestRedraw();
        }
        if (!st.editing && st.findOpen && ek == 4 && (emods & 1) == 0
        && e.keyCode == 114) {
            DataTable.CommitFind(st, cols, src);
            DataTable.FindStep(st, cols, src,
            (emods & 2) != 0 ? 0 - 1 : 1, visRows);
            ek = 0;
            app.RequestRedraw();
        }

        if (!st.editing && ek == 4) {
            int kc2 = e.keyCode;
            if ((kc2 == 113 || kc2 == 13) && st.hitRow >= 0 && st.hitCol >= 0
            && st.hitCol < cols.Count && cols[st.hitCol].editable) {
                if (cols[st.hitCol].isBool) {
                    DataTable.ToggleBoolCell(st, cols, src, st.hitRow, st.hitCol);
                } else {
                    DataTable.BeginEdit(st, cols, src, st.hitRow, st.hitCol);
                }
                ek = 0;
                app.RequestRedraw();
            }
        }

        if (!st.editing && ek == 6 && st.hitRow >= 0 && st.hitCol >= 0
        && st.hitCol < cols.Count && cols[st.hitCol].editable && !cols[st.hitCol].isBool
        && st.filterRowFocusCol < 0 && st.openMenu < 0 && !st.colChooserOpen) {
            int code = e.keyCode;
            if (code >= 32 && code != 127) {
                string ch = Text.CharStr(code);
                if (ch.Length > 0) {
                    DataTable.BeginEdit(st, cols, src, st.hitRow, st.hitCol);
                    st.editBuf = ch;
                    st.editCur = ch.Length;
                    if (st.activeEditorWidget != null) {
                        CellEditor activeEd = cols[st.hitCol].editor;
                        if (activeEd == null) { activeEd = st.cellEditor; }
                        if (activeEd != null) { activeEd.BeginEdit(st.activeEditorWidget, ch, cols[st.hitCol]); }
                    }
                    ek = 0;
                    app.RequestRedraw();
                }
            }
        }

        if (!st.editing && ek == 4 && (st.hitRow >= 0 || DataTable.HasRange(st) || DataTable.HasMulti(st))
        && st.filterRowFocusCol < 0 && st.openMenu < 0 && !st.colChooserOpen) {
            if (DataTable.HandleNavKey(app, cols, src, st, frameColumns, visRows,
            dataViewW, pinnedW, e.keyCode, emods)) {
                ek = 0;
                app.RequestRedraw();
            }
        }

        if (ek == 2 && eb == 0 && ptrOi >= 0
        && !st.chartOpen && !st.colChooserOpen
        ) {
            bool ctrlDrag = (emods & 1) != 0;
            int grabW = app.Scale(6);
            if (st.fillHX >= 0 && !st.editing
            && e.x >= st.fillHX - grabW && e.x < st.fillHX + grabW
            && e.y >= st.fillHY - grabW && e.y < st.fillHY + grabW) {
                st.fillDrag = true;

                st.fillSR0 = DataTable.MinI(st.rangeR0, st.rangeR1);
                st.fillSR1 = DataTable.MaxI(st.rangeR0, st.rangeR1);
                st.fillSC0 = DataTable.MinI(st.rangeC0, st.rangeC1);
                st.fillSC1 = DataTable.MaxI(st.rangeC0, st.rangeC1);
                st.fillTR0 = 0; st.fillTR1 = -1;
                st.fillTC0 = 0; st.fillTC1 = -1;
                app.RequestRedraw();
            } else if (DataTable.DispKind(st, ptrOi) == 1) {
                int gi = DataTable.DispRowOf(st, ptrOi);
                GroupRow gRow = st.groups[gi];
                int gcbPx = x + numW + selW + gRow.level * app.Scale(16)
                + app.Scale(6) + app.Scale(14) + app.Scale(4);
                bool onCb = e.x >= gcbPx - app.Scale(2)
                && e.x < gcbPx + app.Scale(16);
                if (!onCb) { DataTable.ToggleCollapse(st, gRow.key); }
                app.RequestRedraw();
            } else if (e.x >= x && e.x < x + numW && !st.rowGripDrag) {
                DataTable.PickRow(st, src, ptrOi, emods);
                st.rowSelDrag = true;
                app.RequestRedraw();
            } else if (e.x >= firstDataX && ptrCol >= 0) {
                bool sameCell = (!st.editing) && st.hitOrder == ptrOi && st.hitCol == ptrCol
                && st.rangeR0 == st.rangeR1 && st.rangeC0 == st.rangeC1;
                if (st.editing) { DataTable.CommitEdit(st, cols, src); }
                if (st.editing) {
                    app.RequestRedraw();
                } else if (DataTable.IsActionCol(cols, ptrCol)) {
                    st.hitOrder = ptrOi;
                    st.hitRow = DataTable.DispRowOf(st, ptrOi);
                    st.hitCol = ptrCol;
                    st.CellClick.Raise(st.host);
                    app.RequestRedraw();
                } else if (DataTable.IsWidgetCol(cols, ptrCol)) {

                    app.RequestRedraw();
                } else if (sameCell && cols[ptrCol].editable && !cols[ptrCol].isBool
                && !ctrlDrag) {
                    DataTable.BeginEdit(st, cols, src, DataTable.DispRowOf(st, ptrOi), ptrCol);
                    app.RequestRedraw();
                } else {
                    bool shiftDrag = (emods & 2) != 0;
                    bool extend = shiftDrag && st.selAnchor >= 0 && st.selAnchorCol >= 0;
                    if (ctrlDrag) {
                        if (DataTable.HasRange(st)) { DataTable.ArchiveRange(st); }
                    } else {
                        if (DataTable.HasMulti(st)) { DataTable.ClearMulti(st); }
                        if (!extend && st.showSelect && DataTable.AnyRowSelected(st, src)) {
                            DataTable.SelectAllRows(st, src, false);
                            st.SelectionChanged.Raise(st.host);
                        }
                    }
                    st.rangeR0 = extend ? st.selAnchor : ptrOi;
                    st.rangeR1 = ptrOi;
                    st.rangeC0 = extend ? st.selAnchorCol : ptrCol;
                    st.rangeC1 = ptrCol;
                    st.rangeDrag = true;
                    st.rangeSelTouched.Clear();
                    if (!extend) { st.selAnchor = ptrOi; st.selAnchorCol = ptrCol; }
                    if (st.showSelect) { DataTable.SyncRangeChecks(st, src); }
                    st.hitOrder = ptrOi;
                    st.hitRow = DataTable.DispRowOf(st, ptrOi);
                    st.hitCol = ptrCol;

                    st.CellClick.Raise(st.host);
                    app.RequestRedraw();
                }
            }
        }

        if (ek == 1 || (ek == 3 && eb == 0)) {
            if (st.fillDrag) {
                st.fillTR0 = 0; st.fillTR1 = -1;
                st.fillTC0 = 0; st.fillTC1 = -1;
                if (ptrOi >= 0) {
                    if (ptrOi > st.fillSR1) {
                        st.fillTR0 = st.fillSR1 + 1; st.fillTR1 = ptrOi;
                        st.fillTC0 = st.fillSC0; st.fillTC1 = st.fillSC1;
                    } else if (ptrOi < st.fillSR0) {
                        st.fillTR0 = ptrOi; st.fillTR1 = st.fillSR0 - 1;
                        st.fillTC0 = st.fillSC0; st.fillTC1 = st.fillSC1;
                    } else if (ptrCol >= 0 && ptrCol > st.fillSC1) {
                        st.fillTC0 = st.fillSC1 + 1; st.fillTC1 = ptrCol;
                        st.fillTR0 = st.fillSR0; st.fillTR1 = st.fillSR1;
                    } else if (ptrCol >= 0 && ptrCol < st.fillSC0) {
                        st.fillTC0 = ptrCol; st.fillTC1 = st.fillSC0 - 1;
                        st.fillTR0 = st.fillSR0; st.fillTR1 = st.fillSR1;
                    }
                    app.RequestRedraw();
                }
            }
            if (st.rowSelDrag && ptrOi >= 0 && ptrOi != st.hitOrder
            && DataTable.DispKind(st, ptrOi) == 0) {
                DataTable.SelectRowSpan(st, src, st.selAnchor, ptrOi);
                st.hitOrder = ptrOi;
                st.hitRow = DataTable.DispRowOf(st, ptrOi);
                st.SelectionChanged.Raise(st.host);
                app.RequestRedraw();
            }
            if (st.rangeDrag && ptrOi >= 0) {
                st.rangeR1 = ptrOi;
                if (ptrCol >= 0) { st.rangeC1 = ptrCol; }
                DataTable.SyncRangeChecks(st, src);
            }
            if (st.dragRow >= 0) {
                int dd = e.y - st.dragStartY;
                if (dd < 0) { dd = 0 - dd; }
                if (dd > rowH / 2) { st.dragMoved = true; app.RequestRedraw(); }
            }
        }

        if (ek == 3 && eb == 0) {
            if (st.fillDrag) {
                st.fillDrag = false;
                if (st.fillTR0 <= st.fillTR1 && st.fillTC0 <= st.fillTC1) {
                    int filled = DataTable.FillApply(st, cols, src,
                    st.fillSR0, st.fillSC0, st.fillSR1, st.fillSC1,
                    st.fillTR0, st.fillTC0, st.fillTR1, st.fillTC1);
                    if (filled > 0) {
                        DataTable.Flash(st, DataTable.TN("Filled {n} cells", filled, "已填充 {n} 个单元格"));
                    }
                }
                st.fillTR0 = 0; st.fillTR1 = -1;
                st.fillTC0 = 0; st.fillTC1 = -1;
                int grabW = app.Scale(6);
                if (st.fillHX >= 0 && e.isDoubleClick
                && e.x >= st.fillHX - grabW && e.x < st.fillHX + grabW
                && e.y >= st.fillHY - grabW && e.y < st.fillHY + grabW) {
                    int lastSlot = DataTable.LastDataSlot(st);
                    if (lastSlot > st.fillSR1) {
                        int dfilled = DataTable.FillApply(st, cols, src,
                        st.fillSR0, st.fillSC0, st.fillSR1, st.fillSC1,
                        st.fillSR1 + 1, st.fillSC0, lastSlot, st.fillSC1);
                        if (dfilled > 0) {
                            DataTable.Flash(st, DataTable.TN("Filled {n} cells", dfilled, "已填充 {n} 个单元格"));
                        }
                    }
                }
                app.RequestRedraw();
            }
            if (st.rangeDrag) { st.rangeDrag = false; st.rangeSelTouched.Clear(); app.RequestRedraw(); }
            if (st.rowSelDrag) { st.rowSelDrag = false; app.RequestRedraw(); }
            if (st.dragRow >= 0) {
                if (st.groupCols.Count == 0 && st.dragMoved && ptrOi >= 0 && ptrOi != st.dragRow
                && DataTable.DispKind(st, ptrOi) == 0) {
                    DataTable.MoveOrder(st, st.dragRow, ptrOi);
                    st.sortKeys.Clear();
                    DataTable.SyncPrimary(st);
                    app.RequestRedraw();
                } else if (!st.dragMoved && DataTable.DispKind(st, st.dragRow) == 0) {
                    DataTable.PickRow(st, src, st.dragRow, emods);
                    app.RequestRedraw();
                }
                st.dragRow = -1;
                st.dragMoved = false;
                st.rowGripDrag = false;
            }
        }

        if (e.eventName == "Click" && eb == 0 && ptrOi >= 0 && DataTable.DispKind(st, ptrOi) == 0
        && e.isDoubleClick && !app.PointerCaptured()) {
            st.hitOrder = ptrOi;
            st.hitRow = DataTable.DispRowOf(st, ptrOi);
            st.hitCol = ptrCol;
            st.RowDoubleClick.Raise(st.host);
            st.CellDoubleClick.Raise(st.host);
        }

    }
}
