using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// 内置适配器装配与共享小工具。
public class WidgetComps {
    // 池化键（与 BandGridComp 同约定：稳定行键 + 列号）。
    public static string PoolKey(RowKey key, int col) {
        return key.Canonical() + ":" + Convert.ToString(col);
    }

    // 布尔列口径解读：声明的 boolTrue/boolFalse 文本精确匹配
    // 优先（"是"/"否" 等自定义口径 ParseBool 不认识），其余交
    // ParseBool（"1"/"true"/"yes"/"✓"…）。
    public static bool BoolOf(DataColumn c, string val) {
        if (c != null && c.boolTrue != "" && val == c.boolTrue) { return true; }
        if (c != null && c.boolFalse != "" && val == c.boolFalse) { return false; }
        return DataTable.ParseBool(val);
    }

    // 布尔列口径文本：开关/复选提交写回用，与 ToggleBoolCell
    // 同一套口径，不产生混方言数据。
    public static string BoolText(DataColumn c, bool on) {
        if (c != null && on && c.boolTrue != "") { return c.boolTrue; }
        if (c != null && !on && c.boolFalse != "") { return c.boolFalse; }
        return on ? "1" : "0";
    }

    // ---- 富媒体单元格预设（对标企业级表格标签组与用户卡片） ----

    // 绘制状态胶囊标签（Pill）：自动居中与圆角背景
    public static int PaintTagPill(App app, Canvas c, int x, int y, int h, string text, int bg, int fg, int border) {
        if (text == null || text.Length == 0) { return 0; }
        int fs = Style.FontFallback(app, "small");
        int tw = Canvas.MeasureText(text, fs);
        int padH = app.Scale(8);
        int pillW = tw + padH * 2;
        int pillH = app.Scale(18);
        if (pillH > h - app.Scale(4)) { pillH = h - app.Scale(4); }
        int py = y + (h - pillH) / 2;
        int radius = pillH / 2;
        c.FillRoundRect(x, py, pillW, pillH, radius, bg);
        if (border != 0) {
            c.DrawRoundRect(x, py, pillW, pillH, radius, 1, border);
        }
        c.DrawTextCentered(x, py, pillW, pillH, text, fg, fs);
        return pillW;
    }

    // 绘制用户头像与名称胶囊：头像圆形缩写 + 名字 + 角色/工号
    public static int PaintUserPill(App app, Canvas c, int x, int y, int w, int h, string name, string role, int avatarBg, int avatarFg) {
        if (name == null) { name = ""; }
        int fsName = Style.FontFallback(app, "default");
        int fsRole = Style.FontFallback(app, "small");
        int avatarSize = app.Scale(20);
        if (avatarSize > h - app.Scale(6)) { avatarSize = h - app.Scale(6); }
        int ay = y + (h - avatarSize) / 2;
        int ax = x + app.Scale(4);

        // 绘制圆形头像底色与首字缩写
        c.FillRoundRect(ax, ay, avatarSize, avatarSize, avatarSize / 2, avatarBg != 0 ? avatarBg : 0x2B7DE9);
        string avatarLetter = name.Length > 0 ? name.Substring(0, 1).ToUpper() : "?";
        c.DrawTextCentered(ax, ay, avatarSize, avatarSize, avatarLetter, avatarFg != 0 ? avatarFg : 0xFFFFFF, fsRole);

        // 绘制名字与副文本
        int textX = ax + avatarSize + app.Scale(6);
        int nameW = Canvas.MeasureText(name, fsName);
        if (role != null && role.Length > 0) {
            int ny = y + (h - app.Scale(28)) / 2;
            c.DrawText(textX, ny, name, 0x1E242C, fsName);
            int ry = ny + app.Scale(14);
            c.DrawText(textX, ry, role, 0x8C95A0, fsRole);
        } else {
            c.DrawText(textX, y + (h - fsName) / 2, name, 0x1E242C, fsName);
        }
        return avatarSize + app.Scale(6) + nameW;
    }

    // 绘制多标签横向流式列表，自动根据宽度裁剪并输出 +N
    public static void PaintMultiTags(App app, Canvas c, int x, int y, int w, int h, List<string> tags, int defaultBg, int defaultFg) {
        if (tags == null || tags.Count == 0) { return; }
        int curX = x + app.Scale(4);
        int gap = app.Scale(4);
        int maxR = x + w - app.Scale(4);

        for (int i = 0; i < tags.Count; i = i + 1) {
            string tag = tags[i];
            int fs = Style.FontFallback(app, "small");
            int tw = Canvas.MeasureText(tag, fs);
            int pillW = tw + app.Scale(12);
            if (curX + pillW > maxR) {
                int rem = tags.Count - i;
                string remText = "+" + Convert.ToString(rem);
                WidgetComps.PaintTagPill(app, c, curX, y, h, remText, 0xF0F3F6, 0x5C6370, 0xD0D7DE);
                break;
            }
            WidgetComps.PaintTagPill(app, c, curX, y, h, tag, defaultBg, defaultFg, 0);
            curX = curX + pillW + gap;
        }
    }
}
