using System;
using Gui;

namespace Gui.Component.DataTable;

// One prepared layout snapshot for a routed input. Business callbacks may retire it.
internal class DataTableInputContext {
    internal DataTableFrame frame;
    internal DataTableBodyLayout body;
    internal List<DataColumn> columns;
    internal DataSource source;
    internal weak DataTableState state;
    internal int generation;
    internal weak DataTableVisualTree tree;

    internal bool Current() {
        return this.tree != null && this.tree.IsInputCurrent(this);
    }
}
