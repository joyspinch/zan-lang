using System;
using Gui;
using Gui.Widget;
using Gui.Backend;

namespace Gui.Component.DataTable;

internal partial class DataTableVisualTree {
    private void PrepareHover(App app, DataTableState st) {
        if (this.frame == null || this.body == null) { return; }
        if (app.TouchDevice() || st.editing || st.ctxOpen || st.hdrCtxOpen || st.chartOpen
        || st.colChooserOpen || st.cfClearOpen || st.ExportUiOpen() || st.openMenu >= 0
        || st.rangeDrag || st.rowSelDrag || st.dragRow >= 0 || st.dragCol >= 0
        || app.PointerCaptured() || app.HasOverlays()) {
            st.tipOi = -1; st.hdrTipCol = -1; return;
        }
        Control host = this.owner;
        Control hit = host.HitTest(app.mouseX, app.mouseY);
        DataTableInputRegion title = hit as DataTableInputRegion;
        if (title != null && title.action == 2 && title.column >= 0) {
            int column = title.column;
            DataColumn col = this.columns[column];
            st.tipOi = -1;
            if (col.description.Length == 0) { st.hdrTipCol = -1; return; }
            int now = Window.GetTickMs();
            if (st.hdrTipCol != column) { st.hdrTipCol = column; st.hdrTipSinceMs = now; }
            int wait = Tooltip.DefaultDelayMs() - (now - st.hdrTipSinceMs);
            if (wait > 0) { app.RequestWakeFrameIn(wait); }
            else { Tooltip.RequestBox(app, title.bx, title.by, title.bw, title.bh,
            DataTable.ColTitle(this.columns, column) + "\n" + col.description,
            Tooltip.Bottom(), app.Scale(320)); }
            return;
        }
        st.hdrTipCol = -1;
        if (hit != host || app.mouseY < body.bodyTop || app.mouseY >= body.bodyTop + body.bodyH) {
            st.tipOi = -1; return;
        }
        int row = (app.mouseY - body.bodyTop) / frame.rowH;
        int order = body.start + row;
        int cell = this.MenuColumn(app.mouseX);
        if (row >= body.visRows || order >= body.total || DataTable.DispKind(st, order) != 0 || cell < 0) {
            st.tipOi = -1; return;
        }
        DataColumn column = this.columns[cell];
        if (column.isBool || column.cellType > 2) { st.tipOi = -1; return; }
        DataTableInputContext proof = this.InputContext();
        string text = DataTable.CellTextRouted(this.columns, this.source, DataTable.DispRowOf(st, order), cell);
        if (!proof.Current()) { return; }
        if (column.cellType != 2) { text = DataTable.FormatCell(column, text); }
        int width = st.dispW[cell];
        if (Canvas.MeasureText(text, frame.fs) <= width - app.theme.paddingSmall * 2) { st.tipOi = -1; return; }
        int now = Window.GetTickMs();
        if (st.tipOi != order || st.tipCol != cell) {
            st.tipOi = order; st.tipCol = cell; st.tipSinceMs = now;
        }
        int index = DataTable.VisPos(frame.columns, cell);
        if (index < 0) { return; }
        int wait = Tooltip.DefaultDelayMs() - (now - st.tipSinceMs);
        if (wait > 0) { app.RequestWakeFrameIn(wait); }
        else { Tooltip.RequestBox(app, frame.columns[index].x, body.bodyTop + row * frame.rowH,
        width, frame.rowH, text, Tooltip.Bottom(), app.Scale(280)); }
    }
}
