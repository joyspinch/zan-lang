using Gui;

namespace Gui.Component.DataTable;

// A prepared child occupies one visible cell/detail/overlay; no provider runs in Paint.
internal class DataTableVisualSlot {
    internal int kind;
    internal int row;
    internal int column;
    internal Control control;

    internal DataTableVisualSlot(int kind, int row, int column, Control control) {
        this.kind = kind;
        this.row = row;
        this.column = column;
        this.control = control;
    }
}
