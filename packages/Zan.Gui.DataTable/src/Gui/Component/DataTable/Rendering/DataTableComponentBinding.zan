using System;
using Gui;

namespace Gui.Component.DataTable;

internal class DataTableComponentBinding {
    internal weak DataTableVisualTree tree;
    internal weak Control control;
    internal CellComp component;
    internal DataColumn column;
    internal weak DataSource source;
    internal weak DataTableState state;
    internal int row;
    internal int col;
    internal bool syncing;

    internal void Changed(Control sender) {
        DataTableVisualTree owner = tree;
        if (syncing || owner == null || control == null) { return; }
        DataTableInputContext context = owner.InputContext();
        if (context == null || context.state != state || context.source != source
        || !owner.ContainsPrepared(state, control)) { return; }
        string value = DataTable.CellTextRouted(context.columns, source, row, col);
        if (!context.Current()) { return; }
        DataTable.CommitCompCell(component, control, column, value, row, col, source, state);
        if (context.Current()) { owner.InputChanged(); }
        if (control.App != null) { control.App.RequestRedraw(); }
    }
}

internal partial class DataTableVisualTree {
    private List<DataTableComponentBinding> componentBindings = new List<DataTableComponentBinding>();

    internal DataTableComponentBinding ComponentBinding(Control control, CellComp component,
    DataColumn column, DataSource source, DataTableState state, int row, int col) {
        DataTableComponentBinding binding = null;
        for (int i = 0; i < componentBindings.Count; i = i + 1) {
            if (componentBindings[i].control == control) { binding = componentBindings[i]; break; }
        }
        if (binding == null) {
            binding = new DataTableComponentBinding(); binding.control = control;
            componentBindings.Add(binding); component.BindInput(control, binding.Changed);
        }
        binding.tree = this; binding.component = component; binding.column = column;
        binding.source = source; binding.state = state; binding.row = row; binding.col = col;
        return binding;
    }
}
