using System;
using Gui;
using Gui.Widget;
using Gui.Backend;

namespace Gui.Component.DataTable;

// 单元格享元绘制器（CellRenderer / 展现层插槽画笔）：
// 普通只读态下的无状态绘制接口。不创建真实 Control，不挂载事件监听，
// 零堆分配，每帧直接通过 Canvas 完成极速自绘。
// 与 CellEditor（悬浮编辑宿主）构成企业级表格的「双模分离」基石。
public class CellRenderer {
    // Preparation chooses the content owner before input is routed. Returning false
    // keeps the built-in content, including its real input children.
    public virtual bool OwnsCell(DataSource src, int row, int col) { return true; }

    // Paint consumes the ownership decision; it cannot create or retire input children.
    public virtual void Paint(App app, Canvas c, DataSource src, int row, int col,
    int x, int y, int w, int h, bool selected, bool hovered) { }
}
