using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Component.DataTable;

// 单元格合并跨度描述符（对标 DevExpress CellMerge / AG Grid colSpan & rowSpan）
public class CellSpan {
    int rowSpan;
    int colSpan;

    CellSpan(int rSpan, int cSpan) {
        this.rowSpan = rSpan;
        this.colSpan = cSpan;
    }

    bool IsMaster() {
        return this.rowSpan > 1 || this.colSpan > 1;
    }

    bool IsCovered() {
        return this.rowSpan == 0 || this.colSpan == 0;
    }

    static CellSpan None() {
        return new CellSpan(1, 1);
    }

    static CellSpan Covered() {
        return new CellSpan(0, 0);
    }

    static CellSpan Make(int rSpan, int cSpan) {
        int r = rSpan > 1 ? rSpan : 1;
        int c = cSpan > 1 ? cSpan : 1;
        return new CellSpan(r, c);
    }
}

// 业务级动态单元格跨行与跨列提供器
public class CellSpanProvider {
    // 获取指定行/列单元格的跨度。
    // - 主格：返回 CellSpan.Make(rSpan, cSpan)（rSpan 或 cSpan > 1）
    // - 从属被覆盖格：返回 CellSpan.Covered()
    // - 无合并独立格：返回 CellSpan.None()
    virtual CellSpan GetSpan(DataSource src, int row, int col) {
        return CellSpan.None();
    }
}

// 基于显式区域配置的单元格合并模型
public class TableSpanModel : CellSpanProvider {
    Dictionary<string, CellSpan> spans;

    TableSpanModel() {
        this.spans = new Dictionary<string, CellSpan>();
    }

    void AddSpan(int row, int col, int rowSpan, int colSpan) {
        if (rowSpan < 1) { rowSpan = 1; }
        if (colSpan < 1) { colSpan = 1; }
        if (rowSpan == 1 && colSpan == 1) { return; }

        string masterKey = Convert.ToString(row) + "," + Convert.ToString(col);
        this.spans[masterKey] = new CellSpan(rowSpan, colSpan);

        for (int r = row; r < row + rowSpan; r = r + 1) {
            for (int c = col; c < col + colSpan; c = c + 1) {
                if (r == row && c == col) { continue; }
                string covKey = Convert.ToString(r) + "," + Convert.ToString(c);
                this.spans[covKey] = CellSpan.Covered();
            }
        }
    }

    void Clear() {
        this.spans.Clear();
    }

    override CellSpan GetSpan(DataSource src, int row, int col) {
        string key = Convert.ToString(row) + "," + Convert.ToString(col);
        if (this.spans.ContainsKey(key)) {
            return this.spans[key];
        }
        return CellSpan.None();
    }
}
