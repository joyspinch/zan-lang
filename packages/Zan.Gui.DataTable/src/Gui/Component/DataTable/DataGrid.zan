using System.Collections.Generic;
using System;
using System.Json;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// 绑定到调用方自身实体列表的数据网格（继承 DataTableHostBase），形式与
// `ListView<T>` / `Dropdown<T>` 一致——用访问器声明列，传入数据，
// 底层驱动完整的 DataTable 引擎（排序/筛选/分组/编辑/虚拟化）。
[ControlKind(Of = "string")]  // 按名构造（HTML/设计文档）造 string 实例
public class DataGrid<T> : DataTableHostBase {
    public override Control CreateCloneShell() { return new DataGrid<T>(); }
    public List<GridColumn<T>> gcols;
    public List<T> data;
    public DataTableState st;
    public GridSource<T> source;
    public List<DataColumn> descs;
    public int boundN;
    public string of;
    public bool defaultFactory;

    public void InitGrid() {
        this.InitControl("datatable");
        this.of = "";
        this.defaultFactory = false;
        this.gcols = new List<GridColumn<T>>();
        this.data = null;
        this.st = new DataTableState();
        this.st.host = this;
        this.source = new GridSource<T>();
        this.source.cols = this.gcols;
        this.source.data = null;
        this.source.factory = null;
        this.source.key = null;
        this.descs = new List<DataColumn>();
        this.boundN = 0 - 1;
        this.wiresOwnEvents = true;
    }

    public DataGrid() { this.InitGrid(); }

    protected override List<DataColumn> HostColumns() { return this.descs; }
    protected override DataSource HostSource() { return this.source; }
    protected override DataTableState HostState() { return this.st; }
    protected override void BeforePrepareVisualTree() { this.SyncDescs(); }

    public List<GridColumn<T>> Columns {
        get { return this.gcols; }
    }

    public List<T> ItemsSource {
        get { return this.data; }
        set { this.Bind(value); }
    }

    public GridKey<T> KeySelector {
        get { return this.source.key; }
        set {
            this.source.key = value;
            this.st.expandedByKey = value != null;
            this.st.expandedRows.Clear();
            this.st.expandedKeys.Clear();
            DataTable.InvalidateData(this.st);
        }
    }

    public GridNew<T> NewRowFactory {
        get { return this.source.factory; }
        set {
            this.source.factory = value;
            this.defaultFactory = false;
        }
    }

    private void InstallDefaultFactory() {
        this.defaultFactory = true;
        this.source.factory = () => {
            TypeInfo ti = typeof(T);
            if (ti.Name != "string" && ti.Name != "object") {
                try {
                    object inst = ti.CreateInstance();
                    if (inst != null) { return (T)inst; }
                } catch (Exception _ex) {
                }
            }
            return null;
        };
    }

    public bool UseRowFactory {
        get { return this.source != null && this.source.factory != null; }
        set {
            if (!value || this.source.factory != null) { return; }
            this.InstallDefaultFactory();
        }
    }

    public string ColumnsJsonText() { return ""; }
    public void SetColumnsJsonText(string val) {
        if (val.Length > 0 && val[0] == 91) { this.SetColumnsJson(val); }
    }

    public void Bind(List<T> src) {
        int n = 0;
        if (src != null) { n = src.Count; }
        bool changed = this.data != src;
        if (this.data != src || n != this.boundN) {
            DataTable.InvalidateData(this.st);
        }
        this.data = src;
        this.source.data = src;
        this.boundN = n;
        if (this.defaultFactory || (this.st.allowAddRow && this.source.factory == null)) {
            this.InstallDefaultFactory();
        }
        if (changed) { this.RetireVisualTree(); }
    }

    public int Count() {
        if (this.data == null) { return 0; }
        return this.data.Count;
    }

    public void SyncDescs() {
        for (int i = 0; i < this.gcols.Count; i = i + 1) {
            this.gcols[i].SyncDesc();
        }
        if (this.descs.Count == this.gcols.Count) {
            for (int i = 0; i < this.gcols.Count; i = i + 1) {
                this.descs[i] = this.gcols[i].desc;
            }
            return;
        }
        this.descs = new List<DataColumn>();
        for (int i = 0; i < this.gcols.Count; i = i + 1) {
            this.descs.Add(this.gcols[i].desc);
        }
    }

    public override void OnMeasure(App app) {
        this.SyncDescs();
        int totalW = 0;
        for (int i = 0; i < this.descs.Count; i = i + 1) {
            int cw = this.descs[i].width > 0 ? this.descs[i].width : 100;
            totalW = totalW + app.Scale(cw);
        }
        if (this.st.showRowNum) { totalW = totalW + app.Scale(40); }
        if (this.st.showSelect) { totalW = totalW + app.Scale(36); }
        this.prefW = totalW > 0 ? totalW : app.Scale(360);
        int rh = this.st.rowH > 0 ? app.Scale(this.st.rowH) : app.Scale(34);
        int rows = this.Count();
        if (rows > 0 && rows <= 12) {
            int calcH = rh * (rows + 1) + app.Scale(4);
            this.prefH = calcH > app.Scale(120) ? calcH : app.Scale(120);
        } else {
            this.prefH = app.Scale(240);
        }
    }

    // 声明式契约：外观开关落在引擎 state 上，经基类转发属性绑定。
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Bool("rowNumbers", "Row numbers").Field("ShowRowNumbers").WithTip("Show the row number gutter."));
        ps.Add(PropSpec.Bool("selectable", "Selectable").Field("ShowSelection").WithTip("Show the selection checkbox column."));
        ps.Add(PropSpec.Bool("striped", "Striped").Field("ShowStripes").WithTip("Alternate row background stripes."));
        ps.Add(PropSpec.Int("rowHeight", "Row height").Field("RowHeightPx")
            .WithTip("Row height in logical pixels; 0 uses the theme height."));
        ps.Add(PropSpec.Bool("rowReorder", "Row reorder").Field("AllowRowReorder")
            .WithTip("Drag the row-number handle to reorder rows."));
        ps.Add(PropSpec.Bool("summary", "Summary row").Field("ShowSummary").WithTip("Show the aggregate summary row."));
        ps.Add(PropSpec.Bool("filterRow", "Filter row").Field("ShowFilterRow").WithTip("Show the per-column filter row."));
        ps.Add(PropSpec.Bool("statusBar", "Status bar").Field("ShowStatusBar").WithTip("Show the status bar under the grid."));
        ps.Add(PropSpec.Bool("groupPanel", "Group panel").Field("ShowGroupPanel")
            .WithTip("Show the drag-to-group panel above the header."));
        ps.Add(PropSpec.Bool("allowAddRow", "Allow add row").Field("ShowAddRow")
            .WithTip("Show the add-row placeholder; needs a row factory."));
        ps.Add(PropSpec.Text("of", "Row Type").Field("of").WithTip("Entity type contract name for typed rows."));
        ps.Add(PropSpec.Bool("rowFactory", "Row Factory").Field("UseRowFactory")
            .WithTip("Enable row insertion/deletion with a row factory."));
        ps.Add(PropSpec.Text("previewColumns", "Preview columns").Accessor("PreviewColumnsText", "SetPreviewColumns"));
        ps.Add(PropSpec.Text("columns", "Columns (JSON)").Accessor("ColumnsJsonText", "SetColumnsJsonText"));
        return ps;
    }

    // 运行期通道解析设计稿 data-x-columns JSON 数组，构建真正的 DataColumn 模型并保留完整元数据。
    public void SetColumnsJson(string json) {
        JsonValue cols = null;
        try { cols = JsonValue.Parse(json); } catch (Exception ex) { cols = null; }
        if (cols == null || !cols.IsArray()) { return; }
        this.gcols.Clear();
        for (int i = 0; i < cols.Count(); i = i + 1) {
            JsonValue c = cols.At(i);
            if (c == null || !c.IsObject()) { continue; }
            string field = c.Str("field", "");
            string title = c.Str("title", field != "" ? field : "Col" + Convert.ToString(i + 1));
            int width = c.Int("width", 100);
            if (width <= 0) { width = 100; }
            string ctype = c.Str("type", "");
            GridColumn<T> gc = null;
            if (ctype == "num") {
                gc = new GridColumn<T>(DataColumn.Numeric(title, width));
            } else if (ctype == "real") {
                int dec = c.Int("decimals", 2);
                gc = new GridColumn<T>(DataColumn.Real(title, width, dec));
            } else if (ctype == "bool") {
                gc = new GridColumn<T>(DataColumn.Bool(title, width));
            } else if (ctype == "date") {
                int order = c.Int("dateOrder", 0);
                gc = new GridColumn<T>(DataColumn.AsDate(new DataColumn(title, width), order));
            } else {
                gc = new GridColumn<T>(DataColumn.Text(title, width));
            }
            if (field != "") { gc.FieldName = field; }
            string align = c.Str("align", "");
            if (align == "right") { gc.Alignment = 2; }
            else if (align == "center") { gc.Alignment = 1; }
            string money = c.Str("money", "");
            if (money != "") { gc.CurrencySymbol = money; }
            if (c.Bool("percent", false)) { gc.IsPercent = true; }
            string prefix = c.Str("prefix", "");
            string suffix = c.Str("suffix", "");
            if (prefix != "" || suffix != "") {
                gc.Prefix = prefix;
                gc.Suffix = suffix;
            }
            if (c.Bool("sum", false)) { gc.SummaryKind = 1; }
            if (c.Bool("avg", false)) { gc.SummaryKind = 2; }
            if (c.Bool("min", false)) { gc.SummaryKind = 3; }
            if (c.Bool("max", false)) { gc.SummaryKind = 4; }
            if (c.Bool("count", false)) { gc.SummaryKind = 5; }
            string pin = c.Str("pin", "");
            if (pin == "left") { gc.Freeze = 1; }
            else if (pin == "right") { gc.Freeze = 2; }
            string band = c.Str("band", "");
            if (band != "") { gc.BandPath = band; }
            JsonValue sortable = c.Get("sortable");
            if (sortable != null && sortable.IsBool() && !sortable.AsBool(true)) {
                gc.IsSortable = false;
            }
            if (c.Bool("editable", false)) { gc.IsEditable = true; }
            this.gcols.Add(gc);
        }
        this.SyncDescs();
        this.st.dirty = true;
    }

    public void SetPreviewColumns(string spec) {
        List<string> parts = spec.Split("|");
        for (int i = 0; i < parts.Count; i = i + 1) {
            string it = parts[i];
            if (it.Length == 0) { continue; }
            int comma = it.IndexOf(",");
            if (comma < 0) {
                this.gcols.Add(new GridColumn<T> { Title = it, Width = 100 });
                continue;
            }
            int w = DataTable.ParseInt(it.Substring(0, comma));
            if (w <= 0) { w = 100; }
            this.gcols.Add(new GridColumn<T> { Title = it.Substring(comma + 1), Width = w });
        }
        this.SyncDescs();
        this.st.dirty = true;
    }

    public string PreviewColumnsText() {
        string outp = "";
        for (int i = 0; i < this.gcols.Count; i = i + 1) {
            DataColumn d = this.gcols[i].desc;
            if (i > 0) { outp = outp + "|"; }
            outp = outp + Convert.ToString(d.width) + "," + d.title;
        }
        return outp;
    }

    public string HitField() {
        int i = this.st.HitCol();
        if (i < 0 || i >= this.gcols.Count) { return ""; }
        return this.gcols[i].desc.FieldName();
    }
}
