        if (evt == "ColumnReorder") { this.st.ColumnReorder.Add(() => a(this)); return; }
        if (evt == "GroupChanged") { this.st.GroupChanged.Add(() => a(this)); return; }
        if (evt == "BandToggled") { this.st.BandToggled.Add(() => a(this)); return; }
        if (evt == "RowInserted") { this.st.RowInserted.Add(() => a(this)); return; }
        if (evt == "RowDeleted") { this.st.RowDeleted.Add(() => a(this)); return; }
        if (evt == "ScrollChanged") { this.st.ScrollChanged.Add(() => a(this)); return; }
        On.AddByNameS(evt, a);
    }

    public override void TriggerEvent(string evt) {
        if (evt == "RowClick") { this.st.RowClick.Raise(); return; }
        if (evt == "RowContext" || evt == "RowRightClick") { this.st.RowContext.Raise(); return; }
