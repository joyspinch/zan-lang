using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// 绑定到调用方自身实体列表的数据网格，形式与
// `ListView<T>` / `Dropdown<T>` 一致——用访问器声明列，传入数据，
// 布局、存储或单元格字符串等细节不会泄漏到
// 调用处：
// ```zan
// grid.Bind(users);          // 调用方的 List<User>，每帧读取
// side.Add(grid);
// ```
// 底层驱动完整的 DataTable 引擎（可排序 / 可筛选 /
// 可分组 / 可编辑 / 虚拟化），泛型前端不损失任何
// 能力——可通过 `DataGrid.State()` 访问原始
// `DataTableState`。
public class DataGrid<T> : Control {
    public List<GridColumn<T>> gcols;
    public List<T> data;
    public DataTableState st;
    public GridSource<T> source;
    // 每帧交给引擎的 `List<DataColumn>`，与
    // `gcols` 保持同步，使构造后新增的列也能显示。
    public List<DataColumn> descs;
    // 上一次 Bind 时的行数（-1 = 还没绑过）：行数变了必须让引擎重算行号集合。
    public int boundN;

    public void InitGrid() {
        this.InitControl("datatable", 5);
        this.gcols = new List<GridColumn<T>>();
        this.data = null;
        this.st = new DataTableState();
        this.source = new GridSource<T>();
        this.source.cols = this.gcols;
        this.source.data = null;
        this.source.factory = null;
        this.source.key = null;
        this.descs = new List<DataColumn>();
        this.boundN = 0 - 1;
        // 引擎自行完成整个网格的命中测试 / 绘制，
        // 因此基类控件不能再注册命中区域或绘制表面。
        this.wiresOwnEvents = true;
    }

    public DataGrid() { this.InitGrid(); }

    public override string Kind() { return "DataGrid"; }

    public override string StyleType() { return "datatable"; }

    // ---- 数据 ---------------------------------------------------------------

    // 绑定调用方的列表。不复制——网格每帧读取，
    // 修改列表会在下一次绘制时生效。
    public DataGrid<T> Bind(List<T> src) {
        int n = 0;
        if (src != null) { n = src.Count; }
        // 换了列表、或者行数变了：引擎里的行号集合（st.order）还是上一份数据
        // 的，不重算就会拿越界行号去取单元格。
        if (this.data != src || n != this.boundN) {
            DataTable.InvalidateData(this.st);
        }
        this.data = src;
        this.source.data = src;
        this.boundN = n;
        return this;
    }

    // 绑定实体的稳定键。key 参与选择、详情、排序平局和后续远程事务；
    // 未设置时仍保留旧的临时位置键行为。
    public DataGrid<T> KeyBy(GridKey<T> provider) {
        this.source.key = provider;
        this.st.expandedByKey = provider != null;
        this.st.expandedRows.Clear();
        this.st.expandedKeys.Clear();
        DataTable.InvalidateData(this.st);
        return this;
    }

    // 数据对象字段被原地修改、但列表引用和行数不变时调用，
    // 使排序、筛选、汇总和条件格式重新读取实体。
    public DataGrid<T> Refresh() {
        DataTable.Refresh(this.st, this.source);
        return this;
    }

    public int Count() {
        if (this.data == null) { return 0; }
        return this.data.Count;
    }

    // 实时的 `DataTableState`，用于链式方法未覆盖的
    // 高级配置（自定义 `CellStyler`、主从详情 provider、绑定），
    // 以及在处理器中读取交互上下文（HitRow / HitCol / …）。
    public DataTableState State() { return this.st; }

    // ---- 列 ------------------------------------------------------------

    public GridColumn<T> Add(GridColumn<T> col) {
        this.gcols.Add(col);
        return col;
    }

    // 纯文本列。
    public GridColumn<T> Col(string title, int width, GridText<T> read) {
        GridColumn<T> c = new GridColumn<T>(DataColumn.Text(title, width));
        c.text = read;
        return this.Add(c);
    }

    // 整数列：右对齐，按值排序与合计。
    public GridColumn<T> NumCol(string title, int width, GridInt<T> read) {
        GridColumn<T> c = new GridColumn<T>(DataColumn.Numeric(title, width));
        c.num = read;
        return this.Add(c);
    }

    // 组件列：`read` 从实体取数值序列（如 `u => u.weekPlan`），
    // `compId` 指定内置组件适配器（"bandgrid"）。值经序列化进
    // 引擎文本路径（导出/排序口径不变），渲染层灌进池化真控件。
    // 链式 `.Shape(r,c)` 声明矩阵形状、`.Heat("teal")` 声明色带。
    public GridColumn<T> CompCol(string title, int width, string compId, GridNums<T> read) {
        GridColumn<T> c = new GridColumn<T>(DataColumn.CompCol(title, width, compId));
        c.nums = read;
        return this.Add(c);
    }

    // 组件列（字符串值形态）：`read` 从实体取原始单元格文本
    // （"true"/"1"/"3"/"已发布"……），`compId` 指定组件适配器
    // （"switch"/"checkbox"/"rate"/"select"/"buttons"，或自注册的
    // CellComp）。控件改动走编辑通道写回，需要可回写访问器。
    // 链式 `.Options("A,B,C")` 给 select/buttons 选项、
    // `.Shape(0,N)` 给 rate 显数。
    public GridColumn<T> WidgetCol(string title, int width, string compId, GridText<T> read) {
        GridColumn<T> c = new GridColumn<T>(DataColumn.WidgetCol(title, width, compId));
        c.text = read;
        return this.Add(c);
    }

    // 保留 `decimals` 位小数的数值列。
    public GridColumn<T> RealCol(string title, int width, int decimals, GridReal<T> read) {
        GridColumn<T> c = new GridColumn<T>(DataColumn.Real(title, width, decimals));
        c.real = read;
        return this.Add(c);
    }
    // 复选框 / 布尔列。
    public GridColumn<T> BoolCol(string title, int width, GridBool<T> read) {
        GridColumn<T> c = new GridColumn<T>(DataColumn.Bool(title, width));
        c.truth = read;
        return this.Add(c);
    }

    // 日期列；`order` 指定存储文本的字段顺序
    // （0 y-m-d，1 d-m-y，2 m-d-y）。
    public GridColumn<T> DateCol(string title, int width, int order, GridText<T> read) {
        GridColumn<T> c = new GridColumn<T>(DataColumn.AsDate(new DataColumn(title, width), order));
        c.text = read;
        return this.Add(c);
    }

    // 图片列：读取器返回文件路径 / `mem:` key / http(s) URL，
    // 单元格内 contain 缩放居中；URL 由 ImageHttp 后台取回。
    public GridColumn<T> ImageCol(string title, int width, GridText<T> read) {
        GridColumn<T> c = new GridColumn<T>(DataColumn.ImageCol(title, width));
        c.text = read;
        return this.Add(c);
    }

    // 图标列：读取器返回 tabler 图标名，居中绘制。
    public GridColumn<T> IconCol(string title, int width, GridText<T> read) {
        GridColumn<T> c = new GridColumn<T>(DataColumn.IconCol(title, width));
        c.text = read;
        return this.Add(c);
    }

    // 按钮列：读取器返回按钮标签（空串时用 `icon` 画图标
    // 按钮）；点击触发 OnCellClick，处理器从 State() 读
    // HitRow()/HitCol() 得到本格位置。
    public GridColumn<T> ButtonCol(string title, int width, string icon, string cls, GridText<T> read) {
        GridColumn<T> c = new GridColumn<T>(DataColumn.ButtonCol(title, width, icon, cls));
        c.text = read;
        return this.Add(c);
    }

    // 迷你图列：读取器返回逗号分隔数值序列（"12,18,9,24"），
    // 格内画 accent 色迷你柱状图；`area` 叠加半透明面积。
    public GridColumn<T> SparklineCol(string title, int width, bool area, GridText<T> read) {
        GridColumn<T> c = new GridColumn<T>(DataColumn.SparklineCol(title, width, area));
        c.text = read;
        return this.Add(c);
    }

    // ---- 外观开关（转发给 state）------------------------

    public DataGrid<T> RowNumbers(bool on) { this.st.showRowNum = on; return this; }
    public DataGrid<T> Selectable(bool on) { this.st.showSelect = on; return this; }
    public DataGrid<T> Striped(bool on) { this.st.striped = on; return this; }
    // 行高（逻辑像素）；0 = 沿用主题高度。用于贴近
    // WinForms/DevExpress 那种高信息密度的紧凑表格。
    public DataGrid<T> RowHeight(int px) { this.st.rowH = px; return this; }
    // 允许用行号右侧的手柄拖动重排行（默认关闭）。
    public DataGrid<T> RowReorder(bool on) { this.st.rowReorder = on; return this; }
    public DataGrid<T> Summary(bool on) { this.st.showSummary = on; return this; }
    public DataGrid<T> FilterRow(bool on) { this.st.showFilterRow = on; return this; }
    public DataGrid<T> StatusBar(bool on) { this.st.showStatusBar = on; return this; }
    public DataGrid<T> GroupPanel(bool on) { this.st.showGroupPanel = on; return this; }
    public DataGrid<T> ExternalRowMenu(bool on) {
        this.st.externalRowMenu = on;
        return this;
    }
    // 在末行下方显示"点击添加"占位符，并启用
    // 右键菜单的插入/删除命令。命令仅在安装行
    // 工厂后生效——见 RowFactory。
    public DataGrid<T> AllowAddRow(bool on) { this.st.allowAddRow = on; return this; }

    // 按字段名显示/隐藏列（列的 `Field`；声明式列由生成器自动
    // 写入 "field"）。多个业务共用一份列并集、装配时按业务裁掉
    // 不适用的列就靠它。未知字段：空操作。
    public DataGrid<T> HideCol(string field, bool hidden) {
        this.SyncDescs();
        DataTable.EnsureInit(this.st, this.descs, this.source);
        DataTable.HideField(this.st, this.descs, field, hidden);
        return this;
    }

    // 打开/关闭列选择器弹层（勾选列表控制各列显隐、
    // 搜索框过滤、行内按钮重排）。常与 GroupPanel(true)
    // 搭配使用——面板右缘有常驻 "Columns" 按钮；
    // 也可以在任意事件处理器里调本方法弹出。
    public DataGrid<T> ColumnChooser(bool open) {
        DataTable.SetColumnChooser(this.st, open);
        return this;
    }

    // 列选择器弹层当前是否打开。
    public bool IsColumnChooserOpen() {
        return DataTable.IsColumnChooserOpen(this.st);
    }

    // 为数据源提供构建空白实体的工厂，以启用行插入/删除：
    // 没有工厂时泛型前端无法构造 `T`，网格将
    // 无论 AllowAddRow 如何设置都保持固定行数。
    public DataGrid<T> RowFactory(GridNew<T> f) {
        this.source.factory = f;
        return this;
    }

    // ---- 事件处理器 -----------------------------------------------------------
    // state 是事件发送者；处理器从 State() 读取上下文
    // （HitRow / HitCol / EditRow / EditValue / …），与引擎模型一致。

    public DataGrid<T> OnRowClick(Action a) { this.st.RowClick.Add(a); return this; }
    public DataGrid<T> OnRowContext(Action a) { this.st.RowContext.Add(a); return this; }
    public DataGrid<T> OnRowRightClick(Action a) { this.st.RowContext.Add(a); return this; }
    public DataGrid<T> OnRowDoubleClick(Action a) { this.st.RowDoubleClick.Add(a); return this; }
    public DataGrid<T> OnCellClick(Action a) { this.st.CellClick.Add(a); return this; }
    public DataGrid<T> OnCellDoubleClick(Action a) { this.st.CellDoubleClick.Add(a); return this; }
    public DataGrid<T> OnCellEdit(Action a) { this.st.CellEdit.Add(a); return this; }
    public DataGrid<T> OnCellValidating(Action a) { this.st.CellValidating.Add(a); return this; }
    public DataGrid<T> OnSelectionChanged(Action a) { this.st.SelectionChanged.Add(a); return this; }
    public DataGrid<T> OnSort(Action a) { this.st.Sort.Add(a); return this; }
    public DataGrid<T> OnHeaderClick(Action a) { this.st.HeaderClick.Add(a); return this; }
    public DataGrid<T> OnColumnClick(Action a) { this.st.HeaderClick.Add(a); return this; }
    public DataGrid<T> OnFilterChanged(Action a) { this.st.FilterChanged.Add(a); return this; }
    public DataGrid<T> OnColumnResize(Action a) { this.st.ColumnResize.Add(a); return this; }
    public DataGrid<T> OnColumnResizeEnd(Action a) { this.st.ColumnResizeEnd.Add(a); return this; }
    public DataGrid<T> OnColumnReorder(Action a) { this.st.ColumnReorder.Add(a); return this; }
    public DataGrid<T> OnGroupChanged(Action a) { this.st.GroupChanged.Add(a); return this; }
    public DataGrid<T> OnBandToggled(Action a) { this.st.BandToggled.Add(a); return this; }
    public DataGrid<T> OnRowInserted(Action a) { this.st.RowInserted.Add(a); return this; }
    public DataGrid<T> OnRowDeleted(Action a) { this.st.RowDeleted.Add(a); return this; }
    public DataGrid<T> OnScrollChanged(Action a) { this.st.ScrollChanged.Add(a); return this; }

    // ---- 企业级功能链式配置 (对标 AG Grid Enterprise & DevExpress GridControl) ----

    public DataGrid<T> ContextMenu(ContextMenuFunc fn) {
        DataTable.SetContextMenuFunc(this.st, fn);
        return this;
    }

    public DataGrid<T> RowStyle(RowStyleFunc fn) {
        DataTable.SetRowStyleFunc(this.st, fn);
        return this;
    }

    public DataGrid<T> ShowSelectionSummary(bool on) {
        DataTable.SetShowSelectionSummary(this.st, on);
        return this;
    }

    public DataGrid<T> SizeColumnsToFit(int viewWidth) {
        this.SyncDescs();
        DataTable.SizeColumnsToFit(this.st, this.descs, viewWidth);
        return this;
    }


    // 根据当前列刷新引擎的描述符列表。描述符
    // 按引用共享，配置器的原地修改
    // 立即可见；此处仅在新增列时重新同步列表长度，
    // 以匹配列数。
    public void SyncDescs() {
        if (this.descs.Count == this.gcols.Count) { return; }
        this.descs = new List<DataColumn>();
        for (int i = 0; i < this.gcols.Count; i = i + 1) {
            this.descs.Add(this.gcols[i].desc);
        }
    }

    // ---- 保留事件钩子 -----------------------------------------------------

    public override void OnMeasure(App app) {
        this.prefW = app.Scale(360);
        this.prefH = app.Scale(240);
    }

    public override void OnPaint(App app) {
        this.SyncDescs();
        this.children = new List<Control>();
        this.st.activeDetails = this.children;
        this.st.ownerControl = this;
        DataTable.RenderSource(app, bx, by, bw, bh, this.descs, this.source, this.st);
    }

    // 声明式契约：外观开关全部落在引擎 state 上，没有对应的
    // 控件字段，因此按 GetExtra/SetExtra 挂钩发布（规格不绑定
    // 字段，读写经由下面两个覆盖走到 st）。
    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec rn = PropSpec.Bool("rowNumbers", "Row numbers");
        rn.WithTip("Show the row number gutter.");
        ps.Add(rn);
        PropSpec sel = PropSpec.Bool("selectable", "Selectable");
        sel.WithTip("Show the selection checkbox column.");
        ps.Add(sel);
        PropSpec stp = PropSpec.Bool("striped", "Striped");
        stp.WithTip("Alternate row background stripes.");
        ps.Add(stp);
        PropSpec rh = PropSpec.Int("rowHeight", "Row height");
        rh.WithTip("Row height in logical pixels; 0 uses the theme height.");
        ps.Add(rh);
        PropSpec ro = PropSpec.Bool("rowReorder", "Row reorder");
        ro.WithTip("Drag the row-number handle to reorder rows.");
        ps.Add(ro);
        PropSpec sm = PropSpec.Bool("summary", "Summary row");
        sm.WithTip("Show the aggregate summary row.");
        ps.Add(sm);
        PropSpec fr = PropSpec.Bool("filterRow", "Filter row");
        fr.WithTip("Show the per-column filter row.");
        ps.Add(fr);
        PropSpec sb = PropSpec.Bool("statusBar", "Status bar");
        sb.WithTip("Show the status bar under the grid.");
        ps.Add(sb);
        PropSpec gp = PropSpec.Bool("groupPanel", "Group panel");
        gp.WithTip("Show the drag-to-group panel above the header.");
        ps.Add(gp);
        PropSpec ar = PropSpec.Bool("allowAddRow", "Allow add row");
        ar.WithTip("Show the add-row placeholder; needs a row factory.");
        ps.Add(ar);
        return ps;
    }

    // 运行期/设计器预览的列头:`"宽,标题|宽,标题"`。工厂只能造
    // `DataGrid<string>`,拿不到实体类型,所以预览只铺列头不铺行;
    // 真正的类型化列由编译期 GenForm 展开成泛型列 API。
    public void SetPreviewColumns(string spec) {
        List<string> parts = spec.Split("|");
        for (int i = 0; i < parts.Count; i = i + 1) {
            string it = parts[i];
            if (it.Length == 0) { continue; }
            int comma = it.IndexOf(",");
            if (comma < 0) {
                this.Col(it, 100, null);
                continue;
            }
            int w = DataTable.ParseInt(it.Substring(0, comma));
            if (w <= 0) { w = 100; }
            this.Col(it.Substring(comma + 1), w, null);
        }
        this.st.dirty = true;
    }

    public string PreviewColumnsText() {
        string outp = "";
        for (int i = 0; i < this.gcols.Count; i = i + 1) {
            DataColumn d = this.gcols[i].desc;
            if (i > 0) { outp = outp + "|"; }
            outp = outp + Convert.ToString(d.width) + "," + d.title;
        }
        return outp;
    }

    public override string GetExtra(string key) {
        if (key == "previewColumns") { return this.PreviewColumnsText(); }
        if (key == "rowNumbers") { return PropSpec.Flag(this.st.showRowNum); }
        if (key == "selectable") { return PropSpec.Flag(this.st.showSelect); }
        if (key == "striped") { return PropSpec.Flag(this.st.striped); }
        if (key == "rowHeight") { return Convert.ToString(this.st.rowH); }
        if (key == "rowReorder") { return PropSpec.Flag(this.st.rowReorder); }
        if (key == "summary") { return PropSpec.Flag(this.st.showSummary); }
        if (key == "filterRow") { return PropSpec.Flag(this.st.showFilterRow); }
        if (key == "statusBar") { return PropSpec.Flag(this.st.showStatusBar); }
        if (key == "groupPanel") { return PropSpec.Flag(this.st.showGroupPanel); }
        if (key == "allowAddRow") { return PropSpec.Flag(this.st.allowAddRow); }
        return "";
    }

    public override bool SetExtra(string key, string val) {
        if (key == "previewColumns") { this.SetPreviewColumns(val); return true; }
        if (key == "rowNumbers") { this.st.showRowNum = PropSpec.IsOn(val); return true; }
        if (key == "selectable") { this.st.showSelect = PropSpec.IsOn(val); return true; }
        if (key == "striped") { this.st.striped = PropSpec.IsOn(val); return true; }
        if (key == "rowHeight") { this.st.rowH = DataTable.ParseInt(val); return true; }
        if (key == "rowReorder") { this.st.rowReorder = PropSpec.IsOn(val); return true; }
        if (key == "summary") { this.st.showSummary = PropSpec.IsOn(val); return true; }
        if (key == "filterRow") { this.st.showFilterRow = PropSpec.IsOn(val); return true; }
        if (key == "statusBar") { this.st.showStatusBar = PropSpec.IsOn(val); return true; }
        if (key == "groupPanel") { this.st.showGroupPanel = PropSpec.IsOn(val); return true; }
        if (key == "allowAddRow") { this.st.allowAddRow = PropSpec.IsOn(val); return true; }
        return false;
    }

    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("RowClick");
        e.Add("RowContext");
        e.Add("RowRightClick");
        e.Add("RowDoubleClick");
        e.Add("CellClick");
        e.Add("CellDoubleClick");
        e.Add("CellDblClick");
        e.Add("CellEdit");
        e.Add("CellValidating");
        e.Add("SelectionChanged");
        e.Add("Sort");
        e.Add("HeaderClick");
        e.Add("ColumnClick");
        e.Add("FilterChanged");
        e.Add("ColumnResize");
        e.Add("ColumnResizeEnd");
        e.Add("ColumnReorder");
        e.Add("GroupChanged");
        e.Add("BandToggled");
        e.Add("RowInserted");
        e.Add("RowDeleted");
        e.Add("ScrollChanged");
        return e;
    }

    // 最近一次命中的数据字段名（CellClick/ColumnResize 等事件
    // 的 HitCol 翻译成稳定 field 名；越界/未命名列返回 ""）。
    // GenForm 的声明式列级事件（columns[i].click）按它分派，
    // 列重排不影响路由。
    public string HitField() {
        int i = this.st.HitCol();
        if (i < 0 || i >= this.gcols.Count) { return ""; }
        return this.gcols[i].desc.FieldName();
    }

    // 把网格的语义事件转发到引擎 state 自身的 UiEvent
    // 字段（与链式 `OnRowClick`/… 订阅的队列相同），
    // 使 JSON/设计器的 `onRowClick` 处理器生效；其余事件回退
    // 到 `On` 上的通用事件集合。
    public override void BindEvent(string evt, Action a) {
        if (evt == "RowClick") { this.st.RowClick.Add(a); return; }
        if (evt == "RowContext" || evt == "RowRightClick") { this.st.RowContext.Add(a); return; }
        if (evt == "RowDoubleClick") { this.st.RowDoubleClick.Add(a); return; }
        if (evt == "CellClick") { this.st.CellClick.Add(a); return; }
        if (evt == "CellDoubleClick" || evt == "CellDblClick") { this.st.CellDoubleClick.Add(a); return; }
        if (evt == "CellEdit") { this.st.CellEdit.Add(a); return; }
        if (evt == "CellValidating") { this.st.CellValidating.Add(a); return; }
        if (evt == "SelectionChanged") { this.st.SelectionChanged.Add(a); return; }
        if (evt == "Sort") { this.st.Sort.Add(a); return; }
        if (evt == "HeaderClick" || evt == "ColumnClick") { this.st.HeaderClick.Add(a); return; }
        if (evt == "FilterChanged") { this.st.FilterChanged.Add(a); return; }
        if (evt == "ColumnResize") { this.st.ColumnResize.Add(a); return; }
        if (evt == "ColumnResizeEnd") { this.st.ColumnResizeEnd.Add(a); return; }
