using System.Collections.Generic;
using System;
using System.Json;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// 声明式泛型数据网格：通过 `ItemsSource` 与 `Columns = [ new GridColumn<T> { ... } ]`
// 或 HTML + CSS 标记声明列模型与外观属性，底层驱动完整的 DataTable 虚拟化引擎。
[GuiKind("DataGrid", typeof(DataGrid<string>))]
public class DataGrid<T> : Control {
    public override Control CreateCloneShell() { return new DataGrid<T>(); }
    public List<GridColumn<T>> gcols;
    public List<T> data;
    public DataTableState st;
    public GridSource<T> source;
    public List<DataColumn> descs;
    public int boundN;
    public string of;
    public bool defaultFactory;
    private DataTableVisualTree visualTree;

    public void InitGrid() {
        this.InitControl("datatable");
        this.of = "";
        this.defaultFactory = false;
        this.gcols = new List<GridColumn<T>>();
        this.data = null;
        this.st = new DataTableState();
        this.source = new GridSource<T>();
        this.source.cols = this.gcols;
        this.source.data = null;
        this.source.factory = null;
        this.source.key = null;
        this.descs = new List<DataColumn>();
        this.boundN = 0 - 1;
        this.wiresOwnEvents = true;
    }

    public DataGrid() { this.InitGrid(); }

    public List<GridColumn<T>> Columns {
        get { return this.gcols; }
    }

    public List<T> ItemsSource {
        get { return this.data; }
        set { this.Bind(value); }
    }

    public GridKey<T> KeySelector {
        get { return this.source.key; }
        set {
            this.source.key = value;
            this.st.expandedByKey = value != null;
            this.st.expandedRows.Clear();
            this.st.expandedKeys.Clear();
            DataTable.InvalidateData(this.st);
        }
    }

    public GridNew<T> NewRowFactory {
        get { return this.source.factory; }
        set {
            this.source.factory = value;
            this.defaultFactory = false;
        }
    }

    public int RowHeightPx {
        get { return this.st.rowH; }
        set { this.st.rowH = value; }
    }

    public bool ShowRowNumbers {
        get { return this.st.showRowNum; }
        set { this.st.showRowNum = value; }
    }

    public bool IsSelectable {
        get { return this.st.showSelect; }
        set { this.st.showSelect = value; }
    }

    public bool IsStriped {
        get { return this.st.striped; }
        set { this.st.striped = value; }
    }

    public bool AllowRowReorder {
        get { return this.st.rowReorder; }
        set { this.st.rowReorder = value; }
    }

    public bool ShowSummary {
        get { return this.st.showSummary; }
        set { this.st.showSummary = value; }
    }

    public bool ShowSelectionSummary {
        get { return DataTable.GetShowSelectionSummary(this.st); }
        set { DataTable.SetShowSelectionSummary(this.st, value); }
    }

    public bool ShowFilterRow {
        get { return this.st.showFilterRow; }
        set { this.st.showFilterRow = value; }
    }

    public bool ShowStatusBar {
        get { return this.st.showStatusBar; }
        set { this.st.showStatusBar = value; }
    }

    public bool ShowGroupPanel {
        get { return this.st.showGroupPanel; }
        set { this.st.showGroupPanel = value; }
    }

    public bool UseExternalRowMenu {
        get { return this.st.externalRowMenu; }
        set { this.st.externalRowMenu = value; }
    }

    public bool AllowAddRow {
        get { return this.st.allowAddRow; }
        set { this.st.allowAddRow = value; }
    }

    public ContextMenuFunc ContextMenuProvider {
        get { return DataTable.GetContextMenuFunc(this.st); }
        set { DataTable.SetContextMenuFunc(this.st, value); }
    }

    public RowStyleFunc RowStyleProvider {
        get { return DataTable.GetRowStyleFunc(this.st); }
        set { DataTable.SetRowStyleFunc(this.st, value); }
    }

    public CellSpanProvider SpanProvider {
        get { return this.st.spanProvider; }
        set { this.st.spanProvider = value; }
    }

    public DetailProvider DetailViewProvider {
        get { return this.st.detail; }
        set { DataTable.SetDetail(this.st, value); }
    }

    public Action RowClick { set { if (value != null) { this.st.RowClick.Add(value); } } }
    public Action RowContext { set { if (value != null) { this.st.RowContext.Add(value); } } }
    public Action RowDoubleClick { set { if (value != null) { this.st.RowDoubleClick.Add(value); } } }
    public Action CellClick { set { if (value != null) { this.st.CellClick.Add(value); } } }
    public Action CellDoubleClick { set { if (value != null) { this.st.CellDoubleClick.Add(value); } } }
    public Action CellEdit { set { if (value != null) { this.st.CellEdit.Add(value); } } }
    public Action CellValidating { set { if (value != null) { this.st.CellValidating.Add(value); } } }
    public Action SelectionChanged { set { if (value != null) { this.st.SelectionChanged.Add(value); } } }
    public Action Sort { set { if (value != null) { this.st.Sort.Add(value); } } }
    public Action HeaderClick { set { if (value != null) { this.st.HeaderClick.Add(value); } } }
    public Action FilterChanged { set { if (value != null) { this.st.FilterChanged.Add(value); } } }
    public Action ColumnResize { set { if (value != null) { this.st.ColumnResize.Add(value); } } }
    public Action ColumnResizeEnd { set { if (value != null) { this.st.ColumnResizeEnd.Add(value); } } }
    public Action ColumnReorder { set { if (value != null) { this.st.ColumnReorder.Add(value); } } }
    public Action GroupChanged { set { if (value != null) { this.st.GroupChanged.Add(value); } } }
    public Action BandToggled { set { if (value != null) { this.st.BandToggled.Add(value); } } }
    public Action RowInserted { set { if (value != null) { this.st.RowInserted.Add(value); } } }
    public Action RowDeleted { set { if (value != null) { this.st.RowDeleted.Add(value); } } }
    public Action ScrollChanged { set { if (value != null) { this.st.ScrollChanged.Add(value); } } }

    public override string Kind() { return "DataGrid"; }

    public override string StyleType() { return "datatable"; }

    public override bool ChildControlsRenderedByOwner() { return true; }

    public override void Arrange(int x, int y, int w, int h) {
        this.bx = x; this.by = y; this.bw = w > 0 ? w : 0; this.bh = h > 0 ? h : 0;
        this.SyncDescs();
        if (this.visualTree == null) { this.visualTree = new DataTableVisualTree(this); }
        this.visualTree.Prepare(this.App, this.descs, this.source, this.st);
    }

    public override bool AcceptsRetainedLongPress() { return true; }
    public override int InputFocusCapabilities() { return 3; }

    public override void OnRoutedEvent(RoutedEventArgs e) {
        if (e.eventName != "PointerCancel") { this.PrepareInputTree(); }
        if (this.visualTree != null) { this.visualTree.RouteBody(e); }
        if (!e.handled) { base.OnRoutedEvent(e); }
    }

    public override void OnPreviewRoutedEvent(RoutedEventArgs e) {
        if (e.eventName == "PointerCancel") { base.OnPreviewRoutedEvent(e); return; }
        this.PrepareInputTree();
        if (this.visualTree != null && this.visualTree.RouteMenuEvent(e)) { return; }
        base.OnPreviewRoutedEvent(e);
    }

    public override bool ChildInViewport(Control child) {
        return this.visualTree != null && this.visualTree.ContainsPrepared(this.st, child);
    }

    protected override Control HitTestCore(int x, int y, int pointerType, List<Control> excludedSubtrees) {
        this.PrepareInputTree();
        Control hit = base.HitTestCore(x, y, pointerType, excludedSubtrees);
        return this.visualTree != null ? this.visualTree.ClipHit(hit, x, y) : hit;
    }

    private void PrepareInputTree() {
        this.SyncDescs();
        if (this.visualTree == null || this.visualTree.NeedsPrepare(this.descs, this.source, this.st)) {
            this.Arrange(this.bx, this.by, this.bw, this.bh);
        }
    }

    public override void CollectInputFocus(App app, List<Control> controls) {
        this.PrepareInputTree();
        base.CollectInputFocus(app, controls);
    }

    public override Control FindInputFocus(App app) {
        this.PrepareInputTree();
        return base.FindInputFocus(app);
    }

    public void Bind(List<T> src) {
        int n = 0;
        if (src != null) { n = src.Count; }
        bool changed = this.data != src;
        if (this.data != src || n != this.boundN) {
            DataTable.InvalidateData(this.st);
        }
        this.data = src;
        this.source.data = src;
        this.boundN = n;
        if (this.defaultFactory || (this.st.allowAddRow && this.source.factory == null)) {
            this.defaultFactory = true;
            this.source.factory = () => {
                TypeInfo ti = typeof(T);
                if (ti.Name != "string" && ti.Name != "object") {
                    try {
                        object inst = ti.CreateInstance();
                        if (inst != null) { return (T)inst; }
                    } catch (Exception _ex) {
                    }
                }
                return null;
            };
        }
        if (changed && this.visualTree != null) { this.visualTree.Retire(this.st); }
    }

    public void Refresh() {
        DataTable.Refresh(this.st, this.source);
    }

    public int Count() {
        if (this.data == null) { return 0; }
        return this.data.Count;
    }

    public DataTableState State() { return this.st; }

    public void HideCol(string field, bool hidden) {
        this.SyncDescs();
        DataTable.EnsureInit(this.st, this.descs, this.source);
        DataTable.HideField(this.st, this.descs, field, hidden);
    }

    public void ColumnChooser(bool open) {
        DataTable.SetColumnChooser(this.st, open);
    }

    public bool IsColumnChooserOpen() {
        return DataTable.IsColumnChooserOpen(this.st);
    }

    public void SizeColumnsToFit(int viewWidth) {
        this.SyncDescs();
        DataTable.SizeColumnsToFit(this.st, this.descs, viewWidth);
    }

    public void AutoMergeColumn(int colIndex) {
        if (this.st.spanProvider == null || !(this.st.spanProvider is AutoCellSpanModel)) {
            this.st.spanProvider = new AutoCellSpanModel();
        }
        AutoCellSpanModel autoModel = (AutoCellSpanModel)this.st.spanProvider;
        autoModel.AddColumn(colIndex);
    }

    public void AutoMergeColumn(string field) {
        this.SyncDescs();
        int ci = DataTable.Col(this.descs, field);
        if (ci >= 0) {
            this.AutoMergeColumn(ci);
        }
    }

    public byte[] SaveLayoutMsgPack() {
        this.SyncDescs();
        return DataTable.SaveLayoutMsgPack(this.st, this.descs);
    }

    public bool LoadLayoutMsgPack(byte[] bytes) {
        this.SyncDescs();
        return DataTable.LoadLayoutMsgPack(this.st, this.descs, bytes);
    }

    public string SaveLayoutToken() {
        this.SyncDescs();
        return DataTable.SaveLayoutToken(this.st, this.descs);
    }

    public bool LoadLayoutToken(string token) {
        this.SyncDescs();
        return DataTable.LoadLayoutToken(this.st, this.descs, token);
    }

    public void SyncDescs() {
        for (int i = 0; i < this.gcols.Count; i = i + 1) {
            this.gcols[i].SyncDesc();
        }
        if (this.descs.Count == this.gcols.Count) {
            for (int i = 0; i < this.gcols.Count; i = i + 1) {
                this.descs[i] = this.gcols[i].desc;
            }
            return;
        }
        this.descs = new List<DataColumn>();
        for (int i = 0; i < this.gcols.Count; i = i + 1) {
            this.descs.Add(this.gcols[i].desc);
        }
    }

    public override void OnMeasure(App app) {
        this.SyncDescs();
        int totalW = 0;
        for (int i = 0; i < this.descs.Count; i = i + 1) {
            int cw = this.descs[i].width > 0 ? this.descs[i].width : 100;
            totalW = totalW + app.Scale(cw);
        }
        if (this.st.showRowNum) { totalW = totalW + app.Scale(40); }
        if (this.st.showSelect) { totalW = totalW + app.Scale(36); }
        this.prefW = totalW > 0 ? totalW : app.Scale(360);
        int rh = this.st.rowH > 0 ? app.Scale(this.st.rowH) : app.Scale(34);
        int rows = this.Count();
        if (rows > 0 && rows <= 12) {
            int calcH = rh * (rows + 1) + app.Scale(4);
            this.prefH = calcH > app.Scale(120) ? calcH : app.Scale(120);
        } else {
            this.prefH = app.Scale(240);
        }
    }

    public override void OnPaint(App app) {
        if (this.visualTree != null) { this.visualTree.Render(app, this.descs, this.source, this.st); }
    }

    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec rn = PropSpec.Bool("rowNumbers", "Row numbers");
        rn.WithTip("Show the row number gutter.");
        ps.Add(rn);
        PropSpec sel = PropSpec.Bool("selectable", "Selectable");
        sel.WithTip("Show the selection checkbox column.");
        ps.Add(sel);
        PropSpec stp = PropSpec.Bool("striped", "Striped");
        stp.WithTip("Alternate row background stripes.");
        ps.Add(stp);
        PropSpec rh = PropSpec.Int("rowHeight", "Row height");
        rh.WithTip("Row height in logical pixels; 0 uses the theme height.");
        ps.Add(rh);
        PropSpec ro = PropSpec.Bool("rowReorder", "Row reorder");
        ro.WithTip("Drag the row-number handle to reorder rows.");
        ps.Add(ro);
        PropSpec sm = PropSpec.Bool("summary", "Summary row");
        sm.WithTip("Show the aggregate summary row.");
        ps.Add(sm);
        PropSpec fr = PropSpec.Bool("filterRow", "Filter row");
        fr.WithTip("Show the per-column filter row.");
        ps.Add(fr);
        PropSpec sb = PropSpec.Bool("statusBar", "Status bar");
        sb.WithTip("Show the status bar under the grid.");
        ps.Add(sb);
        PropSpec gp = PropSpec.Bool("groupPanel", "Group panel");
        gp.WithTip("Show the drag-to-group panel above the header.");
        ps.Add(gp);
        PropSpec ar = PropSpec.Bool("allowAddRow", "Allow add row");
        ar.WithTip("Show the add-row placeholder; needs a row factory.");
        ps.Add(ar);
        PropSpec ofp = PropSpec.Text("of", "Row Type");
        ofp.WithTip("Entity type contract name for typed rows.");
        ps.Add(ofp);
        PropSpec rf = PropSpec.Bool("rowFactory", "Row Factory");
        rf.WithTip("Enable row insertion/deletion with a row factory.");
        ps.Add(rf);
        return ps;
    }

    public void SetColumnsJson(string json) {
        JsonValue cols = null;
        try { cols = JsonValue.Parse(json); } catch (Exception ex) { cols = null; }
        if (cols == null || !cols.IsArray()) { return; }
        this.gcols.Clear();
        for (int i = 0; i < cols.Count(); i = i + 1) {
            JsonValue c = cols.At(i);
            if (c == null || !c.IsObject()) { continue; }
            string field = c.Str("field", "");
            string title = c.Str("title", field != "" ? field : "Col" + Convert.ToString(i + 1));
            int width = c.Int("width", 100);
            if (width <= 0) { width = 100; }
            string ctype = c.Str("type", "");
            GridColumn<T> gc = null;
            if (ctype == "num") {
                gc = new GridColumn<T>(DataColumn.Numeric(title, width));
            } else if (ctype == "real") {
                int dec = c.Int("decimals", 2);
                gc = new GridColumn<T>(DataColumn.Real(title, width, dec));
            } else if (ctype == "bool") {
                gc = new GridColumn<T>(DataColumn.Bool(title, width));
            } else if (ctype == "date") {
                int order = c.Int("dateOrder", 0);
                gc = new GridColumn<T>(DataColumn.AsDate(new DataColumn(title, width), order));
            } else {
                gc = new GridColumn<T>(DataColumn.Text(title, width));
            }
            if (field != "") { gc.FieldName = field; }
            string align = c.Str("align", "");
            if (align == "right") { gc.Alignment = 2; }
            else if (align == "center") { gc.Alignment = 1; }
            string money = c.Str("money", "");
            if (money != "") { gc.CurrencySymbol = money; }
            if (c.Bool("percent", false)) { gc.IsPercent = true; }
            string prefix = c.Str("prefix", "");
            string suffix = c.Str("suffix", "");
            if (prefix != "" || suffix != "") {
                gc.Prefix = prefix;
                gc.Suffix = suffix;
            }
            if (c.Bool("sum", false)) { gc.SummaryKind = 1; }
            if (c.Bool("avg", false)) { gc.SummaryKind = 2; }
            if (c.Bool("min", false)) { gc.SummaryKind = 3; }
            if (c.Bool("max", false)) { gc.SummaryKind = 4; }
            if (c.Bool("count", false)) { gc.SummaryKind = 5; }
            string pin = c.Str("pin", "");
            if (pin == "left") { gc.Freeze = 1; }
            else if (pin == "right") { gc.Freeze = 2; }
            string band = c.Str("band", "");
            if (band != "") { gc.BandPath = band; }
            JsonValue sortable = c.Get("sortable");
            if (sortable != null && sortable.IsBool() && !sortable.AsBool(true)) {
                gc.IsSortable = false;
            }
            if (c.Bool("editable", false)) { gc.IsEditable = true; }
            this.gcols.Add(gc);
        }
        this.SyncDescs();
        this.st.dirty = true;
    }

    public void SetPreviewColumns(string spec) {
        List<string> parts = spec.Split("|");
        for (int i = 0; i < parts.Count; i = i + 1) {
            string it = parts[i];
            if (it.Length == 0) { continue; }
            int comma = it.IndexOf(",");
            if (comma < 0) {
                this.gcols.Add(new GridColumn<T> { Title = it, Width = 100 });
                continue;
            }
            int w = DataTable.ParseInt(it.Substring(0, comma));
            if (w <= 0) { w = 100; }
            this.gcols.Add(new GridColumn<T> { Title = it.Substring(comma + 1), Width = w });
        }
        this.SyncDescs();
        this.st.dirty = true;
    }

    public string PreviewColumnsText() {
        string outp = "";
        for (int i = 0; i < this.gcols.Count; i = i + 1) {
            DataColumn d = this.gcols[i].desc;
            if (i > 0) { outp = outp + "|"; }
            outp = outp + Convert.ToString(d.width) + "," + d.title;
        }
        return outp;
    }

    public override string GetExtra(string key) {
        if (key == "of") { return this.of != null ? this.of : ""; }
        if (key == "rowFactory") { return PropSpec.Flag(this.source != null && this.source.factory != null); }
        if (key == "previewColumns") { return this.PreviewColumnsText(); }
        if (key == "rowNumbers") { return PropSpec.Flag(this.st.showRowNum); }
        if (key == "selectable") { return PropSpec.Flag(this.st.showSelect); }
        if (key == "striped") { return PropSpec.Flag(this.st.striped); }
        if (key == "rowHeight") { return Convert.ToString(this.st.rowH); }
        if (key == "rowReorder") { return PropSpec.Flag(this.st.rowReorder); }
        if (key == "summary") { return PropSpec.Flag(this.st.showSummary); }
        if (key == "filterRow") { return PropSpec.Flag(this.st.showFilterRow); }
        if (key == "statusBar") { return PropSpec.Flag(this.st.showStatusBar); }
        if (key == "groupPanel") { return PropSpec.Flag(this.st.showGroupPanel); }
        if (key == "allowAddRow") { return PropSpec.Flag(this.st.allowAddRow); }
        return "";
    }

    public override bool SetExtra(string key, string val) {
        if (key == "of") { this.of = val; return true; }
        if (key == "rowFactory") {
            if (PropSpec.IsOn(val) && this.source.factory == null) {
                this.defaultFactory = true;
                this.source.factory = () => {
                    TypeInfo ti = typeof(T);
                    if (ti.Name != "string" && ti.Name != "object") {
                        try {
                            object inst = ti.CreateInstance();
                            if (inst != null) { return (T)inst; }
                        } catch (Exception _ex) {
                        }
                    }
                    return null;
                };
            }
            return true;
        }
        if (key == "columns") {
            if (val.Length > 0 && val[0] == 91) {
                this.SetColumnsJson(val);
                return true;
            }
            return false;
        }
        if (key == "previewColumns") { this.SetPreviewColumns(val); return true; }
        if (key == "rowNumbers") { this.st.showRowNum = PropSpec.IsOn(val); return true; }
        if (key == "selectable") { this.st.showSelect = PropSpec.IsOn(val); return true; }
        if (key == "striped") { this.st.striped = PropSpec.IsOn(val); return true; }
        if (key == "rowHeight") { this.st.rowH = DataTable.ParseInt(val); return true; }
        if (key == "rowReorder") { this.st.rowReorder = PropSpec.IsOn(val); return true; }
        if (key == "summary") { this.st.showSummary = PropSpec.IsOn(val); return true; }
        if (key == "filterRow") { this.st.showFilterRow = PropSpec.IsOn(val); return true; }
        if (key == "statusBar") { this.st.showStatusBar = PropSpec.IsOn(val); return true; }
        if (key == "groupPanel") { this.st.showGroupPanel = PropSpec.IsOn(val); return true; }
        if (key == "allowAddRow") { this.st.allowAddRow = PropSpec.IsOn(val); return true; }
        return false;
    }

    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("RowClick");
        e.Add("RowContext");
        e.Add("RowRightClick");
        e.Add("RowDoubleClick");
        e.Add("CellClick");
        e.Add("CellDoubleClick");
        e.Add("CellDblClick");
        e.Add("CellEdit");
        e.Add("CellValidating");
        e.Add("SelectionChanged");
        e.Add("Sort");
        e.Add("HeaderClick");
        e.Add("ColumnClick");
        e.Add("FilterChanged");
        e.Add("ColumnResize");
        e.Add("ColumnResizeEnd");
        e.Add("ColumnReorder");
        e.Add("GroupChanged");
        e.Add("BandToggled");
        e.Add("RowInserted");
        e.Add("RowDeleted");
        e.Add("ScrollChanged");
        return e;
    }

    public string HitField() {
        int i = this.st.HitCol();
        if (i < 0 || i >= this.gcols.Count) { return ""; }
        return this.gcols[i].desc.FieldName();
    }

    public override void BindEvent(string evt, Action a) {
        if (evt == "RowClick") { this.st.RowClick.Add(a); return; }
        if (evt == "RowContext" || evt == "RowRightClick") { this.st.RowContext.Add(a); return; }
        if (evt == "RowDoubleClick") { this.st.RowDoubleClick.Add(a); return; }
        if (evt == "CellClick") { this.st.CellClick.Add(a); return; }
        if (evt == "CellDoubleClick" || evt == "CellDblClick") { this.st.CellDoubleClick.Add(a); return; }
        if (evt == "CellEdit") { this.st.CellEdit.Add(a); return; }
        if (evt == "CellValidating") { this.st.CellValidating.Add(a); return; }
        if (evt == "SelectionChanged") { this.st.SelectionChanged.Add(a); return; }
        if (evt == "Sort") { this.st.Sort.Add(a); return; }
        if (evt == "HeaderClick" || evt == "ColumnClick") { this.st.HeaderClick.Add(a); return; }
        if (evt == "FilterChanged") { this.st.FilterChanged.Add(a); return; }
        if (evt == "ColumnResize") { this.st.ColumnResize.Add(a); return; }
        if (evt == "ColumnResizeEnd") { this.st.ColumnResizeEnd.Add(a); return; }
        if (evt == "ColumnReorder") { this.st.ColumnReorder.Add(a); return; }
        if (evt == "GroupChanged") { this.st.GroupChanged.Add(a); return; }
        if (evt == "BandToggled") { this.st.BandToggled.Add(a); return; }
        if (evt == "RowInserted") { this.st.RowInserted.Add(a); return; }
        if (evt == "RowDeleted") { this.st.RowDeleted.Add(a); return; }
        if (evt == "ScrollChanged") { this.st.ScrollChanged.Add(a); return; }
        base.BindEvent(evt, a);
    }

    public override void BindEventS(string evt, ControlEvent a) {
        if (evt == "RowClick") { this.st.RowClick.Add(() => a(this)); return; }
        if (evt == "RowContext" || evt == "RowRightClick") { this.st.RowContext.Add(() => a(this)); return; }
        if (evt == "RowDoubleClick") { this.st.RowDoubleClick.Add(() => a(this)); return; }
