        if (evt == "GroupChanged") { this.st.GroupChanged.Add(a); return; }
        if (evt == "BandToggled") { this.st.BandToggled.Add(a); return; }
        if (evt == "RowInserted") { this.st.RowInserted.Add(a); return; }
        if (evt == "RowDeleted") { this.st.RowDeleted.Add(a); return; }
        if (evt == "ScrollChanged") { this.st.ScrollChanged.Add(a); return; }
        On.AddByName(evt, a);
    }

    // <see cref="BindEvent"/> 的 sender 通道（S = Sender）：
    // 表格专属事件将自身（Control 句柄）封包给带参回调；通用事件按名路由。
    public override void BindEventS(string evt, ControlEvent a) {
        if (evt == "RowClick") { this.st.RowClick.Add(() => a(this)); return; }
        if (evt == "RowContext" || evt == "RowRightClick") { this.st.RowContext.Add(() => a(this)); return; }
