        if (evt == "SelectionChanged") { this.st.SelectionChanged.Add(() => a(this)); return; }
        if (evt == "Sort") { this.st.Sort.Add(() => a(this)); return; }
        if (evt == "HeaderClick" || evt == "ColumnClick") { this.st.HeaderClick.Add(() => a(this)); return; }
        if (evt == "FilterChanged") { this.st.FilterChanged.Add(() => a(this)); return; }
