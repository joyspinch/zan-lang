using System.Collections.Generic;
using System;
using System.Json;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// 绑定到调用方自身实体列表的数据网格，形式与
// `ListView<T>` / `Dropdown<T>` 一致——用访问器声明列，传入数据，
// 布局、存储或单元格字符串等细节不会泄漏到
// 调用处：
// ```zan
// grid.Bind(users);          // 调用方的 List<User>，每帧读取
// side.Add(grid);
// ```
// 底层驱动完整的 DataTable 引擎（可排序 / 可筛选 /
// 可分组 / 可编辑 / 虚拟化），泛型前端不损失任何
// 能力——可通过 `DataGrid.State()` 访问原始
// `DataTableState`。
public class DataGrid<T> : Control {
    public List<GridColumn<T>> gcols;
    public List<T> data;
    public DataTableState st;
    public GridSource<T> source;
    // 每帧交给引擎的 `List<DataColumn>`，与
    // `gcols` 保持同步，使构造后新增的列也能显示。
    public List<DataColumn> descs;
    // 上一次 Bind 时的行数（-1 = 还没绑过）：行数变了必须让引擎重算行号集合。
    public int boundN;
    // 设计稿契约类型名（如 ContractRow / User），供设计器属性协议与运行时投影识别。
    public string of;
    public bool defaultFactory;
    private DataTableVisualTree visualTree;

    public void InitGrid() {
        this.InitControl("datatable", 5);
        this.of = "";
        this.defaultFactory = false;
        this.gcols = new List<GridColumn<T>>();
        this.data = null;
        this.st = new DataTableState();
        this.st.host = this;
        this.source = new GridSource<T>();
        this.source.cols = this.gcols;
        this.source.data = null;
        this.source.factory = null;
        this.source.key = null;
        this.descs = new List<DataColumn>();
        this.boundN = 0 - 1;
        // 引擎自行完成整个网格的命中测试 / 绘制，
        // 因此基类控件不能再注册命中区域或绘制表面。
        this.wiresOwnEvents = true;
    }

    public DataGrid() { this.InitGrid(); }

    public override string StyleType() { return "datatable"; }

    public override bool ChildControlsRenderedByOwner() { return true; }

    public override void Arrange(int x, int y, int w, int h) {
        this.bx = x; this.by = y; this.bw = w > 0 ? w : 0; this.bh = h > 0 ? h : 0;
        this.SyncDescs();
        if (this.visualTree == null) { this.visualTree = new DataTableVisualTree(this); }
        this.visualTree.Prepare(this.App, this.descs, this.source, this.st);
    }

    public override bool AcceptsRetainedLongPress() { return true; }
    public override int InputFocusCapabilities() { return 3; }

    public override void OnRoutedEvent(RoutedEventArgs e) {
        if (e.eventName != "PointerCancel") { this.PrepareInputTree(); }
        if (this.visualTree != null) { this.visualTree.RouteBody(e); }
        if (!e.handled) { base.OnRoutedEvent(e); }
    }

    public override void OnPreviewRoutedEvent(RoutedEventArgs e) {
        if (e.eventName == "PointerCancel") { base.OnPreviewRoutedEvent(e); return; }
        this.PrepareInputTree();
        if (this.visualTree != null && this.visualTree.RouteMenuEvent(e)) { return; }
        base.OnPreviewRoutedEvent(e);
    }

    public override bool ChildInViewport(Control child) {
        return this.visualTree != null && this.visualTree.ContainsPrepared(this.st, child);
    }

    protected override Control HitTestCore(int x, int y, int pointerType, List<Control> excludedSubtrees) {
        this.PrepareInputTree();
        Control hit = base.HitTestCore(x, y, pointerType, excludedSubtrees);
        return this.visualTree != null ? this.visualTree.ClipHit(hit, x, y) : hit;
    }

    private void PrepareInputTree() {
        this.SyncDescs();
        if (this.visualTree == null || this.visualTree.NeedsPrepare(this.descs, this.source, this.st)) {
            this.Arrange(this.bx, this.by, this.bw, this.bh);
        }
    }

    public override void CollectInputFocus(App app, List<Control> controls) {
        this.PrepareInputTree();
        base.CollectInputFocus(app, controls);
    }

    public override Control FindInputFocus(App app) {
        this.PrepareInputTree();
        return base.FindInputFocus(app);
    }

    // ---- 数据 ---------------------------------------------------------------

    // 绑定调用方的列表。不复制——网格每帧读取，
    // 修改列表会在下一次绘制时生效。
    public DataGrid<T> Bind(List<T> src) {
        int n = 0;
        if (src != null) { n = src.Count; }
        bool changed = this.data != src;
        // 换了列表、或者行数变了：引擎里的行号集合（st.order）还是上一份数据
        // 的，不重算就会拿越界行号去取单元格。
        if (this.data != src || n != this.boundN) {
            DataTable.InvalidateData(this.st);
        }
        this.data = src;
        this.source.data = src;
        this.boundN = n;
        if (this.defaultFactory || (this.st.allowAddRow && this.source.factory == null)) {
            this.defaultFactory = true;
            this.source.factory = () => {
                TypeInfo ti = typeof(T);
                if (ti.Name != "string" && ti.Name != "object") {
                    try {
                        object inst = ti.CreateInstance();
                        if (inst != null) { return (T)inst; }
                    } catch (Exception _ex) {
                        // 动态实例化失败（无无参构造函数或安全拦截）时回退到 null
                    }
                }
                return null;
            };
        }
        // Cancellation observes the committed binding and may supersede it.
        if (changed && this.visualTree != null) { this.visualTree.Retire(this.st); }
        return this;
    }

    // 绑定实体的稳定键。key 参与选择、详情、排序平局和后续远程事务；
    // 未设置时仍保留旧的临时位置键行为。
    public DataGrid<T> KeyBy(GridKey<T> provider) {
        this.source.key = provider;
        this.st.expandedByKey = provider != null;
        this.st.expandedRows.Clear();
        this.st.expandedKeys.Clear();
        DataTable.InvalidateData(this.st);
        return this;
    }

    // 数据对象字段被原地修改、但列表引用和行数不变时调用，
    // 使排序、筛选、汇总和条件格式重新读取实体。
    public DataGrid<T> Refresh() {
        DataTable.Refresh(this.st, this.source);
        return this;
    }

    public int Count() {
        if (this.data == null) { return 0; }
        return this.data.Count;
    }

    // 实时的 `DataTableState`，用于链式方法未覆盖的
    // 高级配置（自定义 `CellStyler`、主从详情 provider、绑定），
    // 以及在处理器中读取交互上下文（HitRow / HitCol / …）。
    public DataTableState State() { return this.st; }

    // ---- 列 ------------------------------------------------------------

    public GridColumn<T> Add(GridColumn<T> col) {
        this.gcols.Add(col);
        DataTable.InvalidateView(this.st);
        return col;
    }

    // 纯文本列。
    public GridColumn<T> Col(string title, int width, GridText<T> read) {
        GridColumn<T> c = new GridColumn<T>(DataColumn.Text(title, width));
        c.text = read;
        return this.Add(c);
    }

    // 整数列：右对齐，按值排序与合计。
    public GridColumn<T> NumCol(string title, int width, GridInt<T> read) {
        GridColumn<T> c = new GridColumn<T>(DataColumn.Numeric(title, width));
        c.num = read;
        return this.Add(c);
    }

    // 组件列：`read` 从实体取数值序列（如 `u => u.weekPlan`），
    // `compId` 指定内置组件适配器（"bandgrid"）。值经序列化进
    // 引擎文本路径（导出/排序口径不变），渲染层灌进池化真控件。
    // 链式 `.Shape(r,c)` 声明矩阵形状、`.Heat("teal")` 声明色带。
    public GridColumn<T> CompCol(string title, int width, string compId, GridNums<T> read) {
        GridColumn<T> c = new GridColumn<T>(DataColumn.CompCol(title, width, compId));
        c.nums = read;
        return this.Add(c);
    }

    // 组件列（字符串值形态）：`read` 从实体取原始单元格文本
    // （"true"/"1"/"3"/"已发布"……），`compId` 指定组件适配器
    // （"switch"/"checkbox"/"rate"/"select"/"buttons"，或自注册的
    // CellComp）。控件改动走编辑通道写回，需要可回写访问器。
    // 链式 `.Options("A,B,C")` 给 select/buttons 选项、
    // `.Shape(0,N)` 给 rate 显数。
    public GridColumn<T> WidgetCol(string title, int width, string compId, GridText<T> read) {
        GridColumn<T> c = new GridColumn<T>(DataColumn.WidgetCol(title, width, compId));
        c.text = read;
        return this.Add(c);
    }

    // 保留 `decimals` 位小数的数值列。
    public GridColumn<T> RealCol(string title, int width, int decimals, GridReal<T> read) {
        GridColumn<T> c = new GridColumn<T>(DataColumn.Real(title, width, decimals));
        c.real = read;
        return this.Add(c);
    }
    // 复选框 / 布尔列。
    public GridColumn<T> BoolCol(string title, int width, GridBool<T> read) {
        GridColumn<T> c = new GridColumn<T>(DataColumn.Bool(title, width));
        c.truth = read;
        return this.Add(c);
    }

    // 日期列；`order` 指定存储文本的字段顺序
    // （0 y-m-d，1 d-m-y，2 m-d-y）。
    public GridColumn<T> DateCol(string title, int width, int order, GridText<T> read) {
        GridColumn<T> c = new GridColumn<T>(DataColumn.AsDate(new DataColumn(title, width), order));
        c.text = read;
        return this.Add(c);
    }

    // 图片列：读取器返回文件路径 / `mem:` key / http(s) URL，
    // 单元格内 contain 缩放居中；URL 由 ImageHttp 后台取回。
    public GridColumn<T> ImageCol(string title, int width, GridText<T> read) {
        GridColumn<T> c = new GridColumn<T>(DataColumn.ImageCol(title, width));
        c.text = read;
        return this.Add(c);
    }

    // 图标列：读取器返回 tabler 图标名，居中绘制。
    public GridColumn<T> IconCol(string title, int width, GridText<T> read) {
        GridColumn<T> c = new GridColumn<T>(DataColumn.IconCol(title, width));
        c.text = read;
        return this.Add(c);
    }

    // 按钮列：读取器返回按钮标签（空串时用 `icon` 画图标
    // 按钮）；点击触发 OnCellClick，处理器从 State() 读
    // HitRow()/HitCol() 得到本格位置。
    public GridColumn<T> ButtonCol(string title, int width, string icon, string cls, GridText<T> read) {
        GridColumn<T> c = new GridColumn<T>(DataColumn.ButtonCol(title, width, icon, cls));
        c.text = read;
        return this.Add(c);
    }

    // 迷你图列：读取器返回逗号分隔数值序列（"12,18,9,24"），
    // 格内画 accent 色迷你柱状图；`area` 叠加半透明面积。
    public GridColumn<T> SparklineCol(string title, int width, bool area, GridText<T> read) {
        GridColumn<T> c = new GridColumn<T>(DataColumn.SparklineCol(title, width, area));
        c.text = read;
        return this.Add(c);
    }

    // ---- 外观开关（转发给 state）------------------------

    public DataGrid<T> RowNumbers(bool on) { this.st.showRowNum = on; return this; }
    public DataGrid<T> Selectable(bool on) { this.st.showSelect = on; return this; }
    public DataGrid<T> Striped(bool on) { this.st.striped = on; return this; }
    // 行高（逻辑像素）；0 = 沿用主题高度。用于贴近
    // WinForms/DevExpress 那种高信息密度的紧凑表格。
    public DataGrid<T> RowHeight(int px) { this.st.rowH = px; return this; }
    // 允许用行号右侧的手柄拖动重排行（默认关闭）。
    public DataGrid<T> RowReorder(bool on) { this.st.rowReorder = on; return this; }
    public DataGrid<T> Summary(bool on) { this.st.showSummary = on; return this; }
    public DataGrid<T> FilterRow(bool on) { this.st.showFilterRow = on; return this; }
    public DataGrid<T> StatusBar(bool on) { this.st.showStatusBar = on; return this; }
    public DataGrid<T> GroupPanel(bool on) { this.st.showGroupPanel = on; return this; }
    public DataGrid<T> ExternalRowMenu(bool on) {
        this.st.externalRowMenu = on;
        return this;
    }
    // 在末行下方显示"点击添加"占位符，并启用
    // 右键菜单的插入/删除命令。命令仅在安装行
    // 工厂后生效——见 RowFactory。
    public DataGrid<T> AllowAddRow(bool on) { this.st.allowAddRow = on; return this; }

    // 按字段名显示/隐藏列（列的 `Field`；声明式列由生成器自动
    // 写入 "field"）。多个业务共用一份列并集、装配时按业务裁掉
    // 不适用的列就靠它。未知字段：空操作。
    public DataGrid<T> HideCol(string field, bool hidden) {
        this.SyncDescs();
        DataTable.EnsureInit(this.st, this.descs, this.source);
        DataTable.HideField(this.st, this.descs, field, hidden);
        return this;
    }

    // 打开/关闭列选择器弹层（勾选列表控制各列显隐、
    // 搜索框过滤、行内按钮重排）。常与 GroupPanel(true)
    // 搭配使用——面板右缘有常驻 "Columns" 按钮；
    // 也可以在任意事件处理器里调本方法弹出。
    public DataGrid<T> ColumnChooser(bool open) {
        DataTable.SetColumnChooser(this.st, open);
        return this;
    }

    // 列选择器弹层当前是否打开。
    public bool IsColumnChooserOpen() {
        return DataTable.IsColumnChooserOpen(this.st);
    }

    // 为数据源提供构建空白实体的工厂，以启用行插入/删除：
    // 没有工厂时泛型前端无法构造 `T`，网格将
    // 无论 AllowAddRow 如何设置都保持固定行数。
    public DataGrid<T> RowFactory(GridNew<T> f) {
        this.source.factory = f;
        this.defaultFactory = false;
        return this;
    }

    // ---- 事件处理器 -----------------------------------------------------------
    // state 是事件发送者；处理器从 State() 读取上下文
    // （HitRow / HitCol / EditRow / EditValue / …），与引擎模型一致。

    public DataGrid<T> OnRowClick(Action a) { this.st.RowClick.Add(a); return this; }
    public DataGrid<T> OnRowContext(Action a) { this.st.RowContext.Add(a); return this; }
    public DataGrid<T> OnRowRightClick(Action a) { this.st.RowContext.Add(a); return this; }
    public DataGrid<T> OnRowDoubleClick(Action a) { this.st.RowDoubleClick.Add(a); return this; }
    public DataGrid<T> OnCellClick(Action a) { this.st.CellClick.Add(a); return this; }
    public DataGrid<T> OnCellDoubleClick(Action a) { this.st.CellDoubleClick.Add(a); return this; }
    public DataGrid<T> OnCellEdit(Action a) { this.st.CellEdit.Add(a); return this; }
    public DataGrid<T> OnCellValidating(Action a) { this.st.CellValidating.Add(a); return this; }
    public DataGrid<T> OnSelectionChanged(Action a) { this.st.SelectionChanged.Add(a); return this; }
    public DataGrid<T> OnSort(Action a) { this.st.Sort.Add(a); return this; }
    public DataGrid<T> OnHeaderClick(Action a) { this.st.HeaderClick.Add(a); return this; }
    public DataGrid<T> OnColumnClick(Action a) { this.st.HeaderClick.Add(a); return this; }
    public DataGrid<T> OnFilterChanged(Action a) { this.st.FilterChanged.Add(a); return this; }
    public DataGrid<T> OnColumnResize(Action a) { this.st.ColumnResize.Add(a); return this; }
    public DataGrid<T> OnColumnResizeEnd(Action a) { this.st.ColumnResizeEnd.Add(a); return this; }
    public DataGrid<T> OnColumnReorder(Action a) { this.st.ColumnReorder.Add(a); return this; }
    public DataGrid<T> OnGroupChanged(Action a) { this.st.GroupChanged.Add(a); return this; }
    public DataGrid<T> OnBandToggled(Action a) { this.st.BandToggled.Add(a); return this; }
    public DataGrid<T> OnRowInserted(Action a) { this.st.RowInserted.Add(a); return this; }
    public DataGrid<T> OnRowDeleted(Action a) { this.st.RowDeleted.Add(a); return this; }
    public DataGrid<T> OnScrollChanged(Action a) { this.st.ScrollChanged.Add(a); return this; }

    // ---- 企业级功能链式配置 (对标 AG Grid Enterprise & DevExpress GridControl) ----

    public DataGrid<T> ContextMenu(ContextMenuFunc fn) {
        DataTable.SetContextMenuFunc(this.st, fn);
        return this;
    }

    public DataGrid<T> RowStyle(RowStyleFunc fn) {
        DataTable.SetRowStyleFunc(this.st, fn);
        return this;
    }

    public DataGrid<T> ShowSelectionSummary(bool on) {
        DataTable.SetShowSelectionSummary(this.st, on);
        return this;
    }

    public DataGrid<T> SizeColumnsToFit(int viewWidth) {
        this.SyncDescs();
        DataTable.SizeColumnsToFit(this.st, this.descs, viewWidth);
        return this;
    }

    // 为指定列开启相邻相同值自动垂直合并（对标 DevExpress AllowCellMerge）
    public DataGrid<T> AutoMergeColumn(int colIndex) {
        if (this.st.spanProvider == null || !(this.st.spanProvider is AutoCellSpanModel)) {
            this.st.spanProvider = new AutoCellSpanModel();
        }
        AutoCellSpanModel autoModel = (AutoCellSpanModel)this.st.spanProvider;
        autoModel.AddColumn(colIndex);
        return this;
    }

    public DataGrid<T> AutoMergeColumn(string field) {
        this.SyncDescs();
        int ci = DataTable.Col(this.descs, field);
        if (ci >= 0) {
            this.AutoMergeColumn(ci);
        }
        return this;
    }

    // 设置单元格跨行跨列合并模型
    public DataGrid<T> SpanModel(CellSpanProvider model) {
        this.st.spanProvider = model;
        return this;
    }

    // 设置主从明细提供器（支持 TabbedDetailProvider / ControlDetailProvider 等）
    public DataGrid<T> Detail(DetailProvider provider) {
        DataTable.SetDetail(this.st, provider);
        return this;
    }

    // 采用通用 MessagePack 国际标准二进制保存表格布局（消灭 JSON 冗余与 GC）
    public byte[] SaveLayoutMsgPack() {
        this.SyncDescs();
        return DataTable.SaveLayoutMsgPack(this.st, this.descs);
    }

    public bool LoadLayoutMsgPack(byte[] bytes) {
        this.SyncDescs();
        return DataTable.LoadLayoutMsgPack(this.st, this.descs, bytes);
    }

    // 保存为紧凑单行令牌（单行 Base64，适合存数据库字段或用户偏好配置文件）
    public string SaveLayoutToken() {
        this.SyncDescs();
        return DataTable.SaveLayoutToken(this.st, this.descs);
    }

    public bool LoadLayoutToken(string token) {
        this.SyncDescs();
        return DataTable.LoadLayoutToken(this.st, this.descs, token);
    }

    // 根据当前列刷新引擎的描述符列表。描述符
    // 按引用共享，配置器的原地修改
    // 立即可见；此处仅在新增列时重新同步列表长度，
    // 以匹配列数。
    public void SyncDescs() {
        if (this.descs.Count == this.gcols.Count) { return; }
        this.descs = new List<DataColumn>();
        for (int i = 0; i < this.gcols.Count; i = i + 1) {
            this.descs.Add(this.gcols[i].desc);
        }
    }

    // ---- 保留事件钩子 -----------------------------------------------------

    public override void OnMeasure(App app) {
        this.prefW = app.Scale(360);
        this.prefH = app.Scale(240);
    }

    public override void OnPaint(App app) {
        if (this.visualTree != null) { this.visualTree.Render(app, this.descs, this.source, this.st); }
    }

    // 声明式契约：外观开关落在引擎 state 上，经下面的转发属性绑定。
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Bool("rowNumbers", "Row numbers").Field("ShowRowNumbers").WithTip("Show the row number gutter."));
        ps.Add(PropSpec.Bool("selectable", "Selectable").Field("ShowSelection").WithTip("Show the selection checkbox column."));
        ps.Add(PropSpec.Bool("striped", "Striped").Field("ShowStripes").WithTip("Alternate row background stripes."));
        ps.Add(PropSpec.Int("rowHeight", "Row height").Field("RowHeightPx")
            .WithTip("Row height in logical pixels; 0 uses the theme height."));
        ps.Add(PropSpec.Bool("rowReorder", "Row reorder").Field("AllowRowReorder")
            .WithTip("Drag the row-number handle to reorder rows."));
        ps.Add(PropSpec.Bool("summary", "Summary row").Field("ShowSummary").WithTip("Show the aggregate summary row."));
        ps.Add(PropSpec.Bool("filterRow", "Filter row").Field("ShowFilterRow").WithTip("Show the per-column filter row."));
        ps.Add(PropSpec.Bool("statusBar", "Status bar").Field("ShowStatusBar").WithTip("Show the status bar under the grid."));
        ps.Add(PropSpec.Bool("groupPanel", "Group panel").Field("ShowGroupPanel")
            .WithTip("Show the drag-to-group panel above the header."));
        ps.Add(PropSpec.Bool("allowAddRow", "Allow add row").Field("ShowAddRow")
            .WithTip("Show the add-row placeholder; needs a row factory."));
        ps.Add(PropSpec.Text("of", "Row Type").Field("of").WithTip("Entity type contract name for typed rows."));
        ps.Add(PropSpec.Bool("rowFactory", "Row Factory").Field("UseRowFactory")
            .WithTip("Enable row insertion/deletion with a row factory."));
        ps.Add(PropSpec.Text("previewColumns", "Preview columns").Accessor("PreviewColumnsText", "SetPreviewColumns"));
        ps.Add(PropSpec.Text("columns", "Columns (JSON)").Accessor("ColumnsJsonText", "SetColumnsJsonText"));
        return ps;
    }

    // 网格外观开关：引擎 state 持有，这里以属性公开给属性协议（设计器 / HTML）。
    public bool ShowRowNumbers { get { return this.st.showRowNum; } set { this.st.showRowNum = value; } }
    public bool ShowSelection { get { return this.st.showSelect; } set { this.st.showSelect = value; } }
    public bool ShowStripes { get { return this.st.striped; } set { this.st.striped = value; } }
    public int RowHeightPx { get { return this.st.rowH; } set { this.st.rowH = value; } }
    public bool AllowRowReorder { get { return this.st.rowReorder; } set { this.st.rowReorder = value; } }
    public bool ShowSummary { get { return this.st.showSummary; } set { this.st.showSummary = value; } }
    public bool ShowFilterRow { get { return this.st.showFilterRow; } set { this.st.showFilterRow = value; } }
    public bool ShowStatusBar { get { return this.st.showStatusBar; } set { this.st.showStatusBar = value; } }
    public bool ShowGroupPanel { get { return this.st.showGroupPanel; } set { this.st.showGroupPanel = value; } }
    public bool ShowAddRow { get { return this.st.allowAddRow; } set { this.st.allowAddRow = value; } }

    // 行工厂：开启时为 T 装默认构造工厂（插入 / 删除行需要）；关闭不卸载已有工厂。
    public bool UseRowFactory {
        get { return this.source != null && this.source.factory != null; }
        set {
            if (!value || this.source.factory != null) { return; }
            this.defaultFactory = true;
            this.source.factory = () => {
                TypeInfo ti = typeof(T);
                if (ti.Name != "string" && ti.Name != "object") {
                    try {
                        object inst = ti.CreateInstance();
                        if (inst != null) { return (T)inst; }
                    } catch (Exception _ex) {
                    }
                }
                return null;
            };
        }
    }

    // columns 只写：JSON 数组形态的列定义（其余形态忽略）。
    public string ColumnsJsonText() { return ""; }
    public void SetColumnsJsonText(string val) {
        if (val.Length > 0 && val[0] == 91) { this.SetColumnsJson(val); }
    }

    // 运行期通道解析设计稿 data-x-columns JSON 数组，构建真正的 DataColumn 模型并保留完整元数据。
    public void SetColumnsJson(string json) {
        JsonValue cols = null;
        try { cols = JsonValue.Parse(json); } catch (Exception ex) { cols = null; }
        if (cols == null || !cols.IsArray()) { return; }
        this.gcols.Clear();
        for (int i = 0; i < cols.Count(); i = i + 1) {
            JsonValue c = cols.At(i);
            if (c == null || !c.IsObject()) { continue; }
            string field = c.Str("field", "");
            string title = c.Str("title", field != "" ? field : "Col" + Convert.ToString(i + 1));
            int width = c.Int("width", 100);
            if (width <= 0) { width = 100; }
            string ctype = c.Str("type", "");
            GridColumn<T> gc = null;
            if (ctype == "num") {
                gc = new GridColumn<T>(DataColumn.Numeric(title, width));
            } else if (ctype == "real") {
                int dec = c.Int("decimals", 2);
                gc = new GridColumn<T>(DataColumn.Real(title, width, dec));
            } else if (ctype == "bool") {
                gc = new GridColumn<T>(DataColumn.Bool(title, width));
            } else if (ctype == "date") {
                int order = c.Int("dateOrder", 0);
                gc = new GridColumn<T>(DataColumn.AsDate(new DataColumn(title, width), order));
            } else {
                gc = new GridColumn<T>(DataColumn.Text(title, width));
            }
            if (field != "") { gc.Field(field); }
            string align = c.Str("align", "");
            if (align == "right") { gc.Right(); }
            else if (align == "center") { gc.Center(); }
            string money = c.Str("money", "");
            if (money != "") { gc.Money(money); }
            if (c.Bool("percent", false)) { gc.Percent(); }
            string prefix = c.Str("prefix", "");
            string suffix = c.Str("suffix", "");
            if (prefix != "" || suffix != "") { gc.Affix(prefix, suffix); }
            if (c.Bool("sum", false)) { gc.Sum(); }
            if (c.Bool("avg", false)) { gc.Avg(); }
            if (c.Bool("min", false)) { gc.Min(); }
            if (c.Bool("max", false)) { gc.Max(); }
            if (c.Bool("count", false)) { gc.Count(); }
            string pin = c.Str("pin", "");
            if (pin == "left") { gc.Pin(); }
            else if (pin == "right") { gc.PinRight(); }
            string band = c.Str("band", "");
            if (band != "") { gc.Band(band); }
            JsonValue sortable = c.Get("sortable");
            if (sortable != null && sortable.IsBool() && !sortable.AsBool(true)) {
                gc.NotSortable();
            }
            if (c.Bool("editable", false)) { gc.desc.Editable(); }
            this.gcols.Add(gc);
        }
        this.SyncDescs();
        this.st.dirty = true;
    }

    // 运行期/设计器预览的列头:`"宽,标题|宽,标题"`。工厂只能造
    // `DataGrid<string>`,拿不到实体类型,所以预览只铺列头不铺行;
    // 真正的类型化列由挂载时的声明式列绑定展开成泛型列 API。
    public void SetPreviewColumns(string spec) {
        List<string> parts = spec.Split("|");
        for (int i = 0; i < parts.Count; i = i + 1) {
            string it = parts[i];
            if (it.Length == 0) { continue; }
            int comma = it.IndexOf(",");
            if (comma < 0) {
                this.Col(it, 100, null);
                continue;
            }
            int w = DataTable.ParseInt(it.Substring(0, comma));
            if (w <= 0) { w = 100; }
            this.Col(it.Substring(comma + 1), w, null);
        }
        this.st.dirty = true;
    }

    public string PreviewColumnsText() {
        string outp = "";
        for (int i = 0; i < this.gcols.Count; i = i + 1) {
            DataColumn d = this.gcols[i].desc;
            if (i > 0) { outp = outp + "|"; }
            outp = outp + Convert.ToString(d.width) + "," + d.title;
        }
        return outp;
    }

    // 最近一次命中的数据字段名（CellClick/ColumnResize 等事件
// 的 HitCol 翻译成稳定 field 名；越界/未命名列返回 ""）。
// 声明式列级事件（columns[i].click）按它分派，
// 列重排不影响路由。
public string HitField() {
    int i = this.st.HitCol();
    if (i < 0 || i >= this.gcols.Count) { return ""; }
    return this.gcols[i].desc.FieldName();
}

// 表格语义事件：引擎 state 持有事件对象（state.host = 本网格作为 sender），
// 这里以 [Event] 属性公开给按名接线（HTML/设计器）与设计器事件列表。
[Event]
public UiEvent RowClick { get { return this.st.RowClick; } }
[Event(Alias = "RowRightClick")]
public UiEvent RowContext { get { return this.st.RowContext; } }
[Event]
public UiEvent RowDoubleClick { get { return this.st.RowDoubleClick; } }
[Event]
public UiEvent CellClick { get { return this.st.CellClick; } }
[Event(Alias = "CellDblClick")]
public UiEvent CellDoubleClick { get { return this.st.CellDoubleClick; } }
[Event]
public UiEvent CellEdit { get { return this.st.CellEdit; } }
[Event]
public UiEvent CellValidating { get { return this.st.CellValidating; } }
[Event]
public UiEvent SelectionChanged { get { return this.st.SelectionChanged; } }
[Event]
public UiEvent Sort { get { return this.st.Sort; } }
[Event(Alias = "ColumnClick")]
public UiEvent HeaderClick { get { return this.st.HeaderClick; } }
[Event]
public UiEvent FilterChanged { get { return this.st.FilterChanged; } }
[Event]
public UiEvent ColumnResize { get { return this.st.ColumnResize; } }
[Event]
public UiEvent ColumnResizeEnd { get { return this.st.ColumnResizeEnd; } }
[Event]
public UiEvent ColumnReorder { get { return this.st.ColumnReorder; } }
[Event]
public UiEvent GroupChanged { get { return this.st.GroupChanged; } }
[Event]
public UiEvent BandToggled { get { return this.st.BandToggled; } }
[Event]
public UiEvent RowInserted { get { return this.st.RowInserted; } }
[Event]
public UiEvent RowDeleted { get { return this.st.RowDeleted; } }
[Event]
public UiEvent ScrollChanged { get { return this.st.ScrollChanged; } }
}
