using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// DataTable 导出进度弹层：ExportToXlsxAsyncUi / ExportToCsvAsyncUi
// 启动后台导出时在表格上叠一个居中模态卡片——进度条 + 百分比 +
// 行数计数，运行中可取消，结束给出结果与关闭按钮。
// `DataTableExportUi` 是弹层的全部状态，挂在 <c>st.exportUi</c>，
// 只在 UI 线程读写。后台写盘线程不触碰它：进度回调只写
// <see cref="DataTableUiExportProgress"/> 的静态暂存，渲染循环
// 每帧开头经 <see cref="DataTableUiExportProgress.SyncUi"/> 拉取
// 同步——与画廊此前手搓的静态镜像同纪律，只是收进了组件。
// <c>cancel</c> 是唯一的反向通道：UI 线程写、写盘线程每行询问。
class DataTableExportUi {
    public bool visible;  // 弹层显示中（运行中，或完成待关闭）
    public bool finished;  // 写盘已结束（ok/message 有效）
    public bool ok;  // finished 时的结果
    public string message;  // 失败/取消原因（ok 时为空）
    public string path;  // 目标文件路径
    public int done;  // 已完成行数
    public int total;  // 总行数（含表头行，OnStart 给出）
    public App app;  // 宿主应用（进度推进时请求重绘）
    public AtomicInt cancel = new AtomicInt(0);
}

// 内置进度实现：后台回调只写静态暂存，UI 线程每帧拉取。
// 进程内同一时刻至多一个导出（Export.zan 的 sExportBusy 原子门），
// 静态槽因此安全。
class DataTableUiExportProgress : DataTableExportProgress {
    // 当前弹层状态（包装入口 Bind；Cancelled 在后台线程读取）。
    public static DataTableExportUi ui;
    static int sDone;
    static int sTotal;
    static bool sOk;
    static string sMsg;
    static bool sFinished;

    // 包装入口在启动导出前登记状态对象并复位暂存。
    public static void Bind(DataTableExportUi target) {
        DataTableUiExportProgress.ui = target;
        DataTableUiExportProgress.sDone = 0;
        DataTableUiExportProgress.sTotal = 0;
        DataTableUiExportProgress.sOk = false;
        DataTableUiExportProgress.sMsg = "";
        DataTableUiExportProgress.sFinished = false;
    }

    public override void OnStart(int totalRows) {
        DataTableUiExportProgress.sDone = 0;
        DataTableUiExportProgress.sTotal = totalRows;
    }

    public override void OnProgress(int doneRows, int totalRows) {
        DataTableUiExportProgress.sDone = doneRows;
        DataTableUiExportProgress.sTotal = totalRows;
    }

    public override void OnDone(bool ok, string error) {
        DataTableUiExportProgress.sOk = ok;
        DataTableUiExportProgress.sMsg = error;
        DataTableUiExportProgress.sFinished = true;
    }

    public override bool Cancelled() {
        return DataTableUiExportProgress.ui != null
            && DataTableUiExportProgress.ui.cancel.Load() != 0;
    }

    // UI 线程：渲染弹层前把后台暂存拉取进弹层状态。完成态只在
    // 首次到达时提交（message/ok 不被后续帧改写）。
    public static void SyncUi() {
        DataTableExportUi u = DataTableUiExportProgress.ui;
        if (u == null) { return; }
        u.done = DataTableUiExportProgress.sDone;
        u.total = DataTableUiExportProgress.sTotal;
        if (DataTableUiExportProgress.sFinished && !u.finished) {
            u.finished = true;
            u.ok = DataTableUiExportProgress.sOk;
            u.message = DataTableUiExportProgress.sMsg;
        }
    }
}

partial class DataTable {
    // 异步导出 .xlsx 并显示进度弹层：经 sXlsxExportUi 槽（xlsx 写盘
    // 家族随真实导出调用才拉入）。CSV 入口是
    // 核心契约与执行状态转移规范。
    static bool ExportToXlsxAsyncUi(App app, DataTableState st, List<DataColumn> cols,
                                    DataSource src, string path, bool selectionOnly) {
        return DataTable.ExportAsyncUiImpl(app, st, cols, src, path, selectionOnly, 1);
    }

    // 异步导出 CSV 并显示进度弹层，语义同上。
    static bool ExportToCsvAsyncUi(App app, DataTableState st, List<DataColumn> cols,
                                   DataSource src, string path, bool selectionOnly) {
        return DataTable.ExportAsyncUiImpl(app, st, cols, src, path, selectionOnly, 2);
    }

    static bool ExportAsyncUiImpl(App app, DataTableState st, List<DataColumn> cols,
                                  DataSource src, string path, bool selectionOnly, int kind) {
        DataTableExportUi ui = new DataTableExportUi();
        ui.visible = true;
        ui.path = path;
        ui.app = app;
        st.exportUi = ui;
        DataTableUiExportProgress.Bind(ui);
        DataTableUiExportProgress prog = new DataTableUiExportProgress();
        bool started = kind == 1
            ? DataTable.RunXlsxExportUi(app, st, cols, src, path, selectionOnly)
            : DataTable.ExportToCsvAsync(st, cols, src, path, selectionOnly, prog);
        if (!started) {
            // 无可导内容：库不回调 OnDone，直接落失败态；已有导出
            // 在运行：库回调 OnDone(false, "已有导出在运行")，其
            // 暂存会被渲染前的 SyncUi 拉取，文案以它为准。
            ui.finished = true;
            ui.ok = false;
            ui.message = DataTable.T("Nothing to export", "没有可导出的内容");
        }
        app.RequestRedraw();
        return started;
    }
}
