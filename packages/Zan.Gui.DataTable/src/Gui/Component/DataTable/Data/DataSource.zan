using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// DataTable 的虚拟数据源（DevExpress 风格的 ValueNeeded）。
// 网格自身从不存储行——它按需为可见窗口拉取单元格，
// 并通过类型化键（`CellNum`）排序/聚合，无需
// 重新解析字符串。继承此类并用列式存储（每列
// 一个数组）支撑，可以远少于 `List<DataRow>`
// 字符串单元格的内存容纳数百万行，排序/汇总也无需
// 逐单元格解析字符串。
public class DataSource {
    // 源行数。
    public virtual int RowCount() { return 0; }
    // 单元格的显示文本（row = 源索引，col = 列索引）。
    public virtual string CellText(int row, int col) { return ""; }
    // 单元格的数值键，用于数值列的排序/聚合。
    // 非数值列返回 0。
    public virtual int CellNum(int row, int col) { return 0; }

    // 单元格的小数键，用于声明了 `decimals > 0` 的列。
    // 默认实现解析 CellText，现有数据源免费获得小数支持；
    // 当底层存储已持有 double 时重写它。
    public virtual double CellReal(int row, int col) {
        return DataTable.ParseReal(this.CellText(row, col));
    }

    // 日期列单元格的天数键（自 1970-01-01 起的天数）。
    // 默认实现按列声明的字段顺序解析 CellText，
    // 现有数据源免费获得日期支持；
    // 当底层存储已持有天数或时间戳时重写它。`order` 是
    // 列的 `dateOrder`；空单元格返回 `DataTable.NoDate()`。
    public virtual int CellDay(int row, int col, int order) {
        return DataTable.ParseDate(this.CellText(row, col), order);
    }

    // bool 列单元格的真值。默认实现解析 CellText，
    // 现有数据源免费获得复选框列；
    // 当底层存储已持有标志位时重写它。
    public virtual bool CellBool(int row, int col) {
        return DataTable.ParseBool(this.CellText(row, col));
    }

    // 稳定行键入口。旧数据源默认使用仅当前源实例
    // 有效的临时位置键；远程/领域源应重写为业务主键。
    public virtual RowKey GetRowKey(int row) {
        return RowKey.Legacy(row);
    }

    // 将单元格值写回底层数据（内联编辑）。
    // 只读数据源忽略写入。
    public virtual void SetCell(int row, int col, string v) { }

    // 该数据源支持 InsertRow / RemoveRow 时为 true。为 false 时
    // 网格隐藏添加/删除功能（以及新行占位符），
    // 只读或计算型数据源无需额外防护。
    public virtual bool CanInsert() { return false; }

    // 插入空行使其落在索引 `at`（`at == RowCount()`
    // 即追加）。实际插入时返回 true。
    public virtual bool InsertRow(int at) { return false; }

    // 移除 `at` 处的行。实际移除时返回 true。
    public virtual bool RemoveRow(int at) { return false; }

    // ---- 服务端 / 无限 / 视口协议 ----
    // 无法一次性交出全部数据集的源（远程
    // 数据库、文件流、计算结果）实现这五个钩子，
    // 而不是预加载所有行。网格无需改动即可工作：
    // 它拉取源声明存在的行，用户滚动时请求更多，
    // 并且只要服务器掌控顺序，就绝不在本地排序或过滤。
    // 参考实现见 ServerDataSource。

    // 数据源自行管理行顺序时为 true。网格随后跳过本地
    // 排序和过滤——传给 CellText/CellNum/... 的 `row` 索引
    // 已是源最终（服务器排序/过滤后）的顺序，
    // 显示顺序即服务器给出的顺序。本地分组和
    // 聚合仍然适用，作用于已加载的前缀。
    public virtual bool ServerControlled() { return false; }

    // 单元格所在行是否已获取、可读取。
    // 未就绪的行渲染为加载占位符而非空文本，
    // 网格调用 RequestBlock 拉取它们。默认为 true（本地
    // 源按定义总是完整的）。
    public virtual bool CellReady(int row, int col) { return true; }

    // 请求数据源获取包含 `row` 的数据块。可以每帧调用：
    // 实现必须合并重复/重叠的请求。
    public virtual void RequestBlock(int row) { }

    // 请求数据源获取当前已加载前缀之后的下一块
    // （滚动到底持续拉取，直到 HasMore() 变为 false）。
    // 与 RequestBlock(row) 不同：调用方不知道
    // 未获取区域从哪一行开始，所以它请求“下一块是什么”。
    public virtual void RequestNextBlock() { }

    // 数据源是否可能还有 RowCount() 之外的行。
    // 总数未知且仍在流式传输时为 true，
    // 用户滚动到底部时网格会请求下一块。
    public virtual bool HasMore() { return false; }

    // 每帧轮询。每次重绘前、重算前调用一次；
    // 有新数据到达（取回的数据块、服务器事务）时返回 true，
    // 网格标记自身为脏并重绘。无数据到达时
    // 开销极小且无副作用。
    public virtual bool Poll() { return false; }

    // 按稳定 RowKey 实时合并一批增量（upsert/remove/cell）。
    // 默认不支持：返回 null。支持按键定位的源（本地列表源、
    // 服务端缓存源）重写它；应用完成后源自行刷新页与缓存，
    // 网格经由 Poll 感知变化。见 DataTable.Realtime.zan。
    public virtual DeltaResult ApplyDeltas(DeltaBatch batch) { return null; }
}
