    // ---- 事件上下文访问器（方案 A：处理器读取 sender） ----
    public int HitRow() { return hitRow; }

    // 导出进度弹层是否显示中（模态：表体按下/滚轮/按键等
    // 事件路径据此抑制，弹层由 RenderExportUi 最后绘制并
    // 独占处理自己的按钮）。
    public bool ExportUiOpen() {
        return this.exportUi != null && this.exportUi.visible;
    }

    public int HitOrderIndex() { return hitOrder; }
    public int CtxRow() { return ctxRow; }
    public int CtxOrder() { return ctxOrder; }
    public int CtxCol() { return ctxCol; }
    public int CtxX() { return ctxX; }
    public int CtxY() { return ctxY; }
    public int HitCol() { return hitCol; }
    public int SortColIndex() { return sortCol; }
    public int SortDirection() { return sortDir; }
    public int ScrollTop() { return scrollRow; }
    public int EditRow() { return editRow; }
    public int EditCol() { return editCol; }
    public string EditValue() { return editVal; }

    // 返回当前全部选中行的源行索引，顺序与数据源索引一致。
    // 业务侧可在 RowContext 处理器中读取多选对象。
    public List<int> SelectedRowIndices() {
        List<int> rows = new List<int>();
        for (int i = 0; i < selected.Count; i = i + 1) {
            if (selected[i]) { rows.Add(i); }
        }
        return rows;
    }

    // 拒绝正在校验的值。在 `CellValidating` 处理器中调用：
    // 编辑器保持打开并在下方显示 `msg`，不会有写入
    // 到达数据源。
    public void Reject(string msg) {
        editRejected = true;
        editError = msg;
    }

    // 当前的拒绝信息（上次提交被接受时为“”）。
    public string EditError() { return editError; }
}
