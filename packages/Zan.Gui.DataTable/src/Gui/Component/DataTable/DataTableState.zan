        this.chartTitle = "";
        this.chartBars = new List<ChartBar>();
        this.chartMax = 1;
        this.exportUi = null;
        this.pivotView = false;
        this.pvRowCol = -1;
        this.pvColDim = -1;
        this.pvValueCol = -1;
        this.pvRowKeys = new List<string>();
        this.pvColKeys = new List<string>();
        this.pvCells = new List<double>();
        this.pvRowTot = new List<double>();
        this.pvCellSum = new List<double>();
        this.pvCellCnt = new List<int>();
        this.pvCellMx = new List<double>();
        this.pvCellMn = new List<double>();
        this.pvViewCols = new List<DataColumn>();
        this.pvInner = null;
        this.pvSource = null;
        this.pvDirty = false;
        this.pvOrigCols = 0;
        this.pvOrigColsList = null;
        this.pvSavedFilters = null;
        this.pvSavedFilterRowText = null;
        this.pvSavedGroupCols = null;
        this.pvSavedSortKeys = null;
        this.pvSavedSummary = false;
        this.pvRowTitle = "";
        this.pvColTitle = "";
        this.pvValTitle = "";
        this.pivotAgg = 0;
        this.transposeView = false;
        this.trViewCols = new List<DataColumn>();
        this.trSource = null;
        this.trInner = null;
        this.trOrigColsList = null;
        this.trOrigCols = 0;
        this.trRows = 0;
        this.trDirty = false;
        this.FilterChanged = new UiEvent();
        this.HeaderClick = new UiEvent();
        this.Sort = new UiEvent();
        this.RowClick = new UiEvent();
        this.RowContext = new UiEvent();
        this.RowDoubleClick = new UiEvent();
        this.CellClick = new UiEvent();
        this.CellDoubleClick = new UiEvent();
        this.CellEdit = new UiEvent();
        this.CellValidating = new UiEvent();
        this.SelectionChanged = new UiEvent();
        this.ColumnResize = new UiEvent();
        this.ColumnResizeEnd = new UiEvent();
        this.ScrollChanged = new UiEvent();
        this.GroupChanged = new UiEvent();
        this.ColumnReorder = new UiEvent();
        this.RowInserted = new UiEvent();
        this.RowDeleted = new UiEvent();
        this.BandToggled = new UiEvent();
        this.groupCols = new List<int>();
        this.collapsedKeys = new List<string>();
        this.treeAdapter = null;
        this.expandedTree = new List<bool>();
        this.treeCol = -1;
        this.treeLoading = new List<bool>();
        this.filterTree = null;
        this.showGroupPanel = false;
        this.dragChip = -1;
        this.dragHbar = false;
        this.dragVbar = false;
        this.chipDropVis = -1;
        this.hdrDragToPanel = false;
        this.dispRows = new List<DispRow>();
        this.dispFlat = true;
        this.groups = new List<GroupRow>();
        this.pinnedTopRows = new List<DataRow>();
        this.pinnedBottomRows = new List<DataRow>();
        this.hitRow = -1;
        this.hitOrder = -1;
        this.hitCol = -1;
        this.editRow = -1;
        this.editCol = -1;
        this.editVal = "";
        this.editing = false;
        this.editBuf = "";
        this.editCur = 0;
        this.editError = "";
        this.editRejected = false;
        this.edPopOpen = false;
        this.edPopSel = -1;
        this.edPopScroll = 0;
        this.edPopItems = new List<int>();
        this.edCalMonth = 0;
        this.edPopHot = false;
        this.styler = null;
        this.detail = null;
        this.expandedRows = new List<int>();
        this.expandedKeys = new List<RowKey>();
        this.expandedByKey = false;
        this.undoLog = new List<RowEdit>();
        this.redoLog = new List<RowEdit>();
        this.undoLimit = 100;
        this.allowAddRow = false;
        this.undoing = false;
        this.lastAddedRow = -1;
        this.undoGroup = 0;
        this.undoGroupSeq = 0;
        this.fillDrag = false;
        this.fillHX = -1;
        this.fillHY = -1;
        this.fillSR0 = -1;
        this.fillSC0 = -1;
        this.fillSR1 = -1;
        this.fillSC1 = -1;
        this.fillTR0 = 0;
        this.fillTC0 = 0;
        this.fillTR1 = -1;
        this.fillTC1 = -1;
        this.emptyText = "";
        this.loadingText = "";
        this.overlayKind = "";
