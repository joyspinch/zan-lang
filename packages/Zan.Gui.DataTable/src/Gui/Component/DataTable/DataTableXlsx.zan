using System;
using System.Data.Excel;
using System.Threading;
using Gui;
using Gui.Component.DataTable;

namespace Gui.Component.DataTable;

// xlsx 写盘核心与带弹层的导出入口（原 DataTable partial 的
// XLSX 支路，见文件头）。
public class DataTableXlsx {

    // 装配 xlsx 弹层导出口（把本类的 ExportToXlsxAsyncUi 挂进
    // DataTable.sXlsxExportUi 槽）。需要 Excel 导出的宿主（或测试）
    // 调一次本方法——按需拉取按名计数，这一拼就把本文件连同
    // XlsxBook/Zip/Deflate 写盘家族拉进图；不调用的程序整支裁掉。
    static void InstallExportUi() {
        DataTable.InstallXlsxExportUi(DataTableXlsx.ExportToXlsxAsyncUi);
    }

    // 异步导出 .xlsx 并显示居中进度弹层（含取消/关闭）。行选择
    // 与快照语义与 <see cref="DataTable.ExportToCsvAsync"/> 完全
    // 一致。返回 false（无可导内容或已有导出在运行）时弹层仍会
    // 显示失败原因，点关闭收起。弹层本体（DataTableExportUi/
    // Progress/SyncUi）在 DataTable.ExportUi.zan——本文件被拉入
    // 的前提是有人真的点了 Excel 导出（Overlays 菜单项先经
    // DataTable.sXlsxExportUi 槽查装配），那时弹层文件必然在图。
    static bool ExportToXlsxAsyncUi(App app, DataTableState st, List<DataColumn> cols,
                                    DataSource src, string path, bool selectionOnly) {
        DataTableUiExportProgress prog = new DataTableUiExportProgress();
        return DataTableXlsx.ExportToXlsxAsync(st, cols, src, path, selectionOnly, prog);
    }

    // 异步导出为 .xlsx：立即返回 true 表示任务已启动，写盘在后台
    // 线程上流式进行。行集/列区间在本调用内（当前线程）冻结成
    // 快照——之后表格的排序、过滤、勾选变化不影响本次导出；数据
    // 源内容本身请保持只读。进度/取消经 `progress` 回调（在后台
    // 线程上发生，UI 更新用 App.Post 切回），结束时必有一次
    // OnDone。返回 false：已有导出在运行（并回调
    // OnDone(false, "已有导出在运行")）或无可导内容（不回调）。
    static bool ExportToXlsxAsync(DataTableState st, List<DataColumn> cols,
                                  DataSource src, string path, bool selectionOnly,
                                  DataTableExportProgress progress) {
        DataTableExportSnapshot snap = DataTable.ExportBegin(selectionOnly,
            st, cols.Count, src, progress);
        if (snap == null) { return false; }
        ExportJob job = new ExportJob();
        job.kind = 1;
        job.snap = snap;
        job.cols = cols;
        job.src = src;
        job.path = path;
        job.progress = progress;
        // 写盘核心经槽交给 Worker（Export.zan 不拼 Xlsx 类型，
        // 否则按需拉取会把写盘家族拖进每个放表格的程序）。
        DataTable.sXlsxCore = delegate() {
            return DataTableXlsx.ExportXlsxSnapshot(job.snap, job.cols, job.src,
                                                    job.path, job.progress);
        };
        DataTable.sExportJob = job;
        if (!Thread.Start(ExportJob.Worker)) {
            DataTable.sExportJob = null;
            DataTable.sXlsxCore = null;
            DataTable.sExportBusy.Store(0);
            if (progress != null) { progress.OnDone(false, DataTable.T("Failed to start export thread", "无法启动导出线程")); }
            return false;
        }
        return true;
    }

    // xlsx 写盘核心（同步与后台线程共用）。progress 为 null 表示
    // 不需要进度/取消。返回 false = 取消或写盘失败。
    static bool ExportXlsxSnapshot(DataTableExportSnapshot snap, List<DataColumn> cols,
                                   DataSource src, string path,
                                   DataTableExportProgress progress) {
        int maxBandDepth = 0;
        for (int cc = snap.c0; cc <= snap.c1 && cc < cols.Count; cc = cc + 1) {
            int d = DataTable.BandDepth(cols[cc].band);
            if (d > maxBandDepth) { maxBandDepth = d; }
        }
        int headerRows = maxBandDepth > 0 ? maxBandDepth + 1 : 1;
        int total = snap.rows.Count + headerRows;
        if (progress != null) { progress.OnStart(total); }
        XlsxBook book = XlsxBook.New();
        XlsxSheet sheet = book.AddSheet("Sheet1");
        // 自动计算左侧连续冻结列数并写入原生 Excel 冻结窗格：
        int pinnedLeft = 0;
        int checkC = snap.c0;
        while (checkC <= snap.c1 && checkC < cols.Count && cols[checkC].freeze == 1) {
            pinnedLeft = pinnedLeft + 1;
            checkC = checkC + 1;
        }
        sheet.freezeCols = pinnedLeft;
        sheet.freezeRows = headerRows;
        sheet.freezeHeader = true;

        // 多级复合表头（Banded Headers）OpenXML 单元格合并：
        if (headerRows > 1) {
            int bandLevels = headerRows - 1;
            // 1. 横向合并：同级共享前缀的连续列
            for (int blv = 0; blv < bandLevels; blv = blv + 1) {
                int row1 = blv + 1;
                int cc = snap.c0;
                while (cc <= snap.c1 && cc < cols.Count) {
                    string p = DataTable.BandPrefix(cols[cc].band, blv + 1);
                    if (p == "" || DataTable.BandDepth(p) <= blv) {
                        cc = cc + 1;
                        continue;
                    }
                    int ccNext = cc + 1;
                    while (ccNext <= snap.c1 && ccNext < cols.Count
                           && DataTable.BandPrefix(cols[ccNext].band, blv + 1) == p) {
                        ccNext = ccNext + 1;
                    }
                    if (ccNext - 1 > cc) {
                        int cStart0 = cc - snap.c0;
                        int cEnd0 = (ccNext - 1) - snap.c0;
                        string mref = Xlsx.ColRef(cStart0) + Convert.ToString(row1)
                                    + ":" + Xlsx.ColRef(cEnd0) + Convert.ToString(row1);
                        sheet.AddMerge(mref);
                    }
                    cc = ccNext;
                }
            }
            // 2. 纵向合并：深度不足的列向下补齐延伸
            for (int cc = snap.c0; cc <= snap.c1 && cc < cols.Count; cc = cc + 1) {
                int d = DataTable.BandDepth(cols[cc].band);
                int startRow1 = (d == 0) ? 1 : (d + 1);
                int endRow1 = headerRows;
                if (endRow1 > startRow1) {
                    int col0 = cc - snap.c0;
                    string mref = Xlsx.ColRef(col0) + Convert.ToString(startRow1)
                                + ":" + Xlsx.ColRef(col0) + Convert.ToString(endRow1);
                    sheet.AddMerge(mref);
                }
            }
        }

        // 自动计算并同步单元格合并区间（CellSpan -> OpenXML mergeCells）：
        if (snap.spanProvider != null) {
            for (int ri = 0; ri < snap.rows.Count; ri = ri + 1) {
                int srcRow = snap.rows[ri];
                for (int cc = snap.c0; cc <= snap.c1 && cc < cols.Count; cc = cc + 1) {
                    CellSpan sp = snap.spanProvider.GetSpan(src, srcRow, cc);
                    if (sp != null && sp.IsMaster()) {
                        int startRow1 = ri + headerRows + 1;
                        int endRow1 = startRow1 + sp.rowSpan - 1;
                        int startCol0 = cc - snap.c0;
                        int endCol0 = startCol0 + sp.colSpan - 1;
                        string mref = Xlsx.ColRef(startCol0) + Convert.ToString(startRow1)
                                    + ":" + Xlsx.ColRef(endCol0) + Convert.ToString(endRow1);
                        sheet.AddMerge(mref);
                    }
                }
            }
        }

        DataTableRowSource rs = new DataTableRowSource();
        rs.src = src;
        rs.cols = cols;
        rs.snap = snap;
        rs.progress = progress;
        rs.headerRows = headerRows;
        bool ok = book.SaveStreaming(path, new List<XlsxRowSource>{ rs });
        if (progress != null) {
            if (ok) {
                progress.OnProgress(total, total);
                progress.OnDone(true, "");
            } else if (progress.Cancelled()) {
                progress.OnDone(false, DataTable.T("Cancelled", "已取消"));
            } else {
                progress.OnDone(false, DataTable.T("Write failed", "写入失败"));
            }
        }
        return ok;
    }

    // 单元格 → xlsx 值：按列声明的类型键取数（与排序/汇总走的
    // 是同一条路径，导出与表格显示不会各说各话）。
    // 空单元格返回 null（写出时跳过）。计算列导出公式实数。
    static XlsxCell ExportCell(int ci, List<DataColumn> cols, DataColumn col,
                               DataSource src, int row) {
        // 计算列：优先按公式值取数（失败行显示空，跳过）。
        if (col.formula.Length > 0) {
            double fv;
            if (!DataTable.FormulaTryReal(cols, src, row, ci, out fv)) { return null; }
            return XlsxCell.Num(fv);
        }
        string raw = src.CellText(row, ci);
        if (raw == "") { return null; }
        if (col.isDate) {
            int day = src.CellDay(row, ci, col.dateOrder);
            if (day == DataTable.NoDate()) { return XlsxCell.Str(raw); }
            return XlsxCell.Date(day);
        }
        if (col.isBool) { return XlsxCell.Bool(src.CellBool(row, ci)); }
        if (col.numeric) {
            if (col.decimals > 0) { return XlsxCell.Num(src.CellReal(row, ci)); }
            return XlsxCell.Num((double)src.CellNum(row, ci));
        }
        return XlsxCell.Str(raw);
    }
}
