using System;
using Gui;

namespace Gui.Component.DataTable;

/// DataTable 模块：单元格内编辑——开始/提交/取消、日历与
/// 选项选择器、布尔切换和数值步进。
partial class DataTable {

    /// 在 (rowIdx, col) 打开行内编辑器：预填当前单元格文本并把
    /// 光标置于末尾。下拉/日历编辑器（editorKind 1/2）立即展开
    /// 弹层并定位高亮项；日期解析失败或为空时日历定位到当前月。
    /// 列不可编辑或位置非法时不动作。
    static void BeginEdit(DataTableState st, List<DataColumn> cols,
                          DataSource src, int rowIdx, int col) {
        if (col < 0 || col >= cols.Count) { return; }
        if (!cols[col].editable) { return; }
        if (rowIdx < 0 || rowIdx >= src.RowCount()) { return; }
        DataColumn c = cols[col];
        st.editing = true;
        st.editRow = rowIdx;
        st.editCol = col;
        st.editBuf = src.CellText(rowIdx, col);
        st.editCur = st.editBuf.Length;
        st.editError = "";
        st.editRejected = false;

        // 下拉和日历编辑器打开时弹层已显示——
        // 选择它们就是为了让选项立即可见。
        st.edPopOpen = false;
        st.edPopSel = -1;
        st.edPopScroll = 0;
        st.edPopItems = new List<int>();
        if (c.editorKind == 1) {
            st.edPopOpen = true;
            st.edPopItems = DataTable.FilterChoices(c, "");
            st.edPopSel = DataTable.IndexOfChoice(c, st.editBuf);
        } else if (c.editorKind == 2) {
            st.edPopOpen = true;
            int day = DataTable.ParseDate(st.editBuf, c.dateOrder);
            // 无法解析或为空的日期单元格定位到当前月，
            // 使选择器仍可用于填入空白。
            if (day == DataTable.NoDate()) { day = DataTable.Today(); }
            DateTime dt = DateTime.FromUnixSeconds(day * 86400);
            st.edCalMonth = DataTable.YearMonth(dt.Year(), dt.Month());
            st.edPopSel = day;
        }
    }

    /// 把日历选择移动 `days` 天，显示月份跟随，
    /// 跨月时自动翻页，并把新日期
    /// 写入缓冲区。
    static void CalendarStep(DataTableState st, DataColumn c, int days) {
        int d = st.edPopSel;
        if (d == DataTable.NoDate() || d == -1) { d = DataTable.Today(); }
        else { d = d + days; }
        st.edPopSel = d;
        DateTime dt = DateTime.FromUnixSeconds(d * 86400);
        st.edCalMonth = DataTable.YearMonth(dt.Year(), dt.Month());
        st.editBuf = DataTable.FormatDate(d, DataTable.DateStoreFormat(c));
        st.editCur = st.editBuf.Length;
        st.editError = "";
    }

    /// `v` 在列选项中的位置（不区分大小写），否则返回 -1。
    static int IndexOfChoice(DataColumn c, string v) {
        string q = DataTable.TrimSpace(v);
        for (int i = 0; i < c.choices.Count; i = i + 1) {
            if (DataTable.EqCI(c.choices[i], q)) { return i; }
        }
        return -1;
    }

    /// 按键后重新筛选下拉列表，高亮保持在
    /// 仍在列表中的输入值上，否则落在第一个匹配项。
    static void RefreshChoices(DataTableState st, DataColumn c) {
        st.edPopItems = DataTable.FilterChoices(c, st.editBuf);
        st.edPopScroll = 0;
        int exact = DataTable.IndexOfChoice(c, st.editBuf);
        if (exact >= 0) { st.edPopSel = exact; }
        else if (st.edPopItems.Count > 0) { st.edPopSel = st.edPopItems[0]; }
        else { st.edPopSel = -1; }
    }

    /// 在筛选后的列表中移动下拉高亮 `step` 个位置，
    /// 两端钳制。
    static void MoveChoice(DataTableState st, int step) {
        if (st.edPopItems.Count == 0) { return; }
        int at = 0;
        int i = 0;
        while (i < st.edPopItems.Count) {
            if (st.edPopItems[i] == st.edPopSel) { at = i; i = st.edPopItems.Count; }
            else { i = i + 1; }
        }
        at = at + step;
        if (at < 0) { at = 0; }
        if (at >= st.edPopItems.Count) { at = st.edPopItems.Count - 1; }
        st.edPopSel = st.edPopItems[at];
    }

    /// 关闭编辑器并丢弃未提交的缓冲区，同时收起弹层、
    /// 清空错误与拒绝标记。
    static void CancelEdit(DataTableState st) {
        st.editing = false;
        st.editRow = -1;
        st.editCol = -1;
        st.editError = "";
        st.editRejected = false;
        st.edPopOpen = false;
    }

    /// 翻转布尔单元格并记为已提交的编辑。布尔列没有
    /// 可输入的文本，因此点击或 F2/Enter 就地切换，
    /// 而非打开行内编辑器。
    static void ToggleBoolCell(DataTableState st, List<DataColumn> cols, DataSource src,
                               int row, int col) {
        if (col < 0 || col >= cols.Count) { return; }
        if (row < 0 || row >= src.RowCount()) { return; }
        DataColumn c = cols[col];
        if (!c.isBool || !c.editable) { return; }
        string nv = c.boolTrue;
        if (src.CellBool(row, col)) { nv = c.boolFalse; }
        DataTable.Journal(st, RowEdit.Cell(row, col, src.CellText(row, col), nv));
        src.SetCell(row, col, nv);
        st.editRow = row;
        st.editCol = col;
        st.editVal = nv;
        st.hitRow = row;
        st.hitCol = col;
        st.dirty = true;
        st.CellEdit.Raise();
    }

    /// 校验缓冲区并写回行。值必须通过
    /// 列的声明式规则，并在 `CellValidating` 事件中存活，
    /// 处理器可调用 `Reject(msg)`。被拒绝的值保持编辑器
    /// 打开并显示消息，让用户修正而非
    /// 丢失输入。
    static void CommitEdit(DataTableState st, List<DataColumn> cols, DataSource src) {
        if (!st.editing) { return; }
        int rr = st.editRow;
        int cc = st.editCol;
        if (rr < 0 || rr >= src.RowCount() || cc < 0 || cc >= cols.Count) {
            DataTable.CancelEdit(st);
            return;
        }
        DataColumn c = cols[cc];

        // 严格下拉框提交高亮项而非输入的
        // 前缀，因此从列表选"Ship"会存储"Shipping"。
        if (c.editorKind == 1 && st.edPopSel >= 0 && st.edPopSel < c.choices.Count
            && DataTable.IndexOfChoice(c, st.editBuf) < 0) {
            st.editBuf = c.choices[st.edPopSel];
        }

        string err = DataTable.ValidateCell(c, st.editBuf);
        if (err.Length > 0) {
            st.editError = err;
            return;
        }

        // 把最终决定权交给应用。editVal 携带候选值，
        // 处理器可在决定前通过 EditValue() 检查。
        st.editVal = st.editBuf;
        st.editRejected = false;
        st.editError = "";
        st.CellValidating.Raise();
        if (st.editRejected) {
            if (st.editError.Length == 0) { st.editError = "Invalid value"; }
            return;
        }

        DataTable.Journal(st, RowEdit.Cell(rr, cc, src.CellText(rr, cc), st.editBuf));
        src.SetCell(rr, cc, st.editBuf);
        st.hitRow = rr;
        st.hitCol = cc;
        st.CellEdit.Raise();
        st.dirty = true;
        st.editing = false;
        st.editRow = -1;
        st.editCol = -1;
        st.edPopOpen = false;
    }

}
