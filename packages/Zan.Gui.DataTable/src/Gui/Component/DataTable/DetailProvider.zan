using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// 主从详情钩子：提供展开行下方绘制的面板。
// 继承它，重写 `Paint`（可选 `Slots` / `CanExpand`），
// 并用 `DataTable.SetDetail(st, provider)` 交给网格。行随即在行号栏
// 长出展开箭头；点击后在行下方打开一个
// 供详情面板绘制的带区——子表格、表单、图表。
// 详情带高度为整数个普通行槽位（`Slots`），
// 这使表格体的滚动和命中测试运算保持一致；见 `DispRow`。
public class DetailProvider {
    // `row` 的详情带高度，以普通行高为单位。
    // 网格会将其夹取到至少 1。可按行重写（例如根据
    // 子记录数量）。
    virtual int Slots(DataSource src, int row) { return 3; }

    // `row` 是否可以展开。无可展示内容的行返回 false，
    // 它便显示空白边距而不是无用的箭头。
    virtual bool CanExpand(DataSource src, int row) { return true; }

    // 将 `row` 的详情面板绘制到 [x,y,w,h]。画布裁剪到
    // 该矩形内，面板不会溢出到相邻行。
    virtual void Paint(App app, DataSource src, int row,
                       int x, int y, int w, int h) { }

    // 为 `row` 提供挂载的真 Control 实例（行明细控件模板）。
    // 若返回非 null，网格自动进行 MeasureTree + Arrange + RenderTree 并完整支持输入与事件；
    // 返回 null 时退回调用 Paint 进行 Canvas 享元绘制。
    virtual Control ProvideControl(App app, DataSource src, int row,
                                   int x, int y, int w, int h) {
        return null;
    }
}

// 行明细真控件构建委托
public delegate Control DetailControlFactory(App app, DataSource src, int row);

// 万能真控件行明细提供器（零胶水代码，一行挂载任意真实 Gui.Control 作为行详情模板）：
public class ControlDetailProvider : DetailProvider {
    DetailControlFactory factory;
    int slotCount;

    ControlDetailProvider(DetailControlFactory f, int slots) {
        this.factory = f;
        this.slotCount = slots > 0 ? slots : 4;
    }

    override int Slots(DataSource src, int row) {
        return this.slotCount;
    }

    override Control ProvideControl(App app, DataSource src, int row,
                                   int x, int y, int w, int h) {
        if (this.factory == null) { return null; }
        return this.factory(app, src, row);
    }
}

// 开箱即用多选项卡主从明细提供器（对标 SAP / ERP 复杂明细标签页）：
// 为展开的数据行并列挂载多个选项卡明细页，各页独立生成子控件并无缝切换。
public class TabbedDetailProvider : DetailProvider {
    List<string> tabTitles;
    List<DetailControlFactory> tabFactories;
    int slotCount;
    // 每行当前激活的 Tab 索引映射（行号 -> 选项卡下标）
    Dict<int, int> activeTabs;

    public TabbedDetailProvider(int slots) {
        this.tabTitles = new List<string>();
        this.tabFactories = new List<DetailControlFactory>();
        this.slotCount = slots > 0 ? slots : 6;
        this.activeTabs = new Dict<int, int>();
    }

    public TabbedDetailProvider() {
        this.tabTitles = new List<string>();
        this.tabFactories = new List<DetailControlFactory>();
        this.slotCount = 6;
        this.activeTabs = new Dict<int, int>();
    }

    public TabbedDetailProvider AddTab(string title, DetailControlFactory factory) {
        if (title != null && factory != null) {
            this.tabTitles.Add(title);
            this.tabFactories.Add(factory);
        }
        return this;
    }

    public override int Slots(DataSource src, int row) {
        return this.slotCount;
    }

    public override Control ProvideControl(App app, DataSource src, int row,
                                           int x, int y, int w, int h) {
        if (this.tabTitles.Count == 0) { return null; }

        Tabs tabsBar = new Tabs(Tabs.Segment());
        for (int i = 0; i < this.tabTitles.Count; i = i + 1) {
            Control page = null;
            if (i < this.tabFactories.Count && this.tabFactories[i] != null) {
                page = this.tabFactories[i](app, src, row);
            }
            if (page == null) {
                page = Panel.Column();
            }
            tabsBar.AddPage(this.tabTitles[i], page);
        }

        int curTab = 0;
        if (this.activeTabs.ContainsKey(row)) {
            curTab = this.activeTabs[row];
        }
        if (curTab >= this.tabTitles.Count) { curTab = 0; }
        tabsBar.Select(curTab);

        int capturedRow = row;
        TabbedDetailProvider self = this;
        tabsBar.TabChanged.AddS((Control sender) => {
            Tabs t = (Tabs)sender;
            self.activeTabs[capturedRow] = t.Active();
        });

        return tabsBar;
    }
}
