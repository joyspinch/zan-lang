using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// 分组表格中的一行分组标题：标题文本、嵌套层级、所含
// 数据行数、完整路径键（折叠查找）和折叠快照。
// 取代旧的按索引对齐的 grpLabel/grpLevel/grpCount/grpKey/grpCollapsed
// 并行列表。
// `aggregates` 是该组自身成员行的逐列小计（与表格列列表按索引对齐），在
// BuildDisplay 中一次性计算，让分组标题能显示 DevExpress 风格的分组汇总
// （例如 "Category: Electronics (42)  Revenue: \u00a51,234,567"）而无需额外
// 每帧开销。
public class GroupRow {
    public string label;
    public int level;
    public int count;
    public string key;
    public bool collapsed;
    public List<GroupAggregateEntry> aggregates;  // 强类型分组逐列聚合实体列表
    // 最内层（叶子）分组的成员源行（st.order 的连续片段），
    // BuildDisplay 关组时填充。最外层组不物化成员（每行
    // 只会记一次，嵌套层级不重复占内存）；组表头三态
    // 复选框对父组按 key 前缀收集后代叶子组的成员。
    public List<int> members;

    public GroupRow(string lb, int lv, int cnt, string k, bool coll) {
        label = lb;
        level = lv;
        count = cnt;
        key = k;
        collapsed = coll;
        aggregates = new List<GroupAggregateEntry>();
        members = new List<int>();
    }
}
