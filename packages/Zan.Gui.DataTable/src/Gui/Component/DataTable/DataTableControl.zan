using System.Collections.Generic;
using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// 非泛型 DataTable 的原生 Visual Tree 控件节点包装器（继承 DataTableHostBase）：
// 允许调用方将任意动态列与通用数据源直接以标准 Control 节点形态挂入 Visual Tree：
// ```zan
// DataTableControl grid = new DataTableControl(cols, src, st);
// layout.Add(grid);
// ```
public class DataTableControl : DataTableHostBase {
    public override Control CreateCloneShell() { return new DataTableControl(); }
    public List<DataColumn> columns;
    public DataSource source;
    public DataTableState state;

    public void InitGrid(List<DataColumn> cols, DataSource src, DataTableState st) {
        this.InitControl("datatable");
        this.columns = cols != null ? cols : new List<DataColumn>();
        this.source = src;
        this.state = st != null ? st : new DataTableState();
        this.state.host = this;
        this.wiresOwnEvents = true;
    }

    public DataTableControl(List<DataColumn> cols, DataSource src, DataTableState st) {
        this.InitGrid(cols, src, st);
    }

    public DataTableControl(List<DataColumn> cols, DataSource src) {
        this.InitGrid(cols, src, null);
    }

    public DataTableControl() {
        this.InitGrid(null, null, null);
    }

    protected override List<DataColumn> HostColumns() { return this.columns; }
    protected override DataSource HostSource() { return this.source; }
    protected override DataTableState HostState() { return this.state; }

    public List<DataColumn> Columns {
        get { return this.columns; }
        set { this.Bind(value, this.source); }
    }

    public DataSource ItemsSource {
        get { return this.source; }
        set { this.Bind(this.columns, value); }
    }

    public DataTableState TableState {
        get { return this.state; }
        set { this.state = value != null ? value : new DataTableState(); }
    }

    public void Bind(List<DataColumn> cols, DataSource src) {
        bool changed = this.source != src;
        bool schemaChanged = this.columns != cols;
        this.columns = cols != null ? cols : new List<DataColumn>();
        this.source = src;
        if (changed && this.state != null) { DataTable.InvalidateData(this.state); }
        else if (schemaChanged && this.state != null) { DataTable.InvalidateView(this.state); }
        if (this.state != null && this.source != null) {
            DataTable.EnsureInit(this.state, this.columns, this.source);
        }
        // Commit the binding before Cancel can reenter Bind with a newer source.
        if (changed) { this.RetireVisualTree(); }
    }

    public override void OnMeasure(App app) {
        int w = 0;
        if (this.columns != null) {
            for (int i = 0; i < this.columns.Count; i = i + 1) {
                w = w + (this.columns[i].width > 0 ? this.columns[i].width : app.Scale(80));
            }
        }
        if (w < app.Scale(240)) { w = app.Scale(360); }
        int h = app.Scale(240);
        if (this.state != null && this.state.rowH > 0) {
            h = this.state.rowH * 10;
        }
        this.prefW = w;
        this.prefH = h;
    }
}
