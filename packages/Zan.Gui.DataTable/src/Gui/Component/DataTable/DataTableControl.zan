using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// 非泛型 DataTable 的原生 Visual Tree 控件节点包装器（对标 DataGrid<T>）：
// 允许调用方将任意动态列与通用数据源直接以标准 Control 节点形态挂入 Visual Tree：
// ```zan
// DataTableControl grid = new DataTableControl(cols, src, st);
// layout.Add(grid);
// ```
// 内部自动维护主从明细（activeDetails）的 Visual Tree 子节点拓扑生命周期，
// 并将指针与键盘事件原生委托至 DataTable 渲染流水线。
public class DataTableControl : Control {
    public List<DataColumn> columns;
    public DataSource source;
    public DataTableState state;

    public void InitGrid(List<DataColumn> cols, DataSource src, DataTableState st) {
        this.InitControl("datatable", 5);
        this.columns = cols != null ? cols : new List<DataColumn>();
        this.source = src;
        this.state = st != null ? st : new DataTableState();
        // 引擎内部完成网格内部几何测算与多区域命中，基类控件不阻断子事件
        this.wiresOwnEvents = true;
    }

    public DataTableControl(List<DataColumn> cols, DataSource src, DataTableState st) {
        this.InitGrid(cols, src, st);
    }

    public DataTableControl(List<DataColumn> cols, DataSource src) {
        this.InitGrid(cols, src, null);
    }

    public DataTableControl() {
        this.InitGrid(null, null, null);
    }

    public override string Kind() { return "DataTableControl"; }

    public override string StyleType() { return "datatable"; }

    public DataTableState State() { return this.state; }

    public DataTableControl Bind(List<DataColumn> cols, DataSource src) {
        this.columns = cols != null ? cols : new List<DataColumn>();
        this.source = src;
        if (this.state != null && this.source != null) {
            DataTable.EnsureInit(this.state, this.columns, this.source);
        }
        return this;
    }

    // 采用通用 MessagePack 国际标准二进制保存表格布局（消灭 JSON 冗余与 GC）
    public byte[] SaveLayoutMsgPack() {
        return DataTable.SaveLayoutMsgPack(this.state, this.columns);
    }

    public bool LoadLayoutMsgPack(byte[] bytes) {
        return DataTable.LoadLayoutMsgPack(this.state, this.columns, bytes);
    }

    // 保存为紧凑单行令牌（单行 Base64，适合存数据库字段或用户偏好配置文件）
    public string SaveLayoutToken() {
        return DataTable.SaveLayoutToken(this.state, this.columns);
    }

    public bool LoadLayoutToken(string token) {
        return DataTable.LoadLayoutToken(this.state, this.columns, token);
    }

    // 自动适配全部可见列宽
    public void AutoFitAll() {
        this.AutoFitAll(this.App);
    }
    public void AutoFitAll(App app) {
        if (this.columns == null || this.source == null || this.state == null) { return; }
        app = this.ResolveApp(app);
        DataTable.AutoFitAll(app, this.columns, this.source, this.state);
    }

    // 自动适配指定列宽
    public void AutoFitColumn(int col) {
        this.AutoFitColumn(this.App, col);
    }
    public void AutoFitColumn(App app, int col) {
        if (this.columns == null || this.source == null || this.state == null) { return; }
        app = this.ResolveApp(app);
        DataTable.AutoFitColumn(app, this.columns, this.source, this.state, col);
    }

    // 按当前显示顺序全选/全不选
    public void SelectAll(bool val) {
        if (this.state != null && this.source != null) {
            DataTable.SelectAllRows(this.state, this.source, val);
        }
    }

    // 清空全部选择项
    public void ClearSelection() {
        this.SelectAll(false);
    }

    // 按指定字段排序（1 升序，2 降序）
    public void SortBy(string field, int dir) {
        if (this.state != null && this.columns != null) {
            DataTable.SortByField(this.state, this.columns, field, dir);
        }
    }

    // 按指定字段分组
    public void GroupBy(string field) {
        if (this.state != null && this.columns != null) {
            DataTable.GroupByField(this.state, this.columns, field);
        }
    }

    // 重置所有列（恢复默认宽度与排序）
    public void ResetColumns() {
        if (this.state != null && this.columns != null) {
            DataTable.ResetColumns(this.state, this.columns);
        }
    }

    // 打开行内快速搜索栏
    public void OpenFind() {
        if (this.state != null) {
            DataTable.OpenFind(this.state);
        }
    }

    // 关闭快速搜索栏
    public void CloseFind() {
        if (this.state != null) {
            DataTable.CloseFind(this.state);
        }
    }

    // 设置常驻视口全局子串高亮检索
    public void SetHighlightQuery(string query) {
        if (this.state != null) {
            DataTable.SetHighlightQuery(this.state, query);
        }
    }

    // 异步导出为 Excel XLSX 文件并弹出进度浮层
    public bool ExportToXlsx(string path, bool selectionOnly) {
        return this.ExportToXlsx(this.App, path, selectionOnly);
    }
    public bool ExportToXlsx(App app, string path, bool selectionOnly) {
        if (this.columns == null || this.source == null || this.state == null) { return false; }
        app = this.ResolveApp(app);
        return DataTable.ExportToXlsxAsyncUi(app, this.state, this.columns, this.source, path, selectionOnly);
    }

    // 异步导出为 CSV 文件并弹出进度浮层
    public bool ExportToCsv(string path, bool selectionOnly) {
        return this.ExportToCsv(this.App, path, selectionOnly);
    }
    public bool ExportToCsv(App app, string path, bool selectionOnly) {
        if (this.columns == null || this.source == null || this.state == null) { return false; }
        app = this.ResolveApp(app);
        return DataTable.ExportToCsvAsyncUi(app, this.state, this.columns, this.source, path, selectionOnly);
    }

    public override void OnMeasure(App app) {
        int w = 0;
        if (this.columns != null) {
            for (int i = 0; i < this.columns.Count; i = i + 1) {
                w = w + (this.columns[i].width > 0 ? this.columns[i].width : app.Scale(80));
            }
        }
        if (w < app.Scale(240)) { w = app.Scale(360); }
        int h = app.Scale(240);
        if (this.state != null && this.state.rowH > 0) {
            h = this.state.rowH * 10;
        }
        this.prefW = w;
        this.prefH = h;
    }

    public override void OnPaint(App app) {
        if (this.columns == null || this.source == null || this.state == null) { return; }
        // 挂接 Visual Tree 子树容器拓扑，使主从明细控件正常接入父子关系与事件冒泡
        this.children = new List<Control>();
        this.state.activeDetails = this.children;
        this.state.ownerControl = this;
        DataTable.RenderSource(app, this.bx, this.by, this.bw, this.bh, this.columns, this.source, this.state);
    }
}
