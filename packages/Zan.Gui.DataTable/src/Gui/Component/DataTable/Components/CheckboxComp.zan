using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// "checkbox" 适配器：布尔值（同 switch 的序列化口径），格内
// 一个无标题复选框。
public class CheckboxComp : CellComp {
    List<WidgetPoolSlot> pool;
    DataColumn lastCol;
    bool lastOn;

    CheckboxComp() : base("checkbox") {
        this.pool = new List<WidgetPoolSlot>();
        this.lastCol = null;
        this.lastOn = false;
    }

    override Control Acquire(App app, DataSource src, int row, int col,
                             RowKey key, int x, int y, int w, int h,
                             int rows, int cols) {
        string k = WidgetComps.PoolKey(key, col);
        for (int i = 0; i < this.pool.Count; i = i + 1) {
            if (this.pool[i].key == k) { return this.pool[i].ctl; }
        }
        Checkbox cb = new Checkbox();
        cb.wiresOwnEvents = true;
        cb.SetLabel("");
        if (this.pool.Count >= CellComp.PoolCap) { this.Reset(); }
        this.pool.Add(new WidgetPoolSlot(k, cb));
        return cb;
    }

    override void FillStr(Control ctl, string val, DataColumn col,
                          DataSource src, int row) {
        Checkbox cb = (Checkbox)ctl;
        this.lastCol = col;
        this.lastOn = WidgetComps.BoolOf(col, val);
        if (cb.IsChecked() != this.lastOn) { cb.SetChecked(this.lastOn); }
    }

    // 与 SwitchComp 同契约：仅本帧用户点击才上报，列口径文本。
    override bool TakeCommit(Control ctl, ref string outVal) {
        Checkbox cb = (Checkbox)ctl;
        bool on = cb.IsChecked();
        if (on == this.lastOn) { return false; }
        outVal = WidgetComps.BoolText(this.lastCol, on);
        this.lastOn = on;
        return true;
    }

    override void Reset() {
        this.pool.Clear();
        this.lastCol = null;
        this.lastOn = false;
    }
}
