using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// "switch" 适配器：布尔值按列的 boolTrue/boolFalse 文本序列化
// （与 bool 列口径一致），SetOn 灌入、IsOn 上报。
// 状态与槽位实例绑定，杜绝全局单例状态跨表/跨行串扰。
public class SwitchComp : CellComp {
    List<WidgetPoolSlot> pool;

    SwitchComp() : base("switch") {
        this.pool = new List<WidgetPoolSlot>();
    }

    WidgetPoolSlot FindSlot(Control ctl) {
        for (int i = 0; i < this.pool.Count; i = i + 1) {
            if (this.pool[i].ctl == ctl) { return this.pool[i]; }
        }
        return null;
    }

    override Control Acquire(App app, DataSource src, int row, int col,
                             RowKey key, int x, int y, int w, int h,
                             int rows, int cols) {
        string k = WidgetComps.PoolKey(key, col);
        for (int i = 0; i < this.pool.Count; i = i + 1) {
            if (this.pool[i].key == k) { return this.pool[i].ctl; }
        }
        Switch sw = new Switch();
        sw.wiresOwnEvents = true;
        if (this.pool.Count >= CellComp.PoolCap) { this.Reset(); }
        WidgetPoolSlot slot = new WidgetPoolSlot(k, sw);
        this.pool.Add(slot);
        return sw;
    }

    override void FillStr(Control ctl, string val, DataColumn col,
                          DataSource src, int row) {
        Switch sw = (Switch)ctl;
        WidgetPoolSlot slot = this.FindSlot(ctl);
        bool on = WidgetComps.BoolOf(col, val);
        if (slot == null) {
            slot = new WidgetPoolSlot("", sw);
            this.pool.Add(slot);
        }
        slot.col = col;
        slot.lastVal = on ? "true" : "false";
        if (sw.IsOn() != on) { sw.SetOn(on); }
    }

    // 仅在控件状态相对本次灌入值发生变化（= 本帧用户点击）
    // 时上报，文本走列布尔口径。
    override bool TakeCommit(Control ctl, ref string outVal) {
        Switch sw = (Switch)ctl;
        WidgetPoolSlot slot = this.FindSlot(ctl);
        if (slot == null || slot.col == null) { return false; }
        bool on = sw.IsOn();
        bool lastOn = slot.lastVal == "true";
        if (on == lastOn) { return false; }
        outVal = WidgetComps.BoolText(slot.col, on);
        slot.lastVal = on ? "true" : "false";
        return true;
    }

    override void Reset() {
        this.pool.Clear();
    }
}
