using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// "rate" 适配器：整星数（0..N 文本）。显数 N 取列形状 shapeC
// （<=0 用 Rate 默认），经 Shape 声明。Rate 内部以 *2 编码支持
// 半星；这里只用整数档。
public class RateComp : CellComp {
    List<WidgetPoolSlot> pool;
    int lastV;

    RateComp() : base("rate") {
        this.pool = new List<WidgetPoolSlot>();
        this.lastV = 0;
    }

    override Control Acquire(App app, DataSource src, int row, int col,
                             RowKey key, int x, int y, int w, int h,
                             int rows, int cols) {
        string k = WidgetComps.PoolKey(key, col);
        for (int i = 0; i < this.pool.Count; i = i + 1) {
            if (this.pool[i].key == k) { return this.pool[i].ctl; }
        }
        // 星数不在这里定：cellType 10 没有矩阵概念，DrawCompCell
        // 传来的 cols 已退化成 1（空序列兜底），按它设置就成了
        // “一格一星”。显数由 FillStr 按列 shapeC 解析（见下）。
        Rate r = new Rate();
        r.wiresOwnEvents = true;
        if (this.pool.Count >= CellComp.PoolCap) { this.Reset(); }
        this.pool.Add(new WidgetPoolSlot(k, r));
        return r;
    }

    override void FillStr(Control ctl, string val, DataColumn col,
                          DataSource src, int row) {
        Rate r = (Rate)ctl;
        // 显数取列形状 shapeC，未声明用 Rate 默认 5。
        int want = (col != null && col.shapeC > 0) ? col.shapeC : 5;
        if (r.MaxStars() != want) { r.Max(want); }
        int v = DataTable.ParseInt(val);
        if (v < 0) { v = 0; }
        // 越界值按显数截断展示，lastV 记截断后的值——若记原值，
        // TakeCommit 会把“展示截断”当用户改动，下一帧自动把格里
        // 的 9 覆盖成 5（展示路径写数据）。
        if (v > want) { v = want; }
        this.lastV = v;
        if (r.Value() != v) { r.SetStars(v); }
    }

    // 空文本/非数值灌 0 后不再上报 "0"（展示不写数据）。
    override bool TakeCommit(Control ctl, ref string outVal) {
        Rate r = (Rate)ctl;
        int v = r.Value();
        if (v == this.lastV) { return false; }
        outVal = Convert.ToString(v);
        this.lastV = v;
        return true;
    }

    override void Reset() {
        this.pool.Clear();
        this.lastV = 0;
    }
}
