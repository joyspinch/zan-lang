using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// 万能 Gui 控件悬浮编辑器适配器（零胶水代码，任意 Gui 组件直接挂载进单元格）：
// 自动探测 Input, TextArea, SelectBox, Checkbox, Switch 等标准控件的数据通道，
// 并支持未知自定义控件的属性协议（"value"）与生命周期焦点挂载。
class ControlCellEditor : CellEditor {
    Control widget;

    ControlCellEditor(Control ctl) {
        this.widget = ctl;
    }

    override Control CreateWidget(App app, DataTableState st, DataColumn col) {
        return this.widget;
    }

    static bool IsNumeric(string s) {
        if (s == null || s == "") { return false; }
        int start = 0;
        if (s[0] == 45) { start = 1; } // '-'
        if (start >= s.Length) { return false; }
        for (int i = start; i < s.Length; i = i + 1) {
            if (s[i] < 48 || s[i] > 57) { return false; }
        }
        return true;
    }

    override void BeginEdit(Control ctl, string initValue, DataColumn col) {
        if (ctl == null) { return; }
        if (ctl is Input) {
            ((Input)ctl).SetText(initValue);
            return;
        }
        if (ctl is TextArea) {
            ((TextArea)ctl).SetText(initValue);
            return;
        }
        if (ctl is SelectBox) {
            ((SelectBox)ctl).SetExtra("value", initValue);
            return;
        }
        if (ctl is InputNumber) {
            if (initValue != "" && ControlCellEditor.IsNumeric(initValue)) {
                ((InputNumber)ctl).SetValue(Convert.ToInt32(initValue));
            }
            return;
        }
        if (ctl is Checkbox) {
            ((Checkbox)ctl).SetChecked(DataTable.ParseBool(initValue));
            return;
        }
        if (ctl is Switch) {
            ((Switch)ctl).SetOn(DataTable.ParseBool(initValue));
            return;
        }
        ctl.SetProp("value", initValue);
    }

    override string GetValue(Control ctl, DataColumn col) {
        if (ctl == null) { return ""; }
        if (ctl is Input) { return ((Input)ctl).GetText(); }
        if (ctl is TextArea) { return ((TextArea)ctl).GetText(); }
        if (ctl is SelectBox) { return ((SelectBox)ctl).Text(); }
        if (ctl is InputNumber) { return Convert.ToString(((InputNumber)ctl).Value()); }
        if (ctl is Checkbox) { return ((Checkbox)ctl).IsChecked() ? "true" : "false"; }
        if (ctl is Switch) { return ((Switch)ctl).IsOn() ? "true" : "false"; }
        return ctl.GetProp("value");
    }

    override void Focus(App app, Control ctl) {
        if (ctl == null || app == null) { return; }
        if (ctl is Input) {
            app.focus.SetFocused(((Input)ctl).wid);
        } else if (ctl is SelectBox) {
            app.focus.SetFocused(((SelectBox)ctl).wid);
        } else if (ctl.commonId > 0) {
            app.focus.SetFocused(ctl.commonId);
        }
    }

    override bool OnKeyDown(Control ctl, int key, DataTableState st) {
        if (key == 13 || key == 9 || key == 27) {
            return false;
        }
        return true;
    }

    override void EndEdit(Control ctl) {
    }
}
