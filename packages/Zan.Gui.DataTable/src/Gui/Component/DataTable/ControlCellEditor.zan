using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// 单元格数据通道委托：允许调用方对任意复杂复合组件自由定制赋值/取值（彻底杜绝硬编码）
public delegate void CellValueSetter(Control ctl, string value);
public delegate string CellValueGetter(Control ctl);

// 万能 Gui 控件悬浮编辑器适配器（纯协议驱动 + 开放委托定制）：
// 1. 契约驱动（Protocol-Driven）：任意 Gui.Control 默认走统一的标准 "value" 属性通道（SetProp("value") / GetProp("value")）；
// 2. 委托开放（Open-Closed）：支持注入自定义 Setter/Getter 委托，无需在表格核心代码里硬编码任何具体控件类型；
// 3. 焦点收敛：依托 Control.WidgetId() 统一将键盘输入焦点授予组件内部交互内核。
public class ControlCellEditor : CellEditor {
    Control widget;
    CellValueSetter customSetter;
    CellValueGetter customGetter;

    ControlCellEditor(Control ctl) {
        this.widget = ctl;
    }

    ControlCellEditor(Control ctl, CellValueSetter setter, CellValueGetter getter) {
        this.widget = ctl;
        this.customSetter = setter;
        this.customGetter = getter;
    }

    override Control CreateWidget(App app, DataTableState st, DataColumn col) {
        return this.widget;
    }

    override void BeginEdit(Control ctl, string initValue, DataColumn col) {
        if (ctl == null) { return; }
        if (this.customSetter != null) {
            this.customSetter(ctl, initValue);
            return;
        }
        ctl.SetProp("value", initValue);
        if (ctl is Input) {
            Input inp = (Input)ctl;
            inp.SelectAll();
        }
    }

    override string GetValue(Control ctl, DataColumn col) {
        if (ctl == null) { return ""; }
        if (this.customGetter != null) {
            return this.customGetter(ctl);
        }
        string val = ctl.GetProp("selectedValue");
        if (val != "") { return val; }
        return ctl.GetProp("value");
    }

    override void Focus(App app, Control ctl) {
        if (ctl == null || app == null) { return; }
        int wid = ctl.WidgetId();
        if (wid > 0) {
            app.focus.SetFocused(wid);
        } else if (ctl.commonId > 0) {
            app.focus.SetFocused(ctl.commonId);
        }
    }

    override bool OnKeyDown(Control ctl, int key, DataTableState st) {
        if (key == 13 || key == 9 || key == 27) {
            return false;
        }
        return true;
    }

    override void EndEdit(Control ctl) {
    }
}
