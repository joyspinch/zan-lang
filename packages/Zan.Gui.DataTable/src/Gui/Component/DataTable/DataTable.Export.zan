using System;
using System.IO;
using System.Text;
using System.Threading;

namespace Gui.Component.DataTable;

// DataTable 分部：文件导出（CSV 同步 + 异步流式；XLSX 支路在
// DataTableXlsx.zan——XlsxBook/Zip/Deflate 家族只有真的
// 导出 Excel 的程序才需要，按需拉取据此整支裁掉）。
// 行选择语义与 <see cref="BuildText"/>（剪贴板复制）完全一致，
// "所见即所得"——导出的就是过滤/排序后看到的行。序列化本体在
// <see cref="XlsxBook"/>（数据层），不依赖 GUI；服务端/控制台
// 程序直接用 XlsxBook.SaveStreaming 即可。
public partial class DataTable {
    // 后台导出的单任务槽与忙标志：避免两个导出互相抢文件与
    // 进度回调（与 DownloadJob 的单任务语义一致）。
    static ExportJob sExportJob;
    // 后台导出忙标志：0 空闲 / 1 占用，抢占成功者才开工。
    static AtomicInt sExportBusy = new AtomicInt(0);
    // xlsx 写盘核心槽：DataTableXlsx.ExportToXlsxAsync 启动任务前
    // 装入（闭包持有实参），Worker 线程只经此槽调用——主文件不
    // 拼 Xlsx 家族的任何类型，xlsx 支路随导出调用按需拉入。
    static Func<bool> sXlsxCore;
    // xlsx 弹层导出入口槽：由 DataTableXlsx.Importable()（或宿主
    // 显式 DataTableXlsx.InstallExportUi）装配。Overlays 的 Excel
    // 菜单项只经此槽调用——本文件族若拼 DataTableXlsx 类名，
    // 按需拉取会把 XlsxBook/Zip/Deflate 拖进每个放表格的程序。
    // 未装配 = null，菜单项点击报「未启用 Excel 导出」。
    static XlsxExportUiFn sXlsxExportUi;
    // 装配 xlsx 弹层导出入口（幂等）。DataTableXlsx.InstallExportUi
    // 在文件被拉入时调用；需要 Excel 导出但从未装配的宿主可显式
    // 调用同一个入口触发拉入。
    static void InstallXlsxExportUi(XlsxExportUiFn fn) {
        if (fn != null) { DataTable.sXlsxExportUi = fn; }
    }

    // Overlays 的 Excel 菜单项走这里：经槽调 xlsx 入口，未装配
    // 返回 false（弹层显示「没有可导出的内容」——与无可导内容
    // 同形，xlsx 写盘家族不进图）。
    static bool RunXlsxExportUi(App app, DataTableState st, List<DataColumn> cols,
                                DataSource src, string path, bool selectionOnly) {
        XlsxExportUiFn fn = DataTable.sXlsxExportUi;
        if (fn == null) { return false; }
        return fn(app, st, cols, src, path, selectionOnly);
    }

    // ---------- 同步导出（小表；大表请用 *Async） ----------

    // 导出为 CSV 文件，始终含表头行。行选择：
    // `selectionOnly` 为 false 时导出整个过滤/排序后的视图；
    // 为 true 时有单元格范围导范围（行×列），否则导勾选行，
    // 两者皆无返回 false。内容与复制粘贴一致（显示文本，
    // RFC 4180 转义）。UTF-8 带 BOM，Excel 双击打开不乱码。
    // 逐行流式写出，内存占用与行数无关；路径打不开返回 false。
    static bool ExportToCsv(DataTableState st, List<DataColumn> cols,
                            DataSource src, string path, bool selectionOnly) {
        DataTableExportSnapshot snap = DataTable.ExportSnapshot(st, cols.Count, src, selectionOnly);
        if (snap == null) { return false; }
        try {
            return DataTable.ExportCsvSnapshot(snap, cols, src, path, null);
        } catch (Exception ex) {
            return false;
        }
    }

    // 异步导出为 CSV，语义与 <see cref="ExportToXlsxAsync"/>
    // 相同（逐行流式 + BOM + RFC 4180 转义）。
    static bool ExportToCsvAsync(DataTableState st, List<DataColumn> cols,
                                 DataSource src, string path, bool selectionOnly,
                                 DataTableExportProgress progress) {
        DataTableExportSnapshot snap = DataTable.ExportBegin(selectionOnly,
            st, cols.Count, src, progress);
        if (snap == null) { return false; }
        ExportJob job = new ExportJob();
        job.kind = 2;
        job.snap = snap;
        job.cols = cols;
        job.src = src;
        job.path = path;
        job.progress = progress;
        DataTable.sExportJob = job;
        if (!Thread.Start(ExportJob.Worker)) {
            DataTable.sExportJob = null;
            DataTable.sExportBusy.Store(0);
            if (progress != null) { progress.OnDone(false, DataTable.T("Failed to start export thread", "无法启动导出线程")); }
            return false;
        }
        return true;
    }

    // 异步导出的公共前置：忙标志占位 + 当前线程冻结快照。失败
    // 时负责把忙标志放回去。返回 null = 拒绝启动。
    static DataTableExportSnapshot ExportBegin(bool selectionOnly, DataTableState st,
                                               int colCount, DataSource src,
                                               DataTableExportProgress progress) {
        if (DataTable.sExportBusy.CompareExchange(0, 1) != 0) {
            if (progress != null) { progress.OnDone(false, DataTable.T("An export is already running", "已有导出在运行")); }
            return null;
        }
        DataTableExportSnapshot snap = DataTable.ExportSnapshot(st, colCount, src, selectionOnly);
        if (snap == null) {
            DataTable.sExportBusy.Store(0);
        }
        return snap;
    }

    // ---------- 内部：快照与写盘核心 ----------

    // 在调用线程（通常是 UI 线程）冻结导出行集：列区间与行序一次
    // 取走，之后表格再排序/过滤/勾选都不影响本次导出。无可导内容
    // 返回 null。
    static DataTableExportSnapshot ExportSnapshot(DataTableState st, int colCount,
                                                  DataSource src, bool selectionOnly) {
        int c0 = 0;
        int c1 = colCount - 1;
        List<int> rowsOut = new List<int>();
        if (selectionOnly && DataTable.HasRange(st)) {
            c0 = DataTable.MaxI(0, DataTable.MinI(st.rangeC0, st.rangeC1));
            c1 = DataTable.MinI(colCount - 1,
                DataTable.MaxI(st.rangeC0, st.rangeC1));
            int rLo = DataTable.MaxI(0, DataTable.MinI(st.rangeR0, st.rangeR1));
            int rHi = DataTable.MinI(st.order.Count - 1,
                DataTable.MaxI(st.rangeR0, st.rangeR1));
            for (int oi = rLo; oi <= rHi; oi = oi + 1) { rowsOut.Add(st.order[oi]); }
        } else if (selectionOnly) {
            for (int oi = 0; oi < st.order.Count; oi = oi + 1) {
                int ri = st.order[oi];
                if (DataTable.IsSelected(st, src, ri)) { rowsOut.Add(ri); }
            }
        } else {
            for (int oi = 0; oi < st.order.Count; oi = oi + 1) {
                rowsOut.Add(st.order[oi]);
            }
        }
        if (c1 < c0 || rowsOut.Count == 0) { return null; }
        DataTableExportSnapshot snap = new DataTableExportSnapshot();
        snap.rows = rowsOut;
        snap.c0 = c0;
        snap.c1 = c1;
        snap.spanProvider = st.spanProvider;
        return snap;
    }

    // CSV 写盘核心：逐行流式（UTF-8 带 BOM；RFC 4180 转义与
    // 复制粘贴一致）。返回 false = 取消或写盘失败。
    static bool ExportCsvSnapshot(DataTableExportSnapshot snap, List<DataColumn> cols,
                                  DataSource src, string path,
                                  DataTableExportProgress progress) {
        int total = snap.rows.Count + 1;
        if (progress != null) { progress.OnStart(total); }
        StreamWriter w = new StreamWriter(path);
        try {
            // UTF-8 BOM：Excel 双击打开 CSV 时没有它按本地旧代码
            // 页猜编码，中文必乱码。
            w.Write(Encoding.Utf8FromCodePoint(65279));
            StringBuilder sb = new StringBuilder();
            for (int cc = snap.c0; cc <= snap.c1; cc = cc + 1) {
                if (cc > snap.c0) { sb.Append(","); }
                sb.Append(DataTable.CsvField(cols[cc].title));
            }
            sb.Append("\r\n");
            w.Write(sb.ToString());
            for (int k = 0; k < snap.rows.Count; k = k + 1) {
                if (progress != null && progress.Cancelled()) {
                    w.Close();
                    File.Delete(path);
                    progress.OnDone(false, DataTable.T("Cancelled", "已取消"));
                    return false;
                }
                int ri = snap.rows[k];
                sb = new StringBuilder();
                for (int cc = snap.c0; cc <= snap.c1; cc = cc + 1) {
                    if (cc > snap.c0) { sb.Append(","); }
                    sb.Append(DataTable.CsvField(DataTable.CellTextRouted(cols, src, ri, cc)));
                }
                sb.Append("\r\n");
                w.Write(sb.ToString());
                if ((k & 511) == 511 && progress != null) {
                    progress.OnProgress(k + 2, total);
                }
            }
            w.Close();
            if (progress != null) {
                progress.OnProgress(total, total);
                progress.OnDone(true, "");
            }
            return true;
        } catch (Exception ex) {
            w.Close();
            File.Delete(path);
            if (progress != null) { progress.OnDone(false, ex.Message); }
            return false;
        }
    }
}
