using System;

namespace Gui.Component.DataTable;

// 一页查询结果的传输元数据。totalKnown=false 时，total 不参与
// RowCount 推断，HasMore/continuation 才是尾部语义的来源。
public class QueryResult {
    int requestId;
    int generation;
    string queryText;
    int queryHash;
    int schemaVersion;
    int serverRevision;
    int start;
    int requestedCount;
    string cursor;
    int total;
    bool totalKnown;
    bool hasMore;
    string continuation;
    List<QueryRow> rows;
    List<QueryGroupBucket> groups;
    List<QueryAggregateValue> aggregates;
    string error;
    bool valid;

    // 内部构造：start 钳制到 >=0、requestedCount 钳制到 >=1，文本字段
    // null 记空串；total 已知但小于 start+行数 时抬到 start+行数。
    // 任一行键缺失或 revision 为负、行数超出请求页大小、或声明
    // hasMore 却缺 continuation 时置 valid=false 并把原因记入 error。
    QueryResult(int id, int gen, string canonical, int hash, int schema, int server,
                int at, int requested, string pageCursor,
                List<QueryRow> values, int totalCount,
                bool known, bool more, string nextCursor, string failure) {
        this.requestId = id;
        this.generation = gen;
        this.queryText = canonical;
        if (this.queryText == null) { this.queryText = ""; }
        this.queryHash = hash;
        this.schemaVersion = schema;
        this.serverRevision = server;
        this.start = at;
        if (this.start < 0) { this.start = 0; }
        this.requestedCount = requested;
        if (this.requestedCount < 1) { this.requestedCount = 1; }
        this.cursor = pageCursor;
        if (this.cursor == null) { this.cursor = ""; }
        this.rows = values;
        if (this.rows == null) { this.rows = new List<QueryRow>(); }
        this.groups = new List<QueryGroupBucket>();
        this.aggregates = new List<QueryAggregateValue>();
        this.total = totalCount;
        this.totalKnown = known;
        if (this.totalKnown && this.total < 0) { this.totalKnown = false; }
        if (this.totalKnown && this.total < this.start + this.rows.Count) {
            this.total = this.start + this.rows.Count;
        }
        this.hasMore = more;
        this.continuation = nextCursor;
        if (this.continuation == null) { this.continuation = ""; }
        this.error = failure;
        if (this.error == null) { this.error = ""; }
        this.valid = true;
        for (int i = 0; i < this.rows.Count; i = i + 1) {
            if (this.rows[i] == null || this.rows[i].Key() == null
                || this.rows[i].Revision() < 0) {
                this.valid = false;
            }
        }
        if (this.rows.Count > this.requestedCount && this.error.Length == 0) {
            this.error = "query result row count exceeds viewport";
            this.valid = false;
        }
        if (this.hasMore && this.cursor.Length > 0
            && this.continuation.Length == 0 && this.error.Length == 0) {
            this.error = "query result continuation is missing";
            this.valid = false;
        }
    }

    // 构造 token/viewport 身份下的空页（无行，total=0 且已知）；
    // token 或 viewport 为 null 返回 null。
    static QueryResult Empty(QueryRequestToken token, QueryViewport viewport) {
        if (token == null || viewport == null) { return null; }
        return new QueryResult(token.RequestId(), token.Generation(),
            token.QueryText(), token.QueryHash(), token.SchemaVersion(), token.ServerRevision(),
            viewport.Start(), viewport.Count(), viewport.Cursor(),
            new List<QueryRow>(), 0, true, false, "", "");
    }

    // 构造仅声明覆盖行 at 的空结果（页大小 1）；token 为 null 返回 null。
    static QueryResult EmptyAt(QueryRequestToken token, int at) {
        if (token == null) { return null; }
        return new QueryResult(token.RequestId(), token.Generation(),
            token.QueryText(), token.QueryHash(), token.SchemaVersion(), token.ServerRevision(),
            at, 1, "", new List<QueryRow>(), 0, true, false, "", "");
    }

    // 构造携带 message 的失败结果（无行、total 未知）；
    // token 或 viewport 为 null 返回 null。
    static QueryResult Failure(QueryRequestToken token, QueryViewport viewport,
                               string message) {
        if (token == null || viewport == null) { return null; }
        return new QueryResult(token.RequestId(), token.Generation(),
            token.QueryText(), token.QueryHash(), token.SchemaVersion(), token.ServerRevision(),
            viewport.Start(), viewport.Count(), viewport.Cursor(),
            new List<QueryRow>(), 0, false, false, "", message);
    }

    // 结果所属请求序号。
    int RequestId() { return this.requestId; }
    // 结果所属 generation。
    int Generation() { return this.generation; }
    // 请求的 canonical 查询文本。
    string QueryText() { return this.queryText; }
    // 查询指纹。
    int QueryHash() { return this.queryHash; }
    // 构建时的 schema 版本。
    int SchemaVersion() { return this.schemaVersion; }
    // 构建时的服务端 revision。
    int ServerRevision() { return this.serverRevision; }
    // 本页起始行索引。
    int Start() { return this.start; }
    // 请求的页大小。
    int RequestedCount() { return this.requestedCount; }
    // 请求使用的续页 token。
    string Cursor() { return this.cursor; }
    // 实际返回行数。
    int Count() { return this.rows.Count; }
    // 行快照列表。
    List<QueryRow> Rows() { return this.rows; }
    // 全集行数；仅在 TotalKnown 时可信。
    int Total() { return this.total; }
    // 服务端是否给出了全集行数。
    bool TotalKnown() { return this.totalKnown; }
    // 简单顺延后是否还有数据。
    bool HasMore() { return this.hasMore; }
    // 服务端续页 token；空串表示无。
    string Continuation() { return this.continuation; }
    // 失败/形状错误文本；成功为空串。
    string Error() { return this.error; }
    // 有错误文本或形状校验未通过时为 true。
    bool Failed() { return this.error.Length > 0 || !this.valid; }
    // 分组桶列表（无分组为空）。
    List<QueryGroupBucket> Groups() { return this.groups; }
    // 聚合值列表（无聚合为空）。
    List<QueryAggregateValue> Aggregates() { return this.aggregates; }

    // 复制本结果并替换分组/聚合形状（逐项复制，null 列表按空处理）；
    // 其余元数据与行快照保持共享。
    QueryResult WithShape(List<QueryGroupBucket> groupValues,
                          List<QueryAggregateValue> aggregateValues) {
        QueryResult result = new QueryResult(this.requestId, this.generation,
            this.queryText, this.queryHash, this.schemaVersion, this.serverRevision,
            this.start, this.requestedCount, this.cursor, this.rows, this.total,
            this.totalKnown, this.hasMore, this.continuation, this.error);
        if (groupValues != null) {
            for (int i = 0; i < groupValues.Count; i = i + 1) {
                QueryGroupBucket g = groupValues[i];
                if (g != null) { result.groups.Add(new QueryGroupBucket(g.Key(), g.Count())); }
            }
        }
        if (aggregateValues != null) {
            for (int i = 0; i < aggregateValues.Count; i = i + 1) {
                QueryAggregateValue a = aggregateValues[i];
                if (a != null) {
                    result.aggregates.Add(new QueryAggregateValue(a.Column(), a.Mode(),
                        a.Kind(), a.Text(), a.Number()));
                }
            }
        }
        return result;
    }

    // 本页是否覆盖显示行索引 row。
    bool Covers(int row) {
        return row >= this.start && row < this.start + this.rows.Count;
    }

    // 结果的 start/count/cursor 与视口完全一致；viewport 为 null 返回 false。
    bool MatchesViewport(QueryViewport viewport) {
        if (viewport == null) { return false; }
        return this.start == viewport.Start()
            && this.requestedCount == viewport.Count()
            && this.cursor == viewport.Cursor();
    }

    // 覆盖 row 时返回该行快照，否则返回 null。
    QueryRow RowAt(int row) {
        if (!this.Covers(row)) { return null; }
        return this.rows[row - this.start];
    }

    // 单元格文本；行不存在或行快照无 cells 时为空串。
    string CellText(int row, int col) {
        QueryRow value = this.RowAt(row);
        if (value == null || value.Cells() == null) { return ""; }
        return value.Cells().At(col);
    }

    // 结果身份与 token 的六个字段完全一致；token 为 null 返回 false。
    bool Matches(QueryRequestToken token) {
        if (token == null) { return false; }
        return this.requestId == token.RequestId()
            && this.generation == token.Generation()
            && this.queryText == token.QueryText()
            && this.queryHash == token.QueryHash()
            && this.schemaVersion == token.SchemaVersion()
            && this.serverRevision == token.ServerRevision();
    }

    // 缓存页不属于某一次请求；命中后只替换传输身份和视口元数据，
    // 行快照本身保持共享，从而让 Poll() 按新 token 完成生命周期校验。
    QueryResult Rebind(QueryRequestToken token, QueryViewport viewport) {
        if (token == null || viewport == null || !this.MatchesViewport(viewport)) {
            return null;
        }
        QueryResult result = new QueryResult(token.RequestId(), token.Generation(),
            token.QueryText(), token.QueryHash(), token.SchemaVersion(), token.ServerRevision(),
            viewport.Start(), viewport.Count(), viewport.Cursor(), this.rows,
            this.total, this.totalKnown, this.hasMore, this.continuation, this.error);
        for (int i = 0; i < this.groups.Count; i = i + 1) {
            result.groups.Add(new QueryGroupBucket(this.groups[i].Key(), this.groups[i].Count()));
        }
        for (int i = 0; i < this.aggregates.Count; i = i + 1) {
            QueryAggregateValue a = this.aggregates[i];
            result.aggregates.Add(new QueryAggregateValue(a.Column(), a.Mode(),
                a.Kind(), a.Text(), a.Number()));
        }
        return result;
    }
}
