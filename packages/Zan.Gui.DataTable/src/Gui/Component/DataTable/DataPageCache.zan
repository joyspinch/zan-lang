using System;

namespace Gui.Component.DataTable;

// 按字节预算的确定性页缓存。实现使用小型数组，避免把线性 HashSet
// 当作高速索引；容量通常只包含当前视口附近的几十页，命中时更新 LRU。
public class DataPageCache {
    int byteBudget;
    int bytes;
    int clock;
    List<DataPageCacheEntry> entries;

    // 以字节预算构造缓存；预算钳制到 >=1。
    DataPageCache(int budget) {
        this.byteBudget = budget;
        if (this.byteBudget < 1) { this.byteBudget = 1; }
        this.bytes = 0;
        this.clock = 0;
        this.entries = new List<DataPageCacheEntry>();
    }

    // 缓存字节预算。
    int ByteBudget() { return this.byteBudget; }
    // 当前占用字节数。
    int Bytes() { return this.bytes; }
    // 缓存的页数。
    int Count() { return this.entries.Count; }

    // 按页键查找条目下标；未命中返回 -1。
    int Find(DataPageKey key) {
        for (int i = 0; i < this.entries.Count; i = i + 1) {
            if (this.entries[i].Key().Same(key)) { return i; }
        }
        return -1;
    }

    // 命中时返回页结果并刷新 LRU 时钟；未命中返回 null。
    QueryResult Get(DataPageKey key) {
        int at = this.Find(key);
        if (at < 0) { return null; }
        this.clock = this.clock + 1;
        this.entries[at].lastUse = this.clock;
        return this.entries[at].Result();
    }

    // 按查询身份（dataset/text/hash + generation/schema/server）查找
    // 覆盖 row 的页并刷新 LRU；未命中返回 null。
    QueryResult GetRow(QueryDescriptor query, int generation,
                       int schema, int server, int row) {
        if (query == null || row < 0) { return null; }
        string dataset = query.Dataset();
        string text = query.QueryJson();
        int hash = query.QueryFingerprint();
        for (int i = 0; i < this.entries.Count; i = i + 1) {
            DataPageCacheEntry e = this.entries[i];
            DataPageKey k = e.Key();
            if (k.Dataset() == dataset && k.QueryText() == text
                && k.QueryHash() == hash && k.Generation() == generation
                && k.SchemaVersion() == schema && k.ServerRevision() == server
                && e.Result().Covers(row)) {
                this.clock = this.clock + 1;
                e.lastUse = this.clock;
                return e.Result();
            }
        }
        return null;
    }

    // 设置页的固定标志；页不存在时为空操作。
    void SetPinned(DataPageKey key, bool value) {
        int at = this.Find(key);
        if (at >= 0) { this.entries[at].pinned = value; }
    }

    // 除 excluded 外最久未使用且未固定的条目下标；没有返回 -1。
    int OldestEvictableExcept(int excluded) {
        int found = -1;
        int stamp = 2147483647;
        for (int i = 0; i < this.entries.Count; i = i + 1) {
            DataPageCacheEntry e = this.entries[i];
            if (i != excluded && !e.Pinned() && e.LastUse() < stamp) {
                found = i;
                stamp = e.LastUse();
            }
        }
        return found;
    }

    // 除 excluded 外可淘汰（未固定）条目的字节总量。
    int EvictableBytesExcept(int excluded) {
        int total = 0;
        for (int i = 0; i < this.entries.Count; i = i + 1) {
            if (i != excluded && !this.entries[i].Pinned()) {
                total = total + this.entries[i].Bytes();
            }
        }
        return total;
    }

    // 全缓存中最久未使用且未固定的条目下标；没有返回 -1。
    int OldestEvictable() { return this.OldestEvictableExcept(-1); }

    // 淘汰一个最久未使用的未固定页；无可淘汰返回 false。
    bool EvictOne() {
        int at = this.OldestEvictable();
        if (at < 0) { return false; }
        this.bytes = this.bytes - this.entries[at].Bytes();
        this.entries.RemoveAt(at);
        return true;
    }

    // 插入/替换一页。单页大于预算时不缓存，但仍允许当前查询使用。
    bool Put(DataPageKey key, QueryResult result, int byteSize) {
        if (key == null || result == null) { return false; }
        if (byteSize < 0) { return false; }
        if (byteSize > this.byteBudget) { return false; }
        int old = this.Find(key);
        int oldBytes = 0;
        bool preservePinned = false;
        if (old >= 0) {
            oldBytes = this.entries[old].Bytes();
            preservePinned = this.entries[old].Pinned();
        }
        if (this.bytes < oldBytes) { return false; }
        if (byteSize > 2147483647 - (this.bytes - oldBytes)) { return false; }
        int projected = this.bytes - oldBytes + byteSize;
        if (projected < 0) { return false; }
        if (projected > this.byteBudget) {
            int need = projected - this.byteBudget;
            if (need > this.EvictableBytesExcept(old)) { return false; }
        }
        while (this.bytes - oldBytes + byteSize > this.byteBudget) {
            int victim = this.OldestEvictableExcept(old);
            if (victim < 0) { return false; }
            this.bytes = this.bytes - this.entries[victim].Bytes();
            this.entries.RemoveAt(victim);
            if (old > victim) { old = old - 1; }
        }
        if (old >= 0) {
            this.bytes = this.bytes - this.entries[old].Bytes();
            this.entries.RemoveAt(old);
        }
        this.clock = this.clock + 1;
        DataPageCacheEntry replacement =
            new DataPageCacheEntry(key, result, byteSize, this.clock);
        replacement.pinned = preservePinned;
        this.entries.Add(replacement);
        this.bytes = this.bytes + byteSize;
        return true;
    }

    // 清空缓存并归零字节数。
    void Clear() {
        this.entries.Clear();
        this.bytes = 0;
    }
}
