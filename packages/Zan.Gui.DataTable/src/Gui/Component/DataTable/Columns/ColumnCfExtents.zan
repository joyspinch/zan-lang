using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// 列条件格式范围与极值统计实体（消除 cfMin/cfMax 与 cfMinR/cfMaxR 平行列表反模式）。
public class ColumnCfExtents {
    public int min;
    public int max;
    public double minReal;
    public double maxReal;

    public ColumnCfExtents() {
        this.min = 0;
        this.max = 0;
        this.minReal = 0.0;
        this.maxReal = 0.0;
    }

    public ColumnCfExtents(int min, int max, double minReal, double maxReal) {
        this.min = min;
        this.max = max;
        this.minReal = minReal;
        this.maxReal = maxReal;
    }
}
