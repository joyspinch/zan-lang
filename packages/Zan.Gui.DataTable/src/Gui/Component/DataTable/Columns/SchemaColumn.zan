using System;

namespace Gui.Component.DataTable;

// DataTable 列的稳定身份和类型描述。DataColumn 仍是现有渲染/编辑
// 配置的兼容入口；SchemaColumn 用于新查询、缓存和扩展能力。
public class SchemaColumn {
    string id;
    string field;
    int valueType;
    string rendererId;
    string editorId;
    bool nullable;

    // 构造列描述：渲染器/编辑器默认 "text"，默认可空。
    SchemaColumn(string columnId, string fieldName, int kind) {
        this.id = columnId;
        this.field = fieldName;
        this.valueType = kind;
        this.rendererId = "text";
        this.editorId = "text";
        this.nullable = true;
    }

    // 列稳定标识。
    string Id() { return this.id; }
    // 数据字段名（cell 增量按名寻址）。
    string Field() { return this.field; }
    // 值类型，按 TableValue 的 kind 编号（0 null、1 text、2 int、3 real、4 bool、5 day）。
    int ValueType() { return this.valueType; }
    // 列是否允许空值。
    bool Nullable() { return this.nullable; }
}
