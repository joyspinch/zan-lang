using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// 列汇总聚合状态强类型实体（消除 aggMode/aggValue/aggReal/summaryText 平行列表反模式）。
public class ColumnAggregateState {
    public int mode;
    public int value;
    public double realValue;
    public string summaryText;

    public ColumnAggregateState() {
        this.mode = 0;
        this.value = 0;
        this.realValue = 0.0;
        this.summaryText = "";
    }

    public ColumnAggregateState(int mode, int value, double realValue, string summaryText) {
        this.mode = mode;
        this.value = value;
        this.realValue = realValue;
        this.summaryText = summaryText != null ? summaryText : "";
    }
}
