using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// DataTable 的列描述符。
// cellType：0 文本，1 链接，2 标签，3 进度，4 徽章，5 图片，
// 6 图标，7 按钮，8 图表，9 组件
// align：0 左对齐，1 居中，2 右对齐
public class DataColumn {
    public string title;
    public string field;
    public int width;
    public int cellType;
    public int align;
    public bool sortable;
    public bool filterable;
    public bool resizable;
    public int tagType;
    public bool numeric;
    public int summary;  // 总计行聚合：0 无，1 总和，2 平均，3 最小，4 最大，5 计数，6 派生，7 勾选行数
    public string summaryFmt;
    public CustomSummaryProvider customSummary;

    // ---- 派生汇总（summary==6） ----
    public int deriveOp;
    public int deriveA;
    public int deriveB;

    // ---- 条件格式 ----
    public int cfMode;  // 0 无，1 数据条，2 色阶，3 高亮 >，4 高 <，5 前 N，6 后 N
    public int cfColor;
    public int cfColor2;
    public int cfThreshold;
    public bool cfRankPct;

    // ---- 显示格式化 ----
    public int fmt;
    public bool grouped;
    public string prefix;
    public string suffix;
    public int decimals;
    public string formula;

    // ---- 日期列 ----
    public bool isDate;
    public int dateOrder;
    public int dateFmt;
    public int dateGroup;

    // ---- bool 列 ----
    public bool isBool;
    public int boolStyle;
    public string boolTrue;
    public string boolFalse;

    // ---- 编辑 ----
    public bool editable;

    // ---- 图标 / 按钮 / 图表列（cellType 6/7/8）----
    public string btnIcon;
    public string btnClass;
    public bool sparkArea;
    public int sparkKind;
    public int sparkColor;
    public int sparkNegColor;

    // ---- 组件列插槽（CellWidgetProvider）----
    public CellWidgetProvider widgetProvider;

    public int editorKind;
    public List<string> choices;
    public bool choicesStrict;
    public double editStep;

    // ---- 声明式校验 ----
    public bool required;
    public int maxLength;
    public bool hasMin;
    public bool hasMax;
    public double editMin;
    public double editMax;

    // ---- 固定 / 冻结 / 多级表头 / 合并 / 换行 ----
    public int freeze;
    public string band;
    public string description;
    public bool mergeSame;
    public bool wrapText;
    public int wrapLines;

    // ---- 现代单元格体系（Renderer / Editor / Slot 模板对齐） ----
    public CellRenderer renderer;
    public CellEditor editor;
    public string slot;
    public CellValidator validator;

    public DataColumn() : this("", 100) { }

    public DataColumn(string title, int width) {
        this.title = title;
        this.field = "";
        this.width = width;
        this.cellType = 0;
        this.align = 0;
        this.sortable = true;
        this.filterable = true;
        this.resizable = true;
        this.tagType = 1;
        this.numeric = false;
        this.summary = 0;
        this.summaryFmt = "";
        this.customSummary = null;
        this.validator = null;
        this.deriveOp = 0;
        this.deriveA = 0;
        this.deriveB = -1;
        this.cfMode = 0;
        this.cfColor = 0;
        this.cfColor2 = 0;
        this.cfThreshold = 0;
        this.cfRankPct = false;
        this.fmt = 0;
        this.grouped = false;
        this.prefix = "";
        this.suffix = "";
        this.decimals = 0;
        this.formula = "";
        this.isDate = false;
        this.dateOrder = 0;
        this.dateFmt = 0;
        this.dateGroup = 0;
        this.isBool = false;
        this.boolStyle = 0;
        this.boolTrue = "true";
        this.boolFalse = "false";
        this.editable = false;
        this.editorKind = 0;
        this.btnIcon = "";
        this.btnClass = "";
        this.sparkArea = false;
        this.sparkKind = 0;
        this.sparkColor = 0;
        this.sparkNegColor = 0;
        this.choices = new List<string>();
        this.choicesStrict = true;
        this.editStep = 1.0;
        this.required = false;
        this.maxLength = 0;
        this.hasMin = false;
        this.hasMax = false;
        this.editMin = 0.0;
        this.editMax = 0.0;
        this.freeze = 0;
        this.band = "";
        this.description = "";
        this.mergeSame = false;
        this.wrapText = false;
        this.wrapLines = 2;
        this.renderer = null;
        this.editor = null;
        this.slot = "";
    }

    // ---- 声明式属性（支持 new DataColumn { Title = ..., Width = ..., ... }） ----
    public string Title {
        get { return this.title; }
        set { this.title = value != null ? value : ""; }
    }

    public int Width {
        get { return this.width; }
        set { this.width = value; }
    }

    public string ColumnKey {
        get { return this.field; }
        set { this.field = value != null ? value : ""; }
    }

    public int CellType {
        get { return this.cellType; }
        set { this.cellType = value; }
    }

    public int Alignment {
        get { return this.align; }
        set { this.align = value; }
    }

    public bool IsSortable {
        get { return this.sortable; }
        set { this.sortable = value; }
    }

    public bool IsFilterable {
        get { return this.filterable; }
        set { this.filterable = value; }
    }

    public bool IsResizable {
        get { return this.resizable; }
        set { this.resizable = value; }
    }

    public bool IsEditable {
        get { return this.editable; }
        set { this.editable = value; }
    }

    public bool IsNumeric {
        get { return this.numeric; }
        set { this.numeric = value; }
    }

    public bool IsBool {
        get { return this.isBool; }
        set { this.isBool = value; }
    }

    public bool IsDate {
        get { return this.isDate; }
        set { this.isDate = value; }
    }

    public int Freeze {
        get { return this.freeze; }
        set { this.freeze = value; }
    }

    public string BandPath {
        get { return this.band; }
        set { this.band = value != null ? value : ""; }
    }

    public string Description {
        get { return this.description; }
        set { this.description = value != null ? value : ""; }
    }

    public int SummaryKind {
        get { return this.summary; }
        set { this.summary = value; }
    }

    public string SummaryFormat {
        get { return this.summaryFmt; }
        set { this.summaryFmt = value != null ? value : ""; }
    }

    public CellRenderer CellRenderer {
        get { return this.renderer; }
        set { this.renderer = value; }
    }

    public CellEditor CellEditor {
        get { return this.editor; }
        set {
            this.editor = value;
            if (value != null) { this.editable = true; }
        }
    }

    public Control EditorControl {
        set {
            this.editor = value != null ? new ControlCellEditor(value) : null;
            if (value != null) { this.editable = true; }
        }
    }

    public string SlotName {
        get { return this.slot; }
        set { this.slot = value != null ? value : ""; }
    }

    public CellValidator Validator {
        get { return this.validator; }
        set { this.validator = value; }
    }

    public CustomSummaryProvider CustomSummary {
        get { return this.customSummary; }
        set { this.customSummary = value; }
    }

    public string FieldName() {
        return this.field;
    }

    public void Derive(int op, int a, int b) {
        this.summary = 6;
        this.deriveOp = op;
        this.deriveA = a;
        this.deriveB = b;
    }

    // ---- 静态配置与工厂辅助方法 ----
    public static DataColumn Renderer(DataColumn c, CellRenderer r) {
        c.renderer = r;
        return c;
    }

    public static DataColumn Editor(DataColumn c, CellEditor e) {
        c.editor = e;
        c.editable = true;
        return c;
    }

    public static DataColumn ControlEditor(DataColumn c, Control widget) {
        c.editor = new ControlCellEditor(widget);
        c.editable = true;
        return c;
    }

    public static DataColumn ControlEditorCustom(DataColumn c, Control widget, CellValueSetter setter, CellValueGetter getter) {
        c.editor = new ControlCellEditor(widget, setter, getter);
        c.editable = true;
        return c;
    }

    public static DataColumn Slot(DataColumn c, string slotName) {
        c.slot = slotName;
        return c;
    }

    public static DataColumn Field(DataColumn c, string name) {
        c.field = name;
        return c;
    }

    public static DataColumn Describe(DataColumn c, string text) {
        c.description = text;
        return c;
    }

    public static DataColumn Editable(DataColumn c) {
        c.editable = true;
        return c;
    }

    public static DataColumn Dropdown(DataColumn c, List<string> items, bool strict) {
        c.editable = true;
        c.editorKind = 1;
        c.choices = items;
        c.choicesStrict = strict;
        return c;
    }

    public static DataColumn DatePicker(DataColumn c) {
        c.editable = true;
        c.editorKind = 2;
        c.isDate = true;
        return c;
    }

    public static DataColumn Spinner(DataColumn c, double step) {
        c.editable = true;
        c.editorKind = 3;
        c.numeric = true;
        c.align = 2;
        if (step <= 0.0) { step = 1.0; }
        c.editStep = step;
        return c;
    }

    public static DataColumn Required(DataColumn c) {
        c.required = true;
        return c;
    }

    public static DataColumn MaxLength(DataColumn c, int n) {
        if (n < 0) { n = 0; }
        c.maxLength = n;
        return c;
    }

    public static DataColumn Range(DataColumn c, double lo, double hi) {
        c.numeric = true;
        c.hasMin = true;
        c.hasMax = true;
        c.editMin = lo;
        c.editMax = hi;
        return c;
    }

    public static DataColumn Pin(DataColumn c) {
        c.freeze = 1;
        return c;
    }

    public static DataColumn PinRight(DataColumn c) {
        c.freeze = 2;
        return c;
    }

    public static DataColumn Band(DataColumn c, string path) {
        c.band = path;
        return c;
    }

    public static DataColumn Decimals(DataColumn c, int n) {
        if (n < 0) { n = 0; }
        c.decimals = n;
        c.numeric = true;
        c.align = 2;
        if (n > 0) { c.fmt = 1; }
        return c;
    }

    public static DataColumn Real(string title, int width, int decimals) {
        return DataColumn.Decimals(new DataColumn(title, width), decimals);
    }

    public static DataColumn Formula(string title, int width, string expr) {
        return DataColumn.Formula(new DataColumn(title, width), expr);
    }

    public static DataColumn Formula(DataColumn c, string expr) {
        c.formula = expr;
        if (expr.Length > 0) {
            c.numeric = true;
            c.align = 2;
            c.editable = false;
            c.isDate = false;
            c.isBool = false;
            if (c.decimals == 0) { c.decimals = 2; }
            if (c.fmt == 0) { c.fmt = 1; }
        }
        return c;
    }

    public static DataColumn AsDate(DataColumn c, int order) {
        c.isDate = true;
        c.dateOrder = order;
        c.numeric = false;
        return c;
    }

    public static DataColumn Date(string title, int width) {
        return DataColumn.AsDate(new DataColumn(title, width), 0);
    }

    public static DataColumn DateFormat(DataColumn c, int fmt) {
        c.isDate = true;
        c.dateFmt = fmt;
        return c;
    }

    public static DataColumn DateGroup(DataColumn c, int mode) {
        c.isDate = true;
        c.dateGroup = mode;
        return c;
    }

    public static DataColumn AsBool(DataColumn c, int style) {
        c.isBool = true;
        c.boolStyle = style;
        c.align = 1;
        c.numeric = false;
        return c;
    }

    public static DataColumn Bool(string title, int width) {
        return DataColumn.AsBool(new DataColumn(title, width), 0);
    }

    public static DataColumn BoolText(DataColumn c, string yes, string no) {
        c.isBool = true;
        c.boolTrue = yes;
        c.boolFalse = no;
        return c;
    }

    public static DataColumn Money(DataColumn c, string symbol) {
        c.fmt = 1;
        c.grouped = true;
        c.prefix = symbol;
        c.numeric = true;
        c.align = 2;
        if (c.decimals == 0) { c.decimals = 2; }
        return c;
    }

    public static DataColumn Percent(DataColumn c) {
        c.fmt = 1;
        c.suffix = "%";
        c.numeric = true;
        c.align = 2;
        return c;
    }

    public static DataColumn Grouped(DataColumn c) {
        c.fmt = 1;
        c.grouped = true;
        c.numeric = true;
        c.align = 2;
        return c;
    }

    public static DataColumn Affix(DataColumn c, string prefix, string suffix) {
        c.fmt = 1;
        c.prefix = prefix;
        c.suffix = suffix;
        return c;
    }

    public static DataColumn DataBar(DataColumn c, int color) {
        c.cfMode = 1;
        c.cfColor = color;
        return c;
    }

    public static DataColumn ColorScale(DataColumn c, int lowColor, int highColor) {
        c.cfMode = 2;
        c.cfColor = lowColor;
        c.cfColor2 = highColor;
        return c;
    }

    public static DataColumn HighlightGreater(DataColumn c, int threshold, int color) {
        c.cfMode = 3;
        c.cfThreshold = threshold;
        c.cfColor = color;
        return c;
    }

    public static DataColumn HighlightLess(DataColumn c, int threshold, int color) {
        c.cfMode = 4;
        c.cfThreshold = threshold;
        c.cfColor = color;
        return c;
    }

    public static DataColumn TopRules(DataColumn c, int countOrPct, int color) {
        if (countOrPct < 0) { c.cfMode = 5; c.cfThreshold = 0 - countOrPct; c.cfRankPct = true; }
        else { c.cfMode = 5; c.cfThreshold = countOrPct; c.cfRankPct = false; }
        c.cfColor = color;
        return c;
    }

    public static DataColumn BottomRules(DataColumn c, int countOrPct, int color) {
        if (countOrPct < 0) { c.cfMode = 6; c.cfThreshold = 0 - countOrPct; c.cfRankPct = true; }
        else { c.cfMode = 6; c.cfThreshold = countOrPct; c.cfRankPct = false; }
        c.cfColor = color;
        return c;
    }

    public static DataColumn NotResizable(DataColumn c) {
        c.resizable = false;
        return c;
    }

    public static DataColumn Merge(DataColumn c) {
        c.mergeSame = true;
        return c;
    }

    public static DataColumn Wrap(DataColumn c, int maxLines) {
        if (maxLines < 1) { maxLines = 2; }
        c.wrapText = true;
        c.wrapLines = maxLines;
        return c;
    }

    public static DataColumn Text(string title, int width) {
        return new DataColumn(title, width);
    }

    public static DataColumn Numeric(string title, int width) {
        DataColumn c = new DataColumn(title, width);
        c.numeric = true;
        c.align = 2;
        return c;
    }

    public static DataColumn Link(string title, int width) {
        DataColumn c = new DataColumn(title, width);
        c.cellType = 1;
        return c;
    }

    public static DataColumn TagCol(string title, int width, int tagType) {
        DataColumn c = new DataColumn(title, width);
        c.cellType = 2;
        c.tagType = tagType;
        c.align = 1;
        return c;
    }

    public static DataColumn ProgressCol(string title, int width) {
        DataColumn c = new DataColumn(title, width);
        c.cellType = 3;
        c.numeric = true;
        return c;
    }

    public static DataColumn BadgeCol(string title, int width) {
        DataColumn c = new DataColumn(title, width);
        c.cellType = 4;
        c.align = 1;
        return c;
    }

    public static DataColumn ImageCol(string title, int width) {
        DataColumn c = new DataColumn(title, width);
        c.cellType = 5;
        c.align = 1;
        return c;
    }

    public static DataColumn IconCol(string title, int width) {
        DataColumn c = new DataColumn(title, width);
        c.cellType = 6;
        c.align = 1;
        c.sortable = false;
        c.filterable = false;
        return c;
    }

    public static DataColumn ButtonCol(string title, int width, string icon, string cls) {
        DataColumn c = new DataColumn(title, width);
        c.cellType = 7;
        c.align = 1;
        c.btnIcon = icon;
        c.btnClass = cls;
        c.sortable = false;
        c.filterable = false;
        c.editable = false;
        return c;
    }

    public static DataColumn SparklineCol(string title, int width, bool area) {
        DataColumn c = new DataColumn(title, width);
        c.cellType = 8;
        c.align = 1;
        c.btnIcon = "";
        c.btnClass = "";
        c.sparkArea = area;
        c.sparkKind = 0;
        c.sparkColor = 0;
        c.sparkNegColor = 0;
        c.sortable = false;
        c.filterable = false;
        return c;
    }

    public static DataColumn SparkKind(DataColumn c, int kind) {
        if (kind < 0 || kind > 2) { kind = 0; }
        c.sparkKind = kind;
        return c;
    }

    public static DataColumn SparkColors(DataColumn c, int posColor, int negColor) {
        c.sparkColor = posColor;
        c.sparkNegColor = negColor;
        return c;
    }

    public static DataColumn WidgetSlot(string title, int width, CellWidgetProvider provider) {
        DataColumn c = new DataColumn(title, width);
        c.widgetProvider = provider;
        c.sortable = false;
        c.filterable = false;
        c.editable = false;
        return c;
    }

    public static DataColumn Derived(string title, int width, int op, int a, int b) {
        DataColumn c = new DataColumn(title, width);
        c.numeric = true;
        c.align = 2;
        c.summary = 6;
        c.deriveOp = op;
        c.deriveA = a;
        c.deriveB = b;
        return c;
    }

    public static void Derive(DataColumn c, int op, int a, int b) {
        c.Derive(op, a, b);
    }

    public static DataColumn Sum(DataColumn c) {
        c.summary = 1;
        return c;
    }

    public static DataColumn Avg(DataColumn c) {
        c.summary = 2;
        return c;
    }

    public static DataColumn SummaryFmt(DataColumn c, string fmt) {
        c.summaryFmt = fmt;
        return c;
    }
}
