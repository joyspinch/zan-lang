using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// DataTable 的列描述符。
// cellType：0 文本，1 链接，2 标签，3 进度，4 徽章，5 图片，
// 6 图标，7 按钮，8 图表，9 组件
// align：0 左对齐，1 居中，2 右对齐
public class DataColumn {
    public string title;
    // 该列的稳定名称，与位置及其
    // （可翻译的）标题无关。用 `DataColumn.Field(c, "name")` 设置，
    // 传给 `DataTable.Col(cols, "name")` 获取索引，
    // 使应用代码和保存的布局在列被插入、移动或重命名后依然有效。
    // 空表示“未命名”：此类列只能按索引访问。
    public string field;
    public int width;
    public int cellType;
    public int align;
    public bool sortable;
    public bool filterable;
    public bool resizable;
    public int tagType;
    public bool numeric;
    public int summary;  // 总计行聚合：0 无，1 总和，2 平均，3 最小，4 最大，5 计数，6 派生，7 勾选行数
    // 聚合文案模板（DevExpress SummaryItem.DisplayFormat 等位）：
    // 非空时页脚显示模板，{0} 替换为聚合值，{0:0.##} 等带格式
    // 说明的占位符按说明渲染（如「合计{0:0.##}行:」→「合计3.5行:」）。
    public string summaryFmt;
    public CustomSummaryProvider customSummary; // 自定义汇总计算器（对标 DevExpress CustomSummaryCalculate）

    // ---- 派生汇总（summary==6）：由其他列的聚合值计算，
    // 因此为 O(1)，从不扫描行。
    // deriveOp：0 百分比 (A*100/B)，1 比值 (A/B)，2 差值 (A-B)，3 和 (A+B)，4 积 (A*B)
    // deriveA / deriveB：聚合值作为运算输入的源列索引
    public int deriveOp;
    public int deriveA;
    public int deriveB;

    // ---- 条件格式 ----
    public int cfMode;  // 0 无，1 数据条，2 色阶，3 高亮 >，4 高 <，5 前 N，6 后 N
    public int cfColor;  // 数据条/低端/高亮的强调色
    public int cfColor2;  // 色阶高端颜色
    public int cfThreshold;  // 高亮比较值；Top/Bottom 规则时为 N（项数或百分比）
    // Top/Bottom 规则的 N 按百分比解释（cfMode 5/6）。
    public bool cfRankPct;

    // ---- 显示格式化（仅影响渲染字符串；排序/过滤
    // 仍看到原始单元格值） ----
    public int fmt;  // 0 原始，1 格式化（前缀 + 可选分组数字 + 后缀）
    public bool grouped;  // 在整数部分插入千位分隔符
    public string prefix;  // 前置文本，例如货币符号
    public string suffix;  // 尾部文本，例如“%”

    // 数值列的小数位数。0 保持原有的整数
    // 路径（通过 CellNum 排序/聚合）；> 0 将该列切换到实数
    // 路径：值解析为 double，比较和汇总不丢失
    // 小数部分，并精确渲染到这么多位小数。
    public int decimals;

    // 计算列的表达式（见 DataTable.Formula.zan）。空串表示普通列。
    // 非空时该列的值不来自数据源，而是对每行求值表达式：
    // 四则运算、括号、一元负号、数字字面量和
    // （按 field 名解析，回退按 title）。列自动切换到
    // decimals 位小数的实数路径（排序/聚合/条件格式一致），
    // 且不可编辑——公式列是派生只读输出。
    public string formula;

    // ---- 日期列 ----
    // isDate 将该列切换到天数键路径：单元格用 ParseDate 解析，
    // 按自纪元起的天数排序和分组，并用 FormatDate 渲染。
    // dateOrder 指定*存储*文本的字段顺序
    // （0 y-m-d，1 d-m-y，2 m-d-y）；dateFmt 指定渲染格式；
    // dateGroup 在分组时对值分桶（0 日，1 年，2 月，
    // 3 季度，4 星期）。
    public bool isDate;
    public int dateOrder;
    public int dateFmt;
    public int dateGroup;

    // ---- bool 列 ----
    // isBool 将该列切换到真值键路径：单元格用 ParseBool 读取，
    // 按 false 在前 true 在后排序，并按 boolStyle 绘制
    // （0 复选框，1 对勾/叉字形，2 文本）。boolTrue/boolFalse 指定切换时
    // 写回的文本形式，样式 2 也用它显示。
    public bool isBool;
    public int boolStyle;
    public string boolTrue;
    public string boolFalse;

    // ---- 编辑 ----
    public bool editable;  // 单元格值可内联编辑（需显式开启）

    // ---- 图标 / 按钮 / 图表列（cellType 6/7/8）----
    // 图标列（6）：单元格值即 tabler 图标名（如 "check"），
    // 用 Canvas.DrawGlyph 以 datatable::icon 的前景色绘制；
    // 空值画空。不参与编辑、汇总与 tooltip。
    // 按钮列（7）：单元格值作为按钮标签（空值画图标按钮，
    // 用 btnIcon）；整格热区居中一个 small 按钮，
    // 点击把 hitRow/hitCol 指向本格后 Raise CellClick。
    // 不参与编辑与内联校验。
    // 图表列（8）：单元格值是以逗号分隔的数值序列（如
    // "12,18,9,24"，宽松实数解析），按 sparkKind 画格内
    // 迷你图：0 柱状（默认，历史行为），1 折线（抗锯齿
    // 折线 + 末点强调），2 面积（折线 + 基线填充）。含
    // 负值的序列以零基线分区：正值向上用 sparkColor，
    // 负值向下用 sparkNegColor（Excel 迷你图惯例）。
    // 序列为空画空。不参与编辑、汇总与 tooltip。
    public string btnIcon;  // 按钮列的图标（值为空时的按钮内容）
    public string btnClass;  // 按钮列的 class（如 "primary"、"danger text"）
    public bool sparkArea;  // 柱状形态是否在柱下画半透明面积（历史字段）
    public int sparkKind;  // 图表形态：0 柱状，1 折线，2 面积
    public int sparkColor;  // 正值/线条色（0 = 主题 accent 自动）
    public int sparkNegColor;  // 负值色（0 = 主题 danger 自动）

    // ---- 组件列（cellType 9 数值序列 / cellType 10 字符串值）----
    // 渲染层按 compId 从 CellComp 注册表取适配器，把单元格值
    // 灌进一个池化的真控件（BandGrid、Switch、SelectBox 等），
    // 控件按格矩形渲染、事件归一为 CellClick；WidgetCol 形态
    // 的改动经 TakeCommit 走编辑通道写回。序列化边界在引擎内
    // 部——使用层只见类型化访问器（GridNums<T>/GridText<T>），
    // 不接触控件与绘制。
    public CellWidgetProvider widgetProvider;  // 列级标准真控件互嵌提供器（任意 Gui.Widget 零适配器互嵌，Visual Tree 统一路由）
    public string compId;  // CellComp 注册表键（如 "bandgrid"）
    public bool actionOnly;  // 动作按钮组：点击是命令不落选区（不回写标签）
    public bool vTop;  // 组件列排列：默认格内垂直居中，置真改顶对齐
    public int shapeR;  // 矩阵形状：行数（shapeC 为列数；<=0 用组件默认）
    public int shapeC;
    public string heatBand;  // 数值→色带名（"" 关闭；见 HeatBands）

    // 单元格打开的编辑器：0 = 纯文本框；1 = 下拉框，从
    // `choices` 中选取；2 = 日历，用于日期列；3 = 数字微调器，按
    // `editStep` 步进。bool 列忽略此项——它们在原地切换。
    public int editorKind;
    public List<string> choices;  // 下拉项（editorKind 1）
    public bool choicesStrict;  // 下拉框：拒绝不在 `choices` 中的值
    public double editStep;  // 微调器步长（editorKind 3）

    // 声明式校验，提交时在 CellValidating 事件
    // 之前检查。列可以任意组合使用。
    public bool required;  // 拒绝空值
    public int maxLength;  // 拒绝过长输入（0 = 不限）
    public bool hasMin;  // 将 editMin 作为下界强制生效
    public bool hasMax;  // 将 editMax 作为上界强制生效
    public double editMin;
    public double editMax;

    // ---- 固定 / 冻结 ----
    // 0 = 随其余列滚动，1 = 冻结在左边缘，2 = 冻结在
    // 右边缘。冻结列被提升出滚动带区，
    // 中间区域在其下方平移时保持屏幕位置不变。
    public int freeze;

    // ---- band（多级表头） ----
    // 该列所属表头分组的斜杠分隔路径，最外层
    // 在前：“”为不分组，“Contact”一层，“Contact/Address”两层。
    // 表头每层增加一行，分组横跨相邻的
    // 共享路径的列——因此分组是列自身的属性，
    // 不可能与列失去同步。
    public string band;

    // 表头悬停提示：指针在列标题上停留 DefaultDelayMs 后弹出
    // 的完整说明（两行式：标题=列名，描述=本字段）。空串 =
    // 不弹提示。
    public string description;

    // ---- 合并单元格 ----
    // mergeSame 为 true 时，同一列里文本相同且相邻的数据行
    // （中间不隔组表头/详情带）渲染为一个纵向合并格——VTable
    // "同值相邻合并"的同类项。仅影响渲染：排序/筛选/导出
    // 仍逐行看到各自的值，编辑也仍写回所在行的底层单元格。
    public bool mergeSame;

    // ---- 文本换行（自动行高） ----
    // wrapText 为 true 时（cellType 0）单元格文本按列宽折行
    // 最多 wrapLines 行，行高相应增大——整个网格统一行高的
    // 约定保持不变（虚拟化的 slot*rowH 寻址依赖它），需要的
    // 行数按过滤集合的抽样统计（见 ComputeFrame 的
    // WrapRowHeight），因此是"网格长高"而非逐行变高。
    public bool wrapText;
    public int wrapLines;

    // ---- 现代单元格体系（Renderer / Editor / Slot 模板对齐） ----
    public CellRenderer renderer;
    public CellEditor editor;
    public string slot;
    public CellValidator validator;

    public DataColumn(string title, int width) {
        this.title = title;
        this.field = "";
        this.width = width;
        this.cellType = 0;
        this.align = 0;
        this.sortable = true;
        this.filterable = true;
        this.resizable = true;
        this.tagType = 1;
        this.numeric = false;
        this.summary = 0;
        this.summaryFmt = "";
        this.customSummary = null;
        this.validator = null;
        this.deriveOp = 0;
        this.deriveA = 0;
        this.deriveB = -1;
        this.cfMode = 0;
        this.cfColor = 0;
        this.cfColor2 = 0;
        this.cfThreshold = 0;
        this.cfRankPct = false;
        this.fmt = 0;
        this.grouped = false;
        this.prefix = "";
        this.suffix = "";
        this.decimals = 0;
        this.formula = "";
        this.isDate = false;
        this.dateOrder = 0;
        this.dateFmt = 0;
        this.dateGroup = 0;
        this.isBool = false;
        this.boolStyle = 0;
        this.boolTrue = "true";
        this.boolFalse = "false";
        this.editable = false;
        this.editorKind = 0;
        this.btnIcon = "";
        this.btnClass = "";
        this.sparkArea = false;
        this.sparkKind = 0;
        this.sparkColor = 0;
        this.sparkNegColor = 0;
        this.compId = "";
        this.shapeR = 0;
        this.shapeC = 0;
        this.heatBand = "";
        this.choices = new List<string>();
        this.choicesStrict = true;
        this.editStep = 1.0;
        this.required = false;
        this.maxLength = 0;
        this.hasMin = false;
        this.hasMax = false;
        this.editMin = 0.0;
        this.editMax = 0.0;
        this.freeze = 0;
        this.band = "";
        this.description = "";
        this.mergeSame = false;
        this.wrapText = false;
        this.wrapLines = 2;
        this.renderer = null;
        this.editor = null;
        this.slot = "";
    }

    // 设置该列的自定义享元绘制器（ICellRenderer 享元画笔）
    public static DataColumn Renderer(DataColumn c, CellRenderer r) {
        c.renderer = r;
        return c;
    }

    // 设置该列的悬浮编辑器（ICellEditor 编辑态宿主）
    public static DataColumn Editor(DataColumn c, CellEditor e) {
        c.editor = e;
        c.editable = true;
        return c;
    }

    // 直接传入任意 Gui 控件实例作为该列的编辑器（零胶水代码，基于通用 value 协议）
    public static DataColumn ControlEditor(DataColumn c, Control widget) {
        c.editor = new ControlCellEditor(widget);
        c.editable = true;
        return c;
    }

    // 传入任意 Gui 控件及自定义的 Setter/Getter 数据通道委托（彻底杜绝硬编码，自由接管任意复杂复合组件）
    public static DataColumn ControlEditorCustom(DataColumn c, Control widget, CellValueSetter setter, CellValueGetter getter) {
        c.editor = new ControlCellEditor(widget, setter, getter);
        c.editable = true;
        return c;
    }

    // 设置该列挂载的声明式插槽/模板名（对齐基础组件 Slot / Template 机制）
    public static DataColumn Slot(DataColumn c, string slotName) {
        c.slot = slotName;
        return c;
    }

    // 为列命名，使其可通过 `DataTable.Col(cols, name)` 访问
    // 而非字面索引。与其他构建器一样可组合：
    // ```zan
    // ```
    public static DataColumn Field(DataColumn c, string name) {
        c.field = name; return c;
    }

    // 列的稳定字段名（`Field` 设的名字；未命名列返回 ""）。
    // 命中信息按名消费用（DataGrid.HitField → 列级事件按名分派）。
    public string FieldName() {
        return field;
    }

    // 设置表头悬停提示的描述文本。与其他构建器一样可组合：
    // ```zan
    // DataColumn.Numeric("Score", 120), "0-100 分，越高越好"));
    // ```
    // 指针在列标题上停留约半秒后弹出两行提示（列名 + 此文本）。
    public static DataColumn Describe(DataColumn c, string text) {
        c.description = text; return c;
    }

    // 让列启用内联编辑（双击/第二次单击单元格，或按
    // F2/Enter）。数值列在提交时校验输入。
    public static DataColumn Editable(DataColumn c) {
        c.editable = true; return c;
    }

    // ---- 编辑器配置器（均隐含 Editable） ----
    // 通过下拉列表编辑该列。键入会过滤列表，
    // 默认只接受列表中的值提交；传 `strict = false` 可允许
    // 在建议之外输入自由文本。
    public static DataColumn Dropdown(DataColumn c, List<string> items, bool strict) {
        c.editable = true;
        c.editorKind = 1;
        c.choices = items;
        c.choicesStrict = strict;
        return c;
    }

    // 通过月历编辑该列。隐含 `AsDate`，
    // 所选日期经过该列自身的解析/格式化配对往返。
    public static DataColumn DatePicker(DataColumn c) {
        c.editable = true;
        c.editorKind = 2;
        c.isDate = true;
        return c;
    }

    // 通过数字微调器编辑该列：上/下方向键和 +/- 按钮
    // 按 `step` 步进，值始终保持为数字。
    public static DataColumn Spinner(DataColumn c, double step) {
        c.editable = true;
        c.editorKind = 3;
        c.numeric = true;
        c.align = 2;
        if (step <= 0.0) { step = 1.0; }
        c.editStep = step;
        return c;
    }

    // ---- 声明式校验（提交时检查） ----
    // 拒绝空值。
    public static DataColumn Required(DataColumn c) {
        c.required = true; return c;
    }

    // 拒绝超过 `n` 个字符的输入（0 清除限制）。
    public static DataColumn MaxLength(DataColumn c, int n) {
        if (n < 0) { n = 0; }
        c.maxLength = n; return c;
    }

    // 提交时将数值列限制在 [lo, hi] 内。
    public static DataColumn Range(DataColumn c, double lo, double hi) {
        c.numeric = true;
        c.hasMin = true; c.hasMax = true;
        c.editMin = lo; c.editMax = hi;
        return c;
    }

    // 提交时将数值列限制为 >= lo。
    public static DataColumn MinValue(DataColumn c, double lo) {
        c.numeric = true; c.hasMin = true; c.editMin = lo; return c;
    }

    // 提交时将数值列限制为 <= hi。
    public static DataColumn MaxValue(DataColumn c, double hi) {
        c.numeric = true; c.hasMax = true; c.editMax = hi; return c;
    }

    // 将列冻结在左边缘：它被提升到滚动列之前，
    // 并在它们于其下方平移时保持不动。
    public static DataColumn Pin(DataColumn c) {
        c.freeze = 1; return c;
    }

    // 将列冻结在右边缘，适合放累计总和或行的
    // 操作按钮：无论中间区域滚多远，它始终可及，
    // 这正是把它们放在那里的原因。
    public static DataColumn PinRight(DataColumn c) {
        c.freeze = 2; return c;
    }

    // 将列放入表头分组，表头相应增加一行：
    // ```zan
    // ```
    // 路径相同的相邻列共享一个跨列单元格。
    // 用斜杠嵌套，最外层在前——“Contact/Address”位于一个
    // 同样横跨其他名为 Contact 的列的单元格下。传“”取消分组。
    public static DataColumn Band(DataColumn c, string path) {
        c.band = path; return c;
    }

    // ---- 显示格式配置器（可组合到任意列） ----
    // 数值列的小数位数：将排序、聚合
    // 和条件格式切换到实数（double）路径，并精确渲染到
    // `n` 位小数。`Decimals(c, 0)` 恢复整数路径。
    public static DataColumn Decimals(DataColumn c, int n) {
        if (n < 0) { n = 0; }
        c.decimals = n; c.numeric = true; c.align = 2;
        if (n > 0) { c.fmt = 1; }
        return c;
    }

    // 小数数值列，例如 `DataColumn.Real("Rate", 90, 2)`。
    public static DataColumn Real(string title, int width, int decimals) {
        return DataColumn.Decimals(new DataColumn(title, width), decimals);
    }

    // 计算列：`expr` 是对每行求值的公式（语法与语义见
    // DataTable.Formula.zan）。列自动走 `decimals` 位小数的
    // 实数路径（默认 2 位：排序/聚合/条件格式全部一致），
    // 并保持只读——公式列是派生输出，内联编辑与粘贴
    // 对它无效。典型用法：
    // ```zan
    // ```
    public static DataColumn Formula(string title, int width, string expr) {
        return DataColumn.Formula(new DataColumn(title, width), expr);
    }

    // 在既有列上启用公式（`expr` 传 "" 清除）。传入了
    // decimals 的列保留其位数；否则默认 2 位。列引用
    // 闭环（公式互相引用）不在构建期检测——求值层按
    // 单遍顺序读取各列的底层值，公式列引用公式列时
    // 读到的是后者的源数据，而非其计算结果。
    public static DataColumn Formula(DataColumn c, string expr) {
        c.formula = expr;
        if (expr.Length > 0) {
            c.numeric = true;
            c.align = 2;
            c.editable = false;
            c.isDate = false;
            c.isBool = false;
            if (c.decimals == 0) { c.decimals = 2; }
            if (c.fmt == 0) { c.fmt = 1; }
        }
        return c;
    }

    // ---- 日期配置器 ----
    // 将列视为日期：单元格解析为天数，按时间而非
    // 字典序排序和分组。`order` 指定存储文本的字段
    // 顺序（0 y-m-d，1 d-m-y，2 m-d-y）；开头的 4 位
    // 字段无论何种顺序都读作年份。
    public static DataColumn AsDate(DataColumn c, int order) {
        c.isDate = true;
        c.dateOrder = order;
        c.numeric = false;
        return c;
    }

    // ISO 风格日期列，例如 `DataColumn.Date("Ordered", 110)`。
    public static DataColumn Date(string title, int width) {
        return DataColumn.AsDate(new DataColumn(title, width), 0);
    }

    // 渲染日期格式：0 YYYY-MM-DD，1 DD/MM/YYYY，2 MM/DD/YYYY，
    // 3 YYYY年M月D日, 4 YYYY-MM, 5 YYYY, 6 "1 Jan 2026".
    public static DataColumn DateFormat(DataColumn c, int fmt) {
        c.isDate = true; c.dateFmt = fmt; return c;
    }

    // 该列分组时对日期分桶：0 精确到日，1 年，2 月，
    // 3 季度，4 星期。
    public static DataColumn DateGroup(DataColumn c, int mode) {
        c.isDate = true; c.dateGroup = mode; return c;
    }

    // ---- bool 配置器 ----
    // 将列视为真值：单元格用 ParseBool 读取（“1”、
    // “true”、“yes”、“y”、“on”、“\u2713”及其否定形式，不区分大小写），
    // 按 false 在前 true 在后排序，并按 `style` 居中绘制
    // （0 复选框，1 对勾/叉字形，2 文本）。
    public static DataColumn AsBool(DataColumn c, int style) {
        c.isBool = true;
        c.boolStyle = style;
        c.align = 1;
        c.numeric = false;
        return c;
    }

    // 复选框列，例如 `DataColumn.Bool("Active", 70)`。
    // 结合 `Editable` 可让单击切换单元格。
    public static DataColumn Bool(string title, int width) {
        return DataColumn.AsBool(new DataColumn(title, width), 0);
    }

    // bool 单元格切换时写回的文本，样式 2 也用它显示。
    // 默认为“true”/“false”；可用例如 `BoolText(c, "Yes", "No")`。
    public static DataColumn BoolText(DataColumn c, string yes, string no) {
        c.isBool = true; c.boolTrue = yes; c.boolFalse = no; return c;
    }

    // 货币：千位分组数字加前置符号，右对齐。
    // 默认 2 位小数；之后用 `Decimals` 覆盖。
    public static DataColumn Money(DataColumn c, string symbol) {
        c.fmt = 1; c.grouped = true; c.prefix = symbol; c.numeric = true; c.align = 2;
        if (c.decimals == 0) { c.decimals = 2; }
        return c;
    }
    // 百分比：追加“%”，右对齐。
    public static DataColumn Percent(DataColumn c) {
        c.fmt = 1; c.suffix = "%"; c.numeric = true; c.align = 2; return c;
    }
    // 仅千位分隔符（例如 1234567 -> 1,234,567）。
    public static DataColumn Grouped(DataColumn c) {
        c.fmt = 1; c.grouped = true; c.numeric = true; c.align = 2; return c;
    }
    // 任意前缀/后缀（可任一为空），例如“ kg”这样的单位。
    public static DataColumn Affix(DataColumn c, string prefix, string suffix) {
        c.fmt = 1; c.prefix = prefix; c.suffix = suffix; return c;
    }

    // ---- 条件格式配置器（静态，可无需
    // 实例方法链式调用即可组合） ----
    public static DataColumn DataBar(DataColumn c, int color) {
        c.cfMode = 1; c.cfColor = color; return c;
    }
    public static DataColumn ColorScale(DataColumn c, int lowColor, int highColor) {
        c.cfMode = 2; c.cfColor = lowColor; c.cfColor2 = highColor; return c;
    }
    public static DataColumn HighlightGreater(DataColumn c, int threshold, int color) {
        c.cfMode = 3; c.cfThreshold = threshold; c.cfColor = color; return c;
    }
    public static DataColumn HighlightLess(DataColumn c, int threshold, int color) {
        c.cfMode = 4; c.cfThreshold = threshold; c.cfColor = color; return c;
    }
    // 前 N 项（`countOrPct > 0`）或前 N%（< 0，N 取绝对值）。
    public static DataColumn TopRules(DataColumn c, int countOrPct, int color) {
        if (countOrPct < 0) { c.cfMode = 5; c.cfThreshold = 0 - countOrPct; c.cfRankPct = true; }
        else { c.cfMode = 5; c.cfThreshold = countOrPct; c.cfRankPct = false; }
        c.cfColor = color; return c;
    }
    // 后 N 项 / 后 N%，语义同上。
    public static DataColumn BottomRules(DataColumn c, int countOrPct, int color) {
        if (countOrPct < 0) { c.cfMode = 6; c.cfThreshold = 0 - countOrPct; c.cfRankPct = true; }
        else { c.cfMode = 6; c.cfThreshold = countOrPct; c.cfRankPct = false; }
        c.cfColor = color; return c;
    }

    // 将列标记为固定宽度：用户不能拖动其右边框，
    // 指针在（本应出现的）调整大小手柄上显示禁止光标。
    public static DataColumn NotResizable(DataColumn c) {
        c.resizable = false; return c;
    }

    // 同值相邻纵向合并（VTable data merge 的同类项）：该列
    // 文本相同且相邻的数据行（中间不隔组表头/详情带）画成
    // 一个跨行合并格。仅是渲染效果——排序/筛选/导出仍逐行
    // 看到各自的值；编辑仍写回所在行的底层单元格，改值后
    // 合并随之下一次重绘自然拆开。
    // ```zan
    // ```
    public static DataColumn Merge(DataColumn c) {
        c.mergeSame = true; return c;
    }

    // 文本换行：该列（cellType 0）的单元格文本按列宽折行，
    // 最多 `maxLines` 行；行高按全部换行列的最大需要行数
    // 统一增大（网格仍是统一行高，虚拟化寻址不变）。
    // `maxLines <= 0` 取 2。长文本超出部分仍按截断加省略号。
    public static DataColumn Wrap(DataColumn c, int maxLines) {
        if (maxLines < 1) { maxLines = 2; }
        c.wrapText = true;
        c.wrapLines = maxLines;
        return c;
    }

    public static DataColumn Text(string title, int width) {
        return new DataColumn(title, width);
    }

    public static DataColumn Numeric(string title, int width) {
        DataColumn c = new DataColumn(title, width);
        c.numeric = true;
        c.align = 2;
        return c;
    }

    public static DataColumn Link(string title, int width) {
        DataColumn c = new DataColumn(title, width);
        c.cellType = 1;
        return c;
    }

    public static DataColumn TagCol(string title, int width, int tagType) {
        DataColumn c = new DataColumn(title, width);
        c.cellType = 2;
        c.tagType = tagType;
        c.align = 1;
        return c;
    }

    public static DataColumn ProgressCol(string title, int width) {
        DataColumn c = new DataColumn(title, width);
        c.cellType = 3;
        c.numeric = true;
        return c;
    }

    public static DataColumn BadgeCol(string title, int width) {
        DataColumn c = new DataColumn(title, width);
        c.cellType = 4;
        c.align = 1;
        return c;
    }

    // 图片列：单元格值是文件路径、`mem:` 已注册 key 或 http(s)
    // URL（URL 由 ImageHttp 后台取回，就绪后自动重绘；加载中与
    // 失败画淡色占位块）。图片在格内 contain 缩放居中，不参与
    // 条件格式、汇总与内联编辑。
    public static DataColumn ImageCol(string title, int width) {
        DataColumn c = new DataColumn(title, width);
        c.cellType = 5;
        c.align = 1;
        return c;
    }

    // 图标列：单元格值即 tabler 图标名（"check"、"trash"、"pencil"），
    // 以 datatable::icon 的前景色居中绘制；空值画空。
    // 不可排序/筛选——图标名不是可比较的数据。
    public static DataColumn IconCol(string title, int width) {
        DataColumn c = new DataColumn(title, width);
        c.cellType = 6;
        c.align = 1;
        c.sortable = false;
        c.filterable = false;
        return c;
    }

    // 按钮列：整格居中一个 small 按钮。单元格值是按钮标签；
    // 标签为空时用 `icon`（tabler 图标名）画图标按钮。
    // 点击按钮把 hitRow/hitCol 指向本格并 Raise CellClick，
    // 处理器与普通单元格点击走同一入口读取上下文。
    // `cls` 是按钮 class（"primary"、"danger outline"、"text"…），
    // 空串用默认外观。不可排序/筛选/编辑。
    public static DataColumn ButtonCol(string title, int width, string icon, string cls) {
        DataColumn c = new DataColumn(title, width);
        c.cellType = 7;
        c.align = 1;
        c.btnIcon = icon;
        c.btnClass = cls;
        c.sortable = false;
        c.filterable = false;
        c.editable = false;
        return c;
    }

    // 图表列：单元格值是以逗号分隔的数值序列
    // （"12,18,9,24,30"），ParseReal 宽松解析（"¥1,234" 也能读），
    // 格内画等槽位迷你图。`kind`：0 柱状（默认，柱高以正峰
    // 为比例），1 折线（抗锯齿折线 + 末点强调），2 面积
    // （折线 + 基线填充）。柱状形态下 `area` 为 true 时柱下
    // 叠加半透明面积（历史参数）。含负值的序列以零基线分区，
    // 正值用 `posColor`、负值用 `negColor`（0 = 主题自动：
    // accent / spark-neg）。不可排序/筛选——序列文本不构成
    // 可比较的键。
    public static DataColumn SparklineCol(string title, int width, bool area) {
        DataColumn c = new DataColumn(title, width);
        c.cellType = 8;
        c.align = 1;
        c.btnIcon = "";
        c.btnClass = "";
        c.sparkArea = area;
        c.sparkKind = 0;
        c.sparkColor = 0;
        c.sparkNegColor = 0;
        c.sortable = false;
        c.filterable = false;
        return c;
    }

    // 图表列形态：0 柱状，1 折线，2 面积（越界回柱状）。
    public static DataColumn SparkKind(DataColumn c, int kind) {
        if (kind < 0 || kind > 2) { kind = 0; }
        c.sparkKind = kind;
        return c;
    }

    // 图表列配色：正值/线条色与负值色（0 = 主题自动）。
    public static DataColumn SparkColors(DataColumn c, int posColor, int negColor) {
        c.sparkColor = posColor;
        c.sparkNegColor = negColor;
        return c;
    }

    // 组件列：单元格值（逗号分隔数值序列，同迷你图约定）被
    // 灌进 `compId` 标识的池化真控件（如 "bandgrid"），控件按
    // 格矩形渲染。`shapeR`/`shapeC` 声明矩阵形状（<=0 用组件
    // 默认），`heat` 是数值→色带名（"" 关闭；"teal"/"amber"/
    // "coral"/"blue"…）。点击矩阵格子把 hitRow/hitCol 指向本格、
    // CompPos() 提供格内 (r,c) 后 Raise CellClick。
    // 不可排序/筛选——序列文本不构成可比较的键。
    // 序列化边界在引擎内部：使用层经 `DataGrid<T>.CompCol` 的
    // 类型化访问器提供 `List<int>`，从不接触控件与绘制。
    public static DataColumn CompCol(string title, int width, string compId) {
        DataColumn c = new DataColumn(title, width);
        c.cellType = 9;
        c.align = 1;
        c.compId = compId;
        c.shapeR = 0;
        c.shapeC = 0;
        c.heatBand = "";
        c.sortable = false;
        c.filterable = false;
        c.editable = false;
        return c;
    }

    // 组件列的矩阵形状（行 × 格）。仅对 cellType 9 有意义。
    public static DataColumn Shape(DataColumn c, int rows, int cols) {
        c.shapeR = rows;
        c.shapeC = cols;
        return c;
    }

    // 组件列（字符串值形态，cellType 10）：单元格文本灌进
    // `compId` 标识的池化真控件。内置 compId："switch"/"checkbox"
    // （布尔文本）、"rate"（0..N 星数，Shape 的 shapeC 为显数）、
    // "select"/"buttons"（选项取 `choices`，经 Options 声明）。
    // 用户控件实现 CellComp（FillStr/TakeCommit）Register 一次
    // 即可用自己的 id。控件改动经 TakeCommit 走编辑通道写回
    // （撤销/SetCell/CellEdit），排序筛选关闭，导出用原始文本。
    // 标准组件互嵌插槽列：直接挂载任意标准 Gui.Widget（按钮、开关、复选框、自定义面板等），
    // 渲染管线就地停靠测量，点击/焦点/键盘事件全部交由 Visual Tree 原生派发，无需中介适配器。
    public static DataColumn WidgetSlot(string title, int width, CellWidgetProvider provider) {
        DataColumn c = new DataColumn(title, width);
        c.widgetProvider = provider;
        c.sortable = false;
        c.filterable = false;
        c.editable = false;
        return c;
    }

    public static DataColumn WidgetCol(string title, int width, string compId) {
        DataColumn c = new DataColumn(title, width);
        c.cellType = 10;
        c.align = 1;
        c.compId = compId;
        c.sortable = false;
        c.filterable = false;
        c.editable = false;
        return c;
    }

    // 组件列（cellType 10 select/buttons）或下拉编辑器的选项，
    // 逗号分隔一次给全（如 "草稿,审核中,已发布"）。
    public static DataColumn Options(DataColumn c, string csv) {
        if (c.choices == null) { c.choices = new List<string>(); }
        c.choices.Clear();
        List<string> parts = DataTable.NumSeries(csv);
        for (int i = 0; i < parts.Count; i = i + 1) { c.choices.Add(parts[i]); }
        return c;
    }

    // 动作按钮组列（cellType 10 "buttons"）：点击是命令
    // （CellClick，段号在 HitCol/CompPosC），不是数据选择——
    // 适配器不回写段标签（单元格文本保持原值），焦点描边
    // 与填充柄不停留在这种列上（DataTable.IsActionCol）。
    // 与 Options 组合声明段标签。
    public static DataColumn Actions(DataColumn c) {
        if (c != null) { c.actionOnly = true; }
        return c;
    }

    // 组件列改顶对齐。默认格内垂直居中（行高大于控件自然高度时
    // 上下均分留白）；矩阵形态或需要贴住表头的场合才需要这个。
    public static DataColumn VTop(DataColumn c) {
        if (c != null) { c.vTop = true; }
        return c;
    }

    // 组件列的数值→色带映射（"teal"/"amber"/"coral"/"blue"/
    // "green"/"purple"，空串关闭）。仅对 cellType 9 有意义。
    public static DataColumn Heat(DataColumn c, string band) {
        c.heatBand = band;
        return c;
    }

    // 命名色带的两端颜色（0xAARRGGBB）。`name` 不识别时返回
    // false，调用方回退 accent 单色。与文档第 1 节色板一致的
    // 内置映射，组件列着色共用。浅端按亮色（默认）皮肤调的
    // 参考值：组件列实际把深端交给 BandGrid.Heat，由其绘制
    // 时从当前皮肤表面色派生浅端，暗色皮肤自动得暗色调。
    public static bool HeatBands(string name, ref int lo, ref int hi) {
        if (name == "teal") { lo = 0xFFE1F5EE; hi = 0xFF0D6E56; return true; }
        if (name == "amber") { lo = 0xFFFAEEDA; hi = 0xFFBA7517; return true; }
        if (name == "coral") { lo = 0xFFFAECE7; hi = 0xFFD85A30; return true; }
        if (name == "blue") { lo = 0xFFE6F1FB; hi = 0xFF185FA5; return true; }
        if (name == "green") { lo = 0xFFEAF3DE; hi = 0xFF3B6D11; return true; }
        if (name == "purple") { lo = 0xFFEEEDFE; hi = 0xFF534AB7; return true; }
        return false;
    }

    // 汇总由其他列聚合值派生的数值列
    // （不逐行扫描）。`op` 为 0 百分比 / 1 比值 / 2 差值 / 3 和 / 4 积 /
    // 5 千分比（A*1000/B）；`a` 和 `b` 是源列索引。
    public static DataColumn Derived(string title, int width, int op, int a, int b) {
        DataColumn c = new DataColumn(title, width);
        c.numeric = true;
        c.align = 2;
        c.summary = 6;
        c.deriveOp = op;
        c.deriveA = a;
        c.deriveB = b;
        return c;
    }

    // 在既有列上设置派生汇总（老 DevExpress CustomSummaryCalculate
    // 等位：页脚由其它 sum 列的聚合值现算）。op 同 Derived。
    public static void Derive(DataColumn c, int op, int a, int b) {
        c.summary = 6;
        c.deriveOp = op;
        c.deriveA = a;
        c.deriveB = b;
    }

    // ---- 页脚聚合配置器（为该列显示总计行） ----
    public static DataColumn Sum(DataColumn c) { c.summary = 1; return c; }
    public static DataColumn Avg(DataColumn c) { c.summary = 2; return c; }
    public static DataColumn Min(DataColumn c) { c.summary = 3; return c; }
    public static DataColumn Max(DataColumn c) { c.summary = 4; return c; }
    public static DataColumn Count(DataColumn c) { c.summary = 5; return c; }
    // 勾选行数聚合（DevExpress Selection 汇总等位）。
    public static DataColumn CountSel(DataColumn c) { c.summary = 7; return c; }
    // 页脚聚合文案模板，{0} 替换为聚合值，{0:0.##} 等按数字
    // 格式说明渲染（老 DisplayFormat；详见 ApplySummaryTemplate）。
    public static DataColumn SummaryFmt(DataColumn c, string fmt) {
        c.summaryFmt = fmt;
        return c;
    }
    public static DataColumn CustomSummary(DataColumn c, CustomSummaryProvider provider) {
        c.customSummary = provider;
        return c;
    }

    public DataColumn WithValidator(CellValidator v) {
        this.validator = v;
        return this;
    }

    public DataColumn WithValidateFunc(CellValidateFunc fn) {
        this.validator = new CustomCellValidator(fn);
        return this;
    }

    public static DataColumn Validate(DataColumn c, CellValidator v) {
        c.validator = v;
        return c;
    }

    public static DataColumn ValidateFunc(DataColumn c, CellValidateFunc fn) {
        c.validator = new CustomCellValidator(fn);
        return c;
    }
}
