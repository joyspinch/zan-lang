using System;
using System.Json;
using System.IO;
using System.Net;
using System.Net.Sockets;
using System.Net.Http;
using System.Net.Http.Client;
using System.Threading;
using Gui;

namespace Gui.Component.DataTable;

/// HTTP 块源：ServerDataSource 的"限流接口 + 本地缓存"适配器。
/// 面向把慢/限流的远端列表接口接进 DataTable 的工具型应用（列表先出、
/// 行块懒加载）：继承 ServerDataSource 的块合同，只补两件事——
/// 1. **缓存先行**：每个块 (start,count) 对应缓存目录里的一个 JSON
/// 文件。命中直接在 UI 线程同步供给（零网络、零等待）；未命中才
/// 入队后台拉取，取回后先落盘再交付——进程重启后同一块不再打网。
/// 2. **后台交付**：拉取走全局单工的静态 Job 通道（线程入口用
/// 静态方法组 + 静态槽位，而不是给每条取数连源一起捕获；实例
/// 方法组与捕获 lambda 自 2026-09 起已能直接喂给 Thread.Start，
/// 见 docs/ABI.md §3.6）。
/// void 循环里 await 静态 async 取数（try 在 async 体内，TASKS
/// A88 悬挂教训），完成写静态槽位，由网格每帧的 Poll() 在 UI
/// 线程并入。源状态除经 Mutex 保护的槽位外不出 UI 线程，迟到/
/// 过期结果被 nonce 丢弃。
/// 线协议：`GET <basePath>?start=<s>&count=<c>`，响应 JSON：
/// { "total": 123, "rows": [["c0","c1"], ["c0","c1"]] }
/// total 可省略（省略时短块固定总数）。单元格一律字符串，与
/// DataRow/CellText 的文本通道一致。缓存页即该响应原文。
/// v1 有意不做：磁盘缓存的主动失效（删除缓存目录即可）、每源并发
/// 拉取（全局单工 + 基类在途合并兜底）、写穿透（SubmitTransaction
/// 事务链路的远端回写需服务端配合，另案）。
class HttpTableSource : ServerDataSource {
    string host;
    int port;
    string basePath;
    string cacheDir;
    bool useTls;
    string token;
    string lastError;

    // 在途身份（UI 线程写；单源同一时刻至多一个在途块，基类已合并）。
    int fetchNonce;
    int activeNonce;
    int pendStart;
    int pendCount;
    string pendPath;

    // ---- 全局单工拉取通道（Mutex 保护；worker 写 / UI Poll 消费）----
    static nint lockHandle;
    static List<HttpTableSource> queue;
    static bool workerUp;
    static HttpTableSource doneSrc;
    static int doneNonce;
    static string doneErr;
    static string doneBody;

    /// 创建普通（明文）HTTP 块源。cacheDir 是块缓存目录，须已存在。
    static HttpTableSource Create(string host, int port,
                                  string basePath, string cacheDir) {
        HttpTableSource s = new HttpTableSource();
        s.Setup(100);
        s.host = host;
        s.port = port;
        s.basePath = basePath;
        s.cacheDir = cacheDir;
        s.useTls = false;
        s.token = "";
        s.lastError = "";
        return s;
    }

    /// 创建 HTTPS 块源（证书校验遵循 TlsStream 既有策略）。
    static HttpTableSource CreateTls(string host, int port,
                                     string basePath, string cacheDir) {
        HttpTableSource s = HttpTableSource.Create(host, port, basePath, cacheDir);
        s.useTls = true;
        return s;
    }

    /// 可选的鉴权 token：以 `&token=` 查询参数随块请求发送（v1 不做
    /// 请求头注入——SendBytesAsync 尚无头扩展点）。
    void SetToken(string t) { token = t; }

    /// 最近一次网络失败的说明；成功后清空。缓存命中不改动它。
    string LastError() { return lastError; }

    /// 块 (start,count) 的缓存文件路径（键=主机端口路径的净化串，
    /// 无哈希折叠——路径可读可手工排查）。
    string CachePath(int start, int count) {
        string raw = host + "_" + Convert.ToString(port) + "_" + basePath;
        int rlen = raw.Length;
        byte[] buf = new byte[rlen];
        for (int i = 0; i < rlen; i = i + 1) {
            int c = raw[i] & 255;
            bool ok = (c >= 97 && c <= 122) || (c >= 65 && c <= 90)
                || (c >= 48 && c <= 57) || c == 95;
            buf[i] = (byte)(ok ? c : 95);
        }
        string key = buf.ToStr(0, rlen);
        return cacheDir + "/tbl_" + key + ".p" + Convert.ToString(start)
            + "." + Convert.ToString(count) + ".json";
    }

    /// 网格请求块：缓存命中同步供给；未命中入队后台拉取（本方法立即
    /// 返回，不碰 FinishBlock——交付在 Poll 里完成）。
    override void FetchBlock(int start, int count) {
        string path = this.CachePath(start, count);
        if (File.Exists(path)) {
            this.ServeFile(path);
            return;
        }
        this.fetchNonce = this.fetchNonce + 1;
        this.activeNonce = this.fetchNonce;
        this.pendStart = start;
        this.pendCount = count;
        this.pendPath = path;
        if (lockHandle == 0) { lockHandle = Mutex.Create(); }
        Mutex.Lock(lockHandle);
        if (queue == null) { queue = new List<HttpTableSource>(); }
        queue.Add(this);
        bool need = !workerUp;
        workerUp = true;
        Mutex.Unlock(lockHandle);
        if (need) {
            if (!Thread.Start(HttpTableSource.WorkerEntry)) {
                Mutex.Lock(lockHandle);
                workerUp = false;
                Mutex.Unlock(lockHandle);
                this.FinishBlock(null, -1);
            }
        }
    }

    /// worker 线程入口：队列空即退出，下一次 FetchBlock 重新拉起。
    /// void 循环里 await 静态 async 取数；入口本身不带 try（TASKS A88）。
    static void WorkerEntry() {
        Socket.Initialize();
        while (true) {
            HttpTableSource src = null;
            Mutex.Lock(lockHandle);
            if (queue != null && queue.Count > 0) {
                src = queue[0];
                queue.RemoveAt(0);
            } else {
                workerUp = false;
                Mutex.Unlock(lockHandle);
                return;
            }
            Mutex.Unlock(lockHandle);
            await HttpTableSource.FetchOne(src);
        }
    }

    /// 取数一个块：传输里任何一处抛出都必须变成一条错误结果——不接住
    /// 的话 worker 静静死掉，网格永远停在加载占位上（ImageHttp 同戒）。
    /// 落盘是尽力而为：写失败不吞数据，正文照常经槽位交付。
    static async int FetchOne(HttpTableSource src) {
        string err = "";
        string body = "";
        try {
            HttpClient client = new HttpClient(src.host, src.port);
            string url = src.basePath + "?start=" + Convert.ToString(src.pendStart)
                + "&count=" + Convert.ToString(src.pendCount);
            if (src.token != "") { url = url + "&token=" + src.token; }
            HttpResponse resp = await client.SendBytesAsync("GET", url, "");
            if (resp.statusCode != 200) {
                err = "HTTP " + Convert.ToString(resp.statusCode);
            } else {
                body = resp.body;
            }
        } catch (Exception ex) {
            err = ex.Message;
        }
        if (err == "" && body != "") {
            try {
                File.WriteAllText(src.pendPath, body);
            } catch (Exception ex) {
                Console.WriteLine("HttpTableSource: cache write failed: "
                    + ex.Message);
            }
        }
        Mutex.Lock(lockHandle);
        doneSrc = src;
        doneNonce = src.activeNonce;
        doneErr = err;
        doneBody = body;
        Mutex.Unlock(lockHandle);
        return 0;
    }

    /// 每帧并入：先消费完成槽（正文交付 / 失败块），再交给基类。
    override bool Poll() {
        if (lockHandle != 0) {
            bool mine = false;
            int nonce = 0;
            string err = "";
            string body = "";
            Mutex.Lock(lockHandle);
            if (doneSrc == this) {
                mine = true;
                nonce = doneNonce;
                err = doneErr;
                body = doneBody;
                doneSrc = null;
                doneErr = "";
                doneBody = "";
            }
            Mutex.Unlock(lockHandle);
            if (mine) {
                if (this.loading && nonce == this.activeNonce) {
                    if (err == "") {
                        this.lastError = "";
                        List<DataRow> rows = new List<DataRow>();
                        if (this.ParsePage(body, rows)) {
                            this.FinishBlock(rows, rows.Count);
                        } else {
                            this.FinishBlock(null, -1);
                        }
                    } else {
                        this.lastError = err;
                        this.FinishBlock(null, -1);
                    }
                }
            }
        }
        return base.Poll();
    }

    /// 从缓存页文件读出块并交付（UI 线程）。
    void ServeFile(string path) {
        List<DataRow> rows = new List<DataRow>();
        string body = File.ReadAllText(path);
        if (this.ParsePage(body, rows)) {
            this.FinishBlock(rows, rows.Count);
        } else {
            this.FinishBlock(null, -1);
        }
    }

    /// 解析线协议页：{"total":n,"rows":[[..],..]}。行一律 Push 成
    /// 字符串单元格；total >= 0 时固定总数。坏页返回 false。
    bool ParsePage(string body, List<DataRow> dst) {
        JsonValue v = JsonValue.Parse(body);
        if (v == null || !v.IsObject()) { return false; }
        JsonValue rows = v.Get("rows");
        if (rows == null || !rows.IsArray()) { return false; }
        for (int i = 0; i < rows.Count(); i = i + 1) {
            JsonValue r = rows.At(i);
            if (r == null || !r.IsArray()) { continue; }
            DataRow d = new DataRow();
            for (int j = 0; j < r.Count(); j = j + 1) {
                d.Push(r.At(j).AsString(""));
            }
            dst.Add(d);
        }
        int total = v.Int("total", -1);
        if (total >= 0) { this.SetKnownTotal(total); }
        return true;
    }
}
