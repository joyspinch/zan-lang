using System;

namespace Gui.Component.DataTable;

public partial class DataTable {
    // 挂接（或 null 清除）组合筛选树。改动即失效显示模型，
    // 与 SetFilter 等入口一致。
    static void SetFilterTree(DataTableState st, FilterGroup root) {
        st.filterTree = root;
        DataTable.InvalidateQuery(st);
    }

    // 当前组合筛选树（未挂接时 null）。
    static FilterGroup FilterTreeOf(DataTableState st) {
        return st.filterTree;
    }

    // 组合筛选树是否有内容（null 或空组均为 false）。
    static bool HasFilterTree(DataTableState st) {
        return st.filterTree != null && DataTable.GroupHasContent(st.filterTree);
    }

    // 组内是否有任何条件或子组；null 视为无内容。
    static bool GroupHasContent(FilterGroup g) {
        if (g == null) { return false; }
        return g.Conditions().Count > 0 || g.Groups().Count > 0;
    }

    // 组求值：AND 组全过才过，OR 组一过即过。空组恒通过。
    static bool GroupPasses(DataTableState st, FilterGroup g, List<DataColumn> cols,
                            DataSource src, int row, int today) {
        if (!DataTable.GroupHasContent(g)) { return true; }
        int n = g.Conditions().Count;
        for (int i = 0; i < n; i = i + 1) {
            bool pass = DataTable.ConditionPasses(g.Conditions()[i], cols, src, row);
            if (g.and && !pass) { return false; }
            if (!g.and && pass) { return true; }
        }
        int gn = g.Groups().Count;
        for (int i = 0; i < gn; i = i + 1) {
            bool pass = DataTable.GroupPasses(st, g.Groups()[i], cols, src, row, today);
            if (g.and && !pass) { return false; }
            if (!g.and && pass) { return true; }
        }
        // AND 走到此处意味着全部通过；OR 意味着全部失败。
        return g.and;
    }

    // 条件求值。条件按 field 名找列；找不到的列按"不匹配"
    // 处理——拼错的 field 不应静默放行。
    static bool ConditionPasses(FilterCondition c, List<DataColumn> cols,
                                DataSource src, int row) {
        int colIdx = -1;
        for (int i = 0; i < cols.Count; i = i + 1) {
            if (cols[i].field == c.Field()) { colIdx = i; break; }
        }
        if (colIdx < 0) { return false; }
        // 计算列：条件按公式显示文本求值（与渲染一致）。
        string v = DataTable.CellTextRouted(cols, src, row, colIdx);
        if (v == null) { v = ""; }
        int op = c.Op();
        if (op == 8) { return DataTable.TrimSpace(v).Length == 0; }
        if (op == 9) { return DataTable.TrimSpace(v).Length > 0; }
        if (op == 0) { return DataTable.ContainsCI(v, c.ValueA()); }
        if (op == 10) { return DataTable.StartsCI(v, c.ValueA()); }
        if (op == 11) { return DataTable.EndsCI(v, c.ValueA()); }
        if (op == 1) { return DataTable.EqCI(v, c.ValueA()); }
        if (op == 2) { return !DataTable.EqCI(v, c.ValueA()); }
        // 3..7 数值比较：数值解析失败（空文本等）按不匹配处理，
        // 与比较筛选对纯数字的解释一致。
        double a = DataTable.ParseReal(c.ValueA());
        double b = DataTable.ParseReal(c.ValueB());
        double x = DataTable.ParseReal(v);
        if (op == 3) { return x > a; }
        if (op == 4) { return x >= a; }
        if (op == 5) { return x < a; }
        if (op == 6) { return x <= a; }
        if (op == 7) { return x >= a && x <= b; }
        return false;
    }

    // 行是否通过组合筛选树（Recompute 在逐列筛选之后调用）。
    // 未挂接树时恒真。
    static bool RowPassesFilterTree(DataTableState st, List<DataColumn> cols,
                                    DataSource src, int row, int today) {
        if (!DataTable.HasFilterTree(st)) { return true; }
        return DataTable.GroupPasses(st, st.filterTree, cols, src, row, today);
    }
}
