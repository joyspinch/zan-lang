using System;
using Gui;
using Gui.Widget;
using Gui.Backend;

namespace Gui.Component.DataTable;

// 单元格享元绘制器（CellRenderer / 展现层插槽画笔）：
// 普通只读态下的无状态绘制接口。不创建真实 Control，不挂载事件监听，
// 零堆分配，每帧直接通过 Canvas 完成极速自绘。
// 与 CellEditor（悬浮编辑宿主）构成企业级表格的「双模分离」基石。
public class CellRenderer {
    // 绘制单元格内容。
    // 返回 true 表示完全接管绘制（DataTable 内置的文本/图标/进度条跳过）；
    // 返回 false 表示继续由内置逻辑绘制。
    public virtual bool Paint(App app, Canvas c, DataSource src, int row, int col,
                             int x, int y, int w, int h, bool selected, bool hovered) {
        return false;
    }
}
