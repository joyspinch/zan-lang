using System;

namespace Gui.Component.DataTable;

// 计算列（Formula）分部：表达式解析与逐行求值。
// `DataColumn.formula` 非空的列不读数据源：每个单元格的值
// 是对表达式求值的结果。语法（单遍递归下降，运算优先级
// 与 C 一致）：
// ```text
// expr    := term (('+' | '-') term)*
// term    := unary (('*' | '/') unary)*
// unary   := '-' unary | primary
// primary := 数字 | 函数调用 | '(' expr ')' | 列引用
// ```
// - 数字：十进制字面量；一元负号由 unary 层处理；
// - 函数：`min(a,b,...)`、`max(a,b,...)`（变参）、
// `abs/round/floor/ceil/sqrt(x)`，`round` 可带第二参数
// 指定小数位；sqrt 用 Newton 迭代（运行时无 Math.Sqrt）；
// - 列引用：裸标识符，先按 `field` 名解析，回退按 `title`；
// 嵌套公式列被引用时读到的是其**源数据**（未计算的），
// 因此跨公式引用应指向普通列；
// - 括号深度上限 32，超出视为畸形。
// 语义全部 fail-soft（商业网格惯例：公式列不抛异常、
// 不打断渲染）：
// - 解析（与行无关）：未知列名、未知函数、畸形表达式、
// 尾随垃圾 → 整列显示空；
// - 求值（逐行）：除以 0 → 该行显示空。
// 实现是两段式：构建/列变更时把表达式解析成逆波兰
// token 序列（`FormulaExpr`），此后每行求值只是一次
// 纯栈运算——不重复做名字查找与语法分析，O(rows ×
// tokens)。
public partial class DataTable {
    // ---------- Formula 解析 ----------

    // 逆波兰 token：0 数字，1 列引用，2 +，3 -，4 *，5 /，
    // 6 一元负号，7 min，8 max，9 abs，10 round，11 floor，
    // 12 ceil，13 sqrt。

    // ---------- Formula 求值 ----------

    // 对编译好的表达式按行求值。返回 false 表示该行结果
    // 无效（除以 0），调用方渲染空文本。解析已失败的表达式
    // 由 FormulaExprOf 缓存为 null，不会进入这里。
    static bool FormulaEval(FormulaExpr e, DataSource src, int row, out double value) {
        value = 0.0;
        if (e == null || e.err) { return false; }
        List<double> st = new List<double>();
        int n = e.ops.Count;
        for (int i = 0; i < n; i = i + 1) {
            int op = e.ops[i];
            if (op == 0) { st.Add(e.nums[i]); }
            else if (op == 1) { st.Add(src.CellReal(row, e.colIdx[i])); }
            else if (op == 2 || op == 3 || op == 4 || op == 5) {
                if (st.Count < 2) { return false; }
                double b = st[st.Count - 1];
                double a = st[st.Count - 2];
                st.RemoveAt(st.Count - 1);
                st.RemoveAt(st.Count - 1);
                if (op == 2) { st.Add(a + b); }
                else if (op == 3) { st.Add(a - b); }
                else if (op == 4) { st.Add(a * b); }
                else {
                    // 除以 0：该行公式无效（fail-soft 显示空）。
                    if (b == 0.0) { return false; }
                    st.Add(a / b);
                }
            }
            else if (op == 6) {
                if (st.Count < 1) { return false; }
                int last = st.Count - 1;
                st[last] = 0.0 - st[last];
            }
            else {
                int argc = e.argc[i];
                if (st.Count < argc) { return false; }
                int base2 = st.Count - argc;
                double v = 0.0;
                if (op == 7) {
                    v = st[base2];
                    for (int k = 1; k < argc; k = k + 1) { if (st[base2 + k] < v) { v = st[base2 + k]; } }
                } else if (op == 8) {
                    v = st[base2];
                    for (int k = 1; k < argc; k = k + 1) { if (st[base2 + k] > v) { v = st[base2 + k]; } }
                } else if (op == 9) {
                    v = st[base2];
                    if (v < 0.0) { v = 0.0 - v; }
                } else if (op == 10) {
                    // round(x) / round(x, digits)
                    int digits = 0;
                    if (argc == 2) {
                        digits = (int)st[base2 + 1];
                        if (digits < 0) { digits = 0; }
                        if (digits > 10) { digits = 10; }
                    }
                    double m = DataTable.Pow10(digits);
                    double scaled = st[base2] * m;
                    if (scaled >= 0.0) { v = (double)((long)(scaled + 0.5)) / m; }
                    else { v = 0.0 - (double)((long)(0.0 - scaled + 0.5)) / m; }
                } else if (op == 11) {
                    double x = st[base2];
                    if (x >= 0.0 || x == (double)((long)x)) { v = (double)((long)x); }
                    else { v = 0.0 - (double)((long)(0.0 - x)) - 1.0; }
                } else if (op == 12) {
                    double x = st[base2];
                    if (x <= 0.0 || x == (double)((long)x)) { v = (double)((long)x); }
                    else { v = (double)((long)x) + 1.0; }
                } else if (op == 13) {
                    double x = st[base2];
                    if (x < 0.0) { return false; }
                    if (x == 0.0) { v = 0.0; }
                    else {
                        // Newton 迭代（运行时无 Math.Sqrt）。
                        double g = x;
                        for (int it = 0; it < 60; it = it + 1) {
                            double next = 0.5 * (g + x / g);
                            double d2 = next - g;
                            if (d2 < 0.0) { d2 = 0.0 - d2; }
                            if (d2 <= g * 1e-12) { g = next; break; }
                            g = next;
                        }
                        v = g;
                    }
                } else {
                    return false;
                }
                // 先弹出全部实参再压入结果（RemoveAt 自高向低）。
                for (int k = 0; k < argc; k = k + 1) { st.RemoveAt(st.Count - 1); }
                st.Add(v);
            }
        }
        if (st.Count != 1) { return false; }
        value = st[0];
        return true;
    }

    // ---------- Formula 路由入口 ----------

    // 列是否为计算列。
    static bool IsFormula(List<DataColumn> cols, int col) {
        if (col < 0 || col >= cols.Count) { return false; }
        return cols[col].formula.Length > 0;
    }

    // 计算列在 `row` 行的显示文本。非计算列返回 null（调用方
    // 回落普通读取路径）；计算列求值失败（畸形表达式、除以
    // 0、负数开方）返回 ""——fail-soft，绝不打断渲染。
    static string FormulaText(List<DataColumn> cols, DataSource src, int row, int col) {
        if (!DataTable.IsFormula(cols, col)) { return null; }
        FormulaExpr e = DataTable.FormulaExprOf(cols, col);
        if (e == null) { return ""; }
        double v;
        if (!DataTable.FormulaEval(e, src, row, out v)) { return ""; }
        return DataTable.FormatCell(cols[col], DataTable.FormatReal(v, cols[col].decimals));
    }

    // 计算列在 `row` 行的实数值。非计算列返回 false。
    static bool FormulaTryReal(List<DataColumn> cols, DataSource src, int row, int col, out double v) {
        v = 0.0;
        if (!DataTable.IsFormula(cols, col)) { return false; }
        FormulaExpr e = DataTable.FormulaExprOf(cols, col);
        if (e == null) { return false; }
        return DataTable.FormulaEval(e, src, row, out v);
    }

    // 每列表达式编译缓存。表达式对象不可变，列列表或表达式
    // 字符串变更时由 InvalidateFormulaCache 整体作废。
    static FormulaCacheEntry sFormulaCache;

    // 取列的编译结果；缓存按列列表指针与列数整体命中，
    // 未命中则整表重编译。非计算列缓存为 null。
    static FormulaExpr FormulaExprOf(List<DataColumn> cols, int col) {
        FormulaCacheEntry entry = DataTable.sFormulaCache;
        if (entry != null && entry.cols == cols && entry.exprs.Count == cols.Count) {
            return entry.exprs[col];
        }
        entry = new FormulaCacheEntry();
        entry.cols = cols;
        entry.exprs = new List<FormulaExpr>();
        for (int i = 0; i < cols.Count; i = i + 1) {
            DataColumn c = cols[i];
            if (c.formula.Length > 0) {
                entry.exprs.Add(new FormulaExpr(c.formula, cols));
            } else {
                entry.exprs.Add(null);
            }
        }
        DataTable.sFormulaCache = entry;
        return entry.exprs[col];
    }

    // 修改任意列的 formula 字段后调用：整体作废编译缓存。
    // FormulaText/FormulaTryReal 在下一次调用时重新编译。
    static void InvalidateFormulaCache() {
        DataTable.sFormulaCache = null;
    }
}
