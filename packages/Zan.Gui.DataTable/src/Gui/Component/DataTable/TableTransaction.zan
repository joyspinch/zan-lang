using System;
using System.Json;

namespace Gui.Component.DataTable;

// 一次可批量提交的 mutation 集合。Draft 阶段可追加，进入校验后
// 不再接受修改；状态转移是单向的，避免 ACK 覆盖已取消事务。
public class TableTransaction {
    string transactionId;
    int mode;
    int state;
    List<TableMutation> mutations;
    string error;

    // 构造 Draft 事务；id 为 null 记空串，mode 非法时回退为 AllOrNothing。
    TableTransaction(string id, int transactionMode) {
        this.transactionId = id;
        this.mode = transactionMode;
        if (this.transactionId == null) { this.transactionId = ""; }
        if (this.mode != TransactionMode.AllOrNothing
            && this.mode != TransactionMode.BestEffort) {
            this.mode = TransactionMode.AllOrNothing;
        }
        this.state = TransactionState.Draft;
        this.mutations = new List<TableMutation>();
        this.error = "";
    }

    // 创建 Draft 事务。
    public static TableTransaction Create(string id, int transactionMode) {
        return new TableTransaction(id, transactionMode);
    }

    // 事务标识。
    string TransactionId() { return this.transactionId; }
    // 提交策略（TransactionMode）。
    int Mode() { return this.mode; }
    // 当前生命周期状态（TransactionState）。
    int State() { return this.state; }
    // 失败/冲突原因文本；未失败时为空串。
    string Error() { return this.error; }
    // 已加入的 mutation 数量。
    int Count() { return this.mutations.Count; }

    // 事务可提交：id 非空、mode 合法、至少一个 mutation 且每个
    // mutation 有效，mutationId 无重复。
    public bool IsValid() {
        if (this.transactionId.Length == 0
            || (this.mode != TransactionMode.AllOrNothing
                && this.mode != TransactionMode.BestEffort)
            || this.mutations.Count == 0) { return false; }
        for (int i = 0; i < this.mutations.Count; i = i + 1) {
            TableMutation mutation = this.mutations[i];
            if (mutation == null || !mutation.IsValid()) { return false; }
            for (int j = 0; j < i; j = j + 1) {
                if (this.mutations[j].MutationId() == mutation.MutationId()) {
                    return false;
                }
            }
        }
        return true;
    }

    // 事务内是否已存在该 id 的 mutation；id 为 null 返回 false。
    public bool HasMutationId(string id) {
        if (id == null) { return false; }
        for (int i = 0; i < this.mutations.Count; i = i + 1) {
            if (this.mutations[i].MutationId() == id) { return true; }
        }
        return false;
    }

    // 仅在 Draft 阶段接受有效且 id 不重复的 mutation；否则返回 false。
    public bool Add(TableMutation mutation) {
        if (this.state != TransactionState.Draft || mutation == null
            || !mutation.IsValid()) { return false; }
        for (int i = 0; i < this.mutations.Count; i = i + 1) {
            if (this.mutations[i].MutationId() == mutation.MutationId()) { return false; }
        }
        this.mutations.Add(mutation);
        return true;
    }

    // 第 index 个 mutation 的复制值；越界返回 null。
    public TableMutation At(int index) {
        if (index < 0 || index >= this.mutations.Count) { return null; }
        TableMutation m = this.mutations[index];
        return TableMutation.Cell(m.MutationId(), m.Key(), m.Column(),
            m.ExpectedRevision(), m.Value());
    }

    // 进入校验阶段：要求处于 Draft 且至少有一个 mutation；成功后状态为 Validating。
    public bool BeginValidation() {
        if (this.state != TransactionState.Draft || this.mutations.Count == 0) {
            return false;
        }
        this.state = TransactionState.Validating;
        return true;
    }

    // Validating -> Pending，表示即将提交；其它状态返回 false。
    public bool MarkPending() {
        if (this.state != TransactionState.Validating) { return false; }
        this.state = TransactionState.Pending;
        return true;
    }

    // Pending -> Acked；仅在 Pending 状态成功。
    public bool Ack() {
        if (this.state != TransactionState.Pending) { return false; }
        this.state = TransactionState.Acked;
        return true;
    }

    // Pending -> Rejected 并记录原因 message（null 记空串）。
    public bool Reject(string message) {
        if (this.state != TransactionState.Pending) { return false; }
        this.error = message;
        if (this.error == null) { this.error = ""; }
        this.state = TransactionState.Rejected;
        return true;
    }

    // Pending -> Conflict 并记录冲突详情 message（null 记空串）。
    public bool MarkConflict(string message) {
        if (this.state != TransactionState.Pending) { return false; }
        this.error = message;
        if (this.error == null) { this.error = ""; }
        this.state = TransactionState.Conflict;
        return true;
    }

    // Draft/Validating/Pending -> Cancelled；终态不可取消。
    public bool Cancel() {
        if (this.state != TransactionState.Draft
            && this.state != TransactionState.Validating
            && this.state != TransactionState.Pending) { return false; }
        this.state = TransactionState.Cancelled;
        return true;
    }

    // 处于 Acked/Rejected/Conflict/Cancelled 任一终态时为 true。
    public bool IsTerminal() {
        return this.state == TransactionState.Acked
            || this.state == TransactionState.Rejected
            || this.state == TransactionState.Conflict
            || this.state == TransactionState.Cancelled;
    }

    // 序列化为传输 JsonValue：事务身份加逐个 mutation 的 JSON 对象数组。
    public JsonValue ToJsonValue() {
        JsonValue root = JsonValue.NewObject();
        root.Put("ver", JsonValue.NewNum("1"));
        root.Put("id", JsonValue.NewStr(this.transactionId));
        root.Put("mode", JsonValue.NewNum(Convert.ToString(this.mode)));
        root.Put("state", JsonValue.NewNum(Convert.ToString(this.state)));
        root.Put("error", JsonValue.NewStr(this.error));
        JsonValue values = JsonValue.NewArray();
        for (int i = 0; i < this.mutations.Count; i = i + 1) {
            values.Append(this.mutations[i].ToJsonValue());
        }
        root.Put("mutations", values);
        return root;
    }

    // 序列化为传输 JSON 文本。
    public string ToJson() {
        return this.ToJsonValue().ToJson();
    }
}
