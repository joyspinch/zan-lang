using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// DataGrid 图片列的远端取回通道槽。
// 渲染遇到 http(s) 图片单元格时经 Ensure 走已注册的实现或委托给 Image.EnsureUrl；
// 未就绪或未注册画加载占位。
public delegate string GridUrlEnsureFn(App app, string url);

public class GridImageSlot {
    static GridUrlEnsureFn ensurer;

    static void SetEnsurer(GridUrlEnsureFn fn) { ensurer = fn; }

    static string Ensure(App app, string url) {
        if (ensurer != null) { return ensurer(app, url); }
        return Image.EnsureUrl(app, url);
    }
}
