using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// 单元格悬浮编辑器契约（CellEditor / 编辑态插槽）：
// 当用户通过双击、敲击键盘（Type-to-Edit）、按 F2 或 Enter 激活单元格编辑时，
// 表格通过此接口获取或重用一个真实 Control 实例，将其悬浮停靠在单元格绝对坐标上。
// 全局单例/按列类型单例，全表同一时刻只激活 1 个 Editor，避免控件树爆炸。
public class CellEditor {
    // 获取或创建用于编辑该列的真实控件（如 Input、SelectBox、DatePicker 或用户自定义控件）
    public virtual Control CreateWidget(App app, DataTableState st, DataColumn col) {
        return null;
    }

    // 激活编辑：将数据源当前值绑定到控件，并重置校验状态
    public virtual void BeginEdit(Control ctl, string initValue, DataColumn col) {
    }

    // 读取编辑后的文本值（准备提交）
    public virtual string GetValue(Control ctl, DataColumn col) {
        return "";
    }

    // 将输入焦点移入该控件（选中文字、展开下拉或弹窗等）
    public virtual void Focus(App app, Control ctl) {
    }

    // 键盘按键预处理（返回 true 表示已被编辑器处理，不触发 DataTable 的格间跳转）
    public virtual bool OnKeyDown(Control ctl, int key, DataTableState st) {
        return false;
    }

    // 编辑结束清理
    public virtual void EndEdit(Control ctl) {
    }
}
