using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

/// <summary>
/// 内置字符串值组件适配器（cellType 10 WidgetCol）。与数值形态的
/// <see cref="BandGridComp"/> 平级：把单元格文本（开关的布尔、下拉
/// 的选中项、评分的星数……）灌进一个池化的真控件，渲染后经
/// TakeCommit 上报写回。注册表见 DataTable.EnsureCompRegistry。
///
/// 池化键与 bandgrid 一致（RowKey + 列号）；`Acquire` 不用数据，
/// 形状参数对无矩阵概念的控件无意义（传 1×1）。
///
/// 写回语义：FillStr 记录灌入值，TakeCommit 只在用户改动后返回
/// 新值——引擎比对单元格现状相同则静默跳过，不同则
/// Journal(RowEdit.Cell) → src.SetCell → CellEdit（撤销/事件齐全）。
/// </summary>

/// "switch" 适配器：布尔值按列的 boolTrue/boolFalse 文本序列化
/// （与 bool 列口径一致），SetOn 灌入、IsOn 上报。
class SwitchComp : CellComp {
    List<string> poolKeys;
    List<Control> poolCtl;
    DataColumn lastCol;
    bool lastOn;

    SwitchComp() : base("switch") {
        this.poolKeys = new List<string>();
        this.poolCtl = new List<Control>();
        this.lastCol = null;
        this.lastOn = false;
    }

    override Control Acquire(App app, DataSource src, int row, int col,
                             RowKey key, int x, int y, int w, int h,
                             int rows, int cols) {
        string k = WidgetComps.PoolKey(key, col);
        for (int i = 0; i < this.poolKeys.Count; i = i + 1) {
            if (this.poolKeys[i] == k) { return this.poolCtl[i]; }
        }
        Switch sw = new Switch();
        sw.wiresOwnEvents = true;
        if (this.poolKeys.Count >= CellComp.PoolCap) { this.Reset(); }
        this.poolKeys.Add(k);
        this.poolCtl.Add(sw);
        return sw;
    }

    override void FillStr(Control ctl, string val, DataColumn col,
                          DataSource src, int row) {
        Switch sw = (Switch)ctl;
        this.lastCol = col;
        this.lastOn = WidgetComps.BoolOf(col, val);
        if (sw.IsOn() != this.lastOn) { sw.SetOn(this.lastOn); }
    }

    /// 仅在控件状态相对本次灌入值发生变化（= 本帧用户点击）
    /// 时上报，文本走列布尔口径。展示从不写数据：排序/筛选/
    /// 换页重灌不会误触发提交，引擎的 nv != val 只是兜底。
    override bool TakeCommit(Control ctl, ref string outVal) {
        Switch sw = (Switch)ctl;
        bool on = sw.IsOn();
        if (on == this.lastOn) { return false; }
        outVal = WidgetComps.BoolText(this.lastCol, on);
        this.lastOn = on;
        return true;
    }

    override void Reset() {
        this.poolKeys.Clear();
        this.poolCtl.Clear();
        this.lastCol = null;
        this.lastOn = false;
    }
}

/// "checkbox" 适配器：布尔值（同 switch 的序列化口径），格内
/// 一个无标题复选框。
class CheckboxComp : CellComp {
    List<string> poolKeys;
    List<Control> poolCtl;
    DataColumn lastCol;
    bool lastOn;

    CheckboxComp() : base("checkbox") {
        this.poolKeys = new List<string>();
        this.poolCtl = new List<Control>();
        this.lastCol = null;
        this.lastOn = false;
    }

    override Control Acquire(App app, DataSource src, int row, int col,
                             RowKey key, int x, int y, int w, int h,
                             int rows, int cols) {
        string k = WidgetComps.PoolKey(key, col);
        for (int i = 0; i < this.poolKeys.Count; i = i + 1) {
            if (this.poolKeys[i] == k) { return this.poolCtl[i]; }
        }
        Checkbox cb = new Checkbox();
        cb.wiresOwnEvents = true;
        cb.SetLabel("");
        if (this.poolKeys.Count >= CellComp.PoolCap) { this.Reset(); }
        this.poolKeys.Add(k);
        this.poolCtl.Add(cb);
        return cb;
    }

    override void FillStr(Control ctl, string val, DataColumn col,
                          DataSource src, int row) {
        Checkbox cb = (Checkbox)ctl;
        this.lastCol = col;
        this.lastOn = WidgetComps.BoolOf(col, val);
        if (cb.IsChecked() != this.lastOn) { cb.SetChecked(this.lastOn); }
    }

    /// 与 SwitchComp 同契约：仅本帧用户点击才上报，列口径文本。
    override bool TakeCommit(Control ctl, ref string outVal) {
        Checkbox cb = (Checkbox)ctl;
        bool on = cb.IsChecked();
        if (on == this.lastOn) { return false; }
        outVal = WidgetComps.BoolText(this.lastCol, on);
        this.lastOn = on;
        return true;
    }

    override void Reset() {
        this.poolKeys.Clear();
        this.poolCtl.Clear();
        this.lastCol = null;
        this.lastOn = false;
    }
}

/// "rate" 适配器：整星数（0..N 文本）。显数 N 取列形状 shapeC
/// （<=0 用 Rate 默认），经 Shape 声明。Rate 内部以 *2 编码支持
/// 半星；这里只用整数档。
class RateComp : CellComp {
    List<string> poolKeys;
    List<Control> poolCtl;
    int lastV;

    RateComp() : base("rate") {
        this.poolKeys = new List<string>();
        this.poolCtl = new List<Control>();
        this.lastV = 0;
    }

    override Control Acquire(App app, DataSource src, int row, int col,
                             RowKey key, int x, int y, int w, int h,
                             int rows, int cols) {
        string k = WidgetComps.PoolKey(key, col);
        for (int i = 0; i < this.poolKeys.Count; i = i + 1) {
            if (this.poolKeys[i] == k) { return this.poolCtl[i]; }
        }
        // 星数不在这里定：cellType 10 没有矩阵概念，DrawCompCell
        // 传来的 cols 已退化成 1（空序列兜底），按它设置就成了
        // “一格一星”。显数由 FillStr 按列 shapeC 解析（见下）。
        Rate r = new Rate();
        r.wiresOwnEvents = true;
        if (this.poolKeys.Count >= CellComp.PoolCap) { this.Reset(); }
        this.poolKeys.Add(k);
        this.poolCtl.Add(r);
        return r;
    }

    override void FillStr(Control ctl, string val, DataColumn col,
                          DataSource src, int row) {
        Rate r = (Rate)ctl;
        // 显数取列形状 shapeC，未声明用 Rate 默认 5。
        int want = (col != null && col.shapeC > 0) ? col.shapeC : 5;
        if (r.MaxStars() != want) { r.Max(want); }
        int v = DataTable.ParseInt(val);
        if (v < 0) { v = 0; }
        // 越界值按显数截断展示，lastV 记截断后的值——若记原值，
        // TakeCommit 会把“展示截断”当用户改动，下一帧自动把格里
        // 的 9 覆盖成 5（展示路径写数据）。
        if (v > want) { v = want; }
        this.lastV = v;
        if (r.Value() != v) { r.SetStars(v); }
    }

    /// 空文本/非数值灌 0 后不再上报 "0"（展示不写数据）。
    override bool TakeCommit(Control ctl, ref string outVal) {
        Rate r = (Rate)ctl;
        int v = r.Value();
        if (v == this.lastV) { return false; }
        outVal = Convert.ToString(v);
        this.lastV = v;
        return true;
    }

    override void Reset() {
        this.poolKeys.Clear();
        this.poolCtl.Clear();
        this.lastV = 0;
    }
}

/// "select" 适配器：选项列 `choices`（Options 声明），单元格值是
/// 所选项文本。灌入按文本匹配 SetIndex；上报当前选项标签。
class SelectComp : CellComp {
    List<string> poolKeys;
    List<Control> poolCtl;
    int lastIdx;

    SelectComp() : base("select") {
        this.poolKeys = new List<string>();
        this.poolCtl = new List<Control>();
        this.lastIdx = 0 - 1;
    }

    override Control Acquire(App app, DataSource src, int row, int col,
                             RowKey key, int x, int y, int w, int h,
                             int rows, int cols) {
        string k = WidgetComps.PoolKey(key, col);
        for (int i = 0; i < this.poolKeys.Count; i = i + 1) {
            if (this.poolKeys[i] == k) { return this.poolCtl[i]; }
        }
        SelectBox s = new SelectBox();
        s.wiresOwnEvents = true;
        if (this.poolKeys.Count >= CellComp.PoolCap) { this.Reset(); }
        this.poolKeys.Add(k);
        this.poolCtl.Add(s);
        return s;
    }

    override void FillStr(Control ctl, string val, DataColumn col,
                          DataSource src, int row) {
        SelectBox s = (SelectBox)ctl;
        if (col.choices != null && s.SelectCount() != col.choices.Count) {
            s.ClearOptions();
            for (int i = 0; i < col.choices.Count; i = i + 1) {
                s.AddOption(col.choices[i]);
            }
            s.SetIndex(0 - 1);
        }
        if (val == s.SelectedLabel()) {
            this.lastIdx = s.Selected();
            return;
        }
        int idx = 0 - 1;
        // 列没声明 Options 时不能按 null choices 取 Count：
        // 未知值灌 -1 的路径也要能走到。
        if (col.choices != null) {
            for (int i = 0; i < col.choices.Count; i = i + 1) {
                if (col.choices[i] == val) { idx = i; break; }
            }
        }
        if (idx != s.Selected()) { s.SetIndex(idx); }
        this.lastIdx = idx;
    }

    /// 单元格值不在 choices 内时灌 -1，TakeCommit 因状态未变
    /// 不上报——展示不会把未知值清成空串。
    override bool TakeCommit(Control ctl, ref string outVal) {
        SelectBox s = (SelectBox)ctl;
        if (s.Selected() == this.lastIdx) { return false; }
        outVal = s.SelectedLabel();
        this.lastIdx = s.Selected();
        return true;
    }

    override void Reset() {
        this.poolKeys.Clear();
        this.poolCtl.Clear();
        this.lastIdx = 0 - 1;
    }
}

/// "buttons" 适配器：ButtonGroup 分段模式（选项同样取列
/// `choices`）。点击段 Raise CellClick（CompPos 报段号）——动作
/// 语义；值变化（当前段作为文本写回）时经 TakeCommit 提交。
/// 数据源只读时 SetCell 是空操作，自然退化为纯动作列；
/// `Actions()` 声明的动作列则连状态都不落——不回写标签，
/// 单元格文本保持原值，活动段视觉由 FillStr 每帧复位。
class ButtonsComp : CellComp {
    List<string> poolKeys;
    List<Control> poolCtl;
    string lastLabel;
    bool lastAction;

    ButtonsComp() : base("buttons") {
        this.poolKeys = new List<string>();
        this.poolCtl = new List<Control>();
        this.lastLabel = "";
        this.lastAction = false;
    }

    override Control Acquire(App app, DataSource src, int row, int col,
                             RowKey key, int x, int y, int w, int h,
                             int rows, int cols) {
        string k = WidgetComps.PoolKey(key, col);
        for (int i = 0; i < this.poolKeys.Count; i = i + 1) {
            if (this.poolKeys[i] == k) { return this.poolCtl[i]; }
        }
        ButtonGroup g = new ButtonGroup(0);
        g.SetSize(1);
        if (this.poolKeys.Count >= CellComp.PoolCap) { this.Reset(); }
        this.poolKeys.Add(k);
        this.poolCtl.Add(g);
        return g;
    }

    override void FillStr(Control ctl, string val, DataColumn col,
                          DataSource src, int row) {
        ButtonGroup g = (ButtonGroup)ctl;
        if (col.choices != null && g.SegCount() != col.choices.Count) {
            g.ClearSegs();
            for (int i = 0; i < col.choices.Count; i = i + 1) {
                g.Add(col.choices[i]);
            }
        }
        if (col != null && col.actionOnly) {
            // 动作列：高亮不代表任何数据——每帧复位，
            // 点击的按压态只活当帧。
            g.SetActiveIndex(0 - 1);
        } else if (val != g.ActiveLabel()) {
            g.SetActive(val);
        }
        this.lastLabel = g.ActiveLabel();
        this.lastAction = col != null && col.actionOnly;
    }

    /// 段选择未变不上报（重灌当前值不会写数据）；点击动作语义
    /// 不受影响——CellClick 经 CompPos 独立归一，仍每次触发。
    /// 动作列（Actions()）从不提交：点击只报 CellClick。
    override bool TakeCommit(Control ctl, ref string outVal) {
        ButtonGroup g = (ButtonGroup)ctl;
        if (this.lastAction) { return false; }
        string lbl = g.ActiveLabel();
        if (lbl == "" || lbl == this.lastLabel) { return false; }
        outVal = lbl;
        this.lastLabel = lbl;
        return true;
    }

    override bool CompPos(Control ctl, ref int r, ref int c) {
        ButtonGroup g = (ButtonGroup)ctl;
        int hit = g.TakeClicked();
        if (hit < 0) { return false; }
        r = 0;
        c = hit;
        return true;
    }

    override void Reset() {
        this.poolKeys.Clear();
        this.poolCtl.Clear();
        this.lastLabel = "";
        this.lastAction = false;
    }
}

/// 内置适配器装配与共享小工具。
class WidgetComps {
    /// 池化键（与 BandGridComp 同约定：稳定行键 + 列号）。
    static string PoolKey(RowKey key, int col) {
        return key.Canonical() + ":" + Convert.ToString(col);
    }

    /// 布尔列口径解读：声明的 boolTrue/boolFalse 文本精确匹配
    /// 优先（"是"/"否" 等自定义口径 ParseBool 不认识），其余交
    /// ParseBool（"1"/"true"/"yes"/"✓"…）。
    static bool BoolOf(DataColumn c, string val) {
        if (c != null && c.boolTrue != "" && val == c.boolTrue) { return true; }
        if (c != null && c.boolFalse != "" && val == c.boolFalse) { return false; }
        return DataTable.ParseBool(val);
    }

    /// 布尔列口径文本：开关/复选提交写回用，与 ToggleBoolCell
    /// 同一套口径，不产生混方言数据。
    static string BoolText(DataColumn c, bool on) {
        if (c != null && on && c.boolTrue != "") { return c.boolTrue; }
        if (c != null && !on && c.boolFalse != "") { return c.boolFalse; }
        return on ? "1" : "0";
    }
}

partial class DataTable {
    /// 装配字符串值内置组件（幂等，紧随 bandgrid）。
    static void EnsureWidgetComps() {
        CellComp.Register(new SwitchComp());
        CellComp.Register(new CheckboxComp());
        CellComp.Register(new RateComp());
        CellComp.Register(new SelectComp());
        CellComp.Register(new ButtonsComp());
    }
}
