using System;
using Gui;

namespace Gui.Component.DataTable;

// 撤销/重做日志与行事务编辑状态聚类实体。
// 收敛原平铺在 DataTableState 中的 undo* / redo* 状态字段。
public class DataTableUndoState {
    public List<RowEdit> undoLog;
    public List<RowEdit> redoLog;
    public int undoLimit;
    public bool undoing;
    public int lastAddedRow;
    public int undoGroup;
    public int undoGroupSeq;

    public DataTableUndoState() {
        this.undoLog = new List<RowEdit>();
        this.redoLog = new List<RowEdit>();
        this.undoLimit = 100;
        this.undoing = false;
        this.lastAddedRow = -1;
        this.undoGroup = 0;
        this.undoGroupSeq = 0;
    }

    public void Clear() {
        this.undoLog.Clear();
        this.redoLog.Clear();
        this.undoing = false;
        this.lastAddedRow = -1;
        this.undoGroup = 0;
        this.undoGroupSeq = 0;
    }
}
