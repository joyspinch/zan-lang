using System;

namespace Gui.Component.DataTable;

// 过滤键的查询内缓存。列值只在 Execute 开始时解析一次，比较器
// 只读取 primitive 数组；Empty/NotEmpty 仍依据原始文本判断。
public class LocalFilterColumn {
    int kind;
    int mode;
    string aText;
    string bText;
    int aInt;
    int bInt;
    double aReal;
    double bReal;
    bool aBool;
    bool bBool;
    List<int> ints;
    List<double> reals;
    List<bool> bools;

    // 构造过滤列：类型化（kind 1–3）的两个比较值在构造时解析一次。
    LocalFilterColumn(int valueKind, int op, string a, string b) {
        this.kind = valueKind;
        this.mode = op;
        this.aText = a;
        this.bText = b;
        if (this.aText == null) { this.aText = ""; }
        if (this.bText == null) { this.bText = ""; }
        this.aInt = 0;
        this.bInt = 0;
        this.aReal = 0.0;
        this.bReal = 0.0;
        this.aBool = false;
        this.bBool = false;
        if (this.kind == 1) {
            this.aInt = DataTable.ParseInt(this.aText);
            this.bInt = DataTable.ParseInt(this.bText);
        } else if (this.kind == 2) {
            this.aReal = DataTable.ParseReal(this.aText);
            this.bReal = DataTable.ParseReal(this.bText);
        } else if (this.kind == 3) {
            this.aBool = DataTable.ParseBool(this.aText);
            this.bBool = DataTable.ParseBool(this.bText);
        }
        this.ints = new List<int>();
        this.reals = new List<double>();
        this.bools = new List<bool>();
    }

    // 追加一行的预解析值：按 kind 解析文本；kind=0（文本）不缓存。
    public void Add(string value) {
        if (value == null) { value = ""; }
        if (this.kind == 1) { this.ints.Add(DataTable.ParseInt(value)); }
        else if (this.kind == 2) { this.reals.Add(DataTable.ParseReal(value)); }
        else if (this.kind == 3) { this.bools.Add(DataTable.ParseBool(value)); }
    }

    // 第 row 行是否通过本列过滤。类型化操作按预解析值比较
    // （Between 为闭区间；bool 只支持 Equals），Empty/NotEmpty
    // 始终按原始文本判断，其余模式回退 PassText 的文本语义。
    public bool Pass(string raw, int row) {
        if (raw == null) { raw = ""; }
        if (this.kind == 1) {
            int value = this.ints[row];
            if (this.mode == QueryFilterMode.Equals) { return value == this.aInt; }
            if (this.mode == QueryFilterMode.Greater) { return value > this.aInt; }
            if (this.mode == QueryFilterMode.GreaterOrEqual) { return value >= this.aInt; }
            if (this.mode == QueryFilterMode.Less) { return value < this.aInt; }
            if (this.mode == QueryFilterMode.LessOrEqual) { return value <= this.aInt; }
            if (this.mode == QueryFilterMode.Between) { return value >= this.aInt && value <= this.bInt; }
        } else if (this.kind == 2) {
            double value = this.reals[row];
            if (this.mode == QueryFilterMode.Equals) { return value == this.aReal; }
            if (this.mode == QueryFilterMode.Greater) { return value > this.aReal; }
            if (this.mode == QueryFilterMode.GreaterOrEqual) { return value >= this.aReal; }
            if (this.mode == QueryFilterMode.Less) { return value < this.aReal; }
            if (this.mode == QueryFilterMode.LessOrEqual) { return value <= this.aReal; }
            if (this.mode == QueryFilterMode.Between) { return value >= this.aReal && value <= this.bReal; }
        } else if (this.kind == 3) {
            bool value = this.bools[row];
            if (this.mode == QueryFilterMode.Equals) { return value == this.aBool; }
        }
        return this.mode == QueryFilterMode.Empty ? raw.Length == 0
            : (this.mode == QueryFilterMode.NotEmpty ? raw.Length > 0
            : this.PassText(raw));
    }

    // 对原始文本执行文本语义比较：Contains/StartsWith/EndsWith、
    // 字典序比较（Equals/Greater/Less 及组合）与闭区间 Between；
    // 未识别的模式放行。
    public bool PassText(string value) {
        int cmp = DataTable.CompareStr(value, this.aText);
        if (this.mode == QueryFilterMode.Contains) {
            if (this.aText.Length == 0) { return true; }
            for (int i = 0; i + this.aText.Length <= value.Length; i = i + 1) {
                if (value.Substring(i, this.aText.Length) == this.aText) { return true; }
            }
            return false;
        }
        if (this.mode == QueryFilterMode.StartsWith) {
            return value.Length >= this.aText.Length
                && value.Substring(0, this.aText.Length) == this.aText;
        }
        if (this.mode == QueryFilterMode.EndsWith) {
            return value.Length >= this.aText.Length
                && value.Substring(value.Length - this.aText.Length, this.aText.Length) == this.aText;
        }
        if (this.mode == QueryFilterMode.Equals) { return cmp == 0; }
        if (this.mode == QueryFilterMode.Greater) { return cmp > 0; }
        if (this.mode == QueryFilterMode.GreaterOrEqual) { return cmp >= 0; }
        if (this.mode == QueryFilterMode.Less) { return cmp < 0; }
        if (this.mode == QueryFilterMode.LessOrEqual) { return cmp <= 0; }
        if (this.mode == QueryFilterMode.Between) {
            return cmp >= 0 && DataTable.CompareStr(value, this.bText) <= 0;
        }
        return true;
    }
}
