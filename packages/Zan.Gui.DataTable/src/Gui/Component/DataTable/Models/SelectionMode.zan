using System;
using System.Json;

namespace Gui.Component.DataTable;

// 选择粒度。Row 是默认的数据行选择模式；Cell/Range 为后续
// 单元格命令保留明确的协议值。
public class SelectionMode {
    // 数据行选择（默认）。
    static const int Row = 1;
    // 单元格选择（协议保留值）。
    static const int Cell = 2;
    // 区域选择（协议保留值）。
    static const int Range = 3;
}
