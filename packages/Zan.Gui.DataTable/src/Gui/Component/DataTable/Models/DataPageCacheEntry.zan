using System;

namespace Gui.Component.DataTable;

// 页缓存条目：页键、结果与估算字节占用。pinned 的页不参与
// 淘汰；lastUse 记录最近使用的时钟值，供 LRU 比较。
public class DataPageCacheEntry {
    DataPageKey key;
    QueryResult result;
    int bytes;
    bool pinned;
    int lastUse;

    // 构造条目；pinned 初始为 false，lastUse 取时钟 stamp。
    DataPageCacheEntry(DataPageKey pageKey, QueryResult page,
                       int byteSize, int stamp) {
        this.key = pageKey;
        this.result = page;
        this.bytes = byteSize;
        this.pinned = false;
        this.lastUse = stamp;
    }

    // 页键。
    DataPageKey Key() { return this.key; }
    // 缓存的页结果。
    QueryResult Result() { return this.result; }
    // 估算字节占用。
    int Bytes() { return this.bytes; }
    // 是否被固定（不参与淘汰）。
    bool Pinned() { return this.pinned; }
    // 最近使用的时钟值。
    int LastUse() { return this.lastUse; }
}
