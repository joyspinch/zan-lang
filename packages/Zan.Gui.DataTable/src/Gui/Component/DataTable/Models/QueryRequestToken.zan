using System;

namespace Gui.Component.DataTable;

// 一次查询请求的不可变身份。cancel 只改变请求状态，不改变身份，
// 因而迟到结果即使内容相同也不能重新进入缓存。
public class QueryRequestToken {
    int requestId;
    int generation;
    string queryText;
    int queryHash;
    int schemaVersion;
    int serverRevision;
    bool cancelled;

    // 构造请求身份；cancelled 初始为 false，canonical 为 null 记空串。
    QueryRequestToken(int id, int gen, string canonical, int hash,
                      int schema, int server) {
        this.requestId = id;
        this.generation = gen;
        this.queryText = canonical;
        if (this.queryText == null) { this.queryText = ""; }
        this.queryHash = hash;
        this.schemaVersion = schema;
        this.serverRevision = server;
        this.cancelled = false;
    }

    // 单调递增的请求序号。
    int RequestId() { return this.requestId; }
    // 创建时的源 generation；Refresh/SetSchema 等会使旧代失效。
    int Generation() { return this.generation; }
    // 请求的 canonical 查询文本。
    string QueryText() { return this.queryText; }
    // 查询指纹。
    int QueryHash() { return this.queryHash; }
    // 创建时的 schema 版本。
    int SchemaVersion() { return this.schemaVersion; }
    // 创建时的服务端 revision。
    int ServerRevision() { return this.serverRevision; }
    // token 是否已被取消。
    bool IsCancelled() { return this.cancelled; }
    // 取消该 token；只改变请求状态，不改变身份。
    void Cancel() { this.cancelled = true; }

    // 六个身份字段全部相等才视为同一次请求；other 为 null 返回 false。
    public bool SameIdentity(QueryRequestToken other) {
        if (other == null) { return false; }
        return this.requestId == other.requestId
            && this.generation == other.generation
            && this.queryText == other.queryText
            && this.queryHash == other.queryHash
            && this.schemaVersion == other.schemaVersion
            && this.serverRevision == other.serverRevision;
    }
}
