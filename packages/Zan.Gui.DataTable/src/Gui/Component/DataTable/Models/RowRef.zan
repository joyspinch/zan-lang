using System;

namespace Gui.Component.DataTable;

// 行键与当前数据源位置的短期映射。
// locator 会随排序、过滤和页缓存变化，不能持久化为身份。
public class RowRef {
    RowKey key;
    int locator;
    int revision;

    // 内部构造。
    RowRef(RowKey k, int at, int rev) {
        this.key = k;
        this.locator = at;
        this.revision = rev;
    }
}
