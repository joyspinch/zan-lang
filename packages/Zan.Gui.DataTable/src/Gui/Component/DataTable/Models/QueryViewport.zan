using System;

namespace Gui.Component.DataTable;

// 视口请求。start/count 用于 offset 分页；cursor 非空时可由服务端
// 采用 keyset/cursor 分页。查询描述本身不携带回调或运行时对象。
public class QueryViewport {
    int start;
    int count;
    string cursor;

    // 构造视口；start 钳制到 >=0，count 钳制到 >=1，cursor 为 null 记空串。
    QueryViewport(int at, int size, string token) {
        this.start = at;
        this.count = size;
        this.cursor = token;
        if (this.start < 0) { this.start = 0; }
        if (this.count < 1) { this.count = 1; }
        if (this.cursor == null) { this.cursor = ""; }
    }

    // 页起始行索引（offset 分页）。
    int Start() { return this.start; }
    // 请求的页大小（行数），至少 1。
    int Count() { return this.count; }
    // 服务端续页 token；未使用时为空串。
    string Cursor() { return this.cursor; }
    // 是否携带续页 token（可走 keyset/cursor 分页）。
    bool UsesCursor() { return this.cursor.Length > 0; }
}
