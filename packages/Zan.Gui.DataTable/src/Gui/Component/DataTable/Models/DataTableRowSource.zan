using System;
using System.Data.Excel;
using System.Threading;
using Gui;
using Gui.Component.DataTable;

namespace Gui.Component.DataTable;

// <see cref="XlsxRowSource"/> 适配器：把快照 + DataSource 逐行喂给
// 流式写盘。排序/过滤/勾选状态已在快照里冻结（所见即所得）；
// CellText/CellNum 等直接读应用侧数据源——导出期间应用不应改写
// 数据源内容（行数上限 1048576 由 XlsxBook 自动分表兜住）。
public class DataTableRowSource : XlsxRowSource {
    public DataSource src;
    public List<DataColumn> cols;
    public DataTableExportSnapshot snap;
    public DataTableExportProgress progress;
    public int headerRows;

    int GetHeaderRows() {
        if (this.headerRows > 0) { return this.headerRows; }
        return 1;
    }

    // 行数 = 快照行数 + 表头行数（支持多级表头）。
    override int RowCount() { return this.snap.rows.Count + this.GetHeaderRows(); }

    void FillHeaderRow(int index, List<XlsxCell> row) {
        int hRows = this.GetHeaderRows();
        for (int cc = this.snap.c0; cc <= this.snap.c1 && cc < this.cols.Count; cc = cc + 1) {
            DataColumn col = this.cols[cc];
            string path = col.band;
            int d = DataTable.BandDepth(path);
            if (d == 0) {
                if (index == 0) {
                    row.Add(XlsxCell.Str(col.title));
                } else {
                    row.Add(XlsxCell.Str(""));
                }
            } else {
                if (index < d) {
                    string pCur = DataTable.BandPrefix(path, index + 1);
                    bool isSecondary = false;
                    if (cc > this.snap.c0) {
                        string pPrev = DataTable.BandPrefix(this.cols[cc - 1].band, index + 1);
                        if (pCur == pPrev && pCur != "") {
                            isSecondary = true;
                        }
                    }
                    if (isSecondary) {
                        row.Add(XlsxCell.Str(""));
                    } else {
                        List<string> parts = path.Split("/");
                        string seg = index < parts.Count ? parts[index] : "";
                        row.Add(XlsxCell.Str(seg));
                    }
                } else if (index == d) {
                    row.Add(XlsxCell.Str(col.title));
                } else {
                    row.Add(XlsxCell.Str(""));
                }
            }
        }
    }

    // index < headerRows 写表头，其余按快照行序逐格写出数据行。
    override bool FillRow(int index, List<XlsxCell> row) {
        int hRows = this.GetHeaderRows();
        if (index < hRows) {
            this.FillHeaderRow(index, row);
            return true;
        }
        int ri = this.snap.rows[index - hRows];
        for (int cc = this.snap.c0; cc <= this.snap.c1 && cc < this.cols.Count; cc = cc + 1) {
            row.Add(DataTableXlsx.ExportCell(cc, this.cols, this.cols[cc], this.src, ri));
        }
        return true;
    }

    // 把写盘进度转发给调用方钩子；未挂接 progress 时忽略。
    override void OnProgress(int done, int total) {
        if (this.progress != null) { this.progress.OnProgress(done, total); }
    }

    // 把取消询问转发给调用方钩子；未挂接 progress 时恒不取消。
    override bool Cancelled() {
        return this.progress != null && this.progress.Cancelled();
    }
}
