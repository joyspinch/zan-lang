using System;
using System.Data.Excel;
using System.Threading;
using Gui;
using Gui.Component.DataTable;

namespace Gui.Component.DataTable;

// <see cref="XlsxRowSource"/> 适配器：把快照 + DataSource 逐行喂给
// 流式写盘。排序/过滤/勾选状态已在快照里冻结（所见即所得）；
// CellText/CellNum 等直接读应用侧数据源——导出期间应用不应改写
// 数据源内容（行数上限 1048576 由 XlsxBook 自动分表兜住）。
class DataTableRowSource : XlsxRowSource {
    public DataSource src;
    public List<DataColumn> cols;
    public DataTableExportSnapshot snap;
    public DataTableExportProgress progress;

    // 行数 = 快照行数 + 1（表头行）。
    override int RowCount() { return this.snap.rows.Count + 1; }

    // index 0 写表头（快照列区间内的列标题），其余按快照行序
    // 逐格写出数据行。
    override bool FillRow(int index, List<XlsxCell> row) {
        if (index == 0) {
            for (int cc = this.snap.c0; cc <= this.snap.c1; cc = cc + 1) {
                row.Add(XlsxCell.Str(this.cols[cc].title));
            }
            return true;
        }
        int ri = this.snap.rows[index - 1];
        for (int cc = this.snap.c0; cc <= this.snap.c1; cc = cc + 1) {
            row.Add(DataTableXlsx.ExportCell(cc, this.cols, this.cols[cc], this.src, ri));
        }
        return true;
    }

    // 把写盘进度转发给调用方钩子；未挂接 progress 时忽略。
    override void OnProgress(int done, int total) {
        if (this.progress != null) { this.progress.OnProgress(done, total); }
    }

    // 把取消询问转发给调用方钩子；未挂接 progress 时恒不取消。
    override bool Cancelled() {
        return this.progress != null && this.progress.Cancelled();
    }
}
