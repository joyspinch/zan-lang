using System;
using System.Json;

namespace Gui.Component.DataTable;

// 一个可传输的过滤谓词。column 是 schema 中的稳定列槽位；kind：
// 0 文本、1 整数、2 实数、3 bool。
public class QueryFilterClause {
    int column;
    int mode;
    int kind;
    string value;
    string value2;

    // 构造过滤子句；a/b 为 null 记空串。
    QueryFilterClause(int col, int op, string a, string b, int valueKind) {
        this.column = col;
        this.mode = op;
        this.kind = valueKind;
        this.value = a;
        if (this.value == null) { this.value = ""; }
        this.value2 = b;
        if (this.value2 == null) { this.value2 = ""; }
    }

    // schema 中的稳定列槽位。
    public int Column() { return this.column; }
    // 过滤操作符（QueryFilterMode）。
    public int Mode() { return this.mode; }
    // 值类型 kind：0 文本、1 整数、2 实数、3 bool。
    public int Kind() { return this.kind; }
    // 第一比较值文本。
    public string Value() { return this.value; }
    // 第二比较值文本（Between 的上界）。
    public string Value2() { return this.value2; }
}
