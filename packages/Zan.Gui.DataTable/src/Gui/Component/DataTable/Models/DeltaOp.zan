using System;
using System.Json;

namespace Gui.Component.DataTable;

// 一条实时增量操作。`kind`：0 upsert（按键整行写入或更新）、
// 1 remove（按键移除）、2 cell（按键修订单列的值）。
// 所有操作都以稳定 RowKey 的 canonical 文本为行身份——没有键的行
// 无法参与实时合并，调用方必须先为源配置键（KeyProvider 或源的
// GetRowKey）。upsert 的整行值放在 `cells`（与列列表按索引对齐）；
// cell 操作只写 `field`（列的稳定 Field 名）和 `value`。
public class DeltaOp {
    // 0：按键整行写入或更新。
    public static const int Upsert = 0;
    // 1：按键移除。
    public static const int Remove = 1;
    // 2：按键修订单列。
    public static const int Cell = 2;

    public int kind;
    public string key;
    public int revision;
    public List<string> cells;
    public string field;
    public string value;

    // 内部构造：cells 为空列表，field/value 为空串，key 为 null 记空串。
    public DeltaOp(int opKind, string rowKey, int rev) {
        this.kind = opKind;
        this.key = rowKey;
        if (this.key == null) { this.key = ""; }
        this.revision = rev;
        this.cells = new List<string>();
        this.field = "";
        this.value = "";
    }

    // 构造按键整行写入（已存在的键被覆盖，缺失的键追加）。
    public static DeltaOp UpsertRow(string rowKey, List<string> values, int rev) {
        DeltaOp op = new DeltaOp(DeltaOp.Upsert, rowKey, rev);
        if (values != null) {
            for (int i = 0; i < values.Count; i = i + 1) {
                string v = values[i];
                op.cells.Add(v == null ? "" : v);
            }
        }
        return op;
    }

    // 构造按键移除。键不存在时为幂等空操作。
    public static DeltaOp RemoveRow(string rowKey, int rev) {
        return new DeltaOp(DeltaOp.Remove, rowKey, rev);
    }

    // 构造按键修订单列。列用稳定 Field 名寻址，
    // 与列的重排/插入无关。
    public static DeltaOp SetCell(string rowKey, string fieldName, string cellValue, int rev) {
        DeltaOp op = new DeltaOp(DeltaOp.Cell, rowKey, rev);
        op.field = fieldName;
        if (op.field == null) { op.field = ""; }
        op.value = cellValue;
        if (op.value == null) { op.value = ""; }
        return op;
    }

    // 操作种类（Upsert/Remove/Cell）。
    public int Kind() { return this.kind; }
    // 行身份的 canonical 文本。
    public string Key() { return this.key; }
    // 构造时携带的行 revision。
    public int Revision() { return this.revision; }
    // cell 操作的列 Field 名；其他操作为空串。
    public string Field() { return this.field; }
    // cell 操作的新值；其他操作为空串。
    public string Value() { return this.value; }
    // upsert 的整行值（与列索引对齐）；其他操作为空列表。
    public List<string> Cells() { return this.cells; }

    // 一个 op 的瘦身拷贝：加入批后，调用方对原 cells 列表的
    // 后续修改不会影响批内已保存的值。
    public DeltaOp Copy() {
        DeltaOp op = new DeltaOp(this.kind, this.key, this.revision);
        for (int i = 0; i < this.cells.Count; i = i + 1) {
            op.cells.Add(this.cells[i]);
        }
        op.field = this.field;
        op.value = this.value;
        return op;
    }

    // op 的 JSON 形式：op/key/rev 恒有，upsert 带 cells 数组，
    // cell 带 field/value。
    public JsonValue ToJsonValue() {
        JsonValue root = JsonValue.NewObject();
        root.Put("op", JsonValue.NewNum(Convert.ToString(this.kind)));
        root.Put("key", JsonValue.NewStr(this.key));
        root.Put("rev", JsonValue.NewNum(Convert.ToString(this.revision)));
        if (this.kind == DeltaOp.Upsert) {
            JsonValue arr = JsonValue.NewArray();
            for (int i = 0; i < this.cells.Count; i = i + 1) {
                arr.Append(JsonValue.NewStr(this.cells[i]));
            }
            root.Put("cells", arr);
        } else if (this.kind == DeltaOp.Cell) {
            root.Put("field", JsonValue.NewStr(this.field));
            root.Put("value", JsonValue.NewStr(this.value));
        }
        return root;
    }

    // 从 JsonDoc 槽位解析单条 op；结构不完整或 kind 未知时返回 null。
    public static DeltaOp FromJsonDoc(JsonDoc doc, int slot) {
        if (doc == null || slot < 0 || doc.KindAt(slot) != 5) { return null; }
        int opSlot = doc.Get(slot, "op");
        int keySlot = doc.Get(slot, "key");
        if (opSlot < 0 || keySlot < 0) { return null; }
        int kind = doc.IntAt(opSlot, -1);
        if (kind != DeltaOp.Upsert && kind != DeltaOp.Remove
            && kind != DeltaOp.Cell) { return null; }
        string key = doc.StrAt(keySlot, "");
        if (key.Length == 0) { return null; }
        int revSlot = doc.Get(slot, "rev");
        int rev = revSlot >= 0 ? doc.IntAt(revSlot, 0) : 0;
        DeltaOp op = new DeltaOp(kind, key, rev);
        if (kind == DeltaOp.Upsert) {
            int cellsSlot = doc.Get(slot, "cells");
            if (cellsSlot >= 0 && doc.KindAt(cellsSlot) == 4) {
                int cCount = doc.Count(cellsSlot);
                int cSlot = doc.FirstChild(cellsSlot);
                for (int i = 0; i < cCount; i = i + 1) {
                    op.cells.Add(doc.StrAt(cSlot, ""));
                    cSlot = doc.NextSibling(cSlot);
                }
            }
        } else if (kind == DeltaOp.Cell) {
            int fieldSlot = doc.Get(slot, "field");
            if (fieldSlot >= 0) { op.field = doc.StrAt(fieldSlot, ""); }
            int valSlot = doc.Get(slot, "value");
            if (valSlot >= 0) { op.value = doc.StrAt(valSlot, ""); }
        }
        return op;
    }

    // 解析单条 op；结构不完整或 kind 未知时返回 null。
    public static DeltaOp FromJsonValue(JsonValue node) {
        if (node == null || !node.IsObject()) { return null; }
        if (!node.Has("op") || !node.Has("key")) { return null; }
        int kind = node.Int("op", -1);
        if (kind != DeltaOp.Upsert && kind != DeltaOp.Remove
            && kind != DeltaOp.Cell) { return null; }
        string key = node.Str("key", "");
        if (key.Length == 0) { return null; }
        int rev = node.Int("rev", 0);
        DeltaOp op = new DeltaOp(kind, key, rev);
        if (kind == DeltaOp.Upsert) {
            JsonValue arr = node.Get("cells");
            if (arr != null && arr.IsArray()) {
                for (int i = 0; i < arr.Count(); i = i + 1) {
                    op.cells.Add(arr.At(i).AsString(""));
                }
            }
        } else if (kind == DeltaOp.Cell) {
            op.field = node.Str("field", "");
            op.value = node.Str("value", "");
        }
        return op;
    }
}
