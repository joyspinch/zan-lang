using System;
using System.Json;

namespace Gui.Component.DataTable;

// 单个 mutation 的服务端结果。
public class MutationResult {
    // 1 接受、2 拒绝、3 冲突、4 取消。
    static const int Accepted = 1;
    static const int Rejected = 2;
    static const int Conflict = 3;
    static const int Cancelled = 4;

    string mutationId;
    int status;
    string canonicalValue;
    string serverValue;
    int serverRevision;
    string message;

    // 构造结果；各文本字段为 null 时记为空串。
    MutationResult(string id, int resultStatus, string canonical,
                   string server, int revision, string detail) {
        this.mutationId = id;
        this.status = resultStatus;
        this.canonicalValue = canonical;
        this.serverValue = server;
        this.serverRevision = revision;
        this.message = detail;
        if (this.mutationId == null) { this.mutationId = ""; }
        if (this.canonicalValue == null) { this.canonicalValue = ""; }
        if (this.serverValue == null) { this.serverValue = ""; }
        if (this.message == null) { this.message = ""; }
    }

    // 接受：canonical 为规范化后的新值，revision 为服务端行 revision。
    public static MutationResult AcceptedValue(string id, string value, int revision) {
        return new MutationResult(id, MutationResult.Accepted, value, "", revision, "");
    }
    // 拒绝：detail 说明原因，serverRevision 为 -1。
    public static MutationResult RejectedValue(string id, string detail) {
        return new MutationResult(id, MutationResult.Rejected, "", "", -1, detail);
    }
    // 冲突：server/serverRevision 为服务端当前值与行 revision。
    public static MutationResult ConflictValue(string id, string server, int revision,
                                        string detail) {
        return new MutationResult(id, MutationResult.Conflict, "", server, revision, detail);
    }
    // 取消：detail 说明原因，serverRevision 为 -1。
    public static MutationResult CancelledValue(string id, string detail) {
        return new MutationResult(id, MutationResult.Cancelled, "", "", -1, detail);
    }

    // 对应的 mutation 标识。
    string MutationId() { return this.mutationId; }
    // 结果状态（Accepted/Rejected/Conflict/Cancelled）。
    int Status() { return this.status; }
    // 接受时的规范化新值；其它状态为空串。
    string CanonicalValue() { return this.canonicalValue; }
    // 冲突时的服务端当前值；其它状态为空串。
    string ServerValue() { return this.serverValue; }
    // 服务端行 revision；拒绝/取消时为 -1。
    int ServerRevision() { return this.serverRevision; }
    // 失败/冲突说明文本。
    string Message() { return this.message; }

    // id 非空且状态为四个合法值之一时为 true。
    public bool IsValid() {
        return this.mutationId.Length > 0
            && (this.status == MutationResult.Accepted
                || this.status == MutationResult.Rejected
                || this.status == MutationResult.Conflict
                || this.status == MutationResult.Cancelled);
    }

    // 单个结果的传输 JSON（id/status/canonical/server/revision/message）。
    public string ToJson() {
        JsonValue root = JsonValue.NewObject();
        root.Put("id", JsonValue.NewStr(this.mutationId));
        root.Put("status", JsonValue.NewNum(Convert.ToString(this.status)));
        root.Put("canonical", JsonValue.NewStr(this.canonicalValue));
        root.Put("server", JsonValue.NewStr(this.serverValue));
        root.Put("revision", JsonValue.NewNum(Convert.ToString(this.serverRevision)));
        root.Put("message", JsonValue.NewStr(this.message));
        return root.ToJson();
    }
}
