using System;
using System.Json;

namespace Gui.Component.DataTable;

// 一个稳定的分组键。多个键按添加顺序形成分组路径。
public class QueryGroupClause {
    int column;
    int kind;

    // 构造分组子句。
    QueryGroupClause(int col, int valueKind) {
        this.column = col;
        this.kind = valueKind;
    }

    // schema 中的稳定列槽位。
    public int Column() { return this.column; }
    // 值类型 kind（与 QueryFilterClause 相同）。
    public int Kind() { return this.kind; }
}
