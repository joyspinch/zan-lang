using System;
using System.Json;

namespace Gui.Component.DataTable;

// 一个可传输的稳定排序键。多个键按添加顺序组成字典序。
// kind 与 QueryFilterClause 相同。
public class QuerySortClause {
    int column;
    int direction;
    int kind;

    // 构造排序子句；direction 为 1 升序、2 降序。
    QuerySortClause(int col, int dir, int valueKind) {
        this.column = col;
        this.direction = dir;
        this.kind = valueKind;
    }

    // schema 中的稳定列槽位。
    public int Column() { return this.column; }
    // 排序方向：1 升序、2 降序。
    public int Direction() { return this.direction; }
    // 值类型 kind（与 QueryFilterClause 相同）。
    public int Kind() { return this.kind; }
}
