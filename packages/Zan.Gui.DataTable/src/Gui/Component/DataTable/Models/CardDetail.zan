using System;
using Gui;
using Gui.Widget;
using Gui.Backend;

namespace Gui.Component.DataTable;

// 键值卡片详情：把主行（或任意键值对）渲染为
// label: value 两列卡片。子类持有数据，本类只管绘制
// 与尺寸（每对一行，clamp 到 maxSlots）。
public class CardDetail : DetailProvider {
    // 强类型键值项列表（唯一主表示，消除旧 labels/values 平行列表）。
    public List<CardDetailItem> items;
    public int maxSlots;

    // 内部构造；使用 Of() 创建。
    CardDetail() {
        this.items = new List<CardDetailItem>();
        this.maxSlots = 0;
    }

    // 创建空卡片，随后用 Add() 链式填充。
    static CardDetail Of() {
        return new CardDetail();
    }

    // 装配一对标签/值；返回 this 便于链式填充。
    CardDetail Add(string label, string value) {
        CardDetailItem it = new CardDetailItem(label, value);
        this.items.Add(it);
        return this;
    }

    // 详情带行槽数 = 键值对数，夹取到 [1, maxSlots]。
    override int Slots(DataSource src, int row) {
        int cap = this.maxSlots > 0 ? this.maxSlots : 8;
        int n = this.items.Count + 0;
        if (n > cap) { n = cap; }
        if (n < 1) { n = 1; }
        return n;
    }

    // 逐行绘制 label: value 两列；超出详情带高度的行不再绘制。
    override void Paint(App app, DataSource src, int row,
                        int x, int y, int w, int h) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int rowH = t.heightMedium;
        int pad = app.Scale(8);
        int fs = app.Scale(12);
        int cap = this.maxSlots > 0 ? this.maxSlots : 8;
        int n = this.items.Count;
        if (n > cap) { n = cap; }
        int lw = app.Scale(120);
        for (int i = 0; i < n; i = i + 1) {
            int ry = y + pad + i * rowH;
            if (ry + rowH > y + h) { break; }
            CardDetailItem it = this.items[i];
            c.DrawText(x + pad, Canvas.CenterTextY(ry, rowH, fs),
                       it.label, Style.Part(app, "datatable", "label", "", "", "",
                                            Style.SNormal()).FgOr(0), fs);
            c.DrawText(x + pad + lw, Canvas.CenterTextY(ry, rowH, fs),
                       it.value, Style.Part(app, "datatable", "cell", "", "", "",
                                            Style.SNormal()).FgOr(0), fs);
        }
    }
}
