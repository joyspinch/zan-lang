using System;
using Gui;

namespace Gui.Component.DataTable;

// Excel 式选区填充柄（Fill Handle）拖拽状态聚类实体。
// 收敛原平铺在 DataTableState 中的 fill* 状态字段。
public class DataTableFillState {
    public bool drag;
    public int hx;
    public int hy;
    public int sr0;
    public int sc0;
    public int sr1;
    public int sc1;
    public int tr0;
    public int tc0;
    public int tr1;
    public int tc1;

    public DataTableFillState() {
        this.drag = false;
        this.hx = -1;
        this.hy = -1;
        this.sr0 = -1;
        this.sc0 = -1;
        this.sr1 = -1;
        this.sc1 = -1;
        this.tr0 = 0;
        this.tc0 = 0;
        this.tr1 = -1;
        this.tc1 = -1;
    }

    public void Reset() {
        this.drag = false;
        this.hx = -1;
        this.hy = -1;
        this.sr0 = -1;
        this.sc0 = -1;
        this.sr1 = -1;
        this.sc1 = -1;
        this.tr0 = 0;
        this.tc0 = 0;
        this.tr1 = -1;
        this.tc1 = -1;
    }
}
