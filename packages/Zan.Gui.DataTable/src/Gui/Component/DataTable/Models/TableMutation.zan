using System;
using System.Json;

namespace Gui.Component.DataTable;

// 一次远程单元格修改的不可变描述。业务身份使用 RowKey，
// expectedRevision 用于服务端乐观并发校验。
public class TableMutation {
    string mutationId;
    RowKey rowKey;
    int column;
    int expectedRevision;
    string value;

    // 构造 mutation；id/value 为 null 时记为空串。
    TableMutation(string id, RowKey key, int col, int revision, string nextValue) {
        this.mutationId = id;
        this.rowKey = key;
        this.column = col;
        this.expectedRevision = revision;
        this.value = nextValue;
        if (this.mutationId == null) { this.mutationId = ""; }
        if (this.value == null) { this.value = ""; }
    }

    // 构造一个单元格修改；revision 为提交时客户端已知的行 revision。
    public static TableMutation Cell(string id, RowKey key, int col,
                              int revision, string nextValue) {
        return new TableMutation(id, key, col, revision, nextValue);
    }

    // 事务内唯一的 mutation 标识。
    string MutationId() { return this.mutationId; }
    // 目标行业务身份。
    RowKey Key() { return this.rowKey; }
    // 目标列索引。
    int Column() { return this.column; }
    // 乐观并发校验的期望行 revision；服务端值不一致即冲突。
    int ExpectedRevision() { return this.expectedRevision; }
    // 新单元格文本。
    string Value() { return this.value; }

    // id 非空、rowKey 存在、列索引与期望 revision 均非负时为 true。
    public bool IsValid() {
        return this.mutationId.Length > 0 && this.rowKey != null
            && this.column >= 0 && this.expectedRevision >= 0;
    }

    // 序列化为传输 JSON（id/key/col/rev/value）；rowKey 为 null 时 key 记空串。
    public string ToJson() {
        JsonValue root = JsonValue.NewObject();
        root.Put("id", JsonValue.NewStr(this.mutationId));
        root.Put("key", JsonValue.NewStr(this.rowKey == null ? "" : this.rowKey.Canonical()));
        root.Put("col", JsonValue.NewNum(Convert.ToString(this.column)));
        root.Put("rev", JsonValue.NewNum(Convert.ToString(this.expectedRevision)));
        root.Put("value", JsonValue.NewStr(this.value));
        return root.ToJson();
    }
}
