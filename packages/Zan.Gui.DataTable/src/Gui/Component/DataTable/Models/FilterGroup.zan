using System;

namespace Gui.Component.DataTable;

// AND/OR 组：`and` 为 true 时子条件与子组全部通过才通过，
// 为 false 时任一通过即通过。空组恒通过（AND 的单位元），
// 因此空 AND 组外层不会误杀全部行。
public class FilterGroup {
    bool and;
    List<FilterCondition> conditions;
    List<FilterGroup> groups;

    // 内部构造；使用 And()/Or() 创建。
    FilterGroup(bool isAnd) {
        this.and = isAnd;
        this.conditions = new List<FilterCondition>();
        this.groups = new List<FilterGroup>();
    }

    // 全部条件与子组取交集。
    public static FilterGroup And() { return new FilterGroup(true); }

    // 任一条件或子组通过即通过。
    public static FilterGroup Or() { return new FilterGroup(false); }

    // 组连接词：true = AND，false = OR。
    bool IsAnd() { return this.and; }

    // 本组的直接条件列表，按声明顺序求值。
    List<FilterCondition> Conditions() { return this.conditions; }

    // 子组列表，每个子组作为单个操作数递归求值。
    List<FilterGroup> Groups() { return this.groups; }
}
