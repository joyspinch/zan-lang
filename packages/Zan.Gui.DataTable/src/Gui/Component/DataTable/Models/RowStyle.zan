using System;
using Gui;

namespace Gui.Component.DataTable;

// 业务整行样式描述模型（用于告警行、状态行、逾期行整行高亮等，对标 AG Grid getRowStyle & DevExpress RowStyle）
public class RowStyle {
    int bg;       // 背景填充色（0 = 默认透明/隔行色）
    int fg;       // 文本前景色（0 = 默认）
    bool bold;    // 文本加粗
    int border;   // 整行边框色（0 = 默认行线）

    RowStyle() {
        this.bg = 0;
        this.fg = 0;
        this.bold = false;
        this.border = 0;
    }

    public static RowStyle Create(int bg, int fg) {
        RowStyle s = new RowStyle();
        s.bg = bg;
        s.fg = fg;
        return s;
    }

    public static RowStyle Bg(int bg) {
        RowStyle s = new RowStyle();
        s.bg = bg;
        return s;
    }

    public static RowStyle Warning() {
        return RowStyle.Create(0x28FFAA00, 0xD48800);
    }

    public static RowStyle Danger() {
        return RowStyle.Create(0x30FF4D4F, 0xCF1322);
    }

    public static RowStyle Success() {
        return RowStyle.Create(0x2852C41A, 0x389E0D);
    }

    public static RowStyle Muted() {
        return RowStyle.Create(0x18000000, 0x8C8C8C);
    }
}

// 整行样式判断委托：(src, rowIdx) => RowStyle (为 null 表示走默认行样式)
public delegate RowStyle RowStyleFunc(DataSource src, int rowIdx);
