using System;
using System.Json;

namespace Gui.Component.DataTable;

// 远端查询的下推/残差契约。Pushed 是服务端明确承诺执行的
// 操作，Residual 必须由后续执行器在完整候选集上完成；二者都保留
// 原查询的 dataset、revision、canonical text 和 hash。
public class QueryPlanContract {
    QueryPlan pushed;
    QueryPlan residual;
    int pushedCapabilities;
    int residualCapabilities;
    QueryPlanIssue issue;

    // 内部构造：pushed/residual 与两个能力掩码、issue 一一对应。
    QueryPlanContract(QueryPlan pushedPlan, QueryPlan residualPlan,
                      int pushedMask, int residualMask,
                      QueryPlanIssue problem) {
        this.pushed = pushedPlan;
        this.residual = residualPlan;
        this.pushedCapabilities = pushedMask;
        this.residualCapabilities = residualMask;
        this.issue = problem;
    }

    // 按能力掩码把已校验计划拆成下推与残差两个子计划：数据源支持的
    // 操作类别整体进入 pushed，其余整体落入 residual；两个子计划均
    // 保留完整查询身份。full 为 null 或无效时结果携带同一 issue。
    public static QueryPlanContract FromPlan(QueryPlan full, int supportedMask) {
        if (full == null) {
            return new QueryPlanContract(null, null, 0, 0,
                new QueryPlanIssue(QueryPlan.InvalidQuery,
                    "query plan is unavailable", -1, -1));
        }
        if (!full.IsValid()) {
            return new QueryPlanContract(null, null, 0, 0, full.Issue());
        }
        List<QueryFilterClause> pushedFilters = new List<QueryFilterClause>();
        List<QueryFilterClause> residualFilters = new List<QueryFilterClause>();
        List<QuerySortClause> pushedSorts = new List<QuerySortClause>();
        List<QuerySortClause> residualSorts = new List<QuerySortClause>();
        List<QueryGroupClause> pushedGroups = new List<QueryGroupClause>();
        List<QueryGroupClause> residualGroups = new List<QueryGroupClause>();
        List<QueryAggregateClause> pushedAggregates = new List<QueryAggregateClause>();
        List<QueryAggregateClause> residualAggregates = new List<QueryAggregateClause>();
        int pushedMask = 0;
        int residualMask = 0;

        for (int i = 0; i < full.FilterCount(); i = i + 1) {
            QueryFilterClause clause = full.FilterAt(i);
            if ((supportedMask & QueryCapabilities.Filter) != 0) {
                pushedFilters.Add(clause);
            } else {
                residualFilters.Add(clause);
            }
        }
        for (int i = 0; i < full.SortCount(); i = i + 1) {
            QuerySortClause clause = full.SortAt(i);
            if ((supportedMask & QueryCapabilities.Sort) != 0) {
                pushedSorts.Add(clause);
            } else {
                residualSorts.Add(clause);
            }
        }
        for (int i = 0; i < full.GroupCount(); i = i + 1) {
            QueryGroupClause clause = new QueryGroupClause(full.GroupColumnAt(i),
                full.GroupKindAt(i));
            if ((supportedMask & QueryCapabilities.Group) != 0) {
                pushedGroups.Add(clause);
            } else {
                residualGroups.Add(clause);
            }
        }
        for (int i = 0; i < full.AggregateCount(); i = i + 1) {
            QueryAggregateClause clause = new QueryAggregateClause(
                full.AggregateColumnAt(i), full.AggregateModeAt(i),
                full.AggregateKindAt(i));
            if ((supportedMask & QueryCapabilities.Aggregate) != 0) {
                pushedAggregates.Add(clause);
            } else {
                residualAggregates.Add(clause);
            }
        }
        if (pushedFilters.Count > 0) { pushedMask = pushedMask + QueryCapabilities.Filter; }
        if (pushedSorts.Count > 0) { pushedMask = pushedMask + QueryCapabilities.Sort; }
        if (pushedGroups.Count > 0) { pushedMask = pushedMask + QueryCapabilities.Group; }
        if (pushedAggregates.Count > 0) {
            pushedMask = pushedMask + QueryCapabilities.Aggregate;
        }
        if (residualFilters.Count > 0) {
            residualMask = residualMask + QueryCapabilities.Filter;
        }
        if (residualSorts.Count > 0) { residualMask = residualMask + QueryCapabilities.Sort; }
        if (residualGroups.Count > 0) { residualMask = residualMask + QueryCapabilities.Group; }
        if (residualAggregates.Count > 0) {
            residualMask = residualMask + QueryCapabilities.Aggregate;
        }
        QueryPlan pushedPlan = QueryPlan.Subset(full, supportedMask,
            pushedFilters, pushedSorts, pushedGroups, pushedAggregates);
        QueryPlan residualPlan = QueryPlan.Subset(full, 0,
            residualFilters, residualSorts, residualGroups, residualAggregates);
        return new QueryPlanContract(pushedPlan, residualPlan,
            pushedMask, residualMask, null);
    }

    // 先按“全能力”校验查询再拆分，使能力不足只影响下推范围，
    // 不会掩盖子句本身的校验错误；columnCount<0 表示列数未知。
    public static QueryPlanContract Build(QueryDescriptor query, int columnCount,
                                   QueryCapabilities supported) {
        int supportedMask = 0;
        if (supported != null) { supportedMask = supported.Mask(); }
        int allOperations = QueryCapabilities.Filter + QueryCapabilities.Sort
            + QueryCapabilities.Group + QueryCapabilities.Aggregate;
        QueryPlan full = QueryPlan.Build(query, columnCount,
            QueryCapabilities.Of(allOperations));
        return QueryPlanContract.FromPlan(full, supportedMask);
    }

    // 同上，但校验阶段追加 schema 值类型匹配检查。
    public static QueryPlanContract Build(QueryDescriptor query,
                                   List<SchemaColumn> schema,
                                   QueryCapabilities supported) {
        int supportedMask = 0;
        if (supported != null) { supportedMask = supported.Mask(); }
        int allOperations = QueryCapabilities.Filter + QueryCapabilities.Sort
            + QueryCapabilities.Group + QueryCapabilities.Aggregate;
        QueryPlan full = QueryPlan.Build(query, schema,
            QueryCapabilities.Of(allOperations));
        return QueryPlanContract.FromPlan(full, supportedMask);
    }

    // 契约无校验问题时为 true。
    bool IsValid() { return this.issue == null; }
    // 校验问题；有效契约为 null。
    QueryPlanIssue Issue() { return this.issue; }
    // 校验错误文本；无问题时为空串。
    string Error() { return this.issue == null ? "" : this.issue.Message(); }
    // 服务端承诺执行的下推子计划；契约无效时为 null。
    QueryPlan Pushed() { return this.pushed; }
    // 必须由后续执行器补执行的残差子计划；无残差时子句列表为空。
    QueryPlan Residual() { return this.residual; }
    // pushed 中实际出现的操作类别掩码。
    int PushedCapabilities() { return this.pushedCapabilities; }
    // residual 中实际出现的操作类别掩码。
    int ResidualCapabilities() { return this.residualCapabilities; }
    // 存在需要本地补执行的操作时为 true。
    bool HasResidual() { return this.residualCapabilities != 0; }
    // 有效且无残差，即查询可整体下推。
    bool IsComplete() { return this.IsValid() && !this.HasResidual(); }

    // 远端传输包的 canonical JSON。子计划 JSON 各自携带完整查询身份，
    // 服务端可以只读取 pushed，残差执行器可以只读取 residual。
    public string ToJson() {
        JsonValue root = JsonValue.NewObject();
        root.Put("ver", JsonValue.NewNum("1"));
        root.Put("pushedCaps", JsonValue.NewNum(Convert.ToString(this.pushedCapabilities)));
        root.Put("residualCaps", JsonValue.NewNum(Convert.ToString(this.residualCapabilities)));
        if (this.pushed != null) { root.Put("pushed", this.pushed.ToJsonValue()); }
        if (this.residual != null) { root.Put("residual", this.residual.ToJsonValue()); }
        if (this.issue != null) {
            JsonValue problem = JsonValue.NewObject();
            problem.Put("code", JsonValue.NewNum(Convert.ToString(this.issue.Code())));
            problem.Put("message", JsonValue.NewStr(this.issue.Message()));
            problem.Put("column", JsonValue.NewNum(Convert.ToString(this.issue.Column())));
            problem.Put("clause", JsonValue.NewNum(Convert.ToString(this.issue.Clause())));
            root.Put("issue", problem);
        }
        return root.ToJson();
    }
}
