using System;
using Gui;
using Gui.Widget;
using Gui.Backend;

namespace Gui.Component.DataTable;

// 卡片详情键值项实体（消除 labels/values 平行列表反模式）。
public class CardDetailItem {
    public string label;
    public string value;

    public CardDetailItem(string label, string value) {
        this.label = label != null ? label : "";
        this.value = value != null ? value : "";
    }
}
