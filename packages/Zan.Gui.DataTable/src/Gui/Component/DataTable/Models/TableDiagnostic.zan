using System;

namespace Gui.Component.DataTable;

// DataTable 的非致命结构诊断。诊断不改变旧 API 的返回值，
// 供宿主在开发/遥测模式下显示重复键、过期结果和能力不匹配。
public class TableDiagnostic {
    int code;
    string message;
    string field;
    int row;

    // 内部构造；经各 *Diagnostic 工厂创建。
    TableDiagnostic(int c, string msg, string f, int r) {
        this.code = c;
        this.message = msg;
        this.field = f;
        this.row = r;
    }

    // 诊断代码：1 重复键，2 缺少稳定键，3 过期结果，4 schema 不匹配。
    int Code() { return this.code; }
    // 人类可读的诊断消息。
    string Message() { return this.message; }
    // 相关列的 field 名；与列无关的诊断为空串。
    string Field() { return this.field; }
    // 相关数据行索引；schema 类诊断为 -1，
    // 过期结果诊断在此字段携带 generation。
    int Row() { return this.row; }
}
