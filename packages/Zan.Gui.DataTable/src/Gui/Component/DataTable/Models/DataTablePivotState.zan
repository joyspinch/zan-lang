using System;
using Gui;

namespace Gui.Component.DataTable;

// 透视表（Pivot View）运行时状态聚类实体。
// 收敛原平铺在 DataTableState 中的 pv* 状态字段，提升内聚性并支持独立重置。
public class DataTablePivotState {
    public int rowCol;
    public int colDim;
    public int valueCol;
    public List<string> rowKeys;
    public List<string> colKeys;
    public List<double> cells;
    public List<double> rowTot;
    public List<double> cellSum;
    public List<int> cellCnt;
    public List<double> cellMx;
    public List<double> cellMn;
    public List<DataColumn> viewCols;
    public DataSource inner;
    public PivotDataSource source;
    public bool dirty;
    public int origCols;
    public List<DataColumn> origColsList;
    public List<ColFilter> savedFilters;
    public List<string> savedFilterRowText;
    public List<int> savedGroupCols;
    public List<SortKey> savedSortKeys;
    public bool savedSummary;
    public string rowTitle;
    public string colTitle;
    public string valTitle;

    public DataTablePivotState() {
        this.rowCol = -1;
        this.colDim = -1;
        this.valueCol = -1;
        this.rowKeys = new List<string>();
        this.colKeys = new List<string>();
        this.cells = new List<double>();
        this.rowTot = new List<double>();
        this.cellSum = new List<double>();
        this.cellCnt = new List<int>();
        this.cellMx = new List<double>();
        this.cellMn = new List<double>();
        this.viewCols = new List<DataColumn>();
        this.inner = null;
        this.source = null;
        this.dirty = false;
        this.origCols = 0;
        this.origColsList = null;
        this.savedFilters = null;
        this.savedFilterRowText = null;
        this.savedGroupCols = null;
        this.savedSortKeys = null;
        this.savedSummary = false;
        this.rowTitle = "";
        this.colTitle = "";
        this.valTitle = "";
    }

    public void Reset() {
        this.rowCol = -1;
        this.colDim = -1;
        this.valueCol = -1;
        this.rowKeys.Clear();
        this.colKeys.Clear();
        this.cells.Clear();
        this.rowTot.Clear();
        this.cellSum.Clear();
        this.cellCnt.Clear();
        this.cellMx.Clear();
        this.cellMn.Clear();
        this.viewCols.Clear();
        this.inner = null;
        this.source = null;
        this.dirty = false;
        this.origCols = 0;
        this.origColsList = null;
        this.savedFilters = null;
        this.savedFilterRowText = null;
        this.savedGroupCols = null;
        this.savedSortKeys = null;
        this.savedSummary = false;
        this.rowTitle = "";
        this.colTitle = "";
        this.valTitle = "";
    }
}
