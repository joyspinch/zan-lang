using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// `DataGrid<T>` 的一列：引擎可理解的复用 `DataColumn` 描述符，
// 配以直接读取该列绑定 `T` 值的访问器，
// 使网格绑定到真实的
// 领域对象（`List<User>`），而非按位置排列的字符串单元格。
// 配置方法镜像 `DataColumn` 的（Money / Percent / Sortable / …），
// 原地修改描述符，因此可以流畅地链式组合：
// ```zan
// ```
public class GridColumn<T> {
    // DataTable 引擎读取的描述符（标题、宽度、类型、格式、
    // 汇总、编辑、冻结、band …）。与网格每帧交给引擎的列表
    // 按引用共享。
    public DataColumn desc;

    // 显示文本。为 null 时网格从列持有的类型化
    // 访问器推导，因此数值 / bool 列无需单独的
    // 文本读取器。
    public GridText<T> text;
    // 整数排序/聚合键（数值列）。为 null 时回退为解析
    // 显示文本。
    public GridInt<T> num;
    // 数值序列键（组件列）。null 时组件列无数据。
    public GridNums<T> nums;
    // 小数排序/聚合键（decimals > 0）。为 null 时回退为解析
    // 显示文本。
    public GridReal<T> real;
    // 布尔键（bool 列）。回退为解析显示文本。
    public GridBool<T> truth;
    // 就地编辑的回写。null 表示该列只读显示。
    public GridSet<T> setter;

    public GridColumn(DataColumn d) {
        this.desc = d;
        this.text = null;
        this.num = null;
        this.nums = null;
        this.real = null;
        this.truth = null;
        this.setter = null;
    }

    // ---- 编辑 ----
    // 使该列可编辑，并把提交的值通过 `w` 写回
    // 实体。
    public GridColumn<T> Editable(GridSet<T> w) {
        this.setter = w;
        DataColumn.Editable(this.desc);
        return this;
    }

    // 设置该列的悬浮编辑器（ICellEditor 编辑态宿主）
    public GridColumn<T> Editor(CellEditor e) {
        DataColumn.Editor(this.desc, e);
        return this;
    }

    // 直接挂载任意 Gui 控件作为该列编辑器（零胶水代码！）
    public GridColumn<T> ControlEditor(Control widget) {
        DataColumn.ControlEditor(this.desc, widget);
        return this;
    }

    // 挂载任意 Gui 控件及自定义的 Setter/Getter 数据通道委托
    public GridColumn<T> ControlEditorCustom(Control widget, CellValueSetter setter, CellValueGetter getter) {
        DataColumn.ControlEditorCustom(this.desc, widget, setter, getter);
        return this;
    }

    // 设置该列的自定义享元画笔（ICellRenderer 享元画笔）
    public GridColumn<T> Renderer(CellRenderer r) {
        DataColumn.Renderer(this.desc, r);
        return this;
    }

    // 设置该列挂载的声明式插槽/模板名（对齐基础组件 Slot / Template 机制）
    public GridColumn<T> Slot(string slotName) {
        DataColumn.Slot(this.desc, slotName);
        return this;
    }

    // ---- 描述符透传（修改 desc，返回 this 以便链式调用）----
    public GridColumn<T> Field(string name) { DataColumn.Field(this.desc, name); return this; }
    public GridColumn<T> Right() { this.desc.align = 2; return this; }
    public GridColumn<T> Center() { this.desc.align = 1; return this; }
    public GridColumn<T> NotSortable() { this.desc.sortable = false; return this; }
    public GridColumn<T> NotResizable() { DataColumn.NotResizable(this.desc); return this; }
    public GridColumn<T> Money(string symbol) { DataColumn.Money(this.desc, symbol); return this; }
    public GridColumn<T> Percent() { DataColumn.Percent(this.desc); return this; }
    public GridColumn<T> Grouped() { DataColumn.Grouped(this.desc); return this; }
    public GridColumn<T> Affix(string prefix, string suffix) { DataColumn.Affix(this.desc, prefix, suffix); return this; }
    public GridColumn<T> Pin() { DataColumn.Pin(this.desc); return this; }
    public GridColumn<T> PinRight() { DataColumn.PinRight(this.desc); return this; }
    public GridColumn<T> Band(string path) { DataColumn.Band(this.desc, path); return this; }
    public GridColumn<T> Sum() { DataColumn.Sum(this.desc); return this; }
    public GridColumn<T> Avg() { DataColumn.Avg(this.desc); return this; }
    public GridColumn<T> Min() { DataColumn.Min(this.desc); return this; }
    public GridColumn<T> Max() { DataColumn.Max(this.desc); return this; }
    public GridColumn<T> Count() { DataColumn.Count(this.desc); return this; }
    // 组件列（cellType 10 select/buttons / 下拉编辑器）选项，逗号分隔。
    public GridColumn<T> Options(string csv) { DataColumn.Options(this.desc, csv); return this; }
    // 组件列矩阵形状（cellType 9）/ rate 显数（cellType 10）。
    public GridColumn<T> Shape(int rows, int cols) { DataColumn.Shape(this.desc, rows, cols); return this; }

    // 引擎用于显示、排序
    // 键和导出的原始（未格式化）单元格字符串。引擎在此基础上应用列的显示格式
    // （千分位 / 前缀 / 后缀 / 日期 / bool），因此原始
    // 值保持可解析。未提供文本读取器时，则
    // 从类型化访问器推导。
    public string Raw(T row) {
        if (this.text != null) { return this.text(row); }
        if (this.nums != null) {
            // 组件列：类型化序列 → CSV。序列化边界在此，
            // 引擎与渲染层只见到与迷你图同约定的文本。
            List<int> v = this.nums(row);
            string s = "";
            if (v != null) {
                for (int i = 0; i < v.Count; i = i + 1) {
                    if (i > 0) { s = s + ","; }
                    s = s + Convert.ToString(v[i]);
                }
            }
            return s;
        }
        if (this.real != null) { return DataTable.FormatReal(this.real(row), this.desc.decimals); }
        if (this.num != null) { return Convert.ToString(this.num(row)); }
        if (this.truth != null) {
            if (this.truth(row)) { return this.desc.boolTrue; }
            return this.desc.boolFalse;
        }
        return "";
    }
}
