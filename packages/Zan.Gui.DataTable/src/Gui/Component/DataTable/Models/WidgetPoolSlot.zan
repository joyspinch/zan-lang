using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// 控件池槽位实体（消除 poolKeys / poolCtl 平行列表反模式，并将行级列定义与状态与槽位实例绑定，消除单例脏状态）。
public class WidgetPoolSlot {
    public string key;
    public Control ctl;
    public DataColumn col;
    public string lastVal;

    public WidgetPoolSlot(string key, Control ctl) {
        this.key = key != null ? key : "";
        this.ctl = ctl;
        this.col = null;
        this.lastVal = "";
    }
}
