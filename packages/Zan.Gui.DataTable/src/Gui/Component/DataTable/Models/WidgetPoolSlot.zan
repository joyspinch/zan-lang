using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// 控件池槽位实体（消除 poolKeys / poolCtl 平行列表反模式）。
public class WidgetPoolSlot {
    public string key;
    public Control ctl;

    public WidgetPoolSlot(string key, Control ctl) {
        this.key = key != null ? key : "";
        this.ctl = ctl;
    }
}
