using System;
using System.Json;

namespace Gui.Component.DataTable;

// 一个声明式聚合。mode：1 sum、2 average、3 min、4 max、5 count。
public class QueryAggregateClause {
    int column;
    int mode;
    int kind;

    // 构造聚合子句。
    QueryAggregateClause(int col, int op, int valueKind) {
        this.column = col;
        this.mode = op;
        this.kind = valueKind;
    }

    // schema 中的稳定列槽位。
    public int Column() { return this.column; }
    // 聚合模式（1 sum、2 average、3 min、4 max、5 count）。
    public int Mode() { return this.mode; }
    // 值类型 kind（与 QueryFilterClause 相同）。
    public int Kind() { return this.kind; }
}
