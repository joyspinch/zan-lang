using System;
using Gui;

namespace Gui.Component.DataTable;

// 帧级样式快照（Style Snapshot）：
// 一次性解析并缓存当前主题下 DataTable 绘制所需的全部 StyleBox，
// 避免在虚拟滚动行循环与各管道子阶段中重复触发样式表查找与字典哈希计算。
public class DataTableStyleSnapshot {
    public StyleBox surface;
    public StyleBox header;
    public StyleBox icon;
    public StyleBox iconSel;
    public StyleBox bandHdr;
    public StyleBox accent;
    public StyleBox row;
    public StyleBox rowStriped;
    public StyleBox rowHover;
    public StyleBox rowSel;
    public StyleBox groupRow;
    public StyleBox detail;
    public StyleBox hint;
    public StyleBox cellBox;
    public StyleBox grid;
    public StyleBox toast;

    public DataTableStyleSnapshot() { }

    public static DataTableStyleSnapshot Create(App app) {
        DataTableStyleSnapshot ss = new DataTableStyleSnapshot();
        ss.surface = Style.Full(app, "datatable", "", "", Style.SNormal());
        ss.header = Style.Part(app, "datatable", "header", "", "", "", Style.SNormal());
        ss.icon = Style.Part(app, "datatable", "icon", "", "", "", Style.SNormal());
        ss.iconSel = Style.Part(app, "datatable", "icon", "", "", "", Style.SSelected());
        ss.bandHdr = Style.Part(app, "datatable", "band", "", "", "", Style.SNormal());
        ss.accent = Style.Part(app, "datatable", "accent", "", "", "", Style.SNormal());
        ss.row = Style.Part(app, "datatable", "row", "", "", "", Style.SNormal());
        ss.rowStriped = Style.Part(app, "datatable", "row", "", "striped", "", Style.SNormal());
        ss.rowHover = Style.Part(app, "datatable", "row", "", "", "", Style.SHover());
        ss.rowSel = Style.Part(app, "datatable", "row", "", "", "", Style.SSelected());
        ss.groupRow = Style.Part(app, "datatable", "group-row", "", "", "", Style.SNormal());
        ss.detail = Style.Part(app, "datatable", "detail", "", "", "", Style.SNormal());
        ss.hint = Style.Part(app, "datatable", "hint", "", "", "", Style.SNormal());
        ss.cellBox = Style.Part(app, "datatable", "cell", "", "", "", Style.SNormal());
        ss.grid = Style.Part(app, "datatable", "grid", "", "", "", Style.SNormal());
        ss.toast = Style.Part(app, "datatable", "toast", "", "", "", Style.SNormal());
        return ss;
    }
}
