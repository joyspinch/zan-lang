using System;

namespace Gui.Component.DataTable;

// 查询结果中的分组元数据。rows 仍然是原始行快照，组树和小计
// 单独传递，避免为每个显示组复制整页行对象。
public class QueryGroupBucket {
    string key;
    int count;

    // 构造分组桶。
    QueryGroupBucket(string groupKey, int rowCount) {
        this.key = groupKey;
        this.count = rowCount;
    }

    // 分组组合键。
    string Key() { return this.key; }
    // 组内行数。
    int Count() { return this.count; }
}
