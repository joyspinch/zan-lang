using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// 一张筛选条件芯片。kind：0 逐列 ColFilter，1 筛选行
// 文本，2 组合筛选树，3 透视视图（常驻首张），4 透视
// 视图下“进入前”的原始逐列筛选（已烘进聚合，× 触发
// 重物化）。`col` 仅对 0/1/4 有意义。纯数据投影，
// 测试可直接断言。
public class FilterChip {
    int kind;
    int col;
    string text;

    FilterChip(int chipKind, int chipCol, string chipText) {
        this.kind = chipKind;
        this.col = chipCol;
        this.text = chipText;
    }

    static FilterChip Make(int kind, int col, string text) {
        return new FilterChip(kind, col, text);
    }

    // 芯片类别（0 逐列 / 1 筛选行 / 2 组合树 / 3 透视 / 4 原始逐列）。
    int Kind() { return this.kind; }
    // 所属列索引（kind 0/1/4），其余 -1。
    int Col() { return this.col; }
    // 显示文本。
    string Text() { return this.text; }
}
