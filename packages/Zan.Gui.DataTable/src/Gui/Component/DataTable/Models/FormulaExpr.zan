using System;

namespace Gui.Component.DataTable;

// 逆波兰 token：0 数字，1 列引用，2 +，3 -，4 *，5 /，
    // 6 一元负号，7 min，8 max，9 abs，10 round，11 floor，
    // 12 ceil，13 sqrt。
    public class FormulaExpr {
        public List<int> ops;
        public List<double> nums;
        public List<int> colIdx;
        // 变参函数的实参个数（min/max）；其余函数不使用。
        public List<int> argc;
        public bool err;

        // 编译表达式；畸形输入置 err=true（整列显示空）。
        public FormulaExpr(string src, List<DataColumn> cols) {
            this.ops = new List<int>();
            this.nums = new List<double>();
            this.colIdx = new List<int>();
            this.argc = new List<int>();
            this.err = false;
            this.Compile(src, cols);
        }

        // ---- 编译：递归下降 → 逆波兰 ----

        string src;
        int pos;
        int depth;
        List<DataColumn> cols;

        // 标记编译失败并清空已生成的全部 token。
        public void Fail() {
            this.err = true;
            this.ops.Clear();
            this.nums.Clear();
            this.colIdx.Clear();
            this.argc.Clear();
        }

        // 每个 token 在四个平行数组里各占一格：运算符的
        // nums/colIdx/argc 只是占位 0，保证 ops[i] 与其余
        // 数组同索引对齐。
        public void Emit(int op) {
            this.ops.Add(op);
            this.nums.Add(0.0);
            this.colIdx.Add(0);
            this.argc.Add(0);
        }

        // 递归下降解析入口；成功后必须恰好消费到串尾，
        // 否则视为畸形并失败。
        public void Compile(string src, List<DataColumn> cols) {
            this.src = src;
            this.pos = 0;
            this.depth = 0;
            this.cols = cols;
            this.ParseExpr();
            if (this.err) { return; }
            this.SkipWs();
            if (this.pos < this.src.Length) { this.Fail(); }
        }

        // 跳过空格与制表符。
        public void SkipWs() {
            while (this.pos < this.src.Length) {
                int c = (int)this.src[this.pos];
                if (c != 32 && c != 9) { break; }
                this.pos = this.pos + 1;
            }
        }

        // 加减层：term (('+' | '-') term)*。
        public void ParseExpr() {
            this.ParseTerm();
            while (!this.err) {
                this.SkipWs();
                if (this.pos >= this.src.Length) { break; }
                int c = (int)this.src[this.pos];
                if (c != 43 && c != 45) { break; }
                this.pos = this.pos + 1;
                this.ParseTerm();
                if (this.err) { break; }
                this.Emit(c == 43 ? 2 : 3);
            }
        }

        // 乘除层：unary (('*' | '/') unary)*。
        public void ParseTerm() {
            this.ParseUnary();
            while (!this.err) {
                this.SkipWs();
                if (this.pos >= this.src.Length) { break; }
                int c = (int)this.src[this.pos];
                if (c != 42 && c != 47) { break; }
                this.pos = this.pos + 1;
                this.ParseUnary();
                if (this.err) { break; }
                this.Emit(c == 42 ? 4 : 5);
            }
        }

        // 一元层：'-' unary | primary。
        public void ParseUnary() {
            this.SkipWs();
            if (this.pos < this.src.Length && (int)this.src[this.pos] == 45) {
                this.pos = this.pos + 1;
                this.ParseUnary();
                if (this.err) { return; }
                this.Emit(6);
                return;
            }
            this.ParsePrimary();
        }

        // 数字字面量、括号子表达式（深度上限 32）、
        // 函数调用或列引用（先 field 名，回退 title）。
        public void ParsePrimary() {
            this.SkipWs();
            if (this.pos >= this.src.Length) { this.Fail(); return; }
            int c = (int)this.src[this.pos];
            // 括号子表达式
            if (c == 40) {
                this.pos = this.pos + 1;
                if (this.depth >= 32) { this.Fail(); return; }
                this.depth = this.depth + 1;
                this.ParseExpr();
                this.depth = this.depth - 1;
                if (this.err) { return; }
                this.SkipWs();
                if (this.pos < this.src.Length && (int)this.src[this.pos] == 41) {
                    this.pos = this.pos + 1;
                    return;
                }
                this.Fail();
                return;
            }
            // 数字字面量
            if ((c >= 48 && c <= 57) || c == 46) {
                int start = this.pos;
                while (this.pos < this.src.Length) {
                    int d = (int)this.src[this.pos];
                    if (d < 48 || d > 57) { break; }
                    this.pos = this.pos + 1;
                }
                if (this.pos < this.src.Length && (int)this.src[this.pos] == 46) {
                    this.pos = this.pos + 1;
                    while (this.pos < this.src.Length) {
                        int d = (int)this.src[this.pos];
                        if (d < 48 || d > 57) { break; }
                        this.pos = this.pos + 1;
                    }
                }
                this.Emit(0);
                this.nums[this.nums.Count - 1] = DataTable.ParseReal(this.src.Substring(start, this.pos - start));
                return;
            }
            // 标识符：函数调用或列引用
            if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95) {
                int start = this.pos;
                while (this.pos < this.src.Length) {
                    int d = (int)this.src[this.pos];
                    bool alnum = (d >= 48 && d <= 57) || (d >= 65 && d <= 90) || (d >= 97 && d <= 122) || d == 95;
                    if (!alnum) { break; }
                    this.pos = this.pos + 1;
                }
                string ident = this.src.Substring(start, this.pos - start);
                int save = this.pos;
                this.SkipWs();
                if (this.pos < this.src.Length && (int)this.src[this.pos] == 40) {
                    this.pos = this.pos + 1;
                    string fn = DataTable.LowerAscii(ident);
                    this.SkipWs();
                    // 零实参调用：仅 min/max 有意义地失败，其他函数
                    // 在求值层统一检查实参个数。
                    if (this.pos < this.src.Length && (int)this.src[this.pos] == 41) {
                        this.pos = this.pos + 1;
                        this.PushFunc(fn, 0);
                        return;
                    }
                    int count = 0;
                    while (!this.err) {
                        this.ParseExpr();
                        if (this.err) { break; }
                        count = count + 1;
                        this.SkipWs();
                        if (this.pos < this.src.Length && (int)this.src[this.pos] == 44) {
                            this.pos = this.pos + 1;
                        } else {
                            if (this.pos < this.src.Length && (int)this.src[this.pos] == 41) {
                                this.pos = this.pos + 1;
                            } else { this.Fail(); }
                            break;
                        }
                    }
                    if (this.err) { return; }
                    this.PushFunc(fn, count);
                    return;
                }
                this.pos = save;
                // 列引用：先按 field 名，回退按 title。
                int ci = DataTable.Col(this.cols, ident);
                if (ci < 0) {
                    for (int k = 0; k < this.cols.Count; k = k + 1) {
                        if (this.cols[k].title == ident) { ci = k; break; }
                    }
                }
                if (ci < 0) { this.Fail(); return; }
                this.Emit(1);
                this.colIdx[this.colIdx.Count - 1] = ci;
                return;
            }
            this.Fail();
        }
        // 函数的逆波兰约定：先依次求值全部实参，然后函数 token
        // 弹出 argc 个操作数。这里把函数 token 压在实参之后输出，
        // 并记录实参个数（min/max 变参需要；固定元数函数求值层
        // 自行检查栈深）。
        public void PushFunc(string fn, int count) {
            int op = 0;
            if (fn == "min") { op = 7; }
            else if (fn == "max") { op = 8; }
            else if (fn == "abs") { op = 9; }
            else if (fn == "round") { op = 10; }
            else if (fn == "floor") { op = 11; }
            else if (fn == "ceil") { op = 12; }
            else if (fn == "sqrt") { op = 13; }
            else { this.Fail(); return; }
            // 实参个数合法性：min/max ≥1；其余恰为 1（round 可 +1）。
            if (op == 7 || op == 8) {
                if (count < 1) { this.Fail(); return; }
            } else if (op == 10) {
                if (count < 1 || count > 2) { this.Fail(); return; }
            } else {
                if (count != 1) { this.Fail(); return; }
            }
            this.Emit(op);
            this.argc[this.argc.Count - 1] = count;
        }
    }
