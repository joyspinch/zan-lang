using System;

namespace Gui.Component.DataTable;

// 查询结果中的聚合值。number 用于数值/布尔聚合，text 保存文本
// min/max 的规范值；count 由 mode=5 表示。
public class QueryAggregateValue {
    int column;
    int mode;
    int kind;
    string text;
    double number;

    // 构造聚合值；text 为 null 记空串。
    QueryAggregateValue(int col, int op, int valueKind, string valueText,
                        double valueNumber) {
        this.column = col;
        this.mode = op;
        this.kind = valueKind;
        this.text = valueText;
        if (this.text == null) { this.text = ""; }
        this.number = valueNumber;
    }

    // 聚合目标列索引。
    int Column() { return this.column; }
    // 聚合模式（1 sum、2 average、3 min、4 max、5 count）。
    int Mode() { return this.mode; }
    // 值类型 kind（与 QueryFilterClause 相同）。
    int Kind() { return this.kind; }
    // 文本 min/max 的规范值；数值聚合为空串。
    string Text() { return this.text; }
    // 数值/布尔聚合结果；count 模式下为行数。
    double Number() { return this.number; }
}
