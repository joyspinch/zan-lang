using System;
using System.Json;

namespace Gui.Component.DataTable;

// 批应用结果的计数快照。调用方据此更新状态栏或写日志；
// 同键 upsert 的"更新"与"追加"在 `updated`/`inserted` 中区分。
public class DeltaResult {
    public int inserted;
    public int updated;
    public int removed;
    public int cells;
    public int missing;

    // 构造全零计数的结果。
    public static DeltaResult Create() {
        return new DeltaResult();
    }

    // 追加的新行数。
    public int Inserted() { return this.inserted; }
    // 按键覆盖的既有行数。
    public int Updated() { return this.updated; }
    // 移除的行数。
    public int Removed() { return this.removed; }
    // 应用的单列修订数。
    public int Cells() { return this.cells; }
    // 键存在但操作未生效的条数（例如 cell 指向未知 Field）。
    public int Missing() { return this.missing; }
}
