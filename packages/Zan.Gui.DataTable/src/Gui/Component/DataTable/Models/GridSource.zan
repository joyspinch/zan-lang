using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// 将 `List<T>` 及各列访问器适配为引擎的 `DataSource`，
// 使强大的 DataTable 引擎（排序 / 筛选 / 分组 / 聚合 / 编辑 /
// 虚拟化）能原样作用于调用方自己的对象。不复制任何数据：
// 每帧都从活动列表读取单元格。
public class GridSource<T> : DataSource {
    public List<T> data;
    public List<GridColumn<T>> cols;
    // 空白行实体工厂；null 使数据源保持只读。
    public GridNew<T> factory;
    // 领域实体的稳定键读取器；null 时回退到临时位置键。
    public GridKey<T> key;


    public override int RowCount() {
        if (this.data == null) { return 0; }
        return this.data.Count;
    }

    // 行号在当前这份数据里有效。引擎按上一次重算出来的行号集合
    // （`st.order`）取单元格，绑定的列表在那之后缩短过的话行号就会越界；
    // 读单元格是每帧的事，越界一次就是整个程序退出，所以这里按列一样挡住。
    public bool Row(int row) {
        if (this.data == null) { return false; }
        return row >= 0 && row < this.data.Count;
    }

    public override string CellText(int row, int col) {
        if (col < 0 || col >= this.cols.Count) { return ""; }
        if (!this.Row(row)) { return ""; }
        return this.cols[col].Raw(this.data[row]);
    }

    public override RowKey GetRowKey(int row) {
        if (!this.Row(row)) { return null; }
        if (this.key != null) { return this.key(this.data[row]); }
        return RowKey.Legacy(row);
    }

    public override int CellNum(int row, int col) {
        if (col < 0 || col >= this.cols.Count || !this.Row(row)) { return 0; }
        GridColumn<T> gc = this.cols[col];
        if (gc.num != null) { return gc.num(this.data[row]); }
        return DataTable.ParseInt(this.CellText(row, col));
    }

    public override double CellReal(int row, int col) {
        if (col < 0 || col >= this.cols.Count || !this.Row(row)) { return 0.0; }
        GridColumn<T> gc = this.cols[col];
        if (gc.real != null) { return gc.real(this.data[row]); }
        return DataTable.ParseReal(this.CellText(row, col));
    }

    public override bool CellBool(int row, int col) {
        if (col < 0 || col >= this.cols.Count || !this.Row(row)) { return false; }
        GridColumn<T> gc = this.cols[col];
        if (gc.truth != null) { return gc.truth(this.data[row]); }
        return DataTable.ParseBool(this.CellText(row, col));
    }

    public override void SetCell(int row, int col, string v) {
        if (col < 0 || col >= this.cols.Count) { return; }
        if (!this.Row(row)) { return; }
        GridColumn<T> gc = this.cols[col];
        if (gc.setter != null) { gc.setter(this.data[row], v); }
    }

    // 含回写访问器的列使网格可编辑；
    // 没有此类列的源保持只读。行插入/删除由
    // `DataGrid.RowFactory` 开启，它提供泛型前端无法
    // 合成的空白实体构造函数。
    public override bool CanInsert() { return this.factory != null; }

    public override bool InsertRow(int at) {
        if (this.factory == null) { return false; }
        if (at < 0 || at > this.data.Count) { return false; }
        this.data.Insert(at, this.factory());
        return true;
    }

    public override bool RemoveRow(int at) {
        if (at < 0 || at >= this.data.Count) { return false; }
        this.data.RemoveAt(at);
        return true;
    }
}
