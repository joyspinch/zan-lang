using System.Json;
using System;

namespace Gui.Component.DataTable;

// 一批实时增量。批是应用/传输的最小单元：同批内后面的 op
// 可以覆盖前面的（同键 upsert 两次 = 一次最终态），应用方
// 只在整批成功后触发一次刷新。
public class DeltaBatch {
    public static const int FormatVersion = 1;

    public int version;
    public List<DeltaOp> ops;

    // 构造空批，版本固定为 FormatVersion。
    public DeltaBatch() {
        this.version = DeltaBatch.FormatVersion;
        this.ops = new List<DeltaOp>();
    }

    // 创建空批。
    public static DeltaBatch Create() {
        return new DeltaBatch();
    }

    // 追加一个 op 的瘦身拷贝；null 忽略。
    public void Add(DeltaOp op) {
        if (op != null) { this.ops.Add(op.Copy()); }
    }

    // 批内 op 数。
    public int Count() { return this.ops.Count; }
    // 第 i 个 op。
    public DeltaOp At(int i) { return this.ops[i]; }
    // 批格式版本。
    public int Version() { return this.version; }

    // 同键去重合并：保留每个 (键, 种类, cell 的列) 组合中最后一次
    // 出现的 op。批次典型规模是几十条，O(n²) 保序线性扫描足够。
    public void Compress() {
        List<DeltaOp> kept = new List<DeltaOp>();
        for (int i = 0; i < this.ops.Count; i = i + 1) {
            DeltaOp op = this.ops[i];
            int k = op.Kind();
            for (int j = kept.Count - 1; j >= 0; j = j - 1) {
                DeltaOp prior = kept[j];
                if (prior.Key() != op.Key()) { continue; }
                if (k == DeltaOp.Remove || k == DeltaOp.Upsert) {
                    kept.RemoveAt(j);
                } else if (k == DeltaOp.Cell && prior.Kind() == DeltaOp.Cell
                    && prior.Field() == op.Field()) {
                    kept.RemoveAt(j);
                }
            }
            kept.Add(op);
        }
        this.ops = kept;
    }

    // 批的 JSON 形式（ver/ops 数组）。
    public JsonValue ToJsonValue() {
        JsonValue root = JsonValue.NewObject();
        root.Put("ver", JsonValue.NewNum(Convert.ToString(this.version)));
        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < this.ops.Count; i = i + 1) {
            arr.Append(this.ops[i].ToJsonValue());
        }
        root.Put("ops", arr);
        return root;
    }

    // ToJsonValue 的序列化文本。
    public string ToJson() { return this.ToJsonValue().ToJson(); }

    // 解析一批；文本为空、结构不是对象、版本未知或任何一条 op
    // 非法时返回 null——部分应用的批次会造成幽灵行，宁缺毋滥。
    public static DeltaBatch FromJson(string text) {
        if (text == null || text.Length == 0) { return null; }
        JsonDoc doc = null;
        try {
            doc = JsonDoc.Parse(text);
        } catch (Exception ex) {
            return null;
        }
        if (doc == null || doc.KindAt(doc.root) != 5) { return null; }
        int verSlot = doc.Get(doc.root, "ver");
        int opsSlot = doc.Get(doc.root, "ops");
        if (verSlot < 0 || opsSlot < 0) { return null; }
        if (doc.IntAt(verSlot, 0) != DeltaBatch.FormatVersion) { return null; }
        if (doc.KindAt(opsSlot) != 4) { return null; }
        int count = doc.Count(opsSlot);
        DeltaBatch batch = new DeltaBatch();
        int opSlot = doc.FirstChild(opsSlot);
        for (int i = 0; i < count; i = i + 1) {
            DeltaOp op = DeltaOp.FromJsonDoc(doc, opSlot);
            if (op == null) { return null; }
            batch.ops.Add(op);
            opSlot = doc.NextSibling(opSlot);
        }
        return batch;
    }
}

// 一条实时增量操作。`kind`：0 upsert（按键整行写入或更新）、
// 1 remove（按键移除）、2 cell（按键修订单列的值）。
// 所有操作都以稳定 RowKey 的 canonical 文本为行身份——没有键的行
// 无法参与实时合并，调用方必须先为源配置键（KeyProvider 或源的
// GetRowKey）。upsert 的整行值放在 `cells`（与列列表按索引对齐）；
// cell 操作只写 `field`（列的稳定 Field 名）和 `value`。
public class DeltaOp {
    // 0：按键整行写入或更新。
    public static const int Upsert = 0;
    // 1：按键移除。
    public static const int Remove = 1;
    // 2：按键修订单列。
    public static const int Cell = 2;

    public int kind;
    public string key;
    public int revision;
    public List<string> cells;
    public string field;
    public string value;

    // 内部构造：cells 为空列表，field/value 为空串，key 为 null 记空串。
    public DeltaOp(int opKind, string rowKey, int rev) {
        this.kind = opKind;
        this.key = rowKey;
        if (this.key == null) { this.key = ""; }
        this.revision = rev;
        this.cells = new List<string>();
        this.field = "";
        this.value = "";
    }

    // 构造按键整行写入（已存在的键被覆盖，缺失的键追加）。
    public static DeltaOp UpsertRow(string rowKey, List<string> values, int rev) {
        DeltaOp op = new DeltaOp(DeltaOp.Upsert, rowKey, rev);
        if (values != null) {
            for (int i = 0; i < values.Count; i = i + 1) {
                string v = values[i];
                op.cells.Add(v == null ? "" : v);
            }
        }
        return op;
    }

    // 构造按键移除。键不存在时为幂等空操作。
    public static DeltaOp RemoveRow(string rowKey, int rev) {
        return new DeltaOp(DeltaOp.Remove, rowKey, rev);
    }

    // 构造按键修订单列。列用稳定 Field 名寻址，
    // 与列的重排/插入无关。
    public static DeltaOp SetCell(string rowKey, string fieldName, string cellValue, int rev) {
        DeltaOp op = new DeltaOp(DeltaOp.Cell, rowKey, rev);
        op.field = fieldName;
        if (op.field == null) { op.field = ""; }
        op.value = cellValue;
        if (op.value == null) { op.value = ""; }
        return op;
    }

    // 操作种类（Upsert/Remove/Cell）。
    public int Kind() { return this.kind; }
    // 行身份的 canonical 文本。
    public string Key() { return this.key; }
    // 构造时携带的行 revision。
    public int Revision() { return this.revision; }
    // cell 操作的列 Field 名；其他操作为空串。
    public string Field() { return this.field; }
    // cell 操作的新值；其他操作为空串。
    public string Value() { return this.value; }
    // upsert 的整行值（与列索引对齐）；其他操作为空列表。
    public List<string> Cells() { return this.cells; }

    // 一个 op 的瘦身拷贝：加入批后，调用方对原 cells 列表的
    // 后续修改不会影响批内已保存的值。
    public DeltaOp Copy() {
        DeltaOp op = new DeltaOp(this.kind, this.key, this.revision);
        for (int i = 0; i < this.cells.Count; i = i + 1) {
            op.cells.Add(this.cells[i]);
        }
        op.field = this.field;
        op.value = this.value;
        return op;
    }

    // op 的 JSON 形式：op/key/rev 恒有，upsert 带 cells 数组，
    // cell 带 field/value。
    public JsonValue ToJsonValue() {
        JsonValue root = JsonValue.NewObject();
        root.Put("op", JsonValue.NewNum(Convert.ToString(this.kind)));
        root.Put("key", JsonValue.NewStr(this.key));
        root.Put("rev", JsonValue.NewNum(Convert.ToString(this.revision)));
        if (this.kind == DeltaOp.Upsert) {
            JsonValue arr = JsonValue.NewArray();
            for (int i = 0; i < this.cells.Count; i = i + 1) {
                arr.Append(JsonValue.NewStr(this.cells[i]));
            }
            root.Put("cells", arr);
        } else if (this.kind == DeltaOp.Cell) {
            root.Put("field", JsonValue.NewStr(this.field));
            root.Put("value", JsonValue.NewStr(this.value));
        }
        return root;
    }

    // 从 JsonDoc 槽位解析单条 op；结构不完整或 kind 未知时返回 null。
    public static DeltaOp FromJsonDoc(JsonDoc doc, int slot) {
        if (doc == null || slot < 0 || doc.KindAt(slot) != 5) { return null; }
        int opSlot = doc.Get(slot, "op");
        int keySlot = doc.Get(slot, "key");
        if (opSlot < 0 || keySlot < 0) { return null; }
        int kind = doc.IntAt(opSlot, -1);
        if (kind != DeltaOp.Upsert && kind != DeltaOp.Remove
            && kind != DeltaOp.Cell) { return null; }
        string key = doc.StrAt(keySlot, "");
        if (key.Length == 0) { return null; }
        int revSlot = doc.Get(slot, "rev");
        int rev = revSlot >= 0 ? doc.IntAt(revSlot, 0) : 0;
        DeltaOp op = new DeltaOp(kind, key, rev);
        if (kind == DeltaOp.Upsert) {
            int cellsSlot = doc.Get(slot, "cells");
            if (cellsSlot >= 0 && doc.KindAt(cellsSlot) == 4) {
                int cCount = doc.Count(cellsSlot);
                int cSlot = doc.FirstChild(cellsSlot);
                for (int i = 0; i < cCount; i = i + 1) {
                    op.cells.Add(doc.StrAt(cSlot, ""));
                    cSlot = doc.NextSibling(cSlot);
                }
            }
        } else if (kind == DeltaOp.Cell) {
            int fieldSlot = doc.Get(slot, "field");
            if (fieldSlot >= 0) { op.field = doc.StrAt(fieldSlot, ""); }
            int valSlot = doc.Get(slot, "value");
            if (valSlot >= 0) { op.value = doc.StrAt(valSlot, ""); }
        }
        return op;
    }

    // 解析单条 op；结构不完整或 kind 未知时返回 null。
    public static DeltaOp FromJsonValue(JsonValue node) {
        if (node == null || !node.IsObject()) { return null; }
        if (!node.Has("op") || !node.Has("key")) { return null; }
        int kind = node.Int("op", -1);
        if (kind != DeltaOp.Upsert && kind != DeltaOp.Remove
            && kind != DeltaOp.Cell) { return null; }
        string key = node.Str("key", "");
        if (key.Length == 0) { return null; }
        int rev = node.Int("rev", 0);
        DeltaOp op = new DeltaOp(kind, key, rev);
        if (kind == DeltaOp.Upsert) {
            JsonValue arr = node.Get("cells");
            if (arr != null && arr.IsArray()) {
                for (int i = 0; i < arr.Count(); i = i + 1) {
                    op.cells.Add(arr.At(i).AsString(""));
                }
            }
        } else if (kind == DeltaOp.Cell) {
            op.field = node.Str("field", "");
            op.value = node.Str("value", "");
        }
        return op;
    }
}

// 批应用结果的计数快照。调用方据此更新状态栏或写日志；
// 同键 upsert 的"更新"与"追加"在 `updated`/`inserted` 中区分。
public class DeltaResult {
    public int inserted;
    public int updated;
    public int removed;
    public int cells;
    public int missing;

    // 构造全零计数的结果。
    public static DeltaResult Create() {
        return new DeltaResult();
    }

    // 追加的新行数。
    public int Inserted() { return this.inserted; }
    // 按键覆盖的既有行数。
    public int Updated() { return this.updated; }
    // 移除的行数。
    public int Removed() { return this.removed; }
    // 应用的单列修订数。
    public int Cells() { return this.cells; }
    // 键存在但操作未生效的条数（例如 cell 指向未知 Field）。
    public int Missing() { return this.missing; }
}

// 单个 mutation 的服务端结果。
public class MutationResult {
    // 1 接受、2 拒绝、3 冲突、4 取消。
    static const int Accepted = 1;
    static const int Rejected = 2;
    static const int Conflict = 3;
    static const int Cancelled = 4;

    string mutationId;
    int status;
    string canonicalValue;
    string serverValue;
    int serverRevision;
    string message;

    // 构造结果；各文本字段为 null 时记为空串。
    MutationResult(string id, int resultStatus, string canonical,
                   string server, int revision, string detail) {
        this.mutationId = id;
        this.status = resultStatus;
        this.canonicalValue = canonical;
        this.serverValue = server;
        this.serverRevision = revision;
        this.message = detail;
        if (this.mutationId == null) { this.mutationId = ""; }
        if (this.canonicalValue == null) { this.canonicalValue = ""; }
        if (this.serverValue == null) { this.serverValue = ""; }
        if (this.message == null) { this.message = ""; }
    }

    // 接受：canonical 为规范化后的新值，revision 为服务端行 revision。
    public static MutationResult AcceptedValue(string id, string value, int revision) {
        return new MutationResult(id, MutationResult.Accepted, value, "", revision, "");
    }
    // 拒绝：detail 说明原因，serverRevision 为 -1。
    public static MutationResult RejectedValue(string id, string detail) {
        return new MutationResult(id, MutationResult.Rejected, "", "", -1, detail);
    }
    // 冲突：server/serverRevision 为服务端当前值与行 revision。
    public static MutationResult ConflictValue(string id, string server, int revision,
                                        string detail) {
        return new MutationResult(id, MutationResult.Conflict, "", server, revision, detail);
    }
    // 取消：detail 说明原因，serverRevision 为 -1。
    public static MutationResult CancelledValue(string id, string detail) {
        return new MutationResult(id, MutationResult.Cancelled, "", "", -1, detail);
    }

    // 对应的 mutation 标识。
    string MutationId() { return this.mutationId; }
    // 结果状态（Accepted/Rejected/Conflict/Cancelled）。
    int Status() { return this.status; }
    // 接受时的规范化新值；其它状态为空串。
    string CanonicalValue() { return this.canonicalValue; }
    // 冲突时的服务端当前值；其它状态为空串。
    string ServerValue() { return this.serverValue; }
    // 服务端行 revision；拒绝/取消时为 -1。
    int ServerRevision() { return this.serverRevision; }
    // 失败/冲突说明文本。
    string Message() { return this.message; }

    // id 非空且状态为四个合法值之一时为 true。
    public bool IsValid() {
        return this.mutationId.Length > 0
            && (this.status == MutationResult.Accepted
                || this.status == MutationResult.Rejected
                || this.status == MutationResult.Conflict
                || this.status == MutationResult.Cancelled);
    }

    // 单个结果的传输 JSON 节点（id/status/canonical/server/revision/message）。
    public JsonValue ToJsonValue() {
        JsonValue root = JsonValue.NewObject();
        root.Put("id", JsonValue.NewStr(this.mutationId));
        root.Put("status", JsonValue.NewNum(Convert.ToString(this.status)));
        root.Put("canonical", JsonValue.NewStr(this.canonicalValue));
        root.Put("server", JsonValue.NewStr(this.serverValue));
        root.Put("revision", JsonValue.NewNum(Convert.ToString(this.serverRevision)));
        root.Put("message", JsonValue.NewStr(this.message));
        return root;
    }

    // 单个结果的传输 JSON（id/status/canonical/server/revision/message）。
    public string ToJson() {
        return this.ToJsonValue().ToJson();
    }
}

// 一次远程单元格修改的不可变描述。业务身份使用 RowKey，
// expectedRevision 用于服务端乐观并发校验。
public class TableMutation {
    string mutationId;
    RowKey rowKey;
    int column;
    int expectedRevision;
    string value;

    // 构造 mutation；id/value 为 null 时记为空串。
    TableMutation(string id, RowKey key, int col, int revision, string nextValue) {
        this.mutationId = id;
        this.rowKey = key;
        this.column = col;
        this.expectedRevision = revision;
        this.value = nextValue;
        if (this.mutationId == null) { this.mutationId = ""; }
        if (this.value == null) { this.value = ""; }
    }

    // 构造一个单元格修改；revision 为提交时客户端已知的行 revision。
    public static TableMutation Cell(string id, RowKey key, int col,
                              int revision, string nextValue) {
        return new TableMutation(id, key, col, revision, nextValue);
    }

    // 事务内唯一的 mutation 标识。
    string MutationId() { return this.mutationId; }
    // 目标行业务身份。
    RowKey Key() { return this.rowKey; }
    // 目标列索引。
    int Column() { return this.column; }
    // 乐观并发校验的期望行 revision；服务端值不一致即冲突。
    int ExpectedRevision() { return this.expectedRevision; }
    // 新单元格文本。
    string Value() { return this.value; }

    // id 非空、rowKey 存在、列索引与期望 revision 均非负时为 true。
    public bool IsValid() {
        return this.mutationId.Length > 0 && this.rowKey != null
            && this.column >= 0 && this.expectedRevision >= 0;
    }

    // 序列化为传输 JsonValue（id/key/col/rev/value）；rowKey 为 null 时 key 记空串。
    public JsonValue ToJsonValue() {
        JsonValue root = JsonValue.NewObject();
        root.Put("id", JsonValue.NewStr(this.mutationId));
        root.Put("key", JsonValue.NewStr(this.rowKey == null ? "" : this.rowKey.Canonical()));
        root.Put("col", JsonValue.NewNum(Convert.ToString(this.column)));
        root.Put("rev", JsonValue.NewNum(Convert.ToString(this.expectedRevision)));
        root.Put("value", JsonValue.NewStr(this.value));
        return root;
    }

    // 序列化为传输 JSON 文本。
    public string ToJson() {
        return this.ToJsonValue().ToJson();
    }
}

// 事务提交策略。
public class TransactionMode {
    // 全部成功才提交，任一失败整体拒绝。
    static const int AllOrNothing = 1;
    // 尽力而为：允许部分 mutation 被拒绝，其余照常生效。
    static const int BestEffort = 2;
}

// 一次事务提交的独立请求身份。它不复用 QueryRequestToken，
// 因而 cell mutation 不会被误判为分页结果。
public class TransactionRequestToken {
    int requestId;
    string transactionId;
    int generation;
    int schemaVersion;
    int serverRevision;
    bool cancelled;

    // 构造请求身份；txId 为 null 记空串，cancelled 初始为 false。
    TransactionRequestToken(int id, string txId, int gen, int schema, int server) {
        this.requestId = id;
        this.transactionId = txId;
        if (this.transactionId == null) { this.transactionId = ""; }
        this.generation = gen;
        this.schemaVersion = schema;
        this.serverRevision = server;
        this.cancelled = false;
    }

    // 单调递增的请求序号。
    int RequestId() { return this.requestId; }
    // 提交的事务标识。
    string TransactionId() { return this.transactionId; }
    // 创建时的源 generation。
    int Generation() { return this.generation; }
    // 创建时的 schema 版本。
    int SchemaVersion() { return this.schemaVersion; }
    // 创建时的服务端 revision。
    int ServerRevision() { return this.serverRevision; }
    // token 是否已被取消。
    bool IsCancelled() { return this.cancelled; }
    // 取消该 token；不改变身份。
    void Cancel() { this.cancelled = true; }

    // 五个身份字段全部相等才视为同一次提交；other 为 null 返回 false。
    public bool SameIdentity(TransactionRequestToken other) {
        if (other == null) { return false; }
        return this.requestId == other.RequestId()
            && this.transactionId == other.TransactionId()
            && this.generation == other.Generation()
            && this.schemaVersion == other.SchemaVersion()
            && this.serverRevision == other.ServerRevision();
    }
}

// 事务生命周期：Draft -> Validating -> Pending -> Acked，
// 失败分支为 Rejected/Conflict/Cancelled。
public class TransactionState {
    // 草稿：仍可追加 mutation。
    static const int Draft = 1;
    // 本地校验中：不再接受修改。
    static const int Validating = 2;
    // 已提交，等待服务端结果。
    static const int Pending = 3;
    // 服务端确认全部生效。
    static const int Acked = 4;
    // 服务端拒绝。
    static const int Rejected = 5;
    // 乐观并发冲突。
    static const int Conflict = 6;
    // 提交前或等待中被取消。
    static const int Cancelled = 7;
}

// 一次事务的不可变结果快照。结果列表通过 Add 只在构造阶段填充，
// 读取时使用 ResultAt 的复制值，避免调用方修改内部对象。
public class TableTransactionResult {
    // 1 确认、2 拒绝、3 冲突、4 取消。
    static const int Acked = 1;
    static const int Rejected = 2;
    static const int Conflict = 3;
    static const int Cancelled = 4;

    string transactionId;
    int status;
    List<MutationResult> results;

    // 构造结果快照；id 为 null 记空串，results 由 Add 填充。
    TableTransactionResult(string id, int resultStatus) {
        this.transactionId = id;
        this.status = resultStatus;
        if (this.transactionId == null) { this.transactionId = ""; }
        this.results = new List<MutationResult>();
    }

    // 创建指定状态的结果快照。
    public static TableTransactionResult Create(string id, int resultStatus) {
        return new TableTransactionResult(id, resultStatus);
    }

    // 事务标识。
    string TransactionId() { return this.transactionId; }
    // 事务级状态（Acked/Rejected/Conflict/Cancelled）。
    int Status() { return this.status; }
    // 单个结果条数。
    int Count() { return this.results.Count; }

    // 结果可采信：id 非空、状态合法且至少包含一条结果。
    public bool IsValid() {
        return this.transactionId.Length > 0
            && (this.status == TableTransactionResult.Acked
                || this.status == TableTransactionResult.Rejected
                || this.status == TableTransactionResult.Conflict
                || this.status == TableTransactionResult.Cancelled)
            && this.results.Count > 0;
    }

    // 构造阶段追加一条结果；null 被忽略并返回 false。
    public bool Add(MutationResult result) {
        if (result == null) { return false; }
        this.results.Add(result);
        return true;
    }

    // 第 index 个结果的复制值；越界返回 null。
    public MutationResult ResultAt(int index) {
        if (index < 0 || index >= this.results.Count) { return null; }
        MutationResult r = this.results[index];
        return new MutationResult(r.MutationId(), r.Status(), r.CanonicalValue(),
            r.ServerValue(), r.ServerRevision(), r.Message());
    }

    // 状态为 Accepted 的结果条数。
    public int AcceptedCount() {
        int count = 0;
        for (int i = 0; i < this.results.Count; i = i + 1) {
            if (this.results[i].Status() == MutationResult.Accepted) { count = count + 1; }
        }
        return count;
    }

    // 非 Accepted 的结果条数（含取消）。
    int FailedCount() { return this.results.Count - this.AcceptedCount(); }

    // 深复制：状态与全部结果逐条复制，内部列表与原对象独立。
    public TableTransactionResult Copy() {
        TableTransactionResult copy = TableTransactionResult.Create(
            this.transactionId, this.status);
        for (int i = 0; i < this.results.Count; i = i + 1) {
            MutationResult result = this.results[i];
            copy.Add(new MutationResult(result.MutationId(), result.Status(),
                result.CanonicalValue(), result.ServerValue(),
                result.ServerRevision(), result.Message()));
        }
        return copy;
    }

    // 序列化为传输 JSON 节点：事务 id/status 加逐条结果的 JSON 对象数组。
    public JsonValue ToJsonValue() {
        JsonValue root = JsonValue.NewObject();
        root.Put("ver", JsonValue.NewNum("1"));
        root.Put("id", JsonValue.NewStr(this.transactionId));
        root.Put("status", JsonValue.NewNum(Convert.ToString(this.status)));
        JsonValue values = JsonValue.NewArray();
        for (int i = 0; i < this.results.Count; i = i + 1) {
            MutationResult res = this.results[i];
            if (res != null) { values.Append(res.ToJsonValue()); }
        }
        root.Put("results", values);
        return root;
    }

    // 序列化为传输 JSON：事务 id/status 加逐条结果的 JSON 对象数组。
    public string ToJson() {
        return this.ToJsonValue().ToJson();
    }
}

// DataTable 的非致命结构诊断。诊断不改变旧 API 的返回值，
// 供宿主在开发/遥测模式下显示重复键、过期结果和能力不匹配。
public class TableDiagnostic {
    int code;
    string message;
    string field;
    int row;

    // 内部构造；经各 *Diagnostic 工厂创建。
    TableDiagnostic(int c, string msg, string f, int r) {
        this.code = c;
        this.message = msg;
        this.field = f;
        this.row = r;
    }

    // 诊断代码：1 重复键，2 缺少稳定键，3 过期结果，4 schema 不匹配。
    int Code() { return this.code; }
    // 人类可读的诊断消息。
    string Message() { return this.message; }
    // 相关列的 field 名；与列无关的诊断为空串。
    string Field() { return this.field; }
    // 相关数据行索引；schema 类诊断为 -1，
    // 过期结果诊断在此字段携带 generation。
    int Row() { return this.row; }
}
