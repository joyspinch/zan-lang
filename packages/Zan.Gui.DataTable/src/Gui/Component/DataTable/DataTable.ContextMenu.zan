using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Component.DataTable;

// 业务右键菜单项定义（对标 AG Grid getContextMenuItems / DevExpress PopupMenu）
public class TableContextMenuItem {
    string label;
    string icon;
    string shortcut;
    bool disabled;
    bool danger;
    Action<DataTableState, DataSource, int, int> onClick; // 回调签名: (st, src, row, col)

    TableContextMenuItem(string label, string icon, Action<DataTableState, DataSource, int, int> onClick) {
        this.label = label;
        this.icon = icon;
        this.shortcut = "";
        this.disabled = false;
        this.danger = false;
        this.onClick = onClick;
    }

    public static TableContextMenuItem Item(string label, string icon, Action<DataTableState, DataSource, int, int> onClick) {
        return new TableContextMenuItem(label, icon, onClick);
    }

    public static TableContextMenuItem Danger(string label, string icon, Action<DataTableState, DataSource, int, int> onClick) {
        TableContextMenuItem m = new TableContextMenuItem(label, icon, onClick);
        m.danger = true;
        return m;
    }
}

// 上下文菜单构建委托：(st, cols, src, row, col) => 业务追加的菜单项
public delegate List<TableContextMenuItem> ContextMenuFunc(DataTableState st, List<DataColumn> cols, DataSource src, int row, int col);

public partial class DataTable {
    // 注册自定义行右键菜单提供委托
    public static void SetContextMenuFunc(DataTableState st, ContextMenuFunc fn) {
        st.contextMenuFunc = fn;
    }

    public static ContextMenuFunc GetContextMenuFunc(DataTableState st) {
        return st.contextMenuFunc;
    }
}
