using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// 树模式适配器：把任意层级结构投影成"每行有若干子行"
// 的形状，网格据此交错显示。行身份仍是源行索引（与
// 排序/筛选/选择的读取路径一致）；适配器只回答结构问题。
// 继承它并重写 RootCount / ChildCount / ChildOf：
// - `RootCount` 返回顶层行数，`RootAt(i)` 返回第 i 个
// 顶层行的源索引。默认实现遍历源，把无父行（`ParentOf`
// 返回 -1）当根；按需重写成直接索引。
// - `ChildCount(src, row)` 返回该行的子行数（0 = 叶子）；
// `ChildOf(src, row, index)` 返回第 index 个子行的源索引。
// - 可选重写 `ParentOf`（默认 -1）：无重写时根 = 全部行
// 中 ParentOf < 0 者，需要 O(n) 扫描；重写后 RootAt 走
// RootCount 直接索引。
public class TreeAdapter {
    // 顶层行数。
    virtual int RootCount(DataSource src) {
        int n = 0;
        if (src == null) { return 0; }
        for (int row = 0; row < src.RowCount(); row = row + 1) {
            if (this.ParentOf(src, row) < 0) { n = n + 1; }
        }
        return n;
    }

    // 第 i 个顶层行的源索引。默认实现再次扫描源，
    // 与 RootCount 的判定保持一致。
    virtual int RootAt(DataSource src, int i) {
        if (src == null) { return -1; }
        int seen = 0;
        for (int row = 0; row < src.RowCount(); row = row + 1) {
            if (this.ParentOf(src, row) < 0) {
                if (seen == i) { return row; }
                seen = seen + 1;
            }
        }
        return -1;
    }

    // `row` 的子行数；0 = 叶子。
    virtual int ChildCount(DataSource src, int row) { return 0; }

    // `row` 的第 `index` 个子行的源索引；越界返回 -1。
    virtual int ChildOf(DataSource src, int row, int index) { return -1; }

    // `row` 的父行源索引；顶层行返回 -1。仅默认
    // RootCount/RootAt 的"无父即根"判定使用它。
    virtual int ParentOf(DataSource src, int row) { return -1; }

    // ---- 懒加载（VTable 树形懒加载的同类项） ----
    // 三个虚方法构成异步展开契约：IsLazy 声明该行的子行
    // 需要按需取回；ChildrenLoaded 回答是否已取回；网格在
    // 用户展开未取回的行时置 loading 标记并调用 LoadChildren，
    // 应用取回子行（把行插入数据源）后调用
    // DataTable.TreeLoaded(st, src, row) 收尾——加载中的行
    // 在树列上显示 spinner 占位，子行到位后下一帧自然长出。
    // `row` 的子行是否需要按需（异步）取回。默认 false =
    // 子行已在数据源里，展开即得。
    virtual bool IsLazy(DataSource src, int row) { return false; }

    // 懒加载行的子行是否已取回。仅 IsLazy 行会被询问；
    // 未取回的行展开时触发 LoadChildren。
    virtual bool ChildrenLoaded(DataSource src, int row) { return true; }

    // 开始异步取回 `row` 的子行。实现应尽快把取到的子行
    // 插入数据源，然后调用 DataTable.TreeLoaded(st, src, row)。
    // 网格不等待：加载期间该行显示 spinner。
    virtual void LoadChildren(DataSource src, int row) { }

    // ---- 树形递归 Rollup 聚合计算（对标 AG Grid / DevExpress TreeList 聚合汇总） ----
    // aggMode: 0 = Sum, 1 = Avg, 2 = Min, 3 = Max, 4 = Count
    public virtual double Rollup(DataSource src, int row, int col, int aggMode) {
        if (src == null || row < 0) { return 0.0; }
        int nKids = this.ChildCount(src, row);
        if (nKids == 0) {
            if (aggMode == 4) { return 1.0; }
            return src.CellReal(row, col);
        }

        if (aggMode == 4) {
            double totalLeaves = 0.0;
            for (int i = 0; i < nKids; i = i + 1) {
                int kid = this.ChildOf(src, row, i);
                if (kid >= 0) {
                    totalLeaves = totalLeaves + this.Rollup(src, kid, col, 4);
                }
            }
            return totalLeaves;
        }

        if (aggMode == 0) {
            double sum = 0.0;
            for (int i = 0; i < nKids; i = i + 1) {
                int kid = this.ChildOf(src, row, i);
                if (kid >= 0) {
                    sum = sum + this.Rollup(src, kid, col, 0);
                }
            }
            return sum;
        }

        if (aggMode == 1) {
            double totalVal = this.Rollup(src, row, col, 0);
            double leafCount = this.Rollup(src, row, col, 4);
            if (leafCount > 0.0) {
                return totalVal / leafCount;
            }
            return 0.0;
        }

        if (aggMode == 2) {
            double minVal = 0.0;
            bool hasVal = false;
            for (int i = 0; i < nKids; i = i + 1) {
                int kid = this.ChildOf(src, row, i);
                if (kid >= 0) {
                    double v = this.Rollup(src, kid, col, 2);
                    if (!hasVal || v < minVal) {
                        minVal = v;
                        hasVal = true;
                    }
                }
            }
            return minVal;
        }

        if (aggMode == 3) {
            double maxVal = 0.0;
            bool hasVal = false;
            for (int i = 0; i < nKids; i = i + 1) {
                int kid = this.ChildOf(src, row, i);
                if (kid >= 0) {
                    double v = this.Rollup(src, kid, col, 3);
                    if (!hasVal || v > maxVal) {
                        maxVal = v;
                        hasVal = true;
                    }
                }
            }
            return maxVal;
        }

        return 0.0;
    }

    public double RollupSum(DataSource src, int row, int col) { return this.Rollup(src, row, col, 0); }
    public double RollupAvg(DataSource src, int row, int col) { return this.Rollup(src, row, col, 1); }
    public double RollupMin(DataSource src, int row, int col) { return this.Rollup(src, row, col, 2); }
    public double RollupMax(DataSource src, int row, int col) { return this.Rollup(src, row, col, 3); }
    public int RollupCount(DataSource src, int row) { return (int)this.Rollup(src, row, 0, 4); }
}

// 开箱即用单表自关联树模式适配器（对标 AG Grid TreeData 与 DevExpress TreeList）：
// 基于主键列（idCol）与父级主键列（parentCol）自动构建树形层级，无需用户手写任何适配器代码。
public class IdTreeAdapter : TreeAdapter {
    int idCol;
    int parentCol;
    List<int> rootIndices;
    // 每行的子行索引列表（按源行索引索引）：
    List<List<int>> childIndices;
    // 每行的父行索引（按源行索引索引，-1 表示根）：
    List<int> parentIndices;
    int lastRowCount;

    IdTreeAdapter(int idColumn, int parentColumn) {
        this.idCol = idColumn;
        this.parentCol = parentColumn;
        this.rootIndices = new List<int>();
        this.childIndices = new List<List<int>>();
        this.parentIndices = new List<int>();
        this.lastRowCount = -1;
    }

    public void EnsureIndex(DataSource src) {
        if (src == null) { return; }
        int count = src.RowCount();
        if (count == this.lastRowCount) { return; }
        this.lastRowCount = count;
        this.rootIndices.Clear();
        this.childIndices.Clear();
        this.parentIndices.Clear();

        for (int i = 0; i < count; i = i + 1) {
            this.childIndices.Add(new List<int>());
            this.parentIndices.Add(0 - 1);
        }

        // 建立 id -> row 映射
        Dict<string, int> idToRow = new Dict<string, int>();
        for (int r = 0; r < count; r = r + 1) {
            string idVal = src.CellText(r, this.idCol).Trim();
            if (idVal.Length > 0) {
                idToRow[idVal] = r;
            }
        }

        // 建立树形父子关系
        for (int r2 = 0; r2 < count; r2 = r2 + 1) {
            string pVal = src.CellText(r2, this.parentCol).Trim();
            int pRow = -1;
            if (pVal.Length > 0 && pVal != "0" && pVal != "-1" && idToRow.ContainsKey(pVal)) {
                pRow = idToRow[pVal];
            }
            if (pRow >= 0 && pRow != r2) {
                this.parentIndices[r2] = pRow;
                this.childIndices[pRow].Add(r2);
            } else {
                this.rootIndices.Add(r2);
            }
        }
    }

    override int RootCount(DataSource src) {
        this.EnsureIndex(src);
        return this.rootIndices.Count;
    }

    override int RootAt(DataSource src, int i) {
        this.EnsureIndex(src);
        if (i >= 0 && i < this.rootIndices.Count) {
            return this.rootIndices[i];
        }
        return -1;
    }

    override int ChildCount(DataSource src, int row) {
        this.EnsureIndex(src);
        if (row >= 0 && row < this.childIndices.Count) {
            return this.childIndices[row].Count;
        }
        return 0;
    }

    override int ChildOf(DataSource src, int row, int index) {
        this.EnsureIndex(src);
        if (row >= 0 && row < this.childIndices.Count) {
            List<int> kids = this.childIndices[row];
            if (index >= 0 && index < kids.Count) {
                return kids[index];
            }
        }
        return -1;
    }

    override int ParentOf(DataSource src, int row) {
        this.EnsureIndex(src);
        if (row >= 0 && row < this.parentIndices.Count) {
            return this.parentIndices[row];
        }
        return -1;
    }
}
