using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// 标准文本悬浮编辑器（基于标准 Gui.Widget.Input）
// 拥有原生的文本选区、IME 输入、双击选词、光标拖动、系统剪贴板支持（Ctrl+C/V/X/Z）。
public class TextCellEditor : CellEditor {
    Input inp;

    TextCellEditor() {
        this.inp = null;
    }

    override Control CreateWidget(App app, DataTableState st, DataColumn col) {
        if (this.inp == null) {
            this.inp = new Input();
            this.inp.Autoselect = true;
        }
        return this.inp;
    }

    override void BeginEdit(Control ctl, string initValue, DataColumn col) {
        Input input = (Input)ctl;
        input.SetText(initValue);
        input.SelectAll();
    }

    override string GetValue(Control ctl, DataColumn col) {
        Input input = (Input)ctl;
        return input.GetText();
    }

    override void Focus(App app, Control ctl) {
        if (app != null && ctl != null) {
            Input inp = (Input)ctl;
            app.focus.SetFocused(inp.wid);
        }
    }

    override bool OnKeyDown(Control ctl, int key, DataTableState st) {
        // Tab (9), Enter (13), Esc (27) 交给 DataTable 外层处理提交、跳转与取消
        if (key == 13 || key == 9 || key == 27) {
            return false;
        }
        return true;
    }

    override void EndEdit(Control ctl) {
    }
}
