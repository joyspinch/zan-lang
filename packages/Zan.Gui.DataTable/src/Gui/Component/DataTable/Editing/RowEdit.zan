using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// 一条可逆更改，记录后 Ctrl+Z 可将其还原。
// `kind` 为 0 单元格编辑、1 行插入、2 行删除。删除把整行
// 文本保存在 `cells` 中，因为源在 RemoveRow 返回的
// 那一刻就可以丢弃存储——
// 让行可恢复的是日志，而非源。
public class RowEdit {
    int kind;
    int row;  // 更改所作用的数据行索引
    int col;  // 单元格编辑：列；否则为 -1
    string before;  // 单元格编辑：原有的值
    string after;  // 单元格编辑：写入的值
    List<string> cells;  // 行删除：被删除的行，逐单元格

    // 同组条目一起撤销。一次粘贴涉及五十个
    // 单元格，必须一次 Ctrl+Z 全部回退，而不是五十次——
    // 因此撤销的单位是组而非条目。0 表示“单独成组”。
    int group;

    public static RowEdit Cell(int row, int col, string before, string after) {
        RowEdit e = new RowEdit();
        e.kind = 0;
        e.row = row;
        e.col = col;
        e.before = before;
        e.after = after;
        e.cells = new List<string>();
        e.group = 0;
        return e;
    }

    public static RowEdit Insert(int row) {
        RowEdit e = new RowEdit();
        e.kind = 1;
        e.row = row;
        e.col = -1;
        e.before = "";
        e.after = "";
        e.cells = new List<string>();
        e.group = 0;
        return e;
    }

    public static RowEdit Delete(int row, List<string> cells) {
        RowEdit e = new RowEdit();
        e.kind = 2;
        e.row = row;
        e.col = -1;
        e.before = "";
        e.after = "";
        e.cells = cells;
        e.group = 0;
        return e;
    }
}
