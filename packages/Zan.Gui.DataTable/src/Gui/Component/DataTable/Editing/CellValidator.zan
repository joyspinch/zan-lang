using System;
using Gui;

namespace Gui.Component.DataTable;

// 单元格数据校验器抽象基类与通用实现（对标 DevExpress GridColumn.AddRule / AG Grid Cell Validation）
// 校验不通过时返回错误描述；通过时返回空字符串 "" 或 null。
public class CellValidator {
    public virtual string Validate(DataColumn col, string value, int row, int colIdx) {
        return "";
    }
}

public delegate string CellValidateFunc(DataColumn col, string value, int row, int colIdx);

public class CustomCellValidator : CellValidator {
    public CellValidateFunc fn;

    public CustomCellValidator(CellValidateFunc f) {
        this.fn = f;
    }

    public override string Validate(DataColumn col, string value, int row, int colIdx) {
        if (this.fn != null) {
            return this.fn(col, value, row, colIdx);
        }
        return "";
    }
}
