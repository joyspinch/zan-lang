using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// 逐列过滤器，由三个协作阶段组成（均可选）：
// 1. 集合筛选 \u2014 剔除 `hidden` 中存在的值（Values 标签页）；
// 2. 文本筛选 \u2014 `textMode`（1 包含 / 2 等于 / 3 开头 / 4 结尾）
// 对 `textQuery` 进行匹配（Text Filters 标签页）；
// 3. 批量筛选 \u2014 匹配 `batchTerms` 中的每一项（按 `batchExact`
// 精确或子串匹配）；`batchKeep` 保留匹配项，否则排除。
public class ColFilter {
    List<string> hidden;
    int textMode;
    string textQuery;
    List<string> batchTerms;
    bool batchExact;
    bool batchKeep;

    // ---- 比较筛选（第 4 阶段） ----
    // 使用列自身的排序规则将单元格与 cmpA 比较（双边模式还用 cmpB），
    // 因此数值列按值比较，日期
    // 列按天、bool 列按真值比较——从不按字典序。
    // cmpMode：0 关闭，1 >，2 >=，3 <，4 <=，5 ==，6 !=，7 介于（含端点），
    // 8 不介于，9 为空，10 不为空
    int cmpMode;
    string cmpA;
    string cmpB;

    // ---- 日期预设（第 5 阶段） ----
    // 筛选时相对“今天”解析的窗口，因此保存的
    // 布局明天依然有效。解析为包含端点的日期范围。
    // 0 关闭，1 今天，2 昨天，3 本周（从周日算起），4 最近 7 天，
    // 5 本月，6 最近 30 天，7 本季度，8 今年，9 年初至今，
    // 10 过去（今天之前），11 未来（今天之后）
    int datePreset;

    // ---- Top-N（第 6 阶段，作用于整个集合而非逐行） ----
    // 0 关闭，1 前 N，2 后 N，3 前 N%，4 后 N%，
    // 5 高于平均值，6 低于平均值
    int topMode;
    int topN;

    ColFilter() {
        this.hidden = new List<string>();
        this.textMode = 1;
        this.textQuery = "";
        this.batchTerms = new List<string>();
        this.batchExact = false;
        this.batchKeep = true;
        this.cmpMode = 0;
        this.cmpA = "";
        this.cmpB = "";
        this.datePreset = 0;
        this.topMode = 0;
        this.topN = 10;
    }

    public bool IsHidden(string v) {
        return hidden.Contains(v);
    }

    public void Toggle(string v) {
        int idx = hidden.IndexOf(v);
        if (idx >= 0) {
            hidden.RemoveAt(idx);
        } else {
            hidden.Add(v);
        }
    }

    public bool Active() {
        if (hidden.Count > 0) { return true; }
        if (textQuery.Length > 0) { return true; }
        if (batchTerms.Count > 0) { return true; }
        if (cmpMode != 0) { return true; }
        if (datePreset != 0) { return true; }
        if (topMode != 0) { return true; }
        return false;
    }

    // 此过滤器是否需要在决定前取得整个过滤集合
    // （Top-N 和高于/低于平均值），而不是逐行判断。
    bool NeedsSetPass() { return topMode != 0; }

    // 移除所有阶段，恢复列为不过滤状态。
    public void Reset() {
        hidden.Clear();
        textMode = 1;
        textQuery = "";
        batchTerms.Clear();
        batchExact = false;
        batchKeep = true;
        cmpMode = 0;
        cmpA = "";
        cmpB = "";
        datePreset = 0;
        topMode = 0;
        topN = 10;
    }
}
