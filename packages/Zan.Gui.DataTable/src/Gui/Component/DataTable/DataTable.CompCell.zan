using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

public partial class DataTable {
    static bool compsInited;

    // 池控件专属保留 id 段（940000）的游标，seq 域——实际
    // id = 1000000 + 940000 + 游标。与 Designer(800000/840000/
    // 860000)、SceneDesigner(820000/880000)、FilePicker/ChildWindow
    // (900000)、Layer(930000)、IDE 助手(935000) 错开。
    static int compBandSeq;

    // 进入池控件独立作用域（配对 CompBandExit）。
    // 基于作用域 Hash 栈隔离分配，消除硬编码 940000 魔数号段，
    // 保证不同表格、不同行内组件 ID 永远局部唯一且不与其他窗口踩踏。
    public static int CompBandEnter() {
        WidgetId.Push("datatable_comp_band");
        return 0;
    }

    // 离开池控件独立作用域，恢复外部上下文计数器。
    public static void CompBandExit(int outer) {
        WidgetId.Pop();
    }

    // 内置组件适配器装配。幂等。
    public static void EnsureCompRegistry() {
        if (compsInited) { return; }
        compsInited = true;
        CellComp.Register(new BandGridComp());
        DataTable.EnsureWidgetComps();
    }

    // 测试钩子：触发注册表装配并返回已就绪标志。
    public static bool EnsureCompRegistryProbe() {
        DataTable.EnsureCompRegistry();
        return compsInited;
    }

    // 组件列渲染入口：解析值 → 取适配器 → 池化 → 刷值 →
    // 三步渲染 → 点击归一。由 DrawCellRangeCtx 的 cellType 9
    // 分支调用（画布已裁剪到格矩形内）。`src` 是网格当前
    // 数据源，用于稳定行键池化。
    public static void DrawCompCell(App app, DataColumn col, string val,
                             int cx, int cy, int cw, int rowH,
                             int rowIdx, int cc, DataSource src,
                             DataTableState st) {
        CellComp comp = CellComp.Find(col.compId);
        if (comp == null) {
            // 未注册的 compId：画占位块，fail-soft 不炸帧。
            Canvas c = app.canvas;
            Theme t = app.theme;
            StyleBox ph = Style.Part(app, "datatable", "progress-track",
                                     "", "", "", Style.SNormal());
            c.FillRoundRect(cx + t.paddingSmall, cy + app.Scale(4),
                            cw - t.paddingSmall * 2, rowH - app.Scale(8),
                            t.borderRadiusSmall, ph.BgOr(0));
            return;
        }
        List<int> vals = new List<int>();
        if (col.cellType != 10) {
            List<string> parts = DataTable.NumSeries(val);
            for (int i = 0; i < parts.Count; i = i + 1) {
                vals.Add(DataTable.ParseInt(parts[i]));
            }
        }
        int rows = col.shapeR;
        int cols = col.shapeC;
        if (cols <= 0) { cols = vals.Count; }
        if (cols < 1) { cols = 1; }
        if (rows <= 0) { rows = 1; }
        // 稳定行键：优先数据源的业务键；不可用时回退位置键
        // （与选择/详情的键回退语义一致）。
        RowKey key = null;
        if (src != null) { key = src.GetRowKey(rowIdx); }
        if (key == null) { key = RowKey.Legacy(rowIdx); }
        // 池键冠以本表实例序号：注册表是进程级单例，裸 (RowKey, col)
        // 会让同屏两个网格（或一表一预览）声明同一 compId 时拿到
        // 同一个控件实例——同帧互灌值、互抢命中矩形、提交串台。
        key = DataTable.CompPoolKey(st, key);
        // 池控件的构造（Acquire 未命中时 new）与值刷灌（FillStr 里
        // 可能重灌选项/分段、Rate.Max 重排星号块）都会领新 id——
        // 全部圈进保留段，见 CompBandEnter 的注释。
        int outerSeq = DataTable.CompBandEnter();
        Control ctl = comp.Acquire(app, src, rowIdx, cc, key,
                                   cx, cy, cw, rowH, rows, cols);
        if (ctl != null) {
            // 数值形态（cellType 9）走序列灌值；字符串形态
            // （cellType 10 WidgetCol）直接把原始单元格文本给适配器。
            if (col.cellType == 10) {
                comp.FillStr(ctl, val, col, src, rowIdx);
            } else {
                comp.Fill(ctl, vals, rows, cols, col.heatBand);
            }
        }
        DataTable.CompBandExit(outerSeq);
        if (ctl == null) { return; }
        if (st != null && st.activeDetails != null) {
            if (!st.activeDetails.Contains(ctl)) {
                st.activeDetails.Add(ctl);
            }
            if (st.ownerControl != null) {
                ctl.parent = st.ownerControl;
            }
        }
        ctl.MeasureTree(app);
        // 组件默认在格内垂直居中（DataColumn.VTop() 可声明顶对齐）：
        // 叶子控件都在 Arrange 矩形的顶边作画，行高大于控件自然高度
        // 时把矩形整体下移半格高差即可居中。矩阵形态（cellType 9，
        // bandgrid 等）按行列铺满格高，不参与这个默认。
        if (col.cellType == 10 && !col.vTop) {
            int natH = ctl.StyleHeight();
            if (natH > 0 && natH < rowH) { cy = cy + (rowH - natH) / 2; }
        }
        ctl.Arrange(cx, cy, cw, rowH);
        ctl.RenderTree(app);
        // 写回轮询（WidgetCol 形态）：控件本帧产生了新值则按
        // ToggleBoolCell 同款通道提交——记撤销、写源、Raise
        // CellEdit；值与单元格现状相同则静默跳过。
        if (st != null && col.cellType == 10) {
            string nv = "";
            if (comp.TakeCommit(ctl, ref nv) && src != null
                && rowIdx >= 0 && cc >= 0 && nv != val) {
                DataTable.Journal(st, RowEdit.Cell(rowIdx, cc, val, nv));
                src.SetCell(rowIdx, cc, nv);
                st.hitRow = rowIdx;
                st.hitCol = cc;
                st.CellEdit.Raise();
            }
        }
        // 点击归一：组件内发生了激活（如 BandGrid 双击），把
        // 事件上下文指向本格并附上格内位置后 Raise CellClick。
        if (st != null) {
            int pr = 0;
            int pc = 0;
            if (comp.CompPos(ctl, ref pr, ref pc)) {
                if (rowIdx >= 0 && cc >= 0) {
                    st.hitRow = rowIdx;
                    st.hitCol = cc;
                }
                st.compR = pr;
                st.compC = pc;
                st.CellClick.Raise();
            }
        }
    }

    // 最近一次组件列点击在矩阵内的行（CellClick 处理器读取）。
    public static int CompPosR(DataTableState st) { return st.compR; }

    // 最近一次组件列点击在矩阵内的列。
    public static int CompPosC(DataTableState st) { return st.compC; }

    // 组件池键命名空间：给行键冠以表状态实例序号。适配器池只按
    // (RowKey, col) 存控件，而注册表（CellComp.registry）是进程级
    // 单例——同屏两个网格声明同一 compId 时，两表同帧会从同一
    // 适配器拿到同一个控件实例：互灌值、互抢命中矩形、提交串台
    // （bandgrid 与 WidgetCol 形态同样中招）。业务键文本原样保留，
    // 同一表内的复用语义不变。
    public static RowKey CompPoolKey(DataTableState st, RowKey key) {
        if (st == null || key == null) { return key; }
        return RowKey.Of("t" + Convert.ToString(st.inst) + "@"
                         + key.Canonical());
    }

    // 测试钩子：两个状态实例对同一行键得到不同池键，且同一实例
    // 跨帧（多次调用）稳定。
    public static bool CompPoolKeyDistinctProbe(DataTableState a, DataTableState b) {
        RowKey k = RowKey.Of("probe");
        string ka = DataTable.CompPoolKey(a, k).Canonical();
        string kb = DataTable.CompPoolKey(b, k).Canonical();
        string ka2 = DataTable.CompPoolKey(a, k).Canonical();
        return ka != kb && ka == ka2;
    }
}
