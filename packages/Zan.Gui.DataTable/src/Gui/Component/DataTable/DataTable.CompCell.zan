using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

/// 组件列适配器：把 cellType 9 的单元格值（逗号分隔数值序列，
/// 与迷你图同一序列化约定）灌进一个池化的真控件，供渲染循环
/// Measure/Arrange/RenderTree 三步渲染。这是框架作者级扩展点——
/// 使用层经 `DataGrid<T>.CompCol` 声明 `compId`，从不接触本接口。
///
/// 注册表在 DataTable.CompCell 静态块完成内置装配（"bandgrid"）；
/// 新组件实现本抽象类并 Register 一次，即对全部网格声明式可用。
///
/// 池化责任在本类：以 `GetRowKey(row)` + 列为键缓存控件实例，
/// 虚拟滚动下同一显示槽位会滚过任意多行，复用时由 Fill 只刷
/// 数据、不重建控件——焦点不丢、状态不闪。
abstract class CellComp {
    public string id;

    CellComp(string id) {
        this.id = id;
    }

    /// 创建（或从池中取出）该格的控件实例。`rows`/`cols` 来自
    /// 列声明的矩阵形状（<=0 时实现自行决定默认形状）。
    /// 实现必须缓存：同一 (key, col) 每帧拿到同一个实例。
    virtual Control Acquire(App app, DataSource src, int row, int col,
                            RowKey key, int x, int y, int w, int h,
                            int rows, int cols) { return null; }

    /// 把单元格值灌进控件。`vals` 是解析后的数值序列（可能
    /// 为空）；`rows`/`cols` 是目标矩阵形状。实现按需 SetNum、
    /// 多余槽位清零、缺失槽位保持旧值，不得重新 Bind 清掉
    /// 用户选区。
    virtual void Fill(Control ctl, List<int> vals, int rows, int cols,
                      string heatBand) { }

    /// 组件列字符串值形态（cellType 10 WidgetCol）：把原始
    /// 单元格文本灌进控件（开关的布尔、下拉的选中项等），
    /// `col` 提供列级配置（choices、boolTrue/boolFalse、形状），
    /// `src`/`row` 供适配器需要行上下文时使用。默认空实现，
    /// 旧数值适配器（bandgrid）零改动。
    virtual void FillStr(Control ctl, string val, DataColumn col,
                         DataSource src, int row) { }

    /// 渲染后轮询（两个形态共用）：控件本帧发生了会写回数据的
    /// 变化时返回 true 并把新值放 `outVal`（引擎按
    /// Journal(RowEdit.Cell) → src.SetCell → CellEdit 提交）。
    /// 返回 false 表示无变化。值比较由引擎做，适配器只上报。
    virtual bool TakeCommit(Control ctl, ref string outVal) { return false; }

    /// 最近一次 Fill 中命中的矩阵内位置（用于把组件内点击
    /// 归一为 CellClick 时提供格内 (r,c)；未命中返回 false）。
    virtual bool CompPos(Control ctl, ref int r, ref int c) { return false; }

    /// 网格重建时清空池（随 CellWidgetProvider.Reset 的语义）。
    virtual void Reset() { }

    // ---- 注册表 ----
    static List<CellComp> registry;

    /// 单个适配器池的深度上限。池键含业务键，键集无界的数据源
    /// （时间戳主键、实时流逐行换键）会让池随历史行无限增长——
    /// 超过上限整池重置：宁可损失复用，不失去内存上界。
    static readonly int PoolCap = 2048;

    /// 按 id 注册适配器（重复注册覆盖，便于测试）。首次调用
    /// 装配内置适配器。
    static void Register(CellComp comp) {
        if (registry == null) { registry = new List<CellComp>(); }
        for (int i = 0; i < registry.Count; i = i + 1) {
            if (registry[i].id == comp.id) { registry[i] = comp; return; }
        }
        registry.Add(comp);
    }

    static CellComp Find(string id) {
        DataTable.EnsureCompRegistry();
        for (int i = 0; i < registry.Count; i = i + 1) {
            if (registry[i].id == id) { return registry[i]; }
        }
        return null;
    }
}

/// "bandgrid" 适配器：把数值序列按行优先灌进 BandGrid 矩阵。
/// 形状缺省 1×序列长度（单行条）；heatBand 经 HeatBands 映射为
/// 底色梯度回调。点击/拖选随 BandGrid 自身交互，CompPos 读其
/// CellRow/CellCol。
class BandGridComp : CellComp {
    // 池：键 = RowKey 序列化文本 + 列号。控件与形状缓存在一起，
    // 形状变化（列配置重声明）时重建。
    List<string> poolKeys;
    List<Control> poolCtl;
    List<int> poolShape;

    BandGridComp() : base("bandgrid") {
        this.poolKeys = new List<string>();
        this.poolCtl = new List<Control>();
        this.poolShape = new List<int>();
    }

    override Control Acquire(App app, DataSource src, int row, int col,
                             RowKey key, int x, int y, int w, int h,
                             int rows, int cols) {
        string k = key.Canonical() + ":" + Convert.ToString(col);
        int shape = rows * 1024 + cols;
        for (int i = 0; i < this.poolKeys.Count; i = i + 1) {
            if (this.poolKeys[i] == k) {
                if (this.poolShape[i] != shape) {
                    // 形状变了：换新实例（旧实例交 GC）。
                    this.poolKeys.RemoveAt(i);
                    this.poolCtl.RemoveAt(i);
                    this.poolShape.RemoveAt(i);
                    break;
                }
                return this.poolCtl[i];
            }
        }
        BandGrid g = new BandGrid();
        g.Bind(rows, cols);
        g.CellSize(16, 14);
        g.wiresOwnEvents = true;
        if (this.poolKeys.Count >= CellComp.PoolCap) { this.Reset(); }
        this.poolKeys.Add(k);
        this.poolCtl.Add(g);
        this.poolShape.Add(shape);
        return g;
    }

    override void Fill(Control ctl, List<int> vals, int rows, int cols,
                       string heatBand) {
        BandGrid g = (BandGrid)ctl;
        // 色带只把深端锚色交给 BandGrid：浅端由它绘制时从当前
        // 皮肤表面色派生（HeatBands 的浅端是亮色皮肤参考值）。
        if (heatBand != "") {
            int lo = 0;
            int hi = 0;
            DataColumn.HeatBands(heatBand, ref lo, ref hi);
            g.Heat(hi);
        } else {
            g.Heat(0);
        }
        int n = rows * cols;
        for (int i = 0; i < n; i = i + 1) {
            int v = 0;
            if (vals != null && i < vals.Count) { v = vals[i]; }
            if (g.NumAt(i / cols, i % cols) != v) {
                g.SetNum(i / cols, i % cols, v);
            }
        }
    }

    override bool CompPos(Control ctl, ref int r, ref int c) {
        BandGrid g = (BandGrid)ctl;
        if (g.CellRow() < 0) { return false; }
        r = g.CellRow();
        c = g.CellCol();
        return true;
    }

    override void Reset() {
        this.poolKeys.Clear();
        this.poolCtl.Clear();
        this.poolShape.Clear();
    }
}

partial class DataTable {
    static bool compsInited;

    /// 池控件专属保留 id 段（940000）的游标，seq 域——实际
    /// id = 1000000 + 940000 + 游标。与 Designer(800000/840000/
    /// 860000)、SceneDesigner(820000/880000)、FilePicker/ChildWindow
    /// (900000)、Layer(930000)、IDE 助手(935000) 错开。
    static int compBandSeq;

    /// 进入池控件保留段（配对 CompBandExit，返回宿主计数器）。
    /// 池控件在帧循环中迟到构造，而即时模式宿主（画廊等混合体）
    /// 每帧 WidgetId.ResetFrame 会把主计数器回卷重发：从这里直接
    /// 领号，领走的正是宿主后续某帧控件的本命 id——任何让当帧
    /// 分配数变化的交互（插删行、toast、开窗）都会把分配前沿推过
    /// 池控件的 id，点击按 id 归属时两个控件同时命中，事件落到
    /// 错误的控件/行（「不同行组件事件乱飞」）。与 Layer 同一机制：
    /// 段内取号，宿主计数器原样恢复、互不相扰。
    static int CompBandEnter() {
        int outer = WidgetId.SeqValue();
        WidgetId.SetSeq(940000 + DataTable.compBandSeq);
        return outer;
    }

    /// 离开池控件保留段：游标按实际消耗推进（各控件一次用量
    /// 不一，按用量记账比定步长稳），宿主计数器恢复。
    static void CompBandExit(int outer) {
        DataTable.compBandSeq = WidgetId.SeqValue() - 940000;
        WidgetId.SetSeq(outer);
    }

    /// 内置组件适配器装配。幂等。
    static void EnsureCompRegistry() {
        if (compsInited) { return; }
        compsInited = true;
        CellComp.Register(new BandGridComp());
        DataTable.EnsureWidgetComps();
    }

    /// 测试钩子：触发注册表装配并返回已就绪标志。
    static bool EnsureCompRegistryProbe() {
        DataTable.EnsureCompRegistry();
        return compsInited;
    }

    /// 组件列渲染入口：解析值 → 取适配器 → 池化 → 刷值 →
    /// 三步渲染 → 点击归一。由 DrawCellRangeCtx 的 cellType 9
    /// 分支调用（画布已裁剪到格矩形内）。`src` 是网格当前
    /// 数据源，用于稳定行键池化。
    static void DrawCompCell(App app, DataColumn col, string val,
                             int cx, int cy, int cw, int rowH,
                             int rowIdx, int cc, DataSource src,
                             DataTableState st) {
        CellComp comp = CellComp.Find(col.compId);
        if (comp == null) {
            // 未注册的 compId：画占位块，fail-soft 不炸帧。
            Canvas c = app.canvas;
            Theme t = app.theme;
            StyleBox ph = Style.Part(app, "datatable", "progress-track",
                                     "", "", "", Style.SNormal());
            c.FillRoundRect(cx + t.paddingSmall, cy + app.Scale(4),
                            cw - t.paddingSmall * 2, rowH - app.Scale(8),
                            t.borderRadiusSmall, ph.BgOr(0));
            return;
        }
        List<int> vals = new List<int>();
        if (col.cellType != 10) {
            List<string> parts = DataTable.NumSeries(val);
            for (int i = 0; i < parts.Count; i = i + 1) {
                vals.Add(DataTable.ParseInt(parts[i]));
            }
        }
        int rows = col.shapeR;
        int cols = col.shapeC;
        if (cols <= 0) { cols = vals.Count; }
        if (cols < 1) { cols = 1; }
        if (rows <= 0) { rows = 1; }
        // 稳定行键：优先数据源的业务键；不可用时回退位置键
        // （与选择/详情的键回退语义一致）。
        RowKey key = null;
        if (src != null) { key = src.GetRowKey(rowIdx); }
        if (key == null) { key = RowKey.Legacy(rowIdx); }
        // 池键冠以本表实例序号：注册表是进程级单例，裸 (RowKey, col)
        // 会让同屏两个网格（或一表一预览）声明同一 compId 时拿到
        // 同一个控件实例——同帧互灌值、互抢命中矩形、提交串台。
        key = DataTable.CompPoolKey(st, key);
        // 池控件的构造（Acquire 未命中时 new）与值刷灌（FillStr 里
        // 可能重灌选项/分段、Rate.Max 重排星号块）都会领新 id——
        // 全部圈进保留段，见 CompBandEnter 的注释。
        int outerSeq = DataTable.CompBandEnter();
        Control ctl = comp.Acquire(app, src, rowIdx, cc, key,
                                   cx, cy, cw, rowH, rows, cols);
        if (ctl != null) {
            // 数值形态（cellType 9）走序列灌值；字符串形态
            // （cellType 10 WidgetCol）直接把原始单元格文本给适配器。
            if (col.cellType == 10) {
                comp.FillStr(ctl, val, col, src, rowIdx);
            } else {
                comp.Fill(ctl, vals, rows, cols, col.heatBand);
            }
        }
        DataTable.CompBandExit(outerSeq);
        if (ctl == null) { return; }
        ctl.MeasureTree(app);
        // 组件默认在格内垂直居中（DataColumn.VTop() 可声明顶对齐）：
        // 叶子控件都在 Arrange 矩形的顶边作画，行高大于控件自然高度
        // 时把矩形整体下移半格高差即可居中。矩阵形态（cellType 9，
        // bandgrid 等）按行列铺满格高，不参与这个默认。
        if (col.cellType == 10 && !col.vTop) {
            int natH = ctl.StyleHeight();
            if (natH > 0 && natH < rowH) { cy = cy + (rowH - natH) / 2; }
        }
        ctl.Arrange(cx, cy, cw, rowH);
        ctl.RenderTree(app);
        // 写回轮询（WidgetCol 形态）：控件本帧产生了新值则按
        // ToggleBoolCell 同款通道提交——记撤销、写源、Raise
        // CellEdit；值与单元格现状相同则静默跳过。
        if (st != null && col.cellType == 10) {
            string nv = "";
            if (comp.TakeCommit(ctl, ref nv) && src != null
                && rowIdx >= 0 && cc >= 0 && nv != val) {
                DataTable.Journal(st, RowEdit.Cell(rowIdx, cc, val, nv));
                src.SetCell(rowIdx, cc, nv);
                st.hitRow = rowIdx;
                st.hitCol = cc;
                st.CellEdit.Raise();
            }
        }
        // 点击归一：组件内发生了激活（如 BandGrid 双击），把
        // 事件上下文指向本格并附上格内位置后 Raise CellClick。
        if (st != null) {
            int pr = 0;
            int pc = 0;
            if (comp.CompPos(ctl, ref pr, ref pc)) {
                if (rowIdx >= 0 && cc >= 0) {
                    st.hitRow = rowIdx;
                    st.hitCol = cc;
                }
                st.compR = pr;
                st.compC = pc;
                st.CellClick.Raise();
            }
        }
    }

    /// 最近一次组件列点击在矩阵内的行（CellClick 处理器读取）。
    static int CompPosR(DataTableState st) { return st.compR; }

    /// 最近一次组件列点击在矩阵内的列。
    static int CompPosC(DataTableState st) { return st.compC; }

    /// 组件池键命名空间：给行键冠以表状态实例序号。适配器池只按
    /// (RowKey, col) 存控件，而注册表（CellComp.registry）是进程级
    /// 单例——同屏两个网格声明同一 compId 时，两表同帧会从同一
    /// 适配器拿到同一个控件实例：互灌值、互抢命中矩形、提交串台
    /// （bandgrid 与 WidgetCol 形态同样中招）。业务键文本原样保留，
    /// 同一表内的复用语义不变。
    static RowKey CompPoolKey(DataTableState st, RowKey key) {
        if (st == null || key == null) { return key; }
        return RowKey.Of("t" + Convert.ToString(st.inst) + "@"
                         + key.Canonical());
    }

    /// 测试钩子：两个状态实例对同一行键得到不同池键，且同一实例
    /// 跨帧（多次调用）稳定。
    static bool CompPoolKeyDistinctProbe(DataTableState a, DataTableState b) {
        RowKey k = RowKey.Of("probe");
        string ka = DataTable.CompPoolKey(a, k).Canonical();
        string kb = DataTable.CompPoolKey(b, k).Canonical();
        string ka2 = DataTable.CompPoolKey(a, k).Canonical();
        return ka != kb && ka == ka2;
    }
}
