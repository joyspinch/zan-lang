using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// DataTable 列级条件格式规则实体（消除 menuCfMode/menuCfColor 等平行列表反模式）。
public class ColumnCfRule {
    public int mode;
    public int color;
    public int color2;
    public int threshold;
    public bool rankPct;
    public bool off;

    public ColumnCfRule() {
        this.mode = 0;
        this.color = 0;
        this.color2 = 0;
        this.threshold = 0;
        this.rankPct = false;
        this.off = false;
    }

    public static ColumnCfRule Create() {
        return new ColumnCfRule();
    }
}
