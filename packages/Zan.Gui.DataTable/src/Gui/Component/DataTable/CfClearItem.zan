using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// 条件格式清除项实体（消除 cfClearCols/cfClearSel 平行列表反模式）。
public class CfClearItem {
    public int column;
    public bool selected;

    public CfClearItem(int column, bool selected) {
        this.column = column;
        this.selected = selected;
    }
}
