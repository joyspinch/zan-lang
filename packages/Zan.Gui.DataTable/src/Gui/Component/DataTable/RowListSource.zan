using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// 向后兼容适配器：通过 DataSource 接口提供内存中的
// 字符串单元格 `List<DataRow>`，
// 现有 `DataTable.Render(..., rows, ...)` 调用无需改动即可继续工作。
public class RowListSource : DataSource {
    public List<DataRow> rows;

    public RowListSource(List<DataRow> rows) {
        this.rows = rows;
    }

    public override int RowCount() { return this.rows.Count; }
    public override string CellText(int row, int col) { return this.rows[row].At(col); }
    public override int CellNum(int row, int col) { return DataTable.ParseInt(this.rows[row].At(col)); }
    public override void SetCell(int row, int col, string v) { this.rows[row].Set(col, v); }

    // 内存列表总能增长或收缩。
    public override bool CanInsert() { return true; }

    public override bool InsertRow(int at) {
        if (at < 0 || at > this.rows.Count) { return false; }
        this.rows.Insert(at, new DataRow());
        return true;
    }

    public override bool RemoveRow(int at) {
        if (at < 0 || at >= this.rows.Count) { return false; }
        this.rows.RemoveAt(at);
        return true;
    }
}
