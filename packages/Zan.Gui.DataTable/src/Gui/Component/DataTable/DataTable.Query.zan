using System;
using System.Json;

namespace Gui.Component.DataTable;

public partial class DataTable {
    // 数据内容、行键或 schema 改变：所有派生查询和显示结果失效。
    public static void InvalidateData(DataTableState st) {
        st.dataRevision = st.dataRevision + 1;
        st.queryRevision = st.queryRevision + 1;
        st.viewRevision = st.viewRevision + 1;
        st.rowKeysRevision = -1;
        st.rowKeys.Clear();
        st.dirty = true;
    }

    // 过滤、排序、分组、汇总或分页参数改变：数据身份不变，
    // 只使查询和依赖它的显示模型失效。透视视图的交叉
    // 聚合依赖筛选结果，一并标脏重建。
    public static void InvalidateQuery(DataTableState st) {
        st.queryRevision = st.queryRevision + 1;
        st.viewRevision = st.viewRevision + 1;
        st.dirty = true;
        st.pvDirty = true;
    }

    // 列宽、顺序、隐藏、冻结或主题显示状态改变：只使几何/帧失效。
    public static void InvalidateView(DataTableState st) {
        st.viewRevision = st.viewRevision + 1;
        st.dirty = true;
    }
}
