using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

partial class DataTable {
    // ---------- 查找条（Ctrl+F，VTable 搜索插件的同类项） ----------

    // 查找与筛选互补：筛选丢弃不匹配的行，查找定位并高亮
    // 全部命中格。命中不物化——它们随排序/筛选即时变化，
    // 因此导航沿当前显示顺序现场扫描；每帧高亮只扫可见
    // 窗口（与截断 tooltip 同一成本量级），百万行源也不加重
    // 渲染。命中计数按查询变化后的第一帧统计一次，扫描行数
    // 以 FindScanCap 封顶，输入不卡顿。

    // 命中计数/导航扫描的最大显示行数（超过部分不参与计数
    // 与循环导航——虚拟源上"查找全部"本来就是无限代价）。
    static readonly int FindScanCap = 200000;

    // 打开查找条并聚焦输入框。
    static void OpenFind(DataTableState st) {
        st.findOpen = true;
        st.findFocused = true;
        st.filterRowFocusCol = -1;
        st.findCur = st.findBuf.Length;
    }

    // 关闭查找条并清掉命中高亮（不改数据）。
    static void CloseFind(DataTableState st) {
        st.findOpen = false;
        st.findFocused = false;
        st.findQuery = "";
        st.findBuf = "";
        st.findCur = 0;
        st.findIndex = -1;
        st.findCount = 0;
    }

    // 该列是否参与查找：文本可读的列（文本/链接/标签/进度/
    // 徽章/日期）。图标/按钮/迷你图/组件列的值是图标名、
    // 序列文本，不构成可读的查找键，跳过。
    static bool FindableCol(DataColumn col) {
        if (col.cellType >= 6) { return false; }
        if (col.isBool) { return false; }
        return true;
    }

    // 数据行 `row` 的任一可查找列命中 `q`（不区分大小写）。
    static bool RowHasMatch(List<DataColumn> cols, DataSource src, int row, string q) {
        for (int c = 0; c < cols.Count; c = c + 1) {
            if (!DataTable.FindableCol(cols[c])) { continue; }
            if (DataTable.ContainsCI(DataTable.CellTextRouted(cols, src, row, c), q)) {
                return true;
            }
        }
        return false;
    }

    // 单元格（数据行 row、列 col）是否命中当前查询。供每帧
    // 的高亮绘制与导航扫描调用——一次子串比较，循环内安全。
    static bool CellMatches(DataTableState st, List<DataColumn> cols, DataSource src,
                            int row, int col) {
        if (!st.findOpen || st.findQuery.Length == 0) { return false; }
        if (col < 0 || col >= cols.Count) { return false; }
        if (!DataTable.FindableCol(cols[col])) { return false; }
        return DataTable.ContainsCI(DataTable.CellTextRouted(cols, src, row, col),
                                    st.findQuery);
    }

    // 提交查询：把缓冲同步为生效查询，并按显示顺序统计命中
    // （FindScanCap 封顶）。当前命中序号复位为未导航。
    static void CommitFind(DataTableState st, List<DataColumn> cols, DataSource src) {
        st.findQuery = st.findBuf;
        st.findIndex = -1;
        st.findCount = 0;
        if (st.findQuery.Length == 0) { return; }
        int n = DataTable.DispCount(st);
        if (n > FindScanCap) { n = FindScanCap; }
        for (int i = 0; i < n; i = i + 1) {
            if (DataTable.DispKind(st, i) != 0) { continue; }
            if (DataTable.RowHasMatch(cols, src, DataTable.DispRowOf(st, i), st.findQuery)) {
                st.findCount = st.findCount + 1;
            }
        }
    }

    // 命中计数就地刷新：缓冲与生效查询不一致（正在输入）
    // 才重新统计，否则 O(1) 空转。由查找条绘制每帧调用。
    static void FindEnsureCount(DataTableState st, List<DataColumn> cols, DataSource src) {
        if (st.findQuery == st.findBuf) { return; }
        DataTable.CommitFind(st, cols, src);
    }

    // 沿显示顺序前进（dir 1）/后退（dir -1）到下一个命中格，
    // 到视图尽头回绕（浏览器式）。命中格成为单元格光标并
    // 滚入视野。把 (显示槽位 × 可见列) 摊平成一条序列环扫：
    // 组表头/详情带槽位天然不命中，跳过即可。
    static void FindStep(DataTableState st, List<DataColumn> cols, DataSource src,
                         int dir, int visRows) {
        if (st.findQuery.Length == 0) { DataTable.CommitFind(st, cols, src); }
        if (st.findQuery.Length == 0 || st.findCount == 0) { return; }
        int n = DataTable.DispCount(st);
        if (n > FindScanCap) { n = FindScanCap; }
        List<int> vcols = new List<int>();
        for (int c = 0; c < cols.Count; c = c + 1) {
            if (c < st.colHidden.Count && st.colHidden[c]) { continue; }
            vcols.Add(c);
        }
        if (vcols.Count == 0 || n == 0) { return; }
        int nv = vcols.Count;
        int total2 = n * nv;
        // 起点：当前光标格的下一格（后退则上一格）；无光标时
        // dir>0 从头、dir<0 从尾。
        int start;
        if (st.hitOrder >= 0 && st.hitOrder < n && st.hitCol >= 0) {
            int hv = vcols.IndexOf(st.hitCol);
            if (hv < 0) { hv = dir > 0 ? 0 : nv - 1; }
            start = st.hitOrder * nv + hv + dir;
        } else {
            start = dir > 0 ? 0 : total2 - 1;
        }
        for (int k = 0; k < total2; k = k + 1) {
            int idx = ((start + dir * k) % total2 + total2) % total2;
            int slot = idx / nv;
            int vi = idx - slot * nv;
            if (DataTable.DispKind(st, slot) != 0) { continue; }
            int row = DataTable.DispRowOf(st, slot);
            if (!DataTable.CellMatches(st, cols, src, row, vcols[vi])) { continue; }
            DataTable.MoveCursor(st, src, slot, vcols[vi], false);
            DataTable.ScrollSlotIntoView(st, slot, visRows);
            if (st.findIndex < 0) {
                st.findIndex = dir > 0 ? 0 : st.findCount - 1;
            } else {
                st.findIndex = (st.findIndex + dir + st.findCount) % st.findCount;
            }
            return;
        }
    }

    // 查找条浮层：网格右上角的输入框 + 命中计数 + 上/下/关闭。
    // 绘制在上下文菜单等模态浮层之前，因此菜单永远盖住它；
    // 键盘输入在 RenderSource 的查找键盘块处理（与筛选行
    // 同一模式），这里只处理条内的指针交互。
    static void RenderFindBar(App app, int x, int y, int viewW,
                              List<DataColumn> cols, DataSource src, DataTableState st,
                              int visRows) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = Style.FontFallback(app, "small");
        // 模态浮层（右键菜单/列选择器/条件格式清除/编辑器弹窗）打开
        // 时查找条不得响应：条内命中是几何判定，直接读原始事件，
        // 菜单钳位后正好盖住查找条所在角落，点菜单项会点穿到
        // 上/下/关闭钮上。ModalEvt 与 RenderSource 入口同一份清单。
        int evt = DataTable.ModalEvt(app, st);
        DataTable.FindEnsureCount(st, cols, src);

        int barH = t.heightMedium;
        int barY = y + app.Scale(6);
        int boxW = app.Scale(200);
        int btnW = app.Scale(26);
        int countW = 0;
        if (st.findQuery.Length > 0 && st.findCount > 0) {
            string cnt = Convert.ToString(st.findIndex >= 0 ? st.findIndex + 1 : 0)
                         + "/" + Convert.ToString(st.findCount);
            countW = Canvas.MeasureText(cnt, fs) + app.Scale(10);
        }
        int barW = app.Scale(28) + boxW + countW + btnW * 3 + app.Scale(12);
        int barX = x + viewW - barW - app.Scale(10);

        StyleBox sBar = Style.Part(app, "datatable", "panel", "", "", "",
                                   Style.SNormal());
        c.FillRoundRect(barX, barY, barW, barH, t.borderRadiusSmall, sBar.BgOr(0));
        c.DrawRoundRect(barX, barY, barW, barH, t.borderRadiusSmall,
                        sBar.BorderOr(0), 1);

        // 输入框 + 引导图标
        int ibx = barX + app.Scale(26);
        int iby = barY + app.Scale(4);
        int ibh = barH - app.Scale(8);
        DataTable.EditBox(app, ibx, iby, boxW, ibh, st.findBuf,
                          DataTable.T("Find...", "查找..."), st.findFocused);
        c.DrawGlyphIn("search", barX + app.Scale(5), barY, app.Scale(20), barH,
                      app.Scale(13), Style.Part(app, "datatable", "icon", "", "", "",
                                                 Style.SNormal()).FgOr(0));
        int inputId = app.focus.AllocId();
        app.hitTester.RegisterRect(inputId, ibx, iby, boxW, ibh, 0);
        if (evt == 3 && app.window.EventButton() == 0
            && app.hitTester.HitTest(app.mouseX, app.mouseY) == inputId
            && !st.findFocused) {
            st.findFocused = true;
            st.findCur = st.findBuf.Length;
            app.RequestRedraw();
        }

        // 命中计数（有生效查询且有命中时）
        int cx2 = ibx + boxW + app.Scale(6);
        if (countW > 0) {
            string cnt = Convert.ToString(st.findIndex >= 0 ? st.findIndex + 1 : 0)
                         + "/" + Convert.ToString(st.findCount);
            c.DrawText(cx2, Canvas.CenterTextY(barY, barH, fs), cnt,
                       Style.Part(app, "datatable", "hint", "", "", "",
                                  Style.SNormal()).FgOr(0), fs);
        }
        cx2 = cx2 + countW;

        // 上 / 下 / 关闭
        for (int b = 0; b < 3; b = b + 1) {
            string icon = b == 0 ? "chevron-up" : (b == 1 ? "chevron-down" : "close");
            int bid = app.focus.AllocId();
            app.hitTester.RegisterRect(bid, cx2, barY + app.Scale(2), btnW,
                                       barH - app.Scale(4), 0);
            bool hot = app.focus.IsHovered(bid);
            int gcol = Style.Part(app, "datatable", "icon", "", "", "",
                                  hot ? Style.SHover() : Style.SNormal()).FgOr(0);
            c.DrawGlyphIn(icon, cx2, barY + app.Scale(2), btnW, barH - app.Scale(4),
                          app.Scale(13), gcol);
            if (evt == 3 && app.window.EventButton() == 0
                && app.hitTester.HitTest(app.mouseX, app.mouseY) == bid) {
                if (b == 0) { DataTable.FindStep(st, cols, src, 0 - 1, visRows); }
                else if (b == 1) { DataTable.FindStep(st, cols, src, 1, visRows); }
                else { DataTable.CloseFind(st); }
                app.RequestRedraw();
            }
            cx2 = cx2 + btnW;
        }
    }
}
