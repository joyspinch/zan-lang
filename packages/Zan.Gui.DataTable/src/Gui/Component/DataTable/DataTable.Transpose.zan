using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

public partial class DataTable {
    // ---------- 转置视图（表格整体行列互换） ----------

    // 转置的行数上限：显示列 = 原行，无界宽表没有可操作性
    // （VTable 的转置示例同样是小表）。超过上限的行不进入
    // 视图，状态栏行数仍如实显示原行数。
    static readonly int TransposeRowCap = 300;

    // 表格当前是否处于转置视图。
    static bool IsTransposeView(DataTableState st) {
        return st.transposeView;
    }

    // 把整个表格切换为转置投影：显示行 = 原列（首列是列
    // 标题），显示列 = 原（过滤前的前 TransposeRowCap）行。
    // 生成列只读、统一文本路径；视图层的排序/选区/剪贴板
    // 照常工作。与透视视图互斥——进入时先退出透视。
    static bool SetTranspose(DataTableState st, List<DataColumn> cols, DataSource src) {
        if (cols.Count == 0 || src == null) { return false; }
        if (st.pivotView) { DataTable.ExitPivot(st); }
        if (st.transposeView) { return true; }
        st.transposeView = true;
        st.trOrigCols = cols.Count;
        st.trOrigColsList = cols;
        st.trInner = src;
        st.trSource = new TransposeDataSource(st, src);
        st.trDirty = true;
        DataTable.TransposeEnsure(st);
        DataTable.InvalidateQuery(st);
        return true;
    }

    // 退出转置视图：裁掉生成列在按列状态里追加的槽位，
    // 原始列与数据恢复原状。
    static void ExitTranspose(DataTableState st) {
        if (!st.transposeView) { return; }
        st.transposeView = false;
        int n = st.trOrigCols;
        DataTable.TruncListI(st.colWidths, n);
        DataTable.TruncListI(st.aggMode, n);
        DataTable.TruncListI(st.aggValue, n);
        DataTable.TruncListI(st.cfMin, n);
        DataTable.TruncListI(st.cfMax, n);
        DataTable.TruncListB(st.colHidden, n);
        DataTable.TruncListI(st.colFreeze, n);
        DataTable.TruncListD(st.aggReal, n);
        DataTable.TruncListD(st.aggSumR, n);
        DataTable.TruncListD(st.aggMinR, n);
        DataTable.TruncListD(st.aggMaxR, n);
        DataTable.TruncListD(st.cfMinR, n);
        DataTable.TruncListD(st.cfMaxR, n);
        DataTable.TruncListS(st.summaryText, n);
        if (st.aggregates != null) {
            while (st.aggregates.Count > n) { st.aggregates.RemoveAt(st.aggregates.Count - 1); }
        }
        if (st.cfExtents != null) {
            while (st.cfExtents.Count > n) { st.cfExtents.RemoveAt(st.cfExtents.Count - 1); }
        }
        int k = st.colOrder.Count - 1;
        while (k >= 0) {
            if (st.colOrder[k] >= n) { st.colOrder.RemoveAt(k); }
            k = k - 1;
        }
        st.trViewCols = new List<DataColumn>();
        st.trSource = null;
        st.trInner = null;
        st.trOrigColsList = null;
        st.trRows = 0;
        st.trDirty = false;
        DataTable.PivotResetView(st);
        DataTable.InvalidateQuery(st);
    }

    // 物化转置列（trDirty 时）：生成 1 + min(行数, Cap) 列
    // 只读文本列。行数随底层源变化自动跟进（Poll 置脏）。
    static void TransposeEnsure(DataTableState st) {
        if (!st.trDirty) { return; }
        st.trDirty = false;
        int rows = st.trInner != null ? st.trInner.RowCount() : 0;
        if (rows > TransposeRowCap) { rows = TransposeRowCap; }
        st.trRows = rows;
        List<DataColumn> vc = new List<DataColumn>();
        DataColumn head = new DataColumn(DataTable.T("Field", "字段"), 140);
        head.sortable = false;
        head.filterable = false;
        head.editable = false;
        vc.Add(head);
        int j = 0;
        while (j < rows) {
            DataColumn rc = new DataColumn(Convert.ToString(j + 1), 90);
            rc.sortable = true;
            rc.filterable = false;
            rc.editable = false;
            rc.align = 1;
            rc.summary = 0;
            vc.Add(rc);
            j = j + 1;
        }
        st.trViewCols = vc;
    }

    // 渲染管线使用的数据源：包装后的转置投影。
    static DataSource TransposeViewSource(DataTableState st, DataSource src) {
        if (st.trSource == null) {
            st.trSource = new TransposeDataSource(st, src);
        }
        return st.trSource;
    }
}
