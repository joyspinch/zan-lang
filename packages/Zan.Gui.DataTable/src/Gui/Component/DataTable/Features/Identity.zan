using System;

namespace Gui.Component.DataTable;

public partial class DataTable {
    // 手动刷新数据源。刷新会使派生顺序、筛选、汇总和键索引失效；
    // 行本身的业务身份由 KeyProvider 决定。
    public static void Refresh(DataTableState st) {
        DataTable.InvalidateData(st);
    }

    // 当前数据源的键快照发生变化时，重新建立查询/选择相关索引。
    public static void Refresh(DataTableState st, DataSource src) {
        DataTable.Refresh(st);
        DataTable.RebuildRowKeys(st, src);
        DataTable.PruneExpandedKeys(st, src);
    }

    // 移除已经不再存在于当前数据源的详情键。
    // 刷新/删除后不能让“幽灵”详情继续占用展开计数，
    // 也不能在后续重用同一键时意外复活旧面板。
    public static void PruneExpandedKeys(DataTableState st, DataSource src) {
        int i = 0;
        while (i < st.expandedKeys.Count) {
            if (DataTable.RowIndexOfKey(st, src, st.expandedKeys[i]) < 0) {
                st.expandedKeys.RemoveAt(i);
            } else {
                i = i + 1;
            }
        }
    }

    // 安装稳定行键提供器。传入 null 恢复兼容的临时位置键。
    public static void SetKeyProvider(DataTableState st, RowKeyProvider provider) {
        if (provider == null) { st.keyProvider = new RowKeyProvider(); }
        else { st.keyProvider = provider; }
        st.expandedByKey = provider != null;
        st.expandedRows.Clear();
        st.expandedKeys.Clear();
        DataTable.InvalidateData(st);
    }

    // 重建当前源的键快照。调用方应只在源身份改变或首次绑定时触发；
    // 列表位置不是持久身份，旧源因此只能得到临时 legacy 键。
    public static void RebuildRowKeys(DataTableState st, DataSource src) {
        st.rowKeys.Clear();
        st.diagnostics.Clear();
        Dict<string, bool> seen = new Dict<string, bool>();
        int n = src.RowCount();
        for (int row = 0; row < n; row = row + 1) {
            RowKey key = null;
            if (st.keyProvider != null) { key = st.keyProvider.Key(src, row); }
            else { key = src.GetRowKey(row); }
            if (key == null) { key = RowKey.Legacy(row); }
            string canonical = key.Canonical();
            if (seen.ContainsKey(canonical)) {
                st.diagnostics.Add(DataTable.DuplicateKeyDiagnostic(canonical, row));
            } else {
                seen[canonical] = true;
            }
            st.rowKeys.Add(key);
        }
        st.rowKeysRevision = st.dataRevision;
    }

    // 读取当前源行的稳定键。返回的 locator 仍是瞬时索引，
    // 业务代码应保存返回的 RowKey 而不是 row。
    public static RowKey RowKeyAt(DataTableState st, DataSource src, int row) {
        if (row < 0 || row >= src.RowCount()) { return null; }
        if (st.rowKeysRevision != st.dataRevision
            || st.rowKeys.Count != src.RowCount()) {
            DataTable.RebuildRowKeys(st, src);
        }
        return st.rowKeys[row];
    }

    // 以稳定键查找当前源位置；找不到返回 -1。
    public static int RowIndexOfKey(DataTableState st, DataSource src, RowKey key) {
        if (key == null) { return -1; }
        if (st.rowKeysRevision != st.dataRevision
            || st.rowKeys.Count != src.RowCount()) {
            DataTable.RebuildRowKeys(st, src);
        }
        for (int row = 0; row < st.rowKeys.Count; row = row + 1) {
            if (st.rowKeys[row].Same(key)) { return row; }
        }
        return -1;
    }

    // 清除并返回当前结构诊断；调用方可在每次绑定或刷新后读取。
    public static List<TableDiagnostic> Diagnostics(DataTableState st) {
        return st.diagnostics;
    }

    // 数据内容/行集/schema 的版本号；InvalidateData 递增，
    // 键快照以它与 rowKeysRevision 的差判断是否需要重建。
    public static int DataRevision(DataTableState st) { return st.dataRevision; }
    // 查询参数（过滤/排序/分组/汇总/分页）的版本号；
    // InvalidateQuery 与 InvalidateData 递增。
    public static int QueryRevision(DataTableState st) { return st.queryRevision; }
    // 视图几何/显示状态的版本号；三种 Invalidate* 都会递增。
    public static int ViewRevision(DataTableState st) { return st.viewRevision; }

    // 当前稳定键选择模型。旧 source-index selected 仍作为渲染兼容投影。
    public static SelectionModel Selection(DataTableState st) {
        if (st.selectionModel == null) { st.selectionModel = SelectionModel.Row(); }
        return st.selectionModel;
    }

    // 安装 key selection 模型。安装时不立即假定旧 bool 的含义，
    // 首次 SyncSelectionModel 会把当前兼容选择投影进稳定键集合。
    public static void SetSelectionModel(DataTableState st, SelectionModel model) {
        if (st == null) { return; }
        if (model == null) { model = SelectionModel.Row(); }
        st.selectionModel = model;
        st.selectionModelAuthoritative = false;
    }

    // 行是否拥有非临时、非空的稳定业务键；源为 null 或行越界
    // 时返回 false。
    public static bool HasStableKey(DataSource src, int row) {
        if (src == null || row < 0 || row >= src.RowCount()) { return false; }
        RowKey key = src.GetRowKey(row);
        return key != null && !key.IsTemporary() && key.Canonical().Length > 0;
    }

    // 带 state 的版本：优先采纳 state 级 keyProvider 的判定。
    public static bool HasStableKey(DataTableState st, DataSource src, int row) {
        if (st == null) { return DataTable.HasStableKey(src, row); }
        if (src == null || row < 0 || row >= src.RowCount()) { return false; }
        RowKey key = DataTable.CurrentRowKey(st, src, row);
        return key != null && !key.IsTemporary() && key.Canonical().Length > 0;
    }

    // 行键解析的统一入口，优先级与 RebuildRowKeys 一致：
    // 先问 state 的 keyProvider，再问源自身的 GetRowKey，
    // 都没有则 legacy。此前只有 RebuildRowKeys 走这条链，
    // HasStableKey/IsSelected/SetSelected 直接问源——状态级
    // keyProvider（`DataTable.SetKeyProvider`）因此对选择模型
    // 不生效，这里收敛到一处。
    public static RowKey CurrentRowKey(DataTableState st, DataSource src, int row) {
        if (st != null && st.keyProvider != null) {
            RowKey provided = st.keyProvider.Key(src, row);
            if (provided != null) { return provided; }
        }
        return src.GetRowKey(row);
    }

    // 将 stable-key 模型投影到旧 selected 数组；无稳定键的兼容源
    // 保留原有 bool 选择语义，不把 legacy key 误当持久身份。
    // 整表探测/投影只按行键快照的代次与行数失效——空闲帧是
    // O(1) 空转。此前每帧全表 GetRowKey：无键源永远扫不到
    // 稳定键、百万行每帧 new 上百万个 legacy RowKey，空闲帧
    // CPU 被打满（1M 行 ~420ms/帧）。
    public static void SyncSelectionModel(DataTableState st, DataSource src) {
        if (st == null || src == null || st.selectionModel == null) { return; }
        if (st.selectionSyncRevision == st.rowKeysRevision
            && st.selectionSyncRows == src.RowCount()) { return; }
        st.selectionSyncRevision = st.rowKeysRevision;
        st.selectionSyncRows = src.RowCount();
        bool anyStable = false;
        for (int row = 0; row < src.RowCount(); row = row + 1) {
            if (DataTable.HasStableKey(st, src, row)) { anyStable = true; row = src.RowCount(); }
        }
        if (!anyStable) { return; }
        while (st.selected.Count < src.RowCount()) { st.selected.Add(false); }
        if (!st.selectionModelAuthoritative) {
            st.selectionModel.Clear();
            for (int row = 0; row < src.RowCount(); row = row + 1) {
                RowKey key = DataTable.CurrentRowKey(st, src, row);
                if (st.selected[row] && key != null && !key.IsTemporary()
                    && key.Canonical().Length > 0) {
                    st.selectionModel.SelectKey(key.Canonical());
                }
            }
            st.selectionModelAuthoritative = true;
        }
        for (int row = 0; row < src.RowCount(); row = row + 1) {
            RowKey key = DataTable.CurrentRowKey(st, src, row);
            bool selected = false;
            if (key != null && !key.IsTemporary()) {
                selected = st.selectionModel.ContainsKey(key.Canonical());
            }
            st.selected[row] = selected;
        }
    }

    // 行是否处于选中状态。稳定键行走 SelectionModel；
    // 兼容源回退旧的 bool 数组。参数非法时返回 false。
    public static bool IsSelected(DataTableState st, DataSource src, int row) {
        if (st == null || src == null || row < 0 || row >= src.RowCount()) { return false; }
        RowKey key = DataTable.CurrentRowKey(st, src, row);
        if (key != null && !key.IsTemporary() && key.Canonical().Length > 0
            && st.selectionModel != null) {
            return st.selectionModel.ContainsKey(key.Canonical());
        }
        return row < st.selected.Count && st.selected[row];
    }

    // 设置行的选中状态。稳定键行写入 SelectionModel 并把模型
    // 标记为权威；兼容源只写旧 bool 数组。
    public static void SetSelected(DataTableState st, DataSource src, int row, bool value) {
        if (st == null || src == null || row < 0 || row >= src.RowCount()) { return; }
        while (st.selected.Count < src.RowCount()) { st.selected.Add(false); }
        RowKey key = DataTable.CurrentRowKey(st, src, row);
        if (key != null && !key.IsTemporary() && key.Canonical().Length > 0
            && st.selectionModel != null) {
            if (value) { st.selectionModel.SelectKey(key.Canonical()); }
            else { st.selectionModel.DeselectKey(key.Canonical()); }
            st.selectionModelAuthoritative = true;
            st.selected[row] = value;
            return;
        }
        st.selected[row] = value;
    }
}
