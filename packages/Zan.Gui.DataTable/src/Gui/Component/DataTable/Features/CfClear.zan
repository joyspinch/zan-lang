using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// 清除条件格式规则弹窗：表里可能同时存在多种规则（数据条/
// 色阶/高亮/前后规则，分布在多列），右键菜单的"清除规则"直项
// 只能整列一刀切。弹窗把当前生效的规则逐条列出（菜单槽位优先，
// 其次列工厂预设），勾选后单删或多删；勾选清除的列写入
// menuCfOff 压制工厂预设——否则每帧重建的列会把预设带回来。
public partial class DataTable {

    // 列的生效条件格式模式：显式清除 > 菜单槽位 > 列工厂预设。
    public static int CfEffectiveMode(DataTableState st, DataColumn dc, int col) {
        if (st.cfRules != null && col >= 0 && col < st.cfRules.Count) {
            if (st.cfRules[col].off) { return 0; }
            if (st.cfRules[col].mode != 0) { return st.cfRules[col].mode; }
        }
        return dc.cfMode;
    }

    // 列的生效规则的可读名（数据条 / 色阶 / 大于均值 / …）。
    public static string CfRuleLabel(DataTableState st, DataColumn dc, int col) {
        int mode = DataTable.CfEffectiveMode(st, dc, col);
        bool slot = st.cfRules != null && col >= 0 && col < st.cfRules.Count && st.cfRules[col].mode != 0;
        bool pct = slot ? st.cfRules[col].rankPct : dc.cfRankPct;
        if (mode == 1) { return DataTable.T("Data bar", "数据条"); }
        if (mode == 2) { return DataTable.T("Color scale", "色阶"); }
        if (mode == 3) { return DataTable.T("Greater than average", "大于均值"); }
        if (mode == 4) { return DataTable.T("Less than average", "小于均值"); }
        if (mode == 5) {
            return pct ? DataTable.T("Top 10 %", "前 10 %")
            : DataTable.T("Top 10 items", "前 10 项");
        }
        if (mode == 6) {
            return pct ? DataTable.T("Bottom 10 %", "后 10 %")
            : DataTable.T("Bottom 10 items", "后 10 项");
        }
        return "";
    }

    // 列的生效规则主色（色板 chip 用；槽位优先）。
    public static int CfRuleColor(DataTableState st, DataColumn dc, int col) {
        if (st.cfRules != null && col >= 0 && col < st.cfRules.Count && st.cfRules[col].mode != 0) {
            return st.cfRules[col].color;
        }
        return dc.cfColor;
    }

    // 打开弹窗：枚举全表生效规则，默认全选。没有规则时提示
    // 并且不打开。
    public static void OpenCfClear(DataTableState st, List<DataColumn> cols) {
        st.cfClearItems = new List<CfClearItem>();
        st.cfClearScroll = 0;
        for (int c = 0; c < cols.Count; c = c + 1) {
            if (DataTable.CfEffectiveMode(st, cols[c], c) != 0) {
                st.cfClearItems.Add(new CfClearItem(c, true));
            }
        }
        if (st.cfClearItems.Count == 0) {
            DataTable.Flash(st, DataTable.T("No conditional formatting rules",
            "没有条件格式规则"));
            return;
        }
        st.cfClearOpen = true;
    }

    // 应用清除：`all` 时忽略勾选整表清（全部清除按钮），否则
    // 只清勾选列。被清列写入 cfRules[col].off（压制工厂预设）并清掉
    // 菜单槽；名次缓存随 st.dirty 由下一帧 Recompute 重建。
    public static void ApplyCfClear(DataTableState st, bool all) {
        int n = 0;
        if (st.cfRules == null) { st.cfRules = new List<ColumnCfRule>(); }
        for (int i = 0; i < st.cfClearItems.Count; i = i + 1) {
            CfClearItem it = st.cfClearItems[i];
            if (!all && !it.selected) { continue; }
            int col = it.column;
            while (st.cfRules.Count <= col) {
                st.cfRules.Add(ColumnCfRule.Create());
            }
            st.cfRules[col].off = true;
            st.cfRules[col].mode = 0;
            st.cfRules[col].rankPct = false;
            n = n + 1;
        }
        st.cfClearOpen = false;
        if (n > 0) {
            st.dirty = true;
            DataTable.Flash(st, DataTable.TN("Cleared rules on {n} columns",
            n, "已清除 {n} 列的规则"));
        }
    }

}
