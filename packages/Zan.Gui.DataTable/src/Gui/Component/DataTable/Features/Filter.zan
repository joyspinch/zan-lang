using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// DataTable 模块：筛选谓词——不区分大小写的文本匹配、
// 表头筛选菜单使用的逐列文本/比较/预设筛选。
public partial class DataTable {
    // ---- 文本/批量筛选的不区分大小写字符串匹配 ----

    // ASCII 大写折叠为小写；其余码点原样。
    public static int FoldC(int cc) {
        if (cc >= 65 && cc <= 90) { return cc + 32; }
        return cc;
    }

    // hay 从 off 起是否以 needle 开头（不区分 ASCII 大小写）。
    public static bool MatchAt(string hay, string needle, int off) {
        for (int j = 0; j < needle.Length; j = j + 1) {
            char ch = hay[off + j];
            char cn = needle[j];
            if (DataTable.FoldC((int)ch) != DataTable.FoldC((int)cn)) { return false; }
        }
        return true;
    }

    // 不区分 ASCII 大小写的相等判断（长度不同直接 false）。
    public static bool EqCI(string a, string b) {
        if (a.Length != b.Length) { return false; }
        return DataTable.MatchAt(a, b, 0);
    }

    // hay 是否包含 needle（不区分 ASCII 大小写）；空 needle 恒 true。
    public static bool ContainsCI(string hay, string needle) {
        int nl = needle.Length;
        int hl = hay.Length;
        if (nl == 0) { return true; }
        if (nl > hl) { return false; }
        for (int i = 0; i <= hl - nl; i = i + 1) {
            if (DataTable.MatchAt(hay, needle, i)) { return true; }
        }
        return false;
    }

    // needle 在 hay 中首次出现（不区分 ASCII 大小写）的字节
    // 下标；无命中返回 -1。与 ContainsCI 同一匹配语义，供
    // 查找高亮定位匹配段。
    public static int IndexOfCI(string hay, string needle) {
        int nl = needle.Length;
        int hl = hay.Length;
        if (nl == 0 || nl > hl) { return 0 - 1; }
        for (int i = 0; i <= hl - nl; i = i + 1) {
            if (DataTable.MatchAt(hay, needle, i)) { return i; }
        }
        return 0 - 1;
    }

    // hay 是否以 needle 开头（不区分 ASCII 大小写）。
    public static bool StartsCI(string hay, string needle) {
        if (needle.Length > hay.Length) { return false; }
        return DataTable.MatchAt(hay, needle, 0);
    }

    // hay 是否以 needle 结尾（不区分 ASCII 大小写）。
    public static bool EndsCI(string hay, string needle) {
        int nl = needle.Length;
        int hl = hay.Length;
        if (nl > hl) { return false; }
        return DataTable.MatchAt(hay, needle, hl - nl);
    }

    // 按 mode 匹配：2 等于、3 前缀、4 后缀，其余（含 1）为包含；
    // 空查询恒 true。均不区分 ASCII 大小写。
    public static bool TextMatch(string v, string q, int mode) {
        if (q.Length == 0) { return true; }
        if (mode == 2) { return DataTable.EqCI(v, q); }
        if (mode == 3) { return DataTable.StartsCI(v, q); }
        if (mode == 4) { return DataTable.EndsCI(v, q); }
        return DataTable.ContainsCI(v, q);
    }

    // 删除最后一个字符（而非最后一个字节），
    // 确保多字节字符整体删除。
    public static string Backspace(string s) {
        if (s.Length == 0) { return ""; }
        return Text.Left(s, Text.PrevCharStart(s, s.Length));
    }

    // 单个单元格值是否通过列筛选的每个阶段。
    // 无显式列类型时的单元格筛选便捷重载：比较阶段回退为纯文本排序。
    public static bool CellPasses(ColFilter f, string v) {
        return DataTable.CellPassesCol(f, new DataColumn("", 0), v, 0);
    }

    // 单个单元格的行级筛选阶段。`today` 是当前日号，
    // 传入以确保一次遍历的每行都基于同一时刻
    // 解析日期预设。Top-N 不在此判定：它需要整个集合。
    public static bool CellPassesCol(ColFilter f, DataColumn col, string v, int today) {
        if (f.cmpMode != 0) {
            if (!DataTable.CmpPasses(f, col, v)) { return false; }
        }
        if (f.datePreset != 0) {
            if (!DataTable.PresetPasses(f, col, v, today)) { return false; }
        }
        if (f.hidden.Count > 0 && f.IsHidden(v)) { return false; }
        if (f.textQuery.Length > 0) {
            if (!DataTable.TextMatch(v, f.textQuery, f.textMode)) { return false; }
        }
        if (f.batchTerms.Count > 0) {
            bool matched = false;
            int i = 0;
            while (i < f.batchTerms.Count) {
                bool hit = false;
                if (f.batchExact) { hit = DataTable.EqCI(v, f.batchTerms[i]); }
                else { hit = DataTable.ContainsCI(v, f.batchTerms[i]); }
                if (hit) { matched = true; i = f.batchTerms.Count; }
                else { i = i + 1; }
            }
            if (f.batchKeep) {
                if (!matched) { return false; }
            } else {
                if (matched) { return false; }
            }
        }
        return true;
    }

    // ---- 比较筛选 ----

    // 按列类型编码比较类别：0 文本，1 整数，2 小数，3 日期，4 布尔。
    private static int CmpColKind(DataColumn col) {
        if (col.isBool) { return 4; }
        if (col.isDate) { return 3; }
        if (col.numeric && col.decimals > 0) { return 2; }
        if (col.numeric) { return 1; }
        return 0;
    }

    // 在 ColFilter 上缓存已解析且有序化的 cmpA/cmpB 边界，
    // 避免 100 万行筛选时每行重复解析常量阈值与比对 lo/hi 顺序。
    private static void EnsureCmpCache(ColFilter f, DataColumn col, int kind) {
        int m = f.cmpMode;
        int dOrd = col.isDate ? col.dateOrder : 0;
        if (f.cachedCmpMode == m && f.cachedCmpKind == kind && f.cachedCmpDateOrder == dOrd
            && f.cachedCmpA == f.cmpA && f.cachedCmpB == f.cmpB) {
            return;
        }
        f.cachedCmpMode = m;
        f.cachedCmpKind = kind;
        f.cachedCmpDateOrder = dOrd;
        f.cachedCmpA = f.cmpA;
        f.cachedCmpB = f.cmpB;
        bool dual = (m == 7 || m == 8);
        if (kind == 4) {
            int ba = DataTable.ParseBool(f.cmpA) ? 1 : 0;
            int bb = dual ? (DataTable.ParseBool(f.cmpB) ? 1 : 0) : ba;
            if (dual && ba > bb) { int tmp = ba; ba = bb; bb = tmp; }
            f.cachedCmpLoBool = ba;
            f.cachedCmpHiBool = bb;
        } else if (kind == 3) {
            int da = DataTable.ParseDate(f.cmpA, dOrd);
            int db = dual ? DataTable.ParseDate(f.cmpB, dOrd) : da;
            if (dual && da > db) { int tmp = da; da = db; db = tmp; }
            f.cachedCmpLoDay = da;
            f.cachedCmpHiDay = db;
        } else if (kind == 2) {
            double ra = DataTable.ParseReal(f.cmpA);
            double rb = dual ? DataTable.ParseReal(f.cmpB) : ra;
            if (dual && ra > rb) { double tmp = ra; ra = rb; rb = tmp; }
            f.cachedCmpLoReal = ra;
            f.cachedCmpHiReal = rb;
        } else if (kind == 1) {
            int ia = DataTable.ParseInt(f.cmpA);
            int ib = dual ? DataTable.ParseInt(f.cmpB) : ia;
            if (dual && ia > ib) { int tmp = ia; ia = ib; ib = tmp; }
            f.cachedCmpLoInt = ia;
            f.cachedCmpHiInt = ib;
        } else {
            string sa = f.cmpA;
            string sb = dual ? f.cmpB : sa;
            if (dual && DataTable.CompareStr(sa, sb) > 0) { string tmp = sa; sa = sb; sb = tmp; }
            f.cachedCmpLoStr = sa;
            f.cachedCmpHiStr = sb;
        }
    }

    // 用筛选的比较阶段测试单元格。排序依据来自
    // 列类型：数值列按值比较，日期列按
    // 日号；只有无类型列回退为文本。
    public static bool CmpPasses(ColFilter f, DataColumn col, string v) {
        int m = f.cmpMode;
        if (m == 9) { return DataTable.TrimSpace(v).Length == 0; }
        if (m == 10) { return DataTable.TrimSpace(v).Length > 0; }
        int kind = DataTable.CmpColKind(col);
        DataTable.EnsureCmpCache(f, col, kind);
        if (m == 7 || m == 8) {
            // 边界接受任意顺序，"between 10 and 1" 仍能
            // 表达用户想要的区间（已在 EnsureCmpCache 预排序）。
            bool inside = false;
            if (kind == 4) {
                int bv = DataTable.ParseBool(v) ? 1 : 0;
                inside = bv >= f.cachedCmpLoBool && bv <= f.cachedCmpHiBool;
            } else if (kind == 3) {
                int dv = DataTable.ParseDate(v, f.cachedCmpDateOrder);
                inside = dv >= f.cachedCmpLoDay && dv <= f.cachedCmpHiDay;
            } else if (kind == 2) {
                double rv = DataTable.ParseReal(v);
                inside = rv >= f.cachedCmpLoReal && rv <= f.cachedCmpHiReal;
            } else if (kind == 1) {
                int iv = DataTable.ParseInt(v);
                inside = iv >= f.cachedCmpLoInt && iv <= f.cachedCmpHiInt;
            } else {
                inside = DataTable.CompareStr(v, f.cachedCmpLoStr) >= 0
                      && DataTable.CompareStr(v, f.cachedCmpHiStr) <= 0;
            }
            if (m == 7) { return inside; }
            return !inside;
        }
        int ca = 0;
        if (kind == 4) {
            int bv = DataTable.ParseBool(v) ? 1 : 0;
            if (bv < f.cachedCmpLoBool) { ca = -1; }
            else if (bv > f.cachedCmpLoBool) { ca = 1; }
        } else if (kind == 3) {
            int dv = DataTable.ParseDate(v, f.cachedCmpDateOrder);
            if (dv < f.cachedCmpLoDay) { ca = -1; }
            else if (dv > f.cachedCmpLoDay) { ca = 1; }
        } else if (kind == 2) {
            double rv = DataTable.ParseReal(v);
            if (rv < f.cachedCmpLoReal) { ca = -1; }
            else if (rv > f.cachedCmpLoReal) { ca = 1; }
        } else if (kind == 1) {
            int iv = DataTable.ParseInt(v);
            if (iv < f.cachedCmpLoInt) { ca = -1; }
            else if (iv > f.cachedCmpLoInt) { ca = 1; }
        } else {
            ca = DataTable.CompareStr(v, f.cachedCmpLoStr);
        }
        if (m == 1) { return ca > 0; }
        if (m == 2) { return ca >= 0; }
        if (m == 3) { return ca < 0; }
        if (m == 4) { return ca <= 0; }
        if (m == 5) { return ca == 0; }
        if (m == 6) { return ca != 0; }
        return true;
    }

    // 日期预设覆盖的闭区间日范围，相对 `today`。
    // 预设关闭或该侧无界时返回 false；
    // lo/hi 写入双元素列表（0 = lo，1 = hi）。
    public static List<int> PresetRange(int preset, int today) {
        List<int> r = new List<int>{
            DataTable.NoDate(),
            DataTable.NoDate() };
        if (preset == 0 || today == DataTable.NoDate()) { return r; }
        DateTime t = DateTime.FromUnixSeconds((long)today * 86400L);
        int y = t.Year();
        int mo = t.Month();
        if (preset == 1) { r[0] = today; r[1] = today; }
        else if (preset == 2) { r[0] = today - 1; r[1] = today - 1; }
        else if (preset == 3) {
            int dow = DateTime.FloorMod(today + 4, 7);  // 0 = 周日
            r[0] = today - dow;
            r[1] = r[0] + 6;
        }
        else if (preset == 4) { r[0] = today - 6; r[1] = today; }
        else if (preset == 5) {
            r[0] = DateTime.DaysFromCivil(y, mo, 1);
            r[1] = r[0] + DateTime.DaysInMonth(y, mo) - 1;
        }
        else if (preset == 6) { r[0] = today - 29; r[1] = today; }
        else if (preset == 7) {
            int qs = ((mo - 1) / 3) * 3 + 1;
            r[0] = DateTime.DaysFromCivil(y, qs, 1);
            int qe = qs + 2;
            r[1] = DateTime.DaysFromCivil(y, qe, DateTime.DaysInMonth(y, qe));
        }
        else if (preset == 8) {
            r[0] = DateTime.DaysFromCivil(y, 1, 1);
            r[1] = DateTime.DaysFromCivil(y, 12, 31);
        }
        else if (preset == 9) { r[0] = DateTime.DaysFromCivil(y, 1, 1); r[1] = today; }
        else if (preset == 10) { r[1] = today - 1; }  // 过去：低侧开放
        else if (preset == 11) { r[0] = today + 1; }  // 未来：高侧开放
        return r;
    }

    // 用筛选的日期预设测试单元格。不含
    // 可识别日期的单元格永不满足预设。
    // 预解析并缓存 (datePreset, today) 的日区间，消除每行分配 List 与日期拆解。
    public static bool PresetPasses(ColFilter f, DataColumn col, string v, int today) {
        int d = DataTable.ParseDate(v, col.dateOrder);
        int noDate = DataTable.NoDate();
        if (d == noDate) { return false; }
        if (f.cachedPresetCode != f.datePreset || f.cachedPresetToday != today) {
            List<int> r = DataTable.PresetRange(f.datePreset, today);
            f.cachedPresetCode = f.datePreset;
            f.cachedPresetToday = today;
            f.cachedPresetLo = r[0];
            f.cachedPresetHi = r[1];
        }
        if (f.cachedPresetLo != noDate && d < f.cachedPresetLo) { return false; }
        if (f.cachedPresetHi != noDate && d > f.cachedPresetHi) { return false; }
        return true;
    }

    // 今天的日号，用于解析相对日期预设。
    public static int Today() {
        return (int)DateTime.FloorDivL(DateTime.UtcNow().ToUnixSeconds(), 86400);
    }

    // 单元格比较：numeric 时按 ParseInt 比较，否则按文本。
    public static int CompareCell(string a, string b, bool numeric) {
        if (numeric) {
            int va = ParseInt(a);
            int vb = ParseInt(b);
            if (va < vb) { return -1; }
            if (va > vb) { return 1; }
            return 0;
        }
        return DataTable.CompareStr(a, b);
    }

    // 感知列类型的单元格比较：小数列按 double 比较，
    // 1.5 与 1.9 不再相等，整数列保持精确的 int 路径，
    // 其余按文本比较。
    public static int CompareCellCol(DataColumn col, string a, string b) {
        if (col.isBool) {
            int ba = 0;
            int bb = 0;
            if (DataTable.ParseBool(a)) { ba = 1; }
            if (DataTable.ParseBool(b)) { bb = 1; }
            if (ba < bb) { return -1; }
            if (ba > bb) { return 1; }
            return 0;
        }
        if (col.isDate) {
            int ka = DataTable.ParseDate(a, col.dateOrder);
            int kb = DataTable.ParseDate(b, col.dateOrder);
            if (ka < kb) { return -1; }
            if (ka > kb) { return 1; }
            return 0;
        }
        if (col.numeric && col.decimals > 0) {
            double da = DataTable.ParseReal(a);
            double db = DataTable.ParseReal(b);
            if (da < db) { return -1; }
            if (da > db) { return 1; }
            return 0;
        }
        return DataTable.CompareCell(a, b, col.numeric);
    }

    // 按字号与像素宽截断文本并追加省略号；本就放得下时原样返回。
    // 截断点回退到字符边界，避免多字节字符被切半。
    public static string Truncate(string text, int fontSize, int maxW) {
        return Ellipsis.Fit(text, maxW, fontSize, "…", true);
    }

    // 语义类型对应的主题前景色：1 primary、2 info、3 success、
    // 4 warning、5 error；样式无前景色时为 0。
    public static int TypeColor(App app, int type) {
        string cls = "";
        if (type == 1) { cls = "primary"; }
        if (type == 2) { cls = "info"; }
        if (type == 3) { cls = "success"; }
        if (type == 4) { cls = "warning"; }
        if (type == 5) { cls = "error"; }
        return Style.Part(app, "datatable", "tag", "", cls, "",
                          Style.SNormal()).FgOr(0);
    }

}
