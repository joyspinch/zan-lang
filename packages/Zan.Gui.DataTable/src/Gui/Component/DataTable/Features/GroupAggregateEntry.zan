using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// 分组行逐列聚合汇总条目实体（消除 GroupRow 中 aggValues/aggTexts 平行列表反模式）。
public class GroupAggregateEntry {
    public int value;
    public string text;

    public GroupAggregateEntry(int v, string t) {
        this.value = v;
        this.text = t;
    }
}
