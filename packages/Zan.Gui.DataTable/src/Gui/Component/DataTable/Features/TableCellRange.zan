using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// 单元格多选矩形选区强类型实体（消除 multiRanges 四元整数列表反模式）。
public class TableCellRange {
    public int row0;
    public int col0;
    public int row1;
    public int col1;

    public TableCellRange(int r0, int c0, int r1, int c1) {
        this.row0 = r0;
        this.col0 = c0;
        this.row1 = r1;
        this.col1 = c1;
    }
}
