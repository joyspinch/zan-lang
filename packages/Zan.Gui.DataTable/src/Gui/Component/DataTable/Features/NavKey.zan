using System;
using Gui;
using Gui.Widget;
using Gui.Backend;

namespace Gui.Component.DataTable;

// DataTable 单元格光标键盘导航、选区加选与剪贴板快捷键（Ctrl+C/V/X/A, Ctrl+Shift+C 等）。
public partial class DataTable {
    public static bool HandleNavKey(App app, List<DataColumn> cols, DataSource src,
                             DataTableState st, List<FrameColumn> columns, int visRows,
                             int dataViewW, int pinnedW, int kc, int emods) {
        if (columns.Count == 0) { return false; }
        bool shift = Modifiers.HasShift(emods);
        bool ctrl = Modifiers.HasCtrl(emods);

        // ---- 剪贴板 / 选区快捷键 ----
        if (ctrl && shift && kc == 67) {  // Ctrl+Shift+C: 带表头复制（Excel/AG Grid 标配）
            Clipboard.SetText(DataTable.BuildText(st, cols, src, false, true));
            DataTable.Flash(st, DataTable.T("Copied with headers", "已带表头复制到剪贴板"));
            return true;
        }
        if (ctrl && kc == 67) {  // Ctrl+C
            Clipboard.SetText(DataTable.CopyText(st, cols, src));
            DataTable.Flash(st, DataTable.T("Copied to clipboard", "已复制到剪贴板"));
            return true;
        }
        if (ctrl && kc == 88) {  // Ctrl+X：复制后清空
            Clipboard.SetText(DataTable.CopyText(st, cols, src));
            int cut = DataTable.ClearRangeCells(st, cols, src);
            if (cut > 0) { DataTable.Flash(st, DataTable.TN("Cut {n} cells", cut, "已剪切 {n} 个单元格")); }
            else { DataTable.Flash(st, DataTable.T("Copied to clipboard", "已复制到剪贴板")); }
            return true;
        }
        if (ctrl && kc == 86) {  // Ctrl+V
            int n = DataTable.PasteText(st, cols, src, Clipboard.GetText());
            if (n > 0) { DataTable.Flash(st, DataTable.TN("Pasted {n} cells", n, "已粘贴 {n} 个单元格")); }
            else { DataTable.Flash(st, DataTable.T("No pasteable editable cells", "无可粘贴的可编辑单元格")); }
            return true;
        }
        if (ctrl && kc == 65) {  // Ctrl+A：全选网格
            DataTable.SelectAllRows(st, src, true);
            int firstSlot = DataTable.FirstDataSlot(st);
            int lastSlot = DataTable.LastDataSlot(st);
            if (firstSlot >= 0) {
                st.rangeR0 = firstSlot;
                st.rangeR1 = lastSlot;
                st.rangeC0 = columns[0].column;
                st.rangeC1 = columns[columns.Count - 1].column;
            }
            st.SelectionChanged.Raise();
            return true;
        }
        if (ctrl && kc == 90 && !shift) {  // Ctrl+Z
            if (DataTable.Undo(st, cols, src)) {
                DataTable.Recompute(st, cols, src);
                DataTable.Flash(st, DataTable.T("Undone", "已撤销"));
            } else {
                DataTable.Flash(st, DataTable.T("Nothing to undo", "没有可撤销的操作"));
            }
            return true;
        }
        // Shift 版必须在上面的撤销分支前排除：此前撤销分支重复
        // 两份且都不看 shift，Ctrl+Shift+Z 永远落进撤销，下面的
        // 重做分支里 (kc == 90 && shift) 成了不可达代码。
        if (ctrl && (kc == 89 || (kc == 90 && shift))) {  // Ctrl+Y / Ctrl+Shift+Z
            if (DataTable.Redo(st, cols, src)) {
                DataTable.Recompute(st, cols, src);
                DataTable.Flash(st, DataTable.T("Redone", "已重做"));
            } else {
                DataTable.Flash(st, DataTable.T("Nothing to redo", "没有可重做的操作"));
            }
            return true;
        }
        // Ctrl+D / Ctrl+R：选区内向下/向右填充（Excel 惯例）。
        if (ctrl && kc == 68 && DataTable.HasRange(st)) {
            int n = DataTable.FillDown(st, cols, src);
            if (n > 0) { DataTable.Flash(st, DataTable.TN("Filled {n} cells", n, "已填充 {n} 个单元格")); }
            else { DataTable.Flash(st, DataTable.T("Nothing to fill", "没有可填充的单元格")); }
            return true;
        }
        if (ctrl && kc == 82 && DataTable.HasRange(st)) {
            int n = DataTable.FillRight(st, cols, src);
            if (n > 0) { DataTable.Flash(st, DataTable.TN("Filled {n} cells", n, "已填充 {n} 个单元格")); }
            else { DataTable.Flash(st, DataTable.T("Nothing to fill", "没有可填充的单元格")); }
            return true;
        }
        // Ctrl+Delete 删除整行；普通 Delete 只清空单元格。
        // 破坏性操作刻意采用更不易误触的组合键。
        if (ctrl && kc == 46) {
            int killed = DataTable.DeleteSelectedRows(st, cols, src);
            if (killed == 0 && st.hitRow >= 0) {
                if (DataTable.DeleteRow(st, cols, src, st.hitRow)) { killed = 1; }
            }
            if (killed > 0) {
                DataTable.Recompute(st, cols, src);
                DataTable.Flash(st, DataTable.TN("Deleted {n} rows (Ctrl+Z to undo)", killed, "已删除 {n} 行（Ctrl+Z 撤销）"));
            } else {
                DataTable.Flash(st, DataTable.T("This data source does not support deleting rows", "该数据源不支持删除行"));
            }
            return true;
        }
        if (ctrl && kc == 45) {  // Ctrl+Insert 追加一行
            int nr = DataTable.AppendRow(st, cols, src);
            if (nr >= 0) {
                DataTable.Recompute(st, cols, src);
                DataTable.FocusRow(st, cols, src, nr);
            } else {
                DataTable.Flash(st, DataTable.T("This data source does not support adding rows", "该数据源不支持添加行"));
            }
            return true;
        }
        if ((kc == 46 || kc == 8) && !ctrl && !shift) {  // Delete / Backspace 清空选区
            int cleared = DataTable.ClearRangeCells(st, cols, src);
            if (cleared > 0) {
                DataTable.Flash(st, DataTable.TN("Cleared {n} cells", cleared, "已清空 {n} 个单元格"));
            }
            return cleared > 0;
        }
        if (kc == 32) {  // Space 勾选该行 / 选区
            int r = st.hitRow;
            if (r < 0 && st.rangeR0 >= 0) { r = DataTable.DispRowOf(st, st.rangeR0); }
            if (r >= 0) {
                if (st.rangeR0 >= 0 && st.rangeR1 >= st.rangeR0 && (st.rangeR1 > st.rangeR0 || shift)) {
                    bool anyUnchecked = false;
                    for (int s = st.rangeR0; s <= st.rangeR1; s = s + 1) {
                        int ri = DataTable.DispRowOf(st, s);
                        if (ri >= 0 && !DataTable.IsSelected(st, src, ri)) { anyUnchecked = true; break; }
                    }
                    for (int s = st.rangeR0; s <= st.rangeR1; s = s + 1) {
                        int ri = DataTable.DispRowOf(st, s);
                        if (ri >= 0) { DataTable.SetSelected(st, src, ri, anyUnchecked); }
                    }
                } else {
                    DataTable.SetSelected(st, src, r, !DataTable.IsSelected(st, src, r));
                }
                st.SelectionChanged.Raise();
                return true;
            }
        }

        if (!DataTable.IsNavKey(kc)) { return false; }
        // 即使光标已在边缘，导航键也被消费，
        // 防止方向键穿透到下层滚动页面。
        List<int> tgt = DataTable.NavTarget(st, columns, visRows, kc, emods);
        int newSlot = tgt[0];
        int newCol = tgt[1];
        if (newSlot < 0 || newCol < 0) { return true; }
        // Tab 像表单字段一样提交，即使按住 Shift
        // 也会收起选区（Shift+Tab 表示"后退"而非"扩展"）。
        bool extend = shift && kc != 9;
        if (!DataTable.MoveCursor(st, src, newSlot, newCol, extend)) { return true; }
        DataTable.ScrollSlotIntoView(st, newSlot, visRows);
        DataTable.ScrollColIntoView(st, columns, newCol, dataViewW, pinnedW);
        st.CellClick.Raise();
        return true;
    }
}
