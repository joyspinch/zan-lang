using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Gui.Backend;

namespace Gui.Component.DataTable;

// DataTable.Clipboard.zan - 单元格范围选区与剪贴板/CSV 导出文本构建
public partial class DataTable {
    // ---------- 选择 / 剪贴板 / 导出辅助 ----------

    // 两者中较小的整数。
    public static int MinI(int a, int b) { if (a < b) { return a; } return b; }
    // 两者中较大的整数。
    public static int MaxI(int a, int b) { if (a > b) { return a; } return b; }

    // 当前存在单元格范围选择时为 true。
    public static bool HasRange(DataTableState st) {
        return st.rangeR0 >= 0 && st.rangeC0 >= 0;
    }

    // 当前已有任意选中行（勾选框或范围选中）时为 true。
    public static bool HasSelection(DataTableState st) {
        for (int i = 0; i < st.selected.Count; i = i + 1) {
            if (st.selected[i]) { return true; }
        }
        return false;
    }

    // 转义单个 CSV 字段（含逗号、引号或换行时加引号，内嵌引号翻倍）。
    public static string CsvField(string v) {
        bool needsQuote = false;
        for (int i = 0; i < v.Length; i = i + 1) {
            int cc = (int)v[i];
            if (cc == 44 || cc == 34 || cc == 10 || cc == 13) { needsQuote = true; break; }
        }
        if (!needsQuote) { return v; }
        // 将内嵌引号翻倍；用 Substring 复制片段，
        // 使非 ASCII 字符完整保留（不做逐字符重建）。
        StringBuilder sb = new StringBuilder();
        sb.Append("\"");
        int start = 0;
        for (int k = 0; k < v.Length; k = k + 1) {
            if ((int)v[k] == 34) {
                sb.Append(v.Substring(start, k - start + 1));
                sb.Append("\"");
                start = k + 1;
            }
        }
        if (start < v.Length) { sb.Append(v.Substring(start, v.Length - start)); }
        sb.Append("\"");
        return sb.ToString();
    }

    // 计算剪贴板/导出应遍历的列顺序：
    // 优先沿用 VisibleOrder（遵循用户拖拽后的视觉列序并自动跳过隐藏列）；
    // 在未调用 EnsureInit 的极简单元测试场景下回退为模型列区间 [c0..c1]。
    private static List<int> ClipboardCols(DataTableState st, List<DataColumn> cols,
                                           int c0, int c1, bool rangeMode) {
        List<int> outCols = new List<int>();
        if (cols == null || cols.Count == 0) { return outCols; }
        if (c0 < 0) { c0 = 0; }
        if (c1 >= cols.Count) { c1 = cols.Count - 1; }
        if (c0 > c1) { return outCols; }
        if (st != null && st.colHidden != null && st.colHidden.Count >= cols.Count) {
            List<int> vorder = DataTable.VisibleOrder(st, cols);
            for (int i = 0; i < vorder.Count; i = i + 1) {
                int cc = vorder[i];
                if (!rangeMode || (cc >= c0 && cc <= c1)) {
                    outCols.Add(cc);
                }
            }
            return outCols;
        }
        for (int cc = c0; cc <= c1; cc = cc + 1) {
            if (st != null && st.colHidden != null && cc < st.colHidden.Count && st.colHidden[cc]) { continue; }
            outCols.Add(cc);
        }
        return outCols;
    }

    private static void AppendHeaderRow(StringBuilder sb, List<DataColumn> cols,
                                        List<int> colList, string sep, bool csv, string nl) {
        bool first = true;
        for (int i = 0; i < colList.Count; i = i + 1) {
            int cc = colList[i];
            string h = cols[cc].title;
            if (csv) { h = DataTable.CsvField(h); }
            if (!first) { sb.Append(sep); }
            first = false;
            sb.Append(h);
        }
        sb.Append(nl);
    }

    private static void AppendDataRow(StringBuilder sb, List<DataColumn> cols, DataSource src,
                                      int srcRow, List<int> colList, string sep, bool csv, string nl) {
        bool first = true;
        for (int i = 0; i < colList.Count; i = i + 1) {
            int cc = colList[i];
            string v = DataTable.CellTextRouted(cols, src, srcRow, cc);
            if (csv) { v = DataTable.CsvField(v); }
            if (!first) { sb.Append(sep); }
            first = false;
            sb.Append(v);
        }
        sb.Append(nl);
    }

    // 为当前单元格范围构建制表符分隔（剪贴板）或逗号分隔（CSV）文本块；
    // 无范围则用勾选的行，
    // 否则用整个（过滤/排序后的）视图。`csv` 决定分隔符和转义方式；
    // `withHeader` 在前面加上列标题。
    // Ctrl 追加出的多区域选区按区域顺序逐块拼接（Excel 同款：
    // 每个区域独立成段，区域间不共享行）。
    public static string BuildText(DataTableState st, List<DataColumn> cols, DataSource src, bool csv, bool withHeader) {
        string sep = csv ? "," : "\t";
        string nl = "\r\n";
        StringBuilder sb = new StringBuilder();

        // 多区域：逐区域追加文本段。
        if (DataTable.RangeCount(st) > 1) {
            int n = DataTable.RangeCount(st);
            for (int mi = 0; mi < n; mi = mi + 1) {
                int mr0 = -1; int mc0 = -1; int mr1 = -1; int mc1 = -1;
                if (!DataTable.RangeAt(st, mi, out mr0, out mc0, out mr1, out mc1)) { continue; }
                List<int> mCols = DataTable.ClipboardCols(st, cols, mc0, mc1, true);
                if (mCols.Count == 0) { continue; }
                if (withHeader) { DataTable.AppendHeaderRow(sb, cols, mCols, sep, csv, nl); }
                for (int mrr = mr0; mrr <= mr1; mrr = mrr + 1) {
                    int rowIdx = DataTable.DispRowOf(st, mrr);
                    if (rowIdx >= 0) {
                        DataTable.AppendDataRow(sb, cols, src, rowIdx, mCols, sep, csv, nl);
                    }
                }
            }
            return sb.ToString();
        }

        int c0 = 0;
        int c1 = cols.Count - 1;
        bool rangeMode = DataTable.HasRange(st);
        if (rangeMode) {
            c0 = DataTable.MinI(st.rangeC0, st.rangeC1);
            c1 = DataTable.MaxI(st.rangeC0, st.rangeC1);
            // 与多区域路径同一口径：列集可能在选取后被重建
            // （画廊每帧重建列），复制前夹到现存列，宁少不越界。
            if (c0 < 0) { c0 = 0; }
            if (c1 > cols.Count - 1) { c1 = cols.Count - 1; }
            if (c0 > c1) { return ""; }
        }

        List<int> colList = DataTable.ClipboardCols(st, cols, c0, c1, rangeMode);
        if (colList.Count == 0) { return ""; }

        if (withHeader) { DataTable.AppendHeaderRow(sb, cols, colList, sep, csv, nl); }

        if (rangeMode) {
            int r0 = DataTable.MinI(st.rangeR0, st.rangeR1);
            int r1 = DataTable.MaxI(st.rangeR0, st.rangeR1);
            for (int rr = r0; rr <= r1; rr = rr + 1) {
                int rowIdx = DataTable.DispRowOf(st, rr);
                if (rowIdx >= 0) {
                    DataTable.AppendDataRow(sb, cols, src, rowIdx, colList, sep, csv, nl);
                }
            }
            return sb.ToString();
        }

        // 否则：选中的行；未勾选任何行时用整个视图
        bool anySel = false;
        for (int s = 0; s < st.order.Count; s = s + 1) {
            if (DataTable.IsSelected(st, src, st.order[s])) { anySel = true; break; }
        }
        for (int oi = 0; oi < st.order.Count; oi = oi + 1) {
            int ri = st.order[oi];
            if (!anySel || DataTable.IsSelected(st, src, ri)) {
                DataTable.AppendDataRow(sb, cols, src, ri, colList, sep, csv, nl);
            }
        }
        return sb.ToString();
    }
}
