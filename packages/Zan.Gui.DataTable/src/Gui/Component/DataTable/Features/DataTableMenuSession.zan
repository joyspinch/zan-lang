using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// Menus retain their callbacks, so the reverse link to table state is weak.
internal class DataTableMenuSession {
    internal weak DataTableState state;
    public void RowSelected(Control sender) {
        DataTableState st = state;
        if (st == null || sender != st.ctxRetainedMenu) { return; }
        int action = st.ctxRetainedMenu.TakeAction();
        st.ctxOpen = false;
        if (action >= 0 && st.retainedTree != null) { st.retainedTree.DispatchMenuAction(false, action); }
    }
    public void HeaderSelected(Control sender) {
        DataTableState st = state;
        if (st == null || sender != st.hdrRetainedMenu) { return; }
        int action = st.hdrRetainedMenu.TakeAction();
        st.hdrCtxOpen = false;
        if (action >= 0 && st.retainedTree != null) { st.retainedTree.DispatchMenuAction(true, action); }
    }
    public void RowDismissed(Control sender) {
        DataTableState st = state;
        if (st == null || sender != st.ctxRetainedMenu) { return; }
        st.ctxOpen = false;
    }
    public void HeaderDismissed(Control sender) {
        DataTableState st = state;
        if (st == null || sender != st.hdrRetainedMenu) { return; }
        st.hdrCtxOpen = false;
    }
    public void SummarySelected(Control sender) {
        DataTableState st = state;
        if (st == null || sender != st.sumRetainedMenu) { return; }
        int action = st.sumRetainedMenu.TakeAction();
        st.sumCtxOpen = false;
        if (action >= 0 && st.retainedTree != null) { st.retainedTree.DispatchSummaryAction(action); }
    }
    public void SummaryDismissed(Control sender) {
        DataTableState st = state;
        if (st == null || sender != st.sumRetainedMenu) { return; }
        st.sumCtxOpen = false;
    }
}
