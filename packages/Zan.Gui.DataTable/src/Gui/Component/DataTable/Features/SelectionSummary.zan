using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Component.DataTable;

// Excel / DevExpress / AG Grid 风格多选单元格状态栏自动统计模型
// 当选区包含多个单元格时，自动统计格数、数值格数、和、平均值、极小极大值。
public class SelectionSummary {
    int cellCount;
    int numericCount;
    double sum;
    double average;
    double min;
    double max;
    bool hasNumeric;

    SelectionSummary() {
        this.cellCount = 0;
        this.numericCount = 0;
        this.sum = 0.0;
        this.average = 0.0;
        this.min = 0.0;
        this.max = 0.0;
        this.hasNumeric = false;
    }

    public string Format() {
        if (this.cellCount <= 0) { return ""; }
        string res = "Count: " + Convert.ToString(this.cellCount);
        if (this.hasNumeric) {
            res = res + "   Sum: " + DataTable.FormatReal(this.sum, 2)
            + "   Avg: " + DataTable.FormatReal(this.average, 2)
            + "   Min: " + DataTable.FormatReal(this.min, 2)
            + "   Max: " + DataTable.FormatReal(this.max, 2);
        }
        return res;
    }
}

public partial class DataTable {
    // 外部查询始终读取当前数据，不参与渲染调用内的快照共享。
    public static SelectionSummary ComputeSelectionSummary(DataTableState st, List<DataColumn> cols, DataSource src) {
        SelectionStatistics stats = new SelectionStatistics(false, true);
        stats.Read(st, cols, src);
        return stats.summary;
    }

    // 一次并集遍历同时累积两种口径。CellNum 是可覆写的数据源契约，
    // 不得用文本解析代替；公式逐格截断，文本统计仍读取原始 CellText。
    internal static void CollectSelectionStatistics(DataTableState st, List<DataColumn> cols, DataSource src,
    SelectionStatistics stats, bool footer, bool textSummary) {
        SelectionSummary res = stats.summary;
        if (!DataTable.HasRange(st) && !DataTable.HasMulti(st)) { return; }
        int nRanges = DataTable.RangeCount(st);
        // 预先解包所有选区边界，避免在最多 50,000 格的内层循环里反复调用 RangeAt。
        List<int> r0s = new List<int>();
        List<int> c0s = new List<int>();
        List<int> r1s = new List<int>();
        List<int> c1s = new List<int>();
        for (int qi = 0; qi < nRanges; qi = qi + 1) {
            int qr0 = -1; int qc0 = -1; int qr1 = -1; int qc1 = -1;
            if (DataTable.RangeAt(st, qi, out qr0, out qc0, out qr1, out qc1)) {
                r0s.Add(qr0);
                c0s.Add(qc0);
                r1s.Add(qr1);
                c1s.Add(qc1);
            }
        }
        int validRanges = r0s.Count;
        if (validRanges == 0) { return; }

        int dispCount = DataTable.DispCount(st);
        bool firstNum = true;
        int visited = 0;
        int scanCap = 50000;

        for (int qi = 0; qi < validRanges && visited < scanCap; qi = qi + 1) {
            int qr0 = r0s[qi];
            int qc0 = c0s[qi];
            int qr1 = r1s[qi];
            int qc1 = c1s[qi];
            int rri = qr0;
            while (rri <= qr1 && rri < dispCount && visited < scanCap) {
                if (DataTable.DispKind(st, rri) == 0) {
                    int drow = DataTable.DispRowOf(st, rri);
                    int rci = qc0;
                    while (rci <= qc1 && rci < cols.Count && visited < scanCap) {
                        if (st.colHidden != null && rci < st.colHidden.Count && st.colHidden[rci]) {
                            rci = rci + 1;
                            continue;
                        }
                        bool dup = false;
                        for (int qj = 0; qj < qi; qj = qj + 1) {
                            if (rri >= r0s[qj] && rri <= r1s[qj] && rci >= c0s[qj] && rci <= c1s[qj]) {
                                dup = true;
                                break;
                            }
                        }
                        if (!dup) {
                            visited = visited + 1;
                            if (footer && cols[rci].numeric) {
                                double frv = 0.0;
                                if (cols[rci].formula.Length > 0
                                && DataTable.FormulaTryReal(cols, src, drow, rci, out frv)) {
                                    stats.footerSum = stats.footerSum + (int)frv;
                                } else {
                                    stats.footerSum = stats.footerSum + src.CellNum(drow, rci);
                                }
                                stats.footerCount = stats.footerCount + 1;
                            }
                            if (textSummary) {
                                res.cellCount = res.cellCount + 1;
                                string val = src.CellText(drow, rci);
                                string trimmed = DataTable.TrimSpace(val);
                                if (trimmed.Length > 0 && DataTable.IsNumericStr(trimmed)) {
                                    double d = DataTable.ParseReal(trimmed);
                                    res.numericCount = res.numericCount + 1;
                                    res.sum = res.sum + d;
                                    if (firstNum) {
                                        res.min = d;
                                        res.max = d;
                                        firstNum = false;
                                        res.hasNumeric = true;
                                    } else {
                                        if (d < res.min) { res.min = d; }
                                        if (d > res.max) { res.max = d; }
                                    }
                                }
                            }
                        }
                        rci = rci + 1;
                    }
                }
                rri = rri + 1;
            }
        }

        if (res.numericCount > 0) {
            res.average = res.sum / (double)res.numericCount;
        }
    }

    public static SelectionSummary GetSelectionSummary(DataTableState st, List<DataColumn> cols, DataSource src) {
        return DataTable.ComputeSelectionSummary(st, cols, src);
    }

    public static string GetSelectionSummaryText(DataTableState st, List<DataColumn> cols, DataSource src) {
        SelectionSummary s = DataTable.ComputeSelectionSummary(st, cols, src);
        return s.Format();
    }

    public static void SetShowSelectionSummary(DataTableState st, bool enable) {
        st.showSelectionSummary = enable;
        DataTable.InvalidateView(st);
    }

    public static bool GetShowSelectionSummary(DataTableState st) {
        return st.showSelectionSummary;
    }
}
