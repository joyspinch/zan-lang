using System;
using Gui;
using Gui.Widget;
using Gui.Backend;
using Gui.Component.Chart;

namespace Gui.Component.DataTable;

// DataTable 主渲染管线：统一度量计算与顶层生命周期调度（表头/主体/页脚/交互/浮层分层解耦）。
public partial class DataTable {
    // 便捷重载：渲染内存中的 List<DataRow>（包装为 RowListSource）
    public static void Render(App app, int x, int y, int viewW, int viewH,
                       List<DataColumn> cols, List<DataRow> rows, DataTableState st) {
        RowListSource src;
        if (st != null) {
            if (st.cachedRowSource == null) {
                st.cachedRowSource = new RowListSource(rows);
            } else {
                st.cachedRowSource.rows = rows;
            }
            src = st.cachedRowSource;
        } else {
            src = new RowListSource(rows);
        }
        DataTable.RenderSource(app, x, y, viewW, viewH, cols, src, st);
    }

    // 渲染前奏：把全部每帧布局几何解析到 DataTableFrame
    public static DataTableFrame ComputeFrame(App app, int x, int y, int viewW, int viewH,
                       List<DataColumn> cols, DataSource src, DataTableState st) {
        Canvas c = app.canvas;
        Theme t = app.theme;

        // 服务端数据源在帧间交付数据
        if (src.Poll()) {
            st.dirty = true;
            app.RequestRedraw();
        }
        if (src.HasMore() && src.RowCount() == 0) { src.RequestBlock(0); }

        DataTable.EnsureInit(st, cols, src);
        DataTable.SyncBindings(st, src);
        DataTable.Recompute(st, cols, src);

        int titleRowH = t.heightMedium;
        int rowH = t.heightMedium;
        int fs = Style.FontFallback(app, "medium");
        if (st.rowH > 0) {
            rowH = app.Scale(st.rowH);
        }

        bool hasWrap = false;
        for (int wc = 0; wc < cols.Count; wc = wc + 1) {
            if (cols[wc].wrapText) { hasWrap = true; wc = cols.Count; }
        }
        if (hasWrap && src.RowCount() > 0 && st.colWidths.Count >= cols.Count) {
            int lineH2 = fs + app.Scale(4);
            int maxLines = 1;
            int totalRows = src.RowCount();
            int stride = (totalRows + 63) / 64;
            for (int srow = 0; srow < totalRows; srow = srow + stride) {
                for (int wcol = 0; wcol < cols.Count; wcol = wcol + 1) {
                    DataColumn wcol2 = cols[wcol];
                    if (!wcol2.wrapText || wcol >= st.colHidden.Count
                        || st.colHidden[wcol]) { continue; }
                    int innerW2 = app.Scale(st.colWidths[wcol]) - app.Scale(12);
                    if (innerW2 < app.Scale(16)) { continue; }
                    string txt = DataTable.CellTextRouted(cols, src, srow, wcol);
                    if (txt.Length == 0) { continue; }
                    int wlines = (Canvas.MeasureText(txt, fs) + innerW2 - 1) / innerW2;
                    if (wlines > wcol2.wrapLines) { wlines = wcol2.wrapLines; }
                    if (wlines > maxLines) { maxLines = wlines; }
                }
            }
            if (maxLines > 1) {
                int needH = maxLines * lineH2 + app.Scale(8);
                if (needH > rowH) { rowH = needH; }
            }
        }

        int bandRowH = t.heightSmall;
        int bandLevels = 0;
        int headerH = titleRowH;

        int filterPanelH = 0;
        if (st.showFilterPanel || st.pivotView) { filterPanelH = app.Scale(30); }
        if (filterPanelH > 0) {
            DataTable.RenderFilterPanel(app, x, y, viewW, filterPanelH, cols, src, st);
        }
        int groupPanelH = 0;
        if (st.showGroupPanel) { groupPanelH = app.Scale(34); }
        int hdrY = y + filterPanelH + groupPanelH;
        int panelY = y + filterPanelH;
        if (st.showGroupPanel) {
            DataTable.RenderGroupPanel(app, x, panelY, viewW, groupPanelH, cols, st,
                                       st.dragCol >= 0 && st.dragColMoved);
        }
        y = hdrY;
        viewH = viewH - filterPanelH - groupPanelH;

        int numW = 0;
        if (st.showRowNum) {
            numW = app.Scale(46);
            int needW = Canvas.MeasureText(Convert.ToString(src.RowCount()), Style.FontFallback(app, "small"))
                        + app.Scale(16);
            if (needW > numW) { numW = needW; }
        }
        int selW = 0;
        if (st.showSelect) { selW = app.Scale(40); }

        int gridColor = Style.Part(app, "datatable", "grid", "", "", "",
                                   Style.SNormal()).BgOr(0);
        int menuIconW = app.Scale(14);

        int sbGutter = app.Scale(12);
        int clipRight = x + viewW - sbGutter;

        int dataW = 0;
        for (int ci = 0; ci < st.colWidths.Count; ci = ci + 1) {
            if (!st.colHidden[ci]) { dataW = dataW + st.colWidths[ci]; }
        }
        int totalW = numW + selW + dataW;

        int availData = clipRight - (x + numW + selW);
        if (availData < app.Scale(80)) { availData = app.Scale(80); }
        st.dispW.Clear();
        for (int di = 0; di < st.colWidths.Count; di = di + 1) {
            if (st.colHidden[di]) { st.dispW.Add(0); }
            else { st.dispW.Add(st.colWidths[di]); }
        }
        int firstDataX = x + numW + selW;
        int dataViewW = clipRight - firstDataX;

        List<int> vorder = DataTable.VisibleOrder(st, cols);
        int nLeft = DataTable.LeftFrozenCount(st, vorder);
        int nRight = DataTable.RightFrozenCount(st, vorder);
        int pinnedW = DataTable.PinnedWidth(st);
        int pinnedRW = DataTable.PinnedRightWidth(st);
        int minBand = app.Scale(80);
        while (nRight > 0 && dataViewW - pinnedW - pinnedRW < minBand) {
            pinnedRW = pinnedRW - st.dispW[vorder[vorder.Count - nRight]];
            nRight = nRight - 1;
        }
        while (nLeft > 1 && dataViewW - pinnedW - pinnedRW < minBand) {
            nLeft = nLeft - 1;
            pinnedW = pinnedW - st.dispW[vorder[nLeft]];
        }

        int bandX = firstDataX + pinnedW;
        int bandW = dataViewW - pinnedW - pinnedRW;
        if (bandW < 1) { bandW = 1; }
        int bandNatW = 0;
        int bi = nLeft;
        while (bi < vorder.Count - nRight) { bandNatW = bandNatW + st.dispW[vorder[bi]]; bi = bi + 1; }
        int maxScrollX = bandNatW - bandW;
        if (maxScrollX < 0) { maxScrollX = 0; }
        if (st.scrollX > maxScrollX) { st.scrollX = maxScrollX; }
        if (st.scrollX < 0) { st.scrollX = 0; }
        int rightX = firstDataX + dataViewW - pinnedRW;

        bandLevels = DataTable.BandLevels(cols, vorder);
        headerH = titleRowH + bandLevels * bandRowH;
        int titleTop = y + bandLevels * bandRowH;

        List<FrameColumn> frameColumns = new List<FrameColumn>();
        int cxAcc = firstDataX;
        for (int bpos = 0; bpos < vorder.Count; bpos = bpos + 1) {
            if (bpos == nLeft) { cxAcc = bandX - st.scrollX; }
            if (bpos == vorder.Count - nRight) { cxAcc = rightX; }
            int ownerBand = 1;
            if (bpos < nLeft) { ownerBand = 0; }
            else if (bpos >= vorder.Count - nRight) { ownerBand = 2; }
            frameColumns.Add(new FrameColumn(vorder[bpos], cxAcc, ownerBand));
            cxAcc = cxAcc + st.dispW[vorder[bpos]];
        }
        DataTableFrame f = new DataTableFrame();
        f.y = y;
        f.viewH = viewH;
        f.numW = numW;
        f.selW = selW;
        f.gridColor = gridColor;
        f.menuIconW = menuIconW;
        f.clipRight = clipRight;
        f.firstDataX = firstDataX;
        f.dataViewW = dataViewW;
        f.titleRowH = titleRowH;
        f.rowH = rowH;
        f.fs = fs;
        f.bandRowH = bandRowH;
        f.bandLevels = bandLevels;
        f.headerH = headerH;
        f.titleTop = titleTop;
        f.pinnedW = pinnedW;
        f.pinnedRW = pinnedRW;
        f.bandX = bandX;
        f.bandW = bandW;
        f.bandNatW = bandNatW;
        f.maxScrollX = maxScrollX;
        f.rightX = rightX;
        f.panelY = panelY;
        f.groupPanelH = groupPanelH;
        f.columns = frameColumns;
        f.styles = DataTableStyleSnapshot.Create(app);
        return f;
    }

    // 核心渲染调度入口
    public static void RenderSource(App app, int x, int y, int viewW, int viewH,
                       List<DataColumn> cols, DataSource src, DataTableState st) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int evt = DataTable.ModalEvt(app, st);
        int openMenuAtStart = st.openMenu;

        // 透视视图或转置视图展开
        if (st.pivotView) {
            DataTable.PivotEnsure(st, cols, src);
            cols = DataTable.PivotViewCols(st);
            src = DataTable.PivotViewSource(st, src);
        } else if (st.transposeView) {
            DataTable.TransposeEnsure(st);
            cols = st.trViewCols;
            src = DataTable.TransposeViewSource(st, src);
        }

        // 统一解析帧几何与条带度量
        DataTableFrame f = DataTable.ComputeFrame(app, x, y, viewW, viewH, cols, src, st);
        int numW = f.numW;
        int selW = f.selW;
        int headerH = f.headerH;
        y = f.y;
        viewH = f.viewH;

        // 外边框与表格背景（复用帧样式快照）
        StyleBox sSurface = f.styles.surface;
        StyleBox sToast = f.styles.toast;
        c.FillRoundRect(x, y, viewW, viewH, t.borderRadiusMedium, sSurface.BgOr(0));
        c.DrawRoundRect(x, y, viewW, viewH, t.borderRadiusMedium, sSurface.BorderOr(0), 1);

        // 1. 渲染管道阶段：表头区域、Band行与列交互
        DataTable.RenderHeader(app, x, y, viewW, f, cols, src, st, evt, openMenuAtStart);

        // 2. 渲染管道阶段：计算主体布局并渲染数据行虚拟化视口
        DataTableBodyLayout lay = DataTable.ComputeBodyLayout(app, y, viewH, f, src, st);
        DataTable.RenderBody(app, x, y, viewW, viewH, f, lay, cols, src, st, evt);

        // 3. 渲染管道阶段：交互分发、键盘导航与指针拖拽映射
        DataTable.RenderInteraction(app, x, y, viewW, viewH, f, lay, cols, src, st, evt);

        // 4. 渲染管道阶段：固定底行、汇总行、分页器与滚动条
        DataTable.RenderFooter(app, x, y, viewW, viewH, f, lay, cols, src, st, evt);

        // 5. 顶层非模态/模态浮层（按 z-order 位于最顶层）
        if (st.findOpen) {
            DataTable.RenderFindBar(app, x, y, viewW, cols, src, st, lay.visRows);
        }
        if (st.openMenu >= 0 && st.openMenu < cols.Count) {
            DataTable.RenderMenu(app, x, y, viewW, headerH, numW, selW, cols, src, st);
        }
        if (st.ctxOpen) {
            DataTable.RenderContextMenu(app, x, y, viewW, viewH, cols, src, st);
        }
        if (st.hdrCtxOpen) {
            DataTable.RenderHeaderMenu(app, x, y, viewW, viewH, cols, src, st);
        }
        if (st.colChooserOpen) {
            DataTable.RenderColumnChooser(app, x, y, viewW, viewH, cols, src, st);
        }
        if (st.cfClearOpen) {
            DataTable.RenderCfClear(app, x, y, viewW, viewH, cols, st);
        }
        if (st.chartOpen) {
            DataTable.RenderChart(app, x, y, viewW, viewH, st);
        }
        if (st.ExportUiOpen()) {
            DataTable.RenderExportUi(app, x, y, viewW, viewH, st);
        }
        if (st.showSelectionSummary && !st.editing && (DataTable.HasRange(st) || DataTable.HasMulti(st))
            && !st.ExportUiOpen() && !st.chartOpen && !st.cfClearOpen) {
            SelectionSummary selSum = DataTable.ComputeSelectionSummary(st, cols, src);
            if (selSum.cellCount > 1) {
                string sumTxt = selSum.Format();
                if (sumTxt.Length > 0) {
                    int pfs = Style.FontFallback(app, "small");
                    int ptw = Canvas.MeasureText(sumTxt, pfs);
                    int pw = ptw + app.Scale(24);
                    int ph = app.Scale(24);
                    int px = x + viewW - pw - app.Scale(16);
                    int py = y + viewH - ph - app.Scale(12);
                    if (st.showSummary) {
                        py = py - (st.rowH > 0 ? st.rowH : t.heightMedium);
                    }
                    c.FillRoundRect(px, py, pw, ph, ph / 2, DataTable.ColorAlpha(0x1E242C, 220));
                    c.DrawRoundRect(px, py, pw, ph, ph / 2, 1, DataTable.ColorAlpha(0xFFFFFF, 50));
                    c.DrawTextCentered(px, py, pw, ph, sumTxt, 0xF0F3F6, pfs);
                }
            }
        }

        // 6. 列宽调整实时指引线与像素指示胶囊（对标 ag-Grid & Excel）
        if (st.resizeCol >= 0 && st.resizeCol < cols.Count) {
            int rzCol = st.resizeCol;
            int rzX = -1;
            for (int rzi = 0; rzi < f.columns.Count; rzi = rzi + 1) {
                FrameColumn fc = f.columns[rzi];
                if (fc.column == rzCol) {
                    rzX = fc.x + st.dispW[rzCol];
                    break;
                }
            }
            if (rzX >= x && rzX <= x + viewW) {
                StyleBox sAccent = Style.Part(app, "datatable", "accent", "", "", "", Style.SNormal());
                int guideColor = sAccent.BgOr(0x2B7DE9);
                c.FillRect(rzX - app.Scale(1), y, app.Scale(2), viewH, guideColor);
                string wTip = Convert.ToString(st.colWidths[rzCol]) + " px";
                int tipFs = Style.FontFallback(app, "small");
                int tipW = Canvas.MeasureText(wTip, tipFs) + app.Scale(12);
                int tipH = app.Scale(20);
                int tipX = rzX - tipW / 2;
                if (tipX < x + app.Scale(4)) { tipX = x + app.Scale(4); }
                if (tipX + tipW > x + viewW - app.Scale(4)) { tipX = x + viewW - tipW - app.Scale(4); }
                int tipY = y + f.groupPanelH + app.Scale(4);
                c.FillRoundRect(tipX, tipY, tipW, tipH, app.Scale(4), DataTable.ColorAlpha(0x1E242C, 230));
                c.DrawRoundRect(tipX, tipY, tipW, tipH, app.Scale(4), 1, guideColor);
                c.DrawTextCentered(tipX, tipY, tipW, tipH, wTip, 0xFFFFFF, tipFs);
            }
        }
        if (st.toastFrames > 0 && st.toast.Length > 0) {
            int tfs = Style.FontFallback(app, "small");
            int tw = Canvas.MeasureText(st.toast, tfs) + app.Scale(24);
            int th = t.heightMedium;
            int tx = x + (viewW - tw) / 2;
            int tyy = y + viewH - th - app.Scale(12);
            c.FillRoundRect(tx, tyy, tw, th, t.borderRadiusMedium, sToast.BgOr(0));
            c.DrawTextCentered(tx, tyy, tw, th, st.toast, sToast.FgOr(0), tfs);
            st.toastFrames = st.toastFrames - 1;
            if (st.toastFrames > 0) { app.RequestRedraw(); }
        }
    }
}
