using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// 单次 DataTable 渲染的每帧布局几何。由
// `DataTable.ComputeFrame`（渲染前奏）一次性计算，供所有绘制/
// 命中测试/交互阶段读取，表头/筛选行/单元格/汇总/
// 滚动条在结构上始终保持对齐。纯瞬时数据：
// 帧间不持久化任何内容（那是 `DataTableState` 的职责）。
// `columns` 是切成三个带区的可见列顺序
// [左侧冻结 | 滚动 | 右侧冻结]。所有坐标均已
// 按当前 `scrollX`、分组面板条和冻结带夹取解析完毕。
public class DataTableFrame {
    int y;  // 表头顶部（分组面板下方，若显示）
    int viewH;  // 控件高度减去分组面板条
    int numW;  // 行号栏宽度（隐藏时为 0）
    int selW;  // 选择栏宽度（隐藏时为 0）
    int gridColor;
    int menuIconW;
    int clipRight;  // 内容不得溢出的右边界
    int firstDataX;  // 第一个数据列的左边缘
    int dataViewW;
    int titleRowH;
    int rowH;
    int fs;  // 正文字号
    int bandRowH;  // 多级表头 band 行高
    int bandLevels;  // 标题上方的 band 行数
    int headerH;  // 表头总高度（bands + 标题）
    int titleTop;  // 列标题行的顶部
    int pinnedW;  // 左侧冻结带宽度
    int pinnedRW;  // 右侧冻结带宽度
    int bandX;  // 中间滚动带的左边缘
    int bandW;  // 中间滚动带的宽度
    int bandNatW;  // 中间带的自然（未滚动）宽度
    int maxScrollX;  // 水平滚动范围
    int rightX;  // 右侧冻结带的左边缘
    int panelY;  // 分组面板条顶部
    int groupPanelH;  // 分组面板条高度（隐藏时为 0）
    List<FrameColumn> columns;  // 可见列（左侧冻结|中间|右侧冻结）
}

// 表格主体与视口各分区的纵向几何布局参数
public class DataTableBodyLayout {
    public int total;
    public int summaryH;
    public int pagerH;
    public int filterRowH;
    public int statusBarH;
    public int topPinnedH;
    public int bottomPinnedH;
    public int bodyTop;
    public int bodyH;
    public int visRows;
    public int start;
}

