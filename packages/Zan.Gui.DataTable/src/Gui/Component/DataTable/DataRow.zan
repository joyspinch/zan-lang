using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

// 一行字符串单元格。先用 Create() 构建，再逐列 Push()。
class DataRow {
    List<string> cells;

    DataRow() {
        this.cells = new List<string>();
    }

    void Push(string v) {
        cells.Add(v);
    }

    string At(int i) {
        if (i < 0) { return ""; }
        if (i >= cells.Count) { return ""; }
        return cells[i];
    }

    int Count() { return this.cells.Count; }

    DataRow Copy() {
        DataRow result = new DataRow();
        for (int i = 0; i < this.cells.Count; i = i + 1) {
            result.Push(this.cells[i]);
        }
        return result;
    }

    void Set(int i, string v) {
        if (i < 0) { return; }
        while (cells.Count <= i) { cells.Add(""); }
        cells[i] = v;
    }
}
