using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Component.DataTable;

// 分组行标题自定义格式化器抽象基类 (对标 DevExpress CustomGroupDisplayText / AG Grid groupRowRendererParams)
public class GroupDisplayFormatter {
    virtual string Format(GroupRow grp, List<DataColumn> cols, DataSource src) {
        return "";
    }
}

// 零样板函数委托：允许应用直接传入匿名 lambda 格式化分组标题
public delegate string GroupDisplayFunc(GroupRow grp, List<DataColumn> cols, DataSource src);

// 基于委托的格式化器实现
public class CustomGroupDisplayFormatter : GroupDisplayFormatter {
    GroupDisplayFunc fn;

    CustomGroupDisplayFormatter(GroupDisplayFunc f) {
        this.fn = f;
    }

    override string Format(GroupRow grp, List<DataColumn> cols, DataSource src) {
        if (this.fn != null) {
            return this.fn(grp, cols, src);
        }
        return "";
    }
}
