using System;
using System.Collections.Generic;
using System.Text;

namespace Document.Pdf;

// 字节缓冲（写出 PDF 时用）。
//
// **自己拼字节而不是拼字符串**：PDF 里要写二进制标记（`%` + 4 个高位字节），
// 字符串承载不了；而且拼字符串再转字节要多一次拷贝与一次编码。
public class PdfBuffer {
    private byte[] data;
    private int count;
    private byte[] scratch;

    public PdfBuffer() {
        this.data = new byte[1024];
        this.count = 0;
        this.scratch = new byte[24];
    }

    // 当前长度（字节）。
    public int Length() { return this.count; }

    // 清空缓冲以便复用（保留底层容量）。
    public void Clear() { this.count = 0; }

    private void Ensure(int extra) {
        int need = this.count + extra;
        if (need <= this.data.Length) { return; }
        int cap = this.data.Length * 2;
        while (cap < need) { cap = cap * 2; }
        byte[] bigger = new byte[cap];
        if (this.count > 0) {
            NativeMemory.Copy((nint)bigger, (nint)this.data, this.count);
        }
        this.data = bigger;
    }

    // 追加 ASCII 文本（非 ASCII 字符按字节截断——调用方只应传 ASCII）。
    public void Ascii(string text) {
        if (text == null) { return; }
        int len = text.Length;
        if (len <= 0) { return; }
        this.Ensure(len);
        NativeMemory.PutString((nint)this.data, this.count, text, len);
        this.count = this.count + len;
    }

    // 追加字符串切片 [start, start + length) 的 ASCII/Latin-1 字节（零中间 Substring 分配）。
    public void AsciiSlice(string text, int start, int length) {
        if (text == null || length <= 0) { return; }
        if (start < 0) { start = 0; }
        int end = start + length;
        if (end > text.Length) { end = text.Length; }
        int n = end - start;
        if (n <= 0) { return; }
        this.Ensure(n);
        byte[] dst = this.data;
        int p = this.count;
        for (int i = 0; i < n; i = i + 1) {
            int c = text[start + i];
            if (c > 255) { c = 63; }
            dst[p + i] = (byte)c;
        }
        this.count = p + n;
    }

    // 直接合并另一份 PdfBuffer 的字节内容。
    public void Append(PdfBuffer other) {
        if (other == null || other.count <= 0) { return; }
        int n = other.count;
        this.Ensure(n);
        NativeMemory.Copy((nint)this.data + this.count, (nint)other.data, n);
        this.count = this.count + n;
    }

    // 追加十进制整数（零中间字符串分配）。
    public void AppendInt(int value) {
        this.AppendLong((long)value);
    }

    // 追加 64 位十进制整数（零堆分配，正确处理 long.MinValue）。
    public void AppendLong(long value) {
        if (value == -9223372036854775807L - 1L) {
            this.Ascii("-9223372036854775808");
            return;
        }
        this.Ensure(21);
        byte[] dst = this.data;
        int p = this.count;
        if (value == 0L) {
            dst[p] = 48;
            this.count = p + 1;
            return;
        }
        long v = value;
        if (v < 0L) {
            dst[p] = 45;
            p = p + 1;
            v = -v;
        }
        byte[] digits = this.scratch;
        int n = 0;
        while (v > 0L) {
            long q = v / 10L;
            digits[n] = (byte)(48 + (int)(v - q * 10L));
            v = q;
            n = n + 1;
        }
        for (int i = n - 1; i >= 0; i = i - 1) {
            dst[p] = digits[i];
            p = p + 1;
        }
        this.count = p;
    }

    // 追加定长 10 位十进制整数（左侧补 '0'，用于 xref 偏移表，零堆分配）。
    public void AppendPad10(int value) {
        this.Ensure(10);
        int v = value < 0 ? 0 : value;
        byte[] dst = this.data;
        int p = this.count;
        for (int i = 9; i >= 0; i = i - 1) {
            int q = v / 10;
            dst[p + i] = (byte)(48 + (v - q * 10));
            v = q;
        }
        this.count = p + 10;
    }

    // 追加一个字节。
    public void Raw(byte value) {
        if (this.count >= this.data.Length) { this.Ensure(1); }
        this.data[this.count] = value;
        this.count = this.count + 1;
    }

    // 追加一个数（PDF 数字格式，最多三位小数，零堆分配；拒绝 NaN/Infinity 防产出损坏 PDF）。
    public void Number(double value) {
        if (value != value || (value - value) != 0.0) {
            throw new PdfException(PdfError.InvalidArgument, "PdfBuffer.Number: non-finite number (NaN/Infinity)");
        }
        this.Ensure(28);
        if (value < 0.0) {
            this.data[this.count] = 45;
            this.count = this.count + 1;
            value = -value;
        }
        double intPart = Math.Floor(value);
        long whole = (long)intPart;
        long thousandths = (long)((value - intPart) * 1000.0 + 0.5);
        if (thousandths >= 1000L) {
            whole = whole + 1L;
            thousandths = thousandths - 1000L;
        }
        this.AppendLong(whole);
        if (thousandths == 0L) { return; }
        byte[] dst = this.data;
        int p = this.count;
        dst[p] = 46;
        p = p + 1;
        int t = (int)thousandths;
        int d1 = t / 100;
        int rem = t - d1 * 100;
        int d2 = rem / 10;
        int d3 = rem - d2 * 10;
        dst[p] = (byte)(48 + d1);
        p = p + 1;
        if (d2 != 0 || d3 != 0) {
            dst[p] = (byte)(48 + d2);
            p = p + 1;
            if (d3 != 0) {
                dst[p] = (byte)(48 + d3);
                p = p + 1;
            }
        }
        this.count = p;
    }

    // 取出内容。
    public byte[] ToArray() {
        byte[] out2 = new byte[this.count];
        if (this.count > 0) {
            NativeMemory.Copy((nint)out2, (nint)this.data, this.count);
        }
        return out2;
    }

    // 数字转 PDF 字面量（不依赖 locale 的定点格式）。
    //
    // **为什么不用 `Convert.ToString`**：不同 locale 的小数点与千分位不同，
    // 写进 PDF 会让阅读器解析出错误的坐标。
    public static string Format(double value) {
        if (value != value || (value - value) != 0.0) {
            throw new PdfException(PdfError.InvalidArgument, "PdfBuffer.Format: non-finite number (NaN/Infinity)");
        }
        if (value < 0.0) {
            return "-" + PdfBuffer.Format(-value);
        }
        double intPart = Math.Floor(value);
        long whole = (long)intPart;
        long thousandths = (long)((value - intPart) * 1000.0 + 0.5);
        if (thousandths >= 1000L) {
            whole = whole + 1L;
            thousandths = thousandths - 1000L;
        }
        if (thousandths == 0L) { return whole.ToString(); }
        StringBuilder sb = new StringBuilder();
        sb.Append(whole);
        sb.Append(".");
        int d1 = (int)(thousandths / 100L);
        int d2 = (int)((thousandths / 10L) % 10L);
        int d3 = (int)(thousandths % 10L);
        sb.Append(d1);
        if (d2 != 0 || d3 != 0) {
            sb.Append(d2);
            if (d3 != 0) {
                sb.Append(d3);
            }
        }
        return sb.ToString();
    }
}
