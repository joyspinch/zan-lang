using System;
using System.Collections.Generic;
using System.Text;

namespace Document.Pdf;

// 字节缓冲（写出 PDF 时用）。
//
// **自己拼字节而不是拼字符串**：PDF 里要写二进制标记（`%` + 4 个高位字节），
// 字符串承载不了；而且拼字符串再转字节要多一次拷贝与一次编码。
public class PdfBuffer {
    private byte[] data;
    private int count;
    private byte[] scratch;

    public PdfBuffer() {
        this.data = new byte[1024];
        this.count = 0;
        this.scratch = new byte[24];
    }

    // 当前长度（字节）。
    public int Length() { return this.count; }

    // 清空缓冲以便复用（保留底层容量）。
    public void Clear() { this.count = 0; }

    private void Ensure(int extra) {
        if (extra <= 0) { return; }
        long need = (long)this.count + (long)extra;
        if (need > 2147483591L) {
            throw new InvalidOperationException("PdfBuffer capacity overflow");
        }
        if (need <= (long)this.data.Length) { return; }
        long cap = (long)this.data.Length;
        if (cap < 1024L) { cap = 1024L; }
        while (cap < need) {
            cap = cap * 2L;
            if (cap > 2147483591L) { cap = 2147483591L; break; }
        }
        byte[] bigger = new byte[(int)cap];
        if (this.count > 0) {
            NativeMemory.Copy((nint)bigger, (nint)this.data, this.count);
        }
        this.data = bigger;
    }

    // 追加 ASCII 文本（非 ASCII 字符按字节截断——调用方只应传 ASCII）。
    public void Ascii(string text) {
        if (text == null) { return; }
        int len = text.Length;
        if (len <= 0) { return; }
        int p = this.count;
        if (p + len > this.data.Length) { this.Ensure(len); }
        NativeMemory.Copy((nint)this.data + (nint)p, (nint)text, len);
        this.count = p + len;
    }

    // 追加字符串切片 [start, start + length) 的 ASCII/Latin-1 字节（零中间 Substring 分配）。
    public void AsciiSlice(string text, int start, int length) {
        if (text == null || length <= 0) { return; }
        if (start < 0) { start = 0; }
        int tlen = text.Length;
        int end = start + length;
        if (end > tlen) { end = tlen; }
        int n = end - start;
        if (n <= 0) { return; }
        int p = this.count;
        if (p + n > this.data.Length) { this.Ensure(n); }
        Span<byte> src = new Span<byte>((nint)text, tlen);
        Span<byte> dst = new Span<byte>((nint)this.data, this.data.Length);
        for (int i = 0; i < n; i = i + 1) {
            dst[p + i] = src[start + i];
        }
        this.count = p + n;
    }

    // 直接合并另一份 PdfBuffer 的字节内容。
    public void Append(PdfBuffer other) {
        if (other == null || other.count <= 0) { return; }
        int n = other.count;
        int p = this.count;
        if (p + n > this.data.Length) { this.Ensure(n); }
        NativeMemory.Copy((nint)this.data + (nint)p, (nint)other.data, n);
        this.count = p + n;
    }

    // 追加十进制整数（零中间字符串分配）。
    public void AppendInt(int value) {
        this.AppendLong((long)value);
    }

    // 追加 64 位十进制整数（零堆分配，正确处理 long.MinValue）。
    public void AppendLong(long value) {
        if (value == -9223372036854775807L - 1L) {
            this.Ascii("-9223372036854775808");
            return;
        }
        int p = this.count;
        if (p + 21 > this.data.Length) { this.Ensure(21); }
        Span<byte> dst = new Span<byte>((nint)this.data, this.data.Length);
        if (value == 0L) {
            dst[p] = 48;
            this.count = p + 1;
            return;
        }
        long v = value;
        if (v < 0L) {
            dst[p] = 45;
            p = p + 1;
            v = -v;
        }
        Span<byte> digits = new Span<byte>((nint)this.scratch, 24);
        int n = 0;
        while (v > 0L) {
            long q = v / 10L;
            digits[n] = (byte)(48 + (int)(v - q * 10L));
            v = q;
            n = n + 1;
        }
        for (int i = n - 1; i >= 0; i = i - 1) {
            dst[p] = digits[i];
            p = p + 1;
        }
        this.count = p;
    }

    // 追加定长 10 位十进制整数（左侧补 '0'，用于 xref 偏移表，零堆分配）。
    public void AppendPad10(int value) {
        int p = this.count;
        if (p + 10 > this.data.Length) { this.Ensure(10); }
        int v = value < 0 ? 0 : value;
        Span<byte> dst = new Span<byte>((nint)this.data, this.data.Length);
        for (int i = 9; i >= 0; i = i - 1) {
            int q = v / 10;
            dst[p + i] = (byte)(48 + (v - q * 10));
            v = q;
        }
        this.count = p + 10;
    }

    // 追加一个字节。
    public void Raw(byte value) {
        int p = this.count;
        if (p >= this.data.Length) { this.Ensure(1); }
        Span<byte> dst = new Span<byte>((nint)this.data, this.data.Length);
        dst[p] = value;
        this.count = p + 1;
    }

    // 批量直写切片 [start, end) 的转义 PDF 字面量字节流；遇到不可编码字节时返回其索引，全部成功返回 -1。
    internal int WritePdfEscapedFast(string text, int start, int end) {
        int slen = end - start;
        if (slen <= 0) { return -1; }
        // 每 ASCII 字节最多写 2 字节，每 2 字节 UTF-8 Latin-1 写 4 字节，故 slen * 2 为严格上界。
        int worst = slen * 2;
        int p = this.count;
        if (p + worst > this.data.Length) { this.Ensure(worst); }
        Span<byte> src = new Span<byte>((nint)text, text.Length);
        Span<byte> dst = new Span<byte>((nint)this.data, this.data.Length);
        int i = start;
        while (i < end) {
            int b0 = src[i];
            if (b0 < 128) {
                if (b0 >= 32 && b0 <= 126) {
                    if (b0 == 92 || b0 == 40 || b0 == 41) {
                        dst[p] = 92;
                        dst[p + 1] = (byte)b0;
                        p = p + 2;
                    } else {
                        dst[p] = (byte)b0;
                        p = p + 1;
                    }
                    i = i + 1;
                } else {
                    this.count = p;
                    return i;
                }
            } else if ((b0 == 194 || b0 == 195) && i + 1 < end) {
                int b1 = src[i + 1];
                if ((b1 & 192) != 128) {
                    this.count = p;
                    return i;
                }
                int cp = ((b0 & 31) << 6) | (b1 & 63);
                if (cp < 160 || cp > 255) {
                    this.count = p;
                    return i;
                }
                dst[p] = 92;
                dst[p + 1] = (byte)(48 + ((cp >> 6) & 7));
                dst[p + 2] = (byte)(48 + ((cp >> 3) & 7));
                dst[p + 3] = (byte)(48 + (cp & 7));
                p = p + 4;
                i = i + 2;
            } else {
                this.count = p;
                return i;
            }
        }
        this.count = p;
        return -1;
    }

    // 追加一个数（PDF 数字格式，最多三位小数，单次 Ensure + Span 直写零堆分配；拒绝 NaN/Infinity/超范围值防产出损坏 PDF）。
    public void Number(double value) {
        if (value != value || (value - value) != 0.0 || value >= 9223372036854774784.0 || value <= -9223372036854774784.0) {
            throw new PdfException(PdfError.InvalidArgument, "PdfBuffer.Number: non-finite or out-of-range number");
        }
        int p = this.count;
        if (p + 28 > this.data.Length) { this.Ensure(28); }
        Span<byte> dst = new Span<byte>((nint)this.data, this.data.Length);
        if (value < 0.0) {
            dst[p] = 45;
            p = p + 1;
            value = -value;
        }
        double intPart = Math.Floor(value);
        long whole = (long)intPart;
        long thousandths = (long)((value - intPart) * 1000.0 + 0.5);
        if (thousandths >= 1000L) {
            whole = whole + 1L;
            thousandths = thousandths - 1000L;
        }
        if (whole == 0L) {
            dst[p] = 48;
            p = p + 1;
        } else if (whole < 1000L) {
            int w = (int)whole;
            if (w >= 100) {
                int h = w / 100;
                int r = w - h * 100;
                int t1 = r / 10;
                dst[p] = (byte)(48 + h);
                dst[p + 1] = (byte)(48 + t1);
                dst[p + 2] = (byte)(48 + (r - t1 * 10));
                p = p + 3;
            } else if (w >= 10) {
                int t1 = w / 10;
                dst[p] = (byte)(48 + t1);
                dst[p + 1] = (byte)(48 + (w - t1 * 10));
                p = p + 2;
            } else {
                dst[p] = (byte)(48 + w);
                p = p + 1;
            }
        } else {
            Span<byte> digits = new Span<byte>((nint)this.scratch, 24);
            long v = whole;
            int dn = 0;
            while (v > 0L) {
                long q = v / 10L;
                digits[dn] = (byte)(48 + (int)(v - q * 10L));
                v = q;
                dn = dn + 1;
            }
            for (int i = dn - 1; i >= 0; i = i - 1) {
                dst[p] = digits[i];
                p = p + 1;
            }
        }
        if (thousandths == 0L) {
            this.count = p;
            return;
        }
        dst[p] = 46;
        p = p + 1;
        int t = (int)thousandths;
        int d1 = t / 100;
        int rem = t - d1 * 100;
        int d2 = rem / 10;
        int d3 = rem - d2 * 10;
        dst[p] = (byte)(48 + d1);
        p = p + 1;
        if (d2 != 0 || d3 != 0) {
            dst[p] = (byte)(48 + d2);
            p = p + 1;
            if (d3 != 0) {
                dst[p] = (byte)(48 + d3);
                p = p + 1;
            }
        }
        this.count = p;
    }

    // 取出内容。
    public byte[] ToArray() {
        byte[] out2 = new byte[this.count];
        if (this.count > 0) {
            NativeMemory.Copy((nint)out2, (nint)this.data, this.count);
        }
        return out2;
    }

    // 数字转 PDF 字面量（不依赖 locale 的定点格式）。
    //
    // **为什么不用 `Convert.ToString`**：不同 locale 的小数点与千分位不同，
    // 写进 PDF 会让阅读器解析出错误的坐标。
    public static string Format(double value) {
        if (value != value || (value - value) != 0.0 || value >= 9223372036854774784.0 || value <= -9223372036854774784.0) {
            throw new PdfException(PdfError.InvalidArgument, "PdfBuffer.Format: non-finite or out-of-range number");
        }
        if (value < 0.0) {
            return "-" + PdfBuffer.Format(-value);
        }
        double intPart = Math.Floor(value);
        long whole = (long)intPart;
        long thousandths = (long)((value - intPart) * 1000.0 + 0.5);
        if (thousandths >= 1000L) {
            whole = whole + 1L;
            thousandths = thousandths - 1000L;
        }
        if (thousandths == 0L) { return whole.ToString(); }
        StringBuilder sb = new StringBuilder();
        sb.Append(whole);
        sb.Append(".");
        int d1 = (int)(thousandths / 100L);
        int d2 = (int)((thousandths / 10L) % 10L);
        int d3 = (int)(thousandths % 10L);
        sb.Append(d1);
        if (d2 != 0 || d3 != 0) {
            sb.Append(d2);
            if (d3 != 0) {
                sb.Append(d3);
            }
        }
        return sb.ToString();
    }
}
