using System;
using System.Collections.Generic;
using System.Text;

namespace Document.Pdf;

// PDF 写出器（能力层）：把文档翻译成 PDF 1.4 字节流。
//
// **结构**：Catalog → Pages → 每页的 Page 对象 + 内容流；五个标准 14 字体
// 对象由所有页共享（字体是全局资源，不必每页一份）。
//
// **坐标翻转换只做一次**：页面用左上角原点、y 向下；PDF 用左下角原点、
// y 向上。翻在写内容流时做（`H - y`），其余地方都按页面的坐标想。
//
// **文本只走 ASCII 与 Latin-1**：标准 14 字体没有 CJK 字形。要中文得嵌
// 字体（TrueType 子集 + 编码表），那是另一件事——本包遇到编不出来的字符
// **当场报错**，不写出一份读者打不开或显示成方框的文档。
public static class PdfWriter {
    // 写出整个文档（全流程直写 PdfBuffer，消除循环字符串拼接与二次拷贝）。
    public static byte[] Write(PdfDocument doc) {
        if (doc == null) {
            throw new PdfException(PdfError.InvalidArgument, "PdfWriter.Write: the document must not be null");
        }
        int pageCount = doc.PageCount();
        if (pageCount == 0) {
            throw new PdfException(PdfError.InvalidState, "PdfWriter.Write: the document has no pages");
        }

        int catalogObj = 1;
        int pagesObj = 2;
        int infoObj = 3;
        int firstFontObj = 4;
        int fontCount = 5;
        int firstPageObj = firstFontObj + fontCount;
        int totalObjs = firstPageObj + pageCount * 2 - 1;

        PdfBuffer buf = new PdfBuffer();
        PdfBuffer pageContentBuf = new PdfBuffer();
        int[] offsets = new int[totalObjs];

        // 文件头 + 二进制标记（让阅读器认出这是二进制传输而非文本）。
        buf.Ascii("%PDF-1.4\n");
        buf.Raw(37); buf.Raw(226); buf.Raw(227); buf.Raw(207); buf.Raw(211);
        buf.Ascii("\n");

        // Catalog。
        offsets[catalogObj - 1] = buf.Length();
        buf.Ascii("1 0 obj\n<< /Type /Catalog /Pages 2 0 R >>\nendobj\n");

        // Pages 树。
        offsets[pagesObj - 1] = buf.Length();
        buf.Ascii("2 0 obj\n<< /Type /Pages /Kids [");
        for (int i = 0; i < pageCount; i = i + 1) {
            if (i > 0) { buf.Raw(32); }
            buf.AppendInt(firstPageObj + i * 2);
            buf.Ascii(" 0 R");
        }
        buf.Ascii("] /Count ");
        buf.AppendInt(pageCount);
        buf.Ascii(" >>\nendobj\n");

        // 文档信息。
        offsets[infoObj - 1] = buf.Length();
        buf.Ascii("3 0 obj\n");
        PdfWriter.WriteInfoBody(buf, doc);
        buf.Ascii("\nendobj\n");

        // 五个标准 14 字体。
        string[] baseFonts = new string[] {
            "Helvetica", "Helvetica-Bold", "Times-Roman", "Times-Bold", "Courier"
        };
        for (int i = 0; i < fontCount; i = i + 1) {
            int objNum = firstFontObj + i;
            offsets[objNum - 1] = buf.Length();
            buf.AppendInt(objNum);
            buf.Ascii(" 0 obj\n<< /Type /Font /Subtype /Type1 /BaseFont /");
            buf.Ascii(baseFonts[i]);
            buf.Ascii(" /Encoding /WinAnsiEncoding >>\nendobj\n");
        }

        // 每页：Page 对象 + 内容流。
        string resources = "<< /Font << /F1 4 0 R /F2 5 0 R /F3 6 0 R /F4 7 0 R /F5 8 0 R >> >>";
        for (int i = 0; i < pageCount; i = i + 1) {
            PdfPage page = doc.Page(i);
            pageContentBuf.Clear();
            PdfWriter.WriteContentOf(pageContentBuf, page);

            int pageObj = firstPageObj + i * 2;
            int contentObj = pageObj + 1;
            offsets[pageObj - 1] = buf.Length();
            buf.AppendInt(pageObj);
            buf.Ascii(" 0 obj\n<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ");
            buf.Number(page.Size.Width);
            buf.Raw(32);
            buf.Number(page.Size.Height);
            buf.Ascii("] /Resources ");
            buf.Ascii(resources);
            buf.Ascii(" /Contents ");
            buf.AppendInt(contentObj);
            buf.Ascii(" 0 R >>\nendobj\n");

            offsets[contentObj - 1] = buf.Length();
            buf.AppendInt(contentObj);
            buf.Ascii(" 0 obj\n<< /Length ");
            buf.AppendInt(pageContentBuf.Length());
            buf.Ascii(" >>\nstream\n");
            buf.Append(pageContentBuf);
            buf.Ascii("endstream\nendobj\n");
        }

        // 交叉引用表。
        int xrefOffset = buf.Length();
        buf.Ascii("xref\n0 ");
        buf.AppendInt(totalObjs + 1);
        buf.Ascii("\n0000000000 65535 f \n");
        for (int i = 0; i < totalObjs; i = i + 1) {
            buf.AppendPad10(offsets[i]);
            buf.Ascii(" 00000 n \n");
        }
        buf.Ascii("trailer\n<< /Size ");
        buf.AppendInt(totalObjs + 1);
        buf.Ascii(" /Root 1 0 R /Info 3 0 R >>\nstartxref\n");
        buf.AppendInt(xrefOffset);
        buf.Ascii("\n%%EOF\n");

        return buf.ToArray();
    }

    // 文档信息字典。
    private static void WriteInfoBody(PdfBuffer buf, PdfDocument doc) {
        buf.Ascii("<< /Producer (Zan.Pdf)");
        PdfWriter.WriteInfoEntry(buf, "/Title", doc.Title);
        PdfWriter.WriteInfoEntry(buf, "/Author", doc.Author);
        PdfWriter.WriteInfoEntry(buf, "/Subject", doc.Subject);
        PdfWriter.WriteInfoEntry(buf, "/Keywords", doc.Keywords);
        PdfWriter.WriteInfoEntry(buf, "/Creator", doc.Creator);
        buf.Ascii(" >>");
    }

    // 一个信息字段（空值不写）。
    private static void WriteInfoEntry(PdfBuffer buf, string key, string value) {
        if (value == null || value.Length == 0) { return; }
        buf.Raw(32);
        buf.Ascii(key);
        buf.Ascii(" (");
        PdfWriter.WriteEscapedText(buf, value);
        buf.Raw(41);
    }

    // 页面内容流（PDF 操作符，直写 PdfBuffer）。
    private static void WriteContentOf(PdfBuffer buf, PdfPage page) {
        double height = page.Size.Height;
        int gCount = page.GraphicsCount();
        for (int i = 0; i < gCount; i = i + 1) {
            PdfGraphics g = page.At(i);
            if (g == null) { continue; }
            if (g.Kind == PdfGraphicsKind.Line) {
                buf.Number(g.LineWidth);
                buf.Ascii(" w\n");
                PdfWriter.WriteColorOp(buf, g.StrokeColor, "RG");
                buf.Number(g.X1);
                buf.Raw(32);
                buf.Number(height - g.Y1);
                buf.Ascii(" m\n");
                buf.Number(g.X2);
                buf.Raw(32);
                buf.Number(height - g.Y2);
                buf.Ascii(" l\nS\n");
            } else if (g.Kind == PdfGraphicsKind.RectFill) {
                PdfWriter.WriteColorOp(buf, g.Color, "rg");
                PdfWriter.WriteRectOp(buf, g, height);
                buf.Ascii("f\n");
            } else if (g.Kind == PdfGraphicsKind.RectStroke) {
                buf.Number(g.LineWidth);
                buf.Ascii(" w\n");
                PdfWriter.WriteColorOp(buf, g.StrokeColor, "RG");
                PdfWriter.WriteRectOp(buf, g, height);
                buf.Ascii("S\n");
            } else if (g.Kind == PdfGraphicsKind.RectFillStroke) {
                buf.Number(g.LineWidth);
                buf.Ascii(" w\n");
                PdfWriter.WriteColorOp(buf, g.Color, "rg");
                PdfWriter.WriteColorOp(buf, g.StrokeColor, "RG");
                PdfWriter.WriteRectOp(buf, g, height);
                buf.Ascii("B\n");
            } else if (g.Kind == PdfGraphicsKind.Text) {
                PdfWriter.WriteTextOps(buf, g, height);
            }
        }
    }

    // 颜色操作符。
    private static void WriteColorOp(PdfBuffer buf, PdfColor color, string op) {
        buf.Number(color.R);
        buf.Raw(32);
        buf.Number(color.G);
        buf.Raw(32);
        buf.Number(color.B);
        buf.Raw(32);
        buf.Ascii(op);
        buf.Raw(10);
    }

    // 矩形操作符（PDF 的矩形用左下角）。
    private static void WriteRectOp(PdfBuffer buf, PdfGraphics g, double pageHeight) {
        buf.Number(g.X);
        buf.Raw(32);
        buf.Number(pageHeight - g.Y - g.H);
        buf.Raw(32);
        buf.Number(g.W);
        buf.Raw(32);
        buf.Number(g.H);
        buf.Ascii(" re\n");
    }

    // 文本操作符（多行按行切片定位，零整行中间字符串分配）。
    private static void WriteTextOps(PdfBuffer buf, PdfGraphics g, double pageHeight) {
        string text = g.Text;
        if (text == null) { return; }
        double lineHeight = g.Font.LineHeight(g.FontSize);
        double ascent = g.Font.AscentAt(g.FontSize);
        int textLen = text.Length;
        Span<byte> tb = textLen > 0 ? new Span<byte>((nint)text, textLen) : new Span<byte>((nint)0, 0);
        int start = 0;
        int lineIdx = 0;
        while (true) {
            int eol = -1;
            int nextStart = textLen;
            for (int k = start; k < textLen; k = k + 1) {
                int ch = tb[k];
                if (ch <= 13) {
                    if (ch == 10) {
                        eol = k;
                        nextStart = k + 1;
                        break;
                    }
                    if (ch == 13) {
                        eol = k;
                        nextStart = (k + 1 < textLen && tb[k + 1] == 10) ? (k + 2) : (k + 1);
                        break;
                    }
                }
            }
            int end = eol < 0 ? textLen : eol;
            double x = g.X;
            if (g.Align != PdfTextAlign.Left) {
                double width = g.Font.MeasureSlice(text, start, end, g.FontSize);
                if (g.Align == PdfTextAlign.Center) {
                    x = g.X + (g.W - width) * 0.5;
                } else if (g.Align == PdfTextAlign.Right) {
                    x = g.X + g.W - width;
                }
            }
            double top = g.Y + lineIdx * lineHeight;
            double baseline = pageHeight - (top + ascent);
            buf.Ascii("BT\n/");
            buf.Ascii(g.Font.ResourceName);
            buf.Raw(32);
            buf.Number(g.FontSize);
            buf.Ascii(" Tf\n");
            PdfWriter.WriteColorOp(buf, g.Color, "rg");
            buf.Ascii("1 0 0 1 ");
            buf.Number(x);
            buf.Raw(32);
            buf.Number(baseline);
            buf.Ascii(" Tm\n(");
            PdfWriter.WriteEscapedTextSlice(buf, text, start, end);
            buf.Ascii(") Tj\nET\n");
            if (eol < 0) { break; }
            start = nextStart;
            lineIdx = lineIdx + 1;
        }
    }

    private static string HexCode(int v) {
        string digits = "0123456789ABCDEF";
        if (v < 0) { v = 0; }
        if (v < 256) {
            return digits.Substring((v >> 4) & 15, 1) + digits.Substring(v & 15, 1);
        }
        StringBuilder sb = new StringBuilder();
        int x = v;
        while (x > 0) {
            sb.Append(digits.Substring(x & 15, 1));
            x = x >> 4;
        }
        string rev = sb.ToString();
        StringBuilder outSb = new StringBuilder(rev.Length);
        for (int i = rev.Length - 1; i >= 0; i = i - 1) {
            outSb.Append(rev.Substring(i, 1));
        }
        return outSb.ToString();
    }

    // 直写转义后的 PDF 字面量字节流（零字符级 Substring/Concat 分配）。
    private static void WriteEscapedText(PdfBuffer buf, string text) {
        if (text == null) { return; }
        PdfWriter.WriteEscapedTextSlice(buf, text, 0, text.Length);
    }

    // 直写切片 [start, end) 的转义 PDF 字面量字节流（批量 Span 直写，仅异常字节走报错路径）。
    private static void WriteEscapedTextSlice(PdfBuffer buf, string text, int start, int end) {
        int badIdx = buf.WritePdfEscapedFast(text, start, end);
        if (badIdx < 0) { return; }
        int b0 = text[badIdx] & 255;
        if (b0 < 128) {
            throw new PdfException(PdfError.UnencodableCharacter,
                "PdfWriter: the character 0x" + PdfWriter.HexCode(b0) +
                " cannot be encoded with the standard 14 fonts");
        }
        if ((b0 == 194 || b0 == 195) && badIdx + 1 < end) {
            int b1 = text[badIdx + 1] & 255;
            if ((b1 & 192) != 128) {
                throw new PdfException(PdfError.UnencodableCharacter,
                    "PdfWriter: invalid UTF-8 byte sequence");
            }
            int cp = ((b0 & 31) << 6) | (b1 & 63);
            throw new PdfException(PdfError.UnencodableCharacter,
                "PdfWriter: the character 0x" + PdfWriter.HexCode(cp) +
                " cannot be encoded with the standard 14 fonts");
        }
        throw new PdfException(PdfError.UnencodableCharacter,
            "PdfWriter: the character 0x" + PdfWriter.HexCode(b0) +
            " cannot be encoded with the standard 14 fonts");
    }

    // 转义 PDF 字面量字符串里的特殊字符（公开兼容 API，按 UTF-8 码点解码）。
    //
    // `\`、`(`、`)` 必须转义；Latin-1（U+00A0..U+00FF）走八进制转义（WinAnsi 高位区）。
    // 编码不出来的字符（控制字符、U+007F..U+009F、> U+00FF）当场报错。
    public static string EscapeText(string text) {
        if (text == null) { return ""; }
        int len = text.Length;
        if (len == 0) { return ""; }
        nint tp = (nint)text;
        Span<byte> tb = new Span<byte>(tp, len);
        int i = 0;
        while (i < len) {
            int b0 = tb[i];
            if (b0 >= 32 && b0 <= 126 && b0 != 92 && b0 != 40 && b0 != 41) {
                i = i + 1;
                continue;
            }
            break;
        }
        if (i == len) { return text; }
        StringBuilder sb = new StringBuilder(len + 8);
        int runStart = 0;
        while (i < len) {
            int b0 = tb[i];
            if (b0 >= 32 && b0 <= 126 && b0 != 92 && b0 != 40 && b0 != 41) {
                i = i + 1;
                continue;
            }
            if (i > runStart) {
                sb.Append(new StringView(tp + (nint)runStart, i - runStart));
            }
            if (b0 == 92) {
                sb.Append("\\\\");
                i = i + 1;
            } else if (b0 == 40) {
                sb.Append("\\(");
                i = i + 1;
            } else if (b0 == 41) {
                sb.Append("\\)");
                i = i + 1;
            } else if ((b0 == 194 || b0 == 195) && i + 1 < len) {
                int b1 = tb[i + 1];
                if ((b1 & 192) != 128) {
                    throw new PdfException(PdfError.UnencodableCharacter,
                        "PdfWriter: invalid UTF-8 byte sequence");
                }
                int cp = ((b0 & 31) << 6) | (b1 & 63);
                if (cp < 160 || cp > 255) {
                    throw new PdfException(PdfError.UnencodableCharacter,
                        "PdfWriter: the character 0x" + PdfWriter.HexCode(cp) +
                        " cannot be encoded with the standard 14 fonts");
                }
                sb.Append("\\");
                sb.Append((cp >> 6) & 7);
                sb.Append((cp >> 3) & 7);
                sb.Append(cp & 7);
                i = i + 2;
            } else {
                throw new PdfException(PdfError.UnencodableCharacter,
                    "PdfWriter: the character 0x" + PdfWriter.HexCode(b0) +
                    " cannot be encoded with the standard 14 fonts");
            }
            runStart = i;
        }
        if (runStart == 0) { return text; }
        if (runStart < len) {
            sb.Append(text.Substring(runStart, len - runStart));
        }
        return sb.ToString();
    }
}
