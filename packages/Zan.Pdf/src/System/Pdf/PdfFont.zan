using System;
using System.Collections.Generic;

namespace System.Pdf;

// 字体（标准 14 字体的一部分）。
//
// **只用标准 14 字体，不嵌字体**：PDF 的标准 14 字体（Helvetica / Times /
// Courier × 常规/粗体）是阅读器自带的，**不用嵌字体文件**——文档小、没有
// 授权问题、任何阅读器都能开。代价是只能用这几种西文字体，且宽度是
// 内置的固定值（不是字体的真实度量，但对标准 14 字体而言就是真实度量）。
//
// **宽度表单位是 1/1000 em**：字符宽度 × 字号 / 1000 = 实际点数。
// 这也是 PDF 与 PostScript 的惯例。
public class PdfFont {
    // 资源名（页面资源字典里的键，如 `/F1`）。
    public string ResourceName;
    // 基础字体名（写进 `/BaseFont`）。
    public string BaseFont;
    // 上伸部（1/1000 em）：基线到字顶。
    public int Ascent;
    // 下伸部（1/1000 em，正数）：基线到字底。
    public int Descent;
    // 是否等宽。
    public bool Monospace;

    // 字符宽度表（码位 32..126）。
    private int[] widths;

    private PdfFont(string resourceName, string baseFont, int ascent, int descent, bool monospace, int[] widths) {
        this.ResourceName = resourceName;
        this.BaseFont = baseFont;
        this.Ascent = ascent;
        this.Descent = descent;
        this.Monospace = monospace;
        this.widths = widths;
    }

    // Helvetica（无衬线，常规）。
    public static PdfFont Helvetica() {
        return new PdfFont("F1", "Helvetica", 718, 207, false, PdfMetrics.Parse(
            "278,278,355,556,556,889,667,191,333,333,389,584,278,333,278,278," +
            "556,556,556,556,556,556,556,556,556,556,278,278,584,584,584,556," +
            "1015,667,667,722,722,667,611,778,722,278,500,667,556,833,722,778," +
            "667,778,722,667,611,722,667,944,667,667,611,278,278,278,469,556," +
            "333,556,556,500,556,556,278,556,556,222,222,500,222,833,556,556," +
            "556,556,333,500,278,556,500,722,500,500,500,334,260,334,584"));
    }

    // Helvetica 粗体。
    public static PdfFont HelveticaBold() {
        return new PdfFont("F2", "Helvetica-Bold", 718, 207, false, PdfMetrics.Parse(
            "278,333,474,556,556,889,722,238,333,333,389,584,278,333,278,278," +
            "556,556,556,556,556,556,556,556,556,556,333,333,584,584,584,611," +
            "975,722,722,722,722,667,611,778,722,278,556,722,611,833,722,778," +
            "667,778,722,667,611,722,667,944,667,667,611,333,278,333,584,556," +
            "333,556,611,556,611,556,333,611,611,278,278,556,278,889,611,611," +
            "611,611,389,556,333,611,556,778,556,556,500,389,280,389,584"));
    }

    // Times（衬线，常规）。
    public static PdfFont Times() {
        return new PdfFont("F3", "Times-Roman", 683, 217, false, PdfMetrics.Parse(
            "250,333,408,500,500,833,778,180,333,333,500,564,250,333,250,278," +
            "500,500,500,500,500,500,500,500,500,500,278,278,564,564,564,444," +
            "921,722,667,667,722,611,556,722,722,333,389,722,611,889,722,722," +
            "556,722,667,556,611,722,722,944,722,722,611,333,278,333,469,500," +
            "333,444,500,444,500,444,333,500,500,278,278,500,278,778,500,500," +
            "500,500,333,389,278,500,500,722,500,500,444,480,200,480,541"));
    }

    // Times 粗体。
    public static PdfFont TimesBold() {
        return new PdfFont("F4", "Times-Bold", 683, 217, false, PdfMetrics.Parse(
            "250,333,555,500,500,1000,833,278,333,333,500,570,250,333,250,278," +
            "500,500,500,500,500,500,500,500,500,500,333,333,570,570,570,500," +
            "930,722,667,722,722,667,611,778,778,389,500,778,667,944,722,778," +
            "611,778,722,556,667,722,722,1000,722,722,667,333,278,333,581,500," +
            "333,500,556,444,556,444,333,500,556,278,333,556,278,833,556,500," +
            "556,556,444,389,333,556,500,722,500,500,444,394,220,394,520"));
    }

    // Courier（等宽，常规；宽度恒为 600）。
    public static PdfFont Courier() {
        return new PdfFont("F5", "Courier", 629, 157, true, PdfMetrics.Fixed(600));
    }

    // 字符宽度（1/1000 em）。未收录的码位按 500 估。
    public int WidthOf(int code) {
        if (this.widths == null) { return 500; }
        int index = code - 32;
        if (index < 0 || index >= this.widths.Length) { return 500; }
        return this.widths[index];
    }

    // 文本宽度（点）。
    public double Measure(string text, double fontSize) {
        if (text == null) { return 0.0; }
        double total = 0.0;
        for (int i = 0; i < text.Length; i = i + 1) {
            total = total + this.WidthOf(text[i]);
        }
        return total * fontSize / 1000.0;
    }

    // 上伸部（点）。
    public double AscentAt(double fontSize) {
        return this.Ascent * fontSize / 1000.0;
    }

    // 下伸部（点，正数）。
    public double DescentAt(double fontSize) {
        return this.Descent * fontSize / 1000.0;
    }

    // 行高（点）：上伸 + 下伸 + 一点行距。
    public double LineHeight(double fontSize) {
        return (this.Ascent + this.Descent) * fontSize / 1000.0 * 1.2;
    }
}

// 字体度量工具（内部用）。
public static class PdfMetrics {
    // 解析逗号分隔的宽度表。
    public static int[] Parse(string csv) {
        List<int> values = new List<int>();
        int i = 0;
        int n = csv.Length;
        while (i < n) {
            int start = i;
            while (i < n && csv[i] != 44) { i = i + 1; }
            string part = csv.Substring(start, i - start);
            values.Add(PdfMetrics.ToInt(part));
            if (i < n) { i = i + 1; }
        }
        int[] result = new int[values.Count];
        for (int k = 0; k < values.Count; k = k + 1) {
            result[k] = values[k];
        }
        return result;
    }

    // 定长表（等宽字体）。
    public static int[] Fixed(int width) {
        int[] result = new int[95];
        for (int i = 0; i < 95; i = i + 1) {
            result[i] = width;
        }
        return result;
    }

    // 文本转整数（容错：非法字符按 0）。
    private static int ToInt(string text) {
        if (text == null) { return 0; }
        int value = 0;
        bool any = false;
        for (int i = 0; i < text.Length; i = i + 1) {
            int c = text[i];
            if (c < 48 || c > 57) { continue; }
            value = value * 10 + (c - 48);
            any = true;
        }
        if (!any) { return 0; }
        return value;
    }
}
