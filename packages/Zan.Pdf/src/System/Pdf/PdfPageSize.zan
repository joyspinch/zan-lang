using System;

namespace System.Pdf;

// 页面尺寸（单位：点，1 点 = 1/72 英寸）。
//
// **为什么自己定尺寸而不做成枚举**：A4 / Letter / Legal 之外，自定义尺寸很常见
//（票据、标签、画布导出），枚举只能把"自定义"塞进一个特例里。
public class PdfPageSize {
    // 宽度（点）。
    public double Width;
    // 高度（点）。
    public double Height;

    public PdfPageSize(double width, double height) {
        if (width <= 0.0 || height <= 0.0) {
            throw new PdfException(PdfError.InvalidArgument,
                "PdfPageSize: the page size must be positive");
        }
        this.Width = width;
        this.Height = height;
    }

    // A4（595.28 × 841.89 点）。
    public static PdfPageSize A4() {
        return new PdfPageSize(595.28, 841.89);
    }

    // Letter（612 × 792 点）。
    public static PdfPageSize Letter() {
        return new PdfPageSize(612.0, 792.0);
    }

    // Legal（612 × 1008 点）。
    public static PdfPageSize Legal() {
        return new PdfPageSize(612.0, 1008.0);
    }

    // 自定义尺寸。
    public static PdfPageSize Custom(double width, double height) {
        return new PdfPageSize(width, height);
    }
}
