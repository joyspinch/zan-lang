using System;
using System.Collections.Generic;
using System.IO;

namespace System.Pdf;

// PDF 文档（门面层）。
//
// **零配置可用**：`new PdfDocument()` → `AddPage()` → 在页上画 → `Build()`。
//
// **坐标**：左上角原点，y 向下（写进 PDF 时自动翻成左下角）。
//
// **只生成不解析**：本包是"排版并写出 PDF"的，不是 PDF 阅读器。要读 PDF
// 里的文本与表格是另一件事（需要内容流解析与字体映射），见 README 的
// 已知边界。
//
// **并发**：非线程安全（文档是逐页构建的状态）。
public class PdfDocument {
    // 文档标题（写进文档信息字典）。
    public string Title;
    // 作者。
    public string Author;
    // 主题。
    public string Subject;
    // 关键词。
    public string Keywords;
    // 生成程序名。
    public string Creator;

    private List<PdfPage> pages;

    public PdfDocument() {
        this.pages = new List<PdfPage>();
        this.Title = "";
        this.Author = "";
        this.Subject = "";
        this.Keywords = "";
        this.Creator = "Zan.Pdf";
    }

    // 加一页（A4）。
    public PdfPage AddPage() {
        return this.AddPage(PdfPageSize.A4());
    }

    // 加一页（指定尺寸）。
    public PdfPage AddPage(PdfPageSize size) {
        PdfPage page = new PdfPage(size);
        this.pages.Add(page);
        return page;
    }

    // 页数。
    public int PageCount() { return this.pages.Count; }

    // 取某页（越界报错）。
    public PdfPage Page(int index) {
        if (index < 0 || index >= this.pages.Count) {
            throw new PdfException(PdfError.InvalidArgument,
                "PdfDocument.Page: page index out of range: " + index.ToString());
        }
        return this.pages[index];
    }

    // 序列化成 PDF 字节流。
    public byte[] Build() {
        return PdfWriter.Write(this);
    }

    // 写文件。
    public void Save(string path) {
        if (path == null || path == "") {
            throw new PdfException(PdfError.InvalidArgument, "PdfDocument.Save: the path must not be empty");
        }
        File.WriteAllBytes(path, this.Build());
    }
}
