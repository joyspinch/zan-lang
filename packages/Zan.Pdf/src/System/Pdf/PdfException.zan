using System;

namespace System.Pdf;

// PDF 文档构建失败的原因（可区分的错误码）。
public enum PdfError {
    // 参数非法（页尺寸为负、字体为 null、内容超限等）。
    InvalidArgument = 0,
    // 字体无法编码该字符（标准 14 字体只覆盖 ASCII 与 Latin-1）。
    UnencodableCharacter = 1,
    // 文档状态不对（还没加页就构建等）。
    InvalidState = 2,
}

// PDF 构建错误。
//
// **为什么一律抛异常**：PDF 是"要么能打开、要么打不开"的格式——半个文档、
// 错位的 xref 表，读者软件的表现是从第一页开始全部乱掉，而不是提示你
// "第 3 页的字体名写错了"。所以构建期必须把问题全部挡掉，错误要带上下文
// （哪个页、哪个字符、什么编码）。
public class PdfException : Exception {
    // 错误码。
    public PdfError error;

    public PdfException(PdfError error, string message) : base(message) {
        this.error = error;
    }
}
