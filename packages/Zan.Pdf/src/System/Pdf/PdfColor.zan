using System;

namespace System.Pdf;

// 颜色（RGB，各分量 0..1）。
//
// **用 double 不用 byte**：绘制时经常要按比例调暗 / 加透明度中间量，
// 用 0..255 的 byte 每调一次都要来回转换。
public struct PdfColor {
    // 红色分量（0..1）。
    public double R;
    // 绿色分量（0..1）。
    public double G;
    // 蓝色分量（0..1）。
    public double B;

    public PdfColor(double r, double g, double b) {
        this.R = r;
        this.G = g;
        this.B = b;
    }

    // 黑色。
    public static PdfColor Black {
        get { return new PdfColor(0.0, 0.0, 0.0); }
    }

    // 白色。
    public static PdfColor White {
        get { return new PdfColor(1.0, 1.0, 1.0); }
    }

    // 灰色（0..1，0.5 为中灰）。
    public static PdfColor Gray(double level) {
        double v = level;
        if (v < 0.0) { v = 0.0; }
        if (v > 1.0) { v = 1.0; }
        return new PdfColor(v, v, v);
    }

    // 从 0..255 的分量构造。
    public static PdfColor FromRgb(int r, int g, int b) {
        return new PdfColor(
            PdfColor.Clamp01(r / 255.0),
            PdfColor.Clamp01(g / 255.0),
            PdfColor.Clamp01(b / 255.0));
    }

    // 十六进制颜色（`#rrggbb`，大小写皆可）。
    public static PdfColor FromHex(string hex) {
        if (hex == null || hex.Length != 7 || hex[0] != 35) {
            throw new PdfException(PdfError.InvalidArgument,
                "PdfColor.FromHex: expected #rrggbb, got '" + (hex != null ? hex : "null") + "'");
        }
        return PdfColor.FromRgb(
            PdfColor.HexByte(hex.Substring(1, 2)),
            PdfColor.HexByte(hex.Substring(3, 2)),
            PdfColor.HexByte(hex.Substring(5, 2)));
    }

    // 两个颜色按比例混合（t=0 取 a，t=1 取 b）。
    public static PdfColor Mix(PdfColor a, PdfColor b, double t) {
        double k = t;
        if (k < 0.0) { k = 0.0; }
        if (k > 1.0) { k = 1.0; }
        return new PdfColor(
            a.R + (b.R - a.R) * k,
            a.G + (b.G - a.G) * k,
            a.B + (b.B - a.B) * k);
    }

    private static double Clamp01(double v) {
        if (v < 0.0) { return 0.0; }
        if (v > 1.0) { return 1.0; }
        return v;
    }

    private static int HexByte(string pair) {
        int value = 0;
        for (int i = 0; i < pair.Length; i = i + 1) {
            int c = pair[i];
            int digit = 0;
            if (c >= 48 && c <= 57) { digit = c - 48; }
            else if (c >= 97 && c <= 102) { digit = c - 97 + 10; }
            else if (c >= 65 && c <= 70) { digit = c - 65 + 10; }
            else {
                throw new PdfException(PdfError.InvalidArgument,
                    "PdfColor.FromHex: bad hex digit in '" + pair + "'");
            }
            value = value * 16 + digit;
        }
        return value;
    }
}
