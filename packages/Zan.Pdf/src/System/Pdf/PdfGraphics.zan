using System;

namespace System.Pdf;

// 绘图指令的种类。
public enum PdfGraphicsKind {
    // 线段。
    Line = 0,
    // 填充矩形。
    RectFill = 1,
    // 描边矩形。
    RectStroke = 2,
    // 填充 + 描边矩形。
    RectFillStroke = 3,
    // 文本。
    Text = 4,
}

// 一条绘图指令（原语层）。
//
// **坐标是左上角原点、y 向下**：这是排版引擎的惯用坐标（和 HTML 画布一样），
// 写进 PDF 时再翻成 PDF 的左下角原点。翻坐标的活儿只在一个地方做。
//
// **值对象**：画完就不再改，页面持有指令列表，写出时按顺序翻译成 PDF 内容流。
public class PdfGraphics {
    // 指令种类。
    public PdfGraphicsKind Kind;

    // 线段起点（x1, y1）与终点（x2, y2）。
    public double X1;
    public double Y1;
    public double X2;
    public double Y2;
    // 矩形左上角（x, y）与尺寸（w, h）。
    public double X;
    public double Y;
    public double W;
    public double H;

    // 填充色 / 描边色。
    public PdfColor Color;
    public PdfColor StrokeColor;
    // 线宽（点）。
    public double LineWidth;

    // 文本内容 / 字体 / 字号 / 对齐。
    public string Text;
    public PdfFont Font;
    public double FontSize;
    public PdfTextAlign Align;

    public PdfGraphics(PdfGraphicsKind kind) {
        this.Kind = kind;
        this.Color = PdfColor.Black;
        this.StrokeColor = PdfColor.Black;
        this.LineWidth = 1.0;
        this.Text = "";
        this.Font = PdfFont.Helvetica();
        this.FontSize = 12.0;
        this.Align = PdfTextAlign.Left;
    }
}
