using System;
using System.Collections.Generic;

namespace System.Pdf;

// 一页：尺寸 + 绘图指令列表。
//
// **零配置可用**：`new PdfPage()` 是 A4；`new PdfPage(PdfPageSize.A4())` 指定尺寸。
//
// **坐标系**：左上角原点，y 向下（x 向右，y 向下）。文字的 y 是**行顶**，
// 不是基线——排版时按行顶对齐更直观。
//
// **并发**：非线程安全（页面是逐页写、逐页读的状态）。
public class PdfPage {
    // 页面尺寸。
    public PdfPageSize Size;

    private List<PdfGraphics> graphics;

    // A4 页面。
    public PdfPage() : this(PdfPageSize.A4()) { }

    // 指定尺寸的页面。
    public PdfPage(PdfPageSize size) {
        if (size == null) {
            throw new PdfException(PdfError.InvalidArgument, "PdfPage: the page size must not be null");
        }
        this.Size = size;
        this.graphics = new List<PdfGraphics>();
    }

    // 指令条数。
    public int GraphicsCount() { return this.graphics.Count; }

    // 取指令（越界返回 null）。
    public PdfGraphics At(int index) {
        if (index < 0 || index >= this.graphics.Count) { return null; }
        return this.graphics[index];
    }

    // 画一条线。
    public void DrawLine(double x1, double y1, double x2, double y2, PdfColor color, double lineWidth) {
        PdfGraphics g = new PdfGraphics(PdfGraphicsKind.Line);
        g.X1 = x1; g.Y1 = y1; g.X2 = x2; g.Y2 = y2;
        g.Color = color;
        g.StrokeColor = color;
        g.LineWidth = lineWidth;
        this.graphics.Add(g);
    }

    // 画一个矩形（只填充）。
    public void DrawRect(double x, double y, double w, double h, PdfColor fill) {
        PdfGraphics g = new PdfGraphics(PdfGraphicsKind.RectFill);
        g.X = x; g.Y = y; g.W = w; g.H = h;
        g.Color = fill;
        this.graphics.Add(g);
    }

    // 画一个矩形（只描边）。
    public void DrawRectOutline(double x, double y, double w, double h, PdfColor stroke, double lineWidth) {
        PdfGraphics g = new PdfGraphics(PdfGraphicsKind.RectStroke);
        g.X = x; g.Y = y; g.W = w; g.H = h;
        g.StrokeColor = stroke;
        g.Color = stroke;
        g.LineWidth = lineWidth;
        this.graphics.Add(g);
    }

    // 画一个矩形（填充 + 描边）。
    public void DrawRectBoth(double x, double y, double w, double h,
                              PdfColor fill, PdfColor stroke, double lineWidth) {
        PdfGraphics g = new PdfGraphics(PdfGraphicsKind.RectFillStroke);
        g.X = x; g.Y = y; g.W = w; g.H = h;
        g.Color = fill;
        g.StrokeColor = stroke;
        g.LineWidth = lineWidth;
        this.graphics.Add(g);
    }

    // 画一行文本（y 是行顶；文本里的 `\n` 会拆成多行）。
    public void DrawText(double x, double y, string text, PdfFont font, double fontSize, PdfColor color) {
        this.DrawTextInBox(x, y, 0.0, text, PdfTextAlign.Left, font, fontSize, color);
    }

    // 在一个宽 boxWidth 的盒子里画文本（按对齐方式摆放）。
    //
    // `boxWidth` 为 0 时表示"不限定宽度"，等价于左对齐。
    public void DrawTextInBox(double x, double y, double boxWidth, string text,
                               PdfTextAlign align, PdfFont font, double fontSize, PdfColor color) {
        if (font == null) {
            throw new PdfException(PdfError.InvalidArgument, "PdfPage.DrawText: the font must not be null");
        }
        if (fontSize <= 0.0) {
            throw new PdfException(PdfError.InvalidArgument,
                "PdfPage.DrawText: the font size must be positive");
        }
        PdfGraphics g = new PdfGraphics(PdfGraphicsKind.Text);
        g.X = x;
        g.Y = y;
        g.W = boxWidth;
        g.Text = text != null ? text : "";
        g.Font = font;
        g.FontSize = fontSize;
        g.Align = align;
        g.Color = color;
        this.graphics.Add(g);
    }

    // 文本宽度（点）。
    public double MeasureText(string text, PdfFont font, double fontSize) {
        if (text == null || font == null) { return 0.0; }
        return font.Measure(text, fontSize);
    }

    // 多行文本的总高度（点）。
    public double MeasureTextHeight(string text, PdfFont font, double fontSize) {
        if (font == null) { return 0.0; }
        int lines = PdfPage.CountLines(text);
        return font.LineHeight(fontSize) * lines;
    }

    // 文本行数（`\n` 分隔；空串算一行）。
    public static int CountLines(string text) {
        if (text == null || text.Length == 0) { return 1; }
        int lines = 1;
        for (int i = 0; i < text.Length; i = i + 1) {
            if (text[i] == 10) { lines = lines + 1; }
        }
        return lines;
    }
}
