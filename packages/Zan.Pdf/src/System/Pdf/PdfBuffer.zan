using System;
using System.Collections.Generic;

namespace System.Pdf;

// 字节缓冲（写出 PDF 时用）。
//
// **自己拼字节而不是拼字符串**：PDF 里要写二进制标记（`%` + 4 个高位字节），
// 字符串承载不了；而且拼字符串再转字节要多一次拷贝与一次编码。
public class PdfBuffer {
    private List<byte> bytes;

    public PdfBuffer() {
        this.bytes = new List<byte>();
    }

    // 当前长度（字节）。
    public int Length() { return this.bytes.Count; }

    // 追加 ASCII 文本（非 ASCII 字符按字节截断——调用方只应传 ASCII）。
    public void Ascii(string text) {
        if (text == null) { return; }
        for (int i = 0; i < text.Length; i = i + 1) {
            int c = text[i];
            if (c > 255) { c = 63; }
            this.bytes.Add((byte)c);
        }
    }

    // 追加一个字节。
    public void Raw(byte value) {
        this.bytes.Add(value);
    }

    // 追加一个数（PDF 数字格式，最多三位小数）。
    public void Number(double value) {
        this.Ascii(PdfBuffer.Format(value));
    }

    // 取出内容。
    public byte[] ToArray() {
        return this.bytes.ToArray();
    }

    // 数字转 PDF 字面量（不依赖 locale 的定点格式）。
    //
    // **为什么不用 `Convert.ToString`**：不同 locale 的小数点与千分位不同，
    // 写进 PDF 会让阅读器解析出错误的坐标。
    public static string Format(double value) {
        if (value < 0.0) {
            return "-" + PdfBuffer.Format(-value);
        }
        double intPart = Math.Floor(value);
        double frac = value - intPart;
        long whole = (long)intPart;
        long thousandths = (long)(frac * 1000.0 + 0.5);
        if (thousandths >= 1000L) {
            whole = whole + 1L;
            thousandths = thousandths - 1000L;
        }
        string head = whole.ToString();
        if (thousandths == 0L) { return head; }
        string tail = thousandths.ToString();
        while (tail.Length < 3) { tail = "0" + tail; }
        while (tail.EndsWith("0")) { tail = tail.Substring(0, tail.Length - 1); }
        return head + "." + tail;
    }
}
