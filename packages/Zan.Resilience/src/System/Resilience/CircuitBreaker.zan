using System;
using System.Threading;

namespace System.Resilience;

// 熔断器状态机三态。
public class CircuitBreaker : IDisposable {
    public CircuitState state;
    public int failureThreshold;
    public long breakDurationMs;
    public int successThreshold;
    public int consecutiveFailures;
    public int consecutiveSuccesses;
    public long trippedAtMs;
    public nint mtx;
    private object gate;
    private bool disposed;
    private int halfOpenInFlight;
    private int generation;

    public CircuitBreaker(int failureThreshold, long breakDurationMs, int successThreshold) {
        this.failureThreshold = failureThreshold > 0 ? failureThreshold : 5;
        this.breakDurationMs = breakDurationMs > 0 ? breakDurationMs : 5000;
        this.successThreshold = successThreshold > 0 ? successThreshold : 2;
        this.state = CircuitState.Closed;
        this.consecutiveFailures = 0;
        this.consecutiveSuccesses = 0;
        this.trippedAtMs = 0;
        this.halfOpenInFlight = 0;
        this.generation = 1;
        this.mtx = 0;
        this.gate = new object();
        this.disposed = false;
    }

    public void Dispose() {
        lock (this.gate) {
            this.disposed = true;
        }
    }

    public static CircuitBreaker CreateDefault() {
        return new CircuitBreaker(5, 5000, 2);
    }

    // 获取当前生效的熔断状态（如果处于 Open 且熔断时间已过，自动推进至 HalfOpen）。
    public CircuitState State() {
        lock (this.gate) {
            if (this.disposed) { return this.state; }
            this.UpdateStateInternal();
            return this.state;
        }
    }

    // 检查是否允许放行调用（Open 状态快速失败拦截，杜绝雪崩）。
    public bool CanExecute() {
        int ignored = 0;
        return this.CanExecute(out ignored);
    }

    // 带状态代数令牌的放行检查：配合 RecordSuccess(token)/RecordFailure(token) 屏蔽跨周期迟到回调。
    public bool CanExecute(out int token) {
        token = 0;
        lock (this.gate) {
            if (this.disposed) { return false; }
            this.UpdateStateInternal();
            if (this.state == CircuitState.Closed) {
                token = this.generation;
                return true;
            }
            if (this.state == CircuitState.HalfOpen) {
                // 限制半开态并发探测数不超过剩余所需成功阈值，防止恢复瞬间惊群击穿。
                if (this.halfOpenInFlight + this.consecutiveSuccesses < this.successThreshold) {
                    this.halfOpenInFlight = this.halfOpenInFlight + 1;
                    token = this.generation;
                    return true;
                }
                return false;
            }
            return false; // Open 状态快速失败
        }
    }

    // 记录一次成功调用。
    public void RecordSuccess() {
        this.RecordSuccessInternal(-1);
    }

    // 按代数令牌记录成功调用；过期周期的迟到回报将被忽略。
    public void RecordSuccess(int token) {
        this.RecordSuccessInternal(token);
    }

    private int NextGeneration() {
        int next = (this.generation + 1) & 0x7FFFFFFF;
        return next == 0 ? 1 : next;
    }

    private void RecordSuccessInternal(int token) {
        lock (this.gate) {
            if (this.disposed) { return; }
            if (token >= 0 && token != this.generation) { return; }
            if (this.state == CircuitState.HalfOpen) {
                if (this.halfOpenInFlight > 0) {
                    this.halfOpenInFlight = this.halfOpenInFlight - 1;
                }
                this.consecutiveSuccesses = this.consecutiveSuccesses + 1;
                if (this.consecutiveSuccesses >= this.successThreshold) {
                    // 半开探测通过，自动愈合恢复至 Closed
                    this.state = CircuitState.Closed;
                    this.consecutiveFailures = 0;
                    this.consecutiveSuccesses = 0;
                    this.trippedAtMs = 0;
                    this.halfOpenInFlight = 0;
                    this.generation = this.NextGeneration();
                }
            } else if (this.state == CircuitState.Closed) {
                this.consecutiveFailures = 0;
            }
        }
    }

    // 记录一次失败调用。
    public void RecordFailure() {
        this.RecordFailureInternal(-1);
    }

    // 按代数令牌记录失败调用；过期周期的迟到失败不会误熔断新周期。
    public void RecordFailure(int token) {
        this.RecordFailureInternal(token);
    }

    private void RecordFailureInternal(int token) {
        lock (this.gate) {
            if (this.disposed) { return; }
            if (token >= 0 && token != this.generation) { return; }
            long now = CircuitBreaker.NowMs();
            if (this.state == CircuitState.HalfOpen) {
                // 半开探测失败，立即重新触发熔断
                this.state = CircuitState.Open;
                this.trippedAtMs = now;
                this.consecutiveSuccesses = 0;
                this.halfOpenInFlight = 0;
                this.generation = this.NextGeneration();
            } else if (this.state == CircuitState.Closed) {
                this.consecutiveFailures = this.consecutiveFailures + 1;
                if (this.consecutiveFailures >= this.failureThreshold) {
                    // 连续错误达到阈值，触发熔断切为 Open
                    this.state = CircuitState.Open;
                    this.trippedAtMs = now;
                    this.consecutiveSuccesses = 0;
                    this.halfOpenInFlight = 0;
                    this.generation = this.NextGeneration();
                }
            }
        }
    }

    // 手动重置熔断器至 Closed 初始正常状态。
    public void Reset() {
        lock (this.gate) {
            if (this.disposed) { return; }
            this.state = CircuitState.Closed;
            this.consecutiveFailures = 0;
            this.consecutiveSuccesses = 0;
            this.trippedAtMs = 0;
            this.halfOpenInFlight = 0;
            this.generation = this.NextGeneration();
        }
    }

    private void UpdateStateInternal() {
        if (this.state == CircuitState.Open) {
            long now = CircuitBreaker.NowMs();
            if (now - this.trippedAtMs >= this.breakDurationMs) {
                this.state = CircuitState.HalfOpen;
                this.consecutiveSuccesses = 0;
                this.halfOpenInFlight = 0;
                this.generation = this.NextGeneration();
            }
        }
    }

    private static long NowMs() {
        long freq = Stopwatch.Frequency();
        if (freq <= 0) { return 0; }
        return (long)(Stopwatch.NowTicks() * 1000.0 / (double)freq);
    }
}
