using System.Threading;

namespace System.Hosting;

// 托管服务契约（与 .NET IHostedService 同形）。StartAsync 在宿主启动阶段
// 顺序调用，StopAsync 在关闭阶段**逆序**调用；两者都不应抛异常给宿主——
// 宿主会记账并继续停其余服务，但自带原因比"被吞掉"更好排查。
public interface IHostedService {
    async bool StartAsync(CancellationToken ct);
    async bool StopAsync(CancellationToken ct);
}
