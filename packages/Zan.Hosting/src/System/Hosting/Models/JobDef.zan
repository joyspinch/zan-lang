using System;

namespace System.Hosting;

// 持久化任务的定义快照（PersistentJobs.Snapshot 的行形状）。
// 字段直接对应 ZanStore 的 job:<id>:<field> 键节；nextMs<=0 表示
// 已停排（cron 失效或手动停），retriesLeft 是剩余重试次数。
public class JobDef {
    public string id;
    public string name;
    public string cron;
    public long nextMs;
    public long lastMs;
    public int retriesLeft;
    public long runs;
    public long fails;

    public JobDef() {
        this.id = "";
        this.name = "";
        this.cron = "";
        this.nextMs = 0;
        this.lastMs = 0;
        this.retriesLeft = 0;
        this.runs = 0;
        this.fails = 0;
    }

    // 上次执行是否处于"失败且无重试额度"的关注状态。
    public bool NeedsAttention() {
        return this.fails > 0 && this.retriesLeft == 0
            && this.runs == 0 ? false : this.fails > 0 && this.retriesLeft == 0;
    }
}
