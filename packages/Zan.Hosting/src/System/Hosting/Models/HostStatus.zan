namespace System.Hosting;

// 宿主状态快照（强类型，供状态行/管理页/健康检查直接读，避免拼 JSON 解包）。
public class HostStatus {
    public string name;
    public bool running;
    public int services;
    public int startFailures;
    public int stopFailures;
    public int stopped;

    public HostStatus() {
        this.name = "";
        this.running = false;
        this.services = 0;
        this.startFailures = 0;
        this.stopFailures = 0;
        this.stopped = 0;
    }

    public string Line() {
        return "host " + this.name
            + (this.running ? " running" : " stopped")
            + " services=" + Convert.ToString(this.services)
            + " startFail=" + Convert.ToString(this.startFailures)
            + " stopFail=" + Convert.ToString(this.stopFailures)
            + " stopped=" + Convert.ToString(this.stopped);
    }
}
