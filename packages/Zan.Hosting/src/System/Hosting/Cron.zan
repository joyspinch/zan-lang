using System;
using Tasks.Jobs;

namespace System.Hosting;

// Compatibility wrapper: a bad expression returns null and constrained day
// of month and day of week fields match by union.
public class Cron {
    CronExpression expression;

    private Cron(CronExpression expression) { this.expression = expression; }

    public string Source() { return this.expression.RawExpression; }

    public static Cron Parse(string expr) {
        CronExpression parsed = CronExpression.ParseHosting(expr);
        if (parsed == null) { return null; }
        return new Cron(parsed);
    }

    public bool Matches(DateTime time) { return this.expression.IsMatching(time); }

    // Strictly after the given UTC timestamp; -1 if there is no match in the search window.
    public long NextAfter(long fromEpochMs) {
        DateTime next = this.expression.GetNext(DateTime.FromUnixMilliseconds(fromEpochMs));
        return next == null ? -1L : next.ToUnixMilliseconds();
    }
}
