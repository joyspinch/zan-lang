using System;
using System.Collections.Generic;
using System.Threading;
using Tasks.Jobs;

namespace System.Hosting;

// Hosting lifecycle and compatibility API for the persistent Jobs dispatcher.
public class PersistentJobs : BackgroundService {
    public delegate bool JobHandler(string id, string name, string param);

    ZanStoreCronStorage storage;
    CronJobs jobs;
    public JobHandler handler;
    public long retryDelayMs = 60000;
    public int maxRetries = 3;
    // Retained for source compatibility; nonzero settings are rejected.
    public int maxParallel = 0;

    public PersistentJobs(string storePath) {
        this.name = "persistent-jobs";
        this.intervalMs = 1000;
        this.storage = new ZanStoreCronStorage(storePath);
        this.jobs = new CronJobs(this.storage, new JobRegistry(), RetryPolicy.None());
    }

    public bool StoreOk() { return this.storage.IsOpen(); }
    public string StoreError() { return this.storage.GetError(); }

    // Stop and join the host loop before closing. A timed out stop does not
    // make it safe to close a store that an active callback still needs.
    public void Close() {
        if ((this.started && !this.StoppedCleanly()) || !this.jobs.TryStop()) {
            throw new InvalidOperationException("stop and join persistent jobs before closing the store");
        }
        this.storage.Close();
    }

    public bool Upsert(string id, string cronExpr, string jobName) {
        if (!this.StoreOk() || id == null || id.Contains(":")) { return false; }
        return this.jobs.Upsert(id, cronExpr, jobName, null, true);
    }

    public void Remove(string id) {
        if (this.StoreOk()) { this.jobs.Remove(id); }
    }

    public bool TriggerNow(string id) {
        return this.StoreOk() && this.jobs.TriggerNow(id);
    }

    public List<JobDef> Snapshot() {
        List<JobDef> result = new List<JobDef>();
        if (!this.StoreOk()) { return result; }
        foreach (JobRecord record in this.jobs.Snapshot()) {
            JobDef row = new JobDef();
            row.id = record.id;
            row.name = record.name;
            row.cron = record.cron;
            row.nextMs = record.runAt;
            row.lastMs = record.startAt;
            row.retriesLeft = record.cronRetriesLeft;
            row.runs = record.cronRuns;
            row.fails = record.cronFails;
            row.lastError = record.error;
            row.inFlight = record.state == JobState.Processing;
            row.retryPending = record.state == JobState.Failed;
            result.Add(row);
        }
        return result;
    }

    public override async bool ExecuteAsync(CancellationToken ct) {
        if (this.maxParallel != 0) {
            throw new ArgumentException("PersistentJobs supports serial execution only (maxParallel = 0)");
        }
        if (!this.StoreOk()) {
            this.lastError = this.StoreError();
            return false;
        }
        int attempts = this.maxRetries < 0 ? 1 : this.maxRetries;
        if (this.maxRetries >= 0 && attempts < int.MaxValue) { attempts = attempts + 1; }
        RetryPolicy policy = RetryPolicy.Fixed(attempts, this.retryDelayMs);
        Func<JobRecord, JobResult> run = (JobRecord record) => {
            try {
                if (this.handler == null) {
                    this.lastError = "persistent job handler is not configured";
                    return JobResult.Retry(this.lastError);
                }
                if (this.handler(record.id, record.name, record.args)) { return JobResult.Success(); }
                this.lastError = "persistent job handler returned false";
                return JobResult.Retry(this.lastError);
            } catch (Exception e) {
                this.lastError = e.Message == null ? "handler threw" : e.Message;
                return JobResult.Retry(this.lastError);
            }
        };
        this.jobs.ProcessOnce(ct, policy, run);
        return true;
    }
}
