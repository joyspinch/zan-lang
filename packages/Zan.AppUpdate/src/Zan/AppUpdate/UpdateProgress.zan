using System;

namespace Zan.AppUpdate;

/// <summary>
/// 更新生命周期阶段常量。
/// </summary>
class UpdatePhase {
    static const int Idle = 0;
    static const int Checking = 1;
    static const int Downloading = 2;
    static const int Verifying = 3;
    static const int Extracting = 4;
    static const int SelfHealing = 5;
    static const int Completed = 6;
    static const int Failed = 7;
    static const int Cancelled = 8;

    /// <summary>获取阶段的中文描述文本。</summary>
    static string PhaseName(int phase) {
        if (phase == UpdatePhase.Checking) { return "检查版本"; }
        if (phase == UpdatePhase.Downloading) { return "下载更新"; }
        if (phase == UpdatePhase.Verifying) { return "校验完整性"; }
        if (phase == UpdatePhase.Extracting) { return "解压安装"; }
        if (phase == UpdatePhase.SelfHealing) { return "篡改检测与自愈还原"; }
        if (phase == UpdatePhase.Completed) { return "更新完成"; }
        if (phase == UpdatePhase.Failed) { return "更新失败"; }
        if (phase == UpdatePhase.Cancelled) { return "已取消"; }
        return "准备中";
    }
}

/// <summary>
/// 更新过程中的进度状态快照。
/// </summary>
class UpdateProgressInfo {
    int phase;
    int percent;            // 0 ~ 100
    long bytesCurrent;
    long bytesTotal;
    string currentFile;
    string message;
    string error;

    UpdateProgressInfo() {
        this.phase = UpdatePhase.Idle;
        this.percent = 0;
        this.bytesCurrent = 0;
        this.bytesTotal = 0;
        this.currentFile = "";
        this.message = "";
        this.error = "";
    }

    static UpdateProgressInfo Create(int phase, int percent, string currentFile, string message) {
        UpdateProgressInfo info = new UpdateProgressInfo();
        info.phase = phase;
        info.percent = percent;
        info.currentFile = currentFile;
        info.message = message;
        return info;
    }

    static UpdateProgressInfo Progress(int phase, int percent, long currentBytes, long totalBytes, string file, string msg) {
        UpdateProgressInfo info = new UpdateProgressInfo();
        info.phase = phase;
        info.percent = percent;
        info.bytesCurrent = currentBytes;
        info.bytesTotal = totalBytes;
        info.currentFile = file;
        info.message = msg;
        return info;
    }

    static UpdateProgressInfo Fail(int phase, string errMsg) {
        UpdateProgressInfo info = new UpdateProgressInfo();
        info.phase = UpdatePhase.Failed;
        info.percent = 0;
        info.error = errMsg;
        info.message = errMsg;
        return info;
    }
}

/// <summary>
/// 更新进度回调委托。
/// </summary>
delegate void UpdateProgressCallback(UpdateProgressInfo info);

/// <summary>
/// 控制台简易进度条渲染器，适合命令行工具及无头运行环境。
/// </summary>
class ConsoleProgressRenderer {
    static void Print(UpdateProgressInfo info) {
        if (info == null) { return; }
        string stage = UpdatePhase.PhaseName(info.phase);
        int p = info.percent;
        if (p < 0) { p = 0; }
        if (p > 100) { p = 100; }

        int barWidth = 20;
        int filled = (p * barWidth) / 100;
        string bar = "";
        for (int i = 0; i < barWidth; i = i + 1) {
            if (i < filled) {
                bar = bar + "=";
            } else if (i == filled) {
                bar = bar + ">";
            } else {
                bar = bar + " ";
            }
        }

        string fileMsg = "";
        if (info.currentFile != null && info.currentFile.Length > 0) {
            fileMsg = " [" + info.currentFile + "]";
        }

        Console.WriteLine("[" + stage + "] [" + bar + "] " + p.ToString() + "% " + info.message + fileMsg);
    }

    /// <summary>
    /// 渲染进度信息（同 Print）。
    /// </summary>
    static void Render(UpdateProgressInfo info) {
        Print(info);
    }
}
