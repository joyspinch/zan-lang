using System;
using System.Json;

namespace Zan.AppUpdate;

// 版本更新中的单个文件条目元信息。
public class UpdateFileEntry {
    public string path;  // 相对路径（统一使用正斜杠 /）
    public long size;  // 文件字节大小
    public string md5;  // 32 位小写 MD5 校验和
    public bool required;  // 是否核心必需文件

    public UpdateFileEntry() {
        this.path = "";
        this.size = 0;
        this.md5 = "";
        this.required = true;
    }

    public static UpdateFileEntry Create(string path, long size, string md5, bool required) {
        UpdateFileEntry e = new UpdateFileEntry();
        e.path = NormalizePath(path);
        e.size = size;
        e.md5 = md5 != null ? md5.ToLower() : "";
        e.required = required;
        return e;
    }

    // 统一路径分隔符为正斜杠，去除开头的斜杠。
    public static string NormalizePath(string p) {
        if (p == null) { return ""; }
        string res = "";
        for (int i = 0; i < p.Length; i = i + 1) {
            string ch = p.Substring(i, 1);
            if (ch == "\\") {
                res = res + "/";
            } else {
                res = res + ch;
            }
        }
        while (res.StartsWith("/")) {
            res = res.Substring(1);
        }
        if (!UpdateFileEntry.SafeRelPath(res)) { return ""; }
        return res;
    }

    // 归档内相对路径防逃逸检查。
    public static bool SafeRelPath(string p) {
        if (p == null || p.Length == 0) { return false; }
        int c0 = p[0] & 255;
        if (c0 == 47 || c0 == 92) { return false; }  // 绝对路径
        if (p.Length >= 2 && (p[1] & 255) == 58) { return false; }  // "C:" 盘符
        int n = p.Length;
        int seg = 0;
        for (int i = 0; i <= n; i = i + 1) {
            int c = i < n ? (p[i] & 255) : 47;
            if (c == 47 || c == 92) {
                if (i - seg == 2 && (p[seg] & 255) == 46 && (p[seg + 1] & 255) == 46) {
                    return false;  // ".." 段
                }
                seg = i + 1;
            }
        }
        return true;
    }

    // 转换为 Json 节点。
    public JsonValue ToJsonValue() {
        JsonValue obj = JsonValue.NewObject();
        obj.PutStr("path", this.path);
        obj.PutInt("size", this.size);
        obj.PutStr("md5", this.md5);
        obj.PutBool("required", this.required);
        return obj;
    }

    // 从 Json 节点反序列化。
    public static UpdateFileEntry FromJsonValue(JsonValue obj) {
        if (obj == null) { return null; }
        UpdateFileEntry e = new UpdateFileEntry();
        e.path = NormalizePath(obj.Str("path", ""));
        e.size = obj.Long("size", 0);
        e.md5 = obj.Str("md5", "").ToLower();
        e.required = obj.Bool("required", true);
        return e;
    }

    // 从 JsonDoc 槽位高效反序列化（零 DOM 分配）。
    public static UpdateFileEntry FromJsonDoc(JsonDoc doc, int slot) {
        if (doc == null || slot < 0) { return null; }
        UpdateFileEntry e = new UpdateFileEntry();
        e.path = NormalizePath(doc.Str(slot, "path", ""));
        e.size = doc.Long(slot, "size", 0L);
        e.md5 = doc.Str(slot, "md5", "").ToLower();
        e.required = doc.Bool(slot, "required", true);
        return e;
    }
}
