using System;
using System.Json;

namespace Zan.AppUpdate;

// 版本更新中的单个文件条目元信息。
class UpdateFileEntry {
    string path;  // 相对路径（统一使用正斜杠 /）
    long size;  // 文件字节大小
    string md5;  // 32 位小写 MD5 校验和
    bool required;  // 是否核心必需文件

    UpdateFileEntry() {
        this.path = "";
        this.size = 0;
        this.md5 = "";
        this.required = true;
    }

    static UpdateFileEntry Create(string path, long size, string md5, bool required) {
        UpdateFileEntry e = new UpdateFileEntry();
        e.path = NormalizePath(path);
        e.size = size;
        e.md5 = md5 != null ? md5.ToLower() : "";
        e.required = required;
        return e;
    }

    // 统一路径分隔符为正斜杠，去除开头的斜杠。
    // 压缩包内来自不可信来源的路径可能携带 ".." 段、盘符等逃逸
    // 构造（zip-slip），归一化结果不满足 SafeRelPath 时一律返回
    // 空串 fail-closed，调用方必须把空串当作非法条目拒绝。
    static string NormalizePath(string p) {
        if (p == null) { return ""; }
        string res = "";
        for (int i = 0; i < p.Length; i = i + 1) {
            string ch = p.Substring(i, 1);
            if (ch == "\\") {
                res = res + "/";
            } else {
                res = res + ch;
            }
        }
        while (res.StartsWith("/")) {
            res = res.Substring(1);
        }
        if (!UpdateFileEntry.SafeRelPath(res)) { return ""; }
        return res;
    }

    // 归档内相对路径防逃逸检查（与 stdlib Tar.SafeName 同
    // 规则）：必须非空、相对、无盘符、不含 ".." 段。注意 "\\" 仅在
    // 段边界处当分隔符参与 ".." 判定，段内反斜杠在 Windows 上原样
    // 成为文件名的一部分，不额外拒绝。非法时返回 false。
    static bool SafeRelPath(string p) {
        if (p == null || p.Length == 0) { return false; }
        int c0 = p[0] & 255;
        if (c0 == 47 || c0 == 92) { return false; }  // 绝对路径
        if (p.Length >= 2 && (p[1] & 255) == 58) { return false; }  // "C:" 盘符
        int n = p.Length;
        int seg = 0;
        for (int i = 0; i <= n; i = i + 1) {
            int c = i < n ? (p[i] & 255) : 47;
            if (c == 47 || c == 92) {
                if (i - seg == 2 && (p[seg] & 255) == 46 && (p[seg + 1] & 255) == 46) {
                    return false;  // ".." 段
                }
                seg = i + 1;
            }
        }
        return true;
    }

    // 转换为 Json 节点。
    JsonValue ToJsonValue() {
        JsonValue obj = JsonValue.NewObject();
        obj.PutStr("path", this.path);
        obj.PutInt("size", this.size);
        obj.PutStr("md5", this.md5);
        obj.PutBool("required", this.required);
        return obj;
    }

    // 从 Json 节点反序列化。
    static UpdateFileEntry FromJsonValue(JsonValue obj) {
        if (obj == null) { return null; }
        UpdateFileEntry e = new UpdateFileEntry();
        e.path = NormalizePath(obj.Str("path", ""));
        e.size = obj.Long("size", 0);
        e.md5 = obj.Str("md5", "").ToLower();
        e.required = obj.Bool("required", true);
        return e;
    }
}
