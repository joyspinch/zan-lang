using System;
using System.Json;

namespace Zan.AppUpdate;

/// <summary>
/// 版本更新中的单个文件条目元信息。
/// </summary>
class UpdateFileEntry {
    string path;        // 相对路径（统一使用正斜杠 /）
    long size;          // 文件字节大小
    string md5;         // 32 位小写 MD5 校验和
    bool required;      // 是否核心必需文件

    UpdateFileEntry() {
        this.path = "";
        this.size = 0;
        this.md5 = "";
        this.required = true;
    }

    static UpdateFileEntry Create(string path, long size, string md5, bool required) {
        UpdateFileEntry e = new UpdateFileEntry();
        e.path = NormalizePath(path);
        e.size = size;
        e.md5 = md5 != null ? md5.ToLower() : "";
        e.required = required;
        return e;
    }

    /// <summary>统一路径分隔符为正斜杠，去除开头的斜杠。</summary>
    static string NormalizePath(string p) {
        if (p == null) { return ""; }
        string res = "";
        for (int i = 0; i < p.Length; i = i + 1) {
            string ch = p.Substring(i, 1);
            if (ch == "\\") {
                res = res + "/";
            } else {
                res = res + ch;
            }
        }
        while (res.StartsWith("/")) {
            res = res.Substring(1);
        }
        return res;
    }

    /// <summary>转换为 Json 节点。</summary>
    JsonValue ToJsonValue() {
        JsonValue obj = JsonValue.NewObject();
        obj.PutStr("path", this.path);
        obj.PutInt("size", this.size);
        obj.PutStr("md5", this.md5);
        obj.PutBool("required", this.required);
        return obj;
    }

    /// <summary>从 Json 节点反序列化。</summary>
    static UpdateFileEntry FromJsonValue(JsonValue obj) {
        if (obj == null) { return null; }
        UpdateFileEntry e = new UpdateFileEntry();
        e.path = NormalizePath(obj.Str("path", ""));
        e.size = obj.Long("size", 0);
        e.md5 = obj.Str("md5", "").ToLower();
        e.required = obj.Bool("required", true);
        return e;
    }
}
