using System;

namespace Zan.AppUpdate;

public class ConsoleProgressRenderer {
    public static void Print(UpdateProgressInfo info) {
        if (info == null) { return; }
        string stage = UpdatePhase.PhaseName(info.phase);
        int p = info.percent;
        if (p < 0) { p = 0; }
        if (p > 100) { p = 100; }

        int barWidth = 20;
        int filled = (p * barWidth) / 100;
        string bar = "";
        for (int i = 0; i < barWidth; i = i + 1) {
            if (i < filled) {
                bar = bar + "=";
            } else if (i == filled) {
                bar = bar + ">";
            } else {
                bar = bar + " ";
            }
        }

        string fileMsg = "";
        if (info.currentFile != null && info.currentFile.Length > 0) {
            fileMsg = " [" + info.currentFile + "]";
        }

        Console.WriteLine("[" + stage + "] [" + bar + "] " + p.ToString() + "% " + info.message + fileMsg);
    }

    // 渲染进度信息（同 Print）。
    public static void Render(UpdateProgressInfo info) {
        Print(info);
    }
}
