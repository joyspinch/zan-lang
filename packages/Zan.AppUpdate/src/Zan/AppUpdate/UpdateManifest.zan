using System;
using System.IO;
using System.Collections.Generic;
using System.Json;

namespace Zan.AppUpdate;

/// <summary>
/// 应用程序版本发布清单与更新描述。
/// </summary>
class UpdateManifest {
    string appName;
    string version;
    string releaseDate;
    string packageUrl;
    long packageSize;
    string packageMd5;
    string changelog;
    List<UpdateFileEntry> files;
    // 发行方对清单的 RSASSA-PKCS1-v1_5/SHA-256 签名（小写 hex），
    // 签名对象为 SigningPayload()（signature 字段置空的规范化 JSON）。
    // 客户端经 AppUpdater.SetTrustedSigner 配置发行方公钥后强制验签。
    string signature;

    UpdateManifest() {
        this.appName = "";
        this.version = "1.0.0";
        this.releaseDate = "";
        this.packageUrl = "";
        this.packageSize = 0;
        this.packageMd5 = "";
        this.changelog = "";
        this.files = new List<UpdateFileEntry>();
        this.signature = "";
    }

    /// <summary>清单签名（小写 hex；未签名为空串）。</summary>
    string Signature() {
        return this.signature;
    }

    /// <summary>写入清单签名（仅打包侧 ReleasePackager 使用）。</summary>
    void SetSignature(string sigHex) {
        this.signature = sigHex != null ? sigHex.ToLower() : "";
    }

    /// <summary>验签与签名共用的规范化负载：字段与 ToJson 一致，
    /// signature 置空、紧凑输出（无空白），保证两端逐字节一致。</summary>
    string SigningPayload() {
        return this.ToJsonCore(false, "");
    }

    /// <summary>添加一个文件条目。</summary>
    void AddFile(UpdateFileEntry entry) {
        if (entry != null) {
            this.files.Add(entry);
        }
    }

    /// <summary>根据相对路径查找文件条目。</summary>
    UpdateFileEntry FindFile(string relPath) {
        string norm = UpdateFileEntry.NormalizePath(relPath);
        for (int i = 0; i < this.files.Count; i = i + 1) {
            UpdateFileEntry f = this.files[i];
            if (f.path == norm) {
                return f;
            }
        }
        return null;
    }

    /// <summary>序列化为 JSON 字符串（含 signature 字段）。</summary>
    string ToJson(bool pretty) {
        return this.ToJsonCore(pretty, this.signature);
    }

    string ToJsonCore(bool pretty, string sigValue) {
        JsonValue root = JsonValue.NewObject();
        root.PutStr("appName", this.appName);
        root.PutStr("version", this.version);
        root.PutStr("releaseDate", this.releaseDate);
        root.PutStr("packageUrl", this.packageUrl);
        root.PutInt("packageSize", this.packageSize);
        root.PutStr("packageMd5", this.packageMd5);
        root.PutStr("changelog", this.changelog);

        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < this.files.Count; i = i + 1) {
            UpdateFileEntry entry = this.files[i];
            arr.Append(entry.ToJsonValue());
        }
        root.Put("files", arr);
        root.PutStr("signature", sigValue);

        return root.ToJson();
    }

    /// <summary>保存清单到本地文件。</summary>
    void SaveToFile(string path) {
        string json = this.ToJson(true);
        File.WriteAllText(path, json);
    }

    /// <summary>从 JSON 字符串反序列化清单。</summary>
    static UpdateManifest Parse(string jsonStr) {
        if (jsonStr == null || jsonStr.Length == 0) { return null; }
        JsonValue root = JsonValue.Parse(jsonStr);
        if (root == null) { return null; }

        UpdateManifest m = new UpdateManifest();
        m.appName = root.Str("appName", "");
        m.version = root.Str("version", "1.0.0");
        m.releaseDate = root.Str("releaseDate", "");
        m.packageUrl = root.Str("packageUrl", "");
        m.packageSize = root.Long("packageSize", 0);
        m.packageMd5 = root.Str("packageMd5", "").ToLower();
        m.changelog = root.Str("changelog", "");
        m.signature = root.Str("signature", "").ToLower();

        JsonValue filesArr = root.Get("files");
        if (filesArr != null) {
            int count = filesArr.Count();
            for (int i = 0; i < count; i = i + 1) {
                JsonValue item = filesArr.At(i);
                UpdateFileEntry entry = UpdateFileEntry.FromJsonValue(item);
                if (entry != null) {
                    m.files.Add(entry);
                }
            }
        }
        return m;
    }

    /// <summary>从本地文件加载清单。</summary>
    static UpdateManifest LoadFromFile(string path) {
        if (!File.Exists(path)) { return null; }
        string text = File.ReadAllText(path);
        return Parse(text);
    }
}
