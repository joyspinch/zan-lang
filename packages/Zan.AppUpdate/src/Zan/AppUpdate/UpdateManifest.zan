using System;
using System.IO;
using System.Collections.Generic;
using System.Json;

namespace Zan.AppUpdate;

// 应用程序版本发布清单与更新描述。
public class UpdateManifest {
    public string appName;
    public string version;
    public string releaseDate;
    public string packageUrl;
    public long packageSize;
    public string packageMd5;
    public string changelog;
    public List<UpdateFileEntry> files;
    // 发行方对清单的 RSASSA-PKCS1-v1_5/SHA-256 签名（小写 hex）
    public string signature;

    public UpdateManifest() {
        this.appName = "";
        this.version = "1.0.0";
        this.releaseDate = "";
        this.packageUrl = "";
        this.packageSize = 0;
        this.packageMd5 = "";
        this.changelog = "";
        this.files = new List<UpdateFileEntry>();
        this.signature = "";
    }

    // 清单签名（小写 hex；未签名为空串）。
    public string Signature() {
        return this.signature;
    }

    // 写入清单签名（仅打包侧 ReleasePackager 使用）。
    public void SetSignature(string sigHex) {
        this.signature = sigHex != null ? sigHex.ToLower() : "";
    }

    // 验签与签名共用的规范化负载：字段与 ToJson 一致，
    // signature 置空、紧凑输出（无空白），保证两端逐字节一致。
    public string SigningPayload() {
        return this.ToJsonCore(false, "");
    }

    // 添加一个文件条目。
    public void AddFile(UpdateFileEntry entry) {
        if (entry != null) {
            this.files.Add(entry);
        }
    }

    // 根据相对路径查找文件条目。
    public UpdateFileEntry FindFile(string relPath) {
        string norm = UpdateFileEntry.NormalizePath(relPath);
        for (int i = 0; i < this.files.Count; i = i + 1) {
            UpdateFileEntry f = this.files[i];
            if (f.path == norm) {
                return f;
            }
        }
        return null;
    }

    // 序列化为 JSON 字符串（含 signature 字段）。
    public string ToJson() {
        return this.ToJson(false);
    }

    // 序列化为 JSON 字符串（含 signature 字段，可指定 pretty）。
    public string ToJson(bool pretty) {
        return this.ToJsonCore(pretty, this.signature);
    }

    public string ToJsonCore(bool pretty, string sigValue) {
        JsonValue root = JsonValue.NewObject();
        root.PutStr("appName", this.appName);
        root.PutStr("version", this.version);
        root.PutStr("releaseDate", this.releaseDate);
        root.PutStr("packageUrl", this.packageUrl);
        root.PutInt("packageSize", this.packageSize);
        root.PutStr("packageMd5", this.packageMd5);
        root.PutStr("changelog", this.changelog);

        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < this.files.Count; i = i + 1) {
            UpdateFileEntry entry = this.files[i];
            arr.Append(entry.ToJsonValue());
        }
        root.Put("files", arr);
        root.PutStr("signature", sigValue);

        return root.ToJson();
    }

    // 保存清单到本地文件。
    public void SaveToFile(string path) {
        string json = this.ToJson(true);
        File.WriteAllText(path, json);
    }

    // 从 JSON 字符串反序列化清单（基于 JsonDoc 扁平磁带，零临时 DOM 树开销）。
    public static UpdateManifest Parse(string jsonStr) {
        if (jsonStr == null || jsonStr.Length == 0) { return null; }
        JsonDoc doc = JsonDoc.Parse(jsonStr);
        if (doc == null || doc.root < 0 || doc.KindAt(doc.root) != 5) { return null; }

        UpdateManifest m = new UpdateManifest();
        m.appName = doc.Str(doc.root, "appName", "");
        m.version = doc.Str(doc.root, "version", "1.0.0");
        m.releaseDate = doc.Str(doc.root, "releaseDate", "");
        m.packageUrl = doc.Str(doc.root, "packageUrl", "");
        m.packageSize = doc.Long(doc.root, "packageSize", 0L);
        m.packageMd5 = doc.Str(doc.root, "packageMd5", "").ToLower();
        m.changelog = doc.Str(doc.root, "changelog", "");
        m.signature = doc.Str(doc.root, "signature", "").ToLower();

        int filesArr = doc.Key(doc.root, "files");
        if (filesArr >= 0 && doc.KindAt(filesArr) == 4) {
            int count = doc.Count(filesArr);
            m.files.Reserve(count);
            int item = doc.FirstChild(filesArr);
            for (int i = 0; i < count; i = i + 1) {
                UpdateFileEntry entry = UpdateFileEntry.FromJsonDoc(doc, item);
                if (entry != null) {
                    m.files.Add(entry);
                }
                item = doc.NextSibling(item);
            }
        }
        return m;
    }

    // 从本地文件加载清单。
    public static UpdateManifest LoadFromFile(string path) {
        if (!File.Exists(path)) { return null; }
        string text = File.ReadAllText(path);
        return Parse(text);
    }
}
