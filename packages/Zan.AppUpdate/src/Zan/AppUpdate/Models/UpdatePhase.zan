using System;

namespace Zan.AppUpdate;

public class UpdatePhase {
    public static const int Idle = 0;
    public static const int Checking = 1;
    public static const int Downloading = 2;
    public static const int Verifying = 3;
    public static const int Extracting = 4;
    public static const int SelfHealing = 5;
    public static const int Completed = 6;
    public static const int Failed = 7;
    public static const int Cancelled = 8;

    // 获取阶段的中文描述文本。
    public static string PhaseName(int phase) {
        if (phase == UpdatePhase.Checking) { return "检查版本"; }
        if (phase == UpdatePhase.Downloading) { return "下载更新"; }
        if (phase == UpdatePhase.Verifying) { return "校验完整性"; }
        if (phase == UpdatePhase.Extracting) { return "解压安装"; }
        if (phase == UpdatePhase.SelfHealing) { return "篡改检测与自愈还原"; }
        if (phase == UpdatePhase.Completed) { return "更新完成"; }
        if (phase == UpdatePhase.Failed) { return "更新失败"; }
        if (phase == UpdatePhase.Cancelled) { return "已取消"; }
        return "准备中";
    }
}
