using System;

namespace Zan.AppUpdate;

public class UpdateProgressInfo {
    public int phase;
    public int percent;  // 0 ~ 100
    public long bytesCurrent;
    public long bytesTotal;
    public string currentFile;
    public string message;
    public string error;

    public UpdateProgressInfo() {
        this.phase = UpdatePhase.Idle;
        this.percent = 0;
        this.bytesCurrent = 0;
        this.bytesTotal = 0;
        this.currentFile = "";
        this.message = "";
        this.error = "";
    }

    public static UpdateProgressInfo Create(int phase, int percent, string currentFile, string message) {
        UpdateProgressInfo info = new UpdateProgressInfo();
        info.phase = phase;
        info.percent = percent;
        info.currentFile = currentFile;
        info.message = message;
        return info;
    }

    public static UpdateProgressInfo Progress(int phase, int percent, long currentBytes, long totalBytes, string file, string msg) {
        UpdateProgressInfo info = new UpdateProgressInfo();
        info.phase = phase;
        info.percent = percent;
        info.bytesCurrent = currentBytes;
        info.bytesTotal = totalBytes;
        info.currentFile = file;
        info.message = msg;
        return info;
    }

    public static UpdateProgressInfo Fail(int phase, string errMsg) {
        UpdateProgressInfo info = new UpdateProgressInfo();
        info.phase = UpdatePhase.Failed;
        info.percent = 0;
        info.error = errMsg;
        info.message = errMsg;
        return info;
    }
}

// 更新进度回调委托。
public delegate void UpdateProgressCallback(UpdateProgressInfo info);
