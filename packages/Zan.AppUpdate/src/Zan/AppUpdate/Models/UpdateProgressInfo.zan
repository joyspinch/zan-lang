using System;

namespace Zan.AppUpdate;

class UpdateProgressInfo {
    int phase;
    int percent;  // 0 ~ 100
    long bytesCurrent;
    long bytesTotal;
    string currentFile;
    string message;
    string error;

    UpdateProgressInfo() {
        this.phase = UpdatePhase.Idle;
        this.percent = 0;
        this.bytesCurrent = 0;
        this.bytesTotal = 0;
        this.currentFile = "";
        this.message = "";
        this.error = "";
    }

    static UpdateProgressInfo Create(int phase, int percent, string currentFile, string message) {
        UpdateProgressInfo info = new UpdateProgressInfo();
        info.phase = phase;
        info.percent = percent;
        info.currentFile = currentFile;
        info.message = message;
        return info;
    }

    static UpdateProgressInfo Progress(int phase, int percent, long currentBytes, long totalBytes, string file, string msg) {
        UpdateProgressInfo info = new UpdateProgressInfo();
        info.phase = phase;
        info.percent = percent;
        info.bytesCurrent = currentBytes;
        info.bytesTotal = totalBytes;
        info.currentFile = file;
        info.message = msg;
        return info;
    }

    static UpdateProgressInfo Fail(int phase, string errMsg) {
        UpdateProgressInfo info = new UpdateProgressInfo();
        info.phase = UpdatePhase.Failed;
        info.percent = 0;
        info.error = errMsg;
        info.message = errMsg;
        return info;
    }
}

// 更新进度回调委托。
delegate void UpdateProgressCallback(UpdateProgressInfo info);

// 控制台简易进度条渲染器，适合命令行工具及无头运行环境。
