using System;
using System.IO;
using System.IO.Compression;
using System.Collections.Generic;
using System.Security.Cryptography;

namespace Zan.AppUpdate;

class TamperFileIssue {
    string path;
    int status;
    string expectedMd5;
    string actualMd5;
    long expectedSize;
    long actualSize;
    bool restored;

    TamperFileIssue() {
        this.path = "";
        this.status = FileIntegrityStatus.Ok;
        this.expectedMd5 = "";
        this.actualMd5 = "";
        this.expectedSize = 0;
        this.actualSize = 0;
        this.restored = false;
    }

    static TamperFileIssue Create(string path, int status, string expMd5, string actMd5, long expSize, long actSize) {
        TamperFileIssue it = new TamperFileIssue();
        it.path = path;
        it.status = status;
        it.expectedMd5 = expMd5;
        it.actualMd5 = actMd5;
        it.expectedSize = expSize;
        it.actualSize = actSize;
        it.restored = false;
        return it;
    }
}

// 程序完整性自检报表。
