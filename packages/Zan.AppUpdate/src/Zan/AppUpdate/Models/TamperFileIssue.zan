using System;
using System.IO;
using System.IO.Compression;
using System.Collections.Generic;
using System.Security.Cryptography;

namespace Zan.AppUpdate;

public class TamperFileIssue {
    public string path;
    public int status;
    public string expectedMd5;
    public string actualMd5;
    public long expectedSize;
    public long actualSize;
    public bool restored;

    public TamperFileIssue() {
        this.path = "";
        this.status = FileIntegrityStatus.Ok;
        this.expectedMd5 = "";
        this.actualMd5 = "";
        this.expectedSize = 0;
        this.actualSize = 0;
        this.restored = false;
    }

    public static TamperFileIssue Create(string path, int status, string expMd5, string actMd5, long expSize, long actSize) {
        TamperFileIssue it = new TamperFileIssue();
        it.path = path;
        it.status = status;
        it.expectedMd5 = expMd5;
        it.actualMd5 = actMd5;
        it.expectedSize = expSize;
        it.actualSize = actSize;
        it.restored = false;
        return it;
    }
}
