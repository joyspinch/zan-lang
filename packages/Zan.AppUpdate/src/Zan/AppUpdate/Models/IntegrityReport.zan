using System;
using System.IO;
using System.IO.Compression;
using System.Collections.Generic;
using System.Security.Cryptography;

class IntegrityReport {
    bool isClean;
    int totalChecked;
    int okCount;
    int missingCount;
    int tamperedCount;
    int restoredCount;
    List<TamperFileIssue> issues;

    IntegrityReport() {
        this.isClean = true;
        this.totalChecked = 0;
        this.okCount = 0;
        this.missingCount = 0;
        this.tamperedCount = 0;
        this.restoredCount = 0;
        this.issues = new List<TamperFileIssue>();
    }

    void AddIssue(TamperFileIssue issue) {
        if (issue == null) { return; }
        this.isClean = false;
        if (issue.status == FileIntegrityStatus.Missing) {
            this.missingCount = this.missingCount + 1;
        } else if (issue.status == FileIntegrityStatus.Tampered) {
            this.tamperedCount = this.tamperedCount + 1;
        }
        this.issues.Add(issue);
    }

    string Summary() {
        string res = "【程序完整性检测报告】\n";
        res = res + "总检测文件数: " + this.totalChecked.ToString() + "\n";
        res = res + "正常文件数:   " + this.okCount.ToString() + "\n";
        res = res + "缺失文件数:   " + this.missingCount.ToString() + "\n";
        res = res + "被篡改文件数: " + this.tamperedCount.ToString() + "\n";
        if (this.restoredCount > 0) {
            res = res + "已自动还原数: " + this.restoredCount.ToString() + "\n";
        }
        res = res + "整体状态:     " + (this.isClean ? "纯净完整 (PASS)" : "存在异常 (TAMPERED)") + "\n";

        if (this.issues.Count > 0) {
            res = res + "\n异常文件明细:\n";
            for (int i = 0; i < this.issues.Count; i = i + 1) {
                TamperFileIssue it = this.issues[i];
                res = res + " - [" + FileIntegrityStatus.StatusText(it.status) + "] " + it.path;
                if (it.status == FileIntegrityStatus.Tampered) {
                    res = res + " (期望 MD5: " + it.expectedMd5 + ", 实际 MD5: " + it.actualMd5 + ")";
                }
                if (it.restored) {
                    res = res + " -> [已自动还原恢复]";
                }
                res = res + "\n";
            }
        }
        return res;
    }
}

// 防篡改检测与自愈还原引擎。
// 通过 MD5 哈希比对检验程序完整性，并在发现损坏/被篡改时从官方 Zip 包自动还原。
