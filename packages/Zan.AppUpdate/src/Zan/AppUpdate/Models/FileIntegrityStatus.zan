using System;

namespace Zan.AppUpdate;

public class FileIntegrityStatus {
    public static const int Ok = 0;
    public static const int Missing = 1;
    public static const int Tampered = 2;

    public static string StatusText(int s) {
        if (s == FileIntegrityStatus.Ok) { return "正常"; }
        if (s == FileIntegrityStatus.Missing) { return "文件缺失"; }
        if (s == FileIntegrityStatus.Tampered) { return "文件被篡改/校验不匹配"; }
        return "未知";
    }
}
