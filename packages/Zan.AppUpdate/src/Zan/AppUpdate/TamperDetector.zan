using System;
using System.IO;
using System.IO.Compression;
using System.Collections.Generic;
using System.Security.Cryptography;

namespace Zan.AppUpdate;

/// <summary>
/// 文件篡改状态枚举。
/// </summary>
class FileIntegrityStatus {
    static const int Ok = 0;
    static const int Missing = 1;
    static const int Tampered = 2;

    static string StatusText(int s) {
        if (s == FileIntegrityStatus.Ok) { return "正常"; }
        if (s == FileIntegrityStatus.Missing) { return "文件缺失"; }
        if (s == FileIntegrityStatus.Tampered) { return "文件被篡改/校验不匹配"; }
        return "未知";
    }
}

/// <summary>
/// 单个异常文件的检测项详情。
/// </summary>
class TamperFileIssue {
    string path;
    int status;
    string expectedMd5;
    string actualMd5;
    long expectedSize;
    long actualSize;
    bool restored;

    TamperFileIssue() {
        this.path = "";
        this.status = FileIntegrityStatus.Ok;
        this.expectedMd5 = "";
        this.actualMd5 = "";
        this.expectedSize = 0;
        this.actualSize = 0;
        this.restored = false;
    }

    static TamperFileIssue Create(string path, int status, string expMd5, string actMd5, long expSize, long actSize) {
        TamperFileIssue it = new TamperFileIssue();
        it.path = path;
        it.status = status;
        it.expectedMd5 = expMd5;
        it.actualMd5 = actMd5;
        it.expectedSize = expSize;
        it.actualSize = actSize;
        it.restored = false;
        return it;
    }
}

/// <summary>
/// 程序完整性自检报表。
/// </summary>
class IntegrityReport {
    bool isClean;
    int totalChecked;
    int okCount;
    int missingCount;
    int tamperedCount;
    int restoredCount;
    List<TamperFileIssue> issues;

    IntegrityReport() {
        this.isClean = true;
        this.totalChecked = 0;
        this.okCount = 0;
        this.missingCount = 0;
        this.tamperedCount = 0;
        this.restoredCount = 0;
        this.issues = new List<TamperFileIssue>();
    }

    void AddIssue(TamperFileIssue issue) {
        if (issue == null) { return; }
        this.isClean = false;
        if (issue.status == FileIntegrityStatus.Missing) {
            this.missingCount = this.missingCount + 1;
        } else if (issue.status == FileIntegrityStatus.Tampered) {
            this.tamperedCount = this.tamperedCount + 1;
        }
        this.issues.Add(issue);
    }

    string Summary() {
        string res = "【程序完整性检测报告】\n";
        res = res + "总检测文件数: " + this.totalChecked.ToString() + "\n";
        res = res + "正常文件数:   " + this.okCount.ToString() + "\n";
        res = res + "缺失文件数:   " + this.missingCount.ToString() + "\n";
        res = res + "被篡改文件数: " + this.tamperedCount.ToString() + "\n";
        if (this.restoredCount > 0) {
            res = res + "已自动还原数: " + this.restoredCount.ToString() + "\n";
        }
        res = res + "整体状态:     " + (this.isClean ? "纯净完整 (PASS)" : "存在异常 (TAMPERED)") + "\n";

        if (this.issues.Count > 0) {
            res = res + "\n异常文件明细:\n";
            for (int i = 0; i < this.issues.Count; i = i + 1) {
                TamperFileIssue it = this.issues[i];
                res = res + " - [" + FileIntegrityStatus.StatusText(it.status) + "] " + it.path;
                if (it.status == FileIntegrityStatus.Tampered) {
                    res = res + " (期望 MD5: " + it.expectedMd5 + ", 实际 MD5: " + it.actualMd5 + ")";
                }
                if (it.restored) {
                    res = res + " -> [已自动还原恢复]";
                }
                res = res + "\n";
            }
        }
        return res;
    }
}

/// <summary>
/// 防篡改检测与自愈还原引擎。
/// 通过 MD5 哈希比对检验程序完整性，并在发现损坏/被篡改时从官方 Zip 包自动还原。
/// </summary>
class TamperDetector {

    /// <summary>
    /// 对本地应用程序目录进行全量 MD5 防篡改比对自检。
    /// </summary>
    static IntegrityReport Check(string appDir, UpdateManifest manifest, UpdateProgressCallback cb) {
        IntegrityReport report = new IntegrityReport();
        if (manifest == null || manifest.files == null) {
            return report;
        }

        int total = manifest.files.Count;
        report.totalChecked = total;

        for (int i = 0; i < total; i = i + 1) {
            UpdateFileEntry expected = manifest.files[i];
            string fullPath = appDir + "/" + expected.path;

            if (!File.Exists(fullPath)) {
                // 文件缺失
                TamperFileIssue issue = TamperFileIssue.Create(
                    expected.path,
                    FileIntegrityStatus.Missing,
                    expected.md5,
                    "",
                    expected.size,
                    0
                );
                report.AddIssue(issue);
            } else {
                byte[] bytes = File.ReadAllBytes(fullPath);
                int actSize = bytes != null ? bytes.Length : 0;
                string actMd5 = Md5.HashToHex(bytes);

                if (actMd5 != expected.md5) {
                    // MD5 不匹配：文件被篡改或损坏
                    TamperFileIssue issue = TamperFileIssue.Create(
                        expected.path,
                        FileIntegrityStatus.Tampered,
                        expected.md5,
                        actMd5,
                        expected.size,
                        actSize
                    );
                    report.AddIssue(issue);
                } else {
                    report.okCount = report.okCount + 1;
                }
            }

            if (cb != null) {
                int percent = ((i + 1) * 100) / total;
                cb(UpdateProgressInfo.Progress(
                    UpdatePhase.SelfHealing,
                    percent,
                    i + 1,
                    total,
                    expected.path,
                    "正在比对文件 MD5 防篡改哈希..."
                ));
            }
        }

        return report;
    }

    /// <summary>
    /// 根据防篡改自检报表，从官方 Zip 更新包中提取正版文件，自动还原被篡改或缺失的文件。
    /// </summary>
    /// <param name="appDir">目标应用程序根目录</param>
    /// <param name="report">自检报表</param>
    /// <param name="zipPackagePath">官方原始 Zip 压缩包路径</param>
    /// <param name="cb">进度回调</param>
    /// <returns>修复成功的数量</returns>
    static int RestoreFromZip(string appDir, IntegrityReport report, string zipPackagePath, UpdateProgressCallback cb) {
        if (report == null || report.isClean || report.issues.Count == 0) {
            return 0;
        }

        if (!File.Exists(zipPackagePath)) {
            if (cb != null) {
                cb(UpdateProgressInfo.Fail(UpdatePhase.Failed, "自愈修复失败：官方恢复包不存在: " + zipPackagePath));
            }
            return 0;
        }

        if (cb != null) {
            cb(UpdateProgressInfo.Create(UpdatePhase.SelfHealing, 0, "", "正在打开官方恢复包进行防篡改自愈..."));
        }

        byte[] zipBytes = File.ReadAllBytes(zipPackagePath);
        if (zipBytes == null || zipBytes.Length == 0) {
            if (cb != null) {
                cb(UpdateProgressInfo.Fail(UpdatePhase.Failed, "官方恢复包内容为空"));
            }
            return 0;
        }

        List<ZipEntry> entries = Zip.Read(zipBytes);
        if (entries == null) {
            if (cb != null) {
                cb(UpdateProgressInfo.Fail(UpdatePhase.Failed, "官方恢复包 Zip 解析失败"));
            }
            return 0;
        }
        int restoredCount = 0;
        int issueTotal = report.issues.Count;

        for (int i = 0; i < issueTotal; i = i + 1) {
            TamperFileIssue issue = report.issues[i];
            string normPath = UpdateFileEntry.NormalizePath(issue.path);

            // 在 Zip 中查找对应的条目
            ZipEntry targetEntry = null;
            for (int k = 0; k < entries.Count; k = k + 1) {
                ZipEntry ze = entries[k];
                if (UpdateFileEntry.NormalizePath(ze.name) == normPath) {
                    targetEntry = ze;
                    break;
                }
            }

            if (targetEntry != null) {
                // 提取文件原始内容
                byte[] originalBytes = Zip.Extract(zipBytes, targetEntry);
                string fullPath = appDir + "/" + issue.path;

                // 确保目标所在目录存在
                string dir = Path.GetDirectoryName(fullPath);
                if (dir != null && dir.Length > 0 && !Directory.Exists(dir)) {
                    Directory.CreateDirectory(dir);
                }

                // 覆盖写入被篡改文件
                File.WriteAllBytes(fullPath, originalBytes);
                AppUpdater.RestoreExecutablePermissionIfNeeded(fullPath, originalBytes);

                // 二次校验恢复后的 MD5
                string verifiedMd5 = Md5.HashToHex(originalBytes);
                if (verifiedMd5 == issue.expectedMd5) {
                    issue.restored = true;
                    restoredCount = restoredCount + 1;
                }
            }

            if (cb != null) {
                int percent = ((i + 1) * 100) / issueTotal;
                cb(UpdateProgressInfo.Progress(
                    UpdatePhase.SelfHealing,
                    percent,
                    i + 1,
                    issueTotal,
                    issue.path,
                    "已自动还原被篡改文件并二次复核 MD5"
                ));
            }
        }

        report.restoredCount = restoredCount;
        if (restoredCount == issueTotal) {
            report.isClean = true;
        }

        return restoredCount;
    }
}
