using System;
using System.IO;
using System.IO.Compression;
using System.Collections.Generic;
using System.Security.Cryptography;

namespace AppUpdate;

public class TamperFileIssue {
    public string path;
    public int status;
    public string expectedSha256;
    public string actualSha256;
    public long expectedSize;
    public long actualSize;
    public bool restored;

    public TamperFileIssue() {
        this.path = "";
        this.status = FileIntegrityStatus.Ok;
        this.expectedSha256 = "";
        this.actualSha256 = "";
        this.expectedSize = 0;
        this.actualSize = 0;
        this.restored = false;
    }

    public static TamperFileIssue Create(string path, int status, string expSha256, string actSha256, long expSize, long actSize) {
        TamperFileIssue it = new TamperFileIssue();
        it.path = path;
        it.status = status;
        it.expectedSha256 = expSha256;
        it.actualSha256 = actSha256;
        it.expectedSize = expSize;
        it.actualSize = actSize;
        it.restored = false;
        return it;
    }
}
