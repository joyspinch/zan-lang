using System;
using System.IO;
using System.IO.Compression;
using System.Collections.Generic;
using System.Security.Cryptography;
using System.Text;

namespace AppUpdate;

public class IntegrityReport {
    public bool isClean;
    public int totalChecked;
    public int okCount;
    public int missingCount;
    public int tamperedCount;
    public int restoredCount;
    public List<TamperFileIssue> issues;

    public IntegrityReport() {
        this.isClean = true;
        this.totalChecked = 0;
        this.okCount = 0;
        this.missingCount = 0;
        this.tamperedCount = 0;
        this.restoredCount = 0;
        this.issues = new List<TamperFileIssue>();
    }

    public void AddIssue(TamperFileIssue issue) {
        if (issue == null) { return; }
        this.isClean = false;
        if (issue.status == FileIntegrityStatus.Missing) {
            this.missingCount = this.missingCount + 1;
        } else if (issue.status == FileIntegrityStatus.Tampered) {
            this.tamperedCount = this.tamperedCount + 1;
        }
        this.issues.Add(issue);
    }

    public string Summary() {
        StringBuilder res = new StringBuilder();
        res.Append("【程序完整性检测报告】\n");
        res.Append("总检测文件数: "); res.Append(this.totalChecked.ToString()); res.Append("\n");
        res.Append("正常文件数:   "); res.Append(this.okCount.ToString()); res.Append("\n");
        res.Append("缺失文件数:   "); res.Append(this.missingCount.ToString()); res.Append("\n");
        res.Append("被篡改文件数: "); res.Append(this.tamperedCount.ToString()); res.Append("\n");
        if (this.restoredCount > 0) {
            res.Append("已自动还原数: "); res.Append(this.restoredCount.ToString()); res.Append("\n");
        }
        res.Append("整体状态:     ");
        res.Append(this.isClean ? "纯净完整 (PASS)" : "存在异常 (TAMPERED)");
        res.Append("\n");

        if (this.issues.Count > 0) {
            res.Append("\n异常文件明细:\n");
            for (int i = 0; i < this.issues.Count; i = i + 1) {
                TamperFileIssue it = this.issues[i];
                res.Append(" - [");
                res.Append(FileIntegrityStatus.StatusText(it.status));
                res.Append("] ");
                res.Append(it.path);
                if (it.status == FileIntegrityStatus.Tampered) {
                    res.Append(" (期望 SHA-256: ");
                    res.Append(it.expectedSha256);
                    res.Append(", 实际 SHA-256: ");
                    res.Append(it.actualSha256);
                    res.Append(")");
                }
                if (it.restored) {
                    res.Append(" -> [已自动还原恢复]");
                }
                res.Append("\n");
            }
        }
        return res.ToString();
    }
}
