using System;
using System.IO;

namespace AppUpdate;

// One collaborator per transaction; no shared test callback or mutable global state.
internal class InstallPersistence {
    internal virtual void SyncFile(string path, string boundary) {
        File.FlushToDisk(path);
    }

    internal virtual void SyncDirectory(string path, string boundary) {
        #if !WINDOWS
        Directory.FlushToDisk(path);
        #endif
        // Windows has no directory barrier backend; file flushing alone does not
        // establish durable namespace publication there.
    }

    internal void SyncParents(string path, string boundary) {
        // Also covers entries created by a previous attempt whose directory sync
        // failed. Existing ancestors cannot be assumed persistent after a retry.
        string current = Path.GetFullPath(path);
        while (current != null && current.Length > 0) {
            this.SyncDirectory(current, boundary);
            string parent = Path.GetDirectoryName(current);
            if (parent == current) { break; }
            current = parent;
        }
    }

    internal void CreateDirectories(string path) {
        Directory.CreateDirectoryRecursive(path);
        this.SyncParents(path, "directories-created");
    }
}
