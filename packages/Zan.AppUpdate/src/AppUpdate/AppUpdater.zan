using System;
using System.IO;
using System.IO.Compression;
using System.Collections.Generic;
using System.Security.Cryptography;

namespace AppUpdate;

public class AppUpdater {
    private static string signerKeyHex = "";

    // Trust anchors come from the installed application, never downloaded metadata.
    // Invalid configuration clears the previous anchor and fails closed.
    public static void SetTrustedSigner(string modulusHex, string exponentHex) {
        AppUpdater.signerKeyHex = TrustedRsaKeys.Single(modulusHex, exponentHex);
    }

    // Each line is public modulusHex:exponentHex; invalid replacement clears trust.
    public static bool SetTrustedSigners(string serializedKeys) {
        string snapshot = TrustedRsaKeys.FromHex(serializedKeys);
        AppUpdater.signerKeyHex = snapshot;
        return snapshot != "";
    }

    public static bool SetTrustedSignerPemBundle(string trustedPem) {
        return AppUpdater.SetTrustedSigners(TrustedRsaKeys.FromPemBundle(trustedPem));
    }

    public static bool IsHex(string value, int minLength, int maxLength) {
        if (value == null || value.Length < minLength || value.Length > maxLength || value.Length % 2 != 0) { return false; }
        for (int i = 0; i < value.Length; i = i + 1) {
            int c = value[i];
            if (!((c >= 48 && c <= 57) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102))) { return false; }
        }
        return true;
    }

    public static string HashBytes(byte[] bytes) {
        if (bytes == null) { return ""; }
        return Hex.Encode(Sha256.Hash(bytes), 32);
    }

    public static bool ValidManifest(UpdateManifest manifest) {
        if (manifest == null || manifest.files == null || manifest.files.Count == 0 || manifest.files.Count > 10000) { return false; }
        if (manifest.packageSize <= 0 || manifest.packageSize > 268435456L || !IsHex(manifest.packageSha256, 64, 64)) { return false; }
        Dictionary<string, bool> seen = new Dictionary<string, bool>();
        long total = 0;
        for (int i = 0; i < manifest.files.Count; i = i + 1) {
            UpdateFileEntry f = manifest.files[i];
            if (f == null || !UpdateFileEntry.SafeRelPath(f.path) || f.path != UpdateFileEntry.NormalizePath(f.path)) { return false; }
            if (f.size < 0 || f.size > 67108864L || !IsHex(f.sha256, 64, 64)) { return false; }
            string key = f.path.ToLower();
            if (key == "_backup" || key.StartsWith("_backup/") || seen.ContainsKey(key)) { return false; }
            // Parent and child installations may share this tree: no payload may
            // replace another install's lock inode or transaction state.
            List<string> segments = key.Split("/");
            for (int k = 0; k < segments.Count; k = k + 1) {
                if (segments[k] == "_appupdate" || segments[k] == "_appupdate.lock") { return false; }
            }
            seen.Add(key, true);
            total = total + f.size;
            if (total > 268435456L) { return false; }
        }
        for (int i = 0; i < manifest.files.Count; i = i + 1) {
            string key = manifest.files[i].path.ToLower();
            int slash = key.IndexOf("/");
            while (slash >= 0) {
                if (seen.ContainsKey(key.Substring(0, slash))) { return false; }
                slash = key.IndexOf("/", slash + 1);
            }
        }
        return true;
    }

    public static bool VerifyManifestSignature(UpdateManifest manifest, UpdateProgressCallback cb) {
        string anchors = AppUpdater.signerKeyHex;
        if (!ValidManifest(manifest) || anchors == "") {
            if (cb != null) { cb(UpdateProgressInfo.Fail(UpdatePhase.Failed, "Missing trusted signer, signature or SHA-256 metadata")); }
            return false;
        }
        bool ok = TrustedRsaKeys.VerifyHex(anchors, manifest.SigningPayload(), manifest.Signature());
        if (!ok && cb != null) { cb(UpdateProgressInfo.Fail(UpdatePhase.Failed, "Manifest signature rejected")); }
        return ok;
    }

    // Check ancestry as well as the leaf: a safe relative name can traverse an existing link.
    public static bool SafeDestination(string root, string rel) {
        if (root == null || root.Length == 0 || !UpdateFileEntry.SafeRelPath(rel)) { return false; }
        string current = Path.GetFullPath(root + "/" + rel);
        if (current == null || current.Length == 0) { return false; }
        while (current.Length > 0) {
            if (File.IsReparsePoint(current)) { return false; }
            string parent = Path.GetDirectoryName(current);
            if (parent == null || parent == current) { break; }
            current = parent;
        }
        return true;
    }

    public static bool HasNewVersion(string currentVersion, string remoteVersion) {
        if (remoteVersion == null || remoteVersion.Length == 0) { return false; }
        if (currentVersion == null || currentVersion.Length == 0) { return true; }
        if (currentVersion == remoteVersion) { return false; }
        List<string> cParts = SplitVersion(currentVersion);
        List<string> rParts = SplitVersion(remoteVersion);
        int maxLen = cParts.Count > rParts.Count ? cParts.Count : rParts.Count;
        for (int i = 0; i < maxLen; i = i + 1) {
            int cNum = i < cParts.Count ? ParseIntSafe(cParts[i]) : 0;
            int rNum = i < rParts.Count ? ParseIntSafe(rParts[i]) : 0;
            if (rNum > cNum) { return true; }
            if (rNum < cNum) { return false; }
        }
        return false;
    }

    public static List<string> SplitVersion(string v) {
        List<string> res = new List<string>();
        string cur = "";
        for (int i = 0; i < v.Length; i = i + 1) {
            string ch = v.Substring(i, 1);
            if (ch == "." || ch == "-" || ch == "_") {
                if (cur.Length > 0) { res.Add(cur); cur = ""; }
            } else { cur = cur + ch; }
        }
        if (cur.Length > 0) { res.Add(cur); }
        return res;
    }

    public static int ParseIntSafe(string s) {
        if (s == null || s.Length == 0) { return 0; }
        int n = 0;
        for (int i = 0; i < s.Length; i = i + 1) {
            int code = s[i];
            if (code < 48 || code > 57 || n > 214748364 || (n == 214748364 && code > 55)) { break; }
            n = n * 10 + code - 48;
        }
        return n;
    }

    // A diagnostic digest check does not authorize installation.
    public static bool VerifyZipPackage(string zipPath, string expectedSha256, UpdateProgressCallback cb) {
        if (!IsHex(expectedSha256, 64, 64) || !File.Exists(zipPath) || File.GetSize64(zipPath) > 268435456L) { return false; }
        byte[] bytes = File.ReadAllBytes(zipPath);
        return bytes != null && HashBytes(bytes) == expectedSha256.ToLower();
    }

    private static int ReadU16(byte[] bytes, int pos) {
        return (bytes[pos] & 255) | ((bytes[pos + 1] & 255) << 8);
    }

    private static long ReadU32(byte[] bytes, int pos) {
        return (long)ReadU16(bytes, pos) | ((long)ReadU16(bytes, pos + 2) << 16);
    }

    private static List<ZipEntry> ReadVerifiedPackage(string zipPath, UpdateManifest manifest) {
        if (!File.Exists(zipPath) || File.GetSize64(zipPath) != manifest.packageSize) { return null; }
        byte[] bytes = File.ReadAllBytes(zipPath);
        if (bytes == null || bytes.Length != manifest.packageSize || HashBytes(bytes) != manifest.packageSha256.ToLower()) { return null; }
        List<ZipEntry> entries = Zip.Read(bytes);
        if (entries == null || entries.Count != manifest.files.Count) { return null; }
        Dictionary<string, bool> seen = new Dictionary<string, bool>();
        for (int i = 0; i < entries.Count; i = i + 1) {
            ZipEntry e = entries[i];
            if (e == null || e.isDirectory || !UpdateFileEntry.SafeRelPath(e.name)) { return null; }
            string rel = UpdateFileEntry.NormalizePath(e.name);
            string key = rel.ToLower();
            if (seen.ContainsKey(key)) { return null; }
            seen.Add(key, true);
            UpdateFileEntry f = manifest.FindFile(rel);
            if (f == null || f.size != e.uncompressedSize || e.compressedSize < 0 || e.compressedSize > 268435456) { return null; }
            if (e.method != 0 && e.method != 8) { return null; }
            // Disallow Zip.Extract's scan fallback and local/central size disagreement.
            int pos = e.localHeaderOffset;
            if (pos < 0 || (long)pos + 30L > bytes.Length || ReadU32(bytes, pos) != Zip.SigLocal) { return null; }
            int flags = ReadU16(bytes, pos + 6);
            int nameLen = ReadU16(bytes, pos + 26);
            int extraLen = ReadU16(bytes, pos + 28);
            long dataPos = (long)pos + 30L + nameLen + extraLen;
            if ((flags & 1) != 0 || ReadU16(bytes, pos + 8) != e.method || nameLen != e.name.Length || dataPos + e.compressedSize > bytes.Length) { return null; }
            for (int k = 0; k < nameLen; k = k + 1) {
                if ((bytes[pos + 30 + k] & 255) != (e.name[k] & 255)) { return null; }
            }
            long localCompressed = ReadU32(bytes, pos + 18);
            long localSize = ReadU32(bytes, pos + 22);
            if (!((localCompressed == e.compressedSize && localSize == e.uncompressedSize) || ((flags & 8) != 0 && localCompressed == 0 && localSize == 0))) { return null; }
            byte[] extracted = Zip.Extract(bytes, e);
            if (extracted == null || extracted.Length != f.size || HashBytes(extracted) != f.sha256.ToLower()) { return null; }
            e.name = rel;
            e.data = extracted;
        }
        return entries;
    }

    // Isolate mutable caller metadata while preserving every signed field's
    // exact representation and order. Signature verification follows the copy.
    internal static UpdateManifest Snapshot(UpdateManifest source) {
        try {
            if (!ValidManifest(source)) { return null; }
            UpdateManifest copy = new UpdateManifest();
            copy.appName = source.appName;
            copy.version = source.version;
            copy.releaseDate = source.releaseDate;
            copy.packageUrl = source.packageUrl;
            copy.packageSize = source.packageSize;
            copy.packageSha256 = source.packageSha256;
            copy.packageMd5 = source.packageMd5;
            copy.changelog = source.changelog;
            copy.signature = source.signature;
            for (int i = 0; i < source.files.Count; i = i + 1) {
                UpdateFileEntry item = source.files[i];
                UpdateFileEntry entry = new UpdateFileEntry();
                entry.path = item.path;
                entry.size = item.size;
                entry.sha256 = item.sha256;
                entry.md5 = item.md5;
                entry.required = item.required;
                copy.files.Add(entry);
            }
            return copy;
        } catch (Exception ex) { return null; }
    }

    // No unsigned overload: every production write requires a signed manifest.
    public static bool ApplyPackage(string zipPath, UpdateManifest manifest, string targetAppDir, bool backupOld, UpdateProgressCallback cb) {
        if (!ValidManifest(manifest)) { return false; }
        UpdateManifest snapshot = Snapshot(manifest);
        if (!VerifyManifestSignature(snapshot, null)) { return false; }
        List<ZipEntry> entries = ReadVerifiedPackage(zipPath, snapshot);
        if (entries == null) { return false; }
        try {
            if (!InstallTransaction.Install(targetAppDir, snapshot, entries, backupOld)) { return false; }
        } catch (Exception ex) { return false; }
        if (cb != null) { cb(UpdateProgressInfo.Create(UpdatePhase.Completed, 100, "", "Authenticated package installed")); }
        return true;
    }

    public static IntegrityReport VerifyAndSelfHeal(string targetAppDir, UpdateManifest manifest, string recoveryZipPath, UpdateProgressCallback cb) {
        IntegrityReport report = TamperDetector.Check(targetAppDir, manifest, null);
        if (!report.isClean && report.issues.Count > 0 && recoveryZipPath != null && recoveryZipPath.Length > 0) {
            TamperDetector.RestoreFromZip(targetAppDir, manifest, report, recoveryZipPath, null);
        }
        if (cb != null) {
            cb(UpdateProgressInfo.Create(report.isClean ? UpdatePhase.Completed : UpdatePhase.Failed, 100, "", report.isClean ? "Integrity verified" : "Integrity or recovery rejected"));
        }
        return report;
    }

    public static bool UpdateTo(string currentVersion, string manifestPath, string localZipPath, string targetAppDir, bool backupOld, UpdateProgressCallback cb) {
        UpdateManifest manifest = UpdateManifest.LoadFromFile(manifestPath);
        if (manifest == null) { return false; }
        if (!VerifyManifestSignature(manifest, null)) { return false; }
        if (!HasNewVersion(currentVersion, manifest.version)) { return true; }
        if (!ApplyPackage(localZipPath, manifest, targetAppDir, backupOld, null)) { return false; }
        IntegrityReport report = TamperDetector.Check(targetAppDir, manifest, cb);
        return report.isClean;
    }

    public static void RestoreExecutablePermissionIfNeeded(string filePath, byte[] content) {
        #if !WINDOWS
        if (filePath == null || content == null || content.Length < 2) { return; }
        bool isExec = filePath.EndsWith(".sh") || (content[0] == 35 && content[1] == 33);
        if (content.Length >= 4) {
            if (content[0] == 0x7F && content[1] == 0x45 && content[2] == 0x4C && content[3] == 0x46) { isExec = true; }
            if ((content[0] == 0xCF || content[0] == 0xCE) && content[1] == 0xFA && content[2] == 0xED && content[3] == 0xFE) { isExec = true; }
            if (content[0] == 0xCA && content[1] == 0xFE && content[2] == 0xBA && content[3] == 0xBE) { isExec = true; }
        }
        if (isExec) { File.SetExecutable(filePath, true); }
        #endif
    }
}
