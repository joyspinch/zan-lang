using System;
using System.IO;

namespace AppUpdate;

public class TamperDetector {
    // Untrusted metadata must never direct local filesystem inspection.
    public static IntegrityReport Check(string appDir, UpdateManifest manifest, UpdateProgressCallback cb) {
        IntegrityReport report = new IntegrityReport();
        if (manifest == null || !AppUpdater.ValidManifest(manifest)) {
            report.isClean = false;
            return report;
        }
        UpdateManifest snapshot = AppUpdater.Snapshot(manifest);
        if (!AppUpdater.VerifyManifestSignature(snapshot, null)) {
            report.isClean = false;
            return report;
        }
        for (int i = 0; i < snapshot.files.Count; i = i + 1) {
            UpdateFileEntry expected = snapshot.files[i];
            if (!AppUpdater.SafeDestination(appDir, expected.path)) {
                report.isClean = false;
                return report;
            }
        }
        report.totalChecked = snapshot.files.Count;
        for (int i = 0; i < snapshot.files.Count; i = i + 1) {
            UpdateFileEntry expected = snapshot.files[i];
            string fullPath = appDir + "/" + expected.path;
            if (!File.Exists(fullPath)) {
                report.AddIssue(TamperFileIssue.Create(expected.path, FileIntegrityStatus.Missing, expected.sha256, "", expected.size, 0));
            } else {
                long size = File.GetSize64(fullPath);
                // Do not allocate an attacker-grown file; a size mismatch already proves damage.
                string digest = "";
                if (size == expected.size) { digest = AppUpdater.HashBytes(File.ReadAllBytes(fullPath)); }
                if (size != expected.size || digest != expected.sha256.ToLower()) {
                    report.AddIssue(TamperFileIssue.Create(expected.path, FileIntegrityStatus.Tampered, expected.sha256, digest, expected.size, size));
                } else {
                    report.okCount = report.okCount + 1;
                }
            }
        }
        if (cb != null) {
            cb(UpdateProgressInfo.Create(report.isClean ? UpdatePhase.Completed : UpdatePhase.SelfHealing, 100, "", "SHA-256 integrity check complete"));
        }
        return report;
    }

    // Recovery reinstalls the authenticated package, then rechecks disk contents.
    // The caller's mutable report is output only; it never authorizes paths or bytes.
    public static int RestoreFromZip(string appDir, UpdateManifest manifest, IntegrityReport report, string zipPackagePath, UpdateProgressCallback cb) {
        if (report == null) { return 0; }
        report.isClean = false;
        report.restoredCount = 0;
        IntegrityReport before = Check(appDir, manifest, null);
        if (before.isClean) {
            report.isClean = true;
            report.totalChecked = before.totalChecked;
            report.okCount = before.okCount;
            report.missingCount = 0;
            report.tamperedCount = 0;
            report.issues = before.issues;
            return 0;
        }
        if (before.issues.Count == 0) { return 0; }
        if (!AppUpdater.ApplyPackage(zipPackagePath, manifest, appDir, false, null)) { return 0; }
        IntegrityReport after = Check(appDir, manifest, null);
        report.isClean = after.isClean;
        report.totalChecked = after.totalChecked;
        report.okCount = after.okCount;
        report.missingCount = after.missingCount;
        report.tamperedCount = after.tamperedCount;
        report.issues = before.issues;
        if (after.isClean) {
            report.restoredCount = before.issues.Count;
            for (int i = 0; i < report.issues.Count; i = i + 1) { report.issues[i].restored = true; }
        }
        if (cb != null) { cb(UpdateProgressInfo.Create(after.isClean ? UpdatePhase.Completed : UpdatePhase.Failed, 100, "", "Authenticated recovery finished")); }
        return report.restoredCount;
    }
}
