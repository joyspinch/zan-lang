using System;

namespace System.Configuration;

// 配置值的严格解析。
//
// 系统自带的 Convert.ToInt32 / ToInt64 对非法文本静默返回 0（不抛异常），
// 配置读取若直接用它们，"port": "abc" 会被读成 0，而不是调用方给的默认
// 值——原先 ConfigurationRoot.GetInt 里的 try/catch 因此从不触发。这里
// 自己严格解析：非法文本一律判失败，交给调用方回落到默认值。
public class ConfigurationValues {
    // 严格解析 32 位整数：只接受可选正负号 + 十进制数字（允许首尾空白）。
    public static bool TryParseInt(string text, out int value) {
        value = 0;
        long parsed = 0;
        if (!TryParseInteger(text, out parsed)) { return false; }
        if (parsed > 2147483647L || parsed < -2147483648L) { return false; }
        value = (int)parsed;
        return true;
    }

    // 严格解析 64 位整数：规则同 TryParseInt，只是范围更大。
    public static bool TryParseLong(string text, out long value) {
        value = 0L;
        long parsed = 0L;
        if (!TryParseInteger(text, out parsed)) { return false; }
        value = parsed;
        return true;
    }

    // 严格解析布尔：接受 true/false/1/0/yes/no/on/off（不区分大小写）。
    public static bool TryParseBool(string text, out bool value) {
        value = false;
        if (text == null) { return false; }
        string lower = text.Trim().ToLower();
        if (lower == "true" || lower == "1" || lower == "yes" || lower == "on") {
            value = true;
            return true;
        }
        if (lower == "false" || lower == "0" || lower == "no" || lower == "off") {
            value = false;
            return true;
        }
        return false;
    }

    // 整数文本的公共解析：可选正负号 + 至少一位十进制数字，
    // 不允许中间夹带空白或其它字符。累加用 long，避免长文本回绕。
    public static bool TryParseInteger(string text, out long value) {
        value = 0L;
        if (text == null) { return false; }
        string s = text.Trim();
        if (s.Length == 0) { return false; }
        int i = 0;
        bool neg = false;
        int c0 = s[0] & 255;
        if (c0 == 43 || c0 == 45) {          // '+' / '-'
            neg = (c0 == 45);
            i = 1;
        }
        if (i >= s.Length) { return false; }
        long acc = 0L;
        for (; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { return false; }
            acc = acc * 10L + (long)(c - 48);
            // 19 位十进制已超出 int64 的安全范围，直接判失败。
            if (acc > 922337203685477580L) { return false; }
        }
        value = neg ? -acc : acc;
        return true;
    }
}
