using System;

namespace System.Configuration;

// 配置值的严格解析（直接对接系统标准 TryParse 原语）。
public class ConfigurationValues {
    private static string TrimFast(string text) {
        int n = text.Length;
        if (n == 0) { return text; }
        if ((text[0] & 255) > 32 && (text[n - 1] & 255) > 32) { return text; }
        return text.Trim();
    }

    private static bool EqualsRangeAsciiIgnoreCase(string s, int start, int len, string lowerLit) {
        if (len != lowerLit.Length) { return false; }
        for (int i = 0; i < len; i = i + 1) {
            int c = s[start + i] & 255;
            if (c >= 65 && c <= 90) { c = c + 32; }
            if (c != (lowerLit[i] & 255)) { return false; }
        }
        return true;
    }

    // 严格解析 32 位整数：只接受可选正负号 + 十进制数字（允许首尾空白）。
    public static bool TryParseInt(string text, out int value) {
        if (text == null) { value = 0; return false; }
        return int.TryParse(ConfigurationValues.TrimFast(text), out value);
    }

    // 严格解析 64 位整数：规则同 TryParseInt，只是范围更大。
    public static bool TryParseLong(string text, out long value) {
        if (text == null) { value = 0L; return false; }
        return long.TryParse(ConfigurationValues.TrimFast(text), out value);
    }

    // 严格解析布尔：接受 true/false/1/0/yes/no/on/off（不区分大小写）。
    public static bool TryParseBool(string text, out bool value) {
        value = false;
        if (text == null) { return false; }
        int start = 0;
        int end = text.Length;
        while (start < end && (text[start] & 255) <= 32) { start = start + 1; }
        while (end > start && (text[end - 1] & 255) <= 32) { end = end - 1; }
        int len = end - start;
        if (len == 0) { return false; }
        if (len == 1) {
            int c = text[start] & 255;
            if (c == 49) { value = true; return true; }
            if (c == 48) { value = false; return true; }
            return false;
        }
        if (ConfigurationValues.EqualsRangeAsciiIgnoreCase(text, start, len, "true")
            || ConfigurationValues.EqualsRangeAsciiIgnoreCase(text, start, len, "yes")
            || ConfigurationValues.EqualsRangeAsciiIgnoreCase(text, start, len, "on")) {
            value = true;
            return true;
        }
        if (ConfigurationValues.EqualsRangeAsciiIgnoreCase(text, start, len, "false")
            || ConfigurationValues.EqualsRangeAsciiIgnoreCase(text, start, len, "no")
            || ConfigurationValues.EqualsRangeAsciiIgnoreCase(text, start, len, "off")) {
            value = false;
            return true;
        }
        return false;
    }

    // 整数文本的公共解析（向后兼容保留，委托 long.TryParse）。
    public static bool TryParseInteger(string text, out long value) {
        return TryParseLong(text, out value);
    }
}
