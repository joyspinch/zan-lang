using System;

namespace System.Configuration;

// 配置值的严格解析（直接对接系统标准 TryParse 原语）。
public class ConfigurationValues {
    // 严格解析 32 位整数：只接受可选正负号 + 十进制数字（允许首尾空白）。
    public static bool TryParseInt(string text, out int value) {
        if (text == null) { value = 0; return false; }
        return int.TryParse(text.Trim(), out value);
    }

    // 严格解析 64 位整数：规则同 TryParseInt，只是范围更大。
    public static bool TryParseLong(string text, out long value) {
        if (text == null) { value = 0L; return false; }
        return long.TryParse(text.Trim(), out value);
    }

    // 严格解析布尔：接受 true/false/1/0/yes/no/on/off（不区分大小写）。
    public static bool TryParseBool(string text, out bool value) {
        value = false;
        if (text == null) { return false; }
        string trimmed = text.Trim();
        if (bool.TryParse(trimmed, out value)) {
            return true;
        }
        string lower = trimmed.ToLower();
        if (lower == "1" || lower == "yes" || lower == "on") {
            value = true;
            return true;
        }
        if (lower == "0" || lower == "no" || lower == "off") {
            value = false;
            return true;
        }
        return false;
    }

    // 整数文本的公共解析（向后兼容保留，委托 long.TryParse）。
    public static bool TryParseInteger(string text, out long value) {
        return TryParseLong(text, out value);
    }
}
