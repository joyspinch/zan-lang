using System;
using System.Collections.Generic;
using System.Text;

namespace System.Configuration;

// dotenv 风格的配置文件提供程序：一行一条 "KEY=VALUE"。
//
// 解析规则：
//   - 空行与以 '#' 开头的行忽略；
//   - 允许 "export " 前缀；
//   - 值用双引号包裹时按转义展开（\n \t \r \\ \"），用单引号包裹时取字面量；
//   - 未加引号的值去掉行尾注释（' #' 之后的部分，'#' 前必须有空白，
//     这样 "a#b" 里的 '#' 不会被当成注释起点）；
//   - 没有 '=' 的行忽略；
//   - 键里的 '__' 与 ':' 等价，所以 "DATABASE__PORT" 与 "Database:Port"
//     落到同一个配置键。
public class EnvFileConfigurationProvider : ConfigurationProvider {
    public string path;
    public bool optional;

    public EnvFileConfigurationProvider(string path) : base() {
        this.path = path;
        this.optional = false;
    }

    public EnvFileConfigurationProvider(string path, bool optional) : base() {
        this.path = path;
        this.optional = optional;
    }

    private static bool IsTrimWs(int c) {
        return c == 32 || c == 9 || c == 10 || c == 13 || c == 11 || c == 12;
    }

    // 读文件并重建内容。文件不存在时：optional 为真则跳过，
    // 否则抛 FileNotFoundException（配置缺文件是启动期错误，不该静默）。
    public override void Load() {
        if (this.path == null || this.path.Length == 0) { return; }
        if (!File.Exists(this.path)) {
            if (this.optional) {
                this.data.Clear();
                return;
            }
            throw new FileNotFoundException("Configuration file not found: " + this.path);
        }
        string text = File.ReadAllText(this.path);
        this.data.Clear();
        int n = text.Length;
        nint tp = (nint)text;
        int pos = 0;
        while (pos < n) {
            int nl = NativeMemory.Find(tp, pos, 10, n - pos);
            int end = nl >= 0 ? nl : n;
            this.ParseLineSlice(text, tp, pos, end);
            if (nl < 0) { break; }
            pos = nl + 1;
        }
    }

    // 解析一行 "KEY=VALUE"。
    protected void ParseLine(string rawLine) {
        if (rawLine == null || rawLine.Length == 0) { return; }
        this.ParseLineSlice(rawLine, (nint)rawLine, 0, rawLine.Length);
    }

    private void ParseLineSlice(string text, nint tp, int start, int end) {
        int s = start;
        int e = end;
        while (s < e && EnvFileConfigurationProvider.IsTrimWs(text[s] & 255)) { s = s + 1; }
        while (e > s && EnvFileConfigurationProvider.IsTrimWs(text[e - 1] & 255)) { e = e - 1; }
        if (s >= e) { return; }
        if ((text[s] & 255) == 35) { return; } // '#'
        if (e - s >= 7
            && (text[s] & 255) == 101
            && (text[s + 1] & 255) == 120
            && (text[s + 2] & 255) == 112
            && (text[s + 3] & 255) == 111
            && (text[s + 4] & 255) == 114
            && (text[s + 5] & 255) == 116
            && (text[s + 6] & 255) == 32) {
            s = s + 7;
            while (s < e && EnvFileConfigurationProvider.IsTrimWs(text[s] & 255)) { s = s + 1; }
        }
        int eq = s < e ? NativeMemory.Find(tp, s, 61, e - s) : -1;
        if (eq < 0) { return; }
        int ks = s;
        int ke = eq;
        while (ke > ks && EnvFileConfigurationProvider.IsTrimWs(text[ke - 1] & 255)) { ke = ke - 1; }
        if (ks >= ke) { return; }
        int vs = eq + 1;
        int ve = e;
        bool hadLeadingWs = false;
        while (vs < ve && EnvFileConfigurationProvider.IsTrimWs(text[vs] & 255)) {
            vs = vs + 1;
            hadLeadingWs = true;
        }
        string rawKey = text.Substring(ks, ke - ks);
        string value = (hadLeadingWs && vs < ve && (text[vs] & 255) == 35)
            ? ""
            : EnvFileConfigurationProvider.ParseValueSlice(text, tp, vs, ve);
        this.Set(rawKey, value);
    }

    private static bool IsTrailingCommentOrWs(string raw, int pos, int end) {
        int p = pos;
        while (p < end && EnvFileConfigurationProvider.IsTrimWs(raw[p] & 255)) { p = p + 1; }
        if (p >= end) { return true; }
        return p > pos && (raw[p] & 255) == 35;
    }

    private static string ParseValueSlice(string raw, nint rp, int start, int end) {
        int len = end - start;
        if (len < 2) {
            return (start == 0 && end == raw.Length) ? raw : raw.Substring(start, len);
        }
        int first = raw[start] & 255;
        int last = raw[end - 1] & 255;
        if (first == 34) {
            if (last == 34) {
                return EnvFileConfigurationProvider.UnescapeSlice(raw, rp, start + 1, end - 1);
            }
            int p = start + 1;
            while (p < end) {
                int c = raw[p] & 255;
                if (c == 92) {
                    p = p + 2;
                    continue;
                }
                if (c == 34) {
                    if (EnvFileConfigurationProvider.IsTrailingCommentOrWs(raw, p + 1, end)) {
                        return EnvFileConfigurationProvider.UnescapeSlice(raw, rp, start + 1, p);
                    }
                    break;
                }
                p = p + 1;
            }
        }
        if (first == 39) {
            if (last == 39) {
                return raw.Substring(start + 1, len - 2);
            }
            int close = NativeMemory.Find(rp, start + 1, 39, end - (start + 1));
            if (close >= 0 && EnvFileConfigurationProvider.IsTrailingCommentOrWs(raw, close + 1, end)) {
                return raw.Substring(start + 1, close - (start + 1));
            }
        }
        return EnvFileConfigurationProvider.StripInlineCommentSlice(raw, rp, start, end);
    }

    // 取值的字面形式：双引号解转义、单引号取字面量、其余去行尾注释。
    public static string ParseValue(string raw) {
        if (raw == null || raw.Length < 2) { return raw; }
        return EnvFileConfigurationProvider.ParseValueSlice(raw, (nint)raw, 0, raw.Length);
    }

    private static string StripInlineCommentSlice(string raw, nint rp, int start, int end) {
        int scan = start + 1;
        int hash = -1;
        while (scan < end) {
            int hit = NativeMemory.Find(rp, scan, 35, end - scan);
            if (hit < 0) { break; }
            int prev = raw[hit - 1] & 255;
            if (prev == 32 || prev == 9) { hash = hit; break; }
            scan = hit + 1;
        }
        if (hash < 0) {
            return (start == 0 && end == raw.Length) ? raw : raw.Substring(start, end - start);
        }
        int ts = start;
        int te = hash;
        while (ts < te && EnvFileConfigurationProvider.IsTrimWs(raw[ts] & 255)) { ts = ts + 1; }
        while (te > ts && EnvFileConfigurationProvider.IsTrimWs(raw[te - 1] & 255)) { te = te - 1; }
        return raw.Substring(ts, te - ts);
    }

    // 去掉未加引号值里的行尾注释：'#' 前有空白才算注释起点。
    public static string StripInlineComment(string raw) {
        if (raw == null || raw.Length < 2) { return raw; }
        return EnvFileConfigurationProvider.StripInlineCommentSlice(raw, (nint)raw, 0, raw.Length);
    }

    private static string UnescapeSlice(string text, nint tp, int start, int end) {
        int len = end - start;
        if (len <= 0) { return ""; }
        int firstBs = NativeMemory.Find(tp, start, 92, len);
        if (firstBs < 0) {
            return (start == 0 && end == text.Length) ? text : text.Substring(start, len);
        }
        byte[] buf = new byte[len];
        nint bp = (nint)buf;
        int cur = start;
        int dst = 0;
        int hit = firstBs;
        while (hit >= 0 && hit + 1 < end) {
            int nextCh = text[hit + 1] & 255;
            int mapped = 0;
            if (nextCh == 110) { mapped = 10; }
            else if (nextCh == 116) { mapped = 9; }
            else if (nextCh == 114) { mapped = 13; }
            else if (nextCh == 92) { mapped = 92; }
            else if (nextCh == 34) { mapped = 34; }
            if (mapped != 0) {
                int run = hit - cur;
                if (run > 0) {
                    NativeMemory.Copy(bp + (nint)dst, tp + (nint)cur, run);
                    dst = dst + run;
                }
                buf[dst] = (byte)mapped;
                dst = dst + 1;
                cur = hit + 2;
                hit = cur < end ? NativeMemory.Find(tp, cur, 92, end - cur) : -1;
            } else {
                int nextSearch = hit + 1;
                hit = nextSearch < end ? NativeMemory.Find(tp, nextSearch, 92, end - nextSearch) : -1;
            }
        }
        int rem = end - cur;
        if (rem > 0) {
            NativeMemory.Copy(bp + (nint)dst, tp + (nint)cur, rem);
            dst = dst + rem;
        }
        return NativeMemory.GetString(bp, 0, dst);
    }

    // 双引号里的转义展开：\n \t \r \\ \"，其余反斜杠原样保留。
    public static string Unescape(string text) {
        if (text == null) { return ""; }
        return EnvFileConfigurationProvider.UnescapeSlice(text, (nint)text, 0, text.Length);
    }
}
