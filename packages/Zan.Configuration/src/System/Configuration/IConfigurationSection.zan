using System;
using System.Collections.Generic;

namespace System.Configuration;

public interface IConfigurationSection {
    // 获取指定键的配置值，不存在时返回 null。
    string Get(string key);

    // 获取字符串配置值，不存在时返回默认值。
    string GetString(string key, string defaultValue);

    // 获取 32 位整型配置值，不存在或解析失败时返回默认值。
    int GetInt(string key, int defaultValue);

    // 获取 64 位长整型配置值，不存在或解析失败时返回默认值。
    long GetLong(string key, long defaultValue);

    // 获取布尔型配置值（支持 true/false/1/0/yes/no），不存在或解析失败时返回默认值。
    bool GetBool(string key, bool defaultValue);

    // 获取当前节在其父级中的键名（如 "ConnectionStrings"）。
    string GetKey();

    // 获取当前节从根路径开始的完整层级路径（如 "Database:ConnectionStrings"）。
    string GetPath();

    // 获取当前节的原始标量值。
    string GetValue();

    // 设置当前节的原始标量值。
    void SetValue(string val);

    // 获取指定节名的子配置小节。
    IConfigurationSection GetSection(string sectionKey);

    // 获取当前作用域下的全部直接子键列表。
    List<string> GetKeys();
}
