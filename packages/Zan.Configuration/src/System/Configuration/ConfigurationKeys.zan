using System;
using System.Collections.Generic;

namespace System.Configuration;

// 配置键的规范化与映射规则。内存 / JSON / dotenv / 环境变量四种来源
// 共用同一套键空间：查询时先规范化，存放时也存规范化后的键，
// 于是 "database:port"、"DATABASE__PORT"、"Database:Port" 命中同一条配置。
//
// 规范形式：键由若干"段"组成，段分隔符在配置键里是 ':'，在环境变量里
// 是 '__'，两者等价；每段规范化成"首字母大写、其余小写"。
//   "database:port"  → "Database:Port"
//   "DATABASE__PORT" → "Database:Port"
//   "myKey"           → "Mykey"
// 规范化是幂等的：Canonical(Canonical(k)) == Canonical(k)。
public class ConfigurationKeys {
    // 配置键形式的段分隔符。
    public static string SectionSeparator = ":";

    // 环境变量形式的段分隔符。
    public static string EnvironmentSeparator = "__";

    private static string SafeSectionSep() {
        return (SectionSeparator != null && SectionSeparator.Length > 0) ? SectionSeparator : ":";
    }

    private static string SafeEnvSep() {
        return (EnvironmentSeparator != null && EnvironmentSeparator.Length > 0) ? EnvironmentSeparator : "__";
    }

    private static bool IsDefaultSeps() {
        return SectionSeparator == ":" && EnvironmentSeparator == "__";
    }

    private static bool IsTrimWs(int c) {
        return c == 32 || c == 9 || c == 10 || c == 13 || c == 11 || c == 12;
    }

    private static void NormalizePrefixBounds(string prefix, out int ps, out int pe) {
        ps = 0;
        pe = 0;
        if (prefix == null || prefix.Length == 0) { return; }
        int n = prefix.Length;
        Span<byte> pb = new Span<byte>((nint)prefix, n);
        int s = 0;
        int e = n;
        while (s < e && IsTrimWs(pb[s])) { s = s + 1; }
        while (e > s && IsTrimWs(pb[e - 1])) { e = e - 1; }
        while (e > s && pb[e - 1] == 95) { e = e - 1; }
        ps = s;
        pe = e;
    }

    private static string CanonicalSliceDefault(string key, int start, int end) {
        int sliceLen = end - start;
        if (sliceLen <= 0) { return ""; }
        Span<byte> kb = new Span<byte>((nint)key, key.Length);
        // 乐观检查：已完全规范化时直接返回原串或零 byte[] 切片；遇到首个非规范字节立即中止进入单趟写缓冲。
        bool exact = true;
        int i = start;
        int segStart = start;
        int segCount = 0;
        while (i <= end) {
            if (i == end || kb[i] == 58) {
                int slen = i - segStart;
                if (slen == 0) { exact = false; break; }
                segCount = segCount + 1;
                i = i + 1;
                segStart = i;
            } else {
                int c = kb[i];
                if (c == 95 && i + 1 < end && kb[i + 1] == 95) { exact = false; break; }
                if (i == segStart) {
                    if (c >= 97 && c <= 122) { exact = false; break; }
                } else {
                    if (c >= 65 && c <= 90) { exact = false; break; }
                }
                i = i + 1;
            }
        }
        if (exact) {
            if (segCount == 0) { return ""; }
            if (start == 0 && end == key.Length) { return key; }
            return key.Substring(start, sliceLen);
        }
        // 非规范形态：单趟写出（输出长度严格 ≤ sliceLen，因为 ':' 1->1，'__' 2->1，空段省略）。
        byte[] buf = new byte[sliceLen];
        Span<byte> dst = new Span<byte>((nint)buf, sliceLen);
        int di = 0;
        int writtenSegs = 0;
        i = start;
        segStart = start;
        while (i <= end) {
            int sepLen = 0;
            if (i == end) {
                sepLen = 1;
            } else {
                int c = kb[i];
                if (c == 58) {
                    sepLen = 1;
                } else if (c == 95 && i + 1 < end && kb[i + 1] == 95) {
                    sepLen = 2;
                }
            }
            if (sepLen > 0) {
                int slen = i - segStart;
                if (slen > 0) {
                    if (writtenSegs > 0) {
                        dst[di] = 58;
                        di = di + 1;
                    }
                    int c0 = kb[segStart];
                    dst[di] = (byte)((c0 >= 97 && c0 <= 122) ? c0 - 32 : c0);
                    di = di + 1;
                    for (int k = segStart + 1; k < i; k = k + 1) {
                        int ck = kb[k];
                        dst[di] = (byte)((ck >= 65 && ck <= 90) ? ck + 32 : ck);
                        di = di + 1;
                    }
                    writtenSegs = writtenSegs + 1;
                }
                i = i + sepLen;
                segStart = i;
            } else {
                i = i + 1;
            }
        }
        if (di == 0) { return ""; }
        return NativeMemory.GetString((nint)buf, 0, di);
    }

    // 单趟直接写入调用方复用 scratch 缓冲区（消除每键一次 byte[] 堆分配与二次扫描）。
    internal static string CanonicalSliceFast(string key, Span<byte> kb, int start, int end, byte[] scratch, Span<byte> dst) {
        if (start >= end) { return ""; }
        if (!IsDefaultSeps()) {
            return Canonical(key.Substring(start, end - start));
        }
        int sliceLen = end - start;
        if (scratch == null || sliceLen > scratch.Length) {
            return CanonicalSliceDefault(key, start, end);
        }
        int di = 0;
        int writtenSegs = 0;
        int i = start;
        int segStart = start;
        while (i <= end) {
            int sepLen = 0;
            if (i == end) {
                sepLen = 1;
            } else {
                int c = kb[i];
                if (c == 58) {
                    sepLen = 1;
                } else if (c == 95 && i + 1 < end && kb[i + 1] == 95) {
                    sepLen = 2;
                }
            }
            if (sepLen > 0) {
                int slen = i - segStart;
                if (slen > 0) {
                    if (writtenSegs > 0) {
                        dst[di] = 58;
                        di = di + 1;
                    }
                    int c0 = kb[segStart];
                    dst[di] = (byte)((c0 >= 97 && c0 <= 122) ? c0 - 32 : c0);
                    di = di + 1;
                    for (int k = segStart + 1; k < i; k = k + 1) {
                        int ck = kb[k];
                        dst[di] = (byte)((ck >= 65 && ck <= 90) ? ck + 32 : ck);
                        di = di + 1;
                    }
                    writtenSegs = writtenSegs + 1;
                }
                i = i + sepLen;
                segStart = i;
            } else {
                i = i + 1;
            }
        }
        if (di == 0) { return ""; }
        return NativeMemory.GetString((nint)scratch, 0, di);
    }

    // 规范化配置键切片 [start, end)（默认分隔符走零 Substring 单趟快路径）。
    public static string CanonicalSlice(string key, int start, int end) {
        if (key == null) { return ""; }
        int n = key.Length;
        if (start < 0) { start = 0; }
        if (end > n) { end = n; }
        if (start >= end) { return ""; }
        if (IsDefaultSeps()) {
            return CanonicalSliceDefault(key, start, end);
        }
        return Canonical(key.Substring(start, end - start));
    }

    // 把任意写法的配置键规范化。
    public static string Canonical(string key) {
        if (key == null || key.Length == 0) { return ""; }
        if (IsDefaultSeps()) {
            return CanonicalSliceDefault(key, 0, key.Length);
        }
        List<string> segs = SplitSegments(key);
        List<string> outSegs = new List<string>();
        for (int i = 0; i < segs.Count; i = i + 1) {
            string s = NormalizeSegment(segs[i]);
            if (s.Length > 0) { outSegs.Add(s); }
        }
        return string.Join(SafeSectionSep(), outSegs);
    }

    // 按分隔符切段：':' 与 '__' 等价。
    public static List<string> SplitSegments(string key) {
        if (key == null) { return new List<string>(); }
        if (IsDefaultSeps()) {
            List<string> outp = new List<string>();
            int n = key.Length;
            int segStart = 0;
            int i = 0;
            while (i < n) {
                int c = key[i] & 255;
                if (c == 58) {
                    outp.Add(key.Substring(segStart, i - segStart));
                    i = i + 1;
                    segStart = i;
                } else if (c == 95 && i + 1 < n && (key[i + 1] & 255) == 95) {
                    outp.Add(key.Substring(segStart, i - segStart));
                    i = i + 2;
                    segStart = i;
                } else {
                    i = i + 1;
                }
            }
            outp.Add(key.Substring(segStart, n - segStart));
            return outp;
        }
        string secSep = SafeSectionSep();
        string envSep = SafeEnvSep();
        string norm = key.Replace(envSep, secSep);
        return norm.Split(secSep);
    }

    // 单段规范化：首字母大写、其余小写。
    public static string NormalizeSegment(string seg) {
        if (seg == null || seg.Length == 0) { return ""; }
        int n = seg.Length;
        Span<byte> sb = new Span<byte>((nint)seg, n);
        bool already = true;
        int c0 = sb[0];
        if (c0 >= 97 && c0 <= 122) {
            already = false;
        } else {
            for (int i = 1; i < n; i = i + 1) {
                int ci = sb[i];
                if (ci >= 65 && ci <= 90) { already = false; break; }
            }
        }
        if (already) { return seg; }
        byte[] buf = new byte[n];
        Span<byte> dst = new Span<byte>((nint)buf, n);
        dst[0] = (byte)((c0 >= 97 && c0 <= 122) ? c0 - 32 : c0);
        for (int i = 1; i < n; i = i + 1) {
            int ci = sb[i];
            dst[i] = (byte)((ci >= 65 && ci <= 90) ? ci + 32 : ci);
        }
        return NativeMemory.GetString((nint)buf, 0, n);
    }

    // 前缀规范化：去掉结尾的下划线，"APP_" / "APP__" / "APP" 等价于 "APP"。
    public static string NormalizePrefix(string prefix) {
        if (prefix == null || prefix.Length == 0) { return ""; }
        int ps = 0;
        int pe = 0;
        NormalizePrefixBounds(prefix, out ps, out pe);
        if (ps >= pe) { return ""; }
        if (ps == 0 && pe == prefix.Length) { return prefix; }
        return prefix.Substring(ps, pe - ps);
    }

    // 配置键 → 环境变量名：段全部大写、用 '__' 连接、再加前缀。
    //   "Database:Port" + 前缀 "APP" → "APP__DATABASE__PORT"
    public static string ToEnvironmentName(string key, string prefix) {
        if (IsDefaultSeps()) {
            int ps = 0;
            int pe = 0;
            NormalizePrefixBounds(prefix, out ps, out pe);
            int pLen = pe - ps;
            int n = key == null ? 0 : key.Length;
            int segCount = 0;
            int charCount = 0;
            int i = 0;
            int segStart = 0;
            while (i <= n) {
                int sepLen = 0;
                if (i == n) {
                    sepLen = 1;
                } else {
                    int c = key[i] & 255;
                    if (c == 58) {
                        sepLen = 1;
                    } else if (c == 95 && i + 1 < n && (key[i + 1] & 255) == 95) {
                        sepLen = 2;
                    }
                }
                if (sepLen > 0) {
                    int slen = i - segStart;
                    if (slen > 0) {
                        segCount = segCount + 1;
                        charCount = charCount + slen;
                    }
                    i = i + sepLen;
                    segStart = i;
                } else {
                    i = i + 1;
                }
            }
            long bodyLenL = segCount == 0 ? 0L : (long)charCount + (long)(segCount - 1) * 2L;
            long totalLenL = pLen > 0 ? (long)pLen + 2L + bodyLenL : bodyLenL;
            if (totalLenL <= 0L) { return ""; }
            if (totalLenL > 2147483647L) {
                throw new ArgumentOutOfRangeException("key");
            }
            int totalLen = (int)totalLenL;
            byte[] buf = new byte[totalLen];
            int di = 0;
            if (pLen > 0) {
                NativeMemory.Copy((nint)buf, (nint)prefix + (nint)ps, pLen);
                buf[pLen] = 95;
                buf[pLen + 1] = 95;
                di = pLen + 2;
            }
            int writtenSegs = 0;
            i = 0;
            segStart = 0;
            while (i <= n) {
                int sepLen = 0;
                if (i == n) {
                    sepLen = 1;
                } else {
                    int c = key[i] & 255;
                    if (c == 58) {
                        sepLen = 1;
                    } else if (c == 95 && i + 1 < n && (key[i + 1] & 255) == 95) {
                        sepLen = 2;
                    }
                }
                if (sepLen > 0) {
                    int slen = i - segStart;
                    if (slen > 0) {
                        if (writtenSegs > 0) {
                            buf[di] = 95;
                            buf[di + 1] = 95;
                            di = di + 2;
                        }
                        for (int k = segStart; k < i; k = k + 1) {
                            int ck = key[k] & 255;
                            buf[di] = (byte)((ck >= 97 && ck <= 122) ? ck - 32 : ck);
                            di = di + 1;
                        }
                        writtenSegs = writtenSegs + 1;
                    }
                    i = i + sepLen;
                    segStart = i;
                } else {
                    i = i + 1;
                }
            }
            return NativeMemory.GetString((nint)buf, 0, totalLen);
        }
        string secSep = SafeSectionSep();
        string envSep = SafeEnvSep();
        string canonical = Canonical(key);
        List<string> segs = canonical.Split(secSep);
        List<string> upper = new List<string>();
        for (int i = 0; i < segs.Count; i = i + 1) {
            if (segs[i].Length > 0) { upper.Add(segs[i].ToUpper()); }
        }
        string body = string.Join(envSep, upper);
        string p = NormalizePrefix(prefix);
        if (p.Length == 0) { return body; }
        return p + envSep + body;
    }

    // 环境变量名 → 配置键：先剥前缀再规范化。
    //   "APP__DATABASE__PORT" + 前缀 "APP" → "Database:Port"
    public static string FromEnvironmentName(string envName, string prefix) {
        if (envName == null || envName.Length == 0) { return ""; }
        if (IsDefaultSeps()) {
            int ps = 0;
            int pe = 0;
            NormalizePrefixBounds(prefix, out ps, out pe);
            int pLen = pe - ps;
            int offset = 0;
            if (pLen > 0 && envName.Length - 2 >= pLen
                && (envName[pLen] & 255) == 95
                && (envName[pLen + 1] & 255) == 95) {
                bool match = true;
                for (int i = 0; i < pLen; i = i + 1) {
                    if ((envName[i] & 255) != (prefix[ps + i] & 255)) {
                        match = false;
                        break;
                    }
                }
                if (match) { offset = pLen + 2; }
            }
            return CanonicalSliceDefault(envName, offset, envName.Length);
        }
        string rest = envName;
        string p = NormalizePrefix(prefix);
        if (p.Length > 0) {
            string head = p + SafeEnvSep();
            if (rest.StartsWith(head)) { rest = rest.Substring(head.Length); }
        }
        return Canonical(rest);
    }
}
