using System;
using System.Text;
using System.Threading;

namespace System.Configuration;

// 内存键值配置提供程序。
public class MemoryConfigurationProvider : ConfigurationProvider {
    public MemoryConfigurationProvider() : base() {
    }

    public MemoryConfigurationProvider(Dictionary<string, string> initialData) : base() {
        if (initialData != null) {
            List<string> keys = initialData.Keys;
            for (int i = 0; i < keys.Count; i = i + 1) {
                string k = keys[i];
                // 走 Set：键要和其它 provider 一样先规范化。
                this.Set(k, initialData[k]);
            }
        }
    }
}
