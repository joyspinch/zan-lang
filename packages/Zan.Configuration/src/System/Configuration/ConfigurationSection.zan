using System;
using System.Text;
using System.Threading;

namespace System.Configuration;

// 表示分层树状配置的一个配置小节实现。
public class ConfigurationSection : IConfigurationSection {
    public IConfiguration root;
    public string path;
    public string key;

    public ConfigurationSection(IConfiguration root, string path) {
        this.root = root;
        // 路径规范化，与 provider 的键空间保持一致（否则用小写节名
        // 取不到 "Database:Port" 这类键）。
        this.path = ConfigurationKeys.Canonical(path);
        int lastColon = this.path.LastIndexOf(":");
        if (lastColon >= 0 && lastColon < this.path.Length - 1) {
            this.key = this.path.Substring(lastColon + 1, this.path.Length - lastColon - 1);
        } else {
            this.key = this.path;
        }
    }

    public string Get(string subKey) {
        return this.root.Get(this.path + ":" + subKey);
    }

    public string GetString(string subKey, string defaultValue) {
        string v = this.Get(subKey);
        return v != null ? v : defaultValue;
    }

    // 取 32 位整型配置值，非法文本返回默认值（严格解析，不用会静默
    // 返回 0 的 Convert.ToInt32）。
    public int GetInt(string subKey, int defaultValue) {
        string v = this.Get(subKey);
        if (v == null) { return defaultValue; }
        int parsed = 0;
        if (!ConfigurationValues.TryParseInt(v, out parsed)) { return defaultValue; }
        return parsed;
    }

    // 取 64 位长整型配置值，非法文本返回默认值。
    public long GetLong(string subKey, long defaultValue) {
        string v = this.Get(subKey);
        if (v == null) { return defaultValue; }
        long parsed = 0L;
        if (!ConfigurationValues.TryParseLong(v, out parsed)) { return defaultValue; }
        return parsed;
    }

    // 取布尔型配置值（支持 true/false/1/0/yes/no/on/off），非法文本返回默认值。
    public bool GetBool(string subKey, bool defaultValue) {
        string v = this.Get(subKey);
        if (v == null) { return defaultValue; }
        bool parsed = false;
        if (!ConfigurationValues.TryParseBool(v, out parsed)) { return defaultValue; }
        return parsed;
    }

    public string GetKey() {
        return this.key;
    }

    public string GetPath() {
        return this.path;
    }

    public string GetValue() {
        return this.root.Get(this.path);
    }

    public void SetValue(string val) {
        // 更新根配置中对应路径的值。
        this.root.Set(this.path, val);
    }

    public IConfigurationSection GetSection(string sectionKey) {
        return this.root.GetSection(this.path + ":" + sectionKey);
    }

    public List<string> GetKeys() {
        List<string> allKeys = this.root.GetKeys();
        List<string> result = new List<string>();
        string pfx = this.path + ":";
        for (int i = 0; i < allKeys.Count; i = i + 1) {
            string k = allKeys[i];
            if (k.StartsWith(pfx)) {
                string sub = k.Substring(pfx.Length, k.Length - pfx.Length);
                result.Add(sub);
            }
        }
        return result;
    }
}
