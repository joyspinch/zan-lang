namespace Game.Debug;

// 实体检查器里的一个字段行：字段名 + 值（已格式化的文本）。
//
// 值一律是**文本**——Zan 没有反射也拿不到强类型字段，检查器不做类型
// 推断，格式化由喂数据的一方负责（引擎那边知道这个字段是血量还是坐标）。
public class DebugFieldRow {
    // 字段名。
    public string name;
    // 字段值的文本形式。
    public string value;

    public DebugFieldRow() {
        this.name = "";
        this.value = "";
    }

    public DebugFieldRow(string name, string value) {
        this.name = name == null ? "" : name;
        this.value = value == null ? "" : value;
    }

    // 一行文本："名字: 值"。
    public string Summary() {
        return this.name + ": " + this.value;
    }

    // 命中过滤串（字段名或值里包含，大小写不敏感）。
    public bool Matches(string query) {
        if (query == null || query == "") { return true; }
        string q = query.ToLower();
        return this.name.ToLower().Contains(q) || this.value.ToLower().Contains(q);
    }
}
