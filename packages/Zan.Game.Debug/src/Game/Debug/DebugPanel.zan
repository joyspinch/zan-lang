using System.Collections.Generic;
using Gui;
using Gui.Widget;

namespace Game.Debug;

// 调试面板：把行模型画成 Gui 控件。
//
// **整个包只有这一个文件依赖 Gui**，其余全是纯逻辑。这样"要在无 GUI 环境
// 用这个包"（服务端 headless 模拟、CI 断面板内容）时，不引 Gui 也能用
// 数据层那套（`DebugText`）。
//
// 面板本身是**薄壳**：它不重算任何东西，只把已经算好的行摆成控件。行从
// 哪来（Profiler 的报告、实体快照）由调用方决定。
//
// 挂到游戏上的方式与 HUD 相同：`HudLayer.Add(debugPanel.BuildOverlay(rows))`。
public class DebugPanel {
    // 帧剖析覆盖层面板。
    //
    // 带条的行用**字符条**呈现——和 `DebugText` 的文本呈现是同一套字符，
    // 于是"面板里看到的"与"日志里截到的"长得一样。
    public static Control BuildOverlay(List<DebugOverlayRow> rows) {
        Panel p = new Panel("debug-overlay");
        if (rows == null) { return p; }
        for (int i = 0; i < rows.Count; i = i + 1) {
            DebugOverlayRow r = rows[i];
            p.Add(new Label(DebugPanel.LineText(r)));
        }
        return p;
    }

    // 实体检查器面板：上半是实体列表，下半是选中实体的组件字段。
    public static Control BuildInspector(List<DebugEntityRow> entities,
        List<DebugComponentRow> components) {
        Panel p = new Panel("debug-inspector");
        if (entities != null) {
            for (int i = 0; i < entities.Count; i = i + 1) {
                p.Add(new Label(entities[i].Summary()));
            }
        }
        if (components != null) {
            for (int i = 0; i < components.Count; i = i + 1) {
                DebugComponentRow c = components[i];
                p.Add(new Label(c.name));
                if (!c.expanded) { continue; }
                for (int k = 0; k < c.fields.Count; k = k + 1) {
                    p.Add(new Label("  " + c.fields[k].Summary()));
                }
            }
        }
        return p;
    }

    // 覆盖层一行的呈现文本（面板与文本呈现共用）。
    public static string LineText(DebugOverlayRow r) {
        if (r.kind == DebugOverlayKind.Header) { return "[" + r.label + "]"; }
        if (r.kind == DebugOverlayKind.Bar) { return r.SummaryWithBar(); }
        return r.Summary();
    }
}
