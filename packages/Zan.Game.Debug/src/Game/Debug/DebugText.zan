using System.Collections.Generic;

namespace Game.Debug;

// 文本呈现：把行模型渲染成纯文本。
//
// 这是**无 GUI 环境下的等价物**——覆盖层在游戏里画成面板，同一份行模型在
// stdout / 日志 / CI 里渲染成文本。两者读的是同一份结构，不是两套各算
// 一遍的逻辑（两套各算一遍迟早对不上）。
//
// 带条的行用**字符条**呈现（`#` 若干格），占比信息不丢：比例在文本里
// 也看得见，CI 里截一段日志就能判断"谁占大头"。
public class DebugText {
    // 覆盖层行 → 多行文本。
    public static List<string> Overlay(List<DebugOverlayRow> rows) {
        List<string> out2 = new List<string>();
        if (rows == null) { return out2; }
        for (int i = 0; i < rows.Count; i = i + 1) {
            DebugOverlayRow r = rows[i];
            if (r.kind == DebugOverlayKind.Header) {
                out2.Add("[" + r.label + "]");
            } else if (r.kind == DebugOverlayKind.Bar) {
                out2.Add(r.SummaryWithBar());
            } else {
                out2.Add(r.Summary());
            }
        }
        return out2;
    }

    // 实体行 → 多行文本。
    public static List<string> Entities(List<DebugEntityRow> rows) {
        List<string> out2 = new List<string>();
        if (rows == null) { return out2; }
        for (int i = 0; i < rows.Count; i = i + 1) {
            out2.Add(rows[i].Summary());
        }
        return out2;
    }

    // 组件行 → 多行文本（组件名一行，字段缩进一行一个）。
    public static List<string> Components(List<DebugComponentRow> rows) {
        List<string> out2 = new List<string>();
        if (rows == null) { return out2; }
        for (int i = 0; i < rows.Count; i = i + 1) {
            out2.Add(rows[i].Summary());
        }
        return out2;
    }

    // 覆盖层行 → 一整段文本（行间用换行连接）。
    public static string OverlayText(List<DebugOverlayRow> rows) {
        List<string> lines = DebugText.Overlay(rows);
        string s = "";
        for (int i = 0; i < lines.Count; i = i + 1) {
            if (i > 0) { s = s + "\n"; }
            s = s + lines[i];
        }
        return s;
    }
}
