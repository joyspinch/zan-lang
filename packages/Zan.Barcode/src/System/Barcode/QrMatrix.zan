namespace System.Barcode;

// 二维码的模块矩阵：version / size / ecl + 边长 size 的模块位图
//（true = 深色，**不含静区**）。
//
// **为什么用行主序一维数组而不是二维数组**：Zan 没有二维数组，二维逻辑
// 要么开 `bool[size][]`（每行一个对象，分配多），要么开一个一维数组自己
// 算下标。解码路径上要访问上百万个模块，一维数组少一层间接、也少一堆
// 分配。`Get(x, y)` 把下标计算收在一处。
public class QrMatrix {
    // 版本号 1..40。
    public int version;
    // 边长（模块数）= version * 4 + 17。
    public int size;
    // 纠错级别。
    public QrEcl ecl;
    // 模块位图（行主序，长度 size * size）。
    public bool[] modules;

    public QrMatrix() {
        this.version = 0;
        this.size = 0;
        this.ecl = QrEcl.M;
        this.modules = new bool[0];
    }

    // (x,y) 处模块是否深色（行主序，不含静区）。
    public bool Get(int x, int y) {
        if (x < 0 || y < 0 || x >= this.size || y >= this.size) { return false; }
        return this.modules[y * this.size + x];
    }
}
