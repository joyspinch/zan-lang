namespace System.Barcode;

// 位流读取器：从数据码字里按位取值（高位在前）。
//
// **为什么单独一个类**：分段解析要反复"读 n 位"，而"位不够了"必须能被
// 察觉——**读越界不是"返回 0"，是"解析失败"**。把边界检查收在这里，
// 解析代码就不用到处判断。
public class QrBitReader {
    // 数据码字。
    int[] data;
    // 已读到的位下标。
    int bitPos;

    public QrBitReader(int[] data) {
        this.data = data != null ? data : new int[0];
        this.bitPos = 0;
    }

    // 还能读出 n 位吗。
    public bool HasMore(int n) {
        return this.bitPos + n <= this.data.Length * 8;
    }

    // 读 n 位（高位在前）。位数不够时返回 0（调用方应先用 HasMore 判断）。
    public int Read(int n) {
        if (n <= 0) { return 0; }
        int val = 0;
        for (int i = 0; i < n; i = i + 1) {
            int idx = this.bitPos + i;
            int byteIdx = idx / 8;
            if (byteIdx >= this.data.Length) { break; }
            int bit = (this.data[byteIdx] >> (7 - idx % 8)) & 1;
            val = (val << 1) | bit;
        }
        this.bitPos = this.bitPos + n;
        return val;
    }

    // 已读到的位数。
    public int Position() {
        return this.bitPos;
    }
}
