using System;

namespace System.Barcode;

// 扫码门面：给一张图，拿一个结果。
//
// **门面只做三件事**：参数校验、把内部解码器的结果转成 `BarcodeResult`、
// 把失败翻译成带错误码的异常。真正的活都在 `QrDecoder` 里——所以想直接用
// 低层能力（自己二值化、自己定变换）的人可以用 `QrDecoder`，不必经过这层。
//
// **零配置**：不需要先设置阈值、缩放因子、期望格式——给图就行。
public class BarcodeScanner {

    // 扫一张图。失败抛 `BarcodeException`（带可区分的错误码）。
    public static BarcodeResult Scan(BarcodeImage img) {
        if (img == null || !img.IsValid()) {
            throw new BarcodeException(BarcodeError.InvalidImage,
                "image is empty or malformed");
        }
        QrDecoder.QrDecodeResult r = QrDecoder.Decode(img);
        BarcodeResult outp = new BarcodeResult();
        outp.format = "QR";
        outp.text = r.text;
        outp.bytes = r.bytes;
        outp.version = r.version;
        outp.size = r.size;
        outp.ecl = r.ecl;
        outp.mask = r.mask;
        outp.moduleSize = r.moduleSize;
        outp.corners = r.corners;
        return outp;
    }

    // 扫一张图，失败时返回 false 而不是抛异常。
    //
    // 连续扫码（摄像头预览帧）时用这个：**每一帧都可能没有码**，那是正常
    // 情况，不该被异常打断。
    public static bool TryScan(BarcodeImage img, BarcodeResult[] outp) {
        try {
            BarcodeResult r = BarcodeScanner.Scan(img);
            if (outp != null && outp.Length > 0) { outp[0] = r; }
            return true;
        } catch (BarcodeException e) {
            return false;
        }
    }
}
