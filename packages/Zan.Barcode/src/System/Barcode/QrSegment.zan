using System;
using System.Collections.Generic;

namespace System.Barcode;

// 一个编码分段：mode 为模式指示符值，chars 是字符数（numeric/alnum 为
// 字符数，byte 为字节数），bits 是该段的数据位（不含模式/计数头）。
//
// 与 `QrBitReader` 里的解码侧分段模型刻意分开：编码侧按"最优分段"把文本
// 拆成若干游程，解码侧按位流里实际读到的模式还原。一个包内两个方向，
// 各自的结构更贴合自己的用法。
public class QrSegment {
    // 模式指示符（1 = numeric / 2 = alphanumeric / 4 = byte）。
    public int mode;
    // 字符数（numeric/alnum）或字节数（byte）。
    public int chars;
    // 该段在源文本里的起始字节位置（编码侧用）。
    public int srcPos;
    // 该段的数据位（不含模式/计数头），高位在前。
    public List<int> bits;

    public QrSegment() {
        this.mode = 0;
        this.chars = 0;
        this.srcPos = 0;
        this.bits = new List<int>();
    }
}
