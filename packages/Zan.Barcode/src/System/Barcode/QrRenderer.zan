namespace System.Barcode;

// 把模块矩阵画成像素。
//
// **为什么包里要有渲染**：二维码的"编码 -> 画出来 -> 再读回来"是一个完整
// 闭环，没有渲染就只能拿外部工具生成图来测；而这个闭环也是判定器的主要
// 依据。渲染本身是纯算术，不依赖任何 GUI 包——显示是调用方的事（画到
// Canvas、写成 PNG、贴到网页都行）。
//
// **注意**：本包**不负责出 PNG/SVG 文件**——那是文件格式的事，交给
// `Zan.IO` / GUI 层；这里只产出像素。
public class QrRenderer {

    // 默认参数。
    public static int DefaultScale() { return 4; }
    public static int DefaultMargin() { return 4; }

    // 渲染成 ARGB32 像素数组（每像素一个 0xAARRGGBB 整数，行主序）。
    //
    // `scale` 是每个模块占多少像素；`margin` 是静区模块数（ISO 建议 4，
    // 没有静区的码很多扫码器认不出来）。
    public static int[] ToArgb(QrMatrix mx, int scale, int margin,
                               int dark, int light) {
        if (mx == null || mx.size <= 0) { return new int[0]; }
        if (scale < 1) { scale = 1; }
        if (margin < 0) { margin = 0; }
        int mods = mx.size + 2 * margin;
        int side = mods * scale;
        int[] outp = new int[side * side];
        for (int i = 0; i < outp.Length; i = i + 1) { outp[i] = light; }
        for (int row = 0; row < mx.size; row = row + 1) {
            for (int col = 0; col < mx.size; col = col + 1) {
                if (!mx.Get(col, row)) { continue; }
                int x0 = (col + margin) * scale;
                int y0 = (row + margin) * scale;
                for (int y = y0; y < y0 + scale; y = y + 1) {
                    int rowBase = y * side;
                    for (int x = x0; x < x0 + scale; x = x + 1) {
                        outp[rowBase + x] = dark;
                    }
                }
            }
        }
        return outp;
    }

    // 渲染成可直接喂给解码器的图像（ARGB -> 亮度平面）。
    public static BarcodeImage ToImage(QrMatrix mx, int scale, int margin) {
        int[] argb = QrRenderer.ToArgb(mx, scale, margin,
                                       0xFF000000, 0xFFFFFFFF);
        int side = mx.size + 2 * margin;
        if (scale < 1) { scale = 1; }
        return BarcodeImage.FromArgb(side * scale, side * scale, argb);
    }
}
