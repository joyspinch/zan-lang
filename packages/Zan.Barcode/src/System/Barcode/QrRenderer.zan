using System;

namespace System.Barcode;

// 把模块矩阵画成像素。
//
// **为什么包里要有渲染**：二维码的"编码 -> 画出来 -> 再读回来"是一个完整
// 闭环，没有渲染就只能拿外部工具生成图来测；而这个闭环也是判定器的主要
// 依据。渲染本身是纯算术，不依赖任何 GUI 包——显示是调用方的事（画到
// Canvas、写成 PNG、贴到网页都行）。
//
// **注意**：本包**不负责出 PNG/SVG 文件**——那是文件格式的事，交给
// `Zan.IO` / GUI 层；这里只产出像素。
public class QrRenderer {

    // 默认参数。
    public static int DefaultScale() { return 4; }
    public static int DefaultMargin() { return 4; }

    // 渲染成 ARGB32 像素数组（每像素一个 0xAARRGGBB 整数，行主序）。
    //
    // `scale` 是每个模块占多少像素；`margin` 是静区模块数（ISO 建议 4，
    // 没有静区的码很多扫码器认不出来）。
    public static int[] ToArgb(QrMatrix mx, int scale, int margin,
                               int dark, int light) {
        if (mx == null || mx.size <= 0) { return new int[0]; }
        if (scale < 1) { scale = 1; }
        if (margin < 0) { margin = 0; }
        int msize = mx.size;
        int mods = msize + 2 * margin;
        int side = mods * scale;
        int rowBytes = side * 4;
        int[] outp = new int[side * side];
        nint basePtr = (nint)outp;
        bool[] modules = mx.modules;

        // 生成单条浅色背景扫描线并按行 NativeMemory.Copy 填充上下静区
        int marginPx = margin * scale;
        if (marginPx > 0) {
            for (int x = 0; x < side; x = x + 1) { outp[x] = light; }
            for (int y = 1; y < marginPx; y = y + 1) {
                NativeMemory.Copy(basePtr + y * rowBytes, basePtr, rowBytes);
            }
            int botStart = (margin + msize) * scale;
            for (int y = botStart; y < side; y = y + 1) {
                NativeMemory.Copy(basePtr + y * rowBytes, basePtr, rowBytes);
            }
        }
        // 每模块行仅渲染首条像素扫描线，再整行 NativeMemory.Copy 复制剩余 scale-1 行
        for (int row = 0; row < msize; row = row + 1) {
            int y0 = (row + margin) * scale;
            int rowBase = y0 * side;
            int mRow = row * msize;
            for (int x = 0; x < marginPx; x = x + 1) { outp[rowBase + x] = light; }
            int px = rowBase + marginPx;
            for (int col = 0; col < msize; col = col + 1) {
                int color = modules[mRow + col] ? dark : light;
                for (int s = 0; s < scale; s = s + 1) {
                    outp[px + s] = color;
                }
                px = px + scale;
            }
            for (int x = 0; x < marginPx; x = x + 1) { outp[px + x] = light; }
            nint srcRow = basePtr + y0 * rowBytes;
            for (int s = 1; s < scale; s = s + 1) {
                NativeMemory.Copy(srcRow + s * rowBytes, srcRow, rowBytes);
            }
        }
        return outp;
    }

    // 渲染成可直接喂给解码器的图像（ARGB -> 亮度平面）。
    public static BarcodeImage ToImage(QrMatrix mx, int scale, int margin) {
        int[] argb = QrRenderer.ToArgb(mx, scale, margin,
                                       0xFF000000, 0xFFFFFFFF);
        int side = mx.size + 2 * margin;
        if (scale < 1) { scale = 1; }
        return BarcodeImage.FromArgb(side * scale, side * scale, argb);
    }
}
