namespace System.Barcode;

// 纠错级别（ISO/IEC 18004）。
//
// 枚举值本身只是包内的稳定标识；**格式信息里的 2 位编码**由 `QrFormat.EclBits`
// 单独给出（标准规定 L=01 / M=00 / Q=11 / H=10，与枚举顺序不一致）——别把
// 枚举值直接当格式位用。
public enum QrEcl {
    // ~7% 恢复能力。
    L = 0,
    // ~15% 恢复能力（默认）。
    M = 1,
    // ~25% 恢复能力。
    Q = 2,
    // ~30% 恢复能力。
    H = 3,
}
