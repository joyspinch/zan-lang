using System;

namespace System.Barcode;

// 条码/二维码的异常。
//
// **异常 + 错误码两个通道**：人看 `Message`（异常自带），程序看 `error`。
// 调用方要能**按原因分支**——"没找到码"该重扫，"模式不支持"该提示用户，
// "纠错失败"该提示图像太糊。合成一句话会让这些分支都做不了。
public class BarcodeException : Exception {
    // 错误码。
    public BarcodeError error;

    public BarcodeException(BarcodeError error, string text) : base(text) {
        this.error = error;
    }

    // 带细节的构造：细节拼进消息（调用方要展示给人看时不必自己拼）。
    public BarcodeException(BarcodeError error, string text, string detail) : base(BarcodeException.Combine(text, detail)) {
        this.error = error;
    }

    // 消息与细节的拼接（只能在 base(...) 里算，所以提成静态方法）。
    static string Combine(string text, string detail) {
        if (detail == null || detail.Length == 0) { return text; }
        return text + ": " + detail;
    }

    // 错误码的英文名（调试输出用；不依赖枚举的字符串格式化行为）。
    public string ErrorName() {
        if (this.error == BarcodeError.None) { return "None"; }
        if (this.error == BarcodeError.InvalidImage) { return "InvalidImage"; }
        if (this.error == BarcodeError.NotFound) { return "NotFound"; }
        if (this.error == BarcodeError.MalformedCode) { return "MalformedCode"; }
        if (this.error == BarcodeError.CorrectionFailed) { return "CorrectionFailed"; }
        if (this.error == BarcodeError.UnsupportedMode) { return "UnsupportedMode"; }
        if (this.error == BarcodeError.TooLong) { return "TooLong"; }
        if (this.error == BarcodeError.Internal) { return "Internal"; }
        return "Unknown";
    }
}
