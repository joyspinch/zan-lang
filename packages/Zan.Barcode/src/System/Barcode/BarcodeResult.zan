using System;

namespace System.Barcode;

// 一次扫码的结果。
//
// **为什么把版本 / 纠错级别 / 掩码这些"内部信息"也带出来**：调用方经常需要
// 它们做判断——"这个码是 H 级（容错高）说明它可能带 logo"、"版本 1 说明
// 容量小"。但它们是**参考信息，不是契约**：解码出的 `text` 才是契约。
public class BarcodeResult {
    // 码制（当前只有 "QR"）。
    public string format;
    // 解出的文本。
    public string text;
    // 原始字节（byte 段的原始字节；纯 numeric/alnum 码时为空）。
    public byte[] bytes;
    // QR 版本号 1..40。
    public int version;
    // 边长（模块数）。
    public int size;
    // 纠错级别。
    public QrEcl ecl;
    // 掩码编号 0..7。
    public int mask;
    // 模块尺寸（像素/模块）。
    public double moduleSize;
    // 四个角在图像里的位置（像素）：TL, TR, BR, BL，每点两个数。
    public double[] corners;

    public BarcodeResult() {
        this.format = "QR";
        this.text = "";
        this.bytes = new byte[0];
        this.version = 0;
        this.size = 0;
        this.ecl = QrEcl.M;
        this.mask = 0;
        this.moduleSize = 0;
        this.corners = new double[0];
    }

    // 一行摘要（调试输出用）。
    public string Describe() {
        return this.format + " v" + this.version
            + " ecl=" + this.ecl.ToString()
            + " mask=" + this.mask
            + " size=" + this.size
            + " text=" + this.text;
    }
}
