using System;
using System.Collections.Generic;

namespace System.Barcode;

// 定位图形（1:1:3:1:1）与校正图形（1:1:1:1:1）检测。
// 定位图形命中放在命名空间层：避免嵌套类型数组触发编译器类型未定义。
public class QrFinderPattern {
    public double x;
    public double y;
    public double moduleSize;  // 视在像素/模块，旋转后真实边长为 s * max(|cosθ|, |sinθ|)
    public double err;

    public QrFinderPattern() {
        this.x = 0;
        this.y = 0;
        this.moduleSize = 0;
        this.err = 0;
    }
}

public class QrScanHit {
    public double center;
    public double moduleSize;
    public double barLo;
    public double barHi;
    public double err;

    public QrScanHit() {
        this.center = 0;
        this.moduleSize = 0;
        this.barLo = 0;
        this.barHi = 0;
        this.err = 0;
    }
}

public class QrFinder {
    public static int KIND_FINDER = 0;   // 1:1:3:1:1
    public static int KIND_ALIGN = 1;    // 1:1:1:1:1

    class Group {
        public double px;
        public double py;
        public List<double> xs;
        public List<double> ys;
        public List<double> ms;
        public double minErr;

        public Group() {
            this.px = 0;
            this.py = 0;
            this.xs = new List<double>();
            this.ys = new List<double>();
            this.ms = new List<double>();
            this.minErr = 1e30;
        }
    }

    // 中位数免疫数据区偶发假命中对均值造成的离群拉偏。
    static double Median(List<double> vals) {
        int n = vals.Count;
        if (n <= 0) { return 0; }
        double[] a = new double[n];
        for (int i = 0; i < n; i = i + 1) { a[i] = vals[i]; }
        for (int i = 1; i < n; i = i + 1) {
            double key = a[i];
            int j = i - 1;
            while (j >= 0 && a[j] > key) {
                a[j + 1] = a[j];
                j = j - 1;
            }
            a[j + 1] = key;
        }
        if (n % 2 == 1) { return a[n / 2]; }
        return (a[n / 2 - 1] + a[n / 2]) / 2.0;
    }

    public static List<QrFinderPattern> Find(bool[] dark, int width, int height) {
        List<QrScanHit> hhits = new List<QrScanHit>();
        List<int> hrows = new List<int>();
        List<int> cols = new List<int>();
        Dict<int, List<int>> byCol = new Dict<int, List<int>>();
        List<QrScanHit> lineHits = new List<QrScanHit>();
        for (int y = 0; y < height; y = y + 1) {
            lineHits.Clear();
            QrFinder.ScanLine(dark, width, height, y, true, KIND_FINDER, lineHits);
            for (int i = 0; i < lineHits.Count; i = i + 1) {
                int cx = (int)(lineHits[i].center + 0.5);
                if (cx < 0 || cx >= width) { continue; }
                int idx = hhits.Count;
                hhits.Add(lineHits[i]);
                hrows.Add(y);
                if (byCol.ContainsKey(cx)) {
                    byCol[cx].Add(idx);
                } else {
                    List<int> bucket = new List<int>();
                    bucket.Add(idx);
                    byCol.Add(cx, bucket);
                    cols.Add(cx);
                }
            }
        }
        if (hhits.Count == 0) { return new List<QrFinderPattern>(); }
        return QrFinder.ClusterMatches(dark, width, height, hhits, hrows, cols, byCol);
    }

    // 用竖直 3-bar 跨度交叉验证并按 (x, y) 配对点聚类；簇内存原始横向命中取中位数以抵消 tanθ 线性漂移。
    static List<QrFinderPattern> ClusterMatches(
        bool[] dark, int width, int height,
        List<QrScanHit> hhits, List<int> hrows,
        List<int> cols, Dict<int, List<int>> byCol) {
        List<Group> groups = new List<Group>();
        List<QrScanHit> vhits = new List<QrScanHit>();
        for (int ci = 0; ci < cols.Count; ci = ci + 1) {
            int cx = cols[ci];
            vhits.Clear();
            QrFinder.ScanLine(dark, width, height, cx, false, KIND_FINDER, vhits);
            if (vhits.Count == 0) { continue; }
            List<int> colIdxs = byCol[cx];
            for (int j = 0; j < colIdxs.Count; j = j + 1) {
                int hi = colIdxs[j];
                QrScanHit h = hhits[hi];
                int row = hrows[hi];
                QrScanHit bestV = null;
                for (int k = 0; k < vhits.Count; k = k + 1) {
                    QrScanHit v = vhits[k];
                    if (row < v.barLo - 0.5 || row > v.barHi + 0.5) { continue; }
                    if (QrFinder.AbsF(v.moduleSize - h.moduleSize) > h.moduleSize * 0.4) { continue; }
                    if (bestV == null || v.err < bestV.err) { bestV = v; }
                }
                if (bestV == null) { continue; }
                QrFinder.AddToGroup(groups, h, bestV, row);
            }
        }
        List<QrFinderPattern> outp = new List<QrFinderPattern>();
        for (int g = 0; g < groups.Count; g = g + 1) {
            Group gr = groups[g];
            if (gr.xs.Count <= 0) { continue; }
            QrFinderPattern p = new QrFinderPattern();
            p.x = QrFinder.Median(gr.xs);
            p.y = QrFinder.Median(gr.ys);
            p.moduleSize = QrFinder.Median(gr.ms);
            p.err = gr.minErr;
            outp.Add(p);
        }
        return outp;
    }

    static void AddToGroup(List<Group> groups, QrScanHit h, QrScanHit v, int row) {
        double px = h.center;
        double py = v.center;
        double tol = h.moduleSize * 0.5;
        if (tol < 1.5) { tol = 1.5; }
        Group best = null;
        double bestD = 0;
        for (int g = 0; g < groups.Count; g = g + 1) {
            double dx = QrFinder.AbsF(px - groups[g].px);
            double dy = QrFinder.AbsF(py - groups[g].py);
            if (dx > tol || dy > tol) { continue; }
            double d = dx + dy;
            if (best == null || d < bestD) { best = groups[g]; bestD = d; }
        }
        if (best == null) {
            best = new Group();
            best.px = px;
            best.py = py;
            groups.Add(best);
        }
        best.xs.Add(h.center);
        best.ys.Add(row);
        best.ms.Add(h.moduleSize);
        if (h.err < best.minErr) { best.minErr = h.err; }
    }

    // 在符号坐标系内匹配 5x5 校正图形以兼容旋转与斜拍；25 格必须全中避免误匹配带偏透视变换。
    public static bool FindAlignment(QrTransform t, bool[] dark, int width, int height,
                                     double symX, double symY, double[] outp) {
        double[] pt = new double[2];
        int bestBad = 999;
        bool found = false;
        for (int dy = -3; dy <= 3; dy = dy + 1) {
            for (int dx = -3; dx <= 3; dx = dx + 1) {
                double cx = symX + dx;
                double cy = symY + dy;
                int bad = 0;
                for (int r = -2; r <= 2 && bad < 999; r = r + 1) {
                    for (int c = -2; c <= 2; c = c + 1) {
                        t.Map(cx + c, cy + r, pt);
                        int px = (int)(pt[0] + 0.5);
                        int py = (int)(pt[1] + 0.5);
                        if (px < 0 || py < 0 || px >= width || py >= height) {
                            bad = 999;
                            break;
                        }
                        bool wantDark = (r == -2 || r == 2 || c == -2 || c == 2 || (r == 0 && c == 0));
                        if (wantDark != dark[py * width + px]) { bad = bad + 1; }
                    }
                }
                if (bad < bestBad) {
                    bestBad = bad;
                    found = true;
                    t.Map(cx, cy, pt);
                    outp[0] = pt[0];
                    outp[1] = pt[1];
                }
            }
        }
        return found && bestBad == 0;
    }

    public static void ScanLine(bool[] dark, int width, int height, int fixedPos,
                                bool horizontal, int kind, List<QrScanHit> outp) {
        int len = horizontal ? width : height;
        int[] p = new int[5];
        double[] metrics = new double[2];
        int runCount = 0;
        int color = -1;
        int runLen = 0;
        for (int i = 0; i < len; i = i + 1) {
            bool d = horizontal ? dark[fixedPos * width + i] : dark[i * width + fixedPos];
            int c = d ? 1 : 0;
            if (c != color) {
                if (color >= 0) {
                    for (int k = 0; k < 4; k = k + 1) { p[k] = p[k + 1]; }
                    p[4] = runLen;
                    runCount = runCount + 1;
                    if (runCount >= 5 && QrFinder.IsRatio(p, kind, metrics)) {
                        int span = p[0] + p[1] + p[2] + p[3] + p[4];
                        int barLo = i - span + p[0] + p[1];
                        int barHi = barLo + p[2];
                        QrScanHit h = new QrScanHit();
                        h.center = (double)(barLo + barHi) / 2.0;
                        h.moduleSize = metrics[0];
                        h.barLo = barLo;
                        h.barHi = barHi;
                        h.err = metrics[1];
                        outp.Add(h);
                    }
                }
                color = c;
                runLen = 1;
            } else {
                runLen = runLen + 1;
            }
        }
    }

    // 模块尺寸取四段单模块 (p0+p1+p3+p4)/4 而非 p2/3，斜切时各段截短互相抵消。
    static bool IsRatio(int[] p, int kind, double[] metrics) {
        double m = 0;
        double err = 0;
        if (kind == KIND_ALIGN) {
            m = p[2];
            double tol = m * 0.5;
            if (tol < 1.0) { tol = 1.0; }
            for (int i = 0; i < 5; i = i + 1) {
                double d = QrFinder.AbsF(m - p[i]);
                if (d > tol) { return false; }
                if (d > err) { err = d; }
            }
        } else {
            m = (p[0] + p[1] + p[3] + p[4]) / 4.0;
            if (m < 0.75) { return false; }
            double tol = m * 0.45;
            if (tol < 1.0) { tol = 1.0; }
            double d0 = QrFinder.AbsF(p[0] - m);
            double d1 = QrFinder.AbsF(p[1] - m);
            double d3 = QrFinder.AbsF(p[3] - m);
            double d4 = QrFinder.AbsF(p[4] - m);
            if (d0 > tol || d1 > tol || d3 > tol || d4 > tol) { return false; }
            if (d0 > err) { err = d0; }
            if (d1 > err) { err = d1; }
            if (d3 > err) { err = d3; }
            if (d4 > err) { err = d4; }
            double d2 = QrFinder.AbsF(p[2] - 3.0 * m);
            double tol2 = m * 0.6;
            if (tol2 < 1.5) { tol2 = 1.5; }
            if (d2 > tol2) { return false; }
            if (d2 > err) { err = d2; }
        }
        metrics[0] = m;
        metrics[1] = err;
        return true;
    }

    public static double AbsF(double v) {
        if (v < 0.0) { return -v; }
        return v;
    }

    public static double Distance(double x0, double y0, double x1, double y1) {
        double dx = x1 - x0;
        double dy = y1 - y0;
        return QrFinder.Sqrt(dx * dx + dy * dy);
    }

    public static double Sqrt(double v) {
        if (v <= 0.0) { return 0.0; }
        double x = v > 1.0 ? v / 2.0 : v;
        for (int i = 0; i < 40; i = i + 1) {
            double nx = 0.5 * (x + v / x);
            if (nx == x) { break; }
            x = nx;
        }
        return x;
    }
}
