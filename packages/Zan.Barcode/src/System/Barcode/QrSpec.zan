using System;
using System.Collections.Generic;

namespace System.Barcode;

// QR 规格层（ISO/IEC 18004）：版本表、纠错分块、对齐图形、FunctionMap、GF(256) 与 RS 编码。
// 编码器与解码器共用本层规格与 FunctionMap，保证功能模块判定与分块交织逐位一致。
public class QrSpec {

    // ---- 版本表（ISO 18004 Table 13-22 / E.1） ---------------------------

    // 每块纠错码字数 [level][version 1..40]
    static int[] EC_PER_BLOCK_L = new int[]{
        -1, 7, 10, 15, 20, 26, 18, 20, 24, 30, 18, 20, 24, 26, 30, 22, 24, 28,
        30, 28, 28, 28, 28, 30, 30, 26, 28, 30, 30, 30, 30, 30, 30, 30, 30, 30,
        30, 30, 30, 30, 30};
    static int[] EC_PER_BLOCK_M = new int[]{
        -1, 10, 16, 26, 18, 24, 16, 18, 22, 22, 26, 30, 22, 22, 24, 24, 28, 28,
        26, 26, 26, 26, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28,
        28, 28, 28, 28, 28};
    static int[] EC_PER_BLOCK_Q = new int[]{
        -1, 13, 22, 18, 26, 18, 24, 18, 22, 20, 24, 28, 26, 24, 20, 30, 24, 28,
        28, 26, 30, 28, 30, 30, 30, 30, 28, 30, 30, 37, 34, 28, 30, 31, 24, 37,
        32, 29, 37, 34, 31};
    static int[] EC_PER_BLOCK_H = new int[]{
        -1, 17, 28, 22, 16, 22, 28, 26, 26, 24, 28, 24, 28, 22, 24, 24, 30, 28,
        28, 26, 28, 30, 24, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30,
        30, 30, 30, 30, 30};

    // 分块数 [level][version 1..40]
    static int[] NUM_BLOCKS_L = new int[]{
        -1, 1, 1, 1, 1, 1, 2, 2, 2, 2, 4, 4, 4, 4, 4, 6, 6, 6, 6, 7, 8, 8, 9,
        9, 10, 12, 12, 12, 13, 14, 15, 16, 17, 18, 19, 19, 20, 21, 22, 24, 25};
    static int[] NUM_BLOCKS_M = new int[]{
        -1, 1, 1, 1, 2, 2, 4, 4, 4, 5, 5, 5, 8, 9, 9, 10, 10, 11, 13, 14, 16,
        17, 17, 18, 20, 21, 23, 25, 26, 28, 29, 31, 33, 35, 37, 38, 40, 43, 45,
        47, 49};
    static int[] NUM_BLOCKS_Q = new int[]{
        -1, 1, 1, 2, 2, 4, 4, 6, 6, 8, 8, 8, 10, 12, 16, 12, 17, 16, 18, 21, 20,
        23, 23, 25, 27, 29, 34, 34, 35, 38, 40, 43, 45, 48, 51, 53, 56, 59, 62,
        65, 68};
    static int[] NUM_BLOCKS_H = new int[]{
        -1, 1, 1, 2, 4, 4, 4, 5, 6, 8, 8, 11, 11, 16, 16, 18, 16, 19, 21, 25,
        25, 25, 34, 30, 32, 35, 37, 40, 42, 45, 48, 51, 54, 57, 60, 63, 66, 70,
        74, 77, 81};

    // 该版本/级别每块纠错码字数。
    public static int EcPerBlock(QrEcl ecl, int ver) {
        if (ver < 1 || ver > 40) { return 0; }
        if (ecl == QrEcl.L) { return EC_PER_BLOCK_L[ver]; }
        if (ecl == QrEcl.M) { return EC_PER_BLOCK_M[ver]; }
        if (ecl == QrEcl.Q) { return EC_PER_BLOCK_Q[ver]; }
        return EC_PER_BLOCK_H[ver];
    }

    // 该版本/级别的纠错分块数。
    public static int NumBlocks(QrEcl ecl, int ver) {
        if (ver < 1 || ver > 40) { return 0; }
        if (ecl == QrEcl.L) { return NUM_BLOCKS_L[ver]; }
        if (ecl == QrEcl.M) { return NUM_BLOCKS_M[ver]; }
        if (ecl == QrEcl.Q) { return NUM_BLOCKS_Q[ver]; }
        return NUM_BLOCKS_H[ver];
    }

    // 校正图形（对齐图形）中心坐标序列（ISO 18004 Table E.1）。
    // 首元素 0 是占位，调用方取 pos[1..]。
    public static int[] AlignPattern(int ver) {
        if (ver <= 1) { return new int[0]; }
        if (ver == 2) { return new int[]{0, 6, 18}; }
        if (ver == 3) { return new int[]{0, 6, 22}; }
        if (ver == 4) { return new int[]{0, 6, 26}; }
        if (ver == 5) { return new int[]{0, 6, 30}; }
        if (ver == 6) { return new int[]{0, 6, 34}; }
        if (ver == 7) { return new int[]{0, 6, 22, 38}; }
        if (ver == 8) { return new int[]{0, 6, 24, 42}; }
        if (ver == 9) { return new int[]{0, 6, 26, 46}; }
        if (ver == 10) { return new int[]{0, 6, 28, 50}; }
        if (ver == 11) { return new int[]{0, 6, 30, 54}; }
        if (ver == 12) { return new int[]{0, 6, 32, 58}; }
        if (ver == 13) { return new int[]{0, 6, 34, 62}; }
        if (ver == 14) { return new int[]{0, 6, 26, 46, 66}; }
        if (ver == 15) { return new int[]{0, 6, 26, 48, 70}; }
        if (ver == 16) { return new int[]{0, 6, 26, 50, 74}; }
        if (ver == 17) { return new int[]{0, 6, 30, 54, 78}; }
        if (ver == 18) { return new int[]{0, 6, 30, 56, 82}; }
        if (ver == 19) { return new int[]{0, 6, 30, 58, 86}; }
        if (ver == 20) { return new int[]{0, 6, 34, 62, 90}; }
        if (ver == 21) { return new int[]{0, 6, 28, 50, 72, 94}; }
        if (ver == 22) { return new int[]{0, 6, 26, 50, 74, 98}; }
        if (ver == 23) { return new int[]{0, 6, 30, 54, 78, 102}; }
        if (ver == 24) { return new int[]{0, 6, 28, 54, 80, 106}; }
        if (ver == 25) { return new int[]{0, 6, 32, 58, 84, 110}; }
        if (ver == 26) { return new int[]{0, 6, 30, 58, 86, 114}; }
        if (ver == 27) { return new int[]{0, 6, 34, 62, 90, 118}; }
        if (ver == 28) { return new int[]{0, 6, 26, 50, 74, 98, 122}; }
        if (ver == 29) { return new int[]{0, 6, 30, 54, 78, 102, 126}; }
        if (ver == 30) { return new int[]{0, 6, 26, 52, 78, 104, 130}; }
        if (ver == 31) { return new int[]{0, 6, 30, 56, 82, 108, 134}; }
        if (ver == 32) { return new int[]{0, 6, 34, 60, 86, 112, 138}; }
        if (ver == 33) { return new int[]{0, 6, 30, 58, 86, 114, 142}; }
        if (ver == 34) { return new int[]{0, 6, 34, 62, 90, 118, 146}; }
        if (ver == 35) { return new int[]{0, 6, 30, 54, 78, 102, 126, 150}; }
        if (ver == 36) { return new int[]{0, 6, 24, 50, 76, 102, 128, 154}; }
        if (ver == 37) { return new int[]{0, 6, 28, 54, 80, 106, 132, 158}; }
        if (ver == 38) { return new int[]{0, 6, 32, 58, 84, 110, 136, 162}; }
        if (ver == 39) { return new int[]{0, 6, 26, 54, 82, 110, 138, 166}; }
        return new int[]{0, 6, 30, 58, 86, 114, 142, 170};
    }

    // 总码字数 = floor(rawDataModules / 8)。
    public static int TotalCodewords(int ver) {
        int rawModules = (16 * ver + 128) * ver + 64;
        int n = ver / 7 + 2;
        if (ver >= 2) {
            rawModules = rawModules - ((25 * n - 10) * n - 55);
        }
        if (ver >= 7) { rawModules = rawModules - 36; }
        return rawModules / 8;
    }

    // 该版本/级别的数据码字容量（总码字减去全部纠错码字）。
    public static int DataCapacity(int ver, QrEcl ecl) {
        return QrSpec.TotalCodewords(ver)
            - QrSpec.EcPerBlock(ecl, ver) * QrSpec.NumBlocks(ecl, ver);
    }

    // 按版本/级别给出完整分块序列 [numBlocksG1, dataG1, numBlocksG2, dataG2]。
    // group1 的块数据少，group2 的块数据多（多 1 个码字）。
    public static int[] BlockPlan(int ver, QrEcl ecl) {
        int nBlocks = QrSpec.NumBlocks(ecl, ver);
        int ecLen = QrSpec.EcPerBlock(ecl, ver);
        int total = QrSpec.TotalCodewords(ver);
        int data = total - nBlocks * ecLen;
        int small = data / nBlocks;
        int numLarge = data - small * nBlocks;
        if (numLarge > 0) {
            return new int[]{nBlocks - numLarge, small, numLarge, small + 1};
        }
        return new int[]{nBlocks, small, 0, 0};
    }

    // ---- 功能图形地图 -------------------------------------------------------

    // 功能图形（不可放数据/掩码）地图：true = 功能模块，编解码共用同一份实现。
    static object cacheLock = new object();
    static bool[][] fnCache = null;

    // 内部只读共享模板（编码器/解码器只读访问，保留线程安全双重检查锁，免除每次编码整矩阵复制）。
    internal static bool[] FunctionMapReadOnly(int ver) {
        if (ver < 1 || ver > 40) { return QrSpec.BuildFunctionMap(ver); }
        bool[][] cache = QrSpec.fnCache;
        if (cache != null) {
            bool[] hit = cache[ver];
            if (hit != null) { return hit; }
        }
        bool[] cached = null;
        lock (QrSpec.cacheLock) {
            if (QrSpec.fnCache == null) { QrSpec.fnCache = new bool[41][]; }
            cached = QrSpec.fnCache[ver];
            if (cached == null) {
                cached = QrSpec.BuildFunctionMap(ver);
                QrSpec.fnCache[ver] = cached;
            }
        }
        return cached;
    }

    // 覆盖三个定位图形及分隔带、定时/校正图形、版本/格式信息区与固定深色模块。
    // 按版本惰性缓存模板，对外返回安全副本，避免重复标定全矩阵。
    public static bool[] FunctionMap(int ver) {
        bool[] cached = QrSpec.FunctionMapReadOnly(ver);
        bool[] copy = new bool[cached.Length];
        Array.Copy(cached, copy, cached.Length);
        return copy;
    }

    static bool[] BuildFunctionMap(int ver) {
        int size = ver * 4 + 17;
        bool[] fn = new bool[size * size];
        for (int i = 0; i < size * size; i = i + 1) { fn[i] = false; }

        // 定位图形（连同分隔带一起算功能区）。
        QrSpec.MarkSquare(fn, size, 3, 3, 4);
        QrSpec.MarkSquare(fn, size, size - 4, 3, 4);
        QrSpec.MarkSquare(fn, size, 3, size - 4, 4);

        // 定时图形：第 6 行与第 6 列（8 .. size-9）。
        for (int i = 8; i <= size - 9; i = i + 1) {
            fn[6 * size + i] = true;
            fn[i * size + 6] = true;
        }

        // 校正图形（跳过与三个定位图形重叠的角）。
        int[] pos = QrSpec.AlignPattern(ver);
        int n = pos.Length - 1;
        for (int r = 0; r < n; r = r + 1) {
            for (int c = 0; c < n; c = c + 1) {
                bool corner = (r == 0 && c == 0)
                    || (r == 0 && c == n - 1)
                    || (r == n - 1 && c == 0);
                if (!corner) {
                    QrSpec.MarkSquare(fn, size, pos[c + 1], pos[r + 1], 2);
                }
            }
        }

        // 版本信息区（v >= 7）：左上 / 右上 6x3 条带。
        if (ver >= 7) {
            for (int i = 0; i < 18; i = i + 1) {
                int a = i / 3;
                int b = i % 3;
                QrSpec.MarkFn(fn, size, a, size - 11 + b);
                QrSpec.MarkFn(fn, size, size - 11 + b, a);
            }
        }

        // 格式信息区：左上（列 8 / 行 8）、左下（行 8 / 列 8）、固定深色模块。
        for (int i = 0; i < 9; i = i + 1) {
            if (i != 6) {
                QrSpec.MarkFn(fn, size, 8, i);
                QrSpec.MarkFn(fn, size, i, 8);
            }
        }
        for (int i = 0; i < 8; i = i + 1) {
            QrSpec.MarkFn(fn, size, size - 1 - i, 8);
            if (i != 6) { QrSpec.MarkFn(fn, size, 8, size - 1 - i); }
        }
        QrSpec.MarkFn(fn, size, 8, size - 8);
        return fn;
    }

    // 标记 (x,y) 为功能模块（越界忽略）。
    static void MarkFn(bool[] fn, int size, int x, int y) {
        if (x < 0 || y < 0 || x >= size || y >= size) { return; }
        fn[y * size + x] = true;
    }

    // 以 (cx,cy) 为中心标记边长 (2*r+1) 的方形功能区（定位图形 r=4，校正图形 r=2）。
    static void MarkSquare(bool[] fn, int size, int cx, int cy, int r) {
        for (int dy = -r; dy <= r; dy = dy + 1) {
            for (int dx = -r; dx <= r; dx = dx + 1) {
                QrSpec.MarkFn(fn, size, cx + dx, cy + dy);
            }
        }
    }

    // ---- GF(256) 算术（本原多项式 0x11D，生成元 α = 2） --------------------

    static int[] gfExp = null;
    static int[] gfLog = null;

    // 首次调用时在锁内构建完 GF(256) 指数/对数表并先发布 gfLog 再发布 gfExp，避免并发读到半初始化态。
    static void EnsureGf() {
        if (gfExp != null && gfLog != null) { return; }
        lock (QrSpec.cacheLock) {
            if (gfExp != null && gfLog != null) { return; }
            int[] e = new int[512];
            int[] l = new int[256];
            int v = 1;
            for (int i = 0; i < 255; i = i + 1) {
                e[i] = v;
                l[v] = i;
                v = v << 1;
                if (v >= 256) { v = v ^ 0x11D; }
            }
            for (int i = 255; i < 512; i = i + 1) { e[i] = e[i - 255]; }
            gfLog = l;
            gfExp = e;
        }
    }

    // GF(256) 乘法（任一操作数为 0 时结果为 0）。
    public static int GfMul(int a, int b) {
        if (a == 0 || b == 0) { return 0; }
        QrSpec.EnsureGf();
        return gfExp[gfLog[a] + gfLog[b]];
    }

    // GF(256) 除法（除数为 0 时返回 0；调用方不该这么用）。
    public static int GfDiv(int a, int b) {
        if (a == 0 || b == 0) { return 0; }
        QrSpec.EnsureGf();
        return gfExp[gfLog[a] + 255 - gfLog[b]];
    }

    // GF(256) 求逆（0 的逆无定义，返回 0）。
    public static int GfInv(int a) {
        if (a == 0) { return 0; }
        QrSpec.EnsureGf();
        return gfExp[255 - gfLog[a]];
    }

    // GF(256) 的 α^k（k 可为负）。
    public static int GfAlpha(int k) {
        QrSpec.EnsureGf();
        int idx = ((k % 255) + 255) % 255;
        return gfExp[idx];
    }

    // ---- Reed-Solomon 编码 --------------------------------------------------

    // RS 生成多项式 prod(x - a^i), i=0..deg-1；升幂索引且 result[deg-1] = 1（最高次 x^deg 隐式为 1）。
    public static int[] RsGenerator(int deg) {
        QrSpec.EnsureGf();
        int[] result = new int[deg];
        for (int i = 0; i < deg; i = i + 1) { result[i] = 0; }
        result[deg - 1] = 1;
        int root = 1;
        for (int i = 0; i < deg; i = i + 1) {
            for (int j = 0; j < deg; j = j + 1) {
                result[j] = QrSpec.GfMul(result[j], root);
                if (j + 1 < deg) { result[j] = result[j] ^ result[j + 1]; }
            }
            root = QrSpec.GfMul(root, 2);
        }
        return result;
    }

    // 零拷贝切片版 RS 余式计算：将 data[offset..offset+dataLen) 对 gen 取模结果写入 outEc[outOff..outOff+deg)。
    // 提升 GF 表查表与融合移位+异或为单遍循环，消除每字节两次循环及每次乘法的 EnsureGf 调用。
    internal static void RsRemainderSlice(int[] data, int offset, int dataLen, int[] gen, int[] outEc, int outOff) {
        QrSpec.EnsureGf();
        int[] exp = gfExp;
        int[] log = gfLog;
        int deg = gen.Length;
        for (int j = 0; j < deg; j = j + 1) { outEc[outOff + j] = 0; }
        int degM1 = deg - 1;
        for (int i = 0; i < dataLen; i = i + 1) {
            int factor = data[offset + i] ^ outEc[outOff];
            if (factor == 0) {
                for (int j = 0; j < degM1; j = j + 1) {
                    outEc[outOff + j] = outEc[outOff + j + 1];
                }
                outEc[outOff + degM1] = 0;
            } else {
                int logF = log[factor];
                for (int j = 0; j < degM1; j = j + 1) {
                    int g = gen[j];
                    int prod = g == 0 ? 0 : exp[log[g] + logF];
                    outEc[outOff + j] = outEc[outOff + j + 1] ^ prod;
                }
                int gLast = gen[degM1];
                outEc[outOff + degM1] = gLast == 0 ? 0 : exp[log[gLast] + logF];
            }
        }
    }

    // data 对生成多项式 gen 取模（Nayuki 式），返回 deg 个纠错码字。
    public static int[] RsRemainder(int[] data, int dataLen, int[] gen) {
        int[] result = new int[gen.Length];
        QrSpec.RsRemainderSlice(data, 0, dataLen, gen, result, 0);
        return result;
    }
}
