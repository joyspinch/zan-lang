namespace System.Barcode;

// 条码/二维码的错误原因（可区分的错误码）。
//
// **为什么要错误码**：扫码失败的原因差别很大——"图里没有码"是采集问题，
// "码找到了但纠错失败"是码本身或图像质量的问题，"模式不支持"是能力边界。
// 合成一句话会让排查变慢，也会让调用方没法分别处理（比如"没找到"就重扫，
// "不支持"就直接告诉用户换个码）。
public enum BarcodeError {
    // 没有错误。
    None = 0,
    // 输入图像不合法（宽高为 0、缓冲区长度对不上等）。
    InvalidImage = 1,
    // 图像里没找到可识别的码。
    NotFound = 2,
    // 找到了码，但结构不合法（版本/分块对不上、格式信息纠不回来）。
    MalformedCode = 3,
    // Reed-Solomon 纠错失败（污损太多，或数据不是合法码字）。
    CorrectionFailed = 4,
    // 码的模式本包不支持（例如 Kanji 模式、ECI 自定义字符集）。
    UnsupportedMode = 5,
    // 内容太长：超出 QR 版本 40 + 最高纠错级别的容量。
    TooLong = 6,
    // 内部错误（不应该发生；出现即说明包里有 bug）。
    Internal = 7,
}
