using System;
using System.Collections.Generic;

namespace System.Barcode;

// 纯 Zan QR Code（版本 1-40，ISO/IEC 18004）编码器；Encode 返回不含静区的 QrMatrix。
public class QrEncoder {
    public static int MODE_NUMERIC = 1;
    public static int MODE_ALNUM = 2;
    public static int MODE_BYTE = 4;

    static string ALNUM_CHARS = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ $%*+-./:";

    public static QrMatrix Encode(string text, QrEcl ecl) {
        List<QrSegment> segs = QrEncoder.MakeQrSegments(text);
        int ver = QrEncoder.PickVersion(segs, ecl);
        if (ver < 0) {
            throw new BarcodeException(BarcodeError.TooLong, "content too long for QR version 40");
        }
        int totalCw = QrSpec.TotalCodewords(ver);
        int[] cw = new int[totalCw];
        for (int i = 0; i < totalCw; i = i + 1) { cw[i] = 0; }
        QrEncoder.WriteQrSegments(segs, ver, ecl, cw);
        return QrEncoder.BuildMatrix(ver, ecl, cw);
    }

    public static QrEcl ParseEcl(string s) {
        if (s == null || s.Length != 1) { return QrEcl.M; }
        int b = s[0] & 255;
        if (b == 76 || b == 108) { return QrEcl.L; }
        if (b == 81 || b == 113) { return QrEcl.Q; }
        if (b == 72 || b == 104) { return QrEcl.H; }
        return QrEcl.M;
    }

    public static bool IsNumeric(int b) { return b >= 48 && b <= 57; }

    public static int AlnumValueByte(int c) {
        for (int i = 0; i < 45; i = i + 1) {
            if (ALNUM_CHARS[i] == c) { return i; }
        }
        return -1;
    }

    public static int SeqByteLen(int lead) {
        if (lead < 128) { return 1; }
        if (lead < 224) { return 2; }
        if (lead < 240) { return 3; }
        return 4;
    }

    // 按码点游程切段并将 <=8 字符的短非 Byte 游程折回 Byte（省模式切换头），再合并相邻 Byte 段。
    static List<QrSegment> MakeQrSegments(string text) {
        List<QrSegment> outp = new List<QrSegment>();
        if (text == null || text.Length == 0) { return outp; }
        List<QrSegment> raw = new List<QrSegment>();
        int len = text.Length;
        int i = 0;
        while (i < len) {
            int runStart = i;
            int mode = QrEncoder.ModeOfByte(text[i] & 255, text, i);
            i = i + QrEncoder.SeqByteLen(text[i] & 255);
            while (i < len) {
                if (QrEncoder.ModeOfByte(text[i] & 255, text, i) != mode) { break; }
                i = i + QrEncoder.SeqByteLen(text[i] & 255);
            }
            string run = text.Substring(runStart, i - runStart);
            QrSegment s;
            if (mode == MODE_NUMERIC) {
                s = new QrSegment();
                s.bits = new List<int>();
                s.mode = MODE_NUMERIC;
                s.chars = run.Length;
                s.srcPos = runStart;
                int j = 0;
                int n = run.Length;
                while (j < n) {
                    int take = n - j;
                    if (take > 3) { take = 3; }
                    int v = 0;
                    for (int k = 0; k < take; k = k + 1) { v = v * 10 + (run[j + k] - 48); }
                    int bits = take == 3 ? 10 : (take == 2 ? 7 : 4);
                    for (int b2 = bits - 1; b2 >= 0; b2 = b2 - 1) { s.bits.Add((v >> b2) & 1); }
                    j = j + take;
                }
            } else if (mode == MODE_ALNUM) {
                s = new QrSegment();
                s.bits = new List<int>();
                s.mode = MODE_ALNUM;
                s.chars = run.Length;
                s.srcPos = runStart;
                int j = 0;
                int n = run.Length;
                while (j + 2 <= n) {
                    int v = QrEncoder.AlnumValueByte(run[j] & 255) * 45 + QrEncoder.AlnumValueByte(run[j + 1] & 255);
                    for (int b2 = 10; b2 >= 0; b2 = b2 - 1) { s.bits.Add((v >> b2) & 1); }
                    j = j + 2;
                }
                if (j < n) {
                    int v = QrEncoder.AlnumValueByte(run[j] & 255);
                    for (int b2 = 5; b2 >= 0; b2 = b2 - 1) { s.bits.Add((v >> b2) & 1); }
                }
            } else {
                s = QrEncoder.MakeByteRun(run);
                s.srcPos = runStart;
            }
            raw.Add(s);
        }
        for (int k = 0; k < raw.Count; k = k + 1) {
            QrSegment s = raw[k];
            if (s.mode != MODE_BYTE && s.chars <= 8) {
                // 使用构造时记录的 srcPos：相邻 Byte 合并会就地修改 chars，事后累加起点会错位。
                s = QrEncoder.MakeByteRun(text.Substring(s.srcPos, s.chars));
            }
            bool merged = false;
            if (s.mode == MODE_BYTE && outp.Count > 0) {
                QrSegment p = outp[outp.Count - 1];
                if (p.mode == MODE_BYTE) {
                    for (int j = 0; j < s.bits.Count; j = j + 1) { p.bits.Add(s.bits[j]); }
                    p.chars = p.chars + s.chars;
                    merged = true;
                }
            }
            if (!merged) { outp.Add(s); }
        }
        return outp;
    }

    static QrSegment MakeByteRun(string run) {
        QrSegment s = new QrSegment();
        s.mode = MODE_BYTE;
        s.chars = run.Length;
        s.bits = new List<int>();
        for (int j = 0; j < run.Length; j = j + 1) {
            int v = run[j] & 255;
            for (int b = 7; b >= 0; b = b - 1) { s.bits.Add((v >> b) & 1); }
        }
        return s;
    }

    public static int ModeOfByte(int b, string text, int pos) {
        if (QrEncoder.SeqByteLen(b) == 1) {
            if (QrEncoder.IsNumeric(b)) { return MODE_NUMERIC; }
            if (QrEncoder.AlnumValueByte(b) >= 0) { return MODE_ALNUM; }
        }
        return MODE_BYTE;
    }

    static int CharCountBits(int mode, int ver) {
        int g = ver <= 9 ? 0 : (ver <= 26 ? 1 : 2);
        if (mode == MODE_NUMERIC) { return 10 + 2 * g; }
        if (mode == MODE_ALNUM) { return 9 + 2 * g; }
        return g == 0 ? 8 : 16;
    }

    static int PickVersion(List<QrSegment> segs, QrEcl ecl) {
        for (int ver = 1; ver <= 40; ver = ver + 1) {
            int need = 0;
            for (int i = 0; i < segs.Count; i = i + 1) {
                QrSegment s = segs[i];
                need = need + 4 + QrEncoder.CharCountBits(s.mode, ver) + s.bits.Count;
            }
            if (need <= QrSpec.DataCapacity(ver, ecl) * 8) { return ver; }
        }
        return -1;
    }

    static void WriteQrSegments(List<QrSegment> segs, int ver, QrEcl ecl, int[] cw) {
        List<int> bits = new List<int>();
        for (int i = 0; i < segs.Count; i = i + 1) {
            QrSegment s = segs[i];
            QrEncoder.AppendVal(bits, s.mode, 4);
            QrEncoder.AppendVal(bits, s.chars, QrEncoder.CharCountBits(s.mode, ver));
            for (int k = 0; k < s.bits.Count; k = k + 1) { bits.Add(s.bits[k]); }
        }
        int cap = QrSpec.DataCapacity(ver, ecl);
        int term = cap * 8 - bits.Count;
        if (term > 4) { term = 4; }
        if (term < 0) { term = 0; }
        for (int i = 0; i < term; i = i + 1) { bits.Add(0); }
        int nDataCw = (bits.Count + 7) / 8;
        for (int i = 0; i < bits.Count; i = i + 1) {
            if (bits[i] != 0) { cw[i / 8] = cw[i / 8] | (1 << (7 - i % 8)); }
        }
        for (int i = nDataCw; i < cap; i = i + 1) {
            cw[i] = (i - nDataCw) % 2 == 0 ? 0xEC : 0x11;
        }
    }

    static void AppendVal(List<int> bits, int val, int n) {
        for (int i = n - 1; i >= 0; i = i - 1) { bits.Add((val >> i) & 1); }
    }

    static void SetFn(bool[] fn, int size, int x, int y) {
        if (x < 0 || y < 0 || x >= size || y >= size) { return; }
        fn[y * size + x] = true;
    }

    // 绘制同心方环功能图形（定位 r=4 留白 dist 2/4；校正 r=2 留白 dist 1）。
    static void DrawRing(bool[] dark, bool[] fn, int size, int cx, int cy, int radius, int hole1, int hole2) {
        for (int dy = -radius; dy <= radius; dy = dy + 1) {
            for (int dx = -radius; dx <= radius; dx = dx + 1) {
                int dist = dy * dy > dx * dx ? dy : dx;
                if (dist < 0) { dist = -dist; }
                int x = cx + dx;
                int y = cy + dy;
                QrEncoder.SetFn(fn, size, x, y);
                if (x >= 0 && y >= 0 && x < size && y < size && dist != hole1 && dist != hole2) {
                    dark[y * size + x] = true;
                }
            }
        }
    }

    static int BchVersion(int ver) {
        int d = ver << 12;
        // 消去比特 17..12 共 6 位（只循环 5 次会残留高位污染版本信息）。
        for (int i = 0; i <= 5; i = i + 1) {
            if (((d >> (17 - i)) & 1) != 0) { d = d ^ (0x1F25 << (5 - i)); }
        }
        return (ver << 12) | d;
    }

    static void InitFunctionMatrix(int ver, bool[] dark, bool[] fn, int size) {
        QrEncoder.DrawRing(dark, fn, size, 3, 3, 4, 2, 4);
        QrEncoder.DrawRing(dark, fn, size, size - 4, 3, 4, 2, 4);
        QrEncoder.DrawRing(dark, fn, size, 3, size - 4, 4, 2, 4);

        for (int i = 8; i <= size - 9; i = i + 1) {
            if (i % 2 == 0) {
                dark[6 * size + i] = true;
                dark[i * size + 6] = true;
            }
        }

        int[] pos = QrSpec.AlignPattern(ver);
        int n = pos.Length - 1;
        for (int r = 0; r < n; r = r + 1) {
            for (int c = 0; c < n; c = c + 1) {
                bool corner = (r == 0 && c == 0) || (r == 0 && c == n - 1) || (r == n - 1 && c == 0);
                if (!corner) {
                    QrEncoder.DrawRing(dark, fn, size, pos[c + 1], pos[r + 1], 2, 1, -1);
                }
            }
        }

        if (ver >= 7) {
            int vinfo = QrEncoder.BchVersion(ver);
            for (int i = 0; i < 18; i = i + 1) {
                int a = i / 3;
                int b = i % 3;
                QrEncoder.SetFn(fn, size, a, size - 11 + b);
                QrEncoder.SetFn(fn, size, size - 11 + b, a);
                if (((vinfo >> i) & 1) != 0) {
                    dark[(size - 11 + b) * size + a] = true;
                    dark[a * size + (size - 11 + b)] = true;
                }
            }
        }

        for (int i = 0; i < 9; i = i + 1) {
            if (i != 6) {
                QrEncoder.SetFn(fn, size, 8, i);
                QrEncoder.SetFn(fn, size, i, 8);
            }
        }
        for (int i = 0; i < 8; i = i + 1) {
            QrEncoder.SetFn(fn, size, size - 1 - i, 8);
            if (i != 6) { QrEncoder.SetFn(fn, size, 8, size - 1 - i); }
        }
        QrEncoder.SetFn(fn, size, 8, size - 8);
        dark[8 * size + (size - 8)] = true;
    }

    static int[] EncodeBlocksAndInterleave(int ver, QrEcl ecl, int[] cw) {
        int[] plan = QrSpec.BlockPlan(ver, ecl);
        int k1 = plan[0]; int d1 = plan[1]; int k2 = plan[2]; int d2 = plan[3];
        int numBlocks = k1 + k2;
        int ecLen = QrSpec.EcPerBlock(ecl, ver);
        int dataTotal = QrSpec.DataCapacity(ver, ecl);
        int[] lens = new int[numBlocks];
        List<int[]> chunks = new List<int[]>();
        List<int[]> ecs = new List<int[]>();
        int p = 0;
        int[] gen = QrSpec.RsGenerator(ecLen);
        for (int b = 0; b < numBlocks; b = b + 1) {
            lens[b] = b < k1 ? d1 : d2;
            int[] chunk = new int[lens[b]];
            for (int t = 0; t < lens[b]; t = t + 1) {
                chunk[t] = cw[p];
                p = p + 1;
            }
            chunks.Add(chunk);
            ecs.Add(QrSpec.RsRemainder(chunk, lens[b], gen));
        }
        int[] blockData = new int[dataTotal + numBlocks * ecLen];
        int w = 0;
        int maxLen = d1 > d2 ? d1 : d2;
        for (int t = 0; t < maxLen; t = t + 1) {
            for (int b = 0; b < numBlocks; b = b + 1) {
                if (t < lens[b]) {
                    blockData[w] = chunks[b][t];
                    w = w + 1;
                }
            }
        }
        for (int t = 0; t < ecLen; t = t + 1) {
            for (int b = 0; b < numBlocks; b = b + 1) {
                blockData[w] = ecs[b][t];
                w = w + 1;
            }
        }
        return blockData;
    }

    static QrMatrix BuildMatrix(int ver, QrEcl ecl, int[] cw) {
        int size = ver * 4 + 17;
        bool[] dark = new bool[size * size];
        // 功能图形地图须与解码器（QrSpec.FunctionMap）逐位一致。
        bool[] fn = QrSpec.FunctionMap(ver);
        for (int i = 0; i < size * size; i = i + 1) { dark[i] = false; }
        QrEncoder.InitFunctionMatrix(ver, dark, fn, size);

        int[] blockData = QrEncoder.EncodeBlocksAndInterleave(ver, ecl, cw);
        bool[] finalDark = new bool[size * size];
        Array.Copy(dark, finalDark, size * size);
        int bit = 0;
        int totalCw = blockData.Length;
        for (int right = size - 1; right >= 1; right = right - 2) {
            int r2 = right <= 6 ? right - 1 : right;
            for (int vert = 0; vert < size; vert = vert + 1) {
                for (int z = 0; z < 2; z = z + 1) {
                    int j = r2 - z;
                    bool upwards = (r2 & 2) == 0;
                    if (j < 6) { upwards = !upwards; }
                    int y = upwards ? size - 1 - vert : vert;
                    int idx = y * size + j;
                    if (!fn[idx] && bit < totalCw * 8) {
                        finalDark[idx] = ((blockData[bit / 8] >> (7 - bit % 8)) & 1) != 0;
                        bit = bit + 1;
                    }
                }
            }
        }

        int bestPenalty = 0x7FFFFFFF;
        int cells = size * size;
        bool[] cand = new bool[cells];
        bool[] best = new bool[cells];
        for (int m = 0; m < 8; m = m + 1) {
            QrEncoder.ApplyMaskInto(finalDark, fn, size, m, ecl, cand);
            int pen = QrEncoder.Penalty(cand, size);
            if (pen < bestPenalty) {
                bestPenalty = pen;
                Array.Copy(cand, best, cells);
            }
        }
        QrMatrix mx = new QrMatrix();
        mx.version = ver;
        mx.size = size;
        mx.ecl = ecl;
        mx.modules = best;
        return mx;
    }

    static void ApplyMaskInto(bool[] dark, bool[] fn, int size, int mask, QrEcl ecl, bool[] outp) {
        Array.Copy(dark, outp, size * size);
        for (int y = 0; y < size; y = y + 1) {
            int rowBase = y * size;
            for (int x = 0; x < size; x = x + 1) {
                int idx = rowBase + x;
                if (!fn[idx] && QrEncoder.MaskBit(mask, x, y)) { outp[idx] = !outp[idx]; }
            }
        }
        int bits = QrFormat.EncodeBits(ecl, mask);
        for (int i = 0; i <= 5; i = i + 1) { outp[i * size + 8] = ((bits >> i) & 1) != 0; }
        outp[7 * size + 8] = ((bits >> 6) & 1) != 0;
        outp[8 * size + 8] = ((bits >> 7) & 1) != 0;
        outp[8 * size + 7] = ((bits >> 8) & 1) != 0;
        for (int i = 9; i < 15; i = i + 1) { outp[8 * size + (14 - i)] = ((bits >> i) & 1) != 0; }
        for (int i = 0; i < 8; i = i + 1) { outp[8 * size + (size - 1 - i)] = ((bits >> i) & 1) != 0; }
        for (int i = 8; i < 15; i = i + 1) { outp[(size - 15 + i) * size + 8] = ((bits >> i) & 1) != 0; }
        outp[8 * size + (size - 8)] = true;
    }

    public static bool MaskBit(int m, int x, int y) {
        if (m == 0) { return ((x + y) & 1) == 0; }
        if (m == 1) { return (y & 1) == 0; }
        if (m == 2) { return x % 3 == 0; }
        if (m == 3) { return (x + y) % 3 == 0; }
        if (m == 4) { return ((x / 3 + (y >> 1)) & 1) == 0; }
        if (m == 5) { int xy = x * y; return ((xy & 1) + xy % 3) == 0; }
        if (m == 6) { int xy = x * y; return (((xy & 1) + xy % 3) & 1) == 0; }
        return ((((x + y) & 1) + (x * y) % 3) & 1) == 0;
    }

    // 融合 2 遍扫描（水平遍合并游程/2x2块/11位移位寄存模式/暗模块计数；垂直遍合并游程/11位模式），
    // 消除原 6 遍扫描与 O(size^2*11) 内层循环，与原 Penalty 逐分等价。
    static int Penalty(bool[] m, int size) {
        int result = 0;
        int darkCount = 0;
        for (int y = 0; y < size; y = y + 1) {
            int rowBase = y * size;
            int nextRow = rowBase + size;
            bool hasNext = y + 1 < size;
            int runColor = -1;
            int runLen = 0;
            int bits = 0;
            for (int x = 0; x < size; x = x + 1) {
                bool cur = m[rowBase + x];
                int c = cur ? 1 : 0;
                darkCount = darkCount + c;
                if (c != runColor) {
                    if (runLen >= 5) { result = result + 3 + (runLen - 5); }
                    runColor = c;
                    runLen = 1;
                } else {
                    runLen = runLen + 1;
                }
                bits = ((bits << 1) | c) & 0x7FF;
                if (x >= 10 && bits == 0x05D) { result = result + 40; }
                if (hasNext && x + 1 < size) {
                    if (cur == m[rowBase + x + 1] && cur == m[nextRow + x] && cur == m[nextRow + x + 1]) {
                        result = result + 3;
                    }
                }
            }
            if (runLen >= 5) { result = result + 3 + (runLen - 5); }
        }
        for (int x = 0; x < size; x = x + 1) {
            int runColor = -1;
            int runLen = 0;
            int bits = 0;
            int idx = x;
            for (int y = 0; y < size; y = y + 1) {
                int c = m[idx] ? 1 : 0;
                idx = idx + size;
                if (c != runColor) {
                    if (runLen >= 5) { result = result + 3 + (runLen - 5); }
                    runColor = c;
                    runLen = 1;
                } else {
                    runLen = runLen + 1;
                }
                bits = ((bits << 1) | c) & 0x7FF;
                if (y >= 10 && bits == 0x05D) { result = result + 40; }
            }
            if (runLen >= 5) { result = result + 3 + (runLen - 5); }
        }
        int diff = darkCount * 100 / (size * size) - 50;
        if (diff < 0) { diff = -diff; }
        return result + ((diff + 4) / 5) * 10;
    }
}
