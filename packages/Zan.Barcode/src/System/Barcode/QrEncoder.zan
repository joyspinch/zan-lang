using System;
using System.Collections.Generic;

namespace System.Barcode;

// 纯 Zan QR Code（版本 1-40，ISO/IEC 18004）编码器；Encode 返回不含静区的 QrMatrix。
public class QrEncoder {
    public static int MODE_NUMERIC = 1;
    public static int MODE_ALNUM = 2;
    public static int MODE_BYTE = 4;

    static string ALNUM_CHARS = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ $%*+-./:";
    static int[] alnumLut = null;

    static int[] GetAlnumLut() {
        int[] t = QrEncoder.alnumLut;
        if (t != null) { return t; }
        int[] lut = new int[128];
        for (int i = 0; i < 128; i = i + 1) { lut[i] = -1; }
        for (int i = 0; i < 45; i = i + 1) {
            lut[ALNUM_CHARS[i] & 127] = i;
        }
        QrEncoder.alnumLut = lut;
        return lut;
    }

    public static QrMatrix Encode(string text, QrEcl ecl) {
        int segCount = 0;
        int[] segModes = null;
        int[] segStarts = null;
        int[] segLens = null;
        QrEncoder.BuildSegmentSpans(text, out segModes, out segStarts, out segLens, out segCount);
        int ver = QrEncoder.PickVersionSpans(segModes, segLens, segCount, ecl);
        if (ver < 0) {
            throw new BarcodeException(BarcodeError.TooLong, "content too long for QR version 40");
        }
        int totalCw = QrSpec.TotalCodewords(ver);
        int[] cw = new int[totalCw];
        QrEncoder.WriteSegmentSpans(text, segModes, segStarts, segLens, segCount, ver, ecl, cw);
        return QrEncoder.BuildMatrix(ver, ecl, cw);
    }

    public static QrEcl ParseEcl(string s) {
        if (s == null || s.Length != 1) { return QrEcl.M; }
        int b = s[0] & 255;
        if (b == 76 || b == 108) { return QrEcl.L; }
        if (b == 81 || b == 113) { return QrEcl.Q; }
        if (b == 72 || b == 104) { return QrEcl.H; }
        return QrEcl.M;
    }

    public static bool IsNumeric(int b) { return b >= 48 && b <= 57; }

    public static int AlnumValueByte(int c) {
        if (c < 0 || c >= 128) { return -1; }
        return QrEncoder.GetAlnumLut()[c];
    }

    public static int SeqByteLen(int lead) {
        if (lead < 128) { return 1; }
        if (lead < 224) { return 2; }
        if (lead < 240) { return 3; }
        return 4;
    }

    static int[] GrowQrInts(int[] arr, int count) {
        int[] nb = new int[arr.Length * 2];
        Array.Copy(arr, nb, count);
        return nb;
    }

    // 零 Substring、零逐位 List<int> 游程切段：只记录 (mode, start, byteLen)，
    // 将 <=8 字符短非 Byte 游程折回 Byte 并合并相邻 Byte 段（与原分段结果逐位一致）。
    static void BuildSegmentSpans(string text, out int[] outModes, out int[] outStarts, out int[] outLens, out int outCount) {
        if (text == null || text.Length == 0) {
            outModes = new int[0];
            outStarts = new int[0];
            outLens = new int[0];
            outCount = 0;
            return;
        }
        int[] lut = QrEncoder.GetAlnumLut();
        int len = text.Length;
        int[] rModes = new int[16];
        int[] rStarts = new int[16];
        int[] rLens = new int[16];
        int rCnt = 0;
        int i = 0;
        while (i < len) {
            int runStart = i;
            int b0 = text[i] & 255;
            int mode = b0 < 128 ? (b0 >= 48 && b0 <= 57 ? MODE_NUMERIC : (lut[b0] >= 0 ? MODE_ALNUM : MODE_BYTE)) : MODE_BYTE;
            int step0 = QrEncoder.SeqByteLen(b0);
            if (step0 > len - i) { step0 = len - i; }
            i = i + step0;
            while (i < len) {
                int bi = text[i] & 255;
                int m2 = bi < 128 ? (bi >= 48 && bi <= 57 ? MODE_NUMERIC : (lut[bi] >= 0 ? MODE_ALNUM : MODE_BYTE)) : MODE_BYTE;
                if (m2 != mode) { break; }
                int step = QrEncoder.SeqByteLen(bi);
                if (step > len - i) { step = len - i; }
                i = i + step;
            }
            if (rCnt >= rModes.Length) {
                rModes = QrEncoder.GrowQrInts(rModes, rCnt);
                rStarts = QrEncoder.GrowQrInts(rStarts, rCnt);
                rLens = QrEncoder.GrowQrInts(rLens, rCnt);
            }
            rModes[rCnt] = mode;
            rStarts[rCnt] = runStart;
            rLens[rCnt] = i - runStart;
            rCnt = rCnt + 1;
        }
        int[] fModes = new int[rCnt];
        int[] fStarts = new int[rCnt];
        int[] fLens = new int[rCnt];
        int fCnt = 0;
        for (int k = 0; k < rCnt; k = k + 1) {
            int m = rModes[k];
            int st = rStarts[k];
            int sl = rLens[k];
            if (m != MODE_BYTE && sl <= 8) {
                m = MODE_BYTE;
            }
            if (m == MODE_BYTE && fCnt > 0 && fModes[fCnt - 1] == MODE_BYTE) {
                fLens[fCnt - 1] = fLens[fCnt - 1] + sl;
            } else {
                fModes[fCnt] = m;
                fStarts[fCnt] = st;
                fLens[fCnt] = sl;
                fCnt = fCnt + 1;
            }
        }
        outModes = fModes;
        outStarts = fStarts;
        outLens = fLens;
        outCount = fCnt;
    }

    public static int ModeOfByte(int b, string text, int pos) {
        if (QrEncoder.SeqByteLen(b) == 1) {
            if (QrEncoder.IsNumeric(b)) { return MODE_NUMERIC; }
            if (QrEncoder.AlnumValueByte(b) >= 0) { return MODE_ALNUM; }
        }
        return MODE_BYTE;
    }

    static int CharCountBits(int mode, int ver) {
        int g = ver <= 9 ? 0 : (ver <= 26 ? 1 : 2);
        if (mode == MODE_NUMERIC) { return 10 + 2 * g; }
        if (mode == MODE_ALNUM) { return 9 + 2 * g; }
        return g == 0 ? 8 : 16;
    }

    static int SegmentDataBits(int mode, int chars) {
        if (mode == MODE_NUMERIC) {
            int rem = chars % 3;
            return (chars / 3) * 10 + (rem == 2 ? 7 : (rem == 1 ? 4 : 0));
        }
        if (mode == MODE_ALNUM) {
            return (chars / 2) * 11 + ((chars & 1) != 0 ? 6 : 0);
        }
        return chars * 8;
    }

    static int PickVersionSpans(int[] modes, int[] lens, int count, QrEcl ecl) {
        int baseBits = 0;
        for (int i = 0; i < count; i = i + 1) {
            baseBits = baseBits + 4 + QrEncoder.SegmentDataBits(modes[i], lens[i]);
        }
        for (int ver = 1; ver <= 40; ver = ver + 1) {
            int need = baseBits;
            for (int i = 0; i < count; i = i + 1) {
                need = need + QrEncoder.CharCountBits(modes[i], ver);
            }
            if (need <= QrSpec.DataCapacity(ver, ecl) * 8) { return ver; }
        }
        return -1;
    }

    static void PushBits(int[] cw, ref int cwPos, ref ulong bitBuf, ref int bitCnt, int val, int nBits) {
        bitBuf = (bitBuf << nBits) | ((ulong)val & ((1UL << nBits) - 1UL));
        bitCnt = bitCnt + nBits;
        while (bitCnt >= 8) {
            bitCnt = bitCnt - 8;
            cw[cwPos] = (int)((bitBuf >> bitCnt) & 255UL);
            cwPos = cwPos + 1;
        }
    }

    // 紧致位打包直接写入 cw：消除全部 List<int> 逐 bit 堆分配与二次 unpack。
    static void WriteSegmentSpans(string text, int[] modes, int[] starts, int[] lens, int count, int ver, QrEcl ecl, int[] cw) {
        int[] lut = QrEncoder.GetAlnumLut();
        ulong bitBuf = 0UL;
        int bitCnt = 0;
        int cwPos = 0;
        int totalBits = 0;
        for (int i = 0; i < count; i = i + 1) {
            int mode = modes[i];
            int st = starts[i];
            int sl = lens[i];
            int ccBits = QrEncoder.CharCountBits(mode, ver);
            QrEncoder.PushBits(cw, ref cwPos, ref bitBuf, ref bitCnt, mode, 4);
            QrEncoder.PushBits(cw, ref cwPos, ref bitBuf, ref bitCnt, sl, ccBits);
            totalBits = totalBits + 4 + ccBits;
            if (mode == MODE_NUMERIC) {
                int j = 0;
                while (j < sl) {
                    int take = sl - j;
                    if (take > 3) { take = 3; }
                    int v = 0;
                    for (int k = 0; k < take; k = k + 1) { v = v * 10 + ((text[st + j + k] & 255) - 48); }
                    int nb = take == 3 ? 10 : (take == 2 ? 7 : 4);
                    QrEncoder.PushBits(cw, ref cwPos, ref bitBuf, ref bitCnt, v, nb);
                    totalBits = totalBits + nb;
                    j = j + take;
                }
            } else if (mode == MODE_ALNUM) {
                int j = 0;
                while (j + 2 <= sl) {
                    int v = lut[text[st + j] & 127] * 45 + lut[text[st + j + 1] & 127];
                    QrEncoder.PushBits(cw, ref cwPos, ref bitBuf, ref bitCnt, v, 11);
                    totalBits = totalBits + 11;
                    j = j + 2;
                }
                if (j < sl) {
                    int v = lut[text[st + j] & 127];
                    QrEncoder.PushBits(cw, ref cwPos, ref bitBuf, ref bitCnt, v, 6);
                    totalBits = totalBits + 6;
                }
            } else {
                for (int j = 0; j < sl; j = j + 1) {
                    QrEncoder.PushBits(cw, ref cwPos, ref bitBuf, ref bitCnt, text[st + j] & 255, 8);
                }
                totalBits = totalBits + sl * 8;
            }
        }
        int cap = QrSpec.DataCapacity(ver, ecl);
        int term = cap * 8 - totalBits;
        if (term > 4) { term = 4; }
        if (term > 0) {
            QrEncoder.PushBits(cw, ref cwPos, ref bitBuf, ref bitCnt, 0, term);
        }
        if (bitCnt > 0) {
            cw[cwPos] = (int)((bitBuf << (8 - bitCnt)) & 255UL);
            cwPos = cwPos + 1;
        }
        for (int i = cwPos; i < cap; i = i + 1) {
            cw[i] = ((i - cwPos) & 1) == 0 ? 0xEC : 0x11;
        }
    }

    static void SetFn(bool[] fn, int size, int x, int y) {
        if (x < 0 || y < 0 || x >= size || y >= size) { return; }
        fn[y * size + x] = true;
    }

    // 绘制同心方环功能图形（定位 r=4 留白 dist 2/4；校正 r=2 留白 dist 1）。
    // 仅写入功能图形的深色模块到 dark（fn 直接共享 QrSpec.FunctionMapReadOnly(ver)，免除重复写入与拷贝）。
    static void DrawRingDarkOnly(bool[] dark, int size, int cx, int cy, int radius, int hole1, int hole2) {
        for (int dy = -radius; dy <= radius; dy = dy + 1) {
            int y = cy + dy;
            if (y < 0 || y >= size) { continue; }
            int rowBase = y * size;
            int ady = dy < 0 ? -dy : dy;
            for (int dx = -radius; dx <= radius; dx = dx + 1) {
                int x = cx + dx;
                if (x < 0 || x >= size) { continue; }
                int adx = dx < 0 ? -dx : dx;
                int dist = ady > adx ? ady : adx;
                if (dist != hole1 && dist != hole2) {
                    dark[rowBase + x] = true;
                }
            }
        }
    }

    static int BchVersion(int ver) {
        int d = ver << 12;
        // 消去比特 17..12 共 6 位（只循环 5 次会残留高位污染版本信息）。
        for (int i = 0; i <= 5; i = i + 1) {
            if (((d >> (17 - i)) & 1) != 0) { d = d ^ (0x1F25 << (5 - i)); }
        }
        return (ver << 12) | d;
    }

    static void InitFunctionDark(int ver, bool[] dark, int size) {
        QrEncoder.DrawRingDarkOnly(dark, size, 3, 3, 4, 2, 4);
        QrEncoder.DrawRingDarkOnly(dark, size, size - 4, 3, 4, 2, 4);
        QrEncoder.DrawRingDarkOnly(dark, size, 3, size - 4, 4, 2, 4);

        for (int i = 8; i <= size - 9; i = i + 2) {
            dark[6 * size + i] = true;
            dark[i * size + 6] = true;
        }

        int[] pos = QrSpec.AlignPattern(ver);
        int n = pos.Length - 1;
        for (int r = 0; r < n; r = r + 1) {
            for (int c = 0; c < n; c = c + 1) {
                bool corner = (r == 0 && c == 0) || (r == 0 && c == n - 1) || (r == n - 1 && c == 0);
                if (!corner) {
                    QrEncoder.DrawRingDarkOnly(dark, size, pos[c + 1], pos[r + 1], 2, 1, -1);
                }
            }
        }

        if (ver >= 7) {
            int vinfo = QrEncoder.BchVersion(ver);
            for (int i = 0; i < 18; i = i + 1) {
                if (((vinfo >> i) & 1) != 0) {
                    int a = i / 3;
                    int b = i % 3;
                    dark[(size - 11 + b) * size + a] = true;
                    dark[a * size + (size - 11 + b)] = true;
                }
            }
        }
        dark[8 * size + (size - 8)] = true;
    }

    static int[] EncodeBlocksAndInterleave(int ver, QrEcl ecl, int[] cw) {
        int[] plan = QrSpec.BlockPlan(ver, ecl);
        int k1 = plan[0]; int d1 = plan[1]; int k2 = plan[2]; int d2 = plan[3];
        int numBlocks = k1 + k2;
        int ecLen = QrSpec.EcPerBlock(ecl, ver);
        int dataTotal = QrSpec.DataCapacity(ver, ecl);
        int[] offs = new int[numBlocks];
        int[] lens = new int[numBlocks];
        int[] ecAll = new int[numBlocks * ecLen];
        int p = 0;
        int[] gen = QrSpec.RsGenerator(ecLen);
        for (int b = 0; b < numBlocks; b = b + 1) {
            int bl = b < k1 ? d1 : d2;
            offs[b] = p;
            lens[b] = bl;
            QrSpec.RsRemainderSlice(cw, p, bl, gen, ecAll, b * ecLen);
            p = p + bl;
        }
        int[] blockData = new int[dataTotal + numBlocks * ecLen];
        int w = 0;
        int maxLen = d1 > d2 ? d1 : d2;
        for (int t = 0; t < maxLen; t = t + 1) {
            for (int b = 0; b < numBlocks; b = b + 1) {
                if (t < lens[b]) {
                    blockData[w] = cw[offs[b] + t];
                    w = w + 1;
                }
            }
        }
        for (int t = 0; t < ecLen; t = t + 1) {
            for (int b = 0; b < numBlocks; b = b + 1) {
                blockData[w] = ecAll[b * ecLen + t];
                w = w + 1;
            }
        }
        return blockData;
    }

    static QrMatrix BuildMatrix(int ver, QrEcl ecl, int[] cw) {
        int size = ver * 4 + 17;
        int cells = size * size;
        // 直接共享只读功能图形模板（零矩阵拷贝）。
        bool[] fn = QrSpec.FunctionMapReadOnly(ver);
        bool[] finalDark = new bool[cells];
        QrEncoder.InitFunctionDark(ver, finalDark, size);

        int[] blockData = QrEncoder.EncodeBlocksAndInterleave(ver, ecl, cw);
        int bit = 0;
        int totalBits = blockData.Length * 8;
        for (int right = size - 1; right >= 1; right = right - 2) {
            int r2 = right <= 6 ? right - 1 : right;
            for (int vert = 0; vert < size; vert = vert + 1) {
                for (int z = 0; z < 2; z = z + 1) {
                    int j = r2 - z;
                    bool upwards = (r2 & 2) == 0;
                    if (j < 6) { upwards = !upwards; }
                    int y = upwards ? size - 1 - vert : vert;
                    int idx = y * size + j;
                    if (!fn[idx] && bit < totalBits) {
                        finalDark[idx] = ((blockData[bit >> 3] >> (7 - (bit & 7))) & 1) != 0;
                        bit = bit + 1;
                    }
                }
            }
        }

        int bestPenalty = 0x7FFFFFFF;
        bool[] cand = new bool[cells];
        bool[] best = new bool[cells];
        for (int m = 0; m < 8; m = m + 1) {
            QrEncoder.ApplyMaskInto(finalDark, fn, size, m, ecl, cand);
            int pen = QrEncoder.Penalty(cand, size);
            if (pen < bestPenalty) {
                bestPenalty = pen;
                bool[] swap = best;
                best = cand;
                cand = swap;
            }
        }
        QrMatrix mx = new QrMatrix();
        mx.version = ver;
        mx.size = size;
        mx.ecl = ecl;
        mx.modules = best;
        return mx;
    }

    // 按 8 种掩码特化循环外分发：消除逐像素 MaskBit 调用与整数除法取模（% 3 改为 0..2 递推计数）。
    static void ApplyMaskInto(bool[] dark, bool[] fn, int size, int mask, QrEcl ecl, bool[] outp) {
        Array.Copy(dark, outp, size * size);
        if (mask == 0) {
            for (int y = 0; y < size; y = y + 1) {
                int rowBase = y * size;
                for (int x = y & 1; x < size; x = x + 2) {
                    int idx = rowBase + x;
                    if (!fn[idx]) { outp[idx] = !outp[idx]; }
                }
            }
        } else if (mask == 1) {
            for (int y = 0; y < size; y = y + 2) {
                int rowBase = y * size;
                for (int x = 0; x < size; x = x + 1) {
                    int idx = rowBase + x;
                    if (!fn[idx]) { outp[idx] = !outp[idx]; }
                }
            }
        } else if (mask == 2) {
            for (int y = 0; y < size; y = y + 1) {
                int rowBase = y * size;
                for (int x = 0; x < size; x = x + 3) {
                    int idx = rowBase + x;
                    if (!fn[idx]) { outp[idx] = !outp[idx]; }
                }
            }
        } else if (mask == 3) {
            int yMod = 0;
            for (int y = 0; y < size; y = y + 1) {
                int rowBase = y * size;
                int startX = yMod == 0 ? 0 : (3 - yMod);
                for (int x = startX; x < size; x = x + 3) {
                    int idx = rowBase + x;
                    if (!fn[idx]) { outp[idx] = !outp[idx]; }
                }
                yMod = yMod + 1;
                if (yMod == 3) { yMod = 0; }
            }
        } else if (mask == 4) {
            for (int y = 0; y < size; y = y + 1) {
                int rowBase = y * size;
                int yHalf = (y >> 1) & 1;
                int xDiv3Par = 0;
                int xMod3 = 0;
                for (int x = 0; x < size; x = x + 1) {
                    if ((xDiv3Par ^ yHalf) == 0) {
                        int idx = rowBase + x;
                        if (!fn[idx]) { outp[idx] = !outp[idx]; }
                    }
                    xMod3 = xMod3 + 1;
                    if (xMod3 == 3) { xMod3 = 0; xDiv3Par = xDiv3Par ^ 1; }
                }
            }
        } else if (mask == 5) {
            int yMod3 = 0;
            for (int y = 0; y < size; y = y + 1) {
                int rowBase = y * size;
                int yOdd = y & 1;
                int xyMod3 = 0;
                for (int x = 0; x < size; x = x + 1) {
                    if (((x & yOdd) == 0) && xyMod3 == 0) {
                        int idx = rowBase + x;
                        if (!fn[idx]) { outp[idx] = !outp[idx]; }
                    }
                    xyMod3 = xyMod3 + yMod3;
                    if (xyMod3 >= 3) { xyMod3 = xyMod3 - 3; }
                }
                yMod3 = yMod3 + 1;
                if (yMod3 == 3) { yMod3 = 0; }
            }
        } else if (mask == 6) {
            int yMod3 = 0;
            for (int y = 0; y < size; y = y + 1) {
                int rowBase = y * size;
                int yOdd = y & 1;
                int xyMod3 = 0;
                for (int x = 0; x < size; x = x + 1) {
                    if ((((x & yOdd) + xyMod3) & 1) == 0) {
                        int idx = rowBase + x;
                        if (!fn[idx]) { outp[idx] = !outp[idx]; }
                    }
                    xyMod3 = xyMod3 + yMod3;
                    if (xyMod3 >= 3) { xyMod3 = xyMod3 - 3; }
                }
                yMod3 = yMod3 + 1;
                if (yMod3 == 3) { yMod3 = 0; }
            }
        } else {
            int yMod3 = 0;
            for (int y = 0; y < size; y = y + 1) {
                int rowBase = y * size;
                int yOdd = y & 1;
                int xyMod3 = 0;
                for (int x = 0; x < size; x = x + 1) {
                    if (((((x + yOdd) & 1) + xyMod3) & 1) == 0) {
                        int idx = rowBase + x;
                        if (!fn[idx]) { outp[idx] = !outp[idx]; }
                    }
                    xyMod3 = xyMod3 + yMod3;
                    if (xyMod3 >= 3) { xyMod3 = xyMod3 - 3; }
                }
                yMod3 = yMod3 + 1;
                if (yMod3 == 3) { yMod3 = 0; }
            }
        }
        int bits = QrFormat.EncodeBits(ecl, mask);
        for (int i = 0; i <= 5; i = i + 1) { outp[i * size + 8] = ((bits >> i) & 1) != 0; }
        outp[7 * size + 8] = ((bits >> 6) & 1) != 0;
        outp[8 * size + 8] = ((bits >> 7) & 1) != 0;
        outp[8 * size + 7] = ((bits >> 8) & 1) != 0;
        for (int i = 9; i < 15; i = i + 1) { outp[8 * size + (14 - i)] = ((bits >> i) & 1) != 0; }
        for (int i = 0; i < 8; i = i + 1) { outp[8 * size + (size - 1 - i)] = ((bits >> i) & 1) != 0; }
        for (int i = 8; i < 15; i = i + 1) { outp[(size - 15 + i) * size + 8] = ((bits >> i) & 1) != 0; }
        outp[8 * size + (size - 8)] = true;
    }

    public static bool MaskBit(int m, int x, int y) {
        if (m == 0) { return ((x + y) & 1) == 0; }
        if (m == 1) { return (y & 1) == 0; }
        if (m == 2) { return x % 3 == 0; }
        if (m == 3) { return (x + y) % 3 == 0; }
        if (m == 4) { return ((x / 3 + (y >> 1)) & 1) == 0; }
        if (m == 5) { int xy = x * y; return ((xy & 1) + xy % 3) == 0; }
        if (m == 6) { int xy = x * y; return (((xy & 1) + xy % 3) & 1) == 0; }
        return ((((x + y) & 1) + (x * y) % 3) & 1) == 0;
    }

    // 融合 2 遍扫描（水平遍合并游程/2x2块/11位移位寄存模式/暗模块计数；垂直遍合并游程/11位模式），
    // 消除原 6 遍扫描与 O(size^2*11) 内层循环，与原 Penalty 逐分等价。
    static int Penalty(bool[] m, int size) {
        int result = 0;
        int darkCount = 0;
        for (int y = 0; y < size; y = y + 1) {
            int rowBase = y * size;
            int nextRow = rowBase + size;
            bool hasNext = y + 1 < size;
            int runColor = -1;
            int runLen = 0;
            int bits = 0;
            for (int x = 0; x < size; x = x + 1) {
                bool cur = m[rowBase + x];
                int c = cur ? 1 : 0;
                darkCount = darkCount + c;
                if (c != runColor) {
                    if (runLen >= 5) { result = result + 3 + (runLen - 5); }
                    runColor = c;
                    runLen = 1;
                } else {
                    runLen = runLen + 1;
                }
                bits = ((bits << 1) | c) & 0x7FF;
                if (x >= 10 && (bits == 0x05D || bits == 0x5D0)) { result = result + 40; }
                if (hasNext && x + 1 < size) {
                    if (cur == m[rowBase + x + 1] && cur == m[nextRow + x] && cur == m[nextRow + x + 1]) {
                        result = result + 3;
                    }
                }
            }
            if (runLen >= 5) { result = result + 3 + (runLen - 5); }
        }
        for (int x = 0; x < size; x = x + 1) {
            int runColor = -1;
            int runLen = 0;
            int bits = 0;
            int idx = x;
            for (int y = 0; y < size; y = y + 1) {
                int c = m[idx] ? 1 : 0;
                idx = idx + size;
                if (c != runColor) {
                    if (runLen >= 5) { result = result + 3 + (runLen - 5); }
                    runColor = c;
                    runLen = 1;
                } else {
                    runLen = runLen + 1;
                }
                bits = ((bits << 1) | c) & 0x7FF;
                if (y >= 10 && (bits == 0x05D || bits == 0x5D0)) { result = result + 40; }
            }
            if (runLen >= 5) { result = result + 3 + (runLen - 5); }
        }
        int diff = darkCount * 100 / (size * size) - 50;
        if (diff < 0) { diff = -diff; }
        return result + ((diff + 4) / 5) * 10;
    }
}
