using System;
using System.Collections.Generic;

namespace System.Barcode;

// Reed-Solomon 纠错解码（GF(256)，本原多项式 0x11D，Berlekamp-Massey + 增量 Chien 搜索 + Forney）。
// 码字 block[0] 为最高次项；内部多项式一律按升幂下标表示。
public class QrRsDecoder {

    // 就地纠错一个码字块；错误过多或无法通过伴随式复核时返回 false。
    public static bool Decode(int[] block, int ecLen) {
        if (block == null || ecLen <= 0) { return false; }
        int n = block.Length;
        if (n <= ecLen) { return false; }
        for (int i = 0; i < n; i = i + 1) {
            if (block[i] < 0 || block[i] > 255) { return false; }
        }

        int[] synd = QrRsDecoder.Syndromes(block, ecLen);
        bool clean = true;
        for (int i = 0; i < ecLen; i = i + 1) {
            if (synd[i] != 0) { clean = false; break; }
        }
        if (clean) { return true; }

        int[][] eo = QrRsDecoder.ErrorLocatorAndEvaluator(synd, ecLen);
        if (eo == null) { return false; }
        int[] lambda = eo[0];
        int[] omega = eo[1];
        int nerr = lambda.Length - 1;
        if (nerr <= 0 || nerr > ecLen / 2) { return false; }

        List<int> positions = QrRsDecoder.ErrorPositions(lambda, n, nerr);
        if (positions == null) { return false; }

        int[] expArr = QrSpec.GfExpTable();
        int[] logArr = QrSpec.GfLogTable();
        Span<int> exp = new Span<int>((nint)expArr, 512);
        Span<int> log = new Span<int>((nint)logArr, 256);

        int posCnt = positions.Count;
        int[] mags = new int[posCnt];
        for (int k = 0; k < posCnt; k = k + 1) {
            int j = positions[k];
            int d = n - 1 - j;
            int dMod = d % 255;
            int xLoc = exp[dMod];
            int xInv = exp[dMod == 0 ? 0 : (255 - dMod)];
            int num = QrRsDecoder.EvalFast(omega, xInv, exp, log);
            int den = QrRsDecoder.EvalDerivFast(lambda, xInv, exp, log);
            if (den == 0) { return false; }
            int magnitude = 0;
            if (num != 0) {
                int mIdx = log[xLoc] + log[num] - log[den];
                if (mIdx < 0) { mIdx = mIdx + 255; }
                magnitude = exp[mIdx];
            }
            mags[k] = magnitude;
        }
        for (int k = 0; k < posCnt; k = k + 1) {
            int j = positions[k];
            block[j] = block[j] ^ mags[k];
        }

        // 内联伴随式复核（失败时回滚已写入的修正量，避免污染调用方缓冲）
        Span<int> blk = new Span<int>((nint)block, n);
        for (int i = 0; i < ecLen; i = i + 1) {
            int logX = i % 255;
            int s = 0;
            for (int j = 0; j < n; j = j + 1) {
                int bj = blk[j];
                s = (s == 0 ? 0 : exp[log[s] + logX]) ^ bj;
            }
            if (s != 0) {
                for (int k = 0; k < posCnt; k = k + 1) {
                    int j = positions[k];
                    block[j] = block[j] ^ mags[k];
                }
                return false;
            }
        }
        return true;
    }

    // 伴随式 S_i = r(α^i)，i = 0..ecLen-1（Span 直查 GF 指数/对数表 + 预提 logX，消除逐字节 GfMul 调用）。
    public static int[] Syndromes(int[] block, int ecLen) {
        if (block == null || ecLen <= 0) { return new int[0]; }
        int[] synd = new int[ecLen];
        int n = block.Length;
        if (n == 0) { return synd; }
        int[] expArr = QrSpec.GfExpTable();
        int[] logArr = QrSpec.GfLogTable();
        Span<int> exp = new Span<int>((nint)expArr, 512);
        Span<int> log = new Span<int>((nint)logArr, 256);
        Span<int> blk = new Span<int>((nint)block, n);
        Span<int> dst = new Span<int>((nint)synd, ecLen);
        for (int i = 0; i < ecLen; i = i + 1) {
            int logX = i % 255;
            int s = 0;
            int j = 0;
            while (j + 4 <= n) {
                s = (s == 0 ? 0 : exp[log[s] + logX]) ^ (blk[j] & 255);
                s = (s == 0 ? 0 : exp[log[s] + logX]) ^ (blk[j + 1] & 255);
                s = (s == 0 ? 0 : exp[log[s] + logX]) ^ (blk[j + 2] & 255);
                s = (s == 0 ? 0 : exp[log[s] + logX]) ^ (blk[j + 3] & 255);
                j = j + 4;
            }
            while (j < n) {
                s = (s == 0 ? 0 : exp[log[s] + logX]) ^ (blk[j] & 255);
                j = j + 1;
            }
            dst[i] = s;
        }
        return synd;
    }

    // Berlekamp-Massey + Forney 求值多项式：返回 [Λ, Ω]（Λ(0)=1 归一化），失败返回 null。
    // 全程在固定长度工作缓冲原地迭代，消除 Sugiyama 欧几里得的多项式临时堆分配。
    public static int[][] ErrorLocatorAndEvaluator(int[] synd, int ecLen) {
        if (synd == null || ecLen <= 0) { return null; }
        int copyLen = synd.Length < ecLen ? synd.Length : ecLen;
        bool allZero = true;
        for (int i = 0; i < copyLen; i = i + 1) {
            if (synd[i] != 0) { allZero = false; break; }
        }
        if (allZero) { return null; }

        int[] expArr = QrSpec.GfExpTable();
        int[] logArr = QrSpec.GfLogTable();
        Span<int> exp = new Span<int>((nint)expArr, 512);
        Span<int> log = new Span<int>((nint)logArr, 256);

        int cap = ecLen + 1;
        // 单块连续暂存缓冲承载 C/B/T/om（必要时末尾附 S），将每块临时堆分配从 5 次压缩至 1 次。
        bool needCopyS = synd.Length < ecLen;
        int workLen = cap * 3 + ecLen + (needCopyS ? ecLen : 0);
        int[] work = new int[workLen];
        nint wp = (nint)work;
        Span<int> C = new Span<int>(wp, cap);
        Span<int> B = new Span<int>(wp + (nint)(cap * 4), cap);
        Span<int> T = new Span<int>(wp + (nint)(cap * 8), cap);
        Span<int> om = new Span<int>(wp + (nint)(cap * 12), ecLen);
        Span<int> S;
        if (needCopyS) {
            S = new Span<int>(wp + (nint)((cap * 3 + ecLen) * 4), ecLen);
            for (int i = 0; i < copyLen; i = i + 1) { S[i] = synd[i]; }
        } else {
            S = new Span<int>((nint)synd, ecLen);
        }

        C[0] = 1;
        B[0] = 1;
        int L = 0;
        int bLen = 0;
        int m = 1;
        int b = 1;

        for (int step = 0; step < ecLen; step = step + 1) {
            int d = S[step];
            for (int i = 1; i <= L; i = i + 1) {
                int ci = C[i];
                int si = S[step - i];
                if (ci != 0 && si != 0) {
                    d = d ^ exp[log[ci] + log[si]];
                }
            }
            if (d == 0) {
                m = m + 1;
                continue;
            }
            int logCoef = log[d] - log[b];
            if (logCoef < 0) { logCoef = logCoef + 255; }
            if (2 * L <= step) {
                for (int i = 0; i <= L; i = i + 1) { T[i] = C[i]; }
                int oldL = L;
                for (int i = 0; i <= bLen; i = i + 1) {
                    int bi = B[i];
                    if (bi != 0 && i + m < cap) {
                        C[i + m] = C[i + m] ^ exp[log[bi] + logCoef];
                    }
                }
                L = step + 1 - L;
                for (int i = 0; i <= oldL; i = i + 1) { B[i] = T[i]; }
                bLen = oldL;
                b = d;
                m = 1;
            } else {
                for (int i = 0; i <= bLen; i = i + 1) {
                    int bi = B[i];
                    if (bi != 0 && i + m < cap) {
                        C[i + m] = C[i + m] ^ exp[log[bi] + logCoef];
                    }
                }
                m = m + 1;
            }
        }

        int degL = L < ecLen ? L : ecLen;
        while (degL > 0 && C[degL] == 0) { degL = degL - 1; }
        if (degL <= 0 || C[0] == 0) { return null; }

        int[] lambda = new int[degL + 1];
        for (int i = 0; i <= degL; i = i + 1) { lambda[i] = C[i]; }

        // Ω(x) = S(x) · Λ(x) mod x^{ecLen}
        for (int i = 0; i <= degL; i = i + 1) {
            int li = C[i];
            if (li == 0) { continue; }
            int logLi = log[li];
            int lim = ecLen - i;
            for (int j = 0; j < lim; j = j + 1) {
                int sj = S[j];
                if (sj != 0) {
                    om[i + j] = om[i + j] ^ exp[logLi + log[sj]];
                }
            }
        }
        int omLen = ecLen;
        while (omLen > 0 && om[omLen - 1] == 0) { omLen = omLen - 1; }
        int[] omega = new int[omLen];
        for (int i = 0; i < omLen; i = i + 1) { omega[i] = om[i]; }

        return new int[][]{ lambda, omega };
    }

    // 增量 Chien 搜索：每步仅将各项乘以 α^{-i}，单缓冲切片消除二次分配与逐点重算幂次。
    public static List<int> ErrorPositions(int[] lambda, int n, int expected) {
        List<int> outp = new List<int>();
        if (lambda == null || lambda.Length == 0) { return null; }
        int deg = lambda.Length - 1;
        int[] expArr = QrSpec.GfExpTable();
        int[] logArr = QrSpec.GfLogTable();
        Span<int> exp = new Span<int>((nint)expArr, 512);
        Span<int> log = new Span<int>((nint)logArr, 256);

        int stride = deg + 1;
        int[] work = new int[stride * 2];
        nint wp = (nint)work;
        Span<int> terms = new Span<int>(wp, stride);
        Span<int> steps = new Span<int>(wp + (nint)(stride * 4), stride);
        for (int i = 0; i <= deg; i = i + 1) {
            terms[i] = lambda[i];
            int im = i % 255;
            steps[i] = im == 0 ? 0 : (255 - im);
        }

        int t0 = terms[0];
        for (int d = 0; d < n; d = d + 1) {
            int val = t0;
            for (int i = 1; i <= deg; i = i + 1) {
                int ti = terms[i];
                if (ti != 0) {
                    val = val ^ ti;
                    terms[i] = exp[log[ti] + steps[i]];
                }
            }
            if (val == 0) {
                outp.Add(n - 1 - d);
            }
        }
        if (outp.Count != expected) { return null; }
        return outp;
    }

    // 形式导数 Λ'(x)（特征 2：只有奇次项保留，次数降一）。
    public static int[] FormalDerivative(int[] lambda) {
        int len = lambda.Length;
        int[] d = new int[len > 0 ? len - 1 : 0];
        for (int i = 1; i < len; i = i + 2) {
            d[i - 1] = lambda[i];
        }
        return d;
    }

    // 直接对 Λ 的奇次项按 p^2 做 Horner 求值（特征 2 形式导数 Λ'(p)，零数组分配且步数减半）。
    private static int EvalDerivFast(int[] lambda, int p, Span<int> exp, Span<int> log) {
        int len = lambda.Length;
        if (len <= 1) { return 0; }
        if (p == 0) { return lambda[1]; }
        int top = ((len - 1) & 1) == 1 ? (len - 1) : (len - 2);
        int logP2 = log[p] << 1;
        if (logP2 >= 255) { logP2 = logP2 - 255; }
        int val = lambda[top];
        for (int i = top - 2; i >= 1; i = i - 2) {
            val = (val == 0 ? 0 : exp[log[val] + logP2]) ^ lambda[i];
        }
        return val;
    }

    private static int EvalFast(int[] coeff, int p, Span<int> exp, Span<int> log) {
        int len = coeff.Length;
        if (len == 0) { return 0; }
        if (p == 0) { return coeff[0]; }
        int logP = log[p];
        int val = coeff[len - 1];
        for (int i = len - 2; i >= 0; i = i - 1) {
            val = (val == 0 ? 0 : exp[log[val] + logP]) ^ coeff[i];
        }
        return val;
    }

    // 升幂多项式在点 p 处的值：Σ coeff[i]·p^i（Horner 递推 + 直接查表）。
    public static int Eval(int[] coeff, int p) {
        if (coeff == null || coeff.Length == 0) { return 0; }
        int[] expArr = QrSpec.GfExpTable();
        int[] logArr = QrSpec.GfLogTable();
        Span<int> exp = new Span<int>((nint)expArr, 512);
        Span<int> log = new Span<int>((nint)logArr, 256);
        return QrRsDecoder.EvalFast(coeff, p, exp, log);
    }
}
