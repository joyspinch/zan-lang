using System;
using System.Collections.Generic;

namespace System.Json;

// JSON Pointer（RFC 6901）："/a/b/0" 形式的路径。
//
// 用于两处：JSON Patch 的 path/from 定位，以及 JSON Schema 报出的
// 实例路径。转义规则是 "~" → "~0"、"/" → "~1"（顺序不能反：先转 "~"
// 再转 "/"）。
public class JsonPointer {
    // 转义一段路径。
    public static string Escape(string token) {
        if (token == null) { return ""; }
        string t = token.Replace("~", "~0");
        return t.Replace("/", "~1");
    }

    // 还原一段路径。
    public static string Unescape(string token) {
        if (token == null) { return ""; }
        string t = token.Replace("~1", "/");
        return t.Replace("~0", "~");
    }

    // 拆指针："" → 空表；"/a/b" → ["a","b"]；"/" → [""]。
    // 指针必须以 '/' 开头，否则抛 ArgumentException。
    public static List<string> Split(string pointer) {
        List<string> out2 = new List<string>();
        if (pointer == null || pointer.Length == 0) { return out2; }
        if ((pointer[0] & 255) != 47) {
            throw new ArgumentException("JSON Pointer must start with '/': " + pointer);
        }
        int n = pointer.Length;
        int i = 1;
        while (true) {
            int start = i;
            while (i < n && (pointer[i] & 255) != 47) { i = i + 1; }
            out2.Add(JsonPointer.Unescape(pointer.Substring(start, i - start)));
            if (i >= n) { break; }
            i = i + 1;
        }
        return out2;
    }

    // 把若干段拼成指针（段不再转义——调用方给的是原始键名时需自己转义）。
    public static string Join(List<string> parts) {
        if (parts == null) { return ""; }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < parts.Count; i = i + 1) {
            sb.Append("/");
            sb.Append(JsonPointer.Escape(parts[i]));
        }
        return sb.ToString();
    }
}
