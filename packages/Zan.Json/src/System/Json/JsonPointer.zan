using System;
using System.Collections.Generic;

namespace System.Json;

// JSON Pointer（RFC 6901）："/a/b/0" 形式的路径。
//
// 用于两处：JSON Patch 的 path/from 定位，以及 JSON Schema 报出的
// 实例路径。转义规则是 "~" → "~0"、"/" → "~1"（顺序不能反：先转 "~"
// 再转 "/"）。
public class JsonPointer {
    // 转义一段路径（无 '~'/'/' 时 O(1) 零分配原样返回；有转义单遍直写）。
    public static string Escape(string token) {
        if (token == null) { return ""; }
        int n = token.Length;
        if (n == 0) { return ""; }
        nint tp = (nint)token;
        if (NativeMemory.IndexOfAny(tp, n, 126, 47) < 0) {
            return token;
        }
        Span<byte> tb = new Span<byte>(tp, n);
        int extra = 0;
        for (int i = 0; i < n; i = i + 1) {
            int c = tb[i] & 255;
            if (c == 126 || c == 47) { extra = extra + 1; }
        }
        byte[] outb = new byte[n + extra];
        int o = 0;
        for (int i = 0; i < n; i = i + 1) {
            int c = tb[i] & 255;
            if (c == 126) {
                outb[o] = 126; outb[o + 1] = 48; o = o + 2;
            } else if (c == 47) {
                outb[o] = 126; outb[o + 1] = 49; o = o + 2;
            } else {
                outb[o] = (byte)c; o = o + 1;
            }
        }
        return NativeMemory.GetString((nint)outb, 0, o);
    }

    // 还原一段路径（无 '~' 时零分配原样返回；有转义单遍直写）。
    public static string Unescape(string token) {
        if (token == null) { return ""; }
        int n = token.Length;
        if (n == 0) { return ""; }
        nint tp = (nint)token;
        if (NativeMemory.Find(tp, 0, 126, n) < 0) {
            return token;
        }
        return JsonPointer.UnescapeSliceRaw(tp, 0, n);
    }

    // 内部零中间串切片还原：无 '~' 直接切出一次字符串，有 '~' 单遍解码。
    internal static string UnescapeSlice(nint ptr, int start, int len) {
        if (len <= 0) { return ""; }
        if (NativeMemory.Find(ptr, start, 126, len) < 0) {
            return NativeMemory.GetString(ptr, start, len);
        }
        return JsonPointer.UnescapeSliceRaw(ptr, start, len);
    }

    private static string UnescapeSliceRaw(nint ptr, int start, int len) {
        Span<byte> tb = new Span<byte>(ptr + (nint)start, len);
        byte[] outb = new byte[len];
        int o = 0;
        int i = 0;
        while (i < len) {
            int c = tb[i] & 255;
            if (c == 126 && i + 1 < len) {
                int nx = tb[i + 1] & 255;
                if (nx == 49) {
                    outb[o] = 47; o = o + 1; i = i + 2; continue;
                }
                if (nx == 48) {
                    outb[o] = 126; o = o + 1; i = i + 2; continue;
                }
            }
            outb[o] = (byte)c;
            o = o + 1;
            i = i + 1;
        }
        return NativeMemory.GetString((nint)outb, 0, o);
    }

    // 拆指针："" → 空表；"/a/b" → ["a","b"]；"/" → [""]。
    // 指针必须以 '/' 开头，否则抛 ArgumentException。
    public static List<string> Split(string pointer) {
        List<string> out2 = new List<string>();
        if (pointer == null || pointer.Length == 0) { return out2; }
        if ((pointer[0] & 255) != 47) {
            throw new ArgumentException("JSON Pointer must start with '/': " + pointer);
        }
        int n = pointer.Length;
        nint pp = (nint)pointer;
        int i = 1;
        while (true) {
            int slash = i < n ? NativeMemory.Find(pp, i, 47, n - i) : -1;
            int end = slash < 0 ? n : slash;
            out2.Add(JsonPointer.UnescapeSlice(pp, i, end - i));
            if (slash < 0) { break; }
            i = slash + 1;
        }
        return out2;
    }

    // 把若干段拼成指针（两遍精确计算 + 单次 byte[] 分配直写，零 StringBuilder/临时转义串）。
    public static string Join(List<string> parts) {
        if (parts == null || parts.Count == 0) { return ""; }
        int cnt = parts.Count;
        int total = 0;
        bool anyEscape = false;
        for (int i = 0; i < cnt; i = i + 1) {
            string s = parts[i];
            total = total + 1; // '/'
            if (s != null && s.Length > 0) {
                int sl = s.Length;
                total = total + sl;
                nint sp = (nint)s;
                if (NativeMemory.IndexOfAny(sp, sl, 126, 47) >= 0) {
                    anyEscape = true;
                    Span<byte> sb = new Span<byte>(sp, sl);
                    for (int k = 0; k < sl; k = k + 1) {
                        int c = sb[k] & 255;
                        if (c == 126 || c == 47) { total = total + 1; }
                    }
                }
            }
        }
        byte[] outb = new byte[total];
        nint op = (nint)outb;
        int o = 0;
        if (!anyEscape) {
            for (int i = 0; i < cnt; i = i + 1) {
                outb[o] = 47;
                o = o + 1;
                string s = parts[i];
                if (s != null && s.Length > 0) {
                    int sl = s.Length;
                    NativeMemory.Copy(op + (nint)o, (nint)s, sl);
                    o = o + sl;
                }
            }
            return NativeMemory.GetString(op, 0, total);
        }
        for (int i = 0; i < cnt; i = i + 1) {
            outb[o] = 47;
            o = o + 1;
            string s = parts[i];
            if (s == null || s.Length == 0) { continue; }
            int sl = s.Length;
            nint sp = (nint)s;
            if (NativeMemory.IndexOfAny(sp, sl, 126, 47) < 0) {
                NativeMemory.Copy(op + (nint)o, sp, sl);
                o = o + sl;
            } else {
                Span<byte> sb = new Span<byte>(sp, sl);
                for (int k = 0; k < sl; k = k + 1) {
                    int c = sb[k] & 255;
                    if (c == 126) {
                        outb[o] = 126; outb[o + 1] = 48; o = o + 2;
                    } else if (c == 47) {
                        outb[o] = 126; outb[o + 1] = 49; o = o + 2;
                    } else {
                        outb[o] = (byte)c; o = o + 1;
                    }
                }
            }
        }
        return NativeMemory.GetString(op, 0, total);
    }
}
