using System;
using System.Text;
using System.Collections.Generic;

namespace System.Json;

// 纯库级实现的工业级 JSON 门面类。
// 全面废黜编译器硬编码宏拦截，基于原生运行时反射 (Native Reflection) 与 JsonDoc 实现。
public class Json {

    // 泛型对象序列化为 JSON 文本
    public static string Serialize<T>(T obj) {
        if (obj == null) return "null";
        StringBuilder sb = new StringBuilder();
        sb.Append("{");
        TypeInfo ti = typeof(T);
        int fc = ti.FieldCount;
        bool first = true;
        for (int i = 0; i < fc; i = i + 1) {
            string fname = ti.GetFieldName(i);
            string ftype = ti.GetFieldType(i);
            if (!first) sb.Append(",");
            first = false;
            Json.WriteString(sb, fname);
            sb.Append(":");
            if (ftype == "string") {
                Json.WriteString(sb, obj.GetFieldString(fname));
            } else if (ftype == "int") {
                sb.Append(Convert.ToString(obj.GetFieldInt(fname)));
            } else if (ftype == "long") {
                sb.Append(Convert.ToString(obj.GetFieldLong(fname)));
            } else if (ftype == "double" || ftype == "float") {
                sb.Append(Convert.ToString(obj.GetFieldDouble(fname)));
            } else if (ftype == "bool") {
                sb.Append(obj.GetFieldBool(fname) ? "true" : "false");
            } else {
                object child = obj.GetFieldObject(fname);
                if (child == null) {
                    sb.Append("null");
                } else {
                    sb.Append("\"[object]\"");
                }
            }
        }
        sb.Append("}");
        return sb.ToString();
    }

    // 泛型 JSON 文本反序列化为对象
    public static T Deserialize<T>(string text) {
        TypeInfo ti = typeof(T);
        object inst = ti.CreateInstance();
        if (text == null || text.Length == 0 || text == "null") {
            return (T)inst;
        }
        JsonDoc doc = JsonDoc.Parse(text);
        int fc = ti.FieldCount;
        for (int i = 0; i < fc; i = i + 1) {
            string fname = ti.GetFieldName(i);
            string ftype = ti.GetFieldType(i);
            int slot = doc != null ? doc.Get(doc.root, fname) : -1;
            if (slot < 0) continue;
            if (ftype == "string") {
                inst.SetFieldString(fname, doc.StrAt(slot, ""));
            } else if (ftype == "int") {
                inst.SetFieldInt(fname, doc.IntAt(slot, 0));
            } else if (ftype == "long") {
                inst.SetFieldLong(fname, doc.LongAt(slot, 0));
            } else if (ftype == "double" || ftype == "float") {
                inst.SetFieldDouble(fname, doc.DoubleAt(slot, 0.0));
            } else if (ftype == "bool") {
                inst.SetFieldBool(fname, doc.KindAt(slot) == 4);
            }
        }
        return (T)inst;
    }

    private static void WriteString(StringBuilder sb, string s) {
        if (s == null) {
            sb.Append("null");
            return;
        }
        sb.Append("\"");
        for (int i = 0; i < s.Length; i = i + 1) {
            char c = s[i];
            if (c == '\"') sb.Append("\\\"");
            else if (c == '\\') sb.Append("\\\\");
            else if (c == '\n') sb.Append("\\n");
            else if (c == '\r') sb.Append("\\r");
            else if (c == '\t') sb.Append("\\t");
            else sb.Append(c);
        }
        sb.Append("\"");
    }
}
