using System;

namespace System.Json;

// JSON 值的深度比较。
//
// 数字按数值比较（1 与 1.0 相等——JSON Schema 的语义），其余按类型
// 逐层比较。对象按"键集合相同且每个值相等"判定（键顺序不算）。
public class JsonEqual {
    public static bool DeepEquals(JsonValue a, JsonValue b) {
        if (a == null) { return b == null; }
        if (b == null) { return false; }
        if (a.IsNumber() && b.IsNumber()) {
            return a.AsDouble(0.0) == b.AsDouble(0.0);
        }
        if (a.IsNull() || b.IsNull()) { return a.IsNull() && b.IsNull(); }
        if (a.IsBool() && b.IsBool()) { return a.AsBool(false) == b.AsBool(false); }
        if (a.IsString() && b.IsString()) { return a.AsString("") == b.AsString(""); }
        if (a.IsArray() && b.IsArray()) {
            int n = a.Count();
            if (n != b.Count()) { return false; }
            for (int i = 0; i < n; i = i + 1) {
                if (!JsonEqual.DeepEquals(a.At(i), b.At(i))) { return false; }
            }
            return true;
        }
        if (a.IsObject() && b.IsObject()) {
            int n = a.Count();
            if (n != b.Count()) { return false; }
            for (int i = 0; i < n; i = i + 1) {
                string key = a.KeyAt(i);
                JsonValue bv = b.Get(key);
                if (bv == null) { return false; }
                if (!JsonEqual.DeepEquals(a.ValAt(i), bv)) { return false; }
            }
            return true;
        }
        return false;
    }
}
