using System;
using System.Collections.Generic;

namespace System.Json;

// JSON Patch 失败时抛出（路径不存在、操作不支持、test 不通过）。
public class JsonPatchException : Exception {
    public JsonPatchException(string message) {
        Message = message;
    }
}

// JSON Patch（RFC 6902）应用器。
//
// 支持 add / remove / replace / move / copy / test 六种操作，路径用
// JSON Pointer（"/a/b/0"，"-" 表示数组末尾追加）。
//
// 语义取舍：
//   - 应用到**副本**上并返回新文档，原文档不动（RFC 6902 允许原地，
//     但返回值更不容易误用）；
//   - move 的 from 若是 path 的前缀，报错（RFC 要求这种移动无效）；
//   - 数组插入没有"插入"原语，只能重建数组（顺序保持）。
public class JsonPatch {
    // 应用补丁（返回新文档）。
    public static JsonValue Apply(JsonValue doc, JsonValue patch) {
        if (patch == null || !patch.IsArray()) {
            throw new JsonPatchException("JSON Patch must be an array of operations");
        }
        JsonValue work = (doc == null) ? JsonValue.NewObject() : doc.Clone();
        int n = patch.Count();
        for (int i = 0; i < n; i = i + 1) {
            JsonValue op = patch.At(i);
            if (op == null || !op.IsObject()) {
                throw new JsonPatchException("patch operation must be an object");
            }
            string name = op.Str("op", "");
            string path = op.Str("path", "");
            int op0 = name.Length > 0 ? (name[0] & 255) : 0;
            if (op0 == 97 && name == "add") {
                JsonValue v = op.Get("value");
                if (v == null) { throw new JsonPatchException("add operation requires 'value'"); }
                JsonPatch.Add(work, path, v);
            } else if (op0 == 114 && name == "remove") {
                JsonPatch.Remove(work, path);
            } else if (op0 == 114 && name == "replace") {
                JsonValue v = op.Get("value");
                if (v == null) { throw new JsonPatchException("replace operation requires 'value'"); }
                JsonPatch.Replace(work, path, v);
            } else if (op0 == 109 && name == "move") {
                JsonPatch.Move(work, op.Str("from", ""), path);
            } else if (op0 == 99 && name == "copy") {
                JsonPatch.Copy(work, op.Str("from", ""), path);
            } else if (op0 == 116 && name == "test") {
                JsonValue v = op.Get("value");
                if (!JsonEqual.DeepEquals(JsonPatch.Get(work, path), v)) {
                    throw new JsonPatchException("test failed at " + path);
                }
            } else {
                throw new JsonPatchException("unknown patch operation '" + name + "'");
            }
        }
        return work;
    }

    // 应用补丁（从 JSON 文本读）。
    public static JsonValue Apply(JsonValue doc, string patchJson) {
        return JsonPatch.Apply(doc, JsonValue.Parse(patchJson));
    }

    // 流式指针导航取值（零 List<string> 分配；数组段零字符串分配）。
    public static JsonValue Get(JsonValue doc, string pointer) {
        if (pointer == null || pointer.Length == 0) { return doc; }
        if ((pointer[0] & 255) != 47) {
            throw new ArgumentException("JSON Pointer must start with '/': " + pointer);
        }
        JsonValue cur = doc;
        int n = pointer.Length;
        nint pp = (nint)pointer;
        int i = 1;
        while (true) {
            if (cur == null) { return null; }
            int slash = i < n ? NativeMemory.Find(pp, i, 47, n - i) : -1;
            int end = slash < 0 ? n : slash;
            int segLen = end - i;
            if (cur.IsObject()) {
                string key = JsonPointer.UnescapeSlice(pp, i, segLen);
                cur = cur.Get(key);
            } else if (cur.IsArray()) {
                int idx = JsonPatch.IndexOfSlice(pointer, i, segLen);
                if (idx < 0 || idx >= cur.Count()) { return null; }
                cur = cur.At(idx);
            } else {
                return null;
            }
            if (slash < 0) { break; }
            i = slash + 1;
        }
        return cur;
    }

    // add：对象按键写入（存在则替换），数组按下标插入，"-" 追加到末尾。
    static void Add(JsonValue doc, string pointer, JsonValue value) {
        if (pointer.Length == 0) { throw new JsonPatchException("cannot add at the document root"); }
        JsonValue parent = null;
        int lastStart = 0;
        int lastLen = 0;
        if (!JsonPatch.ParentOfSlice(doc, pointer, out parent, out lastStart, out lastLen)) {
            throw new JsonPatchException("no such path: " + pointer);
        }
        if (parent.IsObject()) {
            string last = JsonPointer.UnescapeSlice((nint)pointer, lastStart, lastLen);
            parent.Set(last, value);
            return;
        }
        if (parent.IsArray()) {
            if (lastLen == 1 && (pointer[lastStart] & 255) == 45) { parent.Append(value); return; }
            int idx = JsonPatch.IndexOfSlice(pointer, lastStart, lastLen);
            if (idx < 0 || idx > parent.Count()) {
                throw new JsonPatchException("bad array index in path: " + pointer);
            }
            JsonPatch.InsertAt(parent, idx, value);
            return;
        }
        throw new JsonPatchException("cannot add to a scalar at: " + pointer);
    }

    // remove：删掉对象键或数组元素。
    static void Remove(JsonValue doc, string pointer) {
        JsonValue parent = null;
        int lastStart = 0;
        int lastLen = 0;
        if (!JsonPatch.ParentOfSlice(doc, pointer, out parent, out lastStart, out lastLen)) {
            throw new JsonPatchException("no such path: " + pointer);
        }
        if (parent.IsObject()) {
            string last = JsonPointer.UnescapeSlice((nint)pointer, lastStart, lastLen);
            if (!parent.Remove(last)) {
                throw new JsonPatchException("no such property: " + last);
            }
            return;
        }
        if (parent.IsArray()) {
            int idx = JsonPatch.IndexOfSlice(pointer, lastStart, lastLen);
            if (idx < 0 || idx >= parent.Count()) {
                throw new JsonPatchException("no such array index: " + JsonPointer.UnescapeSlice((nint)pointer, lastStart, lastLen));
            }
            parent.RemoveAt(idx);
            return;
        }
        throw new JsonPatchException("cannot remove from a scalar at: " + pointer);
    }

    // replace：目标必须存在。
    static void Replace(JsonValue doc, string pointer, JsonValue value) {
        JsonValue parent = null;
        int lastStart = 0;
        int lastLen = 0;
        if (!JsonPatch.ParentOfSlice(doc, pointer, out parent, out lastStart, out lastLen)) {
            throw new JsonPatchException("no such path: " + pointer);
        }
        if (parent.IsObject()) {
            string last = JsonPointer.UnescapeSlice((nint)pointer, lastStart, lastLen);
            if (!parent.Has(last)) { throw new JsonPatchException("no such property: " + last); }
            parent.Set(last, value);
            return;
        }
        if (parent.IsArray()) {
            int idx = JsonPatch.IndexOfSlice(pointer, lastStart, lastLen);
            if (idx < 0 || idx >= parent.Count()) {
                throw new JsonPatchException("no such array index: " + JsonPointer.UnescapeSlice((nint)pointer, lastStart, lastLen));
            }
            parent.SetAt(idx, value);
            return;
        }
        throw new JsonPatchException("cannot replace a scalar at: " + pointer);
    }

    // 零拼接前缀检查：判定 path 是否以 from + "/" 开头。
    private static bool StartsWithPrefixSlash(string path, string from) {
        int fl = from.Length;
        if (path.Length <= fl || (path[fl] & 255) != 47) { return false; }
        for (int i = 0; i < fl; i = i + 1) {
            if ((path[i] & 255) != (from[i] & 255)) { return false; }
        }
        return true;
    }

    // move：单次遍历 from 同时取出并删除，再写入 path（消除 Get + Remove 双重导航）。
    static void Move(JsonValue doc, string from, string path) {
        if (from == path) { return; }
        if (JsonPatch.StartsWithPrefixSlash(path, from)) {
            throw new JsonPatchException("cannot move a location into its own child: " + from);
        }
        JsonValue parent = null;
        int lastStart = 0;
        int lastLen = 0;
        if (!JsonPatch.ParentOfSlice(doc, from, out parent, out lastStart, out lastLen)) {
            throw new JsonPatchException("no such path: " + from);
        }
        JsonValue v = null;
        if (parent.IsObject()) {
            string last = JsonPointer.UnescapeSlice((nint)from, lastStart, lastLen);
            v = parent.Get(last);
            if (v == null) { throw new JsonPatchException("no such path: " + from); }
            parent.Remove(last);
        } else if (parent.IsArray()) {
            int idx = JsonPatch.IndexOfSlice(from, lastStart, lastLen);
            if (idx < 0 || idx >= parent.Count()) {
                throw new JsonPatchException("no such path: " + from);
            }
            v = parent.At(idx);
            parent.RemoveAt(idx);
        } else {
            throw new JsonPatchException("no such path: " + from);
        }
        JsonPatch.Add(doc, path, v);
    }

    // copy：把 from 的值复制一份加到 path。
    static void Copy(JsonValue doc, string from, string path) {
        JsonValue v = JsonPatch.Get(doc, from);
        if (v == null) { throw new JsonPatchException("no such path: " + from); }
        JsonPatch.Add(doc, path, v.Clone());
    }

    // 流式定位父节点与最后一段切片（零 List<string> 与数组末段零字符串分配）。
    static bool ParentOfSlice(JsonValue doc, string pointer, out JsonValue parent, out int lastStart, out int lastLen) {
        parent = null;
        lastStart = 0;
        lastLen = 0;
        if (pointer == null || pointer.Length == 0) { return false; }
        if ((pointer[0] & 255) != 47) {
            throw new ArgumentException("JSON Pointer must start with '/': " + pointer);
        }
        int n = pointer.Length;
        nint pp = (nint)pointer;
        JsonValue cur = doc;
        int i = 1;
        while (true) {
            int slash = i < n ? NativeMemory.Find(pp, i, 47, n - i) : -1;
            if (slash < 0) {
                if (cur == null) { return false; }
                lastStart = i;
                lastLen = n - i;
                parent = cur;
                return true;
            }
            if (cur == null) { return false; }
            int segLen = slash - i;
            if (cur.IsObject()) {
                string key = JsonPointer.UnescapeSlice(pp, i, segLen);
                cur = cur.Get(key);
            } else if (cur.IsArray()) {
                int idx = JsonPatch.IndexOfSlice(pointer, i, segLen);
                if (idx < 0 || idx >= cur.Count()) { return false; }
                cur = cur.At(idx);
            } else {
                return false;
            }
            i = slash + 1;
        }
    }

    // 数组插入（JsonValue 没有 insert 原语，仅搬移 index 之后元素并从尾部弹出）。
    static void InsertAt(JsonValue arr, int index, JsonValue value) {
        int n = arr.Count();
        if (index >= n) { arr.Append(value); return; }
        int start = index < 0 ? 0 : index;
        List<JsonValue> tail = new List<JsonValue>();
        for (int i = start; i < n; i = i + 1) { tail.Add(arr.At(i)); }
        for (int i = n - 1; i >= start; i = i - 1) { arr.RemoveAt(i); }
        arr.Append(value);
        for (int i = 0; i < tail.Count; i = i + 1) { arr.Append(tail[i]); }
    }

    // RFC 6901 数组下标切片直读（零字符串分配）。
    static int IndexOfSlice(string s, int start, int len) {
        if (s == null || len <= 0) { return -1; }
        if (len > 1 && (s[start] & 255) == 48) { return -1; }
        long v = 0L;
        for (int i = 0; i < len; i = i + 1) {
            int d = (s[start + i] & 255) - 48;
            if (d < 0 || d > 9) { return -1; }
            v = v * 10L + (long)d;
            if (v > 2147483647L) { return -1; }
        }
        return (int)v;
    }

    // RFC 6901 数组下标：仅允许 "0" 或不带前导零的非负十进制整数；非法返回 -1。
    static int IndexOf(string s) {
        if (s == null || s.Length == 0) { return -1; }
        return JsonPatch.IndexOfSlice(s, 0, s.Length);
    }
}
