using System;
using System.Text;

namespace System.Json;

// 驱动 JsonValue.Parse 的源字符串游标（Zan 没有
// ref/out 参数，所以位置保存在该对象上）。
public class JsonReader {
    // 源字符串。
    public string s;
    // 源指针（直接借用字符串底层内存地址，彻底杜绝 ToBytes 堆分配与中间拷贝）。
    public nint ptr;
    public byte[] buf;
    // 当前字节偏移。
    public int pos;
    // 源长度。
    public int len;
    // 递归解析/校验的最大嵌套深度。深层嵌套文档会耗尽
    // 调用栈（约 20-40 万层时解析器崩溃），必须显式限制。
    public static int MaxDepth = 512;

    // 严格模式（JsonValue.Parse）：边建树边校验，首个错误位置
    // 记在 errPos 上；宽松模式（ParseLenient）行为保持不变。
    public bool strict;
    // 首个语法错误的字节位置；无错误为 -1。
    public int errPos;
    private StringBuilder escapedString;
    private string[] keyCache;

    public JsonReader() {
        this.s = "";
        this.ptr = (nint)0;
        this.buf = null;
        this.pos = 0;
        this.len = 0;
        this.strict = false;
        this.errPos = -1;
        this.keyCache = null;
    }

    // 创建宽松模式游标。
    public static JsonReader Of(string src) {
        JsonReader r = new JsonReader();
        r.s = src;
        r.ptr = (nint)src;
        r.buf = null;
        r.pos = 0;
        r.len = src.Length;
        r.strict = false;
        r.errPos = -1;
        return r;
    }

    // 创建严格模式游标（Parse 用）。
    public static JsonReader OfStrict(string src) {
        JsonReader r = JsonReader.Of(src);
        r.strict = true;
        return r;
    }

    // 记录首个错误位置（后来的错误不覆盖它）。
    public void Fail() {
        if (errPos < 0) { errPos = pos; }
    }

    // 是否已记录过错误。
    public bool Failed() { return errPos >= 0; }

    // 游标处的字节，输入结束时为 -1。
    public int CurB() {
        int p = this.pos;
        if (p >= this.len) { return -1; }
        if (this.ptr != (nint)0) {
            Span<byte> sp = new Span<byte>(this.ptr, this.len);
            return sp[p] & 255;
        }
        return s[p] & 255;
    }

    // 跳过空白（空格/制表/换行/回车）。
    // 针对 JSON 中大部分非空白字符首字节快速直接跳出；
    // 较长的空白游程走向量扫描。
    public void SkipWs() {
        int p = this.pos;
        int n = this.len;
        if (p >= n) { return; }
        if (this.ptr != (nint)0) {
            Span<byte> sp = new Span<byte>(this.ptr, n);
            int c0 = sp[p];
            if (c0 > 32 || (c0 != 32 && c0 != 9 && c0 != 10 && c0 != 13)) {
                return;
            }
            p = p + 1;
            if (p < n) {
                int c1 = sp[p];
                if (c1 > 32 || (c1 != 32 && c1 != 9 && c1 != 10 && c1 != 13)) {
                    this.pos = p;
                    return;
                }
            }
            this.pos = JsonScan.SkipWhitespace(this.ptr, p, n);
            return;
        }
        int c0 = s[p] & 255;
        if (c0 != 32 && c0 != 9 && c0 != 10 && c0 != 13) {
            return;
        }
        while (p < n) {
            int c = s[p] & 255;
            if (c == 32 || c == 9 || c == 10 || c == 13) {
                p = p + 1;
            } else {
                break;
            }
        }
        this.pos = p;
    }

    // 从游标读一个任意 JSON 值（顶层入口）。
    public JsonValue ReadValue() {
        return ReadValueAt(0);
    }

    // ReadValue 的递归实现；`depth` 用于 MaxDepth 保护，超限时
    // 严格模式记错误，宽松模式返回 null 占位。
    public JsonValue ReadValueAt(int depth) {
        if (depth > JsonReader.MaxDepth) {
            if (strict) { Fail(); }
            return JsonValue.NewNull();
        }
        int n = this.len;
        if (this.ptr != (nint)0) {
            Span<byte> sp = new Span<byte>(this.ptr, n);
            int p = this.pos;
            if (p < n && sp[p] <= 32) {
                SkipWs();
                p = this.pos;
            }
            if (p >= n) { return ReadNumber(); }
            int c = sp[p];
            if (c == 123) { return ReadObjectAt(depth); }  // '{'
            if (c == 91) { return ReadArrayAt(depth); }  // '['
            if (c == 34) { return JsonValue.NewStr(ReadString()); }
            if (c == 116) {  // 't'
                if (strict) {
                    if (p + 4 <= n && sp[p + 1] == 114 && sp[p + 2] == 117 && sp[p + 3] == 101) {
                        this.pos = p + 4;
                        return JsonValue.NewBool(true);
                    }
                    Fail();
                    return JsonValue.NewNull();
                }
                this.pos = p + 4;
                return JsonValue.NewBool(true);
            }
            if (c == 102) {  // 'f'
                if (strict) {
                    if (p + 5 <= n && sp[p + 1] == 97 && sp[p + 2] == 108 && sp[p + 3] == 115 && sp[p + 4] == 101) {
                        this.pos = p + 5;
                        return JsonValue.NewBool(false);
                    }
                    Fail();
                    return JsonValue.NewNull();
                }
                this.pos = p + 5;
                return JsonValue.NewBool(false);
            }
            if (c == 110) {  // 'n'
                if (strict) {
                    if (p + 4 <= n && sp[p + 1] == 117 && sp[p + 2] == 108 && sp[p + 3] == 108) {
                        this.pos = p + 4;
                    } else {
                        Fail();
                    }
                } else {
                    this.pos = p + 4;
                }
                return JsonValue.NewNull();
            }
            return ReadNumber();
        }
        SkipWs();
        int p0 = this.pos;
        if (p0 >= n) { return ReadNumber(); }
        int c0 = s[p0] & 255;
        if (c0 == 123) { return ReadObjectAt(depth); }  // '{'
        if (c0 == 91) { return ReadArrayAt(depth); }  // '['
        if (c0 == 34) { return JsonValue.NewStr(ReadString()); }
        if (c0 == 116 || c0 == 102) {  // 't' / 'f'
            if (strict) {
                string lit = "false";
                if (c0 == 116) { lit = "true"; }
                if (!ValidLiteral(lit)) {
                    Fail();
                    return JsonValue.NewNull();
                }
                return JsonValue.NewBool(c0 == 116);
            }
            return ReadBool();
        }
        if (c0 == 110) {
            if (strict) {
                if (!ValidLiteral("null")) { Fail(); }
            } else {
                pos = pos + 4;
            }
            return JsonValue.NewNull();
        }
        return ReadNumber();
    }

    // 读对象键名：内联 Span 短键扫描 + 本地 128 槽去重缓存，免 JsonScan 调用与重复 Substring 分配。
    private string ReadKey() {
        if (this.ptr == (nint)0) { return ReadString(); }
        int p = this.pos;
        int n = this.len;
        Span<byte> sp = new Span<byte>(this.ptr, n);
        if (p >= n || sp[p] != 34) {
            if (strict) { Fail(); }
            return "";
        }
        int start = p + 1;
        int scan = start;
        int lim = start + 48;
        if (lim > n) { lim = n; }
        int foundEnd = -1;
        while (scan < lim) {
            int b = sp[scan];
            if (b == 34) { foundEnd = scan; break; }
            if (b == 92 || b < 32) { return ReadString(); }
            scan = scan + 1;
        }
        if (foundEnd < 0) {
            long longEnd = JsonScan.StringEnd(this.ptr, start, n);
            if (longEnd < 0L || longEnd >= (long)n) { return ReadString(); }
            int le = (int)longEnd;
            this.pos = le + 1;
            return s.Substring(start, le - start);
        }
        int klen = foundEnd - start;
        this.pos = foundEnd + 1;
        if (klen == 0) { return ""; }
        string[] pool = this.keyCache;
        if (pool == null) {
            pool = new string[128];
            this.keyCache = pool;
        }
        int first = sp[start];
        int last = sp[foundEnd - 1];
        int h = (klen * 33 + first * 17 + last) & 127;
        string cached = pool[h];
        if (cached != null && cached.Length == klen) {
            Span<byte> cb = new Span<byte>((nint)cached, klen);
            bool eq = true;
            for (int i = 0; i < klen; i = i + 1) {
                if (sp[start + i] != cb[i]) { eq = false; break; }
            }
            if (eq) { return cached; }
        }
        string fresh = s.Substring(start, klen);
        pool[h] = fresh;
        return fresh;
    }

    // 游标处为 '{' 时读对象；strict 下逐 token 校验，
    // 错误语义同 ReadValueAt。
    public JsonValue ReadObjectAt(int depth) {
        JsonValue obj = JsonValue.NewObject();
        pos = pos + 1;  // 消费 '{'
        int n = this.len;
        if (this.ptr != (nint)0) {
            Span<byte> sp = new Span<byte>(this.ptr, n);
            if (pos < n && sp[pos] <= 32) { SkipWs(); }
            if (pos < n && sp[pos] == 125) { pos = pos + 1; return obj; }  // '}'
            while (pos < n) {
                if (sp[pos] <= 32) { SkipWs(); }
                if (strict && (pos >= n || sp[pos] != 34)) { Fail(); return obj; }
                string key = ReadKey();
                if (pos < n && sp[pos] <= 32) { SkipWs(); }
                if (pos < n && sp[pos] == 58) { pos = pos + 1; }  // ':'
                else if (strict) { Fail(); return obj; }
                JsonValue v = ReadValueAt(depth + 1);
                if (strict && Failed()) { return obj; }
                // The parser owns both nodes. The fresh child cannot reference its parent.
                obj.keys.Add(key);
                obj.vals.Add(v);
                if (pos < n && sp[pos] <= 32) { SkipWs(); }
                if (pos < n) {
                    int c = sp[pos];
                    if (c == 44) { pos = pos + 1; }  // ','
                    else if (c == 125) { pos = pos + 1; return obj; }  // '}'
                    else {
                        if (strict) { Fail(); }
                        return obj;
                    }
                } else {
                    if (strict) { Fail(); }
                    return obj;
                }
            }
            if (strict) { Fail(); }  // 未闭合
            return obj;
        }
        SkipWs();
        if (CurB() == 125) { pos = pos + 1; return obj; }  // '}'
        while (pos < n) {
            SkipWs();
            if (strict && CurB() != 34) { Fail(); return obj; }
            string key = ReadString();
            SkipWs();
            if (CurB() == 58) { pos = pos + 1; }  // ':'
            else if (strict) { Fail(); return obj; }
            JsonValue v = ReadValueAt(depth + 1);
            if (strict && Failed()) { return obj; }
            // The parser owns both nodes. The fresh child cannot reference its parent.
            obj.keys.Add(key);
            obj.vals.Add(v);
            SkipWs();
            int c = CurB();
            if (c == 44) { pos = pos + 1; }  // ','
            else if (c == 125) { pos = pos + 1; return obj; }  // '}'
            else {
                if (strict) { Fail(); }
                return obj;
            }
        }
        if (strict) { Fail(); }  // 未闭合
        return obj;
    }

    // 游标处为 '[' 时读数组；错误语义同 ReadObjectAt。
    public JsonValue ReadArrayAt(int depth) {
        JsonValue arr = JsonValue.NewArray();
        pos = pos + 1;  // 消费 '['
        int n = this.len;
        if (this.ptr != (nint)0) {
            Span<byte> sp = new Span<byte>(this.ptr, n);
            if (pos < n && sp[pos] <= 32) { SkipWs(); }
            if (pos < n && sp[pos] == 93) { pos = pos + 1; return arr; }  // ']'
            while (pos < n) {
                JsonValue v = ReadValueAt(depth + 1);
                if (strict && Failed()) { return arr; }
                // Only parser-created values enter this list.
                arr.items.Add(v);
                if (pos < n && sp[pos] <= 32) { SkipWs(); }
                if (pos < n) {
                    int c = sp[pos];
                    if (c == 44) { pos = pos + 1; }  // ','
                    else if (c == 93) { pos = pos + 1; return arr; }  // ']'
                    else {
                        if (strict) { Fail(); }
                        return arr;
                    }
                } else {
                    if (strict) { Fail(); }
                    return arr;
                }
            }
            if (strict) { Fail(); }  // 未闭合
            return arr;
        }
        SkipWs();
        if (CurB() == 93) { pos = pos + 1; return arr; }  // ']'
        while (pos < n) {
            JsonValue v = ReadValueAt(depth + 1);
            if (strict && Failed()) { return arr; }
            // Only parser-created values enter this list.
            arr.items.Add(v);
            SkipWs();
            int c = CurB();
            if (c == 44) { pos = pos + 1; }  // ','
            else if (c == 93) { pos = pos + 1; return arr; }  // ']'
            else {
                if (strict) { Fail(); }
                return arr;
            }
        }
        if (strict) { Fail(); }  // 未闭合
        return arr;
    }

    // 从起始引号读取带引号的字符串；解码常见
    // 转义。结束后 pos 位于闭合引号之后。无转义的字符串
    // （最常见的情况）先 memchr 定位闭合引号/反斜杠，
    // 再单次 Substring；含转义的字符串则回退到 StringBuilder，
    // 批量复制转义之间的普通片段。
    public string ReadString() {
        if (CurB() != 34) {
            if (strict) { Fail(); }
            return "";
        }
        pos = pos + 1;  // 消费起始引号
        int start = pos;
        if (this.ptr != (nint)0) {
            int scan = JsonScan.StringEnd(this.ptr, pos, len);
            if (scan >= 0L && scan < (long)len) {
                string plain = s.Substring(start, (int)scan - start);
                pos = (int)scan + 1;
                return plain;
            } else if (scan < 0L) {
                pos = (int)(-scan - 1L);
            } else {
                pos = len;
            }
        } else {
            while (pos < len) {
                int c = s[pos] & 255;
                if (c == 34) {
                    string plain = s.Substring(start, pos - start);
                    pos = pos + 1;
                    return plain;
                }
                if (c == 92) {
                    break;
                }
                pos = pos + 1;
            }
        }
        if (this.escapedString == null) { this.escapedString = new StringBuilder(); }
        StringBuilder sb = this.escapedString;
        sb.Clear();
        if (pos > start) {
            if (this.ptr != (nint)0) { sb.Append(new StringView(this.ptr + (nint)start, pos - start)); }
            else { sb.Append(s.Substring(start, pos - start)); }
        }
        while (pos < len) {
            int c = s[pos] & 255;
            if (c == 34) { pos = pos + 1; return this.FinishEscapedString(sb); }
            if (c == 92 && pos + 1 < len) {
                int n = s[pos + 1] & 255;
                if (n == 110) { sb.Append("\n"); }
                else if (n == 116) { sb.Append("\t"); }
                else if (n == 114) { sb.Append("\r"); }
                else if (n == 34) { sb.Append("\""); }
                else if (n == 92) { sb.Append("\\"); }
                else if (n == 47) { sb.Append("/"); }
                else if (n == 98) { sb.Append(Encoding.CharFromCode(8)); }
                else if (n == 102) { sb.Append(Encoding.CharFromCode(12)); }
                else if (n == 117) {
                    // \uXXXX：以 UTF-8 输出（含代理对）。很多客户端默认
                    // 把所有非 ASCII 字符发成 \uXXXX（Python json.dumps 的
                    // ensure_ascii=True 就是这样），不解码就会把
                    // "\u4e2d\u6587" 变成字面量 "u4e2du6587"。
                    pos = pos + 2;
                    int cp = JsonScan.Hex4(s, pos, len);
                    if (cp < 0) {
                        // 错误位置按转义起点报（游标已越过 "\u"）。
                        if (strict) {
                            pos = pos - 2;
                            Fail();
                            return this.FinishEscapedString(sb);
                        }
                        sb.Append("u");
                        continue;
                    }
                    pos = pos + 4;
                    if (cp >= 55296 && cp <= 56319 && pos + 5 < len
                        && (s[pos] & 255) == 92 && (s[pos + 1] & 255) == 117) {
                        int lo = JsonScan.Hex4(s, pos + 2, len);
                        if (lo >= 56320 && lo <= 57343) {
                            cp = 65536 + ((cp - 55296) << 10) + (lo - 56320);
                            pos = pos + 6;
                        }
                    }
                    if (cp == 0) {
                        // \u0000 接受并保留（与 JsonTape 的行为统一；
                        // Zan 字符串带显式长度，装得下内嵌 NUL。BSON
                        // 语料先例：管理串可含 NUL）。写出的内容经
                        // Encoding.JsonEscape 转成 \u0000，往返无损。
                        sb.Append(Encoding.Utf8FromCodePoint(0));
                        continue;
                    }
                    sb.Append(Encoding.Utf8FromCodePoint(cp));
                    continue;
                }
                else {
                    // \" \\ \/ \b \f \n \r \t \u 之外的转义在 JSON 里非法。
                    if (strict) { Fail(); return this.FinishEscapedString(sb); }
                    if (this.ptr != (nint)0) { sb.Append(new StringView(this.ptr + (nint)(pos + 1), 1)); }
                    else { sb.Append(s.Substring(pos + 1, 1)); }
                }
                pos = pos + 2;
            } else {
                if ((s[pos] & 255) == 92) {
                    // 尾部孤反斜杠(后面没有字节可构成转义):上面的
                    // "c == 92 && pos + 1 < len" 不命中才会到这里。
                    // 若直接走下面的 FindNotAnyOf,它从反斜杠处起扫
                    // 立即返回 0,pos 原地不动 —— 解析器死循环。
                    if (strict) { Fail(); return this.FinishEscapedString(sb); }
                    sb.Append("\\");
                    pos = pos + 1;
                    continue;
                }
                int stop2 = len;
                if (this.ptr != (nint)0) {
                    int scan2 = JsonScan.StringEnd(this.ptr, pos, len);
                    if (scan2 >= 0L && scan2 < (long)len) {
                        stop2 = (int)scan2;
                    } else if (scan2 < 0L) {
                        stop2 = (int)(-scan2 - 1L);
                    }
                    sb.Append(new StringView(this.ptr + (nint)pos, stop2 - pos));
                } else {
                    stop2 = pos;
                    while (stop2 < len) {
                        int sc = s[stop2] & 255;
                        if (sc == 34 || sc == 92) { break; }
                        stop2 = stop2 + 1;
                    }
                    sb.Append(s.Substring(pos, stop2 - pos));
                }
                pos = stop2;
            }
        }
        if (strict) { Fail(); }  // 未闭合
        return this.FinishEscapedString(sb);
    }

    private string FinishEscapedString(StringBuilder builder) {
        string decoded = builder.ToString();
        if (decoded.Length > JsonScan.MaxRetainedEscapeBytes) { this.escapedString = null; }
        return decoded;
    }

    // 从 `at` 开始的 4 位十六进制值；不足 4 位或含非十六进制
    // 字符时返回 -1。
    public static int Hex4(string src, int at, int limit) {
        return JsonScan.Hex4(src, at, limit);
    }

    // 读取字面量 true/false（宽松模式）并构造布尔值。
    public JsonValue ReadBool() {
        if (CurB() == 116) { pos = pos + 4; return JsonValue.NewBool(true); }
        pos = pos + 5;  // "false"
        return JsonValue.NewBool(false);
    }

    // 读数字 token：数字游程短（中位 2-4 字节），strspn 的调用开销
    // 反而更贵，用字节循环吃 token，然后就地解析——纯整数存 numI，
    // 含 . / e 的存 numD。不再保留字面量字符串（AsString/ToJson
    // 的输出文本按需生成），每 token 少一次分配、读取侧免二次解析。
    public JsonValue ReadNumber() {
        int start = pos;
        int n = this.len;
        if (this.ptr != (nint)0 && start < n) {
            Span<byte> sp = new Span<byte>(this.ptr, n);
            int p = start;
            bool neg = false;
            if (sp[p] == 45) {
                neg = true;
                p = p + 1;
            }
            int dstart = p;
            long acc = 0L;
            while (p < n) {
                int d = (sp[p] & 255) - 48;
                if (d < 0 || d > 9) { break; }
                acc = acc * 10L + (long)d;
                p = p + 1;
            }
            int dcnt = p - dstart;
            if (dcnt > 0 && dcnt <= 18) {
                bool isSimpleInt = true;
                if (p < n) {
                    int nextC = sp[p];
                    if (nextC == 46 || nextC == 101 || nextC == 69 || nextC == 45 || nextC == 43) {
                        isSimpleInt = false;
                    }
                }
                if (isSimpleInt) {
                    this.pos = p;
                    if (neg) { acc = 0L - acc; }
                    return JsonValue.NewInt(acc);
                }
            }
            while (p < n) {
                int c = sp[p];
                if ((c >= 48 && c <= 57) || c == 45 || c == 43 || c == 46
                    || c == 101 || c == 69) {
                    p = p + 1;
                } else {
                    break;
                }
            }
            this.pos = p;
            if (p == start) {
                if (strict) { Fail(); return JsonValue.NewNull(); }
                return JsonValue.NewInt(0);
            }
            if (strict && !ValidNumberAt(start, p)) {
                Fail();
                return JsonValue.NewNull();
            }
            return JsonValue.ParseNumberToken(s, start, p);
        }
        while (pos < n) {
            int c = s[pos] & 255;
            if ((c >= 48 && c <= 57) || c == 45 || c == 43 || c == 46
                || c == 101 || c == 69) {  // digits - + . e E
                pos = pos + 1;
            } else {
                break;
            }
        }
        if (pos == start) {
            // 数字 token 前缀为空：strict 下报错，宽松下占 0。
            if (strict) { Fail(); return JsonValue.NewNull(); }
            return JsonValue.NewInt(0);
        }
        if (strict && !ValidNumberAt(start, pos)) {
            Fail();
            return JsonValue.NewNull();
        }
        return JsonValue.ParseNumberToken(s, start, pos);
    }

    // ---- 语法校验（严格模式解析时就地调用） -------------------------

    // 校验游标处是字面量 `lit`（"true"/"false"/"null"）并推进；
    // 不匹配时不推进返回 false。
    public bool ValidLiteral(string lit) {
        int n = lit.Length;
        int p = this.pos;
        if (p + n > this.len) { return false; }
        if (this.ptr != (nint)0 && n > 0) {
            Span<byte> sp = new Span<byte>(this.ptr, this.len);
            Span<byte> lb = new Span<byte>((nint)lit, n);
            for (int i = 0; i < n; i = i + 1) {
                if (sp[p + i] != lb[i]) { return false; }
            }
            this.pos = p + n;
            return true;
        }
        for (int i = 0; i < n; i = i + 1) {
            if ((s[p + i] & 255) != (lit[i] & 255)) { return false; }
        }
        this.pos = p + n;
        return true;
    }

    // 校验 [from, to) 是 JSON 数字语法（可选负号、整数、
    // 可选小数、可选指数）；语法不符返回 false（不推进——
    // 游标已由 ReadNumber 的字节循环吃满 token 游程）。
    public bool ValidNumberAt(int from, int to) {
        int i = from;
        if (this.ptr != (nint)0 && to <= this.len) {
            Span<byte> sp = new Span<byte>(this.ptr, this.len);
            if (i < to && sp[i] == 45) { i = i + 1; }
            if (i >= to) { return false; }
            int d = (sp[i] & 255) - 48;
            if (d < 0 || d > 9) { return false; }
            while (i < to) {
                int c = (sp[i] & 255) - 48;
                if (c < 0 || c > 9) { break; }
                i = i + 1;
            }
            if (i < to && sp[i] == 46) {
                i = i + 1;
                if (i >= to) { return false; }
                int d2 = (sp[i] & 255) - 48;
                if (d2 < 0 || d2 > 9) { return false; }
                while (i < to) {
                    int c2 = (sp[i] & 255) - 48;
                    if (c2 < 0 || c2 > 9) { break; }
                    i = i + 1;
                }
            }
            if (i < to && (sp[i] == 101 || sp[i] == 69)) {
                i = i + 1;
                if (i < to && (sp[i] == 43 || sp[i] == 45)) { i = i + 1; }
                if (i >= to) { return false; }
                int d3 = (sp[i] & 255) - 48;
                if (d3 < 0 || d3 > 9) { return false; }
                while (i < to) {
                    int c3 = (sp[i] & 255) - 48;
                    if (c3 < 0 || c3 > 9) { break; }
                    i = i + 1;
                }
            }
            return i == to;
        }
        if (i < to && (s[i] & 255) == 45) { i = i + 1; }
        if (i >= to) { return false; }
        int d = (s[i] & 255) - 48;
        if (d < 0 || d > 9) { return false; }
        while (i < to) {
            int c = (s[i] & 255) - 48;
            if (c < 0 || c > 9) { break; }
            i = i + 1;
        }
        if (i < to && (s[i] & 255) == 46) {
            i = i + 1;
            if (i >= to) { return false; }
            int d2 = (s[i] & 255) - 48;
            if (d2 < 0 || d2 > 9) { return false; }
            while (i < to) {
                int c2 = (s[i] & 255) - 48;
                if (c2 < 0 || c2 > 9) { break; }
                i = i + 1;
            }
        }
        if (i < to && ((s[i] & 255) == 101 || (s[i] & 255) == 69)) {
            i = i + 1;
            if (i < to && ((s[i] & 255) == 43 || (s[i] & 255) == 45)) { i = i + 1; }
            if (i >= to) { return false; }
            int d3 = (s[i] & 255) - 48;
            if (d3 < 0 || d3 > 9) { return false; }
            while (i < to) {
                int c3 = (s[i] & 255) - 48;
                if (c3 < 0 || c3 > 9) { break; }
                i = i + 1;
            }
        }
        return i == to;
    }
}
