using System;
using System.Collections.Generic;

namespace System.Json;

// JSONPath 的一段。
public class JsonPathSegment {
    // 段类型：1 子节点名、2 通配、3 下标、4 递归下降、5 过滤、6 切片。
    public const int Child = 1;
    public const int Wildcard = 2;
    public const int Index = 3;
    public const int Recurse = 4;
    public const int Filter = 5;
    public const int Slice = 6;

    public int kind;
    // 子节点名 / 递归下降的目标名（"*" 表示全部）。
    public string name;
    // 下标。
    public int index;
    // 切片：起、止、步长（步长 0 视为 1）。
    public int from;
    public int to;
    public int step;
    // 过滤表达式原文。
    public string filter;
    // 预解析过滤计划（消除对每个候选元素的重复切串与字面量解析）。
    internal bool filterCompiled;
    internal bool filterValid;
    internal List<string> filterKeys;
    internal string filterOp;
    internal JsonValue filterRhs;

    public JsonPathSegment() {
        this.kind = 0;
        this.name = "";
        this.index = 0;
        this.from = 0;
        this.to = 0;
        this.step = 1;
        this.filter = "";
        this.filterCompiled = false;
        this.filterValid = false;
        this.filterKeys = null;
        this.filterOp = "";
        this.filterRhs = null;
    }
}

// JSONPath 查询。
//
// 支持：$ 根、.name 与 ['name'] 子节点、[*] 通配、[0] / [-1] 下标、
// [start:end] 切片、..name 与 ..* 递归下降、[?(条件)] 过滤、
// 逗号并接多段路径。条件支持 @.field 存在性，以及 == != > >= < <=
// （数字与字符串）。不支持：过滤里的函数调用、脚本表达式、多层
// 括号嵌套过滤。
//
// 路径写错时抛 ArgumentException（不静默返回空表）。
public class JsonPath {
    public JsonPath() {
    }

    // 查询（按文档顺序返回命中的值）。
    //
    // 路径可以是用逗号并接的多条选择器（"$.a, $.b"），结果按路径顺序
    // 拼接，不去重。
    public static List<JsonValue> Query(JsonValue root, string path) {
        List<JsonValue> out2 = new List<JsonValue>();
        if (path == null || path.Length == 0) { return out2; }
        int n = path.Length;
        nint pp = (nint)path;
        // 快路径：无逗号时零分组切分，直接流式解析求值。
        if (NativeMemory.Find(pp, 0, 44, n) < 0) {
            JsonPath.EvalSelector(root, path, pp, 0, n, out2);
            return out2;
        }
        int depth = 0;
        int start = 0;
        for (int i = 0; i < n; i = i + 1) {
            int c = path[i] & 255;
            if (c == 91 || c == 40) { depth = depth + 1; continue; }
            if (c == 93 || c == 41) { depth = depth - 1; continue; }
            if (c == 39 || c == 34) {
                i = i + 1;
                while (i < n && (path[i] & 255) != c) { i = i + 1; }
                continue;
            }
            if (c == 44 && depth == 0) {
                JsonPath.EvalSelector(root, path, pp, start, i, out2);
                start = i + 1;
            }
        }
        JsonPath.EvalSelector(root, path, pp, start, n, out2);
        return out2;
    }

    // 路径是否命中（至少一个结果）。
    public static bool Exists(JsonValue root, string path) {
        if (path == null || path.Length == 0) { return false; }
        int n = path.Length;
        nint pp = (nint)path;
        if (NativeMemory.Find(pp, 0, 44, n) < 0) {
            return JsonPath.EvalFirstSingle(root, path, pp, 0, n) != null;
        }
        return JsonPath.Query(root, path).Count > 0;
    }

    // 取第一个命中值（没有返回 dflt）。
    public static JsonValue First(JsonValue root, string path, JsonValue dflt) {
        if (path == null || path.Length == 0) { return dflt; }
        int n = path.Length;
        nint pp = (nint)path;
        if (NativeMemory.Find(pp, 0, 44, n) < 0) {
            JsonValue v = JsonPath.EvalFirstSingle(root, path, pp, 0, n);
            return v != null ? v : dflt;
        }
        List<JsonValue> hits = JsonPath.Query(root, path);
        if (hits.Count == 0) { return dflt; }
        return hits[0];
    }

    static bool IsWs(int c) {
        return c == 32 || c == 9 || c == 10 || c == 13 || c == 11 || c == 12;
    }

    static int SkipWs(string src, int pos, int end) {
        while (pos < end) {
            int c = src[pos] & 255;
            if (c != 32 && c != 9) { break; }
            pos = pos + 1;
        }
        return pos;
    }

    static int SkipTrimLeft(string src, int pos, int end) {
        while (pos < end && JsonPath.IsWs(src[pos] & 255)) { pos = pos + 1; }
        return pos;
    }

    static int SkipTrimRight(string src, int start, int end) {
        while (end > start && JsonPath.IsWs(src[end - 1] & 255)) { end = end - 1; }
        return end;
    }

    // 窥视剩余文本是否恰好只剩一段 `.name`（非 `..`、非 `.*`），用于融合扇出末段免中间 List 分配。
    static bool TryPeekFinalChild(string src, int pos, int end, out string keyOut) {
        keyOut = null;
        if (pos >= end || (src[pos] & 255) != 46) { return false; }
        int p = pos + 1;
        if (p >= end || (src[p] & 255) == 46) { return false; }
        int ks = p;
        while (p < end) {
            int cc = src[p] & 255;
            if (cc == 46 || cc == 91 || cc == 93 || cc == 32 || cc == 9) { break; }
            p = p + 1;
        }
        int klen = p - ks;
        if (klen == 0 || (klen == 1 && (src[ks] & 255) == 42)) { return false; }
        if (JsonPath.SkipWs(src, p, end) < end) { return false; }
        keyOut = src.Substring(ks, klen);
        return true;
    }

    // 单选择器首命中快路径：沿标量链零 List 分配，末段过滤/通配/切片直接短路返回首命中。
    static JsonValue EvalFirstSingle(JsonValue root, string src, nint pp, int start, int end) {
        int s = JsonPath.SkipTrimLeft(src, start, end);
        int e = JsonPath.SkipTrimRight(src, s, end);
        if (s >= e) { return null; }
        int pos = s;
        if ((src[pos] & 255) == 36) { pos = pos + 1; }
        JsonValue cur = root;
        while (true) {
            pos = JsonPath.SkipWs(src, pos, e);
            if (pos >= e) { return cur; }
            int c = src[pos] & 255;
            if (c == 46) {
                pos = pos + 1;
                if (pos < e && (src[pos] & 255) == 46) {
                    List<JsonValue> tmp = new List<JsonValue>();
                    JsonPath.EvalSelector(root, src, pp, start, end, tmp);
                    return tmp.Count > 0 ? tmp[0] : null;
                }
                int ns = pos;
                while (pos < e) {
                    int cc = src[pos] & 255;
                    if (cc == 46 || cc == 91 || cc == 93 || cc == 32 || cc == 9) { break; }
                    pos = pos + 1;
                }
                int nlen = pos - ns;
                if (nlen == 0) {
                    throw new ArgumentException("invalid JSONPath at " + Convert.ToString(pos - s));
                }
                if (nlen == 1 && (src[ns] & 255) == 42) {
                    int afterW = JsonPath.SkipWs(src, pos, e);
                    if (afterW >= e) {
                        if (cur == null) { return null; }
                        if (cur.IsArray()) { return cur.Count() > 0 ? cur.At(0) : null; }
                        if (cur.IsObject()) { return cur.Count() > 0 ? cur.ValAt(0) : null; }
                        return null;
                    }
                    List<JsonValue> tmp = new List<JsonValue>();
                    JsonPath.EvalSelector(root, src, pp, start, end, tmp);
                    return tmp.Count > 0 ? tmp[0] : null;
                }
                if (cur != null) {
                    if (cur.IsObject()) {
                        cur = cur.Get(src.Substring(ns, nlen));
                    } else {
                        cur = null;
                    }
                }
                continue;
            }
            if (c == 91) {
                int bpos = JsonPath.SkipWs(src, pos + 1, e);
                if (bpos >= e) {
                    throw new ArgumentException("unterminated JSONPath bracket");
                }
                int bc = src[bpos] & 255;
                if (bc == 42) {
                    int afterStar = JsonPath.SkipWs(src, bpos + 1, e);
                    if (afterStar >= e || (src[afterStar] & 255) != 93) {
                        throw new ArgumentException("expected '93' in JSONPath at " + Convert.ToString(afterStar - s));
                    }
                    if (JsonPath.SkipWs(src, afterStar + 1, e) >= e) {
                        if (cur == null) { return null; }
                        if (cur.IsArray()) { return cur.Count() > 0 ? cur.At(0) : null; }
                        if (cur.IsObject()) { return cur.Count() > 0 ? cur.ValAt(0) : null; }
                        return null;
                    }
                    List<JsonValue> tmp = new List<JsonValue>();
                    JsonPath.EvalSelector(root, src, pp, start, end, tmp);
                    return tmp.Count > 0 ? tmp[0] : null;
                }
                if (bc == 63) {
                    int close = JsonPath.FindMatchingBracket(src, bpos + 1, e);
                    if (close < 0) { throw new ArgumentException("unterminated JSONPath filter"); }
                    if (JsonPath.SkipWs(src, close + 1, e) >= e) {
                        // 末段过滤早停短路：找到首个命中元素立即返回，零 List 分配。
                        if (cur == null || (!cur.IsArray() && !cur.IsObject())) { return null; }
                        int fs = JsonPath.SkipTrimLeft(src, bpos + 1, close);
                        int fe = JsonPath.SkipTrimRight(src, fs, close);
                        if (fe - fs >= 2 && (src[fs] & 255) == 40 && (src[fe - 1] & 255) == 41) {
                            fs = JsonPath.SkipTrimLeft(src, fs + 1, fe - 1);
                            fe = JsonPath.SkipTrimRight(src, fs, fe - 1);
                        }
                        return JsonPath.FindFirstFilterMatch(cur, src, pp, fs, fe);
                    }
                    List<JsonValue> tmp = new List<JsonValue>();
                    JsonPath.EvalSelector(root, src, pp, start, end, tmp);
                    return tmp.Count > 0 ? tmp[0] : null;
                }
                if (bc == 39 || bc == 34) {
                    int qEnd = NativeMemory.Find(pp, bpos + 1, bc, e - (bpos + 1));
                    if (qEnd < 0) { throw new ArgumentException("unterminated JSONPath name"); }
                    int after = JsonPath.SkipWs(src, qEnd + 1, e);
                    if (after >= e || (src[after] & 255) != 93) {
                        throw new ArgumentException("expected '93' in JSONPath at " + Convert.ToString(after - s));
                    }
                    if (cur != null) {
                        if (cur.IsObject()) {
                            cur = cur.Get(src.Substring(bpos + 1, qEnd - bpos - 1));
                        } else {
                            cur = null;
                        }
                    }
                    pos = after + 1;
                    continue;
                }
                int close2 = NativeMemory.Find(pp, bpos, 93, e - bpos);
                if (close2 < 0) { throw new ArgumentException("unterminated JSONPath bracket"); }
                int bs = JsonPath.SkipTrimLeft(src, bpos, close2);
                int be = JsonPath.SkipTrimRight(src, bs, close2);
                if (NativeMemory.Find(pp, bs, 58, be - bs) >= 0) {
                    List<JsonValue> tmp = new List<JsonValue>();
                    JsonPath.EvalSelector(root, src, pp, start, end, tmp);
                    return tmp.Count > 0 ? tmp[0] : null;
                }
                int idx = 0;
                if (JsonPath.TryIndexSlice(src, bs, be, out idx)) {
                    if (cur != null) {
                        if (cur.IsArray()) {
                            int arrN = cur.Count();
                            int ri = idx < 0 ? arrN + idx : idx;
                            cur = (ri >= 0 && ri < arrN) ? cur.At(ri) : null;
                        } else {
                            cur = null;
                        }
                    }
                } else {
                    if (cur != null) {
                        if (cur.IsObject()) {
                            cur = cur.Get(src.Substring(bs, be - bs));
                        } else {
                            cur = null;
                        }
                    }
                }
                pos = close2 + 1;
                continue;
            }
            throw new ArgumentException("invalid JSONPath at " + Convert.ToString(pos - s));
        }
    }

    // 流式单选择器解析+求值：
    //   - 零 JsonPathSegment 对象分配、零递归 Eval；
    //   - 标量前缀零 List<JsonValue> 分配；
    //   - 扇出段（[*]/[from:to:step]/[?(...)]）后接末段 `.child` 直接融合写入 out2，免中间列表分配。
    static void EvalSelector(JsonValue root, string src, nint pp, int start, int end, List<JsonValue> out2) {
        int s = JsonPath.SkipTrimLeft(src, start, end);
        int e = JsonPath.SkipTrimRight(src, s, end);
        if (s >= e) { return; }

        int pos = s;
        if ((src[pos] & 255) == 36) { pos = pos + 1; }

        JsonValue single = root;
        bool hasSingle = (root != null);
        List<JsonValue> cur = null;
        List<JsonValue> scratch = null;

        while (true) {
            pos = JsonPath.SkipWs(src, pos, e);
            if (pos >= e) { break; }
            int c = src[pos] & 255;

            if (c == 46) { // '.'
                pos = pos + 1;
                if (pos < e && (src[pos] & 255) == 46) {
                    // '..' 递归下降
                    pos = pos + 1;
                    int ns = pos;
                    while (pos < e) {
                        int cc = src[pos] & 255;
                        if (cc == 46 || cc == 91 || cc == 93 || cc == 32 || cc == 9) { break; }
                        pos = pos + 1;
                    }
                    int nlen = pos - ns;
                    bool isWild = (nlen == 0) || (nlen == 1 && (src[ns] & 255) == 42);
                    int nextPos = JsonPath.SkipWs(src, pos, e);
                    bool isLast = (nextPos >= e);
                    if (hasSingle) {
                        List<JsonValue> dst = isLast ? out2 : (scratch != null ? scratch : new List<JsonValue>());
                        if (!isLast) { dst.Clear(); }
                        if (isWild) {
                            JsonPath.CollectRecursiveAll(single, dst);
                        } else {
                            JsonPath.CollectRecursiveKey(single, src.Substring(ns, nlen), dst);
                        }
                        hasSingle = false;
                        single = null;
                        if (isLast) { return; }
                        cur = dst;
                        scratch = null;
                    } else if (cur != null && cur.Count > 0) {
                        List<JsonValue> dst = isLast ? out2 : (scratch != null ? scratch : new List<JsonValue>());
                        if (!isLast) { dst.Clear(); }
                        if (isWild) {
                            for (int i = 0; i < cur.Count; i = i + 1) {
                                JsonPath.CollectRecursiveAll(cur[i], dst);
                            }
                        } else {
                            string name = src.Substring(ns, nlen);
                            for (int i = 0; i < cur.Count; i = i + 1) {
                                JsonPath.CollectRecursiveKey(cur[i], name, dst);
                            }
                        }
                        if (isLast) { return; }
                        scratch = cur;
                        cur = dst;
                    }
                    pos = nextPos;
                    continue;
                }

                // '.name' 或 '.*'
                int ks = pos;
                while (pos < e) {
                    int cc = src[pos] & 255;
                    if (cc == 46 || cc == 91 || cc == 93 || cc == 32 || cc == 9) { break; }
                    pos = pos + 1;
                }
                int klen = pos - ks;
                if (klen == 0) {
                    throw new ArgumentException("invalid JSONPath at " + Convert.ToString(pos - s));
                }
                int nextPos2 = JsonPath.SkipWs(src, pos, e);
                bool isLast2 = (nextPos2 >= e);
                if (klen == 1 && (src[ks] & 255) == 42) {
                    if (hasSingle) {
                        string finalChild = null;
                        if (!isLast2 && JsonPath.TryPeekFinalChild(src, nextPos2, e, out finalChild)) {
                            JsonPath.CollectWildcardChild(single, finalChild, out2);
                            return;
                        }
                        List<JsonValue> dst = isLast2 ? out2 : (scratch != null ? scratch : new List<JsonValue>());
                        if (!isLast2) { dst.Clear(); }
                        JsonPath.CollectWildcard(single, dst);
                        hasSingle = false;
                        single = null;
                        if (isLast2) { return; }
                        cur = dst;
                        scratch = null;
                    } else if (cur != null && cur.Count > 0) {
                        List<JsonValue> dst = isLast2 ? out2 : (scratch != null ? scratch : new List<JsonValue>());
                        if (!isLast2) { dst.Clear(); }
                        for (int i = 0; i < cur.Count; i = i + 1) {
                            JsonPath.CollectWildcard(cur[i], dst);
                        }
                        if (isLast2) { return; }
                        scratch = cur;
                        cur = dst;
                    }
                } else {
                    if (hasSingle) {
                        if (single.IsObject()) {
                            single = single.Get(src.Substring(ks, klen));
                            if (single == null) { hasSingle = false; }
                        } else {
                            single = null;
                            hasSingle = false;
                        }
                    } else if (cur != null && cur.Count > 0) {
                        string key = src.Substring(ks, klen);
                        List<JsonValue> dst = isLast2 ? out2 : (scratch != null ? scratch : new List<JsonValue>());
                        if (!isLast2) { dst.Clear(); }
                        for (int i = 0; i < cur.Count; i = i + 1) {
                            JsonValue node = cur[i];
                            if (node.IsObject()) {
                                JsonValue v = node.Get(key);
                                if (v != null) { dst.Add(v); }
                            }
                        }
                        if (isLast2) { return; }
                        scratch = cur;
                        cur = dst;
                    }
                }
                pos = nextPos2;
                continue;
            }

            if (c == 91) { // '['
                pos = JsonPath.SkipWs(src, pos + 1, e);
                if (pos >= e) {
                    throw new ArgumentException("unterminated JSONPath bracket");
                }
                int bc = src[pos] & 255;

                // '[*]'
                if (bc == 42) {
                    pos = JsonPath.SkipWs(src, pos + 1, e);
                    if (pos >= e || (src[pos] & 255) != 93) {
                        throw new ArgumentException("expected '93' in JSONPath at " + Convert.ToString(pos - s));
                    }
                    pos = pos + 1;
                    int nextPos = JsonPath.SkipWs(src, pos, e);
                    bool isLast = (nextPos >= e);
                    if (hasSingle) {
                        string finalChild = null;
                        if (!isLast && JsonPath.TryPeekFinalChild(src, nextPos, e, out finalChild)) {
                            JsonPath.CollectWildcardChild(single, finalChild, out2);
                            return;
                        }
                        List<JsonValue> dst = isLast ? out2 : (scratch != null ? scratch : new List<JsonValue>());
                        if (!isLast) { dst.Clear(); }
                        JsonPath.CollectWildcard(single, dst);
                        hasSingle = false;
                        single = null;
                        if (isLast) { return; }
                        cur = dst;
                        scratch = null;
                    } else if (cur != null && cur.Count > 0) {
                        List<JsonValue> dst = isLast ? out2 : (scratch != null ? scratch : new List<JsonValue>());
                        if (!isLast) { dst.Clear(); }
                        for (int i = 0; i < cur.Count; i = i + 1) {
                            JsonPath.CollectWildcard(cur[i], dst);
                        }
                        if (isLast) { return; }
                        scratch = cur;
                        cur = dst;
                    }
                    pos = nextPos;
                    continue;
                }

                // '[?(...)]'
                if (bc == 63) {
                    int close = JsonPath.FindMatchingBracket(src, pos + 1, e);
                    if (close < 0) { throw new ArgumentException("unterminated JSONPath filter"); }
                    int fs = JsonPath.SkipTrimLeft(src, pos + 1, close);
                    int fe = JsonPath.SkipTrimRight(src, fs, close);
                    if (fe - fs >= 2 && (src[fs] & 255) == 40 && (src[fe - 1] & 255) == 41) {
                        fs = JsonPath.SkipTrimLeft(src, fs + 1, fe - 1);
                        fe = JsonPath.SkipTrimRight(src, fs, fe - 1);
                    }
                    pos = close + 1;
                    int nextPos = JsonPath.SkipWs(src, pos, e);
                    bool isLast = (nextPos >= e);
                    if (hasSingle) {
                        string finalChild = null;
                        if (!isLast && JsonPath.TryPeekFinalChild(src, nextPos, e, out finalChild)) {
                            JsonPath.ApplyFilterSingleChild(single, src, pp, fs, fe, finalChild, out2);
                            return;
                        }
                        List<JsonValue> dst = isLast ? out2 : (scratch != null ? scratch : new List<JsonValue>());
                        if (!isLast) { dst.Clear(); }
                        JsonPath.ApplyFilterSingle(single, src, pp, fs, fe, dst);
                        hasSingle = false;
                        single = null;
                        if (isLast) { return; }
                        cur = dst;
                        scratch = null;
                    } else if (cur != null && cur.Count > 0) {
                        List<JsonValue> dst = isLast ? out2 : (scratch != null ? scratch : new List<JsonValue>());
                        if (!isLast) { dst.Clear(); }
                        JsonPath.ApplyFilterList(cur, src, pp, fs, fe, dst);
                        if (isLast) { return; }
                        scratch = cur;
                        cur = dst;
                    }
                    pos = nextPos;
                    continue;
                }

                // "['name']" / '["name"]'
                if (bc == 39 || bc == 34) {
                    int qEnd = NativeMemory.Find(pp, pos + 1, bc, e - (pos + 1));
                    if (qEnd < 0) { throw new ArgumentException("unterminated JSONPath name"); }
                    int after = JsonPath.SkipWs(src, qEnd + 1, e);
                    if (after >= e || (src[after] & 255) != 93) {
                        throw new ArgumentException("expected '93' in JSONPath at " + Convert.ToString(after - s));
                    }
                    int ks = pos + 1;
                    int klen = qEnd - ks;
                    pos = after + 1;
                    int nextPos = JsonPath.SkipWs(src, pos, e);
                    bool isLast = (nextPos >= e);
                    if (hasSingle) {
                        if (single.IsObject()) {
                            single = single.Get(src.Substring(ks, klen));
                            if (single == null) { hasSingle = false; }
                        } else {
                            single = null;
                            hasSingle = false;
                        }
                    } else if (cur != null && cur.Count > 0) {
                        string key = src.Substring(ks, klen);
                        List<JsonValue> dst = isLast ? out2 : (scratch != null ? scratch : new List<JsonValue>());
                        if (!isLast) { dst.Clear(); }
                        for (int i = 0; i < cur.Count; i = i + 1) {
                            JsonValue node = cur[i];
                            if (node.IsObject()) {
                                JsonValue v = node.Get(key);
                                if (v != null) { dst.Add(v); }
                            }
                        }
                        if (isLast) { return; }
                        scratch = cur;
                        cur = dst;
                    }
                    pos = nextPos;
                    continue;
                }

                // '[from:to:step]' / '[idx]' / '[name]'
                int close2 = NativeMemory.Find(pp, pos, 93, e - pos);
                if (close2 < 0) { throw new ArgumentException("unterminated JSONPath bracket"); }
                int bs = JsonPath.SkipTrimLeft(src, pos, close2);
                int be = JsonPath.SkipTrimRight(src, bs, close2);
                pos = close2 + 1;
                int nextPos3 = JsonPath.SkipWs(src, pos, e);
                bool isLast3 = (nextPos3 >= e);

                int colon1 = NativeMemory.Find(pp, bs, 58, be - bs);
                if (colon1 >= 0) {
                    int sFrom = 0;
                    int sTo = 0;
                    bool hasTo = false;
                    int sStep = 1;
                    int v = 0;
                    int fStart = JsonPath.SkipTrimLeft(src, bs, colon1);
                    int fEnd = JsonPath.SkipTrimRight(src, fStart, colon1);
                    if (fEnd > fStart && JsonPath.TryIndexSlice(src, fStart, fEnd, out v)) { sFrom = v; }
                    int restStart = colon1 + 1;
                    int colon2 = restStart < be ? NativeMemory.Find(pp, restStart, 58, be - restStart) : -1;
                    if (colon2 < 0) {
                        int tStart = JsonPath.SkipTrimLeft(src, restStart, be);
                        int tEnd = JsonPath.SkipTrimRight(src, tStart, be);
                        if (tEnd > tStart && JsonPath.TryIndexSlice(src, tStart, tEnd, out v)) {
                            sTo = v;
                            hasTo = true;
                        }
                    } else {
                        int tStart = JsonPath.SkipTrimLeft(src, restStart, colon2);
                        int tEnd = JsonPath.SkipTrimRight(src, tStart, colon2);
                        if (tEnd > tStart && JsonPath.TryIndexSlice(src, tStart, tEnd, out v)) {
                            sTo = v;
                            hasTo = true;
                        }
                        int stepStart = colon2 + 1;
                        if (stepStart < be) {
                            int colon3 = NativeMemory.Find(pp, stepStart, 58, be - stepStart);
                            int stepEnd = colon3 >= 0 ? colon3 : be;
                            int pStart = JsonPath.SkipTrimLeft(src, stepStart, stepEnd);
                            int pEnd = JsonPath.SkipTrimRight(src, pStart, stepEnd);
                            if (pEnd > pStart && JsonPath.TryIndexSlice(src, pStart, pEnd, out v) && v != 0) {
                                sStep = v < 0 ? -v : v;
                            }
                        }
                    }
                    if (hasSingle) {
                        string finalChild = null;
                        if (!isLast3 && JsonPath.TryPeekFinalChild(src, nextPos3, e, out finalChild)) {
                            if (single.IsArray()) {
                                JsonPath.CollectSliceRawChild(single, sFrom, sTo, hasTo, sStep, finalChild, out2);
                            }
                            return;
                        }
                        List<JsonValue> dst = isLast3 ? out2 : (scratch != null ? scratch : new List<JsonValue>());
                        if (!isLast3) { dst.Clear(); }
                        if (single.IsArray()) { JsonPath.CollectSliceRaw(single, sFrom, sTo, hasTo, sStep, dst); }
                        hasSingle = false;
                        single = null;
                        if (isLast3) { return; }
                        cur = dst;
                        scratch = null;
                    } else if (cur != null && cur.Count > 0) {
                        List<JsonValue> dst = isLast3 ? out2 : (scratch != null ? scratch : new List<JsonValue>());
                        if (!isLast3) { dst.Clear(); }
                        for (int i = 0; i < cur.Count; i = i + 1) {
                            JsonValue node = cur[i];
                            if (node.IsArray()) { JsonPath.CollectSliceRaw(node, sFrom, sTo, hasTo, sStep, dst); }
                        }
                        if (isLast3) { return; }
                        scratch = cur;
                        cur = dst;
                    }
                    pos = nextPos3;
                    continue;
                }

                int idx2 = 0;
                if (JsonPath.TryIndexSlice(src, bs, be, out idx2)) {
                    if (hasSingle) {
                        if (single.IsArray()) {
                            int arrN = single.Count();
                            int ri = idx2 < 0 ? arrN + idx2 : idx2;
                            single = (ri >= 0 && ri < arrN) ? single.At(ri) : null;
                            if (single == null) { hasSingle = false; }
                        } else {
                            single = null;
                            hasSingle = false;
                        }
                    } else if (cur != null && cur.Count > 0) {
                        List<JsonValue> dst = isLast3 ? out2 : (scratch != null ? scratch : new List<JsonValue>());
                        if (!isLast3) { dst.Clear(); }
                        for (int i = 0; i < cur.Count; i = i + 1) {
                            JsonValue node = cur[i];
                            if (node.IsArray()) {
                                int arrN = node.Count();
                                int ri = idx2 < 0 ? arrN + idx2 : idx2;
                                if (ri >= 0 && ri < arrN) { dst.Add(node.At(ri)); }
                            }
                        }
                        if (isLast3) { return; }
                        scratch = cur;
                        cur = dst;
                    }
                    pos = nextPos3;
                    continue;
                }

                // 无引号键名 '[name]'
                if (hasSingle) {
                    if (single.IsObject()) {
                        single = single.Get(src.Substring(bs, be - bs));
                        if (single == null) { hasSingle = false; }
                    } else {
                        single = null;
                        hasSingle = false;
                    }
                } else if (cur != null && cur.Count > 0) {
                    string key = src.Substring(bs, be - bs);
                    List<JsonValue> dst = isLast3 ? out2 : (scratch != null ? scratch : new List<JsonValue>());
                    if (!isLast3) { dst.Clear(); }
                    for (int i = 0; i < cur.Count; i = i + 1) {
                        JsonValue node = cur[i];
                        if (node.IsObject()) {
                            JsonValue v = node.Get(key);
                            if (v != null) { dst.Add(v); }
                        }
                    }
                    if (isLast3) { return; }
                    scratch = cur;
                    cur = dst;
                }
                pos = nextPos3;
                continue;
            }

            throw new ArgumentException("invalid JSONPath at " + Convert.ToString(pos - s));
        }

        if (hasSingle && single != null) {
            out2.Add(single);
        } else if (cur != null) {
            for (int i = 0; i < cur.Count; i = i + 1) { out2.Add(cur[i]); }
        }
    }

    static void CollectWildcard(JsonValue node, List<JsonValue> out2) {
        if (node.IsArray()) {
            int n = node.Count();
            for (int k = 0; k < n; k = k + 1) { out2.Add(node.At(k)); }
        } else if (node.IsObject()) {
            int n = node.Count();
            for (int k = 0; k < n; k = k + 1) { out2.Add(node.ValAt(k)); }
        }
    }

    static void CollectWildcardChild(JsonValue node, string childKey, List<JsonValue> out2) {
        if (node.IsArray()) {
            int n = node.Count();
            for (int k = 0; k < n; k = k + 1) {
                JsonValue elem = node.At(k);
                if (elem.IsObject()) {
                    JsonValue v = elem.Get(childKey);
                    if (v != null) { out2.Add(v); }
                }
            }
        } else if (node.IsObject()) {
            int n = node.Count();
            for (int k = 0; k < n; k = k + 1) {
                JsonValue elem = node.ValAt(k);
                if (elem.IsObject()) {
                    JsonValue v = elem.Get(childKey);
                    if (v != null) { out2.Add(v); }
                }
            }
        }
    }

    static int FindMatchingBracket(string src, int start, int end) {
        int depth = 1;
        int quote = 0;
        for (int i = start; i < end; i = i + 1) {
            int c = src[i] & 255;
            if (quote != 0) {
                if (c == 92) {
                    i = i + 1;
                    continue;
                }
                if (c == quote) { quote = 0; }
                continue;
            }
            if (c == 39 || c == 34) {
                quote = c;
            } else if (c == 91) {
                depth = depth + 1;
            } else if (c == 93) {
                depth = depth - 1;
                if (depth == 0) { return i; }
            }
        }
        return -1;
    }

    static void CollectSliceRaw(JsonValue arr, int from, int to, bool hasTo, int step, List<JsonValue> out2) {
        int n = arr.Count();
        if (!hasTo) { to = n; }
        if (from < 0) { from = n + from; }
        if (to < 0) { to = n + to; }
        if (from < 0) { from = 0; }
        if (to > n) { to = n; }
        if (step <= 0) { step = 1; }
        for (int i = from; i < to; i = i + step) {
            out2.Add(arr.At(i));
        }
    }

    static void CollectSliceRawChild(JsonValue arr, int from, int to, bool hasTo, int step, string childKey, List<JsonValue> out2) {
        int n = arr.Count();
        if (!hasTo) { to = n; }
        if (from < 0) { from = n + from; }
        if (to < 0) { to = n + to; }
        if (from < 0) { from = 0; }
        if (to > n) { to = n; }
        if (step <= 0) { step = 1; }
        for (int i = from; i < to; i = i + step) {
            JsonValue elem = arr.At(i);
            if (elem.IsObject()) {
                JsonValue v = elem.Get(childKey);
                if (v != null) { out2.Add(v); }
            }
        }
    }

    // 递归下降（按容器类型拆分为 Obj/Arr 避免重复 IsObject/IsArray 检查并跳过叶节点）。
    static void CollectRecursiveKeyObj(JsonValue node, string name, List<JsonValue> out2) {
        int n = node.Count();
        for (int i = 0; i < n; i = i + 1) {
            string k = node.KeyAt(i);
            JsonValue v = node.ValAt(i);
            if (k == name) { out2.Add(v); }
            if (v.IsObject()) {
                JsonPath.CollectRecursiveKeyObj(v, name, out2);
            } else if (v.IsArray()) {
                JsonPath.CollectRecursiveKeyArr(v, name, out2);
            }
        }
    }

    static void CollectRecursiveKeyArr(JsonValue node, string name, List<JsonValue> out2) {
        int n = node.Count();
        for (int i = 0; i < n; i = i + 1) {
            JsonValue v = node.At(i);
            if (v.IsObject()) {
                JsonPath.CollectRecursiveKeyObj(v, name, out2);
            } else if (v.IsArray()) {
                JsonPath.CollectRecursiveKeyArr(v, name, out2);
            }
        }
    }

    static void CollectRecursiveKey(JsonValue node, string name, List<JsonValue> out2) {
        if (node.IsObject()) {
            JsonPath.CollectRecursiveKeyObj(node, name, out2);
        } else if (node.IsArray()) {
            JsonPath.CollectRecursiveKeyArr(node, name, out2);
        }
    }

    // 递归下降（特化通配 '*'）。
    static void CollectRecursiveAll(JsonValue node, List<JsonValue> out2) {
        if (node.IsObject()) {
            int n = node.Count();
            for (int i = 0; i < n; i = i + 1) {
                JsonValue v = node.ValAt(i);
                out2.Add(v);
                if (v.IsObject() || v.IsArray()) {
                    JsonPath.CollectRecursiveAll(v, out2);
                }
            }
        } else if (node.IsArray()) {
            int n = node.Count();
            for (int i = 0; i < n; i = i + 1) {
                JsonValue v = node.At(i);
                out2.Add(v);
                if (v.IsObject() || v.IsArray()) {
                    JsonPath.CollectRecursiveAll(v, out2);
                }
            }
        }
    }

    // 零堆分配快读常见 JSON 数字（整数与简单小数）；含科学计数法或超长位数回退 ParseNumberToken。
    static bool TryParseNumberFast(string src, int rs, int re, out double val) {
        val = 0.0;
        if (rs >= re) { return false; }
        int i = rs;
        bool neg = false;
        if ((src[i] & 255) == 45) { neg = true; i = i + 1; }
        if (i >= re) { return false; }
        long intPart = 0L;
        int digits = 0;
        while (i < re) {
            int d = (src[i] & 255) - 48;
            if (d < 0 || d > 9) { break; }
            if (digits >= 15) { return false; }
            intPart = intPart * 10L + (long)d;
            digits = digits + 1;
            i = i + 1;
        }
        if (digits == 0) { return false; }
        if (i == re) {
            val = neg ? -(double)intPart : (double)intPart;
            return true;
        }
        if ((src[i] & 255) == 46) {
            i = i + 1;
            long frac = 0L;
            double scale = 1.0;
            int fdigits = 0;
            while (i < re) {
                int d = (src[i] & 255) - 48;
                if (d < 0 || d > 9) { break; }
                if (fdigits >= 9) { return false; }
                frac = frac * 10L + (long)d;
                scale = scale * 10.0;
                fdigits = fdigits + 1;
                i = i + 1;
            }
            if (fdigits == 0 || i != re) { return false; }
            double res = (double)intPart + (double)frac / scale;
            val = neg ? -res : res;
            return true;
        }
        return false;
    }

    // ---- 过滤条件（单遍预编译为整型 opKind + 标量 RHS，单键零 List 分配）----
    // opKind: 0=exists, 1=EQ, 2=NE, 3=GT, 4=GE, 5=LT, 6=LE
    // rhsKind: 0=invalid, 1=number, 2=string, 3=bool, 4=null

    static bool ParseFilterPlan(
        string src, nint pp, int fs, int fe,
        out string key0, out List<string> extraKeys, out bool selfNode,
        out int opKind, out int rhsKind, out double rhsNum, out string rhsStr, out bool rhsBool
    ) {
        key0 = null;
        extraKeys = null;
        selfNode = false;
        opKind = 0;
        rhsKind = 0;
        rhsNum = 0.0;
        rhsStr = "";
        rhsBool = false;

        if (fs >= fe || (src[fs] & 255) != 64) { return false; }

        int opAt = -1;
        int opLen = 0;
        for (int i = fs + 1; i < fe; i = i + 1) {
            int c = src[i] & 255;
            if (c == 39 || c == 34) {
                i = i + 1;
                while (i < fe && (src[i] & 255) != c) { i = i + 1; }
                continue;
            }
            if (c == 61 && i + 1 < fe && (src[i + 1] & 255) == 61) {
                opAt = i; opLen = 2; opKind = 1; break;
            }
            if (c == 33 && i + 1 < fe && (src[i + 1] & 255) == 61) {
                opAt = i; opLen = 2; opKind = 2; break;
            }
            if (c == 62) {
                if (i + 1 < fe && (src[i + 1] & 255) == 61) {
                    opAt = i; opLen = 2; opKind = 4; break;
                }
                opAt = i; opLen = 1; opKind = 3; break;
            }
            if (c == 60) {
                if (i + 1 < fe && (src[i + 1] & 255) == 61) {
                    opAt = i; opLen = 2; opKind = 6; break;
                }
                opAt = i; opLen = 1; opKind = 5; break;
            }
        }

        int le = (opAt < 0) ? fe : JsonPath.SkipTrimRight(src, fs, opAt);
        if (le == fs + 1) {
            selfNode = true;
        } else {
            int i = fs + 1;
            while (i < le) {
                int c = src[i] & 255;
                string segKey = null;
                if (c == 46) {
                    i = i + 1;
                    int ks = i;
                    while (i < le) {
                        int cc = src[i] & 255;
                        if (cc == 46 || cc == 91) { break; }
                        i = i + 1;
                    }
                    segKey = src.Substring(ks, i - ks);
                } else if (c == 91) {
                    i = i + 1;
                    int ks = i;
                    int close = JsonPath.FindMatchingBracket(src, i, le);
                    int ke = close >= 0 ? close : le;
                    int rs = JsonPath.SkipTrimLeft(src, ks, ke);
                    int re = JsonPath.SkipTrimRight(src, rs, ke);
                    if (re - rs >= 2 && ((src[rs] & 255) == 39 || (src[rs] & 255) == 34)
                        && (src[re - 1] & 255) == (src[rs] & 255)) {
                        rs = rs + 1;
                        re = re - 1;
                    }
                    segKey = src.Substring(rs, re - rs);
                    i = close >= 0 ? close + 1 : le;
                } else {
                    return false;
                }
                if (key0 == null) {
                    key0 = segKey;
                } else {
                    if (extraKeys == null) { extraKeys = new List<string>(); }
                    extraKeys.Add(segKey);
                }
            }
        }

        if (opKind != 0) {
            int rs = JsonPath.SkipTrimLeft(src, opAt + opLen, fe);
            int re = JsonPath.SkipTrimRight(src, rs, fe);
            int rlen = re - rs;
            if (rlen <= 0) {
                rhsKind = 0;
            } else {
                int rc = src[rs] & 255;
                if (rc == 39 || rc == 34) {
                    if (rlen < 2 || (src[re - 1] & 255) != rc) {
                        throw new ArgumentException("unterminated string literal in JSONPath filter");
                    }
                    rhsKind = 2;
                    rhsStr = src.Substring(rs + 1, rlen - 2);
                } else if (rlen == 4 && rc == 116 && (src[rs + 1] & 255) == 114 && (src[rs + 2] & 255) == 117 && (src[rs + 3] & 255) == 101) {
                    rhsKind = 3;
                    rhsBool = true;
                } else if (rlen == 5 && rc == 102 && (src[rs + 1] & 255) == 97 && (src[rs + 2] & 255) == 108 && (src[rs + 3] & 255) == 115 && (src[rs + 4] & 255) == 101) {
                    rhsKind = 3;
                    rhsBool = false;
                } else if (rlen == 4 && rc == 110 && (src[rs + 1] & 255) == 117 && (src[rs + 2] & 255) == 108 && (src[rs + 3] & 255) == 108) {
                    rhsKind = 4;
                } else {
                    double fastNum = 0.0;
                    if (JsonPath.TryParseNumberFast(src, rs, re, out fastNum)) {
                        rhsKind = 1;
                        rhsNum = fastNum;
                    } else {
                        JsonValue nv = JsonValue.ParseNumberToken(src, rs, re);
                        if (nv != null && nv.IsNumber()) {
                            rhsKind = 1;
                            rhsNum = nv.AsDouble(0.0);
                        } else {
                            rhsKind = 0;
                        }
                    }
                }
            }
        }
        return true;
    }

    static bool MatchFilterElem(
        JsonValue elem, string key0, List<string> extraKeys, bool selfNode,
        int opKind, int rhsKind, double rhsNum, string rhsStr, bool rhsBool
    ) {
        JsonValue cur = elem;
        if (!selfNode) {
            if (cur == null || !cur.IsObject()) {
                cur = null;
            } else {
                cur = cur.Get(key0);
                if (extraKeys != null) {
                    int kn = extraKeys.Count;
                    for (int i = 0; i < kn; i = i + 1) {
                        if (cur == null || !cur.IsObject()) { cur = null; break; }
                        cur = cur.Get(extraKeys[i]);
                    }
                }
            }
        }
        if (opKind == 0) {
            return cur != null && !cur.IsNull();
        }
        if (cur == null || rhsKind == 0) { return false; }
        if (opKind == 1) { // ==
            if (rhsKind == 1) { return cur.IsNumber() && cur.AsDouble(0.0) == rhsNum; }
            if (rhsKind == 2) { return cur.IsString() && cur.AsString("") == rhsStr; }
            if (rhsKind == 3) { return cur.IsBool() && cur.AsBool(false) == rhsBool; }
            if (rhsKind == 4) { return cur.IsNull(); }
            return false;
        }
        if (opKind == 2) { // !=
            if (rhsKind == 1) { return !(cur.IsNumber() && cur.AsDouble(0.0) == rhsNum); }
            if (rhsKind == 2) { return !(cur.IsString() && cur.AsString("") == rhsStr); }
            if (rhsKind == 3) { return !(cur.IsBool() && cur.AsBool(false) == rhsBool); }
            if (rhsKind == 4) { return !cur.IsNull(); }
            return true;
        }
        if (rhsKind == 1) {
            if (!cur.IsNumber()) { return false; }
            double a = cur.AsDouble(0.0);
            if (opKind == 3) { return a > rhsNum; }
            if (opKind == 4) { return a >= rhsNum; }
            if (opKind == 5) { return a < rhsNum; }
            if (opKind == 6) { return a <= rhsNum; }
            return false;
        }
        if (rhsKind == 2) {
            if (!cur.IsString()) { return false; }
            string a = cur.AsString("");
            if (opKind == 3) { return a > rhsStr; }
            if (opKind == 4) { return a >= rhsStr; }
            if (opKind == 5) { return a < rhsStr; }
            if (opKind == 6) { return a <= rhsStr; }
        }
        return false;
    }

    static JsonValue FindFirstFilterMatch(JsonValue node, string src, nint pp, int fs, int fe) {
        string key0 = null;
        List<string> extraKeys = null;
        bool selfNode = false;
        int opKind = 0;
        int rhsKind = 0;
        double rhsNum = 0.0;
        string rhsStr = "";
        bool rhsBool = false;
        if (!JsonPath.ParseFilterPlan(src, pp, fs, fe, out key0, out extraKeys, out selfNode, out opKind, out rhsKind, out rhsNum, out rhsStr, out rhsBool)) {
            return null;
        }
        if (node.IsArray()) {
            int n = node.Count();
            for (int k = 0; k < n; k = k + 1) {
                JsonValue elem = node.At(k);
                if (JsonPath.MatchFilterElem(elem, key0, extraKeys, selfNode, opKind, rhsKind, rhsNum, rhsStr, rhsBool)) {
                    return elem;
                }
            }
        } else {
            int n = node.Count();
            for (int k = 0; k < n; k = k + 1) {
                JsonValue elem = node.ValAt(k);
                if (JsonPath.MatchFilterElem(elem, key0, extraKeys, selfNode, opKind, rhsKind, rhsNum, rhsStr, rhsBool)) {
                    return elem;
                }
            }
        }
        return null;
    }

    static void ApplyFilterSingleChild(JsonValue node, string src, nint pp, int fs, int fe, string childKey, List<JsonValue> dst) {
        if (!node.IsArray() && !node.IsObject()) { return; }
        string key0 = null;
        List<string> extraKeys = null;
        bool selfNode = false;
        int opKind = 0;
        int rhsKind = 0;
        double rhsNum = 0.0;
        string rhsStr = "";
        bool rhsBool = false;
        if (!JsonPath.ParseFilterPlan(src, pp, fs, fe, out key0, out extraKeys, out selfNode, out opKind, out rhsKind, out rhsNum, out rhsStr, out rhsBool)) {
            return;
        }
        if (node.IsArray()) {
            int n = node.Count();
            for (int k = 0; k < n; k = k + 1) {
                JsonValue elem = node.At(k);
                if (JsonPath.MatchFilterElem(elem, key0, extraKeys, selfNode, opKind, rhsKind, rhsNum, rhsStr, rhsBool)) {
                    if (elem.IsObject()) {
                        JsonValue v = elem.Get(childKey);
                        if (v != null) { dst.Add(v); }
                    }
                }
            }
        } else {
            int n = node.Count();
            for (int k = 0; k < n; k = k + 1) {
                JsonValue elem = node.ValAt(k);
                if (JsonPath.MatchFilterElem(elem, key0, extraKeys, selfNode, opKind, rhsKind, rhsNum, rhsStr, rhsBool)) {
                    if (elem.IsObject()) {
                        JsonValue v = elem.Get(childKey);
                        if (v != null) { dst.Add(v); }
                    }
                }
            }
        }
    }

    static void ApplyFilterSingle(JsonValue node, string src, nint pp, int fs, int fe, List<JsonValue> dst) {
        if (!node.IsArray() && !node.IsObject()) { return; }
        string key0 = null;
        List<string> extraKeys = null;
        bool selfNode = false;
        int opKind = 0;
        int rhsKind = 0;
        double rhsNum = 0.0;
        string rhsStr = "";
        bool rhsBool = false;
        if (!JsonPath.ParseFilterPlan(src, pp, fs, fe, out key0, out extraKeys, out selfNode, out opKind, out rhsKind, out rhsNum, out rhsStr, out rhsBool)) {
            return;
        }
        if (node.IsArray()) {
            int n = node.Count();
            for (int k = 0; k < n; k = k + 1) {
                JsonValue elem = node.At(k);
                if (JsonPath.MatchFilterElem(elem, key0, extraKeys, selfNode, opKind, rhsKind, rhsNum, rhsStr, rhsBool)) {
                    dst.Add(elem);
                }
            }
        } else {
            int n = node.Count();
            for (int k = 0; k < n; k = k + 1) {
                JsonValue elem = node.ValAt(k);
                if (JsonPath.MatchFilterElem(elem, key0, extraKeys, selfNode, opKind, rhsKind, rhsNum, rhsStr, rhsBool)) {
                    dst.Add(elem);
                }
            }
        }
    }

    static void ApplyFilterList(List<JsonValue> nodes, string src, nint pp, int fs, int fe, List<JsonValue> dst) {
        string key0 = null;
        List<string> extraKeys = null;
        bool selfNode = false;
        int opKind = 0;
        int rhsKind = 0;
        double rhsNum = 0.0;
        string rhsStr = "";
        bool rhsBool = false;
        if (!JsonPath.ParseFilterPlan(src, pp, fs, fe, out key0, out extraKeys, out selfNode, out opKind, out rhsKind, out rhsNum, out rhsStr, out rhsBool)) {
            return;
        }
        int cn = nodes.Count;
        for (int i = 0; i < cn; i = i + 1) {
            JsonValue node = nodes[i];
            if (node.IsArray()) {
                int n = node.Count();
                for (int k = 0; k < n; k = k + 1) {
                    JsonValue elem = node.At(k);
                    if (JsonPath.MatchFilterElem(elem, key0, extraKeys, selfNode, opKind, rhsKind, rhsNum, rhsStr, rhsBool)) {
                        dst.Add(elem);
                    }
                }
            } else if (node.IsObject()) {
                int n = node.Count();
                for (int k = 0; k < n; k = k + 1) {
                    JsonValue elem = node.ValAt(k);
                    if (JsonPath.MatchFilterElem(elem, key0, extraKeys, selfNode, opKind, rhsKind, rhsNum, rhsStr, rhsBool)) {
                        dst.Add(elem);
                    }
                }
            }
        }
    }

    // 切片直读整数（可带负号）；不是整数返回 false。
    static bool TryIndexSlice(string s, int start, int end, out int value) {
        value = 0;
        if (s == null || start >= end) { return false; }
        int i = start;
        int sign = 1;
        int c = s[i] & 255;
        if (c == 45) { sign = -1; i = i + 1; }
        if (i >= end) { return false; }
        int v = 0;
        for (; i < end; i = i + 1) {
            int d = (s[i] & 255) - 48;
            if (d < 0 || d > 9) { return false; }
            v = v * 10 + d;
        }
        value = sign * v;
        return true;
    }

    static int IndexOf(string s) {
        int v = 0;
        if (s != null && JsonPath.TryIndexSlice(s, 0, s.Length, out v)) { return v; }
        return -1;
    }

    static bool TryIndex(string s, out int value) {
        value = 0;
        if (s == null) { return false; }
        return JsonPath.TryIndexSlice(s, 0, s.Length, out value);
    }
}
