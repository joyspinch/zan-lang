using System;
using System.Collections.Generic;

namespace System.Json;

// 一条校验错误。
public class JsonSchemaError {
    // 实例路径（JSON Pointer 形态；根是空串）。
    public string path;
    // 触发的关键字（"type" / "required" / "minimum" …）。
    public string keyword;
    // 说明文字。
    public string message;

    public JsonSchemaError(string path, string keyword, string message) {
        this.path = path == null ? "" : path;
        this.keyword = keyword == null ? "" : keyword;
        this.message = message == null ? "" : message;
    }

    // 一行可读描述。
    public string Describe() {
        string at = this.path.Length == 0 ? "/" : this.path;
        return at + ": " + this.message + " [" + this.keyword + "]";
    }
}

// 校验结果。
public class JsonSchemaResult {
    // 所有错误（没有错误就是通过）。
    public List<JsonSchemaError> errors;

    public JsonSchemaResult() {
        this.errors = new List<JsonSchemaError>();
    }

    // 是否通过。
    public bool IsValid() { return this.errors.Count == 0; }

    // 错误条数。
    public int Count() { return this.errors.Count; }

    // 第一条错误（没有返回 null）。
    public JsonSchemaError First() {
        if (this.errors.Count == 0) { return null; }
        return this.errors[0];
    }

    // 汇总成一行文字。
    public string Message() {
        if (this.errors.Count == 0) { return "valid"; }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < this.errors.Count; i = i + 1) {
            if (i > 0) { sb.Append("; "); }
            sb.Append(this.errors[i].Describe());
        }
        return sb.ToString();
    }
}

// JSON Schema（draft 2020-12 子集）。
//
// 支持的关键字：type / enum / const / required / properties /
// patternProperties / additionalProperties / items / prefixItems /
// minItems / maxItems / uniqueItems / minimum / maximum /
// exclusiveMinimum / exclusiveMaximum / multipleOf / minLength /
// maxLength / pattern / allOf / anyOf / oneOf / not / $ref（本地指针）。
//
// 说明：
//   - 布尔 schema 照 spec 解释（true 恒真、false 恒假）；
//   - "$ref" 只解析本地指针（"#/$defs/x"、"#/definitions/x"、
//     "#/properties/x"），不支持远程引用；
//   - "$ref" 与同级关键字并存时，只按 $ref 校验（不合并同级）；
//   - 递归 schema 按实例深度限 64 层，超出后不再下钻；
//   - 字符串长度按码点数算（不是字节数）。
public class JsonSchema {
    // schema 文档本身。
    public JsonValue root;
    // "$defs" / "definitions"（$ref 的本地解析入口）。
    public JsonValue defs;

    public JsonSchema() {
        this.root = JsonValue.NewObject();
        this.defs = null;
    }

    // 从 JSON 文本建 schema（文本非法时抛 JsonException）。
    public static JsonSchema Parse(string json) {
        return JsonSchema.Of(JsonValue.Parse(json));
    }

    // 从已有的值树建 schema。
    public static JsonSchema Of(JsonValue doc) {
        JsonSchema s = new JsonSchema();
        s.root = doc == null ? JsonValue.NewObject() : doc;
        JsonValue d = s.root.Get("$defs");
        if (d == null) { d = s.root.Get("definitions"); }
        s.defs = d;
        return s;
    }

    // 校验一个实例，返回全部错误（不是首个）。
    public JsonSchemaResult Validate(JsonValue instance) {
        JsonSchemaValidator v = new JsonSchemaValidator(this);
        return v.Validate(instance);
    }

    // 只问合不合格。
    public bool IsValid(JsonValue instance) {
        return this.Validate(instance).IsValid();
    }
}
