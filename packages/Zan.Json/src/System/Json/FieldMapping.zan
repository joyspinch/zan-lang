using System;
using System.Reflection;

namespace System.Json;

// JSON and data binding share the existing field annotation conventions.
public class FieldMapping {
    public string Name;
    public string DefaultValue;
    public bool Ignored;
    public bool Required;
    public bool Primary;
    public bool Identity;

    public static FieldMapping Read(TypeInfo type, int index) {
        FieldMapping field = new FieldMapping();
        field.Name = type.GetFieldName(index);
        field.DefaultValue = "";
        AttributeReader attributes = new AttributeReader(type.GetFieldAttributeData(index));
        while (attributes.MoveNext()) {
            string name = attributes.Name;
            if (name.EndsWith("Attribute")) { name = name.Substring(0, name.Length - 9); }
            if (name == "Column" || name == "JsonProperty" || name == "JsonPropertyName") {
                while (attributes.MoveNextArgument()) {
                    string key = attributes.ArgumentName;
                    if (attributes.ArgumentKind == 'S' && (key == "" || key == "Name")) {
                        field.Name = attributes.ArgumentValue;
                    }
                    if (attributes.ArgumentKind == 'B' && attributes.ArgumentValue == "true") {
                        if (key == "Ignore") { field.Ignored = true; }
                        else if (key == "Required") { field.Required = true; }
                        else if (key == "IsPrimary") { field.Primary = true; }
                        else if (key == "IsIdentity") { field.Identity = true; }
                    }
                }
            } else if (name == "JsonIgnore" || name == "Ignore" || name == "NotMapped") {
                field.Ignored = true;
            } else if (name == "JsonRequired" || name == "Required") {
                field.Required = true;
            } else if (name == "Key" || name == "PrimaryKey") {
                field.Primary = true;
            } else if ((name == "JsonDefault" || name == "DefaultValue") && attributes.MoveNextArgument()) {
                char kind = attributes.ArgumentKind;
                if (kind == 'S' || kind == 'B' || kind == 'I' || kind == 'F') {
                    field.DefaultValue = attributes.ArgumentValue;
                }
            }
        }
        return field;
    }
}
