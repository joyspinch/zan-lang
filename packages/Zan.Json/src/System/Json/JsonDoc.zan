// 平面 tape JSON 解析器。热路径是单函数显式栈状态机（ParseTape）：
// 使用类型化数组写入 tape，空间不足时搬移已写槽位后继续扫描。
// 错误 -(位置+1) 为首错位置、MaxDepth 容器封顶、空容器槽编码、escPool 物化保持稳定规范。
using System;
using System.Collections.Generic;
using System.Text;
using System.Threading;

namespace System.Json;

public delegate T JsonDocScopeFunc<T>(JsonDoc doc);
public delegate void JsonDocScopeAction(JsonDoc doc);

// 一个 JSON 槽位（tape 上的一个节点）。JsonDoc 的 slots 列表就是
// 解析出的整棵树，深度优先连续排布：标量内联在槽里，孩子紧随
// 容器槽之后。字段编码（16 字节，<see cref="JsonSlot.a"/> 低 8 位
// 是值类别，其余位按类别复用；b 是唯一的载荷字段）：
// - null/bool（kind 0/1/6）：a 即 kind，一位信息折进编码，b = 0；
// - 整数（kind 2，纯整数 token）：完整 64 位值放 <see cref="JsonSlot.b"/>；
// - 浮点（kind 7，带 . / e 的 token）：IEEE 754 位型经
// NativeMemory.AsI64 折进 <see cref="JsonSlot.b"/>（AsF64 取回）；
// - 字符串（kind 3）：无转义 token 零拷贝——a 高位记 src 起始偏移、
// b 记长度；含转义（无法零拷贝）a 高位记 -1，b 记 escPool 下标；
// 按需模式中尚未解码的值以 -2 标记，b 保存原文与首个转义的偏移。
// - 数组（kind 4）/ 对象（kind 5）：b = 元素数 | (跳过偏移 &lt;&lt; 31)，
// 跳过偏移是"容器整体之后第一个槽位"的相对距离。
// <see cref="JsonDoc.KindAt"/> 把 6/7 归一化回 0..5 对外契约。
public partial class JsonDoc {
    // tape 槽位（外部走访问器）。
    public JsonSlot[] slots;
    public int slotCount;
    // 全部对象的键值对表（对象槽 a 高位记首对下标）。
    public JsonPair[] pairs;
    public int pairCount;
    // 含转义的字符串/键在此物化（无转义的走 src 零拷贝）。
    public List<string> escPool;
    // 源串。零拷贝 token 指向它，因此它随 doc 存活。
    public string src;
    // 源字节缓冲，下标 < len 与字符串下标一一对应。
    public byte[] buf;
    // 根槽位。
    public int root;

    private int maxValueDepth;

    // Depth of the deepest value, measured from root depth zero.
    public int MaxValueDepth() { return this.maxValueDepth; }

    private const int DeferredEscape = -2;
    private StringBuilder deferredEscapeBuilder;

    public JsonDoc() {
        this.slots = null;
        this.slotCount = 0;
        this.pairs = null;
        this.pairCount = 0;
        this.escPool = null;
        this.src = "";
        this.buf = null;
        this.root = 0;
    }

    private static ThreadLocal<JsonScratch> scratchPool = new ThreadLocal<JsonScratch>(() => new JsonScratch());

    public static JsonScratch GetScratch() {
        return JsonDoc.scratchPool.Value;
    }

    // A scoped document borrows its tape until the callback returns. Nested
    // Parse/ParseScoped calls must lease another tape, including on exceptions.
    // Keep one reusable workspace per nesting depth on the current thread.
    private static JsonScratch RentScratch() {
        JsonScratch sc = JsonDoc.GetScratch();
        while (sc.leased) {
            if (sc.next == null) { sc.next = new JsonScratch(); }
            sc = sc.next;
        }
        sc.leased = true;
        return sc;
    }

    // 在回调中借用线程局部解析工作区。回调返回后不得再访问文档。
    public static T ParseScoped<T>(string src, JsonDocScopeFunc<T> fn) {
        return JsonDoc.ParseScopedCore<T>(src, fn, false);
    }

    // Read the document on the calling thread during the callback.
    // Escaped string values are decoded and cached on their first read.
    public static T ParseScopedDeferred<T>(string src, JsonDocScopeFunc<T> fn) {
        return JsonDoc.ParseScopedCore<T>(src, fn, true);
    }

    private static T ParseScopedCore<T>(string src, JsonDocScopeFunc<T> fn, bool deferEscapes) {
        if (src == null) { throw new JsonException("JSON source cannot be null"); }
        if (fn == null) { throw new JsonException("Scoped function cannot be null"); }
        JsonScratch sc = JsonDoc.RentScratch();
        try {
            JsonDoc doc = JsonDoc.ParseBorrowed(src, sc, deferEscapes);
            try { return fn(doc); }
            finally { JsonDoc.ReleaseBorrowed(doc); }
        } finally { sc.leased = false; }
    }

    public static void ParseScoped(string src, JsonDocScopeAction fn) {
        JsonDoc.ParseScopedCore(src, fn, false);
    }

    public static void ParseScopedDeferred(string src, JsonDocScopeAction fn) {
        JsonDoc.ParseScopedCore(src, fn, true);
    }

    private static void ParseScopedCore(string src, JsonDocScopeAction fn, bool deferEscapes) {
        if (src == null) { throw new JsonException("JSON source cannot be null"); }
        if (fn == null) { throw new JsonException("Scoped action cannot be null"); }
        JsonScratch sc = JsonDoc.RentScratch();
        try {
            JsonDoc doc = JsonDoc.ParseBorrowed(src, sc, deferEscapes);
            try { fn(doc); }
            finally { JsonDoc.ReleaseBorrowed(doc); }
        } finally { sc.leased = false; }
    }

    private static void ReleaseBorrowed(JsonDoc doc) {
        doc.deferredEscapeBuilder = null;
        doc.slots = null;
        doc.pairs = null;
        doc.buf = null;
    }

    private static JsonDoc ParseBorrowed(string src, JsonScratch sc, bool deferEscapes) {
        int len = src.Length;
        byte[] input;
        if (len <= JsonScratch.MaxRetainedSourceBytes) {
            sc.EnsureCapacity(len, 0, 0);
            input = sc.buf;
        } else {
            // Oversized input belongs to this scope, including when parsing fails.
            input = new byte[len + 32];
        }
        NativeMemory.PutString(input, 0, src, len);
        JsonDoc doc = new JsonDoc();
        doc.src = src;
        doc.buf = input;
        JsonDoc.ParseDocument(doc, len, sc, deferEscapes);
        return doc;
    }

    public static JsonDoc Parse(string src) {
        if (src == null) { throw new JsonException("JSON source cannot be null"); }
        int len = src.Length;
        // buf 必须是本 doc 独占的缓冲：slots 里的键偏移指向它，
        // doc 存活期间 Get() 都要在它上面比对。线程局部 scratch 池
        // 会被任何一次后续 Parse 覆写，绝不能交给长命 doc（否则同线程
        // 再解析一次就破坏老 doc 的键查找）。scratch 只复用 slots/pairs
        // 暂存（ParseInternal 会拷出）与 ParseScoped 瞬时场景。
        byte[] buf = new byte[len];
        NativeMemory.PutString(buf, 0, src, len);
        return JsonDoc.ParseInternal(buf, len, src);
    }

    // Tape offsets are relative to the start of the selected input.
    public static JsonDoc ParseBytes(byte[] buf, int off, int len) {
        if (buf == null) { throw new JsonException("JSON buffer cannot be null"); }
        if (off < 0 || len < 0 || off > buf.Length || len > buf.Length - off) {
            throw new JsonException("JSON buffer range out of bounds");
        }
        byte[] input = new byte[len];
        if (len > 0) {
            NativeMemory.Copy(input, (nint)buf + (nint)off, len);
        }
        return JsonDoc.ParseInternal(input, len, input.ToStr(0, len));
    }

    private static JsonDoc ParseInternal(byte[] buf, int len, string src) {
        JsonScratch sc = JsonDoc.RentScratch();
        try { return JsonDoc.ParseInternalWithScratch(buf, len, src, sc); }
        finally { sc.leased = false; }
    }

    private static JsonDoc ParseInternalWithScratch(byte[] buf, int len, string src, JsonScratch sc) {
        JsonDoc doc = new JsonDoc();
        doc.src = src;
        doc.buf = buf;
        JsonDoc.ParseDocument(doc, len, sc, false);

        // A persistent document cannot hold arrays that the next lease may overwrite.
        if (doc.slots == sc.slots || doc.slots.Length != doc.slotCount) {
            JsonSlot[] slots = new JsonSlot[doc.slotCount];
            JsonDoc.CopyTape((nint)slots, (nint)doc.slots, (long)doc.slotCount * sizeof(JsonSlot));
            doc.slots = slots;
        }
        if (doc.pairs == sc.pairs || doc.pairs.Length != doc.pairCount) {
            JsonPair[] pairs = new JsonPair[doc.pairCount];
            if (doc.pairCount > 0) {
                JsonDoc.CopyTape((nint)pairs, (nint)doc.pairs, (long)doc.pairCount * sizeof(JsonPair));
            }
            doc.pairs = pairs;
        }
        return doc;
    }

    private static void ParseDocument(JsonDoc doc, int len, JsonScratch sc, bool deferEscapes) {
        long result = JsonDoc.ParseTape(doc.buf, len, sc.slots, sc.slots.Length, sc.pairs, sc.pairs.Length,
        sc.fr, sc.counts, doc, deferEscapes);
        if (result < 0) {
            throw new JsonException("Malformed JSON at position " + Convert.ToString((int)(-1 - result)));
        }
        if (result != 0) { throw new JsonException("Invalid JSON parse workspace"); }
        int pos = JsonScan.SkipWhitespace((nint)doc.buf, (int)sc.counts[2], len);
        if (pos < len) {
            throw new JsonException("Malformed JSON at position " + Convert.ToString(pos));
        }
        doc.slotCount = (int)sc.counts[0];
        doc.pairCount = (int)sc.counts[1];

        // Keep modest growth reusable. Large overflow arrays belong to this document only.
        if (doc.slots.Length <= JsonScratch.MaxRetainedSlots) { sc.slots = doc.slots; }
        if (doc.pairs.Length <= JsonScratch.MaxRetainedPairs) { sc.pairs = doc.pairs; }
    }

    private static int NextTapeCapacity(int capacity, int inputLength) {
        // A valid document needs one byte per slot plus a separator or closing
        // delimiter per non-root slot. Grow beyond that estimate on invalid input
        // so the scanner still reports the first syntax error.
        int denseCapacity = inputLength / 2 + inputLength % 2;
        int limit = capacity < denseCapacity ? denseCapacity : inputLength;
        if (capacity >= limit) { throw new JsonException("JSON tape capacity exceeded"); }
        if (capacity == 0) { return 1; }
        return capacity > limit / 2 ? limit : capacity * 2;
    }

    private static int NextEntryCapacity(int capacity, int inputLength, int consumed, int retainedLimit) {
        int next = JsonDoc.NextTapeCapacity(capacity, inputLength);
        int denseLimit = inputLength / 2 + inputLength % 2;
        // The scanned prefix may be denser than the remainder. Bound speculative
        // capacity to one doubling past the retention limit and grow normally beyond it.
        int estimateLimit = Math.Min(denseLimit, retainedLimit * 2 + 1);
        if (consumed == 0 || next >= estimateLimit) { return next; }
        long estimate = (long)capacity * inputLength / consumed + 1L;
        if (estimate > estimateLimit) { estimate = estimateLimit; }
        return estimate > next ? (int)estimate : next;
    }

    private static void CopyTape(nint destination, nint source, long bytes) {
        while (bytes > int.MaxValue) {
            NativeMemory.Copy(destination, source, int.MaxValue);
            destination = destination + (nint)int.MaxValue;
            source = source + (nint)int.MaxValue;
            bytes = bytes - int.MaxValue;
        }
        NativeMemory.Copy(destination, source, (int)bytes);
    }

    private static int[] GrowFrames(int[] frames, int depth, int inputLength) {
        int capacity = JsonDoc.NextTapeCapacity(frames.Length / 4, Math.Min(inputLength, int.MaxValue / 4));
        int[] grown = new int[capacity * 4];
        if (depth > 0) {
            JsonDoc.CopyTape((nint)grown, (nint)frames, (long)depth * 4 * sizeof(int));
        }
        return grown;
    }

    public static long ParsePureFast(byte[] buf, int len, JsonSlot[] sl, int slotCap, JsonPair[] pr, int pairCap, int[] fr, long[] counts) {
        long result = JsonDoc.ParseTape(buf, len, sl, slotCap, pr, pairCap, fr, counts, null, false);
        return result > 0 ? -1L - result : result;
    }

    // 0 = success, 1 = escape pooling disabled, 2 = insufficient fixed workspace.
    // With a document, tape arrays may grow. Syntax errors report -(position + 1).
    private static long ParseTape(byte[] buf, int len, JsonSlot[] sl, int slotCap, JsonPair[] pr, int pairCap, int[] fr, long[] counts, JsonDoc doc, bool deferEscapes) {
        if (buf == null || len < 0 || len > buf.Length || sl == null || pr == null
        || slotCap < 0 || slotCap > sl.Length || pairCap < 0 || pairCap > pr.Length
        || fr == null || counts == null || counts.Length < 3) {
            throw new JsonException("Invalid JSON parse workspace");
        }
        int slotCount = 0;
        int pairCount = 0;
        nint input = (nint)buf;
        int frameCapacity = fr.Length / 4;
        int maxd = JsonDoc.MaxDepth;
        int depth = 0;
        int deepest = 0;
        int pbase = -4;
        bool wantKey = false;
        StringBuilder escaped = null;
        int pos = 0;

        while (true) {
            if (pos < len && (buf[pos] & 255) <= 32) {
                pos = JsonScan.SkipWhitespace(input, pos, len);
            }
            if (pos >= len) { break; }
            int c = buf[pos] & 255;

            if (wantKey) {
                if (c != 34) { return (long)(-1 - pos); }
                int p2 = pos + 1;
                int start = p2;
                int res = JsonScan.StringEnd(input, p2, len);
                if (res >= len) { return (long)(-1 - len); }
                if (pairCount >= pairCap) {
                    if (doc == null) { return 2L; }
                    pairCap = JsonDoc.NextEntryCapacity(pairCap, len, pos, JsonScratch.MaxRetainedPairs);
                    JsonPair[] grown = new JsonPair[pairCap];
                    if (pairCount > 0) {
                        JsonDoc.CopyTape((nint)grown, (nint)pr, (long)pairCount * sizeof(JsonPair));
                    }
                    pr = grown;
                }
                int pi = pairCount;
                pairCount = pairCount + 1;
                if (res < 0) {
                    if (doc == null) { return 1L; }
                    pos = doc.ReadEscaped(buf, len, start, -1 - res, ref escaped);
                    if (pos < 0) { return (long)pos; }
                    pr[pi].keyStart = -1;
                    pr[pi].keyLen = doc.escPool.Count - 1;
                } else {
                    pr[pi].keyStart = start;
                    pr[pi].keyLen = res - start;
                    pos = res + 1;
                }
                pr[pi].nextPair = -1;

                if (fr[pbase + 3] >= 0) {
                    pr[fr[pbase + 3]].nextPair = pi;
                }
                fr[pbase + 3] = pi;
                fr[pbase + 2] = fr[pbase + 2] + 1;

                if (pos < len && (buf[pos] & 255) <= 32) {
                    pos = JsonScan.SkipWhitespace(input, pos, len);
                }
                if (pos >= len || (buf[pos] & 255) != 58) { return (long)(-1 - pos); }
                pos = pos + 1;
                if (pos < len && (buf[pos] & 255) == 32) { pos = pos + 1; }
                wantKey = false;
                continue;
            }

            if (depth > maxd && fr[pbase] == 4) { return (long)(-1 - pos); }

            if (slotCount >= slotCap) {
                if (doc == null) { return 2L; }
                slotCap = JsonDoc.NextEntryCapacity(slotCap, len, pos, JsonScratch.MaxRetainedSlots);
                JsonSlot[] grown = new JsonSlot[slotCap];
                if (slotCount > 0) {
                    JsonDoc.CopyTape((nint)grown, (nint)sl, (long)slotCount * sizeof(JsonSlot));
                }
                sl = grown;
            }
            int vslot = slotCount;
            slotCount = slotCount + 1;
            if (c == 34) {
                int p2 = pos + 1;
                int start = p2;
                int res = JsonScan.StringEnd(input, p2, len);
                if (res >= len) { return (long)(-1 - len); }
                if (res < 0) {
                    if (doc == null) { return 1L; }
                    int escapeAt = -1 - res;
                    if (deferEscapes) {
                        pos = JsonDoc.ValidateEscaped(doc.src, buf, len, escapeAt);
                        if (pos < 0) { return (long)pos; }
                        sl[vslot] = JsonDoc.DeferredStringSlot(start, escapeAt);
                    } else {
                        pos = doc.ReadEscaped(buf, len, start, escapeAt, ref escaped);
                        if (pos < 0) { return (long)pos; }
                        sl[vslot].a = -256L | 3L;
                        sl[vslot].b = (long)(doc.escPool.Count - 1);
                    }
                } else {
                    sl[vslot].a = 3L | ((long)start << 8);
                    sl[vslot].b = (long)(res - start);
                    pos = res + 1;
                }
            } else if (c == 123) {
                int pk = pos + 1;
                if (pk < len && (buf[pk] & 255) <= 32) {
                    pk = JsonScan.SkipWhitespace(input, pk, len);
                }
                if (pk < len && (buf[pk] & 255) == 125) {
                    sl[vslot].a = -251L;
                    sl[vslot].b = 1L << 31;
                    pos = pk + 1;
                } else {
                    if (depth > maxd) { return (long)(-1 - pos); }
                    if (depth >= frameCapacity) {
                        if (doc == null) { return 2L; }
                        fr = JsonDoc.GrowFrames(fr, depth, len);
                        frameCapacity = fr.Length / 4;
                    }
                    sl[vslot].a = 5L | ((long)pairCount << 8);

                    int fo = depth * 4;
                    fr[fo] = 5;
                    fr[fo + 1] = vslot;
                    fr[fo + 2] = 0;
                    fr[fo + 3] = -1;
                    depth = depth + 1;
                    if (depth > deepest) { deepest = depth; }
                    pbase = fo;
                    pos = pos + 1;
                    wantKey = true;
                    continue;
                }
            } else if (c == 91) {
                int pk = pos + 1;
                if (pk < len && (buf[pk] & 255) <= 32) {
                    pk = JsonScan.SkipWhitespace(input, pk, len);
                }
                if (pk < len && (buf[pk] & 255) == 93) {
                    sl[vslot].a = 4L;
                    sl[vslot].b = 1L << 31;
                    pos = pk + 1;
                } else {
                    if (depth > maxd) { return (long)(-1 - pos); }
                    if (depth >= frameCapacity) {
                        if (doc == null) { return 2L; }
                        fr = JsonDoc.GrowFrames(fr, depth, len);
                        frameCapacity = fr.Length / 4;
                    }
                    sl[vslot].a = 4L;

                    int fa = depth * 4;
                    fr[fa] = 4;
                    fr[fa + 1] = vslot;
                    fr[fa + 2] = 0;
                    fr[fa + 3] = -1;
                    depth = depth + 1;
                    if (depth > deepest) { deepest = depth; }
                    pbase = fa;
                    pos = pos + 1;
                    wantKey = false;
                    continue;
                }
            } else if (c == 116) {
                if (len - pos < 4 || buf[pos + 1] != 114 || buf[pos + 2] != 117 || buf[pos + 3] != 101) { return (long)(-1 - pos); }
                sl[vslot].a = 1L;
                sl[vslot].b = 0L;
                pos = pos + 4;
            } else if (c == 102) {
                if (len - pos < 5 || buf[pos + 1] != 97 || buf[pos + 2] != 108 || buf[pos + 3] != 115 || buf[pos + 4] != 101) { return (long)(-1 - pos); }
                sl[vslot].a = 6L;
                sl[vslot].b = 0L;
                pos = pos + 5;
            } else if (c == 110) {
                if (len - pos < 4 || buf[pos + 1] != 117 || buf[pos + 2] != 108 || buf[pos + 3] != 108) { return (long)(-1 - pos); }
                sl[vslot].a = 0L;
                sl[vslot].b = 0L;
                pos = pos + 4;
            } else {
                int ns = pos;
                int ni = pos;
                if (c == 45) { ni = ni + 1; }
                long nacc = 0;
                int ndig = 0;
                while (ni < len) {
                    int d = (buf[ni] & 255) - 48;
                    if (d < 0 || d > 9) { break; }
                    if (ndig < 18) { nacc = nacc * 10 + d; }
                    ndig = ndig + 1;
                    ni = ni + 1;
                }
                bool nok = ndig >= 1;
                bool isInt = nok;
                if (nok && ni < len && (buf[ni] & 255) == 46) {
                    isInt = false;
                    ni = ni + 1;
                    int nfd = 0;
                    while (ni < len) {
                        int d = (buf[ni] & 255) - 48;
                        if (d < 0 || d > 9) { break; }
                        nfd = nfd + 1;
                        ni = ni + 1;
                    }
                    if (nfd == 0) { nok = false; }
                }
                if (nok && ni < len && ((buf[ni] & 255) == 101 || (buf[ni] & 255) == 69)) {
                    isInt = false;
                    ni = ni + 1;
                    if (ni < len && ((buf[ni] & 255) == 43 || (buf[ni] & 255) == 45)) { ni = ni + 1; }
                    int ned = 0;
                    while (ni < len) {
                        int d = (buf[ni] & 255) - 48;
                        if (d < 0 || d > 9) { break; }
                        ned = ned + 1;
                        ni = ni + 1;
                    }
                    if (ned == 0) { nok = false; }
                }
                if (!nok) { return (long)(-1 - ni); }
                if (isInt && ndig <= 18) {
                    if (c == 45) { nacc = 0 - nacc; }
                    sl[vslot].a = 2L;
                    sl[vslot].b = nacc;
                } else {
                    sl[vslot].a = 7L | ((long)ns << 8);
                    sl[vslot].b = (long)(ni - ns);
                }
                pos = ni;
            }

            if (depth == 0) {
                counts[0] = (long)slotCount;
                counts[1] = (long)pairCount;
                counts[2] = (long)pos;
                if (doc != null) { doc.slots = sl; doc.pairs = pr; doc.maxValueDepth = deepest; }
                return 0L;
            }

            if (fr[pbase] == 4) {
                fr[pbase + 2] = fr[pbase + 2] + 1;
            } else {
                pr[fr[pbase + 3]].valueSlot = vslot;
            }

            while (true) {
                if (pos < len && (buf[pos] & 255) <= 32) {
                    pos = JsonScan.SkipWhitespace(input, pos, len);
                }
                if (pos >= len) { return (long)(-1 - pos); }
                c = buf[pos] & 255;
                if (c == 44) {
                    pos = pos + 1;
                    if (pos < len && (buf[pos] & 255) == 32) { pos = pos + 1; }
                    wantKey = fr[pbase] == 5;
                    break;
                }
                int close = fr[pbase] == 4 ? 93 : 125;
                if (c != close) { return (long)(-1 - pos); }
                pos = pos + 1;
                int ms2 = fr[pbase + 1];
                sl[ms2].b = (long)fr[pbase + 2] | ((long)(slotCount - ms2) << 31);
                depth = depth - 1;
                pbase = pbase - 4;
                if (depth == 0) {
                    counts[0] = (long)slotCount;
                    counts[1] = (long)pairCount;
                    counts[2] = (long)pos;
                    if (doc != null) { doc.slots = sl; doc.pairs = pr; doc.maxValueDepth = deepest; }
                    return 0L;
                }
                if (fr[pbase] == 4) {
                    fr[pbase + 2] = fr[pbase + 2] + 1;
                } else {
                    pr[fr[pbase + 3]].valueSlot = ms2;
                }
            }
        }
        return (long)(-1 - pos);
    }

    // 熔合解析核心：单函数显式状态机。
    // 深度语义：容器嵌套以 MaxDepth 封顶（推栈时检查）。
    // 值完成后就地记账并级联处理分隔符与逐层收口，仅对象"要键"时
    // 切 wantKey 布尔，空容器走免推栈快路径。
    // 错误 -(位置+1) 为首错位置。
    public static int ParseCore(List<JsonSlot> sl, List<JsonPair> pr,
    List<string> pool, string src, byte[] buf, int len) {
        return JsonDoc.ParseCoreValues(sl, pr, pool, src, buf, len, false);
    }

    private static int ParseCoreValues(List<JsonSlot> sl, List<JsonPair> pr,
    List<string> pool, string src, byte[] buf, int len, bool deferEscapes) {
        // 容器栈：每层 4 个 int——kind(4/5)、容器槽下标、已收子元素
        // 数、最后一个键值对下标（对象用，数组恒 -1）。深度可瞬时
        // 到 MaxDepth+1（第 513 层容器可进、其内容必错，与旧递归
        // 实现的边界语义一致），栈容量多留一层。
        int[] fr = new int[(JsonDoc.MaxDepth + 2) * 4];
        StringBuilder escaped = null;
        int maxd = JsonDoc.MaxDepth;
        int depth = 0;
        int pbase = -4;  // 栈顶帧基下标 = (depth-1)*4
        bool wantKey = false;  // 对象帧期待键（其余情况恒 false）
        int pos = 0;
        while (true) {
            pos = JsonScan.SkipWhitespace((nint)buf, pos, len);
            if (pos >= len) { return -1 - pos; }
            int c = buf[pos] & 255;
            if (wantKey) {
                // ---- 对象键：'"' + SIMD 扫描 + ':' ----
                if (c != 34) { return -1 - pos; }
                pos = JsonDoc.ScanObjectKey(pr, pool, src, buf, len, pos, pbase, fr, ref escaped);
                if (pos < 0) { return pos; }
                pos = JsonScan.SkipWhitespace((nint)buf, pos, len);
                if (pos >= len || buf[pos] != 58) { return -1 - pos; }
                pos = pos + 1;
                wantKey = false;
                continue;
            }
            // ---- 值分派 ----
            // 标量深度对齐：数组元素在 depth > MaxDepth 时报错，对象成员走内联分派
            // （depth==0 短路不读）。
            if (depth > maxd && fr[pbase] == 4) { return -1 - pos; }
            int vslot;
            if (c == 34) {
                // ---- 字符串值：SIMD 向量查找闭引号与转义符 ----
                int p2 = pos + 1;
                int start = p2;
                int res = JsonScan.StringEnd((nint)buf, p2, len);
                if (res >= 0 && res < len) {
                    int q = (int)res;
                    JsonSlot ts = new JsonSlot();
                    ts.a = (long)3 | ((long)start << 8);
                    ts.b = (long)(q - start);
                    sl.Add(ts);
                    pos = q + 1;
                    vslot = sl.Count - 1;
                } else if (res < 0) {
                    int esc = -1 - res;
                    int pe;
                    if (deferEscapes) {
                        pe = JsonDoc.ValidateEscaped(src, buf, len, esc);
                        if (pe < 0) { return pe; }
                        sl.Add(JsonDoc.DeferredStringSlot(start, esc));
                    } else {
                        pe = JsonDoc.DecodeEscaped(pool, src, buf, len, start, esc, ref escaped);
                        if (pe < 0) { return pe; }
                        JsonSlot ts2 = new JsonSlot();
                        ts2.a = -256L | 3L;
                        ts2.b = (long)(pool.Count - 1);
                        sl.Add(ts2);
                    }
                    pos = pe;
                    vslot = sl.Count - 1;
                } else {
                    return -1 - len;
                }
            } else if (c == 123) {
                // ---- '{'：先窥探空对象（免推栈快路径）----
                int pk = JsonScan.SkipWhitespace((nint)buf, (pos + 1), len);
                if (pk < len && buf[pk] == 125) {
                    // 空对象：首对下标 -1（链立即终止，避免串进之后
                    // 别的对象的键），b = 1<<31。
                    JsonSlot te = new JsonSlot();
                    te.a = (long)5 | ((long)-1 << 8);
                    te.b = (long)1 << 31;
                    sl.Add(te);
                    pos = pk + 1;
                    vslot = sl.Count - 1;
                } else {
                    // 非空对象：推帧。深度语义：进入时 depth 可到
                    // maxd（第 513 层容器可进、其内容必错）。
                    if (depth > maxd) { return -1 - pos; }
                    JsonSlot to = new JsonSlot();
                    to.a = (long)5 | ((long)pr.Count << 8);
                    sl.Add(to);
                    int fo = depth * 4;
                    fr[fo] = 5;
                    fr[fo + 1] = sl.Count - 1;
                    fr[fo + 2] = 0;
                    fr[fo + 3] = -1;
                    depth = depth + 1;
                    pbase = fo;
                    pos = pos + 1;
                    wantKey = true;
                    continue;
                }
            } else if (c == 91) {
                // ---- '['：先窥探空数组（免推栈快路径）----
                int pk = JsonScan.SkipWhitespace((nint)buf, (pos + 1), len);
                if (pk < len && buf[pk] == 93) {
                    JsonSlot te2 = new JsonSlot();
                    te2.a = 4;
                    te2.b = (long)1 << 31;
                    sl.Add(te2);
                    pos = pk + 1;
                    vslot = sl.Count - 1;
                } else {
                    if (depth > maxd) { return -1 - pos; }
                    JsonSlot ta = new JsonSlot();
                    ta.a = 4;
                    sl.Add(ta);
                    int fa = depth * 4;
                    fr[fa] = 4;
                    fr[fa + 1] = sl.Count - 1;
                    fr[fa + 2] = 0;
                    fr[fa + 3] = -1;
                    depth = depth + 1;
                    pbase = fa;
                    pos = pos + 1;
                    wantKey = false;
                    continue;
                }
            } else if (c == 116) {
                if (len - pos < 4 || buf[pos + 1] != 114 || buf[pos + 2] != 117 || buf[pos + 3] != 101) { return -1 - pos; }
                JsonSlot tt = new JsonSlot();
                tt.a = 1;
                sl.Add(tt);
                pos = pos + 4;
                vslot = sl.Count - 1;
            } else if (c == 102) {
                if (len - pos < 5 || buf[pos + 1] != 97 || buf[pos + 2] != 108 || buf[pos + 3] != 115 || buf[pos + 4] != 101) {
                    return -1 - pos;
                }
                JsonSlot tf = new JsonSlot();
                tf.a = 6;
                sl.Add(tf);
                pos = pos + 5;
                vslot = sl.Count - 1;
            } else if (c == 110) {
                if (len - pos < 4 || buf[pos + 1] != 117 || buf[pos + 2] != 108 || buf[pos + 3] != 108) { return -1 - pos; }
                JsonSlot tn = new JsonSlot();
                tn.a = 0;
                sl.Add(tn);
                pos = pos + 4;
                vslot = sl.Count - 1;
            } else {
                int ns = pos;
                int ni = pos;
                if (c == 45) { ni = ni + 1; }
                long nacc = 0;
                int ndig = 0;
                while (ni < len) {
                    int d = (buf[ni] & 255) - 48;
                    if (d < 0 || d > 9) { break; }
                    if (ndig < 18) { nacc = nacc * 10 + d; }
                    ndig = ndig + 1;
                    ni = ni + 1;
                }
                bool nok = ndig >= 1;
                bool nisInt = nok;
                if (nok && ni < len && (buf[ni] & 255) == 46) {
                    nisInt = false;
                    ni = ni + 1;
                    int nfd = 0;
                    while (ni < len) {
                        int d = (buf[ni] & 255) - 48;
                        if (d < 0 || d > 9) { break; }
                        nfd = nfd + 1;
                        ni = ni + 1;
                    }
                    if (nfd == 0) { nok = false; }
                }
                if (nok && ni < len && ((buf[ni] & 255) == 101 || (buf[ni] & 255) == 69)) {
                    nisInt = false;
                    ni = ni + 1;
                    if (ni < len && ((buf[ni] & 255) == 43 || (buf[ni] & 255) == 45)) { ni = ni + 1; }
                    int ned = 0;
                    while (ni < len) {
                        int d = (buf[ni] & 255) - 48;
                        if (d < 0 || d > 9) { break; }
                        ned = ned + 1;
                        ni = ni + 1;
                    }
                    if (ned == 0) { nok = false; }
                }
                if (!nok) { return -1 - ni; }
                JsonSlot tn2 = new JsonSlot();
                if (nisInt && ndig <= 18) {
                    if (c == 45) { nacc = 0 - nacc; }
                    tn2.a = 2;
                    tn2.b = nacc;
                } else {
                    tn2.a = 7L | ((long)ns << 8);
                    tn2.b = (long)(ni - ns);
                }
                sl.Add(tn2);
                pos = ni;
                vslot = sl.Count - 1;
            }
            // ---- 值完成：父帧记账（顶层值即文档完）----
            if (depth == 0) { return pos; }
            if (fr[pbase] == 4) {
                fr[pbase + 2] = fr[pbase + 2] + 1;
            } else {
                pr[fr[pbase + 3]].valueSlot = vslot;
            }
            // ---- 分隔级联：逗号继续取值/键，收口逐层向上 ----
            while (true) {
                pos = JsonScan.SkipWhitespace((nint)buf, pos, len);
                if (pos >= len) { return -1 - pos; }
                c = buf[pos] & 255;
                if (c == 44) {
                    pos = pos + 1;
                    if (pos < len && (buf[pos] & 255) == 32) { pos = pos + 1; }
                    wantKey = fr[pbase] == 5;
                    break;
                }
                int close = fr[pbase] == 4 ? 93 : 125;
                if (c != close) { return -1 - pos; }
                pos = pos + 1;
                int ms2 = fr[pbase + 1];
                sl[ms2].b = (long)fr[pbase + 2]
                | ((long)(sl.Count - ms2) << 31);
                depth = depth - 1;
                pbase = pbase - 4;
                if (depth == 0) { return pos; }
                // 收口的容器是父帧的值：
                if (fr[pbase] == 4) {
                    fr[pbase + 2] = fr[pbase + 2] + 1;
                } else {
                    pr[fr[pbase + 3]].valueSlot = ms2;
                }
            }
            continue;
        }
    }

    // 对象键 token 扫描（起始引号在 pos）：SIMD 向量查找闭引号与转义符。
    public static int ScanKey(List<JsonSlot> sl, List<JsonPair> pr,
    List<string> pool, string src, byte[] buf, int len, int pos,
    int pbase, int[] fr) {
        StringBuilder escaped = null;
        return JsonDoc.ScanObjectKey(pr, pool, src, buf, len, pos, pbase, fr, ref escaped);
    }

    private static int ScanObjectKey(List<JsonPair> pr, List<string> pool, string src, byte[] buf, int len, int pos, int pbase, int[] fr, ref StringBuilder escaped) {
        int p2 = pos + 1;
        int start = p2;
        int res = JsonScan.StringEnd((nint)buf, p2, len);
        int q = -1;
        int esc = -1;
        if (res >= 0 && res < len) {
            q = (int)res;
        } else if (res < 0) {
            esc = (int)(-1 - res);
        } else {
            return -1 - len;
        }
        JsonPair pair = new JsonPair();
        pair.nextPair = -1;
        pair.valueSlot = -1;
        if (q >= 0) {
            pair.keyStart = start;
            pair.keyLen = q - start;
            pos = q + 1;
        } else {
            int pe = JsonDoc.DecodeEscaped(pool, src, buf, len, start, esc, ref escaped);
            if (pe < 0) { return pe; }
            pair.keyStart = -1;
            pair.keyLen = pool.Count - 1;
            pos = pe;
        }
        pr.Add(pair);
        int pi = pr.Count - 1;
        if (fr[pbase + 3] >= 0) { pr[fr[pbase + 3]].nextPair = pi; }
        fr[pbase + 3] = pi;
        fr[pbase + 2] = fr[pbase + 2] + 1;
        return pos;
    }

    private int ReadEscaped(byte[] buf, int len, int start, int escapeAt, ref StringBuilder escaped) {
        if (this.escPool == null) { this.escPool = new List<string>(); }
        return JsonDoc.DecodeEscaped(this.escPool, this.src, buf, len, start, escapeAt, ref escaped);
    }

    // 转义 token 物化：前缀 (start..esc) 原文进池，再从 esc（首个
    // 反斜杠位置）扫到闭引号，解码全部转义（含 \uXXXX 与代理对）。
    // 返回闭引号后位置或 -(错误位置+1)；调用方以 pool.Count-1 取本
    // 串下标。值与键共用，冷路径。
    public static int EscStringInto(List<string> pool, string src, byte[] buf,
    int len, int start, int esc) {
        StringBuilder escaped = null;
        return JsonDoc.DecodeEscaped(pool, src, buf, len, start, esc, ref escaped);
    }

    private static int DecodeEscaped(List<string> pool, string src, byte[] buf, int len, int start, int esc, ref StringBuilder escaped) {
        // ToString copies the result into the pool, so the next token can reuse the builder.
        if (escaped == null) { escaped = new StringBuilder(); }
        StringBuilder sb = escaped;
        sb.Clear();
        if (esc > start) { sb.Append(new StringView((nint)src + (nint)start, esc - start)); }
        int pos = esc;
        while (pos < len) {
            int c = buf[pos] & 255;
            if (c == 34) {
                pos = pos + 1;
                string decoded = sb.ToString();
                pool.Add(decoded);
                // Release large buffers once their token has been copied to the pool.
                if (decoded.Length > JsonScan.MaxRetainedEscapeBytes) { escaped = null; }
                return pos;
            }
            if (c == 92 && pos + 1 < len) {
                int n2 = buf[pos + 1] & 255;
                if (n2 == 110) { sb.Append("\n"); }
                else if (n2 == 116) { sb.Append("\t"); }
                else if (n2 == 114) { sb.Append("\r"); }
                else if (n2 == 34) { sb.Append("\""); }
                else if (n2 == 92) { sb.Append("\\"); }
                else if (n2 == 47) { sb.Append("/"); }
                else if (n2 == 98) { sb.Append("\u0008"); }
                else if (n2 == 102) { sb.Append("\u000c"); }
                else if (n2 == 117) {
                    int escStart = pos;
                    pos = pos + 2;
                    int cp = JsonScan.Hex4(src, pos, len);
                    if (cp < 0) { return -1 - escStart; }
                    pos = pos + 4;
                    if (cp >= 55296 && cp <= 56319 && pos + 5 < len
                    && (buf[pos] & 255) == 92 && (buf[pos + 1] & 255) == 117) {
                        int lo = JsonScan.Hex4(src, pos + 2, len);
                        if (lo >= 56320 && lo <= 57343) {
                            cp = 65536 + ((cp - 55296) << 10) + (lo - 56320);
                            pos = pos + 6;
                        }
                    }
                    sb.Append(Encoding.Utf8FromCodePoint(cp));
                    continue;
                }
                else {
                    return -1 - pos;
                }
                pos = pos + 2;
            } else {
                int scan = JsonScan.StringEnd((nint)buf, pos, len);
                int stop2 = scan < 0 ? -1 - scan : scan;
                // stop2==pos 说明当前字节是 '\' 但已到末尾（pos+1==len），直接报错收口。
                if (stop2 == pos) { return -1 - pos; }
                sb.Append(new StringView((nint)src + (nint)pos, stop2 - pos));
                pos = stop2;
            }
        }
        return -1 - pos;
    }

    // Scan only escape syntax and the closing quote. Surrogate handling belongs to decoding.
    private static int ValidateEscaped(string src, byte[] buf, int len, int escapeAt) {
        nint address = (nint)buf;
        while (true) {
            if (len - escapeAt < 2) { return -1 - escapeAt; }
            int code = buf[escapeAt + 1] & 255;
            int end = escapeAt + 2;
            if (code == 117) {
                if (JsonScan.Hex4(src, end, len) < 0) { return -1 - escapeAt; }
                end = end + 4;
            } else if (code != 34 && code != 47 && code != 92 && code != 98
            && code != 102 && code != 110 && code != 114 && code != 116) {
                return -1 - escapeAt;
            }
            int next = JsonScan.StringEnd(address, end, len);
            if (next >= 0) { return next < len ? next + 1 : -1 - len; }
            escapeAt = -1 - next;
        }
    }

    private static JsonSlot DeferredStringSlot(int start, int escapeAt) {
        JsonSlot slot = new JsonSlot();
        slot.a = ((long)JsonDoc.DeferredEscape << 8) | 3L;
        slot.b = ((long)start << 32) | (long)escapeAt;
        return slot;
    }

    private string DecodeDeferredStringAt(int at) {
        long payload = this.slots[at].b;
        if (this.escPool == null) { this.escPool = new List<string>(); }
        StringBuilder builder = this.deferredEscapeBuilder;
        int pos = JsonDoc.DecodeEscaped(this.escPool, this.src, this.buf, this.src.Length,
        (int)(payload >> 32), (int)payload, ref builder);
        if (pos < 0) { throw new JsonException("Malformed JSON at position " + Convert.ToString(-1 - pos)); }
        this.deferredEscapeBuilder = builder;
        int index = this.escPool.Count - 1;
        this.slots[at].b = (long)index;
        this.slots[at].a = -256L | 3L;
        return this.escPool[index];
    }

    // 就地解析 [from, to) 的浮点 token。运算顺序与
    // JsonValue.DoubleOf 完全一致（long 尾数 + 精确 10 的幂表一次
    // 缩放），结果位级相同。
    public static double DoubleInRange(byte[] buf, int from, int to) {
        int i = from;
        bool neg = false;
        if (i < to && (buf[i] & 255) == 45) { neg = true; i = i + 1; }
        else if (i < to && (buf[i] & 255) == 43) { i = i + 1; }
        long mant = 0;
        int exp10 = 0;
        bool roundUp = false;
        bool seenDigit = false;
        while (i < to) {
            int d = (buf[i] & 255) - 48;
            if (d < 0 || d > 9) { break; }
            seenDigit = true;
            if (mant < 100000000000000000) {
                mant = mant * 10 + d;
            } else {
                if (!roundUp && d >= 5) { roundUp = true; }
                exp10 = exp10 + 1;
            }
            i = i + 1;
        }
        if (i < to && (buf[i] & 255) == 46) {
            i = i + 1;
            while (i < to) {
                int d = (buf[i] & 255) - 48;
                if (d < 0 || d > 9) { break; }
                seenDigit = true;
                if (mant < 100000000000000000) {
                    mant = mant * 10 + d;
                    exp10 = exp10 - 1;
                } else {
                    if (!roundUp && d >= 5) { roundUp = true; }
                }
                i = i + 1;
            }
        }
        if (!seenDigit) { return 0.0; }
        if (i < to && ((buf[i] & 255) == 101 || (buf[i] & 255) == 69)) {
            i = i + 1;
            bool eneg = false;
            if (i < to && (buf[i] & 255) == 45) { eneg = true; i = i + 1; }
            else if (i < to && (buf[i] & 255) == 43) { i = i + 1; }
            int ex = 0;
            while (i < to) {
                int d = (buf[i] & 255) - 48;
                if (d < 0 || d > 9) { break; }
                if (ex < 100000000) { ex = ex * 10 + d; }
                i = i + 1;
            }
            if (eneg) { exp10 = exp10 - ex; } else { exp10 = exp10 + ex; }
        }
        if (roundUp) { mant = mant + 1; }
        double v = mant;
        int e = exp10;
        if (e > 350) { e = 350; }
        else if (e < -350) { e = -350; }
        while (e > 22) { v = v * 1e22; e = e - 22; }
        while (e < -22) { v = v / 1e22; e = e + 22; }
        if (e >= 0) {
            v = v * JsonValue.Pow10Tab[e];
        } else {
            v = v / JsonValue.Pow10Tab[0 - e];
        }
        if (neg) {
            if (v == 0.0) { return -0.0; }
            return 0.0 - v;
        }
        return v;
    }

    // 从 `at` 开始的 4 位十六进制值；不足 4 位或含非十六进制
    // 字符时返回 -1。
    public static int Hex4(string src, int at, int limit) {
        return JsonScan.Hex4(src, at, limit);
    }

    // 递归深度上限（与 JsonValue 一致）。
    public static int MaxDepth = 512;

    // 只读遍历、字段提取 (KindAt/Get/IntAt/StrAt)、点分路径 (Path/GetString/GetInt)
    // 与 JSON 序列化 (ToJson/WriteSlot) 见 JsonDoc.Accessors.zan
}
