        }
        string valName = valTi.Name;
        string valKind = valTi.Kind;

        if (valName == "string") {
            Dict<string, string> d = (Dict<string, string>)dictObj;
            List<string> keys = d.Keys;
            for (int i = 0; i < keys.Count; i = i + 1) {
                if (i > 0) { sb.Append(","); }
                string k = keys[i];
                sb.Append("\"");
                Encoding.JsonEscapeTo(sb, k);
                sb.Append("\":");
                string v = d[k];
                if (v == null) { sb.Append("null"); }
                else {
                    sb.Append("\"");
                    Encoding.JsonEscapeTo(sb, v);
                    sb.Append("\"");
                }
            }
        } else if (valName == "int" || valName == "short" || valName == "byte" || valKind == "enum") {
            Dict<string, int> d = (Dict<string, int>)dictObj;
            List<string> keys = d.Keys;
            for (int i = 0; i < keys.Count; i = i + 1) {
                if (i > 0) { sb.Append(","); }
                string k = keys[i];
                sb.Append("\"");
                Encoding.JsonEscapeTo(sb, k);
                sb.Append("\":");
                sb.Append(Convert.ToString(d[k]));
            }
        } else if (valName == "long") {
            Dict<string, long> d = (Dict<string, long>)dictObj;
            List<string> keys = d.Keys;
            for (int i = 0; i < keys.Count; i = i + 1) {
                if (i > 0) { sb.Append(","); }
                string k = keys[i];
                sb.Append("\"");
                Encoding.JsonEscapeTo(sb, k);
                sb.Append("\":");
                sb.Append(Convert.ToString(d[k]));
            }
        } else if (valName == "double" || valName == "float") {
            Dict<string, double> d = (Dict<string, double>)dictObj;
            List<string> keys = d.Keys;
            for (int i = 0; i < keys.Count; i = i + 1) {
                if (i > 0) { sb.Append(","); }
                string k = keys[i];
                sb.Append("\"");
                Encoding.JsonEscapeTo(sb, k);
                sb.Append("\":");
                sb.Append(Convert.ToString(d[k]));
            }
        } else if (valName == "bool") {
            Dict<string, bool> d = (Dict<string, bool>)dictObj;
            List<string> keys = d.Keys;
            for (int i = 0; i < keys.Count; i = i + 1) {
