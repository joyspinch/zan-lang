using System;
using System.Text;

namespace System.Json;

// 工业级 JSON 统一序列化与反序列化入口门面。
// 提供类似 C# / Go / Rust / Java 风格的标准顶层静态接口。
//
// 需要修改 JSON 树时，Deserialize 和 DeserializeLenient 返回 JsonValue。
// 只读查询可用 DeserializeDoc。仅在回调内读取时，JsonDoc.ParseScoped
// 可以复用解析工作区。
// Json.Deserialize<T> 从 JsonDoc 绑定强类型对象，目标类型或其成员为
// JsonValue 时会构建对应的树。
public class JsonSerializer {
    // 将 JsonValue 序列化为紧凑 JSON 文本。
    public static string Serialize(JsonValue val) {
        if (val == null) { return "null"; }
        return val.ToJson();
    }

    // 将 JsonValue 序列化为两空格缩进的美化 JSON 文本。
    public static string SerializePretty(JsonValue val) {
        if (val == null) { return "null"; }
        return val.PrettyToJson();
    }

    // 将 JSON 文本解析为 JsonValue 树；格式非法时抛出 JsonException。
    public static JsonValue Deserialize(string json) {
        if (json == null) { return JsonValue.NewNull(); }
        return JsonValue.Parse(json);
    }

    // 宽松模式解析 JSON 文本；尽力而为容错，不抛出异常。
    public static JsonValue DeserializeLenient(string json) {
        if (json == null) { return JsonValue.NewNull(); }
        return JsonValue.ParseLenient(json);
    }

    // 将 JSON 文本解析为零拷贝平铺 tape 结构的 JsonDoc（适用于极高性能只读查询）。
    public static JsonDoc DeserializeDoc(string json) {
        if (json == null) { return JsonDoc.Parse("null"); }
        return JsonDoc.Parse(json);
    }
}

// 统一标准便捷门面 Json.Serialize<T> 与 Json.Deserialize<T>
// 基于原生 TypeInfo 运行时反射驱动，彻底杜绝编译期代码生成器侵入。
public class Json {
    public static bool IsListType(string name) {
        return name != null && name.Length >= 5 && name.Substring(0, 5) == "List<";
    }

    public static bool IsDictType(string name) {
        return name != null && ((name.Length >= 5 && name.Substring(0, 5) == "Dict<") ||
                                (name.Length >= 11 && name.Substring(0, 11) == "Dictionary<"));
    }

    public static bool IsJsonValueType(string name) {
        return name == "JsonValue" || name == "System.Json.JsonValue";
    }

    public static string Serialize<T>(T obj) {
        if (obj == null) { return "null"; }
        StringBuilder sb = new StringBuilder();
        Json.WriteTo(sb, typeof(T), (object)obj);
        return sb.ToString();
    }

    internal static void WriteTo(StringBuilder sb, TypeInfo ti, object obj) {
        if (obj == null) { sb.Append("null"); return; }
        if (Json.IsJsonValueType(ti.Name) || Json.IsJsonValueType(ti.FullName)) {
            ((JsonValue)obj).WriteTo(sb);
        } else if (Json.IsListType(ti.Name)) {
            Json.SerializeList(sb, ti, obj);
        } else if (Json.IsDictType(ti.Name)) {
            Json.SerializeDict(sb, ti, obj);
        } else {
            Json.SerializeObject(sb, ti, obj);
        }
    }

    public static T Deserialize<T>(string json) {
        if (json == null || json.Length == 0) {
            throw new Exception("Cannot deserialize null or empty JSON string");
        }
        TypeInfo ti = typeof(T);
        if (Json.IsJsonValueType(ti.Name) || Json.IsJsonValueType(ti.FullName)) {
            JsonValue jv = JsonValue.Parse(json);
            return (T)(object)jv;
        }
        return JsonDoc.ParseScoped<T>(json, (doc) => Json.Bind<T>(doc));
    }

    private static T Bind<T>(JsonDoc doc) {
        if (doc == null || doc.slotCount == 0) {
            throw new Exception("Invalid JSON root");
        }
        TypeInfo ti = typeof(T);
        int root = doc.root;
        if (Json.IsListType(ti.Name)) {
            object list = Json.DeserializeList(doc, root, ti);
            return (T)list;
        }
        if (Json.IsDictType(ti.Name)) {
            object dict = Json.DeserializeDict(doc, root, ti);
            return (T)dict;
        }
        object obj = Json.DeserializeObject(doc, root, ti);
        return (T)obj;
    }

    public static void SerializeObject(StringBuilder sb, TypeInfo ti, object obj) {
        if (obj == null) { sb.Append("null"); return; }
        Json.SerializeObjectWithMapping(sb, JsonTypeMapping.Get(ti), obj);
    }

    private static void SerializeObjectWithMapping(StringBuilder sb, JsonTypeMapping mapping, object obj) {
        sb.Append("{");
        List<JsonMemberMapping> fields = mapping.Fields;
        int n = fields.Count;
        for (int i = 0; i < n; i = i + 1) {
            JsonMemberMapping field = fields[i];
            if (i > 0) { sb.Append(","); }
            sb.Append(field.OutputName);
            Json.WriteMember(sb, field.Type, field.Kind, obj, field.FieldName);
        }
        sb.Append("}");
    }

    public static void SerializeMember(StringBuilder sb, TypeInfo fti, string ftype, object target, string fname) {
        Json.WriteMember(sb, fti, JsonMemberMapping.Classify(ftype, fti), target, fname);
    }

    private static void WriteMember(StringBuilder sb, TypeInfo fti, JsonMemberKind kind, object target, string fname) {
        if (kind == JsonMemberKind.String) {
            string s = target.GetFieldString(fname);
            if (s == null) { sb.Append("null"); }
            else {
                sb.Append("\"");
                Encoding.JsonEscapeTo(sb, s);
                sb.Append("\"");
            }
        } else if (kind == JsonMemberKind.Int || kind == JsonMemberKind.UnsignedInt) {
            sb.Append(target.GetFieldInt(fname));
        } else if (kind == JsonMemberKind.Long || kind == JsonMemberKind.UnsignedLong) {
            sb.Append(target.GetFieldLong(fname));
        } else if (kind == JsonMemberKind.Double) {
            sb.Append(Convert.ToString(target.GetFieldDouble(fname)));
        } else if (kind == JsonMemberKind.Bool) {
            sb.Append(target.GetFieldBool(fname) ? "true" : "false");
        } else if (kind == JsonMemberKind.Value) {
            object jvo = target.GetFieldObject(fname);
            if (jvo == null) { sb.Append("null"); }
            else { ((JsonValue)jvo).WriteTo(sb); }
        } else if (kind == JsonMemberKind.List) {
            object listObj = target.GetFieldObject(fname);
            Json.SerializeList(sb, fti, listObj);
        } else if (kind == JsonMemberKind.Dictionary) {
            object dictObj = target.GetFieldObject(fname);
            Json.SerializeDict(sb, fti, dictObj);
        } else {
            object child = target.GetFieldObject(fname);
            if (child == null) { sb.Append("null"); }
            else {
                TypeInfo childTi = child.GetType();
                string cname = childTi.Name;
                if (Json.IsDictType(cname)) {
                    Json.SerializeDict(sb, childTi, child);
                } else if (Json.IsListType(cname)) {
                    Json.SerializeList(sb, childTi, child);
                } else {
                    Json.SerializeObject(sb, childTi, child);
                }
            }
        }
    }

    public static void SerializeList(StringBuilder sb, TypeInfo listTi, object listObj) {
        if (listObj == null) { sb.Append("null"); return; }
        sb.Append("[");
        TypeInfo elemTi = listTi;
        if (listTi.TypeArgCount > 0) {
            elemTi = listTi.GetTypeArg(0);
        }
        string elemName = elemTi.Name;
        string elemKind = elemTi.Kind;

        if (Json.IsListType(elemName)) {
            // Closed List<T> types are invariant. Read through the existing
            // reflection thunks, which retain the actual element representation.
            int count = listObj.InvokeInt("Count");
            for (int r = 0; r < count; r = r + 1) {
                if (r > 0) { sb.Append(","); }
                Json.SerializeList(sb, elemTi, listObj.InvokeObject("Get", r));
            }
        } else if (elemName == "string") {
            List<string> list = (List<string>)listObj;
            for (int j = 0; j < list.Count; j = j + 1) {
                if (j > 0) { sb.Append(","); }
                if (list[j] == null) { sb.Append("null"); }
                else {
                    sb.Append("\"");
                    Encoding.JsonEscapeTo(sb, list[j]);
                    sb.Append("\"");
                }
            }
        } else if (elemName == "int") {
            List<int> list = (List<int>)listObj;
            for (int j = 0; j < list.Count; j = j + 1) {
                if (j > 0) { sb.Append(","); }
                sb.Append(list[j]);
            }
        } else if (elemName == "short" || elemName == "byte" || elemKind == "enum") {
            int count = listObj.InvokeInt("Count");
            for (int j = 0; j < count; j = j + 1) {
                if (j > 0) { sb.Append(","); }
                sb.Append(listObj.InvokeInt("Get", j));
            }
        } else if (elemName == "long") {
            List<long> list = (List<long>)listObj;
            for (int j = 0; j < list.Count; j = j + 1) {
                if (j > 0) { sb.Append(","); }
                sb.Append(list[j]);
            }
        } else if (elemName == "double") {
            List<double> list = (List<double>)listObj;
            for (int j = 0; j < list.Count; j = j + 1) {
                if (j > 0) { sb.Append(","); }
                sb.Append(list[j]);
            }
        } else if (elemName == "float") {
            int count = listObj.InvokeInt("Count");
            for (int j = 0; j < count; j = j + 1) {
                if (j > 0) { sb.Append(","); }
                sb.Append(Convert.ToString(listObj.InvokeDouble("Get", j)));
            }
        } else if (elemName == "bool") {
            List<bool> list = (List<bool>)listObj;
            for (int j = 0; j < list.Count; j = j + 1) {
                if (j > 0) { sb.Append(","); }
                sb.Append(list[j] ? "true" : "false");
            }
        } else if (elemName == "JsonValue") {
            int count = listObj.InvokeInt("Count");
            for (int j = 0; j < count; j = j + 1) {
                if (j > 0) { sb.Append(","); }
                object item = listObj.InvokeObject("Get", j);
                if (item == null) { sb.Append("null"); }
                else { ((JsonValue)item).WriteTo(sb); }
            }
        } else if (Json.IsDictType(elemName)) {
            int count = listObj.InvokeInt("Count");
            for (int j = 0; j < count; j = j + 1) {
                if (j > 0) { sb.Append(","); }
                object item = listObj.InvokeObject("Get", j);
                if (item == null) { sb.Append("null"); }
                else { Json.SerializeDict(sb, elemTi, item); }
            }
        } else {
            int count = listObj.InvokeInt("Count");
            JsonTypeMapping elemMapping = count > 0 ? JsonTypeMapping.Get(elemTi) : null;
            for (int j = 0; j < count; j = j + 1) {
                if (j > 0) { sb.Append(","); }
                object item = listObj.InvokeObject("Get", j);
                if (item == null) { sb.Append("null"); }
                else { Json.SerializeObjectWithMapping(sb, elemMapping, item); }
            }
        }
        sb.Append("]");
    }

    public static void SerializeDict(StringBuilder sb, TypeInfo dictTi, object dictObj) {
        if (dictObj == null) { sb.Append("null"); return; }
        sb.Append("{");
        TypeInfo valTi = dictTi;
        if (dictTi.TypeArgCount > 1) {
            valTi = dictTi.GetTypeArg(1);
        }
        string valName = valTi.Name;
        string valKind = valTi.Kind;

        if (valName == "string") {
            Dict<string, string> d = (Dict<string, string>)dictObj;
            List<string> keys = d.Keys;
            for (int i = 0; i < keys.Count; i = i + 1) {
                if (i > 0) { sb.Append(","); }
                string k = keys[i];
                sb.Append("\"");
                Encoding.JsonEscapeTo(sb, k);
                sb.Append("\":");
                string v = d[k];
                if (v == null) { sb.Append("null"); }
                else {
                    sb.Append("\"");
                    Encoding.JsonEscapeTo(sb, v);
                    sb.Append("\"");
                }
            }
        } else if (valName == "int" || valName == "short" || valName == "byte" || valKind == "enum") {
            Dict<string, int> d = (Dict<string, int>)dictObj;
            List<string> keys = d.Keys;
            for (int i = 0; i < keys.Count; i = i + 1) {
                if (i > 0) { sb.Append(","); }
                string k = keys[i];
                sb.Append("\"");
                Encoding.JsonEscapeTo(sb, k);
                sb.Append("\":");
                sb.Append(d[k]);
            }
        } else if (valName == "long") {
            Dict<string, long> d = (Dict<string, long>)dictObj;
            List<string> keys = d.Keys;
            for (int i = 0; i < keys.Count; i = i + 1) {
                if (i > 0) { sb.Append(","); }
                string k = keys[i];
                sb.Append("\"");
                Encoding.JsonEscapeTo(sb, k);
                sb.Append("\":");
                sb.Append(d[k]);
            }
        } else if (valName == "double" || valName == "float") {
            Dict<string, double> d = (Dict<string, double>)dictObj;
            List<string> keys = d.Keys;
            for (int i = 0; i < keys.Count; i = i + 1) {
                if (i > 0) { sb.Append(","); }
                string k = keys[i];
                sb.Append("\"");
                Encoding.JsonEscapeTo(sb, k);
                sb.Append("\":");
                sb.Append(Convert.ToString(d[k]));
            }
        } else if (valName == "bool") {
            Dict<string, bool> d = (Dict<string, bool>)dictObj;
            List<string> keys = d.Keys;
            for (int i = 0; i < keys.Count; i = i + 1) {
                if (i > 0) { sb.Append(","); }
                string k = keys[i];
                sb.Append("\"");
                Encoding.JsonEscapeTo(sb, k);
                sb.Append("\":");
                sb.Append(d[k] ? "true" : "false");
            }
        } else if (valName == "JsonValue") {
            Dict<string, object> d = (Dict<string, object>)dictObj;
            List<string> keys = d.Keys;
            for (int i = 0; i < keys.Count; i = i + 1) {
                if (i > 0) { sb.Append(","); }
                string k = keys[i];
                sb.Append("\"");
                Encoding.JsonEscapeTo(sb, k);
                sb.Append("\":");
                object v = d[k];
                if (v == null) { sb.Append("null"); }
                else { ((JsonValue)v).WriteTo(sb); }
            }
        } else {
            Dict<string, object> d = (Dict<string, object>)dictObj;
            List<string> keys = d.Keys;
            bool valIsList = Json.IsListType(valName);
            bool valIsDict = Json.IsDictType(valName);
            JsonTypeMapping valMapping = (!valIsList && !valIsDict && keys.Count > 0) ? JsonTypeMapping.Get(valTi) : null;
            for (int i = 0; i < keys.Count; i = i + 1) {
                if (i > 0) { sb.Append(","); }
                string k = keys[i];
                sb.Append("\"");
                Encoding.JsonEscapeTo(sb, k);
                sb.Append("\":");
                object v = d[k];
                if (v == null) {
                    sb.Append("null");
                } else if (valIsList) {
                    Json.SerializeList(sb, valTi, v);
                } else if (valIsDict) {
                    Json.SerializeDict(sb, valTi, v);
                } else {
                    Json.SerializeObjectWithMapping(sb, valMapping, v);
                }
            }
        }
        sb.Append("}");
    }

    public static object DeserializeObject(JsonDoc doc, int at, TypeInfo ti) {
        JsonTypeMapping mapping = null;
        return Json.BindObject(doc, at, ti, ref mapping);
    }

    private static object BindObject(JsonDoc doc, int at, TypeInfo ti, ref JsonTypeMapping mapping) {
        if (at < 0 || at >= doc.slotCount || doc.KindAt(at) != 5) {
            throw new Exception("JSON root must be an object");
        }
        object obj = ti.CreateInstance();
        if (mapping == null) { mapping = JsonTypeMapping.Get(ti); }
        List<JsonMemberMapping> fields = mapping.Fields;
        int[] matches = mapping.MatchProperties(doc, at);
        for (int i = 0; i < fields.Count; i = i + 1) {
            JsonMemberMapping field = fields[i];
            int fv = matches == null ? doc.Get(at, field.JsonName) : matches[i] - 1;
            if (fv < 0) {
                if (field.Required) {
                    throw new Exception("Missing required JSON property: " + field.JsonName);
                }
                if (field.DefaultValue.Length > 0) {
                    Json.SetDefault(obj, field.FieldName, field.Kind, field.DefaultValue);
                }
            } else if (doc.KindAt(fv) != 0) {
                Json.ReadField(obj, field.FieldName, field.Kind, field.Type, doc, fv);
            }
        }
        return obj;
    }

    public static void ApplyFieldDefault(object obj, string fname, string ftype, TypeInfo fti, string dflt) {
        Json.SetDefault(obj, fname, JsonMemberMapping.Classify(ftype, fti), dflt);
    }

    private static void SetDefault(object obj, string fname, JsonMemberKind kind, string dflt) {
        if (kind == JsonMemberKind.String) {
            obj.SetFieldString(fname, dflt);
        } else if (kind == JsonMemberKind.Int) {
            obj.SetFieldInt(fname, Convert.ToInt32(dflt));
        } else if (kind == JsonMemberKind.Long) {
            obj.SetFieldLong(fname, Convert.ToInt64(dflt));
        } else if (kind == JsonMemberKind.Double) {
            obj.SetFieldDouble(fname, Convert.ToDouble(dflt));
        } else if (kind == JsonMemberKind.Bool) {
            obj.SetFieldBool(fname, dflt == "true" || dflt == "1");
        }
    }

    public static void DeserializeField(object obj, string fname, string ftype, TypeInfo fti, JsonDoc doc, int fv) {
        Json.ReadField(obj, fname, JsonMemberMapping.Classify(ftype, fti), fti, doc, fv);
    }

    private static void ReadField(object obj, string fname, JsonMemberKind kind, TypeInfo fti, JsonDoc doc, int fv) {
        if (kind == JsonMemberKind.String) {
            obj.SetFieldString(fname, doc.StrAt(fv, ""));
        } else if (kind == JsonMemberKind.Int) {
            obj.SetFieldInt(fname, doc.IntAt(fv, 0));
        } else if (kind == JsonMemberKind.Long) {
            obj.SetFieldLong(fname, doc.LongAt(fv, 0L));
        } else if (kind == JsonMemberKind.Double) {
            obj.SetFieldDouble(fname, doc.DoubleAt(fv, 0.0));
        } else if (kind == JsonMemberKind.Bool) {
            obj.SetFieldBool(fname, doc.BoolAt(fv, false));
        } else if (kind == JsonMemberKind.Value) {
            obj.SetFieldObject(fname, (object)JsonValue.FromDoc(doc, fv));
        } else if (kind == JsonMemberKind.List) {
            object list = Json.DeserializeList(doc, fv, fti);
            obj.SetFieldObject(fname, list);
        } else if (kind == JsonMemberKind.Dictionary) {
            object dict = Json.DeserializeDict(doc, fv, fti);
            obj.SetFieldObject(fname, dict);
        } else {
            if (doc.KindAt(fv) == 5) {
                object child = Json.DeserializeObject(doc, fv, fti);
                obj.SetFieldObject(fname, child);
            }
        }
    }

    public static object DeserializeDict(JsonDoc doc, int at, TypeInfo dictTi) {
        if (at < 0 || at >= doc.slotCount || doc.KindAt(at) != 5) {
            throw new Exception("JSON root must be an object for Dict");
        }
        TypeInfo valTi = dictTi;
        if (dictTi.TypeArgCount > 1) {
            valTi = dictTi.GetTypeArg(1);
        }
        string valName = valTi.Name;
        string valKind = valTi.Kind;

        if (valName == "string") {
            Dict<string, string> dict = new Dict<string, string>();
            int p = (int)(doc.slots[at].a >> 8);
            while (p >= 0) {
                JsonPair pair = doc.pairs[p];
                string key = pair.keyStart < 0 ? doc.escPool[pair.keyLen] : doc.src.Substring(pair.keyStart, pair.keyLen);
                dict.Add(key, doc.StrAt(pair.valueSlot, ""));
                p = pair.nextPair;
            }
            return (object)dict;
        } else if (valName == "int" || valName == "short" || valName == "byte" || valKind == "enum") {
            Dict<string, int> dict = new Dict<string, int>();
            int p = (int)(doc.slots[at].a >> 8);
            while (p >= 0) {
                JsonPair pair = doc.pairs[p];
                string key = pair.keyStart < 0 ? doc.escPool[pair.keyLen] : doc.src.Substring(pair.keyStart, pair.keyLen);
                dict.Add(key, doc.IntAt(pair.valueSlot, 0));
                p = pair.nextPair;
            }
            return (object)dict;
        } else if (valName == "long") {
            Dict<string, long> dict = new Dict<string, long>();
            int p = (int)(doc.slots[at].a >> 8);
            while (p >= 0) {
                JsonPair pair = doc.pairs[p];
                string key = pair.keyStart < 0 ? doc.escPool[pair.keyLen] : doc.src.Substring(pair.keyStart, pair.keyLen);
                dict.Add(key, doc.LongAt(pair.valueSlot, 0L));
                p = pair.nextPair;
            }
            return (object)dict;
        } else if (valName == "double" || valName == "float") {
            Dict<string, double> dict = new Dict<string, double>();
            int p = (int)(doc.slots[at].a >> 8);
            while (p >= 0) {
                JsonPair pair = doc.pairs[p];
                string key = pair.keyStart < 0 ? doc.escPool[pair.keyLen] : doc.src.Substring(pair.keyStart, pair.keyLen);
                dict.Add(key, doc.DoubleAt(pair.valueSlot, 0.0));
                p = pair.nextPair;
            }
            return (object)dict;
        } else if (valName == "bool") {
            Dict<string, bool> dict = new Dict<string, bool>();
            int p = (int)(doc.slots[at].a >> 8);
            while (p >= 0) {
                JsonPair pair = doc.pairs[p];
                string key = pair.keyStart < 0 ? doc.escPool[pair.keyLen] : doc.src.Substring(pair.keyStart, pair.keyLen);
                dict.Add(key, doc.BoolAt(pair.valueSlot, false));
                p = pair.nextPair;
            }
            return (object)dict;
        } else if (valName == "JsonValue") {
            Dict<string, object> dict = new Dict<string, object>();
            int p = (int)(doc.slots[at].a >> 8);
            while (p >= 0) {
                JsonPair pair = doc.pairs[p];
                string key = pair.keyStart < 0 ? doc.escPool[pair.keyLen] : doc.src.Substring(pair.keyStart, pair.keyLen);
                dict.Add(key, (object)JsonValue.FromDoc(doc, pair.valueSlot));
                p = pair.nextPair;
            }
            return (object)dict;
        } else {
            Dict<string, object> dict = new Dict<string, object>();
            int p = (int)(doc.slots[at].a >> 8);
            while (p >= 0) {
                JsonPair pair = doc.pairs[p];
                string key = pair.keyStart < 0 ? doc.escPool[pair.keyLen] : doc.src.Substring(pair.keyStart, pair.keyLen);
                int vs = pair.valueSlot;
                if (doc.KindAt(vs) == 0) {
                    dict.Add(key, null);
                } else if (Json.IsListType(valName)) {
                    dict.Add(key, Json.DeserializeList(doc, vs, valTi));
                } else if (Json.IsDictType(valName)) {
                    dict.Add(key, Json.DeserializeDict(doc, vs, valTi));
                } else {
                    dict.Add(key, Json.DeserializeObject(doc, vs, valTi));
                }
                p = pair.nextPair;
            }
            return (object)dict;
        }
    }

    public static object DeserializeList(JsonDoc doc, int at, TypeInfo listTi) {
        if (at >= 0 && at < doc.slotCount && doc.KindAt(at) == 0) { return null; }
        object list = listTi.CreateInstance();
        if (list == null) { throw new Exception("Cannot create JSON list: " + listTi.Name); }
        TypeInfo elemTi = listTi;
        if (listTi.TypeArgCount > 0) { elemTi = listTi.GetTypeArg(0); }
        if (at >= 0 && at < doc.slotCount) {
            string elemName = elemTi.Name;
            string elemKind = elemTi.Kind;
            JsonTypeMapping mapping = null;
            if (doc.KindAt(at) == 4) {
                int count = doc.Count(at);
                int child = doc.FirstChild(at);
                if (elemName == "long") {
                    List<long> longs = list as List<long>;
                    if (longs != null) {
                        longs.Reserve(count);
                        for (int i = 0; i < count; i++) {
                            longs.Add(doc.LongAt(child, 0L));
                            child = doc.NextSibling(child);
                        }
                        return list;
                    }
                } else if (elemName == "int") {
                    List<int> ints = list as List<int>;
                    if (ints != null) {
                        ints.Reserve(count);
                        for (int i = 0; i < count; i++) {
                            ints.Add(doc.IntAt(child, 0));
                            child = doc.NextSibling(child);
                        }
                        return list;
                    }
                } else if (elemName == "double") {
                    List<double> dbls = list as List<double>;
                    if (dbls != null) {
                        dbls.Reserve(count);
                        for (int i = 0; i < count; i++) {
                            dbls.Add(doc.DoubleAt(child, 0.0));
                            child = doc.NextSibling(child);
                        }
                        return list;
                    }
                } else if (elemName == "string") {
                    List<string> strs = list as List<string>;
                    if (strs != null) {
                        strs.Reserve(count);
                        for (int i = 0; i < count; i++) {
                            strs.Add(doc.KindAt(child) == 0 ? null : doc.StrAt(child, ""));
                            child = doc.NextSibling(child);
                        }
                        return list;
                    }
                } else if (elemName == "bool") {
                    List<bool> bools = list as List<bool>;
                    if (bools != null) {
                        bools.Reserve(count);
                        for (int i = 0; i < count; i++) {
                            bools.Add(doc.BoolAt(child, false));
                            child = doc.NextSibling(child);
                        }
                        return list;
                    }
                }
                for (int i = 0; i < count; i = i + 1) {
                    Json.BindListItem(list, elemTi, elemName, elemKind, doc, child, ref mapping);
                    child = doc.NextSibling(child);
                }
            } else if (!Json.IsListType(elemName)) {
                // Preserve the existing lenient scalar/object-to-single-item behavior.
                Json.BindListItem(list, elemTi, elemName, elemKind, doc, at, ref mapping);
            }
        }
        return list;
    }

    public static void DeserializeListItem(object list, TypeInfo elemTi, JsonDoc doc, int at) {
        JsonTypeMapping mapping = null;
        Json.BindListItem(list, elemTi, elemTi.Name, elemTi.Kind, doc, at, ref mapping);
    }

    private static void BindListItem(object list, TypeInfo elemTi, string elemName, string elemKind, JsonDoc doc, int at, ref JsonTypeMapping mapping) {
        bool added = false;
        if (elemName == "int" || elemKind == "enum") {
            added = list.Invoke("Add", doc.IntAt(at, 0));
        } else if (elemName == "short") {
            added = list.Invoke("Add", (short)doc.IntAt(at, 0));
        } else if (elemName == "byte") {
            added = list.Invoke("Add", (byte)doc.IntAt(at, 0));
        } else if (elemName == "long") {
            added = list.Invoke("Add", doc.LongAt(at, 0L));
        } else if (elemName == "float") {
            added = list.Invoke("Add", (float)doc.DoubleAt(at, 0.0));
        } else if (elemName == "double") {
            added = list.Invoke("Add", doc.DoubleAt(at, 0.0));
        } else if (elemName == "bool") {
            added = list.Invoke("Add", doc.BoolAt(at, false));
        } else if (doc.KindAt(at) == 0) {
            added = list.Invoke("Add", (object)null);
        } else if (elemName == "string") {
            added = list.Invoke("Add", doc.StrAt(at, ""));
        } else if (Json.IsJsonValueType(elemName)) {
            added = list.Invoke("Add", (object)JsonValue.FromDoc(doc, at));
        } else if (Json.IsListType(elemName)) {
            added = list.Invoke("Add", Json.DeserializeList(doc, at, elemTi));
        } else if (doc.KindAt(at) == 5) {
            if (Json.IsDictType(elemName)) {
                added = list.Invoke("Add", Json.DeserializeDict(doc, at, elemTi));
            } else {
                added = list.Invoke("Add", Json.BindObject(doc, at, elemTi, ref mapping));
            }
        } else {
            return;
        }
        if (!added) { throw new Exception("Cannot append JSON list item: " + elemName); }
    }
}
