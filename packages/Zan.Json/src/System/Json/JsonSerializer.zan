            }
        } else if (valName == "JsonValue") {
            Dict<string, object> d = (Dict<string, object>)dictObj;
            List<string> keys = d.Keys;
            for (int i = 0; i < keys.Count; i = i + 1) {
                if (i > 0) { sb.Append(","); }
                string k = keys[i];
                sb.Append("\"");
                Encoding.JsonEscapeTo(sb, k);
                sb.Append("\":");
                object v = d[k];
                if (v == null) { sb.Append("null"); }
                else { sb.Append(((JsonValue)v).ToJson()); }
            }
        } else {
            Dict<string, object> d = (Dict<string, object>)dictObj;
            List<string> keys = d.Keys;
            for (int i = 0; i < keys.Count; i = i + 1) {
                if (i > 0) { sb.Append(","); }
                string k = keys[i];
                sb.Append("\"");
                Encoding.JsonEscapeTo(sb, k);
                sb.Append("\":");
