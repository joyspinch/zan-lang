    public static object DeserializeObject(JsonDoc doc, int at, TypeInfo ti) {
        if (at < 0 || at >= doc.slotCount || doc.KindAt(at) != 5) {
            throw new Exception("JSON root must be an object");
        }
        object obj = ti.CreateInstance();
        int count = ti.FieldCount;
        for (int i = 0; i < count; i = i + 1) {
            if (ti.IsFieldIgnored(i)) { continue; }
            string fname = ti.GetFieldName(i);
            string ftype = ti.GetFieldType(i);
            TypeInfo fti = ti.GetFieldTypeInfo(i);
            string jsonKey = ti.GetFieldCustomName(i);
            if (jsonKey.Length == 0) { jsonKey = fname; }
            int fv = doc.Get(at, jsonKey);
            if (ti.IsFieldRequired(i) && fv < 0) {
                throw new Exception("Missing required JSON property: " + jsonKey);
            }
            if (fv < 0) {
                string dflt = ti.GetFieldDefault(i);
                if (dflt.Length > 0) {
                    Json.ApplyFieldDefault(obj, fname, ftype, fti, dflt);
                }
                continue;
            }
            if (doc.KindAt(fv) == 0) { continue; }
            Json.DeserializeField(obj, fname, ftype, fti, doc, fv);
        }
        return obj;
    }

    public static void ApplyFieldDefault(object obj, string fname, string ftype, TypeInfo fti, string dflt) {
        if (ftype == "string") {
            obj.SetFieldString(fname, dflt);
        } else if (ftype == "int" || ftype == "short" || ftype == "byte" || fti.Kind == "enum") {
            obj.SetFieldInt(fname, Convert.ToInt32(dflt));
        } else if (ftype == "long") {
            obj.SetFieldLong(fname, Convert.ToInt64(dflt));
        } else if (ftype == "double" || ftype == "float") {
            obj.SetFieldDouble(fname, Convert.ToDouble(dflt));
        } else if (ftype == "bool") {
            obj.SetFieldBool(fname, dflt == "true" || dflt == "1");
        }
    }

    public static void DeserializeField(object obj, string fname, string ftype, TypeInfo fti, JsonDoc doc, int fv) {
        if (ftype == "string") {
            obj.SetFieldString(fname, doc.StrAt(fv, ""));
        } else if (ftype == "int" || ftype == "short" || ftype == "byte" || fti.Kind == "enum") {
            obj.SetFieldInt(fname, doc.IntAt(fv, 0));
        } else if (ftype == "long") {
            obj.SetFieldLong(fname, doc.LongAt(fv, 0L));
        } else if (ftype == "double" || ftype == "float") {
            obj.SetFieldDouble(fname, doc.DoubleAt(fv, 0.0));
        } else if (ftype == "bool") {
            obj.SetFieldBool(fname, doc.BoolAt(fv, false));
        } else if (Json.IsJsonValueType(ftype)) {
            obj.SetFieldObject(fname, (object)JsonValue.FromDoc(doc, fv));
        } else if (Json.IsListType(ftype)) {
            object list = Json.DeserializeList(doc, fv, fti);
            obj.SetFieldObject(fname, list);
        } else if (Json.IsDictType(ftype)) {
            object dict = Json.DeserializeDict(doc, fv, fti);
            obj.SetFieldObject(fname, dict);
        } else {
            if (doc.KindAt(fv) == 5) {
                object child = Json.DeserializeObject(doc, fv, fti);
                obj.SetFieldObject(fname, child);
            }
        }
    }

    public static object DeserializeDict(JsonDoc doc, int at, TypeInfo dictTi) {
        if (at < 0 || at >= doc.slotCount || doc.KindAt(at) != 5) {
            throw new Exception("JSON root must be an object for Dict");
        }
        TypeInfo valTi = dictTi;
        if (dictTi.TypeArgCount > 1) {
            valTi = dictTi.GetTypeArg(1);
        }
        string valName = valTi.Name;
        string valKind = valTi.Kind;

        if (valName == "string") {
            Dict<string, string> dict = new Dict<string, string>();
            int p = (int)(doc.slots[at].a >> 8);
            while (p >= 0) {
                JsonPair pair = doc.pairs[p];
                string key = pair.keyStart < 0 ? doc.escPool[pair.keyLen] : doc.src.Substring(pair.keyStart, pair.keyLen);
                dict.Add(key, doc.StrAt(pair.valueSlot, ""));
                p = pair.nextPair;
            }
            return (object)dict;
        } else if (valName == "int" || valName == "short" || valName == "byte" || valKind == "enum") {
            Dict<string, int> dict = new Dict<string, int>();
            int p = (int)(doc.slots[at].a >> 8);
            while (p >= 0) {
                JsonPair pair = doc.pairs[p];
                string key = pair.keyStart < 0 ? doc.escPool[pair.keyLen] : doc.src.Substring(pair.keyStart, pair.keyLen);
                dict.Add(key, doc.IntAt(pair.valueSlot, 0));
                p = pair.nextPair;
            }
            return (object)dict;
        } else if (valName == "long") {
            Dict<string, long> dict = new Dict<string, long>();
            int p = (int)(doc.slots[at].a >> 8);
            while (p >= 0) {
                JsonPair pair = doc.pairs[p];
                string key = pair.keyStart < 0 ? doc.escPool[pair.keyLen] : doc.src.Substring(pair.keyStart, pair.keyLen);
                dict.Add(key, doc.LongAt(pair.valueSlot, 0L));
                p = pair.nextPair;
            }
            return (object)dict;
        } else if (valName == "double" || valName == "float") {
            Dict<string, double> dict = new Dict<string, double>();
            int p = (int)(doc.slots[at].a >> 8);
            while (p >= 0) {
                JsonPair pair = doc.pairs[p];
                string key = pair.keyStart < 0 ? doc.escPool[pair.keyLen] : doc.src.Substring(pair.keyStart, pair.keyLen);
                dict.Add(key, doc.DoubleAt(pair.valueSlot, 0.0));
                p = pair.nextPair;
            }
            return (object)dict;
        } else if (valName == "bool") {
            Dict<string, bool> dict = new Dict<string, bool>();
            int p = (int)(doc.slots[at].a >> 8);
            while (p >= 0) {
                JsonPair pair = doc.pairs[p];
                string key = pair.keyStart < 0 ? doc.escPool[pair.keyLen] : doc.src.Substring(pair.keyStart, pair.keyLen);
                dict.Add(key, doc.BoolAt(pair.valueSlot, false));
                p = pair.nextPair;
            }
            return (object)dict;
        } else if (valName == "JsonValue") {
            Dict<string, object> dict = new Dict<string, object>();
            int p = (int)(doc.slots[at].a >> 8);
            while (p >= 0) {
                JsonPair pair = doc.pairs[p];
                string key = pair.keyStart < 0 ? doc.escPool[pair.keyLen] : doc.src.Substring(pair.keyStart, pair.keyLen);
                dict.Add(key, (object)JsonValue.FromDoc(doc, pair.valueSlot));
                p = pair.nextPair;
            }
            return (object)dict;
        } else {
            Dict<string, object> dict = new Dict<string, object>();
            int p = (int)(doc.slots[at].a >> 8);
            while (p >= 0) {
                JsonPair pair = doc.pairs[p];
                string key = pair.keyStart < 0 ? doc.escPool[pair.keyLen] : doc.src.Substring(pair.keyStart, pair.keyLen);
                int vs = pair.valueSlot;
                if (doc.KindAt(vs) == 0) {
                    dict.Add(key, null);
                } else if (Json.IsListType(valName)) {
                    dict.Add(key, Json.DeserializeList(doc, vs, valTi));
                } else if (Json.IsDictType(valName)) {
                    dict.Add(key, Json.DeserializeDict(doc, vs, valTi));
                } else {
                    dict.Add(key, Json.DeserializeObject(doc, vs, valTi));
                }
                p = pair.nextPair;
            }
            return (object)dict;
        }
