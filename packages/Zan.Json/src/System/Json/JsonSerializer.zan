        }
        string elemName = elemTi.Name;
        string elemKind = elemTi.Kind;

        if (Json.IsListType(elemName)) {
            List<object> rows = new List<object>();
            if (at >= 0 && at < doc.slotCount && doc.KindAt(at) == 4) {
                int count = doc.Count(at);
                int c = doc.FirstChild(at);
                for (int i = 0; i < count; i = i + 1) {
                    rows.Add(Json.DeserializeList(doc, c, elemTi));
                    c = doc.NextSibling(c);
                }
            }
            return (object)rows;
        } else if (elemName == "string") {
            List<string> list = new List<string>();
            if (at >= 0 && at < doc.slotCount) {
                if (doc.KindAt(at) == 4) {
                    int count = doc.Count(at);
                    int c = doc.FirstChild(at);
                    for (int i = 0; i < count; i = i + 1) {
                        list.Add(doc.StrAt(c, ""));
                        c = doc.NextSibling(c);
                    }
                } else if (doc.KindAt(at) != 0) {
                    list.Add(doc.StrAt(at, ""));
                }
            }
            return (object)list;
        } else if (elemName == "int" || elemName == "short" || elemName == "byte" || elemKind == "enum") {
            List<int> list = new List<int>();
            if (at >= 0 && at < doc.slotCount) {
                if (doc.KindAt(at) == 4) {
                    int count = doc.Count(at);
                    int c = doc.FirstChild(at);
                    for (int i = 0; i < count; i = i + 1) {
                        list.Add(doc.IntAt(c, 0));
                        c = doc.NextSibling(c);
                    }
                } else if (doc.KindAt(at) != 0) {
                    list.Add(doc.IntAt(at, 0));
                }
            }
            return (object)list;
        } else if (elemName == "long") {
            List<long> list = new List<long>();
            if (at >= 0 && at < doc.slotCount) {
                if (doc.KindAt(at) == 4) {
                    int count = doc.Count(at);
                    int c = doc.FirstChild(at);
                    for (int i = 0; i < count; i = i + 1) {
                        list.Add(doc.LongAt(c, 0L));
                        c = doc.NextSibling(c);
                    }
                } else if (doc.KindAt(at) != 0) {
                    list.Add(doc.LongAt(at, 0L));
                }
            }
            return (object)list;
        } else if (elemName == "double" || elemName == "float") {
            List<double> list = new List<double>();
            if (at >= 0 && at < doc.slotCount) {
                if (doc.KindAt(at) == 4) {
                    int count = doc.Count(at);
                    int c = doc.FirstChild(at);
                    for (int i = 0; i < count; i = i + 1) {
                        list.Add(doc.DoubleAt(c, 0.0));
                        c = doc.NextSibling(c);
                    }
                } else if (doc.KindAt(at) != 0) {
                    list.Add(doc.DoubleAt(at, 0.0));
                }
            }
            return (object)list;
        } else if (elemName == "bool") {
            List<bool> list = new List<bool>();
            if (at >= 0 && at < doc.slotCount) {
                if (doc.KindAt(at) == 4) {
                    int count = doc.Count(at);
                    int c = doc.FirstChild(at);
                    for (int i = 0; i < count; i = i + 1) {
                        list.Add(doc.BoolAt(c, false));
                        c = doc.NextSibling(c);
                    }
                } else if (doc.KindAt(at) != 0) {
                    list.Add(doc.BoolAt(at, false));
                }
            }
            return (object)list;
        } else if (elemName == "JsonValue") {
            List<object> list = new List<object>();
            if (at >= 0 && at < doc.slotCount) {
                if (doc.KindAt(at) == 4) {
                    int count = doc.Count(at);
                    int c = doc.FirstChild(at);
                    for (int i = 0; i < count; i = i + 1) {
                        list.Add((object)JsonValue.FromDoc(doc, c));
                        c = doc.NextSibling(c);
                    }
                } else if (doc.KindAt(at) != 0) {
                    list.Add((object)JsonValue.FromDoc(doc, at));
                }
            }
            return (object)list;
        } else {
            List<object> list = new List<object>();
            if (at >= 0 && at < doc.slotCount) {
                if (doc.KindAt(at) == 4) {
                    int count = doc.Count(at);
                    int c = doc.FirstChild(at);
                    for (int i = 0; i < count; i = i + 1) {
                        if (doc.KindAt(c) == 5) {
                            if (Json.IsDictType(elemName)) {
                                list.Add(Json.DeserializeDict(doc, c, elemTi));
                            } else {
                                list.Add(Json.DeserializeObject(doc, c, elemTi));
                            }
                        }
                        c = doc.NextSibling(c);
                    }
                } else if (doc.KindAt(at) == 5) {
                    if (Json.IsDictType(elemName)) {
                        list.Add(Json.DeserializeDict(doc, at, elemTi));
                    } else {
                        list.Add(Json.DeserializeObject(doc, at, elemTi));
                    }
                }
            }
            return (object)list;
        }
    }
