using System;
using System.Text;

namespace System.Json;

// 解析后的 JSON 值树（object / array / string / number / bool / null）。
// 递归模型，可以遍历嵌套文档（UI 布局树、状态实体）。用
// <see cref="Parse"/> 构建；用 As*/类型化字段助手读取标量；
// 用 Get/Has 遍历对象、At/Count 遍历数组。
// 性能设计（3MB 文档实测 ~280 MB/s，同文档历史实现 28 MB/s）：
// 逐字节扫描全部下沉到 NativeMemory.ScanNotByte / Find（strspn/memchr，
// 向量化）；数字在扫描循环里就地解析成 numI/numD，不再保留字面量
// 字符串（每 token 少一次分配、读取侧少一次重解析）；字符串无转义时
// 一次 Substring（比逐字节 Zan 循环快一个数量级）；对象键值对
// keys/vals 并置（同一次键查找碰一个 Cache 行，不用两趟）。
public partial class JsonValue {
    // 值类别：0 null，1 bool，2 number，3 string，4 array，5 object。
    public int kind;
    // kind 1 时的布尔值。
    public bool boolVal;
    // kind 2 时的整数值（无小数/指数部分的 token 直接存这里；
    // 浮点 token 存 numD，numI 置 0；读取时按 token 形态取，
    // 没有二次解析）。
    public long numI;
    // kind 2 时的浮点值（带 . / e 的 token）。
    public double numD;
    // kind 2 时该 token 是否为纯整数（决定 Int/Long 是否免转换）。
    public bool numIsInt;
    // kind 2 时数字的十进制文本（AsString/ToJson 用）。
    public string numRaw;
    // kind 3 时的字符串值。
    public string strVal;
    // kind 4 时的数组元素。
    public List<JsonValue> items;
    // kind 4 的数值直存形态（刀11），与 items 互斥：numArr != null
    // 即数值形态。读路径（Count/At/Clone/序列化）双形态透明；
    // 变异操作先经 MaterializeItems 降级，序列化输出与装箱形态
    // 逐字节等价（元素按 NewDouble 的 numD 分支渲染）。
    public double[] numArr;
    // kind 5 时的键列表。
    public List<string> keys;
    // kind 5 时与 keys 并置的值列表。
    public List<JsonValue> vals;
    // kind 5 时的键索引哈希表（键数 > 8 且被频繁查找时懒加载构建，加速宽对象属性访问）。
    public Dict<string, int> keyIndex;
    // 是否为只读单例或受保护节点（禁止任何变异操作，防范单例投毒）。
    public bool isReadOnly;

    // 组树（WriteTo/WritePretty）与解析（ReadValueAt）共用的
    // 嵌套深度上限。序列化同样是递归的：无界深度的树会在
    // WriteTo 里耗尽调用栈直接段错误，所以与解析对称地限制。
    public static int MaxDepth = 512;

    static JsonValue nullVal;
    static JsonValue trueVal;
    static JsonValue falseVal;
    static JsonValue zeroVal;
    static JsonValue oneVal;

    // 全局单例只读 null 值（kind 0）。
    public static JsonValue NullVal {
        get {
            if (JsonValue.nullVal == null) {
                JsonValue v = new JsonValue();
                v.kind = 0;
                v.isReadOnly = true;
                JsonValue.nullVal = v;
            }
            return JsonValue.nullVal;
        }
    }

    // 全局单例只读 true 值（kind 1）。
    public static JsonValue TrueVal {
        get {
            if (JsonValue.trueVal == null) {
                JsonValue v = new JsonValue();
                v.kind = 1;
                v.boolVal = true;
                v.isReadOnly = true;
                JsonValue.trueVal = v;
            }
            return JsonValue.trueVal;
        }
    }

    // 全局单例只读 false 值（kind 1）。
    public static JsonValue FalseVal {
        get {
            if (JsonValue.falseVal == null) {
                JsonValue v = new JsonValue();
                v.kind = 1;
                v.boolVal = false;
                v.isReadOnly = true;
                JsonValue.falseVal = v;
            }
            return JsonValue.falseVal;
        }
    }

    // 全局单例只读整数 0 值（kind 2）。
    public static JsonValue ZeroVal {
        get {
            if (JsonValue.zeroVal == null) {
                JsonValue v = new JsonValue();
                v.kind = 2;
                v.numI = 0L;
                v.numIsInt = true;
                v.isReadOnly = true;
                JsonValue.zeroVal = v;
            }
            return JsonValue.zeroVal;
        }
    }

    // 全局单例只读整数 1 值（kind 2）。
    public static JsonValue OneVal {
        get {
            if (JsonValue.oneVal == null) {
                JsonValue v = new JsonValue();
                v.kind = 2;
                v.numI = 1L;
                v.numIsInt = true;
                v.isReadOnly = true;
                JsonValue.oneVal = v;
            }
            return JsonValue.oneVal;
        }
    }

    // 是否为只读单例或受保护的不可变节点。
    public bool IsReadOnly() {
        return this.isReadOnly || this == JsonValue.nullVal || this == JsonValue.trueVal || this == JsonValue.falseVal || this == JsonValue.zeroVal || this == JsonValue.oneVal;
    }

    // 确保当前节点可变；若为只读单例则立即抛出 JsonException，阻止单例投毒。
    public void EnsureMutable() {
        if (this.IsReadOnly()) {
            throw new JsonException("Cannot mutate immutable or singleton JsonValue (kind=" + Convert.ToString(this.kind) + ")");
        }
    }

    // 递归检测 target 节点是否已作为子孙节点出现在 root 树中（防止 ARC 有向成环导致永久内存泄漏）。
    public static bool TreeContains(JsonValue root, JsonValue target, int depth) {
        if (root == null || target == null || depth > 32) { return false; }
        if (root == target) { return true; }
        if (root.kind == 4) {
            if (root.items != null) {
                int n = root.items.Count;
                for (int i = 0; i < n; i = i + 1) {
                    if (JsonValue.TreeContains(root.items[i], target, depth + 1)) { return true; }
                }
            }
            return false;
        }
        if (root.kind == 5) {
            if (root.vals != null) {
                int n = root.vals.Count;
                for (int i = 0; i < n; i = i + 1) {
                    if (JsonValue.TreeContains(root.vals[i], target, depth + 1)) { return true; }
                }
            }
            return false;
        }
        return false;
    }

    // 校验挂载子节点是否会导致循环引用。
    public void CheckCycle(JsonValue child) {
        if (child == null) { return; }
        if (child == this) {
            throw new JsonException("Circular reference detected: cannot attach JsonValue to itself");
        }
        if (child.kind == 4 || child.kind == 5) {
            if (JsonValue.TreeContains(child, this, 0)) {
                throw new JsonException("Circular reference detected: child hierarchy already contains parent");
            }
        }
    }

    public JsonValue() {
        this.kind = 0;
        this.boolVal = false;
        this.numI = 0L;
        this.numD = 0.0;
        this.numIsInt = false;
        this.numRaw = "";
        this.strVal = "";
        this.items = null;
        this.numArr = null;
        this.keys = null;
        this.vals = null;
        this.keyIndex = null;
        this.isReadOnly = false;
    }

    // 构造 null 值（kind 0）。
    public static JsonValue NewNull() {
        return JsonValue.NullVal;
    }

    // 构造布尔值（kind 1）。复用全局只读单例，消除堆分配。
    public static JsonValue NewBool(bool b) {
        return b ? JsonValue.TrueVal : JsonValue.FalseVal;
    }

    // 构造整数值（kind 2，numIsInt）。高频 0 与 1 复用只读单例。
    public static JsonValue NewInt(long n) {
        if (n == 0L) { return JsonValue.ZeroVal; }
        if (n == 1L) { return JsonValue.OneVal; }
        JsonValue v = new JsonValue();
        v.kind = 2;
        v.numI = n;
        v.numIsInt = true;
        v.numRaw = "";
        return v;
    }

    // 构造浮点值（kind 2）。
    public static JsonValue NewDouble(double d) {
        JsonValue v = new JsonValue();
        v.kind = 2;
        v.numD = d;
        v.numIsInt = false;
        v.numRaw = "";
        return v;
    }

    // 构造数字值（kind 2），保留原始字面量避免浮点往返损失。
    public static JsonValue NewNum(string raw) {
        JsonValue v = new JsonValue();
        v.kind = 2;
        v.numRaw = raw;
        return v;
    }

    // 构造字符串值（kind 3）。
    public static JsonValue NewStr(string s) {
        JsonValue v = new JsonValue();
        v.kind = 3;
        v.strVal = s;
        return v;
    }

    // 构造空数组（kind 4）。
    public static JsonValue NewArray() {
        JsonValue v = new JsonValue();
        v.kind = 4;
        v.items = new List<JsonValue>();
        return v;
    }

    // 构造数值直存数组（kind 4 数值形态）：对 src 做一次防御拷贝，
    // 调用方事后改动原数组不渗入本值。
    public static JsonValue NewDoubleArray(double[] src) {
        int n = src != null ? src.Length : 0;
        double[] copy = new double[n];
        for (int i = 0; i < n; i = i + 1) { copy[i] = src[i]; }
        JsonValue v = new JsonValue();
        v.kind = 4;
        v.items = null;
        v.numArr = copy;
        return v;
    }

    // 构造空对象（kind 5）。
    public static JsonValue NewObject() {
        JsonValue v = new JsonValue();
        v.kind = 5;
        v.keys = new List<string>();
        v.vals = new List<JsonValue>();
        return v;
    }

    // 深拷贝当前 JsonValue 及其所有子节点（对象和数组递归克隆）。
    public JsonValue Clone() {
        if (this.kind == 0) { return JsonValue.NewNull(); }
        if (this.kind == 1) { return JsonValue.NewBool(this.boolVal); }
        if (this.kind == 2) {
            JsonValue v = new JsonValue();
            v.kind = 2;
            v.numI = this.numI;
            v.numD = this.numD;
            v.numIsInt = this.numIsInt;
            v.numRaw = this.numRaw;
            return v;
        }
        if (this.kind == 3) { return JsonValue.NewStr(this.strVal); }
        if (this.kind == 4) {
            if (this.numArr != null) { return JsonValue.NewDoubleArray(this.numArr); }
            JsonValue arr = JsonValue.NewArray();
            int n = this.items.Count;
            for (int i = 0; i < n; i = i + 1) {
                arr.items.Add(this.items[i].Clone());
            }
            return arr;
        }
        if (this.kind == 5) {
            JsonValue obj = JsonValue.NewObject();
            int n = this.keys.Count;
            for (int i = 0; i < n; i = i + 1) {
                obj.keys.Add(this.keys[i]);
                obj.vals.Add(this.vals[i].Clone());
            }
            return obj;
        }
        return JsonValue.NewNull();
    }

    // 是否为 null 值（kind 0）。
    public bool IsNull() { return kind == 0; }
    // 是否为布尔值（kind 1）。
    public bool IsBool() { return kind == 1; }
    // 是否为数字值（kind 2）。
    public bool IsNumber() { return kind == 2; }
    // 是否为整型形态的数字：NewInt、整数字面量解析产物，
    // 或无小数点/指数记号的 NewNum 手工字面量；NewDouble 永远不是
    // （数值恰为整数也保持浮点形态）。二进制序列化据此选择整数/
    // 浮点线格式。
    public bool IsInt() {
        if (kind != 2) { return false; }
        if (numIsInt) { return numRaw == null || numRaw.Length == 0; }
        if (numRaw == null || numRaw.Length == 0) { return false; }
        int i = 0;
        int n = numRaw.Length;
        while (i < n) {
            int c = numRaw[i] & 255;
            if (c == 46 || c == 101 || c == 69) { return false; }  // . e E
            i = i + 1;
        }
        return true;
    }
    // 是否为字符串值（kind 3）。
    public bool IsString() { return kind == 3; }
    // 是否为数组（kind 4）。
    public bool IsArray() { return kind == 4; }
    // 是否为对象（kind 5）。
    public bool IsObject() { return kind == 5; }

    // ---- 对象访问 -----------------------------------------------------

    // 追加键值对（对象）。不去重；重复键读取时首键胜（见 Get）。
    public void Put(string key, JsonValue v) {
        this.EnsureMutable();
        this.CheckCycle(v);
        // 索引已在册的键不覆盖：首键胜，保持与线性扫描一致。
        if (this.keyIndex != null && !this.keyIndex.ContainsKey(key)) {
            this.keyIndex[key] = keys.Count;
        }
        keys.Add(key);
        vals.Add(v);
    }

    // 对象是否含该 key；不是对象时返回 false。
    public bool Has(string key) {
        if (kind != 5) { return false; }
        int n = keys.Count;
        if (n <= 8) {
            for (int i = 0; i < n; i = i + 1) {
                if (keys[i] == key) { return true; }
            }
            return false;
        }
        if (this.keyIndex == null) {
            Get(key);
        }
        if (this.keyIndex != null) {
            return this.keyIndex.ContainsKey(key);
        }
        return false;
    }

    // `key` 对应的值；不存在或不是对象时返回 null。
    // 键数量 <= 8 时走连续内存线性扫描（零额外内存、缓存行友好）；
    // 键数量 > 8 时自动激活懒加载哈希索引，O(1) 访问。
    // 重复键统一首键胜（与线性扫描同语义）。
    public JsonValue Get(string key) {
        if (kind != 5) { return null; }
        int n = keys.Count;
        if (n <= 8) {
            for (int i = 0; i < n; i = i + 1) {
                if (keys[i] == key) { return vals[i]; }
            }
            return null;
        }
        if (this.keyIndex == null) {
            Dict<string, int> ki = new Dict<string, int>();
            for (int i = 0; i < n; i = i + 1) {
                // 首键胜：在册的不覆盖。
                if (!ki.ContainsKey(keys[i])) { ki[keys[i]] = i; }
            }
            this.keyIndex = ki;
        }
        if (this.keyIndex.ContainsKey(key)) {
            int idx = this.keyIndex[key];
            return vals[idx];
        }
        return null;
    }

    // 若 `key` 已存在则替换其值，否则追加（对象）。
    public void Set(string key, JsonValue v) {
        this.EnsureMutable();
        this.CheckCycle(v);
        if (this.keyIndex != null && this.keyIndex.ContainsKey(key)) {
            int idx = this.keyIndex[key];
            vals[idx] = v;
            return;
        }
        // 大对象先补建索引（与 Get 同口径，首键胜），否则下面的线性扫描
        // 让"循环 Set 建 N 键"退化成 O(n²)：TomlParser 逐表 Set 曾因此把
        // 100k 表的配置解析挂到分钟级（P2-27）。
        if (keys.Count > 8) {
            this.EnsureKeyIndex();
            if (this.keyIndex.ContainsKey(key)) {
                vals[this.keyIndex[key]] = v;
            } else {
                this.keyIndex[key] = keys.Count;
                keys.Add(key);
                vals.Add(v);
            }
            return;
        }
        for (int i = 0; i < keys.Count; i = i + 1) {
            if (keys[i] == key) {
                vals[i] = v;
                if (this.keyIndex != null) { this.keyIndex[key] = i; }
                return;
            }
        }
        if (this.keyIndex != null) {
            this.keyIndex[key] = keys.Count;
        }
        keys.Add(key);
        vals.Add(v);
    }

    // 构建键哈希索引（键数量 > 8 时构建）。首键胜，与
    // Get 的线性扫描同语义；RemoveAt 会整体失效重建（见该处注释）。
    public void EnsureKeyIndex() {
        if (this.keyIndex != null) { return; }
        Dict<string, int> ki = new Dict<string, int>();
        int n = keys.Count;
        for (int i = 0; i < n; i = i + 1) {
            if (!ki.ContainsKey(keys[i])) { ki[keys[i]] = i; }
        }
        this.keyIndex = ki;
    }

    // 从对象中移除指定键（存在则删除并返回 true；不存在或非对象返回 false）。
    public bool Remove(string key) {
        this.EnsureMutable();
        if (kind != 5 || keys == null) { return false; }
        for (int i = 0; i < keys.Count; i = i + 1) {
            if (keys[i] == key) {
                this.RemoveAt(i);
                return true;
            }
        }
        return false;
    }

    // 从对象或数组中按索引移除指定元素。
    public void RemoveAt(int index) {
        this.EnsureMutable();
        if (kind == 5) {
            if (keys != null && index >= 0 && index < keys.Count) {
                keys.RemoveAt(index);
                if (vals != null && index < vals.Count) {
                    vals.RemoveAt(index);
                }
                this.keyIndex = null;
            }
            return;
        }
        if (kind == 4) {
            // 数组的元素在 items 里（vals 是对象的值列表）——删错列表
            // 会让 RemoveAt 变成静默的空操作。
            int n = this.numArr != null ? this.numArr.Length : (items != null ? items.Count : 0);
            if (index >= 0 && index < n) {
                this.MaterializeItems();
                items.RemoveAt(index);
            }
        }
    }

    // 原位改名第 `index` 个键（键序与值不变）。Designer 这类编辑器用它
    // 做"保持键序的改名"，替代裸写 keys[i]——裸写会绕过 keyIndex，
    // 大对象（>8 键）改名后按名 Get 命中旧下标。非对象或越界抛
    // JsonException（与 KeyAt/ValAt 同族：改名传错下标是编程错误）。
    // 撞已有键时旧键仍在册、按名 Get 首键胜——调用方负责先查重
    // （Designer 属性改名就这么做）。
    public void RenameKey(int index, string newKey) {
        this.EnsureMutable();
        if (kind != 5 || keys == null) {
            throw new JsonException("RenameKey(" + Convert.ToString(index) + ") on non-object value (kind=" + Convert.ToString(kind) + ")");
        }
        if (index < 0 || index >= keys.Count) {
            throw new JsonException("RenameKey(" + Convert.ToString(index) + ") out of range (count=" + Convert.ToString(keys.Count) + ")");
        }
        keys[index] = newKey;
        this.keyIndex = null;
    }

    // 从该对象解析点分路径（"user.name"）；任一段
    // 缺失或不是对象时返回 null。用于双向 `bind` 查找。
    public JsonValue PathGet(string path) {
        if (path == null) { return null; }
        JsonValue cur = this;
        int start = 0;
        int len = path.Length;
        for (int i = 0; i <= len; i = i + 1) {
            bool end = i == len;
            bool dot = false;
            if (!end) { dot = (path[i] & 255) == 46; }
            if (end || dot) {
                string seg = path.Substring(start, i - start);
                if (cur == null) { return null; }
                cur = cur.Get(seg);
                start = i + 1;
            }
        }
        return cur;
    }

    // 沿点分路径写入标量字符串，按需创建中间对象
    // 和叶子节点，使绑定的控件能把编辑内容回写到状态。
    public void PathSet(string path, string val) {
        PathSetValue(path, JsonValue.NewStr(val));
    }

    // 与 PathSet 类似，但写入任意 JsonValue 叶子，使绑定的控件
    // 能在回写时保持值的 JSON 类型（bool / number / string），
    // 而不是全部转成字符串。根不是对象（数组/标量）时抛出 JsonException。
    public void PathSetValue(string path, JsonValue leaf) {
        if (path == null) { return; }
        if (!this.IsObject()) {
            throw new JsonException(
            "PathSetValue: root is not an object, path: " + path);
        }
        JsonValue cur = this;
        int start = 0;
        int len = path.Length;
        for (int i = 0; i <= len; i = i + 1) {
            bool end = i == len;
            bool dot = false;
            if (!end) { dot = (path[i] & 255) == 46; }
            if (end || dot) {
                string seg = path.Substring(start, i - start);
                if (end) {
                    cur.Set(seg, leaf);
                } else {
                    JsonValue next = cur.Get(seg);
                    if (next == null || !next.IsObject()) {
                        next = JsonValue.NewObject();
                        cur.Set(seg, next);
                    }
                    cur = next;
                }
                start = i + 1;
            }
        }
    }

    // ---- 便利写入口 ----------------------------------------------------
    // 手拼 JSON 字符串（"{\"k\":\"" + v + "\"}"）是注入与非法 JSON 的
    // 根源：引号、反斜杠、换行一旦混进变量就毁掉整个报文。这组入口让
    // 每个字段一行写完、转义交给 ToJson，从根上替代字符串拼接。

    // 追加字符串成员（null 值写成 JSON null，与字符串 "null" 区分）。
    public void PutStr(string key, string v) {
        if (v == null) { this.Put(key, JsonValue.NewNull()); return; }
        this.Put(key, JsonValue.NewStr(v));
    }

    // 追加整数成员。
    public void PutInt(string key, long v) {
        this.Put(key, JsonValue.NewInt(v));
    }

    // 追加浮点成员。
    public void PutDouble(string key, double v) {
        this.Put(key, JsonValue.NewDouble(v));
    }

    // 追加布尔成员。
    public void PutBool(string key, bool v) {
        this.Put(key, JsonValue.NewBool(v));
    }

    // 追加 null 成员。
    public void PutNull(string key) {
        this.Put(key, JsonValue.NewNull());
    }

    // 把一段已序列化的 JSON 文本作为成员值嵌入：能解析就挂
    // 解析出的子树（对象/数组/数字原样保型），解析失败则整段按字符串
    // 存——任何输入都不可能产出非法 JSON。用于收编「片段拼接」：把
    // 上游序列化好的 items/errors 等挂进外层报文，不再 Substring(1)
    // 之类按文本外科手术拼。
    public void PutJson(string key, string jsonText) {
        this.Put(key, JsonValue.ParseOrStr(jsonText));
    }

    // 数组末尾追加字符串元素（null 按空串存，数组元素无 null 语义）。
    public void AppendStr(string v) {
        this.Append(JsonValue.NewStr(v == null ? "" : v));
    }

    // 数组末尾追加整数元素。
    public void AppendInt(long v) {
        this.Append(JsonValue.NewInt(v));
    }

    // 数组末尾追加浮点元素。
    public void AppendDouble(double v) {
        this.Append(JsonValue.NewDouble(v));
    }

    // 数组末尾追加布尔元素。
    public void AppendBool(bool v) {
        this.Append(JsonValue.NewBool(v));
    }

    // 数组末尾嵌入一段已序列化 JSON 文本（语义同 PutJson）。
    public void AppendJson(string jsonText) {
        this.Append(JsonValue.ParseOrStr(jsonText));
    }

    // ParseLenient 的无异常形态：能解析返回子树；解析失败或
    // 结果是 null 字面量时返回字符串形态——用于 PutJson/AppendJson 的
    // 「片段嵌入」语义，保证任何输入都得到一个合法 JSON 值。
    public static JsonValue ParseOrStr(string jsonText) {
        if (jsonText == null) { return JsonValue.NewStr(""); }
        JsonValue v = null;
        try { v = JsonValue.ParseLenient(jsonText); } catch (Exception) { v = null; }
        if (v == null || v.IsNull()) { return JsonValue.NewStr(jsonText); }
        return v;
    }

    // ---- 数组访问 -----------------------------------------------------

    // 数值直存形态降级为装箱形态（变异操作进入时调用），值语义不变。
    public void MaterializeItems() {
        this.EnsureMutable();
        if (this.numArr == null) { return; }
        double[] arr = this.numArr;
        this.numArr = null;
        this.items = new List<JsonValue>();
        this.items.Reserve(arr.Length);
        for (int i = 0; i < arr.Length; i = i + 1) { this.items.Add(JsonValue.NewDouble(arr[i])); }
    }

    // 数组末尾追加元素（数组）。数值直存形态先降级。
    public void Append(JsonValue v) {
        this.EnsureMutable();
        this.CheckCycle(v);
        this.MaterializeItems();
        items.Add(v);
    }

    // 元素数量（数组元素或对象条目数；其他情况为 0）。
    public int Count() {
        if (kind == 4) { return this.numArr != null ? this.numArr.Length : items.Count; }
        if (kind == 5) { return keys.Count; }
        return 0;
    }

    // 第 i 个数组元素。非数组或越界抛 JsonException——历史版本此处是
    // 裸 items[i]：把 At 用在对象（items=null）上直接段崩 0xC0000005
    // 且无任何诊断（P2-17）。数值直存形态按需懒装箱。
    public JsonValue At(int i) {
        if (kind != 4 || (items == null && this.numArr == null)) {
            throw new JsonException("At(" + Convert.ToString(i) + ") on non-array value (kind=" + Convert.ToString(kind) + ")");
        }
        int n = this.numArr != null ? this.numArr.Length : items.Count;
        if (i < 0 || i >= n) {
            throw new JsonException("At(" + Convert.ToString(i) + ") out of range (count=" + Convert.ToString(n) + ")");
        }
        if (this.numArr != null) { return JsonValue.NewDouble(this.numArr[i]); }
        return items[i];
    }

    // 替换第 i 个数组元素（kind 4）。非数组或越界为**静默空操作**——
    // 与 At/KeyAt 的抛错风格不同：所有现役调用方都先用下标计算/Count
    // 自行校验过，把这里改成抛错等于给它们加一遍重复检查。新代码拿
    // 不准下标时请先校验，别依赖静默语义。
    public void SetAt(int i, JsonValue val) {
        this.EnsureMutable();
        this.CheckCycle(val);
        if (kind != 4) { return; }
        int n = this.numArr != null ? this.numArr.Length : (items != null ? items.Count : 0);
        if (i >= 0 && i < n) {
            this.MaterializeItems();
            items[i] = val;
        }
    }

    // 第 i 个对象的 key（用于遍历对象）。非对象或越界抛 JsonException
    // （与 At 同族：历史版本裸 keys[i]，对象外调用段崩）。
    public string KeyAt(int i) {
        if (kind != 5 || keys == null) {
            throw new JsonException("KeyAt(" + Convert.ToString(i) + ") on non-object value (kind=" + Convert.ToString(kind) + ")");
        }
        if (i < 0 || i >= keys.Count) {
            throw new JsonException("KeyAt(" + Convert.ToString(i) + ") out of range (count=" + Convert.ToString(keys.Count) + ")");
        }
        return keys[i];
    }
    // 第 i 个对象的值（与 KeyAt 配对遍历）。非对象或越界抛 JsonException。
    public JsonValue ValAt(int i) {
        if (kind != 5 || vals == null) {
            throw new JsonException("ValAt(" + Convert.ToString(i) + ") on non-object value (kind=" + Convert.ToString(kind) + ")");
        }
        if (i < 0 || i >= vals.Count) {
            throw new JsonException("ValAt(" + Convert.ToString(i) + ") out of range (count=" + Convert.ToString(vals.Count) + ")");
        }
        return vals[i];
    }


    // 紧凑/排版序列化 (ToJson/PrettyToJson)、类型转换 (As*/Str/Int)
    // 与解析构建 (FromDoc/Parse) 见 JsonValue.Convert.zan
}
