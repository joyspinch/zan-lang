using System;
using System.Numerics;

namespace Game.Render3D;

// 光源参数。
//
// **方向约定**：Direction 是光线传播方向（从光源射向场景）。平行光的
// 入射方向因此是 -Direction——写反了整个场景会反过来亮，这是 3D 管线
// 里最常见的约定错误之一。
public class Light {
    // 光源类型。
    public LightKind Kind;
    // 颜色（线性 0..1）。
    public float Red;
    public float Green;
    public float Blue;
    // 强度（乘在颜色上）。
    public float Intensity;
    // 平行光：光线传播方向；聚光：锥轴方向。
    public Vector3 Direction;
    // 点光 / 聚光：世界位置。
    public Vector3 Position;
    // 点光 / 聚光：射程（0 = 不衰减）。
    public float Range;
    // 聚光内锥半角（弧度）。
    public float InnerAngle;
    // 聚光外锥半角（弧度）。
    public float OuterAngle;
    // 是否参与本帧光照。
    public bool Enabled;

    public Light() {
        this.Kind = LightKind.Directional;
        this.Red = 1.0f;
        this.Green = 1.0f;
        this.Blue = 1.0f;
        this.Intensity = 1.0f;
        this.Direction = new Vector3(0.0f, -1.0f, 0.0f);
        this.Position = Vector3.Zero;
        this.Range = 0.0f;
        this.InnerAngle = 0.3f;
        this.OuterAngle = 0.6f;
        this.Enabled = true;
    }

    // 平行光：direction 为光线传播方向。
    public static Light DirectionalLight(float red, float green, float blue,
                                         float intensity, Vector3 direction) {
        Light l = new Light();
        l.Kind = LightKind.Directional;
        l.Red = red;
        l.Green = green;
        l.Blue = blue;
        l.Intensity = intensity;
        l.Direction = Vector3.Normalize(direction);
        return l;
    }

    // 点光：range 为 0 时不随距离衰减。
    public static Light PointLight(float red, float green, float blue,
                                   float intensity, Vector3 position,
                                   float range) {
        Light l = new Light();
        l.Kind = LightKind.Point;
        l.Red = red;
        l.Green = green;
        l.Blue = blue;
        l.Intensity = intensity;
        l.Position = position;
        l.Range = range;
        return l;
    }

    // 聚光：direction 为锥轴方向（从光源射向场景），角度为半角。
    public static Light SpotLight(float red, float green, float blue,
                                  float intensity, Vector3 position,
                                  Vector3 direction, float range,
                                  float innerAngle, float outerAngle) {
        Light l = new Light();
        l.Kind = LightKind.Spot;
        l.Red = red;
        l.Green = green;
        l.Blue = blue;
        l.Intensity = intensity;
        l.Position = position;
        l.Direction = Vector3.Normalize(direction);
        l.Range = range;
        l.InnerAngle = innerAngle;
        l.OuterAngle = outerAngle;
        return l;
    }
}
