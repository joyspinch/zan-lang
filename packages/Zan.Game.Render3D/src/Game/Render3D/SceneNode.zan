using System;
using System.Collections.Generic;
using System.Numerics;
using Game.Animation;

namespace Game.Render3D;

// 场景节点：渲染场景树的一节。
//
// 变换用 Game.Animation.Transform3D（平移 + 四元数旋转 + 缩放），
// 不自造第二套变换结构。节点的层级只表达"父子关系"——世界矩阵由渲染
// 计划逐层相乘得到（矩阵相乘是精确的，而 Transform3D.Compose 在
// "父级非等比缩放 + 子级带旋转"时不可分解，那正是骨骼的活儿，
// 渲染层不背这个锅）。
public class SceneNode {
    // 节点名（调试与日志用）。
    public string Name;
    // 局部变换。
    public Transform3D Local;
    // 子节点。
    public List<SceneNode> Children;
    // 网格句柄（Canvas.MeshUpload 的返回值）；0 = 本节点不直接出图，
    // 只作为分组节点（下面挂子节点）。
    public int MeshKey;
    // 材质。
    public Material Material;
    // 代表法线（局部空间）：逐实例光照用它代替逐顶点法线。
    public Vector3 Normal;
    // 包围球半径（局部空间单位）。
    public float BoundsRadius;
    // 是否参与渲染。
    public bool Visible;
    // 渲染层：0 = 不透明，1 = 透明（透明项按视深从远到近排序）。
    public int Layer;

    public SceneNode(string name) {
        this.Name = name;
        this.Local = Transform3D.Identity;
        this.Children = new List<SceneNode>();
        this.MeshKey = 0;
        this.Material = new Material();
        this.Normal = new Vector3(0.0f, 1.0f, 0.0f);
        this.BoundsRadius = 1.0f;
        this.Visible = true;
        this.Layer = 0;
    }

    // 挂一个子节点，返回自身便于链式调用。
    public SceneNode AddChild(SceneNode child) {
        if (child != null) { this.Children.Add(child); }
        return this;
    }

    // 整棵子树的节点数（含自身）。
    public int NodeCount() {
        int n = 1;
        for (int i = 0; i < this.Children.Count; i = i + 1) {
            n = n + this.Children[i].NodeCount();
        }
        return n;
    }

    // 设置局部平移。
    public SceneNode SetPosition(float x, float y, float z) {
        this.Local.Position = new Vector3(x, y, z);
        return this;
    }

    // 设置局部缩放。
    public SceneNode SetScale(float x, float y, float z) {
        this.Local.Scale = new Vector3(x, y, z);
        return this;
    }

    // 设置局部旋转（欧拉角，度；YXZ 序，与 stdlib Quaternion 一致）。
    public SceneNode SetEuler(float pitchDegrees, float yawDegrees, float rollDegrees) {
        this.Local.Rotation = Quaternion.FromEulerDegrees(pitchDegrees, yawDegrees, rollDegrees);
        return this;
    }
}
