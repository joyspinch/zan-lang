using Gui;

namespace Game.Render3D;

// 一个绘制项：渲染计划算好的一条"把这个网格这样画"指令。
//
// 纯数据，没有行为——绘制层只读这些字段，不反过来改。
public class RenderItem {
    // 网格句柄。
    public int MeshKey;
    // 纹理键（图像路径或 "mem:" key）；空串表示无纹理。
    public string TextureKey;
    // 纹理分组号：同一 (网格, 纹理) 的项分组号相同——排序后同组相邻，
    // 批次提交时才能连成一段（同网格多实例 = 一次实例化绘制）。
    public int TexGroup;
    // 模型矩阵（世界变换）。
    public Mat4 Model;
    // 着色后的 tint（0xAARRGGBB）；-1 = 不染色（白）。
    public int Tint;
    // 渲染层：0 = 不透明，1 = 透明。
    public int Layer;
    // 沿视线的深度（相机背后为负），用于透明排序与雾。
    public float Depth;
    // 来源节点名（调试用）。
    public string NodeName;

    public RenderItem() {
        this.MeshKey = 0;
        this.TextureKey = "";
        this.TexGroup = 0;
        this.Model = Mat4.Identity();
        this.Tint = -1;
        this.Layer = 0;
        this.Depth = 0.0f;
        this.NodeName = "";
    }
}
