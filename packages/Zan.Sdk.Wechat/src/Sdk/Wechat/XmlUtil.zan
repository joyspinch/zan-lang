using System;
using System.Text;

namespace Sdk.Wechat;

// 微信推送/回复 XML 的极简标签读写（微信报文字段普遍包在 CDATA 中）。
public class XmlUtil {
    private static bool IsTrimWs(int c) {
        return c == 32 || c == 9 || c == 10 || c == 13 || c == 11 || c == 12;
    }

    private static int FindOpenTag(string xml, nint xp, int n, string tag, int tlen, int termByte) {
        if (tlen < 0 || n < 2 || n - 2 < tlen) { return -1; }
        if (tlen == 0) {
            int pos = 0;
            while (n - pos >= 2) {
                int lt = NativeMemory.Find(xp, pos, 60, n - pos);
                if (lt < 0 || n - lt < 2) { return -1; }
                if ((xml[lt + 1] & 255) == termByte) { return lt; }
                pos = lt + 1;
            }
            return -1;
        }
        int t0 = tag[0] & 255;
        int pos = 1;
        int maxHit = n - tlen;
        while (pos < maxHit) {
            int hit = NativeMemory.Find(xp, pos, (byte)t0, maxHit - pos);
            if (hit < 0) { return -1; }
            if ((xml[hit - 1] & 255) == 60 && (xml[hit + tlen] & 255) == termByte) {
                bool eq = true;
                for (int i = 1; i < tlen; i = i + 1) {
                    if ((xml[hit + i] & 255) != (tag[i] & 255)) { eq = false; break; }
                }
                if (eq) { return hit - 1; }
            }
            pos = hit + 1;
        }
        return -1;
    }

    private static bool StartsWithCdataOpen(string s, int pos, int limit) {
        if (limit - pos < 9) { return false; }
        return (s[pos] & 255) == 60
            && (s[pos + 1] & 255) == 33
            && (s[pos + 2] & 255) == 91
            && (s[pos + 3] & 255) == 67
            && (s[pos + 4] & 255) == 68
            && (s[pos + 5] & 255) == 65
            && (s[pos + 6] & 255) == 84
            && (s[pos + 7] & 255) == 65
            && (s[pos + 8] & 255) == 91;
    }

    private static int FindCloseTag(string xml, nint xp, int start, int limit, string tag, int tlen) {
        if (start < 0 || tlen < 0 || limit - start < 3 || limit - start - 3 < tlen) { return -1; }
        int pos = start;
        while (limit - pos >= 3 + tlen) {
            int lt = NativeMemory.Find(xp, pos, 60, limit - pos);
            if (lt < 0 || limit - lt < 3 + tlen) { return -1; }
            if (XmlUtil.StartsWithCdataOpen(xml, lt, limit)) {
                int cEnd = XmlUtil.FindCdataEnd(xml, lt + 9, limit);
                if (cEnd < 0) { return -1; }
                pos = cEnd + 3;
                continue;
            }
            if ((xml[lt + 1] & 255) == 47 && (xml[lt + 2 + tlen] & 255) == 62) {
                bool eq = true;
                for (int i = 0; i < tlen; i = i + 1) {
                    if ((xml[lt + 2 + i] & 255) != (tag[i] & 255)) { eq = false; break; }
                }
                if (eq) { return lt; }
            }
            pos = lt + 1;
        }
        return -1;
    }

    internal static int FindCloseTagSlice(string xml, nint xp, int start, int limit, int nameStart, int nameLen) {
        if (start < 0 || nameLen < 0 || limit - start < 3 || limit - start - 3 < nameLen) { return -1; }
        int pos = start;
        while (limit - pos >= 3 + nameLen) {
            int lt = NativeMemory.Find(xp, pos, 60, limit - pos);
            if (lt < 0 || limit - lt < 3 + nameLen) { return -1; }
            if (XmlUtil.StartsWithCdataOpen(xml, lt, limit)) {
                int cEnd = XmlUtil.FindCdataEnd(xml, lt + 9, limit);
                if (cEnd < 0) { return -1; }
                pos = cEnd + 3;
                continue;
            }
            if ((xml[lt + 1] & 255) == 47 && (xml[lt + 2 + nameLen] & 255) == 62) {
                bool eq = true;
                for (int i = 0; i < nameLen; i = i + 1) {
                    if ((xml[lt + 2 + i] & 255) != (xml[nameStart + i] & 255)) { eq = false; break; }
                }
                if (eq) { return lt; }
            }
            pos = lt + 1;
        }
        return -1;
    }

    internal static int FindCdataEnd(string s, int from, int limit) {
        if (s == null || from < 0 || limit > s.Length || limit - from < 3) { return -1; }
        int maxPos = limit - 3;
        for (int pos = from; pos <= maxPos; pos = pos + 1) {
            if ((s[pos] & 255) == 93 && (s[pos + 1] & 255) == 93 && (s[pos + 2] & 255) == 62) {
                return pos;
            }
        }
        return -1;
    }

    internal static string StripCdataSlice(string s, int start, int end) {
        if (s == null || start < 0 || end < start || end > s.Length) { return ""; }
        int a = start;
        int b = end;
        while (a < b && XmlUtil.IsTrimWs(s[a] & 255)) { a = a + 1; }
        while (b > a && XmlUtil.IsTrimWs(s[b - 1] & 255)) { b = b - 1; }
        int len = b - a;
        if (len == 0) { return ""; }
        if (len >= 12 && XmlUtil.StartsWithCdataOpen(s, a, b)) {
            int close = XmlUtil.FindCdataEnd(s, a + 9, b);
            if (close >= 0) {
                // 单段 CDATA 快路径（零 StringBuilder 分配）。
                if (close + 3 == b) {
                    return s.Substring(a + 9, close - (a + 9));
                }
                // 支持拆分 CDATA 拼回（如 "]]]]><![CDATA[>" 编码含 "]]>" 的文本）。
                StringBuilder sb = new StringBuilder(len);
                sb.Append(s.Substring(a + 9, close - (a + 9)));
                int cur = close + 3;
                while (cur < b) {
                    if (XmlUtil.StartsWithCdataOpen(s, cur, b)) {
                        int nxt = XmlUtil.FindCdataEnd(s, cur + 9, b);
                        if (nxt < 0) { break; }
                        sb.Append(s.Substring(cur + 9, nxt - (cur + 9)));
                        cur = nxt + 3;
                    } else {
                        break;
                    }
                }
                return sb.ToString();
            }
        }
        if (a == 0 && b == s.Length) { return s; }
        return s.Substring(a, len);
    }

    public static string GetTag(string xml, string tag) {
        if (xml == null || tag == null) { return ""; }
        int n = xml.Length;
        int tlen = tag.Length;
        if (n == 0) { return ""; }
        nint xp = (nint)xml;
        int start = XmlUtil.FindOpenTag(xml, xp, n, tag, tlen, 62);
        if (start < 0) {
            start = XmlUtil.FindOpenTag(xml, xp, n, tag, tlen, 32);
            if (start < 0) { return ""; }
            int gt = NativeMemory.Find(xp, start + tlen + 2, 62, n - (start + tlen + 2));
            if (gt < 0) { return ""; }
            start = gt + 1;
        } else {
            start = start + tlen + 2;
        }
        int end = XmlUtil.FindCloseTag(xml, xp, start, n, tag, tlen);
        if (end < 0) { return ""; }
        return XmlUtil.StripCdataSlice(xml, start, end);
    }

    public static string StripCdata(string s) {
        if (s == null || s.Length == 0) { return ""; }
        return XmlUtil.StripCdataSlice(s, 0, s.Length);
    }

    public static string CdataTag(string tag, string text) {
        string safeTag = tag == null ? "" : tag;
        string safe = text == null ? "" : text;
        int tlen = safeTag.Length;
        int slen = safe.Length;
        nint sp = (nint)safe;
        int hit = XmlUtil.FindCdataEnd(safe, 0, slen);
        if (hit < 0) {
            long totalL = (long)tlen * 2L + (long)slen + 17L;
            if (totalL > 2147483591L) {
                throw new Exception("XmlUtil.CdataTag: output exceeds maximum buffer size");
            }
            int total = (int)totalL;
            byte[] buf = new byte[total];
            nint bp = (nint)buf;
            nint tp = (nint)safeTag;
            int di = 0;
            buf[di] = 60; di = di + 1;
            if (tlen > 0) { NativeMemory.Copy(bp + (nint)di, tp, tlen); di = di + tlen; }
            NativeMemory.Copy(bp + (nint)di, (nint)"><![CDATA[", 10); di = di + 10;
            if (slen > 0) { NativeMemory.Copy(bp + (nint)di, sp, slen); di = di + slen; }
            NativeMemory.Copy(bp + (nint)di, (nint)"]]></", 5); di = di + 5;
            if (tlen > 0) { NativeMemory.Copy(bp + (nint)di, tp, tlen); di = di + tlen; }
            buf[di] = 62;
            return NativeMemory.GetString(bp, 0, total);
        }
        long initCapL = (long)tlen * 2L + (long)slen + 32L;
        if (initCapL > 65536L) { initCapL = 65536L; }
        StringBuilder sb = new StringBuilder((int)initCapL);
        sb.Append("<"); sb.Append(safeTag); sb.Append("><![CDATA[");
        int from = 0;
        while (hit >= 0) {
            sb.Append(new StringView(sp + (nint)from, hit + 2 - from));
            sb.Append("]]><![CDATA[>");
            from = hit + 3;
            hit = XmlUtil.FindCdataEnd(safe, from, slen);
        }
        if (slen > from) { sb.Append(new StringView(sp + (nint)from, slen - from)); }
        sb.Append("]]></"); sb.Append(safeTag); sb.Append(">");
        return sb.ToString();
    }

    public static string TextTag(string tag, string text) {
        string safeTag = tag == null ? "" : tag;
        string esc = Encoding.XmlEscape(text == null ? "" : text, false, false);
        int tlen = safeTag.Length;
        int elen = esc.Length;
        long totalL = (long)tlen * 2L + (long)elen + 5L;
        if (totalL > 2147483591L) {
            throw new Exception("XmlUtil.TextTag: output exceeds maximum buffer size");
        }
        int total = (int)totalL;
        byte[] buf = new byte[total];
        nint bp = (nint)buf;
        nint tp = (nint)safeTag;
        int di = 0;
        buf[di] = 60; di = di + 1;
        if (tlen > 0) { NativeMemory.Copy(bp + (nint)di, tp, tlen); di = di + tlen; }
        buf[di] = 62; di = di + 1;
        if (elen > 0) { NativeMemory.Copy(bp + (nint)di, (nint)esc, elen); di = di + elen; }
        buf[di] = 60; buf[di + 1] = 47; di = di + 2;
        if (tlen > 0) { NativeMemory.Copy(bp + (nint)di, tp, tlen); di = di + tlen; }
        buf[di] = 62;
        return NativeMemory.GetString(bp, 0, total);
    }

    public static int IndexOf(string hay, string needle, int from) {
        if (hay == null || needle == null) { return -1; }
        if (from < 0) { from = 0; }
        if (needle.Length == 0) { return from <= hay.Length ? from : hay.Length; }
        if (from >= hay.Length) { return -1; }
        return hay.IndexOf(needle, from);
    }
}
