using System;
using System.Text;

namespace Sdk.Wechat;

// 微信推送/回复 XML 的极简标签读写（微信报文字段普遍包在 CDATA 中）。
public class XmlUtil {
    public static string GetTag(string xml, string tag) {
        string open = "<" + tag + ">";
        string close = "</" + tag + ">";
        int start = XmlUtil.IndexOf(xml, open, 0);
        if (start < 0) {
            open = "<" + tag + " ";
            start = XmlUtil.IndexOf(xml, open, 0);
            if (start < 0) { return ""; }
            int gt = XmlUtil.IndexOf(xml, ">", start);
            if (gt < 0) { return ""; }
            start = gt + 1;
        } else {
            start = start + open.Length;
        }
        int end = XmlUtil.IndexOf(xml, close, start);
        if (end < 0) { return ""; }
        return XmlUtil.StripCdata(xml.Substring(start, end - start));
    }

    public static string StripCdata(string s) {
        string t = s.Trim();
        if (t.Length >= 12 && t.Substring(0, 9) == "<![CDATA[") {
            int close = XmlUtil.IndexOf(t, "]]>", 9);
            if (close >= 0) {
                return t.Substring(9, close - 9);
            }
        }
        return t;
    }

    public static string CdataTag(string tag, string text) {
        string safe = text == null ? "" : text;
        if (safe.IndexOf("]]>") >= 0) {
            StringBuilder sb = new StringBuilder(safe.Length + 16);
            int from = 0;
            int hit = safe.IndexOf("]]>", from);
            while (hit >= 0) {
                sb.Append(safe.Substring(from, hit + 2 - from));
                sb.Append("]]><![CDATA[>");
                from = hit + 3;
                hit = safe.IndexOf("]]>", from);
            }
            sb.Append(safe.Substring(from, safe.Length - from));
            safe = sb.ToString();
        }
        return "<" + tag + "><![CDATA[" + safe + "]]></" + tag + ">";
    }

    public static string TextTag(string tag, string text) {
        return "<" + tag + ">" + Encoding.XmlEscape(text == null ? "" : text, false, false) + "</" + tag + ">";
    }

    public static int IndexOf(string hay, string needle, int from) {
        if (needle.Length == 0) { return from; }
        if (from < 0) { from = 0; }
        if (from >= hay.Length) { return -1; }
        return hay.IndexOf(needle, from);
    }
}
