using System;
using System.Json;
using System.Text;

namespace Sdk.Wechat;

// 内部 JSON/query 累加器（按需延迟分配，供生成的类型化请求使用）。
public class WechatTypedRequest {
    JsonValue body;
    JsonValue query;
    JsonValue path;

    public WechatTypedRequest() {
        this.body = null;
        this.query = null;
        this.path = null;
    }

    private JsonValue EnsureBody() {
        if (this.body == null) { this.body = JsonValue.NewObject(); }
        return this.body;
    }

    private JsonValue EnsureQuery() {
        if (this.query == null) { this.query = JsonValue.NewObject(); }
        return this.query;
    }

    private JsonValue EnsurePath() {
        if (this.path == null) { this.path = JsonValue.NewObject(); }
        return this.path;
    }

    private static JsonValue StringsArray(List<string> items) {
        JsonValue array = JsonValue.NewArray();
        if (items != null) {
            for (int i = 0; i < items.Count; i = i + 1) { array.Append(JsonValue.NewStr(items[i])); }
        }
        return array;
    }

    private static JsonValue IntsArray(List<int> items) {
        JsonValue array = JsonValue.NewArray();
        if (items != null) {
            for (int i = 0; i < items.Count; i = i + 1) { array.Append(JsonValue.NewNum(Convert.ToString(items[i]))); }
        }
        return array;
    }

    private static JsonValue LongsArray(List<long> items) {
        JsonValue array = JsonValue.NewArray();
        if (items != null) {
            for (int i = 0; i < items.Count; i = i + 1) { array.Append(JsonValue.NewNum(Convert.ToString(items[i]))); }
        }
        return array;
    }

    public WechatTypedRequest BodyString(string key, string fieldValue) {
        this.EnsureBody().Set(key, JsonValue.NewStr(fieldValue)); return this;
    }
    public WechatTypedRequest BodyInt(string key, int fieldValue) {
        this.EnsureBody().Set(key, JsonValue.NewNum(Convert.ToString(fieldValue))); return this;
    }
    public WechatTypedRequest BodyLong(string key, long fieldValue) {
        this.EnsureBody().Set(key, JsonValue.NewNum(Convert.ToString(fieldValue))); return this;
    }
    public WechatTypedRequest BodyDouble(string key, double fieldValue) {
        this.EnsureBody().Set(key, JsonValue.NewNum(Convert.ToString(fieldValue))); return this;
    }
    public WechatTypedRequest BodyBool(string key, bool fieldValue) {
        this.EnsureBody().Set(key, JsonValue.NewBool(fieldValue)); return this;
    }
    public WechatTypedRequest BodyStrings(string key, List<string> items) {
        this.EnsureBody().Set(key, WechatTypedRequest.StringsArray(items)); return this;
    }
    public WechatTypedRequest BodyInts(string key, List<int> items) {
        this.EnsureBody().Set(key, WechatTypedRequest.IntsArray(items)); return this;
    }
    public WechatTypedRequest BodyLongs(string key, List<long> items) {
        this.EnsureBody().Set(key, WechatTypedRequest.LongsArray(items)); return this;
    }
    public WechatTypedRequest BodyValue(string key, JsonValue fieldValue) {
        if (fieldValue != null) { this.EnsureBody().Set(key, fieldValue); }
        return this;
    }
    public WechatTypedRequest BodyJson(string key, string json) {
        if (json.Length > 0) { this.EnsureBody().Set(key, JsonValue.Parse(json)); }
        return this;
    }

    public WechatTypedRequest PathString(string key, string fieldValue) {
        this.EnsurePath().Set(key, JsonValue.NewStr(fieldValue)); return this;
    }
    public WechatTypedRequest PathLong(string key, long fieldValue) {
        this.EnsurePath().Set(key, JsonValue.NewNum(Convert.ToString(fieldValue))); return this;
    }
    public bool HasValue(string key) {
        return (this.path != null && this.path.Has(key))
            || (this.query != null && this.query.Has(key))
            || (this.body != null && this.body.Has(key));
    }
    public string ValueText(string key) {
        JsonValue fieldValue = this.path != null ? this.path.Get(key) : null;
        if (fieldValue == null && this.query != null) { fieldValue = this.query.Get(key); }
        if (fieldValue == null && this.body != null) { fieldValue = this.body.Get(key); }
        if (fieldValue == null) { return ""; }
        return fieldValue.AsString("");
    }

    public WechatTypedRequest QueryString(string key, string fieldValue) {
        this.EnsureQuery().Set(key, JsonValue.NewStr(fieldValue)); return this;
    }
    public WechatTypedRequest QueryInt(string key, int fieldValue) {
        this.EnsureQuery().Set(key, JsonValue.NewNum(Convert.ToString(fieldValue))); return this;
    }
    public WechatTypedRequest QueryLong(string key, long fieldValue) {
        this.EnsureQuery().Set(key, JsonValue.NewNum(Convert.ToString(fieldValue))); return this;
    }
    public WechatTypedRequest QueryStrings(string key, List<string> items) {
        this.EnsureQuery().Set(key, WechatTypedRequest.StringsArray(items)); return this;
    }
    public WechatTypedRequest QueryInts(string key, List<int> items) {
        this.EnsureQuery().Set(key, WechatTypedRequest.IntsArray(items)); return this;
    }
    public WechatTypedRequest QueryValue(string key, JsonValue fieldValue) {
        if (fieldValue != null) { this.EnsureQuery().Set(key, fieldValue); }
        return this;
    }
    public WechatTypedRequest QueryJson(string key, string json) {
        if (json.Length > 0) { this.EnsureQuery().Set(key, JsonValue.Parse(json)); }
        return this;
    }

    public string JsonBody() {
        return this.body == null ? "{}" : this.body.ToJson();
    }

    public string QueryText() {
        if (this.query == null || this.query.Count() == 0) { return ""; }
        StringBuilder result = new StringBuilder();
        for (int i = 0; i < this.query.Count(); i = i + 1) {
            if (i > 0) { result.Append("&"); }
            JsonValue queryValue = this.query.ValAt(i);
            string raw = queryValue.AsString("");
            if (queryValue.IsArray() || queryValue.IsObject()) { raw = queryValue.ToJson(); }
            result.Append(Encoding.UrlEncode(this.query.KeyAt(i)));
            result.Append("=");
            result.Append(Encoding.UrlEncode(raw));
        }
        return result.ToString();
    }
}
