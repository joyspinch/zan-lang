using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

/// <summary>方法请求/响应契约；可复用的 DTO 实体见 Sdk.Wechat.Models.Work。</summary>
class WechatWorkOAuth2ApiGetUserIdRequest {
    WechatTypedRequest request;

    public WechatWorkOAuth2ApiGetUserIdRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkOAuth2ApiGetUserIdRequest Code(string fieldValue) {
        this.request.QueryString("code", fieldValue);
        return this;
    }

    WechatWorkOAuth2ApiGetUserIdRequest AgentId(string fieldValue) {
        this.request.QueryString("agentId", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}

class WechatWorkOAuth2ApiGetUserIdResponse : WechatWorkOAuth2OAuth2ResultGetUserInfoResult {
    public string Raw;
}

class WechatWorkOAuth2ApiGetUserDetailRequest {
    WechatTypedRequest request;

    public WechatWorkOAuth2ApiGetUserDetailRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkOAuth2ApiGetUserDetailRequest UserTicket(string fieldValue) {
        this.request.BodyString("user_ticket", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}

class WechatWorkOAuth2ApiGetUserDetailResponse : WechatWorkGetUserDetailResult {
