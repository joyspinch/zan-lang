}

/// <summary>
/// OAuth2/OAuth2Api.cs 的 Zan 强类型接口。
/// 业务参数由请求对象自动序列化，凭证由客户端配置和缓存自动补充。
/// 由 scripts/generate_wechat_product_apis.py 从 Senparc 微信产品 API 生成。
/// </summary>
class WechatWorkOAuth2Api {
    WechatWorkClient client;

    public WechatWorkOAuth2Api(WechatWorkClient client) {
        this.client = client;
    }

    /// <summary>GET /cgi-bin/auth/getuserinfo</summary>
    async WechatWorkOAuth2ApiGetUserIdResponse GetUserIdAsync(WechatWorkOAuth2ApiGetUserIdRequest request) {
        if (request == null) { request = new WechatWorkOAuth2ApiGetUserIdRequest(); }
        WechatResponse raw = await this.client.RequestAsync("GET", "/cgi-bin/auth/getuserinfo", request.QueryText(), "", WechatCredentialKind.AccessToken);
        WechatWorkOAuth2ApiGetUserIdResponse result = Json.Deserialize<WechatWorkOAuth2ApiGetUserIdResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GetUserIdRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/cgi-bin/auth/getuserinfo", query, "", WechatCredentialKind.AccessToken);
    }

    /// <summary>POST /cgi-bin/auth/getuserdetail</summary>
    async WechatWorkOAuth2ApiGetUserDetailResponse GetUserDetailAsync(WechatWorkOAuth2ApiGetUserDetailRequest request) {
        if (request == null) { request = new WechatWorkOAuth2ApiGetUserDetailRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/auth/getuserdetail", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWorkOAuth2ApiGetUserDetailResponse result = Json.Deserialize<WechatWorkOAuth2ApiGetUserDetailResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GetUserDetailRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/auth/getuserdetail", query, jsonBody, WechatCredentialKind.AccessToken);
    }

}
