using System;
using System.Text;
using Sdk.Wechat;
using System.Net.External;

namespace Sdk.Wechat.Work;

// 企业微信 JSON API 客户端，自动缓存 corp access_token。
public class WechatWorkClient {
    WechatApiTransport transport;
    WechatTokenCache tokenCache;
    string corpId;
    string corpSecret;
    string providerAccessToken;
    string suiteAccessToken;

    public WechatWorkClient(string corpId, string corpSecret) {
        this.transport = new WechatApiTransport("qyapi.weixin.qq.com");
        this.tokenCache = new WechatTokenCache();
        this.corpId = corpId;
        this.corpSecret = corpSecret;
        this.providerAccessToken = "";
        this.suiteAccessToken = "";
    }

    public WechatWorkClient Server(string host, int port) {
        this.transport.Server(host, port);
        return this;
    }

    public WechatWorkClient PlainHttpMode() {
        this.transport.PlainHttpMode();
        return this;
    }

    public WechatWorkClient Timeout(int ms) {
        this.transport.Timeout(ms);
        return this;
    }

    public WechatWorkClient SetCallPolicy(ExternalCallPolicy policy) {
        this.transport.SetCallPolicy(policy);
        return this;
    }

    public ExternalCallPolicy CallPolicy() {
        return this.transport.CallPolicy();
    }

    public WechatWorkClient SetAccessToken(string token, int expiresIn) {
        this.tokenCache.Set(token, expiresIn);
        return this;
    }

    public WechatWorkClient SetProviderAccessToken(string token) {
        this.providerAccessToken = token;
        return this;
    }

    public WechatWorkClient SetSuiteAccessToken(string token) {
        this.suiteAccessToken = token;
        return this;
    }

    public async string GetAccessTokenAsync() {
        string cached = this.tokenCache.Current();
        if (cached.Length > 0) { return cached; }
        if (this.corpId.Length == 0 || this.corpSecret.Length == 0) {
            throw new WechatException("work.paramError", "corpId / corpSecret 不能为空", "");
        }
        string path = "/cgi-bin/gettoken?corpid=" + Encoding.UrlEncode(this.corpId)
            + "&corpsecret=" + Encoding.UrlEncode(this.corpSecret);
        return await this.tokenCache.GetOrFetchAsync(this.transport, path, "work");
    }

    private async string CredentialAsync(WechatCredentialKind kind) {
        if (kind == WechatCredentialKind.None) { return ""; }
        if (kind == WechatCredentialKind.AccessToken) { return await this.GetAccessTokenAsync(); }
        if (kind == WechatCredentialKind.ProviderAccessToken) {
            if (this.providerAccessToken.Length == 0) {
                throw new WechatException("work.tokenMissing", "请先设置 provider_access_token", "");
            }
            return this.providerAccessToken;
        }
        if (kind == WechatCredentialKind.SuiteAccessToken) {
            if (this.suiteAccessToken.Length == 0) {
                throw new WechatException("work.tokenMissing", "请先设置 suite_access_token", "");
            }
            return this.suiteAccessToken;
        }
        throw new WechatException("work.tokenUnsupported", "当前客户端不支持此凭证类型", "");
    }

    private async string BuildTargetAsync(string path, string query, WechatCredentialKind credential) {
        string token = await this.CredentialAsync(credential);
        return WechatApiTransport.BuildTarget(path, query, credential, token);
    }

    public async WechatResponse RequestAsync(string method, string path, string query,
                                             string jsonBody, WechatCredentialKind credential) {
        string target = await this.BuildTargetAsync(path, query, credential);
        return await this.transport.RequestJsonAsync(method, target, jsonBody);
    }

    public async WechatRawResponse RequestRawAsync(string method, string path,
                                                   string query, string body,
                                                   string contentType,
                                                   WechatCredentialKind credential) {
        string target = await this.BuildTargetAsync(path, query, credential);
        return await this.transport.RequestRawAsync(method, target, body, contentType, null);
    }

    public async WechatRawResponse RequestMultipartAsync(string method, string path,
                                                         string query,
                                                         WechatMultipart multipart,
                                                         WechatCredentialKind credential) {
        string target = await this.BuildTargetAsync(path, query, credential);
        return await this.transport.RequestMultipartAsync(method, target, multipart);
    }

    public async WechatResponse UploadJsonAsync(string path, string query,
                                                WechatMultipart multipart,
                                                WechatCredentialKind credential) {
        string target = await this.BuildTargetAsync(path, query, credential);
        return await this.transport.UploadJsonAsync(target, multipart);
    }
}
