using System;
using System.Text;
using Sdk.Wechat;
using System.Net.External;

namespace Sdk.Wechat.Work;

/// <summary>企业微信 JSON API 客户端，自动缓存 corp access_token。</summary>
class WechatWorkClient {
    WechatApiTransport transport;
    string corpId;
    string corpSecret;
    string accessToken;
    long accessTokenExpireUnix;
    string providerAccessToken;
    string suiteAccessToken;

    public WechatWorkClient(string corpId, string corpSecret) {
        this.transport = new WechatApiTransport("qyapi.weixin.qq.com");
        this.corpId = corpId;
        this.corpSecret = corpSecret;
        this.accessToken = "";
        this.accessTokenExpireUnix = 0;
        this.providerAccessToken = "";
        this.suiteAccessToken = "";
    }

    WechatWorkClient Server(string host, int port) {
        this.transport.Server(host, port);
        return this;
    }

    WechatWorkClient Timeout(int ms) {
        this.transport.Timeout(ms);
        return this;
    }

    WechatWorkClient SetCallPolicy(ExternalCallPolicy policy) {
        this.transport.SetCallPolicy(policy);
        return this;
    }

    ExternalCallPolicy CallPolicy() {
        return this.transport.CallPolicy();
    }

    WechatWorkClient SetAccessToken(string token, int expiresIn) {
        this.accessToken = token;
        int life = expiresIn - 300;
        if (life < 0) { life = 0; }
        this.accessTokenExpireUnix = DateTime.UtcNow().ToUnixSeconds() + life;
        return this;
    }

    WechatWorkClient SetProviderAccessToken(string token) {
        this.providerAccessToken = token;
        return this;
    }

    WechatWorkClient SetSuiteAccessToken(string token) {
        this.suiteAccessToken = token;
        return this;
    }

    async string GetAccessTokenAsync() {
        if (this.accessToken.Length > 0
            && DateTime.UtcNow().ToUnixSeconds() < this.accessTokenExpireUnix) {
            return this.accessToken;
        }
        if (this.corpId.Length == 0 || this.corpSecret.Length == 0) {
            throw new WechatException("work.paramError", "corpId / corpSecret 不能为空", "");
        }
        string path = "/cgi-bin/gettoken?corpid=" + Encoding.UrlEncode(this.corpId)
            + "&corpsecret=" + Encoding.UrlEncode(this.corpSecret);
        WechatResponse response = await this.transport.RequestJsonAsync("GET", path, "");
        string token = response.Str(WechatCredential.QueryName(WechatCredentialKind.AccessToken), "");
        if (token.Length == 0) {
            throw new WechatException("work.badResponse", "响应缺少 access_token", response.Data);
        }
        this.SetAccessToken(token, response.Int("expires_in", 7200));
        return this.accessToken;
    }

    async string CredentialAsync(WechatCredentialKind kind) {
        if (kind == WechatCredentialKind.None) { return ""; }
        if (kind == WechatCredentialKind.AccessToken) { return await this.GetAccessTokenAsync(); }
        if (kind == WechatCredentialKind.ProviderAccessToken) {
            if (this.providerAccessToken.Length == 0) {
                throw new WechatException("work.tokenMissing", "请先设置 provider_access_token", "");
            }
            return this.providerAccessToken;
        }
        if (kind == WechatCredentialKind.SuiteAccessToken) {
            if (this.suiteAccessToken.Length == 0) {
                throw new WechatException("work.tokenMissing", "请先设置 suite_access_token", "");
            }
            return this.suiteAccessToken;
        }
        throw new WechatException("work.tokenUnsupported", "当前客户端不支持此凭证类型", "");
    }

    async WechatResponse RequestAsync(string method, string path, string query,
                                      string jsonBody, WechatCredentialKind credential) {
        string target = WechatApiTransport.BuildPath(path, query);
        string token = await this.CredentialAsync(credential);
        target = WechatApiTransport.AppendQuery(target, WechatCredential.QueryName(credential), token);
        return await this.transport.RequestJsonAsync(method, target, jsonBody);
    }

    async WechatRawResponse RequestRawAsync(string method, string path,
                                             string query, string body,
                                             string contentType,
                                             WechatCredentialKind credential) {
        string target = WechatApiTransport.BuildPath(path, query);
        string token = await this.CredentialAsync(credential);
        target = WechatApiTransport.AppendQuery(target, WechatCredential.QueryName(credential), token);
        return await this.transport.RequestSimpleRawAsync(method, target, body, contentType);
    }

    async WechatRawResponse RequestMultipartAsync(string method, string path,
                                                   string query,
                                                   WechatMultipart multipart,
                                                   WechatCredentialKind credential) {
        string target = WechatApiTransport.BuildPath(path, query);
        string token = await this.CredentialAsync(credential);
        target = WechatApiTransport.AppendQuery(target, WechatCredential.QueryName(credential), token);
        return await this.transport.RequestMultipartAsync(method, target, multipart);
    }
}
