namespace Sdk.Wechat.Work;

// 方法请求/响应契约；可复用的 DTO 实体见 Sdk.Wechat.Models.Work。
class WechatWorkSsoApiGetLoginInfoRequest {
    WechatTypedRequest request;

    public WechatWorkSsoApiGetLoginInfoRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkSsoApiGetLoginInfoRequest AuthCode(string fieldValue) {
        this.request.BodyString("auth_code", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}

class WechatWorkSsoApiGetLoginInfoResponse : WechatWorkGetLoginInfoResult {
    public string Raw;
}

