class WechatWorkSsoApiGetProviderTokenResponse {
    public string Raw;
    public JsonValue Value;
}

// SSO/SsoApi.cs 的 Zan 强类型接口。
// 由 scripts/generate_wechat_product_apis.py 从 Senparc 微信产品 API 生成。
class WechatWorkSsoApi {
    WechatWorkClient client;

    public WechatWorkSsoApi(WechatWorkClient client) {
        this.client = client;
    }

    async WechatWorkSsoApiGetLoginInfoResponse GetLoginInfoAsync(WechatWorkSsoApiGetLoginInfoRequest request) {
        if (request == null) { request = new WechatWorkSsoApiGetLoginInfoRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/service/get_login_info", request.QueryText(), request.JsonBody(), WechatCredentialKind.ProviderAccessToken);
        WechatWorkSsoApiGetLoginInfoResponse result = Json.Deserialize<WechatWorkSsoApiGetLoginInfoResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GetLoginInfoRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/service/get_login_info", query, jsonBody, WechatCredentialKind.ProviderAccessToken);
    }

    async WechatWorkSsoApiGetProviderTokenResponse GetProviderTokenAsync(WechatWorkSsoApiGetProviderTokenRequest request) {
        if (request == null) { request = new WechatWorkSsoApiGetProviderTokenRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/service/get_provider_token", request.QueryText(), request.JsonBody(), WechatCredentialKind.None);
        WechatWorkSsoApiGetProviderTokenResponse result = Json.Deserialize<WechatWorkSsoApiGetProviderTokenResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GetProviderTokenRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/service/get_provider_token", query, jsonBody, WechatCredentialKind.None);
    }

}
