        WechatWorkAsynchronousApiBatchReplacePartyResponse result = Json.Deserialize<WechatWorkAsynchronousApiBatchReplacePartyResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse BatchReplacePartyRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/batch/replaceparty", query, jsonBody, WechatCredentialKind.AccessToken);
    }

    public async WechatWorkAsynchronousApiGetReplaceUserResultResponse GetReplaceUserResultAsync(WechatWorkAsynchronousApiGetReplaceUserResultRequest request) {
        if (request == null) { request = new WechatWorkAsynchronousApiGetReplaceUserResultRequest(); }
        WechatResponse raw = await this.client.RequestAsync("GET", "/cgi-bin/batch/getresult", request.QueryText(), "", WechatCredentialKind.AccessToken);
        WechatWorkAsynchronousApiGetReplaceUserResultResponse result = Json.Deserialize<WechatWorkAsynchronousApiGetReplaceUserResultResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse GetReplaceUserResultRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/cgi-bin/batch/getresult", query, "", WechatCredentialKind.AccessToken);
    }

    public async WechatWorkAsynchronousApiGetReplacePartyResultResponse GetReplacePartyResultAsync(WechatWorkAsynchronousApiGetReplacePartyResultRequest request) {
        if (request == null) { request = new WechatWorkAsynchronousApiGetReplacePartyResultRequest(); }
        WechatResponse raw = await this.client.RequestAsync("GET", "/cgi-bin/batch/getresult", request.QueryText(), "", WechatCredentialKind.AccessToken);
        WechatWorkAsynchronousApiGetReplacePartyResultResponse result = Json.Deserialize<WechatWorkAsynchronousApiGetReplacePartyResultResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse GetReplacePartyResultRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/cgi-bin/batch/getresult", query, "", WechatCredentialKind.AccessToken);
