using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkAsynchronousApi {
    WechatWorkClient client;

    public WechatWorkAsynchronousApi(WechatWorkClient client) {
        this.client = client;
    }

    public async WechatWorkAsynchronousApiBatchSyncUserResponse BatchSyncUserAsync(WechatWorkAsynchronousApiBatchSyncUserRequest request) {
        if (request == null) { request = new WechatWorkAsynchronousApiBatchSyncUserRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/batch/syncuser", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWorkAsynchronousApiBatchSyncUserResponse result = Json.Deserialize<WechatWorkAsynchronousApiBatchSyncUserResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse BatchSyncUserRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/batch/syncuser", query, jsonBody, WechatCredentialKind.AccessToken);
    }

