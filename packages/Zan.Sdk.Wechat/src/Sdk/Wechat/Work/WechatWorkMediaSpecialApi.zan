using System;
using System.Collections.Generic;

namespace Sdk.Wechat.Work;

public class WechatWorkMediaSpecialApi {
    WechatWorkClient client;
    public WechatWorkMediaSpecialApi(WechatWorkClient client) { this.client = client; }

    public async WechatResponse UploadAsync(string mediaType, string fileName,
                                            string contentType, string fileBytes) {
        WechatMultipart form = WechatMultipart.ForFile("media", fileName, contentType, fileBytes);
        return await this.client.UploadJsonAsync("/cgi-bin/media/upload",
            "type=" + Encoding.UrlEncode(mediaType), form, WechatCredentialKind.AccessToken);
    }

    public async WechatRawResponse GetAsync(string mediaId) {
        return await this.client.RequestRawAsync("GET", "/cgi-bin/media/get",
            "media_id=" + Encoding.UrlEncode(mediaId), "", "", WechatCredentialKind.AccessToken);
    }

    public async WechatResponse AddMaterialAsync(string mediaType, int agentId,
                                                 string fileName, string contentType,
                                                 string fileBytes) {
        WechatMultipart form = WechatMultipart.ForFile("media", fileName, contentType, fileBytes);
        string query = "agentid=" + Convert.ToString(agentId)
            + "&type=" + Encoding.UrlEncode(mediaType);
        return await this.client.UploadJsonAsync("/cgi-bin/material/add_material",
            query, form, WechatCredentialKind.AccessToken);
    }

    public async WechatRawResponse GetForeverMaterialAsync(int agentId, string mediaId) {
        string query = "media_id=" + Encoding.UrlEncode(mediaId)
            + "&agentid=" + Convert.ToString(agentId);
        return await this.client.RequestRawAsync("GET", "/cgi-bin/material/get",
            query, "", "", WechatCredentialKind.AccessToken);
    }

    public async WechatResponse UploadimgMediaAsync(string fileName, string contentType,
                                                    string fileBytes) {
        WechatMultipart form = WechatMultipart.ForFile("media", fileName, contentType, fileBytes);
        return await this.client.UploadJsonAsync("/cgi-bin/media/uploadimg",
            "", form, WechatCredentialKind.AccessToken);
    }

    public async WechatResponse UploadAttachmentAsync(string mediaType,
                                                      string attachmentType,
                                                      string fileName,
                                                      string contentType,
                                                      string fileBytes) {
        WechatMultipart form = WechatMultipart.ForFile("media", fileName, contentType, fileBytes);
        string query = "media_type=" + Encoding.UrlEncode(mediaType)
            + "&attachment_type=" + Encoding.UrlEncode(attachmentType);
        return await this.client.UploadJsonAsync("/cgi-bin/media/upload_attachment",
            query, form, WechatCredentialKind.AccessToken);
    }
}
