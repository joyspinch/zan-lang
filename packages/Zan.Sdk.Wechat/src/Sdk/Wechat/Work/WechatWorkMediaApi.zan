using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkMediaApi {
    WechatWorkClient client;

    public WechatWorkMediaApi(WechatWorkClient client) {
        this.client = client;
    }

    public async WechatWorkMediaApiAddMpNewsResponse AddMpNewsAsync(WechatWorkMediaApiAddMpNewsRequest request) {
        if (request == null) { request = new WechatWorkMediaApiAddMpNewsRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/material/add_mpnews", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWorkMediaApiAddMpNewsResponse result = Json.Deserialize<WechatWorkMediaApiAddMpNewsResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse AddMpNewsRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/material/add_mpnews", query, jsonBody, WechatCredentialKind.AccessToken);
    }

    public async WechatWorkMediaApiGetForeverMpNewsResponse GetForeverMpNewsAsync(WechatWorkMediaApiGetForeverMpNewsRequest request) {
        if (request == null) { request = new WechatWorkMediaApiGetForeverMpNewsRequest(); }
        WechatResponse raw = await this.client.RequestAsync("GET", "/cgi-bin/material/get", request.QueryText(), "", WechatCredentialKind.AccessToken);
        WechatWorkMediaApiGetForeverMpNewsResponse result = Json.Deserialize<WechatWorkMediaApiGetForeverMpNewsResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse GetForeverMpNewsRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/cgi-bin/material/get", query, "", WechatCredentialKind.AccessToken);
    }

