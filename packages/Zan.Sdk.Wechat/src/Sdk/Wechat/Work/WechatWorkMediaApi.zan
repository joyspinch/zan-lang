        if (request == null) { request = new WechatWorkMediaApiDeleteForeverMaterialRequest(); }
        WechatResponse raw = await this.client.RequestAsync("GET", "/cgi-bin/material/del", request.QueryText(), "", WechatCredentialKind.AccessToken);
        WechatWorkMediaApiDeleteForeverMaterialResponse result = Json.Deserialize<WechatWorkMediaApiDeleteForeverMaterialResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse DeleteForeverMaterialRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/cgi-bin/material/del", query, "", WechatCredentialKind.AccessToken);
    }

    public async WechatWorkMediaApiUpdateMpNewsResponse UpdateMpNewsAsync(WechatWorkMediaApiUpdateMpNewsRequest request) {
        if (request == null) { request = new WechatWorkMediaApiUpdateMpNewsRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/material/update_mpnews", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWorkMediaApiUpdateMpNewsResponse result = Json.Deserialize<WechatWorkMediaApiUpdateMpNewsResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse UpdateMpNewsRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/material/update_mpnews", query, jsonBody, WechatCredentialKind.AccessToken);
    }

    public async WechatWorkMediaApiGetCountResponse GetCountAsync(WechatWorkMediaApiGetCountRequest request) {
        if (request == null) { request = new WechatWorkMediaApiGetCountRequest(); }
        WechatResponse raw = await this.client.RequestAsync("GET", "/cgi-bin/material/get_count", request.QueryText(), "", WechatCredentialKind.AccessToken);
        WechatWorkMediaApiGetCountResponse result = Json.Deserialize<WechatWorkMediaApiGetCountResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse GetCountRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/cgi-bin/material/get_count", query, "", WechatCredentialKind.AccessToken);
    }

    public async WechatWorkMediaApiBatchGetMaterialResponse BatchGetMaterialAsync(WechatWorkMediaApiBatchGetMaterialRequest request) {
        if (request == null) { request = new WechatWorkMediaApiBatchGetMaterialRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/material/batchget", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWorkMediaApiBatchGetMaterialResponse result = Json.Deserialize<WechatWorkMediaApiBatchGetMaterialResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse BatchGetMaterialRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/material/batchget", query, jsonBody, WechatCredentialKind.AccessToken);
    }

}
