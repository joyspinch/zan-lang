    public WechatWorkMassApi(WechatWorkClient client) {
        this.client = client;
    }

    async WechatWorkMassApiSendTextResponse SendTextAsync(WechatWorkMassApiSendTextRequest request) {
        if (request == null) { request = new WechatWorkMassApiSendTextRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/message/send", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWorkMassApiSendTextResponse result = Json.Deserialize<WechatWorkMassApiSendTextResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse SendTextRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/message/send", query, jsonBody, WechatCredentialKind.AccessToken);
    }

