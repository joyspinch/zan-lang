using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

/// <summary>方法请求/响应契约；可复用的 DTO 实体见 Sdk.Wechat.Models.Work。</summary>
class WechatWorkMobileApiGetTicketResponse : WechatWorkGetTicketResultJson {
    public string Raw;
}

class WechatWorkMobileApiGetJsApiTicketResponse : WechatWorkGetTicketResultJson {
    public string Raw;
}

/// <summary>
/// Mobile/MobileApi.cs 的 Zan 强类型接口。
/// 业务参数由请求对象自动序列化，凭证由客户端配置和缓存自动补充。
/// 由 scripts/generate_wechat_product_apis.py 从 Senparc 微信产品 API 生成。
/// </summary>
class WechatWorkMobileApi {
    WechatWorkClient client;

    public WechatWorkMobileApi(WechatWorkClient client) {
        this.client = client;
    }

    /// <summary>GET /cgi-bin/ticket/get</summary>
    async WechatWorkMobileApiGetTicketResponse GetTicketAsync() {
        WechatResponse raw = await this.client.RequestAsync("GET", "/cgi-bin/ticket/get", "", "", WechatCredentialKind.AccessToken);
        WechatWorkMobileApiGetTicketResponse result = Json.Deserialize<WechatWorkMobileApiGetTicketResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GetTicketRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/cgi-bin/ticket/get", query, "", WechatCredentialKind.AccessToken);
    }

    /// <summary>GET /cgi-bin/ticket/get</summary>
    async WechatWorkMobileApiGetJsApiTicketResponse GetJsApiTicketAsync() {
        WechatResponse raw = await this.client.RequestAsync("GET", "/cgi-bin/ticket/get", "", "", WechatCredentialKind.AccessToken);
        WechatWorkMobileApiGetJsApiTicketResponse result = Json.Deserialize<WechatWorkMobileApiGetJsApiTicketResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GetJsApiTicketRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/cgi-bin/ticket/get", query, "", WechatCredentialKind.AccessToken);
    }

}
