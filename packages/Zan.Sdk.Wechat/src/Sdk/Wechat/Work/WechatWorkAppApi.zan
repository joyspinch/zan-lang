/// <summary>
/// App/AppApi.cs 的 Zan 强类型接口。
/// 业务参数由请求对象自动序列化，凭证由客户端配置和缓存自动补充。
/// 由 scripts/generate_wechat_product_apis.py 从 Senparc 微信产品 API 生成。
/// </summary>
class WechatWorkAppApi {
    WechatWorkClient client;

    public WechatWorkAppApi(WechatWorkClient client) {
        this.client = client;
    }

    /// <summary>GET /cgi-bin/agent/get</summary>
    async WechatWorkAppApiGetAppInfoResponse GetAppInfoAsync(WechatWorkAppApiGetAppInfoRequest request) {
        if (request == null) { request = new WechatWorkAppApiGetAppInfoRequest(); }
        WechatResponse raw = await this.client.RequestAsync("GET", "/cgi-bin/agent/get", request.QueryText(), "", WechatCredentialKind.AccessToken);
        WechatWorkAppApiGetAppInfoResponse result = Json.Deserialize<WechatWorkAppApiGetAppInfoResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GetAppInfoRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/cgi-bin/agent/get", query, "", WechatCredentialKind.AccessToken);
    }

    /// <summary>POST /cgi-bin/agent/set</summary>
    async WechatWorkAppApiSetAppResponse SetAppAsync(WechatWorkAppApiSetAppRequest request) {
        if (request == null) { request = new WechatWorkAppApiSetAppRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/agent/set", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWorkAppApiSetAppResponse result = Json.Deserialize<WechatWorkAppApiSetAppResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse SetAppRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/agent/set", query, jsonBody, WechatCredentialKind.AccessToken);
    }

    /// <summary>GET /cgi-bin/agent/list</summary>
    async WechatWorkAppApiGetAppListResponse GetAppListAsync() {
        WechatResponse raw = await this.client.RequestAsync("GET", "/cgi-bin/agent/list", "", "", WechatCredentialKind.AccessToken);
        WechatWorkAppApiGetAppListResponse result = Json.Deserialize<WechatWorkAppApiGetAppListResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GetAppListRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/cgi-bin/agent/list", query, "", WechatCredentialKind.AccessToken);
    }

}
