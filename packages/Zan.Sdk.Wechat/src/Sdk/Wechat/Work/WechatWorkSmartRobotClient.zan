using System;
using System.Text;
using System.Net.WebSocket.Secure;
using System.Security.Cryptography;
using System.Json;

namespace Sdk.Wechat.Work;

// aibot 线上协议：{cmd, headers:{req_id}, body}。`body` 是
// JsonValue 透传，因为调用方会提供任意回复 JSON；空的
// body 序列化为 JSON null，与旧的原生 "null" 字面量完全一致。

public class WechatWorkSmartRobotClient {
    WssClient socket;
    string host;
    int port;
    string path;

    public WechatWorkSmartRobotClient() {
        this.host = "openws.work.weixin.qq.com";
        this.port = 443;
        this.path = "/";
        this.socket = null;
    }

    public WechatWorkSmartRobotClient Endpoint(string host, int port, string path) {
        this.host = host; this.port = port; this.path = path;
        return this;
    }

    public async void ConnectAndSubscribeAsync(string botId, string secret) {
        if (this.socket != null) {
            await this.socket.Close();
            this.socket = null;
        }
        WssClient ws = await WssClient.ConnectAsync(this.host, this.port, this.path);
        if (ws == null || !ws.IsConnected()) {
            if (ws != null) { await ws.Close(); }
            throw new InvalidOperationException("企业微信智能机器人 WSS 连接失败");
        }
        this.socket = ws;
        try {
            WwRobotAuthBody auth = new WwRobotAuthBody();
            auth.bot_id = botId;
            auth.secret = secret;
            await this.SendCommandAsync("aibot_subscribe", CreateRequestId(),
                Json.Serialize<WwRobotAuthBody>(auth));
        } catch (Exception e) {
            await this.CloseAsync();
            throw e;
        }
    }

    public async string ReceiveAsync() {
        WssClient ws = this.socket;
        if (ws == null) { return ""; }
        return await ws.RecvText();
    }

    public async void RespondWelcomeAsync(string requestId, string replyJson) {
        await this.SendCommandAsync("aibot_respond_welcome_msg", requestId, replyJson);
    }

    public async void RespondAsync(string requestId, string replyJson) {
        await this.SendCommandAsync("aibot_respond_msg", requestId, replyJson);
    }

    public async void UpdateResponseAsync(string requestId, string replyJson) {
        await this.SendCommandAsync("aibot_respond_update_msg", requestId, replyJson);
    }

    public async void SendMessageAsync(string requestId, string messageJson) {
        await this.SendCommandAsync("aibot_send_msg", requestId, messageJson);
    }

    public async void SendPingAsync(string requestId) {
        string id = requestId == null ? "" : requestId;
        if (id.Length == 0) { id = CreateRequestId(); }
        await this.SendCommandAsync("ping", id, "");
    }

    public async void SendCommandAsync(string command, string requestId, string bodyJson) {
        WssClient ws = this.socket;
        if (ws == null || !ws.IsConnected()) {
            throw new InvalidOperationException("企业微信智能机器人长连接尚未建立");
        }
        WwCommandEnvelope envelope = new WwCommandEnvelope();
        envelope.cmd = command == null ? "" : command;
        envelope.headers = new WwCommandHeaders();
        envelope.headers.req_id = requestId == null ? "" : requestId;
        if (bodyJson != null && bodyJson.Length > 0) {
            envelope.body = JsonValue.ParseLenient(bodyJson);
        }
        await ws.SendText(Json.Serialize<WwCommandEnvelope>(envelope));
    }

    public async void CloseAsync() {
        WssClient ws = this.socket;
        this.socket = null;
        if (ws != null) { await ws.Close(); }
    }

    public static string CreateRequestId() {
        byte[] bytes = RandomNumberGenerator.GetBytes(16);
        if (bytes == null || bytes.Length < 16) {
            throw new InvalidOperationException("企业微信机器人请求 ID 随机数生成失败");
        }
        return Hex.Encode(bytes, 16);
    }
}
