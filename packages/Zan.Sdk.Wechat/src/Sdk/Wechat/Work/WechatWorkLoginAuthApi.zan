using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkLoginAuthApi {
    WechatWorkClient client;

    public WechatWorkLoginAuthApi(WechatWorkClient client) {
        this.client = client;
    }

    public async WechatWorkLoginAuthApiGetLoginUrlResponse GetLoginUrlAsync(WechatWorkLoginAuthApiGetLoginUrlRequest request) {
        if (request == null) { request = new WechatWorkLoginAuthApiGetLoginUrlRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/service/get_login_url", request.QueryText(), request.JsonBody(), WechatCredentialKind.ProviderAccessToken);
        WechatWorkLoginAuthApiGetLoginUrlResponse result = Json.Deserialize<WechatWorkLoginAuthApiGetLoginUrlResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse GetLoginUrlRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/service/get_login_url", query, jsonBody, WechatCredentialKind.ProviderAccessToken);
    }

}
