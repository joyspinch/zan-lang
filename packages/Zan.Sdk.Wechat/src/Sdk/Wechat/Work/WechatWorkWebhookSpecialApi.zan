using System;
using System.Collections.Generic;

namespace Sdk.Wechat.Work;

public class WechatWorkWebhookSpecialApi {
    WechatWorkClient client;
    public WechatWorkWebhookSpecialApi(WechatWorkClient client) { this.client = client; }

    public async WechatResponse UploadMediaAsync(string key, string fileName,
                                                 string contentType, string fileBytes) {
        WechatMultipart form = WechatMultipart.ForFile("media", fileName, contentType, fileBytes);
        string query = "key=" + Encoding.UrlEncode(key) + "&type=file";
        return await this.client.UploadJsonAsync("/cgi-bin/webhook/upload_media",
            query, form, WechatCredentialKind.None);
    }
}
