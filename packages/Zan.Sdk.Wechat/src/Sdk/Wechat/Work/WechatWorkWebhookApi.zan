using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkWebhookApi {
    WechatWorkClient client;

    public WechatWorkWebhookApi(WechatWorkClient client) {
        this.client = client;
    }

    public async WechatWorkWebhookApiSendTextResponse SendTextAsync(WechatWorkWebhookApiSendTextRequest request) {
        if (request == null) { request = new WechatWorkWebhookApiSendTextRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/webhook/send", request.QueryText(), request.JsonBody(), WechatCredentialKind.None);
        WechatWorkWebhookApiSendTextResponse result = Json.Deserialize<WechatWorkWebhookApiSendTextResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse SendTextRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/webhook/send", query, jsonBody, WechatCredentialKind.None);
    }

