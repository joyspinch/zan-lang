using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkMiniProgramMiniApi {
    WechatWorkClient client;

    public WechatWorkMiniProgramMiniApi(WechatWorkClient client) {
        this.client = client;
    }

    public async WechatWorkMiniProgramMiniApiLoginCheckResponse LoginCheckAsync(WechatWorkMiniProgramMiniApiLoginCheckRequest request) {
        if (request == null) { request = new WechatWorkMiniProgramMiniApiLoginCheckRequest(); }
        WechatResponse raw = await this.client.RequestAsync("GET", "/cgi-bin/miniprogram/jscode2session", request.QueryText(), "", WechatCredentialKind.AccessToken);
        WechatWorkMiniProgramMiniApiLoginCheckResponse result = Json.Deserialize<WechatWorkMiniProgramMiniApiLoginCheckResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse LoginCheckRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/cgi-bin/miniprogram/jscode2session", query, "", WechatCredentialKind.AccessToken);
    }

    public async WechatWorkMiniProgramMiniApiThirdLoginCheckResponse ThirdLoginCheckAsync(WechatWorkMiniProgramMiniApiThirdLoginCheckRequest request) {
        if (request == null) { request = new WechatWorkMiniProgramMiniApiThirdLoginCheckRequest(); }
        WechatResponse raw = await this.client.RequestAsync("GET", "/cgi-bin/service/miniprogram/jscode2session", request.QueryText(), "", WechatCredentialKind.SuiteAccessToken);
        WechatWorkMiniProgramMiniApiThirdLoginCheckResponse result = Json.Deserialize<WechatWorkMiniProgramMiniApiThirdLoginCheckResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse ThirdLoginCheckRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/cgi-bin/service/miniprogram/jscode2session", query, "", WechatCredentialKind.SuiteAccessToken);
    }

    public async WechatWorkMiniProgramMiniApiTransferSessionResponse TransferSessionAsync(WechatWorkMiniProgramMiniApiTransferSessionRequest request) {
        if (request == null) { request = new WechatWorkMiniProgramMiniApiTransferSessionRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/miniprogram/transfer_session", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWorkMiniProgramMiniApiTransferSessionResponse result = Json.Deserialize<WechatWorkMiniProgramMiniApiTransferSessionResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse TransferSessionRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/miniprogram/transfer_session", query, jsonBody, WechatCredentialKind.AccessToken);
    }

}
