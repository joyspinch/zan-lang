using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkIdConvertApi {
    WechatWorkClient client;

    public WechatWorkIdConvertApi(WechatWorkClient client) {
        this.client = client;
    }

    async WechatWorkIdConvertApiUpgradeChatIdForNewCorpResponse UpgradeChatIdForNewCorpAsync(WechatWorkIdConvertApiUpgradeChatIdForNewCorpRequest request) {
        if (request == null) { request = new WechatWorkIdConvertApiUpgradeChatIdForNewCorpRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/idconvert/upgrade_chatid_for_new_corp", request.QueryText(), request.JsonBody(), WechatCredentialKind.SuiteAccessToken);
        WechatWorkIdConvertApiUpgradeChatIdForNewCorpResponse result = Json.Deserialize<WechatWorkIdConvertApiUpgradeChatIdForNewCorpResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse UpgradeChatIdForNewCorpRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/idconvert/upgrade_chatid_for_new_corp", query, jsonBody, WechatCredentialKind.SuiteAccessToken);
    }

}
