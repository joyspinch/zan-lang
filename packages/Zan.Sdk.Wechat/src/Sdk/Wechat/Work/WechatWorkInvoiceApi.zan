using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkInvoiceApi {
    WechatWorkClient client;

    public WechatWorkInvoiceApi(WechatWorkClient client) {
        this.client = client;
    }

    async WechatWorkInvoiceApiGetInvoiceInfoResponse GetInvoiceInfoAsync(WechatWorkInvoiceApiGetInvoiceInfoRequest request) {
        if (request == null) { request = new WechatWorkInvoiceApiGetInvoiceInfoRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/card/invoice/reimburse/getinvoiceinfo", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWorkInvoiceApiGetInvoiceInfoResponse result = Json.Deserialize<WechatWorkInvoiceApiGetInvoiceInfoResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GetInvoiceInfoRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/card/invoice/reimburse/getinvoiceinfo", query, jsonBody, WechatCredentialKind.AccessToken);
    }

    async WechatWorkInvoiceApiGetInvoiceListInfoResponse GetInvoiceListInfoAsync(WechatWorkInvoiceApiGetInvoiceListInfoRequest request) {
        if (request == null) { request = new WechatWorkInvoiceApiGetInvoiceListInfoRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/card/invoice/reimburse/getinvoicebatch", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWorkInvoiceApiGetInvoiceListInfoResponse result = Json.Deserialize<WechatWorkInvoiceApiGetInvoiceListInfoResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GetInvoiceListInfoRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/card/invoice/reimburse/getinvoicebatch", query, jsonBody, WechatCredentialKind.AccessToken);
    }

    async WechatWorkInvoiceApiUpdateInvoiceStatusResponse UpdateInvoiceStatusAsync(WechatWorkInvoiceApiUpdateInvoiceStatusRequest request) {
        if (request == null) { request = new WechatWorkInvoiceApiUpdateInvoiceStatusRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/card/invoice/reimburse/updateinvoicestatus", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWorkInvoiceApiUpdateInvoiceStatusResponse result = Json.Deserialize<WechatWorkInvoiceApiUpdateInvoiceStatusResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse UpdateInvoiceStatusRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/card/invoice/reimburse/updateinvoicestatus", query, jsonBody, WechatCredentialKind.AccessToken);
    }

    async WechatWorkInvoiceApiUpdateInvoiceListStatusResponse UpdateInvoiceListStatusAsync(WechatWorkInvoiceApiUpdateInvoiceListStatusRequest request) {
        if (request == null) { request = new WechatWorkInvoiceApiUpdateInvoiceListStatusRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/card/invoice/reimburse/updatestatusbatch", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWorkInvoiceApiUpdateInvoiceListStatusResponse result = Json.Deserialize<WechatWorkInvoiceApiUpdateInvoiceListStatusResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse UpdateInvoiceListStatusRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/card/invoice/reimburse/updatestatusbatch", query, jsonBody, WechatCredentialKind.AccessToken);
    }

}
