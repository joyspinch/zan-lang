using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkMailListCurrentApi {
    WechatWorkClient client;

    public WechatWorkMailListCurrentApi(WechatWorkClient client) {
        this.client = client;
    }

    async WechatWorkMailListCurrentApiGetJoinQrcodeResponse GetJoinQrcodeAsync(WechatWorkMailListCurrentApiGetJoinQrcodeRequest request) {
        if (request == null) { request = new WechatWorkMailListCurrentApiGetJoinQrcodeRequest(); }
        WechatResponse raw = await this.client.RequestAsync("GET", "/cgi-bin/corp/get_join_qrcode", request.QueryText(), "", WechatCredentialKind.AccessToken);
        WechatWorkMailListCurrentApiGetJoinQrcodeResponse result = Json.Deserialize<WechatWorkMailListCurrentApiGetJoinQrcodeResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GetJoinQrcodeRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/cgi-bin/corp/get_join_qrcode", query, "", WechatCredentialKind.AccessToken);
    }

    async WechatWorkMailListCurrentApiGetDepartmentResponse GetDepartmentAsync(WechatWorkMailListCurrentApiGetDepartmentRequest request) {
        if (request == null) { request = new WechatWorkMailListCurrentApiGetDepartmentRequest(); }
        WechatResponse raw = await this.client.RequestAsync("GET", "/cgi-bin/department/get", request.QueryText(), "", WechatCredentialKind.AccessToken);
        WechatWorkMailListCurrentApiGetDepartmentResponse result = Json.Deserialize<WechatWorkMailListCurrentApiGetDepartmentResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GetDepartmentRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/cgi-bin/department/get", query, "", WechatCredentialKind.AccessToken);
    }

}
