using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkKFApi {
    WechatWorkClient client;

    public WechatWorkKFApi(WechatWorkClient client) {
        this.client = client;
    }

    public async WechatWorkKFApiSendTextResponse SendTextAsync(WechatWorkKFApiSendTextRequest request) {
        if (request == null) { request = new WechatWorkKFApiSendTextRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/kf/send", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWorkKFApiSendTextResponse result = Json.Deserialize<WechatWorkKFApiSendTextResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse SendTextRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/kf/send", query, jsonBody, WechatCredentialKind.AccessToken);
    }

    public async WechatWorkKFApiSendImageResponse SendImageAsync(WechatWorkKFApiSendImageRequest request) {
        if (request == null) { request = new WechatWorkKFApiSendImageRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/kf/send", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWorkKFApiSendImageResponse result = Json.Deserialize<WechatWorkKFApiSendImageResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse SendImageRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/kf/send", query, jsonBody, WechatCredentialKind.AccessToken);
    }

    public async WechatWorkKFApiSendFileResponse SendFileAsync(WechatWorkKFApiSendFileRequest request) {
        if (request == null) { request = new WechatWorkKFApiSendFileRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/kf/send", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWorkKFApiSendFileResponse result = Json.Deserialize<WechatWorkKFApiSendFileResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse SendFileRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/kf/send", query, jsonBody, WechatCredentialKind.AccessToken);
    }

    public async WechatWorkKFApiSendVoiceResponse SendVoiceAsync(WechatWorkKFApiSendVoiceRequest request) {
        if (request == null) { request = new WechatWorkKFApiSendVoiceRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/kf/send", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWorkKFApiSendVoiceResponse result = Json.Deserialize<WechatWorkKFApiSendVoiceResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse SendVoiceRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/kf/send", query, jsonBody, WechatCredentialKind.AccessToken);
    }

    public async WechatWorkKFApiGetKFListResponse GetKFListAsync(WechatWorkKFApiGetKFListRequest request) {
        if (request == null) { request = new WechatWorkKFApiGetKFListRequest(); }
        WechatResponse raw = await this.client.RequestAsync("GET", "/cgi-bin/kf/list", request.QueryText(), "", WechatCredentialKind.AccessToken);
        WechatWorkKFApiGetKFListResponse result = Json.Deserialize<WechatWorkKFApiGetKFListResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse GetKFListRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/cgi-bin/kf/list", query, "", WechatCredentialKind.AccessToken);
    }

}
