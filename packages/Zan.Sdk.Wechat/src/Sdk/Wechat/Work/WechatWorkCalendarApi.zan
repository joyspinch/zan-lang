using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkCalendarApi {
    WechatWorkClient client;

    public WechatWorkCalendarApi(WechatWorkClient client) {
        this.client = client;
    }

    async WechatWorkCalendarApiAddResponse AddAsync(WechatWorkCalendarApiAddRequest request) {
        if (request == null) { request = new WechatWorkCalendarApiAddRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/oa/calendar/add", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWorkCalendarApiAddResponse result = Json.Deserialize<WechatWorkCalendarApiAddResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse AddRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/oa/calendar/add", query, jsonBody, WechatCredentialKind.AccessToken);
    }

    async WechatWorkCalendarApiUpdateResponse UpdateAsync(WechatWorkCalendarApiUpdateRequest request) {
        if (request == null) { request = new WechatWorkCalendarApiUpdateRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/oa/calendar/update", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWorkCalendarApiUpdateResponse result = Json.Deserialize<WechatWorkCalendarApiUpdateResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse UpdateRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/oa/calendar/update", query, jsonBody, WechatCredentialKind.AccessToken);
    }

    async WechatWorkCalendarApiGetResponse GetAsync(WechatWorkCalendarApiGetRequest request) {
        if (request == null) { request = new WechatWorkCalendarApiGetRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/oa/calendar/get", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWorkCalendarApiGetResponse result = Json.Deserialize<WechatWorkCalendarApiGetResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GetRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/oa/calendar/get", query, jsonBody, WechatCredentialKind.AccessToken);
    }

    async WechatWorkCalendarApiDelResponse DelAsync(WechatWorkCalendarApiDelRequest request) {
        if (request == null) { request = new WechatWorkCalendarApiDelRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/oa/calendar/del", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWorkCalendarApiDelResponse result = Json.Deserialize<WechatWorkCalendarApiDelResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse DelRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/oa/calendar/del", query, jsonBody, WechatCredentialKind.AccessToken);
    }

}
