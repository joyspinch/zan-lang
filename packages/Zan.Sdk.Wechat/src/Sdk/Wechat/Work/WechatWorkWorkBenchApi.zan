using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkWorkBenchApi {
    WechatWorkClient client;

    public WechatWorkWorkBenchApi(WechatWorkClient client) {
        this.client = client;
    }

    public async WechatWorkWorkBenchApiSetWorkBenchTemplateResponse SetWorkBenchTemplateAsync(WechatWorkWorkBenchApiSetWorkBenchTemplateRequest request) {
        if (request == null) { request = new WechatWorkWorkBenchApiSetWorkBenchTemplateRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/agent/set_workbench_template", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWorkWorkBenchApiSetWorkBenchTemplateResponse result = Json.Deserialize<WechatWorkWorkBenchApiSetWorkBenchTemplateResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse SetWorkBenchTemplateRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/agent/set_workbench_template", query, jsonBody, WechatCredentialKind.AccessToken);
    }

    public async WechatWorkWorkBenchApiGetWorkBenchTemplateResponse GetWorkBenchTemplateAsync(WechatWorkWorkBenchApiGetWorkBenchTemplateRequest request) {
        if (request == null) { request = new WechatWorkWorkBenchApiGetWorkBenchTemplateRequest(); }
        WechatResponse raw = await this.client.RequestAsync("GET", "/cgi-bin/agent/get_workbench_template", request.QueryText(), "", WechatCredentialKind.AccessToken);
        WechatWorkWorkBenchApiGetWorkBenchTemplateResponse result = Json.Deserialize<WechatWorkWorkBenchApiGetWorkBenchTemplateResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse GetWorkBenchTemplateRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/cgi-bin/agent/get_workbench_template", query, "", WechatCredentialKind.AccessToken);
    }

    public async WechatWorkWorkBenchApiSetWorkBenchDataResponse SetWorkBenchDataAsync(WechatWorkWorkBenchApiSetWorkBenchDataRequest request) {
        if (request == null) { request = new WechatWorkWorkBenchApiSetWorkBenchDataRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/agent/set_workbench_data", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWorkWorkBenchApiSetWorkBenchDataResponse result = Json.Deserialize<WechatWorkWorkBenchApiSetWorkBenchDataResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse SetWorkBenchDataRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/agent/set_workbench_data", query, jsonBody, WechatCredentialKind.AccessToken);
    }

}
