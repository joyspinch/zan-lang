using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkShakeAroundApi {
    WechatWorkClient client;

    public WechatWorkShakeAroundApi(WechatWorkClient client) {
        this.client = client;
    }

    async WechatWorkShakeAroundApiGetSuiteTokenResponse GetSuiteTokenAsync(WechatWorkShakeAroundApiGetSuiteTokenRequest request) {
        if (request == null) { request = new WechatWorkShakeAroundApiGetSuiteTokenRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/shakearound/getshakeinfo", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWorkShakeAroundApiGetSuiteTokenResponse result = Json.Deserialize<WechatWorkShakeAroundApiGetSuiteTokenResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GetSuiteTokenRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/shakearound/getshakeinfo", query, jsonBody, WechatCredentialKind.AccessToken);
    }

}
