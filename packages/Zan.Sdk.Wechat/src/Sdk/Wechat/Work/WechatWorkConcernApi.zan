using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkConcernApi {
    WechatWorkClient client;

    public WechatWorkConcernApi(WechatWorkClient client) {
        this.client = client;
    }

    public async WechatWorkConcernApiTwoVerificationResponse TwoVerificationAsync(WechatWorkConcernApiTwoVerificationRequest request) {
        if (request == null) { request = new WechatWorkConcernApiTwoVerificationRequest(); }
        WechatResponse raw = await this.client.RequestAsync("GET", "/cgi-bin/user/authsucc", request.QueryText(), "", WechatCredentialKind.AccessToken);
        WechatWorkConcernApiTwoVerificationResponse result = Json.Deserialize<WechatWorkConcernApiTwoVerificationResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse TwoVerificationRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/cgi-bin/user/authsucc", query, "", WechatCredentialKind.AccessToken);
    }

}
