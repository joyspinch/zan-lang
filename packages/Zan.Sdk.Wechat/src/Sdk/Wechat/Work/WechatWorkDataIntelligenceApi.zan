using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkDataIntelligenceApi {
    WechatWorkClient client;

    public WechatWorkDataIntelligenceApi(WechatWorkClient client) {
        this.client = client;
    }

    async WechatWorkDataIntelligenceApiGetConversationRecordsResponse GetConversationRecordsAsync(WechatWorkDataIntelligenceApiGetConversationRecordsRequest request) {
        if (request == null) { request = new WechatWorkDataIntelligenceApiGetConversationRecordsRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/data/get_conversation_records", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWorkDataIntelligenceApiGetConversationRecordsResponse result = Json.Deserialize<WechatWorkDataIntelligenceApiGetConversationRecordsResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GetConversationRecordsRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/data/get_conversation_records", query, jsonBody, WechatCredentialKind.AccessToken);
    }

    async WechatWorkDataIntelligenceApiGetMessageStatisticsResponse GetMessageStatisticsAsync(WechatWorkDataIntelligenceApiGetMessageStatisticsRequest request) {
        if (request == null) { request = new WechatWorkDataIntelligenceApiGetMessageStatisticsRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/data/get_message_statistics", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWorkDataIntelligenceApiGetMessageStatisticsResponse result = Json.Deserialize<WechatWorkDataIntelligenceApiGetMessageStatisticsResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GetMessageStatisticsRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/data/get_message_statistics", query, jsonBody, WechatCredentialKind.AccessToken);
    }

}
