using System;
using System.Security.Cryptography;

namespace Sdk.Wechat;

/// <summary>
/// 微信服务器 URL 接入时的签名校验（公众号 / 小程序服务器配置）。
///
/// 规则与官方一致：把 token、timestamp、nonce 三个字符串按字典序排序后拼接，
/// 做 SHA-1，得到 40 位小写十六进制；与微信传来的 signature 比对。
///
/// 直接使用 <see cref="Sha1"/> / <see cref="Hex"/>，不自造摘要实现。
/// </summary>
class CheckSignature {
    /// <summary>默认 Token。历史遗留的公开常量：token 忘配时回落到
    /// 它等于让签名形同虚设（"weixin" 谁都知道），因此校验路径
    /// 不再回落——空 token 一律拒绝（fail-closed）。字段仅为兼容
    /// 既有引用保留，新代码不要依赖。</summary>
    public static string DefaultToken = "weixin";

    /// <summary>检查 signature 是否与 token/timestamp/nonce 匹配。
    /// 空签名/空 token 直接拒绝；比较用常数时间（防逐字节探测）。</summary>
    static bool Check(string signature, string timestamp, string nonce, string token) {
        if (signature.Length == 0 || token.Length == 0) { return false; }
        string expected = CheckSignature.GetSignature(timestamp, nonce, token);
        if (expected.Length == 0) { return false; }
        return Jwt.fixedEquals(signature, signature.Length, expected, expected.Length);
    }

    /// <summary>
    /// 计算签名。token 为空返回空串（调用方按拒绝处理），
    /// 不再回落 <see cref="DefaultToken"/>。
    /// </summary>
    static string GetSignature(string timestamp, string nonce, string token) {
        if (token.Length == 0) { return ""; }
        string joined = CheckSignature.JoinSorted(token, timestamp, nonce);
        byte[] digest = Sha1.Hash(joined, joined.Length);
        return Hex.Encode(digest, 20);
    }

    /// <summary>
    /// 把三个字符串按字典序（ordinal）排序后拼接。数量固定为 3，插入排序即可。
    /// </summary>
    static string JoinSorted(string a, string b, string c) {
        string x = a;
        string y = b;
        string z = c;
        if (String.CompareOrdinal(x, y) > 0) {
            string tmp = x; x = y; y = tmp;
        }
        if (String.CompareOrdinal(y, z) > 0) {
            string tmp = y; y = z; z = tmp;
        }
        if (String.CompareOrdinal(x, y) > 0) {
            string tmp = x; x = y; y = tmp;
        }
        return x + y + z;
    }
}
