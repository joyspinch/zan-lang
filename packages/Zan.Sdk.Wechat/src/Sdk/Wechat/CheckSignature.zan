using System;
using System.Collections.Generic;
using System.Security.Cryptography;

namespace Sdk.Wechat;

// 微信服务器 URL 接入签名校验（token/timestamp/nonce 字典序拼接后 SHA-1，fail-closed）。
public class CheckSignature {
    public static string DefaultToken = "weixin";

    public static bool Check(string signature, string timestamp, string nonce, string token) {
        if (signature == null || signature.Length == 0 || token == null || token.Length == 0) { return false; }
        string expected = CheckSignature.GetSignature(timestamp, nonce, token);
        if (expected.Length == 0) { return false; }
        // 常数时间比对，防逐字节探测。
        return Jwt.fixedEquals(signature, signature.Length, expected, expected.Length);
    }

    public static string GetSignature(string timestamp, string nonce, string token) {
        if (token == null || token.Length == 0) { return ""; }
        string ts = timestamp == null ? "" : timestamp;
        string nc = nonce == null ? "" : nonce;
        string joined = CheckSignature.JoinSorted(token, ts, nc);
        byte[] digest = Sha1.Hash(joined, joined.Length);
        return Hex.Encode(digest, 20);
    }

    private static string JoinSorted(string a, string b, string c) {
        List<string> xs = new List<string>{ a, b, c };
        xs.Sort();
        return xs[0] + xs[1] + xs[2];
    }
}
