using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3PayScorePayScoreApisApiSyncPayServiceOrderRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3PayScorePayScoreApisApiSyncPayServiceOrderRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3PayScorePayScoreApisApiSyncPayServiceOrderRequest OutOrderNo(string fieldValue) {
        this.request.PathString("out_order_no", fieldValue);
        return this;
    }

    WechatPayV3PayScorePayScoreApisApiSyncPayServiceOrderRequest Appid(string fieldValue) {
        this.request.BodyString("appid", fieldValue);
        return this;
    }

    WechatPayV3PayScorePayScoreApisApiSyncPayServiceOrderRequest ServiceId(string fieldValue) {
        this.request.BodyString("service_id", fieldValue);
        return this;
    }

    WechatPayV3PayScorePayScoreApisApiSyncPayServiceOrderRequest Type(string fieldValue) {
        this.request.BodyString("type", fieldValue);
        return this;
    }

    WechatPayV3PayScorePayScoreApisApiSyncPayServiceOrderRequest Detail(WechatPayPayScoreSyncPayServiceOrderRequestDataDetail fieldValue) {
        this.request.BodyJson("detail", Json.Serialize<WechatPayPayScoreSyncPayServiceOrderRequestDataDetail>(fieldValue));
        return this;
    }

    WechatPayV3PayScorePayScoreApisApiSyncPayServiceOrderRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/payscore/serviceorder/{data.out_order_no}/sync";
        result = result.Replace("{data.out_order_no}", Encoding.UrlEncode(this.request.ValueText("out_order_no")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
