using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3VehicleParkingVehicleParkingApisApiQueryParkingRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3VehicleParkingVehicleParkingApisApiQueryParkingRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    public WechatPayV3VehicleParkingVehicleParkingApisApiQueryParkingRequest OutTradeNo(string fieldValue) {
        this.request.PathString("out_trade_no", fieldValue);
        return this;
    }

    public WechatPayV3VehicleParkingVehicleParkingApisApiQueryParkingRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    public string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/vehicle/transactions/out-trade-no/{out_trade_no}";
        result = result.Replace("{out_trade_no}", Encoding.UrlEncode(this.request.ValueText("out_trade_no")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
