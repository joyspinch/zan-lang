using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3PayScorePayScoreApisApiModifyGuideRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3PayScorePayScoreApisApiModifyGuideRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3PayScorePayScoreApisApiModifyGuideRequest GuideId(string fieldValue) {
        this.request.PathString("guide_id", fieldValue);
        return this;
    }

    WechatPayV3PayScorePayScoreApisApiModifyGuideRequest Name(string fieldValue) {
        this.request.BodyString("name", fieldValue);
        return this;
    }

    WechatPayV3PayScorePayScoreApisApiModifyGuideRequest Mobile(string fieldValue) {
        this.request.BodyString("mobile", fieldValue);
        return this;
    }

    WechatPayV3PayScorePayScoreApisApiModifyGuideRequest QrCode(string fieldValue) {
        this.request.BodyString("qr_code", fieldValue);
        return this;
    }

    WechatPayV3PayScorePayScoreApisApiModifyGuideRequest Avatar(string fieldValue) {
        this.request.BodyString("avatar", fieldValue);
        return this;
    }

    WechatPayV3PayScorePayScoreApisApiModifyGuideRequest GroupQrcode(string fieldValue) {
        this.request.BodyString("group_qrcode", fieldValue);
        return this;
    }

    WechatPayV3PayScorePayScoreApisApiModifyGuideRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/smartguide/guides/{data.guide_id}";
        result = result.Replace("{data.guide_id}", Encoding.UrlEncode(this.request.ValueText("guide_id")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
