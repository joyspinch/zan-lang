using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3EcommerceEcommerceApisAccountFundsApiQueryPlatformBalanceRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3EcommerceEcommerceApisAccountFundsApiQueryPlatformBalanceRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3EcommerceEcommerceApisAccountFundsApiQueryPlatformBalanceRequest AccountType(string fieldValue) {
        this.request.QueryString("accountType", fieldValue);
        return this;
    }

    WechatPayV3EcommerceEcommerceApisAccountFundsApiQueryPlatformBalanceRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/merchant/fund/balance/{EscapeAccountFundsValue(accountType)}";
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
