        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    public WechatPayV3ParkingReminderParkingReminderApisApiSyncExtensionPaymentRequest OutTradeNo(string fieldValue) {
        this.request.BodyString("out_trade_no", fieldValue);
