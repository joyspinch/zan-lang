    public WechatPayV3ParkingReminderParkingReminderApisApiSyncExtensionPaymentRequest FeeItems(List<WechatPayParkingExtensionFeeItem> fieldValue) {
        this.request.BodyJson("fee_items", Json.Serialize<List<WechatPayParkingExtensionFeeItem>>(fieldValue));
