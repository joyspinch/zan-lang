using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3PayScorePayScoreApisApiGivePermissionRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3PayScorePayScoreApisApiGivePermissionRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3PayScorePayScoreApisApiGivePermissionRequest ServiceId(string fieldValue) {
        this.request.BodyString("service_id", fieldValue);
        return this;
    }

    WechatPayV3PayScorePayScoreApisApiGivePermissionRequest Appid(string fieldValue) {
        this.request.BodyString("appid", fieldValue);
        return this;
    }

    WechatPayV3PayScorePayScoreApisApiGivePermissionRequest AuthorizationCode(string fieldValue) {
        this.request.BodyString("authorization_code", fieldValue);
        return this;
    }

    WechatPayV3PayScorePayScoreApisApiGivePermissionRequest NotifyUrl(string fieldValue) {
        this.request.BodyString("notify_url", fieldValue);
        return this;
    }

    WechatPayV3PayScorePayScoreApisApiGivePermissionRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/payscore/permissions";
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
