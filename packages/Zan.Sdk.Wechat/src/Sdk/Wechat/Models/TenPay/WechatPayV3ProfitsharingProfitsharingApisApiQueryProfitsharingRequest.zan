using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3ProfitsharingProfitsharingApisApiQueryProfitsharingRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3ProfitsharingProfitsharingApisApiQueryProfitsharingRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3ProfitsharingProfitsharingApisApiQueryProfitsharingRequest TransactionId(string fieldValue) {
        this.request.QueryString("transaction_id", fieldValue);
        return this;
    }

    WechatPayV3ProfitsharingProfitsharingApisApiQueryProfitsharingRequest OutOrderNo(string fieldValue) {
        this.request.PathString("out_order_no", fieldValue);
        return this;
    }

    WechatPayV3ProfitsharingProfitsharingApisApiQueryProfitsharingRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/profitsharing/orders/{out_order_no}";
        result = result.Replace("{out_order_no}", Encoding.UrlEncode(this.request.ValueText("out_order_no")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
