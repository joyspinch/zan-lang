using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3BasePayBasePayApisApiOrderQueryByTransactionIdRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3BasePayBasePayApisApiOrderQueryByTransactionIdRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3BasePayBasePayApisApiOrderQueryByTransactionIdRequest TransactionId(string fieldValue) {
        this.request.PathString("transaction_id", fieldValue);
        return this;
    }

    WechatPayV3BasePayBasePayApisApiOrderQueryByTransactionIdRequest Mchid(string fieldValue) {
        this.request.QueryString("mchid", fieldValue);
        return this;
    }

    WechatPayV3BasePayBasePayApisApiOrderQueryByTransactionIdRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/pay/transactions/id/{transaction_id}";
        result = result.Replace("{transaction_id}", Encoding.UrlEncode(this.request.ValueText("transaction_id")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
