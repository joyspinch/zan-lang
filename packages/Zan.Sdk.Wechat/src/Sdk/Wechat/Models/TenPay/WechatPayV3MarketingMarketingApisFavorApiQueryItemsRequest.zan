using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3MarketingMarketingApisFavorApiQueryItemsRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3MarketingMarketingApisFavorApiQueryItemsRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3MarketingMarketingApisFavorApiQueryItemsRequest Offset(long fieldValue) {
        this.request.QueryLong("offset", fieldValue);
        return this;
    }

    WechatPayV3MarketingMarketingApisFavorApiQueryItemsRequest Limit(long fieldValue) {
        this.request.QueryLong("limit", fieldValue);
        return this;
    }

    WechatPayV3MarketingMarketingApisFavorApiQueryItemsRequest StockCreatorMchid(string fieldValue) {
        this.request.QueryString("stock_creator_mchid", fieldValue);
        return this;
    }

    WechatPayV3MarketingMarketingApisFavorApiQueryItemsRequest StockId(string fieldValue) {
        this.request.PathString("stock_id", fieldValue);
        return this;
    }

    WechatPayV3MarketingMarketingApisFavorApiQueryItemsRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/marketing/favor/stocks/{stock_id}/items";
        result = result.Replace("{stock_id}", Encoding.UrlEncode(this.request.ValueText("stock_id")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

