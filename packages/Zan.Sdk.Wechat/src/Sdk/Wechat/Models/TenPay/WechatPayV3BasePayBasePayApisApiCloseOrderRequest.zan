using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3BasePayBasePayApisApiCloseOrderRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3BasePayBasePayApisApiCloseOrderRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3BasePayBasePayApisApiCloseOrderRequest Mchid(string fieldValue) {
        this.request.BodyString("mchid", fieldValue);
        return this;
    }

    WechatPayV3BasePayBasePayApisApiCloseOrderRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/pay/transactions/out-trade-no/{out_trade_no}/close";
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
