using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3ComplaintComplaintApisApiResponseRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3ComplaintComplaintApisApiResponseRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3ComplaintComplaintApisApiResponseRequest ComplaintId(string fieldValue) {
        this.request.PathString("complaint_id", fieldValue);
        return this;
    }

    WechatPayV3ComplaintComplaintApisApiResponseRequest ComplaintedMchid(string fieldValue) {
        this.request.BodyString("complainted_mchid", fieldValue);
        return this;
    }

    WechatPayV3ComplaintComplaintApisApiResponseRequest ResponseContent(string fieldValue) {
        this.request.BodyString("response_content", fieldValue);
        return this;
    }

    WechatPayV3ComplaintComplaintApisApiResponseRequest ResponseImages(List<string> fieldValue) {
        this.request.BodyStrings("response_images", fieldValue);
        return this;
    }

    WechatPayV3ComplaintComplaintApisApiResponseRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/merchant-service/complaints-v2/{data.complaint_id}/response";
        result = result.Replace("{data.complaint_id}", Encoding.UrlEncode(this.request.ValueText("complaint_id")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
