using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3PayScorePayScoreApisApiCompleteServiceOrderRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3PayScorePayScoreApisApiCompleteServiceOrderRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3PayScorePayScoreApisApiCompleteServiceOrderRequest OutOrderNo(string fieldValue) {
        this.request.PathString("out_order_no", fieldValue);
        return this;
    }

    WechatPayV3PayScorePayScoreApisApiCompleteServiceOrderRequest Appid(string fieldValue) {
        this.request.BodyString("appid", fieldValue);
        return this;
    }

    WechatPayV3PayScorePayScoreApisApiCompleteServiceOrderRequest ServiceId(string fieldValue) {
        this.request.BodyString("service_id", fieldValue);
        return this;
    }

    WechatPayV3PayScorePayScoreApisApiCompleteServiceOrderRequest PostPayments(List<WechatPayPayScoreCompleteServiceOrderRequestDataPostPayment> fieldValue) {
        this.request.BodyJson("post_payments", Json.Serialize<List<WechatPayPayScoreCompleteServiceOrderRequestDataPostPayment>>(fieldValue));
        return this;
    }

    WechatPayV3PayScorePayScoreApisApiCompleteServiceOrderRequest PostDiscounts(List<WechatPayPayScoreCompleteServiceOrderRequestDataPostDiscount> fieldValue) {
        this.request.BodyJson("post_discounts", Json.Serialize<List<WechatPayPayScoreCompleteServiceOrderRequestDataPostDiscount>>(fieldValue));
        return this;
    }

    WechatPayV3PayScorePayScoreApisApiCompleteServiceOrderRequest TotalAmount(long fieldValue) {
        this.request.BodyLong("total_amount", fieldValue);
        return this;
    }

    WechatPayV3PayScorePayScoreApisApiCompleteServiceOrderRequest TimeRange(WechatPayPayScoreCompleteServiceOrderRequestDataTimeRange fieldValue) {
        this.request.BodyJson("time_range", Json.Serialize<WechatPayPayScoreCompleteServiceOrderRequestDataTimeRange>(fieldValue));
        return this;
    }

    WechatPayV3PayScorePayScoreApisApiCompleteServiceOrderRequest Location(WechatPayPayScoreCompleteServiceOrderRequestDataLocation fieldValue) {
        this.request.BodyJson("location", Json.Serialize<WechatPayPayScoreCompleteServiceOrderRequestDataLocation>(fieldValue));
        return this;
    }

    WechatPayV3PayScorePayScoreApisApiCompleteServiceOrderRequest ProfitSharing(bool fieldValue) {
        this.request.BodyBool("profit_sharing", fieldValue);
        return this;
    }

    WechatPayV3PayScorePayScoreApisApiCompleteServiceOrderRequest GoodsTag(string fieldValue) {
        this.request.BodyString("goods_tag", fieldValue);
        return this;
    }

    WechatPayV3PayScorePayScoreApisApiCompleteServiceOrderRequest Device(WechatPayServiceOrderRequestDevice fieldValue) {
        this.request.BodyJson("device", Json.Serialize<WechatPayServiceOrderRequestDevice>(fieldValue));
        return this;
    }

    WechatPayV3PayScorePayScoreApisApiCompleteServiceOrderRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/payscore/serviceorder/{data.out_order_no}/complete";
        result = result.Replace("{data.out_order_no}", Encoding.UrlEncode(this.request.ValueText("out_order_no")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
