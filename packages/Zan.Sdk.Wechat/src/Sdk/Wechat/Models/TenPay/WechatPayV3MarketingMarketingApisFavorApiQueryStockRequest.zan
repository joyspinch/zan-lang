using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3MarketingMarketingApisFavorApiQueryStockRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3MarketingMarketingApisFavorApiQueryStockRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    public WechatPayV3MarketingMarketingApisFavorApiQueryStockRequest StockId(string fieldValue) {
        this.request.PathString("stock_id", fieldValue);
        return this;
    }

    public WechatPayV3MarketingMarketingApisFavorApiQueryStockRequest StockCreatorMchid(string fieldValue) {
        this.request.QueryString("stock_creator_mchid", fieldValue);
        return this;
    }

    public WechatPayV3MarketingMarketingApisFavorApiQueryStockRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    public string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/marketing/favor/stocks/{stock_id}";
        result = result.Replace("{stock_id}", Encoding.UrlEncode(this.request.ValueText("stock_id")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
