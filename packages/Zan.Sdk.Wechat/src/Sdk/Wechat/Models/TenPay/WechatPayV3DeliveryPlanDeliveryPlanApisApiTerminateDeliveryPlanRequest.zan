using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3DeliveryPlanDeliveryPlanApisApiTerminateDeliveryPlanRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3DeliveryPlanDeliveryPlanApisApiTerminateDeliveryPlanRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    public WechatPayV3DeliveryPlanDeliveryPlanApisApiTerminateDeliveryPlanRequest PlanId(string fieldValue) {
        this.request.BodyString("planId", fieldValue);
        return this;
    }

    public WechatPayV3DeliveryPlanDeliveryPlanApisApiTerminateDeliveryPlanRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    public string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/marketing/partner/delivery-plan/delivery-plans/{EscapeDeliveryPlanValue(planId)}/terminate";
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
