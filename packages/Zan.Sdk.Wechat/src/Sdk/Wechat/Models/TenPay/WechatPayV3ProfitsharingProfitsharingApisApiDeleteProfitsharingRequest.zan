    public string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/{1}profitsharing/receivers/delete";
        string partner = "";
        if (this.request.HasValue("sp_mchid")) { partner = "partner/"; }
        result = result.Replace("{1}", partner);
        return result;
