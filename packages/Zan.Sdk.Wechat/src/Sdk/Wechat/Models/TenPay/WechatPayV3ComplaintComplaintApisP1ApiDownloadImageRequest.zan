using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3ComplaintComplaintApisP1ApiDownloadImageRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3ComplaintComplaintApisP1ApiDownloadImageRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    public WechatPayV3ComplaintComplaintApisP1ApiDownloadImageRequest MediaId(string fieldValue) {
        this.request.PathString("mediaId", fieldValue);
        return this;
    }

    public WechatPayV3ComplaintComplaintApisP1ApiDownloadImageRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    public string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/merchant-service/images/{escapedMediaId}";
        result = result.Replace("{escapedMediaId}", Encoding.UrlEncode(this.request.ValueText("mediaId")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
