using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3BrandApplymentBrandApplymentApisApiQueryByBusinessCodeRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3BrandApplymentBrandApplymentApisApiQueryByBusinessCodeRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3BrandApplymentBrandApplymentApisApiQueryByBusinessCodeRequest BusinessCode(string fieldValue) {
        this.request.PathString("businessCode", fieldValue);
        return this;
    }

    WechatPayV3BrandApplymentBrandApplymentApisApiQueryByBusinessCodeRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/brand/applyments/business-code/{Escape(businessCode)}";
        result = result.Replace("{Escape(businessCode)}", Encoding.UrlEncode(this.request.ValueText("businessCode")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
