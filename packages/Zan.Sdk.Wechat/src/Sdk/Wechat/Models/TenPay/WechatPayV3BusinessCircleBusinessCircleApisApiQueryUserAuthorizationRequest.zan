using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3BusinessCircleBusinessCircleApisApiQueryUserAuthorizationRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3BusinessCircleBusinessCircleApisApiQueryUserAuthorizationRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3BusinessCircleBusinessCircleApisApiQueryUserAuthorizationRequest Appid(string fieldValue) {
        this.request.QueryString("appid", fieldValue);
        return this;
    }

    WechatPayV3BusinessCircleBusinessCircleApisApiQueryUserAuthorizationRequest Openid(string fieldValue) {
        this.request.PathString("openid", fieldValue);
        return this;
    }

    WechatPayV3BusinessCircleBusinessCircleApisApiQueryUserAuthorizationRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/businesscircle/user-authorizations/{openid}";
        result = result.Replace("{openid}", Encoding.UrlEncode(this.request.ValueText("openid")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
