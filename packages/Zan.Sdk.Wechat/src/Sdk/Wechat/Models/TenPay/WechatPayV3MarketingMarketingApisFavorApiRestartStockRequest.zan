using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3MarketingMarketingApisFavorApiRestartStockRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3MarketingMarketingApisFavorApiRestartStockRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3MarketingMarketingApisFavorApiRestartStockRequest StockCreatorMchid(string fieldValue) {
        this.request.BodyString("stock_creator_mchid", fieldValue);
        return this;
    }

    WechatPayV3MarketingMarketingApisFavorApiRestartStockRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/marketing/favor/stocks/{stock_id}/restart";
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
