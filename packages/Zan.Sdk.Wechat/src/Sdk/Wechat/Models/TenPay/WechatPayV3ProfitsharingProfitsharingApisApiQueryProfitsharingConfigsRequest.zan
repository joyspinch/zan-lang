using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3ProfitsharingProfitsharingApisApiQueryProfitsharingConfigsRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3ProfitsharingProfitsharingApisApiQueryProfitsharingConfigsRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3ProfitsharingProfitsharingApisApiQueryProfitsharingConfigsRequest BrandMchid(string fieldValue) {
        this.request.PathString("brand_mchid", fieldValue);
        return this;
    }

    WechatPayV3ProfitsharingProfitsharingApisApiQueryProfitsharingConfigsRequest SubMchid(string fieldValue) {
        this.request.QueryString("sub_mchid", fieldValue);
        return this;
    }

    WechatPayV3ProfitsharingProfitsharingApisApiQueryProfitsharingConfigsRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/brand/profitsharing/brand-configs/{data.brand_mchid}";
        result = result.Replace("{data.brand_mchid}", Encoding.UrlEncode(this.request.ValueText("brand_mchid")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
