    public WechatPayV3EcommerceEcommerceApisCrossBorderApiQueryFundsToOverseaAvailableAmountRequest TransactionId(string fieldValue) {
        this.request.QueryString("transactionId", fieldValue);
        return this;
    }

    public WechatPayV3EcommerceEcommerceApisCrossBorderApiQueryFundsToOverseaAvailableAmountRequest SubMchId(string fieldValue) {
        this.request.QueryString("subMchId", fieldValue);
