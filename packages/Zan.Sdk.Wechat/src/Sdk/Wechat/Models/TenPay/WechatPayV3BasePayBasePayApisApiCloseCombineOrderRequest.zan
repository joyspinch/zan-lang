using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3BasePayBasePayApisApiCloseCombineOrderRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3BasePayBasePayApisApiCloseCombineOrderRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    public WechatPayV3BasePayBasePayApisApiCloseCombineOrderRequest CombineAppid(string fieldValue) {
        this.request.BodyString("combine_appid", fieldValue);
        return this;
    }

    public WechatPayV3BasePayBasePayApisApiCloseCombineOrderRequest SubOrders(List<WechatPayBasePayCloseCombineOrderRequestDataSubOrder> fieldValue) {
        this.request.BodyJson("sub_orders", Json.Serialize<List<WechatPayBasePayCloseCombineOrderRequestDataSubOrder>>(fieldValue));
        return this;
    }

    public WechatPayV3BasePayBasePayApisApiCloseCombineOrderRequest CombineOutTradeNo(string fieldValue) {
        this.request.PathString("combine_out_trade_no", fieldValue);
        return this;
    }

    public WechatPayV3BasePayBasePayApisApiCloseCombineOrderRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    public string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/combine-transactions/out-trade-no/{combine_out_trade_no}/close";
        result = result.Replace("{combine_out_trade_no}", Encoding.UrlEncode(this.request.ValueText("combine_out_trade_no")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
