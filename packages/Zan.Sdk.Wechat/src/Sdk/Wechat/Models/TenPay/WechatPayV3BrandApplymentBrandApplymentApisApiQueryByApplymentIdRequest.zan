using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3BrandApplymentBrandApplymentApisApiQueryByApplymentIdRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3BrandApplymentBrandApplymentApisApiQueryByApplymentIdRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3BrandApplymentBrandApplymentApisApiQueryByApplymentIdRequest ApplymentId(string fieldValue) {
        this.request.PathString("applymentId", fieldValue);
        return this;
    }

    WechatPayV3BrandApplymentBrandApplymentApisApiQueryByApplymentIdRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/brand/applyments/applyment-id/{Escape(applymentId)}";
        result = result.Replace("{Escape(applymentId)}", Encoding.UrlEncode(this.request.ValueText("applymentId")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
