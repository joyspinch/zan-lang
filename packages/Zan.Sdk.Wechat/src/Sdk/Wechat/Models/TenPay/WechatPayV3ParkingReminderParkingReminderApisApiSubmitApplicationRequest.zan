using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3ParkingReminderParkingReminderApisApiSubmitApplicationRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3ParkingReminderParkingReminderApisApiSubmitApplicationRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3ParkingReminderParkingReminderApisApiSubmitApplicationRequest ParkingLot(WechatPayParkingLotApplicationData fieldValue) {
        this.request.BodyJson("parking_lot", Json.Serialize<WechatPayParkingLotApplicationData>(fieldValue));
        return this;
    }

    WechatPayV3ParkingReminderParkingReminderApisApiSubmitApplicationRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/parking/reminders/application";
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
