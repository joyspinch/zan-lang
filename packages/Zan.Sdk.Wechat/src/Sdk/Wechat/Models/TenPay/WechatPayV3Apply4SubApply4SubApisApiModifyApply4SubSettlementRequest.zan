using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3Apply4SubApply4SubApisApiModifyApply4SubSettlementRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3Apply4SubApply4SubApisApiModifyApply4SubSettlementRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3Apply4SubApply4SubApisApiModifyApply4SubSettlementRequest SubMchid(string fieldValue) {
        this.request.PathString("sub_mchid", fieldValue);
        return this;
    }

    WechatPayV3Apply4SubApply4SubApisApiModifyApply4SubSettlementRequest AccountInfo(WechatPayApply4SubAccountInfo fieldValue) {
        this.request.BodyJson("account_info", Json.Serialize<WechatPayApply4SubAccountInfo>(fieldValue));
        return this;
    }

    WechatPayV3Apply4SubApply4SubApisApiModifyApply4SubSettlementRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/apply4sub/sub_merchants/{data.sub_mchid}/modify-settlement";
        result = result.Replace("{data.sub_mchid}", Encoding.UrlEncode(this.request.ValueText("sub_mchid")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
