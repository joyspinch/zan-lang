using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3BankComponentBankComponentApisApiQueryBranchListRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3BankComponentBankComponentApisApiQueryBranchListRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    public WechatPayV3BankComponentBankComponentApisApiQueryBranchListRequest BankAliasCode(string fieldValue) {
        this.request.PathString("bank_alias_code", fieldValue);
        return this;
    }

    public WechatPayV3BankComponentBankComponentApisApiQueryBranchListRequest CityCode(string fieldValue) {
        this.request.BodyString("city_code", fieldValue);
        return this;
    }

    public WechatPayV3BankComponentBankComponentApisApiQueryBranchListRequest Offset(int fieldValue) {
        this.request.BodyInt("offset", fieldValue);
        return this;
    }

    public WechatPayV3BankComponentBankComponentApisApiQueryBranchListRequest Limit(int fieldValue) {
        this.request.BodyInt("limit", fieldValue);
        return this;
    }

    public WechatPayV3BankComponentBankComponentApisApiQueryBranchListRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    public string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/capital/capitallhh/banks/{data.bank_alias_code}/branches";
        result = result.Replace("{data.bank_alias_code}", Encoding.UrlEncode(this.request.ValueText("bank_alias_code")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
