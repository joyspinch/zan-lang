using System;
using System.Json;
using System.Text;
using Sdk.Wechat.TenPay;

namespace Sdk.Wechat.Models.TenPay;
public class WechatPayLegacyUtilities {
    static string EscapeParam(string s) {
        if (s == null || s.Length == 0) { return ""; }
        string hex = "0123456789ABCDEF";
        StringBuilder sb = new StringBuilder(s.Length);
        for (int i = 0; i < s.Length; i = i + 1) {
            int b = s[i] & 255;
            bool unreserved = (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
                || (b >= 48 && b <= 57) || b == 45 || b == 46 || b == 95 || b == 126;
            if (unreserved) {
                sb.Append(s.Substring(i, 1));
            } else {
                sb.Append("%");
                sb.Append(hex.Substring((b >> 4) & 15, 1));
                sb.Append(hex.Substring(b & 15, 1));
            }
        }
        return sb.ToString();
    }

    public static string NativePayV1(string sign, string appId, string timestamp,
                              string nonce, string productId) {
        return "weixin://wxpay/bizpayurl?sign=" + WechatPayLegacyUtilities.EscapeParam(sign)
            + "&appid=" + WechatPayLegacyUtilities.EscapeParam(appId)
            + "&productid=" + WechatPayLegacyUtilities.EscapeParam(productId)
            + "&timestamp=" + WechatPayLegacyUtilities.EscapeParam(timestamp)
            + "&noncestr=" + WechatPayLegacyUtilities.EscapeParam(nonce);
    }

    public static string NativePay(string appId, string timestamp, string merchantId,
                            string nonce, string productId, string sign) {
        return "weixin://wxpay/bizpayurl?sign=" + WechatPayLegacyUtilities.EscapeParam(sign)
            + "&appid=" + WechatPayLegacyUtilities.EscapeParam(appId)
            + "&mch_id=" + WechatPayLegacyUtilities.EscapeParam(merchantId)
            + "&product_id=" + WechatPayLegacyUtilities.EscapeParam(productId)
            + "&time_stamp=" + WechatPayLegacyUtilities.EscapeParam(timestamp)
            + "&nonce_str=" + WechatPayLegacyUtilities.EscapeParam(nonce);
    }

    public static string GetJsPaySign(string appId, string timestamp, string nonce,
                               string packageValue, string merchantKey,
                               string signType) {
        WechatPayV2Request request = new WechatPayV2Request();
        request.Set("appId", appId);
        request.Set("timeStamp", timestamp);
        request.Set("nonceStr", nonce);
        request.Set("package", packageValue);
        request.Set("signType", signType);
        return request.Sign(merchantKey, signType);
    }
}

