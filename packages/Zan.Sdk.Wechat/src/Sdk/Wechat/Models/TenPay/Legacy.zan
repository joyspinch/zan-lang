using System;
using System.Json;
using Sdk.Wechat.TenPay;

namespace Sdk.Wechat.Models.TenPay;
public class WechatPayLegacyUtilities {
    public static string NativePayV1(string sign, string appId, string timestamp,
                              string nonce, string productId) {
        return "weixin://wxpay/bizpayurl?sign=" + sign + "&appid=" + appId
            + "&productid=" + productId + "&timestamp=" + timestamp
            + "&noncestr=" + nonce;
    }

    public static string NativePay(string appId, string timestamp, string merchantId,
                            string nonce, string productId, string sign) {
        return "weixin://wxpay/bizpayurl?sign=" + sign + "&appid=" + appId
            + "&mch_id=" + merchantId + "&product_id=" + productId
            + "&time_stamp=" + timestamp + "&nonce_str=" + nonce;
    }

    public static string GetJsPaySign(string appId, string timestamp, string nonce,
                               string packageValue, string merchantKey,
                               string signType) {
        WechatPayV2Request request = new WechatPayV2Request();
        request.Set("appId", appId);
        request.Set("timeStamp", timestamp);
        request.Set("nonceStr", nonce);
        request.Set("package", packageValue);
        request.Set("signType", signType);
        return request.Sign(merchantKey, signType);
    }
}

public class WechatPayOrderInfo {
    public string ret_code;
    public string ret_msg;
    public string input_charset;
    public string trade_state;
    public string trade_mode;
    public string partner;
    public string bank_type;
    public string bank_billno;
    public string total_fee;
    public string fee_type;
    public string transaction_id;
    public string out_trade_no;
    public string is_split;
    public string is_refund;
    public string attach;
    public string time_end;
    public string transport_fee;
    public string product_fee;
    public string discount;
    public string rmb_total_fee;
}

public class WechatPayOrderqueryResult {
    public int errcode;
    public string errmsg;
    public WechatPayOrderInfo orderInfo;
}

public class WechatPayTenPayV3UnifiedorderRequestDataSceneInfo {
    public WechatPayUniversalTenPayV3UnifiedorderRequestDataSceneInfoStoreInfo store_info;
    public JsonValue h5_info;
}

public class WechatPayUniversalTenPayV3UnifiedorderRequestDataSceneInfoStoreInfo {
    public string id;
    public string name;
    public string area_code;
    public string address;
}

public class WxPayRepayData {
    string appid;
    string mchid;
    string nonce_str;
    string openid;
}
