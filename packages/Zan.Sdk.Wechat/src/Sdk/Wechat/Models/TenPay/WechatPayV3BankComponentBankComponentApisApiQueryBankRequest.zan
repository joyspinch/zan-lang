using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3BankComponentBankComponentApisApiQueryBankRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3BankComponentBankComponentApisApiQueryBankRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    public WechatPayV3BankComponentBankComponentApisApiQueryBankRequest AccountNumber(string fieldValue) {
        this.request.BodyString("account_number", fieldValue);
        return this;
    }

    public WechatPayV3BankComponentBankComponentApisApiQueryBankRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    public string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/capital/capitallhh/banks/personal-banking";
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
