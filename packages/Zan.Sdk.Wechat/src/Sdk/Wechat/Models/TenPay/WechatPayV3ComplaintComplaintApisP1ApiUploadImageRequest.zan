using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3ComplaintComplaintApisP1ApiUploadImageRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3ComplaintComplaintApisP1ApiUploadImageRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3ComplaintComplaintApisP1ApiUploadImageRequest FileName(string fieldValue) {
        this.request.BodyString("fileName", fieldValue);
        return this;
    }

    WechatPayV3ComplaintComplaintApisP1ApiUploadImageRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/merchant-service/images/upload";
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
