using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3MedicalInsuranceMedicalInsuranceApisApiQueryOrderByOutTradeNoRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3MedicalInsuranceMedicalInsuranceApisApiQueryOrderByOutTradeNoRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3MedicalInsuranceMedicalInsuranceApisApiQueryOrderByOutTradeNoRequest OutTradeNo(string fieldValue) {
        this.request.PathString("outTradeNo", fieldValue);
        return this;
    }

    WechatPayV3MedicalInsuranceMedicalInsuranceApisApiQueryOrderByOutTradeNoRequest SubMchId(string fieldValue) {
        this.request.QueryString("subMchId", fieldValue);
        return this;
    }

    WechatPayV3MedicalInsuranceMedicalInsuranceApisApiQueryOrderByOutTradeNoRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/med-ins/orders/out-trade-no/{Escape(outTradeNo)}";
        result = result.Replace("{Escape(outTradeNo)}", Encoding.UrlEncode(this.request.ValueText("outTradeNo")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
