using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3ComplaintComplaintApisP1ApiResponseImmediateServiceRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3ComplaintComplaintApisP1ApiResponseImmediateServiceRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3ComplaintComplaintApisP1ApiResponseImmediateServiceRequest ComplaintedMchid(string fieldValue) {
        this.request.BodyString("complainted_mchid", fieldValue);
        return this;
    }

    WechatPayV3ComplaintComplaintApisP1ApiResponseImmediateServiceRequest Message(WechatPayImmediateServiceMessage fieldValue) {
        this.request.BodyJson("message", Json.Serialize<WechatPayImmediateServiceMessage>(fieldValue));
        return this;
    }

    WechatPayV3ComplaintComplaintApisP1ApiResponseImmediateServiceRequest IdempotentId(string fieldValue) {
        this.request.BodyString("idempotent_id", fieldValue);
        return this;
    }

    WechatPayV3ComplaintComplaintApisP1ApiResponseImmediateServiceRequest ComplaintId(string fieldValue) {
        this.request.PathString("complaintId", fieldValue);
        return this;
    }

    WechatPayV3ComplaintComplaintApisP1ApiResponseImmediateServiceRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/merchant-service/complaints-v2/{escapedComplaintId}/response-immediate-service";
        result = result.Replace("{escapedComplaintId}", Encoding.UrlEncode(this.request.ValueText("complaintId")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
