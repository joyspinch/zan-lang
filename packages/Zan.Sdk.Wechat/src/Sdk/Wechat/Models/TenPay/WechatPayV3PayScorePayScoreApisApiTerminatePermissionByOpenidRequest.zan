using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3PayScorePayScoreApisApiTerminatePermissionByOpenidRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3PayScorePayScoreApisApiTerminatePermissionByOpenidRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    public WechatPayV3PayScorePayScoreApisApiTerminatePermissionByOpenidRequest Openid(string fieldValue) {
        this.request.PathString("openid", fieldValue);
        return this;
    }

    public WechatPayV3PayScorePayScoreApisApiTerminatePermissionByOpenidRequest ServiceId(string fieldValue) {
        this.request.BodyString("service_id", fieldValue);
        return this;
    }

    public WechatPayV3PayScorePayScoreApisApiTerminatePermissionByOpenidRequest Appid(string fieldValue) {
        this.request.BodyString("appid", fieldValue);
        return this;
    }

    public WechatPayV3PayScorePayScoreApisApiTerminatePermissionByOpenidRequest Reason(string fieldValue) {
        this.request.BodyString("reason", fieldValue);
        return this;
    }

    public WechatPayV3PayScorePayScoreApisApiTerminatePermissionByOpenidRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    public string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/payscore/permissions/openid/{data.openid}/terminate";
        result = result.Replace("{data.openid}", Encoding.UrlEncode(this.request.ValueText("openid")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
