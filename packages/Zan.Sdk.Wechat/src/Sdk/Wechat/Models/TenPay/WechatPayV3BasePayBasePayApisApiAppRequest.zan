    }

    public WechatPayV3BasePayBasePayApisApiAppRequest NotifyUrl(string fieldValue) {
        this.request.BodyString("notify_url", fieldValue);
        return this;
    }

    public WechatPayV3BasePayBasePayApisApiAppRequest GoodsTag(string fieldValue) {
        this.request.BodyString("goods_tag", fieldValue);
        return this;
    }

    public WechatPayV3BasePayBasePayApisApiAppRequest SupportFapiao(bool fieldValue) {
        this.request.BodyBool("support_fapiao", fieldValue);
        return this;
    }

    public WechatPayV3BasePayBasePayApisApiAppRequest Amount(WechatPayBasePayTransactionsRequestDataAmount fieldValue) {
        this.request.BodyJson("amount", Json.Serialize<WechatPayBasePayTransactionsRequestDataAmount>(fieldValue));
        return this;
    }

    public WechatPayV3BasePayBasePayApisApiAppRequest Detail(WechatPayBasePayTransactionsRequestDataDetail fieldValue) {
        this.request.BodyJson("detail", Json.Serialize<WechatPayBasePayTransactionsRequestDataDetail>(fieldValue));
