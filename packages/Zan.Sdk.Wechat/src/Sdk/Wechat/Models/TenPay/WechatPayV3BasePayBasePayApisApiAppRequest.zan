    public WechatPayV3BasePayBasePayApisApiAppRequest Payer(WechatPayBasePayTransactionsRequestDataPayer fieldValue) {
        this.request.BodyJson("payer", Json.Serialize<WechatPayBasePayTransactionsRequestDataPayer>(fieldValue));
