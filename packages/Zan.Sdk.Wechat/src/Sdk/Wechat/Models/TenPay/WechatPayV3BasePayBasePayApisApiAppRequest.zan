    public WechatPayV3BasePayBasePayApisApiAppRequest SettleInfo(WechatPayBasePayTransactionsRequestDataSettleInfo fieldValue) {
        this.request.BodyJson("settle_info", Json.Serialize<WechatPayBasePayTransactionsRequestDataSettleInfo>(fieldValue));
