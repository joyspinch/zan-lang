    }

    public WechatPayV3BasePayBasePayApisApiAppRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    public string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/pay/{1}transactions/app";
        string partner = "";
        if (this.request.HasValue("sp_mchid")) { partner = "partner/"; }
        result = result.Replace("{1}", partner);
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

