    public WechatPayV3BasePayBasePayApisApiAppRequest SpAppid(string fieldValue) {
        this.request.BodyString("sp_appid", fieldValue);
        return this;
    }

    public WechatPayV3BasePayBasePayApisApiAppRequest SpMchid(string fieldValue) {
        this.request.BodyString("sp_mchid", fieldValue);
        return this;
    }

    public WechatPayV3BasePayBasePayApisApiAppRequest SubAppid(string fieldValue) {
        this.request.BodyString("sub_appid", fieldValue);
        return this;
    }

    public WechatPayV3BasePayBasePayApisApiAppRequest SubMchid(string fieldValue) {
        this.request.BodyString("sub_mchid", fieldValue);
        return this;
    }

    public WechatPayV3BasePayBasePayApisApiAppRequest Description(string fieldValue) {
        this.request.BodyString("description", fieldValue);
        return this;
    }

    public WechatPayV3BasePayBasePayApisApiAppRequest OutTradeNo(string fieldValue) {
        this.request.BodyString("out_trade_no", fieldValue);
        return this;
    }

    public WechatPayV3BasePayBasePayApisApiAppRequest TimeExpire(string fieldValue) {
        this.request.BodyString("time_expire", fieldValue);
