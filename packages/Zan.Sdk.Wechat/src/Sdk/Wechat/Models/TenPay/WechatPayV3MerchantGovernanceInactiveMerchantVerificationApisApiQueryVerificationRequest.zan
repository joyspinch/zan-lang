using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3MerchantGovernanceInactiveMerchantVerificationApisApiQueryVerificationRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3MerchantGovernanceInactiveMerchantVerificationApisApiQueryVerificationRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3MerchantGovernanceInactiveMerchantVerificationApisApiQueryVerificationRequest SubMchId(string fieldValue) {
        this.request.PathString("subMchId", fieldValue);
        return this;
    }

    WechatPayV3MerchantGovernanceInactiveMerchantVerificationApisApiQueryVerificationRequest VerificationId(string fieldValue) {
        this.request.PathString("verificationId", fieldValue);
        return this;
    }

    WechatPayV3MerchantGovernanceInactiveMerchantVerificationApisApiQueryVerificationRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/compliance/inactive-merchant-identity-verification/merchants/{Escape(subMchId)}/verifications/{Escape(verificationId)}";
        result = result.Replace("{Escape(subMchId)}", Encoding.UrlEncode(this.request.ValueText("subMchId")));
        result = result.Replace("{Escape(verificationId)}", Encoding.UrlEncode(this.request.ValueText("verificationId")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
