using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3BasePayBasePayApisApiCertificatesRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3BasePayBasePayApisApiCertificatesRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3BasePayBasePayApisApiCertificatesRequest AlgorithmType(JsonValue fieldValue) {
        this.request.QueryValue("algorithmType", fieldValue);
        return this;
    }

    WechatPayV3BasePayBasePayApisApiCertificatesRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/certificates";
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
