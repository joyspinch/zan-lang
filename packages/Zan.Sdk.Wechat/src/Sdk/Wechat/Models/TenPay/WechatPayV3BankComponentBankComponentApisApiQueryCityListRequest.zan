using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3BankComponentBankComponentApisApiQueryCityListRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3BankComponentBankComponentApisApiQueryCityListRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    public WechatPayV3BankComponentBankComponentApisApiQueryCityListRequest ProvinceCode(string fieldValue) {
        this.request.PathString("province_code", fieldValue);
        return this;
    }

    public WechatPayV3BankComponentBankComponentApisApiQueryCityListRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    public string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/capital/capitallhh/areas/provinces/{data.province_code}/cities";
        result = result.Replace("{data.province_code}", Encoding.UrlEncode(this.request.ValueText("province_code")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
