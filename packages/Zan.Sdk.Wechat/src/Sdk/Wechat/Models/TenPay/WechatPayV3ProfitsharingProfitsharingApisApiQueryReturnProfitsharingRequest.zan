    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/profitsharing/return-orders/{out_return_no}";
        result = result.Replace("{out_return_no}", Encoding.UrlEncode(this.request.ValueText("out_return_no")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
