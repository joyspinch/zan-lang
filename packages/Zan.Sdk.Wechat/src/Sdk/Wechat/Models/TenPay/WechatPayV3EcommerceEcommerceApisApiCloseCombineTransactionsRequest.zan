using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3EcommerceEcommerceApisApiCloseCombineTransactionsRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3EcommerceEcommerceApisApiCloseCombineTransactionsRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    public WechatPayV3EcommerceEcommerceApisApiCloseCombineTransactionsRequest CombineOutTradeNo(string fieldValue) {
        this.request.PathString("combine_out_trade_no", fieldValue);
        return this;
    }

    public WechatPayV3EcommerceEcommerceApisApiCloseCombineTransactionsRequest SubOrders(List<WechatPayCombineSubOrderInfo> fieldValue) {
        this.request.BodyJson("sub_orders", Json.Serialize<List<WechatPayCombineSubOrderInfo>>(fieldValue));
        return this;
    }

    public WechatPayV3EcommerceEcommerceApisApiCloseCombineTransactionsRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    public string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/ecommerce/combine/transactions/out-trade-no/{data.combine_out_trade_no}/close";
        result = result.Replace("{data.combine_out_trade_no}", Encoding.UrlEncode(this.request.ValueText("combine_out_trade_no")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
