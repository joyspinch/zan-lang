using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3MarketingMarketingApisCardApiSendCardRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3MarketingMarketingApisCardApiSendCardRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    public WechatPayV3MarketingMarketingApisCardApiSendCardRequest CardId(string fieldValue) {
        this.request.PathString("card_id", fieldValue);
        return this;
    }

    public WechatPayV3MarketingMarketingApisCardApiSendCardRequest Appid(string fieldValue) {
        this.request.BodyString("appid", fieldValue);
        return this;
    }

    public WechatPayV3MarketingMarketingApisCardApiSendCardRequest Openid(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    public WechatPayV3MarketingMarketingApisCardApiSendCardRequest OutRequestNo(string fieldValue) {
        this.request.BodyString("out_request_no", fieldValue);
        return this;
    }

    public WechatPayV3MarketingMarketingApisCardApiSendCardRequest SendTime(string fieldValue) {
        this.request.BodyString("send_time", fieldValue);
        return this;
    }

    public WechatPayV3MarketingMarketingApisCardApiSendCardRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    public string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/marketing/busifavor/coupons/{data.card_id}/send";
        result = result.Replace("{data.card_id}", Encoding.UrlEncode(this.request.ValueText("card_id")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
