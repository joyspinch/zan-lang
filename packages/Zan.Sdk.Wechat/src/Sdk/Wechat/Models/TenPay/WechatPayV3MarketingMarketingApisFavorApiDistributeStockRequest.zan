using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3MarketingMarketingApisFavorApiDistributeStockRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3MarketingMarketingApisFavorApiDistributeStockRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3MarketingMarketingApisFavorApiDistributeStockRequest StockId(string fieldValue) {
        this.request.BodyString("stock_id", fieldValue);
        return this;
    }

    WechatPayV3MarketingMarketingApisFavorApiDistributeStockRequest OutRequestNo(string fieldValue) {
        this.request.BodyString("out_request_no", fieldValue);
        return this;
    }

    WechatPayV3MarketingMarketingApisFavorApiDistributeStockRequest Appid(string fieldValue) {
        this.request.BodyString("appid", fieldValue);
        return this;
    }

    WechatPayV3MarketingMarketingApisFavorApiDistributeStockRequest StockCreatorMchid(string fieldValue) {
        this.request.BodyString("stock_creator_mchid", fieldValue);
        return this;
    }

    WechatPayV3MarketingMarketingApisFavorApiDistributeStockRequest Openid(string fieldValue) {
        this.request.PathString("openid", fieldValue);
        return this;
    }

    WechatPayV3MarketingMarketingApisFavorApiDistributeStockRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/marketing/favor/users/{openid}/coupons";
        result = result.Replace("{openid}", Encoding.UrlEncode(this.request.ValueText("openid")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
