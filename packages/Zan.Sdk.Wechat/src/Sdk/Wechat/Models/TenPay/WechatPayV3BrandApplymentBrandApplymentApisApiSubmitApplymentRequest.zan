using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3BrandApplymentBrandApplymentApisApiSubmitApplymentRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3BrandApplymentBrandApplymentApisApiSubmitApplymentRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    public WechatPayV3BrandApplymentBrandApplymentApisApiSubmitApplymentRequest BusinessCode(string fieldValue) {
        this.request.BodyString("business_code", fieldValue);
        return this;
    }

    public WechatPayV3BrandApplymentBrandApplymentApisApiSubmitApplymentRequest AdminInfo(WechatPayBrandApplymentAdminInfo fieldValue) {
        this.request.BodyJson("admin_info", Json.Serialize<WechatPayBrandApplymentAdminInfo>(fieldValue));
        return this;
    }

    public WechatPayV3BrandApplymentBrandApplymentApisApiSubmitApplymentRequest SubjectInfo(WechatPayBrandApplymentSubjectInfo fieldValue) {
        this.request.BodyJson("subject_info", Json.Serialize<WechatPayBrandApplymentSubjectInfo>(fieldValue));
        return this;
    }

    public WechatPayV3BrandApplymentBrandApplymentApisApiSubmitApplymentRequest BrandBasicInfo(WechatPayBrandApplymentBasicInfo fieldValue) {
        this.request.BodyJson("brand_basic_info", Json.Serialize<WechatPayBrandApplymentBasicInfo>(fieldValue));
        return this;
    }

    public WechatPayV3BrandApplymentBrandApplymentApisApiSubmitApplymentRequest Trademark(WechatPayBrandApplymentTrademarkInfo fieldValue) {
        this.request.BodyJson("trademark", Json.Serialize<WechatPayBrandApplymentTrademarkInfo>(fieldValue));
        return this;
    }

    public WechatPayV3BrandApplymentBrandApplymentApisApiSubmitApplymentRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    public string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/brand/applyments";
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
