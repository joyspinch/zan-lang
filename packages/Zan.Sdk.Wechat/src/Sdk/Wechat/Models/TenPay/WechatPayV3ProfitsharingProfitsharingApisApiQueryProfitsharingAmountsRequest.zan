using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3ProfitsharingProfitsharingApisApiQueryProfitsharingAmountsRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3ProfitsharingProfitsharingApisApiQueryProfitsharingAmountsRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    public WechatPayV3ProfitsharingProfitsharingApisApiQueryProfitsharingAmountsRequest TransactionId(string fieldValue) {
        this.request.PathString("transaction_id", fieldValue);
        return this;
    }

    public WechatPayV3ProfitsharingProfitsharingApisApiQueryProfitsharingAmountsRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    public string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/profitsharing/transactions/{transaction_id}/amounts";
        result = result.Replace("{transaction_id}", Encoding.UrlEncode(this.request.ValueText("transaction_id")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
