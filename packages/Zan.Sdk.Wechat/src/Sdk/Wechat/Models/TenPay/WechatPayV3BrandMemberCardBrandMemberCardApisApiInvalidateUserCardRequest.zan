    public string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/card-member/user-cards/{value}";
        result = result.Replace("{value}", Encoding.UrlEncode(this.request.ValueText("userCardCode")));
