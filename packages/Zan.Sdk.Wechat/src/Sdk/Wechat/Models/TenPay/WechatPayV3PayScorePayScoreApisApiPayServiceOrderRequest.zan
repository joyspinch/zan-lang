using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3PayScorePayScoreApisApiPayServiceOrderRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3PayScorePayScoreApisApiPayServiceOrderRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3PayScorePayScoreApisApiPayServiceOrderRequest OutOrderNo(string fieldValue) {
        this.request.PathString("out_order_no", fieldValue);
        return this;
    }

    WechatPayV3PayScorePayScoreApisApiPayServiceOrderRequest Appid(string fieldValue) {
        this.request.BodyString("appid", fieldValue);
        return this;
    }

    WechatPayV3PayScorePayScoreApisApiPayServiceOrderRequest ServiceId(string fieldValue) {
        this.request.BodyString("service_id", fieldValue);
        return this;
    }

    WechatPayV3PayScorePayScoreApisApiPayServiceOrderRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/payscore/serviceorder/{data.out_order_no}/pay";
        result = result.Replace("{data.out_order_no}", Encoding.UrlEncode(this.request.ValueText("out_order_no")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
