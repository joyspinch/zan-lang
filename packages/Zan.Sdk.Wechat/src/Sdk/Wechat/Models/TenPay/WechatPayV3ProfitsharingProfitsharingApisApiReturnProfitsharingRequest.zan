using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3ProfitsharingProfitsharingApisApiReturnProfitsharingRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3ProfitsharingProfitsharingApisApiReturnProfitsharingRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    public WechatPayV3ProfitsharingProfitsharingApisApiReturnProfitsharingRequest BrandMchid(string fieldValue) {
        this.request.BodyString("brand_mchid", fieldValue);
        return this;
    }

    public WechatPayV3ProfitsharingProfitsharingApisApiReturnProfitsharingRequest SubMchid(string fieldValue) {
        this.request.BodyString("sub_mchid", fieldValue);
        return this;
    }

    public WechatPayV3ProfitsharingProfitsharingApisApiReturnProfitsharingRequest OrderId(string fieldValue) {
        this.request.BodyString("order_id", fieldValue);
        return this;
    }

    public WechatPayV3ProfitsharingProfitsharingApisApiReturnProfitsharingRequest OutOrderNo(string fieldValue) {
        this.request.BodyString("out_order_no", fieldValue);
        return this;
    }

    public WechatPayV3ProfitsharingProfitsharingApisApiReturnProfitsharingRequest OutReturnNo(string fieldValue) {
        this.request.BodyString("out_return_no", fieldValue);
        return this;
    }

    public WechatPayV3ProfitsharingProfitsharingApisApiReturnProfitsharingRequest ReturnMchid(string fieldValue) {
        this.request.BodyString("return_mchid", fieldValue);
        return this;
    }

    public WechatPayV3ProfitsharingProfitsharingApisApiReturnProfitsharingRequest Amount(int fieldValue) {
        this.request.BodyInt("amount", fieldValue);
        return this;
    }

    public WechatPayV3ProfitsharingProfitsharingApisApiReturnProfitsharingRequest Description(string fieldValue) {
        this.request.BodyString("description", fieldValue);
        return this;
    }

    public WechatPayV3ProfitsharingProfitsharingApisApiReturnProfitsharingRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    public string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/{1}profitsharing/return-orders";
        string partner = "";
        if (this.request.HasValue("sp_mchid")) { partner = "partner/"; }
        result = result.Replace("{1}", partner);
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
