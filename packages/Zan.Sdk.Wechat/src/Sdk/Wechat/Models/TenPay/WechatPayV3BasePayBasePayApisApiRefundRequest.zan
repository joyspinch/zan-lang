using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3BasePayBasePayApisApiRefundRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3BasePayBasePayApisApiRefundRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    public WechatPayV3BasePayBasePayApisApiRefundRequest TransactionId(string fieldValue) {
        this.request.BodyString("transaction_id", fieldValue);
        return this;
    }

    public WechatPayV3BasePayBasePayApisApiRefundRequest OutTradeNo(string fieldValue) {
        this.request.BodyString("out_trade_no", fieldValue);
        return this;
    }

    public WechatPayV3BasePayBasePayApisApiRefundRequest OutRefundNo(string fieldValue) {
        this.request.BodyString("out_refund_no", fieldValue);
        return this;
    }

    public WechatPayV3BasePayBasePayApisApiRefundRequest Reason(string fieldValue) {
        this.request.BodyString("reason", fieldValue);
        return this;
    }

    public WechatPayV3BasePayBasePayApisApiRefundRequest NotifyUrl(string fieldValue) {
        this.request.BodyString("notify_url", fieldValue);
        return this;
    }

    public WechatPayV3BasePayBasePayApisApiRefundRequest FundsAccount(string fieldValue) {
        this.request.BodyString("funds_account", fieldValue);
        return this;
    }

    public WechatPayV3BasePayBasePayApisApiRefundRequest Amount(WechatPayBasePayRefundRequsetDataAmount fieldValue) {
        this.request.BodyJson("amount", Json.Serialize<WechatPayBasePayRefundRequsetDataAmount>(fieldValue));
        return this;
    }

    public WechatPayV3BasePayBasePayApisApiRefundRequest GoodsDetail(List<WechatPayBasePayRefundRequsetDataGoodsDetail> fieldValue) {
        this.request.BodyJson("goods_detail", Json.Serialize<List<WechatPayBasePayRefundRequsetDataGoodsDetail>>(fieldValue));
        return this;
    }

    public WechatPayV3BasePayBasePayApisApiRefundRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    public string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/refund/domestic/refunds";
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
