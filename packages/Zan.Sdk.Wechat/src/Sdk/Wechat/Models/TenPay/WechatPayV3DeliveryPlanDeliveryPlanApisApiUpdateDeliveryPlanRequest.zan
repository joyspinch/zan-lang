    }

    public WechatPayV3DeliveryPlanDeliveryPlanApisApiUpdateDeliveryPlanRequest PlanId(string fieldValue) {
        this.request.BodyString("planId", fieldValue);
        return this;
    }

    public WechatPayV3DeliveryPlanDeliveryPlanApisApiUpdateDeliveryPlanRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    public string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/marketing/partner/delivery-plan/delivery-plans/{EscapeDeliveryPlanValue(planId)}";
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

