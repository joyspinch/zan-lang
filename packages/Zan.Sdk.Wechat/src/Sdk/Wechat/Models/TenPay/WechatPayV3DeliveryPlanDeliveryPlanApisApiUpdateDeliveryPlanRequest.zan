using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3DeliveryPlanDeliveryPlanApisApiUpdateDeliveryPlanRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3DeliveryPlanDeliveryPlanApisApiUpdateDeliveryPlanRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    public WechatPayV3DeliveryPlanDeliveryPlanApisApiUpdateDeliveryPlanRequest ModifyContent(WechatPayDeliveryPlanModifyContent fieldValue) {
        this.request.BodyJson("modify_content", Json.Serialize<WechatPayDeliveryPlanModifyContent>(fieldValue));
        return this;
    }

    public WechatPayV3DeliveryPlanDeliveryPlanApisApiUpdateDeliveryPlanRequest OutRequestNo(string fieldValue) {
        this.request.BodyString("out_request_no", fieldValue);
