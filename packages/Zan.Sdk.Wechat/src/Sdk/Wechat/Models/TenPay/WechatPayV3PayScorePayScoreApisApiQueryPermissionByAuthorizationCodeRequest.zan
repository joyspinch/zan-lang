using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3PayScorePayScoreApisApiQueryPermissionByAuthorizationCodeRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3PayScorePayScoreApisApiQueryPermissionByAuthorizationCodeRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    public WechatPayV3PayScorePayScoreApisApiQueryPermissionByAuthorizationCodeRequest ServiceId(string fieldValue) {
        this.request.PathString("service_id", fieldValue);
        return this;
    }

    public WechatPayV3PayScorePayScoreApisApiQueryPermissionByAuthorizationCodeRequest AuthorizationCode(string fieldValue) {
        this.request.PathString("authorization_code", fieldValue);
        return this;
    }

    public WechatPayV3PayScorePayScoreApisApiQueryPermissionByAuthorizationCodeRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    public string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/payscore/permissions/authorization-code/{authorization_code}&service_id={service_id}";
        result = result.Replace("{authorization_code}", Encoding.UrlEncode(this.request.ValueText("authorization_code")));
        result = result.Replace("{service_id}", Encoding.UrlEncode(this.request.ValueText("service_id")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
