using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3MerchantGovernanceMerchantLimitationApisApiQuerySubMerchantLimitationRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3MerchantGovernanceMerchantLimitationApisApiQuerySubMerchantLimitationRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    public WechatPayV3MerchantGovernanceMerchantLimitationApisApiQuerySubMerchantLimitationRequest SubMchId(string fieldValue) {
        this.request.PathString("subMchId", fieldValue);
        return this;
    }

    public WechatPayV3MerchantGovernanceMerchantLimitationApisApiQuerySubMerchantLimitationRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    public string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/mch-operation-manage/merchant-limitations/sub-mchid/{Escape(subMchId)}";
        result = result.Replace("{Escape(subMchId)}", Encoding.UrlEncode(this.request.ValueText("subMchId")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
