using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3BrandMemberCardBrandMemberCardApisApiQueryCardRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3BrandMemberCardBrandMemberCardApisApiQueryCardRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3BrandMemberCardBrandMemberCardApisApiQueryCardRequest CardId(string fieldValue) {
        this.request.PathString("cardId", fieldValue);
        return this;
    }

    WechatPayV3BrandMemberCardBrandMemberCardApisApiQueryCardRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/card-member/cards/{value}";
        result = result.Replace("{value}", Encoding.UrlEncode(this.request.ValueText("cardId")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
