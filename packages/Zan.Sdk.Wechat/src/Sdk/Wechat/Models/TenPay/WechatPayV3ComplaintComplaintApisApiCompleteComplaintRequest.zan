using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3ComplaintComplaintApisApiCompleteComplaintRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3ComplaintComplaintApisApiCompleteComplaintRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3ComplaintComplaintApisApiCompleteComplaintRequest ComplaintId(string fieldValue) {
        this.request.PathString("complaint_id", fieldValue);
        return this;
    }

    WechatPayV3ComplaintComplaintApisApiCompleteComplaintRequest ComplaintedMchid(string fieldValue) {
        this.request.BodyString("complainted_mchid", fieldValue);
        return this;
    }

    WechatPayV3ComplaintComplaintApisApiCompleteComplaintRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/merchant-service/complaints-v2/{data.complaint_id}/complete";
        result = result.Replace("{data.complaint_id}", Encoding.UrlEncode(this.request.ValueText("complaint_id")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
