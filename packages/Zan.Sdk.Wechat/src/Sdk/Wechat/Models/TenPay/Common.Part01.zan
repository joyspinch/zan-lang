using System.Security.Cryptography;

namespace Sdk.Wechat.TenPay;

public class WechatPayLegacyUtilities {
    public static string NativePayV1(string sign, string appId, string timestamp,
                              string nonce, string productId) {
        return "weixin://wxpay/bizpayurl?sign=" + sign + "&appid=" + appId
            + "&productid=" + productId + "&timestamp=" + timestamp
            + "&noncestr=" + nonce;
    }

    public static string NativePay(string appId, string timestamp, string merchantId,
                            string nonce, string productId, string sign) {
        return "weixin://wxpay/bizpayurl?sign=" + sign + "&appid=" + appId
            + "&mch_id=" + merchantId + "&product_id=" + productId
            + "&time_stamp=" + timestamp + "&nonce_str=" + nonce;
    }

    public static string GetJsPaySign(string appId, string timestamp, string nonce,
                               string packageValue, string merchantKey,
                               string signType) {
        WechatPayV2Request request = new WechatPayV2Request();
        request.Set("appId", appId);
        request.Set("timeStamp", timestamp);
        request.Set("nonceStr", nonce);
        request.Set("package", packageValue);
        request.Set("signType", signType);
        return request.Sign(merchantKey, signType);
    }
}

