using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3PayScorePayScoreApisApiTerminatePermissionByAuthorizationCodeRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3PayScorePayScoreApisApiTerminatePermissionByAuthorizationCodeRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    public WechatPayV3PayScorePayScoreApisApiTerminatePermissionByAuthorizationCodeRequest AuthorizationCode(string fieldValue) {
        this.request.PathString("authorization_code", fieldValue);
        return this;
    }

    public WechatPayV3PayScorePayScoreApisApiTerminatePermissionByAuthorizationCodeRequest ServiceId(string fieldValue) {
        this.request.BodyString("service_id", fieldValue);
        return this;
    }

    public WechatPayV3PayScorePayScoreApisApiTerminatePermissionByAuthorizationCodeRequest Reason(string fieldValue) {
        this.request.BodyString("reason", fieldValue);
        return this;
    }

    public WechatPayV3PayScorePayScoreApisApiTerminatePermissionByAuthorizationCodeRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    public string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/payscore/permissions/authorization-code/{data.authorization_code}/terminate";
        result = result.Replace("{data.authorization_code}", Encoding.UrlEncode(this.request.ValueText("authorization_code")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
