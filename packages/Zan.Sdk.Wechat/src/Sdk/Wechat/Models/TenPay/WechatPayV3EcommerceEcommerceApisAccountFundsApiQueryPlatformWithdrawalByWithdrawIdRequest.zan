using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3EcommerceEcommerceApisAccountFundsApiQueryPlatformWithdrawalByWithdrawIdRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3EcommerceEcommerceApisAccountFundsApiQueryPlatformWithdrawalByWithdrawIdRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    public WechatPayV3EcommerceEcommerceApisAccountFundsApiQueryPlatformWithdrawalByWithdrawIdRequest WithdrawId(string fieldValue) {
        this.request.QueryString("withdrawId", fieldValue);
        return this;
    }

    public WechatPayV3EcommerceEcommerceApisAccountFundsApiQueryPlatformWithdrawalByWithdrawIdRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    public string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/merchant/fund/withdraw/withdraw-id/{EscapeAccountFundsValue(withdrawId)}";
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
