using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3BrandStoreBrandStoreApisApiCloseBrandStoreRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3BrandStoreBrandStoreApisApiCloseBrandStoreRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3BrandStoreBrandStoreApisApiCloseBrandStoreRequest StoreId(string fieldValue) {
        this.request.PathString("storeId", fieldValue);
        return this;
    }

    WechatPayV3BrandStoreBrandStoreApisApiCloseBrandStoreRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/store/brandstores/{value}";
        result = result.Replace("{value}", Encoding.UrlEncode(this.request.ValueText("storeId")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
