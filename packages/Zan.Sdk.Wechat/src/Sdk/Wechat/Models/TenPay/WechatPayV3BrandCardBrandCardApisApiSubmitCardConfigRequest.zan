using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3BrandCardBrandCardApisApiSubmitCardConfigRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3BrandCardBrandCardApisApiSubmitCardConfigRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3BrandCardBrandCardApisApiSubmitCardConfigRequest BusinessCode(string fieldValue) {
        this.request.BodyString("business_code", fieldValue);
        return this;
    }

    WechatPayV3BrandCardBrandCardApisApiSubmitCardConfigRequest BrandId(string fieldValue) {
        this.request.BodyString("brand_id", fieldValue);
        return this;
    }

    WechatPayV3BrandCardBrandCardApisApiSubmitCardConfigRequest BrandMiniProgramInfo(WechatPayBrandCardMiniProgramInfo fieldValue) {
        this.request.BodyJson("brand_mini_program_info", Json.Serialize<WechatPayBrandCardMiniProgramInfo>(fieldValue));
        return this;
    }

    WechatPayV3BrandCardBrandCardApisApiSubmitCardConfigRequest BrandCustomerService(WechatPayBrandCardCustomerServiceInfo fieldValue) {
        this.request.BodyJson("brand_customer_service", Json.Serialize<WechatPayBrandCardCustomerServiceInfo>(fieldValue));
        return this;
    }

    WechatPayV3BrandCardBrandCardApisApiSubmitCardConfigRequest ServiceList(List<WechatPayBrandCardServiceInfo> fieldValue) {
        this.request.BodyJson("service_list", Json.Serialize<List<WechatPayBrandCardServiceInfo>>(fieldValue));
        return this;
    }

    WechatPayV3BrandCardBrandCardApisApiSubmitCardConfigRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/brand/card/card-configs";
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
