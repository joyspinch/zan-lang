using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3TransferTransferApisApiBatchesRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3TransferTransferApisApiBatchesRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3TransferTransferApisApiBatchesRequest Appid(string fieldValue) {
        this.request.BodyString("appid", fieldValue);
        return this;
    }

    WechatPayV3TransferTransferApisApiBatchesRequest OutBatchNo(string fieldValue) {
        this.request.BodyString("out_batch_no", fieldValue);
        return this;
    }

    WechatPayV3TransferTransferApisApiBatchesRequest BatchName(string fieldValue) {
        this.request.BodyString("batch_name", fieldValue);
        return this;
    }

    WechatPayV3TransferTransferApisApiBatchesRequest BatchRemark(string fieldValue) {
        this.request.BodyString("batch_remark", fieldValue);
        return this;
    }

    WechatPayV3TransferTransferApisApiBatchesRequest TotalAmount(int fieldValue) {
        this.request.BodyInt("total_amount", fieldValue);
        return this;
    }

    WechatPayV3TransferTransferApisApiBatchesRequest TotalNum(int fieldValue) {
        this.request.BodyInt("total_num", fieldValue);
        return this;
    }

    WechatPayV3TransferTransferApisApiBatchesRequest TransferDetailList(List<WechatPayTransferDetailList> fieldValue) {
        this.request.BodyJson("transfer_detail_list", Json.Serialize<List<WechatPayTransferDetailList>>(fieldValue));
        return this;
    }

    WechatPayV3TransferTransferApisApiBatchesRequest TransferSceneId(string fieldValue) {
        this.request.BodyString("transfer_scene_id", fieldValue);
        return this;
    }

    WechatPayV3TransferTransferApisApiBatchesRequest NotifyUrl(string fieldValue) {
        this.request.BodyString("notify_url", fieldValue);
        return this;
    }

    WechatPayV3TransferTransferApisApiBatchesRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/transfer/batches";
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
