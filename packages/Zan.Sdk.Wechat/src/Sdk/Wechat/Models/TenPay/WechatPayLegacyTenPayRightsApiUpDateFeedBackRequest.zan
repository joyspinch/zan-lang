using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayLegacyTenPayRightsApiUpDateFeedBackRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayLegacyTenPayRightsApiUpDateFeedBackRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayLegacyTenPayRightsApiUpDateFeedBackRequest OpenId(string fieldValue) {
        this.request.QueryString("openid", fieldValue);
        return this;
    }

    WechatPayLegacyTenPayRightsApiUpDateFeedBackRequest FeedBackId(string fieldValue) {
        this.request.QueryString("feedbackid", fieldValue);
        return this;
    }

    WechatPayLegacyTenPayRightsApiUpDateFeedBackRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/payfeedback/update";
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
