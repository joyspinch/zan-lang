using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3BasePayBasePayApisApiH5Request {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3BasePayBasePayApisApiH5Request() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3BasePayBasePayApisApiH5Request Appid(string fieldValue) {
        this.request.BodyString("appid", fieldValue);
        return this;
    }

    WechatPayV3BasePayBasePayApisApiH5Request Mchid(string fieldValue) {
        this.request.BodyString("mchid", fieldValue);
        return this;
    }

    WechatPayV3BasePayBasePayApisApiH5Request SpAppid(string fieldValue) {
        this.request.BodyString("sp_appid", fieldValue);
        return this;
    }

    WechatPayV3BasePayBasePayApisApiH5Request SpMchid(string fieldValue) {
        this.request.BodyString("sp_mchid", fieldValue);
        return this;
    }

    WechatPayV3BasePayBasePayApisApiH5Request SubAppid(string fieldValue) {
        this.request.BodyString("sub_appid", fieldValue);
        return this;
    }

    WechatPayV3BasePayBasePayApisApiH5Request SubMchid(string fieldValue) {
        this.request.BodyString("sub_mchid", fieldValue);
        return this;
    }

    WechatPayV3BasePayBasePayApisApiH5Request Description(string fieldValue) {
        this.request.BodyString("description", fieldValue);
        return this;
    }

    WechatPayV3BasePayBasePayApisApiH5Request OutTradeNo(string fieldValue) {
        this.request.BodyString("out_trade_no", fieldValue);
        return this;
    }

    WechatPayV3BasePayBasePayApisApiH5Request TimeExpire(string fieldValue) {
        this.request.BodyString("time_expire", fieldValue);
        return this;
    }

    WechatPayV3BasePayBasePayApisApiH5Request Attach(string fieldValue) {
        this.request.BodyString("attach", fieldValue);
        return this;
    }

    WechatPayV3BasePayBasePayApisApiH5Request NotifyUrl(string fieldValue) {
        this.request.BodyString("notify_url", fieldValue);
        return this;
    }

    WechatPayV3BasePayBasePayApisApiH5Request GoodsTag(string fieldValue) {
        this.request.BodyString("goods_tag", fieldValue);
        return this;
    }

    WechatPayV3BasePayBasePayApisApiH5Request SupportFapiao(bool fieldValue) {
        this.request.BodyBool("support_fapiao", fieldValue);
        return this;
    }

    WechatPayV3BasePayBasePayApisApiH5Request Amount(WechatPayBasePayTransactionsRequestDataAmount fieldValue) {
        this.request.BodyJson("amount", Json.Serialize<WechatPayBasePayTransactionsRequestDataAmount>(fieldValue));
        return this;
    }

    WechatPayV3BasePayBasePayApisApiH5Request Detail(WechatPayBasePayTransactionsRequestDataDetail fieldValue) {
        this.request.BodyJson("detail", Json.Serialize<WechatPayBasePayTransactionsRequestDataDetail>(fieldValue));
        return this;
    }

    WechatPayV3BasePayBasePayApisApiH5Request SceneInfo(WechatPayBasePayTransactionsRequestDataSceneInfo fieldValue) {
        this.request.BodyJson("scene_info", Json.Serialize<WechatPayBasePayTransactionsRequestDataSceneInfo>(fieldValue));
