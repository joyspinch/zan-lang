    WechatPayV3BasePayBasePayApisApiH5Request Payer(WechatPayBasePayTransactionsRequestDataPayer fieldValue) {
        this.request.BodyJson("payer", Json.Serialize<WechatPayBasePayTransactionsRequestDataPayer>(fieldValue));
        return this;
    }

    WechatPayV3BasePayBasePayApisApiH5Request SettleInfo(WechatPayBasePayTransactionsRequestDataSettleInfo fieldValue) {
        this.request.BodyJson("settle_info", Json.Serialize<WechatPayBasePayTransactionsRequestDataSettleInfo>(fieldValue));
        return this;
    }

    WechatPayV3BasePayBasePayApisApiH5Request RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/pay/{1}transactions/h5";
        string partner = "";
        if (this.request.HasValue("sp_mchid")) { partner = "partner/"; }
        result = result.Replace("{1}", partner);
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

