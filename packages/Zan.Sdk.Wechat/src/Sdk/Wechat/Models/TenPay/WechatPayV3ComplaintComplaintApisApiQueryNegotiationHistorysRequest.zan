using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3ComplaintComplaintApisApiQueryNegotiationHistorysRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3ComplaintComplaintApisApiQueryNegotiationHistorysRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    public WechatPayV3ComplaintComplaintApisApiQueryNegotiationHistorysRequest ComplaintId(string fieldValue) {
        this.request.PathString("complaint_id", fieldValue);
        return this;
    }

    public WechatPayV3ComplaintComplaintApisApiQueryNegotiationHistorysRequest Limit(int fieldValue) {
        this.request.QueryInt("limit", fieldValue);
        return this;
    }

    public WechatPayV3ComplaintComplaintApisApiQueryNegotiationHistorysRequest Offset(int fieldValue) {
        this.request.QueryInt("offset", fieldValue);
        return this;
    }

    public WechatPayV3ComplaintComplaintApisApiQueryNegotiationHistorysRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    public string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/merchant-service/complaints-v2/{complaint_id}/negotiation-historys";
        result = result.Replace("{complaint_id}", Encoding.UrlEncode(this.request.ValueText("complaint_id")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
