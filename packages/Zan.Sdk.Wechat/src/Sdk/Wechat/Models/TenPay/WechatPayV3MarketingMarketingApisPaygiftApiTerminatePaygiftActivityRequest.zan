    public WechatPayV3MarketingMarketingApisPaygiftApiTerminatePaygiftActivityRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3MarketingMarketingApisPaygiftApiTerminatePaygiftActivityRequest ActivityId(string fieldValue) {
        this.request.PathString("activity_id", fieldValue);
        return this;
    }

    WechatPayV3MarketingMarketingApisPaygiftApiTerminatePaygiftActivityRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/marketing/paygiftactivity/activities/{activity_id}/terminate";
        result = result.Replace("{activity_id}", Encoding.UrlEncode(this.request.ValueText("activity_id")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
