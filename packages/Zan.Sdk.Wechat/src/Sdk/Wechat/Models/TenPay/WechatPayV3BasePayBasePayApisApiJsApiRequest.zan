using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3BasePayBasePayApisApiJsApiRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3BasePayBasePayApisApiJsApiRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3BasePayBasePayApisApiJsApiRequest Appid(string fieldValue) {
        this.request.BodyString("appid", fieldValue);
        return this;
    }

    WechatPayV3BasePayBasePayApisApiJsApiRequest Mchid(string fieldValue) {
        this.request.BodyString("mchid", fieldValue);
        return this;
    }

    WechatPayV3BasePayBasePayApisApiJsApiRequest SpAppid(string fieldValue) {
        this.request.BodyString("sp_appid", fieldValue);
        return this;
    }

    WechatPayV3BasePayBasePayApisApiJsApiRequest SpMchid(string fieldValue) {
        this.request.BodyString("sp_mchid", fieldValue);
        return this;
    }

    WechatPayV3BasePayBasePayApisApiJsApiRequest SubAppid(string fieldValue) {
        this.request.BodyString("sub_appid", fieldValue);
        return this;
    }

    WechatPayV3BasePayBasePayApisApiJsApiRequest SubMchid(string fieldValue) {
        this.request.BodyString("sub_mchid", fieldValue);
        return this;
    }

    WechatPayV3BasePayBasePayApisApiJsApiRequest Description(string fieldValue) {
        this.request.BodyString("description", fieldValue);
        return this;
    }

    WechatPayV3BasePayBasePayApisApiJsApiRequest OutTradeNo(string fieldValue) {
        this.request.BodyString("out_trade_no", fieldValue);
        return this;
    }

    WechatPayV3BasePayBasePayApisApiJsApiRequest TimeExpire(string fieldValue) {
        this.request.BodyString("time_expire", fieldValue);
        return this;
    }

    WechatPayV3BasePayBasePayApisApiJsApiRequest Attach(string fieldValue) {
        this.request.BodyString("attach", fieldValue);
        return this;
    }

    WechatPayV3BasePayBasePayApisApiJsApiRequest NotifyUrl(string fieldValue) {
        this.request.BodyString("notify_url", fieldValue);
        return this;
    }

    WechatPayV3BasePayBasePayApisApiJsApiRequest GoodsTag(string fieldValue) {
        this.request.BodyString("goods_tag", fieldValue);
        return this;
    }

    WechatPayV3BasePayBasePayApisApiJsApiRequest SupportFapiao(bool fieldValue) {
        this.request.BodyBool("support_fapiao", fieldValue);
        return this;
    }

    WechatPayV3BasePayBasePayApisApiJsApiRequest Amount(WechatPayBasePayTransactionsRequestDataAmount fieldValue) {
        this.request.BodyJson("amount", Json.Serialize<WechatPayBasePayTransactionsRequestDataAmount>(fieldValue));
        return this;
    }

    WechatPayV3BasePayBasePayApisApiJsApiRequest Detail(WechatPayBasePayTransactionsRequestDataDetail fieldValue) {
        this.request.BodyJson("detail", Json.Serialize<WechatPayBasePayTransactionsRequestDataDetail>(fieldValue));
        return this;
    }

    WechatPayV3BasePayBasePayApisApiJsApiRequest SceneInfo(WechatPayBasePayTransactionsRequestDataSceneInfo fieldValue) {
        this.request.BodyJson("scene_info", Json.Serialize<WechatPayBasePayTransactionsRequestDataSceneInfo>(fieldValue));
        return this;
    }

    WechatPayV3BasePayBasePayApisApiJsApiRequest Payer(WechatPayBasePayTransactionsRequestDataPayer fieldValue) {
        this.request.BodyJson("payer", Json.Serialize<WechatPayBasePayTransactionsRequestDataPayer>(fieldValue));
        return this;
    }

    WechatPayV3BasePayBasePayApisApiJsApiRequest SettleInfo(WechatPayBasePayTransactionsRequestDataSettleInfo fieldValue) {
        this.request.BodyJson("settle_info", Json.Serialize<WechatPayBasePayTransactionsRequestDataSettleInfo>(fieldValue));
        return this;
    }

    WechatPayV3BasePayBasePayApisApiJsApiRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/pay/{1}transactions/jsapi";
        string partner = "";
        if (this.request.HasValue("sp_mchid")) { partner = "partner/"; }
        result = result.Replace("{1}", partner);
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
