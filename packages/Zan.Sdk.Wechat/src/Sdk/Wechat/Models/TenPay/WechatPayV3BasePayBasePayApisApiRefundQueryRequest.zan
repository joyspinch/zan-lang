using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3BasePayBasePayApisApiRefundQueryRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3BasePayBasePayApisApiRefundQueryRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    public WechatPayV3BasePayBasePayApisApiRefundQueryRequest OutRefundNo(string fieldValue) {
        this.request.PathString("out_refund_no", fieldValue);
        return this;
    }

    public WechatPayV3BasePayBasePayApisApiRefundQueryRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    public string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/refund/domestic/refunds/{out_refund_no}";
        result = result.Replace("{out_refund_no}", Encoding.UrlEncode(this.request.ValueText("out_refund_no")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
