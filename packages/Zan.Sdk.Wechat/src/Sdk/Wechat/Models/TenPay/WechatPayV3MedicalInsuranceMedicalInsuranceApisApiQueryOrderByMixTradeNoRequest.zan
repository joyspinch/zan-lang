    public string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/med-ins/orders/mix-trade-no/{Escape(mixTradeNo)}";
        result = result.Replace("{Escape(mixTradeNo)}", Encoding.UrlEncode(this.request.ValueText("mixTradeNo")));
