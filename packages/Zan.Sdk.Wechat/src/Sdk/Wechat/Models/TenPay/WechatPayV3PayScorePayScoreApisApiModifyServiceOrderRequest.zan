using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3PayScorePayScoreApisApiModifyServiceOrderRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3PayScorePayScoreApisApiModifyServiceOrderRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    public WechatPayV3PayScorePayScoreApisApiModifyServiceOrderRequest OutOrderNo(string fieldValue) {
        this.request.PathString("out_order_no", fieldValue);
        return this;
    }

    public WechatPayV3PayScorePayScoreApisApiModifyServiceOrderRequest Appid(string fieldValue) {
        this.request.BodyString("appid", fieldValue);
        return this;
    }

    public WechatPayV3PayScorePayScoreApisApiModifyServiceOrderRequest ServiceId(string fieldValue) {
        this.request.BodyString("service_id", fieldValue);
        return this;
    }

    public WechatPayV3PayScorePayScoreApisApiModifyServiceOrderRequest PostPayments(List<WechatPayPayScoreModifyServiceOrderRequestDataPostPayment> fieldValue) {
        this.request.BodyJson("post_payments", Json.Serialize<List<WechatPayPayScoreModifyServiceOrderRequestDataPostPayment>>(fieldValue));
        return this;
    }

    public WechatPayV3PayScorePayScoreApisApiModifyServiceOrderRequest PostDiscounts(List<WechatPayPayScoreModifyServiceOrderRequestDataPostDiscount> fieldValue) {
        this.request.BodyJson("post_discounts", Json.Serialize<List<WechatPayPayScoreModifyServiceOrderRequestDataPostDiscount>>(fieldValue));
        return this;
    }

    public WechatPayV3PayScorePayScoreApisApiModifyServiceOrderRequest TotalAmount(long fieldValue) {
        this.request.BodyLong("total_amount", fieldValue);
        return this;
    }

    public WechatPayV3PayScorePayScoreApisApiModifyServiceOrderRequest Reason(string fieldValue) {
        this.request.BodyString("reason", fieldValue);
        return this;
    }

    public WechatPayV3PayScorePayScoreApisApiModifyServiceOrderRequest Device(WechatPayServiceOrderRequestDevice fieldValue) {
        this.request.BodyJson("device", Json.Serialize<WechatPayServiceOrderRequestDevice>(fieldValue));
        return this;
    }

    public WechatPayV3PayScorePayScoreApisApiModifyServiceOrderRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    public string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/payscore/serviceorder/{data.out_order_no}/modify";
        result = result.Replace("{data.out_order_no}", Encoding.UrlEncode(this.request.ValueText("out_order_no")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
