using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3DeliveryPlanDeliveryPlanApisApiSetDeliveryPlanNotifyUrlRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3DeliveryPlanDeliveryPlanApisApiSetDeliveryPlanNotifyUrlRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3DeliveryPlanDeliveryPlanApisApiSetDeliveryPlanNotifyUrlRequest NotifyUrl(string fieldValue) {
        this.request.BodyString("notify_url", fieldValue);
        return this;
    }

    WechatPayV3DeliveryPlanDeliveryPlanApisApiSetDeliveryPlanNotifyUrlRequest ServiceProviderMchId(string fieldValue) {
        this.request.BodyString("serviceProviderMchId", fieldValue);
        return this;
    }

    WechatPayV3DeliveryPlanDeliveryPlanApisApiSetDeliveryPlanNotifyUrlRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/marketing/partner/delivery-plan/{EscapeDeliveryPlanValue(serviceProviderMchId)}/notify-url";
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
