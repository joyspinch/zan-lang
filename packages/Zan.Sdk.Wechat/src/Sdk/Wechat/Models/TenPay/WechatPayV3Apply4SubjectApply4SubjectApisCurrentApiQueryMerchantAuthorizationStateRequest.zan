public class WechatPayV3Apply4SubjectApply4SubjectApisCurrentApiQueryMerchantAuthorizationStateRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3Apply4SubjectApply4SubjectApisCurrentApiQueryMerchantAuthorizationStateRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    public WechatPayV3Apply4SubjectApply4SubjectApisCurrentApiQueryMerchantAuthorizationStateRequest SubMchId(string fieldValue) {
        this.request.PathString("subMchId", fieldValue);
        return this;
    }

    public WechatPayV3Apply4SubjectApply4SubjectApisCurrentApiQueryMerchantAuthorizationStateRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    public string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/apply4subject/applyment/merchants/{Escape(subMchId)}/state";
        result = result.Replace("{Escape(subMchId)}", Encoding.UrlEncode(this.request.ValueText("subMchId")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

