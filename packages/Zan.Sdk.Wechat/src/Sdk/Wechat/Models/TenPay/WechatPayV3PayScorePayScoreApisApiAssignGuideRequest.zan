using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3PayScorePayScoreApisApiAssignGuideRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3PayScorePayScoreApisApiAssignGuideRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    public WechatPayV3PayScorePayScoreApisApiAssignGuideRequest SubMchid(string fieldValue) {
        this.request.BodyString("sub_mchid", fieldValue);
        return this;
    }

    public WechatPayV3PayScorePayScoreApisApiAssignGuideRequest GuideId(string fieldValue) {
        this.request.PathString("guide_id", fieldValue);
        return this;
    }

    public WechatPayV3PayScorePayScoreApisApiAssignGuideRequest OutTradeNo(string fieldValue) {
        this.request.BodyString("out_trade_no", fieldValue);
        return this;
    }

    public WechatPayV3PayScorePayScoreApisApiAssignGuideRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    public string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/smartguide/guides/{data.guide_id}/assign";
        result = result.Replace("{data.guide_id}", Encoding.UrlEncode(this.request.ValueText("guide_id")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
