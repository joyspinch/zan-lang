using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3FaPiaoFaPiaoApisApiQueryFapiaoRequest {
    WechatTypedRequest request;
    string overridePath;

    public WechatPayV3FaPiaoFaPiaoApisApiQueryFapiaoRequest() {
        this.request = new WechatTypedRequest();
        this.overridePath = "";
    }

    WechatPayV3FaPiaoFaPiaoApisApiQueryFapiaoRequest FapiaoApplyId(string fieldValue) {
        this.request.PathString("fapiao_apply_id", fieldValue);
        return this;
    }

    WechatPayV3FaPiaoFaPiaoApisApiQueryFapiaoRequest RequestPath(string fieldValue) {
        this.overridePath = fieldValue;
        return this;
    }

    string Path() {
        if (this.overridePath.Length > 0) { return this.overridePath; }
        string result = "/v3/new-tax-control-fapiao/fapiao-applications/{data.fapiao_apply_id}";
        result = result.Replace("{data.fapiao_apply_id}", Encoding.UrlEncode(this.request.ValueText("fapiao_apply_id")));
        return result;
    }
    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }

}
