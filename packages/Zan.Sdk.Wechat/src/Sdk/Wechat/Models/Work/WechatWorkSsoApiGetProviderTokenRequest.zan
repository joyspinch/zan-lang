using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkSsoApiGetProviderTokenRequest {
    WechatTypedRequest request;

    public WechatWorkSsoApiGetProviderTokenRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkSsoApiGetProviderTokenRequest CorpId(string fieldValue) {
        this.request.BodyString("corpid", fieldValue);
        return this;
    }

    WechatWorkSsoApiGetProviderTokenRequest ProviderSecret(string fieldValue) {
        this.request.BodyString("provider_secret", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
