using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkCustomerTagApiExternalContactMarkTagRequest {
    WechatTypedRequest request;

    public WechatWorkCustomerTagApiExternalContactMarkTagRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkCustomerTagApiExternalContactMarkTagRequest Userid(string fieldValue) {
        this.request.BodyString("userid", fieldValue);
        return this;
    }

    WechatWorkCustomerTagApiExternalContactMarkTagRequest ExternalUserid(string fieldValue) {
        this.request.BodyString("external_userid", fieldValue);
        return this;
    }

    WechatWorkCustomerTagApiExternalContactMarkTagRequest AddTag(List<string> fieldValue) {
        this.request.BodyStrings("add_tag", fieldValue);
        return this;
    }

    WechatWorkCustomerTagApiExternalContactMarkTagRequest RemoveTag(List<string> fieldValue) {
        this.request.BodyStrings("remove_tag", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
