using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkAsynchronousApiBatchReplacePartyRequest {
    WechatTypedRequest request;

    public WechatWorkAsynchronousApiBatchReplacePartyRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkAsynchronousApiBatchReplacePartyRequest Url(string fieldValue) {
        this.request.BodyString("url", fieldValue);
        return this;
    }

    public WechatWorkAsynchronousApiBatchReplacePartyRequest Token(string fieldValue) {
        this.request.BodyString("token", fieldValue);
        return this;
    }

    public WechatWorkAsynchronousApiBatchReplacePartyRequest Encodingaeskey(string fieldValue) {
        this.request.BodyString("encodingaeskey", fieldValue);
        return this;
    }

    public WechatWorkAsynchronousApiBatchReplacePartyRequest MediaId(string fieldValue) {
        this.request.BodyString("mediaId", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
