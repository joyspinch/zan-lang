using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkThirdPartyAuthApiGetUserInfoRequest {
    WechatTypedRequest request;

    public WechatWorkThirdPartyAuthApiGetUserInfoRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkThirdPartyAuthApiGetUserInfoRequest SuiteAccessToken(string fieldValue) {
        this.request.QueryString("suiteAccessToken", fieldValue);
        return this;
    }

    WechatWorkThirdPartyAuthApiGetUserInfoRequest Code(string fieldValue) {
        this.request.QueryString("code", fieldValue);
        return this;
    }

    WechatWorkThirdPartyAuthApiGetUserInfoRequest AgentId(string fieldValue) {
        this.request.QueryString("agentId", fieldValue);
        return this;
    }

    WechatWorkThirdPartyAuthApiGetUserInfoRequest AuthCorpId(string fieldValue) {
        this.request.QueryString("authCorpId", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
