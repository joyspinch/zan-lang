using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkWebhookApiSendTemplateCardRequest {
    WechatTypedRequest request;

    public WechatWorkWebhookApiSendTemplateCardRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkWebhookApiSendTemplateCardRequest CardType(string fieldValue) {
        this.request.BodyString("card_type", fieldValue);
        return this;
    }

    public WechatWorkWebhookApiSendTemplateCardRequest Source(WechatWorkSourceInfo fieldValue) {
        this.request.BodyJson("source", Json.Serialize<WechatWorkSourceInfo>(fieldValue));
        return this;
    }

    public WechatWorkWebhookApiSendTemplateCardRequest MainTitle(WechatWorkMainTitleInfo fieldValue) {
        this.request.BodyJson("main_title", Json.Serialize<WechatWorkMainTitleInfo>(fieldValue));
        return this;
    }

    public WechatWorkWebhookApiSendTemplateCardRequest CardImage(WechatWorkCardImage fieldValue) {
        this.request.BodyJson("card_image", Json.Serialize<WechatWorkCardImage>(fieldValue));
        return this;
    }

    public WechatWorkWebhookApiSendTemplateCardRequest ImageTextArea(WechatWorkImageTextArea fieldValue) {
        this.request.BodyJson("image_text_area", Json.Serialize<WechatWorkImageTextArea>(fieldValue));
        return this;
    }

    public WechatWorkWebhookApiSendTemplateCardRequest EmphasisContent(WechatWorkEmphasisContentInfo fieldValue) {
        this.request.BodyJson("emphasis_content", Json.Serialize<WechatWorkEmphasisContentInfo>(fieldValue));
        return this;
    }

    public WechatWorkWebhookApiSendTemplateCardRequest QuoteArea(WechatWorkQuoteAreaInfo fieldValue) {
        this.request.BodyJson("quote_area", Json.Serialize<WechatWorkQuoteAreaInfo>(fieldValue));
        return this;
    }

    public WechatWorkWebhookApiSendTemplateCardRequest SubTitleText(string fieldValue) {
        this.request.BodyString("sub_title_text", fieldValue);
        return this;
    }

    public WechatWorkWebhookApiSendTemplateCardRequest CardAction(WechatWorkCardActionInfo fieldValue) {
        this.request.BodyJson("card_action", Json.Serialize<WechatWorkCardActionInfo>(fieldValue));
        return this;
    }

    public WechatWorkWebhookApiSendTemplateCardRequest Key(string fieldValue) {
        this.request.QueryString("key", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
