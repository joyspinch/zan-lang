using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkMiniProgramMiniApiThirdLoginCheckRequest {
    WechatTypedRequest request;

    public WechatWorkMiniProgramMiniApiThirdLoginCheckRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkMiniProgramMiniApiThirdLoginCheckRequest Code(string fieldValue) {
        this.request.QueryString("code", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
