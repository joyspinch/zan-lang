using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkMassApiSendTextRequest {
    WechatTypedRequest request;

    public WechatWorkMassApiSendTextRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkMassApiSendTextRequest ToUser(string fieldValue) {
        this.request.BodyString("touser", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendTextRequest ToParty(string fieldValue) {
        this.request.BodyString("toparty", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendTextRequest ToTag(string fieldValue) {
        this.request.BodyString("totag", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendTextRequest AgentId(string fieldValue) {
        this.request.BodyString("agentid", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendTextRequest Content(string fieldValue) {
        this.request.BodyString("text", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendTextRequest Safe(int fieldValue) {
        this.request.BodyInt("safe", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendTextRequest EnableDuplicateCheck(int fieldValue) {
        this.request.BodyInt("enable_duplicate_check", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendTextRequest DuplicateCheckInterval(int fieldValue) {
        this.request.BodyInt("duplicate_check_interval", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
