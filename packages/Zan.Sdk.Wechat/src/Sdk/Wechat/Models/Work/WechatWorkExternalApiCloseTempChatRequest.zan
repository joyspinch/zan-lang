using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkExternalApiCloseTempChatRequest {
    WechatTypedRequest request;

    public WechatWorkExternalApiCloseTempChatRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkExternalApiCloseTempChatRequest Userid(string fieldValue) {
        this.request.BodyString("userid", fieldValue);
        return this;
    }

    WechatWorkExternalApiCloseTempChatRequest ExternalUserid(string fieldValue) {
        this.request.BodyString("external_userid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
