using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkMediaApiGetCountRequest {
    WechatTypedRequest request;

    public WechatWorkMediaApiGetCountRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkMediaApiGetCountRequest AgentId(int fieldValue) {
        this.request.QueryInt("agentid", fieldValue);
