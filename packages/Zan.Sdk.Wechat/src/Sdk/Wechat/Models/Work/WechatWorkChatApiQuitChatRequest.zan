using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkChatApiQuitChatRequest {
    WechatTypedRequest request;

    public WechatWorkChatApiQuitChatRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkChatApiQuitChatRequest ChatId(string fieldValue) {
        this.request.BodyString("chatid", fieldValue);
        return this;
    }

    WechatWorkChatApiQuitChatRequest OpUser(string fieldValue) {
        this.request.BodyString("op_user", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
