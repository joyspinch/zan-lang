using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkOaApiGetApprovalDetailRequest {
    WechatTypedRequest request;

    public WechatWorkOaApiGetApprovalDetailRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkOaApiGetApprovalDetailRequest SpNo(string fieldValue) {
        this.request.BodyString("sp_no", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
