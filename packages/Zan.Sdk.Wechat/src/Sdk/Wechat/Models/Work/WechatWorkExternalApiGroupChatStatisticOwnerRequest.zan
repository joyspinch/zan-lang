using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkExternalApiGroupChatStatisticOwnerRequest {
    WechatTypedRequest request;

    public WechatWorkExternalApiGroupChatStatisticOwnerRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkExternalApiGroupChatStatisticOwnerRequest DayBeginTime(long fieldValue) {
        this.request.BodyLong("day_begin_time", fieldValue);
        return this;
    }

    WechatWorkExternalApiGroupChatStatisticOwnerRequest DayEndTime(long fieldValue) {
        this.request.BodyLong("day_end_time", fieldValue);
        return this;
    }

    WechatWorkExternalApiGroupChatStatisticOwnerRequest OwnerFilter(WechatWorkGroupChatOwnerFilter fieldValue) {
        this.request.BodyJson("owner_filter", Json.Serialize<WechatWorkGroupChatOwnerFilter>(fieldValue));
        return this;
    }

    WechatWorkExternalApiGroupChatStatisticOwnerRequest OrderBy(int fieldValue) {
        this.request.BodyInt("order_by", fieldValue);
        return this;
    }

    WechatWorkExternalApiGroupChatStatisticOwnerRequest OrderAsc(int fieldValue) {
        this.request.BodyInt("order_asc", fieldValue);
        return this;
    }

    WechatWorkExternalApiGroupChatStatisticOwnerRequest Offset(int fieldValue) {
        this.request.BodyInt("offset", fieldValue);
        return this;
    }

    WechatWorkExternalApiGroupChatStatisticOwnerRequest Limit(int fieldValue) {
        this.request.BodyInt("limit", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
