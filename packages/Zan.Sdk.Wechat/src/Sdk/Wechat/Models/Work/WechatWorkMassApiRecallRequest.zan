using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkMassApiRecallRequest {
    WechatTypedRequest request;

    public WechatWorkMassApiRecallRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkMassApiRecallRequest MsgId(string fieldValue) {
        this.request.BodyString("msgid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
