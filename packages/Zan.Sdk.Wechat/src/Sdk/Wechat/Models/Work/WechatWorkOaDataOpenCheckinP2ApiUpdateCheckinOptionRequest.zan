using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkOaDataOpenCheckinP2ApiUpdateCheckinOptionRequest {
    WechatTypedRequest request;

    public WechatWorkOaDataOpenCheckinP2ApiUpdateCheckinOptionRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkOaDataOpenCheckinP2ApiUpdateCheckinOptionRequest EffectiveNow(bool fieldValue) {
        this.request.BodyBool("effective_now", fieldValue);
        return this;
    }

    WechatWorkOaDataOpenCheckinP2ApiUpdateCheckinOptionRequest Group(WechatWorkGroup fieldValue) {
        this.request.BodyJson("group", Json.Serialize<WechatWorkGroup>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
