using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkLoginAuthApiGetLoginUrlRequest {
    WechatTypedRequest request;

    public WechatWorkLoginAuthApiGetLoginUrlRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkLoginAuthApiGetLoginUrlRequest LoginTicket(string fieldValue) {
        this.request.BodyString("login_ticket", fieldValue);
        return this;
    }

    public WechatWorkLoginAuthApiGetLoginUrlRequest Target(string fieldValue) {
        this.request.BodyString("target", fieldValue);
        return this;
    }

    public WechatWorkLoginAuthApiGetLoginUrlRequest Agentid(int fieldValue) {
        this.request.BodyInt("agentid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
