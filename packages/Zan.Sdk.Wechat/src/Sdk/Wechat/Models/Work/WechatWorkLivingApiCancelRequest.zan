using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkLivingApiCancelRequest {
    WechatTypedRequest request;

    public WechatWorkLivingApiCancelRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkLivingApiCancelRequest Livingid(string fieldValue) {
        this.request.BodyString("livingid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
