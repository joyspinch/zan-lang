using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkLivingApiGetLivingInfoRequest {
    WechatTypedRequest request;

    public WechatWorkLivingApiGetLivingInfoRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkLivingApiGetLivingInfoRequest Livingid(string fieldValue) {
        this.request.QueryString("livingid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
