using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkChatApiCreateChatRequest {
    WechatTypedRequest request;

    public WechatWorkChatApiCreateChatRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkChatApiCreateChatRequest ChatId(string fieldValue) {
        this.request.BodyString("chatid", fieldValue);
        return this;
    }

    WechatWorkChatApiCreateChatRequest Name(string fieldValue) {
        this.request.BodyString("name", fieldValue);
        return this;
    }

    WechatWorkChatApiCreateChatRequest Owner(string fieldValue) {
        this.request.BodyString("owner", fieldValue);
        return this;
    }

    WechatWorkChatApiCreateChatRequest Userlist(List<string> fieldValue) {
        this.request.BodyStrings("userlist", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
