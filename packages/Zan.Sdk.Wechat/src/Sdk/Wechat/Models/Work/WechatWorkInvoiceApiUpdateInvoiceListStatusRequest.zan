using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkInvoiceApiUpdateInvoiceListStatusRequest {
    WechatTypedRequest request;

    public WechatWorkInvoiceApiUpdateInvoiceListStatusRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkInvoiceApiUpdateInvoiceListStatusRequest OpenId(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    WechatWorkInvoiceApiUpdateInvoiceListStatusRequest ReimburseStatus(string fieldValue) {
        this.request.BodyString("reimburse_status", fieldValue);
        return this;
    }

    WechatWorkInvoiceApiUpdateInvoiceListStatusRequest ItemList(List<WechatWorkInvoiceItem> fieldValue) {
        this.request.BodyJson("invoice_list", Json.Serialize<List<WechatWorkInvoiceItem>>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
