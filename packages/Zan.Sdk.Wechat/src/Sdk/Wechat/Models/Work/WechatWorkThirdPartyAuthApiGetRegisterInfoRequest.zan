using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkThirdPartyAuthApiGetRegisterInfoRequest {
    WechatTypedRequest request;

    public WechatWorkThirdPartyAuthApiGetRegisterInfoRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkThirdPartyAuthApiGetRegisterInfoRequest RegisterCode(string fieldValue) {
        this.request.BodyString("register_code", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
