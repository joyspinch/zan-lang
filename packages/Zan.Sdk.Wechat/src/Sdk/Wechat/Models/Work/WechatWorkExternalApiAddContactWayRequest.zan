    }

    public WechatWorkExternalApiAddContactWayRequest ExpiresIn(int fieldValue) {
        this.request.BodyInt("expires_in", fieldValue);
        return this;
    }

    public WechatWorkExternalApiAddContactWayRequest ChatExpiresIn(int fieldValue) {
