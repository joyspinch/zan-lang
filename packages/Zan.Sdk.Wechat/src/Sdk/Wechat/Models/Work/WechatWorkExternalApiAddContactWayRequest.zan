    }

    public WechatWorkExternalApiAddContactWayRequest Unionid(string fieldValue) {
        this.request.BodyString("unionid", fieldValue);
        return this;
    }

    public WechatWorkExternalApiAddContactWayRequest Conclusions(WechatWorkConclusions fieldValue) {
        this.request.BodyJson("conclusions", Json.Serialize<WechatWorkConclusions>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
