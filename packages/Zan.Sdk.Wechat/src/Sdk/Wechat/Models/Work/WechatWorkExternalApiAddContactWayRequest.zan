using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkExternalApiAddContactWayRequest {
    WechatTypedRequest request;

    public WechatWorkExternalApiAddContactWayRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkExternalApiAddContactWayRequest Type(int fieldValue) {
        this.request.BodyInt("type", fieldValue);
        return this;
    }

    public WechatWorkExternalApiAddContactWayRequest Scene(int fieldValue) {
        this.request.BodyInt("scene", fieldValue);
        return this;
    }

    public WechatWorkExternalApiAddContactWayRequest Style(int fieldValue) {
        this.request.BodyInt("style", fieldValue);
        return this;
    }

    public WechatWorkExternalApiAddContactWayRequest Remark(string fieldValue) {
        this.request.BodyString("remark", fieldValue);
        return this;
    }

    public WechatWorkExternalApiAddContactWayRequest SkipVerify(bool fieldValue) {
        this.request.BodyBool("skip_verify", fieldValue);
        return this;
    }

    public WechatWorkExternalApiAddContactWayRequest State(string fieldValue) {
        this.request.BodyString("state", fieldValue);
        return this;
    }

    public WechatWorkExternalApiAddContactWayRequest User(List<string> fieldValue) {
        this.request.BodyStrings("user", fieldValue);
        return this;
    }

    public WechatWorkExternalApiAddContactWayRequest Party(List<int> fieldValue) {
        this.request.BodyInts("party", fieldValue);
        return this;
    }

    public WechatWorkExternalApiAddContactWayRequest IsTemp(bool fieldValue) {
        this.request.BodyBool("is_temp", fieldValue);
