using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkExternalApiAddContactWayRequest {
    WechatTypedRequest request;

    public WechatWorkExternalApiAddContactWayRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkExternalApiAddContactWayRequest Type(int fieldValue) {
        this.request.BodyInt("type", fieldValue);
        return this;
    }

    WechatWorkExternalApiAddContactWayRequest Scene(int fieldValue) {
        this.request.BodyInt("scene", fieldValue);
        return this;
    }

    WechatWorkExternalApiAddContactWayRequest Style(int fieldValue) {
        this.request.BodyInt("style", fieldValue);
        return this;
    }

    WechatWorkExternalApiAddContactWayRequest Remark(string fieldValue) {
        this.request.BodyString("remark", fieldValue);
        return this;
    }

    WechatWorkExternalApiAddContactWayRequest SkipVerify(bool fieldValue) {
        this.request.BodyBool("skip_verify", fieldValue);
        return this;
    }

    WechatWorkExternalApiAddContactWayRequest State(string fieldValue) {
        this.request.BodyString("state", fieldValue);
        return this;
    }

    WechatWorkExternalApiAddContactWayRequest User(List<string> fieldValue) {
        this.request.BodyStrings("user", fieldValue);
        return this;
    }

    WechatWorkExternalApiAddContactWayRequest Party(List<int> fieldValue) {
        this.request.BodyInts("party", fieldValue);
        return this;
    }

    WechatWorkExternalApiAddContactWayRequest IsTemp(bool fieldValue) {
        this.request.BodyBool("is_temp", fieldValue);
        return this;
    }

    WechatWorkExternalApiAddContactWayRequest ExpiresIn(int fieldValue) {
        this.request.BodyInt("expires_in", fieldValue);
        return this;
    }

    WechatWorkExternalApiAddContactWayRequest ChatExpiresIn(int fieldValue) {
        this.request.BodyInt("chat_expires_in", fieldValue);
        return this;
    }

    WechatWorkExternalApiAddContactWayRequest Unionid(string fieldValue) {
        this.request.BodyString("unionid", fieldValue);
        return this;
    }

    WechatWorkExternalApiAddContactWayRequest Conclusions(WechatWorkConclusions fieldValue) {
        this.request.BodyJson("conclusions", Json.Serialize<WechatWorkConclusions>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
