using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkExternalApiGetExternalContactRequest {
    WechatTypedRequest request;

    public WechatWorkExternalApiGetExternalContactRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkExternalApiGetExternalContactRequest ExternalUserId(string fieldValue) {
        this.request.QueryString("external_userid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
