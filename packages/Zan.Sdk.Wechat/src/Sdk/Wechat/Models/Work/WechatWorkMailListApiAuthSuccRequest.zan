using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkMailListApiAuthSuccRequest {
    WechatTypedRequest request;

    public WechatWorkMailListApiAuthSuccRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkMailListApiAuthSuccRequest UserId(string fieldValue) {
        this.request.QueryString("userid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
