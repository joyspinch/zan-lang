using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkCalendarApiDelRequest {
    WechatTypedRequest request;

    public WechatWorkCalendarApiDelRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkCalendarApiDelRequest CalId(string fieldValue) {
        this.request.BodyString("cal_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
