using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkThirdPartyAuthApiContactSyncSuccessRequest {
    WechatTypedRequest request;

    public WechatWorkThirdPartyAuthApiContactSyncSuccessRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkThirdPartyAuthApiContactSyncSuccessRequest AccessToken(string fieldValue) {
        this.request.QueryString("AccessToken", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
