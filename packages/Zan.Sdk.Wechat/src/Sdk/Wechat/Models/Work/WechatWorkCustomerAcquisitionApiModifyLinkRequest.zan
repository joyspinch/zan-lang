using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkCustomerAcquisitionApiModifyLinkRequest {
    WechatTypedRequest request;

    public WechatWorkCustomerAcquisitionApiModifyLinkRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkCustomerAcquisitionApiModifyLinkRequest LinkId(string fieldValue) {
        this.request.BodyString("link_id", fieldValue);
        return this;
    }

    public WechatWorkCustomerAcquisitionApiModifyLinkRequest LinkName(string fieldValue) {
        this.request.BodyString("link_name", fieldValue);
        return this;
    }

    public WechatWorkCustomerAcquisitionApiModifyLinkRequest Range(WechatWorkCustomerAcquisitionRange fieldValue) {
        this.request.BodyJson("range", Json.Serialize<WechatWorkCustomerAcquisitionRange>(fieldValue));
        return this;
    }

    public WechatWorkCustomerAcquisitionApiModifyLinkRequest SkipVerify(bool fieldValue) {
        this.request.BodyBool("skip_verify", fieldValue);
        return this;
    }

    public WechatWorkCustomerAcquisitionApiModifyLinkRequest AcquisitionPriority(WechatWorkCustomerAcquisitionPriority fieldValue) {
        this.request.BodyJson("AcquisitionPriority", Json.Serialize<WechatWorkCustomerAcquisitionPriority>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
