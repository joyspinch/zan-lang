using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkMediaApiDeleteForeverMaterialRequest {
    WechatTypedRequest request;

    public WechatWorkMediaApiDeleteForeverMaterialRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkMediaApiDeleteForeverMaterialRequest AgentId(int fieldValue) {
        this.request.QueryInt("agentid", fieldValue);
        return this;
    }

    WechatWorkMediaApiDeleteForeverMaterialRequest MediaId(string fieldValue) {
        this.request.QueryString("media_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
