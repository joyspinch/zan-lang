using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkExternalApiGroupChatListRequest {
    WechatTypedRequest request;

    public WechatWorkExternalApiGroupChatListRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkExternalApiGroupChatListRequest StatusFilter(int fieldValue) {
        this.request.BodyInt("status_filter", fieldValue);
        return this;
    }

    public WechatWorkExternalApiGroupChatListRequest OwnerFilter(WechatWorkOwnerFilter fieldValue) {
        this.request.BodyJson("owner_filter", Json.Serialize<WechatWorkOwnerFilter>(fieldValue));
        return this;
    }

    public WechatWorkExternalApiGroupChatListRequest Cursor(string fieldValue) {
        this.request.BodyString("cursor", fieldValue);
        return this;
    }

    public WechatWorkExternalApiGroupChatListRequest Limit(int fieldValue) {
        this.request.BodyInt("limit", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
