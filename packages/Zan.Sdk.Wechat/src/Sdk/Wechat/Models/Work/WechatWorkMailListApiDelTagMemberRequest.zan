using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkMailListApiDelTagMemberRequest {
    WechatTypedRequest request;

    public WechatWorkMailListApiDelTagMemberRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkMailListApiDelTagMemberRequest TagId(int fieldValue) {
        this.request.BodyInt("tagid", fieldValue);
        return this;
    }

    WechatWorkMailListApiDelTagMemberRequest UserList(List<string> fieldValue) {
        this.request.BodyStrings("userlist", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
