using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkScheduleApiDelRequest {
    WechatTypedRequest request;

    public WechatWorkScheduleApiDelRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkScheduleApiDelRequest ScheduleId(string fieldValue) {
        this.request.BodyString("schedule_id", fieldValue);
        return this;
    }

    WechatWorkScheduleApiDelRequest OpMode(int fieldValue) {
        this.request.BodyInt("op_mode", fieldValue);
        return this;
    }

    WechatWorkScheduleApiDelRequest OpStartTime(int fieldValue) {
        this.request.BodyInt("op_start_time", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
