using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkExternalApiAddCropTagRequest {
    WechatTypedRequest request;

    public WechatWorkExternalApiAddCropTagRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkExternalApiAddCropTagRequest GroupId(string fieldValue) {
        this.request.BodyString("group_id", fieldValue);
        return this;
    }

    public WechatWorkExternalApiAddCropTagRequest GroupName(string fieldValue) {
        this.request.BodyString("group_name", fieldValue);
        return this;
    }

    public WechatWorkExternalApiAddCropTagRequest Order(int fieldValue) {
        this.request.BodyInt("order", fieldValue);
        return this;
    }

    public WechatWorkExternalApiAddCropTagRequest Tag(List<WechatWorkAddCorpTagRequestTag> fieldValue) {
        this.request.BodyJson("tag", Json.Serialize<List<WechatWorkAddCorpTagRequestTag>>(fieldValue));
        return this;
    }

    public WechatWorkExternalApiAddCropTagRequest Agentid(int fieldValue) {
        this.request.BodyInt("agentid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
