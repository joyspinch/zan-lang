using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkCustomerAcquisitionApiCreateLinkRequest {
    WechatTypedRequest request;

    public WechatWorkCustomerAcquisitionApiCreateLinkRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkCustomerAcquisitionApiCreateLinkRequest LinkName(string fieldValue) {
        this.request.BodyString("link_name", fieldValue);
        return this;
    }

    public WechatWorkCustomerAcquisitionApiCreateLinkRequest Range(WechatWorkCustomerAcquisitionRange fieldValue) {
        this.request.BodyJson("range", Json.Serialize<WechatWorkCustomerAcquisitionRange>(fieldValue));
        return this;
    }

    public WechatWorkCustomerAcquisitionApiCreateLinkRequest SkipVerify(bool fieldValue) {
        this.request.BodyBool("skip_verify", fieldValue);
        return this;
    }

    public WechatWorkCustomerAcquisitionApiCreateLinkRequest PriorityOption(WechatWorkCustomerAcquisitionPriority fieldValue) {
        this.request.BodyJson("priority_option", Json.Serialize<WechatWorkCustomerAcquisitionPriority>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
