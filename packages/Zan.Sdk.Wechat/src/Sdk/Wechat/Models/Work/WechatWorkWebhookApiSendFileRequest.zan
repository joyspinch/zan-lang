using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkWebhookApiSendFileRequest {
    WechatTypedRequest request;

    public WechatWorkWebhookApiSendFileRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkWebhookApiSendFileRequest MediaId(string fieldValue) {
        this.request.QueryString("file", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
