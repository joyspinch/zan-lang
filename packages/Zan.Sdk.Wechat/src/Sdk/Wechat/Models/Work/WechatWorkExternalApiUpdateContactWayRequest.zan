using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkExternalApiUpdateContactWayRequest {
    WechatTypedRequest request;

    public WechatWorkExternalApiUpdateContactWayRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkExternalApiUpdateContactWayRequest ConfigId(string fieldValue) {
        this.request.BodyString("config_id", fieldValue);
        return this;
    }

    WechatWorkExternalApiUpdateContactWayRequest Remark(string fieldValue) {
        this.request.BodyString("remark", fieldValue);
        return this;
    }

    WechatWorkExternalApiUpdateContactWayRequest SkipVerify(bool fieldValue) {
        this.request.BodyBool("skip_verify", fieldValue);
        return this;
    }

    WechatWorkExternalApiUpdateContactWayRequest Style(int fieldValue) {
        this.request.BodyInt("style", fieldValue);
        return this;
    }

    WechatWorkExternalApiUpdateContactWayRequest State(string fieldValue) {
        this.request.BodyString("state", fieldValue);
        return this;
    }

    WechatWorkExternalApiUpdateContactWayRequest User(List<string> fieldValue) {
        this.request.BodyStrings("user", fieldValue);
        return this;
    }

    WechatWorkExternalApiUpdateContactWayRequest Party(List<int> fieldValue) {
        this.request.BodyInts("party", fieldValue);
        return this;
    }

    WechatWorkExternalApiUpdateContactWayRequest ExpiresIn(int fieldValue) {
        this.request.BodyInt("expires_in", fieldValue);
        return this;
    }

    WechatWorkExternalApiUpdateContactWayRequest ChatExpiresIn(int fieldValue) {
        this.request.BodyInt("chat_expires_in", fieldValue);
        return this;
    }

    WechatWorkExternalApiUpdateContactWayRequest Unionid(string fieldValue) {
        this.request.BodyString("unionid", fieldValue);
        return this;
    }

    WechatWorkExternalApiUpdateContactWayRequest Conclusions(WechatWorkConclusions fieldValue) {
        this.request.BodyJson("conclusions", Json.Serialize<WechatWorkConclusions>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
