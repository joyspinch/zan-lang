using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkChatApiSendChatSimpleMessageRequest {
    WechatTypedRequest request;

    public WechatWorkChatApiSendChatSimpleMessageRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkChatApiSendChatSimpleMessageRequest ChatId(string fieldValue) {
        this.request.BodyString("chatId", fieldValue);
        return this;
    }

    public WechatWorkChatApiSendChatSimpleMessageRequest MsgType(JsonValue fieldValue) {
        this.request.BodyValue("msgType", fieldValue);
        return this;
    }

    public WechatWorkChatApiSendChatSimpleMessageRequest ContentOrMediaId(string fieldValue) {
        this.request.BodyString("contentOrMediaId", fieldValue);
        return this;
    }

    public WechatWorkChatApiSendChatSimpleMessageRequest Safe(int fieldValue) {
        this.request.BodyInt("safe", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
