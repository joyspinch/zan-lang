using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkInvoiceApiUpdateInvoiceStatusRequest {
    WechatTypedRequest request;

    public WechatWorkInvoiceApiUpdateInvoiceStatusRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkInvoiceApiUpdateInvoiceStatusRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    public WechatWorkInvoiceApiUpdateInvoiceStatusRequest EncryptCode(string fieldValue) {
        this.request.BodyString("encrypt_code", fieldValue);
        return this;
    }

    public WechatWorkInvoiceApiUpdateInvoiceStatusRequest ReimburseStatus(string fieldValue) {
        this.request.BodyString("reimburse_status", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
