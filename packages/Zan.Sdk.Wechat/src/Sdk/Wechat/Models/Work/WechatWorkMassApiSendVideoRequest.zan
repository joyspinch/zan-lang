using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkMassApiSendVideoRequest {
    WechatTypedRequest request;

    public WechatWorkMassApiSendVideoRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkMassApiSendVideoRequest ToUser(string fieldValue) {
        this.request.BodyString("touser", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendVideoRequest ToParty(string fieldValue) {
        this.request.BodyString("toparty", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendVideoRequest ToTag(string fieldValue) {
        this.request.BodyString("totag", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendVideoRequest AgentId(string fieldValue) {
        this.request.BodyString("agentid", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendVideoRequest MediaId(string fieldValue) {
        this.request.BodyString("video", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendVideoRequest Safe(int fieldValue) {
        this.request.BodyInt("safe", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendVideoRequest EnableDuplicateCheck(int fieldValue) {
        this.request.BodyInt("enable_duplicate_check", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendVideoRequest DuplicateCheckInterval(int fieldValue) {
        this.request.BodyInt("duplicate_check_interval", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
