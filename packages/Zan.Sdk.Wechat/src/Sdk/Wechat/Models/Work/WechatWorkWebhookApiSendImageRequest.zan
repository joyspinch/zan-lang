using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkWebhookApiSendImageRequest {
    WechatTypedRequest request;

    public WechatWorkWebhookApiSendImageRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkWebhookApiSendImageRequest Base64(string fieldValue) {
        this.request.QueryString("base64", fieldValue);
        return this;
    }

    public WechatWorkWebhookApiSendImageRequest Md5(string fieldValue) {
        this.request.BodyString("md5", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
