using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkMassApiSendTemplateCardRequest {
    WechatTypedRequest request;

    public WechatWorkMassApiSendTemplateCardRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkMassApiSendTemplateCardRequest Touser(string fieldValue) {
        this.request.BodyString("touser", fieldValue);
        return this;
    }

    WechatWorkMassApiSendTemplateCardRequest Toparty(string fieldValue) {
        this.request.BodyString("toparty", fieldValue);
        return this;
    }

    WechatWorkMassApiSendTemplateCardRequest Totag(string fieldValue) {
        this.request.BodyString("totag", fieldValue);
        return this;
    }

    WechatWorkMassApiSendTemplateCardRequest Msgtype(string fieldValue) {
        this.request.BodyString("msgtype", fieldValue);
        return this;
    }

    WechatWorkMassApiSendTemplateCardRequest Agentid(int fieldValue) {
        this.request.BodyInt("agentid", fieldValue);
        return this;
    }

    WechatWorkMassApiSendTemplateCardRequest TemplateCard(WechatWorkTemplateCardBase fieldValue) {
        this.request.BodyJson("template_card", Json.Serialize<WechatWorkTemplateCardBase>(fieldValue));
        return this;
    }

    WechatWorkMassApiSendTemplateCardRequest EnableIdTrans(int fieldValue) {
        this.request.BodyInt("enable_id_trans", fieldValue);
        return this;
    }

    WechatWorkMassApiSendTemplateCardRequest EnableDuplicateCheck(int fieldValue) {
        this.request.BodyInt("enable_duplicate_check", fieldValue);
        return this;
    }

    WechatWorkMassApiSendTemplateCardRequest DuplicateCheckInterval(int fieldValue) {
        this.request.BodyInt("duplicate_check_interval", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
