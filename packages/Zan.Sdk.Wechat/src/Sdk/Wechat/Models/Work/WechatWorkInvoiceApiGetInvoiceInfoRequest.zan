using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkInvoiceApiGetInvoiceInfoRequest {
    WechatTypedRequest request;

    public WechatWorkInvoiceApiGetInvoiceInfoRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkInvoiceApiGetInvoiceInfoRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    public WechatWorkInvoiceApiGetInvoiceInfoRequest EncryptCode(string fieldValue) {
        this.request.BodyString("encrypt_code", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
