using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkMassApiSendMarkdownRequest {
    WechatTypedRequest request;

    public WechatWorkMassApiSendMarkdownRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkMassApiSendMarkdownRequest ToUser(string fieldValue) {
        this.request.BodyString("touser", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendMarkdownRequest ToParty(string fieldValue) {
        this.request.BodyString("toparty", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendMarkdownRequest ToTag(string fieldValue) {
        this.request.BodyString("totag", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendMarkdownRequest AgentId(string fieldValue) {
        this.request.BodyString("agentid", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendMarkdownRequest Content(string fieldValue) {
        this.request.BodyString("markdown", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendMarkdownRequest EnableDuplicateCheck(int fieldValue) {
        this.request.BodyInt("enable_duplicate_check", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendMarkdownRequest DuplicateCheckInterval(int fieldValue) {
        this.request.BodyInt("duplicate_check_interval", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
