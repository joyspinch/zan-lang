using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkAsynchronousApiBatchReplaceUserRequest {
    WechatTypedRequest request;

    public WechatWorkAsynchronousApiBatchReplaceUserRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkAsynchronousApiBatchReplaceUserRequest Url(string fieldValue) {
        this.request.BodyString("url", fieldValue);
        return this;
    }

    public WechatWorkAsynchronousApiBatchReplaceUserRequest Token(string fieldValue) {
        this.request.BodyString("token", fieldValue);
        return this;
    }

    public WechatWorkAsynchronousApiBatchReplaceUserRequest Encodingaeskey(string fieldValue) {
        this.request.BodyString("encodingaeskey", fieldValue);
        return this;
    }

    public WechatWorkAsynchronousApiBatchReplaceUserRequest MediaId(string fieldValue) {
        this.request.BodyString("mediaId", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
