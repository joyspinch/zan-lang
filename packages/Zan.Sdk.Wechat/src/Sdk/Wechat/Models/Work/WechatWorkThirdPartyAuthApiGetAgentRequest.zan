using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkThirdPartyAuthApiGetAgentRequest {
    WechatTypedRequest request;

    public WechatWorkThirdPartyAuthApiGetAgentRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkThirdPartyAuthApiGetAgentRequest SuiteId(string fieldValue) {
        this.request.BodyString("suite_id", fieldValue);
        return this;
    }

    WechatWorkThirdPartyAuthApiGetAgentRequest AuthCorpId(string fieldValue) {
        this.request.BodyString("auth_corpid", fieldValue);
        return this;
    }

    WechatWorkThirdPartyAuthApiGetAgentRequest PermanentCode(string fieldValue) {
        this.request.BodyString("permanent_code", fieldValue);
        return this;
    }

    WechatWorkThirdPartyAuthApiGetAgentRequest AgentId(string fieldValue) {
        this.request.BodyString("agentid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
