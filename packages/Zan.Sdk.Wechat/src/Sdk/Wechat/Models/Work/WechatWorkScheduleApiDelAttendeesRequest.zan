using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkScheduleApiDelAttendeesRequest {
    WechatTypedRequest request;

    public WechatWorkScheduleApiDelAttendeesRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkScheduleApiDelAttendeesRequest ScheduleId(string fieldValue) {
        this.request.BodyString("schedule_id", fieldValue);
        return this;
    }

    WechatWorkScheduleApiDelAttendeesRequest Attendees(List<WechatWorkAttendee> fieldValue) {
        this.request.BodyJson("attendees", Json.Serialize<List<WechatWorkAttendee>>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
