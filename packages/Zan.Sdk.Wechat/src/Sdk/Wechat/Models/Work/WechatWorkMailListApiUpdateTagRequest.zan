using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkMailListApiUpdateTagRequest {
    WechatTypedRequest request;

    public WechatWorkMailListApiUpdateTagRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkMailListApiUpdateTagRequest TagId(int fieldValue) {
        this.request.BodyInt("tagid", fieldValue);
        return this;
    }

    WechatWorkMailListApiUpdateTagRequest TagName(string fieldValue) {
        this.request.BodyString("tagname", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
