using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkOaApiApprovalCopyTemplateRequest {
    WechatTypedRequest request;

    public WechatWorkOaApiApprovalCopyTemplateRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkOaApiApprovalCopyTemplateRequest OpenTemplateId(string fieldValue) {
        this.request.BodyString("open_template_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
