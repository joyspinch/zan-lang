using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkAppApiGetAppInfoRequest {
    WechatTypedRequest request;

    public WechatWorkAppApiGetAppInfoRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkAppApiGetAppInfoRequest AgentId(int fieldValue) {
        this.request.QueryInt("agentid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
