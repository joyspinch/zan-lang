using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkCorpgroupApiRuleAddRuleRequest {
    WechatTypedRequest request;

    public WechatWorkCorpgroupApiRuleAddRuleRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkCorpgroupApiRuleAddRuleRequest ChainId(string fieldValue) {
        this.request.BodyString("chain_id", fieldValue);
        return this;
    }

    public WechatWorkCorpgroupApiRuleAddRuleRequest RuleInfo(WechatWorkAddRuleRequestRuleInfo fieldValue) {
        this.request.BodyJson("rule_info", Json.Serialize<WechatWorkAddRuleRequestRuleInfo>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
