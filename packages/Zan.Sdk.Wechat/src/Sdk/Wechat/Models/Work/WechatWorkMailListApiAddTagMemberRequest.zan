using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkMailListApiAddTagMemberRequest {
    WechatTypedRequest request;

    public WechatWorkMailListApiAddTagMemberRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkMailListApiAddTagMemberRequest TagId(int fieldValue) {
        this.request.BodyInt("tagid", fieldValue);
        return this;
    }

    public WechatWorkMailListApiAddTagMemberRequest UserList(List<string> fieldValue) {
        this.request.BodyStrings("userlist", fieldValue);
        return this;
    }

    public WechatWorkMailListApiAddTagMemberRequest PartyList(List<long> fieldValue) {
        this.request.BodyLongs("partylist", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
