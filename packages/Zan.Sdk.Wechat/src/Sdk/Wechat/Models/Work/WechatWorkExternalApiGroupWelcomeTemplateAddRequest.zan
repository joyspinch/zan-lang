using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkExternalApiGroupWelcomeTemplateAddRequest {
    WechatTypedRequest request;

    public WechatWorkExternalApiGroupWelcomeTemplateAddRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkExternalApiGroupWelcomeTemplateAddRequest Notify(int fieldValue) {
        this.request.BodyInt("notify", fieldValue);
        return this;
    }

    WechatWorkExternalApiGroupWelcomeTemplateAddRequest Text(WechatWorkExternalGetExternalContactResultText fieldValue) {
        this.request.BodyJson("text", Json.Serialize<WechatWorkExternalGetExternalContactResultText>(fieldValue));
        return this;
    }

    WechatWorkExternalApiGroupWelcomeTemplateAddRequest Image(WechatWorkGroupWelcomeTemplateImage fieldValue) {
        this.request.BodyJson("image", Json.Serialize<WechatWorkGroupWelcomeTemplateImage>(fieldValue));
        return this;
    }

    WechatWorkExternalApiGroupWelcomeTemplateAddRequest Link(WechatWorkExternalExternalJsonAddMessageTemplateRequestLink fieldValue) {
        this.request.BodyJson("link", Json.Serialize<WechatWorkExternalExternalJsonAddMessageTemplateRequestLink>(fieldValue));
        return this;
    }

    WechatWorkExternalApiGroupWelcomeTemplateAddRequest Miniprogram(WechatWorkExternalGetExternalContactResultMiniprogram fieldValue) {
        this.request.BodyJson("miniprogram", Json.Serialize<WechatWorkExternalGetExternalContactResultMiniprogram>(fieldValue));
        return this;
    }

    WechatWorkExternalApiGroupWelcomeTemplateAddRequest Agentid(string fieldValue) {
        this.request.BodyString("agentid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
