using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkThirdPartyAuthApiGetPermanentCodeRequest {
    WechatTypedRequest request;

    public WechatWorkThirdPartyAuthApiGetPermanentCodeRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkThirdPartyAuthApiGetPermanentCodeRequest SuiteId(string fieldValue) {
        this.request.BodyString("suite_id", fieldValue);
        return this;
    }

    public WechatWorkThirdPartyAuthApiGetPermanentCodeRequest AuthCode(string fieldValue) {
        this.request.BodyString("auth_code", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
