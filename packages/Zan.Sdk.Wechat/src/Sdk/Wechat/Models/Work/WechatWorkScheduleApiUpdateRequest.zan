using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkScheduleApiUpdateRequest {
    WechatTypedRequest request;

    public WechatWorkScheduleApiUpdateRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkScheduleApiUpdateRequest ScheduleId(string fieldValue) {
        this.request.BodyString("schedule_id", fieldValue);
        return this;
    }

    public WechatWorkScheduleApiUpdateRequest Admins(List<string> fieldValue) {
        this.request.BodyStrings("admins", fieldValue);
        return this;
    }

    public WechatWorkScheduleApiUpdateRequest Organizer(string fieldValue) {
        this.request.BodyString("organizer", fieldValue);
        return this;
    }

    public WechatWorkScheduleApiUpdateRequest StartTime(int fieldValue) {
        this.request.BodyInt("start_time", fieldValue);
        return this;
    }

    public WechatWorkScheduleApiUpdateRequest EndTime(int fieldValue) {
        this.request.BodyInt("end_time", fieldValue);
        return this;
    }

    public WechatWorkScheduleApiUpdateRequest IsWholeDay(int fieldValue) {
        this.request.BodyInt("is_whole_day", fieldValue);
        return this;
    }

    public WechatWorkScheduleApiUpdateRequest Attendees(List<WechatWorkAttendee> fieldValue) {
        this.request.BodyJson("attendees", Json.Serialize<List<WechatWorkAttendee>>(fieldValue));
        return this;
    }

    public WechatWorkScheduleApiUpdateRequest Summary(string fieldValue) {
        this.request.BodyString("summary", fieldValue);
        return this;
    }

    public WechatWorkScheduleApiUpdateRequest Description(string fieldValue) {
        this.request.BodyString("description", fieldValue);
        return this;
    }

    public WechatWorkScheduleApiUpdateRequest Reminders(WechatWorkReminders fieldValue) {
        this.request.BodyJson("reminders", Json.Serialize<WechatWorkReminders>(fieldValue));
        return this;
    }

    public WechatWorkScheduleApiUpdateRequest Location(string fieldValue) {
        this.request.BodyString("location", fieldValue);
        return this;
    }

    public WechatWorkScheduleApiUpdateRequest CalId(string fieldValue) {
        this.request.BodyString("cal_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
