using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkMassApiSendTaskCardRequest {
    WechatTypedRequest request;

    public WechatWorkMassApiSendTaskCardRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkMassApiSendTaskCardRequest Touser(string fieldValue) {
        this.request.BodyString("touser", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendTaskCardRequest Toparty(string fieldValue) {
        this.request.BodyString("toparty", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendTaskCardRequest Totag(string fieldValue) {
        this.request.BodyString("totag", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendTaskCardRequest Agentid(int fieldValue) {
        this.request.BodyInt("agentid", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendTaskCardRequest InteractiveTaskcard(WechatWorkTaskcardNotice fieldValue) {
        this.request.BodyJson("interactive_taskcard", Json.Serialize<WechatWorkTaskcardNotice>(fieldValue));
        return this;
    }

    public WechatWorkMassApiSendTaskCardRequest Taskcard(WechatWorkTaskcardNotice fieldValue) {
        this.request.BodyJson("taskcard", Json.Serialize<WechatWorkTaskcardNotice>(fieldValue));
        return this;
    }

    public WechatWorkMassApiSendTaskCardRequest EnableIdTrans(int fieldValue) {
        this.request.BodyInt("enable_id_trans", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendTaskCardRequest EnableDuplicateCheck(int fieldValue) {
        this.request.BodyInt("enable_duplicate_check", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendTaskCardRequest DuplicateCheckInterval(int fieldValue) {
        this.request.BodyInt("duplicate_check_interval", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
