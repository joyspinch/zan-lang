using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkThirdPartyAuthApiGetAdminListRequest {
    WechatTypedRequest request;

    public WechatWorkThirdPartyAuthApiGetAdminListRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkThirdPartyAuthApiGetAdminListRequest AuthCorpId(string fieldValue) {
        this.request.BodyString("auth_corpid", fieldValue);
        return this;
    }

    public WechatWorkThirdPartyAuthApiGetAdminListRequest AgentId(string fieldValue) {
        this.request.BodyString("agentid", fieldValue);
