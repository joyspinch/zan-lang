    public WechatWorkScheduleApiGetByCalendarRequest CalId(string fieldValue) {
        this.request.BodyString("cal_id", fieldValue);
        return this;
    }

    public WechatWorkScheduleApiGetByCalendarRequest Offset(int fieldValue) {
        this.request.BodyInt("offset", fieldValue);
        return this;
    }

    public WechatWorkScheduleApiGetByCalendarRequest Limit(int fieldValue) {
        this.request.BodyInt("limit", fieldValue);
        return this;
    }

