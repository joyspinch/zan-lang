using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkScheduleApiAddRequest {
    WechatTypedRequest request;

    public WechatWorkScheduleApiAddRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkScheduleApiAddRequest Schedule(WechatWorkSchedule fieldValue) {
        this.request.BodyJson("schedule", Json.Serialize<WechatWorkSchedule>(fieldValue));
        return this;
    }

    public WechatWorkScheduleApiAddRequest Agentid(int fieldValue) {
        this.request.BodyInt("agentid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
