using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkMassApiSendMiniNoticeCardRequest {
    WechatTypedRequest request;

    public WechatWorkMassApiSendMiniNoticeCardRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkMassApiSendMiniNoticeCardRequest Touser(string fieldValue) {
        this.request.BodyString("touser", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendMiniNoticeCardRequest Toparty(string fieldValue) {
        this.request.BodyString("toparty", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendMiniNoticeCardRequest Totag(string fieldValue) {
        this.request.BodyString("totag", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendMiniNoticeCardRequest Msgtype(string fieldValue) {
        this.request.BodyString("msgtype", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendMiniNoticeCardRequest MiniprogramNotice(WechatWorkMiniprogramNotice fieldValue) {
        this.request.BodyJson("miniprogram_notice", Json.Serialize<WechatWorkMiniprogramNotice>(fieldValue));
        return this;
    }

    public WechatWorkMassApiSendMiniNoticeCardRequest EnableDuplicateCheck(int fieldValue) {
        this.request.BodyInt("enableDuplicateCheck", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendMiniNoticeCardRequest DuplicateCheckInterval(int fieldValue) {
        this.request.BodyInt("duplicateCheckInterval", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
