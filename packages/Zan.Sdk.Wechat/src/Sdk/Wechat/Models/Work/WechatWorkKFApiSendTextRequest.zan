using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkKFApiSendTextRequest {
    WechatTypedRequest request;

    public WechatWorkKFApiSendTextRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkKFApiSendTextRequest SenderType(JsonValue fieldValue) {
        this.request.BodyValue("sender", fieldValue);
        return this;
    }

    public WechatWorkKFApiSendTextRequest ReceiverType(JsonValue fieldValue) {
        this.request.BodyValue("receiver", fieldValue);
        return this;
    }

    public WechatWorkKFApiSendTextRequest Content(string fieldValue) {
        this.request.BodyString("text", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
