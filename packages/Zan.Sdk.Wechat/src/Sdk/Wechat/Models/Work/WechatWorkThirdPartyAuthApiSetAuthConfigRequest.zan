using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkThirdPartyAuthApiSetAuthConfigRequest {
    WechatTypedRequest request;

    public WechatWorkThirdPartyAuthApiSetAuthConfigRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkThirdPartyAuthApiSetAuthConfigRequest AuthCode(string fieldValue) {
        this.request.BodyString("pre_auth_code", fieldValue);
        return this;
    }

    public WechatWorkThirdPartyAuthApiSetAuthConfigRequest Appid(List<int> fieldValue) {
        this.request.BodyInts("session_info", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
