public class WechatWorkMemberDepartmentAssignment {
    public long departmentId;
    public int order;
    public int isLeader;
    public string directLeader;

    public WechatWorkMemberDepartmentAssignment() {
        this.departmentId = 0;
        this.order = 0;
        this.isLeader = 0;
        this.directLeader = "";
    }

    public WechatWorkMemberDepartmentAssignment(long deptId, int ord, int leader, string dirLeader) {
        this.departmentId = deptId;
        this.order = ord;
        this.isLeader = leader;
        this.directLeader = dirLeader != null ? dirLeader : "";
    }
}

