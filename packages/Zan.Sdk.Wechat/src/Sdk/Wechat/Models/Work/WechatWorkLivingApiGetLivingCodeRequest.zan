using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkLivingApiGetLivingCodeRequest {
    WechatTypedRequest request;

    public WechatWorkLivingApiGetLivingCodeRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkLivingApiGetLivingCodeRequest Openid(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    WechatWorkLivingApiGetLivingCodeRequest Livingid(string fieldValue) {
        this.request.BodyString("livingid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
