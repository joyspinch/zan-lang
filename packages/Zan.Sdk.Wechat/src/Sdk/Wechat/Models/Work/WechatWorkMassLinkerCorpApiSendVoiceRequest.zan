using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkMassLinkerCorpApiSendVoiceRequest {
    WechatTypedRequest request;

    public WechatWorkMassLinkerCorpApiSendVoiceRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkMassLinkerCorpApiSendVoiceRequest Touser(List<string> fieldValue) {
        this.request.BodyStrings("touser", fieldValue);
        return this;
    }

    public WechatWorkMassLinkerCorpApiSendVoiceRequest Toparty(List<string> fieldValue) {
        this.request.BodyStrings("toparty", fieldValue);
        return this;
    }

    public WechatWorkMassLinkerCorpApiSendVoiceRequest Totag(List<string> fieldValue) {
        this.request.BodyStrings("totag", fieldValue);
        return this;
    }

    public WechatWorkMassLinkerCorpApiSendVoiceRequest Toall(int fieldValue) {
        this.request.BodyInt("toall", fieldValue);
        return this;
    }

    public WechatWorkMassLinkerCorpApiSendVoiceRequest Msgtype(string fieldValue) {
        this.request.BodyString("msgtype", fieldValue);
        return this;
    }

    public WechatWorkMassLinkerCorpApiSendVoiceRequest Agentid(int fieldValue) {
        this.request.BodyInt("agentid", fieldValue);
        return this;
    }

    public WechatWorkMassLinkerCorpApiSendVoiceRequest Voice(WechatWorkVoice fieldValue) {
        this.request.BodyJson("voice", Json.Serialize<WechatWorkVoice>(fieldValue));
