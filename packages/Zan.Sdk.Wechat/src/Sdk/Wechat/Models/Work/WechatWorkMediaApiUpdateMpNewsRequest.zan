using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkMediaApiUpdateMpNewsRequest {
    WechatTypedRequest request;

    public WechatWorkMediaApiUpdateMpNewsRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkMediaApiUpdateMpNewsRequest AgentId(int fieldValue) {
        this.request.BodyInt("agentid", fieldValue);
        return this;
    }

    public WechatWorkMediaApiUpdateMpNewsRequest MediaId(string fieldValue) {
        this.request.BodyString("media_id", fieldValue);
        return this;
    }

    public WechatWorkMediaApiUpdateMpNewsRequest MpNewsArticles(JsonValue fieldValue) {
        this.request.BodyValue("mpnews", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
