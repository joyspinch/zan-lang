using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkKFApiSendFileRequest {
    WechatTypedRequest request;

    public WechatWorkKFApiSendFileRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkKFApiSendFileRequest SenderType(JsonValue fieldValue) {
        this.request.BodyValue("sender", fieldValue);
        return this;
    }

    WechatWorkKFApiSendFileRequest ReceiverType(JsonValue fieldValue) {
        this.request.BodyValue("receiver", fieldValue);
        return this;
    }

    WechatWorkKFApiSendFileRequest MediaId(string fieldValue) {
        this.request.BodyString("file", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
