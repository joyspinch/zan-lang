using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkExternalApiGroupChatGetRequest {
    WechatTypedRequest request;

    public WechatWorkExternalApiGroupChatGetRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkExternalApiGroupChatGetRequest ChatId(string fieldValue) {
        this.request.BodyString("chat_id", fieldValue);
        return this;
    }

    public WechatWorkExternalApiGroupChatGetRequest NeedName(bool fieldValue) {
        this.request.BodyBool("need_name", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
