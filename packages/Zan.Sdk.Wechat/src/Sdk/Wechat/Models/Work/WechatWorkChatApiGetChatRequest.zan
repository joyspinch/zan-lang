using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkChatApiGetChatRequest {
    WechatTypedRequest request;

    public WechatWorkChatApiGetChatRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkChatApiGetChatRequest ChatId(string fieldValue) {
        this.request.QueryString("chatid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
