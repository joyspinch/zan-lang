using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkOaApiApprovalCreateTemplateRequest {
    WechatTypedRequest request;

    public WechatWorkOaApiApprovalCreateTemplateRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkOaApiApprovalCreateTemplateRequest TemplateName(List<WechatWorkApprovalCreateTemplateRequestTextAndLang> fieldValue) {
        this.request.BodyJson("template_name", Json.Serialize<List<WechatWorkApprovalCreateTemplateRequestTextAndLang>>(fieldValue));
        return this;
    }

    public WechatWorkOaApiApprovalCreateTemplateRequest TemplateContent(WechatWorkApprovalCreateTemplateRequestTemplateContent fieldValue) {
        this.request.BodyJson("template_content", Json.Serialize<WechatWorkApprovalCreateTemplateRequestTemplateContent>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
