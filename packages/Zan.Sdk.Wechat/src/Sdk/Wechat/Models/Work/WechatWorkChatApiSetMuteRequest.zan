using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkChatApiSetMuteRequest {
    WechatTypedRequest request;

    public WechatWorkChatApiSetMuteRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkChatApiSetMuteRequest UserMuteList(List<WechatWorkUserMute> fieldValue) {
        this.request.BodyJson("user_mute_list", Json.Serialize<List<WechatWorkUserMute>>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
