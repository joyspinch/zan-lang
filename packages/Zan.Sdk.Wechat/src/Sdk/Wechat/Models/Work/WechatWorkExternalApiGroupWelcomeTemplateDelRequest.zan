using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkExternalApiGroupWelcomeTemplateDelRequest {
    WechatTypedRequest request;

    public WechatWorkExternalApiGroupWelcomeTemplateDelRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkExternalApiGroupWelcomeTemplateDelRequest TemplateId(string fieldValue) {
        this.request.BodyString("template_id", fieldValue);
        return this;
    }

    WechatWorkExternalApiGroupWelcomeTemplateDelRequest Agentid(long fieldValue) {
        this.request.BodyLong("agentid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
