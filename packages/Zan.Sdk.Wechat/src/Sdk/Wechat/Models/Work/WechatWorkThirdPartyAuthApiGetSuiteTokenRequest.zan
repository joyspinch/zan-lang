using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkThirdPartyAuthApiGetSuiteTokenRequest {
    WechatTypedRequest request;

    public WechatWorkThirdPartyAuthApiGetSuiteTokenRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkThirdPartyAuthApiGetSuiteTokenRequest SuiteId(string fieldValue) {
        this.request.BodyString("suite_id", fieldValue);
        return this;
    }

    WechatWorkThirdPartyAuthApiGetSuiteTokenRequest SuiteSecret(string fieldValue) {
        this.request.BodyString("suite_secret", fieldValue);
        return this;
    }

    WechatWorkThirdPartyAuthApiGetSuiteTokenRequest SuiteTicket(string fieldValue) {
        this.request.BodyString("suite_ticket", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
