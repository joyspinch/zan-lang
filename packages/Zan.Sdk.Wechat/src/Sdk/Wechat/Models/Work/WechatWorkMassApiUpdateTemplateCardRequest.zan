using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkMassApiUpdateTemplateCardRequest {
    WechatTypedRequest request;

    public WechatWorkMassApiUpdateTemplateCardRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkMassApiUpdateTemplateCardRequest Userids(List<string> fieldValue) {
        this.request.BodyStrings("userids", fieldValue);
        return this;
    }

    WechatWorkMassApiUpdateTemplateCardRequest Partyids(List<int> fieldValue) {
        this.request.BodyInts("partyids", fieldValue);
        return this;
    }

    WechatWorkMassApiUpdateTemplateCardRequest Tagids(List<int> fieldValue) {
        this.request.BodyInts("tagids", fieldValue);
        return this;
    }

    WechatWorkMassApiUpdateTemplateCardRequest Atall(int fieldValue) {
        this.request.BodyInt("atall", fieldValue);
        return this;
    }

    WechatWorkMassApiUpdateTemplateCardRequest Agentid(int fieldValue) {
        this.request.BodyInt("agentid", fieldValue);
        return this;
    }

    WechatWorkMassApiUpdateTemplateCardRequest ResponseCode(string fieldValue) {
        this.request.BodyString("response_code", fieldValue);
        return this;
    }

    WechatWorkMassApiUpdateTemplateCardRequest EnableIdTrans(int fieldValue) {
        this.request.BodyInt("enable_id_trans", fieldValue);
        return this;
    }

    WechatWorkMassApiUpdateTemplateCardRequest TemplateCard(WechatWorkTemplateCardBase fieldValue) {
        this.request.BodyJson("template_card", Json.Serialize<WechatWorkTemplateCardBase>(fieldValue));
        return this;
    }

    WechatWorkMassApiUpdateTemplateCardRequest Button(WechatWorkMassUpdateTemplateCardUpdateTemplateCardRequestButton fieldValue) {
        this.request.BodyJson("button", Json.Serialize<WechatWorkMassUpdateTemplateCardUpdateTemplateCardRequestButton>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
