using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkMassApiUpdateTemplateCardRequest {
    WechatTypedRequest request;

    public WechatWorkMassApiUpdateTemplateCardRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkMassApiUpdateTemplateCardRequest Userids(List<string> fieldValue) {
        this.request.BodyStrings("userids", fieldValue);
        return this;
    }

    public WechatWorkMassApiUpdateTemplateCardRequest Partyids(List<int> fieldValue) {
        this.request.BodyInts("partyids", fieldValue);
        return this;
    }

    public WechatWorkMassApiUpdateTemplateCardRequest Tagids(List<int> fieldValue) {
        this.request.BodyInts("tagids", fieldValue);
        return this;
    }

    public WechatWorkMassApiUpdateTemplateCardRequest Atall(int fieldValue) {
        this.request.BodyInt("atall", fieldValue);
        return this;
    }

    public WechatWorkMassApiUpdateTemplateCardRequest Agentid(int fieldValue) {
        this.request.BodyInt("agentid", fieldValue);
        return this;
    }

    public WechatWorkMassApiUpdateTemplateCardRequest ResponseCode(string fieldValue) {
        this.request.BodyString("response_code", fieldValue);
        return this;
    }

    public WechatWorkMassApiUpdateTemplateCardRequest EnableIdTrans(int fieldValue) {
        this.request.BodyInt("enable_id_trans", fieldValue);
        return this;
    }

    public WechatWorkMassApiUpdateTemplateCardRequest TemplateCard(WechatWorkTemplateCardBase fieldValue) {
        this.request.BodyJson("template_card", Json.Serialize<WechatWorkTemplateCardBase>(fieldValue));
        return this;
    }

    public WechatWorkMassApiUpdateTemplateCardRequest Button(WechatWorkMassUpdateTemplateCardUpdateTemplateCardRequestButton fieldValue) {
        this.request.BodyJson("button", Json.Serialize<WechatWorkMassUpdateTemplateCardUpdateTemplateCardRequestButton>(fieldValue));
