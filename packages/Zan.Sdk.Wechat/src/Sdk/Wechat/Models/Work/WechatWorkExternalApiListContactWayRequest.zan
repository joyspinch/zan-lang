using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkExternalApiListContactWayRequest {
    WechatTypedRequest request;

    public WechatWorkExternalApiListContactWayRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkExternalApiListContactWayRequest StartTime(int fieldValue) {
        this.request.BodyInt("start_time", fieldValue);
        return this;
    }

    public WechatWorkExternalApiListContactWayRequest EndTime(int fieldValue) {
        this.request.BodyInt("end_time", fieldValue);
        return this;
    }

    public WechatWorkExternalApiListContactWayRequest Cursor(string fieldValue) {
        this.request.BodyString("cursor", fieldValue);
        return this;
    }

    public WechatWorkExternalApiListContactWayRequest Limit(int fieldValue) {
        this.request.BodyInt("limit", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
