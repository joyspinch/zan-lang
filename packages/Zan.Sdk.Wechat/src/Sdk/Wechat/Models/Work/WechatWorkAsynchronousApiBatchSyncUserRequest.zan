using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkAsynchronousApiBatchSyncUserRequest {
    WechatTypedRequest request;

    public WechatWorkAsynchronousApiBatchSyncUserRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkAsynchronousApiBatchSyncUserRequest Url(string fieldValue) {
        this.request.BodyString("url", fieldValue);
        return this;
    }

    public WechatWorkAsynchronousApiBatchSyncUserRequest Token(string fieldValue) {
        this.request.BodyString("token", fieldValue);
        return this;
    }

    public WechatWorkAsynchronousApiBatchSyncUserRequest Encodingaeskey(string fieldValue) {
        this.request.BodyString("encodingaeskey", fieldValue);
        return this;
    }

    public WechatWorkAsynchronousApiBatchSyncUserRequest MediaId(string fieldValue) {
        this.request.BodyString("mediaId", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
