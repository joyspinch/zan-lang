using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkKFApiSendVoiceRequest {
    WechatTypedRequest request;

    public WechatWorkKFApiSendVoiceRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkKFApiSendVoiceRequest SenderType(JsonValue fieldValue) {
        this.request.BodyValue("sender", fieldValue);
        return this;
    }

    public WechatWorkKFApiSendVoiceRequest ReceiverType(JsonValue fieldValue) {
        this.request.BodyValue("receiver", fieldValue);
        return this;
    }

    public WechatWorkKFApiSendVoiceRequest MediaId(string fieldValue) {
        this.request.BodyString("voice", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
