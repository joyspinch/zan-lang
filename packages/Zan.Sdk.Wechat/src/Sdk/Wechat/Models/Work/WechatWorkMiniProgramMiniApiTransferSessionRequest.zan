using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkMiniProgramMiniApiTransferSessionRequest {
    WechatTypedRequest request;

    public WechatWorkMiniProgramMiniApiTransferSessionRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkMiniProgramMiniApiTransferSessionRequest Userid(string fieldValue) {
        this.request.BodyString("userid", fieldValue);
        return this;
    }

    WechatWorkMiniProgramMiniApiTransferSessionRequest SessionKey(string fieldValue) {
        this.request.BodyString("session_key", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
