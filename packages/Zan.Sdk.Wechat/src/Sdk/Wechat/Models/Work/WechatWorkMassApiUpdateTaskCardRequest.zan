using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkMassApiUpdateTaskCardRequest {
    WechatTypedRequest request;

    public WechatWorkMassApiUpdateTaskCardRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkMassApiUpdateTaskCardRequest Userids(List<string> fieldValue) {
        this.request.BodyStrings("userids", fieldValue);
        return this;
    }

    public WechatWorkMassApiUpdateTaskCardRequest Agentid(int fieldValue) {
        this.request.BodyInt("agentid", fieldValue);
        return this;
    }

    public WechatWorkMassApiUpdateTaskCardRequest TaskId(string fieldValue) {
        this.request.BodyString("task_id", fieldValue);
        return this;
    }

    public WechatWorkMassApiUpdateTaskCardRequest ClickedKey(string fieldValue) {
        this.request.BodyString("clicked_key", fieldValue);
        return this;
    }

    public WechatWorkMassApiUpdateTaskCardRequest ReplaceName(string fieldValue) {
        this.request.BodyString("replace_name", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
