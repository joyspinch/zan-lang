using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkScheduleApiUpdateRepeatRequest {
    WechatTypedRequest request;

    public WechatWorkScheduleApiUpdateRepeatRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkScheduleApiUpdateRepeatRequest SkipAttendees(int fieldValue) {
        this.request.BodyInt("skip_attendees", fieldValue);
        return this;
    }

    public WechatWorkScheduleApiUpdateRepeatRequest OpMode(int fieldValue) {
        this.request.BodyInt("op_mode", fieldValue);
        return this;
    }

    public WechatWorkScheduleApiUpdateRepeatRequest OpStartTime(long fieldValue) {
        this.request.BodyLong("op_start_time", fieldValue);
        return this;
    }

    public WechatWorkScheduleApiUpdateRepeatRequest Schedule(WechatWorkScheduleUpdate fieldValue) {
        this.request.BodyJson("schedule", Json.Serialize<WechatWorkScheduleUpdate>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
