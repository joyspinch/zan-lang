using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkCorpgroupApiTransferSessionRequest {
    WechatTypedRequest request;

    public WechatWorkCorpgroupApiTransferSessionRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkCorpgroupApiTransferSessionRequest Userid(string fieldValue) {
        this.request.BodyString("userid", fieldValue);
        return this;
    }

    public WechatWorkCorpgroupApiTransferSessionRequest SessionKey(string fieldValue) {
        this.request.BodyString("session_key", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
