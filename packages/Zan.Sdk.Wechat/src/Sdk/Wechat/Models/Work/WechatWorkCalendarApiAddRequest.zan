using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkCalendarApiAddRequest {
    WechatTypedRequest request;

    public WechatWorkCalendarApiAddRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkCalendarApiAddRequest Calendar(WechatWorkCalendar fieldValue) {
        this.request.BodyJson("calendar", Json.Serialize<WechatWorkCalendar>(fieldValue));
        return this;
    }

    WechatWorkCalendarApiAddRequest Agentid(int fieldValue) {
        this.request.BodyInt("agentid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
