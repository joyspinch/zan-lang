using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkCalendarApiGetRequest {
    WechatTypedRequest request;

    public WechatWorkCalendarApiGetRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkCalendarApiGetRequest CalIdList(List<string> fieldValue) {
        this.request.BodyStrings("cal_id_list", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
