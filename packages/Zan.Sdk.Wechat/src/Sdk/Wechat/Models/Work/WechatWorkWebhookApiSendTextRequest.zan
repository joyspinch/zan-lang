using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkWebhookApiSendTextRequest {
    WechatTypedRequest request;

    public WechatWorkWebhookApiSendTextRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkWebhookApiSendTextRequest Content(string fieldValue) {
        this.request.QueryString("content", fieldValue);
        return this;
    }

    WechatWorkWebhookApiSendTextRequest MentionedList(List<string> fieldValue) {
        this.request.BodyStrings("mentioned_list", fieldValue);
        return this;
    }

    WechatWorkWebhookApiSendTextRequest MentionedMobileList(List<string> fieldValue) {
        this.request.BodyStrings("mentioned_mobile_list", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
