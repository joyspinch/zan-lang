using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkExternalApiGetGroupMsgTaskRequest {
    WechatTypedRequest request;

    public WechatWorkExternalApiGetGroupMsgTaskRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkExternalApiGetGroupMsgTaskRequest Msgid(string fieldValue) {
        this.request.BodyString("msgid", fieldValue);
        return this;
    }

    public WechatWorkExternalApiGetGroupMsgTaskRequest Limit(int fieldValue) {
        this.request.BodyInt("limit", fieldValue);
        return this;
    }

    public WechatWorkExternalApiGetGroupMsgTaskRequest Cursor(string fieldValue) {
        this.request.BodyString("cursor", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
