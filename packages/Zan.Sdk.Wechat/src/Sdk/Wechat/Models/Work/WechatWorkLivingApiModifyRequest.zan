using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkLivingApiModifyRequest {
    WechatTypedRequest request;

    public WechatWorkLivingApiModifyRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkLivingApiModifyRequest Livingid(string fieldValue) {
        this.request.BodyString("livingid", fieldValue);
        return this;
    }

    public WechatWorkLivingApiModifyRequest Theme(string fieldValue) {
        this.request.BodyString("theme", fieldValue);
        return this;
    }

    public WechatWorkLivingApiModifyRequest LivingStart(long fieldValue) {
        this.request.BodyLong("living_start", fieldValue);
        return this;
    }

    public WechatWorkLivingApiModifyRequest LivingDuration(int fieldValue) {
        this.request.BodyInt("living_duration", fieldValue);
        return this;
    }

    public WechatWorkLivingApiModifyRequest Description(string fieldValue) {
        this.request.BodyString("description", fieldValue);
        return this;
    }

    public WechatWorkLivingApiModifyRequest Type(int fieldValue) {
        this.request.BodyInt("type", fieldValue);
        return this;
    }

    public WechatWorkLivingApiModifyRequest RemindTime(int fieldValue) {
        this.request.BodyInt("remind_time", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
