using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkOAuth2ApiGetUserIdRequest {
    WechatTypedRequest request;

    public WechatWorkOAuth2ApiGetUserIdRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkOAuth2ApiGetUserIdRequest Code(string fieldValue) {
        this.request.QueryString("code", fieldValue);
        return this;
    }

    public WechatWorkOAuth2ApiGetUserIdRequest AgentId(string fieldValue) {
        this.request.QueryString("agentId", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
