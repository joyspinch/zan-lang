using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkThirdPartyAuthApiGetPreAuthCodeRequest {
    WechatTypedRequest request;

    public WechatWorkThirdPartyAuthApiGetPreAuthCodeRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkThirdPartyAuthApiGetPreAuthCodeRequest SuiteId(string fieldValue) {
        this.request.BodyString("suite_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
