using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkChatApiClearNotifyRequest {
    WechatTypedRequest request;

    public WechatWorkChatApiClearNotifyRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkChatApiClearNotifyRequest OpUser(string fieldValue) {
        this.request.BodyString("op_user", fieldValue);
        return this;
    }

    public WechatWorkChatApiClearNotifyRequest Type(JsonValue fieldValue) {
        this.request.BodyValue("chat", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
