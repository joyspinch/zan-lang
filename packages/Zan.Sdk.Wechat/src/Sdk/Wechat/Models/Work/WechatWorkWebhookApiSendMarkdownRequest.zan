using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkWebhookApiSendMarkdownRequest {
    WechatTypedRequest request;

    public WechatWorkWebhookApiSendMarkdownRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkWebhookApiSendMarkdownRequest Content(string fieldValue) {
        this.request.QueryString("markdown", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
