public class WechatWorkGetMemberResult {
    public string userid;
    public string name;
    // 结构化部门任职实体列表（主表示）。
    public List<WechatWorkMemberDepartmentAssignment> assignments;
    // 兼容企业微信 HTTP JSON 接口的平行列表字段。
    public List<long> department;
    public List<int> order;
    public string position;
    public string mobile;
    public int gender;
    public string email;
    public string biz_mail;
    public List<int> is_leader_in_dept;
    public List<string> direct_leader;
    public string avatar;
    public string alias;
    public int status;
    public string telephone;
    public string english_name;
    public string open_userid;
    public int main_department;
    public WechatWorkExtattr extattr;
    public int enable;
    public string wxplugin_status;
    public string qr_code;
    public WechatWorkMailListMemberMemberBaseExternalProfile external_profile;
    public string external_position;
    public string address;

    // 获取强类型部门任职条目，若 assignments 为空则从兼容列表懒解析同步。
    public List<WechatWorkMemberDepartmentAssignment> GetAssignments() {
        if (this.assignments != null) { return this.assignments; }
        List<WechatWorkMemberDepartmentAssignment> list = new List<WechatWorkMemberDepartmentAssignment>();
        if (this.department != null) {
            for (int i = 0; i < this.department.Count; i = i + 1) {
                long deptId = this.department[i];
                int ord = (this.order != null && i < this.order.Count) ? this.order[i] : 0;
                int leader = (this.is_leader_in_dept != null && i < this.is_leader_in_dept.Count) ? this.is_leader_in_dept[i] : 0;
                string dirLeader = (this.direct_leader != null && i < this.direct_leader.Count && this.direct_leader[i] != null) ? this.direct_leader[i] : "";
                list.Add(new WechatWorkMemberDepartmentAssignment(deptId, ord, leader, dirLeader));
            }
        }
        this.assignments = list;
        return this.assignments;
    }

    // 设置强类型部门任职条目，并自动同步到兼容列表。
    public void SetAssignments(List<WechatWorkMemberDepartmentAssignment> list) {
        this.assignments = list;
        this.department = new List<long>();
        this.order = new List<int>();
        this.is_leader_in_dept = new List<int>();
        this.direct_leader = new List<string>();
        if (list == null) { return; }
        for (int i = 0; i < list.Count; i = i + 1) {
            WechatWorkMemberDepartmentAssignment a = list[i];
            if (a == null) { continue; }
            this.department.Add(a.departmentId);
            this.order.Add(a.order);
            this.is_leader_in_dept.Add(a.isLeader);
            this.direct_leader.Add(a.directLeader);
        }
    }
}

