using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkOaDataOpenApiAddCheckinRecordRequest {
    WechatTypedRequest request;

    public WechatWorkOaDataOpenApiAddCheckinRecordRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkOaDataOpenApiAddCheckinRecordRequest Records(List<WechatWorkAddCheckinRecordInfo> fieldValue) {
        this.request.BodyJson("records", Json.Serialize<List<WechatWorkAddCheckinRecordInfo>>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
