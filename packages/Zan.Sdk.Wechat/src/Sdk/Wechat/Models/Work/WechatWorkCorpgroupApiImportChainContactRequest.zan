using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkCorpgroupApiImportChainContactRequest {
    WechatTypedRequest request;

    public WechatWorkCorpgroupApiImportChainContactRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkCorpgroupApiImportChainContactRequest ChainId(string fieldValue) {
        this.request.BodyString("chain_id", fieldValue);
        return this;
    }

    WechatWorkCorpgroupApiImportChainContactRequest Openid(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    WechatWorkCorpgroupApiImportChainContactRequest Corpid(string fieldValue) {
        this.request.BodyString("corpid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
