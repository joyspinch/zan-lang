using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkMassApiSendNewsRequest {
    WechatTypedRequest request;

    public WechatWorkMassApiSendNewsRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkMassApiSendNewsRequest ToUser(string fieldValue) {
        this.request.BodyString("touser", fieldValue);
        return this;
    }

    WechatWorkMassApiSendNewsRequest ToParty(string fieldValue) {
        this.request.BodyString("toparty", fieldValue);
        return this;
    }

    WechatWorkMassApiSendNewsRequest ToTag(string fieldValue) {
        this.request.BodyString("totag", fieldValue);
        return this;
    }

    WechatWorkMassApiSendNewsRequest AgentId(string fieldValue) {
        this.request.BodyString("agentid", fieldValue);
        return this;
    }

    WechatWorkMassApiSendNewsRequest Articles(List<WechatWorkArticle> fieldValue) {
        this.request.BodyJson("news", Json.Serialize<List<WechatWorkArticle>>(fieldValue));
        return this;
    }

    WechatWorkMassApiSendNewsRequest EnableDuplicateCheck(int fieldValue) {
        this.request.BodyInt("enable_duplicate_check", fieldValue);
        return this;
    }

    WechatWorkMassApiSendNewsRequest DuplicateCheckInterval(int fieldValue) {
        this.request.BodyInt("duplicate_check_interval", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
