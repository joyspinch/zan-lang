using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkExternalApiSendWelcomeMsgRequest {
    WechatTypedRequest request;

    public WechatWorkExternalApiSendWelcomeMsgRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkExternalApiSendWelcomeMsgRequest WelcomeCode(string fieldValue) {
        this.request.BodyString("welcome_code", fieldValue);
        return this;
    }

    WechatWorkExternalApiSendWelcomeMsgRequest Text(WechatWorkExternalExternalJsonSendWelcomeMsgRequestText fieldValue) {
        this.request.BodyJson("text", Json.Serialize<WechatWorkExternalExternalJsonSendWelcomeMsgRequestText>(fieldValue));
        return this;
    }

    WechatWorkExternalApiSendWelcomeMsgRequest Attachments(List<WechatWorkExternalExternalJsonSendWelcomeMsgRequestAttachment> fieldValue) {
        this.request.BodyJson("attachments", Json.Serialize<List<WechatWorkExternalExternalJsonSendWelcomeMsgRequestAttachment>>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
