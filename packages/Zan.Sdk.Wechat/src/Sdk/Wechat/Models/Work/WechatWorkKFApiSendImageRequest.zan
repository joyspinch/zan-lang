using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkKFApiSendImageRequest {
    WechatTypedRequest request;

    public WechatWorkKFApiSendImageRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkKFApiSendImageRequest SenderType(JsonValue fieldValue) {
        this.request.BodyValue("sender", fieldValue);
        return this;
    }

    WechatWorkKFApiSendImageRequest ReceiverType(JsonValue fieldValue) {
        this.request.BodyValue("receiver", fieldValue);
        return this;
    }

    WechatWorkKFApiSendImageRequest MediaId(string fieldValue) {
        this.request.BodyString("image", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
