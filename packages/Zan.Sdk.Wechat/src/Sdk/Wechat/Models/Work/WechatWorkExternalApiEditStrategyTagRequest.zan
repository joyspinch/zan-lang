using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkExternalApiEditStrategyTagRequest {
    WechatTypedRequest request;

    public WechatWorkExternalApiEditStrategyTagRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkExternalApiEditStrategyTagRequest Id(string fieldValue) {
        this.request.BodyString("id", fieldValue);
        return this;
    }

    WechatWorkExternalApiEditStrategyTagRequest Name(string fieldValue) {
        this.request.BodyString("name", fieldValue);
        return this;
    }

    WechatWorkExternalApiEditStrategyTagRequest Order(int fieldValue) {
        this.request.BodyInt("order", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
