using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkMassApiSendTextCardRequest {
    WechatTypedRequest request;

    public WechatWorkMassApiSendTextCardRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkMassApiSendTextCardRequest ToUser(string fieldValue) {
        this.request.BodyString("touser", fieldValue);
        return this;
    }

    WechatWorkMassApiSendTextCardRequest ToParty(string fieldValue) {
        this.request.BodyString("toparty", fieldValue);
        return this;
    }

    WechatWorkMassApiSendTextCardRequest ToTag(string fieldValue) {
        this.request.BodyString("totag", fieldValue);
        return this;
    }

    WechatWorkMassApiSendTextCardRequest AgentId(string fieldValue) {
        this.request.BodyString("agentid", fieldValue);
        return this;
    }

    WechatWorkMassApiSendTextCardRequest Title(string fieldValue) {
        this.request.BodyString("textcard", fieldValue);
        return this;
    }

    WechatWorkMassApiSendTextCardRequest EnableDuplicateCheck(int fieldValue) {
        this.request.BodyInt("enable_duplicate_check", fieldValue);
        return this;
    }

    WechatWorkMassApiSendTextCardRequest DuplicateCheckInterval(int fieldValue) {
        this.request.BodyInt("duplicate_check_interval", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
