using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkCorpgroupApiRuleModifyRuleRequest {
    WechatTypedRequest request;

    public WechatWorkCorpgroupApiRuleModifyRuleRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkCorpgroupApiRuleModifyRuleRequest ChainId(string fieldValue) {
        this.request.BodyString("chain_id", fieldValue);
        return this;
    }

    public WechatWorkCorpgroupApiRuleModifyRuleRequest RuleId(int fieldValue) {
        this.request.BodyInt("rule_id", fieldValue);
        return this;
    }

    public WechatWorkCorpgroupApiRuleModifyRuleRequest RuleInfo(WechatWorkModifyRuleRequestRuleInfo fieldValue) {
        this.request.BodyJson("rule_info", Json.Serialize<WechatWorkModifyRuleRequestRuleInfo>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
