using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkWebhookApiSendNewsRequest {
    WechatTypedRequest request;

    public WechatWorkWebhookApiSendNewsRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkWebhookApiSendNewsRequest Msgtype(string fieldValue) {
        this.request.BodyString("msgtype", fieldValue);
        return this;
    }

    public WechatWorkWebhookApiSendNewsRequest News(WechatWorkWebhookWebhookNewsNews fieldValue) {
        this.request.BodyJson("news", Json.Serialize<WechatWorkWebhookWebhookNewsNews>(fieldValue));
        return this;
    }

    public WechatWorkWebhookApiSendNewsRequest Key(string fieldValue) {
        this.request.QueryString("key", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
