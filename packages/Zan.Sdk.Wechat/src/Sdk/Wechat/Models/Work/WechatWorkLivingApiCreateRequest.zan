using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkLivingApiCreateRequest {
    WechatTypedRequest request;

    public WechatWorkLivingApiCreateRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkLivingApiCreateRequest AnchorUserid(string fieldValue) {
        this.request.BodyString("anchor_userid", fieldValue);
        return this;
    }

    WechatWorkLivingApiCreateRequest Theme(string fieldValue) {
        this.request.BodyString("theme", fieldValue);
        return this;
    }

    WechatWorkLivingApiCreateRequest LivingStart(long fieldValue) {
        this.request.BodyLong("living_start", fieldValue);
        return this;
    }

    WechatWorkLivingApiCreateRequest LivingDuration(int fieldValue) {
        this.request.BodyInt("living_duration", fieldValue);
        return this;
    }

    WechatWorkLivingApiCreateRequest Description(string fieldValue) {
        this.request.BodyString("description", fieldValue);
        return this;
    }

    WechatWorkLivingApiCreateRequest Type(int fieldValue) {
        this.request.BodyInt("type", fieldValue);
        return this;
    }

    WechatWorkLivingApiCreateRequest Agentid(int fieldValue) {
        this.request.BodyInt("agentid", fieldValue);
        return this;
    }

    WechatWorkLivingApiCreateRequest RemindTime(int fieldValue) {
        this.request.BodyInt("remind_time", fieldValue);
        return this;
    }

    WechatWorkLivingApiCreateRequest ActivityCoverMediaid(string fieldValue) {
        this.request.BodyString("activity_cover_mediaid", fieldValue);
        return this;
    }

    WechatWorkLivingApiCreateRequest ActivityShareMediaid(string fieldValue) {
        this.request.BodyString("activity_share_mediaid", fieldValue);
        return this;
    }

    WechatWorkLivingApiCreateRequest ActivityDetail(WechatWorkLivingActivityDetail fieldValue) {
        this.request.BodyJson("activity_detail", Json.Serialize<WechatWorkLivingActivityDetail>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
