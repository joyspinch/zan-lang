using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkMediaApiAddMpNewsRequest {
    WechatTypedRequest request;

    public WechatWorkMediaApiAddMpNewsRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkMediaApiAddMpNewsRequest AgentId(int fieldValue) {
        this.request.BodyInt("agentid", fieldValue);
        return this;
    }

    WechatWorkMediaApiAddMpNewsRequest MpNewsArticles(JsonValue fieldValue) {
        this.request.BodyValue("mpnews", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
