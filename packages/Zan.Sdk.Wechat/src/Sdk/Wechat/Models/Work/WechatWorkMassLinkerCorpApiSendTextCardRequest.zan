using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkMassLinkerCorpApiSendTextCardRequest {
    WechatTypedRequest request;

    public WechatWorkMassLinkerCorpApiSendTextCardRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkMassLinkerCorpApiSendTextCardRequest Touser(List<string> fieldValue) {
        this.request.BodyStrings("touser", fieldValue);
        return this;
    }

    public WechatWorkMassLinkerCorpApiSendTextCardRequest Toparty(List<string> fieldValue) {
        this.request.BodyStrings("toparty", fieldValue);
        return this;
    }

    public WechatWorkMassLinkerCorpApiSendTextCardRequest Totag(List<string> fieldValue) {
        this.request.BodyStrings("totag", fieldValue);
        return this;
    }

    public WechatWorkMassLinkerCorpApiSendTextCardRequest Toall(int fieldValue) {
        this.request.BodyInt("toall", fieldValue);
        return this;
    }

    public WechatWorkMassLinkerCorpApiSendTextCardRequest Msgtype(string fieldValue) {
        this.request.BodyString("msgtype", fieldValue);
        return this;
    }

    public WechatWorkMassLinkerCorpApiSendTextCardRequest Agentid(int fieldValue) {
        this.request.BodyInt("agentid", fieldValue);
        return this;
    }

    public WechatWorkMassLinkerCorpApiSendTextCardRequest Textcard(WechatWorkTextcard fieldValue) {
        this.request.BodyJson("textcard", Json.Serialize<WechatWorkTextcard>(fieldValue));
