using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkExternalApiDeleteContactWayRequest {
    WechatTypedRequest request;

    public WechatWorkExternalApiDeleteContactWayRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkExternalApiDeleteContactWayRequest ConfigId(string fieldValue) {
        this.request.BodyString("config_id", fieldValue);
