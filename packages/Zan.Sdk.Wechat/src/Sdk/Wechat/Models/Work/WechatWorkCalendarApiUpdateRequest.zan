using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkCalendarApiUpdateRequest {
    WechatTypedRequest request;

    public WechatWorkCalendarApiUpdateRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkCalendarApiUpdateRequest SkipPublicRange(int fieldValue) {
        this.request.BodyInt("skip_public_range", fieldValue);
        return this;
    }

    public WechatWorkCalendarApiUpdateRequest Calendar(WechatWorkCalendarUpdate fieldValue) {
        this.request.BodyJson("calendar", Json.Serialize<WechatWorkCalendarUpdate>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
