using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkMailListApiInviteRequest {
    WechatTypedRequest request;

    public WechatWorkMailListApiInviteRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkMailListApiInviteRequest User(List<string> fieldValue) {
        this.request.BodyStrings("user", fieldValue);
        return this;
    }

    public WechatWorkMailListApiInviteRequest Party(List<string> fieldValue) {
        this.request.BodyStrings("party", fieldValue);
        return this;
    }

    public WechatWorkMailListApiInviteRequest Tag(List<string> fieldValue) {
        this.request.BodyStrings("tag", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
