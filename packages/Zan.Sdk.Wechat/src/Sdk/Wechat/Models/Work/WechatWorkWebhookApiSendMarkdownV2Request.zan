using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkWebhookApiSendMarkdownV2Request {
    WechatTypedRequest request;

    public WechatWorkWebhookApiSendMarkdownV2Request() { this.request = new WechatTypedRequest(); }

    WechatWorkWebhookApiSendMarkdownV2Request Content(string fieldValue) {
        this.request.QueryString("markdown_v2", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
