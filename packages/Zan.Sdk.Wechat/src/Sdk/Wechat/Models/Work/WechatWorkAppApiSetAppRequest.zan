using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkAppApiSetAppRequest {
    WechatTypedRequest request;

    public WechatWorkAppApiSetAppRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkAppApiSetAppRequest Agentid(string fieldValue) {
        this.request.BodyString("agentid", fieldValue);
        return this;
    }

    public WechatWorkAppApiSetAppRequest ReportLocationFlag(string fieldValue) {
        this.request.BodyString("report_location_flag", fieldValue);
        return this;
    }

    public WechatWorkAppApiSetAppRequest LogoMediaid(string fieldValue) {
        this.request.BodyString("logo_mediaid", fieldValue);
        return this;
    }

    public WechatWorkAppApiSetAppRequest Name(string fieldValue) {
        this.request.BodyString("name", fieldValue);
        return this;
    }

    public WechatWorkAppApiSetAppRequest Description(string fieldValue) {
        this.request.BodyString("description", fieldValue);
        return this;
    }

    public WechatWorkAppApiSetAppRequest RedirectDomain(string fieldValue) {
        this.request.BodyString("redirect_domain", fieldValue);
        return this;
    }

    public WechatWorkAppApiSetAppRequest Isreportuser(int fieldValue) {
        this.request.BodyInt("isreportuser", fieldValue);
        return this;
    }

    public WechatWorkAppApiSetAppRequest HomeUrl(string fieldValue) {
        this.request.BodyString("home_url", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
