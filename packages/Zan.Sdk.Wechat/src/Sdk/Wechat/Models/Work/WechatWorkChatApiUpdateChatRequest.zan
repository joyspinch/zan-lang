using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkChatApiUpdateChatRequest {
    WechatTypedRequest request;

    public WechatWorkChatApiUpdateChatRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkChatApiUpdateChatRequest ChatId(string fieldValue) {
        this.request.BodyString("chatid", fieldValue);
        return this;
    }

    WechatWorkChatApiUpdateChatRequest Name(string fieldValue) {
        this.request.BodyString("name", fieldValue);
        return this;
    }

    WechatWorkChatApiUpdateChatRequest Owner(string fieldValue) {
        this.request.BodyString("owner", fieldValue);
        return this;
    }

    WechatWorkChatApiUpdateChatRequest AddUserList(List<string> fieldValue) {
        this.request.BodyStrings("add_user_list", fieldValue);
        return this;
    }

    WechatWorkChatApiUpdateChatRequest DelUserList(List<string> fieldValue) {
        this.request.BodyStrings("del_user_list", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
