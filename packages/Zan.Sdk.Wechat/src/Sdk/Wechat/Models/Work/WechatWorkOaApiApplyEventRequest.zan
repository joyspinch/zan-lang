using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkOaApiApplyEventRequest {
    WechatTypedRequest request;

    public WechatWorkOaApiApplyEventRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkOaApiApplyEventRequest CreatorUserid(string fieldValue) {
        this.request.BodyString("creator_userid", fieldValue);
        return this;
    }

    WechatWorkOaApiApplyEventRequest TemplateId(string fieldValue) {
        this.request.BodyString("template_id", fieldValue);
        return this;
    }

    WechatWorkOaApiApplyEventRequest UseTemplateApprover(int fieldValue) {
        this.request.BodyInt("use_template_approver", fieldValue);
        return this;
    }

    WechatWorkOaApiApplyEventRequest ChooseDepartment(int fieldValue) {
        this.request.BodyInt("choose_department", fieldValue);
        return this;
    }

    WechatWorkOaApiApplyEventRequest Approver(List<WechatWorkApplyEventRequestApprover> fieldValue) {
        this.request.BodyJson("approver", Json.Serialize<List<WechatWorkApplyEventRequestApprover>>(fieldValue));
        return this;
    }

    WechatWorkOaApiApplyEventRequest Notifyer(List<string> fieldValue) {
        this.request.BodyStrings("notifyer", fieldValue);
        return this;
    }

    WechatWorkOaApiApplyEventRequest NotifyType(int fieldValue) {
        this.request.BodyInt("notify_type", fieldValue);
        return this;
    }

    WechatWorkOaApiApplyEventRequest ApplyData(WechatWorkApplyEventRequestApplyData fieldValue) {
        this.request.BodyJson("apply_data", Json.Serialize<WechatWorkApplyEventRequestApplyData>(fieldValue));
        return this;
    }

    WechatWorkOaApiApplyEventRequest SummaryList(List<WechatWorkApplyEventRequestSummaryList> fieldValue) {
        this.request.BodyJson("summary_list", Json.Serialize<List<WechatWorkApplyEventRequestSummaryList>>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
