using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkExternalApiTransferExternalRequest {
    WechatTypedRequest request;

    public WechatWorkExternalApiTransferExternalRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkExternalApiTransferExternalRequest ExternalUserId(string fieldValue) {
        this.request.BodyString("external_userid", fieldValue);
        return this;
    }

    WechatWorkExternalApiTransferExternalRequest HandoverUserId(string fieldValue) {
        this.request.BodyString("handover_userid", fieldValue);
        return this;
    }

    WechatWorkExternalApiTransferExternalRequest TakeoverUserId(string fieldValue) {
        this.request.BodyString("takeover_userid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
