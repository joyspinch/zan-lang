using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkThirdPartyAuthApiSetScopeRequest {
    WechatTypedRequest request;

    public WechatWorkThirdPartyAuthApiSetScopeRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkThirdPartyAuthApiSetScopeRequest Agentid(int fieldValue) {
        this.request.QueryInt("agentid", fieldValue);
        return this;
    }

    public WechatWorkThirdPartyAuthApiSetScopeRequest AllowUser(List<string> fieldValue) {
        this.request.QueryStrings("allow_user", fieldValue);
        return this;
    }

    public WechatWorkThirdPartyAuthApiSetScopeRequest AllowParty(List<int> fieldValue) {
        this.request.QueryInts("allow_party", fieldValue);
        return this;
    }

    public WechatWorkThirdPartyAuthApiSetScopeRequest AllowTag(List<int> fieldValue) {
        this.request.QueryInts("allow_tag", fieldValue);
        return this;
    }

    public WechatWorkThirdPartyAuthApiSetScopeRequest AccessToken(string fieldValue) {
        this.request.QueryString("AccessToken", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
