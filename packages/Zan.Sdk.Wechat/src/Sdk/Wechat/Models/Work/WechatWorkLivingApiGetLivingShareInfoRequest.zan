using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkLivingApiGetLivingShareInfoRequest {
    WechatTypedRequest request;

    public WechatWorkLivingApiGetLivingShareInfoRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkLivingApiGetLivingShareInfoRequest WwShareCode(string fieldValue) {
        this.request.BodyString("ww_share_code", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
