using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkMassApiSendFileRequest {
    WechatTypedRequest request;

    public WechatWorkMassApiSendFileRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkMassApiSendFileRequest ToUser(string fieldValue) {
        this.request.BodyString("touser", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendFileRequest ToParty(string fieldValue) {
        this.request.BodyString("toparty", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendFileRequest ToTag(string fieldValue) {
        this.request.BodyString("totag", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendFileRequest AgentId(string fieldValue) {
        this.request.BodyString("agentid", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendFileRequest MediaId(string fieldValue) {
        this.request.BodyString("file", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendFileRequest Safe(int fieldValue) {
        this.request.BodyInt("safe", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendFileRequest EnableDuplicateCheck(int fieldValue) {
        this.request.BodyInt("enable_duplicate_check", fieldValue);
        return this;
    }

    public WechatWorkMassApiSendFileRequest DuplicateCheckInterval(int fieldValue) {
        this.request.BodyInt("duplicate_check_interval", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
