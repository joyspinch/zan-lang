using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkOAuth2ApiGetUserDetailRequest {
    WechatTypedRequest request;

    public WechatWorkOAuth2ApiGetUserDetailRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkOAuth2ApiGetUserDetailRequest UserTicket(string fieldValue) {
        this.request.BodyString("user_ticket", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
