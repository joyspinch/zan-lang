    WechatTypedRequest request;

    public WechatWorkOaApiSetOneUserQuotaRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkOaApiSetOneUserQuotaRequest Userid(string fieldValue) {
        this.request.BodyString("userid", fieldValue);
        return this;
    }

    public WechatWorkOaApiSetOneUserQuotaRequest VacationId(string fieldValue) {
        this.request.BodyString("vacation_id", fieldValue);
        return this;
    }

    public WechatWorkOaApiSetOneUserQuotaRequest Leftduration(int fieldValue) {
        this.request.BodyInt("leftduration", fieldValue);
        return this;
    }

    public WechatWorkOaApiSetOneUserQuotaRequest TimeAttr(int fieldValue) {
        this.request.BodyInt("time_attr", fieldValue);
        return this;
    }

    public WechatWorkOaApiSetOneUserQuotaRequest Remarks(string fieldValue) {
        this.request.BodyString("remarks", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
