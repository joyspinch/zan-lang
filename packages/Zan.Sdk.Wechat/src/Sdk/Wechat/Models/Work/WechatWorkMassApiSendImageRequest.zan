using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkMassApiSendImageRequest {
    WechatTypedRequest request;

    public WechatWorkMassApiSendImageRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkMassApiSendImageRequest ToUser(string fieldValue) {
        this.request.BodyString("touser", fieldValue);
        return this;
    }

    WechatWorkMassApiSendImageRequest ToParty(string fieldValue) {
        this.request.BodyString("toparty", fieldValue);
        return this;
    }

    WechatWorkMassApiSendImageRequest ToTag(string fieldValue) {
        this.request.BodyString("totag", fieldValue);
        return this;
    }

    WechatWorkMassApiSendImageRequest AgentId(string fieldValue) {
        this.request.BodyString("agentid", fieldValue);
        return this;
    }

    WechatWorkMassApiSendImageRequest MediaId(string fieldValue) {
        this.request.BodyString("image", fieldValue);
        return this;
    }

    WechatWorkMassApiSendImageRequest Safe(int fieldValue) {
        this.request.BodyInt("safe", fieldValue);
        return this;
    }

    WechatWorkMassApiSendImageRequest EnableDuplicateCheck(int fieldValue) {
        this.request.BodyInt("enable_duplicate_check", fieldValue);
        return this;
    }

    WechatWorkMassApiSendImageRequest DuplicateCheckInterval(int fieldValue) {
        this.request.BodyInt("duplicate_check_interval", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
