using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkThirdPartyAuthApiGetAuthInfoRequest {
    WechatTypedRequest request;

    public WechatWorkThirdPartyAuthApiGetAuthInfoRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkThirdPartyAuthApiGetAuthInfoRequest SuiteId(string fieldValue) {
        this.request.BodyString("suite_id", fieldValue);
        return this;
    }

    public WechatWorkThirdPartyAuthApiGetAuthInfoRequest AuthCorpId(string fieldValue) {
        this.request.BodyString("auth_corpid", fieldValue);
        return this;
    }

    public WechatWorkThirdPartyAuthApiGetAuthInfoRequest PermanentCode(string fieldValue) {
        this.request.BodyString("permanent_code", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
