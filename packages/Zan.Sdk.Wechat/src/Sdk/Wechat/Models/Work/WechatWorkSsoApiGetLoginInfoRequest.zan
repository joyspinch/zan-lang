using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkSsoApiGetLoginInfoRequest {
    WechatTypedRequest request;

    public WechatWorkSsoApiGetLoginInfoRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkSsoApiGetLoginInfoRequest AuthCode(string fieldValue) {
        this.request.BodyString("auth_code", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
