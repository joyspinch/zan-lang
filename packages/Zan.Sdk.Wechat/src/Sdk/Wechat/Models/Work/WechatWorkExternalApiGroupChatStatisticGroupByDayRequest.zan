using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkExternalApiGroupChatStatisticGroupByDayRequest {
    WechatTypedRequest request;

    public WechatWorkExternalApiGroupChatStatisticGroupByDayRequest() { this.request = new WechatTypedRequest(); }

    public WechatWorkExternalApiGroupChatStatisticGroupByDayRequest DayBeginTime(long fieldValue) {
        this.request.BodyLong("day_begin_time", fieldValue);
        return this;
    }

    public WechatWorkExternalApiGroupChatStatisticGroupByDayRequest DayEndTime(long fieldValue) {
        this.request.BodyLong("day_end_time", fieldValue);
        return this;
    }

    public WechatWorkExternalApiGroupChatStatisticGroupByDayRequest OwnerFilter(WechatWorkGroupChatOwnerFilter fieldValue) {
        this.request.BodyJson("owner_filter", Json.Serialize<WechatWorkGroupChatOwnerFilter>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
