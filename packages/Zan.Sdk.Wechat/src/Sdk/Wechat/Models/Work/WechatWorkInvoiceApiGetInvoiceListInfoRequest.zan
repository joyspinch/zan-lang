using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

public class WechatWorkInvoiceApiGetInvoiceListInfoRequest {
    WechatTypedRequest request;

    public WechatWorkInvoiceApiGetInvoiceListInfoRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkInvoiceApiGetInvoiceListInfoRequest ItemList(List<WechatWorkInvoiceItem> fieldValue) {
        this.request.BodyJson("item_list", Json.Serialize<List<WechatWorkInvoiceItem>>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
