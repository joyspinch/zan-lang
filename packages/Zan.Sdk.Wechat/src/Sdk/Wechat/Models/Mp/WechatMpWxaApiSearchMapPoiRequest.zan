using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpWxaApiSearchMapPoiRequest {
    WechatTypedRequest request;

    public WechatMpWxaApiSearchMapPoiRequest() { this.request = new WechatTypedRequest(); }

    WechatMpWxaApiSearchMapPoiRequest Districtid(int fieldValue) {
        this.request.QueryInt("districtid", fieldValue);
        return this;
    }

    WechatMpWxaApiSearchMapPoiRequest Keyword(string fieldValue) {
        this.request.QueryString("keyword", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
