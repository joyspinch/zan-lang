using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpNonTaxPayApiMockQueryFeeRequest {
    WechatTypedRequest request;

    public WechatMpNonTaxPayApiMockQueryFeeRequest() { this.request = new WechatTypedRequest(); }

    WechatMpNonTaxPayApiMockQueryFeeRequest Appid(string fieldValue) {
        this.request.BodyString("appid", fieldValue);
        return this;
    }

    WechatMpNonTaxPayApiMockQueryFeeRequest Url(string fieldValue) {
        this.request.BodyString("url", fieldValue);
        return this;
    }

    WechatMpNonTaxPayApiMockQueryFeeRequest Version(int fieldValue) {
        this.request.BodyInt("version", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
