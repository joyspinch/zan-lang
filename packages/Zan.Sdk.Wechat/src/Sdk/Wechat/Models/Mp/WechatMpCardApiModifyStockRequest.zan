using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiModifyStockRequest {
    WechatTypedRequest request;

    public WechatMpCardApiModifyStockRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCardApiModifyStockRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    WechatMpCardApiModifyStockRequest IncreaseStockValue(int fieldValue) {
        this.request.BodyInt("increase_stock_value", fieldValue);
        return this;
    }

    WechatMpCardApiModifyStockRequest ReduceStockValue(int fieldValue) {
        this.request.BodyInt("reduce_stock_value", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
