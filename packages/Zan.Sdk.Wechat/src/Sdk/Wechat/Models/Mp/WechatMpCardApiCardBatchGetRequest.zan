using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiCardBatchGetRequest {
    WechatTypedRequest request;

    public WechatMpCardApiCardBatchGetRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCardApiCardBatchGetRequest Offset(int fieldValue) {
        this.request.BodyInt("offset", fieldValue);
        return this;
    }

    public WechatMpCardApiCardBatchGetRequest Count(int fieldValue) {
        this.request.BodyInt("count", fieldValue);
        return this;
    }

    public WechatMpCardApiCardBatchGetRequest StatusList(List<string> fieldValue) {
        this.request.BodyStrings("status_list", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
