using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpShakeAroundApiSetLotterySwitchRequest {
    WechatTypedRequest request;

    public WechatMpShakeAroundApiSetLotterySwitchRequest() { this.request = new WechatTypedRequest(); }

    WechatMpShakeAroundApiSetLotterySwitchRequest LotteryId(string fieldValue) {
        this.request.QueryString("lotteryId", fieldValue);
        return this;
    }

    WechatMpShakeAroundApiSetLotterySwitchRequest OnOff(int fieldValue) {
        this.request.QueryInt("onOff", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
