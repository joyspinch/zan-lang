using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCustomApiSendMpNewsRequest {
    WechatTypedRequest request;

    public WechatMpCustomApiSendMpNewsRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCustomApiSendMpNewsRequest OpenId(string fieldValue) {
        this.request.BodyString("touser", fieldValue);
        return this;
    }

    public WechatMpCustomApiSendMpNewsRequest MediaId(string fieldValue) {
        this.request.BodyString("mpnews", fieldValue);
        return this;
    }

    public WechatMpCustomApiSendMpNewsRequest KfAccount(string fieldValue) {
        this.request.BodyString("CustomService", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
