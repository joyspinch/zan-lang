using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardStoreApiSetStoreCardRequest {
    WechatTypedRequest request;

    public WechatMpCardStoreApiSetStoreCardRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCardStoreApiSetStoreCardRequest PoiId(string fieldValue) {
        this.request.BodyString("poi_id", fieldValue);
        return this;
    }

    WechatMpCardStoreApiSetStoreCardRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
