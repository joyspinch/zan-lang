using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiPayConfirmRequest {
    WechatTypedRequest request;

    public WechatMpCardApiPayConfirmRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCardApiPayConfirmRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    WechatMpCardApiPayConfirmRequest Quantity(int fieldValue) {
        this.request.BodyInt("quantity", fieldValue);
        return this;
    }

    WechatMpCardApiPayConfirmRequest OrderId(string fieldValue) {
        this.request.BodyString("order_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
