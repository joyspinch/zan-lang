using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpOneCodeApiTicketToCodeRequest {
    WechatTypedRequest request;

    public WechatMpOneCodeApiTicketToCodeRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpOneCodeApiTicketToCodeRequest Openid(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    public WechatMpOneCodeApiTicketToCodeRequest CodeTicket(string fieldValue) {
        this.request.BodyString("code_ticket", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
