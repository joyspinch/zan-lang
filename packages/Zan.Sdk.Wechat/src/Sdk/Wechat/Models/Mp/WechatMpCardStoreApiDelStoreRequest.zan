using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardStoreApiDelStoreRequest {
    WechatTypedRequest request;

    public WechatMpCardStoreApiDelStoreRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCardStoreApiDelStoreRequest PoiId(string fieldValue) {
        this.request.BodyString("poi_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
