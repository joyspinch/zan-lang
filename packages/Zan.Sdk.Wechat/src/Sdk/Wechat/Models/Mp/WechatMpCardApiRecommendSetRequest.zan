using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiRecommendSetRequest {
    WechatTypedRequest request;

    public WechatMpCardApiRecommendSetRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCardApiRecommendSetRequest EndTime(long fieldValue) {
        this.request.BodyLong("end_time", fieldValue);
        return this;
    }

    WechatMpCardApiRecommendSetRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    WechatMpCardApiRecommendSetRequest Text(string fieldValue) {
        this.request.BodyString("text", fieldValue);
        return this;
    }

    WechatMpCardApiRecommendSetRequest Url(string fieldValue) {
        this.request.BodyString("url", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
