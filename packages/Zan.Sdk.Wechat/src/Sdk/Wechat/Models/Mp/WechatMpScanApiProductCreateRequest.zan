using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpScanApiProductCreateRequest {
    WechatTypedRequest request;

    public WechatMpScanApiProductCreateRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpScanApiProductCreateRequest BaseInfo(WechatMpBrandInfoBaseInfo fieldValue) {
        this.request.BodyJson("base_info", Json.Serialize<WechatMpBrandInfoBaseInfo>(fieldValue));
        return this;
    }

    public WechatMpScanApiProductCreateRequest DetailInfo(WechatMpBrandInfoDetailInfo fieldValue) {
        this.request.BodyJson("detail_info", Json.Serialize<WechatMpBrandInfoDetailInfo>(fieldValue));
        return this;
    }

    public WechatMpScanApiProductCreateRequest ActionInfo(WechatMpBrandInfoActionInfo fieldValue) {
        this.request.BodyJson("action_info", Json.Serialize<WechatMpBrandInfoActionInfo>(fieldValue));
        return this;
    }

    public WechatMpScanApiProductCreateRequest ModuleInfo(WechatMpBrandInfoModuleInfo fieldValue) {
        this.request.BodyJson("module_info", Json.Serialize<WechatMpBrandInfoModuleInfo>(fieldValue));
        return this;
    }

    public WechatMpScanApiProductCreateRequest KeyStandard(string fieldValue) {
        this.request.BodyString("keyStandard", fieldValue);
        return this;
    }

    public WechatMpScanApiProductCreateRequest KeyStr(string fieldValue) {
        this.request.BodyString("keyStr", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
