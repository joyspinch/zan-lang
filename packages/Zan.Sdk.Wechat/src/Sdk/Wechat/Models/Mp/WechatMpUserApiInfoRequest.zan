using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpUserApiInfoRequest {
    WechatTypedRequest request;

    public WechatMpUserApiInfoRequest() { this.request = new WechatTypedRequest(); }

    WechatMpUserApiInfoRequest OpenId(string fieldValue) {
        this.request.QueryString("openid", fieldValue);
        return this;
    }

    WechatMpUserApiInfoRequest Lang(JsonValue fieldValue) {
        this.request.QueryValue("lang", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
