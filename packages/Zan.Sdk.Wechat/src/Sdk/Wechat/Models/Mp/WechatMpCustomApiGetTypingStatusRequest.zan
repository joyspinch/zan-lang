using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCustomApiGetTypingStatusRequest {
    WechatTypedRequest request;

    public WechatMpCustomApiGetTypingStatusRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCustomApiGetTypingStatusRequest Touser(string fieldValue) {
        this.request.BodyString("touser", fieldValue);
        return this;
    }

    WechatMpCustomApiGetTypingStatusRequest TypingStatus(string fieldValue) {
        this.request.BodyString("command", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
