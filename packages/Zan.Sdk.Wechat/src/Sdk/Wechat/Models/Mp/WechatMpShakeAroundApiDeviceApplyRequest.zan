using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpShakeAroundApiDeviceApplyRequest {
    WechatTypedRequest request;

    public WechatMpShakeAroundApiDeviceApplyRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpShakeAroundApiDeviceApplyRequest Quantity(int fieldValue) {
        this.request.BodyInt("quantity", fieldValue);
        return this;
    }

    public WechatMpShakeAroundApiDeviceApplyRequest ApplyReason(string fieldValue) {
        this.request.BodyString("apply_reason", fieldValue);
        return this;
    }

    public WechatMpShakeAroundApiDeviceApplyRequest Comment(string fieldValue) {
        this.request.BodyString("comment", fieldValue);
        return this;
    }

    public WechatMpShakeAroundApiDeviceApplyRequest PoiId(long fieldValue) {
        this.request.BodyLong("poi_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
