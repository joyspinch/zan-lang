using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiCardDecryptRequest {
    WechatTypedRequest request;

    public WechatMpCardApiCardDecryptRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCardApiCardDecryptRequest EncryptCode(string fieldValue) {
        this.request.BodyString("encrypt_code", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
