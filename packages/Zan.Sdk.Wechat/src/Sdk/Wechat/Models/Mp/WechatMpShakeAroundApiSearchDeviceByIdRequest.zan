using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpShakeAroundApiSearchDeviceByIdRequest {
    WechatTypedRequest request;

    public WechatMpShakeAroundApiSearchDeviceByIdRequest() { this.request = new WechatTypedRequest(); }

    WechatMpShakeAroundApiSearchDeviceByIdRequest DeviceIdentifiers(List<WechatMpDeviceApplyDataDeviceIdentifiers> fieldValue) {
        this.request.BodyJson("device_identifiers", Json.Serialize<List<WechatMpDeviceApplyDataDeviceIdentifiers>>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
