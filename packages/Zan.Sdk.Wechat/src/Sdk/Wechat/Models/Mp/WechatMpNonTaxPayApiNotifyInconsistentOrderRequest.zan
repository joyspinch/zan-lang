using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpNonTaxPayApiNotifyInconsistentOrderRequest {
    WechatTypedRequest request;

    public WechatMpNonTaxPayApiNotifyInconsistentOrderRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpNonTaxPayApiNotifyInconsistentOrderRequest Appid(string fieldValue) {
        this.request.BodyString("appid", fieldValue);
        return this;
    }

    public WechatMpNonTaxPayApiNotifyInconsistentOrderRequest OrderId(string fieldValue) {
        this.request.BodyString("order_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
