using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCustomServiceApiCloseSessionRequest {
    WechatTypedRequest request;

    public WechatMpCustomServiceApiCloseSessionRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCustomServiceApiCloseSessionRequest OpenId(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    public WechatMpCustomServiceApiCloseSessionRequest KfAccount(string fieldValue) {
        this.request.BodyString("kf_account", fieldValue);
        return this;
    }

    public WechatMpCustomServiceApiCloseSessionRequest Text(string fieldValue) {
        this.request.BodyString("text", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
