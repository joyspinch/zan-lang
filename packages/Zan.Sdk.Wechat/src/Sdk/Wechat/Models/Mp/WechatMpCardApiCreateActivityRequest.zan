using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiCreateActivityRequest {
    WechatTypedRequest request;

    public WechatMpCardApiCreateActivityRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCardApiCreateActivityRequest Info(WechatMpCardGiftcardMktActivityDataInfo fieldValue) {
        this.request.BodyJson("info", Json.Serialize<WechatMpCardGiftcardMktActivityDataInfo>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
