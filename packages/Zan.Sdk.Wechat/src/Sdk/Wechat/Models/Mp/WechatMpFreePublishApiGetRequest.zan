using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpFreePublishApiGetRequest {
    WechatTypedRequest request;

    public WechatMpFreePublishApiGetRequest() { this.request = new WechatTypedRequest(); }

    WechatMpFreePublishApiGetRequest PublishId(string fieldValue) {
        this.request.BodyString("publish_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
