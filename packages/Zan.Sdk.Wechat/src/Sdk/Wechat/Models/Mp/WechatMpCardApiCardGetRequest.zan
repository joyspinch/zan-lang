using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiCardGetRequest {
    WechatTypedRequest request;

    public WechatMpCardApiCardGetRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCardApiCardGetRequest Code(string fieldValue) {
        this.request.BodyString("code", fieldValue);
        return this;
    }

    public WechatMpCardApiCardGetRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
