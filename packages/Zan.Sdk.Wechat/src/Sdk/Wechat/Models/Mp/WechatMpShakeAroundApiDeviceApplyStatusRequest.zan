using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpShakeAroundApiDeviceApplyStatusRequest {
    WechatTypedRequest request;

    public WechatMpShakeAroundApiDeviceApplyStatusRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpShakeAroundApiDeviceApplyStatusRequest AppId(long fieldValue) {
        this.request.BodyLong("apply_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
