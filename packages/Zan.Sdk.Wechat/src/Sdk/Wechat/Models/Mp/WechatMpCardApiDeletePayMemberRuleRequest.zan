using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiDeletePayMemberRuleRequest {
    WechatTypedRequest request;

    public WechatMpCardApiDeletePayMemberRuleRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCardApiDeletePayMemberRuleRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    public WechatMpCardApiDeletePayMemberRuleRequest MchidList(List<int> fieldValue) {
        this.request.BodyInts("mchid_list", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
