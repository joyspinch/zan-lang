using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCustomApiSendMenuRequest {
    WechatTypedRequest request;

    public WechatMpCustomApiSendMenuRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCustomApiSendMenuRequest Head(string fieldValue) {
        this.request.BodyString("head_content", fieldValue);
        return this;
    }

    public WechatMpCustomApiSendMenuRequest MenuList(List<WechatMpSendMenuContent> fieldValue) {
        this.request.BodyJson("list", Json.Serialize<List<WechatMpSendMenuContent>>(fieldValue));
        return this;
    }

    public WechatMpCustomApiSendMenuRequest Tail(string fieldValue) {
        this.request.BodyString("tail_content", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
