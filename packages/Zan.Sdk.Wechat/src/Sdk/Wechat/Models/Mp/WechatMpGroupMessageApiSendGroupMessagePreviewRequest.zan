using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpGroupMessageApiSendGroupMessagePreviewRequest {
    WechatTypedRequest request;

    public WechatMpGroupMessageApiSendGroupMessagePreviewRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpGroupMessageApiSendGroupMessagePreviewRequest Type(int fieldValue) {
        this.request.BodyInt("type", fieldValue);
        return this;
    }

    public WechatMpGroupMessageApiSendGroupMessagePreviewRequest Value(string fieldValue) {
        this.request.BodyString("value", fieldValue);
        return this;
    }

    public WechatMpGroupMessageApiSendGroupMessagePreviewRequest OpenId(string fieldValue) {
        this.request.BodyString("openId", fieldValue);
        return this;
    }

    public WechatMpGroupMessageApiSendGroupMessagePreviewRequest WxName(string fieldValue) {
        this.request.BodyString("wxName", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
