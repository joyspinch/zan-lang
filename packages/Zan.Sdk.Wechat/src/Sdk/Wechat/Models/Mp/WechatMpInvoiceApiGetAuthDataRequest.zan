using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpInvoiceApiGetAuthDataRequest {
    WechatTypedRequest request;

    public WechatMpInvoiceApiGetAuthDataRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpInvoiceApiGetAuthDataRequest OrderId(string fieldValue) {
        this.request.BodyString("order_id", fieldValue);
        return this;
    }

    public WechatMpInvoiceApiGetAuthDataRequest SAppId(string fieldValue) {
        this.request.BodyString("s_appid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
