using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpUserApiUpdateRemarkRequest {
    WechatTypedRequest request;

    public WechatMpUserApiUpdateRemarkRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpUserApiUpdateRemarkRequest OpenId(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    public WechatMpUserApiUpdateRemarkRequest Remark(string fieldValue) {
        this.request.BodyString("remark", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
