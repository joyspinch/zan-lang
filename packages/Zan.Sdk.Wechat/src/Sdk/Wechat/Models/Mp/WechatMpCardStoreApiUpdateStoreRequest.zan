using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardStoreApiUpdateStoreRequest {
    WechatTypedRequest request;

    public WechatMpCardStoreApiUpdateStoreRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCardStoreApiUpdateStoreRequest MapPoiId(string fieldValue) {
        this.request.BodyString("map_poi_id", fieldValue);
        return this;
    }

    public WechatMpCardStoreApiUpdateStoreRequest PoiId(string fieldValue) {
        this.request.BodyString("poi_id", fieldValue);
        return this;
    }

    public WechatMpCardStoreApiUpdateStoreRequest Hour(string fieldValue) {
        this.request.BodyString("hour", fieldValue);
        return this;
    }

    public WechatMpCardStoreApiUpdateStoreRequest ContractPhone(string fieldValue) {
        this.request.BodyString("contract_phone", fieldValue);
        return this;
    }

    public WechatMpCardStoreApiUpdateStoreRequest PicList(string fieldValue) {
        this.request.BodyString("pic_list", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
