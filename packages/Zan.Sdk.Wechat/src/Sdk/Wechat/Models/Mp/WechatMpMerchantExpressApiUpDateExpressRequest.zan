using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpMerchantExpressApiUpDateExpressRequest {
    WechatTypedRequest request;

    public WechatMpMerchantExpressApiUpDateExpressRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpMerchantExpressApiUpDateExpressRequest TemplateId(int fieldValue) {
        this.request.BodyInt("template_id", fieldValue);
        return this;
    }

    public WechatMpMerchantExpressApiUpDateExpressRequest DeliveryTemplate(string fieldValue) {
        this.request.BodyString("delivery_template", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
