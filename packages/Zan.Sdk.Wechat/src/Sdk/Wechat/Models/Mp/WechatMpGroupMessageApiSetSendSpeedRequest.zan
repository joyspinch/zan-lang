using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpGroupMessageApiSetSendSpeedRequest {
    WechatTypedRequest request;

    public WechatMpGroupMessageApiSetSendSpeedRequest() { this.request = new WechatTypedRequest(); }

    WechatMpGroupMessageApiSetSendSpeedRequest Speed(int fieldValue) {
        this.request.BodyInt("speed", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
