using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpUserTagApiCreateRequest {
    WechatTypedRequest request;

    public WechatMpUserTagApiCreateRequest() { this.request = new WechatTypedRequest(); }

    WechatMpUserTagApiCreateRequest Name(string fieldValue) {
        this.request.BodyString("tag", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
