using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpInvoiceApiSetAuthFieldRequest {
    WechatTypedRequest request;

    public WechatMpInvoiceApiSetAuthFieldRequest() { this.request = new WechatTypedRequest(); }

    WechatMpInvoiceApiSetAuthFieldRequest UserField(WechatMpUserFiledData fieldValue) {
        this.request.QueryJson("user_field", Json.Serialize<WechatMpUserFiledData>(fieldValue));
        return this;
    }

    WechatMpInvoiceApiSetAuthFieldRequest BizField(WechatMpBizField fieldValue) {
        this.request.BodyJson("biz_field", Json.Serialize<WechatMpBizField>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
