using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCustomServiceApiInviteWorkerRequest {
    WechatTypedRequest request;

    public WechatMpCustomServiceApiInviteWorkerRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCustomServiceApiInviteWorkerRequest KfAccount(string fieldValue) {
        this.request.BodyString("kf_account", fieldValue);
        return this;
    }

    public WechatMpCustomServiceApiInviteWorkerRequest InviteWx(string fieldValue) {
        this.request.BodyString("invite_wx", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
