using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpWxaApiUpdateStoreRequest {
    WechatTypedRequest request;

    public WechatMpWxaApiUpdateStoreRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpWxaApiUpdateStoreRequest PoiId(string fieldValue) {
        this.request.BodyString("poi_id", fieldValue);
        return this;
    }

    public WechatMpWxaApiUpdateStoreRequest Hour(string fieldValue) {
        this.request.BodyString("hour", fieldValue);
        return this;
    }

    public WechatMpWxaApiUpdateStoreRequest PicList(string fieldValue) {
        this.request.BodyString("pic_list", fieldValue);
        return this;
    }

    public WechatMpWxaApiUpdateStoreRequest ContractPhone(string fieldValue) {
        this.request.BodyString("contract_phone", fieldValue);
        return this;
    }

    public WechatMpWxaApiUpdateStoreRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
