using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpOneCodeApiApplyCodeRequest {
    WechatTypedRequest request;

    public WechatMpOneCodeApiApplyCodeRequest() { this.request = new WechatTypedRequest(); }

    WechatMpOneCodeApiApplyCodeRequest CodeCount(long fieldValue) {
        this.request.BodyLong("code_count", fieldValue);
        return this;
    }

    WechatMpOneCodeApiApplyCodeRequest IsvApplicationId(string fieldValue) {
        this.request.BodyString("isv_application_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
