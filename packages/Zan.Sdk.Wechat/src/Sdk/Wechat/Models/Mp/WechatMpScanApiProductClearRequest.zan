using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpScanApiProductClearRequest {
    WechatTypedRequest request;

    public WechatMpScanApiProductClearRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpScanApiProductClearRequest KeyStandard(int fieldValue) {
        this.request.BodyInt("keystandard", fieldValue);
        return this;
    }

    public WechatMpScanApiProductClearRequest KeyStr(string fieldValue) {
        this.request.BodyString("keystr", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
