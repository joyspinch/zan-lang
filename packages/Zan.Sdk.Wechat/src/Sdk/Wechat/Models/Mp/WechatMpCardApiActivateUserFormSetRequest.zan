using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiActivateUserFormSetRequest {
    WechatTypedRequest request;

    public WechatMpCardApiActivateUserFormSetRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCardApiActivateUserFormSetRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    public WechatMpCardApiActivateUserFormSetRequest RequiredForm(WechatMpBaseForm fieldValue) {
        this.request.BodyJson("required_form", Json.Serialize<WechatMpBaseForm>(fieldValue));
        return this;
    }

    public WechatMpCardApiActivateUserFormSetRequest OptionalForm(WechatMpBaseForm fieldValue) {
        this.request.BodyJson("optional_form", Json.Serialize<WechatMpBaseForm>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
