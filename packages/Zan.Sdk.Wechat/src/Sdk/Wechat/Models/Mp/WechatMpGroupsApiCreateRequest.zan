using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpGroupsApiCreateRequest {
    WechatTypedRequest request;

    public WechatMpGroupsApiCreateRequest() { this.request = new WechatTypedRequest(); }

    WechatMpGroupsApiCreateRequest Name(string fieldValue) {
        this.request.BodyString("group", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
