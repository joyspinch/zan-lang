using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpUserApiBatchGetUserInfoRequest {
    WechatTypedRequest request;

    public WechatMpUserApiBatchGetUserInfoRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpUserApiBatchGetUserInfoRequest UserList(List<WechatMpBatchGetUserInfoData> fieldValue) {
        this.request.BodyJson("user_list", Json.Serialize<List<WechatMpBatchGetUserInfoData>>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
