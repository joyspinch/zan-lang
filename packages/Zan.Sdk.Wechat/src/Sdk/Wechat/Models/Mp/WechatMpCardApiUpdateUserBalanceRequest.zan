using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiUpdateUserBalanceRequest {
    WechatTypedRequest request;

    public WechatMpCardApiUpdateUserBalanceRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCardApiUpdateUserBalanceRequest Code(string fieldValue) {
        this.request.BodyString("code", fieldValue);
        return this;
    }

    public WechatMpCardApiUpdateUserBalanceRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    public WechatMpCardApiUpdateUserBalanceRequest Balance(double fieldValue) {
        this.request.BodyDouble("balance", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
