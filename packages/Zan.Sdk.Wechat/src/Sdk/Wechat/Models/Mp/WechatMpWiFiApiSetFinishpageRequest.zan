using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpWiFiApiSetFinishpageRequest {
    WechatTypedRequest request;

    public WechatMpWiFiApiSetFinishpageRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpWiFiApiSetFinishpageRequest ShopId(long fieldValue) {
        this.request.BodyLong("shop_id", fieldValue);
        return this;
    }

    public WechatMpWiFiApiSetFinishpageRequest FinishPageUrl(string fieldValue) {
        this.request.BodyString("finishpage_url", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
