using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiGetCardUrlRequest {
    WechatTypedRequest request;

    public WechatMpCardApiGetCardUrlRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCardApiGetCardUrlRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    WechatMpCardApiGetCardUrlRequest OuterStr(string fieldValue) {
        this.request.BodyString("outer_str", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
