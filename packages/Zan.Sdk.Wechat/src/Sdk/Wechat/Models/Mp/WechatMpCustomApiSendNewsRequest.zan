using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCustomApiSendNewsRequest {
    WechatTypedRequest request;

    public WechatMpCustomApiSendNewsRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCustomApiSendNewsRequest OpenId(string fieldValue) {
        this.request.BodyString("touser", fieldValue);
        return this;
    }

    WechatMpCustomApiSendNewsRequest Articles(JsonValue fieldValue) {
        this.request.BodyValue("news", fieldValue);
        return this;
    }

    WechatMpCustomApiSendNewsRequest KfAccount(string fieldValue) {
        this.request.BodyString("CustomService", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
