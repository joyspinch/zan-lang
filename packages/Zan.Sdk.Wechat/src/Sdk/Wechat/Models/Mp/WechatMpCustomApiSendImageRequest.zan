using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCustomApiSendImageRequest {
    WechatTypedRequest request;

    public WechatMpCustomApiSendImageRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCustomApiSendImageRequest OpenId(string fieldValue) {
        this.request.BodyString("touser", fieldValue);
        return this;
    }

    WechatMpCustomApiSendImageRequest MediaId(string fieldValue) {
        this.request.BodyString("image", fieldValue);
        return this;
    }

    WechatMpCustomApiSendImageRequest KfAccount(string fieldValue) {
        this.request.BodyString("CustomService", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
