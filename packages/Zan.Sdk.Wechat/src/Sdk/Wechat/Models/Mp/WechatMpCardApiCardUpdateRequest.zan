using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiCardUpdateRequest {
    WechatTypedRequest request;

    public WechatMpCardApiCardUpdateRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCardApiCardUpdateRequest CardType(int fieldValue) {
        this.request.BodyInt("cardType", fieldValue);
        return this;
    }

    WechatMpCardApiCardUpdateRequest Data(JsonValue fieldValue) {
        this.request.BodyValue("data", fieldValue);
        return this;
    }

    WechatMpCardApiCardUpdateRequest CardId(string fieldValue) {
        this.request.BodyString("cardId", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
