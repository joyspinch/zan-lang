using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpFreePublishApiDeleteRequest {
    WechatTypedRequest request;

    public WechatMpFreePublishApiDeleteRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpFreePublishApiDeleteRequest ArticleId(string fieldValue) {
        this.request.BodyString("article_id", fieldValue);
        return this;
    }

    public WechatMpFreePublishApiDeleteRequest Index(int fieldValue) {
        this.request.BodyInt("index", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
