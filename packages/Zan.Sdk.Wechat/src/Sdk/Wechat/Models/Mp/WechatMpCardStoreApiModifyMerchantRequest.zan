using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardStoreApiModifyMerchantRequest {
    WechatTypedRequest request;

    public WechatMpCardStoreApiModifyMerchantRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCardStoreApiModifyMerchantRequest HeadingMediaid(string fieldValue) {
        this.request.BodyString("headimg_mediaid", fieldValue);
        return this;
    }

    WechatMpCardStoreApiModifyMerchantRequest Intro(string fieldValue) {
        this.request.BodyString("intro", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
