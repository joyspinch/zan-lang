using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpInvoiceApiGetSelectTitleUrlRequest {
    WechatTypedRequest request;

    public WechatMpInvoiceApiGetSelectTitleUrlRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpInvoiceApiGetSelectTitleUrlRequest Attach(string fieldValue) {
        this.request.BodyString("attach", fieldValue);
        return this;
    }

    public WechatMpInvoiceApiGetSelectTitleUrlRequest BizName(string fieldValue) {
        this.request.BodyString("biz_name", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
