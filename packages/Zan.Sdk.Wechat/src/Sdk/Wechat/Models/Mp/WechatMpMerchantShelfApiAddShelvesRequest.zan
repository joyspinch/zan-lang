    public WechatMpMerchantShelfApiAddShelvesRequest GroupInfo(WechatMpM1GroupInfo fieldValue) {
        this.request.BodyJson("group_info", Json.Serialize<WechatMpM1GroupInfo>(fieldValue));
        return this;
    }

    public WechatMpMerchantShelfApiAddShelvesRequest Eid(int fieldValue) {
        this.request.BodyInt("eid", fieldValue);
