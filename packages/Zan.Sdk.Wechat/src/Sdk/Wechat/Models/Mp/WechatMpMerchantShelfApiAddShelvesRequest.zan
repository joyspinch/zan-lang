    }

    public WechatMpMerchantShelfApiAddShelvesRequest GroupInfos(WechatMpM2GroupInfos fieldValue) {
        this.request.BodyJson("group_infos", Json.Serialize<WechatMpM2GroupInfos>(fieldValue));
