    public WechatMpMerchantShelfApiAddShelvesRequest ShelfBanner(string fieldValue) {
        this.request.BodyString("shelfBanner", fieldValue);
        return this;
    }

    public WechatMpMerchantShelfApiAddShelvesRequest ShelfName(string fieldValue) {
        this.request.BodyString("shelfName", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
