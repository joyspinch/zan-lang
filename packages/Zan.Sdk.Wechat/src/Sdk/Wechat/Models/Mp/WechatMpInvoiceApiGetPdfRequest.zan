using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpInvoiceApiGetPdfRequest {
    WechatTypedRequest request;

    public WechatMpInvoiceApiGetPdfRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpInvoiceApiGetPdfRequest SMediaId(string fieldValue) {
        this.request.QueryString("s_media_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
