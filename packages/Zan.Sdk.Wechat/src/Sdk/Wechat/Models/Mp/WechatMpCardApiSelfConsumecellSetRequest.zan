using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiSelfConsumecellSetRequest {
    WechatTypedRequest request;

    public WechatMpCardApiSelfConsumecellSetRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCardApiSelfConsumecellSetRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    public WechatMpCardApiSelfConsumecellSetRequest IsOpen(bool fieldValue) {
        this.request.BodyBool("is_open", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
