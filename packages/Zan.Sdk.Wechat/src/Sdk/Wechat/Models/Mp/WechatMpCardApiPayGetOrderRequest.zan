using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiPayGetOrderRequest {
    WechatTypedRequest request;

    public WechatMpCardApiPayGetOrderRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCardApiPayGetOrderRequest OrderId(int fieldValue) {
        this.request.BodyInt("order_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
