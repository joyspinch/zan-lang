using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiCreateCardRequest {
    WechatTypedRequest request;

    public WechatMpCardApiCreateCardRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCardApiCreateCardRequest BaseInfo(WechatMpCardBaseInfoBase fieldValue) {
        this.request.BodyJson("base_info", Json.Serialize<WechatMpCardBaseInfoBase>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
