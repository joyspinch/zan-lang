using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiPayCellSetRequest {
    WechatTypedRequest request;

    public WechatMpCardApiPayCellSetRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCardApiPayCellSetRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    WechatMpCardApiPayCellSetRequest IsOpen(bool fieldValue) {
        this.request.BodyBool("is_open", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
