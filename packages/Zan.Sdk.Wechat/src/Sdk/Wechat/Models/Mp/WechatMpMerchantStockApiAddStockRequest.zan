using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpMerchantStockApiAddStockRequest {
    WechatTypedRequest request;

    public WechatMpMerchantStockApiAddStockRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpMerchantStockApiAddStockRequest ProductId(string fieldValue) {
        this.request.BodyString("product_id", fieldValue);
        return this;
    }

    public WechatMpMerchantStockApiAddStockRequest SkuInfo(string fieldValue) {
        this.request.BodyString("sku_info", fieldValue);
        return this;
    }

    public WechatMpMerchantStockApiAddStockRequest Quantity(int fieldValue) {
        this.request.BodyInt("quantity", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
