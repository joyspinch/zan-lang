using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpNewTmplApiAddTemplateRequest {
    WechatTypedRequest request;

    public WechatMpNewTmplApiAddTemplateRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpNewTmplApiAddTemplateRequest Tid(string fieldValue) {
        this.request.BodyString("tid", fieldValue);
        return this;
    }

    public WechatMpNewTmplApiAddTemplateRequest KidList(List<int> fieldValue) {
        this.request.BodyInts("kidList", fieldValue);
        return this;
    }

    public WechatMpNewTmplApiAddTemplateRequest SceneDesc(string fieldValue) {
        this.request.BodyString("sceneDesc", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
