using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpInvoiceApiInsertCardToBagRequest {
    WechatTypedRequest request;

    public WechatMpInvoiceApiInsertCardToBagRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpInvoiceApiInsertCardToBagRequest OrderId(string fieldValue) {
        this.request.BodyString("order_id", fieldValue);
        return this;
    }

    public WechatMpInvoiceApiInsertCardToBagRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    public WechatMpInvoiceApiInsertCardToBagRequest Appid(string fieldValue) {
        this.request.BodyString("appid", fieldValue);
        return this;
    }

    public WechatMpInvoiceApiInsertCardToBagRequest CardExt(WechatMpCardExtInfo fieldValue) {
        this.request.BodyJson("card_ext", Json.Serialize<WechatMpCardExtInfo>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
