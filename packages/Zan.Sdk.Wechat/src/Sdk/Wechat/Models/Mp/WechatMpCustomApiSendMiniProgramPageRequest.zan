using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCustomApiSendMiniProgramPageRequest {
    WechatTypedRequest request;

    public WechatMpCustomApiSendMiniProgramPageRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCustomApiSendMiniProgramPageRequest Title(string fieldValue) {
        this.request.BodyString("title", fieldValue);
        return this;
    }

    WechatMpCustomApiSendMiniProgramPageRequest Appid(string fieldValue) {
        this.request.BodyString("appid", fieldValue);
        return this;
    }

    WechatMpCustomApiSendMiniProgramPageRequest Pagepath(string fieldValue) {
        this.request.BodyString("pagepath", fieldValue);
        return this;
    }

    WechatMpCustomApiSendMiniProgramPageRequest ThumbMediaId(string fieldValue) {
        this.request.BodyString("thumb_media_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
