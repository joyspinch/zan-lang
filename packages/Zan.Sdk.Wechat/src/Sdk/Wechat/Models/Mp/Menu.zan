using Sdk.Wechat;
using Sdk.Wechat.Mp;
using System;
using System.Json;

namespace Sdk.Wechat.Mp;

public class WechatMpCVOCRApiMenuRequest {
    WechatTypedRequest request;

    public WechatMpCVOCRApiMenuRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCVOCRApiMenuRequest ImgUrl(string fieldValue) {
        this.request.QueryString("img_url", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}

public class WechatMpCVOCRApiMenuResponse : WechatMpMenuJsonResult {
    public string Raw;
}

public class WechatMpMenuJsonResult {
    public string content;
}
