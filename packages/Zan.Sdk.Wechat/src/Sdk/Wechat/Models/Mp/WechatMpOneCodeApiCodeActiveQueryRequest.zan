using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpOneCodeApiCodeActiveQueryRequest {
    WechatTypedRequest request;

    public WechatMpOneCodeApiCodeActiveQueryRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpOneCodeApiCodeActiveQueryRequest ApplicationId(long fieldValue) {
        this.request.BodyLong("application_id", fieldValue);
        return this;
    }

    public WechatMpOneCodeApiCodeActiveQueryRequest CodeIndex(long fieldValue) {
        this.request.BodyLong("code_index", fieldValue);
        return this;
    }

    public WechatMpOneCodeApiCodeActiveQueryRequest CodeUrl(string fieldValue) {
        this.request.BodyString("code_url", fieldValue);
        return this;
    }

    public WechatMpOneCodeApiCodeActiveQueryRequest Code(string fieldValue) {
        this.request.BodyString("code", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
