using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCustomApiSendTextRequest {
    WechatTypedRequest request;

    public WechatMpCustomApiSendTextRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCustomApiSendTextRequest OpenId(string fieldValue) {
        this.request.BodyString("touser", fieldValue);
        return this;
    }

    WechatMpCustomApiSendTextRequest Content(string fieldValue) {
        this.request.BodyString("text", fieldValue);
        return this;
    }

    WechatMpCustomApiSendTextRequest KfAccount(string fieldValue) {
        this.request.BodyString("customservice", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
