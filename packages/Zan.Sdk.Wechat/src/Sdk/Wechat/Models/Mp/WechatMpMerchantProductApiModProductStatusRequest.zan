using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpMerchantProductApiModProductStatusRequest {
    WechatTypedRequest request;

    public WechatMpMerchantProductApiModProductStatusRequest() { this.request = new WechatTypedRequest(); }

    WechatMpMerchantProductApiModProductStatusRequest ProductId(string fieldValue) {
        this.request.BodyString("product_id", fieldValue);
        return this;
    }

    WechatMpMerchantProductApiModProductStatusRequest Status(int fieldValue) {
        this.request.BodyInt("status", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
