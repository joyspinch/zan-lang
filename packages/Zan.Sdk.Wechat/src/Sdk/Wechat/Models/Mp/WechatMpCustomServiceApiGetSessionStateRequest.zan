using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCustomServiceApiGetSessionStateRequest {
    WechatTypedRequest request;

    public WechatMpCustomServiceApiGetSessionStateRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCustomServiceApiGetSessionStateRequest OpenId(string fieldValue) {
        this.request.QueryString("openid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
