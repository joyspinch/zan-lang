using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiPayRechargeRequest {
    WechatTypedRequest request;

    public WechatMpCardApiPayRechargeRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCardApiPayRechargeRequest CoinCount(int fieldValue) {
        this.request.BodyInt("coin_count", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
