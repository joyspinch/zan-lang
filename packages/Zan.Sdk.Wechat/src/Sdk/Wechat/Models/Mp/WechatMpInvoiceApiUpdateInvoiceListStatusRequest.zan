using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpInvoiceApiUpdateInvoiceListStatusRequest {
    WechatTypedRequest request;

    public WechatMpInvoiceApiUpdateInvoiceListStatusRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpInvoiceApiUpdateInvoiceListStatusRequest OpenId(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    public WechatMpInvoiceApiUpdateInvoiceListStatusRequest ReimburseStatus(int fieldValue) {
        this.request.BodyInt("reimburse_status", fieldValue);
        return this;
    }

    public WechatMpInvoiceApiUpdateInvoiceListStatusRequest ItemList(List<WechatMpInvoiceItem> fieldValue) {
        this.request.BodyJson("invoice_list", Json.Serialize<List<WechatMpInvoiceItem>>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
