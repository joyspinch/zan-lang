using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCustomServiceApiUpdateCustomRequest {
    WechatTypedRequest request;

    public WechatMpCustomServiceApiUpdateCustomRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCustomServiceApiUpdateCustomRequest KfAccount(string fieldValue) {
        this.request.BodyString("kf_account", fieldValue);
        return this;
    }

    WechatMpCustomServiceApiUpdateCustomRequest NickName(string fieldValue) {
        this.request.BodyString("nickname", fieldValue);
        return this;
    }

    WechatMpCustomServiceApiUpdateCustomRequest PassWord(string fieldValue) {
        this.request.BodyString("password", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
