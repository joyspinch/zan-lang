using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpMediaApiUploadNewsRequest {
    WechatTypedRequest request;

    public WechatMpMediaApiUploadNewsRequest() { this.request = new WechatTypedRequest(); }

    WechatMpMediaApiUploadNewsRequest News(List<WechatMpNewsModel> fieldValue) {
        this.request.BodyJson("articles", Json.Serialize<List<WechatMpNewsModel>>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
