using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCustomServiceApiAddCustomRequest {
    WechatTypedRequest request;

    public WechatMpCustomServiceApiAddCustomRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCustomServiceApiAddCustomRequest KfAccount(string fieldValue) {
        this.request.BodyString("kf_account", fieldValue);
        return this;
    }

    public WechatMpCustomServiceApiAddCustomRequest NickName(string fieldValue) {
        this.request.BodyString("nickname", fieldValue);
        return this;
    }

    public WechatMpCustomServiceApiAddCustomRequest PassWord(string fieldValue) {
        this.request.BodyString("password", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
