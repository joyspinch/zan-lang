using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiBoardingPassCheckInRequest {
    WechatTypedRequest request;

    public WechatMpCardApiBoardingPassCheckInRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCardApiBoardingPassCheckInRequest Code(string fieldValue) {
        this.request.BodyString("code", fieldValue);
        return this;
    }

    WechatMpCardApiBoardingPassCheckInRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    WechatMpCardApiBoardingPassCheckInRequest PassengerName(string fieldValue) {
        this.request.BodyString("passenger_name", fieldValue);
        return this;
    }

    WechatMpCardApiBoardingPassCheckInRequest ClassType(string fieldValue) {
        this.request.BodyString("@class", fieldValue);
        return this;
    }

    WechatMpCardApiBoardingPassCheckInRequest Seat(string fieldValue) {
        this.request.BodyString("seat", fieldValue);
        return this;
    }

    WechatMpCardApiBoardingPassCheckInRequest EtktBnr(string fieldValue) {
        this.request.BodyString("etkt_bnr", fieldValue);
        return this;
    }

    WechatMpCardApiBoardingPassCheckInRequest QrcodeData(string fieldValue) {
        this.request.BodyString("qrcode_data", fieldValue);
        return this;
    }

    WechatMpCardApiBoardingPassCheckInRequest IsCancel(bool fieldValue) {
        this.request.BodyBool("is_cancel", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
