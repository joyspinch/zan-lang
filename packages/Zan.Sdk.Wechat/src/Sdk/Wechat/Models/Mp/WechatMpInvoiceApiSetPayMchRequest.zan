using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpInvoiceApiSetPayMchRequest {
    WechatTypedRequest request;

    public WechatMpInvoiceApiSetPayMchRequest() { this.request = new WechatTypedRequest(); }

    WechatMpInvoiceApiSetPayMchRequest Mchid(string fieldValue) {
        this.request.QueryString("mchid", fieldValue);
        return this;
    }

    WechatMpInvoiceApiSetPayMchRequest SPappid(string fieldValue) {
        this.request.BodyString("s_pappid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
