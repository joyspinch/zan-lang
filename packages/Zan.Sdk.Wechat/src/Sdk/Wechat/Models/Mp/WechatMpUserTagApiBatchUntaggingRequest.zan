using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpUserTagApiBatchUntaggingRequest {
    WechatTypedRequest request;

    public WechatMpUserTagApiBatchUntaggingRequest() { this.request = new WechatTypedRequest(); }

    WechatMpUserTagApiBatchUntaggingRequest OpenidList(List<string> fieldValue) {
        this.request.BodyStrings("openid_list", fieldValue);
        return this;
    }

    WechatMpUserTagApiBatchUntaggingRequest Tagid(int fieldValue) {
        this.request.BodyInt("tagid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
