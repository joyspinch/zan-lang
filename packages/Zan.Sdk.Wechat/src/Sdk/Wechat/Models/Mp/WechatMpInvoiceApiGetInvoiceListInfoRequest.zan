using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpInvoiceApiGetInvoiceListInfoRequest {
    WechatTypedRequest request;

    public WechatMpInvoiceApiGetInvoiceListInfoRequest() { this.request = new WechatTypedRequest(); }

    WechatMpInvoiceApiGetInvoiceListInfoRequest ItemList(List<WechatMpInvoiceItem> fieldValue) {
        this.request.BodyJson("item_list", Json.Serialize<List<WechatMpInvoiceItem>>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
