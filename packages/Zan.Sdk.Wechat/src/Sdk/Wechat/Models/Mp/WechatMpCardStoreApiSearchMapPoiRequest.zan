using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardStoreApiSearchMapPoiRequest {
    WechatTypedRequest request;

    public WechatMpCardStoreApiSearchMapPoiRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCardStoreApiSearchMapPoiRequest DistrictId(string fieldValue) {
        this.request.BodyString("districtid", fieldValue);
        return this;
    }

    WechatMpCardStoreApiSearchMapPoiRequest Keyword(string fieldValue) {
        this.request.BodyString("keyword", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
