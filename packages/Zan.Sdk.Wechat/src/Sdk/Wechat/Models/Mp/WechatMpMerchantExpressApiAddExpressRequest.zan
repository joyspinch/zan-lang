using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpMerchantExpressApiAddExpressRequest {
    WechatTypedRequest request;

    public WechatMpMerchantExpressApiAddExpressRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpMerchantExpressApiAddExpressRequest DeliveryTemplate(string fieldValue) {
        this.request.BodyString("delivery_template", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
