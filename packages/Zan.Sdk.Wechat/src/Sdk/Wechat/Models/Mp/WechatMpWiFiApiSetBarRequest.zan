using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpWiFiApiSetBarRequest {
    WechatTypedRequest request;

    public WechatMpWiFiApiSetBarRequest() { this.request = new WechatTypedRequest(); }

    WechatMpWiFiApiSetBarRequest ShopId(long fieldValue) {
        this.request.BodyLong("shop_id", fieldValue);
        return this;
    }

    WechatMpWiFiApiSetBarRequest BarType(int fieldValue) {
        this.request.BodyInt("bar_type", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
