using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCustomApiSendMusicRequest {
    WechatTypedRequest request;

    public WechatMpCustomApiSendMusicRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCustomApiSendMusicRequest Title(string fieldValue) {
        this.request.BodyString("title", fieldValue);
        return this;
    }

    WechatMpCustomApiSendMusicRequest Description(string fieldValue) {
        this.request.BodyString("description", fieldValue);
        return this;
    }

    WechatMpCustomApiSendMusicRequest MusicUrl(string fieldValue) {
        this.request.BodyString("musicurl", fieldValue);
        return this;
    }

    WechatMpCustomApiSendMusicRequest HqMusicUrl(string fieldValue) {
        this.request.BodyString("hqmusicurl", fieldValue);
        return this;
    }

    WechatMpCustomApiSendMusicRequest ThumbMediaId(string fieldValue) {
        this.request.BodyString("thumb_media_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
