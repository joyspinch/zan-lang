using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiCardConsumeRequest {
    WechatTypedRequest request;

    public WechatMpCardApiCardConsumeRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCardApiCardConsumeRequest Code(string fieldValue) {
        this.request.BodyString("code", fieldValue);
        return this;
    }

    WechatMpCardApiCardConsumeRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
