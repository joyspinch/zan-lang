using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpInvoiceApiUpdateInvoiceStatusRequest {
    WechatTypedRequest request;

    public WechatMpInvoiceApiUpdateInvoiceStatusRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpInvoiceApiUpdateInvoiceStatusRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    public WechatMpInvoiceApiUpdateInvoiceStatusRequest EncryptCode(string fieldValue) {
        this.request.BodyString("encrypt_code", fieldValue);
        return this;
    }

    public WechatMpInvoiceApiUpdateInvoiceStatusRequest ReimburseStatus(int fieldValue) {
        this.request.BodyInt("reimburse_status", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
