using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiAddCardAfterPayRequest {
    WechatTypedRequest request;

    public WechatMpCardApiAddCardAfterPayRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCardApiAddCardAfterPayRequest RuleInfo(WechatMpRuleInfo fieldValue) {
        this.request.BodyJson("rule_info", Json.Serialize<WechatMpRuleInfo>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
