using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpMerchantProductApiDeleteProductRequest {
    WechatTypedRequest request;

    public WechatMpMerchantProductApiDeleteProductRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpMerchantProductApiDeleteProductRequest ProductId(string fieldValue) {
        this.request.BodyString("product_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
