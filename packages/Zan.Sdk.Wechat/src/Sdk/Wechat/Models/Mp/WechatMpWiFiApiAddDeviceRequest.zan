using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpWiFiApiAddDeviceRequest {
    WechatTypedRequest request;

    public WechatMpWiFiApiAddDeviceRequest() { this.request = new WechatTypedRequest(); }

    WechatMpWiFiApiAddDeviceRequest ShopId(long fieldValue) {
        this.request.BodyLong("shop_id", fieldValue);
        return this;
    }

    WechatMpWiFiApiAddDeviceRequest Ssid(string fieldValue) {
        this.request.BodyString("ssid", fieldValue);
        return this;
    }

    WechatMpWiFiApiAddDeviceRequest Password(string fieldValue) {
        this.request.BodyString("password", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
