using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiApiConfirmAuthorizationRequest {
    WechatTypedRequest request;

    public WechatMpCardApiApiConfirmAuthorizationRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCardApiApiConfirmAuthorizationRequest ComponentAppid(string fieldValue) {
        this.request.QueryString("component_appid", fieldValue);
        return this;
    }

    public WechatMpCardApiApiConfirmAuthorizationRequest AuthorizerAppid(string fieldValue) {
        this.request.BodyString("authorizer_appid", fieldValue);
        return this;
    }

    public WechatMpCardApiApiConfirmAuthorizationRequest FuncscopeCategoryId(int fieldValue) {
        this.request.BodyInt("funcscope_category_id", fieldValue);
        return this;
    }

    public WechatMpCardApiApiConfirmAuthorizationRequest ConfirmValue(int fieldValue) {
        this.request.BodyInt("confirm_value", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
