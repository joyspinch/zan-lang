using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCustomServiceApiCreateSessionRequest {
    WechatTypedRequest request;

    public WechatMpCustomServiceApiCreateSessionRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCustomServiceApiCreateSessionRequest OpenId(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    WechatMpCustomServiceApiCreateSessionRequest KfAccount(string fieldValue) {
        this.request.BodyString("kf_account", fieldValue);
        return this;
    }

    WechatMpCustomServiceApiCreateSessionRequest Text(string fieldValue) {
        this.request.BodyString("text", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
