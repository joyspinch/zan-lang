using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpNonTaxPayApiRefundRequest {
    WechatTypedRequest request;

    public WechatMpNonTaxPayApiRefundRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpNonTaxPayApiRefundRequest Appid(string fieldValue) {
        this.request.BodyString("appid", fieldValue);
        return this;
    }

    public WechatMpNonTaxPayApiRefundRequest OrderId(string fieldValue) {
        this.request.BodyString("order_id", fieldValue);
        return this;
    }

    public WechatMpNonTaxPayApiRefundRequest Reason(string fieldValue) {
        this.request.BodyString("reason", fieldValue);
        return this;
    }

    public WechatMpNonTaxPayApiRefundRequest RefundFee(long fieldValue) {
        this.request.BodyLong("refund_fee", fieldValue);
        return this;
    }

    public WechatMpNonTaxPayApiRefundRequest RefundOutId(string fieldValue) {
        this.request.BodyString("refund_out_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
