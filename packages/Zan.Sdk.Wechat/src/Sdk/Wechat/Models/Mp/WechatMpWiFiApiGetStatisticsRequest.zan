using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpWiFiApiGetStatisticsRequest {
    WechatTypedRequest request;

    public WechatMpWiFiApiGetStatisticsRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpWiFiApiGetStatisticsRequest BeginDate(string fieldValue) {
        this.request.BodyString("begin_date", fieldValue);
        return this;
    }

    public WechatMpWiFiApiGetStatisticsRequest EndDate(string fieldValue) {
        this.request.BodyString("end_date", fieldValue);
        return this;
    }

    public WechatMpWiFiApiGetStatisticsRequest ShopId(long fieldValue) {
        this.request.BodyLong("shop_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
