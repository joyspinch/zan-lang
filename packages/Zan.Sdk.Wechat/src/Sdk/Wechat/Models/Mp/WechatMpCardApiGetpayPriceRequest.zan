using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiGetpayPriceRequest {
    WechatTypedRequest request;

    public WechatMpCardApiGetpayPriceRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCardApiGetpayPriceRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    WechatMpCardApiGetpayPriceRequest Quantity(int fieldValue) {
        this.request.BodyInt("quantity", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
