using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCustomApiSendVoiceRequest {
    WechatTypedRequest request;

    public WechatMpCustomApiSendVoiceRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCustomApiSendVoiceRequest OpenId(string fieldValue) {
        this.request.BodyString("touser", fieldValue);
        return this;
    }

    public WechatMpCustomApiSendVoiceRequest MediaId(string fieldValue) {
        this.request.BodyString("voice", fieldValue);
        return this;
    }

    public WechatMpCustomApiSendVoiceRequest KfAccount(string fieldValue) {
        this.request.BodyString("CustomService", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
