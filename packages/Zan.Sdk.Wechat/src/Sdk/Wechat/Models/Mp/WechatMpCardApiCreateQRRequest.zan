using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiCreateQRRequest {
    WechatTypedRequest request;

    public WechatMpCardApiCreateQRRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCardApiCreateQRRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    public WechatMpCardApiCreateQRRequest Code(string fieldValue) {
        this.request.BodyString("code", fieldValue);
        return this;
    }

    public WechatMpCardApiCreateQRRequest OpenId(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    public WechatMpCardApiCreateQRRequest OuterId(string fieldValue) {
        this.request.BodyString("outer_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
