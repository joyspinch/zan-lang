using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpWiFiApiDeleteDeviceRequest {
    WechatTypedRequest request;

    public WechatMpWiFiApiDeleteDeviceRequest() { this.request = new WechatTypedRequest(); }

    WechatMpWiFiApiDeleteDeviceRequest Bssid(string fieldValue) {
        this.request.BodyString("bssid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
