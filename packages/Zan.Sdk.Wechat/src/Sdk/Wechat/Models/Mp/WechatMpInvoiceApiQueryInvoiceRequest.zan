using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpInvoiceApiQueryInvoiceRequest {
    WechatTypedRequest request;

    public WechatMpInvoiceApiQueryInvoiceRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpInvoiceApiQueryInvoiceRequest Fpqqlsh(string fieldValue) {
        this.request.BodyString("fpqqlsh", fieldValue);
        return this;
    }

    public WechatMpInvoiceApiQueryInvoiceRequest Nsrsbh(string fieldValue) {
        this.request.BodyString("nsrsbh", fieldValue);
