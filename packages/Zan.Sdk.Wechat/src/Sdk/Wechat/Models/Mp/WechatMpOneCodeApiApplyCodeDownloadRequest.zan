using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpOneCodeApiApplyCodeDownloadRequest {
    WechatTypedRequest request;

    public WechatMpOneCodeApiApplyCodeDownloadRequest() { this.request = new WechatTypedRequest(); }

    WechatMpOneCodeApiApplyCodeDownloadRequest ApplicationId(long fieldValue) {
        this.request.BodyLong("application_id", fieldValue);
        return this;
    }

    WechatMpOneCodeApiApplyCodeDownloadRequest CodeStart(long fieldValue) {
        this.request.BodyLong("code_start", fieldValue);
        return this;
    }

    WechatMpOneCodeApiApplyCodeDownloadRequest CodeEnd(long fieldValue) {
        this.request.BodyLong("code_end", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
