using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiBindToGiftCardRequest {
    WechatTypedRequest request;

    public WechatMpCardApiBindToGiftCardRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCardApiBindToGiftCardRequest SubId(string fieldValue) {
        this.request.BodyString("sub_mch_id", fieldValue);
        return this;
    }

    public WechatMpCardApiBindToGiftCardRequest WxaAppId(string fieldValue) {
        this.request.BodyString("wxa_appid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
