using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpShakeAroundApiRegisterRequest {
    WechatTypedRequest request;

    public WechatMpShakeAroundApiRegisterRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpShakeAroundApiRegisterRequest Name(string fieldValue) {
        this.request.BodyString("name", fieldValue);
        return this;
    }

    public WechatMpShakeAroundApiRegisterRequest PhoneNumber(string fieldValue) {
        this.request.BodyString("phone_number", fieldValue);
        return this;
    }

    public WechatMpShakeAroundApiRegisterRequest Email(string fieldValue) {
        this.request.BodyString("email", fieldValue);
        return this;
    }

    public WechatMpShakeAroundApiRegisterRequest QualificationCertUrls(List<string> fieldValue) {
        this.request.BodyStrings("qualification_cert_urls", fieldValue);
        return this;
    }

    public WechatMpShakeAroundApiRegisterRequest ApplyReason(string fieldValue) {
        this.request.BodyString("apply_reason", fieldValue);
        return this;
    }

    public WechatMpShakeAroundApiRegisterRequest IndustryId(string fieldValue) {
        this.request.BodyString("industry_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
