using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpScanApiTestWhiteListSetRequest {
    WechatTypedRequest request;

    public WechatMpScanApiTestWhiteListSetRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpScanApiTestWhiteListSetRequest OpenId(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    public WechatMpScanApiTestWhiteListSetRequest UserName(string fieldValue) {
        this.request.BodyString("userName", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
