using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpWxaApiModifyMerchantRequest {
    WechatTypedRequest request;

    public WechatMpWxaApiModifyMerchantRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpWxaApiModifyMerchantRequest HeadimgMediaid(string fieldValue) {
        this.request.BodyString("headimg_mediaid", fieldValue);
        return this;
    }

    public WechatMpWxaApiModifyMerchantRequest Intro(string fieldValue) {
        this.request.BodyString("intro", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
