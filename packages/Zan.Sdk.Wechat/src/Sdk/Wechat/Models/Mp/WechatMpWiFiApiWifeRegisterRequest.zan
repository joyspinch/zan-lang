using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpWiFiApiWifeRegisterRequest {
    WechatTypedRequest request;

    public WechatMpWiFiApiWifeRegisterRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpWiFiApiWifeRegisterRequest ShopId(long fieldValue) {
        this.request.BodyLong("shop_id", fieldValue);
        return this;
    }

    public WechatMpWiFiApiWifeRegisterRequest Ssid(string fieldValue) {
        this.request.BodyString("ssid", fieldValue);
        return this;
    }

    public WechatMpWiFiApiWifeRegisterRequest Reset(string fieldValue) {
        this.request.BodyString("reset", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
