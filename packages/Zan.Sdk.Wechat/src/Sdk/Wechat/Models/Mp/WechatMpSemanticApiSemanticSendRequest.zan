using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpSemanticApiSemanticSendRequest {
    WechatTypedRequest request;

    public WechatMpSemanticApiSemanticSendRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpSemanticApiSemanticSendRequest Query(string fieldValue) {
        this.request.BodyString("query", fieldValue);
        return this;
    }

    public WechatMpSemanticApiSemanticSendRequest Category(string fieldValue) {
        this.request.BodyString("category", fieldValue);
        return this;
    }

    public WechatMpSemanticApiSemanticSendRequest Latitude(double fieldValue) {
        this.request.BodyDouble("latitude", fieldValue);
        return this;
    }

    public WechatMpSemanticApiSemanticSendRequest Longitude(double fieldValue) {
        this.request.BodyDouble("longitude", fieldValue);
        return this;
    }

    public WechatMpSemanticApiSemanticSendRequest City(string fieldValue) {
        this.request.BodyString("city", fieldValue);
        return this;
    }

    public WechatMpSemanticApiSemanticSendRequest Region(string fieldValue) {
        this.request.BodyString("region", fieldValue);
        return this;
    }

    public WechatMpSemanticApiSemanticSendRequest Appid(string fieldValue) {
        this.request.BodyString("appid", fieldValue);
        return this;
    }

    public WechatMpSemanticApiSemanticSendRequest Uid(string fieldValue) {
        this.request.BodyString("uid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
