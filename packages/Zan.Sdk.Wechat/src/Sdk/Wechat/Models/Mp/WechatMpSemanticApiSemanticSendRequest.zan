using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpSemanticApiSemanticSendRequest {
    WechatTypedRequest request;

    public WechatMpSemanticApiSemanticSendRequest() { this.request = new WechatTypedRequest(); }

    WechatMpSemanticApiSemanticSendRequest Query(string fieldValue) {
        this.request.BodyString("query", fieldValue);
        return this;
    }

    WechatMpSemanticApiSemanticSendRequest Category(string fieldValue) {
        this.request.BodyString("category", fieldValue);
        return this;
    }

    WechatMpSemanticApiSemanticSendRequest Latitude(double fieldValue) {
        this.request.BodyDouble("latitude", fieldValue);
        return this;
    }

    WechatMpSemanticApiSemanticSendRequest Longitude(double fieldValue) {
        this.request.BodyDouble("longitude", fieldValue);
        return this;
    }

    WechatMpSemanticApiSemanticSendRequest City(string fieldValue) {
        this.request.BodyString("city", fieldValue);
        return this;
    }

    WechatMpSemanticApiSemanticSendRequest Region(string fieldValue) {
        this.request.BodyString("region", fieldValue);
        return this;
    }

    WechatMpSemanticApiSemanticSendRequest Appid(string fieldValue) {
        this.request.BodyString("appid", fieldValue);
        return this;
    }

    WechatMpSemanticApiSemanticSendRequest Uid(string fieldValue) {
        this.request.BodyString("uid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
