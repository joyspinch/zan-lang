using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpDraftApiSwitchRequest {
    WechatTypedRequest request;

    public WechatMpDraftApiSwitchRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpDraftApiSwitchRequest CheckOnly(bool fieldValue) {
        this.request.BodyBool("checkOnly", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
