using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCVImageApiQrCodeRequest {
    WechatTypedRequest request;

    public WechatMpCVImageApiQrCodeRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCVImageApiQrCodeRequest ImgUrl(string fieldValue) {
        this.request.QueryString("img_url", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
