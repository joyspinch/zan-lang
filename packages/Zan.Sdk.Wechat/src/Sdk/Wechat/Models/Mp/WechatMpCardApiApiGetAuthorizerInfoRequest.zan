using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiApiGetAuthorizerInfoRequest {
    WechatTypedRequest request;

    public WechatMpCardApiApiGetAuthorizerInfoRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCardApiApiGetAuthorizerInfoRequest ComponentAppid(string fieldValue) {
        this.request.QueryString("component_appid", fieldValue);
        return this;
    }

    WechatMpCardApiApiGetAuthorizerInfoRequest AuthorizerAppid(string fieldValue) {
        this.request.BodyString("authorizer_appid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
