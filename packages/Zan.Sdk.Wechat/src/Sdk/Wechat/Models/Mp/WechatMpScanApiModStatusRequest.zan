using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpScanApiModStatusRequest {
    WechatTypedRequest request;

    public WechatMpScanApiModStatusRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpScanApiModStatusRequest KeyStandard(string fieldValue) {
        this.request.BodyString("keystandard", fieldValue);
        return this;
    }

    public WechatMpScanApiModStatusRequest KeyStr(string fieldValue) {
        this.request.BodyString("keystr", fieldValue);
        return this;
    }

    public WechatMpScanApiModStatusRequest Status(string fieldValue) {
        this.request.BodyString("status", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
