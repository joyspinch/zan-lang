using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpWiFiApiOpenPluginTokenRequest {
    WechatTypedRequest request;

    public WechatMpWiFiApiOpenPluginTokenRequest() { this.request = new WechatTypedRequest(); }

    WechatMpWiFiApiOpenPluginTokenRequest CallBackUrl(string fieldValue) {
        this.request.QueryString("callBackUrl", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
