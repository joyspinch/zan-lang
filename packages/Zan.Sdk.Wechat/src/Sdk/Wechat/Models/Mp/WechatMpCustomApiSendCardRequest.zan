using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCustomApiSendCardRequest {
    WechatTypedRequest request;

    public WechatMpCustomApiSendCardRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCustomApiSendCardRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    public WechatMpCustomApiSendCardRequest Code(string fieldValue) {
        this.request.BodyString("code", fieldValue);
        return this;
    }

    public WechatMpCustomApiSendCardRequest Openid(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    public WechatMpCustomApiSendCardRequest ExpireSeconds(string fieldValue) {
        this.request.BodyString("expire_seconds", fieldValue);
        return this;
    }

    public WechatMpCustomApiSendCardRequest IsUniqueCode(bool fieldValue) {
        this.request.BodyBool("is_unique_code", fieldValue);
        return this;
    }

    public WechatMpCustomApiSendCardRequest OuterStr(string fieldValue) {
        this.request.BodyString("outer_str", fieldValue);
        return this;
    }

    public WechatMpCustomApiSendCardRequest OpenId(string fieldValue) {
        this.request.BodyString("openId", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
