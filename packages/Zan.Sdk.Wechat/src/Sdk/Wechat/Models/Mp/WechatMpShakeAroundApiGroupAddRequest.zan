using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpShakeAroundApiGroupAddRequest {
    WechatTypedRequest request;

    public WechatMpShakeAroundApiGroupAddRequest() { this.request = new WechatTypedRequest(); }

    WechatMpShakeAroundApiGroupAddRequest GroupName(string fieldValue) {
        this.request.BodyString("group_name", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
