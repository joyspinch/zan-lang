using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpGroupsApiGetIdRequest {
    WechatTypedRequest request;

    public WechatMpGroupsApiGetIdRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpGroupsApiGetIdRequest OpenId(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
