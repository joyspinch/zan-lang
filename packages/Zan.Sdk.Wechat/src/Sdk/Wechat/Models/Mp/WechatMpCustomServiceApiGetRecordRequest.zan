using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCustomServiceApiGetRecordRequest {
    WechatTypedRequest request;

    public WechatMpCustomServiceApiGetRecordRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCustomServiceApiGetRecordRequest StartTime(string fieldValue) {
        this.request.BodyString("starttime", fieldValue);
        return this;
    }

    WechatMpCustomServiceApiGetRecordRequest EndTime(string fieldValue) {
        this.request.BodyString("endtime", fieldValue);
        return this;
    }

    WechatMpCustomServiceApiGetRecordRequest PageSize(int fieldValue) {
        this.request.BodyInt("pagesize", fieldValue);
        return this;
    }

    WechatMpCustomServiceApiGetRecordRequest PageIndex(int fieldValue) {
        this.request.BodyInt("pageindex", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
