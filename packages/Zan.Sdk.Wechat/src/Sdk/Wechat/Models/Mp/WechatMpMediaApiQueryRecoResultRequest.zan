using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpMediaApiQueryRecoResultRequest {
    WechatTypedRequest request;

    public WechatMpMediaApiQueryRecoResultRequest() { this.request = new WechatTypedRequest(); }

    WechatMpMediaApiQueryRecoResultRequest VoiceId(string fieldValue) {
        this.request.BodyString("voice_id", fieldValue);
        return this;
    }

    WechatMpMediaApiQueryRecoResultRequest Lang(string fieldValue) {
        this.request.BodyString("lang", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
