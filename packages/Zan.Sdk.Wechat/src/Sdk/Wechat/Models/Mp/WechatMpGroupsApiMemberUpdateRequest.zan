using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpGroupsApiMemberUpdateRequest {
    WechatTypedRequest request;

    public WechatMpGroupsApiMemberUpdateRequest() { this.request = new WechatTypedRequest(); }

    WechatMpGroupsApiMemberUpdateRequest OpenId(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    WechatMpGroupsApiMemberUpdateRequest ToGroupId(int fieldValue) {
        this.request.BodyInt("to_groupid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
