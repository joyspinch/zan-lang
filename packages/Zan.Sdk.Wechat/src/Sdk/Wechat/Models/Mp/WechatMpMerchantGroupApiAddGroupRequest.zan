using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpMerchantGroupApiAddGroupRequest {
    WechatTypedRequest request;

    public WechatMpMerchantGroupApiAddGroupRequest() { this.request = new WechatTypedRequest(); }

    WechatMpMerchantGroupApiAddGroupRequest GroupDetail(WechatMpGroupDetail fieldValue) {
        this.request.BodyJson("group_detail", Json.Serialize<WechatMpGroupDetail>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
