using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiUserinfoGetRequest {
    WechatTypedRequest request;

    public WechatMpCardApiUserinfoGetRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCardApiUserinfoGetRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    WechatMpCardApiUserinfoGetRequest Code(string fieldValue) {
        this.request.BodyString("code", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
