using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCommentApiReplyDeleteRequest {
    WechatTypedRequest request;

    public WechatMpCommentApiReplyDeleteRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCommentApiReplyDeleteRequest MsgDataId(long fieldValue) {
        this.request.BodyLong("msg_data_id", fieldValue);
        return this;
    }

    public WechatMpCommentApiReplyDeleteRequest Index(long fieldValue) {
        this.request.BodyLong("index", fieldValue);
        return this;
    }

    public WechatMpCommentApiReplyDeleteRequest UserCommentId(long fieldValue) {
        this.request.BodyLong("user_comment_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
