using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiAuthoritySetRequest {
    WechatTypedRequest request;

    public WechatMpCardApiAuthoritySetRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCardApiAuthoritySetRequest OpenIds(List<string> fieldValue) {
        this.request.BodyStrings("openid", fieldValue);
        return this;
    }

    public WechatMpCardApiAuthoritySetRequest UserNames(List<string> fieldValue) {
        this.request.BodyStrings("username", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
