using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiShelfCreateRequest {
    WechatTypedRequest request;

    public WechatMpCardApiShelfCreateRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCardApiShelfCreateRequest Banner(string fieldValue) {
        this.request.BodyString("banner", fieldValue);
        return this;
    }

    public WechatMpCardApiShelfCreateRequest PageTitle(string fieldValue) {
        this.request.BodyString("page_title", fieldValue);
        return this;
    }

    public WechatMpCardApiShelfCreateRequest CanShare(bool fieldValue) {
        this.request.BodyBool("can_share", fieldValue);
        return this;
    }

    public WechatMpCardApiShelfCreateRequest Scene(int fieldValue) {
        this.request.BodyInt("scene", fieldValue);
        return this;
    }

    public WechatMpCardApiShelfCreateRequest CardList(List<WechatMpShelfCreateDataCardList> fieldValue) {
        this.request.BodyJson("card_list", Json.Serialize<List<WechatMpShelfCreateDataCardList>>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
