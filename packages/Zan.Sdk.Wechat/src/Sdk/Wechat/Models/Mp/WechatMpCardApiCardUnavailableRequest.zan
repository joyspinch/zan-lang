using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiCardUnavailableRequest {
    WechatTypedRequest request;

    public WechatMpCardApiCardUnavailableRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCardApiCardUnavailableRequest Code(string fieldValue) {
        this.request.BodyString("code", fieldValue);
        return this;
    }

    public WechatMpCardApiCardUnavailableRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
