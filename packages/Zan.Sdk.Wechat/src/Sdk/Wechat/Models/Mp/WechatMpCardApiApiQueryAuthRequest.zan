using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiApiQueryAuthRequest {
    WechatTypedRequest request;

    public WechatMpCardApiApiQueryAuthRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCardApiApiQueryAuthRequest ComponentAppid(string fieldValue) {
        this.request.QueryString("component_appid", fieldValue);
        return this;
    }

    WechatMpCardApiApiQueryAuthRequest AuthorizationCode(string fieldValue) {
        this.request.BodyString("authorization_code", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
