using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCustomServiceApiGetMsgListRequest {
    WechatTypedRequest request;

    public WechatMpCustomServiceApiGetMsgListRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCustomServiceApiGetMsgListRequest StartTime(string fieldValue) {
        this.request.BodyString("starttime", fieldValue);
        return this;
    }

    public WechatMpCustomServiceApiGetMsgListRequest EndTime(string fieldValue) {
        this.request.BodyString("endtime", fieldValue);
        return this;
    }

    public WechatMpCustomServiceApiGetMsgListRequest MsgId(long fieldValue) {
        this.request.BodyLong("msgid", fieldValue);
        return this;
    }

    public WechatMpCustomServiceApiGetMsgListRequest Number(int fieldValue) {
        this.request.BodyInt("number", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
