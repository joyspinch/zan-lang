using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpQrCodeApiCreateRequest {
    WechatTypedRequest request;

    public WechatMpQrCodeApiCreateRequest() { this.request = new WechatTypedRequest(); }

    WechatMpQrCodeApiCreateRequest ExpireSeconds(int fieldValue) {
        this.request.BodyInt("expire_seconds", fieldValue);
        return this;
    }

    WechatMpQrCodeApiCreateRequest SceneId(int fieldValue) {
        this.request.BodyInt("action_info", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
