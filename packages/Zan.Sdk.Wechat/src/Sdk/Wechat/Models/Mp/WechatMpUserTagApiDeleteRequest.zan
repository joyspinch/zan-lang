using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpUserTagApiDeleteRequest {
    WechatTypedRequest request;

    public WechatMpUserTagApiDeleteRequest() { this.request = new WechatTypedRequest(); }

    WechatMpUserTagApiDeleteRequest Id(int fieldValue) {
        this.request.BodyInt("tag", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
