using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpInvoiceApiSetContactRequest {
    WechatTypedRequest request;

    public WechatMpInvoiceApiSetContactRequest() { this.request = new WechatTypedRequest(); }

    WechatMpInvoiceApiSetContactRequest Phone(string fieldValue) {
        this.request.QueryString("contact", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
