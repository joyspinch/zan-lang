using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpMerchantProductApiAddProductRequest {
    WechatTypedRequest request;

    public WechatMpMerchantProductApiAddProductRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpMerchantProductApiAddProductRequest ProductBase(WechatMpProductBase fieldValue) {
        this.request.BodyJson("product_base", Json.Serialize<WechatMpProductBase>(fieldValue));
        return this;
    }

    public WechatMpMerchantProductApiAddProductRequest SkuList(List<WechatMpSkuList> fieldValue) {
        this.request.BodyJson("sku_list", Json.Serialize<List<WechatMpSkuList>>(fieldValue));
        return this;
    }

    public WechatMpMerchantProductApiAddProductRequest Attrext(WechatMpAttrext fieldValue) {
        this.request.BodyJson("attrext", Json.Serialize<WechatMpAttrext>(fieldValue));
        return this;
    }

    public WechatMpMerchantProductApiAddProductRequest DeliveryInfo(WechatMpDeliveryInfo fieldValue) {
        this.request.BodyJson("delivery_info", Json.Serialize<WechatMpDeliveryInfo>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
