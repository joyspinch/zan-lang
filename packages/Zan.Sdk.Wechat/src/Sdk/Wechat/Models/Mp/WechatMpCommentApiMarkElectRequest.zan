using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCommentApiMarkElectRequest {
    WechatTypedRequest request;

    public WechatMpCommentApiMarkElectRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCommentApiMarkElectRequest MsgDataId(long fieldValue) {
        this.request.BodyLong("msg_data_id", fieldValue);
        return this;
    }

    WechatMpCommentApiMarkElectRequest Index(long fieldValue) {
        this.request.BodyLong("index", fieldValue);
        return this;
    }

    WechatMpCommentApiMarkElectRequest UserCommentId(long fieldValue) {
        this.request.BodyLong("user_comment_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
