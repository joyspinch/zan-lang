using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpUserTagApiUpdateRequest {
    WechatTypedRequest request;

    public WechatMpUserTagApiUpdateRequest() { this.request = new WechatTypedRequest(); }

    WechatMpUserTagApiUpdateRequest Id(int fieldValue) {
        this.request.BodyInt("id", fieldValue);
        return this;
    }

    WechatMpUserTagApiUpdateRequest Name(string fieldValue) {
        this.request.BodyString("name", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
