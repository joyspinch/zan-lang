using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpMerchantProductApiUpDateProductRequest {
    WechatTypedRequest request;

    public WechatMpMerchantProductApiUpDateProductRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpMerchantProductApiUpDateProductRequest ProductId(string fieldValue) {
        this.request.BodyString("product_id", fieldValue);
        return this;
    }

    public WechatMpMerchantProductApiUpDateProductRequest ProductBase(WechatMpProductBase fieldValue) {
        this.request.BodyJson("product_base", Json.Serialize<WechatMpProductBase>(fieldValue));
        return this;
    }

    public WechatMpMerchantProductApiUpDateProductRequest SkuList(List<WechatMpSkuList> fieldValue) {
        this.request.BodyJson("sku_list", Json.Serialize<List<WechatMpSkuList>>(fieldValue));
        return this;
    }

    public WechatMpMerchantProductApiUpDateProductRequest Attrext(WechatMpAttrext fieldValue) {
        this.request.BodyJson("attrext", Json.Serialize<WechatMpAttrext>(fieldValue));
        return this;
    }

    public WechatMpMerchantProductApiUpDateProductRequest DeliveryInfo(WechatMpDeliveryInfo fieldValue) {
        this.request.BodyJson("delivery_info", Json.Serialize<WechatMpDeliveryInfo>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
