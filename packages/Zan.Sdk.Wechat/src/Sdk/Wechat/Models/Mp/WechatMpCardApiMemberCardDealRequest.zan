using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiMemberCardDealRequest {
    WechatTypedRequest request;

    public WechatMpCardApiMemberCardDealRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCardApiMemberCardDealRequest Code(string fieldValue) {
        this.request.BodyString("code", fieldValue);
        return this;
    }

    WechatMpCardApiMemberCardDealRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    WechatMpCardApiMemberCardDealRequest RecordBonus(string fieldValue) {
        this.request.BodyString("record_bonus", fieldValue);
        return this;
    }

    WechatMpCardApiMemberCardDealRequest AddBonus(double fieldValue) {
        this.request.BodyDouble("add_bonus", fieldValue);
        return this;
    }

    WechatMpCardApiMemberCardDealRequest AddBalance(double fieldValue) {
        this.request.BodyDouble("add_balance", fieldValue);
        return this;
    }

    WechatMpCardApiMemberCardDealRequest RecordBalance(string fieldValue) {
        this.request.BodyString("record_balance", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
