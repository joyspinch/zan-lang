using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiUploadWxaCodeRequest {
    WechatTypedRequest request;

    public WechatMpCardApiUploadWxaCodeRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCardApiUploadWxaCodeRequest WxaAppId(string fieldValue) {
        this.request.BodyString("wxa_appid", fieldValue);
        return this;
    }

    public WechatMpCardApiUploadWxaCodeRequest PageId(string fieldValue) {
        this.request.BodyString("page_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
