using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpScanApiUpdateBrandRequest {
    WechatTypedRequest request;

    public WechatMpScanApiUpdateBrandRequest() { this.request = new WechatTypedRequest(); }

    WechatMpScanApiUpdateBrandRequest Keystandard(string fieldValue) {
        this.request.BodyString("keystandard", fieldValue);
        return this;
    }

    WechatMpScanApiUpdateBrandRequest Keystr(string fieldValue) {
        this.request.BodyString("keystr", fieldValue);
        return this;
    }

    WechatMpScanApiUpdateBrandRequest BrandInfo(WechatMpBrandInfo fieldValue) {
        this.request.BodyJson("brand_info", Json.Serialize<WechatMpBrandInfo>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
