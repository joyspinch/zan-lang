using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpWiFiApiShopListRequest {
    WechatTypedRequest request;

    public WechatMpWiFiApiShopListRequest() { this.request = new WechatTypedRequest(); }

    WechatMpWiFiApiShopListRequest PageIndex(int fieldValue) {
        this.request.BodyInt("pageindex", fieldValue);
        return this;
    }

    WechatMpWiFiApiShopListRequest PageSize(int fieldValue) {
        this.request.BodyInt("pagesize", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
