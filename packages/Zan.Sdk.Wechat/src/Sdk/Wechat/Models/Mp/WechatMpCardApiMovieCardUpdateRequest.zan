using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiMovieCardUpdateRequest {
    WechatTypedRequest request;

    public WechatMpCardApiMovieCardUpdateRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCardApiMovieCardUpdateRequest Code(string fieldValue) {
        this.request.BodyString("code", fieldValue);
        return this;
    }

    public WechatMpCardApiMovieCardUpdateRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    public WechatMpCardApiMovieCardUpdateRequest TicketClass(string fieldValue) {
        this.request.BodyString("ticket_class", fieldValue);
        return this;
    }

    public WechatMpCardApiMovieCardUpdateRequest ShowTime(string fieldValue) {
        this.request.BodyString("show_time", fieldValue);
        return this;
    }

    public WechatMpCardApiMovieCardUpdateRequest Duration(int fieldValue) {
        this.request.BodyInt("duration", fieldValue);
        return this;
    }

    public WechatMpCardApiMovieCardUpdateRequest ScreeningRoom(string fieldValue) {
        this.request.BodyString("screening_room", fieldValue);
        return this;
    }

    public WechatMpCardApiMovieCardUpdateRequest SeatNumbers(List<string> fieldValue) {
        this.request.BodyStrings("seat_number", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
