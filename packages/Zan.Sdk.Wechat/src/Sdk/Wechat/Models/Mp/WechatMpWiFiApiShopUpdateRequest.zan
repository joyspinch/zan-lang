using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpWiFiApiShopUpdateRequest {
    WechatTypedRequest request;

    public WechatMpWiFiApiShopUpdateRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpWiFiApiShopUpdateRequest ShopId(long fieldValue) {
        this.request.BodyLong("shop_id", fieldValue);
        return this;
    }

    public WechatMpWiFiApiShopUpdateRequest OldSsid(string fieldValue) {
        this.request.BodyString("old_ssid", fieldValue);
        return this;
    }

    public WechatMpWiFiApiShopUpdateRequest Ssid(string fieldValue) {
        this.request.BodyString("ssid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
