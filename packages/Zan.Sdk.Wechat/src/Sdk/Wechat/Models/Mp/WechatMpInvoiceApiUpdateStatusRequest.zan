using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpInvoiceApiUpdateStatusRequest {
    WechatTypedRequest request;

    public WechatMpInvoiceApiUpdateStatusRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpInvoiceApiUpdateStatusRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    public WechatMpInvoiceApiUpdateStatusRequest Code(string fieldValue) {
        this.request.BodyString("code", fieldValue);
        return this;
    }

    public WechatMpInvoiceApiUpdateStatusRequest ReimburseStatus(int fieldValue) {
        this.request.BodyInt("reimburse_status", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
