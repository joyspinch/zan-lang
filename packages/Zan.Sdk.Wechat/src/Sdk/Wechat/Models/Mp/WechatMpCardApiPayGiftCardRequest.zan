using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiPayGiftCardRequest {
    WechatTypedRequest request;

    public WechatMpCardApiPayGiftCardRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCardApiPayGiftCardRequest SubId(string fieldValue) {
        this.request.BodyString("sub_mch_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
