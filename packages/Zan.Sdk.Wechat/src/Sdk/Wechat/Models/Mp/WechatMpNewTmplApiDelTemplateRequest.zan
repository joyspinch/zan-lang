using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpNewTmplApiDelTemplateRequest {
    WechatTypedRequest request;

    public WechatMpNewTmplApiDelTemplateRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpNewTmplApiDelTemplateRequest PriTmplId(string fieldValue) {
        this.request.BodyString("priTmplId", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
