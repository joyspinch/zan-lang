using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpGroupsApiBatchUpdateRequest {
    WechatTypedRequest request;

    public WechatMpGroupsApiBatchUpdateRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpGroupsApiBatchUpdateRequest OpenIds(List<string> fieldValue) {
        this.request.BodyStrings("openid_list", fieldValue);
        return this;
    }

    public WechatMpGroupsApiBatchUpdateRequest ToGroupId(int fieldValue) {
        this.request.BodyInt("to_groupid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
