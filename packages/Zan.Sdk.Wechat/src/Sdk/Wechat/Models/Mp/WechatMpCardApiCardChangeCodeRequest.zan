using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiCardChangeCodeRequest {
    WechatTypedRequest request;

    public WechatMpCardApiCardChangeCodeRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCardApiCardChangeCodeRequest Code(string fieldValue) {
        this.request.BodyString("code", fieldValue);
        return this;
    }

    WechatMpCardApiCardChangeCodeRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    WechatMpCardApiCardChangeCodeRequest NewCode(string fieldValue) {
        this.request.BodyString("new_code", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
