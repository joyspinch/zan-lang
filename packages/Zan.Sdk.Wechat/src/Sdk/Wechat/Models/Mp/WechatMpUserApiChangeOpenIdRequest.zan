using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpUserApiChangeOpenIdRequest {
    WechatTypedRequest request;

    public WechatMpUserApiChangeOpenIdRequest() { this.request = new WechatTypedRequest(); }

    WechatMpUserApiChangeOpenIdRequest FromAppId(string fieldValue) {
        this.request.BodyString("from_appid", fieldValue);
        return this;
    }

    WechatMpUserApiChangeOpenIdRequest OpenIdList(List<string> fieldValue) {
        this.request.BodyStrings("openid_list", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
