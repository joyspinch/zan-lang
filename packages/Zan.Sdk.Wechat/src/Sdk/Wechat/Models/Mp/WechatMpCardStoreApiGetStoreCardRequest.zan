using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardStoreApiGetStoreCardRequest {
    WechatTypedRequest request;

    public WechatMpCardStoreApiGetStoreCardRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCardStoreApiGetStoreCardRequest PoiId(string fieldValue) {
        this.request.BodyString("poi_id", fieldValue);
