using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpDraftApiAddDraftRequest {
    WechatTypedRequest request;

    public WechatMpDraftApiAddDraftRequest() { this.request = new WechatTypedRequest(); }

    WechatMpDraftApiAddDraftRequest Draft(List<WechatMpDraftModel> fieldValue) {
        this.request.BodyJson("articles", Json.Serialize<List<WechatMpDraftModel>>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
