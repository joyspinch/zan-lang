using System;
using System.Text;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpSpecialProtocol {
    public static string MediaType(WechatMpMediaType mediaType) {
        if (mediaType == WechatMpMediaType.Image) { return "image"; }
        if (mediaType == WechatMpMediaType.Voice) { return "voice"; }
        if (mediaType == WechatMpMediaType.Video) { return "video"; }
        return "thumb";
    }

    public static bool LooksLikeJson(string body) {
        for (int i = 0; i < body.Length; i = i + 1) {
            int c = body[i] & 255;
            if (c != 32 && c != 9 && c != 10 && c != 13) {
                return c == 123;
            }
        }
        return false;
    }

    public static string VideoDescription(string title, string introduction) {
        JsonValue description = JsonValue.NewObject();
        description.Put("title", JsonValue.NewStr(title));
        description.Put("introduction", JsonValue.NewStr(introduction));
        return description.ToJson();
    }
}
