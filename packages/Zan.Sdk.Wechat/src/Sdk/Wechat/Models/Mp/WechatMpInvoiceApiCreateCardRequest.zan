using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpInvoiceApiCreateCardRequest {
    WechatTypedRequest request;

    public WechatMpInvoiceApiCreateCardRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpInvoiceApiCreateCardRequest BaseInfo(WechatMpInvoiceBaseInfo fieldValue) {
        this.request.BodyJson("base_info", Json.Serialize<WechatMpInvoiceBaseInfo>(fieldValue));
        return this;
    }

    public WechatMpInvoiceApiCreateCardRequest Payee(string fieldValue) {
        this.request.BodyString("payee", fieldValue);
        return this;
    }

    public WechatMpInvoiceApiCreateCardRequest Type(string fieldValue) {
        this.request.BodyString("type", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
