using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCommentApiCloseRequest {
    WechatTypedRequest request;

    public WechatMpCommentApiCloseRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCommentApiCloseRequest MsgDataId(long fieldValue) {
        this.request.BodyLong("msg_data_id", fieldValue);
        return this;
    }

    WechatMpCommentApiCloseRequest Index(long fieldValue) {
        this.request.BodyLong("index", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
