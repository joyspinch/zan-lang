using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpInvoiceApiScanTitleRequest {
    WechatTypedRequest request;

    public WechatMpInvoiceApiScanTitleRequest() { this.request = new WechatTypedRequest(); }

    WechatMpInvoiceApiScanTitleRequest ScanText(string fieldValue) {
        this.request.BodyString("scan_text", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
