using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpUserApiBatchBlackListRequest {
    WechatTypedRequest request;

    public WechatMpUserApiBatchBlackListRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpUserApiBatchBlackListRequest OpenidList(List<string> fieldValue) {
        this.request.BodyStrings("openid_list", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
