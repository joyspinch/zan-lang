using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiCheckCodeRequest {
    WechatTypedRequest request;

    public WechatMpCardApiCheckCodeRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCardApiCheckCodeRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    public WechatMpCardApiCheckCodeRequest CodeList(List<string> fieldValue) {
        this.request.BodyStrings("code", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
