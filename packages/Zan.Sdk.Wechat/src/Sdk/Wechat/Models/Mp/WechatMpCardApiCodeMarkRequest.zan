using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiCodeMarkRequest {
    WechatTypedRequest request;

    public WechatMpCardApiCodeMarkRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCardApiCodeMarkRequest Code(string fieldValue) {
        this.request.BodyString("code", fieldValue);
        return this;
    }

    WechatMpCardApiCodeMarkRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    WechatMpCardApiCodeMarkRequest OpenId(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    WechatMpCardApiCodeMarkRequest IsMark(string fieldValue) {
        this.request.BodyString("is_mark", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
