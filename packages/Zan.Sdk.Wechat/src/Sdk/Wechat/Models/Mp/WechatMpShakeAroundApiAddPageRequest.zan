using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpShakeAroundApiAddPageRequest {
    WechatTypedRequest request;

    public WechatMpShakeAroundApiAddPageRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpShakeAroundApiAddPageRequest Title(string fieldValue) {
        this.request.BodyString("title", fieldValue);
        return this;
    }

    public WechatMpShakeAroundApiAddPageRequest Description(string fieldValue) {
        this.request.BodyString("description", fieldValue);
        return this;
    }

    public WechatMpShakeAroundApiAddPageRequest PageUrl(string fieldValue) {
        this.request.BodyString("page_url", fieldValue);
        return this;
    }

    public WechatMpShakeAroundApiAddPageRequest Comment(string fieldValue) {
        this.request.BodyString("comment", fieldValue);
        return this;
    }

    public WechatMpShakeAroundApiAddPageRequest IconUrl(string fieldValue) {
        this.request.BodyString("icon_url", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
