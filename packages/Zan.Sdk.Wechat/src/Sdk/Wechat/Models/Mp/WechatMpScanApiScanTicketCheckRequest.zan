using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpScanApiScanTicketCheckRequest {
    WechatTypedRequest request;

    public WechatMpScanApiScanTicketCheckRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpScanApiScanTicketCheckRequest Ticket(string fieldValue) {
        this.request.BodyString("ticket", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
