using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCustomApiSendVideoRequest {
    WechatTypedRequest request;

    public WechatMpCustomApiSendVideoRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCustomApiSendVideoRequest MediaId(string fieldValue) {
        this.request.BodyString("media_id", fieldValue);
        return this;
    }

    WechatMpCustomApiSendVideoRequest ThumbMediaId(string fieldValue) {
        this.request.BodyString("thumb_media_id", fieldValue);
        return this;
    }

    WechatMpCustomApiSendVideoRequest Title(string fieldValue) {
        this.request.BodyString("title", fieldValue);
        return this;
    }

    WechatMpCustomApiSendVideoRequest Description(string fieldValue) {
        this.request.BodyString("description", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
