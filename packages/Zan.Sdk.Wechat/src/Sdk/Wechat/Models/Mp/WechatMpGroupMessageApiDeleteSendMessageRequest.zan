using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpGroupMessageApiDeleteSendMessageRequest {
    WechatTypedRequest request;

    public WechatMpGroupMessageApiDeleteSendMessageRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpGroupMessageApiDeleteSendMessageRequest MsgId(string fieldValue) {
        this.request.BodyString("msg_id", fieldValue);
        return this;
    }

    public WechatMpGroupMessageApiDeleteSendMessageRequest ArticleIdx(int fieldValue) {
        this.request.BodyInt("article_idx", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
