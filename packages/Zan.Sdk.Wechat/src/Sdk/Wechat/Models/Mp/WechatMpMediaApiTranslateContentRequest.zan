using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpMediaApiTranslateContentRequest {
    WechatTypedRequest request;

    public WechatMpMediaApiTranslateContentRequest() { this.request = new WechatTypedRequest(); }

    WechatMpMediaApiTranslateContentRequest Ifrom(string fieldValue) {
        this.request.BodyString("Ifrom", fieldValue);
        return this;
    }

    WechatMpMediaApiTranslateContentRequest Ito(string fieldValue) {
        this.request.BodyString("Ito", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
