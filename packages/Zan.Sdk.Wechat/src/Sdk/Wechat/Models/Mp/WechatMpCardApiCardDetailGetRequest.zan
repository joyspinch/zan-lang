using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiCardDetailGetRequest {
    WechatTypedRequest request;

    public WechatMpCardApiCardDetailGetRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCardApiCardDetailGetRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
