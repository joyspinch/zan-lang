using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiCodeDepositRequest {
    WechatTypedRequest request;

    public WechatMpCardApiCodeDepositRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCardApiCodeDepositRequest CardId(string fieldValue) {
        this.request.BodyString("card_id", fieldValue);
        return this;
    }

    public WechatMpCardApiCodeDepositRequest CodeList(List<string> fieldValue) {
        this.request.BodyStrings("code", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
