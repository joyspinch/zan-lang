using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpMerchantGroupApiPropertyModGroupRequest {
    WechatTypedRequest request;

    public WechatMpMerchantGroupApiPropertyModGroupRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpMerchantGroupApiPropertyModGroupRequest GroupId(int fieldValue) {
        this.request.BodyInt("group_id", fieldValue);
        return this;
    }

    public WechatMpMerchantGroupApiPropertyModGroupRequest GroupName(string fieldValue) {
        this.request.BodyString("group_name", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
