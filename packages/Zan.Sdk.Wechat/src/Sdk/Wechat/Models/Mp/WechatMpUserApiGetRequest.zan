using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpUserApiGetRequest {
    WechatTypedRequest request;

    public WechatMpUserApiGetRequest() { this.request = new WechatTypedRequest(); }

    WechatMpUserApiGetRequest NextOpenId(string fieldValue) {
        this.request.QueryString("nextOpenId", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
