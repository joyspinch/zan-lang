using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpPoiApiAddPoiRequest {
    WechatTypedRequest request;

    public WechatMpPoiApiAddPoiRequest() { this.request = new WechatTypedRequest(); }

    WechatMpPoiApiAddPoiRequest Business(WechatMpCreateStoreBusiness fieldValue) {
        this.request.BodyJson("business", Json.Serialize<WechatMpCreateStoreBusiness>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
