using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpOneCodeApiApplyCodeQueryRequest {
    WechatTypedRequest request;

    public WechatMpOneCodeApiApplyCodeQueryRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpOneCodeApiApplyCodeQueryRequest ApplicationId(long fieldValue) {
        this.request.BodyLong("application_id", fieldValue);
        return this;
    }

    public WechatMpOneCodeApiApplyCodeQueryRequest IsvApplicationId(string fieldValue) {
        this.request.BodyString("isv_application_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
