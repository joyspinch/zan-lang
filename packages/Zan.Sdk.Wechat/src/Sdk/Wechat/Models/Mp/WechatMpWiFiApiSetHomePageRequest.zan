using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpWiFiApiSetHomePageRequest {
    WechatTypedRequest request;

    public WechatMpWiFiApiSetHomePageRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpWiFiApiSetHomePageRequest ShopId(long fieldValue) {
        this.request.BodyLong("shop_id", fieldValue);
        return this;
    }

    public WechatMpWiFiApiSetHomePageRequest Url(string fieldValue) {
        this.request.BodyString("@struct", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
