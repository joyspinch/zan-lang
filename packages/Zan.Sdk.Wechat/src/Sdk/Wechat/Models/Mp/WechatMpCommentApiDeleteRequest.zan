using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCommentApiDeleteRequest {
    WechatTypedRequest request;

    public WechatMpCommentApiDeleteRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCommentApiDeleteRequest MsgDataId(long fieldValue) {
        this.request.BodyLong("msg_data_id", fieldValue);
        return this;
    }

    public WechatMpCommentApiDeleteRequest Index(long fieldValue) {
        this.request.BodyLong("index", fieldValue);
        return this;
    }

    public WechatMpCommentApiDeleteRequest UserCommentId(long fieldValue) {
        this.request.BodyLong("user_comment_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
