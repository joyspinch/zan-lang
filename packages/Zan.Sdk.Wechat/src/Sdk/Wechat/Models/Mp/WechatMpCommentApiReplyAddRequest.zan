using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCommentApiReplyAddRequest {
    WechatTypedRequest request;

    public WechatMpCommentApiReplyAddRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpCommentApiReplyAddRequest MsgDataId(long fieldValue) {
        this.request.BodyLong("msg_data_id", fieldValue);
        return this;
    }

    public WechatMpCommentApiReplyAddRequest Index(long fieldValue) {
        this.request.BodyLong("index", fieldValue);
        return this;
    }

    public WechatMpCommentApiReplyAddRequest UserCommentId(long fieldValue) {
        this.request.BodyLong("user_comment_id", fieldValue);
        return this;
    }

    public WechatMpCommentApiReplyAddRequest Content(string fieldValue) {
        this.request.BodyString("content", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
