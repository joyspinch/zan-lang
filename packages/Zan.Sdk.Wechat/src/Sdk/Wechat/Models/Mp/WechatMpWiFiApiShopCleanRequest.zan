using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpWiFiApiShopCleanRequest {
    WechatTypedRequest request;

    public WechatMpWiFiApiShopCleanRequest() { this.request = new WechatTypedRequest(); }

    WechatMpWiFiApiShopCleanRequest ShopId(long fieldValue) {
        this.request.BodyLong("shop_id", fieldValue);
        return this;
    }

    WechatMpWiFiApiShopCleanRequest Ssid(string fieldValue) {
        this.request.BodyString("ssid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
