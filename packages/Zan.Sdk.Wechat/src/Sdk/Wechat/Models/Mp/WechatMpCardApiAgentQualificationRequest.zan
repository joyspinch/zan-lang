using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCardApiAgentQualificationRequest {
    WechatTypedRequest request;

    public WechatMpCardApiAgentQualificationRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCardApiAgentQualificationRequest RegisterCapital(string fieldValue) {
        this.request.BodyString("register_capital", fieldValue);
        return this;
    }

    WechatMpCardApiAgentQualificationRequest BusinessLicenseMediaid(string fieldValue) {
        this.request.BodyString("business_license_media_id", fieldValue);
        return this;
    }

    WechatMpCardApiAgentQualificationRequest TaxRegistRationCertificateMediaid(string fieldValue) {
        this.request.BodyString("tax_registration_certificate_media_id", fieldValue);
        return this;
    }

    WechatMpCardApiAgentQualificationRequest LastQuarterTaxListingMediaid(string fieldValue) {
        this.request.BodyString("last_quarter_tax_listing_media_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
