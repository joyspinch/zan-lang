using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpShakeAroundApiGroupUpdateRequest {
    WechatTypedRequest request;

    public WechatMpShakeAroundApiGroupUpdateRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpShakeAroundApiGroupUpdateRequest Groupid(string fieldValue) {
        this.request.BodyString("group_id", fieldValue);
        return this;
    }

    public WechatMpShakeAroundApiGroupUpdateRequest GroupName(string fieldValue) {
        this.request.BodyString("group_name", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
