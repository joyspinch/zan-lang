using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCustomServiceApiDeleteCustomRequest {
    WechatTypedRequest request;

    public WechatMpCustomServiceApiDeleteCustomRequest() { this.request = new WechatTypedRequest(); }

    WechatMpCustomServiceApiDeleteCustomRequest KfAccount(string fieldValue) {
        this.request.QueryString("kf_account", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
