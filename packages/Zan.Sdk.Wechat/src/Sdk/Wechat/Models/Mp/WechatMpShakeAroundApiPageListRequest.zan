namespace Sdk.Wechat.Mp;

public class WechatMpShakeAroundApiPageListRequest {
    WechatTypedRequest request;

    public WechatMpShakeAroundApiPageListRequest() { this.request = new WechatTypedRequest(); }

    public WechatMpShakeAroundApiPageListRequest Date(long fieldValue) {
        this.request.BodyLong("date", fieldValue);
