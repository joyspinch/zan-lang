using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenSecOrderApiUploadShippingInfoRequest {
    WechatTypedRequest request;

    public WechatWxOpenSecOrderApiUploadShippingInfoRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenSecOrderApiUploadShippingInfoRequest OrderKey(WechatWxOpenOrderKeyModel fieldValue) {
        this.request.BodyJson("order_key", Json.Serialize<WechatWxOpenOrderKeyModel>(fieldValue));
        return this;
    }

    WechatWxOpenSecOrderApiUploadShippingInfoRequest LogisticsType(int fieldValue) {
        this.request.BodyInt("logistics_type", fieldValue);
        return this;
    }

    WechatWxOpenSecOrderApiUploadShippingInfoRequest DeliveryMode(int fieldValue) {
        this.request.BodyInt("delivery_mode", fieldValue);
        return this;
    }

    WechatWxOpenSecOrderApiUploadShippingInfoRequest IsAllDelivered(bool fieldValue) {
        this.request.BodyBool("is_all_delivered", fieldValue);
        return this;
    }

    WechatWxOpenSecOrderApiUploadShippingInfoRequest ShippingList(List<WechatWxOpenShippingListModel> fieldValue) {
        this.request.BodyJson("shipping_list", Json.Serialize<List<WechatWxOpenShippingListModel>>(fieldValue));
        return this;
    }

    WechatWxOpenSecOrderApiUploadShippingInfoRequest UploadTime(string fieldValue) {
        this.request.BodyString("upload_time", fieldValue);
        return this;
    }

    WechatWxOpenSecOrderApiUploadShippingInfoRequest Payer(WechatWxOpenPayerModel fieldValue) {
        this.request.BodyJson("payer", Json.Serialize<WechatWxOpenPayerModel>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
