using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenNovelApiDeleteChapterRequest {
    WechatTypedRequest request;

    public WechatWxOpenNovelApiDeleteChapterRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenNovelApiDeleteChapterRequest BookId(string fieldValue) {
        this.request.BodyString("book_id", fieldValue);
        return this;
    }

    public WechatWxOpenNovelApiDeleteChapterRequest ChapterId(string fieldValue) {
        this.request.BodyString("chapter_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
