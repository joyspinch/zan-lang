using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenCustomServiceKfWorkApiBindRequest {
    WechatTypedRequest request;

    public WechatWxOpenCustomServiceKfWorkApiBindRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenCustomServiceKfWorkApiBindRequest CorpId(string fieldValue) {
        this.request.BodyString("corpid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
