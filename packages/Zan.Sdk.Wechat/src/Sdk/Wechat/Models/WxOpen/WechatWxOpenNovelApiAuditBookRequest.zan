using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenNovelApiAuditBookRequest {
    WechatTypedRequest request;

    public WechatWxOpenNovelApiAuditBookRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenNovelApiAuditBookRequest BookId(string fieldValue) {
        this.request.BodyString("book_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
