using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenXPayApiGetComplaintDetailRequest {
    WechatTypedRequest request;

    public WechatWxOpenXPayApiGetComplaintDetailRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenXPayApiGetComplaintDetailRequest ComplaintId(string fieldValue) {
        this.request.BodyString("complaint_id", fieldValue);
        return this;
    }

    public WechatWxOpenXPayApiGetComplaintDetailRequest Env(int fieldValue) {
        this.request.BodyInt("env", fieldValue);
        return this;
    }

    public WechatWxOpenXPayApiGetComplaintDetailRequest PaySig(string fieldValue) {
        this.request.QueryString("pay_sig", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
