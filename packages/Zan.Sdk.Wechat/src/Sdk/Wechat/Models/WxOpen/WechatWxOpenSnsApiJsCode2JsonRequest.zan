using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenSnsApiJsCode2JsonRequest {
    WechatTypedRequest request;

    public WechatWxOpenSnsApiJsCode2JsonRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenSnsApiJsCode2JsonRequest AppId(string fieldValue) {
        this.request.QueryString("appid", fieldValue);
        return this;
    }

    public WechatWxOpenSnsApiJsCode2JsonRequest Secret(string fieldValue) {
        this.request.QueryString("secret", fieldValue);
        return this;
    }

    public WechatWxOpenSnsApiJsCode2JsonRequest JsCode(string fieldValue) {
        this.request.QueryString("js_code", fieldValue);
        return this;
    }

    public WechatWxOpenSnsApiJsCode2JsonRequest GrantType(string fieldValue) {
        this.request.QueryString("grant_type", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
