using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenWxAppApiSearchMapPoiRequest {
    WechatTypedRequest request;

    public WechatWxOpenWxAppApiSearchMapPoiRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenWxAppApiSearchMapPoiRequest Districtid(long fieldValue) {
        this.request.BodyLong("districtid", fieldValue);
        return this;
    }

    public WechatWxOpenWxAppApiSearchMapPoiRequest Keyword(string fieldValue) {
        this.request.BodyString("keyword", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
