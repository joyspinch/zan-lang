using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenXPayApiQueryOrderRequest {
    WechatTypedRequest request;

    public WechatWxOpenXPayApiQueryOrderRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenXPayApiQueryOrderRequest Openid(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    public WechatWxOpenXPayApiQueryOrderRequest Env(int fieldValue) {
        this.request.BodyInt("env", fieldValue);
        return this;
    }

    public WechatWxOpenXPayApiQueryOrderRequest OrderId(string fieldValue) {
        this.request.BodyString("order_id", fieldValue);
        return this;
    }

    public WechatWxOpenXPayApiQueryOrderRequest WxOrderId(string fieldValue) {
        this.request.BodyString("wx_order_id", fieldValue);
        return this;
    }

    public WechatWxOpenXPayApiQueryOrderRequest PaySig(string fieldValue) {
        this.request.QueryString("pay_sig", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
