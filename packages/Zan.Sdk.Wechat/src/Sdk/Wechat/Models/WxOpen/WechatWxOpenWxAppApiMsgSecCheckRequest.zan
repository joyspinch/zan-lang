using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenWxAppApiMsgSecCheckRequest {
    WechatTypedRequest request;

    public WechatWxOpenWxAppApiMsgSecCheckRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenWxAppApiMsgSecCheckRequest Content(string fieldValue) {
        this.request.BodyString("content", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
