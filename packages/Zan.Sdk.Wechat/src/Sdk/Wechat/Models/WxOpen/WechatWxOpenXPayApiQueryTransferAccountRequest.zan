using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenXPayApiQueryTransferAccountRequest {
    WechatTypedRequest request;

    public WechatWxOpenXPayApiQueryTransferAccountRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenXPayApiQueryTransferAccountRequest Env(int fieldValue) {
        this.request.BodyInt("env", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
