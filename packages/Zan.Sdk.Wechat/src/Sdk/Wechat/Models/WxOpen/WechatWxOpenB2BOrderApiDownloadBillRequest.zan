using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenB2BOrderApiDownloadBillRequest {
    WechatTypedRequest request;

    public WechatWxOpenB2BOrderApiDownloadBillRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenB2BOrderApiDownloadBillRequest BillDate(string fieldValue) {
        this.request.BodyString("bill_date", fieldValue);
        return this;
    }

    WechatWxOpenB2BOrderApiDownloadBillRequest Mchid(string fieldValue) {
        this.request.BodyString("mchid", fieldValue);
        return this;
    }

    WechatWxOpenB2BOrderApiDownloadBillRequest PaySig(string fieldValue) {
        this.request.BodyString("paySig", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
