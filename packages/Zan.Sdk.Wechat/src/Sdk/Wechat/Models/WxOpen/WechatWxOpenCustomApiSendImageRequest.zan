using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenCustomApiSendImageRequest {
    WechatTypedRequest request;

    public WechatWxOpenCustomApiSendImageRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenCustomApiSendImageRequest OpenId(string fieldValue) {
        this.request.BodyString("touser", fieldValue);
        return this;
    }

    public WechatWxOpenCustomApiSendImageRequest MediaId(string fieldValue) {
        this.request.BodyString("image", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
