using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenB2BApiSendRetailNotificationRequest {
    WechatTypedRequest request;

    public WechatWxOpenB2BApiSendRetailNotificationRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenB2BApiSendRetailNotificationRequest Type(int fieldValue) {
        this.request.BodyInt("type", fieldValue);
        return this;
    }

    public WechatWxOpenB2BApiSendRetailNotificationRequest ToUserList(List<string> fieldValue) {
        this.request.BodyStrings("to_user_list", fieldValue);
        return this;
    }

    public WechatWxOpenB2BApiSendRetailNotificationRequest Content(string fieldValue) {
        this.request.BodyString("content", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
