using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenTcbApiSendTemplateMessageRequest {
    WechatTypedRequest request;

    public WechatWxOpenTcbApiSendTemplateMessageRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenTcbApiSendTemplateMessageRequest Env(string fieldValue) {
        this.request.QueryString("env", fieldValue);
        return this;
    }

    WechatWxOpenTcbApiSendTemplateMessageRequest Name(string fieldValue) {
        this.request.BodyString("name", fieldValue);
        return this;
    }

    WechatWxOpenTcbApiSendTemplateMessageRequest PostBody(JsonValue fieldValue) {
        this.request.BodyValue("postBody", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
