using System;
using System.Text;
using System.Json;
using Sdk.Wechat;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenSpecialWxaCodeUnlimitRequest {
    WechatTypedRequest request;
    public WechatWxOpenSpecialWxaCodeUnlimitRequest() { this.request = new WechatTypedRequest(); }
    WechatWxOpenSpecialWxaCodeUnlimitRequest Scene(string fieldValue) { this.request.BodyString("scene", fieldValue); return this; }
    WechatWxOpenSpecialWxaCodeUnlimitRequest Page(string fieldValue) { this.request.BodyString("page", fieldValue); return this; }
    WechatWxOpenSpecialWxaCodeUnlimitRequest CheckPath(bool fieldValue) { this.request.BodyBool("check_path", fieldValue); return this; }
    WechatWxOpenSpecialWxaCodeUnlimitRequest EnvVersion(string fieldValue) { this.request.BodyString("env_version", fieldValue); return this; }
    WechatWxOpenSpecialWxaCodeUnlimitRequest Width(int fieldValue) { this.request.BodyInt("width", fieldValue); return this; }
    WechatWxOpenSpecialWxaCodeUnlimitRequest AutoColor(bool fieldValue) { this.request.BodyBool("auto_color", fieldValue); return this; }
    WechatWxOpenSpecialWxaCodeUnlimitRequest LineColor(JsonValue fieldValue) { this.request.BodyValue("line_color", fieldValue); return this; }
    WechatWxOpenSpecialWxaCodeUnlimitRequest IsHyaline(bool fieldValue) { this.request.BodyBool("is_hyaline", fieldValue); return this; }
    string JsonBody() { return this.request.JsonBody(); }
}
