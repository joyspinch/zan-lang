using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenXPayApiSendSubscribePrePaymentRequest {
    WechatTypedRequest request;

    public WechatWxOpenXPayApiSendSubscribePrePaymentRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenXPayApiSendSubscribePrePaymentRequest Openid(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    WechatWxOpenXPayApiSendSubscribePrePaymentRequest DeductPrice(int fieldValue) {
        this.request.BodyInt("deduct_price", fieldValue);
        return this;
    }

    WechatWxOpenXPayApiSendSubscribePrePaymentRequest ProductId(string fieldValue) {
        this.request.BodyString("product_id", fieldValue);
        return this;
    }

    WechatWxOpenXPayApiSendSubscribePrePaymentRequest OutContractCode(string fieldValue) {
        this.request.BodyString("out_contract_code", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
