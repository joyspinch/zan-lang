    public WechatWxOpenXPayApiQueryUserBalanceRequest Openid(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    public WechatWxOpenXPayApiQueryUserBalanceRequest Env(int fieldValue) {
        this.request.BodyInt("env", fieldValue);
        return this;
    }

    public WechatWxOpenXPayApiQueryUserBalanceRequest UserIp(string fieldValue) {
        this.request.BodyString("user_ip", fieldValue);
        return this;
    }

    public WechatWxOpenXPayApiQueryUserBalanceRequest PaySig(string fieldValue) {
        this.request.QueryString("pay_sig", fieldValue);
        return this;
    }

    public WechatWxOpenXPayApiQueryUserBalanceRequest Signature(string fieldValue) {
        this.request.QueryString("signature", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
