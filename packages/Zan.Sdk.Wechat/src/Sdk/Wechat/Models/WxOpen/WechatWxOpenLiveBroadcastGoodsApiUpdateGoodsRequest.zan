    public WechatWxOpenLiveBroadcastGoodsApiUpdateGoodsRequest GoodsInfo(WechatWxOpenLiveBroadcastGoodsInfoRequest fieldValue) {
        this.request.BodyJson("goodsInfo", Json.Serialize<WechatWxOpenLiveBroadcastGoodsInfoRequest>(fieldValue));
