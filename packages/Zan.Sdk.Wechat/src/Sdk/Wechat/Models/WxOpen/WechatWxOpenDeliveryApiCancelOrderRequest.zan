using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenDeliveryApiCancelOrderRequest {
    WechatTypedRequest request;

    public WechatWxOpenDeliveryApiCancelOrderRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenDeliveryApiCancelOrderRequest Openid(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    WechatWxOpenDeliveryApiCancelOrderRequest DeliveryId(string fieldValue) {
        this.request.BodyString("delivery_id", fieldValue);
        return this;
    }

    WechatWxOpenDeliveryApiCancelOrderRequest WaybillId(string fieldValue) {
        this.request.BodyString("waybill_id", fieldValue);
        return this;
    }

    WechatWxOpenDeliveryApiCancelOrderRequest OrderId(string fieldValue) {
        this.request.BodyString("order_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
