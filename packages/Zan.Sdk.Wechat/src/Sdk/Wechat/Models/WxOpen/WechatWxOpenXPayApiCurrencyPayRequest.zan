using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenXPayApiCurrencyPayRequest {
    WechatTypedRequest request;

    public WechatWxOpenXPayApiCurrencyPayRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenXPayApiCurrencyPayRequest Openid(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    WechatWxOpenXPayApiCurrencyPayRequest Env(int fieldValue) {
        this.request.BodyInt("env", fieldValue);
        return this;
    }

    WechatWxOpenXPayApiCurrencyPayRequest UserIp(string fieldValue) {
        this.request.BodyString("user_ip", fieldValue);
        return this;
    }

    WechatWxOpenXPayApiCurrencyPayRequest Amount(int fieldValue) {
        this.request.BodyInt("amount", fieldValue);
        return this;
    }

    WechatWxOpenXPayApiCurrencyPayRequest OrderId(string fieldValue) {
        this.request.BodyString("order_id", fieldValue);
        return this;
    }

    WechatWxOpenXPayApiCurrencyPayRequest Payitem(string fieldValue) {
        this.request.BodyString("payitem", fieldValue);
        return this;
    }

    WechatWxOpenXPayApiCurrencyPayRequest Remark(string fieldValue) {
        this.request.BodyString("remark", fieldValue);
        return this;
    }

    WechatWxOpenXPayApiCurrencyPayRequest PaySig(string fieldValue) {
        this.request.QueryString("pay_sig", fieldValue);
        return this;
    }

    WechatWxOpenXPayApiCurrencyPayRequest Signature(string fieldValue) {
        this.request.QueryString("signature", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
