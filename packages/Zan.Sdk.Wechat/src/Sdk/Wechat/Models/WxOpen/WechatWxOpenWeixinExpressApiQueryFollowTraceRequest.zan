using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenWeixinExpressApiQueryFollowTraceRequest {
    WechatTypedRequest request;

    public WechatWxOpenWeixinExpressApiQueryFollowTraceRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenWeixinExpressApiQueryFollowTraceRequest WaybillToken(string fieldValue) {
        this.request.BodyString("waybill_token", fieldValue);
        return this;
    }

    public WechatWxOpenWeixinExpressApiQueryFollowTraceRequest Openid(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
