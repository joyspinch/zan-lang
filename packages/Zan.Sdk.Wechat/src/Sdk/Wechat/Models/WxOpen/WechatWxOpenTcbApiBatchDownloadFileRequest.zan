using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenTcbApiBatchDownloadFileRequest {
    WechatTypedRequest request;

    public WechatWxOpenTcbApiBatchDownloadFileRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenTcbApiBatchDownloadFileRequest Env(string fieldValue) {
        this.request.BodyString("env", fieldValue);
        return this;
    }

    WechatWxOpenTcbApiBatchDownloadFileRequest FileList(List<WechatWxOpenFileItem> fieldValue) {
        this.request.BodyJson("file_list", Json.Serialize<List<WechatWxOpenFileItem>>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
