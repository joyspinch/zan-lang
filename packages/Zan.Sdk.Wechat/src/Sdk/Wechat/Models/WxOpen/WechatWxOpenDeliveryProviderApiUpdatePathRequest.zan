using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenDeliveryProviderApiUpdatePathRequest {
    WechatTypedRequest request;

    public WechatWxOpenDeliveryProviderApiUpdatePathRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenDeliveryProviderApiUpdatePathRequest Token(string fieldValue) {
        this.request.BodyString("token", fieldValue);
        return this;
    }

    WechatWxOpenDeliveryProviderApiUpdatePathRequest WaybillId(string fieldValue) {
        this.request.BodyString("waybill_id", fieldValue);
        return this;
    }

    WechatWxOpenDeliveryProviderApiUpdatePathRequest ActionTime(long fieldValue) {
        this.request.BodyLong("action_time", fieldValue);
        return this;
    }

    WechatWxOpenDeliveryProviderApiUpdatePathRequest ActionType(int fieldValue) {
        this.request.BodyInt("action_type", fieldValue);
        return this;
    }

    WechatWxOpenDeliveryProviderApiUpdatePathRequest ActionMsg(string fieldValue) {
        this.request.BodyString("action_msg", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
