using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenWxAppApiMediaCheckRequest {
    WechatTypedRequest request;

    public WechatWxOpenWxAppApiMediaCheckRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenWxAppApiMediaCheckRequest MediaUrl(string fieldValue) {
        this.request.BodyString("media_url", fieldValue);
        return this;
    }

    WechatWxOpenWxAppApiMediaCheckRequest MediaType(string fieldValue) {
        this.request.BodyString("media_type", fieldValue);
        return this;
    }

    WechatWxOpenWxAppApiMediaCheckRequest Version(int fieldValue) {
        this.request.BodyInt("version", fieldValue);
        return this;
    }

    WechatWxOpenWxAppApiMediaCheckRequest OpenId(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    WechatWxOpenWxAppApiMediaCheckRequest Scene(int fieldValue) {
        this.request.BodyInt("scene", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
