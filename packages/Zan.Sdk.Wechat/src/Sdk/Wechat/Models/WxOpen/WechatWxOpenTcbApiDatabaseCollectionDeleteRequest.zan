using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenTcbApiDatabaseCollectionDeleteRequest {
    WechatTypedRequest request;

    public WechatWxOpenTcbApiDatabaseCollectionDeleteRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenTcbApiDatabaseCollectionDeleteRequest Env(string fieldValue) {
        this.request.BodyString("env", fieldValue);
        return this;
    }

    public WechatWxOpenTcbApiDatabaseCollectionDeleteRequest CollectionName(string fieldValue) {
        this.request.BodyString("collection_name", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
