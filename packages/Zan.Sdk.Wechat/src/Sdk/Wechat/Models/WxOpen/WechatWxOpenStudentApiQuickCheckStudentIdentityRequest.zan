using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenStudentApiQuickCheckStudentIdentityRequest {
    WechatTypedRequest request;

    public WechatWxOpenStudentApiQuickCheckStudentIdentityRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenStudentApiQuickCheckStudentIdentityRequest Openid(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    WechatWxOpenStudentApiQuickCheckStudentIdentityRequest WxStudentcheckCode(string fieldValue) {
        this.request.BodyString("wx_studentcheck_code", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
