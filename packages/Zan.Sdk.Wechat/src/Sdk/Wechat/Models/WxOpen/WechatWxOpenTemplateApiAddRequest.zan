using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenTemplateApiAddRequest {
    WechatTypedRequest request;

    public WechatWxOpenTemplateApiAddRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenTemplateApiAddRequest Id(string fieldValue) {
        this.request.BodyString("id", fieldValue);
        return this;
    }

    public WechatWxOpenTemplateApiAddRequest KeywordIdList(List<int> fieldValue) {
        this.request.BodyInts("keyword_id_list", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
