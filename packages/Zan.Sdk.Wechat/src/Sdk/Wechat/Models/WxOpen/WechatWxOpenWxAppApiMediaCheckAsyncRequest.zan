using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenWxAppApiMediaCheckAsyncRequest {
    WechatTypedRequest request;

    public WechatWxOpenWxAppApiMediaCheckAsyncRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenWxAppApiMediaCheckAsyncRequest MediaUrl(string fieldValue) {
        this.request.BodyString("media_url", fieldValue);
        return this;
    }

    public WechatWxOpenWxAppApiMediaCheckAsyncRequest MediaType(string fieldValue) {
        this.request.BodyString("media_type", fieldValue);
        return this;
    }

    public WechatWxOpenWxAppApiMediaCheckAsyncRequest Version(int fieldValue) {
        this.request.BodyInt("version", fieldValue);
        return this;
    }

    public WechatWxOpenWxAppApiMediaCheckAsyncRequest OpenId(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    public WechatWxOpenWxAppApiMediaCheckAsyncRequest Scene(int fieldValue) {
        this.request.BodyInt("scene", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
