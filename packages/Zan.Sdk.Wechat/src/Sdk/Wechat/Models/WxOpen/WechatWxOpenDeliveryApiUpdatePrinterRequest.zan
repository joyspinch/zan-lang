using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenDeliveryApiUpdatePrinterRequest {
    WechatTypedRequest request;

    public WechatWxOpenDeliveryApiUpdatePrinterRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenDeliveryApiUpdatePrinterRequest Openid(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    public WechatWxOpenDeliveryApiUpdatePrinterRequest UpdateType(string fieldValue) {
        this.request.BodyString("update_type", fieldValue);
        return this;
    }

    public WechatWxOpenDeliveryApiUpdatePrinterRequest TagidList(string fieldValue) {
        this.request.BodyString("tagid_list", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
