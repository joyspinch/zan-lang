using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenXPayApiQueryDownloadOrderRequest {
    WechatTypedRequest request;

    public WechatWxOpenXPayApiQueryDownloadOrderRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenXPayApiQueryDownloadOrderRequest TaskId(string fieldValue) {
        this.request.BodyString("task_id", fieldValue);
        return this;
    }

    WechatWxOpenXPayApiQueryDownloadOrderRequest Env(int fieldValue) {
        this.request.BodyInt("env", fieldValue);
        return this;
    }

    WechatWxOpenXPayApiQueryDownloadOrderRequest PaySig(string fieldValue) {
        this.request.QueryString("pay_sig", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
