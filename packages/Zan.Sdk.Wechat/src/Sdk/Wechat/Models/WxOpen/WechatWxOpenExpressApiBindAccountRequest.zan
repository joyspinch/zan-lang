using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenExpressApiBindAccountRequest {
    WechatTypedRequest request;

    public WechatWxOpenExpressApiBindAccountRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenExpressApiBindAccountRequest DeliveryId(string fieldValue) {
        this.request.BodyString("delivery_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
