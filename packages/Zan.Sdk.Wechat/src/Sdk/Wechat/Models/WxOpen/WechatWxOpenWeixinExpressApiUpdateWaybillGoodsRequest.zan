using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenWeixinExpressApiUpdateWaybillGoodsRequest {
    WechatTypedRequest request;

    public WechatWxOpenWeixinExpressApiUpdateWaybillGoodsRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenWeixinExpressApiUpdateWaybillGoodsRequest WaybillToken(string fieldValue) {
        this.request.BodyString("waybill_token", fieldValue);
        return this;
    }

    WechatWxOpenWeixinExpressApiUpdateWaybillGoodsRequest Openid(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    WechatWxOpenWeixinExpressApiUpdateWaybillGoodsRequest GoodsInfo(WechatWxOpenWeixinExpressGoodsInfo fieldValue) {
        this.request.BodyJson("goods_info", Json.Serialize<WechatWxOpenWeixinExpressGoodsInfo>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
