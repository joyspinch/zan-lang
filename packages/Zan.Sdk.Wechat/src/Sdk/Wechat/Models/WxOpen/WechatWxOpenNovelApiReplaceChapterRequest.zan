using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenNovelApiReplaceChapterRequest {
    WechatTypedRequest request;

    public WechatWxOpenNovelApiReplaceChapterRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenNovelApiReplaceChapterRequest BookId(string fieldValue) {
        this.request.BodyString("book_id", fieldValue);
        return this;
    }

    public WechatWxOpenNovelApiReplaceChapterRequest ChapterId(string fieldValue) {
        this.request.BodyString("chapter_id", fieldValue);
        return this;
    }

    public WechatWxOpenNovelApiReplaceChapterRequest NewChapterTitle(string fieldValue) {
        this.request.BodyString("new_chapter_title", fieldValue);
        return this;
    }

    public WechatWxOpenNovelApiReplaceChapterRequest NewContent(string fieldValue) {
        this.request.BodyString("new_content", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
