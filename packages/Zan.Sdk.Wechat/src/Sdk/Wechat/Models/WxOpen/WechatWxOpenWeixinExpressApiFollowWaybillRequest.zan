    }

    WechatWxOpenWeixinExpressApiFollowWaybillRequest GoodsInfo(WechatWxOpenWeixinExpressGoodsInfo fieldValue) {
        this.request.BodyJson("goods_info", Json.Serialize<WechatWxOpenWeixinExpressGoodsInfo>(fieldValue));
