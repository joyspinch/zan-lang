using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenDeliveryProviderApiRefundOrderRequest {
    WechatTypedRequest request;

    public WechatWxOpenDeliveryProviderApiRefundOrderRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenDeliveryProviderApiRefundOrderRequest Token(string fieldValue) {
        this.request.BodyString("token", fieldValue);
        return this;
    }

    public WechatWxOpenDeliveryProviderApiRefundOrderRequest Fee(long fieldValue) {
        this.request.BodyLong("fee", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
