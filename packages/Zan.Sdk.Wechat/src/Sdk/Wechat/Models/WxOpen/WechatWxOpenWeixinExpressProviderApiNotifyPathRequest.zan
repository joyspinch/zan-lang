using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenWeixinExpressProviderApiNotifyPathRequest {
    WechatTypedRequest request;

    public WechatWxOpenWeixinExpressProviderApiNotifyPathRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenWeixinExpressProviderApiNotifyPathRequest Sender(WechatWxOpenWeixinExpressPathContact fieldValue) {
        this.request.BodyJson("sender", Json.Serialize<WechatWxOpenWeixinExpressPathContact>(fieldValue));
        return this;
    }

    WechatWxOpenWeixinExpressProviderApiNotifyPathRequest Receiver(WechatWxOpenWeixinExpressPathContact fieldValue) {
        this.request.BodyJson("receiver", Json.Serialize<WechatWxOpenWeixinExpressPathContact>(fieldValue));
        return this;
    }

    WechatWxOpenWeixinExpressProviderApiNotifyPathRequest WaybillId(string fieldValue) {
        this.request.BodyString("waybill_id", fieldValue);
        return this;
    }

    WechatWxOpenWeixinExpressProviderApiNotifyPathRequest Path(WechatWxOpenWeixinExpressPathNode fieldValue) {
        this.request.BodyJson("path", Json.Serialize<WechatWxOpenWeixinExpressPathNode>(fieldValue));
        return this;
    }

    WechatWxOpenWeixinExpressProviderApiNotifyPathRequest CreateTime(long fieldValue) {
        this.request.BodyLong("create_time", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
