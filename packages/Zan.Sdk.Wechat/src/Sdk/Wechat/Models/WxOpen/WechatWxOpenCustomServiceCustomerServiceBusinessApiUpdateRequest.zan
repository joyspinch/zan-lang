using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenCustomServiceCustomerServiceBusinessApiUpdateRequest {
    WechatTypedRequest request;

    public WechatWxOpenCustomServiceCustomerServiceBusinessApiUpdateRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenCustomServiceCustomerServiceBusinessApiUpdateRequest BusinessId(string fieldValue) {
        this.request.BodyString("business_id", fieldValue);
        return this;
    }

    WechatWxOpenCustomServiceCustomerServiceBusinessApiUpdateRequest Nickname(string fieldValue) {
        this.request.BodyString("nickname", fieldValue);
        return this;
    }

    WechatWxOpenCustomServiceCustomerServiceBusinessApiUpdateRequest IconMediaId(string fieldValue) {
        this.request.BodyString("icon_media_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
