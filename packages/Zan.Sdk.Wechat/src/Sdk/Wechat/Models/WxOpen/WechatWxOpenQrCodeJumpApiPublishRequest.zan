using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenQrCodeJumpApiPublishRequest {
    WechatTypedRequest request;

    public WechatWxOpenQrCodeJumpApiPublishRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenQrCodeJumpApiPublishRequest Prefix(string fieldValue) {
        this.request.BodyString("prefix", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
