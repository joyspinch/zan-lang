using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenB2BMerchantApiApplyBankTransferRequest {
    WechatTypedRequest request;

    public WechatWxOpenB2BMerchantApiApplyBankTransferRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenB2BMerchantApiApplyBankTransferRequest OutRegistrationId(string fieldValue) {
        this.request.BodyString("out_registration_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
