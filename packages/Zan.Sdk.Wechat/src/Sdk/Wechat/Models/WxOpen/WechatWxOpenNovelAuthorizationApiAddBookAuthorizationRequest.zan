using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenNovelAuthorizationApiAddBookAuthorizationRequest {
    WechatTypedRequest request;

    public WechatWxOpenNovelAuthorizationApiAddBookAuthorizationRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenNovelAuthorizationApiAddBookAuthorizationRequest Books(List<WechatWxOpenNovelBookAuthorizationInput> fieldValue) {
        this.request.BodyJson("books", Json.Serialize<List<WechatWxOpenNovelBookAuthorizationInput>>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
