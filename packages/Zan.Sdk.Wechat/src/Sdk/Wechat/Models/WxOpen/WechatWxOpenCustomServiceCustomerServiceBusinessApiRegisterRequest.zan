using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenCustomServiceCustomerServiceBusinessApiRegisterRequest {
    WechatTypedRequest request;

    public WechatWxOpenCustomServiceCustomerServiceBusinessApiRegisterRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenCustomServiceCustomerServiceBusinessApiRegisterRequest AccountName(string fieldValue) {
        this.request.BodyString("account_name", fieldValue);
        return this;
    }

    WechatWxOpenCustomServiceCustomerServiceBusinessApiRegisterRequest Nickname(string fieldValue) {
        this.request.BodyString("nickname", fieldValue);
        return this;
    }

    WechatWxOpenCustomServiceCustomerServiceBusinessApiRegisterRequest IconMediaId(string fieldValue) {
        this.request.BodyString("icon_media_id", fieldValue);
        return this;
    }

    WechatWxOpenCustomServiceCustomerServiceBusinessApiRegisterRequest TransferToCommonKf(bool fieldValue) {
        this.request.BodyBool("transfer_to_commkf", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
