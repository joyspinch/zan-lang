using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenNovelApiCreateChapterRequest {
    WechatTypedRequest request;

    public WechatWxOpenNovelApiCreateChapterRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenNovelApiCreateChapterRequest BookId(string fieldValue) {
        this.request.BodyString("book_id", fieldValue);
        return this;
    }

    WechatWxOpenNovelApiCreateChapterRequest Chapter(WechatWxOpenNovelChapterInput fieldValue) {
        this.request.BodyJson("chapter", Json.Serialize<WechatWxOpenNovelChapterInput>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
