using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenLiveBroadcastApiUpdateCustomerServiceRequest {
    WechatTypedRequest request;

    public WechatWxOpenLiveBroadcastApiUpdateCustomerServiceRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenLiveBroadcastApiUpdateCustomerServiceRequest RoomId(long fieldValue) {
        this.request.BodyLong("roomId", fieldValue);
        return this;
    }

    WechatWxOpenLiveBroadcastApiUpdateCustomerServiceRequest CloseKf(int fieldValue) {
        this.request.BodyInt("closeKf", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
