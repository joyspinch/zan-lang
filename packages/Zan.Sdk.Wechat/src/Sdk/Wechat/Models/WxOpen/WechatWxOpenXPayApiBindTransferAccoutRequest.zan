using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenXPayApiBindTransferAccoutRequest {
    WechatTypedRequest request;

    public WechatWxOpenXPayApiBindTransferAccoutRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenXPayApiBindTransferAccoutRequest TransferAccountUid(long fieldValue) {
        this.request.BodyLong("transfer_account_uid", fieldValue);
        return this;
    }

    WechatWxOpenXPayApiBindTransferAccoutRequest TransferAccountOrgName(string fieldValue) {
        this.request.BodyString("transfer_account_org_name", fieldValue);
        return this;
    }

    WechatWxOpenXPayApiBindTransferAccoutRequest Env(int fieldValue) {
        this.request.BodyInt("env", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
