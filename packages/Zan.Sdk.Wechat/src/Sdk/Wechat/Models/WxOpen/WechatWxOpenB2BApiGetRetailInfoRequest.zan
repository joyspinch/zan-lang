using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenB2BApiGetRetailInfoRequest {
    WechatTypedRequest request;

    public WechatWxOpenB2BApiGetRetailInfoRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenB2BApiGetRetailInfoRequest Openid(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    WechatWxOpenB2BApiGetRetailInfoRequest MobilePhone(string fieldValue) {
        this.request.BodyString("mobile_phone", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
