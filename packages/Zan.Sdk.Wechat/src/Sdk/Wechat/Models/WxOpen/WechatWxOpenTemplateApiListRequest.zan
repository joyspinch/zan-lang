using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenTemplateApiListRequest {
    WechatTypedRequest request;

    public WechatWxOpenTemplateApiListRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenTemplateApiListRequest Offset(int fieldValue) {
        this.request.BodyInt("offset", fieldValue);
        return this;
    }

    public WechatWxOpenTemplateApiListRequest Count(int fieldValue) {
        this.request.BodyInt("count", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
