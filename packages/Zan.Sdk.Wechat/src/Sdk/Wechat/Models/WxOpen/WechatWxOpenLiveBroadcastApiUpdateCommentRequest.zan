using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenLiveBroadcastApiUpdateCommentRequest {
    WechatTypedRequest request;

    public WechatWxOpenLiveBroadcastApiUpdateCommentRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenLiveBroadcastApiUpdateCommentRequest Id(long fieldValue) {
        this.request.BodyLong("id", fieldValue);
        return this;
    }

    public WechatWxOpenLiveBroadcastApiUpdateCommentRequest BanComment(int fieldValue) {
        this.request.BodyInt("banComment", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
