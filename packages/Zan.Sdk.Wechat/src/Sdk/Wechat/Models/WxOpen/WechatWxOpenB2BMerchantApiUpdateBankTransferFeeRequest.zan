using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenB2BMerchantApiUpdateBankTransferFeeRequest {
    WechatTypedRequest request;

    public WechatWxOpenB2BMerchantApiUpdateBankTransferFeeRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenB2BMerchantApiUpdateBankTransferFeeRequest SubMchid(string fieldValue) {
        this.request.BodyString("sub_mchid", fieldValue);
        return this;
    }

    public WechatWxOpenB2BMerchantApiUpdateBankTransferFeeRequest CertifiedChargeFeeNumerator(int fieldValue) {
        this.request.BodyInt("certified_charge_fee_numerator", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
