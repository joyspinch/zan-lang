using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenWeixinExpressProviderApiQueryUserBindingRequest {
    WechatTypedRequest request;

    public WechatWxOpenWeixinExpressProviderApiQueryUserBindingRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenWeixinExpressProviderApiQueryUserBindingRequest Phone(string fieldValue) {
        this.request.BodyString("phone", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
