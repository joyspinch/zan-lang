using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenTemplateApiUniformSendRequest {
    WechatTypedRequest request;

    public WechatWxOpenTemplateApiUniformSendRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenTemplateApiUniformSendRequest Touser(string fieldValue) {
        this.request.BodyString("touser", fieldValue);
        return this;
    }

    public WechatWxOpenTemplateApiUniformSendRequest WeappTemplateMsg(WechatWxOpenWeappTemplateMsg fieldValue) {
        this.request.BodyJson("weapp_template_msg", Json.Serialize<WechatWxOpenWeappTemplateMsg>(fieldValue));
        return this;
    }

    public WechatWxOpenTemplateApiUniformSendRequest MpTemplateMsg(WechatWxOpenMpTemplateMsg fieldValue) {
        this.request.BodyJson("mp_template_msg", Json.Serialize<WechatWxOpenMpTemplateMsg>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
