using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenWxAppApiApplyPluginRequest {
    WechatTypedRequest request;

    public WechatWxOpenWxAppApiApplyPluginRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenWxAppApiApplyPluginRequest PluginAppid(string fieldValue) {
        this.request.BodyString("plugin_appid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
