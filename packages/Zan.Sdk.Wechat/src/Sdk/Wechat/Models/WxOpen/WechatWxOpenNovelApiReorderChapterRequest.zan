using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenNovelApiReorderChapterRequest {
    WechatTypedRequest request;

    public WechatWxOpenNovelApiReorderChapterRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenNovelApiReorderChapterRequest BookId(string fieldValue) {
        this.request.BodyString("book_id", fieldValue);
        return this;
    }

    WechatWxOpenNovelApiReorderChapterRequest ChapterId(string fieldValue) {
        this.request.BodyString("chapter_id", fieldValue);
        return this;
    }

    WechatWxOpenNovelApiReorderChapterRequest TargetChapterId(string fieldValue) {
        this.request.BodyString("target_chapter_id", fieldValue);
        return this;
    }

    WechatWxOpenNovelApiReorderChapterRequest Operation(int fieldValue) {
        this.request.BodyInt("operation", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
