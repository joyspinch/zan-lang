using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenWxAppUrlSchemeApiQuerySchemeRequest {
    WechatTypedRequest request;

    public WechatWxOpenWxAppUrlSchemeApiQuerySchemeRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenWxAppUrlSchemeApiQuerySchemeRequest Scheme(string fieldValue) {
        this.request.BodyString("scheme", fieldValue);
        return this;
    }

    public WechatWxOpenWxAppUrlSchemeApiQuerySchemeRequest QueryType(int fieldValue) {
        this.request.BodyInt("query_type", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
