public class WechatWxOpenSpecialSendTextRequest {
    WechatTypedRequest request;
    string businessId;
    public WechatWxOpenSpecialSendTextRequest() {
        this.request = new WechatTypedRequest(); this.businessId = "";
        this.request.BodyString("msgtype", "text");
    }
    public WechatWxOpenSpecialSendTextRequest OpenId(string fieldValue) {
        this.request.BodyString("touser", fieldValue); return this;
    }
    public WechatWxOpenSpecialSendTextRequest Content(string fieldValue) {
        JsonValue text = JsonValue.NewObject();
        text.Set("content", JsonValue.NewStr(fieldValue));
        this.request.BodyValue("text", text); return this;
    }
    public WechatWxOpenSpecialSendTextRequest BusinessId(string fieldValue) {
        this.businessId = fieldValue;
        if (fieldValue.Length > 0) { this.request.BodyString("businessid", fieldValue); }
        return this;
    }
    public string Path() {
        if (this.businessId.Length > 0) { return "/cgi-bin/message/custom/business/send"; }
        return "/cgi-bin/message/custom/send";
    }
    string JsonBody() { return this.request.JsonBody(); }
}

