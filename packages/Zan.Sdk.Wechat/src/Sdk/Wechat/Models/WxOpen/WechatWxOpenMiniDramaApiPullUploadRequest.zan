using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenMiniDramaApiPullUploadRequest {
    WechatTypedRequest request;

    public WechatWxOpenMiniDramaApiPullUploadRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenMiniDramaApiPullUploadRequest MediaName(string fieldValue) {
        this.request.BodyString("media_name", fieldValue);
        return this;
    }

    public WechatWxOpenMiniDramaApiPullUploadRequest MediaUrl(string fieldValue) {
        this.request.BodyString("media_url", fieldValue);
        return this;
    }

    public WechatWxOpenMiniDramaApiPullUploadRequest CoverUrl(string fieldValue) {
        this.request.BodyString("cover_url", fieldValue);
        return this;
    }

    public WechatWxOpenMiniDramaApiPullUploadRequest SourceContext(string fieldValue) {
        this.request.BodyString("source_context", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
