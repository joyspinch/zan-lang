using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenXPayApiQueryUploadGoodsRequest {
    WechatTypedRequest request;

    public WechatWxOpenXPayApiQueryUploadGoodsRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenXPayApiQueryUploadGoodsRequest Env(int fieldValue) {
        this.request.BodyInt("env", fieldValue);
        return this;
    }

    public WechatWxOpenXPayApiQueryUploadGoodsRequest PaySig(string fieldValue) {
        this.request.QueryString("pay_sig", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
