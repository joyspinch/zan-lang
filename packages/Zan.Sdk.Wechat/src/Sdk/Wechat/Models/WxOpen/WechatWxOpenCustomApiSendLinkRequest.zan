using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenCustomApiSendLinkRequest {
    WechatTypedRequest request;

    public WechatWxOpenCustomApiSendLinkRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenCustomApiSendLinkRequest Title(string fieldValue) {
        this.request.BodyString("title", fieldValue);
        return this;
    }

    WechatWxOpenCustomApiSendLinkRequest Description(string fieldValue) {
        this.request.BodyString("description", fieldValue);
        return this;
    }

    WechatWxOpenCustomApiSendLinkRequest Url(string fieldValue) {
        this.request.BodyString("url", fieldValue);
        return this;
    }

    WechatWxOpenCustomApiSendLinkRequest ThumbUrl(string fieldValue) {
        this.request.BodyString("thumb_url", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
