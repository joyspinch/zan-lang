using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenFaceApiQueryVerifyInfoRequest {
    WechatTypedRequest request;

    public WechatWxOpenFaceApiQueryVerifyInfoRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenFaceApiQueryVerifyInfoRequest VerifyId(string fieldValue) {
        this.request.BodyString("verify_id", fieldValue);
        return this;
    }

    public WechatWxOpenFaceApiQueryVerifyInfoRequest OutSeqNo(string fieldValue) {
        this.request.BodyString("out_seq_no", fieldValue);
        return this;
    }

    public WechatWxOpenFaceApiQueryVerifyInfoRequest CertHash(string fieldValue) {
        this.request.BodyString("cert_hash", fieldValue);
        return this;
    }

    public WechatWxOpenFaceApiQueryVerifyInfoRequest Openid(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
