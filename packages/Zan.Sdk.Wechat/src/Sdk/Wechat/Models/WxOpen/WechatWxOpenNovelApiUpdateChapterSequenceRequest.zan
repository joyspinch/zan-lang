using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenNovelApiUpdateChapterSequenceRequest {
    WechatTypedRequest request;

    public WechatWxOpenNovelApiUpdateChapterSequenceRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenNovelApiUpdateChapterSequenceRequest BookId(string fieldValue) {
        this.request.BodyString("book_id", fieldValue);
        return this;
    }

    public WechatWxOpenNovelApiUpdateChapterSequenceRequest ChapterSeqList(List<WechatWxOpenNovelChapterSequence> fieldValue) {
        this.request.BodyJson("chapter_seq_list", Json.Serialize<List<WechatWxOpenNovelChapterSequence>>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
