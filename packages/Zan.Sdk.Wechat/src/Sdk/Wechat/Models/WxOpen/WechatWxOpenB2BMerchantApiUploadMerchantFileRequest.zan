using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenB2BMerchantApiUploadMerchantFileRequest {
    WechatTypedRequest request;

    public WechatWxOpenB2BMerchantApiUploadMerchantFileRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenB2BMerchantApiUploadMerchantFileRequest FileName(string fieldValue) {
        this.request.BodyString("file_name", fieldValue);
        return this;
    }

    public WechatWxOpenB2BMerchantApiUploadMerchantFileRequest File(string fieldValue) {
        this.request.BodyString("file", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
