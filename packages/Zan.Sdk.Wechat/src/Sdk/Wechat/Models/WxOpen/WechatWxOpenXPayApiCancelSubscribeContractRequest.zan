using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenXPayApiCancelSubscribeContractRequest {
    WechatTypedRequest request;

    public WechatWxOpenXPayApiCancelSubscribeContractRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenXPayApiCancelSubscribeContractRequest Openid(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    WechatWxOpenXPayApiCancelSubscribeContractRequest TerminationReason(string fieldValue) {
        this.request.BodyString("termination_reason", fieldValue);
        return this;
    }

    WechatWxOpenXPayApiCancelSubscribeContractRequest ProductId(string fieldValue) {
        this.request.BodyString("product_id", fieldValue);
        return this;
    }

    WechatWxOpenXPayApiCancelSubscribeContractRequest OutContractCode(string fieldValue) {
        this.request.BodyString("out_contract_code", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
