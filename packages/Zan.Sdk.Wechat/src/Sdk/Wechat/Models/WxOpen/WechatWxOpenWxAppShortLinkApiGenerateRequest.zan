using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenWxAppShortLinkApiGenerateRequest {
    WechatTypedRequest request;

    public WechatWxOpenWxAppShortLinkApiGenerateRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenWxAppShortLinkApiGenerateRequest PageUrl(string fieldValue) {
        this.request.BodyString("page_url", fieldValue);
        return this;
    }

    WechatWxOpenWxAppShortLinkApiGenerateRequest PageTitle(string fieldValue) {
        this.request.BodyString("page_title", fieldValue);
        return this;
    }

    WechatWxOpenWxAppShortLinkApiGenerateRequest IsPermanent(bool fieldValue) {
        this.request.BodyBool("is_permanent", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
