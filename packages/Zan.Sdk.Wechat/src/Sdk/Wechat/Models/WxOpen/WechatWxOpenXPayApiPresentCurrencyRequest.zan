using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenXPayApiPresentCurrencyRequest {
    WechatTypedRequest request;

    public WechatWxOpenXPayApiPresentCurrencyRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenXPayApiPresentCurrencyRequest Openid(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    WechatWxOpenXPayApiPresentCurrencyRequest Env(int fieldValue) {
        this.request.BodyInt("env", fieldValue);
        return this;
    }

    WechatWxOpenXPayApiPresentCurrencyRequest OrderId(string fieldValue) {
        this.request.BodyString("order_id", fieldValue);
        return this;
    }

    WechatWxOpenXPayApiPresentCurrencyRequest Amount(int fieldValue) {
        this.request.BodyInt("amount", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
