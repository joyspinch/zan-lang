using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenB2BApiBatchCreateRetailRequest {
    WechatTypedRequest request;

    public WechatWxOpenB2BApiBatchCreateRetailRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenB2BApiBatchCreateRetailRequest RetailInfoList(List<WechatWxOpenB2BRetailPreEntry> fieldValue) {
        this.request.BodyJson("retail_info_list", Json.Serialize<List<WechatWxOpenB2BRetailPreEntry>>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
