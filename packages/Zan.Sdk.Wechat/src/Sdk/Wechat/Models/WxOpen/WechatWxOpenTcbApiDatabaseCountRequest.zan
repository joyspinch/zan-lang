using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenTcbApiDatabaseCountRequest {
    WechatTypedRequest request;

    public WechatWxOpenTcbApiDatabaseCountRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenTcbApiDatabaseCountRequest Env(string fieldValue) {
        this.request.BodyString("env", fieldValue);
        return this;
    }

    public WechatWxOpenTcbApiDatabaseCountRequest Query(string fieldValue) {
        this.request.BodyString("query", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
