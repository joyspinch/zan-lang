using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenNovelApiGetChapterRequest {
    WechatTypedRequest request;

    public WechatWxOpenNovelApiGetChapterRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenNovelApiGetChapterRequest BookId(string fieldValue) {
        this.request.BodyString("book_id", fieldValue);
        return this;
    }

    public WechatWxOpenNovelApiGetChapterRequest ChapterId(string fieldValue) {
        this.request.BodyString("chapter_id", fieldValue);
        return this;
    }

    public WechatWxOpenNovelApiGetChapterRequest NeedEditedData(bool fieldValue) {
        this.request.BodyBool("need_edited_data", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
