using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenSecOrderIncrementApiReportSpecialOrderRequest {
    WechatTypedRequest request;

    public WechatWxOpenSecOrderIncrementApiReportSpecialOrderRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenSecOrderIncrementApiReportSpecialOrderRequest OrderId(string fieldValue) {
        this.request.BodyString("order_id", fieldValue);
        return this;
    }

    public WechatWxOpenSecOrderIncrementApiReportSpecialOrderRequest Type(int fieldValue) {
        this.request.BodyInt("type", fieldValue);
        return this;
    }

    public WechatWxOpenSecOrderIncrementApiReportSpecialOrderRequest DelayTo(long fieldValue) {
        this.request.BodyLong("delay_to", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
