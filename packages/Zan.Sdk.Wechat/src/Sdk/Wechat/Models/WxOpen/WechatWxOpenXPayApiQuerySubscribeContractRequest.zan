using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenXPayApiQuerySubscribeContractRequest {
    WechatTypedRequest request;

    public WechatWxOpenXPayApiQuerySubscribeContractRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenXPayApiQuerySubscribeContractRequest Openid(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    public WechatWxOpenXPayApiQuerySubscribeContractRequest ProductId(string fieldValue) {
        this.request.BodyString("product_id", fieldValue);
        return this;
    }

    public WechatWxOpenXPayApiQuerySubscribeContractRequest OutContractCode(string fieldValue) {
        this.request.BodyString("out_contract_code", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
