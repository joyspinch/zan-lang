using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenNovelReaderApiSetPreviewSettingRequest {
    WechatTypedRequest request;

    public WechatWxOpenNovelReaderApiSetPreviewSettingRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenNovelReaderApiSetPreviewSettingRequest Setting(WechatWxOpenNovelPreviewSetting fieldValue) {
        this.request.BodyJson("setting", Json.Serialize<WechatWxOpenNovelPreviewSetting>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
