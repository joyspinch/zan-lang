using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenMiniDramaApiCommitUploadRequest {
    WechatTypedRequest request;

    public WechatWxOpenMiniDramaApiCommitUploadRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenMiniDramaApiCommitUploadRequest UploadId(string fieldValue) {
        this.request.BodyString("upload_id", fieldValue);
        return this;
    }

    WechatWxOpenMiniDramaApiCommitUploadRequest MediaPartInfos(List<WechatWxOpenMiniDramaPartInfo> fieldValue) {
        this.request.BodyJson("media_part_infos", Json.Serialize<List<WechatWxOpenMiniDramaPartInfo>>(fieldValue));
        return this;
    }

    WechatWxOpenMiniDramaApiCommitUploadRequest CoverPartInfos(List<WechatWxOpenMiniDramaPartInfo> fieldValue) {
        this.request.BodyJson("cover_part_infos", Json.Serialize<List<WechatWxOpenMiniDramaPartInfo>>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
