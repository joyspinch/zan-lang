using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenSecOrderIncrementApiApplyTradeTypeChangeRequest {
    WechatTypedRequest request;

    public WechatWxOpenSecOrderIncrementApiApplyTradeTypeChangeRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenSecOrderIncrementApiApplyTradeTypeChangeRequest TradeType(int fieldValue) {
        this.request.BodyInt("trade_type", fieldValue);
        return this;
    }

    public WechatWxOpenSecOrderIncrementApiApplyTradeTypeChangeRequest MaterialList(List<WechatWxOpenTradeTypeMaterial> fieldValue) {
        this.request.BodyJson("material_list", Json.Serialize<List<WechatWxOpenTradeTypeMaterial>>(fieldValue));
        return this;
    }

    public WechatWxOpenSecOrderIncrementApiApplyTradeTypeChangeRequest Reason(string fieldValue) {
        this.request.BodyString("reason", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
