using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenCustomServiceApiKfAccountAddRequest {
    WechatTypedRequest request;

    public WechatWxOpenCustomServiceApiKfAccountAddRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenCustomServiceApiKfAccountAddRequest KfWx(string fieldValue) {
        this.request.BodyString("kf_wx", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
