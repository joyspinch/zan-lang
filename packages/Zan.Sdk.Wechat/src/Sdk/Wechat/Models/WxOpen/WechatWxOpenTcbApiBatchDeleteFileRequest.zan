using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenTcbApiBatchDeleteFileRequest {
    WechatTypedRequest request;

    public WechatWxOpenTcbApiBatchDeleteFileRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenTcbApiBatchDeleteFileRequest Env(string fieldValue) {
        this.request.BodyString("env", fieldValue);
        return this;
    }

    WechatWxOpenTcbApiBatchDeleteFileRequest FileidList(List<string> fieldValue) {
        this.request.BodyStrings("fileid_list", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
