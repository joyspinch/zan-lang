using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenSoterApiVerifySignatureRequest {
    WechatTypedRequest request;

    public WechatWxOpenSoterApiVerifySignatureRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenSoterApiVerifySignatureRequest Openid(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    WechatWxOpenSoterApiVerifySignatureRequest JsonString(string fieldValue) {
        this.request.BodyString("json_string", fieldValue);
        return this;
    }

    WechatWxOpenSoterApiVerifySignatureRequest JsonSignature(string fieldValue) {
        this.request.BodyString("json_signature", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
