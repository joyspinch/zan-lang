using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenTcbApiUploadFileRequest {
    WechatTypedRequest request;

    public WechatWxOpenTcbApiUploadFileRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenTcbApiUploadFileRequest Env(string fieldValue) {
        this.request.BodyString("env", fieldValue);
        return this;
    }

    WechatWxOpenTcbApiUploadFileRequest Path(string fieldValue) {
        this.request.BodyString("path", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
