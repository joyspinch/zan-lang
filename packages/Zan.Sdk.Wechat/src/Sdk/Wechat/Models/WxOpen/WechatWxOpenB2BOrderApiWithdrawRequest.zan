using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenB2BOrderApiWithdrawRequest {
    WechatTypedRequest request;

    public WechatWxOpenB2BOrderApiWithdrawRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenB2BOrderApiWithdrawRequest WithdrawAmount(long fieldValue) {
        this.request.BodyLong("withdraw_amount", fieldValue);
        return this;
    }

    WechatWxOpenB2BOrderApiWithdrawRequest OutWithdrawNo(string fieldValue) {
        this.request.BodyString("out_withdraw_no", fieldValue);
        return this;
    }

    WechatWxOpenB2BOrderApiWithdrawRequest Mchid(string fieldValue) {
        this.request.BodyString("mchid", fieldValue);
        return this;
    }

    WechatWxOpenB2BOrderApiWithdrawRequest PaySig(string fieldValue) {
        this.request.BodyString("paySig", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
