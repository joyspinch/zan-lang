using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenNovelApiBatchCreateChaptersRequest {
    WechatTypedRequest request;

    public WechatWxOpenNovelApiBatchCreateChaptersRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenNovelApiBatchCreateChaptersRequest BookId(string fieldValue) {
        this.request.BodyString("book_id", fieldValue);
        return this;
    }

    WechatWxOpenNovelApiBatchCreateChaptersRequest ChapterList(List<WechatWxOpenNovelChapterInput> fieldValue) {
        this.request.BodyJson("chapter_list", Json.Serialize<List<WechatWxOpenNovelChapterInput>>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
