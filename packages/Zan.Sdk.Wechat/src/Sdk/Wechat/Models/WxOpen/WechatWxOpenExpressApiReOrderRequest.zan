    public WechatWxOpenExpressApiReOrderRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenExpressApiReOrderRequest DeliveryToken(string fieldValue) {
        this.request.BodyString("delivery_token", fieldValue);
        return this;
    }

    public WechatWxOpenExpressApiReOrderRequest Shopid(string fieldValue) {
        this.request.BodyString("shopid", fieldValue);
        return this;
    }

    public WechatWxOpenExpressApiReOrderRequest ShopOrderId(string fieldValue) {
        this.request.BodyString("shop_order_id", fieldValue);
        return this;
    }

    public WechatWxOpenExpressApiReOrderRequest ShopNo(string fieldValue) {
        this.request.BodyString("shop_no", fieldValue);
        return this;
    }

    public WechatWxOpenExpressApiReOrderRequest DeliverySign(string fieldValue) {
        this.request.BodyString("delivery_sign", fieldValue);
        return this;
    }

    public WechatWxOpenExpressApiReOrderRequest DeliveryId(string fieldValue) {
        this.request.BodyString("delivery_id", fieldValue);
        return this;
    }

    public WechatWxOpenExpressApiReOrderRequest Openid(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    public WechatWxOpenExpressApiReOrderRequest Sender(WechatWxOpenPreAddOrderSender fieldValue) {
        this.request.BodyJson("sender", Json.Serialize<WechatWxOpenPreAddOrderSender>(fieldValue));
        return this;
    }

    public WechatWxOpenExpressApiReOrderRequest Receiver(WechatWxOpenPreAddOrderReceiver fieldValue) {
        this.request.BodyJson("receiver", Json.Serialize<WechatWxOpenPreAddOrderReceiver>(fieldValue));
        return this;
    }

    public WechatWxOpenExpressApiReOrderRequest Cargo(WechatWxOpenPreAddOrderCargo fieldValue) {
        this.request.BodyJson("cargo", Json.Serialize<WechatWxOpenPreAddOrderCargo>(fieldValue));
        return this;
