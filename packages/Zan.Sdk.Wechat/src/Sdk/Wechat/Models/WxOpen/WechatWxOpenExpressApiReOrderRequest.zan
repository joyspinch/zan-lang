    public WechatWxOpenExpressApiReOrderRequest OrderInfo(WechatWxOpenPreAddOrderOrderInfo fieldValue) {
        this.request.BodyJson("order_info", Json.Serialize<WechatWxOpenPreAddOrderOrderInfo>(fieldValue));
        return this;
    }

    public WechatWxOpenExpressApiReOrderRequest Shop(WechatWxOpenPreAddOrderShop fieldValue) {
        this.request.BodyJson("shop", Json.Serialize<WechatWxOpenPreAddOrderShop>(fieldValue));
        return this;
    }

    public WechatWxOpenExpressApiReOrderRequest SubBizId(string fieldValue) {
        this.request.BodyString("sub_biz_id", fieldValue);
