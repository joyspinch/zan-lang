using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenExpressApiReOrderRequest {
    WechatTypedRequest request;

    public WechatWxOpenExpressApiReOrderRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenExpressApiReOrderRequest DeliveryToken(string fieldValue) {
        this.request.BodyString("delivery_token", fieldValue);
        return this;
    }

    WechatWxOpenExpressApiReOrderRequest Shopid(string fieldValue) {
        this.request.BodyString("shopid", fieldValue);
        return this;
    }

    WechatWxOpenExpressApiReOrderRequest ShopOrderId(string fieldValue) {
        this.request.BodyString("shop_order_id", fieldValue);
        return this;
    }

    WechatWxOpenExpressApiReOrderRequest ShopNo(string fieldValue) {
        this.request.BodyString("shop_no", fieldValue);
        return this;
    }

    WechatWxOpenExpressApiReOrderRequest DeliverySign(string fieldValue) {
        this.request.BodyString("delivery_sign", fieldValue);
        return this;
    }

    WechatWxOpenExpressApiReOrderRequest DeliveryId(string fieldValue) {
        this.request.BodyString("delivery_id", fieldValue);
        return this;
    }

    WechatWxOpenExpressApiReOrderRequest Openid(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    WechatWxOpenExpressApiReOrderRequest Sender(WechatWxOpenPreAddOrderSender fieldValue) {
        this.request.BodyJson("sender", Json.Serialize<WechatWxOpenPreAddOrderSender>(fieldValue));
        return this;
    }

    WechatWxOpenExpressApiReOrderRequest Receiver(WechatWxOpenPreAddOrderReceiver fieldValue) {
        this.request.BodyJson("receiver", Json.Serialize<WechatWxOpenPreAddOrderReceiver>(fieldValue));
        return this;
    }

    WechatWxOpenExpressApiReOrderRequest Cargo(WechatWxOpenPreAddOrderCargo fieldValue) {
        this.request.BodyJson("cargo", Json.Serialize<WechatWxOpenPreAddOrderCargo>(fieldValue));
        return this;
    }

    WechatWxOpenExpressApiReOrderRequest OrderInfo(WechatWxOpenPreAddOrderOrderInfo fieldValue) {
        this.request.BodyJson("order_info", Json.Serialize<WechatWxOpenPreAddOrderOrderInfo>(fieldValue));
        return this;
    }

    WechatWxOpenExpressApiReOrderRequest Shop(WechatWxOpenPreAddOrderShop fieldValue) {
        this.request.BodyJson("shop", Json.Serialize<WechatWxOpenPreAddOrderShop>(fieldValue));
        return this;
    }

    WechatWxOpenExpressApiReOrderRequest SubBizId(string fieldValue) {
        this.request.BodyString("sub_biz_id", fieldValue);
