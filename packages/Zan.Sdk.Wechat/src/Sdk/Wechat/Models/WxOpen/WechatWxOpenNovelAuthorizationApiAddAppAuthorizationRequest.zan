using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenNovelAuthorizationApiAddAppAuthorizationRequest {
    WechatTypedRequest request;

    public WechatWxOpenNovelAuthorizationApiAddAppAuthorizationRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenNovelAuthorizationApiAddAppAuthorizationRequest Infos(List<WechatWxOpenNovelAppAuthorizationInput> fieldValue) {
        this.request.BodyJson("infos", Json.Serialize<List<WechatWxOpenNovelAppAuthorizationInput>>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
