using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenWxAppApiUnbindPluginRequest {
    WechatTypedRequest request;

    public WechatWxOpenWxAppApiUnbindPluginRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenWxAppApiUnbindPluginRequest AppId(string fieldValue) {
        this.request.BodyString("plugin_appid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
