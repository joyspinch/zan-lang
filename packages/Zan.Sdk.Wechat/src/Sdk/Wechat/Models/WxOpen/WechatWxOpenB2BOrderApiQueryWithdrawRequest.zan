using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenB2BOrderApiQueryWithdrawRequest {
    WechatTypedRequest request;

    public WechatWxOpenB2BOrderApiQueryWithdrawRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenB2BOrderApiQueryWithdrawRequest OutWithdrawNo(string fieldValue) {
        this.request.BodyString("out_withdraw_no", fieldValue);
        return this;
    }

    WechatWxOpenB2BOrderApiQueryWithdrawRequest Mchid(string fieldValue) {
        this.request.BodyString("mchid", fieldValue);
        return this;
    }

    WechatWxOpenB2BOrderApiQueryWithdrawRequest PaySig(string fieldValue) {
        this.request.BodyString("paySig", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
