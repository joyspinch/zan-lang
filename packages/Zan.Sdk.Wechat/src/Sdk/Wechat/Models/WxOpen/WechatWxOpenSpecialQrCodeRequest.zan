using System;
using System.Text;
using System.Json;
using Sdk.Wechat;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenSpecialQrCodeRequest {
    WechatTypedRequest request;
    public WechatWxOpenSpecialQrCodeRequest() { this.request = new WechatTypedRequest(); }
    WechatWxOpenSpecialQrCodeRequest Path(string fieldValue) { this.request.BodyString("path", fieldValue); return this; }
    WechatWxOpenSpecialQrCodeRequest Width(int fieldValue) { this.request.BodyInt("width", fieldValue); return this; }
    string JsonBody() { return this.request.JsonBody(); }
}
