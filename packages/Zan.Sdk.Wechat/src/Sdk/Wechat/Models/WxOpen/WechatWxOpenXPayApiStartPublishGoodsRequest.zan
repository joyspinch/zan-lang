using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenXPayApiStartPublishGoodsRequest {
    WechatTypedRequest request;

    public WechatWxOpenXPayApiStartPublishGoodsRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenXPayApiStartPublishGoodsRequest PublishItem(List<WechatWxOpenStartPublishGoodsItem> fieldValue) {
        this.request.BodyJson("publish_item", Json.Serialize<List<WechatWxOpenStartPublishGoodsItem>>(fieldValue));
        return this;
    }

    public WechatWxOpenXPayApiStartPublishGoodsRequest Env(int fieldValue) {
        this.request.BodyInt("env", fieldValue);
        return this;
    }

    public WechatWxOpenXPayApiStartPublishGoodsRequest PaySig(string fieldValue) {
        this.request.QueryString("pay_sig", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
