using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenDeliveryApiBindAccountRequest {
    WechatTypedRequest request;

    public WechatWxOpenDeliveryApiBindAccountRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenDeliveryApiBindAccountRequest Type(string fieldValue) {
        this.request.BodyString("type", fieldValue);
        return this;
    }

    public WechatWxOpenDeliveryApiBindAccountRequest BizId(string fieldValue) {
        this.request.BodyString("biz_id", fieldValue);
        return this;
    }

    public WechatWxOpenDeliveryApiBindAccountRequest DeliveryId(string fieldValue) {
        this.request.BodyString("delivery_id", fieldValue);
        return this;
    }

    public WechatWxOpenDeliveryApiBindAccountRequest Password(string fieldValue) {
        this.request.BodyString("password", fieldValue);
        return this;
    }

    public WechatWxOpenDeliveryApiBindAccountRequest RemarkContent(string fieldValue) {
        this.request.BodyString("remark_content", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
