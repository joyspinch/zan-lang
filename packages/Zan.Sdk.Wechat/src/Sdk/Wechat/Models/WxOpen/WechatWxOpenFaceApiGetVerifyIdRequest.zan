using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenFaceApiGetVerifyIdRequest {
    WechatTypedRequest request;

    public WechatWxOpenFaceApiGetVerifyIdRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenFaceApiGetVerifyIdRequest OutSeqNo(string fieldValue) {
        this.request.BodyString("out_seq_no", fieldValue);
        return this;
    }

    public WechatWxOpenFaceApiGetVerifyIdRequest CertInfo(WechatWxOpenFaceCertificateInfo fieldValue) {
        this.request.BodyJson("cert_info", Json.Serialize<WechatWxOpenFaceCertificateInfo>(fieldValue));
        return this;
    }

    public WechatWxOpenFaceApiGetVerifyIdRequest Openid(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
