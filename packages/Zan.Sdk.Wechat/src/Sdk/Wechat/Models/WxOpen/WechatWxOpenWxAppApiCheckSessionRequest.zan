using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenWxAppApiCheckSessionRequest {
    WechatTypedRequest request;

    public WechatWxOpenWxAppApiCheckSessionRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenWxAppApiCheckSessionRequest OpenId(string fieldValue) {
        this.request.QueryString("openid", fieldValue);
        return this;
    }

    public WechatWxOpenWxAppApiCheckSessionRequest SessionKey(string fieldValue) {
        this.request.QueryString("sessionKey", fieldValue);
        return this;
    }

    public WechatWxOpenWxAppApiCheckSessionRequest Buffer(string fieldValue) {
        this.request.QueryString("buffer", fieldValue);
        return this;
    }

    public WechatWxOpenWxAppApiCheckSessionRequest SigMethod(string fieldValue) {
        this.request.QueryString("sig_method", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
