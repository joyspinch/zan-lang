using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenSecOrderApiUploadCombinedShippingInfoRequest {
    WechatTypedRequest request;

    public WechatWxOpenSecOrderApiUploadCombinedShippingInfoRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenSecOrderApiUploadCombinedShippingInfoRequest OrderKey(WechatWxOpenOrderKeyModel fieldValue) {
        this.request.BodyJson("order_key", Json.Serialize<WechatWxOpenOrderKeyModel>(fieldValue));
        return this;
    }

    WechatWxOpenSecOrderApiUploadCombinedShippingInfoRequest SubOrders(List<WechatWxOpenSubOrdersModel> fieldValue) {
        this.request.BodyJson("sub_orders", Json.Serialize<List<WechatWxOpenSubOrdersModel>>(fieldValue));
        return this;
    }

    WechatWxOpenSecOrderApiUploadCombinedShippingInfoRequest UploadTime(string fieldValue) {
        this.request.BodyString("upload_time", fieldValue);
        return this;
    }

    WechatWxOpenSecOrderApiUploadCombinedShippingInfoRequest Payer(WechatWxOpenPayerModel fieldValue) {
        this.request.BodyJson("payer", Json.Serialize<WechatWxOpenPayerModel>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
