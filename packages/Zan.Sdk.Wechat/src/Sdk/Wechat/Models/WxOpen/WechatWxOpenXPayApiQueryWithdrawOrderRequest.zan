using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenXPayApiQueryWithdrawOrderRequest {
    WechatTypedRequest request;

    public WechatWxOpenXPayApiQueryWithdrawOrderRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenXPayApiQueryWithdrawOrderRequest WithdrawNo(string fieldValue) {
        this.request.BodyString("withdraw_no", fieldValue);
        return this;
    }

    public WechatWxOpenXPayApiQueryWithdrawOrderRequest Env(int fieldValue) {
        this.request.BodyInt("env", fieldValue);
        return this;
    }

    public WechatWxOpenXPayApiQueryWithdrawOrderRequest PaySig(string fieldValue) {
        this.request.QueryString("pay_sig", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
