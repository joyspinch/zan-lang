using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenNovelApiListChaptersRequest {
    WechatTypedRequest request;

    public WechatWxOpenNovelApiListChaptersRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenNovelApiListChaptersRequest BookId(string fieldValue) {
        this.request.BodyString("book_id", fieldValue);
        return this;
    }

    public WechatWxOpenNovelApiListChaptersRequest NeedEditedData(bool fieldValue) {
        this.request.BodyBool("need_edited_data", fieldValue);
        return this;
    }

    public WechatWxOpenNovelApiListChaptersRequest Limit(int fieldValue) {
        this.request.BodyInt("limit", fieldValue);
        return this;
    }

    public WechatWxOpenNovelApiListChaptersRequest Offset(int fieldValue) {
        this.request.BodyInt("offset", fieldValue);
        return this;
    }

    public WechatWxOpenNovelApiListChaptersRequest VolumeIndex(int fieldValue) {
        this.request.BodyInt("volume_index", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
