using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenDeliveryProviderApiUpdateBusinessRequest {
    WechatTypedRequest request;

    public WechatWxOpenDeliveryProviderApiUpdateBusinessRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenDeliveryProviderApiUpdateBusinessRequest ShopAppId(string fieldValue) {
        this.request.BodyString("shop_app_id", fieldValue);
        return this;
    }

    WechatWxOpenDeliveryProviderApiUpdateBusinessRequest BizId(string fieldValue) {
        this.request.BodyString("biz_id", fieldValue);
        return this;
    }

    WechatWxOpenDeliveryProviderApiUpdateBusinessRequest ResultCode(int fieldValue) {
        this.request.BodyInt("result_code", fieldValue);
        return this;
    }

    WechatWxOpenDeliveryProviderApiUpdateBusinessRequest ResultMsg(string fieldValue) {
        this.request.BodyString("result_msg", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
