using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenWxAppApiDevPluginRequest {
    WechatTypedRequest request;

    public WechatWxOpenWxAppApiDevPluginRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenWxAppApiDevPluginRequest Page(int fieldValue) {
        this.request.BodyInt("page", fieldValue);
        return this;
    }

    WechatWxOpenWxAppApiDevPluginRequest Num(int fieldValue) {
        this.request.BodyInt("num", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
