using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenLiveBroadcastApiUpdateFeedPublicRequest {
    WechatTypedRequest request;

    public WechatWxOpenLiveBroadcastApiUpdateFeedPublicRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenLiveBroadcastApiUpdateFeedPublicRequest RoomId(long fieldValue) {
        this.request.BodyLong("roomId", fieldValue);
        return this;
    }

    public WechatWxOpenLiveBroadcastApiUpdateFeedPublicRequest IsFeedsPublic(int fieldValue) {
        this.request.BodyInt("isFeedsPublic", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
