using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenTemplateApiDelRequest {
    WechatTypedRequest request;

    public WechatWxOpenTemplateApiDelRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenTemplateApiDelRequest TemplateId(string fieldValue) {
        this.request.BodyString("template_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
