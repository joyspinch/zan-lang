using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenXPayApiUploadVpFileRequest {
    WechatTypedRequest request;

    public WechatWxOpenXPayApiUploadVpFileRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenXPayApiUploadVpFileRequest Base64Img(string fieldValue) {
        this.request.BodyString("base64_img", fieldValue);
        return this;
    }

    public WechatWxOpenXPayApiUploadVpFileRequest ImgUrl(string fieldValue) {
        this.request.BodyString("img_url", fieldValue);
        return this;
    }

    public WechatWxOpenXPayApiUploadVpFileRequest FileName(string fieldValue) {
        this.request.BodyString("file_name", fieldValue);
        return this;
    }

    public WechatWxOpenXPayApiUploadVpFileRequest Env(int fieldValue) {
        this.request.BodyInt("env", fieldValue);
        return this;
    }

    public WechatWxOpenXPayApiUploadVpFileRequest PaySig(string fieldValue) {
        this.request.QueryString("pay_sig", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
