using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenTcbApiUpdateIndexRequest {
    WechatTypedRequest request;

    public WechatWxOpenTcbApiUpdateIndexRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenTcbApiUpdateIndexRequest Env(string fieldValue) {
        this.request.BodyString("env", fieldValue);
        return this;
    }

    public WechatWxOpenTcbApiUpdateIndexRequest CollectionName(string fieldValue) {
        this.request.BodyString("collection_name", fieldValue);
        return this;
    }

    public WechatWxOpenTcbApiUpdateIndexRequest CreateIndexes(List<WechatWxOpenCreateIndex> fieldValue) {
        this.request.BodyJson("create_indexes", Json.Serialize<List<WechatWxOpenCreateIndex>>(fieldValue));
        return this;
    }

    public WechatWxOpenTcbApiUpdateIndexRequest DropIndexes(List<WechatWxOpenDropIndex> fieldValue) {
        this.request.BodyJson("drop_indexes", Json.Serialize<List<WechatWxOpenDropIndex>>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
