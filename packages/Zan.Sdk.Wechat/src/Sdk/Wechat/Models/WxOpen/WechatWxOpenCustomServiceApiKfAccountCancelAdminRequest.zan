using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenCustomServiceApiKfAccountCancelAdminRequest {
    WechatTypedRequest request;

    public WechatWxOpenCustomServiceApiKfAccountCancelAdminRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenCustomServiceApiKfAccountCancelAdminRequest KfOpenid(string fieldValue) {
        this.request.BodyString("kf_openid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
