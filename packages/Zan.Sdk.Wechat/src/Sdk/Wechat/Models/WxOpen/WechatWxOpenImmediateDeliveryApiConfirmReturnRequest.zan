using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenImmediateDeliveryApiConfirmReturnRequest {
    WechatTypedRequest request;

    public WechatWxOpenImmediateDeliveryApiConfirmReturnRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenImmediateDeliveryApiConfirmReturnRequest Shopid(string fieldValue) {
        this.request.BodyString("shopid", fieldValue);
        return this;
    }

    public WechatWxOpenImmediateDeliveryApiConfirmReturnRequest ShopOrderId(string fieldValue) {
        this.request.BodyString("shop_order_id", fieldValue);
        return this;
    }

    public WechatWxOpenImmediateDeliveryApiConfirmReturnRequest WaybillId(string fieldValue) {
        this.request.BodyString("waybill_id", fieldValue);
        return this;
    }

    public WechatWxOpenImmediateDeliveryApiConfirmReturnRequest DeliverySign(string fieldValue) {
        this.request.BodyString("delivery_sign", fieldValue);
        return this;
    }

    public WechatWxOpenImmediateDeliveryApiConfirmReturnRequest ShopNo(string fieldValue) {
        this.request.BodyString("shop_no", fieldValue);
        return this;
    }

    public WechatWxOpenImmediateDeliveryApiConfirmReturnRequest Remark(string fieldValue) {
        this.request.BodyString("remark", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
