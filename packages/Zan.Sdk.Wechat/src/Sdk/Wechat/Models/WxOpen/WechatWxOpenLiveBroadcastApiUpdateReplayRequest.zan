using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenLiveBroadcastApiUpdateReplayRequest {
    WechatTypedRequest request;

    public WechatWxOpenLiveBroadcastApiUpdateReplayRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenLiveBroadcastApiUpdateReplayRequest RoomId(long fieldValue) {
        this.request.BodyLong("roomId", fieldValue);
        return this;
    }

    public WechatWxOpenLiveBroadcastApiUpdateReplayRequest CloseReplay(int fieldValue) {
        this.request.BodyInt("closeReplay", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
