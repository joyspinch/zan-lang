    }

    public WechatWxOpenExpressApiCancelOrderRequest ShopOrderId(string fieldValue) {
        this.request.BodyString("shop_order_id", fieldValue);
        return this;
    }

    public WechatWxOpenExpressApiCancelOrderRequest ShopNo(string fieldValue) {
        this.request.BodyString("shop_no", fieldValue);
        return this;
    }

