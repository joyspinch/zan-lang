        this.request.BodyString("delivery_sign", fieldValue);
        return this;
    }

    public WechatWxOpenExpressApiCancelOrderRequest DeliveryId(string fieldValue) {
        this.request.BodyString("delivery_id", fieldValue);
        return this;
    }

    public WechatWxOpenExpressApiCancelOrderRequest WaybillId(string fieldValue) {
        this.request.BodyString("waybill_id", fieldValue);
        return this;
    }

    public WechatWxOpenExpressApiCancelOrderRequest CancelReasonId(int fieldValue) {
        this.request.BodyInt("cancel_reason_id", fieldValue);
        return this;
    }

    public WechatWxOpenExpressApiCancelOrderRequest CancelReason(string fieldValue) {
