using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenXPayApiDownloadBillRequest {
    WechatTypedRequest request;

    public WechatWxOpenXPayApiDownloadBillRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenXPayApiDownloadBillRequest BeginDs(long fieldValue) {
        this.request.QueryLong("begin_ds", fieldValue);
        return this;
    }

    public WechatWxOpenXPayApiDownloadBillRequest EndDs(long fieldValue) {
        this.request.BodyLong("end_ds", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
