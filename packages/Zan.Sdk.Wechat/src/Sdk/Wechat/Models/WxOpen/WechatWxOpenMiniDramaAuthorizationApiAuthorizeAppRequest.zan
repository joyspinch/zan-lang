using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenMiniDramaAuthorizationApiAuthorizeAppRequest {
    WechatTypedRequest request;

    public WechatWxOpenMiniDramaAuthorizationApiAuthorizeAppRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenMiniDramaAuthorizationApiAuthorizeAppRequest AuthorizedAppid(string fieldValue) {
        this.request.BodyString("authorized_appid", fieldValue);
        return this;
    }

    public WechatWxOpenMiniDramaAuthorizationApiAuthorizeAppRequest AuthzExpireTime(long fieldValue) {
        this.request.BodyLong("authz_expire_time", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
