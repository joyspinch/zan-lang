using System;
using System.Text;
using System.Json;
using Sdk.Wechat;

namespace Sdk.Wechat.WxOpen;

class WechatWxOpenSpecialBillRequest {
    WechatTypedRequest request;
    public WechatWxOpenSpecialBillRequest() { this.request = new WechatTypedRequest(); }
    WechatWxOpenSpecialBillRequest Date(string fieldValue) {
        this.request.BodyString("date", fieldValue); return this;
    }
    WechatWxOpenSpecialBillRequest Type(string fieldValue) {
        this.request.BodyString("type", fieldValue); return this;
    }
    string JsonBody() { return this.request.JsonBody(); }
}
