using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenImmediateDeliveryApiBindAccountRequest {
    WechatTypedRequest request;

    public WechatWxOpenImmediateDeliveryApiBindAccountRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenImmediateDeliveryApiBindAccountRequest DeliveryId(string fieldValue) {
        this.request.BodyString("delivery_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
