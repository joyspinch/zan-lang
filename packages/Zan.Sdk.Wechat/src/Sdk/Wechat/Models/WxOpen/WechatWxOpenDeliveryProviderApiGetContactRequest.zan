using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenDeliveryProviderApiGetContactRequest {
    WechatTypedRequest request;

    public WechatWxOpenDeliveryProviderApiGetContactRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenDeliveryProviderApiGetContactRequest Token(string fieldValue) {
        this.request.BodyString("token", fieldValue);
        return this;
    }

    WechatWxOpenDeliveryProviderApiGetContactRequest WaybillId(string fieldValue) {
        this.request.BodyString("waybill_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
