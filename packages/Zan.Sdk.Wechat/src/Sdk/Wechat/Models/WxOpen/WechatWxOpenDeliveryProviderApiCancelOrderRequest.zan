using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenDeliveryProviderApiCancelOrderRequest {
    WechatTypedRequest request;

    public WechatWxOpenDeliveryProviderApiCancelOrderRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenDeliveryProviderApiCancelOrderRequest Token(string fieldValue) {
        this.request.BodyString("token", fieldValue);
        return this;
    }

    public WechatWxOpenDeliveryProviderApiCancelOrderRequest Reason(string fieldValue) {
        this.request.BodyString("reason", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
