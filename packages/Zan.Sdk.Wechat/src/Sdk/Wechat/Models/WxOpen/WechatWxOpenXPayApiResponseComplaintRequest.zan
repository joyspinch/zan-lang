using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenXPayApiResponseComplaintRequest {
    WechatTypedRequest request;

    public WechatWxOpenXPayApiResponseComplaintRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenXPayApiResponseComplaintRequest ComplaintId(string fieldValue) {
        this.request.BodyString("complaint_id", fieldValue);
        return this;
    }

    WechatWxOpenXPayApiResponseComplaintRequest ResponseContent(string fieldValue) {
        this.request.BodyString("response_content", fieldValue);
        return this;
    }

    WechatWxOpenXPayApiResponseComplaintRequest ResponseImages(List<string> fieldValue) {
        this.request.BodyStrings("response_images", fieldValue);
        return this;
    }

    WechatWxOpenXPayApiResponseComplaintRequest Env(int fieldValue) {
        this.request.BodyInt("env", fieldValue);
        return this;
    }

    WechatWxOpenXPayApiResponseComplaintRequest PaySig(string fieldValue) {
        this.request.QueryString("pay_sig", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
