using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenChargeApiUsageRequest {
    WechatTypedRequest request;

    public WechatWxOpenChargeApiUsageRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenChargeApiUsageRequest SpuId(string fieldValue) {
        this.request.QueryString("spuId", fieldValue);
        return this;
    }

    public WechatWxOpenChargeApiUsageRequest Offset(int fieldValue) {
        this.request.QueryInt("offset", fieldValue);
        return this;
    }

    public WechatWxOpenChargeApiUsageRequest Limit(int fieldValue) {
        this.request.QueryInt("limit", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
