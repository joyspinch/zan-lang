using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenXPayApiCreateWithdrawOrderRequest {
    WechatTypedRequest request;

    public WechatWxOpenXPayApiCreateWithdrawOrderRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenXPayApiCreateWithdrawOrderRequest WithdrawNo(string fieldValue) {
        this.request.BodyString("withdraw_no", fieldValue);
        return this;
    }

    public WechatWxOpenXPayApiCreateWithdrawOrderRequest WithdrawAmount(string fieldValue) {
        this.request.BodyString("withdraw_amount", fieldValue);
        return this;
    }

    public WechatWxOpenXPayApiCreateWithdrawOrderRequest Env(int fieldValue) {
        this.request.BodyInt("env", fieldValue);
        return this;
    }

    public WechatWxOpenXPayApiCreateWithdrawOrderRequest PaySig(string fieldValue) {
        this.request.QueryString("pay_sig", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
