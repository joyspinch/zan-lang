using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenLiveBroadcastApiAddAssistantsRequest {
    WechatTypedRequest request;

    public WechatWxOpenLiveBroadcastApiAddAssistantsRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenLiveBroadcastApiAddAssistantsRequest RoomId(long fieldValue) {
        this.request.BodyLong("roomId", fieldValue);
        return this;
    }

    public WechatWxOpenLiveBroadcastApiAddAssistantsRequest Users(List<WechatWxOpenLiveBroadcastAssistantUser> fieldValue) {
        this.request.BodyJson("users", Json.Serialize<List<WechatWxOpenLiveBroadcastAssistantUser>>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
