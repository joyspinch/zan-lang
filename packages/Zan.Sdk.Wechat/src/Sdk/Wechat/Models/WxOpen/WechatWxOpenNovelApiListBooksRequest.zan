using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenNovelApiListBooksRequest {
    WechatTypedRequest request;

    public WechatWxOpenNovelApiListBooksRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenNovelApiListBooksRequest Limit(int fieldValue) {
        this.request.BodyInt("limit", fieldValue);
        return this;
    }

    WechatWxOpenNovelApiListBooksRequest Offset(int fieldValue) {
        this.request.BodyInt("offset", fieldValue);
        return this;
    }

    WechatWxOpenNovelApiListBooksRequest LastId(long fieldValue) {
        this.request.BodyLong("last_id", fieldValue);
        return this;
    }

    WechatWxOpenNovelApiListBooksRequest NeedEditedData(bool fieldValue) {
        this.request.BodyBool("need_edited_data", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
