using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenB2BOrderApiCloseOrderRequest {
    WechatTypedRequest request;

    public WechatWxOpenB2BOrderApiCloseOrderRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenB2BOrderApiCloseOrderRequest Mchid(string fieldValue) {
        this.request.BodyString("mchid", fieldValue);
        return this;
    }

    public WechatWxOpenB2BOrderApiCloseOrderRequest OutTradeNo(string fieldValue) {
        this.request.BodyString("out_trade_no", fieldValue);
        return this;
    }

    public WechatWxOpenB2BOrderApiCloseOrderRequest OrderId(string fieldValue) {
        this.request.BodyString("order_id", fieldValue);
        return this;
    }

    public WechatWxOpenB2BOrderApiCloseOrderRequest PaySig(string fieldValue) {
        this.request.BodyString("paySig", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
