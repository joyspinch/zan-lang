using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenCustomApiSendMiniProgramPageRequest {
    WechatTypedRequest request;

    public WechatWxOpenCustomApiSendMiniProgramPageRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenCustomApiSendMiniProgramPageRequest Title(string fieldValue) {
        this.request.BodyString("title", fieldValue);
        return this;
    }

    public WechatWxOpenCustomApiSendMiniProgramPageRequest PagePath(string fieldValue) {
        this.request.BodyString("pagepath", fieldValue);
        return this;
    }

    public WechatWxOpenCustomApiSendMiniProgramPageRequest ThumbMediaId(string fieldValue) {
        this.request.BodyString("url", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
