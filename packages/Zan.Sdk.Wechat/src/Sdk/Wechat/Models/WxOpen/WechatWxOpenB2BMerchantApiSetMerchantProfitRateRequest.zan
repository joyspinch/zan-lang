using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenB2BMerchantApiSetMerchantProfitRateRequest {
    WechatTypedRequest request;

    public WechatWxOpenB2BMerchantApiSetMerchantProfitRateRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenB2BMerchantApiSetMerchantProfitRateRequest SubMchid(string fieldValue) {
        this.request.BodyString("sub_mchid", fieldValue);
        return this;
    }

    WechatWxOpenB2BMerchantApiSetMerchantProfitRateRequest ProfitRate(int fieldValue) {
        this.request.BodyInt("profit_rate", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
