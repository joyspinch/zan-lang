using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenXPayApiCompleteComplaintRequest {
    WechatTypedRequest request;

    public WechatWxOpenXPayApiCompleteComplaintRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenXPayApiCompleteComplaintRequest ComplaintId(string fieldValue) {
        this.request.BodyString("complaint_id", fieldValue);
        return this;
    }

    public WechatWxOpenXPayApiCompleteComplaintRequest Env(int fieldValue) {
        this.request.BodyInt("env", fieldValue);
        return this;
    }

    public WechatWxOpenXPayApiCompleteComplaintRequest PaySig(string fieldValue) {
        this.request.QueryString("pay_sig", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
