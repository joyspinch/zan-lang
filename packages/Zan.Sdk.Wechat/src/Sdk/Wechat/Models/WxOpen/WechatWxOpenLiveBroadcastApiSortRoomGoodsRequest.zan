using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenLiveBroadcastApiSortRoomGoodsRequest {
    WechatTypedRequest request;

    public WechatWxOpenLiveBroadcastApiSortRoomGoodsRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenLiveBroadcastApiSortRoomGoodsRequest RoomId(long fieldValue) {
        this.request.BodyLong("roomId", fieldValue);
        return this;
    }

    WechatWxOpenLiveBroadcastApiSortRoomGoodsRequest Goods(List<WechatWxOpenLiveBroadcastGoodsId> fieldValue) {
        this.request.BodyJson("goods", Json.Serialize<List<WechatWxOpenLiveBroadcastGoodsId>>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
