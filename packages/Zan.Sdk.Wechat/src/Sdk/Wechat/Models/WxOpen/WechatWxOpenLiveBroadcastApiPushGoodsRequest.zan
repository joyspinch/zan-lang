using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenLiveBroadcastApiPushGoodsRequest {
    WechatTypedRequest request;

    public WechatWxOpenLiveBroadcastApiPushGoodsRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenLiveBroadcastApiPushGoodsRequest RoomId(long fieldValue) {
        this.request.BodyLong("roomId", fieldValue);
        return this;
    }

    public WechatWxOpenLiveBroadcastApiPushGoodsRequest GoodsId(long fieldValue) {
        this.request.BodyLong("goodsId", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
