using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenXPayApiStartUploadGoodsRequest {
    WechatTypedRequest request;

    public WechatWxOpenXPayApiStartUploadGoodsRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenXPayApiStartUploadGoodsRequest UploadItem(List<WechatWxOpenStartUploadGoodsItem> fieldValue) {
        this.request.BodyJson("upload_item", Json.Serialize<List<WechatWxOpenStartUploadGoodsItem>>(fieldValue));
        return this;
    }

    public WechatWxOpenXPayApiStartUploadGoodsRequest Env(int fieldValue) {
        this.request.BodyInt("env", fieldValue);
        return this;
    }

    public WechatWxOpenXPayApiStartUploadGoodsRequest PaySig(string fieldValue) {
        this.request.QueryString("pay_sig", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
