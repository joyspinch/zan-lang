using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenSecOrderApiNotifyConfirmReceiveRequest {
    WechatTypedRequest request;

    public WechatWxOpenSecOrderApiNotifyConfirmReceiveRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenSecOrderApiNotifyConfirmReceiveRequest ReceiveTime(long fieldValue) {
        this.request.BodyLong("receive_time", fieldValue);
        return this;
    }

    WechatWxOpenSecOrderApiNotifyConfirmReceiveRequest TransactionId(string fieldValue) {
        this.request.BodyString("transaction_id", fieldValue);
        return this;
    }

    WechatWxOpenSecOrderApiNotifyConfirmReceiveRequest MerchantId(string fieldValue) {
        this.request.BodyString("merchant_id", fieldValue);
        return this;
    }

    WechatWxOpenSecOrderApiNotifyConfirmReceiveRequest SubMerchantId(string fieldValue) {
        this.request.BodyString("sub_merchant_id", fieldValue);
        return this;
    }

    WechatWxOpenSecOrderApiNotifyConfirmReceiveRequest MerchantTradeNo(string fieldValue) {
        this.request.BodyString("merchant_trade_no", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
