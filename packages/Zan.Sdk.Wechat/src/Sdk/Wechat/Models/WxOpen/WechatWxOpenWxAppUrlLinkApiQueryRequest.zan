using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenWxAppUrlLinkApiQueryRequest {
    WechatTypedRequest request;

    public WechatWxOpenWxAppUrlLinkApiQueryRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenWxAppUrlLinkApiQueryRequest UrlLink(string fieldValue) {
        this.request.BodyString("url_link", fieldValue);
        return this;
    }

    WechatWxOpenWxAppUrlLinkApiQueryRequest QueryType(int fieldValue) {
        this.request.BodyInt("query_type", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
