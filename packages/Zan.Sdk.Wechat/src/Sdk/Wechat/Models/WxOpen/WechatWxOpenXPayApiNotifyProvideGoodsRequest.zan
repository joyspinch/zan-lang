using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenXPayApiNotifyProvideGoodsRequest {
    WechatTypedRequest request;

    public WechatWxOpenXPayApiNotifyProvideGoodsRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenXPayApiNotifyProvideGoodsRequest OrderId(string fieldValue) {
        this.request.BodyString("order_id", fieldValue);
        return this;
    }

    WechatWxOpenXPayApiNotifyProvideGoodsRequest WxOrderId(string fieldValue) {
        this.request.BodyString("wx_order_id", fieldValue);
        return this;
    }

    WechatWxOpenXPayApiNotifyProvideGoodsRequest Env(int fieldValue) {
        this.request.BodyInt("env", fieldValue);
        return this;
    }

    WechatWxOpenXPayApiNotifyProvideGoodsRequest PaySig(string fieldValue) {
        this.request.QueryString("pay_sig", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
