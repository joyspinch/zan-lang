using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenMessageApiSendSubscribeRequest {
    WechatTypedRequest request;

    public WechatWxOpenMessageApiSendSubscribeRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenMessageApiSendSubscribeRequest ToUser(string fieldValue) {
        this.request.BodyString("touser", fieldValue);
        return this;
    }

    public WechatWxOpenMessageApiSendSubscribeRequest TemplateId(string fieldValue) {
        this.request.BodyString("template_id", fieldValue);
        return this;
    }

    public WechatWxOpenMessageApiSendSubscribeRequest Page(string fieldValue) {
        this.request.BodyString("page", fieldValue);
        return this;
    }

    public WechatWxOpenMessageApiSendSubscribeRequest Data(JsonValue fieldValue) {
        this.request.BodyValue("data", fieldValue);
        return this;
    }

    public WechatWxOpenMessageApiSendSubscribeRequest MiniprogramState(string fieldValue) {
        this.request.BodyString("miniprogram_state", fieldValue);
        return this;
    }

    public WechatWxOpenMessageApiSendSubscribeRequest Lang(string fieldValue) {
        this.request.BodyString("lang", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
