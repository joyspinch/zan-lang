using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenDeliveryProviderApiPreviewTemplateRequest {
    WechatTypedRequest request;

    public WechatWxOpenDeliveryProviderApiPreviewTemplateRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenDeliveryProviderApiPreviewTemplateRequest WaybillId(string fieldValue) {
        this.request.BodyString("waybill_id", fieldValue);
        return this;
    }

    public WechatWxOpenDeliveryProviderApiPreviewTemplateRequest WaybillTemplate(string fieldValue) {
        this.request.BodyString("waybill_template", fieldValue);
        return this;
    }

    public WechatWxOpenDeliveryProviderApiPreviewTemplateRequest WaybillData(string fieldValue) {
        this.request.BodyString("waybill_data", fieldValue);
        return this;
    }

    public WechatWxOpenDeliveryProviderApiPreviewTemplateRequest Custom(WechatWxOpenDeliveryDeliveryJsonAddOrderModel fieldValue) {
        this.request.BodyJson("custom", Json.Serialize<WechatWxOpenDeliveryDeliveryJsonAddOrderModel>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
