using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenB2BOrderApiSetAutoWithdrawRequest {
    WechatTypedRequest request;

    public WechatWxOpenB2BOrderApiSetAutoWithdrawRequest() { this.request = new WechatTypedRequest(); }

    public WechatWxOpenB2BOrderApiSetAutoWithdrawRequest Status(int fieldValue) {
        this.request.BodyInt("status", fieldValue);
        return this;
    }

    public WechatWxOpenB2BOrderApiSetAutoWithdrawRequest RetainAmt(long fieldValue) {
        this.request.BodyLong("retain_amt", fieldValue);
        return this;
    }

    public WechatWxOpenB2BOrderApiSetAutoWithdrawRequest Mchid(string fieldValue) {
        this.request.BodyString("mchid", fieldValue);
        return this;
    }

    public WechatWxOpenB2BOrderApiSetAutoWithdrawRequest PaySig(string fieldValue) {
        this.request.BodyString("paySig", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
