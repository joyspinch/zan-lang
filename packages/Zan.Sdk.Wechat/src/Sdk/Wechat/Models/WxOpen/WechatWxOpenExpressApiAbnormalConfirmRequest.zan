using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenExpressApiAbnormalConfirmRequest {
    WechatTypedRequest request;

    public WechatWxOpenExpressApiAbnormalConfirmRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenExpressApiAbnormalConfirmRequest Shopid(string fieldValue) {
        this.request.BodyString("shopid", fieldValue);
        return this;
    }

    WechatWxOpenExpressApiAbnormalConfirmRequest ShopOrderId(string fieldValue) {
        this.request.BodyString("shop_order_id", fieldValue);
        return this;
    }

    WechatWxOpenExpressApiAbnormalConfirmRequest ShopNo(string fieldValue) {
        this.request.BodyString("shop_no", fieldValue);
        return this;
    }

    WechatWxOpenExpressApiAbnormalConfirmRequest DeliverySign(string fieldValue) {
        this.request.BodyString("delivery_sign", fieldValue);
        return this;
    }

    WechatWxOpenExpressApiAbnormalConfirmRequest WaybillId(string fieldValue) {
        this.request.BodyString("waybill_id", fieldValue);
        return this;
    }

    WechatWxOpenExpressApiAbnormalConfirmRequest Remark(string fieldValue) {
        this.request.BodyString("remark", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
