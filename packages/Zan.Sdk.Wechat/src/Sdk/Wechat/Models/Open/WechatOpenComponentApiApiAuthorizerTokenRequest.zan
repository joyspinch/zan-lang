using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenComponentApiApiAuthorizerTokenRequest {
    WechatTypedRequest request;

    public WechatOpenComponentApiApiAuthorizerTokenRequest() { this.request = new WechatTypedRequest(); }

    public WechatOpenComponentApiApiAuthorizerTokenRequest ComponentAppId(string fieldValue) {
        this.request.BodyString("component_appid", fieldValue);
        return this;
    }

    public WechatOpenComponentApiApiAuthorizerTokenRequest AuthorizerAppId(string fieldValue) {
        this.request.BodyString("authorizer_appid", fieldValue);
        return this;
    }

    public WechatOpenComponentApiApiAuthorizerTokenRequest AuthorizerRefreshToken(string fieldValue) {
        this.request.BodyString("authorizer_refresh_token", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
