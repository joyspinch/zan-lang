using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenComponentApiGetAuthorizerOptionRequest {
    WechatTypedRequest request;

    public WechatOpenComponentApiGetAuthorizerOptionRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenComponentApiGetAuthorizerOptionRequest ComponentAppId(string fieldValue) {
        this.request.BodyString("component_appid", fieldValue);
        return this;
    }

    WechatOpenComponentApiGetAuthorizerOptionRequest AuthorizerAppId(string fieldValue) {
        this.request.BodyString("authorizer_appid", fieldValue);
        return this;
    }

    WechatOpenComponentApiGetAuthorizerOptionRequest OptionName(int fieldValue) {
        this.request.BodyInt("option_name", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
