using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenCodeApiSetWeappSupportVersionRequest {
    WechatTypedRequest request;

    public WechatOpenCodeApiSetWeappSupportVersionRequest() { this.request = new WechatTypedRequest(); }

    public WechatOpenCodeApiSetWeappSupportVersionRequest Version(string fieldValue) {
        this.request.BodyString("version", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
