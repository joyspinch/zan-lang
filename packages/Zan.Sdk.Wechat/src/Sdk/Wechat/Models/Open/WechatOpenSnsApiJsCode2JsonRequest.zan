using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenSnsApiJsCode2JsonRequest {
    WechatTypedRequest request;

    public WechatOpenSnsApiJsCode2JsonRequest() { this.request = new WechatTypedRequest(); }

    public WechatOpenSnsApiJsCode2JsonRequest AppId(string fieldValue) {
        this.request.QueryString("appid", fieldValue);
        return this;
    }

    public WechatOpenSnsApiJsCode2JsonRequest ComponentAppId(string fieldValue) {
        this.request.QueryString("component_appid", fieldValue);
        return this;
    }

    public WechatOpenSnsApiJsCode2JsonRequest JsCode(string fieldValue) {
        this.request.QueryString("js_code", fieldValue);
        return this;
    }

    public WechatOpenSnsApiJsCode2JsonRequest GrantType(string fieldValue) {
        this.request.QueryString("grant_type", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
