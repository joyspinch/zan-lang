using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenSecOrderApiNotifyConfirmReceiveRequest {
    WechatTypedRequest request;

    public WechatOpenSecOrderApiNotifyConfirmReceiveRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenSecOrderApiNotifyConfirmReceiveRequest TransactionId(string fieldValue) {
        this.request.BodyString("transaction_id", fieldValue);
        return this;
    }

    WechatOpenSecOrderApiNotifyConfirmReceiveRequest MerchantId(string fieldValue) {
        this.request.BodyString("merchant_id", fieldValue);
        return this;
    }

    WechatOpenSecOrderApiNotifyConfirmReceiveRequest SubMerchantId(string fieldValue) {
        this.request.BodyString("sub_merchant_id", fieldValue);
        return this;
    }

    WechatOpenSecOrderApiNotifyConfirmReceiveRequest MerchantTradeNo(string fieldValue) {
        this.request.BodyString("merchant_trade_no", fieldValue);
        return this;
    }

    WechatOpenSecOrderApiNotifyConfirmReceiveRequest ReceivedTime(long fieldValue) {
        this.request.BodyLong("received_time", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
