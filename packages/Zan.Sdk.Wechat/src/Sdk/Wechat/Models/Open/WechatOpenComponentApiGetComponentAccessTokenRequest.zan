using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenComponentApiGetComponentAccessTokenRequest {
    WechatTypedRequest request;

    public WechatOpenComponentApiGetComponentAccessTokenRequest() { this.request = new WechatTypedRequest(); }

    public WechatOpenComponentApiGetComponentAccessTokenRequest ComponentAppId(string fieldValue) {
        this.request.BodyString("component_appid", fieldValue);
        return this;
    }

    public WechatOpenComponentApiGetComponentAccessTokenRequest ComponentAppSecret(string fieldValue) {
        this.request.BodyString("component_appsecret", fieldValue);
        return this;
    }

    public WechatOpenComponentApiGetComponentAccessTokenRequest ComponentVerifyTicket(string fieldValue) {
        this.request.BodyString("component_verify_ticket", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
