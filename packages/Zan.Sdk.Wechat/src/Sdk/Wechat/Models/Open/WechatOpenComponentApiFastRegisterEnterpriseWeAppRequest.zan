using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenComponentApiFastRegisterEnterpriseWeAppRequest {
    WechatTypedRequest request;

    public WechatOpenComponentApiFastRegisterEnterpriseWeAppRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenComponentApiFastRegisterEnterpriseWeAppRequest EntName(string fieldValue) {
        this.request.QueryString("name", fieldValue);
        return this;
    }

    WechatOpenComponentApiFastRegisterEnterpriseWeAppRequest EntCode(string fieldValue) {
        this.request.BodyString("code", fieldValue);
        return this;
    }

    WechatOpenComponentApiFastRegisterEnterpriseWeAppRequest CodeType(int fieldValue) {
        this.request.BodyInt("code_type", fieldValue);
        return this;
    }

    WechatOpenComponentApiFastRegisterEnterpriseWeAppRequest LegalPersonaOpenId(string fieldValue) {
        this.request.BodyString("legal_persona_openid", fieldValue);
        return this;
    }

    WechatOpenComponentApiFastRegisterEnterpriseWeAppRequest LegalPersonaName(string fieldValue) {
        this.request.BodyString("legal_persona_name", fieldValue);
        return this;
    }

    WechatOpenComponentApiFastRegisterEnterpriseWeAppRequest ComponentPhone(string fieldValue) {
        this.request.BodyString("component_phone", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
