using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenWxaApiGetAppealRecordsRequest {
    WechatTypedRequest request;

    public WechatOpenWxaApiGetAppealRecordsRequest() { this.request = new WechatTypedRequest(); }

    public WechatOpenWxaApiGetAppealRecordsRequest IllegalRecordId(string fieldValue) {
        this.request.BodyString("illegal_record_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
