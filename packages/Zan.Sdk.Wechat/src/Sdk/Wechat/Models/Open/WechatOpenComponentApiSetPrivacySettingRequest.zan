using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenComponentApiSetPrivacySettingRequest {
    WechatTypedRequest request;

    public WechatOpenComponentApiSetPrivacySettingRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenComponentApiSetPrivacySettingRequest ContactEmail(string fieldValue) {
        this.request.BodyString("contact_email", fieldValue);
        return this;
    }

    WechatOpenComponentApiSetPrivacySettingRequest ContactPhone(string fieldValue) {
        this.request.BodyString("contact_phone", fieldValue);
        return this;
    }

    WechatOpenComponentApiSetPrivacySettingRequest ContactQq(string fieldValue) {
        this.request.BodyString("contact_qq", fieldValue);
        return this;
    }

    WechatOpenComponentApiSetPrivacySettingRequest ContactWeixin(string fieldValue) {
        this.request.BodyString("contact_weixin", fieldValue);
        return this;
    }

    WechatOpenComponentApiSetPrivacySettingRequest ExtFileMediaId(string fieldValue) {
        this.request.BodyString("ext_file_media_id", fieldValue);
        return this;
    }

    WechatOpenComponentApiSetPrivacySettingRequest NoticeMethod(string fieldValue) {
        this.request.BodyString("notice_method", fieldValue);
        return this;
    }

    WechatOpenComponentApiSetPrivacySettingRequest StoreExpireTimestamp(string fieldValue) {
        this.request.BodyString("store_expire_timestamp", fieldValue);
        return this;
    }

    WechatOpenComponentApiSetPrivacySettingRequest ComponentAccessToken(string fieldValue) {
        this.request.BodyString("componentAccessToken", fieldValue);
        return this;
    }

    WechatOpenComponentApiSetPrivacySettingRequest SettingList(List<WechatOpenSetPrivacySettingDataSettingList> fieldValue) {
        this.request.BodyJson("settingList", Json.Serialize<List<WechatOpenSetPrivacySettingDataSettingList>>(fieldValue));
        return this;
    }

    WechatOpenComponentApiSetPrivacySettingRequest PrivacyVer(int fieldValue) {
        this.request.BodyInt("privacy_ver", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
