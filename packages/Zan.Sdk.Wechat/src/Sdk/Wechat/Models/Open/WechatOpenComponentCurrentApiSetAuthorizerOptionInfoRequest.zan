using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenComponentCurrentApiSetAuthorizerOptionInfoRequest {
    WechatTypedRequest request;

    public WechatOpenComponentCurrentApiSetAuthorizerOptionInfoRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenComponentCurrentApiSetAuthorizerOptionInfoRequest OptionName(string fieldValue) {
        this.request.BodyString("option_name", fieldValue);
        return this;
    }

    WechatOpenComponentCurrentApiSetAuthorizerOptionInfoRequest OptionValue(string fieldValue) {
        this.request.BodyString("option_value", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
