using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenWxaApiUpdateShowWxaItemRequest {
    WechatTypedRequest request;

    public WechatOpenWxaApiUpdateShowWxaItemRequest() { this.request = new WechatTypedRequest(); }

    public WechatOpenWxaApiUpdateShowWxaItemRequest WxaSubscribeBizFlag(int fieldValue) {
        this.request.BodyInt("wxa_subscribe_biz_flag", fieldValue);
        return this;
    }

    public WechatOpenWxaApiUpdateShowWxaItemRequest Appid(string fieldValue) {
        this.request.BodyString("appid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
