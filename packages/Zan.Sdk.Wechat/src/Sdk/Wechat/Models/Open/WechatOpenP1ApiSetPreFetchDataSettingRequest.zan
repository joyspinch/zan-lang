using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenP1ApiSetPreFetchDataSettingRequest {
    WechatTypedRequest request;

    public WechatOpenP1ApiSetPreFetchDataSettingRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenP1ApiSetPreFetchDataSettingRequest IsOpen(bool fieldValue) {
        this.request.BodyBool("is_pre_fetch_open", fieldValue);
        return this;
    }

    WechatOpenP1ApiSetPreFetchDataSettingRequest FetchType(int fieldValue) {
        this.request.BodyInt("pre_fetch_type", fieldValue);
        return this;
    }

    WechatOpenP1ApiSetPreFetchDataSettingRequest FetchUrl(string fieldValue) {
        this.request.BodyString("pre_fetch_url", fieldValue);
        return this;
    }

    WechatOpenP1ApiSetPreFetchDataSettingRequest EnvironmentId(string fieldValue) {
        this.request.BodyString("pre_env", fieldValue);
        return this;
    }

    WechatOpenP1ApiSetPreFetchDataSettingRequest FunctionName(string fieldValue) {
        this.request.BodyString("pre_function_name", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
