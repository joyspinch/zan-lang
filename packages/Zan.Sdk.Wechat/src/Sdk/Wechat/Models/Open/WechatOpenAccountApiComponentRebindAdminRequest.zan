using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenAccountApiComponentRebindAdminRequest {
    WechatTypedRequest request;

    public WechatOpenAccountApiComponentRebindAdminRequest() { this.request = new WechatTypedRequest(); }

    public WechatOpenAccountApiComponentRebindAdminRequest Taskid(string fieldValue) {
        this.request.BodyString("taskid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
