using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenSecApiWxaAuthRequest {
    WechatTypedRequest request;

    public WechatOpenSecApiWxaAuthRequest() { this.request = new WechatTypedRequest(); }

    public WechatOpenSecApiWxaAuthRequest CustomerType(int fieldValue) {
        this.request.BodyInt("customer_type", fieldValue);
        return this;
    }

    public WechatOpenSecApiWxaAuthRequest Taskid(string fieldValue) {
        this.request.BodyString("taskid", fieldValue);
        return this;
    }

    public WechatOpenSecApiWxaAuthRequest ContactInfo(WechatOpenWxaAuthAuthDataContactInfo fieldValue) {
        this.request.BodyJson("contact_info", Json.Serialize<WechatOpenWxaAuthAuthDataContactInfo>(fieldValue));
        return this;
    }

    public WechatOpenSecApiWxaAuthRequest InvoiceInfo(WechatOpenWxaAuthAuthDataInvoiceInfo fieldValue) {
        this.request.BodyJson("invoice_info", Json.Serialize<WechatOpenWxaAuthAuthDataInvoiceInfo>(fieldValue));
        return this;
    }

    public WechatOpenSecApiWxaAuthRequest Qualification(string fieldValue) {
        this.request.BodyString("qualification", fieldValue);
        return this;
    }

    public WechatOpenSecApiWxaAuthRequest QualificationOther(List<string> fieldValue) {
        this.request.BodyStrings("qualification_other", fieldValue);
        return this;
    }

    public WechatOpenSecApiWxaAuthRequest AccountName(string fieldValue) {
        this.request.BodyString("account_name", fieldValue);
        return this;
    }

    public WechatOpenSecApiWxaAuthRequest AccountNameType(int fieldValue) {
        this.request.BodyInt("account_name_type", fieldValue);
        return this;
    }

    public WechatOpenSecApiWxaAuthRequest AccountSupplemental(List<string> fieldValue) {
        this.request.BodyStrings("account_supplemental", fieldValue);
        return this;
    }

    public WechatOpenSecApiWxaAuthRequest PayType(int fieldValue) {
        this.request.BodyInt("pay_type", fieldValue);
        return this;
    }

    public WechatOpenSecApiWxaAuthRequest AuthIdentification(string fieldValue) {
        this.request.BodyString("auth_identification", fieldValue);
        return this;
    }

    public WechatOpenSecApiWxaAuthRequest AuthIdentMaterial(List<string> fieldValue) {
        this.request.BodyStrings("auth_ident_material", fieldValue);
        return this;
    }

    public WechatOpenSecApiWxaAuthRequest ThirdPartyPhone(string fieldValue) {
        this.request.BodyString("third_party_phone", fieldValue);
        return this;
    }

    public WechatOpenSecApiWxaAuthRequest ServiceAppid(string fieldValue) {
        this.request.BodyString("service_appid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
