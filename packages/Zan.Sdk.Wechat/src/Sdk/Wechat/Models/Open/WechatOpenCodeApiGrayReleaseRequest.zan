using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenCodeApiGrayReleaseRequest {
    WechatTypedRequest request;

    public WechatOpenCodeApiGrayReleaseRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenCodeApiGrayReleaseRequest GrayPercentage(int fieldValue) {
        this.request.BodyInt("gray_percentage", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
