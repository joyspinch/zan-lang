using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenQRConnectApiGetUserInfoRequest {
    WechatTypedRequest request;

    public WechatOpenQRConnectApiGetUserInfoRequest() { this.request = new WechatTypedRequest(); }

    public WechatOpenQRConnectApiGetUserInfoRequest OpenId(string fieldValue) {
        this.request.QueryString("openid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
