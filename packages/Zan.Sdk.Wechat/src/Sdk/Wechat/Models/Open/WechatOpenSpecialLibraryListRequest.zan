using System;
using System.Text;
using System.Json;
using Sdk.Wechat;

namespace Sdk.Wechat.Open;

public class WechatOpenSpecialLibraryListRequest {
    WechatTypedRequest request;
    public WechatOpenSpecialLibraryListRequest() { this.request = new WechatTypedRequest(); }
    WechatOpenSpecialLibraryListRequest Offset(int fieldValue) { this.request.BodyInt("offset", fieldValue); return this; }
    WechatOpenSpecialLibraryListRequest Count(int fieldValue) { this.request.BodyInt("count", fieldValue); return this; }
    string JsonBody() { return this.request.JsonBody(); }
}
