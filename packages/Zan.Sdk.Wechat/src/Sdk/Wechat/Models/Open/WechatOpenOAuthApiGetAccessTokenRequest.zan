using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenOAuthApiGetAccessTokenRequest {
    WechatTypedRequest request;

    public WechatOpenOAuthApiGetAccessTokenRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenOAuthApiGetAccessTokenRequest AppId(string fieldValue) {
        this.request.QueryString("appid", fieldValue);
        return this;
    }

    WechatOpenOAuthApiGetAccessTokenRequest ComponentAppid(string fieldValue) {
        this.request.QueryString("component_appid", fieldValue);
        return this;
    }

    WechatOpenOAuthApiGetAccessTokenRequest Code(string fieldValue) {
        this.request.QueryString("code", fieldValue);
        return this;
    }

    WechatOpenOAuthApiGetAccessTokenRequest GrantType(string fieldValue) {
        this.request.QueryString("grant_type", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
