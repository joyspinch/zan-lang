using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenComponentApiQueryAuthRequest {
    WechatTypedRequest request;

    public WechatOpenComponentApiQueryAuthRequest() { this.request = new WechatTypedRequest(); }

    public WechatOpenComponentApiQueryAuthRequest ComponentAppId(string fieldValue) {
        this.request.BodyString("component_appid", fieldValue);
        return this;
    }

    public WechatOpenComponentApiQueryAuthRequest AuthorizationCode(string fieldValue) {
        this.request.BodyString("authorization_code", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
