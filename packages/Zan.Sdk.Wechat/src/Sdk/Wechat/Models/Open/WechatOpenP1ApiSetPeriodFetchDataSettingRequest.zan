using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenP1ApiSetPeriodFetchDataSettingRequest {
    WechatTypedRequest request;

    public WechatOpenP1ApiSetPeriodFetchDataSettingRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenP1ApiSetPeriodFetchDataSettingRequest IsOpen(bool fieldValue) {
        this.request.BodyBool("is_period_fetch_open", fieldValue);
        return this;
    }

    WechatOpenP1ApiSetPeriodFetchDataSettingRequest FetchType(int fieldValue) {
        this.request.BodyInt("period_fetch_type", fieldValue);
        return this;
    }

    WechatOpenP1ApiSetPeriodFetchDataSettingRequest FetchUrl(string fieldValue) {
        this.request.BodyString("period_fetch_url", fieldValue);
        return this;
    }

    WechatOpenP1ApiSetPeriodFetchDataSettingRequest EnvironmentId(string fieldValue) {
        this.request.BodyString("period_env", fieldValue);
        return this;
    }

    WechatOpenP1ApiSetPeriodFetchDataSettingRequest FunctionName(string fieldValue) {
        this.request.BodyString("period_function_name", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
