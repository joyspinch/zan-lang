using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenComponentApiSetAuthorizerOptionRequest {
    WechatTypedRequest request;

    public WechatOpenComponentApiSetAuthorizerOptionRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenComponentApiSetAuthorizerOptionRequest ComponentAppId(string fieldValue) {
        this.request.BodyString("component_appid", fieldValue);
        return this;
    }

    WechatOpenComponentApiSetAuthorizerOptionRequest AuthorizerAppId(string fieldValue) {
        this.request.BodyString("authorizer_appid", fieldValue);
        return this;
    }

    WechatOpenComponentApiSetAuthorizerOptionRequest OptionName(int fieldValue) {
        this.request.BodyInt("option_name", fieldValue);
        return this;
    }

    WechatOpenComponentApiSetAuthorizerOptionRequest OptionValue(int fieldValue) {
        this.request.BodyInt("option_value", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
