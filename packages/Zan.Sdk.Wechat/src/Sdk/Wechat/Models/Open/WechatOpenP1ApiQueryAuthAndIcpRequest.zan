using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenP1ApiQueryAuthAndIcpRequest {
    WechatTypedRequest request;

    public WechatOpenP1ApiQueryAuthAndIcpRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenP1ApiQueryAuthAndIcpRequest ProcedureId(string fieldValue) {
        this.request.BodyString("procedure_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
