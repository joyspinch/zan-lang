using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenComponentApiFastRegisterWeAppRequest {
    WechatTypedRequest request;

    public WechatOpenComponentApiFastRegisterWeAppRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenComponentApiFastRegisterWeAppRequest EntName(string fieldValue) {
        this.request.QueryString("name", fieldValue);
        return this;
    }

    WechatOpenComponentApiFastRegisterWeAppRequest EntCode(string fieldValue) {
        this.request.BodyString("code", fieldValue);
        return this;
    }

    WechatOpenComponentApiFastRegisterWeAppRequest CodeType(int fieldValue) {
        this.request.BodyInt("code_type", fieldValue);
        return this;
    }

    WechatOpenComponentApiFastRegisterWeAppRequest LegalPersonaWechat(string fieldValue) {
        this.request.BodyString("legal_persona_wechat", fieldValue);
        return this;
    }

    WechatOpenComponentApiFastRegisterWeAppRequest LegalPersonaName(string fieldValue) {
        this.request.BodyString("legal_persona_name", fieldValue);
        return this;
    }

    WechatOpenComponentApiFastRegisterWeAppRequest ComponentPhone(string fieldValue) {
        this.request.BodyString("component_phone", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
