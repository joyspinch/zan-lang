using System;
using System.Text;
using System.Json;
using Sdk.Wechat;

namespace Sdk.Wechat.Open;

public class WechatOpenSpecialQrCodeRequest {
    WechatTypedRequest request;
    public WechatOpenSpecialQrCodeRequest() { this.request = new WechatTypedRequest(); }
    WechatOpenSpecialQrCodeRequest Path(string fieldValue) {
        this.request.QueryString("path", fieldValue); return this;
    }
    string QueryText() { return this.request.QueryText(); }
}
