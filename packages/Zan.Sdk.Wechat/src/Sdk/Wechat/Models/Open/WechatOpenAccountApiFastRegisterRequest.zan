using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenAccountApiFastRegisterRequest {
    WechatTypedRequest request;

    public WechatOpenAccountApiFastRegisterRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenAccountApiFastRegisterRequest Ticket(string fieldValue) {
        this.request.BodyString("ticket", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
