using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenOAuthApiRefreshTokenRequest {
    WechatTypedRequest request;

    public WechatOpenOAuthApiRefreshTokenRequest() { this.request = new WechatTypedRequest(); }

    public WechatOpenOAuthApiRefreshTokenRequest AppId(string fieldValue) {
        this.request.QueryString("appid", fieldValue);
        return this;
    }

    public WechatOpenOAuthApiRefreshTokenRequest RefreshToken(string fieldValue) {
        this.request.QueryString("refresh_token", fieldValue);
        return this;
    }

    public WechatOpenOAuthApiRefreshTokenRequest ComponentAppid(string fieldValue) {
        this.request.QueryString("component_appid", fieldValue);
        return this;
    }

    public WechatOpenOAuthApiRefreshTokenRequest GrantType(string fieldValue) {
        this.request.QueryString("grant_type", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
