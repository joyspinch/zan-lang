using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenCodeApiChangeVisitStatusRequest {
    WechatTypedRequest request;

    public WechatOpenCodeApiChangeVisitStatusRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenCodeApiChangeVisitStatusRequest Action(int fieldValue) {
        this.request.BodyInt("action", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
