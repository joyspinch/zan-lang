using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenWxaEmbeddedApiDelAuthorizeRequest {
    WechatTypedRequest request;

    public WechatOpenWxaEmbeddedApiDelAuthorizeRequest() { this.request = new WechatTypedRequest(); }

    public WechatOpenWxaEmbeddedApiDelAuthorizeRequest Flag(int fieldValue) {
        this.request.BodyInt("flag", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
