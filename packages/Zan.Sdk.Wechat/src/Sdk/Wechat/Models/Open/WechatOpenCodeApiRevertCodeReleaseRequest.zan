using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenCodeApiRevertCodeReleaseRequest {
    WechatTypedRequest request;

    public WechatOpenCodeApiRevertCodeReleaseRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenCodeApiRevertCodeReleaseRequest AppVersion(string fieldValue) {
        this.request.QueryString("app_version", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
