using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenWxOpenApiAddCategoryRequest {
    WechatTypedRequest request;

    public WechatOpenWxOpenApiAddCategoryRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenWxOpenApiAddCategoryRequest AddCategoryData(List<WechatOpenAddCategoryData> fieldValue) {
        this.request.BodyJson("categories", Json.Serialize<List<WechatOpenAddCategoryData>>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
