using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenComponentApiGetDomainConfirmFileRequest {
    WechatTypedRequest request;

    public WechatOpenComponentApiGetDomainConfirmFileRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenComponentApiGetDomainConfirmFileRequest ComponentAccessToken(string fieldValue) {
        this.request.BodyString("componentAccessToken", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
