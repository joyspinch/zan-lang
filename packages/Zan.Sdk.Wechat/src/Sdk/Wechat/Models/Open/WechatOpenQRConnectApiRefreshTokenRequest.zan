using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenQRConnectApiRefreshTokenRequest {
    WechatTypedRequest request;

    public WechatOpenQRConnectApiRefreshTokenRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenQRConnectApiRefreshTokenRequest AppId(string fieldValue) {
        this.request.QueryString("appid", fieldValue);
        return this;
    }

    WechatOpenQRConnectApiRefreshTokenRequest RefreshToken(string fieldValue) {
        this.request.QueryString("refresh_token", fieldValue);
        return this;
    }

    WechatOpenQRConnectApiRefreshTokenRequest GrantType(string fieldValue) {
        this.request.QueryString("grant_type", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
