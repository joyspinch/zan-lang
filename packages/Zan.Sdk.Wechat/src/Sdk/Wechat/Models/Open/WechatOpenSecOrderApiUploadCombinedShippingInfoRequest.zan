using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenSecOrderApiUploadCombinedShippingInfoRequest {
    WechatTypedRequest request;

    public WechatOpenSecOrderApiUploadCombinedShippingInfoRequest() { this.request = new WechatTypedRequest(); }

    public WechatOpenSecOrderApiUploadCombinedShippingInfoRequest OrderKey(WechatOpenOrderKey fieldValue) {
        this.request.BodyJson("order_key", Json.Serialize<WechatOpenOrderKey>(fieldValue));
        return this;
    }

    public WechatOpenSecOrderApiUploadCombinedShippingInfoRequest SubOrders(List<WechatOpenUploadCombinedShippingInfoSubOrder> fieldValue) {
        this.request.BodyJson("sub_orders", Json.Serialize<List<WechatOpenUploadCombinedShippingInfoSubOrder>>(fieldValue));
        return this;
    }

    public WechatOpenSecOrderApiUploadCombinedShippingInfoRequest UploadTime(string fieldValue) {
        this.request.BodyString("upload_time", fieldValue);
        return this;
    }

    public WechatOpenSecOrderApiUploadCombinedShippingInfoRequest Payer(WechatOpenPayer fieldValue) {
        this.request.BodyJson("payer", Json.Serialize<WechatOpenPayer>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
