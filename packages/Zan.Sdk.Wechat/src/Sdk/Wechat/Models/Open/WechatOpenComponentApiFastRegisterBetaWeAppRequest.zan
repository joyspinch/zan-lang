using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenComponentApiFastRegisterBetaWeAppRequest {
    WechatTypedRequest request;

    public WechatOpenComponentApiFastRegisterBetaWeAppRequest() { this.request = new WechatTypedRequest(); }

    public WechatOpenComponentApiFastRegisterBetaWeAppRequest Name(string fieldValue) {
        this.request.BodyString("name", fieldValue);
        return this;
    }

    public WechatOpenComponentApiFastRegisterBetaWeAppRequest Openid(string fieldValue) {
        this.request.BodyString("openid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
