using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenComponentApiGetPreAuthCodeRequest {
    WechatTypedRequest request;

    public WechatOpenComponentApiGetPreAuthCodeRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenComponentApiGetPreAuthCodeRequest ComponentAppId(string fieldValue) {
        this.request.BodyString("component_appid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
