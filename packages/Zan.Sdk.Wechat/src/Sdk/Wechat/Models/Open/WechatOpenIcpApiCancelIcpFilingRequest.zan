using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenIcpApiCancelIcpFilingRequest {
    WechatTypedRequest request;

    public WechatOpenIcpApiCancelIcpFilingRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenIcpApiCancelIcpFilingRequest CancelType(int fieldValue) {
        this.request.BodyInt("cancel_type", fieldValue);
        return this;
    }

    WechatOpenIcpApiCancelIcpFilingRequest ReasonType(int fieldValue) {
        this.request.BodyInt("reason_type", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
