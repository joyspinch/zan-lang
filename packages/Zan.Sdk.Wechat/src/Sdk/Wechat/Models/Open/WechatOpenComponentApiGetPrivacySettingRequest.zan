using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenComponentApiGetPrivacySettingRequest {
    WechatTypedRequest request;

    public WechatOpenComponentApiGetPrivacySettingRequest() { this.request = new WechatTypedRequest(); }

    public WechatOpenComponentApiGetPrivacySettingRequest PrivacyVer(int fieldValue) {
        this.request.BodyInt("privacy_ver", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
