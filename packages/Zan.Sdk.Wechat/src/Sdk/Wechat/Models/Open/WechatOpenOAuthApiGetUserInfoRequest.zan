using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenOAuthApiGetUserInfoRequest {
    WechatTypedRequest request;

    public WechatOpenOAuthApiGetUserInfoRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenOAuthApiGetUserInfoRequest OpenId(string fieldValue) {
        this.request.QueryString("openid", fieldValue);
        return this;
    }

    WechatOpenOAuthApiGetUserInfoRequest Lang(JsonValue fieldValue) {
        this.request.QueryValue("lang", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
