using Sdk.Wechat;
using Sdk.Wechat.Open;
using System;
using System.Json;

namespace Sdk.Wechat.Open;

public class WechatOpenWxaEmbeddedApiSetAuthorizeRequest {
    WechatTypedRequest request;

    public WechatOpenWxaEmbeddedApiSetAuthorizeRequest() { this.request = new WechatTypedRequest(); }

    public WechatOpenWxaEmbeddedApiSetAuthorizeRequest Flag(int fieldValue) {
        this.request.BodyInt("flag", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}

public class WechatOpenWxaEmbeddedApiSetAuthorizeResponse {
    public string Raw;
    public JsonValue Value;
}
