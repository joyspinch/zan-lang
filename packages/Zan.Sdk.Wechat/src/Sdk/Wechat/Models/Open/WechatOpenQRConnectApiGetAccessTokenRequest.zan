using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenQRConnectApiGetAccessTokenRequest {
    WechatTypedRequest request;

    public WechatOpenQRConnectApiGetAccessTokenRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenQRConnectApiGetAccessTokenRequest AppId(string fieldValue) {
        this.request.QueryString("appid", fieldValue);
        return this;
    }

    WechatOpenQRConnectApiGetAccessTokenRequest AppSecret(string fieldValue) {
        this.request.QueryString("appSecret", fieldValue);
        return this;
    }

    WechatOpenQRConnectApiGetAccessTokenRequest Code(string fieldValue) {
        this.request.QueryString("code", fieldValue);
        return this;
    }

    WechatOpenQRConnectApiGetAccessTokenRequest GrantType(string fieldValue) {
        this.request.QueryString("grant_type", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
