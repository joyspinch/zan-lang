using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenSecApiReauthRequest {
    WechatTypedRequest request;

    public WechatOpenSecApiReauthRequest() { this.request = new WechatTypedRequest(); }

    public WechatOpenSecApiReauthRequest CustomerType(int fieldValue) {
        this.request.BodyInt("customer_type", fieldValue);
        return this;
    }

    public WechatOpenSecApiReauthRequest Taskid(string fieldValue) {
        this.request.BodyString("taskid", fieldValue);
        return this;
    }

    public WechatOpenSecApiReauthRequest ContactInfo(WechatOpenWxaAuthAuthDataContactInfo fieldValue) {
        this.request.BodyJson("contact_info", Json.Serialize<WechatOpenWxaAuthAuthDataContactInfo>(fieldValue));
        return this;
    }

    public WechatOpenSecApiReauthRequest InvoiceInfo(WechatOpenWxaAuthAuthDataInvoiceInfo fieldValue) {
        this.request.BodyJson("invoice_info", Json.Serialize<WechatOpenWxaAuthAuthDataInvoiceInfo>(fieldValue));
        return this;
    }

    public WechatOpenSecApiReauthRequest Qualification(string fieldValue) {
        this.request.BodyString("qualification", fieldValue);
        return this;
    }

    public WechatOpenSecApiReauthRequest QualificationOther(List<string> fieldValue) {
        this.request.BodyStrings("qualification_other", fieldValue);
        return this;
    }

    public WechatOpenSecApiReauthRequest AccountName(string fieldValue) {
        this.request.BodyString("account_name", fieldValue);
        return this;
    }

    public WechatOpenSecApiReauthRequest AccountNameType(int fieldValue) {
        this.request.BodyInt("account_name_type", fieldValue);
        return this;
    }

    public WechatOpenSecApiReauthRequest AccountSupplemental(List<string> fieldValue) {
        this.request.BodyStrings("account_supplemental", fieldValue);
        return this;
    }

    public WechatOpenSecApiReauthRequest PayType(int fieldValue) {
        this.request.BodyInt("pay_type", fieldValue);
        return this;
    }

    public WechatOpenSecApiReauthRequest AuthIdentification(string fieldValue) {
        this.request.BodyString("auth_identification", fieldValue);
        return this;
    }

    public WechatOpenSecApiReauthRequest AuthIdentMaterial(List<string> fieldValue) {
        this.request.BodyStrings("auth_ident_material", fieldValue);
        return this;
    }

    public WechatOpenSecApiReauthRequest ThirdPartyPhone(string fieldValue) {
        this.request.BodyString("third_party_phone", fieldValue);
        return this;
    }

    public WechatOpenSecApiReauthRequest ServiceAppid(string fieldValue) {
        this.request.BodyString("service_appid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
