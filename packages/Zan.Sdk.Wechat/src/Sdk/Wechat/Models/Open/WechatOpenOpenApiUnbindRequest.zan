using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenOpenApiUnbindRequest {
    WechatTypedRequest request;

    public WechatOpenOpenApiUnbindRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenOpenApiUnbindRequest AppId(string fieldValue) {
        this.request.BodyString("appid", fieldValue);
        return this;
    }

    WechatOpenOpenApiUnbindRequest OpenAppid(string fieldValue) {
        this.request.BodyString("open_appid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
