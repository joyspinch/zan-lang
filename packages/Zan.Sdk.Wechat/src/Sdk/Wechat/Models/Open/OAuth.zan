using System;

namespace Sdk.Wechat.Models.Open;
public class WechatOpenJsCode2JsonResult {
    public string openid;
    public string session_key;
    public string unionid;
}

public class WechatOpenOAuthAccessTokenResult {
    public string access_token;
    public int expires_in;
    public string refresh_token;
    public string openid;
    public string scope;
    public string unionid;
    public int is_snapshotuser;
}

public class WechatOpenOAuthUserInfo {
    public string openid;
    public string nickname;
    public int sex;
    public string province;
    public string city;
    public string country;
    public string headimgurl;
    public List<string> privilege;
    public string unionid;
}

public class WechatOpenQRConnectAccessTokenResult {
    public string unionid;
    public string access_token;
    public int expires_in;
    public string refresh_token;
    public string openid;
    public string scope;
}

public class WechatOpenQRConnectUserInfo {
    public string openid;
    public string nickname;
    public int sex;
    public string province;
    public string city;
    public string country;
    public string headimgurl;
    public List<string> privilege;
    public string unionid;
}

public class WechatOpenRefreshAccessTokenResult {
    public string access_token;
