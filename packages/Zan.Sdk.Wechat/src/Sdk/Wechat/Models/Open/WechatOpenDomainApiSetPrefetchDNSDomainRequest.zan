using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenDomainApiSetPrefetchDNSDomainRequest {
    WechatTypedRequest request;

    public WechatOpenDomainApiSetPrefetchDNSDomainRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenDomainApiSetPrefetchDNSDomainRequest PrefetchDnsDomain(List<WechatOpenSetPrefetchDNSDomainData> fieldValue) {
        this.request.BodyJson("prefetch_dns_domain", Json.Serialize<List<WechatOpenSetPrefetchDNSDomainData>>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
