using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenCodeTemplateApiAddToTemplateRequest {
    WechatTypedRequest request;

    public WechatOpenCodeTemplateApiAddToTemplateRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenCodeTemplateApiAddToTemplateRequest DraftId(int fieldValue) {
        this.request.BodyInt("draft_id", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
