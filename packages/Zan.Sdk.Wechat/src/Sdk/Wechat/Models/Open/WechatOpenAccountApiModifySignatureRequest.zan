using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenAccountApiModifySignatureRequest {
    WechatTypedRequest request;

    public WechatOpenAccountApiModifySignatureRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenAccountApiModifySignatureRequest Signature(string fieldValue) {
        this.request.BodyString("signature", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
