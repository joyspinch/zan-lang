using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenSecOrderApiUploadShippingInfoRequest {
    WechatTypedRequest request;

    public WechatOpenSecOrderApiUploadShippingInfoRequest() { this.request = new WechatTypedRequest(); }

    public WechatOpenSecOrderApiUploadShippingInfoRequest OrderKey(WechatOpenOrderKey fieldValue) {
        this.request.BodyJson("order_key", Json.Serialize<WechatOpenOrderKey>(fieldValue));
        return this;
    }

    public WechatOpenSecOrderApiUploadShippingInfoRequest LogisticsType(int fieldValue) {
        this.request.BodyInt("logistics_type", fieldValue);
        return this;
    }

    public WechatOpenSecOrderApiUploadShippingInfoRequest DeliveryMode(int fieldValue) {
        this.request.BodyInt("delivery_mode", fieldValue);
        return this;
    }

    public WechatOpenSecOrderApiUploadShippingInfoRequest IsAllDelivered(bool fieldValue) {
        this.request.BodyBool("is_all_delivered", fieldValue);
        return this;
    }

    public WechatOpenSecOrderApiUploadShippingInfoRequest ShippingList(List<WechatOpenShipping> fieldValue) {
        this.request.BodyJson("shipping_list", Json.Serialize<List<WechatOpenShipping>>(fieldValue));
        return this;
    }

    public WechatOpenSecOrderApiUploadShippingInfoRequest UploadTime(string fieldValue) {
        this.request.BodyString("upload_time", fieldValue);
        return this;
    }

    public WechatOpenSecOrderApiUploadShippingInfoRequest Payer(WechatOpenPayer fieldValue) {
        this.request.BodyJson("payer", Json.Serialize<WechatOpenPayer>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
