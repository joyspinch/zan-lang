using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenWxaApiApplyPrivacyInterfaceRequest {
    WechatTypedRequest request;

    public WechatOpenWxaApiApplyPrivacyInterfaceRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenWxaApiApplyPrivacyInterfaceRequest ApiName(string fieldValue) {
        this.request.BodyString("api_name", fieldValue);
        return this;
    }

    WechatOpenWxaApiApplyPrivacyInterfaceRequest Content(string fieldValue) {
        this.request.BodyString("content", fieldValue);
        return this;
    }

    WechatOpenWxaApiApplyPrivacyInterfaceRequest UrlList(List<string> fieldValue) {
        this.request.BodyStrings("url_list", fieldValue);
        return this;
    }

    WechatOpenWxaApiApplyPrivacyInterfaceRequest PicList(List<string> fieldValue) {
        this.request.BodyStrings("pic_list", fieldValue);
        return this;
    }

    WechatOpenWxaApiApplyPrivacyInterfaceRequest VideoList(List<string> fieldValue) {
        this.request.BodyStrings("video_list", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
