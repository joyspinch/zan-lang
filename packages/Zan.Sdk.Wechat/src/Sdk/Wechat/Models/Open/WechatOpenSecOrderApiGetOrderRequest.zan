using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenSecOrderApiGetOrderRequest {
    WechatTypedRequest request;

    public WechatOpenSecOrderApiGetOrderRequest() { this.request = new WechatTypedRequest(); }

    public WechatOpenSecOrderApiGetOrderRequest TransactionId(string fieldValue) {
        this.request.BodyString("transaction_id", fieldValue);
        return this;
    }

    public WechatOpenSecOrderApiGetOrderRequest MerchantId(string fieldValue) {
        this.request.BodyString("merchant_id", fieldValue);
        return this;
    }

    public WechatOpenSecOrderApiGetOrderRequest SubMerchantId(string fieldValue) {
        this.request.BodyString("sub_merchant_id", fieldValue);
        return this;
    }

    public WechatOpenSecOrderApiGetOrderRequest MerchantTradeNo(string fieldValue) {
        this.request.BodyString("merchant_trade_no", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
