using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenWxaEmbeddedApiAddEmbeddedRequest {
    WechatTypedRequest request;

    public WechatOpenWxaEmbeddedApiAddEmbeddedRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenWxaEmbeddedApiAddEmbeddedRequest Appid(string fieldValue) {
        this.request.BodyString("appid", fieldValue);
        return this;
    }

    WechatOpenWxaEmbeddedApiAddEmbeddedRequest ApplyReason(string fieldValue) {
        this.request.BodyString("apply_reason", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
