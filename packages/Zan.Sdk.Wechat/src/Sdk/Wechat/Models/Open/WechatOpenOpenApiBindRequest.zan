using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenOpenApiBindRequest {
    WechatTypedRequest request;

    public WechatOpenOpenApiBindRequest() { this.request = new WechatTypedRequest(); }

    public WechatOpenOpenApiBindRequest AppId(string fieldValue) {
        this.request.BodyString("appid", fieldValue);
        return this;
    }

    public WechatOpenOpenApiBindRequest OpenAppid(string fieldValue) {
        this.request.BodyString("open_appid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
