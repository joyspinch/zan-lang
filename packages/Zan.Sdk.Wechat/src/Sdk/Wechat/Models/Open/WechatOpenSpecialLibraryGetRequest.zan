using System;
using System.Text;
using System.Json;
using Sdk.Wechat;

namespace Sdk.Wechat.Open;

public class WechatOpenSpecialLibraryGetRequest {
    WechatTypedRequest request;
    public WechatOpenSpecialLibraryGetRequest() { this.request = new WechatTypedRequest(); }
    WechatOpenSpecialLibraryGetRequest Id(string fieldValue) { this.request.BodyString("id", fieldValue); return this; }
    string JsonBody() { return this.request.JsonBody(); }
}
