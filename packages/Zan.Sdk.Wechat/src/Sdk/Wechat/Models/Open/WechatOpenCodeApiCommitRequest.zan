using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenCodeApiCommitRequest {
    WechatTypedRequest request;

    public WechatOpenCodeApiCommitRequest() { this.request = new WechatTypedRequest(); }

    public WechatOpenCodeApiCommitRequest TemplateId(int fieldValue) {
        this.request.BodyInt("template_id", fieldValue);
        return this;
    }

    public WechatOpenCodeApiCommitRequest ExtJson(string fieldValue) {
        this.request.BodyString("ext_json", fieldValue);
        return this;
    }

    public WechatOpenCodeApiCommitRequest UserVersion(string fieldValue) {
        this.request.BodyString("user_version", fieldValue);
        return this;
    }

    public WechatOpenCodeApiCommitRequest UserDesc(string fieldValue) {
        this.request.BodyString("user_desc", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
