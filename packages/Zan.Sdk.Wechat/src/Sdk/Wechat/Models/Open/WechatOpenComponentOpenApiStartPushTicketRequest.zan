using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenComponentOpenApiStartPushTicketRequest {
    WechatTypedRequest request;

    public WechatOpenComponentOpenApiStartPushTicketRequest() { this.request = new WechatTypedRequest(); }

    public WechatOpenComponentOpenApiStartPushTicketRequest ComponentAppId(string fieldValue) {
        this.request.BodyString("component_appid", fieldValue);
        return this;
    }

    public WechatOpenComponentOpenApiStartPushTicketRequest ComponentSecret(string fieldValue) {
        this.request.BodyString("component_secret", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
