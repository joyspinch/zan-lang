using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenComponentApiGetAuthorizerInfoRequest {
    WechatTypedRequest request;

    public WechatOpenComponentApiGetAuthorizerInfoRequest() { this.request = new WechatTypedRequest(); }

    public WechatOpenComponentApiGetAuthorizerInfoRequest ComponentAppId(string fieldValue) {
        this.request.BodyString("component_appid", fieldValue);
        return this;
    }

    public WechatOpenComponentApiGetAuthorizerInfoRequest AuthorizerAppId(string fieldValue) {
        this.request.BodyString("authorizer_appid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
