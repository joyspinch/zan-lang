using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenNewTmplApiAddTemplateRequest {
    WechatTypedRequest request;

    public WechatOpenNewTmplApiAddTemplateRequest() { this.request = new WechatTypedRequest(); }

    public WechatOpenNewTmplApiAddTemplateRequest Tid(string fieldValue) {
        this.request.BodyString("tid", fieldValue);
        return this;
    }

    public WechatOpenNewTmplApiAddTemplateRequest KidList(List<int> fieldValue) {
        this.request.BodyInts("kidList", fieldValue);
        return this;
    }

    public WechatOpenNewTmplApiAddTemplateRequest SceneDesc(string fieldValue) {
        this.request.BodyString("sceneDesc", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
