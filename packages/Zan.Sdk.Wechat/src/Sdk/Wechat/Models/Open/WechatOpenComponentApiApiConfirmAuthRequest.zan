using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenComponentApiApiConfirmAuthRequest {
    WechatTypedRequest request;

    public WechatOpenComponentApiApiConfirmAuthRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenComponentApiApiConfirmAuthRequest ComponentAppId(string fieldValue) {
        this.request.BodyString("component_appid", fieldValue);
        return this;
    }

    WechatOpenComponentApiApiConfirmAuthRequest AuthorizerAppid(string fieldValue) {
        this.request.BodyString("authorizer_appid", fieldValue);
        return this;
    }

    WechatOpenComponentApiApiConfirmAuthRequest FunscopeCategoryId(int fieldValue) {
        this.request.BodyInt("funscope_category_id", fieldValue);
        return this;
    }

    WechatOpenComponentApiApiConfirmAuthRequest ConfirmValue(int fieldValue) {
        this.request.BodyInt("confirm_value", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
