using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenCodeApiSpeedupAuditRequest {
    WechatTypedRequest request;

    public WechatOpenCodeApiSpeedupAuditRequest() { this.request = new WechatTypedRequest(); }

    public WechatOpenCodeApiSpeedupAuditRequest Auditid(int fieldValue) {
        this.request.BodyInt("auditid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
