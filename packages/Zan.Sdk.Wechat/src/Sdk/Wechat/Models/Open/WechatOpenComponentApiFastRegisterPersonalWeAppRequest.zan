using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenComponentApiFastRegisterPersonalWeAppRequest {
    WechatTypedRequest request;

    public WechatOpenComponentApiFastRegisterPersonalWeAppRequest() { this.request = new WechatTypedRequest(); }

    public WechatOpenComponentApiFastRegisterPersonalWeAppRequest WxUser(string fieldValue) {
        this.request.QueryString("wxuser", fieldValue);
        return this;
    }

    public WechatOpenComponentApiFastRegisterPersonalWeAppRequest ComponentPhone(string fieldValue) {
        this.request.BodyString("component_phone", fieldValue);
        return this;
    }

    public WechatOpenComponentApiFastRegisterPersonalWeAppRequest NewVersion(bool fieldValue) {
        this.request.BodyBool("new_version", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
