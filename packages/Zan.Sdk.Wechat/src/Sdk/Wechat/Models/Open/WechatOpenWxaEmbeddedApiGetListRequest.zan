using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenWxaEmbeddedApiGetListRequest {
    WechatTypedRequest request;

    public WechatOpenWxaEmbeddedApiGetListRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenWxaEmbeddedApiGetListRequest Start(int fieldValue) {
        this.request.QueryInt("start", fieldValue);
        return this;
    }

    WechatOpenWxaEmbeddedApiGetListRequest Num(int fieldValue) {
        this.request.QueryInt("num", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
