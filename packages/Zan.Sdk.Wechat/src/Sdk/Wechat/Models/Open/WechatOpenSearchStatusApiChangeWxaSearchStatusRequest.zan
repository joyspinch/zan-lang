using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenSearchStatusApiChangeWxaSearchStatusRequest {
    WechatTypedRequest request;

    public WechatOpenSearchStatusApiChangeWxaSearchStatusRequest() { this.request = new WechatTypedRequest(); }

    public WechatOpenSearchStatusApiChangeWxaSearchStatusRequest Status(int fieldValue) {
        this.request.BodyInt("status", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}
