using System;
using System.Json;
using Sdk.Wechat;

namespace Sdk.Wechat.Mp;

public class WechatMpMerchantSpecialApi {
    WechatClient client;
    public WechatMpMerchantSpecialApi(WechatClient client) { this.client = client; }

    async WechatMpSpecialPictureResponse UploadImgAsync(
            string fileName, string contentType, string fileBytes) {
        WechatRawResponse raw = await this.client.RequestRawAsync("POST",
            "/merchant/common/upload_img",
            "filename=" + Encoding.UrlEncode(fileName), fileBytes, contentType,
            WechatCredentialKind.AccessToken);
        WechatResponse parsed = raw.Json();
        WechatMpSpecialPictureResponse result =
            Json.Deserialize<WechatMpSpecialPictureResponse>(parsed.Data);
        result.Raw = parsed.Raw;
        return result;
    }
}

