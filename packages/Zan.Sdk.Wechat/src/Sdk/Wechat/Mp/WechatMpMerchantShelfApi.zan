using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpMerchantShelfApi {
    WechatClient client;

    public WechatMpMerchantShelfApi(WechatClient client) {
        this.client = client;
    }

    async WechatMpMerchantShelfApiAddShelvesResponse AddShelvesAsync(WechatMpMerchantShelfApiAddShelvesRequest request) {
        if (request == null) { request = new WechatMpMerchantShelfApiAddShelvesRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/merchant/shelf/add", request.QueryText(), request.JsonBody());
        WechatMpMerchantShelfApiAddShelvesResponse result = Json.Deserialize<WechatMpMerchantShelfApiAddShelvesResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse AddShelvesRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/merchant/shelf/add", query, jsonBody);
    }

    async WechatMpMerchantShelfApiDeleteShelvesResponse DeleteShelvesAsync(WechatMpMerchantShelfApiDeleteShelvesRequest request) {
        if (request == null) { request = new WechatMpMerchantShelfApiDeleteShelvesRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/merchant/shelf/del", request.QueryText(), request.JsonBody());
        WechatMpMerchantShelfApiDeleteShelvesResponse result = Json.Deserialize<WechatMpMerchantShelfApiDeleteShelvesResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse DeleteShelvesRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/merchant/shelf/del", query, jsonBody);
    }

    async WechatMpMerchantShelfApiModShelvesResponse ModShelvesAsync(WechatMpMerchantShelfApiModShelvesRequest request) {
        if (request == null) { request = new WechatMpMerchantShelfApiModShelvesRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/merchant/shelf/mod", request.QueryText(), request.JsonBody());
        WechatMpMerchantShelfApiModShelvesResponse result = Json.Deserialize<WechatMpMerchantShelfApiModShelvesResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse ModShelvesRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/merchant/shelf/mod", query, jsonBody);
    }

    async WechatMpMerchantShelfApiGetAllShelvesResponse GetAllShelvesAsync() {
        WechatResponse raw = await WechatMpRequest.GetAsync(this.client, "/merchant/shelf/getall", "");
        WechatMpMerchantShelfApiGetAllShelvesResponse result = Json.Deserialize<WechatMpMerchantShelfApiGetAllShelvesResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GetAllShelvesRawAsync(string query) {
        return await WechatMpRequest.GetAsync(this.client, "/merchant/shelf/getall", query);
    }

    async WechatMpMerchantShelfApiGetByIdShelvesResponse GetByIdShelvesAsync(WechatMpMerchantShelfApiGetByIdShelvesRequest request) {
        if (request == null) { request = new WechatMpMerchantShelfApiGetByIdShelvesRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/merchant/shelf/getbyid", request.QueryText(), request.JsonBody());
        WechatMpMerchantShelfApiGetByIdShelvesResponse result = Json.Deserialize<WechatMpMerchantShelfApiGetByIdShelvesResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GetByIdShelvesRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/merchant/shelf/getbyid", query, jsonBody);
    }

}
