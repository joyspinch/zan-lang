using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpDraftProductCardApi {
    WechatClient client;

    public WechatMpDraftProductCardApi(WechatClient client) {
        this.client = client;
    }

    public async WechatMpDraftProductCardApiGetProductCardInfoResponse GetProductCardInfoAsync(WechatMpDraftProductCardApiGetProductCardInfoRequest request) {
        if (request == null) { request = new WechatMpDraftProductCardApiGetProductCardInfoRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/channels/ec/service/product/getcardinfo", request.QueryText(), request.JsonBody());
        WechatMpDraftProductCardApiGetProductCardInfoResponse result = Json.Deserialize<WechatMpDraftProductCardApiGetProductCardInfoResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse GetProductCardInfoRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/channels/ec/service/product/getcardinfo", query, jsonBody);
    }

}
