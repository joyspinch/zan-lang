    async WechatMpMediaApiUploadTemporaryNewsResponse UploadTemporaryNewsAsync(WechatMpMediaApiUploadTemporaryNewsRequest request) {
        if (request == null) { request = new WechatMpMediaApiUploadTemporaryNewsRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/cgi-bin/media/uploadnews", request.QueryText(), request.JsonBody());
        WechatMpMediaApiUploadTemporaryNewsResponse result = Json.Deserialize<WechatMpMediaApiUploadTemporaryNewsResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

