using System;
using System.Json;
using Sdk.Wechat;

namespace Sdk.Wechat.Mp;

public class WechatMpPoiSpecialApi {
    WechatClient client;
    public WechatMpPoiSpecialApi(WechatClient client) { this.client = client; }

    async WechatMpSpecialPoiUploadImageResponse UploadImageAsync(
            string fileName, string contentType, string fileBytes) {
        WechatMultipart form = new WechatMultipart();
        form.AddFile("media", fileName, contentType, fileBytes);
        WechatRawResponse raw = await this.client.RequestMultipartAsync("POST",
            "/cgi-bin/media/uploadimg", "", form, WechatCredentialKind.AccessToken);
        WechatResponse parsed = raw.Json();
        WechatMpSpecialPoiUploadImageResponse result =
            Json.Deserialize<WechatMpSpecialPoiUploadImageResponse>(parsed.Data);
        result.Raw = parsed.Raw;
        return result;
    }
}

// 二维码图片下载。该端点属于 mp.weixin.qq.com，且不需要 access token。
