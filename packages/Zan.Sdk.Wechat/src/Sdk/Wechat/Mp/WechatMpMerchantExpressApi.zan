using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpMerchantExpressApi {
    WechatClient client;

    public WechatMpMerchantExpressApi(WechatClient client) {
        this.client = client;
    }

    public async WechatMpMerchantExpressApiAddExpressResponse AddExpressAsync(WechatMpMerchantExpressApiAddExpressRequest request) {
        if (request == null) { request = new WechatMpMerchantExpressApiAddExpressRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/merchant/express/add", request.QueryText(), request.JsonBody());
        WechatMpMerchantExpressApiAddExpressResponse result = Json.Deserialize<WechatMpMerchantExpressApiAddExpressResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse AddExpressRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/merchant/express/add", query, jsonBody);
    }

    public async WechatMpMerchantExpressApiDeleteExpressResponse DeleteExpressAsync(WechatMpMerchantExpressApiDeleteExpressRequest request) {
        if (request == null) { request = new WechatMpMerchantExpressApiDeleteExpressRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/merchant/express/del", request.QueryText(), request.JsonBody());
        WechatMpMerchantExpressApiDeleteExpressResponse result = Json.Deserialize<WechatMpMerchantExpressApiDeleteExpressResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse DeleteExpressRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/merchant/express/del", query, jsonBody);
    }

    public async WechatMpMerchantExpressApiUpDateExpressResponse UpDateExpressAsync(WechatMpMerchantExpressApiUpDateExpressRequest request) {
        if (request == null) { request = new WechatMpMerchantExpressApiUpDateExpressRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/merchant/express/update", request.QueryText(), request.JsonBody());
        WechatMpMerchantExpressApiUpDateExpressResponse result = Json.Deserialize<WechatMpMerchantExpressApiUpDateExpressResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse UpDateExpressRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/merchant/express/update", query, jsonBody);
    }

    public async WechatMpMerchantExpressApiGetByIdExpressResponse GetByIdExpressAsync(WechatMpMerchantExpressApiGetByIdExpressRequest request) {
        if (request == null) { request = new WechatMpMerchantExpressApiGetByIdExpressRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/merchant/express/getbyid", request.QueryText(), request.JsonBody());
        WechatMpMerchantExpressApiGetByIdExpressResponse result = Json.Deserialize<WechatMpMerchantExpressApiGetByIdExpressResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse GetByIdExpressRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/merchant/express/getbyid", query, jsonBody);
    }

    public async WechatMpMerchantExpressApiGetAllExpressResponse GetAllExpressAsync() {
        WechatResponse raw = await WechatMpRequest.GetAsync(this.client, "/merchant/express/getall", "");
        WechatMpMerchantExpressApiGetAllExpressResponse result = Json.Deserialize<WechatMpMerchantExpressApiGetAllExpressResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse GetAllExpressRawAsync(string query) {
        return await WechatMpRequest.GetAsync(this.client, "/merchant/express/getall", query);
    }

}
