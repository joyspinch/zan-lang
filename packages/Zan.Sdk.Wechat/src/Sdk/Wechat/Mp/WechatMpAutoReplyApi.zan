class WechatMpAutoReplyApiGetCurrentAutoreplyInfoResponse : WechatMpGetCurrentAutoreplyInfoResult {
    public string Raw;
}

// AutoReply/AutoReplyApi.cs 的 Zan 强类型 JSON 接口。
// 从 Senparc.Weixin.MP.AdvancedAPIs 生成；请勿在此手抄 HTTP 逻辑。
class WechatMpAutoReplyApi {
