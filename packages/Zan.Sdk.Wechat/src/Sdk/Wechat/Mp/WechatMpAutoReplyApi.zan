using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpAutoReplyApi {
    WechatClient client;

    public WechatMpAutoReplyApi(WechatClient client) {
        this.client = client;
    }

    public async WechatMpAutoReplyApiGetCurrentAutoreplyInfoResponse GetCurrentAutoreplyInfoAsync() {
        WechatResponse raw = await WechatMpRequest.GetAsync(this.client, "/cgi-bin/get_current_autoreply_info", "");
        WechatMpAutoReplyApiGetCurrentAutoreplyInfoResponse result = Json.Deserialize<WechatMpAutoReplyApiGetCurrentAutoreplyInfoResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse GetCurrentAutoreplyInfoRawAsync(string query) {
        return await WechatMpRequest.GetAsync(this.client, "/cgi-bin/get_current_autoreply_info", query);
    }

}
