using System;
using System.Json;
using Sdk.Wechat;

namespace Sdk.Wechat.Mp;

public class WechatMpInvoiceSpecialApi {
    WechatClient client;
    public WechatMpInvoiceSpecialApi(WechatClient client) { this.client = client; }

    async WechatMpSpecialSetPdfResponse SetPdfAsync(
            string fileName, string contentType, string fileBytes) {
        WechatMultipart form = new WechatMultipart();
        form.AddFile("pdf", fileName, contentType, fileBytes);
        WechatRawResponse raw = await this.client.RequestMultipartAsync("POST",
            "/card/invoice/platform/setpdf", "", form,
            WechatCredentialKind.AccessToken);
        WechatResponse parsed = raw.Json();
        WechatMpSpecialSetPdfResponse result =
            Json.Deserialize<WechatMpSpecialSetPdfResponse>(parsed.Data);
        result.Raw = parsed.Raw;
        return result;
    }
}

// 临时素材、永久素材和语音识别的二进制接口。
