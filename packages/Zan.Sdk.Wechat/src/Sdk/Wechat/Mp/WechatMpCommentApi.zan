    async WechatMpCommentApiOpenResponse OpenAsync(WechatMpCommentApiOpenRequest request) {
        if (request == null) { request = new WechatMpCommentApiOpenRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/cgi-bin/comment/open", request.QueryText(), request.JsonBody());
