/// <summary>非税缴费对账单下载；成功时 内容 为原始账单文本。</summary>
class WechatMpNonTaxSpecialApi {
    WechatClient client;
    public WechatMpNonTaxSpecialApi(WechatClient client) { this.client = client; }

    async WechatMpSpecialNonTaxBillResponse DownloadBillAsync(
            WechatMpNonTaxDownloadBillRequest request) {
        WechatRawResponse raw = await this.client.RequestRawAsync("POST",
            "/nontax/downloadbill", "",
            Json.Serialize<WechatMpNonTaxDownloadBillRequest>(request),
            "application/json", WechatCredentialKind.AccessToken);
        if (WechatMpSpecialProtocol.LooksLikeJson(raw.Body)) {
            raw.Json();
        }
        WechatMpSpecialNonTaxBillResponse result =
            new WechatMpSpecialNonTaxBillResponse();
        result.content = raw.Body;
        result.Raw = raw.Body;
        return result;
    }
}

