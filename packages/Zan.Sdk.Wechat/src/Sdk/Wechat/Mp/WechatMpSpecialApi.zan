using System;
using System.Text;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

/// <summary>公众号临时/永久素材类型。使用枚举避免调用方手写协议字符串。</summary>
enum WechatMpMediaType {
    Image,
    Voice,
    Video,
    Thumb
}

class WechatMpSpecialProtocol {
    static string MediaType(WechatMpMediaType mediaType) {
        if (mediaType == WechatMpMediaType.Image) { return "image"; }
        if (mediaType == WechatMpMediaType.Voice) { return "voice"; }
        if (mediaType == WechatMpMediaType.Video) { return "video"; }
        return "thumb";
    }

    static bool LooksLikeJson(string body) {
        for (int i = 0; i < body.Length; i = i + 1) {
            int c = body[i] & 255;
            if (c != 32 && c != 9 && c != 10 && c != 13) {
                return c == 123;
            }
        }
        return false;
    }

    static string VideoDescription(string title, string introduction) {
        JsonValue description = JsonValue.NewObject();
        description.Put("title", JsonValue.NewStr(title));
        description.Put("introduction", JsonValue.NewStr(introduction));
        return description.ToJson();
    }
}

class WechatMpSpecialOperationResponse {
    public int errcode;
    public string errmsg;
    public string Raw;
}

class WechatMpSpecialAiCropResponse : WechatMpAiCropJsonResult { public string Raw; }
class WechatMpSpecialQrCodeResponse : WechatMpQrCodeJsonResult { public string Raw; }
class WechatMpSpecialDrivingLicenseResponse : WechatMpDrivingLicenseJsonResult { public string Raw; }
class WechatMpSpecialSetPdfResponse : WechatMpSetPDFResultJson { public string Raw; }
class WechatMpSpecialUploadTemporaryMediaResponse : WechatMpUploadTemporaryMediaResult { public string Raw; }
class WechatMpSpecialUploadForeverMediaResponse : WechatMpUploadForeverMediaResult { public string Raw; }
class WechatMpSpecialUploadImgResponse : WechatMpUploadImgResult { public string Raw; }
class WechatMpSpecialPictureResponse : WechatMpPictureResult { public string Raw; }
class WechatMpSpecialNonTaxBillResponse : WechatMpNonTaxDownloadBillJsonResult { public string Raw; }
class WechatMpSpecialPoiUploadImageResponse : WechatMpPoiUploadImageResultJson { public string Raw; }
class WechatMpSpecialShakeUploadImageResponse : WechatMpUploadImageResultJson { public string Raw; }

/// <summary>客服头像上传；对应 CustomServiceApi.UploadCustomHeadimgAsync。</summary>
class WechatMpCustomServiceSpecialApi {
    WechatClient client;
    public WechatMpCustomServiceSpecialApi(WechatClient client) { this.client = client; }

    async WechatMpSpecialOperationResponse UploadCustomHeadimgAsync(
            string kfAccount, string fileName, string contentType, string fileBytes) {
        WechatMultipart form = new WechatMultipart();
        form.AddFile("media", fileName, contentType, fileBytes);
        WechatRawResponse raw = await this.client.RequestMultipartAsync("POST",
            "/customservice/kfaccount/uploadheadimg",
            "kf_account=" + Encoding.UrlEncode(kfAccount), form,
            WechatCredentialKind.AccessToken);
        WechatResponse parsed = raw.Json();
        WechatMpSpecialOperationResponse result =
            Json.Deserialize<WechatMpSpecialOperationResponse>(parsed.Data);
        result.Raw = parsed.Raw;
        return result;
    }
}

/// <summary>图像裁剪、二维码识别和驾驶证 OCR 文件上传接口。</summary>
class WechatMpCvSpecialApi {
    WechatClient client;
    public WechatMpCvSpecialApi(WechatClient client) { this.client = client; }

    async WechatMpSpecialAiCropResponse AiCropAsync(string imageUrl, string ratios) {
        string query = "img_url=" + Encoding.UrlEncode(imageUrl);
        WechatRawResponse raw;
        if (ratios.Length == 0) {
            raw = await this.client.RequestRawAsync("POST", "/cv/img/aicrop",
                query, "{}", "application/json", WechatCredentialKind.AccessToken);
        } else {
            WechatMultipart form = new WechatMultipart();
            form.AddField("ratios", ratios);
            raw = await this.client.RequestMultipartAsync("POST", "/cv/img/aicrop",
                query, form, WechatCredentialKind.AccessToken);
        }
        WechatResponse parsed = raw.Json();
        WechatMpSpecialAiCropResponse result =
            Json.Deserialize<WechatMpSpecialAiCropResponse>(parsed.Data);
        result.Raw = parsed.Raw;
        return result;
    }

    async WechatMpSpecialAiCropResponse AiCropByFileAsync(
            string ratios, string fileName, string contentType, string fileBytes) {
        WechatMultipart form = new WechatMultipart();
        form.AddFile("img", fileName, contentType, fileBytes);
        if (ratios.Length > 0) { form.AddField("ratios", ratios); }
        WechatRawResponse raw = await this.client.RequestMultipartAsync("POST",
            "/cv/img/aicrop", "", form, WechatCredentialKind.AccessToken);
        WechatResponse parsed = raw.Json();
        WechatMpSpecialAiCropResponse result =
            Json.Deserialize<WechatMpSpecialAiCropResponse>(parsed.Data);
        result.Raw = parsed.Raw;
        return result;
    }

    async WechatMpSpecialQrCodeResponse QrCodeByFileAsync(
            string fileName, string contentType, string fileBytes) {
        WechatMultipart form = new WechatMultipart();
        form.AddFile("img", fileName, contentType, fileBytes);
        WechatRawResponse raw = await this.client.RequestMultipartAsync("POST",
            "/cv/img/qrcode", "", form, WechatCredentialKind.AccessToken);
        WechatResponse parsed = raw.Json();
        WechatMpSpecialQrCodeResponse result =
            Json.Deserialize<WechatMpSpecialQrCodeResponse>(parsed.Data);
        result.Raw = parsed.Raw;
        return result;
    }

    async WechatMpSpecialDrivingLicenseResponse DrivingLicenseByFileAsync(
            string fileName, string contentType, string fileBytes) {
        WechatMultipart form = new WechatMultipart();
        form.AddFile("img", fileName, contentType, fileBytes);
        WechatRawResponse raw = await this.client.RequestMultipartAsync("POST",
            "/cv/ocr/drivinglicense", "", form, WechatCredentialKind.AccessToken);
        WechatResponse parsed = raw.Json();
        WechatMpSpecialDrivingLicenseResponse result =
            Json.Deserialize<WechatMpSpecialDrivingLicenseResponse>(parsed.Data);
        result.Raw = parsed.Raw;
        return result;
    }
}

