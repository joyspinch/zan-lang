/// <summary>二维码图片下载。该端点属于 mp.weixin.qq.com，且不需要 access token。</summary>
class WechatMpQrCodeSpecialApi {
    async WechatRawResponse ShowQrCodeAsync(string ticket) {
        WechatApiTransport transport = new WechatApiTransport("mp.weixin.qq.com");
        string path = WechatApiTransport.BuildPath("/cgi-bin/showqrcode",
            "ticket=" + Encoding.UrlEncode(ticket));
        return await transport.RequestSimpleRawAsync("GET", path, "", "");
    }
}

