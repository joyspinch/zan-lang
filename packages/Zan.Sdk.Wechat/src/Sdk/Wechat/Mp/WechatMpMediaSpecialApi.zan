using System;
using System.Json;
using Sdk.Wechat;

namespace Sdk.Wechat.Mp;

public class WechatMpMediaSpecialApi {
    WechatClient client;
    public WechatMpMediaSpecialApi(WechatClient client) { this.client = client; }

    async WechatMpSpecialUploadTemporaryMediaResponse UploadTemporaryMediaAsync(
            WechatMpMediaType mediaType, string fileName,
            string contentType, string fileBytes) {
        WechatMultipart form = new WechatMultipart();
        form.AddFile("media", fileName, contentType, fileBytes);
        string query = "type=" + Encoding.UrlEncode(
            WechatMpSpecialProtocol.MediaType(mediaType));
        WechatRawResponse raw = await this.client.RequestMultipartAsync("POST",
            "/cgi-bin/media/upload", query, form, WechatCredentialKind.AccessToken);
        WechatResponse parsed = raw.Json();
        WechatMpSpecialUploadTemporaryMediaResponse result =
            Json.Deserialize<WechatMpSpecialUploadTemporaryMediaResponse>(parsed.Data);
        result.Raw = parsed.Raw;
        return result;
    }

    public async WechatRawResponse GetAsync(string mediaId) {
        return await this.client.RequestRawAsync("GET", "/cgi-bin/media/get",
            "media_id=" + Encoding.UrlEncode(mediaId), "", "",
            WechatCredentialKind.AccessToken);
    }

    public async WechatRawResponse GetJssdkAsync(string mediaId) {
        return await this.client.RequestRawAsync("GET", "/cgi-bin/media/get/jssdk",
            "media_id=" + Encoding.UrlEncode(mediaId), "", "",
            WechatCredentialKind.AccessToken);
    }

    async WechatMpSpecialUploadForeverMediaResponse UploadForeverMediaAsync(
            WechatMpMediaType mediaType, string fileName,
            string contentType, string fileBytes) {
        WechatMultipart form = new WechatMultipart();
        form.AddFile("media", fileName, contentType, fileBytes);
        string query = "type=" + Encoding.UrlEncode(
            WechatMpSpecialProtocol.MediaType(mediaType));
        WechatRawResponse raw = await this.client.RequestMultipartAsync("POST",
            "/cgi-bin/material/add_material", query, form,
            WechatCredentialKind.AccessToken);
        WechatResponse parsed = raw.Json();
        WechatMpSpecialUploadForeverMediaResponse result =
            Json.Deserialize<WechatMpSpecialUploadForeverMediaResponse>(parsed.Data);
        result.Raw = parsed.Raw;
        return result;
    }

    async WechatMpSpecialUploadForeverMediaResponse UploadForeverVideoAsync(
            string title, string introduction, string fileName,
            string contentType, string fileBytes) {
        WechatMultipart form = new WechatMultipart();
        form.AddFile("media", fileName, contentType, fileBytes);
        form.AddField("description",
            WechatMpSpecialProtocol.VideoDescription(title, introduction));
        WechatRawResponse raw = await this.client.RequestMultipartAsync("POST",
            "/cgi-bin/material/add_material", "type=video", form,
            WechatCredentialKind.AccessToken);
        WechatResponse parsed = raw.Json();
        WechatMpSpecialUploadForeverMediaResponse result =
            Json.Deserialize<WechatMpSpecialUploadForeverMediaResponse>(parsed.Data);
        result.Raw = parsed.Raw;
        return result;
    }

    public async WechatRawResponse GetForeverMediaAsync(string mediaId) {
        JsonValue body = JsonValue.NewObject();
        body.Put("media_id", JsonValue.NewStr(mediaId));
        return await this.client.RequestRawAsync("POST",
            "/cgi-bin/material/get_material", "", body.ToJson(),
            "application/json", WechatCredentialKind.AccessToken);
    }

    public async WechatRawResponse GetForeverMediaWithContentTypeAsync(string mediaId) {
        return await this.GetForeverMediaAsync(mediaId);
    }

    async WechatMpSpecialUploadImgResponse UploadImgAsync(
            string fileName, string contentType, string fileBytes) {
        WechatMultipart form = new WechatMultipart();
        form.AddFile("media", fileName, contentType, fileBytes);
        WechatRawResponse raw = await this.client.RequestMultipartAsync("POST",
            "/cgi-bin/media/uploadimg", "", form, WechatCredentialKind.AccessToken);
        WechatResponse parsed = raw.Json();
        WechatMpSpecialUploadImgResponse result =
            Json.Deserialize<WechatMpSpecialUploadImgResponse>(parsed.Data);
        result.Raw = parsed.Raw;
        return result;
    }

    async WechatMpSpecialOperationResponse AddVoiceAsync(
            string format, string voiceId, string lang,
            string contentType, string voiceBytes) {
        string query = "format=" + Encoding.UrlEncode(format)
            + "&voice_id=" + Encoding.UrlEncode(voiceId)
            + "&lang=" + Encoding.UrlEncode(lang);
        WechatRawResponse raw = await this.client.RequestRawAsync("POST",
            "/cgi-bin/media/voice/addvoicetorecofortext", query,
            voiceBytes, contentType, WechatCredentialKind.AccessToken);
        WechatResponse parsed = raw.Json();
        WechatMpSpecialOperationResponse result =
            Json.Deserialize<WechatMpSpecialOperationResponse>(parsed.Data);
        result.Raw = parsed.Raw;
        return result;
    }
}

