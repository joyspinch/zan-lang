using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpMerchantOrderApi {
    WechatClient client;

    public WechatMpMerchantOrderApi(WechatClient client) {
        this.client = client;
    }

    async WechatMpMerchantOrderApiGetByIdOrderResponse GetByIdOrderAsync(WechatMpMerchantOrderApiGetByIdOrderRequest request) {
        if (request == null) { request = new WechatMpMerchantOrderApiGetByIdOrderRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/merchant/order/getbyid", request.QueryText(), request.JsonBody());
        WechatMpMerchantOrderApiGetByIdOrderResponse result = Json.Deserialize<WechatMpMerchantOrderApiGetByIdOrderResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GetByIdOrderRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/merchant/order/getbyid", query, jsonBody);
    }

    async WechatMpMerchantOrderApiGetByFilterOrderResponse GetByFilterOrderAsync(WechatMpMerchantOrderApiGetByFilterOrderRequest request) {
        if (request == null) { request = new WechatMpMerchantOrderApiGetByFilterOrderRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/merchant/order/getbyfilter", request.QueryText(), request.JsonBody());
        WechatMpMerchantOrderApiGetByFilterOrderResponse result = Json.Deserialize<WechatMpMerchantOrderApiGetByFilterOrderResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GetByFilterOrderRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/merchant/order/getbyfilter", query, jsonBody);
    }

    async WechatMpMerchantOrderApiSetdeliveryOrderResponse SetdeliveryOrderAsync(WechatMpMerchantOrderApiSetdeliveryOrderRequest request) {
        if (request == null) { request = new WechatMpMerchantOrderApiSetdeliveryOrderRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/merchant/order/setdelivery", request.QueryText(), request.JsonBody());
        WechatMpMerchantOrderApiSetdeliveryOrderResponse result = Json.Deserialize<WechatMpMerchantOrderApiSetdeliveryOrderResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse SetdeliveryOrderRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/merchant/order/setdelivery", query, jsonBody);
    }

    async WechatMpMerchantOrderApiCloseOrderResponse CloseOrderAsync(WechatMpMerchantOrderApiCloseOrderRequest request) {
        if (request == null) { request = new WechatMpMerchantOrderApiCloseOrderRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/merchant/order/close", request.QueryText(), request.JsonBody());
        WechatMpMerchantOrderApiCloseOrderResponse result = Json.Deserialize<WechatMpMerchantOrderApiCloseOrderResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse CloseOrderRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/merchant/order/close", query, jsonBody);
    }

}
