using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpMerchantGroupApi {
    WechatClient client;

    public WechatMpMerchantGroupApi(WechatClient client) {
        this.client = client;
    }

    async WechatMpMerchantGroupApiAddGroupResponse AddGroupAsync(WechatMpMerchantGroupApiAddGroupRequest request) {
        if (request == null) { request = new WechatMpMerchantGroupApiAddGroupRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/merchant/group/add", request.QueryText(), request.JsonBody());
        WechatMpMerchantGroupApiAddGroupResponse result = Json.Deserialize<WechatMpMerchantGroupApiAddGroupResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse AddGroupRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/merchant/group/add", query, jsonBody);
    }

    async WechatMpMerchantGroupApiDeleteGroupResponse DeleteGroupAsync(WechatMpMerchantGroupApiDeleteGroupRequest request) {
        if (request == null) { request = new WechatMpMerchantGroupApiDeleteGroupRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/merchant/group/del", request.QueryText(), request.JsonBody());
        WechatMpMerchantGroupApiDeleteGroupResponse result = Json.Deserialize<WechatMpMerchantGroupApiDeleteGroupResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse DeleteGroupRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/merchant/group/del", query, jsonBody);
    }

    async WechatMpMerchantGroupApiPropertyModGroupResponse PropertyModGroupAsync(WechatMpMerchantGroupApiPropertyModGroupRequest request) {
        if (request == null) { request = new WechatMpMerchantGroupApiPropertyModGroupRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/merchant/group/propertymod", request.QueryText(), request.JsonBody());
        WechatMpMerchantGroupApiPropertyModGroupResponse result = Json.Deserialize<WechatMpMerchantGroupApiPropertyModGroupResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse PropertyModGroupRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/merchant/group/propertymod", query, jsonBody);
    }

    async WechatMpMerchantGroupApiProductModGroupResponse ProductModGroupAsync(WechatMpMerchantGroupApiProductModGroupRequest request) {
        if (request == null) { request = new WechatMpMerchantGroupApiProductModGroupRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/merchant/group/productmod", request.QueryText(), request.JsonBody());
        WechatMpMerchantGroupApiProductModGroupResponse result = Json.Deserialize<WechatMpMerchantGroupApiProductModGroupResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse ProductModGroupRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/merchant/group/productmod", query, jsonBody);
    }

    async WechatMpMerchantGroupApiGetAllGroupResponse GetAllGroupAsync() {
        WechatResponse raw = await WechatMpRequest.GetAsync(this.client, "/merchant/group/getall", "");
        WechatMpMerchantGroupApiGetAllGroupResponse result = Json.Deserialize<WechatMpMerchantGroupApiGetAllGroupResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GetAllGroupRawAsync(string query) {
        return await WechatMpRequest.GetAsync(this.client, "/merchant/group/getall", query);
    }

    async WechatMpMerchantGroupApiGetByIdGroupResponse GetByIdGroupAsync(WechatMpMerchantGroupApiGetByIdGroupRequest request) {
        if (request == null) { request = new WechatMpMerchantGroupApiGetByIdGroupRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/merchant/group/getbyid", request.QueryText(), request.JsonBody());
        WechatMpMerchantGroupApiGetByIdGroupResponse result = Json.Deserialize<WechatMpMerchantGroupApiGetByIdGroupResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GetByIdGroupRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/merchant/group/getbyid", query, jsonBody);
    }

}
