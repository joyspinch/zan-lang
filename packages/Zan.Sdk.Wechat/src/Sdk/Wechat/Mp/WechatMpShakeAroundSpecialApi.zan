using System;
using System.Json;
using Sdk.Wechat;

namespace Sdk.Wechat.Mp;

public class WechatMpShakeAroundSpecialApi {
    WechatClient client;
    public WechatMpShakeAroundSpecialApi(WechatClient client) { this.client = client; }

    async WechatMpSpecialShakeUploadImageResponse UploadImageAsync(
            string fileName, string contentType, string fileBytes) {
        WechatMultipart form = new WechatMultipart();
        form.AddFile("media", fileName, contentType, fileBytes);
        WechatRawResponse raw = await this.client.RequestMultipartAsync("POST",
            "/shakearound/material/add", "", form,
            WechatCredentialKind.AccessToken);
        WechatResponse parsed = raw.Json();
        WechatMpSpecialShakeUploadImageResponse result =
            Json.Deserialize<WechatMpSpecialShakeUploadImageResponse>(parsed.Data);
        result.Raw = parsed.Raw;
        return result;
    }
}
