using System;
using System.Json;
using Sdk.Wechat;

namespace Sdk.Wechat.Mp;

public class WechatMpShakeAroundSpecialApi {
    WechatClient client;
    public WechatMpShakeAroundSpecialApi(WechatClient client) { this.client = client; }

    public async WechatMpSpecialShakeUploadImageResponse UploadImageAsync(
            string fileName, string contentType, string fileBytes) {
        WechatMultipart form = WechatMultipart.ForFile("media", fileName, contentType, fileBytes);
        WechatResponse parsed = await this.client.UploadJsonAsync(
            "/shakearound/material/add", "", form, WechatCredentialKind.AccessToken);
        WechatMpSpecialShakeUploadImageResponse result =
            Json.Deserialize<WechatMpSpecialShakeUploadImageResponse>(parsed.Data);
        result.Raw = parsed.Raw;
        return result;
    }
}
