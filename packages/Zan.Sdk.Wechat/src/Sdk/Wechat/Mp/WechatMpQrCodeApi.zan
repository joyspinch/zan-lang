using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpQrCodeApi {
    WechatClient client;

    public WechatMpQrCodeApi(WechatClient client) {
        this.client = client;
    }

    public async WechatMpQrCodeApiCreateResponse CreateAsync(WechatMpQrCodeApiCreateRequest request) {
        if (request == null) { request = new WechatMpQrCodeApiCreateRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/cgi-bin/qrcode/create", request.QueryText(), request.JsonBody());
        WechatMpQrCodeApiCreateResponse result = Json.Deserialize<WechatMpQrCodeApiCreateResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse CreateRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/cgi-bin/qrcode/create", query, jsonBody);
    }

}
