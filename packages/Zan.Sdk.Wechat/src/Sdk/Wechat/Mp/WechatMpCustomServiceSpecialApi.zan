using System;
using System.Json;
using Sdk.Wechat;

namespace Sdk.Wechat.Mp;

public class WechatMpCustomServiceSpecialApi {
    WechatClient client;
    public WechatMpCustomServiceSpecialApi(WechatClient client) { this.client = client; }

    async WechatMpSpecialOperationResponse UploadCustomHeadimgAsync(
            string kfAccount, string fileName, string contentType, string fileBytes) {
        WechatMultipart form = new WechatMultipart();
        form.AddFile("media", fileName, contentType, fileBytes);
        WechatRawResponse raw = await this.client.RequestMultipartAsync("POST",
            "/customservice/kfaccount/uploadheadimg",
            "kf_account=" + Encoding.UrlEncode(kfAccount), form,
            WechatCredentialKind.AccessToken);
        WechatResponse parsed = raw.Json();
        WechatMpSpecialOperationResponse result =
            Json.Deserialize<WechatMpSpecialOperationResponse>(parsed.Data);
        result.Raw = parsed.Raw;
        return result;
    }
}
