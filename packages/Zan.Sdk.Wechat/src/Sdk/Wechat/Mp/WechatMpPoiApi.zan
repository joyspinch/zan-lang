using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpPoiApi {
    WechatClient client;

    public WechatMpPoiApi(WechatClient client) {
        this.client = client;
    }

    public async WechatMpPoiApiAddPoiResponse AddPoiAsync(WechatMpPoiApiAddPoiRequest request) {
        if (request == null) { request = new WechatMpPoiApiAddPoiRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/cgi-bin/poi/addpoi", request.QueryText(), request.JsonBody());
        WechatMpPoiApiAddPoiResponse result = Json.Deserialize<WechatMpPoiApiAddPoiResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse AddPoiRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/cgi-bin/poi/addpoi", query, jsonBody);
    }

    public async WechatMpPoiApiGetPoiResponse GetPoiAsync(WechatMpPoiApiGetPoiRequest request) {
        if (request == null) { request = new WechatMpPoiApiGetPoiRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/cgi-bin/poi/getpoi", request.QueryText(), request.JsonBody());
        WechatMpPoiApiGetPoiResponse result = Json.Deserialize<WechatMpPoiApiGetPoiResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse GetPoiRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/cgi-bin/poi/getpoi", query, jsonBody);
    }

    public async WechatMpPoiApiGetPoiListResponse GetPoiListAsync(WechatMpPoiApiGetPoiListRequest request) {
        if (request == null) { request = new WechatMpPoiApiGetPoiListRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/cgi-bin/poi/getpoilist", request.QueryText(), request.JsonBody());
        WechatMpPoiApiGetPoiListResponse result = Json.Deserialize<WechatMpPoiApiGetPoiListResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse GetPoiListRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/cgi-bin/poi/getpoilist", query, jsonBody);
    }

    public async WechatMpPoiApiDeletePoiResponse DeletePoiAsync(WechatMpPoiApiDeletePoiRequest request) {
        if (request == null) { request = new WechatMpPoiApiDeletePoiRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/cgi-bin/poi/delpoi", request.QueryText(), request.JsonBody());
        WechatMpPoiApiDeletePoiResponse result = Json.Deserialize<WechatMpPoiApiDeletePoiResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse DeletePoiRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/cgi-bin/poi/delpoi", query, jsonBody);
    }

    public async WechatMpPoiApiUpdatePoiResponse UpdatePoiAsync(WechatMpPoiApiUpdatePoiRequest request) {
        if (request == null) { request = new WechatMpPoiApiUpdatePoiRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/cgi-bin/poi/updatepoi", request.QueryText(), request.JsonBody());
        WechatMpPoiApiUpdatePoiResponse result = Json.Deserialize<WechatMpPoiApiUpdatePoiResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse UpdatePoiRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/cgi-bin/poi/updatepoi", query, jsonBody);
    }

    public async WechatMpPoiApiGetCategoryResponse GetCategoryAsync() {
        WechatResponse raw = await WechatMpRequest.GetAsync(this.client, "/cgi-bin/poi/getwxcategory", "");
        WechatMpPoiApiGetCategoryResponse result = Json.Deserialize<WechatMpPoiApiGetCategoryResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse GetCategoryRawAsync(string query) {
        return await WechatMpRequest.GetAsync(this.client, "/cgi-bin/poi/getwxcategory", query);
    }

}
