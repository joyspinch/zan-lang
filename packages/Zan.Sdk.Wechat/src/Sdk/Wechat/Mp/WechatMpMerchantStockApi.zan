using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpMerchantStockApi {
    WechatClient client;

    public WechatMpMerchantStockApi(WechatClient client) {
        this.client = client;
    }

    async WechatMpMerchantStockApiAddStockResponse AddStockAsync(WechatMpMerchantStockApiAddStockRequest request) {
        if (request == null) { request = new WechatMpMerchantStockApiAddStockRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/merchant/stock/add", request.QueryText(), request.JsonBody());
        WechatMpMerchantStockApiAddStockResponse result = Json.Deserialize<WechatMpMerchantStockApiAddStockResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse AddStockRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/merchant/stock/add", query, jsonBody);
    }

    async WechatMpMerchantStockApiReduceStockResponse ReduceStockAsync(WechatMpMerchantStockApiReduceStockRequest request) {
        if (request == null) { request = new WechatMpMerchantStockApiReduceStockRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/merchant/stock/reduce", request.QueryText(), request.JsonBody());
        WechatMpMerchantStockApiReduceStockResponse result = Json.Deserialize<WechatMpMerchantStockApiReduceStockResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse ReduceStockRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/merchant/stock/reduce", query, jsonBody);
    }

}
