using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

// 方法请求/响应契约；可复用的 DTO 实体位于 Sdk.Wechat.Models.Mp。
class WechatMpMerchantStockApiAddStockRequest {
    WechatTypedRequest request;

    public WechatMpMerchantStockApiAddStockRequest() { this.request = new WechatTypedRequest(); }

    WechatMpMerchantStockApiAddStockRequest ProductId(string fieldValue) {
        this.request.BodyString("product_id", fieldValue);
        return this;
    }

    WechatMpMerchantStockApiAddStockRequest SkuInfo(string fieldValue) {
        this.request.BodyString("sku_info", fieldValue);
        return this;
    }

    WechatMpMerchantStockApiAddStockRequest Quantity(int fieldValue) {
        this.request.BodyInt("quantity", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}

class WechatMpMerchantStockApiAddStockResponse {
    public string Raw;
    public JsonValue Value;
}

class WechatMpMerchantStockApiReduceStockRequest {
    WechatTypedRequest request;

    public WechatMpMerchantStockApiReduceStockRequest() { this.request = new WechatTypedRequest(); }

    WechatMpMerchantStockApiReduceStockRequest ProductId(string fieldValue) {
        this.request.BodyString("product_id", fieldValue);
        return this;
    }

    WechatMpMerchantStockApiReduceStockRequest SkuInfo(string fieldValue) {
        this.request.BodyString("sku_info", fieldValue);
        return this;
    }

    WechatMpMerchantStockApiReduceStockRequest Quantity(int fieldValue) {
        this.request.BodyInt("quantity", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}

class WechatMpMerchantStockApiReduceStockResponse {
    public string Raw;
    public JsonValue Value;
}

// MerChant/Stock/StockApi.cs 的 Zan 强类型 JSON 接口。
// 从 Senparc.Weixin.MP.AdvancedAPIs 生成；请勿在此手抄 HTTP 逻辑。
class WechatMpMerchantStockApi {
    WechatClient client;

    public WechatMpMerchantStockApi(WechatClient client) {
        this.client = client;
    }

    // 开放平台业务 API 参数与响应数据模型契约。
    async WechatMpMerchantStockApiAddStockResponse AddStockAsync(WechatMpMerchantStockApiAddStockRequest request) {
        if (request == null) { request = new WechatMpMerchantStockApiAddStockRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/merchant/stock/add", request.QueryText(), request.JsonBody());
        WechatMpMerchantStockApiAddStockResponse result = Json.Deserialize<WechatMpMerchantStockApiAddStockResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse AddStockRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/merchant/stock/add", query, jsonBody);
    }

    // 开放平台业务 API 参数与响应数据模型契约。
    async WechatMpMerchantStockApiReduceStockResponse ReduceStockAsync(WechatMpMerchantStockApiReduceStockRequest request) {
        if (request == null) { request = new WechatMpMerchantStockApiReduceStockRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/merchant/stock/reduce", request.QueryText(), request.JsonBody());
        WechatMpMerchantStockApiReduceStockResponse result = Json.Deserialize<WechatMpMerchantStockApiReduceStockResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse ReduceStockRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/merchant/stock/reduce", query, jsonBody);
    }

}
