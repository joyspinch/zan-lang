using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCVOCRApi {
    WechatClient client;

    public WechatMpCVOCRApi(WechatClient client) {
        this.client = client;
    }

    async WechatMpCVOCRApiIdCardResponse IdCardAsync(WechatMpCVOCRApiIdCardRequest request) {
        if (request == null) { request = new WechatMpCVOCRApiIdCardRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/cv/ocr/idcard", request.QueryText(), request.JsonBody());
        WechatMpCVOCRApiIdCardResponse result = Json.Deserialize<WechatMpCVOCRApiIdCardResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse IdCardRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/cv/ocr/idcard", query, jsonBody);
    }

