using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

/// <summary>方法请求/响应契约；可复用的 DTO 实体见 Sdk.Wechat.Models.Mp。</summary>
class WechatMpUrlApiShortUrlRequest {
    WechatTypedRequest request;

    public WechatMpUrlApiShortUrlRequest() { this.request = new WechatTypedRequest(); }

    WechatMpUrlApiShortUrlRequest Action(string fieldValue) {
        this.request.BodyString("action", fieldValue);
        return this;
    }

    WechatMpUrlApiShortUrlRequest LongUrl(string fieldValue) {
        this.request.BodyString("long_url", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}

class WechatMpUrlApiShortUrlResponse : WechatMpShortUrlResult {
    public string Raw;
}

class WechatMpUrlApiGenerateShortenRequest {
    WechatTypedRequest request;

    public WechatMpUrlApiGenerateShortenRequest() { this.request = new WechatTypedRequest(); }

    WechatMpUrlApiGenerateShortenRequest LongData(string fieldValue) {
        this.request.BodyString("long_data", fieldValue);
        return this;
    }

    WechatMpUrlApiGenerateShortenRequest ExpireSeconds(int fieldValue) {
        this.request.BodyInt("expire_seconds", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}

class WechatMpUrlApiGenerateShortenResponse : WechatMpGenerateShortenJsonResult {
    public string Raw;
}

class WechatMpUrlApiFetchShortenRequest {
    WechatTypedRequest request;

    public WechatMpUrlApiFetchShortenRequest() { this.request = new WechatTypedRequest(); }

    WechatMpUrlApiFetchShortenRequest ShortKey(string fieldValue) {
        this.request.BodyString("short_key", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}

class WechatMpUrlApiFetchShortenResponse : WechatMpFetchShortenJsonResult {
    public string Raw;
}

/// <summary>
/// Url/UrlApi.cs 的 Zan 强类型 JSON 接口。
/// 从 Senparc.Weixin.MP.AdvancedAPIs 生成；请勿在此手抄 HTTP 逻辑。
/// </summary>
class WechatMpUrlApi {
    WechatClient client;

    public WechatMpUrlApi(WechatClient client) {
        this.client = client;
    }

    /// <summary>POST /cgi-bin/shorturl</summary>
    async WechatMpUrlApiShortUrlResponse ShortUrlAsync(WechatMpUrlApiShortUrlRequest request) {
        if (request == null) { request = new WechatMpUrlApiShortUrlRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/cgi-bin/shorturl", request.QueryText(), request.JsonBody());
        WechatMpUrlApiShortUrlResponse result = Json.Deserialize<WechatMpUrlApiShortUrlResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse ShortUrlRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/cgi-bin/shorturl", query, jsonBody);
    }

    /// <summary>POST /cgi-bin/shorten/gen</summary>
    async WechatMpUrlApiGenerateShortenResponse GenerateShortenAsync(WechatMpUrlApiGenerateShortenRequest request) {
        if (request == null) { request = new WechatMpUrlApiGenerateShortenRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/cgi-bin/shorten/gen", request.QueryText(), request.JsonBody());
        WechatMpUrlApiGenerateShortenResponse result = Json.Deserialize<WechatMpUrlApiGenerateShortenResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GenerateShortenRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/cgi-bin/shorten/gen", query, jsonBody);
    }

    /// <summary>POST /cgi-bin/shorten/fetch</summary>
    async WechatMpUrlApiFetchShortenResponse FetchShortenAsync(WechatMpUrlApiFetchShortenRequest request) {
        if (request == null) { request = new WechatMpUrlApiFetchShortenRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/cgi-bin/shorten/fetch", request.QueryText(), request.JsonBody());
        WechatMpUrlApiFetchShortenResponse result = Json.Deserialize<WechatMpUrlApiFetchShortenResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse FetchShortenRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/cgi-bin/shorten/fetch", query, jsonBody);
    }

}
