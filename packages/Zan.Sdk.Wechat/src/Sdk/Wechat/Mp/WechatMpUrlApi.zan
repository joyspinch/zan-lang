using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpUrlApi {
    WechatClient client;

    public WechatMpUrlApi(WechatClient client) {
        this.client = client;
    }

    public async WechatMpUrlApiShortUrlResponse ShortUrlAsync(WechatMpUrlApiShortUrlRequest request) {
        if (request == null) { request = new WechatMpUrlApiShortUrlRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/cgi-bin/shorturl", request.QueryText(), request.JsonBody());
        WechatMpUrlApiShortUrlResponse result = Json.Deserialize<WechatMpUrlApiShortUrlResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse ShortUrlRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/cgi-bin/shorturl", query, jsonBody);
    }

    public async WechatMpUrlApiGenerateShortenResponse GenerateShortenAsync(WechatMpUrlApiGenerateShortenRequest request) {
        if (request == null) { request = new WechatMpUrlApiGenerateShortenRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/cgi-bin/shorten/gen", request.QueryText(), request.JsonBody());
        WechatMpUrlApiGenerateShortenResponse result = Json.Deserialize<WechatMpUrlApiGenerateShortenResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse GenerateShortenRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/cgi-bin/shorten/gen", query, jsonBody);
    }

    public async WechatMpUrlApiFetchShortenResponse FetchShortenAsync(WechatMpUrlApiFetchShortenRequest request) {
        if (request == null) { request = new WechatMpUrlApiFetchShortenRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/cgi-bin/shorten/fetch", request.QueryText(), request.JsonBody());
        WechatMpUrlApiFetchShortenResponse result = Json.Deserialize<WechatMpUrlApiFetchShortenResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse FetchShortenRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/cgi-bin/shorten/fetch", query, jsonBody);
    }

}
