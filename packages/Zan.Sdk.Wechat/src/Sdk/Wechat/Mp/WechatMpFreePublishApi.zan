using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpFreePublishApi {
    WechatClient client;

    public WechatMpFreePublishApi(WechatClient client) {
        this.client = client;
    }

    public async WechatMpFreePublishApiSubmitResponse SubmitAsync(WechatMpFreePublishApiSubmitRequest request) {
        if (request == null) { request = new WechatMpFreePublishApiSubmitRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/cgi-bin/freepublish/submit", request.QueryText(), request.JsonBody());
        WechatMpFreePublishApiSubmitResponse result = Json.Deserialize<WechatMpFreePublishApiSubmitResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse SubmitRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/cgi-bin/freepublish/submit", query, jsonBody);
    }

