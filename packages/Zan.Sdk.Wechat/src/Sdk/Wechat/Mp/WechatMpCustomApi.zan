using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCustomApi {
    WechatClient client;

    public WechatMpCustomApi(WechatClient client) {
        this.client = client;
    }

    async WechatMpCustomApiSendTextResponse SendTextAsync(WechatMpCustomApiSendTextRequest request) {
        if (request == null) { request = new WechatMpCustomApiSendTextRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/cgi-bin/message/custom/send", request.QueryText(), request.JsonBody());
        WechatMpCustomApiSendTextResponse result = Json.Deserialize<WechatMpCustomApiSendTextResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse SendTextRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/cgi-bin/message/custom/send", query, jsonBody);
    }

