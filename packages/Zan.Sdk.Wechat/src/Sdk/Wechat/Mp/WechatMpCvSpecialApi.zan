using System;
using System.Json;
using Sdk.Wechat;

namespace Sdk.Wechat.Mp;

public class WechatMpCvSpecialApi {
    WechatClient client;
    public WechatMpCvSpecialApi(WechatClient client) { this.client = client; }

    public async WechatMpSpecialAiCropResponse AiCropAsync(string imageUrl, string ratios) {
        string query = "img_url=" + Encoding.UrlEncode(imageUrl);
        WechatRawResponse raw;
        if (ratios.Length == 0) {
            raw = await this.client.RequestRawAsync("POST", "/cv/img/aicrop",
                query, "{}", "application/json", WechatCredentialKind.AccessToken);
        } else {
            WechatMultipart form = new WechatMultipart();
            form.AddField("ratios", ratios);
            raw = await this.client.RequestMultipartAsync("POST", "/cv/img/aicrop",
                query, form, WechatCredentialKind.AccessToken);
        }
        WechatResponse parsed = raw.Json();
        WechatMpSpecialAiCropResponse result =
            Json.Deserialize<WechatMpSpecialAiCropResponse>(parsed.Data);
        result.Raw = parsed.Raw;
        return result;
    }

    async WechatMpSpecialAiCropResponse AiCropByFileAsync(
            string ratios, string fileName, string contentType, string fileBytes) {
        WechatMultipart form = new WechatMultipart();
        form.AddFile("img", fileName, contentType, fileBytes);
        if (ratios.Length > 0) { form.AddField("ratios", ratios); }
        WechatRawResponse raw = await this.client.RequestMultipartAsync("POST",
            "/cv/img/aicrop", "", form, WechatCredentialKind.AccessToken);
        WechatResponse parsed = raw.Json();
        WechatMpSpecialAiCropResponse result =
            Json.Deserialize<WechatMpSpecialAiCropResponse>(parsed.Data);
        result.Raw = parsed.Raw;
        return result;
    }

    async WechatMpSpecialQrCodeResponse QrCodeByFileAsync(
            string fileName, string contentType, string fileBytes) {
        WechatMultipart form = new WechatMultipart();
        form.AddFile("img", fileName, contentType, fileBytes);
        WechatRawResponse raw = await this.client.RequestMultipartAsync("POST",
            "/cv/img/qrcode", "", form, WechatCredentialKind.AccessToken);
        WechatResponse parsed = raw.Json();
        WechatMpSpecialQrCodeResponse result =
            Json.Deserialize<WechatMpSpecialQrCodeResponse>(parsed.Data);
        result.Raw = parsed.Raw;
        return result;
    }

    async WechatMpSpecialDrivingLicenseResponse DrivingLicenseByFileAsync(
            string fileName, string contentType, string fileBytes) {
        WechatMultipart form = new WechatMultipart();
        form.AddFile("img", fileName, contentType, fileBytes);
        WechatRawResponse raw = await this.client.RequestMultipartAsync("POST",
            "/cv/ocr/drivinglicense", "", form, WechatCredentialKind.AccessToken);
        WechatResponse parsed = raw.Json();
        WechatMpSpecialDrivingLicenseResponse result =
            Json.Deserialize<WechatMpSpecialDrivingLicenseResponse>(parsed.Data);
        result.Raw = parsed.Raw;
        return result;
    }
}

