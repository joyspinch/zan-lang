using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpCVImageApi {
    WechatClient client;

    public WechatMpCVImageApi(WechatClient client) {
        this.client = client;
    }

    public async WechatMpCVImageApiQrCodeResponse QrCodeAsync(WechatMpCVImageApiQrCodeRequest request) {
        if (request == null) { request = new WechatMpCVImageApiQrCodeRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/cv/img/qrcode", request.QueryText(), request.JsonBody());
        WechatMpCVImageApiQrCodeResponse result = Json.Deserialize<WechatMpCVImageApiQrCodeResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse QrCodeRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/cv/img/qrcode", query, jsonBody);
    }

}
