    public async WechatMpUserApiInfoResponse InfoAsync(WechatMpUserApiInfoRequest request) {
        if (request == null) { request = new WechatMpUserApiInfoRequest(); }
        WechatResponse raw = await WechatMpRequest.GetAsync(this.client, "/cgi-bin/user/info", request.QueryText());
        WechatMpUserApiInfoResponse result = Json.Deserialize<WechatMpUserApiInfoResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

