using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpSemanticApi {
    WechatClient client;

    public WechatMpSemanticApi(WechatClient client) {
        this.client = client;
    }

    public async WechatMpSemanticApiSemanticSendResponse SemanticSendAsync(WechatMpSemanticApiSemanticSendRequest request) {
        if (request == null) { request = new WechatMpSemanticApiSemanticSendRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/semantic/semproxy/search", request.QueryText(), request.JsonBody());
        WechatMpSemanticApiSemanticSendResponse result = Json.Deserialize<WechatMpSemanticApiSemanticSendResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse SemanticSendRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/semantic/semproxy/search", query, jsonBody);
    }

}
