using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Mp;

namespace Sdk.Wechat.Mp;

public class WechatMpMedicalAssistantApi {
    WechatClient client;

    public WechatMpMedicalAssistantApi(WechatClient client) {
        this.client = client;
    }

    public async WechatMpMedicalAssistantApiSendChannelMessageResponse SendChannelMessageAsync(WechatMpMedicalAssistantApiSendChannelMessageRequest request) {
        if (request == null) { request = new WechatMpMedicalAssistantApiSendChannelMessageRequest(); }
        WechatResponse raw = await WechatMpRequest.PostAsync(this.client, "/cityservice/sendchannelmsg", request.QueryText(), request.JsonBody());
        WechatMpMedicalAssistantApiSendChannelMessageResponse result = Json.Deserialize<WechatMpMedicalAssistantApiSendChannelMessageResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse SendChannelMessageRawAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/cityservice/sendchannelmsg", query, jsonBody);
    }

}
