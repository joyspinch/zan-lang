using System;
using System.Json;

namespace Sdk.Wechat;

// 微信 JSON 响应；HTTP 非 2xx 或 errcode 非 0 一律抛 WechatException。
public class WechatResponse {
    public string Data;
    public string Raw;
    public JsonValue Value;

    public WechatResponse(string data, string raw, JsonValue v) {
        this.Data = data;
        this.Raw = raw;
        this.Value = v;
    }

    public static WechatResponse FromRaw(WechatRawResponse raw) {
        if (!raw.IsSuccess()) {
            JsonValue errObj = null;
            try {
                errObj = JsonValue.Parse(raw.Body);
            } catch (Exception e) {
                errObj = null;
            }
            if (errObj != null && errObj.IsObject() && errObj.Has("errcode")) {
                int code = errObj.Int("errcode", 0);
                if (code != 0) {
                    throw new WechatException(Convert.ToString(code),
                        errObj.Str("errmsg", "微信返回错误"), raw.Body);
                }
            }
            throw new WechatException("http." + Convert.ToString(raw.StatusCode),
                "微信 HTTP 请求失败: " + Convert.ToString(raw.StatusCode), raw.Body);
        }
        return WechatResponse.Parse(raw.Body);
    }

    public static WechatResponse Parse(string body) {
        JsonValue root = null;
        try {
            root = JsonValue.Parse(body);
        } catch (Exception e) {
            throw new WechatException("client.badResponse", e.Message, body);
        }
        if (root == null || !root.IsObject()) {
            throw new WechatException("client.badResponse", "响应不是合法的 JSON 对象", body);
        }

        if (root.Has("errcode")) {
            int code = root.Int("errcode", 0);
            if (code != 0) {
                string msg = root.Str("errmsg", "微信返回错误");
                throw new WechatException(Convert.ToString(code), msg, body);
            }
        }

        return new WechatResponse(body, body, root);
    }

    public string Str(string key, string dflt) {
        if (this.Value == null) { return dflt; }
        return this.Value.Str(key, dflt);
    }

    public int Int(string key, int dflt) {
        if (this.Value == null) { return dflt; }
        return this.Value.Int(key, dflt);
    }
}
