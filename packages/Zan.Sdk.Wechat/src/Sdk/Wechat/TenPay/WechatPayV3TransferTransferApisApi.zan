using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3TransferTransferApisApi {
    WechatPayV3Client client;

    public WechatPayV3TransferTransferApisApi(WechatPayV3Client client) { this.client = client; }

    // POST /v3/transfer/batches; C# 参数：BatchesRequestData 数据, int timeOut = Config.TIME_OUT
    async WechatPayV3TransferTransferApisApiBatchesResponse BatchesAsync(WechatPayV3TransferTransferApisApiBatchesRequest request) {
        WechatRawResponse raw = await this.client.RequestJsonAsync("POST", request.Path(), request.QueryText(), request.JsonBody());
        WechatPayV3TransferTransferApisApiBatchesResponse result = Json.Deserialize<WechatPayV3TransferTransferApisApiBatchesResponse>(raw.Body);
        result.Raw = raw.Body;
        return result;
    }

    async WechatRawResponse BatchesRawAsync(string path, string query, string jsonBody) {
        return await this.client.RequestJsonAsync("POST", path, query, jsonBody);
    }

}
