using System;
using System.Collections.Generic;
using System.Security.Cryptography;
using System.Net.External;
using System.Net.Tls;
using Sdk.Wechat;

namespace Sdk.Wechat.TenPay;

public class WechatPayV2Client {

    WechatPayV2Config config;
    WechatApiTransport transport;
    WechatApiTransport mutualTransport;

    public WechatPayV2Client(WechatPayV2Config config) {
        this.config = config;
        this.transport = new WechatApiTransport("api.mch.weixin.qq.com");
        this.mutualTransport = new WechatApiTransport("api.mch.weixin.qq.com");
        if (config.ClientCertificateFile.Length > 0
            && config.ClientPrivateKeyFile.Length > 0) {
            this.mutualTransport.SetClientCertificate(config.ClientCertificateFile,
                                                      config.ClientPrivateKeyFile);
        }
    }

    public WechatPayV2Client Server(string host, int port) {
        this.transport.Server(host, port); this.mutualTransport.Server(host, port);
        return this;
    }

    public WechatPayV2Client PlainHttpMode() {
        this.transport.PlainHttpMode(); this.mutualTransport.PlainHttpMode();
        return this;
    }

    public WechatPayV2Client Timeout(int ms) {
        this.transport.Timeout(ms); this.mutualTransport.Timeout(ms); return this;
    }

    public WechatPayV2Client SetCallPolicy(ExternalCallPolicy policy) {
        this.transport.SetCallPolicy(policy);
        this.mutualTransport.SetCallPolicy(policy);
        return this;
    }

    public ExternalCallPolicy CallPolicy() {
        return this.transport.CallPolicy();
    }

    public WechatPayV2Client PinPublicKey(string spkiSha256Base64) {
        this.transport.PinPublicKey(spkiSha256Base64);
        this.mutualTransport.PinPublicKey(spkiSha256Base64);
        return this;
    }

    public WechatPayV2Client SetCertPolicy(CertPolicyFn fn) {
        this.transport.SetCertPolicy(fn);
        this.mutualTransport.SetCertPolicy(fn);
        return this;
    }

    public async WechatRawResponse RequestAsync(string path, WechatPayV2Request request,
                                                bool requireClientCertificate) {
        string xml = request.ToSignedXml(this.config);
        return await this.RequestXmlAsync(path, xml, requireClientCertificate);
    }

    public async WechatRawResponse RequestXmlAsync(string path, string signedXml,
                                                   bool requireClientCertificate) {
        WechatRawResponse raw;
        if (requireClientCertificate) {
            if (this.config.ClientCertificateFile.Length == 0
                || this.config.ClientPrivateKeyFile.Length == 0) {
                throw new InvalidOperationException("此微信支付 V2 接口需要配置 PEM 客户端证书和私钥");
            }
            raw = await this.mutualTransport.RequestRawAsync("POST", path,
                signedXml, "text/xml; charset=utf-8", null);
        } else {
            raw = await this.transport.RequestRawAsync("POST", path, signedXml,
                "text/xml; charset=utf-8", null);
        }
        if (!raw.IsSuccess()) {
            throw new WechatException("http." + Convert.ToString(raw.StatusCode),
                "微信支付 V2 HTTP 请求失败: " + Convert.ToString(raw.StatusCode), raw.Body);
        }
        if (XmlUtil.IndexOf(raw.Body, "<xml", 0) >= 0) {
            this.ValidateXmlResponse(raw.Body);
        }
        return raw;
    }

    private void ValidateXmlResponse(string xml) {
        WechatPayV2Request parsed = WechatPayV2Request.ParseXml(xml);
        string returnCode = parsed.Get("return_code", "");
        if (returnCode.Length > 0 && returnCode != "SUCCESS") {
            throw new WechatException(returnCode,
                parsed.Get("return_msg", "微信支付 V2 返回失败"), xml);
        }
        string sign = parsed.Get("sign", "");
        if (sign.Length > 0
            && !parsed.VerifyWithDefaultSignType(this.config.MerchantKey, this.config.SignType)) {
            throw new WechatException("tenpay.signatureInvalid",
                "微信支付 V2 响应签名验证失败", xml);
        }
        string resultCode = parsed.Get("result_code", "");
        if (resultCode.Length > 0 && resultCode != "SUCCESS") {
            string errCode = parsed.Get("err_code", resultCode);
            string errDesc = parsed.Get("err_code_des",
                parsed.Get("return_msg", "微信支付 V2 业务返回失败"));
            throw new WechatException(errCode, errDesc, xml);
        }
    }

    public bool VerifyResponse(string xml) {
        return WechatPayV2Request.ParseXml(xml)
            .VerifyWithDefaultSignType(this.config.MerchantKey, this.config.SignType);
    }

    public WechatPayV2Request VerifyNotification(string xml) {
        WechatPayV2Request parsed = WechatPayV2Request.ParseXml(xml);
        if (!parsed.VerifyWithDefaultSignType(this.config.MerchantKey, this.config.SignType)) {
            throw new WechatException("tenpay.signatureInvalid",
                "微信支付 V2 通知签名验证失败", xml);
        }
        return parsed;
    }

    public string DecodeRefundReqInfo(string encryptedBase64) {
        byte[] md5 = Md5.Hash(this.config.MerchantKey,
                              this.config.MerchantKey.Length);
        string key = Hex.Encode(md5, 16);
        List<int> cipherLen = new List<int>(); cipherLen.Add(0);
        byte[] encrypted = Base64.Decode(encryptedBase64, cipherLen);
        if (encrypted == null || cipherLen[0] == 0 || (cipherLen[0] % 16) != 0) {
            throw new ArgumentException("退款通知密文长度无效");
        }
        byte[] plain = new byte[cipherLen[0] + 1];
        int off = 0;
        while (off < cipherLen[0]) {
            string block = encrypted.ToStr(off, 16);
            byte[] decoded = Aes.DecryptBlockEcb(key, 32, block);
            if (decoded == null || decoded.Length < 16) {
                throw new ArgumentException("退款通知密文解密失败");
            }
            for (int j = 0; j < 16; j = j + 1) { plain[off + j] = decoded[j]; }
            off = off + 16;
        }
        int resultLen = cipherLen[0];
        int padding = plain[resultLen - 1] & 255;
        int bad = (padding < 1 || padding > 16 || padding > resultLen) ? 1 : 0;
        int checkLen = bad == 0 ? padding : 1;
        for (int j = 0; j < checkLen; j = j + 1) {
            bad = bad | ((plain[resultLen - 1 - j] & 255) ^ padding);
        }
        if (bad != 0) {
            throw new ArgumentException("退款通知密文 PKCS#7 填充非法");
        }
        return plain.ToStr(0, resultLen - padding);
    }
}
