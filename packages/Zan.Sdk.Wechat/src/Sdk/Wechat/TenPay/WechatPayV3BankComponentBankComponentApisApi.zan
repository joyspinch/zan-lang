    // POST /v3/capital/capitallhh/banks/personal-banking; C# 参数：QueryBankRequestData 数据, int timeOut = Config.TIME_OUT
    async WechatPayV3BankComponentBankComponentApisApiQueryBankResponse QueryBankAsync(WechatPayV3BankComponentBankComponentApisApiQueryBankRequest request) {
        WechatRawResponse raw = await this.client.RequestJsonAsync("POST", request.Path(), request.QueryText(), request.JsonBody());
        WechatPayV3BankComponentBankComponentApisApiQueryBankResponse result = Json.Deserialize<WechatPayV3BankComponentBankComponentApisApiQueryBankResponse>(raw.Body);
        result.Raw = raw.Body;
        return result;
    }

    async WechatRawResponse QueryBankRawAsync(string path, string query, string jsonBody) {
        return await this.client.RequestJsonAsync("POST", path, query, jsonBody);
    }

