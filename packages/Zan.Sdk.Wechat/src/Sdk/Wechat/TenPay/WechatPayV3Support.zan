using System;
using System.Json;
using System.Security.Cryptography;

namespace Sdk.Wechat.TenPay;

/// <summary>微信支付平台证书/公钥实体（消除 serials / pems / keys 平行列表反模式）。</summary>
class WechatPayPlatformKeyEntry {
    public string serial;
    public string pem;
    public RsaKey key;

    WechatPayPlatformKeyEntry(string serial, string pem, RsaKey key) {
        this.serial = serial != null ? serial : "";
        this.pem = pem != null ? pem : "";
        this.key = key;
    }
}

/// <summary>微信支付平台证书/公钥缓存，按序列号支持证书轮换。</summary>
class WechatPayPlatformKeyStore {
    List<WechatPayPlatformKeyEntry> entries;

    public WechatPayPlatformKeyStore() {
        this.entries = new List<WechatPayPlatformKeyEntry>();
    }

    int Count() { return this.entries.Count; }

    WechatPayPlatformKeyStore Add(string serial, string publicKeyOrCertificatePem) {
        RsaKey key = RsaKey.FromPublicPem(publicKeyOrCertificatePem);
        if (key == null) {
            throw new ArgumentException("微信支付平台公钥或证书 PEM 无效");
        }
        int i = this.IndexOf(serial);
        if (i >= 0) {
            this.entries[i].pem = publicKeyOrCertificatePem;
            this.entries[i].key = key;
        } else {
            this.entries.Add(new WechatPayPlatformKeyEntry(serial, publicKeyOrCertificatePem, key));
        }
        return this;
    }

    bool Contains(string serial) { return this.IndexOf(serial) >= 0; }

    RsaKey Get(string serial) {
        int i = this.IndexOf(serial);
        if (i < 0) { return null; }
        return this.entries[i].key;
    }

    string Pem(string serial) {
        int i = this.IndexOf(serial);
        if (i < 0) { return ""; }
        return this.entries[i].pem;
    }

    string SerialAt(int index) {
        if (index >= 0 && index < this.entries.Count) {
            return this.entries[index].serial;
        }
        return "";
    }

    RsaKey First() {
        if (this.entries.Count == 0) { return null; }
        return this.entries[0].key;
    }

    int IndexOf(string serial) {
        for (int i = 0; i < this.entries.Count; i = i + 1) {
            if (this.entries[i].serial == serial) { return i; }
        }
        return -1;
    }
}

/// <summary>
/// 微信支付 API v3 通知。原始报文、通知 ID、验签与 AES-GCM 资源解密均保留，
/// 业务方可将 DecryptResource() 的 JSON 再映射为自己的数据类型。
/// </summary>
class WechatPayNotification {
    string Id;
    string CreateTime;
    string EventType;
    string ResourceType;
    string Summary;
    string Algorithm;
    string Ciphertext;
    string Nonce;
    string AssociatedData;
    string RawBody;

    public WechatPayNotification() {
        this.Id = "";
        this.CreateTime = "";
        this.EventType = "";
        this.ResourceType = "";
        this.Summary = "";
        this.Algorithm = "";
        this.Ciphertext = "";
        this.Nonce = "";
        this.AssociatedData = "";
        this.RawBody = "";
    }

    static WechatPayNotification Parse(string body) {
        JsonValue root = JsonValue.Parse(body);
        if (root == null || !root.IsObject()) {
            throw new ArgumentException("微信支付通知不是 JSON 对象");
        }
        WechatPayNotification n = new WechatPayNotification();
        n.RawBody = body;
        n.Id = root.Str("id", "");
        n.CreateTime = root.Str("create_time", "");
        n.EventType = root.Str("event_type", "");
        n.ResourceType = root.Str("resource_type", "");
        n.Summary = root.Str("summary", "");
        JsonValue resource = root.Get("resource");
        if (resource != null && resource.IsObject()) {
            n.Algorithm = resource.Str("algorithm", "");
            n.Ciphertext = resource.Str("ciphertext", "");
            n.Nonce = resource.Str("nonce", "");
            n.AssociatedData = resource.Str("associated_data", "");
        }
        return n;
    }

    bool Verify(WechatPayV3Client client, string timestamp, string nonce,
                string signature, string serial) {
        return client.VerifyNotification(timestamp, nonce, this.RawBody,
                                         signature, serial);
    }

    bool VerifyWithPublicKey(string timestamp, string nonce,
                             string signature, string serial,
                             string expectedSerial, string publicKeyPem) {
        return WechatPayV3Client.VerifyNotificationWithPublicKey(timestamp,
            nonce, this.RawBody, signature, serial, expectedSerial,
            publicKeyPem);
    }

    string DecryptResourceWithKey(string apiKey) {
        return WechatPayV3Client.DecryptResourceWithKey(apiKey,
            this.Ciphertext, this.Nonce, this.AssociatedData);
    }

    string DecryptResource(WechatPayV3Client client) {
        if (this.Algorithm.Length > 0
            && this.Algorithm != "AEAD_AES_256_GCM") {
            throw new InvalidOperationException("当前仅支持 AEAD_AES_256_GCM 通知资源");
        }
        return client.DecryptResource(this.Ciphertext, this.Nonce,
                                      this.AssociatedData);
    }
}
