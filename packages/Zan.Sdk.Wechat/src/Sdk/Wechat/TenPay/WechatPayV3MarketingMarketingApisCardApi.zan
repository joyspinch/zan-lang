using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3MarketingMarketingApisCardApi {
    WechatPayV3Client client;

    public WechatPayV3MarketingMarketingApisCardApi(WechatPayV3Client client) { this.client = client; }

    // POST /v3/marketing/busifavor/coupons/{数据.card_id}/发送; C# 参数：SendCardRequestData 数据, int timeOut = Config.TIME_OUT
    public async WechatPayV3MarketingMarketingApisCardApiSendCardResponse SendCardAsync(WechatPayV3MarketingMarketingApisCardApiSendCardRequest request) {
        WechatRawResponse raw = await this.client.RequestJsonAsync("POST", request.Path(), request.QueryText(), request.JsonBody());
        WechatPayV3MarketingMarketingApisCardApiSendCardResponse result = Json.Deserialize<WechatPayV3MarketingMarketingApisCardApiSendCardResponse>(raw.Body);
        result.Raw = raw.Body;
        return result;
    }

    public async WechatRawResponse SendCardRawAsync(string path, string query, string jsonBody) {
        return await this.client.RequestJsonAsync("POST", path, query, jsonBody);
    }

}
