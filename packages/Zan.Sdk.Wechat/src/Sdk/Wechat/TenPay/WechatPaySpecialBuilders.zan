using System;
using System.Collections.Generic;

namespace Sdk.Wechat.TenPay;

public class WechatPaySpecialBuilders {
    public static string VehicleParkingRepaymentMiniProgramAppId() {
        return "wx5e73c65404eee268";
    }
    public static string VehicleParkingRepaymentMiniProgramUserName() {
        return "gh_5e259b7a73b1";
    }

    public static string CreateVehicleParkingRepaymentData(string appId,
                                                     string merchantId,
                                                     string openId,
                                                     string nonce) {
        string actualNonce = nonce;
        if (actualNonce.Length == 0) {
            actualNonce = Hex.Encode(RandomNumberGenerator.GetBytes(16), 16);
        }
        WxPayRepayData o = new WxPayRepayData();
        o.appid = appId;
        o.mchid = merchantId;
        o.nonce_str = actualNonce;
        o.openid = openId;
        return Json.Serialize<WxPayRepayData>(o);
    }

    public static string CreateVehicleParkingRepaymentPath(string appId,
                                                     string merchantId,
                                                     string openId,
                                                     string nonce) {
        return "pages/invest_list/invest_list?mchid=" + Encoding.UrlEncode(merchantId)
            + "&appid=" + Encoding.UrlEncode(appId)
            + "&nonce_str=" + Encoding.UrlEncode(nonce)
            + "&openid=" + Encoding.UrlEncode(openId);
    }

    public static string CreateMedicalInsurancePayPackage(WechatPayV3Client client,
                                                    string mixTradeNo,
                                                    string prepayId,
                                                    string appId,
                                                    bool includeAppId) {
        JsonValue o = JsonValue.NewObject();
        o.Put("mixTradeNo", JsonValue.NewStr(mixTradeNo));
        if (includeAppId) {
            o.Put("appid", JsonValue.NewStr(appId));
        }
        if (prepayId.Length > 0) {
            long timestamp = DateTime.UtcNow().ToUnixSeconds();
            string nonce = Hex.Encode(RandomNumberGenerator.GetBytes(16), 16);
            string packageValue = "prepay_id=" + prepayId;
            string paySign = client.SignAppMessage(appId, packageValue,
                                                   timestamp, nonce);
            o.Put("timeStamp", JsonValue.NewStr(Convert.ToString(timestamp)));
            o.Put("nonceStr", JsonValue.NewStr(nonce));
            o.Put("package", JsonValue.NewStr(packageValue));
            o.Put("signType", JsonValue.NewStr("RSA"));
            o.Put("paySign", JsonValue.NewStr(paySign));
        }
        return o.ToJson();
    }
}
