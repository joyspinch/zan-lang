using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3MerchantGovernanceMerchantLimitationApisApi {
    WechatPayV3Client client;

    public WechatPayV3MerchantGovernanceMerchantLimitationApisApi(WechatPayV3Client client) { this.client = client; }

    // GET /v3/mch-operation-manage/merchant-limitations/sub-mchid/{Escape(subMchId)}; C# 参数：string subMchId, int timeOut = Config.TIME_OUT
    public async WechatPayV3MerchantGovernanceMerchantLimitationApisApiQuerySubMerchantLimitationResponse QuerySubMerchantLimitationAsync(WechatPayV3MerchantGovernanceMerchantLimitationApisApiQuerySubMerchantLimitationRequest request) {
        WechatRawResponse raw = await this.client.RequestJsonAsync("GET", request.Path(), request.QueryText(), "");
        WechatPayV3MerchantGovernanceMerchantLimitationApisApiQuerySubMerchantLimitationResponse result = Json.Deserialize<WechatPayV3MerchantGovernanceMerchantLimitationApisApiQuerySubMerchantLimitationResponse>(raw.Body);
        result.Raw = raw.Body;
        return result;
    }

    public async WechatRawResponse QuerySubMerchantLimitationRawAsync(string path, string query) {
        return await this.client.RequestJsonAsync("GET", path, query, "");
    }

}
