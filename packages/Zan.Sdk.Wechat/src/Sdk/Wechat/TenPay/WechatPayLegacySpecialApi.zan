using System;
using System.Text;
using System.Security.Cryptography;
using System.Json;

namespace Sdk.Wechat.TenPay;

class WechatPayLegacyRedPackApi {
    WechatPayV2Client client;
    public WechatPayLegacyRedPackApi(WechatPayV2Client client) {
        this.client = client;
    }

    async WechatRawResponse SendNormalRedPackAsync(WechatPayV2Request request) {
        return await this.client.RequestAsync("/mmpaymkttransfers/sendredpack",
                                              request, true);
    }
    async WechatRawResponse SendGroupRedPackAsync(WechatPayV2Request request) {
        return await this.client.RequestAsync("/mmpaymkttransfers/sendgroupredpack",
                                              request, true);
    }
    async WechatRawResponse SearchRedPackAsync(WechatPayV2Request request) {
        return await this.client.RequestAsync("/mmpaymkttransfers/gethbinfo",
                                              request, true);
    }
    async WechatRawResponse SendMiniAppRedPackAsync(WechatPayV2Request request) {
        return await this.client.RequestAsync("/mmpaymkttransfers/sendminiprogramhb",
                                              request, true);
    }
    async WechatRawResponse SendNormalRedPackViaProviderAsync(
                                              WechatPayV2Request request) {
        return await this.client.RequestAsync("/mmpaymkttransfers/sendredpack",
                                              request, true);
    }
    async WechatRawResponse HbPreOrderAsync(WechatPayV2Request request) {
        return await this.client.RequestAsync("/mmpaymkttransfers/hbpreorder",
                                              request, true);
    }
    async WechatRawResponse SendWorkRedPackAsync(WechatPayV2Request request) {
        return await this.client.RequestAsync("/mmpaymkttransfers/sendworkwxredpack",
                                              request, true);
    }
    async WechatRawResponse QueryWorkRedPackAsync(WechatPayV2Request request) {
        return await this.client.RequestAsync("/mmpaymkttransfers/queryworkwxredpack",
                                              request, true);
    }
}

// 旧版 XML 分账接口。
class WechatPayLegacyProfitSharingApi {
    WechatPayV2Client client;
    public WechatPayLegacyProfitSharingApi(WechatPayV2Client client) {
        this.client = client;
    }

    async WechatRawResponse ProfitSharingAsync(WechatPayV2Request request) {
        return await this.client.RequestAsync("/secapi/pay/profitsharing",
                                              request, true);
    }
    async WechatRawResponse MultiProfitSharingAsync(WechatPayV2Request request) {
        return await this.client.RequestAsync("/secapi/pay/multiprofitsharing",
                                              request, true);
    }
    async WechatRawResponse ProfitSharingFinishAsync(WechatPayV2Request request) {
        return await this.client.RequestAsync("/secapi/pay/profitsharingfinish",
                                              request, true);
    }
    async WechatRawResponse ProfitSharingAddReceiverAsync(
                                              WechatPayV2Request request) {
        return await this.client.RequestAsync("/pay/profitsharingaddreceiver",
                                              request, false);
    }
    async WechatRawResponse ProfitSharingRemoveReceiverAsync(
                                              WechatPayV2Request request) {
        return await this.client.RequestAsync("/pay/profitsharingremovereceiver",
                                              request, false);
    }
    async WechatRawResponse ProfitSharingQueryAsync(WechatPayV2Request request) {
        return await this.client.RequestAsync("/pay/profitsharingquery",
                                              request, false);
    }
}

// 现代特殊接口中的客户端参数构造辅助。
class WechatPaySpecialBuilders {
    static string VehicleParkingRepaymentMiniProgramAppId() {
        return "wx5e73c65404eee268";
    }
    static string VehicleParkingRepaymentMiniProgramUserName() {
        return "gh_5e259b7a73b1";
    }

    static string CreateVehicleParkingRepaymentData(string appId,
                                                     string merchantId,
                                                     string openId,
                                                     string nonce) {
        string actualNonce = nonce;
        if (actualNonce.Length == 0) {
            actualNonce = Hex.Encode(RandomNumberGenerator.GetBytes(16), 16);
        }
        WxPayRepayData o = new WxPayRepayData();
        o.appid = appId;
        o.mchid = merchantId;
        o.nonce_str = actualNonce;
        o.openid = openId;
        return Json.Serialize<WxPayRepayData>(o);
    }

    static string CreateVehicleParkingRepaymentPath(string appId,
                                                     string merchantId,
                                                     string openId,
                                                     string nonce) {
        return "pages/invest_list/invest_list?mchid=" + Encoding.UrlEncode(merchantId)
            + "&appid=" + Encoding.UrlEncode(appId)
            + "&nonce_str=" + Encoding.UrlEncode(nonce)
            + "&openid=" + Encoding.UrlEncode(openId);
    }

    static string CreateMedicalInsurancePayPackage(WechatPayV3Client client,
                                                    string mixTradeNo,
                                                    string prepayId,
                                                    string appId,
                                                    bool includeAppId) {
        JsonValue o = JsonValue.NewObject();
        o.Put("mixTradeNo", JsonValue.NewStr(mixTradeNo));
        if (includeAppId) {
            o.Put("appid", JsonValue.NewStr(appId));
        }
        if (prepayId.Length > 0) {
            long timestamp = DateTime.UtcNow().ToUnixSeconds();
            string nonce = Hex.Encode(RandomNumberGenerator.GetBytes(16), 16);
            string packageValue = "prepay_id=" + prepayId;
            string paySign = client.SignAppMessage(appId, packageValue,
                                                   timestamp, nonce);
            o.Put("timeStamp", JsonValue.NewStr(Convert.ToString(timestamp)));
            o.Put("nonceStr", JsonValue.NewStr(nonce));
            o.Put("package", JsonValue.NewStr(packageValue));
            o.Put("signType", JsonValue.NewStr("RSA"));
            o.Put("paySign", JsonValue.NewStr(paySign));
        }
        return o.ToJson();
    }
}

class WechatPayLegacySpecialApi { }
