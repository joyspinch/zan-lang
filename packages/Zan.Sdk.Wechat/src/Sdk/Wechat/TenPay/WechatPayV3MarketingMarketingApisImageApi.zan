using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayV3MarketingMarketingApisImageApi {
    WechatPayV3Client client;

    public WechatPayV3MarketingMarketingApisImageApi(WechatPayV3Client client) { this.client = client; }

    // POST /v3/marketing/favor/media/图片-upload; C# 参数：UploadImageRequestData 数据, int timeOut = Config.TIME_OUT
    public async WechatPayV3MarketingMarketingApisImageApiUploadImageResponse UploadImage(WechatPayV3MarketingMarketingApisImageApiUploadImageRequest request) {
        WechatRawResponse raw = await this.client.RequestJsonAsync("POST", request.Path(), request.QueryText(), request.JsonBody());
        WechatPayV3MarketingMarketingApisImageApiUploadImageResponse result = Json.Deserialize<WechatPayV3MarketingMarketingApisImageApiUploadImageResponse>(raw.Body);
        result.Raw = raw.Body;
        return result;
    }

    public async WechatRawResponse UploadImage(string path, string query, string jsonBody) {
        return await this.client.RequestJsonAsync("POST", path, query, jsonBody);
    }

}
