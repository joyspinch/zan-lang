using System;
using Sdk.Wechat;
using System.Net.External;

namespace Sdk.Wechat.TenPay;

// 早期公众号支付 /pay 与 /payfeedback 接口配置。
public class WechatPayLegacyMpClient {
    WechatPayLegacyMpConfig config;
    WechatApiTransport transport;

    public WechatPayLegacyMpClient(WechatPayLegacyMpConfig config) {
        this.config = config;
        this.transport = new WechatApiTransport("api.weixin.qq.com");
    }

    public WechatPayLegacyMpClient Server(string host, int port) {
        this.transport.Server(host, port); return this;
    }
    public WechatPayLegacyMpClient PlainHttpMode() {
        this.transport.PlainHttpMode(); return this;
    }
    public WechatPayLegacyMpClient Timeout(int ms) {
        this.transport.Timeout(ms); return this;
    }
    public WechatPayLegacyMpClient SetCallPolicy(ExternalCallPolicy policy) {
        this.transport.SetCallPolicy(policy); return this;
    }
    public ExternalCallPolicy CallPolicy() {
        return this.transport.CallPolicy();
    }
    public WechatPayLegacyMpClient SetAccessToken(string accessToken) {
        this.config.AccessToken = accessToken; return this;
    }

    private string BuildTarget(string path, string query) {
        if (this.config.AccessToken.Length == 0) {
            throw new InvalidOperationException("早期公众号支付接口需要 access_token");
        }
        return WechatApiTransport.BuildTarget(path, query,
            WechatCredentialKind.AccessToken, this.config.AccessToken);
    }

    public async WechatRawResponse RequestJsonAsync(string method, string path,
                                                    string query, string jsonBody) {
        string target = this.BuildTarget(path, query);
        string body = jsonBody;
        if (method != "GET" && body.Length == 0) { body = "{}"; }
        WechatRawResponse raw = await this.transport.RequestRawAsync(
            method, target, body, "application/json", null);
        WechatResponse.FromRaw(raw);
        return raw;
    }

    public async WechatRawResponse RequestMultipartAsync(string method, string path,
                                                         string query,
                                                         WechatMultipart multipart) {
        string target = this.BuildTarget(path, query);
        return await this.transport.RequestMultipartAsync(method, target, multipart);
    }
}
