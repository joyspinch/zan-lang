using System;
using System.Collections.Generic;

namespace Sdk.Wechat.TenPay;

public class WechatPayLegacyRedPackApi {
    WechatPayV2Client client;
    public WechatPayLegacyRedPackApi(WechatPayV2Client client) {
        this.client = client;
    }

    public async WechatRawResponse SendNormalRedPackAsync(WechatPayV2Request request) {
        return await this.client.RequestAsync("/mmpaymkttransfers/sendredpack",
                                              request, true);
    }
    public async WechatRawResponse SendGroupRedPackAsync(WechatPayV2Request request) {
        return await this.client.RequestAsync("/mmpaymkttransfers/sendgroupredpack",
                                              request, true);
    }
    public async WechatRawResponse SearchRedPackAsync(WechatPayV2Request request) {
        return await this.client.RequestAsync("/mmpaymkttransfers/gethbinfo",
                                              request, true);
    }
    public async WechatRawResponse SendMiniAppRedPackAsync(WechatPayV2Request request) {
        return await this.client.RequestAsync("/mmpaymkttransfers/sendminiprogramhb",
                                              request, true);
    }
    async WechatRawResponse SendNormalRedPackViaProviderAsync(
                                              WechatPayV2Request request) {
        return await this.client.RequestAsync("/mmpaymkttransfers/sendredpack",
                                              request, true);
    }
    public async WechatRawResponse HbPreOrderAsync(WechatPayV2Request request) {
        return await this.client.RequestAsync("/mmpaymkttransfers/hbpreorder",
                                              request, true);
    }
    public async WechatRawResponse SendWorkRedPackAsync(WechatPayV2Request request) {
        return await this.client.RequestAsync("/mmpaymkttransfers/sendworkwxredpack",
                                              request, true);
    }
    public async WechatRawResponse QueryWorkRedPackAsync(WechatPayV2Request request) {
        return await this.client.RequestAsync("/mmpaymkttransfers/queryworkwxredpack",
                                              request, true);
    }
}

// 旧版 XML 分账接口。
