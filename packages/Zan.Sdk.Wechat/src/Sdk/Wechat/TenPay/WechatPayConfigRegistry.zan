using System;
using System.Collections.Generic;

namespace Sdk.Wechat.TenPay;

public class WechatPayConfigRegistry {
    List<WechatPayV3Entry> v3Entries;
    List<WechatPayV2Entry> v2Entries;

    public WechatPayConfigRegistry() {
        this.v3Entries = new List<WechatPayV3Entry>();
        this.v2Entries = new List<WechatPayV2Entry>();
    }

    WechatPayConfigRegistry AddV3(string name, WechatPayV3Config config) {
        int i = this.IndexOfV3(name);
        if (i >= 0) { this.v3Entries[i].config = config; }
        else { this.v3Entries.Add(new WechatPayV3Entry(name, config)); }
        return this;
    }

    WechatPayConfigRegistry AddV2(string name, WechatPayV2Config config) {
        int i = this.IndexOfV2(name);
        if (i >= 0) { this.v2Entries[i].config = config; }
        else { this.v2Entries.Add(new WechatPayV2Entry(name, config)); }
        return this;
    }

    WechatPayV3Config GetV3(string name) {
        int i = this.IndexOfV3(name);
        if (i < 0) { return null; }
        return this.v3Entries[i].config;
    }

    WechatPayV2Config GetV2(string name) {
        int i = this.IndexOfV2(name);
        if (i < 0) { return null; }
        return this.v2Entries[i].config;
    }

    int IndexOfV3(string name) {
        for (int i = 0; i < this.v3Entries.Count; i = i + 1) {
            if (this.v3Entries[i].name == name) { return i; }
        }
        return -1;
    }

    int IndexOfV2(string name) {
        for (int i = 0; i < this.v2Entries.Count; i = i + 1) {
            if (this.v2Entries[i].name == name) { return i; }
        }
        return -1;
    }
}
