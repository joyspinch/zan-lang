class WechatPayLegacyTenPayV3Api {
    WechatPayV2Client client;

    public WechatPayLegacyTenPayV3Api(WechatPayV2Client client) { this.client = client; }

    /// <summary>POST /sandboxnew/pay/getsignkey; C# 参数：TenPayV3GetSignKeyRequestData dataInfo, int timeOut = Config.TIME_OUT</summary>
    async WechatPayLegacyTenPayV3ApiGetSignKeyResponse GetSignKeyAsync(WechatPayLegacyTenPayV3ApiGetSignKeyRequest request) {
        WechatRawResponse raw = await this.client.RequestAsync("/sandboxnew/pay/getsignkey", request.Inner(), false);
        WechatPayLegacyTenPayV3ApiGetSignKeyResponse result = new WechatPayLegacyTenPayV3ApiGetSignKeyResponse();
        result.Raw = raw.Body;
        WechatPayV2Request xml = WechatPayV2Request.ParseXml(raw.Body);
        result.mch_id = xml.Get("mch_id", "");
        result.sandbox_signkey = xml.Get("sandbox_signkey", "");
        result.return_code = xml.Get("return_code", "");
        result.return_msg = xml.Get("return_msg", "");
        return result;
    }

    async WechatRawResponse GetSignKeyRawAsync(WechatPayV2Request request) {
        return await this.client.RequestAsync("/sandboxnew/pay/getsignkey", request, false);
    }

    /// <summary>POST /pay/unifiedorder; C# 参数：string 数据, int timeOut = Config.TIME_OUT</summary>
    async WechatPayLegacyTenPayV3ApiUnifiedorderResponse UnifiedorderAsync(WechatPayLegacyTenPayV3ApiUnifiedorderRequest request) {
        WechatRawResponse raw = await this.client.RequestAsync("/pay/unifiedorder", request.Inner(), false);
        WechatPayLegacyTenPayV3ApiUnifiedorderResponse result = new WechatPayLegacyTenPayV3ApiUnifiedorderResponse();
        result.Raw = raw.Body;
        WechatPayV2Request xml = WechatPayV2Request.ParseXml(raw.Body);
        return result;
    }

    async WechatRawResponse UnifiedorderRawAsync(WechatPayV2Request request) {
        return await this.client.RequestAsync("/pay/unifiedorder", request, false);
    }

    /// <summary>POST /pay/unifiedorder; C# 参数：TenPayV3UnifiedorderRequestData dataInfo, int timeOut = Config.TIME_OUT</summary>
    async WechatPayLegacyTenPayV3ApiHtml5OrderResponse Html5OrderAsync(WechatPayLegacyTenPayV3ApiHtml5OrderRequest request) {
        WechatRawResponse raw = await this.client.RequestAsync("/pay/unifiedorder", request.Inner(), false);
        WechatPayLegacyTenPayV3ApiHtml5OrderResponse result = new WechatPayLegacyTenPayV3ApiHtml5OrderResponse();
        result.Raw = raw.Body;
        WechatPayV2Request xml = WechatPayV2Request.ParseXml(raw.Body);
        result.device_info = xml.Get("device_info", "");
        result.trade_type = xml.Get("trade_type", "");
        result.prepay_id = xml.Get("prepay_id", "");
        result.code_url = xml.Get("code_url", "");
        result.mweb_url = xml.Get("mweb_url", "");
        result.appid = xml.Get("appid", "");
        result.mch_id = xml.Get("mch_id", "");
        result.sub_appid = xml.Get("sub_appid", "");
