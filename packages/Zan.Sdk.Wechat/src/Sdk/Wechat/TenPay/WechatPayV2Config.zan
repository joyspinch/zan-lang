using System;
using System.Collections.Generic;

namespace Sdk.Wechat.TenPay;

public class WechatPayV2Config {
    public string AppId;
    public string AppSecret;
    public string MerchantId;
    public string MerchantKey;
    public string NotifyUrl;
    public string WxOpenNotifyUrl;
    public string SignType;
    public string ClientCertificateFile;
    public string ClientPrivateKeyFile;
    public string SubAppId;
    public string SubAppSecret;
    public string SubMerchantId;

    public WechatPayV2Config(string appId, string merchantId, string merchantKey) {
        this.AppId = appId;
        this.AppSecret = "";
        this.MerchantId = merchantId;
        this.MerchantKey = merchantKey;
        this.NotifyUrl = "";
        this.WxOpenNotifyUrl = "";
        this.SignType = "MD5";
        this.ClientCertificateFile = "";
        this.ClientPrivateKeyFile = "";
        this.SubAppId = "";
        this.SubAppSecret = "";
        this.SubMerchantId = "";
    }

    public WechatPayV2Config SetAppSecret(string appSecret) {
        this.AppSecret = appSecret; return this;
    }
    public WechatPayV2Config SetNotifyUrl(string url) {
        this.NotifyUrl = url; return this;
    }
    public WechatPayV2Config SetNotifyUrls(string payUrl, string wxOpenUrl) {
        this.NotifyUrl = payUrl; this.WxOpenNotifyUrl = wxOpenUrl; return this;
    }
    public WechatPayV2Config UseHmacSha256() {
        this.SignType = "HMAC-SHA256"; return this;
    }
    public WechatPayV2Config SetClientCertificate(string certFile, string keyFile) {
        this.ClientCertificateFile = certFile;
        this.ClientPrivateKeyFile = keyFile;
        return this;
    }
    public WechatPayV2Config SetServiceProviderCredentials(string subAppId,
                                                            string subAppSecret,
                                                            string subMerchantId) {
        this.SubAppId = subAppId;
        this.SubAppSecret = subAppSecret;
        this.SubMerchantId = subMerchantId;
        return this;
    }
}
