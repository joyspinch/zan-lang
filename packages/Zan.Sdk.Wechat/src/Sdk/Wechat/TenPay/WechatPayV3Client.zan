using System;
using System.Json;
using System.Security.Cryptography;
using System.Net.External;
using System.Net.Tls;
using Sdk.Wechat;

namespace Sdk.Wechat.TenPay;

// 微信支付 API v3 的 WECHATPAY2 签名、验签、平台证书轮换、敏感字段和通知解密客户端。
public class WechatPayV3Client {
    WechatPayV3Config config;
    WechatApiTransport transport;
    RsaKey merchantKey;
    WechatPayPlatformKeyStore platformKeys;
    string defaultPlatformSerial;
    bool requireResponseSignature;

    public WechatPayV3Client(WechatPayV3Config config) {
        this.config = config;
        this.transport = new WechatApiTransport("api.mch.weixin.qq.com");
        this.merchantKey = RsaKey.FromPrivatePem(config.MerchantPrivateKeyPem);
        if (this.merchantKey == null || !this.merchantKey.HasPrivateKey()) {
            throw new ArgumentException("MerchantPrivateKeyPem 不是有效的 RSA 私钥");
        }
        this.platformKeys = new WechatPayPlatformKeyStore();
        this.defaultPlatformSerial = config.PlatformSerialNumber;
        this.requireResponseSignature = config.RequireResponseSignature;
        if (config.PlatformSerialNumber.Length > 0
            && config.PlatformPublicKeyPem.Length > 0) {
            this.platformKeys.Add(config.PlatformSerialNumber,
                                  config.PlatformPublicKeyPem);
        }
    }

    public WechatPayV3Client Server(string host, int port) {
        this.transport.Server(host, port); return this;
    }

    public WechatPayV3Client PlainHttpMode() {
        this.transport.PlainHttpMode(); return this;
    }

    public WechatPayV3Client Timeout(int ms) {
        this.transport.Timeout(ms); return this;
    }

    public WechatPayV3Client SetCallPolicy(ExternalCallPolicy policy) {
        this.transport.SetCallPolicy(policy); return this;
    }

    public ExternalCallPolicy CallPolicy() {
        return this.transport.CallPolicy();
    }

    public WechatPayV3Client PinPublicKey(string spkiSha256Base64) {
        this.transport.PinPublicKey(spkiSha256Base64);
        return this;
    }

    public WechatPayV3Client SetCertPolicy(CertPolicyFn fn) {
        this.transport.SetCertPolicy(fn);
        return this;
    }

    // 仅更新当前客户端实例的平台证书缓存，不反向修改传入的 config。
    public WechatPayV3Client SetPlatformPublicKey(string serial,
                                                  string publicKeyOrCertificatePem) {
        this.platformKeys.Add(serial, publicKeyOrCertificatePem);
        this.defaultPlatformSerial = serial;
        this.requireResponseSignature = true;
        return this;
    }

    public bool HasPlatformPublicKey(string serial) {
        return this.platformKeys.Contains(serial);
    }

    public string GetPlatformPublicKeyPem(string serial) {
        return this.platformKeys.Pem(serial);
    }

    public string BuildAuthorization(string method, string target, string body,
                                     long timestamp, string nonce) {
        string message = method + "\n" + target + "\n"
            + Convert.ToString(timestamp) + "\n" + nonce + "\n" + body + "\n";
        string signature = this.merchantKey.SignSha256(message);
        return "WECHATPAY2-SHA256-RSA2048 mchid=\"" + this.config.MerchantId
            + "\",nonce_str=\"" + nonce + "\",timestamp=\""
            + Convert.ToString(timestamp) + "\",serial_no=\""
            + this.config.MerchantSerialNumber + "\",signature=\""
            + signature + "\"";
    }

    public async WechatRawResponse RequestAsync(string method, string path,
                                                string query, string body,
                                                string contentType) {
        string target = WechatApiTransport.BuildPath(path, query);
        long timestamp = DateTime.UtcNow().ToUnixSeconds();
        byte[] nonceBytes = RandomNumberGenerator.GetBytes(16);
        string nonce = Hex.Encode(nonceBytes, 16);
        string authorization = this.BuildAuthorization(method, target, body,
                                                        timestamp, nonce);
        List<string> headers = new List<string>{
            "Authorization: " + authorization,
            "Accept: application/json",
            "User-Agent: zan-wechat-sdk/1.0" };
        WechatRawResponse response = await this.transport.RequestRawAsync(
            method, target, body, contentType, headers);
        if (!this.VerifyResponse(response)) {
            throw new WechatException("tenpay.signatureInvalid",
                "微信支付响应签名验证失败", response.Body);
        }
        if (!response.IsSuccess()) {
            WechatPayV3Client.ThrowHttpError(response);
        }
        return response;
    }

    public async WechatRawResponse RequestJsonAsync(string method, string path,
                                                    string query, string jsonBody) {
        return await this.RequestAsync(method, path, query, jsonBody,
                                       "application/json");
    }

    public async WechatRawResponse RequestMultipartAsync(string method, string path,
                                                         string query,
                                                         WechatMultipart multipart) {
        string body = multipart.Body();
        return await this.RequestAsync(method, path, query, body,
                                       multipart.ContentType());
    }

    // 下载微信返回的短期签名 URL；此请求不附加商户 Authorization。
    public async WechatRawResponse DownloadAsync(string url) {
        ExternalTarget target = ExternalTarget.Parse(url);
        bool allowPlain = this.transport.IsPlainHttp();
        if (target == null || !ExternalTargetPolicy.IsAllowedTarget(
                target, allowPlain, allowPlain)) {
            throw new ArgumentException("微信支付下载地址不是允许的外部 HTTPS 目标");
        }
        string path = target.Path() + target.Query();
        WechatApiTransport downloader = new WechatApiTransport(target.Host());
        downloader.Server(target.Host(), target.Port());
        if (allowPlain && !target.IsTls()) { downloader.PlainHttpMode(); }
        downloader.Timeout(this.transport.TimeoutMs());
        downloader.SetCallPolicy(this.transport.CallPolicy());
        WechatRawResponse raw = await downloader.RequestRawAsync("GET", path, "", "", null);
        if (!raw.IsSuccess()) {
            WechatPayV3Client.ThrowHttpError(raw);
        }
        return raw;
    }

    private static void ThrowHttpError(WechatRawResponse response) {
        string code = "";
        string message = "";
        try {
            JsonValue err = JsonValue.Parse(response.Body);
            if (err != null && err.IsObject()) {
                code = err.Str("code", "");
                message = err.Str("message", "");
            }
        } catch (Exception e) {
            code = "";
        }
        if (code.Length == 0) {
            code = "http." + Convert.ToString(response.StatusCode);
        }
        if (message.Length == 0) {
            message = "微信支付 V3 HTTP 请求失败: " + Convert.ToString(response.StatusCode);
        }
        throw new WechatException(code, message, response.Body);
    }

    public bool VerifyResponse(WechatRawResponse response) {
        string timestamp = response.Header("Wechatpay-Timestamp");
        string nonce = response.Header("Wechatpay-Nonce");
        string signature = response.Header("Wechatpay-Signature");
        string serial = response.Header("Wechatpay-Serial");
        if (timestamp.Length == 0 || nonce.Length == 0 || signature.Length == 0) {
            return !this.requireResponseSignature;
        }
        if (!WechatPayV3Client.TimestampFresh(timestamp)) { return false; }
        RsaKey key = this.PlatformKey(serial);
        if (key == null) { return !this.requireResponseSignature; }
        string message = timestamp + "\n" + nonce + "\n" + response.Body + "\n";
        return key.VerifySha256(message, signature);
    }

    // 通知/响应时间戳必须新鲜：|now - ts| ≤ 300 秒（官方建议窗口），
    // 截获的历史"支付成功"通知不能无限期重放。非纯十进制一律拒绝。
    public static bool TimestampFresh(string timestamp) {
        if (timestamp.Length == 0 || timestamp.Length > 12) { return false; }
        long ts = 0;
        for (int i = 0; i < timestamp.Length; i = i + 1) {
            int c = timestamp[i] & 255;
            if (c < 48 || c > 57) { return false; }
            ts = ts * 10 + (c - 48);
        }
        long now = DateTime.UtcNow().ToUnixSeconds();
        long diff = now - ts;
        if (diff < 0) { diff = 0 - diff; }
        return diff <= 300;
    }

    public bool VerifyNotification(string timestamp, string nonce, string body,
                                   string signature, string serial) {
        if (!WechatPayV3Client.TimestampFresh(timestamp)) { return false; }
        RsaKey key = this.PlatformKey(serial);
        if (key == null) { return false; }
        string message = timestamp + "\n" + nonce + "\n" + body + "\n";
        return key.VerifySha256(message, signature);
    }

    public static bool VerifyNotificationWithPublicKey(string timestamp, string nonce,
                                                string body, string signature,
                                                string serial,
                                                string expectedSerial,
                                                string publicKeyPem) {
        if (!WechatPayV3Client.TimestampFresh(timestamp)) { return false; }
        if (expectedSerial.Length > 0 && serial != expectedSerial) { return false; }
        RsaKey key = RsaKey.FromPublicPem(publicKeyPem);
        if (key == null) { return false; }
        string message = timestamp + "\n" + nonce + "\n" + body + "\n";
        return key.VerifySha256(message, signature);
    }

    // 验签并解密微信支付 V3 异步通知；任何校验失败均抛出 WechatException。
    public string VerifyAndDecryptNotification(string timestamp, string nonce, string body,
                                               string signature, string serial) {
        if (!this.VerifyNotification(timestamp, nonce, body, signature, serial)) {
            throw new WechatException("tenpay.signatureInvalid",
                "微信支付通知签名或时间戳校验失败", body);
        }
        WechatPayNotification notice = WechatPayNotification.Parse(body);
        return notice.DecryptResource(this);
    }

    public RsaKey PlatformKey(string serial) {
        if (serial.Length > 0) { return this.platformKeys.Get(serial); }
        if (this.defaultPlatformSerial.Length > 0) {
            RsaKey configured = this.platformKeys.Get(this.defaultPlatformSerial);
            if (configured != null) { return configured; }
        }
        return this.platformKeys.First();
    }

    public string DecryptResource(string ciphertextBase64, string nonce,
                                  string associatedData) {
        return WechatPayV3Client.DecryptResourceWithKey(this.config.ApiV3Key,
            ciphertextBase64, nonce, associatedData);
    }

    public static string DecryptResourceWithKey(string apiKey, string ciphertextBase64,
                                         string nonce, string associatedData) {
        if (apiKey.Length != 32) {
            throw new ArgumentException("API 密钥必须是 32 字节");
        }
        List<int> totalLen = new List<int>(); totalLen.Add(0);
        byte[] encrypted = Base64.Decode(ciphertextBase64, totalLen);
        if (encrypted == null || totalLen[0] < 16 || nonce.Length != 12) {
            throw new ArgumentException("微信支付 AES-GCM 密文或 nonce 无效");
        }
        int cipherLen = totalLen[0] - 16;
        string tag = encrypted.ToStr(cipherLen, 16);
        List<int> ok = new List<int>(); ok.Add(0);
        byte[] plain = AesGcm.Decrypt(apiKey, 32, nonce,
            associatedData, associatedData.Length, encrypted, cipherLen, tag, ok);
        if (plain == null || ok[0] == 0) {
            throw new WechatException("tenpay.decryptFailed",
                                      "微信支付 AES-GCM 标签验证失败", "");
        }
        return plain.ToStr(0, cipherLen);
    }

    public string EncryptSensitive(string plaintext) {
        return this.EncryptSensitiveWithSerial(plaintext, this.defaultPlatformSerial);
    }

    public string EncryptSensitiveWithSerial(string plaintext, string serial) {
        RsaKey key = this.PlatformKey(serial);
        if (key == null) {
            throw new InvalidOperationException("请先配置微信支付平台公钥");
        }
        return key.EncryptOaepSha1(plaintext);
    }

    public string SignAppMessage(string appId, string packageValue,
                                 long timestamp, string nonce) {
        string message = appId + "\n" + Convert.ToString(timestamp) + "\n"
            + nonce + "\n" + packageValue + "\n";
        return this.merchantKey.SignSha256(message);
    }

    // 生成小程序/JSAPI 调起微信支付（wx.requestPayment / WeixinJSBridge）所需 JSON 参数。
    public string BuildJsapiPayParams(string appId, string prepayId) {
        string useAppId = appId.Length > 0 ? appId : this.config.AppId;
        long ts = DateTime.UtcNow().ToUnixSeconds();
        string nonce = Hex.Encode(RandomNumberGenerator.GetBytes(16), 16);
        string pkg = "prepay_id=" + prepayId;
        string paySign = this.SignAppMessage(useAppId, pkg, ts, nonce);
        JsonValue obj = JsonValue.NewObject();
        obj.Put("appId", JsonValue.NewStr(useAppId));
        obj.Put("timeStamp", JsonValue.NewStr(Convert.ToString(ts)));
        obj.Put("nonceStr", JsonValue.NewStr(nonce));
        obj.Put("package", JsonValue.NewStr(pkg));
        obj.Put("signType", JsonValue.NewStr("RSA"));
        obj.Put("paySign", JsonValue.NewStr(paySign));
        return obj.ToJson();
    }

    // 生成原生 App 调起微信支付所需 JSON 参数。
    public string BuildAppPayParams(string appId, string partnerId, string prepayId) {
        string useAppId = appId.Length > 0 ? appId : this.config.AppId;
        string usePartner = partnerId.Length > 0 ? partnerId : this.config.MerchantId;
        long ts = DateTime.UtcNow().ToUnixSeconds();
        string nonce = Hex.Encode(RandomNumberGenerator.GetBytes(16), 16);
        string sign = this.SignAppMessage(useAppId, prepayId, ts, nonce);
        JsonValue obj = JsonValue.NewObject();
        obj.Put("appid", JsonValue.NewStr(useAppId));
        obj.Put("partnerid", JsonValue.NewStr(usePartner));
        obj.Put("prepayid", JsonValue.NewStr(prepayId));
        obj.Put("package", JsonValue.NewStr("Sign=WXPay"));
        obj.Put("noncestr", JsonValue.NewStr(nonce));
        obj.Put("timestamp", JsonValue.NewStr(Convert.ToString(ts)));
        obj.Put("sign", JsonValue.NewStr(sign));
        return obj.ToJson();
    }

    // 下载微信支付平台证书；algorithmType 为 RSA、SM2 或 ALL。
    public async WechatRawResponse DownloadCertificatesAsync(string algorithmType) {
        string query = "";
        if (algorithmType.Length > 0) {
            query = "algorithm_type=" + algorithmType;
        }
        return await this.RequestJsonAsync("GET", "/v3/certificates", query, "");
    }

    // 下载并解密 RSA 平台证书，加入按序列号缓存。
    public async int RefreshPlatformCertificatesAsync(string algorithmType) {
        WechatRawResponse response = await this.DownloadCertificatesAsync(algorithmType);
        return this.LoadCertificatesResponse(response.Body);
    }

    // 装载 /v3/certificates 的 JSON 响应并返回新增/更新数量。
    public int LoadCertificatesResponse(string json) {
        JsonValue root = JsonValue.Parse(json);
        if (root == null || !root.IsObject()) { return 0; }
        JsonValue data = root.Get("data");
        if (data == null || !data.IsArray()) { return 0; }
        int loaded = 0;
        for (int i = 0; i < data.Count(); i = i + 1) {
            JsonValue item = data.At(i);
            if (item != null && item.IsObject()) {
                string serial = item.Str("serial_no", "");
                JsonValue encrypted = item.Get("encrypt_certificate");
                if (serial.Length > 0 && encrypted != null
                    && encrypted.IsObject()) {
                    string algorithm = encrypted.Str("algorithm", "");
                    if (algorithm.Length == 0 || algorithm == "AEAD_AES_256_GCM") {
                        string pem = this.DecryptResource(
                            encrypted.Str("ciphertext", ""),
                            encrypted.Str("nonce", ""),
                            encrypted.Str("associated_data", ""));
                        this.SetPlatformPublicKey(serial, pem);
                        loaded = loaded + 1;
                    }
                }
            }
        }
        return loaded;
    }

    // 装载直接返回 public_key/public_key_id 的平台公钥 JSON。
    public int LoadPublicKeysResponse(string json) {
        JsonValue root = JsonValue.Parse(json);
        if (root == null || !root.IsObject()) { return 0; }
        JsonValue data = root.Get("data");
        if (data == null) { return 0; }
        int loaded = 0;
        if (data.IsArray()) {
            for (int i = 0; i < data.Count(); i = i + 1) {
                loaded = loaded + this.LoadPublicKeyItem(data.At(i));
            }
        } else {
            loaded = this.LoadPublicKeyItem(data);
        }
        return loaded;
    }

    private int LoadPublicKeyItem(JsonValue item) {
        if (item == null || !item.IsObject()) { return 0; }
        string serial = item.Str("public_key_id", item.Str("serial_no", ""));
        string pem = item.Str("public_key", item.Str("pem", ""));
        if (serial.Length == 0 || pem.Length == 0) { return 0; }
        this.SetPlatformPublicKey(serial, pem);
        return 1;
    }
}
