using System;
using System.Json;
using System.Text;
using Sdk.Wechat;
using Sdk.Wechat.Models.TenPay;

namespace Sdk.Wechat.TenPay;

public class WechatPayLegacyTenpayV3PayBankApi {
    WechatPayV2Client client;

    public WechatPayLegacyTenpayV3PayBankApi(WechatPayV2Client client) { this.client = client; }

    // POST /mmpaysptrans/pay_bank; C# 参数：IServiceProvider serviceProvider, TenPayV3PayBankRequestData dataInfo, #if NET462 string cert, string certPassword, #endif int timeOut = Config.TIME_OUT
    public async WechatPayLegacyTenpayV3PayBankApiPayBankResponse PayBankAsync(WechatPayLegacyTenpayV3PayBankApiPayBankRequest request) {
        WechatRawResponse raw = await this.client.RequestAsync("/mmpaysptrans/pay_bank", request.Inner(), true);
        WechatPayLegacyTenpayV3PayBankApiPayBankResponse result = new WechatPayLegacyTenpayV3PayBankApiPayBankResponse();
        result.Raw = raw.Body;
        WechatPayV2Request xml = WechatPayV2Request.ParseXml(raw.Body);
        result.result_code = xml.Get("result_code", "");
        result.err_code = xml.Get("err_code", "");
        result.err_code_des = xml.Get("err_code_des", "");
        result.mch_id = xml.Get("mch_id", "");
        result.partner_trade_no = xml.Get("partner_trade_no", "");
        result.amount = xml.Get("amount", "");
        result.nonce_str = xml.Get("nonce_str", "");
        result.sign = xml.Get("sign", "");
        result.payment_no = xml.Get("payment_no", "");
        result.cmms_amt = xml.Get("cmms_amt", "");
        result.return_code = xml.Get("return_code", "");
        result.return_msg = xml.Get("return_msg", "");
        return result;
    }

    public async WechatRawResponse PayBankRawAsync(WechatPayV2Request request) {
        return await this.client.RequestAsync("/mmpaysptrans/pay_bank", request, true);
    }

    // POST /mmpaysptrans/query_bank; C# 参数：IServiceProvider serviceProvider, TenPayV3QueryBankRequestData dataInfo, #if NET462 string cert, string certPassword, #endif int timeOut = Config.TIME_OUT
    public async WechatPayLegacyTenpayV3PayBankApiQueryBankResponse QueryBankAsync(WechatPayLegacyTenpayV3PayBankApiQueryBankRequest request) {
        WechatRawResponse raw = await this.client.RequestAsync("/mmpaysptrans/query_bank", request.Inner(), true);
        WechatPayLegacyTenpayV3PayBankApiQueryBankResponse result = new WechatPayLegacyTenpayV3PayBankApiQueryBankResponse();
        result.Raw = raw.Body;
        WechatPayV2Request xml = WechatPayV2Request.ParseXml(raw.Body);
        result.result_code = xml.Get("result_code", "");
        result.err_code = xml.Get("err_code", "");
        result.err_code_des = xml.Get("err_code_des", "");
        result.mch_id = xml.Get("mch_id", "");
        result.partner_trade_no = xml.Get("partner_trade_no", "");
        result.payment_no = xml.Get("payment_no", "");
        result.bank_no_md5 = xml.Get("bank_no_md5", "");
        result.true_name_md5 = xml.Get("true_name_md5", "");
        result.amount = xml.Get("amount", "");
        result.status = xml.Get("status", "");
        result.cmms_amt = xml.Get("cmms_amt", "");
        result.create_time = xml.Get("create_time", "");
        result.pay_succ_time = xml.Get("pay_succ_time", "");
        result.reason = xml.Get("reason", "");
        result.return_code = xml.Get("return_code", "");
        result.return_msg = xml.Get("return_msg", "");
        return result;
    }

    public async WechatRawResponse QueryBankRawAsync(WechatPayV2Request request) {
        return await this.client.RequestAsync("/mmpaysptrans/query_bank", request, true);
    }

    // POST /risk/getpublickey; C# 参数：IServiceProvider serviceProvider, TenPayV3QueryBankRequestData dataInfo, #if NET462 string cert, string certPassword, #endif int timeOut = Config.TIME_OUT
    public async WechatPayLegacyTenpayV3PayBankApiGetPublicKeyResponse GetPublicKeyAsync(WechatPayLegacyTenpayV3PayBankApiGetPublicKeyRequest request) {
        WechatRawResponse raw = await this.client.RequestAsync("/risk/getpublickey", request.Inner(), true);
        WechatPayLegacyTenpayV3PayBankApiGetPublicKeyResponse result = new WechatPayLegacyTenpayV3PayBankApiGetPublicKeyResponse();
        result.Raw = raw.Body;
        WechatPayV2Request xml = WechatPayV2Request.ParseXml(raw.Body);
        result.result_code = xml.Get("result_code", "");
        result.err_code = xml.Get("err_code", "");
        result.err_code_des = xml.Get("err_code_des", "");
        result.mch_id = xml.Get("mch_id", "");
        result.pub_key = xml.Get("pub_key", "");
        result.return_code = xml.Get("return_code", "");
        result.return_msg = xml.Get("return_msg", "");
        return result;
    }

    public async WechatRawResponse GetPublicKeyRawAsync(WechatPayV2Request request) {
        return await this.client.RequestAsync("/risk/getpublickey", request, true);
    }

}
