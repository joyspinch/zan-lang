using System;
using System.Collections.Generic;

namespace Sdk.Wechat.TenPay;

public class WechatPayNotification {
    public string Id;
    public string CreateTime;
    public string EventType;
    public string ResourceType;
    public string Summary;
    public string Algorithm;
    public string Ciphertext;
    public string Nonce;
    public string AssociatedData;
    public string RawBody;

    public WechatPayNotification() {
        this.Id = "";
        this.CreateTime = "";
        this.EventType = "";
        this.ResourceType = "";
        this.Summary = "";
        this.Algorithm = "";
        this.Ciphertext = "";
        this.Nonce = "";
        this.AssociatedData = "";
        this.RawBody = "";
    }

    public static WechatPayNotification Parse(string body) {
        JsonValue root = JsonValue.Parse(body);
        if (root == null || !root.IsObject()) {
            throw new ArgumentException("微信支付通知不是 JSON 对象");
        }
        WechatPayNotification n = new WechatPayNotification();
        n.RawBody = body;
        n.Id = root.Str("id", "");
        n.CreateTime = root.Str("create_time", "");
        n.EventType = root.Str("event_type", "");
        n.ResourceType = root.Str("resource_type", "");
        n.Summary = root.Str("summary", "");
        JsonValue resource = root.Get("resource");
        if (resource != null && resource.IsObject()) {
            n.Algorithm = resource.Str("algorithm", "");
            n.Ciphertext = resource.Str("ciphertext", "");
            n.Nonce = resource.Str("nonce", "");
            n.AssociatedData = resource.Str("associated_data", "");
        }
        return n;
    }

    public bool Verify(WechatPayV3Client client, string timestamp, string nonce,
                       string signature, string serial) {
        return client.VerifyNotification(timestamp, nonce, this.RawBody,
                                         signature, serial);
    }

    public bool VerifyWithPublicKey(string timestamp, string nonce,
                                    string signature, string serial,
                                    string expectedSerial, string publicKeyPem) {
        return WechatPayV3Client.VerifyNotificationWithPublicKey(timestamp,
            nonce, this.RawBody, signature, serial, expectedSerial,
            publicKeyPem);
    }

    public string DecryptResourceWithKey(string apiKey) {
        return WechatPayV3Client.DecryptResourceWithKey(apiKey,
            this.Ciphertext, this.Nonce, this.AssociatedData);
    }

    public string DecryptResource(WechatPayV3Client client) {
        if (this.Algorithm.Length > 0
            && this.Algorithm != "AEAD_AES_256_GCM") {
            throw new InvalidOperationException("当前仅支持 AEAD_AES_256_GCM 通知资源");
        }
        return client.DecryptResource(this.Ciphertext, this.Nonce,
                                      this.AssociatedData);
    }

    public string VerifyAndDecrypt(WechatPayV3Client client, string timestamp,
                                   string nonce, string signature, string serial) {
        if (!this.Verify(client, timestamp, nonce, signature, serial)) {
            throw new WechatException("tenpay.signatureInvalid",
                "微信支付通知签名或时间戳校验失败", this.RawBody);
        }
        return this.DecryptResource(client);
    }
}
