using System;
using System.Collections.Generic;

namespace Sdk.Wechat.TenPay;

public class WechatPayPlatformKeyStore {
    List<WechatPayPlatformKeyEntry> entries;

    public WechatPayPlatformKeyStore() {
        this.entries = new List<WechatPayPlatformKeyEntry>();
    }

    int Count() { return this.entries.Count; }

    public WechatPayPlatformKeyStore Add(string serial, string publicKeyOrCertificatePem) {
        RsaKey key = RsaKey.FromPublicPem(publicKeyOrCertificatePem);
        if (key == null) {
            throw new ArgumentException("微信支付平台公钥或证书 PEM 无效");
        }
        int i = this.IndexOf(serial);
        if (i >= 0) {
            this.entries[i].pem = publicKeyOrCertificatePem;
            this.entries[i].key = key;
        } else {
            this.entries.Add(new WechatPayPlatformKeyEntry(serial, publicKeyOrCertificatePem, key));
        }
        return this;
    }

    bool Contains(string serial) { return this.IndexOf(serial) >= 0; }

    public RsaKey Get(string serial) {
        int i = this.IndexOf(serial);
        if (i < 0) { return null; }
        return this.entries[i].key;
    }

    public string Pem(string serial) {
        int i = this.IndexOf(serial);
        if (i < 0) { return ""; }
        return this.entries[i].pem;
    }

    public string SerialAt(int index) {
        if (index >= 0 && index < this.entries.Count) {
            return this.entries[index].serial;
        }
        return "";
    }

    public RsaKey First() {
        if (this.entries.Count == 0) { return null; }
        return this.entries[0].key;
    }

    public int IndexOf(string serial) {
        for (int i = 0; i < this.entries.Count; i = i + 1) {
            if (this.entries[i].serial == serial) { return i; }
        }
        return -1;
    }
}

// 微信支付 API v3 通知。原始报文、通知 ID、验签与 AES-GCM 资源解密均保留，
// 业务方可将 DecryptResource() 的 JSON 再映射为自己的数据类型。
