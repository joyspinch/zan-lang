using System;
using System.Collections.Generic;

namespace Sdk.Wechat.TenPay;

public class WechatPayV2Request {
    List<WechatPayV2Field> fields;

    public WechatPayV2Request() {
        this.fields = new List<WechatPayV2Field>();
    }

    private static bool IsValidXmlTagName(string name) {
        if (name == null || name.Length == 0) { return false; }
        int c0 = name[0] & 255;
        bool startOk = (c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122) || c0 == 95;
        if (!startOk) { return false; }
        for (int i = 1; i < name.Length; i = i + 1) {
            int c = name[i] & 255;
            bool ok = (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
                || (c >= 48 && c <= 57) || c == 95 || c == 45 || c == 46 || c == 58;
            if (!ok) { return false; }
        }
        return true;
    }

    public WechatPayV2Request Set(string name, string fieldValue) {
        if (!WechatPayV2Request.IsValidXmlTagName(name)) {
            throw new ArgumentException("微信支付 V2 XML 字段名非法: " + (name == null ? "" : name));
        }
        string val = fieldValue == null ? "" : fieldValue;
        int i = this.Index(name);
        if (i >= 0) { this.fields[i].value = val; }
        else { this.fields.Add(new WechatPayV2Field(name, val)); }
        return this;
    }

    bool Has(string name) { return this.Index(name) >= 0; }

    public string Get(string name, string dflt) {
        int i = this.Index(name);
        if (i < 0) { return dflt; }
        return this.fields[i].value;
    }

    int Count() { return this.fields.Count; }

    private void SiftDownOrder(int[] order, int root, int end) {
        while (true) {
            int child = root * 2 + 1;
            if (child >= end) { break; }
            int swap = root;
            if (String.CompareOrdinal(this.fields[order[swap]].name, this.fields[order[child]].name) < 0) {
                swap = child;
            }
            if (child + 1 < end
                && String.CompareOrdinal(this.fields[order[swap]].name, this.fields[order[child + 1]].name) < 0) {
                swap = child + 1;
            }
            if (swap == root) { break; }
            int tmp = order[root];
            order[root] = order[swap];
            order[swap] = tmp;
            root = swap;
        }
    }

    public string Canonical(string merchantKey) {
        int n = this.fields.Count;
        int[] order = new int[n];
        int cnt = 0;
        int bodyLen = 0;
        for (int i = 0; i < n; i = i + 1) {
            WechatPayV2Field field = this.fields[i];
            if (field.value.Length > 0 && field.name != "sign") {
                order[cnt] = i;
                cnt = cnt + 1;
                bodyLen = bodyLen + field.name.Length + 1 + field.value.Length;
            }
        }
        if (cnt > 1) {
            if (cnt <= 32) {
                for (int i = 1; i < cnt; i = i + 1) {
                    int idx = order[i];
                    string key = this.fields[idx].name;
                    int j = i - 1;
                    while (j >= 0 && String.CompareOrdinal(this.fields[order[j]].name, key) > 0) {
                        order[j + 1] = order[j];
                        j = j - 1;
                    }
                    order[j + 1] = idx;
                }
            } else {
                for (int start = (cnt - 2) / 2; start >= 0; start = start - 1) {
                    this.SiftDownOrder(order, start, cnt);
                }
                for (int end = cnt - 1; end > 0; end = end - 1) {
                    int tmp = order[end];
                    order[end] = order[0];
                    order[0] = tmp;
                    this.SiftDownOrder(order, 0, end);
                }
            }
        }
        int mkLen = merchantKey == null ? 0 : merchantKey.Length;
        int totalLen = (cnt > 0 ? bodyLen + cnt : 0) + 4 + mkLen;
        byte[] buf = new byte[totalLen];
        nint bp = (nint)buf;
        int di = 0;
        for (int i = 0; i < cnt; i = i + 1) {
            if (i > 0) { buf[di] = 38; di = di + 1; }
            WechatPayV2Field field = this.fields[order[i]];
            int klen = field.name.Length;
            int vlen = field.value.Length;
            if (klen > 0) {
                NativeMemory.Copy(bp + (nint)di, (nint)field.name, klen);
                di = di + klen;
            }
            buf[di] = 61; di = di + 1;
            if (vlen > 0) {
                NativeMemory.Copy(bp + (nint)di, (nint)field.value, vlen);
                di = di + vlen;
            }
        }
        if (cnt > 0) { buf[di] = 38; di = di + 1; }
        buf[di] = 107; buf[di + 1] = 101; buf[di + 2] = 121; buf[di + 3] = 61;
        di = di + 4;
        if (mkLen > 0) {
            NativeMemory.Copy(bp + (nint)di, (nint)merchantKey, mkLen);
        }
        return NativeMemory.GetString(bp, 0, totalLen);
    }

    public string Sign(string merchantKey, string signType) {
        string st = (signType == null || signType.Length == 0) ? "MD5" : signType;
        string source = this.Canonical(merchantKey);
        byte[] digest;
        if (st == "HMAC-SHA256") {
            digest = Hmac.Sha256Mac(merchantKey, merchantKey.Length,
                                    source, source.Length);
            return Hex.Encode(digest, 32).ToUpperAscii();
        }
        if (st != "MD5") {
            throw new ArgumentException("不支持的微信支付 V2 签名类型: " + st);
        }
        digest = Md5.Hash(source, source.Length);
        return Hex.Encode(digest, 16).ToUpperAscii();
    }

    public bool Verify(string merchantKey) {
        return this.VerifyWithDefaultSignType(merchantKey, "MD5");
    }

    public bool VerifyWithDefaultSignType(string merchantKey, string defaultSignType) {
        // 空 merchantKey 拒绝：否则攻击者可用空密钥自签伪造回调
        string actual = this.Get("sign", "");
        if (merchantKey == null || merchantKey.Length == 0 || actual.Length == 0) { return false; }
        string defType = (defaultSignType == null || defaultSignType.Length == 0) ? "MD5" : defaultSignType;
        string signType = this.Get("sign_type", "");
        if (signType.Length == 0) {
            signType = defType;
        } else if (defType == "HMAC-SHA256" && signType != "HMAC-SHA256") {
            // 配置强签名算法时禁止报文通过 sign_type=MD5 降级验签
            return false;
        }
        if (signType != "MD5" && signType != "HMAC-SHA256") { return false; }
        string expected = this.Sign(merchantKey, signType);
        // 常数时间比较，防逐字节探测签名
        return Jwt.fixedEquals(actual, actual.Length, expected, expected.Length);
    }

    public string ToSignedXml(WechatPayV2Config config) {
        if (!this.Has("appid") && config.AppId.Length > 0) {
            this.Set("appid", config.AppId);
        }
        if (!this.Has("mch_id") && config.MerchantId.Length > 0) {
            this.Set("mch_id", config.MerchantId);
        }
        if (!this.Has("nonce_str")) {
            this.Set("nonce_str", WechatPayV3Client.RandomNonceHex());
        }
        if (!this.Has("notify_url") && config.NotifyUrl.Length > 0) {
            this.Set("notify_url", config.NotifyUrl);
        }
        if (config.SignType == "HMAC-SHA256" && !this.Has("sign_type")) {
            this.Set("sign_type", config.SignType);
        }
        this.Set("sign", this.Sign(config.MerchantKey, config.SignType));
        return this.ToXml();
    }

    private void SetValidated(string name, string fieldValue) {
        int i = this.Index(name);
        if (i >= 0) { this.fields[i].value = fieldValue; }
        else { this.fields.Add(new WechatPayV2Field(name, fieldValue)); }
    }

    public string ToXml() {
        int n = this.fields.Count;
        int totalLen = 11; // "<xml></xml>"
        int cdataHits = 0;
        int firstCdataField = -1;
        for (int i = 0; i < n; i = i + 1) {
            WechatPayV2Field f = this.fields[i];
            string v = f.value == null ? "" : f.value;
            int vlen = v.Length;
            totalLen = totalLen + f.name.Length * 2 + vlen + 17;
            if (vlen >= 3) {
                int hit = XmlUtil.FindCdataEnd(v, 0, vlen);
                if (hit >= 0) {
                    if (firstCdataField < 0) { firstCdataField = i; }
                    while (hit >= 0) {
                        cdataHits = cdataHits + 1;
                        hit = XmlUtil.FindCdataEnd(v, hit + 3, vlen);
                    }
                }
            }
        }
        totalLen = totalLen + cdataHits * 12;
        byte[] buf = new byte[totalLen];
        nint bp = (nint)buf;
        NativeMemory.Copy(bp, (nint)"<xml>", 5);
        int di = 5;
        for (int i = 0; i < n; i = i + 1) {
            WechatPayV2Field f = this.fields[i];
            string fname = f.name;
            string v = f.value == null ? "" : f.value;
            int klen = fname.Length;
            int vlen = v.Length;
            nint kp = (nint)fname;
            buf[di] = 60; di = di + 1;
            if (klen > 0) { NativeMemory.Copy(bp + (nint)di, kp, klen); di = di + klen; }
            NativeMemory.Copy(bp + (nint)di, (nint)"><![CDATA[", 10); di = di + 10;
            if (vlen > 0) {
                if (firstCdataField < 0 || i < firstCdataField || vlen < 3) {
                    NativeMemory.Copy(bp + (nint)di, (nint)v, vlen);
                    di = di + vlen;
                } else {
                    nint vp = (nint)v;
                    int from = 0;
                    int hit = XmlUtil.FindCdataEnd(v, 0, vlen);
                    while (hit >= 0) {
                        int seg = hit + 2 - from;
                        if (seg > 0) { NativeMemory.Copy(bp + (nint)di, vp + (nint)from, seg); di = di + seg; }
                        NativeMemory.Copy(bp + (nint)di, (nint)"]]><![CDATA[>", 13);
                        di = di + 13;
                        from = hit + 3;
                        hit = XmlUtil.FindCdataEnd(v, from, vlen);
                    }
                    int tail = vlen - from;
                    if (tail > 0) { NativeMemory.Copy(bp + (nint)di, vp + (nint)from, tail); di = di + tail; }
                }
            }
            NativeMemory.Copy(bp + (nint)di, (nint)"]]></", 5); di = di + 5;
            if (klen > 0) { NativeMemory.Copy(bp + (nint)di, kp, klen); di = di + klen; }
            buf[di] = 62; di = di + 1;
        }
        NativeMemory.Copy(bp + (nint)di, (nint)"</xml>", 6);
        return NativeMemory.GetString(bp, 0, totalLen);
    }

    public static WechatPayV2Request ParseXml(string xml) {
        WechatPayV2Request result = new WechatPayV2Request();
        if (xml == null || xml.Length == 0) { return result; }
        int xlen = xml.Length;
        nint xp = (nint)xml;
        int pos = xml.IndexOf("<xml", 0);
        if (pos < 0) { return result; }
        int rootGt = NativeMemory.Find(xp, pos + 4, 62, xlen - (pos + 4));
        if (rootGt < 0) { return result; }
        pos = rootGt + 1;
        int xmlEnd = xml.IndexOf("</xml>", pos);
        if (xmlEnd < 0) { xmlEnd = xlen; }
        while (pos < xmlEnd) {
            int open = NativeMemory.Find(xp, pos, 60, xmlEnd - pos);
            if (open < 0 || open + 1 >= xmlEnd) { break; }
            int nextC = xml[open + 1] & 255;
            if (nextC == 47) { break; } // '</'
            if (nextC == 33) { // '<!' comment or declaration
                if (open + 3 < xmlEnd && (xml[open + 2] & 255) == 45 && (xml[open + 3] & 255) == 45) {
                    int cEnd = xml.IndexOf("-->", open + 4);
                    if (cEnd < 0 || cEnd >= xmlEnd) { break; }
                    pos = cEnd + 3;
                    continue;
                }
                int dEnd = NativeMemory.Find(xp, open + 2, 62, xmlEnd - (open + 2));
                if (dEnd < 0 || dEnd >= xmlEnd) { break; }
                pos = dEnd + 1;
                continue;
            }
            if (nextC == 63) { // '<?' processing instruction
                int pEnd = xml.IndexOf("?>", open + 2);
                if (pEnd < 0 || pEnd >= xmlEnd) { break; }
                pos = pEnd + 2;
                continue;
            }
            int gt = NativeMemory.Find(xp, open + 1, 62, xmlEnd - (open + 1));
            if (gt < 0 || gt > xmlEnd) { break; }
            bool selfClosing = gt > open + 1 && (xml[gt - 1] & 255) == 47;
            int nameLimit = selfClosing ? gt - 1 : gt;
            int nameStart = open + 1;
            int nameEnd = nameLimit;
            bool nameValid = nameStart < nameLimit;
            if (nameValid) {
                int c0 = xml[nameStart] & 255;
                if (c0 == 32 || c0 == 9 || c0 == 13 || c0 == 10) {
                    nameEnd = nameStart;
                    nameValid = false;
                } else {
                    nameValid = (c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122) || c0 == 95;
                    int scan = nameStart + 1;
                    while (scan < nameLimit) {
                        int c = xml[scan] & 255;
                        if (c == 32 || c == 9 || c == 13 || c == 10) {
                            nameEnd = scan; break;
                        }
                        if (nameValid && !((c >= 65 && c <= 90) || (c >= 97 && c <= 122)
                            || (c >= 48 && c <= 57) || c == 95 || c == 45 || c == 46 || c == 58)) {
                            nameValid = false;
                        }
                        scan = scan + 1;
                    }
                }
            }
            int nameLen = nameEnd - nameStart;
            if (selfClosing) {
                if (nameLen > 0) {
                    string name = xml.Substring(nameStart, nameLen);
                    if (!nameValid) {
                        throw new ArgumentException("微信支付 V2 XML 字段名非法: " + name);
                    }
                    result.SetValidated(name, "");
                }
                pos = gt + 1;
                continue;
            }
            int end = XmlUtil.FindCloseTagSlice(xml, xp, gt + 1, xmlEnd, nameStart, nameLen);
            if (end < 0 || end > xmlEnd) {
                pos = gt + 1;
                continue;
            }
            string name = xml.Substring(nameStart, nameLen);
            if (!nameValid) {
                throw new ArgumentException("微信支付 V2 XML 字段名非法: " + name);
            }
            string fieldValue = XmlUtil.StripCdataSlice(xml, gt + 1, end);
            result.SetValidated(name, fieldValue);
            pos = end + nameLen + 3;
        }
        return result;
    }

    private int Index(string name) {
        for (int i = 0; i < this.fields.Count; i = i + 1) {
            if (this.fields[i].name == name) { return i; }
        }
        return -1;
    }
}
