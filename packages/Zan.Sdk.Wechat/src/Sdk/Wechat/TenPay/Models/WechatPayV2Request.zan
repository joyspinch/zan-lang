using System;
using System.Collections.Generic;

namespace Sdk.Wechat.TenPay;

public class WechatPayV2Request {
    List<WechatPayV2Field> fields;

    public WechatPayV2Request() {
        this.fields = new List<WechatPayV2Field>();
    }

    private static bool IsValidXmlTagName(string name) {
        if (name == null || name.Length == 0) { return false; }
        int c0 = name[0] & 255;
        bool startOk = (c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122) || c0 == 95;
        if (!startOk) { return false; }
        for (int i = 1; i < name.Length; i = i + 1) {
            int c = name[i] & 255;
            bool ok = (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
                || (c >= 48 && c <= 57) || c == 95 || c == 45 || c == 46 || c == 58;
            if (!ok) { return false; }
        }
        return true;
    }

    public WechatPayV2Request Set(string name, string fieldValue) {
        if (!WechatPayV2Request.IsValidXmlTagName(name)) {
            throw new ArgumentException("微信支付 V2 XML 字段名非法: " + (name == null ? "" : name));
        }
        string val = fieldValue == null ? "" : fieldValue;
        int i = this.Index(name);
        if (i >= 0) { this.fields[i].value = val; }
        else { this.fields.Add(new WechatPayV2Field(name, val)); }
        return this;
    }

    bool Has(string name) { return this.Index(name) >= 0; }

    public string Get(string name, string dflt) {
        int i = this.Index(name);
        if (i < 0) { return dflt; }
        return this.fields[i].value;
    }

    int Count() { return this.fields.Count; }

    public string Canonical(string merchantKey) {
        List<string> keys = new List<string>();
        for (int i = 0; i < this.fields.Count; i = i + 1) {
            WechatPayV2Field field = this.fields[i];
            if (field.name != "sign" && field.value.Length > 0) {
                keys.Add(field.name);
            }
        }
        keys.Sort();
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < keys.Count; i = i + 1) {
            if (i > 0) { sb.Append("&"); }
            sb.Append(keys[i]); sb.Append("="); sb.Append(this.Get(keys[i], ""));
        }
        if (sb.Length > 0) { sb.Append("&"); }
        sb.Append("key="); sb.Append(merchantKey);
        return sb.ToString();
    }

    public string Sign(string merchantKey, string signType) {
        string st = (signType == null || signType.Length == 0) ? "MD5" : signType;
        string source = this.Canonical(merchantKey);
        byte[] digest;
        if (st == "HMAC-SHA256") {
            digest = Hmac.Sha256Mac(merchantKey, merchantKey.Length,
                                    source, source.Length);
            return Hex.Encode(digest, 32).ToUpperAscii();
        }
        if (st != "MD5") {
            throw new ArgumentException("不支持的微信支付 V2 签名类型: " + st);
        }
        digest = Md5.Hash(source, source.Length);
        return Hex.Encode(digest, 16).ToUpperAscii();
    }

    public bool Verify(string merchantKey) {
        return this.VerifyWithDefaultSignType(merchantKey, "MD5");
    }

    public bool VerifyWithDefaultSignType(string merchantKey, string defaultSignType) {
        // 空 merchantKey 拒绝：否则攻击者可用空密钥自签伪造回调
        string actual = this.Get("sign", "");
        if (merchantKey == null || merchantKey.Length == 0 || actual.Length == 0) { return false; }
        string defType = (defaultSignType == null || defaultSignType.Length == 0) ? "MD5" : defaultSignType;
        string signType = this.Get("sign_type", "");
        if (signType.Length == 0) {
            signType = defType;
        } else if (defType == "HMAC-SHA256" && signType != "HMAC-SHA256") {
            // 配置强签名算法时禁止报文通过 sign_type=MD5 降级验签
            return false;
        }
        if (signType != "MD5" && signType != "HMAC-SHA256") { return false; }
        string expected = this.Sign(merchantKey, signType);
        // 常数时间比较，防逐字节探测签名
        return Jwt.fixedEquals(actual, actual.Length, expected, expected.Length);
    }

    public string ToSignedXml(WechatPayV2Config config) {
        if (!this.Has("appid") && config.AppId.Length > 0) {
            this.Set("appid", config.AppId);
        }
        if (!this.Has("mch_id") && config.MerchantId.Length > 0) {
            this.Set("mch_id", config.MerchantId);
        }
        if (!this.Has("nonce_str")) {
            this.Set("nonce_str", WechatPayV3Client.RandomNonceHex());
        }
        if (!this.Has("notify_url") && config.NotifyUrl.Length > 0) {
            this.Set("notify_url", config.NotifyUrl);
        }
        if (config.SignType == "HMAC-SHA256" && !this.Has("sign_type")) {
            this.Set("sign_type", config.SignType);
        }
        this.Set("sign", this.Sign(config.MerchantKey, config.SignType));
        return this.ToXml();
    }

    public string ToXml() {
        StringBuilder sb = new StringBuilder();
        sb.Append("<xml>");
        for (int i = 0; i < this.fields.Count; i = i + 1) {
            sb.Append("<"); sb.Append(this.fields[i].name); sb.Append("><![CDATA[");
            string v = this.fields[i].value == null ? "" : this.fields[i].value;
            int from = 0;
            int hit = XmlUtil.IndexOf(v, "]]>", from);
            while (hit >= 0) {
                sb.Append(v.Substring(from, hit + 2 - from));
                sb.Append("]]><![CDATA[>");
                from = hit + 3;
                hit = XmlUtil.IndexOf(v, "]]>", from);
            }
            sb.Append(from == 0 ? v : v.Substring(from, v.Length - from));
            sb.Append("]]></"); sb.Append(this.fields[i].name); sb.Append(">");
        }
        sb.Append("</xml>");
        return sb.ToString();
    }

    public static WechatPayV2Request ParseXml(string xml) {
        WechatPayV2Request result = new WechatPayV2Request();
        if (xml == null || xml.Length == 0) { return result; }
        int pos = XmlUtil.IndexOf(xml, "<xml", 0);
        if (pos < 0) { return result; }
        pos = XmlUtil.IndexOf(xml, ">", pos);
        if (pos < 0) { return result; }
        pos = pos + 1;
        int xmlEnd = XmlUtil.IndexOf(xml, "</xml>", pos);
        if (xmlEnd < 0) { xmlEnd = xml.Length; }
        while (pos < xmlEnd) {
            int open = XmlUtil.IndexOf(xml, "<", pos);
            if (open < 0 || open >= xmlEnd) { break; }
            if (open + 1 >= xmlEnd) { break; }
            int nextC = xml[open + 1] & 255;
            if (nextC == 47) { break; } // '</'
            if (nextC == 33) { // '<!' comment or declaration
                if (open + 3 < xmlEnd && (xml[open + 2] & 255) == 45 && (xml[open + 3] & 255) == 45) {
                    int cEnd = XmlUtil.IndexOf(xml, "-->", open + 4);
                    if (cEnd < 0 || cEnd >= xmlEnd) { break; }
                    pos = cEnd + 3;
                    continue;
                }
                int dEnd = XmlUtil.IndexOf(xml, ">", open + 2);
                if (dEnd < 0 || dEnd >= xmlEnd) { break; }
                pos = dEnd + 1;
                continue;
            }
            if (nextC == 63) { // '<?' processing instruction
                int pEnd = XmlUtil.IndexOf(xml, "?>", open + 2);
                if (pEnd < 0 || pEnd >= xmlEnd) { break; }
                pos = pEnd + 2;
                continue;
            }
            int gt = XmlUtil.IndexOf(xml, ">", open + 1);
            if (gt < 0 || gt > xmlEnd) { break; }
            bool selfClosing = gt > open + 1 && (xml[gt - 1] & 255) == 47;
            int nameLimit = selfClosing ? gt - 1 : gt;
            int nameEnd = nameLimit;
            int scan = open + 1;
            while (scan < nameLimit) {
                int c = xml[scan] & 255;
                if (c == 32 || c == 9 || c == 13 || c == 10) {
                    nameEnd = scan; break;
                }
                scan = scan + 1;
            }
            string name = xml.Substring(open + 1, nameEnd - open - 1);
            if (selfClosing) {
                if (name.Length > 0) { result.Set(name, ""); }
                pos = gt + 1;
                continue;
            }
            string close = "</" + name + ">";
            int end = XmlUtil.IndexOf(xml, close, gt + 1);
            if (end < 0 || end > xmlEnd) {
                pos = gt + 1;
                continue;
            }
            string fieldValue = XmlUtil.StripCdata(xml.Substring(gt + 1,
                                                   end - gt - 1));
            result.Set(name, fieldValue);
            pos = end + close.Length;
        }
        return result;
    }

    private int Index(string name) {
        for (int i = 0; i < this.fields.Count; i = i + 1) {
            if (this.fields[i].name == name) { return i; }
        }
        return -1;
    }
}
