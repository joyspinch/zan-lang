using System;
using System.Collections.Generic;

namespace Sdk.Wechat.TenPay;

public class WechatPayV2Entry {
    public string name;
    public WechatPayV2Config config;

    WechatPayV2Entry(string name, WechatPayV2Config config) {
        this.name = name != null ? name : "";
        this.config = config;
    }
}
