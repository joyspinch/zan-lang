using System;
using System.Collections.Generic;

namespace Sdk.Wechat.TenPay;

public class WechatPayLegacyMpConfig {
    string AppId;
    string AppSecret;
    string AccessToken;

    public WechatPayLegacyMpConfig(string appId, string appSecret) {
        this.AppId = appId;
        this.AppSecret = appSecret;
        this.AccessToken = "";
    }

    public WechatPayLegacyMpConfig SetAccessToken(string accessToken) {
        this.AccessToken = accessToken; return this;
    }
}

// 早期公众号微信支付客户端。AppId/AppSecret 是配置，短期 access_token 可在刷新后设置。
