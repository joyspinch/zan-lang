using System;

namespace Sdk.Wechat.TenPay;

/// <summary>
/// 微信支付 API v3 商户配置。这里保存商户部署时提供的长期配置；
/// 每笔订单、退款等业务数据由具体 API 的强类型 Request 提供。
/// </summary>
class WechatPayV3Config {
    string AppId;
    string AppSecret;
    string MerchantId;
    string MerchantKey;
    string MerchantSerialNumber;
    string MerchantPrivateKeyPem;
    string ApiV3Key;
    string ClientCertificateFile;
    string ClientPrivateKeyFile;
    string NotifyUrl;
    string WxOpenNotifyUrl;
    string SubAppId;
    string SubAppSecret;
    string SubMerchantId;
    string PlatformSerialNumber;
    string PlatformPublicKeyPem;
    bool RequireResponseSignature;

    public WechatPayV3Config(string appId, string merchantId,
                      string merchantSerialNumber,
                      string merchantPrivateKeyPem,
                      string apiV3Key) {
        this.AppId = appId;
        this.AppSecret = "";
        this.MerchantId = merchantId;
        this.MerchantKey = "";
        this.MerchantSerialNumber = merchantSerialNumber;
        this.MerchantPrivateKeyPem = merchantPrivateKeyPem;
        this.ApiV3Key = apiV3Key;
        this.ClientCertificateFile = "";
        this.ClientPrivateKeyFile = "";
        this.NotifyUrl = "";
        this.WxOpenNotifyUrl = "";
        this.SubAppId = "";
        this.SubAppSecret = "";
        this.SubMerchantId = "";
        this.PlatformSerialNumber = "";
        this.PlatformPublicKeyPem = "";
        this.RequireResponseSignature = false;
    }

    WechatPayV3Config SetAppSecret(string appSecret) {
        this.AppSecret = appSecret; return this;
    }
    WechatPayV3Config SetLegacyMerchantKey(string merchantKey) {
        this.MerchantKey = merchantKey; return this;
    }
    WechatPayV3Config SetLegacyCertificate(string certFile, string keyFile) {
        this.ClientCertificateFile = certFile;
        this.ClientPrivateKeyFile = keyFile;
        return this;
    }
    WechatPayV3Config SetNotifyUrl(string url) {
        this.NotifyUrl = url; return this;
    }
    WechatPayV3Config SetNotifyUrls(string payUrl, string wxOpenUrl) {
        this.NotifyUrl = payUrl; this.WxOpenNotifyUrl = wxOpenUrl; return this;
    }
    WechatPayV3Config SetServiceProvider(string subAppId, string subMerchantId) {
        this.SubAppId = subAppId; this.SubMerchantId = subMerchantId; return this;
    }
    WechatPayV3Config SetServiceProviderCredentials(string subAppId,
                                                     string subAppSecret,
                                                     string subMerchantId) {
        this.SubAppId = subAppId;
        this.SubAppSecret = subAppSecret;
        this.SubMerchantId = subMerchantId;
        return this;
    }
    WechatPayV3Config SetPlatformPublicKey(string serial, string publicKeyPem) {
        this.PlatformSerialNumber = serial;
        this.PlatformPublicKeyPem = publicKeyPem;
        this.RequireResponseSignature = true;
        return this;
    }
    WechatPayV3Config AllowUnsignedResponse() {
        this.RequireResponseSignature = false; return this;
    }
}

/// <summary>微信支付 V2/XML 商户配置。</summary>
class WechatPayV2Config {
    string AppId;
    string AppSecret;
    string MerchantId;
    string MerchantKey;
    string NotifyUrl;
    string WxOpenNotifyUrl;
    string SignType;
    string ClientCertificateFile;
    string ClientPrivateKeyFile;
    string SubAppId;
    string SubAppSecret;
    string SubMerchantId;

    public WechatPayV2Config(string appId, string merchantId, string merchantKey) {
        this.AppId = appId;
        this.AppSecret = "";
        this.MerchantId = merchantId;
        this.MerchantKey = merchantKey;
        this.NotifyUrl = "";
        this.WxOpenNotifyUrl = "";
        this.SignType = "MD5";
        this.ClientCertificateFile = "";
        this.ClientPrivateKeyFile = "";
        this.SubAppId = "";
        this.SubAppSecret = "";
        this.SubMerchantId = "";
    }

    WechatPayV2Config SetAppSecret(string appSecret) {
        this.AppSecret = appSecret; return this;
    }
    WechatPayV2Config SetNotifyUrl(string url) {
        this.NotifyUrl = url; return this;
    }
    WechatPayV2Config SetNotifyUrls(string payUrl, string wxOpenUrl) {
        this.NotifyUrl = payUrl; this.WxOpenNotifyUrl = wxOpenUrl; return this;
    }
    WechatPayV2Config UseHmacSha256() {
        this.SignType = "HMAC-SHA256"; return this;
    }
    WechatPayV2Config SetClientCertificate(string certFile, string keyFile) {
        this.ClientCertificateFile = certFile;
        this.ClientPrivateKeyFile = keyFile;
        return this;
    }
    WechatPayV2Config SetServiceProviderCredentials(string subAppId,
                                                     string subAppSecret,
                                                     string subMerchantId) {
        this.SubAppId = subAppId;
        this.SubAppSecret = subAppSecret;
        this.SubMerchantId = subMerchantId;
        return this;
    }
}

/// <summary>按名称保存多商户配置，对应原 SDK 的 TenPayV3InfoCollection。</summary>
class WechatPayConfigRegistry {
    List<string> v3Names;
    List<WechatPayV3Config> v3Values;
    List<string> v2Names;
    List<WechatPayV2Config> v2Values;

    public WechatPayConfigRegistry() {
        this.v3Names = new List<string>();
        this.v3Values = new List<WechatPayV3Config>();
        this.v2Names = new List<string>();
        this.v2Values = new List<WechatPayV2Config>();
    }

    WechatPayConfigRegistry AddV3(string name, WechatPayV3Config config) {
        int i = this.IndexOf(this.v3Names, name);
        if (i >= 0) { this.v3Values[i] = config; }
        else { this.v3Names.Add(name); this.v3Values.Add(config); }
        return this;
    }

    WechatPayConfigRegistry AddV2(string name, WechatPayV2Config config) {
        int i = this.IndexOf(this.v2Names, name);
        if (i >= 0) { this.v2Values[i] = config; }
        else { this.v2Names.Add(name); this.v2Values.Add(config); }
        return this;
    }

    WechatPayV3Config GetV3(string name) {
        int i = this.IndexOf(this.v3Names, name);
        if (i < 0) { return null; }
        return this.v3Values[i];
    }

    WechatPayV2Config GetV2(string name) {
        int i = this.IndexOf(this.v2Names, name);
        if (i < 0) { return null; }
        return this.v2Values[i];
    }

    int IndexOf(List<string> names, string name) {
        for (int i = 0; i < names.Count; i = i + 1) {
            if (names[i] == name) { return i; }
        }
        return -1;
    }
}
