using System;
using System.Text;
using System.Security.Cryptography;

namespace Sdk.Wechat;

// 微信安全模式消息加解密（AES-256-CBC + 32 字节 PKCS#7）。
public class WXBizMsgCrypt {
    string token;
    string appId;
    byte[] aesKey;
    byte[] aesIv;

    public WXBizMsgCrypt(string token, string encodingAesKey, string appId) {
        this.token = token;
        this.appId = appId;
        if (encodingAesKey.Length != 43) {
            throw new WechatException("client.paramError",
                "EncodingAESKey 长度必须为 43", "");
        }
        List<int> keyLen = new List<int>();
        keyLen.Add(0);
        byte[] key = Base64.Decode(encodingAesKey + "=", keyLen);
        if (keyLen[0] != 32) {
            throw new WechatException("client.paramError",
                "EncodingAESKey 解码后不是 32 字节", "");
        }
        this.aesKey = key;
        byte[] iv = new byte[17];
        for (int i = 0; i < 16; i = i + 1) { iv[i] = key[i]; }
        this.aesIv = iv;
    }

    public string DecryptMsg(string msgSignature, string timestamp, string nonce, string postData) {
        string encrypt = XmlUtil.GetTag(postData, "Encrypt");
        if (encrypt.Length == 0) {
            throw new WechatException("client.badResponse", "推送 XML 缺少 Encrypt", postData);
        }
        if (msgSignature.Length == 0 || this.token.Length == 0) {
            throw new WechatException("-40001", "签名校验失败（签名或 token 为空）", postData);
        }
        string expect = WXBizMsgCrypt.MsgSignature(this.token, timestamp, nonce, encrypt);
        // 常数时间比对，防逐字节探测。
        if (!Jwt.fixedEquals(msgSignature, msgSignature.Length, expect, expect.Length)) {
            throw new WechatException("-40001", "签名校验失败", postData);
        }
        WXBizPlain plain = this.AesDecrypt(encrypt);
        if (plain.AppId != this.appId) {
            throw new WechatException("-40005", "appId 校验失败", postData);
        }
        return plain.Msg;
    }

    public string EncryptMsg(string replyMsg, string timestamp, string nonce) {
        string encrypt = this.AesEncrypt(replyMsg);
        string sig = WXBizMsgCrypt.MsgSignature(this.token, timestamp, nonce, encrypt);
        StringBuilder sb = new StringBuilder();
        sb.Append("<xml>");
        sb.Append(XmlUtil.CdataTag("Encrypt", encrypt));
        sb.Append(XmlUtil.CdataTag("MsgSignature", sig));
        sb.Append(XmlUtil.TextTag("TimeStamp", timestamp));
        sb.Append(XmlUtil.CdataTag("Nonce", nonce));
        sb.Append("</xml>");
        return sb.ToString();
    }

    public static string MsgSignature(string token, string timestamp, string nonce, string encrypt) {
        string joined = WXBizMsgCrypt.JoinSorted4(token, timestamp, nonce, encrypt);
        byte[] digest = Sha1.Hash(joined, joined.Length);
        return Hex.Encode(digest, 20);
    }

    private static string JoinSorted4(string a, string b, string c, string d) {
        List<string> xs = new List<string>{ a, b, c, d };
        xs.Sort();
        return xs[0] + xs[1] + xs[2] + xs[3];
    }

    private WXBizPlain AesDecrypt(string cipherB64) {
        List<int> clen = new List<int>();
        clen.Add(0);
        byte[] cipher = Base64.Decode(cipherB64, clen);
        int n = clen[0];
        if (n == 0 || (n % 16) != 0) {
            throw new WechatException("-40007", "AES 密文长度非法", "");
        }
        byte[] raw = WXBizMsgCrypt.CbcDecryptNoPad(this.aesKey, 32, this.aesIv, cipher, n);
        int pad = raw[n - 1] & 255;
        int bad = (pad < 1 || pad > 32 || pad > n) ? 1 : 0;
        int checkLen = bad == 0 ? pad : 1;
        for (int p = 0; p < checkLen; p = p + 1) {
            bad = bad | ((raw[n - 1 - p] & 255) ^ pad);
        }
        if (bad != 0) {
            throw new WechatException("-40007", "AES 填充非法", "");
        }
        int plen = n - pad;
        if (plen < 20) {
            throw new WechatException("-40007", "AES 明文过短", "");
        }
        int msgLen = ((raw[16] & 255) << 24)
                   | ((raw[17] & 255) << 16)
                   | ((raw[18] & 255) << 8)
                   | (raw[19] & 255);
        // 用减法比较避免 20+msgLen i32 上溢绕过边界检查。
        if (msgLen < 0 || msgLen > plen - 20) {
            throw new WechatException("-40007", "AES 明文长度字段非法", "");
        }
        WXBizPlain result = new WXBizPlain();
        result.Msg = raw.ToStr(20, msgLen);
        result.AppId = raw.ToStr(20 + msgLen, plen - 20 - msgLen);
        return result;
    }

    private string AesEncrypt(string plain) {
        string rand = WXBizMsgCrypt.RandAscii(16);
        int msgLen = plain.Length;
        int appLen = this.appId.Length;
        int content = 16 + 4 + msgLen + appLen;
        int amount = 32 - (content % 32);
        if (amount == 0) { amount = 32; }
        int total = content + amount;
        byte[] buf = new byte[total + 1];
        int i = 0;
        for (; i < 16; i = i + 1) { buf[i] = (byte)(rand[i] & 255); }
        buf[16] = (byte)((msgLen >> 24) & 255);
        buf[17] = (byte)((msgLen >> 16) & 255);
        buf[18] = (byte)((msgLen >> 8) & 255);
        buf[19] = (byte)(msgLen & 255);
        i = 0;
        while (i < msgLen) { buf[20 + i] = (byte)(plain[i] & 255); i = i + 1; }
        i = 0;
        while (i < appLen) { buf[20 + msgLen + i] = (byte)(this.appId[i] & 255); i = i + 1; }
        i = 0;
        while (i < amount) { buf[content + i] = (byte)(amount & 255); i = i + 1; }

        byte[] cipher = WXBizMsgCrypt.CbcEncryptNoPad(this.aesKey, 32, this.aesIv, buf, total);
        return Base64.Encode(cipher, total);
    }

    private static byte[] CbcEncryptNoPad(string key, int keyLen, byte[] iv, byte[] data, int len) {
        byte[] outb = new byte[len + 1];
        byte[] prev = new byte[17];
        byte[] block = new byte[17];
        for (int i = 0; i < 16; i = i + 1) { prev[i] = iv[i]; }
        int off = 0;
        while (off < len) {
            for (int j = 0; j < 16; j = j + 1) {
                block[j] = (byte)((data[off + j] & 255) ^ (prev[j] & 255));
            }
            byte[] enc = Aes.EncryptBlockEcb(key, keyLen, block);
            if (enc == null) {
                throw new WechatException("-40006", "AES 加密失败", "");
            }
            for (int j = 0; j < 16; j = j + 1) {
                outb[off + j] = enc[j];
                prev[j] = enc[j];
            }
            off = off + 16;
        }
        return outb;
    }

    private static byte[] CbcDecryptNoPad(string key, int keyLen, byte[] iv, byte[] data, int len) {
        byte[] outb = new byte[len + 1];
        byte[] prev = new byte[17];
        byte[] block = new byte[17];
        for (int i = 0; i < 16; i = i + 1) { prev[i] = iv[i]; }
        int off = 0;
        while (off < len) {
            for (int j = 0; j < 16; j = j + 1) { block[j] = (byte)(data[off + j] & 255); }
            byte[] dec = Aes.DecryptBlockEcb(key, keyLen, block);
            if (dec == null) {
                throw new WechatException("-40007", "AES 解密失败", "");
            }
            for (int j = 0; j < 16; j = j + 1) {
                outb[off + j] = (byte)((dec[j] & 255) ^ (prev[j] & 255));
                prev[j] = block[j];
            }
            off = off + 16;
        }
        return outb;
    }

    private static string RandAscii(int n) {
        if (n <= 0) { return ""; }
        string alphabet = "234567acdefhijkmnprstACDEFGHJKMNPQRSUVWXYZ";
        int alen = alphabet.Length;
        byte[] rnd = RandomNumberGenerator.GetBytes(n);
        if (rnd == null || rnd.Length < n) {
            throw new WechatException("-40006", "安全随机数生成失败", "");
        }
        byte[] outBytes = new byte[n];
        for (int i = 0; i < n; i = i + 1) {
            int idx = (rnd[i] & 255) % alen;
            outBytes[i] = alphabet[idx];
        }
        return outBytes.ToStr(0, n);
    }
}
