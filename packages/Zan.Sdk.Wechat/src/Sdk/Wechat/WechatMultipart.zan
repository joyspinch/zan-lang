using System;
using System.Security.Cryptography;

namespace Sdk.Wechat;

/// <summary>二进制安全的 multipart/form-data 请求构建器。</summary>
class WechatMultipart {
    string boundary;
    StringBuilder content;
    bool closed;

    public WechatMultipart() {
        byte[] random = RandomNumberGenerator.GetBytes(16);
        this.boundary = "----ZanWechat" + Hex.Encode(random, 16);
        this.content = new StringBuilder();
        this.closed = false;
    }

    string ContentType() { return "multipart/form-data; boundary=" + this.boundary; }

    WechatMultipart AddField(string name, string fieldValue) {
        this.EnsureOpen();
        this.content.Append("--" + this.boundary + "\r\n");
        this.content.Append("Content-Disposition: form-data; name=\"");
        this.content.Append(name);
        this.content.Append("\"\r\n\r\n");
        this.content.Append(fieldValue);
        this.content.Append("\r\n");
        return this;
    }

    WechatMultipart AddFile(string name, string fileName, string mediaType,
                            string bytes) {
        this.EnsureOpen();
        this.content.Append("--" + this.boundary + "\r\n");
        this.content.Append("Content-Disposition: form-data; name=\"");
        this.content.Append(name);
        this.content.Append("\"; filename=\"");
        this.content.Append(fileName);
        this.content.Append("\"\r\nContent-Type: ");
        this.content.Append(mediaType);
        this.content.Append("\r\n\r\n");
        this.content.Append(bytes);
        this.content.Append("\r\n");
        return this;
    }

    string Body() {
        if (!this.closed) {
            this.content.Append("--" + this.boundary + "--\r\n");
            this.closed = true;
        }
        return this.content.ToString();
    }

    void EnsureOpen() {
        if (this.closed) {
            throw new InvalidOperationException("multipart body is already closed");
        }
    }
}
