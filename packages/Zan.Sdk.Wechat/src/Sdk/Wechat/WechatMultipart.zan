using System;
using System.Security.Cryptography;

namespace Sdk.Wechat;

// 二进制安全的 multipart/form-data 请求构建器。
public class WechatMultipart {
    string boundary;
    StringBuilder content;
    bool closed;

    public WechatMultipart() {
        byte[] random = RandomNumberGenerator.GetBytes(16);
        if (random == null || random.Length < 16) {
            throw new InvalidOperationException("failed to generate multipart boundary");
        }
        this.boundary = "----ZanWechat" + Hex.Encode(random, 16);
        this.content = new StringBuilder();
        this.closed = false;
    }

    public string ContentType() { return "multipart/form-data; boundary=" + this.boundary; }

    public static WechatMultipart ForFile(string name, string fileName,
                                          string mediaType, string bytes) {
        return new WechatMultipart().AddFile(name, fileName, mediaType, bytes);
    }

    public WechatMultipart AddField(string name, string fieldValue) {
        this.EnsureOpen();
        WechatMultipart.ValidateHeaderValue(name, true, "field name");
        this.content.Append("--" + this.boundary + "\r\n");
        this.content.Append("Content-Disposition: form-data; name=\"");
        this.content.Append(name);
        this.content.Append("\"\r\n\r\n");
        this.content.Append(fieldValue);
        this.content.Append("\r\n");
        return this;
    }

    public WechatMultipart AddFile(string name, string fileName, string mediaType,
                                   string bytes) {
        this.EnsureOpen();
        WechatMultipart.ValidateHeaderValue(name, true, "field name");
        WechatMultipart.ValidateHeaderValue(fileName, true, "file name");
        WechatMultipart.ValidateHeaderValue(mediaType, false, "media type");
        this.content.Append("--" + this.boundary + "\r\n");
        this.content.Append("Content-Disposition: form-data; name=\"");
        this.content.Append(name);
        this.content.Append("\"; filename=\"");
        this.content.Append(fileName);
        this.content.Append("\"\r\nContent-Type: ");
        this.content.Append(mediaType);
        this.content.Append("\r\n\r\n");
        this.content.Append(bytes);
        this.content.Append("\r\n");
        return this;
    }

    private static void ValidateHeaderValue(string val, bool forbidQuote, string label) {
        if (val == null) {
            throw new ArgumentException("multipart " + label + " is null");
        }
        for (int i = 0; i < val.Length; i = i + 1) {
            int c = val[i] & 255;
            if (c == 0 || c == 10 || c == 13 || (forbidQuote && c == 34)) {
                throw new ArgumentException("invalid character in multipart " + label);
            }
        }
    }

    public string Body() {
        if (!this.closed) {
            this.content.Append("--" + this.boundary + "--\r\n");
            this.closed = true;
        }
        return this.content.ToString();
    }

    private void EnsureOpen() {
        if (this.closed) {
            throw new InvalidOperationException("multipart body is already closed");
        }
    }
}
