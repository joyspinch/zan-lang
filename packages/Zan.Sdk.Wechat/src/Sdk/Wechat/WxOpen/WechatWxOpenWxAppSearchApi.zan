using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

/// <summary>方法请求/响应契约；可复用的 DTO 实体位于 Sdk.Wechat.Models.WxOpen。</summary>
class WechatWxOpenWxAppSearchApiSubmitPagesRequest {
    WechatTypedRequest request;

    public WechatWxOpenWxAppSearchApiSubmitPagesRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenWxAppSearchApiSubmitPagesRequest Pages(List<WechatWxOpenPage> fieldValue) {
        this.request.BodyJson("pages", Json.Serialize<List<WechatWxOpenPage>>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}

class WechatWxOpenWxAppSearchApiSubmitPagesResponse {
    public string Raw;
    public JsonValue Value;
}

/// <summary>
/// WxApp/SearchApi.cs 的 Zan 强类型接口。
/// 业务参数由请求对象自动序列化，凭证由客户端配置和缓存自动补充。
/// 由 scripts/generate_wechat_product_apis.py 从 Senparc 微信产品 API 生成。
/// </summary>
class WechatWxOpenWxAppSearchApi {
    WechatWxOpenClient client;

    public WechatWxOpenWxAppSearchApi(WechatWxOpenClient client) {
        this.client = client;
    }

    /// <summary>POST /wxa/search/wxaapi_submitpages</summary>
    async WechatWxOpenWxAppSearchApiSubmitPagesResponse SubmitPagesAsync(WechatWxOpenWxAppSearchApiSubmitPagesRequest request) {
        if (request == null) { request = new WechatWxOpenWxAppSearchApiSubmitPagesRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/wxa/search/wxaapi_submitpages", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenWxAppSearchApiSubmitPagesResponse result = Json.Deserialize<WechatWxOpenWxAppSearchApiSubmitPagesResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse SubmitPagesRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/search/wxaapi_submitpages", query, jsonBody, WechatCredentialKind.AccessToken);
    }

}
