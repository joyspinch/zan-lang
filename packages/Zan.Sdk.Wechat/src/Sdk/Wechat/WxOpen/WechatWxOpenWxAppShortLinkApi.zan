using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenWxAppShortLinkApi {
    WechatWxOpenClient client;

    public WechatWxOpenWxAppShortLinkApi(WechatWxOpenClient client) {
        this.client = client;
    }

    async WechatWxOpenWxAppShortLinkApiGenerateResponse GenerateAsync(WechatWxOpenWxAppShortLinkApiGenerateRequest request) {
        if (request == null) { request = new WechatWxOpenWxAppShortLinkApiGenerateRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/wxa/genwxashortlink", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenWxAppShortLinkApiGenerateResponse result = Json.Deserialize<WechatWxOpenWxAppShortLinkApiGenerateResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GenerateRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/genwxashortlink", query, jsonBody, WechatCredentialKind.AccessToken);
    }

}
