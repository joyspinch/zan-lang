using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenTcbIncrementApi {
    WechatWxOpenClient client;

    public WechatWxOpenTcbIncrementApi(WechatWxOpenClient client) {
        this.client = client;
    }

    public async WechatWxOpenTcbIncrementApiGetOpenDataResponse GetOpenDataAsync(WechatWxOpenTcbIncrementApiGetOpenDataRequest request) {
        if (request == null) { request = new WechatWxOpenTcbIncrementApiGetOpenDataRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/wxa/getopendata", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenTcbIncrementApiGetOpenDataResponse result = Json.Deserialize<WechatWxOpenTcbIncrementApiGetOpenDataResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse GetOpenDataRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/getopendata", query, jsonBody, WechatCredentialKind.AccessToken);
    }

}
