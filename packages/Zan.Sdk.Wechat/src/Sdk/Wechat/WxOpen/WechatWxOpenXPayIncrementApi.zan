using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenXPayIncrementApi {
    WechatWxOpenClient client;

    public WechatWxOpenXPayIncrementApi(WechatWxOpenClient client) {
        this.client = client;
    }

    async WechatWxOpenXPayIncrementApiBindTransferAccountResponse BindTransferAccountAsync(WechatWxOpenXPayIncrementApiBindTransferAccountRequest request) {
        if (request == null) { request = new WechatWxOpenXPayIncrementApiBindTransferAccountRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/xpay/bind_transfer_accout", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenXPayIncrementApiBindTransferAccountResponse result = Json.Deserialize<WechatWxOpenXPayIncrementApiBindTransferAccountResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse BindTransferAccountRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/xpay/bind_transfer_accout", query, jsonBody, WechatCredentialKind.AccessToken);
    }

    async WechatWxOpenXPayIncrementApiDownloadIosSettlementBillResponse DownloadIosSettlementBillAsync(WechatWxOpenXPayIncrementApiDownloadIosSettlementBillRequest request) {
        if (request == null) { request = new WechatWxOpenXPayIncrementApiDownloadIosSettlementBillRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/xpay/download_ios_settlement_bill", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenXPayIncrementApiDownloadIosSettlementBillResponse result = Json.Deserialize<WechatWxOpenXPayIncrementApiDownloadIosSettlementBillResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse DownloadIosSettlementBillRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/xpay/download_ios_settlement_bill", query, jsonBody, WechatCredentialKind.AccessToken);
    }

    async WechatWxOpenXPayIncrementApiQueryPunishmentReasonsResponse QueryPunishmentReasonsAsync(WechatWxOpenXPayIncrementApiQueryPunishmentReasonsRequest request) {
        if (request == null) { request = new WechatWxOpenXPayIncrementApiQueryPunishmentReasonsRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/xpay/query_punishment_reasons", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenXPayIncrementApiQueryPunishmentReasonsResponse result = Json.Deserialize<WechatWxOpenXPayIncrementApiQueryPunishmentReasonsResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse QueryPunishmentReasonsRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/xpay/query_punishment_reasons", query, jsonBody, WechatCredentialKind.AccessToken);
    }

}
