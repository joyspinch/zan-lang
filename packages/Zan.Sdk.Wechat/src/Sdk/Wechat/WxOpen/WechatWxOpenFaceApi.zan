using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenFaceApi {
    WechatWxOpenClient client;

    public WechatWxOpenFaceApi(WechatWxOpenClient client) {
        this.client = client;
    }

    public async WechatWxOpenFaceApiGetVerifyIdResponse GetVerifyIdAsync(WechatWxOpenFaceApiGetVerifyIdRequest request) {
        if (request == null) { request = new WechatWxOpenFaceApiGetVerifyIdRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cityservice/face/identify/getverifyid", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenFaceApiGetVerifyIdResponse result = Json.Deserialize<WechatWxOpenFaceApiGetVerifyIdResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse GetVerifyIdRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cityservice/face/identify/getverifyid", query, jsonBody, WechatCredentialKind.AccessToken);
    }

    public async WechatWxOpenFaceApiQueryVerifyInfoResponse QueryVerifyInfoAsync(WechatWxOpenFaceApiQueryVerifyInfoRequest request) {
        if (request == null) { request = new WechatWxOpenFaceApiQueryVerifyInfoRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cityservice/face/identify/queryverifyinfo", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenFaceApiQueryVerifyInfoResponse result = Json.Deserialize<WechatWxOpenFaceApiQueryVerifyInfoResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse QueryVerifyInfoRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cityservice/face/identify/queryverifyinfo", query, jsonBody, WechatCredentialKind.AccessToken);
    }

}
