using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenRedPacketCoverApi {
    WechatWxOpenClient client;

    public WechatWxOpenRedPacketCoverApi(WechatWxOpenClient client) {
        this.client = client;
    }

    public async WechatWxOpenRedPacketCoverApiGetCoverUrlResponse GetCoverUrlAsync(WechatWxOpenRedPacketCoverApiGetCoverUrlRequest request) {
        if (request == null) { request = new WechatWxOpenRedPacketCoverApiGetCoverUrlRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/redpacketcover/wxapp/cover_url/get_by_token", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenRedPacketCoverApiGetCoverUrlResponse result = Json.Deserialize<WechatWxOpenRedPacketCoverApiGetCoverUrlResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse GetCoverUrlRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/redpacketcover/wxapp/cover_url/get_by_token", query, jsonBody, WechatCredentialKind.AccessToken);
    }

}
