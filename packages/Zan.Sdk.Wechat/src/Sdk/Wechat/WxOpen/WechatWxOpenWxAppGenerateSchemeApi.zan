using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

// 方法请求/响应契约；可复用的 DTO 实体位于 Sdk.Wechat.Models.WxOpen。
class WechatWxOpenWxAppGenerateSchemeApiSubmitPagesRequest {
    WechatTypedRequest request;

    public WechatWxOpenWxAppGenerateSchemeApiSubmitPagesRequest() { this.request = new WechatTypedRequest(); }

    WechatWxOpenWxAppGenerateSchemeApiSubmitPagesRequest Pages(List<WechatWxOpenPage> fieldValue) {
        this.request.BodyJson("pages", Json.Serialize<List<WechatWxOpenPage>>(fieldValue));
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}

class WechatWxOpenWxAppGenerateSchemeApiSubmitPagesResponse {
    public string Raw;
    public JsonValue Value;
}

// WxApp/GenerateSchemeApi.cs 的 Zan 强类型接口。
// 业务参数由请求对象自动序列化，凭证由客户端配置和缓存自动补充。
// 由 scripts/generate_wechat_product_apis.py 从 Senparc 微信产品 API 生成。
class WechatWxOpenWxAppGenerateSchemeApi {
    WechatWxOpenClient client;

    public WechatWxOpenWxAppGenerateSchemeApi(WechatWxOpenClient client) {
        this.client = client;
    }

    // 开放平台业务 API 参数与响应数据模型契约。
    async WechatWxOpenWxAppGenerateSchemeApiSubmitPagesResponse SubmitPagesAsync(WechatWxOpenWxAppGenerateSchemeApiSubmitPagesRequest request) {
        if (request == null) { request = new WechatWxOpenWxAppGenerateSchemeApiSubmitPagesRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/wxa/search/wxaapi_submitpages", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenWxAppGenerateSchemeApiSubmitPagesResponse result = Json.Deserialize<WechatWxOpenWxAppGenerateSchemeApiSubmitPagesResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse SubmitPagesRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/search/wxaapi_submitpages", query, jsonBody, WechatCredentialKind.AccessToken);
    }

}
