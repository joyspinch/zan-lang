using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenWxAppUrlSchemeApi {
    WechatWxOpenClient client;

    public WechatWxOpenWxAppUrlSchemeApi(WechatWxOpenClient client) {
        this.client = client;
    }

    async WechatWxOpenWxAppUrlSchemeApiGenerateSchemeResponse GenerateSchemeAsync(WechatWxOpenWxAppUrlSchemeApiGenerateSchemeRequest request) {
        if (request == null) { request = new WechatWxOpenWxAppUrlSchemeApiGenerateSchemeRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/wxa/generatescheme", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenWxAppUrlSchemeApiGenerateSchemeResponse result = Json.Deserialize<WechatWxOpenWxAppUrlSchemeApiGenerateSchemeResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GenerateSchemeRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/generatescheme", query, jsonBody, WechatCredentialKind.AccessToken);
    }

    async WechatWxOpenWxAppUrlSchemeApiGenerateNFCSchemeResponse GenerateNFCSchemeAsync(WechatWxOpenWxAppUrlSchemeApiGenerateNFCSchemeRequest request) {
        if (request == null) { request = new WechatWxOpenWxAppUrlSchemeApiGenerateNFCSchemeRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/wxa/generatenfcscheme", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenWxAppUrlSchemeApiGenerateNFCSchemeResponse result = Json.Deserialize<WechatWxOpenWxAppUrlSchemeApiGenerateNFCSchemeResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GenerateNFCSchemeRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/generatenfcscheme", query, jsonBody, WechatCredentialKind.AccessToken);
    }

    async WechatWxOpenWxAppUrlSchemeApiQuerySchemeResponse QuerySchemeAsync(WechatWxOpenWxAppUrlSchemeApiQuerySchemeRequest request) {
        if (request == null) { request = new WechatWxOpenWxAppUrlSchemeApiQuerySchemeRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/wxa/queryscheme", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenWxAppUrlSchemeApiQuerySchemeResponse result = Json.Deserialize<WechatWxOpenWxAppUrlSchemeApiQuerySchemeResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse QuerySchemeRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/queryscheme", query, jsonBody, WechatCredentialKind.AccessToken);
    }

}
