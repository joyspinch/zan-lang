using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenSnsApi {
    WechatWxOpenClient client;

    public WechatWxOpenSnsApi(WechatWxOpenClient client) {
        this.client = client;
    }

    public async WechatWxOpenSnsApiJsCode2JsonResponse JsCode2JsonAsync(WechatWxOpenSnsApiJsCode2JsonRequest request) {
        if (request == null) { request = new WechatWxOpenSnsApiJsCode2JsonRequest(); }
        WechatResponse raw = await this.client.RequestAsync("GET", "/sns/jscode2session", request.QueryText(), "", WechatCredentialKind.None);
        WechatWxOpenSnsApiJsCode2JsonResponse result = Json.Deserialize<WechatWxOpenSnsApiJsCode2JsonResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse JsCode2JsonRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/sns/jscode2session", query, "", WechatCredentialKind.None);
    }

}
