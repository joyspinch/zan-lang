        if (request == null) { request = new WechatWxOpenCustomServiceKfWorkApiBindRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/customservice/work/bind", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenCustomServiceKfWorkApiBindResponse result = Json.Deserialize<WechatWxOpenCustomServiceKfWorkApiBindResponse>(raw.Data);
