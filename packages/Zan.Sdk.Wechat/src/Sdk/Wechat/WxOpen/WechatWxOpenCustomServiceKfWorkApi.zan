        WechatResponse raw = await this.client.RequestAsync("GET", "/customservice/work/get", "", "", WechatCredentialKind.AccessToken);
        WechatWxOpenCustomServiceKfWorkApiGetBoundResponse result = Json.Deserialize<WechatWxOpenCustomServiceKfWorkApiGetBoundResponse>(raw.Data);
