using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenStudentApi {
    WechatWxOpenClient client;

    public WechatWxOpenStudentApi(WechatWxOpenClient client) {
        this.client = client;
    }

    async WechatWxOpenStudentApiQuickCheckStudentIdentityResponse QuickCheckStudentIdentityAsync(WechatWxOpenStudentApiQuickCheckStudentIdentityRequest request) {
        if (request == null) { request = new WechatWxOpenStudentApiQuickCheckStudentIdentityRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/intp/quickcheckstudentidentity", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenStudentApiQuickCheckStudentIdentityResponse result = Json.Deserialize<WechatWxOpenStudentApiQuickCheckStudentIdentityResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse QuickCheckStudentIdentityRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/intp/quickcheckstudentidentity", query, jsonBody, WechatCredentialKind.AccessToken);
    }

}
