using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenServiceMarketApi {
    WechatWxOpenClient client;

    public WechatWxOpenServiceMarketApi(WechatWxOpenClient client) {
        this.client = client;
    }

    public async WechatWxOpenServiceMarketApiInvokeServiceResponse InvokeServiceAsync(WechatWxOpenServiceMarketApiInvokeServiceRequest request) {
        if (request == null) { request = new WechatWxOpenServiceMarketApiInvokeServiceRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/wxa/servicemarket", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenServiceMarketApiInvokeServiceResponse result = Json.Deserialize<WechatWxOpenServiceMarketApiInvokeServiceResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse InvokeServiceRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/servicemarket", query, jsonBody, WechatCredentialKind.AccessToken);
    }

    public async WechatWxOpenServiceMarketApiRetrieveResultResponse RetrieveResultAsync(WechatWxOpenServiceMarketApiRetrieveResultRequest request) {
        if (request == null) { request = new WechatWxOpenServiceMarketApiRetrieveResultRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/wxa/servicemarketretrieve", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenServiceMarketApiRetrieveResultResponse result = Json.Deserialize<WechatWxOpenServiceMarketApiRetrieveResultResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse RetrieveResultRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/servicemarketretrieve", query, jsonBody, WechatCredentialKind.AccessToken);
    }

}
