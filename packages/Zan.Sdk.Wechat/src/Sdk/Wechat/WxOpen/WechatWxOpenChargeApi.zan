using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenChargeApi {
    WechatWxOpenClient client;

    public WechatWxOpenChargeApi(WechatWxOpenClient client) {
        this.client = client;
    }

    public async WechatWxOpenChargeApiUsageResponse UsageAsync(WechatWxOpenChargeApiUsageRequest request) {
        if (request == null) { request = new WechatWxOpenChargeApiUsageRequest(); }
        WechatResponse raw = await this.client.RequestAsync("GET", "/wxa/charge/usage/get", request.QueryText(), "", WechatCredentialKind.AccessToken);
        WechatWxOpenChargeApiUsageResponse result = Json.Deserialize<WechatWxOpenChargeApiUsageResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse UsageRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/wxa/charge/usage/get", query, "", WechatCredentialKind.AccessToken);
    }

    public async WechatWxOpenChargeApiGetRecentAverageResponse GetRecentAverageAsync(WechatWxOpenChargeApiGetRecentAverageRequest request) {
        if (request == null) { request = new WechatWxOpenChargeApiGetRecentAverageRequest(); }
        WechatResponse raw = await this.client.RequestAsync("GET", "/wxa/charge/usage/get_recent_average", request.QueryText(), "", WechatCredentialKind.AccessToken);
        WechatWxOpenChargeApiGetRecentAverageResponse result = Json.Deserialize<WechatWxOpenChargeApiGetRecentAverageResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse GetRecentAverageRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/wxa/charge/usage/get_recent_average", query, "", WechatCredentialKind.AccessToken);
    }

}
