using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenMessageServiceCardApi {
    WechatWxOpenClient client;

    public WechatWxOpenMessageServiceCardApi(WechatWxOpenClient client) {
        this.client = client;
    }

    async WechatWxOpenMessageServiceCardApiSetUserNotifyResponse SetUserNotifyAsync(WechatWxOpenMessageServiceCardApiSetUserNotifyRequest request) {
        if (request == null) { request = new WechatWxOpenMessageServiceCardApiSetUserNotifyRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/wxa/set_user_notify", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenMessageServiceCardApiSetUserNotifyResponse result = Json.Deserialize<WechatWxOpenMessageServiceCardApiSetUserNotifyResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse SetUserNotifyRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/set_user_notify", query, jsonBody, WechatCredentialKind.AccessToken);
    }

    async WechatWxOpenMessageServiceCardApiSetUserNotifyExtResponse SetUserNotifyExtAsync(WechatWxOpenMessageServiceCardApiSetUserNotifyExtRequest request) {
        if (request == null) { request = new WechatWxOpenMessageServiceCardApiSetUserNotifyExtRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/wxa/set_user_notifyext", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenMessageServiceCardApiSetUserNotifyExtResponse result = Json.Deserialize<WechatWxOpenMessageServiceCardApiSetUserNotifyExtResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse SetUserNotifyExtRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/set_user_notifyext", query, jsonBody, WechatCredentialKind.AccessToken);
    }

    async WechatWxOpenMessageServiceCardApiGetUserNotifyResponse GetUserNotifyAsync(WechatWxOpenMessageServiceCardApiGetUserNotifyRequest request) {
        if (request == null) { request = new WechatWxOpenMessageServiceCardApiGetUserNotifyRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/wxa/get_user_notify", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenMessageServiceCardApiGetUserNotifyResponse result = Json.Deserialize<WechatWxOpenMessageServiceCardApiGetUserNotifyResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GetUserNotifyRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/get_user_notify", query, jsonBody, WechatCredentialKind.AccessToken);
    }

}
