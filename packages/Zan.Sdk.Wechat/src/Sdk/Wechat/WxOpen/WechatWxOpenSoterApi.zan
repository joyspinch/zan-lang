using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenSoterApi {
    WechatWxOpenClient client;

    public WechatWxOpenSoterApi(WechatWxOpenClient client) {
        this.client = client;
    }

    public async WechatWxOpenSoterApiVerifySignatureResponse VerifySignatureAsync(WechatWxOpenSoterApiVerifySignatureRequest request) {
        if (request == null) { request = new WechatWxOpenSoterApiVerifySignatureRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/soter/verify_signature", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenSoterApiVerifySignatureResponse result = Json.Deserialize<WechatWxOpenSoterApiVerifySignatureResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse VerifySignatureRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/soter/verify_signature", query, jsonBody, WechatCredentialKind.AccessToken);
    }

}
