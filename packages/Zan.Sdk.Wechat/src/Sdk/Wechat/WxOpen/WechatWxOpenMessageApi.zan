using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenMessageApi {
    WechatWxOpenClient client;

    public WechatWxOpenMessageApi(WechatWxOpenClient client) {
        this.client = client;
    }

    public async WechatWxOpenMessageApiSendSubscribeResponse SendSubscribeAsync(WechatWxOpenMessageApiSendSubscribeRequest request) {
        if (request == null) { request = new WechatWxOpenMessageApiSendSubscribeRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/message/subscribe/send", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenMessageApiSendSubscribeResponse result = Json.Deserialize<WechatWxOpenMessageApiSendSubscribeResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse SendSubscribeRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/message/subscribe/send", query, jsonBody, WechatCredentialKind.AccessToken);
    }

    public async WechatWxOpenMessageApiSendEmployeeRelationMessageResponse SendEmployeeRelationMessageAsync(WechatWxOpenMessageApiSendEmployeeRelationMessageRequest request) {
        if (request == null) { request = new WechatWxOpenMessageApiSendEmployeeRelationMessageRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/message/wxopen/employeerelationmsg/send", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenMessageApiSendEmployeeRelationMessageResponse result = Json.Deserialize<WechatWxOpenMessageApiSendEmployeeRelationMessageResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse SendEmployeeRelationMessageRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/message/wxopen/employeerelationmsg/send", query, jsonBody, WechatCredentialKind.AccessToken);
    }

}
