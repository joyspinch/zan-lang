using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenHardwareDeviceApi {
    WechatWxOpenClient client;

    public WechatWxOpenHardwareDeviceApi(WechatWxOpenClient client) {
        this.client = client;
    }

    public async WechatWxOpenHardwareDeviceApiSendDeviceMessageResponse SendDeviceMessageAsync(WechatWxOpenHardwareDeviceApiSendDeviceMessageRequest request) {
        if (request == null) { request = new WechatWxOpenHardwareDeviceApiSendDeviceMessageRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/message/device/subscribe/send", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenHardwareDeviceApiSendDeviceMessageResponse result = Json.Deserialize<WechatWxOpenHardwareDeviceApiSendDeviceMessageResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse SendDeviceMessageRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/message/device/subscribe/send", query, jsonBody, WechatCredentialKind.AccessToken);
    }

}
