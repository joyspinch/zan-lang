using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenWeixinExpressProviderApi {
    WechatWxOpenClient client;

    public WechatWxOpenWeixinExpressProviderApi(WechatWxOpenClient client) {
        this.client = client;
    }

    public async WechatWxOpenWeixinExpressProviderApiQueryUserBindingResponse QueryUserBindingAsync(WechatWxOpenWeixinExpressProviderApiQueryUserBindingRequest request) {
        if (request == null) { request = new WechatWxOpenWeixinExpressProviderApiQueryUserBindingRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/express/delivery/userquery", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenWeixinExpressProviderApiQueryUserBindingResponse result = Json.Deserialize<WechatWxOpenWeixinExpressProviderApiQueryUserBindingResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse QueryUserBindingRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/express/delivery/userquery", query, jsonBody, WechatCredentialKind.AccessToken);
    }

    public async WechatWxOpenWeixinExpressProviderApiNotifyPathResponse NotifyPathAsync(WechatWxOpenWeixinExpressProviderApiNotifyPathRequest request) {
        if (request == null) { request = new WechatWxOpenWeixinExpressProviderApiNotifyPathRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/express/delivery/pathnotify", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenWeixinExpressProviderApiNotifyPathResponse result = Json.Deserialize<WechatWxOpenWeixinExpressProviderApiNotifyPathResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse NotifyPathRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/express/delivery/pathnotify", query, jsonBody, WechatCredentialKind.AccessToken);
    }

}
