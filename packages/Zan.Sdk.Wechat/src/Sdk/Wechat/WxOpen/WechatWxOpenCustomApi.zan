using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenCustomApi {
    WechatWxOpenClient client;

    public WechatWxOpenCustomApi(WechatWxOpenClient client) {
        this.client = client;
    }

    async WechatWxOpenCustomApiSendImageResponse SendImageAsync(WechatWxOpenCustomApiSendImageRequest request) {
        if (request == null) { request = new WechatWxOpenCustomApiSendImageRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/message/custom/send", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenCustomApiSendImageResponse result = Json.Deserialize<WechatWxOpenCustomApiSendImageResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse SendImageRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/message/custom/send", query, jsonBody, WechatCredentialKind.AccessToken);
    }

    async WechatWxOpenCustomApiSendLinkResponse SendLinkAsync(WechatWxOpenCustomApiSendLinkRequest request) {
        if (request == null) { request = new WechatWxOpenCustomApiSendLinkRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/message/custom/send", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenCustomApiSendLinkResponse result = Json.Deserialize<WechatWxOpenCustomApiSendLinkResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse SendLinkRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/message/custom/send", query, jsonBody, WechatCredentialKind.AccessToken);
    }

    async WechatWxOpenCustomApiSendMiniProgramPageResponse SendMiniProgramPageAsync(WechatWxOpenCustomApiSendMiniProgramPageRequest request) {
        if (request == null) { request = new WechatWxOpenCustomApiSendMiniProgramPageRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/message/custom/send", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenCustomApiSendMiniProgramPageResponse result = Json.Deserialize<WechatWxOpenCustomApiSendMiniProgramPageResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse SendMiniProgramPageRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/message/custom/send", query, jsonBody, WechatCredentialKind.AccessToken);
    }

}
