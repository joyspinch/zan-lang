using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenImmediateDeliveryProviderApi {
    WechatWxOpenClient client;

    public WechatWxOpenImmediateDeliveryProviderApi(WechatWxOpenClient client) {
        this.client = client;
    }

    async WechatWxOpenImmediateDeliveryProviderApiUpdateOrderStatusResponse UpdateOrderStatusAsync(WechatWxOpenImmediateDeliveryProviderApiUpdateOrderStatusRequest request) {
        if (request == null) { request = new WechatWxOpenImmediateDeliveryProviderApiUpdateOrderStatusRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/express/local/delivery/update_order", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenImmediateDeliveryProviderApiUpdateOrderStatusResponse result = Json.Deserialize<WechatWxOpenImmediateDeliveryProviderApiUpdateOrderStatusResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse UpdateOrderStatusRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/express/local/delivery/update_order", query, jsonBody, WechatCredentialKind.AccessToken);
    }

}
