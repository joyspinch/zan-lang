using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenCustomServiceApi {
    WechatWxOpenClient client;

    public WechatWxOpenCustomServiceApi(WechatWxOpenClient client) {
        this.client = client;
    }

    async WechatWxOpenCustomServiceApiGetKfListResponse GetKfListAsync() {
        WechatResponse raw = await this.client.RequestAsync("GET", "/cgi-bin/customservice/getkflist", "", "", WechatCredentialKind.AccessToken);
        WechatWxOpenCustomServiceApiGetKfListResponse result = Json.Deserialize<WechatWxOpenCustomServiceApiGetKfListResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GetKfListRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/cgi-bin/customservice/getkflist", query, "", WechatCredentialKind.AccessToken);
    }

