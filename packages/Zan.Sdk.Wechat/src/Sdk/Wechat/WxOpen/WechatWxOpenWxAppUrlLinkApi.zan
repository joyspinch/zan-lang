using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.WxOpen;

namespace Sdk.Wechat.WxOpen;

public class WechatWxOpenWxAppUrlLinkApi {
    WechatWxOpenClient client;

    public WechatWxOpenWxAppUrlLinkApi(WechatWxOpenClient client) {
        this.client = client;
    }

    async WechatWxOpenWxAppUrlLinkApiGenerateResponse GenerateAsync(WechatWxOpenWxAppUrlLinkApiGenerateRequest request) {
        if (request == null) { request = new WechatWxOpenWxAppUrlLinkApiGenerateRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/wxa/generate_urllink", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenWxAppUrlLinkApiGenerateResponse result = Json.Deserialize<WechatWxOpenWxAppUrlLinkApiGenerateResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GenerateRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/generate_urllink", query, jsonBody, WechatCredentialKind.AccessToken);
    }

    async WechatWxOpenWxAppUrlLinkApiQueryResponse QueryAsync(WechatWxOpenWxAppUrlLinkApiQueryRequest request) {
        if (request == null) { request = new WechatWxOpenWxAppUrlLinkApiQueryRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/wxa/query_urllink", request.QueryText(), request.JsonBody(), WechatCredentialKind.AccessToken);
        WechatWxOpenWxAppUrlLinkApiQueryResponse result = Json.Deserialize<WechatWxOpenWxAppUrlLinkApiQueryResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse QueryRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/query_urllink", query, jsonBody, WechatCredentialKind.AccessToken);
    }

}
