using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

// 方法请求/响应契约；可复用的 DTO 实体见 Sdk.Wechat.Models.Open。
class WechatOpenSnsApiJsCode2JsonRequest {
    WechatTypedRequest request;

    public WechatOpenSnsApiJsCode2JsonRequest() { this.request = new WechatTypedRequest(); }

    WechatOpenSnsApiJsCode2JsonRequest AppId(string fieldValue) {
        this.request.QueryString("appid", fieldValue);
        return this;
    }

    WechatOpenSnsApiJsCode2JsonRequest ComponentAppId(string fieldValue) {
        this.request.QueryString("component_appid", fieldValue);
        return this;
    }

    WechatOpenSnsApiJsCode2JsonRequest JsCode(string fieldValue) {
        this.request.QueryString("js_code", fieldValue);
        return this;
    }

    WechatOpenSnsApiJsCode2JsonRequest GrantType(string fieldValue) {
        this.request.QueryString("grant_type", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}

class WechatOpenSnsApiJsCode2JsonResponse : WechatOpenJsCode2JsonResult {
    public string Raw;
}

// WxaAPIs/Sns/SnsApi.cs 的 Zan 强类型接口。
// 业务参数由请求对象自动序列化，凭证由客户端配置和缓存自动补充。
// 由 scripts/generate_wechat_product_apis.py 从 Senparc 微信产品 API 生成。
class WechatOpenSnsApi {
    WechatOpenClient client;

    public WechatOpenSnsApi(WechatOpenClient client) {
        this.client = client;
    }

    // 开放平台业务 API 参数与响应数据模型契约。
    async WechatOpenSnsApiJsCode2JsonResponse JsCode2JsonAsync(WechatOpenSnsApiJsCode2JsonRequest request) {
        if (request == null) { request = new WechatOpenSnsApiJsCode2JsonRequest(); }
        WechatResponse raw = await this.client.RequestAsync("GET", "/sns/component/jscode2session", request.QueryText(), "", WechatCredentialKind.ComponentAccessToken);
        WechatOpenSnsApiJsCode2JsonResponse result = Json.Deserialize<WechatOpenSnsApiJsCode2JsonResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse JsCode2JsonRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/sns/component/jscode2session", query, "", WechatCredentialKind.ComponentAccessToken);
    }

}
