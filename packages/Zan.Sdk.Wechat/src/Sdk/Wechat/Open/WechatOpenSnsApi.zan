using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenSnsApi {
    WechatOpenClient client;

    public WechatOpenSnsApi(WechatOpenClient client) {
        this.client = client;
    }

    async WechatOpenSnsApiJsCode2JsonResponse JsCode2JsonAsync(WechatOpenSnsApiJsCode2JsonRequest request) {
        if (request == null) { request = new WechatOpenSnsApiJsCode2JsonRequest(); }
        WechatResponse raw = await this.client.RequestAsync("GET", "/sns/component/jscode2session", request.QueryText(), "", WechatCredentialKind.ComponentAccessToken);
        WechatOpenSnsApiJsCode2JsonResponse result = Json.Deserialize<WechatOpenSnsApiJsCode2JsonResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse JsCode2JsonRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/sns/component/jscode2session", query, "", WechatCredentialKind.ComponentAccessToken);
    }

}
