using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenCodeTemplateApi {
    WechatOpenClient client;

    public WechatOpenCodeTemplateApi(WechatOpenClient client) {
        this.client = client;
    }

    public async WechatOpenCodeTemplateApiGetTemplateDraftListResponse GetTemplateDraftListAsync() {
        WechatResponse raw = await this.client.RequestAsync("GET", "/wxa/gettemplatedraftlist", "", "", WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenCodeTemplateApiGetTemplateDraftListResponse result = Json.Deserialize<WechatOpenCodeTemplateApiGetTemplateDraftListResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse GetTemplateDraftListRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/wxa/gettemplatedraftlist", query, "", WechatCredentialKind.AuthorizerAccessToken);
    }

    public async WechatOpenCodeTemplateApiGetTemplateListResponse GetTemplateListAsync() {
        WechatResponse raw = await this.client.RequestAsync("GET", "/wxa/gettemplatelist", "", "", WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenCodeTemplateApiGetTemplateListResponse result = Json.Deserialize<WechatOpenCodeTemplateApiGetTemplateListResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse GetTemplateListRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/wxa/gettemplatelist", query, "", WechatCredentialKind.AuthorizerAccessToken);
    }

    public async WechatOpenCodeTemplateApiAddToTemplateResponse AddToTemplateAsync(WechatOpenCodeTemplateApiAddToTemplateRequest request) {
        if (request == null) { request = new WechatOpenCodeTemplateApiAddToTemplateRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/wxa/addtotemplate", request.QueryText(), request.JsonBody(), WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenCodeTemplateApiAddToTemplateResponse result = Json.Deserialize<WechatOpenCodeTemplateApiAddToTemplateResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse AddToTemplateRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/addtotemplate", query, jsonBody, WechatCredentialKind.AuthorizerAccessToken);
    }

    public async WechatOpenCodeTemplateApiDeleteTemplateResponse DeleteTemplateAsync(WechatOpenCodeTemplateApiDeleteTemplateRequest request) {
        if (request == null) { request = new WechatOpenCodeTemplateApiDeleteTemplateRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/wxa/deletetemplate", request.QueryText(), request.JsonBody(), WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenCodeTemplateApiDeleteTemplateResponse result = Json.Deserialize<WechatOpenCodeTemplateApiDeleteTemplateResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse DeleteTemplateRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/deletetemplate", query, jsonBody, WechatCredentialKind.AuthorizerAccessToken);
    }

