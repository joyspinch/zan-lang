using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenComponentOpenApi {
    WechatOpenClient client;

    public WechatOpenComponentOpenApi(WechatOpenClient client) {
        this.client = client;
    }

    async WechatOpenComponentOpenApiStartPushTicketResponse StartPushTicketAsync(WechatOpenComponentOpenApiStartPushTicketRequest request) {
        if (request == null) { request = new WechatOpenComponentOpenApiStartPushTicketRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/component/api_start_push_ticket", request.QueryText(), request.JsonBody(), WechatCredentialKind.None);
        WechatOpenComponentOpenApiStartPushTicketResponse result = Json.Deserialize<WechatOpenComponentOpenApiStartPushTicketResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse StartPushTicketRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/component/api_start_push_ticket", query, jsonBody, WechatCredentialKind.None);
    }

    async WechatOpenComponentOpenApiClearComponentQuotaByAppSecretResponse ClearComponentQuotaByAppSecretAsync(WechatOpenComponentOpenApiClearComponentQuotaByAppSecretRequest request) {
        if (request == null) { request = new WechatOpenComponentOpenApiClearComponentQuotaByAppSecretRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/component/clear_quota/v2", request.QueryText(), request.JsonBody(), WechatCredentialKind.None);
        WechatOpenComponentOpenApiClearComponentQuotaByAppSecretResponse result = Json.Deserialize<WechatOpenComponentOpenApiClearComponentQuotaByAppSecretResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse ClearComponentQuotaByAppSecretRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/component/clear_quota/v2", query, jsonBody, WechatCredentialKind.None);
    }

}
