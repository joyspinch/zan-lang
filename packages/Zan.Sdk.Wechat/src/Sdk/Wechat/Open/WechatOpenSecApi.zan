using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenSecApi {
    WechatOpenClient client;

    public WechatOpenSecApi(WechatOpenClient client) {
        this.client = client;
    }

    public async WechatOpenSecApiWxaAuthResponse WxaAuthAsync(WechatOpenSecApiWxaAuthRequest request) {
        if (request == null) { request = new WechatOpenSecApiWxaAuthRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/wxa/sec/wxaauth", request.QueryText(), request.JsonBody(), WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenSecApiWxaAuthResponse result = Json.Deserialize<WechatOpenSecApiWxaAuthResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse WxaAuthRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/sec/wxaauth", query, jsonBody, WechatCredentialKind.AuthorizerAccessToken);
    }

    public async WechatOpenSecApiQueryAuthResponse QueryAuthAsync(WechatOpenSecApiQueryAuthRequest request) {
        if (request == null) { request = new WechatOpenSecApiQueryAuthRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/wxa/sec/queryauth", request.QueryText(), request.JsonBody(), WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenSecApiQueryAuthResponse result = Json.Deserialize<WechatOpenSecApiQueryAuthResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse QueryAuthRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/sec/queryauth", query, jsonBody, WechatCredentialKind.AuthorizerAccessToken);
    }

    public async WechatOpenSecApiReauthResponse ReauthAsync(WechatOpenSecApiReauthRequest request) {
        if (request == null) { request = new WechatOpenSecApiReauthRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/wxa/sec/reauth", request.QueryText(), request.JsonBody(), WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenSecApiReauthResponse result = Json.Deserialize<WechatOpenSecApiReauthResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse ReauthRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/sec/reauth", query, jsonBody, WechatCredentialKind.AuthorizerAccessToken);
    }

    public async WechatOpenSecApiAuthIdentityTreeResponse AuthIdentityTreeAsync() {
        WechatResponse raw = await this.client.RequestAsync("POST", "/wxa/sec/authidentitytree", "", "", WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenSecApiAuthIdentityTreeResponse result = Json.Deserialize<WechatOpenSecApiAuthIdentityTreeResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse AuthIdentityTreeRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/sec/authidentitytree", query, jsonBody, WechatCredentialKind.AuthorizerAccessToken);
    }

}
