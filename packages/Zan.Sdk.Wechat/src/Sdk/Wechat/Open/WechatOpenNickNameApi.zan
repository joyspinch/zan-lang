using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenNickNameApi {
    WechatOpenClient client;

    public WechatOpenNickNameApi(WechatOpenClient client) {
        this.client = client;
    }

    public async WechatOpenNickNameApiSetNickNameResponse SetNickNameAsync(WechatOpenNickNameApiSetNickNameRequest request) {
        if (request == null) { request = new WechatOpenNickNameApiSetNickNameRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/wxa/setnickname", request.QueryText(), request.JsonBody(), WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenNickNameApiSetNickNameResponse result = Json.Deserialize<WechatOpenNickNameApiSetNickNameResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse SetNickNameRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/setnickname", query, jsonBody, WechatCredentialKind.AuthorizerAccessToken);
    }

    public async WechatOpenNickNameApiQueryNickNameResponse QueryNickNameAsync(WechatOpenNickNameApiQueryNickNameRequest request) {
        if (request == null) { request = new WechatOpenNickNameApiQueryNickNameRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/wxa/api_wxa_querynickname", request.QueryText(), request.JsonBody(), WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenNickNameApiQueryNickNameResponse result = Json.Deserialize<WechatOpenNickNameApiQueryNickNameResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse QueryNickNameRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/api_wxa_querynickname", query, jsonBody, WechatCredentialKind.AuthorizerAccessToken);
    }

    public async WechatOpenNickNameApiCheckWxVerifyNickNameResponse CheckWxVerifyNickNameAsync(WechatOpenNickNameApiCheckWxVerifyNickNameRequest request) {
        if (request == null) { request = new WechatOpenNickNameApiCheckWxVerifyNickNameRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/wxverify/checkwxverifynickname", request.QueryText(), request.JsonBody(), WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenNickNameApiCheckWxVerifyNickNameResponse result = Json.Deserialize<WechatOpenNickNameApiCheckWxVerifyNickNameResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse CheckWxVerifyNickNameRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/wxverify/checkwxverifynickname", query, jsonBody, WechatCredentialKind.AuthorizerAccessToken);
    }

}
