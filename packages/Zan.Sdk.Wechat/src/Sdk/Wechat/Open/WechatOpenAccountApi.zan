using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenAccountApi {
    WechatOpenClient client;

    public WechatOpenAccountApi(WechatOpenClient client) {
        this.client = client;
    }

    public async WechatOpenAccountApiFastRegisterResponse FastRegisterAsync(WechatOpenAccountApiFastRegisterRequest request) {
        if (request == null) { request = new WechatOpenAccountApiFastRegisterRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/account/fastregister", request.QueryText(), request.JsonBody(), WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenAccountApiFastRegisterResponse result = Json.Deserialize<WechatOpenAccountApiFastRegisterResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse FastRegisterRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/account/fastregister", query, jsonBody, WechatCredentialKind.AuthorizerAccessToken);
    }

    public async WechatOpenAccountApiGetAccountBasicInfoResponse GetAccountBasicInfoAsync() {
        WechatResponse raw = await this.client.RequestAsync("GET", "/cgi-bin/account/getaccountbasicinfo", "", "", WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenAccountApiGetAccountBasicInfoResponse result = Json.Deserialize<WechatOpenAccountApiGetAccountBasicInfoResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse GetAccountBasicInfoRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/cgi-bin/account/getaccountbasicinfo", query, "", WechatCredentialKind.AuthorizerAccessToken);
    }

    public async WechatOpenAccountApiModifyHeadImageResponse ModifyHeadImageAsync(WechatOpenAccountApiModifyHeadImageRequest request) {
        if (request == null) { request = new WechatOpenAccountApiModifyHeadImageRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/account/modifyheadimage", request.QueryText(), request.JsonBody(), WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenAccountApiModifyHeadImageResponse result = Json.Deserialize<WechatOpenAccountApiModifyHeadImageResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse ModifyHeadImageRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/account/modifyheadimage", query, jsonBody, WechatCredentialKind.AuthorizerAccessToken);
    }

    public async WechatOpenAccountApiModifySignatureResponse ModifySignatureAsync(WechatOpenAccountApiModifySignatureRequest request) {
        if (request == null) { request = new WechatOpenAccountApiModifySignatureRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/account/modifysignature", request.QueryText(), request.JsonBody(), WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenAccountApiModifySignatureResponse result = Json.Deserialize<WechatOpenAccountApiModifySignatureResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse ModifySignatureRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/account/modifysignature", query, jsonBody, WechatCredentialKind.AuthorizerAccessToken);
    }

    public async WechatOpenAccountApiComponentRebindAdminResponse ComponentRebindAdminAsync(WechatOpenAccountApiComponentRebindAdminRequest request) {
        if (request == null) { request = new WechatOpenAccountApiComponentRebindAdminRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/account/componentrebindadmin", request.QueryText(), request.JsonBody(), WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenAccountApiComponentRebindAdminResponse result = Json.Deserialize<WechatOpenAccountApiComponentRebindAdminResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse ComponentRebindAdminRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/account/componentrebindadmin", query, jsonBody, WechatCredentialKind.AuthorizerAccessToken);
    }

}
