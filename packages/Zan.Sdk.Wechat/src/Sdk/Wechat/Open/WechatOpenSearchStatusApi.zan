using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenSearchStatusApi {
    WechatOpenClient client;

    public WechatOpenSearchStatusApi(WechatOpenClient client) {
        this.client = client;
    }

    public async WechatOpenSearchStatusApiGetWxaSearchStatusResponse GetWxaSearchStatusAsync() {
        WechatResponse raw = await this.client.RequestAsync("GET", "/wxa/getwxasearchstatus", "", "", WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenSearchStatusApiGetWxaSearchStatusResponse result = Json.Deserialize<WechatOpenSearchStatusApiGetWxaSearchStatusResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse GetWxaSearchStatusRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/wxa/getwxasearchstatus", query, "", WechatCredentialKind.AuthorizerAccessToken);
    }

    public async WechatOpenSearchStatusApiChangeWxaSearchStatusResponse ChangeWxaSearchStatusAsync(WechatOpenSearchStatusApiChangeWxaSearchStatusRequest request) {
        if (request == null) { request = new WechatOpenSearchStatusApiChangeWxaSearchStatusRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/wxa/changewxasearchstatus", request.QueryText(), request.JsonBody(), WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenSearchStatusApiChangeWxaSearchStatusResponse result = Json.Deserialize<WechatOpenSearchStatusApiChangeWxaSearchStatusResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse ChangeWxaSearchStatusRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/changewxasearchstatus", query, jsonBody, WechatCredentialKind.AuthorizerAccessToken);
    }

}
