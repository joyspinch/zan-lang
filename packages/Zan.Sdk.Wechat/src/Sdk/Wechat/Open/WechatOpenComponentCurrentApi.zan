using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenComponentCurrentApi {
    WechatOpenClient client;

    public WechatOpenComponentCurrentApi(WechatOpenClient client) {
        this.client = client;
    }

    public async WechatOpenComponentCurrentApiGetAuthorizerOptionInfoResponse GetAuthorizerOptionInfoAsync(WechatOpenComponentCurrentApiGetAuthorizerOptionInfoRequest request) {
        if (request == null) { request = new WechatOpenComponentCurrentApiGetAuthorizerOptionInfoRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/component/get_authorizer_option", request.QueryText(), request.JsonBody(), WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenComponentCurrentApiGetAuthorizerOptionInfoResponse result = Json.Deserialize<WechatOpenComponentCurrentApiGetAuthorizerOptionInfoResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse GetAuthorizerOptionInfoRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/component/get_authorizer_option", query, jsonBody, WechatCredentialKind.AuthorizerAccessToken);
    }

    public async WechatOpenComponentCurrentApiSetAuthorizerOptionInfoResponse SetAuthorizerOptionInfoAsync(WechatOpenComponentCurrentApiSetAuthorizerOptionInfoRequest request) {
        if (request == null) { request = new WechatOpenComponentCurrentApiSetAuthorizerOptionInfoRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/component/set_authorizer_option", request.QueryText(), request.JsonBody(), WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenComponentCurrentApiSetAuthorizerOptionInfoResponse result = Json.Deserialize<WechatOpenComponentCurrentApiSetAuthorizerOptionInfoResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse SetAuthorizerOptionInfoRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/component/set_authorizer_option", query, jsonBody, WechatCredentialKind.AuthorizerAccessToken);
    }

}
