using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenQRConnectApi {
    WechatOpenClient client;

    public WechatOpenQRConnectApi(WechatOpenClient client) {
        this.client = client;
    }

    async WechatOpenQRConnectApiGetAccessTokenResponse GetAccessTokenAsync(WechatOpenQRConnectApiGetAccessTokenRequest request) {
        if (request == null) { request = new WechatOpenQRConnectApiGetAccessTokenRequest(); }
        WechatResponse raw = await this.client.RequestAsync("GET", "/sns/oauth2/access_token", request.QueryText(), "", WechatCredentialKind.None);
        WechatOpenQRConnectApiGetAccessTokenResponse result = Json.Deserialize<WechatOpenQRConnectApiGetAccessTokenResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GetAccessTokenRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/sns/oauth2/access_token", query, "", WechatCredentialKind.None);
    }

    async WechatOpenQRConnectApiRefreshTokenResponse RefreshTokenAsync(WechatOpenQRConnectApiRefreshTokenRequest request) {
        if (request == null) { request = new WechatOpenQRConnectApiRefreshTokenRequest(); }
        WechatResponse raw = await this.client.RequestAsync("GET", "/sns/oauth2/refresh_token", request.QueryText(), "", WechatCredentialKind.None);
        WechatOpenQRConnectApiRefreshTokenResponse result = Json.Deserialize<WechatOpenQRConnectApiRefreshTokenResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse RefreshTokenRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/sns/oauth2/refresh_token", query, "", WechatCredentialKind.None);
    }

    async WechatOpenQRConnectApiGetUserInfoResponse GetUserInfoAsync(WechatOpenQRConnectApiGetUserInfoRequest request) {
        if (request == null) { request = new WechatOpenQRConnectApiGetUserInfoRequest(); }
        WechatResponse raw = await this.client.RequestAsync("GET", "/sns/userinfo", request.QueryText(), "", WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenQRConnectApiGetUserInfoResponse result = Json.Deserialize<WechatOpenQRConnectApiGetUserInfoResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GetUserInfoRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/sns/userinfo", query, "", WechatCredentialKind.AuthorizerAccessToken);
    }

    async WechatOpenQRConnectApiAuthResponse AuthAsync(WechatOpenQRConnectApiAuthRequest request) {
        if (request == null) { request = new WechatOpenQRConnectApiAuthRequest(); }
        WechatResponse raw = await this.client.RequestAsync("GET", "/sns/auth", request.QueryText(), "", WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenQRConnectApiAuthResponse result = Json.Deserialize<WechatOpenQRConnectApiAuthResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse AuthRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/sns/auth", query, "", WechatCredentialKind.AuthorizerAccessToken);
    }

}
