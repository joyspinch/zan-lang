using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenSetWebViewDomainApi {
    WechatOpenClient client;

    public WechatOpenSetWebViewDomainApi(WechatOpenClient client) {
        this.client = client;
    }

    public async WechatOpenSetWebViewDomainApiSetWebViewDomainResponse SetWebViewDomainAsync(WechatOpenSetWebViewDomainApiSetWebViewDomainRequest request) {
        if (request == null) { request = new WechatOpenSetWebViewDomainApiSetWebViewDomainRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/wxa/setwebviewdomain", request.QueryText(), request.JsonBody(), WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenSetWebViewDomainApiSetWebViewDomainResponse result = Json.Deserialize<WechatOpenSetWebViewDomainApiSetWebViewDomainResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse SetWebViewDomainRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/setwebviewdomain", query, jsonBody, WechatCredentialKind.AuthorizerAccessToken);
    }

}
