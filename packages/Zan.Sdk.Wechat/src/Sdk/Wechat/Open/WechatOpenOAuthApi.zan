using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenOAuthApi {
    WechatOpenClient client;

    public WechatOpenOAuthApi(WechatOpenClient client) {
        this.client = client;
    }

    public async WechatOpenOAuthApiGetAccessTokenResponse GetAccessTokenAsync(WechatOpenOAuthApiGetAccessTokenRequest request) {
        if (request == null) { request = new WechatOpenOAuthApiGetAccessTokenRequest(); }
        WechatResponse raw = await this.client.RequestAsync("GET", "/sns/oauth2/component/access_token", request.QueryText(), "", WechatCredentialKind.ComponentAccessToken);
        WechatOpenOAuthApiGetAccessTokenResponse result = Json.Deserialize<WechatOpenOAuthApiGetAccessTokenResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse GetAccessTokenRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/sns/oauth2/component/access_token", query, "", WechatCredentialKind.ComponentAccessToken);
    }

    public async WechatOpenOAuthApiRefreshTokenResponse RefreshTokenAsync(WechatOpenOAuthApiRefreshTokenRequest request) {
        if (request == null) { request = new WechatOpenOAuthApiRefreshTokenRequest(); }
        WechatResponse raw = await this.client.RequestAsync("GET", "/sns/oauth2/component/refresh_token", request.QueryText(), "", WechatCredentialKind.ComponentAccessToken);
        WechatOpenOAuthApiRefreshTokenResponse result = Json.Deserialize<WechatOpenOAuthApiRefreshTokenResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse RefreshTokenRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/sns/oauth2/component/refresh_token", query, "", WechatCredentialKind.ComponentAccessToken);
    }

    public async WechatOpenOAuthApiGetUserInfoResponse GetUserInfoAsync(WechatOpenOAuthApiGetUserInfoRequest request) {
        if (request == null) { request = new WechatOpenOAuthApiGetUserInfoRequest(); }
        WechatResponse raw = await this.client.RequestAsync("GET", "/sns/userinfo", request.QueryText(), "", WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenOAuthApiGetUserInfoResponse result = Json.Deserialize<WechatOpenOAuthApiGetUserInfoResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse GetUserInfoRawAsync(string query) {
        return await this.client.RequestAsync("GET", "/sns/userinfo", query, "", WechatCredentialKind.AuthorizerAccessToken);
    }

}
