using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenOpenApi {
    WechatOpenClient client;

    public WechatOpenOpenApi(WechatOpenClient client) {
        this.client = client;
    }

    async WechatOpenOpenApiCreateResponse CreateAsync(WechatOpenOpenApiCreateRequest request) {
        if (request == null) { request = new WechatOpenOpenApiCreateRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/open/create", request.QueryText(), request.JsonBody(), WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenOpenApiCreateResponse result = Json.Deserialize<WechatOpenOpenApiCreateResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse CreateRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/open/create", query, jsonBody, WechatCredentialKind.AuthorizerAccessToken);
    }

    async WechatOpenOpenApiBindResponse BindAsync(WechatOpenOpenApiBindRequest request) {
        if (request == null) { request = new WechatOpenOpenApiBindRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/open/bind", request.QueryText(), request.JsonBody(), WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenOpenApiBindResponse result = Json.Deserialize<WechatOpenOpenApiBindResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse BindRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/open/bind", query, jsonBody, WechatCredentialKind.AuthorizerAccessToken);
    }

    async WechatOpenOpenApiUnbindResponse UnbindAsync(WechatOpenOpenApiUnbindRequest request) {
        if (request == null) { request = new WechatOpenOpenApiUnbindRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/open/unbind", request.QueryText(), request.JsonBody(), WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenOpenApiUnbindResponse result = Json.Deserialize<WechatOpenOpenApiUnbindResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse UnbindRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/open/unbind", query, jsonBody, WechatCredentialKind.AuthorizerAccessToken);
    }

    async WechatOpenOpenApiGetResponse GetAsync(WechatOpenOpenApiGetRequest request) {
        if (request == null) { request = new WechatOpenOpenApiGetRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/open/get", request.QueryText(), request.JsonBody(), WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenOpenApiGetResponse result = Json.Deserialize<WechatOpenOpenApiGetResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GetRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/open/get", query, jsonBody, WechatCredentialKind.AuthorizerAccessToken);
    }

}
