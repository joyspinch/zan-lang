using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Open;

namespace Sdk.Wechat.Open;

public class WechatOpenModifyDomainApi {
    WechatOpenClient client;

    public WechatOpenModifyDomainApi(WechatOpenClient client) {
        this.client = client;
    }

    public async WechatOpenModifyDomainApiModifyDomainResponse ModifyDomainAsync(WechatOpenModifyDomainApiModifyDomainRequest request) {
        if (request == null) { request = new WechatOpenModifyDomainApiModifyDomainRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/wxa/modify_domain", request.QueryText(), request.JsonBody(), WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenModifyDomainApiModifyDomainResponse result = Json.Deserialize<WechatOpenModifyDomainApiModifyDomainResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    public async WechatResponse ModifyDomainRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/modify_domain", query, jsonBody, WechatCredentialKind.AuthorizerAccessToken);
    }

}
