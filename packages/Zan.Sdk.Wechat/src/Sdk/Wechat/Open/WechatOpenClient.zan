using System;
using System.Net.External;
using Sdk.Wechat;

namespace Sdk.Wechat.Open;

// 微信开放平台 JSON API 客户端。开放平台 token 的取得依赖 verify_ticket、
// authorizer refresh token 等业务状态，因此由调用方注入，不在传输层伪造。
public class WechatOpenClient {
    WechatApiTransport transport;
    string componentAccessToken;
    string authorizerAccessToken;

    public WechatOpenClient() {
        this.transport = new WechatApiTransport("api.weixin.qq.com");
        this.componentAccessToken = "";
        this.authorizerAccessToken = "";
    }

    public WechatOpenClient Server(string host, int port) {
        this.transport.Server(host, port);
        return this;
    }

    public WechatOpenClient PlainHttpMode() {
        this.transport.PlainHttpMode();
        return this;
    }

    public WechatOpenClient Timeout(int ms) {
        this.transport.Timeout(ms);
        return this;
    }

    public WechatOpenClient SetCallPolicy(ExternalCallPolicy policy) {
        this.transport.SetCallPolicy(policy);
        return this;
    }

    public ExternalCallPolicy CallPolicy() {
        return this.transport.CallPolicy();
    }

    public WechatOpenClient SetComponentAccessToken(string token) {
        this.componentAccessToken = token;
        return this;
    }

    public WechatOpenClient SetAuthorizerAccessToken(string token) {
        this.authorizerAccessToken = token;
        return this;
    }

    // SetAuthorizerAccessToken 的通用别名，也可注入 OAuth access_token。
    public WechatOpenClient SetAccessToken(string token) {
        this.authorizerAccessToken = token;
        return this;
    }

    private string Credential(WechatCredentialKind kind) {
        if (kind == WechatCredentialKind.None) { return ""; }
        if (kind == WechatCredentialKind.ComponentAccessToken) {
            if (this.componentAccessToken.Length == 0) {
                throw new WechatException("open.tokenMissing", "请先设置 component_access_token", "");
            }
            return this.componentAccessToken;
        }
        if (kind == WechatCredentialKind.AuthorizerAccessToken
            || kind == WechatCredentialKind.AccessToken) {
            if (this.authorizerAccessToken.Length == 0) {
                throw new WechatException("open.tokenMissing", "请先设置 authorizer access_token", "");
            }
            return this.authorizerAccessToken;
        }
        throw new WechatException("open.tokenUnsupported", "当前客户端不支持此凭证类型", "");
    }

    private string BuildTarget(string path, string query, WechatCredentialKind credential) {
        return WechatApiTransport.BuildTarget(path, query, credential, this.Credential(credential));
    }

    public async WechatResponse RequestAsync(string method, string path, string query,
                                             string jsonBody, WechatCredentialKind credential) {
        return await this.transport.RequestJsonAsync(
            method, this.BuildTarget(path, query, credential), jsonBody);
    }

    public async WechatRawResponse RequestRawAsync(string method, string path,
                                                   string query, string body,
                                                   string contentType,
                                                   WechatCredentialKind credential) {
        return await this.transport.RequestRawAsync(
            method, this.BuildTarget(path, query, credential), body, contentType, null);
    }

    public async WechatRawResponse RequestMultipartAsync(string method, string path,
                                                         string query,
                                                         WechatMultipart multipart,
                                                         WechatCredentialKind credential) {
        return await this.transport.RequestMultipartAsync(
            method, this.BuildTarget(path, query, credential), multipart);
    }

    public async WechatResponse UploadJsonAsync(string path, string query,
                                                WechatMultipart multipart,
                                                WechatCredentialKind credential) {
        return await this.transport.UploadJsonAsync(
            this.BuildTarget(path, query, credential), multipart);
    }
}
