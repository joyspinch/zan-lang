using System;

namespace Sdk.Wechat;

/// <summary>内部认证策略，由生成的端点元数据选择。</summary>
enum WechatCredentialKind {
    None,
    AccessToken,
    ProviderAccessToken,
    SuiteAccessToken,
    ComponentAccessToken,
    AuthorizerAccessToken
}

class WechatCredential {
    static string QueryName(WechatCredentialKind kind) {
        if (kind == WechatCredentialKind.AccessToken
            || kind == WechatCredentialKind.AuthorizerAccessToken) {
            return "access_token";
        }
        if (kind == WechatCredentialKind.ProviderAccessToken) {
            return "provider_access_token";
        }
        if (kind == WechatCredentialKind.SuiteAccessToken) {
            return "suite_access_token";
        }
        if (kind == WechatCredentialKind.ComponentAccessToken) {
            return "component_access_token";
        }
        return "";
    }
}
