using System;

namespace Sdk.Wechat;

// 微信 API 调用异常（Code 为微信 errcode 或 client.* 本地错误码）。
public class WechatException : Exception {
    public string Code;
    public string Body;

    public WechatException(string code, string message, string body) {
        this.Code = code;
        this.Body = body;
        Message = code + ": " + message;
    }
}
