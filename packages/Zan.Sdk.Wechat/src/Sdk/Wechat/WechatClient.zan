using System;
using System.Text;
using System.Net.External;
using System.Net.Tls;

namespace Sdk.Wechat;

// 微信公众号（MP）客户端；access_token 实例内缓存（提前 300 秒刷新），失败一律抛 WechatException。
public class WechatClient {
    static string DEFAULT_HOST = "api.weixin.qq.com";

    WechatApiTransport transport;
    WechatTokenCache tokenCache;
    string appId;
    string appSecret;

    public WechatClient(string appId, string appSecret) {
        this.appId = appId;
        this.appSecret = appSecret;
        this.transport = new WechatApiTransport(DEFAULT_HOST);
        this.tokenCache = new WechatTokenCache();
    }

    public WechatClient Server(string host, int port) {
        this.transport.Server(host, port);
        return this;
    }

    public WechatClient PlainHttpMode() {
        this.transport.PlainHttpMode();
        return this;
    }

    public WechatClient Timeout(int ms) {
        this.transport.Timeout(ms);
        return this;
    }

    public WechatClient SetCallPolicy(ExternalCallPolicy policy) {
        this.transport.SetCallPolicy(policy);
        return this;
    }

    public ExternalCallPolicy CallPolicy() {
        return this.transport.CallPolicy();
    }

    public WechatClient PinPublicKey(string spkiSha256Base64) {
        this.transport.PinPublicKey(spkiSha256Base64);
        return this;
    }

    public WechatClient SetCertPolicy(CertPolicyFn fn) {
        this.transport.SetCertPolicy(fn);
        return this;
    }

    // 手动注入外部缓存的 access_token；内部自动扣减 300 秒提前刷新。
    public WechatClient SetAccessToken(string token, int expiresIn) {
        this.tokenCache.Set(token, expiresIn);
        return this;
    }

    public async string GetAccessTokenAsync() {
        string cached = this.tokenCache.Current();
        if (cached.Length > 0) { return cached; }
        if (this.appId.Length == 0 || this.appSecret.Length == 0) {
            throw new WechatException("client.paramError", "appId / appSecret 不能为空", "");
        }
        string path = "/cgi-bin/token?grant_type=client_credential"
            + "&appid=" + Encoding.UrlEncode(this.appId)
            + "&secret=" + Encoding.UrlEncode(this.appSecret);
        return await this.tokenCache.GetOrFetchAsync(this.transport, path, "client");
    }

    private async string CredentialAsync(WechatCredentialKind kind) {
        if (kind == WechatCredentialKind.None) { return ""; }
        if (kind == WechatCredentialKind.AccessToken) {
            return await this.GetAccessTokenAsync();
        }
        throw new WechatException("client.tokenUnsupported",
            "公众号客户端只支持 access token", "");
    }

    private async string BuildTargetAsync(string path, string query, WechatCredentialKind credential) {
        string token = await this.CredentialAsync(credential);
        return WechatApiTransport.BuildTarget(path, query, credential, token);
    }

    // 供 Mp 模块直连的统一 JSON 请求入口（自动附加 access_token）。
    public async WechatResponse RequestAsync(string method, string path, string query, string jsonBody) {
        string target = await this.BuildTargetAsync(path, query, WechatCredentialKind.AccessToken);
        return await this.transport.RequestJsonAsync(method, target, jsonBody);
    }

    public async WechatRawResponse RequestRawAsync(string method, string path,
                                             string query, string body,
                                             string contentType,
                                             WechatCredentialKind credential) {
        string target = await this.BuildTargetAsync(path, query, credential);
        return await this.transport.RequestRawAsync(method, target, body, contentType, null);
    }

    public async WechatRawResponse RequestMultipartAsync(string method, string path,
                                                   string query,
                                                   WechatMultipart multipart,
                                                   WechatCredentialKind credential) {
        string target = await this.BuildTargetAsync(path, query, credential);
        return await this.transport.RequestMultipartAsync(method, target, multipart);
    }

    public async WechatResponse UploadJsonAsync(string path, string query,
                                                WechatMultipart multipart,
                                                WechatCredentialKind credential) {
        string target = await this.BuildTargetAsync(path, query, credential);
        return await this.transport.UploadJsonAsync(target, multipart);
    }

    // ---- 网页 OAuth（使用用户授权 code/oauth token，不走公众号实例 tokenCache） ----

    public async WechatResponse OAuthAccessTokenAsync(string code) {
        if (code.Length == 0) {
            throw new WechatException("client.paramError", "code 不能为空", "");
        }
        string path = "/sns/oauth2/access_token?appid=" + Encoding.UrlEncode(this.appId)
            + "&secret=" + Encoding.UrlEncode(this.appSecret)
            + "&code=" + Encoding.UrlEncode(code)
            + "&grant_type=authorization_code";
        return await this.transport.RequestJsonAsync("GET", path, "");
    }

    public async WechatResponse OAuthRefreshTokenAsync(string refreshToken) {
        if (refreshToken.Length == 0) {
            throw new WechatException("client.paramError", "refreshToken 不能为空", "");
        }
        string path = "/sns/oauth2/refresh_token?appid=" + Encoding.UrlEncode(this.appId)
            + "&grant_type=refresh_token"
            + "&refresh_token=" + Encoding.UrlEncode(refreshToken);
        return await this.transport.RequestJsonAsync("GET", path, "");
    }

    public async WechatResponse OAuthUserInfoAsync(string oauthAccessToken, string openId, string lang) {
        if (oauthAccessToken.Length == 0 || openId.Length == 0) {
            throw new WechatException("client.paramError", "oauthAccessToken / openId 不能为空", "");
        }
        string l = lang.Length == 0 ? "zh_CN" : lang;
        string path = "/sns/userinfo?openid=" + Encoding.UrlEncode(openId)
            + "&lang=" + Encoding.UrlEncode(l);
        path = WechatApiTransport.AppendQuery(path,
            WechatCredential.QueryName(WechatCredentialKind.AccessToken),
            oauthAccessToken);
        return await this.transport.RequestJsonAsync("GET", path, "");
    }

    public string BuildOAuthUrl(string redirectUri, string scope, string state) {
        string s = scope.Length == 0 ? "snsapi_base" : scope;
        return "https://open.weixin.qq.com/connect/oauth2/authorize?appid="
            + Encoding.UrlEncode(this.appId)
            + "&redirect_uri=" + Encoding.UrlEncode(redirectUri)
            + "&response_type=code&scope=" + Encoding.UrlEncode(s)
            + "&state=" + Encoding.UrlEncode(state)
            + "#wechat_redirect";
    }
}
