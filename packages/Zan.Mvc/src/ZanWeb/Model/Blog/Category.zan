using System.Data.Orm;

namespace ZanWeb.Model.Blog;

/* 博客栏目；文章存 id，公开 URL 用 slug，改名不破坏链接。 */
[Table(Name = "blog_category")]
class Category {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 64, IsNullable = false)]
    string name;

    [Column(StringLength = 64, IsNullable = false)]
    string slug;

    [Column(StringLength = 255)]
    string description;

    int sortOrder;
    int status;
    long createdAt;
}