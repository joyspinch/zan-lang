using System;
using System.Data;

namespace ZanWeb.Core;

/* worker 数据库访问：连接池 + 借用协议。main.zan 一次性构建池并注入。请求借出连接执行语句，finally 中归还。全部走 *Async 端点以挂起协程。忘记 Release() 会耗尽池，故 finally 不可省略。*/
class DbContext {
    DbPool pool;
    DbPool readPool;

    DbContext(DbPool pool) {
        this.pool = pool;
        this.readPool = pool;
    }

    DbContext(DbPool writePool, DbPool readPool) {
        this.pool = writePool;
        this.readPool = (readPool != null) ? readPool : writePool;
    }

    /* 包装启动引导创建的池（默认模式，读写复用同一主库池）。*/
    static DbContext Of(DbPool pool) {
        return new DbContext(pool);
    }

    /* 包装读写分离连接池：若 readPool 为 null 自动无缝回退复用主库池。*/
    static DbContext Of(DbPool writePool, DbPool readPool) {
        return new DbContext(writePool, readPool);
    }

    /* 借出主库连接供请求使用（写/事务）；池满时挂起协程。*/
    async IDbConnection Acquire() {
        if (this.pool == null) { return null; }
        IDbConnection db = await this.pool.AcquireAsync();
        if (db == null || !db.IsConnected()) {
            this.pool.Release(db);
            return null;
        }
        /* 所有应用语句在此被借用，故在此计时：每个借用点一个包装器，避免每个 DAO 都放秒表。Metrics.db 使用独立池，不会自跟踪。*/
        return TracedDbConnection.Wrap(db);
    }

    /* 归还主库连接到池，兼容 null，可直接放入 finally。*/
    void Release(IDbConnection db) {
        if (this.pool == null || db == null) { return; }
        /* 归还的是底层池连接，而非请求拿到的计时包装器。*/
        this.pool.Release(TracedDbConnection.Unwrap(db));
    }

    /* 借出只读连接（未配置从库时自动借主库，配置从库时借从库）；池满时挂起协程。*/
    async IDbConnection AcquireRead() {
        DbPool target = (this.readPool != null) ? this.readPool : this.pool;
        if (target == null) { return null; }
        IDbConnection db = await target.AcquireAsync();
        if (db == null || !db.IsConnected()) {
            target.Release(db);
            return null;
        }
        return TracedDbConnection.Wrap(db);
    }

    /* 归还只读连接到对应的池。*/
    void ReleaseRead(IDbConnection db) {
        if (db == null) { return; }
        DbPool target = (this.readPool != null) ? this.readPool : this.pool;
        if (target == null) { return; }
        target.Release(TracedDbConnection.Unwrap(db));
    }

    /* 是否启用了独立的只读从库池。*/
    bool HasSeparateReadPool() {
        return this.readPool != null && this.readPool != this.pool;
    }

    /* 启动时提前建连（服务器接受请求之前），返回当前主库空闲数；0 表示数据库不可达。*/
    async int Warmup(int count) {
        int w = 0;
        if (this.pool != null) {
            w = await this.pool.WarmupAsync(count);
        }
        if (this.HasSeparateReadPool()) {
            await this.readPool.WarmupAsync(count);
        }
        return w;
    }

    int IdleCount() {
        if (this.pool == null) { return 0; }
        return this.pool.IdleCount();
    }

    int LiveCount() {
        if (this.pool == null) { return 0; }
        return this.pool.LiveCount();
    }

    int WaitingCount() {
        if (this.pool == null) { return 0; }
        return this.pool.WaitingCount();
    }

    void Close() {
        if (this.pool != null) { this.pool.Close(); }
        if (this.HasSeparateReadPool()) { this.readPool.Close(); }
    }
}
