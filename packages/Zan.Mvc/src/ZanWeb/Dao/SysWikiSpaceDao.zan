using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model;
using ZanWeb.Web;

namespace ZanWeb.Dao;

/* wiki_space 的数据读写网关 */
class SysWikiSpaceDao {
    IDbConnection db;

    SysWikiSpaceDao(AppController host) {
        /* 请求作用域：连接取宿主控制器的请求租约——事务与只读从库口径一致。 */
        this.db = host.__Conn();
    }

    /* 非请求场景（种子、后台任务）显式给连接。 */
    SysWikiSpaceDao(IDbConnection db) {
        this.db = db;
    }

    async SysWikiSpace ById(int id) {
        return await this.db.Select<SysWikiSpace>().Where(a => a.id == id).FirstAsync();
    }

    async List<SysWikiSpace> All() {
        return await this.db.Select<SysWikiSpace>().OrderBy(a => a.sortOrder).ToListAsync();
    }

    async int Insert(SysWikiSpace space) {
        return await this.db.Insert<SysWikiSpace>(space).ExecuteIdentityAsync();
    }

    async int Update(SysWikiSpace space) {
        return await this.db.Update<SysWikiSpace>()
            .Set(a => a.name, space.name)
            .Set(a => a.description, space.description)
            .Set(a => a.icon, space.icon)
            .Set(a => a.departmentId, space.departmentId)
            .Set(a => a.sortOrder, space.sortOrder)
            .Set(a => a.status, space.status)
            .Where(a => a.id == space.id)
            .ExecuteAffrowsAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<SysWikiSpace>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
