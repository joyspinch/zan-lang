using System;
using System.Data;
using System.Diagnostics;
using System.Text;
using System.Web;
using ZanWeb.Security;
using ZanWeb.Services;
using ZanWeb.Web;

namespace ZanWeb.Core;

/* 项目侧路由注册委托：__AttrRoutes 是编译期按本项目控制器属性生成的类，
   只存在于应用内，框架经此挂点执行注册而不感知具体路由表。 */
delegate void RouteFn(WebApp app);

/* ZanWeb 应用引导：配置、日志、连接池、缓存、Schema 迁移、WebApp 装配、
   中间件、指标、集群总线、任务调度、路由授权、接口文档与服务器生命周期
   全部在此收口。应用侧 main.zan 只做三件事：声明业务菜单分组、注册路由
   表挂点与业务种子挂点，然后 await Boot.Run()。框架升级 = 包升级，应用
   组合根不随之变动。 */
class Boot {
    /* 应用侧经 Boot.OnRoutes 注册的路由表执行入口。 */
    static RouteFn routes;

    /* 慢请求阈值(ms)，启动时从 [log].slowMs 读取 */
    static int slowMs = 1000;
    /* 慢 SQL 阈值(微秒)，启动时从 [log].slowSqlMs 换算 */
    static long slowSqlUs = 200000;

    /* 注册路由表挂点。应用侧传编译期生成的 __AttrRoutes.Register：
       Boot.OnRoutes(Program.RegisterRoutes); */
    static void OnRoutes(RouteFn fn) {
        routes = fn;
    }

    /* 引导并运行服务器；返回值即进程退出码（start/stop/restart 命令语义）。 */
    static async int Run() {
        /* 进程需位于发布目录，按相对路径读取 config/views/wwwroot/数据库 */
        bool _cd = ProcessHost.UseAppDir("config/app.json");
        Cfg.Load("config/app.json");

        /* 日志优先写入文件，worker 进程可能没有控制台 */
        if (Cfg.Log.dir.Length > 0) {
            int level = Log.INFO;
            if (Cfg.Log.debug) { level = Log.DEBUG; }
            Log.Configure(Cfg.Log.dir, Cfg.Log.pattern, level);
            /* worker 的 stdout 已重定向到日志文件，不重复输出到控制台 */
            Log.EchoToConsole(Cfg.Log.debug);
        }

        /* 依赖注入：每个 worker 进程独立构建连接池和缓存，支持读写分离从库 */
        DbPool pool = Db.OpenPool();
        DbPool readPool = Db.OpenReadOnlyPool();
        DbContext db = (readPool != null) ? DbContext.Of(pool, readPool) : DbContext.Of(pool);
        CacheContext cache = CacheContext.Of(Db.OpenRedis());
        AppServices services = new AppServices(db, cache);
        AppServices.Use(services);

        /* 预开两个连接，避免首请求支付连接开销 */
        int idle = await db.Warmup(2);
        Console.WriteLine("[db] " + Cfg.Db.driver + " pool size="
            + Convert.ToString(Cfg.Db.poolSize) + " idle=" + Convert.ToString(idle));
        if (Cfg.Cache.driver == "redis") {
            bool up = await cache.Warmup();
            if (up) {
                Console.WriteLine("[cache] redis "
                    + Cfg.Cache.redisHost + ":" + Convert.ToString(Cfg.Cache.redisPort)
                    + " (shared across workers)");
            } else {
                Console.WriteLine("[cache] redis unreachable -- reads miss,"
                    + " writes are dropped, handlers fall back to the database");
            }
        } else {
            Console.WriteLine("[cache] worker-local memory"
                + " -- correct only while [worker].count is 1");
        }

        /* 启动时执行一次 Schema 迁移和数据初始化。数据库常常晚于应用
           就绪（容器编排的常见次序），给三次短重试再定论；仍失败则
           记账后继续启动——进程活着、日志可查、数据面如实 503，运维
           按日志处置，而不是无诊断的黑屏崩溃。 */
        bool ready = false;
        for (int attempt = 1; attempt <= 3 && !ready; attempt = attempt + 1) {
            ready = await Schema.Ensure(db);
            if (!ready) {
                Log.Error("[db] schema not applied (attempt "
                    + Convert.ToString(attempt) + "/3) -- check database"
                    + " connectivity and the migration log");
                Console.WriteLine("[db] schema not applied (attempt "
                    + Convert.ToString(attempt) + "/3) -- retrying in 5s");
                await Task.Delay(5000);
            }
        }
        if (!ready) {
            Log.Error("[db] schema unavailable after retries -- requests"
                + " will fail until the database is reachable and the"
                + " process is restarted");
            Console.WriteLine("[db] schema unavailable after retries --"
                + " see error log");
        }

        WebApp app = new WebApp(Cfg.Server.host, Cfg.Server.port);
        app.MaxBody(Cfg.Server.maxBodyMB * 1024 * 1024);
        /* 上传上限独立于请求体上限：流式上传不占内存，可以给得宽裕 */
        app.MaxUpload(Cfg.Server.uploadBodyMB * 1024 * 1024);
        app.GlobalLimit(Cfg.Server.globalLimitPerSec);
        WebHost.Use(app);
        app.AuthResolver(AuthToken.Resolve);
        app.PermissionResolver(AuthUser.Allow);
        app.LoginPath(Routes.Login);
        /* 全站安全响应头，放在一切可能短路应答的中间件之前，让 403/204
           也带着这些头出门。 */
        app.Before(SecurityHeaders);
        /* Cookie 写入必须有同源证据；不要求无 cookie 的 API 客户端
           伪造浏览器头。double-submit CSRF 默认关闭——框架页面/脚本
           尚未产出 _csrf 字段与 X-CSRF-Token 头，默认打开 = 全站表单
           403；应用页面按 Csrf 类注释配齐 token 回显后，在 main.zan
           调 Boot.EnableCsrf() 一行开启。 */
        app.Before(OriginGuard);
        if (csrfEnabled) {
            app.Before(CsrfGuard);
        }
        /* 运行模式判断：mode=api 时跳过 HTML 视图载入与静态目录挂载（纯 API 轻量模式） */
        if (Cfg.Server.mode != "api") {
            /* 视图从磁盘读取一次，之后从内存渲染 */
            app.Views("views");

            /* 静态文件挂载：仅 wwwroot/ 可被外部访问。资产无版本号指纹，
               故浏览器缓存只保留一小时；改版后一小时内或强制刷新生效。 */
            StaticFiles.MaxAge(3600);
            StaticFiles.Mount(app, "/static", "wwwroot");
        } else {
            Console.WriteLine("[server] mode=api (headless): views and static assets bypassed");
        }

        /* 跨域资源共享（CORS）与预检阻断 */
        if (Cfg.Cors.enabled) {
            app.Before(CorsFilter);
            /* CORS 放行的具体 Origin 同样允许发起 WS 升级；"*" 不登记
               （带 cookie 的升级不适用通配凭据语义）。 */
            if (Cfg.Cors.allowOrigin != "*") {
                WebWs.AllowOrigin(Cfg.Cors.allowOrigin);
            }
        }

        /* 生命周期钩子 */
        if (Cfg.Log.access) {
            app.Before(AccessLog);
        }
        slowMs = Cfg.Log.slowMs;
        slowSqlUs = (long)Cfg.Log.slowSqlMs * 1000;
        app.After(Metrics);
        ServerMetrics.Global().SlowQueryMs(Cfg.Log.slowSqlMs);
        DbTrace.Sink(SqlTrace);
        ServerMetrics.Global()
            .ErrorLog(Cfg.Log.errorLog, Cfg.Log.debug)
            .OnError(MetricsStore.Failed);

        /* 指标历史写入独立数据库，由后台协程定期刷新 */
        bool hist = await MetricsStore.Start();
        if (hist) {
            Console.WriteLine("[metrics] history " + Cfg.Metrics.path
                + " flush=" + Convert.ToString(Cfg.Metrics.flushSeconds) + "s");
            /* 停机最后一冲：Worker 排空完成后、退出前把残余窗口落库。 */
            Worker.OnShutdown(MetricsStore.FlushAtExit);
        }

        /* 跨物理节点状态总线：默认关闭（保持单机高性能共享内存），配置集群时通过 Redis Pub/Sub 同步失效事件 */
        if (Cfg.Cluster.enabled) {
            if (Cfg.Cache.driver == "redis") {
                ClusterBus.Init(Cfg.Cluster, Db.OpenRedis());
                ClusterBus.Start();
                Console.WriteLine("[cluster] Redis Pub/Sub bus armed on channel "
                    + Cfg.Cluster.channel);
            } else {
                Console.WriteLine("[cluster] cluster.enabled is true but cache.driver is not redis"
                    + " -- cluster bus disabled, state will remain local");
            }
        }

        /* 定时任务调度：每 worker 一条循环，到点经数据库乐观锁抢单，
           多 worker 不重复执行；数据库未就绪时空转重试。受 [job].enabled 开关控制。 */
        if (Cfg.Job.enabled) {
            JobHost.Arm();
        } else {
            Console.WriteLine("[job] disabled by config");
        }

        /* 路由：编译期从控制器属性生成，运行时只执行注册（挂点由应用侧注册） */
        if (routes != null) {
            routes(app);
        }

        /* 权限索引：从路由表建立 screen->bit 映射 */
        Perm.Index(app);

        if (ready) {
            /* 内置角色同步路由授权，然后移入共享内存（匿名表，master 建、worker 继承） */
            bool grantsReady = await Schema.SyncRoleGrants(app);
            if (!grantsReady) {
                Console.WriteLine("[rbac] role grants not synchronized"
                    + " -- check database connectivity and schema");
            }
            if (!PermTable.Open()) {
                Console.WriteLine("[rbac] shared memory unavailable");
            }
            IDbConnection rbac = await AppServices.Current().Db().Acquire();
            if (rbac != null) {
                await PermTable.LoadRoles(rbac);
                AppServices.Current().Db().Release(rbac);
            }
        }

        /* API 文档：从属性生成，挂载到 /api/docs */
        ApiDocs.Title(Cfg.Server.name);
        ApiDocs.MountSpec(app, "/api/docs");

        /* RunCommand 的返回不是 worker 停服边界：start 的 master/worker 在
           Worker 内直接 exit；stop/reload/status 返回的只是命令发送进程，
           reload 应答时旧 worker 仍可能处理请求。不要在这里或 finally 中
           关闭池/缓存或重置静态服务；真正清理须由 Worker 排空请求后的可等待
           钩子触发，并先停止、等待 job/metrics/cluster 后台任务再关依赖。 */
        int r = await WebServer.RunCommand(app, Cfg.Worker.count,
            Cfg.Worker.daemon);
        return r;
    }

    /* double-submit CSRF 默认关闭（见 Run 内注释）。 */
    static bool csrfEnabled = false;

    /// <summary>一行开启 double-submit CSRF（须在 Boot.Run() 之前调用）。
    /// 只拦浏览器形态的请求（携带 zsession/csrf cookie 的不安全方法）；
    /// bearer 与无 cookie 的 API 客户端没有可被跨站滥用的环境凭证，
    /// 不拦。开启后应用页面的表单须带 _csrf 隐藏域、ajax 须回显
    /// X-CSRF-Token（Csrf 类注释），否则这些请求会被 403。</summary>
    static void EnableCsrf() {
        csrfEnabled = true;
    }

    /// double-submit 闸的浏览器形态过滤：真闸在 Csrf.Guard。
    static bool CsrfGuard(HttpContext ctx) {
        bool safe = ctx.method == "GET" || ctx.method == "HEAD"
            || ctx.method == "OPTIONS";
        if (!safe) {
            bool bearer = ctx.Header("Authorization").StartsWith("Bearer ");
            bool browser = ctx.Cookie("zsession").Length > 0
                || ctx.Cookie("csrf_token").Length > 0;
            if (bearer || !browser) { return true; }
        }
        return Csrf.Guard(ctx);
    }

    /* 全站安全响应头：nosniff 关 MIME 嗅探；DENY 禁被嵌（管理台弹窗走
       ajax 注入，无 iframe 需求）；Referrer-Policy 收敛外链引泄。CSP
       由 [security].csp 门控（默认关）：框架视图与生成器已去内联
       （内联 style=、内联 script、javascript: 伪协议清零——th 列宽走
       遗留 width 属性、tab 条 href="#"、页脚本外链到 /static/js/ 下的独立文件，
       页面资源纯自托管无外链），应用自有视图未清扫时开启会破页。img
       放行 data:（内联图标/占位）；form-action 不设——登录表单本就
       允许同源提交，跨站由 Csrf.Guard 把守。 */
    static bool SecurityHeaders(HttpContext ctx) {
        ctx.SetHeader("X-Content-Type-Options", "nosniff");
        ctx.SetHeader("X-Frame-Options", "DENY");
        ctx.SetHeader("Referrer-Policy", "no-referrer");
        if (Cfg.Security.csp) {
            ctx.SetHeader("Content-Security-Policy",
                "default-src 'self'; img-src 'self' data:; base-uri 'self'");
        }
        return true;
    }

    /* 慢 SQL 追踪：记录归一化语句、归档到 metrics.db、超过阈值时写日志 */
    static void SqlTrace(string sql, long us) {
        ServerMetrics.Global().RecordQuery(sql, us);
        string norm = ServerMetrics.NormalizeSql(sql);
        /* 与 metrics_sql_day.sql 的 StringLength 一致；截得更短会砍掉宽表
           语句的 WHERE/LIMIT 尾巴，统计屏读不出语句形状。 */
        if (norm.Length > 400) { norm = norm.Substring(0, 400); }
        bool slow = us >= slowSqlUs;
        MetricsStore.RecordSql(norm, us, slow);
        if (slow) {
            Log.Warn("[slow-sql] " + Convert.ToString(us) + "us " + norm);
        }
    }

    /* Cookie writes need browser-origin evidence; bearer and cookie-free API
       clients do not rely on ambient credentials and need no browser headers. */
    static bool OriginGuard(HttpContext ctx) {
        if (ctx.method == "GET" || ctx.method == "HEAD" || ctx.method == "OPTIONS") {
            return true;
        }
        string origin = ctx.Header("Origin");
        bool bearer = ctx.Header("Authorization").StartsWith("Bearer ");
        bool cookie = !bearer && ctx.Cookie("zsession").Length > 0;
        if (!cookie) {
            if (origin.Length > 0 && Cfg.Cors.enabled && ValidCorsOrigin()
                    && (origin == Cfg.Cors.allowOrigin
                        || (bearer && Cfg.Cors.allowOrigin == "*"
                            && HttpOrigin(origin) == origin))) {
                return true;
            }
            return Csrf.OriginGuard(ctx);
        }
        string site = ctx.Header("Sec-Fetch-Site");
        bool same = site != "cross-site";
        if (origin.Length > 0) {
            same = same && HttpOrigin(origin) == origin
                && SameOriginHost(origin, ctx.Header("Host"));
        } else {
            string referer = ctx.Header("Referer");
            if (referer.Length > 0) {
                string refOrigin = HttpOrigin(referer);
                same = same && refOrigin.Length > 0
                    && SameOriginHost(refOrigin, ctx.Header("Host"));
            } else {
                same = same && site == "same-origin";
            }
        }
        if (same) { return true; }
        ctx.Status(403, "Forbidden");
        ctx.Text("request origin missing or invalid");
        return false;
    }

    /* HTTP(S) origin only, rejecting opaque origins, userinfo and delimiters
       rather than sanitizing attacker input into a different authority. */
    static string HttpOrigin(string url) {
        int start = 0;
        if (url.StartsWith("https://")) { start = 8; }
        else if (url.StartsWith("http://")) { start = 7; }
        else { return ""; }
        for (int i = 0; i < url.Length; i = i + 1) {
            int c = url[i] & 255;
            if (c <= 32 || c == 127 || c == 92) { return ""; }
        }
        int end = url.Length;
        int slash = url.IndexOf("/", start);
        int query = url.IndexOf("?", start);
        int hash = url.IndexOf("#", start);
        if (slash >= 0 && slash < end) { end = slash; }
        if (query >= 0 && query < end) { end = query; }
        if (hash >= 0 && hash < end) { end = hash; }
        if (end <= start) { return ""; }
        string auth = url.Substring(start, end - start);
        for (int i = 0; i < auth.Length; i = i + 1) {
            int c = auth[i] & 255;
            bool ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 90)
                || (c >= 97 && c <= 122) || c == 46 || c == 45
                || c == 58 || c == 91 || c == 93;
            if (!ok) { return ""; }
        }
        int portAt = auth.IndexOf(":");
        if (auth.StartsWith("[")) {
            int close = auth.IndexOf("]");
            if (close <= 2 || !auth.Substring(1, close - 1).Contains(":")) { return ""; }
            portAt = close + 1;
            if (portAt == auth.Length) { portAt = -1; }
            else if ((auth[portAt] & 255) != 58) { return ""; }
        } else {
            if (auth.Contains("[") || auth.Contains("]") || portAt == 0) { return ""; }
        }
        if (portAt >= 0) {
            string port = auth.Substring(portAt + 1);
            if (port.Length == 0 || port.Length > 5) { return ""; }
            int number = 0;
            for (int i = 0; i < port.Length; i = i + 1) {
                int digit = (port[i] & 255) - 48;
                if (digit < 0 || digit > 9) { return ""; }
                number = number * 10 + digit;
            }
            if (number > 65535) { return ""; }
        }
        return url.Substring(0, end);
    }

    static bool SameOriginHost(string origin, string host) {
        if (host.Length == 0) { return false; }
        bool tls = origin.StartsWith("https://");
        int start = tls ? 8 : 7;
        return Csrf.TrimDefaultPort(origin.Substring(start).ToLower(), tls)
            == Csrf.TrimDefaultPort(host.ToLower(), tls);
    }

    static bool ValidCorsOrigin() {
        string origin = Cfg.Cors.allowOrigin;
        if (origin == "*") { return !Cfg.Cors.allowCredentials; }
        return origin.Length > 0 && HttpOrigin(origin) == origin;
    }

    /* Invalid CORS configuration grants no cross-origin access, without
       disabling same-origin pages or non-browser API clients. */
    static bool CorsFilter(HttpContext ctx) {
        if (!Cfg.Cors.enabled || !ValidCorsOrigin()) { return true; }
        ctx.SetHeader("Access-Control-Allow-Origin", Cfg.Cors.allowOrigin);
        ctx.SetHeader("Access-Control-Allow-Methods", Cfg.Cors.allowMethods);
        ctx.SetHeader("Access-Control-Allow-Headers", Cfg.Cors.allowHeaders);
        if (Cfg.Cors.allowCredentials) {
            ctx.SetHeader("Access-Control-Allow-Credentials", "true");
        }
        ctx.SetHeader("Access-Control-Max-Age", Convert.ToString(Cfg.Cors.maxAge));

        if (ctx.method == "OPTIONS") {
            ctx.Status(204, "No Content");
            ctx.Text("");
            return false;
        }
        return true;
    }

    static int traceSeq = 0;

    static bool AccessLog(HttpContext ctx) {
        string traceId = ctx.Header("x-request-id");
        if (traceId.Length == 0) {
            traceId = ctx.Header("X-Request-Id");
        }
        traceId = CleanTraceId(traceId);
        if (traceId.Length == 0) {
            traceSeq = traceSeq + 1;
            traceId = "tr_" + Convert.ToString(DateTime.UtcNow().ToUnixSeconds())
                + "_" + Convert.ToString(traceSeq);
        }
        ctx.SetHeader("X-Request-Id", traceId);
        Console.WriteLine("[req] [" + traceId + "] " + ctx.method + " " + ctx.path);
        return true;
    }

    /* 客户端可伪造 x-request-id：头里夹带换行即能伪造整行访问日志
       （或塞进控制台转义序列）。traceId 只放行白名单 [A-Za-z0-9._-]，
       不合法字符一律丢弃，洗完为空按缺失处理（本地再生成）；上限 64
       字符防超长头撑爆日志行。洗过的 id 同时用于日志与回显头。 */
    static string CleanTraceId(string raw) {
        if (raw == null) { return ""; }
        int n = raw.Length;
        if (n > 64) { n = 64; }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < n; i = i + 1) {
            int c = raw[i] & 255;
            bool ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 90)
                || (c >= 97 && c <= 122) || c == 46 || c == 45 || c == 95;
            if (ok) { sb.Append(raw[i]); }
        }
        return sb.ToString();
    }

    /* 请求指标：按毫秒统计，流式连接只计推送量 */
    static void Metrics(HttpContext ctx, long elapsedUs) {
        if (ctx.routePattern.Length == 0) {
            if (elapsedUs > (long)slowMs * 1000) {
                Console.WriteLine("[slow] " + ctx.method + " " + ctx.path + " "
                    + Convert.ToString(elapsedUs) + "us");
            }
            return;
        }
        if (ctx.MetricsExcluded()) {
            MetricsStore.Pushed(ctx.method, ctx.routePattern, ctx.Frames(),
                ctx.FrameBytes());
            return;
        }
        MetricsStore.Record(ctx.method, ctx.routePattern, ctx.status,
            elapsedUs);
        if (elapsedUs > (long)slowMs * 1000) {
            Console.WriteLine("[slow] " + ctx.method + " " + ctx.path + " "
                + Convert.ToString(elapsedUs) + "us");
        }
    }
}
