using System;
using System.IO;
using System.Json;
using ZanWeb.Security;
using ZanWeb.Services;

namespace ZanWeb.Core;

/* [server] 配置。*/
class ServerCfg {
    string name;
    string mode;
    string host;
    int port;
    int maxBodyMB;
    int uploadBodyMB;
    int globalLimitPerSec;
    /* Verification issuance only: comma-separated exact proxy IP literals (no CIDR,
       names or wildcards). Empty trusts nobody. Proxies must overwrite X-Forwarded-For
       or append their observed peer; never pass an unverified header unchanged. */
    string trustedProxies;

    static ServerCfg Defaults() {
        ServerCfg c = new ServerCfg();
        c.name = "app";
        c.mode = "full";
        c.host = "127.0.0.1";
        c.port = 8080;
        c.maxBodyMB = 2;
        c.uploadBodyMB = 64;
        c.globalLimitPerSec = 0;
        c.trustedProxies = "";
        return c;
    }
}

/* [database.readOnly] 只读从库配置：开启后读写分离，查询借用从库连接池，写与事务走主库。*/
class DatabaseReadOnlyCfg {
    bool enabled;
    string driver;
    string sqlitePath;
    string host;
    int port;
    string name;
    string user;
    string password;
    int poolSize;

    static DatabaseReadOnlyCfg Defaults() {
        DatabaseReadOnlyCfg c = new DatabaseReadOnlyCfg();
        c.enabled = false;
        c.driver = "sqlite";
        c.sqlitePath = "app.db";
        c.host = "127.0.0.1";
        c.port = 3306;
        c.name = "app";
        c.user = "root";
        c.password = "";
        c.poolSize = 8;
        return c;
    }
}

/* [cors] 跨域资源共享配置。*/
class CorsCfg {
    bool enabled;
    string allowOrigin;
    string allowMethods;
    string allowHeaders;
    bool allowCredentials;
    int maxAge;

    static CorsCfg Defaults() {
        CorsCfg c = new CorsCfg();
        c.enabled = true;
        c.allowOrigin = "*";
        c.allowMethods = "GET, POST, PUT, DELETE, OPTIONS";
        c.allowHeaders = "Content-Type, Authorization, X-Request-Id";
        c.allowCredentials = false;
        c.maxAge = 86400;
        return c;
    }
}

/* [database] 配置。*/
class DatabaseCfg {
    string driver;
    string sqlitePath;
    string host;
    int port;
    string name;
    string user;
    string password;
    /* 每个 worker 进程独立池的最大连接数；全服务最多 poolSize * worker.count。*/
    int poolSize;
    DatabaseReadOnlyCfg readOnly;

    static DatabaseCfg Defaults() {
        DatabaseCfg c = new DatabaseCfg();
        c.driver = "sqlite";
        c.sqlitePath = "app.db";
        c.host = "127.0.0.1";
        c.port = 3306;
        c.name = "app";
        c.user = "root";
        c.password = "";
        c.poolSize = 8;
        c.readOnly = DatabaseReadOnlyCfg.Defaults();
        return c;
    }
}

/* [worker] 配置。*/
class WorkerCfg {
    int count;
    bool daemon;

    static WorkerCfg Defaults() {
        WorkerCfg c = new WorkerCfg();
        c.count = 1;
        c.daemon = false;
        return c;
    }
}

/* [log] 配置。*/
class LogCfg {
    bool access;
    int slowMs;
    /* 慢 SQL 阈值，达此值即记入日志并计数。*/
    int slowSqlMs;
    /* 按日日志目录，"" 禁用文件输出。*/
    string dir;
    /* 日志文件名模式，每次写入展开。*/
    string pattern;
    /* 错误日志文件，"" 禁用。*/
    string errorLog;
    /* 同时向控制台输出错误，生产环境关闭。*/
    bool debug;

    static LogCfg Defaults() {
        LogCfg c = new LogCfg();
        c.access = false;
        c.slowMs = 1000;
        /* 故意低于请求阈值：单个 SQL 超过 200ms 已属异常。*/
        c.slowSqlMs = 200;
        c.dir = "logs";
        c.pattern = "{yyyy}{MM}/{dd}.log";
        c.errorLog = "logs/{yyyy}{MM}/{dd}.log";
        c.debug = false;
        return c;
    }
}

/* [metrics] 配置：指标历史存储位置和刷写频率。请求仅累加分钟桶，不直接写入。*/
class MetricsCfg {
    bool enabled;
    /* 独立的 SQLite 文件。*/
    string path;
    /* 定时刷写间隔（秒）；60 = 一分钟。*/
    int flushSeconds;
    /* 达到此行数也触发刷写。*/
    int flushRows;
    /* 保留天数，每小时清理。*/
    int keepDays;
    /* 顶栏告警阈值：5 分钟窗错误率百分比、参与评估的最少调用数（避免低流量
       误报）、P95 耗时毫秒。任一为 0 关闭对应检查；铃铛轮询
       /admin/monitor/alerts 时评估。*/
    int alertErrPct;
    int alertErrCalls;
    int alertP95Ms;

    static MetricsCfg Defaults() {
        MetricsCfg c = new MetricsCfg();
        c.enabled = true;
        c.path = "metrics.db";
        c.flushSeconds = 60;
        c.flushRows = 2000;
        c.keepDays = 30;
        c.alertErrPct = 5;
        c.alertErrCalls = 20;
        c.alertP95Ms = 2000;
        return c;
    }
}

/* [auth] 配置。*/
class AuthCfg {
    /* 会话 Cookie 加密密钥（≥32 字符）。空则拒绝登录，防止伪造 Cookie。*/
    string secret;
    /* 仅空库引导时使用，必须显式设置强密码；不存默认口令。*/
    string bootstrapPassword;
    /* PBKDF2 口令哈希轮数（下限 1000，默认 300000 ≈ 0.17s/次）。
       轮数随哈希落库（pbkdf2$ 自描述格式），调整只影响新写入。*/
    int iter;

    static AuthCfg Defaults() {
        AuthCfg c = new AuthCfg();
        c.secret = "";
        c.bootstrapPassword = "";
        c.iter = 300000;
        return c;
    }
}

/* [security] 安全响应头配置。*/
class SecurityCfg {
    /* 启用 Content-Security-Policy（default-src 'self'）。框架视图与
       生成器已去内联（内联 style=/内联 script/javascript: 伪协议清零：
       th 列宽走遗留 width 属性、tab 条 href="#"、页脚本外链
       到 /static/js/ 下的独立文件）；应用自有视图未清扫时置 true 会破页（如
       server-collab 模板仍有 347 处内联 style、7 处内联 script），
       模板去内联批次后再改默认值。*/
    bool csp;

    static SecurityCfg Defaults() {
        SecurityCfg c = new SecurityCfg();
        c.csp = false;
        return c;
    }
}

/* [cache] 配置。*/
class CacheCfg {
    string driver;
    string redisHost;
    int redisPort;
    int poolSize;
    int connectTimeoutMs;

    static CacheCfg Defaults() {
        CacheCfg c = new CacheCfg();
        c.driver = "memory";
        c.redisHost = "127.0.0.1";
        c.redisPort = 6379;
        c.poolSize = 8;
        c.connectTimeoutMs = 3000;
        return c;
    }
}

/* [job] 配置：定时任务调度器。*/
class JobCfg {
    bool enabled;

    static JobCfg Defaults() {
        JobCfg c = new JobCfg();
        c.enabled = true;
        return c;
    }
}

/* [cluster] 配置：跨物理节点状态同步总线。
   enabled: false（默认保持单机高性能共享内存 PermTable + 本地 verUids，零网络开销）。
   当多机集群部署时设为 true，自动启用 Redis Pub/Sub 广播状态失效事件。*/
class ClusterCfg {
    bool enabled;
    string bus;
    string channel;

    static ClusterCfg Defaults() {
        ClusterCfg c = new ClusterCfg();
        c.enabled = false;
        c.bus = "redis";
        c.channel = "zanweb:cluster:events";
        return c;
    }
}

/* 运行时配置：启动时从 config/app.json 加载一次为全局强类型实体，通过 Cfg.Server.port 等直接访问。无编译期固化，改配置后重启生效。*/
class Cfg {
    static ServerCfg Server = ServerCfg.Defaults();
    static DatabaseCfg Db = DatabaseCfg.Defaults();
    static WorkerCfg Worker = WorkerCfg.Defaults();
    static LogCfg Log = LogCfg.Defaults();
    static CacheCfg Cache = CacheCfg.Defaults();
    static AuthCfg Auth = AuthCfg.Defaults();
    static MetricsCfg Metrics = MetricsCfg.Defaults();
    static JobCfg Job = JobCfg.Defaults();
    static ClusterCfg Cluster = ClusterCfg.Defaults();
    static CorsCfg Cors = CorsCfg.Defaults();
    static SecurityCfg Security = SecurityCfg.Defaults();
    static bool loaded = false;

    /* 依次查找约定的配置文件，找到后叠加到内置默认值之上。*/
    static void Load(string relPath) {
        loaded = true;
        List<string> cands = new List<string>();
        if (relPath.Length > 0) { cands.Add(relPath); }
        cands.Add("config/app.json");
        cands.Add("app.json");
        cands.Add("../config/app.json");
        JsonValue root = null;
        for (int i = 0; i < cands.Count; i = i + 1) {
            if (File.Exists(cands[i])) {
                string txt = File.ReadAllText(cands[i]);
                if (txt.Length > 0) {
                    root = JsonValue.ParseLenient(txt);
                    Console.WriteLine("[config] loaded " + cands[i]);
                    break;
                }
            }
        }
        if (root == null) {
            Console.WriteLine("[config] no config file found; using built-in defaults");
            ApplyEnv();
            return;
        }
        Apply(root);
        ApplyEnv();
    }

    /* 环境变量覆盖，最后应用：部署时不改文件即可指向其他数据库。密码等敏感值应放在此处。*/
    static void ApplyEnv() {
        Db.driver = EnvStr("ZAN_DB_DRIVER", Db.driver);
        Db.host = EnvStr("ZAN_DB_HOST", Db.host);
        Db.port = EnvInt("ZAN_DB_PORT", Db.port);
        Db.name = EnvStr("ZAN_DB_NAME", Db.name);
        Db.user = EnvStr("ZAN_DB_USER", Db.user);
        Db.password = EnvStr("ZAN_DB_PASSWORD", Db.password);
        Db.sqlitePath = EnvStr("ZAN_DB_SQLITE_PATH", Db.sqlitePath);
        Db.poolSize = EnvInt("ZAN_DB_POOL_SIZE", Db.poolSize);
        Cache.redisHost = EnvStr("ZAN_REDIS_HOST", Cache.redisHost);
        Cache.redisPort = EnvInt("ZAN_REDIS_PORT", Cache.redisPort);
        Worker.count = EnvInt("ZAN_WORKERS", Worker.count);
        Auth.secret = EnvStr("ZAN_AUTH_SECRET", Auth.secret);
        Auth.bootstrapPassword = EnvStr("ZAN_BOOTSTRAP_ADMIN_PASSWORD", Auth.bootstrapPassword);
        Auth.iter = EnvInt("ZAN_AUTH_PBKDF2_ITER", Auth.iter);
        Job.enabled = EnvBool("ZAN_JOB_ENABLED", Job.enabled);
        Cluster.enabled = EnvBool("ZAN_CLUSTER_ENABLED", Cluster.enabled);
    }

    static bool EnvBool(string name, bool fallback) {
        string v = ProcessHost.Env(name);
        if (v.Length == 0) { return fallback; }
        if (v == "1" || v == "true" || v == "TRUE") { return true; }
        if (v == "0" || v == "false" || v == "FALSE") { return false; }
        return fallback;
    }

    static string EnvStr(string name, string fallback) {
        string v = ProcessHost.Env(name);
        if (v.Length == 0) { return fallback; }
        return v;
    }

    static int EnvInt(string name, int fallback) {
        string v = ProcessHost.Env(name);
        if (v.Length == 0) { return fallback; }
        int n = Convert.ToInt32(v);
        if (n <= 0) { return fallback; }
        return n;
    }

    static JsonValue Sec(JsonValue root, string name) {
        JsonValue v = root.Get(name);
        if (v == null) { return JsonValue.NewObject(); }
        if (!v.IsObject()) { return JsonValue.NewObject(); }
        return v;
    }

    static void Apply(JsonValue root) {
        JsonValue s = Sec(root, "server");
        Server.name = s.Str("name", Server.name);
        Server.mode = s.Str("mode", Server.mode);
        Server.host = s.Str("host", Server.host);
        Server.port = s.Int("port", Server.port);
        Server.maxBodyMB = s.Int("maxBodyMB", Server.maxBodyMB);
        Server.uploadBodyMB = s.Int("uploadBodyMB", Server.uploadBodyMB);
        Server.globalLimitPerSec = s.Int("globalLimitPerSec", Server.globalLimitPerSec);
        Server.trustedProxies = s.Str("trustedProxies", Server.trustedProxies);

        JsonValue d = Sec(root, "database");
        Db.driver = d.Str("driver", Db.driver);
        Db.sqlitePath = d.Str("sqlitePath", Db.sqlitePath);
        Db.host = d.Str("host", Db.host);
        Db.port = d.Int("port", Db.port);
        Db.name = d.Str("name", Db.name);
        Db.user = d.Str("user", Db.user);
        Db.password = d.Str("password", Db.password);
        Db.poolSize = d.Int("poolSize", Db.poolSize);

        JsonValue ro = Sec(d, "readOnly");
        Db.readOnly.enabled = ro.Bool("enabled", Db.readOnly.enabled);
        Db.readOnly.driver = ro.Str("driver", Db.readOnly.driver);
        Db.readOnly.sqlitePath = ro.Str("sqlitePath", Db.readOnly.sqlitePath);
        Db.readOnly.host = ro.Str("host", Db.readOnly.host);
        Db.readOnly.port = ro.Int("port", Db.readOnly.port);
        Db.readOnly.name = ro.Str("name", Db.readOnly.name);
        Db.readOnly.user = ro.Str("user", Db.readOnly.user);
        Db.readOnly.password = ro.Str("password", Db.readOnly.password);
        Db.readOnly.poolSize = ro.Int("poolSize", Db.readOnly.poolSize);

        JsonValue w = Sec(root, "worker");
        Worker.count = w.Int("count", Worker.count);
        Worker.daemon = w.Bool("daemon", Worker.daemon);

        JsonValue l = Sec(root, "log");
        Log.access = l.Bool("access", Log.access);
        Log.slowMs = l.Int("slowMs", Log.slowMs);
        Log.slowSqlMs = l.Int("slowSqlMs", Log.slowSqlMs);
        Log.dir = l.Str("dir", Log.dir);
        Log.pattern = l.Str("pattern", Log.pattern);
        Log.errorLog = l.Str("errorLog", Log.errorLog);
        Log.debug = l.Bool("debug", Log.debug);

        JsonValue mt = Sec(root, "metrics");
        Metrics.enabled = mt.Bool("enabled", Metrics.enabled);
        Metrics.path = mt.Str("path", Metrics.path);
        Metrics.flushSeconds = mt.Int("flushSeconds", Metrics.flushSeconds);
        Metrics.flushRows = mt.Int("flushRows", Metrics.flushRows);
        Metrics.keepDays = mt.Int("keepDays", Metrics.keepDays);
        Metrics.alertErrPct = mt.Int("alertErrPct", Metrics.alertErrPct);
        Metrics.alertErrCalls = mt.Int("alertErrCalls", Metrics.alertErrCalls);
        Metrics.alertP95Ms = mt.Int("alertP95Ms", Metrics.alertP95Ms);

        JsonValue c = Sec(root, "cache");
        Cache.driver = c.Str("driver", Cache.driver);
        Cache.redisHost = c.Str("redisHost", Cache.redisHost);
        Cache.redisPort = c.Int("redisPort", Cache.redisPort);
        Cache.poolSize = c.Int("poolSize", Cache.poolSize);
        Cache.connectTimeoutMs = c.Int(
            "connectTimeoutMs", Cache.connectTimeoutMs);

        JsonValue a = Sec(root, "auth");
        Auth.secret = a.Str("secret", Auth.secret);
        Auth.bootstrapPassword = a.Str("bootstrapPassword", Auth.bootstrapPassword);
        Auth.iter = a.Int("iter", Auth.iter);

        JsonValue j = Sec(root, "job");
        Job.enabled = j.Bool("enabled", Job.enabled);

        JsonValue cl = Sec(root, "cluster");
        Cluster.enabled = cl.Bool("enabled", Cluster.enabled);
        Cluster.bus = cl.Str("bus", Cluster.bus);
        Cluster.channel = cl.Str("channel", Cluster.channel);

        JsonValue co = Sec(root, "cors");
        Cors.enabled = co.Bool("enabled", Cors.enabled);
        Cors.allowOrigin = co.Str("allowOrigin", Cors.allowOrigin);
        Cors.allowMethods = co.Str("allowMethods", Cors.allowMethods);
        Cors.allowHeaders = co.Str("allowHeaders", Cors.allowHeaders);
        Cors.allowCredentials = co.Bool("allowCredentials", Cors.allowCredentials);
        Cors.maxAge = co.Int("maxAge", Cors.maxAge);

        JsonValue sc = Sec(root, "security");
        Security.csp = sc.Bool("csp", Security.csp);
    }
}
