using System;
using System.IO;
using System.Json;
using ZanWeb.Security;
using ZanWeb.Services;

namespace ZanWeb.Core;

/* [server] 配置。 */
public class Cfg {
    public static ServerCfg Server = ServerCfg.Defaults();
    public static DatabaseCfg Db = DatabaseCfg.Defaults();
    public static WorkerCfg Worker = WorkerCfg.Defaults();
    public static LogCfg Log = LogCfg.Defaults();
    public static CacheCfg Cache = CacheCfg.Defaults();
    public static AuthCfg Auth = AuthCfg.Defaults();
    public static MetricsCfg Metrics = MetricsCfg.Defaults();
    public static JobCfg Job = JobCfg.Defaults();
    public static ClusterCfg Cluster = ClusterCfg.Defaults();
    public static CorsCfg Cors = CorsCfg.Defaults();
    public static SecurityCfg Security = SecurityCfg.Defaults();
    public static bool loaded = false;

    /* 依次查找约定的配置文件，找到后叠加到内置默认值之上。 */
    public static void Load(string relPath) {
        loaded = true;
        List<string> cands = new List<string>();
        if (relPath.Length > 0) { cands.Add(relPath); }
        cands.Add("config/app.json");
        cands.Add("app.json");
        cands.Add("../config/app.json");
        JsonValue root = null;
        for (int i = 0; i < cands.Count; i = i + 1) {
            if (File.Exists(cands[i])) {
                string txt = File.ReadAllText(cands[i]);
                if (txt.Length > 0) {
                    root = JsonValue.ParseLenient(txt);
                    Console.WriteLine("[config] loaded " + cands[i]);
                    break;
                }
            }
        }
        if (root == null) {
            Console.WriteLine("[config] no config file found; using built-in defaults");
            ApplyEnv();
            return;
        }
        Apply(root);
        ApplyEnv();
    }

    /* 环境变量覆盖，最后应用：部署时不改文件即可指向其他数据库。密码等敏感值应放在此处。 */
    private static void ApplyEnv() {
        Db.driver = EnvStr("ZAN_DB_DRIVER", Db.driver);
        Db.host = EnvStr("ZAN_DB_HOST", Db.host);
        Db.port = EnvInt("ZAN_DB_PORT", Db.port);
        Db.name = EnvStr("ZAN_DB_NAME", Db.name);
        Db.user = EnvStr("ZAN_DB_USER", Db.user);
        Db.password = EnvStr("ZAN_DB_PASSWORD", Db.password);
        Db.sqlitePath = EnvStr("ZAN_DB_SQLITE_PATH", Db.sqlitePath);
        Db.poolSize = EnvInt("ZAN_DB_POOL_SIZE", Db.poolSize);
        Cache.redisHost = EnvStr("ZAN_REDIS_HOST", Cache.redisHost);
        Cache.redisPort = EnvInt("ZAN_REDIS_PORT", Cache.redisPort);
        Worker.count = EnvInt("ZAN_WORKERS", Worker.count);
        Auth.secret = EnvStr("ZAN_AUTH_SECRET", Auth.secret);
        Auth.bootstrapPassword = EnvStr("ZAN_BOOTSTRAP_ADMIN_PASSWORD", Auth.bootstrapPassword);
        Auth.iter = EnvInt("ZAN_AUTH_PBKDF2_ITER", Auth.iter);
        Job.enabled = EnvBool("ZAN_JOB_ENABLED", Job.enabled);
        Cluster.enabled = EnvBool("ZAN_CLUSTER_ENABLED", Cluster.enabled);
    }

    private static bool EnvBool(string name, bool fallback) {
        string v = ProcessHost.Env(name);
        if (v.Length == 0) { return fallback; }
        if (v == "1" || v == "true" || v == "TRUE") { return true; }
        if (v == "0" || v == "false" || v == "FALSE") { return false; }
        return fallback;
    }

    private static string EnvStr(string name, string fallback) {
        string v = ProcessHost.Env(name);
        if (v.Length == 0) { return fallback; }
        return v;
    }

    static int EnvInt(string name, int fallback) {
        string v = ProcessHost.Env(name);
        if (v.Length == 0) { return fallback; }
        int n = Convert.ToInt32(v);
        if (n <= 0) { return fallback; }
        return n;
    }

    private static JsonValue Sec(JsonValue root, string name) {
        JsonValue v = root.Get(name);
        if (v == null) { return JsonValue.NewObject(); }
        if (!v.IsObject()) { return JsonValue.NewObject(); }
        return v;
    }

    public static void Apply(JsonValue root) {
        JsonValue s = Sec(root, "server");
        Server.name = s.Str("name", Server.name);
        Server.mode = s.Str("mode", Server.mode);
        Server.host = s.Str("host", Server.host);
        Server.port = s.Int("port", Server.port);
        Server.maxBodyMB = s.Int("maxBodyMB", Server.maxBodyMB);
        Server.uploadBodyMB = s.Int("uploadBodyMB", Server.uploadBodyMB);
        Server.globalLimitPerSec = s.Int("globalLimitPerSec", Server.globalLimitPerSec);
        Server.trustedProxies = s.Str("trustedProxies", Server.trustedProxies);

        JsonValue d = Sec(root, "database");
        Db.driver = d.Str("driver", Db.driver);
        Db.sqlitePath = d.Str("sqlitePath", Db.sqlitePath);
        Db.host = d.Str("host", Db.host);
        Db.port = d.Int("port", Db.port);
        Db.name = d.Str("name", Db.name);
        Db.user = d.Str("user", Db.user);
        Db.password = d.Str("password", Db.password);
        Db.poolSize = d.Int("poolSize", Db.poolSize);

        JsonValue ro = Sec(d, "readOnly");
        Db.readOnly.enabled = ro.Bool("enabled", Db.readOnly.enabled);
        Db.readOnly.driver = ro.Str("driver", Db.readOnly.driver);
        Db.readOnly.sqlitePath = ro.Str("sqlitePath", Db.readOnly.sqlitePath);
        Db.readOnly.host = ro.Str("host", Db.readOnly.host);
        Db.readOnly.port = ro.Int("port", Db.readOnly.port);
        Db.readOnly.name = ro.Str("name", Db.readOnly.name);
        Db.readOnly.user = ro.Str("user", Db.readOnly.user);
        Db.readOnly.password = ro.Str("password", Db.readOnly.password);
        Db.readOnly.poolSize = ro.Int("poolSize", Db.readOnly.poolSize);

        JsonValue w = Sec(root, "worker");
        Worker.count = w.Int("count", Worker.count);
        Worker.daemon = w.Bool("daemon", Worker.daemon);

        JsonValue l = Sec(root, "log");
        Log.access = l.Bool("access", Log.access);
        Log.slowMs = l.Int("slowMs", Log.slowMs);
        Log.slowSqlMs = l.Int("slowSqlMs", Log.slowSqlMs);
        Log.dir = l.Str("dir", Log.dir);
        Log.pattern = l.Str("pattern", Log.pattern);
        Log.errorLog = l.Str("errorLog", Log.errorLog);
        Log.debug = l.Bool("debug", Log.debug);

        JsonValue mt = Sec(root, "metrics");
        Metrics.enabled = mt.Bool("enabled", Metrics.enabled);
        Metrics.path = mt.Str("path", Metrics.path);
        Metrics.flushSeconds = mt.Int("flushSeconds", Metrics.flushSeconds);
        Metrics.flushRows = mt.Int("flushRows", Metrics.flushRows);
        Metrics.keepDays = mt.Int("keepDays", Metrics.keepDays);
        Metrics.alertErrPct = mt.Int("alertErrPct", Metrics.alertErrPct);
        Metrics.alertErrCalls = mt.Int("alertErrCalls", Metrics.alertErrCalls);
        Metrics.alertP95Ms = mt.Int("alertP95Ms", Metrics.alertP95Ms);

        JsonValue c = Sec(root, "cache");
        Cache.driver = c.Str("driver", Cache.driver);
        Cache.redisHost = c.Str("redisHost", Cache.redisHost);
        Cache.redisPort = c.Int("redisPort", Cache.redisPort);
        Cache.poolSize = c.Int("poolSize", Cache.poolSize);
        Cache.connectTimeoutMs = c.Int(
            "connectTimeoutMs", Cache.connectTimeoutMs);

        JsonValue a = Sec(root, "auth");
        Auth.secret = a.Str("secret", Auth.secret);
        Auth.bootstrapPassword = a.Str("bootstrapPassword", Auth.bootstrapPassword);
        Auth.iter = a.Int("iter", Auth.iter);

        JsonValue j = Sec(root, "job");
        Job.enabled = j.Bool("enabled", Job.enabled);

        JsonValue cl = Sec(root, "cluster");
        Cluster.enabled = cl.Bool("enabled", Cluster.enabled);
        Cluster.bus = cl.Str("bus", Cluster.bus);
        Cluster.channel = cl.Str("channel", Cluster.channel);

        JsonValue co = Sec(root, "cors");
        Cors.enabled = co.Bool("enabled", Cors.enabled);
        Cors.allowOrigin = co.Str("allowOrigin", Cors.allowOrigin);
        Cors.allowMethods = co.Str("allowMethods", Cors.allowMethods);
        Cors.allowHeaders = co.Str("allowHeaders", Cors.allowHeaders);
        Cors.allowCredentials = co.Bool("allowCredentials", Cors.allowCredentials);
        Cors.maxAge = co.Int("maxAge", Cors.maxAge);

        JsonValue sc = Sec(root, "security");
        Security.csp = sc.Bool("csp", Security.csp);
    }
}
