using System;
using System.Data;
using System.Data.Orm;
using System.Diagnostics;
using System.Security.Cryptography;
using System.Web;
using ZanWeb.Model;
using ZanWeb.Dao;
using ZanWeb.Core;
using ZanWeb.Security;

namespace ZanWeb.Core;

/* 表结构 + 种子数据，启动时由 ZanWeb.Boot 一次性应用。CodeFirst (SyncStructure) 读取数据库目录发 DDL，不做每次请求触发。种子带计数保护，重复启动不变。权限仅 seed 内置角色持有哪些 action，其余从路由表派生。业务表的种子经 OnSeed 挂点由应用侧注册——模型与 DAO 都在应用里，框架不预设任何业务。*/
async delegate bool SeedFn(IFreeSql fsql);

class Schema {
    /* 迁移互斥租约与等待参数。租约有效期必须远大于一次完整迁移的
       时长（秒级 schema、百万行级 backfill 也远用不到 15 分钟）；
       持约进程崩溃后租约到点自动让出，不会死锁后续启动。 */
    static int LeaseSec = 900;
    static int WaitMs = 60000;

    /* 创建/更新全部表并填充种子数据。数据库不可达或迁移失败时返回
       false，服务器仍启动（探活应答、日志记账，Boot 负责重试与告警）。*/
    static async bool Ensure(DbContext ctx) {
        IDbConnection db = await ctx.Acquire();
        if (db == null) { return false; }
        try {
            if (!await AcquireLease(db)) { return false; }
            try {
                /* 必须接住 Apply 的结果：种子失败要如实回报未就绪；
                   也绝不能用「await 后丢弃」的裸语句形态——协程改写会
                   丢掉外层返回值（编译器挂账），捕获形态无恙。 */
                if (!await Apply(db)) { return false; }
                return true;
            } finally {
                await ReleaseLease(db);
            }
        } catch (Exception ex) {
            /* 迁移失败不再带栈炸掉启动：一条可定位的诊断，服务器继续
               起来——数据面在修好前如实失败，比半截 schema 更可运维。 */
            Log.Error("[db] schema migration failed: " + ex.Message);
            Console.WriteLine("[db] schema migration failed: " + ex.Message);
            return false;
        } finally {
            ctx.Release(db);
        }
    }

    /* Apply 是 Ensure 的租约内主体：WAL → 全量 CodeFirst → 标志回填 →
       种子。每一步都幂等，等待租约的 worker 轮到后重跑一遍是快速 no-op。
       WAL/CodeFirst/锁表是引导协议，留在引导连接上；种子查询走同一连接
       派生的 FreeSql 门面。*/
    static async bool Apply(IDbConnection db) {
        /* SQLite 启用 WAL（其他引擎无操作）：多 worker 共享文件时避免写者阻塞读者。*/
        await DbSchema.UseWriteAheadLogAsync(db);
        /* 编译期已知所有 [Table] 类，一行调用覆盖全部，新模型无需补行。*/
        await db.SyncStructureAllAsync();
        await BackfillGenFlags(db);

        IFreeSql fsql = FreeSql.FromConnection(db);
        if (!await SeedAdmin(fsql)) { return false; }
        if (!await SeedRoles(fsql)) { return false; }
        if (!await SeedDepartments(fsql)) { return false; }
        if (!await SeedDicts(fsql)) { return false; }
        if (!await SeedSettings(fsql)) { return false; }
        if (!await SeedJobs(fsql)) { return false; }
        if (!await RunSeed(fsql)) { return false; }
        return true;
    }

    /* ---- 迁移互斥租约：每个 worker 进程启动都会跑一遍 Ensure，
       并发 CodeFirst DDL 与「先查数再插入」的种子没有互斥时会交错
       （重复 admin、半截表）。sys_lock 用普通 CREATE/INSERT/UPDATE/
       DELETE 表达租约，不依赖任何引擎专有特性；行带过期时间，竞争
       者最多等 WaitMs，等到即幂等重跑，等不到如实放弃。 ---- */

    /* 持约者标识：进程内一次性 nonce + pid + 端口，保证跨机器跨重启
       都不会撞成同一串（撞了会让释放语句误删别人的租约）。 */
    static string leaseHolder = "";

    static string Holder() {
        if (leaseHolder.Length == 0) {
            leaseHolder = "w" + Convert.ToString(WebApp.NowSeconds())
                + "p" + Convert.ToString(ProcessHost.Pid())
                + "r" + Convert.ToString(Cfg.Server.port);
        }
        return leaseHolder;
    }

    static async void CreateLockTable(IDbConnection db) {
        /* 三家方言通用的最小 DDL；值全部由框架自产，无用户输入。 */
        await db.ExecuteAsync("CREATE TABLE IF NOT EXISTS sys_lock ("
            + "name varchar(64) NOT NULL, holder varchar(64) NOT NULL, "
            + "expires int NOT NULL, PRIMARY KEY(name))");
    }

    static async bool AcquireLease(IDbConnection db) {
        await CreateLockTable(db);
        string holder = Holder();
        int waited = 0;
        while (true) {
            int now = WebApp.NowSeconds();
            /* 过期租约先扫掉，再公平竞争。 */
            int _s = await db.ExecuteAsync(
                "DELETE FROM sys_lock WHERE expires < "
                + Convert.ToString(now));
            try {
                int _i = await db.ExecuteAsync("INSERT INTO sys_lock"
                    + "(name, holder, expires) VALUES('schema', '"
                    + holder + "', " + Convert.ToString(now + LeaseSec)
                    + ")");
                return true;
            } catch {
                /* 主键冲突 = 已有持约者（并发启动或租约未过期）。 */
            }
            int claimed = await db.ExecuteAsync("UPDATE sys_lock SET holder='"
                + holder + "', expires=" + Convert.ToString(now + LeaseSec)
                + " WHERE name='schema' AND expires < " + Convert.ToString(now));
            if (claimed > 0) { return true; }
            if (waited >= WaitMs) {
                Log.Error("[db] schema lock busy after "
                    + Convert.ToString(WaitMs / 1000)
                    + "s (another instance is migrating?) -- boot continues without schema");
                Console.WriteLine("[db] schema lock busy -- see error log");
                return false;
            }
            await Task.Delay(2000);
            waited = waited + 2000;
        }
    }

    static async void ReleaseLease(IDbConnection db) {
        int _r = await db.ExecuteAsync("DELETE FROM sys_lock WHERE "
            + "name='schema' AND holder='" + Holder() + "'");
    }

    /* 表设计器的动作/行内编辑标志后补列时，旧行是 NULL（ORM 读作 0）——
       直接按 0 解释会把既有模块的新增/编辑/删除/菜单和所有列的行内编辑
       全部关掉。只在仍为 NULL 时回填为开（inQuick 跟随该列的 inEdit，与
       旧行为"行内编辑从 inEdit 推导"一致）；显式设 0 的行是 0 不是 NULL，
       不受影响，重复启动 no-op。
       CodeFirst 对启动库里已存在的表不补列（只建缺失的表），模型新增的
       标志列必须在这里先补上 —— 否则下面的 UPDATE 撞缺失列，DbException
       直接崩掉启动。 */
    static async bool BackfillGenFlags(IDbConnection db) {
        List<DbColumnDef> tableCols = new List<DbColumnDef>();
        tableCols.Add(DbColumnDef.Of("hasCreate", "int"));
        tableCols.Add(DbColumnDef.Of("hasEdit", "int"));
        tableCols.Add(DbColumnDef.Of("hasDelete", "int"));
        tableCols.Add(DbColumnDef.Of("menuEnabled", "int"));
        int _t = await DbSchema.MigrateAsync(db, "sys_gen_table", tableCols);
        List<DbColumnDef> columnCols = new List<DbColumnDef>();
        columnCols.Add(DbColumnDef.Of("inQuick", "int"));
        int _c = await DbSchema.MigrateAsync(db, "sys_gen_column", columnCols);
        await db.ExecuteAsync(
            "UPDATE sys_gen_table SET hasCreate = 1 WHERE hasCreate IS NULL");
        await db.ExecuteAsync(
            "UPDATE sys_gen_table SET hasEdit = 1 WHERE hasEdit IS NULL");
        await db.ExecuteAsync(
            "UPDATE sys_gen_table SET hasDelete = 1 WHERE hasDelete IS NULL");
        await db.ExecuteAsync(
            "UPDATE sys_gen_table SET menuEnabled = 1 WHERE menuEnabled IS NULL");
        await db.ExecuteAsync(
            "UPDATE sys_gen_column SET inQuick = inEdit WHERE inQuick IS NULL");
        return true;
    }

    /* 空库仅在明确配置强口令时创建引导账号；无配置则拒绝启动。*/
    static async bool SeedAdmin(IFreeSql fsql) {
        int have = await fsql.Select<SysUser>().CountAsync();
        string password = Cfg.Auth.bootstrapPassword;
        if (have > 0) {
            /* 旧部署若仍使用公开的初始密码，必须更换后才能继续服务。*/
            SysUserDao dao = new SysUserDao(fsql);
            SysUser legacy = await dao.ByUsername("admin");
            if (legacy != null && legacy.isSuper == 1 &&
                AuthUser.Verify("admin1234", legacy.passwordSalt, legacy.passwordHash)) {
                if (password == null || password.Length < 12 || password == "admin1234") {
                    throw new Exception("legacy admin password must be rotated with auth.bootstrapPassword or ZAN_BOOTSTRAP_ADMIN_PASSWORD");
                }
                int changed = await dao.ResetPassword(legacy.id, "",
                    AuthUser.NewHash(password), WebApp.NowSeconds());
                if (changed < 1) { throw new Exception("legacy admin password rotation failed"); }
            }
            return true;
        }
        if (password == null || password.Length < 12) {
            throw new Exception("empty database requires auth.bootstrapPassword (or ZAN_BOOTSTRAP_ADMIN_PASSWORD), at least 12 characters");
        }
        SysUser admin = new SysUser();
        admin.username = "admin";
        admin.passwordSalt = "";
        admin.passwordHash = AuthUser.NewHash(password);
        admin.nickname = "系统管理员";
        admin.status = AuthUser.Active;
        admin.isSuper = 1;
        admin.tokenVersion = 1;
        admin.createdAt = WebApp.NowSeconds();
        int _id = await fsql.Insert<SysUser>(admin).ExecuteIdentityAsync();
        return _id > 0;
    }

    /* 两个内置角色：admin（全部管理）和 editor（仅内容管理）。bootstrap 账号绕过角色表，防止误操作锁死。具体权限由 SyncRoleGrants 从路由表填充。*/
    static async bool SeedRoles(IFreeSql fsql) {
        int have = await fsql.Select<SysRole>().CountAsync();
        if (have > 0) { return true; }
        int _admin = await AddRole(fsql, "系统管理员", "admin", 1,
            "除超级管理员外的全部管理权限", DataScope.RoleAll);
        int _editor = await AddRole(fsql, "内容编辑", "editor", 10,
            "只能管理博客内容", DataScope.RoleAll);
        return _admin > 0 && _editor > 0;
    }

    static async int AddRole(IFreeSql fsql, string name, string code, int rank,
                          string description, int dataScope) {
        SysRole r = new SysRole();
        r.name = name;
        r.code = code;
        r.rank = rank;
        r.status = 1;
        r.description = description;
        /* 旧行缺此列则读作 0，DataScope 视为 全部数据，升级不缩权。*/
        r.dataScope = dataScope;
        r.scopeDepts = "";
        r.createdAt = WebApp.NowSeconds();
        r.updatedAt = r.createdAt;
        return await fsql.Insert<SysRole>(r).ExecuteIdentityAsync();
    }

    static async bool Grant(IFreeSql fsql, int roleId, string screen, int mask,
                            long now) {
        SysRoleGrant g = new SysRoleGrant();
        g.roleId = roleId;
        g.action = screen;
        g.mask = mask;
        g.createdAt = now;
        int _id = await fsql.Insert<SysRoleGrant>(g).ExecuteIdentityAsync();
        return _id > 0;
    }

    static async bool SeedDepartments(IFreeSql fsql) {
        int have = await fsql.Select<SysDepartment>().CountAsync();
        if (have > 0) { return true; }
        if (!await AddDept(fsql, 0, "总部", "root", 1)) { return false; }
        if (!await AddDept(fsql, 1, "技术部", "tech", 2)) { return false; }
        return await AddDept(fsql, 1, "内容运营", "content", 3);
    }

    static async bool AddDept(IFreeSql fsql, int parentId, string name,
                           string code, int sortOrder) {
        SysDepartment d = new SysDepartment();
        d.parentId = parentId;
        d.name = name;
        d.code = code;
        d.leaderUserId = 0;
        d.sortOrder = sortOrder;
        d.status = 1;
        int _id = await fsql.Insert<SysDepartment>(d).ExecuteIdentityAsync();
        return _id > 0;
    }

    static async bool SeedDicts(IFreeSql fsql) {
        int have = await fsql.Select<SysDictType>().CountAsync();
        if (have > 0) { return true; }
        if (!await AddDictType(fsql, "user_status", "账号状态")) { return false; }
        if (!await AddDictItem(fsql, "user_status", "1", "启用", 1)) { return false; }
        if (!await AddDictItem(fsql, "user_status", "0", "禁用", 2)) { return false; }
        if (!await AddDictType(fsql, "post_status", "文章状态")) { return false; }
        if (!await AddDictItem(fsql, "post_status", "1", "已发布", 1)) { return false; }
        return await AddDictItem(fsql, "post_status", "0", "草稿", 2);
    }

    static async bool AddDictType(IFreeSql fsql, string code, string name) {
        SysDictType t = new SysDictType();
        t.code = code;
        t.name = name;
        t.status = 1;
        t.description = "";
        t.createdAt = WebApp.NowSeconds();
        t.updatedAt = t.createdAt;
        int _id = await fsql.Insert<SysDictType>(t).ExecuteIdentityAsync();
        return _id > 0;
    }

    static async bool AddDictItem(IFreeSql fsql, string typeCode, string value,
                            string label, int sortOrder) {
        SysDictItem it = new SysDictItem();
        it.typeCode = typeCode;
        it.value = value;
        it.label = label;
        it.sortOrder = sortOrder;
        it.status = 1;
        it.createdAt = WebApp.NowSeconds();
        it.updatedAt = it.createdAt;
        int _id = await fsql.Insert<SysDictItem>(it).ExecuteIdentityAsync();
        return _id > 0;
    }

    static async bool SeedSettings(IFreeSql fsql) {
        int have = await fsql.Select<SysSiteSetting>().CountAsync();
        if (have > 0) {
            return await SeedFeatureSettings(fsql);
        }
        if (!await AddSetting(fsql, "基本", "site.title", "站点名称", "Zan",
            "text", "浏览器标题与页脚使用", 1)) { return false; }
        if (!await AddSetting(fsql, "基本", "site.subtitle", "副标题",
            "熟悉的语法，原生的速度", "text", "", 2)) { return false; }
        if (!await AddSetting(fsql, "基本", "site.description", "站点描述", "",
            "textarea", "写入首页 meta description", 3)) { return false; }
        if (!await AddSetting(fsql, "基本", "site.keywords", "关键词", "Zan,编译型语言,ZanWeb",
            "text", "逗号分隔，写入 meta keywords", 4)) { return false; }
        if (!await AddSetting(fsql, "备案", "site.icp", "ICP 备案号", "",
            "text", "显示在页脚并链接到工信部查询页", 10)) { return false; }
        if (!await AddSetting(fsql, "备案", "site.police", "公安备案号", "",
            "text", "", 11)) { return false; }
        if (!await AddSetting(fsql, "页脚", "site.copyright", "版权信息", "",
            "text", "", 20)) { return false; }
        if (!await AddSetting(fsql, "页脚", "site.contact", "联系方式", "",
            "text", "", 21)) { return false; }
        if (!await AddSetting(fsql, "统计", "site.analytics", "统计代码", "",
            "textarea", "原样输出到页面底部，只接受可信来源的脚本", 30)) { return false; }
        return await SeedFeatureSettings(fsql);
    }

    static async bool SeedFeatureSettings(IFreeSql fsql) {
        if (!await EnsureSetting(fsql, "内容与评论", "blog.comment.enabled",
            "开放评论", "1", "switch", "关闭后前台不再显示评论框，已有评论仍可在后台查看", 40)) { return false; }
        if (!await EnsureSetting(fsql, "内容与评论", "blog.comment.review",
            "评论需审核", "1", "switch", "开启时新评论要在后台通过后才公开显示", 41)) { return false; }
        if (!await EnsureSetting(fsql, "基本", "site.timezone", "时区偏移",
            "480", "text",
            "与 UTC 的分钟偏移，例如 480 表示 UTC+8（北京时间）；服务器在境外时按此换算显示",
            5)) { return false; }
        if (!await EnsureSetting(fsql, "基本", "site.language", "界面语言",
            "zh-CN", "text",
            "管理后台界面语言：zh-CN 或 en-US；语言包在部署目录 i18n/ 下", 6)) { return false; }
        if (!await EnsureSetting(fsql, "基本", "site.url", "站点地址",
            "", "text",
            "如 https://example.com；RSS、sitemap、robots 用它拼绝对链接，留空则按请求的 Host 推导",
            7)) { return false; }
        if (!await EnsureSetting(fsql, "注册登录", "auth.register.enabled",
            "开放注册", "0", "switch", "关闭后前台隐藏注册入口并拒绝注册请求", 50)) { return false; }
        if (!await EnsureSetting(fsql, "注册登录", "auth.register.verify",
            "注册需邮箱验证码", "1", "switch", "需要先配置好邮件服务", 51)) { return false; }
        if (!await EnsureSetting(fsql, "注册登录", "auth.reset.enabled",
            "允许找回密码", "1", "switch", "通过邮箱验证码重设密码", 52)) { return false; }
        if (!await EnsureSetting(fsql, "邮件服务", "mail.host", "SMTP 主机", "",
            "text", "例如 smtp.qq.com", 60)) { return false; }
        if (!await EnsureSetting(fsql, "邮件服务", "mail.port", "端口", "465",
            "text", "465 直连 TLS，587 STARTTLS，25 明文", 61)) { return false; }
        if (!await EnsureSetting(fsql, "邮件服务", "mail.ssl", "使用 TLS", "1",
            "switch", "465 端口保持开启", 62)) { return false; }
        if (!await EnsureSetting(fsql, "邮件服务", "mail.user", "账号", "",
            "text", "", 63)) { return false; }
        if (!await EnsureSetting(fsql, "邮件服务", "mail.pass", "密码 / 授权码", "",
            "password", "多数邮箱要求使用授权码而不是登录密码", 64)) { return false; }
        if (!await EnsureSetting(fsql, "邮件服务", "mail.from", "发件邮箱", "",
            "text", "留空则使用账号", 65)) { return false; }
        if (!await EnsureSetting(fsql, "邮件服务", "mail.fromName", "发件人名称", "",
            "text", "", 66)) { return false; }
        if (!await EnsureSetting(fsql, "AI 助手", "ai.enabled", "启用助手", "0",
            "switch", "开启后右下角的助手可以对话", 70)) { return false; }
        if (!await EnsureSetting(fsql, "AI 助手", "ai.provider", "服务商", "deepseek",
            "text", "从下方预设中选择后自动填写", 71)) { return false; }
        if (!await EnsureSetting(fsql, "AI 助手", "ai.baseUrl", "接口地址",
            "https://api.deepseek.com/v1", "text",
            "OpenAI 兼容协议，末尾不带 /chat/completions", 72)) { return false; }
        if (!await EnsureSetting(fsql, "AI 助手", "ai.apiKey", "API Key", "",
            "password", "只保存在服务端，页面不回显", 73)) { return false; }
        if (!await EnsureSetting(fsql, "AI 助手", "ai.model", "模型",
            "deepseek-chat", "text", "", 74)) { return false; }
        if (!await EnsureSetting(fsql, "AI 助手", "ai.temperature", "温度", "0.3",
            "number", "0 更稳定，1 更发散", 75)) { return false; }
        return await EnsureSetting(fsql, "开发", "gen.root", "源码目录", "..",
            "text", "生成代码写入此目录，相对服务进程工作目录解释；需为包含 src 与 views 的应用源码根目录，生产发布建议填绝对路径", 80);
    }

    static async bool EnsureSetting(IFreeSql fsql, string groupName, string name,
                                string label, string value, string kind,
                                string tip, int sortOrder) {
        int have = await fsql.Select<SysSiteSetting>()
            .Where(a => a.name == name).CountAsync();
        if (have > 0) { return true; }
        return await AddSetting(fsql, groupName, name, label, value, kind, tip, sortOrder);
    }

    static async bool AddSetting(IFreeSql fsql, string groupName, string name,
                             string label, string value, string kind,
                             string tip, int sortOrder) {
        SysSiteSetting s = new SysSiteSetting();
        s.groupName = groupName;
        s.name = name;
        s.label = label;
        s.value = value;
        s.kind = kind;
        s.tip = tip;
        s.sortOrder = sortOrder;
        s.updatedAt = WebApp.NowSeconds();
        int _id = await fsql.Insert<SysSiteSetting>(s).ExecuteIdentityAsync();
        return _id > 0;
    }

    /* ---- 业务种子挂点 ---- */
    /* 应用侧经 Schema.OnSeed 注册自己的业务种子（业务模型与 DAO 都在应用内），
       启动时在系统种子之后、同一连接上执行；未注册即 no-op。 */
    static SeedFn onSeed;

    /* 注册业务种子。fn 收到与系统种子相同的 FreeSql 门面（同一引导连接派生）；
       返回 false 视为种子未完成（服务器仍启动，与库不可达同语义）。 */
    static void OnSeed(SeedFn fn) {
        onSeed = fn;
    }

    /* 供 Ensure 调用：未注册业务种子时直接成功。 */
    static async bool RunSeed(IFreeSql fsql) {
        if (onSeed == null) { return true; }
        return await onSeed(fsql);
    }

    
    /* ---- 路由派生授权 ---- */
    /* 存在的权限 = 路由表。部署决策写入 sys_role_grant 行。内置 admin 始终覆盖全部管理屏，内置 editor 始终覆盖内容屏。本方法只 INSERT，操作者撤销的权限不会被重新添加。*/

    /* 将 mask=0 的旧授权行按 screen 合并为一条屏掩码行；仅 mask=0 的行参与，第二次启动起即 no-op。未声明位的 action 丢弃并在 Perm.Index boot 行提示。*/
    static async bool MigrateGrants(IFreeSql fsql) {
        List<SysRoleGrant> old = await fsql.Select<SysRoleGrant>()
            .Where(a => a.mask == 0).ToListAsync();
        if (old.Count == 0) { return true; }

        List<string> keys = new List<string>();
        List<int> masks = new List<int>();
        for (int i = 0; i < old.Count; i = i + 1) {
            SysRoleGrant g = old[i];
            int bit = Perm.BitOf(g.action);
            if (bit == 0) { continue; }
            string key = Convert.ToString(g.roleId) + "|"
                + Perm.ScreenOf(g.action);
            int at = keys.IndexOf(key);
            if (at < 0) { keys.Add(key); masks.Add(bit); }
            else { masks[at] = masks[at] | bit; }
        }

        int _gone = await fsql.Delete<SysRoleGrant>().Where(a => a.mask == 0)
            .ExecuteAffrowsAsync();
        long now = WebApp.NowSeconds();
        for (int i = 0; i < keys.Count; i = i + 1) {
            string key = keys[i];
            int bar = key.IndexOf("|");
            int roleId = Convert.ToInt32(key.Substring(0, bar));
            string screen = key.Substring(bar + 1);
            SysRoleGrant have = await fsql.Select<SysRoleGrant>()
                .Where(a => a.roleId == roleId && a.action == screen)
                .FirstAsync();
            if (have != null) {
                int merged = have.mask | masks[i];
                int _n = await fsql.Update<SysRoleGrant>()
                    .Set(a => a.mask, merged)
                    .Where(a => a.id == have.id).ExecuteAffrowsAsync();
                continue;
            }
            if (!await Grant(fsql, roleId, screen, masks[i], now)) { return false; }
        }
        Console.WriteLine("[rbac] 旧授权已合并为 "
            + Convert.ToString(keys.Count) + " 条屏掩码");
        return true;
    }

    /* 将不再存在的旧屏键迁移到带模块前缀的新键；无匹配或多匹配的不动并在日志中标出。*/
    static async bool MigrateGrantKeys(IFreeSql fsql) {
        List<SysRoleGrant> rows = await fsql.Select<SysRoleGrant>()
            .Where(a => a.mask != 0).ToListAsync();
        int moved = 0;
        List<string> stray = new List<string>();
        for (int i = 0; i < rows.Count; i = i + 1) {
            SysRoleGrant g = rows[i];
            if (Perm.MaskOf(g.action) != 0) { continue; }
            string now = Perm.Qualify(g.action);
            if (now.Length == 0) { stray.Add(g.action); continue; }
            int gid = g.id;
            int _n = await fsql.Update<SysRoleGrant>().Set(a => a.action, now)
                .Where(a => a.id == gid).ExecuteAffrowsAsync();
            moved = moved + 1;
        }
        if (moved > 0) {
            Console.WriteLine("[rbac] " + Convert.ToString(moved)
                + " 条授权已改用带模块前缀的屏键");
        }
        if (stray.Count > 0) {
            Console.WriteLine("[rbac] " + Convert.ToString(stray.Count)
                + " 条授权的屏幕已不存在，保留未动: "
                + Perm.Join(stray, 8));
        }
        return true;
    }

    /* 给内置角色补发尚未持有的受控 action。每次启动安全，永不删除。*/
    static async bool SyncRoleGrants(WebApp app) {
        IDbConnection db = await AuthUser.Lease();
        if (db == null) { return false; }
        IFreeSql fsql = FreeSql.FromConnection(db);
        try {
            if (!await MigrateGrants(fsql)) { return false; }
            if (!await MigrateGrantKeys(fsql)) { return false; }
            SysRole admin = await fsql.Select<SysRole>()
                .Where(a => a.code == "admin").FirstAsync();
            SysRole editor = await fsql.Select<SysRole>()
                .Where(a => a.code == "editor").FirstAsync();
            if (admin == null && editor == null) { return true; }

            List<SysRoleGrant> rows = await fsql.Select<SysRoleGrant>().ToListAsync();
            string adminHas = ",";
            string editorHas = ",";
            for (int i = 0; i < rows.Count; i = i + 1) {
                SysRoleGrant g = rows[i];
                if (admin != null && g.roleId == admin.id) {
                    adminHas = adminHas + g.action + ",";
                }
                if (editor != null && g.roleId == editor.id) {
                    editorHas = editorHas + g.action + ",";
                }
            }

            bool fillAdmin = admin != null && adminHas == ",";
            bool fillEditor = editor != null && editorHas == ",";
            if (!fillAdmin && !fillEditor) { return true; }

            long now = WebApp.NowSeconds();
            List<Route> routes = app.router.All();
            List<string> screens = new List<string>();
            List<int> masks = new List<int>();
            List<bool> content = new List<bool>();
            for (int i = 0; i < routes.Count; i = i + 1) {
                Route r = routes[i];
                if (r.action.Length == 0 || !r.needsAuth) { continue; }
                int bit = Perm.BitOf(r.action);
                if (bit == 0) { continue; }
                string screen = Perm.ScreenOf(r.action);
                int at = screens.IndexOf(screen);
                if (at < 0) {
                    screens.Add(screen);
                    masks.Add(bit);
                    content.Add(IsContent(r.pattern));
                } else {
                    masks[at] = masks[at] | bit;
                    if (IsContent(r.pattern)) { content[at] = true; }
                }
            }
            for (int i = 0; i < screens.Count; i = i + 1) {
                if (fillAdmin && !await Grant(fsql, admin.id, screens[i], masks[i], now)) {
                    return false;
                }
                if (fillEditor && content[i] &&
                    !await Grant(fsql, editor.id, screens[i], masks[i], now)) {
                    return false;
                }
            }
            return true;
        } finally {
            AuthUser.Give(db);
        }
    }

    static bool IsContent(string pattern) {
        return pattern.StartsWith("/admin/content/") || pattern == "/admin";
    }

    /* 内置定时任务种子：日志清理默认启用（每天一次、保留 30 天），
       心跳为示例任务默认停用；只在空表时插入，管理员改动不被覆盖。 */
    static async bool SeedJobs(IFreeSql fsql) {
        int have = await fsql.Select<SysJob>().CountAsync();
        if (have > 0) { return true; }
        long now = WebApp.NowSeconds();
        SysJob cleanup = new SysJob();
        cleanup.name = "日志清理";
        cleanup.kind = "log.cleanup";
        cleanup.param = "30";
        cleanup.intervalSec = 86400;
        cleanup.enabled = 1;
        cleanup.lastRunAt = 0;
        cleanup.lastOk = 0;
        cleanup.lastMs = 0;
        cleanup.lastMessage = "";
        cleanup.runCount = 0;
        cleanup.createdAt = now;
        cleanup.updatedAt = now;
        int a = await fsql.Insert<SysJob>(cleanup).ExecuteIdentityAsync();
        SysJob ping = new SysJob();
        ping.name = "存活心跳";
        ping.kind = "ping";
        ping.param = "";
        ping.intervalSec = 60;
        ping.enabled = 0;
        ping.lastRunAt = 0;
        ping.lastOk = 0;
        ping.lastMs = 0;
        ping.lastMessage = "";
        ping.runCount = 0;
        ping.createdAt = now;
        ping.updatedAt = now;
        int b = await fsql.Insert<SysJob>(ping).ExecuteIdentityAsync();
        return a > 0 && b > 0;
    }

}
