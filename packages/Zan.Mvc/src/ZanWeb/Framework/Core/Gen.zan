using System;
using System.Data;
using System.Data.Orm;
using System.Text;
using System.Web;
using ZanWeb.Model;
using ZanWeb.Services;
using ZanWeb.Web;

namespace ZanWeb.Core;

/* 表设计器引擎：将设计（SysGenTable+SysGenColumn）生成 DDL 与 .zan 源码。标识符经 Safe() 校验，值使用参数绑定。 */
class Gen {
    /* 判断标识符是否安全：字母开头，仅含字母、数字与下划线（大小写
       均可——本包列名惯例是驼峰，如 sortOrder；与 stdlib QueryBuilder
       的 IsIdent 同口径，引号分号等注入通道一律拒绝）。 */
    static bool Safe(string name) {
        if (name == null) { return false; }
        int n = name.Length;
        if (n == 0 || n > 64) { return false; }
        for (int i = 0; i < n; i = i + 1) {
            string ch = name.Substring(i, 1);
            bool upper = ch >= "A" && ch <= "Z";
            bool lower = ch >= "a" && ch <= "z";
            bool digit = ch >= "0" && ch <= "9";
            if (i == 0 && !lower && !upper) { return false; }
            if (!lower && !upper && !digit && ch != "_") { return false; }
        }
        return true;
    }

    /* 源码标识符既不能逃逸目录，也不能是 Zan 关键字或生成类已有成员。 */
    static bool SafeCode(string name) {
        if (!Gen.Safe(name)) { return false; }
        string reserved = ",abstract,as,async,await,base,bool,break,case,catch,char,class,const,continue,decimal,default,delegate,do,double,else,enum,event,extern,false,finally,float,for,foreach,get,if,in,int,interface,internal,is,long,namespace,new,null,object,out,override,params,private,protected,public,return,set,short,static,string,struct,switch,this,throw,true,try,using,var,virtual,void,where,while,yield,ToRow,id,";
        return !reserved.Contains("," + name + ",");
    }

    /* 字面量只交给源码；HTML 文本另行按 HTML 语法编码。 */
    static string Literal(string text) {
        return text.Replace("\\", "\\\\").Replace("\"", "\\\"")
            .Replace("\r", "\\r").Replace("\n", "\\n").Replace("\t", "\\t");
    }

    static string Html(string text) {
        return text.Replace("&", "&amp;").Replace("<", "&lt;")
            .Replace(">", "&gt;").Replace("\"", "&quot;")
            .Replace("'", "&#39;");
    }

    /* 文档注释不能插入换行或伪造结束标记；它不是字符串字面量。 */
    static string Comment(string text) {
        return text.Replace("\r", " ").Replace("\n", " ")
            .Replace("&", "&amp;").Replace("<", "&lt;").Replace(">", "&gt;");
    }

    /* 从数据库恢复的旧设计也必须过同一入口校验，不能只依赖保存时检查。 */
    static bool Valid(SysGenTable t, List<SysGenColumn> cols) {
        if (!Gen.Safe(t.tableName) || t.tableName.ToLower().StartsWith("sys_")
            || !Gen.SafeCode(t.entityName) || !Gen.Safe(t.section)
            || t.entityName == "RowView" || t.entityName == "AdminController"
            || t.entityName == "AppController" || t.entityName == "Gen") { return false; }
        List<string> names = new List<string>();
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (!Gen.SafeCode(c.name) || names.Contains(c.name)
                || !(c.kind == "string" || c.kind == "text" || c.kind == "int"
                    || c.kind == "long" || c.kind == "decimal" || c.kind == "bool"
                    || c.kind == "datetime") || c.size < 0 || c.size > 4000) { return false; }
            names.Add(c.name);
        }
        return true;
    }

    /* 将设计列转为 DbColumnDef，自动加 identity id。 */
    static List<DbColumnDef> Columns(List<SysGenColumn> cols) {
        List<DbColumnDef> defs = new List<DbColumnDef>();
        defs.Add(DbColumnDef.Identity("id"));
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id") { continue; }
            DbColumnDef d = DbColumnDef.Of(c.name, c.kind).WithSize(c.size)
                .WithNull(c.nullable == 1);
            if (c.defValue.Length > 0) { d = d.WithDefault(c.defValue); }
            defs.Add(d);
        }
        return defs;
    }

    /* 建表或追加设计中有而表缺失的列，不删列不改类型。 */
    static async int Migrate(IDbConnection db, SysGenTable t, List<SysGenColumn> cols) {
        return await DbSchema.MigrateAsync(db, t.tableName, Gen.Columns(cols));
    }

    /* ---- 源码生成 ---- */

    /* 设计列类型到 Zan 类型的映射。 */
    static string ZanType(string kind) {
        if (kind == "int" || kind == "bool") { return "int"; }
        if (kind == "long" || kind == "datetime") { return "long"; }
        if (kind == "decimal") { return "double"; }
        return "string";
    }

    /* 设计器字段类型 → 列表展示形态（见 ListPage.Col）。 */
    static string ColKind(string kind) {
        if (kind == "int" || kind == "long" || kind == "decimal") { return "num"; }
        if (kind == "datetime") { return "time"; }
        if (kind == "text") { return "muted"; }
        return "text";
    }

    /* 生成实体类源码。 */
    static string ModelSource(SysGenTable t, List<SysGenColumn> cols) {
        StringBuilder b = new StringBuilder();
        b.Append("using System;\nusing System.Data.Orm;\nusing ZanWeb.Web;\n\nnamespace ZanWeb.Model.Gen;\n\n");
        b.Append("/// <summary>" + Gen.Comment(t.title) + "。由表设计器生成，可直接修改。</summary>\n");
        b.Append("[Table(Name = \"" + t.tableName + "\")]\n");
        b.Append("class " + t.entityName + " : RowView {\n");
        b.Append("    [Column(IsIdentity = true)]\n    int id;\n");
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id") { continue; }
            b.Append("\n");
            if (c.label.Length > 0) {
                b.Append("    /// <summary>" + Gen.Comment(c.label) + "</summary>\n");
            }
            if (c.kind == "string") {
                b.Append("    [Column(StringLength = "
                    + Convert.ToString(Gen.Size(c)) + ")]\n");
            }
            b.Append("    " + Gen.ZanType(c.kind) + " " + c.name + ";\n");
        }
        /* 视图行自述投影：管理列表与前台列表的键集并集，datetime 出人读日。 */
        b.Append("\n    public void ToRow(StrMap row) {\n");
        b.Append("        row.Set(\"id\", Convert.ToString(this.id));\n");
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id" || c.inList != 1) { continue; }
            if (c.kind == "datetime") {
                b.Append("        row.Set(\"" + c.name
                    + "\", Fmt.Day(this." + c.name + "));\n");
            } else if (c.kind == "bool") {
                b.Append("        if (this." + c.name
                    + " == 1) { row.Set(\"" + c.name + "\", \"1\"); }\n");
            } else if (Gen.ZanType(c.kind) == "string") {
                b.Append("        row.Set(\"" + c.name + "\", this."
                    + c.name + ");\n");
            } else {
                b.Append("        row.Set(\"" + c.name
                    + "\", Convert.ToString(this." + c.name + "));\n");
            }
        }
        /* 第一个 text/长文本出摘要；没有就不出。 */
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.kind == "text" && c.name != "id") {
                b.Append("        row.Set(\"summary\", Prose.Excerpt(this."
                    + c.name + ", 120));\n");
                break;
            }
        }
        b.Append("    }\n");
        b.Append("}\n");
        return b.ToString();
    }

    static int Size(SysGenColumn c) {
        if (c.size > 0) { return c.size; }
        return 255;
    }

    /* 生成管理控制器源码（列表/表单/保存/删除），命名与路由一致。 */
    /* 生成模块的 URL 路径（section/表名），侧边栏共享此 URL。 */
    static string Route(SysGenTable t) {
        string sec = t.section;
        if (!Gen.Safe(sec)) { sec = "content"; }
        return sec + "/" + t.tableName.Replace("_", "");
    }

    /* 设计的默认排序列：必须是设计里真实存在的列（id 不在列清单里，单独放行），否则回落 id。 */
    static string OrderCol(SysGenTable t, List<SysGenColumn> cols) {
        if (t.orderColumn == "id") { return "id"; }
        if (Gen.SafeCode(t.orderColumn)) {
            for (int i = 0; i < cols.Count; i = i + 1) {
                if (cols[i].name == t.orderColumn) { return t.orderColumn; }
            }
        }
        return "id";
    }

    /* 关联列的取值/标签列名：设计器默认 id/name，非法配置回落 id——
       这些名字要进 emitted 的 DbTable 查询，不能带着注入通道出去。 */
    static string RelValue(SysGenColumn c) {
        if (Gen.SafeCode(c.relValue)) { return c.relValue; }
        return "id";
    }

    static string RelLabel(SysGenColumn c) {
        if (Gen.SafeCode(c.relLabel)) { return c.relLabel; }
        return "id";
    }

    /* 关联下拉只在 relTable 是本设计器里的一张表时才服务端喂数；
       指向陌生表时没有可靠的标签列，退回普通输入框。 */
    static bool RelDesigned(SysGenColumn c, List<string> designed) {
        return c.relTable.Length > 0 && Gen.Safe(c.relTable)
            && designed.Contains(c.relTable);
    }

    static string ControllerSource(SysGenTable t, List<SysGenColumn> cols,
        List<string> designed) {
        string cls = t.entityName + "Controller";
        string mdl = "ZanWeb.Model.Gen." + t.entityName;
        string route = Gen.Route(t);
        string orderCol = Gen.OrderCol(t, cols);
        string orderCall = "OrderBy(a => a." + orderCol + ")";
        if (t.orderDesc == 1) { orderCall = "OrderByDescending(a => a." + orderCol + ")"; }
        bool hasDict = false;
        bool hasRelLabel = false;
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id") { continue; }
            if (c.dictType.Length > 0 && Gen.Safe(c.dictType)) { hasDict = true; }
            if (Gen.RelDesigned(c, designed)) { hasRelLabel = true; }
        }
        StringBuilder b = new StringBuilder();
        b.Append("using System;\nusing System.Data;\nusing System.Data.Orm;\n");
        b.Append("using System.Web;\nusing ZanWeb.Core;\n");
        b.Append("using ZanWeb.Dao;\nusing ZanWeb.Model;\n");
        b.Append("using ZanWeb.Security;\nusing ZanWeb.Web;\nusing ZanWeb.Services;\n\n");
        b.Append("namespace ZanWeb.Admin;\n\n");
        b.Append("/// <summary>" + Gen.Comment(t.title)
            + " 管理。由表设计器生成，可直接修改。</summary>\n");
        b.Append("[Route(\"admin/" + route + "/[action]\")]\n");
        b.Append("[Custom(Authorization = CustomAuthorization.Grant)]\n");
        b.Append("[Description(\"" + Gen.Literal(t.title) + "\")]\n");
        b.Append("class " + cls + " : AdminController {\n");

        /* 本屏唯一声明：列、筛选、行内写动作白名单。字典与关联的选项是运行时
           数据，按请求查好拼进声明；设计器元数据在生成期展开——改列回到设计器
           重新生成即可。 */
        b.Append("    async ListPage Screen() {\n");
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id" || (c.inList != 1 && c.inFilter != 1)) { continue; }
            if (c.dictType.Length > 0 && Gen.Safe(c.dictType)) {
                b.Append("        string " + c.name + "Opts = \"\";\n");
                b.Append("        List<SysDictItem> " + c.name
                    + "Items = await new SysDictItemDao(this).ByTypeCodeActive(\""
                    + Gen.Literal(c.dictType) + "\");\n");
                b.Append("        for (int i = 0; i < " + c.name
                    + "Items.Count; i = i + 1) {\n");
                b.Append("            if (" + c.name
                    + "Opts.Length > 0) { " + c.name + "Opts = " + c.name + "Opts + \",\"; }\n");
                b.Append("            " + c.name + "Opts = " + c.name + "Opts + " + c.name
                    + "Items[i].value + \"=\" + " + c.name + "Items[i].label;\n");
                b.Append("        }\n");
            } else if (Gen.RelDesigned(c, designed)) {
                b.Append("        string " + c.name + "Opts = \"\";\n");
                b.Append("        DbResult " + c.name + "Rows = await DbTable.Of(this.Held(), \""
                    + c.relTable + "\").Query()\n");
                b.Append("            .OrderBy(\"" + Gen.RelLabel(c)
                    + "\").Limit(100).ToResultAsync();\n");
                b.Append("        if (" + c.name + "Rows != null) {\n");
                b.Append("            int " + c.name + "V = " + c.name
                    + "Rows.GetColumnIndex(\"" + Gen.RelValue(c) + "\");\n");
                b.Append("            int " + c.name + "L = " + c.name
                    + "Rows.GetColumnIndex(\"" + Gen.RelLabel(c) + "\");\n");
                b.Append("            if (" + c.name + "V >= 0 && " + c.name + "L >= 0) {\n");
                b.Append("                for (int i = 0; i < " + c.name
                    + "Rows.RowCount(); i = i + 1) {\n");
                b.Append("                    if (" + c.name
                    + "Opts.Length > 0) { " + c.name + "Opts = " + c.name + "Opts + \",\"; }\n");
                b.Append("                    " + c.name + "Opts = " + c.name + "Opts + " + c.name
                    + "Rows.GetString(i, " + c.name + "V) + \"=\" + " + c.name
                    + "Rows.GetString(i, " + c.name + "L);\n");
                b.Append("                }\n");
                b.Append("            }\n");
                b.Append("        }\n");
            }
        }
        b.Append("        return ListPage.Of()\n");
        b.Append("            .Col(\"id\", \"ID\", \"num\", \"56px\")\n");
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id" || c.inList != 1) { continue; }
            string width = "";
            if (Gen.ColKind(c.kind) == "num") { width = "90px"; }
            if (c.kind == "datetime") { width = "130px"; }
            string label = Gen.Literal(Gen.LabelOf(c));
            bool dictFed = c.dictType.Length > 0 && Gen.Safe(c.dictType);
            bool relFed = Gen.RelDesigned(c, designed);
            if (c.kind == "bool") {
                b.Append("            .Tag(\"" + c.name + "\", \"" + label
                    + "\", \"1=是|ok,0=否|off\", \"" + width + "\")\n");
            } else if (dictFed) {
                b.Append("            .Tag(\"" + c.name + "\", \"" + label + "\", " + c.name
                    + "Opts, \"" + width + "\")\n");
            } else if (relFed) {
                b.Append("            .Col(\"" + c.name + "Name\", \"" + label
                    + "\", \"text\", \"" + width + "\")\n");
            } else {
                b.Append("            .Col(\"" + c.name + "\", \"" + label
                    + "\", \"" + Gen.ColKind(c.kind) + "\", \"" + width + "\")\n");
            }
        }
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id" || c.inFilter != 1) { continue; }
            string label = Gen.Literal(Gen.LabelOf(c));
            bool dictFed = c.dictType.Length > 0 && Gen.Safe(c.dictType);
            bool relFed = Gen.RelDesigned(c, designed);
            if (c.kind == "bool") {
                b.Append("            .Select(\"" + label + "\", \"" + c.name + "\", \""
                    + c.name + "\", \"1=是,0=否\")\n");
            } else if (dictFed || relFed) {
                b.Append("            .Select(\"" + label + "\", \"" + c.name + "\", \""
                    + c.name + "\", " + c.name + "Opts)\n");
            } else if (c.kind == "datetime") {
                b.Append("            .Time(\"" + label + "\", \"" + c.name + "\", \""
                    + c.name + "\")\n");
            } else if (Gen.ZanType(c.kind) == "string") {
                b.Append("            .Text(\"" + label + "\", \"" + c.name + "\", \""
                    + c.name + "\", \"" + label + " 模糊搜索\")\n");
            } else {
                b.Append("            .Text(\"" + label + "\", \"" + c.name + "\", \""
                    + c.name + "\", \"" + label + " 精确值\")\n");
            }
        }
        b.Append("            .OpsEdit(\"/admin/" + route + "/form\")\n");
        b.Append("            .OpsDel(\"/admin/" + route + "/delete\", \"确定删除吗？\")\n");
        b.Append("            .Table(\"" + t.tableName + "\")\n");
        b.Append("            .EditFields(\"");
        string edits = "";
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id" || c.inEdit != 1) { continue; }
            bool fed = (c.dictType.Length > 0 && Gen.Safe(c.dictType))
                || Gen.RelDesigned(c, designed);
            if (fed || c.kind == "datetime") { continue; }
            if (edits.Length > 0) { edits = edits + ","; }
            string ft = "text";
            if (c.kind == "int" || c.kind == "long") { ft = "int"; }
            edits = edits + c.name + ":" + ft;
        }
        b.Append(edits + "\")\n");
        b.Append("            ;\n    }\n");

        if (hasDict) {
            b.Append("\n    /* 字典值合法性：空值看必填，非空必须命中该字典类型的活动项。 */\n");
            b.Append("    async string CheckDict(string typeCode, string label, string value, bool required) {\n");
            b.Append("        if (value.Length == 0) { return required ? \"请选择\" + label : \"\"; }\n");
            b.Append("        List<SysDictItem> items = await new SysDictItemDao(this).ByTypeCodeActive(typeCode);\n");
            b.Append("        for (int i = 0; i < items.Count; i = i + 1) {\n");
            b.Append("            if (items[i].value == value) { return \"\"; }\n");
            b.Append("        }\n");
            b.Append("        return label + \" 的值不在选项内\";\n");
            b.Append("    }\n");
        }

        b.Append("\n    [HttpGet]\n    [Route(\"/admin/" + route + "\")]\n");
        b.Append("    [Custom(IsMenu = true, Perm = PermBit.View)]\n");
        b.Append("    [Description(\"" + Gen.Literal(t.title) + "列表\")]\n");
        b.Append("    async void Index() {\n");
        b.Append("        ViewData d = await this.Layout(\"" + Gen.Literal(t.title) + "\");\n");
        b.Append("        if (!this.DbReady()) { d.Set(\"dbDown\", \"1\"); this.Page(d); return; }\n");
        b.Append("        ListPage lp = await this.Screen();\n");
        b.Append("        List<OrmCond> conds = lp.Collect(this);\n");
        b.Append("        ListQuery q = this.Paged(\"" + orderCol + "\", 20);\n");
        /* 筛选局部变量：语义与 ListPage.Collect 逐条对齐（文本非空 LIKE、下拉跳过
           空串与 -1、时间走 ParseDay 的 From/To），查询侧用发射的 WhereIf。 */
        string whereLines = "";
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id" || c.inFilter != 1) { continue; }
            bool fed = (c.dictType.Length > 0 && Gen.Safe(c.dictType))
                || Gen.RelDesigned(c, designed);
            if (c.kind == "datetime") {
                b.Append("        long f" + c.name + "F = Fmt.ParseDay(this.InAny(\""
                    + c.name + "From\").Trim());\n");
                b.Append("        long f" + c.name + "T = Fmt.ParseDay(this.InAny(\""
                    + c.name + "To\").Trim());\n");
                whereLines = whereLines + "            .WhereIf(f" + c.name
                    + "F > 0, a => a." + c.name + " >= f" + c.name + "F)\n";
                whereLines = whereLines + "            .WhereIf(f" + c.name
                    + "T > 0, a => a." + c.name + " <= f" + c.name + "T + 86399)\n";
            } else if (Gen.ZanType(c.kind) == "string") {
                b.Append("        string f" + c.name + " = this.InAny(\"" + c.name
                    + "\").Trim();\n");
                if (fed) {
                    whereLines = whereLines + "            .WhereIf(f" + c.name
                        + ".Length > 0 && f" + c.name + " != \"-1\", a => a." + c.name
                        + " == f" + c.name + ")\n";
                } else {
                    whereLines = whereLines + "            .WhereIf(f" + c.name
                        + ".Length > 0, a => a." + c.name + ".Contains(f" + c.name + "))\n";
                }
            } else if (c.kind == "bool") {
                b.Append("        int f" + c.name + "N = Filter.ToInt(this.InAny(\"" + c.name
                    + "\").Trim(), -1);\n");
                whereLines = whereLines + "            .WhereIf(f" + c.name
                    + "N >= 0, a => a." + c.name + " == f" + c.name + "N)\n";
            } else if (c.kind == "int" || c.kind == "long") {
                if (fed) {
                    /* 下拉语义对齐 Collect：空串与 -1 跳过，0 是合法字典值。 */
                    if (c.kind == "int") {
                        b.Append("        int f" + c.name + "N = Filter.ToInt(this.InAny(\""
                            + c.name + "\").Trim(), -1);\n");
                    } else {
                        b.Append("        long f" + c.name + "N = Filter.ToLong(this.InAny(\""
                            + c.name + "\").Trim(), -1);\n");
                    }
                    whereLines = whereLines + "            .WhereIf(f" + c.name
                        + "N >= 0, a => a." + c.name + " == f" + c.name + "N)\n";
                } else {
                    b.Append("        string f" + c.name + "R = this.InAny(\"" + c.name
                        + "\").Trim();\n");
                    b.Append("        long f" + c.name + "N = Filter.ToLong(f" + c.name
                        + "R, 0);\n");
                    whereLines = whereLines + "            .WhereIf(f" + c.name
                        + "R.Length > 0, a => a." + c.name + " == f" + c.name + "N)\n";
                }
            } else if (Gen.ZanType(c.kind) == "double") {
                b.Append("        string f" + c.name + "R = this.InAny(\"" + c.name
                    + "\").Trim();\n");
                b.Append("        double f" + c.name + "N = f" + c.name
                    + "R.Length > 0 ? Filter.ToDouble(f" + c.name + "R, 0.0) : 0.0;\n");
                whereLines = whereLines + "            .WhereIf(f" + c.name
                    + "R.Length > 0, a => a." + c.name + " == f" + c.name + "N)\n";
            }
        }
        b.Append("        int total = await this." + t.entityName + "\n");
        b.Append(whereLines);
        b.Append("            .CountAsync();\n");
        b.Append("        List<" + mdl + "> rows = await this." + t.entityName + "\n");
        b.Append(whereLines);
        b.Append("            ." + orderCall + "\n");
        b.Append("            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();\n");
        b.Append("        List<StrMap> items = d.AddList(\"rows\");\n");
        b.Append("        Rows.Project(rows, items);\n");
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id" || c.inList != 1 || !Gen.RelDesigned(c, designed)) { continue; }
            b.Append("        StrMap " + c.name + "Names = new StrMap();\n");
            b.Append("        DbResult " + c.name + "Rows = await DbTable.Of(this.Held(), \""
                + c.relTable + "\").Query()\n");
            b.Append("            .OrderBy(\"" + Gen.RelLabel(c)
                + "\").Limit(500).ToResultAsync();\n");
            b.Append("        if (" + c.name + "Rows != null) {\n");
            b.Append("            int " + c.name + "V = " + c.name
                + "Rows.GetColumnIndex(\"" + Gen.RelValue(c) + "\");\n");
            b.Append("            int " + c.name + "L = " + c.name
                + "Rows.GetColumnIndex(\"" + Gen.RelLabel(c) + "\");\n");
            b.Append("            if (" + c.name + "V >= 0 && " + c.name + "L >= 0) {\n");
            b.Append("                for (int i = 0; i < " + c.name
                + "Rows.RowCount(); i = i + 1) {\n");
            b.Append("                    " + c.name + "Names.Set(" + c.name
                + "Rows.GetString(i, " + c.name + "V), " + c.name + "Rows.GetString(i, "
                + c.name + "L));\n");
            b.Append("                }\n");
            b.Append("            }\n");
            b.Append("        }\n");
            b.Append("        for (int i = 0; i < items.Count; i = i + 1) {\n");
            b.Append("            items[i].Set(\"" + c.name + "Name\", " + c.name
                + "Names.Get(items[i].Get(\"" + c.name + "\")));\n");
            b.Append("        }\n");
        }
        b.Append("        string path = this.Ctx().path;\n");
        b.Append("        bool canCreate = await this.Can(PermBit.Create);\n");
        b.Append("        bool canUpdate = await this.Can(PermBit.Update);\n");
        b.Append("        bool canDelete = await this.Can(PermBit.Delete);\n");
        b.Append("        lp.Screen(this, d, path, \"/admin/" + route
            + "\", conds, q, total, items, canCreate, canUpdate, canDelete);\n");
        b.Append("        this.Page(d);\n    }\n\n");

        /* 表格配置契约：本屏声明 → adminUI ZanTable 的 ListConfData JSON。 */
        b.Append("    [HttpGet]\n    [Custom(Perm = PermBit.View)]\n");
        b.Append("    [Description(\"" + Gen.Literal(t.title) + "表格配置\")]\n");
        b.Append("    async void Conf() {\n");
        b.Append("        CrudOps.Conf(this, await this.Screen());\n");
        b.Append("    }\n\n");

        b.Append("    [HttpPost]\n    [Custom(Perm = PermBit.Update)]\n");
        b.Append("    [Description(\"编辑" + Gen.Literal(t.title) + "字段\")]\n");
        b.Append("    async void Field() {\n");
        b.Append("        int id = this.InInt(\"id\", 0);\n");
        b.Append("        " + mdl + " cur = await this." + t.entityName + ".Read(id);\n");
        b.Append("        List<int> allowed = new List<int>();\n");
        b.Append("        if (cur != null) { allowed.Add(id); }\n");
        b.Append("        await CrudOps.Field(this, await this.Screen(), \"" + Gen.Literal(t.title)
            + "\", this.In(\"field\").Trim(), this.In(\"value\"), allowed);\n");
        b.Append("    }\n\n");

        b.Append("    [HttpPost]\n    [Custom(Perm = PermBit.Delete)]\n");
        b.Append("    [Description(\"批量删除" + Gen.Literal(t.title) + "\")]\n");
        b.Append("    async void BatchDelete() {\n");
        b.Append("        await CrudOps.Delete(this, await this.Screen(),"
            + " this.Ids(\"ids\"), \"批量删除" + Gen.Literal(t.title) + "\");\n");
        b.Append("    }\n\n");

        b.Append("    [HttpGet]\n    [Custom(Perm = PermBit.Create | PermBit.Update)]\n");
        b.Append("    [Description(\"" + Gen.Literal(t.title) + "表单\")]\n");
        b.Append("    async void Form() {\n");
        b.Append("        int id = this.InInt(\"id\", 0);\n");
        b.Append("        if (!await this.Can(id > 0 ? (int)PermBit.Update : (int)PermBit.Create)) {\n");
        b.Append("            this.Fail(403, \"0403\", \"权限不足\"); return;\n        }\n");
        b.Append("        " + mdl + " e = null;\n");
        b.Append("        if (id > 0) {\n");
        b.Append("            e = await this." + t.entityName + ".Read(id);\n");
        b.Append("            if (e == null) { this.Fail(404, \"0404\", \"记录不存在\"); }\n");
        b.Append("        }\n");
        b.Append("        ViewData d = new ViewData();\n");
        b.Append("        d.Set(\"id\", Convert.ToString(id));\n");
        b.Append("        d.Set(id > 0 ? \"editing\" : \"creating\", \"1\");\n");
        b.Append("        d.Set(\"dialogTitle\", id > 0 ? \"编辑" + Gen.Literal(t.title)
            + "\" : \"新增" + Gen.Literal(t.title) + "\");\n");
        b.Append("        if (e != null) {\n");
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id" || c.inEdit != 1) { continue; }
            if (c.kind == "datetime") {
                b.Append("            d.Set(\"" + c.name + "\", e." + c.name
                    + " > 0 ? Fmt.DayInput(e." + c.name + ") : \"\");\n");
            } else if (Gen.ZanType(c.kind) == "string") {
                b.Append("            d.Set(\"" + c.name + "\", e." + c.name + ");\n");
            } else {
                b.Append("            d.Set(\"" + c.name
                    + "\", Convert.ToString(e." + c.name + "));\n");
            }
        }
        b.Append("        }\n");
        /* 字典/关联下拉的服务端喂数：选项行 {value,label,selected}；当前值不在
           选项集里时补 {name}None，视图用保留行显示原值，避免静默改数据。 */
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id" || (c.inCreate != 1 && c.inEdit != 1)) { continue; }
            bool dictFed = c.dictType.Length > 0 && Gen.Safe(c.dictType);
            bool relFed = Gen.RelDesigned(c, designed);
            if (!dictFed && !relFed) { continue; }
            string count = "";
            string vexpr = "";
            string lexpr = "";
            if (dictFed) {
                b.Append("        List<StrMap> " + c.name + "Opts = d.AddList(\"" + c.name + "Opts\");\n");
                b.Append("        List<SysDictItem> " + c.name
                    + "Items = await new SysDictItemDao(this).ByTypeCodeActive(\""
                    + Gen.Literal(c.dictType) + "\");\n");
                count = c.name + "Items.Count";
                vexpr = c.name + "Items[i].value";
                lexpr = c.name + "Items[i].label";
            } else {
                b.Append("        List<StrMap> " + c.name + "Opts = d.AddList(\"" + c.name + "Opts\");\n");
                b.Append("        DbResult " + c.name + "Rows = await DbTable.Of(this.Held(), \""
                    + c.relTable + "\").Query()\n");
                b.Append("            .OrderBy(\"" + Gen.RelLabel(c)
                    + "\").Limit(100).ToResultAsync();\n");
                b.Append("        int " + c.name + "N = 0;\n");
                b.Append("        int " + c.name + "V = -1;\n");
                b.Append("        int " + c.name + "L = -1;\n");
                b.Append("        if (" + c.name + "Rows != null) {\n");
                b.Append("            " + c.name + "N = " + c.name + "Rows.RowCount();\n");
                b.Append("            " + c.name + "V = " + c.name + "Rows.GetColumnIndex(\""
                    + Gen.RelValue(c) + "\");\n");
                b.Append("            " + c.name + "L = " + c.name + "Rows.GetColumnIndex(\""
                    + Gen.RelLabel(c) + "\");\n");
                b.Append("        }\n");
                count = c.name + "N";
                vexpr = c.name + "Rows.GetString(i, " + c.name + "V)";
                lexpr = c.name + "Rows.GetString(i, " + c.name + "L)";
            }
            b.Append("        bool " + c.name + "Hit = false;\n");
            b.Append("        for (int i = 0; i < " + count + "; i = i + 1) {\n");
            b.Append("            StrMap o = new StrMap();\n");
            b.Append("            o.Set(\"value\", Convert.ToString(" + vexpr + "));\n");
            b.Append("            o.Set(\"label\", " + lexpr + ");\n");
            b.Append("            if (e != null && Convert.ToString(" + vexpr
                + ") == Convert.ToString(e." + c.name + ")) {\n");
            b.Append("                o.Set(\"selected\", \"1\");\n");
            b.Append("                " + c.name + "Hit = true;\n");
            b.Append("            }\n");
            b.Append("            " + c.name + "Opts.Add(o);\n");
            b.Append("        }\n");
            b.Append("        if (e != null && !" + c.name + "Hit) { d.Set(\"" + c.name
                + "None\", \"1\"); }\n");
        }
        b.Append("        this.Dialog(d);\n    }\n\n");

        b.Append("    [HttpPost]\n    [Custom(Perm = PermBit.Create | PermBit.Update)]\n");
        b.Append("    [Description(\"保存" + Gen.Literal(t.title) + "\")]\n");
        b.Append("    async void Save() {\n");
        b.Append("        int id = this.InInt(\"id\", 0);\n");
        b.Append("        if (!await this.Can(id > 0 ? (int)PermBit.Update : (int)PermBit.Create)) {\n");
        b.Append("            this.Fail(403, \"0403\", \"权限不足\"); return;\n        }\n");
        b.Append("        " + mdl + " e = new " + mdl + "();\n");
        b.Append("        if (id > 0) {\n");
        b.Append("            " + mdl + " cur = await this." + t.entityName + ".Read(id);\n");
        b.Append("            if (cur == null) { this.Fail(404, \"0404\", \"记录不存在\"); }\n");
        b.Append("            e = cur;\n        }\n");
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id" || (c.inCreate != 1 && c.inEdit != 1)) { continue; }
            if (c.inCreate != 1) { b.Append("        if (id > 0) {\n"); }
            if (c.inEdit != 1) { b.Append("        if (id == 0) {\n"); }
            string zt = Gen.ZanType(c.kind);
            string label = Gen.Literal(Gen.LabelOf(c));
            bool dictFed = c.dictType.Length > 0 && Gen.Safe(c.dictType);
            bool relFed = Gen.RelDesigned(c, designed);
            if (c.kind == "datetime") {
                /* 日期列：入参是 YYYY-MM-DD 文本，ParseDay 转秒存整型列。 */
                b.Append("        string " + c.name + "Raw = this.In(\"" + c.name + "\").Trim();\n");
                if (c.required == 1) {
                    b.Append("        if (" + c.name + "Raw.Length == 0) { this.Fail(400, \"0400\", \"请填写"
                        + label + "\"); return; }\n");
                }
                b.Append("        if (" + c.name + "Raw.Length > 0) {\n");
                b.Append("            e." + c.name + " = Fmt.ParseDay(" + c.name + "Raw);\n");
                b.Append("            if (e." + c.name + " <= 0) { this.Fail(400, \"0400\", \""
                    + label + " 格式应为 YYYY-MM-DD\"); return; }\n");
                if (c.required != 1) {
                    b.Append("        } else { e." + c.name + " = 0; }\n");
                } else {
                    b.Append("        }\n");
                }
            } else if (zt == "string") {
                if (c.required == 1) {
                    b.Append("        e." + c.name + " = this.Need(\"" + c.name
                        + "\", \"" + label + "\");\n");
                } else {
                    b.Append("        e." + c.name + " = this.In(\"" + c.name + "\");\n");
                }
            } else if (zt == "int") {
                b.Append("        e." + c.name + " = this.InInt(\"" + c.name + "\", 0);\n");
            } else if (zt == "long") {
                b.Append("        e." + c.name + " = this.InLong(\"" + c.name + "\", 0);\n");
            } else {
                b.Append("        e." + c.name + " = this.InDouble(\"" + c.name + "\", 0.0);\n");
            }
            if (dictFed && c.kind != "bool") {
                string vexpr = zt == "string" ? "e." + c.name
                    : "Convert.ToString(e." + c.name + ")";
                b.Append("        string " + c.name + "Err = await this.CheckDict(\""
                    + Gen.Literal(c.dictType) + "\", \"" + label + "\", " + vexpr + ", "
                    + (c.required == 1 ? "true" : "false") + ");\n");
                b.Append("        if (" + c.name + "Err.Length > 0) { this.Fail(400, \"0400\", "
                    + c.name + "Err); return; }\n");
            }
            if (relFed) {
                string relCheck = "DbResult " + c.name + "Chk = await DbTable.Of(this.Held(), \""
                    + c.relTable + "\").Query()\n                .WhereEq(\""
                    + Gen.RelValue(c) + "\", ";
                if (zt == "string") {
                    b.Append("        if (e." + c.name + ".Length > 0) {\n");
                    b.Append("            " + relCheck + "e." + c.name
                        + ").Limit(1).ToResultAsync();\n");
                    b.Append("            if (" + c.name + "Chk == null || " + c.name
                        + "Chk.RowCount() == 0) { this.Fail(400, \"0400\", \"" + label
                        + " 所选记录不存在\"); return; }\n");
                    b.Append("        }");
                } else {
                    b.Append("        if (e." + c.name + " > 0) {\n");
                    b.Append("            long " + c.name + "Id = e." + c.name + ";\n");
                    b.Append("            " + relCheck + c.name + "Id).Limit(1).ToResultAsync();\n");
                    b.Append("            if (" + c.name + "Chk == null || " + c.name
                        + "Chk.RowCount() == 0) { this.Fail(400, \"0400\", \"" + label
                        + " 所选记录不存在\"); return; }\n");
                    b.Append("        }");
                }
                if (c.required == 1) {
                    b.Append(" else {\n            this.Fail(400, \"0400\", \"请选择" + label
                        + "\"); return;\n        }\n");
                } else {
                    b.Append("\n");
                }
            } else if (zt != "string" && c.kind != "datetime" && c.kind != "bool"
                && c.required == 1) {
                string zero = c.kind == "decimal" ? "0.0" : "0";
                b.Append("        if (e." + c.name + " == " + zero
                    + ") { this.Fail(400, \"0400\", \"请填写" + label + "\"); return; }\n");
            }
            if (c.inCreate != 1 || c.inEdit != 1) { b.Append("        }\n"); }
        }
        b.Append("        if (id > 0) {\n");
        bool hasEdit = false;
        for (int i = 0; i < cols.Count; i = i + 1) {
            if (cols[i].name != "id" && cols[i].inEdit == 1) { hasEdit = true; }
        }
        if (hasEdit) {
            b.Append("            int n = await this." + t.entityName + ".Update()\n");
            for (int i = 0; i < cols.Count; i = i + 1) {
                SysGenColumn c = cols[i];
                if (c.name == "id" || c.inEdit != 1) { continue; }
                b.Append("                .Set(a => a." + c.name + ", e." + c.name + ")\n");
            }
            b.Append("                .Where(a => a.id == id).ExecuteAffrowsAsync();\n");
        } else {
            b.Append("            int n = 0;\n");
        }
        b.Append("            await this.Note(\"编辑" + Gen.Literal(t.title)
            + "\", Convert.ToString(id), n > 0, \"\");\n");
        b.Append("            this.Saved(\"已保存\");\n            return;\n        }\n");
        b.Append("        int newId = await this." + t.entityName
            + ".Insert(e).ExecuteIdentityAsync();\n");
        b.Append("        await this.Note(\"新增" + Gen.Literal(t.title)
            + "\", Convert.ToString(newId), newId > 0, \"\");\n");
        b.Append("        this.Saved(\"已创建\");\n    }\n\n");

        b.Append("    [HttpPost]\n    [Custom(Perm = PermBit.Delete)]\n");
        b.Append("    [Description(\"删除" + Gen.Literal(t.title) + "\")]\n");
        b.Append("    async void Delete() {\n");
        b.Append("        int id = this.InInt(\"id\", 0);\n");
        b.Append("        int n = await this." + t.entityName
            + ".Delete().Where(a => a.id == id).ExecuteAffrowsAsync();\n");
        b.Append("        await this.Note(\"删除" + Gen.Literal(t.title)
            + "\", Convert.ToString(id), n > 0, \"\");\n");
        b.Append("        this.Saved(\"已删除\");\n    }\n}\n");
        return b.ToString();
    }

    static string LabelOf(SysGenColumn c) {
        if (c.label.Length > 0) { return c.label; }
        return c.name;
    }

    /* 生成列表视图源码：表格由 ListPage.Screen 整段产出，视图只剩壳。 */
    static string ListViewSource(SysGenTable t, List<SysGenColumn> cols) {
        StringBuilder b = new StringBuilder();
        b.Append("<div class=\"card\">\n  {{{screenHtml}}}\n</div>\n");
        return b.ToString();
    }

    /* 生成表单视图源码。下拉由服务端喂数（Form 动作构建 {value,label,selected}
       选项行），date/richtext/upload 不再掉进 number/兜底分支。 */
    static string FormViewSource(SysGenTable t, List<SysGenColumn> cols,
        List<string> designed) {
        string route = Gen.Route(t);
        StringBuilder b = new StringBuilder();
        b.Append("<form data-submit action=\"/admin/" + route + "/save\">\n");
        b.Append("  <input type=\"hidden\" name=\"id\" value=\"{{id}}\">\n");
        b.Append("  <div class=\"form\">\n");
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id" || (c.inCreate != 1 && c.inEdit != 1)) { continue; }
            if (c.inCreate != 1) { b.Append("    {{#if editing}}\n"); }
            if (c.inEdit != 1) { b.Append("    {{#if creating}}\n"); }
            b.Append("    <label>" + Gen.Html(Gen.LabelOf(c)) + "</label>\n");
            bool fed = (c.dictType.Length > 0 && Gen.Safe(c.dictType))
                || Gen.RelDesigned(c, designed);
            if (fed) {
                /* 选项行由 Form 动作查好；保留行显示当前值，防止保存时静默改数据。 */
                b.Append("    <select class=\"input\" name=\"" + c.name + "\">\n");
                b.Append("      {{#each " + c.name
                    + "Opts}}<option value=\"{{value}}\" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}\n");
                b.Append("      {{#if " + c.name + "None}}<option value=\"{{" + c.name
                    + "}}\" selected>{{" + c.name + "}}</option>{{/if}}\n");
                b.Append("    </select>\n");
            } else if (c.widget == "date" || c.widget == "datetime"
                || c.kind == "datetime") {
                b.Append("    <input class=\"input\" type=\"date\" name=\"" + c.name
                    + "\" value=\"{{" + c.name + "}}\">\n");
            } else if (c.widget == "switch" || c.kind == "bool") {
                b.Append("    <select class=\"input\" name=\"" + c.name
                    + "\"><option value=\"{{" + c.name + "}}\" selected hidden>{{" + c.name
                    + "}}</option><option value=\"1\">是</option><option value=\"0\">否</option></select>\n");
            } else if (c.widget == "richtext" || c.widget == "textarea"
                || c.kind == "text") {
                string rows = c.widget == "richtext" ? "8" : "3";
                b.Append("    <textarea class=\"input\" name=\"" + c.name
                    + "\" rows=\"" + rows + "\">{{" + c.name + "}}</textarea>\n");
            } else if (c.widget == "number" || Gen.ZanType(c.kind) != "string") {
                b.Append("    <input class=\"input\" type=\"number\" name=\"" + c.name
                    + "\" value=\"{{" + c.name + "}}\">\n");
            } else if (c.widget == "upload") {
                b.Append("    <input class=\"input\" name=\"" + c.name
                    + "\" value=\"{{" + c.name + "}}\" placeholder=\"媒体文件 URL\">\n");
            } else {
                b.Append("    <input class=\"input\" name=\"" + c.name
                    + "\" value=\"{{" + c.name + "}}\">\n");
            }
            if (c.inCreate != 1 || c.inEdit != 1) { b.Append("    {{/if}}\n"); }
        }
        b.Append("  </div>\n</form>\n");
        return b.ToString();
    }

    /* 生成数据访问网关（{Entity}Dao），与手写 DAO 结构一致。 */
    static string DaoSource(SysGenTable t, List<SysGenColumn> cols) {
        string ent = t.entityName;
        StringBuilder b = new StringBuilder();
        b.Append("using System;\nusing System.Data;\nusing System.Data.Orm;\n");
        b.Append("using ZanWeb.Model.Gen;\n\n");
        b.Append("namespace ZanWeb.Dao.Gen;\n\n");
        b.Append("/// <summary>" + Gen.Comment(t.title)
            + " 的数据网关。由表设计器生成，可直接修改。</summary>\n");
        b.Append("class " + ent + "Dao {\n");
        b.Append("    IDbConnection db;\n\n");
        b.Append("    " + ent + "Dao(IDbConnection db) {\n");
        b.Append("        this.db = db;\n    }\n\n");

        b.Append("    async " + ent + " ById(int id) {\n");
        b.Append("        return await this.db.Select<" + ent
            + ">().Where(a => a.id == id).FirstAsync();\n    }\n\n");

        b.Append("    async List<" + ent + "> All() {\n");
        b.Append("        return await this.db.Select<" + ent
            + ">().OrderByDescending(a => a.id).ToListAsync();\n    }\n\n");

        b.Append("    async int Count() {\n");
        b.Append("        return await this.db.Select<" + ent
            + ">().CountAsync();\n    }\n\n");

        b.Append("    async int Insert(" + ent + " e) {\n");
        b.Append("        return await this.db.Insert<" + ent
            + ">(e).ExecuteIdentityAsync();\n    }\n\n");

        b.Append("    async int Update(" + ent + " e) {\n");
        string sets = "";
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id") { continue; }
            sets = sets + "            .Set(a => a." + c.name + ", e." + c.name
                + ")\n";
        }
        if (sets.Length == 0) {
            b.Append("        return 0;\n    }\n\n");
        } else {
            b.Append("        return await this.db.Update<" + ent + ">()\n");
            b.Append(sets);
            b.Append("            .Where(a => a.id == e.id).ExecuteAffrowsAsync();\n");
            b.Append("    }\n\n");
        }

        b.Append("    async int Delete(int id) {\n");
        b.Append("        return await this.db.Delete<" + ent
            + ">().Where(a => a.id == id).ExecuteAffrowsAsync();\n    }\n}\n");
        return b.ToString();
    }

    /* ---- 前台源码生成 ---- */

    /* 前台 URL：/blog 式的公开段。生成表用表名本身（/e2e_demo 列表 +
       /e2e_demo/{id} 详情）——section 是后台侧栏分类（content/media/…），
       属内部习惯，不该固化进公开 URL；表名非法时回落 "topics"。 */
    static string FrontPath(SysGenTable t) {
        string name = t.tableName;
        if (!Gen.Safe(name)) { name = "topics"; }
        return name;
    }

    /* 前台列表页可用作摘要/正文展示的列：string 单行、text 长文本、
       datetime 时间戳、bool 开关、数值原样—— richtext 走 text 同型。 */
    static bool FrontTextual(string kind) {
        return kind == "string" || kind == "text" || kind == "int"
            || kind == "long" || kind == "decimal" || kind == "bool"
            || kind == "datetime";
    }

    /* 生成前台公开控制器源码：/「section」列表 + /「section」/{id} 详情，
       匿名可读、无写动作——写永远留在后台（参照 Blog.Posts 的形状）。 */
    static string FrontControllerSource(SysGenTable t, List<SysGenColumn> cols) {
        string cls = t.entityName + "FrontController";
        string mdl = "ZanWeb.Model.Gen." + t.entityName;
        string path = Gen.FrontPath(t);
        string orderCol = Gen.OrderCol(t, cols);
        string orderCall = t.orderDesc == 1
            ? "OrderByDescending(a => a." + orderCol + ")"
            : "OrderBy(a => a." + orderCol + ")";
        string title = Gen.Literal(t.title);
        StringBuilder b = new StringBuilder();
        b.Append("using System;\nusing System.Data;\nusing System.Data.Orm;\n");
        b.Append("using System.Web;\nusing System.Text;\nusing ZanWeb.Core;\nusing ZanWeb.Security;\nusing ZanWeb.Web;\nusing ZanWeb.Services;\nusing ZanWeb.Model.Gen;\n\n");
        b.Append("namespace ZanWeb.Front;\n\n");
        b.Append("/// <summary>" + Gen.Comment(t.title)
            + " 公开页：/\"" + path + "\" 列表 + /\"" + path
            + "\"/{id} 详情。由表设计器生成，可直接修改。</summary>\n");
        b.Append("[Route(\"" + path + "/[action]\")]\n");
        b.Append("[Custom(Authorization = CustomAuthorization.None)]\n");
        b.Append("[Description(\"" + title + "\")]\n");
        b.Append("class " + cls + " : AppController {\n");
        b.Append("    static int PageSize = 10;\n\n");

        b.Append("    [HttpGet]\n    [Route(\"/" + path + "\")]\n");
        b.Append("    [Description(\"" + title + "列表\")]\n");
        b.Append("    async void Index() {\n");
        b.Append("        if (!this.DbReady()) {\n");
        b.Append("            this.Fail(503, \"2001\", \"服务暂时不可用，请稍后再试\");\n");
        b.Append("        }\n");
        b.Append("        string kw = this.In(\"kw\");\n");
        b.Append("        int page = this.InInt(\"page\", 1);\n");
        b.Append("        if (page < 1) { page = 1; }\n\n");
        /* 关键词打在第一个 string 列上；没有 string 列就不接关键词。 */
        SysGenColumn first = null;
        for (int i = 0; i < cols.Count; i = i + 1) {
            if (cols[i].kind == "string" && cols[i].name != "id") {
                first = cols[i];
                break;
            }
        }
        if (first != null) {
            b.Append("        int total = await this." + t.entityName + "\n");
            b.Append("            .WhereIf(kw.Length > 0, a => a." + first.name
                + ".Contains(kw))\n");
            b.Append("            .CountAsync();\n");
            b.Append("        List<" + mdl + "> rows = await this."
                + t.entityName + "\n");
            b.Append("            .WhereIf(kw.Length > 0, a => a." + first.name
                + ".Contains(kw))\n");
        } else {
            b.Append("        int total = await this." + t.entityName
                + ".CountAsync();\n");
            b.Append("        List<" + mdl + "> rows = await this."
                + t.entityName + "\n");
        }
        b.Append("            ." + orderCall + "\n");
        b.Append("            .Skip((page - 1) * " + cls
            + ".PageSize).Take(" + cls + ".PageSize)\n");
        b.Append("            .ToListAsync();\n\n");
        b.Append("        ViewData d = new ViewData();\n");
        b.Append("        await Settings.Apply(d);\n");
        b.Append("        d.Set(\"title\", \"" + title + "\");\n");
        b.Append("        d.Set(\"heading\", \"" + title + "\");\n");
        b.Append("        d.Set(\"kw\", kw);\n");
        b.Append("        d.Set(\"total\", Convert.ToString(total));\n");
        b.Append("        List<StrMap> items = d.AddList(\"rows\");\n");
        b.Append("        Rows.Project(rows, items);\n");
        b.Append("        if (rows.Count == 0) { d.Set(\"empty\", \"1\"); }\n");
        b.Append("        int pages = (total + " + cls
            + ".PageSize - 1) / " + cls + ".PageSize;\n");
        b.Append("        d.Set(\"page\", Convert.ToString(page));\n");
        b.Append("        d.Set(\"pages\", Convert.ToString(pages));\n");
        b.Append("        if (page > 1) { d.Set(\"prev\", \"/" + path
            + "?page=\" + Convert.ToString(page - 1)\n");
        b.Append("            + (kw.Length > 0 ? \"&kw=\" + Encoding.UrlEncode(kw) : \"\")); }\n");
        b.Append("        if (page < pages) { d.Set(\"next\", \"/" + path
            + "?page=\" + Convert.ToString(page + 1)\n");
        b.Append("            + (kw.Length > 0 ? \"&kw=\" + Encoding.UrlEncode(kw) : \"\")); }\n");
        b.Append("        this.View(d);\n    }\n\n");

        b.Append("    [HttpGet]\n    [Route(\"/" + path + "/{id}\")]\n");
        b.Append("    [Description(\"" + title + "详情\")]\n");
        b.Append("    async void Show() {\n");
        b.Append("        int id = this.InInt(\"id\", 0);\n");
        b.Append("        if (id <= 0 || !this.DbReady()) {\n");
        b.Append("            this.Fail(404, \"2004\", \"记录不存在\");\n");
        b.Append("        }\n");
        b.Append("        " + mdl + " e = await this." + t.entityName
            + ".Read(id);\n");
        b.Append("        if (e == null) { this.Fail(404, \"2004\", \"记录不存在\"); }\n");
        b.Append("        ViewData d = new ViewData();\n");
        b.Append("        await Settings.Apply(d);\n");
        b.Append("        d.Set(\"title\", \"" + title + "\");\n");
        b.Append("        d.Set(\"id\", Convert.ToString(id));\n");
        b.Append("        d.Set(\"heading\", \"" + title + "详情\");\n");
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id" || !Gen.FrontTextual(c.kind)) { continue; }
            if (c.kind == "datetime") {
                b.Append("        d.Set(\"" + c.name + "\", Fmt.Day(e."
                    + c.name + "));\n");
            } else if (c.kind == "bool") {
                b.Append("        if (e." + c.name
                    + " == 1) { d.Set(\"" + c.name + "\", \"1\"); }\n");
            } else if (Gen.ZanType(c.kind) == "string") {
                b.Append("        d.Set(\"" + c.name + "\", e." + c.name
                    + ");\n");
            } else {
                b.Append("        d.Set(\"" + c.name
                    + "\", Convert.ToString(e." + c.name + "));\n");
            }
        }
        /* 第一个 text 列切段落渲染正文。 */
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.kind == "text" && c.name != "id") {
                b.Append("        List<StrMap> paras = d.AddList(\"paragraphs\");\n");
                b.Append("        List<string> lines = Prose.Paragraphs(e."
                    + c.name + ");\n");
                b.Append("        for (int i = 0; i < lines.Count; i = i + 1) {\n");
                b.Append("            StrMap row = new StrMap();\n");
                b.Append("            row.Set(\"text\", lines[i]);\n");
                b.Append("            paras.Add(row);\n");
                b.Append("        }\n");
                break;
            }
        }
        b.Append("        this.View(d);\n    }\n}\n");
        return b.ToString();
    }

    /* 生成前台列表视图源码。 */
    static string FrontListViewSource(SysGenTable t, List<SysGenColumn> cols) {
        string path = Gen.FrontPath(t);
        StringBuilder b = new StringBuilder();
        b.Append("<section class=\"gen-head\">\n");
        b.Append("  <h1>{{heading}}</h1>\n");
        b.Append("  <form class=\"blog-search\" method=\"get\" action=\"/" + path + "\">\n");
        b.Append("    <input type=\"search\" name=\"kw\" value=\"{{kw}}\" placeholder=\"搜索\">\n");
        b.Append("    <button type=\"submit\">搜索</button>\n");
        b.Append("  </form>\n");
        b.Append("</section>\n\n");
        b.Append("<section class=\"blog-list\">\n");
        b.Append("  {{#each rows}}\n");
        b.Append("  <article class=\"post-card\">\n");
        b.Append("    <div class=\"post-body\">\n");
        b.Append("      <div class=\"post-meta\">");
        int meta = 0;
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id" || c.inList != 1) { continue; }
            if (meta > 0) { b.Append("<span>·</span>"); }
            if (c.kind == "bool") {
                b.Append("{{#if " + c.name + "}}<span>"
                    + Gen.Html(Gen.LabelOf(c)) + "</span>{{/if}}");
            } else {
                b.Append("<span>{{" + c.name + "}}</span>");
            }
            meta = meta + 1;
            if (meta >= 3) { break; }
        }
        b.Append("</div>\n");
        /* 标题用第一个 string 列；没有就落 id。 */
        string titleCol = "id";
        for (int i = 0; i < cols.Count; i = i + 1) {
            if (cols[i].kind == "string" && cols[i].name != "id") {
                titleCol = cols[i].name;
                break;
            }
        }
        b.Append("      <h2><a href=\"/" + path + "/{{id}}\">{{"
            + titleCol + "}}</a></h2>\n");
        b.Append("      {{#if summary}}<p class=\"post-summary\">{{summary}}</p>{{/if}}\n");
        b.Append("      <div class=\"post-foot\"><a class=\"more\" href=\"/" + path
            + "/{{id}}\">查看详情 &rarr;</a></div>\n");
        b.Append("    </div>\n");
        b.Append("  </article>\n");
        b.Append("  {{/each}}\n");
        b.Append("  {{#if empty}}<div class=\"blog-empty\">还没有数据。</div>{{/if}}\n");
        b.Append("</section>\n\n");
        b.Append("<nav class=\"blog-pager\">\n");
        b.Append("  {{#if prev}}<a class=\"btn-pill ghost\" href=\"{{prev}}\">上一页</a>{{/if}}\n");
        b.Append("  <span class=\"muted\">第 {{page}} / {{pages}} 页 · 共 {{total}} 条</span>\n");
        b.Append("  {{#if next}}<a class=\"btn-pill ghost\" href=\"{{next}}\">下一页</a>{{/if}}\n");
        b.Append("</nav>\n");
        return b.ToString();
    }

    /* 生成前台详情视图源码。 */
    static string FrontShowViewSource(SysGenTable t, List<SysGenColumn> cols) {
        StringBuilder b = new StringBuilder();
        b.Append("<article class=\"article\">\n");
        b.Append("  <header class=\"article-head\">\n");
        b.Append("    <h1>{{heading}}</h1>\n");
        b.Append("  </header>\n");
        b.Append("  <dl class=\"gen-facts\">\n");
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id" || !Gen.FrontTextual(c.kind)) { continue; }
            if (c.kind == "bool") {
                b.Append("  {{#if " + c.name + "}}<div class=\"gen-fact\"><dt>"
                    + Gen.Html(Gen.LabelOf(c)) + "</dt><dd>是</dd></div>{{/if}}\n");
            } else {
                b.Append("  {{#if " + c.name + "}}<div class=\"gen-fact\"><dt>"
                    + Gen.Html(Gen.LabelOf(c)) + "</dt><dd>{{" + c.name + "}}</dd></div>{{/if}}\n");
            }
        }
        b.Append("  </dl>\n");
        for (int i = 0; i < cols.Count; i = i + 1) {
            if (cols[i].kind == "text" && cols[i].name != "id") {
                b.Append("\n  <div class=\"article-body\">\n");
                b.Append("    {{#each paragraphs}}<p>{{text}}</p>{{/each}}\n");
                b.Append("  </div>\n");
                break;
            }
        }
        b.Append("</article>\n");
        return b.ToString();
    }
}
