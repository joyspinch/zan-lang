using System;

namespace Zan.Web.Core;

public class MetricsCfg {
    public bool enabled;
    /* 独立的 SQLite 文件。 */
    public string path;
    /* 定时刷写间隔（秒）；60 = 一分钟。 */
    public int flushSeconds;
    /* 达到此行数也触发刷写。 */
    public int flushRows;
    /* 保留天数，每小时清理。 */
    public int keepDays;
    /* 顶栏告警阈值：5 分钟窗错误率百分比、参与评估的最少调用数（避免低流量 误报）、P95 耗时毫秒。任一为 0 关闭对应检查；铃铛轮询 /admin/monitor/alerts 时评估。 */
    public int alertErrPct;
    public int alertErrCalls;
    public int alertP95Ms;

    public static MetricsCfg Defaults() {
        MetricsCfg c = new MetricsCfg();
        c.enabled = true;
        c.path = "metrics.db";
        c.flushSeconds = 60;
        c.flushRows = 2000;
        c.keepDays = 30;
        c.alertErrPct = 5;
        c.alertErrCalls = 20;
        c.alertP95Ms = 2000;
        return c;
    }
}

