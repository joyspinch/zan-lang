using System;

namespace ZanWeb.Framework.Core;

class JobCfg {
    bool enabled;

    static JobCfg Defaults() {
        JobCfg c = new JobCfg();
        c.enabled = true;
        return c;
    }
}

/* [cluster] 配置：跨物理节点状态同步总线。 enabled: false（默认保持单机高性能共享内存 PermTable + 本地 verUids，零网络开销）。 当多机集群部署时设为 true，自动启用 Redis Pub/Sub 广播状态失效事件。 */
