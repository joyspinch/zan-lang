using System;

namespace Zan.Web.Core;

public class DatabaseCfg {
    public string driver;
    public string sqlitePath;
    public string host;
    public int port;
    public string name;
    public string user;
    public string password;
    /* 每个 worker 进程独立池的最大连接数；全服务最多 poolSize * worker.count。 */
    public int poolSize;
    public DatabaseReadOnlyCfg readOnly;

    public static DatabaseCfg Defaults() {
        DatabaseCfg c = new DatabaseCfg();
        c.driver = "sqlite";
        c.sqlitePath = "app.db";
        c.host = "127.0.0.1";
        c.port = 3306;
        c.name = "app";
        c.user = "root";
        c.password = "";
        c.poolSize = 8;
        c.readOnly = DatabaseReadOnlyCfg.Defaults();
        return c;
    }
}

