using System;

namespace ZanWeb.Framework.Core;

class CacheCfg {
    string driver;
    string redisHost;
    int redisPort;
    int poolSize;
    int connectTimeoutMs;

    static CacheCfg Defaults() {
        CacheCfg c = new CacheCfg();
        c.driver = "memory";
        c.redisHost = "127.0.0.1";
        c.redisPort = 6379;
        c.poolSize = 8;
        c.connectTimeoutMs = 3000;
        return c;
    }
}

/* [job] 配置：定时任务调度器。 */
