using System;

namespace ZanWeb.Framework.Core;

class ServerCfg {
    string name;
    string mode;
    string host;
    int port;
    int maxBodyMB;
    int uploadBodyMB;
    int globalLimitPerSec;
    string trustedProxies;

    static ServerCfg Defaults() {
        ServerCfg c = new ServerCfg();
        c.name = "app";
        c.mode = "full";
        c.host = "127.0.0.1";
        c.port = 8080;
        c.maxBodyMB = 2;
        c.uploadBodyMB = 64;
        c.globalLimitPerSec = 0;
        c.trustedProxies = "";
        return c;
    }
}

/* [database.readOnly] 只读从库配置：开启后读写分离，查询借用从库连接池，写与事务走主库。 */
