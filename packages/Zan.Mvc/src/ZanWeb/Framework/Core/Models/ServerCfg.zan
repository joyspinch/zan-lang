using System;

namespace Zan.Web.Core;

public class ServerCfg {
    public string name;
    public string mode;
    public string host;
    public int port;
    public int maxBodyMB;
    public int uploadBodyMB;
    public int globalLimitPerSec;
    public string trustedProxies;

    public static ServerCfg Defaults() {
        ServerCfg c = new ServerCfg();
        c.name = "app";
        c.mode = "full";
        c.host = "127.0.0.1";
        c.port = 8080;
        c.maxBodyMB = 2;
        c.uploadBodyMB = 64;
        c.globalLimitPerSec = 0;
        c.trustedProxies = "";
        return c;
    }
}

