using System;

namespace Zan.Web.Core;

public class DatabaseReadOnlyCfg {
    public bool enabled;
    public string driver;
    public string sqlitePath;
    public string host;
    public int port;
    public string name;
    public string user;
    public string password;
    public int poolSize;

    public static DatabaseReadOnlyCfg Defaults() {
        DatabaseReadOnlyCfg c = new DatabaseReadOnlyCfg();
        c.enabled = false;
        c.driver = "sqlite";
        c.sqlitePath = "app.db";
        c.host = "127.0.0.1";
        c.port = 3306;
        c.name = "app";
        c.user = "root";
        c.password = "";
        c.poolSize = 8;
        return c;
    }
}

