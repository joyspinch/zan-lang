using System;

namespace ZanWeb.Framework.Core;

class DatabaseReadOnlyCfg {
    bool enabled;
    string driver;
    string sqlitePath;
    string host;
    int port;
    string name;
    string user;
    string password;
    int poolSize;

    static DatabaseReadOnlyCfg Defaults() {
        DatabaseReadOnlyCfg c = new DatabaseReadOnlyCfg();
        c.enabled = false;
        c.driver = "sqlite";
        c.sqlitePath = "app.db";
        c.host = "127.0.0.1";
        c.port = 3306;
        c.name = "app";
        c.user = "root";
        c.password = "";
        c.poolSize = 8;
        return c;
    }
}

