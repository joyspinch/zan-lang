using System;
using ZanWeb.Core;

namespace ZanWeb.Security;

/// <summary>
/// 登录爆破限流：按账号（大小写/空白归一）记失败次数，窗口内达到阈值
/// 即拒绝后续尝试，直到窗口整体滑出。进程内固定窗实现——每 worker
/// 独立计数，阈值按 worker 数放大即实际成本，窗口+阈值组合已把在线
/// 爆破压到不可行量级；跨 worker 共享计数是 SharedTable 的后续题。
///
/// 语义要点（与 AuthUser.Login 配合）：
/// - 被限流与密码错误同答空串，不向客户端区分原因（无账号枚举 oracle）；
///   Blocked() 供调用方渲染"稍后再试"文案，锁状态本就来自攻击者自己的
///   失败次数，不构成新信息。
/// - 不存在的账号也记失败：否则"账号不存在"路径不受限流，计时侧信道
///   可枚举有效用户名。
/// - 成功登录清零；键上限封内存，超出淘汰最旧（攻击者换账号扫描时
///   最多冲掉自己的限流记录）。
/// </summary>
class LoginThrottle {
    /* 窗口内第 MaxFails 次失败即锁到窗口滑出。默认 10 次 / 15 分钟：
       十轮爆破 900 秒只试 10 个口令，人工输错也够余量。 */
    static int MaxFails = 10;
    static int WindowSec = 900;
    /* 键内存上限：全键三张平行表，超限淘汰最旧（表头近似最旧）。 */
    static int MaxKeys = 4096;

    static List<string> names = new List<string>();
    static List<int> counts = new List<int>();
    static List<int> windowStart = new List<int>();

    static string Norm(string user) {
        string s = user.Trim().ToLower();
        if (s.Length > 64) { s = s.Substring(0, 64); }
        return s;
    }

    /* 该账号当前是否还允许尝试。 */
    static bool Allowed(string user) {
        string key = LoginThrottle.Norm(user);
        if (key.Length == 0) { return true; }
        int now = WebApp.NowSeconds();
        lock (LoginThrottle.names) {
            int i = LoginThrottle.IndexOf(key);
            if (i < 0) { return true; }
            if (now - LoginThrottle.windowStart[i] >= LoginThrottle.WindowSec) {
                LoginThrottle.RemoveAt(i);
                return true;
            }
            return LoginThrottle.counts[i] < LoginThrottle.MaxFails;
        }
    }

    /* 记一次失败；新键占用若触顶先淘汰最旧。 */
    static void Fail(string user) {
        string key = LoginThrottle.Norm(user);
        if (key.Length == 0) { return; }
        int now = WebApp.NowSeconds();
        lock (LoginThrottle.names) {
            int i = LoginThrottle.IndexOf(key);
            if (i >= 0) {
                if (now - LoginThrottle.windowStart[i] >= LoginThrottle.WindowSec) {
                    LoginThrottle.counts[i] = 1;
                    LoginThrottle.windowStart[i] = now;
                } else {
                    LoginThrottle.counts[i] = LoginThrottle.counts[i] + 1;
                }
                return;
            }
            if (LoginThrottle.names.Count >= LoginThrottle.MaxKeys) {
                LoginThrottle.RemoveAt(0);
            }
            LoginThrottle.names.Add(key);
            LoginThrottle.counts.Add(1);
            LoginThrottle.windowStart.Add(now);
        }
    }

    /* 成功登录清零该账号。 */
    static void Clear(string user) {
        string key = LoginThrottle.Norm(user);
        if (key.Length == 0) { return; }
        lock (LoginThrottle.names) {
            int i = LoginThrottle.IndexOf(key);
            if (i >= 0) { LoginThrottle.RemoveAt(i); }
        }
    }

    /* 被限流即 true——仅供界面文案，不改变 Login 的应答语义。 */
    static bool Blocked(string user) {
        return !LoginThrottle.Allowed(user);
    }

    static int IndexOf(string key) {
        for (int i = 0; i < LoginThrottle.names.Count; i = i + 1) {
            if (LoginThrottle.names[i] == key) { return i; }
        }
        return -1;
    }

    static void RemoveAt(int i) {
        LoginThrottle.names.RemoveAt(i);
        LoginThrottle.counts.RemoveAt(i);
        LoginThrottle.windowStart.RemoveAt(i);
    }
}
