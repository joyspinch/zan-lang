using System.Data;
using System.Data.Orm;

namespace ZanWeb.Model;

/* 账号 → 资源的数据域授权行（店铺、门店、项目、仓库…）。
 *
 * scopeKey 是业务注册的域键（DataGrant.Define），resourceId 是该域内
 * 一条资源的 id。一个账号在一个域里可以有任意多行；**没有行 = 看不到
 * 任何资源**（fail closed），"全部"只由超管或角色 dataScope=全部获得。
 *
 * 之所以不并进 sys_user_role：角色表达"能做什么"，这里表达"能看哪些
 * 行"，两者变更节奏与授权人不同（角色由平台管，店铺由运营主管分配）。 */
[Table(Name = "sys_user_scope")]
public class SysUserScope {
    [Column(IsIdentity = true)]
    public int id;

    public int userId;
    public string scopeKey;
    public int resourceId;
    public long createdAt;
}
