using System;
using System.Security.Cryptography;
using System.Web;
using ZanWeb.Core;
using ZanWeb.Services;
using ZanWeb.Web;

namespace ZanWeb.Security;

/* Only a successful atomic cache operation exposes a code to the mail sender. */
class VerifyCodeIssue {
    int status = -1;
    string code = "";
}

/* 注册与重置密码使用的 6 位验证码：缓存存储并设置 TTL，发送间隔限制，验证后一次性消费。 */
class VerifyCode {
    static int TtlSeconds = 600;
    static int ResendSeconds = 60;

    static string Key(string purpose, string address) {
        return "code:" + purpose + ":" + address.Trim().ToLower();
    }

    static CacheContext Cache() {
        AppServices s = AppServices.Current();
        if (s == null) { return null; }
        return s.Cache();
    }

    /* Informational only; IssueForIp makes the actual atomic admission decision. */
    static async bool TooSoon(string purpose, string address) {
        CacheContext c = VerifyCode.Cache();
        if (c == null) { return true; }
        string hit = await c.GetAsync(VerifyCode.CooldownKey(address));
        return hit.Length > 0;
    }

    static string CooldownKey(string address) {
        return "code:sent:" + address.Trim().ToLower();
    }

    /* Legacy callers without request context share one conservative quota, not a bypass. */
    static async string Issue(string purpose, string address) {
        VerifyCodeIssue issued = await VerifyCode.IssueForIp(purpose, address, "unknown");
        return issued.code;
    }

    /* Register/reset share both quotas, while their codes remain purpose-bound.
       SMTP failures deliberately keep the reservation: retries must not bypass admission. */
    static async VerifyCodeIssue IssueForIp(string purpose, string address, string ip) {
        VerifyCodeIssue issued = new VerifyCodeIssue();
        CacheContext c = VerifyCode.Cache();
        if (c == null) { return issued; }
        string peer = ip.Trim().ToLower();
        if (peer.Length == 0) { peer = "unknown"; }
        int windowSeconds = Cfg.EnvInt("ZAN_VERIFY_IP_WINDOW_SECONDS", 600);
        int maxSends = Cfg.EnvInt("ZAN_VERIFY_IP_MAX_SENDS", 5);
        string code = VerifyCode.Digits(6);
        issued.status = await c.IssueCodeAsync(VerifyCode.Key(purpose, address),
            VerifyCode.CooldownKey(address), "code:ip:" + peer, code,
            VerifyCode.TtlSeconds, VerifyCode.ResendSeconds, windowSeconds, maxSends);
        if (issued.status == 1) { issued.code = code; }
        return issued;
    }

    /* 校验并消费验证码，错误/过期/已用均返回 false。 */
    static async bool Accept(string purpose, string address, string code) {
        if (code.Length == 0) { return false; }
        CacheContext c = VerifyCode.Cache();
        if (c == null) { return false; }
        return await c.ConsumeCodeAsync(VerifyCode.Key(purpose, address), code);
    }

    static string Digits(int n) {
        byte[] raw = RandomNumberGenerator.GetBytes(n);
        string digits = "";
        for (int i = 0; i < n; i = i + 1) {
            int v = (int)raw[i];
            if (v < 0) { v = 0 - v; }
            digits = digits + Convert.ToString(v % 10);
        }
        return digits;
    }
}
