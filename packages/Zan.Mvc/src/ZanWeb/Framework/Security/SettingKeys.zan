using System;

namespace Zan.Web.Security;

/* sys_setting 表的键名集中定义，防止拼写错误导致静默回退默认值。*/
public class SettingKeys {
    public static string SiteTitle = "site.title";
    public static string SiteSubtitle = "site.subtitle";
    public static string SiteDescription = "site.description";
    public static string SiteKeywords = "site.keywords";
    public static string SiteCopyright = "site.copyright";
    public static string SiteIcp = "site.icp";
    public static string SitePolice = "site.police";
    public static string SiteAnalytics = "site.analytics";
    public static string SiteTimezone = "site.timezone";
    public static string SiteLanguage = "site.language";
    public static string SiteUrl = "site.url";

    public static string RegisterEnabled = "auth.register.enabled";
    public static string RegisterVerify = "auth.register.verify";
    public static string ResetEnabled = "auth.reset.enabled";

    public static string CommentEnabled = "blog.comment.enabled";
    public static string CommentReview = "blog.comment.review";

    public static string MailHost = "mail.host";
    public static string MailPort = "mail.port";
    public static string MailSsl = "mail.ssl";
    public static string MailUser = "mail.user";
    public static string MailPass = "mail.pass";
    public static string MailFrom = "mail.from";
    public static string MailFromName = "mail.fromName";

    public static string AiEnabled = "ai.enabled";
    public static string AiBaseUrl = "ai.baseUrl";
    public static string AiApiKey = "ai.apiKey";
    public static string AiModel = "ai.model";
    public static string AiTemperature = "ai.temperature";

    public static string GenRoot = "gen.root";
}

/* 应用内部路径与路由 action 命名常量。没有 Admin 常量：登录落地页不是
   固定 URL，而是该账号可到达的第一个菜单项（MenuBuilder.LandingFor）。*/
