using System;
using System.Web;
using ZanWeb.Core;

namespace ZanWeb.Security;

/* 按钮级权限：屏为一行，按钮为 5 位位掩码。action 通过 [Custom(Perm = PermBit.Update)] 声明所属位，编译器写入 Route.MetaGet("Perm")。授权行为 (roleId, screen, mask)，检查为一次 AND。未声明位的 action 不可授权，boot 日志提示。*/
class Perm {
    static Dict<string, int> bits = null;
    static Dict<string, int> masks = null;
    static List<string> screens = null;
    static Dict<string, string> titles = null;
    static List<string> unmarked = null;

    static int Full = 31;

    /* 从注册路由构建索引，main 中 __AttrRoutes.Register 之后、首个请求之前调用。*/
    static void Index(WebApp app) {
        bits = new Dict<string, int>();
        masks = new Dict<string, int>();
        screens = new List<string>();
        titles = new Dict<string, string>();
        unmarked = new List<string>();

        List<Route> all = app.router.All();
        for (int i = 0; i < all.Count; i = i + 1) {
            Route r = all[i];
            if (!r.needsAuth || r.action.Length == 0) { continue; }
            if (bits.ContainsKey(r.action)) { continue; }
            int bit = BitValue(r.MetaGet("Perm"));
            bits.Add(r.action, bit);
            if (bit == 0) { unmarked.Add(r.action); continue; }
            string screen = ScreenOf(r.action);
            int have = 0;
            if (masks.TryGetValue(screen, out have)) {
                masks.Remove(screen);
            } else {
                screens.Add(screen);
            }
            masks.Add(screen, have | bit);
            Title(screen, r);
        }
        if (unmarked.Count > 0) {
            Console.WriteLine("[rbac] " + Convert.ToString(unmarked.Count)
                + " 个受控 action 未标注 Perm，已拒绝授权: "
                + Join(unmarked, 8));
        }
    }

    static bool Ready() { return bits != null; }

    static int BitOf(string action) {
        if (!Ready()) { return 0; }
        int bit = 0;
        if (bits.TryGetValue(action, out bit)) { return bit; }
        return 0;
    }

    /* "SysUsers.Save" -> "SysUsers"；"Admin.System.SysUsers.Save" -> "Admin.System.SysUsers"。末段为方法，其余为屏。*/
    static string ScreenOf(string action) {
        int dot = action.LastIndexOf(".");
        if (dot <= 0) { return action; }
        return action.Substring(0, dot);
    }

    static int MaskOf(string screen) {
        if (!Ready()) { return 0; }
        int mask = 0;
        if (masks.TryGetValue(screen, out mask)) { return mask; }
        return 0;
    }

    /* 记录或升级屏标题：屏的 Index 优先，否则取首见路由的 title。*/
    static void Title(string screen, Route r) {
        if (r.title.Length == 0) { return; }
        bool have = titles.ContainsKey(screen);
        if (have && !r.action.EndsWith(".Index")) { return; }
        if (have) { titles.Remove(screen); }
        titles.Add(screen, r.title);
    }

    static string TitleOf(string screen) {
        if (!Ready()) { return screen; }
        string t = "";
        if (titles.TryGetValue(screen, out t) && t.Length > 0) { return t; }
        return screen;
    }

    static List<string> Screens() {
        if (!Ready()) { return new List<string>(); }
        return screens;
    }

    /* 旧键兼容：当前存在的直接返回，否则取唯一以该键结尾的屏；无或不止一个返回 ""。仅迁移使用。*/
    static string Qualify(string stored) {
        if (!Ready() || stored.Length == 0) { return ""; }
        if (masks.ContainsKey(stored)) { return stored; }
        string hit = "";
        string tail = "." + stored;
        for (int i = 0; i < screens.Count; i = i + 1) {
            if (!screens[i].EndsWith(tail)) { continue; }
            if (hit.Length > 0) { return ""; }
            hit = screens[i];
        }
        return hit;
    }

    static List<string> Unmarked() {
        if (!Ready()) { return new List<string>(); }
        return unmarked;
    }

    /* PermBit 成员名 -> 位值。"Create|Update" 表示该 action 同时需要两 bits。*/
    static int BitValue(string name) {
        int bar = name.IndexOf("|");
        if (bar > 0) {
            return BitValue(name.Substring(0, bar))
                 | BitValue(name.Substring(bar + 1));
        }
        if (name == "View") { return (int)PermBit.View; }
        if (name == "Create") { return (int)PermBit.Create; }
        if (name == "Update") { return (int)PermBit.Update; }
        if (name == "Delete") { return (int)PermBit.Delete; }
        if (name == "Export") { return (int)PermBit.Export; }
        return 0;
    }

    static List<int> Order() {
        List<int> outp = new List<int>();
        outp.Add((int)PermBit.View);
        outp.Add((int)PermBit.Create);
        outp.Add((int)PermBit.Update);
        outp.Add((int)PermBit.Delete);
        outp.Add((int)PermBit.Export);
        return outp;
    }

    static string BitLabel(int bit) {
        if (bit == (int)PermBit.View) { return "查看"; }
        if (bit == (int)PermBit.Create) { return "新增"; }
        if (bit == (int)PermBit.Update) { return "修改"; }
        if (bit == (int)PermBit.Delete) { return "删除"; }
        if (bit == (int)PermBit.Export) { return "导出"; }
        return "";
    }

    static string BitName(int bit) {
        if (bit == (int)PermBit.View) { return "View"; }
        if (bit == (int)PermBit.Create) { return "Create"; }
        if (bit == (int)PermBit.Update) { return "Update"; }
        if (bit == (int)PermBit.Delete) { return "Delete"; }
        if (bit == (int)PermBit.Export) { return "Export"; }
        return "";
    }

    /* ---- 持久化串格式 ---- */
    /* 角色掩码以 ",SysUsers:15,SysRoles:5," 字符串行式存放在共享内存中，请求路径读一次即得答案，授权变更才重写。*/

    static int MaskIn(string stored, string screen) {
        if (stored.Length == 0 || screen.Length == 0) { return 0; }
        int at = stored.IndexOf("," + screen + ":");
        if (at < 0) { return 0; }
        int i = at + screen.Length + 2;
        int val = 0;
        bool any = false;
        while (i < stored.Length) {
            int c = stored[i] & 255;
            if (c < 48 || c > 57) { break; }
            val = val * 10 + (c - 48);
            any = true;
            i = i + 1;
        }
        if (!any) { return 0; }
        return val;
    }

    static void Append(StringBuilder sb, string screen, int mask) {
        if (screen.Length == 0 || mask <= 0) { return; }
        sb.Append(screen);
        sb.Append(":");
        sb.Append(Convert.ToString(mask));
        sb.Append(",");
    }

    static string Join(List<string> items, int max) {
        StringBuilder sb = new StringBuilder();
        int n = items.Count;
        if (n > max) { n = max; }
        for (int i = 0; i < n; i = i + 1) {
            if (i > 0) { sb.Append(" "); }
            sb.Append(items[i]);
        }
        if (items.Count > n) { sb.Append(" ..."); }
        return sb.ToString();
    }
}
