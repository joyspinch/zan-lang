using System;
using System.Data;
using System.Web;
using System.Json;
using ZanWeb.Core;
using ZanWeb.Model;
using ZanWeb.Services;

namespace ZanWeb.Web;

/* 注入数据库与缓存访问的控制器基类。依赖在 main.zan 装配并经 AppServices.Use(...) 安装，动作通过 this.Conn()/this.Cache() 访问。连接按请求作用域：Conn() 首次调用时从连接池借出，同请求后续调用复用同一连接，OnAfter() 在动作返回时归还——故业务代码与 DAO 不含 Acquire/Release；按请求(非按查询)持一连接也使事务成为可能，事务内每条语句须在同一连接上执行。BEGIN/COMMIT/ROLLBACK 同其他语句一样需 await。子类清理覆盖 OnDone() 而非 OnAfterAsync()，以确保连接总是被释放。 */
class AppController : Controller {
    IDbConnection lease;
    IDbConnection readLease;
    bool inTx;
    bool readOnlyIntent;
    bool leaseIsRead;

    override void __UseReadOnly() { this.readOnlyIntent = true; }

    /* 注入的数据库上下文（AppServices.Use 前为 null）。私有：控制器经
     * Conn()/Held()/ReadConn() 拿请求连接，不直接触碰借还协议。 */
    private DbContext Db() {
        AppServices s = AppServices.Current();
        if (s == null) { return null; }
        return s.Db();
    }

    /* 注入的缓存上下文（AppServices.Use 前为 null）。 */
    protected CacheContext Cache() {
        AppServices s = AppServices.Current();
        if (s == null) { return null; }
        return s.Cache();
    }

    /* 本次请求的连接：首次调用借出、之后复用、动作返回自动释放。null 表示数据库不可用——处理器应答 503 而非假设结果集为空。 */
    protected async IDbConnection Conn() {
        if (this.lease != null) { return this.lease; }
        DbContext ctx = this.Db();
        if (ctx == null) { return null; }
        if (this.readOnlyIntent) {
            this.lease = await ctx.AcquireRead();
            this.leaseIsRead = this.lease != null;
        } else {
            this.lease = await ctx.Acquire();
        }
        return this.lease;
    }

    /* 本次请求已借出的连接，不 await；仅在 Conn() 或 Begin() 成功后有效。 */
    protected IDbConnection Held() {
        return this.lease;
    }

    /* 请求已有租约时复用同一连接，不嵌套借用；没有租约时借只读池。
       [ReadOnly] 动作在 OnBeforeAsync 已持只读租约，普通动作复用主库；
       事务强制主库，读后写一致性由不标注 [ReadOnly] 保证。 */
    protected async IDbConnection ReadConn() {
        if (this.lease != null) { return this.lease; }
        if (this.inTx) { return await this.Conn(); }
        if (this.readLease != null) { return this.readLease; }
        DbContext ctx = this.Db();
        if (ctx == null) { return null; }
        this.readLease = await ctx.AcquireRead();
        return this.readLease;
    }

    /* 本次请求已借出的只读连接（未借出则回退到请求连接）。*/
    protected IDbConnection HeldRead() {
        if (this.lease != null) { return this.lease; }
        return this.readLease;
    }

    /* 表访问器运行其上的连接：this.SysUser、this.Post 编译为在此连接上的类型化查询，故租约需在 OnBeforeAsync() 取得（访问器是普通成员，无法 await）。不构造 DAO、不借还、字段名在编译期校验。
     * 同时是请求作用域的取数口：DAO 以 `XxxDao(AppController host)` 收宿主、经此解析请求连接——连接永远由框架供给，业务不手工传递。 */
    public IDbConnection __Conn() {
        return this.lease;
    }

    /* 动作运行前借出本次请求连接，供表访问器使用；数据库未配置时零开销（Conn() 答 null，动作回退到 503）。 */
    /* override 而非 virtual：virtual 在 Zan 里是「新开槽位」（隐藏基类
       方法），不是覆盖——生成的路由蹦床经 Controller 静态类型的槽位派
       发，新槽位永远打不中，基类的空实现就会替它执行：请求租约借了
       不还，池被拖干后全站 503/无响应（实测过的全站假死形态）。 */
    override async bool OnBeforeAsync() {
        IDbConnection _db = await this.Conn();
        return this.OnBefore();
    }

    /* 本次请求是否有可用数据库。false 表示连接池无法借出（未配置或不可达），对调用方答 503 而非抛异常；廉价：租约在 OnBeforeAsync() 已取得。 */
    protected bool DbReady() {
        return this.lease != null;
    }

    /* 弃用未知事务状态的主库租约，清理异常不能覆盖原事务失败。
       先清请求字段，确保之后的收尾不会再次归还或操作此连接。 */
    private void DiscardLease() {
        IDbConnection db = this.lease;
        this.lease = null;
        this.leaseIsRead = false;
        this.inTx = false;
        if (db == null) { return; }
        try {
            DbContext ctx = this.Db();
            if (ctx != null) { ctx.Discard(db); }
            else { db.Close(); }
        } catch (Exception cleanupError) { }
    }

    /* false 表示未确认事务开启；BEGIN 失败的连接状态不明，必须弃用。 */
    protected async bool Begin() {
        if (this.readOnlyIntent) { return false; }
        IDbConnection db = await this.Conn();
        if (db == null) { return false; }
        if (this.inTx) { return true; }
        bool begun = false;
        try { begun = await db.BeginTransactionAsync(); }
        catch (Exception beginError) {
            this.DiscardLease();
            throw beginError;
        }
        if (!begun) {
            this.DiscardLease();
            return false;
        }
        this.inTx = true;
        return true;
    }

    /* 提交失败（包括 false）保留 inTx，供失败路径回滚。 */
    protected async void Commit() {
        if (!this.inTx) { return; }
        if (!await this.lease.CommitAsync()) {
            throw new Exception("commit failed");
        }
        this.inTx = false;
    }

    /* 回滚失败（包括 false）保留 inTx，使收尾可重试或弃用脏连接。 */
    protected async void Rollback() {
        if (!this.inTx) { return; }
        if (!await this.lease.RollbackAsync()) {
            throw new Exception("rollback failed");
        }
        this.inTx = false;
    }

    /* [Tx] 蹦床钩子：声明属性即完成事务，动作体内不再出现 Begin/Commit/Rollback 阶梯。 */

    /* 打开本次请求事务（租约+BEGIN）；false 表示数据库不可用，蹦床答 503。 */
    override async bool __TxBegin() { return await this.Begin(); }

    /* 动作成功后提交；无事务时 no-op。 */
    override async void __TxCommit() { await this.Commit(); }

    /* 任何失败路径回滚；可重复调用、可在提交后调用。 */
    override async void __TxRollback() { await this.Rollback(); }

    /* 未完成事务先回滚；失败时先摘除池租约，再尝试关闭脏连接。
       各清理步骤都必须执行，后续清理异常不能覆盖最初的失败。 */
    override async void OnAfterAsync() {
        Exception failure = null;
        if (this.lease != null && this.inTx) {
            try { await this.Rollback(); }
            catch (Exception rollbackError) {
                failure = rollbackError;
                this.DiscardLease();
            }
        }
        try {
            if (this.lease != null) {
                DbContext ctx = this.Db();
                if (ctx != null) {
                    if (this.leaseIsRead) { ctx.ReleaseRead(this.lease); }
                    else { ctx.Release(this.lease); }
                }
            }
        } catch (Exception releaseError) {
            if (failure == null) { failure = releaseError; }
        } finally {
            this.lease = null;
            this.leaseIsRead = false;
            this.inTx = false;
        }
        try {
            if (this.readLease != null) {
                DbContext ctx = this.Db();
                if (ctx != null) { ctx.ReleaseRead(this.readLease); }
            }
        } catch (Exception readError) {
            if (failure == null) { failure = readError; }
        } finally {
            this.readLease = null;
        }
        try { this.OnDone(); }
        catch (Exception doneError) {
            if (failure == null) { failure = doneError; }
        }
        if (failure != null) { throw failure; }
    }

    /* 供子类做每请求清理；覆盖此而非 OnAfterAsync()，后者负责释放连接。 */
    virtual void OnDone() { }

    /* ---- 取参（JSON 体回退） ----------------------------------------
       自研管理壳用表单编码提交，adminUI 系前端（axios）用 JSON 提交。
       route/query/form 未命中时读 application/json 正文顶层字段，两类
       客户端共用同一控制器动作；标量值转文本（数字按 token 原文、布
       尔 true/false）。表单编码路径零行为变化。 */

    /* 公开：ListPage/FormPage/CrudScreenController 等协作类经控制器实例取参，
       与 stdlib In/InInt 同一可见性。 */
    public string InAny(string name) {
        string v = this.In(name);
        if (v.Length > 0) { return v; }
        JsonValue jb = this.Ctx().JsonBody();
        if (jb == null || !jb.IsObject()) { return ""; }
        JsonValue f = jb.Get(name);
        if (f == null || f.IsNull() || f.IsArray() || f.IsObject()) { return ""; }
        return f.AsString("");
    }

    public int InAnyInt(string name) {
        return HttpContext.ParseIntStrict(this.InAny(name), 0);
    }
}
