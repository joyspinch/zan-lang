using System;
using System.Data.Orm;
using ZanWeb.Core;
using ZanWeb.Services;

namespace ZanWeb.Web;

/* 应用服务根：Db、Cache 和 FreeSql ORM 由 main.zan 一次性装配并通过构造注入（依赖注入，无惰性静态发现）。单例通过 Use() 安装，通过 Current() 读取。*/
class AppServices {
    static AppServices current;

    DbContext db;
    CacheContext cache;
    IFreeSql fsql;

    AppServices(DbContext db, CacheContext cache) {
        this.db = db;
        this.cache = cache;
        if (db != null && db.Pool() != null) {
            this.fsql = FreeSql.FromPool(db.Pool());
        } else {
            this.fsql = null;
        }
    }

    AppServices(DbContext db, CacheContext cache, IFreeSql fsql) {
        this.db = db;
        this.cache = cache;
        this.fsql = fsql;
    }

    static void Use(AppServices services) {
        current = services;
    }

    static AppServices Current() {
        return current;
    }

    DbContext Db() {
        return this.db;
    }

    CacheContext Cache() {
        return this.cache;
    }

    IFreeSql Orm() {
        return this.fsql;
    }
}
