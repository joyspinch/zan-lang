using System;
using System.Data.Orm;
using ZanWeb.Core;
using ZanWeb.Services;

namespace ZanWeb.Web;

/* 应用服务根：Db、Cache 和 ZanSql ORM 由 main.zan 一次性装配并通过构造注入（依赖注入，无惰性静态发现）。单例通过 Use() 安装，通过 Current() 读取。*/
class AppServices {
    static AppServices current;

    DbContext db;
    CacheContext cache;
    IZanSql zsql;

    AppServices(DbContext db, CacheContext cache) {
        this.db = db;
        this.cache = cache;
        if (db != null && db.Pool() != null) {
            this.zsql = ZanSql.FromPool(db.Pool());
        } else {
            this.zsql = null;
        }
    }

    AppServices(DbContext db, CacheContext cache, IZanSql zsql) {
        this.db = db;
        this.cache = cache;
        this.zsql = zsql;
    }

    static void Use(AppServices services) {
        current = services;
    }

    static AppServices Current() {
        return current;
    }

    DbContext Db() {
        return this.db;
    }

    CacheContext Cache() {
        return this.cache;
    }

    IZanSql Orm() {
        return this.zsql;
    }
}
