using System;
using System.Web;
using ZanWeb.Core;

namespace ZanWeb.Web;

/* /api 下 JSON 端点基类：统一返回 {code, msg, data, traceId} 响应信封。拒绝时以 HTTP 状态码或业务错误码直接拒绝（绝不重定向到登录表单）。*/
class ApiController : AppController {

    /* 获取当前请求的 TraceId（从请求头或响应头获取）。*/
    protected string TraceId() {
        string t = this.Ctx().Header("x-request-id");
        if (t.Length == 0) {
            t = this.Ctx().Header("X-Request-Id");
        }
        return t;
    }

    /* 统一成功应答：{ "code": 0, "msg": "ok", "data": data, "traceId": "..." } */
    protected void Ok(string dataJson) {
        string t = this.TraceId();
        string body = "{\"code\":0,\"msg\":\"ok\",\"data\":" + (dataJson.Length > 0 ? dataJson : "null");
        if (t.Length > 0) {
            body = body + ",\"traceId\":\"" + t + "\"";
        }
        body = body + "}";
        this.Json(body);
    }

    /* 统一失败应答：{ "code": code, "msg": msg, "traceId": "..." } */
    protected void Fail(int code, string msg) {
        string t = this.TraceId();
        JsonValue o = JsonValue.NewObject();
        o.Put("code", JsonValue.NewNum(Convert.ToString(code)));
        o.Put("msg", JsonValue.NewStr(msg));
        if (t.Length > 0) {
            o.Put("traceId", JsonValue.NewStr(t));
        }
        this.Json(o.ToJson());
    }

    /* 内部异常/500 兜底应答：隐藏内部敏感信息，向客户端返回友好错误并附带 traceId。*/
    protected void ServerError(string userMsg) {
        this.Ctx().Status(500, "Internal Server Error");
        this.Fail(500, userMsg.Length > 0 ? userMsg : "系统繁忙，请稍后重试");
    }
}
