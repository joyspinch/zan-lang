using System;
using System.Collections.Generic;

namespace ZanWeb.Ai;

public class AiReply {
    public bool ok;
    public string text;

    public static AiReply Good(string text) {
        AiReply r = new AiReply();
        r.ok = true;
        r.text = text;
        return r;
    }

    public static AiReply Bad(string why) {
        AiReply r = new AiReply();
        r.ok = false;
        r.text = why;
        return r;
    }
}

/* AI 入口：服务商预设、内置助手、与 OpenAI 兼容接口的调用。Key 仅存于设置表，不发送到浏览器。 */
