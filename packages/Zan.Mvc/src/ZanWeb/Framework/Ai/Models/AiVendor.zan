using System;
using System.Collections.Generic;

namespace ZanWeb.Framework.Ai;

class AiVendor {
    string code;
    string name;
    string baseUrl;
    string model;
    string signup;

    AiVendor(string code, string name, string baseUrl, string model,
             string signup) {
        this.code = code;
        this.name = name;
        this.baseUrl = baseUrl;
        this.model = model;
        this.signup = signup;
    }
}

/* 流式返回的一段文本，用作 JSON 序列化对象。 */
