using System;
using System.Collections.Generic;

namespace ZanWeb.Framework.Ai;

public class AiAgent {
    public string code;
    public string name;
    public string hint;
    public string icon;
    /* 是否允许将结果提交到数据库（建表）。 */
    public bool apply;
    public string prompt;

    public AiAgent(string code, string name, string hint, string icon,
            bool apply, string prompt) {
        this.code = code;
        this.name = name;
        this.hint = hint;
        this.icon = icon;
        this.apply = apply;
        this.prompt = prompt;
    }
}

