using System;
using System.Collections.Generic;

namespace ZanWeb.Framework.Ai;

class AiAgent {
    string code;
    string name;
    string hint;
    string icon;
    /* 是否允许将结果提交到数据库（建表）。 */
    bool apply;
    string prompt;

    AiAgent(string code, string name, string hint, string icon,
            bool apply, string prompt) {
        this.code = code;
        this.name = name;
        this.hint = hint;
        this.icon = icon;
        this.apply = apply;
        this.prompt = prompt;
    }
}

