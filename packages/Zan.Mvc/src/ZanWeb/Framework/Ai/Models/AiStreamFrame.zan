namespace ZanWeb.Ai;

/* 一行 SSE `data:` 解析后的结果。
 *
 * 三种情况用三个字段表达，不用"魔法字符串前缀"区分——那会让调用方
 * 靠 StartsWith 猜，迟早猜错：
 *   kind = "delta"  → text 是增量文本
 *   kind = "error"  → text 是流内错误的原因
 *   kind = "skip"   → 这一行没有内容（keep-alive / [DONE] / 无 choices）
 */
public class AiStreamFrame {
    /* "delta" / "error" / "skip" */
    public string kind;
    public string text;

    public static AiStreamFrame Delta(string text) {
        AiStreamFrame f = new AiStreamFrame();
        f.kind = "delta";
        f.text = text;
        return f;
    }

    public static AiStreamFrame Error(string why) {
        AiStreamFrame f = new AiStreamFrame();
        f.kind = "error";
        f.text = why;
        return f;
    }

    public static AiStreamFrame Skip() {
        AiStreamFrame f = new AiStreamFrame();
        f.kind = "skip";
        f.text = "";
        return f;
    }
}
