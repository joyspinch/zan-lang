    public static AiAgent AgentOf(string code) {
        List<AiAgent> all = Agents();
        for (int i = 0; i < all.Count; i = i + 1) {
            if (all[i].code == code) { return all[i]; }
        }
        return all[0];
    }

    /* AI 服务已配置可用（启用、URL、模型、Key 齐全，本地可免 Key）。 */
    public static async bool Ready() {
        if (!await Settings.On(SettingKeys.AiEnabled, false)) { return false; }
        string url = await Settings.Get(SettingKeys.AiBaseUrl, "");
        string key = await Settings.Get(SettingKeys.AiApiKey, "");
        string model = await Settings.Get(SettingKeys.AiModel, "");
        if (url.Length == 0 || model.Length == 0) { return false; }
        /* URL 必须是预设的完整地址，不能把设置值当作任意外呼目标。 */
        if (!AiEndpointPolicy.IsAllowed(url)) { return false; }
        /* 仅固定的本机 Ollama 地址免 Key，线上服务必须有 Key。 */
        if (key.Length == 0 && !AiEndpointPolicy.IsLocal(url)) { return false; }
        return true;
    }

    /* 单轮对话。 */
    public static async AiReply Ask(string agentCode, string question) {
        return await AskConv(agentCode, "[]", question);
    }

    /* 多轮对话，historyJson 仅当文本处理，角色取 user/assistant，最多保留 20 轮。 */
    public static async AiReply AskConv(string agentCode, string historyJson, string question) {
        if (!await Ready()) { return AiReply.Bad("尚未配置 AI 服务"); }
        string baseUrl = await Settings.Get(SettingKeys.AiBaseUrl, "");
        string key = await Settings.Get(SettingKeys.AiApiKey, "");
        string model = await Settings.Get(SettingKeys.AiModel, "");
        string temp = await Settings.Get(SettingKeys.AiTemperature, "0.3");
        AiEndpoint ep = AiEndpoint.Parse(baseUrl);
        if (ep == null) { return AiReply.Bad("服务地址不合法"); }
        return await Complete(ep, key, model, temp,
        Messages(AgentOf(agentCode), historyJson, question));
    }

    /* 结构化生成用的单轮调用：系统提示词由调用方自带（非对话 persona），
    答语原样返回，解析与验证归调用方——表设计器等需要严格 JSON 契约的
    场景用这个，不走聊天历史。 */
    public static async AiReply CompleteRaw(string systemPrompt, string question) {
        if (!await Ready()) { return AiReply.Bad("尚未配置 AI 服务"); }
        string baseUrl = await Settings.Get(SettingKeys.AiBaseUrl, "");
        string key = await Settings.Get(SettingKeys.AiApiKey, "");
        string model = await Settings.Get(SettingKeys.AiModel, "");
        string temp = await Settings.Get(SettingKeys.AiTemperature, "0.3");
        AiEndpoint ep = AiEndpoint.Parse(baseUrl);
        if (ep == null) { return AiReply.Bad("服务地址不合法"); }
        JsonValue msgs = JsonValue.NewArray();
        JsonValue sys = JsonValue.NewObject();
        sys.PutStr("role", "system");
        sys.PutStr("content", systemPrompt);
        msgs.Append(sys);
        JsonValue cur = JsonValue.NewObject();
        cur.PutStr("role", "user");
        cur.PutStr("content", question);
        msgs.Append(cur);
        return await Complete(ep, key, model, temp, msgs.ToJson());
    }

    /* 构造 messages 数组：系统提示词 + 历史（最多 20 轮）+ 当前问题。
    树构建 + ToJson 产出，转义交给 Encoding.JsonEscape（Q 不再需要）。 */
    /* 拼 messages：系统提示词 + 最多 20 轮历史 + 本轮提问。
     *
     * historyJson 是**客户端**传来的（AssistantController 里 this.In("history")），
     * 所以坏 JSON 必须兜住——解析不了就当没有历史，这一轮照样能问。
     * JsonValue.Parse 遇坏 JSON 是**抛**异常，不接住就是 500。
     *
     * 公开是为了能单独测（它是个纯函数，不碰数据库）。
     */
    public static string Messages(AiAgent agent, string historyJson, string question) {
        JsonValue msgs = JsonValue.NewArray();
        JsonValue sys = JsonValue.NewObject();
        sys.PutStr("role", "system");
        sys.PutStr("content", agent.prompt);
        msgs.Append(sys);
        JsonDoc hist = null;
        try {
            hist = JsonDoc.Parse(historyJson);
        } catch (Exception e) {
            /* history 是**客户端**传来的（见 AssistantController 的 this.In），
             * 坏 JSON 不该把请求炸成 500。解析不了就当没有历史——这一轮
             * 照样能问，只是没有上文。 */
            hist = null;
        }
        if (hist != null && hist.KindAt(hist.root) == 4) {
            int keep = hist.Count(hist.root);
            int start = 0;
            if (keep > 20) { start = keep - 20; }
            for (int i = start; i < keep; i = i + 1) {
                int m = hist.At(hist.root, i);
                if (m < 0) { continue; }
                string role = hist.StrAt(hist.Get(m, "role"), "user");
                if (role != "user" && role != "assistant") { role = "user"; }
                string content = hist.StrAt(hist.Get(m, "content"), "");
                if (content.Length == 0) { continue; }
                JsonValue one = JsonValue.NewObject();
                one.PutStr("role", role);
                one.PutStr("content", content);
                msgs.Append(one);
            }
        }
        JsonValue cur = JsonValue.NewObject();
        cur.PutStr("role", "user");
        cur.PutStr("content", question);
        msgs.Append(cur);
        return msgs.ToJson();
    }

    /* AI 外部调用预算：所有请求都必须有有限的大小、时间和重试预算。
    * POST 补全没有幂等键，明确保持不可重试；本地例外只放行固定的
    * 127.0.0.1 Ollama 端点，供应商精确白名单仍由 AiEndpointPolicy 负责。 */
    private static ExternalCallPolicy CallPolicy(AiEndpoint ep, bool streaming) {
        int idle = streaming ? 60000 : 30000;
        int total = streaming ? 300000 : 120000;
        ExternalCallPolicy p = ExternalCallPolicy.Default()
        .ConnectTimeout(10000)
        .WriteTimeout(30000)
        .ReadTimeout(60000)
        .IdleTimeout(idle)
        .TotalTimeout(total)
        .RequestLimit(2 * 1024 * 1024)
        .ResponseLimit(8 * 1024 * 1024)
        .ErrorLimit(128 * 1024)
        .StreamLimit(16 * 1024 * 1024)
        .Redirects(0)
        .RetryNetwork(false)
        .RetryAttempts(0);
        if (ep.Local()) { p.AllowLocalHttp(); }
        return p;
    }

    private static async int WaitStreamProducer(long producer) {
        /* 最多等待 120 秒（30000 * 4ms），防止 producer 协程死锁导致当前任务永久占用连接与内存 */
        int timeoutTicks = 30000;
        while (Task.IsDone(producer) == 0 && timeoutTicks > 0) {
            await Task.Delay(4);
            timeoutTicks = timeoutTicks - 1;
        }
        return 0;
    }

    /* 非流式调用：发送 messages，返回文本或失败原因。 */
    static async AiReply Complete(AiEndpoint ep, string key, string model,
    string temp, string messages) {
        JsonValue body = JsonValue.NewObject();
        body.PutStr("model", model);
        body.PutJson("temperature", Number(temp));
        body.PutBool("stream", false);
        body.PutJson("messages", messages);

        HttpClient http = new HttpClient(ep.Host(), ep.Port());
        if (ep.Tls()) { http = HttpClient.CreateHttps(ep.Host(), ep.Port()); }
        http.SetCallPolicy(CallPolicy(ep, false));
        http.SetHeader("Content-Type", "application/json");
        http.SetHeader("Accept", "application/json");
        if (key.Length > 0) { http.SetHeader("Authorization", "Bearer " + key); }

        string raw = "";
        try {
            HttpResponse resp = await http.SendAsync("POST",
            ep.Path() + "/chat/completions", body.ToJson());
            raw = resp.body;
            if (resp.statusCode >= 500) {
                return AiReply.Bad("AI 服务返回 "
                + Convert.ToString(resp.statusCode));
            }
        } catch (Exception e) {
            return AiReply.Bad("请求 AI 服务失败：" + e.Message);
        } finally {
            /* 关掉连接池里的 keep-alive 连接：不关的话连接会一直挂到
            进程退出，服务端那边也是半开连接。 */
            http.Close();
        }
        if (raw == null || raw.Length == 0) { return AiReply.Bad("AI 服务没有返回内容"); }

        JsonDoc root = null;
        try {
            root = JsonDoc.Parse(raw);
        } catch (Exception e) {
            /* 坏 JSON 不该把整个请求炸成 500：上游返回的可能是代理的
             * HTML 错误页、截断的响应体、网关插的一行日志。 */
            return AiReply.Bad("AI 服务返回的内容无法解析");
        }
        if (root == null) { return AiReply.Bad("AI 服务返回的内容无法解析"); }
        int err = root.Get("error");
        if (err >= 0 && root.KindAt(err) == 5) {
            /* 服务商的错误文案直接回传，不会泄露 Key。 */
            return AiReply.Bad(root.PathStr("error.message", "AI 服务返回错误"));
        }
        string content = root.PathStr("choices[0].message.content", "");
        if (content.Length == 0) {
            int msgSlot = root.Path(root.root, "choices[0].message");
            if (msgSlot < 0) {
                return AiReply.Bad("AI 服务没有返回回答");
            }
        }
        return AiReply.Good(content);
    }

    /* 流式调用：delta 逐块推到浏览器。 */
    public static async AiReply StreamConv(HttpContext ctx, string agentCode,
    string historyJson, string question) {
        if (!await Ready()) { return AiReply.Bad("尚未配置 AI 服务"); }
        string baseUrl = await Settings.Get(SettingKeys.AiBaseUrl, "");
        string key = await Settings.Get(SettingKeys.AiApiKey, "");
        string model = await Settings.Get(SettingKeys.AiModel, "");
        string temp = await Settings.Get(SettingKeys.AiTemperature, "0.3");
        AiEndpoint ep = AiEndpoint.Parse(baseUrl);
        if (ep == null) { return AiReply.Bad("服务地址不合法"); }

        JsonValue body = JsonValue.NewObject();
        body.PutStr("model", model);
        body.PutJson("temperature", Number(temp));
        body.PutBool("stream", true);
        body.PutJson("messages", Messages(AgentOf(agentCode), historyJson, question));
        HttpClient http = new HttpClient(ep.Host(), ep.Port());
        if (ep.Tls()) { http = HttpClient.CreateHttps(ep.Host(), ep.Port()); }
        /* 空闲超时：每个分片重设，慢响应也能存活，静默超时会被挂断。 */
        http.SetCallPolicy(CallPolicy(ep, true));
        http.SetHeader("Content-Type", "application/json");
        http.SetHeader("Accept", "text/event-stream");
        if (key.Length > 0) { http.SetHeader("Authorization", "Bearer " + key); }

        SseSink sink = SseSink.ToMemory();
        /* SseSend 失败后只标记 sink 为 aborted，并让 transport 自己收尾；
        * 不在 producer 仍可能写入时 Dispose。 */
        http.SetCancelProbe(() => {
            if (!ctx.Hijacked()) {
                sink.Abort();
                return true;
            }
            return false;
        });
        long producer = Task.Spawn(http.PostSseToSinkAsync(
        ep.Path() + "/chat/completions", body.ToJson(), sink));

        StringBuilder full = new StringBuilder();
        string pending = "";
        bool finished = false;
        string streamError = "";
        while (!finished) {
            /* TakeCo：事件驱动地等数据——有数据才醒，不靠轮询。原来这里
             * 每 40ms 醒一次问一句"有货了吗"：既把每个分片的到达延迟了
             * 最多 40ms，又在整条流期间白醒着（一次长回答 = 几十次空转）。
             * TakeCo 挂在 sink 的事件门上，写入或 Abort 都会唤醒它。 */
            SseDelivery batch = await sink.TakeCo();
            string piece = batch.data;
            finished = batch.finished;
            if (piece.Length == 0) {
                if (finished) { break; }
                continue;
            }
            pending = pending + piece;
            int nl = pending.IndexOf("\n");
            while (nl >= 0) {
                string line = pending.Substring(0, nl).Trim();
                pending = pending.Substring(nl + 1);
                AiStreamFrame f = Delta(line);
                if (f.kind == "error") {
                    /* 流内错误帧：不是"用户断开"，也不是传输层错误。
                     * 中止上游——provider 报了错之后还可能继续吐数据（或者
                     * 干脆把连接挂着不关），不中止的话下面 WaitStreamProducer
                     * 会一直等到 120 秒上限才返回，白白占着这条连接。
                     * 中止后 sink.Attempt() 会变成 "err: cancelled"，但下面
                     * 先判 streamError，返回给调用方的仍是 provider 的原因。 */
                    streamError = f.text;
                    sink.Abort();
                    finished = true;
                    break;
                }
                if (f.kind == "delta") {
                    full.Append(f.text);
                    AiDeltaDoc d = new AiDeltaDoc();
                    d.text = f.text;
                    if (!await ctx.SseSend("delta",
                    Json.Serialize<AiDeltaDoc>(d))) {
                        /* 用户关闭面板：先让 producer 在安全的 transport
                        * 边界拆掉上游；不能在其仍运行时 Dispose sink。 */
                        sink.Abort();
                        await WaitStreamProducer(producer);
                        sink.Dispose();
                        http.Close();
                        return AiReply.Bad("客户端已断开");
                    }
                }
                nl = pending.IndexOf("\n");
            }
            if (finished) { break; }
        }

        /* 流结束时可能还剩半行：对端把最后一帧发了但**没以换行收尾**
         * （SSE 允许这样收尾，最后一个事件不必有空行）。这半行要按
         * 完整的一行处理，否则最后一个分片会被**静默丢掉**——收流
         * 正常结束、内容却少一截，且没有任何错误提示。 */
        if (streamError.Length == 0 && pending.Trim().Length > 0) {
            AiStreamFrame f = Delta(pending.Trim());
            if (f.kind == "error") {
                streamError = f.text;
            } else if (f.kind == "delta") {
                full.Append(f.text);
                AiDeltaDoc d = new AiDeltaDoc();
                d.text = f.text;
                if (!await ctx.SseSend("delta",
                Json.Serialize<AiDeltaDoc>(d))) {
                    sink.Abort();
                    await WaitStreamProducer(producer);
                    sink.Dispose();
                    http.Close();
                    return AiReply.Bad("客户端已断开");
                }
            }
        }
        await WaitStreamProducer(producer);
        string outcome = sink.Attempt();
        string text = full.ToString();
        sink.Dispose();
        /* 关掉连接池里的 keep-alive 连接（流式结束后上游已读完）。 */
        http.Close();
        if (streamError.Length > 0) {
            return AiReply.Bad("请求 AI 服务失败：" + streamError);
        }
        if (text.Length == 0) {
            if (outcome.StartsWith("err:")) {
                return AiReply.Bad("请求 AI 服务失败：" + outcome.Substring(4).Trim());
            }
            return AiReply.Bad("AI 服务没有返回内容");
        }
        return AiReply.Good(text);
    }

    /* 从 OpenAI 流式 `data:` 行解析出增量文本 / 流内错误 / 空行。
     *
     * provider 可以在 SSE **数据里**报错（HTTP 状态码仍是 200）。这种
     * 帧必须报给调用方——否则调用方拿到半截内容 + 空错误，看起来像
     * "正常结束"，实际是上游炸了。
     */
    public static AiStreamFrame Delta(string line) {
        if (!line.StartsWith("data:")) { return AiStreamFrame.Skip(); }
        string payload = line.Substring(5).Trim();
        if (payload.Length == 0 || payload == "[DONE]") { return AiStreamFrame.Skip(); }
        JsonDoc doc = null;
        try {
            doc = JsonDoc.Parse(payload);
        } catch (Exception e) {
            /* 坏帧跳过，不让整条流断掉。 */
            return AiStreamFrame.Skip();
        }
        if (doc == null) { return AiStreamFrame.Skip(); }
        int frameError = doc.Get("error");
        if (frameError >= 0 && doc.KindAt(frameError) != 0) {
            string reason = doc.PathStr("error.message", "");
            if (reason.Length == 0) { reason = "流内错误帧"; }
            return AiStreamFrame.Error(reason);
        }
        string piece = doc.PathStr("choices[0].delta.content", "");
        if (piece.Length == 0) { return AiStreamFrame.Skip(); }
        return AiStreamFrame.Delta(piece);
    }

    /* 读取服务商 /models 端点返回的模型列表。 */
    public static async List<string> Models(string baseUrl, string key) {
        List<string> ids = new List<string>();
        AiEndpoint ep = AiEndpoint.Parse(baseUrl);
        if (ep == null) { return ids; }
        HttpClient http = new HttpClient(ep.Host(), ep.Port());
        if (ep.Tls()) { http = HttpClient.CreateHttps(ep.Host(), ep.Port()); }
        http.SetCallPolicy(CallPolicy(ep, false));
        http.SetHeader("Accept", "application/json");
        if (key.Length > 0) { http.SetHeader("Authorization", "Bearer " + key); }
        string raw = "";
        try {
            HttpResponse resp = await http.SendAsync("GET", ep.Path() + "/models", "");
            raw = resp.body;
        } catch (Exception e) {
            http.Close();
            return ids;
        }
        http.Close();
        if (raw == null || raw.Length == 0) { return ids; }
        JsonDoc root = null;
        try {
            root = JsonDoc.Parse(raw);
        } catch (Exception e) {
            /* 拿不到模型列表不是致命错误：返回空列表，让调用方按"没有可用
             * 模型"处理。 */
            return ids;
        }
        if (root == null) { return ids; }
        int data = root.Get("data");
        if (data < 0 || root.KindAt(data) != 4) { return ids; }
        int dCount = root.Count(data);
        int m = root.FirstChild(data);
        for (int i = 0; i < dCount && m >= 0; i = i + 1) {
            string id = root.StrAt(root.Get(m, "id"), "");
            if (id.Length > 0) { ids.Add(id); }
            m = root.NextSibling(m);
        }
        return ids;
    }

    /* 执行助手提议的建表语句：仅允许单条 CREATE TABLE，含注释或第二条语句均拒绝。 */
    public static async AiReply ApplySchema(string sql) {
        string s = sql.Trim();
        while (s.EndsWith(";")) { s = s.Substring(0, s.Length - 1).Trim(); }
        if (s.Length == 0) { return AiReply.Bad("没有可执行的建表语句"); }
        if (s.Contains(";")) { return AiReply.Bad("一次只能执行一条建表语句"); }
        string low = s.ToLower();
        if (!low.StartsWith("create table ")) {
            return AiReply.Bad("只允许执行 CREATE TABLE 语句");
        }
        if (low.Contains("--") || low.Contains("/*")) {
            return AiReply.Bad("语句包含注释，已拒绝");
        }
        IDbConnection db = await AuthUser.Lease();
        if (db == null) { return AiReply.Bad("数据库不可用"); }
        try {
            int _n = await db.ExecuteAsync(s);
        } catch (Exception e) {
            return AiReply.Bad("建表失败：" + e.Message);
        } finally {
            AuthUser.Give(db);
        }
        return AiReply.Good("建表成功");
    }

    /* 安全的温度值：仅数字和小数点。 */
    private static string Number(string v) {
        if (v.Length == 0) { return "0.3"; }
        for (int i = 0; i < v.Length; i = i + 1) {
            string ch = v.Substring(i, 1);
            bool digit = ch >= "0" && ch <= "9";
            if (!digit && ch != ".") { return "0.3"; }
        }
        return v;
    }
}

/* 将基础 URL 拆成 HttpClient 所需的 host/port/path/tls。 */
