using System;
using System.Collections.Generic;
using System.Data.Orm;

namespace ZanWeb.Framework.Services;

/* 每个工作进程的实时快照行，按 worker id 主键覆盖更新。 */
[Table(Name = "metrics_live")]
public class MetricLive {
    [Column(IsPrimary = true, IsIdentity = false)]
    public int worker;
    public int pid;
    public long updated;
    public string snapshot;
    public string series;
}

