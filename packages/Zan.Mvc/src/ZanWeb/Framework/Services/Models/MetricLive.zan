using System;
using System.Collections.Generic;

namespace ZanWeb.Framework.Services;

class MetricLive {
    [Column(IsPrimary = true, IsIdentity = false)]
    int worker;
    int pid;
    long updated;
    string snapshot;
    string series;
}

/* 持久化的服务端错误记录。 */
[Table(Name = "metrics_error")]
[Index(Name = "ix_metrics_error_ts", Fields = "ts")]
