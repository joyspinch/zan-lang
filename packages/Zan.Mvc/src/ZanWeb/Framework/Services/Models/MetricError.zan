using System;
using System.Collections.Generic;
using System.Data.Orm;

namespace ZanWeb.Framework.Services;

/* 持久化的服务端错误记录。 */
[Table(Name = "metrics_error")]
[Index(Name = "ix_metrics_error_ts", Fields = "ts")]
class MetricError {
    [Column(IsPrimary = true, IsIdentity = true)]
    long id;
    long ts;
    [Column(StringLength = 64)]
    string origin;
    string detail;
}

