using System;
using System.Collections.Generic;
using System.Data.Orm;

namespace Zan.Web.Services;

/* 持久化的服务端错误记录。 */
[Table(Name = "metrics_error")]
[Index(Name = "ix_metrics_error_ts", Fields = "ts")]
public class MetricError {
    [Column(IsPrimary = true, IsIdentity = true)]
    public long id;
    public long ts;
    [Column(StringLength = 64)]
    public string origin;
    public string detail;
}

