using System;
using System.Collections.Generic;

namespace ZanWeb.Framework.Services;

class MetricError {
    [Column(IsPrimary = true, IsIdentity = true)]
    long id;
    long ts;
    [Column(StringLength = 64)]
    string origin;
    string detail;
}

/* 运行监控的历史数据存储：内存按分钟聚合后批量写入独立 SQLite 数据库。 */
