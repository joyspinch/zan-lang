using System;
using System.Collections.Generic;
using System.Data.Orm;

namespace ZanWeb.Framework.Services;

/* 单接口单分钟流量指标（调用/错误/耗时/流式帧数/字节），同时作为 metrics_minute 表实体。 */
[Table(Name = "metrics_minute")]
public class MetricMinute {
    [Column(IsPrimary = true)]
    public long minute;  // 截断到分钟的 epoch 秒
    /* 接口由 method + path 两个字段组成，method 为请求方法，path 为路由或静态资源路径。 */
    [Column(IsPrimary = true, StringLength = 16)]
    public string method;
    [Column(IsPrimary = true, StringLength = 400)]
    public string path;
    public long calls;
    public long errors;
    /* 微秒单位，避免毫秒级快接口被归零。 */
    [Column(Name = "total_us")]
    public long totalUs;
    [Column(Name = "max_us")]
    public long maxUs;
    /* 该桶请求的 P95 耗时（微秒）：内存里按固定档位直方图累计，刷写时取 第 95 百分位所在档位的上沿。分位数不可加，多进程/多次刷写按最大 值合并——是全桶真值的上界，不会把慢请求算丢。 */
    [Column(Name = "p95_us")]
    public long p95Us;
    /* 长连接推送的帧数与字节数（SSE/WebSocket），以帧/字节代替延迟度量流式接口。 */
    public long frames;
    public long bytes;
}

