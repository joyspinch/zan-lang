using System;
using System.Collections.Generic;

namespace ZanWeb.Framework.Services;

class MetricMinute {
    [Column(IsPrimary = true)]
    long minute;  // 截断到分钟的 epoch 秒
    /* 接口由 method + path 两个字段组成，method 为请求方法，path 为路由或静态资源路径。 */
    [Column(IsPrimary = true, StringLength = 16)]
    string method;
    [Column(IsPrimary = true, StringLength = 400)]
    string path;
    long calls;
    long errors;
    /* 微秒单位，避免毫秒级快接口被归零。 */
    [Column(Name = "total_us")]
    long totalUs;
    [Column(Name = "max_us")]
    long maxUs;
    /* 该桶请求的 P95 耗时（微秒）：内存里按固定档位直方图累计，刷写时取 第 95 百分位所在档位的上沿。分位数不可加，多进程/多次刷写按最大 值合并——是全桶真值的上界，不会把慢请求算丢。 */
    [Column(Name = "p95_us")]
    long p95Us;
    /* 长连接推送的帧数与字节数（SSE/WebSocket），以帧/字节代替延迟度量流式接口。 */
    long frames;
    long bytes;
}

/* 单日单 SQL 模板的指标（调用/慢次数/耗时），SQL 已规范化，不存储用户输入。 */
[Table(Name = "metrics_sql_day")]
