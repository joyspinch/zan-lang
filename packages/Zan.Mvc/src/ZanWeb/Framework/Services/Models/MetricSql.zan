using System;
using System.Collections.Generic;

namespace ZanWeb.Framework.Services;

class MetricSql {
    [Column(IsPrimary = true)]
    long day;  // 截断到午夜的 epoch 秒
    [Column(IsPrimary = true, StringLength = 400)]
    string sql;  // 规范化的语句模板
    long calls;
    long slow;  // 达到 [log].slowSqlMs 阈值的执行
    [Column(Name = "total_us")]
    long totalUs;  // 微秒单位
    [Column(Name = "max_us")]
    long maxUs;
}

/* 存活工作进程发布的实时行（仅读结构，age 由读取时计算）。 */
