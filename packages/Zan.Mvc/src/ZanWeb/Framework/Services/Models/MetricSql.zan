using System;
using System.Collections.Generic;
using System.Data.Orm;

namespace ZanWeb.Framework.Services;

/* 单日单 SQL 模板的指标（调用/慢次数/耗时），SQL 已规范化，不存储用户输入。 */
[Table(Name = "metrics_sql_day")]
public class MetricSql {
    [Column(IsPrimary = true)]
    public long day;  // 截断到午夜的 epoch 秒
    [Column(IsPrimary = true, StringLength = 400)]
    public string sql;  // 规范化的语句模板
    public long calls;
    public long slow;  // 达到 [log].slowSqlMs 阈值的执行
    [Column(Name = "total_us")]
    public long totalUs;  // 微秒单位
    [Column(Name = "max_us")]
    public long maxUs;
}

