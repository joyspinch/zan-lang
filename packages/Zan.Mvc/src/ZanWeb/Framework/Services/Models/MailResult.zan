using System;
using System.Collections.Generic;

namespace ZanWeb.Framework.Services;

public class MailResult {
    public bool ok;
    public string message;

    public MailResult() {
        this.ok = false;
        this.message = "";
    }

    public static MailResult Fail(string message) {
        MailResult r = new MailResult();
        r.message = message;
        return r;
    }

    public static MailResult Good() {
        MailResult r = new MailResult();
        r.ok = true;
        r.message = "已发送";
        return r;
    }

    public bool Ok() { return this.ok; }
    public string Message() { return this.message; }
}

/* 一次 SMTP 会话（明文或 TLS）。 */
