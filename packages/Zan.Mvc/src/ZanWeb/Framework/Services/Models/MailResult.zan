using System;
using System.Collections.Generic;

namespace ZanWeb.Framework.Services;

class MailResult {
    bool ok;
    string message;

    MailResult() {
        this.ok = false;
        this.message = "";
    }

    static MailResult Fail(string message) {
        MailResult r = new MailResult();
        r.message = message;
        return r;
    }

    static MailResult Good() {
        MailResult r = new MailResult();
        r.ok = true;
        r.message = "已发送";
        return r;
    }

    bool Ok() { return this.ok; }
    string Message() { return this.message; }
}

/* 一次 SMTP 会话（明文或 TLS）。 */
