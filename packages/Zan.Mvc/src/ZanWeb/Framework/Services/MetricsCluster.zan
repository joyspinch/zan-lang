using System;
using System.Collections.Generic;
using System.Json;

namespace Zan.Web.Services;

public class MetricsCluster {
    /* 发布间隔 2 秒，秒级数据失效阈值 30 秒；累加总量不受失效阈值影响。 */
    public static int PublishSeconds = 2;
    public static int FreshSeconds = 30;

    /* 每个 worker 一个后台协程，定期发布快照。 */
    public static async void Loop() {
        while (true) {
            await Task.Delay(PublishSeconds * 1000);
            await Publish();
        }
    }

    /* 覆写本 worker 的实时行（快照 + 时序）。 */
    public static async void Publish() {
        if (!MetricsStore.ready) { return; }
        WebApp app = WebHost.Current();
        if (app == null) { return; }
        IDbConnection db = await MetricsStore.Lease();
        if (db == null) { return; }
        IZanSql fsql = ZanSql.FromConnection(db);
        try {
            MetricLive row = new MetricLive();
            row.worker = ProcessHost.WorkerId();
            row.pid = ProcessHost.Pid();
            row.updated = (long)WebApp.NowSeconds();
            row.snapshot = app.MetricsJson();
            row.series = app.MetricsSeriesJson(120);
            /* 按 worker 主键冲突时覆写非计数列。 */
            int _n = await fsql.Insert<MetricLive>(row)
                .OnConflict(a => a.worker)
                .ExecuteAffrowsAsync();
        } catch (Exception ex) {
            Console.WriteLine("[metrics] live publish failed: " + ex.Message);
        } finally {
            MetricsStore.Give(db);
        }
    }

    /* 读取所有 worker 发布的指定列（snapshot 或 series）及年龄，可选时效过滤。 */
    public static async List<LiveRow> LiveRows(string col, int maxAgeSec) {
        List<LiveRow> outp = new List<LiveRow>();
        if (!MetricsStore.ready) { return outp; }
        IDbConnection db = await MetricsStore.Lease();
        if (db == null) { return outp; }
        IZanSql fsql = ZanSql.FromConnection(db);
        try {
            long now = (long)WebApp.NowSeconds();
            long cut = now - (long)maxAgeSec;
            bool fresh = maxAgeSec > 0;
            List<MetricLive> rows = await fsql.Select<MetricLive>()
                .WhereIf(fresh, a => a.updated >= cut)
                .OrderBy(a => a.worker)
                .ToListAsync();
            for (int i = 0; i < rows.Count; i = i + 1) {
                MetricLive m = rows[i];
                LiveRow w = new LiveRow();
                w.worker = m.worker;
                w.age = now - m.updated;
                if (w.age < 0) { w.age = 0; }
                /* 根据参数选择返回 snapshot 或 series 字段。 */
                w.json = col == "series" ? m.series : m.snapshot;
                outp.Add(w);
            }
        } finally {
            MetricsStore.Give(db);
        }
        return outp;
    }

    /* 合并所有 worker 的快照，追加 workers/processes/worker_list 字段。 */
    public static async string SnapshotJson() {
        WebApp app = WebHost.Current();
        await Publish();  // 本 worker 始终保持最新
        List<LiveRow> rows = await LiveRows("snapshot", 0);
        List<JsonDoc> ms = new List<JsonDoc>();
        List<LiveRow> kept = new List<LiveRow>();
        int live = 0;
        for (int i = 0; i < rows.Count; i = i + 1) {
            LiveRow w = rows[i];
            JsonDoc m = JsonDoc.Parse(w.json);
            if (m == null) { continue; }
            ms.Add(m);
            kept.Add(w);
            if (w.age <= (long)FreshSeconds) { live = live + 1; }
        }

        string own = app.MetricsJson();
        if (ms.Count <= 1) {
            /* 单进程场景：自身快照即服务器全貌。 */
            JsonDoc ownDoc = JsonDoc.Parse(own);
            if (ownDoc == null) { return own; }
            List<JsonDoc> self = new List<JsonDoc>();
            self.Add(ownDoc);
            List<LiveRow> selfRow = new List<LiveRow>();
            LiveRow r = new LiveRow();
            r.worker = ProcessHost.WorkerId();
            r.age = 0;
            r.json = own;
            selfRow.Add(r);
            return MergeSnapshots(self, 1, selfRow);
        }
        return MergeSnapshots(ms, live, kept);
    }

    /* 每个进程一行，含 uptime/requests/queries/load 等，age 为发布到现在的秒数。 */
    public static void WriteProcesses(JsonWriter w, List<LiveRow> rows, List<JsonDoc> ms) {
        w.StartArray();
        for (int i = 0; i < ms.Count; i = i + 1) {
            JsonDoc m = ms[i];
            long age = 0;
            int wid = (int)m.PathLong("worker_id", 0);
            if (i < rows.Count) {
                age = rows[i].age;
                wid = rows[i].worker;
            }
            w.StartObject();
            w.WriteProperty("worker", (long)wid);
            w.WriteProperty("pid", m.PathLong("pid", 0));
            w.WriteProperty("uptime_ms", m.PathLong("uptime_ms", 0));
            w.WriteProperty("cpu_percent", m.PathLong("cpu_percent", -1));
            w.WriteProperty("cpu_ms", m.PathLong("cpu_ms", 0));
            w.WriteProperty("mem_rss_bytes", m.PathLong("mem_rss_bytes", 0));

            long n = m.PathLong("requests.count", 0);
            w.WriteProperty("requests", n);
            w.WriteProperty("errors", m.PathLong("requests.errors", 0));
            w.WriteProperty("avg_us", m.PathLong("requests.avg_us", 0));
            w.WriteProperty("max_us", m.PathLong("requests.max_us", 0));

            w.WriteProperty("concurrent", m.PathLong("load.concurrent", 0));
            w.WriteProperty("streams", m.PathLong("load.streams", 0));
            w.WriteProperty("queries", m.PathLong("queries.count", 0));
            w.WriteProperty("age", age);
            long alive = 0;
            if (age <= (long)FreshSeconds) { alive = 1; }
            w.WriteProperty("live", alive);
            w.EndObject();
        }
        w.EndArray();
    }

    public static string MergeSnapshots(List<JsonDoc> ms, int live, List<LiveRow> rows) {
        long upt = 0;
        long cpuPct = 0;
        long rss = 0;
        long rCount = 0;
        long rErrors = 0;
        long rFailed = 0;
        long rRejected = 0;
        long rAvgW = 0;
        long rMax = 0;
        long rSlowTh = 0;
        long rSlowN = 0;
        long qCount = 0;
        long qAvgW = 0;
        long qMax = 0;
        long qSlowTh = 0;
        long qSlowN = 0;
        long lConc = 0;
        long lPeak = 0;
        long lStreams = 0;
        long lFrames = 0;
        long lBytes = 0;
        StringBuilder wl = new StringBuilder();
        List<ClusterTopEntry> topReq = new List<ClusterTopEntry>();
        List<ClusterTopEntry> topSql = new List<ClusterTopEntry>();
        for (int i = 0; i < ms.Count; i = i + 1) {
            JsonDoc m = ms[i];
            if (i > 0) { wl.Append(","); }
            wl.Append(Convert.ToString(m.PathLong("worker_id", 0)));
            long u = m.PathLong("uptime_ms", 0);
            if (u > upt) { upt = u; }
            long c = m.PathLong("cpu_percent", 0 - 1);
            if (c > 0) { cpuPct = cpuPct + c; }
            long rb = m.PathLong("mem_rss_bytes", 0 - 1);
            if (rb > 0) { rss = rss + rb; }

            long n = m.PathLong("requests.count", 0);
            rCount = rCount + n;
            rErrors = rErrors + m.PathLong("requests.errors", 0);
            rFailed = rFailed + m.PathLong("requests.failed", 0);
            rRejected = rRejected + m.PathLong("requests.rejected", 0);
            rAvgW = rAvgW + n * m.PathLong("requests.avg_us", 0);
            long rqMax = m.PathLong("requests.max_us", 0);
            if (rqMax > rMax) { rMax = rqMax; }
            rSlowTh = m.PathLong("requests.slow_threshold_us", 0);
            rSlowN = rSlowN + m.PathLong("requests.slow_count", 0);

            long n2 = m.PathLong("queries.count", 0);
            qCount = qCount + n2;
            qAvgW = qAvgW + n2 * m.PathLong("queries.avg_us", 0);
            long qsMax = m.PathLong("queries.max_us", 0);
            if (qsMax > qMax) { qMax = qsMax; }
            qSlowTh = m.PathLong("queries.slow_threshold_us", 0);
            qSlowN = qSlowN + m.PathLong("queries.slow_count", 0);

            lConc = lConc + m.PathLong("load.concurrent", 0);
            lPeak = lPeak + m.PathLong("load.peak", 0);
            lStreams = lStreams + m.PathLong("load.streams", 0);
            lFrames = lFrames + m.PathLong("load.stream_frames", 0);
            lBytes = lBytes + m.PathLong("load.stream_bytes", 0);

            MergeTop(topReq, m, "top_requests", "req");
            MergeTop(topSql, m, "top_sql", "sql");
        }

        JsonWriter w = new JsonWriter();
        w.StartObject();
        w.WriteProperty("uptime_ms", upt);
        w.WriteProperty("pid", (long)ProcessHost.Pid());
        w.WriteProperty("worker_id", (long)ProcessHost.WorkerId());
        w.WriteProperty("workers", (long)live);
        w.WriteProperty("workers_counted", (long)ms.Count);
        w.WriteProperty("worker_list", wl.ToString());
        w.WriteProperty("cpu_percent", cpuPct);
        w.WriteProperty("mem_rss_bytes", rss);

        w.WriteKey("requests");
        w.StartObject();
        w.WriteProperty("count", rCount);
        w.WriteProperty("errors", rErrors);
        w.WriteProperty("failed", rFailed);
        w.WriteProperty("rejected", rRejected);
        long rAvg = 0;
        if (rCount > 0) { rAvg = rAvgW / rCount; }
        w.WriteProperty("avg_us", rAvg);
        w.WriteProperty("max_us", rMax);
        w.WriteProperty("slow_threshold_us", rSlowTh);
        w.WriteProperty("slow_count", rSlowN);
        w.EndObject();

        w.WriteKey("queries");
        w.StartObject();
        w.WriteProperty("count", qCount);
        long qAvg = 0;
        if (qCount > 0) { qAvg = qAvgW / qCount; }
        w.WriteProperty("avg_us", qAvg);
        w.WriteProperty("max_us", qMax);
        w.WriteProperty("slow_threshold_us", qSlowTh);
        w.WriteProperty("slow_count", qSlowN);
        w.EndObject();

        w.WriteKey("load");
        w.StartObject();
        w.WriteProperty("concurrent", lConc);
        w.WriteProperty("peak", lPeak);
        w.WriteProperty("streams", lStreams);
        w.WriteProperty("stream_frames", lFrames);
        w.WriteProperty("stream_bytes", lBytes);
        w.EndObject();

        w.WriteKey("top_requests");
        WriteTopArray(w, SortTop(topReq), "req");

        w.WriteKey("top_sql");
        WriteTopArray(w, SortTop(topSql), "sql");

        w.WriteKey("processes");
        WriteProcesses(w, rows, ms);

        w.EndObject();
        return w.ToString();
    }

    /* 合并一个 worker 的 top 列表：同 key 累加 count/total_us，取较大 max_us，重算 avg。 */
    private static void MergeTop(List<ClusterTopEntry> merged, JsonDoc doc, string topKey, string itemKey) {
        int arr = doc.Get(topKey);
        if (arr < 0 || doc.KindAt(arr) != 4) { return; }
        int count = doc.Count(arr);
        int p = doc.FirstChild(arr);
        for (int i = 0; i < count && p >= 0; i = i + 1) {
            string k = doc.StrAt(doc.Get(p, itemKey), "");
            ClusterTopEntry hit = null;
            for (int j = 0; j < merged.Count; j = j + 1) {
                if (merged[j].key == k) { hit = merged[j]; break; }
            }
            long c = doc.LongAt(doc.Get(p, "count"), 0);
            long errs = doc.LongAt(doc.Get(p, "errors"), 0);
            long fld = doc.LongAt(doc.Get(p, "failed"), 0);
            long rej = doc.LongAt(doc.Get(p, "rejected"), 0);
            long tot = doc.LongAt(doc.Get(p, "total_us"), 0);
            long mx = doc.LongAt(doc.Get(p, "max_us"), 0);
            if (hit == null) {
                ClusterTopEntry row = new ClusterTopEntry();
                row.key = k;
                row.count = c;
                row.errors = errs;
                row.failed = fld;
                row.rejected = rej;
                row.totalUs = tot;
                row.maxUs = mx;
                Reavg(row);
                merged.Add(row);
            } else {
                hit.count = hit.count + c;
                hit.errors = hit.errors + errs;
                hit.failed = hit.failed + fld;
                hit.rejected = hit.rejected + rej;
                hit.totalUs = hit.totalUs + tot;
                if (mx > hit.maxUs) { hit.maxUs = mx; }
                Reavg(hit);
            }
            p = doc.NextSibling(p);
        }
    }

    private static void Reavg(ClusterTopEntry row) {
        if (row.count > 0) {
            row.avgUs = row.totalUs / row.count;
        } else {
            row.avgUs = 0;
        }
    }

    /* 按累计耗时降序排列，最多取 20 条，选择排序。 */
    private static List<ClusterTopEntry> SortTop(List<ClusterTopEntry> rows) {
        for (int a = 0; a < rows.Count - 1; a = a + 1) {
            int best = a;
            for (int b = a + 1; b < rows.Count; b = b + 1) {
                if (rows[b].totalUs > rows[best].totalUs) {
                    best = b;
                }
            }
            if (best != a) {
                ClusterTopEntry tmp = rows[a];
                rows[a] = rows[best];
                rows[best] = tmp;
            }
        }
        return rows;
    }

    private static void WriteTopArray(JsonWriter w, List<ClusterTopEntry> rows, string itemKey) {
        w.StartArray();
        int keep = rows.Count;
        if (keep > 20) { keep = 20; }
        for (int i = 0; i < keep; i = i + 1) {
            ClusterTopEntry e = rows[i];
            w.StartObject();
            w.WriteProperty(itemKey, e.key);
            w.WriteProperty("count", e.count);
            w.WriteProperty("errors", e.errors);
            w.WriteProperty("failed", e.failed);
            w.WriteProperty("rejected", e.rejected);
            w.WriteProperty("total_us", e.totalUs);
            w.WriteProperty("max_us", e.maxUs);
            w.WriteProperty("avg_us", e.avgUs);
            w.EndObject();
        }
        w.EndArray();
    }

    /* 合并秒级时序：请求/错误相加，延迟按请求数加权，p95/max 取最值，CPU/RSS 相加。 */
    public static async string SeriesJson(int seconds) {
        WebApp app = WebHost.Current();
        List<LiveRow> rows = await LiveRows("series",
            FreshSeconds);
        if (rows.Count <= 1) { return app.MetricsSeriesJson(seconds); }
        int want = seconds;
        if (want <= 0) { want = 120; }
        long[] req = new long[want];
        long[] err = new long[want];
        long[] avgW = new long[want];
        long[] p95 = new long[want];
        long[] max = new long[want];
        long[] q = new long[want];
        long[] qavgW = new long[want];
        long[] cpu = new long[want];
        long[] rssArr = new long[want];
        int merged = 0;
        for (int i = 0; i < rows.Count; i = i + 1) {
            JsonDoc s = JsonDoc.Parse(rows[i].json);
            if (s == null) { continue; }
            int pts = s.Get("points");
            if (pts < 0 || s.KindAt(pts) != 4) { continue; }
            merged = merged + 1;
            /* 各 worker 以自身时间零点编号，回移 age 使同一秒来自所有 worker 的数据对齐。 */
            int shift = (int)rows[i].age;
            int count = s.Count(pts);
            int p = s.FirstChild(pts);
            for (int j = 0; j < count && p >= 0; j = j + 1) {
                long t = s.LongAt(s.Get(p, "t"), 1);
                if (t <= 0) {
                    int idx = want - 1 + (int)t - shift;  // t: -(want-1)..0
                    if (idx >= 0 && idx < want) {
                        long r = s.LongAt(s.Get(p, "req"), 0);
                        req[idx] = req[idx] + r;
                        err[idx] = err[idx] + s.LongAt(s.Get(p, "err"), 0);
                        avgW[idx] = avgW[idx] + r * s.LongAt(s.Get(p, "avg_us"), 0);
                        long p95v = s.LongAt(s.Get(p, "p95_us"), 0);
                        if (p95v > p95[idx]) { p95[idx] = p95v; }
                        long maxv = s.LongAt(s.Get(p, "max_us"), 0);
                        if (maxv > max[idx]) { max[idx] = maxv; }
                        long qn = s.LongAt(s.Get(p, "queries"), 0);
                        q[idx] = q[idx] + qn;
                        qavgW[idx] = qavgW[idx] + qn * s.LongAt(s.Get(p, "query_avg_us"), 0);
                        long c = s.LongAt(s.Get(p, "cpu_percent"), 0 - 1);
                        if (c > 0) { cpu[idx] = cpu[idx] + c; }
                        long rb = s.LongAt(s.Get(p, "mem_rss_bytes"), 0 - 1);
                        if (rb > 0) { rssArr[idx] = rssArr[idx] + rb; }
                    }
                }
                p = s.NextSibling(p);
            }
        }
        if (merged <= 1) { return app.MetricsSeriesJson(seconds); }
        StringBuilder sb = new StringBuilder();
        sb.Append("{\"step_ms\":1000,\"count\":");
        sb.Append(Convert.ToString(want));
        sb.Append(",\"workers\":");
        sb.Append(Convert.ToString(merged));
        sb.Append(",\"points\":[");
        for (int idx = 0; idx < want; idx = idx + 1) {
            if (idx > 0) { sb.Append(","); }
            long avg = 0;
            if (req[idx] > 0) { avg = avgW[idx] / req[idx]; }
            long qavg = 0;
            if (q[idx] > 0) { qavg = qavgW[idx] / q[idx]; }
            sb.Append("{\"t\":");
            sb.Append(Convert.ToString((long)idx - (long)want + 1));
            sb.Append(",\"req\":");
            sb.Append(Convert.ToString(req[idx]));
            sb.Append(",\"err\":");
            sb.Append(Convert.ToString(err[idx]));
            sb.Append(",\"avg_us\":");
            sb.Append(Convert.ToString(avg));
            sb.Append(",\"p95_us\":");
            sb.Append(Convert.ToString(p95[idx]));
            sb.Append(",\"max_us\":");
            sb.Append(Convert.ToString(max[idx]));
            sb.Append(",\"queries\":");
            sb.Append(Convert.ToString(q[idx]));
            sb.Append(",\"query_avg_us\":");
            sb.Append(Convert.ToString(qavg));
            sb.Append(",\"cpu_percent\":");
            sb.Append(Convert.ToString(cpu[idx]));
            sb.Append(",\"mem_rss_bytes\":");
            sb.Append(Convert.ToString(rssArr[idx]));
            sb.Append("}");
        }
        sb.Append("]}");
        return sb.ToString();
    }
}
