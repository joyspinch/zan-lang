using System;
using System.Collections.Generic;
using System.Json;

namespace Zan.Web.Services;

public class MetricsCluster {
    /* 发布间隔 2 秒，秒级数据失效阈值 30 秒；累加总量不受失效阈值影响。 */
    public static int PublishSeconds = 2;
    public static int FreshSeconds = 30;

    /* 每个 worker 一个后台协程，定期发布快照。 */
    public static async void Loop() {
        while (true) {
            await Task.Delay(PublishSeconds * 1000);
            await Publish();
        }
    }

    /* 覆写本 worker 的实时行（快照 + 时序）。 */
    public static async void Publish() {
        if (!MetricsStore.ready) { return; }
        WebApp app = WebHost.Current();
        if (app == null) { return; }
        IDbConnection db = await MetricsStore.Lease();
        if (db == null) { return; }
        IZanSql fsql = ZanSql.FromConnection(db);
        try {
            MetricLive row = new MetricLive();
            row.worker = ProcessHost.WorkerId();
            row.pid = ProcessHost.Pid();
            row.updated = (long)WebApp.NowSeconds();
            row.snapshot = app.MetricsJson();
            row.series = app.MetricsSeriesJson(120);
            /* 按 worker 主键冲突时覆写非计数列。 */
            int _n = await fsql.Insert<MetricLive>(row)
                .OnConflict(a => a.worker)
                .ExecuteAffrowsAsync();
        } catch (Exception ex) {
            Console.WriteLine("[metrics] live publish failed: " + ex.Message);
        } finally {
            MetricsStore.Give(db);
        }
    }

    /* 读取所有 worker 发布的指定列（snapshot 或 series）及年龄，可选时效过滤。 */
    public static async List<LiveRow> LiveRows(string col, int maxAgeSec) {
        List<LiveRow> outp = new List<LiveRow>();
        if (!MetricsStore.ready) { return outp; }
        IDbConnection db = await MetricsStore.Lease();
        if (db == null) { return outp; }
        IZanSql fsql = ZanSql.FromConnection(db);
        try {
            long now = (long)WebApp.NowSeconds();
            long cut = now - (long)maxAgeSec;
            bool fresh = maxAgeSec > 0;
            List<MetricLive> rows = await fsql.Select<MetricLive>()
                .WhereIf(fresh, a => a.updated >= cut)
                .OrderBy(a => a.worker)
                .ToListAsync();
            for (int i = 0; i < rows.Count; i = i + 1) {
                MetricLive m = rows[i];
                LiveRow w = new LiveRow();
                w.worker = m.worker;
                w.age = now - m.updated;
                if (w.age < 0) { w.age = 0; }
                /* 根据参数选择返回 snapshot 或 series 字段。 */
                w.json = col == "series" ? m.series : m.snapshot;
                outp.Add(w);
            }
        } finally {
            MetricsStore.Give(db);
        }
        return outp;
    }

    /* 合并所有 worker 的快照，追加 workers/processes/worker_list 字段。 */
    public static async string SnapshotJson() {
        WebApp app = WebHost.Current();
        await Publish();  // 本 worker 始终保持最新
        List<LiveRow> rows = await LiveRows("snapshot", 0);
        List<JsonValue> ms = new List<JsonValue>();
        List<LiveRow> kept = new List<LiveRow>();
        int live = 0;
        for (int i = 0; i < rows.Count; i = i + 1) {
            LiveRow w = rows[i];
            JsonValue m = JsonValue.ParseLenient(w.json);
            if (m == null || !m.IsObject()) { continue; }
            ms.Add(m);
            kept.Add(w);
            if (w.age <= (long)FreshSeconds) { live = live + 1; }
        }

        string own = app.MetricsJson();
        if (ms.Count <= 1) {
            /* 单进程场景：自身快照即服务器全貌。 */
            JsonValue o = JsonValue.ParseLenient(own);
            if (o == null || !o.IsObject()) { return own; }
            List<JsonValue> self = new List<JsonValue>();
            self.Add(o);
            List<LiveRow> selfRow = new List<LiveRow>();
            LiveRow r = new LiveRow();
            r.worker = ProcessHost.WorkerId();
            r.age = 0;
            r.json = own;
            selfRow.Add(r);
            o.Put("processes", ProcessesJson(selfRow, self));
            /* 单 worker 场景补全 fleet 字段，避免页面显示异常。 */
            o.Put("workers", Num(1));
            o.Put("workers_counted", Num(1));
            o.Put("worker_list", JsonValue.NewStr(
                Convert.ToString(ProcessHost.WorkerId())));
            return o.ToJson();
        }
        JsonValue merged = JsonValue.ParseLenient(
            MergeSnapshots(ms, live));
        if (merged == null || !merged.IsObject()) { return own; }
        merged.Put("processes", ProcessesJson(kept, ms));
        return merged.ToJson();
    }

    /* 每个进程一行，含 uptime/requests/queries/load 等，age 为发布到现在的秒数。 */
    public static JsonValue ProcessesJson(List<LiveRow> rows, List<JsonValue> ms) {
        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < ms.Count; i = i + 1) {
            JsonValue m = ms[i];
            long age = 0;
            int wid = (int)m.Long("worker_id", 0);
            if (i < rows.Count) {
                age = rows[i].age;
                wid = rows[i].worker;
            }
            JsonValue o = JsonValue.NewObject();
            o.Put("worker", Num(wid));
            o.Put("pid", Num(m.Long("pid", 0)));
            o.Put("uptime_ms", Num(m.Long("uptime_ms", 0)));
            o.Put("cpu_percent", Num(m.Long("cpu_percent", 0 - 1)));
            o.Put("cpu_ms", Num(m.Long("cpu_ms", 0)));
            o.Put("mem_rss_bytes", Num(m.Long("mem_rss_bytes", 0)));
            JsonValue rq = m.Get("requests");
            long n = 0;
            if (rq != null) {
                n = rq.Long("count", 0);
                o.Put("errors", Num(rq.Long("errors", 0)));
                o.Put("avg_us", Num(rq.Long("avg_us", 0)));
                o.Put("max_us", Num(rq.Long("max_us", 0)));
            }
            o.Put("requests", Num(n));
            JsonValue ld = m.Get("load");
            if (ld != null) {
                o.Put("concurrent", Num(ld.Long("concurrent", 0)));
                o.Put("streams", Num(ld.Long("streams", 0)));
            }
            JsonValue qs = m.Get("queries");
            if (qs != null) {
                o.Put("queries", Num(qs.Long("count", 0)));
            }
            o.Put("age", Num(age));
            long alive = 0;
            if (age <= (long)FreshSeconds) { alive = 1; }
            o.Put("live", Num(alive));
            arr.Append(o);
        }
        return arr;
    }

    public static string MergeSnapshots(List<JsonValue> ms, int live) {
        long upt = 0;
        long cpuPct = 0;
        long rss = 0;
        long rCount = 0;
        long rErrors = 0;
        long rFailed = 0;
        long rRejected = 0;
        long rAvgW = 0;
        long rMax = 0;
        long rSlowTh = 0;
        long rSlowN = 0;
        long qCount = 0;
        long qAvgW = 0;
        long qMax = 0;
        long qSlowTh = 0;
        long qSlowN = 0;
        long lConc = 0;
        long lPeak = 0;
        long lStreams = 0;
        long lFrames = 0;
        long lBytes = 0;
        StringBuilder wl = new StringBuilder();
        JsonValue topReq = JsonValue.NewArray();
        JsonValue topSql = JsonValue.NewArray();
        for (int i = 0; i < ms.Count; i = i + 1) {
            JsonValue m = ms[i];
            if (i > 0) { wl.Append(","); }
            wl.Append(Convert.ToString(m.Long("worker_id", 0)));
            if (m.Long("uptime_ms", 0) > upt) { upt = m.Long("uptime_ms", 0); }
            long c = m.Long("cpu_percent", 0 - 1);
            if (c > 0) { cpuPct = cpuPct + c; }
            long rb = m.Long("mem_rss_bytes", 0 - 1);
            if (rb > 0) { rss = rss + rb; }
            JsonValue rq = m.Get("requests");
            if (rq != null) {
                long n = rq.Long("count", 0);
                rCount = rCount + n;
                rErrors = rErrors + rq.Long("errors", 0);
                rFailed = rFailed + rq.Long("failed", 0);
                rRejected = rRejected + rq.Long("rejected", 0);
                rAvgW = rAvgW + n * rq.Long("avg_us", 0);
                if (rq.Long("max_us", 0) > rMax) { rMax = rq.Long("max_us", 0); }
                rSlowTh = rq.Long("slow_threshold_us", 0);
                rSlowN = rSlowN + rq.Long("slow_count", 0);
            }
            JsonValue qs = m.Get("queries");
            if (qs != null) {
                long n2 = qs.Long("count", 0);
                qCount = qCount + n2;
                qAvgW = qAvgW + n2 * qs.Long("avg_us", 0);
                if (qs.Long("max_us", 0) > qMax) { qMax = qs.Long("max_us", 0); }
                qSlowTh = qs.Long("slow_threshold_us", 0);
                qSlowN = qSlowN + qs.Long("slow_count", 0);
            }
            JsonValue ld = m.Get("load");
            if (ld != null) {
                lConc = lConc + ld.Long("concurrent", 0);
                lPeak = lPeak + ld.Long("peak", 0);
                lStreams = lStreams + ld.Long("streams", 0);
                lFrames = lFrames + ld.Long("stream_frames", 0);
                lBytes = lBytes + ld.Long("stream_bytes", 0);
            }
            MergeTop(topReq, m.Get("top_requests"), "req");
            MergeTop(topSql, m.Get("top_sql"), "sql");
        }

        JsonValue requests = JsonValue.NewObject();
        requests.Put("count", Num(rCount));
        requests.Put("errors", Num(rErrors));
        requests.Put("failed", Num(rFailed));
        requests.Put("rejected", Num(rRejected));
        long rAvg = 0;
        if (rCount > 0) { rAvg = rAvgW / rCount; }
        requests.Put("avg_us", Num(rAvg));
        requests.Put("max_us", Num(rMax));
        requests.Put("slow_threshold_us", Num(rSlowTh));
        requests.Put("slow_count", Num(rSlowN));

        JsonValue queries = JsonValue.NewObject();
        queries.Put("count", Num(qCount));
        long qAvg = 0;
        if (qCount > 0) { qAvg = qAvgW / qCount; }
        queries.Put("avg_us", Num(qAvg));
        queries.Put("max_us", Num(qMax));
        queries.Put("slow_threshold_us", Num(qSlowTh));
        queries.Put("slow_count", Num(qSlowN));

        JsonValue load = JsonValue.NewObject();
        load.Put("concurrent", Num(lConc));
        load.Put("peak", Num(lPeak));
        load.Put("streams", Num(lStreams));
        load.Put("stream_frames", Num(lFrames));
        load.Put("stream_bytes", Num(lBytes));

        JsonValue o = JsonValue.NewObject();
        o.Put("uptime_ms", Num(upt));
        o.Put("pid", Num(ProcessHost.Pid()));
        o.Put("worker_id", Num(ProcessHost.WorkerId()));
        o.Put("workers", Num(live));
        /* 计入所有参与合并的 worker（含已停发），停发与流量消失的区别由此区分。 */
        o.Put("workers_counted", Num(ms.Count));
        o.Put("worker_list", JsonValue.NewStr(wl.ToString()));
        o.Put("cpu_percent", Num(cpuPct));
        o.Put("mem_rss_bytes", Num(rss));
        o.Put("requests", requests);
        o.Put("queries", queries);
        o.Put("load", load);
        o.Put("top_requests", SortTop(topReq));
        o.Put("top_sql", SortTop(topSql));
        return o.ToJson();
    }

    /* 合并一个 worker 的 top 列表：同 key 累加 count/total_us，取较大 max_us，重算 avg。 */
    private static void MergeTop(JsonValue merged, JsonValue add, string key) {
        if (add == null || !add.IsArray()) { return; }
        for (int i = 0; i < add.Count(); i = i + 1) {
            JsonValue s = add.At(i);
            string k = s.Str(key, "");
            JsonValue hit = null;
            for (int j = 0; j < merged.Count(); j = j + 1) {
                if (merged.At(j).Str(key, "") == k) { hit = merged.At(j); break; }
            }
            if (hit == null) {
                JsonValue row = JsonValue.NewObject();
                row.Put(key, JsonValue.NewStr(k));
                row.Put("count", Num(s.Long("count", 0)));
                row.Put("errors", Num(s.Long("errors", 0)));
                row.Put("failed", Num(s.Long("failed", 0)));
                row.Put("rejected", Num(s.Long("rejected", 0)));
                row.Put("total_us", Num(s.Long("total_us", 0)));
                row.Put("max_us", Num(s.Long("max_us", 0)));
                Reavg(row);
                merged.Append(row);
                continue;
            }
            hit.Set("count", Num(hit.Long("count", 0)
                + s.Long("count", 0)));
            hit.Set("errors", Num(hit.Long("errors", 0)
                + s.Long("errors", 0)));
            hit.Set("failed", Num(hit.Long("failed", 0)
                + s.Long("failed", 0)));
            hit.Set("rejected", Num(hit.Long("rejected", 0)
                + s.Long("rejected", 0)));
            hit.Set("total_us", Num(hit.Long("total_us", 0)
                + s.Long("total_us", 0)));
            if (s.Long("max_us", 0) > hit.Long("max_us", 0)) {
                hit.Set("max_us", Num(s.Long("max_us", 0)));
            }
            Reavg(hit);
        }
    }

    private static void Reavg(JsonValue row) {
        long n = row.Long("count", 0);
        long avg = 0;
        if (n > 0) { avg = row.Long("total_us", 0) / n; }
        row.Set("avg_us", Num(avg));
    }

    /* 按累计耗时降序排列，最多取 20 条，选择排序。 */
    private static JsonValue SortTop(JsonValue arr) {
        int n = arr.Count();
        List<JsonValue> rows = new List<JsonValue>();
        for (int i = 0; i < n; i = i + 1) { rows.Add(arr.At(i)); }
        for (int a = 0; a < rows.Count - 1; a = a + 1) {
            int best = a;
            for (int b = a + 1; b < rows.Count; b = b + 1) {
                if (rows[b].Long("total_us", 0) > rows[best].Long("total_us", 0)) {
                    best = b;
                }
            }
            if (best != a) {
                JsonValue tmp = rows[a];
                rows[a] = rows[best];
                rows[best] = tmp;
            }
        }
        JsonValue outp = JsonValue.NewArray();
        int keep = rows.Count;
        if (keep > 20) { keep = 20; }
        for (int i = 0; i < keep; i = i + 1) { outp.Append(rows[i]); }
        return outp;
    }

    /* 合并秒级时序：请求/错误相加，延迟按请求数加权，p95/max 取最值，CPU/RSS 相加。 */
    public static async string SeriesJson(int seconds) {
        WebApp app = WebHost.Current();
        List<LiveRow> rows = await LiveRows("series",
            FreshSeconds);
        if (rows.Count <= 1) { return app.MetricsSeriesJson(seconds); }
        int want = seconds;
        if (want <= 0) { want = 120; }
        long[] req = new long[want];
        long[] err = new long[want];
        long[] avgW = new long[want];
        long[] p95 = new long[want];
        long[] max = new long[want];
        long[] q = new long[want];
        long[] qavgW = new long[want];
        long[] cpu = new long[want];
        long[] rssArr = new long[want];
        int merged = 0;
        for (int i = 0; i < rows.Count; i = i + 1) {
            JsonDoc s = JsonDoc.Parse(rows[i].json);
            if (s == null) { continue; }
            int pts = s.Get("points");
            if (pts < 0 || s.KindAt(pts) != 4) { continue; }
            merged = merged + 1;
            /* 各 worker 以自身时间零点编号，回移 age 使同一秒来自所有 worker 的数据对齐。 */
            int shift = (int)rows[i].age;
            int count = s.Count(pts);
            int p = s.FirstChild(pts);
            for (int j = 0; j < count && p >= 0; j = j + 1) {
                long t = s.LongAt(s.Get(p, "t"), 1);
                if (t <= 0) {
                    int idx = want - 1 + (int)t - shift;  // t: -(want-1)..0
                    if (idx >= 0 && idx < want) {
                        long r = s.LongAt(s.Get(p, "req"), 0);
                        req[idx] = req[idx] + r;
                        err[idx] = err[idx] + s.LongAt(s.Get(p, "err"), 0);
                        avgW[idx] = avgW[idx] + r * s.LongAt(s.Get(p, "avg_us"), 0);
                        long p95v = s.LongAt(s.Get(p, "p95_us"), 0);
                        if (p95v > p95[idx]) { p95[idx] = p95v; }
                        long maxv = s.LongAt(s.Get(p, "max_us"), 0);
                        if (maxv > max[idx]) { max[idx] = maxv; }
                        long qn = s.LongAt(s.Get(p, "queries"), 0);
                        q[idx] = q[idx] + qn;
                        qavgW[idx] = qavgW[idx] + qn * s.LongAt(s.Get(p, "query_avg_us"), 0);
                        long c = s.LongAt(s.Get(p, "cpu_percent"), 0 - 1);
                        if (c > 0) { cpu[idx] = cpu[idx] + c; }
                        long rb = s.LongAt(s.Get(p, "mem_rss_bytes"), 0 - 1);
                        if (rb > 0) { rssArr[idx] = rssArr[idx] + rb; }
                    }
                }
                p = s.NextSibling(p);
            }
        }
        if (merged <= 1) { return app.MetricsSeriesJson(seconds); }
        StringBuilder sb = new StringBuilder();
        sb.Append("{\"step_ms\":1000,\"count\":");
        sb.Append(Convert.ToString(want));
        sb.Append(",\"workers\":");
        sb.Append(Convert.ToString(merged));
        sb.Append(",\"points\":[");
        for (int idx = 0; idx < want; idx = idx + 1) {
            if (idx > 0) { sb.Append(","); }
            long avg = 0;
            if (req[idx] > 0) { avg = avgW[idx] / req[idx]; }
            long qavg = 0;
            if (q[idx] > 0) { qavg = qavgW[idx] / q[idx]; }
            sb.Append("{\"t\":");
            sb.Append(Convert.ToString((long)idx - (long)want + 1));
            sb.Append(",\"req\":");
            sb.Append(Convert.ToString(req[idx]));
            sb.Append(",\"err\":");
            sb.Append(Convert.ToString(err[idx]));
            sb.Append(",\"avg_us\":");
            sb.Append(Convert.ToString(avg));
            sb.Append(",\"p95_us\":");
            sb.Append(Convert.ToString(p95[idx]));
            sb.Append(",\"max_us\":");
            sb.Append(Convert.ToString(max[idx]));
            sb.Append(",\"queries\":");
            sb.Append(Convert.ToString(q[idx]));
            sb.Append(",\"query_avg_us\":");
            sb.Append(Convert.ToString(qavg));
            sb.Append(",\"cpu_percent\":");
            sb.Append(Convert.ToString(cpu[idx]));
            sb.Append(",\"mem_rss_bytes\":");
            sb.Append(Convert.ToString(rssArr[idx]));
            sb.Append("}");
        }
        sb.Append("]}");
        return sb.ToString();
    }

    public static JsonValue Num(long v) {
        return JsonValue.NewNum(Convert.ToString(v));
    }
}
