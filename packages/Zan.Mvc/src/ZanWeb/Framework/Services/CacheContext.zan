using System;
using System.Data.Redis;
using ZanWeb.Core;

namespace ZanWeb.Services;

/* 带注入 Redis 池的缓存。main.zan 根据 [cache] 配置构建池并注入（或传 null）。命名即语义：GetAsync/SetAsync/SetTtlAsync/DelAsync = 共享缓存（Redis，所有 worker 可见）；LocalGet/LocalSet/LocalSetTtl/LocalDel = 本 worker 私有内存。driver != "redis" 时无共享缓存，async 方法回退到本地内存（仅 worker.count=1 时正确）。Redis 不可达时读 MISS 写丢弃，调用方回退到数据库。 */
class CacheContext {
    StrMap store;
    StrMap expiry;
    RedisPool redis;

    CacheContext(RedisPool redis) {
        this.store = new StrMap();
        this.expiry = new StrMap();
        this.redis = redis;
    }

    static CacheContext Of(RedisPool redis) {
        return new CacheContext(redis);
    }

    /* 已配置共享（跨 worker）缓存时返回 true。 */
    bool Shared() {
        return this.redis != null;
    }

    /* ---- worker 本地内存（不出进程）---- */
    bool Alive(string key) {
        if (!this.store.Has(key)) { return false; }
        string expires = this.expiry.GetOr(key, "0");
        if (expires == "0") { return true; }
        if (WebApp.NowSeconds() >= Filter.ToInt(expires, 0)) {
            this.store.Set(key, "");
            this.expiry.Set(key, "0");
            return false;
        }
        return true;
    }

    bool LocalHas(string key) {
        return this.Alive(key);
    }

    string LocalGet(string key) {
        if (!this.Alive(key)) { return ""; }
        return this.store.Get(key);
    }

    string LocalGetOr(string key, string fallback) {
        if (!this.Alive(key)) { return fallback; }
        return this.store.Get(key);
    }

    void LocalSet(string key, string text) {
        this.store.Set(key, text);
        this.expiry.Set(key, "0");
    }

    void LocalSetTtl(string key, string text, int seconds) {
        this.store.Set(key, text);
        this.expiry.Set(key, Convert.ToString(WebApp.NowSeconds() + seconds));
    }

    void LocalDel(string key) {
        this.store.Set(key, "");
        this.expiry.Set(key, "0");
    }

    /* ---- 共享缓存（Redis，所有 worker 看到同一值）---- */
    /* 读取共享缓存；"" 表示 MISS（Redis 不可达时同样返回，调用方回退到数据源）。 */
    async string GetAsync(string key) {
        if (this.redis == null) { return this.LocalGet(key); }
        RedisClient client = await this.redis.AcquireAsync();
        if (client == null) { return ""; }
        try {
            return await client.GetAsync(key);
        } finally {
            this.redis.Release(client);
        }
    }

    async void SetAsync(string key, string text) {
        if (this.redis == null) { this.LocalSet(key, text); return; }
        RedisClient client = await this.redis.AcquireAsync();
        if (client == null) { return; }
        try {
            bool _ok = await client.SetAsync(key, text);
        } finally {
            this.redis.Release(client);
        }
    }

    async void SetTtlAsync(string key, string text, int seconds) {
        if (this.redis == null) { this.LocalSetTtl(key, text, seconds); return; }
        RedisClient client = await this.redis.AcquireAsync();
        if (client == null) { return; }
        try {
            bool _ok = await client.SetAsync(key, text);
            int _expires = await client.ExpireAsync(key, seconds);
        } finally {
            this.redis.Release(client);
        }
    }

    async void DelAsync(string key) {
        if (this.redis == null) { this.LocalDel(key); return; }
        RedisClient client = await this.redis.AcquireAsync();
        if (client == null) { return; }
        try {
            int _deleted = await client.DelAsync(key);
        } finally {
            this.redis.Release(client);
        }
    }

    /* Admission and storage are one operation: 1 issued, 0 throttled, -1 unavailable */
    async int IssueCodeAsync(string key, string cooldownKey, string ipKey, string code,
                            int seconds, int cooldownSeconds, int windowSeconds, int maxSends) {
        if (seconds <= 0 || cooldownSeconds <= 0 || windowSeconds <= 0 || maxSends <= 0
            || code.Length == 0) { return -1; }
        if (this.redis == null) {
            /* Process-local admission cannot enforce a deployment-wide quota. */
            if (Cfg.Worker.count != 1 || Cfg.Cluster.enabled || Cfg.Cache.driver == "redis") { return -1; }
            lock (this.store) {
                if (this.LocalGet(cooldownKey).Length > 0) { return 0; }
                int count = Filter.ToInt(this.LocalGet(ipKey), 0);
                if (count >= maxSends) { return 0; }
                if (count == 0) {
                    this.LocalSetTtl(ipKey, "1", windowSeconds);
                } else {
                    this.store.Set(ipKey, Convert.ToString(count + 1));
                }
                this.LocalSetTtl(cooldownKey, "1", cooldownSeconds);
                this.LocalSetTtl(key, code, seconds);
                return 1;
            }
        }
        RedisClient client = await this.redis.AcquireAsync();
        if (client == null) { return -1; }
        try {
            List<string> args = new List<string>();
            args.Add("EVAL");
            args.Add("if redis.call('EXISTS', KEYS[2]) == 1 then return 0 end "
                + "local n = tonumber(redis.call('GET', KEYS[3]) or '0') "
                + "if not n or n < 0 then return -1 end "
                + "if n >= tonumber(ARGV[5]) then return 0 end "
                + "if n == 0 then redis.call('SET', KEYS[3], '1', 'EX', ARGV[4]) "
                + "else redis.call('INCR', KEYS[3]) end "
                + "redis.call('SET', KEYS[2], '1', 'EX', ARGV[3]) "
                + "redis.call('SET', KEYS[1], ARGV[1], 'EX', ARGV[2]) return 1");
            args.Add("3"); args.Add(key); args.Add(cooldownKey); args.Add(ipKey);
            args.Add(code); args.Add(Convert.ToString(seconds));
            args.Add(Convert.ToString(cooldownSeconds));
            args.Add(Convert.ToString(windowSeconds)); args.Add(Convert.ToString(maxSends));
            RedisReply reply = await client.CommandAsync(args);
            if (reply == null || reply.kind != RedisReply.INT) { return -1; }
            int result = reply.AsInt();
            if (result == 0 || result == 1) { return result; }
            return -1;
        } catch {
            /* An ambiguous outcome is never permission to send or retry locally. */
            return -1;
        } finally { this.redis.Release(client); }
    }

    /* 单个验证码的最大错试次数与计数存活期。6 位码在 10 分钟窗口内 有百万空间，比对处不设上限等于把爆破交给运气；错满即作废。 计数 key 比码多活 60 秒，且由 SetCodeAsync 在重发时清零—— 换新码重来的合法用户拿到全新预算，爆破者受发送侧限速约束。 */
    static int CodeMaxTries = 5;
    static int CodeTriesTtl = 660;

    /* 验证码写入须一次性带 TTL；Redis 不可达时不发出不可验证的码。
 重发即重置错试预算（发送侧另有限速，见 VerifyCode）。 */
    async bool SetCodeAsync(string key, string code, int seconds) {
        string tryKey = key + ":tries";
        if (this.redis == null) {
            lock (this.store) {
                this.LocalSetTtl(key, code, seconds);
                this.LocalDel(tryKey);
            }
            return true;
        }
        RedisClient client = await this.redis.AcquireAsync();
        if (client == null) { return false; }
        try {
            List<string> args = new List<string>();
            args.Add("SET"); args.Add(key); args.Add(code);
            args.Add("EX"); args.Add(Convert.ToString(seconds));
            RedisReply reply = await client.CommandAsync(args);
            bool ok = reply != null && reply.AsString() == "OK";
            if (ok) {
                List<string> del = new List<string>();
                del.Add("DEL"); del.Add(tryKey);
                RedisReply _d = await client.CommandAsync(del);
            }
            return ok;
        } finally { this.redis.Release(client); }
    }

    /* 比对与删除在 Redis 单个脚本中执行；本地内存同一把锁保护。 错误、过期、重复使用、超过错试上限以及缓存故障一律拒绝。 脚本返回 1=通过，0=错码（计数+1），-1=错满已作废。 */
    async bool ConsumeCodeAsync(string key, string code) {
        string tryKey = key + ":tries";
        if (this.redis == null) {
            lock (this.store) {
                int tries = Filter.ToInt(this.LocalGet(tryKey), 0);
                if (tries >= CodeMaxTries) {
                    this.LocalDel(key);
                    return false;
                }
                string saved = this.LocalGet(key);
                if (saved.Length == 0 || saved != code) {
                    this.LocalSetTtl(tryKey,
                        Convert.ToString(tries + 1), CodeTriesTtl);
                    return false;
                }
                this.LocalDel(key);
                this.LocalDel(tryKey);
                return true;
            }
        }
        RedisClient client = await this.redis.AcquireAsync();
        if (client == null) { return false; }
        try {
            string script = "local t = tonumber(redis.call('GET', KEYS[2]) or '0') "
                + "if t >= tonumber(ARGV[2]) then redis.call('DEL', KEYS[1]) return -1 end "
                + "if redis.call('GET', KEYS[1]) == ARGV[1] then "
                + "redis.call('DEL', KEYS[1]) redis.call('DEL', KEYS[2]) return 1 end "
                + "redis.call('SET', KEYS[2], t + 1, 'EX', ARGV[3]) return 0";
            List<string> args = new List<string>();
            args.Add("EVAL");
            args.Add(script);
            args.Add("2"); args.Add(key); args.Add(tryKey); args.Add(code);
            args.Add(Convert.ToString(CodeMaxTries));
            args.Add(Convert.ToString(CodeTriesTtl));
            RedisReply reply = await client.CommandAsync(args);
            return reply != null && !reply.IsError() && reply.AsInt() == 1;
        } finally { this.redis.Release(client); }
    }

    /* 预热一条连接以免首次请求支付建连成本，返回 Redis 是否应答。 */
    async bool Warmup() {
        if (this.redis == null) { return false; }
        RedisClient client = await this.redis.AcquireAsync();
        if (client == null) { return false; }
        this.redis.Release(client);
        return true;
    }

    void Close() {
        if (this.redis != null) { this.redis.Close(); }
    }
}
