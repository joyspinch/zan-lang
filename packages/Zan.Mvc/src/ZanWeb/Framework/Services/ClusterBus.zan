using System;
using System.Collections.Generic;
using System.Data.Redis;
using System.Json;
using System.Threading;
using Zan.Web.Core;
using Zan.Web.Security;

namespace Zan.Web.Services;

/* 集群事件总线：当配置 [cluster].enabled = true 时，使用 Redis Pub/Sub 广播
   与监听跨物理节点的缓存/权限状态失效事件。当未开启时，纯单机运行，零开销。*/
public class ClusterBus {
    public static bool enabled = false;
    public static string channel = "zanweb:cluster:events";
    public static RedisPool pool = null;
    public static bool listening = false;

    /* 初始化总线状态（在 main.zan 中服务装配时调用）。*/
    public static void Init(ClusterCfg cfg, RedisPool redisPool) {
        enabled = (cfg != null && cfg.enabled && redisPool != null);
        if (enabled) {
            channel = cfg.channel;
            pool = redisPool;
            Log.Info("[cluster] bus initialized on channel " + channel);
        }
    }

    /* 集群总线是否已启用。*/
    public static bool Enabled() {
        return enabled;
    }

    /* 启动后台订阅监听协程（仅在 ClusterBus.enabled 时有意义）。*/
    public static void Start() {
        if (!enabled || listening) { return; }
        listening = true;
        Task.Spawn(ListenLoop());
    }

    /* 停止监听。*/
    public static void Stop() {
        listening = false;
    }

    /* 后台订阅长循环。*/
    public static async void ListenLoop() {
        while (listening) {
            RedisClient subClient = null;
            try {
                subClient = await RedisClient.ConnectAsync(
                    Cfg.Cache.redisHost, Cfg.Cache.redisPort, Cfg.Cache.connectTimeoutMs);
                if (subClient == null) {
                    await Task.Delay(3000);
                    continue;
                }

                List<string> args = new List<string>();
                args.Add("SUBSCRIBE");
                args.Add(channel);
                RedisReply _sub = await subClient.CommandAsync(args);

                while (listening) {
                    RedisReply reply = await subClient.readReply();
                    if (reply == null || reply.IsNil() || reply.IsError()) {
                        break;
                    }
                    if (reply.Count() == 3) {
                        RedisReply tag = reply.At(0);
                        if (tag != null && tag.AsString() == "message") {
                            RedisReply payloadRep = reply.At(2);
                            if (payloadRep != null) {
                                Dispatch(payloadRep.AsString());
                            }
                        }
                    }
                }
            } catch (Exception ex) {
                Log.Warn("[cluster] subscriber exception: " + ex.Message);
            } finally {
                if (subClient != null) {
                    subClient.Close();
                }
            }

            if (listening) {
                await Task.Delay(2000);
            }
        }
    }

    /* 解析并分派集群事件（调用本地清理，绝不再次广播以免产生死循环风暴）。*/
    public static void Dispatch(string msg) {
        if (msg == null || msg.Length == 0) { return; }
        try {
            JsonDoc doc = JsonDoc.Parse(msg);
            if (doc == null) { return; }
            string type = doc.PathStr("type", "");
            if (type == "evict_user") {
                string uid = doc.PathStr("uid", "");
                if (uid.Length > 0) {
                    AuthUser.ForgetLocal(uid);
                }
            } else if (type == "evict_all") {
                AuthUser.ForgetAllLocal();
            }
        } catch (Exception ex) {
            Log.Warn("[cluster] dispatch error: " + ex.Message);
        }
    }

    /* 广播单用户失效事件。*/
    public static async void PublishEvictUser(string uid) {
        if (!enabled || pool == null || uid.Length == 0) { return; }
        RedisClient client = await pool.AcquireAsync();
        if (client == null) { return; }
        try {
            string json = "{\"type\":\"evict_user\",\"uid\":\"" + uid + "\"}";
            List<string> args = new List<string>();
            args.Add("PUBLISH");
            args.Add(channel);
            args.Add(json);
            RedisReply _rep = await client.CommandAsync(args);
        } catch (Exception ex) {
            Log.Warn("[cluster] publish evict_user failed: " + ex.Message);
        } finally {
            pool.Release(client);
        }
    }

    /* 广播全量失效事件。*/
    public static async void PublishEvictAll() {
        if (!enabled || pool == null) { return; }
        RedisClient client = await pool.AcquireAsync();
        if (client == null) { return; }
        try {
            string json = "{\"type\":\"evict_all\"}";
            List<string> args = new List<string>();
            args.Add("PUBLISH");
            args.Add(channel);
            args.Add(json);
            RedisReply _rep = await client.CommandAsync(args);
        } catch (Exception ex) {
            Log.Warn("[cluster] publish evict_all failed: " + ex.Message);
        } finally {
            pool.Release(client);
        }
    }
}
