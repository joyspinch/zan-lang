using System;
using System.Diagnostics;
using System.Text;
using System.Data.Orm;
using System.Web;
using ZanWeb.Model;
using ZanWeb.Dao;
using ZanWeb.Core;
using ZanWeb.Security;
using ZanWeb.Services;

namespace ZanWeb.Web;

/* HTML 管理后台外壳基类：持有页面归属、外壳与渲染，授权由 [Custom(Authorization=Grant)] 由调度器在到达前拦截（导航答登录页、脚本答 401/403）。每个屏幕三步：Layout(heading) → 填充 d → Page(d)，Page() 按请求决定是否加外壳（直接 URL 出整页、标签加载出面板）。写操作答 JSON 而非重定向，因对话框失败保持、成功关闭。 */
abstract class AdminController : AppController {
    /* 本次请求所属账号，由 Admin() 解析一次。 */
    protected SysUser who;

    /* 当前屏幕标题，用于告知标签条该给新载入的标签命名。 */
    protected string headingText;

    /* 本次请求可见的数据范围，由 Scope() 解析一次。 */
    protected DataScope scope;

    /* 浏览器要面板而非整页时返回 true（标签加载或就地刷新）。 */
    protected bool IsFragment() {
        return this.Ctx().Header("X-Fragment").Length > 0;
    }

    /* 已登录账号；调度器已确认为非空，若该行在令牌检查后被禁用则中止。 */
    protected async SysUser Admin() {
        if (this.who != null) { return this.who; }
        if (!this.DbReady()) { this.Fail(503, "2001", "数据库不可用"); }
        SysUser me = await this.SysUser.ById(Filter.ToInt(this.uid, 0));
        if (me == null || me.status != AuthUser.Active) {
            this.Fail(403, "0403", "该账号无法登录管理后台");
        }
        this.who = me;
        return me;
    }

    /* 进入任何管理屏之前先把该账号的角色解析进共享权限表：此刻请求
       尚未持有租约，借还只是顺序复用；此后本页渲染期的 Allow/Mask
       全部是共享内存读，绝不在持有租约时再向池借第二条连接——
       并发数达到上限后，那种嵌套租借会变成「人人持一条、人人等
       第二条」的循环等待（实测过的全站假死形态）。 */
    override async bool OnBeforeAsync() {
        if (this.uid.Length > 0) {
            await AuthUser.RolesOf(this.uid);
        }
        return await base.OnBeforeAsync();
    }

    /* 本次请求可见的数据行（见 DataScope）。列表屏幕取之传给 WhereIf；账号在屏幕运行前已加载，范围来自共享内存，无额外开销。 */
    protected async DataScope Scope() {
        if (this.scope != null) { return this.scope; }
        SysUser me = await this.Admin();
        List<SysDepartment> departments = await this.SysDepartment.All();
        this.scope = await DataScope.Of(me, departments);
        return this.scope;
    }

    /* 所有管理页起点的外壳数据：标题、登录账号、侧边栏。 */
    protected async ViewData Layout(string heading) {
        SysUser me = await this.Admin();

        await Lang.Load();
        string hshown = Lang.T(heading);
        ViewData d = new ViewData();
        string site = await Settings.Get(SettingKeys.SiteTitle, Cfg.Server.name);
        d.Set("title", hshown + " · " + site + " " + Lang.T("管理后台"));
        d.Set("brand", site);
        d.Set("heading", hshown);
        this.headingText = hshown;
        d.Set("account", me.username);
        string shown = Fmt.Text(me.nickname, me.username);
        d.Set("accountName", shown);
        d.Set("accountMail", Fmt.Text(me.email, ""));
        d.Set("accountInitial", Fmt.FirstChar(shown));
        d.Set("tabPath", this.Ctx().path);
        d.Set("tabTitle", hshown);
        if (me.isSuper == 1) { d.Set("isSuper", "1"); }

        /* 顶栏告警铃铛只给能看运行监控的账号渲染：/admin/monitor/alerts
           的权限属于运行监控屏，无权者不渲染也不轮询（省一个 403）。 */
        if (await AuthUser.Allow(this.Held(), this.uid, "Monitor.Index")) {
            d.Set("canMonitor", "1");
        }

        await this.Buttons(d);

        /* 侧边栏即路由表，按调度器所用同一解析器裁减到该账号可打开的项。 */
        List<MenuNode> nodes = await MenuBuilder.ForUser(
            WebHost.Current(), this.uid, this.Ctx().path);
        await this.AddDesigned(nodes);
        /* 个人资料由顶栏账号菜单进入，不占用业务导航的首级位置。 */
        for (int i = nodes.Count - 1; i >= 0; i = i - 1) {
            if (nodes[i].path == "/admin/profile") { nodes.RemoveAt(i); }
        }
        /* 菜单标题与分组名都过翻译层；设计表标题是用户数据，不翻。 */
        for (int i = 0; i < nodes.Count; i = i + 1) {
            nodes[i].title = Lang.T(nodes[i].title);
            nodes[i].group = Lang.T(nodes[i].group);
        }
        MenuBuilder.Sort(nodes);
        MenuBuilder.Fill(d.AddList("menu"), nodes);
        this.I18n(d);
        return d;
    }

    /* 公共词条注入：布局与对话框都从这里拿 {{iXxx}} 行内按钮文案，
       语言包切换后无需改视图。 */
    protected void I18n(ViewData d) {
        d.Set("iEdit", Lang.T("编辑"));
        d.Set("iDelete", Lang.T("删除"));
        d.Set("iRead", Lang.T("阅读"));
        d.Set("iHistory", Lang.T("历史"));
        d.Set("iLogs", Lang.T("日志"));
        d.Set("iView", Lang.T("查看"));
        d.Set("iRunOnce", Lang.T("执行一次"));
        d.Set("iBackList", Lang.T("返回列表"));
        d.Set("iBackHistory", Lang.T("返回历史"));
        d.Set("iSave", Lang.T("保存"));
        d.Set("iCancel", Lang.T("取消"));
        d.Set("iOps", Lang.T("操作"));
        d.Set("iStatus", Lang.T("状态"));
        d.Set("iFront", Lang.T("查看前台"));
        d.Set("iMenuT", Lang.T("菜单"));
        d.Set("iAlarm", Lang.T("运行告警"));
        d.Set("iRefresh", Lang.T("刷新"));
        d.Set("iProfile", Lang.T("个人资料"));
        d.Set("iPassword", Lang.T("修改密码"));
        d.Set("iLogout", Lang.T("退出登录"));
        d.Set("iFind", Lang.T("筛选菜单（支持首拼）"));
        d.Set("iUpload", Lang.T("上传文件"));
    }

    /* 当前屏幕可显示的按钮：canView/可增/可改/可删/可导出，取自与调度器相同的授权掩码。 */
    protected async void Buttons(ViewData d) {
        int mask = await this.Mask();
        if (mask == 0) { return; }
        List<int> order = Perm.Order();
        for (int i = 0; i < order.Count; i = i + 1) {
            int bit = order[i];
            if ((mask & bit) == 0) { continue; }
            d.Set("can" + Perm.BitName(bit), "1");
        }
    }

    /* 当前屏幕对该登录账号的授权掩码。传请求租约：掩码回填即使需要
       查库也跑在这条连接上，不二次借用（见 AuthUser.RolesOf）。 */
    protected async int Mask() {
        return await AuthUser.MaskOf(this.Held(), this.uid,
            Perm.ScreenOf(this.Ctx().routeAction));
    }

    /* 当前屏幕是否允许某按钮——与模板 {{#if canUpdate}} 取同一数字。 */
    protected async bool Can(int bit) {
        return (await this.Mask() & bit) != 0;
    }

    /* 为每张设计表追加一条侧边栏项；这是行而非路由，唯一一张通用数据屏 /admin/monitor/data 承载它们，故路由表无法供给。 */
    protected async void AddDesigned(List<MenuNode> nodes) {
        if (!await AuthUser.Allow(this.Held(), this.uid, Routes.DataIndex)) { return; }
        if (!this.DbReady()) { return; }
        List<SysGenTable> tables = await this.SysGenTable.AllMigrated();
        for (int i = 0; i < tables.Count; i = i + 1) {
            SysGenTable t = tables[i];
            /* 表已生成自己的模块后，菜单归该模块，通用数据屏不再列出。 */
            if (t.generatedAt > 0) { continue; }
            MenuNode n = new MenuNode();
            n.title = t.title;
            n.path = Routes.Data + "?t=" + t.tableName;
            n.group = MenuBuilder.GroupOf(Routes.Data);
            n.groupOrder = MenuBuilder.OrderOf(Routes.Data);
            n.icon = "mdi:table";
            /* 排在该分区块的路由页面之后，按设计顺序。 */
            n.order = Routes.Data + "~" + Convert.ToString(i);
            n.active = this.Ctx().path == Routes.Data && this.In("t") == t.tableName;
            nodes.Add(n);
        }
    }

    /* 渲染屏幕：直接打开 URL 时输出整页，标签加载时只输出面板。 */
    protected void Page(ViewData d) {
        if (this.IsFragment()) {
            this.Ctx().SetHeader("X-Tab-Title", Encoding.UrlEncode(this.headingText));
            this.Fragment(d);
            return;
        }
        this.View(d);
    }

    /* 渲染对话框主体（表单）——始终是片段。 */
    protected void Dialog(ViewData d) {
        this.I18n(d);
        this.Fragment(d);
    }

    /* 渲染声明式表单对话框：FormPage 产出 formHtml，共享壳
       views/Admin/_FormDialog.html 渲染——通用 CRUD 新增/编辑屏
       不再需要各自的 Form 视图文件。 */
    protected void FormDialog(ViewData d) {
        this.I18n(d);
        this.FragmentOf("Admin._FormDialog", d);
    }

    /* 写操作成功应答：toast 消息，无 payload；屏幕随后自刷新面板。
       包内公开：CrudOps 等声明驱动的通用动作经此统一应答。 */
    void Saved(string msg) {
        this.Ctx().Api("0000", msg, "null");
    }

    /* 将写操作记入 sys_operation_log；读不记（流量主体，无审计意义）。记录动作即路由自身动作名，与授权行和文档同名。包内公开：通用写动作（CrudOps）在控制器之外落审计。 */
    async void Note(string title, string target,
                              bool ok, string message) {
        if (!this.DbReady()) { return; }
        /* 审计必须归因到人：CrudOps 与生成器的写动作不经 Admin()，
           此处懒解析一次。解析失败（账号此刻被禁、库抖动）不阻断记账，
           退回 cookie uid 兜底，至少追责到账号 id。 */
        if (this.who == null) {
            try {
                /* 接住结果（协程裸 await 丢返回值的编译器坑，见 TASKS）。 */
                SysUser me = await this.Admin();
                this.who = me;
            } catch (Exception ex) {
                /* 兜底接住，继续落审计；留一条诊断，userId=0 的审计行
                   不再无因。 */
                Log.Warn("[audit] identity lookup failed, audit falls "
                    + "back to uid: " + ex.Message);
            }
        }
        SysOperationLog row = new SysOperationLog();
        row.userId = 0;
        row.username = "";
        if (this.who != null) {
            row.userId = this.who.id;
            row.username = this.who.username;
        } else if (this.uid.Length > 0) {
            row.userId = Filter.ToInt(this.uid, 0);
            row.username = "uid:" + this.uid;
        }
        row.action = this.Ctx().routeAction;
        row.title = title;
        row.method = this.Ctx().method;
        row.path = this.Ctx().path;
        row.target = target;
        row.ip = ClientIp.Of(this.Ctx());
        row.ok = 0;
        if (ok) { row.ok = 1; }
        row.message = message;
        row.createdAt = WebApp.NowSeconds();
        int _id = await this.SysOperationLog.Insert(row).ExecuteIdentityAsync();
    }

    /* 写出分页页脚：total/page/pages/limit 及上下页号（不存在则空，模板据此隐藏链接）。 */
    protected void Pager(ViewData d, ListQuery q, int total) {
        int pages = q.Pages(total);
        d.Set("total", Convert.ToString(total));
        d.Set("page", Convert.ToString(q.Page()));
        d.Set("pages", Convert.ToString(pages));
        d.Set("limit", Convert.ToString(q.Limit()));
        d.Set("kw", q.Kw());
        if (q.Page() > 1) { d.Set("prev", Convert.ToString(q.Page() - 1)); }
        if (q.Page() < pages) { d.Set("next", Convert.ToString(q.Page() + 1)); }
        if (total == 0) { d.Set("empty", "1"); }
    }

    /* 批量端点的 id 列表：POST ids=1,2,3（逗号分隔）。Filter.ToInt 对任何
       非数字串回退 0，天然过滤脏词；只收正 id，上限 500，防止一次提交
       拖垮一条连接。空列表不是错误——调用方自行决定"未选择"的措辞与码。 */
    protected List<int> Ids(string name) {
        List<int> out_ = new List<int>();
        string csv = this.In(name).Trim();
        if (csv.Length == 0) { return out_; }
        List<string> parts = csv.Split(",");
        for (int i = 0; i < parts.Count && out_.Count < 500; i = i + 1) {
            string p = parts[i].Trim();
            if (p.Length == 0 || p.Length > 9) { continue; }
            int v = Filter.ToInt(p, 0);
            if (v > 0) { out_.Add(v); }
        }
        return out_;
    }

    /* ---- 数据库降级的两个统一出口 ----
       动作不再各自手写 DbReady 三行样板：屏面动作一行判定渲染降级屏，
       数据动作一行判定答 503。dbDown 的呈现（徽章键、文案、状态码）
       只住在这里。 */

    /* 屏面动作：连接不可用时置 dbDown 徽章渲染本屏并答 false，调用方
       直接 return——页面壳照常给用户，数据区显示不可用。 */
    protected bool PageReady(ViewData d) {
        if (this.DbReady()) { return true; }
        d.Set("dbDown", "1");
        this.Page(d);
        return false;
    }

    /* 数据动作：连接不可用时答 503 并答 false。 */
    protected bool DataReady() {
        if (this.DbReady()) { return true; }
        this.Fail(503, "2001", "数据库不可用");
        return false;
    }
}
