using System;
using System.Web;

namespace ZanWeb.Web;

/* 实体 → 视图行的统一投影。模板引擎按名绑定、值恒为字符串
 * （ViewData/List<StrMap> 契约，Zan 编译期静态、无运行时按名字段访问），
 * 查出的实体必须投影成行才能进模板——但投影不该在每个查询点重复手写：
 * 字段→键的映射在实体上声明一次（实现 RowView.ToRow），控制器一行
 * Rows.Project 即得行。实体 ToRow 只装"实体自己知道自己"的键：自有
 * 字段、确定性呈现（Fmt.*、状态文案、徽章）；跨表组合（部门名、角色名、
 * 计数）与依赖请求上下文的键（权限位、当前选中）仍由控制器在 Project
 * 之后补 row.Set。没有实体的行（下拉选项、聚合结果、文档矩阵）不是
 * 转换，直接 new StrMap() 字面构造。 */
interface RowView {
    void ToRow(StrMap row);
}

class Rows {
    /* 实体行批量投影：T 实现了 RowView，按实体自述的 ToRow 成行，
     * 保持顺序，into 为 ViewData.AddList 的返回值。 */
    static void Project<T>(List<T> rows, List<StrMap> into) where T : RowView {
        for (int i = 0; i < rows.Count; i = i + 1) {
            StrMap row = new StrMap();
            rows[i].ToRow(row);
            into.Add(row);
        }
    }
}
