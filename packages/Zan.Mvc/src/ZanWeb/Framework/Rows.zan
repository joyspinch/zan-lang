using System;
using System.Web;

namespace ZanWeb.Web;

/* 实体 → 视图行的统一投影。模板引擎按名绑定、值恒为字符串
 * （ViewData/List<StrMap> 契约，Zan 编译期静态、无运行时按名字段访问），
 * 查出的实体必须投影成行才能进模板——本类是该投影的唯一入口，收敛各
 * 控制器手写的 for/索引/Add 样板；字段格式化（Fmt.*）与行内徽章
 * （canXxx）在投影委托内完成。 */
delegate void RowProj<T>(T item, StrMap row);

class Rows {
    /* 把 rows 逐个投影进 into（ViewData.AddList 的返回值），保持顺序。 */
    static void Of<T>(List<T> rows, RowProj<T> proj, List<StrMap> into) {
        for (int i = 0; i < rows.Count; i = i + 1) {
            StrMap row = new StrMap();
            proj(rows[i], row);
            into.Add(row);
        }
    }
}
