using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model;

namespace ZanWeb.Dao;

/* wiki_space 的数据读写网关 */
public class SysWikiSpaceDao : BaseRepository<SysWikiSpace> {
    public SysWikiSpaceDao(IZanSql fsql) : base(fsql) {}
    public SysWikiSpaceDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async SysWikiSpace ById(int id) {
        return await this.GetExecutor().Select<SysWikiSpace>().Where(a => a.id == id).FirstAsync();
    }

    public async List<SysWikiSpace> All() {
        return await this.GetExecutor().Select<SysWikiSpace>().OrderBy(a => a.sortOrder).ToListAsync();
    }

    public async int Insert(SysWikiSpace space) {
        return await this.GetExecutor().Insert<SysWikiSpace>(space).ExecuteIdentityAsync();
    }

    public async int Update(SysWikiSpace space) {
        return await this.GetExecutor().Update<SysWikiSpace>()
            .Set(a => a.name, space.name)
            .Set(a => a.description, space.description)
            .Set(a => a.icon, space.icon)
            .Set(a => a.departmentId, space.departmentId)
            .Set(a => a.sortOrder, space.sortOrder)
            .Set(a => a.status, space.status)
            .Where(a => a.id == space.id)
            .ExecuteAffrowsAsync();
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<SysWikiSpace>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
