using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model;
using ZanWeb.Core;

namespace ZanWeb.Dao;

/* sys_operation_log 的数据读写网关 */
class SysOperationLogDao : BaseRepository<SysOperationLog> {
    SysOperationLogDao(IFreeSql fsql) : base(fsql) {}
    SysOperationLogDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async SysOperationLog ById(int id) {
        return await this.GetExecutor().Select<SysOperationLog>().Where(a => a.id == id).FirstAsync();
    }

    async List<SysOperationLog> Latest(int limit) {
        return await this.GetExecutor().Select<SysOperationLog>()
            .OrderByDescending(a => a.id)
            .Take(limit)
            .ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<SysOperationLog>().CountAsync();
    }

    async int Insert(SysOperationLog log) {
        return await this.GetExecutor().Insert<SysOperationLog>(log).ExecuteIdentityAsync();
    }

    async int CountScoped(string kw, bool byActor, List<int> actors) {
        return await this.GetExecutor().Select<SysOperationLog>()
            .WhereIf(kw.Length > 0, a => a.username.Contains(kw))
            .WhereIf(byActor, a => actors.Contains(a.userId))
            .CountAsync();
    }

    async List<SysOperationLog> PagedScoped(string kw, bool byActor, List<int> actors, int skip, int limit) {
        return await this.GetExecutor().Select<SysOperationLog>()
            .WhereIf(kw.Length > 0, a => a.username.Contains(kw))
            .WhereIf(byActor, a => actors.Contains(a.userId))
            .OrderByDescending(a => a.id)
            .Skip(skip).Take(limit).ToListAsync();
    }

    /* 声明式列表取数（ListPage.Collect 产出 conds）：kw 走操作人/标题
       双列 OR LIKE（WhereConds 按 "t.username|t.title" 逐列校验并绑定），
       时间区间走 GE/LE；数据边界仍由本 DAO 掌握。 */
    async int CountBy(List<OrmCond> conds, bool byActor, List<int> actors) {
        return await this.GetExecutor().Select<SysOperationLog>()
            .WhereConds(conds)
            .WhereIf(byActor, a => actors.Contains(a.userId))
            .CountAsync();
    }

    async List<SysOperationLog> PagedListBy(List<OrmCond> conds, bool byActor, List<int> actors, int skip, int limit) {
        return await this.GetExecutor().Select<SysOperationLog>()
            .WhereConds(conds)
            .WhereIf(byActor, a => actors.Contains(a.userId))
            .OrderByDescending(a => a.id)
            .Skip(skip).Take(limit)
            .ToListAsync();
    }

    async int ClearAll() {
        return await this.GetExecutor().Delete<SysOperationLog>().Where(a => a.id > 0).ExecuteAffrowsAsync();
    }
}
