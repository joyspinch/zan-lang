using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model;
using ZanWeb.Web;

namespace ZanWeb.Dao;

/* sys_department_role 的数据读写网关 */
class SysDepartmentRoleDao {
    IDbConnection db;

    SysDepartmentRoleDao(AppController host) {
        /* 请求作用域：连接取宿主控制器的请求租约——事务与只读从库口径一致。 */
        this.db = host.__Conn();
    }

    /* 非请求场景（种子、后台任务）显式给连接。 */
    SysDepartmentRoleDao(IDbConnection db) {
        this.db = db;
    }

    async SysDepartmentRole ById(int id) {
        return await this.db.Select<SysDepartmentRole>().Where(a => a.id == id).FirstAsync();
    }

    async List<SysDepartmentRole> ByDepartmentId(int deptId) {
        return await this.db.Select<SysDepartmentRole>()
            .Where(a => a.departmentId == deptId)
            .ToListAsync();
    }

    async List<SysDepartmentRole> ByRoleId(int roleId) {
        return await this.db.Select<SysDepartmentRole>()
            .Where(a => a.roleId == roleId)
            .ToListAsync();
    }

    async int Insert(SysDepartmentRole dr) {
        return await this.db.Insert<SysDepartmentRole>(dr).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<SysDepartmentRole>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async int DeleteByDepartmentId(int deptId) {
        return await this.db.Delete<SysDepartmentRole>().Where(a => a.departmentId == deptId).ExecuteAffrowsAsync();
    }
}
