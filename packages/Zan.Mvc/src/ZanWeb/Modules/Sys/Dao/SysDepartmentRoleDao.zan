using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model;

namespace ZanWeb.Dao;

/* sys_department_role 的数据读写网关 */
class SysDepartmentRoleDao : BaseRepository<SysDepartmentRole> {
    SysDepartmentRoleDao(IFreeSql fsql) : base(fsql) {}
    SysDepartmentRoleDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async SysDepartmentRole ById(int id) {
        return await this.GetExecutor().Select<SysDepartmentRole>().Where(a => a.id == id).FirstAsync();
    }

    async List<SysDepartmentRole> ByDepartmentId(int deptId) {
        return await this.GetExecutor().Select<SysDepartmentRole>()
            .Where(a => a.departmentId == deptId)
            .ToListAsync();
    }

    async List<SysDepartmentRole> ByRoleId(int roleId) {
        return await this.GetExecutor().Select<SysDepartmentRole>()
            .Where(a => a.roleId == roleId)
            .ToListAsync();
    }

    async int Insert(SysDepartmentRole dr) {
        return await this.GetExecutor().Insert<SysDepartmentRole>(dr).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<SysDepartmentRole>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async int DeleteByDepartmentId(int deptId) {
        return await this.GetExecutor().Delete<SysDepartmentRole>().Where(a => a.departmentId == deptId).ExecuteAffrowsAsync();
    }
}
