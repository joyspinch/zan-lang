using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model;

namespace ZanWeb.Dao;

/* sys_login_log 的数据读写网关 */
class SysLoginLogDao : BaseRepository<SysLoginLog> {
    SysLoginLogDao(IFreeSql fsql) : base(fsql) {}
    SysLoginLogDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async SysLoginLog ById(int id) {
        return await this.GetExecutor().Select<SysLoginLog>().Where(a => a.id == id).FirstAsync();
    }

    async List<SysLoginLog> Latest(int limit) {
        return await this.GetExecutor().Select<SysLoginLog>()
            .OrderByDescending(a => a.id)
            .Take(limit)
            .ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<SysLoginLog>().CountAsync();
    }

    async int Insert(SysLoginLog log) {
        return await this.GetExecutor().Insert<SysLoginLog>(log).ExecuteIdentityAsync();
    }

    async int CountScoped(string kw, bool byActor, List<string> actors, bool nothing) {
        return await this.GetExecutor().Select<SysLoginLog>()
            .WhereIf(kw.Length > 0, a => a.username.Contains(kw))
            .WhereIf(byActor, a => actors.Contains(a.username))
            .WhereIf(nothing, a => a.id < 0)
            .CountAsync();
    }

    async List<SysLoginLog> PagedScoped(string kw, bool byActor, List<string> actors, bool nothing, int skip, int limit) {
        return await this.GetExecutor().Select<SysLoginLog>()
            .WhereIf(kw.Length > 0, a => a.username.Contains(kw))
            .WhereIf(byActor, a => actors.Contains(a.username))
            .WhereIf(nothing, a => a.id < 0)
            .OrderByDescending(a => a.id)
            .Skip(skip).Take(limit).ToListAsync();
    }

    async int ClearAll() {
        return await this.GetExecutor().Delete<SysLoginLog>().Where(a => a.id > 0).ExecuteAffrowsAsync();
    }
}
