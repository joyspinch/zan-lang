using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model;

namespace ZanWeb.Dao;

/* sys_setting 的数据读写网关 */
class SysSiteSettingDao : BaseRepository<SysSiteSetting> {
    SysSiteSettingDao(IFreeSql fsql) : base(fsql) {}
    SysSiteSettingDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async SysSiteSetting ById(int id) {
        return await this.GetExecutor().Select<SysSiteSetting>().Where(a => a.id == id).FirstAsync();
    }

    async SysSiteSetting ByName(string name) {
        return await this.GetExecutor().Select<SysSiteSetting>().Where(a => a.name == name).FirstAsync();
    }

    async List<SysSiteSetting> All() {
        return await this.GetExecutor().Select<SysSiteSetting>().OrderBy(a => a.sortOrder).ToListAsync();
    }

    async List<SysSiteSetting> ByGroupName(string groupName) {
        return await this.GetExecutor().Select<SysSiteSetting>()
            .Where(a => a.groupName == groupName)
            .OrderBy(a => a.sortOrder)
            .ToListAsync();
    }

    async int SetValue(string name, string value) {
        return await this.GetExecutor().Update<SysSiteSetting>()
            .Set(a => a.value, value)
            .Set(a => a.updatedAt, WebApp.NowSeconds())
            .Where(a => a.name == name)
            .ExecuteAffrowsAsync();
    }

    async int UpdateValueById(int id, string value, long updatedAt) {
        return await this.GetExecutor().Update<SysSiteSetting>()
            .Set(a => a.value, value)
            .Set(a => a.updatedAt, updatedAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    async int Insert(SysSiteSetting s) {
        return await this.GetExecutor().Insert<SysSiteSetting>(s).ExecuteIdentityAsync();
    }
}
