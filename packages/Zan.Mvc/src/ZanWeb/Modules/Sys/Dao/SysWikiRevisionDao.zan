using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model;

namespace ZanWeb.Dao;

/* wiki_revision 的数据读写网关 */
class SysWikiRevisionDao : BaseRepository<SysWikiRevision> {
    SysWikiRevisionDao(IFreeSql fsql) : base(fsql) {}
    SysWikiRevisionDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async List<SysWikiRevision> ByDocId(int docId) {
        return await this.GetExecutor().Select<SysWikiRevision>()
            .Where(a => a.docId == docId)
            .OrderByDescending(a => a.rev)
            .ToListAsync();
    }

    async SysWikiRevision ByDocAndRev(int docId, int rev) {
        return await this.GetExecutor().Select<SysWikiRevision>()
            .Where(a => a.docId == docId && a.rev == rev)
            .FirstAsync();
    }

    async int Insert(SysWikiRevision rev) {
        return await this.GetExecutor().Insert<SysWikiRevision>(rev).ExecuteIdentityAsync();
    }
}
