using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model;

namespace ZanWeb.Dao;

/* sys_user_scope 的数据读写网关（账号 → 资源 id 的多对多）。 */
public class SysUserScopeDao : BaseRepository<SysUserScope> {
    public SysUserScopeDao(IZanSql fsql) : base(fsql) {}
    public SysUserScopeDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async List<SysUserScope> ByUser(int userId) {
        return await this.GetExecutor().Select<SysUserScope>()
            .Where(a => a.userId == userId)
            .ToListAsync();
    }

    public async List<SysUserScope> ByUserAndKey(int userId, string scopeKey) {
        return await this.GetExecutor().Select<SysUserScope>()
            .Where(a => a.userId == userId && a.scopeKey == scopeKey)
            .ToListAsync();
    }

    public async List<SysUserScope> ByKey(string scopeKey) {
        return await this.GetExecutor().Select<SysUserScope>()
            .Where(a => a.scopeKey == scopeKey)
            .ToListAsync();
    }

    public async int Insert(SysUserScope row) {
        return await this.GetExecutor().Insert<SysUserScope>(row).ExecuteIdentityAsync();
    }

    public async int DeleteByUserKey(int userId, string scopeKey) {
        return await this.GetExecutor().Delete<SysUserScope>()
            .Where(a => a.userId == userId && a.scopeKey == scopeKey)
            .ExecuteAffrowsAsync();
    }

    public async int DeleteByUser(int userId) {
        return await this.GetExecutor().Delete<SysUserScope>()
            .Where(a => a.userId == userId)
            .ExecuteAffrowsAsync();
    }

    /* 该资源被哪些账号持有——分配界面回显与审计用。 */
    public async List<SysUserScope> ByResource(string scopeKey, int resourceId) {
        return await this.GetExecutor().Select<SysUserScope>()
            .Where(a => a.scopeKey == scopeKey && a.resourceId == resourceId)
            .ToListAsync();
    }
}
