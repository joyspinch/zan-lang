using System;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model;
using ZanWeb.Web;

namespace ZanWeb.Dao;

/* sys_department 表数据访问网关：每表一个 DAO，专门负责该表持久化与业务查询 */
class SysDepartmentDao {
    IDbConnection db;

    SysDepartmentDao(AppController host) {
        /* 请求作用域：连接取宿主控制器的请求租约——事务与只读从库口径一致。 */
        this.db = host.__Conn();
    }

    /* 非请求场景（种子、后台任务）显式给连接。 */
    SysDepartmentDao(IDbConnection db) {
        this.db = db;
    }

    async SysDepartment ById(int id) {
        return await this.db.Select<SysDepartment>().Where(a => a.id == id).FirstAsync();
    }

    async List<SysDepartment> All() {
        return await this.db.Select<SysDepartment>()
            .OrderBy(a => a.sortOrder)
            .ToListAsync();
    }

    async List<SysDepartment> Scoped(bool byDept, List<int> scopedDepts, bool mine) {
        return await this.db.Select<SysDepartment>()
            .WhereIf(byDept, a => scopedDepts.Contains(a.id))
            .WhereIf(mine, a => a.id < 0)
            .OrderBy(a => a.sortOrder)
            .ToListAsync();
    }

    async List<SysDepartment> ByParent(int parentId) {
        return await this.db.Select<SysDepartment>()
            .Where(a => a.parentId == parentId)
            .OrderBy(a => a.sortOrder)
            .ToListAsync();
    }

    async int Count() {
        return await this.db.Select<SysDepartment>().CountAsync();
    }

    async int Insert(SysDepartment dept) {
        return await this.db.Insert<SysDepartment>(dept).ExecuteIdentityAsync();
    }

    async int UpdateBasic(int id, string name, string code, int parentId, int sortOrder, int status) {
        return await this.db.Update<SysDepartment>()
            .Set(a => a.name, name)
            .Set(a => a.code, code)
            .Set(a => a.parentId, parentId)
            .Set(a => a.sortOrder, sortOrder)
            .Set(a => a.status, status)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    async int Update(SysDepartment dept) {
        return await this.UpdateBasic(dept.id, dept.name, dept.code, dept.parentId, dept.sortOrder, dept.status);
    }

    async int Delete(int id) {
        return await this.db.Delete<SysDepartment>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
