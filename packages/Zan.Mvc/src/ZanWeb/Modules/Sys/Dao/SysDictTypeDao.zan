using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model;

namespace ZanWeb.Dao;

/* sys_dict_type 的数据读写网关 */
class SysDictTypeDao : BaseRepository<SysDictType> {
    SysDictTypeDao(IFreeSql fsql) : base(fsql) {}
    SysDictTypeDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async SysDictType ById(int id) {
        return await this.GetExecutor().Select<SysDictType>().Where(a => a.id == id).FirstAsync();
    }

    async SysDictType ByCode(string code) {
        return await this.GetExecutor().Select<SysDictType>().Where(a => a.code == code).FirstAsync();
    }

    async List<SysDictType> All() {
        return await this.GetExecutor().Select<SysDictType>().OrderBy(a => a.code).ToListAsync();
    }

    async List<SysDictType> AllActive() {
        return await this.GetExecutor().Select<SysDictType>()
            .Where(a => a.status == 1)
            .OrderBy(a => a.code)
            .ToListAsync();
    }

    async int UpdateFields(int id, string code, string name, string description, int status, long updatedAt) {
        return await this.GetExecutor().Update<SysDictType>()
            .Set(a => a.code, code)
            .Set(a => a.name, name)
            .Set(a => a.description, description)
            .Set(a => a.status, status)
            .Set(a => a.updatedAt, updatedAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    async int Insert(SysDictType dt) {
        return await this.GetExecutor().Insert<SysDictType>(dt).ExecuteIdentityAsync();
    }

    async int Update(SysDictType dt) {
        return await this.UpdateFields(dt.id, dt.code, dt.name, dt.description, dt.status, dt.updatedAt);
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<SysDictType>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
