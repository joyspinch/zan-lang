using System;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Blog;

namespace ZanWeb.Dao.Blog;

/* blog_post 的读写入口；控制器用业务名调用，变更只影响本文件。DAO 经编译器
   派发持请求连接派生的 ZanSql 门面，无独立生命周期，同 action 内多 DAO 共享
   连接和事务。所有方法异步，全部使用 *Async 终结符。 */
public class PostDao : BaseRepository<Post> {
    public PostDao(IZanSql fsql) : base(fsql) {}
    public PostDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    /* 最新已发布文章，可按标题过滤（空关键字不添加条件）。 */
    public async List<Post> Recent(int take, string keyword) {
        return await this.GetExecutor().Select<Post>()
            .Where(a => a.published == 1)
            .WhereIf(keyword.Length > 0, a => a.title.Contains(keyword))
            .OrderByDescending(a => a.id)
            .Take(take)
            .ToListAsync();
    }

    /* 按 id 获取文章，无则返回 null。 */
    public async Post ById(int id) {
        return await this.GetExecutor().Select<Post>().Where(a => a.id == id).ToOneAsync();
    }

    /* 插入并返回新主键。 */
    public async int Insert(Post post) {
        return await this.GetExecutor().Insert<Post>(post).ExecuteIdentityAsync();
    }

    /* 最新文章（含草稿），可按标题过滤；管理后台视图。 */
    public async List<Post> AllRecent(int take, string keyword) {
        return await this.GetExecutor().Select<Post>()
            .WhereIf(keyword.Length > 0, a => a.title.Contains(keyword))
            .OrderByDescending(a => a.id)
            .Take(take)
            .ToListAsync();
    }

    /* 文章总数。 */
    public async int CountAll() {
        return await this.GetExecutor().Select<Post>().CountAsync();
    }

    /* 已发布文章数。 */
    public async int CountPublished() {
        return await this.GetExecutor().Select<Post>()
            .Where(a => a.published == 1)
            .CountAsync();
    }

    /* 增加浏览量 */
    public async int IncViews(int id, int views) {
        return await this.GetExecutor().Update<Post>()
            .Set(a => a.views, views + 1)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    /* 发布(1)/隐藏(0)文章而不删除，返回影响行数。 */
    public async int SetPublished(int id, int published) {
        return await this.GetExecutor().Update<Post>()
            .Set(a => a.published, published)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    /* 获取用于 RSS 输出的最新发布文章 */
    public async List<Post> RssLatest(int limit) {
        return await this.GetExecutor().Select<Post>()
            .Where(a => a.published == 1)
            .OrderByDescending(a => a.top).OrderByDescending(a => a.id)
            .Take(limit).ToListAsync();
    }

    /* 删除文章，返回影响行数。 */
    public async int Delete(int id) {
        return await this.GetExecutor().Delete<Post>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    /* 声明式列表取数（ListPage.Collect 产出 conds）：条件交给 ORM 的
       WhereConds——列名按实体元数据校验、值全部走绑定参数，本层不接触
       SQL 文本。 */
    public async int CountBy(List<OrmCond> conds) {
        return await this.GetExecutor().Select<Post>()
            .WhereConds(conds)
            .CountAsync();
    }

    public async List<Post> PagedListBy(List<OrmCond> conds, int skip, int limit) {
        return await this.GetExecutor().Select<Post>()
            .WhereConds(conds)
            .OrderByDescending(a => a.id)
            .Skip(skip).Take(limit)
            .ToListAsync();
    }

    /* 批量发布/转草稿：类型化 IN 条件（ids.Contains）由编译器降级为
       参数化绑定，调用方保证 ids 非空。 */
    public async int SetPublishedByIds(List<int> ids, int published) {
        if (ids.Count == 0) { return 0; }
        return await this.GetExecutor().Update<Post>()
            .Set(a => a.published, published)
            .Where(a => ids.Contains(a.id))
            .ExecuteAffrowsAsync();
    }

    /* 批量删除主表行；评论与缓存的连带清理是业务语义，留在调用方。 */
    public async int DeleteByIds(List<int> ids) {
        if (ids.Count == 0) { return 0; }
        return await this.GetExecutor().Delete<Post>()
            .Where(a => ids.Contains(a.id))
            .ExecuteAffrowsAsync();
    }
}