using System;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Blog;

namespace ZanWeb.Dao.Blog;

/* blog_category 表数据访问网关：每表一个 DAO，专职该表持久化与查询 */
class CategoryDao : BaseRepository<Category> {
    CategoryDao(IFreeSql fsql) : base(fsql) {}
    CategoryDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async Category ById(int id) {
        return await this.GetExecutor().Select<Category>().Where(a => a.id == id).FirstAsync();
    }

    async Category BySlug(string slug) {
        return await this.GetExecutor().Select<Category>().Where(a => a.slug == slug).FirstAsync();
    }

    async List<Category> All() {
        return await this.GetExecutor().Select<Category>()
            .OrderBy(a => a.sortOrder)
            .ToListAsync();
    }

    async List<Category> AllActive() {
        return await this.GetExecutor().Select<Category>()
            .OrderBy(a => a.sortOrder)
            .ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<Category>().CountAsync();
    }

    async int Insert(Category cat) {
        return await this.GetExecutor().Insert<Category>(cat).ExecuteIdentityAsync();
    }

    async int Update(Category cat) {
        return await this.GetExecutor().Update<Category>()
            .Set(a => a.name, cat.name)
            .Set(a => a.slug, cat.slug)
            .Set(a => a.description, cat.description)
            .Set(a => a.sortOrder, cat.sortOrder)
            .Where(a => a.id == cat.id)
            .ExecuteAffrowsAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<Category>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
