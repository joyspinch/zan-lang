using System;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Blog;

namespace ZanWeb.Dao.Blog;

/* blog_comment 表数据访问网关：每表一个 DAO，专职该表持久化与查询 */
class CommentDao {
    IDbConnection db;

    CommentDao(AppController host) {
        /* 请求作用域：连接取宿主控制器的请求租约——事务与只读从库口径一致。 */
        this.db = host.__Conn();
    }

    /* 非请求场景（种子、后台任务）显式给连接。 */
    CommentDao(IDbConnection db) {
        this.db = db;
    }

    async Comment ById(int id) {
        return await this.db.Select<Comment>().Where(a => a.id == id).FirstAsync();
    }

    async List<Comment> ByPost(int postId) {
        return await this.db.Select<Comment>()
            .Where(a => a.postId == postId && a.status == 1)
            .OrderByDescending(a => a.id)
            .ToListAsync();
    }

    async List<Comment> ByPostId(int postId) {
        return await this.db.Select<Comment>()
            .Where(a => a.postId == postId && a.status == 1)
            .OrderByDescending(a => a.id)
            .ToListAsync();
    }

    async int Count() {
        return await this.db.Select<Comment>().CountAsync();
    }

    async int CountPending() {
        return await this.db.Select<Comment>().Where(a => a.status == 0).CountAsync();
    }

    async int Insert(Comment c) {
        return await this.db.Insert<Comment>(c).ExecuteIdentityAsync();
    }

    async int SetStatus(int id, int status) {
        return await this.db.Update<Comment>()
            .Set(a => a.status, status)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<Comment>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
