using System;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Blog;

namespace ZanWeb.Dao.Blog;

/* blog_comment 表数据访问网关：每表一个 DAO，专职该表持久化与查询 */
class CommentDao : BaseRepository<Comment> {
    CommentDao(IFreeSql fsql) : base(fsql) {}
    CommentDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async Comment ById(int id) {
        return await this.GetExecutor().Select<Comment>().Where(a => a.id == id).FirstAsync();
    }

    async List<Comment> ByPost(int postId) {
        return await this.GetExecutor().Select<Comment>()
            .Where(a => a.postId == postId && a.status == 1)
            .OrderByDescending(a => a.id)
            .ToListAsync();
    }

    async List<Comment> ByPostId(int postId) {
        return await this.GetExecutor().Select<Comment>()
            .Where(a => a.postId == postId && a.status == 1)
            .OrderByDescending(a => a.id)
            .ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<Comment>().CountAsync();
    }

    async int CountPending() {
        return await this.GetExecutor().Select<Comment>().Where(a => a.status == 0).CountAsync();
    }

    async int Insert(Comment c) {
        return await this.GetExecutor().Insert<Comment>(c).ExecuteIdentityAsync();
    }

    async int SetStatus(int id, int status) {
        return await this.GetExecutor().Update<Comment>()
            .Set(a => a.status, status)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<Comment>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
