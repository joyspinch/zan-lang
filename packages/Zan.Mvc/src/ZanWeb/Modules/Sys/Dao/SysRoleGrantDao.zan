using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model;

namespace ZanWeb.Dao;

/* sys_role_grant 的数据读写网关 */
class SysRoleGrantDao : BaseRepository<SysRoleGrant> {
    SysRoleGrantDao(IFreeSql fsql) : base(fsql) {}
    SysRoleGrantDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async SysRoleGrant ById(int id) {
        return await this.GetExecutor().Select<SysRoleGrant>().Where(a => a.id == id).FirstAsync();
    }

    async List<SysRoleGrant> ByRoleId(int roleId) {
        return await this.GetExecutor().Select<SysRoleGrant>()
            .Where(a => a.roleId == roleId)
            .ToListAsync();
    }

    async int Insert(SysRoleGrant rg) {
        return await this.GetExecutor().Insert<SysRoleGrant>(rg).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<SysRoleGrant>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async int DeleteByRoleId(int roleId) {
        return await this.GetExecutor().Delete<SysRoleGrant>().Where(a => a.roleId == roleId).ExecuteAffrowsAsync();
    }
}
