using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model;

namespace ZanWeb.Dao;

/* sys_job 的数据读写网关 */
class SysJobDao : BaseRepository<SysJob> {
    SysJobDao(IFreeSql fsql) : base(fsql) {}
    SysJobDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async SysJob ById(int id) {
        return await this.GetExecutor().Select<SysJob>().Where(a => a.id == id).FirstAsync();
    }

    async List<SysJob> All() {
        return await this.GetExecutor().Select<SysJob>().OrderBy(a => a.id).ToListAsync();
    }

    async int Insert(SysJob job) {
        return await this.GetExecutor().Insert<SysJob>(job).ExecuteIdentityAsync();
    }

    async int Update(SysJob job) {
        return await this.GetExecutor().Update<SysJob>()
            .Set(a => a.name, job.name)
            .Set(a => a.kind, job.kind)
            .Set(a => a.param, job.param)
            .Set(a => a.intervalSec, job.intervalSec)
            .Set(a => a.enabled, job.enabled)
            .Where(a => a.id == job.id)
            .ExecuteAffrowsAsync();
    }

    async int SetEnabled(int id, int enabled) {
        return await this.GetExecutor().Update<SysJob>()
            .Set(a => a.enabled, enabled)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<SysJob>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
