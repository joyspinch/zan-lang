using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model;

namespace ZanWeb.Dao;

/* sys_job_log 的数据读写网关 */
class SysJobLogDao : BaseRepository<SysJobLog> {
    SysJobLogDao(IFreeSql fsql) : base(fsql) {}
    SysJobLogDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async List<SysJobLog> ByJobId(int jobId, int limit) {
        return await this.GetExecutor().Select<SysJobLog>()
            .Where(a => a.jobId == jobId)
            .OrderByDescending(a => a.id)
            .Take(limit)
            .ToListAsync();
    }

    async int Insert(SysJobLog log) {
        return await this.GetExecutor().Insert<SysJobLog>(log).ExecuteIdentityAsync();
    }
}
