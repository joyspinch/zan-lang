using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model;
using ZanWeb.Web;

namespace ZanWeb.Dao;

/* sys_job_log 的数据读写网关 */
class SysJobLogDao {
    IDbConnection db;

    SysJobLogDao(AppController host) {
        /* 请求作用域：连接取宿主控制器的请求租约——事务与只读从库口径一致。 */
        this.db = host.__Conn();
    }

    /* 非请求场景（种子、后台任务）显式给连接。 */
    SysJobLogDao(IDbConnection db) {
        this.db = db;
    }

    async List<SysJobLog> ByJobId(int jobId, int limit) {
        return await this.db.Select<SysJobLog>()
            .Where(a => a.jobId == jobId)
            .OrderByDescending(a => a.id)
            .Take(limit)
            .ToListAsync();
    }

    async int Insert(SysJobLog log) {
        return await this.db.Insert<SysJobLog>(log).ExecuteIdentityAsync();
    }
}
