using System;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model;

namespace ZanWeb.Dao;

/* sys_role 表数据访问网关：每表一个 DAO，专门负责该表持久化与业务查询 */
class SysRoleDao : BaseRepository<SysRole> {
    SysRoleDao(IFreeSql fsql) : base(fsql) {}
    SysRoleDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async SysRole ById(int id) {
        return await this.GetExecutor().Select<SysRole>().Where(a => a.id == id).FirstAsync();
    }

    async SysRole ByCode(string code) {
        return await this.GetExecutor().Select<SysRole>().Where(a => a.code == code).FirstAsync();
    }

    async List<SysRole> All() {
        return await this.GetExecutor().Select<SysRole>()
            .OrderBy(a => a.rank)
            .ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<SysRole>().CountAsync();
    }

    async int Insert(SysRole role) {
        return await this.GetExecutor().Insert<SysRole>(role).ExecuteIdentityAsync();
    }

    async int UpdateBasic(int id, string name, string code, int rank, int status, string description, int dataScope, string scopeDepts, long updatedAt) {
        return await this.GetExecutor().Update<SysRole>()
            .Set(a => a.name, name)
            .Set(a => a.code, code)
            .Set(a => a.rank, rank)
            .Set(a => a.status, status)
            .Set(a => a.description, description)
            .Set(a => a.dataScope, dataScope)
            .Set(a => a.scopeDepts, scopeDepts)
            .Set(a => a.updatedAt, updatedAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    async int Update(SysRole role) {
        return await this.UpdateBasic(role.id, role.name, role.code, role.rank, role.status, role.description, role.dataScope, role.scopeDepts, role.updatedAt);
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<SysRole>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
