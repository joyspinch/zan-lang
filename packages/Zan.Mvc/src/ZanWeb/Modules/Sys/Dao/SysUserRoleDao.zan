using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model;

namespace ZanWeb.Dao;

/* sys_user_role 的数据读写网关 */
class SysUserRoleDao : BaseRepository<SysUserRole> {
    SysUserRoleDao(IFreeSql fsql) : base(fsql) {}
    SysUserRoleDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async SysUserRole ById(int id) {
        return await this.GetExecutor().Select<SysUserRole>().Where(a => a.id == id).FirstAsync();
    }

    async List<SysUserRole> All() {
        return await this.GetExecutor().Select<SysUserRole>().ToListAsync();
    }

    async List<SysUserRole> ByUserId(int userId) {
        return await this.GetExecutor().Select<SysUserRole>()
            .Where(a => a.userId == userId)
            .ToListAsync();
    }

    async List<SysUserRole> ByRoleId(int roleId) {
        return await this.GetExecutor().Select<SysUserRole>()
            .Where(a => a.roleId == roleId)
            .ToListAsync();
    }

    async int Insert(SysUserRole ur) {
        return await this.GetExecutor().Insert<SysUserRole>(ur).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<SysUserRole>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async int DeleteByUserId(int userId) {
        return await this.GetExecutor().Delete<SysUserRole>().Where(a => a.userId == userId).ExecuteAffrowsAsync();
    }

    async List<SysUserRole> ByRoleIds(List<int> roleIds) {
        return await this.GetExecutor().Select<SysUserRole>()
            .Where(a => roleIds.Contains(a.roleId))
            .ToListAsync();
    }
}
