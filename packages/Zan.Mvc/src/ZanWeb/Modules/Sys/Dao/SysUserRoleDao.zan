using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model;

namespace Zan.Web.Dao;

/* sys_user_role 的数据读写网关 */
public class SysUserRoleDao : BaseRepository<SysUserRole> {
    public SysUserRoleDao() : base() {}
    public SysUserRoleDao(IZanSql fsql) : base(fsql) {}
    public SysUserRoleDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async SysUserRole ById(int id) {
        return await this.GetExecutor().Select<SysUserRole>().Where(a => a.id == id).FirstAsync();
    }

    public async List<SysUserRole> All() {
        return await this.GetExecutor().Select<SysUserRole>().ToListAsync();
    }

    public async List<SysUserRole> ByUserId(int userId) {
        return await this.GetExecutor().Select<SysUserRole>()
            .Where(a => a.userId == userId)
            .ToListAsync();
    }

    public async List<SysUserRole> ByRoleId(int roleId) {
        return await this.GetExecutor().Select<SysUserRole>()
            .Where(a => a.roleId == roleId)
            .ToListAsync();
    }

    public async int Insert(SysUserRole ur) {
        return await this.GetExecutor().Insert<SysUserRole>(ur).ExecuteIdentityAsync();
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<SysUserRole>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    public async int DeleteByUserId(int userId) {
        return await this.GetExecutor().Delete<SysUserRole>().Where(a => a.userId == userId).ExecuteAffrowsAsync();
    }

    public async List<SysUserRole> ByRoleIds(List<int> roleIds) {
        return await this.GetExecutor().Select<SysUserRole>()
            .Where(a => roleIds.Contains(a.roleId))
            .ToListAsync();
    }
}
