using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model;

namespace ZanWeb.Dao;

/* wiki_doc 的数据读写网关 */
class SysWikiDocDao : BaseRepository<SysWikiDoc> {
    SysWikiDocDao(IFreeSql fsql) : base(fsql) {}
    SysWikiDocDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async SysWikiDoc ById(int id) {
        return await this.GetExecutor().Select<SysWikiDoc>().Where(a => a.id == id).FirstAsync();
    }

    async List<SysWikiDoc> BySpace(int spaceId) {
        return await this.GetExecutor().Select<SysWikiDoc>()
            .Where(a => a.spaceId == spaceId)
            .OrderByDescending(a => a.id)
            .ToListAsync();
    }

    async int Insert(SysWikiDoc doc) {
        return await this.GetExecutor().Insert<SysWikiDoc>(doc).ExecuteIdentityAsync();
    }

    async int Update(SysWikiDoc doc) {
        return await this.GetExecutor().Update<SysWikiDoc>()
            .Set(a => a.spaceId, doc.spaceId)
            .Set(a => a.title, doc.title)
            .Set(a => a.body, doc.body)
            .Set(a => a.summary, doc.summary)
            .Set(a => a.tags, doc.tags)
            .Set(a => a.status, doc.status)
            .Set(a => a.rev, doc.rev)
            .Where(a => a.id == doc.id)
            .ExecuteAffrowsAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<SysWikiDoc>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
