using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model;

namespace ZanWeb.Dao;

/* media 的数据读写网关 */
class SysMediaFileDao : BaseRepository<SysMediaFile> {
    SysMediaFileDao(IFreeSql fsql) : base(fsql) {}
    SysMediaFileDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async SysMediaFile ById(int id) {
        return await this.GetExecutor().Select<SysMediaFile>().Where(a => a.id == id).FirstAsync();
    }

    async List<SysMediaFile> All() {
        return await this.GetExecutor().Select<SysMediaFile>().OrderByDescending(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<SysMediaFile>().CountAsync();
    }

    async int Insert(SysMediaFile file) {
        return await this.GetExecutor().Insert<SysMediaFile>(file).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<SysMediaFile>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
