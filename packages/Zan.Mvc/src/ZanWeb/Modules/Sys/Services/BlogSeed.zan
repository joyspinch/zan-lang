using System;
using System.Data;
using System.Data.Orm;
using ZanWeb.Core;
using ZanWeb.Model.Blog;
using ZanWeb.Dao.Blog;

namespace ZanWeb.Blog;

/* 博客演示业务种子：经 Schema.OnSeed 注册进框架的种子挂点，启动时在系统
   种子之后执行。业务表（Category/Post/Comment）的 DDL 由 CodeFirst 从本
   项目 Model/Blog 同步，种子带计数保护，重复启动不变。 */
class BlogSeed {
    /* 注册进框架；main.zan 在 await Boot.Run() 之前调用一次。 */
    static void Register() {
        Schema.OnSeed(Run);
    }

    static async bool Run(IFreeSql fsql) {
        int cats = await fsql.Select<Category>().CountAsync();
        if (cats == 0) {
            if (!await AddCategory(fsql, "语言设计", "language", 1)) { return false; }
            if (!await AddCategory(fsql, "服务端", "server", 2)) { return false; }
            if (!await AddCategory(fsql, "工程实践", "practice", 3)) { return false; }
        }
        int published = await new PostDao(fsql).CountPublished();
        if (published > 0) { return true; }
        List<Post> seed = new List<Post> {
            PostOf("Zan 是什么：熟悉的语法，原生的产物", 1,
                "zan,llvm,arc", 1,
                "C# 的写法，AOT 的产物：一份源码经 LLVM 直接生成机器码，运行时不需要虚拟机，内存由编译期插入的引用计数管理。",
                "Zan 想解决的问题很具体：写业务的人希望要类、接口、泛型、属性和 async/await 这些顺手的东西，交付的人希望拿到一个可以直接跑的可执行文件，而不是一套需要先装运行时的环境。\n\n语法层面，Zan 基本沿用 C# 的形状，学习成本主要花在少数几处差异上：结构体在栈上，集合写时复制，没有垃圾回收，也没有生命周期标注。\n\n内存管理用的是自动引用计数（ARC）。计数的增减由编译器在编译期插入，对象的析构时机因此是确定的，不会出现“过一会儿才被回收”的抖动，这对长期驻留的服务端进程尤其重要。\n\n编译目标是 LLVM IR，再由 LLVM 生成目标平台的机器码。启动没有预热阶段，第一份请求和第一万份请求走的是同一份代码。"),
            PostOf("用 ZanIDE 开始第一个项目", 3,
                "zanide,上手", 0,
                "编译器、语言服务、调试器和标准库都在 IDE 里，新建项目到断点调试不需要额外配置。",
                "打开 ZanIDE，新建项目，从控制台、图形界面、服务端、库四类模板里选一个，向导会生成一份可以直接运行的工程。\n\n点“运行”在输出面板看结果，按 F5 进入调试：断点、单步、变量查看、调用栈都由随 IDE 分发的调试器提供，不需要自己搭 LLDB。\n\n要交付时用“发布”，选目标平台打包，产物是可执行文件加上它依赖的动态库，拷到目标机器上即可运行。"),
            PostOf("ZanWeb 的路由是编译期生成的", 2,
                "zanweb,路由,attribute", 0,
                "控制器上的 [Route] / [Http*] 由编译器扫描并生成注册代码，启动时没有反射，也没有手写路由表。",
                "在 ZanWeb 里，一个接口就是一个带属性的方法：[Route] 决定路径，[HttpGet] / [HttpPost] 决定方法，[Description] 决定它在接口文档里的说明。\n\n编译器的属性路由阶段会扫描所有控制器与动作，把类级默认值和方法级覆盖合并，展开 [controller] / [action] 占位，然后生成一份注册代码。运行时要做的只是执行这份注册，因此启动过程里没有反射、没有扫描目录。\n\n同一份属性还喂给两处：管理后台的菜单按属性和权限过滤生成，接口文档按路径分组列出方法、说明、参数与返回值。换句话说，加一个动作，菜单和文档会同时跟上，不存在第二份需要同步的清单。"),
            PostOf("服务端指标为什么用 SSE 而不是轮询", 2,
                "sse,监控,性能", 0,
                "一次连接换掉每秒一次的整轮请求：路由、鉴权、日志都不必为“有没有变化”重复付费。",
                "管理后台的运行监控需要秒级刷新。用轮询实现的话，每个打开的标签页每秒都要走一遍完整请求：解析、路由匹配、会话校验、写一行访问日志，而绝大多数回答是“和上次一样”。\n\n改成 Server-Sent Events 之后，浏览器用 EventSource 订阅一次，服务端每两秒推一帧快照，另外定期补一段时序数据用于绘制曲线，空闲时发一行注释做保活，避免中间代理判定连接已死。\n\n这类长连接不参与延迟统计：它的存活时间取决于用户什么时候关掉页面，把它当成一次慢请求记录下来只会污染 P95。"
            )
        };
        for (int i = 0; i < seed.Count; i = i + 1) {
            int _id = await fsql.Insert<Post>(seed[i]).ExecuteIdentityAsync();
            if (_id <= 0) { return false; }
        }
        return true;
    }

    static async bool AddCategory(IFreeSql fsql, string name, string slug,
                            int sortOrder) {
        Category c = new Category();
        c.name = name;
        c.slug = slug;
        c.description = "";
        c.sortOrder = sortOrder;
        c.status = 1;
        c.createdAt = WebApp.NowSeconds();
        int _id = await fsql.Insert<Category>(c).ExecuteIdentityAsync();
        return _id > 0;
    }

    static Post PostOf(string title, int categoryId, string tags, int top,
                       string summary, string body) {
        Post p = new Post();
        p.title = title;
        p.summary = summary;
        p.body = body;
        p.categoryId = categoryId;
        p.tags = tags;
        p.cover = "";
        p.author = "admin";
        p.published = 1;
        p.top = top;
        p.views = 0;
        p.createdAt = WebApp.NowSeconds();
        p.updatedAt = p.createdAt;
        return p;
    }
}
