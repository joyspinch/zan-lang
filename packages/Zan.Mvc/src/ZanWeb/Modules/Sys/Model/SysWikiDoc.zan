using System;
using System.Data.Orm;
using Zan.Web;

namespace Zan.Web.Model;

/* 知识库文档：正文为 Markdown 文本（无长度上限），阅读页渲染为 HTML。
   rev 为当前版本号，每次保存（含 AI 整理与回滚）+1 并写一条
   wiki_revision 快照；summary 供列表与 AI 整理摘要展示。 */
[Table(Name = "sys_wiki_doc")]
public class SysWikiDoc : RowView {
    [Column(IsIdentity = true)]
    public int id;

    public int spaceId;

    [Column(StringLength = 128, IsNullable = false)]
    public string title;

    [Column(IsNullable = false)]
    public string body;

    [Column(StringLength = 255)]
    public string summary;

    [Column(StringLength = 128)]
    public string tags;

    /* 1=发布（全员可读）；0=草稿（仅编辑可见的约定态）。 */
    public int status;

    public int rev;
    public long views;

    [Column(StringLength = 64)]
    public string createdBy;

    [Column(StringLength = 64)]
    public string updatedBy;

    public long createdAt;
    public long updatedAt;

    /* 视图行自述投影：文档行共用的键集。 */
    public void ToRow(StrMap row) {
        row.Set("id", Convert.ToString(this.id));
        row.Set("title", this.title);
        row.Set("summary", this.summary);
        row.Set("rev", Convert.ToString(this.rev));
        row.Set("updatedBy", this.updatedBy);
        row.Set("updatedAt", Fmt.Stamp(this.updatedAt));
        row.Set("statusText", "发布");
        row.Set("statusClass", "ok");
        if (this.status != 1) {
            row.Set("statusText", "草稿");
            row.Set("statusClass", "muted");
        }
    }
}
