using System.Data.Orm;

namespace ZanWeb.Model;

/* 媒体库文件：上传先落 uploads/ 暂存，消毒改名后挪进公开目录 media/。
   path 只存 media/ 下的文件名（服务端 SafeFileName 生成，无目录成分），
   对外 URL = /media/<path>；展示名 name 保留用户的原始文件名。 */
/* 类名 SysMediaFile 而非 Media：控制器命名空间段也是 Media（ZanWeb.Admin.Media），
   同名类型+命名空间段会踩 nsresolve 解析歧义；表名仍与 URL 同构为 media。 */
[Table(Name = "sys_media_file")]
class SysMediaFile {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 255, IsNullable = false)]
    string name;

    [Column(StringLength = 128, IsNullable = false)]
    string path;

    [Column(StringLength = 16, IsNullable = false)]
    string ext;

    long size;

    [Column(StringLength = 64)]
    string uploadedBy;

    long createdAt;
}
