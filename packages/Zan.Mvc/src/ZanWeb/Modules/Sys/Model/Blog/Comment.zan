using System;
using System.Data.Orm;
using Zan.Web;

namespace Zan.Web.Model.Blog;

/* 读者评论；初始状态 0，仅编辑审核后才可见，公开表单无法自行发布。 */
[Table(Name = "blog_comment")]
public class Comment : RowView {
    [Column(IsIdentity = true)]
    public int id;

    public int postId;

    [Column(StringLength = 64)]
    public string author;

    [Column(StringLength = 128)]
    public string email;

    [Column(StringLength = 2000, IsNullable = false)]
    public string content;

    /* 0=待审核，1=已发布，2=已拒绝。 */
    public int status;

    [Column(StringLength = 64)]
    public string ip;

    public long createdAt;

    /* 视图行自述投影：评论行共用的键集；postTitle 与审核权限位由控制器补。 */
    public void ToRow(StrMap row) {
        row.Set("id", Convert.ToString(this.id));
        row.Set("postId", Convert.ToString(this.postId));
        if (this.author.Length > 0) {
            row.Set("author", this.author);
        } else {
            row.Set("author", "访客");
        }
        row.Set("content", this.content);
        row.Set("ip", Fmt.Dash(this.ip));
        row.Set("createdAt", Fmt.Stamp(this.createdAt));
        row.Set("statusText", Fmt.ReviewText(this.status));
        row.Set("statusClass", Fmt.ReviewClass(this.status));
    }
}