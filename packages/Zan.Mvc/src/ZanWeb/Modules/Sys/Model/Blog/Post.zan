using System;
using System.Data.Orm;
using ZanWeb.Web;

namespace ZanWeb.Model.Blog;

/* 博文；body 为正文，summary 为列表摘要，独立列存储，列表页无需加载或截断正文。 */
[Table(Name = "blog_post")]
class Post : RowView {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 200, IsNullable = false)]
    string title;

    /* 列表及链接预览中显示；作者留空时从正文首行自动填充。 */
    [Column(StringLength = 500)]
    string summary;

    [Column(IsNullable = false)]
    string body;

    /* blog_category.id；0=未分类。 */
    int categoryId;

    /* 逗号分隔标签；关联表会增加筛选能力，但此模板不需要，且多出两个管理界面。 */
    [Column(StringLength = 255)]
    string tags;

    [Column(StringLength = 255)]
    string cover;

    [Column(StringLength = 64)]
    string author;

    /* 1=公开可见；0=草稿。 */
    int published;

    /* 1=置顶。 */
    int top;

    int views;

    long createdAt;
    long updatedAt;

    /* 视图行自述投影：列表/卡片共用的键集；跨表键（category）由控制器补。 */
    public void ToRow(StrMap row) {
        row.Set("id", Convert.ToString(this.id));
        row.Set("title", this.title);
        if (this.summary.Length > 0) {
            row.Set("summary", this.summary);
        } else {
            row.Set("summary", Prose.Excerpt(this.body, 120));
        }
        if (this.author.Length > 0) {
            row.Set("author", this.author);
        } else {
            row.Set("author", "编辑部");
        }
        row.Set("tags", Fmt.Dash(this.tags));
        row.Set("views", Convert.ToString(this.views));
        row.Set("createdAt", Fmt.Day(this.createdAt));
        row.Set("minutes", Convert.ToString(Prose.Minutes(this.body)));
        if (this.cover.Length > 0) { row.Set("cover", this.cover); }
        row.Set("stateText", Fmt.PublishedText(this.published));
        row.Set("stateClass", Fmt.PublishedClass(this.published));
        row.Set("nextState", this.published == 1 ? "0" : "1");
        row.Set("toggleText", this.published == 1 ? "下架" : "发布");
        row.Set("topText", this.top == 1 ? "取消置顶" : "置顶");
        row.Set("nextTop", this.top == 1 ? "0" : "1");
        if (this.top == 1) { row.Set("pinned", "1"); row.Set("top", "1"); }
    }
}