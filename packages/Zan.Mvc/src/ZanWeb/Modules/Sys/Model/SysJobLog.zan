using System;
using System.Data.Orm;
using ZanWeb.Services;
using ZanWeb.Web;

namespace ZanWeb.Model;

/* 定时任务的一次执行记录：开始时间、耗时、结果与消息。每任务保留
   最近若干条（JobHost 写入时修剪），更久的历史靠外部日志归档。 */
[Table(Name = "sys_job_log")]
class SysJobLog : RowView {
    [Column(IsIdentity = true)]
    int id;

    int jobId;

    [Column(StringLength = 64)]
    string jobName;

    /* 执行开始的秒级时间。 */
    long startedAt;

    long ms;

    int ok;

    [Column(StringLength = 255)]
    string message;

    /* 视图行自述投影：执行日志行共用的键集。 */
    public void ToRow(StrMap row) {
        row.Set("startedAt", Fmt.Stamp(this.startedAt));
        row.Set("msText", Fmt.Dur(this.ms * 1000));
        row.Set("okText", "成功");
        row.Set("okClass", "ok");
        if (this.ok != 1) {
            row.Set("okText", "失败");
            row.Set("okClass", "err");
        }
        row.Set("message", this.message);
    }
}
