using System;
using System.Data.Orm;
using ZanWeb.Web;

namespace ZanWeb.Model;

/* 后台设计的一张表：数据库名、生成实体的代码名、管理界面的行为。设计即数据，保存后界面即时可用；生成 .zan 源码为可选第二步。 */
[Table(Name = "sys_gen_table")]
class SysGenTable : RowView {
    [Column(IsIdentity = true)]
    int id;

    /* 物理表名（如 "shop_order"）。 */
    [Column(StringLength = 64, IsNullable = false)]
    string tableName;

    /* 生成代码的实体类名（如 "ShopOrder"）。 */
    [Column(StringLength = 64)]
    string entityName;

    /* 用户可见名称（如 "订单"）。 */
    [Column(StringLength = 64)]
    string title;

    /* 生成界面的 URL 段落（如 "content" → /admin/content/<table>），侧边栏也随之归属。 */
    [Column(StringLength = 32)]
    string section;

    /* 列表默认排序列，1=降序。 */
    [Column(StringLength = 64)]
    string orderColumn;

    int orderDesc;

    /* 列表页大小（1~200，生成时钳制），0 视为缺省 20。 */
    int pageSize;

    /* 选项端点/关联下拉的标签列；空=按 name→title→首个文本列自动探测。 */
    [Column(StringLength = 64)]
    string labelColumn;

    /* 侧边栏菜单图标（mdi 图标名，如 "mdi:chart-bar"）；空=不显示图标。 */
    [Column(StringLength = 32)]
    string menuIcon;

    /* 列表页状态页签的列名（须为字典列或布尔列）；空=不启用页签。 */
    [Column(StringLength = 64)]
    string tabColumn;

    /* 1=生成 CSV 导出动作（Export 权限位控制）。 */
    int exportEnabled;

    /* 1=为此表提供 /api/data 下的 REST 端点。 */
    int apiEnabled;

    /* 1=物理表已创建/更新。 */
    int migrated;

    long createdAt;
    long updatedAt;
    long generatedAt;

    /* 视图行自述投影：生成表行共用的键集；columns 计数由控制器补。 */
    public void ToRow(StrMap row) {
        row.Set("id", Convert.ToString(this.id));
        row.Set("tableName", this.tableName);
        row.Set("entityName", this.entityName);
        row.Set("title", this.title);
        row.Set("section", this.section);
        row.Set("stateText", "未建表");
        row.Set("stateClass", "off");
        if (this.migrated == 1) {
            row.Set("stateText", "已建表");
            row.Set("stateClass", "ok");
        }
        if (this.apiEnabled == 1) { row.Set("api", "1"); }
        /* generatedAt 是「已接管」标记（人工确认生成模块编译部署后置位），非生成时间。 */
        if (this.generatedAt > 0) { row.Set("owned", "1"); }
        else { row.Set("unowned", "1"); }
    }
}