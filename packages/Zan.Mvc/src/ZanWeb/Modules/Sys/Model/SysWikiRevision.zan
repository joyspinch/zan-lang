using System;
using System.Data.Orm;
using ZanWeb.Web;

namespace ZanWeb.Model;

/* 知识库文档的版本快照：每次保存把当时的标题与正文整篇存一条，
   note 记修订说明（AI 整理/回滚自 r N/人工说明），支持查看与回滚。 */
[Table(Name = "sys_wiki_revision")]
class SysWikiRevision : RowView {
    [Column(IsIdentity = true)]
    int id;

    int docId;
    int rev;

    [Column(StringLength = 128, IsNullable = false)]
    string title;

    [Column(IsNullable = false)]
    string body;

    [Column(StringLength = 255)]
    string note;

    [Column(StringLength = 64)]
    string editor;

    long createdAt;

    /* 视图行自述投影：版本行共用的键集；current/canRollback 由控制器补。 */
    public void ToRow(StrMap row) {
        row.Set("id", Convert.ToString(this.id));
        row.Set("rev", Convert.ToString(this.rev));
        row.Set("note", this.note);
        row.Set("editor", this.editor);
        row.Set("createdAt", Fmt.Stamp(this.createdAt));
    }
}
