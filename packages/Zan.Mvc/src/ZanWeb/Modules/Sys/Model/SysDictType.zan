using System;
using System.Data.Orm;
using ZanWeb.Web;

namespace ZanWeb.Model;

/* 一组带名字的 code/label 对（订单状态、性别等）。类型持有每项的机器名，项在 sys_dict_item 中。 */
[Table(Name = "sys_dict_type")]
class SysDictType : RowView {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 64, IsNullable = false)]
    string code;

    [Column(StringLength = 64, IsNullable = false)]
    string name;

    /* 1=可用；禁用后其项不显示。 */
    int status;

    [Column(StringLength = 255)]
    string description;

    long createdAt;
    long updatedAt;

    /* 视图行自述投影：字典类型行共用的键集；active 选中态由控制器补。 */
    public void ToRow(StrMap row) {
        row.Set("id", Convert.ToString(this.id));
        row.Set("code", this.code);
        row.Set("name", this.name);
        row.Set("statusText", Fmt.EnabledText(this.status));
        row.Set("statusClass", Fmt.EnabledClass(this.status));
    }
}