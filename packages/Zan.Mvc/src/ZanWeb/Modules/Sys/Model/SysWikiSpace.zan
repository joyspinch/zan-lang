using System;
using System.Data.Orm;
using ZanWeb.Web;

namespace ZanWeb.Model;

/* 知识库空间：一个部门（或通用）一个空间，文档归属空间。departmentId
   指向 sys_department（0=通用/未绑定），仅作组织归属展示与归属筛选。 */
[Table(Name = "sys_wiki_space")]
class SysWikiSpace : RowView {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 64, IsNullable = false)]
    string name;

    [Column(StringLength = 255)]
    string description;

    [Column(StringLength = 32)]
    string icon;

    int departmentId;
    int sortOrder;
    int status;

    [Column(StringLength = 64)]
    string createdBy;

    long createdAt;
    long updatedAt;

    /* 视图行自述投影：空间行共用的键集；count/active 由控制器补。 */
    public void ToRow(StrMap row) {
        row.Set("id", Convert.ToString(this.id));
        row.Set("name", this.name);
        row.Set("desc", this.description);
    }
}
