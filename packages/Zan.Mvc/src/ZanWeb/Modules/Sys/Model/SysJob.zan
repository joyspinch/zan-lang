using System;
using System.Data.Orm;
using ZanWeb.Services;
using ZanWeb.Web;

namespace ZanWeb.Model;

/* 定时任务定义。kind 指向 JobHost 内置的任务实现（执行体不存库），
   intervalSec 为最小调度粒度秒；lastRunAt 兼作跨 worker 的乐观锁
   基准（到点后 UPDATE ... WHERE lastRunAt=旧值 抢单，仅一进程胜出）。
   param 为按 kind 解释的自由参数（log.cleanup=保留天数）。 */
[Table(Name = "sys_job")]
class SysJob : RowView {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 64, IsNullable = false)]
    string name;

    [Column(StringLength = 32, IsNullable = false)]
    string kind;

    [Column(StringLength = 128)]
    string param;

    /* 5 .. 7 天；创建后允许行内调整。 */
    int intervalSec;

    /* 1=参与调度；0=仅可手动执行一次。 */
    int enabled;

    /* 上次启动的秒级时间；0 表示从未运行（新建即视为到期）。 */
    long lastRunAt;

    int lastOk;
    long lastMs;

    [Column(StringLength = 255)]
    string lastMessage;

    long runCount;
    long createdAt;
    long updatedAt;

    /* 视图行自述投影：任务行共用的键集；kinds 下拉等字面行由控制器构造。 */
    public void ToRow(StrMap row) {
        row.Set("id", Convert.ToString(this.id));
        row.Set("name", this.name);
        row.Set("kind", this.kind);
        row.Set("kindText", JobHost.KindName(this.kind));
        row.Set("intervalSec", Convert.ToString(this.intervalSec));
        row.Set("intervalText", JobHost.IntervalText(this.intervalSec));
        row.Set("paramText", this.ParamText());
        row.Set("runCount", Convert.ToString(this.runCount));
        if (this.enabled == 1) { row.Set("enabledChecked", "checked"); }
        if (this.runCount > 0) {
            row.Set("lastText", Fmt.Stamp(this.lastRunAt) + " · "
                + Fmt.Dur(this.lastMs * 1000));
            row.Set("lastClass", "ok");
            if (this.lastOk != 1) { row.Set("lastClass", "err"); }
            row.Set("lastMessage", this.lastMessage);
        } else {
            row.Set("lastText", "从未运行");
            row.Set("lastClass", "muted");
            row.Set("lastMessage", "");
        }
    }

    string ParamText() {
        if (this.kind == "log.cleanup") {
            return "保留 " + JobHost.NormalizeParam(this.kind, this.param) + " 天";
        }
        return "—";
    }
}
