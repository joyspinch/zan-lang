using System;
using System.Data.Orm;
using ZanWeb.Security;
using ZanWeb.Web;

namespace ZanWeb.Model;

/* 账号表。登录凭证、状态、身份均在此；无第二张 auth 表，无 session 表，cookie 为自签名令牌，tokenVersion 使其失效。权限不在此表，由角色(sys_user_role → sys_role_node)决定；isSuper 仅为引导账号保留。所有状态字段为 int，作为数字比较和索引。 */
[Table(Name = "sys_user")]
class SysUser : RowView {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 64, IsNullable = false)]
    string username;

    /* 加盐迭代 SHA-256（见 AuthUser.PasswordHash）。不返回、不记录。 */
    [Column(StringLength = 128, IsNullable = false)]
    string passwordHash;

    [Column(StringLength = 64, IsNullable = false)]
    string passwordSalt;

    [Column(StringLength = 128)]
    string nickname;

    [Column(StringLength = 128)]
    string email;

    [Column(StringLength = 32)]
    string mobile;

    /* 账号所属部门；角色数据权限范围以此解析。 */
    int departmentId;

    /* 1=启用；其他值不可登录，已发令牌也不解析。 */
    int status;

    /* 1=绕过权限检查；仅引导账号使用，普通管理员通过角色授权。 */
    int isSuper;

    /* 递增使已发所有令牌失效（改密、强登、禁用）。 */
    int tokenVersion;

    long createdAt;
    long updatedAt;

    /* 视图行自述投影：账号列表共用的键集；dept/roles 等跨表键由控制器补。 */
    public void ToRow(StrMap row) {
        row.Set("id", Convert.ToString(this.id));
        row.Set("username", this.username);
        row.Set("nickname", Fmt.Dash(this.nickname));
        if (this.isSuper == 1) { row.Set("superTag", "超管|warn"); }
        row.Set("email", Fmt.MaskEmail(this.email));
        row.Set("mobile", Fmt.MaskMobile(this.mobile));
        row.Set("status", Convert.ToString(this.status));
        row.Set("nextStatus", this.status == 1 ? "0" : "1");
        row.Set("toggleLabel", this.status == 1 ? "禁用" : "启用");
        row.Set("statusText", Fmt.EnabledText(this.status));
        row.Set("statusClass", Fmt.EnabledClass(this.status));
    }
}