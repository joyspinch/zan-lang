using System;
using System.Data.Orm;
using ZanWeb.Web;

namespace ZanWeb.Model;

/* 每次登录尝试，成功与否都记录；失败记录使暴力猜测可见。 */
[Table(Name = "sys_login_log")]
class SysLoginLog : RowView {
    [Column(IsIdentity = true)]
    int id;

    int userId;

    [Column(StringLength = 64)]
    string username;

    [Column(StringLength = 64)]
    string ip;

    [Column(StringLength = 255)]
    string agent;

    /* 1=登录成功，0=拒绝。 */
    int ok;

    [Column(StringLength = 128)]
    string message;

    long createdAt;

    /* 视图行自述投影：登录日志行共用的键集。 */
    public void ToRow(StrMap row) {
        row.Set("username", Fmt.Dash(this.username));
        row.Set("ip", Fmt.Dash(this.ip));
        row.Set("createdAt", Fmt.Stamp(this.createdAt));
        row.Set("okText", Fmt.OkText(this.ok));
        row.Set("okClass", Fmt.OkClass(this.ok));
    }
}