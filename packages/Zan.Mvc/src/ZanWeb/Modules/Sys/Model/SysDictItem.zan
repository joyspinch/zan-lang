using System;
using System.Data.Orm;
using ZanWeb.Web;

namespace ZanWeb.Model;

/* 字典类型的一条条目：存储值及 UI 显示标签。 */
[Table(Name = "sys_dict_item")]
class SysDictItem : RowView {
    [Column(IsIdentity = true)]
    int id;

    /* sys_dict_type.code；按机器名引用，导出字典不带代理键。 */
    [Column(StringLength = 64, IsNullable = false)]
    string typeCode;

    [Column(StringLength = 64, IsNullable = false)]
    string value;

    [Column(StringLength = 128, IsNullable = false)]
    string label;

    int sortOrder;
    int status;
    long createdAt;
    long updatedAt;

    /* 视图行自述投影：字典项行共用的键集。 */
    public void ToRow(StrMap row) {
        row.Set("id", Convert.ToString(this.id));
        row.Set("label", this.label);
        row.Set("value", this.value);
        row.Set("sortOrder", Convert.ToString(this.sortOrder));
        if (this.status == 1) { row.Set("statusChecked", "checked"); }
        row.Set("statusText", Fmt.EnabledText(this.status));
        row.Set("statusClass", Fmt.EnabledClass(this.status));
    }
}