using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using ZanWeb.Core;
using ZanWeb.Model;
using ZanWeb.Security;
using ZanWeb.Services;
using ZanWeb.Web;

namespace ZanWeb.Admin.System;

/* /admin/system/jobs 定时任务——配置驱动屏 + 三个特有动作（执行/
   历史/清空：没有同质兄弟，按动词表豁免）。定义存 sys_job、执行体是
   内置 kind，到点由各 worker 乐观锁抢单执行。启停与间隔行内改，类型
   与参数走编辑框（参数语义随类型变）。任何写动作之后 JobHost 都要
   重读镜像，各自落在钩子里：Save→OnSaved、Field→OnFielded、
   Batch→OnBatched、Delete→OnDeleted（连带清运行历史）。 */
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("定时任务")]
class JobsController : CrudScreenController {
    protected override CrudConf Def() {
        string kindOpts = "";
        List<string> kinds = JobHost.Kinds();
        for (int i = 0; i < kinds.Count; i = i + 1) {
            if (i > 0) { kindOpts = kindOpts + ","; }
            kindOpts = kindOpts + kinds[i] + "=" + JobHost.KindName(kinds[i]);
        }
        return CrudConf.Of("sys_job", "定时任务", "admin/system/jobs")
            .Order("id", false)
            .Label("name")

            .Col("id", "ID").Int().W("70px").Ro()
            .Col("name", "名称").W("170px").Req().Max(64)
                .Search("搜索任务名称")
            .Col("kind", "类型").Opts(kindOpts).W("130px")
            .Col("param", "参数").W("150px").Ph("语义随类型变")
            .Col("intervalSec", "间隔秒").Int().W("90px").Def("60")
                .Min(5).Max(604800).Inline()
            .Col("enabled", "状态").Opts("1=启用|ok,0=停用|off").W("90px")
                .Def("1").Inline()
            .Col("runCount", "次数").Int().W("70px").Ro()
            .Col("lastRun", "上次运行").V().W("220px")
            .Col("lastMessage", "结果").W("220px").Ro()
            .Col("updatedAt", "更新时间").Time().W("150px").Ro()

            .TbarAdd("新增任务")
            .TbarReload()
            .TbarEnable()
            .TbarDisable()
            .OpsCustom("执行一次", "run", "确认立即执行该任务吗？", "id={id}", "u")
            .OpsCustom("运行历史", "logs", "", "id={id}", "")
            .OpsEdit()
            .OpsDel("删除后不可恢复，运行历史一并删除，确认删除该任务吗？")
            .Created("createdAt").Updated("updatedAt")
            .Toggle("enabled");
    }

    [HttpGet]
    [Custom(IsMenu = true, Icon = "mdi:clock-outline", Perm = PermBit.View)]
    [Description("定时任务")]
    async void Index() { await this.DoList(); }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("任务表格配置")]
    void Conf() { this.DoConf(); }

    /* adminUI 数据契约：POST {api}/list，方法名带 Data 避开撞名。 */
    [HttpPost]
    [Route("/admin/system/jobs/list")]
    [Custom(Perm = PermBit.View)]
    [Description("任务数据")]
    async void ListData() { await this.DoListData(); }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("任务行数据")]
    async void Edit() { await this.DoEdit(); }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("任务表单配置")]
    void FormConf() { this.DoFormConf(); }

    [HttpGet]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("任务表单")]
    async void Form() { await this.DoForm(); }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存任务")]
    async void Save() { await this.DoSave(); }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除任务")]
    async void Delete() { await this.DoDelete(); }

    [HttpPost]
    [Custom(Perm = PermBit.Update | PermBit.Delete)]
    [Description("任务批量启停或删除")]
    async void Batch() { await this.DoBatch(); }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("任务行内修改")]
    async void Field() { await this.DoField(); }

    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("任务选项")]
    async void Options() { await this.DoOptions(); }

    /* 保存即归一：类型白名单、参数随类型归一、间隔钳位、启停收 0/1；
       新行补运行态种子列（引擎只写声明列，这些列没有表单字段）。 */
    protected override string OnSaving(DbValues row, bool isNew) {
        string kind = this.InAny("kind");
        if (!JobHost.Known(kind)) { return "未知任务类型 " + kind; }
        string name = this.InAny("name");
        if (name.Length > 64) { name = name.Substring(0, 64); }
        long interval = Filter.ToLong(this.InAny("intervalSec"), 60);
        if (interval < 5) { interval = 5; }
        if (interval > 604800) { interval = 604800; }
        long enabled = Filter.ToLong(this.InAny("enabled"), 1);
        if (enabled != 1) { enabled = 0; }
        row.Set("name", name);
        row.Set("kind", kind);
        row.Set("param", JobHost.NormalizeParam(kind, this.InAny("param")));
        row.Set("intervalSec", interval);
        row.Set("enabled", enabled);
        if (isNew) {
            row.Set("lastRunAt", 0);
            row.Set("lastOk", 0);
            row.Set("lastMs", 0);
            row.Set("lastMessage", "");
            row.Set("runCount", 0);
        }
        return "";
    }

    /* 投影：上次运行列 = 时间 · 耗时（从未运行灰显），口径同实体投影。 */
    protected override async List<StrMap> OnRows(List<StrMap> rows) {
        for (int i = 0; i < rows.Count; i = i + 1) {
            long at = Filter.ToLong(rows[i].Get("lastRunAt"), 0);
            long ok = Filter.ToLong(rows[i].Get("lastOk"), 0);
            long ms = Filter.ToLong(rows[i].Get("lastMs"), 0);
            if (at <= 0) { rows[i].Set("lastRun", "从未运行"); continue; }
            rows[i].Set("lastRun", Fmt.Stamp(at) + " · " + Fmt.Dur(ms * 1000)
                + (ok == 1 ? "" : "（失败）"));
        }
        return rows;
    }

    protected override async Task OnSaved(bool isNew) { JobHost.Touch(); }

    protected override async Task OnFielded(string field, long id) {
        JobHost.Touch();
    }

    protected override async Task OnBatched(string field, string value,
                                            List<int> ids) {
        JobHost.Touch();
    }

    /* 删除连带清运行历史，单行和批量删除共用此钩子。 */
    protected override async Task OnDeleted(long id) {
        int _l = await this.SysJobLog.Delete().Where(a => a.jobId == id)
            .ExecuteAffrowsAsync();
        JobHost.Touch();
    }

    /* ---- 特有动作（动词表豁免：没有同质兄弟） ------------------- */

    /* 手动执行一次：停用任务也允许，抢不到说明别的 worker 正在跑。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("执行一次")]
    async void Run() {
        int id = this.InInt("id", 0);
        SysJob j = await this.SysJob.ById(id);
        if (j == null) { this.Fail(404, "0404", "任务不存在"); }
        IDbConnection db = await this.Conn();
        if (db == null) { this.Fail(503, "2001", "数据库不可用"); }
        string message = await JobHost.RunNow(db, j);
        JobHost.Touch();
        await this.Note("执行定时任务", j.name, true, message);
        this.Saved("已执行：" + message);
    }

    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("运行历史")]
    async void Logs() {
        int id = this.InInt("id", 0);
        SysJob j = await this.SysJob.ById(id);
        if (j == null) { this.Fail(404, "0404", "任务不存在"); }
        ViewData d = await this.Layout(j.name + " · 运行历史");
        d.Set("id", Convert.ToString(j.id));
        d.Set("name", j.name);
        d.Set("kindText", JobHost.KindName(j.kind));
        d.Set("intervalText", JobHost.IntervalText(j.intervalSec));
        d.Set("paramText", j.ParamText());

        ListQuery q = this.Paged("id", 20);
        int total = await this.SysJobLog
            .Where(a => a.jobId == j.id).CountAsync();
        List<SysJobLog> rows = await this.SysJobLog
            .Where(a => a.jobId == j.id)
            .OrderByDescending(a => a.id)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();
        List<StrMap> items = d.AddList("logs");
        Rows.Project(rows, items);
        this.Pager(d, q, total);
        this.Page(d);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("清空运行历史")]
    async void Clear() {
        int id = this.InInt("id", 0);
        SysJob j = await this.SysJob.ById(id);
        if (j == null) { this.Fail(404, "0404", "任务不存在"); }
        int n = await this.SysJobLog.Delete()
            .Where(a => a.jobId == id).ExecuteAffrowsAsync();
        await this.Note("清空运行历史", j.name, n >= 0,
            Convert.ToString(n) + " 条");
        this.Saved("运行历史已清空");
    }
}
