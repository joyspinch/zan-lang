using System;
using System.Data.Orm;
using System.Data;
using System.Json;
using System.Web;
using ZanWeb.Core;
using ZanWeb.Dao;
using ZanWeb.Model;
using ZanWeb.Security;
using ZanWeb.Web;
using ZanWeb.Dao.Blog;

namespace ZanWeb.Admin;

/* /admin 仪表盘：系统当前持有的内容与运行状态；实时数字与监控同取一份快照，经 metrics 事件流推送，避免定时重载。 */
/* 区根路径 /admin 显式声明：登录后的落地页，不随控制器名派生（约定本
   会给出 /admin/dashboard，但 Routes.Admin 与侧边栏锚点都是区根本身）。 */
[Route("/admin")]
[Custom(Authorization = CustomAuthorization.Login)]
[Description("仪表盘")]
class DashboardController : AdminController {
    /* 侧边栏条目即此属性——见 AdminController.Layout，向 MenuBuilder 询问该账号可到达的项。 */
    [HttpGet]
    [Custom(IsMenu = true, Icon = "mdi:gauge")]
    [Description("仪表盘")]
    async void Index() {
        ViewData d = await this.Layout("仪表盘");

        JsonValue m = JsonValue.ParseLenient(WebHost.Current().MetricsJson());
        JsonValue req = m.Get("requests");
        if (req == null) { req = JsonValue.NewObject(); }

        d.Set("requests", Convert.ToString(req.Long("count", 0)));
        d.Set("errors", Convert.ToString(req.Long("errors", 0)));
        d.Set("avg", Fmt.Dur(req.Long("avg_us", 0)));
        d.Set("uptime", Fmt.Uptime(m.Long("uptime_ms", 0)));

        d.Set("users", "—");
        d.Set("posts", "—");
        d.Set("published", "—");
        d.Set("drafts", "—");
        d.Set("comments", "—");
        d.Set("pending", "—");
        if (this.DbReady()) {
            DataScope sc = await this.Scope();
            List<int> scoped = sc.Depts();
            int mine = sc.UserId();
            IDbConnection held = this.Held();

            int users = await held.SysUser.CountScoped(sc.ByDept(), scoped, sc.Mine(), mine);
            int posts = await held.Post.CountAll();
            int published = await held.Post.CountPublished();
            int comments = await held.Comment.Count();
            int pending = await held.Comment.CountPending();
            d.Set("users", Convert.ToString(users));
            d.Set("posts", Convert.ToString(posts));
            d.Set("published", Convert.ToString(published));
            d.Set("drafts", Convert.ToString(posts - published));
            d.Set("comments", Convert.ToString(comments));
            d.Set("pending", Convert.ToString(pending));

            List<ZanWeb.Model.Blog.Post> recent = await held.Post.AllRecent(8, "");
            List<StrMap> rows = d.AddList("recent");
            Rows.Project(recent, rows);
            if (recent.Count == 0) { d.Set("noRecent", "1"); }

            /* 登录记录按用户名匹配（非归属）：一条登录行写于对应账号确认之前，故用本 scope 覆盖的用户名匹配——与登录日志屏同一规则。 */
            List<string> names = new List<string>();
            if (!sc.Any()) {
                List<ZanWeb.Model.SysUser> members = await this.SysUser
                    .WhereIf(sc.ByDept(), a => scoped.Contains(a.departmentId))
                    .WhereIf(sc.Mine(), a => a.id == mine).ToListAsync();
                for (int k = 0; k < members.Count; k = k + 1) {
                    names.Add(members[k].username);
                }
            }
            bool byName = !sc.Any() && names.Count > 0;
            bool nothing = !sc.Any() && names.Count == 0;
            List<ZanWeb.Model.SysLoginLog> logins = await this.SysLoginLog
                .WhereIf(byName, a => names.Contains(a.username))
                .WhereIf(nothing, a => a.id < 0)
                .OrderByDescending(a => a.id).Take(8).ToListAsync();
            List<StrMap> lrows = d.AddList("logins");
            Rows.Project(logins, lrows);
            if (logins.Count == 0) { d.Set("noLogins", "1"); }
        } else {
            d.Set("dbDown", "1");
        }
        this.Page(d);
    }




}
