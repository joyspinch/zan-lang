using System;
using System.Web;
using ZanWeb.Core;
using ZanWeb.Security;
using ZanWeb.Services;
using ZanWeb.Web;

namespace ZanWeb.Admin;

/* 管理台会话端点：/admin/login 与 /admin/logout 的声明区。URL 区籍规则
   要求 admin/ 前缀端点只能由 Admin 区控制器声明（曾因写在 Account 区被判定为
   跨区路由）；登录卡片与校验流是 Account 区的共享实现，此处薄壳转发
   ——两区共用同一 cookie、同一限流与登录日志，页面文案不同而已。视图
   键沿用 Account.Login.Index（登录卡是共享视图资产，键=文件路径）。 */
[Route("admin/login/[action]")]
[Custom(Authorization = CustomAuthorization.None)]
[Description("管理台登录")]
class Login : AdminController {
    [HttpGet]
    [Route("/admin/login")]
    [Description("登录")]
    async void Index() {
        if (this.IsLogin()) {
            this.Ctx().Redirect(Routes.Admin);
            return;
        }
        string site = await Settings.Get(SettingKeys.SiteTitle, "ZanWeb");
        this.ViewOf(ZanWeb.Account.Login.Tpl,
            await ZanWeb.Account.Login.Form(site, "", this.In("user"),
                "/admin/login/submit", "管理后台", true, false));
    }

    [HttpPost]
    [Route("/admin/login/submit")]
    [Description("登录提交")]
    async void Submit() {
        await ZanWeb.Account.Login.Attempt(this,
            "/admin/login/submit", "管理后台", true, false, "/admin");
    }

    [HttpGet]
    [Route("/admin/logout")]
    [Description("退出登录")]
    void Logout() {
        /* 让 cookie 过期足以使本浏览器失效；使所有已发令牌整体失效的是 SysUserDao.BumpTokenVersion。 */
        this.Ctx().SetCookie("zsession", "", 0);
        this.Ctx().Redirect(Routes.Login);
    }
}
