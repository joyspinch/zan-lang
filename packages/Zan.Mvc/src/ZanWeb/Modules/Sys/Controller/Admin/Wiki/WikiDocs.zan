using System;
using System.Data;
using System.Data.Orm;
using System.Text;
using System.Web;
using ZanWeb.Ai;
using ZanWeb.Core;
using ZanWeb.Model;
using ZanWeb.Security;
using ZanWeb.Web;

namespace ZanWeb.Admin.Wiki;

/* /admin/wiki 知识库：左侧空间（一个部门/通用一个库），右侧所选空间
   的文档。文档正文为 Markdown，阅读页经 WikiDocs.Html 渲染可视化；
   每次保存（人工/AI 整理/回滚）都写整篇快照到 wiki_revision，
   可查看可回滚；回滚本身也生成新版本，历史不被改写。 */
[Route("admin/wiki/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("知识库")]
class WikiDocs : AdminController {
    [HttpGet]
    [Route("/admin/wiki")]
    [Custom(IsMenu = true, Icon = "mdi:book-multiple", Perm = PermBit.View)]
    [Description("知识库")]
    async void Index() {
        ViewData d = await this.Layout("知识库");
        if (!this.DbReady()) { d.Set("dbDown", "1"); this.Page(d); return; }

        List<SysWikiSpace> spaces = await this.SysWikiSpace
            .OrderBy(a => a.sortOrder).ToListAsync();
        string current = this.In("space");
        if (current.Length == 0 && spaces.Count > 0) {
            current = Convert.ToString(spaces[0].id);
        }
        int spaceId = Filter.ToInt(current, 0);

        List<StrMap> left = d.AddList("spaces");
        for (int i = 0; i < spaces.Count; i = i + 1) {
            SysWikiSpace s = spaces[i];
            StrMap row = new StrMap();
            row.Set("id", Convert.ToString(s.id));
            row.Set("name", s.name);
            row.Set("desc", s.description);
            int docs = await this.SysWikiDoc
                .Where(a => a.spaceId == s.id).CountAsync();
            row.Set("count", Convert.ToString(docs));
            if (Convert.ToString(s.id) == current) {
                row.Set("active", "active");
            }
            left.Add(row);
        }

        List<SysWikiDoc> docs = await this.SysWikiDoc
            .Where(a => a.spaceId == spaceId)
            .OrderByDescending(a => a.updatedAt).ToListAsync();
        List<StrMap> right = d.AddList("docs");
        for (int i = 0; i < docs.Count; i = i + 1) {
            SysWikiDoc g = docs[i];
            StrMap row = new StrMap();
            row.Set("id", Convert.ToString(g.id));
            row.Set("title", g.title);
            row.Set("summary", g.summary);
            row.Set("rev", Convert.ToString(g.rev));
            row.Set("updatedBy", g.updatedBy);
            row.Set("updatedAt", Fmt.Stamp(g.updatedAt));
            row.Set("statusText", "发布");
            row.Set("statusClass", "ok");
            if (g.status != 1) {
                row.Set("statusText", "草稿");
                row.Set("statusClass", "muted");
            }
            right.Add(row);
        }
        d.Set("space", current);
        if (spaces.Count == 0) { d.Set("emptySpaces", "1"); }
        if (docs.Count == 0) { d.Set("emptyDocs", "1"); }
        this.Page(d);
    }

    [HttpGet]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("知识库表单")]
    async void SpaceForm() {
        int id = this.InInt("id", 0);
        ViewData d = new ViewData();
        d.Set("id", Convert.ToString(id));
        d.Set("dialogTitle", "新增知识库");
        d.Set("icon", "mdi:folder-outline");
        d.Set("sortOrder", "1");
        d.Set("status1", "selected");
        List<SysDepartment> depts = await this.SysDepartment
            .OrderBy(a => a.sortOrder).ToListAsync();
        List<StrMap> items = d.AddList("departments");
        for (int i = 0; i < depts.Count; i = i + 1) {
            StrMap row = new StrMap();
            row.Set("id", Convert.ToString(depts[i].id));
            row.Set("name", depts[i].name);
            items.Add(row);
        }
        if (id > 0) {
            SysWikiSpace s = await this.SysWikiSpace.ById(id);
            if (s == null) { this.Fail(404, "0404", "知识库不存在"); }
            d.Set("dialogTitle", "编辑知识库");
            d.Set("name", s.name);
            d.Set("description", s.description);
            d.Set("icon", s.icon);
            d.Set("departmentId", Convert.ToString(s.departmentId));
            d.Set("sortOrder", Convert.ToString(s.sortOrder));
            d.Set("status1", "");
            if (s.status == 1) { d.Set("status1", "selected"); }
            else { d.Set("status0", "selected"); }
        }
        this.Dialog(d);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存知识库")]
    async void SpaceSave() {
        int id = this.InInt("id", 0);
        string name = this.Need("name", "知识库名称");
        if (name.Length > 64) { name = name.Substring(0, 64); }
        string description = this.In("description");
        if (description.Length > 255) {
            description = description.Substring(0, 255);
        }
        string icon = this.In("icon");
        if (icon.Length > 32) { icon = icon.Substring(0, 32); }
        int departmentId = this.InInt("departmentId", 0);
        int sortOrder = this.InInt("sortOrder", 1);
        int status = this.InInt("status", 1);
        if (status != 1) { status = 0; }

        if (id > 0) {
            int n = await this.SysWikiSpace.Update()
                .Set(a => a.name, name)
                .Set(a => a.description, description)
                .Set(a => a.icon, icon)
                .Set(a => a.departmentId, departmentId)
                .Set(a => a.sortOrder, sortOrder)
                .Set(a => a.status, status)
                .Set(a => a.updatedAt, WebApp.NowSeconds())
                .Where(a => a.id == id)
                .ExecuteAffrowsAsync();
            await this.Note("编辑知识库", name, n > 0, "");
            this.Saved("知识库已保存");
            return;
        }
        SysWikiSpace s = new SysWikiSpace();
        s.name = name;
        s.description = description;
        s.icon = icon;
        s.departmentId = departmentId;
        s.sortOrder = sortOrder;
        s.status = status;
        if (this.who != null) { s.createdBy = this.who.username; }
        s.createdAt = WebApp.NowSeconds();
        s.updatedAt = s.createdAt;
        int newId = await this.SysWikiSpace.Insert(s).ExecuteIdentityAsync();
        await this.Note("新增知识库", name, newId > 0, "");
        this.Saved("知识库已创建");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除知识库")]
    async void SpaceDelete() {
        int id = this.InInt("id", 0);
        SysWikiSpace s = await this.SysWikiSpace.ById(id);
        if (s == null) { this.Fail(404, "0404", "知识库不存在"); }
        int docs = await this.SysWikiDoc
            .Where(a => a.spaceId == id).CountAsync();
        if (docs > 0) {
            this.Fail(400, "0004", "知识库下还有 " + Convert.ToString(docs)
                + " 篇文档，先删除或移动它们");
        }
        int n = await this.SysWikiSpace.Delete().Where(a => a.id == id)
            .ExecuteAffrowsAsync();
        await this.Note("删除知识库", s.name, n > 0, "");
        this.Saved("知识库已删除");
    }

    /* 文档编辑页（非弹窗：正文需要足够的书写空间）。 */
    [HttpGet]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("编辑文档")]
    async void Edit() {
        int id = this.InInt("id", 0);
        ViewData d = await this.Layout(id > 0 ? "编辑文档" : "新建文档");
        d.Set("id", Convert.ToString(id));
        d.Set("spaceId", this.In("spaceId"));
        d.Set("status1", "selected");
        bool aiOn = await Ai.Ready();
        d.Set("aiReady", aiOn ? "1" : "");
        if (id > 0) {
            SysWikiDoc g = await this.SysWikiDoc.ById(id);
            if (g == null) { this.Fail(404, "0404", "文档不存在"); }
            d.Set("spaceId", Convert.ToString(g.spaceId));
            d.Set("title", g.title);
            d.Set("body", g.body);
            d.Set("tags", g.tags);
            d.Set("rev", Convert.ToString(g.rev));
            d.Set("status1", "");
            if (g.status == 1) { d.Set("status1", "selected"); }
            else { d.Set("status0", "selected"); }
        }
        this.Page(d);
    }

    /* 保存文档：新建写版本 1；更新 rev+1 并把新状态整篇入快照。
       note 为本次修订说明（人工改动时来自表单）。 */
    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存文档")]
    async void Save() {
        int id = this.InInt("id", 0);
        int spaceId = this.InInt("spaceId", 0);
        string title = this.Need("title", "文档标题");
        if (title.Length > 128) { title = title.Substring(0, 128); }
        /* 正文是 Markdown 源文，必须走 InRaw 保留换行；In/InText 都会经
           Filter.Clean 丢弃 CR/LF。注入防线在渲染端：Wiki.Html 先转义再叠标记。 */
        string body = this.InRaw("body").Trim();
        if (body.Length == 0) { this.Fail(400, "0004", "正文不能为空"); }
        string tags = this.In("tags");
        if (tags.Length > 128) { tags = tags.Substring(0, 128); }
        string note = this.In("note");
        if (note.Length > 255) { note = note.Substring(0, 255); }
        int status = this.InInt("status", 1);
        if (status != 1) { status = 0; }
        SysWikiSpace space = await this.SysWikiSpace.ById(spaceId);
        if (space == null) { this.Fail(404, "0404", "所属知识库不存在"); }
        string editor = this.who != null ? this.who.username : "";

        if (id > 0) {
            SysWikiDoc cur = await this.SysWikiDoc.ById(id);
            if (cur == null) { this.Fail(404, "0404", "文档不存在"); }
            int rev = cur.rev + 1;
            int n = await this.SysWikiDoc.Update()
                .Set(a => a.title, title)
                .Set(a => a.body, body)
                .Set(a => a.summary, Prose.Excerpt(body, 120))
                .Set(a => a.tags, tags)
                .Set(a => a.status, status)
                .Set(a => a.rev, rev)
                .Set(a => a.updatedBy, editor)
                .Set(a => a.updatedAt, WebApp.NowSeconds())
                .Where(a => a.id == id)
                .ExecuteAffrowsAsync();
            await this.Snapshot(id, rev, title, body,
                note.Length > 0 ? note : "编辑", editor);
            await this.Note("编辑知识库文档", title, n > 0, "r"
                + Convert.ToString(rev));
            this.Saved("文档已保存（r" + Convert.ToString(rev) + "）");
            return;
        }
        SysWikiDoc g = new SysWikiDoc();
        g.spaceId = spaceId;
        g.title = title;
        g.body = body;
        g.summary = Prose.Excerpt(body, 120);
        g.tags = tags;
        g.status = status;
        g.rev = 1;
        g.views = 0;
        g.createdBy = editor;
        g.updatedBy = editor;
        g.createdAt = WebApp.NowSeconds();
        g.updatedAt = g.createdAt;
        int newId = await this.SysWikiDoc.Insert(g).ExecuteIdentityAsync();
        await this.Snapshot(newId, 1, title, body,
            note.Length > 0 ? note : "创建", editor);
        await this.Note("新增知识库文档", title, newId > 0, "");
        this.Saved("文档已创建");
    }

    /* 阅读页：Markdown 渲染为 HTML，阅读计数 +1。 */
    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("阅读文档")]
    async void Page() {
        int id = this.InInt("id", 0);
        SysWikiDoc g = await this.SysWikiDoc.ById(id);
        if (g == null) { this.Fail(404, "0404", "文档不存在"); }
        SysWikiSpace s = await this.SysWikiSpace.ById(g.spaceId);
        ViewData d = await this.Layout(g.title);
        d.Set("id", Convert.ToString(g.id));
        d.Set("title", g.title);
        d.Set("rev", Convert.ToString(g.rev));
        d.Set("updatedBy", g.updatedBy);
        d.Set("updatedAt", Fmt.Stamp(g.updatedAt));
        d.Set("spaceName", s != null ? s.name : "");
        d.Set("spaceId", Convert.ToString(g.spaceId));
        d.Set("minutes", Convert.ToString(Prose.Minutes(g.body)));
        d.Set("views", Convert.ToString(g.views + 1));
        d.Set("bodyHtml", WikiDocs.Html(g.body));
        List<StrMap> tagItems = d.AddList("tags");
        List<string> labels = Prose.Tags(g.tags);
        for (int i = 0; i < labels.Count; i = i + 1) {
            StrMap row = new StrMap();
            row.Set("name", labels[i]);
            tagItems.Add(row);
        }
        if (labels.Count > 0) { d.Set("hasTags", "1"); }
        int _u = await this.SysWikiDoc.Update()
            .Set(a => a.views, g.views + 1)
            .Where(a => a.id == id).ExecuteAffrowsAsync();
        this.Page(d);
    }

    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("修订历史")]
    async void History() {
        int id = this.InInt("id", 0);
        SysWikiDoc g = await this.SysWikiDoc.ById(id);
        if (g == null) { this.Fail(404, "0404", "文档不存在"); }
        ViewData d = await this.Layout(g.title + " · 修订历史");
        d.Set("id", Convert.ToString(g.id));
        d.Set("title", g.title);
        d.Set("rev", Convert.ToString(g.rev));
        bool canUp = await this.Can((int)PermBit.Update);
        List<SysWikiRevision> rows = await this.SysWikiRevision
            .Where(a => a.docId == id)
            .OrderByDescending(a => a.rev).ToListAsync();
        List<StrMap> items = d.AddList("revisions");
        for (int i = 0; i < rows.Count; i = i + 1) {
            SysWikiRevision r = rows[i];
            StrMap row = new StrMap();
            row.Set("id", Convert.ToString(g.id));
            row.Set("rev", Convert.ToString(r.rev));
            row.Set("note", r.note);
            row.Set("editor", r.editor);
            row.Set("createdAt", Fmt.Stamp(r.createdAt));
            if (r.rev == g.rev) { row.Set("current", "1"); }
            if (canUp && r.rev != g.rev) { row.Set("canRollback", "1"); }
            items.Add(row);
        }
        this.Page(d);
    }

    /* 查看历史版本（只读渲染，不改变当前版本）。 */
    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("查看版本")]
    async void Revision() {
        int id = this.InInt("id", 0);
        int rev = this.InInt("rev", 0);
        SysWikiDoc g = await this.SysWikiDoc.ById(id);
        if (g == null) { this.Fail(404, "0404", "文档不存在"); }
        SysWikiRevision r = await this.SysWikiRevision
            .Where(a => a.docId == id)
            .Where(a => a.rev == rev).FirstAsync();
        if (r == null) { this.Fail(404, "0404", "版本不存在"); }
        ViewData d = await this.Layout(g.title + " · r"
            + Convert.ToString(rev));
        d.Set("id", Convert.ToString(id));
        d.Set("title", g.title);
        d.Set("rev", Convert.ToString(rev));
        d.Set("editor", r.editor);
        d.Set("createdAt", Fmt.Stamp(r.createdAt));
        d.Set("note", r.note);
        d.Set("bodyHtml", WikiDocs.Html(r.body));
        this.Page(d);
    }

    /* 回滚 = 以历史版本内容新建一个版本，历史不被改写。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("回滚版本")]
    async void Rollback() {
        int id = this.InInt("id", 0);
        int rev = this.InInt("rev", 0);
        SysWikiDoc g = await this.SysWikiDoc.ById(id);
        if (g == null) { this.Fail(404, "0404", "文档不存在"); }
        SysWikiRevision r = await this.SysWikiRevision
            .Where(a => a.docId == id)
            .Where(a => a.rev == rev).FirstAsync();
        if (r == null) { this.Fail(404, "0404", "版本不存在"); }
        string editor = this.who != null ? this.who.username : "";
        int next = g.rev + 1;
        int n = await this.SysWikiDoc.Update()
            .Set(a => a.title, r.title)
            .Set(a => a.body, r.body)
            .Set(a => a.summary, Prose.Excerpt(r.body, 120))
            .Set(a => a.rev, next)
            .Set(a => a.updatedBy, editor)
            .Set(a => a.updatedAt, WebApp.NowSeconds())
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
        await this.Snapshot(id, next, r.title, r.body,
            "回滚自 r" + Convert.ToString(rev), editor);
        await this.Note("回滚知识库文档", g.title, n > 0,
            "r" + Convert.ToString(next) + " <- r"
            + Convert.ToString(rev));
        this.Saved("已回滚到 r" + Convert.ToString(rev)
            + "，当前为 r" + Convert.ToString(next));
    }

    /* AI 整理：把当前正文交给模型做结构化重写，结果作为一个新版本
       落快照（note=AI 整理），人工可继续编辑或回滚。未配置 AI 时拒绝。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("AI 整理")]
    async void AiOrganize() {
        if (!await Ai.Ready()) {
            this.Fail(400, "0005", "尚未配置 AI 服务");
        }
        int id = this.InInt("id", 0);
        SysWikiDoc g = await this.SysWikiDoc.ById(id);
        if (g == null) { this.Fail(404, "0404", "文档不存在"); }
        AiReply r = await Ai.CompleteRaw(WikiDocs.OrganizePrompt,
            g.title + "\n\n" + g.body);
        if (!r.ok) { this.Fail(502, "0502", r.text); }
        string body = r.text.Trim();
        if (body.Length == 0) { this.Fail(502, "0502", "模型返回空内容"); }
        if (body.Length > 200000) { body = body.Substring(0, 200000); }
        string editor = this.who != null ? this.who.username : "ai";
        int next = g.rev + 1;
        int n = await this.SysWikiDoc.Update()
            .Set(a => a.body, body)
            .Set(a => a.summary, Prose.Excerpt(body, 120))
            .Set(a => a.rev, next)
            .Set(a => a.updatedBy, editor)
            .Set(a => a.updatedAt, WebApp.NowSeconds())
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
        await this.Snapshot(id, next, g.title, body, "AI 整理", editor);
        await this.Note("AI 整理知识库文档", g.title, n > 0,
            "r" + Convert.ToString(next));
        this.Saved("AI 整理完成，已保存为 r" + Convert.ToString(next));
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除文档")]
    async void Delete() {
        int id = this.InInt("id", 0);
        SysWikiDoc g = await this.SysWikiDoc.ById(id);
        if (g == null) { this.Fail(404, "0404", "文档不存在"); }
        string title = g.title;
        int n = await this.SysWikiDoc.Delete().Where(a => a.id == id)
            .ExecuteAffrowsAsync();
        int _r = await this.SysWikiRevision.Delete()
            .Where(a => a.docId == id).ExecuteAffrowsAsync();
        await this.Note("删除知识库文档", title, n > 0, "");
        this.Saved("文档及其修订历史已删除");
    }

    /* ---- 内部助手 ---- */

    /* 写一条版本快照（动作内已持请求连接）。 */
    private async void Snapshot(int docId, int rev, string title, string body,
                        string note, string editor) {
        SysWikiRevision row = new SysWikiRevision();
        row.docId = docId;
        row.rev = rev;
        row.title = title;
        row.body = body;
        row.note = note;
        row.editor = editor;
        row.createdAt = WebApp.NowSeconds();
        int _id = await this.SysWikiRevision.Insert(row).ExecuteIdentityAsync();
    }

    /* AI 整理的系统提示词：只输出整理后的 Markdown 正文，不加解说。 */
    static string OrganizePrompt =
        "你是企业知识库编辑。把给出的文档整理成结构清晰的 Markdown："
        + "用标题分层（#/##/###）、要点用列表、保留全部事实信息、"
        + "修正明显的错别字与格式，不添加原文没有的内容，不改写成回答体。"
        + "只输出整理后的正文，不要任何解释或代码围栏。";

    /* Markdown 轻量渲染：标题/列表/引用/代码围栏/段落 + 行内粗体与代码。
       先整行转义再叠加标记，保证输出 HTML 安全。 */
    static string Html(string md) {
        string norm = md.Replace("\r\n", "\n").Replace("\r", "\n");
        List<string> lines = norm.Split("\n");
        StringBuilder outp = new StringBuilder();
        bool inCode = false;
        bool inList = false;
        bool inOrder = false;
        bool inQuote = false;
        for (int i = 0; i < lines.Count; i = i + 1) {
            string line = lines[i];
            string trimmed = line.Trim();
            if (trimmed.StartsWith("```")) {
                WikiDocs.CloseAll(outp, ref inList, ref inOrder, ref inQuote);
                if (inCode) {
                    outp.Append("</code></pre>\n");
                    inCode = false;
                } else {
                    outp.Append("<pre><code>");
                    inCode = true;
                }
                continue;
            }
            if (inCode) {
                outp.Append(WikiDocs.Esc(line) + "\n");
                continue;
            }
            if (trimmed.Length == 0) {
                WikiDocs.CloseAll(outp, ref inList, ref inOrder, ref inQuote);
                continue;
            }
            if (trimmed.StartsWith("### ")) {
                WikiDocs.CloseAll(outp, ref inList, ref inOrder, ref inQuote);
                outp.Append("<h5>" + WikiDocs.Inline(trimmed.Substring(4))
                    + "</h5>\n");
                continue;
            }
            if (trimmed.StartsWith("## ")) {
                WikiDocs.CloseAll(outp, ref inList, ref inOrder, ref inQuote);
                outp.Append("<h4>" + WikiDocs.Inline(trimmed.Substring(3))
                    + "</h4>\n");
                continue;
            }
            if (trimmed.StartsWith("# ")) {
                WikiDocs.CloseAll(outp, ref inList, ref inOrder, ref inQuote);
                outp.Append("<h3>" + WikiDocs.Inline(trimmed.Substring(2))
                    + "</h3>\n");
                continue;
            }
            if (trimmed.StartsWith("- ")) {
                if (inOrder) { outp.Append("</ol>\n"); inOrder = false; }
                WikiDocs.CloseQuote(outp, ref inQuote);
                if (!inList) {
                    outp.Append("<ul>\n");
                    inList = true;
                }
                outp.Append("<li>" + WikiDocs.Inline(trimmed.Substring(2))
                    + "</li>\n");
                continue;
            }
            if (trimmed.StartsWith("> ")) {
                if (inList) { outp.Append("</ul>\n"); inList = false; }
                if (inOrder) { outp.Append("</ol>\n"); inOrder = false; }
                if (!inQuote) {
                    outp.Append("<blockquote>");
                    inQuote = true;
                }
                outp.Append("<p>" + WikiDocs.Inline(trimmed.Substring(2))
                    + "</p>");
                continue;
            }
            int dot = WikiDocs.OrderDot(trimmed);
            if (dot > 0) {
                if (inList) { outp.Append("</ul>\n"); inList = false; }
                WikiDocs.CloseQuote(outp, ref inQuote);
                if (!inOrder) {
                    outp.Append("<ol>\n");
                    inOrder = true;
                }
                outp.Append("<li>"
                    + WikiDocs.Inline(trimmed.Substring(dot)) + "</li>\n");
                continue;
            }
            WikiDocs.CloseAll(outp, ref inList, ref inOrder, ref inQuote);
            outp.Append("<p>" + WikiDocs.Inline(trimmed) + "</p>\n");
        }
        WikiDocs.CloseAll(outp, ref inList, ref inOrder, ref inQuote);
        if (inCode) { outp.Append("</code></pre>\n"); }
        return outp.ToString();
    }

    /* "1. " 有序列表前缀检测，返回正文起始下标（0=非有序项）。 */
    static int OrderDot(string s) {
        int n = 0;
        while (n < s.Length && s[n] >= 48 && s[n] <= 57) { n = n + 1; }
        if (n == 0 || n > 4 || n + 1 >= s.Length) { return 0; }
        if (s.Substring(n, 2) != ". ") { return 0; }
        return n + 2;
    }

    static void CloseAll(StringBuilder outp, ref bool inList,
                         ref bool inOrder, ref bool inQuote) {
        if (inQuote) { outp.Append("</blockquote>\n"); inQuote = false; }
        if (inList) { outp.Append("</ul>\n"); inList = false; }
        if (inOrder) { outp.Append("</ol>\n"); inOrder = false; }
    }

    static void CloseQuote(StringBuilder outp, ref bool inQuote) {
        if (inQuote) { outp.Append("</blockquote>\n"); inQuote = false; }
    }

    /* 行内标记：**粗体** 与 `代码`；输入应先经过 Esc 转义。 */
    static string Inline(string escaped) {
        string withBold = WikiDocs.Marks(escaped, "**", "<strong>",
            "</strong>");
        return WikiDocs.Marks(withBold, "`", "<code>", "</code>");
    }

    /* 成对标记替换：找到一对标记之间的文本包上标签；不成对原样保留。 */
    static string Marks(string s, string mark, string openTag,
                        string closeTag) {
        int from = 0;
        StringBuilder outp = new StringBuilder();
        while (from < s.Length) {
            int at = s.IndexOf(mark, from);
            if (at < 0) { break; }
            int end = s.IndexOf(mark, at + mark.Length);
            if (end < 0) { break; }
            if (end == at + mark.Length) { from = at + mark.Length; continue; }
            outp.Append(s.Substring(from, at - from));
            outp.Append(openTag + s.Substring(at + mark.Length,
                end - at - mark.Length) + closeTag);
            from = end + mark.Length;
        }
        if (from < s.Length) { outp.Append(s.Substring(from)); }
        return outp.ToString();
    }

    /* 与视图引擎一致的转义面（先转义再叠标记，杜绝注入）。 */
    static string Esc(string s) {
        if (s.IndexOf("<") < 0 && s.IndexOf(">") < 0
            && s.IndexOf("&") < 0 && s.IndexOf("\"") < 0) {
            return s;
        }
        return s.Replace("&", "&amp;").Replace("<", "&lt;")
            .Replace(">", "&gt;").Replace("\"", "&quot;");
    }
}
