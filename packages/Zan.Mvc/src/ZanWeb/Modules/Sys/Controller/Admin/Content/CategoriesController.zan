using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using ZanWeb.Core;
using ZanWeb.Model;
using ZanWeb.Security;
using ZanWeb.Web;
using ZanWeb.Model.Blog;

namespace ZanWeb.Admin.Content;

/* /admin/content/categories 博客栏目——配置驱动示范屏。列表/表单/保存/
   删除/批量/行内修改/表格配置/选项八个端点全部由 CrudScreenController 基座按
   下面一份字段表供给；本类只保留两段业务语义（钩子）：slug 唯一在
   字段上声明、删前查文章占用在 OnDeleting。slug 是公开 URL 携带的
   标识：可保存修改（走编辑框想清楚再改），但没标 Inline——行内快捷
   改不放行它，改显示名不破坏链接。 */
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("分类管理")]
class CategoriesController : CrudScreenController {
    protected override CrudConf Def() {
        return CrudConf.Of("blog_category", "分类管理", "admin/content/categories")
            .Order("sortOrder", false)
            .Label("name")

            .Col("id", "ID").Int().W("70px").Ro()
            .Col("name", "名称").W("180px").Req().Max(64)
                .Search("搜索名称").Inline()
            .Col("slug", "标识").W("150px").Req().Max(64).Ph("公开 URL 标识")
                .Pattern("^[a-z0-9][a-z0-9-]*$")
                .Unique("该分类标识已被使用")
            .Col("description", "说明").Area().Max(255)
            .Col("sortOrder", "排序").Int().W("70px").Def("1").Inline()
            .Col("status", "状态").Opts("1=显示|ok,0=隐藏|off").W("90px")
                .Def("1").Inline()
            .Col("createdAt", "创建时间").Time().W("150px").Ro()
            .Col("posts", "文章").Int().W("70px").V()

            .TbarAdd("新增分类")
            .TbarReload()
            .OpsEdit()
            .OpsDel("删除后不可恢复，确认删除该分类吗？")
            .Created("createdAt");
    }

    [HttpGet]
    [Custom(IsMenu = true, Icon = "mdi:tag", Perm = PermBit.View)]
    [Description("分类管理")]
    async void Index() { await this.DoList(); }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("分类表格配置")]
    void Conf() { this.DoConf(); }

    /* adminUI 数据契约：POST {api}/list 以 JSON {page,pageSize,...筛选}
       取分页行，信封 data={data:[行],total}。方法名带 Data 以避开与
       列表屏路由的撞名，显式 Route 归位到 /list。 */
    [HttpPost]
    [Route("/admin/content/categories/list")]
    [Custom(Perm = PermBit.View)]
    [Description("分类数据")]
    async void ListData() { await this.DoListData(); }

    /* adminUI 行数据契约：POST {api}/edit 提交 {id}，回整行 JSON。 */
    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("分类行数据")]
    async void Edit() { await this.DoEdit(); }

    /* adminUI GeneralForm 契约：PUT {api}/formconf 回表单 schema。 */
    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("分类表单配置")]
    void FormConf() { this.DoFormConf(); }

    [HttpGet]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("分类表单")]
    async void Form() { await this.DoForm(); }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存分类")]
    async void Save() { await this.DoSave(); }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除分类")]
    async void Delete() { await this.DoDelete(); }

    [HttpPost]
    [Custom(Perm = PermBit.Update | PermBit.Delete)]
    [Description("分类批量启停或删除")]
    async void Batch() { await this.DoBatch(); }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("分类行内修改")]
    async void Field() { await this.DoField(); }

    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("分类选项")]
    async void Options() { await this.DoOptions(); }

    /* 删前占用：栏目下还有文章时拒绝删除（与文章屏同一文案口径）。 */
    protected override async string OnDeleting(long id) {
        long used = await this.Post.Where(a => a.categoryId == id).CountAsync();
        if (used > 0) {
            return "该分类下还有 " + Convert.ToString(used) + " 篇文章";
        }
        return "";
    }

    /* 投影：文章数列（每页至多 20 行的逐行计数，博客栏目规模下可忽
       略；数据量大时应换分组查询）。 */
    protected override async List<StrMap> OnRows(List<StrMap> rows) {
        for (int i = 0; i < rows.Count; i = i + 1) {
            long cid = Filter.ToLong(rows[i].Get("id"), 0);
            long used = await this.Post.Where(a => a.categoryId == cid).CountAsync();
            rows[i].Set("posts", Convert.ToString(used));
        }
        return rows;
    }
}
