using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using ZanWeb.Core;
using ZanWeb.Crud;
using ZanWeb.Security;
using ZanWeb.Web;
using ZanWeb.Model.Blog;

namespace ZanWeb.Admin.Content;

/* /admin/content/categories 博客栏目——配置驱动示范屏。列表/表单/保存/
   删除/批量/行内修改/表格配置/选项八个端点全部由 CrudScreen 基座按
   下面一份 Def() 声明供给，本类只保留三段业务语义（钩子与声明）：
   slug 唯一（Unique 声明）、删前查文章占用（OnDeleting）、行内文章数
   投影（OnRows）。slug 是公开 URL 携带的标识：保存走完整白名单，行内
   快捷修改收窄为 Inline 子集、不含 slug——改标识必须走编辑框想清楚
   再改，改显示名不破坏链接。 */
[Route("admin/content/categories/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("分类管理")]
class Categories : CrudScreen {
    override CrudConf Def() {
        return CrudConf.Of("blog_category", "分类管理", "admin/content/categories")
            .Col("id", "ID", "num", "70px")
            .Col("name", "名称", "text", "180px")
            .Col("slug", "标识", "muted", "150px")
            .Col("description", "说明", "muted", "")
            .Col("posts", "文章", "num", "70px")
            .Col("sortOrder", "排序", "num", "70px")
            .Tag("status", "状态", "1=显示|ok,0=隐藏|off", "90px")
            .Col("createdAt", "创建时间", "time", "150px")
            .Text("名称", "kw", "name", "搜索名称")
            .Select("状态", "status", "status", "1=显示,0=隐藏")
            .Time("创建日期", "createdAt", "createdAt")
            .TbarAdd("新增分类")
            .TbarReload()
            .OpsEdit()
            .OpsDel("删除后不可恢复，确认删除该分类吗？")
            .EditFields("name:text,slug:text,description:text,sortOrder:int,status:int")
            .Inline("name:text,description:text,sortOrder:int,status:int")
            .Unique("slug", "该分类标识已被使用")
            .FormText("名称", "name").Req().Max(64)
            .FormText("标识", "slug").Req().Max(64).Ph("公开 URL 标识")
            .FormArea("说明", "description").Max(255)
            .FormText("排序", "sortOrder").Val("1")
            .FormSelect("状态", "status", "1=显示,0=隐藏").Val("1")
            .Order("sortOrder", false)
            .Label("name")
            .Toggle("status")
            .Created("createdAt");
    }

    [HttpGet]
    [Route("/admin/content/categories")]
    [Custom(IsMenu = true, Icon = "mdi:tag", Perm = PermBit.View)]
    [Description("分类管理")]
    async void Index() { await this.DoList(); }

    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("分类表格配置")]
    void Conf() { this.DoConf(); }

    [HttpGet]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("分类表单")]
    async void Form() { await this.DoForm(); }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存分类")]
    async void Save() { await this.DoSave(); }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除分类")]
    async void Delete() { await this.DoDelete(); }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("分类批量启停或删除")]
    async void Batch() { await this.DoBatch(); }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("分类行内修改")]
    async void Field() { await this.DoField(); }

    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("分类选项")]
    async void Options() { await this.DoOptions(); }

    /* 删前占用：栏目下还有文章时拒绝删除（与文章屏同一文案口径）。 */
    override async string OnDeleting(long id) {
        long used = await this.Post.Where(a => a.categoryId == id).CountAsync();
        if (used > 0) {
            return "该分类下还有 " + Convert.ToString(used) + " 篇文章";
        }
        return "";
    }

    /* 投影：文章数列（每页至多 20 行的逐行计数，博客栏目规模下可忽
       略；数据量大时应换分组查询）。 */
    override async List<StrMap> OnRows(List<StrMap> rows) {
        for (int i = 0; i < rows.Count; i = i + 1) {
            long cid = Filter.ToLong(rows[i].Get("id"), 0);
            long used = await this.Post.Where(a => a.categoryId == cid).CountAsync();
            rows[i].Set("posts", Convert.ToString(used));
        }
        return rows;
    }
}
