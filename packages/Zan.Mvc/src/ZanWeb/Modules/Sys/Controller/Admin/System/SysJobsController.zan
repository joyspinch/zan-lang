using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using ZanWeb.Core;
using ZanWeb.Model;
using ZanWeb.Security;
using ZanWeb.Services;
using ZanWeb.Web;

namespace ZanWeb.Admin.System;

/* /admin/system/jobs 定时任务：进程内 JobHost 的管理面。定义存
   sys_job、执行体是内置 kind；到点由各 worker 乐观锁抢单执行。
   行内可改启停与间隔，类型与参数走编辑框（参数语义随类型变）。 */
[Route("admin/system/jobs/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("定时任务")]
class SysJobsController : AdminController {
    [HttpGet]
    [Route("/admin/system/jobs")]
    [Custom(IsMenu = true, Icon = "mdi:clock-outline", Perm = PermBit.View)]
    [Description("定时任务")]
    async void Index() {
        ViewData d = await this.Layout("定时任务");
        if (!this.PageReady(d)) { return; }

        List<SysJob> rows = await this.SysJob.OrderBy(a => a.id).ToListAsync();
        List<StrMap> items = d.AddList("jobs");
        for (int i = 0; i < rows.Count; i = i + 1) {
            SysJob j = rows[i];
            StrMap row = new StrMap();
            row.Set("id", Convert.ToString(j.id));
            row.Set("name", j.name);
            row.Set("kind", j.kind);
            row.Set("kindText", JobHost.KindName(j.kind));
            row.Set("intervalText", JobHost.IntervalText(j.intervalSec));
            row.Set("intervalSec", Convert.ToString(j.intervalSec));
            row.Set("paramText", SysJobsController.ParamText(j));
            row.Set("runCount", Convert.ToString(j.runCount));
            if (j.enabled == 1) { row.Set("enabledChecked", "checked"); }
            if (j.runCount > 0) {
                row.Set("lastText", Fmt.Stamp(j.lastRunAt) + " · "
                    + Fmt.Dur(j.lastMs * 1000));
                row.Set("lastClass", "ok");
                if (j.lastOk != 1) { row.Set("lastClass", "err"); }
                row.Set("lastMessage", j.lastMessage);
            } else {
                row.Set("lastText", "从未运行");
                row.Set("lastClass", "muted");
                row.Set("lastMessage", "");
            }
            items.Add(row);
        }
        if (rows.Count == 0) { d.Set("emptyJobs", "1"); }
        this.Page(d);
    }

    [HttpGet]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("任务表单")]
    async void Form() {
        int id = this.InInt("id", 0);
        ViewData d = new ViewData();
        d.Set("id", Convert.ToString(id));
        d.Set("dialogTitle", "新增任务");
        d.Set("kindSelect", "1");
        d.Set("intervalSec", "60");
        d.Set("enabled1", "selected");
        List<string> kinds = JobHost.Kinds();
        List<StrMap> kindItems = d.AddList("kinds");
        for (int i = 0; i < kinds.Count; i = i + 1) {
            StrMap row = new StrMap();
            row.Set("value", kinds[i]);
            row.Set("text", JobHost.KindName(kinds[i]));
            if (i == 0) { row.Set("selected", "selected"); }
            kindItems.Add(row);
        }
        if (id > 0) {
            SysJob j = await this.SysJob.ById(id);
            if (j == null) { this.Fail(404, "0404", "任务不存在"); }
            d.Set("dialogTitle", "编辑任务");
            d.Set("name", j.name);
            d.Set("kind", j.kind);
            d.Set("kindText", JobHost.KindName(j.kind));
            d.Set("param", JobHost.NormalizeParam(j.kind, j.param));
            d.Set("intervalSec", Convert.ToString(j.intervalSec));
            d.Set("kindSelect", "");
            d.Set("enabled1", "");
            if (j.enabled == 1) { d.Set("enabled1", "selected"); }
            else { d.Set("enabled0", "selected"); }
        }
        this.Dialog(d);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存任务")]
    async void Save() {
        int id = this.InInt("id", 0);
        string name = this.Need("name", "任务名称");
        if (name.Length > 64) { name = name.Substring(0, 64); }
        string kind = this.Need("kind", "任务类型");
        if (!JobHost.Known(kind)) {
            this.Fail(400, "0004", "未知任务类型 " + kind);
        }
        string param = JobHost.NormalizeParam(kind, this.In("param"));
        int intervalSec = this.InInt("intervalSec", 60);
        if (intervalSec < 5) { intervalSec = 5; }
        if (intervalSec > 604800) { intervalSec = 604800; }
        int enabled = this.InInt("enabled", 1);
        if (enabled != 1) { enabled = 0; }

        if (id > 0) {
            SysJob cur = await this.SysJob.ById(id);
            if (cur == null) { this.Fail(404, "0404", "任务不存在"); }
            int n = await this.SysJob.Update()
                .Set(a => a.name, name)
                .Set(a => a.param, param)
                .Set(a => a.intervalSec, intervalSec)
                .Set(a => a.enabled, enabled)
                .Set(a => a.updatedAt, WebApp.NowSeconds())
                .Where(a => a.id == id)
                .ExecuteAffrowsAsync();
            JobHost.Touch();
            await this.Note("编辑定时任务", name, n > 0, "");
            this.Saved("任务已保存");
            return;
        }
        SysJob j = new SysJob();
        j.name = name;
        j.kind = kind;
        j.param = param;
        j.intervalSec = intervalSec;
        j.enabled = enabled;
        j.lastRunAt = 0;
        j.lastOk = 0;
        j.lastMs = 0;
        j.lastMessage = "";
        j.runCount = 0;
        j.createdAt = WebApp.NowSeconds();
        j.updatedAt = j.createdAt;
        int newId = await this.SysJob.Insert(j).ExecuteIdentityAsync();
        JobHost.Touch();
        await this.Note("新增定时任务", name, newId > 0, "");
        this.Saved("任务已创建");
    }

    /* 行内快速改：启停/间隔就地提交。名称与类型是任务的身份，参数
       语义随类型变，都走编辑框；改完让 JobHost 重读镜像。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("任务行内修改")]
    async void Quick() {
        int id = this.InInt("id", 0);
        string field = this.Need("field", "属性");
        SysJob j = await this.SysJob.ById(id);
        if (j == null) { this.Fail(404, "0404", "任务不存在"); }

        if (field == "enabled") {
            int on = this.InInt("value", 0);
            if (on != 0 && on != 1) { this.Fail(400, "0004", "状态不合法"); }
            int n = await this.SysJob.Update().Set(a => a.enabled, on)
                .Set(a => a.updatedAt, WebApp.NowSeconds())
                .Where(a => a.id == id).ExecuteAffrowsAsync();
            JobHost.Touch();
            await this.Note("编辑定时任务", j.name, n > 0, "行内启停");
            this.Ok("{}");
        } else if (field == "intervalSec") {
            int sec = this.InInt("value", j.intervalSec);
            if (sec < 5) { sec = 5; }
            if (sec > 604800) { sec = 604800; }
            int n = await this.SysJob.Update().Set(a => a.intervalSec, sec)
                .Set(a => a.updatedAt, WebApp.NowSeconds())
                .Where(a => a.id == id).ExecuteAffrowsAsync();
            JobHost.Touch();
            await this.Note("编辑定时任务", j.name, n > 0, "行内间隔");
            this.Ok("{}");
        } else {
            this.Fail(400, "0004", "该属性不支持行内修改");
        }
    }

    /* 手动执行一次：停用任务也允许，抢不到说明别的 worker 正在跑。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("执行一次")]
    async void Run() {
        int id = this.InInt("id", 0);
        SysJob j = await this.SysJob.ById(id);
        if (j == null) { this.Fail(404, "0404", "任务不存在"); }
        IDbConnection db = await this.Conn();
        if (db == null) { this.Fail(503, "2001", "数据库不可用"); }
        string message = await JobHost.RunNow(db, j);
        JobHost.Touch();
        await this.Note("执行定时任务", j.name, true, message);
        this.Saved("已执行：" + message);
    }

    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("运行历史")]
    async void Logs() {
        int id = this.InInt("id", 0);
        SysJob j = await this.SysJob.ById(id);
        if (j == null) { this.Fail(404, "0404", "任务不存在"); }
        ViewData d = await this.Layout(j.name + " · 运行历史");
        d.Set("id", Convert.ToString(j.id));
        d.Set("name", j.name);
        d.Set("kindText", JobHost.KindName(j.kind));
        d.Set("intervalText", JobHost.IntervalText(j.intervalSec));
        d.Set("paramText", SysJobsController.ParamText(j));

        ListQuery q = this.Paged("id", 20);
        int total = await this.SysJobLog
            .Where(a => a.jobId == j.id).CountAsync();
        List<SysJobLog> rows = await this.SysJobLog
            .Where(a => a.jobId == j.id)
            .OrderByDescending(a => a.id)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();
        List<StrMap> items = d.AddList("logs");
        for (int i = 0; i < rows.Count; i = i + 1) {
            SysJobLog g = rows[i];
            StrMap row = new StrMap();
            row.Set("startedAt", Fmt.Stamp(g.startedAt));
            row.Set("msText", Fmt.Dur(g.ms * 1000));
            row.Set("okText", "成功");
            row.Set("okClass", "ok");
            if (g.ok != 1) {
                row.Set("okText", "失败");
                row.Set("okClass", "err");
            }
            row.Set("message", g.message);
            items.Add(row);
        }
        this.Pager(d, q, total);
        this.Page(d);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("清空运行历史")]
    async void Clear() {
        int id = this.InInt("id", 0);
        SysJob j = await this.SysJob.ById(id);
        if (j == null) { this.Fail(404, "0404", "任务不存在"); }
        int n = await this.SysJobLog.Delete()
            .Where(a => a.jobId == id).ExecuteAffrowsAsync();
        await this.Note("清空运行历史", j.name, n >= 0,
            Convert.ToString(n) + " 条");
        this.Saved("运行历史已清空");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除任务")]
    async void Delete() {
        int id = this.InInt("id", 0);
        SysJob j = await this.SysJob.ById(id);
        if (j == null) { this.Fail(404, "0404", "任务不存在"); }
        string name = j.name;
        int n = await this.SysJob.Delete().Where(a => a.id == id)
            .ExecuteAffrowsAsync();
        int _l = await this.SysJobLog.Delete()
            .Where(a => a.jobId == id).ExecuteAffrowsAsync();
        JobHost.Touch();
        await this.Note("删除定时任务", name, n > 0, "");
        this.Saved("任务已删除");
    }

    /* param 的人读文本，按 kind 解释。 */
    static string ParamText(SysJob j) {
        if (j.kind == "log.cleanup") {
            return "保留 " + JobHost.NormalizeParam(j.kind, j.param) + " 天";
        }
        return "—";
    }
}
