using System;
using System.Web;
using ZanWeb.Core;
using ZanWeb.Security;
using ZanWeb.Services;
using ZanWeb.Web;

namespace ZanWeb.Admin;

/* 管理台会话端点：/admin/login 与 /admin/logout 的声明区。URL 区籍规则
   要求 admin/ 前缀端点只能由 Admin 区控制器声明（曾因写在 Account 区被判定为
   跨区路由）；登录卡片与校验流是 Account 区的共享实现，此处薄壳转发
   ——两区共用同一 cookie、同一限流与登录日志，页面文案不同而已。视图
   键沿用 Account.LoginController.Index（登录卡是共享视图资产，键=文件路径）。 */
[Route("admin/login/[action]")]
[Custom(Authorization = CustomAuthorization.None)]
[Description("管理台登录")]
class LoginController : AdminController {
    [HttpGet]
    [Route("/admin/login")]
    [Description("登录")]
    async void Index() {
        if (this.IsLogin()) {
            this.Ctx().Redirect(Routes.Admin);
            return;
        }
        string site = await Settings.Get(SettingKeys.SiteTitle, "ZanWeb");
        this.ViewOf(ZanWeb.Account.LoginController.Tpl,
            await ZanWeb.Account.LoginController.Form(site, "", this.In("user"),
                "/admin/login/submit", "管理后台", true, false));
    }

    [HttpPost]
    [Route("/admin/login/submit")]
    [Description("登录提交")]
    async void Submit() {
        await ZanWeb.Account.LoginController.Attempt(this,
            "/admin/login/submit", "管理后台", true, false, "/admin");
    }

    [HttpGet]
    [Route("/admin/logout")]
    [Description("退出登录")]
    async void Logout() {
        /* 退出即全端下线：bump tokenVersion 让该账号所有已发令牌（含
           其他浏览器/端）立刻作废，并同步失效本机版本缓存与集群副本，
           校验下一请求即落库；再让 cookie 过期完成本浏览器登出。 */
        if (this.IsLogin()) {
            int uid = Filter.ToInt(this.uid, 0);
            if (uid > 0) {
                try {
                    int _n = await new ZanWeb.Dao.SysUserDao(this)
                        .BumpTokenVersion(uid);
                } catch (Exception ex) {
                    Log.Error("[auth] logout bump failed for uid "
                        + Convert.ToString(uid) + ": " + ex.Message);
                }
                AuthUser.Forget(this.uid);
            }
        }
        this.Ctx().SetCookie("zsession", "", 0);
        this.Ctx().Redirect(Routes.Login);
    }
}
