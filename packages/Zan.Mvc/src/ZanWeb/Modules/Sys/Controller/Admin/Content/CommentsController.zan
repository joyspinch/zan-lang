using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using ZanWeb.Core;
using ZanWeb.Security;
using ZanWeb.Web;
using ZanWeb.Model.Blog;

namespace ZanWeb.Admin.Content;

/* /admin/content/comments 评论审核——配置驱动屏。读者评论以 status=0
   存储，通过后方在前台可见；待审/通过/驳回由 status 列的 Opts+Inline
   声明供给：行内下拉即审核，通过与拒绝是同一写操作、同一权限位。
   文章列是虚拟列（OnRows 投影），其余全部零编码。 */
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("评论管理")]
class CommentsController : CrudScreenController {
    protected override CrudConf Def() {
        return CrudConf.Of("blog_comment", "评论管理", "admin/content/comments")
            .Order("id", true)
            .Label("author")

            .Col("id", "ID").Int().W("70px").Ro()
            .Col("post", "文章").V().W("240px")
            .Col("author", "作者").W("110px").Max(32)
            .Col("content", "内容").Area().Max(500)
            .Col("ip", "IP").W("130px").Ro()
            .Col("status", "状态").Opts("0=待审|muted,1=通过|ok,2=驳回|err")
                .W("90px").Def("0").Inline().Search("按状态筛选")
            .Col("createdAt", "时间").Time().W("150px").Ro()

            .TbarReload()
            .TbarDelete()
            .OpsDel("删除后不可恢复，确认删除该评论吗？")
            .Created("createdAt");
    }

    [HttpGet]
    [Custom(IsMenu = true, Icon = "mdi:comment-multiple", Perm = PermBit.View)]
    [Description("评论管理")]
    async void Index() { await this.DoList(); }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("评论表格配置")]
    void Conf() { this.DoConf(); }

    /* adminUI 数据契约：POST {api}/list 以 JSON {page,pageSize,...筛选}
       取分页行；方法名带 Data 避开与列表屏路由撞名，显式 Route 归位。 */
    [HttpPost]
    [Route("/admin/content/comments/list")]
    [Custom(Perm = PermBit.View)]
    [Description("评论数据")]
    async void ListData() { await this.DoListData(); }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("评论行数据")]
    async void Edit() { await this.DoEdit(); }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("评论表单配置")]
    void FormConf() { this.DoFormConf(); }

    [HttpGet]
    [Custom(Perm = PermBit.Update)]
    [Description("评论表单")]
    async void Form() { await this.DoForm(); }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("保存评论")]
    async void Save() { await this.DoSave(); }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除评论")]
    async void Delete() { await this.DoDelete(); }

    [HttpPost]
    [Custom(Perm = PermBit.Update | PermBit.Delete)]
    [Description("评论批量操作")]
    async void Batch() { await this.DoBatch(); }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("评论行内修改")]
    async void Field() { await this.DoField(); }

    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("评论选项")]
    async void Options() { await this.DoOptions(); }

    /* 投影：文章列。每页至多 20 行，整表载入后按 id 匹配即可。 */
    protected override async List<StrMap> OnRows(List<StrMap> rows) {
        if (rows.Count == 0) { return rows; }
        List<Post> posts = await this.Post.ToListAsync();
        for (int i = 0; i < rows.Count; i = i + 1) {
            int pid = (int)Filter.ToLong(rows[i].Get("postId"), 0);
            rows[i].Set("post", PostTitle(posts, pid));
        }
        return rows;
    }

    static string PostTitle(List<Post> posts, int id) {
        for (int i = 0; i < posts.Count; i = i + 1) {
            if (posts[i].id == id) { return posts[i].title; }
        }
        return "—";
    }
}
