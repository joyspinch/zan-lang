using System;
using System.Data;
using System.Web;
using Zan.Web.Core;
using Zan.Web.Services;
using Zan.Web;

namespace Zan.Web.Health;

/* 免鉴权健康检查：给负载均衡、看门狗与外部进程监督（systemd/Docker）探活。 监控屏都要登录，而探活端点必须不能要——认证墙内没有可用性观测。 默认只答进程自身事实（无依赖、微秒级）；?deep=1 再探主库（借还一条连接 执行 SELECT 1），库不可达答 503，让 LB 有摘除依据。本端点是一条普通路由， 探活成败本身就记入 /health 指标行——没有流量时Health检查就是心跳。 */
[Custom(Authorization = CustomAuthorization.None)]
[Description("健康检查")]
public class HealthController : AppController {
    [HttpGet]
    [Route("/health")]
    [Description("健康检查")]
    public async void Index() {
        long uptimeMs = 0L;
        long reqCount = 0L;
        WebApp app = WebHost.Current();
        if (app != null) {
            JsonDoc m = JsonDoc.Parse(app.MetricsJson());
            if (m != null) {
                uptimeMs = m.PathLong("uptime_ms", 0L);
                reqCount = m.PathLong("requests.count", 0L);
            }
        }

        string status = "ok";
        string dbStatus = "";
        bool is503 = false;

        if (this.In("deep") == "1") {
            /* 租约在 OnBeforeAsync 已取得：DbReady() 即"借到了连接"。 绝不再向池借第二条——持有租约时的嵌套借还会在连接耗尽时 变成人人持一等人人的循环等待（AdminController 有实测注）。 */
            if (!this.DbReady()) {
                status = "down";
                dbStatus = "pool not ready";
                is503 = true;
            } else {
                bool dbUp = false;
                try {
                    DbResult r = await this.Held().QueryAsync("SELECT 1",
                        new DbParams());
                    dbUp = r != null;
                } catch (Exception ex) {
                    Console.WriteLine("[health] database probe failed: " + ex.Message);
                }
                if (!dbUp) {
                    status = "down";
                    dbStatus = "unreachable";
                    is503 = true;
                } else {
                    dbStatus = "up";
                }
            }
        }

        if (is503) {
            this.Ctx().Status(503, "Service Unavailable");
        }

        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WritePropertyString("status", status);
        if (uptimeMs > 0L) { w.WritePropertyLong("uptime_ms", uptimeMs); }
        if (reqCount > 0L) { w.WritePropertyLong("requests", reqCount); }
        w.WritePropertyInt("pid", ProcessHost.Pid());
        w.WritePropertyInt("worker", ProcessHost.WorkerId());
        if (dbStatus.Length > 0) { w.WritePropertyString("db", dbStatus); }
        w.WriteEndObject();
        this.Json(w.ToString());
    }

    /* K8s 存活探针：进程与事件循环存活，微秒级直接应答。 */
    [HttpGet]
    [Route("/healthz/live")]
    [Description("K8s存活探针")]
    public void Live() {
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WritePropertyString("status", "ok");
        w.WritePropertyInt("pid", ProcessHost.Pid());
        w.WritePropertyInt("worker", ProcessHost.WorkerId());
        w.WriteEndObject();
        this.Json(w.ToString());
    }

    /* K8s 就绪探针：检查核心依赖（数据库、Redis）是否就绪，不可达时返回 503 让 Ingress/LB 摘除流量。 */
    [HttpGet]
    [Route("/healthz/ready")]
    [Description("K8s就绪探针")]
    public async void Ready() {
        string dbStatus = "";
        bool dbUp = false;
        if (!this.DbReady()) {
            dbStatus = "pool not ready";
        } else {
            try {
                DbResult r = await this.Held().QueryAsync("SELECT 1", new DbParams());
                dbUp = (r != null);
            } catch (Exception ex) {
                Console.WriteLine("[health] database probe failed: " + ex.Message);
            }
            if (!dbUp) {
                dbStatus = "unreachable";
            }
        }

        if (!dbUp) {
            this.Ctx().Status(503, "Service Unavailable");
            JsonWriter w = new JsonWriter();
            w.WriteStartObject();
            w.WritePropertyString("status", "down");
            w.WritePropertyString("db", dbStatus);
            w.WriteEndObject();
            this.Json(w.ToString());
            return;
        }

        JsonWriter w2 = new JsonWriter();
        w2.WriteStartObject();
        w2.WritePropertyString("status", "ready");
        w2.WritePropertyString("db", "up");
        if (ClusterBus.Enabled()) {
            w2.WritePropertyString("cluster", "up");
        }
        w2.WriteEndObject();
        this.Json(w2.ToString());
    }
}
