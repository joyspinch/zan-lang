using System;
using ZanWeb.Core;
using ZanWeb.Model;
using ZanWeb.Services;
using ZanWeb.Web;
using System.Web;
using System.Json;

namespace ZanWeb.Users;

/* ORM 与缓存示例：列出用户（缓存）并按路由参数展示单个；路由 /users 与 /user/{id}。 */
[Route("[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.Login)]
[Description("用户")]
class Users : AppController {
    [HttpGet]
    [Route("/users")]
    [Description("用户列表")]
    async void Index() {
        CacheContext cache = this.Cache();
        string cached = "";
        if (cache != null) { cached = await cache.GetAsync("users:all"); }
        if (cached.Length > 0) {
            JsonValue o = JsonValue.NewObject();
            o.Put("code", JsonValue.NewStr("0000"));
            o.Put("msg", JsonValue.NewStr("ok (cache)"));
            JsonValue d = JsonValue.ParseLenient(cached);
            if (d != null) { o.Put("data", d); }
            this.Json(o.ToJson());
            return;
        }
        if (!this.DbReady()) {
            this.Fail(503, "2001",
                "database not configured -- set [database] in config/app.json");
        }
        /* 直接查询实体列表：FreeSql 风格实体直出；敏感字段原地脱敏后序列化，无需建类转来转去 */
        List<SysUser> users = await this.SysUser.OrderBy(a => a.id).ToListAsync();
        for (int i = 0; i < users.Count; i = i + 1) {
            users[i].passwordHash = "";
            users[i].passwordSalt = "";
            users[i].email = Fmt.MaskEmail(users[i].email);
            users[i].mobile = Fmt.MaskMobile(users[i].mobile);
        }
        string data = Json.Serialize<List<SysUser>>(users);
        if (cache != null) { await cache.SetTtlAsync("users:all", data, 5); }
        this.Ok(data);
    }

    [HttpGet]
    [Route("/user/{id}")]
    [Description("用户详情")]
    void Show() {
        string id = this.Param("id");
        JsonValue o = JsonValue.NewObject();
        o.Put("id", JsonValue.NewStr(id));
        o.Put("name", JsonValue.NewStr("user-" + id));
        this.Ok(o.ToJson());
    }
}
