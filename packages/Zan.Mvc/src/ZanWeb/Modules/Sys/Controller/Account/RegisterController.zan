using System;
using System.Data.Orm;
using System.Net.External;
using System.Net.Http;
using System.Security.Cryptography;
using System.Web;
using ZanWeb.Core;
using ZanWeb.Dao;
using ZanWeb.Model;
using ZanWeb.Security;
using ZanWeb.Services;
using ZanWeb.Web;

namespace ZanWeb.Account;

/* 自助注册，可在站点设置中开关（auth.register.enabled / verify）；关闭的
   流程以重定向到登录页作答，而非渲染一个没人能提交的表单。开启验证时，
   邮箱须在建账号前用 VerifyCode 发出的验证码自证。新账号不授予任何角色
   ——它能做什么由管理后台授权，开放注册本身不会把权限交到人手上。
   找回密码是独立的屏（Forgot.zan），本类保留两屏共享的卡片外壳 Page 与
   发码通道 SendCode（static，屏即类的拆分不拆共享件）。 */
[Route("[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.None)]
[Description("注册")]
class RegisterController : AppController {
    static string RegTpl = "Account.RegisterController.Index";

    [HttpGet]
    [Route("/register")]
    [Description("注册")]
    async void Index() {
        if (!await Settings.On(SettingKeys.RegisterEnabled, false)) {
            this.Ctx().Redirect(Routes.SignIn);
            return;
        }
        this.ViewOf(RegTpl, await Page("注册", "", "", this.In("user"), this.In("email")));
    }

    [HttpPost]
    [Route("/register/submit")]
    [Description("提交注册")]
    async void Submit() {
        if (!await Settings.On(SettingKeys.RegisterEnabled, false)) {
            this.Ctx().Redirect(Routes.SignIn);
            return;
        }
        string user = this.In("user");
        string email = this.In("email");
        string pass = this.In("pass");
        string code = this.In("code");

        if (user.Length < 3 || user.Length > 32) {
            await this.Back("账号需要 3 到 32 个字符", user, email);
            return;
        }
        if (!LooksLikeMail(email)) {
            await this.Back("请填写正确的邮箱地址", user, email);
            return;
        }
        if (pass.Length < 8) {
            await this.Back("密码至少 8 位", user, email);
            return;
        }
        if (await Settings.On(SettingKeys.RegisterVerify, true)) {
            if (!await VerifyCode.Accept("register", email, code)) {
                await this.Back("验证码不正确或已过期", user, email);
                return;
            }
        }

        if (!this.DbReady()) {
            await this.Back("数据库不可用，请稍后再试", user, email); return;
        }
        SysUserDao userDao = new SysUserDao(this);
        int clash = await userDao.CountByUsername(user);
        if (clash > 0) { await this.Back("账号已被使用", user, email); return; }
        int mailClash = await userDao.CountByEmail(email);
        if (mailClash > 0) { await this.Back("该邮箱已注册", user, email); return; }

        SysUser u = new SysUser();
        u.username = user;
        u.nickname = user;
        u.email = email;
        u.mobile = "";
        u.departmentId = 0;
        u.passwordSalt = "";
        u.passwordHash = AuthUser.NewHash(pass);
        u.status = 1;
        u.isSuper = 0;
        u.tokenVersion = 1;
        u.createdAt = WebApp.NowSeconds();
        u.updatedAt = u.createdAt;
        int _id = await userDao.Insert(u);

        string token = await AuthUser.Login(user, pass);
        if (token.Length > 0) {
            this.Ctx().SetCookie("zsession", token, 864000);
            this.Ctx().Redirect(Routes.Home);
            return;
        }
        this.Ctx().Redirect(Routes.SignIn);
    }

    [HttpPost]
    [Route("/register/code")]
    [Description("发送注册验证码")]
    async void Code() {
        if (!await Settings.On(SettingKeys.RegisterEnabled, false)) {
            this.Fail(403, "0403", "注册未开放");
        }
        await SendCode(this, "register", this.In("email"), "注册验证码");
    }

    /* 为两种目的发验证码；该邮箱是否属于某账号绝不透露——答法两者相同，故表单无法用于枚举已注册邮箱。static 供注册与找回密码两屏共用。 */
    static async void SendCode(AppController c, string purpose, string email, string subject) {
        if (!LooksLikeMail(email)) {
            c.Fail(400, "0004", "请填写正确的邮箱地址");
        }
        if (!await Mailer.Ready()) {
            c.Fail(400, "0004", "站点尚未配置邮件服务");
        }
        string ip = IssuanceIp(c.Ctx());
        VerifyCodeIssue issued = await VerifyCode.IssueForIp(purpose, email, ip);
        if (issued.status == 0) {
            c.Fail(429, "0429", "验证码发送频繁，请稍后再试");
            return;
        }
        if (issued.status != 1 || issued.code.Length == 0) {
            c.Fail(503, "0503", "验证码服务暂不可用");
            return;
        }
        string code = issued.code;
        string site = await Settings.Get(SettingKeys.SiteTitle, "ZanWeb");
        MailResult r = await Mailer.Send(email, site + " " + subject,
            "你的验证码是 " + code + "，10 分钟内有效。\n\n如果这不是你本人的操作，忽略这封邮件即可。");
        if (!r.ok) {
            c.Fail(502, "0502", r.Message());
        }
        c.Ok("验证码已发送");
    }

    /* Strict literals only, without DNS, ports, brackets or zone IDs. Expand IPv6
       to one spelling so equivalent texts cannot create extra quota buckets.
       IPv4-mapped IPv6 shares the native IPv4 identity. */
    static string CanonicalIp(string ip) {
        if (ip.Length == 0 || ip.Length > 45) { return ""; }
        if (ExternalTarget.ValidIPv4(ip)) { return ip; }
        if (!ip.Contains(":")) { return ""; }
        if (ip.Contains(".")) {
            int tail = ip.LastIndexOf(":") + 1;
            string v4 = ip.Substring(tail);
            if (!ExternalTarget.ValidIPv4(v4)) { return ""; }
            List<string> octets = v4.Split(".");
            int high = Convert.ToInt32(octets[0]) * 256 + Convert.ToInt32(octets[1]);
            int low = Convert.ToInt32(octets[2]) * 256 + Convert.ToInt32(octets[3]);
            ip = ip.Substring(0, tail) + IpHex(high) + ":" + IpHex(low);
        }
        int gap = ip.IndexOf("::");
        if (gap >= 0 && ip.IndexOf("::", gap + 2) >= 0) { return ""; }
        string left = ip;
        string right = "";
        if (gap >= 0) { left = ip.Substring(0, gap); right = ip.Substring(gap + 2); }
        List<int> before = new List<int>();
        List<int> after = new List<int>();
        if (!IpGroups(left, before) || !IpGroups(right, after)) { return ""; }
        int count = before.Count + after.Count;
        if ((gap < 0 && count != 8) || (gap >= 0 && count >= 8)) { return ""; }
        List<int> words = new List<int>();
        for (int i = 0; i < before.Count; i = i + 1) { words.Add(before[i]); }
        for (int i = count; i < 8; i = i + 1) { words.Add(0); }
        for (int i = 0; i < after.Count; i = i + 1) { words.Add(after[i]); }
        if (words[0] == 0 && words[1] == 0 && words[2] == 0 && words[3] == 0
            && words[4] == 0 && words[5] == 65535) {
            return Convert.ToString(words[6] / 256) + "." + Convert.ToString(words[6] % 256)
                + "." + Convert.ToString(words[7] / 256) + "." + Convert.ToString(words[7] % 256);
        }
        string result = "";
        for (int i = 0; i < 8; i = i + 1) {
            if (i > 0) { result = result + ":"; }
            result = result + IpHex(words[i]);
        }
        return result;
    }

    static bool IpGroups(string part, List<int> words) {
        if (part.Length == 0) { return true; }
        int start = 0;
        for (int i = 0; i <= part.Length; i = i + 1) {
            if (i == part.Length || part[i] == ':') {
                int word = ExternalTarget.ParseHex(part.Substring(start, i - start));
                if (word < 0 || words.Count >= 8) { return false; }
                words.Add(word);
                start = i + 1;
            }
        }
        return true;
    }

    static string IpHex(int word) {
        string digits = "0123456789abcdef";
        string result = "";
        for (int shift = 12; shift >= 0; shift = shift - 4) {
            result = result + digits.Substring((word >> shift) & 15, 1);
        }
        return result;
    }

    static string IssuanceIp(HttpContext ctx) {
        string peer = CanonicalIp(ctx.RemoteIp());
        // Missing/invalid peer identity must not become attacker-selected buckets.
        if (peer.Length == 0) { return "unknown"; }
        string configured = Cfg.Server.trustedProxies;
        if (configured.Length == 0 || configured.Length > 4096) { return peer; }
        List<string> entries = configured.Split(",");
        List<string> trusted = new List<string>();
        for (int i = 0; i < entries.Count; i = i + 1) {
            string proxy = CanonicalIp(entries[i].Trim());
            // One invalid entry disables the entire list rather than broadening trust.
            if (proxy.Length == 0) { return peer; }
            trusted.Add(proxy);
        }
        if (!trusted.Contains(peer)) { return peer; }
        HttpRequest request = ctx.request;
        if (request.parseStatus != 0) { return peer; }
        // GetHeader returns the first field, so reject duplicates before using it.
        int fields = 0;
        List<string> lines = request.rawHeaders.Split("\n");
        for (int i = 0; i < lines.Count; i = i + 1) {
            string line = lines[i];
            if (line.Length > 0 && (line[0] == ' ' || line[0] == '\t')) { return peer; }
            int colon = line.IndexOf(":");
            if (colon >= 0 && line.Substring(0, colon).Trim().ToLower() == "x-forwarded-for") {
                fields = fields + 1;
            }
        }
        if (fields != 1) { return peer; }
        string forwarded = request.GetHeader("X-Forwarded-For");
        if (forwarded.Length == 0 || forwarded.Length > 2048) { return peer; }
        List<string> hops = forwarded.Split(",");
        if (hops.Count > 32) { return peer; }
        List<string> addresses = new List<string>();
        for (int i = 0; i < hops.Count; i = i + 1) {
            string hop = CanonicalIp(hops[i].Trim());
            if (hop.Length == 0) { return peer; }
            addresses.Add(hop);
        }
        // Only a trusted hop can vouch for the preceding address. Never select the
        // leftmost item blindly: an untrusted client can prepend arbitrary values.
        string current = peer;
        for (int i = addresses.Count - 1; i >= 0; i = i - 1) {
            if (!trusted.Contains(current)) { return current; }
            current = addresses[i];
        }
        return current;
    }

    async void Back(string error, string user, string email) {
        this.ViewOf(RegTpl, await Page("注册", error, "", user, email));
    }

    static bool LooksLikeMail(string s) {
        int at = s.IndexOf("@");
        return at > 0 && s.IndexOf(".", at) > at + 1 && s.Length < 128;
    }

    static async ViewData Page(string what, string error, string done,
                               string user, string email) {
        string site = await Settings.Get(SettingKeys.SiteTitle, "ZanWeb");
        ViewData d = new ViewData();
        d.Set("title", what + " · " + site);
        d.Set("brand", site);
        d.Set("error", error);
        d.Set("done", done);
        d.Set("user", user);
        d.Set("email", email);
        if (await Settings.On(SettingKeys.RegisterVerify, true)) { d.Set("needCode", "1"); }
        if (await Settings.On(SettingKeys.RegisterEnabled, false)) { d.Set("canRegister", "1"); }
        if (await Settings.On(SettingKeys.ResetEnabled, true)) { d.Set("canReset", "1"); }
        return d;
    }
}
