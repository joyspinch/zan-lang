using System;
using System.Data.Orm;
using System.Web;
using ZanWeb.Core;
using ZanWeb.Dao;
using ZanWeb.Model;
using ZanWeb.Security;
using ZanWeb.Services;
using ZanWeb.Web;

namespace ZanWeb.Account;

/* 登录屏（前台 /login）：与 POST /api/auth/login 发出同一 cookie（AuthUser.LoginController → AuthToken.Issue），浏览器会话与 API 令牌为同一机制；此处不关心密码如何加盐或令牌如何签名。独立模块以取得独立外壳（Account/layout.html 为居中卡片，非管理后台外壳——尚未可用的页面放侧边栏是噪声）。管理台端点 /admin/login 与 /admin/logout 的声明区在 Admin/LoginController.zan（URL 区籍：admin 前缀端点只能由 Admin 区声明），校验流 Attempt 在本类 static 共享、两壳复用，失败重渲染卡片，理由就在用户正看的页面上。 */
[Route("[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.None)]
[Description("登录")]
class LoginController : AppController {
    static string Tpl = "Account.LoginController.Index";

    /* 前台登录：同一机制与卡片，自有外壳与目的地——普通成员回站点首页（/），而非一个可能无权进入的管理后台。GET /login 由默认动作 Index 承接；POST 显式带动作段 /login/submit，路由可逐段寻到方法。 */
    [HttpGet]
    [Route("/login")]
    [Description("登录")]
    async void Index() {
        if (this.IsLogin()) {
            this.Ctx().Redirect(Routes.Home);
            return;
        }
        string site = await Settings.Get(SettingKeys.SiteTitle, "ZanWeb");
        this.ViewOf(Tpl, await Form(site, "", this.In("user"),
            "/login/submit", "登录", false, true));
    }

    [HttpPost]
    [Route("/login/submit")]
    [Description("登录提交")]
    async void Submit() {
        await Attempt(this, "/login/submit", "登录", false, true, "/");
    }

    /* 两张卡片共用一条登录路径：action/heading/demo/home 只塑造重渲的表单，redirectTo 是成功后的去向；失败重渲同卡片，理由留在用户正看的页面上。static 供 Admin/LoginController.zan 薄壳转发（/admin/login 的声明区在 Admin 区）。 */
    static async void Attempt(AppController c, string action, string heading,
                              bool demo, bool home, string redirectTo) {
        string site = await Settings.Get(SettingKeys.SiteTitle, "ZanWeb");
        string user = c.In("user");
        string pass = c.In("pass");
        if (user.Length == 0 || pass.Length == 0) {
            c.ViewOf(Tpl, await Form(site, "请输入账号和密码",
                user, action, heading, demo, home));
            return;
        }
        if (user.Length > 32 || pass.Length > 64) {
            c.ViewOf(Tpl, await Form(site, "账号或密码超出长度限制",
                "", action, heading, demo, home));
            return;
        }
        /* 空字符串同时覆盖"被限流""无此账号"与"密码错误"，令牌路径不得
           向攻击者区分；页面上限流单独提示（锁状态本就来自攻击者自己
           的失败次数，不构成新信息），日志分开记便于发现爆破。 */
        string token = await AuthUser.Login(user, pass);
        if (token.Length == 0) {
            string reason = LoginThrottle.Blocked(user)
                ? "尝试过于频繁，请稍后再试" : "账号或密码不正确";
            await Record(c, c.Ctx(), user, false, reason);
            if (!AuthToken.Ready()) {
                c.ViewOf(Tpl, await Form(site,
                    "服务端未配置会话密钥：请在 config/app.json 的 [auth].secret（或环境变量 ZAN_AUTH_SECRET）填入至少 32 字符",
                    user, action, heading, demo, home));
                return;
            }
            c.ViewOf(Tpl, await Form(site, reason,
                user, action, heading, demo, home));
            return;
        }
        await Record(c, c.Ctx(), user, true, "");
        c.Ctx().SetCookie("zsession", token, 864000);
        /* redirectTo 为空 = 管理台壳：落地页交给"该账号可到达的第一个
           菜单项"（与侧边栏同源同序，看到什么第一项就落到哪里）；
           一项不可达（新号未授权）落到个人资料页——那里能改密码、能退出，
           不落 404。非空（前台壳传 /）照旧。 */
        string target = redirectTo;
        if (target.Length == 0) {
            WebApp cur = WebHost.Current();
            string uid2 = await AuthToken.Resolve(token);
            target = await MenuBuilder.LandingFor(cur, uid2);
            if (target.Length == 0) { target = Routes.Profile; }
        }
        c.Ctx().Redirect(target);
    }

    /* 每次尝试都入 sys_login_log，失败也记：猜测密码的记录只在失败留存时才可追溯。static 供两壳复用。 */
    static async void Record(AppController c, HttpContext ctx, string user,
                             bool ok, string message) {
        if (c.__Conn() == null) { return; }
        SysLoginLog row = new SysLoginLog();
        row.userId = 0;
        row.username = user;
        row.ip = ClientIp.Of(ctx);
        row.agent = ctx.Header("User-Agent");
        row.ok = 0;
        if (ok) { row.ok = 1; }
        row.message = message;
        row.createdAt = WebApp.NowSeconds();
        int _id = await c.SysLoginLog.Insert(row).ExecuteIdentityAsync();
    }

    static ViewData Page(string site, string error, string user) {
        ViewData d = new ViewData();
        d.Set("title", "登录 · " + site);
        d.Set("brand", site);
        d.Set("error", error);
        d.Set("user", user);
        return d;
    }

    /* 按站点设置补上注册/找回链接；关闭的流程不给出会重定向回此处的页。 */
    static async ViewData PageWithLinks(string site, string error, string user) {
        ViewData d = Page(site, error, user);
        bool reg = await Settings.On(SettingKeys.RegisterEnabled, false);
        bool reset = await Settings.On(SettingKeys.ResetEnabled, true);
        if (reg) { d.Set("canRegister", "1"); }
        if (reset) { d.Set("canReset", "1"); }
        if (reg || reset) { d.Set("authLinks", "1"); }
        return d;
    }

    /* 注册/找回链接 + 区分两张卡片的字段：表单提交位置 action、标题、是否打印引导账号提示 demo（仅管理后台卡）、是否给出回前台入口 home（仅前台卡）。 */
    static async ViewData Form(string site, string error, string user,
                               string action, string heading, bool demo,
                               bool home) {
        ViewData d = await PageWithLinks(site, error, user);
        d.Set("action", action);
        d.Set("heading", heading);
        if (demo) { d.Set("demo", "1"); }
        if (home) { d.Set("home", "1"); }
        return d;
    }
}
