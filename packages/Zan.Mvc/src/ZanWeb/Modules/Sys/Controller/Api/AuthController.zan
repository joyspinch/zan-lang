using System;
using Zan.Web.Core;
using Zan.Web.Security;
using Zan.Web;
using System.Web;

namespace Zan.Web.Api;

/* 认证端点；路由 /api/auth/login、/api/auth/me。 */
[Custom(Authorization = CustomAuthorization.None)]
[Description("认证")]
public class AuthController : ApiController {
    [HttpPost]
    [Description("登录")]
    public async void Login() {
        /* 必填用 Need：缺参数即以 {"code":"0003"} 结束，并让 /api/docs 标此两参数为必填；Validator 留给"存在但不合法"的规则（长度、格式）。 */
        string user = this.Need("user", "user");
        string pass = this.Need("pass", "pass");
        Validator v = new Validator();
        v.MaxLen(user, 32, "user");
        v.MaxLen(pass, 64, "pass");
        if (!v.Ok()) {
            this.ctx.Status(422, "Unprocessable Entity");
            this.ctx.Api("1003", "validation failed", v.ErrorsJson());
            return;
        }
        string token = await AuthUser.Login(user, pass);
        if (token.Length == 0) {
            if (!AuthToken.Ready()) {
                this.Fail(503, "1002", "set [auth].secret in config/app.json (or ZAN_AUTH_SECRET) to at least 32 characters");
            }
            this.Fail(401, "1001", "bad credentials");
        }
        this.ctx.SetCookie("zsession", token, 864000);
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WritePropertyString("token", token);
        w.WriteEndObject();
        this.Ok(w.ToString());
    }

    [HttpGet]
    [Custom(Authorization = CustomAuthorization.Login)]
    [Description("当前用户")]
    public void Me() {
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WritePropertyString("uid", this.uid);
        w.WriteEndObject();
        this.Ok(w.ToString());
    }
}
