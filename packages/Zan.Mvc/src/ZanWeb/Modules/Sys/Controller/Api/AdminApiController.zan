using System;
using Zan.Web.Core;
using Zan.Web.Model;
using Zan.Web.Security;
using Zan.Web;
using System.Web;

namespace Zan.Web.Api;

/* 管理端 API：菜单（权限过滤后）与仪表盘摘要，答 {code,msg,data}。
   菜单走 MenuBuilder.JsonFor —— 服务端决定可达项，前端拿到的每条链接
   都是 API 层放行的，不存在「菜单有、接口拒」的第二种事实。 */
[Route("api/admin/[action]")]
[Custom(Authorization = CustomAuthorization.Login)]
[Description("管理壳")]
public class AdminApiController : AdminController {
    [HttpGet]
    [Description("侧边栏菜单")]
    public async void Menu() {
        string menu = await MenuBuilder.JsonFor(
            WebHost.Current(), this.uid, this.Ctx().path);
        this.Ok(menu);
    }

    [HttpGet]
    [Description("仪表盘摘要")]
    public async void Summary() {
        JsonDoc m = JsonDoc.Parse(WebHost.Current().MetricsJson());
        long uptimeMs = m != null ? m.PathLong("uptime_ms", 0L) : 0L;
        long reqCount = m != null ? m.PathLong("requests.count", 0L) : 0L;
        long reqErrors = m != null ? m.PathLong("requests.errors", 0L) : 0L;
        long reqAvgUs = m != null ? m.PathLong("requests.avg_us", 0L) : 0L;

        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WritePropertyString("uptime", Fmt.Uptime(uptimeMs));
        w.WritePropertyLong("requests", reqCount);
        w.WritePropertyLong("errors", reqErrors);
        w.WritePropertyLong("avg_us", reqAvgUs);

        w.WritePropertyName("db");
        w.WriteStartObject();
        if (this.DbReady()) {
            w.WritePropertyBool("ok", true);
            w.WriteEndObject();

            DataScope sc = await this.Scope();
            List<int> scoped = sc.Depts();
            int mine = sc.UserId();
            int users = await this.SysUser
                .WhereIf(sc.ByDept(), a => scoped.Contains(a.departmentId))
                .WhereIf(sc.Mine(), a => a.id == mine)
                .CountAsync();
            int posts = await this.Post.CountAsync();
            int published = await this.Post.Where(a => a.published == 1).CountAsync();
            int comments = await this.Comment.CountAsync();
            int pending = await this.Comment.Where(a => a.status == 0).CountAsync();

            w.WritePropertyInt("users", users);
            w.WritePropertyInt("posts", posts);
            w.WritePropertyInt("published", published);
            w.WritePropertyInt("comments", comments);
            w.WritePropertyInt("pending", pending);
        } else {
            w.WritePropertyBool("ok", false);
            w.WriteEndObject();
        }
        w.WriteEndObject();
        this.Ok(w.ToString());
    }
}
