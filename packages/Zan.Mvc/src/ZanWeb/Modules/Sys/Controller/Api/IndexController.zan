using System;
using ZanWeb.Core;
using ZanWeb.Web;
using System.Web;
using System.Json;

namespace ZanWeb.Api;

/* 公开服务状态；路由 /api/index/index；与前台 ZanWeb.Index.IndexController、管理台 ZanWeb.Admin 各屏区分的模块级 IndexController。
   菜单是显式选择（[Custom(IsMenu=true)]），类级 [Description] 只做文档，
   状态端点不带菜单标注即不属于侧栏；描述保留给接口文档与路由标题。 */
[Custom(Authorization = CustomAuthorization.None)]
[Description("服务状态")]
class IndexController : ApiController {
    [HttpGet]
    [Description("服务状态")]
    void Index() {
        this.Json(WebHost.Current().StatusJson());
    }

    [HttpGet]
    [Description("健康检查")]
    void Ping() {
        JsonValue o = JsonValue.NewObject();
        o.Put("pong", JsonValue.NewNum("1"));
        this.Ok(o.ToJson());
    }
}
