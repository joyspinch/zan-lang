using System;
using System.Text;
using System.Data;
using System.Data.Orm;
using System.Web;
using System.Json;
using Zan.Web.Core;

namespace Zan.Web;

/* 声明驱动的通用写动作与前端表格配置。
 *
 * 写侧：字段/表名白名单出自 ListPage.Table/EditFields（代码声明，非
 * 用户输入），标识符再过 Gen.Safe 字符校验与 DbTable 的 RequireIdent
 * 双保险，SQL 全部由运行期网关 DbTable/DbTableQuery 生成，值一律走
 * ? 占位符参数——本层不出现任何手拼 SQL。行级授权由调用方预检：
 * allowed 集合里的 id 才可写，越权 id 与不存在的 id 同答 404，不泄露
 * 存在性。审计经 AdminController.Note 落 sys_operation_log。
 *
 * 读侧：Conf() 把本屏声明投影为 adminUI ZanTable 的 ListConfData JSON
 * （PUT {apiObj}/conf 契约）——服务端渲染与前端表格配置同源产出，
 * 前端不再各自维护一份列定义。
 */
public class CrudOps {
    /* 单行单字段：POST id/field/value。field 必须在白名单内，值按声明
       类型绑定（int 走整型参数，其余文本），id 必须在 allowed 内。 */
    public static async void Field(AdminController c, ListPage lp, string title,
                            string field, string value, List<int> allowed) {
        StrMap def = Find(lp, field);
        if (def == null) { c.Fail(400, "0004", "该字段不可编辑"); return; }
        if (allowed.Count == 0) { c.Fail(404, "0404", "记录不存在"); return; }
        DbValues row = new DbValues();
        if (def.Get("type") == "int") { row.Set(field, Filter.ToLong(value, 0)); }
        else { row.Set(field, value); }
        int n = await DbTable.Of(c.__Conn(), lp.table)
            .UpdateAsync(row, "id", allowed[0]);
        await c.Note(title + "·编辑字段",
            "#" + Convert.ToString(allowed[0]) + " " + field, n > 0, value);
        c.Saved("已保存");
    }

    /* 批量单字段：POST ids=1,2,3（或调用方直接给 allowed）。批量启禁、
       批量改归属等"同一列一个值"的场景共用此形态；ids 上限 500 由
       AdminController.Ids() 钳制，IN 逐个占位符。 */
    public static async void Batch(AdminController c, ListPage lp, string field,
                            string value, List<int> allowed, string title) {
        StrMap def = Find(lp, field);
        if (def == null) { c.Fail(400, "0004", "该字段不可编辑"); return; }
        if (allowed.Count == 0) { c.Fail(400, "0004", "未选择记录"); return; }
        DbValues row = new DbValues();
        if (def.Get("type") == "int") { row.Set(field, Filter.ToLong(value, 0)); }
        else { row.Set(field, value); }
        int n = await DbTable.Of(c.__Conn(), lp.table).Query()
            .WhereIn("id", allowed)
            .ExecuteUpdateAsync(row);
        await c.Note(title,
            Convert.ToString(allowed.Count) + " 条", n > 0, field + "=" + value);
        c.Saved(Lang.T("已更新") + " " + Convert.ToString(n) + " " + Lang.T("条记录"));
    }

    /* 批量删除：DELETE ... WHERE id IN (占位符...); 关联清理（子表、
       缓存失效）是业务语义，留在调用方——本方法只对声明的主表负责。 */
    public static async void Delete(AdminController c, ListPage lp,
                             List<int> allowed, string title) {
        if (allowed.Count == 0) { c.Fail(400, "0004", "未选择记录"); return; }
        int n = await DbTable.Of(c.__Conn(), lp.table).Query()
            .WhereIn("id", allowed)
            .ExecuteDeleteAsync();
        await c.Note(title, Convert.ToString(allowed.Count) + " 条", n > 0, "");
        c.Saved(Lang.T("已删除") + " " + Convert.ToString(n) + " " + Lang.T("条记录"));
    }

    /* 白名单查找：field 必须精确匹配声明项，且表名/列名过 Gen.Safe——
       双重防线，声明写错时在运行期显式拒绝而不是拼出意外 SQL。 */
    public static StrMap Find(ListPage lp, string field) {
        if (!Gen.Safe(lp.table)) { return null; }
        if (field.Length == 0 || field.Length > 64) { return null; }
        for (int i = 0; i < lp.edits.Count; i = i + 1) {
            if (lp.edits[i].Get("name") == field) {
                if (!Gen.Safe(field)) { return null; }
                return lp.edits[i];
            }
        }
        return null;
    }

    /* adminUI ZanTable 契约：把本屏声明投影为 ListConfData JSON。
       信封 {resp_code,status,msg,url,dynamicToken,t,data}，data =
       {conf, columns, filters, tools}；列类型映射 text/muted→text、
       num→number、time→date、tag/flag→dict；筛选映射 Input/Select/
       DateRange/Select(remote)。editable 只对 EditFields 白名单为真。 */
    public static void Conf(AdminController c, ListPage lp) {
        JsonWriter w = new JsonWriter();
        w.StartObject();
        w.WriteProperty("resp_code", "0000");
        w.WriteProperty("status", 200);
        w.WriteProperty("msg", "ok");
        w.WriteProperty("url", "");
        w.WriteProperty("dynamicToken", "");
        w.WriteProperty("t", 0);

        w.WriteKey("data");
        w.StartObject();

        w.WriteKey("conf");
        w.StartObject();
        w.WriteProperty("showPages", true);
        w.WriteProperty("pageSize", 20);
        w.WriteKey("pageSizes");
        w.StartArray();
        w.WriteValue(10);
        w.WriteValue(20);
        w.WriteValue(50);
        w.WriteValue(100);
        w.EndArray();
        w.WriteProperty("local", false);
        w.WriteProperty("import", false);
        w.WriteProperty("export", false);
        w.EndObject();

        w.WriteKey("columns");
        w.StartArray();
        for (int i = 0; i < lp.cols.Count; i = i + 1) {
            ListCol col = lp.cols[i];
            w.StartObject();
            w.WriteProperty("headerName", col.title);
            w.WriteProperty("field", col.field);
            string type = "text";
            if (col.kind == "num") { type = "number"; }
            else if (col.kind == "time") { type = "date"; }
            else if (col.kind == "tag" || col.kind == "flag") { type = "dict"; }
            w.WriteProperty("type", type);
            w.WriteProperty("sortable", col.kind == "num");
            w.WriteProperty("editable", Find(lp, col.field) != null);
            if (col.width.Length > 0) {
                string wn = WidthNum(col.width);
                if (wn.Length > 0) {
                    w.WriteRawProperty("width", wn);
                }
            }
            if (col.opts.Length > 0) {
                w.WriteProperty("options", col.opts);
            }
            w.EndObject();
        }
        w.EndArray();

        w.WriteKey("filters");
        w.StartArray();
        for (int i = 0; i < lp.fs.Count; i = i + 1) {
            ListFilter f = lp.fs[i];
            w.StartObject();
            w.WriteProperty("title", f.title);
            w.WriteProperty("name", f.name);
            if (f.type == "text") {
                w.WriteProperty("type", "Input");
                w.WriteProperty("placeholder", f.ph);
            } else if (f.type == "select") {
                w.WriteProperty("type", "Select");
                w.WriteProperty("options", f.options);
            } else if (f.type == "time") {
                w.WriteProperty("type", "DateRange");
            } else if (f.type == "pick") {
                w.WriteProperty("type", "Select");
                w.WriteProperty("remote", f.url);
            }
            w.EndObject();
        }
        w.EndArray();

        w.WriteKey("tools");
        w.StartArray();
        for (int i = 0; i < lp.bs.Count; i = i + 1) {
            ListButton b = lp.bs[i];
            if (b.type == "sep") { continue; }
            w.StartObject();
            w.WriteProperty("name", b.name);
            w.WriteProperty("url", b.url);
            w.WriteProperty("type", b.type);
            if (b.value.Length > 0) { w.WriteProperty("value", b.value); }
            if (b.confirm.Length > 0) { w.WriteProperty("confirm", b.confirm); }
            w.EndObject();
        }
        w.EndArray();

        w.EndObject(); // end data
        w.EndObject(); // end root
        c.Json(w.ToString());
    }

    /* "130px" → 130；非数字宽度（auto 等）不产出 width 键。 */
    private static string WidthNum(string width) {
        string r = "";
        for (int i = 0; i < width.Length; i = i + 1) {
            string ch = width.Substring(i, 1);
            if (ch >= "0" && ch <= "9") { r = r + ch; } else { break; }
        }
        if (r.Length == 0) { return "0"; }
        return r;
    }
}
