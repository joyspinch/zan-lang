using System;
using System.Text;
using System.Text.RegularExpressions;
using System.Web;
using ZanWeb.Core;

namespace ZanWeb.Web;

/* 声明式表单页：字段声明、渲染、服务端校验三处同源。
 *
 * 控制器对一张表声明一次字段（类型/约束/可见性），编辑回显（HTML）与
 * 保存校验（服务端）都从这里派生——与 ListPage 合起来，一个通用 CRUD
 * 屏 = 一份声明 + Conf/List/Save/批端点，不再各写一遍模板与校验。
 * 与作者 C# 版 TableConfig/AdminUI CrudConfig 的合一形态，落在服务端
 * 渲染上：表单体整段 HTML 交给共享壳 Admin._FormDialog {{{raw}}} 输出。
 *
 * 约束校验只对可见字段生效（OnlyNew 的初始密码在编辑时既不渲染也不
 * 校验）；值经 Esc 转义回填，密码类型恒不回显。
 */
class FormPage {
    string action;
    string idValue;
    bool wide;
    List<FormField> fs;
    FormField last;

    FormPage() {
        this.fs = new List<FormField>();
        this.idValue = "0";
        this.last = null;
    }

    /* 每屏一个实例：FormPage.Of(saveUrl) 后链式声明；声明方法返回自身，
       修饰方法作用于最近一个声明。 */
    static FormPage Of(string submitAction) {
        FormPage fp = new FormPage();
        fp.action = submitAction;
        return fp;
    }

    /* 主键值：新增/编辑的唯一判定（"0" = 新增），同时渲染进隐藏 id。 */
    FormPage Id(string value) {
        this.idValue = value;
        return this;
    }

    /* 双列紧凑布局（.form.wide 一行两组）；跨满余列的字段配 Span()。 */
    FormPage Wide() {
        this.wide = true;
        return this;
    }

    /* ---- 字段声明 ------------------------------------------------ */

    FormPage Text(string label, string name) {
        return this.Add("text", label, name);
    }

    /* 整数：min/max 是数值界限（Validate 走数值分支，渲染 number）。 */
    FormPage Num(string label, string name) {
        FormField f = this.Add("text", label, name).last;
        f.type = "int";
        return this;
    }

    /* 密码：渲染 type=password，值恒不回显。 */
    FormPage Pass(string label, string name) {
        return this.Add("pass", label, name);
    }

    FormPage Area(string label, string name) {
        return this.Add("area", label, name);
    }

    /* 下拉；options 形如 "1=启用,0=禁用"，选中项按 Val 比对。 */
    FormPage Select(string label, string name, string options) {
        this.Add("select", label, name);
        this.last.options = options;
        return this;
    }

    /* 动态选项（部门/分类等）：rows 为 id/name 两列，由控制器查询后传入。 */
    FormPage SelectList(string label, string name, List<StrMap> rows) {
        this.Add("list", label, name);
        this.last.rows = rows;
        return this;
    }

    /* 提示块：不产生输入与校验（如"改密码请用重置密码"）。 */
    FormPage Hint(string text) {
        this.Add("hint", "", "");
        this.last.value = text;
        return this;
    }

    FormPage Add(string kind, string label, string name) {
        FormField f = new FormField();
        f.kind = kind;
        f.label = label;
        f.name = name;
        f.value = "";
        f.ph = "";
        f.options = "";
        f.blank = "";
        this.fs.Add(f);
        this.last = f;
        return this;
    }

    /* 按参数名取回字段继续修饰（编辑时绑实体值用）：
       fp.Field("username").Val(u.username)。名字必须在声明里。 */
    FormPage Field(string name) {
        for (int i = 0; i < this.fs.Count; i = i + 1) {
            if (this.fs[i].name == name) {
                this.last = this.fs[i];
                return this;
            }
        }
        throw new ApiError(500, "9999", "FormPage 未声明字段 " + name);
    }

    /* ---- 修饰（作用于最近一个声明） ------------------------------ */

    /* 当前值：文本为回显，下拉为选中值。 */
    FormPage Val(string v) { this.last.value = v; return this; }

    FormPage Ph(string p) { this.last.ph = p; return this; }

    /* 最长/最短长度：渲染成 maxlength/minlength，校验同源。 */
    FormPage Max(int n) { this.last.max = n; return this; }

    FormPage Min(int n) { this.last.min = n; return this; }

    FormPage Req() { this.last.required = true; return this; }

    /* 输入跨满余列（.span；wide 双列布局下即整行）。 */
    FormPage Span() { this.last.span = true; return this; }

    FormPage Rows(int n) { this.last.areaRows = n; return this; }

    /* 正则校验（服务端单一来源；留空值不校验，配合 Req() 使用）。 */
    FormPage Pattern(string re) { this.last.pattern = re; return this; }

    /* 仅新增/仅编辑可见（初始密码、编辑提示）。 */
    FormPage OnlyNew() { this.last.onlyNew = true; return this; }

    FormPage OnlyEdit() { this.last.onlyEdit = true; return this; }

    /* 下拉首项空选项（value=0，如 未分配/未分类）。 */
    FormPage Blank(string label) { this.last.blank = label; return this; }

    /* ---- 校验：保存动作读请求 ------------------------------------ */

    /* 只对可见且有规则的字段校验；返回第一条错误文案（"" = 通过），
       控制器 Fail(400, "0004", err) 即可。走 InAny：adminUI 系前端以
       JSON 体提交表单，自研壳走表单编码。 */
    string Validate(AppController c) {
        bool isEdit = this.IsEdit();
        for (int i = 0; i < this.fs.Count; i = i + 1) {
            FormField f = this.fs[i];
            if (!this.Visible(isEdit, f)) { continue; }
            if (f.kind != "text" && f.kind != "pass" && f.kind != "area") { continue; }
            string v = c.InAny(f.name);
            if (f.required && v.Trim().Length == 0) {
                return Lang.T(f.label) + "不能为空";
            }
            /* 整数列：min/max 是数值界限，不是长度。 */
            if (f.type == "int") {
                long n = Filter.ToLong(v, 0);
                if (f.min > 0 && n < f.min) {
                    return Lang.T(f.label) + "不能小于 " + Convert.ToString(f.min);
                }
                if (f.max > 0 && n > f.max) {
                    return Lang.T(f.label) + "不能大于 " + Convert.ToString(f.max);
                }
                continue;
            }
            if (f.min > 0 && v.Length > 0 && v.Length < f.min) {
                return Lang.T(f.label) + "至少 " + Convert.ToString(f.min) + " 位";
            }
            if (f.max > 0 && v.Length > f.max) {
                return Lang.T(f.label) + "不能超过 " + Convert.ToString(f.max) + " 个字符";
            }
            if (f.pattern.Length > 0 && v.Length > 0 && !Regex.Matched(v, f.pattern)) {
                return Lang.T(f.label) + "格式不正确";
            }
        }
        return "";
    }

    /* ---- 渲染：表单体 -------------------------------------------- */

    /* 整段表单体 HTML 放入 d 的 formHtml（共享壳 {{{formHtml}}} 原样
       输出）、提交端点放入 formAction。 */
    void Render(ViewData d) {
        bool isEdit = this.IsEdit();
        StringBuilder sb = new StringBuilder();
        sb.Append("<input type=\"hidden\" name=\"id\" value=\""
            + ListPage.Esc(this.idValue) + "\">\n");
        sb.Append("<div class=\"form" + (this.wide ? " wide" : "") + "\">\n");
        for (int i = 0; i < this.fs.Count; i = i + 1) {
            FormField f = this.fs[i];
            if (!this.Visible(isEdit, f)) { continue; }
            if (f.kind == "hint") {
                sb.Append("  <div class=\"span hint\">" + ListPage.Esc(Lang.T(f.value)) + "</div>\n");
            } else if (f.kind == "text" || f.kind == "pass") {
                sb.Append("  <label" + (f.required ? " class=\"req\"" : "") + ">"
                    + ListPage.Esc(Lang.T(f.label)) + "</label>\n");
                sb.Append("  <input class=\"input" + (f.span ? " span" : "") + "\" type=\""
                    + (f.kind == "pass" ? "password" : "text") + "\" name=\"" + f.name + "\"");
                if (f.kind != "pass") {
                    sb.Append(" value=\"" + ListPage.Esc(f.value) + "\"");
                }
                if (f.type == "int") {
                    if (f.min > 0) { sb.Append(" min=\"" + Convert.ToString(f.min) + "\""); }
                    if (f.max > 0) { sb.Append(" max=\"" + Convert.ToString(f.max) + "\""); }
                } else {
                    if (f.max > 0) { sb.Append(" maxlength=\"" + Convert.ToString(f.max) + "\""); }
                    if (f.min > 0) { sb.Append(" minlength=\"" + Convert.ToString(f.min) + "\""); }
                }
                if (f.required) { sb.Append(" required"); }
                if (f.ph.Length > 0) { sb.Append(" placeholder=\"" + ListPage.Esc(Lang.T(f.ph)) + "\""); }
                sb.Append(">\n");
            } else if (f.kind == "area") {
                sb.Append("  <label" + (f.required ? " class=\"req\"" : "") + ">"
                    + ListPage.Esc(Lang.T(f.label)) + "</label>\n");
                sb.Append("  <textarea class=\"input" + (f.span ? " span" : "") + "\" name=\""
                    + f.name + "\"");
                if (f.areaRows > 0) { sb.Append(" rows=\"" + Convert.ToString(f.areaRows) + "\""); }
                if (f.max > 0) { sb.Append(" maxlength=\"" + Convert.ToString(f.max) + "\""); }
                if (f.required) { sb.Append(" required"); }
                sb.Append(">" + ListPage.Esc(f.value) + "</textarea>\n");
            } else {
                sb.Append("  <label>" + ListPage.Esc(Lang.T(f.label)) + "</label>\n");
                sb.Append("  <select class=\"input\" name=\"" + f.name + "\">");
                if (f.blank.Length > 0) {
                    sb.Append("<option value=\"0\">" + ListPage.Esc(Lang.T(f.blank)) + "</option>");
                }
                if (f.kind == "select") {
                    string rest = f.options;
                    while (rest.Length > 0) {
                        string pair = rest;
                        int comma = rest.IndexOf(",");
                        if (comma >= 0) { pair = rest.Substring(0, comma); rest = rest.Substring(comma + 1); }
                        else { rest = ""; }
                        int eq = pair.IndexOf("=");
                        if (eq <= 0) { continue; }
                        string v = pair.Substring(0, eq);
                        string label = pair.Substring(eq + 1);
                        sb.Append("<option value=\"" + ListPage.Esc(v) + "\""
                            + (v == f.value ? " selected" : "") + ">"
                            + ListPage.Esc(Lang.T(label)) + "</option>");
                    }
                } else if (f.rows != null) {
                    for (int k = 0; k < f.rows.Count; k = k + 1) {
                        string v = f.rows[k].Get("id");
                        sb.Append("<option value=\"" + ListPage.Esc(v) + "\""
                            + (v == f.value ? " selected" : "") + ">"
                            + ListPage.Esc(Lang.T(f.rows[k].Get("name"))) + "</option>");
                    }
                }
                sb.Append("</select>\n");
            }
        }
        sb.Append("</div>\n");
        d.Set("formHtml", sb.ToString());
        d.Set("formAction", this.action);
    }

    bool IsEdit() {
        return this.idValue.Length > 0 && this.idValue != "0";
    }

    bool Visible(bool isEdit, FormField f) {
        if (f.onlyNew) { return !isEdit; }
        if (f.onlyEdit) { return isEdit; }
        return true;
    }
}

/* 表单字段声明（见 FormPage）。 */
class FormField {
    string kind;
    string type;
    string label;
    string name;
    string value;
    string ph;
    string options;
    string blank;
    string pattern;
    List<StrMap> rows;
    int max;
    int min;
    int areaRows;
    bool required;
    bool span;
    bool onlyNew;
    bool onlyEdit;
}
