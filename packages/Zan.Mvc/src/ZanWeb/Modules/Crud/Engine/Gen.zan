using System;
using System.Data;
using System.Data.Orm;
using System.Text;
using System.Web;
using ZanWeb.Model;
using ZanWeb.Services;
using ZanWeb.Web;

namespace ZanWeb.Core;

/* 表设计器引擎：将设计（SysGenTable+SysGenColumn）生成 DDL 与 .zan 源码。标识符经 Safe() 校验，值使用参数绑定。 */
class Gen {
    /* 判断标识符是否安全：字母开头，仅含字母、数字与下划线（大小写
       均可——本包列名惯例是驼峰，如 sortOrder；与 stdlib QueryBuilder
       的 IsIdent 同口径，引号分号等注入通道一律拒绝）。 */
    static bool Safe(string name) {
        if (name == null) { return false; }
        int n = name.Length;
        if (n == 0 || n > 64) { return false; }
        for (int i = 0; i < n; i = i + 1) {
            string ch = name.Substring(i, 1);
            bool upper = ch >= "A" && ch <= "Z";
            bool lower = ch >= "a" && ch <= "z";
            bool digit = ch >= "0" && ch <= "9";
            if (i == 0 && !lower && !upper) { return false; }
            if (!lower && !upper && !digit && ch != "_") { return false; }
        }
        return true;
    }

    /* 源码标识符既不能逃逸目录，也不能是 Zan 关键字或生成类已有成员。 */
    static bool SafeCode(string name) {
        if (!Safe(name)) { return false; }
        string reserved = ",abstract,as,async,await,base,bool,break,case,catch,char,class,const,continue,decimal,default,delegate,do,double,else,enum,event,extern,false,finally,float,for,foreach,get,if,in,int,interface,internal,is,long,namespace,new,null,object,out,override,params,private,protected,public,return,set,short,static,string,struct,switch,this,throw,true,try,using,var,virtual,void,where,while,yield,ToRow,id,";
        return !reserved.Contains("," + name + ",");
    }

    /* 字面量只交给源码；HTML 文本另行按 HTML 语法编码。 */
    static string Literal(string text) {
        return text.Replace("\\", "\\\\").Replace("\"", "\\\"")
            .Replace("\r", "\\r").Replace("\n", "\\n").Replace("\t", "\\t");
    }

    static string Html(string text) {
        return text.Replace("&", "&amp;").Replace("<", "&lt;")
            .Replace(">", "&gt;").Replace("\"", "&quot;")
            .Replace("'", "&#39;");
    }

    /* 文档注释不能插入换行或伪造结束标记；它不是字符串字面量。 */
    static string Comment(string text) {
        return text.Replace("\r", " ").Replace("\n", " ")
            .Replace("&", "&amp;").Replace("<", "&lt;").Replace(">", "&gt;");
    }

    /* 从数据库恢复的旧设计也必须过同一入口校验，不能只依赖保存时检查。 */
    static bool Valid(SysGenTable t, List<SysGenColumn> cols) {
        if (!Safe(t.tableName) || t.tableName.ToLower().StartsWith("sys_")
            || !SafeCode(t.entityName) || !Safe(t.section)
            || t.entityName == "RowView" || t.entityName == "AdminController"
            || t.entityName == "AppController" || t.entityName == "Gen") { return false; }
        List<string> names = new List<string>();
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (!SafeCode(c.name) || names.Contains(c.name)
                || !(c.kind == "string" || c.kind == "text" || c.kind == "int"
                    || c.kind == "long" || c.kind == "decimal" || c.kind == "bool"
                    || c.kind == "datetime") || c.size < 0 || c.size > 4000) { return false; }
            names.Add(c.name);
        }
        return true;
    }

    /* 将设计列转为 DbColumnDef，自动加 identity id。 */
    static List<DbColumnDef> Columns(List<SysGenColumn> cols) {
        List<DbColumnDef> defs = new List<DbColumnDef>();
        defs.Add(DbColumnDef.Identity("id"));
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id") { continue; }
            DbColumnDef d = DbColumnDef.Of(c.name, c.kind).WithSize(c.size)
                .WithNull(c.nullable == 1);
            if (c.defValue.Length > 0) { d = d.WithDefault(c.defValue); }
            defs.Add(d);
        }
        return defs;
    }

    /* 建表或追加设计中有而表缺失的列，不删列不改类型。 */
    static async int Migrate(IDbConnection db, SysGenTable t, List<SysGenColumn> cols) {
        return await DbSchema.MigrateAsync(db, t.tableName, Columns(cols));
    }

    /* ---- 源码生成 ---- */

    /* 设计列类型到 Zan 类型的映射。 */
    static string ZanType(string kind) {
        if (kind == "int" || kind == "bool") { return "int"; }
        if (kind == "long" || kind == "datetime") { return "long"; }
        if (kind == "decimal") { return "double"; }
        return "string";
    }

    /* 设计器字段类型 → 列表展示形态（见 ListPage.Col）。 */
    static string ColKind(string kind) {
        if (kind == "int" || kind == "long" || kind == "decimal") { return "num"; }
        if (kind == "datetime") { return "time"; }
        if (kind == "text") { return "muted"; }
        return "text";
    }

    /* 生成实体类源码。 */
    static string ModelSource(SysGenTable t, List<SysGenColumn> cols) {
        StringBuilder b = new StringBuilder();
        b.Append(ZanHeader());
        b.Append("using System;\nusing System.Data.Orm;\nusing ZanWeb.Web;\n\nnamespace ZanWeb.Model.Gen;\n\n");
        b.Append("/// <summary>" + Comment(t.title) + "。由表设计器生成，可直接修改。</summary>\n");
        b.Append("[Table(Name = \"" + t.tableName + "\")]\n");
        b.Append("class " + t.entityName + " : RowView {\n");
        b.Append("    [Column(IsIdentity = true)]\n    int id;\n");
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id") { continue; }
            b.Append("\n");
            if (c.label.Length > 0) {
                b.Append("    /// <summary>" + Comment(c.label) + "</summary>\n");
            }
            if (c.kind == "string") {
                b.Append("    [Column(StringLength = "
                    + Convert.ToString(Size(c)) + ")]\n");
            }
            b.Append("    " + ZanType(c.kind) + " " + c.name + ";\n");
        }
        /* 视图行自述投影：管理列表与前台列表的键集并集，datetime 出人读日。 */
        b.Append("\n    public void ToRow(StrMap row) {\n");
        b.Append("        row.Set(\"id\", Convert.ToString(this.id));\n");
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id" || c.inList != 1) { continue; }
            if (c.kind == "datetime") {
                b.Append("        row.Set(\"" + c.name
                    + "\", Fmt.Day(this." + c.name + "));\n");
            } else if (c.kind == "bool") {
                b.Append("        if (this." + c.name
                    + " == 1) { row.Set(\"" + c.name + "\", \"1\"); }\n");
            } else if (ZanType(c.kind) == "string") {
                b.Append("        row.Set(\"" + c.name + "\", this."
                    + c.name + ");\n");
            } else {
                b.Append("        row.Set(\"" + c.name
                    + "\", Convert.ToString(this." + c.name + "));\n");
            }
        }
        /* 第一个 text/长文本出摘要；没有就不出。 */
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.kind == "text" && c.name != "id") {
                b.Append("        row.Set(\"summary\", Prose.Excerpt(this."
                    + c.name + ", 120));\n");
                break;
            }
        }
        b.Append("    }\n");
        b.Append("}\n");
        return b.ToString();
    }

    static int Size(SysGenColumn c) {
        if (c.size > 0) { return c.size; }
        return 255;
    }

    /* 生成管理控制器源码（列表/表单/保存/删除），命名与路由一致。 */
    /* 生成模块的 URL 路径（section/表名），侧边栏共享此 URL。 */
    static string Route(SysGenTable t) {
        string sec = t.section;
        if (!Safe(sec)) { sec = "content"; }
        return sec + "/" + t.tableName.Replace("_", "");
    }

    /* 设计的默认排序列：必须是设计里真实存在的列（id 不在列清单里，单独放行），否则回落 id。 */
    static string OrderCol(SysGenTable t, List<SysGenColumn> cols) {
        if (t.orderColumn == "id") { return "id"; }
        if (SafeCode(t.orderColumn)) {
            for (int i = 0; i < cols.Count; i = i + 1) {
                if (cols[i].name == t.orderColumn) { return t.orderColumn; }
            }
        }
        return "id";
    }

    /* 关联列的取值/标签列名：设计器默认 id/name，非法配置回落 id——
       这些名字要进 emitted 的 DbTable 查询，不能带着注入通道出去。 */
    static string RelValue(SysGenColumn c) {
        if (SafeCode(c.relValue)) { return c.relValue; }
        return "id";
    }

    static string RelLabel(SysGenColumn c) {
        if (SafeCode(c.relLabel)) { return c.relLabel; }
        return "id";
    }

    /* 关联下拉只在 relTable 是本设计器里的一张表时才服务端喂数；
       指向陌生表时没有可靠的标签列，退回普通输入框。 */
    static bool RelDesigned(SysGenColumn c, List<SysGenTable> designed) {
        if (c.relTable.Length == 0 || !Safe(c.relTable)) { return false; }
        return DesignedOf(designed, c.relTable) != null;
    }

    /* 按表名找设计行；designed 传本设计器的全部表（Pick 需要对方的路由）。 */
    static SysGenTable DesignedOf(List<SysGenTable> designed, string tableName) {
        for (int i = 0; i < designed.Count; i = i + 1) {
            if (designed[i].tableName == tableName) { return designed[i]; }
        }
        return null;
    }

    /* 选项端点与关联下拉的标签列：显式 labelColumn 必须是设计里真实存在的
       string 列；否则按 name→title→首个 string 列探测，全无则回落 id。 */
    static string LabelCol(SysGenTable t, List<SysGenColumn> cols) {
        if (SafeCode(t.labelColumn) && HasStringCol(cols, t.labelColumn)) {
            return t.labelColumn;
        }
        if (HasStringCol(cols, "name")) { return "name"; }
        if (HasStringCol(cols, "title")) { return "title"; }
        for (int i = 0; i < cols.Count; i = i + 1) {
            if (cols[i].name != "id" && cols[i].kind == "string") { return cols[i].name; }
        }
        return "id";
    }

    static bool HasStringCol(List<SysGenColumn> cols, string name) {
        for (int i = 0; i < cols.Count; i = i + 1) {
            if (cols[i].name == name && cols[i].kind == "string") { return true; }
        }
        return false;
    }

    /* 筛选算子的生效值：有选项源的列（关联/字典/布尔）一律下拉或远程搜索，
       时间列恒为区间选择；其余按 filterOp（like/eq/range），不合法值与 auto
       时按类型回落——文本模糊、数值精确。select 无选项源时没有意义，同样回落。 */
    static string FilterOpOf(SysGenColumn c, List<SysGenTable> designed) {
        if (RelDesigned(c, designed)) { return "pick"; }
        if (c.dictType.Length > 0 && Safe(c.dictType)) { return "select"; }
        if (c.kind == "bool") { return "select"; }
        if (c.kind == "datetime") { return "time"; }
        string op = c.filterOp == null ? "" : c.filterOp;
        if (op != "like" && op != "eq" && op != "select" && op != "range") { op = ""; }
        if (op == "select") { op = ""; }
        if (op.Length == 0) { op = ZanType(c.kind) == "string" ? "like" : "eq"; }
        if (op == "like" && ZanType(c.kind) != "string") { op = "eq"; }
        if (op == "range" && ZanType(c.kind) == "string") { op = "like"; }
        return op;
    }

    /* 列表页签列：须为字典列或布尔列，否则视为未启用（设计行脏数据在此兜底）。 */
    static SysGenColumn TabColOf(SysGenTable t, List<SysGenColumn> cols) {
        string name = t.tabColumn == null ? "" : t.tabColumn.Trim();
        if (name.Length == 0) { return null; }
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == name) {
                if (c.kind == "bool" || (c.dictType.Length > 0 && Safe(c.dictType))) {
                    return c;
                }
                return null;
            }
        }
        return null;
    }

    /* 列表列宽只放行「纯数字+px/em/%」的紧凑形态（≤16 字符），其余按类型默认。 */
    static string ColWidth(SysGenColumn c) {
        return WidthOf(c.listWidth == null ? "" : c.listWidth);
    }

    static string WidthOf(string w) {
        if (w.Length == 0 || w.Length > 16) { return ""; }
        int n = 0;
        while (n < w.Length) {
            string ch = w.Substring(n, 1);
            if (ch < "0" || ch > "9") { break; }
            n = n + 1;
        }
        if (n == 0) { return ""; }
        string unit = w.Substring(n);
        if (unit != "px" && unit != "em" && unit != "%") { return ""; }
        return w;
    }

    /* 页大小钳到 1~200；未配置（≤0）视为缺省 20。 */
    static int PageSizeOf(SysGenTable t) {
        int n = t.pageSize;
        if (n <= 0) { return 20; }
        if (n > 200) { return 200; }
        return n;
    }

    /* 生成时间戳：可辨识产物新旧（adminUI 经验——怀疑配置与产物漂移时先看它）。 */
    static string Stamp() {
        return Fmt.Stamp(WebApp.NowSeconds());
    }

    static string ZanHeader() {
        return "/* 由表设计器生成于 " + Stamp()
            + "，重新生成会覆盖本文件；可直接修改。 */\n";
    }

    static string HtmlHeader() {
        return "<!-- 由表设计器生成于 " + Stamp()
            + "；可直接修改，重新生成会覆盖本文件。 -->\n";
    }

    static string ControllerSource(SysGenTable t, List<SysGenColumn> cols,
        List<SysGenTable> designed) {
        string cls = t.entityName + "Controller";
        string mdl = "ZanWeb.Model.Gen." + t.entityName;
        string route = Route(t);
        string orderCol = OrderCol(t, cols);
        string orderCall = "OrderBy(a => a." + orderCol + ")";
        if (t.orderDesc == 1) { orderCall = "OrderByDescending(a => a." + orderCol + ")"; }
        bool hasDict = false;
        bool hasRelLabel = false;
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id") { continue; }
            if (c.dictType.Length > 0 && Safe(c.dictType)) { hasDict = true; }
            if (RelDesigned(c, designed)) { hasRelLabel = true; }
        }
        /* 页签列与菜单图标：菜单图标仅字符兜底，页签列的字典/布尔校验在 TabColOf。 */
        SysGenColumn tabC = TabColOf(t, cols);
        string tabCol = tabC == null ? "" : tabC.name;
        string menuIcon = t.menuIcon == null ? "" : t.menuIcon.Trim();
        /* 动作开关：关闭的动作不生成端点，列表不出对应入口（增/改/删/菜单）。 */
        bool hasCreate = t.hasCreate == 1;
        bool hasEdit = t.hasEdit == 1;
        bool hasDelete = t.hasDelete == 1;
        bool inMenu = t.menuEnabled == 1;
        StringBuilder b = new StringBuilder();
        b.Append(ZanHeader());
        b.Append("using System;\nusing System.Data;\nusing System.Data.Orm;\n");
        b.Append("using System.Json;\n");
        b.Append("using System.Web;\nusing ZanWeb.Core;\n");
        b.Append("using ZanWeb.Dao;\nusing ZanWeb.Model;\n");
        b.Append("using ZanWeb.Security;\nusing ZanWeb.Web;\nusing ZanWeb.Services;\n\n");
        b.Append("namespace ZanWeb.Admin;\n\n");
        b.Append("/// <summary>" + Comment(t.title)
            + " 管理。由表设计器生成，可直接修改。</summary>\n");
        b.Append("[Route(\"admin/" + route + "/[action]\")]\n");
        b.Append("[Custom(Authorization = CustomAuthorization.Grant)]\n");
        b.Append("[Description(\"" + Literal(t.title) + "\")]\n");
        b.Append("class " + cls + " : AdminController {\n");

        /* 本屏唯一声明：列、筛选、行内写动作白名单。字典与关联的选项是运行时
           数据，按请求查好拼进声明；设计器元数据在生成期展开——改列回到设计器
           重新生成即可。 */
        b.Append("    async ListPage Screen() {\n");
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id" || (c.inList != 1 && c.inFilter != 1)) { continue; }
            /* 字典列的选项是运行时数据（列表 Tag 与筛选 Select 都吃它），按请求
               查好拼进声明；关联筛选走 options 端点远程搜索（Pick），不预载。 */
            if (c.dictType.Length > 0 && Safe(c.dictType)) {
                b.Append("        string " + c.name + "Opts = \"\";\n");
                b.Append("        List<SysDictItem> " + c.name
                    + "Items = await new SysDictItemDao(this).ByTypeCodeActive(\""
                    + Literal(c.dictType) + "\");\n");
                b.Append("        for (int i = 0; i < " + c.name
                    + "Items.Count; i = i + 1) {\n");
                b.Append("            if (" + c.name
                    + "Opts.Length > 0) { " + c.name + "Opts = " + c.name + "Opts + \",\"; }\n");
                b.Append("            " + c.name + "Opts = " + c.name + "Opts + " + c.name
                    + "Items[i].value + \"=\" + " + c.name + "Items[i].label;\n");
                b.Append("        }\n");
            }
        }
        b.Append("        return ListPage.Of()\n");
        b.Append("            .Col(\"id\", \"ID\", \"num\", \"56px\")\n");
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id" || c.inList != 1) { continue; }
            string width = ColWidth(c);
            if (width.Length == 0) {
                if (ColKind(c.kind) == "num") { width = "90px"; }
                if (c.kind == "datetime") { width = "130px"; }
            }
            string label = Literal(LabelOf(c));
            bool dictFed = c.dictType.Length > 0 && Safe(c.dictType);
            bool relFed = RelDesigned(c, designed);
            if (c.kind == "bool") {
                b.Append("            .Tag(\"" + c.name + "\", \"" + label
                    + "\", \"1=是|ok,0=否|off\", \"" + width + "\")\n");
            } else if (dictFed) {
                b.Append("            .Tag(\"" + c.name + "\", \"" + label + "\", " + c.name
                    + "Opts, \"" + width + "\")\n");
            } else if (relFed) {
                b.Append("            .Col(\"" + c.name + "Name\", \"" + label
                    + "\", \"text\", \"" + width + "\")\n");
            } else {
                b.Append("            .Col(\"" + c.name + "\", \"" + label
                    + "\", \"" + ColKind(c.kind) + "\", \"" + width + "\")\n");
            }
        }
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id" || c.inFilter != 1) { continue; }
            if (tabCol.Length > 0 && c.name == tabCol) { continue; }
            string label = Literal(LabelOf(c));
            bool dictFed = c.dictType.Length > 0 && Safe(c.dictType);
            string op = FilterOpOf(c, designed);
            if (op == "pick") {
                SysGenTable rel = DesignedOf(designed, c.relTable);
                b.Append("            .Pick(\"" + label + "\", \"" + c.name + "\", \""
                    + c.name + "\", \"/admin/" + Route(rel) + "/options\")\n");
            } else if (op == "select") {
                string opts = c.kind == "bool" ? "\"1=是,0=否\"" : c.name + "Opts";
                b.Append("            .Select(\"" + label + "\", \"" + c.name + "\", \""
                    + c.name + "\", " + opts + ")\n");
            } else if (op == "time") {
                b.Append("            .Time(\"" + label + "\", \"" + c.name + "\", \""
                    + c.name + "\")\n");
            } else if (op == "range") {
                b.Append("            .Text(\"" + label + " 从\", \"" + c.name
                    + "From\", \"" + c.name + "\", \"" + label + " 下限\")\n");
                b.Append("            .Text(\"" + label + " 到\", \"" + c.name
                    + "To\", \"" + c.name + "\", \"" + label + " 上限\")\n");
            } else if (op == "eq") {
                b.Append("            .Text(\"" + label + "\", \"" + c.name + "\", \""
                    + c.name + "\", \"" + label + " 精确值\")\n");
            } else {
                b.Append("            .Text(\"" + label + "\", \"" + c.name + "\", \""
                    + c.name + "\", \"" + label + " 模糊搜索\")\n");
            }
        }
        if (hasCreate) {
            b.Append("            .TbarAdd(\"新增\", \"/admin/" + route + "/form\")\n");
        }
        if (hasDelete) {
            b.Append("            .TbarDelete(\"/admin/" + route + "/batchdelete\")\n");
        }
        if (hasEdit) {
            b.Append("            .OpsEdit(\"/admin/" + route + "/form\")\n");
        }
        if (hasDelete) {
            b.Append("            .OpsDel(\"/admin/" + route + "/delete\", \"确定删除吗？\")\n");
        }
        b.Append("            .Table(\"" + t.tableName + "\")\n");
        b.Append("            .EditFields(\"");
        string edits = "";
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            /* 行内编辑是编辑的快捷通道：inEdit 且未显式关行内（inQuick），
               字典/关联/时间列的语义行内控件表达不了，恒不进白名单。 */
            if (c.name == "id" || c.inEdit != 1 || c.inQuick != 1) { continue; }
            bool fed = (c.dictType.Length > 0 && Safe(c.dictType))
                || RelDesigned(c, designed);
            if (fed || c.kind == "datetime") { continue; }
            if (edits.Length > 0) { edits = edits + ","; }
            string ft = "text";
            if (c.kind == "int" || c.kind == "long") { ft = "int"; }
            edits = edits + c.name + ":" + ft;
        }
        b.Append(edits + "\")\n");
        b.Append("            ;\n    }\n");

        /* 选项端点（data-pick 契约）：?id= 单条回显、?kw= 标签包含匹配，
           最多 20 条；标签列按 labelColumn 或探测列。关联筛选的远程搜索打这里。 */
        string labelCol = LabelCol(t, cols);
        b.Append("\n    [HttpGet]\n    [Custom(Perm = PermBit.View)]\n");
        b.Append("    [Description(\"" + Literal(t.title) + "选项\")]\n");
        b.Append("    async void Options() {\n");
        b.Append("        string kw = this.In(\"kw\").Trim();\n");
        b.Append("        string idv = this.In(\"id\").Trim();\n");
        b.Append("        DbTable t = DbTable.Of(this.Held(), \"" + t.tableName + "\");\n");
        b.Append("        if (idv.Length > 0) {\n");
        b.Append("            DbResult one = await t.Query().WhereEq(\"id\", Filter.ToLong(idv, 0))\n");
        b.Append("                .Limit(1).ToResultAsync();\n");
        b.Append("            JsonValue row = JsonValue.NewObject();\n");
        b.Append("            if (one != null && one.RowCount() > 0) {\n");
        b.Append("                row.Set(\"id\", JsonValue.NewInt(Filter.ToInt(idv, 0)));\n");
        b.Append("                row.Set(\"label\", JsonValue.NewStr(one.GetString(0, one.GetColumnIndex(\""
            + labelCol + "\"))));\n");
        b.Append("            }\n");
        b.Append("            this.Ctx().Api(Codes.Ok, \"ok\", row.ToJson());\n");
        b.Append("            return;\n        }\n");
        b.Append("        DbTableQuery q = t.Query();\n");
        b.Append("        if (kw.Length > 0) { q = q.WhereContains(\"" + labelCol + "\", kw); }\n");
        b.Append("        DbResult rows = await q.OrderBy(\"" + labelCol
            + "\").Limit(20).ToResultAsync();\n");
        b.Append("        JsonValue arr = JsonValue.NewArray();\n");
        b.Append("        if (rows != null) {\n");
        b.Append("            int idc = rows.GetColumnIndex(\"id\");\n");
        b.Append("            int lbc = rows.GetColumnIndex(\"" + labelCol + "\");\n");
        b.Append("            for (int i = 0; i < rows.RowCount(); i = i + 1) {\n");
        b.Append("                JsonValue o = JsonValue.NewObject();\n");
        b.Append("                o.Set(\"id\", JsonValue.NewInt(rows.GetInt(i, idc)));\n");
        b.Append("                o.Set(\"label\", JsonValue.NewStr(rows.GetString(i, lbc)));\n");
        b.Append("                arr.Append(o);\n");
        b.Append("            }\n");
        b.Append("        }\n");
        b.Append("        this.Ctx().Api(Codes.Ok, \"ok\", arr.ToJson());\n");
        b.Append("    }\n");

        if (hasDict) {
            b.Append("\n    /* 字典值合法性：空值看必填，非空必须命中该字典类型的活动项。 */\n");
            b.Append("    async string CheckDict(string typeCode, string label, string value, bool required) {\n");
            b.Append("        if (value.Length == 0) { return required ? \"请选择\" + label : \"\"; }\n");
            b.Append("        List<SysDictItem> items = await new SysDictItemDao(this).ByTypeCodeActive(typeCode);\n");
            b.Append("        for (int i = 0; i < items.Count; i = i + 1) {\n");
            b.Append("            if (items[i].value == value) { return \"\"; }\n");
            b.Append("        }\n");
            b.Append("        return label + \" 的值不在选项内\";\n");
            b.Append("    }\n");
        }

        b.Append("\n    [HttpGet]\n    [Route(\"/admin/" + route + "\")]\n");
        if (!inMenu) {
            b.Append("    [Custom(IsMenu = false, Perm = PermBit.View)]\n");
        } else if (menuIcon.Length > 0) {
            b.Append("    [Custom(IsMenu = true, Perm = PermBit.View, Icon = \""
                + Literal(menuIcon) + "\")]\n");
        } else {
            b.Append("    [Custom(IsMenu = true, Perm = PermBit.View)]\n");
        }
        b.Append("    [Description(\"" + Literal(t.title) + "列表\")]\n");
        b.Append("    async void Index() {\n");
        b.Append("        ViewData d = await this.Layout(\"" + Literal(t.title) + "\");\n");
        b.Append("        if (!this.DbReady()) { d.Set(\"dbDown\", \"1\"); this.Page(d); return; }\n");
        b.Append("        ListPage lp = await this.Screen();\n");
        if (tabC != null) {
            /* 列表状态页签：选项随设计（字典项或 是/否），选中态随请求回显。 */
            b.Append("        List<StrMap> tabItems = d.AddList(\"tabItems\");\n");
            b.Append("        string tabCur = this.InAny(\"" + tabCol + "\").Trim();\n");
            b.Append("        d.Set(\"tabCol\", \"" + tabCol + "\");\n");
            b.Append("        StrMap tabAll = new StrMap();\n");
            b.Append("        tabAll.Set(\"value\", \"\"); tabAll.Set(\"label\", \"全部\");\n");
            b.Append("        if (tabCur.Length == 0) { tabAll.Set(\"selected\", \"1\"); }\n");
            b.Append("        tabItems.Add(tabAll);\n");
            if (tabC.kind == "bool") {
                b.Append("        StrMap tabY = new StrMap();\n");
                b.Append("        tabY.Set(\"value\", \"1\"); tabY.Set(\"label\", \"是\");\n");
                b.Append("        if (tabCur == \"1\") { tabY.Set(\"selected\", \"1\"); }\n");
                b.Append("        tabItems.Add(tabY);\n");
                b.Append("        StrMap tabN = new StrMap();\n");
                b.Append("        tabN.Set(\"value\", \"0\"); tabN.Set(\"label\", \"否\");\n");
                b.Append("        if (tabCur == \"0\") { tabN.Set(\"selected\", \"1\"); }\n");
                b.Append("        tabItems.Add(tabN);\n");
            } else {
                b.Append("        List<SysDictItem> tabDict = await new SysDictItemDao(this).ByTypeCodeActive(\""
                    + Literal(tabC.dictType) + "\");\n");
                b.Append("        for (int i = 0; i < tabDict.Count; i = i + 1) {\n");
                b.Append("            StrMap o = new StrMap();\n");
                b.Append("            o.Set(\"value\", Convert.ToString(tabDict[i].value));\n");
                b.Append("            o.Set(\"label\", tabDict[i].label);\n");
                b.Append("            if (tabCur == Convert.ToString(tabDict[i].value)) { o.Set(\"selected\", \"1\"); }\n");
                b.Append("            tabItems.Add(o);\n");
                b.Append("        }\n");
            }
        }
        if (t.exportEnabled == 1) {
            b.Append("        d.Set(\"exportUrl\", \"/admin/" + route + "/export\");\n");
        }
        b.Append("        List<OrmCond> conds = lp.Collect(this);\n");
        b.Append("        ListQuery q = this.Paged(\"" + orderCol + "\", "
            + Convert.ToString(PageSizeOf(t)) + ");\n");
        /* 筛选局部变量 + WhereIf：与 ListPage.Collect 语义逐条对齐，共享发射。 */
        string whereLines = FilterEmit(b, cols, designed, tabCol);
        b.Append("        int total = await this." + t.entityName + "\n");
        b.Append(whereLines);
        b.Append("            .CountAsync();\n");
        b.Append("        List<" + mdl + "> rows = await this." + t.entityName + "\n");
        b.Append(whereLines);
        b.Append("            ." + orderCall + "\n");
        b.Append("            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();\n");
        b.Append("        List<StrMap> items = d.AddList(\"rows\");\n");
        b.Append("        Rows.Project(rows, items);\n");
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id" || c.inList != 1 || !RelDesigned(c, designed)) { continue; }
            b.Append("        StrMap " + c.name + "Names = new StrMap();\n");
            b.Append("        DbResult " + c.name + "Rows = await DbTable.Of(this.Held(), \""
                + c.relTable + "\").Query()\n");
            b.Append("            .OrderBy(\"" + RelLabel(c)
                + "\").Limit(500).ToResultAsync();\n");
            b.Append("        if (" + c.name + "Rows != null) {\n");
            b.Append("            int " + c.name + "V = " + c.name
                + "Rows.GetColumnIndex(\"" + RelValue(c) + "\");\n");
            b.Append("            int " + c.name + "L = " + c.name
                + "Rows.GetColumnIndex(\"" + RelLabel(c) + "\");\n");
            b.Append("            if (" + c.name + "V >= 0 && " + c.name + "L >= 0) {\n");
            b.Append("                for (int i = 0; i < " + c.name
                + "Rows.RowCount(); i = i + 1) {\n");
            b.Append("                    " + c.name + "Names.Set(" + c.name
                + "Rows.GetString(i, " + c.name + "V), " + c.name + "Rows.GetString(i, "
                + c.name + "L));\n");
            b.Append("                }\n");
            b.Append("            }\n");
            b.Append("        }\n");
            b.Append("        for (int i = 0; i < items.Count; i = i + 1) {\n");
            b.Append("            items[i].Set(\"" + c.name + "Name\", " + c.name
                + "Names.Get(items[i].Get(\"" + c.name + "\")));\n");
            b.Append("        }\n");
        }
        b.Append("        string path = this.Ctx().path;\n");
        b.Append("        bool canCreate = await this.Can(PermBit.Create);\n");
        b.Append("        bool canUpdate = await this.Can(PermBit.Update);\n");
        b.Append("        bool canDelete = await this.Can(PermBit.Delete);\n");
        b.Append("        lp.Screen(this, d, path, \"/admin/" + route
            + "\", conds, q, total, items, canCreate, canUpdate, canDelete);\n");
        b.Append("        this.Page(d);\n    }\n\n");

        if (t.exportEnabled == 1) {
            /* CSV 导出：同款筛选与排序，Take(50000) 兜底；字典/关联翻译成标签。 */
            b.Append("    [HttpGet]\n    [Custom(Perm = PermBit.Export)]\n");
            b.Append("    [Description(\"导出" + Literal(t.title) + "CSV\")]\n");
            b.Append("    async void Export() {\n");
            string whereLines = FilterEmit(b, cols, designed, tabCol);
            b.Append("        List<" + mdl + "> rows = await this." + t.entityName + "\n");
            b.Append(whereLines);
            b.Append("            ." + orderCall + "\n");
            b.Append("            .Take(50000).ToListAsync();\n");
            for (int i = 0; i < cols.Count; i = i + 1) {
                SysGenColumn c = cols[i];
                if (c.name == "id" || c.inList != 1) { continue; }
                if (c.dictType.Length > 0 && Safe(c.dictType)) {
                    b.Append("        StrMap " + c.name + "Map = new StrMap();\n");
                    b.Append("        List<SysDictItem> " + c.name
                        + "Items = await new SysDictItemDao(this).ByTypeCodeActive(\""
                        + Literal(c.dictType) + "\");\n");
                    b.Append("        for (int i = 0; i < " + c.name
                        + "Items.Count; i = i + 1) {\n");
                    b.Append("            " + c.name + "Map.Set(Convert.ToString("
                        + c.name + "Items[i].value), " + c.name + "Items[i].label);\n");
                    b.Append("        }\n");
                } else if (RelDesigned(c, designed)) {
                    b.Append("        StrMap " + c.name + "Names = new StrMap();\n");
                    b.Append("        DbResult " + c.name + "Rows = await DbTable.Of(this.Held(), \""
                        + c.relTable + "\").Query()\n");
                    b.Append("            .OrderBy(\"" + RelLabel(c)
                        + "\").Limit(500).ToResultAsync();\n");
                    b.Append("        if (" + c.name + "Rows != null) {\n");
                    b.Append("            int " + c.name + "V = " + c.name
                        + "Rows.GetColumnIndex(\"" + RelValue(c) + "\");\n");
                    b.Append("            int " + c.name + "L = " + c.name
                        + "Rows.GetColumnIndex(\"" + RelLabel(c) + "\");\n");
                    b.Append("            if (" + c.name + "V >= 0 && " + c.name + "L >= 0) {\n");
                    b.Append("                for (int i = 0; i < " + c.name
                        + "Rows.RowCount(); i = i + 1) {\n");
                    b.Append("                    " + c.name + "Names.Set(" + c.name
                        + "Rows.GetString(i, " + c.name + "V), " + c.name
                        + "Rows.GetString(i, " + c.name + "L));\n");
                    b.Append("                }\n");
                    b.Append("            }\n");
                    b.Append("        }\n");
                }
            }
            b.Append("        StringBuilder sb = new StringBuilder();\n");
            b.Append("        string head = \"\";\n");
            b.Append("        head = head + CsvCell(\"ID\");\n");
            for (int i = 0; i < cols.Count; i = i + 1) {
                SysGenColumn c = cols[i];
                if (c.name == "id" || c.inList != 1) { continue; }
                b.Append("        head = head + \",\" + CsvCell(\""
                    + Literal(LabelOf(c)) + "\");\n");
            }
            b.Append("        sb.Append(head + \"\\n\");\n");
            b.Append("        for (int i = 0; i < rows.Count; i = i + 1) {\n");
            b.Append("            string line = \"\";\n");
            b.Append("            line = line + CsvCell(Convert.ToString(rows[i].id));\n");
            for (int i = 0; i < cols.Count; i = i + 1) {
                SysGenColumn c = cols[i];
                if (c.name == "id" || c.inList != 1) { continue; }
                string v;
                if (c.kind == "bool") {
                    v = "(rows[i]." + c.name + " == 1 ? \"是\" : \"否\")";
                } else if (c.kind == "datetime") {
                    v = "(rows[i]." + c.name
                        + " > 0 ? Fmt.DayInput(rows[i]." + c.name + ") : \"\")";
                } else if (c.dictType.Length > 0 && Safe(c.dictType)) {
                    v = "CsvDict(" + c.name + "Map, Convert.ToString(rows[i]." + c.name + "))";
                } else if (RelDesigned(c, designed)) {
                    v = "CsvDict(" + c.name + "Names, Convert.ToString(rows[i]." + c.name + "))";
                } else {
                    v = "Convert.ToString(rows[i]." + c.name + ")";
                }
                b.Append("            line = line + \",\" + CsvCell(" + v + ");\n");
            }
            b.Append("            sb.Append(line + \"\\n\");\n");
            b.Append("        }\n");
            b.Append("        this.Ctx().Download(\"" + t.tableName
                + ".csv\", \"text/csv; charset=utf-8\", sb.ToString());\n");
            b.Append("    }\n\n");
            b.Append("    /* CSV 值：包裹引号防逗号/换行破行，内部引号翻倍。 */\n");
            b.Append("    static string CsvCell(string v) {\n");
            b.Append("        StringBuilder sb = new StringBuilder();\n");
            b.Append("        sb.Append(\"\\\"\");\n");
            b.Append("        for (int i = 0; i < v.Length; i = i + 1) {\n");
            b.Append("            string ch = v.Substring(i, 1);\n");
            b.Append("            if ((v[i] & 255) == 34) { sb.Append(\"\\\"\"); }\n");
            b.Append("            sb.Append(ch);\n");
            b.Append("        }\n");
            b.Append("        sb.Append(\"\\\"\");\n");
            b.Append("        return sb.ToString();\n");
            b.Append("    }\n\n");
            b.Append("    /* 字典/关联翻译：映射缺失时回落原始值。 */\n");
            b.Append("    static string CsvDict(StrMap m, string raw) {\n");
            b.Append("        string label = m.Get(raw);\n");
            b.Append("        if (label.Length > 0) { return label; }\n");
            b.Append("        return raw;\n");
            b.Append("    }\n\n");
        }

        /* 表格配置契约：本屏声明 → adminUI ZanTable 的 ListConfData JSON。 */
        b.Append("    [HttpGet]\n    [Custom(Perm = PermBit.View)]\n");
        b.Append("    [Description(\"" + Literal(t.title) + "表格配置\")]\n");
        b.Append("    async void Conf() {\n");
        b.Append("        CrudOps.Conf(this, await this.Screen());\n");
        b.Append("    }\n\n");

        if (hasEdit) {
            b.Append("    [HttpPost]\n    [Custom(Perm = PermBit.Update)]\n");
            b.Append("    [Description(\"编辑" + Literal(t.title) + "字段\")]\n");
            b.Append("    async void Field() {\n");
            b.Append("        int id = this.InInt(\"id\", 0);\n");
            b.Append("        " + mdl + " cur = await this." + t.entityName + ".Read(id);\n");
            b.Append("        List<int> allowed = new List<int>();\n");
            b.Append("        if (cur != null) { allowed.Add(id); }\n");
            b.Append("        await CrudOps.Field(this, await this.Screen(), \"" + Literal(t.title)
                + "\", this.In(\"field\").Trim(), this.In(\"value\"), allowed);\n");
            b.Append("    }\n\n");
        }

        if (hasDelete) {
            b.Append("    [HttpPost]\n    [Custom(Perm = PermBit.Delete)]\n");
            b.Append("    [Description(\"批量删除" + Literal(t.title) + "\")]\n");
            b.Append("    async void BatchDelete() {\n");
            b.Append("        await CrudOps.Delete(this, await this.Screen(),"
                + " this.Ids(\"ids\"), \"批量删除" + Literal(t.title) + "\");\n");
            b.Append("    }\n\n");
        }

        if (hasCreate || hasEdit) {
            b.Append("    [HttpGet]\n    [Custom(Perm = PermBit.Create | PermBit.Update)]\n");
            b.Append("    [Description(\"" + Literal(t.title) + "表单\")]\n");
            b.Append("    async void Form() {\n");
        b.Append("        int id = this.InInt(\"id\", 0);\n");
        b.Append("        if (!await this.Can(id > 0 ? (int)PermBit.Update : (int)PermBit.Create)) {\n");
        b.Append("            this.Fail(403, \"0403\", \"权限不足\"); return;\n        }\n");
        b.Append("        " + mdl + " e = null;\n");
        b.Append("        if (id > 0) {\n");
        b.Append("            e = await this." + t.entityName + ".Read(id);\n");
        b.Append("            if (e == null) { this.Fail(404, \"0404\", \"记录不存在\"); }\n");
        b.Append("        }\n");
        b.Append("        ViewData d = new ViewData();\n");
        b.Append("        d.Set(\"id\", Convert.ToString(id));\n");
        b.Append("        d.Set(id > 0 ? \"editing\" : \"creating\", \"1\");\n");
        b.Append("        d.Set(\"dialogTitle\", id > 0 ? \"编辑" + Literal(t.title)
            + "\" : \"新增" + Literal(t.title) + "\");\n");
        b.Append("        if (e != null) {\n");
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id" || c.inEdit != 1) { continue; }
            if (c.kind == "datetime") {
                b.Append("            d.Set(\"" + c.name + "\", e." + c.name
                    + " > 0 ? Fmt.DayInput(e." + c.name + ") : \"\");\n");
            } else if (ZanType(c.kind) == "string") {
                b.Append("            d.Set(\"" + c.name + "\", e." + c.name + ");\n");
            } else {
                b.Append("            d.Set(\"" + c.name
                    + "\", Convert.ToString(e." + c.name + "));\n");
            }
        }
        b.Append("        }\n");
        /* 字典/关联下拉的服务端喂数：选项行 {value,label,selected}；当前值不在
           选项集里时补 {name}None，视图用保留行显示原值，避免静默改数据。 */
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id" || (c.inCreate != 1 && c.inEdit != 1)) { continue; }
            bool dictFed = c.dictType.Length > 0 && Safe(c.dictType);
            bool relFed = RelDesigned(c, designed);
            if (!dictFed && !relFed) { continue; }
            string count = "";
            string vexpr = "";
            string lexpr = "";
            if (dictFed) {
                b.Append("        List<StrMap> " + c.name + "Opts = d.AddList(\"" + c.name + "Opts\");\n");
                b.Append("        List<SysDictItem> " + c.name
                    + "Items = await new SysDictItemDao(this).ByTypeCodeActive(\""
                    + Literal(c.dictType) + "\");\n");
                count = c.name + "Items.Count";
                vexpr = c.name + "Items[i].value";
                lexpr = c.name + "Items[i].label";
            } else {
                b.Append("        List<StrMap> " + c.name + "Opts = d.AddList(\"" + c.name + "Opts\");\n");
                b.Append("        DbResult " + c.name + "Rows = await DbTable.Of(this.Held(), \""
                    + c.relTable + "\").Query()\n");
                b.Append("            .OrderBy(\"" + RelLabel(c)
                    + "\").Limit(100).ToResultAsync();\n");
                b.Append("        int " + c.name + "N = 0;\n");
                b.Append("        int " + c.name + "V = -1;\n");
                b.Append("        int " + c.name + "L = -1;\n");
                b.Append("        if (" + c.name + "Rows != null) {\n");
                b.Append("            " + c.name + "N = " + c.name + "Rows.RowCount();\n");
                b.Append("            " + c.name + "V = " + c.name + "Rows.GetColumnIndex(\""
                    + RelValue(c) + "\");\n");
                b.Append("            " + c.name + "L = " + c.name + "Rows.GetColumnIndex(\""
                    + RelLabel(c) + "\");\n");
                b.Append("        }\n");
                count = c.name + "N";
                vexpr = c.name + "Rows.GetString(i, " + c.name + "V)";
                lexpr = c.name + "Rows.GetString(i, " + c.name + "L)";
            }
            b.Append("        bool " + c.name + "Hit = false;\n");
            b.Append("        for (int i = 0; i < " + count + "; i = i + 1) {\n");
            b.Append("            StrMap o = new StrMap();\n");
            b.Append("            o.Set(\"value\", Convert.ToString(" + vexpr + "));\n");
            b.Append("            o.Set(\"label\", " + lexpr + ");\n");
            b.Append("            if (e != null && Convert.ToString(" + vexpr
                + ") == Convert.ToString(e." + c.name + ")) {\n");
            b.Append("                o.Set(\"selected\", \"1\");\n");
            b.Append("                " + c.name + "Hit = true;\n");
            b.Append("            }\n");
            b.Append("            " + c.name + "Opts.Add(o);\n");
            b.Append("        }\n");
            b.Append("        if (e != null && !" + c.name + "Hit) { d.Set(\"" + c.name
                + "None\", \"1\"); }\n");
        }
        b.Append("        this.Dialog(d);\n    }\n\n");
        }

        if (hasCreate || hasEdit) {
            b.Append("    [HttpPost]\n    [Custom(Perm = PermBit.Create | PermBit.Update)]\n");
            b.Append("    [Description(\"保存" + Literal(t.title) + "\")]\n");
            b.Append("    async void Save() {\n");
            b.Append("        int id = this.InInt(\"id\", 0);\n");
            b.Append("        if (!await this.Can(id > 0 ? (int)PermBit.Update : (int)PermBit.Create)) {\n");
            b.Append("            this.Fail(403, \"0403\", \"权限不足\"); return;\n        }\n");
            /* 表级开关守卫：动作生成与否看组合，半开时另一侧请求在此拒绝。 */
            if (!hasCreate) {
                b.Append("        if (id == 0) { this.Fail(404, \"0404\", \"该表未开放新增\"); }\n");
            }
            if (!hasEdit) {
                b.Append("        if (id > 0) { this.Fail(404, \"0404\", \"该表未开放编辑\"); }\n");
            }
        b.Append("        " + mdl + " e = new " + mdl + "();\n");
        b.Append("        if (id > 0) {\n");
        b.Append("            " + mdl + " cur = await this." + t.entityName + ".Read(id);\n");
        b.Append("            if (cur == null) { this.Fail(404, \"0404\", \"记录不存在\"); }\n");
        b.Append("            e = cur;\n        }\n");
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id" || (c.inCreate != 1 && c.inEdit != 1)) { continue; }
            if (c.inCreate != 1) { b.Append("        if (id > 0) {\n"); }
            if (c.inEdit != 1) { b.Append("        if (id == 0) {\n"); }
            string zt = ZanType(c.kind);
            string label = Literal(LabelOf(c));
            bool dictFed = c.dictType.Length > 0 && Safe(c.dictType);
            bool relFed = RelDesigned(c, designed);
            if (c.kind == "datetime") {
                /* 日期列：入参是 YYYY-MM-DD 文本，ParseDay 转秒存整型列。 */
                b.Append("        string " + c.name + "Raw = this.In(\"" + c.name + "\").Trim();\n");
                if (c.required == 1) {
                    b.Append("        if (" + c.name + "Raw.Length == 0) { this.Fail(400, \"0400\", \"请填写"
                        + label + "\"); return; }\n");
                }
                b.Append("        if (" + c.name + "Raw.Length > 0) {\n");
                b.Append("            e." + c.name + " = Fmt.ParseDay(" + c.name + "Raw);\n");
                b.Append("            if (e." + c.name + " <= 0) { this.Fail(400, \"0400\", \""
                    + label + " 格式应为 YYYY-MM-DD\"); return; }\n");
                if (c.required != 1) {
                    b.Append("        } else { e." + c.name + " = 0; }\n");
                } else {
                    b.Append("        }\n");
                }
            } else if (zt == "string") {
                if (c.required == 1) {
                    b.Append("        e." + c.name + " = this.Need(\"" + c.name
                        + "\", \"" + label + "\");\n");
                } else {
                    b.Append("        e." + c.name + " = this.In(\"" + c.name + "\");\n");
                }
            } else if (zt == "int") {
                b.Append("        e." + c.name + " = this.InInt(\"" + c.name + "\", 0);\n");
            } else if (zt == "long") {
                b.Append("        e." + c.name + " = this.InLong(\"" + c.name + "\", 0);\n");
            } else {
                b.Append("        e." + c.name + " = this.InDouble(\"" + c.name + "\", 0.0);\n");
            }
            if (dictFed && c.kind != "bool") {
                string vexpr = zt == "string" ? "e." + c.name
                    : "Convert.ToString(e." + c.name + ")";
                b.Append("        string " + c.name + "Err = await this.CheckDict(\""
                    + Literal(c.dictType) + "\", \"" + label + "\", " + vexpr + ", "
                    + (c.required == 1 ? "true" : "false") + ");\n");
                b.Append("        if (" + c.name + "Err.Length > 0) { this.Fail(400, \"0400\", "
                    + c.name + "Err); return; }\n");
            }
            if (relFed) {
                string relCheck = "DbResult " + c.name + "Chk = await DbTable.Of(this.Held(), \""
                    + c.relTable + "\").Query()\n                .WhereEq(\""
                    + RelValue(c) + "\", ";
                if (zt == "string") {
                    b.Append("        if (e." + c.name + ".Length > 0) {\n");
                    b.Append("            " + relCheck + "e." + c.name
                        + ").Limit(1).ToResultAsync();\n");
                    b.Append("            if (" + c.name + "Chk == null || " + c.name
                        + "Chk.RowCount() == 0) { this.Fail(400, \"0400\", \"" + label
                        + " 所选记录不存在\"); return; }\n");
                    b.Append("        }");
                } else {
                    b.Append("        if (e." + c.name + " > 0) {\n");
                    b.Append("            long " + c.name + "Id = e." + c.name + ";\n");
                    b.Append("            " + relCheck + c.name + "Id).Limit(1).ToResultAsync();\n");
                    b.Append("            if (" + c.name + "Chk == null || " + c.name
                        + "Chk.RowCount() == 0) { this.Fail(400, \"0400\", \"" + label
                        + " 所选记录不存在\"); return; }\n");
                    b.Append("        }");
                }
                if (c.required == 1) {
                    b.Append(" else {\n            this.Fail(400, \"0400\", \"请选择" + label
                        + "\"); return;\n        }\n");
                } else {
                    b.Append("\n");
                }
            } else if (zt != "string" && c.kind != "datetime" && c.kind != "bool"
                && c.required == 1) {
                string zero = c.kind == "decimal" ? "0.0" : "0";
                b.Append("        if (e." + c.name + " == " + zero
                    + ") { this.Fail(400, \"0400\", \"请填写" + label + "\"); return; }\n");
            }
            if (c.inCreate != 1 || c.inEdit != 1) { b.Append("        }\n"); }
        }
        b.Append("        if (id > 0) {\n");
        bool hasEdit = false;
        for (int i = 0; i < cols.Count; i = i + 1) {
            if (cols[i].name != "id" && cols[i].inEdit == 1) { hasEdit = true; }
        }
        if (hasEdit) {
            b.Append("            int n = await this." + t.entityName + ".Update()\n");
            for (int i = 0; i < cols.Count; i = i + 1) {
                SysGenColumn c = cols[i];
                if (c.name == "id" || c.inEdit != 1) { continue; }
                b.Append("                .Set(a => a." + c.name + ", e." + c.name + ")\n");
            }
            b.Append("                .Where(a => a.id == id).ExecuteAffrowsAsync();\n");
        } else {
            b.Append("            int n = 0;\n");
        }
        b.Append("            await this.Note(\"编辑" + Literal(t.title)
            + "\", Convert.ToString(id), n > 0, \"\");\n");
        b.Append("            this.Saved(\"已保存\");\n            return;\n        }\n");
        b.Append("        int newId = await this." + t.entityName
            + ".Insert(e).ExecuteIdentityAsync();\n");
        b.Append("        await this.Note(\"新增" + Literal(t.title)
            + "\", Convert.ToString(newId), newId > 0, \"\");\n");
        b.Append("        this.Saved(\"已创建\");\n    }\n\n");
        }

        if (hasDelete) {
            b.Append("    [HttpPost]\n    [Custom(Perm = PermBit.Delete)]\n");
            b.Append("    [Description(\"删除" + Literal(t.title) + "\")]\n");
            b.Append("    async void Delete() {\n");
            b.Append("        int id = this.InInt(\"id\", 0);\n");
            b.Append("        int n = await this." + t.entityName
                + ".Delete().Where(a => a.id == id).ExecuteAffrowsAsync();\n");
            b.Append("        await this.Note(\"删除" + Literal(t.title)
                + "\", Convert.ToString(id), n > 0, \"\");\n");
            b.Append("        this.Saved(\"已删除\");\n    }\n");
        }
        b.Append("}\n");
        return b.ToString();
    }

    static string LabelOf(SysGenColumn c) {
        if (c.label.Length > 0) { return c.label; }
        return c.name;
    }

    /* 生成列表视图源码：表格由 ListPage.Screen 整段产出，视图剩壳；启用
       状态页签/导出时加对应工具行，都没启用则与平铺期形状完全一致。 */
    static string ListViewSource(SysGenTable t, List<SysGenColumn> cols) {
        SysGenColumn tabC = TabColOf(t, cols);
        bool hasExport = t.exportEnabled == 1;
        StringBuilder b = new StringBuilder();
        b.Append(HtmlHeader());
        b.Append("<div class=\"card\">\n");
        if (tabC != null) {
            b.Append("  <div class=\"gen-tabbar\" data-tab-col=\"{{tabCol}}\">\n");
            b.Append("    {{#each tabItems}}<a class=\"gen-tab {{#if selected}}active{{/if}}\""
                + " href=\"#\" data-tab-val=\"{{value}}\">{{label}}</a>{{/each}}\n");
            b.Append("  </div>\n");
        }
        if (hasExport) {
            b.Append("  <div class=\"gen-actions\"><a class=\"btn sm\" href=\"{{exportUrl}}\""
                + " data-export>导出CSV</a></div>\n");
        }
        b.Append("  {{{screenHtml}}}\n</div>\n");
        return b.ToString();
    }

    /* 生成表单视图源码。下拉由服务端喂数（Form 动作构建 {value,label,selected}
       选项行），date/richtext/upload 不再掉进 number/兜底分支；字段按 tabGroup
       分桶，单桶平铺（与旧形状一致），多桶发页内页签。 */
    static string FormViewSource(SysGenTable t, List<SysGenColumn> cols,
        List<SysGenTable> designed) {
        string route = Route(t);
        List<string> groups = TabGroups(cols);
        StringBuilder b = new StringBuilder();
        b.Append(HtmlHeader());
        b.Append("<form data-submit action=\"/admin/" + route + "/save\">\n");
        b.Append("  <input type=\"hidden\" name=\"id\" value=\"{{id}}\">\n");
        if (groups.Count <= 1) {
            b.Append("  <div class=\"form\">\n");
            FormFields(b, cols, "", designed, "    ");
            b.Append("  </div>\n");
            b.Append("  <footer class=\"lay-footer\">\n"
                + "    <button class=\"btn\" type=\"button\" data-close>取消</button>\n"
                + "    <button class=\"btn primary\" type=\"submit\">保存</button>\n"
                + "  </footer>\n</form>\n");
            return b.ToString();
        }
        b.Append("  <div class=\"form-tabs\">\n");
        for (int g = 0; g < groups.Count; g = g + 1) {
            b.Append("    <button type=\"button\" class=\"form-tab"
                + (g == 0 ? " active" : "") + "\" data-pane=\""
                + Convert.ToString(g) + "\">" + Html(groups[g]) + "</button>\n");
        }
        b.Append("  </div>\n");
        for (int g = 0; g < groups.Count; g = g + 1) {
            b.Append("  <div class=\"form-pane" + (g == 0 ? " active" : "")
                + "\" data-pane=\"" + Convert.ToString(g) + "\">\n");
            b.Append("    <div class=\"form\">\n");
            FormFields(b, cols, groups[g], designed, "      ");
            b.Append("    </div>\n  </div>\n");
        }
        b.Append("  <footer class=\"lay-footer\">\n"
            + "    <button class=\"btn\" type=\"button\" data-close>取消</button>\n"
            + "    <button class=\"btn primary\" type=\"submit\">保存</button>\n"
            + "  </footer>\n</form>\n");
        return b.ToString();
    }

    /* 表单字段的分组序：按 tabGroup 首次出现排序，空组名归「基本信息」。 */
    static List<string> TabGroups(List<SysGenColumn> cols) {
        List<string> groups = new List<string>();
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id" || (c.inCreate != 1 && c.inEdit != 1)) { continue; }
            string g = c.tabGroup == null ? "" : c.tabGroup.Trim();
            if (g.Length == 0) { g = "基本信息"; }
            bool seen = false;
            for (int k = 0; k < groups.Count; k = k + 1) {
                if (groups[k] == g) { seen = true; break; }
            }
            if (!seen) { groups.Add(g); }
        }
        return groups;
    }

    /* 发射一组字段的表单控件；group 为 "" 表示全部（单桶平铺）。 */
    static void FormFields(StringBuilder b, List<SysGenColumn> cols,
        string group, List<SysGenTable> designed, string pad) {
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id" || (c.inCreate != 1 && c.inEdit != 1)) { continue; }
            string g = c.tabGroup == null ? "" : c.tabGroup.Trim();
            if (g.Length == 0) { g = "基本信息"; }
            if (group.Length > 0 && g != group) { continue; }
            if (c.inCreate != 1) { b.Append(pad + "{{#if editing}}\n"); }
            if (c.inEdit != 1) { b.Append(pad + "{{#if creating}}\n"); }
            b.Append(pad + "<label>" + Html(LabelOf(c)) + "</label>\n");
            bool fed = (c.dictType.Length > 0 && Safe(c.dictType))
                || RelDesigned(c, designed);
            if (fed) {
                /* 选项行由 Form 动作查好；保留行显示当前值，防止保存时静默改数据。 */
                b.Append(pad + "<select class=\"input\" name=\"" + c.name + "\">\n");
                b.Append(pad + "  {{#each " + c.name
                    + "Opts}}<option value=\"{{value}}\" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}\n");
                b.Append(pad + "  {{#if " + c.name + "None}}<option value=\"{{" + c.name
                    + "}}\" selected>{{" + c.name + "}}</option>{{/if}}\n");
                b.Append(pad + "</select>\n");
            } else if (c.widget == "date" || c.widget == "datetime"
                || c.kind == "datetime") {
                b.Append(pad + "<input class=\"input\" type=\"date\" name=\"" + c.name
                    + "\" value=\"{{" + c.name + "}}\">\n");
            } else if (c.widget == "switch" || c.kind == "bool") {
                b.Append(pad + "<select class=\"input\" name=\"" + c.name
                    + "\"><option value=\"{{" + c.name + "}}\" selected hidden>{{" + c.name
                    + "}}</option><option value=\"1\">是</option><option value=\"0\">否</option></select>\n");
            } else if (c.widget == "richtext" || c.widget == "textarea"
                || c.kind == "text") {
                string rows = c.widget == "richtext" ? "8" : "3";
                b.Append(pad + "<textarea class=\"input\" name=\"" + c.name
                    + "\" rows=\"" + rows + "\">{{" + c.name + "}}</textarea>\n");
            } else if (c.widget == "number" || ZanType(c.kind) != "string") {
                b.Append(pad + "<input class=\"input\" type=\"number\" name=\"" + c.name
                    + "\" value=\"{{" + c.name + "}}\">\n");
            } else if (c.widget == "upload") {
                b.Append(pad + "<input class=\"input\" name=\"" + c.name
                    + "\" value=\"{{" + c.name + "}}\" placeholder=\"媒体文件 URL\">\n");
            } else {
                b.Append(pad + "<input class=\"input\" name=\"" + c.name
                    + "\" value=\"{{" + c.name + "}}\">\n");
            }
            if (c.inCreate != 1 || c.inEdit != 1) { b.Append(pad + "{{/if}}\n"); }
        }
    }

    /* 生成数据访问网关（{Entity}Dao），与手写 DAO 结构一致。 */
    static string DaoSource(SysGenTable t, List<SysGenColumn> cols) {
        string ent = t.entityName;
        StringBuilder b = new StringBuilder();
        b.Append(ZanHeader());
        b.Append("using System;\nusing System.Data;\nusing System.Data.Orm;\n");
        b.Append("using ZanWeb.Model.Gen;\n\n");
        b.Append("namespace ZanWeb.Dao.Gen;\n\n");
        b.Append("/// <summary>" + Comment(t.title)
            + " 的数据网关。由表设计器生成，可直接修改。</summary>\n");
        b.Append("class " + ent + "Dao {\n");
        b.Append("    IDbConnection db;\n\n");
        b.Append("    " + ent + "Dao(IDbConnection db) {\n");
        b.Append("        this.db = db;\n    }\n\n");

        b.Append("    async " + ent + " ById(int id) {\n");
        b.Append("        return await this.db.Select<" + ent
            + ">().Where(a => a.id == id).FirstAsync();\n    }\n\n");

        b.Append("    async List<" + ent + "> All() {\n");
        b.Append("        return await this.db.Select<" + ent
            + ">().OrderByDescending(a => a.id).ToListAsync();\n    }\n\n");

        b.Append("    async int Count() {\n");
        b.Append("        return await this.db.Select<" + ent
            + ">().CountAsync();\n    }\n\n");

        b.Append("    async int Insert(" + ent + " e) {\n");
        b.Append("        return await this.db.Insert<" + ent
            + ">(e).ExecuteIdentityAsync();\n    }\n\n");

        b.Append("    async int Update(" + ent + " e) {\n");
        string sets = "";
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id") { continue; }
            sets = sets + "            .Set(a => a." + c.name + ", e." + c.name
                + ")\n";
        }
        if (sets.Length == 0) {
            b.Append("        return 0;\n    }\n\n");
        } else {
            b.Append("        return await this.db.Update<" + ent + ">()\n");
            b.Append(sets);
            b.Append("            .Where(a => a.id == e.id).ExecuteAffrowsAsync();\n");
            b.Append("    }\n\n");
        }

        b.Append("    async int Delete(int id) {\n");
        b.Append("        return await this.db.Delete<" + ent
            + ">().Where(a => a.id == id).ExecuteAffrowsAsync();\n    }\n}\n");
        return b.ToString();
    }

    /* 筛选局部变量 + WhereIf 链的共享发射（后台 Index 与 JSON Query 同款）：
       语义与 ListPage.Collect 逐条对齐（文本非空才拼条件、下拉跳过空串与 -1、
       时间/数值区间走 From/To 两端）；区间端点的守卫看原文长度，0 是合法边界。
       tabColumn 非空时该列强制精确值语义（列表页签点击即传该列值），且跳过
       常规筛选发射，避免同一列两个筛选入口。 */
    static string FilterEmit(StringBuilder b, List<SysGenColumn> cols,
        List<SysGenTable> designed, string tabColumn) {
        string whereLines = "";
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id") { continue; }
            if (tabColumn.Length > 0 && c.name == tabColumn) {
                if (c.kind == "bool" || c.kind == "long") {
                    string fp = c.kind == "long" ? "ToLong" : "ToInt";
                    string ft = c.kind == "long" ? "long" : "int";
                    b.Append("        " + ft + " f" + c.name + "N = Filter." + fp
                        + "(this.InAny(\"" + c.name + "\").Trim(), -1);\n");
                    whereLines = whereLines + "            .WhereIf(f" + c.name
                        + "N >= 0, a => a." + c.name + " == f" + c.name + "N)\n";
                } else if (ZanType(c.kind) == "string") {
                    b.Append("        string f" + c.name + " = this.InAny(\"" + c.name
                        + "\").Trim();\n");
                    whereLines = whereLines + "            .WhereIf(f" + c.name
                        + ".Length > 0, a => a." + c.name + " == f" + c.name + ")\n";
                } else {
                    b.Append("        int f" + c.name + "N = Filter.ToInt(this.InAny(\""
                        + c.name + "\").Trim(), -1);\n");
                    whereLines = whereLines + "            .WhereIf(f" + c.name
                        + "N >= 0, a => a." + c.name + " == f" + c.name + "N)\n";
                }
                continue;
            }
            if (c.inFilter != 1) { continue; }
            string op = FilterOpOf(c, designed);
            if (op == "time") {
                b.Append("        long f" + c.name + "F = Fmt.ParseDay(this.InAny(\""
                    + c.name + "From\").Trim());\n");
                b.Append("        long f" + c.name + "T = Fmt.ParseDay(this.InAny(\""
                    + c.name + "To\").Trim());\n");
                whereLines = whereLines + "            .WhereIf(f" + c.name
                    + "F > 0, a => a." + c.name + " >= f" + c.name + "F)\n";
                whereLines = whereLines + "            .WhereIf(f" + c.name
                    + "T > 0, a => a." + c.name + " <= f" + c.name + "T + 86399)\n";
            } else if (op == "select" || op == "pick") {
                /* 下拉/远程搜索语义对齐 Collect：空串与 -1 跳过，0 是合法选项值。 */
                if (ZanType(c.kind) == "string") {
                    b.Append("        string f" + c.name + " = this.InAny(\"" + c.name
                        + "\").Trim();\n");
                    whereLines = whereLines + "            .WhereIf(f" + c.name
                        + ".Length > 0 && f" + c.name + " != \"-1\", a => a." + c.name
                        + " == f" + c.name + ")\n";
                } else if (c.kind == "long") {
                    b.Append("        long f" + c.name + "N = Filter.ToLong(this.InAny(\""
                        + c.name + "\").Trim(), -1);\n");
                    whereLines = whereLines + "            .WhereIf(f" + c.name
                        + "N >= 0, a => a." + c.name + " == f" + c.name + "N)\n";
                } else {
                    b.Append("        int f" + c.name + "N = Filter.ToInt(this.InAny(\""
                        + c.name + "\").Trim(), -1);\n");
                    whereLines = whereLines + "            .WhereIf(f" + c.name
                        + "N >= 0, a => a." + c.name + " == f" + c.name + "N)\n";
                }
            } else if (op == "range") {
                string ft = c.kind == "decimal" ? "double"
                    : (c.kind == "long" ? "long" : "int");
                string parse = c.kind == "decimal" ? "ToDouble"
                    : (c.kind == "long" ? "ToLong" : "ToInt");
                string zero = c.kind == "decimal" ? "0.0" : "0";
                b.Append("        string f" + c.name + "FR = this.InAny(\"" + c.name
                    + "From\").Trim();\n");
                b.Append("        string f" + c.name + "TR = this.InAny(\"" + c.name
                    + "To\").Trim();\n");
                b.Append("        " + ft + " f" + c.name + "F = Filter." + parse
                    + "(f" + c.name + "FR, " + zero + ");\n");
                b.Append("        " + ft + " f" + c.name + "T = Filter." + parse
                    + "(f" + c.name + "TR, " + zero + ");\n");
                whereLines = whereLines + "            .WhereIf(f" + c.name
                    + "FR.Length > 0, a => a." + c.name + " >= f" + c.name + "F)\n";
                whereLines = whereLines + "            .WhereIf(f" + c.name
                    + "TR.Length > 0, a => a." + c.name + " <= f" + c.name + "T)\n";
            } else if (ZanType(c.kind) == "string") {
                b.Append("        string f" + c.name + " = this.InAny(\"" + c.name
                    + "\").Trim();\n");
                if (op == "eq") {
                    whereLines = whereLines + "            .WhereIf(f" + c.name
                        + ".Length > 0, a => a." + c.name + " == f" + c.name + ")\n";
                } else {
                    whereLines = whereLines + "            .WhereIf(f" + c.name
                        + ".Length > 0, a => a." + c.name + ".Contains(f" + c.name + "))\n";
                }
            } else {
                /* 数值精确值：int/long/double 各回本型比较，避免跨型等值。 */
                b.Append("        string f" + c.name + "R = this.InAny(\"" + c.name
                    + "\").Trim();\n");
                if (ZanType(c.kind) == "double") {
                    b.Append("        double f" + c.name + "N = f" + c.name
                        + "R.Length > 0 ? Filter.ToDouble(f" + c.name + "R, 0.0) : 0.0;\n");
                } else if (c.kind == "long") {
                    b.Append("        long f" + c.name + "N = Filter.ToLong(f" + c.name
                        + "R, 0);\n");
                } else {
                    b.Append("        int f" + c.name + "N = Filter.ToInt(f" + c.name
                        + "R, 0);\n");
                }
                whereLines = whereLines + "            .WhereIf(f" + c.name
                    + "R.Length > 0, a => a." + c.name + " == f" + c.name + "N)\n";
            }
        }
        return whereLines;
    }

    /* 生成 JSON 接口控制器（apiEnabled=1 时的附加文件）：会话鉴权（Grant +
       PermBit.View，权限同后台查看，不另起 API Key 机制）；Query 分页列表带
       同款筛选，Detail 单条详情。方法名避开 List/Get 等类型与保留名。 */
    static string ApiSource(SysGenTable t, List<SysGenColumn> cols,
        List<SysGenTable> designed) {
        string mdl = "ZanWeb.Model.Gen." + t.entityName;
        string route = "api/gen/" + t.tableName.Replace("_", "");
        string orderCol = OrderCol(t, cols);
        string orderCall = t.orderDesc == 1
            ? "OrderByDescending(a => a." + orderCol + ")"
            : "OrderBy(a => a." + orderCol + ")";
        string title = Literal(t.title);
        int pageSize = PageSizeOf(t);
        StringBuilder b = new StringBuilder();
        b.Append(ZanHeader());
        b.Append("using System;\nusing System.Json;\nusing System.Web;\n");
        b.Append("using ZanWeb.Core;\nusing ZanWeb.Security;\nusing ZanWeb.Web;\n\n");
        b.Append("namespace ZanWeb.Api.Gen;\n\n");
        b.Append("/// <summary>" + Comment(t.title)
            + " JSON 接口。由表设计器生成，可直接修改。</summary>\n");
        b.Append("[Route(\"" + route + "/[action]\")]\n");
        b.Append("[Custom(Authorization = CustomAuthorization.Grant)]\n");
        b.Append("[Description(\"" + title + "接口\")]\n");
        b.Append("class " + t.entityName + "ApiController : ApiController {\n\n");
        b.Append("    [HttpGet]\n    [Custom(Perm = PermBit.View)]\n");
        b.Append("    [Description(\"" + title + "分页列表\")]\n");
        b.Append("    async void Query() {\n");
        b.Append("        int page = this.InInt(\"page\", 1);\n");
        b.Append("        if (page < 1) { page = 1; }\n");
        string whereLines = FilterEmit(b, cols, designed, "");
        b.Append("        int total = await this." + t.entityName + "\n");
        b.Append(whereLines);
        b.Append("            .CountAsync();\n");
        b.Append("        List<" + mdl + "> rows = await this." + t.entityName + "\n");
        b.Append(whereLines);
        b.Append("            ." + orderCall + "\n");
        b.Append("            .Skip((page - 1) * " + Convert.ToString(pageSize)
            + ").Take(" + Convert.ToString(pageSize) + ").ToListAsync();\n");
        b.Append("        JsonValue arr = JsonValue.NewArray();\n");
        b.Append("        for (int i = 0; i < rows.Count; i = i + 1) {\n");
        b.Append("            JsonValue o = JsonValue.NewObject();\n");
        b.Append("            o.Put(\"id\", JsonValue.NewInt(rows[i].id));\n");
        ApiPuts(b, cols, "rows[i]", "            ");
        b.Append("            arr.Append(o);\n");
        b.Append("        }\n");
        b.Append("        JsonValue outp = JsonValue.NewObject();\n");
        b.Append("        outp.Put(\"total\", JsonValue.NewNum(Convert.ToString(total)));\n");
        b.Append("        outp.Put(\"rows\", arr);\n");
        b.Append("        this.Ok(outp.ToJson());\n");
        b.Append("    }\n\n");
        b.Append("    [HttpGet]\n    [Custom(Perm = PermBit.View)]\n");
        b.Append("    [Description(\"" + title + "详情\")]\n");
        b.Append("    async void Detail() {\n");
        b.Append("        int id = this.InInt(\"id\", 0);\n");
        b.Append("        " + mdl + " e = null;\n");
        b.Append("        if (id > 0) { e = await this." + t.entityName + ".Read(id); }\n");
        b.Append("        if (e == null) { this.Fail(404, \"0404\", \"记录不存在\"); }\n");
        b.Append("        JsonValue o = JsonValue.NewObject();\n");
        b.Append("        o.Put(\"id\", JsonValue.NewInt(e.id));\n");
        ApiPuts(b, cols, "e", "        ");
        b.Append("        this.Ok(o.ToJson());\n");
        b.Append("    }\n}\n");
        return b.ToString();
    }

    /* JSON 字段投影：字符串出 NewStr，其余出数值（datetime 保持 epoch 秒，
       交给客户端格式化）；调用方是生成的实体行或列表元素。 */
    static void ApiPuts(StringBuilder b, List<SysGenColumn> cols, string target,
        string pad) {
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id") { continue; }
            string v = target + "." + c.name;
            if (ZanType(c.kind) == "string") {
                b.Append(pad + "o.Put(\"" + c.name + "\", JsonValue.NewStr("
                    + v + "));\n");
            } else {
                b.Append(pad + "o.Put(\"" + c.name + "\", JsonValue.NewNum(Convert.ToString("
                    + v + ")));\n");
            }
        }
    }
}
