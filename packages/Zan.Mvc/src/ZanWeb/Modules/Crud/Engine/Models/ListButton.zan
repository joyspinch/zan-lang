using System;

namespace ZanWeb.Modules.Crud.Engine;

public class ListButton {
    public string type;
    public string name;
    public string url;
    public string value;
    public string confirm;
}

/* 一次请求收集到的条件：stdlib 的 OrmCond（name/col/kind/value），
   name 是来源参数名（分页链接回填用），col 声明于 ListPage（非用户
   输入），kind/value 由 OrmSelect.WhereConds 校验并参数化绑定。 */

/* 表格列声明（见 ListPage.Col/Tag/Flag）。 */
