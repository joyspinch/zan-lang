using System;
using System.Data.Orm;
using ZanWeb.Web;

namespace ZanWeb.Model;

/* 设计中的一列：存储属性(kind/size/nullable/默认值)及其在生成界面中的角色(列表/筛选/新增/编辑是否出现、编辑控件、关联表)。界面从本表读列名，不从请求取，通用 CRUD 界面即可构建未编译表的 SQL，调用方无法指定任意列。 */
[Table(Name = "sys_gen_column")]
public class SysGenColumn : RowView {
    [Column(IsIdentity = true)]
    public int id;

    public int tableId;

    [Column(StringLength = 64, IsNullable = false)]
    public string name;

    /* 存储类型：int | long | string | text | decimal | bool | datetime。 */
    [Column(StringLength = 16)]
    public string kind;

    /* 字符串列长度。 */
    public int size;

    public int nullable;

    [Column(StringLength = 255)]
    public string defValue;

    [Column(StringLength = 64)]
    public string label;

    /* 编辑控件：text | textarea | number | select | switch | date | datetime | upload | richtext。 */
    [Column(StringLength = 16)]
    public string widget;

    /* select 控件的字典类型码，用于枚举选项（非关联表）。 */
    [Column(StringLength = 64)]
    public string dictType;

    /* 关联表及用作存储值和显示标签的列。 */
    [Column(StringLength = 64)]
    public string relTable;

    [Column(StringLength = 64)]
    public string relValue;

    [Column(StringLength = 64)]
    public string relLabel;

    /* 筛选算子：auto(按类型) | like(模糊) | eq(精确) | select(下拉，需选项源)
       | range(数值区间)；不合法值回落 auto。 */
    [Column(StringLength = 16)]
    public string filterOp;

    /* 列表列宽（如 "140px"）；空=按类型默认。 */
    [Column(StringLength = 16)]
    public string listWidth;

    /* 编辑表单的分组页签名；空=默认组，同名归入同一页签，按首次出现排序。 */
    [Column(StringLength = 16)]
    public string tabGroup;

    public int inList;
    public int inFilter;
    public int inCreate;
    public int inEdit;
    /* 1=该列进列表行内编辑白名单（仍须 inEdit=1：行内是编辑的快捷通道，
       不是绕过表单的第二入口）。字典/关联/时间列固定不进（行内控件表达
       不了选项与日期语义）。 */
    public int inQuick;
    public int required;
    public int sortOrder;

    /* 视图行自述投影：字段行共用的键集；dis 禁用态由控制器补。 */
    public void ToRow(StrMap row) {
        row.Set("id", Convert.ToString(this.id));
        row.Set("name", this.name);
        row.Set("label", this.label);
        row.Set("kind", this.kind);
        row.Set("widget", this.widget);
        row.Set("sortOrder", Convert.ToString(this.sortOrder));
        row.Set("inList", Checked(this.inList));
        row.Set("inFilter", Checked(this.inFilter));
        row.Set("inCreate", Checked(this.inCreate));
        row.Set("inEdit", Checked(this.inEdit));
        row.Set("inQuick", Checked(this.inQuick));
        row.Set("required", Checked(this.required));
        if (this.relTable.Length == 0) {
            row.Set("rel", "");
        } else {
            row.Set("rel", this.relTable + "." + this.relLabel);
        }
    }

    static string Checked(int v) {
        if (v == 1) { return "checked"; }
        return "";
    }
}