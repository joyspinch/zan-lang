using System;
using System.Data;
using System.Data.Orm;
using System.IO;
using System.Json;
using System.Security.Cryptography;
using System.Text;
using System.Web;
using ZanWeb.Ai;
using ZanWeb.Core;
using ZanWeb.Model;
using ZanWeb.Security;
using ZanWeb.Services;
using ZanWeb.Web;

namespace ZanWeb.Admin.Dev;

/* /admin/dev/coder 表设计器：设计表（列及其在管理界面的角色）→ 建入数据库 → 通用屏不够用时写出 .zan 源码。三步各为一键，各成本不同：保存设计仅触及 sys_gen_*，迁移发 DDL，生成写文件须重建生效。不会自动丢弃或重写：设计器只做加法。 */
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("代码生成")]
class CoderController : AdminController {
    [HttpGet]
    [Custom(IsMenu = true, Icon = "mdi:table-cog", Perm = PermBit.View)]
    [Description("表设计与生成")]
    async void Index() {
        ViewData d = await this.Layout("表设计与生成");
        if (!this.PageReady(d)) { return; }

        List<SysGenTable> rows = await this.SysGenTable.OrderBy(a => a.id).ToListAsync();
        List<StrMap> list = d.AddList("tables");
        Rows.Project(rows, list);
        for (int i = 0; i < rows.Count; i = i + 1) {
            int cols = await this.SysGenColumn
                .Where(a => a.tableId == rows[i].id).CountAsync();
            list[i].Set("columns", Convert.ToString(cols));
        }
        if (rows.Count == 0) { d.Set("empty", "1"); }
        this.Page(d);
    }

    [HttpGet]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("表信息表单")]
    async void TableForm() {
        int id = this.InInt("id", 0);
        if (!await this.Can(id > 0 ? (int)PermBit.Update : (int)PermBit.Create)) {
            this.Fail(403, "0403", "无操作权限"); return;
        }
        ViewData d = new ViewData();
        d.Set("id", Convert.ToString(id));
        d.Set("dialogTitle", "新建数据表");
        d.Set("section", "content");
        d.Set("apiChecked", "checked");
        d.Set("exportChecked", "checked");
        d.Set("createChecked", "checked");
        d.Set("editChecked", "checked");
        d.Set("deleteChecked", "checked");
        d.Set("menuChecked", "checked");
        d.Set("pageSize", "20");
        d.Set("orderColumn", "id");
        d.Set("orderDescValue", "1");
        d.Set("descSel", "selected");
        d.Set("ascSel", "");
        if (id > 0) {
            SysGenTable t = await this.SysGenTable.ById(id);
            if (t == null) { this.Fail(404, "0404", "设计不存在"); }
            d.Set("dialogTitle", "编辑表信息");
            d.Set("tableName", t.tableName);
            d.Set("entityName", t.entityName);
            d.Set("title", t.title);
            d.Set("section", t.section);
            d.Set("apiChecked", "");
            if (t.apiEnabled == 1) { d.Set("apiChecked", "checked"); }
            d.Set("exportChecked", "");
            if (t.exportEnabled == 1) { d.Set("exportChecked", "checked"); }
            d.Set("createChecked", Checked(t.hasCreate));
            d.Set("editChecked", Checked(t.hasEdit));
            d.Set("deleteChecked", Checked(t.hasDelete));
            d.Set("menuChecked", Checked(t.menuEnabled));
            d.Set("pageSize", Convert.ToString(t.pageSize > 0 ? t.pageSize : 20));
            d.Set("labelColumn", t.labelColumn == null ? "" : t.labelColumn);
            d.Set("menuIcon", t.menuIcon == null ? "" : t.menuIcon);
            d.Set("orderColumn", t.orderColumn != null && t.orderColumn.Length > 0
                ? t.orderColumn : "id");
            d.Set("orderDescValue", t.orderDesc == 1 ? "1" : "0");
            d.Set("descSel", t.orderDesc == 1 ? "selected" : "");
            d.Set("ascSel", t.orderDesc == 1 ? "" : "selected");
            string orderColumn = t.orderColumn != null && t.orderColumn.Length > 0
                ? t.orderColumn : "id";
            string tabColumn = t.tabColumn == null ? "" : t.tabColumn;
            /* 排序列/页签列下拉：排序列=全部列，页签列仅字典与布尔列可充当。 */
            List<SysGenColumn> cols = await this.SysGenColumn
                .Where(a => a.tableId == id).OrderBy(a => a.sortOrder).ToListAsync();
            List<StrMap> orderCols = d.AddList("orderCols");
            StrMap oid = new StrMap();
            oid.Set("v", "id"); oid.Set("label", "id");
            if (orderColumn == "id") { oid.Set("selected", "1"); }
            orderCols.Add(oid);
            List<StrMap> tabCols = d.AddList("tabCols");
            StrMap tnone = new StrMap();
            tnone.Set("v", ""); tnone.Set("label", "不启用");
            if (tabColumn.Length == 0) { tnone.Set("selected", "1"); }
            tabCols.Add(tnone);
            for (int i = 0; i < cols.Count; i = i + 1) {
                StrMap o = new StrMap();
                o.Set("v", cols[i].name);
                o.Set("label", cols[i].name);
                if (cols[i].name == orderColumn) { o.Set("selected", "1"); }
                orderCols.Add(o);
                if (cols[i].kind == "bool"
                    || (cols[i].dictType.Length > 0 && Gen.Safe(cols[i].dictType))) {
                    StrMap tb = new StrMap();
                    tb.Set("v", cols[i].name);
                    tb.Set("label", cols[i].label + "（" + cols[i].name + "）");
                    if (cols[i].name == tabColumn) { tb.Set("selected", "1"); }
                    tabCols.Add(tb);
                }
            }
        }
        this.Dialog(d);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存表信息")]
    async void TableSave() {
        int id = this.InInt("id", 0);
        if (!await this.Can(id > 0 ? (int)PermBit.Update : (int)PermBit.Create)) {
            this.Fail(403, "0403", "无操作权限"); return;
        }
        string tableName = this.Need("tableName", "表名");
        string title = this.Need("title", "名称");
        if (!Gen.Safe(tableName)) {
            this.Fail(400, "0004", "表名只能用小写字母、数字和下划线，且以字母开头");
        }
        if (tableName.ToLower().StartsWith("sys_")) {
            this.Fail(400, "0004", "不能设计系统表");
        }
        string entityName = this.In("entityName");
        if (entityName.Length == 0) { entityName = Pascal(tableName); }
        if (!Gen.SafeCode(entityName) || entityName == "RowView"
            || entityName == "AdminController" || entityName == "AppController"
            || entityName == "Gen") {
            this.Fail(400, "0004", "实体名不是安全的 Zan 类型名");
        }
        /* URL 段落而非标签：侧边栏分区由此派生。 */
        string section = this.In("section");
        if (!Gen.Safe(section)) { section = "content"; }
        int api = 0;
        if (this.In("apiEnabled") == "1") { api = 1; }
        int export = 0;
        if (this.In("exportEnabled") == "1") { export = 1; }
        /* 功能开关随设计落 sys_gen_table：生成器与通用数据入口都读它。
           模型默认 0，未经表单的写入路径（AI/行内）必须显式带上。 */
        int hasCreate = Flag(this.In("hasCreate"));
        int hasEdit = Flag(this.In("hasEdit"));
        int hasDelete = Flag(this.In("hasDelete"));
        int menuEnabled = Flag(this.In("menuEnabled"));
        /* 页大小在保存与生成两处都钳。 */
        int pageSize = this.InInt("pageSize", 20);
        if (pageSize <= 0) { pageSize = 20; }
        if (pageSize > 200) { pageSize = 200; }
        string labelColumn = this.In("labelColumn").Trim();
        if (labelColumn.Length > 0 && !Gen.SafeCode(labelColumn)) {
            this.Fail(400, "0004", "标签列不是安全的字段名");
        }
        string orderColumn = this.In("orderColumn").Trim();
        if (orderColumn.Length == 0) { orderColumn = "id"; }
        /* "id" 是合法缺省排序列，不在标识符白名单内，单独放行。 */
        if (orderColumn != "id" && !Gen.SafeCode(orderColumn)) {
            this.Fail(400, "0004", "排序列不是安全的字段名");
        }
        int orderDesc = this.In("orderDesc") == "0" ? 0 : 1;
        string tabColumn = this.In("tabColumn").Trim();
        if (tabColumn.Length > 0 && !Gen.SafeCode(tabColumn)) {
            this.Fail(400, "0004", "页签列不是安全的字段名");
        }
        string menuIcon = this.In("menuIcon").Trim();
        for (int i = 0; i < menuIcon.Length; i = i + 1) {
            string ch = menuIcon.Substring(i, 1);
            if ((ch < "a" || ch > "z") && (ch < "0" || ch > "9")
                && ch != "-" && ch != ":") {
                this.Fail(400, "0004", "图标名只能用小写字母、数字、冒号和横线");
            }
        }
        if (menuIcon.Length > 32) { menuIcon = menuIcon.Substring(0, 32); }
        /* 编辑时排序列/页签列须真实存在于列清单（页签列限字典或布尔）。 */
        if (id > 0 && (orderColumn != "id" || tabColumn.Length > 0)) {
            List<SysGenColumn> cols = await this.SysGenColumn
                .Where(a => a.tableId == id).ToListAsync();
            if (orderColumn != "id") {
                bool colOk = false;
                for (int i = 0; i < cols.Count; i = i + 1) {
                    if (cols[i].name == orderColumn) { colOk = true; }
                }
                if (!colOk) { this.Fail(400, "0004", "排序列不存在"); }
            }
            if (tabColumn.Length > 0) {
                bool tabOk = false;
                for (int i = 0; i < cols.Count; i = i + 1) {
                    if (cols[i].name != tabColumn) { continue; }
                    if (cols[i].kind == "bool"
                        || (cols[i].dictType.Length > 0 && Gen.Safe(cols[i].dictType))) {
                        tabOk = true;
                    }
                }
                if (!tabOk) { this.Fail(400, "0004", "页签列须为字典列或布尔列"); }
            }
        }

        SysGenTable clash = await this.SysGenTable
            .Where(a => a.tableName == tableName).FirstAsync();
        if (clash != null && clash.id != id) {
            this.Fail(400, "0004", "表 " + tableName + " 已经设计过了");
        }
        if (id > 0) {
            SysGenTable current = await this.SysGenTable.ById(id);
            if (current == null) { this.Fail(404, "0404", "设计不存在"); }
            if (current.migrated == 1 && current.tableName != tableName) {
                this.Fail(409, "0004", "已建表不能更改表名");
            }
            int n = await this.SysGenTable.Update()
                .Set(a => a.tableName, tableName)
                .Set(a => a.entityName, entityName)
                .Set(a => a.title, title)
                .Set(a => a.section, section)
                .Set(a => a.pageSize, pageSize)
                .Set(a => a.orderColumn, orderColumn)
                .Set(a => a.orderDesc, orderDesc)
                .Set(a => a.labelColumn, labelColumn)
                .Set(a => a.menuIcon, menuIcon)
                .Set(a => a.tabColumn, tabColumn)
                .Set(a => a.exportEnabled, export)
                .Set(a => a.apiEnabled, api)
                .Set(a => a.hasCreate, hasCreate)
                .Set(a => a.hasEdit, hasEdit)
                .Set(a => a.hasDelete, hasDelete)
                .Set(a => a.menuEnabled, menuEnabled)
                .Set(a => a.updatedAt, WebApp.NowSeconds())
                .Where(a => a.id == id).ExecuteAffrowsAsync();
            await this.Note("编辑表设计", tableName, n > 0, "");
            this.Saved("表信息已保存");
            return;
        }
        SysGenTable t = new SysGenTable();
        t.tableName = tableName;
        t.entityName = entityName;
        t.title = title;
        t.section = section;
        t.orderColumn = orderColumn;
        t.orderDesc = orderDesc;
        t.pageSize = pageSize;
        t.labelColumn = labelColumn;
        t.menuIcon = menuIcon;
        t.tabColumn = tabColumn;
        t.exportEnabled = export;
        t.apiEnabled = api;
        t.hasCreate = hasCreate;
        t.hasEdit = hasEdit;
        t.hasDelete = hasDelete;
        t.menuEnabled = menuEnabled;
        t.migrated = 0;
        t.createdAt = WebApp.NowSeconds();
        t.updatedAt = t.createdAt;
        int newId = await this.SysGenTable.Insert(t).ExecuteIdentityAsync();
        await this.Note("新建表设计", tableName, newId > 0, "");
        this.Saved("表已创建，去添加字段");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除表设计")]
    async void TableDelete() {
        int id = this.InInt("id", 0);
        SysGenTable t = await this.SysGenTable.ById(id);
        if (t == null) { this.Fail(404, "0404", "设计不存在"); }
        int n = await this.SysGenTable.Delete().Where(a => a.id == id)
            .ExecuteAffrowsAsync();
        int _c = await this.SysGenColumn.Delete().Where(a => a.tableId == id)
            .ExecuteAffrowsAsync();
        await this.Note("删除表设计", t.tableName, n > 0,
            "物理表保留");
        this.Saved("设计已删除，数据库中的表保留");
    }

    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("字段设计")]
    async void Design() {
        bool inDialog = this.In("as") == "dialog";
        ViewData d = inDialog ? new ViewData() : await this.Layout("字段设计");
        if (inDialog) { d.Set("dialogTitle", "字段设计"); await this.Buttons(d); }
        int id = this.InInt("id", 0);
        SysGenTable t = await this.SysGenTable.ById(id);
        if (t == null) { this.Fail(404, "0404", "设计不存在"); }
        d.Set("id", Convert.ToString(t.id));
        d.Set("tableName", t.tableName);
        d.Set("entityName", t.entityName);
        d.Set("tableTitle", t.title);
        if (t.migrated == 1) { d.Set("migrated", "1"); }
        /* AI 生成入口：服务已配置且此屏可增改时出现；权限在各动作上再拦一道。 */
        if (await Ai.Ready() && (await this.Can((int)PermBit.Create)
                || await this.Can((int)PermBit.Update))) {
            d.Set("canAi", "1");
        }

        List<SysGenColumn> cols = await this.SysGenColumn
            .Where(a => a.tableId == id).OrderBy(a => a.sortOrder).ToListAsync();
        /* 行内控件（勾选/名称/类型/控件/排序）只对可更新者可用，只读者拿到禁用态。 */
        bool canEdit = await this.Can((int)PermBit.Update);
        List<StrMap> list = d.AddList("columns");
        Rows.Project(cols, list);
        if (!canEdit) {
            for (int i = 0; i < list.Count; i = i + 1) {
                list[i].Set("dis", "disabled");
            }
        }
        if (cols.Count == 0) { d.Set("empty", "1"); }
        d.Set("showBar", inDialog ? "" : "1");
        if (inDialog) { this.Dialog(d); return; }
        this.Page(d);
    }

    [HttpGet]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("字段表单")]
    async void ColumnForm() {
        int id = this.InInt("id", 0);
        if (!await this.Can(id > 0 ? (int)PermBit.Update : (int)PermBit.Create)) {
            this.Fail(403, "0403", "无操作权限"); return;
        }
        int tableId = this.InInt("tableId", 0);
        ViewData d = new ViewData();
        d.Set("id", Convert.ToString(id));
        d.Set("tableId", Convert.ToString(tableId));
        d.Set("dialogTitle", "新增字段");
        d.Set("size", "255");
        d.Set("sortOrder", "10");
        d.Set("filterOpValue", "auto");
        d.Set("inListChecked", "checked");
        d.Set("inCreateChecked", "checked");
        d.Set("inEditChecked", "checked");
        d.Set("inQuickChecked", "checked");
        if (id > 0) {
            SysGenColumn c = await this.SysGenColumn.ById(id);
            if (c == null) { this.Fail(404, "0404", "字段不存在"); }
            d.Set("dialogTitle", "编辑字段");
            d.Set("tableId", Convert.ToString(c.tableId));
            d.Set("name", c.name);
            d.Set("label", c.label);
            d.Set("kindValue", c.kind);
            d.Set("widgetValue", c.widget);
            d.Set("size", Convert.ToString(c.size));
            d.Set("defValue", c.defValue);
            d.Set("dictType", c.dictType);
            d.Set("relTable", c.relTable);
            d.Set("relValue", c.relValue);
            d.Set("relLabel", c.relLabel);
            d.Set("filterOpValue", c.filterOp.Length > 0 ? c.filterOp : "auto");
            d.Set("listWidth", c.listWidth == null ? "" : c.listWidth);
            d.Set("tabGroup", c.tabGroup == null ? "" : c.tabGroup);
            d.Set("sortOrder", Convert.ToString(c.sortOrder));
            d.Set("inListChecked", Checked(c.inList));
            d.Set("inFilterChecked", Checked(c.inFilter));
            d.Set("inCreateChecked", Checked(c.inCreate));
            d.Set("inEditChecked", Checked(c.inEdit));
            d.Set("inQuickChecked", Checked(c.inQuick));
            d.Set("requiredChecked", Checked(c.required));
            d.Set("nullableChecked", Checked(c.nullable));
        }

        /* 关联选择器列出该管理后台所知的表，使外键为选择而非手输。 */
        List<SysGenTable> tables = await this.SysGenTable.OrderBy(a => a.id).ToListAsync();
        List<StrMap> opts = d.AddList("tables");
        Rows.Project(tables, opts);
        this.Dialog(d);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存字段")]
    async void ColumnSave() {
        int id = this.InInt("id", 0);
        if (!await this.Can(id > 0 ? (int)PermBit.Update : (int)PermBit.Create)) {
            this.Fail(403, "0403", "无操作权限"); return;
        }
        int tableId = this.InInt("tableId", 0);
        string name = this.Need("name", "字段名");
        if (!Gen.SafeCode(name)) {
            this.Fail(400, "0004", "字段名不是安全的 Zan 字段名");
        }
        string kind = this.In("kind");
        if (kind.Length == 0) { kind = "string"; }
        if (!InList(kind, "string,text,int,long,decimal,bool,datetime")) {
            this.Fail(400, "0004", "不支持的存储类型");
        }
        if (tableId <= 0 || await this.SysGenTable.ById(tableId) == null) {
            this.Fail(404, "0404", "设计不存在");
        }
        SysGenColumn clash = await this.SysGenColumn
            .Where(a => a.tableId == tableId).Where(a => a.name == name).FirstAsync();
        if (clash != null && clash.id != id) {
            this.Fail(400, "0004", "字段 " + name + " 已存在");
        }
        string relTable = this.In("relTable");
        if (relTable.Length > 0 && !Gen.Safe(relTable)) {
            this.Fail(400, "0004", "关联表名不合法");
        }
        string relValue = this.In("relValue");
        string relLabel = this.In("relLabel");
        if (relTable.Length > 0) {
            if (relValue.Length == 0) { relValue = "id"; }
            if (relLabel.Length == 0) { relLabel = "name"; }
            if (!Gen.Safe(relValue) || !Gen.Safe(relLabel)) {
                this.Fail(400, "0004", "关联字段名不合法");
            }
        }
        string filterOp = this.In("filterOp");
        if (filterOp.Length == 0) { filterOp = "auto"; }
        if (!InList(filterOp, "auto,like,eq,select,range")) {
            this.Fail(400, "0004", "不支持的筛选算子");
        }
        string listWidth = Clip(this.In("listWidth").Trim(), 16);
        if (listWidth.Length > 0 && Gen.WidthOf(listWidth).Length == 0) {
            this.Fail(400, "0004", "列宽只支持「数字+px/em/%」形态（如 140px）");
        }
        string tabGroup = Clip(this.In("tabGroup").Trim(), 16);

        SysGenColumn c = new SysGenColumn();
        if (id > 0) {
            SysGenColumn cur = await this.SysGenColumn.ById(id);
            if (cur == null || cur.tableId != tableId) {
                this.Fail(404, "0404", "字段不存在");
            }
            c = cur;
        }
        c.tableId = tableId;
        c.name = name;
        c.kind = kind;
        c.size = this.InInt("size", 255);
        if (c.size < 0 || c.size > 4000) { this.Fail(400, "0004", "字段长度不合法"); }
        c.defValue = this.In("defValue");
        c.label = this.In("label");
        c.widget = this.In("widget");
        if (c.widget.Length == 0) { c.widget = "text"; }
        if (!InList(c.widget,
                "text,textarea,number,select,switch,date,richtext,upload")) {
            this.Fail(400, "0004", "不支持的控件");
        }
        c.dictType = this.In("dictType");
        c.relTable = relTable;
        c.relValue = relValue;
        c.relLabel = relLabel;
        c.filterOp = filterOp;
        c.listWidth = listWidth;
        c.tabGroup = tabGroup;
        c.sortOrder = this.InInt("sortOrder", 10);
        c.nullable = Flag(this.In("nullable"));
        c.inList = Flag(this.In("inList"));
        c.inFilter = Flag(this.In("inFilter"));
        c.inCreate = Flag(this.In("inCreate"));
        c.inEdit = Flag(this.In("inEdit"));
        c.inQuick = Flag(this.In("inQuick"));
        c.required = Flag(this.In("required"));

        if (id > 0) {
            int n = await this.SysGenColumn.Update()
                .Set(a => a.name, c.name)
                .Set(a => a.kind, c.kind)
                .Set(a => a.size, c.size)
                .Set(a => a.defValue, c.defValue)
                .Set(a => a.label, c.label)
                .Set(a => a.widget, c.widget)
                .Set(a => a.dictType, c.dictType)
                .Set(a => a.relTable, c.relTable)
                .Set(a => a.relValue, c.relValue)
                .Set(a => a.relLabel, c.relLabel)
                .Set(a => a.filterOp, c.filterOp)
                .Set(a => a.listWidth, c.listWidth)
                .Set(a => a.tabGroup, c.tabGroup)
                .Set(a => a.sortOrder, c.sortOrder)
                .Set(a => a.nullable, c.nullable)
                .Set(a => a.inList, c.inList)
                .Set(a => a.inFilter, c.inFilter)
                .Set(a => a.inCreate, c.inCreate)
                .Set(a => a.inEdit, c.inEdit)
                .Set(a => a.inQuick, c.inQuick)
                .Set(a => a.required, c.required)
                .Where(a => a.id == id).ExecuteAffrowsAsync();
            await this.Note("编辑字段", name, n > 0, "");
            this.Saved("字段已保存");
            return;
        }
        int newId = await this.SysGenColumn.Insert(c).ExecuteIdentityAsync();
        await this.Note("新增字段", name, newId > 0, "");
        this.Saved("字段已添加");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除字段")]
    async void ColumnDelete() {
        int id = this.InInt("id", 0);
        SysGenColumn c = await this.SysGenColumn.ById(id);
        if (c == null) { this.Fail(404, "0404", "字段不存在"); }
        int n = await this.SysGenColumn.Delete().Where(a => a.id == id)
            .ExecuteAffrowsAsync();
        await this.Note("删除字段", c.name, n > 0,
            "数据库中的列保留");
        this.Saved("字段已从设计中移除，数据库中的列保留");
    }

    /* 行内快速改：设计表里的勾选/名称/类型/控件/排序就地提交，免去为一个小开关
       开一次编辑框。只放行白名单列，每列单独校验后单独更新；列名永不来自请求，
       更新构造器按字段写死，调用方无法指定任意列。深度属性（默认值/长度/字典/
       关联）仍走编辑对话框。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("字段行内修改")]
    async void ColumnField() {
        int id = this.InInt("id", 0);
        string field = this.Need("field", "属性");
        string value = this.In("value");
        SysGenColumn c = await this.SysGenColumn.ById(id);
        if (c == null) { this.Fail(404, "0404", "字段不存在"); }

        if (field == "label") {
            string label = Clip(value, 64);
            if (label.Length == 0) { label = c.name; }
            int n = await this.SysGenColumn.Update()
                .Set(a => a.label, label)
                .Where(a => a.id == id).ExecuteAffrowsAsync();
            await this.Note("编辑字段", c.name, n > 0, "label=" + label);
            this.Ok("{}");
            return;
        }
        if (field == "sortOrder") {
            int sort = this.InInt("value", c.sortOrder);
            if (sort < 0) { sort = 0; }
            if (sort > 9999999) { sort = 9999999; }
            int n = await this.SysGenColumn.Update()
                .Set(a => a.sortOrder, sort)
                .Where(a => a.id == id).ExecuteAffrowsAsync();
            await this.Note("编辑字段", c.name, n > 0,
                "sortOrder=" + Convert.ToString(sort));
            this.Ok("{}");
            return;
        }
        if (field == "kind") {
            if (!InList(value, "string,text,int,long,decimal,bool,datetime")) {
                this.Fail(400, "0004", "不支持的存储类型");
            }
            int n = await this.SysGenColumn.Update()
                .Set(a => a.kind, value)
                .Where(a => a.id == id).ExecuteAffrowsAsync();
            await this.Note("编辑字段", c.name, n > 0, "kind=" + value);
            this.Ok("{}");
            return;
        }
        if (field == "widget") {
            if (!InList(value,
                    "text,textarea,number,select,switch,date,richtext,upload")) {
                this.Fail(400, "0004", "不支持的控件");
            }
            int n = await this.SysGenColumn.Update()
                .Set(a => a.widget, value)
                .Where(a => a.id == id).ExecuteAffrowsAsync();
            await this.Note("编辑字段", c.name, n > 0, "widget=" + value);
            this.Ok("{}");
            return;
        }
        if (field == "filterOp") {
            if (!InList(value, "auto,like,eq,select,range")) {
                this.Fail(400, "0004", "不支持的筛选算子");
            }
            int n = await this.SysGenColumn.Update()
                .Set(a => a.filterOp, value)
                .Where(a => a.id == id).ExecuteAffrowsAsync();
            await this.Note("编辑字段", c.name, n > 0, "filterOp=" + value);
            this.Ok("{}");
            return;
        }
        if (field == "tabGroup") {
            string g = Clip(value.Trim(), 16);
            int n = await this.SysGenColumn.Update()
                .Set(a => a.tabGroup, g)
                .Where(a => a.id == id).ExecuteAffrowsAsync();
            await this.Note("编辑字段", c.name, n > 0, "tabGroup=" + g);
            this.Ok("{}");
            return;
        }
        if (field == "inList" || field == "inFilter" || field == "inCreate"
            || field == "inEdit" || field == "inQuick" || field == "required"
            || field == "nullable") {
            int v = Flag(value);
            int n = 0;
            if (field == "inList") {
                n = await this.SysGenColumn.Update().Set(a => a.inList, v)
                    .Where(a => a.id == id).ExecuteAffrowsAsync();
            } else if (field == "inFilter") {
                n = await this.SysGenColumn.Update().Set(a => a.inFilter, v)
                    .Where(a => a.id == id).ExecuteAffrowsAsync();
            } else if (field == "inCreate") {
                n = await this.SysGenColumn.Update().Set(a => a.inCreate, v)
                    .Where(a => a.id == id).ExecuteAffrowsAsync();
            } else if (field == "inEdit") {
                n = await this.SysGenColumn.Update().Set(a => a.inEdit, v)
                    .Where(a => a.id == id).ExecuteAffrowsAsync();
            } else if (field == "inQuick") {
                n = await this.SysGenColumn.Update().Set(a => a.inQuick, v)
                    .Where(a => a.id == id).ExecuteAffrowsAsync();
            } else if (field == "required") {
                n = await this.SysGenColumn.Update().Set(a => a.required, v)
                    .Where(a => a.id == id).ExecuteAffrowsAsync();
            } else {
                n = await this.SysGenColumn.Update().Set(a => a.nullable, v)
                    .Where(a => a.id == id).ExecuteAffrowsAsync();
            }
            await this.Note("编辑字段", c.name, n > 0,
                field + "=" + Convert.ToString(v));
            this.Ok("{}");
            return;
        }
        this.Fail(400, "0004", "不支持行内修改的属性");
    }

    /* AI 字段设计：一句话业务 → 整表字段草稿。AI 只出草案，且过三道关才落设计：
       服务器按设计器契约重验每一列（不信任模型输出，与数据屏同一纪律），
       人在审核表里逐列勾选，应用时对浏览器回传的清单再验一遍。 */
    [HttpGet]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("AI 字段设计表单")]
    async void AiForm() {
        int tableId = this.InInt("tableId", 0);
        SysGenTable t = await this.SysGenTable.ById(tableId);
        if (t == null) { this.Fail(404, "0404", "设计不存在"); }
        if (!await Ai.Ready()) {
            this.Fail(400, "0005", "尚未配置 AI 服务，先到「站点设置 → AI」启用");
        }
        ViewData d = new ViewData();
        d.Set("tableId", Convert.ToString(tableId));
        d.Set("tableTitle", t.title);
        d.Set("tableName", t.tableName);
        this.Dialog(d);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("AI 生成字段设计")]
    async void AiDesign() {
        int tableId = this.InInt("tableId", 0);
        string desc = this.Need("desc", "业务描述");
        SysGenTable t = await this.SysGenTable.ById(tableId);
        if (t == null) { this.Fail(404, "0404", "设计不存在"); }
        if (!await Ai.Ready()) { this.Fail(400, "0005", "尚未配置 AI 服务"); }
        if (desc.Length > 2000) { desc = desc.Substring(0, 2000); }

        List<SysGenColumn> cols = await this.SysGenColumn
            .Where(a => a.tableId == tableId).OrderBy(a => a.sortOrder)
            .ToListAsync();
        /* 字典类型与已设计表作为取值范围给模型：下拉建议落在真实存在的
           字典/表上，而不是编一个不存在的类型码。 */
        List<SysDictType> dicts = await this.SysDictType
            .Where(a => a.status == 1).ToListAsync();
        List<SysGenTable> tables = await this.SysGenTable.OrderBy(a => a.id)
            .ToListAsync();

        AiReply r = await Ai.CompleteRaw(DesignPrompt(),
            DesignAsk(t, desc, cols, dicts, tables));
        if (!r.ok) { this.Fail(400, "0005", r.text); }
        JsonValue root = DesignJson(r.text);
        if (root == null || !root.IsObject()) {
            this.Fail(400, "0005", "AI 返回的内容无法解析为字段设计，请重试或换个描述");
        }
        JsonValue colsArr = root.Get("columns");
        if (colsArr == null || !colsArr.IsArray()) {
            this.Fail(400, "0005", "AI 返回的内容无法解析为字段设计，请重试或换个描述");
        }
        ColumnDraft draft = Sanitize(colsArr, cols, tables);
        if (draft.cols.Count == 0) {
            this.Fail(400, "0005", "AI 给出的字段全部无效（重名或类型不合法），请换个描述再试");
        }

        JsonValue outArr = JsonValue.NewArray();
        for (int i = 0; i < draft.cols.Count; i = i + 1) {
            outArr.Append(ColumnJson(draft.cols[i]));
        }
        JsonValue outObj = JsonValue.NewObject();
        outObj.Put("columns", outArr);
        outObj.Put("dropped", MetricsCluster.Num(draft.dropped));
        this.Ok(outObj.ToJson());
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("应用 AI 字段设计")]
    async void AiApply() {
        int tableId = this.InInt("tableId", 0);
        string listJson = this.Need("columns", "字段清单");
        SysGenTable t = await this.SysGenTable.ById(tableId);
        if (t == null) { this.Fail(404, "0404", "设计不存在"); }
        List<SysGenColumn> cols = await this.SysGenColumn
            .Where(a => a.tableId == tableId).OrderBy(a => a.sortOrder)
            .ToListAsync();
        List<SysGenTable> tables = await this.SysGenTable.OrderBy(a => a.id)
            .ToListAsync();
        JsonValue arr = JsonValue.ParseLenient(listJson);
        if (arr == null || !arr.IsArray()) {
            this.Fail(400, "0004", "字段清单无法解析");
        }
        /* 浏览器回传的数据同样不被信任：与生成走同一个清洗器。 */
        ColumnDraft draft = Sanitize(arr, cols, tables);
        if (draft.cols.Count == 0) {
            this.Fail(400, "0004", "没有可应用的有效字段");
        }

        int sort = 10;
        for (int i = 0; i < cols.Count; i = i + 1) {
            if (cols[i].sortOrder >= sort) { sort = cols[i].sortOrder + 10; }
        }
        int added = 0;
        for (int i = 0; i < draft.cols.Count; i = i + 1) {
            SysGenColumn c = draft.cols[i];
            c.tableId = tableId;
            c.sortOrder = sort;
            sort = sort + 10;
            int _id = await this.SysGenColumn.Insert(c).ExecuteIdentityAsync();
            added = added + 1;
        }
        await this.Note("AI 生成字段", t.tableName, added > 0,
            Convert.ToString(added) + " 个字段"
            + (draft.dropped > 0 ? "，丢弃 " + Convert.ToString(draft.dropped) : ""));
        this.Saved("已应用 " + Convert.ToString(added)
            + " 个字段，记得「同步数据库」建列");
    }

    /* 字段设计任务的系统提示词：严格 JSON 契约 + 控件配型规则。 */
    private static string DesignPrompt() {
        return "你是 ZanWeb 表设计器的字段设计助手。根据业务描述为一张表设计字段，"
            + "只输出一个 JSON 对象，不要解释、不要 Markdown 代码块，格式："
            + "{\"columns\":[{\"name\":\"field_name\",\"label\":\"中文名\","
            + "\"kind\":\"string\",\"size\":255,\"widget\":\"text\","
            + "\"required\":1,\"nullable\":0,\"inList\":1,\"inFilter\":0,"
            + "\"inCreate\":1,\"inEdit\":1,\"defValue\":\"\",\"sortOrder\":10,"
            + "\"dictType\":\"\",\"relTable\":\"\",\"relValue\":\"\",\"relLabel\":\"\"}]}。"
            + "规则：name 用小写下划线，不与已有字段重复；kind 只能是 string/text/"
            + "int/long/decimal/bool/datetime；widget 只能是 text/textarea/number/"
            + "select/switch/date/richtext/upload；bool 配 switch，text 配 textarea，"
            + "int/long/decimal 配 number，datetime 配 date；枚举字段配 select 并填"
            + " dictType（只能用给出的字典类型码），引用其他表配 select 并填 relTable"
            + "（只能用给出的表名）与 relValue=id、relLabel=name；label 用简短中文；"
            + "sortOrder 按 10 递增，重要字段在前；不加主键 id 与 created_at/"
            + "updated_at（系统自动处理）；字段数量适中（8~15 个）。";
    }

    /* 用户消息：表 + 已有字段（防重复）+ 字典/表取值范围 + 业务描述。 */
    static string DesignAsk(SysGenTable t, string desc, List<SysGenColumn> cols,
                            List<SysDictType> dicts, List<SysGenTable> tables) {
        StringBuilder sb = new StringBuilder();
        sb.Append("表：");
        sb.Append(t.tableName);
        sb.Append("（");
        sb.Append(t.title);
        sb.Append("）\n");
        if (cols.Count > 0) {
            sb.Append("已有字段（不要重复，可在其基础上扩展）：");
            for (int i = 0; i < cols.Count; i = i + 1) {
                if (i > 0) { sb.Append(", "); }
                sb.Append(cols[i].name);
                sb.Append("(");
                sb.Append(cols[i].kind);
                sb.Append(")");
            }
            sb.Append("\n");
        }
        if (dicts.Count > 0) {
            sb.Append("可用字典类型：");
            for (int i = 0; i < dicts.Count; i = i + 1) {
                if (i > 0) { sb.Append(", "); }
                sb.Append(dicts[i].code);
                sb.Append("(");
                sb.Append(dicts[i].name);
                sb.Append(")");
            }
            sb.Append("\n");
        }
        if (tables.Count > 0) {
            sb.Append("可关联表：");
            for (int i = 0; i < tables.Count; i = i + 1) {
                if (i > 0) { sb.Append(", "); }
                sb.Append(tables[i].tableName);
                sb.Append("(");
                sb.Append(tables[i].title);
                sb.Append(")");
            }
            sb.Append("\n");
        }
        sb.Append("业务描述：");
        sb.Append(desc);
        return sb.ToString();
    }

    /* 模型答语 → JSON 对象：剥掉可能的代码围栏与前后闲话，取首个 { 到末个 }。 */
    static JsonValue DesignJson(string raw) {
        int a = raw.IndexOf("{");
        int b = raw.LastIndexOf("}");
        if (a < 0 || b <= a) { return null; }
        return JsonValue.ParseLenient(raw.Substring(a, b - a + 1));
    }

    /* 清洗结果：有效列 + 被丢弃数。 */
