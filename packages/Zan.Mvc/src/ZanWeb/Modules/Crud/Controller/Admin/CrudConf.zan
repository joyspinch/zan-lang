using System;
using System.Text;
using System.Web;
using ZanWeb.Core;
using ZanWeb.Web;

namespace ZanWeb.Crud;

/* 配置驱动的管理屏声明（Modules/Crud）。
 *
 * 一个字段只在一份声明里出现一次：Col(列名, 显示名) 起头，类型与
 * 约束跟在后面，一列一行。列表列、搜索、表单、写白名单、行内子集、
 * 唯一约束全部从这份字段表派生——同一列不再在四处各写一遍，也没有
 * 字符串 DSL（"name:text,sortOrder:int"）：
 *
 *   .Col("name", "名称").Req().Max(64).Search("搜索名称").Inline()
 *
 * 读法：name 列必填、至多 64 字、可搜索、可行内改。
 *
 * 修饰分两类——字段级（作用于最近一个 Col，跟在它后面）：
 *   类型   Int() 整数 · Area() 多行文本 · Pass() 密码 · Opts("1=显示|ok,..")
 *          （Opts = 状态类字段：列表渲染徽章、表单渲染下拉、批量启停目标）
 *   展示   W("150px") 列宽 · Muted() 淡显 · Time() 时间列（Unix 秒→日期）
 *   可写性 默认可写（进表单与保存白名单）；Ro() 只读列 · V() 虚拟列
 *          （值由 OnRows 投影，两者都不进表单与白名单）
 *   行为   Search("占位") 可搜索 · Pick("url") 外键远程单选筛选（对端
 *          是另一张屏的 options 端点，与 Search 互斥）· Inline() 可行内
 *          改 · Unique("冲突文案") · Pattern("正则")
 *   校验   Req() · Max(n) · Min(n) · Ph("占位") · Def("默认值") · Span() ·
 *          Rows(n)
 * 屏级（另起一段）：Order/Label/Toggle/Created/Updated、工具栏 Tbar*、
 * 行内操作 Ops*。端点 URL 一律由 path 派生，声明里不写 URL。
 *
 * 声明即白名单：搜索、保存、行内修改只收声明过的列名，值一律占位符
 * 参数。ListPage/FormPage 是逐请求对象，Build()/ToFormPage() 每请求
 * 重放出实例，多屏并发互不串味。
 */
class CrudConf {
    string table;
    string title;
    string path;
    string orderCol;
    bool orderDesc;
    string labelCol;
    string toggleField;
    string stampCreated;
    string stampUpdated;
    List<ListFilter> fs;
    List<ListButton> bs;
    List<ListCol> cols;
    List<ListOps> ops;
    List<StrMap> uniques;
    List<FormField> forms;
    string editDefs;
    string inlineDefs;

    /* 收集中的字段（Col 起、下一个屏级声明止）。 */
    string fName;
    string fLabel;
    string fKind;
    string fOpts;
    string fW;
    bool fMuted;
    bool fRo;
    bool fVir;
    bool fInline;
    string fSearch;
    string fPick;
    string fPattern;
    bool fReq;
    int fMax;
    int fMin;
    string fPh;
    string fDef;
    bool fSpan;
    int fRows;
    string fUnique;

    CrudConf() {
        this.fs = new List<ListFilter>();
        this.bs = new List<ListButton>();
        this.cols = new List<ListCol>();
        this.ops = new List<ListOps>();
        this.uniques = new List<StrMap>();
        this.forms = new List<FormField>();
        this.orderCol = "id";
        this.orderDesc = true;
        this.labelCol = "";
        this.toggleField = "status";
        this.stampCreated = "";
        this.stampUpdated = "";
        this.editDefs = "";
        this.inlineDefs = "";
        this.fName = "";
    }

    /* 每屏一个实例：Of(物理表, 屏标题, URL 基路径) 后逐列声明。 */
    static CrudConf Of(string table, string title, string path) {
        CrudConf c = new CrudConf();
        c.table = table;
        c.title = title;
        c.path = path;
        return c;
    }

    /* ---- 字段声明：一列一行，修饰跟在后面 ------------------------ */

    CrudConf Col(string name, string label) {
        this.Seal();
        this.fName = name;
        this.fLabel = label;
        this.fKind = "text";
        this.fOpts = "";
        this.fW = "";
        this.fMuted = false;
        this.fRo = false;
        this.fVir = false;
        this.fInline = false;
        this.fSearch = "";
        this.fPick = "";
        this.fPattern = "";
        this.fReq = false;
        this.fMax = 0;
        this.fMin = 0;
        this.fPh = "";
        this.fDef = "";
        this.fSpan = false;
        this.fRows = 0;
        this.fUnique = "";
        return this;
    }

    /* 类型：整数（列表右对齐、表单文本框、按整型绑定）。 */
    CrudConf Int() { this.fKind = "int"; return this; }

    /* 类型：多行文本。 */
    CrudConf Area() { this.fKind = "area"; return this; }

    /* 类型：密码（渲染 type=password，编辑留空=不修改，恒不回显）。 */
    CrudConf Pass() { this.fKind = "pass"; return this; }

    /* 类型：状态类（"1=显示|ok,0=隐藏|off"）——列表徽章、表单下拉、
       按整型绑定；下拉选项自动去掉 "|样式" 段。 */
    CrudConf Opts(string opts) { this.fKind = "opts"; this.fOpts = opts; return this; }

    /* ---- 字段修饰：展示 ------------------------------------------ */

    CrudConf W(string width) { this.fW = width; return this; }

    CrudConf Muted() { this.fMuted = true; return this; }

    /* 时间列：行值是 Unix 秒，渲染为日期（配 Ro()，时间由引擎盖戳）。 */
    CrudConf Time() { this.fKind = "time"; return this; }

    /* ---- 字段修饰：可写性与行为 ---------------------------------- */

    /* 只读列：进列表、不进表单与白名单（id、时间戳、外关显示名）。 */
    CrudConf Ro() { this.fRo = true; return this; }

    /* 虚拟列：值由 OnRows 投影（计数、关联名），隐含只读。 */
    CrudConf V() { this.fVir = true; return this; }

    /* 可行内修改（含批量启停子集）。 */
    CrudConf Inline() { this.fInline = true; return this; }

    /* 可搜索：文本列 LIKE，Opts 列下拉等值。参数名列名本身。 */
    CrudConf Search(string ph) { this.fSearch = ph; return this; }

    /* 远程搜索单选筛选（外键列用）：url 通常指向另一张 Crud 屏的
       options 端点（?kw= 列表、?id= 回显）。与 Search 互斥，声明时
       后者生效。 */
    CrudConf Pick(string url) { this.fPick = url; return this; }

    /* 正则校验（服务端单一来源，FormPage.Validate 执行）。 */
    CrudConf Pattern(string re) { this.fPattern = re; return this; }

    /* 唯一约束：保存写前检查、排除自身行，冲突时以此文案拒绝。 */
    CrudConf Unique(string msg) { this.fUnique = msg; return this; }

    /* ---- 字段修饰：表单与校验 ------------------------------------ */

    CrudConf Req() { this.fReq = true; return this; }

    CrudConf Max(int n) { this.fMax = n; return this; }

    CrudConf Min(int n) { this.fMin = n; return this; }

    CrudConf Ph(string p) { this.fPh = p; return this; }

    /* 新增时的默认值（渲染进表单，保存时随表单提交）。 */
    CrudConf Def(string v) { this.fDef = v; return this; }

    CrudConf Span() { this.fSpan = true; return this; }

    CrudConf Rows(int n) { this.fRows = n; return this; }

    /* ---- 屏级声明 ------------------------------------------------ */

    /* 列表排序（默认 id 降序）。 */
    CrudConf Order(string col, bool desc) {
        this.Seal();
        this.orderCol = col;
        this.orderDesc = desc;
        return this;
    }

    /* Options() 选项端点的文案列（data-pick 远程搜索单选的数据源）。 */
    CrudConf Label(string col) {
        this.Seal();
        this.labelCol = col;
        return this;
    }

    /* 批量启停字段（TbarEnable/TbarDisable 的目标列，默认 status）。 */
    CrudConf Toggle(string field) {
        this.Seal();
        this.toggleField = field;
        return this;
    }

    /* 时间戳维护：保存时写入的列名（空串=不维护）。 */
    CrudConf Created(string col) {
        this.Seal();
        this.stampCreated = col;
        return this;
    }

    CrudConf Updated(string col) {
        this.Seal();
        this.stampUpdated = col;
        return this;
    }

    CrudConf TbarAdd(string name) {
        this.Seal();
        return this.Btn("add", name, this.Act("form"), "", "");
    }

    CrudConf TbarReload() {
        this.Seal();
        return this.Btn("reload", "刷新", "", "", "");
    }

    CrudConf TbarEnable() {
        this.Seal();
        return this.Btn("batch", "启用", this.Act("batch"), "1", "确认启用所选记录吗？");
    }

    CrudConf TbarDisable() {
        this.Seal();
        return this.Btn("batch", "禁用", this.Act("batch"), "0", "确认禁用所选记录吗？");
    }

    /* 批量删除不过行级占用钩子——有子记录的表不要声明。 */
    CrudConf TbarDelete() {
        this.Seal();
        return this.Btn("batch", "删除", this.Act("batch"), "",
            "删除后不可恢复，确认删除所选记录吗？");
    }

    /* 自定义批量键：value 区分方向（发布/转草稿），同一 batch 端点。 */
    CrudConf TbarBatch(string name, string value, string confirm) {
        this.Seal();
        return this.Btn("batch", name, this.Act("batch"), value, confirm);
    }

    CrudConf OpsEdit() {
        this.Seal();
        return this.Ops("编辑", this.Act("form"), "", "", "u");
    }

    CrudConf OpsDel(string confirm) {
        this.Seal();
        return this.Ops("删除", this.Act("delete"), confirm, "id={id}", "d");
    }

    /* 自定义行内动作：action 为本屏动作名，POST 按钮。 */
    CrudConf OpsCustom(string name, string action, string confirm, string args, string perm) {
        this.Seal();
        return this.Ops(name, this.Act(action), confirm, args, perm);
    }

    CrudConf Ops(string name, string url, string confirm, string args, string perm) {
        ListOps o = new ListOps();
        o.name = name;
        o.url = url;
        o.confirm = confirm;
        o.args = args;
        o.perm = perm;
        this.ops.Add(o);
        return this;
    }

    CrudConf Btn(string type, string name, string url, string value, string confirm) {
        ListButton b = new ListButton();
        b.type = type;
        b.name = name;
        b.url = url;
        b.value = value;
        b.confirm = confirm;
        this.bs.Add(b);
        return this;
    }

    /* ---- 派生 ---------------------------------------------------- */

    string Act(string action) {
        return "/" + this.path + "/" + action;
    }

    string Title() {
        return this.title;
    }

    /* 把收集中的字段落进各派生列表：列表列、（可写时）白名单与表单、
       （声明时）搜索与唯一约束。每个屏级声明与 Build/ToFormPage 前调用。 */
    void Seal() {
        if (this.fName.Length == 0) { return; }
        string name = this.fName;

        ListCol c = new ListCol();
        c.field = name;
        c.title = this.fLabel;
        c.width = this.fW;
        c.opts = this.fOpts;
        if (this.fKind == "int") { c.kind = "num"; }
        else if (this.fKind == "opts") { c.kind = "tag"; }
        else if (this.fKind == "time") { c.kind = "time"; }
        else if (this.fMuted) { c.kind = "muted"; }
        else { c.kind = "text"; }
        this.cols.Add(c);

        bool writable = !this.fRo && !this.fVir
            && (this.fKind == "text" || this.fKind == "area"
                || this.fKind == "int" || this.fKind == "opts"
                || this.fKind == "pass");
        if (writable) {
            string defType = (this.fKind == "int" || this.fKind == "opts")
                ? "int" : "text";
            if (this.editDefs.Length > 0) { this.editDefs = this.editDefs + ","; }
            this.editDefs = this.editDefs + name + ":" + defType;
            if (this.fInline) {
                if (this.inlineDefs.Length > 0) { this.inlineDefs = this.inlineDefs + ","; }
                this.inlineDefs = this.inlineDefs + name + ":" + defType;
            }
            FormField f = new FormField();
            f.name = name;
            f.label = this.fLabel;
            if (this.fKind == "opts") { f.kind = "select"; }
            else if (this.fKind == "int") { f.kind = "text"; }
            else { f.kind = this.fKind; }
            f.options = CrudConf.SelectOpts(this.fOpts);
            f.blank = "";
            f.rows = null;
            f.onlyNew = false;
            f.onlyEdit = false;
            f.value = this.fDef;
            f.ph = this.fPh;
            f.max = this.fMax;
            f.min = this.fMin;
            f.required = this.fReq;
            f.span = this.fSpan;
            f.areaRows = this.fRows;
            f.pattern = this.fPattern;
            this.forms.Add(f);
        }

        if (this.fPick.Length > 0 || this.fSearch.Length > 0) {
            ListFilter sf = new ListFilter();
            sf.name = name;
            sf.col = name;
            sf.title = this.fLabel;
            if (this.fPick.Length > 0) {
                sf.type = "pick";
                sf.ph = "";
                sf.options = "";
                sf.url = this.fPick;
            } else if (this.fKind == "opts") {
                sf.type = "select";
                sf.ph = "";
                sf.options = CrudConf.SelectOpts(this.fOpts);
                sf.url = "";
            } else {
                sf.type = "text";
                sf.ph = this.fSearch;
                sf.options = "";
                sf.url = "";
            }
            this.fs.Add(sf);
        }

        if (this.fUnique.Length > 0) {
            StrMap u = new StrMap();
            u.Set("col", name);
            u.Set("msg", this.fUnique);
            this.uniques.Add(u);
        }

        this.fName = "";
    }

    /* 逐请求重放：字段表 → ListPage（渲染与取数引擎）。inline=true 时
       写白名单收窄为行内子集（行内修改/批量启停用），保存动作走全集。 */
    ListPage Build(bool inline) {
        this.Seal();
        ListPage lp = ListPage.Of();
        for (int i = 0; i < this.fs.Count; i = i + 1) {
            ListFilter f = this.fs[i];
            if (f.type == "text") { lp.Text(f.title, f.name, f.col, f.ph); }
            else { lp.Select(f.title, f.name, f.col, f.options); }
        }
        for (int i = 0; i < this.bs.Count; i = i + 1) {
            ListButton b = this.bs[i];
            lp.Btn(b.type, b.name, b.url, b.value, b.confirm);
        }
        for (int i = 0; i < this.cols.Count; i = i + 1) {
            ListCol c = this.cols[i];
            if (c.kind == "tag") { lp.Tag(c.field, c.title, c.opts, c.width); }
            else { lp.Col(c.field, c.title, c.kind, c.width); }
        }
        for (int i = 0; i < this.ops.Count; i = i + 1) {
            ListOps o = this.ops[i];
            lp.Ops(o.name, o.url, o.confirm, o.args, o.perm);
        }
        lp.Table(this.table);
        string defs = this.editDefs;
        if (inline && this.inlineDefs.Length > 0) { defs = this.inlineDefs; }
        if (defs.Length > 0) { lp.EditFields(defs); }
        return lp;
    }

    /* 逐请求重放：字段表 → FormPage（值绑定由引擎按行注入）。 */
    FormPage ToFormPage(string idValue) {
        this.Seal();
        FormPage fp = FormPage.Of(this.Act("save")).Id(idValue);
        for (int i = 0; i < this.forms.Count; i = i + 1) {
            FormField f = this.forms[i];
            if (f.kind == "text") { fp.Text(f.label, f.name); }
            else if (f.kind == "pass") { fp.Pass(f.label, f.name); }
            else if (f.kind == "area") { fp.Area(f.label, f.name); }
            else { fp.Select(f.label, f.name, f.options); }
            if (f.ph.Length > 0) { fp.Ph(f.ph); }
            if (f.max > 0) { fp.Max(f.max); }
            if (f.min > 0) { fp.Min(f.min); }
            if (f.required) { fp.Req(); }
            if (f.span) { fp.Span(); }
            if (f.areaRows > 0) { fp.Rows(f.areaRows); }
            if (f.value.Length > 0) { fp.Val(f.value); }
            if (f.pattern.Length > 0) { fp.Pattern(f.pattern); }
        }
        return fp;
    }

    /* "1=显示|ok,0=隐藏|off" → "1=显示,0=隐藏"（表单下拉/搜索下拉用）。 */
    static string SelectOpts(string opts) {
        if (opts.Length == 0) { return ""; }
        StringBuilder sb = new StringBuilder();
        string rest = opts;
        while (rest.Length > 0) {
            string one = rest;
            int comma = rest.IndexOf(",");
            if (comma >= 0) { one = rest.Substring(0, comma); rest = rest.Substring(comma + 1); }
            else { rest = ""; }
            int bar = one.IndexOf("|");
            if (bar > 0) { one = one.Substring(0, bar); }
            if (sb.Length > 0) { sb.Append(","); }
            sb.Append(one);
        }
        return sb.ToString();
    }
}
