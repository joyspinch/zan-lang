using System;
using System.Data;
using System.Data.Orm;
using System.Text;
using System.Threading;
using System.Web;
using System.Json;
using Zan.Web.Core;
using Zan.Web.Model;
using Zan.Web.Security;
using Zan.Web;

namespace Zan.Web.Admin;

/* 配置驱动的管理屏基座（Modules/Crud）。
 *
 * 子类只做两件事：覆写 Def() 给出 CrudConf 声明；用属性声明各端点的
 * 路由、菜单与权限位并转发到 Do* 方法——转发壳就是全部样板（约 30
 * 行），屏体逻辑零行。业务语义的少数部分经四个钩子注入：
 *   OnSaving(row, isNew)   保存前派生/规整，返回错误文案（"" 通过）
 *   OnDeleting(id)         删除前占用检查，返回错误文案（"" 通过）
 *   OnRows(rows)           列表页投影（计数列、关联名、衍生徽章）
 *   OnSaved(isNew)         保存后副作用（缓存失效等）
 * 此外 Unique() 声明把最常见的"唯一性校验"也配置化，写前检查并排除
 * 自身行。
 *
 * 安全基线与全包一致：表名/列名出自声明，过 Gen.Safe 与 DbTable 的
 * RequireIdent 双保险；值一律占位符参数；行级越权与不存在同答 404；
 * 审计经 Note 落 sys_operation_log；权限位由子类属性壳显式声明，未
 * 声明位的动作不可授权（与调度器同一掩码）。
 */
public class CrudScreenController : AdminController {
    /* 最近一次 LoadKeys 的行键集：结果集列名 + 声明的虚拟列（OnRows
       投影）。StrMap 无键枚举，行 JSON 序列化按此显式键集进行。 */
    protected List<string> rowKeys;

    /* 本屏声明的资源数据域：一次请求解析一次，列表 / 计数 / 详情 / 写入
       共用同一份白名单（详见 Framework/Security/DataGrant.zan）。 */
    protected RowScope rowScope;
    protected string rowScopeKey = "";

    /* 子类必覆写：本屏的完整声明。 */
    protected virtual CrudConf Def() {
        throw new ApiError(500, "9999", "CrudScreenController 未覆写 Def()");
    }

    /* 本屏的资源域；未声明 Scope 返回 null（不启用，旧行为）。 */
    protected async RowScope ScopeRow(CrudConf conf) {
        if (conf.scopeKey.Length == 0) { return null; }
        if (this.rowScope != null && this.rowScopeKey == conf.scopeKey) {
            return this.rowScope;
        }
        DataScope dept = await this.Scope();
        this.rowScope = await DataGrant.Of(
            this.Held(), Filter.ToInt(this.uid, 0), conf.scopeKey, dept);
        this.rowScopeKey = conf.scopeKey;
        return this.rowScope;
    }

    /* 域条件并入查询：未声明或不受限时原样返回；空白名单由 ORM 按恒假
       处理（IN () 不会拼进 SQL）。列名出自声明，值走占位符。 */
    protected async DbTableQuery Scoped(DbTableQuery q, CrudConf conf) {
        RowScope sc = await this.ScopeRow(conf);
        if (sc == null || sc.all) { return q; }
        return q.WhereIn(conf.scopeCol, sc.ids);
    }

    /* 单行是否落在域内。越权与不存在同答 404（不泄露其他店铺 id 的
       存在性）；声明了域却缺列一律拒绝（fail closed）。 */
    protected async bool RowAllowed(CrudConf conf, DbResult r) {
        if (conf.scopeKey.Length == 0) { return true; }
        if (r == null || r.RowCount() == 0) { return false; }
        RowScope sc = await this.ScopeRow(conf);
        if (sc == null || sc.all) { return true; }
        int col = r.GetColumnIndex(conf.scopeCol);
        if (col < 0 || r.IsNull(0, col)) { return false; }
        return sc.Allows(r.GetLong(0, col));
    }

    /* 保存时把资源列钉进域内：受域账号不能把行迁到别的店铺，也不能
       留空——只有一个可见资源时自动归属，多个时必须显式选择。 */
    protected async string BindScope(CrudConf conf, DbValues row) {
        if (conf.scopeKey.Length == 0 || conf.scopeCol.Length == 0) { return ""; }
        RowScope sc = await this.ScopeRow(conf);
        if (sc == null || sc.all) { return ""; }
        long sid = Filter.ToLong(this.InAny(conf.scopeCol).Trim(), 0);
        if (sid <= 0) {
            if (sc.ids.Count == 1) { sid = sc.ids[0]; }
            else { return "请选择" + DataGrant.Label(conf.scopeKey); }
        }
        if (!sc.Allows(sid)) {
            return "数据权限不允许操作该" + DataGrant.Label(conf.scopeKey);
        }
        row.Set(conf.scopeCol, sid);
        return "";
    }

    /* ---- 基座端点（子类属性壳转发到这里） ------------------------ */

    /* 列表屏：声明收集条件 → 计数 → 取页 → 投影钩子 → 整段渲染。 */
    public virtual async Task DoList() {
        CrudConf conf = this.Def();
        ListPage lp = conf.Build(false);
        ViewData d = await this.Layout(conf.Title());
        /* 引擎自家屏渲染走 CrudPage（覆写 Page 的壳），故此处不套 PageReady。 */
        if (!this.DbReady()) { d.Set("dbDown", "1"); this.CrudPage(d); return; }

        List<OrmCond> conds = lp.Collect(this);
        long total = await this.CountRows(conf, conds);
        ListQuery q = this.PagedAny();
        List<StrMap> rows = await this.LoadRows(conf, conds, q);

        int mask = await this.Mask();
        bool canCreate = (mask & (int)PermBit.Create) != 0;
        bool canUpdate = (mask & (int)PermBit.Update) != 0;
        bool canDelete = (mask & (int)PermBit.Delete) != 0;
        lp.Screen(this, d, "/" + conf.path, "/" + conf.path,
            conds, q, (int)total, rows, canCreate, canUpdate, canDelete);
        this.CrudPage(d);
    }

    /* 列表数据（adminUI 契约 POST /list）：分页行 JSON + total，信封
       data = {data:[行],total}——与 ZanTable.getData 的解包形状一致。
       条件仍由声明收集：JSON 体筛选与表单编码共用 InAny 入口。 */
    public virtual async Task DoListData() {
        CrudConf conf = this.Def();
        ListPage lp = conf.Build(false);
        if (!this.DataReady()) { return; }
        List<OrmCond> conds = lp.Collect(this);
        long total = await this.CountRows(conf, conds);
        ListQuery q = this.PagedAny();
        List<StrMap> rows = await this.LoadRows(conf, conds, q);
        JsonWriter w = new JsonWriter();
        w.StartObject();
        w.WriteProperty("total", (int)total);
        w.WriteKey("data");
        WriteRows(w, rows, this.rowKeys);
        w.EndObject();
        Env(this, w.ToString());
    }

    /* 行数据（adminUI 契约 POST /edit）：编辑表单回显取数，信封
       data = 行对象（列名即键 + 声明的虚拟列，值全部文本）。 */
    public virtual async Task DoEdit() {
        CrudConf conf = this.Def();
        int id = this.InAnyInt("id");
        if (id <= 0) { this.Fail(400, "0004", "缺少 id"); }
        DbTable t = DbTable.Of(this.Held(), conf.table);
        DbResult r = await t.ReadAsync("id", id);
        if (r == null || r.RowCount() == 0) { this.Fail(404, "0404", "记录不存在"); }
        if (!await this.RowAllowed(conf, r)) { this.Fail(404, "0404", "记录不存在"); }
        this.LoadKeys(conf, r);
        /* 行对象就地构建（与 DoFormConf 同形）：列名 + 声明的虚拟列，
           虚拟列取空串（编辑回显不投影计数列）。 */
        JsonWriter w = new JsonWriter();
        w.StartObject();
        for (int j = 0; j < this.rowKeys.Count; j = j + 1) {
            int col = r.GetColumnIndex(this.rowKeys[j]);
            string v = "";
            if (col >= 0 && !r.IsNull(0, col)) { v = r.GetString(0, col); }
            w.WriteProperty(this.rowKeys[j], v);
        }
        w.EndObject();
        Env(this, w.ToString());
    }

    /* 表单 schema（adminUI 契约 PUT {api}/formconf）：字段表投影为
       legacy FormConfig（formItems），GeneralForm/schema-adapter 直接
       消费。控件映射 text→input、int→input-number、area→textarea、
       pass→password、opts→select；校验规则同源导出。 */
    public virtual void DoFormConf() {
        CrudConf conf = this.Def();
        JsonWriter w = new JsonWriter();
        w.StartObject();
        w.WriteProperty("title", conf.Title());
        w.WriteProperty("width", "600px");
        w.WriteProperty("labelWidth", 100);
        w.WriteProperty("size", "medium");
        w.WriteProperty("cols", 24);
        w.WriteKey("formItems");
        w.StartArray();
        for (int i = 0; i < conf.forms.Count; i = i + 1) {
            FormField f = conf.forms[i];
            w.StartObject();
            w.WriteProperty("field", f.name);
            w.WriteProperty("label", f.label);
            string comp = "input";
            if (f.kind == "int") { comp = "input-number"; }
            else if (f.kind == "area") { comp = "textarea"; }
            else if (f.kind == "pass") { comp = "password"; }
            else if (f.kind == "select") { comp = "select"; }
            w.WriteProperty("component", comp);
            w.WriteProperty("span", f.span ? 24 : 12);
            w.WriteProperty("required", f.required);
            if (f.ph.Length > 0) { w.WriteProperty("placeholder", f.ph); }
            if (f.value.Length > 0) { w.WriteProperty("defaultValue", f.value); }
            if (f.kind == "select") {
                w.WriteKey("options");
                WriteSelectOpts(w, f.options);
            }
            w.WriteKey("rules");
            WriteRules(w, f);
            w.EndObject();
        }
        w.EndArray();
        w.EndObject();
        Env(this, w.ToString());
    }

    /* 通用屏共享一份视图（views/Admin/CrudScreenController.Index.html，键即基座自身的约定视图键）：screenHtml 整段由
       ListPage 产出，整页/面板双形态与 Page() 同一分支。 */
    public void CrudPage(ViewData d) {
        if (this.IsFragment()) {
            this.Ctx().SetHeader("X-Tab-Title", Encoding.UrlEncode(this.headingText));
            this.FragmentOf("Admin.CrudScreenController.Index", d);
            return;
        }
        this.ViewOf("Admin.CrudScreenController.Index", d);
    }

    /* adminUI ZanTable 表格配置（列/筛选/工具栏与列表同源产出）。 */
    public virtual void DoConf() {
        CrudOps.Conf(this, this.Def().Build(false));
    }

    /* 表单对话框：FormPage 产出表单体，共享壳 Admin._FormDialog 渲染；
       编辑时按行回显（pass 字段恒不回显）。 */
    public virtual async Task DoForm() {
        CrudConf conf = this.Def();
        int id = this.InAnyInt("id");
        bool isEdit = id > 0;
        if (!await this.Can(isEdit ? (int)PermBit.Update : (int)PermBit.Create)) {
            this.Fail(403, "0403", "无操作权限"); return;
        }
        FormPage fp = conf.ToFormPage(isEdit ? Convert.ToString(id) : "0");
        ViewData d = new ViewData();
        d.Set("dialogTitle", (isEdit ? Lang.T("编辑") : Lang.T("新增")) + Lang.T(conf.title));
        if (isEdit) {
            DbResult r = await DbTable.Of(this.Held(), conf.table).ReadAsync("id", id);
            if (r == null || r.RowCount() == 0) { this.Fail(404, "0404", "记录不存在"); }
            if (!await this.RowAllowed(conf, r)) { this.Fail(404, "0404", "记录不存在"); }
            for (int i = 0; i < conf.forms.Count; i = i + 1) {
                FormField f = conf.forms[i];
                if (f.name.Length == 0 || f.kind == "pass" || f.kind == "hint") { continue; }
                int col = r.GetColumnIndex(f.name);
                if (col < 0) { continue; }
                fp.Field(f.name).Val(r.GetString(0, col));
            }
        }
        /* 资源列渲染成"只含可见资源"的下拉：受域账号不该手填店铺 id，
           也不该在下拉里看见别人的店铺。 */
        if (conf.scopeKey.Length > 0 && conf.scopeCol.Length > 0) {
            RowScope sc = await this.ScopeRow(conf);
            if (sc != null) {
                bool declared = false;
                for (int i = 0; i < conf.forms.Count; i = i + 1) {
                    if (conf.forms[i].name == conf.scopeCol) { declared = true; }
                }
                if (declared) {
                    string opts = await DataGrant.Options(this.Held(), conf.scopeKey, sc, 300);
                    fp.Field(conf.scopeCol).AsSelect(opts);
                }
            }
        }
        fp.Render(d);
        this.FormDialog(d);
    }

    /* 保存：表单校验（FormPage 同源规则）→ 写白名单绑定 → 唯一约束 →
       OnSaving 钩子 → 插入/更新 → 审计 → OnSaved 钩子。 */
    public virtual async Task DoSave() {
        CrudConf conf = this.Def();
        int id = this.InAnyInt("id");
        bool isNew = id <= 0;
        if (!await this.Can(isNew ? (int)PermBit.Create : (int)PermBit.Update)) {
            this.Fail(403, "0403", "无操作权限"); return;
        }
        ListPage lp = conf.Build(false);
        FormPage fp = conf.ToFormPage(isNew ? "0" : Convert.ToString(id));
        string err = fp.Validate(this);
        if (err.Length > 0) { this.Fail(400, "0004", err); }

        DbValues row = new DbValues();
        for (int i = 0; i < conf.forms.Count; i = i + 1) {
            FormField f = conf.forms[i];
            if (f.name.Length == 0) { continue; }
            if (f.kind == "pass" && !isNew && this.In(f.name).Length == 0) { continue; }
            StrMap def = CrudOps.Find(lp, f.name);
            if (def == null) {
                this.Fail(500, "9999", "表单字段 " + f.name + " 未列入 EditFields 写白名单");
            }
            string v = this.InAny(f.name);
            if (def.Get("type") == "int") { row.Set(f.name, Filter.ToLong(v, 0)); }
            else { row.Set(f.name, v); }
        }
        long now = WebApp.NowSeconds();
        if (isNew && conf.stampCreated.Length > 0) { row.Set(conf.stampCreated, now); }
        if (conf.stampUpdated.Length > 0) { row.Set(conf.stampUpdated, now); }

        DbTable t = DbTable.Of(this.Held(), conf.table);
        List<string> onlyId = new List<string>();
        onlyId.Add("id");
        /* 编辑：先确认目标行落在域内，再确认新值仍在域内——防止把
           别人的行改到自己名下，或把自己的行改到别人名下。 */
        if (!isNew) {
            DbResult cur = await t.ReadAsync("id", id);
            if (cur == null || cur.RowCount() == 0) { this.Fail(404, "0404", "记录不存在"); }
            if (!await this.RowAllowed(conf, cur)) { this.Fail(404, "0404", "记录不存在"); }
        }
        string scopeWhy = await this.BindScope(conf, row);
        if (scopeWhy.Length > 0) { this.Fail(403, "0403", scopeWhy); }
        for (int i = 0; i < conf.uniques.Count; i = i + 1) {
            StrMap u = conf.uniques[i];
            string col = u.Get("col");
            string val = this.In(col);
            if (val.Length == 0) { continue; }
            /* 唯一性检查并入域：与域外行同值不报"重复"（当作不存在），
               否则受域账号能用 400 探测域外有没有某值——存在性泄露，
               破坏"越权与不存在同答"的口径。域内 DB 级唯一约束兜底。 */
            DbTableQuery uq = await this.Scoped(t.Query(), conf);
            DbResult ur = await uq.WhereEq(col, val).ToResultAsync(onlyId);
            if (ur == null) { continue; }
            for (int j = 0; j < ur.RowCount(); j = j + 1) {
                if (ur.GetLong(j, 0) != id) { this.Fail(400, "0004", u.Get("msg")); }
            }
        }

        string why = this.OnSaving(row, isNew);
        if (why.Length > 0) { this.Fail(400, "0004", why); }

        int n;
        if (isNew) { n = await t.InsertAsync(row); }
        else { n = await t.UpdateAsync(row, "id", id); }
        await this.Note(conf.title + (isNew ? "·新增" : "·编辑"),
            this.RowTarget(conf, id), n > 0, "");
        await this.OnSaved(isNew);
        this.Saved(Lang.T("已保存"));
    }

    /* 删除：行存在（不存在同答 404，不泄露其他 id 的存在性）→ 占用
       钩子 → 经 CrudOps 网关删除并审计。 */
    public virtual async Task DoDelete() {
        CrudConf conf = this.Def();
        int id = this.InAnyInt("id");
        ListPage lp = conf.Build(false);
        DbResult r = await DbTable.Of(this.Held(), conf.table).ReadAsync("id", id);
        if (r == null || r.RowCount() == 0) { this.Fail(404, "0404", "记录不存在"); }
        if (!await this.RowAllowed(conf, r)) { this.Fail(404, "0404", "记录不存在"); }
        string why = await this.OnDeleting(id);
        if (why.Length > 0) { this.Fail(400, "0004", why); }
        List<int> allowed = new List<int>();
        allowed.Add(id);
        await CrudOps.Delete(this, lp, allowed, conf.title + "·删除");
        await this.OnDeleted(id);
    }

    /* 批量：value 为空 → 批量删除；否则写 toggleField（批量启停等
       "同一列一个值"）。删除前逐行核对存在性和占用，删除后逐行触发
       子表/缓存副作用；权限按实际分支复核。 */
    public virtual async Task DoBatch() {
        CrudConf conf = this.Def();
        string value = this.InAny("value");
        if (!await this.Can(value.Length == 0 ? (int)PermBit.Delete : (int)PermBit.Update)) {
            this.Fail(403, "0403", "无操作权限"); return;
        }
        List<int> ids = this.IdsAny();
        ListPage lp = conf.Build(true);
        if (value.Length == 0) {
            if (ids.Count == 0) { this.Fail(400, "0004", "未选择记录"); return; }
            DbTable t = DbTable.Of(this.Held(), conf.table);
            List<int> checkedIds = new List<int>();
            for (int i = 0; i < ids.Count; i = i + 1) {
                int id = ids[i];
                if (checkedIds.Contains(id)) { continue; }
                DbResult r = await t.ReadAsync("id", id);
                if (r == null || r.RowCount() == 0) {
                    this.Fail(404, "0404", "记录不存在"); return;
                }
                if (!await this.RowAllowed(conf, r)) {
                    this.Fail(404, "0404", "记录不存在"); return;
                }
                string why = await this.OnDeleting(id);
                if (why.Length > 0) { this.Fail(400, "0004", why); return; }
                checkedIds.Add(id);
            }
            await CrudOps.Delete(this, lp, checkedIds, conf.title + "·批量删除");
            for (int i = 0; i < checkedIds.Count; i = i + 1) {
                await this.OnDeleted(checkedIds[i]);
            }
            return;
        }
        string bad = this.CheckValue(conf, conf.toggleField, value);
        if (bad.Length > 0) { this.Fail(400, "0004", bad); }
        /* 批量启停同样逐行校验域：ids 里混入域外行时整批拒绝，不做
           "能改的改、不能改的跳过"——半成功比失败更难解释。 */
        if (conf.scopeKey.Length > 0) {
            DbTable tt = DbTable.Of(this.Held(), conf.table);
            for (int i = 0; i < ids.Count; i = i + 1) {
                DbResult r = await tt.ReadAsync("id", ids[i]);
                if (r == null || r.RowCount() == 0 || !await this.RowAllowed(conf, r)) {
                    this.Fail(404, "0404", "记录不存在"); return;
                }
            }
        }
        await CrudOps.Batch(this, lp, conf.toggleField, value, ids, conf.title + "·批量");
        await this.OnBatched(conf.toggleField, value, ids);
    }

    /* 行内单字段修改：field 必须在行内白名单内，行必须存在。 */
    public virtual async Task DoField() {
        CrudConf conf = this.Def();
        int id = this.InAnyInt("id");
        if (id <= 0) {
            /* adminUI fieldAsync 把整行放 data 里提交：{data:{id:..},
               field, value}。基于 JsonDoc 深度路径直取，零 DOM 堆分配。 */
            id = this.JsonInt("data.id", 0);
        }
        string field = this.InAny("field");
        if (field.Length == 0) { this.Fail(400, "0004", "属性不能为空"); }
        string value = this.InAny("value");
        ListPage lp = conf.Build(true);
        DbResult r = await DbTable.Of(this.Held(), conf.table).ReadAsync("id", id);
        if (r == null || r.RowCount() == 0) { this.Fail(404, "0404", "记录不存在"); }
        if (!await this.RowAllowed(conf, r)) { this.Fail(404, "0404", "记录不存在"); }
        string bad = this.CheckValue(conf, field, value);
        if (bad.Length > 0) { this.Fail(400, "0004", bad); }
        /* 归属列行内改与保存同规：新值必须落在域内，防止把行迁出域
           （横向越权写）——BindScope 在保存通道的承诺，行内通道同样成立。 */
        if (field == conf.scopeCol && conf.scopeKey.Length > 0) {
            RowScope fsc = await this.ScopeRow(conf);
            if (fsc != null && !fsc.all) {
                long sid = Filter.ToLong(value.Trim(), 0);
                if (sid <= 0 || !fsc.Allows(sid)) {
                    this.Fail(403, "0403", "数据权限不允许操作该" + DataGrant.Label(conf.scopeKey));
                }
            }
        }
        List<int> allowed = new List<int>();
        allowed.Add(id);
        await CrudOps.Field(this, lp, conf.title, field, value, allowed);
        await this.OnFielded(field, id);
    }

    /* 选项端点（data-pick 契约）：?id= 单条回显、?kw= 文案包含匹配，
       最多 20 条；文案列由 Label() 声明。 */
    public virtual async Task DoOptions() {
        CrudConf conf = this.Def();
        if (conf.labelCol.Length == 0) {
            this.Fail(500, "9999", "本屏未声明 Label() 选项列");
        }
        string kw = this.In("kw").Trim();
        string idv = this.In("id").Trim();
        DbTable t = DbTable.Of(this.Held(), conf.table);
        if (idv.Length > 0) {
            DbResult r = await t.Query().WhereEq("id", Filter.ToLong(idv, 0))
                .Limit(1).ToResultAsync();
            JsonWriter w = new JsonWriter();
            w.StartObject();
            if (r != null && r.RowCount() > 0 && await this.RowAllowed(conf, r)) {
                w.WriteProperty("id", Filter.ToInt(idv, 0));
                w.WriteProperty("label", r.GetString(0, r.GetColumnIndex(conf.labelCol)));
            }
            w.EndObject();
            this.Ctx().Api(Codes.Ok, "ok", w.ToString());
            return;
        }
        DbTableQuery q = t.Query();
        q = await this.Scoped(q, conf);
        if (kw.Length > 0) { q = q.WhereContains(conf.labelCol, kw); }
        DbResult rows = await q.OrderBy(conf.orderCol).Limit(20).ToResultAsync();
        JsonWriter wArr = new JsonWriter();
        wArr.StartArray();
        if (rows != null) {
            int idc = rows.GetColumnIndex("id");
            int lbc = rows.GetColumnIndex(conf.labelCol);
            for (int i = 0; i < rows.RowCount(); i = i + 1) {
                wArr.StartObject();
                wArr.WriteProperty("id", rows.GetInt(i, idc));
                wArr.WriteProperty("label", rows.GetString(i, lbc));
                wArr.EndObject();
            }
        }
        wArr.EndArray();
        this.Ctx().Api(Codes.Ok, "ok", wArr.ToString());
    }

    /* ---- 钩子（子类按需覆写） ------------------------------------ */

    /* 保存前派生/规整（改写 row），返回错误文案，"" = 通过。 */
    public virtual string OnSaving(DbValues row, bool isNew) { return ""; }

    /* 删除前占用检查，返回错误文案，"" = 通过。 */
    protected virtual async string OnDeleting(long id) { return ""; }

    /* 列表页投影：为行补计数列/关联名/衍生徽章；返回同一批行。 */
    protected virtual async List<StrMap> OnRows(List<StrMap> rows) { return rows; }

    /* 保存后副作用（缓存失效、联动重算）。 */
    public virtual async Task OnSaved(bool isNew) { }

    /* 行内单字段写后副作用（镜像重读、公开缓存失效）。 */
    public virtual async Task OnFielded(string field, long id) { }

    /* 批量启停写后副作用（OnFielded 的批量版）。 */
    public virtual async Task OnBatched(string field, string value, List<int> ids) { }

    /* 单行删除后副作用（子表级联、镜像重读；占用检查在 OnDeleting）。 */
    protected virtual async Task OnDeleted(long id) { }

    /* 行内/批量写值校验：select 列查选项白名单，int 列查 Min/Max 界限
       ——声明即约束，不因走行内/批量通道而绕过表单同款的界限。 */
    public string CheckValue(CrudConf conf, string field, string value) {
        for (int i = 0; i < conf.forms.Count; i = i + 1) {
            FormField f = conf.forms[i];
            if (f.name != field) { continue; }
            if (f.kind == "select" && f.options.Length > 0) {
                string rest = f.options;
                while (rest.Length > 0) {
                    string one = rest;
                    int comma = rest.IndexOf(",");
                    if (comma >= 0) {
                        one = rest.Substring(0, comma);
                        rest = rest.Substring(comma + 1);
                    } else { rest = ""; }
                    int eq = one.IndexOf("=");
                    if ((eq > 0 ? one.Substring(0, eq) : one) == value) {
                        return "";
                    }
                }
                return "值不在可选项内";
            }
            if (f.type == "int") {
                long n = Filter.ToLong(value, 0);
                if (f.min > 0 && n < f.min) {
                    return "不能小于 " + Convert.ToString(f.min);
                }
                if (f.max > 0 && n > f.max) {
                    return "不能大于 " + Convert.ToString(f.max);
                }
                return "";
            }
            if (f.max > 0 && value.Length > f.max) {
                return "不能超过 " + Convert.ToString(f.max) + " 个字符";
            }
            return "";
        }
        return "";
    }

    /* ---- 内部 ---------------------------------------------------- */

    /* 计数：声明条件下的总行数（分页不参与）。 */
    public async long CountRows(CrudConf conf, List<OrmCond> conds) {
        DbTable t = DbTable.Of(this.Held(), conf.table);
        DbTableQuery q = Apply(t.Query(), conds);
        q = await this.Scoped(q, conf);
        return await q.CountAsync();
    }

    /* 取页：条件 + 排序 + 分页，行投影过 OnRows 钩子；同时记下本页
       键集（供行 JSON 序列化）。 */
    public async List<StrMap> LoadRows(CrudConf conf, List<OrmCond> conds, ListQuery q) {
        DbTable t = DbTable.Of(this.Held(), conf.table);
        DbTableQuery rq = Apply(t.Query(), conds);
        rq = await this.Scoped(rq, conf);
        if (conf.orderDesc) { rq = rq.OrderByDesc(conf.orderCol); }
        else { rq = rq.OrderBy(conf.orderCol); }
        DbResult r = await rq.Page(q.Limit(), q.Skip()).ToResultAsync();
        this.LoadKeys(conf, r);
        List<StrMap> rows = StrMaps(r);
        return await this.OnRows(rows);
    }

    /* 行键集 = 结果集列名 + 声明的虚拟列（去重）。 */
    public void LoadKeys(CrudConf conf, DbResult r) {
        List<string> keys = new List<string>();
        if (r != null) {
            for (int j = 0; j < r.columnNames.Count; j = j + 1) {
                keys.Add(r.columnNames[j]);
            }
        }
        for (int i = 0; i < conf.vcols.Count; i = i + 1) {
            bool has = false;
            for (int j = 0; j < keys.Count; j = j + 1) {
                if (keys[j] == conf.vcols[i]) { has = true; break; }
            }
            if (!has) { keys.Add(conf.vcols[i]); }
        }
        this.rowKeys = keys;
    }

    /* 分页参数兼容：自研壳 page/limit 走 query；adminUI 系 page/
       pageSize 走 JSON 体。把 JSON 侧合并进 query（Paged 与分页链接
       统一读取），query 已有值时不覆盖。 */
    public ListQuery PagedAny() {
        StrMap query = this.Ctx().query;
        string page = this.InAny("page");
        if (page.Length > 0 && query.Get("page").Length == 0) {
            query.Set("page", page);
        }
        string size = this.InAny("pageSize");
        if (size.Length > 0 && query.Get("limit").Length == 0) {
            query.Set("limit", size);
        }
        return this.Paged("id", 20);
    }

    /* 批量 id 列表：CSV（自研壳）或 JSON 数组（adminUI 系）皆收，只
       收正 id、上限 500——与 AdminController.Ids 同一钳制。 */
    public List<int> IdsAny() {
        List<int> out_ = new List<int>();
        string csv = this.InAny("ids").Trim();
        if (csv.Length > 0) {
            List<string> parts = csv.Split(",");
            for (int i = 0; i < parts.Count && out_.Count < 500; i = i + 1) {
                string p = parts[i].Trim();
                if (p.Length == 0 || p.Length > 9) { continue; }
                int v = Filter.ToInt(p, 0);
                if (v > 0) { out_.Add(v); }
            }
            return out_;
        }
        JsonDoc doc = this.Ctx().JsonDoc();
        if (doc == null) { return out_; }
        int arr = doc.Get(doc.root, "ids");
        if (arr < 0) { return out_; }
        int c = doc.FirstChild(arr);
        int count = doc.Count(arr);
        for (int i = 0; i < count && out_.Count < 500 && c >= 0; i = i + 1) {
            int v = doc.IntAt(c, 0);
            if (v > 0) { out_.Add(v); }
            c = doc.NextSibling(c);
        }
        return out_;
    }

    /* adminUI 统一信封（与 CrudOps.Conf 同形）：resp_code "0000" 为成功。 */
    private static void Env(AdminController c, string dataJson) {
        JsonWriter w = new JsonWriter();
        w.StartObject();
        w.WriteProperty("resp_code", "0000");
        w.WriteProperty("status", 200);
        w.WriteProperty("msg", "ok");
        w.WriteProperty("url", "");
        w.WriteProperty("dynamicToken", "");
        w.WriteProperty("t", 0);
        if (dataJson.Length > 0) {
            w.WriteRawProperty("data", dataJson);
        }
        w.EndObject();
        c.Json(w.ToString());
    }

    /* 行 → JSON 数组：按显式键集序列化，值全部文本（NULL 一律空串）。 */
    private static void WriteRows(JsonWriter w, List<StrMap> rows, List<string> keys) {
        w.StartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            w.StartObject();
            for (int j = 0; j < keys.Count; j = j + 1) {
                w.WriteProperty(keys[j], rows[i].Get(keys[j]));
            }
            w.EndObject();
        }
        w.EndArray();
    }

    /* "1=显示,0=隐藏" → [{value,label}]（下拉选项 JSON）。 */
    private static void WriteSelectOpts(JsonWriter w, string opts) {
        w.StartArray();
        string rest = opts;
        while (rest.Length > 0) {
            string pair = rest;
            int comma = rest.IndexOf(",");
            if (comma >= 0) { pair = rest.Substring(0, comma); rest = rest.Substring(comma + 1); }
            else { rest = ""; }
            int eq = pair.IndexOf("=");
            if (eq <= 0) { continue; }
            w.StartObject();
            w.WriteProperty("value", pair.Substring(0, eq));
            w.WriteProperty("label", pair.Substring(eq + 1));
            w.EndObject();
        }
        w.EndArray();
    }

    /* FormField → 校验规则 JSON（adminUI FormRule 形状，与 FormPage.
       Validate 同一规则集：required/min/max/pattern）。 */
    private static void WriteRules(JsonWriter w, FormField f) {
        w.StartArray();
        if (f.required) {
            w.StartObject();
            w.WriteProperty("required", true);
            w.WriteProperty("message", Lang.T(f.label) + Lang.T("不能为空"));
            w.EndObject();
        }
        if (f.min > 0) {
            w.StartObject();
            w.WriteProperty("min", f.min);
            w.WriteProperty("message", Lang.T(f.label) + Lang.T("长度不足"));
            w.EndObject();
        }
        if (f.max > 0) {
            w.StartObject();
            w.WriteProperty("max", f.max);
            w.WriteProperty("message", Lang.T(f.label) + Lang.T("超出长度"));
            w.EndObject();
        }
        if (f.pattern.Length > 0) {
            w.StartObject();
            w.WriteProperty("pattern", f.pattern);
            w.WriteProperty("message", Lang.T(f.label) + Lang.T("格式不正确"));
            w.EndObject();
        }
        w.EndArray();
    }

    /* 审计目标：Label() 列的提交值优先（人可读），否则 #id。 */
    public string RowTarget(CrudConf conf, int id) {
        if (conf.labelCol.Length > 0) {
            string v = this.In(conf.labelCol).Trim();
            if (v.Length > 0) { return v; }
        }
        return "#" + Convert.ToString(id);
    }

    /* OrmCond → DbTableQuery：LIKE→包含、EQ→等值、GE/LE→整型边界。
       列名出自声明，值全部占位符绑定——与实体 ORM 的 WhereConds 同一
       语义，落在运行期表网关上。 */
    private static DbTableQuery Apply(DbTableQuery q, List<OrmCond> conds) {
        for (int i = 0; i < conds.Count; i = i + 1) {
            OrmCond c = conds[i];
            if (c.kind == "LIKE") { q = q.WhereContains(c.col, c.value); }
            else if (c.kind == "EQ") { q = q.WhereEq(c.col, c.value); }
            else if (c.kind == "GE") { q = q.WhereGe(c.col, Filter.ToLong(c.value, 0)); }
            else if (c.kind == "LE") { q = q.WhereLe(c.col, Filter.ToLong(c.value, 0)); }
        }
        return q;
    }

    /* DbResult → 行 StrMap 列表：列名即键（与 Col 声明的 field 对应），
       NULL 一律空串。 */
    private static List<StrMap> StrMaps(DbResult r) {
        List<StrMap> out_ = new List<StrMap>();
        if (r == null) { return out_; }
        for (int i = 0; i < r.RowCount(); i = i + 1) {
            StrMap row = new StrMap();
            for (int j = 0; j < r.columnNames.Count; j = j + 1) {
                if (r.IsNull(i, j)) { continue; }
                row.Set(r.columnNames[j], r.GetString(i, j));
            }
            out_.Add(row);
        }
        return out_;
    }
}
