using System;

namespace ZanWeb.Modules.Crud.Controller.Admin.Dev;

class ColumnDraft {
        List<SysGenColumn> cols;
        int dropped;
    }

    /* 把清单（模型或浏览器回传）重验成设计行：名字合法性、kind/widget 白名单、
       关联表必须真实存在、标志位归一、与已有字段及批内互不重名。无效项丢弃。 */
    static ColumnDraft Sanitize(JsonValue arr, List<SysGenColumn> existing,
                                List<SysGenTable> tables) {
        ColumnDraft outp = new ColumnDraft();
        outp.cols = new List<SysGenColumn>();
        outp.dropped = 0;
        List<string> taken = new List<string>();
        for (int i = 0; i < existing.Count; i = i + 1) {
            taken.Add(existing[i].name);
        }
        for (int i = 0; i < arr.Count(); i = i + 1) {
            JsonValue o = arr.At(i);
            if (o == null || !o.IsObject()) { outp.dropped = outp.dropped + 1; continue; }
            string name = o.Str("name", "").Trim();
            if (!Gen.SafeCode(name) || taken.Contains(name)) {
                outp.dropped = outp.dropped + 1;
                continue;
            }
            string kind = o.Str("kind", "").Trim();
            if (!InList(kind, "string,text,int,long,decimal,bool,datetime")) {
                kind = "string";
            }
            string widget = o.Str("widget", "").Trim();
            if (!InList(widget,
                    "text,textarea,number,select,switch,date,richtext,upload")) {
                widget = WidgetOf(kind);
            }
            SysGenColumn c = new SysGenColumn();
            c.name = name;
            c.label = Clip(o.Str("label", "").Trim(), 64);
            if (c.label.Length == 0) { c.label = name; }
            c.kind = kind;
            long size = o.Long("size", 255);
            if (size < 1 || size > 4000) { size = 255; }
            c.size = (int)size;
            c.defValue = Clip(o.Str("defValue", ""), 255);
            c.widget = widget;
            c.dictType = "";
            string dict = o.Str("dictType", "").Trim();
            if (dict.Length > 0 && Gen.Safe(dict)) { c.dictType = dict; }
            c.relTable = "";
            c.relValue = "";
            c.relLabel = "";
            string rel = o.Str("relTable", "").Trim();
            bool known = false;
            if (Gen.Safe(rel)) {
                for (int k = 0; k < tables.Count; k = k + 1) {
                    if (tables[k].tableName == rel) { known = true; break; }
                }
            }
            if (known) {
                c.relTable = rel;
                c.relValue = Clip(o.Str("relValue", "").Trim(), 64);
                if (!Gen.Safe(c.relValue)) { c.relValue = "id"; }
                c.relLabel = Clip(o.Str("relLabel", "").Trim(), 64);
                if (!Gen.Safe(c.relLabel)) { c.relLabel = "name"; }
            }
            long so = o.Long("sortOrder", 0 - 1);
            if (so < 0) { so = Filter.ToInt(o.Str("sortOrder", ""), 10); }
            c.sortOrder = (int)(so > 0 ? so : 10);
            c.nullable = FlagOf(o, "nullable", 0);
            c.inList = FlagOf(o, "inList", 1);
            c.inFilter = FlagOf(o, "inFilter", 0);
            c.inCreate = FlagOf(o, "inCreate", 1);
            c.inEdit = FlagOf(o, "inEdit", 1);
            c.inQuick = FlagOf(o, "inQuick", 1);
            c.required = FlagOf(o, "required", 0);
            taken.Add(name);
            outp.cols.Add(c);
        }
        return outp;
    }

    static JsonValue ColumnJson(SysGenColumn c) {
        JsonValue o = JsonValue.NewObject();
        o.Put("name", JsonValue.NewStr(c.name));
        o.Put("label", JsonValue.NewStr(c.label));
        o.Put("kind", JsonValue.NewStr(c.kind));
        o.Put("widget", JsonValue.NewStr(c.widget));
        o.Put("size", MetricsCluster.Num(c.size));
        o.Put("defValue", JsonValue.NewStr(c.defValue));
        o.Put("dictType", JsonValue.NewStr(c.dictType));
        o.Put("relTable", JsonValue.NewStr(c.relTable));
        o.Put("relValue", JsonValue.NewStr(c.relValue));
        o.Put("relLabel", JsonValue.NewStr(c.relLabel));
        o.Put("required", MetricsCluster.Num(c.required));
        o.Put("nullable", MetricsCluster.Num(c.nullable));
        o.Put("inList", MetricsCluster.Num(c.inList));
        o.Put("inFilter", MetricsCluster.Num(c.inFilter));
        o.Put("inCreate", MetricsCluster.Num(c.inCreate));
        o.Put("inEdit", MetricsCluster.Num(c.inEdit));
        o.Put("inQuick", MetricsCluster.Num(c.inQuick));
        o.Put("sortOrder", MetricsCluster.Num(c.sortOrder));
        return o;
    }

    /* s 在词表（逗号分隔）中吗。 */
    static bool InList(string s, string csv) {
        if (s.Length == 0) { return false; }
        return ("," + csv + ",").Contains("," + s + ",");
    }

    /* 类型缺省控件：与手填表单的直觉一致。 */
    static string WidgetOf(string kind) {
        if (kind == "bool") { return "switch"; }
        if (kind == "text") { return "textarea"; }
        if (kind == "int" || kind == "long" || kind == "decimal") { return "number"; }
        if (kind == "datetime") { return "date"; }
        return "text";
    }

    static string Clip(string s, int max) {
        if (s.Length <= max) { return s; }
        return s.Substring(0, max);
    }

    /* JSON 标志位：数字 0/1、文本 "1"/"true"/"false" 都认，认不出用默认。 */
    static int FlagOf(JsonValue o, string key, int def) {
        long n = o.Long(key, def);
        if (n == 1) { return 1; }
        if (n == 0) { return 0; }
        string s = o.Str(key, "").ToLower();
        if (s == "1" || s == "true") { return 1; }
        if (s == "0" || s == "false") { return 0; }
        return def;
    }

    /* 将设计应用到数据库：创建表，或补其缺失列。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("同步到数据库")]
    async void Migrate() {
        int id = this.InInt("id", 0);
        SysGenTable t = await this.SysGenTable.ById(id);
        if (t == null) { this.Fail(404, "0404", "设计不存在"); }
        List<SysGenColumn> cols = await this.SysGenColumn
            .Where(a => a.tableId == id).OrderBy(a => a.sortOrder).ToListAsync();
        if (cols.Count == 0) { this.Fail(400, "0004", "先添加字段"); }
        if (!Gen.Valid(t, cols)) { this.Fail(400, "0004", "表或字段设计不合法"); }
        IDbConnection db = await this.Conn();
        if (db == null) { this.Fail(503, "2001", "数据库不可用"); }
        if (t.migrated != 1 && await DbSchema.TableExistsAsync(db, t.tableName)) {
            this.Fail(409, "0004", "数据库中已存在同名表，不能由设计器接管");
        }

        int changed = await Gen.Migrate(db, t, cols);
        int _u = await this.SysGenTable.Update()
            .Set(a => a.migrated, 1)
            .Set(a => a.updatedAt, WebApp.NowSeconds())
            .Where(a => a.id == id).ExecuteAffrowsAsync();
        await this.Note("同步表结构", t.tableName, true,
            Convert.ToString(changed) + " 列");
        this.Saved("已同步到数据库，可以在「数据管理」里维护数据了");
    }

    /* 写出生成源码；须重建后生效，消息直接说明而非暗示已在运行中变更。
       force=1 时覆盖既有目标（仅 Design 页「覆盖重新生成」按钮显式确认后走）。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("生成代码")]
    async void Build() {
        int id = this.InInt("id", 0);
        int force = this.InInt("force", 0);
        SysGenTable t = await this.SysGenTable.ById(id);
        if (t == null) { this.Fail(404, "0404", "设计不存在"); }
        List<SysGenColumn> cols = await this.SysGenColumn
            .Where(a => a.tableId == id).OrderBy(a => a.sortOrder).ToListAsync();
        if (cols.Count == 0) { this.Fail(400, "0004", "先添加字段"); }
        if (!Gen.Valid(t, cols)) { this.Fail(400, "0004", "表或字段设计不合法"); }
        /* 关联下拉/远程筛选只对设计器里真实存在的表喂数；把设计行原样传给
           生成器（Pick 需要关联表的路由）。 */
        List<SysGenTable> tabs = await this.SysGenTable.OrderBy(a => a.id).ToListAsync();

        /* gen.root 相对当前服务工作目录解释（开发时从 build/ 运行，".." 即项目根）；
           生产发布目录没有 src/views 布局，必须在站点设置里配置真实源码根目录。 */
        string root = (await Settings.Get(SettingKeys.GenRoot, "..")).Trim();
        if (root.Length == 0) {
            this.Fail(400, "0004", "未配置源码目录，请在站点设置的「开发」中填写 gen.root");
            return;
        }
        if (!Directory.ExistsOnDisk(root + "/src")
            || !Directory.ExistsOnDisk(root + "/views")) {
            this.Fail(400, "0004", "gen.root 不是应用源码根目录（需要已有 src 和 views）："
                + root + "；请在站点设置的「开发」中配置");
            return;
        }
        try {
            Directory.CreateDirectoryRecursive(root + "/src/Model/Gen");
            Directory.CreateDirectoryRecursive(root + "/src/Controller/Admin");
            if (t.apiEnabled == 1) { Directory.CreateDirectoryRecursive(root + "/src/Controller/Api"); }
            Directory.CreateDirectoryRecursive(root + "/src/Dao/Gen");
            Directory.CreateDirectoryRecursive(root + "/views/Admin");
        } catch (Exception ex) {
            this.Fail(500, "2001", "无法创建源码目录（gen.root=" + root + "）：" + ex.Message);
            return;
        }
        List<string> paths = TargetPaths(t, root);
        for (int i = 0; i < paths.Count; i = i + 1) {
            if (!force && (File.Exists(paths[i]) || Directory.ExistsOnDisk(paths[i]))) {
                this.Fail(409, "0004", "生成目标已存在：" + paths[i]
                    + "；如需覆盖请在字段设计页用「覆盖重新生成」");
                return;
            }
        }
        List<string> sources = SourceList(t, cols, tabs);
        try {
            WriteSources(paths, sources, force == 1);
        } catch (Exception ex) {
            this.Fail(500, "2001", "生成文件失败（gen.root=" + root + "）：" + ex.Message);
            return;
        }

        /* 生成文件尚未编译部署，通用数据入口仍须保留。 */
        await this.Note("生成代码", t.tableName, true, paths[1]);
        this.Saved("已生成 " + Convert.ToString(paths.Count) + " 个文件到 " + root
            + "（" + FileMix(t) + "），"
            + "请将源码纳入工程并重新编译后生效");
    }

    /* 生成源码清单，顺序与 TargetPaths 一一对应：模型/后台控制器/Dao/后台
       视图×2 恒有；apiEnabled=1 加 JSON 接口。 */
    static List<string> SourceList(SysGenTable t, List<SysGenColumn> cols,
        List<SysGenTable> designed) {
        List<string> sources = new List<string>();
        sources.Add(Gen.ModelSource(t, cols));
        sources.Add(Gen.ControllerSource(t, cols, designed));
        sources.Add(Gen.DaoSource(t, cols));
        sources.Add(Gen.ListViewSource(t, cols));
        sources.Add(Gen.FormViewSource(t, cols, designed));
        if (t.apiEnabled == 1) { sources.Add(Gen.ApiSource(t, cols, designed)); }
        return sources;
    }

    /* 文件构成说明（保存消息用）。 */
    static string FileMix(SysGenTable t) {
        string mix = "模型/后台控制器/Dao/后台视图×2";
        if (t.apiEnabled == 1) { mix = mix + "/JSON接口"; }
        return mix;
    }

    /* Directory=URL 前缀，file=class+Controller=route 段落=view 键段，生成表与手写表同构。 */
    static List<string> TargetPaths(SysGenTable t, string root) {
        List<string> paths = new List<string>();
        paths.Add(root + "/src/Model/Gen/" + t.entityName + ".zan");
        paths.Add(root + "/src/Controller/Admin/" + t.entityName + "Controller.zan");
        paths.Add(root + "/src/Dao/Gen/" + t.entityName + "Dao.zan");
        paths.Add(root + "/views/Admin/" + t.entityName + "Controller.Index.html");
        paths.Add(root + "/views/Admin/" + t.entityName + "Controller.Form.html");
        if (t.apiEnabled == 1) {
            paths.Add(root + "/src/Controller/Api/" + t.entityName + "ApiController.zan");
        }
        return paths;
    }

    /* 先写同目录临时文件，再用硬链接独占发布；普通 rename 在部分平台
       会覆盖并发创建的目标，不能用于这里的拒绝覆盖契约。force 时目标
       先删后链——「覆盖重新生成」是显式确认过的人工动作，可接受窗口期。 */
    static void WriteSources(List<string> paths, List<string> sources, bool force) {
        if (paths.Count != sources.Count) { throw new Exception("生成文件数不一致"); }
        string token = Hex.Encode(RandomNumberGenerator.GetBytes(16), 16);
        List<string> staged = new List<string>();
        List<string> published = new List<string>();
        try {
            for (int i = 0; i < paths.Count; i = i + 1) {
                if (!force && (File.Exists(paths[i]) || Directory.ExistsOnDisk(paths[i]))) {
                    throw new Exception("生成目标已存在：" + paths[i]);
                }
                string tmp = paths[i] + "." + token + ".tmp";
                staged.Add(tmp);
                File.WriteAllText(tmp, sources[i]);
            }
            for (int i = 0; i < paths.Count; i = i + 1) {
                if (!force && (File.Exists(paths[i]) || Directory.ExistsOnDisk(paths[i]))) {
                    throw new Exception("生成目标已存在：" + paths[i]);
                }
                if (force && File.Exists(paths[i])) { File.Delete(paths[i]); }
                if (!File.CreateHardLink(paths[i], staged[i])) {
                    throw new Exception("目标已存在或发布生成文件失败：" + paths[i]);
                }
                published.Add(paths[i]);
                File.Delete(staged[i]);
            }
        } catch (Exception ex) {
            for (int i = 0; i < staged.Count; i = i + 1) {
                if (File.Exists(staged[i])) { File.Delete(staged[i]); }
            }
            for (int i = 0; i < published.Count; i = i + 1) {
                if (File.Exists(published[i])) { File.Delete(published[i]); }
            }
            throw ex;
        }
    }

    /* 写出前预览设计将产生的源码。 */
    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("预览生成代码")]
    async void Preview() {
        int id = this.InInt("id", 0);
        SysGenTable t = await this.SysGenTable.ById(id);
        if (t == null) { this.Fail(404, "0404", "设计不存在"); }
        List<SysGenColumn> cols = await this.SysGenColumn
            .Where(a => a.tableId == id).OrderBy(a => a.sortOrder).ToListAsync();
        List<SysGenTable> tabs = await this.SysGenTable.OrderBy(a => a.id).ToListAsync();
        List<string> sources = SourceList(t, cols, tabs);
        ViewData d = new ViewData();
        d.Set("dialogTitle", t.tableName + " 生成预览");
        d.Set("model", sources[0]);
        d.Set("controller", sources[1]);
        d.Set("dao", sources[2]);
        d.Set("list", sources[3]);
        d.Set("form", sources[4]);
        if (t.apiEnabled == 1 && sources.Count > 5) { d.Set("api", sources[5]); }
        string root = (await Settings.Get(SettingKeys.GenRoot, "..")).Trim();
        if (root.Length > 0 && Directory.ExistsOnDisk(root + "/src")
            && Directory.ExistsOnDisk(root + "/views")) {
            List<string> paths = TargetPaths(t, root);
            int existN = 0;
            for (int i = 0; i < paths.Count; i = i + 1) {
                if (File.Exists(paths[i])) { existN = existN + 1; }
            }
            if (existN > 0) {
                d.Set("existsNote", "已有 " + Convert.ToString(existN) + "/"
                    + Convert.ToString(paths.Count)
                    + " 个目标文件存在；默认拒绝覆盖，可在字段设计页用「覆盖重新生成」");
            }
        }
        this.Dialog(d);
    }

    /* 人工确认生成模块已编译部署后置位 generatedAt：通用数据入口随 IsMenu
       隐藏；再点一次恢复。生成≠部署，所以不由 Build 自动写。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("标记生成模块接管")]
    async void Own() {
        int id = this.InInt("id", 0);
        SysGenTable t = await this.SysGenTable.ById(id);
        if (t == null) { this.Fail(404, "0404", "设计不存在"); }
        int next = t.generatedAt > 0 ? 0 : WebApp.NowSeconds();
        await this.SysGenTable.Update()
            .Set(a => a.generatedAt, next)
            .Set(a => a.updatedAt, WebApp.NowSeconds())
            .Where(a => a.id == id).ExecuteAffrowsAsync();
        await this.Note(next > 0 ? "标记生成模块已接管" : "取消接管生成模块",
            t.tableName, true, "");
        this.Saved(next > 0 ? "已标记接管，通用数据入口将隐藏" : "已恢复通用数据入口");
    }

    static int Flag(string v) {
        if (v == "1" || v == "on") { return 1; }
        return 0;
    }

    static string Checked(int v) {
        if (v == 1) { return "checked"; }
        return "";
    }

    /* "shop_order" → "ShopOrder"。 */
    static string Pascal(string snake) {
        string outName = "";
        bool up = true;
        for (int i = 0; i < snake.Length; i = i + 1) {
            string ch = snake.Substring(i, 1);
            if (ch == "_") { up = true; continue; }
            if (up) { outName = outName + ch.ToUpper(); up = false; }
            else { outName = outName + ch; }
        }
        return outName;
    }
}
