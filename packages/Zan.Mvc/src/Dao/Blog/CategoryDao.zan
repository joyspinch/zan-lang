using System;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Blog;

namespace ZanWeb.Dao.Blog;

/* blog_category 表数据访问网关：每表一个 DAO，专职该表持久化与查询 */
class CategoryDao {
    IDbConnection db;

    CategoryDao(AppController host) {
        /* 请求作用域：连接取宿主控制器的请求租约——事务与只读从库口径一致。 */
        this.db = host.__Conn();
    }

    /* 非请求场景（种子、后台任务）显式给连接。 */
    CategoryDao(IDbConnection db) {
        this.db = db;
    }

    async Category ById(int id) {
        return await this.db.Select<Category>().Where(a => a.id == id).FirstAsync();
    }

    async Category BySlug(string slug) {
        return await this.db.Select<Category>().Where(a => a.slug == slug).FirstAsync();
    }

    async List<Category> All() {
        return await this.db.Select<Category>()
            .OrderBy(a => a.sortOrder)
            .ToListAsync();
    }

    async List<Category> AllActive() {
        return await this.db.Select<Category>()
            .OrderBy(a => a.sortOrder)
            .ToListAsync();
    }

    async int Count() {
        return await this.db.Select<Category>().CountAsync();
    }

    async int Insert(Category cat) {
        return await this.db.Insert<Category>(cat).ExecuteIdentityAsync();
    }

    async int Update(Category cat) {
        return await this.db.Update<Category>()
            .Set(a => a.name, cat.name)
            .Set(a => a.slug, cat.slug)
            .Set(a => a.description, cat.description)
            .Set(a => a.sortOrder, cat.sortOrder)
            .Where(a => a.id == cat.id)
            .ExecuteAffrowsAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<Category>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
