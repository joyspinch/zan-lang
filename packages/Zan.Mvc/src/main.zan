using System;
using System.Web;
using ZanWeb.Core;
using ZanWeb.Web;
using ZanWeb.Blog;

/* Zan.Mvc -- 基于 Zan.Mvc 包（packages/Zan.Mvc，命名空间 ZanWeb）的企业级
   Web 应用骨架。框架引导（配置、连接池、Schema、RBAC、指标、集群、任务
   调度、服务器生命周期）由包内 ZanWeb.Boot 收口；本组合根只声明业务侧的
   三件事，随包升级不需要改动：
     1. 业务菜单分组（框架侧栏按路由表派生，不在此硬编码菜单项）；
     2. 路由表挂点（__AttrRoutes 由编译器按本项目控制器属性生成）；
     3. 业务种子挂点（博客演示数据的 DDL 由 CodeFirst 从 Model/Blog 同步）。 */
class Program {
    static void Main() {
        /* 侧栏分组中文标签：URL 首段 → 显示名，按期望顺序注册。
           HTML 外壳（AdminController.Layout）与 SPA（/api/admin/menu）
           同读这一份，两端分组标题一致。 */
        MenuBuilder.Section("content", "内容管理");
        MenuBuilder.Section("media", "媒体库");
        MenuBuilder.Section("wiki", "知识库");
        MenuBuilder.Section("monitor", "运行监控");
        MenuBuilder.Section("system", "系统管理");
        MenuBuilder.Section("dev", "开发工具");

        /* 挂点注册：路由表与业务种子 */
        Boot.OnRoutes(Program.RegisterRoutes);
        BlogSeed.Register();

        int _r = await Boot.Run();
    }

    /* 执行编译期生成的路由注册。签名须匹配 ZanWeb 的 RouteFn 委托。 */
    static void RegisterRoutes(WebApp app) {
        __AttrRoutes.Register(app);
    }
}
