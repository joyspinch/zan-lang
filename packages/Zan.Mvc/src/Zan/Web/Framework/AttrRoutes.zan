using System;
using System.Reflection;
using System.Web;
using Zan.Web.Core;
using Zan.Web;

namespace Zan.Web;

/* 路由生命周期运行器、约定路径解析与自动路由挂点：
   控制器路由、特性解析与强类型动作派发全部在编译期由 MvcRoutesGenerator 生成，
   运行时不执行 AttributeReader 反射或字符串 actionKey 二次派发。 */
public async delegate void ControllerAction(Controller controller, HttpContext ctx);
public delegate void SyncControllerAction(Controller controller, HttpContext ctx);

public class __AttrRoutes {

    private static RouteFn autoAppRoutes = null;
    private static RouteFn autoFrameworkRoutes = null;

    public static void UseAutoRoutes(RouteFn appRoutes, RouteFn frameworkRoutes = null) {
        autoAppRoutes = appRoutes;
        autoFrameworkRoutes = frameworkRoutes;
    }

    public static void ApplyAutoRoutes(WebApp app) {
        if (app == null) { return; }
        if (autoAppRoutes != null) {
            autoAppRoutes(app);
        }
        if (autoFrameworkRoutes != null) {
            autoFrameworkRoutes(app);
        }
        app.Router().InitRouteTableShared();
    }

    public static bool TryRunSyncAction(Controller controller, HttpContext ctx, string view,
                                        bool readOnly, bool directLifecycle, SyncControllerAction action) {
        controller.Bind(ctx);
        controller.SetView(view);
        if (readOnly) { controller.UseReadOnly(); }
        RequestTrace trace = ctx != null ? ctx.Trace : null;
        bool failed = false;
        bool syncHandled = true;
        try {
            bool proceed = false;
            int beforeStage = trace != null ? trace.Begin("controller_before") : -1;
            try {
                if (directLifecycle) {
                    proceed = controller.Before();
                } else if (!controller.TryBeforeSync(out proceed)) {
                    syncHandled = false;
                    return false;
                }
                if (!proceed && trace != null) { trace.Fail(beforeStage, "short_circuit"); }
            } catch (Exception beforeFailure) {
                if (trace != null) { trace.Fail(beforeStage, "exception"); }
                throw;
            } finally {
                if (trace != null) { trace.End(beforeStage); }
            }
            if (proceed) {
                int actionStage = trace != null ? trace.Begin("mvc_action") : -1;
                try {
                    action(controller, ctx);
                } catch (Exception actionFailure) {
                    if (trace != null) { trace.Fail(actionStage, "exception"); }
                    throw;
                } finally {
                    if (trace != null) { trace.End(actionStage); }
                }
            }
            return true;
        } catch (Exception failure) {
            failed = true;
            throw;
        } finally {
            if (syncHandled) {
                int afterStage = trace != null ? trace.Begin("controller_after") : -1;
                try {
                    if (directLifecycle) {
                        controller.After();
                    } else if (!controller.TryAfterSync()) {
                        controller.OnAfter();
                    }
                } catch (Exception cleanupFailure) {
                    if (trace != null) { trace.Fail(afterStage, "exception"); }
                    if (!failed) { throw; }
                    try { Console.WriteLine("[MVC ERROR] controller cleanup failed: " + cleanupFailure.Message); }
                    catch (Exception logFailure) { }
                } finally {
                    if (trace != null) { trace.End(afterStage); }
                }
            }
        }
    }

    public static async void RunSyncActionAsync(Controller controller, HttpContext ctx, string view,
                                                bool readOnly, bool transaction, SyncControllerAction action,
                                                bool syncLifecycle = true) {
        controller.Bind(ctx);
        controller.SetView(view);
        if (readOnly) { controller.UseReadOnly(); }
        RequestTrace trace = ctx != null ? ctx.Trace : null;
        bool begun = false;
        bool committed = false;
        bool failed = false;
        try {
            bool proceed = false;
            int beforeStage = trace != null ? trace.Begin("controller_before") : -1;
            try {
                if (!syncLifecycle || !controller.TryBeforeSync(out proceed)) {
                    proceed = await controller.OnBeforeAsync();
                }
                if (!proceed && trace != null) { trace.Fail(beforeStage, "short_circuit"); }
            } catch (Exception beforeFailure) {
                if (trace != null) { trace.Fail(beforeStage, "exception"); }
                throw;
            } finally {
                if (trace != null) { trace.End(beforeStage); }
            }
            if (proceed) {
                if (transaction) {
                    bool ready = await controller.TxBegin();
                    if (!ready) { throw new ApiError(503, "0503", "服务不可用"); }
                    begun = true;
                }
                int actionStage = trace != null ? trace.Begin("mvc_action") : -1;
                try {
                    action(controller, ctx);
                    if (trace != null && begun && !ctx.Ended()) { trace.Fail(actionStage, "no_response"); }
                } catch (Exception actionFailure) {
                    if (trace != null) { trace.Fail(actionStage, "exception"); }
                    throw;
                } finally {
                    if (trace != null) { trace.End(actionStage); }
                }
                if (begun) {
                    if (!ctx.Ended()) {
                        throw new ApiError(500, "500", "handler produced no response");
                    }
                    await controller.TxCommit();
                    begun = false;
                    committed = true;
                }
            }
        } catch (Exception failure) {
            failed = true;
            if (begun) {
                try { await controller.TxRollback(); }
                catch (Exception rollbackFailure) { }
            }
            throw;
        } finally {
            int afterStage = trace != null ? trace.Begin("controller_after") : -1;
            try {
                if (!syncLifecycle || !controller.TryAfterSync()) {
                    await controller.OnAfterAsync();
                }
            } catch (Exception cleanupFailure) {
                if (trace != null) { trace.Fail(afterStage, "exception"); }
                if (!failed && !committed) { throw; }
                try { Console.WriteLine("[MVC ERROR] controller cleanup failed: " + cleanupFailure.Message); }
                catch (Exception logFailure) { }
            } finally {
                if (trace != null) { trace.End(afterStage); }
            }
        }
    }

    public static async void RunAction(Controller controller, HttpContext ctx, string view,
                                       bool readOnly, bool transaction, ControllerAction action,
                                       bool syncLifecycle = true) {
        controller.Bind(ctx);
        controller.SetView(view);
        if (readOnly) { controller.UseReadOnly(); }
        RequestTrace trace = ctx != null ? ctx.Trace : null;
        bool begun = false;
        bool committed = false;
        bool failed = false;
        try {
            bool proceed = false;
            int beforeStage = trace != null ? trace.Begin("controller_before") : -1;
            try {
                if (!syncLifecycle || !controller.TryBeforeSync(out proceed)) {
                    proceed = await controller.OnBeforeAsync();
                }
                if (!proceed && trace != null) { trace.Fail(beforeStage, "short_circuit"); }
            } catch (Exception beforeFailure) {
                if (trace != null) { trace.Fail(beforeStage, "exception"); }
                throw;
            } finally {
                if (trace != null) { trace.End(beforeStage); }
            }
            if (proceed) {
                if (transaction) {
                    bool ready = await controller.TxBegin();
                    if (!ready) { throw new ApiError(503, "0503", "服务不可用"); }
                    begun = true;
                }
                int actionStage = trace != null ? trace.Begin("mvc_action") : -1;
                try {
                    await action(controller, ctx);
                    if (trace != null && begun && !ctx.Ended()) { trace.Fail(actionStage, "no_response"); }
                } catch (Exception actionFailure) {
                    if (trace != null) { trace.Fail(actionStage, "exception"); }
                    throw;
                } finally {
                    if (trace != null) { trace.End(actionStage); }
                }
                if (begun) {
                    if (!ctx.Ended()) {
                        throw new ApiError(500, "500", "handler produced no response");
                    }
                    await controller.TxCommit();
                    begun = false;
                    committed = true;
                }
            }
        } catch (Exception failure) {
            failed = true;
            if (begun) {
                try { await controller.TxRollback(); }
                catch (Exception rollbackFailure) { }
            }
            throw;
        } finally {
            int afterStage = trace != null ? trace.Begin("controller_after") : -1;
            try {
                if (!syncLifecycle || !controller.TryAfterSync()) {
                    await controller.OnAfterAsync();
                }
            } catch (Exception cleanupFailure) {
                if (trace != null) { trace.Fail(afterStage, "exception"); }
                if (!failed && !committed) { throw; }
                try { Console.WriteLine("[MVC ERROR] controller cleanup failed: " + cleanupFailure.Message); }
                catch (Exception logFailure) { }
            } finally {
                if (trace != null) { trace.End(afterStage); }
            }
        }
    }

    private static List<string> stripNamespaces = null;

    private static List<string> EnsureStripNamespaces() {
        if (stripNamespaces == null) {
            stripNamespaces = new List<string>();
            stripNamespaces.Add("zan");
            stripNamespaces.Add("web");
        }
        return stripNamespaces;
    }

    public static void StripNamespace(string segment) {
        if (segment == null || segment.Length == 0) { return; }
        List<string> list = EnsureStripNamespaces();
        string seg = segment.ToLower();
        for (int i = 0; i < list.Count; i = i + 1) {
            if (list[i] == seg) { return; }
        }
        list.Add(seg);
    }

    public static void ClearStripNamespaces() {
        stripNamespaces = new List<string>();
    }

    public static string ConventionPath(string ns, string ctrl) {
        List<string> stripped = __AttrRoutes.EnsureStripNamespaces();
        string path = "";
        if (ns != null && ns.Length > 0) {
            int start = 0;
            for (int i = 0; i <= ns.Length; i = i + 1) {
                if (i == ns.Length || ns[i] == '.' || ns[i] == '_') {
                    if (i > start) {
                        string seg = ns.Substring(start, i - start).ToLower();
                        bool skip = false;
                        for (int j = 0; j < stripped.Count; j = j + 1) {
                            if (seg == stripped[j]) { skip = true; break; }
                        }
                        if (!skip) {
                            path = path + "/" + seg;
                        }
                    }
                    start = i + 1;
                }
            }
        }
        if (ctrl != null && ctrl.Length > 0) {
            path = path + "/" + ctrl;
        }
        if (path.Length == 0) { path = "/"; }
        return path;
    }

    public static string ActionKey(TypeInfo controller, string action = "Index") {
        string full = controller.FullName;
        if (full.Length == 0) { return ""; }
        string act = (action == null || action.Length == 0) ? "Index" : action;
        return full + "." + act;
    }

    public static string PathOf(WebApp app, TypeInfo controller, string action = "Index", string fallback = "") {
        string key = __AttrRoutes.ActionKey(controller, action);
        if (app != null && key.Length > 0) {
            List<Route> all = app.Router().All();
            string matched = "";
            for (int i = 0; i < all.Count; i = i + 1) {
                Route r = all[i];
                if (r.Action() != key) { continue; }
                string pat = r.Pattern();
                if (!pat.EndsWith("/index")) { return pat; }
                if (matched.Length == 0) { matched = pat; }
            }
            if (matched.Length > 0) { return matched; }
        }
        return fallback;
    }
}
