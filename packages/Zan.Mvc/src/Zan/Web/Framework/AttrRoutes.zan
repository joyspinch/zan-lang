using System;
using System.Web;
using Zan.Web.Core;
using Zan.Web.Security;
using Zan.Web;

namespace Zan.Web;

/* 纯净的约定优于配置（Convention over Configuration）路由引擎：
   1. 命名空间与目录层级 1:1 映射为 URL 路由层级，类名剥离尾部 "Controller"（转小写）作为控制器段。
      （若类上声明了显式 [Route]，以自定义路由为准）。
   2. 方法级特性驱动（基于 TypeInfo.GetMethodCustomAttributes 原生反射）：
      - 显式 [Route] 覆盖优先；
      - 动词由 [HttpPost]/[HttpGet]/[HttpDelete]/[HttpPut] 等特性精确指定，无特性默认 GET；
      - 权限由 [Custom(Perm = ...)]、[Custom(Authorization = ...)] 声明指定；
      - 标题由 [Description] 指定，菜单由 [Custom(IsMenu = true)] 指定；
      - 无 Web 特性且非公共动作的框架内部钩子天然不注册，绝无方法名黑名单硬编码。
   3. 服务器启动时全量装载入跨进程共享内存路由表（RouteTable）。
   4. 请求进入时直接从共享内存表匹配，没有的路由瞬间抛 404（Fail-Fast）。 */
public async delegate bool RouteDispatchHandler(HttpContext ctx, string actionKey);

public class __AttrRoutes {

    public static RouteDispatchHandler CustomDispatcher = null;

    static async void Dispatch(HttpContext ctx) {
        string act = ctx.routeAction;
        if (__AttrRoutes.CustomDispatcher != null) {
            if (await __AttrRoutes.CustomDispatcher(ctx, act)) {
                return;
            }
        }
        ctx.Status(404, "Not Found");
        ctx.Text("Action not found: " + act);
    }

    static string ExtractAttr(string attrs, string prefix) {
        int idx = attrs.IndexOf(prefix);
        if (idx < 0) { return ""; }
        int start = idx + prefix.Length;
        int end = attrs.IndexOf(";", start);
        if (end < 0) { end = attrs.Length; }
        return attrs.Substring(start, end - start);
    }

    static string DeriveControllerPath(string fullName, string attrs) {
        string explicitRoute = __AttrRoutes.ExtractAttr(attrs, "Route=");
        if (explicitRoute.Length > 0 && explicitRoute.StartsWith("/")) {
            return explicitRoute;
        }

        int lastDot = fullName.LastIndexOf(".");
        int lastUnder = fullName.LastIndexOf("_");
        if (lastUnder > lastDot) { lastDot = lastUnder; }
        string className = lastDot >= 0 ? fullName.Substring(lastDot + 1) : fullName;
        string ns = lastDot >= 0 ? fullName.Substring(0, lastDot) : "";

        string ctrl = className;
        if (ctrl.EndsWith("Controller")) {
            ctrl = ctrl.Substring(0, ctrl.Length - 10);
        }
        ctrl = ctrl.ToLower();

        if (explicitRoute.Length > 0) {
            string sub = explicitRoute.Replace("[controller]", ctrl);
            if (!sub.StartsWith("/")) { sub = "/" + sub; }
            if (sub.EndsWith("/[action]")) { sub = sub.Substring(0, sub.Length - 9); }
            return sub;
        }

        /* 命名空间与目录逐级下推映射 */
        string path = "";
        if (ns.Length > 0) {
            int start = 0;
            for (int i = 0; i <= ns.Length; i = i + 1) {
                if (i == ns.Length || ns[i] == '.' || ns[i] == '_') {
                    if (i > start) {
                        string seg = ns.Substring(start, i - start).ToLower();
                        if (seg != "zan" && seg != "web") {
                            path = path + "/" + seg;
                        }
                    }
                    start = i + 1;
                }
            }
        }
        if (ctrl.Length > 0) {
            path = path + "/" + ctrl;
        }
        if (path.Length == 0) { path = "/"; }
        return path;
    }

    static string ExtractVerb(string mattrs) {
        if (mattrs.Contains("HttpPost=true") || mattrs.Contains("HttpPut=true") || mattrs.Contains("HttpPatch=true")) {
            return "POST";
        }
        if (mattrs.Contains("HttpDelete=true")) {
            return "DELETE";
        }
        return "GET";
    }

    static void RegisterController(WebApp app, TypeInfo ti) {
        /* 命名空间派生路径取 FullName：B-ID107 之后 TypeInfo.Name 是短名
           （对齐 C#），拿它推不出 /admin/system 这类命名空间段，约定路由
           会全部塌到根一级。动作键仍按短名算（见下）。 */
        string fullName = ti.FullName;
        string classAttrs = ti.GetCustomAttributes();
        string basePath = __AttrRoutes.DeriveControllerPath(fullName, classAttrs);

        string shortSrc = ti.Name;
        int lastDot = shortSrc.LastIndexOf(".");
        int lastUnder = shortSrc.LastIndexOf("_");
        if (lastUnder > lastDot) { lastDot = lastUnder; }
        string shortName = lastDot >= 0 ? shortSrc.Substring(lastDot + 1) : shortSrc;

        bool classNeedsAuth = classAttrs.Contains("Authorization=CustomAuthorization.Grant")
            || classAttrs.Contains("Authorization=Grant")
            || classAttrs.Contains("Authorization=CustomAuthorization.ApiAuth")
            || classAttrs.Contains("Authorization=ApiAuth");
        bool classNeedsLogin = classAttrs.Contains("Authorization=CustomAuthorization.Login")
            || classAttrs.Contains("Authorization=Login");
        bool classIsNone = classAttrs.Contains("Authorization=CustomAuthorization.None")
            || classAttrs.Contains("Authorization=None");
        bool classIsMenu = classAttrs.Contains("Custom.IsMenu=true") || classAttrs.Contains("IsMenu=true");
        string classDesc = __AttrRoutes.ExtractAttr(classAttrs, "Description=");
        string classIcon = __AttrRoutes.ExtractAttr(classAttrs, "Custom.Icon=");
        if (classIcon.Length == 0) { classIcon = __AttrRoutes.ExtractAttr(classAttrs, "Icon="); }
        string classGroup = __AttrRoutes.ExtractAttr(classAttrs, "Custom.Group=");
        if (classGroup.Length == 0) { classGroup = __AttrRoutes.ExtractAttr(classAttrs, "Group="); }
        string classGroupOrder = __AttrRoutes.ExtractAttr(classAttrs, "Custom.GroupOrder=");
        if (classGroupOrder.Length == 0) { classGroupOrder = __AttrRoutes.ExtractAttr(classAttrs, "GroupOrder="); }
        string classOrder = __AttrRoutes.ExtractAttr(classAttrs, "Custom.Order=");
        if (classOrder.Length == 0) { classOrder = __AttrRoutes.ExtractAttr(classAttrs, "Order="); }

        for (int m = 0; m < ti.MethodCount; m = m + 1) {
            string mname = ti.GetMethodName(m);
            if (mname.StartsWith("__")) {
                continue;
            }
            string mattrs = ti.GetMethodCustomAttributes(m);

            /* 判定是否为 Action：显式声明了 Route/Http 动词/Description/Custom，或者是 Index 约定动作 */
            bool isIndex = (mname == "Index");
            bool hasWebAttr = mattrs.Contains("Route=") || mattrs.Contains("HttpGet")
                || mattrs.Contains("HttpPost") || mattrs.Contains("Description=")
                || mattrs.Contains("Custom.") || mattrs.Contains("Action");
            if (!hasWebAttr && !isIndex) {
                continue;
            }

            string methodRoute = __AttrRoutes.ExtractAttr(mattrs, "Route=");
            string actionPath = "";
            if (methodRoute.Length > 0) {
                if (methodRoute.StartsWith("/")) {
                    actionPath = methodRoute;
                } else {
                    actionPath = basePath == "/" ? "/" + methodRoute : basePath + "/" + methodRoute;
                }
            } else if (isIndex) {
                actionPath = basePath;
            } else {
                actionPath = basePath == "/" ? "/" + mname.ToLower() : basePath + "/" + mname.ToLower();
            }

            string verb = __AttrRoutes.ExtractVerb(mattrs);
            string actionKey = shortName + "." + mname;

            Route r = app.Map(verb, actionPath, __AttrRoutes.Dispatch);
            r.Named(actionKey);

            /* 标题声明 */
            string methodDesc = __AttrRoutes.ExtractAttr(mattrs, "Description=");
            if (methodDesc.Length > 0) {
                r.Title(methodDesc);
            } else if (classDesc.Length > 0) {
                r.Title(classDesc);
            }

            /* 授权与认证声明：对齐原架构 Fail-Closed 规范（零硬编码路径）
               1. 显式 None/Auth：公开访问（不强制登录）
               2. 显式 Grant/ApiAuth：权限拦截（.Auth()）
               3. 显式 Login 或默认缺省：统一要求登录（.Login()，安全兜底） */
            bool isNone = classIsNone
                || mattrs.Contains("Authorization=CustomAuthorization.None")
                || mattrs.Contains("Authorization=None");
            bool needsAuth = !isNone && (classNeedsAuth
                || mattrs.Contains("Authorization=CustomAuthorization.Grant")
                || mattrs.Contains("Authorization=Grant")
                || mattrs.Contains("Authorization=CustomAuthorization.ApiAuth")
                || mattrs.Contains("Authorization=ApiAuth"));
            bool needsLogin = !isNone && !needsAuth;

            if (needsAuth) {
                r.Auth();
            } else if (needsLogin) {
                r.Login();
            }

            /* 导航菜单声明 */
            bool isMenu = false;
            if (mattrs.Contains("Custom.IsMenu=true") || mattrs.Contains("IsMenu=true")) {
                isMenu = true;
            } else if (isIndex && classIsMenu) {
                isMenu = true;
            }
            if (mattrs.Contains("Custom.IsMenu=false") || mattrs.Contains("IsMenu=false")) {
                isMenu = false;
            }
            if (isMenu) { r.Menu(); }

            /* 流式文件上传声明 */
            if (mattrs.Contains("Upload=true") || mattrs.Contains("Upload = true")
                || mattrs.Contains("Custom.Upload=true") || mattrs.Contains("Custom.Upload = true")
                || classAttrs.Contains("Upload=true") || classAttrs.Contains("Upload = true")) {
                r.Upload();
            }

            string methodIcon = __AttrRoutes.ExtractAttr(mattrs, "Custom.Icon=");
            if (methodIcon.Length == 0) { methodIcon = __AttrRoutes.ExtractAttr(mattrs, "Icon="); }
            string icon = methodIcon.Length > 0 ? methodIcon : (isIndex ? classIcon : "");
            if (icon.Length > 0) { r.Meta("Icon", icon); }

            string methodGroup = __AttrRoutes.ExtractAttr(mattrs, "Custom.Group=");
            if (methodGroup.Length == 0) { methodGroup = __AttrRoutes.ExtractAttr(mattrs, "Group="); }
            string group = methodGroup.Length > 0 ? methodGroup : classGroup;
            if (group.Length > 0) { r.Meta("Group", group); }

            string methodGroupOrder = __AttrRoutes.ExtractAttr(mattrs, "Custom.GroupOrder=");
            if (methodGroupOrder.Length == 0) { methodGroupOrder = __AttrRoutes.ExtractAttr(mattrs, "GroupOrder="); }
            string groupOrder = methodGroupOrder.Length > 0 ? methodGroupOrder : classGroupOrder;
            if (groupOrder.Length > 0) { r.Meta("GroupOrder", groupOrder); }

            string methodOrder = __AttrRoutes.ExtractAttr(mattrs, "Custom.Order=");
            if (methodOrder.Length == 0) { methodOrder = __AttrRoutes.ExtractAttr(mattrs, "Order="); }
            string order = methodOrder.Length > 0 ? methodOrder : classOrder;
            if (order.Length > 0) { r.Meta("Order", order); }

            /* 权限位掩码直录 */
            string perm = __AttrRoutes.ExtractAttr(mattrs, "Custom.Perm=");
            if (perm.Length > 0) {
                r.Meta("Perm", perm.Replace("PermBit.", ""));
            }

            /* 路由路径中的 {param} 占位符直录为 path 参数 */
            int braceStart = 0;
            while (braceStart < actionPath.Length) {
                int o = actionPath.IndexOf("{", braceStart);
                if (o < 0) { break; }
                int c = actionPath.IndexOf("}", o);
                if (c < 0) { break; }
                string pname = actionPath.Substring(o + 1, c - o - 1);
                int colon = pname.IndexOf(":");
                string ptype = "string";
                if (colon >= 0) {
                    ptype = pname.Substring(colon + 1);
                    pname = pname.Substring(0, colon);
                }
                r.Param(pname, ptype, true, "", "", "path");
                braceStart = c + 1;
            }

            /* 特性元数据中的请求参数直录（In/Need/Paged 扫描产物） */
            int pidx = 0;
            bool hasCustomParam = false;
            while (pidx < mattrs.Length) {
                int found = mattrs.IndexOf("Param=", pidx);
                if (found < 0) { break; }
                int start = found + 6;
                int end = mattrs.IndexOf(";", start);
                if (end < 0) { end = mattrs.Length; }
                string pstr = mattrs.Substring(start, end - start);
                List<string> parts = pstr.Split("\t");
                if (parts.Count >= 6) {
                    hasCustomParam = true;
                    string pname = parts[0];
                    string ptype = parts[1];
                    string pwhere = parts[2];
                    bool preq = parts[3] == "true";
                    string pdef = parts[4];
                    string pdesc = parts[5];
                    r.Param(pname, ptype, preq, pdef, pdesc, pwhere);
                }
                pidx = end + 1;
            }

            /* 兜底：若无元数据参数且有签名参数，按签名参数直录 */
            if (!hasCustomParam) {
                int pcount = ti.GetMethodParamCount(m);
                for (int p = 0; p < pcount; p = p + 1) {
                    string ptype = ti.GetMethodParamType(m, p);
                    r.Param("p" + Convert.ToString(p), ptype, true, "", "", "query");
                }
            }

            /* Index 别名支持：仅对按约定生成的 Index 生成 /index 别名，显式 [Route] 绝不擅自篡改路径 */
            if (isIndex && methodRoute.Length == 0 && !actionPath.EndsWith("/index") && actionPath != "/") {
                Route rAlias = app.Map(verb, actionPath + "/index", __AttrRoutes.Dispatch);
                rAlias.Named(actionKey);
                if (needsAuth) { rAlias.Auth(); }
                else if (needsLogin) { rAlias.Login(); }
            }
        }
    }

    public static void RegisterFramework(WebApp app) {
        TypeInfo[] f = new TypeInfo[] {
            typeof(Zan.Web.Admin.LoginController),
            typeof(Zan.Web.Admin.DashboardController),
            typeof(Zan.Web.Admin.ProfileController),
            typeof(Zan.Web.Admin.Media.MediaController),
            typeof(Zan.Web.Admin.Wiki.WikiController),
            typeof(Zan.Web.Admin.Content.PostsController),
            typeof(Zan.Web.Admin.Content.CategoriesController),
            typeof(Zan.Web.Admin.Content.CommentsController),
            typeof(Zan.Web.Admin.Dev.CoderController),
            typeof(Zan.Web.Admin.Dev.AssistantController),
            typeof(Zan.Web.Admin.Dev.TxProbeController),
            typeof(Zan.Web.Admin.Monitor.MonitorController),
            typeof(Zan.Web.Admin.Monitor.DataController),
            typeof(Zan.Web.Admin.System.DocsController),
            typeof(Zan.Web.Admin.System.DepartmentsController),
            typeof(Zan.Web.Admin.System.DictsController),
            typeof(Zan.Web.Admin.System.JobsController),
            typeof(Zan.Web.Admin.System.LogsController),
            typeof(Zan.Web.Admin.System.UsersController),
            typeof(Zan.Web.Admin.System.SettingsController),
            typeof(Zan.Web.Admin.System.RolesController),
            typeof(Zan.Web.Account.LoginController),
            typeof(Zan.Web.Account.RegisterController),
            typeof(Zan.Web.Account.ForgotController),
            typeof(Zan.Web.Health.HealthController)
        };
        for (int i = 0; i < f.Length; i = i + 1) {
            __AttrRoutes.RegisterController(app, f[i]);
        }
    }

    public static void Register(WebApp app, TypeInfo[] controllers = null,
                                RouteDispatchHandler dispatcher = null) {
        if (app == null) { return; }

        /* 0. 动作派发器：约定路由把每条路由的 handler 统一挂到 Dispatch，
           真正的控制器方法调用按 routeAction 派发。反射 Invoke 拿不到协程
           句柄（thunk 只回传方法返回值），异步动作无法 await，因此派发器
           由编译器在 __AttrRoutes.Register 调用点合成后作为第三实参传入
           （见 src/compiler/main.c 的动作派发合成）。 */
        if (dispatcher != null) {
            __AttrRoutes.CustomDispatcher = dispatcher;
        }

        /* 1. 动态装载应用业务控制器约定路由与属性路由 */
        if (controllers != null) {
            for (int i = 0; i < controllers.Length; i = i + 1) {
                TypeInfo ti = controllers[i];
                __AttrRoutes.RegisterController(app, ti);
            }
        }

        /* 2. 装载入共享内存路由表，启动 O(1) 极速匹配与非法路径 404 截断 */
        app.router.InitRouteTableShared();
    }
}
