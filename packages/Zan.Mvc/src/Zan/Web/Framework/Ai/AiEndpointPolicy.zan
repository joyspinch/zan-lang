using System;
using System.Net.External;

namespace Zan.Web.Ai;

/* AI 外呼目标白名单。共享解析器先拒绝 userinfo、非法 authority、fragment、
 * 编码变体和危险字面量，再做 provider 的 canonical URL 精确匹配。 */
public class AiEndpointPolicy {
    public static bool IsAllowed(string url) {
        return ParseAllowedTarget(url) != null;
    }

    public static bool IsRemoteAllowed(string url) {
        return ParseRemoteTarget(url) != null;
    }

    internal static ExternalTarget ParseAllowedTarget(string url) {
        ExternalTarget remote = ParseRemoteTarget(url);
        if (remote != null) { return remote; }
        return ParseLocalTarget(url);
    }

    private static ExternalTarget ParseRemoteTarget(string url) {
        if (url != "https://api.deepseek.com/v1"
        && url != "https://api.openai.com/v1"
        && url != "https://dashscope.aliyuncs.com/compatible-mode/v1"
        && url != "https://open.bigmodel.cn/api/paas/v4"
        && url != "https://api.moonshot.cn/v1"
        && url != "https://apihub.agnes-ai.com/v1") { return null; }
        ExternalTarget target = ExternalTarget.Parse(url);
        if (!ExternalTargetPolicy.IsAllowedTarget(target, false, false)
        || target.Canonical() != url) { return null; }
        return target;
    }

    public static bool Exact(string url, string expected) {
        return url != null && url == expected
            && ExternalTargetPolicy.AllowExact(url, expected);
    }

    public static bool IsLocal(string url) {
        return ParseLocalTarget(url) != null;
    }

    private static ExternalTarget ParseLocalTarget(string url) {
        ExternalTarget target = ExternalTarget.Parse(url);
        if (!ExternalTargetPolicy.IsLocalTarget(target, true)
        || target.Canonical() != "http://127.0.0.1:11434/v1") { return null; }
        return target;
    }
}
