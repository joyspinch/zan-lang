using System;
using System.Collections.Generic;

namespace Zan.Web.Ai;

public class AiVendor {
    public string code;
    public string name;
    public string baseUrl;
    public string model;
    public string signup;

    public AiVendor(string code, string name, string baseUrl, string model,
             string signup) {
        this.code = code;
        this.name = name;
        this.baseUrl = baseUrl;
        this.model = model;
        this.signup = signup;
    }
}
