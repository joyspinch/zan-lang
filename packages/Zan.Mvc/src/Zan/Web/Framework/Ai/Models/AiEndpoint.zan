using System;
using System.Net.External;

namespace Zan.Web.Ai;

public class AiEndpoint {
    public string host;
    public int port;
    public string path;
    public bool tls;

    public string Host() { return this.host; }
    public int Port() { return this.port; }
    public string Path() { return this.path; }
    public bool Tls() { return this.tls; }
    public bool Local() { return AiEndpointPolicy.IsLocal(this.Canonical()); }

    public string Canonical() {
        string scheme = this.tls ? "https://" : "http://";
        string authority = this.host;
        if ((this.tls && this.port != 443) || (!this.tls && this.port != 80)) {
            authority = authority + ":" + Convert.ToString(this.port);
        }
        return scheme + authority + this.path;
    }

    /* 解析 URL，返回 null 表示不是允许的地址。 */
    public static AiEndpoint Parse(string url) {
        if (url == null || (!url.StartsWith("https://") && !url.StartsWith("http://"))) {
            return null;
        }
        ExternalTarget target = AiEndpointPolicy.ParseAllowedTarget(url);
        if (target == null) { return null; }
        AiEndpoint e = new AiEndpoint();
        e.host = target.Host();
        e.port = target.Port();
        e.path = target.Path();
        e.tls = target.IsTls();
        return e;
    }
}
