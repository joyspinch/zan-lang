using System;
using System.Collections.Generic;

namespace Zan.Web.Ai;

public class AiReply {
    public bool ok;
    public string text;

    public static AiReply Good(string text) {
        AiReply r = new AiReply();
        r.ok = true;
        r.text = text;
        return r;
    }

    public static AiReply Bad(string why) {
        AiReply r = new AiReply();
        r.ok = false;
        r.text = why;
        return r;
    }
}
