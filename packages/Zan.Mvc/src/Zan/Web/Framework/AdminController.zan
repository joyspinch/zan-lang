using System;
using System.Diagnostics;
using System.Text;
using System.Data.Orm;
using System.Web;
using Zan.Web.Model;
using Zan.Web.Dao;
using Zan.Web.Core;
using Zan.Web.Security;
using Zan.Web.Services;

namespace Zan.Web;

/* HTML 管理后台外壳基类：持有页面归属、外壳与渲染，授权由 [Custom(Authorization=Grant)] 由调度器在到达前拦截（导航答登录页、脚本答 401/403）。每个屏幕三步：Layout(heading) → 填充 d → Page(d)，Page() 按请求决定是否加外壳（直接 URL 出整页、标签加载出面板）。写操作答 JSON 而非重定向，因对话框失败保持、成功关闭。 */
public abstract class AdminController : AppController {
    public SysDepartmentDao SysDepartment { get { return new SysDepartmentDao(this.Held()); } }
    public SysDepartmentRoleDao SysDepartmentRole { get { return new SysDepartmentRoleDao(this.Held()); } }
    public SysDictItemDao SysDictItem { get { return new SysDictItemDao(this.Held()); } }
    public SysDictTypeDao SysDictType { get { return new SysDictTypeDao(this.Held()); } }
    public SysJobDao SysJob { get { return new SysJobDao(this.Held()); } }
    public SysJobLogDao SysJobLog { get { return new SysJobLogDao(this.Held()); } }
    public SysMediaFileDao SysMediaFile { get { return new SysMediaFileDao(this.Held()); } }
    public SysOperationLogDao SysOperationLog { get { return new SysOperationLogDao(this.Held()); } }
    public SysRoleDao SysRole { get { return new SysRoleDao(this.Held()); } }
    public SysRoleGrantDao SysRoleGrant { get { return new SysRoleGrantDao(this.Held()); } }
    public SysSiteSettingDao SysSiteSetting { get { return new SysSiteSettingDao(this.Held()); } }
    public SysUserRoleDao SysUserRole { get { return new SysUserRoleDao(this.Held()); } }
    public SysWikiDocDao SysWikiDoc { get { return new SysWikiDocDao(this.Held()); } }
    public SysWikiRevisionDao SysWikiRevision { get { return new SysWikiRevisionDao(this.Held()); } }
    public SysWikiSpaceDao SysWikiSpace { get { return new SysWikiSpaceDao(this.Held()); } }

    private AdminSession adminSession;

    /* 本次请求所属账号，由 Admin() 解析一次（保留字段供现有子类直接读取）。 */
    protected SysUser who;

    /* 当前屏幕标题，用于告知标签条该给新载入的标签命名。 */
    protected string headingText;

    /* 本次请求可见的数据范围，由 Scope() 解析一次（保留字段供现有子类直接读取）。 */
    protected DataScope scope;

    protected AdminSession Session() {
        if (this.adminSession == null) {
            this.adminSession = new AdminSession(this);
        }
        return this.adminSession;
    }

    /* 浏览器要面板而非整页时返回 true（标签加载或就地刷新）。 */
    protected bool IsFragment() {
        return this.Ctx().Header("X-Fragment").Length > 0;
    }

    /* 已登录账号；调度器已确认为非空，若该行已被禁用则中止。 */
    protected async SysUser Admin() {
        this.who = await this.Session().Admin();
        return this.who;
    }

    /* 进入任何管理屏之前先把该账号的角色解析进共享权限表：此刻请求
       尚未持有租约，借还只是顺序复用；此后本页渲染期的 Allow/Mask
       全部是共享内存读，绝不在持有租约时再向池借第二条连接——
       并发数达到上限后，那种嵌套租借会变成「人人持一条、人人等
       第二条」的循环等待（实测过的全站假死形态）。 */
    override public bool TryBeforeSync(out bool proceed) {
        if (this.uid.Length > 0) {
            proceed = false;
            return false;
        }
        return base.TryBeforeSync(out proceed);
    }

    override public async bool OnBeforeAsync() {
        if (this.uid.Length > 0) {
            await AuthUser.RolesOf(this.uid);
        }
        return await base.OnBeforeAsync();
    }

    /* 数据范围优先从共享内存读取，只有未缓存的部门树范围需要查询组织结构。 */
    protected async DataScope Scope() {
        this.scope = await this.Session().Scope();
        return this.scope;
    }

    /* 所有管理页起点的外壳数据：标题、登录账号、侧边栏。 */
    protected async ViewData Layout(string heading) {
        SysUser me = await this.Admin();

        StrMap settings = await Settings.All(this.Held());
        Lang.LoadLanguage(settings.Get(SettingKeys.SiteLanguage));
        string hshown = Lang.T(heading);
        ViewData d = new ViewData();
        string site = settings.Get(SettingKeys.SiteTitle);
        if (site.Length == 0) { site = Cfg.Server.name; }
        d.Set("title", hshown + " · " + site + " " + Lang.T("管理后台"));
        d.Set("brand", site);
        d.Set("heading", hshown);
        this.headingText = hshown;
        d.Set("account", me.username);
        string shown = Fmt.Text(me.nickname, me.username);
        d.Set("accountName", shown);
        d.Set("accountMail", Fmt.Text(me.email, ""));
        d.Set("accountInitial", Fmt.FirstChar(shown));
        d.Set("tabPath", this.Ctx().Path());
        d.Set("tabTitle", hshown);
        if (me.isSuper == 1) { d.Set("isSuper", "1"); }

        /* 兼容自定义外壳模板的布尔标记；默认外壳由 AdminShell 顶栏部件权限裁减接管。 */
        if (await AuthUser.Allow(this.Held(), this.uid, "Monitor.Index")) {
            d.Set("canMonitor", "1");
        }

        await this.Buttons(d);

        /* 侧边栏即路由表，按调度器所用同一解析器裁减到该账号可打开的项；
           业务/模块动态菜单（如 Crud 设计表）经 MvcHooks.OnMenu 注入，外壳不直接耦合具体模块。 */
        string activeMenuPath = this.Ctx().Path();
        string tableQuery = this.In("t");
        if (tableQuery.Length > 0) { activeMenuPath = activeMenuPath + "?t=" + tableQuery; }
        List<MenuNode> nodes = await MenuService.ForUser(
            WebHost.Current(), this.uid, activeMenuPath, this.Held());
        for (int i = 0; i < nodes.Count; i = i + 1) {
            nodes[i].title = Lang.T(nodes[i].title);
            nodes[i].group = Lang.T(nodes[i].group);
        }
        MenuBuilder.Sort(nodes);
        MenuBuilder.Fill(d.AddList("menu"), nodes);
        this.I18n(d);

        /* 外壳插槽：允许模块与扩展应用按需注入样式、脚本、懒加载模块与挂件，
           无需分叉 views/Admin/layout.html 或重写 AdminController。 */
        d.Set("shellStyles", AdminShell.RenderStyles());
        d.Set("shellScripts", AdminShell.RenderScripts());
        d.Set("shellModules", AdminShell.RenderModules());
        d.Set("topWidgets", await AdminShell.RenderTopWidgets(this.Held(), this.uid, d));
        d.Set("fabWidgets", await AdminShell.RenderFabWidgets(this.Held(), this.uid, d));
        return d;
    }

    private static string[] i18nKeys() {
        return new string[] {
            "iEdit", "iDelete", "iRead", "iHistory", "iLogs", "iView", "iRunOnce",
            "iBackList", "iBackHistory", "iSave", "iCancel", "iOps", "iStatus",
            "iFront", "iMenuT", "iAlarm", "iRefresh", "iProfile", "iPassword",
            "iLogout", "iFind", "iUpload"
        };
    }

    private static string[] i18nTexts() {
        return new string[] {
            "编辑", "删除", "阅读", "历史", "日志", "查看", "执行一次",
            "返回列表", "返回历史", "保存", "取消", "操作", "状态",
            "查看前台", "菜单", "运行告警", "刷新", "个人资料", "修改密码",
            "退出登录", "筛选菜单（支持首拼）", "上传文件"
        };
    }

    /* 公共词条注入：布局与对话框都从这里拿 {{iXxx}} 行内按钮文案，
       语言包切换后无需改视图。 */
    protected void I18n(ViewData d) {
        string[] keys = i18nKeys();
        string[] texts = i18nTexts();
        for (int i = 0; i < keys.Length; i = i + 1) {
            d.Set(keys[i], Lang.T(texts[i]));
        }
    }

    /* 当前屏幕可显示的按钮：canView/可增/可改/可删/可导出，取自与调度器相同的授权掩码。 */
    protected async void Buttons(ViewData d) {
        int mask = await this.Mask();
        if (mask == 0) { return; }
        List<int> order = Perm.Order();
        for (int i = 0; i < order.Count; i = i + 1) {
            int bit = order[i];
            if ((mask & bit) == 0) { continue; }
            d.Set("can" + Perm.BitName(bit), "1");
        }
    }

    /* 当前屏幕对该登录账号的授权掩码。传请求租约：掩码回填即使需要
       查库也跑在这条连接上，不二次借用（见 AuthUser.RolesOf）。 */
    protected async int Mask() {
        return await this.Session().Mask();
    }

    /* 当前屏幕是否允许某按钮——与模板 {{#if canUpdate}} 取同一数字。 */
    protected async bool Can(int bit) {
        return await this.Session().Can(bit);
    }

    /* 渲染屏幕：直接打开 URL 时输出整页，标签加载时只输出面板。 */
    protected void Page(ViewData d) {
        if (this.IsFragment()) {
            this.Ctx().SetHeader("X-Tab-Title", Encoding.UrlEncode(this.headingText));
            this.Fragment(d);
            return;
        }
        this.View(d);
    }

    /* 渲染指定视图键的屏幕：直接打开 URL 时输出整页，标签加载时只输出面板片段。 */
    protected void PageOf(string name, ViewData d) {
        if (this.IsFragment()) {
            this.Ctx().SetHeader("X-Tab-Title", Encoding.UrlEncode(this.headingText));
            this.FragmentOf(name, d);
            return;
        }
        this.ViewOf(name, d);
    }

    /* 渲染对话框主体（表单）——始终是片段。 */
    protected void Dialog(ViewData d) {
        this.I18n(d);
        this.Fragment(d);
    }

    /* 渲染声明式表单对话框：FormPage 产出 formHtml，共享壳
       views/Admin/_FormDialog.html 渲染——通用 CRUD 新增/编辑屏
       不再需要各自的 Form 视图文件。 */
    protected void FormDialog(ViewData d) {
        this.I18n(d);
        this.FragmentOf("Admin._FormDialog", d);
    }

    /* 写操作成功应答：toast 消息，无 payload；屏幕随后自刷新面板。
       包内公开：CrudOps 等声明驱动的通用动作经此统一应答。 */
    public void Saved(string msg) {
        this.Ctx().Api("0000", msg, "null");
    }

    /* 将写操作记入 sys_operation_log；读不记（流量主体，无审计意义）。记录动作即路由自身动作名，与授权行和文档同名。包内公开：通用写动作（CrudOps）在控制器之外落审计。 */
    public async void Note(string title, string target,
                              bool ok, string message) {
        await this.Session().Note(title, target, ok, message);
        this.who = this.Session().CachedUser();
    }

    /* 写出分页页脚：total/page/pages/limit 及上下页号（不存在则空，模板据此隐藏链接）。 */
    protected void Pager(ViewData d, ListQuery q, int total) {
        int pages = q.Pages(total);
        d.Set("total", Convert.ToString(total));
        d.Set("page", Convert.ToString(q.Page()));
        d.Set("pages", Convert.ToString(pages));
        d.Set("limit", Convert.ToString(q.Limit()));
        d.Set("kw", q.Kw());
        if (q.Page() > 1) { d.Set("prev", Convert.ToString(q.Page() - 1)); }
        if (q.Page() < pages) { d.Set("next", Convert.ToString(q.Page() + 1)); }
        if (total == 0) { d.Set("empty", "1"); }
    }

    /* 批量端点的 id 列表：POST ids=1,2,3（逗号分隔）。Filter.ToInt 对任何
       非数字串回退 0，天然过滤脏词；只收正 id，上限 500，防止一次提交
       拖垮一条连接。空列表不是错误——调用方自行决定"未选择"的措辞与码。 */
    protected List<int> Ids(string name) {
        return AdminSession.ParseIds(this.In(name));
    }

    /* ---- 数据库降级的两个统一出口 ----
       动作不再各自手写 DbReady 三行样板：屏面动作一行判定渲染降级屏，
       数据动作一行判定答 503。dbDown 的呈现（徽章键、文案、状态码）
       只住在这里。 */

    /* 屏面动作：连接不可用时置 dbDown 徽章渲染本屏并答 false，调用方
       直接 return——页面壳照常给用户，数据区显示不可用。 */
    protected bool PageReady(ViewData d) {
        if (this.DbReady()) { return true; }
        d.Set("dbDown", "1");
        this.Page(d);
        return false;
    }

    /* 数据动作：连接不可用时答 503 并答 false。 */
    protected bool DataReady() {
        if (this.DbReady()) { return true; }
        this.Fail(503, "2001", "数据库不可用");
        return false;
    }
}
