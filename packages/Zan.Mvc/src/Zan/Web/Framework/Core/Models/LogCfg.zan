using System;

namespace Zan.Web.Core;

public class LogCfg {
    public bool access;
    public int slowMs;
    /* 慢 SQL 阈值，达此值即记入日志并计数。 */
    public int slowSqlMs;
    /* 按日日志目录，"" 禁用文件输出。 */
    public string dir;
    /* 日志文件名模式，每次写入展开。 */
    public string pattern;
    /* 错误日志文件，"" 禁用。 */
    public string errorLog;
    /* 同时向控制台输出错误，生产环境关闭。 */
    public bool debug;

    public static LogCfg Defaults() {
        LogCfg c = new LogCfg();
        c.access = false;
        c.slowMs = 1000;
        /* 故意低于请求阈值：单个 SQL 超过 200ms 已属异常。 */
        c.slowSqlMs = 200;
        c.dir = "logs";
        c.pattern = "{yyyy}{MM}/{dd}.log";
        c.errorLog = "logs/{yyyy}{MM}/{dd}.log";
        c.debug = false;
        return c;
    }
}

