using System;

namespace Zan.Web.Core;

public class SecurityCfg {
    /* 启用 Content-Security-Policy（default-src 'self'）。框架视图与 生成器已去内联（内联 style=/内联 script/javascript: 伪协议清零： th 列宽走遗留 width 属性、tab 条 href="#"、页脚本外链 到 /static/js/ 下的独立文件）；应用自有视图未清扫时置 true 会破页（如 server-collab 模板仍有 347 处内联 style、7 处内联 script）， 模板去内联批次后再改默认值。 */
    public bool csp;

    public static SecurityCfg Defaults() {
        SecurityCfg c = new SecurityCfg();
        c.csp = false;
        return c;
    }
}

