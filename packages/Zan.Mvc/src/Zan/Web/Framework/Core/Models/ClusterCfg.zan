using System;

namespace Zan.Web.Core;

public class ClusterCfg {
    public bool enabled;
    public string bus;
    public string channel;

    public static ClusterCfg Defaults() {
        ClusterCfg c = new ClusterCfg();
        c.enabled = false;
        c.bus = "redis";
        c.channel = "zanweb:cluster:events";
        return c;
    }
}

