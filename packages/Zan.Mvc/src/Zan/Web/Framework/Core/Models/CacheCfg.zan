using System;

namespace Zan.Web.Core;

public class CacheCfg {
    public string driver;
    public string redisHost;
    public int redisPort;
    public int poolSize;
    public int connectTimeoutMs;

    public static CacheCfg Defaults() {
        CacheCfg c = new CacheCfg();
        c.driver = "memory";
        c.redisHost = "127.0.0.1";
        c.redisPort = 6379;
        c.poolSize = 8;
        c.connectTimeoutMs = 3000;
        return c;
    }
}

