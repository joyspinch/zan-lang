using System;

namespace Zan.Web.Core;

public class ServerCfg {
    public string name;
    public string mode;
    public string host;
    public int port;
    public int maxBodyMB;
    public int uploadBodyMB;
    public int globalLimitPerSec;
    public string trustedProxies;
    public string viewsDir;
    public string baseViewsDir;
    public string staticUrl;
    public string staticDir;
    public string baseStaticDir;
    public int staticMaxAge;
    public string spaUrl;
    public string spaDir;
    public string apiDocsPath;
    public string apiPrefix;

    public static ServerCfg Defaults() {
        ServerCfg c = new ServerCfg();
        c.name = "app";
        c.mode = "full";
        c.host = "127.0.0.1";
        c.port = 8080;
        c.maxBodyMB = 2;
        c.uploadBodyMB = 64;
        c.globalLimitPerSec = 0;
        c.trustedProxies = "";
        c.viewsDir = "views";
        c.baseViewsDir = "";
        c.staticUrl = "/static";
        c.staticDir = "wwwroot";
        c.baseStaticDir = "";
        c.staticMaxAge = 0;
        c.spaUrl = "/ui";
        c.spaDir = "";
        c.apiDocsPath = "/api/docs";
        c.apiPrefix = "/api";
        return c;
    }
}

