using System;

namespace Zan.Web.Core;

public class CorsCfg {
    public bool enabled;
    public string allowOrigin;
    public string allowMethods;
    public string allowHeaders;
    public bool allowCredentials;
    public int maxAge;

    public static CorsCfg Defaults() {
        CorsCfg c = new CorsCfg();
        c.enabled = true;
        c.allowOrigin = "*";
        c.allowMethods = "GET, POST, PUT, DELETE, OPTIONS";
        c.allowHeaders = "Content-Type, Authorization, X-Request-Id";
        c.allowCredentials = false;
        c.maxAge = 86400;
        return c;
    }
}

