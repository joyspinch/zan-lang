using System;
using System.Data;
using System.Web;

namespace Zan.Web.Core;

/* 请求作用域的惰性连接：控制器 Held()/表访问器拿到的就是它。
 *
 * 旧口径是 OnBeforeAsync 无条件先借一条连接、持到动作返回——不碰库的
 * 动作（缓存命中、纯模板页、健康检查）也占一个池位，模板渲染与外呼
 * 期间同样占着，吞吐被锁死在「池大小 / 整个请求耗时」。
 *
 * 这里改为首条语句才真正借出：异步端点 await 池（池满挂起协程）；
 * 同步端点无法挂起，只取空闲连接，池里没有空闲时抛错而不是阻塞
 * 工作线程。借不到（数据库未配置/不可达）答 503 ApiError，与原先
 * 「DbReady() 为 false → 503」的应答一致。
 *
 * 归还走 DbContext.Release/ReleaseRead/Discard：它们认得本类并只把
 * 内层的真实池连接放回池，绝不把代理本身塞进池。 */
public class RequestDbConnection : IDbConnection {
    DbContext db;
    bool read;
    IDbConnection inner;
    bool failed;
    /* 连接带上了会话状态（事务、SET、临时表、锁……）：本请求内不得提前归还，
       见 DetachIfIdle。只升不降，保守。 */
    bool pinned;

    public RequestDbConnection(DbContext db, bool read) {
        this.db = db;
        this.read = read;
        this.inner = null;
        this.failed = false;
        this.pinned = false;
    }

    /* 已借出的真实连接（未借出时为 null）。 */
    public IDbConnection Inner() { return this.inner; }

    /* 借自只读池（[ReadOnly] 动作）还是主库池。 */
    public bool IsRead() { return this.read; }

    /* 是否已真正借出连接。 */
    public bool IsOpen() { return this.inner != null; }

    /* 是否借用失败过（数据库不可达）；失败后不再重试，同一请求内快速 503。 */
    public bool Failed() { return this.failed; }

    /* 渲染前提前归还用：未钉住时取走内层连接（同 Detach），代理仍可用——
       之后再有语句会重新惰性借出。钉住或未借出时答 null。 */
    public IDbConnection DetachIfIdle() {
        if (this.pinned || this.inner == null) { return null; }
        return this.Detach();
    }

    /* 语句是否把状态留在连接上（下一条语句必须落在同一连接）：事务控制、
       会话变量、临时对象、显式锁。按首个关键字判定，宁可多钉。每条语句都会
       走这里，所以原地比字节、不分配：SELECT/INSERT 等常见语句一两个字节就出结论。 */
    public static bool SessionBound(string sql) {
        int n = sql.Length;
        int i = 0;
        while (i < n && (sql[i] == 32 || sql[i] == 9 || sql[i] == 10 || sql[i] == 13)) {
            i = i + 1;
        }
        if (i >= n) { return false; }
        int c = RequestDbConnection.Upper(sql[i]);
        if (c == 66) { return RequestDbConnection.KeyAt(sql, i, "BEGIN"); }
        if (c == 83) {
            return RequestDbConnection.KeyAt(sql, i, "SET")
                || RequestDbConnection.KeyAt(sql, i, "START")
                || RequestDbConnection.KeyAt(sql, i, "SAVEPOINT");
        }
        if (c == 76) { return RequestDbConnection.KeyAt(sql, i, "LOCK"); }
        if (c == 68) { return RequestDbConnection.KeyAt(sql, i, "DECLARE"); }
        if (c == 80) {
            return RequestDbConnection.KeyAt(sql, i, "PRAGMA")
                || RequestDbConnection.KeyAt(sql, i, "PREPARE");
        }
        if (c == 85) { return RequestDbConnection.KeyAt(sql, i, "USE"); }
        if (c == 65) { return RequestDbConnection.KeyAt(sql, i, "ATTACH"); }
        if (c == 67) {
            return RequestDbConnection.KeyAt(sql, i, "CREATE TEMP")
                || RequestDbConnection.KeyAt(sql, i, "CREATE TEMPORARY")
                || RequestDbConnection.KeyAt(sql, i, "CREATE LOCAL TEMP")
                || RequestDbConnection.KeyAt(sql, i, "CREATE GLOBAL TEMP");
        }
        return false;
    }

    static int Upper(int b) {
        if (b >= 97 && b <= 122) { return b - 32; }
        return b;
    }

    /* sql 从 at 起（忽略大小写）是否是整词大写关键字 kw（后面不接标识符字符，
       USE 不吃 useful、SET 不吃 settings）。 */
    static bool KeyAt(string sql, int at, string kw) {
        int k = kw.Length;
        if (at + k > sql.Length) { return false; }
        for (int j = 0; j < k; j = j + 1) {
            if (RequestDbConnection.Upper(sql[at + j]) != kw[j]) { return false; }
        }
        if (at + k == sql.Length) { return true; }
        int next = RequestDbConnection.Upper(sql[at + k]);
        return !((next >= 65 && next <= 90) || (next >= 48 && next <= 57) || next == 95);
    }

    private void Track(string sql) {
        if (!this.pinned && RequestDbConnection.SessionBound(sql)) { this.pinned = true; }
    }

    /* 取走内层连接并清空代理：调用方负责把它还给池或弃用。 */
    public IDbConnection Detach() {
        IDbConnection c = this.inner;
        this.inner = null;
        return c;
    }

    /* 异步借出；false 表示数据库不可用（不抛异常，供 Conn() 答 null）。 */
    public async bool Open() {
        if (this.inner != null) { return true; }
        if (this.failed || this.db == null) { return false; }
        IDbConnection c = null;
        if (this.read) { c = await this.db.AcquireRead(); }
        else { c = await this.db.Acquire(); }
        if (this.inner != null) {
            /* 同一请求并发 await 两条语句时，后到者把多借的那条还回去。 */
            if (c != null) { this.Return(c); }
            return true;
        }
        if (c == null) { this.failed = true; return false; }
        this.inner = c;
        return true;
    }

    /* 不挂起的可用性判定（同步 DbReady 用）：有空闲连接就借出并答 true；
       池正忙（无空闲但仍有存活连接）答 true，随后的异步语句排队等池；
       池里一条存活连接都没有答 false（数据库不可达或从未连通）。 */
    public bool OpenNow() {
        if (this.inner != null) { return true; }
        if (this.failed || this.db == null) { return false; }
        IDbConnection c = this.db.TryAcquireNow(this.read);
        if (c != null) { this.inner = c; return true; }
        return this.db.Live(this.read) > 0;
    }

    private void Return(IDbConnection c) {
        if (this.read) { this.db.ReleaseRead(c); } else { this.db.Release(c); }
    }

    private async IDbConnection Ensure() {
        if (this.inner != null) { return this.inner; }
        if (!await this.Open()) {
            throw new ApiError(503, "2001", "数据库不可用");
        }
        return this.inner;
    }

    /* 同步端点：协程无法在这里挂起，只取池中空闲连接。 */
    private IDbConnection EnsureNow() {
        if (this.inner != null) { return this.inner; }
        if (this.failed || this.db == null) {
            throw new ApiError(503, "2001", "数据库不可用");
        }
        IDbConnection c = this.db.TryAcquireNow(this.read);
        if (c == null) {
            throw new InvalidOperationException(
                "request connection not open and pool has no idle connection; "
                + "use the async API or await Conn() first");
        }
        this.inner = c;
        return c;
    }

    public DbResult Query(string sql) { this.Track(sql); return this.EnsureNow().Query(sql); }
    public DbResult Query(string sql, DbParams prms) { this.Track(sql); return this.EnsureNow().Query(sql, prms); }
    public int Execute(string sql) { this.Track(sql); return this.EnsureNow().Execute(sql); }
    public int Execute(string sql, DbParams prms) { this.Track(sql); return this.EnsureNow().Execute(sql, prms); }
    public string ExecuteScalar(string sql) { this.Track(sql); return this.EnsureNow().ExecuteScalar(sql); }
    public string ExecuteScalar(string sql, DbParams prms) { this.Track(sql); return this.EnsureNow().ExecuteScalar(sql, prms); }

    public async DbResult QueryAsync(string sql) {
        this.Track(sql);
        IDbConnection c = await this.Ensure();
        return await c.QueryAsync(sql);
    }
    public async DbResult QueryAsync(string sql, DbParams prms) {
        this.Track(sql);
        IDbConnection c = await this.Ensure();
        return await c.QueryAsync(sql, prms);
    }
    public async int ExecuteAsync(string sql) {
        this.Track(sql);
        IDbConnection c = await this.Ensure();
        return await c.ExecuteAsync(sql);
    }
    public async int ExecuteAsync(string sql, DbParams prms) {
        this.Track(sql);
        IDbConnection c = await this.Ensure();
        return await c.ExecuteAsync(sql, prms);
    }
    public async string ExecuteScalarAsync(string sql) {
        this.Track(sql);
        IDbConnection c = await this.Ensure();
        return await c.ExecuteScalarAsync(sql);
    }
    public async string ExecuteScalarAsync(string sql, DbParams prms) {
        this.Track(sql);
        IDbConnection c = await this.Ensure();
        return await c.ExecuteScalarAsync(sql, prms);
    }

    /* 方言选择在首条语句之前发生（ORM 先拼 SQL 再执行），未借出时问池。 */
    public int GetProvider() {
        if (this.inner != null) { return this.inner.GetProvider(); }
        if (this.db == null) { return 0; }
        return this.db.Provider(this.read);
    }

    /* 未借出时按「可用」回答：借用是惰性的，失败才算断开。 */
    public bool IsConnected() {
        if (this.inner != null) { return this.inner.IsConnected(); }
        return !this.failed && this.db != null;
    }

    public void Close() {
        if (this.inner != null) { this.inner.Close(); }
    }
    public void Dispose() { this.Close(); }

    public void BeginTransaction() { this.pinned = true; this.EnsureNow().BeginTransaction(); }
    public void Commit() { if (this.inner != null) { this.inner.Commit(); } }
    public void Rollback() { if (this.inner != null) { this.inner.Rollback(); } }

    public async bool BeginTransactionAsync() {
        this.pinned = true;
        IDbConnection c = await this.Ensure();
        return await c.BeginTransactionAsync();
    }
    public async bool CommitAsync() {
        if (this.inner == null) { return false; }
        return await this.inner.CommitAsync();
    }
    public async bool RollbackAsync() {
        if (this.inner == null) { return false; }
        return await this.inner.RollbackAsync();
    }
}
