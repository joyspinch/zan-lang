using System;
using System.IO;
using Zan.Web.Security;
using Zan.Web.Services;

namespace Zan.Web.Core;

/* [server] 配置。 */
public class Cfg {
    public static ServerCfg Server = ServerCfg.Defaults();
    public static DatabaseCfg Db = DatabaseCfg.Defaults();
    public static WorkerCfg Worker = WorkerCfg.Defaults();
    public static LogCfg Log = LogCfg.Defaults();
    public static CacheCfg Cache = CacheCfg.Defaults();
    public static AuthCfg Auth = AuthCfg.Defaults();
    public static MetricsCfg Metrics = MetricsCfg.Defaults();
    public static JobCfg Job = JobCfg.Defaults();
    public static ClusterCfg Cluster = ClusterCfg.Defaults();
    public static CorsCfg Cors = CorsCfg.Defaults();
    public static SecurityCfg Security = SecurityCfg.Defaults();
    public static bool loaded = false;

    /* 依次查找约定的配置文件，找到后叠加到内置默认值之上。 */
    public static void Load(string relPath) {
        loaded = true;
        List<string> cands = new List<string>();
        if (relPath.Length > 0) { cands.Add(relPath); }
        cands.Add("config/app.json");
        cands.Add("app.json");
        cands.Add("../config/app.json");
        JsonDoc root = null;
        for (int i = 0; i < cands.Count; i = i + 1) {
            if (File.Exists(cands[i])) {
                string txt = File.ReadAllText(cands[i]);
                if (txt.Length > 0) {
                    root = JsonDoc.Parse(txt);
                    Console.WriteLine("[config] loaded " + cands[i]);
                    break;
                }
            }
        }
        if (root == null) {
            Console.WriteLine("[config] no config file found; using built-in defaults");
            ApplyEnv();
            return;
        }
        Apply(root);
        ApplyEnv();
    }

    /* 环境变量覆盖，最后应用：部署时不改文件即可指向其他数据库。密码等敏感值应放在此处。 */
    private static void ApplyEnv() {
        Db.driver = EnvStr("ZAN_DB_DRIVER", Db.driver);
        Db.host = EnvStr("ZAN_DB_HOST", Db.host);
        Db.port = EnvInt("ZAN_DB_PORT", Db.port);
        Db.name = EnvStr("ZAN_DB_NAME", Db.name);
        Db.user = EnvStr("ZAN_DB_USER", Db.user);
        Db.password = EnvStr("ZAN_DB_PASSWORD", Db.password);
        Db.sqlitePath = EnvStr("ZAN_DB_SQLITE_PATH", Db.sqlitePath);
        Db.poolSize = EnvInt("ZAN_DB_POOL_SIZE", Db.poolSize);
        Cache.redisHost = EnvStr("ZAN_REDIS_HOST", Cache.redisHost);
        Cache.redisPort = EnvInt("ZAN_REDIS_PORT", Cache.redisPort);
        Worker.count = EnvInt("ZAN_WORKERS", Worker.count);
        Auth.secret = EnvStr("ZAN_AUTH_SECRET", Auth.secret);
        Auth.bootstrapPassword = EnvStr("ZAN_BOOTSTRAP_ADMIN_PASSWORD", Auth.bootstrapPassword);
        Auth.iter = EnvInt("ZAN_AUTH_PBKDF2_ITER", Auth.iter);
        Job.enabled = EnvBool("ZAN_JOB_ENABLED", Job.enabled);
        Cluster.enabled = EnvBool("ZAN_CLUSTER_ENABLED", Cluster.enabled);
    }

    private static bool EnvBool(string name, bool fallback) {
        string v = ProcessHost.Env(name);
        if (v.Length == 0) { return fallback; }
        if (v == "1" || v == "true" || v == "TRUE") { return true; }
        if (v == "0" || v == "false" || v == "FALSE") { return false; }
        return fallback;
    }

    private static string EnvStr(string name, string fallback) {
        string v = ProcessHost.Env(name);
        if (v.Length == 0) { return fallback; }
        return v;
    }

    static int EnvInt(string name, int fallback) {
        string v = ProcessHost.Env(name);
        if (v.Length == 0) { return fallback; }
        int n = Convert.ToInt32(v);
        if (n <= 0) { return fallback; }
        return n;
    }

    public static void Apply(System.Json.JsonValue val) {
        if (val == null) { return; }
        JsonDoc doc = JsonDoc.Parse(val.ToJson());
        Apply(doc);
    }

    public static void Apply(JsonDoc doc) {
        if (doc == null) { return; }

        Server.name = doc.PathStr("server.name", Server.name);
        Server.mode = doc.PathStr("server.mode", Server.mode);
        Server.host = doc.PathStr("server.host", Server.host);
        Server.port = doc.PathInt("server.port", Server.port);
        Server.maxBodyMB = doc.PathInt("server.maxBodyMB", Server.maxBodyMB);
        Server.uploadBodyMB = doc.PathInt("server.uploadBodyMB", Server.uploadBodyMB);
        Server.globalLimitPerSec = doc.PathInt("server.globalLimitPerSec", Server.globalLimitPerSec);
        Server.trustedProxies = doc.PathStr("server.trustedProxies", Server.trustedProxies);

        Db.driver = doc.PathStr("database.driver", Db.driver);
        Db.sqlitePath = doc.PathStr("database.sqlitePath", Db.sqlitePath);
        Db.host = doc.PathStr("database.host", Db.host);
        Db.port = doc.PathInt("database.port", Db.port);
        Db.name = doc.PathStr("database.name", Db.name);
        Db.user = doc.PathStr("database.user", Db.user);
        Db.password = doc.PathStr("database.password", Db.password);
        Db.poolSize = doc.PathInt("database.poolSize", Db.poolSize);

        Db.readOnly.enabled = doc.PathBool("database.readOnly.enabled", Db.readOnly.enabled);
        Db.readOnly.driver = doc.PathStr("database.readOnly.driver", Db.readOnly.driver);
        Db.readOnly.sqlitePath = doc.PathStr("database.readOnly.sqlitePath", Db.readOnly.sqlitePath);
        Db.readOnly.host = doc.PathStr("database.readOnly.host", Db.readOnly.host);
        Db.readOnly.port = doc.PathInt("database.readOnly.port", Db.readOnly.port);
        Db.readOnly.name = doc.PathStr("database.readOnly.name", Db.readOnly.name);
        Db.readOnly.user = doc.PathStr("database.readOnly.user", Db.readOnly.user);
        Db.readOnly.password = doc.PathStr("database.readOnly.password", Db.readOnly.password);
        Db.readOnly.poolSize = doc.PathInt("database.readOnly.poolSize", Db.readOnly.poolSize);

        Worker.count = doc.PathInt("worker.count", Worker.count);
        Worker.daemon = doc.PathBool("worker.daemon", Worker.daemon);

        Log.access = doc.PathBool("log.access", Log.access);
        Log.slowMs = doc.PathInt("log.slowMs", Log.slowMs);
        Log.slowSqlMs = doc.PathInt("log.slowSqlMs", Log.slowSqlMs);
        Log.dir = doc.PathStr("log.dir", Log.dir);
        Log.pattern = doc.PathStr("log.pattern", Log.pattern);
        Log.errorLog = doc.PathStr("log.errorLog", Log.errorLog);
        Log.debug = doc.PathBool("log.debug", Log.debug);

        Metrics.enabled = doc.PathBool("metrics.enabled", Metrics.enabled);
        Metrics.path = doc.PathStr("metrics.path", Metrics.path);
        Metrics.flushSeconds = doc.PathInt("metrics.flushSeconds", Metrics.flushSeconds);
        Metrics.flushRows = doc.PathInt("metrics.flushRows", Metrics.flushRows);
        Metrics.keepDays = doc.PathInt("metrics.keepDays", Metrics.keepDays);
        Metrics.alertErrPct = doc.PathInt("metrics.alertErrPct", Metrics.alertErrPct);
        Metrics.alertErrCalls = doc.PathInt("metrics.alertErrCalls", Metrics.alertErrCalls);
        Metrics.alertP95Ms = doc.PathInt("metrics.alertP95Ms", Metrics.alertP95Ms);

        Cache.driver = doc.PathStr("cache.driver", Cache.driver);
        Cache.redisHost = doc.PathStr("cache.redisHost", Cache.redisHost);
        Cache.redisPort = doc.PathInt("cache.redisPort", Cache.redisPort);
        Cache.poolSize = doc.PathInt("cache.poolSize", Cache.poolSize);
        Cache.connectTimeoutMs = doc.PathInt("cache.connectTimeoutMs", Cache.connectTimeoutMs);

        Auth.secret = doc.PathStr("auth.secret", Auth.secret);
        Auth.bootstrapPassword = doc.PathStr("auth.bootstrapPassword", Auth.bootstrapPassword);
        Auth.iter = doc.PathInt("auth.iter", Auth.iter);

        Job.enabled = doc.PathBool("job.enabled", Job.enabled);

        Cluster.enabled = doc.PathBool("cluster.enabled", Cluster.enabled);
        Cluster.bus = doc.PathStr("cluster.bus", Cluster.bus);
        Cluster.channel = doc.PathStr("cluster.channel", Cluster.channel);

        Cors.enabled = doc.PathBool("cors.enabled", Cors.enabled);
        Cors.allowOrigin = doc.PathStr("cors.allowOrigin", Cors.allowOrigin);
        Cors.allowMethods = doc.PathStr("cors.allowMethods", Cors.allowMethods);
        Cors.allowHeaders = doc.PathStr("cors.allowHeaders", Cors.allowHeaders);
        Cors.allowCredentials = doc.PathBool("cors.allowCredentials", Cors.allowCredentials);
        Cors.maxAge = doc.PathInt("cors.maxAge", Cors.maxAge);

        Security.csp = doc.PathBool("security.csp", Security.csp);
    }
}
