using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using Zan.Web.Model;
using Zan.Web.Core;
using Zan.Web.Security;
using Zan.Web;

namespace Zan.Web.Services;

/* 站点全局设置（标题、关键词、备案号等），每 worker 缓存一分钟，保存后本 worker 立即失效。 */
public class Settings {
    public static const int CacheSeconds = 60;

    /* 本 worker 的设置缓存及过期时间，用 StrMap 避免扫描与换行符转义。 */
    private static StrMap values;
    private static long expires;

    public static void Prime(StrMap m) {
        values = m;
        expires = WebApp.NowSeconds() + (long)CacheSeconds;
    }

    public static void Prime(StrMap m, int cacheSeconds) {
        values = m;
        expires = WebApp.NowSeconds() + (long)cacheSeconds;
    }

    /* 加载所有设置，每 worker 每分钟一次。 */
    public static async StrMap All() {
        return await All(null);
    }

    internal static async StrMap All(IDbConnection connection) {
        long now = WebApp.NowSeconds();
        if (values != null && now < expires) {
            return values;
        }
        IDbConnection db = connection;
        if (db == null) { db = await AuthUser.Lease(); }
        if (db == null) {
            /* 数据库不可用时返回旧缓存，下次读取时重试。 */
            if (values != null) { return values; }
            return new StrMap();
        }
        StrMap m = new StrMap();
        try {
            IZanSql fsql = ZanSql.FromConnection(db);
            List<SysSiteSetting> rows = await fsql.Select<SysSiteSetting>().ToListAsync();
            for (int i = 0; i < rows.Count; i = i + 1) {
                m.Set(rows[i].name, rows[i].value);
            }
        } finally {
            if (connection == null) { AuthUser.Give(db); }
        }
        Fmt.SetOffsetMinutes(Filter.ToInt(m.Get(SettingKeys.SiteTimezone), 0));
        values = m;
        expires = now + CacheSeconds;
        return m;
    }

    /* 保存后清除本 worker 的缓存。 */
    public static void Forget() {
        values = null;
        expires = 0;
    }

    /* 读取一个设置，未配置或为空时返回默认值。 */
    public static async string Get(string name, string def) {
        StrMap m = await All();
        string v = m.Get(name);
        if (v.Length == 0) { return def; }
        return v;
    }

    /* 布尔设置：非 "0" 即为 true。 */
    public static async bool On(string name, bool def) {
        string v = await Get(name, "");
        if (v.Length == 0) { return def; }
        return v != "0";
    }

    private static string[] viewDataKeys() {
        return new string[] {
            "siteTitle", "siteSubtitle", "siteKeywords", "siteDescription",
            "siteIcp", "sitePolice", "siteCopyright", "siteContact", "siteAnalytics",
            "brandBadge", "siteCtaText"
        };
    }

    private static string[] viewSettingKeys() {
        return new string[] {
            SettingKeys.SiteTitle, SettingKeys.SiteSubtitle, SettingKeys.SiteKeywords,
            SettingKeys.SiteDescription, SettingKeys.SiteIcp, SettingKeys.SitePolice,
            SettingKeys.SiteCopyright, SettingKeys.SiteContact, SettingKeys.SiteAnalytics,
            SettingKeys.SiteBrandBadge, SettingKeys.SiteCtaText
        };
    }

    /* 仅放行 / 开头站内路径（非 //）、http(s):// 或 data:image/，拦截 javascript: 与引号注入。 */
    public static string SafeBrandAssetUrl(string raw, bool allowDataImage) {
        if (raw == null) { return ""; }
        string s = raw.Trim();
        if (s.Length == 0) { return ""; }
        if (s.Contains("\"") || s.Contains("'") || s.Contains("<") || s.Contains(">")
            || s.Contains("\r") || s.Contains("\n")) {
            return "";
        }
        if (s.StartsWith("/") && !s.StartsWith("//")) { return s; }
        string low = s.ToLower();
        if (low.StartsWith("https://") || low.StartsWith("http://")) { return s; }
        if (allowDataImage && low.StartsWith("data:image/")) { return s; }
        return "";
    }

    /* 仅放行站内相对路径（/ 开头且非 //）或 http(s)://，供 CTA 跳转按钮使用。 */
    public static string SafeNavUrl(string raw, string fallback) {
        string safe = SafeBrandAssetUrl(raw, false);
        if (safe.Length == 0) { return fallback; }
        return safe;
    }

    /* 将公开设置注入视图数据（站点标题、品牌白标、备案号、联系方式等）。 */
    public static async void Apply(ViewData d) {
        StrMap m = await All();
        string[] dkeys = viewDataKeys();
        string[] skeys = viewSettingKeys();
        for (int i = 0; i < dkeys.Length; i = i + 1) {
            string val = m.Get(skeys[i]);
            if (skeys[i] == SettingKeys.SiteTitle && val.Length == 0) { val = "ZanWeb 企业平台"; }
            else if (skeys[i] == SettingKeys.SiteBrandBadge && val.Length == 0) { val = "ENTERPRISE PLATFORM"; }
            else if (skeys[i] == SettingKeys.SiteCtaText && val.Length == 0) { val = "进入控制台"; }
            d.Set(dkeys[i], val);
        }
        string title = m.GetOr(SettingKeys.SiteTitle, "ZanWeb 企业平台");
        d.Set("brandInitial", Fmt.FirstChar(title));
        string logo = SafeBrandAssetUrl(m.Get(SettingKeys.SiteLogoUrl), true);
        if (logo.Length > 0) { d.Set("brandLogoUrl", logo); }
        d.Set("siteCtaUrl", SafeNavUrl(m.Get(SettingKeys.SiteCtaUrl), "/admin"));
        if (await On(SettingKeys.RegisterEnabled, false)) {
            d.Set("canRegister", "1");
        }
        if (await On(SettingKeys.ResetEnabled, true)) {
            d.Set("canReset", "1");
        }
    }
}
