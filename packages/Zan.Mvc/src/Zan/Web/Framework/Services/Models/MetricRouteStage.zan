using System.Data.Orm;

namespace Zan.Web.Services;

[Table(Name = "metrics_route_stages")]
[Index(Name = "ix_metrics_route_stages_route", Fields = "route, method, minute")]
public class MetricRouteStage {
    [Column(IsPrimary = true)]
    public long minute;
    [Column(IsPrimary = true, StringLength = 16)]
    public string method;
    [Column(IsPrimary = true, StringLength = 400)]
    public string route;
    [Column(IsPrimary = true, StringLength = 32)]
    public string stage;
    public long calls;
    public long completed;
    [Column(Name = "elapsed_us")]
    public long elapsedUs;
    [Column(Name = "max_us")]
    public long maxUs;
    public long failed;

    internal void Observe(long elapsed, bool failed) {
        this.calls += 1;
        if (failed) { this.failed += 1; }
        if (elapsed < 0) { return; }
        this.completed += 1;
        this.elapsedUs += elapsed;
        if (elapsed > this.maxUs) { this.maxUs = elapsed; }
    }

    internal void Add(MetricRouteStage other) {
        this.calls += other.calls;
        this.completed += other.completed;
        this.elapsedUs += other.elapsedUs;
        if (other.maxUs > this.maxUs) { this.maxUs = other.maxUs; }
        this.failed += other.failed;
    }
}
