using System.Data.Orm;
using System.Json;

namespace Zan.Web.Services;

[Table(Name = "metrics_route_resources")]
[Index(Name = "ix_metrics_route_resources_route", Fields = "route, method, minute")]
public class MetricRouteResource {
    internal static const string HeaderToCleanup = "header-to-cleanup";
    internal static const string Application = "application";
    internal static const string ReadLoopToCleanup = "read-loop-to-cleanup";
    internal static const int GroupCount = 6;

    [Column(IsPrimary = true)]
    public long minute;
    [Column(IsPrimary = true, StringLength = 16)]
    public string method;
    [Column(IsPrimary = true, StringLength = 400)]
    public string route;
    [Column(IsPrimary = true, StringLength = 24)]
    public string coverage;
    [Column(Name = "cpu_unit", IsPrimary = true, StringLength = 8)]
    public string cpuUnit;
    public long samples;
    [Column(Name = "cpu_samples")]
    public long cpuSamples;
    public long cpu;
    [Column(Name = "allocated_bytes")]
    public long allocatedBytes;
    public long slices;
    [Column(Name = "unfinished_tasks")]
    public long unfinishedTasks;

    internal static int GroupSlot(string coverage, string cpuUnit) {
        int offset;
        if (coverage == HeaderToCleanup) { offset = 0; }
        else if (coverage == Application) { offset = 2; }
        else if (coverage == ReadLoopToCleanup) { offset = 4; }
        else { return -1; }
        if (cpuUnit == "cycles") { return offset; }
        if (cpuUnit == "ns") { return offset + 1; }
        return -1;
    }

    internal void Observe(long cpu, long bytes, long slices, long unfinishedTasks) {
        this.samples += 1;
        if (cpu >= 0) {
            this.cpuSamples += 1;
            this.cpu += cpu;
        }
        this.allocatedBytes += bytes;
        this.slices += slices;
        this.unfinishedTasks += unfinishedTasks;
    }

    internal void Add(MetricRouteResource other) {
        this.samples += other.samples;
        this.cpuSamples += other.cpuSamples;
        this.cpu += other.cpu;
        this.allocatedBytes += other.allocatedBytes;
        this.slices += other.slices;
        this.unfinishedTasks += other.unfinishedTasks;
    }

    internal void WriteCounts(JsonWriter w) {
        w.WriteStartObject();
        w.WriteProperty("coverage", this.coverage);
        w.WriteProperty("cpu_unit", this.cpuUnit);
        w.WriteProperty("samples", this.samples);
        w.WriteProperty("cpu_samples", this.cpuSamples);
        w.WriteProperty("cpu", this.cpuSamples > 0 ? this.cpu : -1);
        w.WriteProperty("allocated_bytes", this.allocatedBytes);
        w.WriteProperty("slices", this.slices);
        w.WriteProperty("unfinished_tasks", this.unfinishedTasks);
        w.WriteEndObject();
    }
}
