using System.Data.Orm;
using System.Json;

namespace Zan.Web.Services;

[Table(Name = "metrics_route_diagnostics")]
[Index(Name = "ix_metrics_route_diagnostics_route", Fields = "route, method, minute")]
public class MetricRouteDiagnostic {
    [Column(IsPrimary = true)]
    public long minute;
    [Column(IsPrimary = true, StringLength = 16)]
    public string method;
    [Column(IsPrimary = true, StringLength = 400)]
    public string route;
    public long samples;
    [Column(Name = "elapsed_us")]
    public long elapsedUs;
    [Column(Name = "max_us")]
    public long maxUs;
    public long failed;
    public long incomplete;
    [Column(Name = "sql_calls")]
    public long sqlCalls;
    [Column(Name = "sql_completed")]
    public long sqlCompleted;
    [Column(Name = "sql_us")]
    public long sqlUs;
    [Column(Name = "sql_failed")]
    public long sqlFailed;
    [Column(Ignore = true)]
    internal MetricRouteResource[] resources;

    internal MetricRouteResource Resource(string coverage, string cpuUnit) {
        int slot = MetricRouteResource.GroupSlot(coverage, cpuUnit);
        if (slot < 0) { return null; }
        if (this.resources == null) { this.resources = new MetricRouteResource[MetricRouteResource.GroupCount]; }
        MetricRouteResource row = this.resources[slot];
        if (row == null) {
            row = new MetricRouteResource();
            row.minute = this.minute;
            row.method = this.method;
            row.route = this.route;
            row.coverage = coverage;
            row.cpuUnit = cpuUnit;
            this.resources[slot] = row;
        }
        return row;
    }

    internal void Add(MetricRouteDiagnostic other) {
        this.samples += other.samples;
        this.elapsedUs += other.elapsedUs;
        if (other.maxUs > this.maxUs) { this.maxUs = other.maxUs; }
        this.failed += other.failed;
        this.incomplete += other.incomplete;
        this.sqlCalls += other.sqlCalls;
        this.sqlCompleted += other.sqlCompleted;
        this.sqlUs += other.sqlUs;
        this.sqlFailed += other.sqlFailed;
        if (other.resources == null) { return; }
        foreach (MetricRouteResource resource in other.resources) {
            if (resource != null) { this.AddResource(resource); }
        }
    }

    internal void AddResource(MetricRouteResource other) {
        MetricRouteResource row = this.Resource(other.coverage, other.cpuUnit);
        if (row != null) { row.Add(other); }
    }

    internal void WriteCounts(JsonWriter w) {
        w.WriteProperty("samples", this.samples);
        w.WriteProperty("elapsed_us", this.elapsedUs);
        w.WriteProperty("max_us", this.maxUs);
        w.WriteProperty("failed", this.failed);
        w.WriteProperty("incomplete", this.incomplete);
        w.WriteProperty("sql_calls", this.sqlCalls);
        w.WriteProperty("sql_completed", this.sqlCompleted);
        w.WriteProperty("sql_us", this.sqlUs);
        w.WriteProperty("sql_failed", this.sqlFailed);
        if (this.resources != null) {
            w.WritePropertyName("resources").WriteStartArray();
            foreach (MetricRouteResource resource in this.resources) {
                if (resource != null) { resource.WriteCounts(w); }
            }
            w.WriteEndArray();
        }
    }
}
