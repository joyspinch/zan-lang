namespace Zan.Web.Services;

internal class RouteDiagnosticBucket {
    public MetricRouteDiagnostic row = new MetricRouteDiagnostic();
    public MetricRouteStage[] stages;

    public RouteDiagnosticBucket(long minute, string method, string route, int stageCount) {
        this.row.minute = minute;
        this.row.method = method;
        this.row.route = route;
        this.stages = new MetricRouteStage[stageCount];
    }

    public MetricRouteStage Stage(int index, string name) {
        MetricRouteStage stage = this.stages[index];
        if (stage == null) {
            stage = new MetricRouteStage();
            stage.minute = this.row.minute;
            stage.method = this.row.method;
            stage.route = this.row.route;
            stage.stage = name;
            this.stages[index] = stage;
        }
        return stage;
    }

    public void Add(RouteDiagnosticBucket other) {
        this.row.Add(other.row);
        for (int i = 0; i < this.stages.Length; i += 1) {
            MetricRouteStage stage = other.stages[i];
            if (stage == null) { continue; }
            MetricRouteStage current = this.stages[i];
            if (current == null) { this.stages[i] = stage; }
            else { current.Add(stage); }
        }
    }
}
