using System;
using System.Collections.Generic;

namespace Zan.Web.Services;

/* 运行监控的历史数据存储：内存按分钟聚合后批量写入独立 SQLite 数据库。 */
public class MetricsStore {
    public static List<MinuteBucket> buckets = new List<MinuteBucket>();
    public static List<MetricError> errors = new List<MetricError>();
    /* 待写入的 SQL 模板聚合（按模板聚合，每个慢查询只累加一次）。 */
    public static List<MetricSql> sqlBuckets = new List<MetricSql>();
    /* 已摘取但尚未提交的批次独立保留；新到记录仍写入上面的活动队列。 */
    public static List<MinuteBucket> retryBuckets = new List<MinuteBucket>();
    public static List<MetricError> retryErrors = new List<MetricError>();
    public static List<MetricSql> retrySqlBuckets = new List<MetricSql>();
    public static object batchLock = new object();
    public static bool flushActive = false;
    /* 未刷新桶数上限，超出则丢弃最旧记录。 */
    public static int MaxBuckets = 8192;
    public static int MaxErrors = 4096;
    /* 内存 SQL 模板数上限，超出时折叠为"其他语句"。 */
    public static int MaxSqlShapes = 512;
    public static string OtherSql = "(其他语句)";
    public static DbPool pool = null;
    public static bool ready = false;
    public static bool flushing = false;
    public static long lastSweep = 0;

    /* 历史库是否就绪：不就绪时查询端（告警评估等）直接空手而回。 */
    public static bool Ready() { return ready; }

    /* 初始化 metrics.db，创建表并启动后台刷新；失败时继续运行但不记历史。 */
    public static async bool Start() {
        if (!Cfg.Metrics.enabled) { return false; }
        Db.EnsureFileDir(Cfg.Metrics.path);
        pool = SqliteConnector.Pool(Cfg.Metrics.path, 1);
        IDbConnection db = await Lease();
        if (db == null) { return false; }
        try {
            /* WAL 模式：刷新写入时历史界面仍可读取。 */
            await DbSchema.UseWriteAheadLogAsync(db);
            /* 旧版使用不同键（route 列 + 毫秒单位），新表独立创建，旧数据归档为 _legacy。 */
            await RetireLegacyMinutes(db);
            /* CodeFirst 建表/加列/建索引；SQL 统计按天聚合，分钟仅用于刷新时机。 */
            IZanSql fsql = ZanSql.FromConnection(db);
            await fsql.SyncStructureAsync<MetricMinute>();
            await fsql.SyncStructureAsync<MetricError>();
            await fsql.SyncStructureAsync<MetricSql>();
            await fsql.SyncStructureAsync<MetricLive>();
        } finally {
            Give(db);
        }
        ready = true;
        return true;
    }

    public static async IDbConnection Lease() {
        if (pool == null) { return null; }
        IDbConnection db = await pool.AcquireAsync();
        if (db == null || !db.IsConnected()) {
            pool.Release(db);
            return null;
        }
        return db;
    }

    public static void Give(IDbConnection db) {
        if (pool == null || db == null) { return; }
        pool.Release(db);
    }

    /* 截断到分钟的 epoch 秒。 */
    public static long Minute(long sec) { return sec - (sec % 60); }

    /* 截断到午夜的 epoch 秒。 */
    public static long Day(long sec) { return sec - (sec % 86400); }

    /* 检测并重命名旧版 metrics_minute 表（按 route 或 total_ms 列判断），归档为 _legacy。 */
    public static async void RetireLegacyMinutes(IDbConnection db) {
        try {
            bool exists = await DbSchema.TableExistsAsync(db,
                "metrics_minute");
            if (!exists) { return; }
            /* 通过 route 或 total_ms 列判断是否为旧版表结构。 */
            List<string> gone = new List<string> { "route", "total_ms" };
            bool old = await DbSchema.HasAnyColumnAsync(db,
                "metrics_minute", gone);
            if (!old) { return; }
            await DbSchema.RenameTableAsync(db, "metrics_minute",
                "metrics_minute_legacy");
            Console.WriteLine("[metrics] history schema changed: previous "
                + "rows kept in metrics_minute_legacy");
        } catch (Exception ex) {
            /* 检查失败不影响服务启动。 */
            Console.WriteLine("[metrics] legacy history check failed: "
                + ex.Message);
        }
    }

    /* 首次有数据可刷新时启动后台刷新协程，避免启动阶段阻塞。 */
    public static void Arm() {
        if (flushing || !ready) { return; }
        flushing = true;
        Task.Spawn(Loop());
        Task.Spawn(MetricsCluster.Loop());
    }

    /* 获取当前分钟的桶，不存在则创建。 */
    public static MinuteBucket Bucket(string method, string path) {
        Arm();
        long m = Minute((long)WebApp.NowSeconds());
        int n = buckets.Count;
        /* 当前分钟桶位于列表末尾，倒序查找即可。 */
        for (int i = n - 1; i >= 0; i = i - 1) {
            MinuteBucket b = buckets[i];
            if (b.row.minute != m) { break; }
            if (b.row.method == method && b.row.path == path) { return b; }
        }
        MinuteBucket b2 = new MinuteBucket();
        b2.row = new MetricMinute();
        b2.row.minute = m;
        b2.row.method = method;
        b2.row.path = path;
        /* 直方图与 ServerMetrics 实时序列同一套档位：同一耗时口径，
 屏上实时 P95 与这里落库的 P95 可互相对照。 */
        b2.hist = new long[ServerMetrics.HIST_BINS];
        buckets.Add(b2);
        while (buckets.Count > MaxBuckets) {
            buckets.RemoveAt(0);
        }
        return b2;
    }

    /* 记录一次请求完成（含状态码与耗时）。 */
    public static void Record(string method, string path, int status, long us) {
        if (!Cfg.Metrics.enabled) { return; }
        lock (batchLock) {
            MinuteBucket b = Bucket(method, path);
            b.row.calls = b.row.calls + 1;
            b.row.totalUs = b.row.totalUs + us;
            if (us > b.row.maxUs) { b.row.maxUs = us; }
            if (status >= 500) { b.row.errors = b.row.errors + 1; }
            int bin = ServerMetrics.HistBin(us);
            b.hist[bin] = b.hist[bin] + 1;
        }
    }

    /* 长连接以推送帧数/字节计量，不计耗时。 */
    public static void Pushed(string method, string path, long frames, long bytes) {
        if (!Cfg.Metrics.enabled) { return; }
        lock (batchLock) {
            MinuteBucket b = Bucket(method, path);
            b.row.frames = b.row.frames + frames;
            b.row.bytes = b.row.bytes + bytes;
        }
    }

    /* 记录一条 SQL 执行结果，累加到当天模板聚合中。SQL 已规范化，耗时单位微秒。 */
    public static void RecordSql(string norm, long us, bool slow) {
        if (!Cfg.Metrics.enabled) { return; }
        lock (batchLock) {
            Arm();
            MetricSql e = SqlEntry(norm);
            e.calls = e.calls + 1;
            e.totalUs = e.totalUs + us;
            if (us > e.maxUs) { e.maxUs = us; }
            if (slow) { e.slow = e.slow + 1; }
        }
    }

    /* 获取今日 SQL 模板聚合项，上限超出则折叠为"其他语句"。 */
    public static MetricSql SqlEntry(string norm) {
        long d = Day((long)WebApp.NowSeconds());
        return SqlEntryIn(sqlBuckets, d, norm);
    }

    /* 活动与重试队列使用同一容量策略；额外一个槽位留给 OtherSql。
 跨天时不能混合主键，淘汰最旧项，避免每天新增一个溢出桶。 */
    public static MetricSql SqlEntryIn(List<MetricSql> rows, long day, string norm) {
        for (int i = rows.Count - 1; i >= 0; i = i - 1) {
            MetricSql e = rows[i];
            if (e.day == day && e.sql == norm) { return e; }
        }
        if (rows.Count >= MaxSqlShapes) {
            for (int i = 0; i < rows.Count; i = i + 1) {
                MetricSql o = rows[i];
                if (o.day == day && o.sql == OtherSql) { return o; }
            }
            norm = OtherSql;
        }
        MetricSql n = new MetricSql();
        n.day = day;
        n.sql = norm;
        rows.Add(n);
        while (rows.Count > MaxSqlShapes + 1) {
            rows.RemoveAt(0);
        }
        return n;
    }

    /* 向错误队列添加一条错误记录。 */
    public static void Failed(long ts, string origin, string detail) {
        if (!Cfg.Metrics.enabled) { return; }
        MetricError e = new MetricError();
        e.ts = ts;
        e.origin = origin;
        e.detail = detail;
        lock (batchLock) {
            errors.Add(e);
            while (errors.Count > MaxErrors) {
                errors.RemoveAt(0);
            }
        }
    }

    /* 直方图 P95：第 95 百分位所在档位的上沿（微秒）；末档没有上沿， 用实测最慢值兜底。档位粒度是买的确定性的价格：每次请求一次增量， 不留样本、不排序。 */
    public static long HistP95(long[] hist, long calls, long maxUs) {
        if (calls <= 0) { return 0; }
        long cut = calls * 95 / 100;
        if (cut < 1) { cut = 1; }
        long acc = 0;
        for (int b = 0; b < ServerMetrics.HIST_BINS; b = b + 1) {
            acc = acc + hist[b];
            if (acc >= cut) {
                if (b >= ServerMetrics.HIST_BINS - 1) { return maxUs; }
                return ServerMetrics.HistEdge(b);
            }
        }
        return maxUs;
    }

    /* 后台刷新协程：每秒检查一次，到达间隔或数量阈值时刷新。 */
    public static async void Loop() {
        int waited = 0;
        while (true) {
            await Task.Delay(1000);
            waited = waited + 1;
            bool due = waited >= Cfg.Metrics.flushSeconds;
            bool full = false;
            lock (batchLock) {
                full = buckets.Count >= Cfg.Metrics.flushRows
                    || errors.Count >= Cfg.Metrics.flushRows
                    || sqlBuckets.Count >= Cfg.Metrics.flushRows;
            }
            if (!due && !full) { continue; }
            waited = 0;
            await Flush();
        }
    }

    /* 在 batchLock 内、开始任何 await 之前合并；重试期间同键只留一行。 P95 与数据库冲突更新一致，取各摘取批次的最大值，而非重算分位数。 容量按每个队列限制，活动队列仍独立接收刷新期间的新记录。 */
    public static void MergeRetry() {
        for (int i = 0; i < buckets.Count; i = i + 1) {
            MinuteBucket add = buckets[i];
            add.row.p95Us = HistP95(add.hist, add.row.calls,
                add.row.maxUs);
            MinuteBucket hit = null;
            for (int j = 0; j < retryBuckets.Count; j = j + 1) {
                MinuteBucket b = retryBuckets[j];
                if (b.row.minute == add.row.minute
                    && b.row.method == add.row.method && b.row.path == add.row.path) {
                    hit = b;
                    break;
                }
            }
            if (hit == null) {
                retryBuckets.Add(add);
            } else {
                hit.row.calls = hit.row.calls + add.row.calls;
                hit.row.errors = hit.row.errors + add.row.errors;
                hit.row.totalUs = hit.row.totalUs + add.row.totalUs;
                hit.row.frames = hit.row.frames + add.row.frames;
                hit.row.bytes = hit.row.bytes + add.row.bytes;
                if (add.row.maxUs > hit.row.maxUs) { hit.row.maxUs = add.row.maxUs; }
                if (add.row.p95Us > hit.row.p95Us) { hit.row.p95Us = add.row.p95Us; }
                for (int bin = 0; bin < ServerMetrics.HIST_BINS; bin = bin + 1) {
                    hit.hist[bin] = hit.hist[bin] + add.hist[bin];
                }
            }
        }
        while (retryBuckets.Count > MaxBuckets) {
            retryBuckets.RemoveAt(0);
        }
        for (int i = 0; i < sqlBuckets.Count; i = i + 1) {
            MetricSql add = sqlBuckets[i];
            MetricSql hit = SqlEntryIn(retrySqlBuckets,
                add.day, add.sql);
            hit.calls = hit.calls + add.calls;
            hit.slow = hit.slow + add.slow;
            hit.totalUs = hit.totalUs + add.totalUs;
            if (add.maxUs > hit.maxUs) { hit.maxUs = add.maxUs; }
        }
        retryErrors.AddRange(errors);
        while (retryErrors.Count > MaxErrors) {
            retryErrors.RemoveAt(0);
        }
    }

    /* 事务性刷新所有缓冲数据，当前分钟也写入以防进程退出丢失。 */
    public static async int Flush() {
        if (!ready) { return 0; }
        lock (batchLock) {
            if (flushActive) { return 0; }
            if (buckets.Count == 0 && errors.Count == 0
                && sqlBuckets.Count == 0
                && retryBuckets.Count == 0
                && retryErrors.Count == 0
                && retrySqlBuckets.Count == 0) {
                return 0;
            }
            flushActive = true;
            /* 先挂到重试批次，再腾出活动队列；任意 await 期间的新数据
 都落在活动队列里，不会被成功提交或失败回收误删。 */
            MergeRetry();
            buckets = new List<MinuteBucket>();
            errors = new List<MetricError>();
            sqlBuckets = new List<MetricSql>();
        }
        IDbConnection db = null;
        DbPool leasedPool = pool;
        bool discard = false;
        int written = 0;
        try {
            List<MetricMinute> mine = new List<MetricMinute>();
            for (int i = 0; i < retryBuckets.Count; i = i + 1) {
                MinuteBucket b = retryBuckets[i];
                mine.Add(b.row);
            }
            db = await Lease();
            if (db != null) {
                IZanSql fsql = ZanSql.FromConnection(db);
                if (!await db.BeginTransactionAsync()) {
                    throw new Exception("begin transaction failed");
                }
                /* 写入时按复合键合并：冲突时累加计数器、取最大 maxUs，最终每桶一行。 */
                if (mine.Count > 0) {
                    written = written + await fsql.Insert<MetricMinute>(mine)
                        .OnConflict("minute")
                        .SetIncr("calls")
                        .SetIncr("errors")
                        .SetIncr("total_us")
                        .SetMax("max_us")
                        .SetMax("p95_us")
                        .SetIncr("frames")
                        .SetIncr("bytes")
                        .ExecuteAffrowsAsync();
                }
                /* 按 (day, sql) 合并，所有工作进程累积到同一行。 */
                if (retrySqlBuckets.Count > 0) {
                    written = written + await fsql.Insert<MetricSql>(retrySqlBuckets)
                        .OnConflict("day")
                        .SetIncr("calls")
                        .SetIncr("slow")
                        .SetIncr("total_us")
                        .SetMax("max_us")
                        .ExecuteAffrowsAsync();
                }
                /* 错误为事件记录，每条独立一行。 */
                if (retryErrors.Count > 0) {
                    written = written + await fsql.Insert<MetricError>(retryErrors)
                        .ExecuteAffrowsAsync();
                }
                if (!await db.CommitAsync()) {
                    throw new Exception("commit failed");
                }
                /* 只有确认提交成功才丢弃批次；清理过期行失败不能重放已提交数据。 */
                lock (batchLock) {
                    retryBuckets = new List<MinuteBucket>();
                    retryErrors = new List<MetricError>();
                    retrySqlBuckets = new List<MetricSql>();
                }
                try {
                    await Sweep(fsql);
                } catch (Exception sweepEx) {
                    Console.WriteLine("[metrics] sweep failed: " + sweepEx.Message);
                }
            }
        } catch (Exception ex) {
            if (db != null) {
                try {
                    if (!await db.RollbackAsync()) {
                        throw new Exception("rollback failed");
                    }
                } catch (Exception rollbackEx) {
                    /* 先摘除池内租约并释放槽位；Close 自身抛错也不能
 把未知事务状态的连接回池或永久占住唯一槽位。 */
                    discard = true;
                    leasedPool.core.Drop(db);
                    Console.WriteLine("[metrics] rollback failed: "
                        + rollbackEx.Message);
                    try {
                        db.Close();
                    } catch (Exception closeEx) {
                        Console.WriteLine("[metrics] close failed: "
                            + closeEx.Message);
                    }
                }
            }
            /* 未提交批次保持原样；下次 Flush 连同新到的批次重试。 */
            Console.WriteLine("[metrics] flush failed: " + ex.Message);
            written = 0;
        } finally {
            try {
                if (!discard && db != null && leasedPool != null) {
                    leasedPool.Release(db);
                }
            } finally {
                lock (batchLock) {
                    flushActive = false;
                }
            }
        }
        return written;
    }

    /* 停机钩子（Boot 经 Worker.OnShutdown 注册）：排空完成后的最后一冲， 把不满一个 flushSeconds 窗口的残余指标落库再退——停机不再丢最后一个 刷新窗口（默认 ≤60s）的数据。Flush 自带 ready/flushActive 门， 与后台 Loop 并发安全，异常也已兜底记日志。 */
    public static async void FlushAtExit() {
        await Flush();
    }

    /* 按保留天数清理过期数据，每小时最多执行一次。 */
    public static async void Sweep(IZanSql fsql) {
        long now = (long)WebApp.NowSeconds();
        if (now - lastSweep < 3600) { return; }
        lastSweep = now;
        long cut = now - (long)Cfg.Metrics.keepDays * 86400;
        long dayCut = Day(cut);
        int _a = await fsql.Delete<MetricMinute>()
            .Where(a => a.minute < cut).ExecuteAffrowsAsync();
        int _b = await fsql.Delete<MetricError>()
            .Where(a => a.ts < cut).ExecuteAffrowsAsync();
        int _c = await fsql.Delete<MetricSql>()
            .Where(a => a.day < dayCut).ExecuteAffrowsAsync();
    }

    /* 查询窗口内 SQL 模板聚合，按调用/耗时/慢次数排序，数据库端聚合，无原始行入内存。 */
    public static async List<MetricSql> SqlTotals(long from, long to, int limit,
                                           string rank) {
        List<MetricSql> outp = new List<MetricSql>();
        if (!ready) { return outp; }
        IDbConnection db = await Lease();
        if (db == null) { return outp; }
        IZanSql fsql = ZanSql.FromConnection(db);
        long a0 = Day(from);
        long b0 = Day(to);
        int order = 2;
        if (rank == "time") {
            order = 4;
        } else if (rank == "slow") {
            order = 3;
        }
        string sql = "SELECT sql, SUM(calls), SUM(slow), SUM(total_us), "
            + "MAX(max_us) FROM metrics_sql_day "
            + "WHERE day >= ? AND day <= ? "
            + "GROUP BY sql ORDER BY " + Convert.ToString(order)
            + " DESC LIMIT " + Convert.ToString(limit);
        DbParams prms = new DbParams().AddLong(a0).AddLong(b0);
        try {
            DbResult r = await fsql.QueryAsync(sql, prms);
            for (int i = 0; i < r.RowCount(); i = i + 1) {
                MetricSql e = new MetricSql();
                e.day = a0;
                e.sql = r.GetString(i, 0);
                e.calls = r.GetLong(i, 1);
                e.slow = r.GetLong(i, 2);
                e.totalUs = r.GetLong(i, 3);
                e.maxUs = r.GetLong(i, 4);
                outp.Add(e);
            }
        } finally {
            Give(db);
        }
        return outp;
    }

    /* 详情只接受窗口内已持久化的规范化模板；调用方传入的文本只是定位键，
 不命中当前窗口时返回 null，避免详情端点变成任意回显接口。 */
    public static async MetricSql SqlOne(long from, long to, string shape) {
        if (!ready || shape.Length == 0) { return null; }
        IDbConnection db = await Lease();
        if (db == null) { return null; }
        IZanSql fsql = ZanSql.FromConnection(db);
        MetricSql outp = null;
        long a0 = Day(from);
        long b0 = Day(to);
        string sql = "SELECT sql, SUM(calls), SUM(slow), SUM(total_us), "
            + "MAX(max_us) FROM metrics_sql_day WHERE day >= ? AND day <= ? "
            + "AND sql = ? GROUP BY sql LIMIT 1";
        DbParams prms = new DbParams().AddLong(a0).AddLong(b0).Add(shape);
        try {
            DbResult r = await fsql.QueryAsync(sql, prms);
            if (r.RowCount() > 0) {
                outp = new MetricSql();
                outp.day = a0;
                outp.sql = r.GetString(0, 0);
                outp.calls = r.GetLong(0, 1);
                outp.slow = r.GetLong(0, 2);
                outp.totalUs = r.GetLong(0, 3);
                outp.maxUs = r.GetLong(0, 4);
            }
        } finally {
            Give(db);
        }
        return outp;
    }

    /* 聚合历史：按 stepSec 分桶（分钟/小时/天），可按 method/path 过滤。 */
    public static async List<MetricMinute> HistoryBuckets(long from, long to,
                                                    string method, string path,
                                                    long stepSec, int limit) {
        List<MetricMinute> outp = new List<MetricMinute>();
        if (stepSec < 1) { stepSec = 60; }
        string sql = "SELECT minute - (minute % " + Convert.ToString(stepSec)
            + "), SUM(calls), SUM(errors), SUM(total_us), MAX(max_us), "
            + "MAX(p95_us), SUM(frames), SUM(bytes) FROM metrics_minute "
            + "WHERE minute >= ? AND minute <= ?";
        DbParams prms = new DbParams().AddLong(from).AddLong(to);
        if (method.Length > 0) {
            sql = sql + " AND method = ?";
            prms.Add(method);
        }
        if (path.Length > 0) {
            sql = sql + " AND path = ?";
            prms.Add(path);
        }
        sql = sql + " GROUP BY minute - (minute % "
            + Convert.ToString(stepSec) + ") ORDER BY 1 DESC LIMIT "
            + Convert.ToString(limit);
        if (!ready) { return outp; }
        IDbConnection db = await Lease();
        if (db == null) { return outp; }
        IZanSql fsql = ZanSql.FromConnection(db);
        try {
            DbResult r = await fsql.QueryAsync(sql, prms);
            for (int i = 0; i < r.RowCount(); i = i + 1) {
                MetricMinute b = new MetricMinute();
                b.minute = r.GetLong(i, 0);
                b.method = method;
                b.path = path;
                b.calls = r.GetLong(i, 1);
                b.errors = r.GetLong(i, 2);
                b.totalUs = r.GetLong(i, 3);
                b.maxUs = r.GetLong(i, 4);
                b.p95Us = r.GetLong(i, 5);
                b.frames = r.GetLong(i, 6);
                b.bytes = r.GetLong(i, 7);
                outp.Add(b);
            }
        } finally {
            Give(db);
        }
        return outp;
    }

    /* 窗口内按接口聚合，按调用次数排序。 */
    public static async List<MetricMinute> RouteTotals(long from, long to,
                                                string method, string path,
                                                int limit) {
        return await RouteTotalsBy(from, to, method, path, limit,
            "calls");
    }

    /* 按接口聚合，可按调用次数或耗时排序。 */
    public static async List<MetricMinute> RouteTotalsBy(long from, long to,
                                                  string method, string path,
                                                  int limit, string rank) {
        List<MetricMinute> outp = new List<MetricMinute>();
        int firstOrder = 3;
        int secondOrder = 5;
        if (rank == "time") {
            firstOrder = 5;
            secondOrder = 3;
        }
        string sql = "SELECT method, path, SUM(calls), SUM(errors), "
            + "SUM(total_us), MAX(max_us), MAX(p95_us), SUM(frames), "
            + "SUM(bytes) FROM metrics_minute WHERE minute >= ? AND minute <= ?";
        DbParams prms = new DbParams().AddLong(from).AddLong(to);
        if (method.Length > 0) {
            sql = sql + " AND method = ?";
            prms.Add(method);
        }
        if (path.Length > 0) {
            sql = sql + " AND path = ?";
            prms.Add(path);
        }
        sql = sql + " GROUP BY method, path ORDER BY "
            + Convert.ToString(firstOrder) + " DESC, "
            + Convert.ToString(secondOrder) + " DESC LIMIT "
            + Convert.ToString(limit);
        if (!ready) { return outp; }
        IDbConnection db = await Lease();
        if (db == null) { return outp; }
        IZanSql fsql = ZanSql.FromConnection(db);
        try {
            DbResult r = await fsql.QueryAsync(sql, prms);
            for (int i = 0; i < r.RowCount(); i = i + 1) {
                MetricMinute e = new MetricMinute();
                e.minute = 0;
                e.method = r.GetString(i, 0);
                e.path = r.GetString(i, 1);
                e.calls = r.GetLong(i, 2);
                e.errors = r.GetLong(i, 3);
                e.totalUs = r.GetLong(i, 4);
                e.maxUs = r.GetLong(i, 5);
                e.p95Us = r.GetLong(i, 6);
                e.frames = r.GetLong(i, 7);
                e.bytes = r.GetLong(i, 8);
                outp.Add(e);
            }
        } finally {
            Give(db);
        }
        return outp;
    }

    /* 窗口整体汇总（单次聚合行，无数据时各字段为 0）。 */
    public static async MetricMinute WindowTotals(long from, long to, string method,
                                           string path) {
        MetricMinute b = new MetricMinute();
        b.minute = from;
        b.method = method;
        b.path = path;
        if (!ready) { return b; }
        string sql = "SELECT SUM(calls), SUM(errors), SUM(total_us), "
            + "MAX(max_us), SUM(frames), SUM(bytes) FROM metrics_minute "
            + "WHERE minute >= ? AND minute <= ?";
        DbParams prms = new DbParams().AddLong(from).AddLong(to);
        if (method.Length > 0) {
            sql = sql + " AND method = ?";
            prms.Add(method);
        }
        if (path.Length > 0) {
            sql = sql + " AND path = ?";
            prms.Add(path);
        }
        IDbConnection db = await Lease();
        if (db == null) { return b; }
        IZanSql fsql = ZanSql.FromConnection(db);
        try {
            DbResult r = await fsql.QueryAsync(sql, prms);
            if (r.RowCount() > 0) {
                b.calls = r.GetLong(0, 0);
                b.errors = r.GetLong(0, 1);
                b.totalUs = r.GetLong(0, 2);
                b.maxUs = r.GetLong(0, 3);
                b.frames = r.GetLong(0, 4);
                b.bytes = r.GetLong(0, 5);
            }
        } finally {
            Give(db);
        }
        return b;
    }

    /* 查询持久化的错误记录，按时间倒序。 */
    public static async List<MetricError> Errors(long from, long to, int limit) {
        List<MetricError> outp = new List<MetricError>();
        if (!ready) { return outp; }
        IDbConnection db = await Lease();
        if (db == null) { return outp; }
        IZanSql fsql = ZanSql.FromConnection(db);
        try {
            outp = await fsql.Select<MetricError>()
                .Where(a => a.ts >= from && a.ts <= to)
                .OrderByDescending(a => a.id)
                .Limit(limit)
                .ToListAsync();
        } finally {
            Give(db);
        }
        return outp;
    }
}

/* 聚合所有工作进程的实时指标：各 worker 独立发布，读取端合并。 */
