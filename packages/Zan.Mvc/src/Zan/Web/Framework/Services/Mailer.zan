using System;
using System.Net.Sockets;
using System.Net.Tls;
using System.Text;
using System.Web;
using Zan.Web.Core;
using Zan.Web.Security;

namespace Zan.Web.Services;

/* 基于站点配置的 SMTP 邮件客户端，支持 465 直连 TLS 与 587/25 STARTTLS，AUTH LOGIN 认证；失败返回可读信息。 */
public class Mailer {
    /* 邮件服务是否已配置发件主机与发件人。 */
    public static async bool Ready() {
        string host = await Settings.Get(SettingKeys.MailHost, "");
        string from = await From();
        return host.Length > 0 && from.Length > 0;
    }

    public static async string From() {
        string from = await Settings.Get(SettingKeys.MailFrom, "");
        if (from.Length > 0) { return from; }
        return await Settings.Get(SettingKeys.MailUser, "");
    }

    /* 发送纯文本邮件，正文与主题 UTF-8 Base64 编码以保留中文。 */
    public static async MailResult Send(string to, string subject, string body) {
        string host = await Settings.Get(SettingKeys.MailHost, "");
        string from = await From();
        if (host.Length == 0 || from.Length == 0) {
            return MailResult.Fail("邮件服务未配置");
        }
        int port = Convert.ToInt32(await Settings.Get(SettingKeys.MailPort, "465"));
        bool secure = await Settings.On(SettingKeys.MailSsl, true);
        string user = await Settings.Get(SettingKeys.MailUser, "");
        string pass = await Settings.Get(SettingKeys.MailPass, "");
        string fromName = await Settings.Get(SettingKeys.MailFromName, "");

        TcpClient tcp = await TcpClient.ConnectAsync(host, port, 8000);
        if (tcp == null) { return MailResult.Fail("无法连接 " + host + ":" + Convert.ToString(port)); }

        MailSession s = new MailSession();
        s.tcp = tcp;
        /* 465 端口直连 TLS，587/25 端口经 STARTTLS 升级。 */
        bool direct = secure && port == 465;
        if (direct) {
            TlsContext ctx = TlsContext.CreateClient();
            if (ctx == null) { s.Close(); return MailResult.Fail("TLS 初始化失败"); }
            TlsStream stream = await TlsStream.ConnectAsync(ctx, tcp.GetSocket(), host);
            if (stream == null) { s.Close(); return MailResult.Fail("TLS 握手失败"); }
            s.tls = stream;
        }

        MailResult r = await Talk(s, host, from, fromName, user, pass,
            to, subject, body, secure && !direct);
        s.Close();
        return r;
    }

    static async MailResult Talk(MailSession s, string host, string from,
                                 string fromName, string user, string pass,
                                 string to, string subject, string body,
                                 bool startTls) {
        string hello = await s.Read();
        if (!Is(hello, "220")) { return MailResult.Fail(Why(hello, "服务器未就绪")); }

        string ehlo = await s.Say("EHLO zanweb");
        if (!Is(ehlo, "250")) { return MailResult.Fail(Why(ehlo, "EHLO 被拒绝")); }

        if (startTls) {
            string up = await s.Say("STARTTLS");
            if (!Is(up, "220")) { return MailResult.Fail(Why(up, "STARTTLS 被拒绝")); }
            TlsContext ctx = TlsContext.CreateClient();
            if (ctx == null) { return MailResult.Fail("TLS 初始化失败"); }
            TlsStream stream = await TlsStream.ConnectAsync(ctx, s.tcp.GetSocket(), host);
            if (stream == null) { return MailResult.Fail("TLS 握手失败"); }
            s.tls = stream;
            string again = await s.Say("EHLO zanweb");
            if (!Is(again, "250")) { return MailResult.Fail(Why(again, "EHLO 被拒绝")); }
        }

        if (user.Length > 0) {
            string auth = await s.Say("AUTH LOGIN");
            if (!Is(auth, "334")) { return MailResult.Fail(Why(auth, "服务器不支持 AUTH LOGIN")); }
            string u = await s.Say(Encoding.Base64Encode(user));
            if (!Is(u, "334")) { return MailResult.Fail(Why(u, "账号被拒绝")); }
            string p = await s.Say(Encoding.Base64Encode(pass));
            if (!Is(p, "235")) { return MailResult.Fail(Why(p, "认证失败")); }
        }

        string mf = await s.Say("MAIL FROM:<" + from + ">");
        if (!Is(mf, "250")) { return MailResult.Fail(Why(mf, "发件地址被拒绝")); }
        string rc = await s.Say("RCPT TO:<" + to + ">");
        if (!Is(rc, "250") && !Is(rc, "251")) {
            return MailResult.Fail(Why(rc, "收件地址被拒绝"));
        }
        string data = await s.Say("DATA");
        if (!Is(data, "354")) { return MailResult.Fail(Why(data, "服务器拒绝接收正文")); }

        string sender = from;
        if (fromName.Length > 0) {
            sender = "=?UTF-8?B?" + Encoding.Base64Encode(fromName) + "?= <" + from + ">";
        }
        string mail = "From: " + sender + "\r\n"
            + "To: <" + to + ">\r\n"
            + "Subject: =?UTF-8?B?" + Encoding.Base64Encode(subject) + "?=\r\n"
            + "MIME-Version: 1.0\r\n"
            + "Content-Type: text/plain; charset=UTF-8\r\n"
            + "Content-Transfer-Encoding: base64\r\n"
            + "\r\n"
            + Encoding.Base64Encode(body) + "\r\n";
        int _n = await s.Write(mail);
        string done = await s.Say(".");
        if (!Is(done, "250")) { return MailResult.Fail(Why(done, "投递失败")); }
        string _bye = await s.Say("QUIT");
        return MailResult.Good();
    }

    private static bool Is(string reply, string code) {
        return reply.Length >= 3 && reply.Substring(0, 3) == code;
    }

    private static string Why(string reply, string fallback) {
        if (reply.Length == 0) { return fallback; }
        return fallback + "：" + reply;
    }
}
