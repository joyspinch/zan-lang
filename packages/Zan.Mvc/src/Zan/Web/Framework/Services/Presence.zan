using System;
using System.Collections.Generic;
using System.Diagnostics;
using System.Text;
using System.Threading;
using Zan.Web.Core;

namespace Zan.Web.Services;

/* 在线用户统计：各 worker 定期发布页面数与 IP 到共享缓存，读取时汇总去重。 */
public class Presence {
    /* 缓存 TTL，需大于发布间隔以防计数闪烁。 */
    public static const int Ttl = 20;

    /* 轮询 worker 上限。 */
    public static const int MaxWorkers = 32;

    /* 列出 IP 上限，超出时访客数回退为页面数。 */
    public static const int MaxIps = 120;

    private static int pages = 0;
    private static List<string> ips = new List<string>();
    private static nint presenceLock = Mutex.Create();

    /* 记录一个来自 ip 的打开页面。 */
    public static void Enter(string ip) {
        nint lk = Presence.presenceLock;
        if (lk == 0) { return; }
        Mutex.Lock(lk);
        try {
            pages = pages + 1;
            ips.Add(ip);
        } finally {
            Mutex.Unlock(lk);
        }
    }

    /* 移除对应的打开页面。 */
    public static void Leave(string ip) {
        nint lk = Presence.presenceLock;
        if (lk == 0) { return; }
        Mutex.Lock(lk);
        try {
            if (pages > 0) { pages = pages - 1; }
            for (int i = 0; i < ips.Count; i = i + 1) {
                if (ips[i] == ip) {
                    int last = ips.Count - 1;
                    if (i != last) { ips[i] = ips[last]; }
                    ips.RemoveAt(last);
                    return;
                }
            }
        } finally {
            Mutex.Unlock(lk);
        }
    }

    /* 发布本 worker 的页面数与 IP 列表到缓存。 */
    public static async void Publish() {
        int curPages = 0;
        List<string> snapshotIps = null;
        nint lk = Presence.presenceLock;
        if (lk != 0) {
            Mutex.Lock(lk);
            try {
                curPages = pages;
                int n = ips.Count;
                if (n > 0 && n <= MaxIps) {
                    snapshotIps = new List<string>();
                    for (int i = 0; i < n; i = i + 1) {
                        snapshotIps.Add(ips[i]);
                    }
                }
            } finally {
                Mutex.Unlock(lk);
            }
        }

        string body = "";
        if (snapshotIps == null || snapshotIps.Count == 0) {
            body = Convert.ToString(curPages);
        } else {
            StringBuilder sb = new StringBuilder();
            sb.Append(Convert.ToString(curPages));
            for (int i = 0; i < snapshotIps.Count; i = i + 1) {
                sb.Append(",");
                sb.Append(snapshotIps[i]);
            }
            body = sb.ToString();
        }
        await Cache.SetTtlAsync(Key(ProcessHost.WorkerId()), body,
                                Ttl);
    }

    /* 所有 worker 的打开页面总数。 */
    public static async int Pages() {
        int total = 0;
        for (int w = 0; w < MaxWorkers; w = w + 1) {
            string v = await Cache.GetAsync(Key(w));
            if (v.Length == 0) { continue; }
            total = total + Head(v);
        }
        if (total == 0) {
            return Local();
        }
        return total;
    }

    /* 所有 worker 的去重 IP 数，超出列出上限时回退为页面数。 */
    public static async int Visitors() {
        Dictionary<string, bool> seen = new Dictionary<string, bool>();
        int totalPages = 0;
        int unlisted = 0;
        for (int w = 0; w < MaxWorkers; w = w + 1) {
            string v = await Cache.GetAsync(Key(w));
            if (v.Length == 0) { continue; }
            int count = Head(v);
            totalPages = totalPages + count;
            int comma = v.IndexOf(",");
            if (comma < 0) {
                if (count > 0) { unlisted = unlisted + count; }
                continue;
            }
            int pos = comma + 1;
            int vlen = v.Length;
            while (pos < vlen) {
                int next = v.IndexOf(",", pos);
                int end = next >= 0 ? next : vlen;
                if (end > pos) {
                    string ip = v.Substring(pos, end - pos);
                    if (!seen.ContainsKey(ip)) {
                        seen[ip] = true;
                    }
                }
                if (next < 0) { break; }
                pos = next + 1;
            }
        }
        int distinct = seen.Count + unlisted;
        if (totalPages == 0) { return Local(); }
        if (distinct > totalPages) { return totalPages; }
        return distinct;
    }

    public static int Local() {
        nint lk = Presence.presenceLock;
        if (lk == 0) { return pages; }
        Mutex.Lock(lk);
        try {
            return pages;
        } finally {
            Mutex.Unlock(lk);
        }
    }

    public static int Head(string slot) {
        if (slot == null || slot.Length == 0) { return 0; }
        int end = slot.IndexOf(",");
        if (end < 0) { end = slot.Length; }
        if (end == 0) { return 0; }
        int n = 0;
        for (int i = 0; i < end; i = i + 1) {
            int c = slot[i] & 255;
            if (c < 48 || c > 57) { return 0; }
            n = n * 10 + (c - 48);
        }
        return n;
    }

    public static string Key(int worker) {
        return "presence:w" + Convert.ToString(worker);
    }
}
