using System;
using System.Data;
using System.Data.Orm;
using System.Diagnostics;
using System.IO;
using System.Linq;
using Zan.Web.Model;
using Zan.Web.Core;
using Zan.Web;

namespace Zan.Web.Services;

public class JobRunResult {
    public bool claimed;
    public bool ok;
    public string message;

    public JobRunResult(bool claimed, bool ok, string message) {
        this.claimed = claimed;
        this.ok = ok;
        this.message = message;
    }
}

/* 进程内定时任务调度器。每个 worker 都跑同一条循环，到点后以
   「UPDATE sys_job SET last_run_at=now WHERE id=? AND last_run_at=旧值 AND enabled=1」
   的乐观锁抢单——只有一个进程能把行改掉，多 worker 天然不重复执行，
   不依赖主从角色或共享内存。执行体是内置 kind（ping/log.cleanup），
   定义入库、实现内聚在本类；运行历史写 sys_job_log 并按条数修剪。 */
public class JobHost {
    /* 内存镜像只用于到期判断，数据库才是权威；管理页改动经 Touch()
       立即失效本 worker 镜像，其他 worker 最迟 30 秒重读一次。 */
    private static List<SysJob> jobs = new List<SysJob>();
    private static bool dirty = true;
    private static bool armed = false;
    private static int ticks = 0;

    /* 每任务保留的最近运行记录条数。 */
    public static const int KeepLogs = 200;

    /* 管理页增删改后调用：本 worker 下个 tick 重读任务表。 */
    public static void Touch() {
        dirty = true;
    }

    /* main.zan 在 schema 就绪后调用一次；数据库未就绪时循环空转，
       每个 tick 自行重试借连接，服务照常启动。 */
    public static void Arm() {
        if (armed) { return; }
        armed = true;
        Task.Spawn(Loop());
    }

    public static async void Loop() {
        while (true) {
            await Task.Delay(1000);
            await Tick();
        }
    }

    public static async void Tick() {
        ticks = ticks + 1;
        if (dirty || ticks >= 30) {
            ticks = 0;
            dirty = false;
            await Reload();
        }
        long now = WebApp.NowSeconds();
        for (int i = 0; i < jobs.Count; i = i + 1) {
            SysJob j = jobs[i];
            if (j.enabled != 1) { continue; }
            if (now - j.lastRunAt < j.intervalSec) { continue; }
            await FireDue(j.id, now);
        }
    }

    public static async void Reload() {
        IZanSql fsql = AppServices.Current()?.Orm();
        if (fsql == null) { return; }
        try {
            jobs = await fsql.Select<SysJob>()
                .OrderBy(a => a.id).ToListAsync();
        } catch (Exception ex) {
            Log.Error("[jobs] reload failed: " + ex.Message);
        }
    }

    /* 保留原调用签名。抢单基准统一取数据库刚读到的时间。 */
    public static async void Fire(int jobId, long prev, long now) {
        await FireDue(jobId, now);
    }

    private static async void FireDue(int jobId, long now) {
        IZanSql fsql = AppServices.Current()?.Orm();
        if (fsql == null) { return; }
        try {
            SysJob j = await fsql.Select<SysJob>().WherePk(jobId).FirstAsync();
            if (j == null || j.enabled != 1) { return; }
            if (now - j.lastRunAt < j.intervalSec) { return; }
            int claimed = await Claim(fsql, j.id, j.lastRunAt, now, true);
            if (claimed == 0) { return; }
            if (claimed != 1) { throw new Exception("任务抢单结果异常"); }
            RefreshMirror(jobId, now);
            string _m = await Run(fsql, j, now);
        } catch (Exception ex) {
            Log.Error("[jobs] fire failed: " + ex.Message);
        }
    }

    /* 抢单成功后把内存镜像的 lastRunAt 推到本次时间，避免下个 tick
       重复发起注定失败的抢单 UPDATE。 */
    public static void RefreshMirror(int jobId, long now) {
        for (int i = 0; i < jobs.Count; i = i + 1) {
            if (jobs[i].id == jobId) {
                jobs[i].lastRunAt = now;
            }
        }
    }

    public static async string Run(IZanSql fsql, SysJob j, long startedAt) {
        JobRunResult result = await RunClaimed(fsql, j, startedAt);
        return result.message;
    }

    /* 任务体失败仍写入运行历史，调用者据此区分执行失败和抢单失败。 */
    private static async JobRunResult RunClaimed(IZanSql fsql, SysJob j, long startedAt) {
        Stopwatch sw = new Stopwatch();
        sw.Start();
        string message = "";
        bool ok = true;
        try {
            message = await Execute(fsql, j);
        } catch (Exception ex) {
            ok = false;
            message = ex.Message;
            if (message.Length > 200) { message = message.Substring(0, 200); }
        }
        sw.Stop();
        long ms = (long)sw.ElapsedMilliseconds();

        SysJobLog row = new SysJobLog();
        row.jobId = j.id;
        row.jobName = j.name;
        row.startedAt = startedAt;
        row.ms = ms;
        row.ok = ok ? 1 : 0;
        row.message = message;
        await SaveRun(fsql, row);

        /* 修剪历史失败时，本次已经写入的运行结果依然有效。 */
        if ((j.runCount + 1) % 50 == 0) {
            try {
                List<SysJobLog> keep = await fsql.Select<SysJobLog>()
                    .Where(a => a.jobId == j.id)
                    .OrderByDescending(a => a.id)
                    .Take(KeepLogs).ToListAsync();
                if (keep.Count >= KeepLogs) {
                    long minKeep = keep[keep.Count - 1].id;
                    int _d = await fsql.Delete<SysJobLog>()
                        .Where(a => a.jobId == j.id)
                        .Where(a => a.id < minKeep)
                        .ExecuteAffrowsAsync();
                }
            } catch (Exception ex) {
                Log.Warn("[jobs] history cleanup failed: " + ex.Message);
            }
        }
        return new JobRunResult(true, ok, message);
    }

    private static async void SaveRun(IZanSql fsql, SysJobLog row) {
        IUnitOfWork uow = await fsql.CreateUnitOfWorkAsync();
        try {
            int updated = await uow.Update<SysJob>()
                .Set(a => a.lastOk, row.ok)
                .Set(a => a.lastMs, row.ms)
                .Set(a => a.lastMessage, row.message)
                .SetIncr(a => a.runCount, (long)1)
                .WherePk(row.jobId)
                .ExecuteAffrowsAsync();
            if (updated != 1) { throw new Exception("任务运行结果未写入"); }
            int logged = await uow.Insert<SysJobLog>(row).ExecuteAffrowsAsync();
            if (logged != 1) { throw new Exception("任务运行历史未写入"); }
            if (!await uow.CommitAsync()) { throw new Exception("任务运行记录未提交"); }
        } catch (Exception ex) {
            try {
                bool rolledBack = await uow.RollbackAsync();
                if (!rolledBack) { Log.Error("[jobs] run record rollback unconfirmed"); }
            } catch (Exception rollbackError) {
                Log.Error("[jobs] run record rollback failed: " + rollbackError.Message);
            }
            throw;
        } finally {
            uow.Dispose();
        }
    }

    private static async int Claim(IZanSql fsql, int jobId, long previous, long now, bool requireEnabled) {
        if (previous >= now) { return 0; }
        // 抢单条件必须保留在 UPDATE 中，避免 ORM 先查候选、再按主键更新。
        ExprNode stamp = ExprNode.Binary("==", ExprNode.Member("lastRunAt"), ExprNode.Const(previous));
        UpdateQuery<SysJob> claim = fsql.Update<SysJob>()
            .Set(a => a.lastRunAt, now)
            .WherePk(jobId)
            .Where(stamp);
        if (requireEnabled) { claim.WhereEq("enabled", 1); }
        return await claim.ExecuteAffrowsAsync();
    }

    /* 手动执行允许停用任务。抢单必须推进秒级时间戳，同秒不能重复认领。 */
    public static async JobRunResult RunNowResult(IZanSql fsql, SysJob j) {
        long now = WebApp.NowSeconds();
        int claimed = await Claim(fsql, j.id, j.lastRunAt, now, false);
        if (claimed == 0) {
            return new JobRunResult(false, false, "任务状态已变更或刚刚执行，请刷新后重试");
        }
        if (claimed != 1) { throw new Exception("任务抢单结果异常"); }
        RefreshMirror(j.id, now);
        return await RunClaimed(fsql, j, now);
    }

    public static async string RunNow(IZanSql fsql, SysJob j) {
        JobRunResult result = await RunNowResult(fsql, j);
        return result.message;
    }

    public static async string RunNow(IDbConnection db, SysJob j) {
        return await RunNow(ZanSql.FromConnection(db), j);
    }

    /* kind 分发表：新增内置任务在此加一支，并在 Kinds/KindName/
       NormalizeParam 补三处登记。fsql 供任务自行读写业务表。 */
    public static async string Execute(IZanSql fsql, SysJob j) {
        if (j.kind == "ping") {
            return "pong @" + Convert.ToString(WebApp.NowSeconds());
        }
        if (j.kind == "log.cleanup") {
            return CleanupLogs(j);
        }
        throw new Exception("未知任务类型 " + j.kind);
    }

    /* 兼容老重载 */
    public static async string Execute(IDbConnection db, SysJob j) {
        return await Execute(ZanSql.FromConnection(db), j);
    }

    /* 删除日志目录里超过保留天数的 .log 文件（按修改时间）。 */
    public static string CleanupLogs(SysJob j) {
        int days = Filter.ToInt(j.param, 30);
        if (days < 1) { days = 1; }
        if (days > 365) { days = 365; }
        string dir = Cfg.Log.dir;
        if (dir.Length == 0 || !Directory.Exists(dir)) {
            return "日志目录不存在，无事可做";
        }
        long cutoff = WebApp.NowSeconds() - (long)days * 86400;
        List<string> files = DirectoryTree.Files(dir, PathFilter.Only(".log"));
        int removed = 0;
        for (int i = 0; i < files.Count; i = i + 1) {
            if (FileInfo.GetLastWriteTime(files[i]) < cutoff) {
                File.Delete(files[i]);
                if (File.Exists(files[i])) { throw new IOException("无法删除日志文件 " + files[i]); }
                removed = removed + 1;
            }
        }
        return "删除 " + Convert.ToString(removed) + " 个超过 "
            + Convert.ToString(days) + " 天的日志文件";
    }

    /* 表单可选择的内置任务类型。 */
    public static List<string> Kinds() {
        List<string> outp = new List<string>();
        outp.Add("ping");
        outp.Add("log.cleanup");
        return outp;
    }

    /* kind 是否受支持。 */
    public static bool Known(string kind) {
        List<string> all = Kinds();
        for (int i = 0; i < all.Count; i = i + 1) {
            if (all[i] == kind) { return true; }
        }
        return false;
    }

    /* 列表与表单显示用名称。 */
    public static string KindName(string kind) {
        if (kind == "ping") { return "存活心跳"; }
        if (kind == "log.cleanup") { return "日志清理"; }
        return kind;
    }

    /* param 的按类归一：不合法回落默认值。 */
    public static string NormalizeParam(string kind, string param) {
        if (kind == "log.cleanup") {
            int days = Filter.ToInt(param, 30);
            if (days < 1) { days = 1; }
            if (days > 365) { days = 365; }
            return Convert.ToString(days);
        }
        return "";
    }

    /* 间隔的人读文本。 */
    public static string IntervalText(int sec) {
        if (sec % 86400 == 0) {
            return "每 " + Convert.ToString(sec / 86400) + " 天";
        }
        if (sec % 3600 == 0) {
            return "每 " + Convert.ToString(sec / 3600) + " 小时";
        }
        if (sec % 60 == 0) {
            return "每 " + Convert.ToString(sec / 60) + " 分钟";
        }
        return "每 " + Convert.ToString(sec) + " 秒";
    }
}
