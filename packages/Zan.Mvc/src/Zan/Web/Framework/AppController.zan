using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using System.Json;
using Zan.Web.Core;
using Zan.Web.Dao;
using Zan.Web.Model;
using Zan.Web.Services;

namespace Zan.Web;

/* 注入数据库与缓存访问的控制器基类。依赖在 main.zan 装配并经 AppServices.Use(...) 安装，动作通过 this.Conn()/this.Cache() 访问。连接按请求作用域：Conn() 首次调用时从连接池借出，同请求后续调用复用同一连接，OnAfter() 在动作返回时归还——故业务代码与 DAO 不含 Acquire/Release；按请求(非按查询)持一连接也使事务成为可能，事务内每条语句须在同一连接上执行。BEGIN/COMMIT/ROLLBACK 同其他语句一样需 await。子类清理覆盖 OnDone() 而非 OnAfterAsync()，以确保连接总是被释放。 */
public abstract class AppController : Controller {
    /* 请求惰性连接：首条语句才向池借出（见 RequestDbConnection）。 */
    RequestDbConnection lease;
    /* 租约已弃用或请求已收尾：Held() 与表访问器连接答 null，显式 Conn() 可重开。 */
    bool leaseClosed;
    IDbConnection readLease;
    bool inTx;
    bool commitFailed;
    bool readOnlyIntent;

    override public void UseReadOnly() { this.readOnlyIntent = true; }

    /* 注入的数据库上下文（AppServices.Use 前为 null）。私有：控制器经
     * Conn()/Held()/ReadConn() 拿请求连接，不直接触碰借还协议。 */
    private DbContext Db() {
        AppServices s = AppServices.Current();
        if (s == null) { return null; }
        return s.Db();
    }

    /* 注入的 ZanSql 统一门面。 */
    protected IZanSql Orm() {
        AppServices s = AppServices.Current();
        if (s == null) {
            throw new InvalidOperationException("AppServices not initialized");
        }
        return s.Orm();
    }

    /* 注入的缓存上下文（AppServices.Use 前为 null）。 */
    protected CacheContext Cache() {
        AppServices s = AppServices.Current();
        if (s == null) {
            throw new InvalidOperationException("AppServices not initialized");
        }
        return s.Cache();
    }

    /* 本请求的惰性连接代理；数据库未配置或租约已关闭时为 null。
       只建代理不借连接——借出发生在首条语句。 */
    private RequestDbConnection Lease() {
        if (this.lease != null) { return this.lease; }
        if (this.leaseClosed) { return null; }
        DbContext ctx = this.Db();
        if (ctx == null) { return null; }
        this.lease = new RequestDbConnection(ctx, this.readOnlyIntent);
        return this.lease;
    }

    /* 本次请求的连接：立即借出（已借出则复用），动作返回自动释放。null 表示数据库不可用——处理器应答 503 而非假设结果集为空。 */
    protected async IDbConnection Conn() {
        this.leaseClosed = false;
        RequestDbConnection l = this.Lease();
        if (l == null) { return null; }
        if (!await l.Open()) { return null; }
        return l;
    }

    /* 本次请求的连接（惰性：首条语句才真正借出），不 await。
       数据库未配置时为 null。 */
    public IDbConnection Held() {
        return this.Lease();
    }

    /* 一个请求只持一条连接：已有租约（含 [ReadOnly] 的只读租约）时复用；
       事务中强制主库；否则借只读池一次。读后写一致性由不标注
       [ReadOnly] 保证。 */
    protected async IDbConnection ReadConn() {
        if (this.readOnlyIntent || (this.lease != null && this.lease.IsOpen())) {
            return await this.Conn();
        }
        if (this.inTx) { return await this.Conn(); }
        if (this.readLease != null) { return this.readLease; }
        DbContext ctx = this.Db();
        if (ctx == null) { return null; }
        this.readLease = await ctx.AcquireRead();
        return this.readLease;
    }

    /* 本次请求已借出的只读连接（未借出则回退到请求连接）。*/
    protected IDbConnection HeldRead() {
        if (this.lease != null && this.lease.IsOpen()) { return this.lease; }
        if (this.readLease != null) { return this.readLease; }
        return this.Held();
    }

    /* 表访问器运行其上的连接：this.SysUser、this.Post 编译为在此连接上的类型化查询。访问器是普通成员无法 await，故这里给的是惰性代理，首条（异步）语句才借出。不构造 DAO、不借还、字段名在编译期校验。
     * 复杂实体方法也由编译器使用同一请求连接派发，业务调用处不构造 DAO 或传递控制器。 */
    public IDbConnection __Conn() {
        return this.Lease();
    }

    /* 动作运行前不再预借连接：不碰库的动作（缓存命中、纯模板页、健康
       探针）不占池位，碰库的动作在首条语句借出、动作返回归还。 */
    override public async bool OnBeforeAsync() {
        return this.OnBefore();
    }

    /* 本次请求是否有可用数据库。已借出 → true；借用失败过 → false；
       否则不挂起地取一条空闲连接；池正忙（全部借出但连接存活）也算
       可用，随后的异步语句排队等池。需要确证可达（健康探针）用
       await DbOpen()。 */
    protected bool DbReady() {
        RequestDbConnection l = this.Lease();
        if (l == null) { return false; }
        if (l.IsOpen()) { return true; }
        if (l.Failed()) { return false; }
        return l.OpenNow();
    }

    /* 确证本请求能借到连接（会真正借出）；false 表示数据库不可用。 */
    protected async bool DbOpen() {
        return await this.Conn() != null;
    }

    /* 弃用未知事务状态的主库租约，清理异常不能覆盖原事务失败。
       先清请求字段，确保之后的收尾不会再次归还或操作此连接。 */
    private void DiscardLease() {
        RequestDbConnection l = this.lease;
        this.lease = null;
        this.leaseClosed = true;
        this.inTx = false;
        if (l == null) { return; }
        IDbConnection db = l.Detach();
        if (db == null) { return; }
        try {
            DbContext ctx = this.Db();
            if (ctx != null) { ctx.Discard(db); }
            else { db.Close(); }
        } catch (Exception _cleanupError) {
            // 租约丢弃时的底层物理连接关闭或释放异常已无恢复价值，抑制异常避免覆盖主业务异常
        }
    }

    /* false 表示未确认事务开启；BEGIN 失败的连接状态不明，必须弃用。 */
    protected async bool Begin() {
        if (this.readOnlyIntent) { return false; }
        IDbConnection db = await this.Conn();
        if (db == null) { return false; }
        if (this.inTx) { return true; }
        bool begun = false;
        try { begun = await db.BeginTransactionAsync(); }
        catch (Exception beginError) {
            this.DiscardLease();
            throw beginError;
        }
        if (!begun) {
            this.DiscardLease();
            return false;
        }
        this.inTx = true;
        return true;
    }

    /* 提交失败（包括 false）保留 inTx，供失败路径回滚。 */
    protected async void Commit() {
        if (!this.inTx) { return; }
        try {
            if (!await this.lease.CommitAsync()) {
                throw new Exception("commit failed");
            }
        } catch (Exception commitError) {
            this.commitFailed = true;
            throw;
        }
        this.inTx = false;
    }

    /* 回滚失败即弃用状态不明的连接，收尾不得重试并覆盖原提交异常。 */
    protected async void Rollback() {
        if (!this.inTx) { return; }
        try {
            if (!await this.lease.RollbackAsync()) {
                throw new Exception("rollback failed");
            }
        } catch (Exception rollbackError) {
            this.DiscardLease();
            throw;
        }
        this.inTx = false;
    }

    /* [Tx] 蹦床钩子：声明属性即完成事务，动作体内不再出现 Begin/Commit/Rollback 阶梯。 */

    /* 打开本次请求事务（租约+BEGIN）；false 表示数据库不可用，蹦床答 503。 */
    override public async bool TxBegin() { return await this.Begin(); }

    /* 动作成功后提交；无事务时 no-op。 */
    override public async void TxCommit() { await this.Commit(); }

    /* 任何失败路径回滚；可重复调用、可在提交后调用。 */
    override public async void TxRollback() { await this.Rollback(); }

    /* 未完成事务先回滚；失败时先摘除池租约，再尝试关闭脏连接。
       各清理步骤都必须执行，后续清理异常不能覆盖最初的失败。 */
    override public async void OnAfterAsync() {
        Exception failure = null;
        if (this.lease != null && this.inTx) {
            try { await this.Rollback(); }
            catch (Exception rollbackError) {
                failure = rollbackError;
                this.DiscardLease();
            }
        }
        try {
            if (this.lease != null) {
                IDbConnection db = this.lease.Detach();
                DbContext ctx = this.Db();
                if (db != null && ctx != null) {
                    if (this.lease.IsRead()) { ctx.ReleaseRead(db); }
                    else { ctx.Release(db); }
                }
            }
        } catch (Exception releaseError) {
            if (failure == null) { failure = releaseError; }
        } finally {
            this.lease = null;
            this.leaseClosed = true;
            this.inTx = false;
        }
        try {
            if (this.readLease != null) {
                DbContext ctx = this.Db();
                if (ctx != null) { ctx.ReleaseRead(this.readLease); }
            }
        } catch (Exception readError) {
            if (failure == null) { failure = readError; }
        } finally {
            this.readLease = null;
        }
        try { this.OnDone(); }
        catch (Exception doneError) {
            if (failure == null) { failure = doneError; }
        }
        if (failure != null && !this.commitFailed) { throw failure; }
    }

    /* 供子类做每请求清理；覆盖此而非 OnAfterAsync()，后者负责释放连接。 */
    virtual void OnDone() { }

    /* ---- 取参（JSON 体回退） ----------------------------------------
       自研管理壳用表单编码提交，adminUI 系前端（axios）用 JSON 提交。
       route/query/form 未命中时读 application/json 正文顶层字段，两类
       客户端共用同一控制器动作；标量值转文本（数字按 token 原文、布
       尔 true/false）。表单编码路径零行为变化。 */

    /* 公开：ListPage/FormPage/CrudScreenController 等协作类经控制器实例取参，
       与 stdlib In/InInt 同一可见性。基于高性能零分配 JsonDoc Flat Tape 结构，
       完全消除读 JSON 请求体创建整棵 DOM 树的开销。 */
    public string InAny(string name) {
        string v = this.In(name);
        if (v.Length > 0) { return v; }
        JsonDoc doc = this.Ctx().JsonDoc();
        if (doc == null) { return ""; }
        int slot = doc.Get(doc.root, name);
        if (slot < 0) { return ""; }
        return doc.StrAt(slot, "");
    }

    public int InAnyInt(string name) {
        string v = this.In(name);
        if (v.Length > 0) { return HttpContext.ParseIntStrict(v, 0); }
        JsonDoc doc = this.Ctx().JsonDoc();
        if (doc == null) { return 0; }
        int slot = doc.Get(doc.root, name);
        if (slot < 0) { return 0; }
        return doc.IntAt(slot, 0);
    }

    public SysUserDao SysUser { get { return new SysUserDao(this.Held()); } }
    public SysLoginLogDao SysLoginLog { get { return new SysLoginLogDao(this.Held()); } }
}
