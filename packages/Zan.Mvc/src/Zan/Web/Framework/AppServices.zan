using System;
using System.Data.Orm;
using Zan.Web.Core;
using Zan.Web.Services;

namespace Zan.Web;

/* 应用服务根：Db、Cache 和 ZanSql ORM 由 main.zan 一次性装配并通过构造注入（依赖注入，无惰性静态发现）。单例通过 Use() 安装，通过 Current() 读取。*/
public class AppServices {
    static AppServices current;

    DbContext db;
    CacheContext cache;
    IZanSql zsql;

    public AppServices(DbContext db, CacheContext cache) {
        this.db = db;
        this.cache = cache;
        if (db != null && db.Pool() != null) {
            this.zsql = ZanSql.FromPool(db.Pool());
        } else {
            this.zsql = null;
        }
    }

    public AppServices(DbContext db, CacheContext cache, IZanSql zsql) {
        this.db = db;
        this.cache = cache;
        this.zsql = zsql;
    }

    public static void Use(AppServices services) {
        current = services;
        if (services != null && services.Orm() != null) {
            ZanSql.SetDefault(services.Orm());
            ZanSql.SetProvider(delegate() {
                AppServices s = AppServices.Current();
                if (s == null) { return null; }
                return s.Orm();
            });
        }
    }

    public static AppServices Current() {
        return current;
    }

    public DbContext Db() {
        return this.db;
    }

    public CacheContext Cache() {
        return this.cache;
    }

    public IZanSql Orm() {
        return this.zsql;
    }
}
