using System;
using System.Data;
using System.Data.Orm;
using System.Diagnostics;
using System.Net;
using System.Threading;
using System.Web;
using Zan.Web.Model;
using Zan.Web.Core;

namespace Zan.Web.Security;

/* 每服务实例的授权表。master 建匿名共享内存，worker 继承同一映射。 */
public class PermTable {
    public static const string ShareRoles = "WEB_PERM_ROLES";
    public static const string ShareUsers = "WEB_PERM_USERS";
    public static const long UserLeaseMs = 300000;

    private static const string State = "#state";
    private static const string RoleWriter = "#role-writer";
    private static const long ReloadLeaseMs = 30000;
    private static const int RetryDelayMs = 2000;
    private static const int UserBuckets = 64;
    private static SharedTable roles = null;
    private static SharedTable users = null;

    public static bool Open() {
        if (Ready()) { return true; }
        long roleHandle = Worker.InheritedHandle(ShareRoles);
        long userHandle = Worker.InheritedHandle(ShareUsers);
        if (roleHandle != 0 || userHandle != 0 || ProcessHost.IsWorker()) {
            if (roleHandle == 0 || userHandle == 0) { return false; }
            SharedTable r = SharedTable.Attach(roleHandle);
            SharedTable u = SharedTable.Attach(userHandle);
            if (!r.IsOpen() || !u.IsOpen()) {
                r.Close();
                u.Close();
                return false;
            }
            r.Label("web perm roles");
            u.Label("web perm users");
            roles = r;
            users = u;
            return true;
        }

        SharedTable nr = new SharedTable("", 256);
        nr.KeySize(16);
        nr.ColumnString("acts", 8216);
        nr.ColumnString("policy", 288);
        if (!nr.CreateAnonymous()) { return false; }
        nr.Label("web perm roles");

        SharedTable nu = new SharedTable("", 8192);
        nu.KeySize(24);
        nu.ColumnInt("owner");
        nu.ColumnInt("userVersion");
        nu.ColumnInt("roleVersion");
        nu.ColumnInt("publishedRoles");
        nu.ColumnInt("clusterOffline");
        nu.ColumnString("roles", 216);
        nu.ColumnString("scope", 1056);
        if (!nu.CreateAnonymous() || !nu.SetInt(State, "userVersion", 1)) {
            nr.Close();
            nu.Close();
            return false;
        }
        for (int i = 0; i < UserBuckets; i = i + 1) {
            if (nu.SetInt(UserBucket(i), "userVersion", 0)) { continue; }
            nr.Close();
            nu.Close();
            return false;
        }
        nu.Label("web perm users");

        Worker.ShareHandle(ShareRoles, nr.OsHandle());
        Worker.ShareHandle(ShareUsers, nu.OsHandle());
        roles = nr;
        users = nu;
        return true;
    }

    public static bool Ready() {
        return roles != null && users != null;
    }

    /* 在查库前登记版本。较晚的失效立即撤下当前版本，并使在途回填作废。 */
    internal static long BeginRoleReload() {
        if (!Ready()) { return 0; }
        long version = users.Increment(State, "roleVersion", 1);
        ForgetAll();
        return version;
    }

    public static async void LoadRoles(IZanSql fsql) {
        long version = BeginRoleReload();
        bool _loaded = await ReloadRoles(fsql, version);
    }

    /* 首次尝试可复用请求连接，失败后只用独立的 ORM 借还连接。 */
    internal static async void LoadRolesWithRetry(IZanSql fsql, IZanSql retryOrm) {
        long version = BeginRoleReload();
        try {
            if (await ReloadRoles(fsql, version)) { return; }
        } finally {
            if (retryOrm != null && RoleReloadPending(version)) {
                Task.Spawn(RetryRoleReload(retryOrm, version));
            }
        }
    }

    private static async void RetryRoleReload(IZanSql fsql, long version) {
        while (RoleReloadPending(version)) {
            await Task.Delay(RetryDelayMs);
            if (!RoleReloadPending(version)) { return; }
            try {
                if (await ReloadRoles(fsql, version)) { return; }
            } catch (Exception ex) {
                Log.Warn("[rbac] role reload failed: " + ex.Message);
            }
        }
    }

    internal static async bool ReloadRoles(IZanSql fsql, long version) {
        if (!Loading(version) || fsql == null) { return false; }
        List<SysRole> rows = await fsql.Select<SysRole>().ToListAsync();
        List<SysRoleGrant> grants = await fsql.Select<SysRoleGrant>().OrderBy(a => a.id).ToListAsync();
        return await PublishRoles(version, rows, grants);
    }

    internal static async bool RolesChangedSince(IZanSql fsql, long version) {
        if (version == 0) { return true; }
        List<SysRole> rows = await fsql.Select<SysRole>().ToListAsync();
        List<SysRoleGrant> grants = await fsql.Select<SysRoleGrant>().OrderBy(a => a.id).ToListAsync();
        if (RoleVersion() != version) { return false; }
        int active = 0;
        string tag = VersionTag(version);
        for (int i = 0; i < rows.Count; i = i + 1) {
            SysRole row = rows[i];
            if (row.status != 1) { continue; }
            active = active + 1;
            string key = Convert.ToString(row.id);
            if (roles.GetString(key, "acts") != RoleActions(row.id, grants, tag)
                || RolePolicy(key, version) != EncodePolicy(row)) { return RoleVersion() == version; }
        }
        return roles.Count() != active && RoleVersion() == version;
    }

    public static async void LoadRoles(IDbConnection db) {
        await LoadRoles(ZanSql.FromConnection(db));
    }

    public static async void LoadRoles(List<SysRole> rows, List<SysRoleGrant> grants) {
        bool _loaded = await PublishRoles(BeginRoleReload(), rows, grants);
    }

    internal static bool RoleReloadPending(long version) {
        return Loading(version) && users.GetInt(State, "publishedRoles") != version;
    }

    private static bool Loading(long version) {
        return Ready() && version > 0 && users.GetInt(State, "roleVersion") == version;
    }

    private static async bool PublishRoles(long version, List<SysRole> rows, List<SysRoleGrant> grants) {
        if (rows == null || grants == null) { return false; }
        while (Loading(version)) {
            if (users.TryAcquireLease(RoleWriter, version, -1, ReloadLeaseMs)) {
                try {
                    return WriteRoles(version, rows, grants);
                } finally {
                    bool _released = users.ReleaseLease(RoleWriter, version);
                }
            }
            await Task.Delay(10);
        }
        return false;
    }

    private static bool WriteRoles(long version, List<SysRole> rows, List<SysRoleGrant> grants) {
        if (!Loading(version)) { return false; }
        if (!RoleReloadPending(version)) { return Loading(version); }
        roles.Clear();
        string tag = VersionTag(version);
        for (int i = 0; i < rows.Count; i = i + 1) {
            SysRole row = rows[i];
            if (row.status != 1) { continue; }
            string acts = RoleActions(row.id, grants, tag);
            if (!Loading(version)) { return false; }
            string key = Convert.ToString(row.id);
            if (!roles.SetString(key, "acts", acts)
                || !roles.SetString(key, "policy", tag + EncodePolicy(row))) {
                Log.Warn("[rbac] role snapshot exceeds shared table capacity");
                return false;
            }
        }
        /* 角色行中的版本还会保护读者免受过期写租约的迟到写入影响。 */
        if (!Loading(version)) { return false; }
        bool published = users.SetInt(State, "publishedRoles", version);
        return published && Loading(version);
    }

    private static string RoleActions(int roleId, List<SysRoleGrant> grants, string tag) {
        StringBuilder acts = new StringBuilder();
        acts.Append(tag + ",");
        for (int i = 0; i < grants.Count; i = i + 1) {
            SysRoleGrant grant = grants[i];
            if (grant.roleId != roleId || grant.action == null || grant.action.Length == 0) { continue; }
            Perm.Append(acts, grant.action, grant.mask);
        }
        return acts.ToString();
    }

    private static string EncodePolicy(SysRole role) {
        string depts = role.scopeDepts == null ? "" : role.scopeDepts;
        return Convert.ToString(role.dataScope) + ":" + depts;
    }

    internal static long RoleVersion() {
        if (UserVersion() == 0) { return 0; }
        long version = users.GetInt(State, "publishedRoles");
        return Loading(version) ? version : 0;
    }

    internal static void SetClusterOnline(bool online) {
        if (!Ready()) { return; }
        if (!online) {
            bool _offline = users.SetInt(State, "clusterOffline", 1);
            long _version = BeginRoleReload();
        } else {
            bool _online = users.SetInt(State, "clusterOffline", 0);
        }
    }

    private static string VersionTag(long version) {
        return Convert.ToString(version) + ":";
    }

    private static string AtVersion(string value, long version) {
        if (version <= 0) { return ""; }
        string tag = VersionTag(version);
        return value.IndexOf(tag) == 0 ? value.Substring(tag.Length) : "";
    }

    internal static string RolePolicy(string roleId, long version) {
        if (version == 0 || RoleVersion() != version) { return ""; }
        return AtVersion(roles.GetString(roleId, "policy"), version);
    }

    public static int RoleScope(string roleId) {
        long version = RoleVersion();
        string policy = RolePolicy(roleId, version);
        int sep = policy.IndexOf(":");
        return sep > 0 && RoleVersion() == version ? Filter.ToInt(policy.Substring(0, sep), 0) : 0;
    }

    public static string RoleDepts(string roleId) {
        long version = RoleVersion();
        string policy = RolePolicy(roleId, version);
        int sep = policy.IndexOf(":");
        return sep > 0 && RoleVersion() == version ? policy.Substring(sep + 1) : "";
    }

    public static bool RolesAllow(string roleIds, string action) {
        int bit = Perm.BitOf(action);
        if (bit == 0) { return false; }
        return (RolesMask(roleIds, Perm.ScreenOf(action)) & bit) != 0;
    }

    public static int RolesMask(string roleIds, string screen) {
        long version = RoleVersion();
        if (version == 0 || screen.Length == 0) { return 0; }
        int mask = 0;
        List<string> ids = Split(roleIds);
        for (int i = 0; i < ids.Count; i = i + 1) {
            string acts = AtVersion(roles.GetString(ids[i], "acts"), version);
            if (acts.Length == 0) { continue; }
            mask = mask | Perm.MaskIn(acts, screen);
        }
        return RoleVersion() == version ? mask : 0;
    }

    private static string UserBucket(int bucket) {
        return "#user:" + Convert.ToString(bucket);
    }

    internal static long UserVersion() {
        if (!Ready() || users.GetInt(State, "clusterOffline") != 0) { return 0; }
        return users.GetInt(State, "userVersion");
    }

    /* 固定的共享分组保留版本，避免账号缓存过期后重用版本。全局与分组计数只增不减。 */
    internal static long UserVersion(string uid) {
        long version = UserVersion();
        int id = AuthUser.ToInt(uid);
        if (version == 0 || id <= 0) { return 0; }
        return version + users.GetInt(UserBucket(id % UserBuckets), "userVersion");
    }

    public static string UserRoles(string uid) {
        long version = UserVersion(uid);
        if (version == 0) { return ""; }
        string hit = AtVersion(users.GetString(uid, "roles"), version);
        return UserVersion(uid) == version ? hit : "";
    }

    public static int UserScope(string uid) {
        string cached = UserScopeEntry(uid, UserVersion(uid), RoleVersion());
        int sep = cached.IndexOf(":");
        return sep > 0 ? Filter.ToInt(cached.Substring(0, sep), 0) : 0;
    }

    public static string UserDepts(string uid) {
        string cached = UserScopeEntry(uid, UserVersion(uid), RoleVersion());
        int sep = cached.IndexOf(":");
        return sep > 0 ? cached.Substring(sep + 1) : "";
    }

    internal static string UserScopeEntry(string uid, long userVersion, long roleVersion) {
        if (userVersion == 0 || roleVersion == 0 || UserVersion(uid) != userVersion
            || RoleVersion() != roleVersion) { return ""; }
        string cached = AtVersion(AtVersion(users.GetString(uid, "scope"), userVersion), roleVersion);
        return UserVersion(uid) == userVersion && RoleVersion() == roleVersion ? cached : "";
    }

    public static void SetUserScope(string uid, int mode, string depts) {
        SetUserScope(uid, mode, depts, UserVersion(uid), RoleVersion());
    }

    internal static void SetUserScope(string uid, int mode, string depts, long userVersion, long roleVersion) {
        if (userVersion == 0 || roleVersion == 0 || UserVersion(uid) != userVersion
            || RoleVersion() != roleVersion) { return; }
        string value = VersionTag(userVersion) + Convert.ToString(roleVersion) + ":"
            + Convert.ToString(mode) + ":" + depts;
        if (users.SetString(uid, "scope", value)) {
            bool _expires = users.Expire(uid, UserLeaseMs);
        }
    }

    public static void SetUser(string uid, bool isSuper, string roleIds) {
        bool _current = SetUserIfCurrent(uid, isSuper, roleIds, UserVersion(uid));
    }

    internal static bool SetUserIfCurrent(string uid, bool isSuper, string roleIds, long version) {
        if (version == 0 || UserVersion(uid) != version) { return false; }
        if (users.SetString(uid, "roles", VersionTag(version) + (isSuper ? "*" : roleIds))) {
            bool _expires = users.Expire(uid, UserLeaseMs);
        }
        return UserVersion(uid) == version;
    }

    public static void Forget(string uid) {
        int id = AuthUser.ToInt(uid);
        if (!Ready() || id <= 0) { return; }
        long _version = users.Increment(UserBucket(id % UserBuckets), "userVersion", 1);
    }

    public static void ForgetAll() {
        if (!Ready()) { return; }
        long _version = users.Increment(State, "userVersion", 1);
    }

    public static List<string> Split(string joined) {
        List<string> outp = new List<string>();
        if (joined == null || joined.Length == 0) { return outp; }
        int start = 0;
        int len = joined.Length;
        for (int i = 0; i < len; i = i + 1) {
            if ((joined[i] & 255) == 44) {
                if (i > start) { outp.Add(joined.Substring(start, i - start)); }
                start = i + 1;
            }
        }
        if (len > start) { outp.Add(joined.Substring(start, len - start)); }
        return outp;
    }
}
