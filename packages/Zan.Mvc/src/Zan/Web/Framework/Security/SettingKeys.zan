using System;

namespace Zan.Web.Security;

/* sys_setting 表的键名集中定义，防止拼写错误导致静默回退默认值。*/
public class SettingKeys {
    public static const string SiteTitle = "site.title";
    public static const string SiteSubtitle = "site.subtitle";
    public static const string SiteDescription = "site.description";
    public static const string SiteKeywords = "site.keywords";
    public static const string SiteCopyright = "site.copyright";
    public static const string SiteIcp = "site.icp";
    public static const string SitePolice = "site.police";
    public static const string SiteAnalytics = "site.analytics";
    public static const string SiteTimezone = "site.timezone";
    public static const string SiteLanguage = "site.language";
    public static const string SiteUrl = "site.url";

    public static const string RegisterEnabled = "auth.register.enabled";
    public static const string RegisterVerify = "auth.register.verify";
    public static const string ResetEnabled = "auth.reset.enabled";

    public static const string CommentEnabled = "blog.comment.enabled";
    public static const string CommentReview = "blog.comment.review";

    public static const string MailHost = "mail.host";
    public static const string MailPort = "mail.port";
    public static const string MailSsl = "mail.ssl";
    public static const string MailUser = "mail.user";
    public static const string MailPass = "mail.pass";
    public static const string MailFrom = "mail.from";
    public static const string MailFromName = "mail.fromName";

    public static const string AiEnabled = "ai.enabled";
    public static const string AiBaseUrl = "ai.baseUrl";
    public static const string AiApiKey = "ai.apiKey";
    public static const string AiModel = "ai.model";
    public static const string AiTemperature = "ai.temperature";

    public static const string GenRoot = "gen.root";
}

/* 应用内部路径与路由 action 命名常量。没有 Admin 常量：登录落地页不是
   固定 URL，而是该账号可到达的第一个菜单项（MenuBuilder.LandingFor）。*/
