using System;
using System.Collections.Generic;
using System.Data;
using Zan.Web.Model;
using Zan.Web.Core;
using Zan.Web.Dao;

namespace Zan.Web.Security;

/* 请求可访问表的哪些行。权限检查回答"能否进入"，数据范围回答"进入后看哪些行"。角色携带 dataScope（1 全部 / 2 本部门 / 3 本部门及下级 / 4 仅本人 / 5 自定义部门）。多角色 union，不排名：只要有一个角色指定部门即贡献；全部角色均"仅本人"才归入 Self。坍缩为三种形态：All / ByDepts / Self。解析一次写入与角色行相同的共享内存，部门树已展平。不可解析账号返回 ByDept over 部门 -1（不匹配任何行，防泄漏）。*/
public class DataScope {
    public static const int RoleAll = 1;
    public static const int RoleDept = 2;
    public static const int RoleDeptTree = 3;
    public static const int RoleSelf = 4;
    public static const int RoleCustom = 5;

    public static const int All = 1;
    public static const int ByDepts = 2;
    public static const int Self = 4;

    private int mode;
    private int userId;
    private bool superUser;
    private List<int> depts;
    private StrMap tags;

    public DataScope() {
        this.mode = ByDepts;
        this.userId = 0;
        this.superUser = false;
        this.depts = new List<int>();
        this.tags = null;
    }

    public bool Any() { return this.mode == All; }

    public bool IsSuper() { return this.superUser; }

    public void SetSuper(bool value) { this.superUser = value; }

    public bool ByDept() { return this.mode == ByDepts; }

    public bool Mine() { return this.mode == Self; }

    public List<int> Depts() { return this.depts; }

    public int UserId() { return this.userId; }

    /* 可扩展上下文标签（如 tenantId / orgKey / companyId 等，供业务/多租户扩展钩子读写）。 */
    public void SetTag(string key, string value) {
        if (key == null || key.Length == 0) { return; }
        if (this.tags == null) { this.tags = new StrMap(); }
        this.tags.Set(key, value == null ? "" : value);
    }

    public void ApplyTags(Dictionary<string, string> claims) {
        if (claims == null || claims.Count == 0) { return; }
        List<string> keys = claims.Keys;
        for (int i = 0; i < keys.Count; i = i + 1) {
            string k = keys[i];
            string v = "";
            claims.TryGetValue(k, out v);
            this.SetTag(k, v);
        }
    }

    public string Tag(string key) {
        if (this.tags == null || key == null || key.Length == 0) { return ""; }
        return this.tags.Get(key);
    }

    public bool HasTag(string key) {
        return this.tags != null && key != null && key.Length > 0 && this.tags.Has(key);
    }

    /* 将当前数据范围收窄到指定部门集合（All → ByDepts；ByDepts → 求交集；空集 → fail-closed）。 */
    public void NarrowToDepts(List<int> allowedDepts) {
        if (this.mode == Self) { return; }
        if (allowedDepts == null || allowedDepts.Count == 0) {
            this.NarrowToNone();
            return;
        }
        List<int> next = new List<int>();
        if (this.mode == All) {
            for (int i = 0; i < allowedDepts.Count; i = i + 1) {
                Add(next, allowedDepts[i]);
            }
        } else {
            for (int i = 0; i < this.depts.Count; i = i + 1) {
                int id = this.depts[i];
                if (id > 0 && Has(allowedDepts, id)) {
                    Add(next, id);
                }
            }
        }
        if (next.Count == 0) {
            this.NarrowToNone();
            return;
        }
        this.mode = ByDepts;
        this.depts = next;
    }

    public void NarrowToSelf() {
        this.mode = Self;
        this.depts = new List<int>();
    }

    public void NarrowToNone() {
        this.mode = ByDepts;
        this.depts = new List<int>();
        this.depts.Add(0 - 1);
    }

    public bool Covers(int rowUserId, int rowDepartmentId) {
        if (this.Any()) { return true; }
        if (this.Mine()) { return rowUserId > 0 && rowUserId == this.userId; }
        return Has(this.depts, rowDepartmentId);
    }

    public static DataScope None() {
        DataScope sc = new DataScope();
        sc.mode = ByDepts;
        sc.depts.Add(0 - 1);
        return sc;
    }

    public static DataScope Everything(int userId) {
        DataScope sc = new DataScope();
        sc.mode = All;
        sc.userId = userId;
        sc.superUser = true;
        return sc;
    }

    private static DataScope RoleAllScope(int userId) {
        DataScope sc = new DataScope();
        sc.mode = All;
        sc.userId = userId;
        sc.superUser = false;
        return sc;
    }

    public static async DataScope Of(SysUser me, List<SysDepartment> departments) {
        return await Of(null, me, departments);
    }

    public static async DataScope Of(IDbConnection db, SysUser me, List<SysDepartment> departments) {
        string uid = me == null ? "" : Convert.ToString(me.id);
        return await Of(db, me, departments, PermTable.UserVersion(uid), false, null);
    }

    internal static async DataScope ForRequest(IDbConnection db, SysUser me, long userVersion,
                                              Dictionary<string, string> claims = null) {
        return await Of(db, me, null, userVersion, true, claims);
    }

    private static async DataScope Of(IDbConnection db, SysUser me,
        List<SysDepartment> departments, long userVersion, bool loadDepartments,
        Dictionary<string, string> claims) {
        if (me == null || me.status != AuthUser.Active || userVersion == 0) { return None(); }
        string uid = Convert.ToString(me.id);
        if (PermTable.UserVersion(uid) != userVersion) { return None(); }
        string roleIds = await AuthUser.RolesOf(db, uid);
        if (PermTable.UserVersion(uid) != userVersion) { return None(); }
        if (roleIds == "*") {
            DataScope all = Everything(me.id);
            all.ApplyTags(claims);
            if (MvcHooks.HasScopeResolvers()) { await MvcHooks.RunScopeResolvers(db, me, all); }
            return all;
        }
        if (roleIds.Length == 0 || (departments == null && !loadDepartments)) { return None(); }

        long roleVersion = PermTable.RoleVersion();
        if (roleVersion == 0) { return None(); }
        string cached = PermTable.UserScopeEntry(uid, userVersion, roleVersion);
        int sep = cached.IndexOf(":");
        if (sep > 0) {
            DataScope restored = Restore(me.id, Filter.ToInt(cached.Substring(0, sep), 0),
                cached.Substring(sep + 1));
            if (PermTable.RoleVersion() == roleVersion
                && PermTable.UserVersion(uid) == userVersion) {
                restored.ApplyTags(claims);
                if (MvcHooks.HasScopeResolvers()) { await MvcHooks.RunScopeResolvers(db, me, restored); }
                return restored;
            }
            return None();
        }
        DataScope sc = await Resolve(db, departments, me, roleIds, roleVersion);
        if (PermTable.RoleVersion() != roleVersion || PermTable.UserVersion(uid) != userVersion) {
            return None();
        }
        PermTable.SetUserScope(uid, sc.mode, Join(sc.depts), userVersion, roleVersion);
        if (PermTable.RoleVersion() != roleVersion || PermTable.UserVersion(uid) != userVersion) {
            return None();
        }
        sc.ApplyTags(claims);
        if (MvcHooks.HasScopeResolvers()) { await MvcHooks.RunScopeResolvers(db, me, sc); }
        return sc;
    }

    private static async DataScope Resolve(IDbConnection db, List<SysDepartment> departments,
        SysUser me, string roleIds, long version) {
        List<string> ids = PermTable.Split(roleIds);
        List<int> depts = new List<int>();
        bool tree = false;
        bool own = false;
        bool self = false;

        for (int i = 0; i < ids.Count; i = i + 1) {
            string policy = PermTable.RolePolicy(ids[i], version);
            int sep = policy.IndexOf(":");
            if (sep <= 0) { continue; }
            int scope = Filter.ToInt(policy.Substring(0, sep), 0);
            if (scope < RoleAll || scope > RoleCustom) { continue; }
            if (scope == RoleAll) { return RoleAllScope(me.id); }
            if (scope == RoleDept) { own = true; }
            else if (scope == RoleDeptTree) { own = true; tree = true; }
            else if (scope == RoleSelf) { self = true; }
            else if (scope == RoleCustom) {
                List<string> named = PermTable.Split(policy.Substring(sep + 1));
                for (int j = 0; j < named.Count; j = j + 1) {
                    Add(depts, Filter.ToInt(named[j], 0));
                }
            }
        }

        if (own && me.departmentId > 0) {
            Add(depts, me.departmentId);
        }
        if (tree && me.departmentId > 0) {
            if (departments == null) {
                departments = await new SysDepartmentDao(db).All();
            }
            List<int> treeDepts = new List<int>();
            treeDepts.Add(me.departmentId);
            Descend(departments, me.departmentId, treeDepts);
            for (int i = 1; i < treeDepts.Count; i = i + 1) { Add(depts, treeDepts[i]); }
        }

        DataScope sc = new DataScope();
        sc.userId = me.id;
        if (depts.Count == 0) {
            if (!self) { return None(); }
            sc.mode = Self;
            return sc;
        }
        sc.mode = ByDepts;
        sc.depts = depts;
        return sc;
    }

    private static void Descend(List<SysDepartment> all, int parent, List<int> outp) {
        for (int i = 0; i < all.Count; i = i + 1) {
            SysDepartment d = all[i];
            if (d.parentId != parent || d.id <= 0) { continue; }
            if (Has(outp, d.id)) { continue; }
            outp.Add(d.id);
            Descend(all, d.id, outp);
        }
    }

    private static DataScope Restore(int userId, int mode, string depts) {
        DataScope sc = new DataScope();
        sc.userId = userId;
        if (mode != ByDepts && mode != Self) { return None(); }
        sc.mode = mode;
        if (mode == ByDepts) {
            List<string> ids = PermTable.Split(depts);
            for (int i = 0; i < ids.Count; i = i + 1) {
                Add(sc.depts, Filter.ToInt(ids[i], 0));
            }
            if (sc.depts.Count == 0) { return None(); }
        }
        return sc;
    }

    private static string Join(List<int> ids) {
        StringBuilder outp = new StringBuilder();
        outp.Append(",");
        for (int i = 0; i < ids.Count; i = i + 1) {
            outp.Append(Convert.ToString(ids[i]));
            outp.Append(",");
        }
        return outp.ToString();
    }

    private static void Add(List<int> list, int id) {
        if (id == 0 || Has(list, id)) { return; }
        list.Add(id);
    }

    private static bool Has(List<int> list, int id) {
        for (int i = 0; i < list.Count; i = i + 1) {
            if (list[i] == id) { return true; }
        }
        return false;
    }

    public static string Label(int roleScope) {
        if (roleScope == RoleAll) { return "全部数据"; }
        if (roleScope == RoleDept) { return "本部门"; }
        if (roleScope == RoleDeptTree) { return "本部门及下级"; }
        if (roleScope == RoleSelf) { return "仅本人"; }
        if (roleScope == RoleCustom) { return "自定义部门"; }
        return "未配置";
    }
}
