using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model;

namespace Zan.Web.Security;

public class AuthUser {
    /* 可登录账号的状态值。*/
    public static int Active = 1;

    /* 为单次认证查询借出连接；token/权限解析在请求协程上运行（delegate 为 async），协程挂起而非阻塞 worker。null 表示数据库不可达，调用方一律降级为匿名。RBAC 阶段从共享权限表读，请求路径零查询。*/
    public static async IDbConnection Lease() {
        AppServices s = AppServices.Current();
        if (s == null) { return null; }
        return await s.Db().Acquire();
    }

    public static void Give(IDbConnection db) {
        AppServices s = AppServices.Current();
        if (s == null) { return; }
        s.Db().Release(db);
    }

    /* 遗留口令哈希：12000 轮 SHA-256 迭代链（material_{r+1} =
       hex(sha256(material_r + ":" + salt))），仅用于校验升级前的旧行；
       新写入一律走 <see cref="NewHash"/> 的 PBKDF2 自描述格式。*/
    public static string PasswordHash(string password, string salt) {
        int saltLen = salt.Length;
        /* 缓冲：材料(<=64 hex) + ":" + salt */
        nint buf = NativeMemory.Alloc(64 + 1 + saltLen + 1);
        try {
            NativeMemory.PutString(buf, 0, salt, saltLen);
            NativeMemory.PutString(buf, saltLen, ":", 1);
            NativeMemory.PutString(buf, saltLen + 1, password, password.Length);
            int len = saltLen + 1 + password.Length;
            Span<byte> hex = new Span<byte>(buf, 65);
            /* 16 进制半字节表，Span 直读直写 */
            nint tbl = NativeMemory.Alloc(16);
            NativeMemory.PutString(tbl, 0, "0123456789abcdef", 16);
            Span<byte> dt = new Span<byte>(tbl, 16);
            for (int i = 0; i < 12000; i = i + 1) {
                NativeMemory.PutString(buf, len, ":", 1);
                NativeMemory.PutString(buf, len + 1, salt, saltLen);
                string digest = NativeMemory.Sha256(buf, len + 1 + saltLen);
                for (int b = 0; b < 32; b = b + 1) {
                    int v = digest[b] & 255;
                    hex[2 * b] = dt[v >> 4];
                    hex[2 * b + 1] = dt[v & 15];
                }
                len = 64;
            }
            NativeMemory.Free(tbl);
            /* 最后一轮的 hex 摘要就在缓冲前 64 字节 */
            return NativeMemory.GetString(buf, 0, 64);
        } finally {
            NativeMemory.Free(buf);
        }
    }

    /* PBKDF2-HMAC-SHA256（stdlib Pbkdf2，默认 30 万轮 ≈ 0.17s/次，
       登录专用路径）。存库格式自描述：pbkdf2$<iter>$<saltHex>$<hashHex>
       ——盐与轮数随哈希落库，调参不迁移旧值；passwordSalt 列只服务
       遗留行。迭代次数取 [auth].iter（env ZAN_AUTH_PBKDF2_ITER），
       下限 1000。 */
    public static string NewHash(string password) {
        int iter = Cfg.Auth.iter;
        if (iter < 1000) { iter = 300000; }
        string salt = Hex.Encode(RandomNumberGenerator.GetBytes(16), 16);
        string hex = Pbkdf2.Hex(password, salt, iter);
        return "pbkdf2$" + Convert.ToString(iter) + "$" + salt + "$" + hex;
    }

    /* 校验口令对一行凭证：pbkdf2$ 自描述格式按解析出的盐/轮数重派生
       比对；否则按遗留迭代链（passwordSalt 列）。比较走常时路径；
       格式不认得、字段残缺一律拒绝。 */
    public static bool Verify(string password, string saltCol, string stored) {
        if (stored.IndexOf("pbkdf2$") == 0) {
            int p1 = stored.IndexOf("$", 7);
            int p2 = stored.IndexOf("$", p1 + 1);
            if (p1 < 0 || p2 < 0) { return false; }
            int iter = Filter.ToInt(stored.Substring(7, p1 - 7), 0);
            string salt = stored.Substring(p1 + 1, p2 - p1 - 1);
            string want = stored.Substring(p2 + 1);
            if (iter < 1 || salt.Length == 0 || want.Length != 64) { return false; }
            return AuthToken.Equal(Pbkdf2.Hex(password, salt, iter), want);
        }
        if (saltCol.Length > 0 && stored.Length == 64) {
            return AuthToken.Equal(PasswordHash(password, saltCol),
                stored);
        }
        return false;
    }

    /* ZanSql 门面：认证单操作经门面逐次取还池连接，等价于一次性借还。*/
    public static IZanSql Orm() {
        AppServices s = AppServices.Current();
        if (s == null) { return null; }
        return s.Orm();
    }

    public static async SysUser ByUsername(string username) {
        return await new SysUserDao().ByUsername(username);
    }

    public static async SysUser ById(string uid) {
        int id = ToInt(uid);
        if (id <= 0) { return null; }
        return await new SysUserDao().ById(id);
    }

    /* 校验密码并发放 Cookie token；"" = 拒绝，调用方不得区分失败原因
       （限流、无此账号、密码错误同答空串）。爆破限流按账号记失败，
       达阈值锁到窗口滑出（LoginThrottle）。*/
    public static async string Login(string username, string password) {
        if (!LoginThrottle.Allowed(username)) { return ""; }
        SysUser row = await ByUsername(username);
        if (row == null || row.status != Active) {
            LoginThrottle.Fail(username);
            return "";
        }
        if (!Verify(password, row.passwordSalt, row.passwordHash)) {
            LoginThrottle.Fail(username);
            return "";
        }
        /* 遗留行成功登录即升级为 pbkdf2$ 自描述格式；写库失败静默，
           下次登录再试。不 bump tokenVersion：已发会话与口令哈希无关。 */
        if (row.passwordHash.IndexOf("pbkdf2$") != 0) {
            await UpgradeHash(row.id, password);
        }
        LoginThrottle.Clear(username);
        return AuthToken.Issue(Convert.ToString(row.id), row.tokenVersion,
            WebApp.NowSeconds());
    }

    /* 登录成功后的哈希格式升级（遗留链 → pbkdf2$）。独立门面操作，
       绝不嵌套在调用方租约之内。 */
    public static async void UpgradeHash(int uid, string password) {
        int _n = await new SysUserDao().UpgradeHash(uid,
            NewHash(password), WebApp.NowSeconds());
    }

    /* 账号当前 token 版本号；无法登录时返回 -1。token 版本不同即作废，token 本身不含密码材料。
       版本号走短 TTL 缓存：每个带 cookie 的请求都要校验一次，直查数据库会让
       每个认证请求消耗两次池借用，白白加倍池压力。代价是 bump tokenVersion
       后旧 token 最迟再有效 VerTtlSec 秒——对管理动作足够快，且 Forget 时主动失效。*/
    public static int VerTtlSec = 30;

    static List<AuthTokenVersionEntry> verEntries = new List<AuthTokenVersionEntry>();

    /* 命中返回缓存的版本号，过期/缺失返回 -1。 */
    public static int CachedVersion(string uid, int now) {
        lock (verEntries) {
            for (int i = 0; i < verEntries.Count; i = i + 1) {
                AuthTokenVersionEntry e = verEntries[i];
                if (e != null && e.uid == uid && e.goodUntil > now) {
                    return e.version;
                }
            }
        }
        return -1;
    }

    public static void StoreVersion(string uid, int version, int now) {
        lock (verEntries) {
            /* 顺带清扫过期项：倒序安全移除，永不漏项或死循环。 */
            for (int i = verEntries.Count - 1; i >= 0; i = i - 1) {
                AuthTokenVersionEntry e = verEntries[i];
                if (e == null || e.goodUntil <= now) {
                    verEntries.RemoveAt(i);
                } else if (e.uid == uid) {
                    e.version = version;
                    e.goodUntil = now + VerTtlSec;
                    return;
                }
            }
            verEntries.Add(new AuthTokenVersionEntry(uid, version, now + VerTtlSec));
        }
    }

    public static void DropCachedVersion(string uid) {
        lock (verEntries) {
            for (int i = 0; i < verEntries.Count; i = i + 1) {
                AuthTokenVersionEntry e = verEntries[i];
                if (e != null && e.uid == uid) {
                    verEntries.RemoveAt(i);
                    return;
                }
            }
        }
    }

    public static async int TokenVersion(string uid) {
        int now = WebApp.NowSeconds();
        int cached = CachedVersion(uid, now);
        if (cached >= 0) { return cached; }
        SysUser row = await ById(uid);
        /* 负结果不缓存：禁用/删除必须尽快生效，且这类查询不在热路径上。 */
        if (row == null || row.status != Active) { return -1; }
        StoreVersion(uid, row.tokenVersion, now);
        return row.tokenVersion;
    }

    public static int ToInt(string s) {
        return Filter.ToInt(s, 0);
    }

    /* ---- 授权 ---- */
    /* 模型：用户持角色，角色持路由 action，action 是调度和菜单共问的唯一权限单位。权限数据在共享内存（PermTable），首次缺失时从数据库加载。授权变更主动写回共享内存。*/
    /* 授权变更时同步失效版本缓存。若启用了集群总线，向集群广播。*/
    public static void Forget(string uid) {
        ForgetLocal(uid);
        if (ClusterBus.Enabled()) {
            ClusterBus.PublishEvictUser(uid);
        }
    }

    /* 仅清除本进程内存与共享内存，不发跨节点广播（用于接收集群广播或纯本地清理）。*/
    public static void ForgetLocal(string uid) {
        DropCachedVersion(uid);
        PermTable.Forget(uid);
    }

    public static void ForgetAll() {
        ForgetAllLocal();
        if (ClusterBus.Enabled()) {
            ClusterBus.PublishEvictAll();
        }
    }

    public static void ForgetAllLocal() {
        lock (verEntries) {
            verEntries.Clear();
        }
        PermTable.ForgetAll();
    }

    public static async void RolesChanged(IDbConnection db) {
        await PermTable.LoadRoles(db);
        PermTable.ForgetAll();
    }

    public static async void RolesChanged(List<SysRole> roles, List<SysRoleGrant> grants) {
        await PermTable.LoadRoles(roles, grants);
        PermTable.ForgetAll();
    }

    /* 调度器和菜单共用的权限解析：账号是否可执行该 action。Bootstrap 账号绕过查找。
       持有请求租约的调用方（控制器动作内）必须走 <see cref="Allow"/> 的
       带连接重载——嵌套租借（持一条再等第二条）在高并发下会把池拖成
       循环等待，见 RolesOf 的说明。 */
    public static async bool Allow(string uid, string action) {
        return await Allow(null, uid, action);
    }

    /* 带租约的权限解析：db 传调用方已持有的请求租约（Held()），角色
       未命中时的回填查询直接跑在它上面，不再二次借连接；传 null 则
       自行借还一次（调用方未持有任何连接时）。 */
    public static async bool Allow(IDbConnection db, string uid, string action) {
        if (action.Length == 0) { return false; }
        string roleIds = await RolesOf(db, uid);
        if (roleIds == "*") { return true; }
        if (roleIds.Length == 0) { return false; }
        return PermTable.RolesAllow(roleIds, action);
    }

    /* 该账号在某屏上的按钮掩码；与 Allow() 拒之依据为同一决策。Bootstrap 账号持该屏所有位。 */
    public static async int MaskOf(string uid, string screen) {
        return await MaskOf(null, uid, screen);
    }

    /* 带租约的按钮掩码：语义同 <see cref="Allow"/> 的带连接重载。 */
    public static async int MaskOf(IDbConnection db, string uid, string screen) {
        if (screen.Length == 0) { return 0; }
        string roleIds = await RolesOf(db, uid);
        if (roleIds == "*") { return Perm.MaskOf(screen); }
        if (roleIds.Length == 0) { return 0; }
        return PermTable.RolesMask(roleIds, screen) & Perm.MaskOf(screen);
    }

    /* 账号角色 ",3,7,"；"*" 为 bootstrap；"" 为未知/禁用/数据库不可达。共享内存读，首次缺失从数据库填充。*/
    public static async string RolesOf(string uid) {
        return await RolesOf(null, uid);
    }

    /* 共享内存未命中时的数据库回填。db 为调用方已持有的租约时查询
       直接跑在它上——绝不在持有租约的状态下再借第二条连接：
       并发数一旦达到池上限，「每人都持一条、每人都等第二条」就是
       循环等待，谁也不释放（实测过的全站假死形态）。db 为 null 才
       自行借还一次，此时本协程未持有任何连接，顺序借用是安全的。*/
    public static async string RolesOf(IDbConnection db, string uid) {
        int id = ToInt(uid);
        if (id <= 0) { return ""; }

        string hit = PermTable.UserRoles(uid);
        if (hit.Length > 0) { return hit; }

        IDbConnection owned = null;
        if (db == null) {
            owned = await Lease();
            if (owned == null) { return ""; }
            db = owned;
        }
        try {
            SysUser me = await db.Select<SysUser>().Where(a => a.id == id).FirstAsync();
            if (me == null || me.status != Active) { return ""; }
            if (me.isSuper == 1) {
                PermTable.SetUser(uid, true, "");
                return "*";
            }
            string joined = await RoleIds(db, me);
            PermTable.SetUser(uid, false, joined);
            return joined;
        } finally {
            if (owned != null) { Give(owned); }
        }
    }

    /* 账号已启用的角色（自身 + 所在部门），输出 ",3,7,"。*/
    private static async string RoleIds(IDbConnection db, SysUser me) {
        List<int> roleIds = new List<int>();
        List<SysUserRole> mine = await db.Select<SysUserRole>()
            .Where(a => a.userId == me.id).ToListAsync();
        for (int i = 0; i < mine.Count; i = i + 1) {
            AddId(roleIds, mine[i].roleId);
        }
        int dept = me.departmentId;
        if (dept > 0) {
            List<SysDepartmentRole> byDept = await db.Select<SysDepartmentRole>()
                .Where(a => a.departmentId == dept).ToListAsync();
            for (int i = 0; i < byDept.Count; i = i + 1) {
                AddId(roleIds, byDept[i].roleId);
            }
        }
        if (roleIds.Count == 0) { return ""; }

        StringBuilder outp = new StringBuilder();
        outp.Append(",");
        List<SysRole> roles = await db.Select<SysRole>().ToListAsync();
        for (int i = 0; i < roles.Count; i = i + 1) {
            SysRole r = roles[i];
            if (r.status != 1 || !HasId(roleIds, r.id)) { continue; }
            outp.Append(Convert.ToString(r.id));
            outp.Append(",");
        }
        string joined = outp.ToString();
        if (joined == ",") { return ""; }
        return joined;
    }

    private static void AddId(List<int> list, int id) {
        if (id <= 0 || HasId(list, id)) { return; }
        list.Add(id);
    }

    private static bool HasId(List<int> list, int id) {
        for (int i = 0; i < list.Count; i = i + 1) {
            if (list[i] == id) { return true; }
        }
        return false;
    }

    public static bool Holds(string haystack, string needle) {
        if (needle.Length == 0) { return false; }
        return ("," + haystack + ",").Contains("," + needle + ",");
    }
}
