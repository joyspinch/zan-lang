using System;
using System.Security.Cryptography;
using System.Web;
using Zan.Web.Core;
using Zan.Web.Services;
using Zan.Web;

namespace Zan.Web.Security;

public class VerifyCode {
    public static int TtlSeconds = 600;
    public static int ResendSeconds = 60;

    public static string Key(string purpose, string address) {
        return "code:" + purpose + ":" + address.Trim().ToLower();
    }

    public static CacheContext Cache() {
        AppServices s = AppServices.Current();
        if (s == null) { return null; }
        return s.Cache();
    }

    public static async bool TooSoon(string purpose, string address) {
        CacheContext c = Cache();
        if (c == null) { return true; }
        string hit = await c.GetAsync(CooldownKey(address));
        return hit.Length > 0;
    }

    public static string CooldownKey(string address) {
        return "code:sent:" + address.Trim().ToLower();
    }

    public static async string Issue(string purpose, string address) {
        VerifyCodeIssue issued = await IssueForIp(purpose, address, "unknown");
        return issued.code;
    }

    public static async VerifyCodeIssue IssueForIp(string purpose, string address, string ip) {
        VerifyCodeIssue issued = new VerifyCodeIssue();
        CacheContext c = Cache();
        if (c == null) { return issued; }
        string peer = ip.Trim().ToLower();
        if (peer.Length == 0) { peer = "unknown"; }
        int windowSeconds = Cfg.EnvInt("ZAN_VERIFY_IP_WINDOW_SECONDS", 600);
        int maxSends = Cfg.EnvInt("ZAN_VERIFY_IP_MAX_SENDS", 5);
        string code = Digits(6);
        issued.status = await c.IssueCodeAsync(Key(purpose, address),
            CooldownKey(address), "code:ip:" + peer, code,
            TtlSeconds, ResendSeconds, windowSeconds, maxSends);
        if (issued.status == 1) { issued.code = code; }
        return issued;
    }

    /* 校验并消费验证码，错误/过期/已用均返回 false。 */
    public static async bool Accept(string purpose, string address, string code) {
        if (code.Length == 0) { return false; }
        CacheContext c = Cache();
        if (c == null) { return false; }
        return await c.ConsumeCodeAsync(Key(purpose, address), code);
    }

    public static string Digits(int n) {
        byte[] raw = RandomNumberGenerator.GetBytes(n);
        string digits = "";
        for (int i = 0; i < n; i = i + 1) {
            int v = (int)raw[i];
            if (v < 0) { v = 0 - v; }
            digits = digits + Convert.ToString(v % 10);
        }
        return digits;
    }
}
