using System;
using System.Web;
using Zan.Web.Core;

namespace Zan.Web.Security;

/* 按钮级权限：屏为一行，按钮为 5 位位掩码。action 通过 [Custom(Perm = PermBit.Update)] 声明所属位，编译器写入 Route.MetaGet("Perm")。授权行为 (roleId, screen, mask)，检查为一次 AND。未声明位的 action 不可授权，boot 日志提示。*/
public class Perm {
    private static Dict<string, int> bits = null;
    private static Dict<string, int> masks = null;
    private static List<string> screens = null;
    private static Dict<string, string> titles = null;
    private static List<string> unmarked = null;

    public static const int Full = 31;

    /* 从注册路由构建索引，main 中 __AttrRoutes.Register 之后、首个请求之前调用。*/
    public static void Index(WebApp app) {
        bits = new Dict<string, int>();
        masks = new Dict<string, int>();
        screens = new List<string>();
        titles = new Dict<string, string>();
        unmarked = new List<string>();

        List<Route> all = app.Router().All();
        StrMap seenRoutes = new StrMap();
        for (int i = 0; i < all.Count; i = i + 1) {
            Route r = all[i];
            string routeKey = r.Method() + " " + r.Pattern();
            if (seenRoutes.Has(routeKey)) { continue; }
            seenRoutes.Set(routeKey, "1");
            if (!r.NeedsAuth() || r.Action().Length == 0) { continue; }
            if (bits.ContainsKey(r.Action())) { continue; }
            int bit = BitValue(r.MetaGet("Perm"));
            bits.Add(r.Action(), bit);
            if (bit == 0) { unmarked.Add(r.Action()); continue; }
            string screen = ScreenOf(r.Action());
            int have = 0;
            if (masks.TryGetValue(screen, out have)) {
                masks.Remove(screen);
            } else {
                screens.Add(screen);
            }
            masks.Add(screen, have | bit);
            Title(screen, r);
        }
        if (unmarked.Count > 0) {
            Console.WriteLine("[rbac] " + Convert.ToString(unmarked.Count)
                + " 个受控 action 未标注 Perm，已拒绝授权: "
                + Join(unmarked, 8));
        }
    }

    public static bool Ready() { return bits != null; }

    public static int BitOf(string action) {
        if (!Ready()) { return 0; }
        int bit = 0;
        if (bits.TryGetValue(action, out bit)) { return bit; }
        return 0;
    }

    /* "SysUsers.Save" -> "SysUsers"；"Admin.System.SysUsers.Save" -> "Admin.System.SysUsers"。末段为方法，其余为屏。*/
    public static string ScreenOf(string action) {
        int dot = action.LastIndexOf(".");
        if (dot <= 0) { return action; }
        return action.Substring(0, dot);
    }

    public static int MaskOf(string screen) {
        if (!Ready()) { return 0; }
        int mask = 0;
        if (masks.TryGetValue(screen, out mask)) { return mask; }
        return 0;
    }

    /* 记录或升级屏标题：屏的 Index 优先，否则取首见路由的 title。*/
    private static void Title(string screen, Route r) {
        if (r.GetTitle().Length == 0) { return; }
        bool have = titles.ContainsKey(screen);
        if (have && !r.Action().EndsWith(".Index")) { return; }
        if (have) { titles.Remove(screen); }
        titles.Add(screen, r.GetTitle());
    }

    public static string TitleOf(string screen) {
        if (!Ready()) { return screen; }
        string t = "";
        if (titles.TryGetValue(screen, out t) && t.Length > 0) { return t; }
        return screen;
    }

    public static List<string> Screens() {
        if (!Ready()) { return new List<string>(); }
        return screens;
    }

    static List<string> Unmarked() {
        if (!Ready()) { return new List<string>(); }
        return unmarked;
    }

    private static int[] bitValues() {
        return new int[] {
            (int)PermBit.View, (int)PermBit.Create, (int)PermBit.Update, (int)PermBit.Delete,
            (int)PermBit.Export, (int)PermBit.Import, (int)PermBit.Audit, (int)PermBit.Publish
        };
    }

    private static string[] bitNames() {
        return new string[] {
            "View", "Create", "Update", "Delete", "Export", "Import", "Audit", "Publish"
        };
    }

    private static string[] bitLabels() {
        return new string[] {
            "查看", "新增", "修改", "删除", "导出", "导入", "审核", "发布"
        };
    }

    /* PermBit 成员名 -> 位值。"Create|Update" 表示该 action 同时需要两 bits。*/
    public static int BitValue(string name) {
        int bar = name.IndexOf("|");
        if (bar > 0) {
            return BitValue(name.Substring(0, bar))
                 | BitValue(name.Substring(bar + 1));
        }
        int[] vals = bitValues();
        string[] names = bitNames();
        for (int i = 0; i < names.Length; i = i + 1) {
            if (name == names[i]) { return vals[i]; }
        }
        return 0;
    }

    public static List<int> Order() {
        List<int> outp = new List<int>();
        int[] vals = bitValues();
        for (int i = 0; i < vals.Length; i = i + 1) {
            outp.Add(vals[i]);
        }
        return outp;
    }

    private static string BitLabel(int bit) {
        int[] vals = bitValues();
        string[] labels_ = bitLabels();
        for (int i = 0; i < vals.Length; i = i + 1) {
            if (bit == vals[i]) { return labels_[i]; }
        }
        return "";
    }

    public static string BitName(int bit) {
        int[] vals = bitValues();
        string[] names = bitNames();
        for (int i = 0; i < vals.Length; i = i + 1) {
            if (bit == vals[i]) { return names[i]; }
        }
        return "";
    }

    /* ---- 持久化串格式 ---- */
    /* 角色掩码以 ",SysUsers:15,SysRoles:5," 字符串行式存放在共享内存中，请求路径读一次即得答案，授权变更才重写。*/

    public static int MaskIn(string stored, string screen) {
        if (stored.Length == 0 || screen.Length == 0) { return 0; }
        int at = stored.IndexOf("," + screen + ":");
        if (at < 0) { return 0; }
        int i = at + screen.Length + 2;
        int val = 0;
        bool any = false;
        while (i < stored.Length) {
            int c = stored[i] & 255;
            if (c < 48 || c > 57) { break; }
            val = val * 10 + (c - 48);
            any = true;
            i = i + 1;
        }
        if (!any) { return 0; }
        return val;
    }

    public static void Append(StringBuilder sb, string screen, int mask) {
        if (screen.Length == 0 || mask <= 0) { return; }
        sb.Append(screen);
        sb.Append(":");
        sb.Append(Convert.ToString(mask));
        sb.Append(",");
    }

    public static string Join(List<string> items, int max) {
        StringBuilder sb = new StringBuilder();
        int n = items.Count;
        if (n > max) { n = max; }
        for (int i = 0; i < n; i = i + 1) {
            if (i > 0) { sb.Append(" "); }
            sb.Append(items[i]);
        }
        if (items.Count > n) { sb.Append(" ..."); }
        return sb.ToString();
    }
}
