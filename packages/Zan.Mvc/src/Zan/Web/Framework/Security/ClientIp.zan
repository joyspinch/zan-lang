using System;
using System.Collections.Generic;
using System.Web;
using Zan.Web.Core;

namespace Zan.Web.Security;

/* 客户端 IP 身份，配额、审计与在线统计共用的同一口径。Canonical 把
   IPv4/IPv6 字面量展开为唯一拼写，等价文本不得制造额外配额桶
   （IPv4-mapped 归还原生 IPv4 身份）；Of 在 trustedProxies 配置下从
   X-Forwarded-For 反代链解析真实客户端——只信受托跳，从不盲取最左项。 */
public class ClientIp {

    /* 规范拼写；算法唯一实现在 System.Web.ForwardedHeaders。 */
    public static string Canonical(string ip) {
        return ForwardedHeaders.Canonical(ip);
    }

    /* 受托代理名单（server.trustedProxies）；任一项非法即整份作废、不信任
       任何代理——一条手误不得放大信任面。 */
    public static List<string> Trusted() {
        List<string> trusted = new List<string>();
        string configured = Cfg.Server.trustedProxies;
        if (configured.Length == 0 || configured.Length > 4096) { return trusted; }
        List<string> entries = configured.Split(",");
        for (int i = 0; i < entries.Count; i = i + 1) {
            string proxy = Canonical(entries[i].Trim());
            if (proxy.Length == 0) { return new List<string>(); }
            trusted.Add(proxy);
        }
        return trusted;
    }

    public static string Of(HttpContext ctx) {
        return ForwardedHeaders.Resolve(ctx.RemoteIp(), ctx.Request(), Trusted());
    }
}
