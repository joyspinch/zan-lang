using System;
using System.Web;

namespace Zan.Web.Security;

public class Routes {
    public static const string Login = "/admin/login";
    public static const string LoginSubmit = "/admin/login/submit";
    public static const string Logout = "/admin/logout";
    public static const string Profile = "/admin/profile";
    public static const string Data = "/admin/monitor/data";
    public static const string Home = "/";
    public static const string SignIn = "/login";
    public static const string SignUp = "/register";
    public static const string DataIndex = "Zan.Web.Admin.Monitor.DataController.Index";

    public static string ActionOf(TypeInfo controller, string action = "Index") {
        return __AttrRoutes.ActionKey(controller, action);
    }

    public static string PathOf(TypeInfo controller, string action = "Index", string fallback = "") {
        return __AttrRoutes.PathOf(WebHost.Current(), controller, action, fallback);
    }
}
