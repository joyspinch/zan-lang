using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using System.Diagnostics;
using System.Security.Cryptography;
using System.Text;
using System.Web;
using Zan.Web.Model;
using Zan.Web.Dao;
using Zan.Web.Core;
using Zan.Web.Services;
using Zan.Web;

namespace Zan.Web.Security;

// 强类型 Token 版本缓存条目实体：将 uid、版本号与到期时间绑定，消除平行列表反模式。
public class AuthToken {
    private static string Secret() { return Cfg.Auth.secret; }
    public static bool Ready() { return Secret().Length >= 32; }

    public static bool Equal(string actual, string expected) {
        int diff = actual.Length ^ expected.Length;
        int n = expected.Length;
        for (int i = 0; i < n; i = i + 1) {
            int a = 0;
            if (i < actual.Length) { a = actual[i] & 255; }
            diff = diff | (a ^ (expected[i] & 255));
        }
        return diff == 0;
    }

    private static string cachedSecret = "";
    private static byte[] cachedKey = null;

    public static string EncodeUrl(string raw, int len) {
        string text = Base64.Encode(raw, len).Replace("+", "-").Replace("/", "_");
        int end = text.Length;
        while (end > 0 && (text[end - 1] & 255) == 61) {
            end = end - 1;
        }
        if (end < text.Length) {
            return text.Substring(0, end);
        }
        return text;
    }

    public static byte[] DecodeUrl(string text, List<int> outLen) {
        for (int i = 0; i < text.Length; i = i + 1) {
            int c = text[i] & 255;
            bool valid = (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
                || (c >= 48 && c <= 57) || c == 45 || c == 95;
            if (!valid) { outLen[0] = -1; return new byte[0]; }
        }
        string base64 = text.Replace("-", "+").Replace("_", "/");
        int rem = base64.Length & 3;
        if (rem == 1) { outLen[0] = -1; return new byte[0]; }
        if (rem == 2) { base64 = base64 + "=="; }
        else if (rem == 3) { base64 = base64 + "="; }
        return Base64.Decode(base64, outLen);
    }

    public static byte[] Key() {
        string secret = Secret();
        if (AuthToken.cachedKey != null && AuthToken.cachedSecret == secret) {
            return AuthToken.cachedKey;
        }
        byte[] derived = Sha256.Hash(secret, secret.Length);
        AuthToken.cachedSecret = secret;
        AuthToken.cachedKey = derived;
        return derived;
    }

    /* 用 AES-GCM 加密签发 Cookie：版本标记 + uid + 签发时间 + tokenVersion（可选签名 Claims）。不含密码材料，强制登出只需 bump 整数。*/
    public static string Issue(string uid, int tokenVersion, int now) {
        return Issue(uid, tokenVersion, now, null);
    }

    public static string Issue(string uid, int tokenVersion, int now, Dictionary<string, string> claims) {
        if (!Ready()) { return ""; }
        string encodedClaims = EncodeClaims(claims);
        string plain = "2\t" + uid + "\t" + Convert.ToString(now) + "\t"
            + Convert.ToString(tokenVersion);
        if (encodedClaims.Length > 0) {
            plain = plain + "\t" + encodedClaims;
        }
        byte[] key = Key();
        byte[] iv = RandomNumberGenerator.GetBytes(12);
        byte[] tag = new byte[16];
        string aad = "zan.auth.cookie.v1";
        byte[] cipher = AesGcm.Encrypt(key, 32, iv, aad, aad.Length,
            plain, plain.Length, tag);
        if (cipher == null) { return ""; }
        byte[] packed = new byte[12 + cipher.Length + 16];
        NativeMemory.Copy((nint)packed, (nint)iv, 12);
        if (cipher.Length > 0) {
            NativeMemory.Copy((nint)packed + (nint)12, (nint)cipher, cipher.Length);
        }
        NativeMemory.Copy((nint)packed + (nint)(12 + cipher.Length), (nint)tag, 16);
        return EncodeUrl(packed, packed.Length);
    }

    private static string EncodeClaims(Dictionary<string, string> claims) {
        if (claims == null || claims.Count == 0) { return ""; }
        List<string> keys = claims.Keys;
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < keys.Count; i = i + 1) {
            string k = keys[i];
            if (k == null || k.Length == 0) { continue; }
            string v = "";
            claims.TryGetValue(k, out v);
            if (sb.Length > 0) { sb.Append("&"); }
            sb.Append(Encoding.UrlEncode(k));
            sb.Append("=");
            sb.Append(Encoding.UrlEncode(v == null ? "" : v));
        }
        return sb.ToString();
    }

    private static void DecodeClaims(string raw, Dictionary<string, string> outClaims) {
        if (outClaims == null || raw == null || raw.Length == 0) { return; }
        List<string> pairs = raw.Split("&");
        for (int i = 0; i < pairs.Count; i = i + 1) {
            string item = pairs[i];
            if (item.Length == 0) { continue; }
            int eq = item.IndexOf("=");
            string k = eq >= 0 ? Encoding.UrlDecode(item.Substring(0, eq)) : Encoding.UrlDecode(item);
            string v = eq >= 0 ? Encoding.UrlDecode(item.Substring(eq + 1)) : "";
            if (k.Length > 0) {
                outClaims[k] = v;
            }
        }
    }

    private static bool TryDecryptPayload(string token, out string uid, out int carriedVersion,
                                          Dictionary<string, string> outClaims) {
        uid = "";
        carriedVersion = -1;
        if (!Ready() || token == null || token.Length < 50 || token.Length > 2048) { return false; }
        List<int> decodedLen = new List<int>(); decodedLen.Add(0);
        byte[] packed = DecodeUrl(token, decodedLen);
        int total = decodedLen[0];
        if (total < 29) { return false; }
        int cipherLen = total - 28;
        byte[] iv = new byte[12];
        byte[] cipher = new byte[cipherLen];
        byte[] tag = new byte[16];
        NativeMemory.Copy((nint)iv, (nint)packed, 12);
        NativeMemory.Copy((nint)cipher, (nint)packed + (nint)12, cipherLen);
        NativeMemory.Copy((nint)tag, (nint)packed + (nint)(12 + cipherLen), 16);
        byte[] key = Key();
        List<int> ok = new List<int>(); ok.Add(0);
        string aad = "zan.auth.cookie.v1";
        byte[] plainBytes = AesGcm.Decrypt(key, 32, iv, aad, aad.Length,
            cipher, cipherLen, tag, ok);
        if (ok[0] == 0 || plainBytes == null) { return false; }
        string plain = plainBytes.ToStr(0, cipherLen);
        int first = plain.IndexOf("\t");
        int second = plain.IndexOf("\t", first + 1);
        int third = plain.IndexOf("\t", second + 1);
        if (first != 1 || plain.Substring(0, first) != "2"
            || second <= first + 1 || third <= second + 1) { return false; }
        int fourth = plain.IndexOf("\t", third + 1);
        if (fourth >= 0 && plain.IndexOf("\t", fourth + 1) >= 0) { return false; }
        string parsedUid = plain.Substring(first + 1, second - first - 1);
        int issued = Filter.ToInt(plain.Substring(second + 1, third - second - 1), 0);
        int now = WebApp.NowSeconds();
        int ttl = Cfg.Auth.ttlSeconds > 0 ? Cfg.Auth.ttlSeconds : 864000;
        if (issued <= 0 || issued > now + 300 || issued + ttl <= now) { return false; }
        string verStr = fourth >= 0
            ? plain.Substring(third + 1, fourth - third - 1)
            : plain.Substring(third + 1);
        int carried = Filter.ToInt(verStr, -1);
        if (carried < 0) { return false; }
        uid = parsedUid;
        carriedVersion = carried;
        if (fourth >= 0 && outClaims != null) {
            DecodeClaims(plain.Substring(fourth + 1), outClaims);
        }
        return true;
    }

    /* 解密并校验签名及有效期（免二次查库），供请求上下文提取已验证声明。 */
    public static bool ParseClaims(string token, string expectedUid, Dictionary<string, string> outClaims) {
        string parsedUid = "";
        int carried = -1;
        if (!TryDecryptPayload(token, out parsedUid, out carried, outClaims)) { return false; }
        if (expectedUid != null && expectedUid.Length > 0 && parsedUid != expectedUid) {
            if (outClaims != null) { outClaims.Clear(); }
            return false;
        }
        return true;
    }

    public static async string Resolve(string token) {
        return await ResolveClaims(token, null);
    }

    public static async string ResolveClaims(string token, Dictionary<string, string> outClaims) {
        string uid = "";
        int carried = -1;
        if (!TryDecryptPayload(token, out uid, out carried, outClaims)) { return ""; }
        int current = await AuthUser.TokenVersion(uid);
        /* 不记录 token 或 uid，避免凭证材料泄漏。*/
        if (carried < 0 || current < 0 || carried != current) {
            if (outClaims != null) { outClaims.Clear(); }
            return "";
        }
        return uid;
    }
}
