using System;
using System.Collections.Generic;
using Zan.Web.Core;

namespace Zan.Web.Security;

internal class LoginThrottleEntry {
    public int count;
    public int windowStart;

    public LoginThrottleEntry(int c, int start) {
        this.count = c;
        this.windowStart = start;
    }
}

// 登录爆破限流：按账号（大小写/空白归一）记失败次数，窗口内达到阈值
// 即拒绝后续尝试，直到窗口整体滑出。进程内固定窗实现——每 worker
// 独立计数，阈值按 worker 数放大即实际成本，窗口+阈值组合已把在线
// 爆破压到不可行量级；跨 worker 共享计数是 SharedTable 的后续题。
// 语义要点（与 AuthUser.Login 配合）：
// - 被限流与密码错误同答空串，不向客户端区分原因（无账号枚举 oracle）；
// Blocked() 供调用方渲染"稍后再试"文案，锁状态本就来自攻击者自己的
// 失败次数，不构成新信息。
// - 不存在的账号也记失败：否则"账号不存在"路径不受限流，计时侧信道
// 可枚举有效用户名。
// - 成功登录清零；键上限封内存，超出先清过期项再淘汰最旧（攻击者换账号扫描时
// 最多冲掉自己的限流记录）。
public class LoginThrottle {
    /* 窗口内第 MaxFails 次失败即锁到窗口滑出。默认 10 次 / 15 分钟：
 十轮爆破 900 秒只试 10 个口令，人工输错也够余量。 */
    public static const int MaxFails = 10;
    public static const int WindowSec = 900;
    /* 键内存上限：Dictionary O(1) 索引，超限先清过期再淘汰最旧窗口。 */
    public static const int MaxKeys = 4096;

    private static Dictionary<string, LoginThrottleEntry> entries = new Dictionary<string, LoginThrottleEntry>();

    public static string Norm(string user) {
        if (user == null) { return ""; }
        string s = user.Trim().ToLower();
        if (s.Length > 64) { s = s.Substring(0, 64); }
        return s;
    }

    /* 该账号当前是否还允许尝试。 */
    public static bool Allowed(string user) {
        string key = Norm(user);
        if (key.Length == 0) { return true; }
        Dictionary<string, LoginThrottleEntry> map = LoginThrottle.entries;
        if (map == null) { return true; }
        int now = WebApp.NowSeconds();
        lock (map) {
            LoginThrottleEntry e = null;
            if (!map.TryGetValue(key, out e) || e == null) { return true; }
            if (now - e.windowStart >= WindowSec) {
                map.Remove(key);
                return true;
            }
            return e.count < MaxFails;
        }
    }

    /* 记一次失败；新键占用若触顶先清过期项再淘汰最旧。 */
    public static void Fail(string user) {
        string key = Norm(user);
        if (key.Length == 0) { return; }
        Dictionary<string, LoginThrottleEntry> map = LoginThrottle.entries;
        if (map == null) { return; }
        int now = WebApp.NowSeconds();
        lock (map) {
            LoginThrottleEntry e = null;
            if (map.TryGetValue(key, out e) && e != null) {
                if (now - e.windowStart >= WindowSec) {
                    e.count = 1;
                    e.windowStart = now;
                } else {
                    e.count = e.count + 1;
                }
                return;
            }
            if (map.Count >= MaxKeys) {
                List<string> keys = map.Keys;
                string oldestKey = null;
                int oldestStart = 2147483647;
                for (int i = 0; i < keys.Count; i = i + 1) {
                    string k = keys[i];
                    LoginThrottleEntry cur = null;
                    if (map.TryGetValue(k, out cur) && cur != null) {
                        if (now - cur.windowStart >= WindowSec) {
                            map.Remove(k);
                        } else if (cur.windowStart < oldestStart) {
                            oldestStart = cur.windowStart;
                            oldestKey = k;
                        }
                    }
                }
                if (map.Count >= MaxKeys && oldestKey != null) {
                    map.Remove(oldestKey);
                }
            }
            map[key] = new LoginThrottleEntry(1, now);
        }
    }

    /* 成功登录清零该账号。 */
    public static void Clear(string user) {
        string key = Norm(user);
        if (key.Length == 0) { return; }
        Dictionary<string, LoginThrottleEntry> map = LoginThrottle.entries;
        if (map == null) { return; }
        lock (map) {
            map.Remove(key);
        }
    }

    /* 被限流即 true——仅供界面文案，不改变 Login 的应答语义。 */
    public static bool Blocked(string user) {
        return !Allowed(user);
    }
}
