using System;
using System.Data;
using System.Data.Orm;
using System.IO;
using System.Json;
using System.Security.Cryptography;
using System.Text;
using System.Web;
using Zan.Web.AdminUi;
using Zan.Web.Ai;
using Zan.Web.Core;
using Zan.Web.Dao;
using Zan.Web.Model;
using Zan.Web.Modules.Crud.Controller.Admin.Dev;
using Zan.Web.Security;
using Zan.Web.Services;
using Zan.Web;

namespace Zan.Web.Admin.Dev;

/* /admin/dev/coder 表设计器：纯 JSON 协议（设计表 → 字段行内编辑/AI 字段设计 → 同步数据库 → 预览/生成代码）。 */
[Custom(Authorization = CustomAuthorization.Grant, Group = "开发工具", GroupOrder = 100)]
[Description("代码生成")]
public class CoderController : AdminController {
    SysGenTableDao SysGenTable { get { return new SysGenTableDao(this.Held()); } }
    SysGenColumnDao SysGenColumn { get { return new SysGenColumnDao(this.Held()); } }
    SysDictTypeDao SysDictType { get { return new SysDictTypeDao(this.Held()); } }

    [HttpGet]
    [Custom(IsMenu = true, Icon = "mdi:table-cog", Perm = PermBit.View)]
    [Description("表设计与生成")]
    public async void Index() {
        await this.Conf();
    }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("表设计器页面配置")]
    public async void Conf() {
        bool aiOn = await Ai.Ready();
        bool canCreate = await this.Can((int)PermBit.Create);
        bool canUpdate = await this.Can((int)PermBit.Update);
        bool canDelete = await this.Can((int)PermBit.Delete);
        List<SysDictType> dicts = await this.SysDictType.Where(a => a.status == 1).ToListAsync();

        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("PageType", "coder");
        w.WriteProperty("title", "表设计与生成");
        w.WriteProperty("tablesUrl", "tables");
        w.WriteProperty("tableSaveUrl", "tablesave");
        w.WriteProperty("tableDeleteUrl", "tabledelete");
        w.WriteProperty("columnsUrl", "columns");
        w.WriteProperty("columnSaveUrl", "columnsave");
        w.WriteProperty("columnDeleteUrl", "columndelete");
        w.WriteProperty("columnFieldUrl", "columnfield");
        w.WriteProperty("aiDesignUrl", "aidesign");
        w.WriteProperty("aiApplyUrl", "aiapply");
        w.WriteProperty("migrateUrl", "migrate");
        w.WriteProperty("buildUrl", "build");
        w.WriteProperty("previewUrl", "preview");
        w.WriteProperty("ownUrl", "own");
        w.WriteProperty("dataBaseUrl", "/admin/monitor/data");
        w.WriteProperty("aiReady", aiOn);
        w.WriteProperty("canCreate", canCreate);
        w.WriteProperty("canUpdate", canUpdate);
        w.WriteProperty("canDelete", canDelete);
        w.WritePropertyName("dicts");
        w.WriteStartArray();
        for (int i = 0; i < dicts.Count; i = i + 1) {
            w.WriteStartObject();
            w.WriteProperty("code", dicts[i].code);
            w.WriteProperty("name", dicts[i].name);
            w.WriteEndObject();
        }
        w.WriteEndArray();
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("设计表列表")]
    public async void Tables() {
        List<SysGenTable> rows = await this.SysGenTable.OrderBy(a => a.id).ToListAsync();
        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            SysGenTable t = rows[i];
            int cols = await this.SysGenColumn.Where(a => a.tableId == t.id).CountAsync();
            w.WriteStartObject();
            w.WriteProperty("id", t.id);
            w.WriteProperty("tableName", t.tableName);
            w.WriteProperty("entityName", t.entityName);
            w.WriteProperty("title", t.title);
            w.WriteProperty("section", t.section);
            w.WriteProperty("pageSize", t.pageSize > 0 ? t.pageSize : 20);
            w.WriteProperty("orderColumn", t.orderColumn != null && t.orderColumn.Length > 0 ? t.orderColumn : "id");
            w.WriteProperty("orderDesc", t.orderDesc);
            w.WriteProperty("labelColumn", t.labelColumn == null ? "" : t.labelColumn);
            w.WriteProperty("menuIcon", t.menuIcon == null ? "" : t.menuIcon);
            w.WriteProperty("tabColumn", t.tabColumn == null ? "" : t.tabColumn);
            w.WriteProperty("exportEnabled", t.exportEnabled);
            w.WriteProperty("apiEnabled", t.apiEnabled);
            w.WriteProperty("hasCreate", t.hasCreate);
            w.WriteProperty("hasEdit", t.hasEdit);
            w.WriteProperty("hasDelete", t.hasDelete);
            w.WriteProperty("menuEnabled", t.menuEnabled);
            w.WriteProperty("migrated", t.migrated);
            w.WriteProperty("generatedAt", t.generatedAt);
            w.WriteProperty("columns", cols);
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("设计表字段列表")]
    public async void Columns() {
        int tableId = this.InAnyInt("tableId", 0);
        SysGenTable t = await this.SysGenTable.ById(tableId);
        if (t == null) { this.Fail(404, "0404", "设计不存在"); return; }
        List<SysGenColumn> cols = await this.SysGenColumn
            .Where(a => a.tableId == tableId).OrderBy(a => a.sortOrder).ToListAsync();
        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            w.WriteStartObject();
            w.WriteProperty("id", c.id);
            w.WriteProperty("tableId", c.tableId);
            w.WriteProperty("name", c.name);
            w.WriteProperty("label", c.label);
            w.WriteProperty("kind", c.kind);
            w.WriteProperty("size", c.size);
            w.WriteProperty("widget", c.widget);
            w.WriteProperty("defValue", c.defValue);
            w.WriteProperty("dictType", c.dictType);
            w.WriteProperty("relTable", c.relTable);
            w.WriteProperty("relValue", c.relValue);
            w.WriteProperty("relLabel", c.relLabel);
            w.WriteProperty("filterOp", c.filterOp.Length > 0 ? c.filterOp : "auto");
            w.WriteProperty("listWidth", c.listWidth == null ? "" : c.listWidth);
            w.WriteProperty("tabGroup", c.tabGroup == null ? "" : c.tabGroup);
            w.WriteProperty("sortOrder", c.sortOrder);
            w.WriteProperty("nullable", c.nullable);
            w.WriteProperty("inList", c.inList);
            w.WriteProperty("inFilter", c.inFilter);
            w.WriteProperty("inCreate", c.inCreate);
            w.WriteProperty("inEdit", c.inEdit);
            w.WriteProperty("inQuick", c.inQuick);
            w.WriteProperty("required", c.required);
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存表信息")]
    public async void TableSave() {
        int id = this.InAnyInt("id", 0);
        if (!await this.Can(id > 0 ? (int)PermBit.Update : (int)PermBit.Create)) {
            this.Fail(403, "0403", "无操作权限"); return;
        }
        string tableName = this.NeedAny("tableName", "表名");
        string title = this.NeedAny("title", "名称");
        if (!Gen.Safe(tableName)) {
            this.Fail(400, "0004", "表名只能用小写字母、数字和下划线，且以字母开头"); return;
        }
        if (tableName.ToLower().StartsWith("sys_")) {
            this.Fail(400, "0004", "不能设计系统表"); return;
        }
        string entityName = this.InAny("entityName");
        if (entityName.Length == 0) { entityName = ColumnDraft.Pascal(tableName); }
        if (!Gen.SafeCode(entityName) || entityName == "RowView"
            || entityName == "AdminController" || entityName == "AppController"
            || entityName == "Gen") {
            this.Fail(400, "0004", "实体名不是安全的 Zan 类型名"); return;
        }
        string section = this.InAny("section");
        if (!Gen.Safe(section)) { section = "content"; }
        int api = FlagAny("apiEnabled");
        int export = FlagAny("exportEnabled");
        int hasCreate = FlagAny("hasCreate");
        int hasEdit = FlagAny("hasEdit");
        int hasDelete = FlagAny("hasDelete");
        int menuEnabled = FlagAny("menuEnabled");
        int pageSize = this.InAnyInt("pageSize", 20);
        if (pageSize <= 0) { pageSize = 20; }
        if (pageSize > 200) { pageSize = 200; }
        string labelColumn = this.InAny("labelColumn").Trim();
        if (labelColumn.Length > 0 && !Gen.SafeCode(labelColumn)) {
            this.Fail(400, "0004", "标签列不是安全的字段名"); return;
        }
        string orderColumn = this.InAny("orderColumn").Trim();
        if (orderColumn.Length == 0) { orderColumn = "id"; }
        if (orderColumn != "id" && !Gen.SafeCode(orderColumn)) {
            this.Fail(400, "0004", "排序列不是安全的字段名"); return;
        }
        int orderDesc = this.InAny("orderDesc") == "0" ? 0 : 1;
        string tabColumn = this.InAny("tabColumn").Trim();
        if (tabColumn.Length > 0 && !Gen.SafeCode(tabColumn)) {
            this.Fail(400, "0004", "页签列不是安全的字段名"); return;
        }
        string menuIcon = this.InAny("menuIcon").Trim();
        for (int i = 0; i < menuIcon.Length; i = i + 1) {
            string ch = menuIcon.Substring(i, 1);
            if ((ch < "a" || ch > "z") && (ch < "0" || ch > "9")
                && ch != "-" && ch != ":") {
                this.Fail(400, "0004", "图标名只能用小写字母、数字、冒号和横线"); return;
            }
        }
        if (menuIcon.Length > 32) { menuIcon = menuIcon.Substring(0, 32); }
        if (id > 0 && (orderColumn != "id" || tabColumn.Length > 0)) {
            List<SysGenColumn> cols = await this.SysGenColumn
                .Where(a => a.tableId == id).ToListAsync();
            if (orderColumn != "id") {
                bool colOk = false;
                for (int i = 0; i < cols.Count; i = i + 1) {
                    if (cols[i].name == orderColumn) { colOk = true; }
                }
                if (!colOk) { this.Fail(400, "0004", "排序列不存在"); return; }
            }
            if (tabColumn.Length > 0) {
                bool tabOk = false;
                for (int i = 0; i < cols.Count; i = i + 1) {
                    if (cols[i].name != tabColumn) { continue; }
                    if (cols[i].kind == "bool"
                        || (cols[i].dictType.Length > 0 && Gen.Safe(cols[i].dictType))) {
                        tabOk = true;
                    }
                }
                if (!tabOk) { this.Fail(400, "0004", "页签列须为字典列或布尔列"); return; }
            }
        }

        SysGenTable clash = await this.SysGenTable
            .Where(a => a.tableName == tableName).FirstAsync();
        if (clash != null && clash.id != id) {
            this.Fail(400, "0004", "表 " + tableName + " 已经设计过了"); return;
        }
        if (id > 0) {
            SysGenTable current = await this.SysGenTable.ById(id);
            if (current == null) { this.Fail(404, "0404", "设计不存在"); return; }
            if (current.migrated == 1 && current.tableName != tableName) {
                this.Fail(409, "0004", "已建表不能更改表名"); return;
            }
            int n = await this.SysGenTable.Update()
                .Set(a => a.tableName, tableName)
                .Set(a => a.entityName, entityName)
                .Set(a => a.title, title)
                .Set(a => a.section, section)
                .Set(a => a.pageSize, pageSize)
                .Set(a => a.orderColumn, orderColumn)
                .Set(a => a.orderDesc, orderDesc)
                .Set(a => a.labelColumn, labelColumn)
                .Set(a => a.menuIcon, menuIcon)
                .Set(a => a.tabColumn, tabColumn)
                .Set(a => a.exportEnabled, export)
                .Set(a => a.apiEnabled, api)
                .Set(a => a.hasCreate, hasCreate)
                .Set(a => a.hasEdit, hasEdit)
                .Set(a => a.hasDelete, hasDelete)
                .Set(a => a.menuEnabled, menuEnabled)
                .Set(a => a.updatedAt, WebApp.NowSeconds())
                .Where(a => a.id == id).ExecuteAffrowsAsync();
            await this.Note("编辑表设计", tableName, n > 0, "");
            this.Saved("表信息已保存");
            return;
        }
        SysGenTable t = new SysGenTable();
        t.tableName = tableName;
        t.entityName = entityName;
        t.title = title;
        t.section = section;
        t.orderColumn = orderColumn;
        t.orderDesc = orderDesc;
        t.pageSize = pageSize;
        t.labelColumn = labelColumn;
        t.menuIcon = menuIcon;
        t.tabColumn = tabColumn;
        t.exportEnabled = export;
        t.apiEnabled = api;
        t.hasCreate = hasCreate;
        t.hasEdit = hasEdit;
        t.hasDelete = hasDelete;
        t.menuEnabled = menuEnabled;
        t.migrated = 0;
        t.createdAt = WebApp.NowSeconds();
        t.updatedAt = t.createdAt;
        int newId = await this.SysGenTable.Insert(t).ExecuteIdentityAsync();
        await this.Note("新建表设计", tableName, newId > 0, "");
        this.Saved("表已创建，去添加字段");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除表设计")]
    public async void TableDelete() {
        int id = this.InAnyInt("id", 0);
        SysGenTable t = await this.SysGenTable.ById(id);
        if (t == null) { this.Fail(404, "0404", "设计不存在"); return; }
        int n = await this.SysGenTable.Delete().Where(a => a.id == id)
            .ExecuteAffrowsAsync();
        int _c = await this.SysGenColumn.Delete().Where(a => a.tableId == id)
            .ExecuteAffrowsAsync();
        await this.Note("删除表设计", t.tableName, n > 0,
            "物理表保留");
        this.Saved("设计已删除，数据库中的表保留");
    }

    private int FlagAny(string name) {
        string v = this.InAny(name).Trim().ToLower();
        if (v == "1" || v == "true" || v == "on") { return 1; }
        return 0;
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存字段")]
    public async void ColumnSave() {
        int id = this.InAnyInt("id", 0);
        if (!await this.Can(id > 0 ? (int)PermBit.Update : (int)PermBit.Create)) {
            this.Fail(403, "0403", "无操作权限"); return;
        }
        int tableId = this.InAnyInt("tableId", 0);
        string name = this.NeedAny("name", "字段名");
        if (!Gen.SafeCode(name)) {
            this.Fail(400, "0004", "字段名不是安全的 Zan 字段名"); return;
        }
        string kind = this.InAny("kind");
        if (kind.Length == 0) { kind = "string"; }
        if (!ColumnDraft.InList(kind, "string,text,int,long,decimal,bool,datetime")) {
            this.Fail(400, "0004", "不支持的存储类型"); return;
        }
        if (tableId <= 0 || await this.SysGenTable.ById(tableId) == null) {
            this.Fail(404, "0404", "设计不存在"); return;
        }
        SysGenColumn clash = await this.SysGenColumn
            .Where(a => a.tableId == tableId).Where(a => a.name == name).FirstAsync();
        if (clash != null && clash.id != id) {
            this.Fail(400, "0004", "字段 " + name + " 已存在"); return;
        }
        string relTable = this.InAny("relTable");
        if (relTable.Length > 0 && !Gen.Safe(relTable)) {
            this.Fail(400, "0004", "关联表名不合法"); return;
        }
        string relValue = this.InAny("relValue");
        string relLabel = this.InAny("relLabel");
        if (relTable.Length > 0) {
            if (relValue.Length == 0) { relValue = "id"; }
            if (relLabel.Length == 0) { relLabel = "name"; }
            if (!Gen.Safe(relValue) || !Gen.Safe(relLabel)) {
                this.Fail(400, "0004", "关联字段名不合法"); return;
            }
        }
        string filterOp = this.InAny("filterOp");
        if (filterOp.Length == 0) { filterOp = "auto"; }
        if (!ColumnDraft.InList(filterOp, "auto,like,eq,select,range")) {
            this.Fail(400, "0004", "不支持的筛选算子"); return;
        }
        string listWidth = ColumnDraft.Clip(this.InAny("listWidth").Trim(), 16);
        if (listWidth.Length > 0 && Gen.WidthOf(listWidth).Length == 0) {
            this.Fail(400, "0004", "列宽只支持「数字+px/em/%」形态（如 140px）"); return;
        }
        string tabGroup = ColumnDraft.Clip(this.InAny("tabGroup").Trim(), 16);

        SysGenColumn c = new SysGenColumn();
        if (id > 0) {
            SysGenColumn cur = await this.SysGenColumn.ById(id);
            if (cur == null || cur.tableId != tableId) {
                this.Fail(404, "0404", "字段不存在"); return;
            }
            c = cur;
        }
        c.tableId = tableId;
        c.name = name;
        c.kind = kind;
        c.size = this.InAnyInt("size", 255);
        if (c.size < 0 || c.size > 4000) { this.Fail(400, "0004", "字段长度不合法"); return; }
        c.defValue = this.InAny("defValue");
        c.label = this.InAny("label");
        c.widget = this.InAny("widget");
        if (c.widget.Length == 0) { c.widget = "text"; }
        if (!ColumnDraft.InList(c.widget,
                "text,textarea,number,select,switch,date,richtext,upload")) {
            this.Fail(400, "0004", "不支持的控件"); return;
        }
        c.dictType = this.InAny("dictType");
        c.relTable = relTable;
        c.relValue = relValue;
        c.relLabel = relLabel;
        c.filterOp = filterOp;
        c.listWidth = listWidth;
        c.tabGroup = tabGroup;
        c.sortOrder = this.InAnyInt("sortOrder", 10);
        c.nullable = FlagAny("nullable");
        c.inList = FlagAny("inList");
        c.inFilter = FlagAny("inFilter");
        c.inCreate = FlagAny("inCreate");
        c.inEdit = FlagAny("inEdit");
        c.inQuick = FlagAny("inQuick");
        c.required = FlagAny("required");

        if (id > 0) {
            int n = await this.SysGenColumn.Update()
                .Set(a => a.name, c.name)
                .Set(a => a.kind, c.kind)
                .Set(a => a.size, c.size)
                .Set(a => a.defValue, c.defValue)
                .Set(a => a.label, c.label)
                .Set(a => a.widget, c.widget)
                .Set(a => a.dictType, c.dictType)
                .Set(a => a.relTable, c.relTable)
                .Set(a => a.relValue, c.relValue)
                .Set(a => a.relLabel, c.relLabel)
                .Set(a => a.filterOp, c.filterOp)
                .Set(a => a.listWidth, c.listWidth)
                .Set(a => a.tabGroup, c.tabGroup)
                .Set(a => a.sortOrder, c.sortOrder)
                .Set(a => a.nullable, c.nullable)
                .Set(a => a.inList, c.inList)
                .Set(a => a.inFilter, c.inFilter)
                .Set(a => a.inCreate, c.inCreate)
                .Set(a => a.inEdit, c.inEdit)
                .Set(a => a.inQuick, c.inQuick)
                .Set(a => a.required, c.required)
                .Where(a => a.id == id).ExecuteAffrowsAsync();
            await this.Note("编辑字段", name, n > 0, "");
            this.Saved("字段已保存");
            return;
        }
        int newId = await this.SysGenColumn.Insert(c).ExecuteIdentityAsync();
        await this.Note("新增字段", name, newId > 0, "");
        this.Saved("字段已添加");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除字段")]
    public async void ColumnDelete() {
        int id = this.InAnyInt("id", 0);
        SysGenColumn c = await this.SysGenColumn.ById(id);
        if (c == null) { this.Fail(404, "0404", "字段不存在"); return; }
        int n = await this.SysGenColumn.Delete().Where(a => a.id == id)
            .ExecuteAffrowsAsync();
        await this.Note("删除字段", c.name, n > 0,
            "数据库中的列保留");
        this.Saved("字段已从设计中移除，数据库中的列保留");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("字段行内修改")]
    public async void ColumnField() {
        int id = this.InAnyInt("id", 0);
        string field = this.NeedAny("field", "属性");
        string value = this.InAny("value");
        SysGenColumn c = await this.SysGenColumn.ById(id);
        if (c == null) { this.Fail(404, "0404", "字段不存在"); return; }

        if (field == "label") {
            string label = ColumnDraft.Clip(value, 64);
            if (label.Length == 0) { label = c.name; }
            int n = await this.SysGenColumn.Update()
                .Set(a => a.label, label)
                .Where(a => a.id == id).ExecuteAffrowsAsync();
            await this.Note("编辑字段", c.name, n > 0, "label=" + label);
            this.Ok("{}");
            return;
        }
        if (field == "sortOrder") {
            int sort = this.InAnyInt("value", c.sortOrder);
            if (sort < 0) { sort = 0; }
            if (sort > 9999999) { sort = 9999999; }
            int n = await this.SysGenColumn.Update()
                .Set(a => a.sortOrder, sort)
                .Where(a => a.id == id).ExecuteAffrowsAsync();
            await this.Note("编辑字段", c.name, n > 0,
                "sortOrder=" + Convert.ToString(sort));
            this.Ok("{}");
            return;
        }
        if (field == "kind") {
            if (!ColumnDraft.InList(value, "string,text,int,long,decimal,bool,datetime")) {
                this.Fail(400, "0004", "不支持的存储类型"); return;
            }
            int n = await this.SysGenColumn.Update()
                .Set(a => a.kind, value)
                .Where(a => a.id == id).ExecuteAffrowsAsync();
            await this.Note("编辑字段", c.name, n > 0, "kind=" + value);
            this.Ok("{}");
            return;
        }
        if (field == "widget") {
            if (!ColumnDraft.InList(value,
                    "text,textarea,number,select,switch,date,richtext,upload")) {
                this.Fail(400, "0004", "不支持的控件"); return;
            }
            int n = await this.SysGenColumn.Update()
                .Set(a => a.widget, value)
                .Where(a => a.id == id).ExecuteAffrowsAsync();
            await this.Note("编辑字段", c.name, n > 0, "widget=" + value);
            this.Ok("{}");
            return;
        }
        if (field == "filterOp") {
            if (!ColumnDraft.InList(value, "auto,like,eq,select,range")) {
                this.Fail(400, "0004", "不支持的筛选算子"); return;
            }
            int n = await this.SysGenColumn.Update()
                .Set(a => a.filterOp, value)
                .Where(a => a.id == id).ExecuteAffrowsAsync();
            await this.Note("编辑字段", c.name, n > 0, "filterOp=" + value);
            this.Ok("{}");
            return;
        }
        if (field == "tabGroup") {
            string g = ColumnDraft.Clip(value.Trim(), 16);
            int n = await this.SysGenColumn.Update()
                .Set(a => a.tabGroup, g)
                .Where(a => a.id == id).ExecuteAffrowsAsync();
            await this.Note("编辑字段", c.name, n > 0, "tabGroup=" + g);
            this.Ok("{}");
            return;
        }
        if (field == "inList" || field == "inFilter" || field == "inCreate"
            || field == "inEdit" || field == "inQuick" || field == "required"
            || field == "nullable") {
            int v = (value == "1" || value == "true" || value == "on") ? 1 : 0;
            int n = 0;
            if (field == "inList") {
                n = await this.SysGenColumn.Update().Set(a => a.inList, v)
                    .Where(a => a.id == id).ExecuteAffrowsAsync();
            } else if (field == "inFilter") {
                n = await this.SysGenColumn.Update().Set(a => a.inFilter, v)
                    .Where(a => a.id == id).ExecuteAffrowsAsync();
            } else if (field == "inCreate") {
                n = await this.SysGenColumn.Update().Set(a => a.inCreate, v)
                    .Where(a => a.id == id).ExecuteAffrowsAsync();
            } else if (field == "inEdit") {
                n = await this.SysGenColumn.Update().Set(a => a.inEdit, v)
                    .Where(a => a.id == id).ExecuteAffrowsAsync();
            } else if (field == "inQuick") {
                n = await this.SysGenColumn.Update().Set(a => a.inQuick, v)
                    .Where(a => a.id == id).ExecuteAffrowsAsync();
            } else if (field == "required") {
                n = await this.SysGenColumn.Update().Set(a => a.required, v)
                    .Where(a => a.id == id).ExecuteAffrowsAsync();
            } else {
                n = await this.SysGenColumn.Update().Set(a => a.nullable, v)
                    .Where(a => a.id == id).ExecuteAffrowsAsync();
            }
            await this.Note("编辑字段", c.name, n > 0,
                field + "=" + Convert.ToString(v));
            this.Ok("{}");
            return;
        }
        this.Fail(400, "0004", "不支持行内修改的属性");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("AI 生成字段设计")]
    public async void AiDesign() {
        int tableId = this.InAnyInt("tableId", 0);
        string desc = this.NeedAny("desc", "业务描述");
        SysGenTable t = await this.SysGenTable.ById(tableId);
        if (t == null) { this.Fail(404, "0404", "设计不存在"); return; }
        if (!await Ai.Ready()) { this.Fail(400, "0005", "尚未配置 AI 服务"); return; }
        if (desc.Length > 2000) { desc = desc.Substring(0, 2000); }

        List<SysGenColumn> cols = await this.SysGenColumn
            .Where(a => a.tableId == tableId).OrderBy(a => a.sortOrder)
            .ToListAsync();
        List<SysDictType> dicts = await this.SysDictType
            .Where(a => a.status == 1).ToListAsync();
        List<SysGenTable> tables = await this.SysGenTable.OrderBy(a => a.id)
            .ToListAsync();

        AiReply r = await Ai.CompleteRaw(DesignPrompt(),
            DesignAsk(t, desc, cols, dicts, tables));
        if (!r.ok) { this.Fail(400, "0005", r.text); return; }
        JsonDoc root = DesignJson(r.text);
        if (root == null || root.KindAt(root.root) != 5) {
            this.Fail(400, "0005", "AI 返回的内容无法解析为字段设计，请重试或换个描述"); return;
        }
        int colsArr = root.Get("columns");
        if (colsArr < 0 || root.KindAt(colsArr) != 4) {
            this.Fail(400, "0005", "AI 返回的内容无法解析为字段设计，请重试或换个描述"); return;
        }
        ColumnDraft draft = ColumnDraft.Sanitize(root, colsArr, cols, tables);
        if (draft.cols.Count == 0) {
            this.Fail(400, "0005", "AI 给出的字段全部无效（重名或类型不合法），请换个描述再试"); return;
        }

        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WritePropertyName("columns");
        w.WriteStartArray();
        for (int i = 0; i < draft.cols.Count; i = i + 1) {
            ColumnDraft.WriteColumn(w, draft.cols[i]);
        }
        w.WriteEndArray();
        w.WriteProperty("dropped", (long)draft.dropped);
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("应用 AI 字段设计")]
    public async void AiApply() {
        int tableId = this.InAnyInt("tableId", 0);
        string listJson = this.NeedAny("columns", "字段清单");
        SysGenTable t = await this.SysGenTable.ById(tableId);
        if (t == null) { this.Fail(404, "0404", "设计不存在"); return; }
        List<SysGenColumn> cols = await this.SysGenColumn
            .Where(a => a.tableId == tableId).OrderBy(a => a.sortOrder)
            .ToListAsync();
        List<SysGenTable> tables = await this.SysGenTable.OrderBy(a => a.id)
            .ToListAsync();
        JsonDoc arrDoc = JsonDoc.Parse(listJson);
        if (arrDoc == null || arrDoc.KindAt(arrDoc.root) != 4) {
            this.Fail(400, "0004", "字段清单无法解析"); return;
        }
        ColumnDraft draft = ColumnDraft.Sanitize(arrDoc, arrDoc.root, cols, tables);
        if (draft.cols.Count == 0) {
            this.Fail(400, "0004", "没有可应用的有效字段"); return;
        }

        int sort = 10;
        for (int i = 0; i < cols.Count; i = i + 1) {
            if (cols[i].sortOrder >= sort) { sort = cols[i].sortOrder + 10; }
        }
        int added = 0;
        for (int i = 0; i < draft.cols.Count; i = i + 1) {
            SysGenColumn c = draft.cols[i];
            c.tableId = tableId;
            c.sortOrder = sort;
            sort = sort + 10;
            int _id = await this.SysGenColumn.Insert(c).ExecuteIdentityAsync();
            added = added + 1;
        }
        await this.Note("AI 生成字段", t.tableName, added > 0,
            Convert.ToString(added) + " 个字段"
            + (draft.dropped > 0 ? "，丢弃 " + Convert.ToString(draft.dropped) : ""));
        this.Saved("已应用 " + Convert.ToString(added)
            + " 个字段，记得「同步数据库」建列");
    }

    /* 将设计应用到数据库：创建表，或补其缺失列。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("同步到数据库")]
    public async void Migrate() {
        int id = this.InAnyInt("id", 0);
        SysGenTable t = await this.SysGenTable.ById(id);
        if (t == null) { this.Fail(404, "0404", "设计不存在"); return; }
        List<SysGenColumn> cols = await this.SysGenColumn
            .Where(a => a.tableId == id).OrderBy(a => a.sortOrder).ToListAsync();
        if (cols.Count == 0) { this.Fail(400, "0004", "先添加字段"); return; }
        if (!Gen.Valid(t, cols)) { this.Fail(400, "0004", "表或字段设计不合法"); return; }
        IDbConnection db = await this.Conn();
        if (db == null) { this.Fail(503, "2001", "数据库不可用"); return; }
        if (t.migrated != 1 && await DbSchema.TableExistsAsync(db, t.tableName)) {
            this.Fail(409, "0004", "数据库中已存在同名表，不能由设计器接管"); return;
        }

        int changed = await Gen.Migrate(db, t, cols);
        int _u = await this.SysGenTable.Update()
            .Set(a => a.migrated, 1)
            .Set(a => a.updatedAt, WebApp.NowSeconds())
            .Where(a => a.id == id).ExecuteAffrowsAsync();
        await this.Note("同步表结构", t.tableName, true,
            Convert.ToString(changed) + " 列");
        this.Saved("已同步到数据库，可以在「数据管理」里维护数据了");
    }

    /* 写出生成源码；须重建后生效。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("生成代码")]
    public async void Build() {
        int id = this.InAnyInt("id", 0);
        int force = this.InAnyInt("force", 0);
        SysGenTable t = await this.SysGenTable.ById(id);
        if (t == null) { this.Fail(404, "0404", "设计不存在"); }
        List<SysGenColumn> cols = await this.SysGenColumn
            .Where(a => a.tableId == id).OrderBy(a => a.sortOrder).ToListAsync();
        if (cols.Count == 0) { this.Fail(400, "0004", "先添加字段"); }
        if (!Gen.Valid(t, cols)) { this.Fail(400, "0004", "表或字段设计不合法"); }
        /* 关联下拉/远程筛选只对设计器里真实存在的表喂数；把设计行原样传给
           生成器（Pick 需要关联表的路由）。 */
        List<SysGenTable> tabs = await this.SysGenTable.OrderBy(a => a.id).ToListAsync();

        /* gen.root 相对当前服务工作目录解释（开发时从 build/ 运行，".." 即项目根）；
           生产发布目录没有 src 布局，必须在站点设置里配置真实源码根目录。 */
        string root = (await Settings.Get(SettingKeys.GenRoot, "..")).Trim();
        if (root.Length == 0) {
            this.Fail(400, "0004", "未配置源码目录，请在站点设置的「开发」中填写 gen.root");
            return;
        }
        if (!Directory.ExistsOnDisk(root + "/src")) {
            this.Fail(400, "0004", "gen.root 不是应用源码根目录（需要已有 src 目录）："
                + root + "；请在站点设置的「开发」中配置");
            return;
        }
        try {
            Directory.CreateDirectoryRecursive(root + "/src/Model/Gen");
            Directory.CreateDirectoryRecursive(root + "/src/Controller/Admin");
            if (t.apiEnabled == 1) { Directory.CreateDirectoryRecursive(root + "/src/Controller/Api"); }
            Directory.CreateDirectoryRecursive(root + "/src/Dao/Gen");
        } catch (Exception ex) {
            this.Fail(500, "2001", "无法创建源码目录（gen.root=" + root + "）：" + ex.Message);
            return;
        }
        List<string> paths = TargetPaths(t, root);
        for (int i = 0; i < paths.Count; i = i + 1) {
            if (force == 0 && (File.Exists(paths[i]) || Directory.ExistsOnDisk(paths[i]))) {
                this.Fail(409, "0004", "生成目标已存在：" + paths[i]
                    + "；如需覆盖请在字段设计页用「覆盖重新生成」");
                return;
            }
        }
        List<string> sources = SourceList(t, cols, tabs);
        try {
            WriteSources(paths, sources, force == 1);
        } catch (Exception ex) {
            this.Fail(500, "2001", "生成文件失败（gen.root=" + root + "）：" + ex.Message);
            return;
        }

        /* 生成文件尚未编译部署，通用数据入口仍须保留。 */
        await this.Note("生成代码", t.tableName, true, paths[1]);
        this.Saved("已生成 " + Convert.ToString(paths.Count) + " 个文件到 " + root
            + "（" + FileMix(t) + "），"
            + "请将源码纳入工程并重新编译后生效");
    }

    /* 生成源码清单（纯 AdminUI JSON 架构），顺序与 TargetPaths 一一对应：
       模型/后台控制器/Dao 恒有；apiEnabled=1 加 JSON 接口。 */
    static List<string> SourceList(SysGenTable t, List<SysGenColumn> cols,
        List<SysGenTable> designed) {
        List<string> sources = new List<string>();
        sources.Add(Gen.ModelSource(t, cols));
        sources.Add(Gen.ControllerSource(t, cols, designed));
        sources.Add(Gen.DaoSource(t, cols));
        if (t.apiEnabled == 1) { sources.Add(Gen.ApiSource(t, cols, designed)); }
        return sources;
    }

    /* 文件构成说明（保存消息用）。 */
    private static string FileMix(SysGenTable t) {
        string mix = "模型/后台控制器/Dao";
        if (t.apiEnabled == 1) { mix = mix + "/JSON接口"; }
        return mix;
    }

    /* Directory=URL 前缀，file=class+Controller=route 段落，生成表与手写表同构。 */
    public static List<string> TargetPaths(SysGenTable t, string root) {
        List<string> paths = new List<string>();
        paths.Add(root + "/src/Model/Gen/" + t.entityName + ".zan");
        paths.Add(root + "/src/Controller/Admin/" + t.entityName + "Controller.zan");
        paths.Add(root + "/src/Dao/Gen/" + t.entityName + "Dao.zan");
        if (t.apiEnabled == 1) {
            paths.Add(root + "/src/Controller/Api/" + t.entityName + "ApiController.zan");
        }
        return paths;
    }

    /* 先写同目录临时文件，再用硬链接独占发布；普通 rename 在部分平台
       会覆盖并发创建的目标，不能用于这里的拒绝覆盖契约。force 时目标
       先删后链——「覆盖重新生成」是显式确认过的人工动作，可接受窗口期。 */
    public static void WriteSources(List<string> paths, List<string> sources, bool force) {
        if (paths.Count != sources.Count) { throw new Exception("生成文件数不一致"); }
        string token = Hex.Encode(RandomNumberGenerator.GetBytes(16), 16);
        List<string> staged = new List<string>();
        List<string> published = new List<string>();
        try {
            for (int i = 0; i < paths.Count; i = i + 1) {
                if (!force && (File.Exists(paths[i]) || Directory.ExistsOnDisk(paths[i]))) {
                    throw new Exception("生成目标已存在：" + paths[i]);
                }
                string tmp = paths[i] + "." + token + ".tmp";
                staged.Add(tmp);
                File.WriteAllText(tmp, sources[i]);
            }
            for (int i = 0; i < paths.Count; i = i + 1) {
                if (!force && (File.Exists(paths[i]) || Directory.ExistsOnDisk(paths[i]))) {
                    throw new Exception("生成目标已存在：" + paths[i]);
                }
                if (force && File.Exists(paths[i])) { File.Delete(paths[i]); }
                if (!File.CreateHardLink(paths[i], staged[i])) {
                    throw new Exception("目标已存在或发布生成文件失败：" + paths[i]);
                }
                published.Add(paths[i]);
                File.Delete(staged[i]);
            }
        } catch (Exception ex) {
            for (int i = 0; i < staged.Count; i = i + 1) {
                if (File.Exists(staged[i])) { File.Delete(staged[i]); }
            }
            for (int i = 0; i < published.Count; i = i + 1) {
                if (File.Exists(published[i])) { File.Delete(published[i]); }
            }
            throw ex;
        }
    }

    /* 写出前预览设计将产生的源码（纯 JSON）。 */
    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("预览生成代码")]
    public async void Preview() {
        int id = this.InAnyInt("id", 0);
        SysGenTable t = await this.SysGenTable.ById(id);
        if (t == null) { this.Fail(404, "0404", "设计不存在"); return; }
        List<SysGenColumn> cols = await this.SysGenColumn
            .Where(a => a.tableId == id).OrderBy(a => a.sortOrder).ToListAsync();
        List<SysGenTable> tabs = await this.SysGenTable.OrderBy(a => a.id).ToListAsync();
        List<string> sources = SourceList(t, cols, tabs);
        string existsNote = "";
        string root = (await Settings.Get(SettingKeys.GenRoot, "..")).Trim();
        if (root.Length > 0 && Directory.ExistsOnDisk(root + "/src")) {
            List<string> paths = TargetPaths(t, root);
            int existN = 0;
            for (int i = 0; i < paths.Count; i = i + 1) {
                if (File.Exists(paths[i])) { existN = existN + 1; }
            }
            if (existN > 0) {
                existsNote = "已有 " + Convert.ToString(existN) + "/"
                    + Convert.ToString(paths.Count)
                    + " 个目标文件存在；默认拒绝覆盖，可在工作台用「覆盖重新生成」";
            }
        }

        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("tableName", t.tableName);
        w.WriteProperty("existsNote", existsNote);
        w.WritePropertyName("files");
        w.WriteStartArray();
        WritePreviewFile(w, "Model (" + t.entityName + ".zan)", sources[0]);
        WritePreviewFile(w, "Controller (" + t.entityName + "Controller.zan)", sources[1]);
        WritePreviewFile(w, "Dao (" + t.entityName + "Dao.zan)", sources[2]);
        if (t.apiEnabled == 1 && sources.Count > 3) {
            WritePreviewFile(w, "Api (" + t.entityName + "ApiController.zan)", sources[3]);
        }
        w.WriteEndArray();
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    private static void WritePreviewFile(JsonWriter w, string name, string content) {
        w.WriteStartObject();
        w.WriteProperty("name", name);
        w.WriteProperty("content", content);
        w.WriteEndObject();
    }

    /* 人工确认生成模块已编译部署后置位 generatedAt：通用数据入口随 IsMenu 隐藏；再点一次恢复。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("标记生成模块接管")]
    public async void Own() {
        int id = this.InAnyInt("id", 0);
        SysGenTable t = await this.SysGenTable.ById(id);
        if (t == null) { this.Fail(404, "0404", "设计不存在"); return; }
        int next = t.generatedAt > 0 ? 0 : WebApp.NowSeconds();
        await this.SysGenTable.Update()
            .Set(a => a.generatedAt, next)
            .Set(a => a.updatedAt, WebApp.NowSeconds())
            .Where(a => a.id == id).ExecuteAffrowsAsync();
        await this.Note(next > 0 ? "标记生成模块已接管" : "取消接管生成模块",
            t.tableName, true, "");
        this.Saved(next > 0 ? "已标记接管，通用数据入口将隐藏" : "已恢复通用数据入口");
    }

    /* 字段设计任务的系统提示词：严格 JSON 契约 + 控件配型规则。 */
    private static string DesignPrompt() {
        return "你是 ZanWeb 表设计器的字段设计助手。根据业务描述为一张表设计字段，"
            + "只输出一个 JSON 对象，不要解释、不要 Markdown 代码块，格式："
            + "{\"columns\":[{\"name\":\"field_name\",\"label\":\"中文名\","
            + "\"kind\":\"string\",\"size\":255,\"widget\":\"text\","
            + "\"required\":1,\"nullable\":0,\"inList\":1,\"inFilter\":0,"
            + "\"inCreate\":1,\"inEdit\":1,\"defValue\":\"\",\"sortOrder\":10,"
            + "\"dictType\":\"\",\"relTable\":\"\",\"relValue\":\"\",\"relLabel\":\"\"}]}。"
            + "规则：name 用小写下划线，不与已有字段重复；kind 只能是 string/text/"
            + "int/long/decimal/bool/datetime；widget 只能是 text/textarea/number/"
            + "select/switch/date/richtext/upload；bool 配 switch，text 配 textarea，"
            + "int/long/decimal 配 number，datetime 配 date；枚举字段配 select 并填"
            + " dictType（只能用给出的字典类型码），引用其他表配 select 并填 relTable"
            + "（只能用给出的表名）与 relValue=id、relLabel=name；label 用简短中文；"
            + "sortOrder 按 10 递增，重要字段在前；不加主键 id 与 created_at/"
            + "updated_at（系统自动处理）；字段数量适中（8~15 个）。";
    }

    /* 用户消息：表 + 已有字段（防重复）+ 字典/表取值范围 + 业务描述。 */
    static string DesignAsk(SysGenTable t, string desc, List<SysGenColumn> cols,
                            List<SysDictType> dicts, List<SysGenTable> tables) {
        StringBuilder sb = new StringBuilder();
        sb.Append("表：");
        sb.Append(t.tableName);
        sb.Append("（");
        sb.Append(t.title);
        sb.Append("）\n");
        if (cols.Count > 0) {
            sb.Append("已有字段（不要重复，可在其基础上扩展）：");
            for (int i = 0; i < cols.Count; i = i + 1) {
                if (i > 0) { sb.Append(", "); }
                sb.Append(cols[i].name);
                sb.Append("(");
                sb.Append(cols[i].kind);
                sb.Append(")");
            }
            sb.Append("\n");
        }
        if (dicts.Count > 0) {
            sb.Append("可用字典类型：");
            for (int i = 0; i < dicts.Count; i = i + 1) {
                if (i > 0) { sb.Append(", "); }
                sb.Append(dicts[i].code);
                sb.Append("(");
                sb.Append(dicts[i].name);
                sb.Append(")");
            }
            sb.Append("\n");
        }
        if (tables.Count > 0) {
            sb.Append("可关联表：");
            for (int i = 0; i < tables.Count; i = i + 1) {
                if (i > 0) { sb.Append(", "); }
                sb.Append(tables[i].tableName);
                sb.Append("(");
                sb.Append(tables[i].title);
                sb.Append(")");
            }
            sb.Append("\n");
        }
        sb.Append("业务描述：");
        sb.Append(desc);
        return sb.ToString();
    }

    /* 模型答语 → JSON 对象：剥掉可能的代码围栏与前后闲话，取首个 { 到末个 }。 */
    private static JsonDoc DesignJson(string raw) {
        int a = raw.IndexOf("{");
        int b = raw.LastIndexOf("}");
        if (a < 0 || b <= a) { return null; }
        return JsonDoc.Parse(raw.Substring(a, b - a + 1));
    }
}

