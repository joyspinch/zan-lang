using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model;

namespace Zan.Web.Dao;

/* sys_gen_column 的数据读写网关 */
public class SysGenColumnDao : BaseRepository<SysGenColumn> {
    public SysGenColumnDao() : base() {}
    public SysGenColumnDao(IZanSql fsql) : base(fsql) {}
    public SysGenColumnDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async SysGenColumn ById(int id) {
        return await this.GetExecutor().Select<SysGenColumn>()
            .Where(a => a.id == id)
            .FirstAsync();
    }

    public async List<SysGenColumn> ByTableId(int tableId) {
        return await this.GetExecutor().Select<SysGenColumn>()
            .Where(a => a.tableId == tableId)
            .OrderBy(a => a.sortOrder)
            .ToListAsync();
    }

    public InsertQuery<SysGenColumn> Insert(SysGenColumn col) {
        return this.GetExecutor().Insert<SysGenColumn>(col);
    }

    public InsertQuery<SysGenColumn> Insert() {
        return this.GetExecutor().Insert<SysGenColumn>();
    }

    public UpdateQuery<SysGenColumn> Update() {
        return this.GetExecutor().Update<SysGenColumn>();
    }

    public DeleteQuery<SysGenColumn> Delete() {
        return this.GetExecutor().Delete<SysGenColumn>();
    }

    public async int DeleteByTableId(int tableId) {
        return await this.GetExecutor().Delete<SysGenColumn>().Where(a => a.tableId == tableId).ExecuteAffrowsAsync();
    }
}
