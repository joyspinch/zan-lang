using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model;

namespace Zan.Web.Dao;

/* sys_gen_table 的数据读写网关 */
public class SysGenTableDao : BaseRepository<SysGenTable> {
    public SysGenTableDao() : base() {}
    public SysGenTableDao(IZanSql fsql) : base(fsql) {}
    public SysGenTableDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async SysGenTable ById(int id) {
        return await this.GetExecutor().Select<SysGenTable>().Where(a => a.id == id).FirstAsync();
    }

    public async SysGenTable ByTableName(string tableName) {
        return await this.GetExecutor().Select<SysGenTable>().Where(a => a.tableName == tableName).FirstAsync();
    }

    public async List<SysGenTable> All() {
        return await this.GetExecutor().Select<SysGenTable>().OrderBy(a => a.id).ToListAsync();
    }

    public async List<SysGenTable> AllMigrated() {
        return await this.GetExecutor().Select<SysGenTable>().Where(a => a.migrated == 1).ToListAsync();
    }

    public InsertQuery<SysGenTable> Insert(SysGenTable table) {
        return this.GetExecutor().Insert<SysGenTable>(table);
    }

    public InsertQuery<SysGenTable> Insert() {
        return this.GetExecutor().Insert<SysGenTable>();
    }

    public UpdateQuery<SysGenTable> Update() {
        return this.GetExecutor().Update<SysGenTable>();
    }

    public async int Update(SysGenTable table) {
        return await this.GetExecutor().Update<SysGenTable>()
            .Set(a => a.tableName, table.tableName)
            .Set(a => a.entityName, table.entityName)
            .Set(a => a.title, table.title)
            .Set(a => a.section, table.section)
            .Set(a => a.orderColumn, table.orderColumn)
            .Set(a => a.migrated, table.migrated)
            .Where(a => a.id == table.id)
            .ExecuteAffrowsAsync();
    }

    public DeleteQuery<SysGenTable> Delete() {
        return this.GetExecutor().Delete<SysGenTable>();
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<SysGenTable>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
