using System;
using Zan.Web.Core;
using Zan.Web.Services;
using System.Web;

namespace Zan.Web.Index;

/* 企业品牌官网首页：全站白标配置由 Settings 驱动（站点名称、副标题、简介、Logo、主按钮、备案与联系方式），
   支持每家企业部署后直接在后台「站点设置」完成品牌化；通用基座与业务模板通过各自视图展示差异化业务能力。 */
[Description("首页")]
public class IndexController : Controller {
    [HttpGet]
    [Route("/")]
    [Description("首页")]
    public async void Index() {
        ViewData d = new ViewData();
        await Settings.Apply(d);

        string siteTitle = d.Vars().Get("siteTitle");
        if (siteTitle.Length == 0) { siteTitle = "ZanWeb 企业平台"; }
        string subtitle = d.Vars().Get("siteSubtitle");
        if (subtitle.Length == 0) { subtitle = "安全、敏捷的新一代企业数字化管理底座"; }
        string heroDesc = d.Vars().Get("siteDescription");
        if (heroDesc.Length == 0) {
            heroDesc = "集组织权限管控、实时业务可观测、低代码扩展与高可用原生部署于一体的商业级管理平台，助力企业快速上线自有品牌数字系统。";
        }

        d.Set("title", siteTitle + " — " + subtitle);
        d.Set("navHome", "page");
        d.Set("tagline", subtitle);
        d.Set("heroDesc", heroDesc);

        List<StrMap> metrics = d.AddList("metrics");
        Metric(metrics, "99.99%", "高可用集群保障");
        Metric(metrics, "< 2 ms", "原生编译路由响应");
        Metric(metrics, "RBAC + 范围", "部门与行级数据隔离");
        Metric(metrics, "0 外部依赖", "单二进制独立交付");

        List<StrMap> caps = d.AddList("capabilities");
        Cap(caps, "span2", "IAM / 组织权限",
            "组织架构与细粒度权限矩阵",
            "内置部门树、多角色组合、动作级权限位（查看/新增/编辑/删除/导出）与 DataScope 行级数据范围隔离，严格满足大型团队分权治理。",
            "RBAC · DataScope · 部门数据隔离");
        Cap(caps, "", "OBSERVABILITY",
            "实时可观测与慢 SQL 诊断",
            "无需接入第三方探针即可实时观测 QPS、错误率、P99 链路耗时与归一化 SQL 模板热点。",
            "Route Trace · SQL Monitor");
        Cap(caps, "", "LOW-CODE",
            "可视化建模与代码生成",
            "在线设计数据表与表单联动规则，一键生成控制器、DAO 与标准化 CRUD 管理屏。",
            "Schema Designer · Gen Engine");
        Cap(caps, "span2", "COMPLIANCE",
            "操作留痕与安全基线",
            "全量登录审计、关键写操作留痕、CSRF 令牌轮换与登录防爆破限流，结合多级角色与操作轨迹回溯，开箱满足企业安全合规验收。",
            "Audit Log · Login Throttle · CSRF");
        Cap(caps, "", "INTELLIGENCE",
            "AI 智能体与团队知识库",
            "内置多模型网关与流式问答助手，配合空间化 Markdown 文档与历史版本回溯沉淀组织资产。",
            "AI Copilot · Wiki Revisions");
        Cap(caps, "span2", "CLOUD & ON-PREM",
            "企业级任务调度与多引擎持久化",
            "支持 Cron 定时任务宿主与执行日志追踪；默认零依赖本地运行，修改配置即可平滑切换至 MySQL、PostgreSQL 与 Redis 集群。",
            "SQLite WAL · MySQL · PostgreSQL · Redis");

        List<StrMap> trusts = d.AddList("trusts");
        Trust(trusts, "AES-GCM", "加密会话与令牌版本",
            "Cookie 与 API 令牌采用 AES-GCM 认证加密，支持改密与管理员一键全端强制登出。");
        Trust(trusts, "CSP Strict", "前后端防注入纵深防护",
            "默认开启 X-Frame-Options、Sniff 防护与可选严格 CSP 策略，所有数据库访问全参数化。");
        Trust(trusts, "Multi-Worker", "多进程协同与连接池隔离",
            "多进程 Worker 模型搭配独立连接池与集群指标汇总，轻松承载高并发企业业务流量。");
        Trust(trusts, "White-Label", "一站式企业品牌白标",
            "站点名称、Logo、宣传标语、备案信息与联系渠道均在后台实时配置生效，无需二次编码。");

        List<StrMap> steps = d.AddList("steps");
        Step(steps, "01", "配置企业品牌与安全基线",
            "在控制台「站点设置」填入贵司名称、Logo、宣传语与安全策略，秒级生成专属品牌门户。");
        Step(steps, "02", "初始化组织架构与业务模型",
            "导入部门与账号、分配 RBAC 角色与数据范围，并通过表设计器快速装配业务管理模块。");
        Step(steps, "03", "私有化或云端一键上线",
            "单可执行文件搭配精简静态目录即可交付，随业务增长平滑切换至分布式数据库与缓存集群。");

        string canonical = await Geo.Canonical("/");
        this.Geo()
            .SetTitle(siteTitle + " — " + subtitle)
            .SetDescription(heroDesc)
            .SetCanonical(canonical)
            .SetSiteName(siteTitle)
            .AddSchema(GeoSchema.Organization(siteTitle, canonical, heroDesc));
        this.SmartView(d, IndexController.IndexMarkdown(siteTitle, subtitle, heroDesc, canonical));
    }

    private static string IndexMarkdown(string title, string subtitle, string desc, string canonical) {
        return "# " + title + " — " + subtitle + "\n\n"
            + "> " + desc + "\n\n"
            + "## 核心平台能力\n\n"
            + "- **组织权限与数据隔离**：部门树、RBAC 动作权限与行级 DataScope。\n"
            + "- **实时监控与链路诊断**：请求耗时、慢 SQL 归一化与错误堆栈追踪。\n"
            + "- **低代码建模与 AI 助手**：在线表设计、声明式表单与多模型智能助手。\n"
            + "- **私有化单文件交付**：支持 SQLite、MySQL、PostgreSQL 与 Redis。\n\n"
            + "- 访问地址: " + canonical + "\n";
    }

    private static void Metric(List<StrMap> rows, string v, string k) {
        StrMap row = new StrMap();
        row.Set("v", v);
        row.Set("k", k);
        rows.Add(row);
    }

    private static void Cap(List<StrMap> rows, string span, string badge, string name, string desc, string tag) {
        StrMap row = new StrMap();
        row.Set("span", span);
        row.Set("badge", badge);
        row.Set("name", name);
        row.Set("desc", desc);
        row.Set("tag", tag);
        rows.Add(row);
    }

    private static void Trust(List<StrMap> rows, string code, string name, string desc) {
        StrMap row = new StrMap();
        row.Set("code", code);
        row.Set("name", name);
        row.Set("desc", desc);
        rows.Add(row);
    }

    private static void Step(List<StrMap> rows, string num, string title, string desc) {
        StrMap row = new StrMap();
        row.Set("num", num);
        row.Set("title", title);
        row.Set("desc", desc);
        rows.Add(row);
    }
}
