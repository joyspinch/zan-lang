using System;
using System.Data.Orm;
using System.Json;
using System.Web;
using Zan.Web.Core;
using Zan.Web.Dao;
using Zan.Web.Model;
using Zan.Web.Security;
using Zan.Web.Services;
using Zan.Web;

namespace Zan.Web.Admin;

/* 管理台会话端点：/admin/login、/admin/login/submit 与 /admin/logout。
   管理端已全面迁移至 AdminUI SPA：GET /admin/login 直接重定向到 SPA 登录页，
   POST /admin/login/submit 返回纯 JSON 并签发会话 cookie，不再回退旧 SSR 登录卡。 */
[Custom(Authorization = CustomAuthorization.None)]
[Description("管理台登录")]
public class LoginController : AdminController {
    private static string SpaLoginUrl() {
        string baseUrl = Boot.SpaUrl();
        if (baseUrl == "/") { return "/login"; }
        return baseUrl + "/login";
    }

    [HttpGet]
    [Route("/admin/login")]
    [Description("登录")]
    public void Index() {
        if (this.IsLogin()) {
            this.Ctx().Redirect(Boot.SpaUrl());
            return;
        }
        this.Ctx().Redirect(SpaLoginUrl());
    }

    [HttpPost]
    [Description("登录提交")]
    public async void Submit() {
        string user = this.InAny("user").Trim();
        if (user.Length == 0) { user = this.InAny("username").Trim(); }
        string pass = this.InAny("pass");
        if (pass.Length == 0) { pass = this.InAny("password"); }
        if (user.Length == 0 || pass.Length == 0) {
            this.Fail(400, "0003", "请输入账号和密码");
            return;
        }
        if (user.Length > 32 || pass.Length > 64) {
            this.Fail(422, "1003", "账号或密码超出长度限制");
            return;
        }
        string token = await AuthUser.Login(user, pass);
        if (token.Length == 0) {
            string reason = LoginThrottle.Blocked(user)
                ? "尝试过于频繁，请稍后再试" : "账号或密码不正确";
            await RecordLogin(user, false, reason);
            if (!AuthToken.Ready()) {
                this.Fail(503, "1002",
                    "服务端未配置会话密钥：请在 config/app.json 的 [auth].secret（或环境变量 ZAN_AUTH_SECRET）填入至少 32 字符");
                return;
            }
            this.Fail(401, "1001", reason);
            return;
        }
        await RecordLogin(user, true, "");
        this.Ctx().SetCookie(Cfg.Auth.cookieName, token, Cfg.Auth.ttlSeconds);
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("token", token);
        w.WriteProperty("redirect", Boot.SpaUrl());
        w.WriteEndObject();
        this.Ctx().Api(Codes.Ok, "ok", w.ToString());
    }

    private async void RecordLogin(string user, bool ok, string message) {
        if (this.Held() == null) { return; }
        SysLoginLog row = new SysLoginLog();
        row.userId = 0;
        row.username = user;
        row.ip = ClientIp.Of(this.Ctx());
        row.agent = this.Ctx().Header("User-Agent");
        row.ok = ok ? 1 : 0;
        row.message = message;
        row.createdAt = WebApp.NowSeconds();
        try {
            int _id = await this.SysLoginLog.Insert(row).ExecuteIdentityAsync();
        } catch (Exception ex) {
            Log.Error("[auth] admin login log insert failed: " + ex.Message);
        }
    }

    [HttpGet]
    [Route("/admin/logout")]
    [Description("退出登录")]
    public async void Logout() {
        /* 退出即全端下线：bump tokenVersion 让该账号所有已发令牌（含
           其他浏览器/端）立刻作废，并同步失效本机版本缓存与集群副本，
           校验下一请求即落库；再让 cookie 过期完成本浏览器登出。 */
        if (this.IsLogin()) {
            int uid = Filter.ToInt(this.uid, 0);
            if (uid > 0) {
                try {
                    int _n = await this.SysUser.BumpTokenVersion(uid);
                } catch (Exception ex) {
                    Log.Error("[auth] logout bump failed for uid "
                        + Convert.ToString(uid) + ": " + ex.Message);
                }
                AuthUser.Forget(this.uid);
            }
        }
        this.Ctx().SetCookie(Cfg.Auth.cookieName, "", 0);
        this.Ctx().Redirect(SpaLoginUrl());
    }
}
