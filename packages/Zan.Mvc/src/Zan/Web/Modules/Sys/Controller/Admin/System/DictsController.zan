using System;
using System.Data;
using System.Data.Orm;
using System.Json;
using System.Web;
using Zan.Web.AdminUi;
using Zan.Web.Core;
using Zan.Web.Dao;
using Zan.Web.Model;
using Zan.Web.Security;
using Zan.Web;

namespace Zan.Web.Admin.System;

/* /admin/system/dicts 数据字典：其余系统用以标注取值的枚举（状态、种类、等级）；左侧类型、右侧所选类型的条目，编辑其一不看另一无意义，故同一屏。 */
[Custom(Authorization = CustomAuthorization.Grant, Group = "系统管理", GroupOrder = 90)]
[Description("数据字典")]
public class DictsController : AdminController {
    [HttpGet]
    [Custom(IsMenu = true, Icon = "mdi:book-open", Perm = PermBit.View)]
    [Description("数据字典")]
    public void Index() {
        this.Conf();
    }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("数据字典配置")]
    public void Conf() {
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("PageType", "table");

        w.WritePropertyName("Conf");
        w.WriteStartObject();
        w.WriteProperty("showPages", false);
        w.WriteProperty("pageSize", 100);
        w.WriteProperty("pageSizes", "50,100,200");
        w.WriteProperty("Local", false);
        w.WriteProperty("TreeData", false);
        w.WriteProperty("import", false);
        w.WriteProperty("export", true);
        w.WriteProperty("innerKey", "id");
        w.WriteProperty("innerName", "字典条目");
        w.WriteEndObject();

        w.WritePropertyName("LeftPanel");
        w.WriteStartObject();
        w.WriteProperty("title", "字典类型");
        w.WriteProperty("mode", "list");
        w.WriteProperty("dataUrl", "types");
        w.WriteProperty("width", 268);
        w.WriteProperty("idField", "id");
        w.WriteProperty("valueField", "code");
        w.WriteProperty("labelField", "name");
        w.WriteProperty("subtitleField", "code");
        w.WriteProperty("paramField", "type");
        w.WriteProperty("defaultPayloadField", "typeCode");
        w.WriteProperty("searchable", true);
        w.WritePropertyName("tools");
        w.WriteStartArray();
        AdminUiProtocol.WriteFormAction(w, "新增类型", "Add", "primary", "typeformconf", "typesave", false);
        w.WriteEndArray();
        w.WritePropertyName("itemActions");
        w.WriteStartArray();
        AdminUiProtocol.WriteFormActionEx(w, "编辑", "Edit", "info", "typeformconf", "typeedit", "typesave", true);
        AdminUiProtocol.WriteConfirmAction(w, "删除", "Delete", "danger", "typedelete", "删除类型将连带删除其下所有条目，确认删除吗？", true, false, "", "id={id}");
        w.WriteEndArray();
        w.WriteEndObject();

        w.WritePropertyName("Columns");
        w.WriteStartArray();
        WriteDictCol(w, "ID", "id", "number", 70, false, "");
        WriteDictCol(w, "类型标识", "typeCode", "text", 130, false, "");
        WriteDictCol(w, "显示名", "label", "text", 160, true, "");
        WriteDictCol(w, "键值", "value", "text", 130, false, "");
        WriteDictCol(w, "排序", "sortOrder", "number", 90, true, "");
        WriteDictCol(w, "状态", "status", "dict", 90, true, "1=启用,0=停用");
        WriteDictCol(w, "更新时间", "updatedAt", "text", 160, false, "");
        w.WriteEndArray();

        w.WritePropertyName("Filters");
        w.WriteStartArray();
        w.WriteEndArray();
        w.WritePropertyName("FilterRight");
        w.WriteStartArray();
        w.WriteEndArray();

        w.WritePropertyName("Tools");
        w.WriteStartArray();
        AdminUiProtocol.WriteFormAction(w, "新增条目", "Add", "primary", "formconf", "itemsave", false);
        AdminUiProtocol.WriteFormActionEx(w, "编辑条目", "Edit", "info", "formconf", "edit", "itemsave", true);
        AdminUiProtocol.WriteConfirmAction(w, "删除条目", "Delete", "danger", "itemdelete", "确认删除该字典条目吗？", true, false, "", "id={id}");
        w.WriteEndArray();

        w.WritePropertyName("MenuItems");
        w.WriteStartArray();
        AdminUiProtocol.WriteDetailAction(w, "查看详情", "");
        AdminUiProtocol.WriteFormActionEx(w, "编辑条目", "Edit", "info", "formconf", "edit", "itemsave", true);
        AdminUiProtocol.WriteConfirmAction(w, "删除条目", "Delete", "danger", "itemdelete", "确认删除该字典条目吗？", true, false, "", "id={id}");
        w.WriteEndArray();

        w.WritePropertyName("Tabs");
        w.WriteStartArray();
        w.WriteEndArray();

        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    private static void WriteDictCol(JsonWriter w, string header, string field, string type, int width, bool editable, string opts) {
        w.WriteStartObject();
        w.WriteProperty("headerName", header);
        w.WriteProperty("field", field);
        w.WriteProperty("type", type);
        w.WriteProperty("width", width);
        w.WriteProperty("editable", editable);
        if (opts.Length > 0) {
            w.WritePropertyName("options");
            AdminUiProtocol.WriteOptArray(w, opts);
            if (editable) { w.WriteProperty("cellEditor", "agSelectCellEditor"); }
        }
        w.WriteEndObject();
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("字典类型列表")]
    public async void Types() {
        if (!this.DataReady()) { return; }
        List<SysDictType> types = await this.SysDictType.All();
        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < types.Count; i = i + 1) {
            SysDictType t = types[i];
            w.WriteStartObject();
            w.WriteProperty("id", t.id);
            w.WriteProperty("code", t.code);
            w.WriteProperty("name", t.name);
            w.WriteProperty("description", t.description);
            w.WriteProperty("status", Convert.ToString(t.status));
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("字典条目列表")]
    public async void List() {
        if (!this.DataReady()) { return; }
        List<SysDictType> types = await this.SysDictType.All();
        string current = this.InAny("type").Trim();
        if (current.Length == 0 && types.Count > 0) { current = types[0].code; }
        List<SysDictItem> items = current.Length > 0
            ? await this.SysDictItem.ByTypeCode(current)
            : new List<SysDictItem>();

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < items.Count; i = i + 1) {
            SysDictItem it = items[i];
            w.WriteStartObject();
            w.WriteProperty("id", it.id);
            w.WriteProperty("typeCode", it.typeCode);
            w.WriteProperty("label", it.label);
            w.WriteProperty("value", it.value);
            w.WriteProperty("sortOrder", it.sortOrder);
            w.WriteProperty("status", Convert.ToString(it.status));
            w.WriteProperty("updatedAt", Fmt.Stamp(it.updatedAt));
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, items.Count, w.ToString());
    }

    [HttpPut]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("字典类型表单配置")]
    public void TypeFormConf() {
        int id = this.InAnyInt("id", 0);
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("title", id > 0 ? "编辑字典类型" : "新增字典类型");
        w.WriteProperty("width", "520px");
        w.WriteProperty("labelWidth", 90);
        w.WriteProperty("cols", 24);
        w.WritePropertyName("formItems");
        w.WriteStartArray();
        WriteSimpleFormItem(w, "code", "类型标识", "input", 12, true, "", "");
        WriteSimpleFormItem(w, "name", "类型名称", "input", 12, true, "", "");
        w.WriteStartObject();
        w.WriteProperty("field", "status");
        w.WriteProperty("label", "状态");
        w.WriteProperty("component", "select");
        w.WriteProperty("span", 12);
        w.WriteProperty("defaultValue", "1");
        w.WritePropertyName("options");
        AdminUiProtocol.WriteOptArray(w, "1=启用,0=停用");
        w.WriteEndObject();
        WriteSimpleFormItem(w, "description", "说明", "textarea", 24, false, "", "");
        w.WriteEndArray();
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("字典类型编辑回显")]
    public async void TypeEdit() {
        int id = this.InAnyInt("id", 0);
        SysDictType t = await this.SysDictType.ById(id);
        if (t == null) { this.Fail(404, "0404", "字典类型不存在"); }
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", t.id);
        w.WriteProperty("code", t.code);
        w.WriteProperty("name", t.name);
        w.WriteProperty("description", t.description);
        w.WriteProperty("status", Convert.ToString(t.status));
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPut]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("字典条目表单配置")]
    public void FormConf() {
        int id = this.InAnyInt("id", 0);
        string defType = this.InAny("typeCode").Trim();
        if (defType.Length == 0) { defType = this.InAny("type").Trim(); }
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("title", id > 0 ? "编辑字典条目" : "新增字典条目");
        w.WriteProperty("width", "520px");
        w.WriteProperty("labelWidth", 90);
        w.WriteProperty("cols", 24);
        w.WritePropertyName("formItems");
        w.WriteStartArray();
        WriteSimpleFormItem(w, "typeCode", "所属类型", "input", 24, true, "", defType);
        WriteSimpleFormItem(w, "label", "显示名", "input", 12, true, "", "");
        WriteSimpleFormItem(w, "value", "键值", "input", 12, true, "", "");
        w.WriteStartObject();
        w.WriteProperty("field", "sortOrder");
        w.WriteProperty("label", "排序");
        w.WriteProperty("component", "input-number");
        w.WriteProperty("span", 12);
        w.WriteProperty("defaultValue", 1);
        w.WriteEndObject();
        w.WriteStartObject();
        w.WriteProperty("field", "status");
        w.WriteProperty("label", "状态");
        w.WriteProperty("component", "select");
        w.WriteProperty("span", 12);
        w.WriteProperty("defaultValue", "1");
        w.WritePropertyName("options");
        AdminUiProtocol.WriteOptArray(w, "1=启用,0=停用");
        w.WriteEndObject();
        w.WriteEndArray();
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    private static void WriteSimpleFormItem(JsonWriter w, string field, string label, string comp, int span, bool req, string ph, string defVal) {
        w.WriteStartObject();
        w.WriteProperty("field", field);
        w.WriteProperty("label", label);
        w.WriteProperty("component", comp);
        w.WriteProperty("span", span);
        if (req) { w.WriteProperty("required", true); }
        if (ph.Length > 0) { w.WriteProperty("placeholder", ph); }
        if (defVal.Length > 0) { w.WriteProperty("defaultValue", defVal); }
        w.WriteEndObject();
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("字典条目编辑回显")]
    public async void Edit() {
        int id = this.InAnyInt("id", 0);
        SysDictItem it = await this.SysDictItem.ById(id);
        if (it == null) { this.Fail(404, "0404", "字典条目不存在"); }
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", it.id);
        w.WriteProperty("typeCode", it.typeCode);
        w.WriteProperty("label", it.label);
        w.WriteProperty("value", it.value);
        w.WriteProperty("sortOrder", it.sortOrder);
        w.WriteProperty("status", Convert.ToString(it.status));
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("字典条目行内编辑入口")]
    public void Field() {
        this.ItemField();
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存字典类型")]
    public async void TypeSave() {
        int id = this.InAnyInt("id", 0);
        if (!await this.Can(id > 0 ? (int)PermBit.Update : (int)PermBit.Create)) {
            this.Fail(403, "0403", "无操作权限"); return;
        }
        string code = this.NeedAny("code", "类型标识");
        string name = this.NeedAny("name", "类型名称");
        string description = this.InAny("description");
        int status = this.InAnyInt("status", 1);
        if (status != 1) { status = 0; }
        SysDictType clash = await this.SysDictType.ByCode(code);
        if (clash != null && clash.id != id) {
            this.Fail(400, "0004", "类型标识 " + code + " 已存在");
        }
        if (id > 0) {
            int n = await this.SysDictType.UpdateFields(id, code, name, description, status, WebApp.NowSeconds());
            await this.Note("编辑字典类型", code, n > 0, "");
            this.Saved("字典类型已保存");
            return;
        }
        SysDictType t = new SysDictType();
        t.code = code;
        t.name = name;
        t.description = description;
        t.status = status;
        t.createdAt = WebApp.NowSeconds();
        t.updatedAt = t.createdAt;
        int newId = await this.SysDictType.Insert(t).ExecuteIdentityAsync();
        await this.Note("新增字典类型", code, newId > 0, "");
        this.Saved("字典类型已创建");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除字典类型")]
    public async void TypeDelete() {
        int id = this.InAnyInt("id", 0);
        SysDictType t = await this.SysDictType.ById(id);
        if (t == null) { this.Fail(404, "0404", "字典类型不存在"); }
        string code = t.code;
        int n = await this.SysDictType.Delete().Where(a => a.id == id).ExecuteAffrowsAsync();
        int _i = await this.SysDictItem.DeleteByTypeCode(code);
        await this.Note("删除字典类型", code, n > 0, "");
        this.Saved("字典类型及其条目已删除");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存字典条目")]
    public async void ItemSave() {
        int id = this.InAnyInt("id", 0);
        if (!await this.Can(id > 0 ? (int)PermBit.Update : (int)PermBit.Create)) {
            this.Fail(403, "0403", "无操作权限"); return;
        }
        string typeCode = this.NeedAny("typeCode", "所属类型");
        string label = this.NeedAny("label", "显示名");
        string value = this.NeedAny("value", "值");
        int sortOrder = this.InAnyInt("sortOrder", 1);
        int status = this.InAnyInt("status", 1);
        if (status != 1) { status = 0; }
        if (id > 0) {
            int n = await this.SysDictItem.UpdateFields(id, typeCode, label, value, sortOrder, status, WebApp.NowSeconds());
            await this.Note("编辑字典条目", typeCode + "/" + value,
                n > 0, "");
            this.Saved("字典条目已保存");
            return;
        }
        SysDictItem it = new SysDictItem();
        it.typeCode = typeCode;
        it.label = label;
        it.value = value;
        it.sortOrder = sortOrder;
        it.status = status;
        it.createdAt = WebApp.NowSeconds();
        it.updatedAt = it.createdAt;
        int newId = await this.SysDictItem.Insert(it).ExecuteIdentityAsync();
        await this.Note("新增字典条目", typeCode + "/" + value,
            newId > 0, "");
        this.Saved("字典条目已创建");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除字典条目")]
    public async void ItemDelete() {
        int id = this.InAnyInt("id", 0);
        SysDictItem it = await this.SysDictItem.ById(id);
        if (it == null) { this.Fail(404, "0404", "字典条目不存在"); }
        int n = await this.SysDictItem.Delete().Where(a => a.id == id).ExecuteAffrowsAsync();
        await this.Note("删除字典条目",
            it.typeCode + "/" + it.value, n > 0, "");
        this.Saved("字典条目已删除");
    }

    /* 条目行内快速改：显示名/排序/启停就地提交。value 是业务数据引用的键值，
       改动会让既有数据失去标注，必须走编辑框；updatedAt 由端点维护。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("字典条目行内修改")]
    public async void ItemField() {
        int id = this.InAnyInt("id", 0);
        if (id <= 0) {
            JsonDoc doc = this.Ctx().JsonDoc();
            if (doc != null) {
                int dataSlot = doc.Get(doc.root, "data");
                if (dataSlot >= 0) {
                    int idSlot = doc.Get(dataSlot, "id");
                    if (idSlot >= 0) { id = doc.IntAt(idSlot, 0); }
                }
            }
        }
        string field = this.NeedAny("field", "属性");
        string value = this.InAny("value");
        SysDictItem it = await this.SysDictItem.ById(id);
        if (it == null) { this.Fail(404, "0404", "字典条目不存在"); }

        if (field == "label") {
            if (value.Length == 0) { this.Fail(400, "0004", "显示名不能为空"); }
            if (value.Length > 64) { value = value.Substring(0, 64); }
            int n = await this.SysDictItem.UpdateLabel(id, value, WebApp.NowSeconds());
            await this.Note("编辑字典条目", it.typeCode + "/" + it.value,
                n > 0, "行内");
            this.Ok("{}");
            return;
        }
        if (field == "sortOrder") {
            int sort = this.InAnyInt("value", it.sortOrder);
            if (sort < 0) { sort = 0; }
            if (sort > 9999999) { sort = 9999999; }
            int n = await this.SysDictItem.UpdateSortOrder(id, sort, WebApp.NowSeconds());
            await this.Note("编辑字典条目", it.typeCode + "/" + it.value,
                n > 0, "行内排序");
            this.Ok("{}");
            return;
        }
        if (field == "status") {
            int v = 0;
            if (value == "1") { v = 1; }
            int n = await this.SysDictItem.UpdateStatus(id, v, WebApp.NowSeconds());
            await this.Note("编辑字典条目", it.typeCode + "/" + it.value,
                n > 0, v == 1 ? "启用" : "停用");
            this.Ok("{}");
            return;
        }
        this.Fail(400, "0004", "该属性不支持行内修改");
    }

}
