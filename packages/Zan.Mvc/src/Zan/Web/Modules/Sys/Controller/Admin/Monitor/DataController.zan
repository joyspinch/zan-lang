using System;
using System.Data;
using System.Data.Orm;
using System.Json;
using System.Text;
using System.Web;
using Zan.Web.AdminUi;
using Zan.Web.Core;
using Zan.Web.Dao;
using Zan.Web.Model;
using Zan.Web.Security;
using Zan.Web;

namespace Zan.Web.Admin.Monitor;

/* 每张设计表在 /admin/monitor/data?t=<table> 享有的通用管理屏（纯 JSON 协议）。 */
[Custom(Authorization = CustomAuthorization.Grant, Group = "运行监控", GroupOrder = 80)]
[Description("数据管理")]
public class DataController : AdminController {
    SysGenTableDao SysGenTable { get { return new SysGenTableDao(this.Held()); } }
    SysGenColumnDao SysGenColumn { get { return new SysGenColumnDao(this.Held()); } }
    SysDictItemDao SysDictItem { get { return new SysDictItemDao(this.Held()); } }

    [HttpGet]
    [Custom(Icon = "mdi:table", Perm = PermBit.View)]
    [Description("数据列表")]
    public async void Index() {
        await this.Conf();
    }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("动态表表格配置")]
    public async void Conf() {
        string table = this.InAny("t");
        SysGenTable t = await this.Design(table);
        if (t == null) { return; }
        List<SysGenColumn> cols = await this.Columns(t.id);
        bool mayCreate = t.hasCreate == 1 && await this.Can((int)PermBit.Create);
        bool mayEdit = t.hasEdit == 1 && await this.Can((int)PermBit.Update);
        bool mayDelete = t.hasDelete == 1 && await this.Can((int)PermBit.Delete);

        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("PageType", "table");

        w.WritePropertyName("Conf");
        w.WriteStartObject();
        w.WriteProperty("showPages", true);
        w.WriteProperty("pageSize", t.pageSize > 0 ? t.pageSize : 20);
        w.WriteProperty("pageSizes", "10,20,50,100");
        w.WriteProperty("Local", false);
        w.WriteProperty("TreeData", false);
        w.WriteProperty("import", false);
        w.WriteProperty("export", true);
        w.WriteProperty("innerKey", "id");
        w.WriteProperty("innerName", t.title);
        w.WriteEndObject();

        w.WritePropertyName("Columns");
        w.WriteStartArray();
        WriteCol(w, "ID", "id", "number", 80);
        for (int i = 0; i < cols.Count; i = i + 1) {
            if (cols[i].inList != 1 || cols[i].name == "id") { continue; }
            string colType = "text";
            if (Gen.ZanType(cols[i].kind) != "string" && cols[i].dictType.Length == 0 && cols[i].relTable.Length == 0) {
                colType = "number";
            }
            WriteCol(w, LabelOf(cols[i]), cols[i].name, colType, 150);
        }
        w.WriteEndArray();

        w.WritePropertyName("Filters");
        w.WriteStartArray();
        for (int i = 0; i < cols.Count; i = i + 1) {
            if (cols[i].inFilter != 1) { continue; }
            w.WriteStartObject();
            w.WriteProperty("Name", LabelOf(cols[i]));
            w.WriteProperty("Field", "f_" + cols[i].name);
            w.WriteProperty("Type", "Input");
            w.WriteProperty("placeholder", LabelOf(cols[i]));
            w.WriteEndObject();
        }
        w.WriteEndArray();

        w.WritePropertyName("FilterRight");
        w.WriteStartArray();
        w.WriteEndArray();

        string tq = "?t=" + Encoding.UrlEncode(t.tableName);
        w.WritePropertyName("Tools");
        w.WriteStartArray();
        if (mayCreate && t.migrated == 1) {
            AdminUiProtocol.WriteFormActionEx(w, "新增" + t.title, "Add", "primary",
                "/admin/monitor/data/formconf" + tq, "", "/admin/monitor/data/save" + tq, false);
        }
        w.WriteEndArray();

        w.WritePropertyName("MenuItems");
        w.WriteStartArray();
        if (mayEdit && t.migrated == 1) {
            AdminUiProtocol.WriteFormActionEx(w, "编辑", "Edit", "primary",
                "/admin/monitor/data/formconf" + tq, "/admin/monitor/data/edit" + tq, "/admin/monitor/data/save" + tq, true);
        }
        if (mayDelete && t.migrated == 1) {
            AdminUiProtocol.WriteConfirmAction(w, "删除", "Delete", "error",
                "/admin/monitor/data/delete" + tq, "确定删除这条数据吗？", true, true, "", "");
        }
        AdminUiProtocol.WriteDetailAction(w, "查看详情", "");
        w.WriteEndArray();

        w.WritePropertyName("Tabs");
        w.WriteStartArray();
        w.WriteEndArray();

        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    private static void WriteCol(JsonWriter w, string header, string field, string type, int width) {
        w.WriteStartObject();
        w.WriteProperty("headerName", header);
        w.WriteProperty("field", field);
        w.WriteProperty("type", type);
        w.WriteProperty("width", width);
        w.WriteEndObject();
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("动态表分页数据")]
    public async void List() {
        string table = this.InAny("t");
        SysGenTable t = await this.Design(table);
        if (t == null) { return; }
        if (t.migrated != 1) {
            AdminUiProtocol.WriteListData(this, 0, "[]");
            return;
        }
        List<SysGenColumn> cols = await this.Columns(t.id);
        IDbConnection db = await this.Conn();
        if (db == null) { this.Fail(503, "2001", "数据库不可用"); return; }

        string orderCol = Gen.OrderCol(t, cols);
        ListQuery q = this.PagedAny(orderCol, t.pageSize > 0 ? t.pageSize : 20);
        DbTable dt = DbTable.Of(db, t.tableName);
        DbTableQuery query = dt.Query();
        for (int i = 0; i < cols.Count; i = i + 1) {
            if (cols[i].inFilter != 1) { continue; }
            string v = this.InAny("f_" + cols[i].name);
            if (v.Length == 0) { continue; }
            string zt = Gen.ZanType(cols[i].kind);
            if (zt == "string") {
                query.WhereContains(cols[i].name, v);
            } else if (zt == "double") {
                DbValues one = new DbValues().Set(cols[i].name, Filter.ToDouble(v, 0.0));
                query.WhereDict(one);
            } else {
                query.WhereEq(cols[i].name, (long)Filter.ToInt(v, 0));
            }
        }

        int total = (int)(await query.CountAsync());
        List<string> names = new List<string>();
        names.Add("id");
        List<SysGenColumn> shown = new List<SysGenColumn>();
        for (int i = 0; i < cols.Count; i = i + 1) {
            if (cols[i].inList != 1 || cols[i].name == "id") { continue; }
            shown.Add(cols[i]);
            names.Add(cols[i].name);
        }
        if (t.orderDesc == 1) { query.OrderByDesc(orderCol); }
        else { query.OrderBy(orderCol); }
        DbResult res = await query.Page(q.Limit(), q.Skip()).ToResultAsync(names);

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        int n = res != null ? res.RowCount() : 0;
        for (int i = 0; i < n; i = i + 1) {
            w.WriteStartObject();
            w.WriteProperty("id", Filter.ToInt(res.GetByName(i, "id"), 0));
            for (int k = 0; k < shown.Count; k = k + 1) {
                string cell = await this.Display(db, shown[k], res.GetByName(i, shown[k].name));
                w.WriteProperty(shown[k].name, cell);
            }
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, total, w.ToString());
    }

    [HttpPut]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("动态表表单配置")]
    public async void FormConf() {
        int id = this.InAnyInt("id", 0);
        if (!await this.Can(id > 0 ? (int)PermBit.Update : (int)PermBit.Create)) {
            this.Fail(403, "0403", "无操作权限"); return;
        }
        string table = this.InAny("t");
        SysGenTable t = await this.Design(table);
        if (t == null) { return; }
        if (id == 0 && t.hasCreate != 1) { this.Fail(404, "0404", "该表未开放新增"); return; }
        if (id > 0 && t.hasEdit != 1) { this.Fail(404, "0404", "该表未开放编辑"); return; }
        List<SysGenColumn> cols = await this.Columns(t.id);
        IDbConnection db = await this.Conn();
        if (db == null) { this.Fail(503, "2001", "数据库不可用"); return; }

        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("title", (id > 0 ? "编辑" : "新增") + t.title);
        w.WriteProperty("cols", 24);
        w.WriteProperty("labelWidth", 110);
        w.WritePropertyName("formItems");
        w.WriteStartArray();
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id") { continue; }
            if (id > 0 && c.inEdit != 1) { continue; }
            if (id == 0 && c.inCreate != 1) { continue; }
            w.WriteStartObject();
            w.WriteProperty("field", c.name);
            w.WriteProperty("label", LabelOf(c));
            w.WriteProperty("span", 24);
            if (c.required == 1) { w.WriteProperty("required", true); }
            if (c.defValue.Length > 0) { w.WriteProperty("defaultValue", c.defValue); }

            if (c.relTable.Length > 0 || c.dictType.Length > 0) {
                w.WriteProperty("type", "select");
                w.WritePropertyName("options");
                w.WriteStartArray();
                List<StrMap> choices = await this.Choices(db, c);
                for (int o = 0; o < choices.Count; o = o + 1) {
                    w.WriteStartObject();
                    w.WriteProperty("value", choices[o].Get("value"));
                    w.WriteProperty("label", choices[o].Get("label"));
                    w.WriteEndObject();
                }
                w.WriteEndArray();
            } else if (c.widget == "textarea" || c.kind == "text") {
                w.WriteProperty("type", "textarea");
            } else if (c.widget == "switch" || c.kind == "bool") {
                w.WriteProperty("type", "select");
                w.WritePropertyName("options");
                AdminUiProtocol.WriteOptArray(w, "1=是,0=否");
            } else if (c.widget == "number" || Gen.ZanType(c.kind) != "string") {
                w.WriteProperty("type", "number");
            } else if (c.widget == "date") {
                w.WriteProperty("type", "date");
            } else {
                w.WriteProperty("type", "input");
            }
            w.WriteEndObject();
        }
        w.WriteEndArray();
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("读取单条动态数据")]
    public async void Edit() {
        string table = this.InAny("t");
        SysGenTable t = await this.Design(table);
        if (t == null) { return; }
        int id = this.InAnyInt("id", 0);
        if (id <= 0) { this.Fail(400, "0004", "缺少记录 ID"); return; }
        List<SysGenColumn> cols = await this.Columns(t.id);
        IDbConnection db = await this.Conn();
        if (db == null) { this.Fail(503, "2001", "数据库不可用"); return; }
        DbResult cur = await DbTable.Of(db, t.tableName).ReadAsync("id", (long)id);
        if (cur == null) { this.Fail(404, "0404", "记录不存在"); return; }

        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", id);
        for (int i = 0; i < cols.Count; i = i + 1) {
            if (cols[i].name == "id") { continue; }
            w.WriteProperty(cols[i].name, cur.GetByName(0, cols[i].name));
        }
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存数据")]
    public async void Save() {
        int id = this.InAnyInt("id", 0);
        if (!await this.Can(id > 0 ? (int)PermBit.Update : (int)PermBit.Create)) {
            this.Fail(403, "0403", "无操作权限"); return;
        }
        string table = this.InAny("t");
        SysGenTable t = await this.Design(table);
        if (t == null) { return; }
        if (id == 0 && t.hasCreate != 1) { this.Fail(404, "0404", "该表未开放新增"); return; }
        if (id > 0 && t.hasEdit != 1) { this.Fail(404, "0404", "该表未开放编辑"); return; }
        List<SysGenColumn> cols = await this.Columns(t.id);
        IDbConnection db = await this.Conn();
        if (db == null) { this.Fail(503, "2001", "数据库不可用"); return; }

        /* 写入的列即设计自身，故行是 DbValues——ORM 按各列声明类型绑定的名/值包。 */
        DbValues row = new DbValues();
        for (int i = 0; i < cols.Count; i = i + 1) {
            SysGenColumn c = cols[i];
            if (c.name == "id") { continue; }
            if (id > 0 && c.inEdit != 1) { continue; }
            if (id == 0 && c.inCreate != 1) { continue; }
            string v = this.InAny(c.name);
            if (c.widget == "switch" || c.kind == "bool") {
                v = (v == "1" || v == "true") ? "1" : "0";
            }
            if (c.required == 1 && v.Length == 0) {
                this.Fail(400, "0003", LabelOf(c) + "不能为空");
                return;
            }
            string zt = Gen.ZanType(c.kind);
            if (zt == "string") { row.Set(c.name, v); }
            else if (zt == "double") { row.Set(c.name, Filter.ToDouble(v, 0.0)); }
            else { row.Set(c.name, Filter.ToInt(v, 0)); }
        }
        if (row.Count() == 0) { this.Fail(400, "0004", "没有可写入的字段"); return; }

        DbTable dt = DbTable.Of(db, t.tableName);
        if (id > 0) {
            int n = await dt.UpdateAsync(row, "id", (long)id);
            await this.Note("编辑" + t.title,
                Convert.ToString(id), n > 0, "");
            this.Saved("已保存");
            return;
        }
        int rows = await dt.InsertAsync(row);
        await this.Note("新增" + t.title, t.tableName,
            rows > 0, "");
        this.Saved("已创建");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除数据")]
    public async void Delete() {
        string table = this.InAny("t");
        SysGenTable t = await this.Design(table);
        if (t == null) { return; }
        if (t.hasDelete != 1) { this.Fail(403, "0403", "该表未开放删除"); return; }
        int id = this.InAnyInt("id", 0);
        IDbConnection db = await this.Conn();
        if (db == null) { this.Fail(503, "2001", "数据库不可用"); return; }
        int n = await DbTable.Of(db, t.tableName).DeleteAsync("id", (long)id);
        await this.Note("删除" + t.title,
            Convert.ToString(id), n > 0, "");
        this.Saved("已删除");
    }

    /* 辅助方法 */

    /* 表名对应的设计；答话后返回 null。非已保存设计的表名永不进 SQL。 */
    private async SysGenTable Design(string table) {
        if (!Gen.Safe(table)) { this.Fail(400, "0004", "表名不合法"); return null; }
        if (!this.DataReady()) { return null; }
        SysGenTable t = await this.SysGenTable.Where(a => a.tableName == table)
            .FirstAsync();
        if (t == null) { this.Fail(404, "0404", "没有这张表的设计"); return null; }
        return t;
    }

    private async List<SysGenColumn> Columns(int tableId) {
        List<SysGenColumn> all = await this.SysGenColumn
            .Where(a => a.tableId == tableId).OrderBy(a => a.sortOrder).ToListAsync();
        List<SysGenColumn> safe = new List<SysGenColumn>();
        for (int i = 0; i < all.Count; i = i + 1) {
            if (Gen.Safe(all[i].name)) { safe.Add(all[i]); }
        }
        return safe;
    }

    /* 指向另一表或字典类型的列的候选值。 */
    public async List<StrMap> Choices(IDbConnection db, SysGenColumn c) {
        List<StrMap> outRows = new List<StrMap>();
        if (c.dictType.Length > 0) {
            List<SysDictItem> items = await this.SysDictItem
                .Where(a => a.typeCode == c.dictType).Where(a => a.status == 1)
                .OrderBy(a => a.sortOrder).ToListAsync();
            for (int i = 0; i < items.Count; i = i + 1) {
                StrMap row = new StrMap();
                row.Set("value", items[i].value);
                row.Set("label", items[i].label);
                outRows.Add(row);
            }
            return outRows;
        }
        if (c.relTable.Length == 0) { return outRows; }
        if (!Gen.Safe(c.relTable) || !Gen.Safe(c.relValue) || !Gen.Safe(c.relLabel)) {
            return outRows;
        }
        List<string> pick = new List<string>();
        pick.Add(c.relValue);
        if (c.relLabel != c.relValue) { pick.Add(c.relLabel); }
        DbResult r = await DbTable.Of(db, c.relTable).Query().Limit(500)
            .ToResultAsync(pick);
        if (r == null) { return outRows; }
        for (int i = 0; i < r.RowCount(); i = i + 1) {
            StrMap row = new StrMap();
            row.Set("value", r.GetByName(i, c.relValue));
            row.Set("label", r.GetByName(i, c.relLabel));
            outRows.Add(row);
        }
        return outRows;
    }

    /* 单元格展示：关联行显示其标签而非键，字典显示其标签而非值，switch 显示是/否。 */
    public async string Display(IDbConnection db, SysGenColumn c, string raw) {
        if (raw == null || raw.Length == 0) { return ""; }
        if (c.widget == "switch" || c.kind == "bool") {
            if (raw == "1") { return "是"; }
            return "否";
        }
        if (c.dictType.Length > 0 || c.relTable.Length > 0) {
            List<StrMap> choices = await this.Choices(db, c);
            for (int i = 0; i < choices.Count; i = i + 1) {
                if (choices[i].Get("value") == raw) { return choices[i].Get("label"); }
            }
        }
        return raw;
    }

    private static string LabelOf(SysGenColumn c) {
        if (c.label.Length > 0) { return c.label; }
        return c.name;
    }

    /* 此处构造的标记原样插入，故设计表返回的每个值入时都转义。 */
    private static string Esc(string v) {
        if (v == null) { return ""; }
        return v.Replace("&", "&amp;").Replace("<", "&lt;").Replace(">", "&gt;")
            .Replace("\"", "&quot;");
    }
}
