using System;
using System.Web;
using Zan.Web;

namespace Zan.Web.Admin.Dev;

/* 类型化参数绑定示例：只保留无副作用的两数之和，开发路由不得修改账号状态。 */
public class TxProbeController : AdminController {
    [HttpGet]
    [Description("类型化参数绑定示例：两数之和")]
    public void Sum(int a, int b) {
        this.Ok("{\"sum\":" + Convert.ToString(a + b) + "}");
    }

}
