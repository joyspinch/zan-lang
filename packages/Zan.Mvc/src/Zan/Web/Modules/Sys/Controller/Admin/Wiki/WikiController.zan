using System;
using System.Data;
using System.Data.Orm;
using System.Json;
using System.Text;
using System.Web;
using Zan.Web.AdminUi;
using Zan.Web.Ai;
using Zan.Web.Core;
using Zan.Web.Model;
using Zan.Web.Security;
using Zan.Web;

namespace Zan.Web.Admin.Wiki;

/* /admin/wiki/wiki 知识库：左侧空间 + 右侧文档、Markdown 阅读/编辑、修订历史与回滚、AI 整理（纯 JSON 协议）。 */
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("知识库")]
public class WikiController : AdminController {
    [HttpGet]
    [Custom(IsMenu = true, Icon = "mdi:book-multiple", Perm = PermBit.View)]
    [Description("知识库")]
    public async void Index() {
        await this.Conf();
    }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("知识库页面配置")]
    public async void Conf() {
        bool aiOn = await Ai.Ready();
        bool canCreate = await this.Can((int)PermBit.Create);
        bool canUpdate = await this.Can((int)PermBit.Update);
        bool canDelete = await this.Can((int)PermBit.Delete);
        List<SysDepartment> depts = await this.SysDepartment.OrderBy(a => a.sortOrder).ToListAsync();

        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("PageType", "wiki");
        w.WriteProperty("title", "知识库");
        w.WriteProperty("spacesUrl", "spaces");
        w.WriteProperty("docsUrl", "docs");
        w.WriteProperty("docUrl", "doc");
        w.WriteProperty("saveUrl", "save");
        w.WriteProperty("deleteUrl", "delete");
        w.WriteProperty("spaceSaveUrl", "spacesave");
        w.WriteProperty("spaceDeleteUrl", "spacedelete");
        w.WriteProperty("historyUrl", "history");
        w.WriteProperty("revisionUrl", "revision");
        w.WriteProperty("rollbackUrl", "rollback");
        w.WriteProperty("aiOrganizeUrl", "aiorganize");
        w.WriteProperty("aiReady", aiOn);
        w.WriteProperty("canCreate", canCreate);
        w.WriteProperty("canUpdate", canUpdate);
        w.WriteProperty("canDelete", canDelete);
        w.WritePropertyName("departments");
        w.WriteStartArray();
        for (int i = 0; i < depts.Count; i = i + 1) {
            w.WriteStartObject();
            w.WriteProperty("id", depts[i].id);
            w.WriteProperty("name", depts[i].name);
            w.WriteEndObject();
        }
        w.WriteEndArray();
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("知识库空间列表")]
    public async void Spaces() {
        List<SysWikiSpace> spaces = await this.SysWikiSpace
            .OrderBy(a => a.sortOrder).ToListAsync();
        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < spaces.Count; i = i + 1) {
            SysWikiSpace s = spaces[i];
            int count = await this.SysWikiDoc.Where(a => a.spaceId == s.id).CountAsync();
            w.WriteStartObject();
            w.WriteProperty("id", s.id);
            w.WriteProperty("name", s.name);
            w.WriteProperty("description", s.description);
            w.WriteProperty("icon", s.icon);
            w.WriteProperty("departmentId", s.departmentId);
            w.WriteProperty("sortOrder", s.sortOrder);
            w.WriteProperty("status", s.status);
            w.WriteProperty("count", count);
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("空间文档列表")]
    public async void Docs() {
        int spaceId = this.InAnyInt("spaceId", 0);
        string kw = this.InAny("kw").Trim();
        List<SysWikiDoc> docs = spaceId > 0
            ? await this.SysWikiDoc.Where(a => a.spaceId == spaceId).OrderByDescending(a => a.updatedAt).ToListAsync()
            : await this.SysWikiDoc.OrderByDescending(a => a.updatedAt).ToListAsync();

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < docs.Count; i = i + 1) {
            SysWikiDoc g = docs[i];
            if (kw.Length > 0 && !g.title.Contains(kw) && !g.tags.Contains(kw) && !g.summary.Contains(kw)) { continue; }
            w.WriteStartObject();
            w.WriteProperty("id", g.id);
            w.WriteProperty("spaceId", g.spaceId);
            w.WriteProperty("title", g.title);
            w.WriteProperty("summary", g.summary);
            w.WriteProperty("tags", g.tags);
            w.WriteProperty("rev", g.rev);
            w.WriteProperty("views", g.views);
            w.WriteProperty("status", g.status);
            w.WriteProperty("updatedBy", g.updatedBy);
            w.WriteProperty("updatedAt", Fmt.Stamp(g.updatedAt));
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("文档详情")]
    public async void Doc() {
        int id = this.InAnyInt("id", 0);
        int incView = this.InAnyInt("view", 0);
        SysWikiDoc g = await this.SysWikiDoc.ById(id);
        if (g == null) { this.Fail(404, "0404", "文档不存在"); return; }
        SysWikiSpace s = await this.SysWikiSpace.ById(g.spaceId);
        int views = g.views;
        if (incView == 1) {
            views = views + 1;
            int _u = await this.SysWikiDoc.Update()
                .Set(a => a.views, views)
                .Where(a => a.id == id).ExecuteAffrowsAsync();
        }
        List<string> labels = Prose.Tags(g.tags);

        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", g.id);
        w.WriteProperty("spaceId", g.spaceId);
        w.WriteProperty("spaceName", s != null ? s.name : "");
        w.WriteProperty("title", g.title);
        w.WriteProperty("body", g.body);
        w.WriteProperty("bodyHtml", MarkdownLite.Html(g.body));
        w.WriteProperty("tags", g.tags);
        w.WritePropertyName("tagList");
        w.WriteStartArray();
        for (int i = 0; i < labels.Count; i = i + 1) {
            w.WriteString(labels[i]);
        }
        w.WriteEndArray();
        w.WriteProperty("rev", g.rev);
        w.WriteProperty("views", views);
        w.WriteProperty("status", g.status);
        w.WriteProperty("minutes", Prose.Minutes(g.body));
        w.WriteProperty("updatedBy", g.updatedBy);
        w.WriteProperty("updatedAt", Fmt.Stamp(g.updatedAt));
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存知识库")]
    public async void SpaceSave() {
        int id = this.InAnyInt("id", 0);
        if (!await this.Can(id > 0 ? (int)PermBit.Update : (int)PermBit.Create)) {
            this.Fail(403, "0403", "无操作权限"); return;
        }
        string name = this.NeedAny("name", "知识库名称");
        if (name.Length > 64) { name = name.Substring(0, 64); }
        string description = this.InAny("description");
        if (description.Length > 255) {
            description = description.Substring(0, 255);
        }
        string icon = this.InAny("icon");
        if (icon.Length == 0) { icon = "mdi:folder-outline"; }
        if (icon.Length > 32) { icon = icon.Substring(0, 32); }
        int departmentId = this.InAnyInt("departmentId", 0);
        int sortOrder = this.InAnyInt("sortOrder", 1);
        int status = this.InAnyInt("status", 1);
        if (status != 1) { status = 0; }

        if (id > 0) {
            int n = await this.SysWikiSpace.Update()
                .Set(a => a.name, name)
                .Set(a => a.description, description)
                .Set(a => a.icon, icon)
                .Set(a => a.departmentId, departmentId)
                .Set(a => a.sortOrder, sortOrder)
                .Set(a => a.status, status)
                .Set(a => a.updatedAt, WebApp.NowSeconds())
                .Where(a => a.id == id)
                .ExecuteAffrowsAsync();
            await this.Note("编辑知识库", name, n > 0, "");
            this.Saved("知识库已保存");
            return;
        }
        SysWikiSpace s = new SysWikiSpace();
        s.name = name;
        s.description = description;
        s.icon = icon;
        s.departmentId = departmentId;
        s.sortOrder = sortOrder;
        s.status = status;
        if (this.who != null) { s.createdBy = this.who.username; }
        s.createdAt = WebApp.NowSeconds();
        s.updatedAt = s.createdAt;
        int newId = await this.SysWikiSpace.Insert(s).ExecuteIdentityAsync();
        await this.Note("新增知识库", name, newId > 0, "");
        this.Saved("知识库已创建");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除知识库")]
    public async void SpaceDelete() {
        int id = this.InAnyInt("id", 0);
        SysWikiSpace s = await this.SysWikiSpace.ById(id);
        if (s == null) { this.Fail(404, "0404", "知识库不存在"); return; }
        int docs = await this.SysWikiDoc
            .Where(a => a.spaceId == id).CountAsync();
        if (docs > 0) {
            this.Fail(400, "0004", "知识库下还有 " + Convert.ToString(docs)
                + " 篇文档，先删除或移动它们");
            return;
        }
        int n = await this.SysWikiSpace.Delete().Where(a => a.id == id)
            .ExecuteAffrowsAsync();
        await this.Note("删除知识库", s.name, n > 0, "");
        this.Saved("知识库已删除");
    }

    /* 保存文档：新建写版本 1；更新 rev+1 并把新状态整篇入快照。 */
    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存文档")]
    public async void Save() {
        int id = this.InAnyInt("id", 0);
        if (!await this.Can(id > 0 ? (int)PermBit.Update : (int)PermBit.Create)) {
            this.Fail(403, "0403", "无操作权限"); return;
        }
        int spaceId = this.InAnyInt("spaceId", 0);
        string title = this.NeedAny("title", "文档标题");
        if (title.Length > 128) { title = title.Substring(0, 128); }
        string body = this.InAnyRaw("body").Trim();
        if (body.Length == 0) { this.Fail(400, "0004", "正文不能为空"); return; }
        string tags = this.InAny("tags");
        if (tags.Length > 128) { tags = tags.Substring(0, 128); }
        string note = this.InAny("note");
        if (note.Length > 255) { note = note.Substring(0, 255); }
        int status = this.InAnyInt("status", 1);
        if (status != 1) { status = 0; }
        SysWikiSpace space = await this.SysWikiSpace.ById(spaceId);
        if (space == null) { this.Fail(404, "0404", "所属知识库不存在"); return; }
        string editor = this.who != null ? this.who.username : "";

        if (id > 0) {
            SysWikiDoc cur = await this.SysWikiDoc.ById(id);
            if (cur == null) { this.Fail(404, "0404", "文档不存在"); return; }
            int rev = cur.rev + 1;
            int n = await this.SysWikiDoc.Update()
                .Set(a => a.title, title)
                .Set(a => a.body, body)
                .Set(a => a.summary, Prose.Excerpt(body, 120))
                .Set(a => a.tags, tags)
                .Set(a => a.status, status)
                .Set(a => a.rev, rev)
                .Set(a => a.updatedBy, editor)
                .Set(a => a.updatedAt, WebApp.NowSeconds())
                .Where(a => a.id == id)
                .ExecuteAffrowsAsync();
            await this.Snapshot(id, rev, title, body,
                note.Length > 0 ? note : "编辑", editor);
            await this.Note("编辑知识库文档", title, n > 0, "r"
                + Convert.ToString(rev));
            this.Saved("文档已保存（r" + Convert.ToString(rev) + "）");
            return;
        }
        SysWikiDoc g = new SysWikiDoc();
        g.spaceId = spaceId;
        g.title = title;
        g.body = body;
        g.summary = Prose.Excerpt(body, 120);
        g.tags = tags;
        g.status = status;
        g.rev = 1;
        g.views = 0;
        g.createdBy = editor;
        g.updatedBy = editor;
        g.createdAt = WebApp.NowSeconds();
        g.updatedAt = g.createdAt;
        int newId = await this.SysWikiDoc.Insert(g).ExecuteIdentityAsync();
        await this.Snapshot(newId, 1, title, body,
            note.Length > 0 ? note : "创建", editor);
        await this.Note("新增知识库文档", title, newId > 0, "");
        this.Saved("文档已创建");
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("修订历史")]
    public async void History() {
        int id = this.InAnyInt("id", 0);
        SysWikiDoc g = await this.SysWikiDoc.ById(id);
        if (g == null) { this.Fail(404, "0404", "文档不存在"); return; }
        bool canUp = await this.Can((int)PermBit.Update);
        List<SysWikiRevision> rows = await this.SysWikiRevision
            .Where(a => a.docId == id)
            .OrderByDescending(a => a.rev).ToListAsync();

        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", g.id);
        w.WriteProperty("title", g.title);
        w.WriteProperty("rev", g.rev);
        w.WriteProperty("canRollback", canUp);
        w.WritePropertyName("revisions");
        w.WriteStartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            SysWikiRevision r = rows[i];
            w.WriteStartObject();
            w.WriteProperty("rev", r.rev);
            w.WriteProperty("title", r.title);
            w.WriteProperty("note", r.note);
            w.WriteProperty("editor", r.editor);
            w.WriteProperty("createdAt", Fmt.Stamp(r.createdAt));
            w.WriteProperty("current", r.rev == g.rev);
            w.WriteEndObject();
        }
        w.WriteEndArray();
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("查看版本")]
    public async void Revision() {
        int id = this.InAnyInt("id", 0);
        int rev = this.InAnyInt("rev", 0);
        SysWikiDoc g = await this.SysWikiDoc.ById(id);
        if (g == null) { this.Fail(404, "0404", "文档不存在"); return; }
        SysWikiRevision r = await this.SysWikiRevision
            .Where(a => a.docId == id)
            .Where(a => a.rev == rev).FirstAsync();
        if (r == null) { this.Fail(404, "0404", "版本不存在"); return; }

        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", id);
        w.WriteProperty("title", r.title);
        w.WriteProperty("rev", rev);
        w.WriteProperty("editor", r.editor);
        w.WriteProperty("createdAt", Fmt.Stamp(r.createdAt));
        w.WriteProperty("note", r.note);
        w.WriteProperty("body", r.body);
        w.WriteProperty("bodyHtml", MarkdownLite.Html(r.body));
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    /* 回滚 = 以历史版本内容新建一个版本，历史不被改写。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("回滚版本")]
    public async void Rollback() {
        int id = this.InAnyInt("id", 0);
        int rev = this.InAnyInt("rev", 0);
        SysWikiDoc g = await this.SysWikiDoc.ById(id);
        if (g == null) { this.Fail(404, "0404", "文档不存在"); return; }
        SysWikiRevision r = await this.SysWikiRevision
            .Where(a => a.docId == id)
            .Where(a => a.rev == rev).FirstAsync();
        if (r == null) { this.Fail(404, "0404", "版本不存在"); return; }
        string editor = this.who != null ? this.who.username : "";
        int next = g.rev + 1;
        int n = await this.SysWikiDoc.Update()
            .Set(a => a.title, r.title)
            .Set(a => a.body, r.body)
            .Set(a => a.summary, Prose.Excerpt(r.body, 120))
            .Set(a => a.rev, next)
            .Set(a => a.updatedBy, editor)
            .Set(a => a.updatedAt, WebApp.NowSeconds())
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
        await this.Snapshot(id, next, r.title, r.body,
            "回滚自 r" + Convert.ToString(rev), editor);
        await this.Note("回滚知识库文档", g.title, n > 0,
            "r" + Convert.ToString(next) + " <- r"
            + Convert.ToString(rev));
        this.Saved("已回滚到 r" + Convert.ToString(rev)
            + "，当前为 r" + Convert.ToString(next));
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("AI 整理")]
    public async void AiOrganize() {
        if (!await Ai.Ready()) {
            this.Fail(400, "0005", "尚未配置 AI 服务");
            return;
        }
        int id = this.InAnyInt("id", 0);
        SysWikiDoc g = await this.SysWikiDoc.ById(id);
        if (g == null) { this.Fail(404, "0404", "文档不存在"); return; }
        AiReply r = await Ai.CompleteRaw(OrganizePrompt,
            g.title + "\n\n" + g.body);
        if (!r.ok) { this.Fail(502, "0502", r.text); return; }
        string body = r.text.Trim();
        if (body.Length == 0) { this.Fail(502, "0502", "模型返回空内容"); return; }
        if (body.Length > 200000) { body = body.Substring(0, 200000); }
        string editor = this.who != null ? this.who.username : "ai";
        int next = g.rev + 1;
        int n = await this.SysWikiDoc.Update()
            .Set(a => a.body, body)
            .Set(a => a.summary, Prose.Excerpt(body, 120))
            .Set(a => a.rev, next)
            .Set(a => a.updatedBy, editor)
            .Set(a => a.updatedAt, WebApp.NowSeconds())
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
        await this.Snapshot(id, next, g.title, body, "AI 整理", editor);
        await this.Note("AI 整理知识库文档", g.title, n > 0,
            "r" + Convert.ToString(next));
        this.Saved("AI 整理完成，已保存为 r" + Convert.ToString(next));
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除文档")]
    public async void Delete() {
        int id = this.InAnyInt("id", 0);
        SysWikiDoc g = await this.SysWikiDoc.ById(id);
        if (g == null) { this.Fail(404, "0404", "文档不存在"); return; }
        string title = g.title;
        int n = await this.SysWikiDoc.Delete().Where(a => a.id == id)
            .ExecuteAffrowsAsync();
        int _r = await this.SysWikiRevision.Delete()
            .Where(a => a.docId == id).ExecuteAffrowsAsync();
        await this.Note("删除知识库文档", title, n > 0, "");
        this.Saved("文档及其修订历史已删除");
    }

    /* ---- 内部助手 ---- */

    /* 写一条版本快照（动作内已持请求连接）。 */
    private async void Snapshot(int docId, int rev, string title, string body,
                        string note, string editor) {
        SysWikiRevision row = new SysWikiRevision();
        row.docId = docId;
        row.rev = rev;
        row.title = title;
        row.body = body;
        row.note = note;
        row.editor = editor;
        row.createdAt = WebApp.NowSeconds();
        int _id = await this.SysWikiRevision.Insert(row).ExecuteIdentityAsync();
    }

    /* AI 整理的系统提示词：只输出整理后的 Markdown 正文，不加解说。 */
    static string OrganizePrompt =
        "你是企业知识库编辑。把给出的文档整理成结构清晰的 Markdown："
        + "用标题分层（#/##/###）、要点用列表、保留全部事实信息、"
        + "修正明显的错别字与格式，不添加原文没有的内容，不改写成回答体。"
        + "只输出整理后的正文，不要任何解释或代码围栏。";

}
