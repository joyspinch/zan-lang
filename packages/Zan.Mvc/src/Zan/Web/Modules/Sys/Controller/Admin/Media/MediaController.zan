using System;
using System.Data;
using System.Data.Orm;
using System.Diagnostics;
using System.IO;
using System.Json;
using System.Security.Cryptography;
using System.Web;
using Zan.Web.AdminUi;
using Zan.Web.Core;
using Zan.Web.Dao;
using Zan.Web.Model;
using Zan.Web.Security;
using Zan.Web;

namespace Zan.Web.Admin.Media;

/* 上传体先由 [Upload] 写入暂存文件。展示名经 SafeFileName 处理，
   公开路径单独分配。/static/media/ 同时服务既有路径和新生成的路径。
   白名单默认拒绝 SVG 等可携带同源脚本的类型。 */
[Custom(Authorization = CustomAuthorization.Grant, Group = "媒体库", GroupOrder = 60)]
[Description("媒体库")]
public class MediaController : AdminController {
    SysMediaFileDao SysMediaFile { get { return new SysMediaFileDao(this.Held()); } }
    private static const string MediaDir = "wwwroot/media";
    private static const string MediaUrl = "/static/media/";
    // StaticFiles rejects dot-prefixed segments. Keep staging on the media volume.
    private static const string DeleteDir = "wwwroot/media/.media-delete";
    /* 上传白名单：图片/文档/压缩包/音视频。 */
    static string Allowed = "png,jpg,jpeg,gif,webp,ico,bmp,"
        + "pdf,txt,md,csv,doc,docx,xls,xlsx,ppt,pptx,"
        + "zip,gz,tar,mp3,wav,mp4,webm,json";

    [HttpGet]
    [Custom(IsMenu = true, Icon = "mdi:image-area", Perm = PermBit.View)]
    [Description("媒体文件")]
    public void Index() {
        this.Conf();
    }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("媒体库页面配置")]
    public void Conf() {
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("PageType", "media");
        w.WriteProperty("title", "媒体库");
        w.WriteProperty("listUrl", "list");
        w.WriteProperty("uploadUrl", "upload");
        w.WriteProperty("deleteUrl", "delete");
        w.WriteProperty("allowed", Allowed);
        w.WriteProperty("maxBytes", StaticFiles.MaxFileBytes);
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("媒体文件列表数据")]
    public async void List() {
        if (!this.DataReady()) { return; }
        List<SysMediaFile> rows = await this.SysMediaFile.OrderByDescending(a => a.id)
            .Take(200).ToListAsync();
        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            SysMediaFile m = rows[i];
            string ext = m.ext != null ? m.ext.ToLower() : "";
            bool isImg = ext == "png" || ext == "jpg" || ext == "jpeg"
                || ext == "gif" || ext == "webp" || ext == "ico" || ext == "bmp";
            w.WriteStartObject();
            w.WriteProperty("id", m.id);
            w.WriteProperty("name", m.name);
            w.WriteProperty("path", m.path);
            w.WriteProperty("url", MediaUrl + m.path);
            w.WriteProperty("ext", ext);
            w.WriteProperty("size", m.size);
            w.WriteProperty("sizeText", Fmt.Bytes(m.size));
            w.WriteProperty("isImage", isImg);
            w.WriteProperty("uploadedBy", m.uploadedBy);
            w.WriteProperty("createdAt", Fmt.Stamp(m.createdAt));
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, rows.Count, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create, Upload = true)]
    [Description("上传媒体")]
    public async void Upload() {
        long size = this.ctx.UploadSize();
        string safe = Validator.SafeFileName(this.In("name"));
        string spool = this.ctx.TakeUpload();
        if (spool.Length == 0) { this.Fail(400, "0004", "没有上传内容"); }
        string dest = "";
        bool published = false;
        bool committing = false;
        try {
            if (size <= 0) { this.Fail(400, "0004", "上传内容为空"); }
            if (safe.Length > 255) { this.Fail(400, "0004", "文件名过长"); }
            string ext = ExtOf(safe);
            if (!Validator.ExtAllowed(safe.ToLower(), Allowed)) {
                if (ext.Length > 0) { this.Fail(400, "0004", "不支持的文件类型 ." + ext); }
                this.Fail(400, "0004", "文件缺少扩展名");
            }
            byte[] random = RandomNumberGenerator.GetBytes(16);
            if (random == null) { throw new IOException("无法分配媒体文件名"); }
            SysMediaFile m = new SysMediaFile();
            m.name = safe;
            m.path = Hex.Encode(random, 16) + "." + ext;
            m.ext = ext;
            m.size = size;
            m.uploadedBy = this.who != null ? this.who.username : "";
            m.createdAt = WebApp.NowSeconds();
            string storedPath = m.path;
            dest = Path.Combine(MediaDir, storedPath);
            if (size > StaticFiles.MaxFileBytes && this.UsesBuiltInMediaMount(storedPath, dest)) {
                this.Fail(413, "0004", "媒体文件超过静态资源服务的 4 MiB 上限");
            }
            if (!await this.Begin()) { this.Fail(503, "2001", "数据库不可用"); }
            if (await this.SysMediaFile.Where(a => a.path == storedPath).AnyAsync()) {
                throw new IOException("媒体路径已分配 " + dest);
            }
            long gate = this.LockMedia();
            try {
                MoveMedia(spool, dest);
                published = true;
            } finally {
                File.Unlock(gate);
            }
            int inserted = await this.SysMediaFile.Insert(m).ExecuteAffrowsAsync();
            if (inserted != 1) { throw new Exception("媒体记录未写入"); }
            committing = true;
            await this.Commit();
        } catch (Exception ex) {
            await this.RollbackMedia();
            if (published) {
                if (committing) { ReportMediaIssue("upload commit unconfirmed, retained " + dest); }
                else { RemoveFile(dest); }
            }
            throw;
        } finally {
            RemoveFile(spool);
        }
        await this.AuditMedia("上传媒体", safe);
        this.Saved("已上传 " + safe);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除媒体")]
    public async void Delete() {
        int id = this.InAnyInt("id", 0);
        if (!this.DbReady()) { this.Fail(503, "2001", "数据库不可用"); }
        long gate = LockMedia();
        string name = "";
        string disk = "";
        string staged = "";
        string foldedPath = "";
        bool committing = false;
        try {
            SysMediaFile m = await this.SysMediaFile.ById(id);
            if (m == null) { this.Fail(404, "0404", "文件不存在"); }
            name = m.name;
            string storedPath = m.path;
            if (storedPath.Length == 0 || storedPath != Validator.SafeFileName(storedPath)) {
                throw new IOException("媒体记录的文件名无效");
            }
            disk = Path.Combine(MediaDir, storedPath);
            if (Directory.Exists(disk) || File.IsReparsePoint(disk)) {
                throw new IOException("媒体记录未指向普通文件");
            }
            // 旧记录可能共用原文件名。最后一条引用删除时才移动文件。
            foldedPath = storedPath.ToLower();
            bool shared = await this.SysMediaFile.Where(a => a.id != id)
                .Where(a => a.path.ToLower() == foldedPath).AnyAsync();
            if (!await this.Begin()) { this.Fail(503, "2001", "数据库不可用"); }
            int deleted = await this.SysMediaFile.Delete().Where(a => a.id == id)
                .Where(a => a.path == storedPath).ExecuteAffrowsAsync();
            if (deleted == 0) { this.Fail(409, "1005", "媒体记录已变更，请刷新后重试"); }
            if (deleted != 1) { throw new Exception("媒体记录未删除"); }
            if (!shared) { staged = StageDeletedFile(id, storedPath, disk); }
            committing = true;
            await this.Commit();
            if (staged.Length > 0) { RemoveFile(staged); }
        } catch (Exception ex) {
            bool rolledBack = await this.RollbackMedia();
            if (staged.Length > 0) {
                if (!committing) {
                    RestoreFile(disk, staged);
                } else if (rolledBack) {
                    await this.ReconcileDelete(foldedPath, disk, staged);
                } else {
                    ReportMediaIssue("delete commit unconfirmed, retained " + staged);
                }
            }
            throw;
        } finally {
            File.Unlock(gate);
        }
        await this.AuditMedia("删除媒体", name);
        this.Saved("文件已删除");
    }

    private bool UsesBuiltInMediaMount(string storedPath, string disk) {
        WebApp app = this.ctx.App();
        if (app == null) { return false; }
        string url = MediaUrl + storedPath;
        List<StaticMount> mounts = app.StaticMounts();
        for (int i = 0; i < mounts.Count; i = i + 1) {
            StaticMount mount = mounts[i];
            string rel = StaticFiles.RelativeTo(url, mount.Prefix());
            if (rel == null) { continue; }
            // ServeStatic uses the first matching mount. Compare the resolved file.
            string served = Path.GetFullPath(mount.Root() + "/" + rel);
            string published = Path.GetFullPath(disk);
            #if WINDOWS
            return served.ToLower() == published.ToLower();
            #else
            return served == published;
            #endif
        }
        return false;
    }

    private async void ReconcileDelete(string foldedPath, string disk, string staged) {
        try {
            // ROLLBACK acknowledgement ends the old transaction but can also follow
            // a successful COMMIT. Discard that session before reading the primary.
            this.DiscardLease();
            IDbConnection db = await this.Conn();
            if (db == null) {
                ReportMediaIssue("delete verification unavailable, retained " + staged);
                return;
            }
            bool referenced = await this.SysMediaFile.Where(a => a.path.ToLower() == foldedPath).AnyAsync();
            if (referenced) { RestoreFile(disk, staged); }
            else { RemoveFile(staged); }
        } catch (Exception ex) {
            ReportMediaIssue("delete verification failed, retained " + staged + " - " + ex.Message);
        }
    }

    private long LockMedia() {
        Directory.CreateDirectoryRecursive(DeleteDir);
        // 多个 worker 共用媒体目录，串行处理文件发布、旧引用和补偿。
        long gate = File.TryLock(Path.Combine(DeleteDir, ".lock"));
        if (gate == 0) { this.Fail(409, "1005", "媒体文件正在处理，请稍后重试"); }
        return gate;
    }

    // 调用方持有媒体目录锁。发布与恢复都只移动到空闲路径。
    private static void MoveMedia(string source, string dest) {
        if (File.Exists(dest) || Directory.Exists(dest) || File.IsReparsePoint(dest)) {
            throw new IOException("媒体路径已存在 " + dest);
        }
        File.Move(source, dest);
    }

    private static string StageDeletedFile(int id, string path, string disk) {
        string staged = Path.Combine(DeleteDir, Convert.ToString(id) + "-" + Hex.Encode(Sha256.Hash(path), 32));
        if (Directory.Exists(staged) || File.IsReparsePoint(staged)) {
            throw new IOException("媒体删除暂存路径无效");
        }
        if (File.Exists(staged)) {
            if (File.Exists(disk)) { throw new IOException("媒体删除暂存文件待处理 " + staged); }
            return staged;
        }
        if (!File.Exists(disk)) { return ""; }
        MoveMedia(disk, staged);
        return staged;
    }

    private static void RestoreFile(string disk, string staged) {
        try { MoveMedia(staged, disk); }
        catch (Exception ex) {
            ReportMediaIssue("could not restore " + disk + " from " + staged + " - " + ex.Message);
        }
    }

    private static void RemoveFile(string path) {
        try {
            File.Delete(path);
            if (File.Exists(path) || File.IsReparsePoint(path)) {
                ReportMediaIssue("could not remove " + path);
            }
        } catch (Exception ex) {
            ReportMediaIssue("could not remove " + path + " - " + ex.Message);
        }
    }

    private static void ReportMediaIssue(string message) {
        try { Log.Error("[media] " + message); }
        catch (Exception ex) { }
    }

    private async bool RollbackMedia() {
        try {
            await this.Rollback();
            return true;
        } catch (Exception ex) {
            ReportMediaIssue("rollback failed: " + ex.Message);
            return false;
        }
    }

    private async void AuditMedia(string title, string name) {
        try { await this.Note(title, name, true, ""); }
        catch (Exception ex) { ReportMediaIssue("audit failed: " + ex.Message); }
    }

    /* 取最后一个点之后的扩展名并转小写；无点或点在末尾视为无扩展名。 */
    private static string ExtOf(string name) {
        int dot = 0 - 1;
        for (int i = 0; i < name.Length; i = i + 1) {
            if (name[i] == 46) { dot = i; }
        }
        if (dot < 0 || dot >= name.Length - 1) { return ""; }
        return name.Substring(dot + 1).ToLower();
    }
}
