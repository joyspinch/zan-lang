using System;
using System.Collections.Generic;
using System.Json;
using Zan.Web.Core;
using Zan.Web.Model;
using Zan.Web.Security;
using Zan.Web.Services;
using Zan.Web;
using System.Web;

namespace Zan.Web.Api;

/* 管理端纯 JSON API（继承无 HTML 视图耦合的 AdminApiController）：
   菜单（权限过滤与扩展钩子处理后）与仪表盘摘要，统一答 {code,msg,data,traceId}。
   菜单复用当前请求租约 this.Held() 查询权限，避免池耗尽下嵌套借用连接。 */
[Route("api/admin/[action]")]
[Custom(Authorization = CustomAuthorization.Login)]
[Description("管理壳")]
public class AdminApiController : Zan.Web.AdminApiController {
    [HttpGet]
    [Description("侧边栏菜单")]
    public async void Menu() {
        List<MenuNode> nodes = await MenuService.ForUser(
            WebHost.Current(), this.uid, this.Ctx().Path(), this.Held());
        List<MenuNodeDoc> outp = new List<MenuNodeDoc>();
        for (int i = 0; i < nodes.Count; i = i + 1) {
            MenuNode n = nodes[i];
            outp.Add(new MenuNodeDoc(
                n.Title(), n.Path(), n.Group(), n.Icon(), n.Active()));
        }
        this.Ok(Json.Serialize<List<MenuNodeDoc>>(outp));
    }

    [HttpGet]
    [Description("仪表盘摘要")]
    public async void Summary() {
        JsonDoc m = JsonDoc.Parse(WebHost.Current().MetricsJson());
        long uptimeMs = m != null ? m.PathLong("uptime_ms", 0L) : 0L;
        long reqCount = m != null ? m.PathLong("requests.count", 0L) : 0L;
        long reqErrors = m != null ? m.PathLong("requests.errors", 0L) : 0L;
        long reqAvgUs = m != null ? m.PathLong("requests.avg_us", 0L) : 0L;

        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("uptime", Fmt.Uptime(uptimeMs));
        w.WriteProperty("requests", reqCount);
        w.WriteProperty("errors", reqErrors);
        w.WriteProperty("avg_us", reqAvgUs);

        w.WritePropertyName("db");
        w.WriteStartObject();
        if (this.DbReady()) {
            w.WriteProperty("ok", true);
            w.WriteEndObject();

            DataScope sc = await this.Scope();
            List<int> scoped = sc.Depts();
            int mine = sc.UserId();
            int users = await this.SysUser
                .WhereIf(sc.ByDept(), a => scoped.Contains(a.departmentId))
                .WhereIf(sc.Mine(), a => a.id == mine)
                .CountAsync();

            w.WriteProperty("users", users);
            if (MvcHooks.HasSummaryHooks()) {
                Dictionary<string, string> extra = new Dictionary<string, string>();
                await MvcHooks.RunSummaryHooks(this.Held(), sc, extra);
                List<string> keys = extra.Keys;
                for (int i = 0; i < keys.Count; i = i + 1) {
                    string k = keys[i];
                    if (k == null || k.Length == 0 || k == "users" || k == "db"
                        || k == "uptime" || k == "requests" || k == "errors" || k == "avg_us") {
                        continue;
                    }
                    string v = "";
                    extra.TryGetValue(k, out v);
                    w.WriteProperty(k, v == null ? "" : v);
                }
            }
        } else {
            w.WriteProperty("ok", false);
            w.WriteEndObject();
        }
        w.WriteEndObject();
        this.Ok(w.ToString());
    }
}
