    [HttpPut]
    [Custom(Perm = PermBit.Update)]
    [Description("角色授权矩阵配置")]
    public void GrantConf() {
        List<string> screens = Perm.Screens();
        List<int> order = Perm.Order();
        List<string> gaps = Perm.Unmarked();

        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("title", "角色权限配置");
        w.WriteProperty("width", "860px");
        w.WriteProperty("labelWidth", 90);
        w.WriteProperty("cols", 24);
        w.WritePropertyName("formItems");
        w.WriteStartArray();

        w.WriteStartObject();
        w.WriteProperty("field", "permIds");
        w.WriteProperty("label", "功能权限");
        w.WriteProperty("component", "perm-matrix");
        w.WriteProperty("customType", "perm-matrix");
        w.WriteProperty("span", 24);
        w.WritePropertyName("props");
        w.WriteStartObject();
        if (gaps.Count > 0) {
            w.WriteProperty("unmarked", Perm.Join(gaps, 20));
        }
        w.WritePropertyName("screens");
        w.WriteStartArray();
        for (int i = 0; i < screens.Count; i = i + 1) {
            string screen = screens[i];
            int exists = Perm.MaskOf(screen);
            w.WriteStartObject();
            w.WriteProperty("screen", screen);
            w.WriteProperty("name", Perm.TitleOf(screen));
            w.WritePropertyName("bits");
            w.WriteStartArray();
            for (int b = 0; b < order.Count; b = b + 1) {
                int bit = order[b];
                if ((exists & bit) == 0) { continue; }
                w.WriteStartObject();
                w.WriteProperty("bit", bit);
                w.WriteProperty("name", Perm.BitName(bit));
                w.WriteProperty("value", screen + ":" + Convert.ToString(bit));
                w.WriteEndObject();
            }
            w.WriteEndArray();
            w.WriteEndObject();
        }
        w.WriteEndArray();
        w.WriteEndObject();
        w.WriteEndObject();

        w.WriteEndArray();
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("角色授权回显")]
    public async void GrantEdit() {
        int id = this.InAnyInt("id", 0);
        SysRole r = await this.Find(id);
        List<SysRoleGrant> held = await this.SysRoleGrant
            .Where(a => a.roleId == r.id).ToListAsync();
        List<string> screens = Perm.Screens();
        List<int> order = Perm.Order();
        StringBuilder picked = new StringBuilder();
        for (int i = 0; i < screens.Count; i = i + 1) {
            string screen = screens[i];
            int exists = Perm.MaskOf(screen);
            int mine = 0;
            for (int j = 0; j < held.Count; j = j + 1) {
                if (held[j].action == screen) { mine = mine | held[j].mask; }
            }
            for (int b = 0; b < order.Count; b = b + 1) {
                int bit = order[b];
                if ((exists & bit) == 0 || (mine & bit) == 0) { continue; }
                if (picked.Length > 0) { picked.Append(","); }
                picked.Append(screen + ":" + Convert.ToString(bit));
            }
        }
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", r.id);
        w.WriteProperty("permIds", picked.ToString());
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    private static async Dictionary<int, int> CountByRole(Select query, List<int> ids) {
        query.WhereIn("roleId", ids);
        string key = query.RequireCol("roleId");
        query.GroupBy(key);
        DbResult groups = await query.AggRAsync(key + ", COUNT(" + key + ")");
        Dictionary<int, int> counts = new Dictionary<int, int>();
        if (groups == null) { return counts; }
        for (int i = 0; i < groups.RowCount(); i = i + 1) {
            counts[groups.GetInt(i, 0)] = groups.GetInt(i, 1);
        }
        return counts;
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存角色")]
    public async void Save() {
        int id = this.InAnyInt("id", 0);
        if (!await this.Can(id > 0 ? (int)PermBit.Update : (int)PermBit.Create)) {
            this.Fail(403, "0403", "无操作权限"); return;
        }
        string name = this.NeedAny("name", "角色名称");
        string code = this.NeedAny("code", "角色标识");
        int rank = this.InAnyInt("rank", 10);
        int status = this.InAnyInt("status", 1);
        string description = this.InAny("description");
        if (status != 1) { status = 0; }
        int dataScope = this.InAnyInt("dataScope", 0);
        if (dataScope < DataScope.RoleAll || dataScope > DataScope.RoleCustom) {
            this.Fail(400, Codes.BadInput, "请选择有效的数据权限范围");
            return;
        }
        /* 仅自定义保留部门列表，切离不会留下后续重用的旧集。 */
        string scopeDepts = "";
        if (dataScope == DataScope.RoleCustom) {
            scopeDepts = await this.ScopeDepts(this.InAny("scopeDepts"));
            if (scopeDepts.Length == 0) {
                this.Fail(400, Codes.BadInput, "自定义数据权限至少要选一个部门");
            }
        }

        SysRole clash = await this.SysRole.Where(a => a.code == code).FirstAsync();
        if (clash != null && clash.id != id) {
            this.Fail(400, Codes.Conflict, "角色标识 " + code + " 已存在");
        }
        SysRole r = id > 0 ? await this.Find(id) : new SysRole();
        r.name = name;
        r.code = code;
        r.rank = rank;
        r.status = status;
        r.description = description;
        r.dataScope = dataScope;
        r.scopeDepts = scopeDepts;
        r.updatedAt = (long)WebApp.NowSeconds();
        if (id > 0) {
            int n = await this.SysRole.Update(r).ExecuteAffrowsAsync();
            await this.RefreshRoles();
            await this.Note("编辑角色", code, n > 0, "");
            this.Saved("角色已保存");
            return;
        }
        r.createdAt = r.updatedAt;
        int newId = await this.SysRole.Insert(r).ExecuteIdentityAsync();
        await this.RefreshRoles();
        await this.Note("新增角色", code, newId > 0, "");
        this.Saved("角色已创建");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除角色")]
    public async void Delete() {
        int id = this.InAnyInt("id", 0);
        if (id <= 0) {
            List<int> ids = this.Ids("ids");
            if (ids.Count > 0) { id = ids[0]; }
        }
        SysRole r = await this.Find(id);
        int held = await this.SysUserRole.Where(a => a.roleId == id).CountAsync();
        if (held > 0) {
            this.Fail(400, Codes.Conflict, "还有 " + Convert.ToString(held)
                + " 个账号在使用该角色，请先解除分配");
        }
        if (!await this.Begin()) { this.Fail(503, "2001", "数据库不可用"); }
        int n = await this.SysRole.Delete().Where(a => a.id == id).ExecuteAffrowsAsync();
        int _g = await this.SysRoleGrant.Delete().Where(a => a.roleId == id)
            .ExecuteAffrowsAsync();
        await this.Commit();
        await this.RefreshRoles();
        await this.Note("删除角色", r.code, n > 0, "");
        this.Saved("角色已删除");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("保存角色授权")]
    public async void GrantSave() {
        int id = this.InAnyInt("id", 0);
        SysRole r = await this.Find(id);
        string picked = this.InAny("permIds");
        if (!await this.Begin()) { this.Fail(503, "2001", "数据库不可用"); }
        int _cleared = await this.SysRoleGrant.Delete()
            .Where(a => a.roleId == id).ExecuteAffrowsAsync();

        /* 仅存在的位可授权：表单提交"screen:bit"对，路由表没有的（未注册屏幕、无动作按钮）为伪造字段，丢弃而非入库。 */
        long now = WebApp.NowSeconds();
        List<string> screens = Perm.Screens();
        List<int> order = Perm.Order();
        int granted = 0;
        for (int i = 0; i < screens.Count; i = i + 1) {
            string screen = screens[i];
            int exists = Perm.MaskOf(screen);
            int mask = 0;
            for (int b = 0; b < order.Count; b = b + 1) {
                int bit = order[b];
                if ((exists & bit) == 0) { continue; }
                if (!AuthUser.Holds(picked, screen + ":" + Convert.ToString(bit))) {
                    continue;
                }
                mask = mask | bit;
            }
            if (mask == 0) { continue; }
            SysRoleGrant g = new SysRoleGrant();
            g.roleId = id;
            g.action = screen;
            g.mask = mask;
            g.createdAt = now;
            int inserted = await this.SysRoleGrant.Insert(g).ExecuteAffrowsAsync();
            if (inserted != 1) { throw new Exception("role grant was not saved"); }
            granted = granted + 1;
        }
        await this.Commit();
        await this.RefreshRoles();
        await this.Note("角色授权", r.code, true,
            Convert.ToString(granted) + " 项权限");
        this.Saved("授权已保存");
    }

    private async void RefreshRoles() {
        await AuthUser.RolesChanged(this.Held());
    }

    private async SysRole Find(int id) {
        SysRole r = await this.SysRole.Where(a => a.id == id).FirstAsync();
        if (r == null) { this.Fail(404, Codes.NotFound, "角色不存在"); }
        return r;
    }

    /* 提交的部门存作 ",3,7,"；只保留存在的——防止伪造部门 id 写进 scope。 */
    private async string ScopeDepts(string picked) {
        List<SysDepartment> all = await this.SysDepartment.All();
        StringBuilder outp = new StringBuilder();
        outp.Append(",");
        int kept = 0;
        for (int i = 0; i < all.Count; i = i + 1) {
            string id = Convert.ToString(all[i].id);
            if (!AuthUser.Holds(picked, id)) { continue; }
            outp.Append(id);
            outp.Append(",");
            kept = kept + 1;
        }
        if (kept == 0) { return ""; }
        return outp.ToString();
    }

}
