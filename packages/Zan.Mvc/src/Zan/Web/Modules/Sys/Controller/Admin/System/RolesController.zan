using System;
using System.Data;
using System.Data.Orm;
using System.Json;
using System.Web;
using Zan.Web.AdminUi;
using Zan.Web.Core;
using Zan.Web.Dao;
using Zan.Web.Model;
using Zan.Web.Security;
using Zan.Web;

namespace Zan.Web.Admin.System;

/* /admin/system/roles 角色管理，以及决定每个角色可做什么的屏幕；角色是权利的唯一载体：账号得角色、角色得路由动作、调度器每请求问这张图。故授权对话框为带勾的路由表——可授即存在的动作，新屏幕一编译即可授权，删掉的自动消失。 */
[Custom(Authorization = CustomAuthorization.Grant, Group = "系统管理", GroupOrder = 90)]
[Description("角色管理")]
public class RolesController : AdminController {
    [HttpGet]
    [Custom(IsMenu = true, Icon = "mdi:shield-account", Perm = PermBit.View)]
    [Description("角色管理")]
    public void Index() {
        this.Conf();
    }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("角色表格配置")]
    public void Conf() {
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("PageType", "table");

        w.WritePropertyName("Conf");
        w.WriteStartObject();
        w.WriteProperty("showPages", true);
        w.WriteProperty("pageSize", 20);
        w.WriteProperty("pageSizes", "10,20,50,100");
        w.WriteProperty("Local", false);
        w.WriteProperty("TreeData", false);
        w.WriteProperty("import", false);
        w.WriteProperty("export", true);
        w.WriteProperty("innerKey", "id");
        w.WriteProperty("innerName", "角色");
        w.WriteEndObject();

        w.WritePropertyName("Columns");
        w.WriteStartArray();
        WriteRoleCol(w, "ID", "id", "number", 70, "");
        WriteRoleCol(w, "角色名称", "name", "text", 140, "");
        WriteRoleCol(w, "角色标识", "code", "text", 130, "");
        WriteRoleCol(w, "排序", "rank", "number", 80, "");
        WriteRoleCol(w, "数据范围", "dataScope", "dict", 130, "0=全部数据,1=本部门及以下,2=仅本部门,3=仅本人,4=自定义部门");
        WriteRoleCol(w, "权限数", "perms", "number", 85, "");
        WriteRoleCol(w, "账号数", "users", "number", 85, "");
        WriteRoleCol(w, "状态", "status", "dict", 90, "1=启用,0=禁用");
        WriteRoleCol(w, "说明", "description", "text", 200, "");
        w.WriteEndArray();

        w.WritePropertyName("Filters");
        w.WriteStartArray();
        w.WriteStartObject();
        w.WriteProperty("Name", "角色名称");
        w.WriteProperty("Field", "kw");
        w.WriteProperty("Type", "Input");
        w.WriteProperty("placeholder", "搜索角色名称");
        w.WriteEndObject();
        w.WriteEndArray();

        w.WritePropertyName("FilterRight");
        w.WriteStartArray();
        w.WriteEndArray();

        w.WritePropertyName("Tools");
        w.WriteStartArray();
        AdminUiProtocol.WriteFormAction(w, "新增角色", "Add", "primary", "formconf", "save", false);
        AdminUiProtocol.WriteFormActionEx(w, "编辑", "Edit", "info", "formconf", "edit", "save", true);
        AdminUiProtocol.WriteFormActionEx(w, "权限配置", "Grant", "warning", "grantconf", "grantedit", "grantsave", true);
        AdminUiProtocol.WriteConfirmAction(w, "删除", "Delete", "danger", "delete", "删除后不可恢复，确认删除所选角色吗？", true, false, "", "id={id}");
        w.WriteEndArray();

        w.WritePropertyName("MenuItems");
        w.WriteStartArray();
        AdminUiProtocol.WriteDetailAction(w, "查看详情", "");
        AdminUiProtocol.WriteFormActionEx(w, "编辑", "Edit", "info", "formconf", "edit", "save", true);
        AdminUiProtocol.WriteFormActionEx(w, "权限配置", "Grant", "warning", "grantconf", "grantedit", "grantsave", true);
        AdminUiProtocol.WriteConfirmAction(w, "删除", "Delete", "danger", "delete", "删除后不可恢复，确认删除该角色吗？", true, false, "", "id={id}");
        w.WriteEndArray();

        w.WritePropertyName("Tabs");
        w.WriteStartArray();
        w.WriteEndArray();

        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    private static void WriteRoleCol(JsonWriter w, string header, string field, string type, int width, string opts) {
        w.WriteStartObject();
        w.WriteProperty("headerName", header);
        w.WriteProperty("field", field);
        w.WriteProperty("type", type);
        w.WriteProperty("width", width);
        if (opts.Length > 0) {
            w.WritePropertyName("options");
            AdminUiProtocol.WriteOptArray(w, opts);
        }
        w.WriteEndObject();
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("角色列表数据")]
    public async void List() {
        if (!this.DataReady()) { return; }
        ListQuery q = this.PagedAny("rank", 20);
        string kw = q.Kw();
        int total = await this.SysRole
            .WhereIf(kw.Length > 0, a => a.name.Contains(kw)).CountAsync();
        List<SysRole> rows = await this.SysRole
            .WhereIf(kw.Length > 0, a => a.name.Contains(kw))
            .OrderBy(a => a.rank).Skip(q.Skip()).Take(q.Limit()).ToListAsync();

        Dictionary<int, int> permCounts = new Dictionary<int, int>();
        Dictionary<int, int> userCounts = new Dictionary<int, int>();
        if (rows.Count > 0) {
            List<int> ids = new List<int>();
            for (int i = 0; i < rows.Count; i = i + 1) { ids.Add(rows[i].id); }
            IDbConnection db = this.Held();
            permCounts = await CountByRole(db.Select<SysRoleGrant>().inner, ids);
            userCounts = await CountByRole(db.Select<SysUserRole>().inner, ids);
        }

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            SysRole r = rows[i];
            int perms = 0;
            int users = 0;
            permCounts.TryGetValue(r.id, out perms);
            userCounts.TryGetValue(r.id, out users);
            w.WriteStartObject();
            w.WriteProperty("id", r.id);
            w.WriteProperty("name", r.name);
            w.WriteProperty("code", r.code);
            w.WriteProperty("rank", r.rank);
            w.WriteProperty("dataScope", Convert.ToString(r.dataScope));
            w.WriteProperty("perms", perms);
            w.WriteProperty("users", users);
            w.WriteProperty("status", Convert.ToString(r.status));
            w.WriteProperty("description", r.description);
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, total, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("角色编辑回显")]
    public async void Edit() {
        int id = this.InAnyInt("id", 0);
        SysRole r = await this.Find(id);
        int scope = r.dataScope;
        if (scope < DataScope.RoleAll || scope > DataScope.RoleCustom) { scope = DataScope.RoleSelf; }
        string picked = Fmt.Text(r.scopeDepts, "");
        List<SysDepartment> depts = await this.SysDepartment.OrderBy(a => a.sortOrder).ToListAsync();

        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", r.id);
        w.WriteProperty("name", r.name);
        w.WriteProperty("code", r.code);
        w.WriteProperty("rank", r.rank);
        w.WriteProperty("status", Convert.ToString(r.status));
        w.WriteProperty("dataScope", Convert.ToString(scope));
        w.WriteProperty("description", r.description);
        w.WritePropertyName("scopeDepts");
        w.WriteStartArray();
        for (int i = 0; i < depts.Count; i = i + 1) {
            string did = Convert.ToString(depts[i].id);
            if (AuthUser.Holds(picked, did)) { w.WriteString(did); }
        }
        w.WriteEndArray();
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

