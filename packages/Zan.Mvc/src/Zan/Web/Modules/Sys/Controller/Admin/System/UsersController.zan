    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("分配角色数据回显")]
    public async void RolesEdit() {
        int id = this.InAnyInt("id", 0);
        SysUser u = await this.Reach(id);
        List<SysUserRole> mine = await this.SysUserRole.Where(a => a.userId == u.id).ToListAsync();
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", u.id);
        w.WritePropertyName("roleIds");
        w.WriteStartArray();
        for (int i = 0; i < mine.Count; i = i + 1) {
            w.WriteString(Convert.ToString(mine[i].roleId));
        }
        w.WriteEndArray();
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPut]
    [Custom(Perm = PermBit.Update)]
    [Description("数据范围表单配置")]
    public async void ScopesConf() {
        List<GrantDomain> domains = DataGrant.All();
        DataScope callerScope = await this.Scope();
        int callerId = Filter.ToInt(this.uid, 0);
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("title", "分配数据范围");
        w.WriteProperty("width", "600px");
        w.WriteProperty("labelWidth", 100);
        w.WriteProperty("cols", 24);
        w.WritePropertyName("formItems");
        w.WriteStartArray();
        for (int i = 0; i < domains.Count; i = i + 1) {
            GrantDomain g = domains[i];
            RowScope allowedScope = await DataGrant.Of(this.Held(), callerId, g.key, callerScope);
            string opts = await DataGrant.Options(this.Held(), g.key, allowedScope, 300);
            w.WriteStartObject();
            w.WriteProperty("field", "scope_" + g.key);
            w.WriteProperty("label", g.label);
            w.WriteProperty("component", "checkbox-group");
            w.WriteProperty("span", 24);
            w.WritePropertyName("options");
            AdminUiProtocol.WriteOptArray(w, opts);
            w.WriteEndObject();
        }
        if (domains.Count == 0) {
            WriteFormField(w, "_hint", "提示", "input", 24, false, "", "当前应用未注册业务资源域（DataGrant.Define）");
        }
        w.WriteEndArray();
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("数据范围数据回显")]
    public async void ScopesEdit() {
        int id = this.InAnyInt("id", 0);
        SysUser u = await this.Reach(id);
        List<SysUserScope> mine = await DataGrant.OfUser(this.Held(), u.id);
        List<GrantDomain> domains = DataGrant.All();
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", u.id);
        for (int i = 0; i < domains.Count; i = i + 1) {
            GrantDomain g = domains[i];
            w.WritePropertyName("scope_" + g.key);
            w.WriteStartArray();
            for (int j = 0; j < mine.Count; j = j + 1) {
                if (mine[j].scopeKey == g.key) {
                    w.WriteString(Convert.ToString(mine[j].resourceId));
                }
            }
            w.WriteEndArray();
        }
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    /* 单行单字段编辑（conf 契约的 field 端点）：行级授权走 Reach（越权
       与不存在同答 404），列白名单出自 EditFields——密码散列、token
       版本等凭证材料不在名单，永远无法经此篡改。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("编辑账号字段")]
    public async void Field() {
        int id = this.InAnyInt("id", 0);
        if (id <= 0) {
            JsonDoc doc = this.Ctx().JsonDoc();
            if (doc != null) {
                int dataSlot = doc.Get(doc.root, "data");
                if (dataSlot >= 0) {
                    int idSlot = doc.Get(dataSlot, "id");
                    if (idSlot >= 0) { id = doc.IntAt(idSlot, 0); }
                }
            }
        }
        SysUser u = await this.Reach(id);
        List<int> allowed = new List<int>();
        allowed.Add(u.id);
        await CrudOps.Field(this, ScreenDef(), "账号",
            this.InAny("field").Trim(), this.InAny("value"), allowed);
    }

    /* 新建/编辑对话框；片段非页，列表不动、对话框覆盖其上。 */
    /* 一份声明：Form 渲染与 Save 校验同源（新增/编辑屏 = 声明 + 两动作）。
       部门选项由调用方查询传入（Save 校验用不到，传空列表即可）。 */
    private static FormPage UserForm(List<StrMap> deptRows) {
        return FormPage.Of("/admin/system/users/save")
            .Text("账号", "username").Req().Max(32).Ph("登录名")
            .Text("姓名", "nickname").Max(32)
            .Text("邮箱", "email").Max(64)
            .Text("手机", "mobile").Max(20)
            .SelectList("部门", "departmentId", deptRows).Blank("未分配")
            .Select("状态", "status", "1=启用,0=禁用").Val("1")
            .Pass("初始密码", "password").Min(8).Req().Ph("至少 8 位").OnlyNew()
            .Hint("修改密码请在列表中使用「重置密码」。").OnlyEdit();
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存账号")]
    public async void Save() {
        int id = this.InAnyInt("id", 0);
        if (!await this.Can(id > 0 ? (int)PermBit.Update : (int)PermBit.Create)) {
            this.Fail(403, "0403", "无操作权限"); return;
        }
        /* 声明即校验：与 Form 渲染同一份约束（required/min/max），
           初始密码规则（新增才必填、至少 8 位）也出自声明。 */
        FormPage fp = UserForm(new List<StrMap>());
        fp.Id(Convert.ToString(id));
        string invalid = fp.Validate(this);
        if (invalid.Length > 0) { this.Fail(400, "0004", invalid); }
        string username = this.NeedAny("username", "账号");
        string nickname = this.InAny("nickname");
        string email = this.InAny("email");
        string mobile = this.InAny("mobile");
        int departmentId = this.InAnyInt("departmentId", 0);
        int status = this.InAnyInt("status", 1);
        string password = this.InAny("password");
        if (status != 1) { status = 0; }

        SysUser clash = await this.SysUser.ByUsername(username);
        if (clash != null && clash.id != id) {
            this.Fail(400, "0004", "账号 " + username + " 已存在");
        }
        /* 两端皆校验：被编账号在 scope 内、归档到的部门也在——否则操作员可将账号移出自己范围。 */
        if (id > 0) { SysUser _t = await this.Reach(id); }
        await this.Reachable(departmentId);

        if (id > 0) {
            int n = await this.SysUser.UpdateProfile(id, username, nickname, email, mobile, departmentId, status, WebApp.NowSeconds());
            /* 禁用账号须使其已持会话失效，否则禁令只对下次登录生效。 */
            if (status == 0) { await this.Revoke(id); }
            AuthUser.Forget(Convert.ToString(id));
            await this.Note("编辑账号", "#" + Convert.ToString(id)
                + " " + username, n > 0, "");
            this.Saved("账号已保存");
            return;
        }

        SysUser u = new SysUser();
        u.username = username;
        u.nickname = nickname;
        u.email = email;
        u.mobile = mobile;
        u.departmentId = departmentId;
        u.passwordHash = AuthUser.NewHash(password);
        u.status = status;
        u.isSuper = 0;
        u.tokenVersion = 1;
        u.createdAt = WebApp.NowSeconds();
        u.updatedAt = u.createdAt;
        int newId = await this.SysUser.Insert(u).ExecuteIdentityAsync();
        await this.Note("新增账号",
            "#" + Convert.ToString(newId) + " " + username, newId > 0, "");
        this.Saved("账号已创建");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除账号")]
    public async void Delete() {
        int id = this.InAnyInt("id", 0);
        SysUser u = await this.Reach(id);
        if (u.isSuper == 1) {
            this.Fail(400, "0004", "超级管理员账号不能删除");
        }
        SysUser me = await this.Admin();
        if (me != null && me.id == id) {
            this.Fail(400, "0004", "不能删除当前登录的账号");
        }
        int n = await this.SysUser.Delete().Where(a => a.id == id).ExecuteAffrowsAsync();
        int _r = await this.SysUserRole.Delete().Where(a => a.userId == id).ExecuteAffrowsAsync();
        AuthUser.Forget(Convert.ToString(id));
        await this.Note("删除账号",
            "#" + Convert.ToString(id) + " " + u.username, n > 0, "");
        this.Saved("账号已删除");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("启用或禁用账号")]
    public async void Status() {
        int id = this.InAnyInt("id", 0);
        int status = this.InAnyInt("status", 1);
        if (status != 1) { status = 0; }
        SysUser u = await this.Reach(id);
        if (u.isSuper == 1 && status == 0) {
            this.Fail(400, "0004", "超级管理员账号不能禁用");
        }
        int n = await this.SysUser.SetStatus(id, status);
        if (status == 0) { await this.Revoke(id); }
        AuthUser.Forget(Convert.ToString(id));
        await this.Note("启用或禁用账号",
            "#" + Convert.ToString(id) + " " + u.username, n > 0,
            Fmt.EnabledText(status));
        if (status == 1) { this.Saved("账号已启用"); return; }
        this.Saved("账号已禁用，其登录状态同时失效");
    }

    /* 批量启禁：工具栏对勾选行一次提交（ids=1,2,3）。越权行零容忍——
       名单里有超管或（禁用时的）本人即整体拒绝，不做"能做多少做多少"
       的部分成功，避免操作者误以为全部生效。 */
    /* 批量操作：工具栏对勾选行一次提交（ids=1,2,3），value 空=删除、
       1/0=启禁——与框架网关同一个 batch 端点、同一线缆契约。入口放宽为
       Update|Delete，分支内复核各自的权限位。越权行零容忍——名单里有
       超管或（禁用/删除时的）本人即整体拒绝，不做"能做多少做多少"
       的部分成功，避免操作者误以为全部生效。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update | PermBit.Delete)]
    [Description("账号批量操作（启禁/删除）")]
    public async void Batch() {
        List<int> ids = this.Ids("ids");
        if (ids.Count == 0) { this.Fail(400, "0004", "未选择账号"); return; }
        string value = this.InAny("value");
        int status = value == "1" ? 1 : 0;
        List<SysUser> rows = await this.SysUser.ByIds(ids);
        if (rows.Count == 0) { this.Fail(400, "0004", "所选账号不存在"); return; }
        DataScope sc = await this.Scope();
        SysUser me = await this.Admin();
        for (int i = 0; i < rows.Count; i = i + 1) {
            if (!sc.Covers(rows[i].id, rows[i].departmentId)) {
                this.Fail(404, "0404", "所选账号包含无权操作的记录");
                return;
            }
        }
        if (value.Length == 0) {
            if (!await this.Can(PermBit.Delete)) { this.Fail(403, "0403", "无删除权限"); return; }
            for (int i = 0; i < rows.Count; i = i + 1) {
                if (rows[i].isSuper == 1) {
                    this.Fail(400, "0004", "所选账号包含超级管理员，不能批量删除");
                    return;
                }
                if (me != null && rows[i].id == me.id) {
                    this.Fail(400, "0004", "所选账号包含当前登录账号，不能批量删除");
                    return;
                }
            }
            await CrudOps.Delete(this, ScreenDef(), ids, "批量删除账号");
            for (int i = 0; i < rows.Count; i = i + 1) {
                int _r = await this.SysUserRole.Delete().Where(a => a.userId == rows[i].id).ExecuteAffrowsAsync();
                AuthUser.Forget(Convert.ToString(rows[i].id));
            }
            return;
        }
        if (!await this.Can(PermBit.Update)) { this.Fail(403, "0403", "无编辑权限"); return; }
        for (int i = 0; i < rows.Count; i = i + 1) {
            if (rows[i].isSuper == 1) {
                this.Fail(400, "0004", "所选账号包含超级管理员，不能批量操作");
                return;
            }
            if (status == 0 && me != null && rows[i].id == me.id) {
                this.Fail(400, "0004", "所选账号包含当前登录账号，不能批量禁用");
                return;
            }
        }
        /* 通用批量写动作：白名单（sys_user.status:int）与参数化 SQL 由
           声明供给；禁用会话失效与缓存失效是业务语义，留在屏内。 */
        await CrudOps.Batch(this, ScreenDef(), "status",
            status == 1 ? "1" : "0", ids, "批量启禁账号");
        if (status == 0) {
            for (int i = 0; i < rows.Count; i = i + 1) {
                await this.Revoke(rows[i].id);
                AuthUser.Forget(Convert.ToString(rows[i].id));
            }
        }
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("强制下线")]
    public async void Kick() {
        int id = this.InAnyInt("id", 0);
        SysUser u = await this.Reach(id);
        await this.Revoke(id);
        await this.Note("强制下线",
            "#" + Convert.ToString(id) + " " + u.username, true, "");
        this.Saved("该账号的登录状态已全部失效");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("重置密码")]
    public async void Password() {
        int id = this.InAnyInt("id", 0);
        string password = this.NeedAny("password", "新密码");
        if (password.Length < 8) {
            this.Fail(400, "0004", "密码至少 8 位");
        }
        SysUser u = await this.PasswordTarget(id);
        SysUser me = await this.Admin();
        int n = await this.SysUser.ResetPassword(id, AuthUser.NewHash(password),
            WebApp.NowSeconds(), me.id);
        if (n != 1) { this.Fail(409, Codes.Conflict, "账号状态已变化，请刷新后重试"); return; }
        AuthUser.Forget(Convert.ToString(id));
        await this.Note("重置密码",
            "#" + Convert.ToString(id) + " " + u.username, n > 0, "");
        this.Saved("密码已重置，该账号需要重新登录");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("保存角色分配")]
    public async void RolesSave() {
        int id = this.InAnyInt("id", 0);
        SysUser u = await this.Reach(id);
        string picked = this.InAny("roleIds");
        if (!await this.Begin()) { this.Fail(503, "2001", "数据库不可用"); }
        int _cleared = await this.SysUserRole.Delete().Where(a => a.userId == id).ExecuteAffrowsAsync();
        List<SysRole> roles = await this.SysRole.All();
        int granted = 0;
        for (int i = 0; i < roles.Count; i = i + 1) {
            if (!AuthUser.Holds(picked, Convert.ToString(roles[i].id))) { continue; }
            SysUserRole link = new SysUserRole();
            link.userId = id;
            link.roleId = roles[i].id;
            int inserted = await this.SysUserRole.Insert(link).ExecuteAffrowsAsync();
            if (inserted != 1) { throw new Exception("user role was not saved"); }
            granted = granted + 1;
        }
        await this.Commit();
        AuthUser.Forget(Convert.ToString(id));
        await this.Note("分配角色",
            "#" + Convert.ToString(id) + " " + u.username, true,
            Convert.ToString(granted) + " 个角色");
        this.Saved("角色已保存");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("保存数据范围")]
    public async void ScopesSave() {
        int id = this.InAnyInt("id", 0);
        SysUser u = await this.Reach(id);
        List<GrantDomain> domains = DataGrant.All();
        DataScope callerScope = await this.Scope();
        int callerId = Filter.ToInt(this.uid, 0);
        StringBuilder detail = new StringBuilder();
        for (int i = 0; i < domains.Count; i = i + 1) {
            GrantDomain g = domains[i];
            RowScope allowedScope = await DataGrant.Of(this.Held(), callerId, g.key, callerScope);
            if (allowedScope.Empty()) { continue; }
            List<int> ids = this.IdList("scope_" + g.key);
            if (!allowedScope.all) {
                for (int j = 0; j < ids.Count; j = j + 1) {
                    if (!allowedScope.Allows(ids[j])) {
                        this.Fail(403, "0403", "数据权限不允许授予该" + DataGrant.Label(g.key));
                        return;
                    }
                }
            }
            int n = await DataGrant.Replace(this.Held(), id, g.key, ids);
            if (detail.Length > 0) { detail.Append("；"); }
            detail.Append(Lang.T(g.label) + " " + Convert.ToString(n) + " 项");
        }
        await this.Note("分配数据范围",
            "#" + Convert.ToString(id) + " " + u.username, true, detail.ToString());
        this.Saved("数据范围已保存");
    }

    /* 逗号分隔的 id 串 → 去重正整数列表（复选框组由前端合并为一个字段）。 */
    private List<int> IdList(string name) {
        List<int> outp = new List<int>();
        string csv = this.InAny(name);
        int start = 0;
        int len = csv.Length;
        for (int i = 0; i <= len; i = i + 1) {
            if (i < len && (csv[i] & 255) != 44) { continue; }
            if (i > start) {
                int v = Filter.ToInt(csv.Substring(start, i - start).Trim(), 0);
                if (v > 0 && !outp.Contains(v)) { outp.Add(v); }
            }
            start = i + 1;
        }
        return outp;
    }

    private static string Esc(string s) {
        if (s == null) { return ""; }
        string r = s;
        r = r.Replace("&", "&amp;");
        r = r.Replace("<", "&lt;");
        r = r.Replace(">", "&gt;");
        r = r.Replace("\"", "&quot;");
        return r;
    }

    /* 请求有权操作的账号；超调用方数据 scope 的答与不存在的行同 404。 */
    private async SysUser Reach(int id) {
        SysUser u = await this.SysUser.ById(id);
        if (u == null) { this.Fail(404, "0404", "账号不存在"); }
        DataScope sc = await this.Scope();
        if (!sc.Covers(u.id, u.departmentId)) { this.Fail(404, "0404", "账号不存在"); }
        return u;
    }

    private async SysUser PasswordTarget(int id) {
        SysUser target = await this.Reach(id);
        if (target.isSuper == 1) {
            SysUser me = await this.Admin();
            if (me.isSuper != 1 || me.id != target.id) {
                this.Fail(403, "0403", "超级管理员只能重置本人的密码");
            }
        }
        return target;
    }

    /* 拒绝不可写入的部门，使账号无法被建入或移至操作员不可见的部门。 */
    private async void Reachable(int departmentId) {
        DataScope sc = await this.Scope();
        if (departmentId <= 0) {
            if (sc.Any()) { return; }
            this.Fail(403, "0403", "数据权限不允许选择未分配部门");
        }
        if (sc.Covers(0, departmentId)) { return; }
        this.Fail(403, "0403", "数据权限不允许操作该部门的账号");
    }

    /* 使该账号已发的所有令牌失效。 */
    private async void Revoke(int id) {
        int n = await this.SysUser.BumpTokenVersion(id);
        if (n > 0) { AuthUser.Forget(Convert.ToString(id)); }
    }

    private static string DeptName(List<SysDepartment> depts, int id) {
        for (int i = 0; i < depts.Count; i = i + 1) {
            if (depts[i].id == id) { return depts[i].name; }
        }
        return "—";
    }

    private static string RoleNames(List<SysRole> roles, List<SysUserRole> links, int userId) {
        string names = "";
        for (int i = 0; i < links.Count; i = i + 1) {
            if (links[i].userId != userId) { continue; }
            for (int j = 0; j < roles.Count; j = j + 1) {
                if (roles[j].id != links[i].roleId) { continue; }
                if (names.Length > 0) { names = names + "、"; }
                names = names + roles[j].name;
            }
        }
        if (names.Length == 0) { return "—"; }
        return names;
    }

}
