using System;
using System.Data;
using System.Data.Orm;
using System.Security.Cryptography;
using System.Web;
using System.Json;
using Zan.Web.AdminUi;
using Zan.Web.Core;
using Zan.Web.Dao;
using Zan.Web.Model;
using Zan.Web.Security;
using Zan.Web;

namespace Zan.Web.Admin.System;

/* /admin/system/users 账号管理：搜索、建、编、删、改密、分角色、启禁、强制下线；列表为投影，永非实体——不把密码散列与盐放进行，避免模板失手泄露凭证材料；禁用与强制下线有意分为两键——status=0 阻断后续登录、改 tokenVersion 使已持令牌失效，禁用两者都做，因放行已开会话的禁令不算禁令。 */
[Custom(Authorization = CustomAuthorization.Grant, Group = "系统管理", GroupOrder = 90)]
[Description("账号管理")]
public class UsersController : AdminController {
    /* 本屏唯一声明：列、筛选、工具栏、行内操作、通用写动作白名单同源。
       Index 渲染、CrudOps.Field/Batch/Delete 的白名单与 conf 端点的表格
       配置都从这里派生——加一列或开放一个可编辑字段，只改这里。 */
    private static ListPage ScreenDef() {
        return ListPage.Of()
            .Col("id", "ID", "num", "56px")
            .Col("username", "账号", "text", "130px")
            .Flag("superTag", "", "64px")
            .Col("nickname", "姓名", "text", "110px")
            .Col("email", "邮箱", "muted", "170px")
            .Col("mobile", "手机", "muted", "120px")
            .Col("dept", "部门", "text", "110px")
            .Col("roles", "角色", "text", "")
            .Col("createdAt", "创建日期", "time", "130px")
            .Tag("status", "状态", "1=启用|ok,0=禁用|off", "88px")
            .OpsEdit("/admin/system/users/form")
            .Ops("角色", "/admin/system/users/roles", "", "", "u")
            .Ops("数据范围", "/admin/system/users/scopes", "", "", "u")
            .Ops("密码", "/admin/system/users/passwordform", "", "", "u")
            .Ops("{toggleLabel}", "/admin/system/users/status", "",
                 "id={id}&status={nextStatus}", "u")
            .Ops("下线", "/admin/system/users/kick",
                 "强制下线后该账号需要重新登录，确定吗？", "id={id}", "u")
            .OpsDel("/admin/system/users/delete", "删除后不可恢复，确定删除该账号吗？")
            .Text("账号 / 姓名 / 邮箱", "kw", "t.username|t.nickname|t.email", "搜索账号 / 姓名 / 邮箱")
            .Select("状态", "status", "t.status", "1=启用,0=禁用")
            .Time("创建日期", "createdAt", "t.createdAt")
            .TbarAdd("新增账号", "/admin/system/users/form")
            .TbarReload()
            .TbarSep()
            .TbarEnable("/admin/system/users/batch")
            .TbarDisable("/admin/system/users/batch")
            .TbarDelete("/admin/system/users/batch")
            .Table("sys_user")
            .EditFields("nickname:text,email:text,mobile:text,departmentId:int,status:int");
    }

    [HttpGet]
    [Custom(IsMenu = true, Icon = "mdi:account", Perm = PermBit.View)]
    [Description("账号管理")]
    public void Index() {
        this.Conf();
    }

    /* adminUI ZanTable 表格模板配置（PUT /admin/system/users/conf）：纯 JSON 动作零 iframe。 */
    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("账号表格配置")]
    public void Conf() {
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("PageType", "table");

        w.WritePropertyName("Conf");
        w.WriteStartObject();
        w.WriteProperty("showPages", true);
        w.WriteProperty("pageSize", 20);
        w.WriteProperty("pageSizes", "10,20,50,100");
        w.WriteProperty("Local", false);
        w.WriteProperty("TreeData", false);
        w.WriteProperty("import", false);
        w.WriteProperty("export", true);
        w.WriteProperty("innerKey", "id");
        w.WriteProperty("innerName", "账号");
        w.WriteEndObject();

        w.WritePropertyName("Columns");
        w.WriteStartArray();
        WriteUserCol(w, "ID", "id", "number", 70, false, "");
        WriteUserCol(w, "账号", "username", "text", 130, false, "");
        WriteUserCol(w, "姓名", "nickname", "text", 110, true, "");
        WriteUserCol(w, "邮箱", "email", "text", 170, true, "");
        WriteUserCol(w, "手机", "mobile", "text", 120, true, "");
        WriteUserCol(w, "部门", "dept", "text", 120, false, "");
        WriteUserCol(w, "角色", "roles", "text", 160, false, "");
        WriteUserCol(w, "创建日期", "createdAt", "text", 150, false, "");
        WriteUserCol(w, "状态", "status", "dict", 90, true, "1=启用,0=禁用");
        w.WriteEndArray();

        w.WritePropertyName("Filters");
        w.WriteStartArray();
        w.WriteStartObject();
        w.WriteProperty("Name", "账号 / 姓名 / 邮箱");
        w.WriteProperty("Field", "kw");
        w.WriteProperty("Type", "Input");
        w.WriteProperty("placeholder", "搜索账号 / 姓名 / 邮箱");
        w.WriteEndObject();
        w.WriteStartObject();
        w.WriteProperty("Name", "状态");
        w.WriteProperty("Field", "status");
        w.WriteProperty("Type", "Select");
        w.WritePropertyName("Options");
        AdminUiProtocol.WriteOptArray(w, "1=启用,0=禁用");
        w.WriteEndObject();
        w.WriteEndArray();

        w.WritePropertyName("FilterRight");
        w.WriteStartArray();
        w.WriteEndArray();

        w.WritePropertyName("Tools");
        w.WriteStartArray();
        AdminUiProtocol.WriteFormAction(w, "新增账号", "Add", "primary", "formconf", "save", false);
        AdminUiProtocol.WriteFormActionEx(w, "编辑", "Edit", "info", "formconf", "edit", "save", true);
        AdminUiProtocol.WriteFormActionEx(w, "分配角色", "Roles", "default", "rolesconf", "rolesedit", "rolessave", true);
        AdminUiProtocol.WriteFormActionEx(w, "数据范围", "Scopes", "default", "scopesconf", "scopesedit", "scopessave", true);
        AdminUiProtocol.WriteFormAction(w, "重置密码", "Password", "warning", "passwordconf", "password", true);
        AdminUiProtocol.WriteConfirmAction(w, "批量启用", "BatchConfirm", "success", "batch", "确认启用所选账号吗？", true, false, "{\"value\":\"1\"}", "");
        AdminUiProtocol.WriteConfirmAction(w, "批量禁用", "BatchConfirm", "warning", "batch", "禁用后其登录状态将立即失效，确认禁用吗？", true, false, "{\"value\":\"0\"}", "");
        AdminUiProtocol.WriteConfirmAction(w, "强制下线", "Custom", "warning", "kick", "强制下线后该账号需要重新登录，确定吗？", true, false, "", "id={id}");
        AdminUiProtocol.WriteConfirmAction(w, "删除", "Delete", "danger", "batch", "删除后不可恢复，确认删除所选账号吗？", true, true, "{\"op\":\"delete\"}", "");
        w.WriteEndArray();

        w.WritePropertyName("MenuItems");
        w.WriteStartArray();
        AdminUiProtocol.WriteDetailAction(w, "查看详情", "");
        AdminUiProtocol.WriteFormActionEx(w, "编辑", "Edit", "info", "formconf", "edit", "save", true);
        AdminUiProtocol.WriteFormActionEx(w, "分配角色", "Roles", "default", "rolesconf", "rolesedit", "rolessave", true);
        AdminUiProtocol.WriteFormActionEx(w, "数据范围", "Scopes", "default", "scopesconf", "scopesedit", "scopessave", true);
        AdminUiProtocol.WriteFormAction(w, "重置密码", "Password", "warning", "passwordconf", "password", true);
        AdminUiProtocol.WriteConfirmAction(w, "强制下线", "Custom", "warning", "kick", "强制下线后该账号需要重新登录，确定吗？", true, false, "", "id={id}");
        AdminUiProtocol.WriteConfirmAction(w, "删除", "Delete", "danger", "batch", "删除后不可恢复，确认删除所选账号吗？", true, true, "{\"op\":\"delete\"}", "");
        w.WriteEndArray();

        w.WritePropertyName("Tabs");
        w.WriteStartArray();
        w.WriteEndArray();

        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    private static void WriteUserCol(JsonWriter w, string header, string field, string type, int width, bool editable, string opts) {
        w.WriteStartObject();
        w.WriteProperty("headerName", header);
        w.WriteProperty("field", field);
        w.WriteProperty("type", type);
        w.WriteProperty("width", width);
        w.WriteProperty("editable", editable);
        if (opts.Length > 0) {
            w.WritePropertyName("options");
            AdminUiProtocol.WriteOptArray(w, opts);
            if (editable) { w.WriteProperty("cellEditor", "agSelectCellEditor"); }
        }
        w.WriteEndObject();
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("账号列表数据")]
    public async void List() {
        if (!this.DataReady()) { return; }
        ListPage lp = ScreenDef();
        List<OrmCond> conds = lp.Collect(this);
        ListQuery q = this.PagedAny("id", 20);
        DataScope sc = await this.Scope();
        List<int> scoped = sc.Depts();
        int mine = sc.UserId();

        int total = await this.SysUser.CountBy(conds, sc.ByDept(), scoped, sc.Mine(), mine);
        List<SysUser> rows = await this.SysUser.PagedListBy(conds, sc.ByDept(), scoped, sc.Mine(), mine, q.Skip(), q.Limit());
        List<SysDepartment> depts = await this.SysDepartment.All();
        List<SysRole> roles = await this.SysRole.All();
        List<SysUserRole> links = await this.SysUserRole.ToListAsync();

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            SysUser u = rows[i];
            w.WriteStartObject();
            w.WriteProperty("id", u.id);
            w.WriteProperty("username", u.username);
            w.WriteProperty("nickname", u.nickname);
            w.WriteProperty("email", u.email);
            w.WriteProperty("mobile", u.mobile);
            w.WriteProperty("departmentId", u.departmentId);
            w.WriteProperty("dept", DeptName(depts, u.departmentId));
            w.WriteProperty("roles", RoleNames(roles, links, u.id));
            w.WriteProperty("status", Convert.ToString(u.status));
            w.WriteProperty("isSuper", u.isSuper);
            w.WriteProperty("createdAt", Fmt.Stamp(u.createdAt));
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, total, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("账号编辑回显")]
    public async void Edit() {
        int id = this.InAnyInt("id", 0);
        SysUser u = await this.Reach(id);
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", u.id);
        w.WriteProperty("username", u.username);
        w.WriteProperty("nickname", u.nickname);
        w.WriteProperty("email", u.email);
        w.WriteProperty("mobile", u.mobile);
        w.WriteProperty("departmentId", Convert.ToString(u.departmentId));
        w.WriteProperty("status", Convert.ToString(u.status));
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPut]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("账号表单配置")]
    public async void FormConf() {
        int id = this.InAnyInt("id", 0);
        DataScope sc = await this.Scope();
        List<SysDepartment> depts = await this.SysDepartment.All();

        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("title", id > 0 ? "编辑账号" : "新增账号");
        w.WriteProperty("width", "600px");
        w.WriteProperty("labelWidth", 90);
        w.WriteProperty("cols", 24);
        w.WritePropertyName("formItems");
        w.WriteStartArray();

        WriteFormField(w, "username", "账号", "input", 12, true, "登录名", "");
        WriteFormField(w, "nickname", "姓名", "input", 12, false, "", "");
        WriteFormField(w, "email", "邮箱", "input", 12, false, "", "");
        WriteFormField(w, "mobile", "手机", "input", 12, false, "", "");

        w.WriteStartObject();
        w.WriteProperty("field", "departmentId");
        w.WriteProperty("label", "部门");
        w.WriteProperty("component", "select");
        w.WriteProperty("span", 12);
        w.WriteProperty("defaultValue", "0");
        w.WritePropertyName("options");
        w.WriteStartArray();
        w.WriteStartObject();
        w.WriteProperty("value", "0");
        w.WriteProperty("label", "未分配");
        w.WriteEndObject();
        for (int i = 0; i < depts.Count; i = i + 1) {
            if (!sc.Any() && !sc.Covers(0, depts[i].id)) { continue; }
            w.WriteStartObject();
            w.WriteProperty("value", Convert.ToString(depts[i].id));
            w.WriteProperty("label", depts[i].name);
            w.WriteEndObject();
        }
        w.WriteEndArray();
        w.WriteEndObject();

        w.WriteStartObject();
        w.WriteProperty("field", "status");
        w.WriteProperty("label", "状态");
        w.WriteProperty("component", "select");
        w.WriteProperty("span", 12);
        w.WriteProperty("defaultValue", "1");
        w.WritePropertyName("options");
        AdminUiProtocol.WriteOptArray(w, "1=启用,0=禁用");
        w.WriteEndObject();

        if (id <= 0) {
            WriteFormField(w, "password", "初始密码", "password", 24, true, "至少 8 位", "");
        }

        w.WriteEndArray();
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    private static void WriteFormField(JsonWriter w, string field, string label, string comp, int span, bool req, string ph, string defVal) {
        w.WriteStartObject();
        w.WriteProperty("field", field);
        w.WriteProperty("label", label);
        w.WriteProperty("component", comp);
        w.WriteProperty("span", span);
        if (req) { w.WriteProperty("required", true); }
        if (ph.Length > 0) { w.WriteProperty("placeholder", ph); }
        if (defVal.Length > 0) { w.WriteProperty("defaultValue", defVal); }
        w.WriteEndObject();
    }

