    [HttpPut]
    [Route("/admin/monitor/monitor/errors/conf")]
    [Custom(Perm = PermBit.View)]
    [Description("错误日志表格配置")]
    public void ErrorsConf() {
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("PageType", "table");
        w.WritePropertyName("Conf");
        w.WriteStartObject();
        w.WriteProperty("showPages", true);
        w.WriteProperty("pageSize", 50);
        w.WriteProperty("pageSizes", "20,50,100");
        w.WriteProperty("Local", false);
        w.WriteProperty("TreeData", false);
        w.WriteProperty("import", false);
        w.WriteProperty("export", true);
        w.WriteProperty("innerKey", "id");
        w.WriteProperty("innerName", "错误日志");
        w.WriteEndObject();

        w.WritePropertyName("Columns");
        w.WriteStartArray();
        WriteMonCol(w, "ID", "id", "number", 80);
        WriteMonCol(w, "时间", "ts", "text", 170);
        WriteMonCol(w, "来源", "origin", "text", 220);
        WriteMonCol(w, "详情", "detail", "text", 520);
        w.WriteEndArray();

        w.WritePropertyName("Filters");
        w.WriteStartArray();
        w.WriteStartObject();
        w.WriteProperty("Name", "关键词");
        w.WriteProperty("Field", "kw");
        w.WriteProperty("Type", "Input");
        w.WriteProperty("placeholder", "搜索来源或错误详情");
        w.WriteEndObject();
        w.WriteEndArray();

        w.WritePropertyName("FilterRight");
        w.WriteStartArray();
        w.WriteEndArray();

        w.WritePropertyName("Tools");
        w.WriteStartArray();
        w.WriteEndArray();

        w.WritePropertyName("MenuItems");
        w.WriteStartArray();
        AdminUiProtocol.WriteDetailAction(w, "查看错误详情", "");
        w.WriteEndArray();

        w.WritePropertyName("Tabs");
        w.WriteStartArray();
        WriteTab(w, "近 24 小时", "h", "24");
        WriteTab(w, "近 1 小时", "h", "1");
        WriteTab(w, "近 6 小时", "h", "6");
        WriteTab(w, "近 3 天", "h", "72");
        WriteTab(w, "近 7 天", "h", "168");
        w.WriteEndArray();

        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Route("/admin/monitor/monitor/errors/list")]
    [Custom(Perm = PermBit.View)]
    [Description("错误日志分页数据")]
    public async void ErrorsList() {
        int hours = Hours(this.InAnyInt("h", 24));
        string kw = this.InAny("kw").Trim();
        ListQuery q = this.PagedAny("id", 50);
        long to = (long)WebApp.NowSeconds();
        long from = to - (long)hours * 3600;
        int _w = await MetricsStore.Flush();
        List<MetricError> rows = await MetricsStore.Errors(from, to, MaxRows);

        List<MetricError> matched = new List<MetricError>();
        for (int i = 0; i < rows.Count; i = i + 1) {
            MetricError e = rows[i];
            if (kw.Length > 0 && !e.origin.Contains(kw) && !e.detail.Contains(kw)) { continue; }
            matched.Add(e);
        }

        int total = matched.Count;
        int start = q.Skip();
        int end = start + q.Limit();
        if (end > total) { end = total; }

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = start; i < end; i = i + 1) {
            MetricError e = matched[i];
            w.WriteStartObject();
            w.WriteProperty("id", e.id);
            w.WriteProperty("ts", Fmt.Stamp(e.ts));
            w.WriteProperty("origin", e.origin);
            w.WriteProperty("detail", e.detail);
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, total, w.ToString());
    }

    /* SQL 模板统计屏（纯 JSON 表格协议） */
    [HttpGet]
    [Custom(IsMenu = true, Icon = "mdi:database-search", Perm = PermBit.View)]
    [Description("SQL 统计")]
    public void Sql() {
        this.SqlConf();
    }

    [HttpPut]
    [Route("/admin/monitor/monitor/sql/conf")]
    [Custom(Perm = PermBit.View)]
    [Description("SQL 统计表格配置")]
    public void SqlConf() {
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("PageType", "table");
        w.WritePropertyName("Conf");
        w.WriteStartObject();
        w.WriteProperty("showPages", true);
        w.WriteProperty("pageSize", 50);
        w.WriteProperty("pageSizes", "20,50,100");
        w.WriteProperty("Local", false);
        w.WriteProperty("TreeData", false);
        w.WriteProperty("import", false);
        w.WriteProperty("export", true);
        w.WriteProperty("innerKey", "id");
        w.WriteProperty("innerName", "SQL 模板");
        w.WriteEndObject();

        w.WritePropertyName("Columns");
        w.WriteStartArray();
        WriteMonCol(w, "SQL 模板", "sql", "text", 420);
        WriteMonCol(w, "执行次数", "calls", "number", 100);
        WriteMonCol(w, "慢查询数", "slow", "number", 100);
        WriteMonCol(w, "慢查询率", "slowRate", "text", 100);
        WriteMonCol(w, "平均耗时", "avg", "text", 110);
        WriteMonCol(w, "最大耗时", "max", "text", 110);
        WriteMonCol(w, "总耗时", "total", "text", 120);
        w.WriteEndArray();

        w.WritePropertyName("Filters");
        w.WriteStartArray();
        w.WriteStartObject();
        w.WriteProperty("Name", "时间窗");
        w.WriteProperty("Field", "h");
        w.WriteProperty("Type", "Select");
        w.WritePropertyName("Options");
        AdminUiProtocol.WriteOptArray(w, "24=近 24 小时,1=近 1 小时,6=近 6 小时,72=近 3 天,168=近 7 天");
        w.WriteEndObject();
        w.WriteStartObject();
        w.WriteProperty("Name", "SQL 关键词");
        w.WriteProperty("Field", "kw");
        w.WriteProperty("Type", "Input");
        w.WriteProperty("placeholder", "过滤 SQL 语句");
        w.WriteEndObject();
        w.WriteEndArray();

        w.WritePropertyName("FilterRight");
        w.WriteStartArray();
        w.WriteEndArray();

        w.WritePropertyName("Tools");
        w.WriteStartArray();
        AdminUiProtocol.WriteDownloadAction(w, "导出 CSV", "info", "/admin/monitor/monitor/sqlexport");
        w.WriteEndArray();

        w.WritePropertyName("MenuItems");
        w.WriteStartArray();
        AdminUiProtocol.WriteDetailAction(w, "查看 SQL 详情", "");
        w.WriteEndArray();

        w.WritePropertyName("Tabs");
        w.WriteStartArray();
        WriteTab(w, "按调用次数", "by", "calls");
        WriteTab(w, "按总耗时", "by", "time");
        WriteTab(w, "按慢查询数", "by", "slow");
        w.WriteEndArray();

        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Route("/admin/monitor/monitor/sql/list")]
    [Custom(Perm = PermBit.View)]
    [Description("SQL 统计分页数据")]
    public async void SqlList() {
        MetricWindow win = Window(this.InAny("d"), this.InAny("d2"),
            this.InAnyInt("h", 24));
        string by = "calls";
        if (this.InAny("by") == "time") { by = "time"; }
        if (this.InAny("by") == "slow") { by = "slow"; }
        string kw = this.InAny("kw").Trim();
        ListQuery q = this.PagedAny("id", 50);

        int _w = await MetricsStore.Flush();
        List<MetricSql> tops = await MetricsStore.SqlTotals(win.from, win.to,
            MaxRoutes, by);

        List<MetricSql> matched = new List<MetricSql>();
        for (int i = 0; i < tops.Count; i = i + 1) {
            if (kw.Length > 0 && !tops[i].sql.Contains(kw)) { continue; }
            matched.Add(tops[i]);
        }

        int total = matched.Count;
        int start = q.Skip();
        int end = start + q.Limit();
        if (end > total) { end = total; }

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = start; i < end; i = i + 1) {
            MetricSql e = matched[i];
            w.WriteStartObject();
            w.WriteProperty("id", i + 1);
            w.WriteProperty("sql", e.sql);
            w.WriteProperty("calls", e.calls);
            w.WriteProperty("slow", e.slow);
            w.WriteProperty("slowRate", Rate(e.slow, e.calls));
            w.WriteProperty("avg", Fmt.Dur(Avg(e.totalUs, e.calls)));
            w.WriteProperty("max", Fmt.Dur(e.maxUs));
            w.WriteProperty("total", Fmt.Dur(e.totalUs));
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, total, w.ToString());
    }

    /* SQL 详情 JSON：从当前窗口查找已保存模板，不回显任意输入。 */
    [HttpGet]
    [Route("/admin/monitor/sql/detail")]
    [Custom(Perm = PermBit.View)]
    [Description("SQL 模板详情")]
    public async void SqlDetail() {
        MetricWindow win = Window(this.InAny("d"), this.InAny("d2"),
            this.InAnyInt("h", 24));
        int _w = await MetricsStore.Flush();
        MetricSql e = await MetricsStore.SqlOne(win.from, win.to, this.InAny("sql"));
        if (e == null) { this.Fail(404, "0404", "SQL 模板不存在或已超出统计窗口"); return; }
        string label = Convert.ToString(win.hours) + " 小时";
        if (win.dated) {
            label = win.day;
            if (win.day2 != win.day) { label = label + " → " + win.day2; }
        }
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("window", label);
        w.WriteProperty("sql", e.sql);
        w.WriteProperty("calls", e.calls);
        w.WriteProperty("slow", e.slow);
        w.WriteProperty("avg", Fmt.Dur(Avg(e.totalUs, e.calls)));
        w.WriteProperty("max", Fmt.Dur(e.maxUs));
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    /* 与屏同窗的 SQL 统计导出；同一条目上限，查询串不能一次拉走整库。 */
    [HttpGet]
    [Custom(Perm = PermBit.Export)]
    [Description("导出 SQL 统计")]
    public async void SqlExport() {
        MetricWindow win = Window(this.In("d"), this.In("d2"),
            this.InInt("h", 24));
        string by = "calls";
        if (this.In("by") == "time") { by = "time"; }
        if (this.In("by") == "slow") { by = "slow"; }
        int _w = await MetricsStore.Flush();
        List<MetricSql> tops = await MetricsStore.SqlTotals(win.from, win.to,
            MaxRoutes, by);
        StringBuilder sb = new StringBuilder();
        sb.Append("sql,calls,slow,avg_us,max_us,total_us\n");
        for (int i = 0; i < tops.Count; i = i + 1) {
            MetricSql e = tops[i];
            sb.Append(Cell(e.sql));
            sb.Append(",");
            sb.Append(Convert.ToString(e.calls));
            sb.Append(",");
            sb.Append(Convert.ToString(e.slow));
            sb.Append(",");
            sb.Append(Convert.ToString(Avg(e.totalUs, e.calls)));
            sb.Append(",");
            sb.Append(Convert.ToString(e.maxUs));
            sb.Append(",");
            sb.Append(Convert.ToString(e.totalUs));
            sb.Append("\n");
        }
        this.Ctx().Download("sql-metrics.csv", "text/csv; charset=utf-8",
            sb.ToString());
    }

    /* 顶栏铃铛的数据源：无状态即算即答，不存告警历史——历史是错误日志与 指标屏的职责，这里只回答"现在有事吗"。三信号：5 分钟窗错误率（调用量 达到门槛才评，避免深夜个位数请求一个 500 就是 100%）、窗内最差分钟档 P95 耗时、工作进程掉线（发布停止超过时效）。 */
    static int AlertWindowSec = 300;

    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("运行告警")]
    public async void Alerts() {
        List<string> alerts = new List<string>();
        if (Cfg.Metrics.enabled && MetricsStore.Ready()) {
            int _w = await MetricsStore.Flush();
            long to = (long)WebApp.NowSeconds();
            long from = to - AlertWindowSec;
            MetricMinute tot = await MetricsStore.WindowTotals(from, to, "", "");
            if (Cfg.Metrics.alertErrPct > 0
                    && tot.calls >= (long)Cfg.Metrics.alertErrCalls) {
                long rate10 = tot.errors * 1000 / tot.calls;
                if (rate10 >= (long)Cfg.Metrics.alertErrPct * 10) {
                    alerts.Add("近 5 分钟错误率 "
                        + Tenths(rate10) + "%（"
                        + Convert.ToString(tot.errors) + "/"
                        + Convert.ToString(tot.calls) + "）");
                }
            }
            if (Cfg.Metrics.alertP95Ms > 0) {
                List<MetricMinute> rows = await MetricsStore.HistoryBuckets(
                    from, to, "", "", 60, MaxRows);
                long worst = 0;
                for (int i = 0; i < rows.Count; i = i + 1) {
                    if (rows[i].p95Us > worst) { worst = rows[i].p95Us; }
                }
                if (worst >= (long)Cfg.Metrics.alertP95Ms * 1000) {
                    alerts.Add("近 5 分钟 P95 耗时 "
                        + Fmt.Dur(worst));
                }
            }
            if (Cfg.Worker.count > 1) {
                List<LiveRow> lives = await MetricsCluster.LiveRows("snapshot",
                    MetricsCluster.FreshSeconds);
                if (lives.Count < Cfg.Worker.count) {
                    alerts.Add("工作进程 "
                        + Convert.ToString(lives.Count) + "/"
                        + Convert.ToString(Cfg.Worker.count) + " 在线");
                }
            }
        }
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WritePropertyName("alerts");
        w.WriteStartArray();
        for (int i = 0; i < alerts.Count; i = i + 1) {
            w.WriteStartObject();
            w.WriteProperty("msg", alerts[i]);
            w.WriteEndObject();
        }
        w.WriteEndArray();
        w.WriteProperty("ts", (long)WebApp.NowSeconds());
        w.WriteEndObject();
        this.Json(w.ToString());
    }

