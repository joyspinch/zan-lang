    [HttpPost]
    [Route("/admin/monitor/monitor/history/data")]
    [Custom(Perm = PermBit.View)]
    [Description("历史统计查询数据")]
    public async void HistoryData() {
        string method = this.InAny("m");
        string route = this.InAny("route");
        MetricWindow win = Window(this.InAny("d"), this.InAny("d2"),
            this.InAnyInt("h", 24));
        string gran = Gran(this.InAny("g"), win.hours);
        long step = Step(gran);
        long from = win.from;
        long to = win.to;

        int _w = await MetricsStore.Flush();
        List<MetricMinute> rows = await MetricsStore.HistoryBuckets(from, to,
            method, route, step, MaxRows);
        string by = "calls";
        if (this.InAny("by") == "time") { by = "time"; }
        List<MetricMinute> tops = await MetricsStore.RouteTotalsBy(from, to,
            method, route, MaxRoutes, by);
        if (win.dated) { rows = FillGaps(rows, from, to, step); }

        long calls = 0;
        long errors = 0;
        long peakQps10 = 0;
        for (int i = 0; i < rows.Count; i = i + 1) {
            MetricMinute b = rows[i];
            calls = calls + b.calls;
            errors = errors + b.errors;
            long qps10 = b.calls * 10 / step;
            if (qps10 > peakQps10) { peakQps10 = qps10; }
        }
        long windowQps10 = 0;
        long span = to - from;
        if (span > 0) { windowQps10 = calls * 10 / span; }

        string label = Convert.ToString(win.hours) + " 小时";
        if (win.dated) {
            label = win.day;
            if (win.day2 != win.day) { label = label + " → " + win.day2; }
        }

        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("window", label);
        w.WriteProperty("hours", win.hours);
        w.WriteProperty("gran", gran);
        w.WriteProperty("by", by);
        w.WriteProperty("day", win.day);
        w.WriteProperty("day2", win.day2);
        w.WriteProperty("from", Fmt.Stamp(from));
        w.WriteProperty("to", Fmt.Stamp(to));
        w.WriteProperty("dated", win.dated);
        w.WriteProperty("badDate", win.invalid);
        w.WriteProperty("calls", calls);
        w.WriteProperty("errors", errors);
        w.WriteProperty("errRate", Rate(errors, calls));
        w.WriteProperty("avgQps", Tenths(windowQps10));
        w.WriteProperty("peakQps", Tenths(peakQps10));
        w.WriteProperty("shown", rows.Count);
        w.WriteProperty("capped", rows.Count >= MaxRows);

        w.WritePropertyName("rows");
        w.WriteStartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            MetricMinute b = rows[i];
            long qps10 = b.calls * 10 / step;
            w.WriteStartObject();
            w.WriteProperty("bucket", BucketLabel(b.minute, gran));
            w.WriteProperty("t", b.minute);
            w.WriteProperty("calls", b.calls);
            w.WriteProperty("qps", Tenths(qps10));
            w.WriteProperty("errors", b.errors);
            w.WriteProperty("errRate", Rate(b.errors, b.calls));
            w.WriteProperty("avgUs", Avg(b.totalUs, b.calls));
            w.WriteProperty("avg", Fmt.Dur(Avg(b.totalUs, b.calls)));
            w.WriteProperty("p95Us", b.p95Us);
            w.WriteProperty("p95", Fmt.Dur(b.p95Us));
            w.WriteProperty("maxUs", b.maxUs);
            w.WriteProperty("max", Fmt.Dur(b.maxUs));
            w.WriteProperty("frames", b.frames);
            w.WriteProperty("bytes", Fmt.Bytes(b.bytes));
            w.WriteEndObject();
        }
        w.WriteEndArray();

        w.WritePropertyName("routes");
        w.WriteStartArray();
        for (int i = 0; i < tops.Count; i = i + 1) {
            MetricMinute b = tops[i];
            w.WriteStartObject();
            w.WriteProperty("method", b.method);
            w.WriteProperty("path", b.path);
            w.WriteProperty("route", b.method + " " + b.path);
            w.WriteProperty("calls", b.calls);
            w.WriteProperty("share", Rate(b.calls, calls));
            w.WriteProperty("errors", b.errors);
            w.WriteProperty("errRate", Rate(b.errors, b.calls));
            w.WriteProperty("avg", Fmt.Dur(Avg(b.totalUs, b.calls)));
            w.WriteProperty("p95", Fmt.Dur(b.p95Us));
            w.WriteProperty("max", Fmt.Dur(b.maxUs));
            w.WriteProperty("total", Fmt.Dur(b.totalUs));
            w.WriteProperty("frames", b.frames);
            w.WriteProperty("bytes", Fmt.Bytes(b.bytes));
            w.WriteEndObject();
        }
        w.WriteEndArray();

        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    /* 与屏同窗的文件导出；受同条行数上限约束，一次请求无法拉出整库。 */
    [HttpGet]
    [Custom(Perm = PermBit.Export)]
    [Description("导出历史统计")]
    public async void Export() {
        string method = this.In("m");
        string route = this.In("route");
        MetricWindow win = Window(this.In("d"), this.In("d2"),
            this.InInt("h", 24));
        string gran = Gran(this.In("g"), win.hours);
        long step = Step(gran);
        long from = win.from;
        long to = win.to;
        int _w = await MetricsStore.Flush();
        List<MetricMinute> rows = await MetricsStore.HistoryBuckets(from, to,
            method, route, step, MaxRows);
        if (win.dated) { rows = FillGaps(rows, from, to, step); }

        if (this.In("format") == "json") {
            MetricsExportDoc doc = new MetricsExportDoc();
            doc.from = from;
            doc.to = to;
            doc.rows = new List<MetricsRowDoc>();
            doc.step_seconds = step;
            for (int i = 0; i < rows.Count; i = i + 1) {
                MetricMinute b = rows[i];
                MetricsRowDoc o = new MetricsRowDoc();
                o.bucket = b.minute;
                o.method = method;
                o.path = route;
                o.calls = b.calls;
                o.errors = b.errors;
                o.avg_us = Avg(b.totalUs, b.calls);
                o.max_us = b.maxUs;
                o.frames = b.frames;
                o.bytes = b.bytes;
                doc.rows.Add(o);
            }
            this.Ctx().Download("metrics.json", "application/json",
                Json.Serialize<MetricsExportDoc>(doc));
            return;
        }

        StringBuilder sb = new StringBuilder();
        sb.Append("bucket,method,path,calls,errors,avg_us,max_us,frames,bytes\n");
        for (int i = 0; i < rows.Count; i = i + 1) {
            MetricMinute b = rows[i];
            sb.Append(Convert.ToString(b.minute));
            sb.Append(",");
            sb.Append(Cell(method));
            sb.Append(",");
            sb.Append(Cell(route));
            sb.Append(",");
            sb.Append(Convert.ToString(b.calls));
            sb.Append(",");
            sb.Append(Convert.ToString(b.errors));
            sb.Append(",");
            sb.Append(Convert.ToString(Avg(b.totalUs, b.calls)));
            sb.Append(",");
            sb.Append(Convert.ToString(b.maxUs));
            sb.Append(",");
            sb.Append(Convert.ToString(b.frames));
            sb.Append(",");
            sb.Append(Convert.ToString(b.bytes));
            sb.Append("\n");
        }
        this.Ctx().Download("metrics.csv", "text/csv; charset=utf-8",
            sb.ToString());
    }

    /* 服务器捕获的所有错误（纯 JSON 表格协议） */
