    [HttpPost]
    [Route("/admin/monitor/monitor/tables/list")]
    [Custom(Perm = PermBit.View)]
    [Description("共享内存表数据")]
    public void TablesList() {
        long reserved = 0;
        long resident = 0;
        long usedTotal = 0;
        long capacityTotal = 0;
        int pressure = 0;
        int n = SharedTable.OpenCount();

        JsonWriter rows = new JsonWriter();
        rows.WriteStartArray();
        for (int i = 0; i < n; i = i + 1) {
            long res = SharedTable.OpenStat(i, SharedTable.STAT_RESERVED);
            long live = SharedTable.OpenStat(i, SharedTable.STAT_RESIDENT);
            long cap = SharedTable.OpenStat(i, SharedTable.STAT_CAPACITY);
            long used = SharedTable.OpenStat(i, SharedTable.STAT_COUNT);
            long pct = cap > 0 ? used * 100 / cap : 0;
            string state = pct >= 80 ? "接近容量" : "正常";
            if (pct >= 80) { pressure = pressure + 1; }
            usedTotal = usedTotal + used;
            capacityTotal = capacityTotal + cap;
            reserved = reserved + res;
            if (live >= 0) { resident = resident + live; }

            rows.WriteStartObject();
            rows.WriteProperty("id", i + 1);
            rows.WriteProperty("name", SharedTable.OpenLabel(i));
            rows.WriteProperty("used", used);
            rows.WriteProperty("capacity", cap);
            rows.WriteProperty("fill", Rate(used, cap));
            rows.WriteProperty("stride", SharedTable.OpenStat(i, SharedTable.STAT_ROW_STRIDE));
            rows.WriteProperty("keySize", SharedTable.OpenStat(i, SharedTable.STAT_KEY_SIZE));
            rows.WriteProperty("columns", SharedTable.OpenStat(i, SharedTable.STAT_COLUMNS));
            rows.WriteProperty("reserved", Fmt.Bytes(res));
            rows.WriteProperty("resident", Fmt.Bytes(live));
            rows.WriteProperty("state", state);
            rows.WriteEndObject();
        }
        rows.WriteEndArray();

        JsonWriter sum = new JsonWriter();
        sum.WriteStartArray();
        WriteSum(sum, "映射表数", Convert.ToString(n));
        WriteSum(sum, "总填充率", Rate(usedTotal, capacityTotal));
        WriteSum(sum, "预留空间", Fmt.Bytes(reserved));
        WriteSum(sum, "实际驻留", Fmt.Bytes(resident));
        WriteSum(sum, "高压表", Convert.ToString(pressure));
        sum.WriteEndArray();

        AdminUiProtocol.Ok(this, "{\"total\":" + Convert.ToString(n) + ",\"data\":" + rows.ToString() + ",\"Summary\":" + sum.ToString() + "}");
    }

    private static void WriteMonCol(JsonWriter w, string header, string field, string type, int width) {
        w.WriteStartObject();
        w.WriteProperty("headerName", header);
        w.WriteProperty("field", field);
        w.WriteProperty("type", type);
        w.WriteProperty("width", width);
        w.WriteEndObject();
    }

    private static void WriteTab(JsonWriter w, string name, string field, string val) {
        w.WriteStartObject();
        w.WriteProperty("Name", name);
        w.WriteProperty("Field", field);
        w.WriteProperty("Value", val);
        w.WriteEndObject();
    }

    private static void WriteSum(JsonWriter w, string label, string val) {
        w.WriteStartObject();
        w.WriteProperty("label", label);
        w.WriteProperty("value", val);
        w.WriteEndObject();
    }

    /* 导出与屏幕可请求的最大窗与页；查询串不得决定一次请求读取多少数据。 */
    static int MaxRows = 5000;
    static int MaxHours = 720;
    static int MaxRoutes = 100;

    private static int Hours(int h) {
        if (h < 1) { return 1; }
        if (h > MaxHours) { return MaxHours; }
        return h;
    }

    /* 屏幕所求窗：day 可解析时取日历日（或多日），否则取过去 h 小时；日历窗覆盖整日 00:00:00–23:59:59，同一日期答同桶；滚动窗同样钳到 MaxHours，查询串一次不能要一整年。 */
    private static MetricWindow Window(string day, string day2, int h) {
        MetricWindow w = new MetricWindow();
        w.day = "";
        w.day2 = "";
        w.dated = false;
        w.invalid = false;
        long start = DaySeconds(day);
        if (day.Length > 0 && start < 0) { w.invalid = true; }
        if (start >= 0) {
            long end = DaySeconds(day2);
            if (day2.Length > 0 && end < 0) { w.invalid = true; }
            if (end < start) { end = start; }
            long span = (end - start) / 3600 + 24;
            if (span > (long)MaxHours) {
                end = start + ((long)MaxHours - 24) * 3600;
                span = (long)MaxHours;
            }
            w.from = start;
            w.to = end + 86399;
            w.hours = (int)span;
            w.dated = true;
            w.day = Fmt.Day(start);
            w.day2 = Fmt.Day(end);
            return w;
        }
        w.hours = Hours(h);
        w.to = (long)WebApp.NowSeconds();
        w.from = w.to - (long)w.hours * 3600;
        return w;
    }

    /* "YYYY-MM-DD" 转该日 UTC 零点秒；不可解析为 -1；手解析不信任，因该值决定页面读哪些行。 */
    private static long DaySeconds(string s) {
        if (s == null || s.Length != 10) { return 0 - 1; }
        if (s.Substring(4, 1) != "-" || s.Substring(7, 1) != "-") {
            return 0 - 1;
        }
        int y = Digits(s, 0, 4);
        int m = Digits(s, 5, 2);
        int dd = Digits(s, 8, 2);
        if (y < 1970 || m < 1 || m > 12 || dd < 1) { return 0 - 1; }
        if (dd > DateTime.DaysInMonth(y, m)) { return 0 - 1; }
        return Fmt.LocalDayStart(y, m, dd);
    }

    /* 取 s 在 at 处 n 位数字；任一非数字返回 -1。 */
    private static int Digits(string s, int at, int n) {
        int v = 0;
        for (int i = 0; i < n; i = i + 1) {
            int c = s[at + i] & 255;
            if (c < 48 || c > 57) { return 0 - 1; }
            v = v * 10 + (c - 48);
        }
        return v;
    }

    /* 空桶补零；使一天在屏上为 24 小时，无论有无流量；按 MaxRows 上限。 */
    static List<MetricMinute> FillGaps(List<MetricMinute> rows, long from,
                                       long to, long step) {
        List<MetricMinute> outp = new List<MetricMinute>();
        long first = (from / step) * step;
        long last = (to / step) * step;
        int at = 0;
        for (long b = last; b >= first; b = b - step) {
            if (outp.Count >= MaxRows) { break; }
            if (at < rows.Count && rows[at].minute == b) {
                outp.Add(rows[at]);
                at = at + 1;
                continue;
            }
            MetricMinute z = new MetricMinute();
            z.minute = b;
            z.method = "";
            z.path = "";
            outp.Add(z);
        }
        return outp;
    }

    /* 粒度校验；未设时按窗长挑选可读的粒度（≤3h 分钟，≤3d 小时，更长按日）。 */
    private static string Gran(string g, int hours) {
        if (g == "min" || g == "hour" || g == "day") { return g; }
        if (hours <= 3) { return "min"; }
        if (hours <= 72) { return "hour"; }
        return "day";
    }

    private static long Step(string gran) {
        if (gran == "min") { return 60; }
        if (gran == "day") { return 86400; }
        return 3600;
    }

    /* 桶按屏称呼：日按日期、小时"日期 hh:00"、分钟完整时钟。 */
    private static string BucketLabel(long sec, string gran) {
        if (gran == "day") { return Fmt.Day(sec); }
        string s = Fmt.Stamp(sec);
        if (gran == "hour" && s.Length >= 3) {
            return s.Substring(0, s.Length - 3);
        }
        return s;
    }

    /* 十分位计数，作 "12.3"；整数运算，仅为表格单元格而非后续数学。 */
    private static string Tenths(long v10) {
        return Convert.ToString(v10 / 10) + "." + Convert.ToString(v10 % 10);
    }

    /* part/whole 作百分比，一位小数。 */
    private static string Rate(long part, long whole) {
        if (whole <= 0) { return "0.0"; }
        return Tenths(part * 1000 / whole);
    }

    /* 微秒均值；无调用桶答 0（补零小时无均值，除 0 会出错而非答数）。 */
    private static long Avg(long totalUs, long calls) {
        if (calls <= 0) { return 0; }
        return totalUs / calls;
    }

    /* CSV 单元格：加引号、内部引号翻倍，路由名永不破坏列布局。 */
    private static string Cell(string v) {
        StringBuilder sb = new StringBuilder();
        sb.Append("\"");
        for (int i = 0; i < v.Length; i = i + 1) {
            string ch = v.Substring(i, 1);
            if ((v[i] & 255) == 34) { sb.Append("\""); }
            sb.Append(ch);
        }
        sb.Append("\"");
        return sb.ToString();
    }
}
