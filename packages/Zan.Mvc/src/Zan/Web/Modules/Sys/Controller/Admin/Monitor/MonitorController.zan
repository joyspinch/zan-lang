    [HttpPut]
    [Route("/admin/monitor/monitor/history/conf")]
    [Custom(Perm = PermBit.View)]
    [Description("历史统计页面配置")]
    public void HistoryConf() {
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("PageType", "dashboard");
        w.WriteProperty("mode", "history");
        w.WriteProperty("title", "历史统计");
        w.WriteProperty("subtitle", "按时间桶与接口维度分析历史吞吐、错误率与分位延迟");
        w.WriteProperty("dataUrl", "/admin/monitor/monitor/history/data");
        w.WriteProperty("exportCsvUrl", "/admin/monitor/monitor/export");
