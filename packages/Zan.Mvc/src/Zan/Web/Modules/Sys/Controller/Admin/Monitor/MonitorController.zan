/* /admin/monitor/monitor 服务器监控：吞吐量、错误、延迟、查询、CPU/内存，纯 JSON 协议 + SSE 实时流。 */
[Custom(Authorization = CustomAuthorization.Grant, Group = "运行监控", GroupOrder = 80)]
[Description("运行监控")]
public class MonitorController : AdminController {
    /* 流存活时长；有意的上限：标签整夜开着不应永远占协程，EventSource 会自连。 */
    static int StreamSeconds = 1800;

    [HttpGet]
    [Custom(IsMenu = true, Icon = "mdi:chart-line", Perm = PermBit.View)]
    [Description("实时监控")]
    public async void Index() {
        await this.Conf();
    }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("运行监控页面配置")]
    public async void Conf() {
        JsonDoc m = JsonDoc.Parse(await MetricsCluster.SnapshotJson());
        long workers = m != null ? m.PathLong("workers", 1L) : 1L;
        string wl = m != null ? m.PathStr("worker_list", "") : "";
        if (wl.Length == 0) { wl = Convert.ToString(m != null ? m.PathLong("worker_id", 0L) : 0L); }
        long pid = m != null ? m.PathLong("pid", 0L) : 0L;
        string slow = Fmt.Dur(m != null ? m.PathLong("requests.slow_threshold_us", 0L) : 0L);
        WebApp app = this.Ctx().App();
        bool profileEnabled = app != null && app.RequestProfile() != null;

        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("PageType", "dashboard");
        w.WriteProperty("mode", "monitor");
        w.WriteProperty("title", "实时监控");
        w.WriteProperty("subtitle", "集群实时吞吐、延迟、资源占用与当日接口排行");
        w.WriteProperty("todayUrl", "/admin/monitor/monitor/today");
        w.WriteProperty("snapshotUrl", "/admin/monitor/monitor/snapshot");
        w.WriteProperty("seriesUrl", "/admin/monitor/monitor/series");
        w.WriteProperty("streamUrl", "/admin/monitor/monitor/stream");
        w.WriteProperty("tracesUrl", "/admin/monitor/request-traces");
        w.WriteProperty("diagnosticsUrl", "/admin/monitor/route-diagnostics");
        w.WriteProperty("alertsUrl", "/admin/monitor/monitor/alerts");
        w.WritePropertyName("meta");
        w.WriteStartObject();
        w.WriteProperty("workers", workers);
        w.WriteProperty("worker", wl);
        w.WriteProperty("pid", pid);
        w.WriteProperty("slow", slow);
        w.WriteProperty("requestProfileEnabled", profileEnabled);
        w.WriteEndObject();
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    /* 指标快照 JSON（README "Observability" 承诺的形状）：吞吐/延迟/ 查询/CPU/内存/慢操作与 top 排行，监控屏取数的同一来源。会话 + View 权限位守门——内部计时与路径不对外。 */
    [HttpGet]
    [Route("/admin/stats")]
    [Custom(Perm = PermBit.View)]
    [Description("服务器指标")]
    public async void Stats() {
        this.Json(await MetricsCluster.SnapshotJson());
    }

    /* 当前 worker 的请求追踪，使用快照的 next_before 向后翻页。 */
    [HttpGet]
    [Route("/admin/monitor/request-traces")]
    [Custom(Perm = PermBit.View)]
    [Description("请求追踪")]
    public void RequestTraces() {
        HttpContext ctx = this.Ctx();
        ctx.SetHeader("Cache-Control", "no-store");
        WebApp app = ctx.App();
        RequestProfiler profiler = app != null ? app.RequestProfile() : null;
        if (profiler == null) {
            ctx.Status(503, "Service Unavailable");
            ctx.Api("0503", "request profiling is disabled", "null");
            return;
        }
        ctx.ExcludeRequestProfile();
        ctx.Json(profiler.SnapshotJson(ctx.InInt("limit", 100), ctx.InLong("before", 0)));
    }

    [HttpGet]
    [Route("/admin/monitor/route-diagnostics")]
    [Custom(Perm = PermBit.View)]
    [Description("路由诊断")]
    public async void RouteDiagnostics() {
        HttpContext ctx = this.Ctx();
        ctx.SetHeader("Cache-Control", "no-store");
        ctx.ExcludeRequestProfile();
        ctx.Json(await MetricsStore.RouteDiagnostics(ctx.InInt("hours", 1),
            ctx.In("method"), ctx.In("route")));
    }

    /* 实时快照流；非菜单项，监控页为其界面。 */
    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("运行指标事件流")]
    public async void Stream() {
        HttpContext ctx = this.Ctx();
        if (!await ctx.SseOpen()) { return; }

        /* 首帧携带近期历史使图表一次绘满，而非两分钟内慢慢填满；每帧为所有 live worker 的合并，非本进程自身数字。 */
        if (!await ctx.SseSend("series", await MetricsCluster.SeriesJson(120))) {
            return;
        }

        int elapsed = 0;
        int sinceSeries = 0;
        while (elapsed < StreamSeconds) {
            await Task.Delay(2000);
            elapsed = elapsed + 2;
            sinceSeries = sinceSeries + 2;
            if (!await ctx.SseSend("metrics",
                    await MetricsCluster.SnapshotJson())) { return; }
            if (sinceSeries >= 10) {
                sinceSeries = 0;
                if (!await ctx.SseSend("series",
                        await MetricsCluster.SeriesJson(120))) {
                    return;
                }
            }
        }
    }

    /* 当日页面按五分钟分桶：一昼夜 288 个点，足以看见尖峰又易绘。 */
    static long DayStep = 300;
    /* 当日排名每个排序下展示条数。 */
    static int DayRoutes = 20;

    /* 当日（今天至此，或指定的一天完整）取自持久化的分钟行而非任一进程计数器。不用实时快照：worker 计数器于启动时归零，重启/新派会让页面总计、排名、图表反向跳变。分钟表由所有 worker 写入同一库、以分钟+接口为键，跨重启跨集群累积；本 worker 未刷出的桶先刷出，故当前分钟被纳入；as_of 报告其余 worker 最新刷出的时刻。 */
    private static async string DayJson(long from, long to) {
        int _w = await MetricsStore.Flush();
        MetricMinute tot = await MetricsStore.WindowTotals(from, to, "", "");
        List<MetricMinute> rows = await MetricsStore.HistoryBuckets(from, to,
            "", "", DayStep, MaxRows);
        rows = FillGaps(rows, from, to, DayStep);

        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("day", Fmt.Day(from));
        w.WriteProperty("from", from);
        w.WriteProperty("as_of", to);
        w.WriteProperty("step", DayStep);
        w.WriteProperty("calls", tot.calls);
        w.WriteProperty("errors", tot.errors);
        w.WriteProperty("avg_us", Avg(tot.totalUs, tot.calls));
        w.WriteProperty("max_us", tot.maxUs);
        w.WriteProperty("total_us", tot.totalUs);
        w.WriteProperty("frames", tot.frames);
        w.WriteProperty("bytes", tot.bytes);

        /* 最旧在前：图表 x 轴正向。 */
        w.WritePropertyName("points");
        w.WriteStartArray();
        for (int i = rows.Count - 1; i >= 0; i = i - 1) {
            MetricMinute b = rows[i];
            w.WriteStartObject();
            w.WriteProperty("t", b.minute);
            w.WriteProperty("calls", b.calls);
            w.WriteProperty("errors", b.errors);
            w.WriteProperty("avg_us", Avg(b.totalUs, b.calls));
            w.WriteProperty("p95_us", b.p95Us);
            w.WriteProperty("max_us", b.maxUs);
            w.WriteEndObject();
        }
        w.WriteEndArray();

        w.WritePropertyName("top");
        w.WriteStartArray();
        Dictionary<string,int> seen = new Dictionary<string,int>();
        await AppendDayTop(w, seen, from, to, "calls");
        await AppendDayTop(w, seen, from, to, "time");
        w.WriteEndArray();

        w.WriteEndObject();
        return w.ToString();
    }

    /* 当日各接口一行，供操作员按所问列排序；按调用量与耗时两套排序合并取 top——吞吐最多者常非耗时最多者，单排序会隐藏另一端的领先者。 */
    static async void AppendDayTop(JsonWriter w, Dictionary<string,int> seen,
            long from, long to, string rank) {
        List<MetricMinute> tops = await MetricsStore.RouteTotalsBy(from, to,
            "", "", DayRoutes, rank);
        for (int i = 0; i < tops.Count; i = i + 1) {
            MetricMinute b = tops[i];
            string req = b.method + " " + b.path;
            if (seen.ContainsKey(req)) { continue; }
            seen[req] = 1;
            w.WriteStartObject();
            w.WriteProperty("req", req);
            w.WriteProperty("calls", b.calls);
            w.WriteProperty("errors", b.errors);
            w.WriteProperty("avg_us", Avg(b.totalUs, b.calls));
            w.WriteProperty("p95_us", b.p95Us);
            w.WriteProperty("max_us", b.maxUs);
            w.WriteProperty("total_us", b.totalUs);
            w.WriteEndObject();
        }
    }

    /* 当日累计指标单次请求，供工具与页面首绘；d (YYYY-MM-DD) 指定日，默认今天。 */
    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("当天累计指标")]
    public async void Today() {
        long now = (long)WebApp.NowSeconds();
        long today = Today(now);
        long from = PickedDay(this.In("d"), today);
        this.Json(await DayJson(from,
            DayEnd(from, today, now)));
    }

    /* 今日零点秒。 */
    static long Today(long now) { return Fmt.TodayStart(now); }

    /* 屏幕所求日期：可解析且不在未来的取指定日，否则取今日；未来日无行，答空表会被读作历史丢失。 */
    private static long PickedDay(string day, long today) {
        long start = DaySeconds(day);
        if (start < 0 || start > today) { return today; }
        return start;
    }

    /* 被读当日终点：已结束日取午夜，今日取此刻——窗跑到今夜午夜的会把尚未发生的时刻算作无流量的一日。 */
    private static long DayEnd(long from, long today, long now) {
        if (from >= today) { return now; }
        return from + 86399;
    }

