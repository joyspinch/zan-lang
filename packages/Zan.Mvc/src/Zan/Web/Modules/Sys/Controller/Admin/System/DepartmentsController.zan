namespace Zan.Web.Admin.System;

/* /admin/system/departments 部门；部门可携带自身角色（sys_department_role），故账号继承工作所属的权利，无需逐人分派。 */
[Custom(Authorization = CustomAuthorization.Grant, Group = "系统管理", GroupOrder = 90)]
[Description("部门管理")]
public class DepartmentsController : AdminController {
    [HttpGet]
    [Custom(IsMenu = true, Icon = "mdi:sitemap", Perm = PermBit.View)]
    [Description("部门管理")]
    public void Index() {
        this.Conf();
    }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("部门左树右表配置")]
    public void Conf() {
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("PageType", "table");

        w.WritePropertyName("Conf");
        w.WriteStartObject();
        w.WriteProperty("showPages", false);
        w.WriteProperty("pageSize", 50);
        w.WriteProperty("pageSizes", "20,50,100");
        w.WriteProperty("Local", false);
        w.WriteProperty("TreeData", false);
        w.WriteProperty("import", false);
        w.WriteProperty("export", true);
        w.WriteProperty("innerKey", "id");
        w.WriteProperty("innerName", "成员");
        w.WriteEndObject();

        w.WritePropertyName("LeftPanel");
        w.WriteStartObject();
        w.WriteProperty("title", "组织架构");
        w.WriteProperty("mode", "tree");
        w.WriteProperty("dataUrl", "tree");
        w.WriteProperty("width", 268);
        w.WriteProperty("idField", "id");
        w.WriteProperty("labelField", "name");
        w.WriteProperty("parentField", "parentId");
        w.WriteProperty("badgeField", "members");
        w.WriteProperty("subtitleField", "code");
        w.WriteProperty("paramField", "id");
        w.WriteProperty("defaultPayloadField", "parentId");
        w.WriteProperty("searchable", true);
        w.WritePropertyName("tools");
        w.WriteStartArray();
        AdminUiProtocol.WriteFormAction(w, "新增部门", "Add", "primary", "formconf", "save", false);
        w.WriteEndArray();
        w.WritePropertyName("itemActions");
        w.WriteStartArray();
        AdminUiProtocol.WriteFormActionEx(w, "编辑", "Edit", "info", "formconf", "edit", "save", true);
        AdminUiProtocol.WriteFormActionEx(w, "部门角色", "Roles", "warning", "rolesconf", "rolesedit", "rolessave", true);
        AdminUiProtocol.WriteConfirmAction(w, "删除", "Delete", "danger", "delete", "删除后不可恢复，确认删除该部门吗？", true, false, "", "id={id}");
        w.WriteEndArray();
        w.WriteEndObject();

        w.WritePropertyName("Columns");
        w.WriteStartArray();
        WriteDeptCol(w, "ID", "id", "number", 60, "");
        WriteDeptCol(w, "账号", "username", "text", 115, "");
        WriteDeptCol(w, "姓名", "nickname", "text", 100, "");
        WriteDeptCol(w, "邮箱", "email", "text", 170, "");
        WriteDeptCol(w, "手机", "mobile", "text", 115, "");
        WriteDeptCol(w, "个人角色", "roles", "text", 150, "");
        WriteDeptCol(w, "状态", "status", "dict", 80, "1=启用,0=禁用");
        w.WriteEndArray();

        w.WritePropertyName("Filters");
        w.WriteStartArray();
        w.WriteEndArray();
        w.WritePropertyName("FilterRight");
        w.WriteStartArray();
        w.WriteEndArray();

        w.WritePropertyName("Tools");
        w.WriteStartArray();
        WriteAddMemberPickerTool(w);
        AdminUiProtocol.WriteConfirmAction(w, "移出部门", "RemoveMembers", "warning",
            "removemembers", "确认将所选成员移出当前部门吗？（仅解除部门归属，不会删除账号）",
            true, false, "", "");
        w.WriteEndArray();

        w.WritePropertyName("MenuItems");
        w.WriteStartArray();
        AdminUiProtocol.WriteDetailAction(w, "查看成员详情", "");
        AdminUiProtocol.WriteConfirmAction(w, "移出部门", "RemoveMembers", "warning",
            "removemembers", "确认将所选成员移出当前部门吗？（仅解除部门归属，不会删除账号）",
            true, false, "", "");
        w.WriteEndArray();

        w.WritePropertyName("Tabs");
        w.WriteStartArray();
        w.WriteEndArray();

        w.WriteEndObject();
