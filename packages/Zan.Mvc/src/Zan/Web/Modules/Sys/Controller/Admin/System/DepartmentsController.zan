    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存部门")]
    public async void Save() {
        int id = this.InAnyInt("id", 0);
        if (!await this.Can(id > 0 ? (int)PermBit.Update : (int)PermBit.Create)) {
            this.Fail(403, "0403", "无操作权限"); return;
        }
        string name = this.NeedAny("name", "部门名称");
        string code = this.InAny("code");
        int parentId = this.InAnyInt("parentId", 0);
        int sortOrder = this.InAnyInt("sortOrder", 1);
        int status = this.InAnyInt("status", 1);
        if (status != 1) { status = 0; }
        if (parentId == id && id > 0) {
            this.Fail(400, "0004", "上级部门不能是自己");
        }
        await this.Parented(parentId);
        if (id > 0) {
            SysDepartment dept = await this.Reach(id);
            int n = await this.SysDepartment.UpdateBasic(id, name, code, parentId, sortOrder, status);
            if (n > 0 && dept.parentId != parentId) { AuthUser.ForgetAll(); }
            await this.Note("编辑部门", name, n > 0, "");
            this.Saved("部门已保存");
            return;
        }
        SysDepartment dept = new SysDepartment();
        dept.name = name;
        dept.code = code;
        dept.parentId = parentId;
        dept.sortOrder = sortOrder;
        dept.status = status;
        dept.leaderUserId = 0;
        dept.createdAt = WebApp.NowSeconds();
        int newId = await this.SysDepartment.Insert(dept).ExecuteIdentityAsync();
        if (newId > 0) { AuthUser.ForgetAll(); }
        await this.Note("新增部门", name, newId > 0, "");
        this.Saved("部门已创建");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("保存部门角色")]
    public async void RolesSave() {
        int id = this.InAnyInt("id", 0);
        SysDepartment dept = await this.Reach(id);
        string picked = this.InAny("roleIds");
        if (!await this.Begin()) { this.Fail(503, "2001", "数据库不可用"); }
        int _cleared = await this.SysDepartmentRole.Delete()
            .Where(a => a.departmentId == id).ExecuteAffrowsAsync();
        List<SysRole> roles = await this.SysRole.ToListAsync();
        int granted = 0;
        for (int i = 0; i < roles.Count; i = i + 1) {
            if (!AuthUser.Holds(picked, Convert.ToString(roles[i].id))) { continue; }
            SysDepartmentRole link = new SysDepartmentRole();
            link.departmentId = id;
            link.roleId = roles[i].id;
            int inserted = await this.SysDepartmentRole.Insert(link).ExecuteAffrowsAsync();
            if (inserted != 1) { throw new Exception("department role was not saved"); }
            granted = granted + 1;
        }
        await this.Commit();
        /* 部门内所有人权利刚变更，授权缓存按账号键，故整体清除。 */
        AuthUser.ForgetAll();
        await this.Note("部门角色", dept.name, true,
            Convert.ToString(granted) + " 个角色");
        this.Saved("部门角色已保存");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除部门")]
    public async void Delete() {
        int id = this.InAnyInt("id", 0);
        SysDepartment dept = await this.Reach(id);
        int kids = await this.SysDepartment.Where(a => a.parentId == id).CountAsync();
        if (kids > 0) {
            this.Fail(400, "0004", "请先删除下级部门");
        }
        int members = await this.SysUser.Where(a => a.departmentId == id).CountAsync();
        if (members > 0) {
            this.Fail(400, "0004", "还有 " + Convert.ToString(members)
                + " 个账号属于该部门");
        }
        int n = await this.SysDepartment.Delete().Where(a => a.id == id).ExecuteAffrowsAsync();
        int _r = await this.SysDepartmentRole.Delete().Where(a => a.departmentId == id)
            .ExecuteAffrowsAsync();
        AuthUser.ForgetAll();
        await this.Note("删除部门", dept.name, n > 0, "");
        this.Saved("部门已删除");
    }

    /* 候选成员列表：当前数据范围内且尚未属于目标部门的账号，供「添加成员」弹窗勾选。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("部门候选成员列表")]
    public async void Candidates() {
        if (!this.DataReady()) { return; }
        int deptId = this.ResolveTargetDeptId();
        SysDepartment dept = await this.Reach(deptId);
        DataScope sc = await this.Scope();
        List<int> scoped = sc.Depts();
        int mine = sc.UserId();

        List<SysDepartment> allDepts = await this.SysDepartment.OrderBy(a => a.sortOrder).ToListAsync();
        Dictionary<int, string> deptNames = new Dictionary<int, string>();
        for (int i = 0; i < allDepts.Count; i = i + 1) {
            deptNames[allDepts[i].id] = allDepts[i].name;
        }

        List<SysUser> users = await this.SysUser
            .WhereIf(sc.ByDept(), a => scoped.Contains(a.departmentId) || a.departmentId == 0)
            .WhereIf(sc.Mine(), a => a.id == mine)
            .OrderBy(a => a.id)
            .ToListAsync();

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < users.Count; i = i + 1) {
            SysUser u = users[i];
            if (u.departmentId == dept.id) { continue; }
            string dn = "未分配";
            if (u.departmentId > 0) {
                string found = "";
                if (deptNames.TryGetValue(u.departmentId, out found) && found.Length > 0) {
                    dn = found;
                }
            }
            w.WriteStartObject();
            w.WriteProperty("id", u.id);
            w.WriteProperty("username", u.username);
            w.WriteProperty("nickname", Fmt.Dash(u.nickname));
            w.WriteProperty("departmentId", u.departmentId);
            w.WriteProperty("departmentName", dn);
            w.WriteProperty("email", Fmt.Dash(u.email));
            w.WriteProperty("mobile", Fmt.Dash(u.mobile));
            w.WriteProperty("statusText", u.status == 1 ? "启用" : "禁用");
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    /* 批量将选中账号加入当前部门（更新 departmentId 并清理对应账号授权缓存）。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("添加部门成员")]
    public async void AddMembers() {
        int deptId = this.ResolveTargetDeptId();
        SysDepartment dept = await this.Reach(deptId);
        List<int> ids = this.ParseMemberIds();
        if (ids.Count == 0) {
            this.Fail(400, "0004", "请至少选择一名账号");
        }
        DataScope sc = await this.Scope();
        long now = WebApp.NowSeconds();
        int moved = 0;
        for (int i = 0; i < ids.Count; i = i + 1) {
            SysUser u = await this.SysUser.ById(ids[i]);
            if (u == null) { continue; }
            if (!sc.Any() && u.departmentId > 0 && !sc.Covers(u.id, u.departmentId)) { continue; }
            if (sc.Mine() && u.id != sc.UserId()) { continue; }
            if (u.departmentId == dept.id) { continue; }
            int n = await this.SysUser.UpdateProfile(
                u.id, u.username, u.nickname, u.email, u.mobile, dept.id, u.status, now);
            if (n > 0) {
                AuthUser.Forget(Convert.ToString(u.id));
                moved = moved + 1;
            }
        }
        await this.Note("添加部门成员", dept.name, moved > 0, Convert.ToString(moved) + " 人");
        this.Saved("已添加 " + Convert.ToString(moved) + " 名成员到「" + dept.name + "」");
    }

    /* 批量将选中成员移出当前部门（departmentId 归零，不删除账号）。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("移出部门成员")]
    public async void RemoveMembers() {
        int deptId = this.ResolveTargetDeptId();
        SysDepartment dept = await this.Reach(deptId);
        List<int> ids = this.ParseMemberIds();
        if (ids.Count == 0) {
            this.Fail(400, "0004", "请至少选择一名成员");
        }
        DataScope sc = await this.Scope();
        long now = WebApp.NowSeconds();
        int removed = 0;
        for (int i = 0; i < ids.Count; i = i + 1) {
            SysUser u = await this.SysUser.ById(ids[i]);
            if (u == null || u.departmentId != dept.id) { continue; }
            if (!sc.Any() && !sc.Covers(u.id, u.departmentId)) { continue; }
            int n = await this.SysUser.UpdateProfile(
                u.id, u.username, u.nickname, u.email, u.mobile, 0, u.status, now);
            if (n > 0) {
                AuthUser.Forget(Convert.ToString(u.id));
                removed = removed + 1;
            }
        }
        await this.Note("移出部门成员", dept.name, removed > 0, Convert.ToString(removed) + " 人");
        this.Saved("已将 " + Convert.ToString(removed) + " 名成员移出「" + dept.name + "」");
    }

    private int ResolveTargetDeptId() {
        int deptId = this.InAnyInt("deptId", 0);
        if (deptId <= 0) { deptId = this.InAnyInt("parentId", 0); }
        if (deptId <= 0) { deptId = this.InAnyInt("id", 0); }
        return deptId;
    }

    private List<int> ParseMemberIds() {
        List<int> out_ = new List<int>();
        string csv = this.InAny("ids").Trim();
        if (csv.Length > 0) {
            List<string> parts = csv.Split(",");
            for (int i = 0; i < parts.Count && out_.Count < 500; i = i + 1) {
                string p = parts[i].Trim();
                if (p.Length == 0 || p.Length > 9) { continue; }
                int v = Filter.ToInt(p, 0);
                if (v > 0) { out_.Add(v); }
            }
            if (out_.Count > 0) { return out_; }
        }
        JsonDoc doc = this.Ctx().JsonDoc();
        if (doc == null) { return out_; }
        int arr = doc.Get(doc.root, "pickedIds");
        if (arr < 0) { arr = doc.Get(doc.root, "ids"); }
        if (arr < 0 || doc.KindAt(arr) != 4) { return out_; }
        int c = doc.FirstChild(arr);
        int count = doc.Count(arr);
        for (int i = 0; i < count && out_.Count < 500 && c >= 0; i = i + 1) {
            int v = doc.IntAt(c, 0);
            if (v <= 0) {
                string sv = doc.StrAt(c, "").Trim();
                v = Filter.ToInt(sv, 0);
            }
            if (v > 0) { out_.Add(v); }
            c = doc.NextSibling(c);
        }
        return out_;
    }

    /* 请求可操作的部门：超范围的读作"不存在"，与列表上同。 */
    private async SysDepartment Reach(int id) {
        SysDepartment dept = await this.SysDepartment.ById(id);
        if (dept == null) { this.Fail(404, "0404", "部门不存在"); }
        DataScope sc = await this.Scope();
        if (sc.Any()) { return dept; }
        /* 此处行即部门本身，故行"自己的部门"为其 id；仅本人 scope 只触及调用方所属部门。 */
        bool ok = sc.Covers(0, dept.id);
        if (sc.Mine()) { ok = dept.id == (await this.Admin()).departmentId; }
        if (!ok) { this.Fail(404, "0404", "部门不存在"); }
        return dept;
    }

    /* 部门可归档到的上级；超范围（含顶级）会造出调用方自身无法读回的部门行。 */
    private async void Parented(int parentId) {
        DataScope sc = await this.Scope();
        if (sc.Any()) { return; }
        if (parentId <= 0) {
            this.Fail(403, "0403", "数据权限不允许新增顶级部门");
        }
        SysDepartment _p = await this.Reach(parentId);
    }

    /* 预留额外过滤参数，并兼容单条语句绑定值较少的驱动。 */
    private static const int ListBatchSize = 900;

    private static List<int> IdBatch(List<int> ids, int start) {
        List<int> batch = new List<int>();
        for (int i = start; i < ids.Count && batch.Count < ListBatchSize; i = i + 1) {
            batch.Add(ids[i]);
        }
        return batch;
    }

    private static async Dictionary<int, int> MemberCounts(IDbConnection db, List<int> ids, bool self, int mine) {
        Dictionary<int, int> counts = new Dictionary<int, int>();
        for (int start = 0; start < ids.Count; start = start + ListBatchSize) {
            Select query = db.Select<SysUser>().inner;
            query.WhereIn("departmentId", IdBatch(ids, start));
            if (self) { query.WhereEq("id", mine); }
            string key = query.RequireCol("departmentId");
            query.GroupBy(key);
            DbResult groups = await query.AggRAsync(key + ", COUNT(" + key + ")");
            if (groups == null) { continue; }
            for (int i = 0; i < groups.RowCount(); i = i + 1) {
                counts[groups.GetInt(i, 0)] = groups.GetInt(i, 1);
            }
        }
        return counts;
    }

    private static async List<SysUserRole> StaffRoles(IDbConnection db, List<SysUser> staff) {
        List<int> ids = new List<int>();
        for (int i = 0; i < staff.Count; i = i + 1) { ids.Add(staff[i].id); }
        List<SysUserRole> held = new List<SysUserRole>();
        for (int start = 0; start < ids.Count; start = start + ListBatchSize) {
            SelectQuery<SysUserRole> query = db.Select<SysUserRole>();
            query.inner.WhereIn("userId", IdBatch(ids, start));
            query.inner.OrderBySafe("id");
            List<SysUserRole> batch = await query.ToListAsync();
            held.AddRange(batch);
        }
        return held;
    }

    private static async Dictionary<int, string> RoleNames(IDbConnection db, List<SysDepartmentRole> lent, List<SysUserRole> held) {
        Dictionary<int, string> names = new Dictionary<int, string>();
        for (int i = 0; i < lent.Count; i = i + 1) { names[lent[i].roleId] = "—"; }
        for (int i = 0; i < held.Count; i = i + 1) { names[held[i].roleId] = "—"; }
        List<int> ids = names.Keys;
        for (int start = 0; start < ids.Count; start = start + ListBatchSize) {
            SelectQuery<SysRole> query = db.Select<SysRole>();
            query.inner.WhereIn("id", IdBatch(ids, start));
            List<SysRole> roles = await query.ToListAsync();
            for (int i = 0; i < roles.Count; i = i + 1) { names[roles[i].id] = roles[i].name; }
        }
        return names;
    }

    /* 每层两个全角空格，使平表仍读作树。 */
    private static string Indent(List<SysDepartment> all, SysDepartment dept) {
        string pad = "";
        int parent = dept.parentId;
        int guard = 0;
        while (parent > 0 && guard < 8) {
            pad = pad + "　";
            parent = ParentOf(all, parent);
            guard = guard + 1;
        }
        return pad;
    }

    private static int ParentOf(List<SysDepartment> all, int id) {
        for (int i = 0; i < all.Count; i = i + 1) {
            if (all[i].id == id) { return all[i].parentId; }
        }
        return 0;
    }

    private static string NameOf(List<SysDepartment> all, int id) {
        for (int i = 0; i < all.Count; i = i + 1) {
            if (all[i].id == id) { return all[i].name; }
        }
        return "—";
    }

}
