        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPut]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("部门表单配置")]
    public async void FormConf() {
        int id = this.InAnyInt("id", 0);
        DataScope sc = await this.Scope();
        List<int> scoped = sc.Depts();
        int myDept = (await this.Admin()).departmentId;
        List<SysDepartment> all = await this.SysDepartment
            .WhereIf(sc.ByDept(), a => scoped.Contains(a.id))
            .WhereIf(sc.Mine(), a => a.id == myDept)
            .OrderBy(a => a.sortOrder).ToListAsync();

        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("title", id > 0 ? "编辑部门" : "新增部门");
        w.WriteProperty("width", "540px");
        w.WriteProperty("labelWidth", 90);
        w.WriteProperty("cols", 24);
        w.WritePropertyName("formItems");
        w.WriteStartArray();

        w.WriteStartObject();
        w.WriteProperty("field", "parentId");
        w.WriteProperty("label", "上级部门");
        w.WriteProperty("component", "select");
        w.WriteProperty("span", 24);
        w.WriteProperty("defaultValue", "0");
        w.WritePropertyName("options");
        w.WriteStartArray();
        if (sc.Any()) {
            w.WriteStartObject();
            w.WriteProperty("value", "0");
            w.WriteProperty("label", "顶级部门");
            w.WriteEndObject();
        }
        for (int i = 0; i < all.Count; i = i + 1) {
            if (all[i].id == id) { continue; }
            w.WriteStartObject();
            w.WriteProperty("value", Convert.ToString(all[i].id));
            w.WriteProperty("label", all[i].name);
            w.WriteEndObject();
        }
        w.WriteEndArray();
        w.WriteEndObject();

        w.WriteStartObject();
        w.WriteProperty("field", "name");
        w.WriteProperty("label", "部门名称");
        w.WriteProperty("component", "input");
        w.WriteProperty("span", 12);
        w.WriteProperty("required", true);
        w.WriteEndObject();

        w.WriteStartObject();
        w.WriteProperty("field", "code");
        w.WriteProperty("label", "部门编码");
        w.WriteProperty("component", "input");
        w.WriteProperty("span", 12);
        w.WriteEndObject();

        w.WriteStartObject();
        w.WriteProperty("field", "sortOrder");
        w.WriteProperty("label", "排序");
        w.WriteProperty("component", "input-number");
        w.WriteProperty("span", 12);
        w.WriteProperty("defaultValue", 1);
        w.WriteEndObject();

        w.WriteStartObject();
        w.WriteProperty("field", "status");
        w.WriteProperty("label", "状态");
        w.WriteProperty("component", "select");
        w.WriteProperty("span", 12);
        w.WriteProperty("defaultValue", "1");
        w.WritePropertyName("options");
        AdminUiProtocol.WriteOptArray(w, "1=启用,0=禁用");
        w.WriteEndObject();

        w.WriteEndArray();
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

