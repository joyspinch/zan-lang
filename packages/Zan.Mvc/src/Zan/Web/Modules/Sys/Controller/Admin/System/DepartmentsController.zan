    private static void WriteAddMemberPickerTool(JsonWriter w) {
        w.WriteStartObject();
        w.WriteProperty("Name", "添加成员");
        w.WriteProperty("Action", "AddMembers");
        w.WriteProperty("Type", "primary");
        w.WriteProperty("mode", "picker");
        w.WriteProperty("listUrl", "candidates");
        w.WriteProperty("saveUrl", "addmembers");
        w.WriteProperty("multiple", true);
        w.WriteProperty("rowKey", "id");
        w.WriteProperty("width", "820px");
        w.WriteProperty("height", "580px");
        w.WriteProperty("successText", "成员已加入部门");
        w.WritePropertyName("columns");
        w.WriteStartArray();
        WritePickerCol(w, "ID", "id", 65);
        WritePickerCol(w, "账号", "username", 120);
        WritePickerCol(w, "姓名", "nickname", 110);
        WritePickerCol(w, "当前部门", "departmentName", 130);
        WritePickerCol(w, "邮箱", "email", 170);
        WritePickerCol(w, "状态", "statusText", 75);
        w.WriteEndArray();
        w.WriteEndObject();
    }

    private static void WritePickerCol(JsonWriter w, string title, string key, int width) {
        w.WriteStartObject();
        w.WriteProperty("title", title);
        w.WriteProperty("key", key);
        w.WriteProperty("width", width);
        w.WriteEndObject();
    }

    private static void WriteDeptCol(JsonWriter w, string header, string field, string type, int width, string opts) {
        w.WriteStartObject();
        w.WriteProperty("headerName", header);
        w.WriteProperty("field", field);
        w.WriteProperty("type", type);
        w.WriteProperty("width", width);
        if (opts.Length > 0) {
            w.WritePropertyName("options");
            AdminUiProtocol.WriteOptArray(w, opts);
        }
        w.WriteEndObject();
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("部门树数据")]
    public async void Tree() {
        if (!this.DataReady()) { return; }
        DataScope sc = await this.Scope();
        List<int> scoped = sc.Depts();
        int myDept = (await this.Admin()).departmentId;
        int mine = sc.UserId();

        List<SysDepartment> rows = await this.SysDepartment
            .WhereIf(sc.ByDept(), a => scoped.Contains(a.id))
            .WhereIf(sc.Mine(), a => a.id == myDept)
            .OrderBy(a => a.sortOrder).ToListAsync();
        IDbConnection db = this.Held();
        List<int> deptIds = new List<int>();
        for (int i = 0; i < rows.Count; i = i + 1) { deptIds.Add(rows[i].id); }
        Dictionary<int, int> counts = await MemberCounts(db, deptIds, sc.Mine(), mine);

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            SysDepartment d = rows[i];
            int count = 0;
            counts.TryGetValue(d.id, out count);
            w.WriteStartObject();
            w.WriteProperty("id", d.id);
            w.WriteProperty("parentId", d.parentId);
            w.WriteProperty("name", d.name);
            w.WriteProperty("code", d.code);
            w.WriteProperty("sortOrder", d.sortOrder);
            w.WriteProperty("status", Convert.ToString(d.status));
            w.WriteProperty("members", count);
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("部门成员列表数据")]
    public async void List() {
        if (!this.DataReady()) { return; }
        DataScope sc = await this.Scope();
        List<int> scoped = sc.Depts();
        int myDept = (await this.Admin()).departmentId;
        int mine = sc.UserId();

        List<SysDepartment> rows = await this.SysDepartment
            .WhereIf(sc.ByDept(), a => scoped.Contains(a.id))
            .WhereIf(sc.Mine(), a => a.id == myDept)
            .OrderBy(a => a.sortOrder).ToListAsync();
        int pick = this.InAnyInt("id", 0);
        if (pick == 0 && rows.Count > 0) { pick = rows[0].id; }

        SysDepartment picked = null;
        for (int i = 0; i < rows.Count; i = i + 1) {
            if (rows[i].id == pick) { picked = rows[i]; break; }
        }
        if (picked == null) {
            AdminUiProtocol.WriteListData(this, 0, "[]");
            return;
        }

        IDbConnection db = this.Held();
        SelectQuery<SysUser> staffQuery = db.Select<SysUser>().WhereEq("departmentId", pick);
        if (sc.Mine()) { staffQuery.WhereEq("id", mine); }
        staffQuery.inner.OrderBySafe("id");
        List<SysUser> staff = await staffQuery.ToListAsync();
        List<SysUserRole> held = await StaffRoles(db, staff);

        SelectQuery<SysDepartmentRole> lentQuery = db.Select<SysDepartmentRole>().WhereEq("departmentId", pick);
        lentQuery.inner.OrderBySafe("id");
        List<SysDepartmentRole> lent = await lentQuery.ToListAsync();
        Dictionary<int, string> roleNames = await RoleNames(db, lent, held);

        StringBuilder deptRoleText = new StringBuilder();
        for (int i = 0; i < lent.Count; i = i + 1) {
            if (i > 0) { deptRoleText.Append("、"); }
            string rn = "—";
            roleNames.TryGetValue(lent[i].roleId, out rn);
            deptRoleText.Append(rn);
        }

        Dictionary<int, string> memberRoles = new Dictionary<int, string>();
        for (int i = 0; i < held.Count; i = i + 1) {
            SysUserRole link = held[i];
            string names = "";
            memberRoles.TryGetValue(link.userId, out names);
            if (names.Length > 0) { names = names + "、"; }
            string rn = "—";
            roleNames.TryGetValue(link.roleId, out rn);
            memberRoles[link.userId] = names + rn;
        }

        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("Count", staff.Count);
        w.WriteProperty("count", staff.Count);
        w.WriteProperty("total", staff.Count);
        w.WritePropertyName("Summary");
        w.WriteStartArray();
        WriteSummaryItem(w, "当前部门", picked.name, "info");
        WriteSummaryItem(w, "部门编码", Fmt.Dash(picked.code), "default");
        WriteSummaryItem(w, "继承角色", deptRoleText.Length > 0 ? deptRoleText.ToString() : "无", "warning");
        WriteSummaryItem(w, "成员数", Convert.ToString(staff.Count), "success");
        w.WriteEndArray();
        w.WritePropertyName("data");
        w.WriteStartArray();
        for (int i = 0; i < staff.Count; i = i + 1) {
            SysUser u = staff[i];
            string names = "";
            memberRoles.TryGetValue(u.id, out names);
            w.WriteStartObject();
            w.WriteProperty("id", u.id);
            w.WriteProperty("username", u.username);
            w.WriteProperty("nickname", u.nickname);
            w.WriteProperty("email", u.email);
            w.WriteProperty("mobile", u.mobile);
            w.WriteProperty("roles", names.Length > 0 ? names : "—");
            w.WriteProperty("status", Convert.ToString(u.status));
            w.WriteEndObject();
        }
        w.WriteEndArray();
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    private static void WriteSummaryItem(JsonWriter w, string label, string val, string tone) {
        w.WriteStartObject();
        w.WriteProperty("label", label);
        w.WriteProperty("value", val);
        w.WriteProperty("tone", tone);
        w.WriteEndObject();
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("部门编辑回显")]
