using System;
using System.Json;
using System.Web;
using Zan.Web.AdminUi;
using Zan.Web.Core;
using Zan.Web.Security;
using Zan.Web;
using Zan.Web.Model;

namespace Zan.Web.Admin.System;

/* /admin/system/docs 接口文档，位于管理后台内；由编译器生成的路由表构造：路径、方法、[Description] 摘要、是否需要会话/权限、参数（编译器从动作体内 In＊/Need＊ 调用收集，即处理实际读取的）、应答。原始 OpenAPI 文档仍留 /api/docs.json 供工具，此屏供人看。 */
[Custom(Authorization = CustomAuthorization.Grant, Group = "系统管理", GroupOrder = 90)]
[Description("接口文档")]
public class DocsController : AdminController {
    [HttpGet]
    [Custom(IsMenu = true, Icon = "mdi:api", Perm = PermBit.View)]
    [Description("接口文档")]
    public void Index() {
        this.Conf();
    }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("接口文档表格配置")]
    public void Conf() {
        List<Route> routes = WebHost.Current().Router().All();
        List<string> groups = new List<string>();
        for (int i = 0; i < routes.Count; i = i + 1) {
            if (!IsApiRoute(routes[i])) { continue; }
            string g = Section(routes[i].Pattern());
            if (!HasPath(groups, g)) { groups.Add(g); }
        }
        SortPaths(groups);

        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("PageType", "apidocs");

        w.WritePropertyName("Conf");
        w.WriteStartObject();
        w.WriteProperty("showPages", true);
        w.WriteProperty("pageSize", 50);
        w.WriteProperty("pageSizes", "20,50,100,200");
        w.WriteProperty("Local", false);
        w.WriteProperty("TreeData", false);
        w.WriteProperty("import", false);
        w.WriteProperty("export", true);
        w.WriteProperty("innerKey", "id");
        w.WriteProperty("innerName", "接口");
        w.WriteProperty("openapiUrl", "/api/docs.json");
        w.WriteProperty("listUrl", "/admin/system/docs/list");
        w.WriteEndObject();

        w.WritePropertyName("Columns");
        w.WriteStartArray();
        WriteDocCol(w, "方法", "method", "dict", 85, "GET=GET,POST=POST,PUT=PUT,DELETE=DELETE");
        WriteDocCol(w, "路径", "path", "text", 260, "");
        WriteDocCol(w, "摘要", "title", "text", 180, "");
        WriteDocCol(w, "认证", "authText", "dict", 100, "公开=公开,需要登录=需要登录,需要权限=需要权限");
        WriteDocCol(w, "分组", "block", "text", 160, "");
        WriteDocCol(w, "Query / Path 参数", "params", "text", 220, "");
        WriteDocCol(w, "Body 参数", "requestBody", "text", 220, "");
        WriteDocCol(w, "控制器动作", "action", "text", 200, "");
        w.WriteEndArray();

        w.WritePropertyName("Filters");
        w.WriteStartArray();
        w.WriteStartObject();
        w.WriteProperty("Name", "关键词");
        w.WriteProperty("Field", "kw");
        w.WriteProperty("Type", "Input");
        w.WriteProperty("placeholder", "搜索路径或接口描述");
        w.WriteEndObject();
        w.WriteEndArray();

        w.WritePropertyName("FilterRight");
        w.WriteStartArray();
        w.WriteEndArray();

        w.WritePropertyName("Tools");
        w.WriteStartArray();
        AdminUiProtocol.WriteDownloadAction(w, "导出 OpenAPI JSON", "info", "/api/docs.json");
        w.WriteEndArray();

        w.WritePropertyName("MenuItems");
        w.WriteStartArray();
        AdminUiProtocol.WriteDetailAction(w, "查看接口详情", "");
        w.WriteEndArray();

        w.WritePropertyName("Tabs");
        w.WriteStartArray();
        w.WriteStartObject();
        w.WriteProperty("Name", "全部");
        w.WriteProperty("Field", "g");
        w.WriteProperty("Value", "");
        w.WriteEndObject();
        for (int i = 0; i < groups.Count; i = i + 1) {
            w.WriteStartObject();
            w.WriteProperty("Name", groups[i]);
            w.WriteProperty("Field", "g");
            w.WriteProperty("Value", groups[i]);
            w.WriteEndObject();
        }
        w.WriteEndArray();

        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    private static void WriteDocCol(JsonWriter w, string header, string field, string type, int width, string opts) {
        w.WriteStartObject();
        w.WriteProperty("headerName", header);
        w.WriteProperty("field", field);
        w.WriteProperty("type", type);
        w.WriteProperty("width", width);
        if (opts.Length > 0) {
            w.WritePropertyName("options");
            AdminUiProtocol.WriteOptArray(w, opts);
        }
        w.WriteEndObject();
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("接口文档列表数据")]
    public void List() {
        List<Route> routes = WebHost.Current().Router().All();
        string kw = this.InAny("kw").Trim();
        string g = this.InAny("g").Trim();
        ListQuery q = this.PagedAny("id", 50);

        List<string> paths = new List<string>();
        for (int i = 0; i < routes.Count; i = i + 1) {
            if (!IsApiRoute(routes[i])) { continue; }
            if (!Match(routes[i], kw)) { continue; }
            string p = routes[i].Pattern();
            if (g.Length > 0 && Section(p) != g) { continue; }
            if (!HasPath(paths, p)) { paths.Add(p); }
        }
        SortPaths(paths);

        List<Route> matched = new List<Route>();
        for (int i = 0; i < paths.Count; i = i + 1) {
            for (int j = 0; j < routes.Count; j = j + 1) {
                if (!IsApiRoute(routes[j])) { continue; }
                if (routes[j].Pattern() != paths[i]) { continue; }
                if (!Match(routes[j], kw)) { continue; }
                matched.Add(routes[j]);
            }
        }

        int total = matched.Count;
        bool fetchAll = this.InAny("all").Trim() == "1";
        int start = fetchAll ? 0 : q.Skip();
        int end = fetchAll ? total : start + q.Limit();
        if (end > total) { end = total; }

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = start; i < end; i = i + 1) {
            Route r = matched[i];
            string path = r.Pattern();
            w.WriteStartObject();
            w.WriteProperty("id", i + 1);
            w.WriteProperty("method", r.Method());
            w.WriteProperty("path", path);
            w.WriteProperty("title", Fmt.Dash(r.GetTitle()));
            w.WriteProperty("authText", AuthText(r));
            w.WriteProperty("section", Section(path));
            w.WriteProperty("block", Block(path));
            w.WriteProperty("params", Params(r, false));
            w.WriteProperty("requestBody", Params(r, true));
            w.WritePropertyName("paramItems");
            WriteParamItems(w, r);
            w.WriteProperty("responses", Responses(r));
            w.WriteProperty("sample", Sample(r));
            w.WriteProperty("action", r.Action());
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, total, w.ToString());
    }

    private static void WriteParamItems(JsonWriter w, Route r) {
        bool form = r.Method() != "GET" && r.Method() != "HEAD";
        w.WriteStartArray();
        for (int i = 0; i < r.DocParams().Count; i = i + 1) {
            ApiParam p = r.DocParams()[i];
            string loc = p.Source();
            if (loc.Length == 0) {
                loc = form ? "body" : "query";
            } else if (form && loc != "path") {
                loc = "body";
            }
            w.WriteStartObject();
            w.WriteProperty("name", p.Name());
            w.WriteProperty("in", loc);
            w.WriteProperty("type", p.JsonType());
            w.WriteProperty("required", p.Required());
            w.WriteProperty("default", p.Default());
            w.WriteProperty("description", p.Desc());
            w.WriteEndObject();
        }
        w.WriteEndArray();
    }

    /* 接口文档仅展示真实 API / 业务动作接口，过滤静态文件、SEO 元文件与纯 HTML 页面入口。 */
    private static bool IsApiRoute(Route r) {
        string p = r.Pattern();
        string m = r.Method();
        if (p == "/" || p.Length == 0) { return false; }
        if (p.Length >= 13 && p.Substring(0, 13) == "/.well-known/") { return false; }
        if (EndsWith(p, ".txt") || EndsWith(p, ".xml") || EndsWith(p, ".ico")
            || EndsWith(p, ".html") || EndsWith(p, ".css") || EndsWith(p, ".js") || EndsWith(p, ".map")) {
            return false;
        }
        if (m == "GET" && (p == "/login" || p == "/login/index"
            || p == "/register" || p == "/register/index"
            || p == "/forgot" || p == "/forgot/index"
            || p == "/admin/login" || p == "/admin/logout")) {
            return false;
        }
        /* 过滤与主路径等价的 /index 兼容别名，避免接口列表重复展示。 */
        if (p.Length > 6 && EndsWith(p, "/index")) {
            return false;
        }
        return true;
    }

    private static bool EndsWith(string s, string suffix) {
        if (s.Length < suffix.Length) { return false; }
        return s.Substring(s.Length - suffix.Length) == suffix;
    }

    private static bool Match(Route r, string kw) {
        if (kw.Length == 0) { return true; }
        if (r.Pattern().Contains(kw)) { return true; }
        return r.GetTitle().Contains(kw);
    }

    /* 动作读取的参数，作 "name:type* 说明"；body 选写操作表单字段，否则 query/path 字段。 */
    private static string Params(Route r, bool body) {
        bool form = r.Method() != "GET" && r.Method() != "HEAD";
        string s = "";
        for (int i = 0; i < r.DocParams().Count; i = i + 1) {
            ApiParam p = r.DocParams()[i];
            bool inBody = form && p.Source() != "path";
            if (inBody != body) { continue; }
            if (s.Length > 0) { s = s + "   "; }
            s = s + p.Name() + ":" + p.JsonType();
            if (p.Required()) { s = s + "*"; }
            else if (p.Default().Length > 0) { s = s + "=" + p.Default(); }
        }
        if (s.Length == 0) {
            if (body) { return ""; }
            return "—";
        }
        return s;
    }

    /* 端点可答的状态及各自形态；与 /api/docs.json 同集。 */
    private static string Responses(Route r) {
        if (IsStream(r)) {
            return "200 text/event-stream （持续推送 metrics / series 事件）"
                + "   401 未登录   403 无权限";
        }
        if (IsJson(r)) {
            string s = "200 application/json {code:string, msg:string, data:any}"
                + "   400 参数不合法";
            if (Private(r)) { s = s + "   401 未登录   403 无权限"; }
            return s + "   404 对象不存在";
        }
        string h = "200 text/html 页面";
        if (Private(r)) { h = h + "   302 未登录时跳转登录页   403 无权限"; }
        return h;
    }

    private static string Sample(Route r) {
        if (IsStream(r)) {
            return "event: metrics / data: {\"count\":128,\"errors\":0,\"avg_us\":312}";
        }
        if (IsJson(r)) {
            return "{\"code\":\"0000\",\"msg\":\"ok\",\"data\":null}";
        }
        return "HTML 文档（管理后台内以面板片段返回）";
    }

    private static bool IsStream(Route r) {
        return r.Pattern().Contains("/stream");
    }

    private static bool IsJson(Route r) {
        string p = r.Pattern();
        if (p.Length >= 5 && p.Substring(0, 5) == "/api/") {
            return true;
        }
        if (p == "/admin/login" || p == "/admin/logout") {
            return false;
        }
        if (p.Length >= 6 && p.Substring(0, 6) == "/admin") {
            return true;
        }
        return r.Method() != "GET";
    }

    /* 端点是否需要授权——即路由属性本身，无第二份清单可查。 */
    private static bool Guarded(Route r) {
        return r.NeedsAuth();
    }

    private static bool Private(Route r) {
        if (r.NeedsLogin() || r.NeedsAuth()) { return true; }
        /* /admin/login 前缀含 GET 卡与 POST /admin/login/submit；登出同豁免。 */
        if (r.Pattern().Length >= 12 && r.Pattern().Substring(0, 12) == "/admin/login") { return false; }
        if (r.Pattern() == "/admin/logout") { return false; }
        return r.Pattern().Length >= 6 && r.Pattern().Substring(0, 6) == "/admin";
    }

    private static string AuthText(Route r) {
        if (Guarded(r)) { return "需要权限"; }
        if (Private(r)) { return "需要登录"; }
        return "公开";
    }

    private static string AuthClass(Route r) {
        if (Guarded(r)) { return "warn"; }
        if (Private(r)) { return "post"; }
        return "ok";
    }

    private static string MethodClass(string method) {
        if (method == "GET") { return "get"; }
        if (method == "POST") { return "post"; }
        if (method == "PUT") { return "put"; }
        if (method == "DELETE") { return "del"; }
        return "";
    }

    /* 第一段路径，读者扫的就是它。 */
    private static string Section(string path) {
        string s = path;
        if (s.Length > 0 && s.Substring(0, 1) == "/") { s = s.Substring(1); }
        int slash = s.IndexOf("/");
        if (slash > 0) { s = s.Substring(0, slash); }
        if (s.Length == 0) { return "/"; }
        return "/" + s;
    }

    /* 端点在其标签下的两段前缀；占位段不开单块。 */
    private static string Block(string path) {
        string s = path;
        if (s.Length > 0 && s.Substring(0, 1) == "/") { s = s.Substring(1); }
        int first = s.IndexOf("/");
        if (first < 0) { return path; }
        string head = s.Substring(0, first);
        string rest = s.Substring(first + 1);
        int second = rest.IndexOf("/");
        if (second >= 0) { rest = rest.Substring(0, second); }
        if (rest.Length == 0) { return "/" + head; }
        if (rest.Substring(0, 1) == "{") { return "/" + head; }
        return "/" + head + "/" + rest;
    }

    private static bool HasPath(List<string> paths, string p) {
        for (int i = 0; i < paths.Count; i = i + 1) {
            if (paths[i] == p) { return true; }
        }
        return false;
    }

    private static void SortPaths(List<string> paths) {
        for (int i = 1; i < paths.Count; i = i + 1) {
            string cur = paths[i];
            int j = i - 1;
            while (j >= 0 && paths[j] > cur) {
                paths[j + 1] = paths[j];
                j = j - 1;
            }
            paths[j + 1] = cur;
        }
    }
}
