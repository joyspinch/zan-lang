using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model;

namespace Zan.Web.Dao;

/* media 的数据读写网关 */
public class SysMediaFileDao : BaseRepository<SysMediaFile> {
    public SysMediaFileDao() : base() {}
    public SysMediaFileDao(IZanSql fsql) : base(fsql) {}
    public SysMediaFileDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async SysMediaFile ById(int id) {
        return await this.GetExecutor().Select<SysMediaFile>().Where(a => a.id == id).FirstAsync();
    }

    public async List<SysMediaFile> All() {
        return await this.GetExecutor().Select<SysMediaFile>().OrderByDescending(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<SysMediaFile>().CountAsync();
    }

    public InsertQuery<SysMediaFile> Insert(SysMediaFile file) {
        return this.GetExecutor().Insert<SysMediaFile>(file);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<SysMediaFile>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
