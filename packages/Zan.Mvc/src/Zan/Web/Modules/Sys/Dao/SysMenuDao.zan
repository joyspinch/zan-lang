using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model;

namespace Zan.Web.Dao;

/* sys_menu 表数据访问网关 */
public class SysMenuDao : BaseRepository<SysMenu> {
    public SysMenuDao() : base() {}
    public SysMenuDao(IZanSql fsql) : base(fsql) {}
    public SysMenuDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async SysMenu ById(int id) {
        return await this.GetExecutor().Select<SysMenu>()
            .Where(a => a.id == id).FirstAsync();
    }

    public async SysMenu ByActionKey(string actionKey) {
        return await this.GetExecutor().Select<SysMenu>()
            .Where(a => a.actionKey == actionKey).FirstAsync();
    }

    public async List<SysMenu> AllOrdered() {
        return await this.GetExecutor().Select<SysMenu>()
            .OrderBy(a => a.groupOrder)
            .OrderBy(a => a.sortOrder)
            .OrderBy(a => a.id)
            .ToListAsync();
    }

    public InsertQuery<SysMenu> Insert(SysMenu menu) {
        return this.GetExecutor().Insert<SysMenu>(menu);
    }

    public UpdateQuery<SysMenu> Update() {
        return this.GetExecutor().Update<SysMenu>();
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<SysMenu>()
            .Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
