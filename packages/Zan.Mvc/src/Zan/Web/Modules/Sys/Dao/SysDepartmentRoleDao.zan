using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model;

namespace Zan.Web.Dao;

/* sys_department_role 的数据读写网关 */
public class SysDepartmentRoleDao : BaseRepository<SysDepartmentRole> {
    public SysDepartmentRoleDao() : base() {}
    public SysDepartmentRoleDao(IZanSql fsql) : base(fsql) {}
    public SysDepartmentRoleDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async SysDepartmentRole ById(int id) {
        return await this.GetExecutor().Select<SysDepartmentRole>().Where(a => a.id == id).FirstAsync();
    }

    public async List<SysDepartmentRole> ByDepartmentId(int deptId) {
        return await this.GetExecutor().Select<SysDepartmentRole>()
            .Where(a => a.departmentId == deptId)
            .ToListAsync();
    }

    public async List<SysDepartmentRole> ByRoleId(int roleId) {
        return await this.GetExecutor().Select<SysDepartmentRole>()
            .Where(a => a.roleId == roleId)
            .ToListAsync();
    }

    public InsertQuery<SysDepartmentRole> Insert(SysDepartmentRole dr) {
        return this.GetExecutor().Insert<SysDepartmentRole>(dr);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<SysDepartmentRole>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    public async int DeleteByDepartmentId(int deptId) {
        return await this.GetExecutor().Delete<SysDepartmentRole>().Where(a => a.departmentId == deptId).ExecuteAffrowsAsync();
    }
}
