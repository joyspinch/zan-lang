using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model;

namespace Zan.Web.Dao;

/* sys_job 的数据读写网关 */
public class SysJobDao : BaseRepository<SysJob> {
    public SysJobDao() : base() {}
    public SysJobDao(IZanSql fsql) : base(fsql) {}
    public SysJobDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async SysJob ById(int id) {
        return await this.GetExecutor().Select<SysJob>().Where(a => a.id == id).FirstAsync();
    }

    public async List<SysJob> All() {
        return await this.GetExecutor().Select<SysJob>().OrderBy(a => a.id).ToListAsync();
    }

    public InsertQuery<SysJob> Insert(SysJob job) {
        return this.GetExecutor().Insert<SysJob>(job);
    }

    public async int Update(SysJob job) {
        return await this.GetExecutor().Update<SysJob>()
            .Set(a => a.name, job.name)
            .Set(a => a.kind, job.kind)
            .Set(a => a.param, job.param)
            .Set(a => a.intervalSec, job.intervalSec)
            .Set(a => a.enabled, job.enabled)
            .Where(a => a.id == job.id)
            .ExecuteAffrowsAsync();
    }

    public async int SetEnabled(int id, int enabled) {
        return await this.GetExecutor().Update<SysJob>()
            .Set(a => a.enabled, enabled)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<SysJob>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
