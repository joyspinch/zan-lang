using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using Zan.Web.Model;
using Zan.Web.Core;

namespace Zan.Web.Dao;

/* sys_user 的读写入口；继承 BaseRepository<SysUser>，登录、令牌解析和管理后台都经此路由，账号表唯一网关。DAO 自动复用调用方连接或 ZanSql 门面。所有方法异步，认证解析器也在请求协程上运行，不阻塞工作线程。 */
public class SysUserDao : BaseRepository<SysUser> {
    public SysUserDao() : base() {}
    public SysUserDao(IZanSql fsql) : base(fsql) {}
    public SysUserDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    // 静态快捷存取方法（零外部传参，自动解析当前上下文）
    public static async SysUser FindByUsername(string username) {
        return await ZanSql.Current.Select<SysUser>()
            .Where(a => a.username == username)
            .FirstAsync();
    }

    public async SysUser ByUsername(string username) {
        return await this.GetExecutor().Select<SysUser>()
            .Where(a => a.username == username)
            .FirstAsync();
    }

    public async SysUser ByEmail(string email) {
        return await this.GetExecutor().Select<SysUser>()
            .Where(a => a.email == email)
            .FirstAsync();
    }

    public async int CountByUsername(string username) {
        return await this.GetExecutor().Select<SysUser>()
            .Where(a => a.username == username)
            .CountAsync();
    }

    public async int CountByEmail(string email) {
        return await this.GetExecutor().Select<SysUser>()
            .Where(a => a.email == email)
            .CountAsync();
    }

    public async SysUser ById(int id) {
        return await this.GetExecutor().Select<SysUser>().Where(a => a.id == id).FirstAsync();
    }

    /* 返回所有账号实体列表（ZanSql 风格直接操作/返回实体） */
    public async List<SysUser> All() {
        return await this.GetExecutor().Select<SysUser>()
            .OrderBy(a => a.id)
            .ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<SysUser>().CountAsync();
    }

    public async int CountAsync() {
        return await this.GetExecutor().Select<SysUser>().CountAsync();
    }

    public InsertQuery<SysUser> Insert(SysUser user) {
        return this.GetExecutor().Insert<SysUser>(user);
    }

    /* 启用(1)/禁用(0)账号；禁用后无法登录，已发令牌也失效。返回影响行数。 */
    public async int SetStatus(int id, int status) {
        return await this.GetExecutor().Update<SysUser>()
            .Set(a => a.status, status)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    /* 更新账号基本属性 */
    public async int UpdateProfile(int id, string username, string nickname, string email, string mobile, int departmentId, int status, long updatedAt) {
        return await this.GetExecutor().Update<SysUser>()
            .Set(a => a.username, username)
            .Set(a => a.nickname, nickname)
            .Set(a => a.email, email)
            .Set(a => a.mobile, mobile)
            .Set(a => a.departmentId, departmentId)
            .Set(a => a.status, status)
            .Set(a => a.updatedAt, updatedAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    /* 更新个人资料 */
    public async int UpdatePersonal(int id, string nickname, string email, string mobile, long updatedAt) {
        return await this.GetExecutor().Update<SysUser>()
            .Set(a => a.nickname, nickname)
            .Set(a => a.email, email)
            .Set(a => a.mobile, mobile)
            .Set(a => a.updatedAt, updatedAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    /* 删除账号，返回影响行数。 */
    public async int Delete(int id) {
        return await this.GetExecutor().Delete<SysUser>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    /* 重置密码 */
    public async int ResetPassword(int id, string salt, string hash, long updatedAt) {
        return await this.GetExecutor().Update<SysUser>()
            .Set(a => a.passwordSalt, salt)
            .Set(a => a.passwordHash, hash)
            .SetIncr(a => a.tokenVersion, 1)
            .Set(a => a.updatedAt, updatedAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    /* 数据库内原子递增，不能先读再写，否则并发撤销会丢更新。 */
    public async int BumpTokenVersion(int id) {
        return await this.GetExecutor().Update<SysUser>()
            .SetIncr(a => a.tokenVersion, 1)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    /* 登录成功后的哈希格式升级（遗留链 → pbkdf2$）。只改凭证材料，
       不 bump tokenVersion——已发会话与口令哈希无关。 */
    public async int UpgradeHash(int id, string hash, long updatedAt) {
        return await this.GetExecutor().Update<SysUser>()
            .Set(a => a.passwordHash, hash)
            .Set(a => a.updatedAt, updatedAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    /* 范围计数：数据权限过滤。 */
    public async int CountScoped(bool byDept, List<int> depts, bool mine, int myId) {
        return await this.GetExecutor().Select<SysUser>()
            .WhereIf(byDept, a => depts.Contains(a.departmentId))
            .WhereIf(mine, a => a.id == myId)
            .CountAsync();
    }

    /* 管理后台分页计数 */
    public async int CountPaged(string kw, int status, bool byDept, List<int> scoped, bool mine, int myId) {
        bool hasKw = kw != null && kw.Length > 0;
        return await this.GetExecutor().Select<SysUser>()
            .WhereIf(hasKw, a => a.username.Contains(kw))
            .WhereIf(status >= 0, a => a.status == status)
            .WhereIf(byDept, a => scoped.Contains(a.departmentId))
            .WhereIf(mine, a => a.id == myId)
            .CountAsync();
    }

    /* 管理后台分页列表 */
    public async List<SysUser> PagedList(string kw, int status, bool byDept, List<int> scoped, bool mine, int myId, int skip, int limit) {
        bool hasKw = kw != null && kw.Length > 0;
        return await this.GetExecutor().Select<SysUser>()
            .WhereIf(hasKw, a => a.username.Contains(kw))
            .WhereIf(status >= 0, a => a.status == status)
            .WhereIf(byDept, a => scoped.Contains(a.departmentId))
            .WhereIf(mine, a => a.id == myId)
            .OrderByDescending(a => a.id)
            .Skip(skip).Take(limit)
            .ToListAsync();
    }

    public async List<SysUser> ByDeptIds(List<int> depts) {
        return await this.GetExecutor().Select<SysUser>()
            .Where(a => depts.Contains(a.departmentId))
            .ToListAsync();
    }

    /* 批量端点的取数与写：类型化 IN 条件（ids.Contains）由编译器降级
       成参数化绑定，调用方保证 ids 非空。 */
    public async List<SysUser> ByIds(List<int> ids) {
        if (ids.Count == 0) { return new List<SysUser>(); }
        return await this.GetExecutor().Select<SysUser>()
            .Where(a => ids.Contains(a.id))
            .ToListAsync();
    }

    public async int SetStatusByIds(List<int> ids, int status) {
        if (ids.Count == 0) { return 0; }
        return await this.GetExecutor().Update<SysUser>()
            .Set(a => a.status, status)
            .Set(a => a.updatedAt, WebApp.NowSeconds())
            .Where(a => ids.Contains(a.id))
            .ExecuteAffrowsAsync();
    }

    public async int DeleteByIds(List<int> ids) {
        if (ids.Count == 0) { return 0; }
        return await this.GetExecutor().Delete<SysUser>()
            .Where(a => ids.Contains(a.id))
            .ExecuteAffrowsAsync();
    }

    /* 声明式列表取数：conds（ListPage.Collect 产出）交给 ORM 的
     * WhereConds——列名按实体元数据校验、值全部走绑定参数，本层不再
     * 接触 SQL 文本。数据边界（部门/本人范围）用类型化条件表达，仍由
     * 本 DAO 掌握，界面声明越不过权限。 */
    public async int CountBy(List<OrmCond> conds, bool byDept, List<int> scoped, bool mine, int myId) {
        return await this.GetExecutor().Select<SysUser>()
            .WhereConds(conds)
            .WhereIf(byDept, a => scoped.Contains(a.departmentId))
            .WhereIf(mine, a => a.id == myId)
            .CountAsync();
    }

    public async List<SysUser> PagedListBy(List<OrmCond> conds, bool byDept, List<int> scoped, bool mine, int myId, int skip, int limit) {
        return await this.GetExecutor().Select<SysUser>()
            .WhereConds(conds)
            .WhereIf(byDept, a => scoped.Contains(a.departmentId))
            .WhereIf(mine, a => a.id == myId)
            .OrderByDescending(a => a.id)
            .Skip(skip).Take(limit)
            .ToListAsync();
    }
}