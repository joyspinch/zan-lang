using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model;

namespace Zan.Web.Dao;

/* sys_job_log 的数据读写网关 */
public class SysJobLogDao : BaseRepository<SysJobLog> {
    public SysJobLogDao() : base() {}
    public SysJobLogDao(IZanSql fsql) : base(fsql) {}
    public SysJobLogDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async List<SysJobLog> ByJobId(int jobId, int limit) {
        return await this.GetExecutor().Select<SysJobLog>()
            .Where(a => a.jobId == jobId)
            .OrderByDescending(a => a.id)
            .Take(limit)
            .ToListAsync();
    }

    public InsertQuery<SysJobLog> Insert(SysJobLog log) {
        return this.GetExecutor().Insert<SysJobLog>(log);
    }
}
