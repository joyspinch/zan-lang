using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model;

namespace Zan.Web.Dao;

/* sys_login_log 的数据读写网关 */
public class SysLoginLogDao : BaseRepository<SysLoginLog> {
    public SysLoginLogDao() : base() {}
    public SysLoginLogDao(IZanSql fsql) : base(fsql) {}
    public SysLoginLogDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async SysLoginLog ById(int id) {
        return await this.GetExecutor().Select<SysLoginLog>().Where(a => a.id == id).FirstAsync();
    }

    public async List<SysLoginLog> Latest(int limit) {
        return await this.GetExecutor().Select<SysLoginLog>()
            .OrderByDescending(a => a.id)
            .Take(limit)
            .ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<SysLoginLog>().CountAsync();
    }

    public InsertQuery<SysLoginLog> Insert(SysLoginLog log) {
        return this.GetExecutor().Insert<SysLoginLog>(log);
    }

    public async int CountScoped(string kw, bool byActor, List<string> actors, bool nothing) {
        return await this.GetExecutor().Select<SysLoginLog>()
            .WhereIf(kw.Length > 0, a => a.username.Contains(kw))
            .WhereIf(byActor, a => actors.Contains(a.username))
            .WhereIf(nothing, a => a.id < 0)
            .CountAsync();
    }

    public async List<SysLoginLog> PagedScoped(string kw, bool byActor, List<string> actors, bool nothing, int skip, int limit) {
        return await this.GetExecutor().Select<SysLoginLog>()
            .WhereIf(kw.Length > 0, a => a.username.Contains(kw))
            .WhereIf(byActor, a => actors.Contains(a.username))
            .WhereIf(nothing, a => a.id < 0)
            .OrderByDescending(a => a.id)
            .Skip(skip).Take(limit).ToListAsync();
    }

    public async int ClearAll() {
        return await this.GetExecutor().Delete<SysLoginLog>().Where(a => a.id > 0).ExecuteAffrowsAsync();
    }
}
