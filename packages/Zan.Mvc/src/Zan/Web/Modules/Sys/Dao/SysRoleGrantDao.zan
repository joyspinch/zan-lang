using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model;

namespace Zan.Web.Dao;

/* sys_role_grant 的数据读写网关 */
public class SysRoleGrantDao : BaseRepository<SysRoleGrant> {
    public SysRoleGrantDao() : base() {}
    public SysRoleGrantDao(IZanSql fsql) : base(fsql) {}
    public SysRoleGrantDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async SysRoleGrant ById(int id) {
        return await this.GetExecutor().Select<SysRoleGrant>().Where(a => a.id == id).FirstAsync();
    }

    public async List<SysRoleGrant> ByRoleId(int roleId) {
        return await this.GetExecutor().Select<SysRoleGrant>()
            .Where(a => a.roleId == roleId)
            .ToListAsync();
    }

    public InsertQuery<SysRoleGrant> Insert(SysRoleGrant rg) {
        return this.GetExecutor().Insert<SysRoleGrant>(rg);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<SysRoleGrant>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    public async int DeleteByRoleId(int roleId) {
        return await this.GetExecutor().Delete<SysRoleGrant>().Where(a => a.roleId == roleId).ExecuteAffrowsAsync();
    }
}
