using System;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model;

namespace Zan.Web.Dao;

/* sys_department 表数据访问网关：每表一个 DAO，专门负责该表持久化与业务查询 */
public class SysDepartmentDao : BaseRepository<SysDepartment> {
    public SysDepartmentDao() : base() {}
    public SysDepartmentDao(IZanSql fsql) : base(fsql) {}
    public SysDepartmentDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async SysDepartment ById(int id) {
        return await this.GetExecutor().Select<SysDepartment>().Where(a => a.id == id).FirstAsync();
    }

    public async List<SysDepartment> All() {
        return await this.GetExecutor().Select<SysDepartment>()
            .OrderBy(a => a.sortOrder)
            .ToListAsync();
    }

    public async List<SysDepartment> Scoped(bool byDept, List<int> scopedDepts, bool mine) {
        return await this.GetExecutor().Select<SysDepartment>()
            .WhereIf(byDept, a => scopedDepts.Contains(a.id))
            .WhereIf(mine, a => a.id < 0)
            .OrderBy(a => a.sortOrder)
            .ToListAsync();
    }

    public async List<SysDepartment> ByParent(int parentId) {
        return await this.GetExecutor().Select<SysDepartment>()
            .Where(a => a.parentId == parentId)
            .OrderBy(a => a.sortOrder)
            .ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<SysDepartment>().CountAsync();
    }

    public InsertQuery<SysDepartment> Insert(SysDepartment dept) {
        return this.GetExecutor().Insert<SysDepartment>(dept);
    }

    public async int UpdateBasic(int id, string name, string code, int parentId, int sortOrder, int status) {
        return await this.GetExecutor().Update<SysDepartment>()
            .Set(a => a.name, name)
            .Set(a => a.code, code)
            .Set(a => a.parentId, parentId)
            .Set(a => a.sortOrder, sortOrder)
            .Set(a => a.status, status)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    public async int Update(SysDepartment dept) {
        return await this.UpdateBasic(dept.id, dept.name, dept.code, dept.parentId, dept.sortOrder, dept.status);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<SysDepartment>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
