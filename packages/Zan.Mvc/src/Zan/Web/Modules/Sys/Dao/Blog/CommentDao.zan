using System;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Blog;

namespace Zan.Web.Dao.Blog;

/* blog_comment 表数据访问网关：每表一个 DAO，专职该表持久化与查询 */
public class CommentDao : BaseRepository<Comment> {
    public CommentDao() : base() {}
    public CommentDao(IZanSql fsql) : base(fsql) {}
    public CommentDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async Comment ById(int id) {
        return await this.GetExecutor().Select<Comment>().Where(a => a.id == id).FirstAsync();
    }

    public async List<Comment> ByPost(int postId) {
        return await this.GetExecutor().Select<Comment>()
            .Where(a => a.postId == postId && a.status == 1)
            .OrderByDescending(a => a.id)
            .ToListAsync();
    }

    public async List<Comment> ByPostId(int postId) {
        return await this.GetExecutor().Select<Comment>()
            .Where(a => a.postId == postId && a.status == 1)
            .OrderByDescending(a => a.id)
            .ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<Comment>().CountAsync();
    }

    public async int CountPending() {
        return await this.GetExecutor().Select<Comment>().Where(a => a.status == 0).CountAsync();
    }

    public InsertQuery<Comment> Insert(Comment c) {
        return this.GetExecutor().Insert<Comment>(c);
    }

    public async int SetStatus(int id, int status) {
        return await this.GetExecutor().Update<Comment>()
            .Set(a => a.status, status)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<Comment>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
