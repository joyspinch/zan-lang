using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model;
using Zan.Web.Core;

namespace Zan.Web.Dao;

/* sys_operation_log 的数据读写网关 */
public class SysOperationLogDao : BaseRepository<SysOperationLog> {
    public SysOperationLogDao() : base() {}
    public SysOperationLogDao(IZanSql fsql) : base(fsql) {}
    public SysOperationLogDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async SysOperationLog ById(int id) {
        return await this.GetExecutor().Select<SysOperationLog>().Where(a => a.id == id).FirstAsync();
    }

    public async List<SysOperationLog> Latest(int limit) {
        return await this.GetExecutor().Select<SysOperationLog>()
            .OrderByDescending(a => a.id)
            .Take(limit)
            .ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<SysOperationLog>().CountAsync();
    }

    public InsertQuery<SysOperationLog> Insert(SysOperationLog log) {
        return this.GetExecutor().Insert<SysOperationLog>(log);
    }

    public async int CountScoped(string kw, bool byActor, List<int> actors) {
        return await this.GetExecutor().Select<SysOperationLog>()
            .WhereIf(kw.Length > 0, a => a.username.Contains(kw))
            .WhereIf(byActor, a => actors.Contains(a.userId))
            .CountAsync();
    }

    public async List<SysOperationLog> PagedScoped(string kw, bool byActor, List<int> actors, int skip, int limit) {
        return await this.GetExecutor().Select<SysOperationLog>()
            .WhereIf(kw.Length > 0, a => a.username.Contains(kw))
            .WhereIf(byActor, a => actors.Contains(a.userId))
            .OrderByDescending(a => a.id)
            .Skip(skip).Take(limit).ToListAsync();
    }

    /* 声明式列表取数（ListPage.Collect 产出 conds）：kw 走操作人/标题
       双列 OR LIKE（WhereConds 按 "t.username|t.title" 逐列校验并绑定），
       时间区间走 GE/LE；数据边界仍由本 DAO 掌握。 */
    public async int CountBy(List<OrmCond> conds, bool byActor, List<int> actors) {
        return await this.GetExecutor().Select<SysOperationLog>()
            .WhereConds(conds)
            .WhereIf(byActor, a => actors.Contains(a.userId))
            .CountAsync();
    }

    public async List<SysOperationLog> PagedListBy(List<OrmCond> conds, bool byActor, List<int> actors, int skip, int limit) {
        return await this.GetExecutor().Select<SysOperationLog>()
            .WhereConds(conds)
            .WhereIf(byActor, a => actors.Contains(a.userId))
            .OrderByDescending(a => a.id)
            .Skip(skip).Take(limit)
            .ToListAsync();
    }

    public async int ClearAll() {
        return await this.GetExecutor().Delete<SysOperationLog>().Where(a => a.id > 0).ExecuteAffrowsAsync();
    }
}
