using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model;

namespace Zan.Web.Dao;

/* sys_setting 的数据读写网关 */
public class SysSiteSettingDao : BaseRepository<SysSiteSetting> {
    public SysSiteSettingDao() : base() {}
    public SysSiteSettingDao(IZanSql fsql) : base(fsql) {}
    public SysSiteSettingDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async SysSiteSetting ById(int id) {
        return await this.GetExecutor().Select<SysSiteSetting>().Where(a => a.id == id).FirstAsync();
    }

    public async SysSiteSetting ByName(string name) {
        return await this.GetExecutor().Select<SysSiteSetting>().Where(a => a.name == name).FirstAsync();
    }

    public async List<SysSiteSetting> All() {
        return await this.GetExecutor().Select<SysSiteSetting>().OrderBy(a => a.sortOrder).ToListAsync();
    }

    public async List<SysSiteSetting> ByGroupName(string groupName) {
        return await this.GetExecutor().Select<SysSiteSetting>()
            .Where(a => a.groupName == groupName)
            .OrderBy(a => a.sortOrder)
            .ToListAsync();
    }

    public async int SetValue(string name, string value) {
        return await this.GetExecutor().Update<SysSiteSetting>()
            .Set(a => a.value, value)
            .Set(a => a.updatedAt, WebApp.NowSeconds())
            .Where(a => a.name == name)
            .ExecuteAffrowsAsync();
    }

    public async int UpdateValueById(int id, string value, long updatedAt) {
        return await this.GetExecutor().Update<SysSiteSetting>()
            .Set(a => a.value, value)
            .Set(a => a.updatedAt, updatedAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    public async int Insert(SysSiteSetting s) {
        return await this.GetExecutor().Insert<SysSiteSetting>(s).ExecuteIdentityAsync();
    }
}
