using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model;

namespace Zan.Web.Dao;

/* wiki_doc 的数据读写网关 */
public class SysWikiDocDao : BaseRepository<SysWikiDoc> {
    public SysWikiDocDao() : base() {}
    public SysWikiDocDao(IZanSql fsql) : base(fsql) {}
    public SysWikiDocDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async SysWikiDoc ById(int id) {
        return await this.GetExecutor().Select<SysWikiDoc>().Where(a => a.id == id).FirstAsync();
    }

    public async List<SysWikiDoc> BySpace(int spaceId) {
        return await this.GetExecutor().Select<SysWikiDoc>()
            .Where(a => a.spaceId == spaceId)
            .OrderByDescending(a => a.id)
            .ToListAsync();
    }

    public InsertQuery<SysWikiDoc> Insert(SysWikiDoc doc) {
        return this.GetExecutor().Insert<SysWikiDoc>(doc);
    }

    public async int Update(SysWikiDoc doc) {
        return await this.GetExecutor().Update<SysWikiDoc>()
            .Set(a => a.spaceId, doc.spaceId)
            .Set(a => a.title, doc.title)
            .Set(a => a.body, doc.body)
            .Set(a => a.summary, doc.summary)
            .Set(a => a.tags, doc.tags)
            .Set(a => a.status, doc.status)
            .Set(a => a.rev, doc.rev)
            .Where(a => a.id == doc.id)
            .ExecuteAffrowsAsync();
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<SysWikiDoc>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
