using System;
using System.Data.Orm;
using Zan.Web;

namespace Zan.Web.Model;

[Table(Name = "sys_menu")]
public class SysMenu : RowView {
    [Column(IsIdentity = true)]
    public int id;

    public int parentId;

    /* 路由动作唯一键（如 Zan.Web.Admin.System.UsersController.Index）；自定义/外链菜单为空串。 */
    [Column(StringLength = 128, IsNullable = false)]
    public string actionKey;

    [Column(StringLength = 64, IsNullable = false)]
    public string title;

    [Column(StringLength = 192, IsNullable = false)]
    public string path;

    [Column(StringLength = 64, IsNullable = false)]
    public string groupName;

    public int groupOrder;
    public int sortOrder;

    [Column(StringLength = 64, IsNullable = false)]
    public string icon;

    /* 权限判定键：为空时只需登录即可见，非空时过 AuthUser.Allow。 */
    [Column(StringLength = 128, IsNullable = false)]
    public string permAction;

    /* 0=显示, 1=隐藏 */
    public int hidden;

    /* 1=启用, 0=停用 */
    public int status;

    /* 0=跟随路由自动同步, 1=管理员已手动定制（启动同步保留标题/分组/排序/图标/显隐） */
    public int customized;

    /* 0=站内路由同步, 1=管理员手工新增/外链 */
    public int isExternal;

    public long createdAt;
    public long updatedAt;

    public void ToRow(StrMap row) {
        row.Set("id", Convert.ToString(this.id));
        row.Set("parentId", Convert.ToString(this.parentId));
        row.Set("actionKey", this.actionKey);
        row.Set("title", this.title);
        row.Set("path", this.path);
        row.Set("groupName", this.groupName);
        row.Set("groupOrder", Convert.ToString(this.groupOrder));
        row.Set("sortOrder", Convert.ToString(this.sortOrder));
        row.Set("icon", this.icon);
        row.Set("permAction", this.permAction);
        row.Set("hidden", Convert.ToString(this.hidden));
        row.Set("status", Convert.ToString(this.status));
        row.Set("customized", Convert.ToString(this.customized));
        row.Set("isExternal", Convert.ToString(this.isExternal));
    }
}
