using System;
using System.Data;
using System.Data.Orm;
using Zan.Web;

namespace Zan.Web.Model;

[Table(Name = "sys_department")]
public class SysDepartment : RowView {
    [Column(IsIdentity = true)]
    public int id;

    public int parentId;

    [Column(StringLength = 64, IsNullable = false)]
    public string name;

    [Column(StringLength = 64, IsNullable = false)]
    public string code;

    public int leaderUserId;
    public int sortOrder;
    public int status;
    public long createdAt;
    public long updatedAt;

    /* 视图行自述投影：部门行共用的键集；indent/members/active 由控制器补。 */
    public void ToRow(StrMap row) {
        row.Set("id", Convert.ToString(this.id));
        row.Set("name", this.name);
        row.Set("code", Fmt.Dash(this.code));
        row.Set("statusClass", Fmt.EnabledClass(this.status));
    }
}