using System;
using System.Data;
using System.Data.Orm;
using Zan.Web.Security;
using Zan.Web;

namespace Zan.Web.Model;

[Table(Name = "sys_role")]
public class SysRole : RowView {
    [Column(IsIdentity = true)]
    public int id;

    [Column(StringLength = 64, IsNullable = false)]
    public string name;

    [Column(StringLength = 64, IsNullable = false)]
    public string code;

    public int rank;
    public int status;

    /* 该角色可见的数据范围：1 全部 / 2 本部门 / 3 本部门及下级 / 4 仅本人 / 5 自定义部门（scopeDepts）。0 为升级前行，读作 1，加此列不会收窄既有角色。 */
    public int dataScope;

    /* dataScope=5 对应的部门，格式如 ",3,7,"，与 sys_user_role 集合缓存格式相同。用列而非关联表，按角色读为字符串，不按部门查询。 */
    [Column(StringLength = 255)]
    public string scopeDepts;

    public string description;
    public long createdAt;
    public long updatedAt;

    /* 视图行自述投影：角色列表共用的键集；perms/users 计数等跨表键由控制器补。 */
    public void ToRow(StrMap row) {
        row.Set("id", Convert.ToString(this.id));
        row.Set("name", this.name);
        row.Set("code", this.code);
        row.Set("rank", Convert.ToString(this.rank));
        row.Set("description", Fmt.Dash(this.description));
        row.Set("scope", DataScope.Label(this.dataScope));
        row.Set("statusText", Fmt.EnabledText(this.status));
        row.Set("statusClass", Fmt.EnabledClass(this.status));
    }
}