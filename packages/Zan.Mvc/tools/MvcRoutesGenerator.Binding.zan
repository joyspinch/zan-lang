using System;
using System.Collections.Generic;
using System.Json;

partial class MvcRoutesGenerator {
    static Dictionary<string, string> Options(JsonValue method) {
        Dictionary<string, string> result = new Dictionary<string, string>();
        JsonValue attrs = method.Get("attrs");
        for (int i = 0; i < attrs.Count(); i++) {
            JsonValue attr = attrs.At(i);
            if (AttrName(attr) != "Opt") { continue; }
            JsonValue args = attr.Get("args");
            for (int j = 0; j < args.Count(); j++) {
                JsonValue arg = args.At(j);
                if (Text(arg, "k") != "lit" || Text(arg, "t") != "str") { continue; }
                string value = Text(arg, "v");
                int equals = value.IndexOf("=");
                string name = equals < 0 ? value : value.Substring(0, equals);
                if (!result.ContainsKey(name)) { result[name] = equals < 0 ? "" : value.Substring(equals + 1); }
            }
        }
        return result;
    }

    static string InputSuffix(string type) {
        if (type == "int") { return "Int"; }
        if (type == "long") { return "Long"; }
        if (type == "double") { return "Double"; }
        if (type == "bool") { return "Bool"; }
        return "";
    }

    static bool IsScalar(string type) { return type == "string" || InputSuffix(type) != ""; }

    static string DefaultLiteral(string type, string value) {
        if (type == "bool") { return value == "true" ? "true" : "false"; }
        if (value == "") { return "0"; }
        if (type == "int") {
            int n = 0;
            if (int.TryParse(value, out n)) { return Convert.ToString(n); }
        } else if (type == "long") {
            long n = 0;
            if (long.TryParse(value, out n)) { return Convert.ToString(n) + "L"; }
        } else {
            double n = 0;
            if (double.TryParse(value, out n)) {
                string number = Convert.ToString(n);
                if (number != "NaN" && number != "Infinity" && number != "-Infinity") { return number; }
            }
        }
        throw new Exception("Invalid MVC " + type + " default " + value);
    }

    static void BindScalar(StringBuilder code, string type, string name, string local,
                           string receiver, bool optional, string defaultValue) {
        string key = Quote(name);
        string suffix = InputSuffix(type);
        string declaration = "        " + type + " " + local + " = ";
        if (!optional) {
            code.Append(declaration + "controller.Need" + suffix + "(" + key + ", " + key + ");\n");
        } else if (type == "string") {
            code.Append(declaration + receiver + ".In(" + key + ");\n");
            code.Append("        if (" + local + ".Length == 0) { " + local + " = " + Quote(defaultValue) + "; }\n");
        } else {
            code.Append(declaration + receiver + ".In" + suffix + "(" + key + ", "
                + DefaultLiteral(type, defaultValue) + ");\n");
        }
    }

    static void BindForm(StringBuilder code, JsonValue form, string local, List<RouteInput> inputs) {
        string type = TypeName(form);
        code.Append("        " + type + " " + local + " = new " + type + "();\n");
        JsonValue fields = form.Get("fields");
        for (int i = 0; i < fields.Count(); i++) {
            JsonValue field = fields.At(i);
            if (Flag(field, "static") || Flag(field, "private") || Flag(field, "protected")) { continue; }
            string name = Text(field, "name");
            string fieldType = Text(field, "type");
            if (!IsScalar(fieldType)) { continue; }
            string access = local + "." + name;
            string key = Quote(name);
            string suffix = InputSuffix(fieldType);
            string args = suffix == "" ? key : key + ", " + access;
            code.Append("        if (ctx.HasIn(" + key + ")) { " + access + " = ctx.In" + suffix + "(" + args + "); }\n");
            inputs.Add(new RouteInput(name, fieldType, "form", false));
        }
    }

    static void EmitRoute(StringBuilder reg, string varName, string verb, string pathExpr,
                          string handleExpr, string syncChain, string actionKeyExpr,
                          Dict<string, string> classAttrs, List<string> classKeys,
                          Dict<string, string> methodAttrs, List<string> methodKeys,
                          bool isIndex, bool showMenu, List<RouteInput> inputs,
                          List<RouteInput> pathParams, string ownerType, string methodName) {
        reg.Append("        Route " + varName + " = app.Map(" + Quote(verb) + ", " + pathExpr
            + ", " + handleExpr + ")" + syncChain + ";\n");
        reg.Append("        " + varName + ".Named(" + actionKeyExpr + ")");
        string title = Setting(methodAttrs, "Description", Setting(classAttrs, "Description"));
        if (title.Length > 0) { reg.Append(".Title(" + Quote(title) + ")"); }
        AppendMetadata(reg, classAttrs, classKeys, true, isIndex);
        AppendMetadata(reg, methodAttrs, methodKeys, false, isIndex);

        // Unknown and undeclared authorization keep the login gate.
        string auth = Setting(methodAttrs, "Authorization", Setting(classAttrs, "Authorization"));
        if (auth == "Grant" || auth == "ApiAuth") { reg.Append(".Auth()"); }
        else if (auth != "None" && auth != "Auth") { reg.Append(".Login()"); }

        // RBAC requires an explicit permission bit for each action.
        string perm = Setting(methodAttrs, "Perm");
        if (perm.Length > 0) {
            reg.Append(".Meta(\"Perm\", " + Quote(perm.Replace("System.Web.PermBit.", "").Replace("PermBit.", "")) + ")");
        }
        string classMenu = isIndex ? Setting(classAttrs, "IsMenu") : "";
        if (showMenu && Setting(methodAttrs, "IsMenu", classMenu) == "true") { reg.Append(".Menu()"); }
        if (Setting(methodAttrs, "Upload", Setting(classAttrs, "Upload")) == "true") { reg.Append(".Upload()"); }

        string limit = Setting(methodAttrs, "ApiMax", Setting(classAttrs, "ApiMax", "0"));
        int max = 0;
        if (!int.TryParse(limit, out max) || max < 0) {
            throw new Exception("Invalid ApiMax for " + ownerType + "." + methodName + ": " + limit);
        }
        if (max > 0) { reg.Append(".Limit(" + Convert.ToString(max) + ")"); }

        string lockScope = Setting(methodAttrs, "Lock", Setting(classAttrs, "Lock"));
        if (lockScope.Length > 0) {
            if (lockScope == "Unknown") {
                throw new Exception("Invalid Lock for " + ownerType + "." + methodName + ": " + lockScope);
            }
            reg.Append(".Lock(" + Quote(lockScope) + ")");
        }
        reg.Append(";\n");

        for (int i = 0; i < inputs.Count; i++) {
            RouteInput input = inputs[i];
            reg.Append("        " + varName + ".Param(" + Quote(input.Name) + ", " + Quote(input.Type) + ", "
                + (input.Required ? "true" : "false") + ", " + Quote(input.DefaultValue) + ", "
                + Quote(input.Description) + ", " + Quote(input.Source) + ");\n");
        }
        for (int i = 0; i < pathParams.Count; i++) {
            RouteInput p = pathParams[i];
            reg.Append("        " + varName + ".Param(" + Quote(p.Name) + ", " + Quote(p.Type) + ", true, \"\", \"\", \"path\");\n");
        }
    }

    static List<RouteInput> ExtractPathParams(string pathTemplate, List<RouteInput> inputs, bool includeTypedSig) {
        List<RouteInput> result = new List<RouteInput>();
        if (pathTemplate.Length == 0 || pathTemplate.IndexOf("{") < 0) { return result; }
        List<string> segs = pathTemplate.Split("/");
        for (int i = 0; i < segs.Count; i++) {
            string seg = segs[i];
            if (seg.Length <= 2 || seg[0] != '{' || seg[seg.Length - 1] != '}') { continue; }
            int colon = seg.IndexOf(":");
            string pName = colon > 1 ? seg.Substring(1, colon - 1) : seg.Substring(1, seg.Length - 2);
            if (pName.Length == 0) { continue; }
            string pType = colon < 0 ? "" : seg.Substring(colon + 1, seg.Length - colon - 2);
            if (pType.Length == 0 && includeTypedSig) {
                for (int j = 0; j < inputs.Count; j++) {
                    if (inputs[j].Name == pName) { pType = inputs[j].Type; break; }
                }
            }
            result.Add(new RouteInput(pName, pType, "path", true));
        }
        return result;
    }

    static void EmitAction(StringBuilder code, StringBuilder reg, JsonValue types,
                           JsonValue owner, JsonValue method, int id, int lifecycleKind,
                           string basePath, bool baseIsRuntime, string ctrlVar,
                           Dict<string, string> classAttrs, List<string> classKeys) {
        string name = Text(method, "name");
        string type = TypeName(owner);
        string keyExpr = "typeof(" + type + ").FullName + " + Quote("." + name);
        string wrapper = "Action" + Convert.ToString(id);
        string handler = "Handle" + Convert.ToString(id);
        string syncHandler = "Sync" + Convert.ToString(id);
        bool isStatic = Flag(method, "static");
        bool isAsync = Flag(method, "async");
        bool transaction = HasAttr(owner, "Tx") || HasAttr(method, "Tx");
        bool readOnly = HasAttr(owner, "ReadOnly") || HasAttr(method, "ReadOnly");
        string view = type.StartsWith("Zan.Web.") ? type.Substring(8) : type;
        List<RouteInput> inputs = new List<RouteInput>();
        JsonValue parameters = method.Get("params");
        Dictionary<string, string> optional = Options(method);
        StringBuilder body = new StringBuilder();
        string args = "";
        bool needsController = false;
        for (int i = 0; i < parameters.Count(); i++) {
            JsonValue param = parameters.At(i);
            string paramType = Text(param, "type");
            string paramName = Text(param, "name");
            string local = "value" + Convert.ToString(i);
            bool opt = optional.ContainsKey(paramName);
            string dflt = opt ? optional[paramName] : "";
            string error = "Unsupported MVC parameter " + type + "." + name + "(" + paramType + " " + paramName + ")";
            if (param.Get("by_ref") != null) { throw new Exception(error); }
            if (IsScalar(paramType)) {
                needsController = needsController || !opt;
                BindScalar(body, paramType, paramName, local, isStatic ? "ctx" : "controller", opt, dflt);
                inputs.Add(new RouteInput(paramName, paramType, "query", !opt, dflt));
            } else if (paramType == "HttpContext" || paramType == "System.Web.HttpContext") {
                local = "ctx";
            } else {
                JsonValue form = FindType(types, paramType, Text(owner, "ns"));
                if (form == null || Text(form, "kind") != "class" || Flag(form, "abstract") || Flag(form, "generic")) {
                    throw new Exception(error);
                }
                BindForm(body, form, local, inputs);
            }
            args = args + (i == 0 ? "" : ", ") + local;
        }

        string signature = isStatic ? "HttpContext ctx" : "Controller baseController, HttpContext ctx";
        code.Append("    static " + (isAsync ? "async " : "") + "void " + wrapper + "(" + signature + ") {\n");
        if (!isStatic) {
            code.Append("        " + type + " controller = (" + type + ")baseController;\n");
        } else if (needsController) {
            code.Append("        Controller controller = new Controller();\n        controller.Bind(ctx);\n");
        }
        code.Append(body.ToString());
        code.Append("        " + (isAsync ? "await " : "") + (isStatic ? type : "controller") + "." + name + "(" + args + ");\n    }\n");

        string handleRef = wrapper;
        string syncChain = "";
        if (isStatic) {
            if (!isAsync) {
                code.Append("    static async void " + handler + "(HttpContext ctx) { " + wrapper + "(ctx); }\n");
                handleRef = handler;
                if (!transaction) { syncChain = ".SyncAction(" + wrapper + ")"; }
            }
        } else if (isAsync) {
            code.Append("    static async void " + handler + "(HttpContext ctx) {\n"
                + "        await __AttrRoutes.RunAction(new " + type + "(), ctx, " + Quote(view + "." + name)
                + ", " + (readOnly ? "true" : "false") + ", " + (transaction ? "true" : "false") + ", " + wrapper
                + ", " + (lifecycleKind != 0 ? "true" : "false") + ");\n    }\n");
            handleRef = handler;
        } else {
            code.Append("    static async void " + handler + "(HttpContext ctx) {\n"
                + "        await __AttrRoutes.RunSyncActionAsync(new " + type + "(), ctx, " + Quote(view + "." + name)
                + ", " + (readOnly ? "true" : "false") + ", " + (transaction ? "true" : "false") + ", " + wrapper
                + ", " + (lifecycleKind != 0 ? "true" : "false") + ");\n    }\n");
            handleRef = handler;
            if (!transaction && lifecycleKind != 0) {
                code.Append("    static bool " + syncHandler + "(HttpContext ctx) {\n"
                    + "        return __AttrRoutes.TryRunSyncAction(new " + type + "(), ctx, "
                    + Quote(view + "." + name) + ", " + (readOnly ? "true" : "false") + ", "
                    + (lifecycleKind == 1 ? "true" : "false") + ", " + wrapper + ");\n    }\n");
                syncChain = ".Sync(" + syncHandler + ")";
            }
        }

        AddBodyInputs(owner, method, inputs);
        List<string> methodKeys;
        Dict<string, string> methodAttrs = ReadAttrs(method, out methodKeys);
        bool isIndex = name == "Index";
        string methodRoute = AttrVal(methodAttrs, "Route");
        string verb = ExtractVerb(methodAttrs);
        string routeVar = "r" + Convert.ToString(id);

        bool pathIsExpr = false;
        string pathExpr = "";
        string staticTemplate = "";
        if (methodRoute.Length > 0) {
            if (methodRoute.StartsWith("/")) {
                pathExpr = Quote(methodRoute);
                staticTemplate = methodRoute;
            } else if (baseIsRuntime) {
                pathIsExpr = true;
                pathExpr = "(" + ctrlVar + " == \"/\" ? \"/\" + " + Quote(methodRoute) + " : " + ctrlVar + " + \"/\" + " + Quote(methodRoute) + ")";
                staticTemplate = methodRoute;
            } else {
                staticTemplate = basePath == "/" ? "/" + methodRoute : basePath + "/" + methodRoute;
                pathExpr = Quote(staticTemplate);
            }
        } else if (isIndex) {
            if (baseIsRuntime) {
                pathIsExpr = true;
                pathExpr = ctrlVar;
            } else {
                staticTemplate = basePath;
                pathExpr = Quote(basePath);
            }
        } else {
            string mlower = name.ToLower();
            if (baseIsRuntime) {
                pathIsExpr = true;
                pathExpr = "(" + ctrlVar + " == \"/\" ? " + Quote("/" + mlower) + " : " + ctrlVar + " + " + Quote("/" + mlower) + ")";
            } else {
                staticTemplate = basePath == "/" ? "/" + mlower : basePath + "/" + mlower;
                pathExpr = Quote(staticTemplate);
            }
        }

        List<RouteInput> primaryPathParams = ExtractPathParams(staticTemplate, inputs, false);
        EmitRoute(reg, routeVar, verb, pathExpr, handleRef, syncChain, keyExpr,
                  classAttrs, classKeys, methodAttrs, methodKeys, isIndex, true,
                  inputs, primaryPathParams, type, name);

        if (isIndex && methodRoute.Length == 0) {
            List<RouteInput> aliasPathParams = ExtractPathParams(staticTemplate, inputs, true);
            if (pathIsExpr) {
                reg.Append("        if (!" + pathExpr + ".EndsWith(\"/index\") && " + pathExpr + " != \"/\") {\n");
                EmitRoute(reg, routeVar + "a", verb, pathExpr + " + \"/index\"", handleRef, syncChain, keyExpr,
                          classAttrs, classKeys, methodAttrs, methodKeys, true, false,
                          inputs, aliasPathParams, type, name);
                reg.Append("        " + routeVar + "a.SharePolicyKey(" + routeVar + ");\n");
                reg.Append("        }\n");
            } else if (!staticTemplate.EndsWith("/index") && staticTemplate != "/") {
                EmitRoute(reg, routeVar + "a", verb, Quote(staticTemplate + "/index"), handleRef, syncChain, keyExpr,
                          classAttrs, classKeys, methodAttrs, methodKeys, true, false,
                          inputs, aliasPathParams, type, name);
                reg.Append("        " + routeVar + "a.SharePolicyKey(" + routeVar + ");\n");
            }
        }
    }

    static int EmitCrudActions(StringBuilder code, StringBuilder reg, JsonValue owner,
                               int id, int lifecycleKind, string basePath, bool baseIsRuntime,
                               string ctrlVar, Dict<string, string> classAttrs, List<string> classKeys,
                               HashSet<string> seen) {
        string[] names = new string[] {
            "Index", "Conf", "ListData", "Edit", "FormConf",
            "Form", "Save", "Delete", "Batch", "Field", "Options"
        };
        string[] doMethods = new string[] {
            "DoList", "DoConfAsync", "DoListData", "DoEdit", "DoFormConfAsync",
            "DoForm", "DoSave", "DoDelete", "DoBatch", "DoField", "DoOptions"
        };
        string[] verbs = new string[] {
            "GET", "PUT", "POST", "POST", "PUT",
            "GET", "POST", "POST", "POST", "POST", "GET"
        };
        string[] routes = new string[] {
            "", "conf", "list", "edit", "formconf",
            "form", "save", "delete", "batch", "field", "options"
        };
        string[] perms = new string[] {
            "PermBit.View", "PermBit.View", "PermBit.View", "PermBit.View", "PermBit.View",
            "PermBit.Create|PermBit.Update", "PermBit.Create|PermBit.Update", "PermBit.Delete",
            "PermBit.Update|PermBit.Delete", "PermBit.Update", "PermBit.View"
        };
        string[] descs = new string[] {
            "", "表格配置", "数据", "行数据", "表单配置",
            "表单", "保存", "删除", "批量操作", "行内修改", "选项"
        };
        for (int i = 0; i < names.Length; i++) {
            if (seen.Contains(names[i])) { continue; }
            seen.Add(names[i]);
            EmitCrudAction(code, reg, owner, id, lifecycleKind, basePath, baseIsRuntime, ctrlVar,
                           classAttrs, classKeys, names[i], doMethods[i], verbs[i], routes[i],
                           perms[i], descs[i]);
            id++;
        }
        return id;
    }

    static void EmitCrudAction(StringBuilder code, StringBuilder reg, JsonValue owner,
                               int id, int lifecycleKind, string basePath, bool baseIsRuntime,
                               string ctrlVar, Dict<string, string> classAttrs, List<string> classKeys,
                               string name, string doMethod, string verb, string methodRoute,
                               string perm, string descSuffix) {
        string type = TypeName(owner);
        string keyExpr = "typeof(" + type + ").FullName + " + Quote("." + name);
        string wrapper = "Action" + Convert.ToString(id);
        string handler = "Handle" + Convert.ToString(id);
        bool transaction = HasAttr(owner, "Tx");
        string view = type.StartsWith("Zan.Web.") ? type.Substring(8) : type;

        code.Append("    static async void " + wrapper + "(Controller baseController, HttpContext ctx) {\n");
        code.Append("        " + type + " controller = (" + type + ")baseController;\n");
        code.Append("        await controller." + doMethod + "();\n    }\n");
        code.Append("    static async void " + handler + "(HttpContext ctx) {\n"
            + "        await __AttrRoutes.RunAction(new " + type + "(), ctx, " + Quote(view + "." + name)
            + ", false, " + (transaction ? "true" : "false") + ", " + wrapper
            + ", " + (lifecycleKind != 0 ? "true" : "false") + ");\n    }\n");

        List<RouteInput> inputs = new List<RouteInput>();
        AddCrudMethodInputs(owner, doMethod, inputs);
        List<RouteInput> pathParams = new List<RouteInput>();
        Dict<string, string> methodAttrs = new Dict<string, string>();
        List<string> methodKeys = new List<string>();
        methodAttrs.Add("Perm", perm);
        methodKeys.Add("Perm");
        string classTitle = Setting(classAttrs, "Description");
        if (descSuffix.Length > 0) {
            string title = classTitle.Length > 0 ? classTitle + descSuffix : descSuffix;
            methodAttrs.Add("Description", title);
            methodKeys.Add("Description");
        }

        bool isIndex = name == "Index";
        string routeVar = "r" + Convert.ToString(id);
        bool pathIsExpr = false;
        string pathExpr = "";
        string staticTemplate = "";
        if (methodRoute.Length > 0) {
            if (baseIsRuntime) {
                pathIsExpr = true;
                pathExpr = "(" + ctrlVar + " == \"/\" ? \"/\" + " + Quote(methodRoute) + " : " + ctrlVar + " + \"/\" + " + Quote(methodRoute) + ")";
                staticTemplate = methodRoute;
            } else {
                staticTemplate = basePath == "/" ? "/" + methodRoute : basePath + "/" + methodRoute;
                pathExpr = Quote(staticTemplate);
            }
        } else {
            if (baseIsRuntime) {
                pathIsExpr = true;
                pathExpr = ctrlVar;
            } else {
                staticTemplate = basePath;
                pathExpr = Quote(basePath);
            }
        }

        EmitRoute(reg, routeVar, verb, pathExpr, handler, "", keyExpr,
                  classAttrs, classKeys, methodAttrs, methodKeys, isIndex, true,
                  inputs, pathParams, type, name);

        if (isIndex && methodRoute.Length == 0) {
            if (pathIsExpr) {
                reg.Append("        if (!" + pathExpr + ".EndsWith(\"/index\") && " + pathExpr + " != \"/\") {\n");
                EmitRoute(reg, routeVar + "a", verb, pathExpr + " + \"/index\"", handler, "", keyExpr,
                          classAttrs, classKeys, methodAttrs, methodKeys, true, false,
                          inputs, pathParams, type, name);
                reg.Append("        " + routeVar + "a.SharePolicyKey(" + routeVar + ");\n");
                reg.Append("        }\n");
            } else if (!staticTemplate.EndsWith("/index") && staticTemplate != "/") {
                EmitRoute(reg, routeVar + "a", verb, Quote(staticTemplate + "/index"), handler, "", keyExpr,
                          classAttrs, classKeys, methodAttrs, methodKeys, true, false,
                          inputs, pathParams, type, name);
                reg.Append("        " + routeVar + "a.SharePolicyKey(" + routeVar + ");\n");
            }
        }
    }
}
