using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

namespace Gui.Component;

class DockLayoutGeometry {
    public int LeftW;
    public int RightW;
    public int BottomH;
    public int MidX;
    public int MidW;
    public int CenterH;
    public int Splitter;
    public bool HasL;
    public bool HasR;
    public bool HasB;
}

public partial class DockHost {
    // Preview and PrepareHost resolve the same area. Only PrepareHost commits sizes;
    // a tiny/minimized window must not overwrite the user's saved extents.
    private DockLayoutGeometry ResolveDockGeometry(App app, Rect a, bool commit) {
        return this.ResolveDockGeometry(app, a, commit, -1, 0, 0);
    }

    private DockLayoutGeometry ResolveDockGeometry(App app, Rect a, bool commit,
    int resizeSide, int resizeExtent, int otherExtent) {
        DockLayoutGeometry g = new DockLayoutGeometry();
        g.Splitter = app.Scale(5);
        g.HasL = this.SideHasVisible(DockSide.Left());
        g.HasR = this.SideHasVisible(DockSide.Right());
        g.HasB = this.SideHasVisible(DockSide.Bottom());
        int scale = app.dpiScale;
        if (scale <= 0) { scale = 100; }
        int left = leftW;
        int right = rightW;
        int bottom = bottomH;
        if (logicalLayoutPending) {
            left = left * scale / 100;
            right = right * scale / 100;
            bottom = bottom * scale / 100;
        }
        if (!sized) {
            left = app.Scale(240);
            right = app.Scale(280);
            bottom = app.Scale(170);
        }
        if (!g.HasL) { left = 0; }
        if (!g.HasR) { right = 0; }
        if (!g.HasB) { bottom = 0; }
        int hl = g.HasL ? g.Splitter : 0;
        int hr = g.HasR ? g.Splitter : 0;
        int hb = g.HasB ? g.Splitter : 0;
        bool lClamped = false;
        bool rClamped = false;
        bool bClamped = false;
        int minSide = app.Scale(140);
        int centerMinW = Math.Max(app.Scale(240), a.width * centerWidthPercent / 100);
        int budget = a.width - hl - hr - centerMinW;
        if (budget < 0) { budget = 0; }
        int sideCount = (g.HasL ? 1 : 0) + (g.HasR ? 1 : 0);
        // Below the combined minimum, keep already compressed drag extents legal.
        // Otherwise restoring a window would reapply the minimum to one side first.
        bool fitsMinimum = budget >= minSide * sideCount;
        if (g.HasL && (left <= 0 || (fitsMinimum && left < minSide))) {
            left = minSide; lClamped = true;
        }
        if (g.HasR && (right <= 0 || (fitsMinimum && right < minSide))) {
            right = minSide; rClamped = true;
        }
        if (resizeSide == DockSide.Left() || resizeSide == DockSide.Right()) {
            int floor = fitsMinimum ? minSide : 0;
            int otherFloor = sideCount > 1 ? floor : 0;
            int extent = Math.Max(floor, Math.Min(budget - otherFloor, resizeExtent));
            int other = Math.Min(otherExtent, budget - extent);
            if (resizeSide == DockSide.Left()) { left = extent; right = other; }
            else { right = extent; left = other; }
        } else if ((long)left + right > budget) {
            // Both sides yield the same fraction of their requested width. Assign
            // the rounding remainder once so the center reserve cannot lose a pixel.
            long requested = (long)left + right;
            left = (int)((long)budget * left / requested);
            if (fitsMinimum && sideCount == 2) {
                left = Math.Max(minSide, Math.Min(budget - minSide, left));
            }
            right = budget - left;
            lClamped = g.HasL;
            rClamped = g.HasR;
        }
        if (g.HasB) {
            int centerMinH = Math.Max(app.Scale(120), a.height * centerHeightPercent / 100);
            int maxB = a.height - hb - centerMinH;
            if (bottom > maxB) { bottom = maxB; bClamped = true; }
            int minBottom = app.Scale(72);
            if (bottom < minBottom && minBottom <= maxB) { bottom = minBottom; bClamped = true; }
            if (bottom < 0) { bottom = 0; bClamped = true; }
        }
        if (commit) {
            dpiScale = scale;
            if (logicalLayoutPending) {
                leftW = leftW * scale / 100;
                rightW = rightW * scale / 100;
                bottomH = bottomH * scale / 100;
                for (int i = 0; i < groups.Count; i = i + 1) {
                    groups[i].extent = groups[i].extent * scale / 100;
                }
                logicalLayoutPending = false;
            }
            if (!sized) {
                leftW = app.Scale(240);
                rightW = app.Scale(280);
                bottomH = app.Scale(170);
                sized = true;
            }
            if (g.HasL && !lClamped) { leftW = left; }
            if (g.HasR && !rClamped) { rightW = right; }
            if (g.HasB && !bClamped) { bottomH = bottom; }
        }
        g.LeftW = left;
        g.RightW = right;
        g.BottomH = bottom;
        g.MidX = a.x + left + hl;
        g.MidW = a.width - left - hl - right - hr;
        if (g.MidW < 0) { g.MidW = 0; }
        g.CenterH = a.height - bottom - hb;
        if (g.CenterH < 0) { g.CenterH = 0; }
        return g;
    }

    private Rect ResolveSideBounds(DockLayoutGeometry g, Rect a, int side) {
        if (side == DockSide.Left()) { return new Rect(a.x, a.y, g.LeftW, a.height); }
        if (side == DockSide.Right()) { return new Rect(a.Right() - g.RightW, a.y, g.RightW, a.height); }
        if (side == DockSide.Bottom()) { return new Rect(g.MidX, a.Bottom() - g.BottomH, g.MidW, g.BottomH); }
        return new Rect(g.MidX, a.y, g.MidW, g.CenterH);
    }

    private void PrepareDockLayout(App app, Rect a) {
        area = a;
        DockLayoutGeometry geometry = this.ResolveDockGeometry(app, a, true);
        headerH = app.theme.heightMedium;
        int hs = geometry.Splitter;

        for (int i = 0; i < panels.Count; i = i + 1) {
            if (panels[i].body == null) {
                panels[i].body = new Rect(0, 0, 0, 0);
            } else {
                panels[i].body.Set(0, 0, 0, 0);
            }
        }

        bool hasL = geometry.HasL;
        bool hasR = geometry.HasR;
        bool hasB = geometry.HasB;
        int lw = geometry.LeftW;
        int rw = geometry.RightW;
        int bh = geometry.BottomH;
        int midX = geometry.MidX;
        int midW = geometry.MidW;

        if (hasL) { this.Splitter("left", 4, 0, 0, a.x + lw, a.y, hs, a.height, true); }
        if (hasR) { this.Splitter("right", 5, 0, 0, a.Right() - rw - hs, a.y, hs, a.height, true); }
        int centerH = geometry.CenterH;
        if (hasB) { this.Splitter("bottom", 6, 0, 0, midX, a.y + centerH, midW, hs, false); }

        // ---- 各侧组布局 ----
        if (hasL) {
            this.PrepareSide(app, this.VisibleGroups(DockSide.Left()),
            this.ResolveSideBounds(geometry, a, DockSide.Left()), true, hs);
        }
        if (hasR) {
            this.PrepareSide(app, this.VisibleGroups(DockSide.Right()),
            this.ResolveSideBounds(geometry, a, DockSide.Right()), true, hs);
        }
        this.PrepareSide(app, this.VisibleGroups(DockSide.Center()),
        this.ResolveSideBounds(geometry, a, DockSide.Center()), false, hs);
        if (hasB) {
            this.PrepareSide(app, this.VisibleGroups(DockSide.Bottom()),
            this.ResolveSideBounds(geometry, a, DockSide.Bottom()), false, hs);
        }
    }

    // Current content geometry before Arrange/PrepareHost.
    // The returned rectangle is an independent snapshot; no layout or input is committed.
    public Rect PreviewContent(App app, Rect a, string id) {
        DockPanel panel = this.Find(id);
        if (app == null || a == null || panel == null || panel.hidden) {
            return new Rect(0 - 30000, 0 - 30000, 1, 1);
        }
        int groupIndex = this.GroupOf(id);
        if (groupIndex < 0) { return new Rect(0 - 30000, 0 - 30000, 1, 1); }
        DockGroup target = groups[groupIndex];
        List<DockGroup> visible = this.VisibleGroups(target.side);
        int targetIndex = -1;
        for (int i = 0; i < visible.Count; i = i + 1) {
            if (visible[i] == target) { targetIndex = i; break; }
        }
        if (targetIndex < 0) { return new Rect(0 - 30000, 0 - 30000, 1, 1); }

        DockLayoutGeometry geometry = this.ResolveDockGeometry(app, a, false);
        Rect side = this.ResolveSideBounds(geometry, a, target.side);
        bool vertical = target.side == DockSide.Left() || target.side == DockSide.Right();
        int minG = 0;
        bool tiny = false;
        List<int> extents = this.ResolveGroupExtents(app, visible, side, vertical,
        geometry.Splitter, out minG, out tiny);
        int pos = vertical ? side.y : side.x;
        for (int i = 0; i < targetIndex; i = i + 1) {
            pos = pos + extents[i] + geometry.Splitter;
        }
        Rect groupBounds = this.ResolveGroupBounds(side, vertical, pos,
        extents[targetIndex], targetIndex == visible.Count - 1);
        List<string> vis = this.ResolveVisiblePanels(target);
        DockPanel active = this.ResolveActivePanel(target, vis, false);
        if (active == null || active.id != id) { return new Rect(0 - 30000, 0 - 30000, 1, 1); }
        Rect body = this.ResolveContentBounds(active, vis.Count, groupBounds, app.theme.heightMedium);
        if (body.width <= 0 || body.height <= 0) { return new Rect(0 - 30000, 0 - 30000, 1, 1); }
        return body;
    }

    private List<string> ResolveVisiblePanels(DockGroup g) {
        List<string> vis = new List<string>();
        for (int i = 0; i < g.ids.Count; i = i + 1) {
            DockPanel p = this.Find(g.ids[i]);
            if (p != null && !p.hidden) { vis.Add(p.id); }
        }
        return vis;
    }

    private DockPanel ResolveActivePanel(DockGroup g, List<string> vis, bool commit) {
        if (vis.Count == 0) { return null; }
        int at = g.active;
        if (at >= g.ids.Count) { at = g.ids.Count - 1; }
        if (at < 0) { at = 0; }
        DockPanel active = this.Find(g.ids[at]);
        if (active == null || active.hidden) {
            active = this.Find(vis[0]);
            at = this.IndexIn(g, vis[0]);
        }
        if (commit) { g.active = at; }
        return active;
    }

    private Rect ResolveContentBounds(DockPanel active, int count, Rect bounds, int headerHeight) {
        int hh = (!active.headerless || count > 1) ? headerHeight : 0;
        if (hh > bounds.height) { hh = bounds.height; }
        return new Rect(bounds.x, bounds.y + hh, bounds.width, bounds.height - hh);
    }

    // Resolve copies of the extents: preparation must not materialize weights,
    // consume a pending logical layout, or persist a temporary tiny layout.
    private List<int> ResolveGroupExtents(App app, List<DockGroup> gs, Rect r,
    bool vertical, int hs, out int minG, out bool tiny) {
        int n = gs.Count;
        int total = vertical ? r.height : r.width;
        total = total - hs * (n - 1);
        if (total < n) { total = n; }
        minG = app.Scale(56);
        tiny = minG * n > total;
        if (tiny) { minG = total / n; }
        List<int> extents = new List<int>();
        int scale = app.dpiScale;
        if (scale <= 0) { scale = 100; }
        int sum = 0;
        int wsum = 0;
        int unset = 0;
        for (int i = 0; i < n; i = i + 1) {
            int extent = gs[i].extent;
            if (logicalLayoutPending) { extent = extent * scale / 100; }
            extents.Add(extent);
            if (extent <= 0) { unset = unset + 1; wsum = wsum + gs[i].weight; }
            else { sum = sum + extent; }
        }
        if (unset > 0 && !tiny) {
            int rest = total - sum;
            if (rest < unset * minG) { rest = unset * minG; }
            if (wsum <= 0) { wsum = unset; }
            for (int i = 0; i < n; i = i + 1) {
                if (extents[i] <= 0) {
                    int extent = rest * gs[i].weight / wsum;
                    if (extent < minG) { extent = minG; }
                    extents[i] = extent;
                    sum = sum + extent;
                }
            }
        }
        if (sum != total && sum > 0 && !tiny) {
            int acc = 0;
            for (int i = 0; i < n - 1; i = i + 1) {
                int extent = extents[i] * total / sum;
                if (extent < minG) { extent = minG; }
                extents[i] = extent;
                acc = acc + extent;
            }
            int last = total - acc;
            if (last < minG) { last = minG; }
            extents[n - 1] = last;
        }
        return extents;
    }

    private Rect ResolveGroupBounds(Rect r, bool vertical, int pos, int extent, bool last) {
        if (last) {
            int end = vertical ? r.Bottom() : r.Right();
            extent = end - pos;
            if (extent < 1) { extent = 1; }
        }
        if (vertical) { return new Rect(r.x, pos, r.width, extent); }
        return new Rect(pos, r.y, extent, r.height);
    }

    private void PrepareSide(App app, List<DockGroup> gs, Rect r, bool vertical, int hs) {
        int n = gs.Count;
        if (n == 0) { return; }
        int minG = 0; bool tiny = false;
        List<int> extents = this.ResolveGroupExtents(app, gs, r, vertical, hs, out minG, out tiny);
        int pos = vertical ? r.y : r.x;
        for (int i = 0; i < n; i = i + 1) {
            DockGroup g = gs[i];
            Rect bounds = this.ResolveGroupBounds(r, vertical, pos, extents[i], i == n - 1);
            int extent = vertical ? bounds.height : bounds.width;
            if (!tiny) { g.extent = extent; }
            g.bounds = bounds;
            this.PrepareGroup(app, g);
            pos = pos + extent;
            if (i < n - 1) {
                string key = "split:" + Convert.ToString(g.key) + ":" + Convert.ToString(gs[i + 1].key);
                this.Splitter(key, 7, g.key, gs[i + 1].key,
                vertical ? r.x : pos, vertical ? pos : r.y,
                vertical ? r.width : hs, vertical ? hs : r.height, !vertical);
                pos = pos + hs;
            }
        }
    }

    private DockInputPart TabPart(DockGroup group, DockPanel panel, string key, int action,
    int x, int y, int w, int h) {
        int left = Math.Max(x, group.bounds.x);
        int right = Math.Min(x + w, group.bounds.Right());
        DockInputPart part = this.Part(key, action, left, y, Math.Max(0, right - left), h);
        part.panelId = panel.id; part.groupKey = group.key;
        return part;
    }

    private void PrepareGroup(App app, DockGroup g) {
        List<string> visible = this.ResolveVisiblePanels(g);
        DockPanel active = this.ResolveActivePanel(g, visible, true);
        if (active == null) { return; }
        Rect bounds = g.bounds;
        g.body = this.ResolveContentBounds(active, visible.Count, bounds, headerH);
        int height = g.body.y - bounds.y;
        g.header = new Rect(bounds.x, bounds.y, bounds.width, height);
        active.body = g.body;
        if (height <= 0) { return; }
        this.TabPart(g, active, "header:" + Convert.ToString(g.key), 1,
        bounds.x, bounds.y, bounds.width, height);
        int font = Style.FontFallback(app, "small");
        int padding = app.theme.paddingMedium; int gap = app.theme.gapSmall;
        int x = bounds.x;
        for (int i = 0; i < visible.Count; i = i + 1) {
            DockPanel panel = this.Find(visible[i]);
            int labelWidth = Canvas.MeasureText(panel.title, font);
            int width = padding * 2 + labelWidth + (panel.closable ? gap + font : 0);
            this.TabPart(g, panel, "tab:" + panel.id, 2, x, bounds.y, width, height);
            if (panel.closable) {
                int closeX = x + padding + labelWidth + gap;
                int closeY = bounds.y + (height - font) / 2;
                int hitW = font + 4; int hitH = font + 4;
                int hitX = closeX - 2; int hitY = closeY - 2;
                if (app.TouchDevice()) {
                    hitW = font + app.Scale(24); hitH = height;
                    hitX = closeX + font / 2 - hitW / 2; hitY = bounds.y;
                }
                this.TabPart(g, panel, "close:" + panel.id, 3, hitX, hitY, hitW, hitH);
            }
            x = x + width;
        }
    }

    private DockInputPart FindPart(string key) {
        for (int i = 0; i < inputParts.Count; i = i + 1) {
            if (inputParts[i].key == key && inputParts[i].used) { return inputParts[i]; }
        }
        return null;
    }

    private void PaintGroup(App app, DockGroup g) {
        Rect bounds = g.bounds;
        List<string> visible = this.ResolveVisiblePanels(g);
        DockPanel active = this.ResolveActivePanel(g, visible, false);
        if (active == null) { return; }
        Control.BareBox(app, "dockgroup", Style.SNormal()).Paint(app,
        bounds.x, bounds.y, bounds.width, bounds.height);
        int height = g.header.height;
        if (height <= 0) { return; }
        Control.BareBox(app, "docktabs", Style.SNormal()).Paint(app,
        bounds.x, bounds.y, bounds.width, height);
        Canvas canvas = app.canvas; Theme theme = app.theme;
        int font = Style.FontFallback(app, "small");
        int padding = theme.paddingMedium; int gap = theme.gapSmall;
        int x = bounds.x;
        canvas.PushClip(bounds.x, bounds.y, bounds.width, height);
        for (int i = 0; i < visible.Count; i = i + 1) {
            DockPanel panel = this.Find(visible[i]);
            int labelWidth = Canvas.MeasureText(panel.title, font);
            int width = padding * 2 + labelWidth + (panel.closable ? gap + font : 0);
            DockInputPart tabPart = this.FindPart("tab:" + panel.id);
            DockInputPart closePart = this.FindPart("close:" + panel.id);
            bool closeHover = closePart != null && closePart.isHovered;
            int state = panel.id == active.id ? Style.SSelected() : Style.SNormal();
            if ((tabPart != null && tabPart.isHovered) || closeHover) { state = state + Style.SHover(); }
            StyleBox tab = Control.BareBox(app, "docktab", state);
            tab.Paint(app, x, bounds.y, width, height);
            StyleBox label = Style.Part(app, "docktab", "label", "", "", "", Style.SNormal());
            canvas.DrawText(x + padding, Canvas.CenterTextY(bounds.y, height, font),
            panel.title, tab.FgOr(label.FgOr(0)), font);
            if (panel.closable) {
                int closeX = x + padding + labelWidth + gap;
                int closeY = bounds.y + (height - font) / 2;
                StyleBox close = Style.Part(app, "docktab", "close", "", "", "",
                closeHover ? Style.SHover() : Style.SNormal());
                if (closeHover) { canvas.FillRoundRect(closeX - 2, closeY - 2, font + 4, font + 4,
                close.RadiusOr(theme.borderRadiusSmall), close.BgOr(0)); }
                canvas.DrawGlyphIn("close", closeX, closeY, font, font, font - 3, close.FgOr(0));
            }
            x = x + width;
        }
        canvas.PopClip();
    }

    // ---- 拖拽与放置 ----

    // 绘制路由拖拽已准备的放置目标和幽灵；在内容之后绘制，保持提示位于最上层。
    public void RenderOverlay(App app) {

        if (!dragging) { return; }
        Canvas c = app.canvas;
        Theme t = app.theme;

        if (dropKind != 0) {
            StyleBox drop = Style.Part(app, "dockgroup", "drop", "", "", "",
            Style.SNormal());
            c.FillRect(dropRect.x, dropRect.y, dropRect.width, dropRect.height,
            drop.BgOr(0));
            c.DrawRoundRect(dropRect.x, dropRect.y, dropRect.width, dropRect.height,
            drop.RadiusOr(t.borderRadiusSmall), drop.BorderOr(0),
            drop.BorderWOr(2));
        }

        DockPanel p = this.Find(dragId);
        if (p != null) {
            int fontSize = Style.FontFallback(app, "small");
            int pad = t.paddingMedium;
            int gw = Canvas.MeasureText(p.title, fontSize) + pad * 2;
            int gh = headerH;
            int gx = app.mouseX + app.Scale(8);
            int gy = app.mouseY + app.Scale(8);
            StyleBox ghost = Style.Part(app, "dockgroup", "ghost", "", "", "",
            Style.SNormal());
            c.SurfaceRoundRect(gx, gy, gw, gh, ghost.RadiusOr(t.borderRadiusSmall),
            ghost.BgOr(0), ghost.BorderOr(0), ghost.BorderWOr(1));
            c.DrawTextCentered(gx, gy, gw, gh, p.title, ghost.FgOr(0), fontSize);
        }
    }

    // 选取指针下方的放置目标：组的标签条或其中部并入该组，
    // 组的边缘带在旁侧新建组，
    // 整个停靠区的外侧带停靠到相应侧边。
    public void ResolveDrop(App app) {
        dropKind = 0;
        dropGroup = -1;
        dropSide = -1;
        dropIndex = 0;
        int mx = app.mouseX;
        int my = app.mouseY;
        if (!area.Contains(mx, my)) { return; }

        for (int gi = 0; gi < groups.Count; gi = gi + 1) {
            DockGroup g = groups[gi];
            if (this.GroupHasVisible(g) && g.bounds.Contains(mx, my)) {
                if (g.header.height > 0 && g.header.Contains(mx, my)) {
                    dropKind = 1;
                    dropGroup = gi;
                    dropRect = g.bounds;
                    return;
                }
                int zone = DockHost.EdgeZone(g.bounds, mx, my);
                if (zone == 0) {
                    dropKind = 1;
                    dropGroup = gi;
                    dropRect = g.bounds;
                    return;
                }
                bool vertical = g.side == DockSide.Left() || g.side == DockSide.Right();
                bool along = false;
                if (vertical && (zone == 3 || zone == 4)) { along = true; }
                if (!vertical && (zone == 1 || zone == 2)) { along = true; }
                if (along) {
                    dropKind = 2;
                    dropSide = g.side;
                    dropIndex = this.SideIndexOf(g);
                    if (zone == 2 || zone == 4) { dropIndex = dropIndex + 1; }
                    dropRect = DockHost.HalfRect(g.bounds, zone);
                    return;
                }
                // 跨越组的排列方向：停靠到边缘所指的宿主侧，
                // 而不是以错误方向拆分该组。
                dropKind = 2;
                dropSide = DockHost.SideForZone(zone);
                dropIndex = this.SideCount(dropSide);
                if (dropSide == DockSide.Left() && zone == 1) { dropIndex = 0; }
                dropRect = this.SideStrip(app, dropSide);
                return;
            }
        }

        int zoneA = DockHost.EdgeZone(area, mx, my);
        if (zoneA == 0) { zoneA = 2; }
        dropKind = 2;
        dropSide = DockHost.SideForZone(zoneA);
        dropIndex = this.SideCount(dropSide);
        dropRect = this.SideStrip(app, dropSide);
    }

    // 0 = 中部，1 = 左带，2 = 右带，3 = 顶带，4 = 底带。
    public static int EdgeZone(Rect r, int mx, int my) {
        int bx = r.width / 4;
        int by = r.height / 4;
        if (bx < 8) { bx = 8; }
        if (by < 8) { by = 8; }
        int dl = mx - r.x;
        int dr = r.Right() - mx;
        int dt = my - r.y;
        int db = r.Bottom() - my;
        int best = 0;
        int bestD = 0;
        if (dl < bx) { best = 1; bestD = dl; }
        if (dr < bx && (best == 0 || dr < bestD)) { best = 2; bestD = dr; }
        if (dt < by && (best == 0 || dt < bestD)) { best = 3; bestD = dt; }
        if (db < by && (best == 0 || db < bestD)) { best = 4; bestD = db; }
        return best;
    }

    // `zone` 所指那一半的矩形（新建组的放置提示）。
    public static Rect HalfRect(Rect r, int zone) {
        if (zone == 1) { return new Rect(r.x, r.y, r.width / 2, r.height); }
        if (zone == 2) { return new Rect(r.x + r.width / 2, r.y, r.width / 2, r.height); }
        if (zone == 3) { return new Rect(r.x, r.y, r.width, r.height / 2); }
        return new Rect(r.x, r.y + r.height / 2, r.width, r.height / 2);
    }

    // 边缘带 → 宿主侧：1=左、2=右、4=下，其余（含顶带）归中央。
    public static int SideForZone(int zone) {
        if (zone == 1) { return DockSide.Left(); }
        if (zone == 2) { return DockSide.Right(); }
        if (zone == 4) { return DockSide.Bottom(); }
        return DockSide.Center();
    }

    // 某一侧将占据的条带，用作侧边停靠的放置提示。
    public Rect SideStrip(App app, int side) {
        int w = leftW;
        if (side == DockSide.Right()) { w = rightW; }
        if (w <= 0) { w = app.Scale(240); }
        if (side == DockSide.Center()) { return area; }
        if (side == DockSide.Left()) { return new Rect(area.x, area.y, w, area.height); }
        if (side == DockSide.Right()) { return new Rect(area.Right() - w, area.y, w, area.height); }
        int h = bottomH;
        if (h <= 0) { h = app.Scale(170); }
        return new Rect(area.x, area.Bottom() - h, area.width, h);
    }

    // `g` 在其所在侧各组中的位置。
    public int SideIndexOf(DockGroup g) {
        int n = 0;
        for (int i = 0; i < groups.Count; i = i + 1) {
            if (groups[i].key == g.key) { return n; }
            if (groups[i].side == g.side) { n = n + 1; }
        }
        return n;
    }

    // 该侧当前的分组数（新组排在末尾用）。
    public int SideCount(int side) {
        int n = 0;
        for (int i = 0; i < groups.Count; i = i + 1) {
            if (groups[i].side == side) { n = n + 1; }
        }
        return n;
    }

    // 新组成为 `side` 的第 `k` 组时的全局索引。
    public int InsertPos(int side, int k) {
        int n = 0;
        for (int i = 0; i < groups.Count; i = i + 1) {
            if (groups[i].side == side) {
                if (n == k) { return i; }
                n = n + 1;
            }
        }
        return groups.Count;
    }

    // 松开时执行放置：dropKind=1 把面板并入目标组（目标组若因
    // Detach 解散则中止）；dropKind=2 在 `dropSide` 第 `dropIndex`
    // 处新建组——但该侧原本只剩被拖面板自己那一个组时退化为
    // 重排序，不拆组。两种都会更新面板 home 并置 changed。
    public void ApplyDrop() {
        if (dropKind == 0) { return; }
        DockPanel p = this.Find(dragId);
        if (p == null) { return; }
        if (dropKind == 1) {
            if (dropGroup < 0 || dropGroup >= groups.Count) { return; }
            DockGroup target = groups[dropGroup];
            if (DockHost.ListHas(target.ids, dragId)) {
                target.active = this.IndexIn(target, dragId);
                return;
            }
            int tkey = target.key;
            this.Detach(dragId);
            // Detach 可能已解散了目标之前被清空的组。
            int ti = this.IndexOfKey(tkey);
            if (ti < 0) { return; }
            groups[ti].ids.Add(dragId);
            groups[ti].active = groups[ti].ids.Count - 1;
            p.home = groups[ti].side;
            changed = true;
            return;
        }

        int side = dropSide;
        int k = dropIndex;
        p.home = side;
        int fromGroup = this.GroupOf(dragId);
        if (fromGroup >= 0 && groups[fromGroup].side == side
        && groups[fromGroup].ids.Count == 1) {
            // 该侧已是唯一组：只需重新排序。
            DockGroup solo = groups[fromGroup];
            groups.RemoveAt(fromGroup);
            int pos = this.InsertPos(side, k);
            if (pos > groups.Count) { pos = groups.Count; }
            groups.Insert(pos, solo);
            changed = true;
            return;
        }
        this.Detach(dragId);
        DockGroup ng = new DockGroup(side, 100);
        ng.ids.Add(dragId);
        ng.active = 0;
        int at = this.InsertPos(side, k);
        if (at > groups.Count) { at = groups.Count; }
        groups.Insert(at, ng);
        changed = true;
    }

    // 按 key 找组（ApplyDrop 在 Detach 后重找目标组用）；无则 -1。
    public int IndexOfKey(int key) {
        for (int i = 0; i < groups.Count; i = i + 1) {
            if (groups[i].key == key) { return i; }
        }
        return -1;
    }

    // 标签正在拖拽时为 true——宿主可以抑制自己本帧的
    // 悬停/拖拽处理。
    public bool Dragging() { return dragging; }
}
