using System;
using Gui;
using Gui.Widget;

namespace Gui.Component;

// 尾部滚动、可选择的文本日志（控制台视图）：最新一行位于
// 底部，滚轮和可拖拽的滚动条可回溯历史，
// 指针可跨行选择文本。行颜色由
// 调用方提供，视图无需知道自己在记录什么。
public class LogView {
    // 每行高度（逻辑像素，绘制时按 DPI 缩放）。
    public static int RowHeight(App app) { return app.Scale(18); }
    // 视图四周留白（逻辑像素）。
    public static int Padding(App app) { return app.Scale(6); }

    // 高度为 `h` 的视图中能容纳的行数。
    public static int VisibleRows(App app, int h) {
        int rows = Math.Max(0, h - LogView.Padding(app) * 2) / LogView.RowHeight(app);
        if (rows < 1) { rows = 1; }
        return rows;
    }

    // 给定滚动位置下绘制的第一行的索引。
    public static int FirstRow(App app, int h, int count, int scroll) {
        int maxScroll = count - LogView.VisibleRows(app, h);
        if (maxScroll < 0) { maxScroll = 0; }
        if (scroll < 0) { scroll = 0; }
        if (scroll > maxScroll) { scroll = maxScroll; }
        return maxScroll - scroll;
    }

    // `mouseY` 下的行索引；日志为空时为 -1。
    public static int RowAt(App app, int y, int h, int count, int scroll, int mouseY) {
        if (count == 0) { return 0 - 1; }
        int rel = (mouseY - (y + LogView.Padding(app))) / LogView.RowHeight(app);
        if (rel < 0) { rel = 0; }
        int ri = LogView.FirstRow(app, h, count, scroll) + rel;
        if (ri < 0) { ri = 0; }
        if (ri >= count) { ri = count - 1; }
        return ri;
    }

    // `lines` 中最接近 `mouseX` 的字符边界。
    public static int ColAt(string line, int textX, int fontSize, int mouseX) {
        if (line == null || line.Length == 0) { return 0; }
        int i = 0;
        while (i < line.Length) {
            int next = Gui.Text.NextCharEnd(line, i);
            if (next <= i) { next = i + 1; }
            int wa = Canvas.MeasureText(Gui.Text.Left(line, i), fontSize);
            int wb = Canvas.MeasureText(Gui.Text.Left(line, next), fontSize);
            if (mouseX < textX + (wa + wb) / 2) { return i; }
            i = next;
        }
        return line.Length;
    }

    internal static void NormalizeSelection(LogState st, out int r0, out int c0, out int r1, out int c1) {
        r0 = st.selR0; c0 = st.selC0;
        r1 = st.selR1; c1 = st.selC1;
        if (r0 > r1 || (r0 == r1 && c0 > c1)) {
            int tr = r0; r0 = r1; r1 = tr;
            int tc = c0; c0 = c1; c1 = tc;
        }
    }

    internal static string SliceSelectedLine(string ln, int r, int r0, int c0, int r1, int c1) {
        if (ln == null) { ln = ""; }
        int s = r == r0 ? c0 : 0;
        int e = r == r1 ? c1 : ln.Length;
        if (s < 0) { s = 0; }
        if (e > ln.Length) { e = ln.Length; }
        s = Gui.Text.ClampCharStart(ln, s);
        e = Gui.Text.ClampCharStart(ln, e);
        if (s > e) { s = e; }
        string seg = ln.Substring(s, e - s);
        return r < r1 ? seg + "\n" : seg;
    }

    private static string SelectionTextCore(List<LogLine> items, List<string> lines, LogState st) {
        if (st == null || !st.HasSelection()) { return ""; }
        int count = items != null ? items.Count : (lines != null ? lines.Count : 0);
        if (count == 0) { return ""; }
        int r0; int c0; int r1; int c1;
        LogView.NormalizeSelection(st, out r0, out c0, out r1, out c1);
        StringBuilder sb = new StringBuilder();
        for (int r = r0; r <= r1 && r < count; r = r + 1) {
            if (r < 0) { continue; }
            string ln = items != null ? (items[r] != null ? items[r].text : "") : lines[r];
            sb.Append(LogView.SliceSelectedLine(ln, r, r0, c0, r1, c1));
        }
        return sb.ToString();
    }

    // 强类型实体版本：`lines` 中被选中的文本，以换行连接（无选中时为 ""）。
    public static string SelectionTextItems(List<LogLine> lines, LogState st) {
        return LogView.SelectionTextCore(lines, null, st);
    }

    // `lines` 中被选中的文本，以换行连接（无选中时为 ""）。
    public static string SelectionText(List<string> lines, LogState st) {
        return LogView.SelectionTextCore(null, lines, st);
    }

    private static void PaintCore(App app, int x, int y, int w, int h,
    List<LogLine> items, List<string> lines, List<int> colors,
    LogState st, string emptyText) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        if (w <= 0 || h <= 0) { return; }
        StyleBox normal = Style.PartRef(app, "logview", "text", "", "", "", Style.SNormal());
        StyleBox empty = Style.PartRef(app, "logview", "empty", "", "", "", Style.SNormal());

        int rowH = LogView.RowHeight(app);
        int pad = LogView.Padding(app);
        int font = Style.FontFallback(app, "small");
        int count = items != null ? items.Count : (lines != null ? lines.Count : 0);

        if (count == 0) {
            if (emptyText != null && emptyText != "") {
                c.DrawText(x + pad, y + pad, emptyText, empty.FgOr(0), empty.FontOr(font));
            }
            return;
        }

        int scroll = st != null ? st.scroll : 0;
        int r0 = st != null ? st.selR0 : 0 - 1;
        int c0 = st != null ? st.selC0 : 0;
        int r1 = st != null ? st.selR1 : 0 - 1;
        int c1 = st != null ? st.selC1 : 0;
        if (st != null && r0 >= 0) { LogView.NormalizeSelection(st, out r0, out c0, out r1, out c1); }

        EditorPalette pal = EditorPalette.For(t);
        int defaultFg = normal.FgOr(0);
        c.PushClip(x, y, w, h);
        int ri = LogView.FirstRow(app, h, count, scroll);
        int cy = y + pad;
        while (ri < count && cy + rowH <= y + h - pad) {
            string ln = items != null ? (items[ri] != null ? items[ri].text : "") : lines[ri];
            if (ln == null) { ln = ""; }
            if (r0 >= 0 && ri >= r0 && ri <= r1) {
                int hs = ri == r0 ? c0 : 0;
                int he = ri == r1 ? c1 : ln.Length;
                if (hs < 0) { hs = 0; }
                if (he > ln.Length) { he = ln.Length; }
                hs = Gui.Text.ClampCharStart(ln, hs);
                he = Gui.Text.ClampCharStart(ln, he);
                if (hs > he) { hs = he; }
                int hx0 = x + pad + Canvas.MeasureText(Gui.Text.Left(ln, hs), font);
                int hx1 = x + pad + Canvas.MeasureText(Gui.Text.Left(ln, he), font);
                if (ri < r1) { hx1 = hx1 + pad; }
                if (hx1 < hx0 + 2) { hx1 = hx0 + 2; }
                c.FillRect(hx0, cy, hx1 - hx0, rowH, pal.selection);
            }
            int col = defaultFg;
            if (items != null) {
                if (items[ri] != null && items[ri].color != 0) { col = items[ri].color; }
            } else if (colors != null && ri < colors.Count && colors[ri] != 0) {
                col = colors[ri];
            }
            c.DrawText(x + pad, cy, ln, col, font);
            cy = cy + rowH;
            ri = ri + 1;
        }
        c.PopClip();
    }

    // 强类型实体主版本：在 x,y,w,h 中绘制结构化日志行列表。
    public static void PaintItems(App app, int x, int y, int w, int h,
    List<LogLine> lines, LogState st,
    string emptyText) {
        LogView.PaintCore(app, x, y, w, h, lines, null, null, st, emptyText);
    }

    // 纯绘制文本行，输入、滚动与状态归 ConsoleView 的 retained 生命周期。
    // colors 可为空或与 lines 平行，0 使用主题默认色。
    // 零堆分配实现：直接基于传入的 lines/colors 串行切片渲染，
    // 杜绝每帧为整份日志全量构造 List<LogLine> 与实体节点。
    public static void Paint(App app, int x, int y, int w, int h,
    List<string> lines, List<int> colors, LogState st,
    string emptyText) {
        LogView.PaintCore(app, x, y, w, h, null, lines, colors, st, emptyText);
    }

}
