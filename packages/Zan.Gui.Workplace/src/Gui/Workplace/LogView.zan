using System;
using Gui;
using Gui.Widget;

namespace Gui.Component;

// 尾部滚动、可选择的文本日志（控制台视图）：最新一行位于
// 底部，滚轮和可拖拽的滚动条可回溯历史，
// 指针可跨行选择文本。行颜色由
// 调用方提供，视图无需知道自己在记录什么。
public class LogView {
    // 每行高度（逻辑像素，绘制时按 DPI 缩放）。
    public static int RowHeight(App app) { return app.Scale(18); }
    // 视图四周留白（逻辑像素）。
    public static int Padding(App app) { return app.Scale(6); }

    // 高度为 `h` 的视图中能容纳的行数。
    public static int VisibleRows(App app, int h) {
        int rows = Math.Max(0, h - LogView.Padding(app) * 2) / LogView.RowHeight(app);
        if (rows < 1) { rows = 1; }
        return rows;
    }

    // 给定滚动位置下绘制的第一行的索引。
    public static int FirstRow(App app, int h, int count, int scroll) {
        int maxScroll = count - LogView.VisibleRows(app, h);
        if (maxScroll < 0) { maxScroll = 0; }
        if (scroll < 0) { scroll = 0; }
        if (scroll > maxScroll) { scroll = maxScroll; }
        return maxScroll - scroll;
    }

    // `mouseY` 下的行索引；日志为空时为 -1。
    public static int RowAt(App app, int y, int h, int count, int scroll, int mouseY) {
        if (count == 0) { return 0 - 1; }
        int rel = (mouseY - (y + LogView.Padding(app))) / LogView.RowHeight(app);
        if (rel < 0) { rel = 0; }
        int ri = LogView.FirstRow(app, h, count, scroll) + rel;
        if (ri < 0) { ri = 0; }
        if (ri >= count) { ri = count - 1; }
        return ri;
    }

    // `lines` 中最接近 `mouseX` 的字符边界。
    public static int ColAt(string line, int textX, int fontSize, int mouseX) {
        for (int i = 0; i < line.Length; i = i + 1) {
            int wa = Canvas.MeasureText(Text.Left(line, i), fontSize);
            int wb = Canvas.MeasureText(Text.Left(line, i + 1), fontSize);
            if (mouseX < textX + (wa + wb) / 2) { return i; }
        }
        return line.Length;
    }

    // 强类型实体版本：`lines` 中被选中的文本，以换行连接（无选中时为 ""）。
    public static string SelectionTextItems(List<LogLine> lines, LogState st) {
        if (!st.HasSelection()) { return ""; }
        int r0 = st.selR0; int c0 = st.selC0;
        int r1 = st.selR1; int c1 = st.selC1;
        if (r0 > r1 || (r0 == r1 && c0 > c1)) {
            int tr = r0; r0 = r1; r1 = tr;
            int tc = c0; c0 = c1; c1 = tc;
        }
        string outp = "";
        int r = r0;
        while (r <= r1 && r < lines.Count) {
            string ln = lines[r].text;
            int s = 0;
            int e = ln.Length;
            if (r == r0) { s = c0; }
            if (r == r1) { e = c1; }
            if (s < 0) { s = 0; }
            if (e > ln.Length) { e = ln.Length; }
            if (s > e) { s = e; }
            outp = outp + ln.Substring(s, e - s);
            if (r < r1) { outp = outp + "\n"; }
            r = r + 1;
        }
        return outp;
    }

    // `lines` 中被选中的文本，以换行连接（无选中时为
    // ""）。
    public static string SelectionText(List<string> lines, LogState st) {
        if (!st.HasSelection()) { return ""; }
        int r0 = st.selR0; int c0 = st.selC0;
        int r1 = st.selR1; int c1 = st.selC1;
        if (r0 > r1 || (r0 == r1 && c0 > c1)) {
            int tr = r0; r0 = r1; r1 = tr;
            int tc = c0; c0 = c1; c1 = tc;
        }
        string outp = "";
        int r = r0;
        while (r <= r1 && r < lines.Count) {
            string ln = lines[r];
            int s = 0;
            int e = ln.Length;
            if (r == r0) { s = c0; }
            if (r == r1) { e = c1; }
            if (s < 0) { s = 0; }
            if (e > ln.Length) { e = ln.Length; }
            if (s > e) { s = e; }
            outp = outp + ln.Substring(s, e - s);
            if (r < r1) { outp = outp + "\n"; }
            r = r + 1;
        }
        return outp;
    }

    // 强类型实体主版本：在 x,y,w,h 中绘制结构化日志行列表。
    public static void PaintItems(App app, int x, int y, int w, int h,
    List<LogLine> lines, LogState st,
    string emptyText) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        if (w <= 0 || h <= 0) { return; }
        StyleBox normal = Style.Part(app, "logview", "text", "", "",
        "", Style.SNormal());
        StyleBox empty = Style.Part(app, "logview", "empty", "", "",
        "", Style.SNormal());

        int rowH = LogView.RowHeight(app);
        int pad = LogView.Padding(app);
        int maxRows = LogView.VisibleRows(app, h);
        int count = lines.Count;
        int maxScroll = count - maxRows;
        if (maxScroll < 0) { maxScroll = 0; }

        if (count == 0) {
            if (emptyText != "") {
                c.DrawText(x + pad, y + pad, emptyText, empty.FgOr(0),
                empty.FontOr(Style.FontFallback(app, "small")));
            }
            return;
        }

        int r0 = st.selR0; int c0 = st.selC0;
        int r1 = st.selR1; int c1 = st.selC1;
        if (r0 >= 0 && (r0 > r1 || (r0 == r1 && c0 > c1))) {
            int tr = r0; r0 = r1; r1 = tr;
            int tc = c0; c0 = c1; c1 = tc;
        }

        EditorPalette pal = EditorPalette.For(t);
        c.PushClip(x, y, w, h);
        int ri = LogView.FirstRow(app, h, count, st.scroll);
        int cy = y + pad;
        while (ri < count && cy + rowH <= y + h - pad) {
            LogLine line = lines[ri];
            string ln = line.text;
            if (r0 >= 0 && ri >= r0 && ri <= r1) {
                int hs = 0;
                int he = ln.Length;
                if (ri == r0) { hs = c0; }
                if (ri == r1) { he = c1; }
                if (hs < 0) { hs = 0; }
                if (he > ln.Length) { he = ln.Length; }
                if (hs > he) { hs = he; }
                int hx0 = x + pad + Canvas.MeasureText(Text.Left(ln, hs), Style.FontFallback(app, "small"));
                int hx1 = x + pad + Canvas.MeasureText(Text.Left(ln, he), Style.FontFallback(app, "small"));
                if (ri < r1) { hx1 = hx1 + pad; }
                if (hx1 < hx0 + 2) { hx1 = hx0 + 2; }
                c.FillRect(hx0, cy, hx1 - hx0, rowH, pal.selection);
            }
            int col = normal.FgOr(0);
            if (line.color != 0) { col = line.color; }
            c.DrawText(x + pad, cy, ln, col, Style.FontFallback(app, "small"));
            cy = cy + rowH;
            ri = ri + 1;
        }
        c.PopClip();

    }

    // 纯绘制文本行，输入、滚动与状态归 ConsoleView 的 retained 生命周期。
    // colors 可为空或与 lines 平行，0 使用主题默认色。
    // 零堆分配实现：直接基于传入的 lines/colors 串行切片渲染，
    // 杜绝每帧为整份日志全量构造 List<LogLine> 与实体节点。
    public static void Paint(App app, int x, int y, int w, int h,
    List<string> lines, List<int> colors, LogState st,
    string emptyText) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        if (w <= 0 || h <= 0) { return; }
        StyleBox normal = Style.Part(app, "logview", "text", "", "",
        "", Style.SNormal());
        StyleBox empty = Style.Part(app, "logview", "empty", "", "",
        "", Style.SNormal());

        int rowH = LogView.RowHeight(app);
        int pad = LogView.Padding(app);
        int maxRows = LogView.VisibleRows(app, h);
        int count = lines.Count;
        int maxScroll = count - maxRows;
        if (maxScroll < 0) { maxScroll = 0; }

        if (count == 0) {
            if (emptyText != "") {
                c.DrawText(x + pad, y + pad, emptyText, empty.FgOr(0),
                empty.FontOr(Style.FontFallback(app, "small")));
            }
            return;
        }

        int r0 = st.selR0; int c0 = st.selC0;
        int r1 = st.selR1; int c1 = st.selC1;
        if (r0 >= 0 && (r0 > r1 || (r0 == r1 && c0 > c1))) {
            int tr = r0; r0 = r1; r1 = tr;
            int tc = c0; c0 = c1; c1 = tc;
        }

        EditorPalette pal = EditorPalette.For(t);
        c.PushClip(x, y, w, h);
        int ri = LogView.FirstRow(app, h, count, st.scroll);
        int cy = y + pad;
        while (ri < count && cy + rowH <= y + h - pad) {
            string ln = lines[ri];
            if (r0 >= 0 && ri >= r0 && ri <= r1) {
                int hs = 0;
                int he = ln.Length;
                if (ri == r0) { hs = c0; }
                if (ri == r1) { he = c1; }
                if (hs < 0) { hs = 0; }
                if (he > ln.Length) { he = ln.Length; }
                if (hs > he) { hs = he; }
                int hx0 = x + pad + Canvas.MeasureText(Text.Left(ln, hs), Style.FontFallback(app, "small"));
                int hx1 = x + pad + Canvas.MeasureText(Text.Left(ln, he), Style.FontFallback(app, "small"));
                if (ri < r1) { hx1 = hx1 + pad; }
                if (hx1 < hx0 + 2) { hx1 = hx0 + 2; }
                c.FillRect(hx0, cy, hx1 - hx0, rowH, pal.selection);
            }
            int col = normal.FgOr(0);
            if (colors != null && ri < colors.Count && colors[ri] != 0) {
                col = colors[ri];
            }
            c.DrawText(x + pad, cy, ln, col, Style.FontFallback(app, "small"));
            cy = cy + rowH;
            ri = ri + 1;
        }
        c.PopClip();

    }

}
