using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;

namespace Gui.Component;

public delegate void ChatAvatarClick(int msgIndex);
public delegate void ChatQuote(int msgIndex, string text);
public delegate void ChatBubbleMenu(int msgIndex, string selText);
public delegate ChatSpeaker ChatSpeakerOf(string agent);
public delegate string ChatKindLabel(string kind);
public delegate string ChatClock(long at);

[GuiKind("ChatView")]
public partial class ChatView : Control {
    public override Control CreateCloneShell() { return new ChatView(); }

    // 调用方的消息列表（实时视图，不拷贝）。
    private List<ChatMessage> data;
    private ChatStrings str;
    private ChatSpeakerOf speakerOf;
    private ChatKindLabel kindLabelOf;
    // 排版模式（ChatStyle.Log / ChatStyle.Bubble）。
    private int style;
    // 时刻格式化钩子（null = 组件内置的本机时区 HH:MM）。
    private ChatClock clockOf;
    // 气泡头像被点中时的宿主回调（bubble 模式专用，见 AvatarHit）。
    private ChatAvatarClick avatarClick;
    // 气泡上右键的宿主回调（bubble 模式；null = 不响应右键）。
    private ChatBubbleMenu bubbleMenu;
    // 卡片消息（msg.card）左键单击的宿主回调（null = 卡片不响应单击）。
    private ChatBubbleMenu bubbleActivate;
    // 卡片单击的按下状态：命中消息下标与按下点（未拖动即视为单击）。
    private int actMsg;
    private int actX;
    private int actY;
    // Arrange 保存准备气泡几何所用的 App，供路由点击回调换算坐标。
    private weak App uiApp;

    // 正在排的那份行表，以及增量重排用的水位线：`cacheTurns` 之前的
    // 轮次已定型，`cachePrefix` 是它们占的行数。
    private List<TextRun> cache;
    private int cacheTurns;
    private int cachePrefix;
    private string cacheKey;
    private string cacheSig;
    // 画出来的那份行表：整份重排要跨好几帧，把半成品直接画出去，看到的
    // 就是「底端锚定的最后一行」一帧一帧往下长——改一次窗口大小，记录就
    // 自己从头滚到底一遍。所以排好的那一份才换上来。
    private List<TextRun> show;
    // 这次重排是整份重排（行号会全部重映射，换上来时要丢掉选区）。
    private bool showStale;

    // 展开的消息下标（工具结果与长代码块共用一份）。
    private List<int> toolOpen;
    private Binding<int> thinkOpen;
    private Binding<int> scrollSig;
    private LogState sel;
    private bool busy;
    // 记录网格与空态提示：常驻子控件，绘制全在它们内部。
    private StyledText grid;
    private Label emptyLbl;

    // ---- 气泡模式（ChatStyle.Bubble）----------------------------------
    // 气泡不是等高行：每条消息是一个宽度按内容、高度按换行结果的可变
    // 盒子，所以它不走 StyledText 的行网格，而是在这里量一遍、
    // 在 OnPaint 里按同一份几何画。几何按「宽度 + 字号 + 数据签名」
    // 缓存，只在真正变了的那一帧重算——否则每帧重新量一遍
    // MeasureText 会把一段长会话的帧预算吃光。
    // 量好的气泡几何（内容坐标，不含滚动偏移）。
    private List<ChatBubble> bub;
    // 几何缓存对应的输入签名（"" = 还没量过）。
    private string bubKey;
    // 几何的总高度（内容坐标），滚动条的界限由它和视口高算出。
    public int bubH;
    // 本次几何是整份重排（会丢弃选区）。
    private bool bubStale;
    // 气泡模式的像素滚动信号（0 = 贴住最新一条）。
    private Binding<int> bscr;
    // 气泡正文的最大宽度比例（千分比），由 `WithBubbleWidth` 给。
    private int bubWMille;
    // 上次量气泡用的布局签名（`BubbleLayoutSig`），变了就是整份重排。
    private string bubSig;
    // 别人的气泡上方显示发言人名字（群聊）。自己发的永远不显示。
    private bool showNames;

    // ---- 气泡模式的文本选择（跨消息）--------------------------------
    // 记录模式的选择走 StyledText 的等高行网格（LogState + 行/列）；
    // 气泡模式的行不是等高的，同一套行列索引在这里没有意义，所以选择
    // 按「消息下标 + 正文内字节偏移」记：(selMsg0, selOff0) 是拖拽起点，
    // (selMsg1, selOff1) 是当前端点，两者谁前谁后由取值比较决定。
    // 偏移是正文（msg.text）里的字节位置，不是展示行里的位置——展示行
    // 随窗口宽度重排，正文偏移不会；窗口一改宽，选区仍框住同一段文字。
    private int selMsg0;
    private int selOff0;
    private int selMsg1;
    private int selOff1;
    private bool selDrag;
    // 宿主回调：用户对某条消息选择「引用」。文本是选中部分（没有选区
    // 就是整条），宿主据此在输入区拉起引用条。
    private ChatQuote quoteCb;

    // 空视图：英文默认文案；Arrange 根据数据切换常驻网格与空态提示。
    public ChatView() {
        this.InitControl("chat");
        this.Pad(0);
        this.gap = 0;
        data = null;
        str = ChatStrings.Default();
        speakerOf = null;
        kindLabelOf = null;
        style = 0;
        clockOf = null;
        // 气泡模式的点击落在子网格 StyledText 上，到不了这里；整条
        // 点击链由 AvatarHit 用当帧几何自己判（日志模式它自会退出）。
        // 双击同样由几何判定：气泡的行不是等高的，StyledText 的
        // 行/列命中在气泡模式下没有意义。
        ChatViewInputAction inputAction = new ChatViewInputAction(this);
        this.OnClick(inputAction.Click);
        this.OnDoubleClick(inputAction.DoubleClick);
        cache = new List<TextRun>();
        cacheTurns = 0;
        cachePrefix = 0;
        cacheKey = "";
        cacheSig = "";
        show = new List<TextRun>();
        showStale = false;
        toolOpen = new List<int>();
        thinkOpen = 0;
        scrollSig = 0;
        bub = new List<ChatBubble>();
        bubKey = "";
        bubH = 0;
        bubStale = false;
        bscr = 0;
        bubWMille = 620;
        bubSig = "";
        showNames = false;
        sel = new LogState();
        selMsg0 = 0 - 1; selOff0 = 0;
        selMsg1 = 0 - 1; selOff1 = 0;
        selDrag = false;
        quoteCb = null;
        bubbleMenu = null;
        busy = false;
        grid = new StyledText();
        grid.Grow();
        // 两个常驻子控件先隐藏，首次 Arrange 按消息数据选择可见节点。
        grid.SetShown(false);
        this.Add(grid);
        emptyLbl = new Label();
        emptyLbl.wrap = true;
        emptyLbl.Class = "hint small";
        emptyLbl.Grow();
        emptyLbl.SetShown(false);
        this.Add(emptyLbl);
    }

    // 控件类型标识（序列化/设计器用）。
    public override string Kind() { return "ChatView"; }

    // 覆写：CSS 类型选择器名（"log"）。
    public override string StyleType() { return "log"; }

    // ---- 宿主接口 ---------------------------------------------------

    public List<ChatMessage> ItemsSource {
        get { return data; }
        set { this.Bind(value); }
    }

    public ChatStrings Strings {
        get { return str; }
        set { this.WithStrings(value); }
    }

    public int StyleMode {
        get { return style; }
        set { this.WithStyle(value); }
    }

    public int BubbleWidthMille {
        get { return bubWMille; }
        set { this.WithBubbleWidth(value); }
    }

    public bool ShowSpeakerNames {
        get { return showNames; }
        set { this.WithSpeakerNames(value); }
    }

    public bool IsBusy {
        get { return busy; }
        set { this.SetBusy(value); }
    }

    public ChatClock ClockFormatter {
        get { return clockOf; }
        set { this.WithClock(value); }
    }

    public ChatAvatarClick AvatarClickHandler {
        get { return avatarClick; }
        set { avatarClick = value; }
    }

    public ChatBubbleMenu BubbleMenuHandler {
        get { return bubbleMenu; }
        set { bubbleMenu = value; }
    }

    public ChatBubbleMenu BubbleActivateHandler {
        get { return bubbleActivate; }
        set { bubbleActivate = value; }
    }

    public ChatQuote QuoteHandler {
        get { return quoteCb; }
        set { quoteCb = value; }
    }

    // 绑定调用方的消息列表（实时视图，不拷贝）。
    public void Bind(List<ChatMessage> msgs) {
        data = msgs;
    }

    // 全部可见文案（宿主已本地化）。
    public void WithStrings(ChatStrings s) {
        if (s != null) { str = s; }
        this.Invalidate();
    }

    // 多智能体会话的外观解析钩子（单助手程序不必调用）。
    public void WithSpeakers(ChatSpeakerOf who, ChatKindLabel kindLabel) {
        speakerOf = who;
        kindLabelOf = kindLabel;
        this.Invalidate();
    }

    // 排版模式（ChatStyle.Log / ChatStyle.Bubble）。换了模式要整份重排。
    public void WithStyle(int st) {
        style = st;
        this.Invalidate();
    }

    // 时刻格式化钩子（气泡模式的时刻分隔与气泡尾巴小字都走它）。
    public void WithClock(ChatClock c) {
        clockOf = c;
        this.Invalidate();
    }

    // 气泡正文的最大宽度（占视口宽的千分比，默认 620 = 六成）。窗口
    // 很宽时一条短消息拉满整屏并不好读，这个上限就是「一句话最长能
    // 占多宽」；窗口变窄时气泡仍然按可用宽度收窄，不会溢出。
    public void WithBubbleWidth(int mille) {
        if (mille < 250) { mille = 250; }
        if (mille > 1000) { mille = 1000; }
        bubWMille = mille;
        this.Invalidate();
    }

    // Keep the original double-click cache contract; the action only borrows us.
    public void DispatchInputDoubleClick() {
        App app = uiApp;
        if (app != null && style == ChatStyle.Bubble()) {
            this.BubbleDoubleClick(app);
        }
    }

    // 当前排版模式。
    public int Style() { return style; }

    // 别人的气泡上方是否显示发言人名字（群聊场景）。一对一聊天关掉它：
    // 左边永远只有一个人，名字行只是白占一行高度。
    public void WithSpeakerNames(bool on) {
        showNames = on;
        this.Invalidate();
    }

    // 本机时区下这条消息的显示文本；没有记时间的旧消息返回 ""。
    public string Clock(long at) {
        if (clockOf != null) { return clockOf(at); }
        if (at <= 0) { return ""; }
        DateTime d = DateTime.FromUnixSeconds(at).ToLocalTime();
        return Text.Left(d.ToTimeString(), 5);
    }

    // 一条消息头行右侧的本机时区时刻（HH:MM）；没有记时间的旧消息返回 ""。
    public static string ClockText(long at) {
        if (at <= 0) { return ""; }
        DateTime d = DateTime.FromUnixSeconds(at).ToLocalTime();
        return Text.Left(d.ToTimeString(), 5);
    }

    // 模型正在回答：记录末尾显示 busy 行。
    public void SetBusy(bool on) { busy = on; }

    // 选区状态（宿主可持久化或复位）。
    public LogState Selection() { return sel; }

    // 底端锚定的滚动偏移绑定（0 = 贴住最新一行）。
    public Binding<int> Scroll() { return scrollSig; }

    // 气泡模式的像素滚动偏移绑定（0 = 贴住最新一条）。宿主把它接到
    // 自己的滚动记忆上时用；不接也不影响滚轮与拖动。
    public Binding<int> BubbleScroll() { return bscr; }

    // 换掉一整份记录（切换会话）：缓存、折叠、选区与滚动全部归零。
    public void Reset() {
        cache = new List<TextRun>();
        cacheTurns = 0;
        cachePrefix = 0;
        cacheKey = "";
        cacheSig = "";
        show = new List<TextRun>();
        showStale = false;
        toolOpen = new List<int>();
        bub = new List<ChatBubble>();
        bubKey = "";
        bubH = 0;
        bubStale = false;
        bscr.Set(0);
        App app = this.App;
        if (app != null) { this.PrepareBubbleAvatars(app); }
        sel.Reset();
        scrollSig.Set(0);
    }

    // 下一帧整份重排（文案、字号或钩子变了）。
    public void Invalidate() {
        cacheKey = "";
        cacheSig = "";
        bubKey = "";
    }

    // 当前选中的文本（未选中则 ""）。气泡模式下回答气泡选区，
    // 记录模式下回答行网格选区——宿主两个模式都可能用。
    public string SelectedText() {
        if (style == ChatStyle.Bubble()) { return this.BubbleSelectionText(); }
        return ChatView.SelectionText(show, sel);
    }

    // 气泡模式下是否有选区（宿主菜单据此决定「复制」是灰的还是亮的）。
    public bool HasSelection() {
        if (style == ChatStyle.Bubble()) { return this.HasBubbleSelection(); }
        return sel.HasSelection();
    }

    // 清空当前选择（气泡/记录两模式通用）。
    public void ClearSelection() {
        if (style == ChatStyle.Bubble()) { this.ClearBubbleSelection(); return; }
        sel.ClearSelection();
    }

    // ---- retained 钩子 ----------------------------------------------

    private bool bubbleScrollReady;
    private int projectedBubbleScroll;
    private int bubbleMaximum;

    public override StyleBox ResolveStyle(App app, int state) {
        StyleBox box = base.ResolveStyle(app, state);
        if (box.overflowCss == -1) {
            box.overflowY = style == ChatStyle.Bubble() ? 2 : 1;
            box.overflow = 1;
        }
        return box;
    }

    public override Rect ScrollViewport() {
        Rect view = base.ScrollViewport();
        App app = this.App;
        int pad = app != null ? app.Scale(10) : 10;
        return new Rect(view.x, view.y + pad, view.width, Math.Max(0, view.height - pad * 2));
    }

    public override void OnScrollChanged() {
        if (style != ChatStyle.Bubble() || !bubbleScrollReady) { return; }
        projectedBubbleScroll = Math.Max(0, bubbleMaximum - this.ScrollTop());
        if (bscr.Get() != projectedBubbleScroll) { bscr.Set(projectedBubbleScroll); }
        App app = this.App;
        if (app != null) { this.PrepareBubbleAvatars(app); }
    }

    public override void Arrange(int x, int y, int w, int h) {
        bx = x; by = y; bw = Math.Max(0, w); bh = Math.Max(0, h);
        App app = this.App;
        if (app == null) { return; }
        uiApp = app;
        this.PrepareChat(app);
        if (style == ChatStyle.Bubble()) {
            bool external = !bubbleScrollReady || bscr.Get() != projectedBubbleScroll;
            int distance = bubbleMaximum - this.ScrollTop();
            Rect view = this.ScrollViewport();
            scrollExtent = bubH;
            scrollExtentX = view.width;
            bubbleMaximum = Math.Max(0, bubH - view.height);
            int next = bubbleMaximum - (external ? bscr.Get() : distance);
            bubbleScrollReady = true;
            int previous = this.ScrollTop();
            this.SetScrollTop(Math.Max(0, Math.Min(bubbleMaximum, next)));
            if (previous == this.ScrollTop()) { this.OnScrollChanged(); }
        } else {
            bubbleScrollReady = false;
            scrollExtent = bh;
            scrollExtentX = bw;
            this.SetScrollTop(0);
            this.PrepareBubbleAvatars(app);
        }
        emptyLbl.MeasureTree(app);
        emptyLbl.Arrange(x, y, w, h);
        grid.MeasureTree(app);
        grid.Arrange(x, y, w, h);
    }

    private void PrepareChat(App app) {
        bool has = data != null && data.Count > 0;
        bool bubMode = style == ChatStyle.Bubble();
        emptyLbl.SetShown(!has && !busy);
        // 记录网格只在记录模式下出现：气泡模式的行不是等高的展示行，
        // 走的是这里自己的几何，网格留着只会把上一份记录又画一遍。
        grid.SetShown(!bubMode && (has || busy));
        if (!has && !busy) {
            emptyLbl.Text = str.empty;
            if (bubMode) { this.BuildBubble(app); }
            return;
        }
        if (bubMode) {
            this.BuildBubble(app);
            return;
        }
        this.Build(app);
        grid.lines = show;
        grid.busy = busy;
        grid.sel = sel;
        grid.interactive = true;
        grid.thinkOpen = thinkOpen;
        grid.toolOpen = toolOpen;
        grid.busyText = str.busy;
        // 记录网格自己画纵向滚动条（它才知道行高与可见行数），这里只把同一个
        // 滚动信号交给它，滚轮与拖动于是动的是同一个量。
        grid.scrollBar = scrollSig;
    }

    public override void OnPaint(App app) {
        if (style == ChatStyle.Bubble()) { this.PaintBubbles(app); }
    }

    public override void OnPointerDown(RoutedEventArgs e) {
        App app = this.App;
        if (e.handled || app == null || this.IsDisabled() || style != ChatStyle.Bubble()) { return; }
        this.BubbleMouse(app);
        if (selDrag) { app.CapturePointer(this, true); e.Handle(); }
    }

    public override void OnPointerMove(RoutedEventArgs e) {
        App app = this.App;
        if (!e.handled && app != null && style == ChatStyle.Bubble()) { this.BubbleMouse(app); }
    }

    public override void OnPointerUp(RoutedEventArgs e) {
        App app = this.App;
        if (e.handled || app == null || style != ChatStyle.Bubble()) { return; }
        if (selDrag && app.window.EventButton() == 0) {
            ChatHit hit = this.SnapHit(this.HitBubble(app, e.x, e.y, true));
            if (hit.msg >= 0) { selMsg1 = hit.msg; selOff1 = hit.off; }
            selDrag = false;
            if (app.GetCapturedPointer() == this) { app.ReleasePointerCapture(); }
            e.Handle();
            app.RequestRedraw();
        } else { this.BubbleMouse(app); }
    }

    public override void OnPointerCancel(RoutedEventArgs e) {
        selDrag = false;
        actMsg = -1;
        base.OnPointerCancel(e);
    }

    public override void OnKeyDown(RoutedEventArgs e) {
        App app = this.App;
        if (app == null || e.handled) { return; }
        if (style == ChatStyle.Bubble()) { this.TakeBubbleCopy(app); }
        else { this.TakeCopy(app); }
    }

    // 宿主注册「气泡头像被点」回调。
    public void OnAvatarClick(ChatAvatarClick cb) {
        avatarClick = cb;
    }

    // Use the prepared child geometry, including themed avatar dimensions.
    public void AvatarHit() {
        App app = uiApp;
        if (avatarClick == null || app == null || style != ChatStyle.Bubble()
        || bubKey == "" || bubbleAvatars == null) { return; }
        if (app.mouseX < bx || app.mouseX >= bx + bw
        || app.mouseY < by || app.mouseY >= by + bh) { return; }
        for (int i = 0; i < bubbleAvatars.Count; i = i + 1) {
            ChatBubbleAvatar avatar = bubbleAvatars[i];
            if (avatar.HitTest(app.mouseX, app.mouseY) != null) {
                avatarClick(avatar.messageIndex);
                return;
            }
        }
    }
}
