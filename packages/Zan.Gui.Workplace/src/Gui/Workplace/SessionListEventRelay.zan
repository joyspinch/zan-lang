using Gui;

namespace Gui.Component;

// Each queued delegate belongs to the host session that wired it.
public class SessionListEventRelay {
    private weak SessionList owner;
    private int generation;
    public SessionListEventRelay(SessionList owner, int generation) {
        this.owner = owner; this.generation = generation;
    }
    public void Create() { if (owner != null && owner.InputCurrent(generation)) { owner.Create(); } }
    public void SearchChanged() { if (owner != null && owner.InputCurrent(generation)) { owner.SearchChanged(); } }
    public void ToggleArchived() { if (owner != null && owner.InputCurrent(generation)) { owner.ToggleArchived(); } }
}
