using System;
using Gui;
using Gui.Widget;

namespace Gui.Component;

public class SessionListRow : Row {
    private weak SessionList owner;
    private int index;
    private Label title;
    private Input rename;
    private Button edit;
    private Button archive;
    private Button delete;
    private SessionListRowRelay eventRelay;

    public SessionListRow(SessionList owner, int index) {
        this.InitControl("listrow", 0);
        this.owner = owner; this.index = index;
        title = new Label("");
        title.AddClass("small");
        rename = new Input("");
        rename.AddClass("small");
        edit = new Button("");
        edit.AddClass("ghost small"); edit.Icon = "edit";
        archive = new Button("");
        archive.AddClass("ghost small"); archive.Icon = "archive";
        delete = new Button("");
        delete.AddClass("ghost small"); delete.Icon = "x";
        this.PrepareActionButton(edit);
        this.PrepareActionButton(archive);
        this.PrepareActionButton(delete);
        this.With(title).With(rename).With(edit).With(archive).With(delete);
        this.WireEvents(owner.InputGeneration());
    }

    private void PrepareActionButton(Button button) {
        // Icon is projected into retained children by SyncBinding; assemble it
        // before the first MeasureTree, and keep an icon-only hit box at one size.
        button.Size = "tiny";
        button.SetProp("style", "width: var(--height-tiny); min-width: var(--height-tiny); height: var(--height-tiny); flex-shrink: 0; padding: 0;");
        button.SyncBinding();
    }

    public void WireEvents(int generation) {
        if (eventRelay != null) {
            title.Click.Remove(eventRelay.Select);
            edit.Click.Remove(eventRelay.Edit);
            archive.Click.Remove(eventRelay.Archive);
            delete.Click.Remove(eventRelay.Delete);
            rename.Submit.Remove(eventRelay.Submit);
        }
        eventRelay = new SessionListRowRelay(this, generation);
        title.Click.Add(eventRelay.Select);
        edit.Click.Add(eventRelay.Edit);
        archive.Click.Add(eventRelay.Archive);
        delete.Click.Add(eventRelay.Delete);
        rename.Submit.Add(eventRelay.Submit);
    }
    public bool InputCurrent(int generation) {
        return owner != null && owner.RowInputCurrent(this, generation);
    }

    public int Index() { return index; }
    public void Update(string text, bool selected, bool isArchived, bool editing,
            string archiveTip, string deleteTip, string renameTip) {
        title.Text = text == "" ? "..." : text;
        rename.SetText(text);
        title.Visible = !editing; rename.Visible = editing;
        edit.Tip = renameTip;
        archive.Tip = archiveTip;
        delete.Tip = deleteTip;
        title.SetClassIn("current archived", selected ? "current" : "");
        if (isArchived) { title.AddClass("archived"); }
        archive.Icon = isArchived ? "upload" : "archive";
        archive.SyncBinding();
    }

    public void FocusRename() { rename.Focus(this.FindApp()); rename.SelectAll(); }
    public void Select() { if (owner != null) { owner.Select(index); } }
    public void Edit() { if (owner != null) { owner.BeginRename(index); } }
    public void Archive() { if (owner != null) { owner.Archive(index); } }
    public void Delete() { if (owner != null) { owner.Delete(index); } }
    public void Submit() { if (owner != null) { owner.FinishRename(index, rename.GetText()); } }
    public override void OnKeyDown(RoutedEventArgs e) {
        if (owner != null && this.InputCurrent(owner.InputGeneration()) && rename.Visible && e.keyCode == 27) {
            if (owner != null) { owner.CancelRenameInput(); }
            e.Handle(); return;
        }
        base.OnKeyDown(e);
    }

    public override void OnMeasure(App app) { prefH = app.Scale(30); }
    public override void OnPaint(App app) {
        StyleBox normal = Control.BareBox(app, "listrow", Style.SNormal());
        StyleBox selected = Control.BareBox(app, "listrow", Style.SSelected());
        if (Style.Has(title.Class, "current")) {
            app.canvas.FillRect(bx, by, bw, bh, selected.BgOr(normal.BgOr(0)));
        }
        StyleBox divider = Style.Part(app, "sessionlist", "divider", "", "", "", Style.SNormal());
        app.canvas.FillRect(bx, by + bh - 1, bw, 1, divider.BgOr(0));
    }
}
