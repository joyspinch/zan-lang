using System;
using Gui;
using Gui.Widget;

namespace Gui.Component;

// Retained session navigation. RenderEx remains a compatibility projection;
// production hosts prepare Root() and consume actions from the routed event path.
public class SessionList : UiViewOwner {
    private Column root;
    private Button newButton;
    private Input search;
    private ScrollColumn rows;
    private Button archivedButton;
    private List<SessionListRow> rowControls;
    private List<string> titles;
    private List<int> archived;
    private int current;
    private bool showArchived;
    private int editing;
    private string emptyText;
    private string archiveTip;
    private string deleteTip;
    private string archivedLabel;
    private string renameTip;
    private SessionListAction pending;
    private int viewX;
    private int viewY;
    private int viewW;
    private int viewH;
    private bool fullHostBounds;
    private bool hostAttached;
    private int clientTop;
    private int inputGeneration;
    private int rowsGeneration;
    private SessionListEventRelay eventRelay;
    private weak App viewApp;
    private UiViewScope viewScope;
    private ControlInputHost viewHost;
    public UiEvent Action;

    public SessionList(string searchHint, string newLabel) {
        Column layout = new Column();
        layout.AddClass("sessionlist");
        root = layout;
        newButton = new Button(newLabel);
        newButton.AddClass("primary small");
        search = new Input(searchHint);
        search.AddClass("small");
        rows = new ScrollColumn();
        rows.Grow();
        archivedButton = new Button("Archived");
        archivedButton.AddClass("ghost small");
        layout.With(newButton).With(search).With(rows).With(archivedButton);
        rowControls = new List<SessionListRow>();
        titles = new List<string>();
        archived = new List<int>();
        current = -1;
        editing = -1;
        emptyText = "";
        archiveTip = "";
        deleteTip = "";
        archivedLabel = "Archived";
        renameTip = "";
        pending = SessionListAction.None();
        Action = new UiEvent();
        this.WireEvents();
    }

    public SessionList Labels(string archive, string delete, string archivedText) {
        archiveTip = archive; deleteTip = delete; archivedLabel = archivedText;
        return this;
    }
    public SessionList RenameLabel(string text) { renameTip = text; return this; }
    public SessionList EmptyText(string text) { emptyText = text; return this; }
    public Column Root() { return root; }
    public string Query() { return search.GetText(); }
    public static int RowH(App app) { return app.Scale(30); }
    public void CancelRename() { editing = -1; this.RebuildRows(); }

    public void InitializeHost(App app) {
        if (app == null) { return; }
        if (viewHost != null && viewApp != app) {
            int previous = inputGeneration;
            this.RetireHost();
            // Cancel/Leave may have chosen a different host, including this App.
            if (inputGeneration != previous + 1 || viewHost != null) { return; }
        }
        if (viewHost != null) { return; }
        inputGeneration = inputGeneration + 1;
        viewApp = app;
        ControlInputHost input = new ControlInputHost(root);
        viewHost = input;
        viewScope = new UiViewScope(app, this, root);
        hostAttached = true;
        root.Visible = true;
        this.WireEvents();
        input.Bind(app);
    }

    public App HostApp() { return viewApp; }
    public int InputGeneration() { return inputGeneration; }
    public bool InputCurrent(int generation) {
        return generation == inputGeneration && hostAttached && viewApp != null
            && viewScope != null && viewScope.IsActive() && root.Visible;
    }
    public bool RowInputCurrent(SessionListRow row, int generation) {
        if (!this.InputCurrent(generation) || row == null || row.parent != rows) { return false; }
        for (int i = 0; i < rowControls.Count; i = i + 1) {
            if (rowControls[i] == row) { return true; }
        }
        return false;
    }

    private void WireEvents() {
        if (eventRelay != null) {
            newButton.Click.Remove(eventRelay.Create);
            search.Change.Remove(eventRelay.SearchChanged);
            archivedButton.Click.Remove(eventRelay.ToggleArchived);
        }
        eventRelay = new SessionListEventRelay(this, inputGeneration);
        newButton.Click.Add(eventRelay.Create);
        search.Change.Add(eventRelay.SearchChanged);
        archivedButton.Click.Add(eventRelay.ToggleArchived);
        for (int i = 0; i < rowControls.Count; i = i + 1) { rowControls[i].WireEvents(inputGeneration); }
    }

    public void SuspendHost() {
        if (!hostAttached) { return; }
        inputGeneration = inputGeneration + 1;
        hostAttached = false;
        root.Visible = false;
        pending = SessionListAction.None();
        // Keep both early registrations: resuming in BeforeInput must not add a
        // participant or replace the input root after its snapshot was taken.
        App app = viewApp;
        if (app != null) { app.ReleaseInputSubtree(root); }
    }

    private void ResumeHost() {
        if (hostAttached) { return; }
        inputGeneration = inputGeneration + 1;
        hostAttached = true;
        root.Visible = true;
        this.WireEvents();
    }

    public void PrepareHost(App app, int x, int y, int w, int h) {
        if (app == null) { return; }
        this.InitializeHost(app);
        if (viewApp != app || viewScope == null || viewHost == null) { return; }
        this.ResumeHost();
        fullHostBounds = false;
        viewX = x; viewY = y; viewW = w; viewH = h;
        this.PrepareView(viewScope, app);
    }

    public void PrepareHostClient(App app, int top) {
        if (app == null) { return; }
        this.InitializeHost(app);
        if (viewApp != app || viewScope == null || viewHost == null) { return; }
        this.ResumeHost();
        fullHostBounds = true;
        clientTop = top;
        viewX = app.ShapeOffX();
        viewY = app.ContentTop() + app.ShapeOffY() + top;
        viewW = app.ClientWidth();
        viewH = app.ClientHeight() - app.ContentTop() - top;
        if (viewW < 0) { viewW = 0; }
        if (viewH < 0) { viewH = 0; }
        this.PrepareView(viewScope, app);
    }

    public void RenderPrepared(App app) {
        if (app == null || viewApp != app || viewScope == null || !hostAttached) { return; }
        root.RenderTree(app);
    }

    public void RetireHost() {
        inputGeneration = inputGeneration + 1;
        root.Visible = false;
        UiViewScope scope = viewScope; viewScope = null;
        ControlInputHost input = viewHost; viewHost = null;
        viewApp = null;
        hostAttached = false;
        pending = SessionListAction.None();
        if (scope != null) { scope.Retire(); }
        if (input != null) { input.Hide(); }
    }

    public void PrepareView(UiViewScope view, App app) {
        if (view == null || view != viewScope || app != viewApp || !hostAttached) { return; }
        if (fullHostBounds) {
            viewX = app.ShapeOffX();
            viewY = app.ContentTop() + app.ShapeOffY() + clientTop;
            viewW = app.ClientWidth();
            viewH = app.ClientHeight() - app.ContentTop() - clientTop;
        }
        if (viewW < 0) { viewW = 0; }
        if (viewH < 0) { viewH = 0; }
        view.Layout(viewX, viewY, viewW, viewH);
    }
    public void ViewAction(string name, Control sender) { }
    public void ViewPointer(Control sender, RoutedEventArgs args) { }

    public void Bind(List<string> nextTitles, int selected, List<int> nextArchived) {
        bool changed = current != selected || titles.Count != nextTitles.Count;
        if (!changed) {
            for (int i = 0; i < titles.Count; i = i + 1) {
                int flag = i < nextArchived.Count ? nextArchived[i] : 0;
                if (titles[i] != nextTitles[i] || archived[i] != flag) { changed = true; break; }
            }
        }
        current = selected;
        if (!changed) { return; }
        titles = new List<string>(); archived = new List<int>();
        for (int i = 0; i < nextTitles.Count; i = i + 1) {
            titles.Add(nextTitles[i]);
            archived.Add(i < nextArchived.Count ? nextArchived[i] : 0);
        }
        this.RebuildRows();
    }

    private void RebuildRows() {
        rowsGeneration = rowsGeneration + 1;
        int revision = rowsGeneration;
        editing = editing >= titles.Count ? -1 : editing;
        rows.RemoveAll();
        if (rowsGeneration != revision) { return; }
        rowControls = new List<SessionListRow>();
        string query = search.GetText();
        for (int i = 0; i < titles.Count; i = i + 1) {
            if (!showArchived && archived[i] != 0) { continue; }
            if (!SessionList.CiContains(titles[i], query)) { continue; }
            SessionListRow row = new SessionListRow(this, i);
            row.Update(titles[i], i == current, archived[i] != 0, i == editing,
                archiveTip, deleteTip, renameTip);
            rowControls.Add(row);
            rows.Add(row);
            if (rowsGeneration != revision) { return; }
        }
        archivedButton.SetText(archivedLabel + " (" + Convert.ToString(this.ArchiveCount()) + ")");
        archivedButton.Visible = this.ArchiveCount() > 0;
        if (rowControls.Count == 0 && emptyText != "") {
            Label empty = new Label(emptyText);
            empty.AddClass("text-secondary small");
            rows.Add(empty);
        }
    }

    private int ArchiveCount() {
        int count = 0;
        for (int i = 0; i < archived.Count; i = i + 1) { if (archived[i] != 0) { count = count + 1; } }
        return count;
    }

    public void SearchChanged() { this.RebuildRows(); }
    public void ToggleArchived() { showArchived = !showArchived; this.RebuildRows(); }
    public void Create() { SessionListAction action = SessionListAction.None(); action.created = true; this.Emit(action); }
    public void Select(int index) { SessionListAction action = SessionListAction.None(); action.selected = index; this.Emit(action); }
    public void Archive(int index) { SessionListAction action = SessionListAction.None(); action.archived = index; this.Emit(action); }
    public void Delete(int index) { SessionListAction action = SessionListAction.None(); action.deleted = index; this.Emit(action); }
    public void BeginRename(int index) {
        if (!this.InputCurrent(inputGeneration) || index < 0 || index >= titles.Count) { return; }
        int generation = inputGeneration;
        editing = index;
        this.RebuildRows();
        if (!this.InputCurrent(generation) || editing != index) { return; }
        for (int i = 0; i < rowControls.Count; i = i + 1) {
            if (rowControls[i].Index() == index) { rowControls[i].FocusRename(); break; }
        }
    }
    public void FinishRename(int index, string title) {
        if (!this.InputCurrent(inputGeneration) || editing != index) { return; }
        int generation = inputGeneration;
        editing = -1;
        this.RebuildRows();
        if (!this.InputCurrent(generation)) { return; }
        SessionListAction action = SessionListAction.None(); action.renamed = index; action.title = title;
        this.Emit(action);
    }
    public void CancelRenameInput() { editing = -1; this.RebuildRows(); }
    private void Emit(SessionListAction action) {
        if (!this.InputCurrent(inputGeneration)) { return; }
        pending = action;
        this.NotifyAction();
    }
    public void NotifyAction() {
        if (this.InputCurrent(inputGeneration)) { Action.Raise(root); }
    }
    public SessionListAction TakeAction() { SessionListAction value = pending; pending = SessionListAction.None(); return value; }

    public static int Fold(int b) { if (b >= 65 && b <= 90) { return b + 32; } return b; }
    public static bool CiContains(string hay, string needle) {
        int m = needle.Length; if (m == 0) { return true; }
        for (int i = 0; i + m <= hay.Length; i = i + 1) {
            int k = 0;
            for (; k < m; k = k + 1) {
                if (SessionList.Fold(hay[i + k]) != SessionList.Fold(needle[k])) { k = -1; break; }
            }
            if (k == m) { return true; }
        }
        return false;
    }

}
