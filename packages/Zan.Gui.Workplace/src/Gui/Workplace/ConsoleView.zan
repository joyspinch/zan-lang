using System;
using Gui;
using Gui.Widget;

namespace Gui.Component;

// 尾部滚动、可选择的控制台视图**控件**：把 LogView 的滚动与
// 选择状态包进一个标准 retained 控件，于是声明式界面
// （.html 设计稿）可以像放 ListView 一样直接声明一个控制台，
// 宿主只需要绑定行列表。行颜色可选。
public class ConsoleView : Control {
    public override Control CreateCloneShell() { return new ConsoleView(); }

    // 强类型实体行列表（唯一主表示，彻底消除 data/colors 平行列表反模式）。
    private List<LogLine> items;
    // 滚动与选择状态（渲染共用一份，宿主可经 State() 持久化或复位）。
    private LogState st;
    // 无行时居中显示的提示（"" 则不绘制）。
    public string Empty;
    // false 时只绘制，不处理滚轮/选择（嵌入的小日志条）。
    private bool live;

    // 构造空视图：未绑定行，活动模式（滚轮/选择可用）。
    public ConsoleView() {
        this.InitControl("console");
        items = new List<LogLine>();
        st = new LogState();
        st.Reset();
        Empty = "";
        live = true;
    }

    // 样式类别（沿用 LogView 的 "log"，两者皮肤一致）。
    public override string StyleType() { return "log"; }

    public List<LogLine> Items {
        get { return items; }
        set { this.BindItems(value); }
    }

    public List<string> Lines {
        set { this.Bind(value); }
    }

    public List<int> Colors {
        set { this.WithColors(value); }
    }

    public bool Live {
        get { return live; }
        set { live = value; }
    }

    public LogState StateModel {
        get { return st; }
        set { if (value != null) { this.UseState(value); } }
    }

    // 强类型实体绑定主入口：绑定调用方的结构化行列表。
    public void BindItems(List<LogLine> lines) {
        if (lines != null) { items = lines; }
        else { items = new List<LogLine>(); }
    }

    // 绑定调用方的纯文本行列表（自动提升为 LogLine 实体列表）。
    public void Bind(List<string> lines) {
        items = new List<LogLine>();
        if (lines != null) {
            for (int i = 0; i < lines.Count; i = i + 1) {
                items.Add(LogLine.OfText(lines[i]));
            }
        }
    }

    // 绑定行颜色列表（直接对齐到 LogLine 实体）。
    public void WithColors(List<int> cols) {
        if (cols != null && items != null) {
            for (int i = 0; i < items.Count && i < cols.Count; i = i + 1) {
                if (items[i] != null) { items[i].color = cols[i]; }
            }
        }
    }

    // 无行时的提示文案（"" 不显示）。
    public void EmptyText(string text) {
        if (text != null) { Empty = text; }
    }

    // 只读日志条：不接受滚轮与拖拽选择。
    public void Passive() {
        live = false;
    }

    // 视图的滚动/选择状态，供宿主持久化或复位。
    public LogState State() { return st; }

    // 跳回最新一行并清除选择。
    public void Reset() { st.Reset(); scrollReady = false; }

    // 当前选中的文本（无选择时为 ""）。
    public string SelectedText() {
        if (items == null || items.Count == 0) { return ""; }
        if (!st.HasSelection()) { return ""; }
        return LogView.SelectionTextItems(items, st);
    }

    // 覆写：设计器属性（空态文案与只读开关；数据经 Bind 在代码侧给）。
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("empty", "Empty text")
            .Field("Empty")
            .WithTip("Shown centred when there are no lines; \"\" hides it."));
        ps.Add(PropSpec.Bool("live", "Live")
            .Field("live")
            .WithTip("Off renders a passive strip: no wheel or drag selection."));
        return ps;
    }

    private int rowPixel;
    private int maximum;
    private int projectedScroll;
    private bool scrollReady;

    public void UseState(LogState state) {
        if (state == null) { throw new ArgumentException("log state required"); }
        st = state; scrollReady = false;
    }

    public override StyleBox ResolveStyle(App app, int state) {
        StyleBox box = base.ResolveStyle(app, state);
        if (box.overflowCss == -1) { box.overflowY = live ? 2 : 1; box.overflow = 1; }
        return box;
    }

    public override Rect ScrollViewport() {
        Rect view = base.ScrollViewport();
        App app = this.App;
        int pad = app != null ? LogView.Padding(app) : 6;
        int row = rowPixel > 0 ? rowPixel : 18;
        return new Rect(view.x, view.y + pad, view.width, Math.Max(0, view.height - pad * 2) / row * row);
    }

    public override void OnScrollChanged() {
        if (!scrollReady || rowPixel <= 0) { return; }
        projectedScroll = Math.Max(0, maximum - this.ScrollTop()) / rowPixel;
        st.scroll = projectedScroll;
    }

    public override void Arrange(int x, int y, int w, int h) {
        bx = x; by = y; bw = Math.Max(0, w); bh = Math.Max(0, h);
        App app = this.App;
        if (app == null) { return; }
        rowPixel = LogView.RowHeight(app);
        int rows = LogView.VisibleRows(app, bh);
        bool external = !scrollReady || st.scroll != projectedScroll;
        int distance = maximum - this.ScrollTop();
        int count = items != null ? items.Count : 0;
        maximum = Math.Max(0, count - rows) * rowPixel;
        scrollExtent = maximum + this.ScrollViewport().height;
        scrollExtentX = bw;
        int next = maximum - (external ? st.scroll * rowPixel : distance);
        scrollReady = true;
        this.SetScrollTop(Math.Max(0, Math.Min(maximum, next)));
        this.OnScrollChanged();
    }

    private void SelectAt(int x, int y, bool anchor) {
        App app = this.App;
        if (app == null || items == null) { return; }
        int row = LogView.RowAt(app, by, bh, items.Count, st.scroll, y);
        string lineText = (row >= 0 && row < items.Count && items[row] != null) ? items[row].text : "";
        int column = row >= 0 ? LogView.ColAt(lineText, bx + LogView.Padding(app),
        Style.FontFallback(app, "small"), x) : 0;
        if (anchor) { st.selR0 = row; st.selC0 = column; }
        st.selR1 = row; st.selC1 = column;
    }

    public override void OnPointerDown(RoutedEventArgs e) {
        App app = this.App;
        if (e.handled || app == null || !live || this.IsDisabled() || e.originalSource != this
        || app.window.EventButton() != 0 || this.ScrollBarHit(e.x, e.y) != 0) { return; }
        this.SelectAt(e.x, e.y, true); st.selDrag = true;
        app.CapturePointer(this, true); app.RequestRedraw(); e.Handle();
    }

    public override void OnPointerMove(RoutedEventArgs e) {
        App app = this.App;
        if (app == null || !st.selDrag || app.GetCapturedPointer() != this) { return; }
        this.SelectAt(e.x, e.y, false); app.RequestRedraw(); e.Handle();
    }

    public override void OnPointerUp(RoutedEventArgs e) {
        App app = this.App;
        if (app == null || !st.selDrag || app.window.EventButton() != 0) { return; }
        this.SelectAt(e.x, e.y, false); st.selDrag = false;
        if (app.GetCapturedPointer() == this) { app.ReleasePointerCapture(); }
        app.RequestRedraw(); e.Handle();
    }

    public override void OnPointerCancel(RoutedEventArgs e) {
        st.selDrag = false; st.barDrag = false;
        base.OnPointerCancel(e);
    }

    public override void OnPaint(App app) {
        LogView.PaintItems(app, bx, by, bw, bh, items, st, Empty);
    }
}
