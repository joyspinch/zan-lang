using System;
using Gui;

namespace Gui.Component;

// Event package retains this action; the action must not retain its owner.
public class ChatViewInputAction {
    private weak ChatView owner;

    public ChatViewInputAction(ChatView chat) { owner = chat; }

    public void Click() {
        ChatView chat = owner;
        if (chat == null) { return; }
        chat.AvatarHit();
    }

    public void DoubleClick() {
        ChatView chat = owner;
        if (chat == null) { return; }
        chat.DispatchInputDoubleClick();
    }
}
