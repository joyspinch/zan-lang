using System;
using Gui;
using Gui.Widget;

namespace Gui.Component;

// 属性表：把一组 PropSpec 画成可编辑的属性行，值直接读写 spec 绑定
// 的字段 / signal。行的标签、编辑器、滚动、裁剪都由控件自己完成，
// 宿主只提供 spec 列表：
// 编辑器按 PropSpec.kind 选：0/4 文本 Input，1 整数 Input，2 Switch，
// 3 SelectBox，5 分组标题（PropSpec.Section，只有文字没有编辑器）。
public class PropertyGrid : Control {
    // 当前绑定的属性行（Bind 每帧灌入，不拷贝）。
    private List<PropSpec> data;
    // 每行一个强类型行编辑器实体（包含对应的 Input/Switch/SelectBox/按键ID/影子值）。
    private List<PropertyGridRow> rows;
    // 当前绑定对象的标识，变化时重建编辑器。
    private string key;
    private int bindingEpoch;
    private bool preparingRows;
    // 自定义标签列宽（逻辑像素，0 = 自动根据内容自适应）。
    public int LabelWidth;
    // 没有属性时显示的文本（"" 不画）。
    public string Empty;
    // 某一行被用户改动后触发（读 ChangedKey 得知是哪一个）。
    public UiEvent Change;
    // 某一行即将被用户改动前触发（写前会话钩子，传 key；用于撤销栈捕获修改前快照）。
    public Action<string> BeforeChange;
    // 最近被用户改动的行号（-1 = 尚无改动；Rebuild 后复位）。
    private int hitRow;
    // 已折叠的分组标题集合（支持一键折叠收起不常用大类）。
    private List<string> collapsedSections;

    // 构造空属性表：未绑定任何行，空态文本为 ""（不画）。
    public PropertyGrid() {
        this.InitControl("props", 5);
        data = new List<PropSpec>();
        rows = new List<PropertyGridRow>();
        key = "";
        Empty = "";
        hitRow = 0 - 1;
        collapsedSections = new List<string>();
        wiresOwnEvents = true;
        Change = new UiEvent();
    }

    public bool IsSectionCollapsed(string sec) {
        if (sec == null || collapsedSections == null) { return false; }
        for (int i = 0; i < collapsedSections.Count; i = i + 1) {
            if (collapsedSections[i] == sec) { return true; }
        }
        return false;
    }

    public void ToggleSection(string sec) {
        if (sec == null) { return; }
        if (collapsedSections == null) { collapsedSections = new List<string>(); }
        for (int i = 0; i < collapsedSections.Count; i = i + 1) {
            if (collapsedSections[i] == sec) {
                collapsedSections.RemoveAt(i);
                this.RefreshRows();
                return;
            }
        }
        collapsedSections.Add(sec);
        this.RefreshRows();
    }

    private void RefreshRows() {
        App app = this.App;
        if (app == null) { return; }
        this.Arrange(bx,by,bw,bh);
        app.RequestRedraw();
    }

    // 控件类型标识（"PropertyGrid"）。
    public override string Kind() { return "PropertyGrid"; }

    // 订阅属性改动事件（回调里读 ChangedKey/ChangedRow）。
    public PropertyGrid OnChange(Action a) {
        Change.Add(a);
        return this;
    }

    // 设置属性写前钩子（在 p.Write 之前触发，传递属性 key，供宿主保存快照到撤销栈）。
    public PropertyGrid OnBeforeChange(Action<string> a) {
        this.BeforeChange = a;
        return this;
    }

    // 最近被用户改动的行号 / 属性键。
    public int ChangedRow() { return hitRow; }
    // 最近被用户改动的属性键（无效时为 ""）。
    public string ChangedKey() {
        if (hitRow < 0 || hitRow >= data.Count) { return ""; }
        return data[hitRow].key;
    }

    // 按属性键获取当前编辑器的值
    public string Value(string k) {
        for (int i = 0; i < data.Count; i = i + 1) {
            if (data[i].key == k) {
                return this.Editor(i);
            }
        }
        return "";
    }

    // 按属性键获取整数值
    public int GetInt(string k, int defVal) {
        string s = this.Value(k);
        if (PropertyGrid.IsNumber(s)) { return Convert.ToInt32(s); }
        return defVal;
    }

    // 绑定一组属性。`k` 标识当前对象（如 "Field:btn0"）：它变化时
    // 才重建编辑器，否则沿用现有的，输入焦点和光标不会每帧丢失。
    public void Bind(string k, List<PropSpec> specs) {
        if (k == key && this.SameSchema(specs)) {
            data = specs;
            this.ReloadExternal();
            this.PrepareRows();
            return;
        }
        key = k;
        data = specs;
        this.Rebuild();
    }

    // 强制丢弃现有编辑器并按当前 specs 重建（切对象后 Bind 会自动调）。
    public void Rebuild() {
        bindingEpoch = bindingEpoch + 1;
        int ticket = bindingEpoch;
        App expectedApp = this.App;
        Control expectedRoot = expectedApp != null ? expectedApp.rootControl : null;
        List<PropSpec> expectedData = data;
        List<PropertyGridRow> previous = rows;
        rows = new List<PropertyGridRow>();
        hitRow = 0 - 1;
        for (int i = 0; i < previous.Count; i = i + 1) {
            // Reentrant binding owns a different row list. Finish retiring this
            // snapshot so its remaining old roots never survive beside new rows.
            this.RetireRow(previous[i]);
        }
        if (!this.LayoutCurrent(expectedApp,expectedRoot,ticket,expectedData)) { return; }
        for (int i = 0; i < data.Count; i = i + 1) {
            PropSpec prop = data[i];
            PropertyGridRow row = new PropertyGridRow();
            row.index = i;
            row.schema = this.SchemaOf(prop);
            string value = prop.Read();
            if (!this.LayoutCurrent(expectedApp,expectedRoot,ticket,expectedData)) { return; }
            row.shadow = value;
            row.root = new Control("property-row-" + Convert.ToString(i));
            row.root.Tip = prop.tip;
            row.label = new Label(prop.label);
            row.reset = new Button { Icon = "refresh", Class = "tiny" };
            row.minus = new Button("-").Small();
            row.plus = new Button("+").Small();
            row.group = new Button(prop.label).Small();
            if (prop.kind == 5) { row.root.Add(row.group); }
            else {
                row.root.Add(row.label);
                if (prop.kind == 2) {
                    row.flag = new Switch(); row.flag.Size = "small";
                    row.flag.SetOn(PropSpec.IsOn(row.shadow)); row.root.Add(row.flag);
                } else if (prop.kind == 3) {
                    row.pick = SelectBox.FromOptions(prop.options, "");
                    row.pick.SetIndex(this.IndexOfValue(prop,row.shadow));
                    for (int option = 0; option < prop.options.Count; option = option + 1) {
                        row.segments.Add(new Button(prop.options[option]).Small());
                    }
                } else {
                    row.text = new Input(""); row.text.SetText(row.shadow); row.root.Add(row.text);
                }
            }
            rows.Add(row);
        }
        this.RefreshRows();
    }

    // 枚举值（可能存的是序号，也可能是选项文本）对应的选项下标。
    private int IndexOfValue(PropSpec p, string val) {
        for (int i = 0; i < p.options.Count; i = i + 1) {
            if (p.options[i] == val) { return i; }
        }
        if (PropertyGrid.IsNumber(val)) {
            int n = Convert.ToInt32(val);
            if (n >= 0 && n < p.options.Count) { return n; }
        }
        return 0;
    }

    // 枚举行当前选择在模型里的字符串形式：绑定到 int 的存序号，
    // 绑定到字符串的存选项文本。
    private string PickValue(PropSpec p, int idx) {
        if (p.num != null || p.snum != null) { return Convert.ToString(idx); }
        if (idx >= 0 && idx < p.options.Count) { return p.options[idx]; }
        return "";
    }

    // 整数属性编辑器判可解析（允许前导 -）。
    private static bool IsNumber(string s) {
        if (s == null || s.Length == 0) { return false; }
        int len = s.Length;
        int i = 0;
        if ((s[0] & 255) == 45) {
            if (len == 1) { return false; }
            i = 1;
        }
        for (; i < len; i = i + 1) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { return false; }
        }
        return true;
    }

    // 编辑器当前值的字符串形式（与 PropSpec.Read 同一种表示）。
    private string Editor(int i) {
        PropSpec p = data[i];
        PropertyGridRow r = rows[i];
        if (p.kind == 2) { return r.flag.IsOn() ? "true" : "false"; }
        if (p.kind == 3) { return this.PickValue(p, r.pick.Value()); }
        return r.text.GetText();
    }

    // 把模型值灌回编辑器（外部改了属性时）。
    private void Load(int i, string val) {
        PropSpec p = data[i];
        PropertyGridRow r = rows[i];
        if (p.kind == 2) { r.flag.SetOn(PropSpec.IsOn(val)); return; }
        if (p.kind == 3) { r.pick.SetIndex(this.IndexOfValue(p, val)); return; }
        r.text.SetText(val);
    }

    // 整数属性的 -/+ 步进：按 spec 配置的步长增减、钳制到范围，
    // 直接写回模型与编辑器，并立即请求重绘，预览同帧跟新。
    private void Step(App app, int i, int delta) {
        List<PropSpec> specs=data;
        PropSpec p=specs[i];
        if (!p.IsBound()) { return; }
        PropertyGridRow row=rows[i];
        int binding=bindingEpoch;int epoch=row.epoch;
        Control root=app!=null?app.rootControl:null;
        string readVal=p.Read();
        if (!this.CanCommitRow(row,binding,epoch,app,root,specs,p)) { return; }
        int cur=PropertyGrid.IsNumber(readVal)?Convert.ToInt32(readVal):0;
        string value=Convert.ToString(p.Clamp(cur+delta));
        if (BeforeChange!=null) { BeforeChange(p.key); }
        if (!this.CanCommitRow(row,binding,epoch,app,root,specs,p)) { return; }
        p.Write(value);
        if (!this.CanCommitRow(row,binding,epoch,app,root,specs,p)) { return; }
        string normalized=p.Read();
        if (!this.CanCommitRow(row,binding,epoch,app,root,specs,p)) { return; }
        row.text.SetText(value);
        if (!this.CanCommitRow(row,binding,epoch,app,root,specs,p)) { return; }
        row.shadow=normalized;
        hitRow=i;Change.PostS(this);
        if (app!=null) { app.RequestRedraw();this.PrepareRows(); }
    }

    // 该行是否需要"恢复默认值"入口（当前值与声明的默认值不同）。
    public bool RowNeedsReset(int i) {
        if (i < 0 || i >= data.Count) { return false; }
        PropSpec p = data[i];
        if (!p.hasDef) { return false; }
        return p.Read() != p.defVal;
    }

    // 把第 i 行复位到默认值（VS 的"恢复默认值"）：写回模型、
    // 同步编辑器、广播改动（经 BeforeChange 走撤销栈钩子）。
    public void ResetToDefault(int i) {
        if (i<0||i>=data.Count||i>=rows.Count) { return; }
        List<PropSpec> specs=data;
        PropSpec p=specs[i];
        if (!p.hasDef||!p.IsBound()) { return; }
        PropertyGridRow row=rows[i];
        int binding=bindingEpoch;int epoch=row.epoch;
        App app=this.App;
        Control root=app!=null?app.rootControl:null;
        if (BeforeChange!=null) { BeforeChange(p.key); }
        if (!this.CanCommitRow(row,binding,epoch,app,root,specs,p)) { return; }
        p.Write(p.defVal);
        if (!this.CanCommitRow(row,binding,epoch,app,root,specs,p)) { return; }
        string normalized=p.Read();
        if (!this.CanCommitRow(row,binding,epoch,app,root,specs,p)) { return; }
        this.Load(i,p.defVal);
        if (!this.CanCommitRow(row,binding,epoch,app,root,specs,p)) { return; }
        row.shadow=normalized;
        hitRow=i;Change.PostS(this);
        if (app!=null) { app.RequestRedraw();this.PrepareRows(); }
    }

    // 单行高度（逻辑像素，绘制时按 DPI 缩放）。
    public int RowHeight() { return this.RowHeight(this.App); }
    public int RowHeight(App app) {
        app = this.ResolveApp(app);
        return app != null ? app.Scale(32) : 32;
    }

    // 全部行的高度（宿主据此在自己的滚动区里给出槽位，折叠分组下的项不占高，等分配对半行合并计算）。
    public int ContentHeight() { return this.ContentHeight(this.App); }
    public int ContentHeight(App app) {
        app = this.ResolveApp(app);
        int rowH = this.RowHeight(app);
        int totalH = 0;
        string curSec = "";
        bool curCollapsed = false;
        for (int i = 0; i < data.Count; i = i + 1) {
            PropSpec p = data[i];
            if (p.kind == 5) {
                curSec = p.label;
                curCollapsed = this.IsSectionCollapsed(curSec);
                totalH = totalH + rowH;
            } else {
                if (!curCollapsed) {
                    totalH = totalH + rowH;
                    if (p.halfRow && (i + 1 < data.Count) && data[i + 1].halfRow && data[i + 1].kind != 5) {
                        i = i + 1;
                    }
                }
            }
        }
        return totalH;
    }

    public override void OnMeasure(App app) { prefH = this.ContentHeight(app); }

    // Scratch implementation fragment: not applied or compiled.
    public override StyleBox ResolveStyle(App app, int state) {
        StyleBox box = base.ResolveStyle(app, state);
        if (box.overflowCss == 0 - 1) { box.overflowY = 2; box.overflow = 1; }
        return box;
    }

    private string SchemaOf(PropSpec p) {
        string result = Convert.ToString(p.key.Length) + ":" + p.key
            + "|" + Convert.ToString(p.alias.Length) + ":" + p.alias
            + "|" + Convert.ToString(p.defaultBinding)
            + "|" + Convert.ToString(p.label.Length) + ":" + p.label
            + "|" + Convert.ToString(p.tip.Length) + ":" + p.tip
            + "|" + Convert.ToString(p.defVal.Length) + ":" + p.defVal
            + "|" + Convert.ToString(p.kind) + "|" + Convert.ToString(p.halfRow) + "|" + Convert.ToString(p.ValueKind())
            + "|" + Convert.ToString(p.step) + "|" + Convert.ToString(p.lo) + "|" + Convert.ToString(p.hi)
            + "|" + Convert.ToString(p.hasRange) + "|" + Convert.ToString(p.hasDef)
            + "|" + Convert.ToString(p.syncName) + "|" + Convert.ToString(p.IsBound());
        for (int i = 0; i < p.options.Count; i = i + 1) {
            // Length prefix keeps literal separators in option labels unambiguous.
            result = result + "|" + Convert.ToString(p.options[i].Length) + ":" + p.options[i];
        }
        return result;
    }

    private bool SameSchema(List<PropSpec> specs) {
        if (specs == null || rows.Count != specs.Count) { return false; }
        for (int i = 0; i < specs.Count; i = i + 1) {
            if (rows[i].schema != this.SchemaOf(specs[i])) { return false; }
        }
        return true;
    }

    private bool CurrentRow(PropertyGridRow row, int binding, int epoch) {
        return row != null && bindingEpoch == binding && row.epoch == epoch
            && row.index >= 0 && row.index < rows.Count && rows[row.index] == row;
    }

    // Layout snapshots include host/root/spec-list identity: same-schema Bind
    // and cross-App adoption need not advance bindingEpoch.
    private bool LayoutCurrent(App app, Control root, int binding, List<PropSpec> specs) {
        return this.App == app && (app == null || app.rootControl == root)
            && bindingEpoch == binding && data == specs;
    }

    private bool LayoutRow(App app, Control root, int binding, List<PropSpec> specs, PropertyGridRow row, int epoch) {
        return this.LayoutCurrent(app,root,binding,specs) && this.CurrentRow(row,binding,epoch)
            && row.root.parent == this && row.root.App == app;
    }

    // Public Reset may run off-tree, but every callback must preserve the
    // exact model, host/root and row from the start of this operation.
    private bool CanCommitRow(PropertyGridRow row, int binding, int epoch, App expectedApp, Control expectedRoot, List<PropSpec> specs, PropSpec prop) {
        if (!this.LayoutCurrent(expectedApp,expectedRoot,binding,specs)
            || !this.CurrentRow(row,binding,epoch) || row.index >= specs.Count || specs[row.index] != prop) { return false; }
        if (expectedRoot == null || !expectedRoot.ContainsInputControl(this)) { return true; }
        return row.root.parent == this && row.root.App == expectedApp
            && this.StyleVisible() && !this.IsDisabled();
    }

    private void CloseRowPicker(PropertyGridRow row) {
        App app = this.App;
        if (row.pick == null || app == null || app.overlayHost == null) { return; }
        if (app.overlayHost.IsAnchorActive(row.pick)) {
            Control popup = app.overlayHost.ActiveRoot();
            if (popup != null) { app.overlayHost.Hide(popup); }
        }
    }

    private void RetireRow(PropertyGridRow row) {
        if (row == null || row.root == null || row.root.parent != this) { return; }
        App app=this.App;
        Control root=app!=null?app.rootControl:null;
        List<PropSpec> specs=data;
        int binding=bindingEpoch;
        Control rowRoot=row.root;
        int epoch=row.epoch;
        this.CloseRowPicker(row);
        // Scroll retirement may synchronously move/rebind this same row during
        // popup Cancel. Only the original session may remove its root.
        if (!this.LayoutCurrent(app,root,binding,specs) || row.epoch!=epoch
            || row.root!=rowRoot || rowRoot.App!=app || rowRoot.parent!=this) { return; }
        row.epoch=row.epoch+1;
        this.Remove(rowRoot);
    }

    private void WireRow(PropertyGridRow row) {
        row.epoch = row.epoch + 1;
        if (row.text != null) {
            row.text.Change.Clear();
            row.text.Change.Add(new PropertyGridAction(this,row,bindingEpoch,row.epoch,0,0).Invoke);
        }
        if (row.flag != null) {
            row.flag.Change.Clear();
            row.flag.Change.Add(new PropertyGridAction(this,row,bindingEpoch,row.epoch,0,0).Invoke);
        }
        if (row.pick != null) {
            row.pick.Change.Clear();
            row.pick.Change.Add(new PropertyGridAction(this,row,bindingEpoch,row.epoch,0,0).Invoke);
        }
        row.reset.Click.Clear();
        row.reset.Click.Add(new PropertyGridAction(this,row,bindingEpoch,row.epoch,1,0).Invoke);
        row.minus.Click.Clear();
        row.minus.Click.Add(new PropertyGridAction(this,row,bindingEpoch,row.epoch,2,-1).Invoke);
        row.plus.Click.Clear();
        row.plus.Click.Add(new PropertyGridAction(this,row,bindingEpoch,row.epoch,2,1).Invoke);
        row.group.Click.Clear();
        row.group.Click.Add(new PropertyGridAction(this,row,bindingEpoch,row.epoch,3,0).Invoke);
        for (int i = 0; i < row.segments.Count; i = i + 1) {
            row.segments[i].Click.Clear();
            row.segments[i].Click.Add(new PropertyGridAction(this,row,bindingEpoch,row.epoch,4,i).Invoke);
        }
    }

    public void ApplyRowAction(PropertyGridRow row, int binding, int epoch, int action, int argument) {
        if (!this.CurrentRow(row,binding,epoch) || row.root.parent != this || this.IsDisabled() || !this.StyleVisible()) { return; }
        App app = this.App;
        if (app == null) { return; }
        Control root = app.rootControl;
        if (root == null || !root.ContainsInputControl(this)) { return; }
        int index = row.index;
        PropSpec prop = data[index];
        if (action == 3) { this.ToggleSection(prop.label); return; }
        if (!prop.IsBound()) { return; }
        if (action == 1) { this.ResetToDefault(index); return; }
        if (action == 2) { this.Step(app,index,argument * prop.step); return; }
        if (action == 4) {
            if (argument == row.pick.Value()) { return; }
            row.pick.SetIndex(argument);
        }
        this.SubmitRow(app,index,binding,epoch);
    }

    private void ReloadExternal() {
        App app=this.App;
        Control root=app!=null?app.rootControl:null;
        int ticket=bindingEpoch;
        List<PropSpec> specs=data;
        for (int i=0;i<specs.Count&&i<rows.Count;i=i+1) {
            PropSpec prop=specs[i];
            PropertyGridRow row=rows[i];
            int epoch=row.epoch;
            if (prop.kind==5||!prop.IsBound()) { continue; }
            string current=prop.Read();
            if (!this.LayoutCurrent(app,root,ticket,specs)||!this.CurrentRow(row,ticket,epoch)) { return; }
            if (current!=row.shadow) {
                this.Load(i,current);
                if (!this.LayoutCurrent(app,root,ticket,specs)||!this.CurrentRow(row,ticket,epoch)) { return; }
                row.shadow=current;
            }
        }
    }

    private void SubmitRow(App app, int index, int binding, int epoch) {
        List<PropSpec> specs=data;
        PropSpec prop=specs[index];
        PropertyGridRow row=rows[index];
        Control root=app.rootControl;
        string current=prop.Read();
        if (!this.CanCommitRow(row,binding,epoch,app,root,specs,prop)) { return; }
        // External update wins without a new user notification.
        if (current!=row.shadow) {
            this.Load(index,current);
            if (!this.CanCommitRow(row,binding,epoch,app,root,specs,prop)) { return; }
            row.shadow=current;return;
        }
        string value=this.Editor(index);
        if (value==current || (prop.kind==1&&!PropertyGrid.IsNumber(value))) { return; }
        if (BeforeChange!=null) { BeforeChange(prop.key); }
        if (!this.CanCommitRow(row,binding,epoch,app,root,specs,prop)) { return; }
        prop.Write(value);
        if (!this.CanCommitRow(row,binding,epoch,app,root,specs,prop)) { return; }
        string normalized=prop.Read();
        if (!this.CanCommitRow(row,binding,epoch,app,root,specs,prop)) { return; }
        if (prop.kind==4) {
            this.Load(index,normalized);
            if (!this.CanCommitRow(row,binding,epoch,app,root,specs,prop)) { return; }
        }
        row.shadow=normalized;
        hitRow=index;
        Change.PostS(this);
        app.RequestRedraw();this.PrepareRows();
    }

    public override void OnScrollChanged() { this.PrepareRows(); }

    public override void Arrange(int x, int y, int w, int h) {
        bx=x; by=y; bw=w>0?w:0; bh=h>0?h:0;
        App app=this.App;
        Control root=app!=null?app.rootControl:null;
        int ticket=bindingEpoch;
        List<PropSpec> specs=data;
        this.ReloadExternal();
        if (!this.LayoutCurrent(app,root,ticket,specs)) { return; }
        Rect view = this.ScrollViewport();
        scrollExtent = this.ContentHeight(this.App);
        scrollExtentX = view.width;
        int maximum = scrollExtent-view.height;
        if (maximum<0) { maximum=0; }
        int next=this.ScrollTop();
        if (next>maximum) { next=maximum; }
        if (next<0) { next=0; }
        this.SetScrollTop(next);
        if (!this.LayoutCurrent(app,root,ticket,specs)) { return; }
        this.PrepareRows();
    }

    private void AdoptPart(PropertyGridRow row, Control part, bool wanted, App app, Control root, int ticket, List<PropSpec> specs, int epoch) {
        if (part == null) { return; }
        if (wanted && part.parent != row.root) { row.root.Add(part); }
        else if (!wanted && part.parent == row.root) {
            if (part == row.pick) { this.CloseRowPicker(row); }
            if (!this.LayoutRow(app,root,ticket,specs,row,epoch)) { return; }
            if (part.parent == row.root) { row.root.Remove(part); }
        }
    }

    private void ArrangeField(PropertyGridRow row, int x, int y, int w, int h, int labelW, App app, Control root, int ticket, List<PropSpec> specs, int epoch) {
        PropSpec prop=data[row.index];
        int editorH=app.Scale(24);
        int editorY=y+(h-editorH)/2;
        int editorX=x+labelW;
        int editorW=w-labelW;
        bool reset=this.RowNeedsReset(row.index); if (!this.LayoutRow(app,root,ticket,specs,row,epoch)) { return; }
        int resetW=app.Scale(18);
        row.label.Text=prop.label;
        row.label.Tip=prop.tip;
        row.label.MeasureTree(app); if (!this.LayoutRow(app,root,ticket,specs,row,epoch)) { return; }
        row.label.Arrange(x,y,labelW-(reset?resetW:0)-app.Scale(4),h); if (!this.LayoutRow(app,root,ticket,specs,row,epoch)) { return; }
        this.AdoptPart(row,row.reset,reset,app,root,ticket,specs,epoch); if (!this.LayoutRow(app,root,ticket,specs,row,epoch)) { return; }
        if (reset) { row.reset.MeasureTree(app); if (!this.LayoutRow(app,root,ticket,specs,row,epoch)) { return; } row.reset.Arrange(x+labelW-resetW-app.Scale(2),editorY,resetW,editorH); if (!this.LayoutRow(app,root,ticket,specs,row,epoch)) { return; } }
        if (prop.kind==2) {
            row.flag.MeasureTree(app); if (!this.LayoutRow(app,root,ticket,specs,row,epoch)) { return; }
            row.flag.Arrange(editorX,y+(h-app.Scale(18))/2,row.flag.prefW>0?row.flag.prefW:app.Scale(36),app.Scale(18)); if (!this.LayoutRow(app,root,ticket,specs,row,epoch)) { return; }
        } else if (prop.kind==3) {
            int count=prop.options.Count;
            bool segmented=count>=2&&count<=4&&!prop.halfRow;
            int partW=count>0?editorW/count:0;
            int font=Style.FontFallback(app,"small");
            for (int i=0;i<count&&segmented;i=i+1) {
                if (Canvas.MeasureText(prop.options[i],font)+app.Scale(16)>partW || partW<app.Scale(24)) { segmented=false; }
            }
            this.AdoptPart(row,row.pick,!segmented,app,root,ticket,specs,epoch); if (!this.LayoutRow(app,root,ticket,specs,row,epoch)) { return; }
            for (int i=0;i<row.segments.Count;i=i+1) {
                Button button=row.segments[i];
                this.AdoptPart(row,button,segmented,app,root,ticket,specs,epoch); if (!this.LayoutRow(app,root,ticket,specs,row,epoch)) { return; }
                if (segmented) {
                    button.Checked=i==row.pick.Value();
                    button.MeasureTree(app); if (!this.LayoutRow(app,root,ticket,specs,row,epoch)) { return; }
                    button.Arrange(editorX+i*partW,editorY,i==count-1?editorW-i*partW:partW,editorH); if (!this.LayoutRow(app,root,ticket,specs,row,epoch)) { return; }
                }
            }
            if (!segmented) { row.pick.MeasureTree(app); if (!this.LayoutRow(app,root,ticket,specs,row,epoch)) { return; } row.pick.Arrange(editorX,editorY,editorW,editorH); if (!this.LayoutRow(app,root,ticket,specs,row,epoch)) { return; } }
        } else {
            int gap=app.Scale(4);
            bool step=prop.kind==1&&editorW>=(editorH+gap)*2+app.Scale(32);
            this.AdoptPart(row,row.minus,step,app,root,ticket,specs,epoch); if (!this.LayoutRow(app,root,ticket,specs,row,epoch)) { return; } this.AdoptPart(row,row.plus,step,app,root,ticket,specs,epoch); if (!this.LayoutRow(app,root,ticket,specs,row,epoch)) { return; }
            int textX=editorX; int textW=editorW;
            if (step) {
                row.minus.MeasureTree(app); if (!this.LayoutRow(app,root,ticket,specs,row,epoch)) { return; } row.plus.MeasureTree(app); if (!this.LayoutRow(app,root,ticket,specs,row,epoch)) { return; }
                row.minus.Arrange(editorX,editorY,editorH,editorH); if (!this.LayoutRow(app,root,ticket,specs,row,epoch)) { return; }
                row.plus.Arrange(editorX+editorW-editorH,editorY,editorH,editorH); if (!this.LayoutRow(app,root,ticket,specs,row,epoch)) { return; }
                textX=textX+editorH+gap; textW=textW-(editorH+gap)*2;
            }
            row.text.MeasureTree(app); if (!this.LayoutRow(app,root,ticket,specs,row,epoch)) { return; } row.text.Arrange(textX,editorY,textW>0?textW:0,editorH); if (!this.LayoutRow(app,root,ticket,specs,row,epoch)) { return; }
        }
    }

    private void PrepareRows() {
        App app=this.App;
        if (app==null||preparingRows) { return; }
        preparingRows=true;
        int ticket=bindingEpoch;
        Control root=app.rootControl;
        List<PropSpec> specs=data;
        try {
            Rect view=this.ScrollViewport();
            int rowH=this.RowHeight(app);
            int rowW=view.width-(scrollExtent>view.height?app.Scale(6):0);
            int font=Style.FontFallback(app,"small");
            int labelW=LabelWidth>0?app.Scale(LabelWidth):app.Scale(110);
            if (LabelWidth<=0) {
                for (int i=0;i<data.Count;i=i+1) {
                    int need=Canvas.MeasureText(data[i].label,font)+app.theme.gapSmall*2;
                    if (need>labelW) { labelW=need; }
                }
                if (labelW>rowW*52/100) { labelW=rowW*52/100; }
            }
            if (rowW-labelW<app.Scale(60)) { labelW=rowW-app.Scale(60); }
            if (labelW<app.Scale(40)) { labelW=app.Scale(40); }
            int y=view.y-this.ScrollTop();
            bool collapsed=false;
            for (int i=0;i<data.Count&&i<rows.Count;i=i+1) {
                PropSpec prop=data[i];
                if (prop.kind==5) { collapsed=this.IsSectionCollapsed(prop.label); }
                bool visible=(prop.kind==5||!collapsed)&&y+rowH>view.y&&y<view.y+view.height&&this.StyleVisible();
                bool pair=prop.kind!=5&&prop.halfRow&&i+1<data.Count&&data[i+1].halfRow&&data[i+1].kind!=5;
                int cells=pair?2:1;
                for (int column=0;column<cells;column=column+1) {
                    PropertyGridRow row=rows[i+column];
                    if (!visible) { this.RetireRow(row); }
                    else {
                        bool attach=row.root.parent!=this;
                        if (attach) { this.WireRow(row); }
                        int epoch=row.epoch;
                        if (attach) { this.Add(row.root); }
                        if (!this.LayoutCurrent(app,root,ticket,specs)) { return; }
                        if (!this.LayoutRow(app,root,ticket,specs,row,epoch)) { return; }
                        int gap=pair?app.Scale(6):0;
                        int cellW=pair?(rowW-gap)/2:rowW;
                        int cellX=view.x+column*(cellW+gap);
                        row.root.Arrange(cellX,y,cellW,rowH);
                        if (!this.LayoutRow(app,root,ticket,specs,row,epoch)) { return; }
                        if (prop.kind==5) {
                            row.group.Text=prop.label;
                            row.group.Icon=collapsed?"chevron-right":"chevron-down";
                            row.group.MeasureTree(app);
                            if (!this.LayoutRow(app,root,ticket,specs,row,epoch)) { return; }
                            row.group.Arrange(cellX,y+(rowH-app.Scale(24))/2,cellW,app.Scale(24));
                        } else {
                            int cellLabel=labelW;
                            if (pair) {
                                cellLabel=Canvas.MeasureText(data[i+column].label,font)+app.Scale(6);
                                if (cellLabel>cellW*45/100) { cellLabel=cellW*45/100; }
                                if (cellLabel<app.Scale(20)) { cellLabel=app.Scale(20); }
                            }
                            this.ArrangeField(row,cellX,y,cellW,rowH,cellLabel,app,root,ticket,specs,epoch);
                        }
                        if (!this.LayoutRow(app,root,ticket,specs,row,epoch)) { return; }
                    }
                    if (!this.LayoutCurrent(app,root,ticket,specs)) { return; }
                }
                if (prop.kind==5||!collapsed) { y=y+rowH; }
                if (pair) { i=i+1; }
            }
        } finally {
            preparingRows=false;
            if (this.App==app&&app.rootControl==root&&(bindingEpoch!=ticket||data!=specs)) { this.RefreshRows(); }
        }
    }

    public override void OnPaint(App app) {
        if (data.Count==0 && Empty!="") {
            StyleBox empty=this.ResolvePartAs(app,"propertygrid","empty","","",Style.SNormal());
            int font=Style.FontFallback(app,"small");
            app.canvas.DrawText(bx,by+app.theme.paddingSmall,Ellipsis.Fit(Empty,bw,font),empty.FgOr(0),font);
        }
    }

    // 控件事件清单：公共事件之外提供 "Change"。
    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        return e;
    }

    // 绑定事件："Change" 接 UiEvent，其余按名称走通用路由。
    public override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        On.AddByName(evt, a);
    }

    // <see cref="BindEvent"/> 的 sender 通道（S = Sender）：
    // 特化事件接本控件的 UiEvent，通用事件按名路由。
    public override void BindEventS(string evt, ControlEvent a) {
        if (evt == "Change") { Change.AddS(a); return; }
        On.AddByNameS(evt, a);
    }

}
