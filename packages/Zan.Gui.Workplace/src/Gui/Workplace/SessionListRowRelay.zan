namespace Gui.Component;

public class SessionListRowRelay {
    private weak SessionListRow row;
    private int generation;
    public SessionListRowRelay(SessionListRow row, int generation) {
        this.row = row; this.generation = generation;
    }
    public void Select() { if (row != null && row.InputCurrent(generation)) { row.Select(); } }
    public void Edit() { if (row != null && row.InputCurrent(generation)) { row.Edit(); } }
    public void Archive() { if (row != null && row.InputCurrent(generation)) { row.Archive(); } }
    public void Delete() { if (row != null && row.InputCurrent(generation)) { row.Delete(); } }
    public void Submit() { if (row != null && row.InputCurrent(generation)) { row.Submit(); } }
}
