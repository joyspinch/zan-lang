using Gui.Widget;

namespace Gui.Component;

// Visible bubble avatars are retained children; the message index follows the
// prepared slot so input uses the same geometry as the normal child traversal.
class ChatBubbleAvatar : Avatar {
    // 按父类种类上报：序列化与自动化以 "Avatar" 识别本控件。
    public override string Kind() { return "Avatar"; }
    public int messageIndex;

    public ChatBubbleAvatar() : base("", 34) { }
}
