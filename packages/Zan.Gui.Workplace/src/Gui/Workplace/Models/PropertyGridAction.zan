using System;
using Gui;

namespace Gui.Component;

// Each editor owns a token which borrows its grid and row. Retirement invalidates
// the row epoch; rebuilding also changes the binding epoch.
public class PropertyGridAction {
    weak PropertyGrid owner;
    weak PropertyGridRow row;
    int bindingEpoch;
    int rowEpoch;
    int kind;
    int value;
    public PropertyGridAction(PropertyGrid grid, PropertyGridRow record, int binding, int epoch, int action, int argument) {
        owner = grid; row = record; bindingEpoch = binding; rowEpoch = epoch; kind = action; value = argument;
    }
    public void Invoke() {
        PropertyGrid grid = owner;
        PropertyGridRow record = row;
        if (grid != null && record != null) { grid.ApplyRowAction(record, bindingEpoch, rowEpoch, kind, value); }
    }
}
