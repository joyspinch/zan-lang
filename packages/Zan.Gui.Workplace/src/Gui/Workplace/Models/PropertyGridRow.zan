using System;
using Gui;
using Gui.Widget;

namespace Gui.Component;

// PropertyGrid 属性行编辑器强类型实体（消除平行列表索引对齐反模式）。
public class PropertyGridRow {
    public Input text;
    public Switch flag;
    public SelectBox pick;
    public int index;
    public int epoch;
    public string schema;
    public Control root;
    public Label label;
    public Button reset;
    public Button minus;
    public Button plus;
    public Button group;
    public List<Button> segments;
    public string shadow;

    public PropertyGridRow() {
        this.text = null;
        this.flag = null;
        this.pick = null;
        this.index = 0 - 1;
        this.epoch = 0;
        this.schema = "";
        this.segments = new List<Button>();
        this.shadow = "";
    }
}
