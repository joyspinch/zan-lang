using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Component;

public class ChatStrings {
    public string you;
    public string assistant;
    public string tool;
    public string error;
    public string thinkShow;
    public string thinkHide;
    public string codeMorePre;
    public string codeMorePost;
    public string codeCollapse;
    public string busy;
    public string empty;

    // 英文默认文案；宿主按需覆盖字段即可。
    public static ChatStrings Default() {
        ChatStrings s = new ChatStrings();
        s.you = "You";
        s.assistant = "Assistant";
        s.tool = "Tool";
        s.error = "Error";
        s.thinkShow = "Thinking (click to show)";
        s.thinkHide = "Thinking (click to hide)";
        s.codeMorePre = "show ";
        s.codeMorePost = " more code lines";
        s.codeCollapse = "collapse code";
        s.busy = "Thinking...";
        s.empty = "";
        return s;
    }
}
