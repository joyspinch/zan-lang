using System;
using System.Collections.Generic;
using System.Json;
using System.Text;

namespace Ai.Tensor;

// safetensors 权重文件读取（HuggingFace 的格式）。
//
// 布局：8 字节小端头长 (u64) · JSON 头（该长度字节，末尾可能用空格补齐）
//       · 数据区（各张量按 data_offsets 摆放，偏移相对数据区起点）。
//
// JSON 头形如：
//   {"weight": {"dtype":"F16","shape":[2,3],"data_offsets":[0,12]},
//    "__metadata__": {"format":"pt"}}
//
// 与 GGUF 不同：这里没有"量化类型"，dtype 是字符串。张量维度是**行主序**
// 的常规顺序（与 GGUF 相同），不需要转置。
public class SafeTensorsReader {
    public Dictionary<string, string> metadata;
    public Dictionary<string, List<string>> metadataArrays;
    public List<WeightTensorInfo> tensors;
    // 数据区起点（文件内绝对偏移）。
    public long dataStart;
    public long dataLength;

    public static SafeTensorsReader Parse(byte[] file) {
        if (file.Length < 8) {
            throw new Exception("safetensors file too short");
        }
        BinaryReader r = new BinaryReader(file);
        long headerLen = r.U64();
        if (headerLen <= 0 || headerLen > file.Length - 8) {
            throw new Exception("safetensors header length out of range: " + Convert.ToString(headerLen));
        }
        string headerText = Encoding.GetString(file, 8, (int)headerLen);
        if (headerText.Length != headerLen || NativeMemory.Compare((nint)file + 8, (nint)headerText, (int)headerLen) != 0) {
            throw new Exception("safetensors header is not valid UTF-8");
        }
        JsonDoc doc = JsonDoc.Parse(headerText);
        if (doc == null || doc.KindAt(doc.root) != 5) {
            throw new Exception("safetensors header is not a JSON object");
        }

        SafeTensorsReader s = new SafeTensorsReader();
        s.metadata = new Dictionary<string, string>();
        s.metadataArrays = new Dictionary<string, List<string>>();
        s.tensors = new List<WeightTensorInfo>();
        s.dataStart = 8 + headerLen;
        s.dataLength = file.Length - s.dataStart;

        HashSet<string> names = new HashSet<string>();
        for (int p = doc.FirstProperty(doc.root); p >= 0; p = doc.NextProperty(p)) {
            string key = doc.PropertyNameView(p).ToString();
            int entrySlot = doc.PropertyValue(p);
            if (names.Contains(key) || doc.KindAt(entrySlot) != 5) {
                throw new Exception("invalid or duplicate safetensors entry '" + key + "'");
            }
            names.Add(key);
            if (key == "__metadata__") {
                for (int mp = doc.FirstProperty(entrySlot); mp >= 0; mp = doc.NextProperty(mp)) {
                    string mKey = doc.PropertyNameView(mp).ToString();
                    int mValue = doc.PropertyValue(mp);
                    if (s.metadata.ContainsKey(mKey) || doc.KindAt(mValue) != 3) {
                        throw new Exception("invalid or duplicate safetensors metadata '" + mKey + "'");
                    }
                    s.metadata[mKey] = doc.StrAt(mValue, "");
                }
            } else {
                s.tensors.Add(s.ReadTensor(key, doc, entrySlot));
            }
        }
        return s;
    }

    WeightTensorInfo ReadTensor(string name, JsonDoc doc, int entrySlot) {
        int dtypeSlot = -1;
        int shapeSlot = -1;
        int offsSlot = -1;
        for (int p = doc.FirstProperty(entrySlot); p >= 0; p = doc.NextProperty(p)) {
            string key = doc.PropertyNameView(p).ToString();
            int value = doc.PropertyValue(p);
            if (key == "dtype" && dtypeSlot < 0) {
                dtypeSlot = value;
            } else if (key == "shape" && shapeSlot < 0) {
                shapeSlot = value;
            } else if (key == "data_offsets" && offsSlot < 0) {
                offsSlot = value;
            } else {
                throw new Exception("unexpected or duplicate field '" + key + "' in safetensors tensor '" + name + "'");
            }
        }
        if (doc.KindAt(dtypeSlot) != 3 || doc.KindAt(shapeSlot) != 4 || doc.KindAt(offsSlot) != 4 || doc.Count(offsSlot) != 2) {
            throw new Exception("safetensors tensor '" + name + "' needs dtype, shape and two data_offsets");
        }
        WeightTensorInfo info = new WeightTensorInfo();
        info.name = name;
        info.dtype = doc.StrAt(dtypeSlot, "");
        info.ggmlType = -1;
        info.shape = new List<int>();
        long count = 1;
        int child = doc.FirstChild(shapeSlot);
        for (int i = 0; i < doc.Count(shapeSlot); i = i + 1) {
            long d = SafeTensorsReader.IntegerAt(doc, child);
            if (d <= 0 || d > 2147483647L || count > 2147483647L / d) {
                throw new Exception("safetensors tensor '" + name + "' has invalid shape");
            }
            info.shape.Add((int)d);
            count = count * d;
            child = doc.NextSibling(child);
        }
        info.count = count;

        int firstOff = doc.FirstChild(offsSlot);
        int secondOff = doc.NextSibling(firstOff);
        long start = SafeTensorsReader.IntegerAt(doc, firstOff);
        long end = SafeTensorsReader.IntegerAt(doc, secondOff);
        if (start < 0 || end < start || end > dataLength) {
            throw new Exception("safetensors tensor '" + name + "' has out-of-range data_offsets");
        }
        info.offset = start;
        info.byteLength = end - start;
        return info;
    }

    private static long IntegerAt(JsonDoc doc, int slot) {
        // KindAt groups integer and floating-point JSON numbers. Geometry and offsets require integers.
        if (slot < 0 || (doc.slots[slot].a & 255L) != 2L) { return -1L; }
        return doc.LongAt(slot, -1L);
    }
}
