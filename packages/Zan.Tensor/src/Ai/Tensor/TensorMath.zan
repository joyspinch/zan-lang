using System;
using System.Collections.Generic;
using System.Numerics;

namespace Ai.Tensor;

// 张量算子（纯静态方法，不原地修改输入，AddInto 除外）。
// 逐元素算子按行主序对齐元素数；归一化/激活沿最后一维执行；矩阵乘优先走 ComputeBackendRegistry。
public class TensorMath {

    // ---- 逐元素 ----

    public static Tensor Add(Tensor a, Tensor b) {
        int n = TensorMath.RequireSameCount(a, b);
        float[] ad = a.data;
        float[] bd = b.data;
        float[] res = new float[n];
        nint ap = (nint)ad;
        nint bp = (nint)bd;
        nint rp = (nint)res;
        int i = 0;
        for (; i + 7 < n; i = i + 8) {
            nint off = (nint)((long)i * 4L);
            Span<float> sa = new Span<float>(ap + off, 8);
            Span<float> sb = new Span<float>(bp + off, 8);
            Span<float> sr = new Span<float>(rp + off, 8);
            sr[0] = sa[0] + sb[0]; sr[1] = sa[1] + sb[1];
            sr[2] = sa[2] + sb[2]; sr[3] = sa[3] + sb[3];
            sr[4] = sa[4] + sb[4]; sr[5] = sa[5] + sb[5];
            sr[6] = sa[6] + sb[6]; sr[7] = sa[7] + sb[7];
        }
        for (; i < n; i = i + 1) { res[i] = ad[i] + bd[i]; }
        return new Tensor(a.Shape(), res);
    }

    public static Tensor Sub(Tensor a, Tensor b) {
        int n = TensorMath.RequireSameCount(a, b);
        float[] ad = a.data;
        float[] bd = b.data;
        float[] res = new float[n];
        nint ap = (nint)ad;
        nint bp = (nint)bd;
        nint rp = (nint)res;
        int i = 0;
        for (; i + 7 < n; i = i + 8) {
            nint off = (nint)((long)i * 4L);
            Span<float> sa = new Span<float>(ap + off, 8);
            Span<float> sb = new Span<float>(bp + off, 8);
            Span<float> sr = new Span<float>(rp + off, 8);
            sr[0] = sa[0] - sb[0]; sr[1] = sa[1] - sb[1];
            sr[2] = sa[2] - sb[2]; sr[3] = sa[3] - sb[3];
            sr[4] = sa[4] - sb[4]; sr[5] = sa[5] - sb[5];
            sr[6] = sa[6] - sb[6]; sr[7] = sa[7] - sb[7];
        }
        for (; i < n; i = i + 1) { res[i] = ad[i] - bd[i]; }
        return new Tensor(a.Shape(), res);
    }

    public static Tensor Mul(Tensor a, Tensor b) {
        int n = TensorMath.RequireSameCount(a, b);
        float[] ad = a.data;
        float[] bd = b.data;
        float[] res = new float[n];
        nint ap = (nint)ad;
        nint bp = (nint)bd;
        nint rp = (nint)res;
        int i = 0;
        for (; i + 7 < n; i = i + 8) {
            nint off = (nint)((long)i * 4L);
            Span<float> sa = new Span<float>(ap + off, 8);
            Span<float> sb = new Span<float>(bp + off, 8);
            Span<float> sr = new Span<float>(rp + off, 8);
            sr[0] = sa[0] * sb[0]; sr[1] = sa[1] * sb[1];
            sr[2] = sa[2] * sb[2]; sr[3] = sa[3] * sb[3];
            sr[4] = sa[4] * sb[4]; sr[5] = sa[5] * sb[5];
            sr[6] = sa[6] * sb[6]; sr[7] = sa[7] * sb[7];
        }
        for (; i < n; i = i + 1) { res[i] = ad[i] * bd[i]; }
        return new Tensor(a.Shape(), res);
    }

    public static Tensor Div(Tensor a, Tensor b) {
        int n = TensorMath.RequireSameCount(a, b);
        float[] ad = a.data;
        float[] bd = b.data;
        float[] res = new float[n];
        nint ap = (nint)ad;
        nint bp = (nint)bd;
        nint rp = (nint)res;
        int i = 0;
        for (; i + 7 < n; i = i + 8) {
            nint off = (nint)((long)i * 4L);
            Span<float> sa = new Span<float>(ap + off, 8);
            Span<float> sb = new Span<float>(bp + off, 8);
            Span<float> sr = new Span<float>(rp + off, 8);
            sr[0] = sa[0] / sb[0]; sr[1] = sa[1] / sb[1];
            sr[2] = sa[2] / sb[2]; sr[3] = sa[3] / sb[3];
            sr[4] = sa[4] / sb[4]; sr[5] = sa[5] / sb[5];
            sr[6] = sa[6] / sb[6]; sr[7] = sa[7] / sb[7];
        }
        for (; i < n; i = i + 1) { res[i] = ad[i] / bd[i]; }
        return new Tensor(a.Shape(), res);
    }

    // 逐元素乘标量。
    public static Tensor Scale(Tensor a, float factor) {
        if (a == null || a.data == null) { throw new ArgumentException("TensorMath.Scale: null tensor"); }
        float[] ad = a.data;
        int n = ad.Length;
        float[] res = new float[n];
        nint ap = (nint)ad;
        nint rp = (nint)res;
        int i = 0;
        for (; i + 7 < n; i = i + 8) {
            nint off = (nint)((long)i * 4L);
            Span<float> sa = new Span<float>(ap + off, 8);
            Span<float> sr = new Span<float>(rp + off, 8);
            sr[0] = sa[0] * factor; sr[1] = sa[1] * factor;
            sr[2] = sa[2] * factor; sr[3] = sa[3] * factor;
            sr[4] = sa[4] * factor; sr[5] = sa[5] * factor;
            sr[6] = sa[6] * factor; sr[7] = sa[7] * factor;
        }
        for (; i < n; i = i + 1) { res[i] = ad[i] * factor; }
        return new Tensor(a.Shape(), res);
    }

    public static Tensor Neg(Tensor a) {
        if (a == null || a.data == null) { throw new ArgumentException("TensorMath.Neg: null tensor"); }
        float[] ad = a.data;
        int n = ad.Length;
        float[] res = new float[n];
        nint ap = (nint)ad;
        nint rp = (nint)res;
        int i = 0;
        for (; i + 7 < n; i = i + 8) {
            nint off = (nint)((long)i * 4L);
            Span<float> sa = new Span<float>(ap + off, 8);
            Span<float> sr = new Span<float>(rp + off, 8);
            sr[0] = -sa[0]; sr[1] = -sa[1];
            sr[2] = -sa[2]; sr[3] = -sa[3];
            sr[4] = -sa[4]; sr[5] = -sa[5];
            sr[6] = -sa[6]; sr[7] = -sa[7];
        }
        for (; i < n; i = i + 1) { res[i] = -ad[i]; }
        return new Tensor(a.Shape(), res);
    }

    // 逐元素夹到 [lo, hi]。
    public static Tensor Clamp(Tensor a, float lo, float hi) {
        if (a == null || a.data == null) { throw new ArgumentException("TensorMath.Clamp: null tensor"); }
        if (lo > hi) { throw new ArgumentException("TensorMath.Clamp: lo > hi"); }
        float[] ad = a.data;
        int n = ad.Length;
        float[] res = new float[n];
        for (int i = 0; i < n; i = i + 1) {
            float v = ad[i];
            if (v < lo) { v = lo; }
            if (v > hi) { v = hi; }
            res[i] = v;
        }
        return new Tensor(a.Shape(), res);
    }

    // 原地累加：dst += src（Transformer 里累加残差用得多，省一次分配）。
    public static void AddInto(Tensor dst, Tensor src) {
        int n = TensorMath.RequireSameCount(dst, src);
        float[] dd = dst.data;
        float[] sd = src.data;
        nint dp = (nint)dd;
        nint sp = (nint)sd;
        int i = 0;
        for (; i + 7 < n; i = i + 8) {
            nint off = (nint)((long)i * 4L);
            Span<float> sdst = new Span<float>(dp + off, 8);
            Span<float> ssrc = new Span<float>(sp + off, 8);
            sdst[0] = sdst[0] + ssrc[0]; sdst[1] = sdst[1] + ssrc[1];
            sdst[2] = sdst[2] + ssrc[2]; sdst[3] = sdst[3] + ssrc[3];
            sdst[4] = sdst[4] + ssrc[4]; sdst[5] = sdst[5] + ssrc[5];
            sdst[6] = sdst[6] + ssrc[6]; sdst[7] = sdst[7] + ssrc[7];
        }
        for (; i < n; i = i + 1) { dd[i] = dd[i] + sd[i]; }
    }

    // ---- 线性代数 ----

    // 矩阵乘：结果[m,n] = a[m,k] · b[k,n]。有加速后端就走后端。
    public static Tensor MatMul(Tensor a, Tensor b) {
        TensorMath.RequireMatrices(a, b);
        IComputeBackend backend = ComputeBackendRegistry.Current();
        if (backend != null && backend.IsAvailable()) {
            List<int> shape = new List<int>();
            shape.Add(a.Dim(0));
            shape.Add(b.Dim(1));
            Tensor res = Tensor.Zeros(shape);
            backend.MatMul(a, b, res);
            return res;
        }
        return TensorMath.MatMulCpu(a, b);
    }

    // CPU 矩阵乘：4×4 寄存器分块微内核 + L1 k-分块（KB=64）+ 定长 Span<float>(ptr, 4) 消边界检查，
    // 16 浮点累加器刚好压进 4 个 SSE/XMM 向量寄存器（零栈溢出），严格保持 p=0..k-1 升序累加顺序。
    public static Tensor MatMulCpu(Tensor a, Tensor b) {
        TensorMath.RequireMatrices(a, b);
        int m = a.Dim(0);
        int k = a.Dim(1);
        int n = b.Dim(1);
        long total = (long)m * (long)n;
        if (total > 2147483647L) {
            throw new ArgumentException("TensorMath.MatMulCpu: output size overflow");
        }
        List<int> shape = new List<int>();
        shape.Add(m);
        shape.Add(n);
        float[] res = new float[(int)total];
        float[] ad = a.data;
        float[] bd = b.data;
        nint aPtr = (nint)ad;
        nint bPtr = (nint)bd;
        nint rPtr = (nint)res;
        int kb = 64;
        for (int p0 = 0; p0 < k; p0 = p0 + kb) {
            int pEnd = p0 + kb;
            if (pEnd > k) { pEnd = k; }
            int pLen = pEnd - p0;
            int i = 0;
            for (; i + 3 < m; i = i + 4) {
                int rowA0 = i * k;
                int rowA1 = rowA0 + k;
                int rowA2 = rowA1 + k;
                int rowA3 = rowA2 + k;
                Span<float> sa0 = new Span<float>(aPtr + (nint)((long)(rowA0 + p0) * 4L), pLen);
                Span<float> sa1 = new Span<float>(aPtr + (nint)((long)(rowA1 + p0) * 4L), pLen);
                Span<float> sa2 = new Span<float>(aPtr + (nint)((long)(rowA2 + p0) * 4L), pLen);
                Span<float> sa3 = new Span<float>(aPtr + (nint)((long)(rowA3 + p0) * 4L), pLen);
                int rowO0 = i * n;
                int rowO1 = rowO0 + n;
                int rowO2 = rowO1 + n;
                int rowO3 = rowO2 + n;
                int j = 0;
                for (; j + 3 < n; j = j + 4) {
                    Span<float> o0 = new Span<float>(rPtr + (nint)((long)(rowO0 + j) * 4L), 4);
                    Span<float> o1 = new Span<float>(rPtr + (nint)((long)(rowO1 + j) * 4L), 4);
                    Span<float> o2 = new Span<float>(rPtr + (nint)((long)(rowO2 + j) * 4L), 4);
                    Span<float> o3 = new Span<float>(rPtr + (nint)((long)(rowO3 + j) * 4L), 4);
                    float c00 = o0[0]; float c01 = o0[1]; float c02 = o0[2]; float c03 = o0[3];
                    float c10 = o1[0]; float c11 = o1[1]; float c12 = o1[2]; float c13 = o1[3];
                    float c20 = o2[0]; float c21 = o2[1]; float c22 = o2[2]; float c23 = o2[3];
                    float c30 = o3[0]; float c31 = o3[1]; float c32 = o3[2]; float c33 = o3[3];
                    long rowB = (long)p0 * (long)n + (long)j;
                    for (int dp = 0; dp < pLen; dp = dp + 1) {
                        float a0 = sa0[dp];
                        float a1 = sa1[dp];
                        float a2 = sa2[dp];
                        float a3 = sa3[dp];
                        Span<float> b4 = new Span<float>(bPtr + (nint)(rowB * 4L), 4);
                        float b0 = b4[0]; float b1 = b4[1]; float b2 = b4[2]; float b3 = b4[3];
                        c00 = c00 + a0 * b0; c01 = c01 + a0 * b1; c02 = c02 + a0 * b2; c03 = c03 + a0 * b3;
                        c10 = c10 + a1 * b0; c11 = c11 + a1 * b1; c12 = c12 + a1 * b2; c13 = c13 + a1 * b3;
                        c20 = c20 + a2 * b0; c21 = c21 + a2 * b1; c22 = c22 + a2 * b2; c23 = c23 + a2 * b3;
                        c30 = c30 + a3 * b0; c31 = c31 + a3 * b1; c32 = c32 + a3 * b2; c33 = c33 + a3 * b3;
                        rowB = rowB + (long)n;
                    }
                    o0[0] = c00; o0[1] = c01; o0[2] = c02; o0[3] = c03;
                    o1[0] = c10; o1[1] = c11; o1[2] = c12; o1[3] = c13;
                    o2[0] = c20; o2[1] = c21; o2[2] = c22; o2[3] = c23;
                    o3[0] = c30; o3[1] = c31; o3[2] = c32; o3[3] = c33;
                }
                for (; j < n; j = j + 1) {
                    float c0 = res[rowO0 + j];
                    float c1 = res[rowO1 + j];
                    float c2 = res[rowO2 + j];
                    float c3 = res[rowO3 + j];
                    long rowB = (long)p0 * (long)n + (long)j;
                    for (int dp = 0; dp < pLen; dp = dp + 1) {
                        float bv = bd[(int)rowB];
                        c0 = c0 + sa0[dp] * bv;
                        c1 = c1 + sa1[dp] * bv;
                        c2 = c2 + sa2[dp] * bv;
                        c3 = c3 + sa3[dp] * bv;
                        rowB = rowB + (long)n;
                    }
                    res[rowO0 + j] = c0;
                    res[rowO1 + j] = c1;
                    res[rowO2 + j] = c2;
                    res[rowO3 + j] = c3;
                }
            }
            for (; i < m; i = i + 1) {
                int rowA = i * k;
                Span<float> sa = new Span<float>(aPtr + (nint)((long)(rowA + p0) * 4L), pLen);
                int rowO = i * n;
                int j = 0;
                for (; j + 3 < n; j = j + 4) {
                    Span<float> o0 = new Span<float>(rPtr + (nint)((long)(rowO + j) * 4L), 4);
                    float c0 = o0[0]; float c1 = o0[1]; float c2 = o0[2]; float c3 = o0[3];
                    long rowB = (long)p0 * (long)n + (long)j;
                    for (int dp = 0; dp < pLen; dp = dp + 1) {
                        float av = sa[dp];
                        Span<float> b4 = new Span<float>(bPtr + (nint)(rowB * 4L), 4);
                        c0 = c0 + av * b4[0]; c1 = c1 + av * b4[1];
                        c2 = c2 + av * b4[2]; c3 = c3 + av * b4[3];
                        rowB = rowB + (long)n;
                    }
                    o0[0] = c0; o0[1] = c1; o0[2] = c2; o0[3] = c3;
                }
                for (; j < n; j = j + 1) {
                    float acc = res[rowO + j];
                    long rowB = (long)p0 * (long)n + (long)j;
                    for (int dp = 0; dp < pLen; dp = dp + 1) {
                        acc = acc + sa[dp] * bd[(int)rowB];
                        rowB = rowB + (long)n;
                    }
                    res[rowO + j] = acc;
                }
            }
        }
        return new Tensor(shape, res);
    }

    // 矩阵乘向量：结果[m] = a[m,k] · v[k]（4 行 × 4 路定长 Span 展开，消除内层边界检查并触发 SIMD FMA）。
    public static Tensor MatVec(Tensor a, Tensor v) {
        if (a == null || v == null || a.data == null || v.data == null) {
            throw new ArgumentException("TensorMath.MatVec: null tensor");
        }
        if (a.Rank() != 2 || v.Rank() != 1) {
            throw new ArgumentException("TensorMath.MatVec: expects a 2D matrix and a 1D vector");
        }
        int m = a.Dim(0);
        int k = a.Dim(1);
        if (v.Dim(0) != k) {
            throw new ArgumentException("TensorMath.MatVec: inner dimensions do not match");
        }
        List<int> shape = new List<int>();
        shape.Add(m);
        float[] res = new float[m];
        float[] ad = a.data;
        float[] vd = v.data;
        nint aPtr = (nint)ad;
        nint vPtr = (nint)vd;
        int i = 0;
        nint rowStride = (nint)((long)k * 4L);
        for (; i + 3 < m; i = i + 4) {
            nint p0 = aPtr + (nint)((long)i * (long)k * 4L);
            nint p1 = p0 + rowStride;
            nint p2 = p1 + rowStride;
            nint p3 = p2 + rowStride;
            float acc0 = 0.0f;
            float acc1 = 0.0f;
            float acc2 = 0.0f;
            float acc3 = 0.0f;
            int p = 0;
            for (; p + 3 < k; p = p + 4) {
                nint off = (nint)((long)p * 4L);
                Span<float> sv = new Span<float>(vPtr + off, 4);
                Span<float> s0 = new Span<float>(p0 + off, 4);
                Span<float> s1 = new Span<float>(p1 + off, 4);
                Span<float> s2 = new Span<float>(p2 + off, 4);
                Span<float> s3 = new Span<float>(p3 + off, 4);
                float v0 = sv[0]; float v1 = sv[1]; float v2 = sv[2]; float v3 = sv[3];
                acc0 = acc0 + (s0[0] * v0 + s0[1] * v1) + (s0[2] * v2 + s0[3] * v3);
                acc1 = acc1 + (s1[0] * v0 + s1[1] * v1) + (s1[2] * v2 + s1[3] * v3);
                acc2 = acc2 + (s2[0] * v0 + s2[1] * v1) + (s2[2] * v2 + s2[3] * v3);
                acc3 = acc3 + (s3[0] * v0 + s3[1] * v1) + (s3[2] * v2 + s3[3] * v3);
            }
            int rowA0 = i * k;
            int rowA1 = rowA0 + k;
            int rowA2 = rowA1 + k;
            int rowA3 = rowA2 + k;
            for (; p < k; p = p + 1) {
                float vp = vd[p];
                acc0 = acc0 + ad[rowA0 + p] * vp;
                acc1 = acc1 + ad[rowA1 + p] * vp;
                acc2 = acc2 + ad[rowA2 + p] * vp;
                acc3 = acc3 + ad[rowA3 + p] * vp;
            }
            res[i] = acc0;
            res[i + 1] = acc1;
            res[i + 2] = acc2;
            res[i + 3] = acc3;
        }
        for (; i < m; i = i + 1) {
            int rowA = i * k;
            nint p0 = aPtr + (nint)((long)rowA * 4L);
            float acc = 0.0f;
            int p = 0;
            for (; p + 3 < k; p = p + 4) {
                nint off = (nint)((long)p * 4L);
                Span<float> sv = new Span<float>(vPtr + off, 4);
                Span<float> s0 = new Span<float>(p0 + off, 4);
                acc = acc + (s0[0] * sv[0] + s0[1] * sv[1]) + (s0[2] * sv[2] + s0[3] * sv[3]);
            }
            for (; p < k; p = p + 1) { acc = acc + ad[rowA + p] * vd[p]; }
            res[i] = acc;
        }
        return new Tensor(shape, res);
    }

    // 一维点积（8 路定长 Span 展开 + 双累加链打破 FMA 依赖）。
    public static float Dot(Tensor a, Tensor b) {
        int n = TensorMath.RequireSameCount(a, b);
        float[] ad = a.data;
        float[] bd = b.data;
        nint ap = (nint)ad;
        nint bp = (nint)bd;
        float s0 = 0.0f; float s1 = 0.0f; float s2 = 0.0f; float s3 = 0.0f;
        float s4 = 0.0f; float s5 = 0.0f; float s6 = 0.0f; float s7 = 0.0f;
        int i = 0;
        for (; i + 7 < n; i = i + 8) {
            nint off = (nint)((long)i * 4L);
            Span<float> sa = new Span<float>(ap + off, 8);
            Span<float> sb = new Span<float>(bp + off, 8);
            s0 = s0 + sa[0] * sb[0]; s1 = s1 + sa[1] * sb[1];
            s2 = s2 + sa[2] * sb[2]; s3 = s3 + sa[3] * sb[3];
            s4 = s4 + sa[4] * sb[4]; s5 = s5 + sa[5] * sb[5];
            s6 = s6 + sa[6] * sb[6]; s7 = s7 + sa[7] * sb[7];
        }
        float acc = ((s0 + s1) + (s2 + s3)) + ((s4 + s5) + (s6 + s7));
        for (; i < n; i = i + 1) { acc = acc + ad[i] * bd[i]; }
        return acc;
    }

    // 右操作数转置矩阵乘：left[m,k] · right[n,k]ᵀ -> [m,n]（4 行 × 4 列分块 + 4 路定长 Span，将 right 访存减少 4 倍）。
    public static Tensor MatMulRightTransposed(Tensor left, Tensor right) {
        if (left == null || right == null || left.data == null || right.data == null) {
            throw new ArgumentException("TensorMath.MatMulRightTransposed: null tensor");
        }
        if (left.Rank() != 2 || right.Rank() != 2) {
            throw new ArgumentException("TensorMath.MatMulRightTransposed: expects 2D tensors");
        }
        int m = left.Dim(0);
        int k = left.Dim(1);
        int n = right.Dim(0);
        if (right.Dim(1) != k) {
            throw new ArgumentException("TensorMath.MatMulRightTransposed: inner dimensions do not match");
        }
        long total = (long)m * (long)n;
        if (total > 2147483647L) {
            throw new ArgumentException("TensorMath.MatMulRightTransposed: output size overflow");
        }
        List<int> shape = new List<int>();
        shape.Add(m);
        shape.Add(n);
        float[] res = new float[(int)total];
        float[] ld = left.data;
        float[] rd = right.data;
        nint lPtr = (nint)ld;
        nint rPtr = (nint)rd;
        nint kStride = (nint)((long)k * 4L);
        int i = 0;
        for (; i + 3 < m; i = i + 4) {
            int rowL0 = i * k;
            int rowL1 = rowL0 + k;
            int rowL2 = rowL1 + k;
            int rowL3 = rowL2 + k;
            int rowO0 = i * n;
            int rowO1 = rowO0 + n;
            int rowO2 = rowO1 + n;
            int rowO3 = rowO2 + n;
            nint pL0 = lPtr + (nint)((long)rowL0 * 4L);
            nint pL1 = pL0 + kStride;
            nint pL2 = pL1 + kStride;
            nint pL3 = pL2 + kStride;
            int j = 0;
            for (; j + 3 < n; j = j + 4) {
                float c00 = 0.0f; float c01 = 0.0f; float c02 = 0.0f; float c03 = 0.0f;
                float c10 = 0.0f; float c11 = 0.0f; float c12 = 0.0f; float c13 = 0.0f;
                float c20 = 0.0f; float c21 = 0.0f; float c22 = 0.0f; float c23 = 0.0f;
                float c30 = 0.0f; float c31 = 0.0f; float c32 = 0.0f; float c33 = 0.0f;
                int baseR0 = j * k;
                int baseR1 = baseR0 + k;
                int baseR2 = baseR1 + k;
                int baseR3 = baseR2 + k;
                nint pR0 = rPtr + (nint)((long)baseR0 * 4L);
                nint pR1 = pR0 + kStride;
                nint pR2 = pR1 + kStride;
                nint pR3 = pR2 + kStride;
                int p = 0;
                for (; p + 3 < k; p = p + 4) {
                    nint off = (nint)((long)p * 4L);
                    Span<float> sl0 = new Span<float>(pL0 + off, 4);
                    Span<float> sl1 = new Span<float>(pL1 + off, 4);
                    Span<float> sl2 = new Span<float>(pL2 + off, 4);
                    Span<float> sl3 = new Span<float>(pL3 + off, 4);
                    Span<float> sr0 = new Span<float>(pR0 + off, 4);
                    Span<float> sr1 = new Span<float>(pR1 + off, 4);
                    Span<float> sr2 = new Span<float>(pR2 + off, 4);
                    Span<float> sr3 = new Span<float>(pR3 + off, 4);
                    float r00 = sr0[0]; float r01 = sr0[1]; float r02 = sr0[2]; float r03 = sr0[3];
                    float r10 = sr1[0]; float r11 = sr1[1]; float r12 = sr1[2]; float r13 = sr1[3];
                    float r20 = sr2[0]; float r21 = sr2[1]; float r22 = sr2[2]; float r23 = sr2[3];
                    float r30 = sr3[0]; float r31 = sr3[1]; float r32 = sr3[2]; float r33 = sr3[3];

                    float x0 = sl0[0]; float x1 = sl0[1]; float x2 = sl0[2]; float x3 = sl0[3];
                    c00 = c00 + (x0 * r00 + x1 * r01) + (x2 * r02 + x3 * r03);
                    c01 = c01 + (x0 * r10 + x1 * r11) + (x2 * r12 + x3 * r13);
                    c02 = c02 + (x0 * r20 + x1 * r21) + (x2 * r22 + x3 * r23);
                    c03 = c03 + (x0 * r30 + x1 * r31) + (x2 * r32 + x3 * r33);

                    x0 = sl1[0]; x1 = sl1[1]; x2 = sl1[2]; x3 = sl1[3];
                    c10 = c10 + (x0 * r00 + x1 * r01) + (x2 * r02 + x3 * r03);
                    c11 = c11 + (x0 * r10 + x1 * r11) + (x2 * r12 + x3 * r13);
                    c12 = c12 + (x0 * r20 + x1 * r21) + (x2 * r22 + x3 * r23);
                    c13 = c13 + (x0 * r30 + x1 * r31) + (x2 * r32 + x3 * r33);

                    x0 = sl2[0]; x1 = sl2[1]; x2 = sl2[2]; x3 = sl2[3];
                    c20 = c20 + (x0 * r00 + x1 * r01) + (x2 * r02 + x3 * r03);
                    c21 = c21 + (x0 * r10 + x1 * r11) + (x2 * r12 + x3 * r13);
                    c22 = c22 + (x0 * r20 + x1 * r21) + (x2 * r22 + x3 * r23);
                    c23 = c23 + (x0 * r30 + x1 * r31) + (x2 * r32 + x3 * r33);

                    x0 = sl3[0]; x1 = sl3[1]; x2 = sl3[2]; x3 = sl3[3];
                    c30 = c30 + (x0 * r00 + x1 * r01) + (x2 * r02 + x3 * r03);
                    c31 = c31 + (x0 * r10 + x1 * r11) + (x2 * r12 + x3 * r13);
                    c32 = c32 + (x0 * r20 + x1 * r21) + (x2 * r22 + x3 * r23);
                    c33 = c33 + (x0 * r30 + x1 * r31) + (x2 * r32 + x3 * r33);
                }
                for (; p < k; p = p + 1) {
                    float r0 = rd[baseR0 + p]; float r1 = rd[baseR1 + p];
                    float r2 = rd[baseR2 + p]; float r3 = rd[baseR3 + p];
                    float lv0 = ld[rowL0 + p];
                    c00 = c00 + lv0 * r0; c01 = c01 + lv0 * r1; c02 = c02 + lv0 * r2; c03 = c03 + lv0 * r3;
                    float lv1 = ld[rowL1 + p];
                    c10 = c10 + lv1 * r0; c11 = c11 + lv1 * r1; c12 = c12 + lv1 * r2; c13 = c13 + lv1 * r3;
                    float lv2 = ld[rowL2 + p];
                    c20 = c20 + lv2 * r0; c21 = c21 + lv2 * r1; c22 = c22 + lv2 * r2; c23 = c23 + lv2 * r3;
                    float lv3 = ld[rowL3 + p];
                    c30 = c30 + lv3 * r0; c31 = c31 + lv3 * r1; c32 = c32 + lv3 * r2; c33 = c33 + lv3 * r3;
                }
                res[rowO0 + j] = c00; res[rowO0 + j + 1] = c01; res[rowO0 + j + 2] = c02; res[rowO0 + j + 3] = c03;
                res[rowO1 + j] = c10; res[rowO1 + j + 1] = c11; res[rowO1 + j + 2] = c12; res[rowO1 + j + 3] = c13;
                res[rowO2 + j] = c20; res[rowO2 + j + 1] = c21; res[rowO2 + j + 2] = c22; res[rowO2 + j + 3] = c23;
                res[rowO3 + j] = c30; res[rowO3 + j + 1] = c31; res[rowO3 + j + 2] = c32; res[rowO3 + j + 3] = c33;
            }
            for (; j < n; j = j + 1) {
                int baseR = j * k;
                nint pR = rPtr + (nint)((long)baseR * 4L);
                float c0 = 0.0f; float c1 = 0.0f; float c2 = 0.0f; float c3 = 0.0f;
                int p = 0;
                for (; p + 3 < k; p = p + 4) {
                    nint off = (nint)((long)p * 4L);
                    Span<float> sr = new Span<float>(pR + off, 4);
                    Span<float> sl0 = new Span<float>(pL0 + off, 4);
                    Span<float> sl1 = new Span<float>(pL1 + off, 4);
                    Span<float> sl2 = new Span<float>(pL2 + off, 4);
                    Span<float> sl3 = new Span<float>(pL3 + off, 4);
                    float r0 = sr[0]; float r1 = sr[1]; float r2 = sr[2]; float r3 = sr[3];
                    c0 = c0 + (sl0[0] * r0 + sl0[1] * r1) + (sl0[2] * r2 + sl0[3] * r3);
                    c1 = c1 + (sl1[0] * r0 + sl1[1] * r1) + (sl1[2] * r2 + sl1[3] * r3);
                    c2 = c2 + (sl2[0] * r0 + sl2[1] * r1) + (sl2[2] * r2 + sl2[3] * r3);
                    c3 = c3 + (sl3[0] * r0 + sl3[1] * r1) + (sl3[2] * r2 + sl3[3] * r3);
                }
                for (; p < k; p = p + 1) {
                    float rv = rd[baseR + p];
                    c0 = c0 + ld[rowL0 + p] * rv;
                    c1 = c1 + ld[rowL1 + p] * rv;
                    c2 = c2 + ld[rowL2 + p] * rv;
                    c3 = c3 + ld[rowL3 + p] * rv;
                }
                res[rowO0 + j] = c0; res[rowO1 + j] = c1; res[rowO2 + j] = c2; res[rowO3 + j] = c3;
            }
        }
        for (; i < m; i = i + 1) {
            int rowL = i * k;
            int rowO = i * n;
            nint pL = lPtr + (nint)((long)rowL * 4L);
            for (int j = 0; j < n; j = j + 1) {
                float acc = 0.0f;
                int baseR = j * k;
                nint pR = rPtr + (nint)((long)baseR * 4L);
                int p = 0;
                for (; p + 3 < k; p = p + 4) {
                    nint off = (nint)((long)p * 4L);
                    Span<float> sl = new Span<float>(pL + off, 4);
                    Span<float> sr = new Span<float>(pR + off, 4);
                    acc = acc + (sl[0] * sr[0] + sl[1] * sr[1]) + (sl[2] * sr[2] + sl[3] * sr[3]);
                }
                for (; p < k; p = p + 1) {
                    acc = acc + ld[rowL + p] * rd[baseR + p];
                }
                res[rowO + j] = acc;
            }
        }
        return new Tensor(shape, res);
    }

    // ---- 归一化与激活 ----

    private static void SoftmaxSlice(Tensor src, float[] dst, int rowBase, int count) {
        if (count <= 0) { return; }
        float[] sd = src.data;
        float max = sd[rowBase];
        for (int i = 0; i < count; i = i + 1) {
            float v = sd[rowBase + i];
            if (v != v) {
                float nan = 0.0f / 0.0f;
                for (int j = 0; j < count; j = j + 1) { dst[rowBase + j] = nan; }
                return;
            }
            if (v > max) { max = v; }
        }
        if (max > 3.4028234e38f) {
            int infCount = 0;
            for (int i = 0; i < count; i = i + 1) {
                if (sd[rowBase + i] > 3.4028234e38f) { infCount = infCount + 1; }
            }
            float w = infCount > 0 ? (1.0f / (float)infCount) : 0.0f;
            for (int i = 0; i < count; i = i + 1) {
                dst[rowBase + i] = sd[rowBase + i] > 3.4028234e38f ? w : 0.0f;
            }
            return;
        }
        if (max < -3.4028234e38f) {
            float u = 1.0f / (float)count;
            for (int i = 0; i < count; i = i + 1) { dst[rowBase + i] = u; }
            return;
        }
        double sum = 0.0;
        for (int i = 0; i < count; i = i + 1) {
            double e = Math.Exp((double)sd[rowBase + i] - (double)max);
            dst[rowBase + i] = (float)e;
            sum = sum + e;
        }
        if (!(sum > 0.0)) {
            for (int i = 0; i < count; i = i + 1) { dst[rowBase + i] = 0.0f; }
        } else {
            double invSum = 1.0 / sum;
            for (int i = 0; i < count; i = i + 1) { dst[rowBase + i] = (float)((double)dst[rowBase + i] * invSum); }
        }
    }

    // Softmax：沿最后一维，数值稳定版（先减最大值）。
    public static Tensor Softmax(Tensor x) {
        if (x == null || x.data == null) { throw new ArgumentException("TensorMath.Softmax: null tensor"); }
        if (x.Rank() == 0) {
            float[] s = new float[x.Count()];
            if (s.Length > 0) { s[0] = 1.0f; }
            return new Tensor(x.Shape(), s);
        }
        int last = x.Dim(x.Rank() - 1);
        int rows = x.Count() / (last > 0 ? last : 1);
        float[] res = new float[x.Count()];
        for (int r = 0; r < rows; r = r + 1) {
            TensorMath.SoftmaxSlice(x, res, r * last, last);
        }
        return new Tensor(x.Shape(), res);
    }

    // 因果 Softmax（scores[seq, seq]，第 i 行仅保留 j <= i，其余为 0）。
    public static Tensor SoftmaxCausal(Tensor scores) {
        if (scores == null || scores.data == null) {
            throw new ArgumentException("TensorMath.SoftmaxCausal: null tensor");
        }
        if (scores.Rank() != 2) {
            throw new ArgumentException("TensorMath.SoftmaxCausal: expects a 2D score matrix");
        }
        int seq = scores.Dim(0);
        int width = scores.Dim(1);
        float[] res = new float[seq * width];
        for (int i = 0; i < seq; i = i + 1) {
            int visible = i + 1;
            if (visible > width) { visible = width; }
            if (visible <= 0) { continue; }
            TensorMath.SoftmaxSlice(scores, res, i * width, visible);
        }
        return new Tensor(scores.Shape(), res);
    }

    private static void RequireLastDimMatch(string op, string arg, Tensor t, int last) {
        if (t != null && (t.data == null || t.Count() != last)) {
            throw new ArgumentException("TensorMath." + op + ": " + arg + " length "
                + Convert.ToString(t.Count()) + " != last dim "
                + Convert.ToString(last));
        }
    }

    // RMSNorm：沿最后一维 x / sqrt(mean(x²) + eps) * weight（weight 可为 null）。
    public static Tensor RMSNorm(Tensor x, float eps, Tensor weight) {
        if (x == null || x.data == null) { throw new ArgumentException("TensorMath.RMSNorm: null tensor"); }
        if (x.Rank() == 0) { throw new ArgumentException("TensorMath.RMSNorm: scalar tensor not supported"); }
        if (!(eps >= 0.0f && eps <= 3.4028234e38f)) { throw new ArgumentException("TensorMath.RMSNorm: eps must be finite and >= 0"); }
        int last = x.Dim(x.Rank() - 1);
        TensorMath.RequireLastDimMatch("RMSNorm", "weight", weight, last);
        float[] xd = x.data;
        float[] res = new float[xd.Length];
        if (last <= 0 || xd.Length == 0) { return new Tensor(x.Shape(), res); }
        int rows = xd.Length / last;
        float[] wd = weight != null ? weight.data : null;
        double invLast = 1.0 / (double)last;
        double epsD = (double)eps;
        for (int r = 0; r < rows; r = r + 1) {
            int rowBase = r * last;
            double ss = 0.0;
            for (int i = 0; i < last; i = i + 1) {
                double v = (double)xd[rowBase + i];
                ss = ss + v * v;
            }
            double denom = Math.Sqrt(ss * invLast + epsD);
            float inv = denom > 0.0 ? (float)(1.0 / denom) : 0.0f;
            if (wd != null) {
                for (int i = 0; i < last; i = i + 1) {
                    res[rowBase + i] = xd[rowBase + i] * inv * wd[i];
                }
            } else {
                for (int i = 0; i < last; i = i + 1) {
                    res[rowBase + i] = xd[rowBase + i] * inv;
                }
            }
        }
        return new Tensor(x.Shape(), res);
    }

    // LayerNorm：沿最后一维减均值除标准差，weight/bias 可为 null。
    public static Tensor LayerNorm(Tensor x, float eps, Tensor weight, Tensor bias) {
        if (x == null || x.data == null) { throw new ArgumentException("TensorMath.LayerNorm: null tensor"); }
        if (x.Rank() == 0) { throw new ArgumentException("TensorMath.LayerNorm: scalar tensor not supported"); }
        if (!(eps >= 0.0f && eps <= 3.4028234e38f)) { throw new ArgumentException("TensorMath.LayerNorm: eps must be finite and >= 0"); }
        int last = x.Dim(x.Rank() - 1);
        TensorMath.RequireLastDimMatch("LayerNorm", "weight", weight, last);
        TensorMath.RequireLastDimMatch("LayerNorm", "bias", bias, last);
        float[] xd = x.data;
        float[] res = new float[xd.Length];
        if (last <= 0 || xd.Length == 0) { return new Tensor(x.Shape(), res); }
        int rows = xd.Length / last;
        float[] wd = weight != null ? weight.data : null;
        float[] bd = bias != null ? bias.data : null;
        double invLast = 1.0 / (double)last;
        double epsD = (double)eps;
        for (int r = 0; r < rows; r = r + 1) {
            int rowBase = r * last;
            double sum = 0.0;
            for (int i = 0; i < last; i = i + 1) { sum = sum + (double)xd[rowBase + i]; }
            double mean = sum * invLast;
            double variance = 0.0;
            for (int i = 0; i < last; i = i + 1) {
                double d = (double)xd[rowBase + i] - mean;
                variance = variance + d * d;
            }
            double denom = Math.Sqrt(variance * invLast + epsD);
            double inv = denom > 0.0 ? (1.0 / denom) : 0.0;
            if (wd != null && bd != null) {
                for (int i = 0; i < last; i = i + 1) {
                    res[rowBase + i] = (float)(((double)xd[rowBase + i] - mean) * inv * (double)wd[i] + (double)bd[i]);
                }
            } else if (wd != null) {
                for (int i = 0; i < last; i = i + 1) {
                    res[rowBase + i] = (float)(((double)xd[rowBase + i] - mean) * inv * (double)wd[i]);
                }
            } else if (bd != null) {
                for (int i = 0; i < last; i = i + 1) {
                    res[rowBase + i] = (float)(((double)xd[rowBase + i] - mean) * inv + (double)bd[i]);
                }
            } else {
                for (int i = 0; i < last; i = i + 1) {
                    res[rowBase + i] = (float)(((double)xd[rowBase + i] - mean) * inv);
                }
            }
        }
        return new Tensor(x.Shape(), res);
    }

    // SiLU：x · sigmoid(x)（极值溢出保护，常规区间保持 float32 精度）。
    public static Tensor SiLU(Tensor x) {
        if (x == null || x.data == null) { throw new ArgumentException("TensorMath.SiLU: null tensor"); }
        float[] xd = x.data;
        int n = xd.Length;
        float[] res = new float[n];
        for (int i = 0; i < n; i = i + 1) {
            float v = xd[i];
            if (v < -80.0f) {
                res[i] = 0.0f;
            } else if (v > 80.0f) {
                res[i] = v;
            } else {
                res[i] = v / (1.0f + (float)Math.Exp((double)(-v)));
            }
        }
        return new Tensor(x.Shape(), res);
    }

    // GELU（tanh 近似，带饱和保护防 dv³ 溢出）。
    public static Tensor GELU(Tensor x) {
        if (x == null || x.data == null) { throw new ArgumentException("TensorMath.GELU: null tensor"); }
        float[] xd = x.data;
        int n = xd.Length;
        float[] res = new float[n];
        for (int i = 0; i < n; i = i + 1) {
            double dv = (double)xd[i];
            if (dv > 20.0) {
                res[i] = (float)dv;
            } else if (dv < -20.0) {
                res[i] = 0.0f;
            } else {
                double inner = 0.7978845608028654 * (dv + 0.044715 * dv * dv * dv);
                double t = TensorMath.Tanh(inner);
                res[i] = (float)(0.5 * dv * (1.0 + t));
            }
        }
        return new Tensor(x.Shape(), res);
    }

    // SwiGLU：silu(gate) * up（单遍融合，省去中间 Tensor 分配与二次扫描）。
    public static Tensor SwiGLU(Tensor gate, Tensor up) {
        int n = TensorMath.RequireSameCount(gate, up);
        float[] gd = gate.data;
        float[] ud = up.data;
        float[] res = new float[n];
        for (int i = 0; i < n; i = i + 1) {
            double v = (double)gd[i];
            double s = v < -80.0 ? 0.0 : (v > 80.0 ? v : v / (1.0 + Math.Exp(-v)));
            res[i] = (float)(s * (double)ud[i]);
        }
        return new Tensor(gate.Shape(), res);
    }

    // ---- 结构操作 ----

    // 按行取表：table 是 [vocab, dim]，indices 是行号 → [len(indices), dim]（整行 memcpy）。
    public static Tensor GatherRows(Tensor table, List<int> indices) {
        if (table == null || table.data == null) {
            throw new ArgumentException("TensorMath.GatherRows: null table");
        }
        if (table.Rank() != 2) {
            throw new ArgumentException("TensorMath.GatherRows: expects a 2D table");
        }
        int dim = table.Dim(1);
        int vocab = table.Dim(0);
        int n = indices == null ? 0 : indices.Count;
        long totalElems = (long)n * (long)dim;
        long rowBytesL = (long)dim * 4L;
        if (totalElems > 2147483647L || rowBytesL > 2147483647L) {
            throw new ArgumentException("TensorMath.GatherRows: output size overflow");
        }
        List<int> shape = new List<int>();
        shape.Add(n);
        shape.Add(dim);
        float[] res = new float[(int)totalElems];
        nint srcPtr = (nint)table.data;
        nint dstPtr = (nint)res;
        for (int i = 0; i < n; i = i + 1) {
            int row = indices[i];
            if (row < 0 || row >= vocab) {
                throw new ArgumentException("TensorMath.GatherRows: row index out of range");
            }
            if (rowBytesL > 0L) {
                NativeMemory.Copy(dstPtr + (nint)((long)i * rowBytesL), srcPtr + (nint)((long)row * rowBytesL), (int)rowBytesL);
            }
        }
        return new Tensor(shape, res);
    }

    // 沿第 0 维拼接两个张量（双段整块 memcpy）。
    public static Tensor ConcatRows(Tensor a, Tensor b) {
        if (a == null || b == null || a.data == null || b.data == null) {
            throw new ArgumentException("TensorMath.ConcatRows: null tensor");
        }
        if (a.Rank() != b.Rank()) { throw new ArgumentException("TensorMath.ConcatRows: rank mismatch"); }
        if (a.Rank() == 0) { throw new ArgumentException("TensorMath.ConcatRows: cannot concat scalar tensors"); }
        long inner = 1L;
        for (int i = 1; i < a.Rank(); i = i + 1) {
            int da = a.Dim(i);
            if (da != b.Dim(i)) { throw new ArgumentException("TensorMath.ConcatRows: inner dimension mismatch"); }
            if (da > 0 && inner > 2147483647L / (long)da) {
                throw new ArgumentException("TensorMath.ConcatRows: inner dimension overflow");
            }
            inner = inner * (long)da;
        }
        long rowsA = (long)a.Dim(0);
        long rowsB = (long)b.Dim(0);
        if (rowsA + rowsB > 2147483647L) {
            throw new ArgumentException("TensorMath.ConcatRows: row count overflow");
        }
        long elemsA = rowsA * inner;
        long elemsB = rowsB * inner;
        long totalElems = elemsA + elemsB;
        if (totalElems > 2147483647L || elemsA * 4L > 2147483647L || elemsB * 4L > 2147483647L) {
            throw new ArgumentException("TensorMath.ConcatRows: output size overflow");
        }
        List<int> shape = a.Shape();
        shape[0] = (int)(rowsA + rowsB);
        float[] res = new float[(int)totalElems];
        if (elemsA > 0L) {
            NativeMemory.Copy((nint)res, (nint)a.data, (int)(elemsA * 4L));
        }
        if (elemsB > 0L) {
            NativeMemory.Copy((nint)res + (nint)(elemsA * 4L), (nint)b.data, (int)(elemsB * 4L));
        }
        return new Tensor(shape, res);
    }

    // ---- 归约与取值 ----

    // 最大值所在下标（第一处最大值；跳过 NaN 避免首元素为 NaN 遮蔽有限值）。
    public static int ArgMax(Tensor x) {
        if (x == null || x.data == null) { throw new ArgumentException("TensorMath.ArgMax: null tensor"); }
        float[] xd = x.data;
        int n = xd.Length;
        if (n == 0) { throw new ArgumentException("TensorMath.ArgMax: empty tensor"); }
        int best = 0;
        float bestVal = xd[0];
        for (int i = 1; i < n; i = i + 1) {
            float v = xd[i];
            if (v != v) { continue; }
            if (bestVal != bestVal || v > bestVal) {
                bestVal = v;
                best = i;
            }
        }
        return best;
    }

    // 堆序比较：在 TopK 小顶堆中，值更小（或 NaN）或（同值且下标更大）的元素优先级更低、居于堆顶以便被替换。
    private static bool TopKWorse(float va, int ia, float vb, int ib) {
        bool aNan = va != va;
        bool bNan = vb != vb;
        if (aNan != bNan) { return aNan; }
        if (aNan && bNan) { return ia > ib; }
        return va < vb || (va == vb && ia > ib);
    }

    private static void TopKSiftDown(float[] hVal, int[] hIdx, int size, int pos) {
        float v = hVal[pos];
        int id = hIdx[pos];
        int half = size >> 1;
        while (pos < half) {
            int left = (pos << 1) + 1;
            int right = left + 1;
            int worst = left;
            if (right < size && TensorMath.TopKWorse(hVal[right], hIdx[right], hVal[left], hIdx[left])) {
                worst = right;
            }
            if (!TensorMath.TopKWorse(hVal[worst], hIdx[worst], v, id)) {
                break;
            }
            hVal[pos] = hVal[worst];
            hIdx[pos] = hIdx[worst];
            pos = worst;
        }
        hVal[pos] = v;
        hIdx[pos] = id;
    }

    // 前 k 大的下标（按值从大到小；同值按原下标升序；O(n log k) 小顶堆，O(k) 额外空间）。
    public static List<int> TopK(Tensor x, int k) {
        if (x == null || x.data == null) { throw new ArgumentException("TensorMath.TopK: null tensor"); }
        float[] xd = x.data;
        int n = xd.Length;
        if (k <= 0 || n == 0) { return new List<int>(); }
        if (k > n) { k = n; }
        if (k == 1) {
            List<int> single = new List<int>();
            single.Add(TensorMath.ArgMax(x));
            return single;
        }
        float[] hVal = new float[k];
        int[] hIdx = new int[k];
        for (int i = 0; i < k; i = i + 1) {
            hVal[i] = xd[i];
            hIdx[i] = i;
        }
        for (int i = (k >> 1) - 1; i >= 0; i = i - 1) {
            TensorMath.TopKSiftDown(hVal, hIdx, k, i);
        }
        for (int i = k; i < n; i = i + 1) {
            float v = xd[i];
            if (TensorMath.TopKWorse(hVal[0], hIdx[0], v, i)) {
                hVal[0] = v;
                hIdx[0] = i;
                TensorMath.TopKSiftDown(hVal, hIdx, k, 0);
            }
        }
        int[] sorted = new int[k];
        int rem = k;
        for (int i = k - 1; i >= 0; i = i - 1) {
            sorted[i] = hIdx[0];
            rem = rem - 1;
            if (rem > 0) {
                hVal[0] = hVal[rem];
                hIdx[0] = hIdx[rem];
                TensorMath.TopKSiftDown(hVal, hIdx, rem, 0);
            }
        }
        List<int> res = new List<int>();
        res.Reserve(k);
        for (int i = 0; i < k; i = i + 1) { res.Add(sorted[i]); }
        return res;
    }

    // 元素和。
    public static float Sum(Tensor x) {
        if (x == null || x.data == null) { throw new ArgumentException("TensorMath.Sum: null tensor"); }
        float[] xd = x.data;
        int n = xd.Length;
        float acc = 0.0f;
        for (int i = 0; i < n; i = i + 1) { acc = acc + xd[i]; }
        return acc;
    }

    // 元素均值。
    public static float Mean(Tensor x) {
        if (x == null || x.data == null) { throw new ArgumentException("TensorMath.Mean: null tensor"); }
        int n = x.data.Length;
        if (n == 0) { throw new ArgumentException("TensorMath.Mean: empty tensor"); }
        return TensorMath.Sum(x) / (float)n;
    }

    // ---- 内部工具 ----

    // 区间 [rowBase, rowBase+len) 内的最大值。空区间没有"最大值"
    // 可言——读 data[start] 是对空数组的越界，直接报清楚。
    public static float MaxOf(Tensor x, int start, int len) {
        if (x == null || x.data == null) {
            throw new ArgumentException("TensorMath.MaxOf: null tensor");
        }
        float[] xd = x.data;
        if (len <= 0 || start < 0 || start > xd.Length || len > xd.Length - start) {
            throw new ArgumentException("TensorMath.MaxOf: range out of bounds");
        }
        float max = xd[start];
        for (int i = 1; i < len; i = i + 1) {
            float v = xd[start + i];
            if (v != v) { continue; }
            if (max != max || v > max) { max = v; }
        }
        return max;
    }

    // tanh（基于底层 Math.Exp，带饱和快速路防溢出）。
    public static double Tanh(double v) {
        if (v > 20.0) { return 1.0; }
        if (v < -20.0) { return -1.0; }
        double e2 = Math.Exp(2.0 * v);
        return (e2 - 1.0) / (e2 + 1.0);
    }

    // 两个张量元素数必须一致。
    public static int RequireSameCount(Tensor a, Tensor b) {
        if (a == null || b == null || a.data == null || b.data == null) { throw new ArgumentException("TensorMath: null tensor"); }
        if (a.Count() != b.Count()) {
            throw new ArgumentException("TensorMath: element count mismatch "
                + Convert.ToString(a.Count()) + " vs " + Convert.ToString(b.Count()));
        }
        return a.Count();
    }

    // 两个张量必须都是二维且内维匹配。
    public static void RequireMatrices(Tensor a, Tensor b) {
        if (a == null || b == null || a.data == null || b.data == null) { throw new ArgumentException("TensorMath: null tensor"); }
        if (a.Rank() != 2 || b.Rank() != 2) {
            throw new ArgumentException("TensorMath: expects 2D tensors");
        }
        if (a.Dim(1) != b.Dim(0)) {
            throw new ArgumentException("TensorMath: inner dimensions do not match "
                + Convert.ToString(a.Dim(1)) + " vs " + Convert.ToString(b.Dim(0)));
        }
    }
}
