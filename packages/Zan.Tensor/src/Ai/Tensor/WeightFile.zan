using System;
using System.Collections.Generic;
using System.Interop;

namespace Ai.Tensor;

// 一个权重张量的描述（两种格式共用）。
public class WeightTensorInfo {
    public string name;
    // 形状（第一维在最外层）。
    public List<int> shape;
    // dtype 名："F32" / "F16" / "BF16" / "Q4_0" ……（safetensors 用它自己的
    // 字符串："I8" / "U16" / "F64" / "BOOL" ……）。
    public string dtype;
    // GGUF 的 ggml 类型编号；safetensors 为 -1。
    public int ggmlType;
    // 数据区内的字节偏移。
    public long offset;
    // 数据区内的字节长度。
    public long byteLength;
    // 元素总数。
    public long count;
}

// 权重文件：GGUF 与 safetensors 的统一入口。
//
// 打开后会读完整份文件的字节、解析出元数据与张量目录；张量数据在需要时
// 才解（Materialize / Find / Require），避免为了看一眼目录就把几个 GB
// 的权重全解一遍。
//
// 两种格式的 dtype 名汇到同一张表上，所以"解成一个 f32 张量"这件事
// 两种格式走同一条路。
public class WeightFile {
    public string format;
    public Dictionary<string, string> metadata;
    public Dictionary<string, List<string>> metadataArrays;
    public List<WeightTensorInfo> tensors;

    private byte[] file;
    private long dataStart;
    private Dictionary<string, WeightTensorInfo> tensorIndex;

    public static WeightFile Open(string path) {
        return Load(File.ReadAllBytes(path));
    }

    private void BuildIndex() {
        Dictionary<string, WeightTensorInfo> idx = new Dictionary<string, WeightTensorInfo>();
        for (int i = 0; i < this.tensors.Count; i = i + 1) {
            WeightTensorInfo info = this.tensors[i];
            if (!idx.ContainsKey(info.name)) {
                idx[info.name] = info;
            }
        }
        this.tensorIndex = idx;
    }

    // 从字节解析（测试与内存场景用；真实文件走 Open）。
    public static WeightFile Load(byte[] bytes) {
        WeightFile w = new WeightFile();
        w.file = bytes;
        w.metadata = new Dictionary<string, string>();
        w.metadataArrays = new Dictionary<string, List<string>>();
        w.tensors = new List<WeightTensorInfo>();

        if (bytes.Length >= 4 && bytes[0] == 71 && bytes[1] == 71
            && bytes[2] == 85 && bytes[3] == 70) {
            GgufReader g = GgufReader.Parse(bytes);
            w.format = "gguf";
            w.metadata = g.metadata;
            w.metadataArrays = g.metadataArrays;
            w.tensors = g.tensors;
            w.dataStart = g.dataStart;
            w.BuildIndex();
            return w;
        }
        // safetensors：8 字节小端头长 + JSON 头。JSON 头一定以 '{' 开头。
        if (bytes.Length >= 9 && bytes[8] == 123) {
            SafeTensorsReader s = SafeTensorsReader.Parse(bytes);
            w.format = "safetensors";
            w.metadata = s.metadata;
            w.metadataArrays = s.metadataArrays;
            w.tensors = s.tensors;
            w.dataStart = s.dataStart;
            w.BuildIndex();
            return w;
        }
        throw new Exception("unrecognized weight file format (not GGUF, not safetensors)");
    }

    // 有没有这个张量（O(1) 哈希查询）。
    public bool Has(string name) {
        if (name == null) { return false; }
        if (this.tensorIndex != null) {
            return this.tensorIndex.ContainsKey(name);
        }
        for (int i = 0; i < this.tensors.Count; i = i + 1) {
            if (this.tensors[i].name == name) { return true; }
        }
        return false;
    }

    // 张量目录（没有返回 null，O(1) 哈希查询）。
    public WeightTensorInfo Info(string name) {
        if (name == null) { return null; }
        if (this.tensorIndex != null) {
            WeightTensorInfo found = null;
            if (this.tensorIndex.TryGetValue(name, out found)) { return found; }
            return null;
        }
        for (int i = 0; i < this.tensors.Count; i = i + 1) {
            if (this.tensors[i].name == name) { return this.tensors[i]; }
        }
        return null;
    }

    // 张量名字列表（按文件里的顺序）。
    public List<string> Names() {
        List<string> names = new List<string>();
        for (int i = 0; i < this.tensors.Count; i = i + 1) {
            names.Add(this.tensors[i].name);
        }
        return names;
    }

    // 解出一个张量（没有返回 null）。
    public Tensor Find(string name) {
        WeightTensorInfo info = this.Info(name);
        if (info == null) { return null; }
        return this.Materialize(info);
    }

    // 解出一个张量（没有就抛）。
    public Tensor Require(string name) {
        WeightTensorInfo info = this.Info(name);
        if (info == null) {
            throw new ArgumentException("no tensor named '" + name + "'");
        }
        return this.Materialize(info);
    }

    private int ValidateSlice(WeightTensorInfo info, long needBytes) {
        long fileLen = (long)this.file.Length;
        if (info == null || info.offset < 0L || info.byteLength < 0L || needBytes < 0L
            || this.dataStart < 0L || this.dataStart > fileLen
            || info.offset > fileLen - this.dataStart) {
            throw new ArgumentException("weight tensor data out of file bounds");
        }
        long start = this.dataStart + info.offset;
        long avail = fileLen - start;
        if (info.byteLength < needBytes || info.byteLength > avail || needBytes > avail) {
            throw new ArgumentException("weight tensor data out of file bounds");
        }
        return (int)start;
    }

    // 把一段权重数据解成 f32 张量（一次性边界校验 + 原始字节数组直读，消除逐元素 BinaryReader/Span 开销）。
    public Tensor Materialize(WeightTensorInfo info) {
        if (info == null || info.count < 0L || info.count > 2147483647L) {
            throw new ArgumentException("weight tensor element count out of bounds");
        }
        int n = (int)info.count;
        float[] out2 = new float[n];
        string dt = info.dtype;
        byte[] raw = this.file;

        if (dt == "F32") {
            long needBytes = (long)n * 4L;
            int start = this.ValidateSlice(info, needBytes);
            if (n > 0) {
                NativeMemory.Copy((nint)out2, (nint)raw + (nint)start, (nint)needBytes);
            }
            return new Tensor(info.shape, out2);
        }
        if (dt == "F16") {
            int p = this.ValidateSlice(info, (long)n * 2L);
            for (int i = 0; i < n; i = i + 1) {
                int bits = (raw[p] & 255) | ((raw[p + 1] & 255) << 8);
                out2[i] = FloatBits.FromF16Bits(bits);
                p = p + 2;
            }
            return new Tensor(info.shape, out2);
        }
        if (dt == "BF16") {
            int p = this.ValidateSlice(info, (long)n * 2L);
            for (int i = 0; i < n; i = i + 1) {
                int bits = (raw[p] & 255) | ((raw[p + 1] & 255) << 8);
                out2[i] = NativeMemory.AsF32(bits << 16);
                p = p + 2;
            }
            return new Tensor(info.shape, out2);
        }
        if (dt == "F64") {
            BinaryReader r = this.ReaderAt(info.offset, info.byteLength);
            for (int i = 0; i < n; i = i + 1) { out2[i] = (float)r.F64(); }
            return new Tensor(info.shape, out2);
        }
        if (dt == "I8") {
            int p = this.ValidateSlice(info, (long)n);
            for (int i = 0; i < n; i = i + 1) {
                int v = raw[p + i] & 255;
                if (v >= 128) { v = v - 256; }
                out2[i] = (float)v;
            }
            return new Tensor(info.shape, out2);
        }
        if (dt == "U8" || dt == "BOOL") {
            int p = this.ValidateSlice(info, (long)n);
            for (int i = 0; i < n; i = i + 1) {
                out2[i] = (float)(raw[p + i] & 255);
            }
            return new Tensor(info.shape, out2);
        }
        if (dt == "I16") {
            int p = this.ValidateSlice(info, (long)n * 2L);
            for (int i = 0; i < n; i = i + 1) {
                int v = (raw[p] & 255) | ((raw[p + 1] & 255) << 8);
                if (v >= 32768) { v = v - 65536; }
                out2[i] = (float)v;
                p = p + 2;
            }
            return new Tensor(info.shape, out2);
        }
        if (dt == "U16") {
            int p = this.ValidateSlice(info, (long)n * 2L);
            for (int i = 0; i < n; i = i + 1) {
                int v = (raw[p] & 255) | ((raw[p + 1] & 255) << 8);
                out2[i] = (float)v;
                p = p + 2;
            }
            return new Tensor(info.shape, out2);
        }
        if (dt == "I32") {
            int p = this.ValidateSlice(info, (long)n * 4L);
            for (int i = 0; i < n; i = i + 1) {
                int v = (raw[p] & 255) | ((raw[p + 1] & 255) << 8)
                      | ((raw[p + 2] & 255) << 16) | ((raw[p + 3] & 255) << 24);
                out2[i] = (float)v;
                p = p + 4;
            }
            return new Tensor(info.shape, out2);
        }
        if (dt == "U32") {
            int p = this.ValidateSlice(info, (long)n * 4L);
            for (int i = 0; i < n; i = i + 1) {
                long v = (long)(raw[p] & 255) | ((long)(raw[p + 1] & 255) << 8)
                       | ((long)(raw[p + 2] & 255) << 16) | ((long)(raw[p + 3] & 255) << 24);
                out2[i] = (float)v;
                p = p + 4;
            }
            return new Tensor(info.shape, out2);
        }
        if (dt == "I64") {
            int p = this.ValidateSlice(info, (long)n * 8L);
            for (int i = 0; i < n; i = i + 1) {
                long v = (long)(raw[p] & 255) | ((long)(raw[p + 1] & 255) << 8)
                       | ((long)(raw[p + 2] & 255) << 16) | ((long)(raw[p + 3] & 255) << 24)
                       | ((long)(raw[p + 4] & 255) << 32) | ((long)(raw[p + 5] & 255) << 40)
                       | ((long)(raw[p + 6] & 255) << 48) | ((long)(raw[p + 7] & 255) << 56);
                out2[i] = (float)v;
                p = p + 8;
            }
            return new Tensor(info.shape, out2);
        }
        if (dt == "U64") {
            int p = this.ValidateSlice(info, (long)n * 8L);
            for (int i = 0; i < n; i = i + 1) {
                long v = (long)(raw[p] & 255) | ((long)(raw[p + 1] & 255) << 8)
                       | ((long)(raw[p + 2] & 255) << 16) | ((long)(raw[p + 3] & 255) << 24)
                       | ((long)(raw[p + 4] & 255) << 32) | ((long)(raw[p + 5] & 255) << 40)
                       | ((long)(raw[p + 6] & 255) << 48) | ((long)(raw[p + 7] & 255) << 56);
                double dv = v >= 0L ? (double)v : (double)(v & 9223372036854775807L) + 9223372036854775808.0;
                out2[i] = (float)dv;
                p = p + 8;
            }
            return new Tensor(info.shape, out2);
        }
        if (dt == "Q4_0" || dt == "Q4_1" || dt == "Q5_0" || dt == "Q5_1"
            || dt == "Q8_0") {
            this.DecodeQuant(info, out2);
            return new Tensor(info.shape, out2);
        }
        throw new ArgumentException("unsupported weight dtype '" + dt
            + "' for tensor '" + info.name + "'");
    }

    // 数据区里某一段的读取器。
    BinaryReader ReaderAt(long offset, long length) {
        long start = this.dataStart + offset;
        if (start < 0 || length < 0 || start + length > this.file.Length) {
            throw new ArgumentException("weight tensor data out of file bounds");
        }
        return new BinaryReader(this.file, (int)start, (int)length);
    }

    // 块量化解码（ggml 的老量化：Q4_0 / Q4_1 / Q5_0 / Q5_1 / Q8_0）。
    void DecodeQuant(WeightTensorInfo info, float[] out2) {
        string dt = info.dtype;
        int n = (int)info.count;
        int blocks = n / 32;
        byte[] raw = this.file;
        if (dt == "Q8_0") {
            int p = this.ValidateSlice(info, (long)blocks * 34L);
            for (int b = 0; b < blocks; b = b + 1) {
                int base2 = b * 32;
                float d = FloatBits.FromF16Bits((raw[p] & 255) | ((raw[p + 1] & 255) << 8));
                p = p + 2;
                for (int i = 0; i < 32; i = i + 1) {
                    int v = raw[p + i] & 255;
                    if (v >= 128) { v = v - 256; }
                    out2[base2 + i] = (float)v * d;
                }
                p = p + 32;
            }
            return;
        }
        if (dt == "Q4_0") {
            int p = this.ValidateSlice(info, (long)blocks * 18L);
            for (int b = 0; b < blocks; b = b + 1) {
                int base2 = b * 32;
                float scale = FloatBits.FromF16Bits((raw[p] & 255) | ((raw[p + 1] & 255) << 8));
                p = p + 2;
                for (int j = 0; j < 16; j = j + 1) {
                    int qs = raw[p + j] & 255;
                    out2[base2 + j] = (float)((qs & 15) - 8) * scale;
                    out2[base2 + j + 16] = (float)(((qs >> 4) & 15) - 8) * scale;
                }
                p = p + 16;
            }
            return;
        }
        if (dt == "Q4_1") {
            int p = this.ValidateSlice(info, (long)blocks * 20L);
            for (int b = 0; b < blocks; b = b + 1) {
                int base2 = b * 32;
                float scale = FloatBits.FromF16Bits((raw[p] & 255) | ((raw[p + 1] & 255) << 8));
                float minv = FloatBits.FromF16Bits((raw[p + 2] & 255) | ((raw[p + 3] & 255) << 8));
                p = p + 4;
                for (int j = 0; j < 16; j = j + 1) {
                    int qs = raw[p + j] & 255;
                    out2[base2 + j] = (float)(qs & 15) * scale + minv;
                    out2[base2 + j + 16] = (float)((qs >> 4) & 15) * scale + minv;
                }
                p = p + 16;
            }
            return;
        }
        if (dt == "Q5_0") {
            int p = this.ValidateSlice(info, (long)blocks * 22L);
            for (int b = 0; b < blocks; b = b + 1) {
                int base2 = b * 32;
                float scale = FloatBits.FromF16Bits((raw[p] & 255) | ((raw[p + 1] & 255) << 8));
                long mask = (long)(raw[p + 2] & 255) | ((long)(raw[p + 3] & 255) << 8)
                          | ((long)(raw[p + 4] & 255) << 16) | ((long)(raw[p + 5] & 255) << 24);
                p = p + 6;
                for (int j = 0; j < 16; j = j + 1) {
                    int qs = raw[p + j] & 255;
                    int xh0 = (int)(((mask >> j) << 4) & 16);
                    int xh1 = (int)((mask >> (j + 12)) & 16);
                    out2[base2 + j] = (float)(((qs & 15) | xh0) - 16) * scale;
                    out2[base2 + j + 16] = (float)((((qs >> 4) & 15) | xh1) - 16) * scale;
                }
                p = p + 16;
            }
            return;
        }
        // Q5_1
        int p5 = this.ValidateSlice(info, (long)blocks * 24L);
        for (int b = 0; b < blocks; b = b + 1) {
            int base2 = b * 32;
            float scale = FloatBits.FromF16Bits((raw[p5] & 255) | ((raw[p5 + 1] & 255) << 8));
            float minv = FloatBits.FromF16Bits((raw[p5 + 2] & 255) | ((raw[p5 + 3] & 255) << 8));
            long mask = (long)(raw[p5 + 4] & 255) | ((long)(raw[p5 + 5] & 255) << 8)
                      | ((long)(raw[p5 + 6] & 255) << 16) | ((long)(raw[p5 + 7] & 255) << 24);
            p5 = p5 + 8;
            for (int j = 0; j < 16; j = j + 1) {
                int qs = raw[p5 + j] & 255;
                int xh0 = (int)(((mask >> j) << 4) & 16);
                int xh1 = (int)((mask >> (j + 12)) & 16);
                out2[base2 + j] = (float)((qs & 15) | xh0) * scale + minv;
                out2[base2 + j + 16] = (float)(((qs >> 4) & 15) | xh1) * scale + minv;
            }
            p5 = p5 + 16;
        }
    }
}
