using System;
using System.Text;
using System.Collections.Generic;

namespace Ai.Tensor;

public static class ByteTokenizer {
    public const int Bos = 256;
    public const int Eos = 257;
    public const int VocabSize = 258;

    public static List<int> Encode(string text, bool addBos = true, bool addEos = false) {
        byte[] bytes = Encoding.GetBytes(text);
        List<int> tokens = new List<int>();
        if (addBos) { tokens.Add(ByteTokenizer.Bos); }
        for (int i = 0; i < bytes.Length; i = i + 1) {
            tokens.Add(bytes[i] & 255);
        }
        if (addEos) { tokens.Add(ByteTokenizer.Eos); }
        return tokens;
    }

    public static string Decode(List<int> tokens) {
        if (tokens == null) { throw new ArgumentException("tokens are required"); }
        byte[] bytes = new byte[tokens.Count];
        int count = 0;
        for (int i = 0; i < tokens.Count; i = i + 1) {
            int token = tokens[i];
            if (token == ByteTokenizer.Bos || token == ByteTokenizer.Eos) { continue; }
            if (token < 0 || token >= ByteTokenizer.Bos) {
                throw new ArgumentException("invalid byte token ID: " + Convert.ToString(token));
            }
            bytes[count] = (byte)token;
            count = count + 1;
        }
        return Encoding.GetString(bytes, 0, count);
    }
}
