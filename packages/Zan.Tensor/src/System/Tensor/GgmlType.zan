using System;

namespace System.Tensor;

// ggml 的张量类型表（GGUF 里存的是这些编号）。
//
// 编号与 llama.cpp 的 ggml_type 一致；这里只登记"名字 / 块大小 / 每块字节
// 数"三件事——解量化需要的位级布局另在 WeightFile 里按类型分派。
//
// K 量化（Q2_K…Q8_K）与 IQ 系列登记了名字与尺寸但**不支持解量化**：
// 它们的位级布局要按 6 元素一组的多级缩放来解，纯 Zan 实现容易错，
// 宁可明确报错也不要给一个悄悄错的值。
public class GgmlType {
    // 类型名（找不到时返回 "?"，并由调用方判断是否支持）。
    public static string Name(int id) {
        if (id == 0) { return "F32"; }
        if (id == 1) { return "F16"; }
        if (id == 2) { return "Q4_0"; }
        if (id == 3) { return "Q4_1"; }
        if (id == 6) { return "Q5_0"; }
        if (id == 7) { return "Q5_1"; }
        if (id == 8) { return "Q8_0"; }
        if (id == 9) { return "Q8_1"; }
        if (id == 10) { return "Q2_K"; }
        if (id == 11) { return "Q3_K"; }
        if (id == 12) { return "Q4_K"; }
        if (id == 13) { return "Q5_K"; }
        if (id == 14) { return "Q6_K"; }
        if (id == 15) { return "Q8_K"; }
        if (id == 16) { return "IQ2_XXS"; }
        if (id == 17) { return "IQ2_XS"; }
        if (id == 18) { return "IQ3_XXS"; }
        if (id == 19) { return "IQ1_S"; }
        if (id == 20) { return "IQ4_NL"; }
        if (id == 21) { return "IQ3_S"; }
        if (id == 22) { return "IQ2_S"; }
        if (id == 23) { return "IQ4_XS"; }
        if (id == 24) { return "I8"; }
        if (id == 25) { return "I16"; }
        if (id == 26) { return "I32"; }
        if (id == 27) { return "I64"; }
        if (id == 28) { return "F64"; }
        if (id == 29) { return "IQ1_M"; }
        if (id == 30) { return "BF16"; }
        return "?";
    }

    // 一个块里的元素个数（量化类型的块；非量化为 1）。
    public static int BlockSize(int id) {
        if (id == 2 || id == 3 || id == 6 || id == 7 || id == 8 || id == 9
            || id == 20) {
            return 32;
        }
        if (id >= 10 && id <= 23) { return 256; }
        if (id == 29) { return 256; }
        return 1;
    }

    // 一个块占多少字节。
    public static int BlockBytes(int id) {
        if (id == 0) { return 4; }
        if (id == 1) { return 2; }
        if (id == 2) { return 18; }
        if (id == 3) { return 20; }
        if (id == 6) { return 22; }
        if (id == 7) { return 24; }
        if (id == 8) { return 34; }
        if (id == 9) { return 36; }
        if (id == 10) { return 84; }
        if (id == 11) { return 110; }
        if (id == 12) { return 144; }
        if (id == 13) { return 176; }
        if (id == 14) { return 210; }
        if (id == 15) { return 292; }
        if (id == 16) { return 66; }
        if (id == 17) { return 74; }
        if (id == 18) { return 98; }
        if (id == 19) { return 50; }
        if (id == 20) { return 18; }
        if (id == 21) { return 110; }
        if (id == 22) { return 82; }
        if (id == 23) { return 136; }
        if (id == 24) { return 1; }
        if (id == 25) { return 2; }
        if (id == 26) { return 4; }
        if (id == 27) { return 8; }
        if (id == 28) { return 8; }
        if (id == 29) { return 56; }
        if (id == 30) { return 2; }
        return 0;
    }

    // 整个张量占多少字节（元素数必须是块大小的整数倍）。
    public static long ByteLength(int id, long count) {
        int block = BlockSize(id);
        int bytes = BlockBytes(id);
        if (bytes == 0) { return 0; }
        if (count % block != 0) {
            throw new Exception("GGUF tensor element count "
                + Convert.ToString(count) + " is not a multiple of block size "
                + Convert.ToString(block) + " for type " + Name(id));
        }
        return (count / block) * (long)bytes;
    }

    // 能不能解成 f32。
    public static bool Supported(int id) {
        if (id == 0 || id == 1 || id == 30) { return true; }
        if (id == 2 || id == 3 || id == 6 || id == 7 || id == 8) { return true; }
        if (id == 24 || id == 25 || id == 26 || id == 27 || id == 28) {
            return true;
        }
        return false;
    }
}
