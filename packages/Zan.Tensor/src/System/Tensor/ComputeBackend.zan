using System;
using System.Collections.Generic;

namespace System.Tensor;

// 计算后端契约：把矩阵乘这类重活交给加速后端（GPU）。
//
// 约定：
// - 后端只处理**连续行主序**的张量（转置/切片请先物化成连续张量）；
// - 输出写进调用方给的结果张量，后端不分配内存；
// - IsAvailable() 为假（没装驱动、没设备）时由 CPU 参考实现兜底，
//   调用方不必区分两条路径。
public interface IComputeBackend {
    // 后端名字（诊断用）。
    string Name();

    // 当前机器上这个后端能不能用。
    bool IsAvailable();

    // 矩阵乘：结果[m,n] = a[m,k] · b[k,n]（a、b 均为二维）。
    void MatMul(Tensor a, Tensor b, Tensor res);
}

// 后端登记处。默认没有加速后端（纯 CPU 参考实现）；装上 GPU 后端后
// 调 Use(...) 挂上即可，张量算子会自动走它。
public class ComputeBackendRegistry {
    // 当前后端（null 表示只用 CPU 参考实现）。
    public static IComputeBackend backend;

    // 挂载后端。
    public static void Use(IComputeBackend b) {
        ComputeBackendRegistry.backend = b;
    }

    // 卸掉后端（回到纯 CPU 参考实现）。
    public static void Clear() {
        ComputeBackendRegistry.backend = null;
    }

    // 取当前后端（可能为 null）。
    public static IComputeBackend Current() {
        return ComputeBackendRegistry.backend;
    }

    // 诊断用：当前实际生效的后端名。
    public static string ActiveName() {
        IComputeBackend b = ComputeBackendRegistry.backend;
        if (b == null) { return "cpu"; }
        if (!b.IsAvailable()) { return "cpu (" + b.Name() + " 不可用)"; }
        return b.Name();
    }
}
