using System;

namespace System.Tensor;

// 浮点位型 ↔ 数值的精确换算：f32 / f16 / bf16。
// 底层直接基于编译器内建的 NativeMemory.AsF32 进行纯位移零开销还原。
//
// 精确性：次正规数、±∞、NaN、-0.0 都按 IEEE-754 还原。f16 / bf16 的
// 每一个值都能被 f32 精确表示，所以转成 f32 无损。
public class FloatBits {
    // 32 位 IEEE-754 位型 → float（编译器内建 bitcast，零开销）。
    public static float FromF32Bits(long bits) {
        return NativeMemory.AsF32((int)bits);
    }

    // 16 位 IEEE-754（半精度）位型 → float。
    public static float FromF16Bits(int bits) {
        int sign = (bits >> 15) & 1;
        int exp = (bits >> 10) & 31;
        int mant = bits & 1023;

        // ±∞ / NaN
        if (exp == 31) {
            if (mant == 0) {
                return sign == 1 ? NativeMemory.AsF32((int)0xFF800000) : NativeMemory.AsF32(0x7F800000);
            }
            return NativeMemory.AsF32(0x7FC00000);
        }

        // 次正规数与 ±0.0
        if (exp == 0) {
            if (mant == 0) {
                return sign == 1 ? NativeMemory.AsF32((int)0x80000000) : 0.0f;
            }
            double v = (double)mant * 5.960464477539063e-8;
            return sign == 1 ? (float)(0.0 - v) : (float)v;
        }

        // 规格化数：直接位移重编为 f32 位型（无浮点乘除、无内存分配）
        int f32bits = (sign << 31) | ((exp + 112) << 23) | (mant << 13);
        return NativeMemory.AsF32(f32bits);
    }

    // bfloat16：位型就是 f32 的高 16 位（左移 16 位即得 f32 位型）。
    public static float FromBF16Bits(int bits) {
        return NativeMemory.AsF32(bits << 16);
    }
}
