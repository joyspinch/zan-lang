using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

namespace Gui.Hmi;

// 报警列表（alarm list）：时间 / 级别 / 位号 / 描述 / 状态五列，
// 未确认行以优先级色底显示，点击行选中。
[GuiKind("AlarmList")]
public class AlarmList : Control {
    public override Control CreateCloneShell() { return new AlarmList(); }
    // 数据源（可与 AlarmBanner 共享同一份报警）。
    public AlarmBuffer buffer;
    private List<AlarmListRow> visibleRows;
    // 当前选中行下标（-1 = 无）。
    public int selected;
    // 选中行变化时触发。
    public UiEvent RowClick;

    // 自带缓冲区（设计器 / 表单编译路径用）。
    public AlarmList() : this(new AlarmBuffer()) { }

    // 换绑缓冲区（与 AlarmBanner 共享同一份报警）。
    public void Bind(AlarmBuffer buf) { buffer = buf; }

    // 当前绑定的缓冲区。
    public AlarmBuffer Buffer() { return buffer; }

    // 共享缓冲区构造。
    public AlarmList(AlarmBuffer buf) {
        this.InitControl("alarmList");
        buffer = buf;
        visibleRows = new List<AlarmListRow>();
        selected = -1;
        wiresOwnEvents = true;
        RowClick = new UiEvent();
    }

    // 当前选中行下标（-1 = 无选中）。
    public int Selected() { return selected; }
    // 选中的报警记录；无选中或下标越界返回 null。
    public AlarmItem SelectedItem() {
        if (selected < 0 || selected >= buffer.Count()) { return null; }
        return buffer.At(selected);
    }

    // 控件类型标识（序列化/设计器用）。
    public override string Kind() { return "AlarmList"; }

    // 覆写：无设计器属性（内容由数据源驱动）。
    protected override List<PropSpec> DefineProps() {
        return new List<PropSpec>();
    }

    // 覆写：公共事件之外提供 "RowClick"。
    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("RowClick");
        return e;
    }

    // 覆写："RowClick" 挂 RowClick 事件，其余按名称走通用路由。
    public override void BindEvent(string evt, Action a) {
        if (evt == "RowClick") { RowClick.Add(a); return; }
        base.BindEvent(evt, a);
    }

    public override void BindEventS(string evt, ControlEvent handler) {
        if (evt == "RowClick") { RowClick.AddS(handler); return; }
        base.BindEventS(evt, handler);
    }

    public override void Arrange(int x, int y, int w, int h) {
        bx = x; by = y; bw = w > 0 ? w : 0; bh = h > 0 ? h : 0;
        App app = this.FindApp();
        if (app == null) { return; }
        int rowH = app.theme.heightSmall;
        if (rowH < 1) { return; }
        int count = buffer != null ? buffer.Count() : 0;
        int shown = bh > rowH ? (bh - rowH + rowH - 1) / rowH : 0;
        if (shown > count) { shown = count; }
        while (visibleRows.Count > shown) {
            AlarmListRow removed = visibleRows[visibleRows.Count - 1];
            visibleRows.RemoveAt(visibleRows.Count - 1);
            this.Remove(removed);
        }
        for (int i = 0; i < shown; i = i + 1) {
            int index = count - 1 - i;
            AlarmItem item = buffer.At(index);
            AlarmListRow row = i < visibleRows.Count ? visibleRows[i] : null;
            if (row == null || row.Item != item) {
                if (row != null) { this.Remove(row); }
                row = new AlarmListRow(this, item);
                if (i < visibleRows.Count) { visibleRows[i] = row; }
                else { visibleRows.Add(row); }
                this.Add(row);
            }
            row.Index = index;
            row.Arrange(bx, by + rowH * (i + 1), bw, rowH);
        }
    }

    internal void SelectRow(AlarmListRow row) {
        if (buffer == null || row.Parent() != this || row.Index < 0
            || row.Index >= buffer.Count() || buffer.At(row.Index) != row.Item) { return; }
        selected = row.Index;
        RowClick.RaiseS(this);
        App app = this.FindApp();
        if (app != null) { app.RequestRedraw(); }
    }

    // 覆写：固定首选尺寸 480 x 200（逻辑 px）。
    public override void OnMeasure(App app) {
        prefW = app.Scale(480);
        prefH = app.Scale(200);
    }

    // 覆写：画表头与五列报警行（最新在最上），点击行选中并触发 RowClick。
    public override void OnPaint(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = Style.FontFallback(app, "small");
        int rowH = t.heightSmall;
        c.FillRect(bx, by, bw, bh, Style.Part(app, "hmi", "panel", "", "", "", Style.SNormal()).BgOr(0));
        c.DrawRect(bx, by, bw, bh, Style.Part(app, "hmi", "panel", "", "", "", Style.SNormal()).BorderOr(0), 1);

        int c0 = bx + app.Scale(8);
        int c1 = c0 + app.Scale(76);
        int c2 = c1 + app.Scale(60);
        int c3 = c2 + app.Scale(110);
        int c4 = bx + bw - app.Scale(70);
        c.FillRect(bx, by, bw, rowH, Style.Part(app, "hmi", "track", "", "", "", Style.SNormal()).BgOr(0));
        c.DrawText(c0, by + rowH / 2 - Canvas.FontHeight(fs) / 2, "时间",
                   Style.Part(app, "hmi", "label", "", "", "", Style.SNormal()).FgOr(0), fs);
        c.DrawText(c1, by + rowH / 2 - Canvas.FontHeight(fs) / 2, "级别",
                   Style.Part(app, "hmi", "label", "", "", "", Style.SNormal()).FgOr(0), fs);
        c.DrawText(c2, by + rowH / 2 - Canvas.FontHeight(fs) / 2, "位号",
                   Style.Part(app, "hmi", "label", "", "", "", Style.SNormal()).FgOr(0), fs);
        c.DrawText(c3, by + rowH / 2 - Canvas.FontHeight(fs) / 2, "描述",
                   Style.Part(app, "hmi", "label", "", "", "", Style.SNormal()).FgOr(0), fs);
        c.DrawText(c4, by + rowH / 2 - Canvas.FontHeight(fs) / 2, "状态",
                   Style.Part(app, "hmi", "label", "", "", "", Style.SNormal()).FgOr(0), fs);


    }
}

internal class AlarmListRow : Button {
    private weak AlarmList owner;
    internal AlarmItem Item;
    internal int Index;

    internal AlarmListRow(AlarmList list, AlarmItem item) : base("") {
        owner = list;
        Item = item;
    }

    public override void OnClick(RoutedEventArgs e) {
        if (this.IsDisabled()) { return; }
        base.OnClick(e);
        AlarmList list = owner;
        if (list != null) { list.SelectRow(this); }
    }

    public override void OnPaint(App app) {
        AlarmList list = owner;
        if (list == null || this.Parent() != list) { return; }
        Canvas c = app.canvas;
        int fs = Style.FontFallback(app, "small");
        int col = AlarmItem.ColorOf(app, Item.Priority());
        int bg = Style.Part(app, "hmi", "panel", "", "", "", Style.SNormal()).BgOr(0);
        if (!Item.IsAcked()) { bg = App.LerpColor(bg, col, 28); }
        if (Index == list.Selected()) {
            bg = App.LerpColor(bg, Style.Part(app, "hmi", "accent", "", "", "", Style.SNormal()).BgOr(0), 22);
        }
        c.FillRect(bx, by, bw, bh, bg);
        c.DrawLine(bx, by + bh - 1, bx + bw, by + bh - 1,
            Style.Part(app, "hmi", "grid", "", "", "", Style.SNormal()).BgOr(0), 1);
        int ty = by + bh / 2 - Canvas.FontHeight(fs) / 2;
        int c0 = bx + app.Scale(8);
        int c1 = c0 + app.Scale(76);
        int c2 = c1 + app.Scale(60);
        int c3 = c2 + app.Scale(110);
        int c4 = bx + bw - app.Scale(70);
        int label = Style.Part(app, "hmi", "label", "", "", "", Style.SNormal()).FgOr(0);
        int value = Style.Part(app, "hmi", "value", "", "", "", Style.SNormal()).FgOr(0);
        c.DrawText(c0, ty, Item.Stamp(), label, fs);
        c.DrawText(c1, ty, AlarmItem.LevelOf(Item.Priority()), col, fs);
        c.DrawText(c2, ty, Item.Point(), value, fs);
        c.DrawText(c3, ty, Item.Message(), value, fs);
        string state = Item.IsActive() ? "活动" : "已复归";
        if (!Item.IsAcked()) { state = state + "*"; }
        c.DrawText(c4, ty, state, label, fs);
    }
}
