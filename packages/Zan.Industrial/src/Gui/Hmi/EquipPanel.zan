using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

namespace Gui.Hmi;

// 设备状态面板：一屏看完一条线上所有设备的卡片墙。它是
// 控件树里的容器，自己按可用宽度把 DeviceCard 排成卡片网格
// （列数随宽度自适应），因此窗口拉宽只是每行多放几张卡，
// 不用重新设计画面。
public class EquipPanel : Control {
    // 设备名列表，与 cards 按下标平行（Of 按它查找）。
    public List<string> names;
    // 设备卡片列表，与 names 按下标对应。
    public List<DeviceCard> cards;
    // 单张卡片的最小宽度（逻辑 px），决定自适应列数。
    public int cardW;
    // 单张卡片的逻辑高度（px）。
    public int cardH;
    // 卡片间距（逻辑 px）。
    public int gapPx;
    // 缩放后的单元尺寸（Arrange 拿不到 App，故在测量时算好）。
    public int cellW;
    public int cellH;
    public int cellGap;
    // 上一帧 Arrange 实际拿到的宽度。
    public int lastArrangeW;

    // 空设备墙（之后 AddDevice/SetItemsText）。
    public EquipPanel() {
        this.InitControl("equipPanel", 5);
        names = new List<string>();
        cards = new List<DeviceCard>();
        cardW = 240;
        cardH = 132;
        gapPx = 12;
        cellW = 240;
        cellH = 132;
        cellGap = 12;
    }

    // 设备卡片数量。
    public int Count() { return cards.Count; }

    // 追加一台设备，返回它的卡片以便挂数值行和点击处理。
    public DeviceCard AddDevice(string name) {
        DeviceCard c = new DeviceCard(name);
        names.Add(name);
        cards.Add(c);
        this.Add(c);
        return c;
    }

    // 第 i 张卡片；越界返回 null。
    public DeviceCard At(int i) {
        if (i < 0 || i >= cards.Count) { return null; }
        return cards[i];
    }

    // 按设备名取卡片；名称不存在时返回 null。
    public DeviceCard Of(string name) {
        for (int i = 0; i < names.Count; i = i + 1) {
            if (names[i] == name) { return cards[i]; }
        }
        return null;
    }

    // 按设备名写状态（0 停机 / 1 运行 / 2 报警 / 3 故障 / 4 离线）。
    public void Set(string name, int state) {
        DeviceCard c = this.Of(name);
        if (c != null) { c.Set(state); }
    }

    // 卡片尺寸（逻辑 px）；宽度是最小值，实际会拉伸填满整行。
    public EquipPanel CardSize(int w, int h) {
        if (w > 0) { cardW = w; }
        if (h > 0) { cardH = h; }
        return this;
    }

    // 按序列化文本重建设备清单：`"1# 泵|2# 泵|风机"`。
    public void SetItemsText(string spec) {
        List<string> parts = spec.Split("|");
        for (int i = 0; i < parts.Count; i = i + 1) {
            if (parts[i] == "") { continue; }
            this.AddDevice(parts[i]);
        }
    }

    // 控件类型标识（序列化/设计器用）。
    public override string Kind() { return "EquipPanel"; }

    // 覆写：返回设计器属性清单（卡片宽 / 卡片高）。
    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec w = PropSpec.Int("cardW", "Card width");
        w.num = cardW;
        ps.Add(w);
        PropSpec h = PropSpec.Int("cardH", "Card height");
        h.num = cardH;
        ps.Add(h);
        return ps;
    }

    // 覆写：缓存缩放后的单元尺寸，并按上一帧排布宽度推列数、行数回写首选尺寸。
    public override void OnMeasure(App app) {
        cellW = app.Scale(cardW);
        cellH = app.Scale(cardH);
        cellGap = app.Scale(gapPx);
        if (prefSet) { return; }
        prefW = cellW;
        int avail = lastArrangeW;
        if (avail < 1) { avail = hintWrapW; }
        if (avail < 1) { avail = prefW; }
        int cols = 1;
        if (avail > 0 && cellW > 0) {
            cols = (avail + cellGap) / (cellW + cellGap);
        }
        if (cols < 1) { cols = 1; }
        if (cols > cards.Count && cards.Count > 0) { cols = cards.Count; }
        int rows = (cards.Count + cols - 1) / cols;
        if (rows < 1) { rows = 1; }
        prefH = rows * cellH + (rows - 1) * cellGap;
    }

    // 卡片网格：按最小卡宽算出列数，再把剩余宽度均分给每列。
    public override void Arrange(int px, int py, int pw, int ph) {
        if (pw < 0) { pw = 0; }
        if (ph < 0) { ph = 0; }
        bx = px;
        by = py;
        bw = pw;
        bh = ph;
        lastArrangeW = pw;
        if (cards.Count == 0) { return; }
        int minW = cellW;
        if (minW < 1) { minW = 1; }
        int gap = cellGap;
        int cols = (pw + gap) / (minW + gap);
        if (cols < 1) { cols = 1; }
        if (cols > cards.Count) { cols = cards.Count; }
        int w = (pw - gap * (cols - 1)) / cols;
        if (w < 1) { w = 1; }
        int h = cellH;
        if (h < 1) { h = 1; }
        for (int i = 0; i < cards.Count; i = i + 1) {
            int col = i % cols;
            int row = i / cols;
            cards[i].Arrange(px + col * (w + gap), py + row * (h + gap), w, h);
        }
    }

    // 覆写：空面板时画一个可见的占位边框。
    public override void OnPaint(App app) {
        if (cards.Count != 0) { return; }
        Theme t = app.theme;
        app.canvas.DrawRoundRect(bx, by, bw, bh, t.borderRadiusMedium,
                                 Style.Part(app, "hmi", "panel", "", "", "", Style.SNormal()).BorderOr(0), 1);
    }
}
