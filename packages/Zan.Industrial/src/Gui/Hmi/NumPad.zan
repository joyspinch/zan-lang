using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

namespace Gui.Hmi;

// 屏幕数字键盘（on-screen numeric keypad）：工控机多为触摸屏、
// 无实体键盘，改设定值靠它。键盘自己维护输入缓冲，确认时把
// 缓冲按位号的刻度换算成原始计数写入。
public class NumPad : Control {
    // 输入缓冲（显示文本，尚未按位号刻度换算）。
    public Binding<string> Text;
    // 确认（ENT）时写入的目标位号；null = 无目标，结果留在缓冲。
    public IoTag target;
    private List<Button> keys;
    // 允许输入负号与小数点。
    public bool allowSign;
    // 允许输入小数点；整个缓冲只允许一个小数点。
    public bool allowDot;
    // 确认（ENT）时触发。
    [Event]
    public UiEvent Submit;
    // 取消（ESC）时触发。
    [Event]
    public UiEvent Cancel;

    // 默认设计期构造：允许负号与小数点，无目标位号。
    public NumPad() {
        this.InitControl("numPad", 0);
        Text = "";
        target = null;
        allowSign = true;
        allowDot = true;
        wiresOwnEvents = true;
        Submit = new UiEvent();
        Cancel = new UiEvent();
        keys = new List<Button>();
        for (int i = 0; i < 15; i = i + 1) {
            string label = i < 12 ? this.KeyAt(i) : (i == 12 ? "+/-" : (i == 13 ? "CLR" : "ENT"));
            NumPadKey key = new NumPadKey(this, label);
            key.ClassName = i == 14 ? "primary" : (i == 13 ? "warning" : "");
            keys.Add(key);
            this.Add(key);
        }
    }

    // 覆盖缓冲文本（不触发 Submit）。
    public void SetText(string s) { Text.Set(s); }
    // 清空缓冲。
    public void Clear() { Text.Set(""); }

    // 确认时写入的位号（同时把它的当前值预置进缓冲）。
    public NumPad Target(IoTag t) {
        target = t;
        Text.Set(t.Text());
        return this;
    }

    // 控件类型标识（序列化/设计器用）。
    public override string Kind() { return "NumPad"; }

    public override int InputFocusCapabilities() { return 1; }

    public override void OnKeyDown(RoutedEventArgs e) {
        if (this.IsDisabled()) { return; }
        if (e.keyCode == 13) { this.Press("ENT"); }
        else if (e.keyCode == 27) { Cancel.Raise(this); }
        else if (e.keyCode == 8) { this.Press("←"); }
        else { base.OnKeyDown(e); return; }
        e.Handle();
    }

    public override void Arrange(int x, int y, int w, int h) {
        bx = x; by = y; bw = w > 0 ? w : 0; bh = h > 0 ? h : 0;
        App app = this.FindApp();
        if (app == null) { return; }
        int pad = app.Scale(8);
        int gap = app.Scale(4);
        int top = by + pad * 2 + app.theme.heightLarge;
        int rowH = (bh - (top - by) - pad - gap * 4) / 5;
        int colW = (bw - pad * 2 - gap * 2) / 3;
        for (int i = 0; i < keys.Count; i = i + 1) {
            Button key = keys[i];
            key.Visible = (i != 10 || allowDot) && (i != 12 || allowSign);
            key.Arrange(bx + pad + (i % 3) * (colW + gap),
                top + (i / 3) * (rowH + gap), colW, rowH);
        }
    }

    // 覆写：返回设计器属性清单（输入缓冲 / 允许负号 / 允许小数点）。
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec v = PropSpec.Text("value", "Entry");
        v.Field("Text", 0);
        ps.Add(v);
        PropSpec sg = PropSpec.Bool("sign", "Allow sign");
        sg.Field("allowSign", 2);
        ps.Add(sg);
        PropSpec dt = PropSpec.Bool("dot", "Allow decimal point");
        dt.Field("allowDot", 2);
        ps.Add(dt);
        return ps;
    }

    // 覆写：固定首选尺寸 200 x 260（逻辑 px）。
    public override void OnMeasure(App app) {
        prefW = app.Scale(200);
        prefH = app.Scale(260);
    }

    // 第 i 个键的文字（4 行 x 3 列）。
    public string KeyAt(int i) {
        List<string> keys = new List<string>{ "7", "8", "9",
                                              "4", "5", "6",
                                              "1", "2", "3",
                                              "0", ".", "←" };
        return keys[i];
    }

    // 覆写：画输入显示屏、4x3 数字键盘与 +/-、CLR、ENT 底行。
    public override void OnPaint(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = Style.FontFallback(app, "large");
        int rad = t.borderRadiusMedium;
        c.FillRoundRect(bx, by, bw, bh, rad, Style.Part(app, "hmi", "panel", "", "", "", Style.SNormal()).BgOr(0));
        c.DrawRoundRect(bx, by, bw, bh, rad, Style.Part(app, "hmi", "panel", "", "", "", Style.SNormal()).BorderOr(0), 1);

        int pad = app.Scale(8);
        int dispH = t.heightLarge;
        c.FillRoundRect(bx + pad, by + pad, bw - pad * 2, dispH,
                        t.borderRadiusSmall, App.Darken(Style.Part(app, "hmi", "track", "", "", "", Style.SNormal()).BgOr(0), 20));
        string shown = Text.Get();
        if (shown == "") { shown = "0"; }
        c.DrawText(bx + pad * 2, by + pad + dispH / 2 - Canvas.FontHeight(fs) / 2,
                   shown, Style.Part(app, "hmi", "value", "", "", "", Style.SNormal()).FgOr(0), fs);
        if (target != null && target.Unit() != "") {
            int fsS = Style.FontFallback(app, "small");
            string u = target.Unit();
            c.DrawText(bx + bw - pad * 2 - Canvas.MeasureText(u, fsS),
                       by + pad + dispH / 2 - Canvas.FontHeight(fsS) / 2,
                       u, Style.Part(app, "hmi", "hint", "", "", "", Style.SNormal()).FgOr(0), fsS);
        }

    }

    // 处理一次按键，`label` 即键面文字。
    public void Press(string label) {
        string s = Text.Get();
        if (label == "ENT") {
            this.Commit();
            Submit.Raise(this);
            return;
        }
        if (label == "CLR") {
            Text.Set("");
            return;
        }
        if (label == "←") {
            if (s.Length > 0) { Text.Set(s.Substring(0, s.Length - 1)); }
            return;
        }
        if (label == "+/-") {
            if (!allowSign) { return; }
            if (s.Length > 0 && s.Substring(0, 1) == "-") {
                Text.Set(s.Substring(1, s.Length - 1));
            } else {
                Text.Set("-" + s);
            }
            return;
        }
        if (label == ".") {
            if (!allowDot || s.IndexOf(".") >= 0) { return; }
            if (s == "") { Text.Set("0."); return; }
            Text.Set(s + ".");
            return;
        }
        Text.Set(s + label);
    }

    // 把输入缓冲按目标位号的刻度换算并写入。
    public void Commit() {
        if (target == null) { return; }
        target.SetRaw(NumPad.Parse(Text.Get(), target.Scale()));
    }

    // "12.34" + scale=100 -> 1234。多余的小数位截断，缺位补零。
    public static int Parse(string s, int scale) {
        if (scale < 1) { scale = 1; }
        bool neg = false;
        string body = s;
        if (body.Length > 0 && body.Substring(0, 1) == "-") {
            neg = true;
            body = body.Substring(1, body.Length - 1);
        }
        int dot = body.IndexOf(".");
        string whole = body;
        string frac = "";
        if (dot >= 0) {
            whole = body.Substring(0, dot);
            frac = body.Substring(dot + 1, body.Length - dot - 1);
        }
        if (whole == "") { whole = "0"; }
        int digits = IoTag.Digits(scale);
        while (frac.Length < digits) { frac = frac + "0"; }
        if (frac.Length > digits) { frac = frac.Substring(0, digits); }
        int v = Convert.ToInt32(whole) * scale;
        if (digits > 0 && frac != "") { v = v + Convert.ToInt32(frac); }
        if (neg) { v = 0 - v; }
        return v;
    }
}

internal class NumPadKey : Button {
    private weak NumPad owner;

    internal NumPadKey(NumPad pad, string label) : base(label) { owner = pad; }

    public override void OnClick(RoutedEventArgs e) {
        if (this.IsDisabled()) { return; }
        base.OnClick(e);
        NumPad pad = owner;
        if (pad != null && this.Parent() == pad) { pad.Press(this.Label()); }
    }
}
