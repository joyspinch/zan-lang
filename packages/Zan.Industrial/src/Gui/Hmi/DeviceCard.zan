using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Hmi;

public class DeviceCard : Control {
    // 设备名（卡片左上标题）。
    public string title;
    // 设备状态（0 停机 / 1 运行 / 2 报警 / 3 故障 / 4 离线）。
    public SignalInt state;
    // 强类型数据行实体列表（唯一主表示）。
    public List<DeviceCardRow> rows;
    // 整卡命中 id（点击时触发 Click）。
    public int wid;
    // 卡片被点击时触发（一般用于打开设备详情）。
    public UiEvent Click;

    public DeviceCard() : this("") { }

    // 以设备名构造空卡片（数据行经 Row 追加）。
    public DeviceCard(string name) {
        this.InitControl("deviceCard", 0);
        title = name;
        state = new SignalInt(0);
        rows = new List<DeviceCardRow>();
        wid = WidgetId.Next();
        wiresOwnEvents = true;
        Click = new UiEvent();
    }

    // 设备状态信号访问器。
    public SignalInt State() { return state; }
    // 写入设备状态（取值见类注释）。
    public void Set(int st) { state.Set(st); }
    // 数据行数。
    public int RowCount() { return rows.Count; }

    // 强类型实体主方法：追加一行实体。
    public DeviceCard AddRow(DeviceCardRow r) {
        if (r != null) {
            rows.Add(r);
        }
        return this;
    }

    // 追加一行"名称 : 数值"。
    public DeviceCard Row(string label, IoTag t) {
        return this.AddRow(new DeviceCardRow(label, t));
    }

    // 控件类型标识（序列化/设计器用）。
    public override string Kind() { return "DeviceCard"; }

    // 覆写：仅公共事件（点击语义走 Click）。
    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        return e;
    }

    // 覆写：返回设计器属性清单（设备名 / 状态信号）。
    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec ti = PropSpec.Text("label", "Title");
        ti.str = title;
        ps.Add(ti);
        PropSpec st = PropSpec.Int("state", "State");
        st.snum = state;
        ps.Add(st);
        return ps;
    }

    // 状态文字。
    public static string TextOf(int st) {
        if (st == 1) { return "运行"; }
        if (st == 2) { return "报警"; }
        if (st == 3) { return "故障"; }
        if (st == 4) { return "离线"; }
        return "停机";
    }

    // 覆写：首选高度 = 标题行 + 数据行数 x 行高 + 边距。
    public override void OnMeasure(App app) {
        prefW = app.Scale(240);
        prefH = app.theme.heightLarge
                + app.Scale(22) * rows.Count + app.Scale(24);
    }

    // 覆写：画设备名、状态芯片、左侧状态色条与数据行，整卡可点击。
    public override void OnPaint(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int rad = t.borderRadiusMedium;
        int st = state.Get();
        int col = Led.ColorOf(app, st);
        int hv = Ui.HoverLevelMsIn(app, wid, 0, bx, by, bw, bh);
        c.FillRoundRect(bx, by, bw, bh, rad,
                        App.LerpColor(Style.Part(app, "hmi", "panel", "", "", "", Style.SNormal()).BgOr(0), Style.Part(app, "hmi", "track", "", "", "", Style.SHover()).BgOr(0), hv));
        c.DrawRoundRect(bx, by, bw, bh, rad, Style.Part(app, "hmi", "panel", "", "", "", Style.SNormal()).BorderOr(0), 1);
        // 左侧状态色条，远距离一眼看出设备状态。
        c.FillRect(bx, by + rad, app.Scale(4), bh - rad * 2, col);

        int pad = app.Scale(10);
        int fsT = Style.FontFallback(app, "medium");
        int fs = Style.FontFallback(app, "small");
        c.DrawText(bx + pad + app.Scale(4), by + pad, title, Style.Part(app, "hmi", "value", "", "", "", Style.SNormal()).FgOr(0), fsT);
        string sTxt = DeviceCard.TextOf(st);
        int chipW = Canvas.MeasureText(sTxt, fs) + app.Scale(16);
        int chipH = Canvas.FontHeight(fs) + app.Scale(6);
        int chipX = bx + bw - pad - chipW;
        c.FillRoundRect(chipX, by + pad, chipW, chipH, chipH / 2,
                        App.LerpColor(Style.Part(app, "hmi", "track", "", "", "", Style.SNormal()).BgOr(0), col, 35));
        c.DrawTextCentered(chipX, by + pad, chipW, chipH, sTxt, col, fs);

        int y = by + pad + chipH + app.Scale(8);
        for (int i = 0; i < rows.Count; i = i + 1) {
            if (y + app.Scale(18) > by + bh) { break; }
            DeviceCardRow r = rows[i];
            IoTag tg = r.tag;
            c.DrawText(bx + pad + app.Scale(4), y, r.name,
                       Style.Part(app, "hmi", "label", "", "", "", Style.SNormal()).FgOr(0), fs);
            string val = tg != null ? tg.TextWithUnit() : "----";
            if (tg != null && !tg.IsGood()) { val = "----"; }
            int vw = Canvas.MeasureText(val, fs);
            int vc = Style.Part(app, "hmi", "value", "", "", "", Style.SNormal()).FgOr(0);
            if (tg != null && tg.Alarm() != 0) { vc = Style.Part(app, "hmi", "status", "", "error", "", Style.SNormal()).BgOr(0); }
            c.DrawText(bx + bw - pad - vw, y, val, vc, fs);
            y = y + app.Scale(20);
        }

        app.hitTester.RegisterRect(wid, bx, by, bw, bh, 0);
        if (Ui.Clicked(app, wid)) {
            Click.RaiseS(this);
            app.RequestRedraw();
        }
        On.Fire(app, wid, this);
    }
}
