using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Hmi;

public class Bargraph : Control {
    // 标题（顶部，"" 不显示）。
    public string caption;
    // 数据位号；null = 用独立信号 raw。
    public IoTag tag;
    // 底层信号（条体长度跟随它的值）。
    public SignalInt raw;
    // 缩放：显示值 = 原始计数 / scale（1 = 不缩放）。
    public int scale;
    // 单位文本（读数后缀）；"" 不显示。
    public string unit;
    // 量程（原始计数）；rawMax ≤ rawMin 时被修正为 rawMin+1。
    public int rawMin;
    public int rawMax;
    // 报警限标线（原始计数）；相等 = 不画标线。
    public int loLimit;
    public int hiLimit;
    // 0 竖向（自下而而上），1 横向（自左向右）。
    public int orient;

    // 初始化：标题 + 数据源 + 量程/单位（同 Gauge 的参数约定）。
    public void InitBar(string text, IoTag t, SignalInt v, int sc, string u,
                 int lo, int hi) {
        this.InitControl("bargraph", 0);
        caption = text;
        tag = t;
        raw = v;
        scale = sc;
        if (scale < 1) { scale = 1; }
        unit = u;
        rawMin = lo;
        rawMax = hi;
        if (rawMax <= rawMin) { rawMax = rawMin + 1; }
        loLimit = 0;
        hiLimit = 0;
        orient = 0;
    }

    // 位号构造：量程/缩放/单位取自位号。
    public Bargraph(string text, IoTag t) {
        InitBar(text, t, t.Value(), t.Scale(), t.Unit(), t.Min(), t.Max());
    }

    // 独立信号构造：量程 lo..hi（原始计数），scale=1、无单位。
    public Bargraph(string text, SignalInt v, int lo, int hi) {
        InitBar(text, null, v, 1, "", lo, hi);
    }

    // 标题构造：内部自建信号，量程 0..100。
    public Bargraph(string text) {
        InitBar(text, null, new SignalInt(0), 1, "", 0, 100);
    }

    public Bargraph() {
        InitBar("", null, new SignalInt(0), 1, "", 0, 100);
    }

    // 方向常量：竖向（自下而上，0）。
    public static int Vertical() { return 0; }
    // 方向常量：横向（自左向右，1）。
    public static int Horizontal() { return 1; }

    // 底层信号访问器。
    public SignalInt Value() { return raw; }
    // 设方向（0 竖向 / 1 横向，链式）。
    public Bargraph Orient(int o) { orient = o; return this; }
    // 设量程（原始计数，hi ≤ lo 时修正为 lo+1；链式）。
    public Bargraph Range(int lo, int hi) {
        rawMin = lo;
        rawMax = hi;
        if (rawMax <= rawMin) { rawMax = rawMin + 1; }
        return this;
    }
    // 设报警限标线（原始计数；相等 = 不画，链式）。
    public Bargraph Limits(int lo, int hi) { loLimit = lo; hiLimit = hi; return this; }

    // 换绑位号（同步量程、缩放与单位）。
    public void Bind(IoTag t) {
        tag = t;
        raw = t.Value();
        scale = t.Scale();
        unit = t.Unit();
        rawMin = t.Min();
        rawMax = t.Max();
    }

    // 控件类型标识（序列化/设计器用）。
    public override string Kind() { return "Bargraph"; }

    // 覆写：返回设计器属性清单（标题 / 量程 / 数值信号 / 方向）。
    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec cap = PropSpec.Text("label", "Caption");
        cap.str = caption;
        ps.Add(cap);
        PropSpec lo = PropSpec.Int("min", "Min");
        lo.num = rawMin;
        ps.Add(lo);
        PropSpec hi = PropSpec.Int("max", "Max");
        hi.num = rawMax;
        ps.Add(hi);
        PropSpec v = PropSpec.Int("value", "Value");
        v.snum = raw;
        ps.Add(v);
        List<string> os = new List<string>{ "vertical", "horizontal" };
        PropSpec orp = PropSpec.Enum("orient", "Orientation", os);
        orp.num = orient;
        ps.Add(orp);
        return ps;
    }

    // 覆写：按方向给首选尺寸（横向 220 x 40，竖向 64 x 180）。
    public override void OnMeasure(App app) {
        if (orient == 1) {
            prefW = app.Scale(220);
            prefH = app.Scale(40);
        } else {
            prefW = app.Scale(64);
            prefH = app.Scale(180);
        }
    }

    // 当前值占量程的比例（千分比 0..1000）。
    public int Fraction() {
        int span = rawMax - rawMin;
        if (span <= 0) { return 0; }
        int p = (raw.Get() - rawMin) * 1000 / span;
        if (p < 0) { p = 0; }
        if (p > 1000) { p = 1000; }
        return p;
    }

    // 覆写：画轨道、按当前值比例填充、报警限标线与读数（横竖两向）。
    public override void OnPaint(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = Style.FontFallback(app, "small");
        int rad = t.borderRadiusSmall;
        int alarm = 0;
        if (tag != null) { alarm = tag.Alarm(); }
        int fill = Style.Part(app, "hmi", "status", "", "ok", "", Style.SNormal()).BgOr(0);
        if (alarm == 1) { fill = Style.Part(app, "hmi", "status", "", "", "", Style.SNormal()).BgOr(0); }
        if (alarm == 2) { fill = Style.Part(app, "hmi", "status", "", "error", "", Style.SNormal()).BgOr(0); }

        int capH = 0;
        if (caption != "") { capH = Canvas.FontHeight(fs) + app.Scale(4); }
        int valH = Canvas.FontHeight(fs) + app.Scale(4);
        if (caption != "") {
            c.DrawText(bx, by, caption, Style.Part(app, "hmi", "label", "", "", "", Style.SNormal()).FgOr(0), fs);
        }
        string txt = IoTag.Format(raw.Get(), scale);
        if (unit != "") { txt = txt + " " + unit; }

        int p = this.Fraction();
        if (orient == 1) {
            int trackY = by + capH;
            int trackH = bh - capH - valH;
            if (trackH < app.Scale(8)) { trackH = app.Scale(8); }
            c.FillRoundRect(bx, trackY, bw, trackH, rad,
                            App.Darken(Style.Part(app, "hmi", "track", "", "", "", Style.SNormal()).BgOr(0), 15));
            int fw = bw * p / 1000;
            c.FillRoundRect(bx, trackY, fw, trackH, rad, fill);
            c.DrawRoundRect(bx, trackY, bw, trackH, rad, Style.Part(app, "hmi", "panel", "", "", "", Style.SNormal()).BorderOr(0), 1);
            this.PaintLimitsH(app, bx, trackY, bw, trackH);
            c.DrawText(bx, trackY + trackH + app.Scale(2), txt,
                       Style.Part(app, "hmi", "value", "", "", "", Style.SNormal()).FgOr(0), fs);
        } else {
            int trackY = by + capH;
            int trackH = bh - capH - valH;
            if (trackH < app.Scale(8)) { trackH = app.Scale(8); }
            int trackW = bw / 3;
            if (trackW < app.Scale(12)) { trackW = app.Scale(12); }
            int tx = bx;
            c.FillRoundRect(tx, trackY, trackW, trackH, rad,
                            App.Darken(Style.Part(app, "hmi", "track", "", "", "", Style.SNormal()).BgOr(0), 15));
            int fh = trackH * p / 1000;
            c.FillRoundRect(tx, trackY + trackH - fh, trackW, fh, rad, fill);
            c.DrawRoundRect(tx, trackY, trackW, trackH, rad,
                            Style.Part(app, "hmi", "panel", "", "", "", Style.SNormal()).BorderOr(0), 1);
            this.PaintLimitsV(app, tx, trackY, trackW, trackH);
            c.DrawText(tx + trackW + app.Scale(6),
                       trackY + trackH / 2 - Canvas.FontHeight(fs) / 2,
                       txt, Style.Part(app, "hmi", "value", "", "", "", Style.SNormal()).FgOr(0), fs);
        }
    }

    // 值 v 在长度 len 上的位置（钳制到 0..len）。
    public int PosOf(int v, int len) {
        int span = rawMax - rawMin;
        if (span <= 0) { return 0; }
        int p = (v - rawMin) * len / span;
        if (p < 0) { p = 0; }
        if (p > len) { p = len; }
        return p;
    }

    // 竖条的报警限标线（低报蓝线、高报红线）。
    public void PaintLimitsV(App app, int x, int y, int w, int h) {
        if (loLimit == hiLimit) { return; }
        Canvas c = app.canvas;
        Theme t = app.theme;
        int lo = this.PosOf(loLimit, h);
        int hi = this.PosOf(hiLimit, h);
        c.DrawLine(x, y + h - lo, x + w, y + h - lo, Style.Part(app, "hmi", "status", "", "", "", Style.SNormal()).BgOr(0), 1);
        c.DrawLine(x, y + h - hi, x + w, y + h - hi, Style.Part(app, "hmi", "status", "", "error", "", Style.SNormal()).BgOr(0), 1);
    }

    // 横条的报警限标线（低报蓝线、高报红线）。
    public void PaintLimitsH(App app, int x, int y, int w, int h) {
        if (loLimit == hiLimit) { return; }
        Canvas c = app.canvas;
        Theme t = app.theme;
        int lo = this.PosOf(loLimit, w);
        int hi = this.PosOf(hiLimit, w);
        c.DrawLine(x + lo, y, x + lo, y + h, Style.Part(app, "hmi", "status", "", "", "", Style.SNormal()).BgOr(0), 1);
        c.DrawLine(x + hi, y, x + hi, y + h, Style.Part(app, "hmi", "status", "", "error", "", Style.SNormal()).BgOr(0), 1);
    }
}
