using System;
using Gui;
using Gui.Widget;

namespace Gui.Hmi;

/// <summary>
/// 指示灯（LED）：一个发光圆点加标题，上位机画面里表示
/// 运行 / 停止 / 故障 / 通信状态。状态用整数，因此可以直接
/// 绑定到位号：0 灭、1 绿（正常）、2 黄（警告）、3 红（故障）、
/// 4 蓝（信息）。
///
///   Led run = new Led("RUN");
///   run.state = tag.Value();          // 绑定位号
///   run.SetBlink(true);               // 故障闪烁
/// </summary>
class Led : Control {
    /// 标题文本；空串不画。
    string caption;
    /// 状态信号：0 灭 / 1 绿 / 2 黄 / 3 红 / 4 蓝。
    SignalInt state;
    /// 报警态（2/3）闪烁。
    bool blink;
    /// 圆点直径（逻辑 px，0 = 按字号自动）。
    int dotSize;

    /// 初始化：标题 + 状态信号（0 灭 / 1 绿 / 2 黄 / 3 红 / 4 蓝）。
    void InitLed(string text, SignalInt st) {
        this.InitControl("led", 0);
        caption = text;
        state = st;
        blink = false;
        dotSize = 0;
    }

    /// 标题 + 外部状态信号。
    Led(string text, SignalInt st) { InitLed(text, st); }
    /// 标题 + 内部自持信号（初始 0 = 灭）。
    Led(string text) { InitLed(text, new SignalInt(0)); }
    /// Placeable from the designer, which builds every control with no
    /// arguments and then applies the design's properties.
    Led() { InitLed("", new SignalInt(0)); }

    /// 状态读写 / 闪烁开关 / 标题文本 / 底层信号。
    int State() { return state.Get(); }
    /// 写状态值。
    void Set(int st) { state.Set(st); }
    /// 设置闪烁开关。
    void SetBlink(bool on) { blink = on; }
    /// 设置标题文本。
    void SetCaption(string s) { caption = s; }
    /// 底层状态信号。
    SignalInt Value() { return state; }

    /// 控件类型标识（序列化/设计器用）。
    override string Kind() { return "Led"; }

    /// 覆写：返回设计器属性清单（标题 / 状态信号 / 报警闪烁）。
    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec cap = PropSpec.Text("label", "Caption");
        cap.str = caption;
        ps.Add(cap);
        PropSpec st = PropSpec.Int("state", "State");
        st.snum = state;
        ps.Add(st);
        PropSpec bl = PropSpec.Bool("blink", "Blink on alarm");
        bl.flag = blink;
        ps.Add(bl);
        return ps;
    }

    /// 状态色：灭为边框灰，1 绿 2 黄 3 红 4 蓝。
    static int ColorOf(App app, int st) {
        string cls = "off";
        if (st == 1) { cls = "ok"; }
        if (st == 2) { cls = "warning"; }
        if (st == 3) { cls = "error"; }
        if (st == 4) { cls = ""; }
        return Style.Part(app, "hmi", "status", "", cls, "",
                          Style.SNormal()).BgOr(0);
    }

    /// 覆写：首选尺寸 = 圆点直径 + 标题宽，高度取 small 行高。
    override void OnMeasure(App app) {
        Theme t = app.theme;
        int d = this.Dot(app);
        prefH = t.heightSmall;
        prefW = d + app.Scale(6) + Canvas.MeasureText(caption, Style.FontFallback(app, "small"));
    }

    /// 圆点直径（缩放后的像素；未配置时用 12 基准值）。
    int Dot(App app) {
        if (dotSize > 0) { return app.Scale(dotSize); }
        return app.Scale(12);
    }

    /// 覆写：画状态圆点与标题；报警闪烁按半秒周期申请局部动画帧。
    override void OnPaint(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int st = state.Get();
        int d = this.Dot(app);
        int cx = bx + d / 2;
        int cy = by + bh / 2;
        int col = Led.ColorOf(app, st);
        bool lit = st != 0;
        if (lit && blink && (st == 2 || st == 3)) {
            // 半秒周期闪烁：亮半拍、暗半拍。用 App 的动画时钟，
            // 因此不需要宿主自己驱动定时器。
            if ((app.nowMs / 500) % 2 == 1) { lit = false; }
            // 只在下一个半秒边界要一帧，且只声明这颗灯自己的像素。
            // 这里原来是 RequestRedraw()：那既不限速（事件循环按最高
            // 帧率忙转，而画面每 500ms 才变一次），也不声明范围（一颗
            // 闪烁的灯就让整页每帧重新混合一遍）。
            int rem = 500 - (app.nowMs % 500);
            if (rem < 1) { rem = 1; }
            app.RequestAnimationFrameIn(rem, bx, by, bw, bh);
        }
        if (lit) {
            c.FillRadial(cx, cy, d, col, 90);
            c.FillCircle(cx, cy, d / 2, col);
        } else {
            c.FillCircle(cx, cy, d / 2, App.Darken(col, 55));
        }
        c.DrawCircle(cx, cy, d / 2, App.Darken(col, 30), 1);
        if (caption != "") {
            int fs = Style.FontFallback(app, "small");
            c.DrawText(bx + d + app.Scale(6),
                       cy - Canvas.FontHeight(fs) / 2,
                       caption, Style.Part(app, "hmi", "value", "", "", "", Style.SNormal()).FgOr(0), fs);
        }
    }
}

/// <summary>
/// 数显表（digital readout）：大字号数值 + 单位 + 标题，超限时
/// 数值转报警色。这是上位机画面上用得最多的一个件。
///
///   Digital pv = new Digital("TIC101 PV", tag);
/// </summary>
class Digital : Control {
    string caption;
    IoTag tag;
    /// 无位号时的自持值（原始计数）与刻度。
    SignalInt raw;
    /// 每工程单位的计数（显示值 = raw / scale，<1 按 1）。
    int scale;
    /// 工程单位后缀；空串不画。
    string unit;

    /// 初始化：标题 + 数据源（位号或独立信号）+ 缩放与单位。
    void InitDigital(string text, IoTag t, SignalInt v, int sc, string u) {
        this.InitControl("digital", 0);
        caption = text;
        tag = t;
        raw = v;
        scale = sc;
        if (scale < 1) { scale = 1; }
        unit = u;
    }

    /// 标题 + 绑定位号（缩放与单位取自位号）。
    Digital(string text, IoTag t) {
        InitDigital(text, t, t.Value(), t.Scale(), t.Unit());
    }

    /// 标题 + 独立信号 + 缩放与单位。
    Digital(string text, SignalInt v, int sc, string u) {
        InitDigital(text, null, v, sc, u);
    }

    /// 标题 + 内部自持信号（初始 0，缩放 1，无单位）。
    Digital(string text) {
        InitDigital(text, null, new SignalInt(0), 1, "");
    }

    /// Placeable from the designer, which builds every control with no
    /// arguments and then applies the design's properties.
    Digital() {
        InitDigital("", null, new SignalInt(0), 1, "");
    }

    /// 底层信号（换绑位号请用 <c>Bind</c>）。
    SignalInt Value() { return raw; }
    /// 换绑位号（同步缩放与单位）。
    void Bind(IoTag t) {
        tag = t;
        raw = t.Value();
        scale = t.Scale();
        unit = t.Unit();
    }

    /// 控件类型标识（序列化/设计器用）。
    override string Kind() { return "Digital"; }

    /// 覆写：返回设计器属性清单（标题 / 单位 / 缩放 / 数值信号）。
    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec cap = PropSpec.Text("label", "Caption");
        cap.str = caption;
        ps.Add(cap);
        PropSpec un = PropSpec.Text("unit", "Unit");
        un.str = unit;
        ps.Add(un);
        PropSpec sc = PropSpec.Int("scale", "Scale");
        sc.num = scale;
        ps.Add(sc);
        PropSpec v = PropSpec.Int("value", "Value");
        v.snum = raw;
        ps.Add(v);
        return ps;
    }

    /// 覆写：固定首选尺寸 150 x 72（逻辑 px）。
    override void OnMeasure(App app) {
        prefW = app.Scale(150);
        prefH = app.Scale(72);
    }

    /// 覆写：画数显面板、标题与工程量值；超限转报警色，坏质量显示 "----"。
    override void OnPaint(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int rad = t.borderRadiusMedium;
        c.FillRoundRect(bx, by, bw, bh, rad, App.Darken(Style.Part(app, "hmi", "track", "", "", "", Style.SNormal()).BgOr(0), 25));
        c.DrawRoundRect(bx, by, bw, bh, rad, Style.Part(app, "hmi", "panel", "", "", "", Style.SNormal()).BorderOr(0), 1);
        int pad = app.Scale(8);
        int fsCap = Style.FontFallback(app, "small");
        if (caption != "") {
            c.DrawText(bx + pad, by + pad, caption, Style.Part(app, "hmi", "label", "", "", "", Style.SNormal()).FgOr(0), fsCap);
        }
        int alarm = 0;
        bool good = true;
        if (tag != null) {
            alarm = tag.Alarm();
            good = tag.IsGood();
        }
        int col = Style.Part(app, "hmi", "value", "", "", "", Style.SNormal()).FgOr(0);
        if (alarm == 1) { col = Style.Part(app, "hmi", "status", "", "", "", Style.SNormal()).BgOr(0); }
        if (alarm == 2) { col = Style.Part(app, "hmi", "status", "", "error", "", Style.SNormal()).BgOr(0); }
        if (!good) { col = Style.Part(app, "hmi", "status", "", "off", "", Style.SNormal()).FgOr(0); }
        string txt = IoTag.Format(raw.Get(), scale);
        if (!good) { txt = "----"; }
        int fsVal = Style.FontFallback(app, "huge");
        int vy = by + bh - pad - Canvas.FontHeight(fsVal);
        c.DrawText(bx + pad, vy, txt, col, fsVal);
        if (unit != "") {
            int vw = Canvas.MeasureText(txt, fsVal);
            c.DrawText(bx + pad + vw + app.Scale(6),
                       vy + Canvas.FontHeight(fsVal) - Canvas.FontHeight(fsCap)
                           - app.Scale(2),
                       unit, Style.Part(app, "hmi", "hint", "", "", "", Style.SNormal()).FgOr(0), fsCap);
        }
    }
}
