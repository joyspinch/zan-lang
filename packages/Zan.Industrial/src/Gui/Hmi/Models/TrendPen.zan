using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

namespace Gui.Hmi;

// 一条趋势曲线：环形采样缓冲 + 颜色 + 位号。缓冲写满后自动
// 覆盖最旧的点，因此长时间运行不增长内存。
public class TrendPen {
    public string title;
    public IoTag tag;
    public SignalInt raw;
    public int color;
    public List<int> samples;
    public int capacity;
    // 下一个写入位置（环形缓冲）。
    public int head;
    public int filled;

    // 构造：笔名 + 位号 + 颜色 + 环形缓冲容量（<8 按 8）。
    public TrendPen(string name, IoTag t, int col, int cap) {
        title = name;
        tag = t;
        raw = t.Value();
        color = col;
        capacity = cap;
        if (capacity < 8) { capacity = 8; }
        samples = new List<int>();
        head = 0;
        filled = 0;
    }

    // 笔名 / 颜色 / 已存样本数 / 绑定的位号。
    public string Title() { return title; }
    // 本笔曲线颜色。
    public int Color() { return color; }
    // 已存样本数。
    public int Count() { return filled; }
    // 绑定的位号。
    public IoTag Point() { return tag; }

    // 采一个点（一般由画面的周期定时器统一调用）。
    public void Sample() {
        this.Push(raw.Get());
    }

    // 直写一个原始值进环形缓冲（不走位号）。
    public void Push(int v) {
        if (samples.Count < capacity) {
            samples.Add(v);
            filled = samples.Count;
            head = samples.Count % capacity;
            return;
        }
        samples[head] = v;
        head = (head + 1) % capacity;
        filled = capacity;
    }

    // 第 i 个点（0 = 最旧），按环形缓冲展开。
    public int At(int i) {
        if (filled < capacity) { return samples[i]; }
        return samples[(head + i) % capacity];
    }
}
