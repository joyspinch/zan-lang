using System;

namespace Gui.Hmi;

// 设备卡片数据行强类型实体：名称与位号绑定，消除平行列表反模式。
public class DeviceCardRow {
    public string name;
    public IoTag tag;

    public DeviceCardRow(string name, IoTag tag) {
        this.name = name != null ? name : "";
        this.tag = tag;
    }

    public static DeviceCardRow Of(string name, IoTag tag) {
        return new DeviceCardRow(name, tag);
    }
}
