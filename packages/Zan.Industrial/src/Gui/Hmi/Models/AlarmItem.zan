using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Hmi;

// 一条报警记录：发生时间、位号、描述、优先级和确认状态。
// 优先级 0 提示 / 1 警告 / 2 故障，决定颜色与排序。
public class AlarmItem {
    // 发生时间（ToTimeString 文本）。
    public string stamp;
    // 位号名。
    public string point;
    // 描述文本。
    public string message;
    // 优先级：0 提示 / 1 警告 / 2 故障。
    public int priority;
    // 是否已确认。
    public bool acked;
    // 报警是否仍然成立（复归后仍留在列表里，直到被确认）。
    public bool active;

    // 构造一条活动、未确认的报警（时间取当前时刻）。
    public AlarmItem(string tagName, string text, int prio) {
        stamp = DateTime.Now().ToTimeString();
        point = tagName;
        message = text;
        priority = prio;
        acked = false;
        active = true;
    }

    // 发生时间文本。
    public string Stamp() { return stamp; }
    // 位号名。
    public string Point() { return point; }
    // 描述文本。
    public string Message() { return message; }
    // 优先级。
    public int Priority() { return priority; }
    // 是否已确认。
    public bool IsAcked() { return acked; }
    // 报警是否仍成立。
    public bool IsActive() { return active; }
    // 确认（acked 置真）。
    public void Ack() { acked = true; }
    // 复归（active 置假；记录留在列表里直到确认并 Purge）。
    public void Clear() { active = false; }

    // 优先级颜色：2 故障红、1 警告黄、其它信息蓝。
    public static int ColorOf(App app, int prio) {
        string cls = "";
        if (prio >= 2) { cls = "error"; }
        else if (prio == 1) { cls = "warning"; }
        return Style.Part(app, "hmi", "status", "", cls, "",
                          Style.SNormal()).BgOr(0);
    }

    // 优先级文字：FAULT / WARN / INFO。
    public static string LevelOf(int prio) {
        if (prio >= 2) { return "FAULT"; }
        if (prio == 1) { return "WARN"; }
        return "INFO";
    }
}
