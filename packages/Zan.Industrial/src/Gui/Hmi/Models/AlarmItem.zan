using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Hmi;

// 一条报警记录：发生时间、位号、描述、优先级和确认状态。
// 优先级 0 提示 / 1 警告 / 2 故障，决定颜色与排序。
class AlarmItem {
    // 发生时间（ToTimeString 文本）。
    string stamp;
    // 位号名。
    string point;
    // 描述文本。
    string message;
    // 优先级：0 提示 / 1 警告 / 2 故障。
    int priority;
    // 是否已确认。
    bool acked;
    // 报警是否仍然成立（复归后仍留在列表里，直到被确认）。
    bool active;

    // 构造一条活动、未确认的报警（时间取当前时刻）。
    AlarmItem(string tagName, string text, int prio) {
        stamp = DateTime.Now().ToTimeString();
        point = tagName;
        message = text;
        priority = prio;
        acked = false;
        active = true;
    }

    // 发生时间文本。
    string Stamp() { return stamp; }
    // 位号名。
    string Point() { return point; }
    // 描述文本。
    string Message() { return message; }
    // 优先级。
    int Priority() { return priority; }
    // 是否已确认。
    bool IsAcked() { return acked; }
    // 报警是否仍成立。
    bool IsActive() { return active; }
    // 确认（acked 置真）。
    void Ack() { acked = true; }
    // 复归（active 置假；记录留在列表里直到确认并 Purge）。
    void Clear() { active = false; }

    // 优先级颜色：2 故障红、1 警告黄、其它信息蓝。
    static int ColorOf(App app, int prio) {
        string cls = "";
        if (prio >= 2) { cls = "error"; }
        else if (prio == 1) { cls = "warning"; }
        return Style.Part(app, "hmi", "status", "", cls, "",
                          Style.SNormal()).BgOr(0);
    }

    // 优先级文字：FAULT / WARN / INFO。
    static string LevelOf(int prio) {
        if (prio >= 2) { return "FAULT"; }
        if (prio == 1) { return "WARN"; }
        return "INFO";
    }
}

// 报警缓冲区：画面上的报警栏和报警列表共享同一个实例，
// 因此"确认"在两处同时生效。
// al.Raise("PT101", "压力高高", 2);
// al.Scan(io);              // 按位号限值自动产生 / 复归
