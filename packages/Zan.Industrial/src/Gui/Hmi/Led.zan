using System;
using Gui;
using Gui.Widget;

namespace Gui.Hmi;

// 指示灯（LED）：一个发光圆点加标题，上位机画面里表示
// 运行 / 停止 / 故障 / 通信状态。状态用整数，因此可以直接
// 绑定到位号：0 灭、1 绿（正常）、2 黄（警告）、3 红（故障）、
// 4 蓝（信息）。
// run.state = tag.Value();          // 绑定位号
// run.SetBlink(true);               // 故障闪烁
class Led : Control {
    // 标题文本；空串不画。
    string caption;
    // 状态信号：0 灭 / 1 绿 / 2 黄 / 3 红 / 4 蓝。
    SignalInt state;
    // 报警态（2/3）闪烁。
    bool blink;
    // 圆点直径（逻辑 px，0 = 按字号自动）。
    int dotSize;

    // 初始化：标题 + 状态信号（0 灭 / 1 绿 / 2 黄 / 3 红 / 4 蓝）。
    void InitLed(string text, SignalInt st) {
        this.InitControl("led", 0);
        caption = text;
        state = st;
        blink = false;
        dotSize = 0;
    }

    // 标题 + 外部状态信号。
    Led(string text, SignalInt st) { InitLed(text, st); }
    // 标题 + 内部自持信号（初始 0 = 灭）。
    Led(string text) { InitLed(text, new SignalInt(0)); }
    Led() { InitLed("", new SignalInt(0)); }

    // 状态读写 / 闪烁开关 / 标题文本 / 底层信号。
    int State() { return state.Get(); }
    // 写状态值。
    void Set(int st) { state.Set(st); }
    // 设置闪烁开关。
    void SetBlink(bool on) { blink = on; }
    // 设置标题文本。
    void SetCaption(string s) { caption = s; }
    // 底层状态信号。
    SignalInt Value() { return state; }

    // 控件类型标识（序列化/设计器用）。
    override string Kind() { return "Led"; }

    // 覆写：返回设计器属性清单（标题 / 状态信号 / 报警闪烁）。
    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec cap = PropSpec.Text("label", "Caption");
        cap.str = caption;
        ps.Add(cap);
        PropSpec st = PropSpec.Int("state", "State");
        st.snum = state;
        ps.Add(st);
        PropSpec bl = PropSpec.Bool("blink", "Blink on alarm");
        bl.flag = blink;
        ps.Add(bl);
        return ps;
    }

    // 状态色：灭为边框灰，1 绿 2 黄 3 红 4 蓝。
    static int ColorOf(App app, int st) {
        string cls = "off";
        if (st == 1) { cls = "ok"; }
        if (st == 2) { cls = "warning"; }
        if (st == 3) { cls = "error"; }
        if (st == 4) { cls = ""; }
        return Style.Part(app, "hmi", "status", "", cls, "",
                          Style.SNormal()).BgOr(0);
    }

    // 覆写：首选尺寸 = 圆点直径 + 标题宽，高度取 small 行高。
    override void OnMeasure(App app) {
        Theme t = app.theme;
        int d = this.Dot(app);
        prefH = t.heightSmall;
        prefW = d + app.Scale(6) + Canvas.MeasureText(caption, Style.FontFallback(app, "small"));
    }

    // 圆点直径（缩放后的像素；未配置时用 12 基准值）。
    int Dot(App app) {
        if (dotSize > 0) { return app.Scale(dotSize); }
        return app.Scale(12);
    }

    // 覆写：画状态圆点与标题；报警闪烁按半秒周期申请局部动画帧。
    override void OnPaint(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int st = state.Get();
        int d = this.Dot(app);
        int cx = bx + d / 2;
        int cy = by + bh / 2;
        int col = Led.ColorOf(app, st);
        bool lit = st != 0;
        if (lit && blink && (st == 2 || st == 3)) {
            // 半秒周期闪烁：亮半拍、暗半拍。用 App 的动画时钟，
            // 因此不需要宿主自己驱动定时器。
            if ((app.nowMs / 500) % 2 == 1) { lit = false; }
            // 只在下一个半秒边界要一帧，且只声明这颗灯自己的像素。
            int rem = 500 - (app.nowMs % 500);
            if (rem < 1) { rem = 1; }
            app.RequestAnimationFrameIn(rem, bx, by, bw, bh);
        }
        if (lit) {
            c.FillRadial(cx, cy, d, col, 90);
            c.FillCircle(cx, cy, d / 2, col);
        } else {
            c.FillCircle(cx, cy, d / 2, App.Darken(col, 55));
        }
        c.DrawCircle(cx, cy, d / 2, App.Darken(col, 30), 1);
        if (caption != "") {
            int fs = Style.FontFallback(app, "small");
            c.DrawText(bx + d + app.Scale(6),
                       cy - Canvas.FontHeight(fs) / 2,
                       caption, Style.Part(app, "hmi", "value", "", "", "", Style.SNormal()).FgOr(0), fs);
        }
    }
}
