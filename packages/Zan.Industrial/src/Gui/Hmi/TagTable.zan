using System;
using System.Collections.Generic;

namespace Gui.Hmi;

class TagTable {
    List<IoTag> tags;
    // 采集周期（毫秒），供宿主的定时器使用。
    int periodMs;

    // 空表；采集周期默认 500ms。
    TagTable() {
        tags = new List<IoTag>();
        periodMs = 500;
    }

    // 位号数量 / 按下标取位号。
    int Count() { return tags.Count; }
    // 返回第 i 个位号。
    IoTag At(int i) { return tags[i]; }
    // 采集周期（毫秒，默认 500）。
    int Period() { return periodMs; }
    // 设置采集周期（毫秒）；非正数忽略。
    void SetPeriod(int ms) { if (ms > 0) { periodMs = ms; } }

    // 声明一个位号（配对单位与定点缩放）。
    IoTag Add(string name, string unit, int scale) {
        IoTag t = new IoTag(name, unit, scale);
        tags.Add(t);
        return t;
    }

    // 无量纲整数位号（无单位、缩放 1）。
    IoTag Add(string name) { return this.Add(name, "", 1); }

    // 按名查找位号，没有则返回 null（调用方不要假定非空）。
    IoTag Of(string name) {
        for (int i = 0; i < tags.Count; i = i + 1) {
            if (tags[i].Name() == name) { return tags[i]; }
        }
        return null;
    }

    // 按名查找，不存在时按默认量程即时建立——数据驱动的
    // 画面加载时不必先声明全部位号。
    IoTag Ensure(string name) {
        IoTag t = this.Of(name);
        if (t != null) { return t; }
        return this.Add(name);
    }

    // 采集回调写值入口：按名写入，位号不存在时静默忽略。
    void Set(string name, int rawValue) {
        IoTag t = this.Of(name);
        if (t != null) { t.SetRaw(rawValue); }
    }

    // 按名标记坏值（位号不存在时静默忽略）。
    void SetBad(string name) {
        IoTag t = this.Of(name);
        if (t != null) { t.SetBad(); }
    }

    // 处于报警状态的位号数量（低报 + 高报）。
    int AlarmCount() {
        int n = 0;
        for (int i = 0; i < tags.Count; i = i + 1) {
            if (tags[i].Alarm() != 0) { n = n + 1; }
        }
        return n;
    }
}
