using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Hmi;

public class AlarmBuffer {
    // 记录列表（追加序，下标 0 最旧）。
    public List<AlarmItem> items;
    // 容量上限（超出时淘汰最旧记录）。
    public int limit;

    // 默认容量 500。
    public AlarmBuffer() {
        items = new List<AlarmItem>();
        limit = 500;
    }

    // 记录条数 / 按下标取记录（下标 0 最旧）。
    public int Count() { return items.Count; }
    // 第 i 条记录（不查越界）。
    public AlarmItem At(int i) { return items[i]; }

    // 未确认的报警条数（报警栏据此闪烁）。
    public int UnackedCount() {
        int n = 0;
        for (int i = 0; i < items.Count; i = i + 1) {
            if (!items[i].IsAcked()) { n = n + 1; }
        }
        return n;
    }

    // 最新一条未确认报警，没有则返回 null。
    public AlarmItem Newest() {
        for (int i = items.Count - 1; i >= 0; i = i - 1) {
            if (!items[i].IsAcked()) { return items[i]; }
        }
        return null;
    }

    // 产生一条报警；超出容量上限（默认 500）时淘汰最旧记录。
    public AlarmItem Raise(string tagName, string text, int prio) {
        AlarmItem a = new AlarmItem(tagName, text, prio);
        items.Add(a);
        while (items.Count > limit) { items.RemoveAt(0); }
        return a;
    }

    // 确认全部报警。
    public void AckAll() {
        for (int i = 0; i < items.Count; i = i + 1) { items[i].Ack(); }
    }

    // 移除已确认且已复归的记录。
    public void Purge() {
        List<AlarmItem> keep = new List<AlarmItem>();
        for (int i = 0; i < items.Count; i = i + 1) {
            AlarmItem a = items[i];
            if (!a.IsAcked() || a.IsActive()) { keep.Add(a); }
        }
        items = keep;
    }

    // 扫描位号表：越限的位号若还没有在册的活动报警就产生一条，
    // 回到限内则把对应记录置为已复归。这样画面只需周期调用一次，
    // 不必在每个采集点手写报警逻辑。
    public void Scan(TagTable io) {
        for (int i = 0; i < io.Count(); i = i + 1) {
            IoTag t = io.At(i);
            int al = t.Alarm();
            AlarmItem cur = this.ActiveOf(t.Name());
            if (al == 0) {
                if (cur != null) { cur.Clear(); }
                continue;
            }
            if (cur != null) { continue; }
            string what = "低报 " + t.TextWithUnit();
            if (al == 2) { what = "高报 " + t.TextWithUnit(); }
            this.Raise(t.Name(), what, 2);
        }
    }

    // 该位号仍然成立的报警记录，没有则 null。
    public AlarmItem ActiveOf(string tagName) {
        for (int i = items.Count - 1; i >= 0; i = i - 1) {
            if (items[i].Point() == tagName && items[i].IsActive()) {
                return items[i];
            }
        }
        return null;
    }
}
