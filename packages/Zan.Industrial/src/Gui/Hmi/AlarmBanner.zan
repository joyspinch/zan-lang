using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

namespace Gui.Hmi;

// 报警横幅（alarm banner）：窗口顶部/底部的一条，显示最新未确认
// 报警并带"确认"按钮，未确认时按优先级闪烁。
public class AlarmBanner : Control {
    // 数据源（可与 AlarmList 共享同一份报警）。
    public AlarmBuffer buffer;
    private Button acknowledge;
    // 报警被确认时触发。
    public UiEvent Ack;

    // 自带缓冲区（设计器 / 表单编译路径用），之后可用 Bind()
    // 换成与报警列表共享的同一个缓冲区。
    public AlarmBanner() : this(new AlarmBuffer()) { }

    // 换绑缓冲区（与 AlarmList 共享同一份报警）。
    public void Bind(AlarmBuffer buf) { buffer = buf; }

    // 当前绑定的缓冲区。
    public AlarmBuffer Buffer() { return buffer; }

    // 共享缓冲区构造。
    public AlarmBanner(AlarmBuffer buf) {
        this.InitControl("alarmBanner", 1);
        buffer = buf;
        wiresOwnEvents = true;
        Ack = new UiEvent();
        prefH = 0;
        acknowledge = new AlarmAcknowledgeButton(this);
        acknowledge.ClassName = "small";
        this.Add(acknowledge);
    }

    // 控件类型标识（序列化/设计器用）。
    public override string Kind() { return "AlarmBanner"; }

    // 覆写：无设计器属性（内容由数据源驱动）。
    protected override List<PropSpec> DefineProps() {
        return new List<PropSpec>();
    }

    // 覆写：公共事件之外提供 "Ack"。
    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Ack");
        return e;
    }

    // 覆写："Ack" 挂 Ack 事件，其余按名称走通用路由。
    public override void BindEvent(string evt, Action a) {
        if (evt == "Ack") { Ack.Add(a); return; }
        base.BindEvent(evt, a);
    }

    public override void BindEventS(string evt, ControlEvent handler) {
        if (evt == "Ack") { Ack.AddS(handler); return; }
        base.BindEventS(evt, handler);
    }

    public override void Arrange(int x, int y, int w, int h) {
        bx = x; by = y; bw = w > 0 ? w : 0; bh = h > 0 ? h : 0;
        App app = this.FindApp();
        if (app == null) { return; }
        int count = buffer != null ? buffer.UnackedCount() : 0;
        acknowledge.Visible = count > 0;
        string caption = "确认 (" + Convert.ToString(count) + ")";
        if (acknowledge.Label() != caption) { acknowledge.SetText(caption); }
        acknowledge.MeasureTree(app);
        int buttonW = Canvas.MeasureText(caption, Style.FontFallback(app, "small")) + app.Scale(20);
        acknowledge.Arrange(bx + bw - buttonW - app.Scale(8),
            by + (bh - app.theme.heightSmall) / 2, buttonW, app.theme.heightSmall);
    }

    internal void Acknowledge() {
        AlarmBuffer source = buffer;
        if (source == null || source.UnackedCount() == 0) { return; }
        source.AckAll();
        Ack.RaiseS(this);
        App app = this.FindApp();
        if (app != null) { app.RequestRedraw(); }
    }

    // 首选高度 = 主题的 medium 行高。
    public override void OnMeasure(App app) {
        prefH = app.theme.heightMedium;
        prefW = 0;
    }

    // 覆写：画最新未确认报警文本与"确认"按钮，未确认时按优先级周期闪烁。
    public override void OnPaint(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = Style.FontFallback(app, "medium");
        AlarmItem a = buffer != null ? buffer.Newest() : null;
        if (a == null) {
            c.FillRect(bx, by, bw, bh, Style.Part(app, "hmi", "panel", "", "", "", Style.SNormal()).BgOr(0));
            c.DrawText(bx + app.Scale(10),
                       by + bh / 2 - Canvas.FontHeight(fs) / 2,
                       "无未确认报警", Style.Part(app, "hmi", "hint", "", "", "", Style.SNormal()).FgOr(0), fs);
            return;
        }
        int col = AlarmItem.ColorOf(app, a.Priority());
        // 未确认报警闪烁：故障级 400ms，其它 800ms。
        int period = 800;
        if (a.Priority() >= 2) { period = 400; }
        int bg = col;
        if ((app.nowMs / period) % 2 == 1) { bg = App.Darken(col, 35); }
        // 只在下一个闪烁边界要一帧，且只声明横幅自己的像素。
        int rem = period - (app.nowMs % period);
        if (rem < 1) { rem = 1; }
        app.RequestAnimationFrameIn(rem, bx, by, bw, bh);
        c.FillRect(bx, by, bw, bh, bg);
        string txt = a.Stamp() + "  " + AlarmItem.LevelOf(a.Priority())
                     + "  " + a.Point() + "  " + a.Message();
        c.DrawText(bx + app.Scale(10), by + bh / 2 - Canvas.FontHeight(fs) / 2,
                   txt, Style.Part(app, "hmi", "accent", "", "", "", Style.SNormal()).FgOr(0), fs);


    }
}

internal class AlarmAcknowledgeButton : Button {
    private weak AlarmBanner owner;
    internal AlarmAcknowledgeButton(AlarmBanner banner) : base("") { owner = banner; }
    public override void OnClick(RoutedEventArgs e) {
        if (this.IsDisabled()) { return; }
        base.OnClick(e);
        AlarmBanner banner = owner;
        if (banner != null && this.Parent() == banner) { banner.Acknowledge(); }
    }
}
