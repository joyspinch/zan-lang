using System;
using Gui;

namespace Gui.Hmi;

// 一个过程位号（tag / point）：上位机画面上所有数显、仪表、
// 指示灯、棒图和趋势都绑定到位号，而不是各自持有一份值，
// 因此一次采集刷新即可让整幅画面同步。
// 值用定点整数表示：`raw` 是原始整数，`scale` 是每单位的
// 计数（1 = 整数，10 = 一位小数，100 = 两位小数）。工控
// 现场的量程和限值本来就是定点的，避免浮点显示抖动。
public class IoTag {
    public string tagName;
    public string unit;
    // 每工程单位的计数（1 / 10 / 100 ...）。
    public int scale;
    // 原始计数值信号（显示值 = raw / scale），HMI 控件共享引用。
    public SignalInt raw;
    public int rawMin;
    public int rawMax;
    // 低 / 高报警限（原始计数）。相等表示不判限。
    public int loLimit;
    public int hiLimit;
    // 最近一次写入是否被认为有效（通信中断时置 false，
    // 显示端据此画出坏值样式）。
    public bool good;

    // 构建位号：缩放 <1 按 1；量程默认 0..100 单位、不判限。
    public IoTag(string name, string engUnit, int scaleCounts) {
        tagName = name;
        unit = engUnit;
        scale = scaleCounts;
        if (scale < 1) { scale = 1; }
        raw = new SignalInt(0);
        rawMin = 0;
        rawMax = 100 * scale;
        loLimit = 0;
        hiLimit = 0;
        good = true;
    }

    // 无量纲整数位号（无单位、无小数）。
    public IoTag(string name) : this(name, "", 1) { }

    // 位号名 / 工程单位 / 定点缩放（每单位计数）。
    public string Name() { return tagName; }
    // 工程单位文本。
    public string Unit() { return unit; }
    // 定点缩放（每单位计数，显示值 = raw / scale）。
    public int Scale() { return scale; }
    // 底层信号（HMI 控件间共享引用实现整幅画面同步刷新）。
    public SignalInt Value() { return raw; }
    // 原始定点计数值（显示值 = raw / scale）。
    public int Raw() { return raw.Get(); }
    // 最近写入是否有效（通信坏时 false，显示端画坏值样式）。
    public bool IsGood() { return good; }
    // 量程上下限（原始计数）。
    public int Min() { return rawMin; }
    // 量程上限（原始计数）。
    public int Max() { return rawMax; }

    // 设量程（原始计数，hi ≤ lo 时修正为 lo+1；链式）。
    public IoTag Range(int lo, int hi) {
        rawMin = lo;
        rawMax = hi;
        if (rawMax <= rawMin) { rawMax = rawMin + 1; }
        return this;
    }

    // 设低/高报警限（原始计数；相等 = 不判限）。
    public IoTag Limits(int lo, int hi) {
        loLimit = lo;
        hiLimit = hi;
        return this;
    }

    // 写入有效原始值（同时清除坏值标记）。
    public void SetRaw(int v) {
        raw.Set(v);
        good = true;
    }

    // 通信中断 / 坏值：保留最后一次的数值但标记为不可信。
    public void SetBad() { good = false; }

    // 0 正常，1 低报，2 高报（未设限值时恒为 0）。
    public int Alarm() {
        if (loLimit == hiLimit) { return 0; }
        int v = raw.Get();
        if (v <= loLimit) { return 1; }
        if (v >= hiLimit) { return 2; }
        return 0;
    }

    // 量程内的百分比（0..100），用于棒图 / 仪表指针。
    public int Percent() {
        int span = rawMax - rawMin;
        if (span <= 0) { return 0; }
        int p = (raw.Get() - rawMin) * 100 / span;
        if (p < 0) { p = 0; }
        if (p > 100) { p = 100; }
        return p;
    }

    // 带小数点的工程值文本（不含单位）。
    public string Text() {
        return IoTag.Format(raw.Get(), scale);
    }

    // 带小数点的工程值文本（含单位；无单位时退化为 <c>Text</c>）。
    public string TextWithUnit() {
        if (unit == "") { return this.Text(); }
        return this.Text() + " " + unit;
    }

    // 定点整数按 `scale` 格式化：scale=10 时 1234 -> "123.4"。
    public static string Format(int v, int scale) {
        if (scale <= 1) { return Convert.ToString(v); }
        bool neg = v < 0;
        if (neg) { v = 0 - v; }
        int whole = v / scale;
        int frac = v - whole * scale;
        string fs = Convert.ToString(frac);
        int digits = IoTag.Digits(scale);
        while (fs.Length < digits) { fs = "0" + fs; }
        string s = Convert.ToString(whole) + "." + fs;
        if (neg) { s = "-" + s; }
        return s;
    }

    // scale 对应的小数位数（10 -> 1，100 -> 2）。
    public static int Digits(int scale) {
        int d = 0;
        int s = scale;
        while (s > 1) { s = s / 10; d = d + 1; }
        return d;
    }
}
