namespace System.Ssh;

// SSH 的消息号（RFC 4250 / 4253 / 4254）。
//
// 消息号分三段：**传输层通用** 1–19、**算法协商与密钥交换** 20–29 与
// 30–49（各 KEX 方法自用）、**认证** 50–79、**连接（通道）** 80–127。
//
// 有一处**号段复用**要注意：60 同时是 SSH_MSG_USERAUTH_PK_OK 与
// SSH_MSG_USERAUTH_PASSWD_CHANGEREQ，靠上下文区分（前者跟在公钥认证请求
// 后面，后者跟在口令认证失败后面）——按号段猜消息类型会认错。
public class SshMessage {
    // 传输层通用。
    public static int Disconnect = 1;
    public static int Ignore = 2;
    public static int Unimplemented = 3;
    public static int Debug = 4;
    public static int ServiceRequest = 5;
    public static int ServiceAccept = 6;
    public static int ExtInfo = 7;

    // 算法协商与密钥交换。
    public static int KexInit = 20;
    public static int NewKeys = 21;

    // curve25519-sha256（RFC 8731）复用 RFC 5656 的 ECDH 号段。
    public static int KexEcdhInit = 30;
    public static int KexEcdhReply = 31;

    // 用户认证（RFC 4252）。
    public static int UserAuthRequest = 50;
    public static int UserAuthFailure = 51;
    public static int UserAuthSuccess = 52;
    public static int UserAuthBanner = 53;
    public static int UserAuthPkOk = 60;
    public static int UserAuthPasswdChangeReq = 60;

    // 连接协议 / 通道（RFC 4254）。
    public static int GlobalRequest = 80;
    public static int RequestSuccess = 81;
    public static int RequestFailure = 82;
    public static int ChannelOpen = 90;
    public static int ChannelOpenConfirmation = 91;
    public static int ChannelOpenFailure = 92;
    public static int ChannelWindowAdjust = 93;
    public static int ChannelData = 94;
    public static int ChannelExtendedData = 95;
    public static int ChannelEof = 96;
    public static int ChannelClose = 97;
    public static int ChannelRequest = 98;
    public static int ChannelSuccess = 99;
    public static int ChannelFailure = 100;

    // 消息号的名字（调试输出用）。
    public static string Name(int message) {
        if (message == Disconnect) { return "DISCONNECT"; }
        if (message == Ignore) { return "IGNORE"; }
        if (message == Unimplemented) { return "UNIMPLEMENTED"; }
        if (message == Debug) { return "DEBUG"; }
        if (message == ServiceRequest) { return "SERVICE_REQUEST"; }
        if (message == ServiceAccept) { return "SERVICE_ACCEPT"; }
        if (message == ExtInfo) { return "EXT_INFO"; }
        if (message == KexInit) { return "KEXINIT"; }
        if (message == NewKeys) { return "NEWKEYS"; }
        if (message == KexEcdhInit) { return "KEX_ECDH_INIT"; }
        if (message == KexEcdhReply) { return "KEX_ECDH_REPLY"; }
        if (message == UserAuthRequest) { return "USERAUTH_REQUEST"; }
        if (message == UserAuthFailure) { return "USERAUTH_FAILURE"; }
        if (message == UserAuthSuccess) { return "USERAUTH_SUCCESS"; }
        if (message == UserAuthBanner) { return "USERAUTH_BANNER"; }
        if (message == UserAuthPkOk) { return "USERAUTH_PK_OK"; }
        if (message == GlobalRequest) { return "GLOBAL_REQUEST"; }
        if (message == RequestSuccess) { return "REQUEST_SUCCESS"; }
        if (message == RequestFailure) { return "REQUEST_FAILURE"; }
        if (message == ChannelOpen) { return "CHANNEL_OPEN"; }
        if (message == ChannelOpenConfirmation) { return "CHANNEL_OPEN_CONFIRMATION"; }
        if (message == ChannelOpenFailure) { return "CHANNEL_OPEN_FAILURE"; }
        if (message == ChannelWindowAdjust) { return "CHANNEL_WINDOW_ADJUST"; }
        if (message == ChannelData) { return "CHANNEL_DATA"; }
        if (message == ChannelExtendedData) { return "CHANNEL_EXTENDED_DATA"; }
        if (message == ChannelEof) { return "CHANNEL_EOF"; }
        if (message == ChannelClose) { return "CHANNEL_CLOSE"; }
        if (message == ChannelRequest) { return "CHANNEL_REQUEST"; }
        if (message == ChannelSuccess) { return "CHANNEL_SUCCESS"; }
        if (message == ChannelFailure) { return "CHANNEL_FAILURE"; }
        return "UNKNOWN";
    }
}
