namespace System.Ssh;

// SSH 的错误原因（可区分的错误码）。
//
// **为什么要错误码**：SSH 失败的原因差别很大——"主机密钥不认识"是安全事件，
// "算法没有交集"是版本兼容问题，"认证被拒"是凭据问题，"对端断开"是网络问题。
// 合成一句话会让调用方没法分别处理（比如"主机密钥变了"要停下来问人，
// "认证被拒"可以自动重试别的口令）。
public enum SshError {
    // 没有错误。
    None = 0,
    // 线格式非法（长度字段越界、mpint 编码不合规、name-list 有空项等）。
    Malformed = 1,
    // 数据被截断（对端发的包比声明的短）。
    Truncated = 2,
    // 版本号不合法（不是 SSH-2.0 开头、超过 255 字节、含非法字符）。
    BadVersion = 3,
    // 双方没有共同的算法（kex / 主机密钥 / 加密 / MAC 任一协商失败）。
    NoCommonAlgorithm = 4,
    // 密钥交换失败（共享密钥算不出、交换哈希对不上、签名校验失败）。
    KexFailed = 5,
    // 主机密钥与 known_hosts 里的记录不符（**安全事件**）。
    HostKeyMismatch = 6,
    // 主机密钥是第一次见（不认识）。
    HostKeyUnknown = 7,
    // 认证被拒（口令错、密钥不匹配）。
    AuthFailed = 8,
    // 对端主动断开（带原因码）。
    Disconnected = 9,
    // 完整性校验失败（AEAD tag 对不上——数据被改过或密钥不对）。
    IntegrityFailed = 10,
    // 收到非预期的消息（协议跑偏了）。
    UnexpectedMessage = 11,
    // 通道打开失败（服务端拒绝）。
    ChannelOpenFailed = 12,
    // 网络读写失败。
    IoError = 13,
    // 超时。
    Timeout = 14,
    // 包太大（超过实现能处理的规模）。
    PacketTooLarge = 15,
    // 本包不支持的能力（算法、认证方式、通道类型）。
    Unsupported = 16,
    // 内部错误（不应该发生；出现即说明包里有 bug）。
    Internal = 17,
}
