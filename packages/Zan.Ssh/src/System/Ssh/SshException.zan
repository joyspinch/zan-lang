using System;

namespace System.Ssh;

// SSH 的异常。
//
// **异常 + 错误码两个通道**：人看 `Message`（异常自带），程序看 `error`。
// 调用方要能**按原因分支**——"主机密钥变了"必须停下来问人，"认证被拒"可以
// 换一种凭据重试，"没有共同算法"是版本问题只能换实现。
public class SshException : Exception {
    // 错误码。
    public SshError error;
    // 对端给的断开原因码（RFC 4253 §11.1），没有则为 0。
    public int disconnectReason;

    public SshException(SshError error, string text) : base(text) {
        this.error = error;
        this.disconnectReason = 0;
    }

    // 带细节的构造：细节拼进消息（调用方要展示给人看时不必自己拼）。
    public SshException(SshError error, string text, string detail) : base(SshException.Combine(text, detail)) {
        this.error = error;
        this.disconnectReason = 0;
    }

    // 消息与细节的拼接（只能在 base(...) 里算，所以提成静态方法）。
    static string Combine(string text, string detail) {
        if (detail == null || detail.Length == 0) { return text; }
        return text + ": " + detail;
    }

    // 错误码的英文名（调试输出用；不依赖枚举的字符串格式化行为）。
    public string ErrorName() {
        if (this.error == SshError.None) { return "None"; }
        if (this.error == SshError.Malformed) { return "Malformed"; }
        if (this.error == SshError.Truncated) { return "Truncated"; }
        if (this.error == SshError.BadVersion) { return "BadVersion"; }
        if (this.error == SshError.NoCommonAlgorithm) { return "NoCommonAlgorithm"; }
        if (this.error == SshError.KexFailed) { return "KexFailed"; }
        if (this.error == SshError.HostKeyMismatch) { return "HostKeyMismatch"; }
        if (this.error == SshError.HostKeyUnknown) { return "HostKeyUnknown"; }
        if (this.error == SshError.AuthFailed) { return "AuthFailed"; }
        if (this.error == SshError.Disconnected) { return "Disconnected"; }
        if (this.error == SshError.IntegrityFailed) { return "IntegrityFailed"; }
        if (this.error == SshError.UnexpectedMessage) { return "UnexpectedMessage"; }
        if (this.error == SshError.ChannelOpenFailed) { return "ChannelOpenFailed"; }
        if (this.error == SshError.IoError) { return "IoError"; }
        if (this.error == SshError.Timeout) { return "Timeout"; }
        if (this.error == SshError.PacketTooLarge) { return "PacketTooLarge"; }
        if (this.error == SshError.Unsupported) { return "Unsupported"; }
        if (this.error == SshError.Internal) { return "Internal"; }
        return "Unknown";
    }
}
