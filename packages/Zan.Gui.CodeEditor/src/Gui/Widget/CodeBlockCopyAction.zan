using Gui.Component.CodeEditor;

namespace Gui.Component.CodeEditor;

// The persistent child owns its callback; the callback borrows the composite.
public class CodeBlockCopyAction {
    weak CodeBlock owner;
    public CodeBlockCopyAction(CodeBlock block) { owner = block; }
    public void Invoke() {
        CodeBlock block = owner;
        if (block != null) { block.ActivateCopy(); }
    }
}
