using System;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Backend;

namespace Gui.Component.CodeEditor;

// 只读代码面板：带标题的头部含复制操作，下方是
// 可滚动、等宽外观的源码行。调用方拥有
// 内容行并决定“复制”做什么，因此本控件不关心
// 语言或所显示的文档。
// cb.RenderInside(app, rect);
public class CodeBlock : Control {
    List<string> lines;
    // 头部标题，通常是语言名。
    Binding<string> Caption;
    // 复制操作上的标签。
    Binding<string> CopyLabel;
    SignalInt scroll;
    bool copied;
    int wid;
    Button copyButton;
    CodeBlockCopyAction copyAction;
    int projectedLine;
    int projectedVersion;
    int linePixel;
    int textFont;
    int gutterPixel;
    int copiedFrame;

    // 选中状态。代码只读但可选中（拖动、Ctrl+A、
    // Ctrl+C），同一时刻只有一个代码块能持有选中，因此状态
    // 共享，并标记所属代码块的焦点 id——这也使它
    // 在每帧重建控件的宿主中依然有效。
    static int selOwner;
    static bool selActive;
    static bool selDragging;
    static int selAnchorLine;
    static int selAnchorCol;
    static int selLine;
    static int selCol;
    // 复制操作被点击时触发。
    UiEvent Copy;

    // 初始化：置标题/内容行/滚动信号并自管 Copy 事件。
    public void InitCodeBlock(string caption, List<string> src) {
        this.InitControl("codeblock", 1);
        lines = src;
        Caption = caption;
        CopyLabel = "Copy";
        scroll = new SignalInt(0);
        copied = false;
        wid = WidgetId.Next();
        wiresOwnEvents = true;
        Copy = new UiEvent();
        copyButton = new Button { Text = "Copy", Icon = "copy", Class = "small" };
        copyAction = new CodeBlockCopyAction(this);
        copyButton.Click.Add(copyAction.Invoke);
        this.Add(copyButton);
        copiedFrame = 0 - 1;
    }

    // 空代码块（设计器用）。
    CodeBlock() { InitCodeBlock("", new List<string>()); }
    // 标题 + 内容行；src 被直接引用，替换内容请走 SetLines。
    CodeBlock(string caption, List<string> src) { InitCodeBlock(caption, src); }

    // 通过宿主持有的信号滚动，因此偏移量在
    // 面板重建后依然保留。
    public void UseScroll(SignalInt s) {
        if (s == null) { return; }
        scroll = s;
        projectedLine = 0 - 1;
    }

    // 刚绘制的这一帧内复制操作被点击时返回 true，供
    // 倾向于轮询而非订阅 `Copy` 的宿主使用。
    bool Copied() { return copied && this.App != null && copiedFrame == this.App.frameCount; }

    // 显示的行；赋值会替换行、重置滚动并清除
    // 任何选中状态。
    public void SetLines(List<string> src) {
        lines = src;
        scroll.Set(0);
        projectedLine = 0;
        CodeBlock.ClearSelection();
        this.SetScrollTop(0);
    }

    // 清除共享选中状态，无论此前属于谁。
    public static void ClearSelection() {
        CodeBlock.selActive = false;
        CodeBlock.selDragging = false;
        CodeBlock.selOwner = 0 - 1;
    }

    // 将整个代码片段拼成一个字符串。
    string AllText() { return string.Join("\n", lines); }

    // 选中的文本；本块无选中时返回 ""。
    public string SelectedText(int owner) {
        if (!CodeBlock.selActive || CodeBlock.selOwner != owner) { return ""; }
        int sL = CodeBlock.selAnchorLine;
        int sC = CodeBlock.selAnchorCol;
        int eL = CodeBlock.selLine;
        int eC = CodeBlock.selCol;
        if (sL > eL || (sL == eL && sC > eC)) {
            int tL = sL; sL = eL; eL = tL;
            int tC = sC; sC = eC; eC = tC;
        }
        if (sL < 0) { sL = 0; }
        if (eL >= lines.Count) { eL = lines.Count - 1; }
        StringBuilder sb = new StringBuilder();
        int i = sL;
        while (i <= eL) {
            string ln = lines[i];
            int a = 0;
            int b = ln.Length;
            if (i == sL) { a = sC; }
            if (i == eL) { b = eC; }
            if (a < 0) { a = 0; }
            if (b > ln.Length) { b = ln.Length; }
            if (b > a) { sb.Append(ln.Substring(a, b - a)); }
            if (i < eL) { sb.Append("\n"); }
            i = i + 1;
        }
        return sb.ToString();
    }

    // 选中整个代码片段（Ctrl+A）。
    public void SelectAll(int owner) {
        if (lines.Count == 0) { return; }
        CodeBlock.selOwner = owner;
        CodeBlock.selAnchorLine = 0;
        CodeBlock.selAnchorCol = 0;
        CodeBlock.selLine = lines.Count - 1;
        CodeBlock.selCol = lines[lines.Count - 1].Length;
        CodeBlock.selActive = true;
    }

    // 行高：`codeblock::line` 字号加呼吸空间。
    public static int LineHeight(App app) {
        StyleBox line = Style.Part(app, "codeblock", "line", "", "", "",
                                   Style.SNormal());
        return Canvas.FontHeight(line.FontOr(Style.FontFallback(app, "small")))
            + app.Scale(4);
    }

    // 标题栏高度：一个标准小按钮加上下
    // 留白，使标题和复制操作在合适的栏内
    // 居中，而非被压缩进过矮的栏。
    public static int HeaderHeight(App app) {
        int h = app.theme.heightSmall + app.Scale(8);
        if (h < app.Scale(32)) { h = app.Scale(32); }
        return h;
    }

    // `lineCount` 行时行号槽的宽度。
    public static int GutterWidth(App app, int lineCount) {
        StyleBox line = Style.Part(app, "codeblock", "line", "", "", "",
                                   Style.SNormal());
        int fs = line.FontOr(Style.FontFallback(app, "small"));
        int digits = Canvas.MeasureText(Convert.ToString(lineCount), fs);
        return digits + app.Scale(18);
    }

    // 默认表面：皮肤自带的面板材质，使代码块看起来
    // 像周围卡片的一员，而非编辑器配色的一块
    // 色斑——编辑器调色板跟随*代码主题*，与
    // 页面其余部分的皮肤无关。
    // 但样式表在 `codeblock` 上的 `background` 仍然优先。
    public static int SurfaceColor(App app, EditorPalette pal) {
        StyleBox ps = Style.Of(app, "panel", "", Style.SNormal());
        return ps.BgOr(0);
    }

    // `lineCount` 行的自然高度（限制在可用空间内）。
    public static int Height(App app, int lineCount) {
        return CodeBlock.HeaderHeight(app)
            + lineCount * CodeBlock.LineHeight(app) + app.Scale(16);
    }

    // 覆写：自然高度（标题栏 + 行数 × 行高 + 留白），宽取最宽行
    // 加行号槽。
    override void OnMeasure(App app) {
        prefH = CodeBlock.Height(app, lines.Count);
        StyleBox line = Style.Part(app, "codeblock", "line", "", Class, "",
                                   Style.SNormal());
        int fs = line.FontOr(Style.FontFallback(app, "small"));
        int widest = 0;
        for (int i = 0; i < lines.Count; i = i + 1) {
            int lw = Canvas.MeasureText(lines[i], fs);
            if (lw > widest) { widest = lw; }
        }
        prefW = widest + app.Scale(34);
    }

    public override int WidgetId() { return wid; }

    public override StyleBox ResolveStyle(App app, int state) {
        StyleBox box = base.ResolveStyle(app, state);
        if (box.overflowCss == 0 - 1) { box.overflowY = 2; box.overflow = 1; }
        return box;
    }

    public override Rect ScrollViewport() {
        Rect view = base.ScrollViewport();
        App app = this.App;
        int header = app != null ? CodeBlock.HeaderHeight(app) : 32;
        int top = app != null ? app.Scale(8) : 8;
        int bottom = app != null ? app.Scale(6) : 6;
        int h = view.height - header - top - bottom;
        return new Rect(view.x, view.y + header + top, view.width, h > 0 ? h : 0);
    }

    public override void OnScrollChanged() {
        if (linePixel <= 0 || scroll == null) { return; }
        projectedLine = this.ScrollTop() / linePixel;
        if (scroll.Get() != projectedLine) { scroll.Set(projectedLine); }
        projectedVersion = scroll.Version();
    }

    public override void Arrange(int x, int y, int w, int h) {
        bx = x; by = y; bw = w > 0 ? w : 0; bh = h > 0 ? h : 0;
        App app = this.App;
        if (app == null) { return; }
        bool external = scroll != null && (scroll.Get() != projectedLine || scroll.Version() != projectedVersion);
        int requested = scroll != null ? scroll.Get() : 0;
        linePixel = CodeBlock.LineHeight(app);
        StyleBox ls = this.ResolvePartAs(app, "codeblock", "line", "", Class, Style.SNormal());
        textFont = ls.FontOr(Style.FontFallback(app, "small"));
        gutterPixel = CodeBlock.GutterWidth(app, lines.Count);
        copyButton.Text = CopyLabel.Get();
        copyButton.MeasureTree(app);
        int cpW = copyButton.prefW > 0 ? copyButton.prefW : app.Scale(72);
        int cpH = app.theme.heightSmall;
        copyButton.Arrange(bx + bw - cpW - app.Scale(8), by + (CodeBlock.HeaderHeight(app) - cpH) / 2, cpW, cpH);
        Rect view = this.ScrollViewport();
        scrollExtent = lines.Count * linePixel;
        scrollExtentX = view.width;
        int maximum = scrollExtent - view.height;
        if (maximum < 0) { maximum = 0; }
        int next = external ? requested * linePixel : this.ScrollTop();
        if (next > maximum) { next = maximum; }
        if (next < 0) { next = 0; }
        projectedLine = next / linePixel;
        if (scroll != null) {
            if (scroll.Get() != projectedLine) { scroll.Set(projectedLine); }
            projectedVersion = scroll.Version();
        }
        this.SetScrollTop(next);
    }

    private bool OverCode(int x, int y) {
        Rect view = this.ScrollViewport();
        return view.Contains(x, y) && x >= view.x + gutterPixel && this.ScrollBarHit(x, y) == 0;
    }

    private void PlaceCaret(int x, int y, bool anchor) {
        if (lines.Count == 0 || linePixel <= 0) { return; }
        Rect view = this.ScrollViewport();
        int pixel = y - view.y + this.ScrollTop();
        int index = pixel < 0 ? 0 : pixel / linePixel;
        if (index >= lines.Count) { index = lines.Count - 1; }
        int column = CodeEditor.ColFromX(lines[index], x - view.x - gutterPixel - this.App.Scale(10), textFont);
        if (anchor) { CodeBlock.selAnchorLine = index; CodeBlock.selAnchorCol = column; }
        CodeBlock.selLine = index;
        CodeBlock.selCol = column;
    }

    public override void OnPointerDown(RoutedEventArgs e) {
        App app = this.App;
        if (e.originalSource != this || app == null || app.window.EventButton() != 0
            || this.IsDisabled() || !this.StyleVisible() || !this.OverCode(e.x, e.y)) { return; }
        this.Focus(app);
        Control popup = app.overlayHost != null ? app.overlayHost.ActiveRoot() : null;
        Control root = popup != null ? popup : app.rootControl;
        if (this.App != app || !this.IsFocused(app) || this.IsDisabled() || !this.StyleVisible()
            || root == null || !root.ContainsInputControl(this)) { return; }
        bool keep = Modifiers.HasShift(e.modifiers) && CodeBlock.selOwner == wid;
        CodeBlock.selOwner = wid;
        this.PlaceCaret(e.x, e.y, !keep);
        CodeBlock.selActive = keep;
        CodeBlock.selDragging = true;
        isPressed = true;
        app.CapturePointer(this, true);
        app.RequestRedraw();
        e.Handle();
    }

    public override void OnPointerMove(RoutedEventArgs e) {
        App app = this.App;
        if (app == null || !CodeBlock.selDragging || CodeBlock.selOwner != wid
            || app.GetCapturedPointer() != this) { return; }
        if (this.IsDisabled() || !this.StyleVisible()) { this.OnInputFocusLost(); return; }
        this.PlaceCaret(e.x, e.y, false);
        CodeBlock.selActive = CodeBlock.selLine != CodeBlock.selAnchorLine || CodeBlock.selCol != CodeBlock.selAnchorCol;
        app.RequestRedraw();
        e.Handle();
    }

    public override void OnPointerUp(RoutedEventArgs e) {
        App app = this.App;
        if (app == null || app.window.EventButton() != 0 || CodeBlock.selOwner != wid
            || !CodeBlock.selDragging) { return; }
        if (!this.IsDisabled() && this.StyleVisible()) {
            this.PlaceCaret(e.x, e.y, false);
            CodeBlock.selActive = CodeBlock.selLine != CodeBlock.selAnchorLine || CodeBlock.selCol != CodeBlock.selAnchorCol;
        }
        CodeBlock.selDragging = false;
        isPressed = false;
        if (app.GetCapturedPointer() == this) { app.ReleasePointerCapture(); }
        app.RequestRedraw();
        e.Handle();
    }

    public override void OnPointerCancel(RoutedEventArgs e) {
        base.OnPointerCancel(e);
        this.OnInputFocusLost();
    }

    public override void OnInputFocusLost() {
        if (CodeBlock.selOwner == wid) { CodeBlock.selDragging = false; }
        isPressed = false;
        App app = this.App;
        if (app != null && app.GetCapturedPointer() == this) { app.ReleasePointerCapture(); }
    }

    public override void OnTextInput(RoutedEventArgs e) {
        App app = this.App;
        if (app == null || !this.IsFocused(app) || this.IsDisabled() || !this.StyleVisible()) { return; }
        if (e.keyCode == 1) { this.SelectAll(wid); }
        else if (e.keyCode == 3) {
            string selected = this.SelectedText(wid);
            Clipboard.SetText(selected != "" ? selected : this.AllText());
        } else { return; }
        app.RequestRedraw();
        e.Handle();
    }

    public void ActivateCopy() {
        App app = this.App;
        if (app == null || this.IsDisabled() || !this.StyleVisible()) { return; }
        copied = true;
        copiedFrame = app.frameCount;
        app.RequestRedraw();
        Copy.RaiseS(this);
    }

    // Painting reads retained geometry, offsets, and selection only.
    override void OnPaint(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        EditorPalette pal = EditorPalette.For(t);
        StyleBox s = computedStyle;
        int hdrH = CodeBlock.HeaderHeight(app);
        c.FillRoundRect(bx, by, bw, bh, s.RadiusOr(t.borderRadiusMedium), s.BgOr(CodeBlock.SurfaceColor(app, pal)));
        c.DrawRect(bx, by, bw, bh, s.BorderOr(0), s.BorderWOr(1));
        c.FillRect(bx, by + hdrH, bw, 1, pal.panelBg);
        StyleBox captionStyle = this.ResolvePartAs(app, "codeblock", "caption", "", Class, Style.SNormal());
        int captionFont = captionStyle.FontOr(Style.FontFallback(app, "medium"));
        c.DrawText(bx + app.Scale(12), Canvas.CenterTextY(by, hdrH, captionFont), Caption.Get(), captionStyle.FgOr(0), captionFont);
        app.focus.RegisterFocusable(wid);
        Rect view = this.ScrollViewport();
        StyleBox ls = this.ResolvePartAs(app, "codeblock", "line", "", Class, Style.SNormal());
        int lineColor = ls.FgOr(pal.plain);
        c.FillRect(bx + 1, by + hdrH + 1, gutterPixel, bh - hdrH - 2, 34 * 16777216 + (pal.panelBg % 16777216));
        c.FillRect(bx + gutterPixel, by + hdrH + 1, 1, bh - hdrH - 2, 60 * 16777216 + (pal.border % 16777216));
        if (linePixel <= 0) { return; }
        int off = this.ScrollTop() / linePixel;
        int y = view.y + off * linePixel - this.ScrollTop();
        int codeX = view.x + gutterPixel + app.Scale(10);
        bool showSelection = CodeBlock.selActive && CodeBlock.selOwner == wid;
        c.PushClip(view.x, view.y, view.width, view.height);
        bool inBlock = false;
        for (int pre = 0; pre < off && pre < lines.Count; pre = pre + 1) {
            List<CodeSpan> spans = new List<CodeSpan>();
            inBlock = CodeEditor.HighlightSpans(lines[pre], pal.keyword, pal.type, pal.str, pal.comment, pal.number, lineColor, inBlock, spans);
        }
        for (int i = off; i < lines.Count && y < view.y + view.height; i = i + 1) {
            string number = Convert.ToString(i + 1);
            c.DrawText(bx + gutterPixel - app.Scale(8) - Canvas.MeasureText(number, textFont), y, number, pal.lineNo, textFont);
            if (showSelection) {
                CodeEditor.DrawSelHighlight(c, app, CodeBlock.selAnchorLine, CodeBlock.selAnchorCol, CodeBlock.selLine, CodeBlock.selCol,
                    i, lines[i], codeX, y, linePixel, textFont, view);
            }
            List<CodeSpan> spans = new List<CodeSpan>();
            inBlock = CodeEditor.HighlightSpans(lines[i], pal.keyword, pal.type, pal.str, pal.comment, pal.number, lineColor, inBlock, spans);
            int tx = codeX;
            for (int j = 0; j < spans.Count; j = j + 1) {
                CodeSpan span = spans[j];
                c.DrawText(tx, y, span.text, span.color, textFont);
                tx = tx + Canvas.MeasureText(span.text, textFont);
            }
            y = y + linePixel;
        }
        c.PopClip();
    }

    // ---- 设计器 / 序列化模型 ----

    // 控件类型标识（序列化/设计器用）。
    override string Kind() { return "CodeBlock"; }

    // 覆写：返回设计器属性清单（caption/copyLabel）。
    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec cap = PropSpec.Text("caption", "Caption");
        cap.str = Caption;
        ps.Add(cap);
        PropSpec cp = PropSpec.Text("copyLabel", "Copy label");
        cp.str = CopyLabel;
        ps.Add(cp);
        return ps;
    }

    // 覆写：公共事件之外提供 "Copy"。
    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Copy");
        return e;
    }

    // 覆写："Copy" 挂 Copy 事件，其余按名称走通用路由。
    override void BindEvent(string evt, Action a) {
        if (evt == "Copy") { Copy.Add(a); return; }
        On.AddByName(evt, a);
    }

    // <see cref="BindEvent"/> 的 sender 通道（S = Sender）：
    // 特化事件接本控件的 UiEvent，通用事件按名路由。
    override void BindEventS(string evt, ControlEvent a) {
        if (evt == "Copy") { Copy.AddS(a); return; }
        On.AddByNameS(evt, a);
    }

}
