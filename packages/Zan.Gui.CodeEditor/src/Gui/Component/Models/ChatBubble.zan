using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Component;

public class ChatBubble {
    // 消息在 `data` 里的下标；-1 表示这不是一条消息（busy 提示行）。
    int idx;
    // 内容坐标里的顶边，以及这块占的高度（含名字行与时刻分隔）。
    int top;
    int h;
    // 顶部为时刻分隔预留的高度（0 = 这条不画分隔）与要画的文本。
    int divH;
    string divText;
    // 名字行高度（群聊里别人的消息才有）与名字。
    int nameH;
    string name;
    // 引用块高度（这条消息是「引用某条消息」的回复时非 0）与内容：
    // 被引人的显示名 + 原文摘要。IM 客户端把引用画在正文上方那一条，
    // 与名字行占的是同一段纵向空间的两个位置（引用在下、名字在上）。
    int quoteH;
    string quoteWho;
    string quoteText;
    // 已经省略号截好的引用行（`引用者: 摘要`），绘制时直接画它，
    // 免得每帧在一段长摘要上做一次二分。
    string quoteShown;
    // 气泡正文的换行结果与最长行宽（图片气泡为空 / 0）。
    List<string> lines;
    // 展示行 → 正文的字节偏移账（与 `lines` 同长）：鼠标落点换算成
    // 正文偏移、选区高亮反算每行的像素区间都要它。图片气泡为空。
    WrappedText linesAt;
    int textW;
    // 图片气泡的画面尺寸（0 = 文本气泡）。
    int imgW;
    int imgH;
    // 图片气泡的图片路径（`imgW > 0` 时有效）。
    string imgPath;
    // 头像首字与配色类名（busy 行没有头像）。
    string initial;
    string avaCls;
    // 这条是「我」发的（右对齐、头像在右）。
    bool mine;
    // 气泡自身的宽高（含内边距）。
    int bw;
    int bh;
    // busy 提示行：气泡用弱色画、不跟任何消息关联。
    bool waiting;

    // 全部字段显式归零：`new` 出来的实例不依赖语言对未赋值字段的默认值。
    ChatBubble() {
        idx = 0 - 1;
        top = 0;
        h = 0;
        divH = 0;
        divText = "";
        nameH = 0;
        name = "";
        quoteH = 0;
        quoteWho = "";
        quoteText = "";
        quoteShown = "";
        lines = new List<string>();
        linesAt = null;
        textW = 0;
        imgW = 0;
        imgH = 0;
        imgPath = "";
        initial = "";
        avaCls = "";
        mine = false;
        bw = 0;
        bh = 0;
        waiting = false;
    }
}

// 气泡模式里的一处落点：命中第几条消息、落在正文的第几个字节。
// 选择按「消息下标 + 正文偏移」记（不是展示行/列）——展示行随窗口
// 宽度重排，正文偏移不会，改窗口宽度后选区仍框住同一段文字。
