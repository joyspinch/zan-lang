using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Component;

public class ChatMessage {
    string role;
    string text;
    string reason;
    string agent;
    string to;
    string kind;
    string taskId;
    int progress;
    // 这一拍实际发出的工具调用（宿主自己的格式，原样留档）。它不进聊天区
    // 的正文——那是给人看的；宿主把请求发回模型时带上它，模型才看得到自己
    // 上一拍真正的调用长什么样。
    string call;
    // 这条消息产生的时刻（Unix 秒，UTC）。0 = 不知道（旧存档里没有这个
    // 字段），头行就不显示时刻。流式那条气泡在建出来时定下这个值，后面
    // 每一拍只改正文，因此显示的是「这一轮开始说话的时间」。
    long at;
    // 图片附件路径（本地文件 / http(s) / data URI，交给 `Gui.Widget.Image`
    // 解码）。非空时这一轮在气泡模式里画成一张图片气泡；正文仍然保留，
    // 供记录模式（ChatStyle.Log）与复制使用。
    string img;
    // 宿主的消息 id（IM/服务端场景按 id 对账增量流；"" = 本地消息）。
    string msgId;
    // 回执位（IM 用）：0 发出 / 1 送达 / 2 已读 / -1 别人的消息。
    // 渲染走 kind（宿主把 mark 翻成 "wx-acked" 一类的节拍串）。
    int mark;
    // 引用回复：被引消息的发送者显示名与原文摘要（"" = 这条不是回复）。
    // 引用块画在自己气泡内、正文之上，与 IM 客户端的观感一致。
    string quoteWho;
    string quoteText;
    // 被引消息的宿主 id（发送时原样回给服务端，对端才能还原引用关系）。
    string quoteId;
    // 卡片消息（任务卡片一类「整体即入口」的消息）：左键单击（未拖动）
    // 交给宿主 OnBubbleActivate，不进文本选区——卡片没有可选中正文，
    // IM 惯例里单击选区对它没有意义。默认 false。
    bool card;

    // 一条普通消息：无思考、无信封，时间戳取当前 UTC 时刻。
    public static ChatMessage Create(string role, string text) {
        ChatMessage m = new ChatMessage();
        m.role = role;
        m.text = text;
        m.reason = "";
        m.agent = "";
        m.to = "";
        m.kind = "";
        m.taskId = "";
        m.progress = 0;
        m.call = "";
        m.at = DateTime.UtcNow().ToUnixSeconds();
        m.img = "";
        m.msgId = "";
        m.mark = -1;
        m.quoteWho = "";
        m.quoteText = "";
        m.quoteId = "";
        return m;
    }

    // 一条带图片的消息（气泡模式画图片，记录模式画正文）。
    public static ChatMessage CreateImage(string role, string path, string text) {
        ChatMessage m = ChatMessage.Create(role, text);
        m.img = path;
        return m;
    }

    // 带思考过程的普通消息。
    public static ChatMessage CreateWithReason(string role, string text, string reason) {
        ChatMessage m = ChatMessage.Create(role, text);
        m.reason = reason;
        return m;
    }

    // 一条带信封的团队消息。
    public static ChatMessage CreateFrom(string role, string text, string agent,
            string to, string kind, string taskId, int progress) {
        ChatMessage m = ChatMessage.Create(role, text);
        m.agent = agent;
        m.to = to;
        m.kind = kind;
        m.taskId = taskId;
        m.progress = progress;
        return m;
    }
}

// 一位发言者的外观：显示名、色调与 Tag 类名。多智能体程序用它把
// 成员 id 翻成头行上看到的样子；单助手程序用不到。
