using System;
using System.Collections.Generic;
using Gui;
using Gui.Rendering;

namespace Gui.Component;

public class ChatSpeaker {
    string name;
    int tint;
    string tagCls;

    // 组装一位发言者外观。
    static ChatSpeaker Of(string name, int tint, string tagCls) {
        ChatSpeaker s = new ChatSpeaker();
        s.name = name;
        s.tint = tint;
        s.tagCls = tagCls;
        return s;
    }
}

// 把成员 id 解析成外观；返回 null 表示「不认识这个 id，按默认助手画」。

