using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Component.CodeEditor;

// CodeEditor 分部：代码折叠引擎（折叠区间管理、可见行映射与展开折叠状态）
public partial class CodeEditor {
    // ---- 代码折叠 ----
    // 区间由宿主从 LSP textDocument/foldingRange 注入；编辑器的职责只有
    // 折叠状态、行布局过滤与槽内点击，不重复实现语法扫描。

    // 注入折叠区间（使用 CodeFoldRegion 强类型实体集合）。
    public void SetFoldRegions(List<CodeFoldRegion> regions) {
        if (foldRegions == null) {
            foldRegions = new List<CodeFoldRegion>();
        } else {
            foldRegions.Clear();
        }
        if (regions == null) { return; }
        for (int i = 0; i < regions.Count; i = i + 1) {
            CodeFoldRegion r = regions[i];
            if (r == null || r.startLine < 0 || r.endLine < r.startLine) { continue; }
            foldRegions.Add(new CodeFoldRegion(r.startLine, r.endLine, r.folded));
        }
    }

    // 注入折叠区间（兼容接口，0 起行号、闭区间，end 行保持可见）。
    // 覆盖上一次注入；当前折叠状态一并复位。
    public void SetFoldRanges(List<int> starts, List<int> ends) {
        if (foldRegions == null) {
            foldRegions = new List<CodeFoldRegion>();
        } else {
            foldRegions.Clear();
        }
        if (starts == null || ends == null) { return; }
        int n = starts.Count < ends.Count ? starts.Count : ends.Count;
        for (int i = 0; i < n; i = i + 1) {
            // 只收区间起点非负的条目并保持按起点有序（LSP 栈扫描
            // 天然有序，这里只做防御性过滤）。
            if (starts[i] < 0 || ends[i] < starts[i]) { continue; }
            foldRegions.Add(new CodeFoldRegion(starts[i], ends[i], false));
        }
    }

    // 已注入的折叠区间数。
    public int FoldRegionCount() {
        if (foldRegions == null) { return 0; }
        return foldRegions.Count;
    }

    // 有区间处于折叠状态时为 true；此时行布局/滚动按可见行解释。
    public bool AnyFolded() {
        if (foldRegions == null) { return false; }
        for (int i = 0; i < foldRegions.Count; i = i + 1) {
            if (foldRegions[i].folded) { return true; }
        }
        return false;
    }

    // 区间 `i` 在当前缓冲区内仍然成立：行号在界内且首尾行带花括号。
    // 文本编辑会让行号漂移，失效区间不得再隐藏内容。
    public bool FoldRegionValid(int i) {
        if (foldRegions == null || i < 0 || i >= foldRegions.Count) { return false; }
        int s = foldRegions[i].startLine;
        int e = foldRegions[i].endLine;
        if (s < 0 || e < s || e >= lines.Count) { return false; }
        return lines[s].IndexOf("{") >= 0 && lines[e].IndexOf("}") >= 0;
    }

    // `line`（0 起）是某个有效区间的折叠起点时返回 true（槽位画标记）。
    public bool FoldableAt(int line) {
        for (int i = 0; i < FoldRegionCount(); i = i + 1) {
            if (foldRegions[i].startLine == line && FoldRegionValid(i)) { return true; }
        }
        return false;
    }

    // `line` 是折叠中（有效且已折叠）区间的起点时返回 true。
    public bool FoldedAt(int line) {
        for (int i = 0; i < FoldRegionCount(); i = i + 1) {
            if (foldRegions[i].startLine == line && foldRegions[i].folded && FoldRegionValid(i)) { return true; }
        }
        return false;
    }

    // `line` 被某个已折叠的有效区间隐藏（起点行本身可见）时返回 true。
    public bool FoldHides(int line) {
        for (int i = 0; i < FoldRegionCount(); i = i + 1) {
            if (foldRegions[i].folded && FoldRegionValid(i)
                && line > foldRegions[i].startLine && line <= foldRegions[i].endLine) { return true; }
        }
        return false;
    }

    // 切换以 `line` 为起点的折叠；该行不是有效折叠起点时无操作。
    public void ToggleFold(int line) {
        for (int i = 0; i < FoldRegionCount(); i = i + 1) {
            if (foldRegions[i].startLine == line && FoldRegionValid(i)) {
                foldRegions[i].folded = !foldRegions[i].folded;
                return;
            }
        }
    }

    // 全部展开（编辑后行号漂移的安全态；BumpTextVersion 已自动调用）。
    public void UnfoldAll() {
        if (foldRegions == null) { return; }
        for (int i = 0; i < foldRegions.Count; i = i + 1) {
            foldRegions[i].folded = false;
        }
    }

    // `line` 落在隐藏区时展开覆盖它的区间（光标/执行行落点保护）。
    public void UnfoldContaining(int line) {
        for (int i = 0; i < FoldRegionCount(); i = i + 1) {
            if (foldRegions[i].folded && FoldRegionValid(i)
                && line > foldRegions[i].startLine && line <= foldRegions[i].endLine) {
                foldRegions[i].folded = false;
            }
        }
    }

    // 展开 `line` 处的折叠（VS 的「展开」）：光标落在已折叠区间的
    // 起点行或被它盖住的行里时，展开这一层。
    public void ExpandFoldAt(int line) {
        for (int i = 0; i < FoldRegionCount(); i = i + 1) {
            if (foldRegions[i].folded && FoldRegionValid(i)
                && line >= foldRegions[i].startLine && line <= foldRegions[i].endLine) {
                foldRegions[i].folded = false;
            }
        }
    }

    // 折叠生效时整个缓冲区的可见行数（供滚动上限）。
    // 三趟遍历同序：先判本行可见（此前的 hideEnd），
    // 再让以本行为起点的折叠区间延伸隐藏段——起点行本身可见。
    public int FoldVisibleTotal() {
        int visible = 0;
        int hideEnd = 0 - 1;
        int ri = 0;
        for (int ln = 0; ln < lines.Count; ln = ln + 1) {
            if (ln > hideEnd) { visible = visible + 1; }
            while (ri < FoldRegionCount() && foldRegions[ri].startLine < ln) { ri = ri + 1; }
            if (ri < FoldRegionCount() && foldRegions[ri].startLine == ln
                && foldRegions[ri].folded && FoldRegionValid(ri) && foldRegions[ri].endLine > hideEnd) {
                hideEnd = foldRegions[ri].endLine;
            }
        }
        return visible;
    }

    // 可见行号 `row` 对应的文档行（滚动顶部行映射）；越界取最后可见行。
    public int FoldDocLineOfRow(int row) {
        if (!AnyFolded()) { return row; }
        int hideEnd = 0 - 1;
        int ri = 0;
        int lastVis = 0;
        for (int ln = 0; ln < lines.Count; ln = ln + 1) {
            if (ln > hideEnd) {
                if (row <= 0) { return ln; }
                row = row - 1;
                lastVis = ln;
            }
            while (ri < FoldRegionCount() && foldRegions[ri].startLine < ln) { ri = ri + 1; }
            if (ri < FoldRegionCount() && foldRegions[ri].startLine == ln
                && foldRegions[ri].folded && FoldRegionValid(ri) && foldRegions[ri].endLine > hideEnd) {
                hideEnd = foldRegions[ri].endLine;
            }
        }
        return lastVis;
    }

    // 文档行 `docLine` 折叠后对应的可见行号（保持光标可见用）。
    public int FoldVisibleRowOf(int docLine) {
        if (!AnyFolded()) { return docLine; }
        int row = 0;
        int hideEnd = 0 - 1;
        int ri = 0;
        for (int ln = 0; ln < docLine && ln < lines.Count; ln = ln + 1) {
            if (ln > hideEnd) { row = row + 1; }
            while (ri < FoldRegionCount() && foldRegions[ri].startLine < ln) { ri = ri + 1; }
            if (ri < FoldRegionCount() && foldRegions[ri].startLine == ln
                && foldRegions[ri].folded && FoldRegionValid(ri) && foldRegions[ri].endLine > hideEnd) {
                hideEnd = foldRegions[ri].endLine;
            }
        }
        return row;
    }

    // 跳过 `ln` 所在的隐藏段，返回其后第一个可见行。
    public int FoldNextVisible(int ln) {
        int ln2 = ln;
        bool again = true;
        while (again) {
            again = false;
            for (int i = 0; i < FoldRegionCount(); i = i + 1) {
                if (foldRegions[i].folded && FoldRegionValid(i)
                    && ln2 > foldRegions[i].startLine && ln2 <= foldRegions[i].endLine) {
                    ln2 = foldRegions[i].endLine + 1;
                    again = true;
                }
            }
        }
        return ln2;
    }
}
