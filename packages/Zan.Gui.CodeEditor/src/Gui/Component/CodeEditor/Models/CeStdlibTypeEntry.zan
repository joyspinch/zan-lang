using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Component.CodeEditor;

public class CeStdlibTypeEntry {
    string name;
    string ns;

    CeStdlibTypeEntry(string name, string ns) {
        this.name = name;
        this.ns = ns;
    }
}

