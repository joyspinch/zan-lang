using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Component.CodeEditor;

public class CodeFoldRegion {
    int startLine;
    int endLine;
    bool folded;

    CodeFoldRegion(int startLine, int endLine, bool folded) {
        this.startLine = startLine;
        this.endLine = endLine;
        this.folded = folded;
    }
}

// 括号与 using 行扫描缓存实体（消除 ceLineSrc / ceBrace / ceParen / ceUsingBad 平行列表反模式）。
