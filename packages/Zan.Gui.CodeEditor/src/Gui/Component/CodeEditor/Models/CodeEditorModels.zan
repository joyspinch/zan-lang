using Gui.Widget;
using Gui;
using System.Collections.Generic;
using System;

namespace Gui.Component.CodeEditor;

// 调试器变量的一行（名称 / 类型 / 值），显示在 Variables
// 面板和编辑器调试悬停提示中。用单个实体取代旧的
// 制表符分隔的 "name\ttype\tvalue" 字符串。
public class DbgVar {
    string name;
    string type;
    string val;

    DbgVar(string name, string type, string val) {
        this.name = name;
        this.type = type;
        this.val = val;
    }
}

public class Caret {
    int line;
    int col;

    Caret(int line, int col) {
        this.line = line;
        this.col = col;
    }
}

class CodeCompletionDescription {
    public int X;
    public int Y;
    public int Width;
    public int Height;
    public string Kind;
    public List<string> Signature;
    public List<string> Documentation;
}

public class CodeCompletionItem {
    string label;
    string kind;
    string detail;
    string doc;
    string insertText;
    bool hasTextEdit;
    // insertText 是片段模板（不是普通文本）：插入后要按模板展开成
    // "骨架 + 一串洞"，Tab 在洞之间跳（Visual Studio 的做法）。
    bool isSnippet;
    int startLine;
    int startCol;
    int endLine;
    int endCol;

    CodeCompletionItem(string label, string kind, string detail, string doc) {
        this.label = label;
        this.kind = kind;
        this.detail = detail;
        this.doc = doc;
        this.insertText = "";
    }
}

// The retained menu owns callbacks, while every business endpoint stays borrowed.
class CodeEditorMenuSession : InputRetirementObserver {
    public weak CodeEditor Owner;
    public weak App Host;
    public weak Control Root;
    public weak ContextMenu Menu;
    public int Generation;
    public InputRetirementToken Retirement;

    public void Invalidate() {
        if (Retirement != null) { Retirement.Invalidate(); Retirement = null; }
    }

    public void Selected(Control sender) {
        CodeEditor editor = Owner;
        if (editor != null && sender == Menu) { editor.ContextMenuFinished(this, sender, true); }
    }

    public void Dismissed(Control sender) {
        CodeEditor editor = Owner;
        if (editor != null && sender == Menu) { editor.ContextMenuFinished(this, sender, false); }
    }

    public void OnInputRetired(InputRetirementToken token) {
        if (token != Retirement) { return; }
        Retirement = null;
        CodeEditor editor = Owner;
        if (editor != null) { editor.ContextMenuRetired(this); }
    }
}

public class CodeEditorPreparedSymbolIndex {
    List<CeSymbolMember> members;
    List<CeSymbolType> types;
}

public class CodeEditorPreparedText {
    List<string> lines;
    string text;
    bool applied;
}

public class CodeEditorTextLoad {
    string path;
    string previousPath;
    int version;
    int language;
}

// Evidence for one synchronous layout/provider call chain.
class CodeEditorViewProof {
    public weak App Host;
    public weak Control Root;
    public weak Control Focused;
    public Canvas Surface;
    public int Generation;
    public long Sequence;
    public int Revision;
    public string Path;
    public int Stamp;
    public int Line;
    public int Column;
}

public class CodeFoldRegion {
    int startLine;
    int endLine;
    bool folded;

    CodeFoldRegion(int startLine, int endLine, bool folded) {
        this.startLine = startLine;
        this.endLine = endLine;
        this.folded = folded;
    }
}

public class CodeLensRef {
    int line;
    string name;
    int x;
    int y;
    int w;
    // 透镜显示的内容：本缓冲区的使用数加项目其余
    // 部分的使用数。点击时与缓冲区可列出的比较，
    // 不同则请求宿主提供完整列表。
    int count;

    CodeLensRef(int line, string name, int x, int y, int w, int count) {
        this.line = line;
        this.name = name;
        this.x = x;
        this.y = y;
        this.w = w;
        this.count = count;
    }
}

public class CodeSemanticProviderLease { }

class CodeSignatureLayout {
    public int X;
    public int Y;
    public int Width;
    public int Height;
    public int Argument;
    public string Signature;
    public List<string> SignatureLines;
    public List<string> DocumentationLines;
    public string Counter;
    public int CounterWidth;
}

public class CodeSpan {
    string text;
    int color;
    int width;

    // 组装一段带色的高亮文本。
    CodeSpan(string text, int color) {
        this.text = text;
        this.color = color;
        this.width = 0 - 1;
    }
}

public class ContextMenuItem {
    string label;
    string key;
    int action;
    // 宿主命令名：只在宿主段（action >= 100）有意义——点选后
    // 控件把命令名写进 ctxCmd，宿主经 TakeCommand() 取走。
    string cmd;

    // `action` 为 0 时 label/key 被忽略（纯分隔行）。
    ContextMenuItem(string label, string key, int action) {
        this.label = label;
        this.key = key;
        this.action = action;
        this.cmd = "";
    }
}

// 一条诊断。三个来源共用它：
//   ① 编辑器本地语法检查（整行，无区间）；
//   ② 语言服务（LSP）推送的语义诊断（带精确区间，用于波浪线）；
//   ③ Run/Build 的编译器诊断（整行，无区间）。
public class Diagnostic {
    int line;
    string msg;
    // 诊断区间：起列与止列（字节列，含起不含止）。-1 表示"整行"。
    int startCol;
    int endCol;
    // 1 = 错误，2 = 警告，3 = 提示。
    int severity;

    Diagnostic(int line, string msg) {
        this.line = line;
        this.msg = msg;
        this.startCol = -1;
        this.endCol = -1;
        this.severity = 1;
    }

    // 带区间的诊断：语言服务推送的诊断带精确范围，
    // 波浪线只画在出错的那几个字符下面（VS 的做法）。
    Diagnostic(int line, int startCol, int endCol, int severity, string msg) {
        this.line = line;
        this.msg = msg;
        this.startCol = startCol;
        this.endCol = endCol;
        this.severity = severity;
    }

    // 区间是否可用于精确定位（两端都在行内且非空）。
    bool HasRange() {
        return startCol >= 0 && endCol > startCol;
    }

    // 严重级归到三档：0 错误 / 1 警告 / 2 提示。
    int SeveritySlot() {
        if (severity == 2) { return 1; }
        if (severity >= 3) { return 2; }
        return 0;
    }
}

public class EditSnapshot {
    List<string> lines;
    string text;
    int line;
    int col;

    EditSnapshot(List<string> lines, int line, int col) {
        this.lines = lines;
        this.text = "";
        this.line = line;
        this.col = col;
    }

    EditSnapshot(string text, int line, int col) {
        this.lines = null;
        this.text = text;
        this.line = line;
        this.col = col;
    }
}

public class QuickFix {
    int line;
    string ns;

    QuickFix(int line, string ns) {
        this.line = line;
        this.ns = ns;
    }
}
