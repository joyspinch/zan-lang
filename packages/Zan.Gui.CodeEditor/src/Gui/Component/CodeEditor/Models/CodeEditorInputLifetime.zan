using Gui;

namespace Gui.Component.CodeEditor;

class CodeEditorInputLifetime : InputRetirementObserver {
    public weak CodeEditor Owner;
    public weak App Host;
    public InputRetirementToken Token;

    public void OnInputRetired(InputRetirementToken token) {
        if (token != Token) { return; }
        Token = null;
        CodeEditor editor = Owner;
        if (editor != null) { editor.EditorInputRetired(this); }
    }
}
