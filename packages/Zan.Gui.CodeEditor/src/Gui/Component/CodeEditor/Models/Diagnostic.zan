using System;
using System.Collections.Generic;
using Gui;
using Gui.Rendering;

namespace Gui.Component.CodeEditor;

public class Diagnostic {
    int line;
    string msg;

    Diagnostic(int line, string msg) {
        this.line = line;
        this.msg = msg;
    }
}

