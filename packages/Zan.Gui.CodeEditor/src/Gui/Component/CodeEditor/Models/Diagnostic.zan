using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Component.CodeEditor;

// 一条诊断。三个来源共用它：
//   ① 编辑器本地语法检查（整行，无区间）；
//   ② 语言服务（LSP）推送的语义诊断（带精确区间，用于波浪线）；
//   ③ Run/Build 的编译器诊断（整行，无区间）。
public class Diagnostic {
    int line;
    string msg;
    // 诊断区间：起列与止列（字节列，含起不含止）。-1 表示"整行"。
    int startCol;
    int endCol;
    // 1 = 错误，2 = 警告，3 = 提示。
    int severity;

    Diagnostic(int line, string msg) {
        this.line = line;
        this.msg = msg;
        this.startCol = -1;
        this.endCol = -1;
        this.severity = 1;
    }

    // 带区间的诊断：语言服务推送的诊断带精确范围，
    // 波浪线只画在出错的那几个字符下面（VS 的做法）。
    Diagnostic(int line, int startCol, int endCol, int severity, string msg) {
        this.line = line;
        this.msg = msg;
        this.startCol = startCol;
        this.endCol = endCol;
        this.severity = severity;
    }

    // 区间是否可用于精确定位（两端都在行内且非空）。
    bool HasRange() {
        return startCol >= 0 && endCol > startCol;
    }

    // 严重级归到三档：0 错误 / 1 警告 / 2 提示。
    int SeveritySlot() {
        if (severity == 2) { return 1; }
        if (severity >= 3) { return 2; }
        return 0;
    }
}

// 一条缺失 using 的快速修复：其解决错误的行以及
// 要导入的命名空间。用单个实体取代并行的行/命名空间列表。
