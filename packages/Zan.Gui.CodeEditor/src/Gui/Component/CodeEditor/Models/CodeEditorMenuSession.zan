using Gui;
using Gui.Widget;

namespace Gui.Component.CodeEditor;

// The retained menu owns callbacks, while every business endpoint stays borrowed.
class CodeEditorMenuSession : InputRetirementObserver {
    public weak CodeEditor Owner;
    public weak App Host;
    public weak Control Root;
    public weak ContextMenu Menu;
    public int Generation;
    public InputRetirementToken Retirement;

    public void Invalidate() {
        if (Retirement != null) { Retirement.Invalidate(); Retirement = null; }
    }

    public void Selected(Control sender) {
        CodeEditor editor = Owner;
        if (editor != null && sender == Menu) { editor.ContextMenuFinished(this, sender, true); }
    }

    public void Dismissed(Control sender) {
        CodeEditor editor = Owner;
        if (editor != null && sender == Menu) { editor.ContextMenuFinished(this, sender, false); }
    }

    public void OnInputRetired(InputRetirementToken token) {
        if (token != Retirement) { return; }
        Retirement = null;
        CodeEditor editor = Owner;
        if (editor != null) { editor.ContextMenuRetired(this); }
    }
}
