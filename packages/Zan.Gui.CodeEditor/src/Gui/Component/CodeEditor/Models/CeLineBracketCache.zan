using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Component.CodeEditor;

public class CeLineBracketCache {
    string src;
    int brace;
    int paren;
    int usingBad;

    CeLineBracketCache(string src, int brace, int paren, int usingBad) {
        this.src = src;
        this.brace = brace;
        this.paren = paren;
        this.usingBad = usingBad;
    }
}
