using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Component.CodeEditor;

public class CodeSpan {
    string text;
    int color;
    int width;

    // 组装一段带色的高亮文本。
    CodeSpan(string text, int color) {
        this.text = text;
        this.color = color;
        this.width = 0 - 1;
    }
}
