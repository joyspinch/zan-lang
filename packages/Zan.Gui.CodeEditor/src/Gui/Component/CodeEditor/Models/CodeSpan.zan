using System;
using System.Collections.Generic;
using Gui;
using Gui.Rendering;

namespace Gui.Component.CodeEditor;

public class CodeSpan {
    string text;
    int color;
    int width;

    // 组装一段带色的高亮文本。
    CodeSpan(string text, int color) {
        this.text = text;
        this.color = color;
        this.width = 0 - 1;
    }
}

// CodeEditor 分部：语法高亮（按行缓存的词法分析）
// 和主渲染路径（装订线、文本、光标、弹窗、缩略图）。
