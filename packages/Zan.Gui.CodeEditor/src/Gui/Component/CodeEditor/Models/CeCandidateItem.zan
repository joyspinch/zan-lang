using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Component.CodeEditor;

public class CeCandidateItem {
    string item;
    string kind;
    CodeCompletionItem semantic;
    // 种类的整数序号。排序时按种类分组/配额要在候选之间来回比较
    // 种类，用字符串比会慢一个量级（工程大时列表有几千项）。
    int kindIdx;

    CeCandidateItem(string item, string kind) {
        this.item = item;
        this.kind = kind;
        this.kindIdx = CodeEditor.KindIndex(kind);
    }
}

// 屏幕可见行布局映射实体（消除 rowLine / rowTop / rowLensY / rowDecl 平行列表反模式）。
