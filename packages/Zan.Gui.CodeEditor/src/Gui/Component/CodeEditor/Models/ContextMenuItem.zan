using System;
using System.Collections.Generic;
using Gui;
using Gui.Rendering;

namespace Gui.Component.CodeEditor;

public class ContextMenuItem {
    string label;
    string key;
    int action;
    // 宿主命令名：只在宿主段（action >= 100）有意义——点选后
    // 控件把命令名写进 ctxCmd，宿主经 TakeCommand() 取走。
    string cmd;

    // `action` 为 0 时 label/key 被忽略（纯分隔行）。
    ContextMenuItem(string label, string key, int action) {
        this.label = label;
        this.key = key;
        this.action = action;
        this.cmd = "";
    }
}

// 自动补全候选条目实体（消除 acAllItems / acAllKinds 平行列表反模式）。
