using System;
using System.Collections.Generic;
using Gui;
using Gui.Rendering;

namespace Gui.Component.CodeEditor;

public class ContextMenuItem {
    string label;
    string key;
    int action;

    // `action` 为 0 时 label/key 被忽略（纯分隔行）。
    ContextMenuItem(string label, string key, int action) {
        this.label = label;
        this.key = key;
        this.action = action;
    }
}

// 自动补全候选条目实体（消除 acAllItems / acAllKinds 平行列表反模式）。
