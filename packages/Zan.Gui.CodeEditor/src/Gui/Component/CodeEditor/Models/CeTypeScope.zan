using System;
using System.Collections.Generic;
using Gui;
using Gui.Rendering;

namespace Gui.Component.CodeEditor;

public class CeTypeScope {
    public string typeName;
    public int depth;

    public CeTypeScope(string typeName, int depth) {
        this.typeName = typeName;
        this.depth = depth;
    }
}

