using System;
using System.Collections.Generic;
using Gui;
using Gui.Rendering;

namespace Gui.Component.CodeEditor;

public class QuickFix {
    int line;
    string ns;

    QuickFix(int line, string ns) {
        this.line = line;
        this.ns = ns;
    }
}

