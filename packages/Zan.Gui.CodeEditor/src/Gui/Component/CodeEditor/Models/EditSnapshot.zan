using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Component.CodeEditor;

public class EditSnapshot {
    List<string> lines;
    string text;
    int line;
    int col;

    EditSnapshot(List<string> lines, int line, int col) {
        this.lines = lines;
        this.text = "";
        this.line = line;
        this.col = col;
    }

    EditSnapshot(string text, int line, int col) {
        this.lines = null;
        this.text = text;
        this.line = line;
        this.col = col;
    }
}

// 一条诊断：所在行（从 0 起）和消息。
// 用单个实体取代并行的行/消息列表。
