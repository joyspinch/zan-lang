using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Component.CodeEditor;

public class CodeLensRef {
    int line;
    string name;
    int x;
    int y;
    int w;
    // 透镜显示的内容：本缓冲区的使用数加项目其余
    // 部分的使用数。点击时与缓冲区可列出的比较，
    // 不同则请求宿主提供完整列表。
    int count;

    CodeLensRef(int line, string name, int x, int y, int w, int count) {
        this.line = line;
        this.name = name;
        this.x = x;
        this.y = y;
        this.w = w;
        this.count = count;
    }
}

// 一个项目类型：名称及其空格分隔的
// 声明成员名列表。用单个实体取代并行的名称/成员列表。
