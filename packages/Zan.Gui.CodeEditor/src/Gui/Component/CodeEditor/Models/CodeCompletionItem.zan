using System;
using System.Collections.Generic;
using Gui;
using Gui.Rendering;

namespace Gui.Component.CodeEditor;

public class CodeCompletionItem {
    string label;
    string kind;
    string detail;
    string doc;
    string insertText;
    bool hasTextEdit;
    int startLine;
    int startCol;
    int endLine;
    int endCol;

    CodeCompletionItem(string label, string kind, string detail, string doc) {
        this.label = label;
        this.kind = kind;
        this.detail = detail;
        this.doc = doc;
        this.insertText = "";
    }
}

