using System;
using System.Collections.Generic;
using Gui;
using Gui.Rendering;

namespace Gui.Component.CodeEditor;

public class CodeCompletionItem {
    string label;
    string kind;
    string detail;
    string doc;
    string insertText;
    bool hasTextEdit;
    // insertText 是片段模板（不是普通文本）：插入后要按模板展开成
    // "骨架 + 一串洞"，Tab 在洞之间跳（Visual Studio 的做法）。
    bool isSnippet;
    int startLine;
    int startCol;
    int endLine;
    int endCol;

    CodeCompletionItem(string label, string kind, string detail, string doc) {
        this.label = label;
        this.kind = kind;
        this.detail = detail;
        this.doc = doc;
        this.insertText = "";
    }
}

