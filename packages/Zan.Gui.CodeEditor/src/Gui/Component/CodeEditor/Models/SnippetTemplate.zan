using System;
using System.Collections.Generic;

namespace Gui.Component.CodeEditor;

// 片段（snippet）模板：展开后的文本 + 一串"洞"（占位符）。
//
// 洞的位置不记死偏移，而是链式推进：
//   洞 i+1 的起点 = 洞 i 的终点 + 两者之间那段固定文本
// 片段模式下用户只往洞里打字，洞之间的固定文本不会变，
// 所以只要盯住当前洞的终点，后面的洞就跟着走。
public class SnippetTemplate {
    // 展开后的文本（洞已填入默认文本）。
    public string text = "";
    // 每个洞：组号（相同序号归一组）、在 text 中的字节起点、默认文本字节长度。
    public List<int> holeGroup = new List<int>();
    public List<int> holeStart = new List<int>();
    public List<int> holeLen = new List<int>();
    // $0（最终光标）在 text 中的字节偏移；没有则 -1。
    public int finalOffset = -1;
}

// 片段模板解析。支持的写法：
//   $1  $2            —— 序号洞（无默认文本）
//   ${1:默认值}       —— 带默认文本的序号洞
//   ${1|a,b,c|}       —— 带选项的序号洞（默认取第一项）
//   ${1}              —— 序号洞
//   $0                —— 最终光标位置
//   $C$               —— 编辑器内置片段的游标标记（老模板在用）
//   \$ \} \\          —— 转义
// 同组号的多次出现（镜像洞）只保留第一个可跳转的洞，
// 其余出现照样填默认文本，但不参与 Tab 跳转。
public class SnippetParser {
    public static SnippetTemplate Parse(string body) {
        SnippetTemplate t = new SnippetTemplate();
        StringBuilder sb = new StringBuilder();
        List<int> seen = new List<int>();
        int n = body.Length;
        int i = 0;
        int runStart = 0;
        while (i < n) {
            int ch = body[i] & 255;
            if (ch != 36 && ch != 92) { i = i + 1; continue; }
            // 普通文本整段追加（按字节切会把多字节字符切坏）
            if (i > runStart) { sb.Append(body.Substring(runStart, i - runStart)); }
            int outLen = sb.Length;
            if (ch == 92) {
                // 反斜杠转义：只对 $ } \ 生效，其它照原样保留
                if (i + 1 < n) {
                    int nx = body[i + 1] & 255;
                    if (nx == 36 || nx == 125 || nx == 92) {
                        sb.Append(body.Substring(i + 1, 1));
                        i = i + 2;
                        runStart = i;
                        continue;
                    }
                }
                sb.Append(body.Substring(i, 1));
                i = i + 1;
                runStart = i;
                continue;
            }
            // '$'
            if (i + 1 >= n) { sb.Append("$"); i = i + 1; runStart = i; continue; }
            int nx = body[i + 1] & 255;
            if (nx == 36) { sb.Append("$"); i = i + 2; runStart = i; continue; }
            if (nx == 67 && i + 2 < n && (body[i + 2] & 255) == 36) {
                // "$C$"：内置片段的游标标记（当作一个空洞）
                SnippetParser.AddHole(t, sb, 0, outLen, "", seen);
                i = i + 3;
                runStart = i;
                continue;
            }
            if (nx == 123) {
                // "${...}"：找配对的 '}'
                int j = i + 2;
                int depth = 1;
                while (j < n) {
                    int c2 = body[j] & 255;
                    if (c2 == 92) { j = j + 2; continue; }
                    if (c2 == 123) { depth = depth + 1; }
                    else if (c2 == 125) {
                        depth = depth - 1;
                        if (depth == 0) { break; }
                    }
                    j = j + 1;
                }
                if (j >= n) { sb.Append("$"); i = i + 1; runStart = i; continue; }
                string content = body.Substring(i + 2, j - (i + 2));
                int group = 0;
                string def = SnippetParser.ContentOf(content, out group);
                SnippetParser.AddHole(t, sb, group, outLen, def, seen);
                i = j + 1;
                runStart = i;
                continue;
            }
            if (nx >= 48 && nx <= 57) {
                int j = i + 1;
                int num = 0;
                while (j < n) {
                    int c2 = body[j] & 255;
                    if (c2 < 48 || c2 > 57) { break; }
                    num = num * 10 + (c2 - 48);
                    j = j + 1;
                }
                if (num == 0) { t.finalOffset = outLen; }
                else { SnippetParser.AddHole(t, sb, num, outLen, "", seen); }
                i = j;
                runStart = i;
                continue;
            }
            sb.Append("$");
            i = i + 1;
            runStart = i;
        }
        if (n > runStart) { sb.Append(body.Substring(runStart, n - runStart)); }
        t.text = sb.ToString();
        return t;
    }

    // 记一个洞；同组号只留第一个（镜像洞不跳转，但照样填默认文本）。
    static void AddHole(SnippetTemplate t, StringBuilder sb, int group, int start,
                        string def, List<int> seen) {
        for (int i = 0; i < seen.Count; i = i + 1) {
            if (seen[i] == group) { sb.Append(def); return; }
        }
        seen.Add(group);
        t.holeGroup.Add(group);
        t.holeStart.Add(start);
        t.holeLen.Add(def.Length);
        sb.Append(def);
    }

    // 解析 "${...}" 里的内容：组号 + 默认文本。
    //   "1:默认值"  "1|a,b|"  "1"
    public static string ContentOf(string content, out int group) {
        group = 0;
        int n = content.Length;
        int i = 0;
        int num = 0;
        while (i < n) {
            int c = content[i] & 255;
            if (c < 48 || c > 57) { break; }
            num = num * 10 + (c - 48);
            i = i + 1;
        }
        group = num;
        if (i >= n) { return ""; }
        int sep = content[i] & 255;
        if (sep == 58) {
            // ':' 之后全是默认文本（可以再带冒号）
            return content.Substring(i + 1, n - (i + 1));
        }
        if (sep == 124) {
            // '|' 之间是选项列表，默认取第一项
            int j = i + 1;
            int optStart = j;
            while (j < n) {
                int c2 = content[j] & 255;
                if (c2 == 124 || c2 == 44) { break; }
                j = j + 1;
            }
            return content.Substring(optStart, j - optStart);
        }
        return "";
    }
}
