using System;
using System.Collections.Generic;
using Gui;
using Gui.Rendering;

namespace Gui.Component.CodeEditor;

public class CeSymbolType {
    public string name;
    public string baseTypes;

    public CeSymbolType(string name, string baseTypes) {
        this.name = name;
        this.baseTypes = baseTypes;
    }
}

