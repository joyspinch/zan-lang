public class CeAnalysisLease { }

// 行表只复制不可变字符串引用，后台不得读取 live 编辑器的集合。

public class CeAnalysisLensResult {
    Dict<int, int> counts;
    Dict<int, List<int>> references;
}

public class CeAnalysisResult {
    List<Diagnostic> errors;
    List<QuickFix> fixes;
