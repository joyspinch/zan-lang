    List<ProjType> projectTypes;
    List<CeCompletionCandidate> candidates;
    List<CeHlLine> highlights;
    CeFileIndex references;
    Dict<string, string> signatures;
    List<string> imports;
    string fileNamespace;
}

public class CeAnalysisSnapshot {
    CeAnalysisLease lease;
    List<string> lines;
    List<string> projectSources;
    List<ProjType> projectTypes;
    List<CeSymbolType> symbolTypes;
    string path;
    int version;
    int projectVersion;
    int symbolVersion;
    int language;
    int themeSignature;
    int keywordColor;
    int typeColor;
    int stringColor;
    int commentColor;
    int numberColor;
    int textColor;
    AtomicInt cancelled;
}

public class CeBufType {
    string name;
    string members;

    CeBufType(string name, string members) {
        this.name = name;
        this.members = members;
    }
}

public class CeCandidateItem {
    string item;
    string kind;
    CodeCompletionItem semantic;
    // 种类的整数序号。排序时按种类分组/配额要在候选之间来回比较
    // 种类，用字符串比会慢一个量级（工程大时列表有几千项）。
    int kindIdx;

    CeCandidateItem(string item, string kind) {
        this.item = item;
        this.kind = kind;
        this.kindIdx = CodeEditor.KindIndex(kind);
    }
}

public class CeCompletionCandidate {
    string item;
    string kind;

    CeCompletionCandidate(string item, string kind) {
        this.item = item;
        this.kind = kind;
    }
}

public class CeExtRefCount {
    string key;
    int count;

    CeExtRefCount(string key, int count) {
        this.key = key;
        this.count = count;
    }
}

public class CeExtRefDecl {
    string owner;
    string name;

    CeExtRefDecl(string owner, string name) {
        this.owner = owner;
        this.name = name;
    }
}

public class CeFileIndex {
    // 抹除了字面量与注释的行（与源文件行号一一对应）。
    List<string> stripped;
    // 每行所属的类型体名（不在任何类型内为 ""）。
    List<string> owners;
    // 每行声明的成员名（无声明为 ""）。
    List<string> decls;

    // 为整份源码建文件索引：抹除字面量/注释、划分每行的
    // owner 类型、摘出每行声明的成员名，三份结果一次算齐。
    public static CeFileIndex Of(List<string> ls) {
        CeFileIndex idx = new CeFileIndex();
        idx.stripped = new List<string>();
        CodeEditor.StripCodeInto(ls, idx.stripped);
        idx.owners = new List<string>();
        CodeEditor.OwnerPerLinePre(idx.stripped, idx.owners);
        idx.decls = new List<string>();
        for (int i = 0; i < idx.stripped.Count; i = i + 1) {
            idx.decls.Add(CodeEditor.DeclNameAt(idx.stripped[i]));
        }
        return idx;
    }

    // 源文本的索引（宿主给的项目源码是整篇文本）。
    public static CeFileIndex OfText(string body) {
        return CeFileIndex.Of(CodeEditor.SplitLines(body));
    }
}

