public class CeSemanticCompletionIntent {
    int token;
    string path;
    string text;
    int stamp;
    int line;
    int col;
    int start;
    bool dot;
    bool forced;
}

public class CeSemanticTextMemo {
    string path;
    int version;
    int line;
    int col;
    string name;
    string text;

    public bool Matches(string path, int version, int line, int col, string name) {
        return this.path == path && this.version == version
            && this.line == line && this.col == col && this.name == name;
    }
}

