using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Component.CodeEditor;

public class CeMissingUsingLine {
    string src;
    string ns;
    string word;

    CeMissingUsingLine(string src, string ns, string word) {
        this.src = src;
        this.ns = ns;
        this.word = word;
    }
}

