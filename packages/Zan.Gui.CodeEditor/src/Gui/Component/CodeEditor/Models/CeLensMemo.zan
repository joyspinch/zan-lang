using System;
using System.Collections.Generic;
using Gui;
using Gui.Rendering;

namespace Gui.Component.CodeEditor;

public class CeLensMemo {
    string name;
    int count;
    int fresh;

    CeLensMemo(string name, int count, int fresh) {
        this.name = name;
        this.count = count;
        this.fresh = fresh;
    }
}

