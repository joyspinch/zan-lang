using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Component.CodeEditor;

public class CeSymbolMember {
    public string owner;
    public string name;
    public string kind;
    public string sig;
    public bool isStatic;

    public CeSymbolMember(string owner, string name, string kind, string sig, bool isStatic) {
        this.owner = owner;
        this.name = name;
        this.kind = kind;
        this.sig = sig;
        this.isStatic = isStatic;
    }
}

