    // 连续键入合并撤销状态：0=无、1=打字、2=退格。
    int undoEditKind;
    int undoEditLine;
    int undoEditCol;

    // ---- 错误诊断 ----
    List<Diagnostic> errors;
    int lastDiagLine;       // 上次 CheckErrors 运行时的光标行（-1 = 从未）
    // 上次 Run/Build 的真实编译器诊断，映射到本文件。
    // 与启发式诊断分开保存，下次编辑时失效
    // （以设置诊断时的缓冲区长度 cErrStamp 跟踪）。
    List<Diagnostic> compErrors;
    int cErrStamp;
    // 语言服务（LSP）推送的语义诊断，按文档路径存放：打字即报
