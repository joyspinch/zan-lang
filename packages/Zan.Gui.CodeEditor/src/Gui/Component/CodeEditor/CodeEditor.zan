    // `scrollLine + y / lineH`：按序保存本帧布局的可见行结构
    // （以 CeVisibleRowLayout 实体承载，消除 rowLine / rowTop / rowLensY 平行列表反模式）。
    // 所有行与像素的映射都经 LineAtY / LineTopY，而非算术计算。
    List<CeVisibleRowLayout> visibleRows;
    // 透镜行高度（未显示时为 0）。
    int lensRowH;

    // ---- 自动补全弹窗状态 ----
    List<string> acItems;   // 当前候选列表（已按前缀 + 种类过滤）
    List<CeCandidateItem> acVisibleCandidates;
    string acSourceText;
