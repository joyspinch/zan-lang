    string acSourcePath;
    int acSourceLine;
    int acSourceCol;
    List<CeCandidateItem> acAllCandidates; // 应用种类过滤器之前的候选（以 CeCandidateItem 实体承载，消除平行列表）
    string acFilter;        // "" = 显示所有种类；否则为单个种类字母
    // 弹窗种类过滤条的几何（供点击命中测试）。
    int filtX;
    int filtY;
    int filtW;
    int filtH;
    List<string> acFull;    // 完整未过滤的候选（供点号模式重新过滤）
    // CodeLens：可点击的 "N references" 标注（每次渲染重建）。
