    List<CeCompletionCandidate> cbCandidates;
    int cbGen;
    int candBaseGen;

    // ---- 符号索引（精确、感知 using 的补全） ----
    // 项目其他文件中声明的类型（class/struct/enum），以及
    // 每个类型空格分隔的声明成员名列表。由宿主 IDE
    // 经 SetProjectFiles() 提供，使 `Utils.` 用 Utils 的真实成员补全
    // 而非猜测。当前缓冲区按需扫描。
    List<ProjType> projTypes;
    // 所有其他项目文件的原始源码，保留以便签名帮助解析
    // 用户/项目方法的真实参数列表（不只是名称）。
    List<string> projFileSrc;
    // 跨文件类型扫描被延迟：SetProjectFiles() 只保存
    // 源码（开销小，切换标签页保持流畅）并标记此处为脏；
    // 真正的逐文件 ScanTypesInto 只在补全首次需要时
    // 经 EnsureProjectScan() 运行。
    bool projScanDirty;
    // 跨文件引用计数，本缓冲区声明的每个 "Owner.member" 一个条目，
    // 一次性遍历 projFileSrc 构建（见 EnsureExternRefs），
    // 每帧绘制的每个声明的计数只需一次查找（以 CeExtRefCount 实体承载，消除平行列表）。
    List<CeExtRefCount> extRefCounts;
    bool extRefDirty;
    // 跨文件统计的进度：待统计的下一个 projFileSrc 下标，
    // 已算完为 -1。一帧里把整个项目扫完要数秒，因此声明
    // 列表和计数在帧之间保留，每帧只推进几个文件（以 CeExtRefDecl 实体承载，消除平行列表）。
    int extRefAt;
    List<CeExtRefDecl> extRefDecls;
    // 当前文件内的进度：已建好的行索引、下一个待统计的
    // 声明，以及该声明类型在本文件里的接收者。一个大文件
    // 乘上上百个声明也不能独占一帧，因此切片粒度到声明。
    CeFileIndex extRefFileIdx;
    int extRefDeclAt;
    string extRefOwnerCur;
    List<string> extRefFamily;
    List<string> extRefRecvs;
    // 当前缓冲区的扫描索引（抹除行/逐行 owner/逐行声明名）
    // 及其对应的 TextStamp()。它与被查的成员无关，
    // 每个声明重建一份时单个 CodeLens 就要 50 ms。
    CeFileIndex refIdx;
    int refStamp;
    // 签名帮助记忆：参数列表在屏幕上的被调用者、
    // 为其解析的签名及解析时的 TextStamp()。解析
    // 会遍历缓冲区和项目源码，因此光标仅仅停在调用内时
    // 不能每帧运行。
    string sigMemoName;
    string sigMemoText;
    int sigMemoStamp;
    CeSemanticTextMemo signatureLspMemo;
    CeSemanticTextMemo sigDocLspMemo;
    CeSemanticTextMemo hoverLspMemo;
    CodeSemanticProviderLease semanticProviderLease;
    CeSemanticCompletionIntent semanticCompletionIntent;
    int semanticCompletionEpoch;
    // CodeLens 计数，按成员名对照缓冲区指纹记忆化（以 CeLensMemo 实体承载，消除平行列表）。
    List<CeLensMemo> lensMemos;
    int lensStamp;
    int lensBudget;
    bool lensPending;
    // 缓冲区上次变化的时间，使重算等待输入
    // 停顿而非每次击键都运行。
    int lensQuietMs;
    // 按行语法高亮缓存，与 `lines` 按索引对齐，
    // 以源码文本校验，滚动/空闲时零重新分词。
    // 调色板（主题/覆盖）变化时 hlThemeSig 使整个缓存失效。
    List<CeHlLine> hlCache;
    int hlThemeSig;
    // 缺失 using 的快速修复：每个把出错行映射到
    // 要导入的命名空间以解决错误。
    List<QuickFix> fixes;
    List<CeMissingUsingLine> muLineCaches;
    string muCtx;
    int muStamp;
    // 括号配平扫描的按行缓存，同样以 `lines` 为下标（以 CeLineBracketCache 实体承载，消除平行列表）。
    List<CeLineBracketCache> ceLineCaches;

    // ---- 调试 ----
    List<int> bps;
    int execLine;
    List<DbgVar> dbgVars;   // 调试悬停提示的变量
    DbgVar hoverTip;        // 当前悬停提示条目（无则为 null）
    int hoverTipX;
    int hoverTipY;
    int lastHoverMoveMs;
    int lastHoverX;
    int lastHoverY;

    // ---- 代码折叠 ----
    // 区间来自宿主（LSP foldingRange）：0 起行号、闭区间 [start,end]，
    // end 行保持可见；按 startLine 升序存放（以 CodeFoldRegion 实体承载，消除平行列表）。
    // 文本一变（BumpTextVersion）即全部展开：行号已漂移的区间
    // 不允许继续隐藏内容，宿主随后重新注入。
    List<CodeFoldRegion> foldRegions;

    // 右键上下文菜单状态。
    bool ctxOpen;
    int ctxX;
    int ctxY;
    string ctxCmd;          // 宿主 IDE 必须处理的命令（"find"/"gotoline"）
    // 宿主追加的右键菜单项（action 落在宿主段 >= 100）。
    List<ContextMenuItem> hostCtxItems;
    // 右键菜单的种类：0 = 文本区主菜单，1 = 行号槽的断点菜单
    // （VS 里点行号槽右键出的是断点菜单，不是编辑菜单）。
    int ctxMenuMode;
    // 断点菜单针对的行（右键命中的行号槽行，0 起）。
    int ctxBpLine;
    // 上一帧的行号槽宽度（宿主/测试按它算行号槽的命中区域）。
    int gutterWLast;
    // 宿主追加的断点菜单项（条件断点等 IDE 能力）。
    List<ContextMenuItem> hostBreakpointItems;

    // ---- 外观（字体 + 语法颜色），由宿主经 ApplyTheme 设置 ----
    // edFont 是代码字号；0 表示"使用 UI 主题的中等字号"。
    // 语法颜色为 ARGB；0 表示"回退到内置默认值"。
    int edFont;
    int synKw;
    int synTy;
    int synStr;
    int synCom;
    int synNum;
    int synText;

    // ---- 皮肤 CSS 的语法色（codeeditor::keyword 等部件）----
    // 每帧由 Render 解析一次；0 = 皮肤未声明该部件，按调色板回退。
    // 优先级：调色板 < 皮肤 CSS < 宿主 ApplyTheme——用户在设置里
    // 点名的配色预设，比环境皮肤更具体。
    int cssKw;
    int cssTy;
    int cssStr;
    int cssCom;
    int cssNum;

    // ---- 语法语言 ----
    // 0 = Zan、1 = Lua、2 = Python。决定关键字表、注释引导符
    // （// / -- / #）和块注释形式，使内嵌的 .lua/.py 脚本不会
    // 按 Zan 高亮，Ctrl+/ 也插入该语言的注释符。
    int syntaxLang;
    int textMemoStamp = 0 - 1;
    string textMemo = "";

    // 设置本缓冲区的语法语言（0=Zan、1=Lua、2=Python）。语言
    // 变化时丢弃按行高亮缓存，使已绘制的行按新语言重新分词。
    public void SetSyntaxLang(int lang) {
        int v = lang;
        if (v < 0 || v > 2) { v = 0; }
        if (v == syntaxLang) { return; }
        syntaxLang = v;
        hlCache = new List<CeHlLine>();
        RequestAnalysis();
    }

    // 当前语法语言（0=Zan、1=Lua、2=Python）。
    public int SyntaxLang() {
        return syntaxLang;
    }

    // 按文件名推断语法语言：.lua 为 Lua、.py/.pyw 为 Python，
    // 其余（含无扩展名）按 Zan 处理。
    public static int LangForName(string path) {
        int n = path.Length;
        int dot = -1;
        for (int i = n - 1; i >= 0; i = i - 1) {
            int b = path[i];
            if (b == 46) { dot = i; break; }
            if (b == 47 || b == 92) { break; }
        }
        if (dot < 0) { return 0; }
        string ext = CodeEditor.LowerAscii(path.Substring(dot, n - dot));
        if (ext == ".lua") { return 1; }
        if (ext == ".py" || ext == ".pyw") { return 2; }
        return 0;
    }

    // ASCII 小写化（扩展名比较用，不触碰多字节字节）。
    public static string LowerAscii(string s) {
        string lo = "abcdefghijklmnopqrstuvwxyz";
        string outs = "";
        for (int i = 0; i < s.Length; i = i + 1) {
            int b = s[i];
            if (b >= 65 && b <= 90) { outs = outs + lo.Substring(b - 65, 1); }
            else { outs = outs + s.Substring(i, 1); }
        }
        return outs;
    }

    // 本语言的行注释引导符（Ctrl+/ 插入的就是它）。
    public string LineComment() {
        if (syntaxLang == 1) { return "--"; }
        if (syntaxLang == 2) { return "#"; }
        return "//";
    }

    // 设置编辑器的代码字号和语法高亮颜色。任一参数为 0
    // 则该方面保持内置默认值。
    public void ApplyTheme(int fontPx, int kw, int ty, int str, int com, int num, int text) {
        edFont = fontPx;
        synKw = kw; synTy = ty; synStr = str; synCom = com; synNum = num; synText = text;
    }

    // 渲染所用的代码字号，未设置时遵循主题默认值。
    public int FontSize(Gui.Theme t) {
        if (edFont > 0) { return edFont; }
        return t.fontSizeMedium;
    }

    CodeEditor() {
        this.syntaxLang = 0;
        this.edFont = 0;
        this.synKw = 0; this.synTy = 0; this.synStr = 0; this.synCom = 0; this.synNum = 0; this.synText = 0;
        this.lines = new List<string>();
        this.lines.Add("");
        this.curLine = 0;
        this.curCol = 0;
        this.scrollLine = 0;
        this.scrollY = 0;
        this.targetScrollY = 0;
        this.maxScrollY = 0;
        this.ensuredCaretLine = -1;
        this.lastId = -1;
        this.visibleRows = new List<CeVisibleRowLayout>();
        this.lensRowH = 0;
        this.acItems = new List<string>();
        this.acAllCandidates = new List<CeCandidateItem>();
        this.acFilter = "";
        this.filtX = 0; this.filtY = 0; this.filtW = 0; this.filtH = 0;
        this.acFull = new List<string>();
        this.codeLens = new List<CodeLensRef>();
        this.refPopOpen = false;
        this.refPopName = "";
        this.refPopLines = new List<int>();
        this.refPopX = 0; this.refPopY = 0; this.refPopSel = 0;
        this.refPopGX = 0; this.refPopGY = 0; this.refPopGW = 0; this.refPopGH = 0;
        this.refPopRowH = 0; this.refPopHeadH = 0; this.refPopShown = 0;
        this.gotoRequested = false;
        this.acSel = 0;
        this.acActive = false;
        this.acStart = 0;
        this.acDot = false;
        this.acKinds = new List<string>();
        this.popX = 0; this.popY = 0; this.popW = 0; this.popH = 0;
        this.popItemH = 0; this.popFirst = 0; this.popShown = 0;
        this.sigOverloads = null;
        this.sigOverloadIndex = 0;
        this.sigOverloadCallee = "";
        this.sigOverloadStamp = -1;
        this.sigOverloadPath = "";
        this.sigPinnedCallee = "";
        this.sigPrevX = 0; this.sigPrevY = 0; this.sigPrevW = 0; this.sigPrevH = 0;
        this.sigNextX = 0; this.sigNextY = 0; this.sigNextW = 0; this.sigNextH = 0;
        this.selActive = false;
        this.selAnchorLine = 0;
        this.selAnchorCol = 0;
        this.mouseSelecting = false;
        this.barDragging = false;
        this.lastClickMs = 0 - 100000;
        this.lastClickLine = -1;
        this.lastClickCol = -1;
        this.clickCount = 0;
        this.pageRows = 20;
        this.textVersion = 1;
        this.lastScrollMs = 0;
        this.wheelAccum = 0;
        this.carets = new List<Caret>();
        this.bpALine = 0 - 1;
        this.bpACol = 0 - 1;
        this.bpMLine = 0 - 1;
        this.bpMCol = 0 - 1;
        this.bpMemoKey = null;
        this.clipboard = "";
        this.undoStack = new List<EditSnapshot>();
        this.redoStack = new List<EditSnapshot>();
        this.undoEditKind = 0;
        this.undoEditLine = 0 - 1;
        this.undoEditCol = 0 - 1;
        this.errors = new List<Diagnostic>();
        this.lastDiagLine = -1;
        this.compErrors = new List<Diagnostic>();
        this.cErrStamp = -1;
        this.diagStaleFrame = -1;
        this.muTypes = null;
        this.btLineSrc = null;
        this.cbCandidates = null;
        this.cbGen = -1;
        this.candBaseGen = 0;
        this.ceLineCaches = null;
        this.projTypes = new List<ProjType>();
        this.projFileSrc = new List<string>();
        this.projScanDirty = false;
        this.extRefCounts = new List<CeExtRefCount>();
        this.extRefDirty = false;
        this.extRefAt = 0 - 1;
        this.extRefDecls = new List<CeExtRefDecl>();
        this.extRefFileIdx = null;
        this.extRefDeclAt = 0;
        this.extRefOwnerCur = "";
        this.extRefFamily = null;
        this.extRefRecvs = null;
        this.refIdx = null;
        this.refStamp = 0 - 1;
        this.sigMemoName = "";
        this.sigMemoText = "";
        this.sigMemoStamp = 0 - 1;
        this.lensMemos = new List<CeLensMemo>();
        this.lensStamp = 0 - 1;
        this.lensBudget = 0;
        this.lensPending = false;
        this.lensQuietMs = 0 - 100000;
        this.hlCache = new List<CeHlLine>();
        this.hlThemeSig = 0;
        this.fixes = new List<QuickFix>();
        this.muLineCaches = null;
        this.muCtx = "";
        this.muStamp = 0 - 1;
        this.bps = new List<int>();
        this.execLine = -1;
        this.dbgVars = new List<DbgVar>();
        this.hoverTip = null;
        this.hoverTipX = 0;
        this.hoverTipY = 0;
        this.lastHoverMoveMs = 0;
        this.lastHoverX = 0;
        this.lastHoverY = 0;
        this.ctxOpen = false;
        this.ctxX = 0;
        this.ctxY = 0;
        this.ctxCmd = "";
        this.hostCtxItems = new List<ContextMenuItem>();
        this.ctxMenuMode = 0;
        this.ctxBpLine = 0;
        this.hostBreakpointItems = new List<ContextMenuItem>();
    }

    // 按 '\n' 把字符串拆分为行（去除 '\r'）。实现移至
    // TextWrap.SplitLines：输入框/多行框只需文本布局原语，
    // 不必拖入整个代码编辑器；此处保留委托以稳住内部调用点。
    public static List<string> SplitLines(string s) {
        return Gui.TextWrap.SplitLines(s);
    }

    // 整体替换缓冲区：保证至少一行，光标与滚动复位到开头，
    // 并强制下一帧重新计算诊断。
    public void SetLines(List<string> ls) {
        lines = ls;
        if (lines.Count == 0) { lines.Add(""); }
        curLine = 0;
        curCol = 0;
        scrollLine = 0;
        scrollY = 0;
        targetScrollY = 0;
        ensuredCaretLine = -1;
        lastDiagLine = -1;  // 强制对新内容重新计算诊断
        acActive = false;
        acDot = false;
        BumpTextVersion();
    }

    // 标记文本已被修改，递增单调版本号。
    // 编辑会让折叠区间的行号漂移，因此顺带全部展开，
    // 由宿主在语义刷新后重新注入区间。
    public void BumpTextVersion() {
        CancelSemanticCompletion();
        textVersion = textVersion + 1;
        hoverLspMemo = null;
        signatureLspMemo = null;
        sigDocLspMemo = null;
        InvalidateDiagStale();
        RequestAnalysis();
        if (foldRegions != null) {
            for (int i = 0; i < foldRegions.Count; i = i + 1) {
                foldRegions[i].folded = false;
            }
        }
    }

    // 载入整段文本（SetLines 的字符串版），同时清空 CodeLens、
    // 签名备忘等派生自旧内容的缓存。
    public void LoadText(string s) {
        SetLines(CodeEditor.SplitLines(s));
        extRefDirty = true;
        // 其他文件的成员不属于本文件。
        sigMemoName = "";
        lensMemos = new List<CeLensMemo>();
        lensStamp = 0 - 1;
    }

    // 全部文本（行以 '\n' 连接）。
    public string GetText() {
        textMemo = string.Join("\n", lines);
        textMemoStamp = TextStamp();
        return textMemo;
    }

    // O(1) 内容版本号：文本实际变更时才递增，
    // 彻底消除每帧遍历全文件所有行统计长度的巨大卡顿。
    public int TextStamp() {
        return textVersion;
    }

    // 编辑器列是 UTF-8 字节偏移，LSP 列是 UTF-16 码元数。
    public static int ByteColumnToUtf16(string text, int byteCol) {
        int pos = 0;
        int units = 0;
        while (pos < text.Length && pos < byteCol) {
            int next = Text.NextCharEnd(text, pos);
            if (next > byteCol) { break; }
            units = units + (next - pos == 4 ? 2 : 1);
            pos = next;
        }
        return units;
    }

    public static int Utf16ColumnToByte(string text, int column) {
        int pos = 0;
        int units = 0;
        while (pos < text.Length && units < column) {
            int next = Text.NextCharEnd(text, pos);
            int width = next - pos == 4 ? 2 : 1;
            if (units + width > column) { break; }
            units = units + width;
            pos = next;
        }
        return pos;
    }

    // 缓冲区行数。
    public int LineCount() {
        return lines.Count;
    }

    // 当前光标行（0 起）。
    public int CurLine() { return curLine; }
    // 当前光标列（0 起）。
    public int CurCol() { return curCol; }

    // 第 `i` 行的文本（越界返回 ""）。使宿主（查找栏）
    // 无需每次击键实例化整个文档即可遍历缓冲区。
    public string LineAt(int i) {
        if (i < 0 || i >= lines.Count) { return ""; }
        return lines[i];
    }

    // 本编辑器上一帧渲染所用的焦点 id，宿主可在
    // 自己的覆盖层关闭时把键盘交还给它。
    public int LastWidgetId() { return lastId; }

    // 选区激活且包含有效文本范围时返回 true。
    public bool HasSelection() { return selActive && (selAnchorLine != curLine || selAnchorCol != curCol); }

    // 首个可见行。拥有多个缓冲区的宿主把它与
    // 光标一起保存，以恢复缓冲区离开时的状态。
    public int ScrollLine() { return scrollLine; }
    // 设置首个可见行（钳制到 [0, 行数-1]）。
    public void SetScrollLine(int line) {
        if (line < 0) { line = 0; }
        if (line >= lines.Count) { line = lines.Count - 1; }
        if (line < 0) { line = 0; }
        scrollLine = line;
        scrollY = 0 - 1; // 标记由下一次 Render 转换为精确像素
        targetScrollY = 0 - 1;
    }

    // 当前视口垂直像素滚动偏移。
    public int ScrollY() { return scrollY; }
    // 设置垂直像素滚动偏移。
    public void SetScrollY(int y) {
        if (y < 0) { y = 0; }
        if (maxScrollY > 0 && y > maxScrollY) { y = maxScrollY; }
        scrollY = y;
        targetScrollY = y;
    }

    // ---- 自动化 / 自省访问器（供 Gui.UiDriver 使用） ----
    // 自动补全弹窗的只读视图，使 AI 驱动可断言
    // 补全候选和选区，而无需屏幕抓取弹窗。
    // 补全弹窗显示期间返回 true。
    public bool CompletionActive() { return acActive; }
    // 可见补全候选的数量。
    public int CompletionCount() { return acItems.Count; }
    // 高亮候选的索引（从 0 起）。
    public int CompletionSel() { return acSel; }
    // 索引 i 处的候选标签（越界返回 ""）。
    public string CompletionItem(int i) {
        if (i < 0 || i >= acItems.Count) { return ""; }
        return acItems[i];
    }
    // 索引 i 处的候选种类标签：M/P/T/K/S/F（越界返回 ""）。
    public string CompletionKind(int i) {
        if (i < 0 || i >= acKinds.Count) { return ""; }
        return acKinds[i];
    }

    // 返回光标下的标识符（无则为空字符串）。
    public string WordAtCaret() {
        if (curLine < 0 || curLine >= lines.Count) { return ""; }
        string s = lines[curLine];
        int col = curCol;
        if (col >= s.Length) { col = s.Length - 1; }
        if (col < 0) { return ""; }
        return CodeEditor.WordAt(s, col);
    }

    // Ctrl+点击请求转到定义后返回一次 true，
    // 并清除标志，使宿主恰好处理一次。
    public bool ConsumeGotoRequest() {
        if (gotoRequested) { gotoRequested = false; return true; }
        return false;
    }

    // 替换调试变量面板的内容（宿主自己的数据，编辑器只负责显示）。
    public void SetDebugVars(List<DbgVar> vars) { dbgVars = vars; }

    // 跳到某行行首（钳制行号、清除选区）。
    public void GoToLine(int line) {
        CancelSemanticCompletion();
        if (line < 0) { line = 0; }
        if (line >= lines.Count) { line = lines.Count - 1; }
        curLine = line;
        curCol = 0;
        selActive = false;
    }

    // 同步查询缓冲区总大小；诊断失效使用 O(1) 的 TextStamp。
    public int BufLen() {
        int n = 0;
        for (int i = 0; i < lines.Count; i = i + 1) { n = n + lines[i].Length + 1; }
        return n;
    }

    // 用上次 Run/Build 针对本文件报告的真实错误
    // 替换红色下划线 + 提示显示的编译器诊断，并
    // 把光标跳到第一个错误，使其原因立即可见。
    // 当编译成功（diagnostics 为空）时，清空快速修复建议，并与编译器结果同步。
    public void SetCompilerDiagnostics(List<Diagnostic> diagnostics) {
        compErrors = diagnostics;
        cErrStamp = TextStamp();
        diagStaleFrame = 0 - 1;
        if (compErrors.Count > 0) {
            GoToLine(compErrors[0].line);
        } else {
            fixes = new List<QuickFix>();
        }
    }

    // 设置某个文档的语义诊断（语言服务推送）。诊断带精确区间，
    // 渲染时在出错的那几个字符下面画波浪线（VS 的做法）。
    // 空诊断表示"这份文档现在没有错误"，直接清掉该路径的记录。
    public void SetSemanticDiagnostics(string path, List<Diagnostic> diagnostics) {
        if (path.Length == 0) { return; }
        if (semDiags == null) { semDiags = new Dict<string, List<Diagnostic>>(); }
        if (diagnostics == null || diagnostics.Count == 0) {
            if (semDiags.ContainsKey(path)) { semDiags.Remove(path); }
            return;
        }
        semDiags[path] = diagnostics;
    }

    // 当前文档在指定行上的语义诊断条数（不做逐帧分配：渲染每个
    // 可见行都要问一次，分配列表会拖慢每帧）。
    public int SemanticDiagCount(int line) {
        if (semDiags == null || documentPath.Length == 0) { return 0; }
        if (!semDiags.ContainsKey(documentPath)) { return 0; }
        List<Diagnostic> all = semDiags[documentPath];
        int n = 0;
        for (int i = 0; i < all.Count; i = i + 1) {
            if (all[i].line == line) { n = n + 1; }
        }
        return n;
    }

    // 该行第 `idx` 条语义诊断（越界返回 null）。
    public Diagnostic SemanticDiagAt(int line, int idx) {
        if (semDiags == null || documentPath.Length == 0) { return null; }
        if (!semDiags.ContainsKey(documentPath)) { return null; }
        List<Diagnostic> all = semDiags[documentPath];
        int n = 0;
        for (int i = 0; i < all.Count; i = i + 1) {
            if (all[i].line != line) { continue; }
            if (n == idx) { return all[i]; }
            n = n + 1;
        }
        return null;
    }

    // 设置编译器诊断后缓冲区一旦变化即返回 true，
    // 用户一开始编辑，过期错误即停止绘制。
    public bool CompilerDiagStale() {
        if (diagStaleFrame == 0) { return false; }
        if (diagStaleFrame == 1) { return true; }
        bool stale = cErrStamp < 0 || TextStamp() != cErrStamp;
        diagStaleFrame = 0;
        if (stale) { diagStaleFrame = 1; }
        return stale;
    }

    // 丢弃每帧的过期记忆；渲染流程在本帧
    // 缓冲区不再变化后调用一次。
    public void InvalidateDiagStale() { diagStaleFrame = 0 - 1; }

    // 某行的编译器诊断消息，无或已过期返回 ""。
    public string CompilerErrMsg(int ln) {
        if (CompilerDiagStale()) { return ""; }
        return CodeEditor.DiagMsg(compErrors, ln);
    }

    // 第 `ln` 行当前携带有效编译器诊断时返回 true。
    public bool HasCompilerErr(int ln) {
        if (CompilerDiagStale()) { return false; }
        return CodeEditor.DiagHas(compErrors, ln);
    }

    // 跳到指定行列（列超界时钳到行尾）。
    public void GoToLineCol(int line, int col) {
        GoToLine(line);
        curCol = col;
        ClampCol();
    }


}
