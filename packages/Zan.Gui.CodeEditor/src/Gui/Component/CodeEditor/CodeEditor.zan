    public CodeSignatureListProvider externalSignatureList;
    // 外部活动参数文档提供者（如 LSP）：签名条第二区显示正在输入的参数说明
    public CodeSignatureDocProvider externalSignatureDoc;
    // 外部悬停文档/签名提示提供者（如 LSP）
    public CodeHoverProvider externalHover;

    // ---- 本帧的行布局 ----
