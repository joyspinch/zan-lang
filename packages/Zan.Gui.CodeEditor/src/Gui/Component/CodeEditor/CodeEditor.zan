using System;
using System.Collections.Generic;
using System.Globalization;
using Gui;
using Gui.Widget;
using Gui.Backend;
using Gui.Component;

namespace Gui.Component.CodeEditor;

public delegate List<CodeCompletionItem> CodeCompletionProvider(string path, int line0, int col0);
public delegate string CodeSignatureProvider(string path, int line0, int col0, string callee);
// 一个重载签名：标签（完整签名文本）+ 文档（该重载的说明）。
public class CodeSignatureItem {
    public string label = "";
    public string doc = "";
    public CodeSignatureItem(string label, string doc) {
        this.label = label;
        this.doc = doc;
    }
}
// 全部重载签名（VS 的参数信息重载列表）：签名条据此显示「◀ 2/3 ▶」
// 并允许逐条切换。返回空列表表示该调用没有重载。
public delegate List<CodeSignatureItem> CodeSignatureListProvider(string path, int line0, int col0, string callee);
// 活动参数的文档（签名提示浮层的第二区）；返回 "" 表示没有。
public delegate string CodeSignatureDocProvider(string path, int line0, int col0, string callee);
public delegate string CodeHoverProvider(string path, int line0, int col0, string word);

public partial class CodeEditor {
