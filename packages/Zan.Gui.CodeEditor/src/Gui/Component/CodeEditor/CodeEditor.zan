    bool refPopOpen;
    string refPopName;
    List<int> refPopLines;
    int refPopX;
    int refPopY;
    int refPopSel;
    // 上次渲染后的最终钳制弹窗几何，用于命中测试。
    int refPopGX;
    int refPopGY;
    int refPopGW;
    int refPopGH;
    int refPopRowH;
    int refPopHeadH;
