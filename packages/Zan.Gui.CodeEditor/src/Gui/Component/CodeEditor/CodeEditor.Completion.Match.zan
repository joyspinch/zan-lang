using System;
using Gui;

namespace Gui.Component.CodeEditor;

partial class CodeEditor {
    // `cand` 对输入 `pfx` 的相关度，不匹配时为 -1。
    // 越高越好。排序遵循 VS 风格补全的隐含顺序：
    // 大小写精确前缀 > 不区分大小写前缀 >
    // 驼峰首字母缩写（`rdal` -> `ReadAllLines`）> 普通
    // 子序列（`rdll` -> `ReadAllLines`）；并列时更短者胜出，
    // 因此前缀 `add` 时 `Add` 排在 `AddRange` 之前。
    public static int MatchScore(string cand, string pfx) {
        if (pfx.Length == 0) { return 1; }
        if (cand.Length < pfx.Length) { return 0 - 1; }
        int bonus = 0 - cand.Length;
        if (cand.StartsWith(pfx)) { return 4000 + bonus; }
        if (CodeEditor.StartsWithI(cand, pfx)) { return 3000 + bonus; }
        if (CodeEditor.HumpMatch(cand, pfx)) { return 2000 + bonus; }
        if (CodeEditor.SubseqMatchI(cand, pfx)) { return 1000 + bonus; }
        return 0 - 1;
    }

    // 候选分层的种类权重（VS 口径）。MatchScore 的量纲是 1000（子序列
    // 匹配）到 4000（精确前缀），这里给每一层留出足够宽的带宽，使层内
    // 匹配质量的差异不会跨层翻转顺序：
    //   局部变量/参数 > 属性 > 字段 > 方法 > 枚举 > 类型 > 关键字 > 代码片段。
    // 从周边文本扫来的裸词（"W"）落到最底——它只是"刚写过的名字"，
    // 不是作用域里的符号，不该压过工程自己的成员。
    // 此前所有候选共用一个分数，排序退化成"收集顺序说了算"，
    // 结果是片段与关键字永远排在工程符号前面，还把项目符号挤出
    // 弹窗的前 80 条。
    public static int KindWeight(string kind) {
        if (kind == "V") { return 6000; }
        if (kind == "P") { return 5000; }
        if (kind == "F") { return 4800; }
        if (kind == "M") { return 4600; }
        if (kind == "E") { return 4400; }
        if (kind == "T") { return 4200; }
        if (kind == "K") { return 4000; }
        if (kind == "S") { return 3800; }
        if (kind == "W") { return 0; }
        return 3000;
    }

    // 种类的整数序号。与 KindWeight 的分层一一对应，排序时按序号
    // 比较种类（字符串比较在几千项的候选上慢一个量级）。
    public static int KindIndex(string kind) {
        if (kind == "V") { return 0; }
        if (kind == "M") { return 1; }
        if (kind == "P") { return 2; }
        if (kind == "F") { return 3; }
        if (kind == "E") { return 4; }
        if (kind == "T") { return 5; }
        if (kind == "K") { return 6; }
        if (kind == "S") { return 7; }
        if (kind == "W") { return 8; }
        return 9;
    }

    // `pfx` 拼出 `cand` 的大写字母（加首字符）时返回 true：
    // `rdal` 和 `RAL` 都能匹配 `ReadAllLines`。
    public static bool HumpMatch(string cand, string pfx) {
        int pi = 0;
        int n = cand.Length;
        for (int i = 0; i < n; i = i + 1) {
            int ch = cand[i];
            bool hump = (i == 0 || (ch >= 65 && ch <= 90)) && ch != 95;
            if (hump) {
                if (CodeEditor.LowerByte(ch) != CodeEditor.LowerByte(pfx[pi])) {
                    return false;
                }
                pi = pi + 1;
                if (pi >= pfx.Length) { return true; }
            }
        }
        return false;
    }

    // `pfx` 的每个字符按顺序出现在 `cand` 中时返回 true，
    // 忽略大小写。
    public static bool SubseqMatchI(string cand, string pfx) {
        int pi = 0;
        for (int ci = 0; pi < pfx.Length && ci < cand.Length; ci = ci + 1) {
            if (CodeEditor.LowerByte(cand[ci]) == CodeEditor.LowerByte(pfx[pi])) {
                pi = pi + 1;
            }
        }
        return pi >= pfx.Length;
    }

    // 两个单字符字符串的不区分大小写比较。
    public static bool EqI(string a, string b) {
        return CodeEditor.StartsWithI(a, b) && a.Length == b.Length;
    }

    // 按相关度降序原地排序候选实体列表。
    public static void SortCandidatesByScore(List<CeCandidateItem> items, List<int> scores) {
        int i = 1;
        while (i < items.Count) {
            CeCandidateItem it = items[i];
            int sc = scores[i];
            int j = i - 1;
            while (j >= 0 && scores[j] < sc) {
                items[j + 1] = items[j];
                scores[j + 1] = scores[j];
                j = j - 1;
            }
            items[j + 1] = it;
            scores[j + 1] = sc;
            i = i + 1;
        }
    }

    // 按相关度降序保留最好的 `limit` 个候选实体。弹窗只显示前几十个，而
    // 一次击键的候选可能上千：对全部候选做插入排序是平方级的，这里
    // 只维护一个长度有界的有序前缀，代价降到 候选数×limit。
    // 与 SortCandidatesByScore 一样是稳定的（同分保持收集顺序）。
    public static void SortCandidatesByScoreTop(List<CeCandidateItem> items,
                                        List<int> scores, int limit) {
        List<CeCandidateItem> ti = new List<CeCandidateItem>();
        List<int> ts = new List<int>();
        int count = items.Count < scores.Count ? items.Count : scores.Count;
        for (int i = 0; i < count; i = i + 1) {
            int sc = scores[i];
            if (ts.Count >= limit && sc <= ts[ts.Count - 1]) { continue; }
            int insertPos = ts.Count;
            while (insertPos > 0 && ts[insertPos - 1] < sc) {
                insertPos = insertPos - 1;
            }
            ti.Insert(insertPos, items[i]);
            ts.Insert(insertPos, sc);
            if (ts.Count > limit) {
                ti.RemoveAt(ti.Count - 1);
                ts.RemoveAt(ts.Count - 1);
            }
        }
        items.Clear();
        scores.Clear();
        for (int k = 0; k < ti.Count; k = k + 1) {
            items.Add(ti[k]);
            scores.Add(ts[k]);
        }
    }

    // 带种类配额的有界插入排序：每个种类最多 `quota` 个名额，
    // 超出名额的项只有比该种类里最差的一项更好时才顶替它。
    // 浏览模式（Ctrl+Space，没有前缀）下工程里的成员可能有上千个，
    // 不分配额的话类型与代码片段会被整个挤出列表——列表里只剩
    // 成员，一个类型名都找不到。VS 的列表是各类型混排的。
    // 输入前缀时不用这个：那时用户要的就是匹配度最高的那一批。
    public static void SortCandidatesByScoreTopKinds(List<CeCandidateItem> items,
                                        List<int> scores, int limit, int quota) {
        int count = items.Count < scores.Count ? items.Count : scores.Count;
        List<CeCandidateItem> wi = new List<CeCandidateItem>();
        List<int> ws = new List<int>();
        for (int i = 0; i < count; i = i + 1) {
            int kind = items[i].kindIdx;
            int sc = scores[i];
            int kindCount = 0;
            int worst = 0 - 1;
            int worstScore = 0;
            for (int j = 0; j < wi.Count; j = j + 1) {
                if (wi[j].kindIdx != kind) { continue; }
                kindCount = kindCount + 1;
                if (worst < 0 || ws[j] < worstScore) { worst = j; worstScore = ws[j]; }
            }
            if (quota > 0 && kindCount >= quota) {
                if (worst < 0 || sc <= worstScore) { continue; }
                wi.RemoveAt(worst);
                ws.RemoveAt(worst);
            }
            // 插入位置：分数降序，同分保持收集顺序。
            int pos = wi.Count;
            while (pos > 0 && ws[pos - 1] < sc) { pos = pos - 1; }
            wi.Insert(pos, items[i]);
            ws.Insert(pos, sc);
            if (wi.Count > limit) {
                wi.RemoveAt(wi.Count - 1);
                ws.RemoveAt(wi.Count - 1);
            }
        }
        items.Clear();
        scores.Clear();
        for (int k = 0; k < wi.Count; k = k + 1) {
            items.Add(wi[k]);
            scores.Add(ws[k]);
        }
    }

    // 显式打开补全（Ctrl+Space），列出作用域内所有内容，
}
