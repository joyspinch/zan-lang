using System;
using Gui;
using Gui.Backend;

namespace Gui.Component.CodeEditor;

// CodeEditor 分部：IntelliSense 描述与片段展开，以及
// 断点管理。
public partial class CodeEditor {
    // ---- IntelliSense 描述与片段 ----

    // 子串 `sub` 在 `s` 中首次出现的索引，无则 -1。
    public static int Find(string s, string sub) {
        if (s == null || sub == null) { return 0 - 1; }
        return s.IndexOf(sub);
    }

    // 补全种类标签的人类可读名称。
    public static string KindWord(string kind) {
        if (kind == "M") { return "method"; }
        if (kind == "P") { return "property"; }
        if (kind == "T") { return "type"; }
        if (kind == "K") { return "keyword"; }
        if (kind == "S") { return "code snippet"; }
        if (kind == "F") { return "field"; }
        if (kind == "E") { return "event"; }
        return "symbol";
    }

    // 给定去除首尾空白的方法声明行，返回整洁的单行
    // 签名 "ReturnType Name(params)"（去修饰符、去函数体），
    // 该行不是方法声明则返回 ""。
    public static string SigFromLine(string trimmed) {
        string s = CodeEditor.StripModifiers(trimmed);
        int paren = CodeEditor.Find(s, "(");
        if (paren <= 0) { return ""; }
        // 拒绝伪装成方法的 "if (" / "while (" 等控制关键字。
        int e = paren;
        while (e > 0 && CodeEditor.IsIdentByte(s[e - 1] & 255)) { e = e - 1; }
        string mname = s.Substring(e, paren - e);
        if (mname.Length == 0 || e == 0) { return ""; }
        if (CodeEditor.IsControlWord(mname)) { return ""; }
        // `app.MaxBody(x);` 是调用而非 MaxBody 的声明：没有
        // 此检查时，悬停提示只会复读指针下的那行。
        if (!CodeEditor.DeclHeadOk(s.Substring(0, e))) { return ""; }
        // 在本行一直取到匹配的右括号；没有则到行尾。
        int depth = 0;
        int i = paren;
        int close = -1;
        while (i < s.Length) {
            int c = s[i] & 255;
            if (c == 40) { depth = depth + 1; }
            else if (c == 41) { depth = depth - 1; if (depth == 0) { close = i; break; } }
            i = i + 1;
        }
        string sig = "";
        if (close >= 0) { sig = s.Substring(0, close + 1); }
        else { sig = CodeEditor.TrimStr(s) + ")"; }
        return CodeEditor.TrimStr(sig);
    }

    // 在给定源码行中查找名为 `name` 的方法并返回其
    // 真实解析签名，无则 ""。
    public static string SigInSource(string src, string name) {
        List<string> ls = CodeEditor.SplitLines(src);
        for (int i = 0; i < ls.Count; i = i + 1) {
            string tr = CodeEditor.TrimStr(ls[i]);
            if (CodeEditor.MemberDeclName(tr) == name) {
                string sig = CodeEditor.SigFromLine(tr);
                if (sig.Length > 0) { return sig; }
            }
        }
        return "";
    }

    // 名为 `name` 的用户/项目方法的真实签名，先
    // 从当前缓冲区解析，再查其他项目文件。找不到返回 ""
    // —— 调用方可回退到精编的 stdlib 签名。
    string RealSigFor(string name) {
        if (analysisApp != null) {
            RequestAnalysis();
            if (AnalysisSnapshotCurrent(analysisApplied) && analysisSignatures != null
                && analysisSignatures.ContainsKey(name)) { return analysisSignatures[name]; }
            return "";
        }
        for (int i = 0; i < lines.Count; i = i + 1) {
            string tr = CodeEditor.TrimStr(lines[i]);
            if (CodeEditor.MemberDeclName(tr) == name) {
                string sig = CodeEditor.SigFromLine(tr);
                if (sig.Length > 0) { return sig; }
            }
        }
        for (int i = 0; i < projFileSrc.Count; i = i + 1) {
            string s = CodeEditor.SigInSource(projFileSrc[i], name);
            if (s.Length > 0) { return s; }
        }
        return "";
    }

    string LspHoverFor(string name, int line, int col) {
        if (externalHover == null || documentPath.Length == 0) { return ""; }
        string path = documentPath;
        int stamp = TextStamp();
        int caretLine = curLine;
        int caretCol = curCol;
        if (hoverLspMemo != null && hoverLspMemo.Matches(path, stamp, line, col, name)) {
            return hoverLspMemo.text;
        }
        string text = externalHover(path, line, col, name);
        if (documentPath != path || TextStamp() != stamp
            || curLine != caretLine || curCol != caretCol) { return ""; }
        CeSemanticTextMemo memo = new CeSemanticTextMemo();
        memo.path = path; memo.version = stamp;
        memo.line = line; memo.col = col; memo.name = name; memo.text = text;
        hoverLspMemo = memo;
        return text;
    }

    // 鼠标悬停时的符号签名查询：优先查内置标准库与项目源码声明，
    // 绝不触发光标位置的 LSP 同步调用，避免光标与鼠标分离时的错误请求与主线程卡顿。
    string SigHelpForHover(string name) {
        int stamp = TextStamp();
        if (sigMemoName == name && sigMemoStamp == stamp) { return sigMemoText; }
        string sig = CodeEditor.DescSig(name);
        if (sig.Length == 0) { sig = RealSigFor(name); }
        sigMemoName = name;
        sigMemoStamp = stamp;
        sigMemoText = sig;
        return sig;
    }

    // `name` 用于参数提示的签名，按被调用者记忆化。
    // // 解析会遍历本缓冲区和所有项目源码，因此
    // 每个被调用者只解析一次而非每次击键：输入实参不会
    // 改变提示所描述的声明。缓冲区被替换（见 LoadText）
    // 或行数变化时丢弃记忆，
    // 这对签名而言已足够精细。
    // 文本版本变更也使本地缓存失效，防止同一行声明修改后仍显示旧签名。
    // 语义提供者还依赖光标位置，独立缓存避免复用旧实参上下文。
    string SigHelpFor(string name) {
        int stamp = TextStamp();
        string bareName = name;
        int dot = name.LastIndexOf(".");
        if (dot >= 0 && dot + 1 < name.Length) {
            bareName = name.Substring(dot + 1, name.Length - (dot + 1));
        }

        if (externalSignature != null && documentPath.Length > 0) {
            string path = documentPath;
            int line = curLine;
            int col = curCol;
            string lspSig = "";
            if (signatureLspMemo != null && signatureLspMemo.Matches(path, stamp, line, col, name)) {
                lspSig = signatureLspMemo.text;
            } else {
                lspSig = externalSignature(path, line, col, name);
                // 若限定名未查到，尝试查询裸方法名（但如果限定名包含状态栏等有特殊签名的组件，绝不回退到可能冲突的通用裸名）
                if (lspSig.Length == 0 && bareName != name && !name.Contains("StatusBar") && !name.Contains("Status")) {
                    lspSig = externalSignature(path, line, col, bareName);
                }
                // 提供者可能泵事件，旧调用的结果不能污染新文档的缓存。
                if (documentPath != path || TextStamp() != stamp
                    || curLine != line || curCol != col) { return ""; }
                CeSemanticTextMemo memo = new CeSemanticTextMemo();
                memo.path = path; memo.version = stamp;
                memo.line = line; memo.col = col; memo.name = name; memo.text = lspSig;
                signatureLspMemo = memo;
            }
            if (lspSig.Length > 0) { return lspSig; }
        }
        if (sigMemoName == name && sigMemoStamp == stamp) { return sigMemoText; }
        string sig = RealSigFor(name);
        if (sig.Length == 0 && bareName != name) { sig = RealSigFor(bareName); }
        if (sig.Length == 0) { sig = CodeEditor.DescSig(name); }
        if (sig.Length == 0 && bareName != name) { sig = CodeEditor.DescSig(bareName); }
        sigMemoName = name;
        sigMemoStamp = stamp;
        sigMemoText = sig;
        return sig;
    }

    // `name` 处调用的活动参数文档（签名条第二区）。
    // 提供者像 externalSignature 一样被记忆化：同一被调用者
    // 与光标处只问一次，输入实参不改变文档所指的参数槽。
    string SigDocFor(string name) {
        if (externalSignatureDoc == null || documentPath.Length == 0) { return ""; }
        string path = documentPath;
        int stamp = TextStamp();
        int line = curLine;
        int col = curCol;
        if (sigDocLspMemo != null && sigDocLspMemo.Matches(path, stamp, line, col, name)) {
            return sigDocLspMemo.text;
        }
        string text = externalSignatureDoc(path, line, col, name);
        if (documentPath != path || TextStamp() != stamp
            || curLine != line || curCol != col) { return ""; }
        CeSemanticTextMemo memo = new CeSemanticTextMemo();
        memo.path = path; memo.version = stamp;
        memo.line = line; memo.col = col; memo.name = name; memo.text = text;
        sigDocLspMemo = memo;
        return text;
    }

    // `name` 处调用的全部重载签名（VS 参数信息里的「1/3」）。
    // 提供者按 (文档, 文本版本, 被调用者) 记忆化：重载列表与光标位置
    // 无关，移动光标不必重新问提供者。
    List<CodeSignatureItem> SigOverloadsFor(string name) {
        if (externalSignatureList == null || documentPath.Length == 0) { return null; }
        int stamp = TextStamp();
        if (sigOverloads != null && sigOverloadCallee == name
                && sigOverloadStamp == stamp && sigOverloadPath == documentPath) {
            return sigOverloads;
        }
        string path = documentPath;
        int line = curLine;
        int col = curCol;
        List<CodeSignatureItem> list = externalSignatureList(path, line, col, name);
        // 提供者可能泵事件，旧调用的结果不能污染新文档的缓存。
        if (documentPath != path || TextStamp() != stamp) { return null; }
        sigOverloads = list;
        sigOverloadCallee = name;
        sigOverloadStamp = stamp;
        sigOverloadPath = path;
        return list;
    }

    // 活动重载下标。默认取"第一个参数个数够当前实参"的那个（与 LSP 的
    // activeSignature 同口径）；用户手动切过就保持手动选择，直到换一次
    // 调用（VS：参数信息里的重载选择在整个调用期间保持）。
    int SigOverloadIndex(int argIdx) {
        if (sigOverloads == null || sigOverloads.Count == 0) { return 0; }
        if (sigPinnedCallee.Length > 0 && sigPinnedCallee == sigOverloadCallee) {
            if (sigOverloadIndex < 0 || sigOverloadIndex >= sigOverloads.Count) {
                sigOverloadIndex = 0;
            }
            return sigOverloadIndex;
        }
        sigOverloadIndex = CodeEditor.AutoOverload(sigOverloads, argIdx);
        return sigOverloadIndex;
    }

    // 第一个参数个数大于 `argIdx` 的重载；都没有就取第一个。
    static int AutoOverload(List<CodeSignatureItem> list, int argIdx) {
        if (list == null) { return 0; }
        for (int i = 0; i < list.Count; i = i + 1) {
            if (CodeEditor.ParamCount(list[i].label) > argIdx) { return i; }
        }
        return 0;
    }

    // 切换重载（delta = -1 上一条 / +1 下一条，循环）。没有重载可切时
    // 返回 false。
    bool SigSwitchOverload(int delta) {
        if (sigOverloads == null || sigOverloads.Count <= 1) { return false; }
        int n = sigOverloads.Count;
        int idx = sigOverloadIndex + delta;
        while (idx < 0) { idx = idx + n; }
        while (idx >= n) { idx = idx - n; }
        sigOverloadIndex = idx;
        sigPinnedCallee = sigOverloadCallee;
        return true;
    }

    // 当前显示的重载下标（宿主用它取同一重载的参数文档）。
    public int SigCurrentOverloadIndex() { return sigOverloadIndex; }

    // 签名 `sig` 的参数个数（顶层逗号分隔；嵌套泛型/lambda 不计）。
    public static int ParamCount(string sig) {
        int open = CodeEditor.Find(sig, "(");
        if (open < 0) { return 0; }
        int depth = 0;
        int count = 0;
        bool any = false;
        int i = open;
        while (i < sig.Length) {
            int c = sig[i] & 255;
            if (c == 40 || c == 60 || c == 91) { depth = depth + 1; }
            else if (c == 41 || c == 62 || c == 93) {
                depth = depth - 1;
                if (depth == 0) { break; }
            } else if (c == 44 && depth == 1) {
                count = count + 1;
            } else if (depth == 1 && c != 32) { any = true; }
            i = i + 1;
        }
        if (!any) { return 0; }
        return count + 1;
    }

    // 光标在其所在行内所处的调用：被调用者名称，
    // 光标不在 `(` 与其 `)` 之间时返回 ""。`outArg` 接收
    // 正在输入的实参的从零开始索引。
    // // 仅一行，从光标处从右到左扫描 —— 足以覆盖
    // 绝大多数调用，且每帧工作量有界。字符串和
    // 字符字面量会被跳过，实参中的 `"("` 不会开启调用。
    string CallAtCaret(List<int> outArg) {
        if (curLine < 0 || curLine >= lines.Count) { return ""; }
        string ln = lines[curLine];
        int end = curCol;
        if (end > ln.Length) { end = ln.Length; }
        // 行中哪些区间位于字面量内：先正向扫描一次，
        // 因为引号配对只能从左到右判定。
        List<int> lit = new List<int>();
        bool inStr = false;
        string q = "";
        for (int i = 0; i < end; i = i + 1) {
            string ch = ln.Substring(i, 1);
            if (inStr) {
                lit.Add(1);
                if (ch == "\\") {
                    i = i + 1;
                    if (i < end) { lit.Add(1); }
                } else if (ch == q) { inStr = false; }
            } else if (ch == "\"" || ch == "'") {
                inStr = true; q = ch; lit.Add(1);
            } else {
                lit.Add(0);
            }
        }
        while (lit.Count < end) { lit.Add(0); }
        int depth = 0;
        int args = 0;
        int at = end - 1;
        while (at >= 0) {
            if (at < lit.Count && lit[at] == 1) { at = at - 1; continue; }
            int c = ln[at] & 255;
            if (c == 41) { depth = depth + 1; }
            else if (c == 40) {
                if (depth == 0) { break; }
                depth = depth - 1;
            } else if (c == 44 && depth == 0) { args = args + 1; }
            at = at - 1;
        }
        if (at < 0) { return ""; }
        int e2 = at;
        while (e2 > 0 && (ln[e2 - 1] & 255) == 32) { e2 = e2 - 1; }
        int identEnd = e2;
        while (e2 > 0 && CodeEditor.IsIdentByte(ln[e2 - 1] & 255)) {
            e2 = e2 - 1;
        }
        string name = ln.Substring(e2, identEnd - e2);
        if (name.Length == 0 || CodeEditor.IsControlWord(name)) { return ""; }

        // 若被调用方法紧跟在成员访问符（.）之后，提取前置的限定符（类名或实例名）
        // 例如：MainStatusBar.SetText(...) -> 优先查 MainStatusBar.SetText 或 StatusBar.SetText
        int pDot = e2;
        while (pDot > 0 && (ln[pDot - 1] & 255) == 32) { pDot = pDot - 1; }
        if (pDot > 0 && (ln[pDot - 1] & 255) == 46) {
            int recvEnd = pDot - 1;
            while (recvEnd > 0 && (ln[recvEnd - 1] & 255) == 32) { recvEnd = recvEnd - 1; }
            int recvStart = recvEnd;
            while (recvStart > 0 && CodeEditor.IsIdentByte(ln[recvStart - 1] & 255)) {
                recvStart = recvStart - 1;
            }
            if (recvEnd > recvStart) {
                string recv = ln.Substring(recvStart, recvEnd - recvStart);
                if (recv.Length > 0 && !CodeEditor.IsControlWord(recv)) {
                    outArg.Add(args);
                    return recv + "." + name;
                }
            }
        }

        outArg.Add(args);
        return name;
    }

    // 参数 `idx` 在 `sig` 参数列表中的起点和长度，
    // 以 (start, len) 追加到 `out2`；无此参数则追加空。
    // 嵌套泛型和 lambda 保留逗号：只有深度 0 的逗号分隔参数。
    public static void ParamSpan(string sig, int idx, List<int> out2) {
        int open = CodeEditor.Find(sig, "(");
        if (open < 0) { return; }
        int depth = 0;
        int start = open + 1;
        int n = 0;
        int i = open;
        while (i < sig.Length) {
            int c = sig[i] & 255;
            if (c == 40 || c == 60 || c == 91) { depth = depth + 1; }
            else if (c == 41 || c == 62 || c == 93) {
                depth = depth - 1;
                if (depth == 0) {
                    if (n == idx && i > start) { out2.Add(start); out2.Add(i - start); }
                    return;
                }
            } else if (c == 44 && depth == 1) {
                if (n == idx) { out2.Add(start); out2.Add(i - start); return; }
                n = n + 1;
                start = i + 1;
            }
            i = i + 1;
        }
    }

    // 成员的单行签名：编译器符号索引存在时
    // 用索引的（这样提示条显示真实声明，含全部重载），
    // 否则用下方精编的列表。
    public static string DescSig(string name) {
        if (name == "SetText") { return "void SetText(int index, string text)"; }
        if (name.EndsWith(".SetText")) {
            if (name.Contains("StatusBar") || name.Contains("Status")) {
                return "void SetText(int index, string text)";
            }
            if (name.Contains("Grid") || name.Contains("BandGrid")) {
                return "void SetText(int row, int col, string text)";
            }
            return "void SetText(string text)";
        }
        string indexed = CodeEditor.SymbolSignatureAny(name);
        if (indexed.Length > 0) { return indexed; }
        if (name == "WriteLine") { return "void WriteLine(object value)"; }
        if (name == "ReadLine") { return "string ReadLine()"; }
        if (name == "Write") { return "void Write(object value)"; }
        if (name == "Add") { return "void Add(T item)"; }
        if (name == "Remove") { return "void Remove(K key)"; }
        if (name == "RemoveAt") { return "void RemoveAt(int index)"; }
        if (name == "Insert") { return "void Insert(int index, T item)"; }
        if (name == "Count") { return "int Count"; }
        if (name == "Length") { return "int Length"; }
        if (name == "Clear") { return "void Clear()"; }
        if (name == "Contains") { return "bool Contains(T item)"; }
        if (name == "IndexOf") { return "int IndexOf(T item)"; }
        if (name == "LastIndexOf") { return "int LastIndexOf(T item)"; }
        if (name == "Reverse") { return "void Reverse()"; }
        if (name == "ToArray") { return "T[] ToArray()"; }
        if (name == "Substring") { return "string Substring(int start, int len)"; }
        if (name == "Replace") { return "string Replace(string from, string to)"; }
        if (name == "Split") { return "List<string> Split(string separator)"; }
        if (name == "Join") { return "string Join(string separator, List<string> values)"; }
        if (name == "Trim") { return "string Trim()"; }
        if (name == "ToUpper") { return "string ToUpper()"; }
        if (name == "ToLower") { return "string ToLower()"; }
        if (name == "StartsWith") { return "bool StartsWith(string prefix)"; }
        if (name == "EndsWith") { return "bool EndsWith(string suffix)"; }
        if (name == "ToString") { return "string ToString()"; }
        if (name == "Equals") { return "bool Equals(object other)"; }
        if (name == "Max") { return "double Max(double a, double b)"; }
        if (name == "Min") { return "double Min(double a, double b)"; }
        if (name == "Abs") { return "double Abs(double value)"; }
        if (name == "Pow") { return "double Pow(double x, double y)"; }
        if (name == "Sqrt") { return "double Sqrt(double value)"; }
        if (name == "Round") { return "double Round(double value)"; }
        if (name == "Floor") { return "double Floor(double value)"; }
        if (name == "Ceiling") { return "double Ceiling(double value)"; }
        if (name == "Sin") { return "double Sin(double value)"; }
        if (name == "Cos") { return "double Cos(double value)"; }
        if (name == "Tan") { return "double Tan(double value)"; }
        if (name == "Atan2") { return "double Atan2(double y, double x)"; }
        if (name == "Atan") { return "double Atan(double value)"; }
        if (name == "Asin") { return "double Asin(double value)"; }
        if (name == "Acos") { return "double Acos(double value)"; }
        if (name == "Exists") { return "bool Exists(string path)"; }
        if (name == "ReadAllText") { return "string ReadAllText(string path)"; }
        if (name == "WriteAllText") { return "void WriteAllText(string path, string text)"; }
        if (name == "AppendAllText") { return "void AppendAllText(string path, string text)"; }
        if (name == "Delete") { return "void Delete(string path)"; }
        if (name == "Copy") { return "void Copy(string from, string to)"; }
        if (name == "Move") { return "void Move(string from, string to)"; }
        if (name == "GetSize") { return "long GetSize(string path)"; }
        if (name == "CreateDirectory") { return "void CreateDirectory(string path)"; }
        if (name == "ListNames") { return "string ListNames(string globPattern)"; }
        if (name == "GetCurrentDirectory") { return "string GetCurrentDirectory()"; }
        if (name == "SetCurrentDirectory") { return "void SetCurrentDirectory(string path)"; }
        if (name == "Combine") { return "string Combine(string a, string b)"; }
        if (name == "GetFileName") { return "string GetFileName(string path)"; }
        if (name == "GetFileNameWithoutExtension") { return "string GetFileNameWithoutExtension(string path)"; }
        if (name == "GetDirectoryName") { return "string GetDirectoryName(string path)"; }
        if (name == "GetExtension") { return "string GetExtension(string path)"; }
        if (name == "HasExtension") { return "bool HasExtension(string path)"; }
        if (name == "GetTempPath") { return "string GetTempPath()"; }
        if (name == "ToInt32") { return "int ToInt32(string text)"; }
        if (name == "ToInt64") { return "long ToInt64(string text)"; }
        if (name == "ToDouble") { return "double ToDouble(string text)"; }
        if (name == "Format") { return "string Format(string format, params object[] args)"; }
        if (name == "IsNullOrEmpty") { return "bool IsNullOrEmpty(string value)"; }
        if (name == "CompareOrdinal") { return "int CompareOrdinal(string a, string b)"; }
        if (name == "ContainsKey") { return "bool ContainsKey(K key)"; }
        if (name == "TryGetValue") { return "bool TryGetValue(K key, out V value)"; }
        if (name == "Append") { return "void Append(object value)"; }
        if (name == "AppendLine") { return "void AppendLine(object value)"; }
        if (name == "SetText") { return "void SetText(int index, string text)"; }
        if (name.EndsWith(".SetText")) {
            if (name.Contains("StatusBar") || name.Contains("Status")) {
                return "void SetText(int index, string text)";
            }
            if (name.Contains("Grid") || name.Contains("BandGrid")) {
                return "void SetText(int row, int col, string text)";
            }
            return "void SetText(string text)";
        }
        if (name == "SetColor") { return "void SetColor(int index, int color)"; }
        if (name == "SetTint") { return "void SetTint(int bg)"; }
        if (name == "AddLeft") { return "int AddLeft(string text)"; }
        if (name == "AddRight") { return "int AddRight(string text)"; }
        if (name == "SetItemsText") { return "void SetItemsText(string spec)"; }
        if (name == "LastIndex") { return "int LastIndex()"; }
        if (name == "SelectedIndex") { return "int SelectedIndex()"; }
        if (name == "OnItemClick") { return "void OnItemClick(Action<int> callback)"; }
        return "";
    }

    // 知名成员的精编单行文档，无则 ""。
    public static string DescDoc(string name) {
        if (name == "SetText" || name.EndsWith(".SetText")) { return "Sets the text of a control or status bar item: SetText(int index, string text) or SetText(string text)."; }
        if (name == "SetColor" || name.EndsWith(".SetColor")) { return "Sets foreground color of a status item or control by index."; }
        if (name == "SetTint" || name.EndsWith(".SetTint")) { return "Sets background tint or accent color."; }
        if (name == "AddLeft" || name.EndsWith(".AddLeft")) { return "Adds a status item to the left side and returns its index."; }
        if (name == "AddRight" || name.EndsWith(".AddRight")) { return "Adds a status item to the right side and returns its index."; }
        if (name == "SetItemsText" || name.EndsWith(".SetItemsText")) { return "Configures status items using a pipe or semicolon delimited specification."; }
        if (name == "LastIndex" || name.EndsWith(".LastIndex")) { return "Returns the index of the most recently clicked status bar item."; }
        if (name == "SelectedIndex" || name.EndsWith(".SelectedIndex")) { return "Returns the zero-based index of the currently selected item."; }
        if (name == "OnItemClick" || name.EndsWith(".OnItemClick")) { return "Subscribes a callback delegate to status item click events."; }
        if (name == "WriteLine") { return "Writes the value followed by a line terminator to standard output."; }
        if (name == "ReadLine") { return "Reads the next line of characters from standard input."; }
        if (name == "Write") { return "Writes the value to standard output (no line terminator)."; }
        if (name == "Add") { return "Adds an item to the end of the collection."; }
        if (name == "Remove") { return "Removes the key/item from the collection."; }
        if (name == "RemoveAt") { return "Removes the item at the given zero-based index."; }
        if (name == "Insert") { return "Inserts an item at the given index, shifting later items."; }
        if (name == "Count") { return "Number of elements currently in the collection."; }
        if (name == "Length") { return "Number of characters/elements."; }
        if (name == "Clear") { return "Removes all elements."; }
        if (name == "Contains") { return "Returns whether the item is present."; }
        if (name == "IndexOf") { return "Zero-based index of the first matching item, or -1."; }
        if (name == "LastIndexOf") { return "Zero-based index of the last matching item, or -1."; }
        if (name == "Reverse") { return "Reverses the order of elements."; }
        if (name == "ToArray") { return "Copies elements to a new array."; }
        if (name == "Substring") { return "Returns a portion of the string starting at start."; }
        if (name == "Replace") { return "Returns a copy with all occurrences of old replaced by new."; }
        if (name == "Split") { return "Splits the string into a List<string> around the separator."; }
        if (name == "Join") { return "Concatenates values, inserting the separator between them."; }
