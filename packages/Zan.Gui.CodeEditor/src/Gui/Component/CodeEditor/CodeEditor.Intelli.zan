        if (name == "Combine") { return "Combines two path strings."; }
        if (name == "GetFileName") { return "Returns the file name and extension of the specified path string."; }
        if (name == "GetFileNameWithoutExtension") { return "Returns the file name of the specified path string without the extension."; }
