using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;

namespace Gui.Component.CodeEditor;

// CodeEditor 分部：键盘输入分发、字符键与快捷键、光标导航与剪贴板按键
public partial class CodeEditor {
    // 分发输入事件：kind==6（字符/编辑键）转 HandleCharKey，
    // kind==4（导航/选择键）转 HandleNavKey，其余种类忽略。
    public void HandleInput(App app) {
        int kind = app.EventKind();
        if (kind == 6) {
            HandleCharKey(app);
        } else if (kind == 4) {
            HandleNavKey(app);
        }
    }

    // kind==6：键入字符、Ctrl 快捷键和编辑键。
    public void HandleCharKey(App app) {
        int code = app.window.EventKeyCode();
        bool ate = ateCtrlKey;
        ateCtrlKey = false;
        // Ctrl 组合已经在 kind==4 里处理过：Windows 之后还会送一个
        // 控制字符（Ctrl+V = 22），再处理一次就粘贴两遍。
        if (ate && (code < 32 || code == 46 || code == 127)) { return; }
        CancelSemanticCompletion();
        // Ctrl+A = 全选（code 1）
        if (code == 1) {
            SelectAll();
            app.RequestRedraw();
            return;
        }
        // Ctrl+Shift+Space = 切换参数信息的重载（VS：再按一次参数信息
        // 逐个翻重载）。必须排在 Ctrl+Space 之前，否则会被当成"列出全部
        // 候选"的显式补全。
        if ((code == 32 || code == 0) && Modifiers.HasCtrl(app.window.EventMods())
                && Modifiers.HasShift(app.window.EventMods())) {
            this.SigSwitchOverload(1);
            app.RequestRedraw();
            return;
        }
        // Ctrl+Space = 显式打开补全，列出
        // 作用域内所有内容，即使未输入前缀（部分平台 code 为 0 且带 Ctrl，
        // 其他平台为按住 Ctrl 的空格；严格防止 Windows IME 的裸 0 码误触发）。
        if (((code == 0 && Modifiers.HasCtrl(app.window.EventMods())) || (code == 32 && Modifiers.HasCtrl(app.window.EventMods())))) {
            if (!InStringOrCommentContext()) {
                ForceCompletion();
                app.RequestRedraw();
            }
            return;
        }
        // Ctrl+C = 复制（code 3）
        if (code == 3) {
            CopySelection();
            app.RequestRedraw();
            return;
        }
        // Ctrl+X = 剪切（code 24）
        if (code == 24) {
            CutSelection();
            CheckErrors();
            app.RequestRedraw();
            return;
        }
        // Ctrl+V = 粘贴（code 22）
        if (code == 22) {
            PasteClipboard();
            CheckErrors();
            UpdateCompletion();
            app.RequestRedraw();
            return;
        }
        // Ctrl+Z = 撤销（code 26）
        if (code == 26) {
            Undo();
            CheckErrors();
            app.RequestRedraw();
            return;
        }
        // Ctrl+Y = 重做（code 25）
        if (code == 25) {
            Redo();
            CheckErrors();
            app.RequestRedraw();
            return;
        }
        // Ctrl+D = 复制行（code 4）
        if (code == 4) {
            DuplicateLine();
            CheckErrors();
            app.RequestRedraw();
            return;
        }
        // Ctrl+L = 删除行（code 12）
        if (code == 12) {
            DeleteLine();
            CheckErrors();
            app.RequestRedraw();
            return;
        }
        // Ctrl+/ = 切换行注释（code 31）
        if (code == 31) {
            ToggleComment();
            CheckErrors();
            app.RequestRedraw();
            return;
        }
        if (code == 8) {
            if (selActive || HasSelection()) {
                ClearExtraCarets();
                DeleteSelection();
                app.RequestRedraw();
                return;
            }
            if (carets.Count > 0) {
                McBackspace();
                UpdateCompletion();
                app.RequestRedraw();
                return;
            }
            // 工业级成对删除：光标在 () [] {} "" '' 中间时退格同时删除两侧
            string ln = curLine >= 0 && curLine < lines.Count ? lines[curLine] : "";
            if (curCol > 0 && curCol < ln.Length) {
                string lCh = ln.Substring(curCol - 1, 1);
                string rCh = ln.Substring(curCol, 1);
                if ((lCh == "(" && rCh == ")") || (lCh == "[" && rCh == "]")
                    || (lCh == "{" && rCh == "}") || (lCh == "\"" && rCh == "\"")
                    || (lCh == "'" && rCh == "'")) {
                    SaveUndo();
                    lines[curLine] = ln.Substring(0, curCol - 1) + ln.Substring(curCol + 1, ln.Length - (curCol + 1));
                    curCol = curCol - 1;
                    UpdateCompletion();
                    app.RequestRedraw();
                    return;
                }
            }
            SaveUndoBackspace(); BackspaceEdit();
            UpdateCompletion();
            app.RequestRedraw();
            return;
        } else if (code == 13) {
            EndUndoGroup();
            int m13 = app.window.EventMods();
            if (Modifiers.HasCtrl(m13)) {
                // Ctrl+M：折叠/展开当前块；Ctrl+Shift+M：展开。
                // Windows 上 Ctrl+M 与 Enter 同码（都是 CR），只能靠
                // 修饰键区分——不判断的话 Ctrl+M 会插入一个换行。
                if (Modifiers.HasShift(m13)) { this.ExpandFoldAt(curLine); }
                else { this.ToggleFold(curLine); }
                acActive = false;
                acSnippetOnly = false;
                app.RequestRedraw();
            } else if (acActive) { AcceptCompletion(false); }
            else {
                ClearExtraCarets();
                if (selActive) { DeleteSelection(); }
                else { SaveUndo(); }
                NewLine();
                CheckErrors();
            }
            app.RequestRedraw();
        } else if (code == 9) {
            EndUndoGroup();
            bool tabShift = Modifiers.HasShift(app.window.EventMods());
            if (snipActive) {
                // 片段模式：Tab 跳到下一个洞（补全弹窗在片段里不打扰用户）。
                SnipNext();
            }
            else if (acActive) { AcceptCompletion(true); }
            else if (tabShift) {
                if (selActive && selAnchorLine != curLine) { OutdentSelection(); }
                else { OutdentCurrentLine(); }
                CheckErrors();
            }
            else if (selActive && selAnchorLine != curLine) {
                IndentSelection();
                CheckErrors();
            }
            else {
                // 无弹窗：先把光标前的标识符前缀补全成词
                // （实体候选 + 文档词，取最长公共前缀），
                // 补不上才退回缩进空格。
                if (!TryCompleteWord()) {
                    if (selActive) { ClearExtraCarets(); DeleteSelection(); }
                    if (carets.Count > 0) { McInsertStr("    "); }
                    else { InsertStr("    "); }
                }
            }
            app.RequestRedraw();
        } else if (code == 27) {
            EndUndoGroup();
            acActive = false;
            acFilter = "";
            selActive = false;
            refPopOpen = false;
            ClearExtraCarets();
            ctxOpen = false;
            SnipEnd();
            app.RequestRedraw();
        } else if (code > 31) {
            string ch = Text.CharStr(code);
            if (ch.Length > 0) {
                if (selActive) {
                    // 工业级选区包裹 (Surround With)：选中文本后输入括号/引号直接包裹选区
                    if (ch == "(") { SurroundSelection("(", ")"); CheckErrors(); app.RequestRedraw(); return; }
                    if (ch == "[") { SurroundSelection("[", "]"); CheckErrors(); app.RequestRedraw(); return; }
                    if (ch == "{") { SurroundSelection("{", "}"); CheckErrors(); app.RequestRedraw(); return; }
                    if (ch == "\"") { SurroundSelection("\"", "\""); CheckErrors(); app.RequestRedraw(); return; }
                    if (ch == "'") { SurroundSelection("'", "'"); CheckErrors(); app.RequestRedraw(); return; }
                    ClearExtraCarets();
                    DeleteSelection();
                } else {
                    string ln = curLine >= 0 && curLine < lines.Count ? lines[curLine] : "";
                    // 1. 跳过已有闭合符号 (Type-over Closing Character)：输入右括号/引号且光标处正好相同时跳过该字符
                    if (curCol < ln.Length && ln.Substring(curCol, 1) == ch) {
                        if (ch == ")" || ch == "]" || ch == "}" || ch == "\"" || ch == "'") {
                            if (ch == "\"" || ch == "'") {
                                acActive = false; acDot = false; CancelSemanticCompletion();
                            }
                            curCol = curCol + 1;
                            app.RequestRedraw();
                            return;
                        }
                    }
                    // 2. 自动配对闭合 (Auto-closing Pairs)：输入左括号/引号自动闭合且光标居中
                    if (carets.Count == 0) {
                        if (ch == "(") {
                            SaveUndoTyping();
                            InsertStr("()");
                            curCol = curCol - 1;
                            selActive = false;
                            CheckErrors();
                            app.RequestRedraw();
                            return;
                        }
                        if (ch == "[") {
                            SaveUndoTyping();
                            InsertStr("[]");
                            curCol = curCol - 1;
                            selActive = false;
                            CheckErrors();
                            app.RequestRedraw();
                            return;
                        }
                        if (ch == "{") {
                            SaveUndoTyping();
                            InsertStr("{}");
                            curCol = curCol - 1;
                            selActive = false;
                            CheckErrors();
                            app.RequestRedraw();
                            return;
                        }
                        if (ch == "\"") {
                            SaveUndoTyping();
                            InsertStr("\"\"");
                            curCol = curCol - 1;
                            selActive = false;
                            acActive = false;
                            acDot = false;
                            CancelSemanticCompletion();
                            app.RequestRedraw();
                            return;
                        }
                        if (ch == "'") {
                            SaveUndoTyping();
                            InsertStr("''");
                            curCol = curCol - 1;
                            selActive = false;
                            acActive = false;
                            acDot = false;
                            CancelSemanticCompletion();
                            app.RequestRedraw();
                            return;
                        }
                    }
                    SaveUndoTyping();
                }
                if (carets.Count > 0) { McInsertStr(ch); }
                else { InsertStr(ch); }
                selActive = false;
                if (snipActive) {
                    // 片段的洞里不弹补全（Visual Studio 的做法）：
                    // 补全弹窗会抢走 Tab，洞就跳不动了。
                }
                else if (ch == ".") {
                    DotCompletion();
                } else {
                    UpdateCompletion();
                }
                // 只对可能改变其他行结构的字符重跑诊断
                // （花括号/圆括号配平、语句
                // 终止）。当前行的普通文本在光标离开该行时才校验，
                // 避免每次击键都
                // 整文档重扫。
                if (ch == "{" || ch == "}" || ch == "(" || ch == ")" || ch == ";") {
                    CheckErrors();
                }
                app.RequestRedraw();
            }
        }
    }

    // kind==4：导航 / 选择 / 多光标移动键。
    public void HandleNavKey(App app) {
        int kc = app.window.EventKeyCode();
        // 片段模式里移动光标 = 离开片段（VS：光标一动，片段即结束）。
        if (snipActive && (kc == 37 || kc == 38 || kc == 39 || kc == 40
            || kc == 33 || kc == 34 || kc == 35 || kc == 36)) {
            SnipEnd();
        }
        if (!(acActive && (kc == 38 || kc == 40))) { CancelSemanticCompletion(); }
        // 剪贴板与全选按虚拟键处理。只认控制字符（Ctrl+C = 3）在
        // 中文输入法开着、或键盘布局不产生控制字符时会整个丢掉，
        // 于是复制粘贴时灵时不灵。
        int cmods = app.window.EventMods();
        if (Modifiers.HasCtrl(cmods) && !Modifiers.HasAlt(cmods)
            && (kc == 67 || kc == 86 || kc == 88 || kc == 65)) {
            ateCtrlKey = true;
            if (kc == 67) { CopySelection(); }
            else if (kc == 88) { CutSelection(); CheckErrors(); }
            else if (kc == 86) {
                PasteClipboard();
                CheckErrors();
                UpdateCompletion();
            } else { SelectAll(); }
            app.RequestRedraw();
            return;
        }
        if (acActive && kc == 38) {
            acSel = acSel - 1;
            if (acSel < 0) { acSel = acItems.Count - 1; }
            app.RequestRedraw();
        } else if (acActive && kc == 40) {
            acSel = acSel + 1;
            if (acSel >= acItems.Count) { acSel = 0; }
            app.RequestRedraw();
        } else if (kc == 27) { EndUndoGroup(); acActive = false; acFilter = ""; acSnippetOnly = false; selActive = false; refPopOpen = false; app.RequestRedraw(); }
        else if (kc == 37) {
            EndUndoGroup();
            int m37 = app.window.EventMods();
            acActive = false; ClearExtraCarets(); SelPrepare(Modifiers.HasShift(m37));
            if (Modifiers.HasCtrl(m37)) { MoveWordLeft(); } else { MoveLeft(); }
            app.RequestRedraw();
        }
        else if (kc == 39) {
            EndUndoGroup();
            int m39 = app.window.EventMods();
            acActive = false; ClearExtraCarets(); SelPrepare(Modifiers.HasShift(m39));
            if (Modifiers.HasCtrl(m39)) { MoveWordRight(); } else { MoveRight(); }
            app.RequestRedraw();
        }
        else if (kc == 38) {
            EndUndoGroup();
            int mods38 = app.window.EventMods();
            if (Modifiers.HasCtrl(mods38) && Modifiers.HasAlt(mods38)) { AddCaretAbove(); }
            else if (Modifiers.HasAlt(mods38)) { ClearExtraCarets(); MoveLineUp(); CheckErrors(); }
            else { ClearExtraCarets(); SelPrepare(Modifiers.HasShift(mods38)); MoveUp(); }
            app.RequestRedraw();
        }
        else if (kc == 40) {
            EndUndoGroup();
            int mods40 = app.window.EventMods();
            if (Modifiers.HasCtrl(mods40) && Modifiers.HasAlt(mods40)) { AddCaretBelow(); }
            else if (Modifiers.HasAlt(mods40)) { ClearExtraCarets(); MoveLineDown(); CheckErrors(); }
            else { ClearExtraCarets(); SelPrepare(Modifiers.HasShift(mods40)); MoveDown(); }
            app.RequestRedraw();
        }
        else if (kc == 33) {
            EndUndoGroup();
            int vis = pageRows;
            bool sh = Modifiers.HasShift(app.window.EventMods());
            acActive = false; ClearExtraCarets(); SelPrepare(sh);
            int np = curLine - vis; if (np < 0) { np = 0; }
            curLine = np; ClampCol(); app.RequestRedraw();
        }
        else if (kc == 34) {
            EndUndoGroup();
            int vis = pageRows;
            bool sh = Modifiers.HasShift(app.window.EventMods());
            acActive = false; ClearExtraCarets(); SelPrepare(sh);
            int np = curLine + vis; if (np > lines.Count - 1) { np = lines.Count - 1; }
            curLine = np; ClampCol(); app.RequestRedraw();
        }
        else if (kc == 36) {
            EndUndoGroup();
            int m36 = app.window.EventMods();
            acActive = false; ClearExtraCarets(); SelPrepare(Modifiers.HasShift(m36));
            if (Modifiers.HasCtrl(m36)) { curLine = 0; curCol = 0; }
            else { curCol = SmartHomeCol(); }
            app.RequestRedraw();
        }
        else if (kc == 35) {
            EndUndoGroup();
            int m35 = app.window.EventMods();
            acActive = false; ClearExtraCarets(); SelPrepare(Modifiers.HasShift(m35));
            if (Modifiers.HasCtrl(m35)) { curLine = lines.Count - 1; }
            curCol = lines[curLine].Length;
            app.RequestRedraw();
        }
        else if (kc == 8) {
            // 退格键 (VK_BACK = 8)：消费后续 kind==6 的 WM_CHAR 字符事件（code==8），防双重删除
            ateCtrlKey = true;
            EndUndoGroup();
            if (selActive || HasSelection()) {
                ClearExtraCarets();
                DeleteSelection();
                app.RequestRedraw();
                return;
            }
            if (carets.Count > 0) {
                McBackspace();
                UpdateCompletion();
                app.RequestRedraw();
                return;
            }
            string ln = curLine >= 0 && curLine < lines.Count ? lines[curLine] : "";
            if (curCol > 0 && curCol < ln.Length) {
                string lCh = ln.Substring(curCol - 1, 1);
                string rCh = ln.Substring(curCol, 1);
                if ((lCh == "(" && rCh == ")") || (lCh == "[" && rCh == "]")
                    || (lCh == "{" && rCh == "}") || (lCh == "\"" && rCh == "\"")
                    || (lCh == "'" && rCh == "'")) {
                    SaveUndo();
                    lines[curLine] = ln.Substring(0, curCol - 1) + ln.Substring(curCol + 1, ln.Length - (curCol + 1));
                    curCol = curCol - 1;
                    UpdateCompletion();
                    app.RequestRedraw();
                    return;
                }
            }
            SaveUndoBackspace();
            BackspaceEdit();
            UpdateCompletion();
            app.RequestRedraw();
            return;
        }
        else if (kc == 46) {
            ateCtrlKey = true;
            EndUndoGroup();
            if (selActive || HasSelection()) {
                ClearExtraCarets();
                DeleteSelection();
            } else {
                ClearExtraCarets();
                SaveUndo();
                DeleteEdit();
            }
            acActive = false;
            app.RequestRedraw();
        }
    }

    // 把像素 x 偏移（相对文本原点）映射为列索引。
    // 实现移至 TextWrap.ColFromX（Input/TextArea 只需文本布局，
    // 不必拖入整个代码编辑器）；此处保留委托稳住内部调用点。
    public static int ColFromX(string s, int px, int fontSize) {
        return Gui.TextWrap.ColFromX(s, px, fontSize);
    }
}
