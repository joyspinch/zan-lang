using System;

namespace Gui.Component.CodeEditor;

/// 调试器变量的一行（名称 / 类型 / 值），显示在 Variables
/// 面板和编辑器调试悬停提示中。用单个实体取代旧的
/// 制表符分隔的 "name\ttype\tvalue" 字符串。
class DbgVar {
    string name;
    string type;
    string val;

    DbgVar(string name, string type, string val) {
        this.name = name;
        this.type = type;
        this.val = val;
    }
}
