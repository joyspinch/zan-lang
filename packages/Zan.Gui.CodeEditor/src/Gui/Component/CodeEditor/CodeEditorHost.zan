using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Gui.Component;

namespace Gui.Component.CodeEditor;

// 现代声明式代码编辑器宿主控件（CodeEditorHost）：
// 将底层的即时模式 CodeEditor 核心引擎封装为标准 Visual Tree 保留式控件。
// 满足现代 GUI 范式：支持 Children = [ ... ] 自由嵌套、Flex/Grid 弹性排版、
// HTML/DSL 标记 (<code-editor> / <CodeEditor>)，以及 GetProp/SetProp 属性协议。
public class CodeEditorHost : Control {
    // 底层高性能编辑器核心
    public CodeEditor editor;

    // 自注册入口（B-ID44 约定）：按需注册到 ControlFactory
    public static void Install() {
        Gui.ControlFactory.Register("CodeEditor", (string k) => new CodeEditorHost());
        Gui.ControlFactory.Register("CodeEditorHost", (string k) => new CodeEditorHost());
    }

    // 初始化宿主控件
    private void InitHost(CodeEditor ed) {
        this.InitControl("codeeditor", 0);
        this.editor = ed != null ? ed : new CodeEditor();
        this.wiresOwnEvents = true;
    }

    // 默认无参构造（声明式树/工厂使用）
    public CodeEditorHost() {
        this.InitHost(null);
    }

    // 显式包裹已有 CodeEditor 实例
    public CodeEditorHost(CodeEditor ed) {
        this.InitHost(ed);
    }

    // 控件类型标识
    public override string Kind() { return "CodeEditor"; }

    // 皮肤类型选择器
    public override string StyleType() { return "codeeditor"; }

    // 属性清单（设计器与反射用）
    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec p = PropSpec.Text("path", "Document Path");
        p.str = editor != null ? editor.documentPath : "";
        ps.Add(p);

        PropSpec t = PropSpec.Text("text", "Code Content");
        t.str = editor != null ? editor.GetText() : "";
        ps.Add(t);
        return ps;
    }

    // 读属性
    public override string GetProp(string key) {
        if (key == "path" && editor != null) { return editor.documentPath; }
        if (key == "text" && editor != null) { return editor.GetText(); }
        return base.GetProp(key);
    }

    // 写属性
    public override void SetProp(string key, string val) {
        if (key == "path" && editor != null) { editor.documentPath = val; return; }
        if (key == "text" && editor != null) { editor.LoadText(val); return; }
        base.SetProp(key, val);
    }

    // 链式载入文本
    public CodeEditorHost LoadText(string s) {
        if (editor != null) { editor.LoadText(s); }
        return this;
    }

    // 读取当前文本
    public string GetText() {
        return editor != null ? editor.GetText() : "";
    }

    // 链式绑定文件路径
    public CodeEditorHost BindPath(string path) {
        if (editor != null) { editor.documentPath = path; }
        return this;
    }

    // 获取底层编辑器实例
    public CodeEditor Editor() {
        return editor;
    }

    // 覆写：度量首选尺寸
    public override void OnMeasure(App app) {
        prefW = app.Scale(600);
        prefH = app.Scale(400);
    }

    // 覆写：排版与绘制。将自身由布局计算得出的矩形传给底层引擎进行局部渲染
    public override void OnPaint(App app) {
        if (editor == null) { return; }
        Rect area = new Rect(bx, by, bw, bh);
        editor.Render(app, area);
    }
}
