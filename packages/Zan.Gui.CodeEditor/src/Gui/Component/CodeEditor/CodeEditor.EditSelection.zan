using System;
using System.Collections.Generic;
using System.Text;
using Gui;
using Gui.Backend;

namespace Gui.Component.CodeEditor;

// CodeEditor 分部：多光标、选区管理、剪贴板操作与行编辑命令
public partial class CodeEditor {
    // ---- 多光标 ----
    // 清掉全部辅助光标（只留主光标）。
    public void ClearExtraCarets() {
        if (carets.Count > 0) { carets.Clear(); }
    }

    // 在最下方活动光标的下一行添加辅助光标。
    public void AddCaretBelow() {
        if (lines == null || lines.Count == 0) { return; }
        int maxL = curLine;
        for (int i = 0; i < carets.Count; i = i + 1) { if (carets[i].line > maxL) { maxL = carets[i].line; } }
        if (maxL + 1 < lines.Count) {
            int col = Text.ClampCharStart(lines[maxL + 1], curCol);
            carets.Add(new Caret(maxL + 1, col));
        }
    }

    // 在最上方活动光标的上一行添加辅助光标。
    public void AddCaretAbove() {
        if (lines == null || lines.Count == 0) { return; }
        int minL = curLine;
        for (int i = 0; i < carets.Count; i = i + 1) { if (carets[i].line < minL) { minL = carets[i].line; } }
        if (minL - 1 >= 0 && minL - 1 < lines.Count) {
            int col = Text.ClampCharStart(lines[minL - 1], curCol);
            carets.Add(new Caret(minL - 1, col));
        }
    }

    // 在主光标和所有辅助光标处插入 `ins`。
    // 所有光标分处不同行，各行编辑互不影响。
    public void McInsertStr(string ins) {
        if (!CanMutate() || ins == null) { return; }
        InsertStr(ins);
        for (int i = 0; i < carets.Count; i = i + 1) {
            int L = carets[i].line;
            if (L >= 0 && L < lines.Count) {
                int C = Text.ClampCharStart(lines[L], carets[i].col);
                lines[L] = Text.InsertAt(lines[L], C, ins);
                carets[i].col = C + ins.Length;
            }
        }
    }

    // 在每个光标处退格。当主光标
    // 位于第 0 列时（合并行会改变索引）退化为单光标。
    public void McBackspace() {
        if (!CanMutate() || lines == null || lines.Count == 0) { return; }
        ClampCol();
        if (curCol <= 0) { ClearExtraCarets(); SaveUndo(); BackspaceEdit(); return; }
        SaveUndo();
        string ln = lines[curLine];
        int start = Text.PrevCharStart(ln, curCol);
        lines[curLine] = Text.DeleteBefore(ln, curCol);
        curCol = start;
        for (int i = 0; i < carets.Count; i = i + 1) {
            int L = carets[i].line;
            if (L >= 0 && L < lines.Count) {
                int C = Text.ClampCharStart(lines[L], carets[i].col);
                if (C > 0) {
                    int cs = Text.PrevCharStart(lines[L], C);
                    lines[L] = Text.DeleteBefore(lines[L], C);
                    carets[i].col = cs;
                }
            }
        }
    }

    // 尚无选区时在当前位置埋下选区锚点（拖拽/Shift 移动前调用）。
    public void StartSelection() {
        if (!selActive) {
            selAnchorLine = curLine;
            selAnchorCol = curCol;
            selActive = true;
        }
    }

    // 归一选区起止位置；无选区返回 false。
    private bool TryGetSelectionRange(out int sL, out int sC, out int eL, out int eC) {
        if (!selActive || lines == null || lines.Count == 0) {
            sL = 0; sC = 0; eL = 0; eC = 0;
            return false;
        }
        sL = selAnchorLine;
        sC = selAnchorCol;
        eL = curLine;
        eC = curCol;
        if (sL < 0) { sL = 0; }
        if (sL >= lines.Count) { sL = lines.Count - 1; }
        if (eL < 0) { eL = 0; }
        if (eL >= lines.Count) { eL = lines.Count - 1; }
        sC = Text.ClampCharStart(lines[sL], sC);
        eC = Text.ClampCharStart(lines[eL], eC);
        if (sL > eL || (sL == eL && sC > eC)) {
            int tmpL = sL; sL = eL; eL = tmpL;
            int tmpC = sC; sC = eC; eC = tmpC;
        }
        return true;
    }

    // 选区文本（行间以 '\n' 连接；方向自动归一，无选区为 ""）。
    public string GetSelectedText() {
        int sL; int sC; int eL; int eC;
        if (!TryGetSelectionRange(out sL, out sC, out eL, out eC)) { return ""; }
        if (sL == eL) {
            string ln = lines[sL];
            if (sC > ln.Length) { sC = ln.Length; }
            if (eC > ln.Length) { eC = ln.Length; }
            return ln.Substring(sC, eC - sC);
        }
        StringBuilder sb = new StringBuilder();
        string firstLn = lines[sL];
        if (sC <= firstLn.Length) {
            sb.Append(firstLn.Substring(sC, firstLn.Length - sC));
        }
        for (int mi = sL + 1; mi < eL; mi = mi + 1) {
            sb.Append("\n");
            sb.Append(lines[mi]);
        }
        string lastLn = lines[eL];
        if (eC > lastLn.Length) { eC = lastLn.Length; }
        sb.Append("\n");
        sb.Append(lastLn.Substring(0, eC));
        return sb.ToString();
    }

    // 删除整个选区：光标落在选区起点，选区取消（无选区或空选区返回 false，成功删除返回 true）。
    public bool DeleteSelection() {
        if (!CanMutate()) { return false; }
        int sL; int sC; int eL; int eC;
        if (!TryGetSelectionRange(out sL, out sC, out eL, out eC)) { return false; }
        if (sL == eL && sC == eC) {
            selActive = false;
            return false;
        }
        SaveUndo();
        if (sL == eL) {
            string ln = lines[sL];
            if (sC > ln.Length) { sC = ln.Length; }
            if (eC > ln.Length) { eC = ln.Length; }
            lines[sL] = ln.Substring(0, sC) + ln.Substring(eC, ln.Length - eC);
        } else {
            string firstLn = lines[sL];
            string lastLn = lines[eL];
            if (sC > firstLn.Length) { sC = firstLn.Length; }
            if (eC > lastLn.Length) { eC = lastLn.Length; }
            string keep = firstLn.Substring(0, sC) + lastLn.Substring(eC, lastLn.Length - eC);
            int dropCount = eL - sL;
            if (dropCount >= 4) {
                List<string> nextLines = new List<string>();
                for (int i = 0; i < sL; i = i + 1) { nextLines.Add(lines[i]); }
                nextLines.Add(keep);
                for (int i = eL + 1; i < lines.Count; i = i + 1) { nextLines.Add(lines[i]); }
                lines = nextLines;
            } else {
                lines[sL] = keep;
                for (int ri = eL; ri > sL; ri = ri - 1) {
                    lines.RemoveAt(ri);
                }
            }
        }
        curLine = sL;
        curCol = sC;
        selActive = false;
        acActive = false;
        acDot = false;
        // 片段模式：选区多半就是洞里的默认文字，删完洞就空了。
        SnipDeletedRange(sL, sC);
        return true;
    }

    // 工业级选区包裹（Surround With）：输入括号/引号时用成对字符包裹当前选区文本
    public void SurroundSelection(string openCh, string closeCh) {
        if (!CanMutate() || openCh == null || closeCh == null) { return; }
        int sL; int sC; int eL; int eC;
        if (!TryGetSelectionRange(out sL, out sC, out eL, out eC)) { return; }
        string selText = GetSelectedText();
        DeleteSelection();
        InsertBlock(openCh + selText + closeCh);
        selAnchorLine = sL;
        selAnchorCol = sC + openCh.Length;
        curLine = eL;
        curCol = sL == eL ? eC + openCh.Length : eC;
        ClampCol();
        selActive = true;
    }

    // 复制选区到系统剪贴板（同时留在内部缓冲）；
    // 当无选区时，按 Visual Studio 规范复制当前整行（包含行尾换行符）。
    public void CopySelection() {
        if (selActive) {
            clipboard = GetSelectedText();
            Clipboard.SetText(clipboard);
        } else if (lines != null && curLine >= 0 && curLine < lines.Count) {
            clipboard = lines[curLine] + "\n";
            Clipboard.SetText(clipboard);
        }
    }

    // 剪切：复制选区后再删除；
    // 当无选区时，按 Visual Studio 规范剪切当前整行并删除该行。
    public void CutSelection() {
        if (!CanMutate()) { return; }
        if (selActive) {
            CopySelection();
            DeleteSelection();
        } else if (lines != null && curLine >= 0 && curLine < lines.Count) {
            CopySelection();
            DeleteLine();
        }
    }

    // 粘贴：优先系统剪贴板（可粘其他应用复制的内容），为空时回退
    // 编辑器内缓冲；内容经 InsertBlock 插入（替换选区）。
    public void PasteClipboard() {
        if (!CanMutate()) { return; }
        // 优先使用系统剪贴板，使其他应用复制的文本可粘贴进来；
        // 系统剪贴板为空时回退到编辑器内缓冲区。
        string os = Clipboard.GetText();
        if (os != null && os.Length > 0) { clipboard = os; }
        if (clipboard == null || clipboard.Length == 0) { return; }
        InsertBlock(clipboard);
    }

    // 在光标处插入可能含多行的文本（替换当前
    // 选区），与粘贴 `ins` 完全一致。
    public void InsertBlock(string ins) {
        if (!CanMutate() || ins == null || lines == null || lines.Count == 0) { return; }
        if (selActive) { DeleteSelection(); }
        else { SaveUndo(); }
        ClampCol();
        List<string> pLines = CodeEditor.SplitLines(ins);
        if (pLines.Count == 0) { return; }
        if (pLines.Count == 1) {
            InsertStr(pLines[0]);
        } else {
            string ln = lines[curLine];
            string left = ln.Substring(0, curCol);
            string right = curCol < ln.Length ? ln.Substring(curCol, ln.Length - curCol) : "";
            int lastIdx = pLines.Count - 1;
            string lastP = pLines[lastIdx];
            if (pLines.Count > 4) {
                List<string> nextLines = new List<string>();
                for (int i = 0; i < curLine; i = i + 1) { nextLines.Add(lines[i]); }
                nextLines.Add(left + pLines[0]);
                for (int pi = 1; pi < lastIdx; pi = pi + 1) { nextLines.Add(pLines[pi]); }
                nextLines.Add(lastP + right);
                for (int i = curLine + 1; i < lines.Count; i = i + 1) { nextLines.Add(lines[i]); }
                lines = nextLines;
            } else {
                lines[curLine] = left + pLines[0];
                for (int pi = 1; pi < lastIdx; pi = pi + 1) {
                    lines.Insert(curLine + pi, pLines[pi]);
                }
                lines.Insert(curLine + lastIdx, lastP + right);
            }
            curLine = curLine + lastIdx;
            curCol = lastP.Length;
        }
    }

    // ---- 行编辑（右键菜单 / VS 风格命令）----

    // 删除当前选区；无选区时删除光标处的字符。
    public void DeleteAtCaret() {
        if (!CanMutate()) { return; }
        if (selActive) { DeleteSelection(); }
        else { SaveUndo(); DeleteEdit(); }
    }

    // 在当前行切换行首行注释（本语言的引导符：Zan "// "、
    // Lua "-- "、Python "# "），或对选区覆盖的每一行切换。
    public void ToggleComment() {
        if (!CanMutate() || lines == null || lines.Count == 0) { return; }
        SaveUndo();
        int a = curLine;
        int b = curLine;
        if (selActive) {
            a = selAnchorLine;
            b = curLine;
            if (a > b) { int tmp = a; a = b; b = tmp; }
        }
        if (a < 0) { a = 0; }
        if (b >= lines.Count) { b = lines.Count - 1; }
        // 若范围内所有行都已注释则取消注释，否则全部加上注释。
        string tok = LineComment();
        int tl = tok.Length;
        bool allComment = true;
        int i = a;
        while (i <= b) {
            string s = lines[i];
            string trimmed = CodeEditor.LTrim(s);
            if (trimmed.Length < tl || trimmed.Substring(0, tl) != tok) {
                if (trimmed.Length > 0) { allComment = false; }
            }
            i = i + 1;
        }
        i = a;
        while (i <= b) {
            string s = lines[i];
            if (allComment) {
                lines[i] = CodeEditor.UncommentTok(s, tok);
            } else {
                if (CodeEditor.LTrim(s).Length > 0) {
                    // 保留前导缩进，在缩进后添加注释符
                    int ws = 0;
                    while (ws < s.Length) {
                        int ch = s[ws] & 255;
                        if (ch == 32 || ch == 9) { ws = ws + 1; } else { break; }
                    }
                    string indent = s.Substring(0, ws);
                    string codePart = s.Substring(ws, s.Length - ws);
                    lines[i] = indent + tok + " " + codePart;
                }
            }
            i = i + 1;
        }
        selActive = false;
        ClampCol();
    }

    // 在当前行正下方复制一行。
    public void DuplicateLine() {
        if (!CanMutate() || lines == null || curLine < 0 || curLine >= lines.Count) { return; }
        SaveUndo();
        string s = lines[curLine];
        lines.Insert(curLine + 1, s);
        curLine = curLine + 1;
        ClampCol();
    }

    // 整行删除当前行。
    public void DeleteLine() {
        if (!CanMutate() || lines == null || lines.Count == 0) { return; }
        SaveUndo();
        if (lines.Count <= 1) {
            lines[0] = "";
            curLine = 0;
            curCol = 0;
            return;
        }
        if (curLine < 0) { curLine = 0; }
        if (curLine >= lines.Count) { curLine = lines.Count - 1; }
        lines.RemoveAt(curLine);
        if (curLine >= lines.Count) { curLine = lines.Count - 1; }
        ClampCol();
    }

    // 去掉前导空格/制表符。
    public static string LTrim(string s) {
        if (s == null || s.Length == 0) { return ""; }
        int len = s.Length;
        int i = 0;
        while (i < len) {
            int ch = s[i];
            if (ch == 32 || ch == 9) { i = i + 1; }
            else { break; }
        }
        if (i == 0) { return s; }
        return s.Substring(i, len - i);
    }

    // 去掉尾部空格/制表符。
    public static string RTrim(string s) {
        if (s == null || s.Length == 0) { return ""; }
        int len = s.Length;
        int i = len - 1;
        while (i >= 0) {
            int ch = s[i];
            if (ch == 32 || ch == 9 || ch == 13 || ch == 10) { i = i - 1; }
            else { break; }
        }
        if (i < 0) { return ""; }
        return s.Substring(0, i + 1);
    }

    // 删除前导空白后的第一个"// "（或"//"）。
    public static string Uncomment(string s) {
        return CodeEditor.UncommentTok(s, "//");
    }

    // 删除前导空白后的第一个 `tok`（及紧随的一个空格），
    // `tok` 是该语言的行注释引导符。
    public static string UncommentTok(string s, string tok) {
        if (s == null || s.Length == 0) { return ""; }
        if (tok == null || tok.Length == 0) { return s; }
        int i = 0;
        while (i < s.Length) {
            int ch = s[i] & 255;
            if (ch == 32 || ch == 9) { i = i + 1; }
            else { break; }
        }
        string lead = s.Substring(0, i);
        string rest = s.Substring(i, s.Length - i);
        int tl = tok.Length;
        if (rest.Length >= tl && rest.Substring(0, tl) == tok) {
            rest = rest.Substring(tl, rest.Length - tl);
            if (rest.Length >= 1 && (rest[0] & 255) == 32) {
                rest = rest.Substring(1, rest.Length - 1);
            }
        }
        return lead + rest;
    }
}
