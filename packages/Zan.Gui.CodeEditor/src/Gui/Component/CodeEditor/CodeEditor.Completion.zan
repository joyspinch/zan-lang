using System;
using Gui;

namespace Gui.Component.CodeEditor;

// CodeEditor 分部：自动补全弹窗、符号索引和
// 感知 using 的补全引擎（成员/类型/标识符建议）。
partial class CodeEditor {
    // ---- 自动补全 ----

    // 列表 `xs` 已包含 `v` 时返回 true。
    public static bool Has(List<string> xs, string v) {
        for (int i = 0; i < xs.Count; i = i + 1) {
            if (xs[i] == v) { return true; }
        }
        return false;
    }

    // `s` 以 `pre` 开头时返回 true。按字节比：扫描路径会对每行
    // 调用它，而 Substring 要为每次测试分配一个字符串。
    public static bool StartsWithP(string s, string pre) {
        int n = pre.Length;
        if (n > s.Length) { return false; }
        for (int i = 0; i < n; i = i + 1) {
            if (s[i] != pre[i]) { return false; }
        }
        return true;
    }

    // 把语言关键字追加到 `outk`。
    public static void KeywordList(List<string> outk) {
        string kws = "using namespace class struct enum interface static extern void int string bool float double char long short byte uint new return if else while for foreach do in break continue true false null this base public private protected internal override virtual abstract sealed const readonly var switch case default try catch finally throw is as typeof sizeof ref out params get set operator async await yield from where select orderby group join let into ascending descending on equals when and or not with record init required global file scoped allows value partial event delegate fixed lock checked unchecked unsafe stackalloc nameof";
        int n = kws.Length;
        int i = 0;
        while (i < n) {
            while (i < n && (kws[i] & 255) == 32) { i = i + 1; }
            if (i >= n) { break; }
            int start = i;
            while (i < n && (kws[i] & 255) != 32) { i = i + 1; }
            outk.Add(kws.Substring(start, i - start));
        }
    }

    // 追加常用标准库类型和成员用于补全。
    public static void StdlibList(List<string> outk) {
        string types = "Console List Dictionary StringBuilder String Math File Directory Path Environment Process Convert Array DateTime TimeSpan Task Thread App Canvas Theme Rect Button Label Input Panel Split Modal TreeView CodeEditor Ribbon Icon SignalInt SignalBool SignalString Window TreeNode RibbonCmd HitRegion Point Size";
        string methods = "WriteLine ReadLine Write ToString Add Remove RemoveAt Insert IndexOf Contains Count Length Clear Sort Reverse Join Split Substring Replace Trim StartsWith EndsWith ToUpper ToLower Format Concat Exists ReadAllText WriteAllText CreateDirectory GetFiles GetDirectories Append AppendLine Max Min Abs Round Sqrt Floor Ceiling Pow Parse TryParse GetText LoadText Render Create SetText";
        string snippets = "Program Main InitializeComponent EventArgs Dispose Override";
        string all = types + " " + methods + " " + snippets;
        int n = all.Length;
        int i = 0;
        while (i < n) {
            while (i < n && (all[i] & 255) == 32) { i = i + 1; }
            if (i >= n) { break; }
            int start = i;
            while (i < n && (all[i] & 255) != 32) { i = i + 1; }
            string w = all.Substring(start, i - start);
            if (!CodeEditor.Has(outk, w)) { outk.Add(w); }
        }
    }

    // 收集缓冲区中出现的唯一标识符 token（长度 >= 2），
    // 使编辑器能补全用户已输入过的符号。
    public static void CollectWords(List<string> ls, List<string> outw) {
        CodeEditor.CollectWordsRange(ls, 0, ls.Count, outw);
    }

    // 同上，但只扫描 [from, to) 区间。两处写法差异都是为了让代价
    // 与规模无关：逐字节推进并且整词只分配一次字符串（原来每个字符
    // 一个 Substring 再逐字符拼接），去重走哈希表（原来对已收集的词
    // 线性查找，于是一次收集是 词数×字符数 的平方级）。
    public static void CollectWordsRange(List<string> ls, int from, int to,
                                  List<string> outw) {
        Dict<string, bool> seen = new Dict<string, bool>();
        for (int i = 0; i < outw.Count; i = i + 1) {
            if (!seen.ContainsKey(outw[i])) { seen.Add(outw[i], true); }
        }
        if (from < 0) { from = 0; }
        if (to > ls.Count) { to = ls.Count; }
        for (int li = from; li < to; li = li + 1) {
            string line = ls[li];
            int n = line.Length;
            int i = 0;
            while (i < n) {
                int ch = line[i];
                bool digit = ch >= 48 && ch <= 57;
                if (CodeEditor.IdentByte(ch) && !digit) {
                    int s = i;
                    while (i < n && CodeEditor.IdentByte(line[i])) { i = i + 1; }
                    if (i - s >= 2) {
                        string w = line.Substring(s, i - s);
                        if (!seen.ContainsKey(w)) {
                            seen.Add(w, true);
                            outw.Add(w);
                        }
                    }
                } else {
                    i = i + 1;
                }
            }
        }
    }

    void CaptureCompletionSource() {
        acSourceText = GetText();
        acSourceVersion = TextStamp();
        acSourcePath = documentPath;
        acSourceLine = curLine;
        acSourceCol = curCol;
    }

    bool CompletionSourceCurrent() {
        return documentPath == acSourcePath && TextStamp() == acSourceVersion
            && curLine == acSourceLine && curCol == acSourceCol && GetText() == acSourceText;
    }

    // 从候选实体重建当前种类过滤器的可见列表并更新弹窗状态。
    void ApplyKindFilter() {
        // 字符串或注释内绝对不弹窗
        if (InStringOrCommentContext()) {
            acActive = false;
            acDot = false;
            acAllCandidates = new List<CeCandidateItem>();
            acItems = new List<string>();
            return;
        }
        // 切换过滤器不能把旧候选的编辑范围重新标记为当前文档。
        if (!CompletionSourceCurrent()) { acActive = false; acDot = false; return; }
        acItems = new List<string>();
        acKinds = new List<string>();
        acVisibleCandidates = new List<CeCandidateItem>();
        int i = 0;
        for (; i < acAllCandidates.Count; i = i + 1) {
            CeCandidateItem cand = acAllCandidates[i];
            string k = cand.kind;
            bool keep = acFilter == "" || acFilter == k;
            // 片段选择器模式只留片段：这是 VS「插入代码片段...」
            // 的口径——列表里只有片段，不掺符号与关键字。
            if (acSnippetOnly && k != "S") { keep = false; }
            if (keep) {
                acVisibleCandidates.Add(cand);
                acItems.Add(cand.item);
                acKinds.Add(k);
            }
        }
        if (acItems.Count == 0 && acAllCandidates.Count > 0 && !acSnippetOnly) {
            // 用户保留的种类过滤器对正在输入的字词没有候选项，
            // 保留它只会显示空弹窗（且 Enter/Tab
            // 会接受并不存在的行），因此丢弃该过滤器。
            acFilter = "";
            i = 0;
            while (i < acAllCandidates.Count) {
                CeCandidateItem cand = acAllCandidates[i];
                acVisibleCandidates.Add(cand);
                acItems.Add(cand.item);
                acKinds.Add(cand.kind);
                i = i + 1;
            }
        }
        if (acItems.Count > 0) {
            acActive = true;
            if (acSel >= acItems.Count) { acSel = acItems.Count - 1; }
            if (acSel < 0) { acSel = 0; }
        } else {
            acActive = false;
            acFilter = "";
        }
    }

    // 未过滤的候选列表至少包含一个
    // 指定种类条目时返回 true（用于灰显不可用的过滤按钮）。
    bool HasKind(string kind) {
        for (int i = 0; i < acAllCandidates.Count; i = i + 1) {
            if (acAllCandidates[i].kind == kind) { return true; }
        }
        return false;
    }

    // 根据光标左侧紧邻的字词重新计算补全弹窗；
    // 无前缀或无候选项时关闭弹窗。

    // 即使尚未输入前缀。若处于字符串或注释内则绝对不打开。
    void ForceCompletion() {
        if (InStringOrCommentContext()) { return; }
        acDot = false;
        acActive = true;
        acForced = true;
        string line = lines[curLine];
        int start = curCol;
        while (start > 0 && CodeEditor.IsIdentByte(line[start - 1] & 255)) { start = start - 1; }
        if (start > 0 && (line[start - 1] & 255) == 46) { DotCompletion(); }
        else { UpdateCompletion(); }
        acForced = false;
    }

    int SemanticCompletionToken() {
        return semanticCompletionIntent != null ? semanticCompletionIntent.token : -1;
    }

    void CancelSemanticCompletion() {
        semanticCompletionEpoch = semanticCompletionEpoch + 1;
        semanticCompletionIntent = null;
    }

    void ClearSemanticTextMemos() {
        hoverLspMemo = null;
        signatureLspMemo = null;
        sigDocLspMemo = null;
        sigMemoName = "";
        sigMemoStamp = -1;
        hoverTip = null;
        // 重载列表也属于语义缓存：换提供者后不能拿旧列表继续翻。
        sigOverloads = null;
        sigOverloadCallee = "";
        sigOverloadStamp = -1;
        sigOverloadPath = "";
        sigPinnedCallee = "";
        sigOverloadIndex = 0;
    }

    void ResetSemanticProviders() {
        CancelSemanticCompletion();
        ClearSemanticTextMemos();
        acActive = false;
        acDot = false;
    }

    CodeSemanticProviderLease AcquireSemanticProviders() {
        ResetSemanticProviders();
        semanticProviderLease = new CodeSemanticProviderLease();
        return semanticProviderLease;
    }

    bool SemanticProvidersCurrent(CodeSemanticProviderLease lease) {
        return lease != null && semanticProviderLease == lease;
    }

    // 只有仍有效的请求意图能刷新弹窗；无本地候选也保留 dot/forced 意图。
    bool RefreshSemanticResult(string method, string path, int stamp, int line,
        int col, string name, int token) {
        if (documentPath != path || TextStamp() != stamp) { return false; }
        if (method == "textDocument/completion") {
            CeSemanticCompletionIntent intent = semanticCompletionIntent;
            if (intent == null || intent.token != token || intent.path != path
                || intent.stamp != stamp || intent.line != curLine || intent.col != curCol
                || line != curLine || col != curCol) { return false; }
            acDot = intent.dot;
            acForced = intent.forced;
            acStart = intent.start;
            UpdateCompletion();
            acForced = false;
            return true;
        }
        return ClearSemanticTextMemo(method, path, stamp, line, col, name);
    }

    bool ClearSemanticTextMemo(string method, string path, int stamp, int line,
        int col, string name) {
        if (method == "textDocument/hover" && hoverLspMemo != null
            && hoverLspMemo.Matches(path, stamp, line, col, name)) {
            hoverLspMemo = null;
            hoverTip = null;
            return true;
        }
        if (method == "textDocument/signatureHelp" && signatureLspMemo != null
            && signatureLspMemo.Matches(path, stamp, line, col, name)) {
            signatureLspMemo = null;
            sigDocLspMemo = null;
            sigMemoName = "";
            sigMemoStamp = -1;
            return true;
        }
        return false;
    }

    bool ScoreExternalCompletion(string prefix, Dict<string, bool> taken, List<int> scores) {
        if (!acForced && InStringOrCommentContext()) { return false; }
        if (externalCompletion == null || documentPath.Length == 0) { return true; }
        string source = "";
        int version = TextStamp();
        string path = documentPath;
        int line = curLine;
        int col = curCol;
        semanticCompletionEpoch = semanticCompletionEpoch + 1;
        CeSemanticCompletionIntent intent = new CeSemanticCompletionIntent();
        intent.token = semanticCompletionEpoch;
        intent.path = path;
        intent.text = source;
        intent.stamp = version;
        intent.line = line;
        intent.col = col;
        intent.start = acStart;
        intent.dot = acDot;
        intent.forced = acForced;
        semanticCompletionIntent = intent;
        List<CodeCompletionItem> items = externalCompletion(path, line, col);
        // 提供者允许泵事件；返回时文档或光标改变就不能应用旧范围。
        if (semanticCompletionIntent != intent || documentPath != path || TextStamp() != version
            || curLine != line || curCol != col) { return false; }
        if (items == null) { return true; }
        for (int i = 0; i < items.Count; i = i + 1) {
            CodeCompletionItem item = items[i];
            int score = CodeEditor.MatchScore(item.label, prefix);
            if (score < 0 || taken.ContainsKey(item.label)) { continue; }
            taken[item.label] = true;
            string kind = item.kind.Length > 0 ? item.kind : "M";
            CeCandidateItem candidate = new CeCandidateItem(item.label, kind);
            candidate.semantic = item;
            acAllCandidates.Add(candidate);
            // 语义项同样按种类分层，并整体领先本地候选 1000 分：
            // 它带着类型推导与参数详情，同一类里应当先于本地启发式项。
            scores.Add(score + CodeEditor.KindWeight(kind) + 1000);
        }
        return true;
    }

    // 重算补全候选：点号模式按已输前缀过滤完整成员列表；常规模式
    // 收集光标前的字词前缀，把基础候选表（特性上下文只给
    // DllImport/StructLayout）与周边词按匹配度打分合并，排序后截断
    // 再套种类过滤。无候选时收起弹窗。
    void UpdateCompletion() {
        CancelSemanticCompletion();
        CaptureCompletionSource();
        // 弹窗已经关掉了：片段选择器模式随之结束（否则之后的打字
        // 会一直只列片段，看起来像补全坏了）。
        if (!acActive) { acSnippetOnly = false; }

        // 字符串字面量或行注释内不弹自动补全，避免干扰文本录入
        if (!acForced && InStringOrCommentContext()) {
            acActive = false;
            acDot = false;
            acAllCandidates = new List<CeCandidateItem>();
            acItems = new List<string>();
            acKinds = new List<string>();
            CancelSemanticCompletion();
            return;
        }

        string ln = lines[curLine];

        // 若处于点号模式，按输入的前缀过滤完整成员列表
        if (acDot) {
            if (acStart > curCol || acStart < 0) { acActive = false; acDot = false; return; }
            string prefix = ln.Substring(acStart, curCol - acStart);
            acAllCandidates = new List<CeCandidateItem>();
            List<int> dscores = new List<int>();
            Dict<string, bool> taken = new Dict<string, bool>();

            // 1. 优先补充外部 LSP 语义补全项（精确、带类型推导与参数详情）
            if (!ScoreExternalCompletion(prefix, taken, dscores)) { acActive = false; return; }

            // 2. 用本地已知的原生成员作为补充与兜底，去重合并
            for (int fi = 0; fi < acFull.Count; fi = fi + 1) {
                string mName = acFull[fi];
                if (taken.ContainsKey(mName)) { continue; }
                int sc = CodeEditor.MatchScore(mName, prefix);
                if (sc >= 0) {
                    taken[mName] = true;
                    acAllCandidates.Add(new CeCandidateItem(mName, CodeEditor.MemberKind(mName)));
                    dscores.Add(sc + CodeEditor.KindWeight(CodeEditor.MemberKind(mName)) + 500); // 兜底候选项
                }
            }

            if (acAllCandidates.Count == 0) { acActive = false; acDot = false; return; }
            CodeEditor.SortCandidatesByScore(acAllCandidates, dscores);
            acSel = 0;
            ApplyKindFilter();
            return;
        }

        // 片段选择器模式（右键「插入代码片段...」）：列表里只有片段。
        // 首次打开列出全部片段；之后用户输入的字符当作片段名的
        // 过滤前缀（VS 的「插入代码片段」对话框就是这个手感）。
        if (acSnippetOnly) {
            acAllCandidates = new List<CeCandidateItem>();
            List<string> sItems = new List<string>();
            List<string> sKinds = new List<string>();
            CodeEditor.SnippetListK(sItems, sKinds);
            string sPfx = "";
            if (acForced) {
                // 刚打开：插入点固定在光标处，不吞掉光标前的字词。
                acStart = curCol;
            } else {
                int sSt = curCol;
                while (sSt > 0 && CodeEditor.IsIdentByte(ln[sSt - 1] & 255)) {
                    sSt = sSt - 1;
                }
                acStart = sSt;
                sPfx = ln.Substring(sSt, curCol - sSt);
            }
            for (int si = 0; si < sItems.Count; si = si + 1) {
                if (sPfx.Length > 0 && !CodeEditor.StartsWithI(sItems[si], sPfx)) {
                    continue;
                }
                acAllCandidates.Add(new CeCandidateItem(sItems[si], sKinds[si]));
            }
            acSel = 0;
            ApplyKindFilter();
            return;
        }

        // 常规字词补全
        int st = curCol;
        while (st > 0 && CodeEditor.IsIdentByte(ln[st - 1] & 255)) {
            st = st - 1;
        }
        acStart = st;
        string pfx = ln.Substring(st, curCol - st);
        if (pfx.Length < 1 && !acForced) { acActive = false; return; }

        List<CeCompletionCandidate> cands;
        List<string> words = new List<string>();
        if (InAttributeContext()) {
            // 在 `[ ... ]` 内：这里只有真正的特性。编译器
            // 只识别 DllImport 和 StructLayout（见 parser.c）。
            cands = new List<CeCompletionCandidate>();
            cands.Add(new CeCompletionCandidate("DllImport", "M"));
            cands.Add(new CeCompletionCandidate("StructLayout", "M"));
        } else {
            EnsureCandBase();
            cands = cbCandidates;
            int radius = CodeEditor.WordScanRadius();
            CodeEditor.CollectWordsRange(lines, curLine - radius,
                                         curLine + radius, words);
        }
        acAllCandidates = new List<CeCandidateItem>();
        List<int> scores = new List<int>();
        Dict<string, bool> taken = new Dict<string, bool>();
        if (!ScoreExternalCompletion(pfx, taken, scores)) { acActive = false; return; }
        ScoreCandidateEntities(cands, pfx, taken, scores);
        ScoreWords(words, "W", pfx, taken, scores);
        if (acAllCandidates.Count == 0) { acActive = false; return; }
        // 排序后保留最优的少数：按收集顺序截断会
        // 在明显候选项扫描较晚时将其丢弃。
        // 没有前缀时是"浏览作用域里有什么"——按种类分配名额，让列表
        // 里各类型混排（否则上千个成员会把类型挤没）；带前缀时按
        // 匹配度给最好的那批，不限名额。
        if (pfx.Length == 0) {
            CodeEditor.SortCandidatesByScoreTopKinds(acAllCandidates, scores, 200, 40);
        } else {
            CodeEditor.SortCandidatesByScoreTop(acAllCandidates, scores, 200);
        }
        acSel = 0;
        ApplyKindFilter();
    }

    // 把实体列表 `cands` 中匹配 `pfx` 的候选追加到弹窗列表（消除平行列表反模式）。
    void ScoreCandidateEntities(List<CeCompletionCandidate> cands,
                                string pfx, Dict<string, bool> taken, List<int> scores) {
        if (cands == null) { return; }
        for (int i = 0; i < cands.Count; i = i + 1) {
            string w = cands[i].item;
            int sc = CodeEditor.MatchScore(w, pfx);
            if (w != pfx && sc >= 0 && !taken.ContainsKey(w)) {
                taken.Add(w, true);
                acAllCandidates.Add(new CeCandidateItem(w, cands[i].kind));
                scores.Add(sc + CodeEditor.KindWeight(cands[i].kind));
            }
        }
    }

    // 把单词列表 `words` 中匹配 `pfx` 的候选追加到弹窗列表，统一赋予 `defKind` 种类。
    void ScoreWords(List<string> words, string defKind,
                    string pfx, Dict<string, bool> taken, List<int> scores) {
        if (words == null) { return; }
        for (int i = 0; i < words.Count; i = i + 1) {
            string w = words[i];
            int sc = CodeEditor.MatchScore(w, pfx);
            if (w != pfx && sc >= 0 && !taken.ContainsKey(w)) {
                taken.Add(w, true);
                acAllCandidates.Add(new CeCandidateItem(w, defKind));
                scores.Add(sc + CodeEditor.KindWeight(defKind));
            }
        }
    }

    // 把 `items` 中匹配 `pfx` 的候选追加到弹窗列表，`taken` 跟踪已入选的
    // 词（多个来源会给出同一个名字）。`kinds` 为 null 时统一用 `defKind`。
    void ScoreCandidates(List<string> items, List<string> kinds, string defKind,
                         string pfx, Dict<string, bool> taken, List<int> scores) {
        for (int i = 0; i < items.Count; i = i + 1) {
            string w = items[i];
            int sc = CodeEditor.MatchScore(w, pfx);
            if (w != pfx && sc >= 0 && !taken.ContainsKey(w)) {
                taken.Add(w, true);
                string k = defKind;
                if (kinds != null && i < kinds.Count) { k = kinds[i]; }
                acAllCandidates.Add(new CeCandidateItem(w, k));
                scores.Add(sc + CodeEditor.KindWeight(k));
            }
        }
    }

    // 补全候选中与光标位置无关的那一半：代码片段、关键字、标准库、
    // 项目类型与成员。它只在项目扫描或缓冲区类型表变化时才会变，而
    // 重建一次要走遍上千个类型和成员，因此跨击键复用。
    void EnsureCandBase() {
        if (analysisApp != null) {
            RequestAnalysis();
            if (cbCandidates == null) { cbCandidates = new List<CeCompletionCandidate>(); }
            return;
        }
        EnsureProjectScan();
        EnsureBufTypes();
        if (cbCandidates != null && cbGen == candBaseGen) { return; }
        List<string> items = new List<string>();
        List<string> kinds = new List<string>();
        // 收集顺序决定同分候选的先后（排序是稳定的）：项目符号先于
        // 标准库，标准库先于关键字与代码片段——工程自己的东西比
        // 通用词更该出现在前面。
        // 代码片段必须排在关键字之前：同名时"片段"标签决定 Tab
        // 是否展开模板（见 AcceptCompletion），调换会让 for/if 失去
        // 模板展开能力。
        AddProjectCandidates(items, kinds);
        AddStdlibCandidates(items, kinds);
        CodeEditor.SnippetListK(items, kinds);
        CodeEditor.KeywordListK(items, kinds);
        cbCandidates = new List<CeCompletionCandidate>();
        for (int i = 0; i < items.Count && i < kinds.Count; i = i + 1) {
            cbCandidates.Add(new CeCompletionCandidate(items[i], kinds[i]));
        }
        cbGen = candBaseGen;
    }

    // 成员名的启发式种类标签：camelCase → 字段，已知名词 →
    // 属性，*Changed/*Click → 事件，否则为方法。

    void AcceptCompletion(bool viaTab) {
        CancelSemanticCompletion();
        if (!acActive) { return; }
        if (acSel < 0 || acSel >= acItems.Count) { acActive = false; return; }
        if (!CompletionSourceCurrent()) { acActive = false; acDot = false; return; }
        CeCandidateItem candidate = acVisibleCandidates[acSel];
        string chosen = candidate.item;
        CodeCompletionItem semantic = candidate.semantic;
        if ((viaTab || acSnippetOnly) && candidate.kind == "S" && semantic == null) {
            // 片段候选：Tab 接受时展开模板；片段选择器里 Enter 也展开
            // （那里的语境就是"插入这段片段"，插触发词没有意义）。
            // 普通补全体里 Enter 仍然只插入触发词——那是既有契约。
            SaveUndo();
            acSnippetOnly = false;
            acActive = false;
            acFilter = "";
            ExpandSnippet(chosen);
            BumpTextVersion();
            return;
        }
        if (semantic != null && semantic.isSnippet) {
            // 语言服务推来的片段：按模板插入，插入后 Tab 在洞之间跳。
            int sL = curLine;
            int sC = acStart;
            int eL = curLine;
            int eC = curCol;
            if (semantic.hasTextEdit) {
                sL = semantic.startLine; sC = semantic.startCol;
                eL = semantic.endLine; eC = semantic.endCol;
            }
            if (sL < 0 || eL < sL || eL >= lines.Count
                || sC < 0 || sC > lines[sL].Length
                || eC < 0 || eC > lines[eL].Length) { acActive = false; return; }
            SaveUndo();
            ClearExtraCarets();
            InsertSnippet(semantic.insertText, sL, sC, eL, eC);
            BumpTextVersion();
            acActive = false;
            acDot = false;
            acFilter = "";
            acSnippetOnly = false;
            CheckErrors();
            return;
        }
        int startLine = curLine;
        int startCol = acStart;
        int endLine = curLine;
        int endCol = curCol;
        if (semantic != null) {
            if (semantic.hasTextEdit || semantic.insertText.Length > 0) { chosen = semantic.insertText; }
            if (semantic.hasTextEdit) {
                startLine = semantic.startLine; startCol = semantic.startCol;
                endLine = semantic.endLine; endCol = semantic.endCol;
            }
        }
        if (startLine < 0 || endLine < startLine || endLine >= lines.Count
            || startCol < 0 || startCol > lines[startLine].Length
            || endCol < 0 || endCol > lines[endLine].Length
            || (startLine == endLine && endCol < startCol)) { acActive = false; return; }
        if (semantic != null && semantic.hasTextEdit) {
            // 编辑范围必须包含请求光标，且不能切断 UTF-8 字符。
            if (startLine > curLine || (startLine == curLine && startCol > curCol)
                || endLine < curLine || (endLine == curLine && endCol < curCol)
                || Text.ClampCharStart(lines[startLine], startCol) != startCol
                || Text.ClampCharStart(lines[endLine], endCol) != endCol) {
                acActive = false; acDot = false; return;
            }
        }
        SaveUndo();
        ClearExtraCarets();
        string left = Text.Left(lines[startLine], startCol);
        string right = Text.Right(lines[endLine], endCol);
        List<string> inserted = CodeEditor.SplitLines(chosen);
        for (int line = endLine; line > startLine; line = line - 1) { lines.RemoveAt(line); }
        lines[startLine] = left + inserted[0];
        for (int i = 1; i < inserted.Count; i = i + 1) { lines.Insert(startLine + i, inserted[i]); }
        curLine = startLine + inserted.Count - 1;
        curCol = inserted.Count == 1 ? left.Length + inserted[0].Length : inserted[inserted.Count - 1].Length;
        lines[curLine] = lines[curLine] + right;
        selActive = false;
        BumpTextVersion();
        acActive = false;
        acDot = false;
        acFilter = "";
        acSnippetOnly = false;
    }

    // 无弹窗时的 Tab 词补全：光标前是标识符前缀且光标不在词中时，
    // 在本地实体与文档词内找以该前缀开头的候选，补到最长公共前缀。
    // 有扩展时插入并返回 true；否则返回 false（调用方回退为缩进空格）。
    // 只用同步来源，不发起语义（LSP）补全请求。
    bool TryCompleteWord() {
        if (carets.Count > 0) { return false; }
        if (curLine < 0 || curLine >= lines.Count) { return false; }
        if (InStringOrCommentContext()) { return false; }
        string ln = lines[curLine];
        if (curCol > ln.Length) { return false; }
        if (curCol < ln.Length && CodeEditor.IsIdentByte(ln[curCol] & 255)) { return false; }
        int st = curCol;
        while (st > 0 && CodeEditor.IsIdentByte(ln[st - 1] & 255)) { st = st - 1; }
        if (st == curCol) { return false; }
        string pfx = ln.Substring(st, curCol - st);
        List<string> labels = new List<string>();
        EnsureCandBase();
        if (cbCandidates != null) {
            for (int i = 0; i < cbCandidates.Count; i = i + 1) {
                string lab = cbCandidates[i].item;
                if (lab.StartsWith(pfx) && lab.Length > pfx.Length) { labels.Add(lab); }
            }
        }
        List<string> words = new List<string>();
        int radius = CodeEditor.WordScanRadius();
        CodeEditor.CollectWordsRange(lines, curLine - radius, curLine + radius, words);
        for (int i = 0; i < words.Count; i = i + 1) {
            if (words[i].StartsWith(pfx) && words[i].Length > pfx.Length) { labels.Add(words[i]); }
        }
        if (labels.Count == 0) { return false; }
        string lcp = labels[0];
        for (int i = 1; i < labels.Count && lcp.Length > pfx.Length; i = i + 1) {
            string other = labels[i];
            int keep = 0;
            int max = lcp.Length < other.Length ? lcp.Length : other.Length;
            while (keep < max && lcp[keep] == other[keep]) { keep = keep + 1; }
            lcp = lcp.Substring(0, keep);
        }
        if (lcp.Length <= pfx.Length) { return false; }
        InsertStr(lcp.Substring(pfx.Length));
        return true;
    }

    // 弹窗当前选中项在已输入前缀之外的行内预测（幽灵文本）；
    // 不适用（无候选、语义 insertText/textEdit、片段、来源过期
    // 或标签不以已输入前缀开头）时返回空。
    string GhostExtension() {
        if (!acActive || acVisibleCandidates == null || acItems == null) { return ""; }
        if (acSel < 0 || acSel >= acItems.Count) { return ""; }
        if (!CompletionSourceCurrent()) { return ""; }
        CeCandidateItem candidate = acVisibleCandidates[acSel];
        if (candidate.semantic != null &&
            (candidate.semantic.hasTextEdit || candidate.semantic.insertText.Length > 0)) {
            return "";
        }
        if (candidate.kind == "S") { return ""; }
        if (acStart < 0 || acStart > curCol || curLine < 0 || curLine >= lines.Count) { return ""; }
        string ln = lines[curLine];
        if (curCol > ln.Length) { return ""; }
        string typed = ln.Substring(acStart, curCol - acStart);
        string label = candidate.item;
        if (label.Length <= typed.Length) { return ""; }
        if (!label.StartsWith(typed)) { return ""; }
        string ext = label.Substring(typed.Length);
        if (ext.Length > 64) { ext = ext.Substring(0, 64); }
        return ext;
    }

    // 紧挨 `dotPos` 处点号之前书写的接收者表达式：
    // `WebApp.Create` 中的 `WebApp`、`app.MaxBody` 中的 `app`，以及链中调用自身的
    // 接收者（`items.Where(x).Select` -> `items`，因为调用的
    // 实参列表会整体跳过）。没有则返回空。
}
