using System;
using Gui;
using Gui.Widget;

namespace Gui.Component;

/// 尾部滚动、可选择的控制台视图**控件**：把 LogView 的滚动与
/// 选择状态包进一个标准 retained 控件，于是声明式界面
/// （.html 设计稿）可以像放 ListView 一样直接声明一个控制台，
/// 宿主只需要绑定行列表。行颜色可选。
class ConsoleView : Control {
    /// 强类型实体行列表（唯一主表示，彻底消除 data/colors 平行列表反模式）。
    List<LogLine> items;
    /// 滚动与选择状态（渲染共用一份，宿主可经 State() 持久化或复位）。
    LogState st;
    /// 无行时居中显示的提示（"" 则不绘制）。
    string Empty;
    /// false 时只绘制，不处理滚轮/选择（嵌入的小日志条）。
    bool live;

    /// 构造空视图：未绑定行，活动模式（滚轮/选择可用）。
    ConsoleView() {
        this.InitControl("console", 5);
        items = new List<LogLine>();
        st = new LogState();
        Empty = "";
        live = true;
    }

    /// 控件类型标识（"ConsoleView"）。
    override string Kind() { return "ConsoleView"; }

    /// 样式类别（沿用 LogView 的 "log"，两者皮肤一致）。
    override string StyleType() { return "log"; }

    /// 强类型实体绑定主入口：绑定调用方的结构化行列表。
    ConsoleView BindItems(List<LogLine> lines) {
        if (lines != null) { items = lines; }
        else { items = new List<LogLine>(); }
        return this;
    }

    /// 绑定调用方的纯文本行列表（自动提升为 LogLine 实体列表）。
    ConsoleView Bind(List<string> lines) {
        items = new List<LogLine>();
        if (lines != null) {
            for (int i = 0; i < lines.Count; i = i + 1) {
                items.Add(LogLine.OfText(lines[i]));
            }
        }
        return this;
    }

    /// 绑定行颜色列表（直接对齐到 LogLine 实体）。
    ConsoleView WithColors(List<int> cols) {
        if (cols != null && items != null) {
            for (int i = 0; i < items.Count && i < cols.Count; i = i + 1) {
                items[i].color = cols[i];
            }
        }
        return this;
    }

    /// 无行时的提示文案（"" 不显示）。
    ConsoleView EmptyText(string text) {
        if (text != null) { Empty = text; }
        return this;
    }

    /// 只读日志条：不接受滚轮与拖拽选择。
    ConsoleView Passive() {
        live = false;
        return this;
    }

    /// 视图的滚动/选择状态，供宿主持久化或复位。
    LogState State() { return st; }

    /// 跳回最新一行并清除选择。
    void Reset() { st.Reset(); }

    /// 当前选中的文本（无选择时为 ""）。
    string SelectedText() {
        if (items == null || items.Count == 0) { return ""; }
        if (!st.HasSelection()) { return ""; }
        return LogView.SelectionTextItems(items, st);
    }

    /// 覆写：设计器属性（空态文案与只读开关；数据经 Bind 在代码侧给）。
    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec emp = PropSpec.Text("empty", "Empty text");
        emp.str = Empty;
        emp.WithTip("Shown centred when there are no lines; \"\" hides it.");
        ps.Add(emp);
        PropSpec lv = PropSpec.Bool("live", "Live");
        lv.flag = live;
        lv.WithTip("Off renders a passive strip: no wheel or drag selection.");
        ps.Add(lv);
        return ps;
    }

    /// 绘制：整体委托给 LogView.RenderItems（含滚轮、尾部滚动与选择）。
    override void OnPaint(App app) {
        List<LogLine> lines = items;
        if (lines == null) { lines = new List<LogLine>(); }
        LogView.RenderItems(app, bx, by, bw, bh, lines, st, Empty, live);
    }
}
