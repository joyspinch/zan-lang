using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// Chart.AxesDraw.zan - 直角坐标系装饰渲染器（网格、分段区域、刻度须、坐标轴线与轴名）
public partial class Chart {
    public static void DrawAxes(App app, ChartFrame f, ChartOption o, List<string> labels) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int fs = ChartFonts.AxisLabel(app);
        int fh = Canvas.FontHeight(fs);
        ChartAxis y0 = o.YAxis0();
        ChartAxis y1 = o.YAxis1();
        ChartAxis x0 = o.XAxis0();
        int plotX = f.plotX;
        int plotY = f.plotY;
        int plotW = f.plotW;
        int plotH = f.plotH;
        int plotBot = plotY + plotH;
        int leftLo = f.leftMin;
        int leftHi = f.leftMax;
        long leftLoF = (long)f.leftMinF;
        long leftHiF = (long)f.leftMaxF;
        int rightLo = f.rightMin;
        int rightHi = f.rightMax;
        long rightLoF = (long)f.rightMinF;
        long rightHiF = (long)f.rightMaxF;
        int xLo = f.xLo;
        int xHi = f.xHi;
        int tMin = f.timeMin;
        int tMax = f.timeMax;
        bool hasRight = f.hasRight;
        bool catY = f.catY;
        bool leftLog = f.leftLog;
        bool rightLog = f.rightLog;
        bool isTime = f.isTime;
        int leftTickLo = f.leftTickLo;
        int leftTickHi = f.leftTickHi;
        int rightTickLo = f.rightTickLo;
        int rightTickHi = f.rightTickHi;
        int xTickLo = f.xTickLo;
        int xTickHi = f.xTickHi;
        int ticks = f.ticks;
        int rt = f.rt;
        int xt = f.xt;
        bool leftFrac = f.leftFrac;
        bool rightFrac = f.rightFrac;

        bool y0IsVL = y0.type == ChartAxisType.Value || leftLog;
        bool x0IsVL = x0.type == ChartAxisType.Value || isTime || catY;
        bool x0Line = x0.show && Chart.AxisLineDraws(x0.axisLineShow, y0IsVL);
        bool y0Line = y0.show && Chart.AxisLineDraws(y0.axisLineShow, x0IsVL);
        bool y1Line = hasRight && y1.show && Chart.AxisLineDraws(y1.axisLineShow, x0IsVL);
        bool x0RidesY0 = Chart.CanOnZeroTo(y0, leftLo, leftHi, x0.onZero);
        bool x0RidesY1 = false;
        if (!x0RidesY0 && hasRight && o.yAxes.Count > 1) {
            x0RidesY1 = Chart.CanOnZeroTo(y1, rightLo, rightHi, x0.onZero);
        }
        bool y0RidesX0 = Chart.CanOnZeroTo(x0, xLo, xHi, y0.onZero);
        bool y1RidesX0 = false;
        if (!y0RidesX0 && hasRight && o.yAxes.Count > 1) {
            y1RidesX0 = Chart.CanOnZeroTo(x0, xLo, xHi, y1.onZero);
        }
        bool xValue = catY || x0.type == ChartAxisType.Value;

        // 网格线 + 左右数值标签（对数轴用 10 的幂刻度）
        StyleBox sGrid = Style.Part(app, "chart", "grid", "", "", "",
                                    Style.SNormal());
        StyleBox sAxis = Style.Part(app, "chart", "axis", "", "", "",
                                    Style.SNormal());
        StyleBox sAxisTitle = Style.Part(app, "chart", "axis-title", "", "",
                                         "", Style.SNormal());
        bool grid = o.showGrid && y0.showGrid;
        // splitLine.lineStyle.color 显式值压过主题网格色（轴上未声明
        // splitColor=0 时随皮肤 chart::grid，6.1 官方缺省 #dbdee4）。
        int gridColY = y0.splitColor != 0 ? y0.splitColor : sGrid.BgOr(0);
        int gridColX = x0.splitColor != 0 ? x0.splitColor : sGrid.BgOr(0);
        // axisLabel.margin：标签与轴线的像素距离（官方缺省 8）。此前
        // 写死 6/4，bump-chart 声明的 30 从未生效，左轴数字被 r=10
        // 的拐点符号圈盖住只剩 "#"。
        int yMargL = app.Scale(y0.labelMargin > 0 ? y0.labelMargin : 8);
        int yMargR = app.Scale(y1.labelMargin > 0 ? y1.labelMargin : 8);
        int xMarg = app.Scale(x0.labelMargin > 0 ? x0.labelMargin : 8);
        // ECharts axis.show：false 时整条轴（线/刻度/标签）不画，
        // 网格线仍随 splitLine 语义保留。
        bool y0Show = y0.show;
        bool x0Show = x0.show;
        // ECharts splitArea.show：相邻刻度交替底纹。数值轴默认关，
        // 引擎字段随现代标准默认 false，按轴显式配置打开。
        // 对白底取 3%/5.5% 黑的 alpha 叠加，视觉即参照站的
        // #F7F7F7/#F2F2F2。类目 Y（轴互换）与对数轴不画。
        if (grid && y0.splitArea && !catY && !leftLog
            && y0.type == ChartAxisType.Value
            && plotW > 0 && plotH > 0) {
            int sSpan = leftTickHi - leftTickLo;
            for (int sk = 0; sk < ticks; sk = sk + 1) {
                int sLo = leftTickLo + sSpan * sk / ticks;
                int sHi = leftTickLo + sSpan * (sk + 1) / ticks;
                int syTop = f.YOf(sHi, 0);
                int syBot = f.YOf(sLo, 0);
                if (syBot <= syTop) { continue; }
                c.FillRect(plotX, syTop, plotW, syBot - syTop,
                    sk % 2 == 0 ? 0x08000000 : 0x0E000000);
            }
        }
        // 薄面板（多 grid 成交量条带这类）：刻度行距小于一行字高
        // 时标签隔行画（网格线照画），避免上下叠字糊成一团。
        int yLblStep = 1;
        if (plotH < (ticks + 1) * (fh + app.Scale(4))) { yLblStep = 2; }
        int y0Col = y0.labelColor != 0 ? y0.labelColor : sAxis.FgOr(0);
        int xLineY = plotY + plotH;
        if (x0RidesY0) { xLineY = f.ZeroLineY(0); }
        else if (x0RidesY1) { xLineY = f.ZeroLineY(1); }
        int yLineX = plotX;
        if (y0.offset != 0) { yLineX = y0.position == "right" ? plotX + plotW + app.Scale(y0.offset) : plotX - app.Scale(y0.offset); }
        else if (y0RidesX0) { yLineX = f.ZeroLineX(); }
        int y1LineX = plotX + plotW;
        if (y1.offset != 0) { y1LineX = plotX + plotW + app.Scale(y1.offset); }
        else if (y1RidesX0) { y1LineX = f.ZeroLineX(); }
        if (catY) {
            // 类目 Y（轴互换）：水平网格线 + 槽中类目标签。
            int cn = y0.categories.Count;
            for (int ci = 0; ci < cn; ci = ci + 1) {
                int gy = f.CatMidY(ci, cn);
                if (grid) { c.FillRect(plotX, gy, plotW, 1, gridColY); }
                if (!y0Show) { continue; }
                string ls = y0.categories[ci];
                if (y0.labelFormatter.Length > 0) { ls = y0.labelFormatter.Replace("{value}", ls); }
                int lw = Canvas.MeasureText(ls, fs);
                int rlx0 = y0.labelInside ? plotX + yMargL : plotX - yMargL - lw;
                c.DrawText(rlx0, Canvas.CenterTextYAt(gy, fs),
                    ls, y0Col, fs);
            }
        } else if (leftLog && leftFrac && (leftLoF != 0 || leftHiF != 0)) {
            // 对数轴（小数域）：十进位枚举（‰ 域 ×10 递进），
            // FracText 出 0.001/0.01/1/10000 这类标签。
            long lvF = leftLoF;
            while (lvF <= leftHiF) {
                int gy = f.YOfLogF(lvF, 0);
                if (grid) { c.FillRect(plotX, gy, plotW, 1, gridColY); }
                if (y0Show) {
                    string ls = Chart.LogFracText(lvF);
                    if (y0.labelFormatter.Length > 0) { ls = y0.labelFormatter.Replace("{value}", ls); }
                    int lw = Canvas.MeasureText(ls, fs);
                    int rlx0 = y0.labelInside ? plotX + yMargL : plotX - yMargL - lw;
                    c.DrawText(rlx0, Canvas.CenterTextYAt(gy, fs),
                        ls, y0Col, fs);
                }
                lvF = lvF * 10L;
            }
        } else if (leftLog) {
            List<int> lts = Chart.LogTicks(leftLo, leftHi);
            for (int li = 0; li < lts.Count; li = li + 1) {
                int lv = lts[li];
                int gy = f.YOfLog(lv, 0);
                if (grid) { c.FillRect(plotX, gy, plotW, 1, gridColY); }
                if (!y0Show) { continue; }
                string ls = Convert.ToString(lv);
                if (leftLog) { ls = Chart.Commas(lv); }
                int lw = Canvas.MeasureText(ls, fs);
                int rlx0 = y0.labelInside ? plotX + yMargL : plotX - yMargL - lw;
                c.DrawText(rlx0, Canvas.CenterTextYAt(gy, fs),
                    ls, y0Col, fs);
            }
        } else if (leftFrac) {
            // 小数轴刻度：×1000 定点域等分，标签 FracText 除回
            // （0..500000 定点 5 段 → 0/100/…/500）。
            int leftSpanF = leftHiF - leftLoF;
            for (int k = 0; k <= ticks; k = k + 1) {
                int lvF = leftLoF + leftSpanF * k / ticks;
                int gy = f.YOfF(lvF, 0);
                if (grid) { c.FillRect(plotX, gy, plotW, 1, gridColY); }
                if (!y0Show || k % yLblStep != 0) { continue; }
                string ls = Chart.FracText(y0.labelNegate ? 0 - lvF : lvF);
                if (y0.labelFormatter.Length > 0) { ls = y0.labelFormatter.Replace("{value}", ls); }
                int lw = Canvas.MeasureText(ls, fs);
                int rlx0 = y0.labelInside ? plotX + yMargL : plotX - yMargL - lw;
                c.DrawText(rlx0, Canvas.CenterTextYAt(gy, fs),
                    ls, y0Col, fs);
            }
        } else {
            // 刻度取 Tick 副本（nice 端点）：映射范围留白外扩后，
            // 网格/标签仍落在整数 nice 值上，端格线悬在绘图区内侧。
            // A15：该轴挂断带时刻度表换成 BrkTicks（区间倍数 + 跳断带 +
            // 断带端点对 + 3/4·interval 剪除），像素走 elapsed 映射；
            // interval 按 elapsed 跨度 / ticks 取整十倍档（nice 的近似，
            // 官方 bar-breaks-simple 得 3000、gap0 demo 得 300 同档）。
            if (f.BrkHas(0)) {
                // interval 优先取量程阶段 BrkNiceExtent 存的 brkIvL；
                // 未存（固定 min/max 等旁路）才按当前 elapsed 跨度现算，
                // 取整档与官方 nice ROUND 一致：1/2/3/5/10（阈值
                // 1.5/2.5/4/7），不是无断轴路径的 1/2/5。
                double iv = f.brkIvL;
                if (iv <= 0.0) {
                    double eLo = Chart.BrkElapsed(f.brkL, f.brkGapL, (double)leftTickLo);
                    double eHi = Chart.BrkElapsed(f.brkL, f.brkGapL, (double)leftTickHi);
                    double eSpan = eHi - eLo;
                    if (eSpan < 1.0) { eSpan = 1.0; }
                    iv = eSpan / (ticks > 0 ? (double)ticks : 5.0);
                    double mag = 1.0;
                    while (mag * 10.0 <= iv) { mag = mag * 10.0; }
                    double m = iv / mag;
                    if (m < 1.5) { iv = mag; }
                    else if (m < 2.5) { iv = 2.0 * mag; }
                    else if (m < 4.0) { iv = 3.0 * mag; }
                    else if (m < 7.0) { iv = 5.0 * mag; }
                    else { iv = 10.0 * mag; }
                    if (iv < 1.0) { iv = 1.0; }
                }
                List<double> bts = Chart.BrkTicks(f.brkL, f.brkGapL,
                    (double)leftTickLo, (double)leftTickHi, iv);
                for (int k = 0; k < bts.Count; k = k + 1) {
                    double lvb = bts[k];
                    int lvi = (int)Math.Round(lvb);
                    int gy = f.YOfBrk(lvb, 0);
                    if (grid) { c.FillRect(plotX, gy, plotW, 1, gridColY); }
                    if (!y0Show) { continue; }
                    string ls = Chart.Commas(y0.labelNegate ? 0 - lvi : lvi);
                    if (y0.labelFormatter.Length > 0) { ls = y0.labelFormatter.Replace("{value}", ls); }
                    int lw = Canvas.MeasureText(ls, fs);
                    int rlx0 = y0.labelInside ? plotX + yMargL : plotX - yMargL - lw;
                    c.DrawText(rlx0, Canvas.CenterTextYAt(gy, fs),
                        ls, y0Col, fs);
                }
            } else {
            int leftSpan = leftTickHi - leftTickLo;
            for (int k = 0; k <= ticks; k = k + 1) {
                int lv = leftTickLo + leftSpan * k / ticks;
                int gy = f.YOf(lv, 0);
                if (grid) { c.FillRect(plotX, gy, plotW, 1, gridColY); }
                if (!y0Show || k % yLblStep != 0) { continue; }
                string ls = Chart.Commas(y0.labelNegate ? 0 - lv : lv);
                if (y0.labelFormatter.Length > 0) { ls = y0.labelFormatter.Replace("{value}", ls); }
                int lw = Canvas.MeasureText(ls, fs);
                int rlx0 = y0.labelInside ? plotX + yMargL : plotX - yMargL - lw;
                c.DrawText(rlx0, Canvas.CenterTextYAt(gy, fs),
                    ls, y0Col, fs);
            }
            }
        }
        // ---- A12 minorSplitLine（CartesianAxisView.ts:170-200）----
        // 细分网格线：每两个 nice 刻度之间 splitNumber 等分处画一条
        // 横线（数值轴）。颜色走 chart::minor-grid，缺省回落主网格色。
        // 类目轴不支持（Axis.ts:204 isOrdinalScale 直接返回空）。
        if (grid && (y0.minorSplitLineShow || (hasRight && y1.minorSplitLineShow))) {
            StyleBox sMinor = Style.Part(app, "chart", "minor-grid", "", "", "",
                                        Style.SNormal());
            int mcol = sMinor.BgOr(0) != 0 ? sMinor.BgOr(0) : sGrid.BgOr(0);
            if (y0.minorSplitLineShow && !catY && leftLog) {
                // 对数轴：刻度非等距，逐对插值
                // （minorTicks.ts:41-63），投影走
                // YOfLogF 的定点对数轴。
                if (leftFrac && (leftLoF != 0 || leftHiF != 0)) {
                    // 小数域：每十进位内按 splitNumber 线性插值。
                    long dF = leftLoF;
                    while (dF < leftHiF) {
                        long dF10 = dF * 10L;
                        for (int mk = 1; mk < y0.minorTickSplitNumber; mk = mk + 1) {
                            long mf = dF + (dF10 - dF) * mk / y0.minorTickSplitNumber;
                            if (mf >= leftHiF) { break; }
                            c.FillRect(plotX, f.YOfLogF(mf, 0), plotW, 1, mcol);
                        }
                        dF = dF10;
                    }
                } else {
                    List<int> ltsM = Chart.LogTicks(leftLo, leftHi);
                    List<double> mtsL = new List<double>();
                    Chart.MinorTickValuesPairs(ltsM, y0.minorTickSplitNumber, mtsL);
                    for (int mi = 0; mi < mtsL.Count; mi = mi + 1) {
                        long mf = (long)(mtsL[mi] * 1000.0 + 0.5);
                        c.FillRect(plotX, f.YOfLogF(mf, 0), plotW, 1, mcol);
                    }
                }
            }
            if (y0.minorSplitLineShow && !catY && !leftLog
                && y0.type == ChartAxisType.Value && ticks > 0) {
                List<double> mts = new List<double>();
                if (leftFrac) {
                    Chart.MinorTickValues((double)leftLoF, (double)leftHiF, ticks,
                        y0.minorTickSplitNumber, mts);
                    for (int mi = 0; mi < mts.Count; mi = mi + 1) {
                        int gy = f.YOfF((int)(mts[mi] + 0.5), 0);
                        c.FillRect(plotX, gy, plotW, 1, mcol);
                    }
                } else {
                    Chart.MinorTickValues((double)leftTickLo, (double)leftTickHi, ticks,
                        y0.minorTickSplitNumber, mts);
                    for (int mi = 0; mi < mts.Count; mi = mi + 1) {
                        int gy = f.YOf((int)(mts[mi] + 0.5), 0);
                        c.FillRect(plotX, gy, plotW, 1, mcol);
                    }
                }
            }
            if (hasRight && y1.minorSplitLineShow && !rightLog
                && y1.type == ChartAxisType.Value && rt > 0) {
                List<double> mts = new List<double>();
                if (rightFrac) {
                    Chart.MinorTickValues((double)rightLoF, (double)rightHiF, rt,
                        y1.minorTickSplitNumber, mts);
                    for (int mi = 0; mi < mts.Count; mi = mi + 1) {
                        int gy = f.YOfF((int)(mts[mi] + 0.5), 1);
                        c.FillRect(plotX, gy, plotW, 1, mcol);
                    }
                } else {
                    Chart.MinorTickValues((double)rightTickLo, (double)rightTickHi, rt,
                        y1.minorTickSplitNumber, mts);
                    for (int mi = 0; mi < mts.Count; mi = mi + 1) {
                        int gy = f.YOf((int)(mts[mi] + 0.5), 1);
                        c.FillRect(plotX, gy, plotW, 1, mcol);
                    }
                }
            }
        }
        if (hasRight) {
            int y1Col = y1.labelColor != 0 ? y1.labelColor : sAxis.FgOr(0);
            if (rightLog) {
                List<int> rts = Chart.LogTicks(rightLo, rightHi);
                for (int ri = 0; ri < rts.Count; ri = ri + 1) {
                    int rv = rts[ri];
                    int gy = f.YOfLog(rv, 1);
                    string rs = Chart.Commas(rv);
                    int lw = Canvas.MeasureText(rs, fs);
                    int rlx = y1.labelInside ? y1LineX - yMargR - lw : y1LineX + yMargR;
                    c.DrawText(rlx, Canvas.CenterTextYAt(gy, fs),
                        rs, y1Col, fs);
                }
            } else if (rightFrac) {
                int rightSpanF = rightHiF - rightLoF;
                for (int k = 0; k <= rt; k = k + 1) {
                    int rvF = rightLoF + rightSpanF * k / rt;
                    int gy = f.YOfF(rvF, 1);
                    if (grid) { c.FillRect(plotX, gy, plotW, 1, gridColY); }
                    if (k % yLblStep != 0) { continue; }
                    string rs = Chart.FracText(y1.labelNegate ? 0 - rvF : rvF);
                    if (y1.labelFormatter.Length > 0) { rs = y1.labelFormatter.Replace("{value}", rs); }
                    int lw = Canvas.MeasureText(rs, fs);
                    int rlx = y1.labelInside ? y1LineX - yMargR - lw : y1LineX + yMargR;
                    c.DrawText(rlx, Canvas.CenterTextYAt(gy, fs),
                        rs, y1Col, fs);
                }
            } else if (f.BrkHas(1)) {
                // A15：右值轴挂断带——与左轴同构：interval 优先取量程
                // 阶段的 brkIvR，未存才现算；取整档与官方 nice ROUND
                // 一致（1/2/3/5/10，阈值 1.5/2.5/4/7）。
                double iv = f.brkIvR;
                if (iv <= 0.0) {
                    double eLo = Chart.BrkElapsed(f.brkR, f.brkGapR, (double)rightTickLo);
                    double eHi = Chart.BrkElapsed(f.brkR, f.brkGapR, (double)rightTickHi);
                    double eSpan = eHi - eLo;
                    if (eSpan < 1.0) { eSpan = 1.0; }
                    iv = eSpan / (rt > 0 ? (double)rt : 5.0);
                    double mag = 1.0;
                    while (mag * 10.0 <= iv) { mag = mag * 10.0; }
                    double m2 = iv / mag;
                    if (m2 < 1.5) { iv = mag; }
                    else if (m2 < 2.5) { iv = 2.0 * mag; }
                    else if (m2 < 4.0) { iv = 3.0 * mag; }
                    else if (m2 < 7.0) { iv = 5.0 * mag; }
                    else { iv = 10.0 * mag; }
                    if (iv < 1.0) { iv = 1.0; }
                }
                List<double> bts = Chart.BrkTicks(f.brkR, f.brkGapR,
                    (double)rightTickLo, (double)rightTickHi, iv);
                for (int k = 0; k < bts.Count; k = k + 1) {
                    double rvb = bts[k];
                    int rvi = (int)Math.Round(rvb);
                    int gy = f.YOfBrk(rvb, 1);
                    if (grid) { c.FillRect(plotX, gy, plotW, 1, gridColY); }
                    string rs = Chart.Commas(y1.labelNegate ? 0 - rvi : rvi);
                    if (y1.labelFormatter.Length > 0) { rs = y1.labelFormatter.Replace("{value}", rs); }
                    int lw = Canvas.MeasureText(rs, fs);
                    int rlx = y1.labelInside ? y1LineX - yMargR - lw : y1LineX + yMargR;
                    c.DrawText(rlx, Canvas.CenterTextYAt(gy, fs),
                        rs, y1Col, fs);
                }
            } else {
                int rightSpan = rightTickHi - rightTickLo;
                for (int k = 0; k <= rt; k = k + 1) {
                    int rv = rightTickLo + rightSpan * k / rt;
                    int gy = f.YOf(rv, 1);
                    if (k % yLblStep != 0) { continue; }
                    string rs = Chart.Commas(y1.labelNegate ? 0 - rv : rv);
                    if (y1.labelFormatter.Length > 0) { rs = y1.labelFormatter.Replace("{value}", rs); }
                    int lw = Canvas.MeasureText(rs, fs);
                    int rlx = y1.labelInside ? y1LineX - yMargR - lw : y1LineX + yMargR;
                    c.DrawText(rlx, Canvas.CenterTextYAt(gy, fs),
                        rs, y1Col, fs);
                }
            }
        }
        if (y0Line) {
            int ylcol = y0.axisLineColor != 0 ? y0.axisLineColor : sAxis.BgOr(0);
            if (f.BrkHas(0)) {
                Chart.DrawAxisLineBands(c, yLineX, plotY, plotH, true,
                    app.Scale(2), ylcol, Chart.BrkPixelBands(f, 0));
            } else {
                c.FillRect(yLineX, plotY, app.Scale(2), plotH, ylcol);
            }
        }
        // Y0 轴刻度须（axisTick）
        if (y0.axisTickShow && y0.show) {
            int ytlen = y0.axisTickLength > 0 ? app.Scale(y0.axisTickLength) : app.Scale(5);
            int yth = y0.axisTickWidth > 0 ? app.Scale(y0.axisTickWidth) : 1;
            int ytcol = y0.axisTickColor != 0 ? y0.axisTickColor : (y0.axisLineColor != 0 ? y0.axisLineColor : sAxis.BgOr(0));
            int ytx0 = y0.axisTickInside ? yLineX : yLineX - ytlen;
            if (!catY) {
                int leftSpan = leftTickHi - leftTickLo;
                for (int k = 0; k <= ticks; k = k + 1) {
                    int lv = leftTickLo + leftSpan * k / ticks;
                    int gy = f.YOf(lv, 0);
                    c.FillRect(ytx0, gy - yth / 2, ytlen, yth, ytcol);
                }
            }
        }
        if (x0Line) {
            if (f.brkX != null && f.brkX.Count > 0) {
                Chart.DrawAxisLineBands(c, plotX, xLineY, plotW, false,
                    app.Scale(2), sAxis.BgOr(0), Chart.BrkPixelBands(f, 2));
            } else {
                c.FillRect(plotX, xLineY, plotW, app.Scale(2), sAxis.BgOr(0));
            }
        }
        if (y1Line) {
            int y1col = y1.axisLineColor != 0 ? y1.axisLineColor : sAxis.BgOr(0);
            if (f.BrkHas(1)) {
                Chart.DrawAxisLineBands(c, y1LineX, plotY, plotH, true, 1,
                    y1col, Chart.BrkPixelBands(f, 1));
            } else {
                c.FillRect(y1LineX, plotY, 1, plotH, y1col);
            }
        }
        // Y1 轴刻度须（axisTick）
        if (hasRight && y1.axisTickShow && y1.show) {
            int y1tlen = y1.axisTickLength > 0 ? app.Scale(y1.axisTickLength) : app.Scale(5);
            int y1th = y1.axisTickWidth > 0 ? app.Scale(y1.axisTickWidth) : 1;
            int y1tcol = y1.axisTickColor != 0 ? y1.axisTickColor : (y1.axisLineColor != 0 ? y1.axisLineColor : sAxis.BgOr(0));
            int y1tx0 = y1.axisTickInside ? y1LineX - y1tlen : y1LineX;
            int rightSpan = rightTickHi - rightTickLo;
            for (int k = 0; k <= rt; k = k + 1) {
                int rv = rightTickLo + rightSpan * k / rt;
                int gy = f.YOf(rv, 1);
                c.FillRect(y1tx0, gy - y1th / 2, y1tlen, y1th, y1tcol);
            }
        }

        // 轴级静态 axisPointer：show 官方缺省 'auto'（SSR 实测
        // get('show')）——auto 时**声明了 value 就显示**；显式 false
        // 才隐藏。竖线锚在 value（时间轴 epoch 天 / 数值轴原值），
        // 线色宽走 lineStyle；label 盒画在 x 轴线下方（官方 label
        // 默认白字圆角盒）。画在网格之上、系列之下（官方 z 序）。
        if (x0.axisPointerShow != 0 && x0.apValueSet && plotW > 0 && plotH > 0) {
            int apx = isTime ? f.XOfTime((int)x0.apValue)
                : f.XOfValue((int)(x0.apValue + (x0.apValue >= 0 ? 0.5 : 0 - 0.5)));
            int apCol = x0.apColor != 0 ? x0.apColor : sAxis.BgOr(0);
            int apW = x0.apWidth > 0 ? x0.apWidth : 1;
            if (apx >= plotX && apx <= plotX + plotW) {
                c.FillRect(apx - apW / 2, plotY, apW, plotH, apCol);
                if (x0.apLabelShow && x0.apLabelBg != 0) {
                    string apt = isTime ? Chart.TimeLabel((int)x0.apValue)
                        : Chart.Commas((int)(x0.apValue
                            + (x0.apValue >= 0 ? 0.5 : 0 - 0.5)));
                    int atW = Canvas.MeasureText(apt, fs);
                    int boxW = atW + app.Scale(10);
                    int boxH = fh + app.Scale(2);
                    int boxY = plotY + plotH + app.Scale(4);
                    c.FillRoundRect(apx - boxW / 2, boxY, boxW, boxH,
                        t.borderRadiusSmall, x0.apLabelBg);
                    c.DrawText(apx - atW / 2,
                        boxY + (boxH - Canvas.FontHeight(fs)) / 2,
                        apt, 0xFFFFFF, fs);
                }
            }
        }

        // x 分类标签（时间轴用 TimeLabel 日期刻度；值轴画数值刻度）
        int n = labels.Count;
        if (x0.show && (catY || xValue)) {
            // 轴互换：类目在 Y（上面已画），X 画数值刻度。
            // ECharts 数值轴 splitLine 默认开（类目轴默认关）：
            // 竖向辅助线是轴互换图（line5 类目 Y + 数值 X）唯一
            // 的网格，横线随类目 Y 的 showGrid=false 不画。
            bool gridX = o.showGrid && x0.showGrid;
            // X 刻度同左/右轴取 nice 端点副本（xLo/xHi 已留白外扩）。
            int xspan = xTickHi - xTickLo;
            // ---- A12 minorSplitLine（X 数值轴）----
            // CartesianAxisView.ts:170-200 同一函数按
            // isHorizontal 分支：x 轴画竖线。
            // 类目轴不支持（Axis.ts:204 返回空）。
            if (x0.minorSplitLineShow && !catY && !isTime
                && x0.type == ChartAxisType.Value && xt > 0) {
                StyleBox sMinorX = Style.Part(app, "chart", "minor-grid", "", "", "",
                                             Style.SNormal());
                int mcolX = sMinorX.BgOr(0) != 0 ? sMinorX.BgOr(0) : sGrid.BgOr(0);
                List<double> mtsX = new List<double>();
                Chart.MinorTickValues((double)xTickLo, (double)xTickHi, xt,
                    x0.minorTickSplitNumber, mtsX);
                for (int miX = 0; miX < mtsX.Count; miX = miX + 1) {
                    int gmx = f.XOfValue((int)(mtsX[miX] + 0.5));
                    if (gmx > plotX && gmx < plotX + plotW) {
                        c.FillRect(gmx, plotY, 1, plotH, mcolX);
                    }
                }
            }
            int x0Col = x0.labelColor != 0 ? x0.labelColor : sAxis.FgOr(0);
            int xly = x0.labelInside ? plotBot - xMarg - fh : plotBot + xMarg;
            for (int k = 0; k <= xt; k = k + 1) {
                int xv = xTickLo + xspan * k / xt;
                int gx = f.XOfValue(xv);
                if (gridX) { c.FillRect(gx, plotY, 1, plotH, gridColX); }
                if (x0.axisTickShow) {
                    int xtlen = x0.axisTickLength > 0 ? app.Scale(x0.axisTickLength) : app.Scale(5);
                    int xtw = x0.axisTickWidth > 0 ? app.Scale(x0.axisTickWidth) : 1;
                    int xtcol = x0.axisTickColor != 0 ? x0.axisTickColor : (x0.axisLineColor != 0 ? x0.axisLineColor : sAxis.BgOr(0));
                    int xty0 = x0.axisTickInside ? xLineY - xtlen : xLineY;
                    c.FillRect(gx - xtw / 2, xty0, xtw, xtlen, xtcol);
                }
                string xs2 = Chart.Commas(xv);
                if (x0.labelFormatter.Length > 0) { xs2 = x0.labelFormatter.Replace("{value}", xs2); }
                string xs2m = x0.labelSt != null && x0.labelSt.rich != null
                    ? Chart.RichStrip(xs2) : xs2;
                int lw = Canvas.MeasureText(xs2m, fs);
                int lx = gx - lw / 2;
                if (lx < plotX) { lx = plotX; }
                if (lx + lw > plotX + plotW) { lx = plotX + plotW - lw; }
                Chart.DrawAxisLabel(app, c, x0, xs2, lx, xly,
                    x0Col, fs);
            }
        } else if (x0.show && (n > 0 || isTime)) {
            int x0Col = x0.labelColor != 0 ? x0.labelColor : sAxis.FgOr(0);
            int xly = x0.labelInside ? plotBot - xMarg - fh : plotBot + xMarg;
            if (isTime) {
                List<int> tts = Chart.TimeTicks(tMin, tMax, 6);
                for (int ti = 0; ti < tts.Count; ti = ti + 1) {
                    int tx = f.XOfTime(tts[ti]);
                    if (x0.axisTickShow) {
                        int xtlen = x0.axisTickLength > 0 ? app.Scale(x0.axisTickLength) : app.Scale(5);
                        int xtw = x0.axisTickWidth > 0 ? app.Scale(x0.axisTickWidth) : 1;
                        int xtcol = x0.axisTickColor != 0 ? x0.axisTickColor : (x0.axisLineColor != 0 ? x0.axisLineColor : sAxis.BgOr(0));
                        int xty0 = x0.axisTickInside ? xLineY - xtlen : xLineY;
                        c.FillRect(tx - xtw / 2, xty0, xtw, xtlen, xtcol);
                    }
                    string ls = Chart.TimeLabel(tts[ti]);
                    if (x0.labelFormatter.Length > 0) { ls = x0.labelFormatter.Replace("{value}", ls); }
                    string lsm = x0.labelSt != null && x0.labelSt.rich != null
                        ? Chart.RichStrip(ls) : ls;
                    int lw = Canvas.MeasureText(lsm, fs);
                    int lx = tx - lw / 2;
                    if (lx < plotX) { lx = plotX; }
                    if (lx + lw > plotX + plotW) { lx = plotX + plotW - lw; }
                    Chart.DrawAxisLabel(app, c, x0, ls, lx, xly,
                        x0Col, fs);
                }
            } else {
                int labelGap = app.Scale(6);
                int rot = x0.labelRotate;
                // 刻度线模式（boundaryGap=false）标签以刻度为中心，
                // 首尾标签允许越出绘图区（与数值轴标签同形态）；
                // 带状模式居中在格子内、不越左缘。
                bool tickX = !f.catBoundaryGap && n > 1;
                // ECharts 类目轴 splitLine 默认开、interval 缺省
                // 'auto'（与 axisLabel 同源抽稀）：竖线只落在显示标签
                // 的刻度上——刻度模式落在类目刻度（CatX），带状模式落
                // 在格子边界（CatLeft）；首线与 y 轴重合、末线贴绘图区
                // 右缘，都跳过。密集类目（雨量图 3079 点）不再逐类目
                // 一条竖线糊成灰罩。
                List<int> tickShown = Chart.CategoryTicks(f, labels, fs,
                    plotX, labelGap, x0);
                if (o.showGrid && x0.showGrid) {
                    for (int si3 = 0; si3 < tickShown.Count; si3 = si3 + 1) {
                        int gvi = tickShown[si3];
                        if (!tickX && gvi == 0) { continue; }
                        int gvx = tickX ? f.CatX(gvi, n) : f.CatLeft(gvi, n);
                        if (gvx > plotX && gvx < plotX + plotW) {
                            c.FillRect(gvx, plotY, 1, plotH, gridColX);
                        }
                    }
                }
                if (x0.axisTickShow) {
                    int xtlen = x0.axisTickLength > 0 ? app.Scale(x0.axisTickLength) : app.Scale(5);
                    int xtw = x0.axisTickWidth > 0 ? app.Scale(x0.axisTickWidth) : 1;
                    int xtcol = x0.axisTickColor != 0 ? x0.axisTickColor : (x0.axisLineColor != 0 ? x0.axisLineColor : sAxis.BgOr(0));
                    int xty0 = x0.axisTickInside ? xLineY - xtlen : xLineY;
                    if (x0.axisTickAlignWithLabel) {
                        for (int si3 = 0; si3 < tickShown.Count; si3 = si3 + 1) {
                            int gvi = tickShown[si3];
                            int tx = f.CatX(gvi, n);
                            c.FillRect(tx - xtw / 2, xty0, xtw, xtlen, xtcol);
                        }
                    } else if (f.catBoundaryGap) {
                        for (int ci = 0; ci <= n; ci = ci + 1) {
                            int tx = ci < n ? f.CatLeft(ci, n) : plotX + plotW;
                            c.FillRect(tx - xtw / 2, xty0, xtw, xtlen, xtcol);
                        }
                    } else {
                        for (int si3 = 0; si3 < tickShown.Count; si3 = si3 + 1) {
                            int tx = f.CatLeft(tickShown[si3], n);
                            c.FillRect(tx - xtw / 2, xty0, xtw, xtlen, xtcol);
                        }
                    }
                }
                for (int ti5 = 0; ti5 < tickShown.Count; ti5 = ti5 + 1) {
                    int ci = tickShown[ti5];
                    string lab = labels[ci];
                    if (x0.labelFormatter.Length > 0) { lab = x0.labelFormatter.Replace("{value}", lab); }
                    bool labRich = x0.labelSt != null && x0.labelSt.rich != null;
                    string labm = labRich ? Chart.RichStrip(lab) : lab;
                    int cxs = f.CatLeft(ci, n);
                    int cellW = f.CatWidth(ci, n);
                    int labelW = Canvas.MeasureText(labm, fs);
                    int labelLeft = tickX ? cxs - labelW / 2
                        : cxs + (cellW - labelW) / 2;
                    if (!tickX && labelLeft < cxs) { labelLeft = cxs; }
                    // 直接迭代 tickShown（CategoryTicks 已抽稀），
                    // 不再对未显示的类目做 Replace/MeasureText。
                    if (rot != 0) {
                        // DrawTextRot 绕未旋转行盒左上角顺时针旋转：
                        // 负角取行盒右缘为锚（文本向右下伸展、标签尾
                        // 对齐格子中线），正角取左缘（文本向右上收）。
                        // 富文本块不能整体旋转——画剥壳文本。
                        int ax = labelLeft + labelW;
                        if (rot > 0) { ax = labelLeft; }
                        int rotY = x0.labelInside ? plotBot - app.Scale(4) - fh : plotBot + app.Scale(4);
                        c.DrawTextRot(ax, rotY, labm,
                            x0Col, fs, rot);
                    } else if (tickX) {
                        Chart.DrawAxisLabel(app, c, x0, lab, cxs - labelW / 2,
                            xly, x0Col, fs);
                    } else {
                        Chart.DrawAxisLabelCentered(app, c, x0, lab, cxs,
                            xly, cellW, fh,
                            x0Col, fs);
                    }
                }
            }
        }

        // 第二条 x 轴（双 X 轴图顶轴/副轴，如 multiple-x-axis）：
        // 沿 plotY 绘制顶部轴线、刻度须、刻度标签与轴名。
        if (o.xAxes.Count > 1) {
            ChartAxis x1 = o.XAxis1();
            if (x1 != null && x1.show) {
                int x1Col = x1.axisLineColor != 0 ? x1.axisLineColor : sAxis.BgOr(0);
                c.FillRect(plotX, plotY, plotW, app.Scale(2), x1Col);
                List<string> x1Labels = x1.categories != null && x1.categories.Count > 0
                    ? x1.categories : labels;
                int x1N = x1Labels.Count;
                int x1LblCol = x1.labelColor != 0 ? x1.labelColor : x1Col;
                int x1tlen = x1.axisTickLength > 0 ? app.Scale(x1.axisTickLength) : app.Scale(5);
                int x1tw = x1.axisTickWidth > 0 ? app.Scale(x1.axisTickWidth) : 1;
                int x1tcol = x1.axisTickColor != 0 ? x1.axisTickColor : x1Col;
                for (int x1i = 0; x1i < x1N; x1i = x1i + 1) {
                    int x1cxs = f.CatLeft(x1i, x1N);
                    int x1cellW = f.CatWidth(x1i, x1N);
                    int x1Mid = f.CatX(x1i, x1N);
                    if (x1.axisTickShow) {
                        int x1TickX = x1.axisTickAlignWithLabel ? x1Mid : x1cxs;
                        int x1TickY = x1.axisTickInside ? plotY : plotY - x1tlen;
                        c.FillRect(x1TickX - x1tw / 2, x1TickY, x1tw, x1tlen, x1tcol);
                    }
                    if (x1.labelShow) {
                        string lab1 = x1Labels[x1i];
                        if (x1.labelFormatter.Length > 0) { lab1 = x1.labelFormatter.Replace("{value}", lab1); }
                        int lab1W = Canvas.MeasureText(lab1, fs);
                        int lab1Y = x1.labelInside ? plotY + app.Scale(4) : plotY - app.Scale(4) - fh;
                        c.DrawText(x1Mid - lab1W / 2, lab1Y, lab1, x1LblCol, fs);
                    }
                }
                if (x1.axisTickShow && !x1.axisTickAlignWithLabel && f.catBoundaryGap) {
                    int x1EndTickX = plotX + plotW;
                    int x1EndTickY = x1.axisTickInside ? plotY : plotY - x1tlen;
                    c.FillRect(x1EndTickX - x1tw / 2, x1EndTickY, x1tw, x1tlen, x1tcol);
                }
                Chart.DrawAxisNameAt(app, c, x1, true, plotX, plotY, plotW, plotH, false,
                    sAxisTitle, fs, plotY);
            }
        }

        // 轴名：ECharts 三态（缺省 'end'）+ nameGap（缺省 15）。
        // 几何与实测出处见 Chart.AxisNamePos。骑线时 start/end 态
        // 的名字贴轴线走（middle 留在边界，AxisBuilder.ts:869 的
        // labelOffset 抵回原位）。
        Chart.DrawAxisNameAt(app, c, x0, true, plotX, plotY, plotW, plotH, false,
            sAxisTitle, fs, xLineY);
        Chart.DrawAxisNameAt(app, c, y0, false, plotX, plotY, plotW, plotH,
            y0.position == "right", sAxisTitle, fs, yLineX);
        // 右轴名只在真的存在第二条轴时画（YAxis1 在单轴时会回退
        // 到 YAxis0，不设防会把左轴名镜像到右缘）。
        if (hasRight && o.yAxes.Count > 1) {
            Chart.DrawAxisNameAt(app, c, y1, false, plotX, plotY, plotW, plotH,
                y1.position == "right", sAxisTitle, fs, y1LineX);
        }

    }
}
