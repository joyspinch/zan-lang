using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// ChartView 渲染器共享的绘图工具：颜色、比例辅助、
// 面板/图例框架、dataZoom 滑块、标记线/区域、直角坐标系和
// 双轴坐标构建器。一次性的静态渲染器（Chart.Line/
// Bar/Pie/...）已移除——所有图表现在声明为 ChartOption
// 并由 ChartView 绘制。
public partial class Chart {

    // 本帧工具箱占用的右上角宽度；DrawPanelI / PanelHead 让开它。
    static int toolReserve;

    // 本帧 option（图例子字段 orient/selectedMode/formatter 的来源）；
    // Render() 分派前置位，与 toolReserve 同为帧内静态。
    static ChartOption legendOpt;
    // 本帧水平图例占用的底部高度（ECharts 6 默认图例在底部，
    // BuildAxesR 从绘图区底边扣除；竖排图例在顶部占位，此值为 0）。
    static int legendBottomReserve;
    // dataZoom 滑条预留带（ZoomBandH，DrawZoomBar 调用方在
    // DrawPanelI 之前置位）：底部图例锚点要从面板底边上移这条带，
    // 否则图例画进滑条轨道里（sh-2015 图例色块透在 filler 底下）。
    // DrawPanelI 读后即清（consume-once），不污染同帧其他面板。
    static int zoomBandReserve;
    // 多 grid 子面板帧内约定（DrawMultiGridPanels 置位/复位）：
    // grid 矩形是纯绘图区，标题/工具箱是页级元素由派发层画一次，
    // 子面板不再按 PanelContentTop 预留头部（96px 成交量条带曾被
    // 59px 头部啃到 30px 绘图区）。
    static bool gridPanelSub;
    // 多 grid 子面板：zoom 窗口全格生效（官方 dataZoom
    // xAxisIndex:[0,1] 同窗联动），但滑条条带只随最后一个 grid
    // 画一次——非末格置位，视图据它跳过 zoomH 预留与 DrawZoomBar。
    static bool zoomBarHidden;

    // 符号形状族绘制（ECharts series.symbol）：shape 取
    // circle（默认实心圆）/ emptyCircle（环）/ rectangle / diamond /
    // triangle。r 为外接半径；borderWidth>0 时用 borderColor 描边。
    // 全部为不透明覆盖、无二次混合，指纹稳定。
    public static void DrawSymbol(Canvas c, int cx, int cy, int r, string shape,
                           int color, int borderColor, int borderWidth) {
        Chart.DrawSymbolGrad(c, cx, cy, r, shape, color, borderColor, borderWidth, null);
    }

    public static void DrawSymbolGrad(Canvas c, int cx, int cy, int r, string shape,
                               int color, int borderColor, int borderWidth,
                               List<int> gradStops) {
        if (shape == "none" || shape == "pass") { return; }
        if (r < 1) { r = 1; }
        if (shape == "rectangle") {
            int d = r * 71 / 100;  // 内接正方形半边（与圆同视觉重量）
            c.FillRect(cx - d, cy - d, d * 2 + 1, d * 2 + 1, color);
        } else if (shape == "diamond") {
            for (int dy = 0 - r; dy <= r; dy = dy + 1) {
                int hw = r - (dy < 0 ? 0 - dy : dy);
                c.FillRect(cx - hw, cy + dy, hw * 2 + 1, 1, color);
            }
        } else if (shape == "triangle") {
            // 上顶点，底边在下：行 r0 距顶点 dy，半宽 = r * dy / r。
            for (int dy = 0 - r; dy <= r; dy = dy + 1) {
                int hw = (r * (dy + r)) / (2 * r);
                if (hw < 0) { hw = 0; }
                c.FillRect(cx - hw, cy + dy, hw * 2 + 1, 1, color);
            }
        } else if (shape == "star" || shape == "star5" || shape == "star6"
                   || shape == "arrow"
                   || shape == "droplet" || shape == "pin"
                   || shape == "emptypin"
                   || shape == "heart" || shape == "emptyheart") {
            // ECharts 其余符号形状：顶点多边形扫描线填充
            // （顶点表见 Chart.PolyVerts1000）。empty* 变体按原语义
            // 画白芯（getSymbolShape：empty 符号 color='#fff' 填充、
            // 色环即本体，环宽缺省 2）。
            List<int> vx = new List<int>();
            List<int> vy = new List<int>();
            Chart.PolyVerts1000(shape, vx, vy);
            Chart.FillPoly1000(c, cx, cy, r, vx, vy, color);
            if (shape == "emptypin" || shape == "emptyheart") {
                int ew = borderWidth > 0 ? borderWidth : 2;
                if (r > ew) {
                    Chart.FillPoly1000(c, cx, cy, r - ew, vx, vy, 0xFFFFFFFF);
                }
            }
        } else if (shape == "emptyCircle") {
            // ECharts emptyCircle：白芯 + 色环（折线 emptyColor '#fff'，
            // 环宽 = borderWidth，缺省取 lineStyle.width，再缺省 2）。
            // 填充圆在像素中心采样下 dx=r 的格点覆盖为 0（外缘半像素
            // 落空），白芯抹掉内圈后色环缩进 1px——DrawCircle 在半径
            // 处再描 1px 把外缘补齐，测试与视觉的环外径都回到 r。
            int ew = borderWidth > 0 ? borderWidth : 2;
            c.FillCircle(cx, cy, r, color);
            if (r > ew) { c.FillCircle(cx, cy, r - ew, 0xFFFFFFFF); }
            c.DrawCircle(cx, cy, r, color, 1);
        } else {
            if (gradStops != null && gradStops.Count >= 2 && r > 2) {
                int baseCol = gradStops[gradStops.Count - 1];
                int lightCol = gradStops[0];
                c.FillCircle(cx, cy, r, baseCol);
                c.FillRadial(cx - r / 4, cy - r / 4, r * 3 / 4, lightCol, 210);
            } else {
                c.FillCircle(cx, cy, r, color);
            }
        }
        if (borderWidth > 0 && borderColor != 0) {
            if (shape == "rectangle" || shape == "diamond" || shape == "triangle") {
                List<int> xs = new List<int>();
                List<int> ys = new List<int>();
                if (shape == "rectangle") {
                    int d = r * 71 / 100;
                    xs.Add(cx - d); ys.Add(cy - d);
                    xs.Add(cx + d); ys.Add(cy - d);
                    xs.Add(cx + d); ys.Add(cy + d);
                    xs.Add(cx - d); ys.Add(cy + d);
                } else if (shape == "diamond") {
                    xs.Add(cx); ys.Add(cy - r);
                    xs.Add(cx + r); ys.Add(cy);
                    xs.Add(cx); ys.Add(cy + r);
                    xs.Add(cx - r); ys.Add(cy);
                } else {
                    xs.Add(cx); ys.Add(cy - r);
                    xs.Add(cx + r); ys.Add(cy + r);
                    xs.Add(cx - r); ys.Add(cy + r);
                }
                xs.Add(xs[0]); ys.Add(ys[0]);
                c.DrawPolyline(xs, ys, borderColor, borderWidth);
            } else if (shape == "emptyCircle") {
                c.DrawCircle(cx, cy, r, borderColor, borderWidth);
            } else {
                c.DrawCircle(cx, cy, r, borderColor, borderWidth);
            }
        }
    }

    // symbolSize -> 外接半径。ECharts 语义 symbolSize 是「半宽
    // （半径）参数」（config.js markPoint 注释：总宽度为
    // symbolSize * 2），传入值本身就是半径，不再折半。
    public static int SymbolRadius(int symbolSize, int defaultR) {
        if (symbolSize > 0) {
            // ECharts symbolSize 是符号直径（bump-chart 20 → 半径
            // 10）。此前当半径用，全部符号放大一倍。
            return symbolSize / 2;
        }
        return defaultR;
    }

    // 类目轴每格可用宽度 `availSize = plotW / n`，抽样至多 5 个数据点，
    // 任一点的符号尺寸 × 1.5（源码注 "Empirical number"）超过 availSize
    // 即判定"放不下全量符号"。`showAllSymbol:'auto'`（缺省）靠它决定是否
    // 按标签间隔抽稀——源码注释 "we show all symbols as possible as we
    // can"，即能放就全放；把"标签放不下 ⇒ 符号也不放"当默认是错的。
    // `symbolSizeF` = 系列符号直径（device 像素，调用方已 app.Scale）；
    // `data`/`i0`/`dpiScale` 给逐点 symbolSize 覆盖（源码
    // `getSymbolSize(data, dataIndex)`），逐点值同样折成 device 像素再比。
    // 只抽样读，不物化整表（密集线 3079 点每帧都走这条）。
    public static bool CanShowAllSymbolForCategory(int plotW, int n, int symbolSizeF,
                                           List<ChartData> data, int i0,
                                           int dpiScale) {
        if (n < 1) { return true; }
        int availSize = plotW / n;
        int step = n / 5;
        if (step < 1) { step = 1; }
        for (int i = 0; i < n; i = i + step) {
            int sz = symbolSizeF;
            int di = i0 + i;
            if (data != null && di >= 0 && di < data.Count
                && data[di].sizeSet && data[di].size > 0) {
                sz = data[di].size * dpiScale / 100;
            }
            if (sz * 3 / 2 > availSize) { return false; }
        }
        return true;
    }

    // 符号形状的顶点表（千分比相对坐标，y 向下为正），由
    // FillPoly1000 缩放到像素。star = 五角星（内接比 382），
    // star6 = 六角星（内接比 577 ≈ 1/√3），arrow = 上指箭镞，
    // droplet = 上尖水滴，heart = 心形（zrender Heart 贝塞尔
    // 采样近似：底尖在下、双瓣在上），pin/emptypin = 地图气球。
    public static void PolyVerts1000(string shape, List<int> vx, List<int> vy) {
        if (shape == "star" || shape == "star5") {
            int[] px = new int[] { 0, 225, 951, 363, 588, 0, -588, -363, -951, -225 };
            int[] py = new int[] { -1000, -309, -309, 118, 809, 382, 809, 118, -309, -309 };
            for (int i = 0; i < px.Length; i = i + 1) { vx.Add(px[i]); vy.Add(py[i]); }
        } else if (shape == "star6") {
            int[] px = new int[] { 0, 289, 866, 577, 866, 289, 0, -289, -866, -577, -866, -289 };
            int[] py = new int[] { -1000, -500, -500, 0, 500, 500, 1000, 500, 500, 0, -500, -500 };
            for (int i = 0; i < px.Length; i = i + 1) { vx.Add(px[i]); vy.Add(py[i]); }
        } else if (shape == "arrow") {
            vx.Add(0); vy.Add(-1000);
            vx.Add(1000); vy.Add(430);
            vx.Add(0); vy.Add(140);
            vx.Add(-1000); vy.Add(430);
        } else if (shape == "droplet") {
            int[] px = new int[] { 0, -400, -790, -1000, -790, -400, 0, 400, 790, 1000, 790, 400 };
            int[] py = new int[] { -1000, -500, -180, 150, 480, 730, 820, 730, 480, 150, -180, -500 };
            for (int i = 0; i < px.Length; i = i + 1) { vx.Add(px[i]); vy.Add(py[i]); }
        } else if (shape == "heart" || shape == "emptyheart") {
            // 心形：zrender Heart（a=w/2、b=0.8h、内尖锚在 0.2h 高度）
            // 两条贝塞尔的采样近似，底尖 (0,1000)、顶瓣 ±(1008,-331)。
            int[] px = new int[] { 0, 500, 914, 1008, 872, 599, 277, 0,
                -277, -599, -872, -1008, -914, -500 };
            int[] py = new int[] { 1000, 667, 151, -331, -711, -927, -910,
                -600, -910, -927, -711, -331, 151, 667 };
            for (int i = 0; i < px.Length; i = i + 1) { vx.Add(px[i]); vy.Add(py[i]); }
        } else {
            // pin / emptypin：气球头（全径圆） + 下尖尾
            int[] px = new int[] { 0, -545, -920, -575, 0, 575, 920, 545 };
            int[] py = new int[] { 1000, 120, -300, -830, -960, -830, -300, 120 };
            for (int i = 0; i < px.Length; i = i + 1) { vx.Add(px[i]); vy.Add(py[i]); }
        }
    }

    // 顶点多边形扫描线填充（偶奇规则）：顶点为千分比相对坐标，
    // 逐行求交点、成对 FillRect。顶点数 ≤ 12，插入排序开销可忽略。
    public static void FillPoly1000(Canvas c, int cx, int cy, int r,
                             List<int> vx, List<int> vy, int color) {
        int vn = vx.Count;
        if (vn < 3 || r < 1) { return; }
        int ymin = vy[0];
        int ymax = vy[0];
        for (int i = 1; i < vn; i = i + 1) {
            if (vy[i] < ymin) { ymin = vy[i]; }
            if (vy[i] > ymax) { ymax = vy[i]; }
        }
        List<int> xs = new List<int>();
        for (int py = ymin; py <= ymax; py = py + 1) {
            xs.Clear();
            for (int i = 0; i < vn; i = i + 1) {
                int j = i + 1 == vn ? 0 : i + 1;
                int y1 = vy[i];
                int y2 = vy[j];
                if ((y1 <= py && y2 > py) || (y2 <= py && y1 > py)) {
                    xs.Add(vx[i] + (py - y1) * (vx[j] - vx[i]) / (y2 - y1));
                }
            }
            for (int a = 1; a < xs.Count; a = a + 1) {
                int key = xs[a];
                int b = a - 1;
                while (b >= 0 && xs[b] > key) { xs[b + 1] = xs[b]; b = b - 1; }
                xs[b + 1] = key;
            }
            for (int p = 0; p + 1 < xs.Count; p = p + 2) {
                int x0 = cx + xs[p] * r / 1000;
                int x1 = cx + xs[p + 1] * r / 1000;
                int sy = cy + py * r / 1000;
                c.FillRect(x0, sy, x1 - x0 + 1, 1, color);
            }
        }
    }

    // axisLabel.interval 语义（ECharts）：-1/非整数 = 自动（渲染器
    // 走防重叠贪心），>=0 = 每 (interval+1) 个画一个。纯函数，
    // conformance 直接断言。
    public static bool LabelShown(int ci, int interval) {
        if (interval < 0) { return true; }
        return ci % (interval + 1) == 0;
    }

    // 类目轴 auto 抽稀的共用判定：返回窗口内实际显示标签的类目
    // 下标（升序）。ECharts 中 axisLabel.interval 缺省 'auto'，
    // splitLine 与折线拐点符号（isMainIdx）与标签同源——密集类目
    // 轴的竖网格和符号都只落在显示标签的刻度上，不再逐类目一条
    // （雨量图 3079 点曾把竖线糊成整幅灰罩、折线满线小圆点）。
    // 规则与 BuildAxesR 标签绘制一致：显式 interval 走 LabelShown、
    // 旋转标签不抽稀、刻度模式（boundaryGap=false）首标签豁免
    // （ECharts 始终画边界刻度），其余贪心让位。
    public static List<int> CategoryTicks(ChartFrame f, List<string> labels, int fs,
                                    int plotX, int labelGap, ChartAxis x0) {
        List<int> shown = new List<int>();
        int n = labels.Count;
        if (f == null || n < 1) { return shown; }
        bool tickX = !f.catBoundaryGap && n > 1;
        int labelRight = plotX - labelGap;
        // 预抽稀步长（与 DrawFrameLoHiT 同一病灶）：candlestick-
        // large 成交量面板 2.2 万条类目，逐条 Replace+MeasureText
        // ≈ 0.7s/帧。自动间隔且不旋转时按估宽 24px 跳步，只对候
        // 选量宽；显式 interval / 旋转标签保留原语义。
        int stride = 1;
        if (n > 1 && x0.labelRotate == 0 && x0.labelInterval < 0) {
            stride = (n * Canvas.FontHeight(fs) + f.plotW - 1) / f.plotW;
            if (stride < 1) { stride = 1; }
        }
        for (int ci = 0; ci < n; ci = ci + stride) {
            string lab = labels[ci];
            if (x0.labelFormatter.Length > 0) {
                lab = x0.labelFormatter.Replace("{value}", lab);
            }
            // 富文本轴标签量宽用剥壳文本（图标宽不进文本测量——
            // 图标段是 backgroundColor image，本引擎退化留白）。
            if (x0.labelSt != null && x0.labelSt.rich != null) {
                lab = Chart.RichStrip(lab);
            }
            int labelW = Canvas.MeasureText(lab, fs);
            int cxs = f.CatLeft(ci, n);
            int cellW = f.CatWidth(ci, n);
            int labelLeft = tickX ? cxs - labelW / 2
                : cxs + (cellW - labelW) / 2;
            if (!tickX && labelLeft < cxs) { labelLeft = cxs; }
            bool show;
            if (x0.labelInterval >= 0) {
                show = Chart.LabelShown(ci, x0.labelInterval);
            } else if (x0.labelRotate != 0) {
                show = true;
            } else {
                show = (tickX && ci == 0)
                    || labelLeft >= labelRight + labelGap;
            }
            if (show) {
                shown.Add(ci);
                labelRight = labelLeft + labelW;
            }
        }
        return shown;
    }

    // 旋转分类标签的竖直占位（像素）：行盒 w×h 绕锚点旋转
    // |deg| 度后的垂直跨度 = w·|sin| + h·|cos|。用 ChartView 的
    // 1000 倍三角表，确定性整数。
    public static int RotatedLabelH(int maxW, int fh, int deg) {
        int a = deg < 0 ? 0 - deg : deg;
        if (a > 90) { a = 90; }
        int s = ChartView.SinDeg(a);
        int co = a >= 90 ? 0 : ChartView.CosDeg(a);
        return (maxW * s + fh * co) / 1000 + 2;
    }

    // ---- 比例辅助 ----

    // 将原始最大值向上取整为友好的轴上界（2/5/10 * 10^n）：
    // 37 -> 50、830 -> 1000。<=5 时返回 5。
    public static int NiceMax(int v) {
        if (v <= 5) { return 5; }
        int mag = 1;
        while (mag * 10 <= v) { mag = mag * 10; }
        int unit = v / mag;
        int nice = 10;
        if (unit < 2) { nice = 2; } else if (unit < 5) { nice = 5; }
        return nice * mag;
    }

    // ======== ECharts 6.1 scale 基元（逐函数照抄，勿改语义）========
    // 上面那个 NiceMax(int) 是本仓库手写的旧近似（`<=5 → 5` 特例 +
    // 2/5/10 阶梯），与 ECharts 不符；下面 NiceD/NiceMode 才是对照源
    // 的忠实物。保留旧函数以便逐步迁移调用点。

    // `number.ts:581 quantityExponent(val)`——十进制指数。
    // 9876→3，0.09876→-2，0.0012→-3。val=0 按源码返回 0。
    // 注意源码用 mathFloor；(int) 是向零截断，负数会差 1
    // （log10(0.0012) = -2.92，必须 -3），故显式下取整。
    public static int QuantityExponent(double val) {
        if (val == 0.0) { return 0; }
        double av = val < 0.0 ? 0.0 - val : val;
        double lg = Math.Log(av) / 2.302585092994046;
        int exp = (int)lg;
        if ((double)exp > lg) { exp = exp - 1; }
        // 源码 :594——Math.log 精度损失用 10^exp 还原，必要时 +1
        if (av / Chart.Pow10D(exp) >= 10.0) { exp = exp + 1; }
        return exp;
    }

    // 10 的整数次幂（源码 Math.pow(10,e)，整数指数无舍入误差）。
    // D 后缀避开本文件既有的 int 版 Pow10。
    public static double Pow10D(int e) {
        double r = 1.0;
        int n = e < 0 ? 0 - e : e;
        for (int i = 0; i < n; i = i + 1) { r = r * 10.0; }
        return e < 0 ? 1.0 / r : r;
    }

    // precision 钳到 [0,20]（TO_FIXED_SUPPORTED_PRECISION_MAX）。
    public static double RoundP(double x, int precision) {
        int p = precision < 0 ? 0 : precision;
        if (p > 20) { p = 20; }
        double sc = Chart.Pow10D(p);
        double v = x * sc;
        double r = v >= 0.0 ? (double)(long)(v + 0.5) : (double)(long)(v - 0.5);
        return r / sc;
    }

    // `number.ts:297 getPrecisionSafe(val)`——字符串法小数位数。
    public static int GetPrecisionSafe(double val) {
        string s = val.ToString();
        int eIdx = s.IndexOf('e');
        if (eIdx < 0) { eIdx = s.IndexOf('E'); }
        int exp = 0;
        int sigLen = s.Length;
        if (eIdx > 0) {
            exp = int.Parse(s.Substring(eIdx + 1));
            sigLen = eIdx;
        }
        int dot = s.IndexOf('.');
        int decLen = dot < 0 ? 0 : sigLen - 1 - dot;
        int r = decLen - exp;
        return r > 0 ? r : 0;
    }

    // `number.ts:265 getPrecision(val)`——快路径 15 次循环，
    // 否则退字符串法。
    public static int GetPrecision(double val) {
        double av = val < 0.0 ? 0.0 - val : val;
        if (av > 1e-14) {
            double e = 1.0;
            for (int i = 0; i < 15; i = i + 1) {
                double v = av * e;
                double r = v >= 0.0 ? (double)(long)(v + 0.5) : (double)(long)(v - 0.5);
                if (r / e == av) { return i; }
                e = e * 10.0;
            }
        }
        return Chart.GetPrecisionSafe(av);
    }

    // `helper.ts:147 getIntervalPrecision(niceInterval)`
    // = getPrecision(interval) + 2。刻度标签小数位数由它决定。
    public static int GetIntervalPrecision(double niceInterval) {
        return Chart.GetPrecision(niceInterval) + 2;
    }

    // `number.ts:613 nice(val, mode)`。roundMode=true 走
    // NICE_MODE_ROUND（helper.ts:103 的调用点）：
    // f<1.5→1  f<2.5→2  f<4→3  f<7→5  else→10
    // false 走 mode=0 分支：f<1→1 f<2→2 f<3→3 f<5→5 else→10。
    // 校验值（已对源逐值核过）：nice(1.4)=1 nice(3.7)=3 nice(7.2)=10
    // nice(0.36)=0.3 nice(0.0012)=0.001 nice(70.1598)=100
    public static double NiceMode(double val, bool roundMode) {
        double av = val < 0.0 ? 0.0 - val : val;
        if (av == 0.0) { return 0.0; }
        int exponent = Chart.QuantityExponent(av);
        double exp10 = Chart.Pow10D(exponent);
        double f = av / exp10;
        double nf = 10.0;
        if (roundMode) {
            if (f < 1.5) { nf = 1.0; }
            else if (f < 2.5) { nf = 2.0; }
            else if (f < 4.0) { nf = 3.0; }
            else if (f < 7.0) { nf = 5.0; }
            else { nf = 10.0; }
        } else {
            if (f < 1.0) { nf = 1.0; }
            else if (f < 2.0) { nf = 2.0; }
            else if (f < 3.0) { nf = 3.0; }
            else if (f < 5.0) { nf = 5.0; }
            else { nf = 10.0; }
        }
        int p = 0 - exponent;
        if (p < 0) { p = 0; }
        double r = Chart.RoundP(nf * exp10, p);
        return val < 0.0 ? 0.0 - r : r;
    }

    // minInterval, maxInterval)`。
    // precision = getIntervalPrecision(interval)
    // minInterval/maxInterval 传 ChartOption.AutoD() 表示不设。
    public static void IntervalScaleNiceTicks(double e0, double e1, int splitNumber,
                                       double minInterval, double maxInterval,
                                       out double interval, out int precision,
                                       out double nt0, out double nt1) {
        double span = e1 - e0;
        double sp = splitNumber > 0 ? span / (double)splitNumber : span;
        interval = Chart.NiceMode(sp, true);
        if (!ChartOption.IsAutoD(minInterval) && interval < minInterval) {
            interval = minInterval;
        }
        if (!ChartOption.IsAutoD(maxInterval) && interval > maxInterval) {
            interval = maxInterval;
        }
        precision = Chart.GetIntervalPrecision(interval);
        if (interval == 0.0) { nt0 = e0; nt1 = e1; return; }
        nt0 = Chart.RoundP(Math.Ceiling(e0 / interval) * interval, precision);
        nt1 = Chart.RoundP(Math.Floor(e1 / interval) * interval, precision);
    }


    // `scale/helper.ts:125 increaseInterval(niceInterval)`：把 nice 步长
    // 抬到下一个 nice 值（f 是十进制系数）——1→2、2→3、3→5、5→10。
    // 用于 alignTicks 的 `loopIncreaseInterval` 搜索。
    public static double IncreaseInterval(double iv) {
        if (iv <= 0.0) { return 1.0; }
        int e = Chart.QuantityExponent(iv);
        double exp10 = Chart.Pow10D(e);
        double f = Chart.RoundP(iv / exp10, 0);
        if (f == 0.0) { f = 1.0; }
        else if (f == 2.0) { f = 3.0; }
        else if (f == 3.0) { f = 5.0; }
        else { f = f * 2.0; }
        return Chart.RoundP(f * exp10, e < 0 ? 0 - e : 0);
    }

    // A11：`axisNiceTicks.ts:130-138` 的 minInterval/maxInterval 钳制。
    // 先按 NiceRange 解出引擎自己的 nice 区间，算出等效步长
    // interval = (hi−lo)/ticks；若被钳制改变，则用钳后的步长重解端点
    // （`niceExtent = [ceil(e0/iv)·iv, floor(e1/iv)·iv]`，出处同文件
    // :140-143）。**未声明钳制的轴走原路，逐像素不变**。
    // 注意本引擎 nice 是 ECharts smartSteps（1/2/2.5/5），
    // 与 6.1 的 1/2/5 端点天然不同——钳制语义（往哪边推）才是可移植的。
    public static ChartSpan ClampNiceRange(int dataLo, int dataHi, bool scale,
                                    double minInterval, double maxInterval) {
        ChartSpan s = Chart.NiceRange(dataLo, dataHi, scale);
        if (ChartOption.IsAutoD(minInterval) && ChartOption.IsAutoD(maxInterval)) { return s; }
        if (s.ticks < 1) { return s; }
        double iv0 = (double)(s.hi - s.lo) / (double)s.ticks;
        if (iv0 <= 0.0) { return s; }
        double iv = iv0;
        if (!ChartOption.IsAutoD(minInterval) && iv < minInterval) { iv = minInterval; }
        if (!ChartOption.IsAutoD(maxInterval) && iv > maxInterval) { iv = maxInterval; }
        if (iv == iv0) { return s; }
        int p = Chart.GetIntervalPrecision(iv);
        // niceExtent = [ceil(e0/iv)·iv, floor(e1/iv)·iv] 落在数据域内部；
        // 但轴的 extent 不得被缩小（Interval.ts:238-282 的
        // 两个补 tick 分支：域外的那一格被推
        // 成 niceExtent ± interval）——数据超出的那一格
        // 必须补回来（min=2 时 0..3 官方出 0..4）。
        double nlo = Chart.RoundP(Math.Ceiling((double)dataLo / iv) * iv, p);
        double nhi = Chart.RoundP(Math.Floor((double)dataHi / iv) * iv, p);
        if (nlo > (double)dataLo) { nlo = Chart.RoundP(nlo - iv, p); }
        if (nhi < (double)dataHi) { nhi = Chart.RoundP(nhi + iv, p); }
        if (nhi <= nlo) { nhi = nlo + iv; }
        ChartSpan r = new ChartSpan();
        r.lo = (int)(nlo >= 0.0 ? nlo + 0.5 : nlo - 0.5);
        r.hi = (int)(nhi >= 0.0 ? nhi + 0.5 : nhi - 0.5);
        if (r.hi <= r.lo) { r.hi = r.lo + 1; }
        int nt = (int)Chart.RoundP(((double)r.hi - (double)r.lo) / iv, 0);
        r.ticks = nt < 1 ? 1 : nt;
        return r;
    }

    // ECharts 6.1 IntervalScale 自动量程（源对抄 scale/helper.js
    // Interval.js getTicks 的两个域外补格分支）。SSR 校准 8 组数据
    // 逐例复现：interval = nice(span/5, round)——round 档是
    // 1/2/3/5/10（f 阈值 1.5/2.5/4/7；smartSteps 智能阶梯
    // 官方 300 步 → 0..1500）；
    // 刻度界向内取整（ceil lo / floor hi），原始域溢出端向外补一格。
    // minInterval/maxInterval 非 Auto 时按 helper.js 钳制步长。
    // 0 锚不在此做（AxisLo/AxisHi 已按 scale 语义并入）。
    public static ChartSpan NiceSpan6(int dataLo, int dataHi, double minInterval,
                               double maxInterval) {
        long span = (long)dataHi - (long)dataLo;
        if (span <= 0) { span = 1; }
        long rough = span / 5;
        if (rough < 1) { rough = 1; }
        // 档位判据用 ×10 定点整数——f 的实数阈值 1.5/2.5/4/7，
        // 截断到整数会把 1.564 误判进 1 档。
        long exp10 = 1;
        while (rough / exp10 >= 10) { exp10 = exp10 * 10; }
        long f10 = rough * 10 / exp10;
        long nf;
        if (f10 < 15) { nf = 1; }
        else if (f10 < 25) { nf = 2; }
        else if (f10 < 40) { nf = 3; }
        else if (f10 < 70) { nf = 5; }
        else { nf = 10; }
        long iv = nf * exp10;
        if (!ChartOption.IsAutoD(minInterval) && (double)iv < minInterval) {
            iv = (long)minInterval;
        }
        if (!ChartOption.IsAutoD(maxInterval) && (double)iv > maxInterval) {
            iv = (long)maxInterval;
        }
        if (iv < 1) { iv = 1; }
        // 向内取整（helper.js niceTickExtent）；负值要数学 ceil/floor，
        // Zan 的 / 向零截断，走 FloorDivQ/CeilDivQ。
        long loT = (long)Chart.CeilDivQ(dataLo, (int)iv) * iv;
        long hiT = (long)Chart.FloorDivQ(dataHi, (int)iv) * iv;
        // 原始域溢出端向外补一格（Interval.js getTicks 的
        // extent[0] < niceExtent[0] / extent[1] > lastNiceTick 分支；
        // 向内取整保证各至多一格）。
        if (loT > dataLo) { loT = loT - iv; }
        if (hiT < dataHi) { hiT = hiT + iv; }
        ChartSpan r = new ChartSpan();
        r.lo = (int)loT;
        r.hi = (int)hiT;
        r.ticks = (int)((hiT - loT) / iv);
        if (r.ticks < 1) { r.ticks = 1; }
        return r;
    }

    // A12：`coord/axisAlignTicks.ts scaleCalcAlign` 的单侧实现——把目标轴
    // 解成与对齐轴**段数相同、刻度对齐**的量程。`alignToSegs` = 对齐轴
    // 的段数；`dataLo/dataHi` 是目标轴的原始 extent（incl0 已并入）。
    // 对应源码 :250-300 的 `targetMinMaxFixed` 双 false 分支：
    // 段数不足 alignToNiceSegCount 时按 incl0/居中规则向两侧补格，
    // 直到 [min,max] 覆盖原 extent。
    // 调用方给的单位是"轴自己的单位"（整数轴=值，小数轴=×1000 定点，
    // 时间轴=天），因此同一函数三处复用。
    public static ChartSpan AlignRange(double dataLo, double dataHi, int alignToSegs,
                                bool incl0) {
        if (alignToSegs < 1) { alignToSegs = 1; }
        // incl0 时先做与 NiceRange 同一个零锚定
        // （Chart.zan 的 NiceRange 原文 :1552-1555，出处 valueAxis
        // _reformValue）：全正数据下界归零、
        // 全负数据上界归零。不做这一步
        // 就会把 2000..23400 对成 -10000..30000
        // （官方 0..40000）——零锚定是
        // incl0 的前提，不是可选补丁。
        if (incl0) {
            if (dataLo >= 0.0 && dataHi >= 0.0) { dataLo = 0.0; }
            if (dataLo <= 0.0 && dataHi <= 0.0) { dataHi = 0.0; }
        }
        double span = dataHi - dataLo;
        if (span <= 0.0) { span = 1.0; }
        double iv = Chart.NiceMode(span / (double)alignToSegs, false);
        if (iv <= 0.0) { iv = 1.0; }
        double nlo = dataLo;
        double nhi = dataHi;
        for (int guard = 0; guard < 64; guard = guard + 1) {
            int p = Chart.GetIntervalPrecision(iv);
            nlo = Chart.RoundP(Math.Ceiling(dataLo / iv) * iv, p);
            nhi = Chart.RoundP(Math.Floor(dataHi / iv) * iv, p);
            int cnt = (int)Chart.RoundP((nhi - nlo) / iv, 0);
            if (cnt <= alignToSegs) {
                int more = alignToSegs - cnt;
                double mlo = 0.0;
                double mhi = 0.0;
                if (incl0 && dataLo == 0.0) { mlo = 0.0; mhi = (double)more; }
                else if (incl0 && dataHi == 0.0) { mlo = (double)more; mhi = 0.0; }
                else {
                    int half = more / 2;
                    if (more % 2 == 0) { mlo = (double)half; mhi = (double)half; }
                    else if (nlo + nhi < dataLo + dataHi) {
                        mlo = (double)half; mhi = (double)(half + 1);
                    } else {
                        mlo = (double)(half + 1); mhi = (double)half;
                    }
                }
                nlo = Chart.RoundP(nlo - iv * mlo, p);
                nhi = Chart.RoundP(nhi + iv * mhi, p);
                if (nlo <= dataLo && nhi >= dataHi) { break; }
            }
            iv = Chart.IncreaseInterval(iv);
        }
        ChartSpan r = new ChartSpan();
        r.lo = (int)(nlo >= 0.0 ? nlo + 0.5 : nlo - 0.5);
        r.hi = (int)(nhi >= 0.0 ? nhi + 0.5 : nhi - 0.5);
        if (r.hi <= r.lo) { r.hi = r.lo + 1; }
        r.ticks = alignToSegs;
        return r;
    }

    // A12 minorTick 的刻度序列：scale/minorTicks.ts:22-81
    // 每两个相邻 nice 刻度之间均分 splitNumber
    // 段，取内部点，且严格落在
    // [extent0, extent1] 内（源码 :50 `minorTick > extent[0] &&
    // minorTick < extent[1]`）——首末段因数不足而被
    // 截掉的点就是这条规则。
    // 入参域与 splitNumber 均为轴自己的单位
    // （整数轴=值，小数轴=×1000 定点）。
    // 对数轴版：刻度不等距（每个十倍），
    // 不能用均分版。源码同 minorTicks.ts:41-63
    // 的对点循环：逐对在**原值**空间插值
    // （minorTick = prev + (c+1)*interval/splitNumber），再经对数映射落像素
    // ——所以 1..10 的细分点是 2.8/4.6/6.4/8.2
    // 而不是对数均分点（官方
    // _scratch/a12_log.js 实测）。
    public static void MinorTickValuesPairs(List<int> ticks, int splitNumber,
                                    List<double> into) {
        if (splitNumber < 2 || ticks.Count < 2) { return; }
        double e0 = (double)ticks[0];
        double e1 = (double)ticks[ticks.Count - 1];
        for (int i = 1; i < ticks.Count; i = i + 1) {
            double prev = (double)ticks[i - 1];
            double interval = (double)ticks[i] - prev;
            if (interval <= 0.0) { continue; }
            double minorInterval = interval / (double)splitNumber;
            int p = Chart.GetIntervalPrecision(minorInterval);
            for (int c = 1; c < splitNumber; c = c + 1) {
                double mt = Chart.RoundP(prev + (double)c * minorInterval, p);
                if (mt > e0 && mt < e1) { into.Add(mt); }
            }
        }
    }

    public static void MinorTickValues(double e0, double e1, int segs, int splitNumber,
                                List<double> into) {
        if (segs < 1 || splitNumber < 2) { return; }
        double interval = (e1 - e0) / (double)segs;
        if (interval == 0.0) { return; }
        double minorInterval = interval / (double)splitNumber;
        int p = Chart.GetIntervalPrecision(minorInterval);
        for (int g = 0; g < segs; g = g + 1) {
            double prev = e0 + interval * (double)g;
            for (int c = 1; c < splitNumber; c = c + 1) {
                double mt = Chart.RoundP(prev + (double)c * minorInterval, p);
                if (mt > e0 && mt < e1) { into.Add(mt); }
            }
        }
    }


    // 系列是否归属指定目标轴：若整个图表/子网格只有单 Y 轴（!hasRight），
    // 则无论是何 axisIndex（如多 grid 默认按原全局下标 1 传入），均统一归属该单轴（axisIndex 0）；
    // 存在双 Y 轴时严格按 series.axisIndex 匹配。
    public static bool SeriesMatchesAxis(ChartSeries s, int axisIndex, bool hasRight) {
        if (s.hidden) { return false; }
        if (!hasRight) { return axisIndex == 0; }
        return s.axisIndex == axisIndex;
    }

    // AxisMinFor 的 1/1000 定点对偶：与 AxisMaxForF 成对——原始
    // 数据下界直传（不许钳零），小数轴量程专用。i0/i1 窗口语义
    // 同 AxisMaxFor。
    public static int AxisMinForF(List<ChartSeries> series, int axisIndex, int i0, int i1, bool scale) {
        return Chart.AxisMinForF(series, axisIndex, i0, i1, scale, true);
    }

    public static int AxisMinForF(List<ChartSeries> series, int axisIndex, int i0, int i1, bool scale, bool hasRight) {
        int mn = 0;
        // !scale：0 本身算一个候选点（`_reformValue` 的同号归零前置条件）；
        // scale：0 不参与，必须扫到真实数据才更新（否则正数据轴会被锚到 0）。
        bool any = !scale;
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            if (Chart.SeriesMatchesAxis(s, axisIndex, hasRight)) {
                int j0 = 0; int j1 = s.Count() - 1;
                if (i0 >= 0 && i1 >= 0) {
                    j0 = i0; j1 = i1;
                    if (j0 > s.Count() - 1) { j0 = s.Count() - 1; }
                    if (j1 > s.Count() - 1) { j1 = s.Count() - 1; }
                    if (j1 < j0) { j1 = j0; }
                }
                for (int j = j0; j <= j1; j = j + 1) {
                    double v = s.Number(j);
                    int vi = (int)(v * 1000 + (v >= 0 ? 0.5 : 0 - 0.5));
                    if (!any || vi < mn) { mn = vi; any = true; }
                }
                // 类目 data 系列（`data:[2,7,...]`）没有点坐标。dataZoom
                // 窗口下 i0/i1>=0，p0/p1 会被钳成 -1，而 `j2 <= p1` 在
                // p0==p1==-1 时为真 → s.points[-1] 越界（bump-chart 的
                // list index out of bounds）。空表跳过点坐标段（上面的
                // data 段已计完）。
                if (s.points.Count < 1) { continue; }
                int p0 = 0; int p1 = s.points.Count - 1;
                if (i0 >= 0 && i1 >= 0) {
                    p0 = i0; p1 = i1;
                    if (p0 > s.points.Count - 1) { p0 = s.points.Count - 1; }
                    if (p1 > s.points.Count - 1) { p1 = s.points.Count - 1; }
                    if (p1 < p0) { p1 = p0; }
                }
                for (int j2 = p0; j2 <= p1; j2 = j2 + 1) {
                    int py = Chart.PointV(s.points[j2].y, s.pointG) * 1000;
                    if (!any || py < mn) { mn = py; any = true; }
                }
            }
        }
        return mn;
    }

    // 轴上是否存在共享 stackName 的柱族系列（堆叠柱）。小数堆叠柱
    // 的量程须按类目堆叠和推导，逐项极值会低估堆叠顶
    // （normalization 各项 ≤0.57、堆叠顶达 1.0）。
    public static bool HasStackedBarsF(List<ChartSeries> series, int axisIndex) {
        return Chart.HasStackedBarsF(series, axisIndex, true);
    }

    public static bool HasStackedBarsF(List<ChartSeries> series, int axisIndex, bool hasRight) {
        List<string> grp = new List<string>();
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            if (!Chart.SeriesMatchesAxis(s, axisIndex, hasRight)) { continue; }
            if (!ChartView.IsBarFamily(s.type)) { continue; }
            // 默认空 stackName 不是堆叠组：分组柱状图（各系列独立
            // 并排）的量程必须按单值上限，不能按堆叠和——否则凡
            // ≥2 系列的分组柱轴都虚高 2-4 倍（ECharts stack 缺省
            // 即无堆叠）。
            if (s.stackName.Length == 0 && s.stack == 0) { continue; }
            if (ChartView.GroupIndex(grp, s.stackName) >= 0) { return true; }
            grp.Add(s.stackName);
        }
        // 堆叠面积折线（confidence-band L/U）同样抬升定点量程。
        for (int i2 = 0; i2 < series.Count; i2 = i2 + 1) {
            ChartSeries s2 = series[i2];
            if (!Chart.SeriesMatchesAxis(s2, axisIndex, hasRight)) { continue; }
            if (!ChartView.IsLineFamily(s2.type)) { continue; }
            if (s2.stackName.Length == 0 && s2.stack == 0) { continue; }
            return true;
        }
        return false;
    }

    // 堆叠柱（共享 stackName 的柱族）逐类目正/负堆叠和（×1000
    // 定点）：hi = 正累加器最大值，lo = 负累加器最小值。正负独立
    // 累计与渲染路径同一语义（负段不与正段相加）。
    // i0/i1 窗口语义同 AxisMaxFor：限制各类目逐组累加到可见段
    // （与 ECharts filterMode:'weakFilter' Y 重定一致）。
    public static ChartSpan StackExtentF(List<ChartSeries> series, int axisIndex, int i0, int i1) {
        return Chart.StackExtentF(series, axisIndex, i0, i1, true);
    }

    public static ChartSpan StackExtentF(List<ChartSeries> series, int axisIndex, int i0, int i1, bool hasRight) {
        List<string> grp = new List<string>();
        for (int g = 0; g < series.Count; g = g + 1) {
            ChartSeries cs = series[g];
            if (!Chart.SeriesMatchesAxis(cs, axisIndex, hasRight)) { continue; }
            if (!ChartView.IsBarFamily(cs.type)) { continue; }
            if (ChartView.GroupIndex(grp, cs.stackName) < 0) { grp.Add(cs.stackName); }
        }
        int ng = grp.Count;
        if (ng < 1) { ng = 1; }
        int n = 0;
        for (int c = 0; c < series.Count; c = c + 1) {
            ChartSeries cs2 = series[c];
            if (!cs2.hidden && cs2.axisIndex == axisIndex
                && ChartView.IsBarFamily(cs2.type)) {
                if (cs2.Count() > n) { n = cs2.Count(); }
            }
        }
        int loI = (i0 >= 0 && i1 >= 0) ? i0 : 0;
        int hiI = (i0 >= 0 && i1 >= 0) ? i1 : n - 1;
        if (loI > n - 1) { loI = n - 1; }
        if (hiI > n - 1) { hiI = n - 1; }
        if (hiI < loI) { hiI = loI; }
        int hi = 0;
        int lo = 0;
        // A9：组内顶端值走 processor/dataStack.ts 的
        // stackStrategy 链（逐系列取各自声明的策略）。
        // 旧的“正负双累加器”在“负值后跟 0”时与官方
        // 分岔（[10,-8,0] 官方给 -8/-8，旧给 10/10）。
        List<double> tops = new List<double>();
        for (int i = loI; i <= hiI; i = i + 1) {
            tops.Clear();
            ChartView.StackTopAll(series, i, tops);
            for (int s2 = 0; s2 < series.Count; s2 = s2 + 1) {
                ChartSeries cs3 = series[s2];
                if (cs3.hidden || cs3.axisIndex != axisIndex
                    || !ChartView.IsBarFamily(cs3.type)) { continue; }
                int gi = ChartView.GroupIndex(grp, cs3.stackName);
                if (gi < 0) { gi = 0; }
                if (i >= cs3.Count()) { continue; }
                double dv = cs3.Number(i);
                int vF = (int)(dv * 1000.0 + (dv >= 0 ? 0.5 : 0 - 0.5));
                double topD = s2 < tops.Count ? tops[s2] : 0.0;
                int topF = (int)(topD * 1000.0 + (topD >= 0 ? 0.5 : 0 - 0.5));
                if (topF > hi) { hi = topF; }
                if (topF - vF < lo) { lo = topF - vF; }
            }
        }
        // 堆叠面积折线（confidence-band L/U 带、stream-graph）：与
        // 柱族不同，渲染按原始值逐类累计（prev+val 链），极值取
        // 各类目全体堆叠折线之和（正负不分组）。
        int ln = 0;
        for (int c2 = 0; c2 < series.Count; c2 = c2 + 1) {
            ChartSeries cs4 = series[c2];
            if (!cs4.hidden && cs4.axisIndex == axisIndex
                && ChartView.IsLineFamily(cs4.type)
                && (cs4.stackName.Length > 0 || cs4.stack != 0)) {
                if (cs4.Count() > ln) { ln = cs4.Count(); }
            }
        }
        int loI3 = (i0 >= 0 && i1 >= 0) ? i0 : 0;
        int hiI3 = (i0 >= 0 && i1 >= 0) ? i1 : ln - 1;
        if (loI3 > ln - 1) { loI3 = ln - 1; }
        if (hiI3 > ln - 1) { hiI3 = ln - 1; }
        if (hiI3 < loI3) { hiI3 = loI3; }
        for (int i3 = loI3; i3 <= hiI3; i3 = i3 + 1) {
            int accL = 0;
            for (int s4 = 0; s4 < series.Count; s4 = s4 + 1) {
                ChartSeries cs5 = series[s4];
                if (cs5.hidden || cs5.axisIndex != axisIndex
                    || !ChartView.IsLineFamily(cs5.type)
                    || (cs5.stackName.Length == 0 && cs5.stack == 0)) {
                    continue;
                }
                if (i3 >= cs5.Count()) { continue; }
                double dv2 = cs5.Number(i3);
                accL = accL + (int)(dv2 * 1000.0 + (dv2 >= 0 ? 0.5 : 0 - 0.5));
            }
            if (accL > hi) { hi = accL; }
            if (accL < lo) { lo = accL; }
        }
        ChartSpan sp = new ChartSpan();
        sp.lo = lo;
        sp.hi = hi;
        sp.ticks = 5;
        return sp;
    }

    // 小数轴 extent 下界（×1000 定点）：固定 min 直接生效，否则
    // 原始数据下界直传（不预设 nice——向下取整是 smartSteps 的
    // 职责，valueAxis._calculateValue 语义）。堆叠柱并入类目堆叠
    // 和的负向极值。i0/i1 窗口语义同 AxisMaxFor。
    public static int FracAxisLoF(int fixedLo, List<ChartSeries> series, int axisIndex, int i0, int i1,
                           bool scale) {
        return Chart.FracAxisLoF(fixedLo, series, axisIndex, i0, i1, scale, true);
    }

    public static int FracAxisLoF(int fixedLo, List<ChartSeries> series, int axisIndex, int i0, int i1,
                           bool scale, bool hasRight) {
        if (fixedLo != ChartOption.Auto()) { return fixedLo * 1000; }
        int lo = Chart.AxisMinForF(series, axisIndex, i0, i1, scale, hasRight);
        if (Chart.HasStackedBarsF(series, axisIndex, hasRight)) {
            ChartSpan se = Chart.StackExtentF(series, axisIndex, i0, i1, hasRight);
            if (se.lo < lo) { lo = se.lo; }
        }
        return lo;
    }

    // 小数轴 extent 上界（×1000 定点）：固定 max 直接生效，否则
    // 原始数据上界直传。堆叠柱并入类目堆叠和的正向极值。
    // i0/i1 窗口语义同 AxisMaxFor。
    public static int FracAxisHiF(int fixedHi, List<ChartSeries> series, int axisIndex, int i0, int i1,
                           bool scale) {
        return Chart.FracAxisHiF(fixedHi, series, axisIndex, i0, i1, scale, true);
    }

    public static int FracAxisHiF(int fixedHi, List<ChartSeries> series, int axisIndex, int i0, int i1,
                           bool scale, bool hasRight) {
        if (fixedHi != ChartOption.Auto()) { return fixedHi * 1000; }
        int hi = Chart.AxisMaxForF(series, axisIndex, i0, i1, scale, hasRight);
        if (Chart.HasStackedBarsF(series, axisIndex, hasRight)) {
            ChartSpan se = Chart.StackExtentF(series, axisIndex, i0, i1, hasRight);
            if (se.hi > hi) { hi = se.hi; }
        }
        return hi;
    }

    // a / b 的数学 floor（Zan 的 / 与 % 向零截断）。
    public static int FloorDivQ(int a, int b) {
        int q = a / b;
        if (a % b != 0 && a < 0) { q = q - 1; }
        return q;
    }

    // a / b 的数学 ceil。
    public static int CeilDivQ(int a, int b) {
        int q = a / b;
        if (a % b != 0 && a > 0) { q = q + 1; }
        return q;
    }

    // 十进制位数（v ≥ 1）。
    public static int DecDigits(int v) {
        int n = 1;
        while (v >= 10) { v = v / 10; n = n + 1; }
        return n;
    }

    // 去掉十进制尾部 0（全精度有效位计数用）。
    public static int StripZeros(int v) {
        while (v > 0 && v % 10 == 0) { v = v / 10; }
        return v;
    }

    // JS Math.round(q / 2)（半数朝 +∞，q 可为负）。
    public static int JSRoundHalf(int q) {
        if (q >= 0) { return (q + 1) / 2; }
        return q / 2;
    }

    // expNum(num/den, 2 位精度，向上)：v = num/den ≥ 0 的两位有效数
    // 上近似。对应 smartSteps 里 getCeil/expSpan 的 expNum(v, 2)。
    public static ChartExp ExpNum2Rat(int num, int den) {
        ChartExp r = new ChartExp();
        r.c = 0;
        r.e = 0;
        if (num <= 0 || den <= 0) { return r; }
        int k;
        if (num >= den) {
            k = Chart.DecDigits(num / den) - 1;
        } else {
            k = 0;
            int p = num;
            while (p < den) { p = p * 10; k = k - 1; }
        }
        int expon = k - 1;
        // Pow10 只服务非负指数，k ≥ 1 时改走除法表达 10^(1-k)。
        int scaled;
        if (k >= 1) {
            scaled = Chart.CeilDivQ(num, den * Chart.Pow10(k - 1));
        } else {
            scaled = Chart.CeilDivQ(num * Chart.Pow10(1 - k), den);
        }
        if (scaled >= 100) { scaled = scaled / 10; expon = expon + 1; }
        r.c = scaled;
        r.e = expon;
        return r;
    }

    // expNum(n, 全精度)：整数 n 的精确分解（c × 10^e = n）。
    // byFloor 只在指数对齐除法时区分 floor/ceil。
    public static ChartExp ExpNumFull(int n, bool byFloor) {
        ChartExp r = new ChartExp();
        r.c = 0;
        r.e = 0;
        if (n == 0) { return r; }
        int ad = n < 0 ? 0 - n : n;
        int digit = Chart.DecDigits(Chart.StripZeros(ad));
        int expon = Chart.DecDigits(ad) - digit;
        r.e = expon;
        r.c = n / Chart.Pow10(expon);
        return r;
    }

    // getCeil：两位尾数向上吸附到步长备选 [10,20,25,50]。
    public static void SmartCeilStep(ChartExp n) {
        if (n.c <= 10) { n.c = 10; return; }
        if (n.c <= 20) { n.c = 20; return; }
        if (n.c <= 25) { n.c = 25; return; }
        if (n.c <= 50) { n.c = 50; return; }
        n.e = n.e + 1;
        n.c = 10;
    }

    // expFixTo：把 x 的指数对齐到 ref（缩指数乘 10 精确，升指数
    // 按 byFloor floor / 否则 ceil 除）。
    public static void ExpAlign(ChartExp x, ChartExp refx, bool byFloor) {
        int delta = refx.e - x.e;
        if (delta == 0) { return; }
        x.e = refx.e;
        if (delta < 0) {
            x.c = x.c * Chart.Pow10(0 - delta);
        } else {
            int q = Chart.Pow10(delta);
            x.c = byFloor ? Chart.FloorDivQ(x.c, q) : Chart.CeilDivQ(x.c, q);
        }
    }

    // smartSteps 的 forInteger：跨度小于段数时向两侧延展跨度
    // （section ≤ 0 时取 5 段），输出压回与原数据同侧。
    public static ChartSpan SmartForInteger(int min, int max, int section) {
        if (section < 1) { section = 5; }
        int delta = section - (max - min);
        int newMin = Chart.JSRoundHalf(min * 2 - delta);
        int newMax = Chart.JSRoundHalf(max * 2 + delta);
        if (min >= 0 && newMin < 0) {
            newMax = newMax - newMin;
            newMin = 0;
        } else if (max <= 0 && newMax > 0) {
            newMin = newMin - newMax;
            newMax = 0;
        }
        ChartSpan s = new ChartSpan();
        s.lo = newMin;
        s.hi = newMax;
        s.ticks = section;
        return s;
    }

    // smartSteps 的 tryForInt：原最值同号（含 0）时尽量取整数步长，
    // 剩余误差向两侧均衡（可能改写 expMin/expMax 并强制 e = 0）。
    public static int SmartTryForInt(int min, int max, ChartExp expMin, ChartExp expMax, int secs) {
        int span = expMax.c - expMin.c;
        int expon = expMax.e;
        int step;
        bool stepInt;
        if (expon >= 0) {
            int num = span * Chart.Pow10(expon);
            step = num / secs;
            stepInt = num % secs == 0;
        } else {
            int den = secs * Chart.Pow10(0 - expon);
            step = span / den;
            stepInt = span % den == 0;
        }
        if (stepInt) { return secs; }
        int spanN = step * secs;
        if (spanN < max - min) {
            step = step + 1;
            spanN = step * secs;
            // section = 0（自适应段数）恒走这一支。
            if (step * (secs - 1) >= max - min) {
                secs = secs - 1;
                spanN = step * secs;
            }
        }
        if (spanN >= max - min) {
            int delta = spanN - (max - min);
            expMin.c = Chart.JSRoundHalf(min * 2 - delta);
            expMax.c = Chart.JSRoundHalf(max * 2 + delta);
            expMin.e = 0;
            expMax.e = 0;
        }
        return secs;
    }

    // smartSteps 的 coreCalc（section = 0 自适应路径）：
    // 步长基准取 ceil(span/6)，段数在 [6,5,4] 中选（调整后跨度最小、
    // 同跨度步长小者胜），整数输入尽量整数步长并均衡误差。
    public static ChartSpan SmartCoreCalc(int min, int max) {
        ChartExp expStep = Chart.ExpNum2Rat(max - min, 6);
        Chart.SmartCeilStep(expStep);
        ChartExp expSpan = Chart.ExpNum2Rat(max - min, 1);
        ChartExp expMin = Chart.ExpNumFull(min, true);
        ChartExp expMax = Chart.ExpNumFull(max, false);
        Chart.ExpAlign(expSpan, expStep, false);
        Chart.ExpAlign(expMin, expStep, true);
        Chart.ExpAlign(expMax, expStep, false);

        // look4sections。对齐单位可能是 10^e（e < 0 的细步长），
        // 整体放大 100 倍参与整数运算，随后把指数一并回退 2。
        int baseC = expMin.c * 100;
        int spanC = (expMax.c - expMin.c) * 100;
        int bestSpan = 0;
        int bestStep = 0;
        int bestMin = 0;
        int bestMax = 0;
        for (int section = 6; section >= 4; section = section - 1) {
            ChartExp ts = Chart.ExpNum2Rat(spanC, section);
            Chart.SmartCeilStep(ts);
            int stepN = ts.c * Chart.Pow10(ts.e);
            int tMin = Chart.FloorDivQ(baseC, stepN) * stepN;
            int tMax = Chart.CeilDivQ(baseC + spanC, stepN) * stepN;
            int sp = tMax - tMin;
            if (section == 6 || sp < bestSpan || (sp == bestSpan && stepN < bestStep)) {
                bestSpan = sp;
                bestStep = stepN;
                bestMin = tMin;
                bestMax = tMax;
            }
        }
        int secs = bestSpan / bestStep;
        if (secs < 3) { secs = secs * 2; }
        expMin.c = bestMin;
        expMin.e = expStep.e - 2;
        expMax.c = bestMax;
        expMax.e = expStep.e - 2;

        // 原最值同号（reform 后必有一端为 0）时尝试整数步长。
        if (min * max >= 0) {
            if (max - min < secs) { return Chart.SmartForInteger(min, max, secs); }
            secs = Chart.SmartTryForInt(min, max, expMin, expMax, secs);
        }
        // cross0：原数据在某侧时输出压回同侧。
        if (min >= 0 && expMin.c < 0) {
            expMax.c = expMax.c - expMin.c;
            expMin.c = 0;
        } else if (max <= 0 && expMax.c > 0) {
            expMin.c = expMin.c - expMax.c;
            expMax.c = 0;
        }
        // makeResult 对整数输入在 lo/hi 上是恒等（只影响小数位与
        // 标签数组），按各自指数还原即可。
        ChartSpan sp2 = new ChartSpan();
        sp2.lo = Chart.ExpRestore(expMin);
        sp2.hi = Chart.ExpRestore(expMax);
        sp2.ticks = secs;
        return sp2;
    }

    // c × 10^e 的整数还原（e < 0 时 c 必是 10^-e 的倍数）。
    public static int ExpRestore(ChartExp x) {
        if (x.e >= 0) { return x.c * Chart.Pow10(x.e); }
        return x.c / Chart.Pow10(0 - x.e);
    }

    // ECharts valueAxis 自动刻度（与演示站一致）：
    // 内层是 src/util/smartSteps.js（section=0 自适应路径）的忠实
    // 移植，外层套 valueAxis._reformValue 的非 scale 规则——
    // 同号数据一端归零（全正 min→0、全负 max→0）与 min==max 整形。
    // -2..15 → -5..15/4 段、0..1320 → 0..1500/6 段、0..2570 →
    // 0..3000/6 段。固定 min/max 不走此函数（尊重不取整）。
    public static ChartSpan NiceRange(int lo, int hi) {
        return Chart.NiceRange(lo, hi, false);
    }

    // scale 版（axis.scale:true）：跳过 `_reformValue` 的同号归零——
    // 出处 ECharts `component/valueAxis.js:666 _reformValue(scale)`：
    // 其余（min==max 整形、smartSteps）与 !scale 完全一致。
    public static ChartSpan NiceRange(int lo, int hi, bool scale) {
        int min = lo;
        int max = hi;
        if (max < min) {
            int tmp = min;
            min = max;
            max = tmp;
        }
        if (min == max) {
            // valueAxis 的 min==max 修复：全 0 → max=1；正数把 min
            // 压到 0（源码 splitNumber ?? 5 实际取 null→0）；负数把
            // max 抬到 0。此段在源码里位于 _reformValue 之前
            // （_calculateValue 内），不受 scale 影响。
            if (max == 0) {
                max = 1;
            } else if (max > 0) {
                min = 0;
            } else {
                max = 0;
            }
        }
        if (!scale) {
            if (min >= 0 && max >= 0) { min = 0; }
            if (min <= 0 && max <= 0) { max = 0; }
        }
        if (min == max) { max = min + 1; }
        if (max - min < 5) {
            return Chart.SmartForInteger(min, max, 0);
        }
        return Chart.SmartCoreCalc(min, max);
    }

    // ECharts valueAxis scale:true（不强制含 0）+ boundaryGap
    // [0.01,0.01] 的量程：数据域两端各外扩 1% 后对齐 nice 步长
    // （1/2/2.5/5×10^k，splitNumber 5 预估），一端不归零——若按
    // NiceRange 的非 scale 规则把全正数据零锚定，2200..2450 的
    // 蜡烛会被压进 0..2500 步长 500 的底部。k1 原版 → 2200..2450
    // 步长 50。
    public static ChartSpan ScaleRange(int lo, int hi) {
        if (hi < lo) {
            int tmp = lo;
            lo = hi;
            hi = tmp;
        }
        if (lo == hi) { hi = lo + 1; }
        int pad = (hi - lo) / 100;
        if (pad < 1) { pad = 1; }
        return Chart.ScatterAutoRange(lo - pad, hi + pad);
    }

    // 全部系列中的最大值（隐藏系列不计），下界 0。
    public static int MaxOf(List<ChartSeries> series) {
        int mx = 0;
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            for (int j = 0; j < s.Count(); j = j + 1) { if (s.Value(j) > mx) { mx = s.Value(j); } }
        }
        return mx;
    }

    // 系列中的最小值（无负数时为 0，隐藏系列不计）。水平条 / 旋风图用
    // 它把轴下界扩到 0 以下，而不是把负值裁成空柱。
    public static int MinOf(List<ChartSeries> series) {
        int mn = 0;
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            if (!s.hidden) {
                for (int j = 0; j < s.Count(); j = j + 1) {
                    if (s.Value(j) < mn) { mn = s.Value(j); }
                }
            }
        }
        return mn;
    }

    // 数值 → 水平像素：plotX 对应 lo，plotX+plotW 对应 hi。
    // 大数值 × plotW 会超 int32（bar3 Population 到百万：
    // 1000000×2601≈2.6e9），乘法走 long。
    public static int ValueX(int plotX, int plotW, int lo, int hi, int v) {
        long span = (long)hi - (long)lo;
        if (span < 1) { span = 1; }
        return plotX + (int)(((long)v - (long)lo) * (long)plotW / span);
    }

    // 定点数值 → 水平像素：v 以 值×g 承载（PointV 约定），分母按
    // span×g 缩放后再除——亚单位像素精度不丢（先 PointV 取整会把
    // 小数坐标量化到整数值格点，scatter3 的 3 位小数云会塌成点阵）。
    public static int ValueXF(int plotX, int plotW, int lo, int hi, int v, int g) {
        if (g <= 1) { return Chart.ValueX(plotX, plotW, lo, hi, v); }
        long span = ((long)hi - (long)lo) * (long)g;
        if (span < 1) { span = 1; }
        return plotX + (int)(((long)v - (long)lo * (long)g) * (long)plotW / span);
    }

    // 强类型实体主方法：elapsed 映射。
    public static double BrkElapsedItems(List<ChartBreakResolvedItem> items, double v) {
        if (items == null) { return v; }
        double elapsed = 0.0;
        double lastEnd = 0.0;
        for (int i = 0; i < items.Count; i = i + 1) {
            ChartBreakResolvedItem it = items[i];
            if (it == null || it.brk == null) { continue; }
            ChartBreak b = it.brk;
            double vmin = b.startD;
            double vmax = b.endD;
            if (v <= vmax) {
                if (v > vmin) {
                    double span = vmax - vmin;
                    double gr = it.gapReal;
                    elapsed = elapsed + vmin - lastEnd + (v - vmin) / span * gr;
                } else {
                    elapsed = elapsed + v - lastEnd;
                }
                return elapsed;
            }
            elapsed = elapsed + vmin - lastEnd + it.gapReal;
            lastEnd = vmax;
        }
        return elapsed + v - lastEnd;
    }

    // 强类型实体主方法：逆映射。
    public static double BrkUnelapsedItems(List<ChartBreakResolvedItem> items, double e) {
        if (items == null) { return e; }
        double lastElapsedEnd = 0.0;
        double lastBreakEnd = 0.0;
        for (int i = 0; i < items.Count; i = i + 1) {
            ChartBreakResolvedItem it = items[i];
            if (it == null || it.brk == null) { continue; }
            ChartBreak b = it.brk;
            double vmin = b.startD;
            double vmax = b.endD;
            double elapsedStart = lastElapsedEnd + vmin - lastBreakEnd;
            double elapsedEnd = elapsedStart + it.gapReal;
            if (e <= elapsedEnd) {
                if (e > elapsedStart) {
                    return vmin + (e - elapsedStart) / (elapsedEnd - elapsedStart) * (vmax - vmin);
                }
                return lastBreakEnd + e - lastElapsedEnd;
            }
            lastElapsedEnd = elapsedEnd;
            lastBreakEnd = vmax;
        }
        return lastBreakEnd + e - lastElapsedEnd;
    }

    // 定点数值 → 垂直像素（ValueXF 的纵轴对偶）。
    // elapsed 映射：把数据值映进“抽掉断带、铺平 gapReal”的线性空间。
    // breaks 已升序去重叠；gapReal 已解算（BrkGapReal）。链式扫描：
    // v ≤ brk.vmax 且 v > brk.vmin → 断带内线性映射进 gapReal 停；
    // v ≤ brk.vmin → 加 (v - lastBreakEnd) 停；否则跳过整个断带
    // （加 vmin-lastBreakEnd+gapReal）。断带外尾部补 (v-lastBreakEnd)。
    public static double BrkElapsed(List<ChartBreak> breaks, List<double> gapReals,
                             double v) {
        if (breaks == null || gapReals == null) { return v; }
        List<ChartBreakResolvedItem> items = new List<ChartBreakResolvedItem>();
        for (int i = 0; i < breaks.Count; i = i + 1) {
            double gr = (i < gapReals.Count) ? gapReals[i] : 0.0;
            items.Add(new ChartBreakResolvedItem(breaks[i], gr));
        }
        return Chart.BrkElapsedItems(items, v);
    }

    // elapsed 的逆映射（breakImpl.ts transformOut）：elapsedVal 落在某
    // 断带的 gapReal 段内 → 按比例折回数据空间；落在段外 → 段间线性。
    public static double BrkUnelapsed(List<ChartBreak> breaks, List<double> gapReals,
                               double e) {
        if (breaks == null || gapReals == null) { return e; }
        List<ChartBreakResolvedItem> items = new List<ChartBreakResolvedItem>();
        for (int i = 0; i < breaks.Count; i = i + 1) {
            double gr = (i < gapReals.Count) ? gapReals[i] : 0.0;
            items.Add(new ChartBreakResolvedItem(breaks[i], gr));
        }
        return Chart.BrkUnelapsedItems(items, e);
    }

    // 断带 gapReal 解算（updateAxisBreakGapReal 的静帧近似——本引擎
    // 不支持 dataZoom 推断带出界，断带要么整体在 extent 内要么整体在
    // 外，半出界分支省略）：占比断带共享总额 G = P·S/(1-P)，P = Σ占比、
    // S = 外层跨度 − Σ断带数据跨度；绝对断带 gapReal = gap 原值。
    // 返回逐断带 gapReal（与 breaks 对齐）；breaks 为空返回空表。
    public static List<double> BrkGapReals(List<ChartBreak> breaks,
                                    double extentLo, double extentHi) {
        List<double> outp = new List<double>();
        int n = breaks.Count;
        if (n == 0) { return outp; }
        double prctSum = 0.0;
        double brkSpan = 0.0;
        for (int i = 0; i < n; i = i + 1) {
            ChartBreak b = breaks[i];
            if (b.startD < extentLo || b.endD > extentHi) { continue; }
            if (b.gapPrct) { prctSum = prctSum + b.gapVal; }
            brkSpan = brkSpan + (b.endD - b.startD);
        }
        double s = extentHi - extentLo - brkSpan;
        if (s < 0.0) { s = 0.0; }
        double totalGap = prctSum > 0.0 && prctSum < 1.0
            ? prctSum * s / (1.0 - prctSum) : 0.0;
        for (int i = 0; i < n; i = i + 1) {
            ChartBreak b = breaks[i];
            if (b.startD < extentLo || b.endD > extentHi) { outp.Add(0.0); continue; }
            if (b.gapPrct) {
                outp.Add(prctSum > 0.0 ? totalGap * b.gapVal / prctSum : 0.0);
            } else {
                outp.Add(b.gapVal);
            }
        }
        return outp;
    }

    // 断带是否真的参与本帧：与轴 extent 相交才算（clampBreakByExtent
    // 的整体在界近似——半出界时钳到界内语义由调用方忽略，语料无此态）。
    public static bool BrkActive(ChartBreak b, double extentLo, double extentHi) {
        return b.startD < extentHi && b.endD > extentLo;
    }

    // A15：断轴 nice 量程（axisNiceTicks.ts calcNiceForIntervalOrLogScale
    // + intervalScaleCalcNiceTicks 源对抄）。raw 域上解 gap →
    // effective span（elapsed 跨度，getScaleLinearSpanEffective）→
    // interval = nice(span/splitNumber, ROUND)——number.ts nice 的
    // ROUND 档是 **1/2/3/5/10** 阈值 1.5/2.5/4/7（3711→3000 的出处；
    // 不是无断轴路径的 1/2/5 十档）→ 最终域向**外**扩到 interval 整数
    // 倍：[floor(lo/iv)·iv, ceil(hi/iv)·iv]。返回 [nlo, nhi, iv]。
    public static List<double> BrkNiceExtent(List<ChartBreak> brks,
                                      double rawLo, double rawHi, int splitNumber) {
        List<double> outp = new List<double>();
        double lo = rawLo;
        double hi = rawHi;
        if (!(hi > lo)) { hi = lo + 1.0; }
        List<double> grs = Chart.BrkGapReals(brks, lo, hi);
        double eLo = Chart.BrkElapsed(brks, grs, lo);
        double eHi = Chart.BrkElapsed(brks, grs, hi);
        double eSpan = eHi - eLo;
        if (eSpan < 1.0) { eSpan = 1.0; }
        double iv = eSpan / (splitNumber > 0 ? (double)splitNumber : 5.0);
        double mag = 1.0;
        while (mag * 10.0 <= iv) { mag = mag * 10.0; }
        double m = iv / mag;
        if (m < 1.5) { iv = mag; }
        else if (m < 2.5) { iv = 2.0 * mag; }
        else if (m < 4.0) { iv = 3.0 * mag; }
        else if (m < 7.0) { iv = 5.0 * mag; }
        else { iv = 10.0 * mag; }
        if (iv < 1.0) { iv = 1.0; }
        outp.Add(Math.Floor(lo / iv) * iv);
        outp.Add(Math.Ceiling(hi / iv) * iv);
        outp.Add(iv);
        return outp;
    }

    // A15：断轴刻度表（Interval.getTicks 的 OUT 空间近似 + prune +
    // addBreaksToTicks）。interval 由调用方按 elapsed 跨度选定；
    // 正常刻度 = 域内 interval 的整数倍，下一个落进断带内部
    // （vmin < v < vmax）时按 calcNiceTickMultiple 跳过：
    // v += round((vmax - v)/interval)·interval；断带端点成对补入；
    // 距断带 3/4·interval 内的正常刻度剔除（pruneTicksByBreak 的
    // 经验 gap）。
    public static List<double> BrkTicks(List<ChartBreak> breaks, List<double> grs,
                                 double lo, double hi, double interval) {
        List<double> outp = new List<double>();
        if (interval <= 0.0) { return outp; }
        // 正常刻度：floor(lo/iv)..floor(hi/iv) 的整数倍（与 NiceRange
        // 端点取整规则一致：下端 ceil 向上取整在 k0 里由 v<=hi 修正）。
        long k0 = (long)Math.Floor(lo / interval);
        long k1 = (long)Math.Floor(hi / interval);
        double v = (double)k0 * interval;
        if (v < lo) { v = v + interval; }
        int guard = 0;
        while (v <= hi + interval * 0.001 && guard < 4096) {
            guard = guard + 1;
            outp.Add(v);
            double nxt = v + interval;
            // calcNiceTickMultiple：nxt 严格落在断带内 → 跳过整段。
            for (int i = 0; i < breaks.Count; i = i + 1) {
                ChartBreak b = breaks[i];
                if (nxt > b.startD && nxt < b.endD) {
                    double mult = Math.Floor((b.endD - nxt) / interval + 0.5);
                    if (mult > 0.0) { nxt = nxt + mult * interval; }
                    break;
                }
            }
            v = nxt;
        }
        // 断带端点成对补入（addBreaksToTicks）。
        for (int i = 0; i < breaks.Count; i = i + 1) {
            ChartBreak b = breaks[i];
            outp.Add(b.startD);
            outp.Add(b.endD);
        }
        // 剔除断带 ±3/4·interval 内的正常刻度（断带端点除外）。
        double gapq = interval * 0.75;
        for (int i = outp.Count - 1; i >= 0; i = i - 1) {
            double tv = outp[i];
            bool isBrkEnd = false;
            for (int b = 0; b < breaks.Count; b = b + 1) {
                if (tv == breaks[b].startD || tv == breaks[b].endD) { isBrkEnd = true; break; }
            }
            if (isBrkEnd) { continue; }
            for (int b = 0; b < breaks.Count; b = b + 1) {
                if (tv > breaks[b].startD - gapq && tv < breaks[b].endD + gapq) {
                    outp.RemoveAt(i);
                    break;
                }
            }
        }
        // 升序。
        for (int a = 1; a < outp.Count; a = a + 1) {
            double key = outp[a];
            int b2 = a - 1;
            while (b2 >= 0 && outp[b2] > key) { outp[b2 + 1] = outp[b2]; b2 = b2 - 1; }
            outp[b2 + 1] = key;
        }
        // 去重。
        List<double> dd = new List<double>();
        for (int i = 0; i < outp.Count; i = i + 1) {
            if (dd.Count == 0 || dd[dd.Count - 1] != outp[i]) { dd.Add(outp[i]); }
        }
        return dd;
    }
    // A15：断带的像素区间（升序、钳在绘图区内）。kind：0=左值轴
    // 1=右值轴（区间是 y 段），2=X 数值/时间轴（区间是 x 段）。
    public static List<int> BrkPixelBands(ChartFrame f, int kind) {
        List<ChartBreak> brks = f.brkL;
        if (kind == 1) { brks = f.brkR; }
        if (kind == 2) { brks = f.brkX; }
        List<int> bands = new List<int>();
        if (brks == null || brks.Count == 0) { return bands; }
        int lo = f.plotY;
        int hi = f.plotY + f.plotH;
        if (kind == 2) { lo = f.plotX; hi = f.plotX + f.plotW; }
        for (int i = 0; i < brks.Count; i = i + 1) {
            int a = kind == 2 ? f.XOfBrk(brks[i].startD)
                : f.YOfBrk(brks[i].startD, kind);
            int b2 = kind == 2 ? f.XOfBrk(brks[i].endD)
                : f.YOfBrk(brks[i].endD, kind);
            if (a > b2) { int t = a; a = b2; b2 = t; }
            if (a < lo) { a = lo; }
            if (b2 > hi) { b2 = hi; }
            if (b2 > a) { bands.Add(a); bands.Add(b2); }
        }
        return bands;
    }

    // A15：axisLine.breakLine（缺省 true）——轴挂断带时轴线只画
    // 断带之外的段（AxisBuilder.ts:716 → axisBreakHelperImpl.ts
    // buildAxisBreakLine addSeg）。bands 为 BrkPixelBands 的升序
    // 区间对 [s0,e0,s1,e1,...]，长度 len 沿 vertical?y:x。
    public static void DrawAxisLineBands(Canvas c, int x, int y, int len, bool vertical,
        int thick, int col, List<int> bands) {
        int pos = 0;
        for (int i = 0; i + 1 < bands.Count; i = i + 2) {
            int s = bands[i];
            int e = bands[i + 1];
            if (s > len) { s = len; }
            if (e > len) { e = len; }
            if (s > pos) {
                if (vertical) { c.FillRect(x, y + pos, thick, s - pos, col); }
                else { c.FillRect(x + pos, y, s - pos, thick, col); }
            }
            if (e > pos) { pos = e; }
        }
        if (pos < len) {
            if (vertical) { c.FillRect(x, y + pos, thick, len - pos, col); }
            else { c.FillRect(x + pos, y, len - pos, thick, col); }
        }
    }

    // A15：锯齿点列（addZigzagShapes 源对抄）。沿 sweep 轴扫过整个
    // 绘图区，端点不偏移（与轴刻度精确相接）、内部点 band ±amp 交替
    // （isSwap 起步 true：两线同向偏移保持平行），步长取
    // minSpan..maxSpan（缺省 4..20）伪随机权重。官方用 Math.random；
    // 这里换黄金比/白银比递推保证逐帧确定（像素回归可复现）。
    // horizontal=true：带在 x（竖直锯齿线，扫 y），否则带在 y。
    public static void BrkZigzag(int seed, int amp, int plotPos, int plotLen,
        int bandLo, int bandHi, bool horizontal,
        List<int> xsA, List<int> ysA, List<int> xsB, List<int> ysB) {
        double minSpan = 4.0;
        double maxSpan = 20.0;
        int sweepEnd = plotPos + plotLen;
        int cur = plotPos;
        bool isSwap = true;
        int idx = 0;
        while (true) {
            bool isLast = cur >= sweepEnd;
            if (isLast) { cur = sweepEnd; }
            int off = 0;
            if (idx > 0 && !isLast) { off = isSwap ? 0 - amp : amp; }
            if (horizontal) {
                xsA.Add(bandLo + off); ysA.Add(cur);
                xsB.Add(bandHi + off); ysB.Add(cur);
            } else {
                xsA.Add(cur); ysA.Add(bandLo + off);
                xsB.Add(cur); ysB.Add(bandHi + off);
            }
            if (isLast) { break; }
            double r = (idx + 1) * 0.6180339887498949 + seed * 0.7548776662466927 + 0.2113;
            r = r - Math.Floor(r);
            int nextStep = (int)(r * (maxSpan - minSpan) + minSpan);
            if (sweepEnd - (cur + nextStep) < (int)minSpan) {
                cur = sweepEnd;
            } else {
                cur = cur + nextStep;
            }
            isSwap = !isSwap;
            idx = idx + 1;
        }
    }

    // A15：breakArea 锯齿边框 dashed [3,3]（borderType 缺省）的近似：
    // 折线笔划不可分段，逐段按切比雪夫长度参数走 3px 通/3px 断，
    // 通段用 DrawLine。每条锯齿约 25 段，成本可忽略。
    public static void BrkDashPolyline(Canvas c, List<int> xs, List<int> ys, int col) {
        for (int i = 1; i < xs.Count; i = i + 1) {
            int dx = xs[i] - xs[i - 1];
            int dy = ys[i] - ys[i - 1];
            int adx = dx > 0 ? dx : 0 - dx;
            int ady = dy > 0 ? dy : 0 - dy;
            int ln = adx > ady ? adx : ady;
            if (ln < 1) { continue; }
            int nseg = (int)Math.Ceiling(ln / 3.0);
            if (nseg < 1) { nseg = 1; }
            for (int s = 0; s < nseg; s = s + 1) {
                if (s % 2 == 1) { continue; }
                double t0 = (double)s / nseg;
                double t1 = (double)(s + 1) / nseg;
                if (t1 > 1.0) { t1 = 1.0; }
                c.DrawLine(xs[i - 1] + (int)(dx * t0 + 0.5),
                    ys[i - 1] + (int)(dy * t0 + 0.5),
                    xs[i - 1] + (int)(dx * t1 + 0.5),
                    ys[i - 1] + (int)(dy * t1 + 0.5), col, 1);
            }
        }
    }

    // A15：breakArea 锯齿带（axisBreakHelperImpl.ts rectCoordBuildBreakAxis
    // → addZigzagShapes 源对抄）。每条断带画两条平行锯齿折线跨满绘图区
    // （边框色/宽、dashed 缺省），gapReal≠0 时再加两线之间的多边形填充
    // （itemStyle color + opacity，缺省 #fff/0.6）。gap=0 只画单线
    // （官方注释：dash/半透明在零宽带上不连续）。官方 z=zigzagZ(100)
    // 在系列之上——调用点在系列绘制之后。
    public static void DrawBreakAreas(Canvas c, ChartFrame f, ChartAxis ax, int kind) {
        if (ax == null || !ax.breakShow) { return; }
        List<ChartBreak> brks = f.brkL;
        List<double> grs = f.brkGapL;
        if (kind == 1) { brks = f.brkR; grs = f.brkGapR; }
        if (kind == 2) { brks = f.brkX; grs = f.brkGapX; }
        if (brks == null || brks.Count == 0 || grs == null || grs.Count < brks.Count) { return; }
        int amp = ax.breakAmp > 0 ? ax.breakAmp : 4;
        int bcol = ax.breakBorderColor != 0 ? ax.breakBorderColor : ChartColor.Rgb(183, 185, 190);
        int fcol = ax.breakFillColor != 0 ? ax.breakFillColor : ChartColor.Rgb(255, 255, 255);
        int opa = ax.breakOpacityX10 >= 0 ? ax.breakOpacityX10 * 255 / 10 : 153;
        List<int> xsA = new List<int>();
        List<int> ysA = new List<int>();
        List<int> xsB = new List<int>();
        List<int> ysB = new List<int>();
        for (int bi = 0; bi < brks.Count; bi = bi + 1) {
            ChartBreak b = brks[bi];
            xsA.Clear();
            ysA.Clear();
            xsB.Clear();
            ysB.Clear();
            if (kind == 2) {
                int xa = f.XOfBrk(b.startD);
                int xb = f.XOfBrk(b.endD);
                if (xa > xb) { int t = xa; xa = xb; xb = t; }
                Chart.BrkZigzag(bi, amp, f.plotY, f.plotH, xa, xb, true,
                    xsA, ysA, xsB, ysB);
            } else {
                int ya = f.YOfBrk(b.startD, kind);
                int yb = f.YOfBrk(b.endD, kind);
                if (ya > yb) { int t = ya; ya = yb; yb = t; }
                Chart.BrkZigzag(bi, amp, f.plotX, f.plotW, ya, yb, false,
                    xsA, ysA, xsB, ysB);
            }
            Chart.BrkDashPolyline(c, xsA, ysA, bcol);
            if (grs[bi] != 0.0) {
                Chart.BrkDashPolyline(c, xsB, ysB, bcol);
                List<ChartMapPoint> poly = new List<ChartMapPoint>();
                for (int i = 0; i < xsA.Count; i = i + 1) { poly.Add(ChartMapPoint.Of(xsA[i], ysA[i])); }
                for (int i = xsB.Count - 1; i >= 0; i = i - 1) { poly.Add(ChartMapPoint.Of(xsB[i], ysB[i])); }
                ChartView.FillPolygon(c, poly, ChartColor.WithAlpha(fcol, opa));
            }
        }
    }

    public static int ValueYF(int plotY, int plotH, int lo, int hi, int v, int g) {
        if (g <= 1) { return Chart.ValueY(plotY, plotH, lo, hi, v); }
        long span = ((long)hi - (long)lo) * (long)g;
        if (span < 1) { span = 1; }
        return plotY + plotH - (int)(((long)v - (long)lo * (long)g) * (long)plotH / span);
    }

    // 数值 → 垂直像素：plotY+plotH 对应 lo，plotY 对应 hi（向上增大）。
    // 同 ValueX：乘法走 long 防大数值 × plotH 溢出。
    public static int ValueY(int plotY, int plotH, int lo, int hi, int v) {
        long span = (long)hi - (long)lo;
        if (span < 1) { span = 1; }
        return plotY + plotH - (int)(((long)v - (long)lo) * (long)plotH / span);
    }

    // 1/1000 定点值 → 垂直像素：lo/hi（值×1000）之间的线性映射，
    // 小数轴（leftMinF 定点域）的 YOfF 用——与 ValueY 同构，
    // 分子分母同放大 1000 后 long 相除，亚单位值不再量化。
    public static int ValueYF1000(int plotY, int plotH, int loF, int hiF, int vF) {
        long span = (long)hiF - (long)loF;
        if (span < 1) { span = 1; }
        return plotY + plotH
            - (int)(((long)vF - (long)loF) * (long)plotH / span);
    }

    // ECharts axisLine.show 三态判定（cartesianAxisHelper.ts:169-181
    // axisLineAutoShow）：显式 true/false 照办；未声明（-1）按 'auto'
    // ——只有当**同网格**对侧轴是 value/log（isIntervalOrLogScale）
    // 时才画，与本轴自身类型无关。time 轴也走 'auto'（实测
    // x时间/y时间 一条线都不画）。
    public static bool AxisLineDraws(int axisLineShow, bool otherIsValueOrLog) {
        if (axisLineShow > 0) { return true; }
        if (axisLineShow == 0) { return false; }
        return otherIsValueOrLog;
    }

    // 0 相对数值域 [lo,hi] 的位置：2 = 严格在内，1 = 恰是端点
    // （EDGE——官方允许骑线），0 = 在域外（禁止骑线）。
    // scale/helper.ts getScaleValuePositionKind 的语义。
    public static int ZeroKindOf(int lo, int hi) {
        if (lo > 0 || hi < 0) { return 0; }
        if (lo == 0 || hi == 0) { return 1; }
        return 2;
    }

    // ECharts Grid.canOnZeroToAxis（Grid.ts:677-717）：目标轴是
    // value/log（category/time 的 0 无数值意义）、0 不在目标域外
    // （EDGE 允许）、骑线轴的 axisLine.onZero 非 false（-1 未声明
    // 按 'auto'，与 true 等价——discourageOnAxisZero 只在
    // containShape 真的扩过量程时置位，本引擎不产生）。
    public static bool CanOnZeroTo(ChartAxis target, int targetLo, int targetHi,
                            int riderOnZero) {
        if (riderOnZero == 0) { return false; }
        if (target.type != ChartAxisType.Value
            && target.type != ChartAxisType.Log) { return false; }
        return Chart.ZeroKindOf(targetLo, targetHi) > 0;
    }

    // ---- 饼标签矩阵（ECharts PieSeries.ts:265-300 缺省 +
    // labelLayout.ts 布局；系列型缺省差异经三态传到这里解析） ----

    // label.show 三态 → 画不画：饼缺省 true（PieSeries.ts:269）。
    // 线柱缺省 false，走 labelShow 布尔不经此函数。
    public static bool PieLabelShows(int showT) {
        return showT != 0;
    }

    // position 属内位（不出引线）：'inside'/'inner'（同义，
    // PieSeries.ts:285 注）/ 'center'。
    public static bool PieLabelInside(string pos) {
        return pos == "inside" || pos == "inner" || pos == "center";
    }

    // labelLine.show 三态 → 画不画引线：缺省 true（PieSeries.ts:289）；
    // false 只藏线，文本仍落在 x3（labelLayout.ts:226 只判 linePoints）。
    public static bool PieLeaderDraws(int lineShowT) {
        return lineShowT != 0;
    }

    // alignTo:'edge' 时水平段终点 x3（labelLayout.ts:236-243）：
    // 左半球 = 视口左缘 + edgeDistance + 文本宽 + 文距，右半球镜像
    // （百分比 edgeDistance 按 viewWidth 折算后传入 px）。
    public static int PieEdgeX3(bool rightSide, int viewL, int viewW, int edgeDist,
                         int textW, int dist) {
        if (rightSide) {
            return viewL + viewW - edgeDist - textW - dist;
        }
        return viewL + edgeDist + textW + dist;
    }

    // 扇区百分比：ECharts percent = Math.round(v/sum*100)
    // （乘 200 加 tot 除 2tot = 正数域四舍五入）。
    public static int PiePct(int v, long tot) {
        if (tot <= 0) { return 0; }
        return (int)((v * 200 + tot) / (tot * 2));
    }

    // ---- 富文本标签（ECharts label.rich + {style|content} 令牌） ----
    // 源语义：官方"富文本标签"文档 + zrender rich 段排版——按 \n 分
    // 行，行内 {name|content} 段用 rich.name 样式，行高 = 段声明
    // lineHeight / height 或字号行盒的最大值，width:'100%' 随整块
    // 宽。分词在 Chart（纯字符串，conformance 可测），量测/绘制在
    // ChartView（要 App 缩放与 Canvas 度量）。

    // 展开模板令牌 {a}{b}{c}{d}{@dim}（**保留** {style|...} 壳——
    // 是否剥壳由调用方按有无 rich 样式表决定）。
    public static string RichFmtRaw(ChartSeries s, string fmt,
                             string name, int val, int pct) {
        string f = fmt;
        if (f.Length == 0) { return name; }
        f = f.Replace("{a}", s.name);
        f = f.Replace("{b}", name);
        f = f.Replace("{c}", Convert.ToString(val));
        f = f.Replace("{d}", Convert.ToString(pct));
        while (true) {
            int at = f.IndexOf("{@");
            if (at < 0) { break; }
            int cb = f.IndexOf("}", at);
            if (cb < 0) { break; }
            f = f.Substring(0, at) + Convert.ToString(val) + f.Substring(cb + 1);
        }
        return f;
    }

    // rich 样式表里按名取样式；没有返回 null。
    public static ChartRichStyle RichStyleOf(ChartTextStyle st, string nm) {
        if (st == null || st.rich == null || nm.Length == 0) { return null; }
        for (int i = 0; i < st.rich.Count; i = i + 1) {
            if (st.rich[i].name == nm) { return st.rich[i]; }
        }
        return null;
    }

    // 富文本分词：按 \n 分行（行号记 seg.line），{name|content} 段
    // 挂样式（查表挂 st 引用，纯文本段 st=null）。未知样式名按纯
    // 文本段处理但保留内容。返回扁平段表（顺序 = 阅读序）。
    // 约定：空段（{hr|}）text = ""，调用方靠 width/borderWidth 识别
    // 线块。
    public static List<RichSeg> RichTokenize(string f, ChartTextStyle st) {
        List<RichSeg> outSegs = new List<RichSeg>();
        int line = 0;
        int i = 0;
        int segLineStart = 0;
        bool lineHasSeg = false;
        while (i < f.Length) {
            char ch = f[i];
            if (ch == '\n') {
                // 行尾文本（非空）或整行空行——空行也要占行号。
                if (i > segLineStart || !lineHasSeg) {
                    RichSeg done = new RichSeg();
                    done.text = f.Substring(segLineStart, i - segLineStart);
                    done.line = line;
                    done.st = null;
                    outSegs.Add(done);
                }
                line = line + 1;
                i = i + 1;
                segLineStart = i;
                lineHasSeg = false;
                continue;
            }
            if (ch == '{') {
                int cb = f.IndexOf("}", i);
                if (cb >= 0) {
                    int bar = f.IndexOf("|", i);
                    if (bar >= 0 && bar < cb) {
                        // 段前的行首文本（若非空）先行进表。
                        if (i > segLineStart) {
                            RichSeg pre = new RichSeg();
                            pre.text = f.Substring(segLineStart, i - segLineStart);
                            pre.line = line;
                            pre.st = null;
                            outSegs.Add(pre);
                            lineHasSeg = true;
                        }
                        RichSeg sg = new RichSeg();
                        sg.st = Chart.RichStyleOf(st,
                            f.Substring(i + 1, bar - i - 1));
                        sg.text = f.Substring(bar + 1, cb - bar - 1);
                        sg.line = line;
                        outSegs.Add(sg);
                        lineHasSeg = true;
                        i = cb + 1;
                        segLineStart = i;
                        continue;
                    }
                }
            }
            i = i + 1;
        }
        if (segLineStart < f.Length || !lineHasSeg || outSegs.Count == 0) {
            RichSeg last = new RichSeg();
            last.text = f.Substring(segLineStart);
            last.line = line;
            last.st = null;
            outSegs.Add(last);
        }
        return outSegs;
    }

    // 段盒高贡献：声明 height 用 height，否则行盒 fontH；均加纵向
    // padding（负 padding 官方允许——gauge-speed 的 [0,0,-20,10]，
    // 结果可为负，排版时按 max(1, ·) 兜底）。
    public static int RichSegH(int declaredH, int fontH, int padT, int padB) {
        int h = declaredH >= 0 ? declaredH : fontH;
        return h + padT + padB;
    }

    // 剥壳文本：富文本格式串去掉 `{name|…}` 壳后的纯内容（未知样式
    // 名同样保留内容）。供量宽（CategoryTicks）、旋转/退化路径和
    // 系列标签文本（LabelText）——带壳串直接 DrawText 会把花括号
    // 画出来。无 `{` 快速返回原串。
    public static string RichStrip(string f) {
        if (f.IndexOf("{") < 0) { return f; }
        List<RichSeg> segs = Chart.RichTokenize(f, null);
        string r = "";
        for (int i = 0; i < segs.Count; i = i + 1) {
            r = r + segs[i].text;
        }
        return r;
    }

    // 轴刻度标签绘制：轴声明了 axisLabel.rich 且文本带壳时走富文本
    // 块（RichLayout+RichDraw，锚 = 块左上，调用方按原纯文本左缘
    // 定位），否则原样 DrawText。旋转路径不在此（块不能整体旋转，
    // 调用方先 RichStrip 后走 DrawTextRot）。
    public static void DrawAxisLabel(App app, Canvas c, ChartAxis a, string lab,
                              int bx, int by, int defCol, int fs) {
        int col = a != null && a.labelColor != 0 ? a.labelColor : defCol;
        if (a.labelSt != null && a.labelSt.rich != null
            && lab.IndexOf("{") >= 0) {
            RichBlock blk = ChartView.RichLayout(app,
                Chart.RichTokenize(lab, a.labelSt), a.labelSt, fs);
            ChartView.RichDraw(app, c, bx, by, blk, col);
            return;
        }
        c.DrawText(bx, by, lab, col, fs);
    }

    // DrawTextCentered 语义的富文本版：矩形内水平+垂直居中；富文本
    // 块按矩形居中（几何与 plain 路径逐像素同位——带状类目标签
    // 此前走 DrawTextCentered，不能因换路漂移 2px）。
    public static void DrawAxisLabelCentered(App app, Canvas c, ChartAxis a, string lab,
                                      int rx, int ry, int rw, int rh,
                                      int defCol, int fs) {
        int col = a != null && a.labelColor != 0 ? a.labelColor : defCol;
        if (a.labelSt != null && a.labelSt.rich != null
            && lab.IndexOf("{") >= 0) {
            RichBlock blk = ChartView.RichLayout(app,
                Chart.RichTokenize(lab, a.labelSt), a.labelSt, fs);
            int bx = rx + (rw - blk.w) / 2;
            int by = ry + (rh - blk.h) / 2;
            if (bx < rx) { bx = rx; }
            if (by < ry) { by = ry; }
            ChartView.RichDraw(app, c, bx, by, blk, col);
            return;
        }
        c.DrawTextCentered(rx, ry, rw, rh, lab, col, fs);
    }

    // 仅索引窗口 [i0,i1]（含端点）内的最大值，供 dataZoom
    // 的索引视图使用（渲染循环直接读原系列，不做有损克隆）。
    public static int MaxOfWindow(List<ChartSeries> series, int i0, int i1) {
        int mx = 0;
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            int j = i0;
            while (j <= i1 && j < s.Count()) {
                if (s.Value(j) > mx) { mx = s.Value(j); }
                j = j + 1;
            }
        }
        return mx;
    }

    // 各分类中的最大堆叠总量（用于堆叠柱状图）。
    // 共享 stackName 的系列堆叠在一起；轴适配最高的组，
    // 使多组堆叠柱（ECharts `stack` 组）正确缩放。`n` 为分类数。
    public static int MaxStack(List<ChartSeries> series, int n) {        List<string> grp = new List<string>();
        for (int g = 0; g < series.Count; g = g + 1) {
            ChartSeries cs = series[g];
            if (!ChartView.IsLineFamily(cs.type)) {
                bool found = false;
                for (int gi = 0; gi < grp.Count; gi = gi + 1) {
                    if (grp[gi] == cs.stackName) { found = true; }
                }
                if (!found) { grp.Add(cs.stackName); }
            }
        }
        int ng = grp.Count;
        if (ng < 1) { ng = 1; }
        int mx = 0;
        for (int i = 0; i < n; i = i + 1) {
            for (int gi = 0; gi < ng; gi = gi + 1) {
                int sum = 0;
                for (int s = 0; s < series.Count; s = s + 1) {
                    ChartSeries cs = series[s];
                    if (!ChartView.IsLineFamily(cs.type) && cs.stackName == grp[gi]) {
                        if (i < cs.Count()) { sum = sum + cs.Value(i); }
                    }
                }
                if (sum > mx) { mx = sum; }
            }
        }
        return mx;
    }

    // MaxStack 的索引窗口版：仅累计分类 j + i0（j 在 [0,n)）。
    public static int MaxStackW(List<ChartSeries> series, int n, int i0) {
        List<string> grp = new List<string>();
        for (int g = 0; g < series.Count; g = g + 1) {
            ChartSeries cs = series[g];
            if (!ChartView.IsLineFamily(cs.type)) {
                bool found = false;
                for (int gi = 0; gi < grp.Count; gi = gi + 1) {
                    if (grp[gi] == cs.stackName) { found = true; }
                }
                if (!found) { grp.Add(cs.stackName); }
            }
        }
        int ng = grp.Count;
        if (ng < 1) { ng = 1; }
        int mx = 0;
        for (int i = 0; i < n; i = i + 1) {
            int oi = i0 + i;
            for (int gi = 0; gi < ng; gi = gi + 1) {
                int sum = 0;
                for (int s = 0; s < series.Count; s = s + 1) {
                    ChartSeries cs = series[s];
                    if (!ChartView.IsLineFamily(cs.type) && cs.stackName == grp[gi]) {
                        if (oi < cs.Count()) { sum = sum + cs.Value(oi); }
                    }
                }
                if (sum > mx) { mx = sum; }
            }
        }
        return mx;
    }


    // MaxStackAll 的索引窗口版：仅累计分类 j + i0。
    public static int MaxStackAllW(List<ChartSeries> series, int n, int i0) {
        int mx = 0;
        for (int i = 0; i < n; i = i + 1) {
            int oi = i0 + i;
            int sum = 0;
            for (int s = 0; s < series.Count; s = s + 1) {
                ChartSeries cs = series[s];
                if (!cs.hidden && oi < cs.Count()) { sum = sum + cs.Value(oi); }
            }
            if (sum > mx) { mx = sum; }
        }
        return mx;
    }

    // 堆叠感知的窗口最大值：逐 stackName 组累计组顶，未堆叠
    // 系列（stack=0）只按绝对值计入（ECharts 轴量程覆盖组顶与
    // 绝对值的最大者，绝对值不进累加和——多级控制混合图）。
    public static int MaxStackGroupsW(List<ChartSeries> series, int n, int i0) {
        return Chart.MaxBarStackGroupsW(series, n, i0);
    }

    // 堆叠柱（含逐系列 stackStrategy）在窗口内的**正侧组顶**最大值。
    // 逐点用 ChartView.StackTopAll 取各系列堆叠结果，取正的最大值；
    // 未堆叠系列按自身值参与（与旧 absMx 口径一致）。
    public static int MaxBarStackGroupsW(List<ChartSeries> series, int n, int i0) {
        int mx = 0;
        List<double> tops = new List<double>();
        for (int i = 0; i < n; i = i + 1) {
            int oi = i0 + i;
            tops.Clear();
            ChartView.StackTopAll(series, oi, tops);
            for (int s = 0; s < series.Count; s = s + 1) {
                ChartSeries cs = series[s];
                if (cs.hidden || oi >= cs.Count()) { continue; }
                bool stackedOne = cs.stackName.Length > 0 || cs.stack != 0;
                double top = s < tops.Count ? tops[s] : 0.0;
                double cand = stackedOne ? top : cs.Number(oi);
                int cF = (int)(cand >= 0.0 ? cand + 0.5 : cand - 0.5);
                if (cF > mx) { mx = cF; }
            }
        }
        return mx;
    }

    // MaxBarStackGroupsW 的负侧对偶：各组堆叠结果的负侧最小值，
    // 返回值 ≤ 0（原始值单位，与调用方 NiceMin 一致）。
    public static int MinBarStackGroupsW(List<ChartSeries> series, int n, int i0) {
        int mn = 0;
        List<double> tops = new List<double>();
        for (int i = 0; i < n; i = i + 1) {
            int oi = i0 + i;
            tops.Clear();
            ChartView.StackTopAll(series, oi, tops);
            for (int s = 0; s < series.Count; s = s + 1) {
                ChartSeries cs = series[s];
                if (cs.hidden || oi >= cs.Count()) { continue; }
                bool stackedOne = cs.stackName.Length > 0 || cs.stack != 0;
                double top = s < tops.Count ? tops[s] : 0.0;
                double cand = stackedOne ? top : cs.Number(oi);
                int cF = (int)(cand >= 0.0 ? cand + 0.5 : cand - 0.5);
                if (cF < mn) { mn = cF; }
            }
        }
        return mn;
    }


    // ---- 几何 ----

    // 整数 point-in-polygon（射线法，even-odd），无除法/浮点。
    // 半开约定：py >= 顶点 y 视为在射线之上，每条边最多计一次
    // 穿越；交点侧由叉积符号结合边方向判定。点在边界上属边缘
    // 情形，结果不保证——由命中层的 bbox 容差吸收。
    public static bool PointInPoly(List<ChartMapPoint> poly, int px, int py) {
        int n = poly.Count;
        if (n < 3) { return false; }
        bool inside = false;
        int j = n - 1;
        for (int i = 0; i < n; i = i + 1) {
            ChartMapPoint pi = poly[i];
            ChartMapPoint pj = poly[j];
            long dx = (long)pi.x - (long)pj.x;
            long dy = (long)pi.y - (long)pj.y;
            long qx = (long)px - (long)pj.x;
            long qy = (long)py - (long)pj.y;
            long cross = dx * qy - dy * qx;
            if (cross == 0 && px >= (pi.x < pj.x ? pi.x : pj.x)
                && px <= (pi.x > pj.x ? pi.x : pj.x)
                && py >= (pi.y < pj.y ? pi.y : pj.y)
                && py <= (pi.y > pj.y ? pi.y : pj.y)) {
                return true;
            }
            if ((py >= pi.y) != (py >= pj.y)) {
                if ((cross > 0) == (pi.y > pj.y)) { inside = !inside; }
            }
            j = i;
        }
        return inside;
    }

    // ---- 轴类型：Time / Log ----

    // 10 的整数对数（floor log10），仅正值（v < 1 → 0）。
    public static int Log10(int v) {
        if (v < 1) { return 0; }
        int e = 0;
        int p = 1;
        while (p * 10 <= v) { p = p * 10; e = e + 1; }
        return e;
    }

    // floor(log10) 的确定性整数逆；超出 int 范围时饱和为 2147483647。
    public static int Pow10(int e) {
        if (e <= 0) { return 1; }
        int p = 1;
        for (int i = 0; i < e; i = i + 1) {
            if (p > 214748364) { return 2147483647; }
            p = p * 10;
        }
        return p;
    }

    // 对数轴刻度：lo/hi 边界 + 中间的 10 的幂（去重，升序）。
    public static List<int> LogTicks(int lo, int hi) {
        if (hi < lo) { int tmp = lo; lo = hi; hi = tmp; }
        if (lo < 1) { lo = 1; }
        if (hi < lo) { hi = lo; }
        List<int> ts = new List<int>();
        ts.Add(lo);
        int p = 1;
        while (p * 10 <= hi) {
            p = p * 10;
            if (p > lo) { ts.Add(p); }
        }
        if (ts[ts.Count - 1] != hi) { ts.Add(hi); }
        return ts;
    }

    // 官方 LogScale.getExtent 的十进位对齐：下界 = 10^floor(log10 v)、
    // 上界 = 10^ceil(log10 v)（line-log 数据 0.002..2000 → 0.001..10000）。
    // F 后缀作用于 ×1000 定点域（sub-1 十进位只有定点能承载）。
    // log 轴小数十进位标签：‰ 域 → "0.001"/"0.01"/"0.1"/"1"/"10,000"。
    // FracText 只有两位小数（1‰ → "0"），log 轴底档需要三位。
    public static string LogFracText(long vF) {
        if (vF >= 1000L) { return Chart.Commas((int)(vF / 1000L)); }
        string fs = Convert.ToString((int)vF);
        string pad = "";
        while (pad.Length + fs.Length < 3) { pad = pad + "0"; }
        return "0." + pad + fs;
    }

    public static int LogFloorI(int v) {
        if (v < 1) { return 1; }
        int b = 1;
        while ((long)b * 10L <= (long)v) { b = b * 10; }
        return b;
    }
    public static int LogCeilI(int v) {
        if (v < 1) { return 1; }
        int b = 1;
        while (b < v) {
            if (b > 100000000) { return 1000000000; }
            b = b * 10;
        }
        return b;
    }
    public static long LogFloorF(long vF) {
        if (vF <= 0) { return 1; }
        long b = 1000;
        while (b * 10L <= vF) { b = b * 10L; }
        while (b > vF) { b = b / 10L; }
        return b < 1 ? 1 : b;
    }
    public static long LogCeilF(long vF) {
        if (vF <= 0) { return 1000; }
        long b = 1000;
        while (b < vF) { b = b * 10L; }
        return b;
    }

    // 从 epoch 天生成确定性短日期 "YYYY-MM-DD"（真实公历，经
    // DateTime 的 civil-from-days；t = 0 是 1970-01-01）。纯表
    // 驱动、无系统时间依赖，供图表演示与 conformance 断言。
    public static string TimeLabel(int t) {
        if (t < 0) { t = 0; }
        DateTime d = DateTime.FromUnixSeconds((long)t * 86400);
        string mm = Convert.ToString(d.Month());
        if (mm.Length < 2) { mm = "0" + mm; }
        string dd = Convert.ToString(d.Day());
        if (dd.Length < 2) { dd = "0" + dd; }
        return Convert.ToString(d.Year()) + "-" + mm + "-" + dd;
    }

    // 时间轴刻度：从 {1,2,5}×10^n 阶梯选步长，使
    // (t1-t0)/step ≤ maxTicks-1；生成 t0 起等距点，
    // 末点不落在网格上则补 t1。跨度全程 64 位——int32 域
    // 相减回绕成负会让步长卡在 1、循环 43 亿次撑爆内存。
    public static List<int> TimeTicks(int t0, int t1, int maxTicks) {
        if (t1 < t0) { int tmp = t0; t0 = t1; t1 = tmp; }
        if (maxTicks < 2) { maxTicks = 2; }
        long span = (long)t1 - (long)t0;
        long step = 1;
        while (span / step + 1 > maxTicks) {
            long mag = 1;
            while (step >= mag * 10) { mag = mag * 10; }
            long unit = step / mag;
            if (unit == 1) { step = 2 * mag; }
            else if (unit == 2) { step = 5 * mag; }
            else { step = 10 * mag; }
        }
        List<int> ts = new List<int>();
        for (long t = t0; t <= t1; t = t + step) { ts.Add((int)t); }
        if (ts[ts.Count - 1] != t1) { ts.Add(t1); }
        return ts;
    }

    // 固定小数位数的确定性格式化（四舍五入，无浮点打印依赖）。
    // precision 钳制在 0..4。
    public static string FormatFixed(double v, int precision) {
        if (precision < 0) { precision = 0; }
        if (precision > 4) { precision = 4; }
        int scale = 1;
        for (int i = 0; i < precision; i = i + 1) { scale = scale * 10; }
        bool neg = false;
        double av = v;
        if (av < 0) { neg = true; av = 0 - av; }
        int scaled = (int)(av * (double)scale + 0.5);
        int ip = scaled / scale;
        string s = Convert.ToString(ip);
        if (precision > 0) {
            int frac = scaled % scale;
            string fs = Convert.ToString(frac);
            while (fs.Length < precision) { fs = "0" + fs; }
            s = s + "." + fs;
        }
        if (neg) { s = "-" + s; }
        return s;
    }


    // 交互 id `wid` 下系列 `si` 的图例隐藏状态键。
    public static int LegendKey(int wid, int si) { return 6000000 + wid * 64 + si; }
    // dataRange 交互态：calculable 滑条两端（0..1000 量化，同
    // zoom 条约定）与 splitList 分段隐藏位（1 = 该段被点掉）。
    public static int DRangeLoKey(int wid) { return 7300000 + wid * 4; }
    // dataRange calculable 滑条上界状态键（千分值 0..1000）。
    public static int DRangeHiKey(int wid) { return 7300000 + wid * 4 + 1; }
    // splitList 第 bi 段的隐藏位键（1 = 该段被点掉）。
    public static int DRangeBandKey(int wid, int bi) { return 7400000 + wid * 32 + bi; }
    // dataRange.hoverLink：指针悬停在 dataRange 条上时该图的高亮键
    // （0 = 无；1 = 悬停中，消费方把接近值域的区域/点描边强调）。
    public static int DRangeHoverKey(int wid) { return 7300000 + wid * 4 + 2; }

    // legend.formatter 纯 seam：{name} 占位替换（模板空 = 原名）。
    public static string LegendLabel(string fmt, string name) {
        if (fmt.Length < 1) { return name; }
        return fmt.Replace("{name}", name);
    }

    // ---- legend 选项帧内访问器（Chart.legendOpt 未置 = 保持旧行为）----
    // 本帧图例是否纵向排布（legendOpt 未置 = 横向）。
    public static bool LegendVertical() {
        ChartOption lo = Chart.legendOpt;
        if (lo == null) { return false; }
        return lo.legendOrient == "vertical";
    }
    // 本帧图例 formatter 模板（legendOpt 未置 = 空模板 = 原名）。
    public static string LegendFmt() {
        ChartOption lo = Chart.legendOpt;
        if (lo == null) { return ""; }
        return lo.legendFormatter;
    }
    // 本帧卡片底色（ECharts option.backgroundColor）。
    // 官方语义（core/echarts.ts:1927）：未声明 → 'transparent'，
    // 由 zrender 底层呈现；Zan 的等价物是主题面板色（0 = 跟随主题）。
    // 声明了就整卡铺它——pie-custom 的 #2c343c 深底配白字标签、
    // gauge-car 的 #000 都是这个用途。
    public static int PanelBgOr(int themeBg) {
        ChartOption lo = Chart.legendOpt;
        if (lo == null) { return themeBg; }
        if (lo.backgroundColor == 0) { return themeBg; }
        return lo.backgroundColor;
    }

    // 本帧标题副标题（ECharts title.subtext；legendOpt 未置 = 空）。
    public static string TitleSubText() {
        ChartOption lo = Chart.legendOpt;
        if (lo == null) { return ""; }
        return lo.titleSub;
    }
    // 本帧标题水平对齐："left" | "center"（官方默认）| "right"。
    public static string TitleAlignMode() {
        ChartOption lo = Chart.legendOpt;
        if (lo == null) { return ""; }
        return lo.titleAlign;
    }
    // 标题正文色。官方 tokens.color.primary = neutral80 = #3c3c41；
    // option.title.textStyle.color 显式给出时以它为准。
    public static int TitleColor() {
        ChartOption lo = Chart.legendOpt;
        if (lo != null && lo.titleColor != 0) { return lo.titleColor; }
        return Chart.TitleNeutral(0x3c, 0x3c, 0x41);
    }
    // 标题副文本色。官方 tokens.color.quaternary = neutral50 = #86878c。
    public static int TitleSubColor() {
        ChartOption lo = Chart.legendOpt;
        if (lo != null && lo.titleSubColor != 0) { return lo.titleSubColor; }
        return Chart.TitleNeutral(0x86, 0x87, 0x8c);
    }
    // 打包 RGB 为不透明 ARGB（alpha 0 在 DrawText 里视为不透明）。
    public static int TitleNeutral(int r, int g, int b) {
        return (r << 16) | (g << 8) | b;
    }
    // legend.left/right 的等效水平对齐（官方盒模型）：显式
    // left/right/center 关键字直接返回；数值/百分比锚返回 ""（走 px
    // 通路）；两锚都未声明时返回官方默认 "center"。
    public static string LegendBoxAlignX() {
        ChartOption lo = Chart.legendOpt;
        if (lo == null) { return "center"; }
        if (lo.legendHasLeft) {
            if (lo.legendLeft == "left" || lo.legendLeft == "center"
                || lo.legendLeft == "right") { return lo.legendLeft; }
            return "";
        }
        if (lo.legendHasRight) {
            if (lo.legendRight == "right") { return "right"; }
            if (lo.legendRight == "left") { return "left"; }
            if (lo.legendRight == "center") { return "center"; }
            return "";
        }
        return "center";  // 官方 LegendModel.defaultOption: left 'center'
    }
    // legend.left 数值锚（px）；未声明数值锚返回 -1。
    public static int LegendAnchorLeftPx() {
        ChartOption lo = Chart.legendOpt;
        if (lo == null) { return 0 - 1; }
        if (lo.legendHasLeft && lo.legendLeftPx >= 0) { return lo.legendLeftPx; }
        return 0 - 1;
    }
    // legend.right 数值锚（px）；未声明返回 -1。
    public static int LegendAnchorRightPx() {
        ChartOption lo = Chart.legendOpt;
        if (lo == null) { return 0 - 1; }
        if (lo.legendHasRight && lo.legendRightPx >= 0) { return lo.legendRightPx; }
        return 0 - 1;
    }
    // legend.top 数值锚（px）；未声明返回 -1。
    public static int LegendAnchorTopPx() {
        ChartOption lo = Chart.legendOpt;
        if (lo == null) { return 0 - 1; }
        if (lo.legendHasTop && lo.legendTopPx >= 0) { return lo.legendTopPx; }
        return 0 - 1;
    }
    // legend.bottom 数值锚（px）；未声明返回 -1（布局侧按官方默认
    // tokens.size.m = 15 处理）。
    public static int LegendAnchorBottomPx() {
        ChartOption lo = Chart.legendOpt;
        if (lo == null) { return 0 - 1; }
        if (lo.legendHasBottom && lo.legendBottomPx >= 0) { return lo.legendBottomPx; }
        return 0 - 1;
    }
    // legend.top/bottom 是否声明为 top/middle/bottom 关键字。
    public static string LegendBoxAlignY() {
        ChartOption lo = Chart.legendOpt;
        if (lo == null) { return ""; }
        if (lo.legendHasTop) {
            if (lo.legendTop == "top" || lo.legendTop == "middle"
                || lo.legendTop == "bottom") { return lo.legendTop; }
        }
        if (lo.legendHasBottom) {
            if (lo.legendBottom == "top" || lo.legendBottom == "middle"
                || lo.legendBottom == "bottom") { return lo.legendBottom; }
        }
        return "";
    }

    // 图例浮层顶边 Y（官方盒模型，供各视图共用）：
    // 显式 top 锚贴顶、显式 bottom 锚贴底（值即距底 px）、关键字
    // top/middle/bottom 对应上/中/下，均未声明时按官方默认
    // bottom = tokens.size.m = 15 贴底。lgH = 图例整体高度。
    public static int LegendFloatTop(App app, int y, int h, int lgH, int pad) {
        int vTop = Chart.LegendAnchorTopPx();
        int vBot = Chart.LegendAnchorBottomPx();
        string vAlign = Chart.LegendBoxAlignY();
        if (vTop >= 0) { return y + app.Scale(vTop); }
        if (vBot >= 0) { return y + h - app.Scale(vBot) - lgH; }
        if (vAlign == "top") { return y + pad; }
        if (vAlign == "middle") { return y + (h - lgH) / 2; }
        return y + h - app.Scale(15) - lgH;  // 官方默认 bottom 15
    }

    // 图例浮层左边 X（官方盒模型）：显式 left/right 数值锚优先，其次
    // 关键字 left/center/right，均未声明时官方默认 center（在
    // [x0, maxX] 内居中）。contentW = 图例整行/整列宽度。
    public static int LegendFloatLeft(App app, int x, int w, int contentW,
                               int pad, int x0, int maxX) {
        int lAnc = Chart.LegendAnchorLeftPx();
        int rAnc = Chart.LegendAnchorRightPx();
        if (lAnc >= 0) { return x + app.Scale(lAnc); }
        if (rAnc >= 0) { return maxX - app.Scale(rAnc) - contentW; }
        string lax = Chart.LegendBoxAlignX();
        if (lax == "left") { return x0; }
        if (lax == "right") { return maxX - contentW; }
        if (contentW > 0 && contentW <= maxX - x0) {
            return x0 + (maxX - x0 - contentW) / 2;
        }
        return x0;
    }

    // 本帧图例点击模式：0 = multiple（现状）| 1 = single |
    // -1 = false（不可点）。
    public static int LegendSelMode() {
        ChartOption lo = Chart.legendOpt;
        if (lo == null) { return 0; }
        if (lo.legendSelectedMode == "single") { return 1; }
        if (lo.legendSelectedMode == "false") { return 0 - 1; }
        return 0;
    }

    // dataRange calculable 滑条位置（0..1000）到值域的线性映射
    // （纯 seam）：q=0 → dLo、q=1000 → dHi。q 越界钳制。
    public static int DataRangeValue(int dLo, int dHi, int q) {
        int span = dHi - dLo;
        if (span < 0) { span = 0; }
        if (q < 0) { q = 0; }
        if (q > 1000) { q = 1000; }
        return dLo + span * q / 1000;
    }

    // 饼/漏斗/玫瑰扇区、和弦/力导节点：按 (系列, 数据项) 持久化隐藏。
    // 与 LegendKey 分段错开，避免单系列多扇区共用一个键把整图关掉。
    public static int LegendSliceKey(int wid, int si, int di) {
        return 6200000 + wid * 1024 + si * 64 + di;
    }
    // 饼扇区静态选中位（点击扇区切换 data.selected 的持久键）。
    public static int PieSelKey(int wid, int si, int di) {
        return 6400000 + wid * 1024 + si * 64 + di;
    }

    // 单个图例色块占宽：色块 + 间隙 + 标签文本宽 + 右侧留白。
    public static int LegendChipW(App app, string label) {
        int lgFs = ChartFonts.Legend(app);
        return app.Scale(12) + app.Scale(6)
            + Canvas.MeasureText(label, lgFs) + app.Scale(10);
    }

    // 标题行与工具箱行的底边：空标题不占大号行高，有工具箱时
    // 内容从工具箱下方开始，避免标题/色块和工具图标叠在一起。
    public static int HeadBandBottomValues(int y, int pad, int titleH,
                                    int toolboxH, int gap) {
        int h = titleH;
        if (toolboxH > h) { h = toolboxH; }
        if (h < 1) { return y + pad; }
        return y + pad + h + gap;
    }

    // 按主题内边距与标题/工具箱行高算出面板内容起始 y
    // （工具箱存在性取本帧 toolReserve）。
    public static int HeadBandBottom(App app, int y, string title) {
        int pad = app.theme.paddingMedium;
        int titleH = 0;
        if (title.Length > 0) {
            titleH = Canvas.FontHeight(Style.FontFallback(app, "large"));
            if (Chart.TitleSubText().Length > 0) {
                titleH = titleH + Canvas.FontHeight(ChartFonts.SeriesLabel(app))
                    + app.Scale(2);
            }
        }
        int toolboxH = 0;
        if (Chart.toolReserve > 0) {
            toolboxH = ChartToolbox.Height(app);
        }
        return Chart.HeadBandBottomValues(y, pad, titleH, toolboxH,
            app.Scale(4));
    }

    // 右侧色块图例一行（独立 AllocId 命中）。stateKey 跨帧持久化：
    // 点一下切换隐藏（变暗 + 删除线），再点恢复。stateKey=0 时
    // 纯展示不可点。返回是否刚点中。
    public static bool DrawLegendChip(App app, int lx, int ly, int legendW, int lh,
                               int color, string label, bool hidden, int stateKey) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int sw = app.Scale(12);
        int hitId = app.focus.AllocId();
        app.hitTester.RegisterRect(hitId, lx, ly, legendW, lh, 3);
        bool hot = app.mouseX >= lx && app.mouseX < lx + legendW
            && app.mouseY >= ly && app.mouseY < ly + lh;
        int rowCol = color;
        int lblColor = Style.Part(app, "chart", "label", "", "", "",
            Style.SNormal()).FgOr(0);
        if (hidden) {
            rowCol = ChartColor.WithAlpha(color, 90);
            lblColor = ChartColor.WithAlpha(lblColor, 110);
        }
        c.FillRoundRect(lx, ly + app.Scale(2), sw, sw, t.borderRadiusSmall, rowCol);
        if (hot && !hidden) {
            c.DrawRoundRect(lx - app.Scale(1), ly + app.Scale(1),
                sw + app.Scale(2), sw + app.Scale(2), t.borderRadiusSmall,
                t.primary, 1);
        }
        int lgFs = ChartFonts.Legend(app);
        c.DrawText(lx + sw + app.Scale(6), ly + app.Scale(1), label, lblColor, lgFs);
        if (hidden) {
            int my = ly + app.Scale(2) + Canvas.FontHeight(lgFs) / 2;
            int tw = Canvas.MeasureText(label, lgFs);
            c.FillRect(lx + sw + app.Scale(6), my, tw, 1, lblColor);
        }
        if (stateKey != 0 && Ui.Clicked(app, hitId)) {
            int nv = 1;
            if (hidden) { nv = 0; }
            app.StateSet(stateKey, nv);
            app.RequestRedraw();
            return true;
        }
        return false;
    }

    // dataZoom 窗口状态键（分类范围的千分值 0..1000）。
    public static int ZoomLoKey(int wid) { return 7000000 + wid * 2; }
    // dataZoom 窗口上界状态键（千分值 0..1000，配对 ZoomLoKey）。
    public static int ZoomHiKey(int wid) { return 7000000 + wid * 2 + 1; }
    // 树图视口平移 X（像素；世界原点相对视口的偏移）。
    public static int TreePanXKey(int wid) { return 8000000 + wid * 16; }
    // 树图视口平移 Y（像素）。
    public static int TreePanYKey(int wid) { return 8000000 + wid * 16 + 1; }
    // 树图拖拽中最近一次指针 X。
    public static int TreeDragXKey(int wid) { return 8000000 + wid * 16 + 2; }
    // 树图拖拽中最近一次指针 Y。
    public static int TreeDragYKey(int wid) { return 8000000 + wid * 16 + 3; }
    // 树图拖拽按下瞬间的视口平移 X 快照（拖拽期间平移 = 快照 - 位移）。
    public static int TreeDragPanXKey(int wid) { return 8000000 + wid * 16 + 4; }
    // 树图拖拽按下瞬间的视口平移 Y 快照。
    public static int TreeDragPanYKey(int wid) { return 8000000 + wid * 16 + 5; }
    // 树图拖拽进行中标志（1 = 按下未释放；释放帧清零）。
    public static int TreeDraggingKey(int wid) { return 8000000 + wid * 16 + 6; }
    // 树图本次拖拽是否实际移动过（1 = 移动过；释放时吞掉 click）。
    public static int TreeDragMovedKey(int wid) { return 8000000 + wid * 16 + 11; }
    // 树缩放，为自然节点间距的百分比。0 表示尚未适配：
    // 首帧（或工具箱「还原」）把整棵树放进视口中心，之后镜头
    // 就是无限画布——平移不夹紧、缩放不因窗口尺寸变化而重置。
    public static int TreeZoomKey(int wid) { return IdHash.HashInt(wid, 7); }
    // 树图漫游（平移/滚轮/拖拽）的稳定命中 id：AllocId 每帧换号
    // 会让滚轮/拖拽丢目标，此键给出跨帧稳定的 id。
    public static int TreeHitKey(int wid) { return IdHash.HashInt(wid, 10); }

    // 快照槽位的 RenderCache 指纹键（见 ChartView.RenderCached）。
    public static int CacheKey(int slot) { return IdHash.HashInt(slot, 900); }

    // toolbox / 地图漫游 / 选中（通过 HashInt 独立隔离）。
    // 数据视图覆盖层开关（1 = 打开，由工具箱「数据视图」切换）。
    public static int TbViewKey(int wid) { return IdHash.HashInt(wid, 80); }
    // 魔法类型切换状态（1 = 切为折线，2 = 切为柱状，0 = 关）。
    public static int TbMagicKey(int wid) { return IdHash.HashInt(wid, 81); }
    // 区域缩放工具开关（1 = 开）。
    public static int TbZoomKey(int wid) { return IdHash.HashInt(wid, 82); }
    // 地图漫游缩放（百分比 40..280；读到的值 < 40 视为未初始化，
    // 重置为 100）。
    public static int MapZoomKey(int wid) { return IdHash.HashInt(wid, 83); }
    // 地图漫游平移 X（像素）。
    public static int MapPanXKey(int wid) { return IdHash.HashInt(wid, 84); }
    // 地图漫游平移 Y（像素）。
    public static int MapPanYKey(int wid) { return IdHash.HashInt(wid, 85); }
    // 地图单选（selectedMode ""/"single"）选中区域下标（-1 = 无）。
    public static int MapSelKey(int wid) { return IdHash.HashInt(wid, 86); }
    // selectedMode="multiple"：按区域持久化选中位。
    public static int MapRegionSelKey(int wid, int region) {
        return IdHash.HashInt(wid, 2048 + region);
    }
    // 地图拖拽进行中标志（1 = 按下未释放；释放帧清零）。
    public static int MapDragKey(int wid) { return 8200000 + wid * 8 + 7; }
    // 地图拖拽中最近一次指针 X。
    public static int MapDragXKey(int wid) { return 8300000 + wid * 4; }
    // 地图拖拽中最近一次指针 Y。
    public static int MapDragYKey(int wid) { return 8300000 + wid * 4 + 1; }
    // 地图拖拽按下瞬间的平移 X 快照。
    public static int MapDragPanXKey(int wid) { return 8300000 + wid * 4 + 2; }
    // 地图拖拽按下瞬间的平移 Y 快照。
    public static int MapDragPanYKey(int wid) { return 8300000 + wid * 4 + 3; }
    // 工具箱第 k 个按钮的命中 id（k 为按钮在当排中的序号）。
    public static int TbHitKey(int wid, int k) { return 8500000 + wid * 8 + k; }

    // ---- connect() 多图联动（ECharts connect：同组图表共享交互态）----
    // 组号由调用方声明（ConnectGroup()），组内所有图表把交互态键
    // 重定向到「组长」的 wid 上（同组第一张图），于是任何一张图里
    // 的 dataZoom 窗口 / 图例开关 / 十字线悬停类别，组内其余图同帧
    // 生效——键段 8600000（组长 wid * 16 + 槽）。
    // 组登记键：同组第一张到达 Resolve 的图把自己的 wid（组长）
    // 写进这里，其余图读它得到共享键基址；读到 0 = 尚未登记。
    public static int ConnectGroupKey(int wid) { return 8600000 + wid * 16; }
    // connect 组共享的「悬停类别下标」状态键（读写都落在组长
    // wid 上）：组内图指针在绘图区内时写入自己的类别下标，
    // 其余图同帧读它对齐十字线；组长登记时初始化为 -1（无悬停）。
    public static int ConnectHoverKey(int wid) { return 8600000 + wid * 16 + 1; }

    // 将缩放窗口（千分值）解析为包含端点的分类索引范围 [i0,i1]。
    // 首次调用时从 ChartOption.zoomStart/zoomEnd 初始化状态。
    public static int ZoomI0(App app, ChartOption o, int wid, int n) {
        int lo = app.StateGet(Chart.ZoomLoKey(wid), 0 - 1);
        if (lo < 0) {
            lo = o.zoomStart * 10;
            // startValue 按类目名定位窗口起点（line-aqi 的
            // "2014-06-01"）；未声明或找不到类目回落百分比域。
            if (o.zoomStartValue != null && o.zoomStartValue.Length > 0 && n > 1) {
                int zi = Chart.CategoryIndexOf(o.XCategories(),
                    o.zoomStartValue);
                if (zi >= 0) { lo = zi * 1000 / (n - 1); }
            }
            app.StateSet(Chart.ZoomLoKey(wid), lo);
        }
        int i0 = lo * (n - 1) / 1000;
        if (i0 < 0) { i0 = 0; }
        if (i0 > n - 1) { i0 = n - 1; }
        return i0;
    }
    // 窗口末端索引（与 ZoomI0 成对）。
    public static int ZoomI1(App app, ChartOption o, int wid, int n) {
        int hi = app.StateGet(Chart.ZoomHiKey(wid), 0 - 1);
        if (hi < 0) {
            hi = o.zoomEnd * 10;
            if (o.zoomEndValue != null && o.zoomEndValue.Length > 0 && n > 1) {
                int zi = Chart.CategoryIndexOf(o.XCategories(),
                    o.zoomEndValue);
                if (zi >= 0) { hi = zi * 1000 / (n - 1); }
            }
            app.StateSet(Chart.ZoomHiKey(wid), hi);
        }
        int i1 = hi * (n - 1) / 1000;
        if (i1 < 0) { i1 = 0; }
        if (i1 > n - 1) { i1 = n - 1; }
        return i1;
    }

    // 将标签窗口化为包含端点的索引范围 [i0,i1]（仅字符串
    // 拷贝；渲染器对系列值也按同一 [i0,i1] 直接读原系列，
    // 避免有损的系列克隆丢失 itemStyle/marks 等字段）。
    public static List<string> WindowLabels(List<string> labels, int i0, int i1) {
        List<string> outp = new List<string>();
        int i = i0;
        while (i <= i1 && i < labels.Count) { outp.Add(labels[i]); i = i + 1; }
        return outp;
    }

    // 类目名精确匹配的首个下标；未命中 -1（dataZoom
    // startValue/endValue 的类目定位用）。
    public static int CategoryIndexOf(List<string> cats, string name) {
        for (int i = 0; i < cats.Count; i = i + 1) {
            if (cats[i] == name) { return i; }
        }
        return 0 - 1;
    }

    // N2：dataZoom slider 官方契约（SliderZoomView.ts 源对抄）。
    // 条几何：height 缺省 30（DEFAULT_FILLER_SIZE）；锚 bottom 缺省
    // defaultLocationEdgeGap 15 + moveHandle 7（条占 [H-52, H-22]，
    // moveHandle 挂条底 [H-22, H-15]）；声明 height/bottom/top
    // （px|'N%'）覆盖；宽 = 绘图区宽（官方 width:'ph' 对齐
    // coordRect），声明 left/right/width 覆盖。层序（官方 z2 序）：
    // dataBackground 阴影（全条宽，代表系列值域 ±30% 外扩折算条高，

    // ---- 坐标系（双轴 + 友好刻度 + 标题）----

    // 点坐标定点值除回真实值（points 存 值×pointG，g<=1 原值跳过）：
    // 四舍五入、负值对称。散点/值对折线的渲染映射、量程、命中与
    // tooltip 统一走这里（ECharts 小数坐标在 int 管线的承载约定，
    // 与折线 value 的 g/1000 同构）。
    public static int PointV(int v, int g) {
        if (g <= 1) { return v; }
        if (v >= 0) { return (v + g / 2) / g; }
        return 0 - ((0 - v + g / 2) / g);
    }

    // 点坐标定点值的提示文本：g<=1 直接整数；g>1 按 g 的十进制
    // 位数输出定点小数（1000 → 3 位，-1500/1000 → "-1.5"），
    // tooltip/状态栏展示与 PointV 的除回约定配套。
    public static string PointText(int v, int g) {
        if (g <= 1) { return Convert.ToString(v); }
        bool neg = v < 0;
        int av = neg ? 0 - v : v;
        int ip = av / g;
        int fr = av - ip * g;
        int dg = g;
        int dc = 0;
        while (dg > 1) { dg = dg / 10; dc = dc + 1; }
        string fs = Convert.ToString(fr);
        while (fs.Length < dc) { fs = "0" + fs; }
        return (neg ? "-" : "") + Convert.ToString(ip) + "." + fs;
    }

    // 散点双 value 轴缺省 scale:true 的紧致 nice 量程：不强制含 0，
    // 数据域两端对齐到 nice 步长（NiceRange 的零锚定对身高体重这
    // 类有自然域的散点会把云挤进角落，ECharts 原版贴数据包络）。
    // 步长候选同 smartSteps：1/2/2.5/5 × 10^k，splitNumber
    // （5）只是预估——实际分段数取包络/步长。
    // ECharts 6 单侧并入 0（`coord/scaleRawExtentInfo.ts:302-312`）：
    // 仅在需要并入 0（!scale）且该端未被显式 min/max 固定时生效。
    // 调用顺序必须是 lo 再 hi——源码按序读改写后的数组。
    public static int ZeroAnchorLo(bool scale, bool fixLo, int lo, int hi) {
        if (scale || fixLo) { return lo; }
        if (lo > 0 && hi > 0) { return 0; }
        return lo;
    }

    // 见 ZeroAnchorLo：全负数据把上界归 0。
    public static int ZeroAnchorHi(bool scale, bool fixHi, int lo, int hi) {
        if (scale || fixHi) { return hi; }
        if (lo < 0 && hi < 0) { return 0; }
        return hi;
    }

    public static ChartSpan ScatterAutoRange(int lo, int hi) {
        if (hi < lo) {
            int tmp = lo;
            lo = hi;
            hi = tmp;
        }
        if (lo == hi) {
            if (lo == 0) {
                hi = lo + 1;
            } else if (lo > 0) {
                lo = 0;
            } else {
                hi = 0;
            }
        }
        if (lo == hi) { hi = lo + 1; }
        int span = hi - lo;
        if (span < 5) {
            return Chart.SmartForInteger(lo, hi, 0);
        }
        int avg = span / 5;
        if (span % 5 > 0) { avg = avg + 1; }
        int step = Chart.NiceStepUp(avg);
        ChartSpan s = new ChartSpan();
        s.lo = Chart.FloorDivQ(lo, step) * step;
        s.hi = Chart.CeilDivQ(hi, step) * step;
        s.ticks = (s.hi - s.lo) / step;
        return s;
    }

    // ≥ v 的最小 1/2/2.5/5 × 10^k（nice 步长候选）。
    public static int NiceStepUp(int v) {
        if (v < 1) { return 1; }
        int d = 1;
        while (d * 10 <= v) { d = d * 10; }
        if (v <= d) { return d; }
        if (v <= 2 * d) { return 2 * d; }
        if (v <= 25 * d / 10) { return 25 * d / 10; }
        if (v <= 5 * d) { return 5 * d; }
        return 10 * d;
    }

    // 绑定到给定数值轴的（可见）系列中的最大值。
    // 窗口参数 i0/i1 把扫描范围限制到 dataZoom 可见段（ECharts 6
    // 默认 filterMode:'weakFilter' 即窗口内数据重定 Y 量程；此前
    // 一律全量扫描，area-time-axis / area-rainfall 这类 65..85%
    // 窗口图保留 -2000..2000 全域，画面被压到顶端 1% 像素可见）。
    // i0<0 || i1<0 = 扫描全量（旧默认行为）。
    public static int AxisMaxFor(List<ChartSeries> series, int axisIndex, int i0, int i1, bool scale) {
        return Chart.AxisMaxFor(series, axisIndex, i0, i1, scale, true);
    }

    public static int AxisMaxFor(List<ChartSeries> series, int axisIndex, int i0, int i1, bool scale, bool hasRight) {
        int mx = 0;
        // scale（axis.scale:true）：0 不并入量程——ECharts 的 incl0 由
        // `needIncludeZero() = !option.scale` 决定（axisModelCommonMixin.ts:33）。
        bool any = !scale;
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            if (Chart.SeriesMatchesAxis(s, axisIndex, hasRight)) {
                int j0 = 0; int j1 = s.Count() - 1;
                if (i0 >= 0 && i1 >= 0) {
                    j0 = i0; j1 = i1;
                    if (j0 > s.Count() - 1) { j0 = s.Count() - 1; }
                    if (j1 > s.Count() - 1) { j1 = s.Count() - 1; }
                    if (j1 < j0) { j1 = j0; }
                }
                // points 系列（[[x,y],...] 数值对）的 y 由下方 points
                // 环按 PointV 除回真值取极值——Value() 读到的是
                // ×pointG 定点原值，混进来会把量程放大 1000 倍
                // （line-in-cartesian 的 y 轴曾画成 0..100,000，
                // 声明 min/max 与真值域错位）。
                if (s.data.Count > 0) {
                    for (int j = j0; j <= j1; j = j + 1) {
                        int v = s.Value(j);
                        if (!any || v > mx) { mx = v; any = true; }
                    }
                }
                if (s.points.Count < 1) { continue; }
                int p0 = 0; int p1 = s.points.Count - 1;
                if (i0 >= 0 && i1 >= 0) {
                    p0 = i0; p1 = i1;
                    if (p0 > s.points.Count - 1) { p0 = s.points.Count - 1; }
                    if (p1 > s.points.Count - 1) { p1 = s.points.Count - 1; }
                    if (p1 < p0) { p1 = p0; }
                }
                for (int j2 = p0; j2 <= p1; j2 = j2 + 1) {
                    int py = Chart.PointV(s.points[j2].y, s.pointG);
                    if (!any || py > mx) { mx = py; any = true; }
                }
            }
        }
        return mx;
    }

    // AxisMaxFor 的 1/1000 定点对偶：小数系列按 Number（未取整）
    // 比较，整数按 Value×1000。ECharts extent 语义：原始数据上界
    // 直传（不许钳零），锚定/取整全部由 NiceRange（smartSteps）
    // 承担——见 valueAxis._calculateValue/_reformValue。
    // i0/i1 窗口语义同 AxisMaxFor。
    public static int AxisMaxForF(List<ChartSeries> series, int axisIndex, int i0, int i1, bool scale) {
        return Chart.AxisMaxForF(series, axisIndex, i0, i1, scale, true);
    }

    public static int AxisMaxForF(List<ChartSeries> series, int axisIndex, int i0, int i1, bool scale, bool hasRight) {
        int mx = 0;
        // 与 AxisMinForF 成对：scale 时 0 不参与，取不到数据才回退 0
        // （空轴仍要能渲染）。
        bool any = !scale;
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            if (Chart.SeriesMatchesAxis(s, axisIndex, hasRight)) {
                int j0 = 0; int j1 = s.Count() - 1;
                if (i0 >= 0 && i1 >= 0) {
                    j0 = i0; j1 = i1;
                    if (j0 > s.Count() - 1) { j0 = s.Count() - 1; }
                    if (j1 > s.Count() - 1) { j1 = s.Count() - 1; }
                    if (j1 < j0) { j1 = j0; }
                }
                for (int j = j0; j <= j1; j = j + 1) {
                    double v = s.Number(j);
                    int vi = (int)(v * 1000 + (v >= 0 ? 0.5 : 0 - 0.5));
                    if (!any || vi > mx) { mx = vi; any = true; }
                }
                if (s.points.Count < 1) { continue; }
                int p0 = 0; int p1 = s.points.Count - 1;
                if (i0 >= 0 && i1 >= 0) {
                    p0 = i0; p1 = i1;
                    if (p0 > s.points.Count - 1) { p0 = s.points.Count - 1; }
                    if (p1 > s.points.Count - 1) { p1 = s.points.Count - 1; }
                    if (p1 < p0) { p1 = p0; }
                }
                for (int j2 = p0; j2 <= p1; j2 = j2 + 1) {
                    int py = Chart.PointV(s.points[j2].y, s.pointG) * 1000;
                    if (!any || py > mx) { mx = py; any = true; }
                }
            }
        }
        return mx;
    }

    // 绑定到给定轴的可见系列是否存在小数数据（numberSet 且值
    // 非整数）。小数轴渲染/量程/提示共用的判定开关。
    public static bool SeriesFracAny(List<ChartSeries> series, int axisIndex) {
        return Chart.SeriesFracAny(series, axisIndex, true);
    }

    public static bool SeriesFracAny(List<ChartSeries> series, int axisIndex, bool hasRight) {
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            if (!Chart.SeriesMatchesAxis(s, axisIndex, hasRight)) { continue; }
            for (int j = 0; j < s.Count(); j = j + 1) {
                if (s.SeriesFrac(j)) { return true; }
            }
            // points 系列（[[x,y],...] 数值对）：坐标以 ×pointG 定点
            // 承载，y 非整倍数即小数坐标（line-easing y 0..1 步长
            // 1/30、line-function 的 sin 值）——交给小数轴管线
            // （×1000 定点域）承载；SeriesFrac 只认 data[]，points
            // 全部漏判会让小数轴被 PointV 取整压扁。
            if (s.pointG > 1 && s.data.Count == 0) {
                for (int j = 0; j < s.points.Count; j = j + 1) {
                    if (s.points[j].y % s.pointG != 0) { return true; }
                }
            }
        }
        return false;
    }

    // 散点轴的小数判定（B18）：坐标在 points 以 ×pointG 定点承载，
    // 非整倍数即小数坐标。xAxis=true 查 x 列（scatter-linear-regression
    // 的 0.03..0.99），false 查 y 列；data[] 小数判定只对 y 有意义
    // （SeriesFrac）。类目下标定点（CatIdx1000）恰为整倍数不误报；
    // 时间对（epoch 天，pointG=1）不进。
    public static bool ScatterAxisFrac(List<ChartSeries> series, bool xAxis) {
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            if (s.hidden || s.points.Count < 1) { continue; }
            if (s.pointG > 1 && s.data.Count == 0) {
                for (int j = 0; j < s.points.Count; j = j + 1) {
                    int v = xAxis ? s.points[j].x : s.points[j].y;
                    if (v % s.pointG != 0) { return true; }
                }
            }
        }
        return false;
    }

    // 绑定到给定数值轴的（可见）系列中的最小值
    // （无负数时为 0），使轴天然覆盖负数。i0/i1 窗口语义同
    // AxisMaxFor。
    public static int AxisMinFor(List<ChartSeries> series, int axisIndex, int i0, int i1, bool scale) {
        return Chart.AxisMinFor(series, axisIndex, i0, i1, scale, true);
    }

    public static int AxisMinFor(List<ChartSeries> series, int axisIndex, int i0, int i1, bool scale, bool hasRight) {
        int mn = 0;
        // 见 AxisMaxFor：scale 时 0 不参与（incl0 = !scale）。
        bool any = !scale;
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            if (Chart.SeriesMatchesAxis(s, axisIndex, hasRight)) {
                int j0 = 0; int j1 = s.Count() - 1;
                if (i0 >= 0 && i1 >= 0) {
                    j0 = i0; j1 = i1;
                    if (j0 > s.Count() - 1) { j0 = s.Count() - 1; }
                    if (j1 > s.Count() - 1) { j1 = s.Count() - 1; }
                    if (j1 < j0) { j1 = j0; }
                }
                if (s.data.Count > 0) {
                    for (int j = j0; j <= j1; j = j + 1) {
                        int v = s.Value(j);
                        if (!any || v < mn) { mn = v; any = true; }
                    }
                }
                if (s.points.Count < 1) { continue; }
                int p0 = 0; int p1 = s.points.Count - 1;
                if (i0 >= 0 && i1 >= 0) {
                    p0 = i0; p1 = i1;
                    if (p0 > s.points.Count - 1) { p0 = s.points.Count - 1; }
                    if (p1 > s.points.Count - 1) { p1 = s.points.Count - 1; }
                    if (p1 < p0) { p1 = p0; }
                }
                for (int j2 = p0; j2 <= p1; j2 = j2 + 1) {
                    int py = Chart.PointV(s.points[j2].y, s.pointG);
                    if (!any || py < mn) { mn = py; any = true; }
                }
            }
        }
        return mn;
    }

    // X 数值轴最小值：值对系列取 points.x，轴互换系列取 values
    // （gap 项不计）；固定覆盖在调用方处理。
    public static int XMinFor(List<ChartSeries> series, bool fromValues, bool scale) {
        int mn = 0;
        // scale（axis.scale:true）时不并入 0，同 AxisMinFor。
        bool any = !scale;
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            if (s.hidden) { continue; }
            if (fromValues) {
                for (int j = 0; j < s.data.Count; j = j + 1) {
                    if (!s.data[j].gap) {
                        int v = s.data[j].val;
                        if (!any || v < mn) { mn = v; any = true; }
                    }
                }
            } else {
                for (int j = 0; j < s.points.Count; j = j + 1) {
                    int px = Chart.PointV(s.points[j].x, s.pointG);
                    if (!any || px < mn) { mn = px; any = true; }
                }
            }
        }
        return mn;
    }
    // X 数值轴最大值（XMinFor 的对偶）。
    public static int XMaxFor(List<ChartSeries> series, bool fromValues, bool scale) {
        int mx = 0;
        bool any = !scale;
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            if (s.hidden) { continue; }
            if (fromValues) {
                for (int j = 0; j < s.data.Count; j = j + 1) {
                    if (!s.data[j].gap) {
                        int v = s.data[j].val;
                        if (!any || v > mx) { mx = v; any = true; }
                    }
                }
            } else {
                for (int j = 0; j < s.points.Count; j = j + 1) {
                    int px = Chart.PointV(s.points[j].x, s.pointG);
                    if (!any || px > mx) { mx = px; any = true; }
                }
            }
        }
        return mx;
    }

    // 格式化标签比裸数值多占的宽度（axisLabel.formatter 模板，
    // 如 "{value} °C"），供轴栏预留。
    public static int FormatterExtraW(string fmt, int v, int fs) {
        string raw = Chart.Commas(v);
        string full = fmt.Replace("{value}", raw);
        return Canvas.MeasureText(full, fs) - Canvas.MeasureText(raw, fs);
    }

    // 是否存在绑定 axisIndex 轴的可见系列。
    public static bool AnyOnAxis(List<ChartSeries> series, int axisIndex) {
        for (int i = 0; i < series.Count; i = i + 1) {
            if (!series[i].hidden && series[i].axisIndex == axisIndex) { return true; }
        }
        return false;
    }

    // 将原始最小值向下取整为友好的负轴下界（-2/-5/-10 * 10^n）；
    // 没有负数需要覆盖时返回 0。
    public static int NiceMin(int v) {
        if (v >= 0) { return 0; }
        int av = 0 - v;
        if (av <= 5) { return 0 - 5; }
        int mag = 1;
        while (mag * 10 <= av) { mag = mag * 10; }
        int unit = av / mag;
        int nice = 10;
        if (unit < 2) { nice = 2; } else if (unit < 5) { nice = 5; }
        return 0 - nice * mag;
    }

    // double 重载：显式界可能是 -0.4 这类小数（line-easing），
    // 走 int 会截断成 0。语义改用 ECharts 的 NICE_MODE_MIN
    // （number.ts:633 `mode===NICE_MODE_MIN` 恒取 nf=1，即 10^exponent
    // 向上覆盖到 |v|），而不是旧的 2/5/10 阶梯。
    public static double NiceMin(double v) {
        if (v >= 0.0) { return 0.0; }
        double av = 0.0 - v;
        int exponent = Chart.QuantityExponent(av);
        double n = Chart.Pow10D(exponent);
        if (n < av) { n = n * 10.0; }
        return 0.0 - n;
    }

    // 从数据 + 固定覆盖解析数值轴的 [lo, hi] 范围（fixedLo/fixedHi
    // 取 ChartOption.Auto() 时从数据推导）。有负值时下界自动扩展
    // 到 0 以下。
    // 横条值轴 'dataMin'/'dataMax' 的原始极值（不零锚、不 nice）：
    // 可见系列的最小/最大值，官方 dataMM = 系列数据并集。
    public static int BarDataMinRaw(List<ChartSeries> series) {
        int mn = 0;
        bool any = false;
        for (int i = 0; i < series.Count; i = i + 1) {
            if (series[i].hidden) { continue; }
            for (int j = 0; j < series[i].Count(); j = j + 1) {
                int v = series[i].Value(j);
                if (!any || v < mn) { mn = v; any = true; }
            }
        }
        return mn;
    }

    public static int BarDataMaxRaw(List<ChartSeries> series) {
        int mx = 0;
        bool any = false;
        for (int i = 0; i < series.Count; i = i + 1) {
            if (series[i].hidden) { continue; }
            for (int j = 0; j < series[i].Count(); j = j + 1) {
                int v = series[i].Value(j);
                if (!any || v > mx) { mx = v; any = true; }
            }
        }
        return mx;
    }

    public static int AxisLo(int fixedLo, int dataMin) {
        return Chart.AxisLo(fixedLo, dataMin, false);
    }
    // scale 版：axis.scale:true 时不做同号归零（原始数据下界直传，
    // 取整交给 NiceRange/smartSteps）。出处 ECharts
    // 才 `_min = 0`。
    public static int AxisLo(int fixedLo, int dataMin, bool scale) {
        if (fixedLo != ChartOption.Auto()) { return fixedLo; }
        if (scale) { return dataMin; }
        return Chart.NiceMin(dataMin);
    }
    // 数值轴上界：固定覆盖优先，否则 NiceMax；保证 hi > lo。
    // 数据全为非正（dataMax <= 0 且有负值）时上界归 0——雨量图
    // 这类全负系列的上界不该被 NiceMax(0)=5 顶出一段空白。
    // 注意这里**不**按 axis.scale 分叉：ECharts 6 的 ECharts 侧
    // `scaleRawExtentInfo` 在 scale:true 下确实不做单侧并入 0，但本函
    // 数只服务"整数近似"这条老管道（NiceMax 对负数返回 5 本身就不合
    // 源），归 0 比 5 更接近源；自动量程那条路（leftDataMax<0 或
    // y0.scale）由 NiceRange 接管，scale 语义在那里生效。
    public static int AxisHi(int fixedHi, int dataMax, int lo) {
        int hi = Chart.NiceMax(dataMax);
        if (fixedHi != ChartOption.Auto()) { hi = fixedHi; }
        if (fixedHi == ChartOption.Auto() && dataMax <= 0 && lo < 0) { hi = 0; }
        if (hi <= lo) { hi = lo + 1; }
        return hi;
    }

    // ECharts 数值默认千分位（axisLabel 的 {value}、tooltip 数值
    // 都过 addCommas）：3000 → "3,000"，负号不占分组位。
    public static string Commas(int v) {
        bool neg = v < 0;
        string d = Convert.ToString(neg ? 0 - v : v);
        int n = d.Length;
        if (n <= 3) { return neg ? "-" + d : d; }
        StringBuilder b = new StringBuilder();
        if (neg) { b.Append("-"); }
        int firstGroup = n % 3;
        if (firstGroup == 0) { firstGroup = 3; }
        b.Append(d.Substring(0, firstGroup));
        int i = firstGroup;
        while (i < n) {
            b.Append(",");
            b.Append(d.Substring(i, 3));
            i = i + 3;
        }
        return b.ToString();
    }

    // 1/1000 定点 → 小数文本：fr 为 0 时输出整数（500000 → "500"、
    // -1000 → "-1"），否则两位小数去尾零（500 → "0.5"、860 →
    // "0.86"）。折线小数值（line6 流量 0.86..1.5）在 int 渲染
    // 管线的承载约定：值 ×1000 存整型，展示前经此除回。
    public static string FracText(int v) {
        bool neg = v < 0;
        int av = neg ? 0 - v : v;
        int ip = av / 1000;
        int fr = (av - ip * 1000 + 5) / 10;
        if (fr >= 100) { ip = ip + 1; fr = fr - 100; }
        if (fr == 0) {
            string whole = Chart.Commas(ip);
            return neg ? "-" + whole : whole;
        }
        string fs = Convert.ToString(fr);
        while (fs.Length > 1 && (fs[fs.Length - 1] & 255) == 48) {
            fs = fs.Substring(0, fs.Length - 1);
        }
        string o = Convert.ToString(ip) + "." + fs;
        return neg ? "-" + o : o;
    }

    // 系列第 i 项的展示文本：小数系列（numberSet 且非整数）输出
    // 两位小数（ECharts 数值默认 ×1000 定点），整数系列仍是
    // 千分位整数——与轴刻度、tooltip 的展示约定一致。
    // labelLayout moveOverlap 的一维解叠（labelLayoutHelper.ts
    // shiftLayoutOnXY:324 的化简——sort by rect pos + 前向顶开，
    // delta = pos - 前盒末缘，负则推到前盒末缘；他们的 bounds
    // squeeze / balanceShift 不在语料路径，未移）。pos 须按升序
    // 给定（调用方带索引排序），size 为各盒沿轴长度，gap = 盒间缝。
    public static List<int> LlShift1D(List<int> pos, List<int> size, int gap) {
        int n = pos.Count;
        List<int> cur = new List<int>();
        for (int i = 0; i < n; i = i + 1) { cur.Add(pos[i]); }
        for (int i = 1; i < n; i = i + 1) {
            int lim = cur[i - 1] + size[i - 1] + gap;
            if (cur[i] < lim) { cur[i] = lim; }
        }
        return cur;
    }

    public static string SeriesNumText(ChartSeries s, int i) {
        if (s.SeriesFrac(i)) {
            double dn = s.Number(i);
            return Chart.FracText((int)(dn * 1000 + (dn >= 0 ? 0.5 : 0 - 0.5)));
        }
        return Chart.Commas(s.Value(i));
    }

    // [lo, hi] 范围分成 `ticks` 步时最宽的刻度标签（像素），
    // 用于预留左/右轴 gut 宽度。
    public static int TickLabelW(int lo, int hi, int ticks, int fs) {
        int span = hi - lo;
        int wmax = 0;
        for (int k = 0; k <= ticks; k = k + 1) {
            int val = lo + span * k / ticks;
            int lw = Canvas.MeasureText(Chart.Commas(val), fs);
            if (lw > wmax) { wmax = lw; }
        }
        return wmax;
    }

    // TickLabelW 的 ×1000 定点对偶：小数轴刻度文本（FracText）
    // 的最宽像素。
    public static int TickLabelWF(int loF, int hiF, int ticks, int fs) {
        int span = hiF - loF;
        int wmax = 0;
        for (int k = 0; k <= ticks; k = k + 1) {
            int lw = Canvas.MeasureText(Chart.FracText(loF + span * k / ticks), fs);
            if (lw > wmax) { wmax = lw; }
        }
        return wmax;
    }

}
