using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// ChartView 渲染器共享的绘图工具：颜色、比例辅助、
// 面板/图例框架、dataZoom 滑块、标记线/区域、直角坐标系和
// 双轴坐标构建器。一次性的静态渲染器（Chart.Line/
// Bar/Pie/...）已移除——所有图表现在声明为 ChartOption
// 并由 ChartView 绘制。

// 图表单帧渲染上下文与布局槽位（面向对象化封装）
public class ChartRenderContext {
    // 本帧工具箱占用的右上角宽度；DrawPanelI / PanelHead 让开它。
    public int toolReserve;
    // 本帧 option（图例子字段 orient/selectedMode/formatter 的来源）；
    public ChartOption legendOpt;
    // 本帧水平图例占用的底部高度
    public int legendBottomReserve;
    // dataZoom 滑条预留带
    public int zoomBandReserve;
    // 多 grid 子面板帧内约定
    public bool gridPanelSub;
    // 多 grid 子面板滑条跳过标记
    public bool zoomBarHidden;

    // 单帧复用几何顶点缓冲（Zero-Alloc 避免渲染高频重复创建临时 List）
    public List<int> pooledPx;
    public List<int> pooledPy;

    // 通用零分配槽位（整型布局、坐标计算与解叠池）
    public List<int> scratchI1;
    public List<int> scratchI2;
    public List<int> scratchI3;
    public List<int> scratchI4;
    public List<int> scratchI5;
    public List<int> scratchI6;
    public List<int> scratchI7;
    public List<int> scratchI8;
    public List<string> scratchS1;
    public List<ChartTextStyle> scratchTs1;
    public List<ChartSeries> scratchSer1;
    public List<ChartMapPoint> scratchPoly1;

    public ChartRenderContext() {
        this.EnsureScratch();
    }

    public void EnsureScratch() {
        if (this.pooledPx == null) { this.pooledPx = new List<int>(); }
        if (this.pooledPy == null) { this.pooledPy = new List<int>(); }
        if (this.scratchI1 == null) { this.scratchI1 = new List<int>(); }
        if (this.scratchI2 == null) { this.scratchI2 = new List<int>(); }
        if (this.scratchI3 == null) { this.scratchI3 = new List<int>(); }
        if (this.scratchI4 == null) { this.scratchI4 = new List<int>(); }
        if (this.scratchI5 == null) { this.scratchI5 = new List<int>(); }
        if (this.scratchI6 == null) { this.scratchI6 = new List<int>(); }
        if (this.scratchI7 == null) { this.scratchI7 = new List<int>(); }
        if (this.scratchI8 == null) { this.scratchI8 = new List<int>(); }
        if (this.scratchS1 == null) { this.scratchS1 = new List<string>(); }
        if (this.scratchTs1 == null) { this.scratchTs1 = new List<ChartTextStyle>(); }
        if (this.scratchSer1 == null) { this.scratchSer1 = new List<ChartSeries>(); }
        if (this.scratchPoly1 == null) { this.scratchPoly1 = new List<ChartMapPoint>(); }
    }

    public void Reset() {
        this.toolReserve = 0;
        this.legendOpt = null;
        this.legendBottomReserve = 0;
        this.zoomBandReserve = 0;
        this.gridPanelSub = false;
        this.zoomBarHidden = false;
        this.EnsureScratch();
        this.pooledPx.Clear();
        this.pooledPy.Clear();
        this.scratchI1.Clear();
        this.scratchI2.Clear();
        this.scratchI3.Clear();
        this.scratchI4.Clear();
        this.scratchI5.Clear();
        this.scratchI6.Clear();
        this.scratchI7.Clear();
        this.scratchI8.Clear();
        this.scratchS1.Clear();
        this.scratchTs1.Clear();
        this.scratchSer1.Clear();
        this.scratchPoly1.Clear();
    }
}

public partial class Chart {
    // 单帧上下文托管实例
    public static ChartRenderContext renderContext = new ChartRenderContext();
    public static ChartRenderContext RenderContext { get { return Chart.renderContext; } }

    public static int toolReserve {
        get { return Chart.renderContext.toolReserve; }
        set { Chart.renderContext.toolReserve = value; }
    }
    public static ChartOption legendOpt {
        get { return Chart.renderContext.legendOpt; }
        set { Chart.renderContext.legendOpt = value; }
    }
    public static int legendBottomReserve {
        get { return Chart.renderContext.legendBottomReserve; }
        set { Chart.renderContext.legendBottomReserve = value; }
    }
    public static int zoomBandReserve {
        get { return Chart.renderContext.zoomBandReserve; }
        set { Chart.renderContext.zoomBandReserve = value; }
    }
    public static bool gridPanelSub {
        get { return Chart.renderContext.gridPanelSub; }
        set { Chart.renderContext.gridPanelSub = value; }
    }
    public static bool zoomBarHidden {
        get { return Chart.renderContext.zoomBarHidden; }
        set { Chart.renderContext.zoomBarHidden = value; }
    }

    // 帧渲染完成后的状态收口与重置，彻底解除 static 保持根对 drawOption / App 的持有。
    public static void EndFrame() {
        Chart.renderContext.Reset();
        ChartColor.fadeFocusIdx = -1;
    }

    // 符号形状族绘制（ECharts series.symbol）：shape 取
    // circle（默认实心圆）/ emptyCircle（环）/ rectangle / diamond /
    // triangle。r 为外接半径；borderWidth>0 时用 borderColor 描边。
    // 全部为不透明覆盖、无二次混合，指纹稳定。
    public static void DrawSymbol(Canvas c, int cx, int cy, int r, string shape,
                           int color, int borderColor, int borderWidth) {
        Chart.DrawSymbolGrad(c, cx, cy, r, shape, color, borderColor, borderWidth, null);
    }

    public static void DrawSymbolGrad(Canvas c, int cx, int cy, int r, string shape,
                               int color, int borderColor, int borderWidth,
                               List<int> gradStops) {
        if (shape == "none" || shape == "pass") { return; }
        if (r < 1) { r = 1; }
        if (shape == "rectangle") {
            int d = r * 71 / 100;  // 内接正方形半边（与圆同视觉重量）
            c.FillRect(cx - d, cy - d, d * 2 + 1, d * 2 + 1, color);
        } else if (shape == "diamond") {
            for (int dy = 0 - r; dy <= r; dy = dy + 1) {
                int hw = r - (dy < 0 ? 0 - dy : dy);
                c.FillRect(cx - hw, cy + dy, hw * 2 + 1, 1, color);
            }
        } else if (shape == "triangle") {
            // 上顶点，底边在下：行 r0 距顶点 dy，半宽 = r * dy / r。
            for (int dy = 0 - r; dy <= r; dy = dy + 1) {
                int hw = (r * (dy + r)) / (2 * r);
                if (hw < 0) { hw = 0; }
                c.FillRect(cx - hw, cy + dy, hw * 2 + 1, 1, color);
            }
        } else if (shape == "star" || shape == "star5" || shape == "star6"
                   || shape == "arrow"
                   || shape == "droplet" || shape == "pin"
                   || shape == "emptypin"
                   || shape == "heart" || shape == "emptyheart") {
            // ECharts 其余符号形状：顶点多边形扫描线填充
            // （顶点表见 Chart.PolyVerts1000）。empty* 变体按原语义
            // 画白芯（getSymbolShape：empty 符号 color='#fff' 填充、
            // 色环即本体，环宽缺省 2）。
            List<int> vx = null;
            List<int> vy = null;
            if (Chart.GetPolyVertsCached(shape, out vx, out vy) && vx != null && vy != null) {
                Chart.FillPoly1000(c, cx, cy, r, vx, vy, color);
            }
            if (shape == "emptypin" || shape == "emptyheart") {
                int ew = borderWidth > 0 ? borderWidth : 2;
                if (r > ew) {
                    Chart.FillPoly1000(c, cx, cy, r - ew, vx, vy, 0xFFFFFFFF);
                }
            }
        } else if (shape == "emptyCircle") {
            // ECharts emptyCircle：白芯 + 色环（折线 emptyColor '#fff'，
            // 环宽 = borderWidth，缺省取 lineStyle.width，再缺省 2）。
            // 填充圆在像素中心采样下 dx=r 的格点覆盖为 0（外缘半像素
            // 落空），白芯抹掉内圈后色环缩进 1px——DrawCircle 在半径
            // 处再描 1px 把外缘补齐，测试与视觉的环外径都回到 r。
            int ew = borderWidth > 0 ? borderWidth : 2;
            c.FillCircle(cx, cy, r, color);
            if (r > ew) { c.FillCircle(cx, cy, r - ew, 0xFFFFFFFF); }
            c.DrawCircle(cx, cy, r, color, 1);
        } else {
            if (gradStops != null && gradStops.Count >= 2 && r > 2) {
                int baseCol = gradStops[gradStops.Count - 1];
                int lightCol = gradStops[0];
                c.FillCircle(cx, cy, r, baseCol);
                c.FillRadial(cx - r / 4, cy - r / 4, r * 3 / 4, lightCol, 210);
            } else {
                c.FillCircle(cx, cy, r, color);
            }
        }
        if (borderWidth > 0 && borderColor != 0) {
            if (shape == "rectangle" || shape == "diamond" || shape == "triangle") {
                if (Chart.scratchBorderXs == null) {
                    Chart.scratchBorderXs = new List<int>();
                    Chart.scratchBorderYs = new List<int>();
                }
                List<int> xs = Chart.scratchBorderXs;
                List<int> ys = Chart.scratchBorderYs;
                xs.Clear(); ys.Clear();
                if (shape == "rectangle") {
                    int d = r * 71 / 100;
                    xs.Add(cx - d); ys.Add(cy - d);
                    xs.Add(cx + d); ys.Add(cy - d);
                    xs.Add(cx + d); ys.Add(cy + d);
                    xs.Add(cx - d); ys.Add(cy + d);
                } else if (shape == "diamond") {
                    xs.Add(cx); ys.Add(cy - r);
                    xs.Add(cx + r); ys.Add(cy);
                    xs.Add(cx); ys.Add(cy + r);
                    xs.Add(cx - r); ys.Add(cy);
                } else {
                    xs.Add(cx); ys.Add(cy - r);
                    xs.Add(cx + r); ys.Add(cy + r);
                    xs.Add(cx - r); ys.Add(cy + r);
                }
                xs.Add(xs[0]); ys.Add(ys[0]);
                c.DrawPolyline(xs, ys, borderColor, borderWidth);
            } else if (shape == "emptyCircle") {
                c.DrawCircle(cx, cy, r, borderColor, borderWidth);
            } else {
                c.DrawCircle(cx, cy, r, borderColor, borderWidth);
            }
        }
    }

    // symbolSize -> 外接半径。ECharts 语义 symbolSize 是「半宽
    // （半径）参数」（config.js markPoint 注释：总宽度为
    // symbolSize * 2），传入值本身就是半径，不再折半。
    public static int SymbolRadius(int symbolSize, int defaultR) {
        if (symbolSize > 0) {
            // ECharts symbolSize 是符号直径（bump-chart 20 → 半径
            // 10）。此前当半径用，全部符号放大一倍。
            return symbolSize / 2;
        }
        return defaultR;
    }

    // 类目轴每格可用宽度 `availSize = plotW / n`，抽样至多 5 个数据点，
    // 任一点的符号尺寸 × 1.5（源码注 "Empirical number"）超过 availSize
    // 即判定"放不下全量符号"。`showAllSymbol:'auto'`（缺省）靠它决定是否
    // 按标签间隔抽稀——源码注释 "we show all symbols as possible as we
    // can"，即能放就全放；把"标签放不下 ⇒ 符号也不放"当默认是错的。
    // `symbolSizeF` = 系列符号直径（device 像素，调用方已 app.Scale）；
    // `data`/`i0`/`dpiScale` 给逐点 symbolSize 覆盖（源码
    // `getSymbolSize(data, dataIndex)`），逐点值同样折成 device 像素再比。
    // 只抽样读，不物化整表（密集线 3079 点每帧都走这条）。
    public static bool CanShowAllSymbolForCategory(int plotW, int n, int symbolSizeF,
                                           List<ChartData> data, int i0,
                                           int dpiScale) {
        if (n < 1) { return true; }
        int availSize = plotW / n;
        int step = n / 5;
        if (step < 1) { step = 1; }
        for (int i = 0; i < n; i = i + step) {
            int sz = symbolSizeF;
            int di = i0 + i;
            if (data != null && di >= 0 && di < data.Count
                && data[di].sizeSet && data[di].size > 0) {
                sz = data[di].size * dpiScale / 100;
            }
            if (sz * 3 / 2 > availSize) { return false; }
        }
        return true;
    }

    // 符号形状的顶点表（千分比相对坐标，y 向下为正），由
    // FillPoly1000 缩放到像素。star = 五角星（内接比 382），
    // star6 = 六角星（内接比 577 ≈ 1/√3），arrow = 上指箭镞，
    // droplet = 上尖水滴，heart = 心形（zrender Heart 贝塞尔
    // 采样近似：底尖在下、双瓣在上），pin/emptypin = 地图气球。
    public static void PolyVerts1000(string shape, List<int> vx, List<int> vy) {
        if (shape == "star" || shape == "star5") {
            int[] px = new int[] { 0, 225, 951, 363, 588, 0, -588, -363, -951, -225 };
            int[] py = new int[] { -1000, -309, -309, 118, 809, 382, 809, 118, -309, -309 };
            for (int i = 0; i < px.Length; i = i + 1) { vx.Add(px[i]); vy.Add(py[i]); }
        } else if (shape == "star6") {
            int[] px = new int[] { 0, 289, 866, 577, 866, 289, 0, -289, -866, -577, -866, -289 };
            int[] py = new int[] { -1000, -500, -500, 0, 500, 500, 1000, 500, 500, 0, -500, -500 };
            for (int i = 0; i < px.Length; i = i + 1) { vx.Add(px[i]); vy.Add(py[i]); }
        } else if (shape == "arrow") {
            vx.Add(0); vy.Add(-1000);
            vx.Add(1000); vy.Add(430);
            vx.Add(0); vy.Add(140);
            vx.Add(-1000); vy.Add(430);
        } else if (shape == "droplet") {
            int[] px = new int[] { 0, -400, -790, -1000, -790, -400, 0, 400, 790, 1000, 790, 400 };
            int[] py = new int[] { -1000, -500, -180, 150, 480, 730, 820, 730, 480, 150, -180, -500 };
            for (int i = 0; i < px.Length; i = i + 1) { vx.Add(px[i]); vy.Add(py[i]); }
        } else if (shape == "heart" || shape == "emptyheart") {
            // 心形：zrender Heart（a=w/2、b=0.8h、内尖锚在 0.2h 高度）
            // 两条贝塞尔的采样近似，底尖 (0,1000)、顶瓣 ±(1008,-331)。
            int[] px = new int[] { 0, 500, 914, 1008, 872, 599, 277, 0,
                -277, -599, -872, -1008, -914, -500 };
            int[] py = new int[] { 1000, 667, 151, -331, -711, -927, -910,
                -600, -910, -927, -711, -331, 151, 667 };
            for (int i = 0; i < px.Length; i = i + 1) { vx.Add(px[i]); vy.Add(py[i]); }
        } else {
            // pin / emptypin：气球头（全径圆） + 下尖尾
            int[] px = new int[] { 0, -545, -920, -575, 0, 575, 920, 545 };
            int[] py = new int[] { 1000, 120, -300, -830, -960, -830, -300, 120 };
            for (int i = 0; i < px.Length; i = i + 1) { vx.Add(px[i]); vy.Add(py[i]); }
        }
    }

    static List<int> polyStarVx; static List<int> polyStarVy;
    static List<int> polyStar6Vx; static List<int> polyStar6Vy;
    static List<int> polyArrowVx; static List<int> polyArrowVy;
    static List<int> polyDropletVx; static List<int> polyDropletVy;
    static List<int> polyPinVx; static List<int> polyPinVy;
    static List<int> polyHeartVx; static List<int> polyHeartVy;
    static List<int> symbolXs;
    static List<int> scratchBorderXs;
    static List<int> scratchBorderYs;

    public static void EnsurePolyCache() {
        if (Chart.polyStarVx != null) { return; }
        Chart.polyStarVx = new List<int>(); Chart.polyStarVy = new List<int>();
        Chart.PolyVerts1000("star", Chart.polyStarVx, Chart.polyStarVy);
        Chart.polyStar6Vx = new List<int>(); Chart.polyStar6Vy = new List<int>();
        Chart.PolyVerts1000("star6", Chart.polyStar6Vx, Chart.polyStar6Vy);
        Chart.polyArrowVx = new List<int>(); Chart.polyArrowVy = new List<int>();
        Chart.PolyVerts1000("arrow", Chart.polyArrowVx, Chart.polyArrowVy);
        Chart.polyDropletVx = new List<int>(); Chart.polyDropletVy = new List<int>();
        Chart.PolyVerts1000("droplet", Chart.polyDropletVx, Chart.polyDropletVy);
        Chart.polyPinVx = new List<int>(); Chart.polyPinVy = new List<int>();
        Chart.PolyVerts1000("pin", Chart.polyPinVx, Chart.polyPinVy);
        Chart.polyHeartVx = new List<int>(); Chart.polyHeartVy = new List<int>();
        Chart.PolyVerts1000("heart", Chart.polyHeartVx, Chart.polyHeartVy);
    }

    public static bool GetPolyVertsCached(string shape, out List<int> vx, out List<int> vy) {
        Chart.EnsurePolyCache();
        if (shape == "star" || shape == "star5") { vx = Chart.polyStarVx; vy = Chart.polyStarVy; return true; }
        if (shape == "star6") { vx = Chart.polyStar6Vx; vy = Chart.polyStar6Vy; return true; }
        if (shape == "arrow") { vx = Chart.polyArrowVx; vy = Chart.polyArrowVy; return true; }
        if (shape == "droplet") { vx = Chart.polyDropletVx; vy = Chart.polyDropletVy; return true; }
        if (shape == "pin" || shape == "emptypin") { vx = Chart.polyPinVx; vy = Chart.polyPinVy; return true; }
        if (shape == "heart" || shape == "emptyheart") { vx = Chart.polyHeartVx; vy = Chart.polyHeartVy; return true; }
        vx = null; vy = null;
        return false;
    }

    // 顶点多边形屏幕行扫描线填充（偶奇规则）：直接遍历屏幕像素行（sy），
    // 杜绝千分比全空间 2000 行扫描与重复覆盖，零堆分配，帧率与吞吐提升超百倍。
    public static void FillPoly1000(Canvas c, int cx, int cy, int r,
                             List<int> vx, List<int> vy, int color) {
        int vn = vx.Count;
        if (vn < 3 || r < 1) { return; }
        int ymin = vy[0];
        int ymax = vy[0];
        for (int i = 1; i < vn; i = i + 1) {
            if (vy[i] < ymin) { ymin = vy[i]; }
            if (vy[i] > ymax) { ymax = vy[i]; }
        }
        int s_ymin = cy + ymin * r / 1000;
        int s_ymax = cy + ymax * r / 1000;
        if (Chart.symbolXs == null) { Chart.symbolXs = new List<int>(); }
        List<int> xs = Chart.symbolXs;
        for (int sy = s_ymin; sy <= s_ymax; sy = sy + 1) {
            int py = (sy - cy) * 1000 / r;
            xs.Clear();
            for (int i = 0; i < vn; i = i + 1) {
                int j = i + 1 == vn ? 0 : i + 1;
                int y1 = vy[i];
                int y2 = vy[j];
                if ((y1 <= py && y2 > py) || (y2 <= py && y1 > py)) {
                    xs.Add(vx[i] + (py - y1) * (vx[j] - vx[i]) / (y2 - y1));
                }
            }
            for (int a = 1; a < xs.Count; a = a + 1) {
                int key = xs[a];
                int b = a - 1;
                while (b >= 0 && xs[b] > key) { xs[b + 1] = xs[b]; b = b - 1; }
                xs[b + 1] = key;
            }
            for (int p = 0; p + 1 < xs.Count; p = p + 2) {
                int x0 = cx + xs[p] * r / 1000;
                int x1 = cx + xs[p + 1] * r / 1000;
                c.FillRect(x0, sy, x1 - x0 + 1, 1, color);
            }
        }
    }

    // axisLabel.interval 语义（ECharts）：-1/非整数 = 自动（渲染器
    // 走防重叠贪心），>=0 = 每 (interval+1) 个画一个。纯函数，
    // conformance 直接断言。
    public static bool LabelShown(int ci, int interval) {
        if (interval < 0) { return true; }
        return ci % (interval + 1) == 0;
    }

    // 类目轴 auto 抽稀的共用判定：返回窗口内实际显示标签的类目
    // 下标（升序）。ECharts 中 axisLabel.interval 缺省 'auto'，
    // splitLine 与折线拐点符号（isMainIdx）与标签同源——密集类目
    // 轴的竖网格和符号都只落在显示标签的刻度上，不再逐类目一条
    // （雨量图 3079 点曾把竖线糊成整幅灰罩、折线满线小圆点）。
    // 规则与 BuildAxesR 标签绘制一致：显式 interval 走 LabelShown、
    // 旋转标签不抽稀、刻度模式（boundaryGap=false）首标签豁免
    // （ECharts 始终画边界刻度），其余贪心让位。
    public static List<int> CategoryTicks(ChartFrame f, List<string> labels, int fs,
                                    int plotX, int labelGap, ChartAxis x0) {
        List<int> shown = new List<int>();
        int n = labels.Count;
        if (f == null || n < 1) { return shown; }
        bool tickX = !f.catBoundaryGap && n > 1;
        int labelRight = plotX - labelGap;
        // 预抽稀步长（与 DrawFrameLoHiT 同一病灶）：candlestick-
        // large 成交量面板 2.2 万条类目，逐条 Replace+MeasureText
        // ≈ 0.7s/帧。自动间隔且不旋转时按估宽 24px 跳步，只对候
        // 选量宽；显式 interval / 旋转标签保留原语义。
        int stride = 1;
        if (n > 1 && x0.labelRotate == 0 && x0.labelInterval < 0) {
            stride = (n * Canvas.FontHeight(fs) + f.plotW - 1) / f.plotW;
            if (stride < 1) { stride = 1; }
        }
        for (int ci = 0; ci < n; ci = ci + stride) {
            string lab = labels[ci];
            if (x0.labelFormatter.Length > 0) {
                lab = x0.labelFormatter.Replace("{value}", lab);
            }
            // 富文本轴标签量宽用剥壳文本（图标宽不进文本测量——
            // 图标段是 backgroundColor image，本引擎退化留白）。
            if (x0.labelSt != null && x0.labelSt.rich != null) {
                lab = Chart.RichStrip(lab);
            }
            int labelW = Canvas.MeasureText(lab, fs);
            int cxs = f.CatLeft(ci, n);
            int cellW = f.CatWidth(ci, n);
            int labelLeft = tickX ? cxs - labelW / 2
                : cxs + (cellW - labelW) / 2;
            if (!tickX && labelLeft < cxs) { labelLeft = cxs; }
            bool show;
            if (x0.labelInterval >= 0) {
                show = Chart.LabelShown(ci, x0.labelInterval);
            } else if (x0.labelRotate != 0) {
                show = true;
            } else {
                show = (tickX && ci == 0)
                    || labelLeft >= labelRight + labelGap;
            }
            if (show) {
                shown.Add(ci);
                labelRight = labelLeft + labelW;
            }
        }
        return shown;
    }

    // 旋转分类标签的竖直占位（像素）：行盒 w×h 绕锚点旋转
    // |deg| 度后的垂直跨度 = w·|sin| + h·|cos|。用 ChartView 的
    // 1000 倍三角表，确定性整数。
    public static int RotatedLabelH(int maxW, int fh, int deg) {
        int a = deg < 0 ? 0 - deg : deg;
        if (a > 90) { a = 90; }
        int s = ChartView.SinDeg(a);
        int co = a >= 90 ? 0 : ChartView.CosDeg(a);
        return (maxW * s + fh * co) / 1000 + 2;
    }

    // 数值 → 水平像素：plotX 对应 lo，plotX+plotW 对应 hi。
    // 大数值 × plotW 会超 int32（bar3 Population 到百万：
    // 1000000×2601≈2.6e9），乘法走 long。
    public static int ValueX(int plotX, int plotW, int lo, int hi, int v) {
        long span = (long)hi - (long)lo;
        if (span < 1) { span = 1; }
        return plotX + (int)(((long)v - (long)lo) * (long)plotW / span);
    }

    // 定点数值 → 水平像素：v 以 值×g 承载（PointV 约定），分母按
    // span×g 缩放后再除——亚单位像素精度不丢（先 PointV 取整会把
    // 小数坐标量化到整数值格点，scatter3 的 3 位小数云会塌成点阵）。
    public static int ValueXF(int plotX, int plotW, int lo, int hi, int v, int g) {
        if (g <= 1) { return Chart.ValueX(plotX, plotW, lo, hi, v); }
        long span = ((long)hi - (long)lo) * (long)g;
        if (span < 1) { span = 1; }
        return plotX + (int)(((long)v - (long)lo * (long)g) * (long)plotW / span);
    }

    // A15：axisLine.breakLine（缺省 true）——轴挂断带时轴线只画
    // 断带之外的段（AxisBuilder.ts:716 → axisBreakHelperImpl.ts
    // buildAxisBreakLine addSeg）。bands 为 BrkPixelBands 的升序
    // 区间对 [s0,e0,s1,e1,...]，长度 len 沿 vertical?y:x。
    public static void DrawAxisLineBands(Canvas c, int x, int y, int len, bool vertical,
        int thick, int col, List<int> bands) {
        int pos = 0;
        for (int i = 0; i + 1 < bands.Count; i = i + 2) {
            int s = bands[i];
            int e = bands[i + 1];
            if (s > len) { s = len; }
            if (e > len) { e = len; }
            if (s > pos) {
                if (vertical) { c.FillRect(x, y + pos, thick, s - pos, col); }
                else { c.FillRect(x + pos, y, s - pos, thick, col); }
            }
            if (e > pos) { pos = e; }
        }
        if (pos < len) {
            if (vertical) { c.FillRect(x, y + pos, thick, len - pos, col); }
            else { c.FillRect(x + pos, y, len - pos, thick, col); }
        }
    }

    // A15：锯齿点列（addZigzagShapes 源对抄）。沿 sweep 轴扫过整个
    // 绘图区，端点不偏移（与轴刻度精确相接）、内部点 band ±amp 交替
    // （isSwap 起步 true：两线同向偏移保持平行），步长取
    // minSpan..maxSpan（缺省 4..20）伪随机权重。官方用 Math.random；
    // 这里换黄金比/白银比递推保证逐帧确定（像素回归可复现）。
    // horizontal=true：带在 x（竖直锯齿线，扫 y），否则带在 y。
    public static void BrkZigzag(int seed, int amp, int plotPos, int plotLen,
        int bandLo, int bandHi, bool horizontal,
        List<int> xsA, List<int> ysA, List<int> xsB, List<int> ysB) {
        double minSpan = 4.0;
        double maxSpan = 20.0;
        int sweepEnd = plotPos + plotLen;
        int cur = plotPos;
        bool isSwap = true;
        int idx = 0;
        while (true) {
            bool isLast = cur >= sweepEnd;
            if (isLast) { cur = sweepEnd; }
            int off = 0;
            if (idx > 0 && !isLast) { off = isSwap ? 0 - amp : amp; }
            if (horizontal) {
                xsA.Add(bandLo + off); ysA.Add(cur);
                xsB.Add(bandHi + off); ysB.Add(cur);
            } else {
                xsA.Add(cur); ysA.Add(bandLo + off);
                xsB.Add(cur); ysB.Add(bandHi + off);
            }
            if (isLast) { break; }
            double r = (idx + 1) * 0.6180339887498949 + seed * 0.7548776662466927 + 0.2113;
            r = r - Math.Floor(r);
            int nextStep = (int)(r * (maxSpan - minSpan) + minSpan);
            if (sweepEnd - (cur + nextStep) < (int)minSpan) {
                cur = sweepEnd;
            } else {
                cur = cur + nextStep;
            }
            isSwap = !isSwap;
            idx = idx + 1;
        }
    }

    // A15：breakArea 锯齿边框 dashed [3,3]（borderType 缺省）的近似：
    // 折线笔划不可分段，逐段按切比雪夫长度参数走 3px 通/3px 断，
    // 通段用 DrawLine。每条锯齿约 25 段，成本可忽略。
    public static void BrkDashPolyline(Canvas c, List<int> xs, List<int> ys, int col) {
        for (int i = 1; i < xs.Count; i = i + 1) {
            int dx = xs[i] - xs[i - 1];
            int dy = ys[i] - ys[i - 1];
            int adx = dx > 0 ? dx : 0 - dx;
            int ady = dy > 0 ? dy : 0 - dy;
            int ln = adx > ady ? adx : ady;
            if (ln < 1) { continue; }
            int nseg = (int)Math.Ceiling(ln / 3.0);
            if (nseg < 1) { nseg = 1; }
            for (int s = 0; s < nseg; s = s + 1) {
                if (s % 2 == 1) { continue; }
                double t0 = (double)s / nseg;
                double t1 = (double)(s + 1) / nseg;
                if (t1 > 1.0) { t1 = 1.0; }
                c.DrawLine(xs[i - 1] + (int)(dx * t0 + 0.5),
                    ys[i - 1] + (int)(dy * t0 + 0.5),
                    xs[i - 1] + (int)(dx * t1 + 0.5),
                    ys[i - 1] + (int)(dy * t1 + 0.5), col, 1);
            }
        }
    }

    // A15：breakArea 锯齿带（axisBreakHelperImpl.ts rectCoordBuildBreakAxis
    // → addZigzagShapes 源对抄）。每条断带画两条平行锯齿折线跨满绘图区
    // （边框色/宽、dashed 缺省），gapReal≠0 时再加两线之间的多边形填充
    // （itemStyle color + opacity，缺省 #fff/0.6）。gap=0 只画单线
    // （官方注释：dash/半透明在零宽带上不连续）。官方 z=zigzagZ(100)
    // 在系列之上——调用点在系列绘制之后。
    public static void DrawBreakAreas(Canvas c, ChartFrame f, ChartAxis ax, int kind) {
        if (ax == null || !ax.breakShow) { return; }
        List<ChartBreak> brks = f.brkL;
        List<double> grs = f.brkGapL;
        if (kind == 1) { brks = f.brkR; grs = f.brkGapR; }
        if (kind == 2) { brks = f.brkX; grs = f.brkGapX; }
        if (brks == null || brks.Count == 0 || grs == null || grs.Count < brks.Count) { return; }
        int amp = ax.breakAmp > 0 ? ax.breakAmp : 4;
        int bcol = ax.breakBorderColor != 0 ? ax.breakBorderColor : ChartColor.Rgb(183, 185, 190);
        int fcol = ax.breakFillColor != 0 ? ax.breakFillColor : ChartColor.Rgb(255, 255, 255);
        int opa = ax.breakOpacityX10 >= 0 ? ax.breakOpacityX10 * 255 / 10 : 153;
        List<int> xsA = new List<int>();
        List<int> ysA = new List<int>();
        List<int> xsB = new List<int>();
        List<int> ysB = new List<int>();
        for (int bi = 0; bi < brks.Count; bi = bi + 1) {
            ChartBreak b = brks[bi];
            xsA.Clear();
            ysA.Clear();
            xsB.Clear();
            ysB.Clear();
            if (kind == 2) {
                int xa = f.XOfBrk(b.startD);
                int xb = f.XOfBrk(b.endD);
                if (xa > xb) { int t = xa; xa = xb; xb = t; }
                Chart.BrkZigzag(bi, amp, f.plotY, f.plotH, xa, xb, true,
                    xsA, ysA, xsB, ysB);
            } else {
                int ya = f.YOfBrk(b.startD, kind);
                int yb = f.YOfBrk(b.endD, kind);
                if (ya > yb) { int t = ya; ya = yb; yb = t; }
                Chart.BrkZigzag(bi, amp, f.plotX, f.plotW, ya, yb, false,
                    xsA, ysA, xsB, ysB);
            }
            Chart.BrkDashPolyline(c, xsA, ysA, bcol);
            if (grs[bi] != 0.0) {
                Chart.BrkDashPolyline(c, xsB, ysB, bcol);
                List<ChartMapPoint> poly = new List<ChartMapPoint>();
                for (int i = 0; i < xsA.Count; i = i + 1) { poly.Add(ChartMapPoint.Of(xsA[i], ysA[i])); }
                for (int i = xsB.Count - 1; i >= 0; i = i - 1) { poly.Add(ChartMapPoint.Of(xsB[i], ysB[i])); }
                ChartView.FillPolygon(c, poly, ChartColor.WithAlpha(fcol, opa));
            }
        }
    }

    public static int ValueYF(int plotY, int plotH, int lo, int hi, int v, int g) {
        if (g <= 1) { return Chart.ValueY(plotY, plotH, lo, hi, v); }
        long span = ((long)hi - (long)lo) * (long)g;
        if (span < 1) { span = 1; }
        return plotY + plotH - (int)(((long)v - (long)lo * (long)g) * (long)plotH / span);
    }

    // 数值 → 垂直像素：plotY+plotH 对应 lo，plotY 对应 hi（向上增大）。
    // 同 ValueX：乘法走 long 防大数值 × plotH 溢出。
    public static int ValueY(int plotY, int plotH, int lo, int hi, int v) {
        long span = (long)hi - (long)lo;
        if (span < 1) { span = 1; }
        return plotY + plotH - (int)(((long)v - (long)lo) * (long)plotH / span);
    }

    // 1/1000 定点值 → 垂直像素：lo/hi（值×1000）之间的线性映射，
    // 小数轴（leftMinF 定点域）的 YOfF 用——与 ValueY 同构，
    // 分子分母同放大 1000 后 long 相除，亚单位值不再量化。
    public static int ValueYF1000(int plotY, int plotH, int loF, int hiF, int vF) {
        long span = (long)hiF - (long)loF;
        if (span < 1) { span = 1; }
        return plotY + plotH
            - (int)(((long)vF - (long)loF) * (long)plotH / span);
    }

    // ECharts axisLine.show 三态判定（cartesianAxisHelper.ts:169-181
    // axisLineAutoShow）：显式 true/false 照办；未声明（-1）按 'auto'
    // ——只有当**同网格**对侧轴是 value/log（isIntervalOrLogScale）
    // 时才画，与本轴自身类型无关。time 轴也走 'auto'（实测
    // x时间/y时间 一条线都不画）。
    public static bool AxisLineDraws(int axisLineShow, bool otherIsValueOrLog) {
        if (axisLineShow > 0) { return true; }
        if (axisLineShow == 0) { return false; }
        return otherIsValueOrLog;
    }

    // 0 相对数值域 [lo,hi] 的位置：2 = 严格在内，1 = 恰是端点
    // （EDGE——官方允许骑线），0 = 在域外（禁止骑线）。
    // scale/helper.ts getScaleValuePositionKind 的语义。
    public static int ZeroKindOf(int lo, int hi) {
        if (lo > 0 || hi < 0) { return 0; }
        if (lo == 0 || hi == 0) { return 1; }
        return 2;
    }

    // ECharts Grid.canOnZeroToAxis（Grid.ts:677-717）：目标轴是
    // value/log（category/time 的 0 无数值意义）、0 不在目标域外
    // （EDGE 允许）、骑线轴的 axisLine.onZero 非 false（-1 未声明
    // 按 'auto'，与 true 等价——discourageOnAxisZero 只在
    // containShape 真的扩过量程时置位，本引擎不产生）。
    public static bool CanOnZeroTo(ChartAxis target, int targetLo, int targetHi,
                            int riderOnZero) {
        if (riderOnZero == 0) { return false; }
        if (target.type != ChartAxisType.Value
            && target.type != ChartAxisType.Log) { return false; }
        return Chart.ZeroKindOf(targetLo, targetHi) > 0;
    }

    // 轴刻度标签绘制：轴声明了 axisLabel.rich 且文本带壳时走富文本
    // 块（RichLayout+RichDraw，锚 = 块左上，调用方按原纯文本左缘
    // 定位），否则原样 DrawText。旋转路径不在此（块不能整体旋转，
    // 调用方先 RichStrip 后走 DrawTextRot）。
    public static void DrawAxisLabel(App app, Canvas c, ChartAxis a, string lab,
                              int bx, int by, int defCol, int fs) {
        int col = a != null && a.labelColor != 0 ? a.labelColor : defCol;
        if (a.labelSt != null && a.labelSt.rich != null
            && lab.IndexOf("{") >= 0) {
            RichBlock blk = ChartView.RichLayout(app,
                Chart.RichTokenize(lab, a.labelSt), a.labelSt, fs);
            ChartView.RichDraw(app, c, bx, by, blk, col);
            return;
        }
        c.DrawText(bx, by, lab, col, fs);
    }

    // DrawTextCentered 语义的富文本版：矩形内水平+垂直居中；富文本
    // 块按矩形居中（几何与 plain 路径逐像素同位——带状类目标签
    // 此前走 DrawTextCentered，不能因换路漂移 2px）。
    public static void DrawAxisLabelCentered(App app, Canvas c, ChartAxis a, string lab,
                                      int rx, int ry, int rw, int rh,
                                      int defCol, int fs) {
        int col = a != null && a.labelColor != 0 ? a.labelColor : defCol;
        if (a.labelSt != null && a.labelSt.rich != null
            && lab.IndexOf("{") >= 0) {
            RichBlock blk = ChartView.RichLayout(app,
                Chart.RichTokenize(lab, a.labelSt), a.labelSt, fs);
            int bx = rx + (rw - blk.w) / 2;
            int by = ry + (rh - blk.h) / 2;
            if (bx < rx) { bx = rx; }
            if (by < ry) { by = ry; }
            ChartView.RichDraw(app, c, bx, by, blk, col);
            return;
        }
        c.DrawTextCentered(rx, ry, rw, rh, lab, col, fs);
    }

    // ---- 几何 ----

    // 整数 point-in-polygon（射线法，even-odd），无除法/浮点。
    // 半开约定：py >= 顶点 y 视为在射线之上，每条边最多计一次
    // 穿越；交点侧由叉积符号结合边方向判定。点在边界上属边缘
    // 情形，结果不保证——由命中层的 bbox 容差吸收。
    public static bool PointInPoly(List<ChartMapPoint> poly, int px, int py) {
        int n = poly.Count;
        if (n < 3) { return false; }
        bool inside = false;
        int j = n - 1;
        for (int i = 0; i < n; i = i + 1) {
            ChartMapPoint pi = poly[i];
            ChartMapPoint pj = poly[j];
            long dx = (long)pi.x - (long)pj.x;
            long dy = (long)pi.y - (long)pj.y;
            long qx = (long)px - (long)pj.x;
            long qy = (long)py - (long)pj.y;
            long cross = dx * qy - dy * qx;
            if (cross == 0 && px >= (pi.x < pj.x ? pi.x : pj.x)
                && px <= (pi.x > pj.x ? pi.x : pj.x)
                && py >= (pi.y < pj.y ? pi.y : pj.y)
                && py <= (pi.y > pj.y ? pi.y : pj.y)) {
                return true;
            }
            if ((py >= pi.y) != (py >= pj.y)) {
                if ((cross > 0) == (pi.y > pj.y)) { inside = !inside; }
            }
            j = i;
        }
        return inside;
    }

    // 将缩放窗口（千分值）解析为包含端点的分类索引范围 [i0,i1]。
    // 首次调用时从 ChartOption.zoomStart/zoomEnd 初始化状态。
    public static int ZoomI0(App app, ChartOption o, int wid, int n) {
        int lo = app.StateGet(Chart.ZoomLoKey(wid), 0 - 1);
        if (lo < 0) {
            lo = o.zoomStart * 10;
            // startValue 按类目名定位窗口起点（line-aqi 的
            // "2014-06-01"）；未声明或找不到类目回落百分比域。
            if (o.zoomStartValue != null && o.zoomStartValue.Length > 0 && n > 1) {
                int zi = Chart.CategoryIndexOf(o.XCategories(),
                    o.zoomStartValue);
                if (zi >= 0) { lo = zi * 1000 / (n - 1); }
            }
            app.StateSet(Chart.ZoomLoKey(wid), lo);
        }
        int i0 = lo * (n - 1) / 1000;
        if (i0 < 0) { i0 = 0; }
        if (i0 > n - 1) { i0 = n - 1; }
        return i0;
    }
    // 窗口末端索引（与 ZoomI0 成对）。
    public static int ZoomI1(App app, ChartOption o, int wid, int n) {
        int hi = app.StateGet(Chart.ZoomHiKey(wid), 0 - 1);
        if (hi < 0) {
            hi = o.zoomEnd * 10;
            if (o.zoomEndValue != null && o.zoomEndValue.Length > 0 && n > 1) {
                int zi = Chart.CategoryIndexOf(o.XCategories(),
                    o.zoomEndValue);
                if (zi >= 0) { hi = zi * 1000 / (n - 1); }
            }
            app.StateSet(Chart.ZoomHiKey(wid), hi);
        }
        int i1 = hi * (n - 1) / 1000;
        if (i1 < 0) { i1 = 0; }
        if (i1 > n - 1) { i1 = n - 1; }
        return i1;
    }

    // 将标签窗口化为包含端点的索引范围 [i0,i1]（全量范围时直接返回原列表，
    // 消除单帧堆分配；开窗时截取切片）。
    public static List<string> WindowLabels(List<string> labels, int i0, int i1) {
        if (labels == null || labels.Count == 0) { return new List<string>(); }
        if (i0 <= 0 && i1 >= labels.Count - 1) { return labels; }
        List<string> outp = new List<string>();
        int i = i0 < 0 ? 0 : i0;
        while (i <= i1 && i < labels.Count) { outp.Add(labels[i]); i = i + 1; }
        return outp;
    }

    // 类目名精确匹配的首个下标；未命中 -1（dataZoom
    // startValue/endValue 的类目定位用）。
    public static int CategoryIndexOf(List<string> cats, string name) {
        for (int i = 0; i < cats.Count; i = i + 1) {
            if (cats[i] == name) { return i; }
        }
        return 0 - 1;
    }

    // N2：dataZoom slider 官方契约（SliderZoomView.ts 源对抄）。
    // 条几何：height 缺省 30（DEFAULT_FILLER_SIZE）；锚 bottom 缺省
    // defaultLocationEdgeGap 15 + moveHandle 7（条占 [H-52, H-22]，
    // moveHandle 挂条底 [H-22, H-15]）；声明 height/bottom/top
    // （px|'N%'）覆盖；宽 = 绘图区宽（官方 width:'ph' 对齐
    // coordRect），声明 left/right/width 覆盖。层序（官方 z2 序）：
    // dataBackground 阴影（全条宽，代表系列值域 ±30% 外扩折算条高，

    // 点坐标定点值除回真实值（points 存 值×pointG，g<=1 原值跳过）：
    // 四舍五入、负值对称。散点/值对折线的渲染映射、量程、命中与
    // tooltip 统一走这里（ECharts 小数坐标在 int 管线的承载约定，
    // 与折线 value 的 g/1000 同构）。
    public static int PointV(int v, int g) {
        if (g <= 1) { return v; }
        if (v >= 0) { return (v + g / 2) / g; }
        return 0 - ((0 - v + g / 2) / g);
    }

    // 点坐标定点值的提示文本：g<=1 直接整数；g>1 按 g 的十进制
    // 位数输出定点小数（1000 → 3 位，-1500/1000 → "-1.5"），
    // tooltip/状态栏展示与 PointV 的除回约定配套。
    public static string PointText(int v, int g) {
        if (g <= 1) { return Convert.ToString(v); }
        bool neg = v < 0;
        int av = neg ? 0 - v : v;
        int ip = av / g;
        int fr = av - ip * g;
        int dg = g;
        int dc = 0;
        while (dg > 1) { dg = dg / 10; dc = dc + 1; }
        string fs = Convert.ToString(fr);
        while (fs.Length < dc) { fs = "0" + fs; }
        return (neg ? "-" : "") + Convert.ToString(ip) + "." + fs;
    }

}
