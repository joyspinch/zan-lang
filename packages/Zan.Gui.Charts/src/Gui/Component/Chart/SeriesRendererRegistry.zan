}

public class SeriesRendererRegistry {
    static List<ISeriesRenderer> renderers;

    public static void InitDefaults() {
        if (SeriesRendererRegistry.renderers != null) { return; }
        List<ISeriesRenderer> list = new List<ISeriesRenderer>();
        list.Add(new PieSeriesRenderer());
        list.Add(new CalendarSeriesRenderer());
        list.Add(new MatrixSeriesRenderer());
        list.Add(new PolarSeriesRenderer());
        list.Add(new HeatmapSeriesRenderer());
        list.Add(new HierarchicalSeriesRenderer());
        list.Add(new FinanceSeriesRenderer());
        list.Add(new RelationSeriesRenderer());
        list.Add(new MapSeriesRenderer());
        list.Add(new EventRiverSeriesRenderer());
        list.Add(new PolarBarSeriesRenderer());
        list.Add(new PictorialSeriesRenderer());
        list.Add(new MoreSeriesRenderer());
        list.Add(new BarSeriesRenderer());
        list.Add(new ScatterSeriesRenderer());
        list.Add(new LineSeriesRenderer());
        SeriesRendererRegistry.renderers = list;
    }

    public static void Register(ISeriesRenderer renderer) {
        SeriesRendererRegistry.InitDefaults();
        if (renderer != null) {
            SeriesRendererRegistry.renderers.Insert(0, renderer);
        }
    }

    public static ISeriesRenderer Find(string kind) {
        SeriesRendererRegistry.InitDefaults();
        for (int i = 0; i < SeriesRendererRegistry.renderers.Count; i = i + 1) {
            ISeriesRenderer r = SeriesRendererRegistry.renderers[i];
            if (r.CanRender(kind)) {
                return r;
            }
        }
        return null;
    }
}
