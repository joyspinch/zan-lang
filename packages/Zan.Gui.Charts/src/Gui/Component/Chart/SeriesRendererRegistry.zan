public class MoreSeriesRenderer : ISeriesRenderer {
    public bool CanRender(string kind) {
        return kind == "parallel" || kind == "themeRiver"
            || kind == "linesCustom" || kind == "graphic";
    }
    public void Render(App app, int x, int y, int w, int h, ChartOption option, int g) {
        string kind = ChartView.DispatchKind(option);
        if (kind == "parallel") {
            ChartView.DrawParallel(app, x, y, w, h, option, g);
        } else if (kind == "themeRiver") {
            ChartView.DrawThemeRiver(app, x, y, w, h, option, g);
        } else if (kind == "linesCustom") {
            ChartView.DrawLinesCustom(app, x, y, w, h, option, g);
        } else if (kind == "graphic") {
            ChartView.DrawGraphic(app, x, y, w, h, option, g);
        }
    }
}

public class BarSeriesRenderer : ISeriesRenderer {
    public bool CanRender(string kind) {
        return kind == "bar" || kind == "hbar"
            || kind == "barStacked" || kind == "barStackedHbar";
    }
    public void Render(App app, int x, int y, int w, int h, ChartOption option, int g) {
        string kind = ChartView.DispatchKind(option);
        bool stacked = kind == "barStacked" || kind == "barStackedHbar";
        bool hbar = kind == "hbar" || kind == "barStackedHbar";
        ChartView.DrawBars(app, x, y, w, h, option, g, stacked, hbar);
    }
}

