using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Component.Chart;

public class PieSeriesRenderer : ISeriesRenderer {
    public bool CanRender(string kind) {
        return kind == "pie" || kind == "rose";
    }
    public void Render(App app, int x, int y, int w, int h, ChartOption option, int g) {
        ChartView.DrawPie(app, x, y, w, h, option, option.pieLabels, g);
    }
}

public class CalendarSeriesRenderer : ISeriesRenderer {
    public bool CanRender(string kind) {
        return kind == "calendar";
    }
    public void Render(App app, int x, int y, int w, int h, ChartOption option, int g) {
        ChartView.DrawCalendar(app, x, y, w, h, option, g);
    }
}

public class MatrixSeriesRenderer : ISeriesRenderer {
    public bool CanRender(string kind) {
        return kind == "matrix";
    }
    public void Render(App app, int x, int y, int w, int h, ChartOption option, int g) {
        ChartView.DrawMatrix(app, x, y, w, h, option, g);
        if (!option.overlay) {
            ChartView.MatrixHover(app, x, y, w, h, option);
        }
    }
}

public class PolarSeriesRenderer : ISeriesRenderer {
    public bool CanRender(string kind) {
        return kind == "polarCoord" || kind == "gauge" || kind == "radar";
    }
    public void Render(App app, int x, int y, int w, int h, ChartOption option, int g) {
        string kind = ChartView.DispatchKind(option);
        if (kind == "polarCoord") {
            ChartView.DrawPolarCoord(app, x, y, w, h, option, g);
        } else if (kind == "gauge") {
            ChartView.DrawGauge(app, x, y, w, h, option, g);
        } else if (kind == "radar") {
            ChartView.DrawPolar(app, x, y, w, h, option, g);
        }
    }
}

public class HeatmapSeriesRenderer : ISeriesRenderer {
    public bool CanRender(string kind) {
        return kind == "heatmap";
    }
    public void Render(App app, int x, int y, int w, int h, ChartOption option, int g) {
        ChartView.DrawHeatmap(app, x, y, w, h, option, g);
    }
}

public class HierarchicalSeriesRenderer : ISeriesRenderer {
    public bool CanRender(string kind) {
        return kind == "wordCloud" || kind == "funnel" || kind == "treemap"
            || kind == "tree" || kind == "sankey" || kind == "sunburst";
    }
    public void Render(App app, int x, int y, int w, int h, ChartOption option, int g) {
        string kind = ChartView.DispatchKind(option);
        if (kind == "wordCloud") {
            ChartView.DrawWordCloud(app, x, y, w, h, option, g);
        } else if (kind == "funnel") {
            ChartSeries leadS = ChartView.LeadSeries(option);
            bool pyramid = false;
            if (leadS != null && leadS.sort == "ascending") { pyramid = true; }
            ChartView.DrawFunnel(app, x, y, w, h, option, g, pyramid);
        } else if (kind == "treemap") {
            ChartView.DrawTreemap(app, x, y, w, h, option, g);
        } else if (kind == "tree") {
            ChartView.DrawTree(app, x, y, w, h, option, g);
        } else if (kind == "sankey") {
            ChartView.DrawSankey(app, x, y, w, h, option, g);
        } else if (kind == "sunburst") {
            ChartView.DrawSunburst(app, x, y, w, h, option, g);
        }
    }
}

public class FinanceSeriesRenderer : ISeriesRenderer {
    public bool CanRender(string kind) {
        return kind == "k" || kind == "box" || kind == "error" || kind == "waterfall";
    }
    public void Render(App app, int x, int y, int w, int h, ChartOption option, int g) {
        string kind = ChartView.DispatchKind(option);
        if (kind == "k") {
            ChartView.DrawCandles(app, x, y, w, h, option, g);
        } else if (kind == "box") {
            ChartView.DrawBox(app, x, y, w, h, option, g);
        } else if (kind == "error") {
            ChartView.DrawError(app, x, y, w, h, option, g);
        } else if (kind == "waterfall") {
            ChartView.DrawWaterfall(app, x, y, w, h, option, g);
        }
    }
}

