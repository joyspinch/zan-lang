using System;
using Gui;

namespace Gui.Component.Chart;

/// 图表皮肤（ChartSkin）：图表配色的独立板块，与全局皮肤主题
/// （Theme）解耦——一套皮肤就是一份命名的定性调色板：default 取
/// ECharts 6.1 默认主题色板（src/visual/tokens.ts color.theme 9 档），
/// infographic/shine/macarons2 取官方主题包各前 8 档。Chart.Palette
/// 在主题 chart token 未定义时回落到当前皮肤，换肤一次即生效于
/// 全部图型（折/柱/饼/漏斗……）。未知名一律按 default 处理。
static class ChartSkin {
    /// 当前全局图表皮肤名。null = "default"。
    static string current;

    /// 当前皮肤名（规范化：null / 未知名都归 default）。
    static string Current() {
        if (ChartSkin.current == null) { return ChartSkin.Name(0); }
        if (ChartSkin.IndexOf(ChartSkin.current) >= 0) { return ChartSkin.current; }
        return ChartSkin.Name(0);
    }

    /// 切换当前图表皮肤；未知名回退 default。
    static void SetCurrent(string name) {
        if (ChartSkin.IndexOf(name) >= 0) {
            ChartSkin.current = name;
            return;
        }
        ChartSkin.current = null;
    }

    /// 内置皮肤数量；选择器按 Name(i)/Label(i) 枚举。
    static int Count() { return 4; }

    /// 第 i 套内置皮肤名。
    static string Name(int i) {
        if (i == 1) { return "infographic"; }
        if (i == 2) { return "shine"; }
        if (i == 3) { return "macarons2"; }
        return "default";
    }

    /// 第 i 套皮肤的显示名。
    static string Label(int i, bool en) {
        if (i == 1) { return en ? "Info" : "信息图"; }
        if (i == 2) { return en ? "Shine" : "绚丽"; }
        if (i == 3) { return en ? "Macaron" : "马卡龙"; }
        return en ? "Default" : "默认";
    }

    /// 皮肤名转下标；未知名 -1。
    static int IndexOf(string name) {
        for (int i = 0; i < ChartSkin.Count(); i = i + 1) {
            if (name == ChartSkin.Name(i)) { return i; }
        }
        return 0 - 1;
    }

    /// 皮肤第 i 档定性色（ARGB，i 自动取模 8 循环）。8 档齐全；
    /// 返回 0 仅当皮肤名未知，由调用方走自己的默认兜底。
    static int ColorAt(string name, int i) {
        int m = i % 8;
        if (name == "infographic") {
            if (m == 0) { return (int)0xFFC1232B; }   // #C1232B
            if (m == 1) { return (int)0xFFB5C334; }   // #B5C334
            if (m == 2) { return (int)0xFFFCCE10; }   // #FCCE10
            if (m == 3) { return (int)0xFFE87C25; }   // #E87C25
            if (m == 4) { return (int)0xFF27727B; }   // #27727B
            if (m == 5) { return (int)0xFFFE8463; }   // #FE8463
            if (m == 6) { return (int)0xFF9BCA63; }   // #9BCA63
            return (int)0xFFFAD860;                    // #FAD860
        }
        if (name == "shine") {
            if (m == 0) { return (int)0xFFC12E34; }   // #C12E34
            if (m == 1) { return (int)0xFFE6B600; }   // #E6B600
            if (m == 2) { return (int)0xFF0098D9; }   // #0098D9
            if (m == 3) { return (int)0xFF2B821D; }   // #2B821D
            if (m == 4) { return (int)0xFF005EAA; }   // #005EAA
            if (m == 5) { return (int)0xFF339CA8; }   // #339CA8
            if (m == 6) { return (int)0xFFCDA819; }   // #CDA819
            return (int)0xFF32A487;                    // #32A487
        }
        if (name == "macarons2") {
            if (m == 0) { return (int)0xFFED9678; }   // #ED9678
            if (m == 1) { return (int)0xFFE7DAC9; }   // #E7DAC9
            if (m == 2) { return (int)0xFFCB8E85; }   // #CB8E85
            if (m == 3) { return (int)0xFFF3F39D; }   // #F3F39D
            if (m == 4) { return (int)0xFFC8E49C; }   // #C8E49C
            if (m == 5) { return (int)0xFFF16D7A; }   // #F16D7A
            if (m == 6) { return (int)0xFFF3D999; }   // #F3D999
            return (int)0xFFD3758F;                    // #D3758F
        }
        if (name == "default") {
            // ECharts 6.1 默认主题色板（src/visual/tokens.ts color.theme
            // 全 9 档，官方示例页不注册主题时的实际取色）。
            int m9 = ((i % 9) + 9) % 9;
            if (m9 == 0) { return (int)0xFF5070DD; }   // #5070DD
            if (m9 == 1) { return (int)0xFFB6D634; }   // #B6D634
            if (m9 == 2) { return (int)0xFF505372; }   // #505372
            if (m9 == 3) { return (int)0xFFFF994D; }   // #FF994D
            if (m9 == 4) { return (int)0xFF0CA8DF; }   // #0CA8DF
            if (m9 == 5) { return (int)0xFFFFD10A; }   // #FFD10A
            if (m9 == 6) { return (int)0xFFFB628B; }   // #FB628B
            if (m9 == 7) { return (int)0xFF785DB0; }   // #785DB0
            return (int)0xFF3FBE95;                    // #3FBE95
        }
        return 0;
    }
}
