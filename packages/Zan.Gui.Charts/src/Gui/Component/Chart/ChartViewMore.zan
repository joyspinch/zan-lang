using System;
using System.Json;
using Gui;
using Gui.Backend;

namespace Gui.Component.Chart;

// ---- 扩展渲染器第三批（ECharts 直译） ----
//
// ① parallel（平行坐标）：parallelAxis[dim] 垂直轴等距铺开，
//    每行数据是一条跨轴折线；维值域由显式 min/max 或该维数据
//    包络（NiceRange）定标，类目维按下标取值。行色逐行取调色板
//    （visualMap dimension 命中时覆盖）；线宽/透明度按 6.1 语义
//    消费 lineStyle.width/opacity——官方 nutrients 是发丝线低透明
//    逐行叠加的密度图。行数 >1000 走 progressive 分帧：每帧画
//    一批行，画过的经区域快照跨帧续画，画完即停（见 parProg*）。
// ② themeRiver（主题河流）：singleAxis 时间轴上按名字分带的
//    堆叠河：每名字一列值按时间对齐，累计出上下边界用
//    FillBandFx 半透明填带（ECharts 默认带 opacity ≈ 0.7 观感）。
//    时间标签全等距（解析成下标的数值时间直接当类目序）。
// ③ linesCustom（type:'lines' 非 geo 坐标兜底）：逐条 data 点对
//    直线 + 端点符号；geo 坐标系的 lines 由地图渲染器消费
//    （后续批次），这里只兜住纯直角坐标/无坐标系形态，保证
//    "type:lines" 永不落 "(no data)" 空板。

partial class ChartView {

    // ---- parallel 平行坐标 ----

    // visualMap 类目模式（官方 nutrients "Groups"）：行色 = 该行
    // dimension 列的字符串类目在 categories 里的下标 → inRange 色。
    // 列值由数据源以定点编码（字符串 AsInt 恒 0 无意义），所以
    // 类目查表挂在渲染层，直接查 option 的原始 dataset；没有
    // dataset 的形态（值列就是下标）按数值查 cats。
    static List<string> parCatNames;
    static List<int> parCatCols;
    static string parCatSrcId;
    static List<int> ParCatLookup(ChartOption o) {
        ChartVisualMap vm = null;
        for (int vi = 0; vi < o.visualMaps.Count; vi = vi + 1) {
            if (o.visualMaps[vi].vmCats.Count > 0) { vm = o.visualMaps[vi]; break; }
        }
        if (vm == null) { return null; }
        string srcId = o.datasets.Count > 0 ? o.datasets[0].id : "";
        if (parCatNames == vm.vmCats && parCatSrcId == srcId) {
            return parCatCols;
        }
        List<int> cols = new List<int>();
        for (int ci = 0; ci < vm.vmCats.Count; ci = ci + 1) { cols.Add(0 - 1); }
        if (o.datasets.Count > 0) {
            ChartJsonDataset ds = o.datasets[0];
            int col = vm.dimension >= 0 ? vm.dimension : 1;
            for (int ri = 0; ri < ds.rows.Count; ri = ri + 1) {
                JsonValue row = ds.source.At(ds.rows[ri]);
                if (row == null || !row.IsArray() || col >= row.Count()) { continue; }
                string gv = row.At(col).AsString("");
                for (int ci = 0; ci < vm.vmCats.Count; ci = ci + 1) {
                    if (cols[ci] == 0 - 1 && vm.vmCats[ci] == gv) {
                        cols[ci] = ds.rows[ri];
                        break;
                    }
                }
            }
        }
        parCatNames = vm.vmCats;
        parCatSrcId = srcId;
        parCatCols = cols;
        return cols;
    }

    // 行色判定：类目模式优先（行号查表，查不到走 outOfRange），
    // 数值渐变其次（连续 visualMap），否则系列色。
    static int ParRowColor(ChartOption o, List<int> catCols, int baseCol,
                           int rowIdx, List<int> row) {
        ChartVisualMap vm = null;
        for (int vi = 0; vi < o.visualMaps.Count; vi = vi + 1) {
            ChartVisualMap v = o.visualMaps[vi];
            if (v.vmCats.Count > 0) { vm = v; break; }
        }
        if (vm != null && catCols != null) {
            // 类目维的行值就是"行号"编码（渲染层把字符串 AsInt 恒
            // 得 0）：先用行号查表，命中即取该类目色。
            int hitR = rowIdx < catCols.Count ? catCols[rowIdx] : 0 - 1;
            if (hitR >= 0 && hitR < vm.rangeColors.Count) {
                return vm.rangeColors[hitR];
            }
            // 无 dataset 的形态：值列直接是类目下标。
            int vd = vm.dimension >= 0 ? vm.dimension : 0;
            if (vd < row.Count && row[vd] >= 0 && row[vd] < vm.rangeColors.Count) {
                return vm.rangeColors[row[vd]];
            }
            return StyleSheet.ParseColor("#ccc");
        }
        for (int vi = 0; vi < o.visualMaps.Count; vi = vi + 1) {
            ChartVisualMap v = o.visualMaps[vi];
            if (v.rangeColors.Count < 2 || !v.hasMin || !v.hasMax
                || v.maxV <= v.minV) { continue; }
            int vd = v.dimension >= 0 ? v.dimension : 0;
            if (vd >= row.Count) { continue; }
            int tF = (int)(((long)row[vd] * 1000 - (long)v.minV) * 1000L
                / (long)(v.maxV - v.minV));
            if (tF < 0) { tF = 0; }
            if (tF > 1000) { tF = 1000; }
            return ChartVisualMap.Lerp(v.rangeColors, tF);
        }
        return baseCol;
    }

    // 大数据渐进渲染状态。行折线的原版语义（官方 nutrients：
    // lineStyle.width 0.5 + opacity 0.05）是发丝线低透明密度叠加——
    // 每行一次独立 src-over，CPU 光栅器上 ~0.85ms/行，7637 行一次
    // 画完必然整窗未响应。按 ECharts progressive 语义分帧流出：
    // 每帧在时间预算内画一批行，画过的行经区域快照跨帧持久
    // （帧首恢复快照 = 接着上一帧的累积画），数据/几何/样式指纹
    // 一变即重开。未画完时 RequestAnimationFrame 续帧，流完即停，
    // 空闲回到零 CPU——大数据不阻塞 UI 线程的正解。
    static int parProgFp;
    static bool parProgHas;
    static int parProgDone;
    static int parProgSlot = -1;
    static bool parProgFresh;

    // FNV-1a 一轮（渐进指纹）。
    static int ParHash(int h, int v) {
        return h * 16777619 ^ v;
    }

    static void DrawParallel(App app, int x, int y, int w, int h,
                             ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        List<ChartSeries> series = o.series;

        // 维数：优先 parallelAxis 声明；缺省按数据最长行推断。
        int dims = o.parAxes.Count;
        for (int si = 0; si < series.Count; si = si + 1) {
            ChartSeries s = series[si];
            if (s.hidden || s.custom != "parallel") { continue; }
            for (int ri = 0; ri < s.parRows.Count; ri = ri + 1) {
                if (s.parRows[ri].Count > dims) { dims = s.parRows[ri].Count; }
            }
        }
        if (dims < 2) { return; }

        // parallelAxis[].dim：6.1 语义，轴声明绑定数据列（official
        // nutrients 的轴序是 [16,2,4,3,...]，不是数组槽位）。dim 未
        // 声明（-1）时退回数组槽位本身（axis i ↔ 列 i）。
        List<int> col = new List<int>();
        for (int d = 0; d < dims; d = d + 1) {
            int ci = d;
            if (d < o.parAxes.Count && o.parAxes[d].dim >= 0
                && o.parAxes[d].dim < 100000) {
                ci = o.parAxes[d].dim;
            }
            col.Add(ci);
        }
        // 列值域包络（dim→[lo,hi]），与轴值域共用（轴值域按列查）。
        int nCols = 0;
        for (int d = 0; d < dims; d = d + 1) {
            if (col[d] + 1 > nCols) { nCols = col[d] + 1; }
        }
        List<int> colLo = new List<int>();
        List<int> colHi = new List<int>();
        for (int ci2 = 0; ci2 < nCols; ci2 = ci2 + 1) {
            colLo.Add(0); colHi.Add(0);
        }

        int plotTop = Chart.DrawPanelI(app, x, y, w, h, o.legendTextColor, o.title, series,
            o.iwid, o.showLegend);

        // 每轴值域：显式 min/max 优先，否则按其数据列包络走
        // NiceRange；类目维域 = [0, 类目数-1]（值存下标）。
        List<int> lo = new List<int>();
        List<int> hi = new List<int>();
        for (int d = 0; d < dims; d = d + 1) {
            int dLo = 0;
            int dHi = 0;
            bool hasRng = false;
            if (d < o.parAxes.Count) {
                if (o.parAxes[d].minSet) { dLo = o.parAxes[d].min; hasRng = true; }
                if (o.parAxes[d].maxSet) { dHi = o.parAxes[d].max; hasRng = true; }
                if (o.parAxes[d].cats.Count > 0) {
                    // 类目维：域 = [0, 类目数-1]（值存下标）。
                    dLo = 0;
                    dHi = o.parAxes[d].cats.Count - 1;
                    hasRng = true;
                }
            }
            if (!hasRng) {
                int dc = col[d];
                if (dc >= colLo.Count) {
                    dLo = int.MaxValue;
                    dHi = int.MinValue;
                    for (int si = 0; si < series.Count; si = si + 1) {
                        ChartSeries s = series[si];
                        if (s.hidden || s.custom != "parallel") { continue; }
                        for (int ri = 0; ri < s.parRows.Count; ri = ri + 1) {
                            List<int> row = s.parRows[ri];
                            if (dc >= row.Count) { continue; }
                            if (row[dc] < dLo) { dLo = row[dc]; }
                            if (row[dc] > dHi) { dHi = row[dc]; }
                        }
                    }
                    if (dLo == int.MaxValue) { dLo = 0; dHi = 1; }
                    ChartSpan sp = Chart.NiceRange(dLo, dHi);
                    dLo = sp.lo;
                    dHi = sp.hi;
                } else {
                    dLo = colLo[dc];
                    dHi = colHi[dc];
                }
            }
            if (dHi <= dLo) { dHi = dLo + 1; }
            lo.Add(dLo);
            hi.Add(dHi);
        }

        // 布局：标题/图例下方一块绘图区，轴间留端点标签。
        int pad = t.paddingMedium;
        int axisFs = ChartFonts.AxisLabel(app);
        int nameH = Canvas.FontHeight(axisFs);
        int plotX = x + pad + app.Scale(8);
        int plotY = plotTop + nameH + app.Scale(6);
        int plotW = (x + w - pad - app.Scale(8)) - plotX;
        int plotH = (y + h - pad - nameH - app.Scale(4)) - plotY;
        if (plotW < 10 || plotH < 10) { return; }

        StyleBox sAxis = Style.Part(app, "chart", "axis", "", "", "",
                                    Style.SNormal());
        StyleBox sGrid = Style.Part(app, "chart", "grid", "", "", "",
                                    Style.SNormal());
        int axCol = sAxis.FgOr(0);

        // parallel.layout：'vertical' = 轴自上而下堆叠、每根轴横置
        //（official nutrients 官方图：轴名 nameLocation:'end' 在右
        // 端）；缺省/'horizontal' = 既有形态，竖轴从左到右排开。
        bool horizAxes = o.parLayout == "vertical";

        // 刻度文本（axisLabel：缺省沿轴内側，末轴外側避让）。
        if (horizAxes) {
            // 横轴自上而下等距：轴 0 贴顶、轴 N-1 贴底。轴名 name
            // 在右端外側；刻度值画在轴下方（k=0 首轴在上方避让）。
            for (int d = 0; d < dims; d = d + 1) {
                int ay = plotY + (dims == 1 ? 0 : d * plotH / (dims - 1));
                c.FillRect(plotX, ay, plotW, app.Scale(2), axCol);
                int span = hi[d] - lo[d];
                int sideY = ay + app.Scale(4);
                if (d == 0) { sideY = ay - app.Scale(3) - nameH; }
                if (sideY < plotY - nameH - app.Scale(3)) {
                    sideY = ay + app.Scale(4);
                }
                for (int k = 0; k <= 4; k = k + 1) {
                    int gx = plotX + k * plotW / 4;
                    if (k > 0 && d == 0) {
                        c.FillRect(gx, plotY, 1, plotH, sGrid.BgOr(0));
                    }
                    int val = lo[d] + span * k / 4;
                    string vs;
                    if (d < o.parAxes.Count && o.parAxes[d].cats.Count > 0) {
                        int ci = val;
                        if (ci < 0) { ci = 0; }
                        if (ci >= o.parAxes[d].cats.Count) {
                            ci = o.parAxes[d].cats.Count - 1;
                        }
                        vs = o.parAxes[d].cats[ci];
                    } else {
                        vs = Chart.Commas(val);
                    }
                    int vw = Canvas.MeasureText(vs, axisFs);
                    int lx = gx - vw / 2;
                    if (k == 0) { lx = gx; }
                    if (k == 4) { lx = gx - vw; }
                    if (lx < plotX) { lx = plotX; }
                    c.DrawText(lx, sideY, vs, axCol, axisFs);
                }
                // 轴名：右端外側（nameLocation 'end' 语义）。
                if (d < o.parAxes.Count && o.parAxes[d].name.Length > 0) {
                    int nw = Canvas.MeasureText(o.parAxes[d].name, axisFs);
                    c.DrawText(plotX + plotW + app.Scale(8),
                        ay - nameH / 2 + app.Scale(1), o.parAxes[d].name,
                        axCol, axisFs);
                }
            }
        } else {
        // N 根垂直轴等距：轴 0 贴左缘、轴 N-1 贴右缘。
        for (int d = 0; d < dims; d = d + 1) {
            int ax = plotX + (dims == 1 ? 0 : d * plotW / (dims - 1));
            c.FillRect(ax, plotY, app.Scale(2), plotH, axCol);
            // 每轴 4 格横向网格线 + 刻度值。
            int span = hi[d] - lo[d];
            for (int k = 0; k <= 4; k = k + 1) {
                int gy = plotY + plotH - k * plotH / 4;
                if (k > 0) {
                    c.FillRect(plotX, gy, plotW, 1, sGrid.BgOr(0));
                }
                int val = lo[d] + span * k / 4;
                string vs;
                if (d < o.parAxes.Count && o.parAxes[d].cats.Count > 0) {
                    int ci = val;
                    if (ci < 0) { ci = 0; }
                    if (ci >= o.parAxes[d].cats.Count) {
                        ci = o.parAxes[d].cats.Count - 1;
                    }
                    vs = o.parAxes[d].cats[ci];
                } else {
                    vs = Chart.Commas(val);
                }
                int vw = Canvas.MeasureText(vs, axisFs);
                int lx = ax + app.Scale(5);
                bool rightSide = d == dims - 1 && dims > 1;
                if (rightSide) { lx = ax - app.Scale(5) - vw; }
                c.DrawText(lx, Canvas.CenterTextYAt(gy, axisFs), vs, axCol, axisFs);
            }
            // 轴名：首轴上方、末轴上方（inverse 时对调，aqi demo）。
            if (d < o.parAxes.Count && o.parAxes[d].name.Length > 0) {
                bool inv = o.parAxes[d].inverse;
                bool topName = d == 0 ? !inv : inv;
                int nw = Canvas.MeasureText(o.parAxes[d].name, axisFs);
                int nx = ax - nw / 2;
                if (nx < plotX) { nx = plotX; }
                if (nx + nw > plotX + plotW) { nx = plotX + plotW - nw; }
                if (topName) {
                    c.DrawText(nx, plotTop, o.parAxes[d].name, axCol, axisFs);
                } else {
                    c.DrawText(nx, plotY + plotH + app.Scale(4),
                        o.parAxes[d].name, axCol, axisFs);
                }
            }
        }
        }

        // visualMap piecewise 类目模式（official nutrients Groups）：
        // 行色 = 行号 → 该行 dimension 列类目下标 → inRange 色；
        // 控件面板画在绘图区左缘（top:20 语义，25 项超行数截断）。
        List<int> catCols = ParCatLookup(o);
        int nCats = 0;
        int catVmIdx = 0 - 1;
        for (int vi = 0; vi < o.visualMaps.Count; vi = vi + 1) {
            if (o.visualMaps[vi].vmCats.Count > 0) {
                nCats = o.visualMaps[vi].vmCats.Count;
                catVmIdx = vi;
                break;
            }
        }
        if (nCats > 0 && o.visualMaps[catVmIdx].show) {
            ChartVisualMap vm = o.visualMaps[catVmIdx];
            int lgFs = ChartFonts.Legend(app);
            int rowH = Canvas.FontHeight(lgFs) + app.Scale(4);
            int maxRows = plotH / rowH;
            if (maxRows < 1) { maxRows = 1; }
            int headH = Canvas.FontHeight(lgFs) + app.Scale(6);
            int sw = app.Scale(10);
            int lgX = plotX + app.Scale(4);
            int lgY = plotY + app.Scale(16);
            StyleBox sLegend = Style.Part(app, "chart", "legend", "", "", "",
                                          Style.SNormal());
            int txtCol = sLegend.FgOr(0);
            c.DrawText(lgX, lgY, "Groups", txtCol, lgFs);
            lgY = lgY + headH;
            int shown = nCats < maxRows ? nCats : maxRows;
            for (int ci = 0; ci < shown; ci = ci + 1) {
                int cc = ci < vm.rangeColors.Count ? vm.rangeColors[ci]
                    : vm.rangeColors.Count > 0
                    ? vm.rangeColors[vm.rangeColors.Count - 1] : 0;
                c.FillRoundRect(lgX, lgY + app.Scale(2), sw, sw,
                    t.borderRadiusSmall, cc);
                string nm = vm.vmCats[ci];
                if (nm.Length > 22) { nm = nm.Substring(0, 22) + ".."; }
                c.DrawText(lgX + sw + app.Scale(5), lgY, nm, txtCol, lgFs);
                lgY = lgY + rowH;
            }
            if (shown < nCats) {
                string more = "+" + (nCats - shown);
                c.DrawText(lgX, lgY, more, txtCol, lgFs);
            }
        }

        // 行折线：一条行 = 跨 dims 根轴的 (ax, y) 折线。行色/线宽/
        // 透明度按 6.1 语义消费 lineStyle（官方 nutrients 是
        // width 0.5 + opacity 0.05 的发丝线密度叠加，不是实线）。
        int slot = 0;
        int mX = app.mouseX;
        int mY = app.mouseY;

        // 总行数：超过阈值走渐进分帧（阈值下的图一次画完，保留
        // 生长动画）。
        int totalRows = 0;
        for (int si = 0; si < series.Count; si = si + 1) {
            ChartSeries s = series[si];
            if (s.hidden || s.custom != "parallel") { continue; }
            totalRows = totalRows + s.parRows.Count;
        }
        bool stream = totalRows > 1000;
        int frameStart = Window.GetTickMs();

        // 渐进指纹：数据/几何/样式任一变化即重开（快照续画只在
        // 同一指纹下合法）。
        int fp = 17;
        if (stream) {
            fp = ParHash(fp, dims);
            fp = ParHash(fp, plotX); fp = ParHash(fp, plotY);
            fp = ParHash(fp, plotW); fp = ParHash(fp, plotH);
            fp = ParHash(fp, totalRows);
            fp = ParHash(fp, axCol);
            fp = ParHash(fp, sGrid.BgOr(0));
            fp = ParHash(fp, horizAxes ? 1 : 0);
            for (int d = 0; d < dims; d = d + 1) {
                fp = ParHash(fp, lo[d]); fp = ParHash(fp, hi[d]);
            }
            for (int vi = 0; vi < o.visualMaps.Count; vi = vi + 1) {
                ChartVisualMap vm = o.visualMaps[vi];
                fp = ParHash(fp, vm.dimension);
                fp = ParHash(fp, vm.minV); fp = ParHash(fp, vm.maxV);
                for (int ci = 0; ci < vm.rangeColors.Count; ci = ci + 1) {
                    fp = ParHash(fp, vm.rangeColors[ci]);
                }
            }
            for (int si = 0; si < series.Count; si = si + 1) {
                ChartSeries s = series[si];
                if (s.hidden || s.custom != "parallel") { continue; }
                fp = ParHash(fp, s.color);
                fp = ParHash(fp, s.itemStyle != null && s.itemStyle.normal != null
                    ? s.itemStyle.normal.lineStyle.width : 0);
                fp = ParHash(fp, s.itemStyle != null && s.itemStyle.normal != null
                    ? s.itemStyle.normal.lineStyle.alpha : 0);
                fp = ParHash(fp, s.parRows.Count);
                for (int ri = 0; ri < s.parRows.Count; ri = ri + 1) {
                    List<int> row = s.parRows[ri];
                    fp = ParHash(fp, row.Count);
                    for (int di = 0; di < row.Count; di = di + 1) {
                        fp = ParHash(fp, row[di]);
                    }
                }
            }
            if (!parProgHas || fp != parProgFp) {
                parProgFp = fp;
                parProgHas = true;
                parProgDone = 0;
                parProgFresh = true;
                if (parProgSlot < 0) { parProgSlot = ChartView.AllocCacheSlot(); }
            }
            // 帧首恢复上一帧的行像素（区域 = 绘图区，含网格底）。
            // 几何变了快照自己会拒绝，此时从头再流。
            if (!parProgFresh) {
                if (!c.RestoreRect(plotX, plotY, plotW, plotH, parProgSlot)) {
                    parProgDone = 0;
                    parProgFresh = true;
                }
            }
        }

        int newDone = stream ? parProgDone : totalRows;
        bool budgetOut = false;
        int rowBase = 0;
        for (int si = 0; si < series.Count && !budgetOut; si = si + 1) {
            ChartSeries s = series[si];
            if (s.hidden || s.custom != "parallel") { continue; }
            int baseCol = s.color;
            if (baseCol == 0) { baseCol = Chart.Palette(t, slot); }
            // series.lineStyle.width/opacity（6.1 语义，官方 nutrients
            // 0.5 + 0.05）：width 经解析 round 进 itemStyle.normal.
            // lineStyle.width，opacity 记 alpha；未声明按原缺省。
            ChartLineStyle parLs = s.itemStyle != null && s.itemStyle.normal != null
                ? s.itemStyle.normal.lineStyle : null;
            int th = parLs != null && parLs.width > 0 ? app.Scale(parLs.width) : app.Scale(2);
            if (th < 1) { th = 1; }
            int rowAlpha = parLs != null && parLs.alpha > 0 ? parLs.alpha : 255;
            // 生长淡入只对非流式小图；流式按原版 progressive 语义
            // 直接进终态密度，不叠加额外动画。
            int alpha = rowAlpha;
            if (!stream && g < 1000) {
                alpha = rowAlpha * (60 + 195 * g / 1000) / 255;
            }
            for (int ri = 0; ri < s.parRows.Count; ri = ri + 1) {
                int gi = rowBase + ri;
                if (stream) {
                    if (gi < parProgDone) { continue; }   // 前帧已画（快照里）
                    if (Window.GetTickMs() - frameStart >= 24) {
                        budgetOut = true;
                        break;
                    }
                }
                newDone = gi + 1;
                List<int> row = s.parRows[ri];
                if (row.Count < 2) { continue; }
                int colv = ParRowColor(o, catCols, baseCol, gi, row);
                colv = Chart.WithAlpha(colv, alpha);
                List<int> px = new List<int>();
                List<int> py = new List<int>();
                for (int d = 0; d < dims; d = di2(d, row, dims)) {
                    int dc = col[d];
                    int span = hi[d] - lo[d];
                    if (span < 1) { span = 1; }
                    int v = dc < row.Count ? row[dc] : lo[d];
                    if (d < o.parAxes.Count && o.parAxes[d].inverse
                        && !o.parAxes[d].minSet && !o.parAxes[d].maxSet) {
                        v = hi[d] - (v - lo[d]);
                    }
                    if (horizAxes) {
                        int xv = plotX + (v - lo[d]) * plotW / span;
                        if (xv < plotX) { xv = plotX; }
                        if (xv > plotX + plotW) { xv = plotX + plotW; }
                        int ay = plotY + d * plotH / (dims - 1);
                        px.Add(xv);
                        py.Add(ay);
                    } else {
                        int ax = plotX + d * plotW / (dims - 1);
                        int pyv = plotY + plotH - (v - lo[d]) * plotH / span;
                        if (pyv < plotY) { pyv = plotY; }
                        if (pyv > plotY + plotH) { pyv = plotY + plotH; }
                        px.Add(ax);
                        py.Add(pyv);
                    }
                }
                // 每行一次独立 src-over：半透明行的逐行叠加累积
                // 正是官方密度图的成因，不能合并成一次批量合成。
                c.DrawPolyline(px, py, colv, th);
                if (stream && Window.GetTickMs() - frameStart >= 24) {
                    budgetOut = true;
                    break;
                }
            }
            rowBase = rowBase + s.parRows.Count;
            slot = slot + 1;
        }

        if (stream) {
            int prevDone = parProgDone;
            parProgDone = newDone;
            parProgFresh = false;
            // 行像素变了才重拍累积快照；流完的帧只恢复不重拍。
            if (parProgDone != prevDone || parProgDone == 0) {
                c.SnapshotRect(plotX, plotY, plotW, plotH, parProgSlot);
            }
            if (parProgDone < totalRows) { app.RequestAnimationFrame(16); }
        }

        // 命中：指针贴近某已画行在任一轴上的顶点。顶点重算代价
        // O(已画行×维)，指针在图外时整段跳过。
        int pad6 = app.Scale(6);
        if (mX >= plotX - pad6 && mX <= plotX + plotW + pad6
            && mY >= plotY - pad6 && mY <= plotY + plotH + pad6) {
            int visRows = stream ? parProgDone : totalRows;
            int hitR2 = pad6 * pad6;
            int gi = 0;
            bool hitDone = false;
            for (int si = 0; si < series.Count && !hitDone; si = si + 1) {
                ChartSeries s = series[si];
                if (s.hidden || s.custom != "parallel") { continue; }
                for (int ri = 0; ri < s.parRows.Count && !hitDone; ri = ri + 1) {
                    if (gi >= visRows) { hitDone = true; break; }
                    gi = gi + 1;
                    List<int> row = s.parRows[ri];
                    if (row.Count < 2) { continue; }
                    for (int d = 0; d < dims; d = d + 1) {
                        int ax = plotX + d * plotW / (dims - 1);
                        int span = hi[d] - lo[d];
                        if (span < 1) { span = 1; }
                        int v = d < row.Count ? row[d] : lo[d];
                        if (d < o.parAxes.Count && o.parAxes[d].inverse
                            && !o.parAxes[d].minSet && !o.parAxes[d].maxSet) {
                            v = hi[d] - (v - lo[d]);
                        }
                        int pyv = plotY + plotH - (v - lo[d]) * plotH / span;
                        if (pyv < plotY) { pyv = plotY; }
                        if (pyv > plotY + plotH) { pyv = plotY + plotH; }
                        int dx = mX - ax;
                        int dy = mY - pyv;
                        if (dx * dx + dy * dy <= hitR2) {
                            ChartHit mh = ChartHit.Of(ChartElementType.LinePoint,
                                ChartView.SeriesIndexOf(o, s), s.name, ri,
                                "", 0, mX, mY);
                            ChartView.OfferActiveHit(mh);
                            break;
                        }
                    }
                }
            }
        }
    }

    // 行循环的维步进辅助（保持 for 头简洁）。
    static int di2(int d, List<int> row, int dims) {
        return d + 1;
    }

    // ---- themeRiver 主题河流 ----

    static void DrawThemeRiver(App app, int x, int y, int w, int h,
                               ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        List<ChartSeries> series = o.series;

        // 收集全体时间标签（保序去重）与名字表（跨系列合并）。
        List<string> times = new List<string>();
        List<string> names = new List<string>();
        for (int si = 0; si < series.Count; si = si + 1) {
            ChartSeries s = series[si];
            if (s.custom != "themeRiver") { continue; }
            for (int ti = 0; ti < s.riverTimes.Count; ti = ti + 1) {
                string tm = s.riverTimes[ti];
                bool seen = false;
                for (int k = 0; k < times.Count; k = k + 1) {
                    if (times[k] == tm) { seen = true; break; }
                }
                if (!seen) { times.Add(tm); }
            }
            for (int ni = 0; ni < s.riverNames.Count; ni = ni + 1) {
                string nm = s.riverNames[ni];
                bool seen2 = false;
                for (int k = 0; k < names.Count; k = k + 1) {
                    if (names[k] == nm) { seen2 = true; break; }
                }
                if (!seen2) { names.Add(nm); }
            }
        }
        int nT = times.Count;
        int nN = names.Count;
        if (nT < 2 || nN < 1) { return; }

        // 值矩阵 [name][time]（缺项 = 0）。
        List<List<int>> grid = new List<List<int>>();
        for (int ni = 0; ni < nN; ni = ni + 1) {
            List<int> row = new List<int>();
            for (int ti = 0; ti < nT; ti = ti + 1) { row.Add(0); }
            grid.Add(row);
        }
        for (int si = 0; si < series.Count; si = si + 1) {
            ChartSeries s = series[si];
            if (s.hidden || s.custom != "themeRiver") { continue; }
            for (int pi = 0; pi < s.riverTimes.Count; pi = pi + 1) {
                int ti = -1;
                for (int k = 0; k < nT; k = k + 1) {
                    if (times[k] == s.riverTimes[pi]) { ti = k; break; }
                }
                if (ti < 0 || s.riverCat[pi] >= nN) { continue; }
                grid[s.riverCat[pi]][ti] = grid[s.riverCat[pi]][ti]
                    + s.riverVals[pi];
            }
        }

        int plotTop = Chart.DrawPanelI(app, x, y, w, h, o.legendTextColor, o.title, series,
            o.iwid, o.showLegend);
        // 时间轴类目：等距带状（boundaryGap 语义）。
        ChartFrame f = Chart.BuildAxesR(app, x, y, w, h, plotTop, times,
            o, series, 0 - 1, 0 - 1, 0 - 1, 0 - 1);

        int totalMax = 0;
        for (int ti = 0; ti < nT; ti = ti + 1) {
            int sum = 0;
            for (int ni = 0; ni < nN; ni = ni + 1) { sum = sum + grid[ni][ti]; }
            if (sum > totalMax) { totalMax = sum; }
        }
        if (totalMax < 1) { totalMax = 1; }

        int alpha = 255;
        if (g < 1000) { alpha = 60 + 195 * g / 1000; }
        if (alpha > 255) { alpha = 255; }

        List<int> xs = new List<int>();
        for (int ti = 0; ti < nT; ti = ti + 1) {
            xs.Add(f.CatMid(ti, nT) * 256);
        }

        int mX = app.mouseX;
        int mY = app.mouseY;
        // 每列累计基线：上一带的顶 = 下一带的底。
        List<int> baseRow = new List<int>();
        for (int ti = 0; ti < nT; ti = ti + 1) { baseRow.Add(0); }
        for (int ni = 0; ni < nN; ni = ni + 1) {
            int baseCol = Chart.Palette(t, ni);
            int colA = Chart.WithAlpha(baseCol, alpha * 7 / 10);
            List<int> topFx = new List<int>();
            List<int> topPath = new List<int>();
            List<int> botFx = new List<int>();
            List<int> botPath = new List<int>();
            for (int ti = 0; ti < nT; ti = ti + 1) {
                int lo = baseRow[ti];
                int hiCum = lo + grid[ni][ti];
                int botPix = f.plotY + f.plotH - lo * f.plotH / totalMax;
                int topPix = f.plotY + f.plotH - hiCum * f.plotH / totalMax;
                topFx.Add(xs[ti]);
                topPath.Add(topPix * 256);
                botFx.Add(xs[ti]);
                botPath.Add(botPix * 256);
            }
            ChartView.FillBandFx(c, topFx, topPath, botFx, botPath,
                colA, false, 255, 255, 179);
            // 累计推进：下一带的底 = 本带的顶（按列累计）。
            for (int ti2 = 0; ti2 < nT; ti2 = ti2 + 1) {
                baseRow[ti2] = baseRow[ti2] + grid[ni][ti2];
            }
            // 命中：指针在带内（该列的本带上下界之间）。
            for (int ti3 = 0; ti3 < nT; ti3 = ti3 + 1) {
                if (mX < f.CatLeft(ti3, nT) || mX >= f.CatLeft(ti3, nT) + f.CatWidth(ti3, nT)) { continue; }
                int lo2 = baseRow[ti3] - grid[ni][ti3];
                int hi2 = baseRow[ti3];
                int botPix = f.plotY + f.plotH - lo2 * f.plotH / totalMax;
                int topPix = f.plotY + f.plotH - hi2 * f.plotH / totalMax;
                if (mY >= topPix && mY <= botPix) {
                    List<TooltipRow> rows = new List<TooltipRow>();
                    rows.Add(TooltipRow.Of(baseCol, names[ni]));
                    rows.Add(TooltipRow.Of(0, times[ti3] + "  "
                        + Chart.Commas(grid[ni][ti3])));
                    ChartView.TooltipCard(app, mX, mY,
                        f.plotX + f.plotW, rows);
                    break;
                }
            }
        }
    }

    // ---- lines 非 geo 兜底 ----

    static void DrawLinesCustom(App app, int x, int y, int w, int h,
                                ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        List<ChartSeries> series = o.series;
        int plotTop = Chart.DrawPanelI(app, x, y, w, h, o.legendTextColor, o.title, series,
            o.iwid, o.showLegend);
        // 点对数据：收集全部端点定标。
        int mX = app.mouseX;
        int mY = app.mouseY;
        int alpha = 255;
        if (g < 1000) { alpha = 60 + 195 * g / 1000; }
        if (alpha > 255) { alpha = 255; }
        int slot = 0;
        for (int si = 0; si < series.Count; si = si + 1) {
            ChartSeries s = series[si];
            if (s.hidden || s.custom != "lines") { continue; }
            int col = s.color;
            if (col == 0) { col = Chart.Palette(t, slot); }
            int colA = Chart.WithAlpha(col, alpha);
            // data 里每项 points 对 [ [x,y],[x,y],... ]；
            // 引擎把坐标对的序列挂在 series.points。
            if (s.points.Count >= 2) {
                int nPts = s.points.Count / 2;
                for (int li = 0; li < nPts; li = li + 1) {
                    int x0 = s.points[li * 2].x;
                    int y0 = s.points[li * 2].y;
                    int x1 = s.points[li * 2 + 1].x;
                    int y1 = s.points[li * 2 + 1].y;
                    c.DrawLine(x0, y0, x1, y1, colA, app.Scale(1));
                }
            }
            slot = slot + 1;
        }
    }
}
