using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// 某深度合并后的 treemap 样式（levels[depth] → 系级 tm* → 官方缺省），
// px 值已过 app.Scale。
class TmStyle {
    int borderWidth;
    int gapWidth;
    int borderColor;
    int borderColorSat;  // -1 未声明；声明后 borderColor 失效
    int hasColorSat;  // colorSaturation [lo,hi]（千分值域）
    int satLo;
    int satHi;
    int upperShow;
    int upperHeight;  // max(borderWidth, show ? height : 0)
    List<int> color;  // 级 color 数组（null → 继承父级 designated）
    int colorMappingBy;  // 0 index | 1 value | 2 id
}
