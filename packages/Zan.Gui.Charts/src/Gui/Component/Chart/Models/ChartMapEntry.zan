using System;

namespace Gui.Component.Chart;

// 已注册地图：echarts registerMap 的对应物。regions 是 0.01°
// 屏幕系几何（GeoJSON 形态，ChartGeoJson.ParseText 解析）或
// SVG 用户单位几何（SVG 形态，ChartSvgMap.Scan 惰性扫描）；
// svg 非 "" 即 SVG 地图，vx..vh 为其 viewBox（布局源框）。
public class ChartMapEntry {
    public string name;
    public string svg;
    public double vx;
    public double vy;
    public double vw;
    public double vh;
    public bool scanned;
    public List<ChartMapRegion> regions;

    public static ChartMapEntry Of(string name) {
        ChartMapEntry e = new ChartMapEntry();
        e.name = name;
        e.svg = "";
        e.scanned = false;
        e.regions = new List<ChartMapRegion>();
        return e;
    }
}
