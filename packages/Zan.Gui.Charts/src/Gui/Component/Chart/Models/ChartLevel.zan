using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartLevel {
    public List<int> color;  // 级调色板 / 渐变档（空 = 继承全局调色板）
    public int hasColorSat;  // colorSaturation [lo,hi] 已声明（千分值饱和度域）
    public int satLo;
    public int satHi;
    public int colorMappingBy;  // 0 index | 1 value | 2 id（官方缺省 index）
    public int borderWidth;  // 官方缺省 0
    public int borderColor;  // 0 = 未声明（官方缺省 neutral00 #fff）
    public int gapWidth;  // 官方缺省 0
    public int borderColorSat;  // borderColorSaturation 千分值；-1 未声明
    public int upperShow;  // 0/1；-1 未声明（官方缺省 false）
    public int upperHeight;  // 官方缺省 20
    public int r0;  // sunburst 环带内半径 px；-1 未声明
    public int r;  // sunburst 环带外半径 px；-1 未声明
    public int labelMode;  // 0 未声明 | 1 radial | 2 tangential | 3 角度
    public int labelRotate;  // labelMode==3 的角度
    public int r0Pct;  // sunburst 环带内半径百分比（千分值）；-1 未声明
    public int rPct;  // sunburst 环带外半径百分比（千分值）；-1 未声明
    public int colorOne;  // 级 itemStyle.color 单色（0 未声明）
    public int labelColor;  // 级 label.color（0 未声明）

    public static ChartLevel Of() {
        ChartLevel lv = new ChartLevel();
        lv.color = null;
        lv.hasColorSat = 0;
        lv.satLo = 0;
        lv.satHi = 0;
        lv.colorMappingBy = 0;
        lv.borderWidth = 0 - 1;
        lv.borderColor = 0;
        lv.gapWidth = 0 - 1;
        lv.borderColorSat = 0 - 1;
        lv.upperShow = 0 - 1;
        lv.upperHeight = 0 - 1;
        lv.r0 = 0 - 1;
        lv.r = 0 - 1;
        lv.labelMode = 0;
        lv.labelRotate = 0;
        lv.r0Pct = 0 - 1;
        lv.rPct = 0 - 1;
        lv.colorOne = 0;
        lv.labelColor = 0;
        return lv;
    }

    // 面向对象深复制实例方法。


    public ChartLevel Clone() {
        ChartLevel lv = ChartLevel.Of();
        if (this.color != null) {
            lv.color = new List<int>();
            for (int i = 0; i < this.color.Count; i = i + 1) { lv.color.Add(this.color[i]); }
        }
        lv.hasColorSat = this.hasColorSat;
        lv.satLo = this.satLo;
        lv.satHi = this.satHi;
        lv.colorMappingBy = this.colorMappingBy;
        lv.borderWidth = this.borderWidth;
        lv.borderColor = this.borderColor;
        lv.gapWidth = this.gapWidth;
        lv.borderColorSat = this.borderColorSat;
        lv.upperShow = this.upperShow;
        lv.upperHeight = this.upperHeight;
        lv.r0 = this.r0;
        lv.r = this.r;
        lv.labelMode = this.labelMode;
        lv.labelRotate = this.labelRotate;
        lv.r0Pct = this.r0Pct;
        lv.rPct = this.rPct;
        lv.colorOne = this.colorOne;
        lv.labelColor = this.labelColor;
        return lv;
    }

    public static ChartLevel Clone(ChartLevel src) {
        if (src == null) { return null; }
        return src.Clone();
    }
}
