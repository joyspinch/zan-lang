using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

class ChartLevel {
    List<int> color;  // 级调色板 / 渐变档（空 = 继承全局调色板）
    int hasColorSat;  // colorSaturation [lo,hi] 已声明（千分值饱和度域）
    int satLo;
    int satHi;
    int colorMappingBy;  // 0 index | 1 value | 2 id（官方缺省 index）
    int borderWidth;  // 官方缺省 0
    int borderColor;  // 0 = 未声明（官方缺省 neutral00 #fff）
    int gapWidth;  // 官方缺省 0
    int borderColorSat;  // borderColorSaturation 千分值；-1 未声明
    int upperShow;  // 0/1；-1 未声明（官方缺省 false）
    int upperHeight;  // 官方缺省 20
    int r0;  // sunburst 环带内半径 px；-1 未声明
    int r;  // sunburst 环带外半径 px；-1 未声明
    int labelMode;  // 0 未声明 | 1 radial | 2 tangential | 3 角度
    int labelRotate;  // labelMode==3 的角度
    int r0Pct;  // sunburst 环带内半径百分比（千分值）；-1 未声明
    int rPct;  // sunburst 环带外半径百分比（千分值）；-1 未声明
    int colorOne;  // 级 itemStyle.color 单色（0 未声明）
    int labelColor;  // 级 label.color（0 未声明）

    static ChartLevel Of() {
        ChartLevel lv = new ChartLevel();
        lv.color = null;
        lv.hasColorSat = 0;
        lv.satLo = 0;
        lv.satHi = 0;
        lv.colorMappingBy = 0;
        lv.borderWidth = 0 - 1;
        lv.borderColor = 0;
        lv.gapWidth = 0 - 1;
        lv.borderColorSat = 0 - 1;
        lv.upperShow = 0 - 1;
        lv.upperHeight = 0 - 1;
        lv.r0 = 0 - 1;
        lv.r = 0 - 1;
        lv.labelMode = 0;
        lv.labelRotate = 0;
        lv.r0Pct = 0 - 1;
        lv.rPct = 0 - 1;
        lv.colorOne = 0;
        lv.labelColor = 0;
        return lv;
    }

    static ChartLevel Clone(ChartLevel src) {
        if (src == null) { return null; }
        ChartLevel lv = ChartLevel.Of();
        if (src.color != null) {
            lv.color = new List<int>();
            for (int i = 0; i < src.color.Count; i = i + 1) { lv.color.Add(src.color[i]); }
        }
        lv.hasColorSat = src.hasColorSat;
        lv.satLo = src.satLo;
        lv.satHi = src.satHi;
        lv.colorMappingBy = src.colorMappingBy;
        lv.borderWidth = src.borderWidth;
        lv.borderColor = src.borderColor;
        lv.gapWidth = src.gapWidth;
        lv.borderColorSat = src.borderColorSat;
        lv.upperShow = src.upperShow;
        lv.upperHeight = src.upperHeight;
        lv.r0 = src.r0;
        lv.r = src.r;
        lv.labelMode = src.labelMode;
        lv.labelRotate = src.labelRotate;
        lv.r0Pct = src.r0Pct;
        lv.rPct = src.rPct;
        lv.colorOne = src.colorOne;
        lv.labelColor = src.labelColor;
        return lv;
    }
}
