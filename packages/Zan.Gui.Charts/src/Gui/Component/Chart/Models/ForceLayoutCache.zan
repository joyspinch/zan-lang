using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// 力导向布局的逐帧记忆化条目：布局是数据与几何的纯函数，
// 即时模式调用方每帧重建 option 对象，按内容指纹复用
// 同一次弹簧模拟，避免滚动/悬停帧反复重算 O(n²) 迭代。
public class ForceLayoutCache {
    public int fp;
    public ForceLayout layout;
    // 指纹命中则返回缓存布局；未命中返回 null。
    public static ForceLayout Lookup(List<ForceLayoutCache> cache, int fp) {
        for (int i = 0; i < cache.Count; i = i + 1) {
            if (cache[i].fp == fp) { return cache[i].layout; }
        }
        return null;
    }
    // 存入布局（同指纹去重；超出容量时挤掉最旧的一条）。
    public static void Store(List<ForceLayoutCache> cache, int fp, ForceLayout l,
                             int capacity) {
        for (int i = 0; i < cache.Count; i = i + 1) {
            if (cache[i].fp == fp) { return; }
        }
        ForceLayoutCache e = new ForceLayoutCache();
        e.fp = fp;
        e.layout = l;
        if (cache.Count >= capacity) { cache.RemoveAt(0); }
        cache.Add(e);
    }
}
