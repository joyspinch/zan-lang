using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartEvent {
    public string name;
    public int start;
    public int end;
    public int value;
    public int color;  // 0 = 继承系列颜色

    // 构造一个事件；color 为 0 表示继承系列颜色。
    public static ChartEvent Of(string name, int start, int end, int value) {
        ChartEvent e = new ChartEvent();
        e.name = name; e.start = start; e.end = end; e.value = value; e.color = 0;
        return e;
    }

    // 深复制；src 为 null 时返回 null。
    // 面向对象深复制实例方法。
    public ChartEvent Clone() {
        ChartEvent e = ChartEvent.Of(this.name, this.start, this.end, this.value);
        e.color = this.color;
        return e;
    }

    public static ChartEvent Clone(ChartEvent src) {
        if (src == null) { return null; }
        return src.Clone();
    }
}

// 一条订阅记录：事件类型与处理器的配对（仅 ChartEventHub 内部使用）。
public class ChartEventSubscription {
    public ChartEventType type;
    public ChartInteractionHandler handler;

    // 构造一条订阅。
    public ChartEventSubscription(ChartEventType type, ChartInteractionHandler handler) {
        this.type = type;
        this.handler = handler;
    }
}
