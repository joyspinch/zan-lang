using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

public class ChartMarkArea {
    public bool xMode;
    public int v0; public int v1;
    public int color;
    public string name;

    public static ChartMarkArea Of() {
        return new ChartMarkArea { xMode = true, v0 = 0, v1 = 0,
            color = 0, name = "" };
    }
}

public class ChartMarkLine {
    public string kind;
    public string name;  // ECharts data 项的 name（平均值/…），tooltip 用
    public int xValue;
    public int yValue;
    public bool hasPoint;
    public string label;
    public string lineType;
    public int color;
    public bool labelShow;  // markLine.label.show（默认 true；area-pieces 关）
    public bool startArrow;  // markLine.symbol[0]："arrow" 才画（默认 none）
    public bool endArrow;  // markLine.symbol[1]：ECharts 默认 ['none','arrow']
    public bool hasEnd;  // 两点斜线（coord 对）：回归/趋势线（anscombe 等）
    public int x2Value;  // 终点 x（原始值域，x 为数值轴时按值映射）
    public int y2Value;  // 终点 y

    // 按 kind 构造阈值线（"average"/"min"/"max" 或 "" = 显式线）。
    public int valueIndex;  // ECharts valueIndex：-1 = 值轴(y 水平线)，0 = x 轴(竖线)

    public static ChartMarkLine Of(string kind) {
        return ChartMarkLine.Of(kind, "");
    }
    // 带 name 的版本（ECharts data 项 {type:'average', name:'平均值'}）。
    public static ChartMarkLine Of(string kind, string name) {
        return new ChartMarkLine { kind = kind, name = name, xValue = 0, yValue = 0,
            hasPoint = false, label = "", lineType = "", color = 0,
            valueIndex = 0 - 1, labelShow = true, startArrow = false,
            endArrow = true, hasEnd = false, x2Value = 0, y2Value = 0 };
    }
    // 平均线：窗口数据的算术平均。
    public static ChartMarkLine Average() { return ChartMarkLine.Of("average"); }
    // 带 name 的平均线。
    public static ChartMarkLine Average(string name) { return ChartMarkLine.Of("average", name); }
    // 最小值线。
    public static ChartMarkLine Min() { return ChartMarkLine.Of("min"); }
    // 最大值线。
    public static ChartMarkLine Max() { return ChartMarkLine.Of("max"); }
    // 显式水平线：y = yValue 处，label 支持 {value} 占位。
    public static ChartMarkLine At(int yValue, string label) {
        ChartMarkLine m = ChartMarkLine.Of("");
        m.yValue = yValue;
        m.label = label;
        return m;
    }

    // 深复制；src 为 null 时返回 null。
    public static ChartMarkLine Clone(ChartMarkLine src) {
        if (src == null) { return null; }
        ChartMarkLine m = ChartMarkLine.Of(src.kind, src.name);
        m.xValue = src.xValue; m.yValue = src.yValue; m.hasPoint = src.hasPoint;
        m.label = src.label; m.lineType = src.lineType; m.color = src.color;
        m.valueIndex = src.valueIndex;
        m.labelShow = src.labelShow; m.startArrow = src.startArrow;
        m.endArrow = src.endArrow;
        m.hasEnd = src.hasEnd; m.x2Value = src.x2Value; m.y2Value = src.y2Value;
        return m;
    }
}

public class ChartMarkPoint {
    public string kind;
    public string name;  // ECharts data 项的 name（最大值/最小值/…），tooltip 用
    public int dataIndex;
    public int xValue;
    public int yValue;
    public string label;
    public int color;  // 0 = 继承系列颜色
    public string symbol;  // ECharts symbol（"emptyCircle"/"star"/…）；"" = 默认实心圆
    public int size;  // ECharts symbolSize；sizeSet=false 时用引擎默认
    public int offX;  // ECharts symbolOffset 逐项横向偏移（px）
    public int offY;  // ECharts symbolOffset 逐项纵向偏移（px）
    public bool offSet;  // 是否声明了 symbolOffset

    // 构造"最大值"标记点（渲染时从系列窗口数据推导位置）。
    public int valueIndex;  // ECharts valueIndex：-1 = 值轴(y)，0 = x 轴标注
    public bool sizeSet;

    public static ChartMarkPoint Max() {
        return ChartMarkPoint.Max("");
    }
    // 带 name 的版本（ECharts data 项 {type:'max', name:'最大值'}）。
    public static ChartMarkPoint Max(string name) {
        return new ChartMarkPoint { kind = "max", name = name, dataIndex = 0 - 1, xValue = 0, yValue = 0, label = "", color = 0, valueIndex = 0 - 1, symbol = "", size = 0, sizeSet = false, offX = 0, offY = 0, offSet = false };
    }
    // 构造"最小值"标记点（渲染时从系列窗口数据推导位置）。
    public static ChartMarkPoint Min() {
        return ChartMarkPoint.Min("");
    }
    // 带 name 的版本（ECharts data 项 {type:'min', name:'最小值'}）。
    public static ChartMarkPoint Min(string name) {
        return new ChartMarkPoint { kind = "min", name = name, dataIndex = 0 - 1, xValue = 0, yValue = 0, label = "", color = 0, valueIndex = 0 - 1, symbol = "", size = 0, sizeSet = false, offX = 0, offY = 0, offSet = false };
    }
    // 构造显式坐标 (xValue,yValue) 的标记点并附标签。
    public static ChartMarkPoint Point(int xValue, int yValue, string label) {
        return new ChartMarkPoint { kind = "point", name = "", dataIndex = 0 - 1, xValue = xValue, yValue = yValue, label = label, color = 0, valueIndex = 0 - 1, symbol = "", size = 0, sizeSet = false, offX = 0, offY = 0, offSet = false };
    }

    // 深复制；src 为 null 时返回 null。
    public static ChartMarkPoint Clone(ChartMarkPoint src) {
        if (src == null) { return null; }
        return new ChartMarkPoint { kind = src.kind, name = src.name, dataIndex = src.dataIndex,
            xValue = src.xValue, yValue = src.yValue, label = src.label,
            color = src.color, valueIndex = src.valueIndex,
            symbol = src.symbol, size = src.size, sizeSet = src.sizeSet,
            offX = src.offX, offY = src.offY, offSet = src.offSet };
    }
}
