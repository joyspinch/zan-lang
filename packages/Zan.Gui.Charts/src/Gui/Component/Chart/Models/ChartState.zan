using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// 高性能图表路径的缓存 min/max 抽取。每个大图表
// 持有一个（类似 DataTableState）；底层数据变化时
// 调用 Invalidate()。ChartBig 惰性填充并在帧间复用。
public class ChartState {
    public int version;  // 数据变化时调用方递增（通过 Invalidate）
    public int builtVersion;  // 构建缓存时的数据版本
    public int builtW;  // 构建缓存时的控件宽度
    public int builtSeries;  // 构建缓存时的系列数量
    public int cols;  // 缓存中每个系列最宽的列数
    public int axisLo;  // 解析后的数值轴边界
    public int axisHi;
    public List<List<ChartBigColExtents>> seriesCols;  // 每系列：每个抽取列的强类型 [min, max] 实体（主表示）
    public List<List<int>> colMin;  // 兼容视图
    public List<List<int>> colMax;  // 兼容视图
    public int animationKey;  // 显式实例键（0 = legacy fallback）
    public bool animationKeySet;

    // 默认构造：入场动画用 legacy 键（5200000 + 控件宽）。
    public ChartState() {
        this.version = 1;
        this.builtVersion = 0;
        this.builtW = -1;
        this.builtSeries = -1;
        this.cols = 0;
        this.axisLo = 0;
        this.axisHi = 0;
        this.seriesCols = new List<List<ChartBigColExtents>>();
        this.colMin = new List<List<int>>();
        this.colMax = new List<List<int>>();
        this.animationKey = 0;
        this.animationKeySet = false;
    }

    // 显式实例键构造；key != 0 时入场动画键与控件宽度解耦。
    public ChartState(int key) {
        this.version = 1; this.builtVersion = 0; this.builtW = -1;
        this.builtSeries = -1; this.cols = 0; this.axisLo = 0; this.axisHi = 0;
        this.seriesCols = new List<List<ChartBigColExtents>>();
        this.colMin = new List<List<int>>(); this.colMax = new List<List<int>>();
        this.animationKey = key; this.animationKeySet = key != 0;
    }

    // 入场动画键：显式键 > 0 时用 5300000+key，否则 legacy 回退
    // 5200000+w。
    public int IntroKey(int w) {
        if (this.animationKeySet) { return ChartBig.AnimationKey(this.animationKey); }
        return 5200000 + w;
    }

    // 将缓存标记为过期，使下次渲染重新抽取源数据。
    public void Invalidate() { this.version = this.version + 1; }
}
