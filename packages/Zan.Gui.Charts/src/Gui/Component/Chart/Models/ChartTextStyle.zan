using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartTextStyle {
    public int color;
    public int fontSize;
    public string fontStyle;
    public string fontWeight;
    public string fontFamily;
    public int shadowColor;
    public int shadowBlur;
    public int shadowOffsetX;
    public int shadowOffsetY;
    public string align;
    public string verticalAlign;
    // -1 = 未声明；颜色 0 = 无。offset/blur 与 Canvas 无模糊的现实下
    // 按描边渲染（见 ChartView.DrawTextStyled）。
    public int tbColor;
    public int tbWidth;
    public int tsColor;
    public int tsBlur;
    public int tsDx;
    public int tsDy;
    public int lineHeight;  // label 级 lineHeight：段未声明自身 lineHeight 时的
                    // 行高缺省（gauge-speed detail.lineHeight 40）；
                    // -1 = 未声明
    public List<ChartRichStyle> rich;
    public int boxBg;  // label.backgroundColor（整块底板）；0 = 无
    public int boxBorder;  // label.borderColor；0 = 无
    public int boxBorderW;  // label.borderWidth；-1 未声明
    public int boxRadius;  // label.borderRadius；-1 未声明
    public int padT;  // label.padding；-1 未声明
    public int padR;
    public int padB;
    public int padL;

    // 构造默认样式：颜色 0（跟随主题）、字号 0（渲染器缺省）。
    public static ChartTextStyle Create() {
        ChartTextStyle s = new ChartTextStyle {
            color = 0, fontSize = 0, fontStyle = "normal", fontWeight = "normal",
            fontFamily = "", shadowColor = 0, shadowBlur = 0
        };
        s.tbColor = 0;
        s.tbWidth = 0 - 1;
        s.tsColor = 0;
        s.tsBlur = 0 - 1;
        s.tsDx = 0;
        s.tsDy = 0;
        s.lineHeight = 0 - 1;
        s.rich = null;
        s.boxBg = 0;
        s.boxBorder = 0;
        s.boxBorderW = 0 - 1;
        s.boxRadius = 0 - 1;
        s.padT = 0 - 1;
        s.padR = 0 - 1;
        s.padB = 0 - 1;
        s.padL = 0 - 1;
        s.shadowOffsetX = 0;
        s.shadowOffsetY = 0;
        s.align = "";
        s.verticalAlign = "";
        return s;
    }

    // 深复制；src 为 null 时返回 null。
    public static ChartTextStyle Clone(ChartTextStyle src) {
        if (src == null) { return null; }
        ChartTextStyle s = new ChartTextStyle { color = src.color, fontSize = src.fontSize,
            fontStyle = src.fontStyle, fontWeight = src.fontWeight,
            fontFamily = src.fontFamily, shadowColor = src.shadowColor,
            shadowBlur = src.shadowBlur };
        s.shadowOffsetX = src.shadowOffsetX;
        s.shadowOffsetY = src.shadowOffsetY;
        s.align = src.align;
        s.verticalAlign = src.verticalAlign;
        s.tbColor = src.tbColor;
        s.tbWidth = src.tbWidth;
        s.tsColor = src.tsColor;
        s.tsBlur = src.tsBlur;
        s.tsDx = src.tsDx;
        s.tsDy = src.tsDy;
        s.lineHeight = src.lineHeight;
        s.boxBg = src.boxBg;
        s.boxBorder = src.boxBorder;
        s.boxBorderW = src.boxBorderW;
        s.boxRadius = src.boxRadius;
        s.padT = src.padT;
        s.padR = src.padR;
        s.padB = src.padB;
        s.padL = src.padL;
        if (src.rich != null) {
            s.rich = new List<ChartRichStyle>();
            for (int i = 0; i < src.rich.Count; i = i + 1) {
                ChartRichStyle a = src.rich[i];
                ChartRichStyle b = new ChartRichStyle();
                b.name = a.name;
                b.color = a.color;
                b.fontSize = a.fontSize;
                b.fontWeight = a.fontWeight;
                b.fontFamily = a.fontFamily;
                b.tbColor = a.tbColor;
                b.tbWidth = a.tbWidth;
                b.tsColor = a.tsColor;
                b.tsBlur = a.tsBlur;
                b.tsDx = a.tsDx;
                b.tsDy = a.tsDy;
                b.align = a.align;
                b.lineHeight = a.lineHeight;
                b.backgroundColor = a.backgroundColor;
                b.bgIsImage = a.bgIsImage;
                b.borderColor = a.borderColor;
                b.borderWidth = a.borderWidth;
                b.radTL = a.radTL;
                b.radTR = a.radTR;
                b.radBR = a.radBR;
                b.radBL = a.radBL;
                b.padT = a.padT;
                b.padR = a.padR;
                b.padB = a.padB;
                b.padL = a.padL;
                b.width = a.width;
                b.height = a.height;
                s.rich.Add(b);
            }
        }
        return s;
    }
}

// 富文本段（Chart.RichTokenize 产出；ChartView.RichLayout 填排版
// 结果）。x/y/w/h 是段盒（含 padding，px）；lh 为所在行行高；
// fsPx/tw 是解析像素字号与文本净宽。
