using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class RadarIndicator {
    public string text;
    public string name;
    public int max;

    public RadarIndicator(string text, int max) {
        this.text = text != null ? text : "";
        this.name = this.text;
        this.max = max;
    }

    public static RadarIndicator Of(string text, int max) {
        return new RadarIndicator(text, max);
    }
}
