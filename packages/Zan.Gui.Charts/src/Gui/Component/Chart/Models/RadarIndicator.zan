using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class RadarIndicator {
    public string text;
    public string name;
    public int max;

    public RadarIndicator(string text, int max) {
        this.text = text != null ? text : "";
        this.name = this.text;
        this.max = max;
    }

    public static RadarIndicator Of(string text, int max) {
        return new RadarIndicator(text, max);
    }
}

// 雷达/极坐标系统（ECharts polar[]）：一个 option 可带多个
// polar，radar 系列用 polarIndex 绑定到对应坐标系。指示器
// （轴名+满刻度）、圆心/半径、起始角、环数、网格形状与
// 指示器名样式都按 polar 独立配置。
