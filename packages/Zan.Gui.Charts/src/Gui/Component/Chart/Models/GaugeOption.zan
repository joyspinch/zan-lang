    public GaugeAxisTick Clone() {
        return new GaugeAxisTick { show = this.show, splitNumber = this.splitNumber,
            length = this.length, lineStyle = this.lineStyle != null ? this.lineStyle.Clone() : null };
    }

    public static GaugeAxisTick Clone(GaugeAxisTick src) {
        if (src == null) { return null; }
        return src.Clone();
    }
}

