using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class GaugeOption {
    public ChartPosition center;
    public ChartScalar innerRadius;
    public ChartScalar radius;
    public int startAngle;
    public int endAngle;
    public int min;
    public int max;
    public int precision;
    public int splitNumber;
    public GaugeAxisLine axisLine;
    public GaugeAxisTick axisTick;
    public GaugeAxisLabel axisLabel;
    public GaugeSplitLine splitLine;
    public GaugePointer pointer;
    public GaugeProgress progress;
    public GaugeAnchor anchor;
    public GaugeTitle title;
    public GaugeDetail detail;

    // 构造默认配置：中心 50%/50%、内径 0、半径 75%、
    // 角度 225→-45、值域 0..100、precision 0、10 分割。
    public static GaugeOption Create() {
        return new GaugeOption {
            center = ChartPosition.Of(ChartScalar.Pct(50), ChartScalar.Pct(50)),
            innerRadius = ChartScalar.Px(0), radius = ChartScalar.Pct(75),
            startAngle = 225, endAngle = 0 - 45, min = 0, max = 100,
            precision = 0, splitNumber = 10,
            axisLine = GaugeAxisLine.Create(), axisTick = GaugeAxisTick.Create(),
            axisLabel = GaugeAxisLabel.Create(), splitLine = GaugeSplitLine.Create(),
            pointer = GaugePointer.Create(), progress = GaugeProgress.Create(),
            anchor = GaugeAnchor.Create(), title = GaugeTitle.Create(), detail = GaugeDetail.Create()
        };
    }

    // 深复制全部子配置；src 为 null 时返回 null。
    public static GaugeOption Clone(GaugeOption src) {
        if (src == null) { return null; }
        return new GaugeOption { center = ChartPosition.Clone(src.center),
            innerRadius = ChartScalar.Clone(src.innerRadius), radius = ChartScalar.Clone(src.radius),
            startAngle = src.startAngle, endAngle = src.endAngle, min = src.min, max = src.max,
            precision = src.precision, splitNumber = src.splitNumber,
            axisLine = GaugeAxisLine.Clone(src.axisLine), axisTick = GaugeAxisTick.Clone(src.axisTick),
            axisLabel = GaugeAxisLabel.Clone(src.axisLabel), splitLine = GaugeSplitLine.Clone(src.splitLine),
            pointer = GaugePointer.Clone(src.pointer), progress = GaugeProgress.Clone(src.progress),
            anchor = GaugeAnchor.Clone(src.anchor), title = GaugeTitle.Clone(src.title),
            detail = GaugeDetail.Clone(src.detail) };
    }
}

// 雷达坐标系指示器轴实体（消除 indicatorText / indicatorMax 平行列表反模式）。
