}

// 仪表盘标题
public class GaugeTitle {
    public bool show;
    public ChartPosition offsetCenter;
    public ChartTextStyle textStyle;

    public static GaugeTitle Create() {
        ChartTextStyle text = ChartTextStyle.Create();
        text.color = ChartColor.Rgb(84, 89, 99);
        text.fontSize = 16;
        return new GaugeTitle {
            show = true, offsetCenter = ChartPosition.Of(ChartScalar.Px(0), ChartScalar.Pct(20)),
            textStyle = text
        };
    }

    public GaugeTitle Clone() {
        return new GaugeTitle { show = this.show,
            offsetCenter = this.offsetCenter != null ? this.offsetCenter.Clone() : null,
            textStyle = this.textStyle != null ? this.textStyle.Clone() : null };
    }

    public static GaugeTitle Clone(GaugeTitle src) {
        if (src == null) { return null; }
        return src.Clone();
    }
}

// 仪表盘数值详情
public class GaugeDetail {
    public bool show;
    public int backgroundColor;
    public int borderWidth;
    public int borderColor;
    public int width;
    public int height;
    public ChartPosition offsetCenter;
    public string formatter;
    public ChartTextStyle textStyle;
    public bool valueAnimation;

    public static GaugeDetail Create() {
        ChartTextStyle text = ChartTextStyle.Create();
        text.fontSize = 30;
        return new GaugeDetail {
            show = true, backgroundColor = 0, borderWidth = 0,
            borderColor = ChartColor.Rgb(204, 204, 204), width = 100, height = 40,
            offsetCenter = ChartPosition.Of(ChartScalar.Px(0), ChartScalar.Pct(40)),
            formatter = "", textStyle = text, valueAnimation = false
        };
    }

    public GaugeDetail Clone() {
        return new GaugeDetail { show = this.show, backgroundColor = this.backgroundColor,
            borderWidth = this.borderWidth, borderColor = this.borderColor,
            width = this.width, height = this.height,
            offsetCenter = this.offsetCenter != null ? this.offsetCenter.Clone() : null, formatter = this.formatter,
            textStyle = this.textStyle != null ? this.textStyle.Clone() : null,
            valueAnimation = this.valueAnimation };
    }

    public static GaugeDetail Clone(GaugeDetail src) {
        if (src == null) { return null; }
        return src.Clone();
    }
}

// 仪表盘核心配置模型
public class GaugeOption {
    public ChartPosition center;
    public ChartScalar innerRadius;
    public ChartScalar radius;
    public int startAngle;
    public int endAngle;
    public int min;
    public int max;
    public int precision;
    public int splitNumber;
    public GaugeAxisLine axisLine;
    public GaugeAxisTick axisTick;
    public GaugeAxisLabel axisLabel;
    public GaugeSplitLine splitLine;
    public GaugePointer pointer;
    public GaugeProgress progress;
    public GaugeAnchor anchor;
    public GaugeTitle title;
    public GaugeDetail detail;

    public static GaugeOption Create() {
        return new GaugeOption {
            center = ChartPosition.Of(ChartScalar.Pct(50), ChartScalar.Pct(50)),
            innerRadius = ChartScalar.Px(0), radius = ChartScalar.Pct(75),
            startAngle = 225, endAngle = 0 - 45, min = 0, max = 100,
            precision = 0, splitNumber = 10,
            axisLine = GaugeAxisLine.Create(), axisTick = GaugeAxisTick.Create(),
            axisLabel = GaugeAxisLabel.Create(), splitLine = GaugeSplitLine.Create(),
            pointer = GaugePointer.Create(), progress = GaugeProgress.Create(),
            anchor = GaugeAnchor.Create(), title = GaugeTitle.Create(), detail = GaugeDetail.Create()
        };
    }

    public GaugeOption Clone() {
        return new GaugeOption { center = this.center != null ? this.center.Clone() : null,
            innerRadius = this.innerRadius != null ? this.innerRadius.Clone() : null, radius = this.radius != null ? this.radius.Clone() : null,
            startAngle = this.startAngle, endAngle = this.endAngle, min = this.min, max = this.max,
            precision = this.precision, splitNumber = this.splitNumber,
            axisLine = this.axisLine != null ? this.axisLine.Clone() : null, axisTick = this.axisTick != null ? this.axisTick.Clone() : null,
            axisLabel = this.axisLabel != null ? this.axisLabel.Clone() : null, splitLine = this.splitLine != null ? this.splitLine.Clone() : null,
            pointer = this.pointer != null ? this.pointer.Clone() : null, progress = this.progress != null ? this.progress.Clone() : null,
            anchor = this.anchor != null ? this.anchor.Clone() : null, title = this.title != null ? this.title.Clone() : null,
            detail = this.detail != null ? this.detail.Clone() : null };
    }

    public static GaugeOption Clone(GaugeOption src) {
        if (src == null) { return null; }
        return src.Clone();
    }
}
