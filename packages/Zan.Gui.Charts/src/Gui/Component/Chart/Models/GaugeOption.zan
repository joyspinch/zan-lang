}

// 仪表盘指针
public class GaugePointer {
    public bool show;
    public ChartScalar length;
    public int width;
    public int color;
    public int shadowColor;
    public int shadowBlur;
    public string icon;

    public static GaugePointer Create() {
        return new GaugePointer {
            show = true, length = ChartScalar.Pct(80), width = 8, color = 0, shadowColor = 0, shadowBlur = 0,
            icon = ""
        };
    }

    public static GaugePointer Clone(GaugePointer src) {
        if (src == null) { return null; }
        return new GaugePointer { show = src.show, length = ChartScalar.Clone(src.length), width = src.width,
            color = src.color, shadowColor = src.shadowColor, shadowBlur = src.shadowBlur,
            icon = src.icon };
    }
}

// 仪表盘进度弧
public class GaugeProgress {
    public bool show;
    public bool overlap;
    public int width;
    public bool roundCap;
    public int color;

    public static GaugeProgress Create() {
        return new GaugeProgress {
            show = false, overlap = true, width = 0, roundCap = false, color = 0
        };
    }

    public static GaugeProgress Clone(GaugeProgress src) {
        if (src == null) { return null; }
        return new GaugeProgress {
            show = src.show, overlap = src.overlap, width = src.width,
            roundCap = src.roundCap, color = src.color
        };
    }
}

// 仪表盘指针固定点
public class GaugeAnchor {
    public bool show;
    public bool showAbove;
    public int size;
    public int color;
    public int borderColor;
    public int borderWidth;
    public string icon;

    public static GaugeAnchor Create() {
        return new GaugeAnchor {
            show = false, showAbove = false, size = 6,
            color = 0, borderColor = 0, borderWidth = 0, icon = ""
        };
    }

    public static GaugeAnchor Clone(GaugeAnchor src) {
        if (src == null) { return null; }
        return new GaugeAnchor {
            show = src.show, showAbove = src.showAbove, size = src.size,
            color = src.color, borderColor = src.borderColor, borderWidth = src.borderWidth,
            icon = src.icon
        };
    }
}

// 仪表盘标题
public class GaugeTitle {
    public bool show;
    public ChartPosition offsetCenter;
    public ChartTextStyle textStyle;

    public static GaugeTitle Create() {
        ChartTextStyle text = ChartTextStyle.Create();
        text.color = ChartColor.Rgb(84, 89, 99);
        text.fontSize = 16;
        return new GaugeTitle {
            show = true, offsetCenter = ChartPosition.Of(ChartScalar.Px(0), ChartScalar.Pct(20)),
            textStyle = text
        };
    }

    public static GaugeTitle Clone(GaugeTitle src) {
        if (src == null) { return null; }
        return new GaugeTitle { show = src.show,
            offsetCenter = ChartPosition.Clone(src.offsetCenter),
            textStyle = ChartTextStyle.Clone(src.textStyle) };
    }
}

// 仪表盘数值详情
public class GaugeDetail {
    public bool show;
    public int backgroundColor;
    public int borderWidth;
    public int borderColor;
    public int width;
    public int height;
    public ChartPosition offsetCenter;
    public string formatter;
    public ChartTextStyle textStyle;
    public bool valueAnimation;

    public static GaugeDetail Create() {
        ChartTextStyle text = ChartTextStyle.Create();
        text.fontSize = 30;
        return new GaugeDetail {
            show = true, backgroundColor = 0, borderWidth = 0,
            borderColor = ChartColor.Rgb(204, 204, 204), width = 100, height = 40,
            offsetCenter = ChartPosition.Of(ChartScalar.Px(0), ChartScalar.Pct(40)),
            formatter = "", textStyle = text, valueAnimation = false
        };
    }

    public static GaugeDetail Clone(GaugeDetail src) {
        if (src == null) { return null; }
        return new GaugeDetail { show = src.show, backgroundColor = src.backgroundColor,
            borderWidth = src.borderWidth, borderColor = src.borderColor,
            width = src.width, height = src.height,
            offsetCenter = ChartPosition.Clone(src.offsetCenter), formatter = src.formatter,
            textStyle = ChartTextStyle.Clone(src.textStyle),
            valueAnimation = src.valueAnimation };
    }
}

// 仪表盘核心配置模型
public class GaugeOption {
    public ChartPosition center;
    public ChartScalar innerRadius;
    public ChartScalar radius;
    public int startAngle;
    public int endAngle;
    public int min;
    public int max;
    public int precision;
    public int splitNumber;
    public GaugeAxisLine axisLine;
    public GaugeAxisTick axisTick;
    public GaugeAxisLabel axisLabel;
    public GaugeSplitLine splitLine;
    public GaugePointer pointer;
    public GaugeProgress progress;
    public GaugeAnchor anchor;
    public GaugeTitle title;
    public GaugeDetail detail;

    public static GaugeOption Create() {
        return new GaugeOption {
            center = ChartPosition.Of(ChartScalar.Pct(50), ChartScalar.Pct(50)),
            innerRadius = ChartScalar.Px(0), radius = ChartScalar.Pct(75),
            startAngle = 225, endAngle = 0 - 45, min = 0, max = 100,
            precision = 0, splitNumber = 10,
            axisLine = GaugeAxisLine.Create(), axisTick = GaugeAxisTick.Create(),
            axisLabel = GaugeAxisLabel.Create(), splitLine = GaugeSplitLine.Create(),
            pointer = GaugePointer.Create(), progress = GaugeProgress.Create(),
            anchor = GaugeAnchor.Create(), title = GaugeTitle.Create(), detail = GaugeDetail.Create()
        };
    }

    public static GaugeOption Clone(GaugeOption src) {
        if (src == null) { return null; }
        return new GaugeOption { center = ChartPosition.Clone(src.center),
            innerRadius = ChartScalar.Clone(src.innerRadius), radius = ChartScalar.Clone(src.radius),
            startAngle = src.startAngle, endAngle = src.endAngle, min = src.min, max = src.max,
            precision = src.precision, splitNumber = src.splitNumber,
            axisLine = GaugeAxisLine.Clone(src.axisLine), axisTick = GaugeAxisTick.Clone(src.axisTick),
            axisLabel = GaugeAxisLabel.Clone(src.axisLabel), splitLine = GaugeSplitLine.Clone(src.splitLine),
            pointer = GaugePointer.Clone(src.pointer), progress = GaugeProgress.Clone(src.progress),
            anchor = GaugeAnchor.Clone(src.anchor), title = GaugeTitle.Clone(src.title),
            detail = GaugeDetail.Clone(src.detail) };
    }
}
