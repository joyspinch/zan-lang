using System;
using System.Json;
using System.Text;
using Gui;

namespace Gui.Component.Chart;

// 仪表盘色带停靠点
public class GaugeColorStop {
    public int stop;
    public int color;

    public static GaugeColorStop Of(int stop, int color) {
        return new GaugeColorStop { stop = stop, color = color };
    }

    // 面向对象深复制实例方法。
    public GaugeColorStop Clone() {
        return GaugeColorStop.Of(this.stop, this.color);
    }

    public static GaugeColorStop Clone(GaugeColorStop src) {
        if (src == null) { return null; }
        return src.Clone();
    }
}

// 仪表盘轴线
public class GaugeAxisLine {
    public bool show;
    public ChartLineStyle lineStyle;
    public List<GaugeColorStop> colors;

    public static GaugeAxisLine Create() {
        GaugeAxisLine a = new GaugeAxisLine {
            show = true, lineStyle = ChartLineStyle.Of(0, 10), colors = new List<GaugeColorStop>()
        };
        a.colors.Add(GaugeColorStop.Of(200, ChartColor.Rgb(34, 139, 34)));
        a.colors.Add(GaugeColorStop.Of(800, ChartColor.Rgb(68, 136, 187)));
        a.colors.Add(GaugeColorStop.Of(1000, ChartColor.Rgb(255, 69, 0)));
        return a;
    }

    public GaugeAxisLine Clone() {
        GaugeAxisLine a = new GaugeAxisLine { show = this.show,
            lineStyle = this.lineStyle != null ? this.lineStyle.Clone() : null, colors = new List<GaugeColorStop>() };
        if (this.colors != null) {
            for (int i = 0; i < this.colors.Count; i = i + 1) {
                GaugeColorStop cs = this.colors[i];
                a.colors.Add(cs != null ? cs.Clone() : null);
            }
        }
        return a;
    }

    public static GaugeAxisLine Clone(GaugeAxisLine src) {
        if (src == null) { return null; }
        return src.Clone();
    }
}

