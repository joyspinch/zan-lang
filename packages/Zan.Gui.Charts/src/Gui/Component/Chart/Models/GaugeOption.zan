using System;
using System.Json;
using System.Text;
using Gui;

namespace Gui.Component.Chart;

// 仪表盘色带停靠点
public class GaugeColorStop {
    public int stop;
    public int color;

    public static GaugeColorStop Of(int stop, int color) {
        return new GaugeColorStop { stop = stop, color = color };
    }

    public static GaugeColorStop Clone(GaugeColorStop src) {
        if (src == null) { return null; }
        return GaugeColorStop.Of(src.stop, src.color);
    }
}

// 仪表盘轴线
public class GaugeAxisLine {
    public bool show;
    public ChartLineStyle lineStyle;
    public List<GaugeColorStop> colors;

    public static GaugeAxisLine Create() {
        GaugeAxisLine a = new GaugeAxisLine {
            show = true, lineStyle = ChartLineStyle.Of(0, 10), colors = new List<GaugeColorStop>()
        };
        a.colors.Add(GaugeColorStop.Of(200, ChartColor.Rgb(34, 139, 34)));
        a.colors.Add(GaugeColorStop.Of(800, ChartColor.Rgb(68, 136, 187)));
        a.colors.Add(GaugeColorStop.Of(1000, ChartColor.Rgb(255, 69, 0)));
        return a;
    }

    public static GaugeAxisLine Clone(GaugeAxisLine src) {
        if (src == null) { return null; }
        GaugeAxisLine a = new GaugeAxisLine { show = src.show,
            lineStyle = ChartLineStyle.Clone(src.lineStyle), colors = new List<GaugeColorStop>() };
        if (src.colors != null) {
            for (int i = 0; i < src.colors.Count; i = i + 1) {
                a.colors.Add(GaugeColorStop.Clone(src.colors[i]));
            }
        }
        return a;
    }
}

// 仪表盘刻度
public class GaugeAxisTick {
    public bool show;
    public int splitNumber;
    public int length;
    public ChartLineStyle lineStyle;

    public static GaugeAxisTick Create() {
        return new GaugeAxisTick {
            show = true, splitNumber = 5, length = 6,
            lineStyle = ChartLineStyle.Of(ChartColor.Rgb(200, 203, 210), 1)
        };
    }

    public static GaugeAxisTick Clone(GaugeAxisTick src) {
        if (src == null) { return null; }
        return new GaugeAxisTick { show = src.show, splitNumber = src.splitNumber,
            length = src.length, lineStyle = ChartLineStyle.Clone(src.lineStyle) };
    }
}

// 仪表盘轴标签
public class GaugeAxisLabel {
    public bool show;
    public string formatter;
    public ChartTextStyle textStyle;

    public static GaugeAxisLabel Create() {
        return new GaugeAxisLabel { show = true, formatter = "", textStyle = ChartTextStyle.Create() };
    }

    public static GaugeAxisLabel Clone(GaugeAxisLabel src) {
        if (src == null) { return null; }
        return new GaugeAxisLabel { show = src.show, formatter = src.formatter,
            textStyle = ChartTextStyle.Clone(src.textStyle) };
    }
}

// 仪表盘分隔线
public class GaugeSplitLine {
    public bool show;
    public int length;
    public ChartLineStyle lineStyle;

    public static GaugeSplitLine Create() {
        return new GaugeSplitLine {
            show = true, length = 10,
            lineStyle = ChartLineStyle.Of(ChartColor.Rgb(180, 184, 192), 3)
        };
    }

    public static GaugeSplitLine Clone(GaugeSplitLine src) {
        if (src == null) { return null; }
        return new GaugeSplitLine { show = src.show, length = src.length,
            lineStyle = ChartLineStyle.Clone(src.lineStyle) };
