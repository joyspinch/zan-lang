// 仪表盘指针
public class GaugePointer {
    public bool show;
    public ChartScalar length;
    public int width;
    public int color;
    public int shadowColor;
    public int shadowBlur;
    public string icon;

    public static GaugePointer Create() {
        return new GaugePointer {
            show = true, length = ChartScalar.Pct(80), width = 8, color = 0, shadowColor = 0, shadowBlur = 0,
            icon = ""
        };
    }

    public GaugePointer Clone() {
        return new GaugePointer { show = this.show, length = this.length != null ? this.length.Clone() : null, width = this.width,
            color = this.color, shadowColor = this.shadowColor, shadowBlur = this.shadowBlur,
            icon = this.icon };
    }

    public static GaugePointer Clone(GaugePointer src) {
        if (src == null) { return null; }
        return src.Clone();
    }
}

