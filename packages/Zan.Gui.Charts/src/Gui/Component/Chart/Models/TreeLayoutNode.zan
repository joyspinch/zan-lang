using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// 树形图布局的中间记录：节点 + 深度 + 叶子 span 起点
// （见 ChartView.TreeAssign）。
public class TreeLayoutNode {
    public ChartNode node;
    public int depth;
    public int lo;
    public int count;

    // 构造布局记录：node/depth/lo/count 全按参数记录
    // （count = 子树叶子槽位数，由调用方传入）。
    public static TreeLayoutNode Of(ChartNode node, int depth, int lo, int count) {
        TreeLayoutNode layout = new TreeLayoutNode();
        layout.node = node;
        layout.depth = depth;
        layout.lo = lo;
        layout.count = count;
        return layout;
    }
}
