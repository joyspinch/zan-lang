using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

class ChartMapRegion {
    string name;
    int value;
    int color;  // 0 = 由 value 映射到连续色域
    List<ChartMapRing> rings;

    // 构造地图区域（颜色由 value 映射到连续色域）。
    static ChartMapRegion Of(string name, int value, List<ChartMapRing> rings) {
        ChartMapRegion r = new ChartMapRegion();
        r.name = name; r.value = value; r.color = 0; r.rings = rings;
        return r;
    }
    // 构造带显式颜色的地图区域（不参与值→色映射）。
    static ChartMapRegion Colored(string name, int value, int color, List<ChartMapRing> rings) {
        ChartMapRegion r = ChartMapRegion.Of(name, value, rings);
        r.color = color;
        return r;
    }

    // 深复制全部环与顶点；src 为 null 时返回 null。
    static ChartMapRegion Clone(ChartMapRegion src) {
        if (src == null) { return null; }
        List<ChartMapRing> rings = new List<ChartMapRing>();
        for (int i = 0; i < src.rings.Count; i = i + 1) {
            ChartMapRing sr = src.rings[i];
            List<ChartMapPoint> points = new List<ChartMapPoint>();
            for (int j = 0; j < sr.points.Count; j = j + 1) {
                points.Add(ChartMapPoint.Of(sr.points[j].x, sr.points[j].y));
            }
            rings.Add(ChartMapRing.Of(points, sr.hole));
        }
        return ChartMapRegion.Colored(src.name, src.value, src.color, rings);
    }
}

// ECharts geo 组件：一张底图地图 + 按名区域覆盖。解析后由
// FromJsonValue 的合成块折算成 isGeoBase 的 type=Map 载体系列
// （几何经 ChartMaps.BindSeries 注入）。
