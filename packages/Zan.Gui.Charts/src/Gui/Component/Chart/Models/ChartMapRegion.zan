using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartMapPoint {
    public int x;
    public int y;

    // 构造一个地图多边形顶点。
    public static ChartMapPoint Of(int x, int y) { return new ChartMapPoint { x = x, y = y }; }
}

public class ChartMapRing {
    public List<ChartMapPoint> points;
    public bool hole;

    // 构造一条环；points 至少 3 个才被 JSON 解析接受。
    public static ChartMapRing Of(List<ChartMapPoint> points, bool hole) {
        return new ChartMapRing { points = points, hole = hole };
    }
}


public class ChartMapRegion {
    public string name;
    public int value;
    public int color;  // 0 = 由 value 映射到连续色域
    public List<ChartMapRing> rings;

    // 构造地图区域（颜色由 value 映射到连续色域）。
    public static ChartMapRegion Of(string name, int value, List<ChartMapRing> rings) {
        ChartMapRegion r = new ChartMapRegion();
        r.name = name; r.value = value; r.color = 0; r.rings = rings;
        return r;
    }
    // 构造带显式颜色的地图区域（不参与值→色映射）。
    public static ChartMapRegion Colored(string name, int value, int color, List<ChartMapRing> rings) {
        ChartMapRegion r = ChartMapRegion.Of(name, value, rings);
        r.color = color;
        return r;
    }

    // 深复制全部环与顶点；src 为 null 时返回 null。
    // 面向对象深复制实例方法。

    public ChartMapRegion Clone() {

        return ChartMapRegion.Clone(this);

    }


    public static ChartMapRegion Clone(ChartMapRegion src) {
        if (src == null) { return null; }
        List<ChartMapRing> rings = new List<ChartMapRing>();
        for (int i = 0; i < src.rings.Count; i = i + 1) {
            ChartMapRing sr = src.rings[i];
            List<ChartMapPoint> points = new List<ChartMapPoint>();
            for (int j = 0; j < sr.points.Count; j = j + 1) {
                points.Add(ChartMapPoint.Of(sr.points[j].x, sr.points[j].y));
            }
            rings.Add(ChartMapRing.Of(points, sr.hole));
        }
        return ChartMapRegion.Colored(src.name, src.value, src.color, rings);
    }
}

// 已注册地图：echarts registerMap 的对应物。
public class ChartMapEntry {
    public string name;
    public string svg;
    public double vx;
    public double vy;
    public double vw;
    public double vh;
    public bool scanned;
    public List<ChartMapRegion> regions;

    public static ChartMapEntry Of(string name) {
        ChartMapEntry e = new ChartMapEntry();
        e.name = name;
        e.svg = "";
        e.scanned = false;
        e.regions = new List<ChartMapRegion>();
        return e;
    }
}
