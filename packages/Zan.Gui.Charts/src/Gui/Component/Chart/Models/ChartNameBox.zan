using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// 轴名占据的像素盒（用于给绘图区让出上下栏）。rot=-90 的行盒
    // （tw x fh）绕 (ax, ay) 逆时针转 90° 后占 x∈[ax,ax+fh]、
    // y∈[ay-tw, ay]（见 AxisNameY 的推导），故 y 区间以 ay 为下界。
    public class ChartNameBox {
        public int left;
        public int top;
        public int right;
        public int bottom;
    }
