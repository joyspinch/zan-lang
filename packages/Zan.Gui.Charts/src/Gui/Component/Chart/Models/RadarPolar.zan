using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

// 极坐标轴规格（angleAxis / radiusAxis）
public class PolarAxisSpec {
    public bool isAngle;
    public ChartAxisType type;
    public int polarIndex;
    public int min;
    public int max;
    public bool minSet;
    public bool maxSet;
    public int startAngle;
    public int endAngle;
    public bool endAngleSet;
    public bool clockwise;
    public bool boundaryGap;
    public List<string> cats;

    public static PolarAxisSpec Of(bool angle) {
        PolarAxisSpec a = new PolarAxisSpec();
        a.isAngle = angle;
        a.type = ChartAxisType.Value;
        a.polarIndex = 0;
        a.min = ChartOption.Auto();
        a.max = ChartOption.Auto();
        a.minSet = false; a.maxSet = false;
        a.startAngle = 90;
        a.endAngle = 0;
        a.endAngleSet = false;
        a.clockwise = true;
        a.boundaryGap = true;
        a.cats = new List<string>();
        return a;
    }

    public PolarAxisSpec Clone() {
        PolarAxisSpec a = PolarAxisSpec.Of(this.isAngle);
        a.type = this.type;
        a.polarIndex = this.polarIndex;
        a.min = this.min; a.max = this.max;
        a.minSet = this.minSet; a.maxSet = this.maxSet;
        a.startAngle = this.startAngle;
        a.endAngle = this.endAngle;
        a.endAngleSet = this.endAngleSet;
        a.clockwise = this.clockwise;
        a.boundaryGap = this.boundaryGap;
        if (this.cats != null) {
            for (int i = 0; i < this.cats.Count; i = i + 1) { a.cats.Add(this.cats[i]); }
        }
        return a;
    }

    public static PolarAxisSpec Clone(PolarAxisSpec src) {
        if (src == null) { return null; }
        return src.Clone();
    }
}

public class RadarIndicator {
    public string text;
    public string name;
    public int max;

    public RadarIndicator(string text, int max) {
        this.text = text != null ? text : "";
        this.name = this.text;
        this.max = max;
    }

    public static RadarIndicator Of(string text, int max) {
        return new RadarIndicator(text, max);
    }
}

// 雷达极坐标指示器样式实体（消除 pnameCol / pnameFmt 平行列表反模式）。
public class PolarNameStyle {
    public int color;
    public string format;

    public PolarNameStyle(int color, string format) {
        this.color = color;
        this.format = format;
    }
}


public class RadarPolar {
    public List<RadarIndicator> indicators;  // 每轴指示器强类型实体列表（主表示）
    public List<string> indicatorText;  // 指示器名称投影列表
    public List<int> indicatorMax;  // 指示器最大值投影列表
    public ChartPosition center;  // 圆心（% 相对面板宽高 / px）；null = 单 polar 自动居中
    public ChartScalar radius;  // 外径（% 相对 min(areaW,areaH)/2 / px）；0 = 自动
    public ChartScalar radiusInner;  // 内径（polar.radius:[30,'80%'] 的首元）；
                                // Px(0) = 从圆心起（ECharts 缺省 [0,'80%']）
    public int startAngle;  // 第一轴的数学角（90 = 正上，ECharts 默认）
    public int splitNumber;  // 环数；0 = 4（与单 polar 现状一致）
    public string type;  // "" / "circle" / "polygon"；"" = 跟全局 radarShape
    public int nameColor;  // 指示器名颜色；0 = 主主题轴色
    public string nameFormat;  // 指示器名模板（ECharts name.formatter 字符串版，
                                // "{value}" 占位；"" = 原名）
    public int axisLineColor;  // 轴线颜色；0 = 主题网格色
    public int axisLineWidth;  // 轴线宽；0 = 1
    public int splitLineColor;  // 分隔环线颜色；0 = 主题网格色
    public int splitLineWidth;  // 分隔环线宽；0 = 1
    public List<int> splitAreaColors;  // 环带交替色（约 30% 透明绘制）；空 = 跟全局

    public static RadarPolar Create() {
        RadarPolar p = new RadarPolar {
            indicators = new List<RadarIndicator>(),
            indicatorText = new List<string>(),
            indicatorMax = new List<int>(),
            center = null, radius = ChartScalar.Px(0),
            radiusInner = ChartScalar.Px(0), startAngle = 90,
            splitNumber = 0, type = "", nameColor = 0, nameFormat = "",
            axisLineColor = 0, axisLineWidth = 0, splitLineColor = 0,
            splitLineWidth = 0, splitAreaColors = new List<int>()
        };
        return p;
    }

    // 面向对象深复制实例方法。
    public RadarPolar Clone() {
        RadarPolar p = new RadarPolar {
            indicators = new List<RadarIndicator>(),
            indicatorText = new List<string>(),
            indicatorMax = new List<int>(),
            center = this.center != null ? this.center.Clone() : null,
            radius = this.radius != null ? this.radius.Clone() : null,
            radiusInner = this.radiusInner != null ? this.radiusInner.Clone() : null,
            startAngle = this.startAngle, splitNumber = this.splitNumber,
            type = this.type, nameColor = this.nameColor, nameFormat = this.nameFormat,
            axisLineColor = this.axisLineColor, axisLineWidth = this.axisLineWidth,
            splitLineColor = this.splitLineColor, splitLineWidth = this.splitLineWidth,
            splitAreaColors = new List<int>()
        };
        if (this.indicators != null) {
            for (int i = 0; i < this.indicators.Count; i = i + 1) {
                p.indicators.Add(new RadarIndicator(this.indicators[i].text, this.indicators[i].max));
            }
        }
        if (this.indicatorText != null) {
            for (int i = 0; i < this.indicatorText.Count; i = i + 1) {
                p.indicatorText.Add(this.indicatorText[i]);
            }
        }
        if (this.indicatorMax != null) {
            for (int i = 0; i < this.indicatorMax.Count; i = i + 1) {
                p.indicatorMax.Add(this.indicatorMax[i]);
            }
        }
        if (this.splitAreaColors != null) {
            for (int i = 0; i < this.splitAreaColors.Count; i = i + 1) {
                p.splitAreaColors.Add(this.splitAreaColors[i]);
            }
        }
        return p;
    }

    public static RadarPolar Clone(RadarPolar src) {
        if (src == null) { return null; }
        return src.Clone();
    }
}
