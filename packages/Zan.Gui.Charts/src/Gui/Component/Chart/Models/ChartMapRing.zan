using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartMapRing {
    public List<ChartMapPoint> points;
    public bool hole;

    // 构造一条环；points 至少 3 个才被 JSON 解析接受。
    public static ChartMapRing Of(List<ChartMapPoint> points, bool hole) {
        return new ChartMapRing { points = points, hole = hole };
    }
}

// 地图区域：名称、值（驱动连续色域）、可选颜色和多条环
// （单环=单部件；多外环=多部件；hole=true 的环减去面积）。
