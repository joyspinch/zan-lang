using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartCalendarSpec {
    public int rangeT0;  // 起始天序
    public int rangeT1;  // 结束天序（含）
    public bool vertical;  // orient == "vertical"
    public int cellW;  // 单元格宽 px；-1 = auto（按容器等分）
    public int cellH;  // 单元格高 px；-1 = auto
    public int leftPx; public int rightPx; public int topPx; public int bottomPx;
    public bool hasLeft; public bool hasRight; public bool hasTop; public bool hasBottom;
    public bool leftCenter; public bool rightCenter; public bool topCenter; public bool bottomCenter;
    public int widthPx; public int heightPx;  // 显式 width/height（-1 = 未声明）

    // ---- 三种刻度文字（官方默认全部 show:true）----
    public bool showDayLabel;    public int dayMargin;    public string dayPos;  // "start"/"end"
    public int dayFirstDay;      public string dayNameMap;  public int dayColor;   public int dayFontSize;
    public bool showMonthLabel;  public int monthMargin;  public string monthPos;  public string monthAlign;
    public string monthNameMap;  public int monthColor;   public int monthFontSize;
    public bool showYearLabel;   public int yearMargin;   public string yearPos;
    public string yearFormatter; public int yearColor;    public int yearFontSize;

    // ---- 网格/格线 ----
    public bool showSplitLine;   public int splitColor;   public int splitWidth;
    public int itemColor;        public int itemBorderWidth; public int itemBorderColor;

    public static ChartCalendarSpec Of() {
        ChartCalendarSpec c = new ChartCalendarSpec();
        c.rangeT0 = 0; c.rangeT1 = 0;
        c.vertical = false;
        c.cellW = 0 - 1; c.cellH = 0 - 1;
        // 官方 CalendarModel.defaultOption: left 80, top 60
        c.leftPx = 80; c.rightPx = 0 - 1; c.topPx = 60; c.bottomPx = 0 - 1;
        c.hasLeft = true; c.hasRight = false; c.hasTop = true; c.hasBottom = false;
        c.leftCenter = false; c.rightCenter = false;
        c.topCenter = false; c.bottomCenter = false;
        c.widthPx = 0 - 1; c.heightPx = 0 - 1;

        c.showDayLabel = true; c.dayMargin = 10; c.dayPos = "start";
        c.dayFirstDay = 0; c.dayNameMap = ""; c.dayColor = 0; c.dayFontSize = 12;
        c.showMonthLabel = true; c.monthMargin = 10; c.monthPos = "start";
        c.monthAlign = "center"; c.monthNameMap = ""; c.monthColor = 0;
        c.monthFontSize = 12;
        c.showYearLabel = true; c.yearMargin = 30; c.yearPos = "";
        c.yearFormatter = ""; c.yearColor = 0; c.yearFontSize = 20;

        c.showSplitLine = true; c.splitColor = 0; c.splitWidth = 1;
        c.itemColor = 0; c.itemBorderWidth = 1; c.itemBorderColor = 0;
        return c;
    }
}

// 矩阵轴向网格节点实体（取代 xText/xLevel/xFirst/xSpan/xKind/xSizes 与 y 轴对应平行列表）
