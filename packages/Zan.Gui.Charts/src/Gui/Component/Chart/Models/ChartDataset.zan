using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartDataset {
    public List<ChartDimension> dimensions;
    public List<string> cats;  // 可选的 x 轴分类标签（可为空）

    // 构造数据集（cats 初始为空，用 Labels() 的 1..N 兜底）。
    public static ChartDataset Of(List<ChartDimension> dimensions) {
        ChartDataset d = new ChartDataset();
        d.dimensions = dimensions;
        d.cats = new List<string>();
        return d;
    }

    // 构造数据集并附带显式 x 轴分类标签。
    public static ChartDataset WithCats(List<ChartDimension> dimensions,
                                 List<string> cats) {
        ChartDataset d = ChartDataset.Of(dimensions);
        d.cats = cats;
        return d;
    }

    // 行数 = 第一维度的值数；无维度时为 0。
    public int RowCount() {
        if (this.dimensions.Count == 0) { return 0; }
        return this.dimensions[0].values.Count;
    }

    // 按名称查找维度的索引，不存在返回 -1。
    public int DimOf(string name) {
        for (int i = 0; i < this.dimensions.Count; i = i + 1) {
            if (this.dimensions[i].name == name) { return i; }
        }
        return 0 - 1;
    }

    // x 轴分类标签：给定 `cats` 时用显式值，否则
    // 用字符串形式的 1..RowCount。
    public List<string> Labels() {
        if (this.cats.Count > 0) { return this.cats; }
        List<string> outp = new List<string>();
        int n = this.RowCount();
        for (int i = 0; i < n; i = i + 1) { outp.Add(Convert.ToString(i + 1)); }
        return outp;
    }

    // 从一组数值维度（按索引）构建 ChartOption。
    // 系列名取自维度名；颜色从主题自动解析。
    public ChartOption EncodeBy(string title, List<int> yDims, ChartType type) {
        List<ChartSeries> ser = new List<ChartSeries>();
        for (int i = 0; i < yDims.Count; i = i + 1) {
            int d = yDims[i];
            if (d >= 0 && d < this.dimensions.Count) {
                ChartDimension dim = this.dimensions[d];
                ser.Add(ChartSeries.Of(dim.name, type, dim.values));
            }
        }
        ChartOption o = ChartOption.Of(ser);
        o.title = title;
        o.Categories(this.Labels());
        return o;
    }

    // 同 EncodeBy，但按名称选择维度。
    public ChartOption EncodeNamed(string title, List<string> yNames, ChartType type) {
        List<int> yd = new List<int>();
        for (int i = 0; i < yNames.Count; i = i + 1) {
            int d = this.DimOf(yNames[i]);
            if (d >= 0) { yd.Add(d); }
        }
        return this.EncodeBy(title, yd, type);
    }
}
