using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// 弦图的一条 ribbon（布局输出）：源/目标节点子弧的中心角与端点。
public class ChordRibbon {
    public int from;  // 节点下标
    public int to;
    public int val;
    public int srcAngle;  // 源节点上该 link 的子弧中心角
    public int dstAngle;  // 目标节点上该 link 的子弧中心角
    public int srcA0;
    public int srcA1;
    public int dstA0;
    public int dstA1;

    // 构造一条 ribbon；子弧范围退化为中心角单点（OfSpan 的简式）。
    public static ChordRibbon Of(int from, int to, int val, int srcAngle, int dstAngle) {
        return ChordRibbon.OfSpan(from, to, val, srcAngle, dstAngle,
            srcAngle, srcAngle, dstAngle, dstAngle);
    }

    // 构造一条 ribbon；val 为流量值，src/dstAngle 为源/目标子弧
    // 中心角，srcA0/srcA1、dstA0/dstA1 为对应子弧起止角。
    public static ChordRibbon OfSpan(int from, int to, int val, int srcAngle, int dstAngle,
                                     int srcA0, int srcA1, int dstA0, int dstA1) {
        ChordRibbon r = new ChordRibbon();
        r.from = from;
        r.to = to;
        r.val = val;
        r.srcAngle = srcAngle;
        r.dstAngle = dstAngle;
        r.srcA0 = srcA0;
        r.srcA1 = srcA1;
        r.dstA0 = dstA0;
        r.dstA1 = dstA1;
        return r;
    }
}
