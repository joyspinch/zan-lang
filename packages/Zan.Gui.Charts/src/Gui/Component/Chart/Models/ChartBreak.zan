using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartBreak {
    // ECharts axis.breaks 一项（axisCommonTypes.ts AxisBreakOption）：
    // [start,end] 是数据空间声明域（time 轴 = epoch 毫秒），gap 是断带
    // 占据的像素份额——'1.5%' 字符串 = tpPrct（占比），数值 = tpAbs
    // （绝对数据单位）。gapReal 在量程定型后解算（breakImpl.ts
    // updateAxisBreakGapReal）：占比断带按 Σprct / (1-Σprct) × S 分摊，
    // S = 外层数据跨度 − Σ(断带数据跨度)。
    public double startD;  // epoch-ms / 数据值（double：类目序号也可能小数）
    public double endD;
    public bool gapPrct;  // gapParsed.type == 'tpPrct'
    public double gapVal;  // prct = 0..1；abs = 数据单位

    public static ChartBreak Of() {
        ChartBreak b = new ChartBreak();
        b.startD = 0.0; b.endD = 0.0;
        b.gapPrct = false; b.gapVal = 0.0;
        return b;
    }

    // 面向对象深复制实例方法。
    public ChartBreak Clone() {
        ChartBreak b = new ChartBreak();
        b.startD = this.startD; b.endD = this.endD;
        b.gapPrct = this.gapPrct; b.gapVal = this.gapVal;
        return b;
    }

    public static ChartBreak Clone(ChartBreak src) {
        if (src == null) { return null; }
        return src.Clone();
    }
}

public class ChartBreakResolved {
    public ChartBreak item;
    public double gapReal;

    public ChartBreakResolved(ChartBreak item, double gapReal) {
        this.item = item;
        this.gapReal = gapReal;
    }

    public static ChartBreakResolved Of(ChartBreak item, double gapReal) {
        return new ChartBreakResolved(item, gapReal);
    }
}

// 强类型断轴解算项实体：将单断带配置与其实际 gapReal 像素/数据跨度绑定，消除平行列表反模式。
public class ChartBreakResolvedItem {
    public ChartBreak brk;
    public double gapReal;

    public ChartBreakResolvedItem(ChartBreak brk, double gapReal) {
        this.brk = brk;
        this.gapReal = gapReal;
    }

    public static ChartBreakResolvedItem Of(ChartBreak brk, double gapReal) {
        return new ChartBreakResolvedItem(brk, gapReal);
    }
}
