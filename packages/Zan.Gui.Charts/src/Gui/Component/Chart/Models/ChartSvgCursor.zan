using System;

namespace Gui.Component.Chart;

// 文本区间数字游标：SVG 属性/路径里的十进制数流（分隔符任意，
// 负号直接拼在前一个数后也是新数，如 "10-5" = [10, -5]）。
public class ChartSvgCursor {
    public string s;
    public int i;
    public int to;
    public bool any;  // 最近一次 NextNum 是否真的读到数字

    public static ChartSvgCursor Of(string s, int from, int to) {
        ChartSvgCursor c = new ChartSvgCursor();
        c.s = s;
        c.i = from;
        c.to = to;
        return c;
    }

    // 是否还有非分隔符字符可读。
    public bool HasMore() {
        this.SkipSep();
        return this.i < this.to;
    }

    // 越过空白/逗号后返回下一个字符（到尾返回 0），不推进。
    public int Peek() {
        this.SkipSep();
        if (this.i < this.to) { return this.s[this.i]; }
        return 0;
    }

    // 读一个带符号十进制数（含指数），推进游标；无数字时
    // any=false 并返回 0（游标原地不动）。
    public double NextNum() {
        this.SkipSep();
        this.any = false;
        int n = this.to;
        int start = this.i;
        if (this.i < n && (this.s[this.i] == 43 || this.s[this.i] == 45)) {
            this.i = this.i + 1;
        }
        while (this.i < n && this.s[this.i] >= 48 && this.s[this.i] <= 57) {
            this.i = this.i + 1;
            this.any = true;
        }
        if (this.i < n && this.s[this.i] == 46) {
            this.i = this.i + 1;
            while (this.i < n && this.s[this.i] >= 48 && this.s[this.i] <= 57) {
                this.i = this.i + 1;
                this.any = true;
            }
        }
        if (this.any && this.i < n && (this.s[this.i] == 101 || this.s[this.i] == 69)) {
            int save = this.i;
            this.i = this.i + 1;
            if (this.i < n && (this.s[this.i] == 43 || this.s[this.i] == 45)) {
                this.i = this.i + 1;
            }
            bool expAny = false;
            while (this.i < n && this.s[this.i] >= 48 && this.s[this.i] <= 57) {
                this.i = this.i + 1;
                expAny = true;
            }
            if (!expAny) { this.i = save; }
        }
        if (!this.any) { return 0.0; }
        return ChartSvgCursor.ParseDouble(this.s, start, this.i);
    }

    public void SkipSep() {
        while (this.i < this.to) {
            int ch = this.s[this.i];
            if (ch == 32 || ch == 44 || ch == 9 || ch == 10 || ch == 13) {
                this.i = this.i + 1;
                continue;
            }
            break;
        }
    }

    // [start,end) 十进制串 → double（手写，免逐数 JSON 开销；
    // 1e308 内安全，指数钳 300）。
    public static double ParseDouble(string s, int start, int end) {
        long ip = 0;
        int i = start;
        bool neg = false;
        if (i < end && (s[i] == 43 || s[i] == 45)) { neg = s[i] == 45; i = i + 1; }
        while (i < end && s[i] >= 48 && s[i] <= 57) {
            ip = ip * 10 + (s[i] - 48);
            i = i + 1;
        }
        double frac = 0.0;
        double scale = 1.0;
        if (i < end && s[i] == 46) {
            i = i + 1;
            while (i < end && s[i] >= 48 && s[i] <= 57) {
                scale = scale * 10.0;
                frac = frac * 10.0 + (s[i] - 48);
                i = i + 1;
            }
        }
        double v = ip + frac / scale;
        if (i < end && (s[i] == 101 || s[i] == 69)) {
            i = i + 1;
            bool eneg = false;
            if (i < end && (s[i] == 43 || s[i] == 45)) { eneg = s[i] == 45; i = i + 1; }
            int ex = 0;
            while (i < end && s[i] >= 48 && s[i] <= 57) {
                ex = ex * 10 + (s[i] - 48);
                i = i + 1;
            }
            if (ex > 300) { ex = 300; }
            double m = 1.0;
            for (int k = 0; k < ex; k = k + 1) { m = m * 10.0; }
            v = eneg ? v / m : v * m;
        }
        return neg ? 0.0 - v : v;
    }
}
