using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartBoxParam {
    public int kind;
    public double num;  // kind 1/2：像素数 / 百分数（可带小数）
    public string kw;  // kind 3：原始关键字

    public static ChartBoxParam Px(double v) {
        return new ChartBoxParam { kind = 1, num = v, kw = "" };
    }
    public static ChartBoxParam Pct(double v) {
        return new ChartBoxParam { kind = 2, num = v, kw = "" };
    }
    public static ChartBoxParam Key(string s) {
        return new ChartBoxParam { kind = 3, num = 0.0, kw = s };
    }
    // 声明了 null/"auto"（占位但无值——mergeLayoutParam 的 hasValue
    // 把它与未声明同样对待，但 hasOwn 语义不同）。
    public static ChartBoxParam Void() {
        return new ChartBoxParam { kind = 0, num = 0.0, kw = "" };
    }

    public static ChartBoxParam Clone(ChartBoxParam src) {
        if (src == null) { return null; }
        return new ChartBoxParam { kind = src.kind, num = src.num, kw = src.kw };
    }
}

// 长度/位置标量：像素（Px）或相对主体的百分比（Pct，0..100）。
