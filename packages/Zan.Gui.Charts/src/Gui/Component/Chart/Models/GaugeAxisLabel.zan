using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class GaugeAxisLabel {
    public bool show;
    public string formatter;
    public ChartTextStyle textStyle;

    // 构造默认标签：显示、无 formatter、默认文本样式。
    public static GaugeAxisLabel Create() {
        return new GaugeAxisLabel { show = true, formatter = "", textStyle = ChartTextStyle.Create() };
    }

    // 深复制；src 为 null 时返回 null。
    public static GaugeAxisLabel Clone(GaugeAxisLabel src) {
        if (src == null) { return null; }
        return new GaugeAxisLabel { show = src.show, formatter = src.formatter,
            textStyle = ChartTextStyle.Clone(src.textStyle) };
    }
}

// 仪表盘分隔线：开关、长度与线样式。
