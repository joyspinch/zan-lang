using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// 力导向图的一条边（布局输出；去重后的无向对）。
public class ForceEdge {
    public int a;  // 节点下标
    public int b;
    public int val;  // 该对 link 值之和

    // 构造一条无向边；val 为该无向对的 link 值之和。
    public static ForceEdge Of(int a, int b, int val) {
        ForceEdge e = new ForceEdge();
        e.a = a;
        e.b = b;
        e.val = val;
        return e;
    }
}
