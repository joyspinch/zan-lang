using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// treemap squarify 布局矩形：绘制与命中共用同一份几何。
public class TmRect {
    public ChartNode node;
    public int depth;
    public int x;
    public int y;
    public int w;
    public int h;

    public static TmRect Of(ChartNode node, int depth, int x, int y, int w, int h) {
        TmRect r = new TmRect();
        r.node = node;
        r.depth = depth;
        r.x = x;
        r.y = y;
        r.w = w;
        r.h = h;
        return r;
    }
}
