using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// treemap squarify 布局矩形：绘制与命中共用同一份几何。
class TmRect {
    ChartNode node;
    int depth;
    int x;
    int y;
    int w;
    int h;

    static TmRect Of(ChartNode node, int depth, int x, int y, int w, int h) {
        TmRect r = new TmRect();
        r.node = node;
        r.depth = depth;
        r.x = x;
        r.y = y;
        r.w = w;
        r.h = h;
        return r;
    }
}
