using System;

namespace Gui.Component.Chart;

// 极坐标柱的一列（ECharts `layout/barPolar.ts` calcRadialBar 的结果
// 条目：同一 stackId 共享一条列）。`offset`/`width` 都是 double ——
// 极坐标带宽是 pxSpan/count（600px 图 7 类目 = 51.43），整数会
// 系统性偏窄。
public class ChartPolarBarCol {
    public double offset;
    public double width;

    public static ChartPolarBarCol Of(double o, double w) {
        return new ChartPolarBarCol { offset = o, width = w };
    }
}
