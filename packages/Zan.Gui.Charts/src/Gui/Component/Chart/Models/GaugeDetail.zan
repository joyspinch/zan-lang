using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class GaugeDetail {
    public bool show;
    public int backgroundColor;
    public int borderWidth;
    public int borderColor;
    public int width;
    public int height;
    public ChartPosition offsetCenter;
    public string formatter;
    public ChartTextStyle textStyle;
    public bool valueAnimation;

    // 构造默认数值牌：显示、无边框底色、100x40、(0px, 40%)、30px 字。
    public static GaugeDetail Create() {
        ChartTextStyle text = ChartTextStyle.Create();
        text.fontSize = 30;
        return new GaugeDetail {
            show = true, backgroundColor = 0, borderWidth = 0,
            borderColor = Chart.Rgb(204, 204, 204), width = 100, height = 40,
            offsetCenter = ChartPosition.Of(ChartScalar.Px(0), ChartScalar.Pct(40)),
            formatter = "", textStyle = text, valueAnimation = false
        };
    }

    // 深复制；src 为 null 时返回 null。
    public static GaugeDetail Clone(GaugeDetail src) {
        if (src == null) { return null; }
        return new GaugeDetail { show = src.show, backgroundColor = src.backgroundColor,
            borderWidth = src.borderWidth, borderColor = src.borderColor,
            width = src.width, height = src.height,
            offsetCenter = ChartPosition.Clone(src.offsetCenter), formatter = src.formatter,
            textStyle = ChartTextStyle.Clone(src.textStyle),
            valueAnimation = src.valueAnimation };
    }
}

// 仪表盘完整配置（ECharts gauge.*）：圆心/半径、角度区间
// （数学角，默认 225°→-45°）、值域 [min,max]、小数位与分割数，
// 以及轴线/刻度/标签/分隔线/指针/标题/数值牌子配置。
