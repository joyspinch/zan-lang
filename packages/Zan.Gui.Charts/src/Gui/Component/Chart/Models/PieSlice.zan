using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// 饼图一个扇区（归一化后）：值、颜色、显示名、所属系列/数据项
// 索引、角度区间 [a0,a1]（度，Canvas 顺时针，0 在 12 点）与环索引。
// 环索引在 pieRings 模式下是可见 Pie 系列的顺序；否则恒为 0。
public class PieSlice {
    public int value;
    public int color;
    public string name;
    public int seriesIndex;
    public int dataIndex;
    public int a0;
    public int a1;
    public int ring;
    public bool selected;  // data.selected：静态选中，绘制时外偏 selectedOffset
    public int roseP;  // 玫瑰图带内位置（千分比：0 = 环内径、1000 = 环外径；
                    // 非玫瑰扇区 = 0，半径走环几何）
    public int padAngle;  // 扇区间隙夹角（度，默认 0）

    // 构造扇区：值/色/名/系列与数据项下标/角度区间/环号按参数
    // 记录，selected 初始为 false（由 PieLayout 按 data.selected 置位）。
    public static PieSlice Of(int value, int color, string name,
                       int seriesIndex, int dataIndex, int a0, int a1, int ring) {
        PieSlice s = new PieSlice();
        s.value = value;
        s.color = color;
        s.name = name;
        s.seriesIndex = seriesIndex;
        s.dataIndex = dataIndex;
        s.a0 = a0;
        s.a1 = a1;
        s.ring = ring;
        s.selected = false;
        s.roseP = 0;
        s.padAngle = 0;
        return s;
    }
}
