using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// 桑基图节点布局：按最长路径分层的层号 + 累计流量决定的
// 高度与 x/y 落点（见 ChartView.DrawSankey）。
class SankeyNodeLayout {
    string name;
    int layer;
    int flowOut;
    int flowIn;
    int x;
    int y;
    int h;

    // 构造桑基节点：仅记名字，layer/flow/x/y/h 由布局阶段填充。
    static SankeyNodeLayout Of(string name) {
        SankeyNodeLayout node = new SankeyNodeLayout();
        node.name = name;
        node.layer = 0;
        node.flowOut = 0;
        node.flowIn = 0;
        node.x = 0;
        node.y = 0;
        node.h = 0;
        return node;
    }
}
