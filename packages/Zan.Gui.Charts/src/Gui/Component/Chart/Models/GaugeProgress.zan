using System;
using System.Json;
using System.Text;
using Gui;

namespace Gui.Component.Chart;

// ECharts 5/6 现代仪表盘进度条（progress）：
// 沿轴线绘制已激活值的圆弧条带，配合 pointer.show=false 可做纯环形进度仪表。
public class GaugeProgress {
    public bool show;
    public bool overlap;
    public int width;
    public bool roundCap;
    public int color;

    public static GaugeProgress Create() {
        return new GaugeProgress {
            show = false, overlap = true, width = 0, roundCap = false, color = 0
        };
    }

    public static GaugeProgress Clone(GaugeProgress src) {
        if (src == null) { return null; }
        return new GaugeProgress {
            show = src.show, overlap = src.overlap, width = src.width,
            roundCap = src.roundCap, color = src.color
        };
    }
}
