using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

class ChartRichStyle {
    string name;
    int color;
    int fontSize;
    string fontWeight;
    string fontFamily;
    // A14 rich 段的 textBorder*/textShadow*（ECharts labelStyle.ts:522,550
    // ——zrender stroke 文本 = 先描边后填充，paint-order:stroke）。
    // borderColor 0 = 无；borderWidth -1 = 未声明；shadowColor 0 = 无。
    int tbColor;
    int tbWidth;
    int tsColor;
    int tsBlur;
    int tsDx;
    int tsDy;
    int align;  // 0 left / 1 center / 2 right；-1 未声明（左）
    int lineHeight;
    int backgroundColor;
    int bgIsImage;
    int borderColor;
    int borderWidth;  // 官方可 0.5（pie-rich-text/treemap hr）：四舍五入存 px
    int radTL;  // borderRadius：数字 = 四角同值；数组 [左上,右上,
    int radTR;  // 右下,左下]（pie-rich-text abg 的 [4,4,0,0] 只
    int radBR;  // 圆上面两角）。-1 未声明。
    int radBL;
    int padT;
    int padR;
    int padB;
    int padL;
    int width;  // -2 = '100%'（随富文本整块宽）；≥0 像素
    int height;

    // 构造默认：全未声明。
    static ChartRichStyle Create() {
        ChartRichStyle r = new ChartRichStyle();
        r.name = "";
        r.color = 0;
        r.fontSize = 0 - 1;
        r.fontWeight = "";
        r.fontFamily = "";
        r.tbColor = 0;
        r.tbWidth = 0 - 1;
        r.tsColor = 0;
        r.tsBlur = 0 - 1;
        r.tsDx = 0;
        r.tsDy = 0;
        r.align = 0 - 1;
        r.lineHeight = 0 - 1;
        r.backgroundColor = 0;
        r.bgIsImage = 0;
        r.borderColor = 0;
        r.borderWidth = 0 - 1;
        r.radTL = 0 - 1;
        r.radTR = 0 - 1;
        r.radBR = 0 - 1;
        r.radBL = 0 - 1;
        r.padT = 0 - 1;
        r.padR = 0 - 1;
        r.padB = 0 - 1;
        r.padL = 0 - 1;
        r.width = 0 - 1;
        r.height = 0 - 1;
        return r;
    }
}

// 文本样式（颜色、字号、字体族、阴影），JSON 可逐字段覆盖。
// 另承载 ECharts label 的整块盒样式（backgroundColor/border/padding，
// pie-rich-text 的 data.label 底板）与 label.rich 富文本样式表；
// rich 非 null 即声明过富文本（可为空表——`rich:{}` 合法）。
