using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartStage {
    public int val;
    public int color;
    public string name;
    public int seriesIndex;  // 对应的 o.series 下标（legend hit toggle 用）
    public int dataIndex;  // 单系列多数据项时的 data[] 下标

    // 构造一个阶段；si 为所属系列下标，dataIndex 初始为 0。
    public ChartStage(int v, int col, string nm, int si) {
        val = v;
        color = col;
        name = nm;
        seriesIndex = si;
        dataIndex = 0;
    }
}

// Treemap / Sunburst 图的层级节点：名称、值和
// 嵌套子节点。叶子携带值；组的值由
// 其子节点推导（渲染为组的总量 / 环扫掠）。
