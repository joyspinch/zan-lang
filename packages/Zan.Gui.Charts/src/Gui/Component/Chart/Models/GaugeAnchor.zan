using System;
using System.Json;
using System.Text;
using Gui;

namespace Gui.Component.Chart;

// ECharts 5/6 现代仪表盘指针固定点（anchor）：
// 仪表盘中心固定点圆环/实心点。
public class GaugeAnchor {
    public bool show;
    public bool showAbove;
    public int size;
    public int color;
    public int borderColor;
    public int borderWidth;
    public string icon;

    public static GaugeAnchor Create() {
        return new GaugeAnchor {
            show = false, showAbove = false, size = 6,
            color = 0, borderColor = 0, borderWidth = 0, icon = ""
        };
    }

    public static GaugeAnchor Clone(GaugeAnchor src) {
        if (src == null) { return null; }
        return new GaugeAnchor {
            show = src.show, showAbove = src.showAbove, size = src.size,
            color = src.color, borderColor = src.borderColor, borderWidth = src.borderWidth,
            icon = src.icon
        };
    }
}
