using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class Bubble {
    public int x;
    public int y;
    public int weight;
    // 构造一个加权散点。
    public static Bubble Of(int x, int y, int weight) {
        Bubble b = new Bubble();
        b.x = x;
        b.y = y;
        b.weight = weight;
        return b;
    }

    // 深复制；src 为 null 时返回 null。
    // 面向对象深复制实例方法。

    public Bubble Clone() {

        return Bubble.Clone(this);

    }


    public static Bubble Clone(Bubble src) {
        if (src == null) { return null; }
        return Bubble.Of(src.x, src.y, src.weight);
    }
}
