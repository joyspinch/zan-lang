using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// 饼图图例条目候选实体（消除 candSi / candDi / candNm 平行列表反模式）。
class PieLegendItem {
    int seriesIndex;
    int dataIndex;
    string name;

    PieLegendItem(int seriesIndex, int dataIndex, string name) {
        this.seriesIndex = seriesIndex;
        this.dataIndex = dataIndex;
        this.name = name;
    }
}
