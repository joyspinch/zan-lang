using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartBreakResolved {
    public ChartBreak item;
    public double gapReal;

    public ChartBreakResolved(ChartBreak item, double gapReal) {
        this.item = item;
        this.gapReal = gapReal;
    }

    public static ChartBreakResolved Of(ChartBreak item, double gapReal) {
        return new ChartBreakResolved(item, gapReal);
    }
}
