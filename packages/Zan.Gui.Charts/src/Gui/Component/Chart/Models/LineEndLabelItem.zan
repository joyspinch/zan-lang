using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// 折线图末端标注实体（消除 endLblX / endLblY / endLblColor / endLblText / endLblS 平行列表反模式）。
class LineEndLabelItem {
    int x;
    int y;
    int color;
    string text;
    ChartSeries series;

    LineEndLabelItem(int x, int y, int color, string text, ChartSeries series) {
        this.x = x;
        this.y = y;
        this.color = color;
        this.text = text;
        this.series = series;
    }
}
