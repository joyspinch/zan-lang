using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartMapPoint {
    public int x;
    public int y;

    // 构造一个地图多边形顶点。
    public static ChartMapPoint Of(int x, int y) { return new ChartMapPoint { x = x, y = y }; }
}

