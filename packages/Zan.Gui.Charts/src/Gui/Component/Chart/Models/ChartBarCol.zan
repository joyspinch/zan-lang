using System;
using System.Text;

namespace Gui.Component.Chart;

// 一根柱列的布局（columnMap 的条目）。
// 同一 stack 的系列共享同一条列；`offset` 是柱左缘相对类目带中心
// 的像素偏移，`width` 是柱宽。两者都是 double，保持浮点精度。
public class ChartBarCol {
    public double offset;
    public double width;

    public static ChartBarCol Of(double o, double w) {
        return new ChartBarCol { offset = o, width = w };
    }
}
