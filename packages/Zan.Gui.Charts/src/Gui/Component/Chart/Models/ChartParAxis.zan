using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartParAxis {
    public string name;
    public int dim;  // parallelAxis.dim：绑定的数据列下标（缺省 = 数组槽位）
    public int min;  // 显式下界；minSet=false 时取数据维最小
    public int max;  // 显式上界；maxSet=false 时取数据维最大
    public bool minSet;
    public bool maxSet;
    public bool inverse;  // parallelAxis.inverse：反向刻度
    public List<string> cats;  // type:"category" 的类目表（值取下标）

    public static ChartParAxis Of() {
        ChartParAxis a = new ChartParAxis();
        a.name = "";
        a.dim = 0 - 1;  // -1 = 未声明，渲染按数组槽位取列
        a.min = 0; a.max = 0;
        a.minSet = false; a.maxSet = false;
        a.inverse = false;
        a.cats = new List<string>();
        return a;
    }

    // 面向对象深复制实例方法。


    public ChartParAxis Clone() {


        return ChartParAxis.Clone(this);


    }



    public static ChartParAxis Clone(ChartParAxis src) {
        if (src == null) { return null; }
        ChartParAxis a = ChartParAxis.Of();
        a.name = src.name;
        a.dim = src.dim;
        a.min = src.min; a.max = src.max;
        a.minSet = src.minSet; a.maxSet = src.maxSet;
        a.inverse = src.inverse;
        for (int i = 0; i < src.cats.Count; i = i + 1) { a.cats.Add(src.cats[i]); }
        return a;
    }
}

// 平行坐标数据行实体
public class ChartParallelRow {
    public List<int> values;

    public ChartParallelRow() {
        this.values = new List<int>();
    }

    public ChartParallelRow(List<int> values) {
        this.values = values != null ? values : new List<int>();
    }

    public static ChartParallelRow Of(List<int> values) {
        return new ChartParallelRow(values);
    }

    public ChartParallelRow Clone() {
        return ChartParallelRow.Clone(this);
    }

    public static ChartParallelRow Clone(ChartParallelRow src) {
        if (src == null) { return null; }
        List<int> cp = new List<int>();
        if (src.values != null) {
            for (int i = 0; i < src.values.Count; i = i + 1) {
                cp.Add(src.values[i]);
            }
        }
        return new ChartParallelRow(cp);
    }
}

