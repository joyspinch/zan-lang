using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class PolarAxisSpec {
    public bool isAngle;  // true = angleAxis，false = radiusAxis
    public ChartAxisType type;  // Value（ECharts 极轴缺省）/ Category
    public int polarIndex;  // 绑定第几个 polar（缺省 = 数组槽位）
    public int min;  // 显式量程；minSet=false 时从数据推导
    public int max;
    public bool minSet;
    public bool maxSet;
    public int startAngle;  // 仅角度轴：起始角（ECharts 缺省 90 = 12 点）。这是
                        // "顺时针为正"的屏幕角：clockwise（缺省）时角度
                        // 随值递减。见 ChartView.PolarAngleAt。
    public int endAngle;  // 仅角度轴：终止角。未声明时 = startAngle - 360
                        // （clockwise:true）。
    public bool endAngleSet;  // endAngle 是否显式声明。`endAngle:0` 是合法显式值
                        // （四分之一圈，polar-endAngle 两个 polar 都这么用），
                        // 不能拿 0 当"未声明"哨兵——旧代码正是如此，于是
                        // polar-endAngle 的扇区被撑成满圈。
    public bool clockwise;  // 仅角度轴：ECharts 缺省 true（角度随值递减，屏幕上
                        // 是顺时针）。false 时角度递增。
    public bool boundaryGap;  // 类目轴（缺省 true：点落在带中央）
    public List<string> cats;  // 类目数据

    public static PolarAxisSpec Of(bool angle) {
        PolarAxisSpec a = new PolarAxisSpec();
        a.isAngle = angle;
        a.type = ChartAxisType.Value;
        a.polarIndex = 0;
        a.min = ChartOption.Auto();
        a.max = ChartOption.Auto();
        a.minSet = false; a.maxSet = false;
        a.startAngle = 90;
        a.endAngle = 0;
        a.endAngleSet = false;
        a.clockwise = true;
        a.boundaryGap = true;
        a.cats = new List<string>();
        return a;
    }

    public static PolarAxisSpec Clone(PolarAxisSpec src) {
        if (src == null) { return null; }
        PolarAxisSpec a = PolarAxisSpec.Of(src.isAngle);
        a.type = src.type;
        a.polarIndex = src.polarIndex;
        a.min = src.min; a.max = src.max;
        a.minSet = src.minSet; a.maxSet = src.maxSet;
        a.startAngle = src.startAngle;
        a.endAngle = src.endAngle;
        a.endAngleSet = src.endAngleSet;
        a.clockwise = src.clockwise;
        a.boundaryGap = src.boundaryGap;
        for (int i = 0; i < src.cats.Count; i = i + 1) { a.cats.Add(src.cats[i]); }
        return a;
    }
}

// Event River 的一个事件：名称、时间区间 [start, end]、值
// （驱动带宽）、可选颜色。普通标量 data 兼容转换为等距事件。
