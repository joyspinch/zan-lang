using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartDimension {
    public string name;
    public List<int> values;

    // 构造一个维度（直接持有 values 列表，不复制）。
    public static ChartDimension Of(string name, List<int> values) {
        ChartDimension d = new ChartDimension();
        d.name = name;
        d.values = values;
        return d;
    }
}
