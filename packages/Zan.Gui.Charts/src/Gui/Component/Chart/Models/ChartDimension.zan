using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartDimension {
    public string name;
    public List<int> values;

    // 构造一个维度（直接持有 values 列表，不复制）。
    public static ChartDimension Of(string name, List<int> values) {
        ChartDimension d = new ChartDimension();
        d.name = name;
        d.values = values;
        return d;
    }
}

// ECharts 风格共享数据源：命名维度按列存储，外加
// 可选的 x 轴分类标签。一个数据集可通过
// EncodeBy / EncodeNamed 选择不同维度来驱动多个图表——
// 调用方从不复制或重构底层列表。
