        this.showGrid = source.showGrid;
        this.showValues = source.showValues;
        this.animate = source.animate;
        this.smooth = source.smooth;
        this.pointerCross = source.pointerCross;
        this.gradient = source.gradient;
        this.rounded = source.rounded;
        this.animMs = source.animMs;
        this.donutPct = source.donutPct;
        this.gaugeMax = source.gaugeMax;
        this.pieLabels = source.pieLabels;
        this.pieCenterText = source.pieCenterText;
        this.pieRings = source.pieRings;
        this.overlay = source.overlay;
        this.radarIndicators = source.radarIndicators;
        this.radarMax = source.radarMax;
        this.radarNames = source.radarNames;
        this.radarScaled = source.radarScaled;
        this.radarShape = source.radarShape;
        this.radarSplitArea = source.radarSplitArea;
        this.radarNameColor = source.radarNameColor;
        this.polars = source.polars;
        this.legendTextColor = source.legendTextColor;
        this.legendOrient = source.legendOrient;
        this.legendX = source.legendX;
        this.legendSelectedMode = source.legendSelectedMode;
        this.legendFormatter = source.legendFormatter;
        this.legendItemGap = source.legendItemGap;
