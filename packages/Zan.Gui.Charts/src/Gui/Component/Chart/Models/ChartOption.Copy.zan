        this.titleSub = source.titleSub;
        this.titleLink = source.titleLink;
        this.titleSublink = source.titleSublink;
        this.titleAlign = source.titleAlign;
        this.titleColor = source.titleColor;
        this.titleSubColor = source.titleSubColor;
        this.xAxes = source.xAxes;
        this.datasets = source.datasets;
        this.visualMaps = source.visualMaps;
        this.titles = source.titles;
        this.grids = source.grids;
        this.markAreas = source.markAreas;
        this.yAxes = source.yAxes;
        this.series = source.series;
        this.declOrder = source.declOrder;
        this.geos = source.geos;
        this.calendars = source.calendars;
        this.matrix = source.matrix;
        this.parAxes = source.parAxes;
        this.angleAxes = source.angleAxes;
        this.radiusAxes = source.radiusAxes;
        this.parLayout = source.parLayout;
        this.graphics = source.graphics;
        this.defaultType = source.defaultType;
        this.showLegend = source.showLegend;
        this.showTooltip = source.showTooltip;
        this.tooltipTrigger = source.tooltipTrigger;
        this.tooltipTriggerOn = source.tooltipTriggerOn;
        this.tooltipConfine = source.tooltipConfine;
        this.tooltipTransitionDuration = source.tooltipTransitionDuration;
        this.tooltipShowDelay = source.tooltipShowDelay;
        this.tooltipHideDelay = source.tooltipHideDelay;
        this.pointerSnap = source.pointerSnap;
        this.toolboxShow = source.toolboxShow;
        this.toolboxDataView = source.toolboxDataView;
        this.toolboxDataViewReadOnly = source.toolboxDataViewReadOnly;
        this.toolboxMagicLine = source.toolboxMagicLine;
        this.toolboxMagicBar = source.toolboxMagicBar;
        this.toolboxRestore = source.toolboxRestore;
        this.toolboxSave = source.toolboxSave;
        this.toolboxZoom = source.toolboxZoom;
        this.toolboxMark = source.toolboxMark;
        this.animation = source.animation;
        this.animationDuration = source.animationDuration;
        this.animationDurationUpdate = source.animationDurationUpdate;
        this.animationEasing = source.animationEasing;
        this.animationEasingUpdate = source.animationEasingUpdate;
        this.animationThreshold = source.animationThreshold;
        this.useUTC = source.useUTC;
        this.blendMode = source.blendMode;
        this.titleItemGap = source.titleItemGap;
        this.roam = source.roam;
        this.roamWheelMode = source.roamWheelMode;
