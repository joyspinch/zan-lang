        this.legendItemHeight = source.legendItemHeight;
        this.legendIcon = source.legendIcon;
        this.legendData = source.legendData;
        this.legendLeft = source.legendLeft;
        this.legendRight = source.legendRight;
        this.legendTop = source.legendTop;
        this.legendBottom = source.legendBottom;
        this.legendHasLeft = source.legendHasLeft;
        this.legendHasRight = source.legendHasRight;
        this.legendHasTop = source.legendHasTop;
        this.legendHasBottom = source.legendHasBottom;
