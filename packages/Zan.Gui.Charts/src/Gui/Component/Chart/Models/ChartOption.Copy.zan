    // Snapshot policy: isolate mutable axes/styles/series and list containers.
    // Dataset/title/grid/markArea/calendar/graphic entries and matrix remain borrowed
    // specifications, matching their existing no-Clone contract.
    public ChartOption Clone() {
        return this.CopyContainers(false);
    }

    // Frame policy: series are materialized by ResolvedChart; zoom specifications
    // and read-only data remain borrowed for the duration of this render only.
    public ChartOption CopyFrame() {
        return this.CopyContainers(true);
    }

    ChartOption CopyContainers(bool frame) {
        ChartOption o = new ChartOption(this);
        o.gridLeftRaw = this.gridLeftRaw != null ? this.gridLeftRaw.Clone() : null;
        o.gridRightRaw = this.gridRightRaw != null ? this.gridRightRaw.Clone() : null;
        o.gridTopRaw = this.gridTopRaw != null ? this.gridTopRaw.Clone() : null;
        o.gridBottomRaw = this.gridBottomRaw != null ? this.gridBottomRaw.Clone() : null;
        o.gridWidthRaw = this.gridWidthRaw != null ? this.gridWidthRaw.Clone() : null;
        o.gridHeightRaw = this.gridHeightRaw != null ? this.gridHeightRaw.Clone() : null;
        o.obLeftRaw = this.obLeftRaw != null ? this.obLeftRaw.Clone() : null;
        o.obRightRaw = this.obRightRaw != null ? this.obRightRaw.Clone() : null;
        o.obTopRaw = this.obTopRaw != null ? this.obTopRaw.Clone() : null;
        o.obBottomRaw = this.obBottomRaw != null ? this.obBottomRaw.Clone() : null;
        if (!frame) {
            o.zooms = new List<ChartZoom>();
            if (this.zooms != null) {
                for (int zi = 0; zi < this.zooms.Count; zi = zi + 1) {
                    ChartZoom z = this.zooms[zi];
                    o.zooms.Add(z != null ? z.Clone() : null);
                }
            }
            o.zoomX = this.zoomX != null ? this.zoomX.Clone() : null;
            o.zoomY = this.zoomY != null ? this.zoomY.Clone() : null;
        }
        o.radarIndicators = new List<RadarIndicator>();
        if (this.radarIndicators != null) {
            for (int i = 0; i < this.radarIndicators.Count; i = i + 1) {
                o.radarIndicators.Add(new RadarIndicator(this.radarIndicators[i].name, this.radarIndicators[i].max));
            }
        }
        o.radarMax = new List<int>();
        if (this.radarMax != null) {
            for (int i = 0; i < this.radarMax.Count; i = i + 1) { o.radarMax.Add(this.radarMax[i]); }
        }
        o.radarNames = new List<string>();
        if (this.radarNames != null) {
            for (int i = 0; i < this.radarNames.Count; i = i + 1) { o.radarNames.Add(this.radarNames[i]); }
        }
        o.polars = new List<RadarPolar>();
        if (this.polars != null) {
            for (int i = 0; i < this.polars.Count; i = i + 1) {
                RadarPolar rp = this.polars[i];
                o.polars.Add(rp != null ? rp.Clone() : null);
            }
        }
        o.rampColors = new List<int>();
        if (this.rampColors != null) {
            for (int i = 0; i < this.rampColors.Count; i = i + 1) { o.rampColors.Add(this.rampColors[i]); }
        }
        o.xAxes = new List<ChartAxis>();
        if (this.xAxes != null) {
            for (int i = 0; i < this.xAxes.Count; i = i + 1) {
                ChartAxis ax = this.xAxes[i];
                o.xAxes.Add(ax != null ? ax.Clone() : null);
            }
        }
        o.datasets = new List<ChartJsonDataset>();
        if (this.datasets != null) {
            for (int di2 = 0; di2 < this.datasets.Count; di2 = di2 + 1) { o.datasets.Add(this.datasets[di2]); }
        }
        o.visualMaps = new List<ChartVisualMap>();
        if (this.visualMaps != null) {
            for (int vi2 = 0; vi2 < this.visualMaps.Count; vi2 = vi2 + 1) {
                ChartVisualMap vm = this.visualMaps[vi2];
                o.visualMaps.Add(vm != null ? vm.Clone() : null);
            }
        }
        o.titles = new List<ChartTitleSpec>();
        if (this.titles != null) {
            for (int ti2 = 0; ti2 < this.titles.Count; ti2 = ti2 + 1) { o.titles.Add(this.titles[ti2]); }
        }
        o.grids = new List<ChartGridSpec>();
        if (this.grids != null) {
            for (int gi2 = 0; gi2 < this.grids.Count; gi2 = gi2 + 1) { o.grids.Add(this.grids[gi2]); }
        }
        o.markAreas = new List<ChartMarkArea>();
        if (this.markAreas != null) {
            for (int mai = 0; mai < this.markAreas.Count; mai = mai + 1) { o.markAreas.Add(this.markAreas[mai]); }
        }
        o.yAxes = new List<ChartAxis>();
        if (this.yAxes != null) {
            for (int i = 0; i < this.yAxes.Count; i = i + 1) {
                ChartAxis ay = this.yAxes[i];
                o.yAxes.Add(ay != null ? ay.Clone() : null);
            }
        }
        if (!frame) {
            o.series = new List<ChartSeries>();
            if (this.series != null) {
                for (int i = 0; i < this.series.Count; i = i + 1) {
                    ChartSeries s = this.series[i];
                    o.series.Add(s != null ? s.Clone() : null);
                }
            }
            o.declOrder = null;
            if (this.declOrder != null && this.declOrder.Count == this.series.Count) {
                o.declOrder = new List<ChartSeries>();
                for (int di = 0; di < this.declOrder.Count; di = di + 1) {
                    int si = ChartView.SeriesIndexOf(this, this.declOrder[di]);
                    if (si >= 0) { o.declOrder.Add(o.series[si]); }
                }
            }
        }
        o.geos = new List<ChartGeo>();
        if (this.geos != null) {
            for (int gci = 0; gci < this.geos.Count; gci = gci + 1) {
                ChartGeo cg = this.geos[gci];
                o.geos.Add(cg != null ? cg.Clone() : null);
            }
        }
        o.calendars = new List<ChartCalendarSpec>();
        if (this.calendars != null) {
            for (int cai = 0; cai < this.calendars.Count; cai = cai + 1) {
                o.calendars.Add(this.calendars[cai]);
            }
        }
        o.parAxes = new List<ChartParAxis>();
        if (this.parAxes != null) {
            for (int pai = 0; pai < this.parAxes.Count; pai = pai + 1) {
                ChartParAxis pa = this.parAxes[pai];
                o.parAxes.Add(pa != null ? pa.Clone() : null);
            }
        }
        o.angleAxes = new List<PolarAxisSpec>();
        if (this.angleAxes != null) {
            for (int pai2 = 0; pai2 < this.angleAxes.Count; pai2 = pai2 + 1) {
                PolarAxisSpec aa = this.angleAxes[pai2];
                o.angleAxes.Add(aa != null ? aa.Clone() : null);
            }
        }
        o.radiusAxes = new List<PolarAxisSpec>();
        if (this.radiusAxes != null) {
            for (int pai3 = 0; pai3 < this.radiusAxes.Count; pai3 = pai3 + 1) {
                PolarAxisSpec ra = this.radiusAxes[pai3];
                o.radiusAxes.Add(ra != null ? ra.Clone() : null);
            }
        }
        o.dataRangeList = new List<ChartRangeSplit>();
        if (this.dataRangeList != null) {
            for (int i = 0; i < this.dataRangeList.Count; i = i + 1) {
                ChartRangeSplit rs = this.dataRangeList[i];
                o.dataRangeList.Add(rs != null ? rs.Clone() : null);
            }
        }
        o.graphics = new List<ChartGraphic>();
        if (this.graphics != null) {
            for (int i = 0; i < this.graphics.Count; i = i + 1) {
                o.graphics.Add(this.graphics[i]);
            }
        }
        if (!frame) {
            if (this.legendData != null) {
                o.legendData = new List<string>();
                for (int i = 0; i < this.legendData.Count; i = i + 1) { o.legendData.Add(this.legendData[i]); }
            }
            if (this.backgroundGradStops != null) {
                o.backgroundGradStops = new List<int>();
                for (int i = 0; i < this.backgroundGradStops.Count; i = i + 1) { o.backgroundGradStops.Add(this.backgroundGradStops[i]); }
            }
            if (this.colorPal != null) {
                o.colorPal = new List<int>();
                for (int i = 0; i < this.colorPal.Count; i = i + 1) { o.colorPal.Add(this.colorPal[i]); }
            }
        }
        return o;
    }

    // The input is already an isolated draw option. Overlay borrows its fields
    // and series, replacing only the lists whose membership the overlay changes.
    public ChartOption OverlayOption(List<ChartSeries> selected) {
        ChartOption o = new ChartOption(this);
        o.overlay = true;
        o.showLegend = false;
        o.series = selected;
        o.declOrder = null;
        return o;
    }
}
