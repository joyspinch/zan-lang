using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// 矩阵坐标系（ECharts6 coord/matrix）的几何与取色域——核心层与
// 悬停层共用的一次推导结果：盒矩形、单位分割（头带 + 叶列/叶行）、
// 色带、值域、piecewise 桶数。
// 官方布局（Matrix.js layOutUnitsOnDimension）：沿 x 向先铺 y 树的
// 层级头带（左缘竖条），再铺 x 树的叶列；沿 y 向先铺 x 树的层级
// 头带（顶缘横条），再铺 y 树的叶行。声明 levelSize/size 的单位先
// 占尺寸（隐藏维的头带占 0），剩余空间**等分**给未声明单位（头带
// 与体格同厚），末单元贴齐盒缘。角区（两棵树头带的交叠）无格线。
class MatGeom {
    int rx; int ry; int rw; int rh;  // 矩阵盒（含头带与角区）
    int xBands; int yBands;  // x 树层级数（顶横带）/ y 树层级数（左竖带）
    int xLeaves; int yLeaves;  // 叶列 / 叶行数
    int unitsX; int unitsY;  // x 向 = yBands + xLeaves；y 向 = xBands + yLeaves
    List<int> xStarts;  // x 向单位边界（unitsX+1 项，绝对 px）
    List<int> yStarts;  // y 向单位边界（unitsY+1 项，绝对 px）
    int bodyL; int bodyT;  // 体区左/上缘（头带结束处）
    int panelX; int panelY;  // 图表面板矩形（图例浮层锚定用）
    int panelW; int panelH;
    List<int> ramp;  // 取色带；<2 色时调用方回退系列色
    double dLo; double dHi;  // 值域：visualMap 声明优先，缺省数据包络
    int split;  // piecewise 等分桶数；0 = 连续

    static MatGeom Of() {
        MatGeom geo = new MatGeom();
        geo.rx = 0; geo.ry = 0; geo.rw = 0; geo.rh = 0;
        geo.xBands = 0; geo.yBands = 0;
        geo.xLeaves = 0; geo.yLeaves = 0;
        geo.unitsX = 0; geo.unitsY = 0;
        geo.xStarts = new List<int>();
        geo.yStarts = new List<int>();
        geo.bodyL = 0; geo.bodyT = 0;
        geo.panelX = 0; geo.panelY = 0;
        geo.panelW = 0; geo.panelH = 0;
        geo.ramp = null;
        geo.dLo = 0.0; geo.dHi = 1.0;
        geo.split = 0;
        return geo;
    }
}
