using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartPoint {
    public int x;
    public int y;
    public int z;  // 第三维（ECharts data [x,y,z] 的末维）：dataRange/
                 // 色带按它映射（非 0 时），散点气泡值等用
    public int size;  // 逐点 symbolSize；sizeSet=false 时忽略
    public bool sizeSet;
    public int color;  // 逐点颜色；0 = 继承系列颜色
    public string name;  // ECharts data[i].name——系列 labelShow 时的逐点
                 // 标签文本（formatter {b}，散点省名标注等用）

    // 构造一个点（无逐点尺寸，继承系列颜色）。
    public static ChartPoint Of(int x, int y) {
        return new ChartPoint { x = x, y = y, z = 0, size = 0, sizeSet = false, color = 0, name = "" };
    }

    // 构造带逐点尺寸（直径像素）的点。
    public static ChartPoint Sized(int x, int y, int size) {
        ChartPoint p = ChartPoint.Of(x, y);
        p.size = size;
        p.sizeSet = true;
        return p;
    }

    // 深复制；src 为 null 时返回 null。
    public static ChartPoint Clone(ChartPoint src) {
        if (src == null) { return null; }
        return new ChartPoint { x = src.x, y = src.y, z = src.z, size = src.size,
            sizeSet = src.sizeSet, color = src.color, name = src.name };
    }
}

// 主题河流图数据点强类型实体（消除 riverTimes/riverVals/riverCat 平行列表反模式）。
