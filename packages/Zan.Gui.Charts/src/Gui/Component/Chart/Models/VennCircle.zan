using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// 韦恩图的一个集合圆（布局输出）。
public class VennCircle {
    public string name;  // 集合名，"" = 由渲染器回退
    public int value;
    public int cx;
    public int cy;
    public int r;

    // 构造一个集合圆（name 为 "" 时由渲染器回退命名）。
    public static VennCircle Of(string name, int value, int cx, int cy, int r) {
        VennCircle v = new VennCircle();
        v.name = name;
        v.value = value;
        v.cx = cx;
        v.cy = cy;
        v.r = r;
        return v;
    }
}
