using System;
using System.Json;
using System.Text;
using Gui;

namespace Gui.Component.Chart;

// ChartOption 分部：dataset 绑定与 radar 向量物化
public partial class ChartOption {
    private static void ParseSeriesDataset(ChartOption o, ChartSeries cs, JsonValue s,
    List<string> bindKeys, List<int> bindOrd) {
        // ECharts dataset 系列绑定：无内联数据的系列缺省绑
        // datasetIndex 0（显式 datasetId/datasetIndex 覆盖）。
        // 按系列类型分派：pie 取 itemName/value 列、candlestick
        // 取 4 值列 + 类目列、scatter 走数值点（千倍定点）、
        // boxplot（custom=="box"）取五数列，line/bar 走类目-
        // 数值对；seriesLayoutBy:'row' 行转列。
        if (cs.data.Count == 0 && cs.points.Count == 0
            && cs.candles.Count == 0 && o.datasets.Count > 0
            && (cs.type != ChartType.Custom || cs.custom == "box")) {
            ChartJsonDataset ds2 = s.Has("datasetId")
                ? ChartJsonDataset.ById(o.datasets, s.Str("datasetId", ""))
                : ChartJsonDataset.At(o.datasets, s.Int("datasetIndex", 0));
            if (ds2 != null && ds2.RowCount() > 0) {
                // 同类（同 dataset、同布局）序号：缺省编码的第
                // ord 条系列取第 ord+1 条值列/行（ECharts 缺省
                // encode 分派）。
                string layKey = Convert.ToString(s.Int("datasetIndex", 0)) + "|"
                    + s.Str("seriesLayoutBy", "column");
                int ord = 0;
                bool ordSeen = false;
                for (int bk = 0; bk < bindKeys.Count; bk = bk + 1) {
                    if (bindKeys[bk] == layKey) {
                        ord = bindOrd[bk];
                        bindOrd[bk] = ord + 1;
                        ordSeen = true;
                        break;
                    }
                }
                if (!ordSeen) { bindKeys.Add(layKey); bindOrd.Add(1); }
                JsonValue enc = s.Get("encode");
                bool encObj = enc != null && enc.IsObject();
                int xcol = 0;
                int ycol = 1;
                if (encObj) {
                    JsonValue exj = enc.Get("x");
                    if (exj != null) {
                        if (exj.IsArray() && exj.Count() > 0) { exj = exj.At(0); }
                        int ex = ds2.ColumnOf(exj);
                        if (ex >= 0) { xcol = ex; }
                    }
                    JsonValue eyj = enc.Get("y");
                    if (eyj != null) {
                        if (eyj.IsArray() && eyj.Count() > 0) { eyj = eyj.At(0); }
                        int ey = ds2.ColumnOf(eyj);
                        if (ey >= 0) { ycol = ey; }
                    }
                } else if (s.Str("seriesLayoutBy", "column") != "row") {
                    // 缺省编码：第 ord 条系列取值列 ord+1（三根
                    // 裸柱绑 2015/2016/2017 三列）。
                    int dc = ord + 1;
                    if (dc < ds2.Width()) { ycol = dc; }
                }
                if (cs.type == ChartType.Pie) {
                    // dataset 饼：itemName 列（缺省 0）作名、
                    // value 列（缺省 1）作值；系列名取值列头。
                    int icol = 0;
                    int vcol = 1;
                    if (encObj) {
                        int ei = ds2.ColumnOf(enc.Get("itemName"));
                        if (ei >= 0) { icol = ei; }
                        int ev = ds2.ColumnOf(enc.Get("value"));
                        if (ev >= 0) { vcol = ev; }
                    }
                    for (int r = 0; r < ds2.RowCount(); r = r + 1) {
                        cs.data.Add(ChartData.NamedNumber(
                            ds2.Num(r, vcol), ds2.Text(r, icol)));
                    }
                    if (cs.name.Length == 0) { cs.name = ds2.Header(vcol); }
                } else if (s.Str("seriesLayoutBy", "column") == "row") {
                    // 行转列：第 ord 条数据行就是一条系列，首列
                    // 是系列名，表头行第 1.. 列是类目。
                    if (ord < ds2.RowCount()) {
                        if (cs.name.Length == 0) { cs.name = ds2.Text(ord, 0); }
                        int cols = ds2.Width();
                        for (int c2 = 1; c2 < cols; c2 = c2 + 1) {
                            cs.data.Add(ChartData.NamedNumber(
                                ds2.Num(ord, c2), ds2.Header(c2)));
                        }
                    }
                } else if (cs.type == ChartType.K) {
                    // encode.y 按系列的 K 线顺序解释，缺省取第 1..4 列。
                    bool echartsOrder = cs.typeName == "candlestick";
                    JsonValue dims = encObj ? enc.Get("y") : null;
                    int oc = ChartOption.CandleDatasetColumn(ds2, dims, 0);
                    int hc = ChartOption.CandleDatasetColumn(ds2, dims, echartsOrder ? 3 : 1);
                    int lc = ChartOption.CandleDatasetColumn(ds2, dims, 2);
                    int cc = ChartOption.CandleDatasetColumn(ds2, dims, echartsOrder ? 1 : 3);
                    for (int r2 = 0; r2 < ds2.RowCount(); r2 = r2 + 1) {
                        cs.candles.Add(Candle.Of((int)ds2.Num(r2, oc),
                            (int)ds2.Num(r2, hc), (int)ds2.Num(r2, lc),
                            (int)ds2.Num(r2, cc)));
                    }
                    int xci = 0;
                    if (encObj) {
                        JsonValue kxj = enc.Get("x");
                        if (kxj != null) {
                            if (kxj.IsArray() && kxj.Count() > 0) { kxj = kxj.At(0); }
                            int ex2 = ds2.ColumnOf(kxj);
                            if (ex2 >= 0) { xci = ex2; }
                        }
                    }
                    if (o.xAxes.Count > 0
                        && o.xAxes[0].type == ChartAxisType.Category
                        && o.xAxes[0].categories.Count == 0) {
                        for (int r3 = 0; r3 < ds2.RowCount(); r3 = r3 + 1) {
                            o.xAxes[0].categories.Add(ds2.Text(r3, xci));
                        }
                    }
                } else if (cs.custom == "box") {
                    // dataset 箱线：值列缺省 1..5（low,Q1,Q2,Q3,
                    // high），encode.x 五元覆盖；标签列
                    // encode.itemName（缺省 0）。标签回填到
                    // category 侧的轴（离群点散点按它定位）。
                    int lc = 0;
                    int b0 = 1; int b1 = 2; int b2 = 3; int b3 = 4; int b4 = 5;
                    if (encObj) {
                        JsonValue ixj = enc.Get("itemName");
                        if (ixj != null) {
                            if (ixj.IsArray() && ixj.Count() > 0) { ixj = ixj.At(0); }
                            int ei2 = ds2.ColumnOf(ixj);
                            if (ei2 >= 0) { lc = ei2; }
                        }
                        JsonValue bxj = enc.Get("x");
                        if (bxj != null && bxj.IsArray() && bxj.Count() >= 5) {
                            int e0 = ds2.ColumnOf(bxj.At(0));
                            int e1 = ds2.ColumnOf(bxj.At(1));
                            int e2 = ds2.ColumnOf(bxj.At(2));
                            int e3 = ds2.ColumnOf(bxj.At(3));
                            int e4 = ds2.ColumnOf(bxj.At(4));
                            if (e0 >= 0) { b0 = e0; }
                            if (e1 >= 0) { b1 = e1; }
                            if (e2 >= 0) { b2 = e2; }
                            if (e3 >= 0) { b3 = e3; }
                            if (e4 >= 0) { b4 = e4; }
                        }
                    }
                    for (int rb = 0; rb < ds2.RowCount(); rb = rb + 1) {
                        cs.boxes.Add(BoxItem.Of(ds2.Text(rb, lc),
                            ChartJsonDataset.Rint(ds2.Num(rb, b0)),
                            ChartJsonDataset.Rint(ds2.Num(rb, b1)),
                            ChartJsonDataset.Rint(ds2.Num(rb, b2)),
                            ChartJsonDataset.Rint(ds2.Num(rb, b3)),
                            ChartJsonDataset.Rint(ds2.Num(rb, b4))));
                    }
                    if (cs.name.Length == 0) { cs.name = ds2.Header(b0); }
                    if (o.xAxes.Count > 0
                        && o.xAxes[0].type == ChartAxisType.Category
                        && o.xAxes[0].categories.Count == 0) {
                        for (int rb2 = 0; rb2 < ds2.RowCount(); rb2 = rb2 + 1) {
                            o.xAxes[0].categories.Add(ds2.Text(rb2, lc));
                        }
                    } else if (o.yAxes.Count > 0
                        && o.yAxes[0].type == ChartAxisType.Category
                        && o.yAxes[0].categories.Count == 0) {
                        for (int rb3 = 0; rb3 < ds2.RowCount(); rb3 = rb3 + 1) {
                            o.yAxes[0].categories.Add(ds2.Text(rb3, lc));
                        }
                    }
                } else {
                    // line/bar/scatter 共用。官方的数值轴智能推断
                    // 只发生在**解析期无 type** 时（axisModelCreator
                    // 这里能见到 Category 且类目为空的唯一形态 =
                    // 用户**显式声明**了 type:'category'（data 回填的
                    // 类目轴 Count>0，无 type 空对象在解析期已是
                    // Value）——显式 type 不得翻（data-transform-filter
                    // 的 Year 列全数值，曾被翻成 value 轴后零锚域
                    // 把 1950..2015 全钳到绘图区右缘）。
                    int xai2 = cs.axisIndex < o.xAxes.Count ? cs.axisIndex : 0;
                    bool xIsCat = o.xAxes.Count > 0
                        && o.xAxes[xai2].type == ChartAxisType.Category;
                    int yai2 = cs.axisIndex < o.yAxes.Count ? cs.axisIndex : 0;
                    bool yIsCat = o.yAxes.Count > 0
                        && o.yAxes[yai2].type == ChartAxisType.Category;
                    if (cs.type == ChartType.Scatter) {
                        // 散点：千倍定点存 points。类目侧（箱线
                        // 离群点 / 聚合明细散点）在回填好的类目
                        // 轴里查序号 ×1000，数值侧取值 ×1000。
                        // 第三维（聚类号/气泡值）进 point.z。
                        cs.pointG = 1000;
                        int w = ds2.Width();
                        for (int r4 = 0; r4 < ds2.RowCount(); r4 = r4 + 1) {
                            int px = xIsCat
                                ? ChartJsonDataset.CatIdx1000(
                                    o.xAxes[xai2], ds2.Text(r4, xcol))
                                : ChartJsonDataset.Mul1000(ds2.Num(r4, xcol));
                            int py = yIsCat
                                ? ChartJsonDataset.CatIdx1000(
                                    o.yAxes[yai2], ds2.Text(r4, ycol))
                                : ChartJsonDataset.Mul1000(ds2.Num(r4, ycol));
                            ChartPoint p = ChartPoint.Of(px, py);
                            if (w > 2) { p.z = (int)ds2.Num(r4, 2); }
                            cs.points.Add(p);
                        }
                        ChartJsonDataset.PieceColorPoints(o, cs);
                    } else if (yIsCat && !xIsCat) {
                        // 横条（encode0）：类目在 y 列，值取 x 列。
                        for (int r5 = 0; r5 < ds2.RowCount(); r5 = r5 + 1) {
                            cs.data.Add(ChartData.NamedNumber(
                                ds2.Num(r5, xcol), ds2.Text(r5, ycol)));
                        }
                        if (cs.name.Length == 0) { cs.name = ds2.Header(xcol); }
                    } else if (xIsCat) {
                        for (int r6 = 0; r6 < ds2.RowCount(); r6 = r6 + 1) {
                            cs.data.Add(ChartData.NamedNumber(
                                ds2.Num(r6, ycol), ds2.Text(r6, xcol)));
                        }
                        if (cs.name.Length == 0) { cs.name = ds2.Header(ycol); }
                    } else if (cs.type == ChartType.Line) {
                        // 双数值轴折线（回归拟合线）：数值点。
                        cs.pointG = 1000;
                        for (int r7 = 0; r7 < ds2.RowCount(); r7 = r7 + 1) {
                            cs.points.Add(ChartPoint.Of(
                                ChartJsonDataset.Mul1000(ds2.Num(r7, xcol)),
                                ChartJsonDataset.Mul1000(ds2.Num(r7, ycol))));
                        }
                    }
                }
            }
        }
    }

    private static void ParseSeriesRadarOrAppend(ChartOption o, ChartSeries cs, JsonValue da) {
        // radar 数据项值数组物化（官方语义）：radar 系列的每个
        // data 项是一条独立多边形——对象项 {value:[每轴值],
        // name:"多边形名"} 或裸数组 [v0,v1,...]。旧标量车道
        // Double("value") 对数组取 0，整图塌成圆心一个点（radar
        // 主力 demo 即坏）。物化成每项一个系列：图例取数据项名
        // （未命名的继承系列名——radar-aqi 31 天同名，图例的
        // "同名系列随主项一起开关"语义天然成立）；样式拷自源
        // 系列（城色是显式 itemStyle.color，随 Clone 带走），
        // 逐项 symbol/symbolSize/lineStyle/itemStyle 覆写落到
        // 物化系列（radar-custom 的 rect 符号）。值 ×1000 定点
        // （radarScaled），radarMax/indicatorMax 同步放大，
        // tooltip 显示走 FracText 除回——0.46 这类小数不丢。
        if (cs.type == ChartType.Radar && da != null && da.IsArray()
            && da.Count() > 0) {
            bool rmatAny = false;
            for (int rmatV = 0; rmatV < da.Count(); rmatV = rmatV + 1) {
                JsonValue rmatIt = da.At(rmatV);
                if (rmatIt == null) { continue; }
                if (rmatIt.IsArray()) { rmatAny = true; break; }
                if (rmatIt.IsObject()) {
                    JsonValue rmatVv = rmatIt.Get("value");
                    if (rmatVv != null && rmatVv.IsArray()) {
                        rmatAny = true; break;
                    }
                }
            }
            if (rmatAny) {
                // 满刻度放大只做一次：本块逐系列进（radar-multiple
                // 是 3 个雷达系列），重复进会把 radarMax/
                // indicatorMax 连乘 1000（100 → 1e8）。首个带向量
                // 项的系列触发，其后系列只物化自己的数据项。
                if (!o.radarScaled) {
                    if (o.radarIndicators != null) {
                        for (int rmatInd = 0; rmatInd < o.radarIndicators.Count; rmatInd = rmatInd + 1) {
                            if (o.radarIndicators[rmatInd].max > 0) {
                                o.radarIndicators[rmatInd].max = o.radarIndicators[rmatInd].max * 1000;
                            }
                        }
                    }
                    for (int rmatM = 0; rmatM < o.radarMax.Count; rmatM = rmatM + 1) {
                        if (o.radarMax[rmatM] > 0) {
                            o.radarMax[rmatM] = o.radarMax[rmatM] * 1000;
                        }
                    }
                    for (int rmatPg = 0; rmatPg < o.polars.Count; rmatPg = rmatPg + 1) {
                        for (int rmatPm = 0; rmatPm < o.polars[rmatPg].indicators.Count;
                             rmatPm = rmatPm + 1) {
                            if (o.polars[rmatPg].indicators[rmatPm].max > 0) {
                                o.polars[rmatPg].indicators[rmatPm].max =
                                    o.polars[rmatPg].indicators[rmatPm].max * 1000;
                            }
                        }
                        for (int rmatPm2 = 0; rmatPm2 < o.polars[rmatPg].indicatorMax.Count;
                             rmatPm2 = rmatPm2 + 1) {
                            if (o.polars[rmatPg].indicatorMax[rmatPm2] > 0) {
                                o.polars[rmatPg].indicatorMax[rmatPm2] =
                                    o.polars[rmatPg].indicatorMax[rmatPm2] * 1000;
                            }
                        }
                    }
                }
                o.radarScaled = true;
                for (int rmatI = 0; rmatI < da.Count(); rmatI = rmatI + 1) {
                    JsonValue rmatIt2 = da.At(rmatI);
                    JsonValue rmatVv2 = rmatIt2.IsObject()
                        ? rmatIt2.Get("value") : rmatIt2;
                    if (rmatVv2 == null || !rmatVv2.IsArray()
                        || rmatVv2.Count() < 1) { continue; }
                    ChartSeries rmatS = ChartSeries.Of(
                        rmatIt2.IsObject() ? rmatIt2.Str("name", "") : "",
                        ChartType.Radar, new List<int>());
                    if (rmatS.name.Length == 0) { rmatS.name = cs.name; }
                    rmatS.color = cs.color;
                    rmatS.areaStyle = cs.areaStyle;
                    rmatS.symbol = cs.symbol;
                    rmatS.symbolSize = cs.symbolSize;
                    rmatS.showSymbol = cs.showSymbol;
                    rmatS.polarIndex = cs.polarIndex;
                    rmatS.z = cs.z;
                    if (cs.itemStyle != null) {
                        rmatS.itemStyle = ChartItemStyle.Clone(cs.itemStyle);
                    }
                    if (rmatIt2.IsObject()) {
                        if (rmatIt2.Has("symbol")) {
                            rmatS.symbol = ChartKinds.SymbolSanitize(
                                rmatIt2.Str("symbol", ""));
                        }
                        if (rmatIt2.Has("symbolSize")) {
                            rmatS.symbolSize = rmatIt2.Int("symbolSize", 0);
                        }
                        JsonValue rmatLs = rmatIt2.Get("lineStyle");
                        if (rmatLs != null && rmatLs.IsObject()) {
                            JsonValue rmatLc = rmatLs.Get("color");
                            if (rmatLc != null) {
                                rmatS.itemStyle.normal.lineStyle.color =
                                    ChartOption.ParseColor(rmatLc, 0);
                            }
                            JsonValue rmatLw = rmatLs.Get("width");
                            if (rmatLw != null && rmatLw.IsNumber()) {
                                rmatS.itemStyle.normal.lineStyle.width =
                                    (int)rmatLw.AsDouble(0.0);
                            }
                            string rmatLt = rmatLs.Str("type", "");
                            if (rmatLt.Length > 0) {
                                rmatS.itemStyle.normal.lineStyle.type = rmatLt;
                            }
                        }
                        JsonValue rmatIs = rmatIt2.Get("itemStyle");
                        if (rmatIs != null && rmatIs.IsObject()) {
                            ChartOption.ParseItemStyle(rmatIs, rmatS.itemStyle);
                        }
                    }
                    for (int rmatAj = 0; rmatAj < rmatVv2.Count();
                         rmatAj = rmatAj + 1) {
                        double rmatDv = rmatVv2.At(rmatAj).AsDouble(0.0);
                        int rmatKv = (int)(rmatDv >= 0.0
                            ? rmatDv * 1000.0 + 0.5
                            : rmatDv * 1000.0 - 0.5);
                        ChartData rmatCd = ChartData.Of(0);
                        rmatCd.val = rmatKv;
                        rmatCd.number = (double)rmatKv;
                        rmatCd.numberSet = true;
                        rmatS.data.Add(rmatCd);
                    }
                    o.series.Add(rmatS);
                }
            } else { o.series.Add(cs); }
        } else {
            o.series.Add(cs);
        }
    }
}
