using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartMatrixBandNode {
    public string text;
    public int level;
    public int first;
    public int span;
    public int kind;
    public ChartBoxParam size;

    public ChartMatrixBandNode(string text, int level, int first, int span, int kind, ChartBoxParam size) {
        this.text = text != null ? text : "";
        this.level = level;
        this.first = first;
        this.span = span;
        this.kind = kind;
        this.size = size;
    }
}

// 矩阵名称查找条目实体（取代 qName/qIdx/qIsX 平行列表）
