using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// 力导向图的一个节点（布局输出；整数像素坐标）。
public class ForceNode {
    public string name;
    public int x;
    public int y;
    public int weight;  // 入 + 出
    public string symbol;  // 形状族（系列显式 tree 节点按名匹配；"" = 圆）
    public int size;  // 直径像素；0 = 按权重自动

    // 构造一个力导向节点（symbol = ""、size = 0 即圆 + 按权重
    // 自动直径）。
    public static ForceNode Of(string name, int x, int y, int weight) {
        ForceNode nd = new ForceNode();
        nd.name = name;
        nd.x = x;
        nd.y = y;
        nd.weight = weight;
        nd.symbol = "";
        nd.size = 0;
        return nd;
    }
}
