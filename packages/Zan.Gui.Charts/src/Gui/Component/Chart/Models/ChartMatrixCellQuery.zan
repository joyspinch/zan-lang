using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartMatrixCellQuery {
    public string name;
    public int index;
    public bool isX;

    public ChartMatrixCellQuery(string name, int index, bool isX) {
        this.name = name != null ? name : "";
        this.index = index;
        this.isX = isX;
    }
}

