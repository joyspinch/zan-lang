using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartZoom {
    public bool slider;  // type=='slider'（缺省）；inside = false（纯交互无条）
    public bool show;  // show（缺省 true；false = 整条隐藏，窗口仍生效）
    public bool realtime;  // 拖拽时是否实时更新（缺省 true）
    public bool showDetail;  // showDetail（缺省 true；拖拽时手柄侧标签开关）
    public bool zoomLock;  // zoomLock：窗口跨度锁定，只能平移
    public bool brushSelect;  // brushSelect（缺省 true）：底部 moveHandle 拖带
    public int start;  // 窗口起点百分比 0..100（缺省 0）
    public int end;  // 窗口终点百分比（缺省 100）
    public int axisIndex;  // 靶向轴下标（xAxisIndex/yAxisIndex 首项）；-1 = 缺省 0
    public bool isY;  // yAxisIndex 靶向（纵向条）；false = x（横向条）
    public int shadowMode;  // showDataShadow：0 'auto'（缺省）| 1 true | 2 false
    public int handleSize;  // handleSize 百分比（100 缺省；0 = 无手柄）；数值 px 另记
    public int handleSizePx;  // handleSize 数值形态（px；-1 = 未声明，走百分比）
    public int minValueSpan;  // 数据单位最小窗口；0 = 未声明
    public int minSpan;  // 百分比最小窗口；0 = 未声明
    public int height;  // height px；-1 = 缺省 30（DEFAULT_FILLER_SIZE）
    public int heightPct;  // height 'N%'；-1 = 未声明
    public int width;  // width px（纵向）；-1 = 缺省 30
    public int widthPct;  // width 'N%'；-1 = 未声明
    public int top;  // top px；-1 未声明
    public int topPct;  // top 'N%'；-1 未声明
    public int bottom;  // bottom px；-1 未声明（缺省贴 edgeGap 15）
    public int bottomPct;  // bottom 'N%'；-1 未声明
    public int left;  // left px；-1 未声明
    public int leftPct;  // left 'N%'；-1 未声明
    public int right;  // right px；-1 未声明
    public int rightPct;  // right 'N%'；-1 未声明
    public int borderColor;  // borderColor；0 = 缺省 accent10 #e0e4f2
    public int fillerColor;  // fillerColor；0 = 缺省 rgba(135,175,274,.2)
    public int textStyleColor;  // textStyle.color；0 = 缺省 neutral60 #6d6e73
    public int dbAreaColor;  // dataBackground.areaStyle.color；0 = 缺省 accent20
    public int dbLineColor;  // dataBackground.lineStyle.color；0 = 缺省 accent30
    public int selDbAreaColor;  // selectedDataBackground.areaStyle.color；0 = 缺省
    public int selDbLineColor;  // selectedDataBackground.lineStyle.color；0 = 缺省 accent40
    public string startValue;  // 类目定位窗口起点（"" = 未声明）
    public string endValue;  // 类目定位窗口终点
    public string labelFormatter;  // null = 未声明；"" = 抑制标签；含 {value} 占位
    public string handleIcon;  // null = 官方缺省 grip；声明 path 时引擎仍画缺省形
    public string filterMode;  // 过滤模式："filter"（缺省）| "weakFilter" | "empty" | "none"
    public bool zoomOnMouseWheel;  // 滚轮缩放控制（缺省 true）
    public bool moveOnMouseMove;  // 鼠标移动平移控制（缺省 true）
    public bool moveOnMouseWheel;  // 滚轮平移控制（缺省 false）
    public int throttle;  // 交互防抖节流间隔 ms（缺省 100）

    public static ChartZoom Of() {
        ChartZoom c = new ChartZoom();
        c.slider = true;
        c.show = true;
        c.realtime = true;
        c.showDetail = true;
        c.zoomLock = false;
        c.brushSelect = true;
        c.start = 0;
        c.end = 100;
        c.axisIndex = 0 - 1;
        c.isY = false;
        c.shadowMode = 0;
        c.handleSize = 100;
        c.handleSizePx = 0 - 1;
        c.minValueSpan = 0;
        c.minSpan = 0;
        c.height = 0 - 1; c.heightPct = 0 - 1;
        c.width = 0 - 1; c.widthPct = 0 - 1;
        c.top = 0 - 1; c.topPct = 0 - 1;
        c.bottom = 0 - 1; c.bottomPct = 0 - 1;
        c.left = 0 - 1; c.leftPct = 0 - 1;
        c.right = 0 - 1; c.rightPct = 0 - 1;
        c.borderColor = 0; c.fillerColor = 0; c.textStyleColor = 0;
        c.dbAreaColor = 0; c.dbLineColor = 0;
        c.selDbAreaColor = 0; c.selDbLineColor = 0;
        c.startValue = ""; c.endValue = "";
        c.labelFormatter = null;
        c.handleIcon = null;
        c.filterMode = "filter";
        c.zoomOnMouseWheel = true;
        c.moveOnMouseMove = true;
        c.moveOnMouseWheel = false;
        c.throttle = 100;
        return c;
    }

    // 深复制；src 为 null 时返回 null。
    // 面向对象深复制实例方法。
    public ChartZoom Clone() {
        ChartZoom c = new ChartZoom();
        c.slider = this.slider; c.show = this.show;
        c.realtime = this.realtime;
        c.showDetail = this.showDetail; c.zoomLock = this.zoomLock;
        c.brushSelect = this.brushSelect;
        c.start = this.start; c.end = this.end;
        c.axisIndex = this.axisIndex; c.isY = this.isY;
        c.shadowMode = this.shadowMode;
        c.handleSize = this.handleSize; c.handleSizePx = this.handleSizePx;
        c.minValueSpan = this.minValueSpan; c.minSpan = this.minSpan;
        c.height = this.height; c.heightPct = this.heightPct;
        c.width = this.width; c.widthPct = this.widthPct;
        c.top = this.top; c.topPct = this.topPct;
        c.bottom = this.bottom; c.bottomPct = this.bottomPct;
        c.left = this.left; c.leftPct = this.leftPct;
        c.right = this.right; c.rightPct = this.rightPct;
        c.borderColor = this.borderColor; c.fillerColor = this.fillerColor;
        c.textStyleColor = this.textStyleColor;
        c.dbAreaColor = this.dbAreaColor; c.dbLineColor = this.dbLineColor;
        c.selDbAreaColor = this.selDbAreaColor; c.selDbLineColor = this.selDbLineColor;
        c.startValue = this.startValue; c.endValue = this.endValue;
        c.labelFormatter = this.labelFormatter; c.handleIcon = this.handleIcon;
        c.filterMode = this.filterMode;
        c.zoomOnMouseWheel = this.zoomOnMouseWheel;
        c.moveOnMouseMove = this.moveOnMouseMove;
        c.moveOnMouseWheel = this.moveOnMouseWheel;
        c.throttle = this.throttle;
        return c;
    }

    public static ChartZoom Clone(ChartZoom src) {
        if (src == null) { return null; }
        return src.Clone();
    }
}
