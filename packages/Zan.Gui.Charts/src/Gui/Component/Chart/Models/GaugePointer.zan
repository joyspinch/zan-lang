using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

class GaugePointer {
    bool show;
    ChartScalar length;
    int width;
    int color;
    int shadowColor;
    int shadowBlur;

    // 构造默认指针：ECharts 默认长 80%、宽 8px；
    // color 0 = 'auto'（跟随轴线色阶段色，见 DrawGauge）。
    static GaugePointer Create() {
        return new GaugePointer {
            show = true, length = ChartScalar.Pct(80), width = 8, color = 0, shadowColor = 0, shadowBlur = 0
        };
    }

    // 深复制；src 为 null 时返回 null。
    static GaugePointer Clone(GaugePointer src) {
        if (src == null) { return null; }
        return new GaugePointer { show = src.show, length = ChartScalar.Clone(src.length), width = src.width,
            color = src.color, shadowColor = src.shadowColor, shadowBlur = src.shadowBlur };
    }
}

// 仪表盘标题（系列名）：开关、相对圆心的偏移与文本样式。
