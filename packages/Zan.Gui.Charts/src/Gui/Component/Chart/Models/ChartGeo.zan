using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

class ChartGeo {
    string map;  // 注册表地图名
    bool roam;  // 漫游（缩放/平移）
    bool labelShow;  // label.show：区域名标签
    ChartTextStyle labelSt;  // geo.label 文本样式（textBorder*/textShadow*，
    string selectedMode;  // ""/"single" | "multiple" | "false"
    int areaColor;  // itemStyle.areaColor；0 = 不覆盖
    int borderColor;  // itemStyle.borderColor；0 = 不覆盖
    int borderWidth;  // itemStyle.borderWidth（官方缺省 0.5）；
                         // -1 = 未声明（渲染器落官方缺省）
    List<ChartMapRegion> regions;  // regions[] 覆盖（stub 或带 ring）
    // matrix 锚定（mini-bar-geo 的 10 面州地图逐格落位）。
    bool matAnchor;
    int mx0; int mx1;
    int my0; int my1;

    static ChartGeo Of() {
        ChartGeo g = new ChartGeo();
        g.map = "";
        g.roam = false;
        g.labelShow = false;
        g.labelSt = null;
        g.selectedMode = "";
        g.areaColor = 0;
        g.borderColor = 0;
        g.borderWidth = 0 - 1;
        g.regions = new List<ChartMapRegion>();
        g.matAnchor = false;
        g.mx0 = 0; g.mx1 = 0;
        g.my0 = 0; g.my1 = 0;
        return g;
    }

    static ChartGeo Clone(ChartGeo src) {
        if (src == null) { return null; }
        ChartGeo g = ChartGeo.Of();
        g.map = src.map;
        // matrix 锚格（coordinateSystem:"matrix" + coord）：resolved
        // drawOption 的 geos 走本克隆过河——漏拷等于锚格全灭（
        // matrix-mini-bar-geo 10 个 map 只剩骨架的根因）。
        g.matAnchor = src.matAnchor;
        g.mx0 = src.mx0; g.mx1 = src.mx1;
        g.my0 = src.my0; g.my1 = src.my1;
        g.roam = src.roam;
        g.labelShow = src.labelShow;
        g.labelSt = ChartTextStyle.Clone(src.labelSt);
        g.selectedMode = src.selectedMode;
        g.areaColor = src.areaColor;
        g.borderColor = src.borderColor;
        g.borderWidth = src.borderWidth;
        for (int i = 0; i < src.regions.Count; i = i + 1) {
            g.regions.Add(ChartMapRegion.Clone(src.regions[i]));
        }
        return g;
    }
}

// 平行坐标的一根轴（ECharts parallelAxis[dim]）：轴名、显式
// min/max、类目维的类目表。渲染时 min/max 缺省由该维数据推导。
