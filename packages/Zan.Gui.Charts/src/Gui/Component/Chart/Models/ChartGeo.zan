using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartGeo {
    public string map;  // 注册表地图名
    public bool roam;  // 漫游（缩放/平移）
    public bool labelShow;  // label.show：区域名标签
    public ChartTextStyle labelSt;  // geo.label 文本样式（textBorder*/textShadow*，
    public string selectedMode;  // ""/"single" | "multiple" | "false"
    public int areaColor;  // itemStyle.areaColor；0 = 不覆盖
    public int borderColor;  // itemStyle.borderColor；0 = 不覆盖
    public int borderWidth;  // itemStyle.borderWidth（官方缺省 0.5）；
                         // -1 = 未声明（渲染器落官方缺省）
    public List<ChartMapRegion> regions;  // regions[] 覆盖（stub 或带 ring）
    public double aspectScale;  // 纵横比映射（官方缺省 0.75）
    public double zoom;  // 地图初始缩放比例（官方缺省 1.0）
    public string layoutCenter;  // 相对容器定位中心（如 ['50%', '50%']）
    public string layoutSize;  // 地图大小（如 '100%' 或数值）
    // matrix 锚定（mini-bar-geo 的 10 面州地图逐格落位）。
    public bool matAnchor;
    public int mx0; public int mx1;
    public int my0; public int my1;

    public static ChartGeo Of() {
        ChartGeo g = new ChartGeo();
        g.map = "";
        g.roam = false;
        g.labelShow = false;
        g.labelSt = null;
        g.selectedMode = "";
        g.areaColor = 0;
        g.borderColor = 0;
        g.borderWidth = 0 - 1;
        g.regions = new List<ChartMapRegion>();
        g.aspectScale = 0.75;
        g.zoom = 1.0;
        g.layoutCenter = "";
        g.layoutSize = "";
        g.matAnchor = false;
        g.mx0 = 0; g.mx1 = 0;
        g.my0 = 0; g.my1 = 0;
        return g;
    }

    // 面向对象深复制实例方法。


    public ChartGeo Clone() {
        ChartGeo g = ChartGeo.Of();
        g.map = this.map;
        // matrix 锚格（coordinateSystem:"matrix" + coord）：resolved
        // drawOption 的 geos 走本克隆过河——漏拷等于锚格全灭（
        // matrix-mini-bar-geo 10 个 map 只剩骨架的根因）。
        g.matAnchor = this.matAnchor;
        g.mx0 = this.mx0; g.mx1 = this.mx1;
        g.my0 = this.my0; g.my1 = this.my1;
        g.roam = this.roam;
        g.labelShow = this.labelShow;
        g.labelSt = this.labelSt != null ? this.labelSt.Clone() : null;
        g.selectedMode = this.selectedMode;
        g.areaColor = this.areaColor;
        g.borderColor = this.borderColor;
        g.borderWidth = this.borderWidth;
        g.aspectScale = this.aspectScale;
        g.zoom = this.zoom;
        g.layoutCenter = this.layoutCenter;
        g.layoutSize = this.layoutSize;
        for (int i = 0; i < this.regions.Count; i = i + 1) {
            ChartMapRegion r = this.regions[i];
            g.regions.Add(r != null ? r.Clone() : null);
        }
        return g;
    }

    public static ChartGeo Clone(ChartGeo src) {
        if (src == null) { return null; }
        return src.Clone();
    }
}
