using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartNode {
    public string name;
    public int val;
    public string id;  // ECharts data 节点 id（treemap colorMappingBy:'id' 的
                     // 映射键 = DFS 序号，官方 mapIdToIndex）
    public int color;  // 逐节点 itemStyle.color（0 = 继承级样式）
    public List<int> vals;  // value 数组形态（obama 的多维 value），null = 标量
    public string symbol;  // ECharts force symbol 逐节点形状（"" = 圆）
    public int size;  // 逐节点尺寸（直径像素；0 = 自动）
    public bool collapsed;  // ECharts data 节点 collapsed:true = 折叠子树
    public List<ChartNode> children;

    // 构造叶子节点（自带值，无子节点）。
    public static ChartNode Leaf(string name, int val) {
        ChartNode n = new ChartNode();
        n.name = name;
        n.val = val;
        n.id = "";
        n.color = 0;
        n.symbol = "";
        n.size = 0;
        n.children = new List<ChartNode>();
        return n;
    }

    // 构造组节点（值由子节点推导，val 置 0）。
    public static ChartNode Group(string name, List<ChartNode> children) {
        ChartNode n = new ChartNode();
        n.name = name;
        n.val = 0;
        n.id = "";
        n.color = 0;
        n.symbol = "";
        n.size = 0;
        n.children = children;
        return n;
    }

    // 带显式 value 的组节点（ECharts data 节点的 value 字段，
    // 不等于子树累计时以显式值为准，tooltip 用）。
    public static ChartNode GroupVal(string name, int val, List<ChartNode> children) {
        ChartNode n = ChartNode.Group(name, children);
        n.val = val;
        return n;
    }

    // 形状 + 尺寸变体（force 分类符号：diamond/triangle/rectangle…）。
    public static ChartNode Shaped(string name, int val, string symbol, int size) {
        ChartNode n = ChartNode.Leaf(name, val);
        n.symbol = ChartKinds.SymbolSanitize(symbol);
        n.size = size;
        return n;
    }

    // value 维度取值（visualDimension 缺省 0 = val；数组形态取
    // 对应维，越界退 val）。
    public int ValueOf(int dim) {
        if (dim > 0 && vals != null && dim < vals.Count) { return vals[dim]; }
        return val;
    }

    // 深复制整棵子树；src 为 null 时返回 null。
    public static ChartNode Clone(ChartNode src) {
        if (src == null) { return null; }
        ChartNode n = new ChartNode();
        n.name = src.name; n.val = src.val; n.symbol = src.symbol; n.size = src.size;
        n.id = src.id; n.color = src.color;
        if (src.vals != null) {
            n.vals = new List<int>();
            for (int i = 0; i < src.vals.Count; i = i + 1) { n.vals.Add(src.vals[i]); }
        }
        n.collapsed = src.collapsed;
        n.children = new List<ChartNode>();
        int childCount = src.children == null ? 0 : src.children.Count;
        for (int i = 0; i < childCount; i = i + 1) {
            ChartNode child = ChartNode.Clone(src.children[i]);
            if (child != null) { n.children.Add(child); }
        }
        return n;
    }

    // 此节点下所有叶子值的总和（组的总量）。
    public int Total() {
        if (this.children == null || this.children.Count == 0) { return this.val; }
        int sum = 0;
        for (int i = 0; i < this.children.Count; i = i + 1) {
            if (this.children[i] != null) { sum = sum + this.children[i].Total(); }
        }
        return sum;
    }
}

// Sankey 图的有向流转链接：从节点 -> 到节点，带一个值
// （链接粗细）。节点在渲染时从链接推导。
