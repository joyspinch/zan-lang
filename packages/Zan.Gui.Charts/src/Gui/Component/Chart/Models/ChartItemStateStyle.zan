using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartItemStateStyle {
    public int color;
    public int color0;  // ECharts K线：阴线填充色（与 color 配对）
    public int borderColor;
    public int borderColor0;  // ECharts K线：阴线边框/影线色（与 borderColor 配对）
    public int borderWidth;
    // itemStyle.borderRadius：最多四个元素 [tl,tr,br,bl]；
    // 单数值解析为四角同值。空表 = 未设置（渲染器用缺省圆角）。
    public List<int> borderRadius;
    public List<int> gradStops;  // itemStyle.color 为渐变时的色标列表（ARGB）
    public ChartLineStyle lineStyle;
    public ChartAreaStyle areaStyle;

    // 构造空样式（颜色 0 = 跟随主题，borderRadius 空表 = 缺省圆角）。
    public static ChartItemStateStyle Create() {
        ChartItemStateStyle st = new ChartItemStateStyle {
            color = 0, borderColor = 0, borderWidth = 0,
            lineStyle = ChartLineStyle.Of(0, 0), areaStyle = ChartAreaStyle.Create()
        };
        st.borderRadius = new List<int>();
        return st;
    }
}

// ECharts itemStyle：normal 与 emphasis 两套状态样式。
