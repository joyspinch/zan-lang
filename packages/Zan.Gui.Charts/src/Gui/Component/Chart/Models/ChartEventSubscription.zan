using System;

namespace Gui.Component.Chart;

// 一条订阅记录：事件类型与处理器的配对（仅 ChartEventHub 内部使用）。
public class ChartEventSubscription {
    public ChartEventType type;
    public ChartInteractionHandler handler;

    // 构造一条订阅。
    public ChartEventSubscription(ChartEventType type, ChartInteractionHandler handler) {
        this.type = type;
        this.handler = handler;
    }
}
