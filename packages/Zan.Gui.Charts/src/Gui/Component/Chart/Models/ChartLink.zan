using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartLink {
    public string from;
    public string to;
    public int val;

    // 构造一条流转链接；val 为链接粗细。
    public static ChartLink Of(string from, string to, int val) {
        ChartLink l = new ChartLink();
        l.from = from;
        l.to = to;
        l.val = val;
        return l;
    }

    // 深复制；src 为 null 时返回 null。
    public static ChartLink Clone(ChartLink src) {
        if (src == null) { return null; }
        return ChartLink.Of(src.from, src.to, src.val);
    }
}

// 图节点平面位置坐标实体（消除 nodeX 与 nodeY、startX 与 startY 平行列表反模式）。
