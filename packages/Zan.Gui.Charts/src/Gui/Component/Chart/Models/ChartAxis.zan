using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartAxis {
    ChartAxisType type;
    string title;  // 轴名称（ECharts name），"" = 无
    // 显式下/上界：整型快照 min/max 与高精度浮点 minD/maxD 保持双精度同步；
    // D 后缀是 double 真值：line-easing 写 min:-0.4 / max:1.4，
    // 只留 int 会把 -0.4 截成 0，轴整体错位、刻度全变整数。
    // Auto() / AutoD() = 从数据推导。写的时候两个一起维护（见 SetRange）。
    int min;
    int max;
    double minD;
    double maxD;
    bool minDataB;  // min:'dataMin' 字面量（本 slice 按未声明处理，接线待续）
    bool maxDataB;  // max:'dataMax' 字面量
    // ECharts ValueAxisBaseOption.scale：true = 量程只按数据（不并入 0）。
    // 出处 `coord/axisModelCommonMixin.ts:33 needIncludeZero() = !option.scale`，
    // 且只对 interval scale（数值轴）适用——对数/时间/类目轴不适用
    // （`coord/scaleRawExtentInfo.ts:301-303`）。
    bool scale;
    bool reversed;  // 翻转轴（ECharts inverse）
    int ticks;  // 数值轴刻度数（默认 5）
    bool showGrid;  // 为此轴绘制网格线
    bool splitLineDeclared;  // splitLine 显式声明过——按维度的官方默认
                      // （xAxis false / yAxis true）只对未声明轴生效
    int splitColor;  // splitLine.lineStyle.color；0 = 主题网格色
    int splitWidth;  // splitLine.lineStyle.width；0 = 1
    int axisPointerShow;  // 轴级静态 axisPointer：-1 未声明（官方缺省
                      // 不画）/ 1 显式 true / 0 显式 false
    double apValue;  // axisPointer.value 锚点（时间轴 = epoch 天，
                      // 数值轴 = 原值）
    bool apValueSet;  // value 是否声明
    int apColor;  // axisPointer.lineStyle.color；0 = 轴色
    int apWidth;  // axisPointer.lineStyle.width；0 = 1
    bool apLabelShow;  // axisPointer.label.show
    int apLabelBg;  // axisPointer.label.backgroundColor；0 = 主题
    bool splitArea;  // ECharts splitArea.show：数值轴相邻刻度交替底纹
                      // （数值轴默认关——引擎随现行现代 ECharts 标准默认 false）
    int labelRotate;  // ECharts axisLabel.rotate：度（钳 -90..90），0 = 水平
    int labelInterval;  // ECharts axisLabel.interval：-1 = 自动防重叠，>=0 = 每 (n+1) 个画一个
    int labelMargin;  // ECharts axisLabel.margin：标签与轴线的像素距离（bump-chart 30）
    bool labelShow;  // ECharts axisLabel.show：false = 整组刻度标签不画
    bool labelInside;  // ECharts axisLabel.inside：true = 标签置于网格/绘图区内侧
    int labelColor;  // ECharts axisLabel.color：刻度标签颜色；0 = 走主题轴色
    int labelFontSize;  // ECharts axisLabel.fontSize：-1 = 未声明
    bool axisTickShow;  // ECharts axisTick.show：默认 true（类目与数值轴默认画刻度短须）
    bool axisTickAlignWithLabel;  // ECharts axisTick.alignWithLabel：类目轴为 true 时刻度对齐标签
    bool axisTickInside;  // ECharts axisTick.inside：刻度向坐标系内部延伸
    int axisTickLength;  // ECharts axisTick.length：刻度长度（默认 5）
    int axisTickColor;  // ECharts axisTick.lineStyle.color；0 = 走轴线/刻度色
    int axisTickWidth;  // ECharts axisTick.lineStyle.width；0 = 1
    string nameLocation;  // ECharts nameLocation："start"|"middle"|"end"
                         // 官方缺省 'end'（coord/axisDefault.ts:34）
    int nameGap;  // ECharts nameGap：轴名与轴线的像素间距，
                         // 官方缺省 15（coord/axisDefault.ts:47）；
                         // -1 = 未声明（走缺省）
    int gridIndex;  // ECharts axis.gridIndex：多 grid 布局归属，缺省 0
    int nameColor;  // ECharts nameTextStyle.color；0 = 走主题色
    int nameFontSize;  // ECharts nameTextStyle.fontSize；-1 = 未声明
    int offset;  // ECharts axis.offset：相对缺省位置的偏移像素（多轴同侧如 multiple-y-axis）
    string labelFormatter;  // ECharts axisLabel.formatter，"{value} °C" 模板
    ChartTextStyle labelSt;  // axisLabel 富文本/盒样式表；null = 未声明 rich。
                            // intraday-breaks-1 周末置灰。声明了 rich 才建
                            // （ParseTextStyle 单点解析），其余轴渲染不变
    bool labelNegate;  // ECharts axisLabel.formatter 为 function(v){return -v}
                       // 的等价开关：刻度/工具提示按 -值 显示（雨量图负值轴）
    bool boundaryGap;  // ECharts boundaryGap（类目轴默认 true：点落在格中）
    // boundaryGap 数组形态（数值轴 extent 外扩）：[下外扩, 上外扩]，
    // 以原始 span 的千分比记（'100%' = 1000）。0 = 未声明/0%。
    // 官方 fixExtentWithBoundaryGap：rawMin -= span·bg0，rawMax +=
    // span·bg1，在 nice 之前施加（area-time-axis [0,'100%'] →
    // 官方 extent -600..1200）。
    int bgLoF;
    int bgHiF;
    int axisLineColor;  // ECharts axisLine.lineStyle.color；0 = 主题色
    int axisLineShow;  // ECharts axisLine.show 三态：-1 = 未声明（走 'auto'）、
                       // 0 = 显式 false、1 = 显式 true。'auto' 的判定：
                       // 类目轴恒画（axisDefault.ts:162 的 show:true，
                       // categoryAxis 不覆盖）；value/log/time 在
                       // cartesianAxisHelper.ts:169-181 里只有当**同网格**
                       // 对侧轴是 value/log 时才画。
    int onZero;  // ECharts axisLine.onZero 三态：-1 = 未声明（按 'auto'）、
                       // 0 = 显式 false、1 = 显式 true。'auto' 与 true 在
                       // 本引擎里等价（discourageOnAxisZero 只在
                       // containShape 真的扩过量程时才置位，见 Grid.ts:677）。
    bool show;  // ECharts axis.show：false = 整条轴（线/刻度/标签）不画
    string position;  // ECharts xAxis/yAxis.position，轴级键（不是
                       // y = "left"/"right"；"" = 未声明（官方缺省
                       // bottom/left，见 Grid.ts:464-479）。
    string axisId;  // ECharts axis.id：series 经 xAxisId/yAxisId 按名引用
    // nice 步长的钳制上下界，只对 interval/time 刻度生效
    // AutoD() = 未声明（源码里的 null 分支）。语义出处
    double minInterval;
    double maxInterval;
    // ECharts axis.alignTicks（axisCommonTypes.ts:186）：与**同网格**
    // 的对齐轴共用刻度（Grid.ts:738-756 挑 alignTo）。本引擎的
    // BuildAxesR 一次只解左/右两条轴，对齐只在这两条之间做。
    bool alignTicks;
    // ECharts minorTick.show（axisDefault.ts:192 缺省 false）+
    // minorSplitLine.show（:202 缺省 false）：细分刻度线与细分网格线。
    // 类目轴不支持（Axis.ts:204 isOrdinalScale 直接返回空）。
    bool minorTickShow;
    int minorTickSplitNumber;  // 缺省 5（axisDefault.ts:194）
    bool minorSplitLineShow;
    // 数值/时间轴断带（类目轴不支持，Axis.ts 声明即报错——解析照收、
    // 渲染侧按轴类型忽略）。gapReal 在量程定型后解算。
    List<ChartBreak> breaks;
    bool breakShow;  // breakArea.show（缺省 true）
    int breakAmp;  // zigzagAmplitude（缺省 4）
    int breakBorderColor;  // itemStyle.borderColor；0 = 主题 #b7b9be
    int breakFillColor;  // itemStyle.color；0 = 白
    int breakOpacityX10;  // itemStyle.opacity ×10（-1 = 未声明 → 6）
    List<string> categories;

    // 分类轴工厂：携带标签列表，无网格线，标签自动防重叠。
    public static ChartAxis Category(List<string> cats) {
        ChartAxis a = new ChartAxis();
        a.type = ChartAxisType.Category;
        a.title = "";
        a.SetRange(ChartOption.AutoD(), ChartOption.AutoD());
        a.scale = false;
        a.reversed = false;
        a.ticks = 5;
        // ECharts 6.1 轴 splitLine 缺省不再在这里定：工厂两族共用，
        // 维度差异（xAxis false / yAxis true）由 ParseAxisOne 在未
        // 声明时落；工厂保持"开"，兼容不走 JSON 的内部构图。
        a.showGrid = true;
        a.splitLineDeclared = false; a.splitColor = 0; a.splitWidth = 0;
        a.axisPointerShow = 0 - 1; a.apValue = 0.0; a.apValueSet = false;
        a.apColor = 0; a.apWidth = 0; a.apLabelShow = false; a.apLabelBg = 0;
        a.splitArea = false;
        a.labelRotate = 0;
        a.labelInterval = 0 - 1;
        a.labelMargin = 0;
        a.labelShow = true;
        a.labelInside = false;
        a.labelColor = 0;
        a.labelFontSize = 0 - 1;
        a.axisTickShow = true;
        a.axisTickAlignWithLabel = false;
        a.axisTickInside = false;
        a.axisTickLength = 5;
        a.axisTickColor = 0;
        a.axisTickWidth = 1;
        a.nameLocation = "end";
        a.nameGap = 0 - 1;
        a.gridIndex = 0;
        a.nameColor = 0;
        a.nameFontSize = 0 - 1;
        a.offset = 0;
        a.labelFormatter = "";
        a.labelNegate = false;
        a.axisLineColor = 0;
        a.minInterval = ChartOption.AutoD();
        a.maxInterval = ChartOption.AutoD();
        a.alignTicks = false;
        a.minorTickShow = false;
        a.minorTickSplitNumber = 5;
        a.minorSplitLineShow = false;
        a.breaks = new List<ChartBreak>();
        a.breakShow = true;
        a.breakAmp = 4;
        a.breakBorderColor = 0;
        a.breakFillColor = 0;
        a.breakOpacityX10 = 0 - 1;
        // （axisDefault.ts:162 / :66）。
        a.axisLineShow = 1;
        a.onZero = 0 - 1;
        a.show = true;
        a.boundaryGap = true;
        a.axisId = "";
        a.categories = cats;
        return a;
    }

    // 分类轴工厂（带轴名称）。
    public static ChartAxis CategoryTitled(List<string> cats, string title) {
        ChartAxis a = ChartAxis.Category(cats);
        a.title = title;
        return a;
    }

    // 数值轴工厂：范围自动推导、显示网格线。ticks 0 = 自动
    // （ECharts splitNumber 缺省，刻度数由量程算法给出；消费方
    // 一律 <1 回落 5），显式 splitNumber 才赋 ticks。
    public static ChartAxis Value() {
        ChartAxis a = new ChartAxis();
        a.type = ChartAxisType.Value;
        a.title = "";
        a.SetRange(ChartOption.AutoD(), ChartOption.AutoD());
        a.scale = false;
        a.reversed = false;
        a.ticks = 0;
        a.showGrid = true;
        a.splitLineDeclared = false; a.splitColor = 0; a.splitWidth = 0;
        a.axisPointerShow = 0 - 1; a.apValue = 0.0; a.apValueSet = false;
        a.apColor = 0; a.apWidth = 0; a.apLabelShow = false; a.apLabelBg = 0;
        a.splitArea = false;
        a.labelRotate = 0;
        a.labelInterval = 0 - 1;
        a.labelMargin = 0;
        a.labelShow = true;
        a.labelInside = false;
        a.labelColor = 0;
        a.labelFontSize = 0 - 1;
        a.axisTickShow = true;
        a.axisTickAlignWithLabel = false;
        a.axisTickInside = false;
        a.axisTickLength = 5;
        a.axisTickColor = 0;
        a.axisTickWidth = 1;
        a.nameLocation = "end";
        a.nameGap = 0 - 1;
        a.gridIndex = 0;
        a.nameColor = 0;
        a.nameFontSize = 0 - 1;
        a.offset = 0;
        a.labelFormatter = "";
        a.labelNegate = false;
        a.axisLineColor = 0;
        a.minInterval = ChartOption.AutoD();
        a.maxInterval = ChartOption.AutoD();
        a.alignTicks = false;
        a.minorTickShow = false;
        a.minorTickSplitNumber = 5;
        a.minorSplitLineShow = false;
        a.breaks = new List<ChartBreak>();
        a.breakShow = true;
        a.breakAmp = 4;
        a.breakBorderColor = 0;
        a.breakFillColor = 0;
        a.breakOpacityX10 = 0 - 1;
        // 数值轴：axisLine.show 官方缺省 'auto'（axisDefault.ts:176，
        // valueAxis 覆盖），故记 -1；onZero 仍是 'auto'。
        a.axisLineShow = 0 - 1;
        a.onZero = 0 - 1;
        a.show = true;
        a.boundaryGap = false;
        a.axisId = "";
        a.categories = new List<string>();
        return a;
    }

    // 数值轴工厂（固定范围 [min,max]）。
    public static ChartAxis ValueRange(int min, int max) {
        ChartAxis a = ChartAxis.Value();
        a.min = min;
        a.max = max;
        return a;
    }

    // 数值轴工厂（带轴名称）。
    public static ChartAxis ValueTitled(string title) {
        ChartAxis a = ChartAxis.Value();
        a.title = title;
        return a;
    }

    // 时间轴工厂（type = Time，其余同数值轴）。
    public static ChartAxis Time() {
        ChartAxis a = ChartAxis.Value();
        a.type = ChartAxisType.Time;
        return a;
    }

    // 对数轴工厂（type = Log，其余同数值轴）。
    public static ChartAxis Log() {
        ChartAxis a = ChartAxis.Value();
        a.type = ChartAxisType.Log;
        return a;
    }

    // 对数轴工厂（带轴名称）。
    public static ChartAxis LogTitled(string title) {
        ChartAxis a = ChartAxis.Log();
        a.title = title;
        return a;
    }

    // 同时写 int 与 double 两套范围（JSON 解析/工厂/clone 都必须走这里，
    // 否则两套值会漂移：hash 读 int、渲染读 double）。
    public void SetRange(double lo, double hi) {
        this.minD = lo;
        this.maxD = hi;
        this.min = ChartOption.IsAutoD(lo) ? ChartOption.Auto() : (int)lo;
        this.max = ChartOption.IsAutoD(hi) ? ChartOption.Auto() : (int)hi;
    }

    // 深复制（含分类标签列表）；src 为 null 时返回 null。
    public static ChartAxis Clone(ChartAxis src) {
        if (src == null) { return null; }
        ChartAxis a = new ChartAxis();
        a.type = src.type; a.title = src.title;
        a.min = src.min; a.max = src.max;
        a.minD = src.minD; a.maxD = src.maxD;
        a.minDataB = src.minDataB; a.maxDataB = src.maxDataB;
        a.scale = src.scale;
        a.minInterval = src.minInterval; a.maxInterval = src.maxInterval;
        a.alignTicks = src.alignTicks;
        a.minorTickShow = src.minorTickShow;
        a.minorTickSplitNumber = src.minorTickSplitNumber;
        a.minorSplitLineShow = src.minorSplitLineShow;
        a.breaks = new List<ChartBreak>();
        if (src.breaks != null) {
            for (int bi = 0; bi < src.breaks.Count; bi = bi + 1) {
                a.breaks.Add(ChartBreak.Clone(src.breaks[bi]));
            }
        }
        a.breakShow = src.breakShow;
        a.breakAmp = src.breakAmp;
        a.breakBorderColor = src.breakBorderColor;
        a.breakFillColor = src.breakFillColor;
        a.breakOpacityX10 = src.breakOpacityX10;
        a.reversed = src.reversed; a.ticks = src.ticks; a.showGrid = src.showGrid;
        a.splitLineDeclared = src.splitLineDeclared; a.splitColor = src.splitColor;
        a.splitWidth = src.splitWidth;
        a.axisPointerShow = src.axisPointerShow; a.apValue = src.apValue;
        a.apValueSet = src.apValueSet; a.apColor = src.apColor;
        a.apWidth = src.apWidth; a.apLabelShow = src.apLabelShow;
        a.apLabelBg = src.apLabelBg;
        a.splitArea = src.splitArea;
        a.labelRotate = src.labelRotate; a.labelInterval = src.labelInterval;
        a.labelMargin = src.labelMargin;
        a.labelShow = src.labelShow;
        a.labelInside = src.labelInside;
        a.labelColor = src.labelColor;
        a.labelFontSize = src.labelFontSize;
        a.axisTickShow = src.axisTickShow;
        a.axisTickAlignWithLabel = src.axisTickAlignWithLabel;
        a.axisTickInside = src.axisTickInside;
        a.axisTickLength = src.axisTickLength;
        a.axisTickColor = src.axisTickColor;
        a.axisTickWidth = src.axisTickWidth;
        a.nameLocation = src.nameLocation; a.nameGap = src.nameGap;
        a.gridIndex = src.gridIndex;
        a.nameColor = src.nameColor;
        a.nameFontSize = src.nameFontSize;
        a.offset = src.offset;
        a.labelFormatter = src.labelFormatter;
        a.labelSt = ChartTextStyle.Clone(src.labelSt);
        a.labelNegate = src.labelNegate;
        a.axisLineColor = src.axisLineColor;
        a.axisLineShow = src.axisLineShow;
        a.onZero = src.onZero;
        a.show = src.show;
        a.position = src.position;
        a.axisId = src.axisId;
        a.boundaryGap = src.boundaryGap; a.categories = new List<string>();
        if (src.categories != null) {
            for (int i = 0; i < src.categories.Count; i = i + 1) {
                a.categories.Add(src.categories[i]);
            }
        }
        return a;
    }
}

// dataZoom 的一个组件（N2：此前只认数组首项的
// show/start/end/startValue/endValue，组件型
// slider/inside、靶向轴与外观键全部丢失）。字段名对齐
// SliderZoomModel.defaultOption；颜色 0 = 官方缺省 token。
