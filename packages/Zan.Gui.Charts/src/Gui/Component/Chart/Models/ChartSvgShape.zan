using System;

namespace Gui.Component.Chart;

// 扫出的一个形状：区域名 + 折线化环组（环内含洞标记）。
public class ChartSvgShape {
    public string name;
    public List<ChartMapRing> rings;

    public static ChartSvgShape Of(string name, List<ChartMapRing> rings) {
        ChartSvgShape s = new ChartSvgShape();
        s.name = name;
        s.rings = rings;
        return s;
    }
}
