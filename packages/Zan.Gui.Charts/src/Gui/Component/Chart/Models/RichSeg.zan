using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class RichSeg {
    public string text;
    public int line;  // 行号 0..
    public ChartRichStyle st;  // null = 纯文本段
    public int x;
    public int y;
    public int w;
    public int h;
    public int fsPx;
    public int tw;
    public int lh;

    public static RichSeg Create() {
        RichSeg s = new RichSeg();
        s.text = "";
        s.line = 0;
        s.st = null;
        s.x = 0;
        s.y = 0;
        s.w = 0;
        s.h = 0;
        s.fsPx = 0;
        s.tw = 0;
        s.lh = 0;
        return s;
    }
}
