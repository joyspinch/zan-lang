using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

class RichSeg {
    string text;
    int line;  // 行号 0..
    ChartRichStyle st;  // null = 纯文本段
    int x;
    int y;
    int w;
    int h;
    int fsPx;
    int tw;
    int lh;

    static RichSeg Create() {
        RichSeg s = new RichSeg();
        s.text = "";
        s.line = 0;
        s.st = null;
        s.x = 0;
        s.y = 0;
        s.w = 0;
        s.h = 0;
        s.fsPx = 0;
        s.tw = 0;
        s.lh = 0;
        return s;
    }
}

// 富文本整块（ChartView.RichLayout 产出）：段表 + 块盒（含外层
// label.padding）+ 行数；st 为生效样式表（绘制底板用）。
