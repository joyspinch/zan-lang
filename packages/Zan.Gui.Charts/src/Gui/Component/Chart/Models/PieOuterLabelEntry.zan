using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// 饼图外侧引线标签实体（消除 lbX1/lbY1/lbX2/lbX3/lbTx/lbYc/lbSide/lbColor/lbLn/lbDraw/lbTxt/lbBlk/lbH 13 组平行列表反模式）。
class PieOuterLabelEntry {
    int x1;
    int y1;
    int x2;
    int x3;
    int tx;
    int yc;
    int side;  // 0 = left, 1 = right
    int color;
    int lineColor;
    bool drawLine;
    string text;
    RichBlock block;
    int height;

    PieOuterLabelEntry(int x1, int y1, int x2, int x3, int tx, int yc,
                       int side, int color, int lineColor, bool drawLine,
                       string text, RichBlock block, int height) {
        this.x1 = x1;
        this.y1 = y1;
        this.x2 = x2;
        this.x3 = x3;
        this.tx = tx;
        this.yc = yc;
        this.side = side;
        this.color = color;
        this.lineColor = lineColor;
        this.drawLine = drawLine;
        this.text = text != null ? text : "";
        this.block = block;
        this.height = height;
    }
}
