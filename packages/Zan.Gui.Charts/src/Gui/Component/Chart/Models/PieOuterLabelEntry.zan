using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// 饼图外侧引线标签实体（消除 lbX1/lbY1/lbX2/lbX3/lbTx/lbYc/lbSide/lbColor/lbLn/lbDraw/lbTxt/lbBlk/lbH 13 组平行列表反模式）。
public class PieOuterLabelEntry {
    public int x1;
    public int y1;
    public int x2;
    public int x3;
    public int tx;
    public int yc;
    public int side;  // 0 = left, 1 = right
    public int color;
    public int lineColor;
    public bool drawLine;
    public string text;
    public RichBlock block;
    public int height;

    public PieOuterLabelEntry(int x1, int y1, int x2, int x3, int tx, int yc,
                       int side, int color, int lineColor, bool drawLine,
                       string text, RichBlock block, int height) {
        this.x1 = x1;
        this.y1 = y1;
        this.x2 = x2;
        this.x3 = x3;
        this.tx = tx;
        this.yc = yc;
        this.side = side;
        this.color = color;
        this.lineColor = lineColor;
        this.drawLine = drawLine;
        this.text = text != null ? text : "";
        this.block = block;
        this.height = height;
    }
}
