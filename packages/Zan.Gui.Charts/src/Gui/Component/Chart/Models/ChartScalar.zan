using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

class ChartScalar {
    int amount;
    bool percent;

    // 固定像素标量。
    static ChartScalar Px(int amount) { return new ChartScalar { amount = amount, percent = false }; }
    // 百分比标量（amount = 百分数）。
    static ChartScalar Pct(int amount) { return new ChartScalar { amount = amount, percent = true }; }

    // 深复制；src 为 null 时返回 null。
    static ChartScalar Clone(ChartScalar src) {
        if (src == null) { return null; }
        return new ChartScalar { amount = src.amount, percent = src.percent };
    }
}

// 二维标量坐标（仪表盘 center、指针 offsetCenter 等用）。
