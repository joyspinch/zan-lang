using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartScalar {
    public int amount;
    public bool percent;

    // 固定像素标量。
    public static ChartScalar Px(int amount) { return new ChartScalar { amount = amount, percent = false }; }
    // 百分比标量（amount = 百分数）。
    public static ChartScalar Pct(int amount) { return new ChartScalar { amount = amount, percent = true }; }

    // 深复制；src 为 null 时返回 null。
    // 面向对象深复制实例方法。
    public ChartScalar Clone() {
        return new ChartScalar { amount = this.amount, percent = this.percent };
    }

    public static ChartScalar Clone(ChartScalar src) {
        if (src == null) { return null; }
        return src.Clone();
    }
}

public class ChartPosition {
    public ChartScalar x;
    public ChartScalar y;

    // 构造一个 (x,y) 标量坐标。
    public static ChartPosition Of(ChartScalar x, ChartScalar y) {
        return new ChartPosition { x = x, y = y };
    }

    // 面向对象深复制实例方法。
    public ChartPosition Clone() {
        return ChartPosition.Of(this.x != null ? this.x.Clone() : null,
                                this.y != null ? this.y.Clone() : null);
    }

    public static ChartPosition Clone(ChartPosition src) {
        if (src == null) { return null; }
        return src.Clone();
    }
}
