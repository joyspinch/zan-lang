using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// 力导向布局：节点 = links 首现序；边 = 无向对（自环丢弃、
// 重复边求和）。初始位置为圆周（无随机）；固定轮数的整数
// 定点弹簧模拟（近距离斥力 + 边吸引 + 中心引力 + 边界钳制）。
// 节点数 > 60 时降迭代。相同输入 → 相同输出。
public class ForceLayout {
    public List<ForceNode> nodes;
    public List<ForceEdge> edges;
    public int iterations;  // 实际执行轮数
    // 入场动画补间的初始位（圆周初值的快照，与 nodes 同序）；
    // iterations==0（单节点/退化）或模拟后为空时为 null。
    public List<ChartNodeCoord> startCoords;  // 初始位强类型实体列表（主表示）
    public List<int> startX;  // 兼容视图
    public List<int> startY;  // 兼容视图

    // 在**局部坐标**里模拟：绘图区左上角为原点，中心在
    // (w/2, h/2)，钳制到 [0..w]×[0..h]。调用方绘制时再平移到
    // 屏幕位置。这样布局只取决于数据与盒子尺寸——卡片滚动
    // 时形状不变，逐帧缓存也能跨滚动位置命中。
    // scaling / gravity（百分比，100 = 现状逐像素一致）：
    // 分别缩放弹簧斥力/边吸引与中心引力（ECharts force.scaling /
    // force.gravity）。
    // repulsion（%，100 = 缺省力）与 edgeLength（px，0 = 未声明）
    // 的全参形态：ECharts 5 force.repulsion/edgeLength。
    public static ForceLayout Of(List<ChartLink> links, int r, int w, int h,
                                 int scaling, int gravity) {
        return ForceLayout.OfK(links, r, w, h, scaling, gravity, 100, 0);
    }

    public static ForceLayout OfK(List<ChartLink> links, int r, int w, int h,
                                  int scaling, int gravity, int repulsion,
                                  int edgeLength) {
        ForceLayout l = ForceLayout.Build(links, null);
        int n = links.Count;
        if (n < 1) { l.iterations = 0; return l; }

        // 初始位置：圆周。
        int nn = l.nodes.Count;
        int cx = w / 2;
        int cy = h / 2;
        int rad = r;
        if (rad < 1) { rad = 1; }
        for (int i = 0; i < nn; i = i + 1) {
            int ang = i * 360 / nn;
            l.nodes[i].x = cx + rad * ChartView.CosDeg(ang) / 1000;
            l.nodes[i].y = cy + rad * ChartView.SinDeg(ang) / 1000;
        }
        // 圆周初值快照：入场补间从这份坐标出发按进度插值到终态，
        // 复刻 ECharts force「节点自初始位收敛」的入场观感。
        l.startCoords = new List<ChartNodeCoord>();
        l.startX = new List<int>();
        l.startY = new List<int>();
        for (int i = 0; i < nn; i = i + 1) {
            l.startCoords.Add(new ChartNodeCoord(l.nodes[i].x, l.nodes[i].y));
            l.startX.Add(l.nodes[i].x);
            l.startY.Add(l.nodes[i].y);
        }

        if (nn < 2) {
            l.nodes[0].x = cx;
            l.nodes[0].y = cy;
            l.iterations = 0;
            return l;
        }

        // 固定轮数的弹簧模拟（整数定点，每轮施加后钳制）。
        int iters = 60;
        if (nn > 60) { iters = 30; }
        l.iterations = iters;
        int k = rad;
        if (k < 8) { k = 8; }
        // edgeLength 声明即边静长（官方 d = edgeLength 线性映射，
        // 语料无 value 漂移→常量边长）；否则按 rad/2 旧行为。
        int rest = rad / 2;
        if (edgeLength > 0) { rest = edgeLength; }
        if (rest < 1) { rest = 1; }
        int maxDisp = rad * 4;
        if (maxDisp < 8) { maxDisp = 8; }
        // 模拟热循环跑在原生 int[] 上（坐标 xs/ys + CSR 邻接）。
        // 开方绝不能走 ChartView.ISqrt：那是初值 r=v 的牛顿迭代，
        // 大坐标要 ~17 次带 long 除法的收敛才到 √v，30 轮 × nn²
        // 的内循环曾被它拖到单帧 8s（graph-webkit-dep nn=513）。
        // Math.Sqrt 是硬件 sqrt；斥力侧另有 d²≥k² 剪枝（d≥k 本来
        // 就不施力）。结果与原牛顿版一致（⌊√v⌋），布局逐位不变。
        int[] xs = new int[nn];
        int[] ys = new int[nn];
        for (int i = 0; i < nn; i = i + 1) {
            xs[i] = l.nodes[i].x;
            ys[i] = l.nodes[i].y;
        }
        int en = l.edges.Count;
        // CSR 邻接表：attraction 从逐节点全边扫描 O(n·en) 降 O(度)。
        int[] adjStart = new int[nn + 1];
        int[] ea = new int[en];
        int[] eb = new int[en];
        for (int ei = 0; ei < en; ei = ei + 1) {
            ea[ei] = l.edges[ei].a;
            eb[ei] = l.edges[ei].b;
            adjStart[ea[ei] + 1] = adjStart[ea[ei] + 1] + 1;
            adjStart[eb[ei] + 1] = adjStart[eb[ei] + 1] + 1;
        }
        for (int i = 0; i < nn; i = i + 1) {
            adjStart[i + 1] = adjStart[i + 1] + adjStart[i];
        }
        int[] adjFill = new int[nn];
        for (int i = 0; i < nn; i = i + 1) { adjFill[i] = adjStart[i]; }
        int[] adjList = new int[2 * en];
        for (int ei = 0; ei < en; ei = ei + 1) {
            int pa = adjFill[ea[ei]];
            adjList[pa] = eb[ei];
            adjFill[ea[ei]] = pa + 1;
            int pb = adjFill[eb[ei]];
            adjList[pb] = ea[ei];
            adjFill[eb[ei]] = pb + 1;
        }
        long k2 = (long)k * (long)k;
        for (int it = 0; it < iters; it = it + 1) {
            for (int i = 0; i < nn; i = i + 1) {
                int xi = xs[i];
                int yi = ys[i];
                int dx = 0;
                int dy = 0;
                // 斥力：近距离成对推开（方向归一化，量级 ∝ (k-d)）。
                for (int j = 0; j < nn; j = j + 1) {
                    if (j == i) { continue; }
                    int dijx = xs[j] - xi;
                    int dijy = ys[j] - yi;
                    if (dijx == 0 && dijy == 0) { dijx = 1; dijy = 0; }
                    int d2 = dijx * dijx + dijy * dijy;
                    // d ≥ k 原本就不施力，平方域直接剪掉，免开方。
                    if ((long)d2 >= k2) { continue; }
                    int d = (int)Math.Sqrt((double)d2);
                    if (d < 8) { d = 8; }
                    int fr = (k - d) * 4 * scaling * repulsion / 100000;
                    dx = dx - dijx * fr / d;
                    dy = dy - dijy * fr / d;
                }
                // 边吸引：拉向对方（拉伸时吸引，压缩时推开；
                // 方向归一化，量级 ∝ (d-rest)）。
                for (int ai = adjStart[i]; ai < adjStart[i + 1]; ai = ai + 1) {
                    int j = adjList[ai];
                    int dijx = xs[j] - xi;
                    int dijy = ys[j] - yi;
                    if (dijx == 0 && dijy == 0) { dijx = 1; dijy = 0; }
                    int d2 = dijx * dijx + dijy * dijy;
                    int d = (int)Math.Sqrt((double)d2);
                    if (d < 8) { d = 8; }
                    int fa = (d - rest) * 2 * scaling / 1000;
                    dx = dx + dijx * fa / d;
                    dy = dy + dijy * fa / d;
                }
                if (dx > maxDisp) { dx = maxDisp; }
                if (dx < 0 - maxDisp) { dx = 0 - maxDisp; }
                if (dy > maxDisp) { dy = maxDisp; }
                if (dy < 0 - maxDisp) { dy = 0 - maxDisp; }
                int nx = xi + dx * 3 / 8;
                int ny = yi + dy * 3 / 8;
                // 中心引力 + 边界钳制。
                nx = nx + (cx - nx) * gravity / 3200;
                ny = ny + (cy - ny) * gravity / 3200;
                if (nx < 0) { nx = 0; }
                if (nx > w) { nx = w; }
                if (ny < 0) { ny = 0; }
                if (ny > h) { ny = h; }
                xs[i] = nx;
                ys[i] = ny;
            }
        }
        for (int i = 0; i < nn; i = i + 1) {
            l.nodes[i].x = xs[i];
            l.nodes[i].y = ys[i];
        }
        return l;
    }

    // 按名查节点下标，无则 -1。
    public static int NodeIndex(List<ForceNode> nodes, string name) {
        for (int i = 0; i < nodes.Count; i = i + 1) {
            if (nodes[i].name == name) { return i; }
        }
        return 0 - 1;
    }

    // 节点/权重/边骨架（布局共有前置）：显式节点名（graph 的
    // data/nodes 即节点，可能没有任何 link 引用）先行，links 里
    // 新出现的名字按首现序补齐；权重 = 入 + 出；边去自环、同
    // 无向对累加。不设坐标、不模拟。
    public static ForceLayout Build(List<ChartLink> links, List<string> nodeNames) {
        ForceLayout l = new ForceLayout();
        l.edges = new List<ForceEdge>();
        l.nodes = new List<ForceNode>();
        if (nodeNames != null) {
            for (int i = 0; i < nodeNames.Count; i = i + 1) {
                if (nodeNames[i].Length > 0
                    && ForceLayout.NodeIndex(l.nodes, nodeNames[i]) < 0) {
                    l.nodes.Add(ForceNode.Of(nodeNames[i], 0, 0, 0));
                }
            }
        }
        for (int li = 0; li < links.Count; li = li + 1) {
            ChartLink lk = links[li];
            if (ForceLayout.NodeIndex(l.nodes, lk.from) < 0) {
                l.nodes.Add(ForceNode.Of(lk.from, 0, 0, 0));
            }
            if (ForceLayout.NodeIndex(l.nodes, lk.to) < 0) {
                l.nodes.Add(ForceNode.Of(lk.to, 0, 0, 0));
            }
        }
        for (int li = 0; li < links.Count; li = li + 1) {
            ChartLink lk = links[li];
            int fi = ForceLayout.NodeIndex(l.nodes, lk.from);
            int ti = ForceLayout.NodeIndex(l.nodes, lk.to);
            l.nodes[fi].weight = l.nodes[fi].weight + lk.val;
            l.nodes[ti].weight = l.nodes[ti].weight + lk.val;
        }
        for (int li = 0; li < links.Count; li = li + 1) {
            ChartLink lk = links[li];
            int fi = ForceLayout.NodeIndex(l.nodes, lk.from);
            int ti = ForceLayout.NodeIndex(l.nodes, lk.to);
            if (fi == ti) { continue; }
            int a = fi;
            int b = ti;
            if (b < a) { int sw = a; a = b; b = sw; }
            int ei = ForceLayout.EdgeIndex(l.edges, a, b);
            if (ei < 0) { l.edges.Add(ForceEdge.Of(a, b, lk.val)); }
            else { l.edges[ei].val = l.edges[ei].val + lk.val; }
        }
        l.iterations = 0;
        return l;
    }

    // 环形布局（ECharts graph layout:'circular'）：节点按声明
    // 序均匀落在圆周；无模拟、无入场补间（startX 保持 null）。
    public static ForceLayout CircularOf(List<ChartLink> links,
                                  List<string> nodeNames, int w, int h) {
        ForceLayout l = ForceLayout.Build(links, nodeNames);
        int nn = l.nodes.Count;
        if (nn < 1) { return l; }
        int cx = w / 2;
        int cy = h / 2;
        int rad = w < h ? w : h;
        rad = rad * 2 / 5;
        if (rad < 1) { rad = 1; }
        for (int i = 0; i < nn; i = i + 1) {
            int ang = i * 360 / nn;
            l.nodes[i].x = cx + rad * ChartView.CosDeg(ang) / 1000;
            l.nodes[i].y = cy + rad * ChartView.SinDeg(ang) / 1000;
        }
        return l;
    }

    // 固定坐标布局（ECharts graph layout:'none'）：按强类型
    // 坐标实体列表 coords[i] 映射进绘图区（优先使用）。
    public static ForceLayout FixedOfCoords(List<ChartLink> links, List<string> nodeNames,
                                     List<ChartNodeCoord> coords, int w, int h) {
        ForceLayout l = ForceLayout.Build(links, nodeNames);
        int nn = l.nodes.Count;
        if (nn < 1) { return l; }
        int pad = 30;
        int loX = 0;
        int hiX = 0;
        int loY = 0;
        int hiY = 0;
        bool gotX = false;
        bool gotY = false;
        int valid = 0;
        if (coords != null) {
            for (int i = 0; i < nn && i < coords.Count; i = i + 1) {
                ChartNodeCoord pt = coords[i];
                if (pt == null || pt.x < 0 || pt.y < 0) { continue; }
                valid = valid + 1;
                if (!gotX) { loX = pt.x; hiX = pt.x; gotX = true; }
                if (pt.x < loX) { loX = pt.x; }
                if (pt.x > hiX) { hiX = pt.x; }
                if (!gotY) { loY = pt.y; hiY = pt.y; gotY = true; }
                if (pt.y < loY) { loY = pt.y; }
                if (pt.y > hiY) { hiY = pt.y; }
            }
        }
        if (valid == 0) { return ForceLayout.CircularOf(links, nodeNames, w, h); }
        int spanX = hiX - loX;
        int spanY = hiY - loY;
        if (spanX < 1) { spanX = 1; }
        if (spanY < 1) { spanY = 1; }
        for (int i = 0; i < nn; i = i + 1) {
            if (coords != null && i < coords.Count && coords[i] != null && coords[i].x >= 0 && coords[i].y >= 0) {
                l.nodes[i].x = pad + (w - pad * 2) * (coords[i].x - loX) / spanX;
                l.nodes[i].y = pad + (h - pad * 2) * (coords[i].y - loY) / spanY;
            } else {
                int ang = i * 360 / nn;
                int rad = (w < h ? w : h) * 2 / 5;
                if (rad < 1) { rad = 1; }
                l.nodes[i].x = w / 2 + rad * ChartView.CosDeg(ang) / 1000;
                l.nodes[i].y = h / 2 + rad * ChartView.SinDeg(ang) / 1000;
            }
        }
        return l;
    }

    // 固定坐标布局（ECharts graph layout:'none'）：节点按声明
    // 序取数据坐标 (xs[i], ys[i])，逐轴线性映射进绘图区（留
    // pad 边距）。数据坐标缺失/退化为一点时该轴回落圆周。
    public static ForceLayout FixedOf(List<ChartLink> links, List<string> nodeNames,
                               List<int> xs, List<int> ys, int w, int h) {
        List<ChartNodeCoord> coords = new List<ChartNodeCoord>();
        int count = xs != null ? xs.Count : 0;
        if (ys != null && ys.Count < count) { count = ys.Count; }
        for (int i = 0; i < count; i = i + 1) {
            coords.Add(new ChartNodeCoord(xs[i], ys[i]));
        }
        return ForceLayout.FixedOfCoords(links, nodeNames, coords, w, h);
    }

    // ECharts force 的 symbol/symbolSize 是**逐节点**声明：调用方把
    // 节点形状放在 series.tree（ChartNode.Shaped 叶），布局仍由 links
    // 推导，这里按名匹配把 symbol/size 抄到 ForceNode 上。未匹配的
    // 节点保持圆 + 自动尺寸。
    // minR/maxR（ECharts force.minSize/maxSize，像素，0 = 关闭）：
    // 无显式 size 的节点直径按权重在两者间线性插值；显式 size 仍
    // 优先。绘制端用 size/2 当半径。
    public static void ApplyShapes(ForceLayout l, List<ChartNode> shapes,
                            int minR, int maxR) {
        int maxW = 1;
        for (int i = 0; i < l.nodes.Count; i = i + 1) {
            if (l.nodes[i].weight > maxW) { maxW = l.nodes[i].weight; }
        }
        for (int i = 0; i < l.nodes.Count; i = i + 1) {
            ForceNode nd = l.nodes[i];
            if (minR > 0) {
                int hi = maxR > 0 ? maxR : minR;
                if (hi < minR) { hi = minR; }
                nd.size = 2 * (minR + (hi - minR) * nd.weight / maxW);
            }
        }
        if (shapes == null) { return; }
        for (int si = 0; si < shapes.Count; si = si + 1) {
            int idx = ForceLayout.NodeIndex(l.nodes, shapes[si].name);
            if (idx >= 0) {
                l.nodes[idx].symbol = shapes[si].symbol;
                if (shapes[si].size > 0) { l.nodes[idx].size = shapes[si].size; }
            }
        }
    }

    // 查无向对 (a,b)（调用方保证小端在前）的边下标，无则 -1。
    public static int EdgeIndex(List<ForceEdge> edges, int a, int b) {
        for (int i = 0; i < edges.Count; i = i + 1) {
            if (edges[i].a == a && edges[i].b == b) { return i; }
        }
        return 0 - 1;
    }
}
