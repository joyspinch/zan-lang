using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartVisualMap {
    public int type;  // 0 = continuous，1 = piecewise
    public bool show;  // 是否绘制控件面板
    public bool realtime;  // 拖拽时是否实时更新（缺省 true）
    public bool hasMin; public bool hasMax;
    public int minV; public int maxV;  // ×1000 定点域
    public int dimension;  // -1 = 默认（按 0 处理）
    public int seriesIndex;  // -1 = 全部系列
    public List<int> rangeColors;  // inRange.color 渐变 stop（continuous）
    // 显式声明过 inRange.color。rangeColors 在
    // "continuous 且未声明颜色"时会填官方缺省彩虹带，那不是用户的
    // 着色意图——接线到全局 o.rampColors 时只能认显式声明，否则
    // scatter-nutrients 的 symbolSize-only visualMap 会把分组色
    // 覆盖成按值彩虹（官方是 piecewise 分组色）。
    public bool colorsExplicit;
    // 声明的边界按**原始数据单位**另存一份：minV/maxV 是 ×1000 定点，
    // 大数（map-usa max:38000000 → 3.8e10）强转会溢出成 INT_MIN；
    // 而 o.rampLo/Hi 的消费者（ChartViewMap/Heatmap/Scatter）都按
    // 原值比较，需要原值。超出 int 范围时记 Auto() 按未声明处理。
    public int minRaw; public int maxRaw;
    public List<ChartVisualPiece> pieces;
    // piecewise 类目模式（官方 nutrients）：categories 列出数据列里
    // 出现过的字符串类目，inRange.color 同序一一对应；行按该列的
    // 字符串值查下标取色，找不到的类目走 outOfRange（#ccc）。
    public List<string> vmCats;
    // inRange.opacity（0..1000 千分位）：官方 lunar 的 heatmap 是 0.3，
    // 让底下的日历格与叠在上面的农历日名都透出来。0 = 未声明（不透明）。
    public int inOpacity;
    // inRange.symbolSize [lo,hi]（px 直径）：geo 投影散点按值线性映射
    // 符号大小（官方 scatter-world-population [6,60]）。hasSize=false =
    // 未声明（渲染器走旧启发式 + 硬帽）。
    public int sizeLo; public int sizeHi;
    public bool hasSize;
    // piecewise 等分桶数（ECharts splitNumber，缺省 5）：值域 [min,max]
    // 均分成 N 桶，热力格取所在桶中点经色带取色（heatmap-large-
    // piecewise 声明 8 桶）。0 = 未声明（按缺省 5）。
    public int splitNumber;

    public static ChartVisualMap Of() {
        ChartVisualMap vm = new ChartVisualMap();
        vm.type = 0; vm.show = true; vm.realtime = true; vm.hasMin = false; vm.hasMax = false;
        vm.minV = 0; vm.maxV = 0; vm.dimension = 0 - 1; vm.seriesIndex = 0 - 1;
        vm.rangeColors = new List<int>();
        vm.colorsExplicit = false;
        vm.minRaw = ChartOption.Auto(); vm.maxRaw = ChartOption.Auto();
        vm.pieces = new List<ChartVisualPiece>();
        vm.vmCats = new List<string>();
        vm.inOpacity = 0;
        vm.sizeLo = 0; vm.sizeHi = 0; vm.hasSize = false;
        vm.splitNumber = 0;
        return vm;
    }

    // 面向对象深复制实例方法。
    public ChartVisualMap Clone() {
        ChartVisualMap vm = ChartVisualMap.Of();
        vm.type = this.type; vm.show = this.show; vm.realtime = this.realtime;
        vm.hasMin = this.hasMin; vm.hasMax = this.hasMax;
        vm.minV = this.minV; vm.maxV = this.maxV;
        vm.dimension = this.dimension; vm.seriesIndex = this.seriesIndex;
        if (this.rangeColors != null) {
            for (int i = 0; i < this.rangeColors.Count; i = i + 1) {
                vm.rangeColors.Add(this.rangeColors[i]);
            }
        }
        vm.colorsExplicit = this.colorsExplicit;
        vm.minRaw = this.minRaw; vm.maxRaw = this.maxRaw;
        if (this.pieces != null) {
            for (int i = 0; i < this.pieces.Count; i = i + 1) { vm.pieces.Add(this.pieces[i]); }
        }
        if (this.vmCats != null) {
            for (int i = 0; i < this.vmCats.Count; i = i + 1) { vm.vmCats.Add(this.vmCats[i]); }
        }
        vm.inOpacity = this.inOpacity;
        vm.sizeLo = this.sizeLo; vm.sizeHi = this.sizeHi; vm.hasSize = this.hasSize;
        vm.splitNumber = this.splitNumber;
        return vm;
    }

    public static ChartVisualMap Clone(ChartVisualMap src) {
        if (src == null) { return null; }
        return src.Clone();
    }

    // inRange.color 多 stop 线性插值；tF 为 0..1000 归一位置。
    public static int Lerp(List<int> stops, int tF) {
        int k = stops.Count;
        if (k < 1) { return 0; }
        if (k == 1 || tF <= 0) { return stops[0]; }
        if (tF >= 1000) { return stops[k - 1]; }
        int seg = tF * (k - 1);
        int i = seg / 1000;
        if (i > k - 2) { return stops[k - 1]; }
        int f = seg - i * 1000;
        int a = stops[i]; int b = stops[i + 1];
        int rr = ((a >> 16) & 255) * (1000 - f) / 1000 + ((b >> 16) & 255) * f / 1000;
        int gg = ((a >> 8) & 255) * (1000 - f) / 1000 + ((b >> 8) & 255) * f / 1000;
        int bb = (a & 255) * (1000 - f) / 1000 + (b & 255) * f / 1000;
        int aa = ((a >> 24) & 255) * (1000 - f) / 1000 + ((b >> 24) & 255) * f / 1000;
        return (aa << 24) | (rr << 16) | (gg << 8) | bb;
    }
}

public class ChartVisualPiece {
    public bool hasLo; public int lo; public bool loIncl;
    public bool hasHi; public int hi; public bool hiIncl;
    public bool hasEq; public int eq;
    public int color;
    public string label;

    public static ChartVisualPiece Of() {
        return new ChartVisualPiece { hasLo = false, lo = 0, loIncl = true,
            hasHi = false, hi = 0, hiIncl = true, hasEq = false, eq = 0,
            color = 0, label = "" };
    }
    // probe 是否落在本段内。
    public bool Hit(int probe) {
        if (hasEq) { return probe == eq; }
        if (!hasLo && !hasHi) { return false; }
        if (hasLo) {
            if (loIncl && probe < lo) { return false; }
            if (!loIncl && probe <= lo) { return false; }
        }
        if (hasHi) {
            if (hiIncl && probe > hi) { return false; }
            if (!hiIncl && probe >= hi) { return false; }
        }
        return true;
    }
}

// visualMap 取色带与值域的一次推导结果（直角热力图 / 矩阵图
// 共用车道，由 ChartView.VisualRampDomain 产出）。
public class RampDomainResult {
    public List<int> ramp;  // 取色带；<2 色时调用方回退系列色
    public int split;       // piecewise 等分桶数；0 = 连续
    public double dLo; public double dHi;  // 值域
}

// visualMap splitList 命名区间实体
public class ChartRangeSplit {
    public string label;
    public int lo;
    public int hi;

    // 构造一个命名区间；lo/hi 可为 ChartOption.Auto() 表示开口。
    public static ChartRangeSplit Of(string label, int lo, int hi) {
        ChartRangeSplit s = new ChartRangeSplit();
        s.label = label;
        s.lo = lo;
        s.hi = hi;
        return s;
    }

    public ChartRangeSplit Clone() {
        return ChartRangeSplit.Of(this.label, this.lo, this.hi);
    }

    public static ChartRangeSplit Clone(ChartRangeSplit src) {
        if (src == null) { return null; }
        return src.Clone();
    }
}
