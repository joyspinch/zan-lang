using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class Candle {
    public int open;
    public int high;
    public int low;
    public int close;
    // ECharts data 项逐根 itemStyle 覆盖（k1 首根蓝色阴线）；
    // null = 跟随系列 itemStyle。渲染器只读 normal 态。
    public ChartItemStyle itemStyle;
    // 构造一根 OHLC 柱。
    public static Candle Of(int open, int high, int low, int close) {
        Candle c = new Candle();
        c.open = open;
        c.high = high;
        c.low = low;
        c.close = close;
        return c;
    }

    // 深复制；src 为 null 时返回 null。
    public static Candle Clone(Candle src) {
        if (src == null) { return null; }
        Candle c = Candle.Of(src.open, src.high, src.low, src.close);
        c.itemStyle = ChartItemStyle.Clone(src.itemStyle);
        return c;
    }
}

// 加权散点（x、y 和一个决定气泡大小的权重）。
