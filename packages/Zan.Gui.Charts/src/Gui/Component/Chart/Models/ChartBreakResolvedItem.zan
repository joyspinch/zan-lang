using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// 强类型断轴解算项实体：将单断带配置与其实际 gapReal 像素/数据跨度绑定，消除平行列表反模式。
public class ChartBreakResolvedItem {
    public ChartBreak brk;
    public double gapReal;

    public ChartBreakResolvedItem(ChartBreak brk, double gapReal) {
        this.brk = brk;
        this.gapReal = gapReal;
    }

    public static ChartBreakResolvedItem Of(ChartBreak brk, double gapReal) {
        return new ChartBreakResolvedItem(brk, gapReal);
    }
}
