using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartNodeCoord {
    public int x;
    public int y;

    public ChartNodeCoord(int x, int y) {
        this.x = x;
        this.y = y;
    }

    public static ChartNodeCoord Of(int x, int y) {
        return new ChartNodeCoord(x, y);
    }
}

// 直角坐标系散点的一个 x/y 数据点，可带逐点尺寸与颜色
// （散点/折线的 points 专用列表用）。
