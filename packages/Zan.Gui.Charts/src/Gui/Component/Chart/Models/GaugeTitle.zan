using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class GaugeTitle {
    public bool show;
    public ChartPosition offsetCenter;
    public ChartTextStyle textStyle;

    // 构造默认标题：显示、位于 (0px, 20%)、灰字 16px。
    public static GaugeTitle Create() {
        ChartTextStyle text = ChartTextStyle.Create();
        text.color = Chart.Rgb(84, 89, 99);
        text.fontSize = 16;
        return new GaugeTitle {
            show = true, offsetCenter = ChartPosition.Of(ChartScalar.Px(0), ChartScalar.Pct(20)),
            textStyle = text
        };
    }

    // 深复制；src 为 null 时返回 null。
    public static GaugeTitle Clone(GaugeTitle src) {
        if (src == null) { return null; }
        return new GaugeTitle { show = src.show,
            offsetCenter = ChartPosition.Clone(src.offsetCenter),
            textStyle = ChartTextStyle.Clone(src.textStyle) };
    }
}

// 仪表盘数值牌：背景/边框、相对圆心偏移与 formatter
// （{value} 占位替换为当前值）。
