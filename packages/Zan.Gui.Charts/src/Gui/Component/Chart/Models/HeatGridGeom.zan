using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// 直角坐标系热力图的网格几何与取色域——核心层与悬停层共用的
// 一次推导结果：列/行规模、网格矩形、色带、值域、piecewise 桶数。
class HeatGridGeom {
    int gx; int gy; int gw; int gh;  // 网格矩形（格与格无缝相接）
    int cols; int rows;  // 列 = x 类目数，行 = y 类目数
    List<string> xCats; List<string> yCats;
    List<int> ramp;  // 取色带；<2 色时调用方回退系列色
    double dLo; double dHi;  // 值域：visualMap 声明优先，缺省数据包络
    int split;  // piecewise 等分桶数；0 = 连续

    static HeatGridGeom Of() {
        HeatGridGeom geo = new HeatGridGeom();
        geo.gx = 0; geo.gy = 0; geo.gw = 0; geo.gh = 0;
        geo.cols = 0; geo.rows = 0;
        geo.xCats = new List<string>();
        geo.yCats = new List<string>();
        geo.ramp = null;
        geo.dLo = 0.0; geo.dHi = 1.0;
        geo.split = 0;
        return geo;
    }
}
