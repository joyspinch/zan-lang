using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// 图表的虚拟、拉取式数据源——图表无需持有
// 原始点数组，数百万点的系列也不产生逐单元对象
// 分配（对应 DataTable 的 DataSource）。子类化它，
// 按需从自己的列式/类型化存储读取点，或用 SeriesListSource 包装
// 内存中的 List<ChartSeries>。
public class ChartSource {
    // 系列数。
    public virtual int SeriesCount() { return 0; }
    // 系列 s 的名称。
    public virtual string SeriesName(int s) { return ""; }
    // 系列 s 的颜色；0 = 自动（调色板）。
    public virtual int SeriesColor(int s) { return 0; }  // 0 = 自动（调色板）
    // 系列 s 的数据点数。
    public virtual int PointCount(int s) { return 0; }
    // 系列 s 第 i 点的数值。
    public virtual int ValueAt(int s, int i) { return 0; }
}
