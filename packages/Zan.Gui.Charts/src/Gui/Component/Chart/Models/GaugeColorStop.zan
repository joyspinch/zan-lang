using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class GaugeColorStop {
    public int stop;
    public int color;

    // 构造一个色带停靠点。
    public static GaugeColorStop Of(int stop, int color) {
        return new GaugeColorStop { stop = stop, color = color };
    }

    // 深复制；src 为 null 时返回 null。
    public static GaugeColorStop Clone(GaugeColorStop src) {
        if (src == null) { return null; }
        return GaugeColorStop.Of(src.stop, src.color);
    }
}

// 仪表盘轴线：线样式 + 渐变色带（colors 按 stop 顺序着色）。
