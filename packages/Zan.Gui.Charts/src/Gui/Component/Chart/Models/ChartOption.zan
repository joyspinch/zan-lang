using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartOption {
    public string title;
    public string titleSub;  // ECharts title.subtext（标题下的小字副标题）
    public string titleLink;  // ECharts title.link
    public string titleSublink;  // ECharts title.sublink
    public string titleAlign;  // ECharts title.left："center"（官方默认）| "left" | "right"
    public int titleColor;  // ECharts title.textStyle.color；0 = 官方默认 #3c3c41
    public int titleSubColor;  // ECharts title.subtextStyle.color；0 = 官方默认 #86878c
    public List<ChartAxis> xAxes;
    public List<ChartJsonDataset> datasets;  // ECharts dataset：id/source/transform
    public List<ChartVisualMap> visualMaps;  // ECharts visualMap：分段/连续视映射
    public List<ChartTitleSpec> titles;  // title 数组（多标题）
    public List<ChartGridSpec> grids;  // grid 数组（多 grid 布局）
    public List<ChartMarkArea> markAreas;  // markArea 区间带（x 类目竖带 / y 横带）
    public List<ChartAxis> yAxes;
    public List<ChartSeries> series;
    // N7：声明序快照（仅 ZSort 填写）。绘制序重排后，lead/kind 等
    // 「声明序首条可见系列」语义仍从本表取——官方每系列自带 view，
    // 面板主导型不随 z 重排漂移。null = 未快照（声明序即本表）。
    public List<ChartSeries> declOrder;
    public List<ChartGeo> geos;  // ECharts geo 组件（底图地图，可多个）
    public List<ChartCalendarSpec> calendars;  // ECharts calendar[]（日历坐标系）
    public ChartMatrixSpec matrix;  // ECharts6 matrix 组件（矩阵坐标系：x/y 维度树）
    public List<ChartParAxis> parAxes;  // ECharts parallelAxis[]（平行坐标维）
    public List<PolarAxisSpec> angleAxes;  // ECharts angleAxis（对象或数组，polarIndex 绑定）
    public List<PolarAxisSpec> radiusAxes;  // ECharts radiusAxis
    // parallel 组件：layout 命名轴的"排布方向"——'vertical'（轴自上
    // 而下堆叠，每根轴横置，nutrients 官方图）| 'horizontal'（轴从
    // 左到右排开，每根轴竖置）。缺省 horizontal（与 ECharts
    // 时代的既有渲染一致）。axisIndex 映射为数据列号 parAxes[i].dim。
    public string parLayout;
    public List<ChartGraphic> graphics;  // ECharts graphic 组件（原生矢量图元列表）

    public ChartType defaultType;  // Add(name, values) / AddLabel 使用的类型

    public bool showLegend;  // 面板标题中的系列图例
    public bool showTooltip;  // 悬停十字线 + 数值工具提示（直角坐标系图表）
    public string tooltipTrigger;  // ECharts tooltip.trigger："item"（默认）| "axis"
    public string tooltipTriggerOn;  // tooltip.triggerOn："mousemove|click"（默认）|
                             // "click" | "none"——none = 不随鼠标出框
    public bool tooltipConfine;  // tooltip.confine：限定在图表容器内
    public double tooltipTransitionDuration;  // tooltip.transitionDuration
    public int tooltipShowDelay;  // tooltip.showDelay
    public int tooltipHideDelay;  // tooltip.hideDelay
    public bool pointerSnap;  // axisPointer.snap
    public bool toolboxShow;  // ECharts toolbox：数据视图 / 类型切换 / 还原 / 保存 / 缩放
    // toolbox.feature 声明掩码：JSON 路径只渲染声明的按钮；对象 API
    // 保持 Create 的全按钮（开箱即用常用工具组）。
    public bool toolboxDataView;
    public bool toolboxDataViewReadOnly;
    public bool toolboxMagicLine;
    public bool toolboxMagicBar;
    public bool toolboxRestore;
    public bool toolboxSave;
    public bool toolboxZoom;
    public bool toolboxMark;
    public bool animation;
    public int animationDuration;
    public int animationDurationUpdate;
    public string animationEasing;
    public string animationEasingUpdate;
    public int animationThreshold;
    public bool useUTC;  // 是否使用 UTC 时间
    public string blendMode;  // 图表混合模式（如 'lighter'）
    public int titleItemGap;  // 主副标题间距
    public bool roam;  // 地图漫游（滚轮缩放 + 拖拽平移）
    public string roamWheelMode;  // "zoom" 消费滚轮；"pass" 交给外层滚动容器
    public bool mapSelect;  // 地图点击选中区域
    public bool showGrid;  // 数值网格线
    public bool showValues;  // 点/柱顶上的数值标签
    public bool animate;  // 首次渲染时的增长入场动画
    public bool smooth;  // 全局平滑（默认 true：ECharts 折线不写 smooth 也渲染曲线）；系列的 smooth 字段覆盖它
    public bool pointerCross;  // tooltip.axisPointer.type='cross'（line7 双数值轴：十字虚线 + ( x , y ) 轴值读数）
    public bool gradient;  // 垂直渐变填充（面积 / 柱状）
    public bool rounded;  // 圆角柱帽
    public int animMs;  // 入场动画时长（毫秒）
    public int donutPct;  // 环形内半径占外半径的百分比
    public int gaugeMax;  // Gauge / 径向条形图的满刻度值（默认 100）
    public bool pieLabels;  // 在饼/环扇区上绘制百分比标签
    public bool pieCenterText;  // 环心总数/选中项名标注（ECharts 默认无此行为，
                        // 仅 emphasis 时显示；显式开启才画）
    public bool pieRings;  // 多系列嵌套环饼图
    public bool overlay;  // 混搭覆盖层 option（DrawOverlaySeries 内部构造）：
                      // 跳过面板底/头，直接在同一面板上叠加绘制
                      // （ECharts 同 option 混排 pie/gauge/funnel + 笛卡尔）
    public List<RadarIndicator> radarIndicators;  // 结构化雷达指示器实体列表（主表示，消除平行列表反模式）
    public List<int> radarMax;  // 兼容派生列表：雷达每轴满刻度（空 = 从数据推导）
    public List<string> radarNames;  // 兼容派生列表：雷达每轴指示器名（radar.indicator[].name；
                             // 空 = 回退旧类目路径）
    public bool radarScaled;  // 雷达数据已 ×1000 定点：值数组物化时置位，
                             // radarMax/polars[].indicatorMax 同步放大，
                             // tooltip 显示走 FracText 除回
    public string radarShape;  // ECharts radar.shape："circle"（默认=现状）| "polygon"
    public bool radarSplitArea;  // ECharts radar.splitArea.show：环带交替色
    public int radarNameColor;  // radar.axisName.color（ECharts5 改名前的 name.
                         // textStyle.color）：指示器名颜色，0 = 主题轴色
    public List<RadarPolar> polars;  // ECharts polar[]：多雷达坐标系；空 = 单 polar
                             // （用上面的 radarMax/radarShape/dims 全局字段）
    // ---- legend 选项（ECharts legend）----
    public int legendTextColor;  // legend.textStyle.color：图例文字色
                                // （radar-aqi 深底的 #fff）；0 = 主题轴色
    public string legendOrient;  // "horizontal"（默认）| "vertical"
    public string legendX;  // ECharts legend.x："left"|"center"(默认)|"right"
    public string legendSelectedMode;  // ""=multiple | "single" | "false"
    public string legendFormatter;  // 标签模板，{name} = 系列名（"" = 原名）
    public int legendItemGap;  // 图例每项间距
    public int legendItemWidth;  // 图例图形宽
    public int legendItemHeight;  // 图例图形高
    public string legendIcon;  // 图例项图标
    public List<string> legendData;  // ECharts legend.data：图例项白名单（按此顺序
                                // 显示；空 = 全部系列）。同名系列共享一项
    // ---- legend 盒模型锚（官方 LegendModel.defaultOption: left 'center'、
    // 四锚求，不再只认旧 legend.x）----
    public string legendLeft;  // 原始写法（"left"/"center"/"right"/"12%"/数字）
    public string legendRight;
    public string legendTop;
    public string legendBottom;
    public bool legendHasLeft;  // 该锚是否显式声明（区分"未声明"与"声明为0"）
    public bool legendHasRight;
    public bool legendHasTop;
    public bool legendHasBottom;
    public int legendLeftPx;  // 已换算的像素锚（仅当 legendHas* 为真）
    public int legendRightPx;
    public int legendTopPx;
    public int legendBottomPx;
    public int legendBoxW;  // 解析 "N%" 锚时的百分比基数。0 = 未知（解析
    public int legendBoxH;  // 发生在 option 载入时，容器尚未布局）
    // ---- dataRange（ECharts 值域筛选组件）----
    public bool dataRangeShow;
    public int dataRangeLo;  // 固定下界（Auto = 数据最小值）
    public int dataRangeHi;  // 固定上界（Auto = 数据最大值）
    public bool dataRangeCalculable;  // true = 双把手滑条；false = 分段点选
    public int dataRangeSplit;  // splitList 为空时的均分段数（<=0 视为 5）
    public bool dataRangeHoverLink;  // hoverLink：悬停 dataRange 条 → 主图值域强调
    public List<ChartRangeSplit> dataRangeList;  // splitList：命名区间
    public bool zoom;  // 在直角坐标系图表下方显示 dataZoom 范围滑块
    public int markLine;  // 左轴上的水平阈值线（Auto = 无）
    public bool markPoint;  // 折线系列的最大值标记
    public string markLabel;  // 显示在 markLine 处的标签
    public int markLo;  // 阴影 markArea 带 [markLo, markHi]（Auto = 无）
    public int markHi;
    public int gridLeft;  // 绘图区内边距覆盖（像素；-1 = 根据标签自动）
    public int gridRight;
    public int gridTop;
    public int gridBottom;
    // grid.{left,right,top,bottom} 的百分比形态（"3%"；-1 = 非 %）。
    // ECharts grid 还支持 containLabel：边距之外再包住轴标签。
    public int gridLeftPct;
    public int gridRightPct;
    public int gridTopPct;
    public int gridBottomPct;
    public bool containLabel;
    // A16：grid 的原始声明（ChartBoxParam，kind/语义见类注释）——
    // GridRawRect 按 ECharts mergeLayoutParam + getLayoutRect 精确
    // 解算单格/多格矩形；上面 int 字段保留为旧读方与指纹的粗档影子。
    public ChartBoxParam gridLeftRaw;
    public ChartBoxParam gridRightRaw;
    public ChartBoxParam gridTopRaw;
    public ChartBoxParam gridBottomRaw;
    public ChartBoxParam gridWidthRaw;
    public ChartBoxParam gridHeightRaw;
    // A16：grid.outerBounds（Grid.ts prepareOuterBounds：'auto' 模式下
    // outerBounds 自身再走一遍 getLayoutRect 得外接矩形，标签外溢
    // 量往里收缩——intraday-breaks-1 {top:'20%',bottom:'30%'}）。
    public ChartBoxParam obLeftRaw;
    public ChartBoxParam obRightRaw;
    public ChartBoxParam obTopRaw;
    public ChartBoxParam obBottomRaw;
    public bool obDeclared;  // outerBounds 键在（无值声明也算，走 OUTER_BOUNDS_DEFAULT）
    public int zoomStart;  // dataZoom 初始窗口，百分比 0..100
    public int zoomEnd;  // dataZoom 初始窗口，百分比 0..100
    public string zoomStartValue;  // dataZoom startValue：按类目名定位窗口起点
    public string zoomEndValue;  // dataZoom endValue：按类目名定位窗口终点
    // ---- N2：dataZoom 组件全量解析 ----
    // 全部组件按声明序（数组展开，对象 = 单组件）。上面的
    // zoomStart/zoomEnd/zoomStartValue/zoomEndValue 是**首个 x 靶向
    // 组件**的窗口投影，供 ZoomI0/ZoomI1/指纹沿用；o.zoom 从
    // 「首项 show」改为「组件存在」（show:false 只藏条不关窗，
    // 动态数据 demo 的窗口语义与官方对齐）。inside-only
    // （bar-gradient 等）开窗但无条——渲染期在 zooms 里找不到
    // slider 组件即不画条。
    public List<ChartZoom> zooms;
    public ChartZoom zoomX;  // 首个 x 靶向组件（窗口投影的来源；null = 无）
    public ChartZoom zoomY;  // 首个 y 靶向组件（纵向条；null = 无）
    public int windowStart;  // 渲染器实际使用的窗口（类别索引，含端点）
    public int windowEnd;  // 由 ResolvedChart 从 app 状态解析；-1 = 未窗口化
    public int backgroundColor;  // 0 = 跟随主题，不主动填充背景
    public List<int> backgroundGradStops;  // 背景渐变色标列表
    // ECharts 根级 color：整图定性调色板（替换官方缺省 9 档）。
    // 系列未声明色时按绘制序取 colorPal[i % n]（ChartResolved.Of）。
    // null = 未声明，走 ChartSkin/主题 token/官方缺省。
    public List<int> colorPal;
    public int iwid;  // 交互键（由 ChartView.Render 每帧设置）；0 = 无
    public int connectGroup;  // connect() 组号（0 = 不参与联动；同组非 0 值共享交互态）

    // 配置 ≥2 个颜色停止点后，热力图等按单元格**值**在色带上取色，
    // 而不是每序列一色。rampColors 为空 = 关闭（默认逐序列着色）。
    public List<int> rampColors;
    public int rampLo;  // 显式值域下界；Auto() = 用数据最小值
    public int rampHi;  // 显式值域上界；Auto() = 用数据最大值

    // 哨兵值，表示"此边界从数据推导"。
    public static int Auto() { return 0 - 2000000000; }
    // visualMap 声明的边界按**原始数据单位**取整（o.rampLo/Hi 的消费者
    // 都按原值比较）。超出 int 可表示范围（>2e9，如 epoch-ms）时返回
    // Auto() 按未声明处理，避免强转溢出（同 B17 的轴 min/max 护栏）。
    public static int RawBound(double d) {
        if (d > 2000000000.0 || d < 0.0 - 2000000000.0) { return ChartOption.Auto(); }
        if (d < 0.0) { return (int)(d - 0.5); }
        return (int)(d + 0.5);
    }
    // double 版（ChartAxis.min/max 是 double；直接 cast 2000000000 会被
    // 强转工具链看作溢出风险，统一走这里）。
    public static double AutoD() { return 0.0 - 2000000000.0; }
    // 测试 double 是否为 Auto 哨兵。
    public static bool IsAutoD(double v) { return v <= 0.0 - 1999999999.0; }
    // 两个 double 在 1/1000 容差内相等（判断"是不是整数界"用）。
    public static bool SameIsh(double a, double b) {
        double d = a - b;
        if (d < 0.0) { d = 0.0 - d; }
        return d < 0.0005;
    }

    // 声明本图加入 connect 组（ECharts connect：多图共享交互态）。
    // 组内所有图传同一个 groupId（任意稳定 int，通常用组长图的
    // wid）。返回 this 便于链式装配。组内图共享：dataZoom 窗口、
    // 图例开关、十字线悬停类别。
    public ChartOption ConnectGroup(int groupId) {
        this.connectGroup = groupId;
        return this;
    }

    // 深复制 option 的可变容器，供 timeline 合并和快照使用。
    // 返回值与输入共享的只有不可变标量字符串，不共享列表/样式外壳。
    public static ChartOption Clone(ChartOption src) {
        if (src == null) { return null; }
        ChartOption o = ChartOption.Create();
        o.title = src.title; o.defaultType = src.defaultType;
        o.titleSub = src.titleSub; o.titleLink = src.titleLink; o.titleSublink = src.titleSublink;
        o.titleAlign = src.titleAlign;
        o.titleColor = src.titleColor; o.titleSubColor = src.titleSubColor;
        o.showLegend = src.showLegend; o.showTooltip = src.showTooltip;
        o.tooltipTrigger = src.tooltipTrigger;
        o.tooltipTriggerOn = src.tooltipTriggerOn;
        o.tooltipConfine = src.tooltipConfine;
        o.tooltipTransitionDuration = src.tooltipTransitionDuration;
        o.tooltipShowDelay = src.tooltipShowDelay;
        o.tooltipHideDelay = src.tooltipHideDelay;
        o.pointerSnap = src.pointerSnap;
        o.pointerCross = src.pointerCross;
        o.toolboxShow = src.toolboxShow; o.roam = src.roam; o.mapSelect = src.mapSelect;
        o.toolboxDataView = src.toolboxDataView; o.toolboxDataViewReadOnly = src.toolboxDataViewReadOnly;
        o.toolboxMagicLine = src.toolboxMagicLine;
        o.toolboxMagicBar = src.toolboxMagicBar; o.toolboxRestore = src.toolboxRestore;
        o.toolboxSave = src.toolboxSave; o.toolboxZoom = src.toolboxZoom;
        o.toolboxMark = src.toolboxMark;
        o.animation = src.animation; o.animationDuration = src.animationDuration;
        o.animationDurationUpdate = src.animationDurationUpdate;
        o.animationEasing = src.animationEasing; o.animationEasingUpdate = src.animationEasingUpdate;
        o.animationThreshold = src.animationThreshold;
        o.useUTC = src.useUTC;
        o.blendMode = src.blendMode;
        o.titleItemGap = src.titleItemGap;
        o.roamWheelMode = src.roamWheelMode;
        o.showGrid = src.showGrid; o.showValues = src.showValues; o.animate = src.animate;
        o.smooth = src.smooth; o.gradient = src.gradient; o.rounded = src.rounded;
        o.animMs = src.animMs; o.donutPct = src.donutPct; o.gaugeMax = src.gaugeMax;
        o.pieLabels = src.pieLabels; o.pieRings = src.pieRings;
        o.pieCenterText = src.pieCenterText;
        o.overlay = src.overlay;
        o.radarShape = src.radarShape; o.radarSplitArea = src.radarSplitArea;
        o.legendOrient = src.legendOrient; o.legendSelectedMode = src.legendSelectedMode;
        o.legendX = src.legendX;
        o.legendItemGap = src.legendItemGap;
        o.legendItemWidth = src.legendItemWidth;
        o.legendItemHeight = src.legendItemHeight;
        o.legendIcon = src.legendIcon;
        o.legendLeft = src.legendLeft; o.legendRight = src.legendRight;
        o.legendTop = src.legendTop; o.legendBottom = src.legendBottom;
        o.legendHasLeft = src.legendHasLeft; o.legendHasRight = src.legendHasRight;
        o.legendHasTop = src.legendHasTop; o.legendHasBottom = src.legendHasBottom;
        o.legendLeftPx = src.legendLeftPx; o.legendRightPx = src.legendRightPx;
        o.legendTopPx = src.legendTopPx; o.legendBottomPx = src.legendBottomPx;
        o.legendBoxW = src.legendBoxW; o.legendBoxH = src.legendBoxH;
        o.legendData = src.legendData;
        o.legendFormatter = src.legendFormatter; o.dataRangeShow = src.dataRangeShow;
        o.dataRangeLo = src.dataRangeLo; o.dataRangeHi = src.dataRangeHi;
        o.dataRangeCalculable = src.dataRangeCalculable; o.dataRangeSplit = src.dataRangeSplit;
        o.dataRangeHoverLink = src.dataRangeHoverLink; o.zoom = src.zoom;
        o.markLine = src.markLine; o.markPoint = src.markPoint; o.markLabel = src.markLabel;
        o.markLo = src.markLo; o.markHi = src.markHi; o.gridLeft = src.gridLeft;
        o.gridRight = src.gridRight; o.gridTop = src.gridTop; o.gridBottom = src.gridBottom;
        o.gridLeftPct = src.gridLeftPct; o.gridRightPct = src.gridRightPct;
        o.gridTopPct = src.gridTopPct; o.gridBottomPct = src.gridBottomPct;
        o.containLabel = src.containLabel;
        o.gridLeftRaw = ChartBoxParam.Clone(src.gridLeftRaw);
        o.gridRightRaw = ChartBoxParam.Clone(src.gridRightRaw);
        o.gridTopRaw = ChartBoxParam.Clone(src.gridTopRaw);
        o.gridBottomRaw = ChartBoxParam.Clone(src.gridBottomRaw);
        o.gridWidthRaw = ChartBoxParam.Clone(src.gridWidthRaw);
        o.gridHeightRaw = ChartBoxParam.Clone(src.gridHeightRaw);
        o.obLeftRaw = ChartBoxParam.Clone(src.obLeftRaw);
        o.obRightRaw = ChartBoxParam.Clone(src.obRightRaw);
        o.obTopRaw = ChartBoxParam.Clone(src.obTopRaw);
        o.obBottomRaw = ChartBoxParam.Clone(src.obBottomRaw);
        o.obDeclared = src.obDeclared;
        o.zoomStart = src.zoomStart; o.zoomEnd = src.zoomEnd;
        o.zoomStartValue = src.zoomStartValue; o.zoomEndValue = src.zoomEndValue;
        o.zooms = new List<ChartZoom>();
        for (int zi = 0; zi < src.zooms.Count; zi = zi + 1) {
            o.zooms.Add(ChartZoom.Clone(src.zooms[zi]));
        }
        o.zoomX = ChartZoom.Clone(src.zoomX);
        o.zoomY = ChartZoom.Clone(src.zoomY);
        o.windowStart = src.windowStart; o.windowEnd = src.windowEnd;
        o.backgroundColor = src.backgroundColor; o.backgroundGradStops = src.backgroundGradStops; o.iwid = src.iwid;
        o.parLayout = src.parLayout;
        o.connectGroup = src.connectGroup; o.rampLo = src.rampLo; o.rampHi = src.rampHi;
        o.radarIndicators = new List<RadarIndicator>();
        if (src.radarIndicators != null) {
            for (int i = 0; i < src.radarIndicators.Count; i = i + 1) {
                o.radarIndicators.Add(new RadarIndicator(src.radarIndicators[i].name, src.radarIndicators[i].max));
            }
        }
        o.radarMax = new List<int>();
        for (int i = 0; i < src.radarMax.Count; i = i + 1) { o.radarMax.Add(src.radarMax[i]); }
        o.radarNames = new List<string>();
        for (int i = 0; i < src.radarNames.Count; i = i + 1) { o.radarNames.Add(src.radarNames[i]); }
        o.radarScaled = src.radarScaled;
        o.radarNameColor = src.radarNameColor;
        o.legendTextColor = src.legendTextColor;
        o.polars = new List<RadarPolar>();
        for (int i = 0; i < src.polars.Count; i = i + 1) {
            o.polars.Add(RadarPolar.Clone(src.polars[i]));
        }
        o.rampColors = new List<int>();
        for (int i = 0; i < src.rampColors.Count; i = i + 1) { o.rampColors.Add(src.rampColors[i]); }
        o.xAxes = new List<ChartAxis>();
        for (int i = 0; i < src.xAxes.Count; i = i + 1) { o.xAxes.Add(ChartAxis.Clone(src.xAxes[i])); }
        o.datasets = new List<ChartJsonDataset>();
        for (int di2 = 0; di2 < src.datasets.Count; di2 = di2 + 1) { o.datasets.Add(src.datasets[di2]); }
        o.visualMaps = new List<ChartVisualMap>();
        for (int vi2 = 0; vi2 < src.visualMaps.Count; vi2 = vi2 + 1) {
            o.visualMaps.Add(ChartVisualMap.Clone(src.visualMaps[vi2]));
        }
        o.titles = new List<ChartTitleSpec>();
        for (int ti2 = 0; ti2 < src.titles.Count; ti2 = ti2 + 1) { o.titles.Add(src.titles[ti2]); }
        o.grids = new List<ChartGridSpec>();
        for (int gi2 = 0; gi2 < src.grids.Count; gi2 = gi2 + 1) { o.grids.Add(src.grids[gi2]); }
        o.markAreas = new List<ChartMarkArea>();
        for (int mai = 0; mai < src.markAreas.Count; mai = mai + 1) { o.markAreas.Add(src.markAreas[mai]); }
        o.yAxes = new List<ChartAxis>();
        for (int i = 0; i < src.yAxes.Count; i = i + 1) { o.yAxes.Add(ChartAxis.Clone(src.yAxes[i])); }
        o.series = new List<ChartSeries>();
        for (int i = 0; i < src.series.Count; i = i + 1) { o.series.Add(ChartSeries.Clone(src.series[i])); }
        o.geos = new List<ChartGeo>();
        for (int gci = 0; gci < src.geos.Count; gci = gci + 1) {
            o.geos.Add(ChartGeo.Clone(src.geos[gci]));
        }
        o.calendars = new List<ChartCalendarSpec>();
        for (int cai = 0; cai < src.calendars.Count; cai = cai + 1) {
            o.calendars.Add(src.calendars[cai]);
        }
        o.matrix = src.matrix;  // 解析后不可变（树展平只读），克隆共享
        o.parAxes = new List<ChartParAxis>();
        for (int pai = 0; pai < src.parAxes.Count; pai = pai + 1) {
            o.parAxes.Add(ChartParAxis.Clone(src.parAxes[pai]));
        }
        o.angleAxes = new List<PolarAxisSpec>();
        for (int pai2 = 0; pai2 < src.angleAxes.Count; pai2 = pai2 + 1) {
            o.angleAxes.Add(PolarAxisSpec.Clone(src.angleAxes[pai2]));
        }
        o.radiusAxes = new List<PolarAxisSpec>();
        for (int pai3 = 0; pai3 < src.radiusAxes.Count; pai3 = pai3 + 1) {
            o.radiusAxes.Add(PolarAxisSpec.Clone(src.radiusAxes[pai3]));
        }
        o.dataRangeList = new List<ChartRangeSplit>();
        for (int i = 0; i < src.dataRangeList.Count; i = i + 1) {
            o.dataRangeList.Add(ChartRangeSplit.Clone(src.dataRangeList[i]));
        }
        o.graphics = new List<ChartGraphic>();
        if (src.graphics != null) {
            for (int i = 0; i < src.graphics.Count; i = i + 1) {
                o.graphics.Add(src.graphics[i]);
            }
        }
        return o;
    }

    // 首个 x 轴的分类标签访问器（兼容常用约定）
    public List<string> xAxisCategories {
        get { return this.XCategories(); }
        set {
            if (this.xAxes != null && this.xAxes.Count > 0) {
                this.xAxes[0].categories = value != null ? value : new List<string>();
            } else {
                this.Categories(value);
            }
        }
    }

    // 无参构造：自动初始化全部安全非空集合与默认参数
    public ChartOption() {
        this.InitDefaults();
    }

    public void InitDefaults() {
        this.title = "";
        this.xAxes = new List<ChartAxis>();
        this.datasets = new List<ChartJsonDataset>();
        this.visualMaps = new List<ChartVisualMap>();
        this.titles = new List<ChartTitleSpec>();
        this.grids = new List<ChartGridSpec>();
        this.markAreas = new List<ChartMarkArea>();
        this.yAxes = new List<ChartAxis>();
        this.series = new List<ChartSeries>();
        this.geos = new List<ChartGeo>();
        this.calendars = new List<ChartCalendarSpec>();
        this.parAxes = new List<ChartParAxis>();
        this.angleAxes = new List<PolarAxisSpec>();
        this.radiusAxes = new List<PolarAxisSpec>();
        this.graphics = new List<ChartGraphic>();
        this.parLayout = "";
        this.defaultType = ChartType.Line;
        this.showLegend = true;
        this.showTooltip = true;
        this.tooltipTrigger = "";
        this.tooltipTriggerOn = "";
        this.tooltipConfine = false;
        this.tooltipTransitionDuration = 0.4;
        this.tooltipShowDelay = 0;
        this.tooltipHideDelay = 100;
        this.pointerSnap = false;
        this.titleLink = "";
        this.titleSublink = "";
        this.titleItemGap = 10;
        this.useUTC = false;
        this.blendMode = "";
        this.toolboxShow = false;
        this.toolboxDataView = true; this.toolboxDataViewReadOnly = false;
        this.toolboxMagicLine = true;
        this.toolboxMagicBar = true; this.toolboxRestore = true;
        this.toolboxSave = true; this.toolboxZoom = true;
        this.toolboxMark = false;
        this.animation = true;
        this.animationDuration = 1000;
        this.animationDurationUpdate = 300;
        this.animationEasing = "cubicOut";
        this.animationEasingUpdate = "cubicInOut";
        this.animationThreshold = 2000;
        this.roam = false;
        this.roamWheelMode = "zoom";
        this.mapSelect = false;
        this.rampColors = new List<int>();
        this.rampLo = ChartOption.Auto();
        this.rampHi = ChartOption.Auto();
        this.showGrid = true;
        this.showValues = false;
        this.animate = true;
        this.smooth = false;
        this.gradient = false;
        this.rounded = true;
        this.animMs = 650;
        this.donutPct = 55;
