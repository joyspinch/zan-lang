using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartMarkArea {
    public bool xMode;
    public int v0; public int v1;
    public int color;
    public string name;

    public static ChartMarkArea Of() {
        return new ChartMarkArea { xMode = true, v0 = 0, v1 = 0,
            color = 0, name = "" };
    }
}

