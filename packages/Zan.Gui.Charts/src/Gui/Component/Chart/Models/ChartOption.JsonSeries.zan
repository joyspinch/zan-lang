using System;
using System.Json;
using System.Text;
using Gui;

namespace Gui.Component.Chart;

// ChartOption 分部：系列外壳遍历、通用配置与底图合成
public partial class ChartOption {
    // 解析 series 数组，调度属性设置与专用数据反序列化。
    public static void ParseSeriesInto(ChartOption o, JsonValue v) {
        JsonValue series = v.Get("series");
        bool seriesObj = series != null && series.IsObject();
        if (seriesObj || (series != null && series.IsArray())) {
            int ns = seriesObj ? 1 : series.Count();
            List<string> bindKeys = new List<string>();
            List<int> bindOrd = new List<int>();
            for (int i = 0; i < ns; i = i + 1) {
                JsonValue s = seriesObj ? series : series.At(i);
                string sty = s.Str("type", "line");
                ChartSeries cs = ChartSeries.Of(s.Str("name", ""),
                    ChartKinds.TypeOf(sty), new List<int>());
                cs.custom = ChartKinds.CustomOf(sty);
                cs.typeName = sty;
                ParseSeriesProps(o, cs, s);
                ParseSeriesData(o, cs, s, bindKeys, bindOrd);
            }
        }
    }

    // 系列属性、样式、符号与标签解析。
    public static void ParseSeriesProps(ChartOption o, ChartSeries cs, JsonValue s) {
                cs.z = s.Int("z", cs.type == ChartType.Line ? 3 : 2);
                cs.zlevel = s.Int("zlevel", cs.zlevel);
                cs.dataGroupId = s.Str("dataGroupId", cs.dataGroupId);
                cs.progressive = s.Int("progressive", cs.progressive);
                cs.progressiveThreshold = s.Int("progressiveThreshold", cs.progressiveThreshold);
                cs.edgeSymbolSize = s.Int("edgeSymbolSize", cs.edgeSymbolSize);
                cs.avoidLabelOverlap = s.Bool("avoidLabelOverlap", cs.avoidLabelOverlap);
                cs.clip = s.Bool("clip", cs.clip);
                cs.sampling = s.Str("sampling", cs.sampling);
                cs.realtimeSort = s.Bool("realtimeSort", cs.realtimeSort);
                cs.legendHoverLink = s.Bool("legendHoverLink", cs.legendHoverLink);
                cs.nodeAlign = s.Str("nodeAlign", cs.nodeAlign);
                cs.singleAxisIndex = s.Int("singleAxisIndex", cs.singleAxisIndex);
                cs.polyline = s.Bool("polyline", cs.polyline);
                cs.showEffectOn = s.Str("showEffectOn", cs.showEffectOn);
                JsonValue ut = s.Get("universalTransition");
                if (ut != null && (ut.IsObject() || ut.IsBool())) {
                    bool utEnabled = ut.IsBool() ? ut.AsBool(false) : ut.Bool("enabled", true);
                    if (ut.IsObject()) {
                        string utDiv = ut.Str("divideShape", "");
                        string utDgi = ut.Str("seriesKey", "");
                    }
                }
                JsonValue eff = s.Get("effect");
                if (eff != null && eff.IsObject()) {
                    bool effShow = eff.Bool("show", true);
                    double effPeriod = eff.Double("period", 4.0);
                    double effSpeed = eff.Double("constantSpeed", 0.0);
                    double effTrail = eff.Double("trailLength", 0.2);
                    bool effLoop = eff.Bool("loop", true);
                    int effSymbolSz = eff.Int("symbolSize", 3);
                    string effSymbol = eff.Str("symbol", "circle");
                    if (eff.Has("color")) {
                        int effColor = ChartOption.ParseColor(eff.Get("color"), 0);
                    }
                }
                JsonValue rip = s.Get("rippleEffect");
                if (rip != null && rip.IsObject()) {
                    double ripPeriod = rip.Double("period", 4.0);
                    double ripScale = rip.Double("scale", 2.5);
                    string ripBrush = rip.Str("brushType", "fill");
                    if (rip.Has("color")) {
                        int ripColor = ChartOption.ParseColor(rip.Get("color"), 0);
                    }
                }
                JsonValue leaves = s.Get("leaves");
                if (leaves != null && leaves.IsObject()) {
                    JsonValue llbl = leaves.Get("label");
                    if (llbl != null && llbl.IsObject()) {
                        ChartTextStyle lts = ChartTextStyle.Create();
                        ChartOption.ParseTextStyle(llbl, lts);
                    }
                    JsonValue lis = leaves.Get("itemStyle");
                    if (lis != null && lis.IsObject()) {
                        ChartItemStyle lisSt = ChartItemStyle.Create();
                        ChartOption.ParseItemStyle(lis, lisSt);
                    }
                }
                cs.selectedMode = ChartKinds.SelectedModeSanitize(
                    s.Str("selectedMode", ""));
                cs.mapName = s.Str("map", "");
                // ECharts 旧键 mapType（doc-example/map-example 的
                // china、map-visualMap-* 的 world）：现代键是 map，
                // 旧例整批用 mapType——不收别名整图空白。
                if (cs.mapName.Length == 0) {
                    cs.mapName = s.Str("mapType", "");
                }
                cs.geoIndex = s.Int("geoIndex", 0);
                // ECharts MapSeries.getMapType()：**显式声明了 geoIndex**
                // 的 map 系列挂在 geo 组件上，此时 option.map/mapType 被
                // 地图名一律取宿主 geo 的 map。真实示例（geo-map-scatter /
                // geo-choropleth-scatter）正是这个形态：map 缺省或空串 +
                // geoIndex:0。不接这一步，系列名空 → BindSeries 直接返回，
                // 系列 data 的值落不到区域上，底图只能靠合成系列画出
                // 一片同色（visualMap 分级/着色全失效）。
                // 判定必须用"显式声明"而非字段值：geoIndex 缺省 0 与显式
                // 0 在数值上无法区分，但 ECharts 的 getHostGeoModel() 走
                // getReferringComponents(..., {useDefault:false})——没写
                // geoIndex 的 map 系列自建独占 geo，自己的 map 优先。
                if (cs.type == ChartType.Map && s.Has("geoIndex")
                    && cs.geoIndex >= 0 && o.geos.Count > cs.geoIndex) {
                    cs.mapName = o.geos[cs.geoIndex].map;
                }
                // map 系列的区域描边：官方 MapSeries defaultOption
                // 用户显式声明走声明值（borderWidth 0 = 关边框）；
                // 未声明保持 -1，渲染端落官方缺省。geoIndex 挂 geo
                // 的系列同官方 getHostGeoModel 语义——geo 组件的
                // itemStyle 优先（下方再覆写）。
                if (cs.type == ChartType.Map) {
                    JsonValue mits = s.Get("itemStyle");
                    if (mits != null && mits.IsObject()) {
                        if (mits.Has("borderColor")) {
                            cs.mapBorderC = ChartOption.ParseColor(
                                mits.Get("borderColor"), 0);
                        }
                        double mbw = mits.Double("borderWidth", -1.0);
                        if (mbw != -1.0) { cs.mapBorderW = (int)(mbw + 0.5); }
                    }
                    if (s.Has("geoIndex") && cs.geoIndex >= 0
                        && o.geos.Count > cs.geoIndex) {
                        ChartGeo hostGeo = o.geos[cs.geoIndex];
                        if (hostGeo.borderColor != 0) {
                            cs.mapBorderC = hostGeo.borderColor;
                        }
                        if (hostGeo.borderWidth >= 0) {
                            cs.mapBorderW = hostGeo.borderWidth;
                        }
                    }
                }
                // coordinateSystem:"geo"（散点/lines/graph 叠加地图）。
                string csys = s.Str("coordinateSystem", "");
                if (csys == "geo") { cs.coordSys = "geo"; }
                // bmap/gaode/amap：百度/高德地图坐标系，与 geo 一样不是
                // 直角系——记下来让热力图三元组车道绕开（否则
                // heatmap-bmap 的 [lng,lat,值] 会被当类目下标）。
                // matrix 同理（matrix-correlation-heatmap 的三元组首
                // 两位是类目名字符串，不是下标）。
                if (csys == "bmap" || csys == "gaode" || csys == "amap"
                    || csys == "matrix") {
                    cs.coordSys = csys;
                }
                // LinesSeries defaultOption.coordinateSystem 缺省即
                // 'geo'（官方 LinesSeries.ts）——geo-lines 迁徙图的
                // lines 系列全都不写 coordinateSystem。仅在 option
                // 存在 geo 组件时补缺省；无地图的纯 lines 兜底车道
                // （points 拆对）保持原样。
                if (cs.custom == "lines" && csys.Length == 0
                    && o.geos.Count > 0) {
                    cs.coordSys = "geo";
                }
                // coordinateSystem:"polar"（ECharts5/6 极坐标：角度轴/
                // 半径轴圆框，line/scatter 点投影）。
                if (csys == "polar") { cs.coordSys = "polar"; }
                // graph/pie 叠加日历）。calendarIndex 选目标日历。
                if (csys == "calendar") {
                    cs.coordSys = "calendar";
                    cs.calIndex = s.Int("calendarIndex", 0);
                    // pie.center 在 calendar 坐标系下是日期串（"2017-02-01"）
                    // 而非 [x,y] 坐标，ParsePoint 的解不出像素，改存 calDay。
                    if (cs.type == ChartType.Pie) {
                        JsonValue ctr = s.Get("center");
                        if (ctr != null && ctr.IsString()) {
                            int cdd = ChartOption.ParseDateDay(ctr.AsString(""), 0 - 1);
                            if (cdd < 0) { cdd = ChartOption.TimeDayOf(ctr); }
                            if (cdd >= 0) { cs.calCenter = cdd; }
                        }
                    }
                }
                // matrix 坐标系的 pie：center 是格名串 ["Grade 1",
                // "Class 1"]（matrix-pie 一格一饼），渲染端解成格矩形
                // 圆心（官方 dataToPoint = rect center）。
                if (csys == "matrix" && cs.type == ChartType.Pie) {
                    JsonValue mctr = s.Get("center");
                    if (mctr != null && mctr.IsArray() && mctr.Count() >= 2) {
                        cs.matCX = mctr.At(0).AsString("");
                        cs.matCY = mctr.At(1).AsString("");
                    } else if (mctr != null && mctr.IsString()) {
                        cs.matCX = mctr.AsString("");
                    }
                }
                if (cs.custom == "pictorialBar") {
                    JsonValue psm = s.Get("symbol");
                    if (psm != null && psm.IsString()) {
                        cs.picSymbol = psm.AsString("");
                    }
                    JsonValue prp = s.Get("symbolRepeat");
                    if (prp != null) {
                        cs.picRepeat = prp.IsString()
                            ? prp.AsString("") : (prp.AsBool(false) ? "true" : "");
                    }
                    cs.picClip = s.Bool("symbolClip", false);
                    cs.picPos = s.Str("symbolPosition", "");
                    JsonValue pbd = s.Get("symbolBoundingData");
                    if (pbd != null && pbd.IsNumber()) { cs.picBound = pbd.AsInt(0); }
                    JsonValue psz = s.Get("symbolSize");
                    if (psz != null && psz.IsArray() && psz.Count() >= 2) {
                        JsonValue w0 = psz.At(0);
                        JsonValue h0 = psz.At(1);
                        if (w0.IsNumber()) { cs.picW = w0.AsInt(0); }
                        else if (w0.IsString() && w0.AsString("").EndsWith("%")) {
                            cs.picWPct = Convert.ToInt(
                                w0.AsString("").Substring(0, w0.AsString("").Length - 1));
                        }
                        if (h0.IsNumber()) { cs.picH = h0.AsInt(0); }
                        else if (h0.IsString() && h0.AsString("").EndsWith("%")) {
                            cs.picHPct = Convert.ToInt(
                                h0.AsString("").Substring(0, h0.AsString("").Length - 1));
                        }
                    } else if (psz != null && psz.IsNumber()) {
                        cs.picW = psz.AsInt(0);
                        cs.picH = cs.picW;
                    }
                    JsonValue pso = s.Get("symbolOffset");
                    if (pso != null && pso.IsArray() && pso.Count() >= 2) {
                        cs.picOffSet = true;
                        JsonValue ox0 = pso.At(0);
                        JsonValue oy0 = pso.At(1);
                        if (ox0.IsNumber()) { cs.picOffX = ox0.AsInt(0); }
                        else if (ox0.IsString() && ox0.AsString("").EndsWith("%")) {
                            string so0 = ox0.AsString("");
                            cs.picOffXPct = Convert.ToInt(so0.Substring(0, so0.Length - 1));
                        }
                        if (oy0.IsNumber()) { cs.picOffY = oy0.AsInt(0); }
                        else if (oy0.IsString() && oy0.AsString("").EndsWith("%")) {
                            string so1 = oy0.AsString("");
                            cs.picOffYPct = Convert.ToInt(so1.Substring(0, so1.Length - 1));
                        }
                    }
                }
                if (cs.custom == "parallel") {
                    JsonValue pd = s.Get("data");
                    if (pd != null && pd.IsArray()) {
                        for (int ri = 0; ri < pd.Count(); ri = ri + 1) {
                            JsonValue row = pd.At(ri);
                            List<int> nums = new List<int>();
                            if (row != null && row.IsArray()) {
                                for (int ci = 0; ci < row.Count(); ci = ci + 1) {
                                    JsonValue cell = row.At(ci);
                                    // 类目维：值是类目下标；数值维：AsInt 取整。
                                    if (cell != null && cell.IsNumber()) {
                                        nums.Add(cell.AsInt(0));
                                    } else {
                                        nums.Add(Convert.ToInt(cell.AsString("")));
                                    }
                                }
                            } else if (row != null && row.IsObject()) {
                                // {value:[...]} 形态
                                JsonValue vv = row.Get("value");
                                if (vv != null && vv.IsArray()) {
                                    for (int ci = 0; ci < vv.Count(); ci = ci + 1) {
                                        nums.Add(vv.At(ci).AsInt(0));
                                    }
                                }
                            }
                            if (nums.Count > 0) {
                                cs.parallelRows.Add(ChartParallelRow.Of(nums));
                                cs.parRows.Add(nums);
                            }
                        }
                    }
                }
                if (cs.custom == "themeRiver") {
                    JsonValue rd = s.Get("data");
                    if (rd != null && rd.IsArray()) {
                        for (int ri = 0; ri < rd.Count(); ri = ri + 1) {
                            JsonValue row = rd.At(ri);
                            if (row == null || !row.IsArray() || row.Count() < 3) { continue; }
                            // [时间, 值, 名字] 三元组；时间支持 "2015/11/08"
                            // 字符串与数值（lastfm 用下标）。
                            JsonValue tj = row.At(0);
                            JsonValue vj = row.At(1);
                            JsonValue nj = row.At(2);
                            string time = tj.IsString()
                                ? tj.AsString("") : tj.AsInt(0) + "";
                            int val = vj.IsNumber() ? vj.AsInt(0)
                                : Convert.ToInt(vj.AsString(""));
                            string nm = nj.AsString("");
                            if (time.Length == 0 || nm.Length == 0) { continue; }
                            int cat = -1;
                            for (int ci = 0; ci < cs.riverNames.Count; ci = ci + 1) {
                                if (cs.riverNames[ci] == nm) { cat = ci; break; }
                            }
                            if (cat < 0) { cs.riverNames.Add(nm); cat = cs.riverNames.Count - 1; }
                            cs.riverPoints.Add(ChartRiverPoint.Of(time, val, cat));
                        }
                    }
                }
                // series.color：数字（0xRRGGBB int 通道）与字符串 "#xxx" 双
                // 形态——字符串经 ParseColor，int-only 会把官方 demo
                // 的命名色静默丢成"继承调色板"。
                cs.color = s.Get("color") != null
                    ? ChartOption.ParseColor(s.Get("color"), 0) : 0;
                cs.axisIndex = s.Int("yAxisIndex", s.Int("axisIndex", 0));
                cs.xIndex = s.Int("xAxisIndex", 0);
                // ECharts id 绑定：series.xAxisId/yAxisId 按轴 id 串接
                // （散点矩阵类 demo 的轴/网格全用 id 命名引用）。命中
                // 同名轴时覆盖索引绑定；未命中保留索引值。
                string xid = s.Str("xAxisId", "");
                if (xid.Length > 0) {
                    for (int ai = 0; ai < o.xAxes.Count; ai = ai + 1) {
                        if (o.xAxes[ai].axisId == xid) { cs.xIndex = ai; break; }
                    }
                }
                string yid = s.Str("yAxisId", "");
                if (yid.Length > 0) {
                    for (int ai = 0; ai < o.yAxes.Count; ai = ai + 1) {
                        if (o.yAxes[ai].axisId == yid) { cs.axisIndex = ai; break; }
                    }
                }
                // stack 同时接受整数（旧形式）和字符串（ECharts stackName 分组）。
                JsonValue stk = s.Get("stack");
                if (stk != null && stk.IsString()) {
                    cs.stackName = stk.AsString("");
                    cs.stack = ChartOption.StackIdFor(cs.stackName);
                } else {
                    cs.stack = s.Int("stack", 0);
                }
                // stackStrategy（processor/dataStack.ts:112）：默认 samesign。
                // 字符串值映射到枚举整；未声明或
                // 不认识的值回落 samesign。
                string sst = s.Str("stackStrategy", "");
                if (sst == "all") { cs.stackStrategy = 1; }
                else if (sst == "positive") { cs.stackStrategy = 2; }
                else if (sst == "negative") { cs.stackStrategy = 3; }
                else { cs.stackStrategy = 0; }
                cs.areaStyle = s.Bool("areaStyle", cs.areaStyle);
                cs.step = s.Str("step", cs.step);
                // series.emphasis.focus："series" = 悬停本系列时其余
                // 系列渐隐（官方 bump/折线族聚焦观感的核心表达）。
                JsonValue emphF = s.Get("emphasis");
                if (emphF != null && emphF.IsObject()) {
                    cs.emphasisFocus = emphF.Str("focus", cs.emphasisFocus);
                }
                cs.sort = s.Str("sort", cs.sort);
                cs.roseType = s.Str("roseType", cs.roseType);
                cs.clockWise = s.Bool("clockWise", cs.clockWise);
                cs.polarIndex = s.Int("polarIndex", cs.polarIndex);
                // ECharts5 radar 系列绑定雷达组件数组用 radarIndex。
                cs.polarIndex = s.Int("radarIndex", cs.polarIndex);
                string lsym = s.Str("linkSymbol", "");
                if (lsym == "arrow") { cs.forceLinkSymbol = "arrow"; }
                // pie.center / pie.radius（ECharts：['25%', 200] 与
                // '55%' | 80 | [110, 140]）。
                cs.center = ChartOption.ParsePoint(s.Get("center"), cs.center);
                JsonValue pieR = s.Get("radius");
                if (pieR != null && pieR.IsArray() && pieR.Count() >= 2) {
                    cs.radiusInner = ChartOption.ParseScalar(pieR.At(0), cs.radiusInner);
                    cs.radius = ChartOption.ParseScalar(pieR.At(1), cs.radius);
                } else if (pieR != null) {
                    cs.radius = ChartOption.ParseScalar(pieR, cs.radius);
                }
                cs.startAngle = s.Int("startAngle", cs.startAngle);
                cs.selectedOffset = s.Int("selectedOffset", cs.selectedOffset);
                cs.padAngle = s.Int("padAngle", cs.padAngle);
                // barWidth 百分比形式（"60%"）单独入 barWidthPct，
                // 像素形式照旧；渲染按带宽百分比定柱宽。
                JsonValue bwp = s.Get("barWidth");
                if (bwp != null && bwp.IsString() && bwp.AsString("").EndsWith("%")) {
                    string wpct = bwp.AsString("");
                    cs.barWidthPct = Convert.ToInt(wpct.Substring(0, wpct.Length - 1));
                } else {
                    cs.barWidth = s.Int("barWidth", cs.barWidth);
                }
                cs.barHeight = s.Int("barHeight", cs.barHeight);
                cs.barMinHeight = s.Int("barMinHeight", cs.barMinHeight);
                cs.barMinAngle = s.Int("barMinAngle", cs.barMinAngle);
                cs.roundCap = s.Bool("roundCap", cs.roundCap);
                cs.silent = s.Bool("silent", cs.silent);
                // 柱布局原始选项（barGrid 的输入）：`Str` 对字符串原样、
                // 对数字给原始字面量（numRaw），缺省 "" —— 正是
                // layout/barGrid.ts:createLayoutInfoListOnAxis 需要的形态。
                cs.barWidthRaw = s.Str("barWidth", "");
                cs.barGapRaw = s.Str("barGap", "");
                cs.barCategoryGapRaw = s.Str("barCategoryGap", "");
                cs.barMinWidthRaw = s.Str("barMinWidth", "");
                cs.barMaxWidthRaw = s.Str("barMaxWidth", "");
                cs.large = s.Bool("large", cs.large);
                cs.largeThreshold = s.Int("largeThreshold", cs.largeThreshold);
                JsonValue bgp = s.Get("barGap");
                if (bgp != null && bgp.IsString() && bgp.AsString("").EndsWith("%")) {
                    string pct = bgp.AsString("");
                    cs.barGapPct = Convert.ToInt(pct.Substring(0, pct.Length - 1));
                } else {
                    cs.barGapPct = s.Int("barGap", cs.barGapPct);
                }
                // smooth：系列级平滑覆盖（bool 或 0/1；缺省继承 option）。
                JsonValue smt = s.Get("smooth");
                if (smt != null && smt.IsBool()) { cs.smooth = smt.AsBool(false) ? 1 : 0; }
                else if (smt != null && smt.IsNumber()) {
                    // ECharts smooth 可为 0..1 平滑系数（0.6 等）：
                    // 非 0 即开平滑（引擎暂不分级张力）。
                    cs.smooth = smt.AsDouble(0.0) != 0.0 ? 1 : 0;
                }
                cs.showBackground = s.Bool("showBackground", cs.showBackground);
                // symbol 形状族 / 尺寸 / showSymbol（bool 或 int 形式）。
                cs.symbol = ChartKinds.SymbolSanitize(s.Str("symbol", cs.symbol));
                cs.symbolSize = s.Int("symbolSize", cs.symbolSize);
                // symbolSize 回调的公式化表达（见 symbolSizeFn 字段注释）。
                string szf = s.Str("symbolSizeFn", "");
                if (szf == "y" || szf == "ySqrt" || szf == "x" || szf == "xSqrt") {
                    cs.symbolSizeFn = szf;
                }
                JsonValue sym = s.Get("showSymbol");
                if (sym != null && sym.IsBool()) {
                    cs.showSymbol = sym.AsBool(true) ? 1 : 0;
                } else if (sym != null && sym.IsNumber()) {
                    cs.showSymbol = sym.AsInt(1);
                }
                // showAllSymbol：'auto'（缺省）= 能放下就全放、放不下才按标签
                // 间隔抽稀；true = 全放；false = 一律按标签间隔。
                // 出处 chart/line/LineView.ts:367-401 getIsIgnoreFunc。
                JsonValue sas = s.Get("showAllSymbol");
                if (sas != null && sas.IsBool()) {
                    cs.showAllSymbol = sas.AsBool(true) ? 1 : 0;
                } else if (sas != null && sas.IsNumber()) {
                    cs.showAllSymbol = sas.AsInt(0 - 1);
                } else if (sas != null && sas.IsString()
                           && sas.AsString("") == "auto") {
                    cs.showAllSymbol = 0 - 1;
                }
                JsonValue bgs = s.Get("backgroundStyle");
                if (bgs != null && bgs.IsObject()) {
                    if (bgs.Has("color")) {
                        cs.backgroundColor = ChartOption.ParseColor(bgs.Get("color"), cs.backgroundColor);
                    }
                }
                cs.innerPct = s.Int("innerPct", cs.innerPct);
                cs.hbar = s.Bool("hbar", cs.hbar);
                cs.treeOrient = s.Str("orient", cs.treeOrient);
                // initialTreeDepth：数字直接记；负数（-1）= 官方语义的
                // "expandTreeDepth 走整树深"（TreeSeries.ts:185-186 的
                // option.initialTreeDepth >= 0 守卫）。expandAndCollapse
                // 缺省 true；声明 false 时全展开（同守卫短路）。
                if (s.Has("initialTreeDepth")) {
                    cs.initialTreeDepth = s.Int("initialTreeDepth", 2);
                    if (cs.initialTreeDepth < 0) { cs.initialTreeDepth = 0 - 1; }
                }
                cs.treeExpandCollapse = s.Bool("expandAndCollapse", cs.treeExpandCollapse);
                cs.custom = s.Str("custom", cs.custom);
                // ---- 批 6：force / chord / funnel / wordCloud 参数 ----
                JsonValue fc = s.Get("force");
                if (fc != null && fc.IsObject()) {
                    cs.forceScaling = fc.Int("scaling", cs.forceScaling);
                    cs.forceGravity = fc.Int("gravity", cs.forceGravity);
                    // ECharts 5 键：repulsion/edgeLength 可为数或 [下,上]
                    // 数组（按节点/边 value 线性映射）——本引擎按均值折算
                    // （语料无 value 漂移用例，均值即缺省形态）。
                    JsonValue repj = fc.Get("repulsion");
                    if (repj != null && repj.IsArray() && repj.Count() >= 2) {
                        cs.forceRepulsion = (repj.At(0).AsInt(100)
                            + repj.At(1).AsInt(100)) / 2;
                    } else {
                        cs.forceRepulsion = repj == null ? cs.forceRepulsion
                            : repj.AsInt(cs.forceRepulsion);
                    }
                    JsonValue elj = fc.Get("edgeLength");
                    if (elj != null && elj.IsArray() && elj.Count() >= 2) {
                        cs.forceEdgeLength = (elj.At(0).AsInt(30)
                            + elj.At(1).AsInt(30)) / 2;
                    } else {
                        cs.forceEdgeLength = elj == null ? cs.forceEdgeLength
                            : elj.AsInt(cs.forceEdgeLength);
                    }

                    cs.forceMinRadius = fc.Int("minRadius", cs.forceMinRadius);
                    cs.forceMaxRadius = fc.Int("maxRadius", cs.forceMaxRadius);
                    JsonValue fns = fc.Get("nodeStyle");
                    if (fns != null && fns.IsObject()) {
                        cs.forceNodeColor = ChartOption.ParseColor(fns.Get("color"),
                            cs.forceNodeColor);
                    }
                    JsonValue fls = fc.Get("linkStyle");
                    if (fls != null && fls.IsObject()) {
                        cs.forceLinkColor = ChartOption.ParseColor(fls.Get("color"),
                            cs.forceLinkColor);
                    }
                }
                JsonValue ch = s.Get("chord");
                if (ch != null && ch.IsObject()) {
                    if (ch.Str("ribbonType", "") == "path") {
                        cs.chordRibbonType = "path";
                    }
                    string cso = ch.Str("sort", "");
                    if (cso == "descending") { cs.chordSort = 1; }
                    else if (cso == "ascending") { cs.chordSort = 2; }
                    cs.chordSortSub = ch.Bool("sortSub", cs.chordSortSub);
                    cs.chordGapDeg = ch.Int("gap", cs.chordGapDeg);
                    cs.chordRingWidthPct = ch.Int("ringWidth", cs.chordRingWidthPct);
                }
                // ECharts chord.matrix：n×n 权重阵（节点名取 data[i].name）。
                JsonValue mx = s.Get("matrix");
                if (mx != null && mx.IsArray()) {
                    for (int mri = 0; mri < mx.Count(); mri = mri + 1) {
                        JsonValue mrow = mx.At(mri);
                        List<int> row = new List<int>();
                        if (mrow != null && mrow.IsArray()) {
                            for (int mci = 0; mci < mrow.Count(); mci = mci + 1) {
                                row.Add(mrow.At(mci).AsInt(0));
                            }
                        }
                        cs.matrix.Add(row);
                    }
                }
                cs.funnelAlign = s.Str("funnelAlign", cs.funnelAlign);
                cs.funnelGap = s.Int("funnelGap", cs.funnelGap);
                cs.funnelPercent = s.Bool("funnelPercent", cs.funnelPercent);
                cs.maxSizePct = s.Int("maxSizePct", cs.maxSizePct);
                if (s.Has("maxSize")) {
                    ChartScalar ms = ChartOption.ParseScalar(s.Get("maxSize"), null);
                    if (ms != null) { cs.maxSizePct = ms.amount; }
                }
                cs.sort = s.Str("sort", cs.sort);
                if (s.Has("left")) { cs.boxLeft = ChartOption.ParseScalar(s.Get("left"), null); }
                if (s.Has("top")) { cs.boxTop = ChartOption.ParseScalar(s.Get("top"), null); }
                if (s.Has("width")) { cs.boxWidth = ChartOption.ParseScalar(s.Get("width"), null); }
                if (s.Has("height")) { cs.boxHeight = ChartOption.ParseScalar(s.Get("height"), null); }
                cs.funnelLabelOut = s.Bool("funnelLabelOut", cs.funnelLabelOut);
                cs.forceCurveness = s.Int("forceCurveness", cs.forceCurveness);
                JsonValue sr = s.Get("sizeRange");
                if (sr != null && sr.IsArray() && sr.Count() >= 2) {
                    cs.wcMinFontSize = sr.At(0).AsInt(cs.wcMinFontSize);
                    cs.wcMaxFontSize = sr.At(1).AsInt(cs.wcMaxFontSize);
                }
                if (s.Str("rotate", "") == "vary") { cs.wcRotate = "vary"; }
                // textRotation:[0,90,...]（ECharts 词云角度候选）：
                // 逗号串接进 wcRotateList，非空时渲染器按序取角度。
                JsonValue rotArr = s.Get("textRotation");
                if (rotArr != null && rotArr.IsArray() && rotArr.Count() > 0) {
                    string rl = "";
                    for (int ra = 0; ra < rotArr.Count(); ra = ra + 1) {
                        int deg = rotArr.At(ra).AsInt(0);
                        deg = ((deg % 360) + 360) % 360;
                        if (deg > 180) { deg = deg - 360; }
                        if (rl.Length > 0) { rl = rl + ","; }
                        rl = rl + Convert.ToString(deg);
                    }
                    cs.wcRotateList = rl;
                }
                ChartOption.ParseSeriesStyle(s, cs);
                // ECharts 把折线面积藏在 itemStyle.normal.areaStyle
                // （对象/true 即启用）。只能看 JSON 是否真的写了这个
                // 键——结构体的 type 默认就是 "default"，拿默认值判
                // 会把每条 v5/v6 折线都误开成面积图（line-simple 渲
                // 染成面积图的根因）。
                if (cs.type == ChartType.Line) {
                    JsonValue itm2x = s.Get("itemStyle");
                    if (itm2x != null && itm2x.IsObject()) {
                        JsonValue nrm2x = itm2x.Get("normal");
                        if (nrm2x != null && nrm2x.IsObject()) {
                            JsonValue na2x = nrm2x.Get("areaStyle");
                            if (na2x != null
                                && (na2x.IsObject() || na2x.AsBool(false))) {
                                cs.areaStyle = true;
                            }
                        }
                    }
                }
                JsonValue elab = s.Get("endLabel");
                if (elab != null && elab.IsObject()) {
                    cs.endLabelShow = elab.Bool("show", true);
                    cs.endLabelDistance = elab.Int("distance", cs.endLabelDistance);
                    cs.endLabelFormatter = elab.Str("formatter", cs.endLabelFormatter);
                }
                if (cs.type == ChartType.Gauge) { ChartOption.ParseGauge(s, cs.gauge); }
                // pie radius:[inner,outer] -> innerPct（内/外半径百分比）。
                JsonValue rad = s.Get("radius");
                if (rad != null && rad.IsArray() && rad.Count() >= 2) {
                    int innerPx = rad.At(0).AsInt(0);
                    int outerPx = rad.At(1).AsInt(0);
                    if (outerPx > 0 && innerPx >= 0 && innerPx <= outerPx) {
                        cs.innerPct = innerPx * 100 / outerPx;
                    }
                }
                ChartOption.ParseLinks(s.Get("links"), cs.links);
                ChartOption.ParseCandles(s.Get("candles"), cs.candles);
                ChartOption.ParseBubbles(s.Get("bubbles"), cs.bubbles);
                ChartOption.ParseBoxes(s.Get("boxes"), cs.boxes);
                ChartOption.ParseErrors(s.Get("errors"), cs.errors);
                ChartOption.ParsePoints(s.Get("points"), cs.points);
                if (cs.points.Count > 0 && cs.pointG <= 1) { cs.pointG = 1000; }
                ChartOption.ParseEvents(s.Get("events"), cs.events);
                ChartOption.ParseRegions(s.Get("regions"), cs.regions);
                // 层级数据（tree/treemap/sunburst 的 children 递归）。
                ChartOption.ParseTree(s.Get("data"), cs.tree);
                // ---- N3：levels 分级样式 + treemap 布局/视觉键 ----
                ChartOption.ParseLevels(s.Get("levels"), cs.levels);
                if (s.Has("visibleMin")) { cs.visibleMin = s.Int("visibleMin", 10); }
                if (s.Has("leafDepth")) { cs.leafDepth = s.Int("leafDepth", 0 - 1); }
                if (s.Has("visualDimension")) { cs.visualDimension = s.Int("visualDimension", 0); }
                if (s.Has("visualMin")) { cs.visualMin = s.Int("visualMin", 0 - 1); }
                if (s.Has("visualMax")) { cs.visualMax = s.Int("visualMax", 0 - 1); }
                JsonValue tmIS = s.Get("itemStyle");
                if (tmIS != null && tmIS.IsObject()) {
                    if (tmIS.Has("borderWidth")) { cs.tmBorderWidth = tmIS.Int("borderWidth", 0); }
                    if (tmIS.Has("gapWidth")) { cs.tmGapWidth = tmIS.Int("gapWidth", 0); }
                    cs.tmBorderColor = ChartOption.ParseColor(tmIS.Get("borderColor"), 0);
                    JsonValue tbcs = tmIS.Get("borderColorSaturation");
                    if (tbcs != null && tbcs.IsNumber()) {
                        cs.tmBorderColorSat = (int)(tbcs.AsDouble(0) * 1000);
                    }
                    JsonValue tcsat = tmIS.Get("colorSaturation");
                    if (tcsat != null && tcsat.IsArray() && tcsat.Count() >= 2) {
                        cs.tmHasColorSat = 1;
                        cs.tmSatLo = (int)(tcsat.At(0).AsDouble(0) * 1000);
                        cs.tmSatHi = (int)(tcsat.At(1).AsDouble(0) * 1000);
                    }
                    // sunburst 系级扇区纯色覆盖（sunburst-monochrome #ddd）。
                    cs.sunItemColor = ChartOption.ParseColor(tmIS.Get("color"), 0);
                }
                JsonValue tmUL = s.Get("upperLabel");
                if (tmUL != null && tmUL.IsObject()) {
                    cs.tmUpperShow = tmUL.Bool("show", false) ? 1 : 0;
                    if (tmUL.Has("height")) { cs.tmUpperHeight = tmUL.Int("height", 20); }
                }
                // sunburst 系级 label.rotate（radial/tangential/角度）与
                JsonValue sbLbl = s.Get("label");
                if (sbLbl != null && sbLbl.IsObject()) {
                    JsonValue sbRot = sbLbl.Get("rotate");
                    if (sbRot != null && sbRot.IsString()) {
                        string sbRs = sbRot.AsString("");
                        if (sbRs == "radial") { cs.sunLabelMode = 1; }
                        else if (sbRs == "tangential") { cs.sunLabelMode = 2; }
                    } else if (sbRot != null) {
                        cs.sunLabelMode = 3;
                        cs.sunLabelRotate = sbRot.AsInt(0);
                    }
                    cs.sunLabelColor = ChartOption.ParseColor(sbLbl.Get("color"), 0);
                }
                ChartOption.ParseMarks(s.Get("markPoint"), cs.marks);
                // series 级 markPoint.label（对象形态）：模板 + 富文本/
                // 盒样式 + 位置/距离；symbolSize 声明后 mark 点画小点
                // 不画 pin 气球（bar-rich-text 的 symbolSize:1 摘要卡）。
                JsonValue mpObj = s.Get("markPoint");
                if (mpObj != null && mpObj.IsObject()) {
                    JsonValue mpLbl = mpObj.Get("label");
                    if (mpLbl != null && mpLbl.IsObject()) {
                        cs.markLabelFmt = mpLbl.Str("formatter", cs.markLabelFmt);
                        cs.markLabelPos = mpLbl.Str("position", cs.markLabelPos);
                        cs.markLabelDist = mpLbl.Int("distance", cs.markLabelDist);
                        if (mpLbl.Get("rich") != null) {
                            ChartTextStyle mst = ChartTextStyle.Create();
                            ChartOption.ParseTextStyle(mpLbl, mst);
                            cs.markLabelSt = mst;
                        }
                    }
                    cs.markSymbolSize = mpObj.Int("symbolSize", cs.markSymbolSize);
                    JsonValue mpo = mpObj.Get("symbolOffset");
                    if (mpo != null && mpo.IsArray() && mpo.Count() >= 2) {
                        cs.markOffSet = true;
                        JsonValue ox0 = mpo.At(0);
                        JsonValue oy0 = mpo.At(1);
                        if (ox0.IsNumber()) { cs.markOffX = ox0.AsInt(0); }
                        else if (ox0.IsString() && ox0.AsString("").EndsWith("%")) {
                            string so0 = ox0.AsString("");
                            cs.markOffXPct = Convert.ToInt(so0.Substring(0, so0.Length - 1));
                        }
                        if (oy0.IsNumber()) { cs.markOffY = oy0.AsInt(0); }
                        else if (oy0.IsString() && oy0.AsString("").EndsWith("%")) {
                            string so1 = oy0.AsString("");
                            cs.markOffYPct = Convert.ToInt(so1.Substring(0, so1.Length - 1));
                        }
                    }
                }
                // series.labelLayout：标签绝对位/偏移/对齐/解叠（对象
                // 形态；官方 JS 函数形 JSON 导出已丢失，见 skill 11）。
                JsonValue llj = s.Get("labelLayout");
                if (llj != null && llj.IsObject()) {
                    cs.llDeclared = true;
                    cs.llDx = llj.Int("dx", cs.llDx);
                    cs.llDy = llj.Int("dy", cs.llDy);
                    if (llj.Has("x")) { cs.llX = llj.Int("x", cs.llX); }
                    if (llj.Has("y")) { cs.llY = llj.Int("y", cs.llY); }
                    cs.llAlign = llj.Str("align", cs.llAlign);
                    cs.llHideOverlap = llj.Bool("hideOverlap", cs.llHideOverlap);
                    cs.llMove = llj.Str("moveOverlap", cs.llMove);
                }
                ChartOption.ParseMarkLines(s.Get("markLine"), cs.markLines);
                ChartOption.ParseMarkArea(s.Get("markArea"), o);
    }

    private static void SynthesizeGeoBaseSeries(ChartOption o) {
        if (o.geos.Count > 0) {
            for (int gi = 0; gi < o.geos.Count; gi = gi + 1) {
                ChartGeo g = o.geos[gi];
                bool owned = false;
                for (int si = 0; si < o.series.Count; si = si + 1) {
                    ChartSeries s6 = o.series[si];
                    if (s6.type == ChartType.Map && s6.mapName == g.map
                        && s6.geoIndex == gi) { owned = true; break; }
                }
                if (owned) { continue; }
                ChartSeries gs = ChartSeries.Of("", ChartType.Map, new List<int>());
                gs.mapName = g.map;
                gs.geoIndex = gi;
                gs.isGeoBase = true;
                // geo 底图（geo.ts z:2，低层骨架）永远画在投影系列
                // （scatter/lines/graph，官方 z 2~4）之下。
                gs.z = 0;
                gs.selectedMode = g.selectedMode;
                gs.labelShow = g.labelShow;
                // geo 底图描边过河：官方 GeoModel defaultOption 同
                // -1（未声明）与显式 0（关边框）都原样传，渲染端分得。
                if (g.borderColor != 0) { gs.mapBorderC = g.borderColor; }
                if (g.borderWidth >= 0) { gs.mapBorderW = g.borderWidth; }
                for (int ri = 0; ri < g.regions.Count; ri = ri + 1) {
                    gs.regions.Add(ChartMapRegion.Clone(g.regions[ri]));
                }
                if (g.areaColor != 0) {
                    // itemStyle.areaColor：覆盖前先记成区域显式色。
                    for (int ri2 = 0; ri2 < gs.regions.Count; ri2 = ri2 + 1) {
                        gs.regions[ri2].color = g.areaColor;
                    }
                }
                ChartMaps.BindSeries(gs);
                if (g.areaColor != 0) {
                    for (int ri3 = 0; ri3 < gs.regions.Count; ri3 = ri3 + 1) {
                        gs.regions[ri3].color = g.areaColor;
                    }
                }
                if (!HasUserMapSeries(o)) { o.series.Insert(0, gs); }
                else { o.series.Add(gs); }
            }
        }
    }


}
