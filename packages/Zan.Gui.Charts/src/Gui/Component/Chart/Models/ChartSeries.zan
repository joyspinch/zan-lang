using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartSeries {
    public string name;
    public ChartType type;
    public int axisIndex;  // 0 = 左/主 Y 轴，1 = 右/次 Y 轴
    public int xIndex;  // ECharts series.xAxisIndex（多 grid 布局分组）
    public bool visBlocked;  // lineStyle.color 显式声明（visualMap 不覆盖线色）
    public int stack;  // 0 = 无；共享正 id 的系列堆叠在一起
    public string stackName;  // ECharts 堆叠组：同名系列堆叠
    // 组内哪些系列参与累加。源码
    // processor/dataStack.ts:112 缺省 "samesign"——只同号累加（正堆上正、
    // 负堆下负）；"all" 无视符号、"positive"/"negative" 只累加指定符号。
    public int stackStrategy;  // 0 = samesign（缺省）| 1 = all | 2 = positive | 3 = negative
    public int color;  // 0 = 自动（调色板）
    public bool hidden;  // 通过交互式图例关闭
    public int smooth;  // -1 = 跟随 option.smooth，0/1 = 逐系列覆盖
    public bool areaStyle;  // ECharts line.areaStyle.show：填充折线下方区域
    public bool endLabelShow;  // ECharts line.endLabel.show：线尾标注
    public int endLabelDistance;  // endLabel.distance：与线尾端点的间距（px）
    public string endLabelFormatter;  // endLabel.formatter：'{a}' 占位系列名
    public string step;  // ECharts line.step: "" | "start" | "middle" | "end"
    public string sort;  // ECharts funnel.sort："descending"（默认）| "ascending"（金字塔）
    public ChartScalar boxLeft;   // ECharts 系列盒模型 left（如 funnel.left: '5%'）
    public ChartScalar boxTop;    // ECharts 系列盒模型 top（如 funnel.top: '50%'）
    public ChartScalar boxWidth;  // ECharts 系列盒模型 width（如 funnel.width: '40%'）
    public ChartScalar boxHeight; // ECharts 系列盒模型 height（如 funnel.height: '45%'）
    public string roseType;  // ECharts pie.roseType："" | "radius" | "area"（玫瑰图）
    public ChartPosition center;  // ECharts pie.center：['25%', 200]——null = 未设，
                            // 多系列共享圆心；Px 的 y 相对绘图区顶
    public ChartScalar radius;  // ECharts pie.radius 外径：'55%' | 80（null = 未设，
                            // % 相对 min(绘图区宽,高)/2）
    public ChartScalar radiusInner;  // radius [min, max] 的 min（环内径，null = 未设）
    public int startAngle;  // ECharts pie.startAngle：数学角（0=3点钟，逆时针增）。
                     // 默认 90 = 12 点钟起始；内部换算为顺时针偏移 90-值。
    public bool clockWise;  // ECharts pie.clockWise：false = 扇区从起始边逆时针铺
                     // （默认 true 顺时针）
    public int polarIndex;  // ECharts series.polarIndex：绑定到 option.polars[]
                     // 的第几个坐标系（默认 0；单 polar 时忽略）
    public int selectedOffset;  // ECharts pie.selectedOffset：选中扇区外偏像素（默认 10）
    public int padAngle;  // ECharts pie.padAngle：扇区间隙夹角（度，默认 0）
    public int barWidth;  // ECharts bar.barWidth：柱宽像素；0 = 自动
    public int barWidthPct;  // ECharts bar.barWidth 的百分比形式（"60%"）：类目
                     // 带宽的百分比；0 = 未设（跟随 barWidth/自动）
    public int barHeight;  // ECharts bar.barHeight：>0 时双数值轴值对柱画横条
                     // （厚度 px、垂直中心在 y 值、从 x=0 基线长到 x 值，
                     // 官方 _buildOther 横向分支）；0 = 竖柱
    public int barMinHeight;  // ECharts bar.barMinHeight：柱条最小像素高（直角坐标）/
                     // 最小像素半径跨度（极坐标径向柱）。|高| < 该值时按符号补足
                     // （layout/barGrid.ts:456-472，竖向分支的判定是 h<=0——零值柱
                     // 也归负方向，结果是向上 1px）；0 = 不设（官方 `|| 0` 缺省）
    public int barMinAngle;  // ECharts bar.barMinAngle：极坐标切向柱最小角度跨度
                     // （layout/barPolar.ts:165-167）；0 = 不设
    public bool roundCap;  // ECharts bar.roundCap：极坐标**切向**柱的端点圆头
                     // （BarView.polar 的 `(!isRadial && roundCap) ?
                     // Sausage : Sector`）。缺省 false（BarSeries.ts:149
                     // 的 defaultOption）。它同时是 barPolar 的 clampLayout
                     // 开关：切向柱圆头时**不**把值钳回轴量程
                     // （barPolar.ts:112-113），端点才能伸出外环。
    public int barGapPct;  // ECharts bar.barGap：同系列柱间距百分比；-1 = 旧固定缝
    // 柱布局原始选项（ECharts layout/barGrid.ts:createLayoutInfoListOnAxis
    // 的系列侧输入）。字符串原样保留 `'N%'` / 数值两种形态，布局期才按
    // 带宽用 parsePercent 折算：上面几个折算成 int 的字段在 300/7 = 42.857
    // 这类带宽上丢精度，柱宽因此系统性偏差。"" = 选项缺省。
    public string barWidthRaw;
    public string barGapRaw;
    public string barCategoryGapRaw;
    public string barMinWidthRaw;
    public string barMaxWidthRaw;
    public bool large;  // ECharts bar.large：大数据量退化渲染标志
    public int largeThreshold;  // ECharts bar.largeThreshold（缺省 400）
    public bool silent;  // ECharts series.silent：true = 不响应鼠标命中（不出
                     // tooltip），图形照画（waterfall2 占位柱）
    public string symbol;  // ECharts series.symbol 形状族（Sanitized：circle/emptyCircle/
                     // rectangle/diamond/triangle；"" = 按族默认）
    public int symbolSize;  // ECharts series.symbolSize 像素；0 = 自动（族默认）
    public int pointG;  // 点坐标放大器：points 的 x/y 存的是值×pointG（定点），
                     // 渲染/量程/命中/tooltip 统一除回——ECharts 小数坐标
                     // （scatter3 的 (Math.random()*10).toFixed(3)）在 int
                     // 管线里这样承载；1 = 原值（缺省，除法跳过）。
    public string symbolSizeFn;  // ECharts symbolSize:function(val){...} 的确定性替代：
                         // "y"      -> 半径 = y 值（平方根比例可选）
                         // "ySqrt"  -> 半径 = ISqrt(y)（面积∝值，气泡图常用）
                         // "x"|"xSqrt" 同理按 x
                         // ""      = 关（用 symbolSize / 逐点 size）
                         // 随 val 而变，非逐点常量——函数回调无法确定性
                         // 复刻，以公式字段表达同一语义。
    public int showSymbol;  // ECharts line.showSymbol：-1 自动 | 0 隐藏点 | 1 显示
    // 出处 `chart/line/LineView.ts:367-401 getIsIgnoreFunc`：true 全显；
    // 'auto' 且 CanShowAllSymbolForCategory 通过时全显（源码注释："we show
    // all symbols as possible as we can"）；否则按类目标签间隔抽稀。
    public int showAllSymbol;
    public bool showBackground;  // ECharts bar.showBackground：零线到满刻度的底带
    public int backgroundColor;  // backgroundStyle.color；0 = 网格线色
    public int innerPct;  // 饼图环形孔占外半径的百分比（0 = 实心饼）
    public bool hbar;  // 柱状图布局：水平绘制（ECharts 交换 value-x/category-y）
    public string treeOrient;
    public int initialTreeDepth;  // ECharts tree.initialTreeDepth；-1 = 显式全展开；缺省 2（TreeSeries.ts:293）
    public bool treeExpandCollapse;  // ECharts tree.expandAndCollapse；缺省 true，false = 全展开
 // ECharts tree.orient："" = 垂直 | "horizontal"
    public ChartLineStyle treeLine;  // ECharts tree itemStyle.normal.lineStyle：
                             // shadow*；color 0 且 type "" = 现状直角网格色
    public bool piePerPoint;  // ECharts mix7「以饼代点」：散点坐标系里逐点画
                      // 小饼。同 option 内所有 piePerPoint 系列按下标
                      // 配对——圆心取首个系列 points[i] 的 (x,y) 值
                      // 坐标，半径取 points[i].size，扇区值取各系列
                      // points[i].z、各用系列色
    public string custom;  // ChartType.Custom 的扩展渲染器："box" | "error" |
    public string emphasisFocus;  // ECharts series.emphasis.focus："series" =
                     // 悬停本系列时其余系列渐隐（ECharts 6 fadeFocus
                     // 语义：非悬停系列描边/填充乘残alpha，本系列
                     // 加粗），"" = 无高亮聚焦。渲染端读
                     // Chart.EmphHoverKey(iwid) 的悬停系列下标。
    public string selectedMode;
    public string mapName;  // ECharts series.map：注册表地图名（"" = 未用）；
                     // 渲染前由 ChartMaps.BindSeries 注入区域几何
    public int geoIndex;  // ECharts series.geoIndex：绑定的 geo 组件下标
    public bool isGeoBase;  // geo 组件合成的底图载体系列（非用户声明）
    // map/geo 底图区域描边（官方 MapSeries/GeoModel defaultOption
    // itemStyle borderWidth 0.5 + borderColor neutral30）：-1 = 用户
    // 未声明（渲染端落官方缺省 1px 网格），显式 0 = 关边框（合法）。
    // ChartItemStateStyle.borderWidth 缺省 0 与"显式 0"无法区分，
    // 故 map 车道用独立哨兵字段。
    public int mapBorderW;  // -1 未声明 / >=0 半径像素（四舍五入）
    public int mapBorderC;  // 0 = 官方缺省 #b7b9be；否则用户声明色
    // ---- pictorialBar（custom == "pictorialBar"）----
    public string picSymbol;  // 原始 symbol 串：内置形状名 / path:// / image://
    public string picRepeat;  // symbolRepeat："true" | "fixed" | ""
    public bool picClip;  // symbolClip：符号裁到值高
    public string picPos;  // symbolPosition："start"（默认）| "end"
    public int picBound;  // symbolBoundingData 标量（0 = 用轴最大值）
    public int picW;  // symbolSize 宽（像素形态）
    public int picH;  // symbolSize 高（像素形态）
    public int picWPct;  // symbolSize 宽（% 相对类目槽宽）
    public int picHPct;  // symbolSize 高（% 相对绘图区高）
    public int picOffX;  // symbolOffset 宽（像素形态）
    public int picOffY;  // symbolOffset 高（像素形态）
    public int picOffXPct;  // symbolOffset 横向 % 相对自身宽（0 无百分比）
    public int picOffYPct;  // symbolOffset 纵向 % 相对自身高（0 无百分比）
    public bool picOffSet;  // series 级是否声明了 symbolOffset
    // ---- parallel / themeRiver ----
    public List<ChartParallelRow> parallelRows;  // parallel：每行一个强类型实体（主表示）
    public List<List<int>> parRows;  // 平行坐标每行维值扁平投影数组
    public List<ChartRiverPoint> riverPoints;  // themeRiver：逐点强类型数据实体
    public List<string> riverNames;  // themeRiver：名字表（图例 + 调色板）
    // ---- 批 6：force / chord / funnel / wordCloud 参数化 ----
    public int forceScaling;  // ECharts force.scaling（%）；100 = 现状
    public int forceGravity;  // ECharts force.gravity（%）；100 = 现状
    public int forceRepulsion;  // ECharts 5 force.repulsion（%，数组取均值）；100 = 缺省
    public int forceEdgeLength;  // ECharts 5 force.edgeLength（px，数组取均值）；0 = 未声明（按 rad/2）
    public int forceMinRadius;  // ECharts force.minRadius（px 节点半径下限）；0 = 关
    public int forceMaxRadius;  // ECharts force.maxRadius（px 节点半径上限）
    public int forceNodeColor;  // force.nodeStyle.color；0 = 逐节点调色板
    public int forceLinkColor;  // force.linkStyle.color；0 = 调色板半透明
    public string forceLinkSymbol;  // force.linkSymbol："arrow" = 目标端箭头；
                            // ""/none = 无（现状）
    public string chordRibbonType;  // ECharts chord ribbonType："path" = 细线；"" = 弧带
    public int chordSort;  // ECharts chord.sort：0 首现 | 1 descending | 2 ascending
    public bool chordSortSub;  // ECharts chord.sortSub：子弧按值降序
    public int chordGapDeg;  // 外环节点间隙（度）；-1 = 自动（2，拥挤归 0）
    public int chordRingWidthPct;  // 外环宽（占半径 %）；0 = 默认 22
    public List<List<int>> matrix;  // ECharts chord.matrix：n×n 权重阵；非空时与
                            // data[i].name 组成节点（含对角自环），展开为
                            // links 渲染（links 非空时优先用 links）
    public string funnelAlign;  // ECharts funnel.funnelAlign：""=center | left | right
    public int funnelGap;  // 漏斗层间隙 px；-1 = 默认 0（官方层间无缝衔接）
    public bool funnelPercent;  // 标签/提示行值后追加「（x%）」转化率
    public int maxSizePct;  // ECharts funnel.maxSize '80%'：最宽层占宽百分比（0=100）
    public bool funnelLabelOut;  // 阶段名外标：层右端标注（官方 label.formatter '{b}预期'）
    public int forceCurveness;  // ECharts force.linkStyle.normal.curveness ×1000
                            // （0 = 直线；200 = 0.2，二次贝塞尔弯曲连线）
    public int wcMinFontSize;  // wordCloud sizeRange[0] px；0 = 默认 Scale(11)
    public int wcMaxFontSize;  // wordCloud sizeRange[1] px；0 = 默认自适应
    public string wcRotate;  // wordCloud.rotate："vary" = 横向/竖向交替；"" = 现状
    public string wcRotateList;  // wordCloud.rotate 自定义角度集，逗号分隔（"0,45,-45"）；
                            // 非空时优先于 wcRotate（ECharts textRotation 数组）
    public ChartItemStyle itemStyle;  // ECharts series.itemStyle：normal / emphasis
    public ChartTextStyle label;  // ECharts series.label 的静态样式
    public bool labelShow;  // series.label.show；渲染器可选择显示数据值
    public bool pieLabels;  // 系列级内标百分比（多饼同板逐系列开关，
                              // 覆盖 option.pieLabels；false = 跟随 option）
    public string labelFmt;  // ECharts label.formatter 模板：{a}=系列名 {b}=类目 {c}=值
    public string labelPos;  // ECharts label.position："top"/"bottom"/"insideTop"/
    public int labelShowT;  // label.show 三态：-1 未声明 / 0 false / 1 true。
                              // 缺省随系列型（ECharts PieSeries.ts:269 饼
                              // =true；线柱=false），故存原始三态由渲染器解
                              // 析；labelShow 保留线柱语义（=1 才真）。
    public int labelLineShow;  // labelLine.show 三态：-1 未声明 / 0 / 1（饼外
                              // 标引线；0 只藏线，文本仍在 x3）
    public int labelLineLen;  // labelLine.length：第一段径向长 px；-1 = 缺省 15
    public int labelLineLen2;  // labelLine.length2：第二段水平长 px；-1 = 缺省 30
    public int labelDist;  // label.distanceToLabelLine：文本离水平段 px；
                              // -1 = 缺省 5
    public int labelEdgeDist;  // label.edgeDistance：alignTo:'edge' 时离面板边
                              // px（数字形态）；-1 = 缺省 '25%'
    public int labelAlignTo;  // label.alignTo：0 'none' / 1 'labelLine' / 2 'edge'
    public int labelRotate;  // ECharts label.rotate：系列数值标签整体旋转
                              // （度，ECharts 正值=逆时针；0 = 水平）
                              // "left"/"right"/"insideLeft"/"insideRight"；"" = 渲染器缺省
    public bool valueAnimation;  // label.valueAnimation（数值动画标志）
    public int labelMinMargin;  // label.minMargin（防重叠最小间距）
    public string dataGroupId;  // series.dataGroupId
    public int progressive;  // series.progressive
    public int progressiveThreshold;  // series.progressiveThreshold
    public int edgeSymbolSize;  // graph.edgeSymbolSize
    public bool avoidLabelOverlap;  // pie.avoidLabelOverlap（缺省 true）
    public bool clip;  // series.clip（缺省 true）
    public string sampling;  // series.sampling
    public bool realtimeSort;  // bar.realtimeSort
    public bool legendHoverLink;  // series.legendHoverLink（缺省 true）
    public string nodeAlign;  // sankey.nodeAlign
    public int singleAxisIndex;  // series.singleAxisIndex
    public bool polyline;  // lines.polyline
    public string showEffectOn;  // effectScatter.showEffectOn
    public List<ChartData> data;
    public List<Candle> candles;  // 蜡烛图种类
    public List<Bubble> bubbles;  // 气泡图种类
    public List<BoxItem> boxes;  // 箱线图种类
    public List<ErrorItem> errors;  // 误差条种类
    public List<ChartPoint> points;  // 散点图种类
    public List<ChartNode> tree;  // Treemap / Sunburst（层级根列表）
    public List<ChartLevel> levels;  // N3 levels 分级样式（treemap/sunburst 逐级）
    public int visibleMin;  // 官方 10：子格面积阈值；仅 sort 'asc'/'desc'
                               // 时生效（treemapLayout filterByThreshold），
                               // 语料 sort:true = 不排序 = 不裁剪
    public int leafDepth;  // -1 未声明；声明后 depth>=leafDepth 视作叶
    public int tmBorderWidth;  // -1 未声明（官方 itemStyle.borderWidth 0）
    public int tmBorderColor;  // 0 未声明（官方 neutral00 #fff）
    public int tmGapWidth;  // -1 未声明（官方 0）
    public int tmBorderColorSat;  // -1 未声明；声明后 borderColor 失效
    public int tmHasColorSat;  // series 级 colorSaturation [lo,hi]
    public int tmSatLo;
    public int tmSatHi;
    public int tmUpperShow;  // -1 未声明（官方 upperLabel.show false）
    public int tmUpperHeight;  // -1 未声明（官方 20）
    public int sunLabelMode;  // sunburst 系级 label.rotate：0 未声明 | 1 radial
                               // | 2 tangential | 3 角度（官方缺省 radial）
    public int sunLabelRotate;  // sunLabelMode==3 的角度
    public int sunLabelColor;  // sunburst 系级 label.color；0 未声明
    public int sunItemColor;  // sunburst 系级 itemStyle.color 纯色覆盖；0 未声明
    public int visualDimension;  // 官方 0；obama 多维 value 取维
    public int visualMin;  // -1 未声明（value 域下限拓宽）
    public int visualMax;  // -1 未声明
    public List<ChartLink> links;  // Sankey / Chord / Force 种类
    public List<ChartMapRegion> regions;  // Map 种类
    public List<ChartEvent> events;  // Event River 种类
    public List<ChartMarkPoint> marks;  // markPoint.data（线/柱系列）
    public string markLabelFmt;  // series 级 markPoint.label.formatter 模板
                          // （bar-rich-text "{a|{a}\n}{b|{b} }{c|{c}}"；
                          // {a}=系列名 {b}=mark name {c}=值）
    public ChartTextStyle markLabelSt;  // series 级 markPoint.label 富文本/盒样式；
                                // null = 未声明 rich（pin 徽标走原路径）
    public string markLabelPos;  // markPoint.label.position："right"/"top"（缺省 top）
    public int markLabelDist;  // markPoint.label.distance：-1 = 未声明（官方缺省 5）
    public int markSymbolSize;  // series 级 markPoint.symbolSize：-1 = 未声明
                          // （声明后显式 mark 不再画 pin 气球，画小点）
    public int markOffX;  // markPoint.symbolOffset x
    public int markOffY;  // markPoint.symbolOffset y
    public int markOffXPct;  // markPoint.symbolOffset x %
    public int markOffYPct;  // markPoint.symbolOffset y %
    public bool markOffSet;  // series 级 markPoint 是否声明了 symbolOffset
    public List<ChartMarkLine> markLines;  // markLine.data（阈值/平均线，线/柱系列）

    // series.labelLayout（ECharts 5 标签布局）：绝对 x/y（容器系，像素）
    // 与相对偏移 dx/dy、水平对齐、重叠隐藏与解叠。语料形：dx:-20
    public bool llDeclared;  // 声明了 labelLayout（参与标签布局组的门）
    public int llDx;  // dx：标签 x偏移（px，缺省 0）
    public int llDy;  // dy：标签 y 偏移（px，缺省 0）
    public int llX;  // x：绝对横位（容器系；LL_UNSET = 未声明）
    public int llY;  // y：绝对纵位（容器系；LL_UNSET = 未声明）
    public string llAlign;  // align："" | "left" | "center" | "right"
    public bool llHideOverlap;  // hideOverlap: true = 与已放标签相交则隐藏
    public string llMove;  // moveOverlap："" | "shiftX" | "shiftY"
    public static int LL_UNSET = 0 - 1000000000;  // labelLayout x/y 未声明哨兵

    public string graphLayout;  // ECharts graph.layout："" | "force" | "none" | "circular"
    public List<ChartNodeCoord> nodeCoords;  // graph layout:'none' 逐节点坐标实体（主表示，淘汰 nodeX/nodeY 平行列表）
    public List<string> graphCats;  // graph categories 名称表（图例 + 类别调色板）
    public string coordSys;  // ECharts series.coordinateSystem："geo" = 地理坐标
                          // （散点/lines/graph 系列叠加在地图底图上）；
                          // "calendar" = 日历坐标（日期落在日历格）；
                          // "" = 直角/默认坐标系
    public int z;  // ECharts series.z（与 zlevel 合成绘制键
                          // zlevel*1000+z，见 ChartView.ZKeyOf）：官方缺省
                          // 2，line 3（各 Series.ts）
    public int zlevel;  // ECharts series.zlevel：官方不分层渲染，仅并入
                          // 绘制序键（zlevel*1000+z）
    public int calIndex;  // series.calendarIndex（coordSys == "calendar" 的目标日历）
    public int calCenter;  // calendar 坐标系下 pie.center 的日期（1970 起天序）；-1 = 未给
    public string matCX;  // matrix 坐标系下 pie.center 的 x 格名（"" = 未锚定）
    public string matCY;  // matrix 坐标系下 pie.center 的 y 格名
    public string typeName;  // 原始 ECharts type 字符串（"effectScatter"/"graph"/
                          // "candlestick"..."）。ChartType 是粗粒度归并
                          // 渲染器需要细分时读它。
    public List<List<ChartPoint>> geoLines;  // lines(coordSys=geo)：每项一条折线
                                     // （coords 0.01° 定点，y = -lat×100）

    public GaugeOption gauge;

    // 无参构造：安全初始化全部非空集合
    public ChartSeries() {
        this.InitDefaults("", ChartType.Line);
    }

    // 显式名称与类型构造
    public ChartSeries(string name, ChartType type) {
        this.InitDefaults(name, type);
    }

    // 显式名称与 ECharts 字符串类型构造（支持 'line'/'bar'/'pie'/...）
    public ChartSeries(string name, string typeName) {
        ChartType t = ChartKinds.TypeOf(typeName);
        this.InitDefaults(name, t);
        this.typeName = typeName;
        if (t == ChartType.Custom && typeName != null && typeName.Length > 0) {
            this.custom = ChartKinds.CustomOf(typeName);
        }
    }

    public void InitDefaults(string name, ChartType type) {
        this.name = name;
        this.type = type;
        this.axisIndex = 0;
        this.stack = 0;
        this.stackName = "";
        this.stackStrategy = 0;
        this.color = 0;
        this.hidden = false;
        this.smooth = 0 - 1;
        this.areaStyle = false;
        this.endLabelShow = false;
        this.endLabelDistance = 5;
        this.endLabelFormatter = "";
        this.step = "";
        this.sort = "descending";
        this.boxLeft = null;
        this.boxTop = null;
        this.boxWidth = null;
        this.boxHeight = null;
        this.roseType = "";
        this.startAngle = 90;
        this.clockWise = true;
        this.polarIndex = 0;
        this.selectedOffset = 10;
        this.padAngle = 0;
        this.barWidth = 0;
        this.barWidthPct = 0;
        this.barHeight = 0;
        this.barMinHeight = 0;
        this.barMinAngle = 0;
        this.roundCap = false;
        this.barGapPct = 0 - 1;
        this.barWidthRaw = "";
        this.barGapRaw = "";
        this.barCategoryGapRaw = "";
        this.barMinWidthRaw = "";
        this.barMaxWidthRaw = "";
        this.large = false;
        this.largeThreshold = 400;
        this.silent = false;
        this.symbol = "";
        this.symbolSize = 0;
        this.pointG = 1;
        this.symbolSizeFn = "";
        this.showSymbol = 0 - 1;
        this.showAllSymbol = 0 - 1;
        this.showBackground = false;
        this.backgroundColor = 0;
        this.innerPct = 0;
        this.hbar = false;
        this.treeOrient = "";
        this.z = type == ChartType.Line ? 3 : 2;
        this.zlevel = 0;
        this.initialTreeDepth = 2;
        this.treeExpandCollapse = true;
        this.treeLine = ChartLineStyle.Of(0, 0);
        this.treeLine.type = "";
        this.piePerPoint = false;
        this.custom = "";
        this.emphasisFocus = "";
        this.selectedMode = "";
        this.mapName = "";
        this.geoIndex = 0;
        this.isGeoBase = false;
        this.mapBorderW = 0 - 1;
        this.mapBorderC = 0;
        this.picSymbol = "";
        this.picRepeat = "";
        this.picClip = false;
        this.picPos = "";
        this.picBound = 0;
        this.picW = 0;
        this.picH = 0;
        this.picWPct = 0;
        this.picHPct = 0;
        this.picOffX = 0;
        this.picOffY = 0;
        this.picOffXPct = 0;
        this.picOffYPct = 0;
        this.picOffSet = false;
        this.markOffX = 0;
        this.markOffY = 0;
        this.markOffXPct = 0;
        this.markOffYPct = 0;
        this.markOffSet = false;
        this.parallelRows = new List<ChartParallelRow>();
        this.parRows = new List<List<int>>();
        this.riverPoints = new List<ChartRiverPoint>();
        this.riverNames = new List<string>();
        this.forceScaling = 100;
        this.forceGravity = 100;
        this.forceRepulsion = 100;
        this.forceEdgeLength = 0;
        this.forceMinRadius = 0;
        this.forceMaxRadius = 0;
        this.forceNodeColor = 0;
        this.forceLinkColor = 0;
        this.forceLinkSymbol = "";
        this.chordRibbonType = "";
        this.chordSort = 0;
        this.chordSortSub = false;
        this.chordGapDeg = 0 - 1;
        this.chordRingWidthPct = 0;
        this.matrix = new List<List<int>>();
        this.funnelAlign = "";
        this.funnelGap = 0 - 1;
        this.funnelPercent = false;
        this.maxSizePct = 0;
        this.funnelLabelOut = false;
        this.forceCurveness = 0;
        this.wcMinFontSize = 0;
        this.wcMaxFontSize = 0;
        this.wcRotate = "";
        this.wcRotateList = "";
        this.itemStyle = ChartItemStyle.Create();
        this.label = ChartTextStyle.Create();
        this.labelShow = false;
        this.labelShowT = 0 - 1;
        this.labelLineShow = 0 - 1;
        this.labelLineLen = 0 - 1;
        this.labelLineLen2 = 0 - 1;
        this.labelDist = 0 - 1;
        this.labelEdgeDist = 0 - 1;
        this.labelAlignTo = 0;
        this.pieLabels = false;
        this.labelFmt = "";
        this.labelPos = "";
        this.labelRotate = 0;
        this.valueAnimation = false;
        this.labelMinMargin = 0 - 1;
        this.dataGroupId = "";
        this.progressive = 0;
        this.progressiveThreshold = 0;
        this.edgeSymbolSize = 0;
        this.avoidLabelOverlap = true;
        this.clip = true;
