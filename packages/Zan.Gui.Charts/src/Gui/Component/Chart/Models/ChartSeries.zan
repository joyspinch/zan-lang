    // 从纯 int 值构建系列（每个值变为 ChartData.Of(v)）。
    public static ChartSeries Of(string name, ChartType type, List<int> values) {
        ChartSeries s = new ChartSeries(name, type);
        if (values != null) {
            for (int i = 0; i < values.Count; i = i + 1) { s.data.Add(ChartData.Of(values[i])); }
        }
        return s;
    }

    // 从显式数据项构建系列（名称 / 逐项颜色）。
    public static ChartSeries Named(string name, ChartType type, List<ChartData> data) {
        ChartSeries s = ChartSeries.Of(name, type, new List<int>());
        s.data = data;
        return s;
    }

    // ---- 类型化工厂：每次调用一个系列，ECharts series[i] 风格 ----
    // `{ 名称: '邮件营销', type: 'line', 数据: [...] }` in ECharts.

    // 折线系列。
    public static ChartSeries Line(string name, List<int> values) { return ChartSeries.Of(name, ChartType.Line, values); }
    // 面积折线系列（areaStyle = true，折线下方填充）。
    public static ChartSeries Area(string name, List<int> values) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Line, values);
        s.areaStyle = true;
        return s;
    }
    // 柱状系列。
    public static ChartSeries Bar(string name, List<int> values) { return ChartSeries.Of(name, ChartType.Bar, values); }
    // 堆叠柱系列（stack = 1；同名 stackName 分组可用 JSON 覆盖）。
    public static ChartSeries StackedBar(string name, List<int> values) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Bar, values);
        s.stack = 1;
        return s;
    }
    // 水平条形系列（类目在 Y 轴）。
    public static ChartSeries HBar(string name, List<int> values) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Bar, values);
        s.hbar = true;
        return s;
    }
    // 水平堆叠条形系列（hbar + stack = 1；同名 stackName 分组）。
    public static ChartSeries HStacked(string name, List<int> values) {
        ChartSeries s = ChartSeries.HBar(name, values);
        s.stack = 1;
        return s;
    }
    // 阶梯折线系列（step = "middle"）。
    public static ChartSeries StepLine(string name, List<int> values) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Line, values);
        s.step = "middle";
        return s;
    }
    // 堆叠折线系列（stack = 1）。
    public static ChartSeries StackedLine(string name, List<int> values) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Line, values);
        s.stack = 1;
        return s;
    }
    // 堆叠面积系列（stack = 1 且 areaStyle = true）。
    public static ChartSeries StackedArea(string name, List<int> values) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Line, values);
        s.stack = 1;
        s.areaStyle = true;
        return s;
    }
    // 饼图系列（数据项名称作扇区标签）。
    public static ChartSeries Pie(string name, List<int> values) { return ChartSeries.Of(name, ChartType.Pie, values); }
    // 环形图系列（innerPct = 55）。
    public static ChartSeries Donut(string name, List<int> values) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Pie, values);
        s.innerPct = 55;
        return s;
    }
    // 仪表盘系列：单值，值域由 GaugeRange / option.gaugeMax 决定。
    public static ChartSeries Gauge(string name, int val) {
        ChartSeries s = ChartSeries.Named(name, ChartType.Gauge,
            new List<ChartData>{ ChartData.Named(val, name) });
        return s;
    }
    // 雷达（极坐标）系列；每轴满刻度由 option.radarMax 声明。
    public static ChartSeries Polar(string name, List<int> values) { return ChartSeries.Of(name, ChartType.Radar, values); }
    // 词云系列；data 项名称为词、值为权重。
    public static ChartSeries WordCloud(string name, List<ChartData> words) {
        return ChartSeries.Named(name, ChartType.WordCloud, words);
    }
    // 漏斗系列（默认按值降序）。
    public static ChartSeries Funnel(string name, List<int> values) { return ChartSeries.Of(name, ChartType.Funnel, values); }
    // 金字塔系列（sort = "ascending"，倒漏斗）。
    public static ChartSeries Pyramid(string name, List<int> values) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Funnel, values);
        s.sort = "ascending";
        return s;
    }
    // 玫瑰图系列（roseType = "radius"，扇区半径随值变化）。
    public static ChartSeries Rose(string name, List<int> values) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Pie, values);
        s.roseType = "radius";
        return s;
    }

    // 由 OHLC 柱构建蜡烛图系列（ECharts type "k"）。
    public static ChartSeries OfCandles(string name, List<Candle> candles) {
        ChartSeries s = ChartSeries.Of(name, ChartType.K, new List<int>());
        s.candles = candles;
        return s;
    }

    // 由气泡构建加权散点系列（ECharts scatter + symbolSize）。
    public static ChartSeries OfBubbles(string name, List<Bubble> bubbles) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Scatter, new List<int>());
        s.bubbles = bubbles;
        return s;
    }

    // 由逐分类统计量构建箱线图系列（扩展渲染器）。
    public static ChartSeries OfBoxes(string name, List<BoxItem> boxes) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Custom, new List<int>());
        s.custom = "box";
        s.boxes = boxes;
        return s;
    }

    // 由值 +/- 误差对构建误差条系列（扩展渲染器）。
    public static ChartSeries OfErrors(string name, List<ErrorItem> errors) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Custom, new List<int>());
        s.custom = "error";
        s.errors = errors;
        return s;
    }

    // 由显式 x/y 点构建散点系列。
    public static ChartSeries OfPoints(string name, List<ChartPoint> points) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Scatter, new List<int>());
        s.points = points;
        return s;
    }

    // 值对折线系列（ECharts series.type='line' 且 data 为
    // [[x,y],...]：line7 双数值轴）。与 OfPoints（散点点云）的
    // 区别在类型：折线渲染器画连线+符号+markLine 全套。
    public static ChartSeries OfLinePoints(string name, List<ChartPoint> points) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Line, new List<int>());
        s.points = points;
        return s;
    }

    // 由根节点构建层级系列（Treemap / Tree / Sunburst）。
    // 系列持有根列表；子节点可任意深度嵌套。
    public static ChartSeries OfTree(string name, ChartType type, ChartNode root) {
        ChartSeries s = ChartSeries.Of(name, type, new List<int>());
        s.tree.Add(root);
        return s;
    }

    // 带显式布局方向的树系列（ECharts tree.orient）。
    // 树默认显示节点标签（ECharts label.show 默认 true），
    // JSON label.show=false / labelShow=false 时隐藏、悬停显。
    public static ChartSeries OfTreeOrient(string name, ChartNode root, string orient) {
        ChartSeries s = ChartSeries.OfTree(name, ChartType.Tree, root);
        s.treeOrient = orient;
        s.labelShow = true;
        return s;
    }

    // 由有向流转链接构建 Sankey 系列（节点从链接推导；扩展渲染器）。
    public static ChartSeries OfLinks(string name, List<ChartLink> links) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Custom, new List<int>());
        s.custom = "sankey";
        s.links = links;
        return s;
    }

    // 和弦图系列：节点从 links 的 from/to 推导。
    public static ChartSeries Chord(string name, List<ChartLink> links) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Chord, new List<int>());
        s.links = links;
        return s;
    }


    // 力导向图系列：节点从 links 的 from/to 推导。
    public static ChartSeries Force(string name, List<ChartLink> links) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Force, new List<int>());
        s.links = links;
        return s;
    }

    // 韦恩图系列：data 项依次为 [A, B, A∩B]（名称 + 值）。
    public static ChartSeries Venn(string name, List<ChartData> data) {
        ChartSeries s = ChartSeries.Named(name, ChartType.Custom, data);
        s.custom = "venn";
        return s;
    }

    // 由命名的累计柱数据构建瀑布图系列（渲染器构建
    // 不可见的堆叠基底；扩展渲染器）。
    public static ChartSeries Waterfall(string name, List<ChartData> data) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Custom, new List<int>());
        s.custom = "waterfall";
        s.data = data;
        return s;
    }

    // 由层级根构建 Sunburst 系列（径向环；扩展渲染器）。
    public static ChartSeries SunburstTree(string name, ChartNode root) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Custom, new List<int>());
        s.custom = "sunburst";
        s.tree.Add(root);
        return s;
    }

    // 同心进度环，一个系列 = 一个环（扩展渲染器；
    // option 的 gaugeMax 为满刻度）。
    public static ChartSeries RadialBars(string name, int val) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Custom, new List<int>{ val });
        s.custom = "radialBars";
        return s;
    }

    // 地图系列：从调用方提供的多部件区域构建。渲染器
    // 不硬编码世界地图，polygon 由调用方决定（确定性
    // 样例见 gallery）。
    public static ChartSeries OfRegions(string name, List<ChartMapRegion> regions) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Map, new List<int>());
        s.regions = regions;
        return s;
    }

    // Event River 系列：从显式事件构建。
    public static ChartSeries OfEvents(string name, List<ChartEvent> events) {
        ChartSeries s = ChartSeries.Of(name, ChartType.EventRiver, new List<int>());
        s.events = events;
        return s;
    }


    // 给线/柱系列追加一条 markLine（threshold/average/min/max）。
    public ChartSeries MarkLine(ChartMarkLine m) { this.markLines.Add(m); return this; }

    // 仪表盘的几何与范围。百分比相对图表主体。
    public ChartSeries GaugeRange(int min, int max) { this.gauge.min = min; this.gauge.max = max; return this; }
    // 设置圆心（百分比）与半径（百分比，相对图表主体）。
    public ChartSeries GaugeLayout(int centerXPct, int centerYPct, int radiusPct) {
        this.gauge.center = ChartPosition.Of(ChartScalar.Pct(centerXPct), ChartScalar.Pct(centerYPct));
        this.gauge.radius = ChartScalar.Pct(radiusPct);
        return this;
    }
    // 设置主刻度数与每主格内的细刻度数（axisTick.splitNumber）。
    public ChartSeries GaugeTicks(int splitNumber, int minorTicks) {
        this.gauge.splitNumber = splitNumber; this.gauge.axisTick.splitNumber = minorTicks; return this;
    }
    // 标题/数值牌改用像素偏移，并把数值牌 formatter 设为
    // "{value}" + suffix。
    public ChartSeries GaugeText(int titleX, int titleY, int detailX, int detailY, string suffix) {
        this.gauge.title.offsetCenter = ChartPosition.Of(ChartScalar.Px(titleX), ChartScalar.Px(titleY));
        this.gauge.detail.offsetCenter = ChartPosition.Of(ChartScalar.Px(detailX), ChartScalar.Px(detailY));
        this.gauge.detail.formatter = "{value}" + suffix; return this;
    }
    // 以四段停靠点替换轴线色带；stop1..stop4 为百分比（0..100），
    // 存储时乘 10 换算为 0..1000 千分位。
    public ChartSeries GaugeColors(int stop1, int color1, int stop2, int color2,
                            int stop3, int color3, int stop4, int color4) {
        this.gauge.axisLine.colors = new List<GaugeColorStop>();
        this.gauge.axisLine.colors.Add(GaugeColorStop.Of(stop1 * 10, color1));
        this.gauge.axisLine.colors.Add(GaugeColorStop.Of(stop2 * 10, color2));
        this.gauge.axisLine.colors.Add(GaugeColorStop.Of(stop3 * 10, color3));
        this.gauge.axisLine.colors.Add(GaugeColorStop.Of(stop4 * 10, color4));
        return this;
    }

    // data 项数；纯值对系列（[[x,y],...]，无 data 项）返回
    // points 数——极值/均值/markLine 等窗口推导据此看到值对。
    public int Count() {
        if (this.data.Count > 0) { return this.data.Count; }
        return this.points.Count;
    }

    // 为真 = 声明了 `large` 且数据量超过 `largeThreshold`（缺省 400）。
    // 只影响 barMinWidth 的缺省（0.5 而非 1）。
    public bool InLargeMode() {
        if (!this.large) { return false; }
        int thr = this.largeThreshold;
        if (thr < 1) { thr = 400; }
        return this.Count() > thr;
    }

    // 第 i 项的 double 值；i 越界返回 0.0，整型项返回其 val。
    // 值对系列取第 i 对的 y。
    public double Number(int i) {
        if (i < 0) { return 0.0; }
        if (this.data.Count > 0) {
            if (i >= this.data.Count) { return 0.0; }
            if (this.data[i].numberSet) { return this.data[i].number; }
            return (double)this.data[i].val;
        }
        if (i < this.points.Count) { return (double)this.points[i].y; }
        return 0.0;
    }

    // 第 i 项的值取整为 int（四舍五入、半数远离零；越界同 Number
    // 返回 0）。不截断：小数数据（line6 流量基流 0.86..1.5）截断后
    // 全体归 0，画出的基线与悬停数值（number 保留小数）对不上。
    public int Value(int i) {
        double v = this.Number(i);
        if (v < 0) { return (int)(v - 0.5); }
        return (int)(v + 0.5);
    }

    // 第 i 项是否小数（numberSet 且值非整）。折线族渲染/量程/
    // 提示对这类数据按 1/1000 定点承载（line6 流量 0.46..365、
    // 降雨量 -0.005..-0.955），轴走 leftMinF/rightMinF 定点域。
    public bool SeriesFrac(int i) {
        if (this.data.Count > 0 && i >= 0 && i < this.data.Count) {
            if (this.data[i].numberSet) {
                return this.data[i].number != (double)this.data[i].val;
            }
        }
        return false;
    }

    // 复制系列外壳和所有可变数据列表。Merge 只会替换这些列表
    // 或显式样式字段，因此不会反向修改输入 option。
    // shareData（阶段 B 克隆税豁免）：data/points/candles 等
    // 逐项大集合只读共享引用，不逐项深拷。仅当本帧渲染路径
    // 对这些集合零写入时才允许（见 ResolvedChart.DrawOption：
    // pie/rose/funnel 会经 ApplyDataLegend 写 data[].hidden/
    // selected，必须排除）；外壳字段（hidden/type/areaStyle/
    // itemStyle 等）仍走新对象，工具箱魔法切换等就地写不漏源。
    public static ChartSeries Clone(ChartSeries src) {
        return ChartSeries.Clone(src, false);
    }

    public static ChartSeries Clone(ChartSeries src, bool shareData) {
        if (src == null) { return null; }
        ChartSeries s = ChartSeries.Of(src.name, src.type, new List<int>());
        s.axisIndex = src.axisIndex; s.stack = src.stack; s.stackName = src.stackName;
        s.stackStrategy = src.stackStrategy;
        s.color = src.color; s.hidden = src.hidden; s.smooth = src.smooth;
        s.xIndex = src.xIndex; s.visBlocked = src.visBlocked;
        s.areaStyle = src.areaStyle; s.step = src.step; s.sort = src.sort;
        s.boxLeft = ChartScalar.Clone(src.boxLeft);
        s.boxTop = ChartScalar.Clone(src.boxTop);
        s.boxWidth = ChartScalar.Clone(src.boxWidth);
        s.boxHeight = ChartScalar.Clone(src.boxHeight);
        s.endLabelShow = src.endLabelShow; s.endLabelDistance = src.endLabelDistance;
        s.endLabelFormatter = src.endLabelFormatter;
        s.roseType = src.roseType; s.startAngle = src.startAngle;
        s.clockWise = src.clockWise;
        s.polarIndex = src.polarIndex;
        s.center = ChartPosition.Clone(src.center);
        s.radius = ChartScalar.Clone(src.radius);
        s.radiusInner = ChartScalar.Clone(src.radiusInner);
        s.selectedOffset = src.selectedOffset; s.padAngle = src.padAngle; s.barWidth = src.barWidth;
        s.barWidthPct = src.barWidthPct;
        s.silent = src.silent;
        s.barHeight = src.barHeight;
        s.barMinHeight = src.barMinHeight;
        s.barMinAngle = src.barMinAngle;
        s.roundCap = src.roundCap;
        s.barGapPct = src.barGapPct; s.symbol = src.symbol;
        s.barWidthRaw = src.barWidthRaw; s.barGapRaw = src.barGapRaw;
        s.barCategoryGapRaw = src.barCategoryGapRaw;
        s.barMinWidthRaw = src.barMinWidthRaw;
        s.barMaxWidthRaw = src.barMaxWidthRaw;
        s.large = src.large; s.largeThreshold = src.largeThreshold;
        s.symbolSize = src.symbolSize; s.symbolSizeFn = src.symbolSizeFn;
        s.pointG = src.pointG;
        s.showSymbol = src.showSymbol; s.showAllSymbol = src.showAllSymbol;
        s.showSymbol = src.showSymbol; s.showBackground = src.showBackground;
        s.backgroundColor = src.backgroundColor; s.innerPct = src.innerPct;
        s.hbar = src.hbar; s.treeOrient = src.treeOrient;
        s.z = src.z; s.zlevel = src.zlevel;
        s.initialTreeDepth = src.initialTreeDepth;
        s.treeExpandCollapse = src.treeExpandCollapse;

        s.custom = src.custom;
        s.emphasisFocus = src.emphasisFocus;
        s.treeLine = ChartLineStyle.Clone(src.treeLine);
        s.piePerPoint = src.piePerPoint;
        s.selectedMode = src.selectedMode; s.forceScaling = src.forceScaling;
        s.mapName = src.mapName; s.geoIndex = src.geoIndex;
        s.isGeoBase = src.isGeoBase;
        s.mapBorderW = src.mapBorderW; s.mapBorderC = src.mapBorderC;
        s.picSymbol = src.picSymbol; s.picRepeat = src.picRepeat;
        s.picClip = src.picClip; s.picPos = src.picPos;
        s.picBound = src.picBound; s.picW = src.picW; s.picH = src.picH;
        s.picWPct = src.picWPct; s.picHPct = src.picHPct;
        s.picOffX = src.picOffX; s.picOffY = src.picOffY;
        s.picOffXPct = src.picOffXPct; s.picOffYPct = src.picOffYPct;
        s.picOffSet = src.picOffSet;
        s.markOffX = src.markOffX; s.markOffY = src.markOffY;
        s.markOffXPct = src.markOffXPct; s.markOffYPct = src.markOffYPct;
        s.markOffSet = src.markOffSet;
        // 标量外壳字段必须在早退之前全部抄完——它们按值传递，与数据
        // 集合共享无关；漏抄会让 shareData 路径物化出的系列丢掉
        // force/chord/funnel/wordCloud 参数（conformance drb6 抓出）。
        s.forceGravity = src.forceGravity; s.forceRepulsion = src.forceRepulsion;
        s.forceEdgeLength = src.forceEdgeLength;
        s.forceMinRadius = src.forceMinRadius;
        s.forceMaxRadius = src.forceMaxRadius; s.forceNodeColor = src.forceNodeColor;
        s.forceLinkColor = src.forceLinkColor;
        s.forceLinkSymbol = src.forceLinkSymbol;
        s.chordRibbonType = src.chordRibbonType;
        s.chordSort = src.chordSort; s.chordSortSub = src.chordSortSub;
        s.chordGapDeg = src.chordGapDeg; s.chordRingWidthPct = src.chordRingWidthPct;
        s.funnelAlign = src.funnelAlign; s.funnelGap = src.funnelGap;
        s.funnelPercent = src.funnelPercent; s.wcMinFontSize = src.wcMinFontSize;
        s.maxSizePct = src.maxSizePct; s.funnelLabelOut = src.funnelLabelOut;
        s.forceCurveness = src.forceCurveness;
        s.wcMaxFontSize = src.wcMaxFontSize; s.wcRotate = src.wcRotate;
        s.wcRotateList = src.wcRotateList;
        s.labelShow = src.labelShow;
        s.labelShowT = src.labelShowT;
        s.labelLineShow = src.labelLineShow;
        s.labelLineLen = src.labelLineLen;
        s.labelLineLen2 = src.labelLineLen2;
        s.labelDist = src.labelDist;
        s.labelEdgeDist = src.labelEdgeDist;
        s.labelAlignTo = src.labelAlignTo;
        s.pieLabels = src.pieLabels;
        s.labelFmt = src.labelFmt; s.labelPos = src.labelPos;
        s.labelRotate = src.labelRotate;
        s.valueAnimation = src.valueAnimation;
        s.labelMinMargin = src.labelMinMargin;
        s.dataGroupId = src.dataGroupId;
        s.progressive = src.progressive;
        s.progressiveThreshold = src.progressiveThreshold;
        s.edgeSymbolSize = src.edgeSymbolSize;
        s.avoidLabelOverlap = src.avoidLabelOverlap;
        s.clip = src.clip;
        s.sampling = src.sampling;
        s.realtimeSort = src.realtimeSort;
        s.legendHoverLink = src.legendHoverLink;
        s.nodeAlign = src.nodeAlign;
        s.singleAxisIndex = src.singleAxisIndex;
        s.polyline = src.polyline;
        s.showEffectOn = src.showEffectOn;
        s.graphLayout = src.graphLayout;
        s.coordSys = src.coordSys;
        s.calIndex = src.calIndex;
        s.calCenter = src.calCenter;
        s.matCX = src.matCX;
        s.matCY = src.matCY;
        s.typeName = src.typeName;
        // N3 分级样式域（treemap/sunburst）：纯标量，与数据共享无关，
        // 必须在 shareData 早退前抄全，否则 Materialize 丢级样式。
        s.visibleMin = src.visibleMin;
        s.leafDepth = src.leafDepth;
        s.tmBorderWidth = src.tmBorderWidth;
        s.tmBorderColor = src.tmBorderColor;
        s.tmGapWidth = src.tmGapWidth;
        s.tmBorderColorSat = src.tmBorderColorSat;
        s.tmHasColorSat = src.tmHasColorSat;
        s.tmSatLo = src.tmSatLo;
        s.tmSatHi = src.tmSatHi;
        s.tmUpperShow = src.tmUpperShow;
        s.tmUpperHeight = src.tmUpperHeight;
        s.sunLabelMode = src.sunLabelMode;
        s.sunLabelRotate = src.sunLabelRotate;
        s.sunLabelColor = src.sunLabelColor;
        s.sunItemColor = src.sunItemColor;
        s.visualDimension = src.visualDimension;
        s.visualMin = src.visualMin;
        s.visualMax = src.visualMax;
        if (shareData) {
            // 阶段 B：渲染帧对数据集合只读，直接共享引用（scatter-large
            // /scatter-weibo 的逐项克隆税由此归零）。写方（图例态
            // ApplyDataLegend、交互回写）必须走「s.data = 新列表或经
            // Clone(shareData:false)」的路径，绝不能经共享引用就地写。
            s.data = src.data;
            s.candles = src.candles;
            s.bubbles = src.bubbles;
            s.boxes = src.boxes;
            s.errors = src.errors;
            s.points = src.points;
            s.tree = src.tree;
            s.levels = src.levels;
            s.links = src.links;
            s.regions = src.regions;
            s.events = src.events;
            s.marks = src.marks;
            s.markLines = src.markLines;
            s.parallelRows = src.parallelRows;
            s.parRows = src.parRows;
            s.matrix = src.matrix;
            s.nodeCoords = src.nodeCoords;
            s.graphCats = src.graphCats;
            s.geoLines = src.geoLines;
            s.riverPoints = src.riverPoints;
            s.riverNames = src.riverNames;
            s.itemStyle = src.itemStyle;
            s.label = src.label;
            s.markLabelFmt = src.markLabelFmt;
            s.markLabelSt = src.markLabelSt;
            s.markLabelPos = src.markLabelPos;
            s.markLabelDist = src.markLabelDist;
            s.markSymbolSize = src.markSymbolSize;
            s.llDeclared = src.llDeclared;
            s.llDx = src.llDx;
            s.llDy = src.llDy;
            s.llX = src.llX;
            s.llY = src.llY;
            s.llAlign = src.llAlign;
            s.llHideOverlap = src.llHideOverlap;
            s.llMove = src.llMove;
            s.gauge = src.gauge;
            return s;
        }
        s.parallelRows = new List<ChartParallelRow>();
        if (src.parallelRows != null) {
            for (int pr = 0; pr < src.parallelRows.Count; pr = pr + 1) {
                s.parallelRows.Add(ChartParallelRow.Clone(src.parallelRows[pr]));
            }
        }
        s.parRows = new List<List<int>>();
        for (int pr = 0; pr < src.parRows.Count; pr = pr + 1) {
            List<int> row = src.parRows[pr];
            List<int> cp = new List<int>();
            for (int pc = 0; pc < row.Count; pc = pc + 1) { cp.Add(row[pc]); }
            s.parRows.Add(cp);
        }
        s.riverPoints = new List<ChartRiverPoint>();
        for (int rp = 0; rp < src.riverPoints.Count; rp = rp + 1) {
            s.riverPoints.Add(ChartRiverPoint.Clone(src.riverPoints[rp]));
        }
        s.riverNames = new List<string>();
        for (int rn = 0; rn < src.riverNames.Count; rn = rn + 1) { s.riverNames.Add(src.riverNames[rn]); }
        s.matrix = new List<List<int>>();
        for (int mi = 0; mi < src.matrix.Count; mi = mi + 1) {
            List<int> row = new List<int>();
            for (int mj = 0; mj < src.matrix[mi].Count; mj = mj + 1) {
                row.Add(src.matrix[mi][mj]);
            }
            s.matrix.Add(row);
        }
        s.itemStyle = ChartItemStyle.Clone(src.itemStyle);
        s.label = ChartTextStyle.Clone(src.label);
        s.gauge = GaugeOption.Clone(src.gauge);
        s.data = new List<ChartData>();
        for (int i = 0; i < src.data.Count; i = i + 1) { s.data.Add(ChartData.Clone(src.data[i])); }
        s.candles = new List<Candle>();
        for (int i = 0; i < src.candles.Count; i = i + 1) { s.candles.Add(Candle.Clone(src.candles[i])); }
        s.bubbles = new List<Bubble>();
        for (int i = 0; i < src.bubbles.Count; i = i + 1) { s.bubbles.Add(Bubble.Clone(src.bubbles[i])); }
        s.boxes = new List<BoxItem>();
        for (int i = 0; i < src.boxes.Count; i = i + 1) { s.boxes.Add(BoxItem.Clone(src.boxes[i])); }
        s.errors = new List<ErrorItem>();
        for (int i = 0; i < src.errors.Count; i = i + 1) { s.errors.Add(ErrorItem.Clone(src.errors[i])); }
        s.points = new List<ChartPoint>();
        for (int i = 0; i < src.points.Count; i = i + 1) { s.points.Add(ChartPoint.Clone(src.points[i])); }
        s.tree = new List<ChartNode>();
        for (int i = 0; i < src.tree.Count; i = i + 1) { s.tree.Add(ChartNode.Clone(src.tree[i])); }
        s.levels = new List<ChartLevel>();
        for (int i = 0; i < src.levels.Count; i = i + 1) { s.levels.Add(ChartLevel.Clone(src.levels[i])); }
        s.visibleMin = src.visibleMin;
        s.leafDepth = src.leafDepth;
        s.tmBorderWidth = src.tmBorderWidth;
        s.tmBorderColor = src.tmBorderColor;
        s.tmGapWidth = src.tmGapWidth;
        s.tmBorderColorSat = src.tmBorderColorSat;
        s.tmHasColorSat = src.tmHasColorSat;
        s.tmSatLo = src.tmSatLo;
        s.tmSatHi = src.tmSatHi;
        s.tmUpperShow = src.tmUpperShow;
        s.tmUpperHeight = src.tmUpperHeight;
        s.sunLabelMode = src.sunLabelMode;
        s.sunLabelRotate = src.sunLabelRotate;
        s.sunLabelColor = src.sunLabelColor;
        s.sunItemColor = src.sunItemColor;
        s.visualDimension = src.visualDimension;
        s.visualMin = src.visualMin;
        s.visualMax = src.visualMax;
        s.links = new List<ChartLink>();
        for (int i = 0; i < src.links.Count; i = i + 1) { s.links.Add(ChartLink.Clone(src.links[i])); }
        s.regions = new List<ChartMapRegion>();
        for (int i = 0; i < src.regions.Count; i = i + 1) { s.regions.Add(ChartMapRegion.Clone(src.regions[i])); }
        s.events = new List<ChartEvent>();
        for (int i = 0; i < src.events.Count; i = i + 1) { s.events.Add(ChartEvent.Clone(src.events[i])); }
        s.marks = new List<ChartMarkPoint>();
        for (int i = 0; i < src.marks.Count; i = i + 1) { s.marks.Add(ChartMarkPoint.Clone(src.marks[i])); }
        s.markLines = new List<ChartMarkLine>();
        for (int i = 0; i < src.markLines.Count; i = i + 1) { s.markLines.Add(ChartMarkLine.Clone(src.markLines[i])); }
        s.markLabelFmt = src.markLabelFmt;
        s.markLabelSt = ChartTextStyle.Clone(src.markLabelSt);
        s.markLabelPos = src.markLabelPos;
        s.markLabelDist = src.markLabelDist;
        s.markSymbolSize = src.markSymbolSize;
        s.llDeclared = src.llDeclared;
        s.llDx = src.llDx;
        s.llDy = src.llDy;
        s.llX = src.llX;
        s.llY = src.llY;
        s.llAlign = src.llAlign;
        s.llHideOverlap = src.llHideOverlap;
        s.llMove = src.llMove;
        s.nodeCoords = new List<ChartNodeCoord>();
        if (src.nodeCoords != null) {
            for (int i = 0; i < src.nodeCoords.Count; i = i + 1) {
                s.nodeCoords.Add(new ChartNodeCoord(src.nodeCoords[i].x, src.nodeCoords[i].y));
            }
        }
        s.graphCats = new List<string>();
        for (int i = 0; i < src.graphCats.Count; i = i + 1) { s.graphCats.Add(src.graphCats[i]); }
        s.geoLines = new List<List<ChartPoint>>();
        for (int i = 0; i < src.geoLines.Count; i = i + 1) {
            List<ChartPoint> line = new List<ChartPoint>();
            for (int k = 0; k < src.geoLines[i].Count; k = k + 1) {
                line.Add(ChartPoint.Clone(src.geoLines[i][k]));
            }
            s.geoLines.Add(line);
        }
        return s;
    }
}

// 一个坐标轴（ECharts xAxis/yAxis 条目）。分类轴携带其
// 标签；数值轴携带可选固定范围（ChartOption.Auto()
// 从数据推导）和刻度数。
