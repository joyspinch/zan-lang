using System;

namespace Gui.Component.Chart;

// 极坐标柱渲染所需的一套轴投影（单个 polar 坐标系）。
// `aLo/aHi`、`rLo/rHi` 是值轴的**数据域**（原值单位，非定点）；
// `r0Px/r1Px` 是半径轴的像素范围。
public class ChartPolarBarFrame {
    public int cx;
    public int cy;
    public int r0Px;
    public int r1Px;
    public bool aCat;
    public bool rCat;
    public double aLo;
    public double aHi;
    public double rLo;
    public double rHi;
    public List<string> aCats;
    public List<string> rCats;
    public int startAngle;  // 角度轴起始角（"顺时针为正"的屏幕角）
    public int endAngle;
    public bool endAngleSet;
    public bool clockwise;
    public bool aOnBand;
    public bool rOnBand;
}
