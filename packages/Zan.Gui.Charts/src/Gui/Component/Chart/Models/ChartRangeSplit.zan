using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartRangeSplit {
    public string label;
    public int lo;
    public int hi;

    // 构造一个命名区间；lo/hi 可为 ChartOption.Auto() 表示开口。
    public static ChartRangeSplit Of(string label, int lo, int hi) {
        ChartRangeSplit s = new ChartRangeSplit();
        s.label = label;
        s.lo = lo;
        s.hi = hi;
        return s;
    }

    // 深复制；src 为 null 时返回 null。
    public static ChartRangeSplit Clone(ChartRangeSplit src) {
        if (src == null) { return null; }
        return ChartRangeSplit.Of(src.label, src.lo, src.hi);
    }
}

// 一个命名、按列存储的数据集维度。
