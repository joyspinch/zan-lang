using System;
using System.Json;
using System.Text;
using Gui;

namespace Gui.Component.Chart;

class ChartGraphic {
    string type;
    string id;
    int x;
    int y;
    string left;
    string top;
    string right;
    string bottom;
    int shapeX;
    int shapeY;
    int shapeW;
    int shapeH;
    int shapeR;
    int fill;
    bool hasFill;
    int stroke;
    int strokeWidth;
    string text;
    int fontSize;
    string fontWeight;
    int z;
    bool keyframeAnimation;
    int animDuration;
    List<ChartGraphic> children;

    static ChartGraphic Create() {
        ChartGraphic g = new ChartGraphic();
        g.type = "rect";
        g.id = "";
        g.x = 0;
        g.y = 0;
        g.left = "";
        g.top = "";
        g.right = "";
        g.bottom = "";
        g.shapeX = 0;
        g.shapeY = 0;
        g.shapeW = 0;
        g.shapeH = 0;
        g.shapeR = 0;
        g.fill = 0;
        g.hasFill = false;
        g.stroke = 0;
        g.strokeWidth = 1;
        g.text = "";
        g.fontSize = 14;
        g.fontWeight = "normal";
        g.z = 0;
        g.keyframeAnimation = false;
        g.animDuration = 1000;
        g.children = new List<ChartGraphic>();
        return g;
    }
}
