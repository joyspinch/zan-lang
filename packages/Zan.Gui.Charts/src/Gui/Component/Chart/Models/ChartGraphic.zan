using System;
using System.Json;
using System.Text;
using Gui;

namespace Gui.Component.Chart;

public class ChartGraphic {
    public string type;
    public string id;
    public int x;
    public int y;
    public string left;
    public string top;
    public string right;
    public string bottom;
    public int shapeX;
    public int shapeY;
    public int shapeW;
    public int shapeH;
    public int shapeR;
    public int fill;
    public bool hasFill;
    public int stroke;
    public int strokeWidth;
    public string text;
    public int fontSize;
    public string fontWeight;
    public int z;
    public bool keyframeAnimation;
    public int animDuration;
    public List<ChartGraphic> children;

    public static ChartGraphic Create() {
        ChartGraphic g = new ChartGraphic();
        g.type = "rect";
        g.id = "";
        g.x = 0;
        g.y = 0;
        g.left = "";
        g.top = "";
        g.right = "";
        g.bottom = "";
        g.shapeX = 0;
        g.shapeY = 0;
        g.shapeW = 0;
        g.shapeH = 0;
        g.shapeR = 0;
        g.fill = 0;
        g.hasFill = false;
        g.stroke = 0;
        g.strokeWidth = 1;
        g.text = "";
        g.fontSize = 14;
        g.fontWeight = "normal";
        g.z = 0;
        g.keyframeAnimation = false;
        g.animDuration = 1000;
        g.children = new List<ChartGraphic>();
        return g;
    }
}
