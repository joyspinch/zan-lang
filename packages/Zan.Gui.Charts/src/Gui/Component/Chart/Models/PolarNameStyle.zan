using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// 雷达极坐标指示器样式实体（消除 pnameCol / pnameFmt 平行列表反模式）。
public class PolarNameStyle {
    public int color;
    public string format;

    public PolarNameStyle(int color, string format) {
        this.color = color;
        this.format = format;
    }
}
