using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// 大数据量图表抽取列的 [min, max] 范围实体（消除 colMin 与 colMax 平行列表反模式）。
public class ChartBigColExtents {
    public int min;
    public int max;

    public ChartBigColExtents(int min, int max) {
        this.min = min;
        this.max = max;
    }

    public static ChartBigColExtents Of(int min, int max) {
        return new ChartBigColExtents(min, max);
    }
}
