using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class GaugeAxisLine {
    public bool show;
    public ChartLineStyle lineStyle;
    public List<GaugeColorStop> colors;

    // 构造默认轴线：显示、宽 10，并预置 ECharts 风格三段色带
    // （20% 以下绿、80% 以下蓝、以上红）。
    public static GaugeAxisLine Create() {
        GaugeAxisLine a = new GaugeAxisLine {
            show = true, lineStyle = ChartLineStyle.Of(0, 10), colors = new List<GaugeColorStop>()
        };
        // ECharts 自带的仪表盘调色板（20% 以下绿、80% 以下蓝、以上红），
        // 未设置任何颜色的仪表盘看起来像参考示例，
        // 而不是在深色皮肤下消失的纯灰环。
        a.colors.Add(GaugeColorStop.Of(200, ChartColor.Rgb(34, 139, 34)));
        a.colors.Add(GaugeColorStop.Of(800, ChartColor.Rgb(68, 136, 187)));
        a.colors.Add(GaugeColorStop.Of(1000, ChartColor.Rgb(255, 69, 0)));
        return a;
    }

    // 深复制（含色带列表）；src 为 null 时返回 null。
    public static GaugeAxisLine Clone(GaugeAxisLine src) {
        if (src == null) { return null; }
        GaugeAxisLine a = new GaugeAxisLine { show = src.show,
            lineStyle = ChartLineStyle.Clone(src.lineStyle), colors = new List<GaugeColorStop>() };
        if (src.colors != null) {
            for (int i = 0; i < src.colors.Count; i = i + 1) {
                a.colors.Add(GaugeColorStop.Clone(src.colors[i]));
            }
        }
        return a;
    }
}

// 仪表盘刻度线：主刻度数、刻度长度与线样式。
