using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

public class Candle {
    public int open;
    public int high;
    public int low;
    public int close;
    // ECharts data 项逐根 itemStyle 覆盖（k1 首根蓝色阴线）；
    // null = 跟随系列 itemStyle。渲染器只读 normal 态。
    public ChartItemStyle itemStyle;
    // 构造一根 OHLC 柱。
    public static Candle Of(int open, int high, int low, int close) {
        Candle c = new Candle();
        c.open = open;
        c.high = high;
        c.low = low;
        c.close = close;
        return c;
    }

    // 深复制；src 为 null 时返回 null。
    // 面向对象深复制实例方法。

    public Candle Clone() {

        return Candle.Clone(this);

    }


    public static Candle Clone(Candle src) {
        if (src == null) { return null; }
        Candle c = Candle.Of(src.open, src.high, src.low, src.close);
        c.itemStyle = ChartItemStyle.Clone(src.itemStyle);
        return c;
    }
}

public class BoxItem {
    public string label;
    public int lo;
    public int q1;
    public int med;
    public int q3;
    public int hi;
    // 构造一个箱线统计项（五数概括 + 分类标签）。
    public static BoxItem Of(string label, int lo, int q1, int med, int q3, int hi) {
        BoxItem b = new BoxItem();
        b.label = label;
        b.lo = lo;
        b.q1 = q1;
        b.med = med;
        b.q3 = q3;
        b.hi = hi;
        return b;
    }

    // 深复制；src 为 null 时返回 null。
    public static BoxItem Clone(BoxItem src) {
        if (src == null) { return null; }
        return BoxItem.Of(src.label, src.lo, src.q1, src.med, src.q3, src.hi);
    }
}

public class ErrorItem {
    public string label;
    public int y;
    public int err;
    // 构造一个误差条项（值 y、对称误差 ±err、分类标签）。
    public static ErrorItem Of(string label, int y, int err) {
        ErrorItem e = new ErrorItem();
        e.label = label;
        e.y = y;
        e.err = err;
        return e;
    }

    // 深复制；src 为 null 时返回 null。
    public static ErrorItem Clone(ErrorItem src) {
        if (src == null) { return null; }
        return ErrorItem.Of(src.label, src.y, src.err);
    }
}
