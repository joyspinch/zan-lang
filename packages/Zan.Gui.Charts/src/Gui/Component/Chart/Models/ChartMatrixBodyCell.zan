using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartMatrixBodyCell {
    public string text;
    public int x0;
    public int x1;
    public int y0;
    public int y1;
    public int labelColor;
    public int labelFontSize;

    public ChartMatrixBodyCell(string text, int x0, int x1, int y0, int y1, int labelColor, int labelFontSize) {
        this.text = text != null ? text : "";
        this.x0 = x0;
        this.x1 = x1;
        this.y0 = y0;
        this.y1 = y1;
        this.labelColor = labelColor;
        this.labelFontSize = labelFontSize;
    }
}
