using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartMatrixBodyCell {
    public string text;
    public int x0;
    public int x1;
    public int y0;
    public int y1;
    public int labelColor;
    public int labelFontSize;

    public ChartMatrixBodyCell(string text, int x0, int x1, int y0, int y1, int labelColor, int labelFontSize) {
        this.text = text != null ? text : "";
        this.x0 = x0;
        this.x1 = x1;
        this.y0 = y0;
        this.y1 = y1;
        this.labelColor = labelColor;
        this.labelFontSize = labelFontSize;
    }
}

// ECharts6 matrix 坐标系组件（官方 coord/matrix/MatrixModel +
// MatrixDim）：x/y 各是一棵维度树，叶子是布局单位。树前序展平进
// 强类型节点列表：first = 子树第一片叶子的序号，span = 覆盖叶子数，
// level = 树深。体格 (i,j) = x 第 i 叶列 × y 第 j 叶行；组格 =
// 叶子域合并的头部格（官方 getCell 支持任意层级按名寻址）。
