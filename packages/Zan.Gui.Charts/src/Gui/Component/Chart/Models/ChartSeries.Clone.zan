using System;
using System.Json;
using System.Text;
using Gui;

namespace Gui.Component.Chart;

// ChartSeries.Clone.zan - ChartSeries 实例与静态深复制实现（支持 shareData 阶段 B 只读数据免深拷）
public partial class ChartSeries {
    // 复制系列外壳和所有可变数据列表。Merge 只会替换这些列表
    // 或显式样式字段，因此不会反向修改输入 option。
    // shareData（阶段 B 克隆税豁免）：data/points/candles 等
    // 逐项大集合只读共享引用，不逐项深拷。仅当本帧渲染路径
    // 对这些集合零写入时才允许（见 ResolvedChart.DrawOption：
    // pie/rose/funnel 会经 ApplyDataLegend 写 data[].hidden/
    // selected，必须排除）；外壳字段（hidden/type/areaStyle/
    // itemStyle 等）仍走新对象，工具箱魔法切换等就地写不漏源。
    // 面向对象深复制实例方法。

    public ChartSeries Clone() {
        return this.Clone(false);
    }

    public ChartSeries Clone(bool shareData) {
        ChartSeries s = ChartSeries.Of(this.name, this.type, new List<int>());
        s.axisIndex = this.axisIndex; s.stack = this.stack; s.stackName = this.stackName;
        s.stackStrategy = this.stackStrategy;
        s.color = this.color; s.hidden = this.hidden; s.smooth = this.smooth;
        s.xIndex = this.xIndex; s.visBlocked = this.visBlocked;
        s.areaStyle = this.areaStyle; s.step = this.step; s.sort = this.sort;
        s.boxLeft = this.boxLeft != null ? this.boxLeft.Clone() : null;
        s.boxTop = this.boxTop != null ? this.boxTop.Clone() : null;
        s.boxWidth = this.boxWidth != null ? this.boxWidth.Clone() : null;
        s.boxHeight = this.boxHeight != null ? this.boxHeight.Clone() : null;
        s.endLabelShow = this.endLabelShow; s.endLabelDistance = this.endLabelDistance;
        s.endLabelFormatter = this.endLabelFormatter;
        s.roseType = this.roseType; s.startAngle = this.startAngle;
        s.clockWise = this.clockWise;
        s.polarIndex = this.polarIndex;
        s.center = this.center != null ? this.center.Clone() : null;
        s.radius = this.radius != null ? this.radius.Clone() : null;
        s.radiusInner = this.radiusInner != null ? this.radiusInner.Clone() : null;
        s.selectedOffset = this.selectedOffset; s.padAngle = this.padAngle; s.barWidth = this.barWidth;
        s.barWidthPct = this.barWidthPct;
        s.silent = this.silent;
        s.barHeight = this.barHeight;
        s.barMinHeight = this.barMinHeight;
        s.barMinAngle = this.barMinAngle;
        s.roundCap = this.roundCap;
        s.barGapPct = this.barGapPct; s.symbol = this.symbol;
        s.barWidthRaw = this.barWidthRaw; s.barGapRaw = this.barGapRaw;
        s.barCategoryGapRaw = this.barCategoryGapRaw;
        s.barMinWidthRaw = this.barMinWidthRaw;
        s.barMaxWidthRaw = this.barMaxWidthRaw;
        s.large = this.large; s.largeThreshold = this.largeThreshold;
        s.symbolSize = this.symbolSize; s.symbolSizeFn = this.symbolSizeFn;
        s.pointG = this.pointG;
        s.showSymbol = this.showSymbol; s.showAllSymbol = this.showAllSymbol;
        s.showSymbol = this.showSymbol; s.showBackground = this.showBackground;
        s.backgroundColor = this.backgroundColor; s.innerPct = this.innerPct;
        s.hbar = this.hbar; s.treeOrient = this.treeOrient;
        s.z = this.z; s.zlevel = this.zlevel;
        s.initialTreeDepth = this.initialTreeDepth;
        s.treeExpandCollapse = this.treeExpandCollapse;

        s.custom = this.custom;
        s.emphasisFocus = this.emphasisFocus;
        s.treeLine = this.treeLine != null ? this.treeLine.Clone() : null;
        s.piePerPoint = this.piePerPoint;
        s.selectedMode = this.selectedMode; s.forceScaling = this.forceScaling;
        s.mapName = this.mapName; s.geoIndex = this.geoIndex;
        s.isGeoBase = this.isGeoBase;
        s.mapBorderW = this.mapBorderW; s.mapBorderC = this.mapBorderC;
        s.picSymbol = this.picSymbol; s.picRepeat = this.picRepeat;
        s.picClip = this.picClip; s.picPos = this.picPos;
        s.picBound = this.picBound; s.picW = this.picW; s.picH = this.picH;
        s.picWPct = this.picWPct; s.picHPct = this.picHPct;
        s.picOffX = this.picOffX; s.picOffY = this.picOffY;
        s.picOffXPct = this.picOffXPct; s.picOffYPct = this.picOffYPct;
        s.picOffSet = this.picOffSet;
        s.markOffX = this.markOffX; s.markOffY = this.markOffY;
        s.markOffXPct = this.markOffXPct; s.markOffYPct = this.markOffYPct;
        s.markOffSet = this.markOffSet;
        // 标量外壳字段必须在早退之前全部抄完——它们按值传递，与数据
        // 集合共享无关；漏抄会让 shareData 路径物化出的系列丢掉
        // force/chord/funnel/wordCloud 参数（conformance drb6 抓出）。
        s.forceGravity = this.forceGravity; s.forceRepulsion = this.forceRepulsion;
        s.forceEdgeLength = this.forceEdgeLength;
        s.forceMinRadius = this.forceMinRadius;
        s.forceMaxRadius = this.forceMaxRadius; s.forceNodeColor = this.forceNodeColor;
        s.forceLinkColor = this.forceLinkColor;
        s.forceLinkSymbol = this.forceLinkSymbol;
        s.chordRibbonType = this.chordRibbonType;
        s.chordSort = this.chordSort; s.chordSortSub = this.chordSortSub;
        s.chordGapDeg = this.chordGapDeg; s.chordRingWidthPct = this.chordRingWidthPct;
        s.funnelAlign = this.funnelAlign; s.funnelGap = this.funnelGap;
        s.funnelPercent = this.funnelPercent; s.wcMinFontSize = this.wcMinFontSize;
        s.maxSizePct = this.maxSizePct; s.funnelLabelOut = this.funnelLabelOut;
        s.forceCurveness = this.forceCurveness;
        s.wcMaxFontSize = this.wcMaxFontSize; s.wcRotate = this.wcRotate;
        s.wcRotateList = this.wcRotateList;
        s.labelShow = this.labelShow;
        s.labelShowT = this.labelShowT;
        s.labelLineShow = this.labelLineShow;
        s.labelLineLen = this.labelLineLen;
        s.labelLineLen2 = this.labelLineLen2;
        s.labelDist = this.labelDist;
        s.labelEdgeDist = this.labelEdgeDist;
        s.labelAlignTo = this.labelAlignTo;
        s.pieLabels = this.pieLabels;
        s.labelFmt = this.labelFmt; s.labelPos = this.labelPos;
        s.labelRotate = this.labelRotate;
        s.valueAnimation = this.valueAnimation;
        s.labelMinMargin = this.labelMinMargin;
        s.dataGroupId = this.dataGroupId;
        s.progressive = this.progressive;
        s.progressiveThreshold = this.progressiveThreshold;
        s.edgeSymbolSize = this.edgeSymbolSize;
        s.avoidLabelOverlap = this.avoidLabelOverlap;
        s.clip = this.clip;
        s.sampling = this.sampling;
        s.realtimeSort = this.realtimeSort;
        s.legendHoverLink = this.legendHoverLink;
        s.nodeAlign = this.nodeAlign;
        s.singleAxisIndex = this.singleAxisIndex;
        s.polyline = this.polyline;
        s.showEffectOn = this.showEffectOn;
        s.graphLayout = this.graphLayout;
        s.coordSys = this.coordSys;
        s.calIndex = this.calIndex;
        s.calCenter = this.calCenter;
        s.matCX = this.matCX;
        s.matCY = this.matCY;
        s.typeName = this.typeName;
        // N3 分级样式域（treemap/sunburst）：纯标量，与数据共享无关，
        // 必须在 shareData 早退前抄全，否则 Materialize 丢级样式。
        s.visibleMin = this.visibleMin;
        s.leafDepth = this.leafDepth;
        s.tmBorderWidth = this.tmBorderWidth;
        s.tmBorderColor = this.tmBorderColor;
        s.tmGapWidth = this.tmGapWidth;
        s.tmBorderColorSat = this.tmBorderColorSat;
        s.tmHasColorSat = this.tmHasColorSat;
        s.tmSatLo = this.tmSatLo;
        s.tmSatHi = this.tmSatHi;
        s.tmUpperShow = this.tmUpperShow;
        s.tmUpperHeight = this.tmUpperHeight;
        s.sunLabelMode = this.sunLabelMode;
        s.sunLabelRotate = this.sunLabelRotate;
        s.sunLabelColor = this.sunLabelColor;
        s.sunItemColor = this.sunItemColor;
        s.visualDimension = this.visualDimension;
        s.visualMin = this.visualMin;
        s.visualMax = this.visualMax;
        if (shareData) {
            // 阶段 B：渲染帧对数据集合只读，直接共享引用（scatter-large
            // /scatter-weibo 的逐项克隆税由此归零）。写方（图例态
            // ApplyDataLegend、交互回写）必须走「s.data = 新列表或经
            // Clone(shareData:false)」的路径，绝不能经共享引用就地写。
            s.data = this.data;
            s.candles = this.candles;
            s.bubbles = this.bubbles;
            s.boxes = this.boxes;
            s.errors = this.errors;
            s.points = this.points;
            s.tree = this.tree;
            s.levels = this.levels;
            s.links = this.links;
            s.regions = this.regions;
            s.events = this.events;
            s.marks = this.marks;
            s.markLines = this.markLines;
            s.parallelRows = this.parallelRows;
            s.parRows = this.parRows;
            s.matrix = this.matrix;
            s.nodeCoords = this.nodeCoords;
            s.graphCats = this.graphCats;
            s.geoLines = this.geoLines;
            s.riverPoints = this.riverPoints;
            s.riverNames = this.riverNames;
            s.itemStyle = this.itemStyle;
            s.label = this.label;
            s.markLabelFmt = this.markLabelFmt;
            s.markLabelSt = this.markLabelSt;
            s.markLabelPos = this.markLabelPos;
            s.markLabelDist = this.markLabelDist;
            s.markSymbolSize = this.markSymbolSize;
            s.llDeclared = this.llDeclared;
            s.llDx = this.llDx;
            s.llDy = this.llDy;
            s.llX = this.llX;
            s.llY = this.llY;
            s.llAlign = this.llAlign;
            s.llHideOverlap = this.llHideOverlap;
            s.llMove = this.llMove;
            s.gauge = this.gauge;
            return s;
        }
        s.parallelRows = new List<ChartParallelRow>();
        if (this.parallelRows != null) {
            for (int pr = 0; pr < this.parallelRows.Count; pr = pr + 1) {
                ChartParallelRow row = this.parallelRows[pr];
                s.parallelRows.Add(row != null ? row.Clone() : null);
            }
        }
        s.parRows = new List<List<int>>();
        if (this.parRows != null) {
            for (int pr = 0; pr < this.parRows.Count; pr = pr + 1) {
                List<int> row = this.parRows[pr];
                List<int> cp = new List<int>();
                for (int pc = 0; pc < row.Count; pc = pc + 1) { cp.Add(row[pc]); }
                s.parRows.Add(cp);
            }
        }
        s.riverPoints = new List<ChartRiverPoint>();
        if (this.riverPoints != null) {
            for (int rp = 0; rp < this.riverPoints.Count; rp = rp + 1) {
                ChartRiverPoint pt = this.riverPoints[rp];
                s.riverPoints.Add(pt != null ? pt.Clone() : null);
            }
        }
        s.riverNames = new List<string>();
        if (this.riverNames != null) {
            for (int rn = 0; rn < this.riverNames.Count; rn = rn + 1) { s.riverNames.Add(this.riverNames[rn]); }
        }
        s.matrix = new List<List<int>>();
        if (this.matrix != null) {
            for (int mi = 0; mi < this.matrix.Count; mi = mi + 1) {
                List<int> row = new List<int>();
                for (int mj = 0; mj < this.matrix[mi].Count; mj = mj + 1) {
                    row.Add(this.matrix[mi][mj]);
                }
                s.matrix.Add(row);
            }
        }
        s.itemStyle = this.itemStyle != null ? this.itemStyle.Clone() : null;
        s.label = this.label != null ? this.label.Clone() : null;
        s.gauge = this.gauge != null ? this.gauge.Clone() : null;
        s.data = new List<ChartData>();
        if (this.data != null) {
            for (int i = 0; i < this.data.Count; i = i + 1) {
                ChartData cd = this.data[i];
                s.data.Add(cd != null ? cd.Clone() : null);
            }
        }
        s.candles = new List<Candle>();
        if (this.candles != null) {
            for (int i = 0; i < this.candles.Count; i = i + 1) {
                Candle c = this.candles[i];
                s.candles.Add(c != null ? c.Clone() : null);
            }
        }
        s.bubbles = new List<Bubble>();
        if (this.bubbles != null) {
            for (int i = 0; i < this.bubbles.Count; i = i + 1) {
                Bubble b = this.bubbles[i];
                s.bubbles.Add(b != null ? b.Clone() : null);
            }
        }
        s.boxes = new List<BoxItem>();
        if (this.boxes != null) {
            for (int i = 0; i < this.boxes.Count; i = i + 1) {
                BoxItem bi = this.boxes[i];
                s.boxes.Add(bi != null ? bi.Clone() : null);
            }
        }
        s.errors = new List<ErrorItem>();
        if (this.errors != null) {
            for (int i = 0; i < this.errors.Count; i = i + 1) {
                ErrorItem ei = this.errors[i];
                s.errors.Add(ei != null ? ei.Clone() : null);
            }
        }
        s.points = new List<ChartPoint>();
        if (this.points != null) {
            for (int i = 0; i < this.points.Count; i = i + 1) {
                ChartPoint pt = this.points[i];
                s.points.Add(pt != null ? pt.Clone() : null);
            }
        }
        s.tree = new List<ChartNode>();
        if (this.tree != null) {
            for (int i = 0; i < this.tree.Count; i = i + 1) {
                ChartNode node = this.tree[i];
                s.tree.Add(node != null ? node.Clone() : null);
            }
        }
        s.levels = new List<ChartLevel>();
        if (this.levels != null) {
            for (int i = 0; i < this.levels.Count; i = i + 1) {
                ChartLevel lvl = this.levels[i];
                s.levels.Add(lvl != null ? lvl.Clone() : null);
            }
        }
        s.visibleMin = this.visibleMin;
        s.leafDepth = this.leafDepth;
        s.tmBorderWidth = this.tmBorderWidth;
        s.tmBorderColor = this.tmBorderColor;
        s.tmGapWidth = this.tmGapWidth;
        s.tmBorderColorSat = this.tmBorderColorSat;
        s.tmHasColorSat = this.tmHasColorSat;
        s.tmSatLo = this.tmSatLo;
        s.tmSatHi = this.tmSatHi;
        s.tmUpperShow = this.tmUpperShow;
        s.tmUpperHeight = this.tmUpperHeight;
        s.sunLabelMode = this.sunLabelMode;
        s.sunLabelRotate = this.sunLabelRotate;
        s.sunLabelColor = this.sunLabelColor;
        s.sunItemColor = this.sunItemColor;
        s.visualDimension = this.visualDimension;
        s.visualMin = this.visualMin;
        s.visualMax = this.visualMax;
        s.links = new List<ChartLink>();
        if (this.links != null) {
            for (int i = 0; i < this.links.Count; i = i + 1) {
                ChartLink lk = this.links[i];
                s.links.Add(lk != null ? lk.Clone() : null);
            }
        }
        s.regions = new List<ChartMapRegion>();
        if (this.regions != null) {
            for (int i = 0; i < this.regions.Count; i = i + 1) {
                ChartMapRegion mr = this.regions[i];
                s.regions.Add(mr != null ? mr.Clone() : null);
            }
        }
        s.events = new List<ChartEvent>();
        if (this.events != null) {
            for (int i = 0; i < this.events.Count; i = i + 1) {
                ChartEvent ev = this.events[i];
                s.events.Add(ev != null ? ev.Clone() : null);
            }
        }
        s.marks = new List<ChartMarkPoint>();
        if (this.marks != null) {
            for (int i = 0; i < this.marks.Count; i = i + 1) {
                ChartMarkPoint mp = this.marks[i];
                s.marks.Add(mp != null ? mp.Clone() : null);
            }
        }
        s.markLines = new List<ChartMarkLine>();
        if (this.markLines != null) {
            for (int i = 0; i < this.markLines.Count; i = i + 1) {
                ChartMarkLine ml = this.markLines[i];
                s.markLines.Add(ml != null ? ml.Clone() : null);
            }
        }
        s.markLabelFmt = this.markLabelFmt;
        s.markLabelSt = this.markLabelSt != null ? this.markLabelSt.Clone() : null;
        s.markLabelPos = this.markLabelPos;
        s.markLabelDist = this.markLabelDist;
        s.markSymbolSize = this.markSymbolSize;
        s.llDeclared = this.llDeclared;
        s.llDx = this.llDx;
        s.llDy = this.llDy;
        s.llX = this.llX;
        s.llY = this.llY;
        s.llAlign = this.llAlign;
        s.llHideOverlap = this.llHideOverlap;
        s.llMove = this.llMove;
        s.nodeCoords = new List<ChartNodeCoord>();
        if (this.nodeCoords != null) {
            for (int i = 0; i < this.nodeCoords.Count; i = i + 1) {
                s.nodeCoords.Add(new ChartNodeCoord(this.nodeCoords[i].x, this.nodeCoords[i].y));
            }
        }
        s.graphCats = new List<string>();
        if (this.graphCats != null) {
            for (int i = 0; i < this.graphCats.Count; i = i + 1) { s.graphCats.Add(this.graphCats[i]); }
        }
        s.geoLines = new List<List<ChartPoint>>();
        if (this.geoLines != null) {
            for (int i = 0; i < this.geoLines.Count; i = i + 1) {
                List<ChartPoint> line = new List<ChartPoint>();
                for (int k = 0; k < this.geoLines[i].Count; k = k + 1) {
                    ChartPoint p = this.geoLines[i][k];
                    line.Add(p != null ? p.Clone() : null);
                }
                s.geoLines.Add(line);
            }
        }
        return s;
    }

    public static ChartSeries Clone(ChartSeries src) {
        if (src == null) { return null; }
        return src.Clone(false);
    }

    public static ChartSeries Clone(ChartSeries src, bool shareData) {
        if (src == null) { return null; }
        return src.Clone(shareData);
    }
}
