using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartGridSpec {
    public int lPct; public int lPx;
    public int tPct; public int tPx;
    public int rPct; public int rPx;
    public int bPct; public int bPx;
    public int wPct; public int wPx;
    public int hPct; public int hPx;
    public bool containLabel;
    // A16：原始声明（parsePercent 语义的 px / "N%" / 关键字）。
    // 多宫格与 DrawFrame 家族走 GridRawRect 精确解算；lPct/lPx 等
    // 旧字段保留给 scatter-matrix 快路径与缓存指纹。
    public ChartBoxParam lRaw;
    public ChartBoxParam tRaw;
    public ChartBoxParam rRaw;
    public ChartBoxParam bRaw;
    public ChartBoxParam wRaw;
    public ChartBoxParam hRaw;
    // matrix 锚定（coordinateSystem:"matrix"）：coord 归一成叶子域
    // [mx0..mx1] × [my0..my1]，格矩形即 grid 矩形（再按自身六参内缩）。
    public string id;  // grid.id：轴/系列的 gridId 串接引用
    public bool matAnchor;
    public int mx0; public int mx1;
    public int my0; public int my1;

    public static ChartGridSpec Of() {
        ChartGridSpec gs = new ChartGridSpec();
        gs.lPct = 0 - 1; gs.lPx = 0 - 1;
        gs.tPct = 0 - 1; gs.tPx = 0 - 1;
        gs.rPct = 0 - 1; gs.rPx = 0 - 1;
        gs.bPct = 0 - 1; gs.bPx = 0 - 1;
        gs.wPct = 0 - 1; gs.wPx = 0 - 1;
        gs.hPct = 0 - 1; gs.hPx = 0 - 1;
        gs.containLabel = false;
        gs.id = "";
        gs.matAnchor = false;
        gs.mx0 = 0; gs.mx1 = 0;
        gs.my0 = 0; gs.my1 = 0;
        return gs;
    }
}

// visualMap.piecewise 的一段：[lo,hi]（含端与否）或等值 eq，
// 命中数据项（dimension 0 = 类目序号 / 1 = 数据值）映射 color。
