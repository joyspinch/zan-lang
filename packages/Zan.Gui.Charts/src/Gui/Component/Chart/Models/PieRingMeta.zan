using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// 饼图单环几何与度量配置实体（消除 6 组 ring* 平行列表反模式）。
public class PieRingMeta {
    public int total;
    public long totalWide;
    public int innerPct;
    public ChartPosition center;
    public ChartScalar radius;
    public ChartScalar radiusInner;

    public PieRingMeta() {
        this.total = 0;
        this.totalWide = 0;
        this.innerPct = 0;
        this.center = null;
        this.radius = null;
        this.radiusInner = null;
    }
}
