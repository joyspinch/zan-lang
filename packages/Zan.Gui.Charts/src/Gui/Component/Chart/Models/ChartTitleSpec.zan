using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartTitleSpec {
    public string text;
    public string sub;
    public string link;
    public int topPct; public int topPx;
    public int leftPct; public int leftPx;
    public string align;  // "center"/"left"/"right"（left 值为关键词时）
    public string id;  // title.id（media 缺省项按 id 覆盖 coord）
    public int itemGap;  // 主副标题间距（官方缺省 10）
    public bool matAnchor;  // coordinateSystem:"matrix"：锚定到格矩形
    public int mx0; public int mx1;
    public int my0; public int my1;

    public static ChartTitleSpec Of() {
        ChartTitleSpec t = new ChartTitleSpec();
        t.text = ""; t.sub = "";
        t.link = "";
        t.topPct = 0 - 1; t.topPx = 0 - 1;
        t.leftPct = 0 - 1; t.leftPx = 0 - 1;
        t.align = "";
        t.id = "";
        t.itemGap = 10;
        t.matAnchor = false;
        t.mx0 = 0; t.mx1 = 0;
        t.my0 = 0; t.my1 = 0;
        return t;
    }
}
