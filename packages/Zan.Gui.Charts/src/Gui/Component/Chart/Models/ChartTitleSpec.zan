using System;
using System.Json;
using System.Text;
using Gui;
namespace Gui.Component.Chart;

public class ChartTitleSpec {
    public string text;
    public string sub;
    public int topPct; public int topPx;
    public int leftPct; public int leftPx;
    public string align;  // "center"/"left"/"right"（left 值为关键词时）
    public string id;  // title.id（media 缺省项按 id 覆盖 coord）
    public bool matAnchor;  // coordinateSystem:"matrix"：锚定到格矩形
    public int mx0; public int mx1;
    public int my0; public int my1;

    public static ChartTitleSpec Of() {
        ChartTitleSpec t = new ChartTitleSpec();
        t.text = ""; t.sub = "";
        t.topPct = 0 - 1; t.topPx = 0 - 1;
        t.leftPct = 0 - 1; t.leftPx = 0 - 1;
        t.align = "";
        t.id = "";
        t.matAnchor = false;
        t.mx0 = 0; t.mx1 = 0;
        t.my0 = 0; t.my1 = 0;
        return t;
    }
}

// ECharts calendar 坐标系的一项（calendar 可为对象或数组）。
// 语义（官方 CalendarModel.defaultOption + Calendar.ts + CalendarView.ts）：
// range    : "2017"（整年）| "2017-02"（整月）| "2017-02-01"（单日）
// | ["起点","终点"]
// orient   : "horizontal"（默认，周为行、横向排月）|
// "vertical"（周为列、纵向排月）
// cellSize : 20（两维同）| [w,h]，任一维可为 "auto"（按容器等分）；
// 显式声明 width/height 或 left+right 时该维强制 auto
// left/top : 官方默认 80 / 60（不是 0）
// dayLabel/monthLabel/yearLabel : 刻度文字
// 日期一律存成 1970-01-01 起的天序（负值 = 之前），与时间轴同基准。
