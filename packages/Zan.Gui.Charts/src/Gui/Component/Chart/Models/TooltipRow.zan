using System;
using System.Json;
using Gui;
using Gui.Backend;

namespace Gui.Component.Chart;

// 提示框内容的一行：可选色块 + 文本（color=0 不画色块，
// 用于标题行/合计行）。
public class TooltipRow {
    public int color;
    public string text;

    // 构造一行提示：color 为色块颜色（0 = 不画色块，用于
    // 标题行/合计行），text 为该行文本。
    public static TooltipRow Of(int color, string text) {
        TooltipRow row = new TooltipRow();
        row.color = color;
        row.text = text;
        return row;
    }
}
