using System;
using System.Json;
using System.Text;
using Gui;

namespace Gui.Component.Chart;

public partial class ChartOption {
    // 解析 grid.left/right/top/bottom 绘图区边距覆盖。
    // grid.{left,top,right,bottom}：数字=像素；"N%"=面板尺寸百分
    // 比；center/middle/left/top/right/bottom 关键字（A16 原样保留，
    // parsePercent 有专名映射）。containLabel=true 时矩形再被轴
    // 标签的外溢量收缩（Grid.ts legacyContainLabel）。
    public static void ParseGrid(JsonValue v, ChartOption o) {
        if (v != null && v.IsArray()) {
            // grid 数组（多 grid 布局）：单格 legacy 字段取第一项，
            // 其余进 grids 供渲染器分组重入。
            for (int gvi = 0; gvi < v.Count(); gvi = gvi + 1) {
                if (v.At(gvi) != null && v.At(gvi).IsObject()) {
                    o.grids.Add(ChartOption.ParseGridOne(v.At(gvi), o));
                }
            }
        }
        ChartOption.ParseGridBody(v, o);
    }

    public static void ParseGridBody(JsonValue v, ChartOption o) {
        if (v == null || !v.IsObject()) { return; }
        ChartOption.ParseGridEdge(v.Get("left"), true, false, o);
        ChartOption.ParseGridEdge(v.Get("right"), false, false, o);
        ChartOption.ParseGridEdge(v.Get("top"), true, true, o);
        ChartOption.ParseGridEdge(v.Get("bottom"), false, true, o);
        o.containLabel = v.Bool("containLabel", o.containLabel);
        // A16：原始声明 + width/height + outerBounds。
        if (v.Has("left")) { o.gridLeftRaw = ChartOption.ParseBoxParam(v.Get("left")); }
        if (v.Has("right")) { o.gridRightRaw = ChartOption.ParseBoxParam(v.Get("right")); }
        if (v.Has("top")) { o.gridTopRaw = ChartOption.ParseBoxParam(v.Get("top")); }
        if (v.Has("bottom")) { o.gridBottomRaw = ChartOption.ParseBoxParam(v.Get("bottom")); }
        if (v.Has("width")) { o.gridWidthRaw = ChartOption.ParseBoxParam(v.Get("width")); }
        if (v.Has("height")) { o.gridHeightRaw = ChartOption.ParseBoxParam(v.Get("height")); }
        JsonValue obv = v.Get("outerBounds");
        if (obv != null && obv.IsObject()) {
            o.obDeclared = true;
            if (obv.Has("left")) { o.obLeftRaw = ChartOption.ParseBoxParam(obv.Get("left")); }
            if (obv.Has("right")) { o.obRightRaw = ChartOption.ParseBoxParam(obv.Get("right")); }
            if (obv.Has("top")) { o.obTopRaw = ChartOption.ParseBoxParam(obv.Get("top")); }
            if (obv.Has("bottom")) { o.obBottomRaw = ChartOption.ParseBoxParam(obv.Get("bottom")); }
        } else if (v.Has("outerBounds")) {
            // 显式 null/"auto" 占位：mergeDefaultAndTheme 的
            // getLayoutParams 只在真值时并参——这里等同未声明。
            o.obDeclared = false;
        }
    }

    // 一个布局标量的原始值：数字（像素）、"N%"（百分比，
    // 保小数）、center/middle/left/top/right/bottom 关键字、
    // null/"auto"（Void——hasValue 视为无值）。不可识别的串按
    // parsePositionSizeOption 的 parseFloat 处理（NaN 归 Void）。
    public static ChartBoxParam ParseBoxParam(JsonValue e) {
        if (e == null || e.IsNull()) { return ChartBoxParam.Void(); }
        if (e.IsNumber()) { return ChartBoxParam.Px(e.AsDouble(0.0)); }
        if (e.IsString()) {
            string s = e.AsString("");
            if (s == "auto") { return ChartBoxParam.Void(); }
            int at = s.IndexOf("%");
            if (at > 0) {
                return ChartBoxParam.Pct(JsonValue.DoubleOf(s.Substring(0, at)));
            }
            if (s == "center" || s == "middle" || s == "left" || s == "top"
                || s == "right" || s == "bottom") {
                return ChartBoxParam.Key(s);
            }
            double d = JsonValue.DoubleOf(s);
            if (d == 0.0 && !ChartOption.StrLooksNumeric(s)) { return ChartBoxParam.Void(); }
            return ChartBoxParam.Px(d);
        }
        return ChartBoxParam.Void();
    }

    // 数字串（可带小数/正负号）。"12.5"、"-3" 真；"12%"、"" 假。
    public static bool StrLooksNumeric(string s) {
        if (s == null || s.Length == 0) { return false; }
        int i = 0;
        if (s[0] == '-') { i = 1; }
        bool digit = false;
        bool dot = false;
        for (; i < s.Length; i = i + 1) {
            char ch = s[i];
            if (ch >= '0' && ch <= '9') { digit = true; }
            else if (ch == '.' && !dot) { dot = true; }
            else { return false; }
        }
        return digit;
    }

    // 解析 grid 单边：isLeft 选 gridLeft/gridRight，isVert 选水
    // 平/垂直字段对（px 与 pct 互斥，后写覆盖）。字符串形态只认
    // "N%"（关键字/数值串进 raw，不落旧字段——A16 前关键字在这里
    // 被静默丢成 px=-1）。
    public static void ParseGridEdge(JsonValue e, bool isLeft, bool isVert, ChartOption o) {
        if (e == null) { return; }
        if (e.IsNumber()) {
            if (isVert) {
                if (isLeft) { o.gridTop = e.AsInt(0 - 1); o.gridTopPct = 0 - 1; }
                else { o.gridBottom = e.AsInt(0 - 1); o.gridBottomPct = 0 - 1; }
            } else {
                if (isLeft) { o.gridLeft = e.AsInt(0 - 1); o.gridLeftPct = 0 - 1; }
                else { o.gridRight = e.AsInt(0 - 1); o.gridRightPct = 0 - 1; }
            }
            return;
        }
        int pct = ChartOption.PercentOf(e.AsString(""), 0 - 1);
        if (pct < 0) { return; }
        if (isVert) {
            if (isLeft) { o.gridTopPct = pct; o.gridTop = 0 - 1; }
            else { o.gridBottomPct = pct; o.gridBottom = 0 - 1; }
        } else {
            if (isLeft) { o.gridLeftPct = pct; o.gridLeft = 0 - 1; }
            else { o.gridRightPct = pct; o.gridRight = 0 - 1; }
        }
    }

    // "3%" -> 3；无 % 或空串返回 dflt。
    public static int PercentOf(string s, int dflt) {
        if (s == null) { return dflt; }
        int at = s.IndexOf("%");
        if (at <= 0) { return dflt; }
        return (int)JsonValue.DoubleOf(s.Substring(0, at));
    }

    // 解析 dataZoom（对象或数组取首项）：show/start/end 百分比，
    // startValue/endValue 按类目名定位窗口（line-aqi），钳制到
    // 0..100 且 end < start 时交换。
    public static void ParseDataZoom(JsonValue v, ChartOption o) {
        if (v == null) { return; }
        // N2：逐组件解析（数组全部元素；对象 = 单组件）。缺省型
        // slider（DataZoomModel 缺省），inside = 纯交互无条。o.zoom
        // 从「首项 show」改「组件存在」：show:false 只藏条不关窗
        o.zoom = true;
        int count = v.IsArray() ? v.Count() : 1;
        for (int i = 0; i < count; i = i + 1) {
            JsonValue z = v.IsArray() ? v.At(i) : v;
            if (z == null || !z.IsObject()) { continue; }
            ChartZoom c = ChartOption.ParseZoomComp(z);
            o.zooms.Add(c);
            // 窗口投影：x 窗口取首个 x 靶向（含未声明轴）组件，
            // y 窗口取首个 y 靶向组件（纵向条自己的窗口）。
            if (!c.isY && o.zoomX == null) { o.zoomX = c; }
            if (c.isY && o.zoomY == null) { o.zoomY = c; }
        }
        if (o.zoomX != null) {
            o.zoomStart = o.zoomX.start;
            o.zoomEnd = o.zoomX.end;
            o.zoomStartValue = o.zoomX.startValue;
            o.zoomEndValue = o.zoomX.endValue;
        }
        if (o.zoomY != null) {
            if (o.zoomY.start < 0) { o.zoomY.start = 0; }
            if (o.zoomY.start > 100) { o.zoomY.start = 100; }
            if (o.zoomY.end < 0) { o.zoomY.end = 0; }
            if (o.zoomY.end > 100) { o.zoomY.end = 100; }
            if (o.zoomY.end < o.zoomY.start) {
                int t2 = o.zoomY.start; o.zoomY.start = o.zoomY.end; o.zoomY.end = t2;
            }
        }
    }

    // 单个 dataZoom 组件解析（键面 = 语料普查 35 demo / 66 组件
    // 用到的全部 + 官方外观缺省键；color 0 = 官方缺省 token）。
    public static ChartZoom ParseZoomComp(JsonValue z) {
        ChartZoom c = ChartZoom.Of();
        c.slider = z.Str("type", "slider") != "inside";
        c.show = z.Bool("show", true);
        c.realtime = z.Bool("realtime", c.realtime);
        c.showDetail = z.Bool("showDetail", true);
        c.zoomLock = z.Bool("zoomLock", false);
        c.brushSelect = z.Bool("brushSelect", true);
        c.filterMode = z.Str("filterMode", c.filterMode);
        c.zoomOnMouseWheel = z.Bool("zoomOnMouseWheel", c.zoomOnMouseWheel);
        c.moveOnMouseMove = z.Bool("moveOnMouseMove", c.moveOnMouseMove);
        c.moveOnMouseWheel = z.Bool("moveOnMouseWheel", c.moveOnMouseWheel);
        c.throttle = z.Int("throttle", c.throttle);
        c.start = z.Int("start", 0);
        c.end = z.Int("end", 100);
        c.startValue = z.Str("startValue", "");
        c.endValue = z.Str("endValue", "");
        JsonValue xi = z.Get("xAxisIndex");
        JsonValue yi = z.Get("yAxisIndex");
        if (xi != null) { c.isY = false; c.axisIndex = ChartOption.ZoomAxisIndex(xi); }
        else if (yi != null) { c.isY = true; c.axisIndex = ChartOption.ZoomAxisIndex(yi); }
        JsonValue sds = z.Get("showDataShadow");
        if (sds != null) {
            // 'auto'（字符串）与缺省都走 0；裸布尔走 1/2。
            c.shadowMode = sds.IsString() ? 0 : (sds.AsBool(true) ? 1 : 2);
        }
        JsonValue hs = z.Get("handleSize");
        if (hs != null && hs.IsNumber()) { c.handleSizePx = hs.AsInt(0 - 1); }
        else if (hs != null) {
            string hss = hs.AsString("");
            if (hss.EndsWith("%")) {
                c.handleSize = (int)JsonValue.DoubleOf(hss.Substring(0, hss.Length - 1));
            }
        }
        c.minValueSpan = z.Int("minValueSpan", 0);
        c.minSpan = z.Int("minSpan", 0);
        c.height = z.Int("height", 0 - 1);
        c.width = z.Int("width", 0 - 1);
        c.top = z.Int("top", 0 - 1);
        c.bottom = z.Int("bottom", 0 - 1);
        c.left = z.Int("left", 0 - 1);
        c.right = z.Int("right", 0 - 1);
        JsonValue lf = z.Get("labelFormatter");
        if (lf != null && lf.IsString()) { c.labelFormatter = lf.AsString(""); }
        JsonValue hi = z.Get("handleIcon");
        if (hi != null) { c.handleIcon = hi.AsString(null); }
        ChartOption.ParseZoomBoxPct(z.Get("height"), c, 1);
        ChartOption.ParseZoomBoxPct(z.Get("width"), c, 2);
        ChartOption.ParseZoomBoxPct(z.Get("top"), c, 3);
        ChartOption.ParseZoomBoxPct(z.Get("bottom"), c, 4);
        ChartOption.ParseZoomBoxPct(z.Get("left"), c, 5);
        ChartOption.ParseZoomBoxPct(z.Get("right"), c, 6);
        JsonValue ts = z.Get("textStyle");
        if (ts != null && ts.IsObject() && ts.Has("color")) {
            c.textStyleColor = ChartOption.ParseColor(ts.Get("color"), 0);
        }
        JsonValue dbg = z.Get("dataBackground");
        if (dbg != null && dbg.IsObject()) {
            JsonValue ar = dbg.Get("areaStyle");
            JsonValue li = dbg.Get("lineStyle");
            if (ar != null && ar.Has("color")) {
                c.dbAreaColor = ChartOption.ParseColor(ar.Get("color"), 0);
            }
            if (li != null && li.Has("color")) {
                c.dbLineColor = ChartOption.ParseColor(li.Get("color"), 0);
            }
        }
        JsonValue sdbg = z.Get("selectedDataBackground");
        if (sdbg != null && sdbg.IsObject()) {
            JsonValue sar = sdbg.Get("areaStyle");
            JsonValue sli = sdbg.Get("lineStyle");
            if (sar != null && sar.Has("color")) {
                c.selDbAreaColor = ChartOption.ParseColor(sar.Get("color"), 0);
            }
            if (sli != null && sli.Has("color")) {
                c.selDbLineColor = ChartOption.ParseColor(sli.Get("color"), 0);
            }
        }
        if (z.Has("fillerColor")) {
            c.fillerColor = ChartOption.ParseColor(z.Get("fillerColor"), 0);
        }
        if (z.Has("borderColor")) {
            c.borderColor = ChartOption.ParseColor(z.Get("borderColor"), 0);
        }
        if (c.start < 0) { c.start = 0; }
        if (c.start > 100) { c.start = 100; }
        if (c.end < 0) { c.end = 0; }
        if (c.end > 100) { c.end = 100; }
        if (c.end < c.start) {
            int t = c.start; c.start = c.end; c.end = t;
        }
        return c;
    }

    // xAxisIndex/yAxisIndex 首项下标：数值直接取；数组取首项
    // （数值或 "all" → 0）；字符串 "all" → 0。引擎靶向记录到组件
    // 上，窗口仍走全局单窗（多 grid 分窗记台账）。
    public static int ZoomAxisIndex(JsonValue v) {
        if (v == null) { return 0; }
        if (v.IsNumber()) { return v.AsInt(0); }
        if (v.IsString()) {
            return v.AsString("") == "all" ? 0 : 0;
        }
        if (v.IsArray() && v.Count() > 0) {
            JsonValue f = v.At(0);
            if (f != null && f.IsNumber()) { return f.AsInt(0); }
            return 0;
        }
        return 0;
    }

    // 盒模型键的 'N%' 形态（px 已在上面 Int 直读）：kind
    // 6=rightPct。数值形态上面已读，这里只补字符串百分比。
    public static void ParseZoomBoxPct(JsonValue v, ChartZoom c, int kind) {
        if (v == null || !v.IsString()) { return; }
        string s = v.AsString("");
        if (!s.EndsWith("%")) { return; }
        int pct = (int)JsonValue.DoubleOf(s.Substring(0, s.Length - 1));
        if (kind == 1) { c.heightPct = pct; }
        else if (kind == 2) { c.widthPct = pct; }
        else if (kind == 3) { c.topPct = pct; }
        else if (kind == 4) { c.bottomPct = pct; }
        else if (kind == 5) { c.leftPct = pct; }
        else { c.rightPct = pct; }
    }

    // 解析 legend 单边锚（官方盒模型 left/right/top/bottom）：数字与
    // "N%" 都换算成 px（百分比基数未知时退回 sidePx），关键字
    // （left/center/right、top/middle/bottom）原样记入 raw。isVert
    // 选水平/垂直锚位，isFar 选远端（right/bottom）。`legendHas*`
    // 区分"未声明"与"声明为 0"——官方 getLayoutRect 里 0 是合法锚。
    public static void ParseLegendAnchor(JsonValue v, string key, bool isVert,
                                  bool isFar, ChartOption o, int sidePx) {
        if (v == null || !v.Has(key)) { return; }
        JsonValue pv = v.Get(key);
        string raw = "";
        int px = 0 - 1;
        if (pv != null && pv.IsNumber()) {
            px = pv.AsInt(0 - 1);
            raw = Convert.ToString(px);
        } else {
            raw = pv == null ? "" : pv.AsString("");
            if (raw.EndsWith("%")) {
                int pct = Convert.ToInt(raw.Substring(0, raw.Length - 1));
                int boxLen = isVert ? o.legendBoxH : o.legendBoxW;
                if (boxLen < 1) { boxLen = sidePx; }
                px = boxLen * pct / 100;
            }
        }
        if (!isVert) {
            if (isFar) { o.legendRight = raw; o.legendHasRight = true; o.legendRightPx = px; }
            else { o.legendLeft = raw; o.legendHasLeft = true; o.legendLeftPx = px; }
        } else {
            if (isFar) { o.legendBottom = raw; o.legendHasBottom = true; o.legendBottomPx = px; }
            else { o.legendTop = raw; o.legendHasTop = true; o.legendTopPx = px; }
        }
    }

    // 解析 markArea（option 级与 series 级各挂一次）。data 的每对
    // [{xAxis|yAxis, name?}, {...}]：x 对按类目名/序号成竖带，
    // y 对成横带。首对"无名无色"的纯 y 影子带仍走旧
    // markLo/markHi 通道（等价绘制，避免与旧金样重复）。
    public static void ParseMarkArea(JsonValue v, ChartOption o) {
        if (v == null || !v.IsObject()) { return; }
        JsonValue data = v.Get("data");
        if (data == null || !data.IsArray() || data.Count() < 1) { return; }
        JsonValue st = v.Get("itemStyle");
        int pairColor = st != null && st.IsObject()
            ? ChartOption.ParseColor(st.Get("color"), 0) : 0;
        for (int pi = 0; pi < data.Count(); pi = pi + 1) {
            JsonValue pair = data.At(pi);
            if (pair == null || !pair.IsArray() || pair.Count() < 2) { continue; }
            JsonValue lo = pair.At(0);
            JsonValue hi = pair.At(1);
            bool loObj = lo != null && lo.IsObject();
            bool hiObj = hi != null && hi.IsObject();
            if (!(loObj && lo.Has("xAxis")) && !(hiObj && hi.Has("xAxis"))) {
                if (!loObj || !lo.Has("yAxis") || !hiObj || !hi.Has("yAxis")) {
                    continue;
                }
                int c0 = pairColor;
                JsonValue lis = lo.Has("itemStyle") ? lo.Get("itemStyle") : null;
                if (c0 == 0 && lis != null) {
                    c0 = ChartOption.ParseColor(lis.Get("color"), 0);
                }
                if (pi == 0 && lo.Str("name", "").Length == 0 && c0 == 0) {
                    o.markLo = lo.Int("yAxis", o.markLo);
                    o.markHi = hi.Int("yAxis", o.markHi);
                    continue;
                }
                ChartMarkArea ya = ChartMarkArea.Of();
                ya.xMode = false;
                ya.v0 = lo.Int("yAxis", 0);
                ya.v1 = hi.Int("yAxis", 0);
                ya.name = lo.Str("name", "");
                ya.color = c0;
                o.markAreas.Add(ya);
                continue;
            }
            int c0x = ChartOption.MarkAreaCatIdx(o, loObj ? lo.Get("xAxis") : null);
            int c1x = ChartOption.MarkAreaCatIdx(o, hiObj ? hi.Get("xAxis") : null);
            if (c0x == ChartOption.MarkAreaNone() || c1x == ChartOption.MarkAreaNone()) {
                continue;
            }
            ChartMarkArea a = ChartMarkArea.Of();
            a.xMode = true;
            a.v0 = c0x;
            a.v1 = c1x;
            a.color = pairColor;
            if (loObj) {
                a.name = lo.Str("name", "");
                JsonValue xis = lo.Has("itemStyle") ? lo.Get("itemStyle") : null;
                if (xis != null) {
                    a.color = ChartOption.ParseColor(xis.Get("color"), a.color);
                }
            }
            o.markAreas.Add(a);
        }
    }

    // markArea x 端点找不到时的哨兵。
    public static int MarkAreaNone() { return 0 - 2147483648; }

    // markArea 的 x 端解析：字符串在 x 类目表里查序号，数字直接
    // 取；"min"/"max"（scatter-weight 的数据范围矩形）暂不展开，
    // 返回哨兵跳过。
    public static int MarkAreaCatIdx(ChartOption o, JsonValue xv) {
        if (xv == null) { return ChartOption.MarkAreaNone(); }
        if (xv.IsNumber()) { return xv.AsInt(ChartOption.MarkAreaNone()); }
        string nm = xv.AsString("");
        if (nm == "min" || nm == "max") { return ChartOption.MarkAreaNone(); }
        if (o.xAxes.Count < 1) { return ChartOption.MarkAreaNone(); }
        List<string> cats = o.xAxes[0].categories;
        for (int i = 0; i < cats.Count; i = i + 1) {
            if (cats[i] == nm) { return i; }
        }
        return ChartOption.MarkAreaNone();
    }


}
