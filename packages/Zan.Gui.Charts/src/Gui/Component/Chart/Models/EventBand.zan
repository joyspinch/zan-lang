using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// Event River 的一条带（布局输出；绝对像素矩形）。
class EventBand {
    string name;
    int start;
    int end;
    int value;
    int x0;
    int x1;
    int y;
    int h;
    int row;
    int src;  // 源 events 下标（稳定排序前的原序），typed hit 用

    // 构造一条事件带（[x0,x1) × [y, y+h) 绝对像素矩形）。
    static EventBand Of(string name, int start, int end, int value,
                        int x0, int x1, int y, int h, int row, int src) {
        EventBand b = new EventBand();
        b.name = name;
        b.start = start;
        b.end = end;
        b.value = value;
        b.x0 = x0;
        b.x1 = x1;
        b.y = y;
        b.h = h;
        b.row = row;
        b.src = src;
        return b;
    }
}
