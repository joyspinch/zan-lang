using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// 大数据量图表抽取列的 [min, max] 范围实体（消除 colMin 与 colMax 平行列表反模式）。
public class ChartBigColExtents {
    public int min;
    public int max;

    public ChartBigColExtents(int min, int max) {
        this.min = min;
        this.max = max;
    }

    public static ChartBigColExtents Of(int min, int max) {
        return new ChartBigColExtents(min, max);
    }
}

// 图表的虚拟、拉取式数据源——图表无需持有
// 原始点数组，数百万点的系列也不产生逐单元对象
// 分配（对应 DataTable 的 DataSource）。子类化它，
// 按需从自己的列式/类型化存储读取点，或用 SeriesListSource 包装
// 内存中的 List<ChartSeries>。
public class ChartSource {
    // 系列数。
    public virtual int SeriesCount() { return 0; }
    // 系列 s 的名称。
    public virtual string SeriesName(int s) { return ""; }
    // 系列 s 的颜色；0 = 自动（调色板）。
    public virtual int SeriesColor(int s) { return 0; }  // 0 = 自动（调色板）
    // 系列 s 的数据点数。
    public virtual int PointCount(int s) { return 0; }
    // 系列 s 第 i 点的数值。
    public virtual int ValueAt(int s, int i) { return 0; }
}

// 适配器：把已有的 List<ChartSeries> 暴露为 ChartSource，
// 高性能路径直接接受内存数据，无需重构。
public class SeriesListSource : ChartSource {
    public List<ChartSeries> series;

    // 包装内存系列列表（直接持有引用，不复制）。
    public static SeriesListSource Of(List<ChartSeries> series) {
        SeriesListSource s = new SeriesListSource();
        s.series = series;
        return s;
    }

    // 系列数 = 内存列表长度。
    public override int SeriesCount() { return this.series.Count; }
    // 系列 s 的名称。
    public override string SeriesName(int s) { return this.series[s].name; }
    // 系列显式色，其次 itemStyle.normal.color，否则 0（调色板）。
    public override int SeriesColor(int s) {
        ChartSeries item = this.series[s];
        if (item.color != 0) { return item.color; }
        if (item.itemStyle != null && item.itemStyle.normal != null
            && item.itemStyle.normal.color != 0) {
            return item.itemStyle.normal.color;
        }
        return 0;
    }
    // 系列 s 的数据点数。
    public override int PointCount(int s) { return this.series[s].Count(); }
    // 系列 s 第 i 点的数值。
    public override int ValueAt(int s, int i) { return this.series[s].Value(i); }
}


// 虚拟 ChartSource 的高性能渲染器。每个系列被缩减为
// 最多约绘图区宽度列的 min/max 包络，缓存在 ChartState 中，
// 仅在数据版本或宽度变化时重建——
// 数百万点的折线/面积图每帧只需 O(width) 而非 O(points)，
// 图表从不持有每点一个对象的数组。用法：
// ChartState st = new ChartState();          // 创建一次，由调用方保存
public class ChartBig {

    // 显式动画键（基于作用域 Hash 派生；key < 1 返回 0 无动画键）。
    public static int AnimationKey(int key) {
        if (key < 1) { return 0; }
        return IdHash.HashInt(key, 530);
    }

    // 缓存过期判定：数据版本、控件宽度或系列数任一变化即需重建。
    public static bool NeedsRebuild(ChartState st, ChartSource src, int w) {
        if (st.builtVersion != st.version) { return true; }
        if (st.builtW != w) { return true; }
        if (st.builtSeries != src.SeriesCount()) { return true; }
        return false;
    }

    // 将每个系列抽取为约 `target` 个 min/max 列。只追加的构建
    // （不做索引写入）——任何优化级别下都安全快速；
    // 每次数据/尺寸变化运行一次，复杂度 O(总点数)。
    public static void Build(ChartState st, ChartSource src, int target) {
        if (target < 2) { target = 2; }
        st.seriesCols = new List<List<ChartBigColExtents>>();
        st.colMin = new List<List<int>>();
        st.colMax = new List<List<int>>();
        int ns = src.SeriesCount();
        int lo = 0;
        int hi = 0;
        bool seen = false;
        int cols = 0;

        for (int s = 0; s < ns; s = s + 1) {
            int n = src.PointCount(s);
            List<ChartBigColExtents> sExt = new List<ChartBigColExtents>();
            List<int> mn = new List<int>();
            List<int> mx = new List<int>();
            if (n > 0) {
                int C = target;
                if (C > n) { C = n; }
                int curCol = 0;
                int cMin = src.ValueAt(s, 0);
                int cMax = cMin;
                int i = 1;
                while (i < n) {
                    int col = i * C / n;
                    int v = src.ValueAt(s, i);
                    if (col != curCol) {
                        sExt.Add(new ChartBigColExtents(cMin, cMax));
                        mn.Add(cMin);
                        mx.Add(cMax);
                        curCol = col;
                        cMin = v;
                        cMax = v;
                    } else {
                        if (v < cMin) { cMin = v; }
                        if (v > cMax) { cMax = v; }
                    }
                    i = i + 1;
                }
                sExt.Add(new ChartBigColExtents(cMin, cMax));
                mn.Add(cMin);
                mx.Add(cMax);
            }

            for (int j = 0; j < sExt.Count; j = j + 1) {
                int a = sExt[j].min;
                int b = sExt[j].max;
                if (!seen) { lo = a; hi = b; seen = true; }
                if (a < lo) { lo = a; }
                if (b > hi) { hi = b; }
            }
            if (sExt.Count > cols) { cols = sExt.Count; }
            st.seriesCols.Add(sExt);
            st.colMin.Add(mn);
            st.colMax.Add(mx);
        }

        st.cols = cols;
        int axisLo = lo;
        if (axisLo > 0) { axisLo = 0; }  // 全非负时以零为锚点
        int axisHi = Chart.NiceMax(hi);
        if (axisHi <= axisLo) { axisHi = axisLo + 1; }
        st.axisLo = axisLo;
        st.axisHi = axisHi;
    }

    // 画面板底、标题与右上角逐系列图例（名称 + 色块，自右向左
    // 排列；系列色缺省取调色板），返回内容区顶部 y。
    public static int DrawHead(App app, int x, int y, int w, int h, string title, ChartSource src) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        StyleBox sPanel = Style.Full(app, "chart", "", "", Style.SNormal());
        c.SurfaceRoundRect(x, y, w, h, t.borderRadiusMedium, sPanel.BgOr(0), sPanel.BorderOr(0), 1);
        int top = y + pad;
        if (title.Length > 0) {
            c.DrawText(x + pad, top, title, sPanel.FgOr(0), Style.FontFallback(app, "large"));
        }
        int lx = x + w - pad;
        int sw = app.Scale(12);
        int si = src.SeriesCount() - 1;
        while (si >= 0) {
            string nm = src.SeriesName(si);
            int tw = Canvas.MeasureText(nm, ChartFonts.Legend(app));
            lx = lx - tw;
            c.DrawText(lx, top + app.Scale(2), nm,
                Style.Part(app, "chart", "legend", "", "", "", Style.SNormal()).FgOr(0),
                ChartFonts.Legend(app));
            int col = src.SeriesColor(si);
            if (col == 0) { col = ChartColor.Palette(t, si); }
            lx = lx - app.Scale(6) - sw;
            c.FillRoundRect(lx, top + app.Scale(3), sw, sw, t.borderRadiusSmall, col);
            lx = lx - app.Scale(14);
            si = si - 1;
        }
        return top + Canvas.FontHeight(Style.FontFallback(app, "large")) + app.Scale(6);
    }

    // 将源数据作为抽取后的折线/面积图绘制到给定矩形中。
    public static void Render(App app, ChartState st, ChartSource src, ChartOption o,
                       int x, int y, int w, int h, string title) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int axisFs = ChartFonts.AxisLabel(app);

        // 控件每水平像素一个抽取列是绘图区宽度的
        // 上界，因此缓存与边距无关。
        if (ChartBig.NeedsRebuild(st, src, w)) {
            ChartBig.Build(st, src, w);
            st.builtVersion = st.version;
            st.builtW = w;
            st.builtSeries = src.SeriesCount();
        }

        int plotTop = ChartBig.DrawHead(app, x, y, w, h, title, src);

        // 将绘图区/轴裁剪到图表盒内，
        // 即使数百万点，抽取列和轴标签也保持在控件内。
        c.PushClip(x, y, w, h);

        int leftGut = Canvas.MeasureText(Convert.ToString(st.axisHi), axisFs) + app.Scale(12);
        int botGut = Canvas.FontHeight(axisFs) + app.Scale(8);
        int plotX = x + pad + leftGut;
        int plotY = plotTop;
        int plotW = (x + w - pad) - plotX;
        int plotH = (y + h - pad - botGut) - plotY;
        if (plotW < app.Scale(20)) { plotW = app.Scale(20); }
        if (plotH < app.Scale(20)) { plotH = app.Scale(20); }

        int span = st.axisHi - st.axisLo;
        if (span < 1) { span = 1; }

        StyleBox sGrid = Style.Part(app, "chart", "grid", "", "", "",
                                    Style.SNormal());
        StyleBox sAxis = Style.Part(app, "chart", "axis", "", "", "",
                                    Style.SNormal());
        int ticks = 5;
        for (int k = 0; k <= ticks; k = k + 1) {
            int gy = plotY + plotH - (k * plotH / ticks);
            c.FillRect(plotX, gy, plotW, 1, sGrid.BgOr(0));
            int val = st.axisLo + span * k / ticks;
            string vs = Convert.ToString(val);
            int vw = Canvas.MeasureText(vs, axisFs);
            c.DrawText(plotX - app.Scale(6) - vw, Canvas.CenterTextYAt(gy, axisFs), vs, sAxis.FgOr(0), axisFs);
        }
        c.FillRect(plotX, plotY, app.Scale(2), plotH, sAxis.BgOr(0));
        c.FillRect(plotX, plotY + plotH, plotW, app.Scale(2), sAxis.BgOr(0));

        int ns = src.SeriesCount();
        if (st.cols < 1) { c.PopClip(); return; }
        int baseY = plotY + plotH;
        int g = 1000;
        if (o.animate) {
            g = app.AnimIntroIn(st.IntroKey(w), o.animMs,
                                 plotX, plotY, plotW, plotH);
        }

        List<int> lx = new List<int>();
        List<int> ly = new List<int>();
        for (int s = 0; s < ns; s = s + 1) {
            int color = src.SeriesColor(s);
            if (color == 0) { color = ChartColor.Palette(t, s); }
            List<ChartBigColExtents> sExt = (st.seriesCols != null && s < st.seriesCols.Count)
                ? st.seriesCols[s] : null;
            int cn = sExt != null ? sExt.Count
                : (st.colMin != null && s < st.colMin.Count ? st.colMin[s].Count : 0);

            lx.Clear();
            ly.Clear();
            for (int cc = 0; cc < cn; cc = cc + 1) {
                int px = plotX + cc * plotW / cn;
                int mnVal = sExt != null ? sExt[cc].min : st.colMin[s][cc];
                int mxVal = sExt != null ? sExt[cc].max : st.colMax[s][cc];
                int vTop = (int)((long)mxVal * g / 1000L);
                int vBot = (int)((long)mnVal * g / 1000L);
                // 大数据量程大，(v - lo) × plotH 会超 int32，乘法走 long。
                int yTop = plotY + plotH - (int)(((long)vTop - (long)st.axisLo) * (long)plotH / (long)span);
                int yBot = plotY + plotH - (int)(((long)vBot - (long)st.axisLo) * (long)plotH / (long)span);
                if (ChartView.HasArea(o)) {
                    // 面积列顶以 1/256 px 定点进 FillColumnAA，边界行
                    // 按小数覆盖率混合；整数 yTop 的 1px 竖条在缓坡上
                    // 是整行硬跳的阶梯。
                    long topNum = ((long)vTop - (long)st.axisLo) * (long)plotH;
                    int yTopF = (plotY + plotH) * 256
                        - (int)(topNum * 256 / (long)span);
                    ChartView.FillColumnAA(c, px, yTopF, baseY, color,
                        o.gradient, 120, 12, 128);
                }
                c.FillRect(px, yTop, 1, yBot - yTop + 1, color);
                lx.Add(px);
                ly.Add(yTop);
            }
            // 折线一笔连成：逐段 DrawLine 的端点各自实心落像素，
            // 拐角处双重混合会亮一像素。
            if (lx.Count > 1) { c.DrawPolyline(lx, ly, color, app.Scale(1)); }
        }

        int total = 0;
        for (int ci = 0; ci < ns; ci = ci + 1) { total = total + src.PointCount(ci); }
        string cap = Convert.ToString(total) + " pts";
        int cw = Canvas.MeasureText(cap, axisFs);
        c.DrawText(x + w - pad - cw, y + h - pad - Canvas.FontHeight(axisFs), cap,
            Style.Part(app, "chart", "hint", "", "", "", Style.SNormal()).FgOr(0), axisFs);
        c.PopClip();
    }
}
