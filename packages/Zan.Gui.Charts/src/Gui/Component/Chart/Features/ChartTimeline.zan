using System;
using System.Json;
using System.Numerics;
using Gui;

namespace Gui.Component.Chart;

// 布局准备播放器几何，路由输入与循环调度推进帧，绘制只读状态。
// Merge 实现 ECharts baseOption + options[] 的逐帧系列替换。
public partial class ChartTimeline : Control {
    public List<ChartOption> frames;
    public List<string> labels;
    public int intervalMs;

    public ChartTimeline() {
        this.InitControl("chartTimeline");
        this.InitTimelineInput();
        this.frames = new List<ChartOption>();
        this.labels = new List<string>();
        this.intervalMs = 0;
    }

    public static ChartTimeline Of() { return new ChartTimeline(); }

    public List<ChartOption> Frames {
        get { return this.frames; }
        set { this.frames = value != null ? value : new List<ChartOption>(); this.Invalidate(); }
    }

    public List<string> FrameLabels {
        get { return this.labels; }
        set { this.labels = value != null ? value : new List<string>(); this.Invalidate(); }
    }

    public int AutoPlayInterval {
        get { return this.intervalMs; }
        set { this.AutoPlay(value); }
    }

    public void Frame(ChartOption option) {
        if (option != null) { this.frames.Add(option); this.Invalidate(); }
    }

    public void Labels(List<string> values) {
        if (values != null) {
            for (int i = 0; i < values.Count; i = i + 1) { this.labels.Add(values[i]); }
            this.Invalidate();
        }
    }

    public void AutoPlay(int interval) {
        this.intervalMs = interval;
        App app = this.App;
        if (app != null) { this.PrepareTimeline(app); }
        this.Invalidate();
    }

    public int FrameCount() { return this.frames.Count; }

    public ChartOption FrameAt(int index) {
        if (index < 0 || index >= this.frames.Count) { return null; }
        return this.frames[index];
    }

    public ChartOption Current(int index) {
        return this.FrameAt(ChartTimeline.Clamp(index, this.frames.Count));
    }

    public int CurrentIndex() {
        return ChartTimeline.TimelineIdxOf(this.App, this.WidgetId(), this.frames.Count);
    }

    public static int TimelineIdxOf(App app, int wid, int count) {
        if (app == null || count < 1) { return 0; }
        return ChartTimeline.Clamp(app.StateGet(ChartTimeline.TlIdxKey(wid), 0), count);
    }

    public static ChartTimeline FromJsonValue(JsonValue timeline, JsonValue options) {
        ChartTimeline result = ChartTimeline.Of();
        if (timeline != null && timeline.IsObject()) {
            if (timeline.Bool("autoPlay", false) || timeline.Has("playInterval")) {
                result.intervalMs = timeline.Int("playInterval", 1000);
            }
            JsonValue data = timeline.Get("data");
            if (data != null && data.IsArray()) {
                for (int i = 0; i < data.Count(); i = i + 1) {
                    result.labels.Add(data.At(i).AsString(""));
                }
            }
        }
        if (options != null && options.IsArray()) {
            for (int i = 0; i < options.Count(); i = i + 1) {
                result.frames.Add(ChartOption.FromJsonValue(options.At(i)));
            }
        }
        return result;
    }

    public string LabelAt(int index) {
        if (index < this.labels.Count && this.labels[index].Length > 0) {
            return this.labels[index];
        }
        if (index < this.frames.Count && this.frames[index].title.Length > 0) {
            return this.frames[index].title;
        }
        return Convert.ToString(index + 1);
    }

    public static int Clamp(int index, int count) {
        if (count < 1) { return 0; }
        return MathUtil.Clamp(index, 0, count - 1);
    }

    // 纯节拍函数：过期只推进一次，避免暂停或阻塞后补发大量帧。
    public static int StepPlay(int index, int count, int last, int now, int interval) {
        if (count < 1) { return 0; }
        if (interval < 1 || last < 0 || now - last < interval) { return Clamp(index, count); }
        return (Clamp(index, count) + 1) % count;
    }

    public static ChartOption Merge(ChartOption baseOption, ChartOption frame) {
        ChartOption result = baseOption != null ? baseOption.Clone() : ChartOption.Create();
        if (result == null) { result = ChartOption.Create(); }
        if (frame == null) { return result; }
        if (frame.title.Length > 0) { result.title = frame.title; }
        for (int i = 0; i < frame.series.Count; i = i + 1) {
            ChartSeries source = frame.series[i];
            ChartSeries copy = source != null ? source.Clone() : null;
            if (copy == null) { continue; }
            int found = -1;
            for (int j = 0; j < result.series.Count; j = j + 1) {
                if (result.series[j].name == source.name) { found = j; break; }
            }
            if (found < 0) { result.series.Add(copy); }
            else { result.series[found] = copy; }
        }
        return result;
    }

    public static int TlIdxKey(int wid) { return IdHash.HashInt(wid, 201); }
    public static int TlPlayKey(int wid) { return IdHash.HashInt(wid, 202); }
    public static int TlTickKey(int wid) { return IdHash.HashInt(wid, 203); }

    public static int Height(App app) { return app.Scale(26); }

    void DrawFrame(App app) {
        ChartTimelineLayout layout = inputLayout;
        int count = this.frames.Count;
        if (layout == null || count < 1 || layout.dots.Count != count) { return; }
        Canvas canvas = app.canvas;
        int index = this.CurrentIndex();
        int playing = app.StateGet(ChartTimeline.TlPlayKey(this.WidgetId()), intervalMs > 0 ? 1 : 0);
        int glyph = app.Scale(13);
        int foreground = Style.Part(app, "chart", "hint", "", "", "", Style.SNormal()).FgOr(0);
        int dotBackground = Style.Part(app, "chart", "zoom-track", "", "", "", Style.SNormal()).BgOr(0);
        int dotActive = Style.Part(app, "chart", "zoom-window", "", "", "", Style.SNormal()).BgOr(0);
        canvas.DrawGlyphIn(playing == 1 ? "pause" : "play", layout.play.x, layout.play.y,
        layout.play.width, layout.play.height, glyph, foreground);
        canvas.DrawGlyphIn("chevron-left", layout.previous.x, layout.previous.y,
        layout.previous.width, layout.previous.height, glyph, foreground);
        canvas.FillRoundRect(layout.track.x, layout.track.y, layout.track.width, layout.track.height,
        app.Scale(1), dotBackground);
        for (int i = 0; i < count; i = i + 1) {
            Rect dot = layout.dots[i];
            int center = dot.x + dot.width / 2;
            canvas.FillCircle(center, layout.dotY,
            i == index ? layout.dotRadius + app.Scale(1) : layout.dotRadius,
            i == index ? dotActive : dotBackground);
            if (i == index) {
                string label = this.LabelAt(i);
                if (label.Length > 0) {
                    int width = Canvas.MeasureText(label, ChartFonts.Legend(app));
                    int left = center - width / 2;
                    if (left < layout.track.x) { left = layout.track.x; }
                    if (left + width > layout.track.x + layout.track.width) {
                        left = layout.track.x + layout.track.width - width;
                    }
                    canvas.DrawText(left, layout.dotY - Canvas.FontHeight(ChartFonts.Legend(app))
                    - app.Scale(2), label, foreground, ChartFonts.Legend(app));
                }
            }
        }
        canvas.DrawGlyphIn("chevron-right", layout.next.x, layout.next.y,
        layout.next.width, layout.next.height, glyph, foreground);
    }
}
