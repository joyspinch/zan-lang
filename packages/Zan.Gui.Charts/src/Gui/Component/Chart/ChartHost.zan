using Gui;

namespace Gui.Component.Chart;

// 保留式图表宿主控件：把立即模式的 ChartView 包进控件树，
// 设计器生成的窗体与运行期 JSON 装载因此能像普通控件一样
// 持有图表（此前 Chart 只能被宿主逐帧 Render，生成代码只发
// Panel 占位）。
// 核心契约与执行状态转移规范。
// ch.SetProp("type", "pie");     // ChartKinds 注册表字符串
// ch.SetProp("title", "访问来源");
// `type` 收 ECharts type 字符串（line/bar/pie/scatter/gauge/
// funnel/radar/wordCloud/...）与设计器别名（area/stacked/hbar/
// hstacked/donut）；切换或构建时按类型现拼一份示例 option
// （SampleOf），宿主接手真数据走 SetOption。依赖结构化数据的
// 图型（地图/关系图/事件河流图等）示例先以分类图呈现，类型
// 字符串原样保留，等 SetOption 换真数据。
class ChartHost : Control {
    ChartView view;
    ChartOption opt;
    string chartType;

    // 默认柱状图示例。必须显式构建：Zan 子类不会隐式跑基类
    // 字段初始化，缺构造的实例 view/opt 全 null。
    ChartHost() {
        this.InitControl("chartHost", 0);
        chartType = "bar";
        opt = ChartHost.SampleOf("bar");
        view = ChartView.Of(opt);
    }

    override string Kind() { return "ChartHost"; }

    // 当前图型字符串与标题的文本应答；其余键交基类
    // （Props 未声明的键走 GetExtra/样式类 fallback）。
    override string GetProp(string key) {
        if (key == "type") { return chartType; }
        if (key == "title") { return opt.title; }
        return base.GetProp(key);
    }

    override void SetProp(string key, string val) {
        if (key == "type") { this.SetChartType(val); return; }
        if (key == "title") { opt.title = val; return; }
        base.SetProp(key, val);
    }

    // 切换图型并重拼示例 option。宿主已用 SetOption 接管数据后
    // 切型会重置为示例数据——类型与数据一起由 SetOption 定。
    void SetChartType(string s) {
        chartType = s;
        opt = ChartHost.SampleOf(s);
        view = ChartView.Of(opt);
    }

    // 整体替换 option（类型、图例、系列全由调用方定）；null
    // 忽略。ChartView 重建，入场动画重放一次。
    void SetOption(ChartOption o) {
        if (o == null) { return; }
        opt = o;
        view = ChartView.Of(o);
    }

    // 示例尺寸（自由画布/流式布局都可再覆写宽高）。
    override void OnMeasure(App app) {
        // 基线图表主题懒装载（App 不再构造即装载，见 ChartTheme）。
        ChartTheme.EnsureDefault(app);
        prefW = 320;
        prefH = 200;
    }

    override void OnPaint(App app) {
        // 兜底：跳过测量的画布路径也能拿到基线主题。
        ChartTheme.EnsureDefault(app);
        view.Render(app, bx, by, bw, bh);
    }

    // 按图型字符串现拼示例 option——设计器画布预览与 `type`
    // 切换共用同一份，保证"设计器所见 = 生成窗体初见"。别名
    // （area/stacked/hbar/hstacked/donut）映射到对应系列风格；
    // line/bar 之外的注册表类型配各自的示例系列；依赖结构化
    // 数据的图型先以分类示例呈现（类型串留在 chartType 上，
    // 真数据由 SetOption 接管）。
    static ChartOption SampleOf(string type) {
        List<string> cats = new List<string>{
            "Mon", "Tue", "Wed", "Thu", "Fri" };
        List<int> a = new List<int>{ 24, 52, 38, 66, 45 };
        List<int> b = new List<int>{ 30, 20, 50, 40, 60 };
        string t = type;
        if (t == null || t == "") { t = "bar"; }

        if (t == "pie" || t == "donut") {
            ChartOption o = ChartOption.With(ChartType.Pie, "", cats);
            ChartSeries s = ChartSeries.Pie("Series A", a);
            if (t == "donut") { s.innerPct = 55; }
            o.showLegend = true;
            o.Add(s);
            return o;
        }
        if (t == "scatter") {
            ChartOption o = ChartOption.Scatter("");
            List<ChartPoint> pts = new List<ChartPoint>{
                ChartPoint.Of(12, 24), ChartPoint.Of(28, 52),
                ChartPoint.Of(40, 38), ChartPoint.Of(55, 66),
                ChartPoint.Of(70, 45) };
            o.Add(ChartSeries.OfPoints("Series A", pts));
            return o;
        }
        if (t == "gauge") {
            ChartOption o = ChartOption.With(ChartType.Gauge, "", cats);
            o.Add(ChartSeries.Gauge("Series A", 66));
            return o;
        }
        if (t == "funnel") {
            ChartOption o = ChartOption.With(ChartType.Funnel, "", cats);
            o.Add(ChartSeries.Funnel("Series A", a));
            return o;
        }
        if (t == "radar") {
            ChartOption o = ChartOption.With(ChartType.Radar, "", cats);
            o.Add(ChartSeries.Polar("Series A", a));
            o.Add(ChartSeries.Polar("Series B", b));
            return o;
        }
        if (t == "wordcloud") {
            ChartOption o = ChartOption.With(ChartType.WordCloud, "", cats);
            List<ChartData> words = new List<ChartData>{
                ChartData.Named(72, "Zan"), ChartData.Named(58, "Gui"),
                ChartData.Named(46, "Chart"), ChartData.Named(35, "LLVM"),
                ChartData.Named(27, "ARC"), ChartData.Named(19, "Wasm") };
            o.Add(ChartSeries.WordCloud("Words", words));
            return o;
        }
        if (t == "area") {
            ChartOption o = ChartOption.With(ChartType.Line, "", cats);
            o.Add(ChartSeries.Area("Series A", a)).Add(ChartSeries.Area("Series B", b));
            return o;
        }
        if (t == "stacked") {
            ChartOption o = ChartOption.With(ChartType.Bar, "", cats);
            o.Add(ChartSeries.StackedBar("Series A", a)).Add(ChartSeries.StackedBar("Series B", b));
            return o;
        }
        if (t == "hbar") {
            ChartOption o = ChartOption.With(ChartType.Bar, "", cats);
            o.Add(ChartSeries.HBar("Series A", a)).Add(ChartSeries.HBar("Series B", b));
            return o;
        }
        if (t == "hstacked") {
            ChartOption o = ChartOption.With(ChartType.Bar, "", cats);
            o.Add(ChartSeries.HStacked("Series A", a)).Add(ChartSeries.HStacked("Series B", b));
            return o;
        }
        if (t == "line" || t == "bar") {
            ChartType ct = ChartType.Bar;
            if (t == "line") { ct = ChartType.Line; }
            ChartOption o = ChartOption.With(ct, "", cats);
            o.Add("Series A", ct, a).Add("Series B", ct, b);
            return o;
        }
        /* 其余注册表类型（k/map/graph/chord/force/eventRiver/
         * treemap/tree/heatmap 及扩展渲染器标签）依赖结构化数据，
         * 示例先以分类柱状呈现；类型字符串留在 chartType，宿主
         * SetOption 接管后按真数据渲染。 */
        ChartOption fb = ChartOption.With(ChartType.Bar, "", cats);
        fb.Add("Series A", a).Add("Series B", b);
        return fb;
    }
}
