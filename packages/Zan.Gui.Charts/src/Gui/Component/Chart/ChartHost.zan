using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

namespace Gui.Component.Chart;

// 保留式图表宿主控件：把立即模式的 ChartView 包进控件树，
// 设计器生成的窗体与运行期 JSON 装载因此能像普通控件一样
// 持有图表（此前 Chart 只能被宿主逐帧 Render，生成代码只发
// Panel 占位）。
// ch.SetProp("type", "pie");     // ChartKinds 注册表字符串
// ch.SetProp("title", "访问来源");
// `type` 收 ECharts type 字符串（line/bar/pie/scatter/gauge/
// funnel/radar/wordCloud/...）与设计器别名（area/stacked/hbar/
// hstacked/donut）；切换或构建时按类型现拼一份示例 option
// （SampleOf），宿主接手真数据走 SetOption。依赖结构化数据的
// 图型（地图/关系图/事件河流图等）示例先以分类图呈现，类型
// 字符串原样保留，等 SetOption 换真数据。
public class ChartHost : Control {
    ChartView view;
    ChartOption opt;
    string chartType;
    bool widgetToolbox;
    ButtonGroup toolboxGroup;
    List<Button> toolboxButtons;
    int lastToolboxActionsHash;

    // 自注册入口（B-ID44 约定）：按需注册到 ControlFactory
    public static void Install() {
        Gui.ControlFactory.Register("ChartHost", (string k) => new ChartHost());
        Gui.ControlFactory.Register("Chart", (string k) => new ChartHost());
    }

    // 默认柱状图示例。必须显式构建：Zan 子类不会隐式跑基类
    // 字段初始化，缺构造的实例 view/opt 全 null。
    public ChartHost() {
        this.InitControl("chartHost", 0);
        chartType = "bar";
        opt = ChartHost.SampleOf("bar");
        view = ChartView.Of(opt);
        widgetToolbox = false;
        toolboxGroup = null;
        toolboxButtons = null;
        lastToolboxActionsHash = 0;
    }

    // 显式指定 ChartOption 构建
    public ChartHost(ChartOption o) {
        this.InitControl("chartHost", 0);
        opt = o != null ? o : ChartHost.SampleOf("bar");
        chartType = opt.series.Count > 0 ? ChartKinds.TypeName(opt.series[0].type) : "bar";
        view = ChartView.Of(opt);
        widgetToolbox = false;
        toolboxGroup = null;
        toolboxButtons = null;
        lastToolboxActionsHash = 0;
    }

    public override string Kind() { return "ChartHost"; }

    // 当前图型字符串与标题的文本应答；其余键交基类
    // （Props 未声明的键走 GetExtra/样式类 fallback）。
    public override string GetProp(string key) {
        if (key == "type") { return chartType; }
        if (key == "title") { return opt.title; }
        if (key == "widgetToolbox") { return widgetToolbox ? "true" : "false"; }
        return base.GetProp(key);
    }

    public override void SetProp(string key, string val) {
        if (key == "type") { this.SetChartType(val); return; }
        if (key == "title") { opt.title = val; return; }
        if (key == "widgetToolbox") { this.SetWidgetToolbox(val == "true" || val == "1"); return; }
        base.SetProp(key, val);
    }

    // 启用/禁用外挂控件模式工具箱（ButtonGroup/Button 挂载）
    public void SetWidgetToolbox(bool enable) {
        widgetToolbox = enable;
        if (!enable && toolboxGroup != null) {
            toolboxGroup.Visible = false;
        }
    }

    public bool IsWidgetToolbox() { return widgetToolbox; }

    private void EnsureToolboxGroup() {
        if (toolboxGroup == null) {
            toolboxGroup = new ButtonGroup("chart-toolbox-bar row");
            toolboxButtons = new List<Button>();
            this.Add(toolboxGroup);
        }
    }

    private void RefreshToolboxButtons() {
        if (toolboxGroup != null) {
            toolboxGroup.ClearSegs();
            if (toolboxButtons != null) { toolboxButtons.Clear(); }
            lastToolboxActionsHash = 0;
        }
    }

    private void SyncToolboxWidget(App app) {
        if (opt == null || !opt.toolboxShow) {
            if (toolboxGroup != null) { toolboxGroup.Visible = false; }
            return;
        }
        this.EnsureToolboxGroup();
        List<int> ids = ChartToolbox.Actions(opt);
        if (ids.Count < 1) {
            toolboxGroup.Visible = false;
            return;
        }

        int h = 0;
        for (int i = 0; i < ids.Count; i = i + 1) {
            h = h * 31 + ids[i];
        }
        if (h != lastToolboxActionsHash) {
            toolboxGroup.ClearSegs();
            toolboxButtons.Clear();
            string[] icons = new string[]{
                "table", "chart-line", "chart-bar", "undo", "save", "search" };
            string[] tips = new string[]{
                "数据视图", "切换为折线", "切换为柱状", "还原", "保存为图片", "区域缩放" };
            for (int k = 0; k < ids.Count; k = k + 1) {
                int act = ids[k];
                Button b = new Button(new IconView(icons[act], 14));
                b.Tip = tips[act];
                b.Class = "toolbox-btn ghost small";
                b.Click.Add(() => {
                    this.OnToolboxAction(act);
                });
                toolboxButtons.Add(b);
                toolboxGroup.AddButton(b);
            }
            lastToolboxActionsHash = h;
        }

        int wid = view.Wid();
        int magic = app.StateGet(Chart.TbMagicKey(wid), 0);
        int zOn = app.StateGet(Chart.TbZoomKey(wid), 0);
        for (int k = 0; k < ids.Count; k = k + 1) {
            int act = ids[k];
            bool on = (act == 1 && magic == 1) || (act == 2 && magic == 2)
                || (act == 5 && zOn != 0);
            if (k < toolboxButtons.Count) {
                toolboxButtons[k].Checked = on;
            }
        }

        int btn = ChartToolbox.Btn(app);
        int gap = ChartToolbox.Gap(app);
        int pad = ChartToolbox.Pad(app);
        int n = ids.Count;
        int rowW = n * btn + (n - 1) * gap;
        int baseX = bx + bw - pad - rowW;
        int baseY = by + pad;

        toolboxGroup.Visible = true;
        toolboxGroup.Arrange(baseX, baseY, rowW, btn);
    }

    private void OnToolboxAction(int action) {
        App app = this.FindApp();
        if (app == null || opt == null || view == null) { return; }
        int wid = view.Wid();
        int magic = app.StateGet(Chart.TbMagicKey(wid), 0);
        int zOn = app.StateGet(Chart.TbZoomKey(wid), 0);
        ChartToolbox.Click(app, action, wid, opt, bx, by, bw, bh, magic, zOn);
        app.RequestRedraw();
    }

    // 切换图型并重拼示例 option。宿主已用 SetOption 接管数据后
    // 切型会重置为示例数据——类型与数据一起由 SetOption 定。
    public void SetChartType(string s) {
        chartType = s;
        opt = ChartHost.SampleOf(s);
        view = ChartView.Of(opt);
        this.RefreshToolboxButtons();
    }

    // 整体替换 option（类型、图例、系列全由调用方定）；null
    // 忽略。ChartView 重建，入场动画重放一次。
    public void SetOption(ChartOption o) {
        if (o == null) { return; }
        opt = o;
        view = ChartView.Of(o);
        this.RefreshToolboxButtons();
    }

    // 获取当前配置选项
    public ChartOption GetOption() {
        return opt;
    }

    // 设置预设主题（如 "macarons", "dark", "shine", "blue" 等）
    public void SetTheme(string name) {
        if (name == null || name.Length == 0) { return; }
        ChartSkin.SetCurrent(name);
    }

    // 示例尺寸（自由画布/流式布局都可再覆写宽高）。
    public override void OnMeasure(App app) {
        app = this.ResolveApp(app);
        // 基线图表主题懒装载（App 不再构造即装载，见 ChartTheme）。
        if (app != null) { ChartTheme.EnsureDefault(app); }
        prefW = 320;
        prefH = 200;
    }

    public override void OnPaint(App app) {
        app = this.ResolveApp(app);
        // 兜底：跳过测量的画布路径也能拿到基线主题。
        if (app != null) { ChartTheme.EnsureDefault(app); }
        if (widgetToolbox && opt != null && opt.toolboxShow) {
            view.suppressCanvasToolbox = true;
            this.SyncToolboxWidget(app);
        } else {
            view.suppressCanvasToolbox = false;
            if (toolboxGroup != null) { toolboxGroup.Visible = false; }
        }
        view.Render(app, bx, by, bw, bh);
    }

    // 按图型字符串现拼示例 option——设计器画布预览与 `type`
    // 切换共用同一份，保证"设计器所见 = 生成窗体初见"。别名
    // （area/stacked/hbar/hstacked/donut）映射到对应系列风格；
    // line/bar 之外的注册表类型配各自的示例系列；依赖结构化
    // 数据的图型先以分类示例呈现（类型串留在 chartType 上，
    // 真数据由 SetOption 接管）。
    public static ChartOption SampleOf(string type) {
        List<string> cats = new List<string>{
            "Mon", "Tue", "Wed", "Thu", "Fri" };
        List<int> a = new List<int>{ 24, 52, 38, 66, 45 };
        List<int> b = new List<int>{ 30, 20, 50, 40, 60 };
        string t = type;
        if (t == null || t == "") { t = "bar"; }

        if (t == "pie" || t == "donut") {
            ChartOption o = ChartOption.With(ChartType.Pie, "", cats);
            ChartSeries s = ChartSeries.Pie("Series A", a);
            if (t == "donut") { s.innerPct = 55; }
            o.showLegend = true;
            o.Add(s);
            return o;
        }
        if (t == "scatter") {
            ChartOption o = ChartOption.Scatter("");
            List<ChartPoint> pts = new List<ChartPoint>{
                ChartPoint.Of(12, 24), ChartPoint.Of(28, 52),
                ChartPoint.Of(40, 38), ChartPoint.Of(55, 66),
                ChartPoint.Of(70, 45) };
            o.Add(ChartSeries.OfPoints("Series A", pts));
            return o;
        }
        if (t == "gauge") {
            ChartOption o = ChartOption.With(ChartType.Gauge, "", cats);
            o.Add(ChartSeries.Gauge("Series A", 66));
            return o;
        }
        if (t == "funnel") {
            ChartOption o = ChartOption.With(ChartType.Funnel, "", cats);
            o.Add(ChartSeries.Funnel("Series A", a));
            return o;
        }
        if (t == "radar") {
            ChartOption o = ChartOption.With(ChartType.Radar, "", cats);
            o.Add(ChartSeries.Polar("Series A", a));
            o.Add(ChartSeries.Polar("Series B", b));
            return o;
        }
        if (t == "wordcloud") {
            ChartOption o = ChartOption.With(ChartType.WordCloud, "", cats);
            List<ChartData> words = new List<ChartData>{
                ChartData.Named(72, "Zan"), ChartData.Named(58, "Gui"),
                ChartData.Named(46, "Chart"), ChartData.Named(35, "LLVM"),
                ChartData.Named(27, "ARC"), ChartData.Named(19, "Wasm") };
            o.Add(ChartSeries.WordCloud("Words", words));
            return o;
        }
        if (t == "area") {
            ChartOption o = ChartOption.With(ChartType.Line, "", cats);
            o.Add(ChartSeries.Area("Series A", a)).Add(ChartSeries.Area("Series B", b));
            return o;
        }
        if (t == "stacked") {
            ChartOption o = ChartOption.With(ChartType.Bar, "", cats);
            o.Add(ChartSeries.StackedBar("Series A", a)).Add(ChartSeries.StackedBar("Series B", b));
            return o;
        }
        if (t == "hbar") {
            ChartOption o = ChartOption.With(ChartType.Bar, "", cats);
            o.Add(ChartSeries.HBar("Series A", a)).Add(ChartSeries.HBar("Series B", b));
            return o;
        }
        if (t == "hstacked") {
            ChartOption o = ChartOption.With(ChartType.Bar, "", cats);
            o.Add(ChartSeries.HStacked("Series A", a)).Add(ChartSeries.HStacked("Series B", b));
            return o;
        }
        if (t == "line" || t == "bar") {
            ChartType ct = ChartType.Bar;
            if (t == "line") { ct = ChartType.Line; }
            ChartOption o = ChartOption.With(ct, "", cats);
            o.Add("Series A", ct, a).Add("Series B", ct, b);
            return o;
        }
        /* 其余注册表类型（k/map/graph/chord/force/eventRiver/
         * treemap/tree/heatmap 及扩展渲染器标签）依赖结构化数据，
         * 示例先以分类柱状呈现；类型字符串留在 chartType，宿主
         * SetOption 接管后按真数据渲染。 */
        ChartOption fb = ChartOption.With(ChartType.Bar, "", cats);
        fb.Add("Series A", a).Add("Series B", b);
        return fb;
    }
}
