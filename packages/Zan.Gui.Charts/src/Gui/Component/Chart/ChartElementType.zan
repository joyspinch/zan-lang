namespace Gui.Component.Chart;

// 图表元素分类。Chart 表示整图空白区域，其余类型表示具体
// 数据图元；这是有限整数枚举，不承诺 ECharts DOM 的完整组件树。
public enum ChartElementType {
    Chart,
    LinePoint,
    Bar,
    ScatterPoint,
    HeatmapCell,
    PieSlice,
    MapRegion,
    FunnelStage,
    Node,
    Link,
    VennCircle,
    EventBand,
    RadarAxis,
    Candlestick,
    BoxPlot,
    ErrorBar,
    Gauge,
    WordTag
}
