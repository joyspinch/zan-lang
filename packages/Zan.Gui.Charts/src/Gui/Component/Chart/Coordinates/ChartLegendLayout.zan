using System;
using Gui;

namespace Gui.Component.Chart;

// The same measured entries place both retained input nodes and legend ink.
internal class ChartLegendLayout {
    internal List<ChartLegendEntry> entries = new List<ChartLegendEntry>();
    internal int bodyY;

    internal static ChartLegendLayout Series(App app, int x, int y, int w, int h,
    string title, List<ChartSeries> series,
    int zoomReserve) {
        ChartLegendLayout layout = new ChartLegendLayout();
        int pad = app.theme.paddingMedium;
        int fs = ChartFonts.Legend(app);
        int rowH = Canvas.FontHeight(fs) + app.Scale(6);
        List<int> prim = Chart.LegendPrimIdx(series);
        bool vertical = Chart.LegendVertical();
        string format = Chart.LegendFmt();
        int ly = y + pad;
        if (vertical) {
            int rows = prim.Count > 0 ? prim.Count : 1;
            ly = Chart.LegendFloatTop(app, y, h - zoomReserve, rows * rowH, pad);
        } else {
            int rows = 1;
            int cursor = x + pad;
            for (int i = 0; i < prim.Count; i = i + 1) {
                int width = app.Scale(30) + Canvas.MeasureText(
                Chart.LegendLabel(format, series[prim[i]].name), fs);
                if (cursor > x + pad && cursor + width > x + w - pad) {
                    rows = rows + 1;
                    cursor = x + pad;
                }
                cursor = cursor + width + app.Scale(10);
            }
            ly = y + h - zoomReserve - app.Scale(27) - rowH / 2 - (rows - 1) * rowH;
        }
        int lx = x + pad;
        int maxX = x + w - pad;
        if (!vertical) {
            int total = 0;
            for (int i = 0; i < prim.Count; i = i + 1) {
                total = total + app.Scale(30) + Canvas.MeasureText(
                Chart.LegendLabel(format, series[prim[i]].name), fs) + app.Scale(10);
            }
            if (prim.Count > 0) { total = total - app.Scale(10); }
            if (total > 0 && total <= maxX - lx) {
                lx = Chart.LegendFloatLeft(app, x, w, total, pad, x + pad, maxX);
            }
        }
        for (int i = 0; i < prim.Count; i = i + 1) {
            int index = prim[i];
            string text = Chart.LegendLabel(format, series[index].name);
            int width = app.Scale(30) + Canvas.MeasureText(text, fs);
            if (lx > x + pad && (vertical || lx + width > maxX)) {
                lx = x + pad;
                ly = ly + rowH;
            }
            layout.entries.Add(ChartLegendEntry.Of(2, index, lx, ly, width, rowH, text));
            lx = lx + width + app.Scale(14);
        }
        return layout;
    }

    internal static ChartLegendLayout Pie(App app, ChartOption o, int x, int y,
    int w, int h, int top) {
        ChartLegendLayout layout = new ChartLegendLayout();
        layout.bodyY = top;
        if (!o.showLegend) { return layout; }
        List<PieLegendItem> candidates = ChartView.PieLegendCollect(o);
        if (o.legendData != null && o.legendData.Count > 1) {
            for (int i = 0; i < o.legendData.Count && i < candidates.Count; i = i + 1) {
                for (int j = i; j < candidates.Count; j = j + 1) {
                    if (candidates[j].name == o.legendData[i]) {
                        PieLegendItem item = candidates[i];
                        candidates[i] = candidates[j]; candidates[j] = item;
                        break;
                    }
                }
            }
        }
        int pad = app.theme.paddingMedium;
        int rowH = Canvas.FontHeight(ChartFonts.Legend(app)) + app.Scale(6);
        int gap = app.Scale(8);
        int x0 = x + pad;
        int maxX = x + w - pad;
        int lx = x0;
        bool vertical = o.legendOrient == "vertical";
        int rows = vertical ? candidates.Count : 1;
        int ly = Chart.LegendFloatTop(app, y, h, rows * rowH, pad);
        if (!vertical && candidates.Count > 0) {
            int total = 0 - gap;
            for (int i = 0; i < candidates.Count; i = i + 1) {
                total = total + Chart.LegendChipW(app, candidates[i].name) + gap;
            }
            lx = Chart.LegendFloatLeft(app, x, w, total, pad, x0, maxX);
        }
        for (int i = 0; i < candidates.Count; i = i + 1) {
            PieLegendItem item = candidates[i];
            int width = Chart.LegendChipW(app, item.name);
            if (vertical) { lx = x0; }
            else if (lx > x0 && lx + width > maxX) { lx = x0; ly = ly + rowH; }
            int key = o.iwid != 0 ? Chart.LegendSliceKey(o.iwid, item.seriesIndex, item.dataIndex) : 0;
            ChartLegendEntry entry = ChartLegendEntry.Of(3, key, lx, ly, width, rowH, item.name);
            entry.seriesIndex = item.seriesIndex;
            entry.dataIndex = item.dataIndex;
            layout.entries.Add(entry);
            if (vertical) { ly = ly + rowH; }
            else {
                lx = lx + width + gap;
                if (ly + rowH > layout.bodyY) { layout.bodyY = ly + rowH; }
            }
        }
        if (layout.bodyY > y + h / 2) { layout.bodyY = top; }
        if (layout.bodyY > top) { layout.bodyY = layout.bodyY + app.Scale(4); }
        return layout;
    }
}

internal class ChartLegendEntry {
    internal int kind;
    internal int index;
    internal int seriesIndex;
    internal int dataIndex;
    internal int x;
    internal int y;
    internal int w;
    internal int h;
    internal string text;

    internal static ChartLegendEntry Of(int kind, int index, int x, int y, int w, int h, string text) {
        ChartLegendEntry entry = new ChartLegendEntry();
        entry.kind = kind; entry.index = index;
        entry.x = x; entry.y = y; entry.w = w; entry.h = h; entry.text = text;
        return entry;
    }
}
