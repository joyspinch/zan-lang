using Gui;
using System.Json;
using System;

namespace Gui.Component.Chart;

// The same measured entries place both retained input nodes and legend ink.
internal class ChartLegendLayout {
    internal List<ChartLegendEntry> entries = new List<ChartLegendEntry>();
    internal int bodyY;

    internal static ChartLegendLayout Series(App app, int x, int y, int w, int h,
    string title, List<ChartSeries> series,
    int zoomReserve) {
        ChartLegendLayout layout = new ChartLegendLayout();
        int pad = app.theme.paddingMedium;
        int fs = ChartFonts.Legend(app);
        int rowH = Canvas.FontHeight(fs) + app.Scale(6);
        List<int> prim = Chart.LegendPrimIdx(series);
        bool vertical = Chart.LegendVertical();
        string format = Chart.LegendFmt();
        int ly = y + pad;
        if (vertical) {
            int rows = prim.Count > 0 ? prim.Count : 1;
            ly = Chart.LegendFloatTop(app, y, h - zoomReserve, rows * rowH, pad);
        } else {
            int rows = 1;
            int cursor = x + pad;
            for (int i = 0; i < prim.Count; i = i + 1) {
                int width = app.Scale(30) + Canvas.MeasureText(
                Chart.LegendLabel(format, series[prim[i]].name), fs);
                if (cursor > x + pad && cursor + width > x + w - pad) {
                    rows = rows + 1;
                    cursor = x + pad;
                }
                cursor = cursor + width + app.Scale(10);
            }
            ly = y + h - zoomReserve - app.Scale(27) - rowH / 2 - (rows - 1) * rowH;
        }
        int lx = x + pad;
        int maxX = x + w - pad;
        if (!vertical) {
            int total = 0;
            for (int i = 0; i < prim.Count; i = i + 1) {
                total = total + app.Scale(30) + Canvas.MeasureText(
                Chart.LegendLabel(format, series[prim[i]].name), fs) + app.Scale(10);
            }
            if (prim.Count > 0) { total = total - app.Scale(10); }
            if (total > 0 && total <= maxX - lx) {
                lx = Chart.LegendFloatLeft(app, x, w, total, pad, x + pad, maxX);
            }
        }
        for (int i = 0; i < prim.Count; i = i + 1) {
            int index = prim[i];
            string text = Chart.LegendLabel(format, series[index].name);
            int width = app.Scale(30) + Canvas.MeasureText(text, fs);
            if (lx > x + pad && (vertical || lx + width > maxX)) {
                lx = x + pad;
                ly = ly + rowH;
            }
            layout.entries.Add(ChartLegendEntry.Of(2, index, lx, ly, width, rowH, text));
            lx = lx + width + app.Scale(14);
        }
        return layout;
    }

    internal static ChartLegendLayout Pie(App app, ChartOption o, int x, int y,
    int w, int h, int top) {
        ChartLegendLayout layout = new ChartLegendLayout();
        layout.bodyY = top;
        if (!o.showLegend) { return layout; }
        List<PieLegendItem> candidates = ChartView.PieLegendCollect(o);
        if (o.legendData != null && o.legendData.Count > 1) {
            for (int i = 0; i < o.legendData.Count && i < candidates.Count; i = i + 1) {
                for (int j = i; j < candidates.Count; j = j + 1) {
                    if (candidates[j].name == o.legendData[i]) {
                        PieLegendItem item = candidates[i];
                        candidates[i] = candidates[j]; candidates[j] = item;
                        break;
                    }
                }
            }
        }
        int pad = app.theme.paddingMedium;
        int rowH = Canvas.FontHeight(ChartFonts.Legend(app)) + app.Scale(6);
        int gap = app.Scale(8);
        int x0 = x + pad;
        int maxX = x + w - pad;
        int lx = x0;
        bool vertical = o.legendOrient == "vertical";
        int rows = vertical ? candidates.Count : 1;
        int ly = Chart.LegendFloatTop(app, y, h, rows * rowH, pad);
        if (!vertical && candidates.Count > 0) {
            int total = 0 - gap;
            for (int i = 0; i < candidates.Count; i = i + 1) {
                total = total + Chart.LegendChipW(app, candidates[i].name) + gap;
            }
            lx = Chart.LegendFloatLeft(app, x, w, total, pad, x0, maxX);
        }
        for (int i = 0; i < candidates.Count; i = i + 1) {
            PieLegendItem item = candidates[i];
            int width = Chart.LegendChipW(app, item.name);
            if (vertical) { lx = x0; }
            else if (lx > x0 && lx + width > maxX) { lx = x0; ly = ly + rowH; }
            int key = o.iwid != 0 ? Chart.LegendSliceKey(o.iwid, item.seriesIndex, item.dataIndex) : 0;
            ChartLegendEntry entry = ChartLegendEntry.Of(3, key, lx, ly, width, rowH, item.name);
            entry.seriesIndex = item.seriesIndex;
            entry.dataIndex = item.dataIndex;
            layout.entries.Add(entry);
            if (vertical) { ly = ly + rowH; }
            else {
                lx = lx + width + gap;
                if (ly + rowH > layout.bodyY) { layout.bodyY = ly + rowH; }
            }
        }
        if (layout.bodyY > y + h / 2) { layout.bodyY = top; }
        if (layout.bodyY > top) { layout.bodyY = layout.bodyY + app.Scale(4); }
        return layout;
    }
}

internal class ChartLegendEntry {
    internal int kind;
    internal int index;
    internal int seriesIndex;
    internal int dataIndex;
    internal int x;
    internal int y;
    internal int w;
    internal int h;
    internal string text;

    internal static ChartLegendEntry Of(int kind, int index, int x, int y, int w, int h, string text) {
        ChartLegendEntry entry = new ChartLegendEntry();
        entry.kind = kind; entry.index = index;
        entry.x = x; entry.y = y; entry.w = w; entry.h = h; entry.text = text;
        return entry;
    }
}

internal class ChartZoomLayout {
    internal int x;
    internal int y;
    internal int w;
    internal int h;
    internal int loX;
    internal int hiX;
    internal int handle;
    internal int hitHalf;
    internal int bandH;
    internal int minGap;
    internal bool moveStrip;

    internal static ChartZoomLayout Create(App app, ChartOption o, int plotX, int plotW,
    int x, int y, int w, int h, int wid, int n) {
        ChartZoom component = Chart.ZoomBarComp(o);
        if (component == null || plotW < 4 || n < 2 || w < 4) { return null; }
        ChartZoomLayout layout = new ChartZoomLayout();
        layout.h = Chart.ZoomBarH(app, component, h);
        layout.y = y + h - app.Scale(22) - layout.h;
        if (component.top >= 0) { layout.y = y + app.Scale(component.top); }
        else if (component.topPct >= 0) { layout.y = y + h * component.topPct / 100; }
        else if (component.bottom >= 0) { layout.y = y + h - app.Scale(component.bottom) - layout.h; }
        layout.w = plotW; layout.x = plotX;
        if (component.width >= 0) { layout.w = app.Scale(component.width); }
        else if (component.widthPct >= 0) { layout.w = w * component.widthPct / 100; }
        if (component.left >= 0) { layout.x = x + app.Scale(component.left); }
        else if (component.leftPct >= 0) { layout.x = x + w * component.leftPct / 100; }
        else if (component.right >= 0) { layout.x = x + w - app.Scale(component.right) - layout.w; }
        else if (component.rightPct >= 0) { layout.x = x + w - w * component.rightPct / 100 - layout.w; }
        if (layout.w < 4) { return null; }
        int lo = app.StateGet(Chart.ZoomLoKey(wid), o.zoomStart * 10);
        int hi = app.StateGet(Chart.ZoomHiKey(wid), o.zoomEnd * 10);
        layout.loX = layout.x + lo * layout.w / 1000;
        layout.hiX = layout.x + hi * layout.w / 1000;
        layout.handle = component.handleSizePx == 0 ? 0 : component.handleSizePx > 0
        ? app.Scale(component.handleSizePx) : layout.h * component.handleSize / 100;
        layout.hitHalf = layout.handle > 0 ? 3 : app.Scale(6);
        layout.moveStrip = component.brushSelect && layout.hiX > layout.loX;
        layout.bandH = layout.h + (layout.moveStrip ? app.Scale(7) : 0);
        layout.minGap = 1000 / (n - 1);
        if (layout.minGap < 20) { layout.minGap = 20; }
        if (component.minSpan * 10 > layout.minGap) { layout.minGap = component.minSpan * 10; }
        int valueGap = component.minValueSpan * 1000 / (n - 1);
        if (valueGap > layout.minGap) { layout.minGap = valueGap; }
        if (layout.minGap > 1000) { layout.minGap = 1000; }
        return layout;
    }
}

// Chart.Keys.zan - 交互状态键（*Key(wid) 作用域 IdHash 派生：图例/dataZoom/树图/地图/工具箱/联动）

public partial class Chart {
    // 交互 id `wid` 下系列 `si` 的图例隐藏状态键（基于作用域 Hash 派生，杜绝全局魔数号段冲突）。
    public static int LegendKey(int wid, int si) { return IdHash.HashInt(si, IdHash.HashInt(wid, 101)); }
    // dataRange 交互态：calculable 滑条两端（0..1000 量化，同
    // zoom 条约定）与 splitList 分段隐藏位（1 = 该段被点掉）。
    public static int DRangeLoKey(int wid) { return IdHash.HashInt(wid, 106); }
    // dataRange calculable 滑条上界状态键（千分值 0..1000）。
    public static int DRangeHiKey(int wid) { return IdHash.HashInt(wid, 107); }
    // splitList 第 bi 段的隐藏位键（1 = 该段被点掉）。
    public static int DRangeBandKey(int wid, int bi) { return IdHash.HashInt(bi, IdHash.HashInt(wid, 108)); }
    // dataRange.hoverLink：指针悬停在 dataRange 条上时该图的高亮键
    // （0 = 无；1 = 悬停中，消费方把接近值域的区域/点描边强调）。
    public static int DRangeHoverKey(int wid) { return IdHash.HashInt(wid, 109); }

    // 饼/漏斗/玫瑰扇区、和弦/力导节点：按 (系列, 数据项) 持久化隐藏（作用域 Hash 派生）。
    public static int LegendSliceKey(int wid, int si, int di) {
        return IdHash.HashInt(di, IdHash.HashInt(si, IdHash.HashInt(wid, 102)));
    }
    // 饼扇区静态选中位（点击扇区切换 data.selected 的持久键，作用域 Hash 派生）。
    public static int PieSelKey(int wid, int si, int di) {
        return IdHash.HashInt(di, IdHash.HashInt(si, IdHash.HashInt(wid, 103)));
    }

    // dataZoom 窗口状态键（分类范围的千分值 0..1000，作用域 Hash 派生）。
    public static int ZoomLoKey(int wid) { return IdHash.HashInt(wid, 104); }
    // dataZoom 窗口上界状态键（千分值 0..1000，配对 ZoomLoKey）。
    public static int ZoomHiKey(int wid) { return IdHash.HashInt(wid, 105); }
    // 树图视口平移 X（像素；世界原点相对视口的偏移，作用域 Hash 派生）。
    public static int TreePanXKey(int wid) { return IdHash.HashInt(wid, 110); }
    // 树图视口平移 Y（像素）。
    public static int TreePanYKey(int wid) { return IdHash.HashInt(wid, 111); }
    // 树图拖拽中最近一次指针 X。
    public static int TreeDragXKey(int wid) { return IdHash.HashInt(wid, 112); }
    // 树图拖拽中最近一次指针 Y。
    public static int TreeDragYKey(int wid) { return IdHash.HashInt(wid, 113); }
    // 树图拖拽按下瞬间的视口平移 X 快照（拖拽期间平移 = 快照 - 位移）。
    public static int TreeDragPanXKey(int wid) { return IdHash.HashInt(wid, 114); }
    // 树图拖拽按下瞬间的视口平移 Y 快照。
    public static int TreeDragPanYKey(int wid) { return IdHash.HashInt(wid, 115); }
    // 树图拖拽进行中标志（1 = 按下未释放；释放帧清零）。
    public static int TreeDraggingKey(int wid) { return IdHash.HashInt(wid, 116); }
    // 树图本次拖拽是否实际移动过（1 = 移动过；释放时吞掉 click）。
    public static int TreeDragMovedKey(int wid) { return IdHash.HashInt(wid, 117); }
    // 树缩放，为自然节点间距的百分比。0 表示尚未适配：
    // 首帧（或工具箱「还原」）把整棵树放进视口中心，之后镜头
    // 就是无限画布——平移不夹紧、缩放不因窗口尺寸变化而重置。
    public static int TreeZoomKey(int wid) { return IdHash.HashInt(wid, 7); }

    // 快照槽位的 RenderCache 指纹键（见 ChartView.RenderCached）。
    public static int CacheKey(int slot) { return IdHash.HashInt(slot, 900); }

    // toolbox / 地图漫游 / 选中（通过 HashInt 独立隔离）。
    // 数据视图覆盖层开关（1 = 打开，由工具箱「数据视图」切换）。
    public static int TbViewKey(int wid) { return IdHash.HashInt(wid, 80); }
    // 魔法类型切换状态（1 = 切为折线，2 = 切为柱状，0 = 关）。
    public static int TbMagicKey(int wid) { return IdHash.HashInt(wid, 81); }
    // 区域缩放工具开关（1 = 开）。
    public static int TbZoomKey(int wid) { return IdHash.HashInt(wid, 82); }
    // 地图漫游缩放（百分比 40..280；读到的值 < 40 视为未初始化，
    // 重置为 100）。
    public static int MapZoomKey(int wid) { return IdHash.HashInt(wid, 83); }
    // 地图漫游平移 X（像素）。
    public static int MapPanXKey(int wid) { return IdHash.HashInt(wid, 84); }
    // 地图漫游平移 Y（像素）。
    public static int MapPanYKey(int wid) { return IdHash.HashInt(wid, 85); }
    // 地图单选（selectedMode ""/"single"）选中区域下标（-1 = 无）。
    public static int MapSelKey(int wid) { return IdHash.HashInt(wid, 86); }
    // selectedMode="multiple"：按区域持久化选中位。
    public static int MapRegionSelKey(int wid, int region) {
        return IdHash.HashInt(wid, 2048 + region);
    }
    // 地图拖拽进行中标志（1 = 按下未释放；释放帧清零，作用域 Hash 派生）。
    public static int MapDragKey(int wid) { return IdHash.HashInt(wid, 118); }
    // 地图拖拽中最近一次指针 X。
    public static int MapDragXKey(int wid) { return IdHash.HashInt(wid, 119); }
    // 地图拖拽中最近一次指针 Y。
    public static int MapDragYKey(int wid) { return IdHash.HashInt(wid, 120); }
    // 地图拖拽按下瞬间的平移 X 快照。
    public static int MapDragPanXKey(int wid) { return IdHash.HashInt(wid, 121); }
    // 地图拖拽按下瞬间的平移 Y 快照。
    public static int MapDragPanYKey(int wid) { return IdHash.HashInt(wid, 122); }

    // ---- connect() 多图联动（ECharts connect：同组图表共享交互态）----
    // 组号由调用方声明（ConnectGroup()），组内所有图表把交互态键
    // 重定向到「组长」的 wid 上（同组第一张图），于是任何一张图里
    // 的 dataZoom 窗口 / 图例开关 / 十字线悬停类别，组内其余图同帧
    // 生效——基于作用域 Hash 派生，彻底消灭魔数号段。
    // 组登记键：同组第一张到达 Resolve 的图把自己的 wid（组长）
    // 写进这里，其余图读它得到共享键基址；读到 0 = 尚未登记。
    public static int ConnectGroupKey(int wid) { return IdHash.HashInt(wid, 124); }
    // connect 组共享的「悬停类别下标」状态键（读写都落在组长
    // wid 上）：组内图指针在绘图区内时写入自己的类别下标，
    // 其余图同帧读它对齐十字线；组长登记时初始化为 -1（无悬停）。
    public static int ConnectHoverKey(int wid) { return IdHash.HashInt(wid, 125); }

}
