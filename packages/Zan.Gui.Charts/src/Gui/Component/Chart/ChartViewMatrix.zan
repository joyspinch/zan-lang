using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

/// 矩阵坐标系（ECharts6 coord/matrix）的几何与取色域——核心层与
/// 悬停层共用的一次推导结果：盒矩形、单位分割（头带 + 叶列/叶行）、
/// 色带、值域、piecewise 桶数。
/// 官方布局（Matrix.js layOutUnitsOnDimension）：沿 x 向先铺 y 树的
/// 层级头带（左缘竖条），再铺 x 树的叶列；沿 y 向先铺 x 树的层级
/// 头带（顶缘横条），再铺 y 树的叶行。声明 levelSize/size 的单位先
/// 占尺寸（隐藏维的头带占 0），剩余空间**等分**给未声明单位（头带
/// 与体格同厚），末单元贴齐盒缘。角区（两棵树头带的交叠）无格线。
class MatGeom {
    int rx; int ry; int rw; int rh;  // 矩阵盒（含头带与角区）
    int xBands; int yBands;  // x 树层级数（顶横带）/ y 树层级数（左竖带）
    int xLeaves; int yLeaves;  // 叶列 / 叶行数
    int unitsX; int unitsY;  // x 向 = yBands + xLeaves；y 向 = xBands + yLeaves
    List<int> xStarts;  // x 向单位边界（unitsX+1 项，绝对 px）
    List<int> yStarts;  // y 向单位边界（unitsY+1 项，绝对 px）
    int bodyL; int bodyT;  // 体区左/上缘（头带结束处）
    int panelX; int panelY;  // 图表面板矩形（图例浮层锚定用）
    int panelW; int panelH;
    List<int> ramp;  // 取色带；<2 色时调用方回退系列色
    double dLo; double dHi;  // 值域：visualMap 声明优先，缺省数据包络
    int split;  // piecewise 等分桶数；0 = 连续

    static MatGeom Of() {
        MatGeom geo = new MatGeom();
        geo.rx = 0; geo.ry = 0; geo.rw = 0; geo.rh = 0;
        geo.xBands = 0; geo.yBands = 0;
        geo.xLeaves = 0; geo.yLeaves = 0;
        geo.unitsX = 0; geo.unitsY = 0;
        geo.xStarts = new List<int>();
        geo.yStarts = new List<int>();
        geo.bodyL = 0; geo.bodyT = 0;
        geo.panelX = 0; geo.panelY = 0;
        geo.panelW = 0; geo.panelH = 0;
        geo.ramp = null;
        geo.dLo = 0.0; geo.dHi = 1.0;
        geo.split = 0;
        return geo;
    }
}

partial class ChartView {

    // ---- 矩阵坐标系车道：维度树头带 + 叶子体格骨架；heatmap 按
    // [x名, y名, 值] 落格上色，pie 按 center 格名落格心，graph 节点
    // 落格心连线。与直角热力图车道共用色带原语 MatColorAt 与帧内
    // 快照缓存定式。----

    /// 盒布局单边：数值 px / "N%"（ParseBoxParam 两种 kind），缺省
    /// 盒尺寸的 10%（官方 MatrixModel.defaultOption 四边 '10%'）。
    static int MatSide(ChartBoxParam p, int full, int dfltPct) {
        if (p == null || p.kind == 0) { return full * dfltPct / 100; }
        if (p.kind == 1) { return (int)(p.num + 0.5); }
        if (p.kind == 2) { return (int)((double)full * p.num / 100.0 + 0.5); }
        return full * dfltPct / 100;
    }

    /// 单向的单位尺寸序列：头带（levelSize 声明；隐藏维 = 0）在前、
    /// 叶（逐格 size 声明）在后，声明过的先占尺寸，剩余均分给未声
    /// 明单位（官方 restSize/restCellsCount）。total = 该向盒尺寸
    /// （百分比声明的基准，官方 parseSizeOption 同源）。
    static List<double> MatUnitSizes(int bandCount, bool bandShow,
                                     ChartBoxParam levelSize,
                                     int leafCount, List<ChartBoxParam> sizes,
                                     int total) {
        List<double> ws = new List<double>();
        double rest = (double)total;
        int restCount = 0;
        for (int k = 0; k < bandCount; k = k + 1) {
            double wh = 0.0 - 1.0;
            if (!bandShow) {
                wh = 0.0;
            } else if (levelSize != null && levelSize.kind == 1) {
                wh = levelSize.num;
            } else if (levelSize != null && levelSize.kind == 2) {
                wh = (double)total * levelSize.num / 100.0;
            }
            if (wh >= 0.0) {
                if (wh > rest) { wh = rest; }
                ws.Add(wh);
                rest = rest - wh;
            } else {
                ws.Add(0.0 - 1.0);
                restCount = restCount + 1;
            }
        }
        for (int j = 0; j < leafCount; j = j + 1) {
            ChartBoxParam sz = j < sizes.Count ? sizes[j] : null;
            double wh = 0.0 - 1.0;
            if (sz != null && sz.kind == 1) { wh = sz.num; }
            else if (sz != null && sz.kind == 2) {
                wh = (double)total * sz.num / 100.0;
            }
            if (wh >= 0.0) {
                if (wh > rest) { wh = rest; }
                ws.Add(wh);
                rest = rest - wh;
            } else {
                ws.Add(0.0 - 1.0);
                restCount = restCount + 1;
            }
        }
        double share = restCount > 0 ? rest / (double)restCount : 0.0;
        for (int k2 = 0; k2 < ws.Count; k2 = k2 + 1) {
            if (ws[k2] < 0.0) { ws[k2] = share; }
        }
        return ws;
    }

    /// 单位尺寸 → 绝对边界（n+1 项）：双精度累计、逐界取整；末界
    /// 即盒缘（末单元天然贴齐），边界保证单调不减（极小单元取整
    /// 后不回退）。
    static List<int> MatStartsOf(int origin, int total, List<double> ws) {
        List<int> starts = new List<int>();
        double cur = (double)origin;
        int n = ws.Count;
        for (int k = 0; k < n; k = k + 1) {
            starts.Add((int)(cur + 0.5));
            cur = cur + ws[k];
        }
        starts.Add(origin + total);
        for (int k2 = 1; k2 < starts.Count; k2 = k2 + 1) {
            if (starts[k2] < starts[k2 - 1]) { starts[k2] = starts[k2 - 1]; }
        }
        return starts;
    }

    /// x/y 向第 k 单元的边界（k ∈ [0, units]）。
    static int MatXAt(MatGeom geo, int k) {
        if (k < 0) { k = 0; }
        if (k > geo.unitsX) { k = geo.unitsX; }
        return geo.xStarts[k];
    }

    static int MatYAt(MatGeom geo, int k) {
        if (k < 0) { k = 0; }
        if (k > geo.unitsY) { k = geo.unitsY; }
        return geo.yStarts[k];
    }

    /// x 维格（叶或组）的屏幕矩形：列域 = 头带之后的叶子域；行域 =
    /// 叶格延伸到体区上沿（官方叶的跨带 = levels - level，恰好到体
    /// 区边界），组格只占本层头带。
    static void MatXCellRect(MatGeom geo, ChartMatrixSpec m, int ci,
                             out int cx, out int cy, out int cw, out int ch) {
        ChartMatrixBandNode node = m.xNodes[ci];
        int col0 = geo.yBands + node.first;
        cx = ChartView.MatXAt(geo, col0);
        cw = ChartView.MatXAt(geo, col0 + node.span) - cx;
        cy = ChartView.MatYAt(geo, node.level);
        int cy2 = node.kind == 0
            ? geo.bodyT
            : ChartView.MatYAt(geo, node.level + 1);
        ch = cy2 - cy;
    }

    /// y 维格（叶或组）的屏幕矩形：行域 = 头带之后的叶子域；列域
    /// 与 x 维对称。
    static void MatYCellRect(MatGeom geo, ChartMatrixSpec m, int ri,
                             out int cx, out int cy, out int cw, out int ch) {
        ChartMatrixBandNode node = m.yNodes[ri];
        int row0 = geo.xBands + node.first;
        cy = ChartView.MatYAt(geo, row0);
        ch = ChartView.MatYAt(geo, row0 + node.span) - cy;
        cx = ChartView.MatXAt(geo, node.level);
        int cx2 = node.kind == 0
            ? geo.bodyL
            : ChartView.MatXAt(geo, node.level + 1);
        cw = cx2 - cx;
    }

    /// 体格 (i,j) 的屏幕矩形：x 第 i 叶列 × y 第 j 叶行。
    static void MatBodyRect(MatGeom geo, int i, int j, out int bx, out int by,
                            out int bw, out int bh) {
        bx = ChartView.MatXAt(geo, geo.yBands + i);
        bw = ChartView.MatXAt(geo, geo.yBands + i + 1) - bx;
        by = ChartView.MatYAt(geo, geo.xBands + j);
        bh = ChartView.MatYAt(geo, geo.xBands + j + 1) - by;
    }

    /// 布局：盒矩形（px/"N%"，缺省四边 10%）+ 单位分割（含声明尺
    /// 寸）+ 取色域。值包络由调用方扫好传入（核心层与指纹合同一趟，
    /// 悬停层走 HeatFactsScan 兜底）。数据不成盒（rw/rh 过小）返回
    /// null。
    static MatGeom MatLayout(App app, int x, int y, int w, int h, int top,
                             ChartOption o, double eLo, double eHi) {
        ChartMatrixSpec m = o.matrix;
        if (m == null) { return null; }
        MatGeom geo = MatGeom.Of();
        int ph = (y + h) - top;
        geo.panelX = x;
        geo.panelY = y;
        geo.panelW = w;
        geo.panelH = h;
        int l = ChartView.MatSide(m.lRaw, w, 10);
        int r = ChartView.MatSide(m.rRaw, w, 10);
        int tt = ChartView.MatSide(m.tRaw, ph, 10);
        int bb = ChartView.MatSide(m.bRaw, ph, 10);
        geo.rx = x + l;
        geo.ry = top + tt;
        geo.rw = w - l - r;
        geo.rh = ph - tt - bb;
        // width/height 声明覆盖对面边推导；left "center" / top
        // "middle" 随声明生效（官方 parseSizeOption：width 百分比对
        // 容器宽，center = 居中安放）。
        if (m.wRaw != null && m.wRaw.kind == 1) {
            geo.rw = (int)(m.wRaw.num + 0.5);
            if (m.leftCenter) { geo.rx = x + (w - geo.rw) / 2; }
        } else if (m.wRaw != null && m.wRaw.kind == 2) {
            geo.rw = (int)((double)w * m.wRaw.num / 100.0 + 0.5);
            if (m.leftCenter) { geo.rx = x + (w - geo.rw) / 2; }
        }
        if (m.hRaw != null && m.hRaw.kind == 1) {
            geo.rh = (int)(m.hRaw.num + 0.5);
            if (m.topMiddle) { geo.ry = top + (ph - geo.rh) / 2; }
        } else if (m.hRaw != null && m.hRaw.kind == 2) {
            geo.rh = (int)((double)ph * m.hRaw.num / 100.0 + 0.5);
            if (m.topMiddle) { geo.ry = top + (ph - geo.rh) / 2; }
        }
        if (geo.rw < 8 || geo.rh < 8) { return null; }
        geo.xBands = m.xLevels;
        geo.yBands = m.yLevels;
        geo.xLeaves = m.xLeaves;
        geo.yLeaves = m.yLeaves;
        geo.unitsX = geo.yBands + geo.xLeaves;
        geo.unitsY = geo.xBands + geo.yLeaves;
        // x 向：y 树层带（levelSize；y.show false = 0）+ x 叶列（size）。
        geo.xStarts = ChartView.MatStartsOf(geo.rx, geo.rw,
            ChartView.MatUnitSizes(geo.yBands, m.yShow, m.yLevelSize,
                geo.xLeaves, m.XSizes(), geo.rw));
        // y 向：x 树层带 + y 叶行。
        geo.yStarts = ChartView.MatStartsOf(geo.ry, geo.rh,
            ChartView.MatUnitSizes(geo.xBands, m.xShow, m.xLevelSize,
                geo.yLeaves, m.YSizes(), geo.rh));
        geo.bodyL = ChartView.MatXAt(geo, geo.yBands);
        geo.bodyT = ChartView.MatYAt(geo, geo.xBands);
        // 取色带与值域：与直角热力图车道同源（全局 rampColors 优先，
        // 否则第一条 visualMap 的 rangeColors——continuous 缺省带在
        // 解析期已填、piecewise 的 inRange.color 也在这里；声明过
        // min/max 用原始值，否则数据包络）。
        ChartVisualMap vm = o.visualMaps.Count > 0 ? o.visualMaps[0] : null;
        geo.ramp = o.rampColors;
        if (vm != null) {
            if (geo.ramp == null || geo.ramp.Count < 2) {
                geo.ramp = vm.rangeColors;
            }
            if (vm.type == 1) {
                geo.split = vm.splitNumber > 0 ? vm.splitNumber : 5;
            }
        }
        geo.dLo = eLo;
        geo.dHi = eHi;
        if (vm != null) {
            if (vm.hasMin && vm.minRaw != ChartOption.Auto()) {
                geo.dLo = (double)vm.minRaw;
            }
            if (vm.hasMax && vm.maxRaw != ChartOption.Auto()) {
                geo.dHi = (double)vm.maxRaw;
            }
        }
        if (geo.dHi - geo.dLo < 0.000001) { geo.dHi = geo.dLo + 1.0; }
        return geo;
    }

    /// 规格文本指纹折叠（字符串逐字符 31 折，与整体指纹同一模）。
    static int MatTextFold(int f, string s) {
        for (int i = 0; i < s.Length; i = i + 1) {
            f = (f * 31 + s[i]) % 2000000000;
        }
        return f;
    }

    /// 多行文本块居中绘制：按 \n 分行，行距 = 字号 + 3px 设计值；
    /// 块整体在 (x,y,w,h) 内水平垂直居中（矩阵头带/体区/角区文本
    /// 共用——官方 sparkline 的 "8:00\n~\n10:00" 三行标签）。
    static void MatDrawLinesCentered(Canvas c, int x, int y, int w, int h,
                                     string text, int col, int font, App app) {
        if (text == null || text.Length < 1 || w < 1 || h < 1) { return; }
        int lineH = font + app.Scale(3);
        int lines = 1;
        for (int ci = 0; ci < text.Length; ci = ci + 1) {
            if (text[ci] == '\n') { lines = lines + 1; }
        }
        int blockH = lines * lineH;
        int curY = y + (h - blockH) / 2;
        int lineStart = 0;
        int textLen = text.Length;
        for (int ci = 0; ci <= textLen; ci = ci + 1) {
            if (ci == textLen || text[ci] == '\n') {
                if (ci > lineStart) {
                    string line = text.Substring(lineStart, ci - lineStart);
                    int lw = c.MeasureText(line, font);
                    c.DrawText(x + (w - lw) / 2, curY, line, col, font);
                }
                curY = curY + lineH;
                lineStart = ci + 1;
            }
        }
    }

    /// 盒单边声明的指纹折叠（kind 区分 px/%，num ×100 保两位小数）。
    static int MatBoxFold(ChartBoxParam p) {
        if (p == null) { return 0; }
        return p.kind * 17 + (int)(p.num * 100.0);
    }

    /// 矩阵坐标系主体入口：先画骨架 + 系列内容（可整块快照缓存），
    /// 再由调用方画悬停覆盖层。指纹覆盖全部取像素输入：几何/缩放、
    /// 规格树形与文本、盒与尺寸声明、body 合并格、逐格数据、系列
    /// hidden/label/锚定位、色带与值域、主题色。g<1000（入场渐显
    /// 探针）不缓存。
    static void DrawMatrix(App app, int x, int y, int w, int h,
                           ChartOption o, int g) {
        ChartMatrixSpec m = o.matrix;
        if (m == null || m.xLeaves < 1 || m.yLeaves < 1
            || m.xLevels < 1 || m.yLevels < 1) { return; }
        Canvas c = app.canvas;
        int top = ChartView.PanelHead(app, x, y, w, h, o.title);
        // 一趟指纹 + 值包络。缓存命中帧只付这一趟，格线/文本/填色
        // 从快照恢复（covariance 族 625 格逐帧重画同样是无响应根因）。
        int f = o.iwid % 1000003;
        f = (f * 31 + x) % 2000000000;
        f = (f * 31 + y) % 2000000000;
        f = (f * 31 + w) % 2000000000;
        f = (f * 31 + h) % 2000000000;
        f = (f * 31 + app.Scale(100)) % 2000000000;
        // 规格：盒 + 尺寸/隐藏声明 + 两棵树 + body 合并格。
        f = (f * 31 + ChartView.MatBoxFold(m.lRaw)
            + ChartView.MatBoxFold(m.tRaw) * 3
            + ChartView.MatBoxFold(m.rRaw) * 7
            + ChartView.MatBoxFold(m.bRaw) * 11) % 2000000000;
        f = (f * 31 + (m.xShow ? 1 : 0) + (m.yShow ? 2 : 0)
            + ChartView.MatBoxFold(m.xLevelSize) * 13
            + ChartView.MatBoxFold(m.yLevelSize) * 17) % 2000000000;
        f = (f * 31 + ChartView.MatBoxFold(m.wRaw)
            + ChartView.MatBoxFold(m.hRaw) * 3
            + (m.leftCenter ? 5 : 0) + (m.topMiddle ? 7 : 0)) % 2000000000;
        f = (f * 31 + m.xLabelFontSize + m.yLabelFontSize * 3
            + m.xLabelColor + m.yLabelColor * 7
            + (m.xLabelBold ? 11 : 0) + (m.yLabelBold ? 13 : 0)) % 2000000000;
        for (int ct = 0; ct < m.cornerText.Count; ct = ct + 1) {
            f = ChartView.MatTextFold(f, m.cornerText[ct]);
        }
        f = (f * 31 + m.xItemColor + m.yItemColor * 3
            + (m.bodyBorder ? 5 : 0)) % 2000000000;
        for (int i = 0; i < m.xNodes.Count; i = i + 1) {
            ChartMatrixBandNode xn = m.xNodes[i];
            f = (f * 31 + xn.level * 5 + xn.first * 13
                + xn.span * 29) % 2000000000;
            f = (f * 31 + ChartView.MatBoxFold(xn.size)) % 2000000000;
            f = ChartView.MatTextFold(f, xn.text);
        }
        for (int j = 0; j < m.yNodes.Count; j = j + 1) {
            ChartMatrixBandNode yn = m.yNodes[j];
            f = (f * 31 + yn.level * 5 + yn.first * 13
                + yn.span * 29) % 2000000000;
            f = (f * 31 + ChartView.MatBoxFold(yn.size)) % 2000000000;
            f = ChartView.MatTextFold(f, yn.text);
        }
        for (int bi = 0; bi < m.bodyCells.Count; bi = bi + 1) {
            ChartMatrixBodyCell bc = m.bodyCells[bi];
            f = (f * 31 + bc.x0 * 7 + bc.x1 * 11
                + bc.y0 * 13 + bc.y1 * 17) % 2000000000;
            f = (f * 31 + bc.labelColor
                + bc.labelFontSize * 3) % 2000000000;
            f = ChartView.MatTextFold(f, bc.text);
        }
        double eLo = 0.0;
        double eHi = 0.0;
        bool seen = false;
        for (int si = 0; si < o.series.Count; si = si + 1) {
            ChartSeries s = o.series[si];
            f = (f * 31 + (s.hidden ? 1 : 0)
                + (s.labelShowT == 1 ? 2 : 0)) % 2000000000;
            f = (f * 31 + s.symbolSize + (s.color != 0 ? s.color : 0)
                + s.itemStyle.normal.lineStyle.color
                + s.itemStyle.normal.lineStyle.width * 3) % 2000000000;
            f = (f * 31 + (s.radius == null ? 0
                : s.radius.amount * (s.radius.percent ? 13 : 17))
                + s.startAngle) % 2000000000;
            f = ChartView.MatTextFold(f, s.matCX);
            f = ChartView.MatTextFold(f, s.matCY);
            if (s.hidden) { continue; }
            for (int di = 0; di < s.data.Count; di = di + 1) {
                ChartData d = s.data[di];
                if (d.heatX < 0 || d.heatY < 0 || d.gap) { continue; }
                f = (f * 31 + d.heatX * 7 + d.heatY * 13
                    + (int)(d.number * 1000.0) * 29) % 2000000000;
                f = ChartView.MatTextFold(f, d.labelText);
                if (!seen) { eLo = d.number; eHi = d.number; seen = true; }
                else {
                    if (d.number < eLo) { eLo = d.number; }
                    if (d.number > eHi) { eHi = d.number; }
                }
            }
        }
        // 取像素的声明输入：色带（全局与 visualMap 两路）、分片数、
        // 值域、主题色——主题切换/图例开关都要能踢掉快照。
        if (o.rampColors != null) {
            for (int i = 0; i < o.rampColors.Count; i = i + 1) {
                f = (f * 31 + o.rampColors[i]) % 2000000000;
            }
        }
        if (o.visualMaps.Count > 0) {
            ChartVisualMap vm = o.visualMaps[0];
            f = (f * 31 + vm.type * 3 + vm.splitNumber * 5
                + vm.minRaw * 7 + vm.maxRaw * 11
                + (vm.hasMin ? 1 : 0) + (vm.hasMax ? 2 : 0)) % 2000000000;
            for (int i = 0; i < vm.rangeColors.Count; i = i + 1) {
                f = (f * 31 + vm.rangeColors[i]) % 2000000000;
            }
        }
        f = (f * 31 + Style.Part(app, "chart", "axis", "", "", "",
            Style.SNormal()).FgOr(0)) % 2000000000;
        f = (f * 31 + Style.Part(app, "chart", "cell", "", "", "",
            Style.SNormal()).BorderOr(0)) % 2000000000;
        f = (f * 31 + Style.Full(app, "chart", "", "", Style.SNormal()).BgOr(0)) % 2000000000;
        int slot = 270 + ((o.iwid % 20) + 20) % 20;
        bool cached = g >= 1000
            && app.StateGet(Chart.CacheKey(slot), 0) == f
            && c.RestoreRect(x, top, w, (y + h) - top, slot);
        c.PushClip(x, top, w, (y + h) - top);
        if (!cached) {
            MatGeom geo = ChartView.MatLayout(app, x, y, w, h, top, o,
                eLo, eHi);
            if (geo != null) {
                ChartView.MatMemoStore(app, o, x, y, w, h, geo);
                ChartView.DrawMatrixBody(app, o, m, geo, g);
                c.SnapshotRect(x, top, w, (y + h) - top, slot);
                app.StateSet(Chart.CacheKey(slot), f);
            }
        }
        c.PopClip();
    }

    /// 矩阵骨架 + 系列内容（快照 miss 帧执行一次）。绘制序：头带
    /// 填充（x/y.itemStyle.color）→ 系列填色 → 体区格网与头带格线
    /// （官方 cell borderWidth 1 borderTint 压在填色上）→ body 合并
    /// 格文本 → 头带标签 → pie/graph 落格 → 背景描边（
    /// backgroundStyle borderColor axisLine）。角区无边框（官方
    /// corner borderColor 'none'）。
    static void DrawMatrixBody(App app, ChartOption o, ChartMatrixSpec m,
                               MatGeom geo, int g) {
        Canvas c = app.canvas;
        int axisFont = ChartFonts.AxisLabel(app);
        int axisC = Style.Part(app, "chart", "axis", "", "", "",
            Style.SNormal()).FgOr(0);
        int gridC = Style.Part(app, "chart", "cell", "", "", "",
            Style.SNormal()).BorderOr(0);
        int labelFg = Style.Part(app, "chart", "label", "", "", "",
            Style.SNormal()).FgOr(0);

        // 头带填充（x/y.itemStyle.color 声明才画；官方缺省 'none'）。
        if (m.xItemColor != 0) {
            for (int i = 0; i < m.xNodes.Count; i = i + 1) {
                int cx;
                int cy;
                int cw;
                int ch;
                ChartView.MatXCellRect(geo, m, i, out cx, out cy, out cw, out ch);
                if (cw > 0 && ch > 0) { c.FillRect(cx, cy, cw, ch, m.xItemColor); }
            }
        }
        if (m.yItemColor != 0) {
            for (int j = 0; j < m.yNodes.Count; j = j + 1) {
                int cx;
                int cy;
                int cw;
                int ch;
                ChartView.MatYCellRect(geo, m, j, out cx, out cy, out cw, out ch);
                if (cw > 0 && ch > 0) { c.FillRect(cx, cy, cw, ch, m.yItemColor); }
            }
        }

        // 系列填色：heatmap 系列按格域上色（组名格 = 合并域整填）。
        // 无色带时回退系列色。逐格数值标签（series.label.show）在
        // 格子放得下时才画。
        bool useRamp = geo.ramp != null && geo.ramp.Count >= 2;
        for (int si = 0; si < o.series.Count; si = si + 1) {
            ChartSeries s = o.series[si];
            if (s.hidden || s.type != ChartType.Heatmap) { continue; }
            for (int di = 0; di < s.data.Count; di = di + 1) {
                ChartData d = s.data[di];
                if (d.heatX < 0 || d.heatY < 0 || d.gap) { continue; }
                if (d.heatX >= m.xNodes.Count || d.heatY >= m.yNodes.Count) {
                    continue;
                }
                int cx;
                int cy;
                int cw;
                int ch;
                ChartView.MatXCellRect(geo, m, d.heatX, out cx, out cy,
                    out cw, out ch);
                int px;
                int py;
                int pw;
                int ph2;
                ChartView.MatYCellRect(geo, m, d.heatY, out px, out py,
                    out pw, out ph2);
                if (cw < 1 || ch < 1 || pw < 1 || ph2 < 1) { continue; }
                int col = useRamp
                    ? ChartView.MatColorAt(geo.ramp, geo.dLo, geo.dHi,
                        geo.split, d.number, g)
                    : s.color;
                // 填色域 = x 格的列域 × y 格的行域（组名格即合并域）。
                c.FillRect(cx, py, cw, ph2, col);
                if (s.labelShowT == 1 && cw >= app.Scale(18)
                    && ph2 >= app.Scale(12)) {
                    // 官方 body label overflow:'break' 折行；单行绘制
                    // 用逐格裁剪兜住溢出（长小数串不许压到邻格）。
                    c.PushClip(cx, py, cw, ph2);
                    c.DrawTextCentered(cx, py, cw, ph2,
                        ChartView.HeatmapGridNumText(d.number),
                        labelFg, ChartFonts.SeriesLabel(app));
                    c.PopClip();
                }
            }
        }

        // 体区格网：叶列/叶行界线（官方 body cell borderWidth 1）。
        // body.itemStyle.borderColor 'none' → 整张体区格网一起去掉
        // （matrix-grid-layout 承载子图，格线压在子图上）。
        if (m.bodyBorder) {
            for (int k = geo.yBands + 1; k < geo.unitsX; k = k + 1) {
                int lx = ChartView.MatXAt(geo, k);
                c.FillRect(lx, geo.bodyT, 1, (geo.ry + geo.rh) - geo.bodyT, gridC);
            }
            for (int l = geo.xBands + 1; l < geo.unitsY; l = l + 1) {
                int ly = ChartView.MatYAt(geo, l);
                c.FillRect(geo.bodyL, ly, (geo.rx + geo.rw) - geo.bodyL, 1, gridC);
            }
            // 体区左/上边界线（头带与体格的分界）。
            c.FillRect(geo.bodyL, geo.bodyT, 1, (geo.ry + geo.rh) - geo.bodyT, gridC);
            c.FillRect(geo.bodyL, geo.bodyT, (geo.rx + geo.rw) - geo.bodyL, 1, gridC);
        }

        // x 头带：叶列竖线只落在叶子自己的带行（末带）到体缘——
        // 官方逐格描边：叶格跨带到体缘，组格只占本带行（组带行内
        // 没有组内竖线，组界由组格描边补）。单层树退化为原样。
        int xLeafTop = ChartView.MatYAt(geo, geo.xBands - 1);
        for (int k = geo.yBands + 1; k < geo.unitsX; k = k + 1) {
            int lx = ChartView.MatXAt(geo, k);
            c.FillRect(lx, xLeafTop, 1, geo.bodyT - xLeafTop, gridC);
        }
        for (int i = 0; i < m.xNodes.Count; i = i + 1) {
            if (m.xNodes[i].level >= geo.xBands - 1) { continue; }
            int gx;
            int gy;
            int gw;
            int gh;
            ChartView.MatXCellRect(geo, m, i, out gx, out gy, out gw, out gh);
            c.DrawRect(gx, gy, gw, gh, gridC, 1);
        }
        if (m.xShow) {
            for (int l = 1; l < geo.xBands; l = l + 1) {
                int ly = ChartView.MatYAt(geo, l);
                c.FillRect(geo.bodyL, ly, (geo.rx + geo.rw) - geo.bodyL, 1, gridC);
            }
        }
        // y 头带：与 x 对称（叶行横线只在末带到体缘，组格描边补界）。
        int yLeafLeft = ChartView.MatXAt(geo, geo.yBands - 1);
        for (int l = geo.xBands + 1; l < geo.unitsY; l = l + 1) {
            int ly = ChartView.MatYAt(geo, l);
            c.FillRect(yLeafLeft, ly, geo.bodyL - yLeafLeft, 1, gridC);
        }
        for (int j = 0; j < m.yNodes.Count; j = j + 1) {
            if (m.yNodes[j].level >= geo.yBands - 1) { continue; }
            int gx;
            int gy;
            int gw;
            int gh;
            ChartView.MatYCellRect(geo, m, j, out gx, out gy, out gw, out gh);
            c.DrawRect(gx, gy, gw, gh, gridC, 1);
        }
        if (m.yShow) {
            for (int k = 1; k < geo.yBands; k = k + 1) {
                int lx = ChartView.MatXAt(geo, k);
                c.FillRect(lx, geo.bodyT, 1, (geo.ry + geo.rh) - geo.bodyT, gridC);
            }
        }

        // body.data 合并格文本（mini-bar-geo 的州名列表；coord 已在
        // 解析期归一成叶子域）。有边声明（缺省有）时描合并域边。
        for (int bi = 0; bi < m.bodyCells.Count; bi = bi + 1) {
            ChartMatrixBodyCell bc = m.bodyCells[bi];
            if (bc.text.Length < 1) { continue; }
            if (bc.x0 < 0 || bc.y0 < 0
                || bc.x1 >= m.xLeaves || bc.y1 >= m.yLeaves) {
                continue;
            }
            int bx = ChartView.MatXAt(geo, geo.yBands + bc.x0);
            int bx2 = ChartView.MatXAt(geo, geo.yBands + bc.x1 + 1);
            int by = ChartView.MatYAt(geo, geo.xBands + bc.y0);
            int by2 = ChartView.MatYAt(geo, geo.xBands + bc.y1 + 1);
            if (m.bodyBorder) {
                c.DrawRect(bx, by, bx2 - bx, by2 - by, gridC, 1);
            }
            int bcol = bc.labelColor != 0 ? bc.labelColor : axisC;
            int bfont = bc.labelFontSize > 0
                ? bc.labelFontSize : axisFont;
            ChartView.MatDrawLinesCentered(c, bx, by, bx2 - bx, by2 - by,
                bc.text, bcol, bfont, app);
        }

        // 角区文本（sparkline 的 "Time"；coord [-1,-1] = 整角区）。
        for (int ct = 0; ct < m.cornerText.Count; ct = ct + 1) {
            ChartView.MatDrawLinesCentered(c, geo.rx, geo.ry,
                geo.bodyL - geo.rx, geo.bodyT - geo.ry,
                m.cornerText[ct], axisC, axisFont, app);
        }

        // 头带标签：x 树格画在各自头带格（列域 × 带高），y 树格
        // 对称。带高放不下字号时跳过（密集网格靠结构辨识）。
        int xLabFs = m.xLabelFontSize > 0 ? m.xLabelFontSize : axisFont;
        int xLabCol = m.xLabelColor != 0 ? m.xLabelColor : axisC;
        int yLabFs = m.yLabelFontSize > 0 ? m.yLabelFontSize : axisFont;
        int yLabCol = m.yLabelColor != 0 ? m.yLabelColor : axisC;
        int bandH = ChartView.MatYAt(geo, 1) - geo.ry;
        bool xLabOk = m.xShow && bandH >= xLabFs;
        for (int i = 0; i < m.xNodes.Count && xLabOk; i = i + 1) {
            int cx;
            int cy;
            int cw;
            int ch;
            ChartView.MatXCellRect(geo, m, i, out cx, out cy, out cw, out ch);
            if (m.xNodes[i].text.Length > 0 && cw >= app.Scale(14)) {
                ChartView.MatDrawLinesCentered(c, cx, cy, cw, ch, m.xNodes[i].text,
                    xLabCol, xLabFs, app);
            }
        }
        int bandW = ChartView.MatXAt(geo, 1) - geo.rx;
        bool yLabOk = m.yShow && bandW >= yLabFs + app.Scale(2);
        for (int j = 0; j < m.yNodes.Count && yLabOk; j = j + 1) {
            int cx;
            int cy;
            int cw;
            int ch;
            ChartView.MatYCellRect(geo, m, j, out cx, out cy, out cw, out ch);
            if (m.yNodes[j].text.Length > 0 && ch >= app.Scale(10)
                && cw >= app.Scale(14)) {
                ChartView.MatDrawLinesCentered(c, cx, cy, cw, ch, m.yNodes[j].text,
                    yLabCol, yLabFs, app);
            }
        }

        // 系列内容落格：pie（center 格名 → 格心）、graph（节点 = 格
        // 心 + 连线箭头）。压在骨架之上（官方系列 z 高于矩阵 z:-50）。
        ChartView.DrawMatrixPies(app, o, m, geo);
        for (int si = 0; si < o.series.Count; si = si + 1) {
            ChartSeries s = o.series[si];
            if (s.hidden || s.type != ChartType.Force
                || s.coordSys != "matrix") { continue; }
            ChartView.DrawMatrixGraph(app, o, m, geo, s, si);
        }

        // 背景描边（backgroundStyle：borderColor axisLine width 1）。
        c.DrawRect(geo.rx, geo.ry, geo.rw, geo.rh, axisC, 1);

        // 图例浮层（matrix-pie 的 Male/Female 行）：候选 = 落格 pie
        // 系列的数据项名，跨系列同名去重（pie 面板道同法）。图例项
        // 的点击显隐不在此道（矩阵悬停层未接管图例热区，记账）。
        if (o.showLegend) {
            ChartView.MatLegendDraw(app, o, geo);
        }
    }

    /// matrix 车道的 pie 图例：数据项名去重收集 + 底部/顶部浮层锚
    /// 定（LegendFloatTop，pie 面板道同一解析），逐项 DrawLegendChip。
    static void MatLegendDraw(App app, ChartOption o, MatGeom geo) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        bool hasPie = false;
        for (int si = 0; si < o.series.Count; si = si + 1) {
            if (o.series[si].type == ChartType.Pie && !o.series[si].hidden
                && (o.series[si].matCX.Length > 0
                    || o.series[si].matCY.Length > 0)) {
                hasPie = true;
                break;
            }
        }
        if (!hasPie) { return; }
        List<PieLegendItem> cands = new List<PieLegendItem>();
        for (int si = 0; si < o.series.Count; si = si + 1) {
            ChartSeries ps = o.series[si];
            if (ps.type != ChartType.Pie) { continue; }
            for (int di = 0; di < ps.data.Count; di = di + 1) {
                string nmm = PieLayout.SliceName(ps, di);
                if (nmm.Length < 1) { continue; }
                bool dup = false;
                for (int ci = 0; ci < cands.Count; ci = ci + 1) {
                    if (cands[ci].name == nmm) { dup = true; break; }
                }
                if (dup) { continue; }
                if (o.legendData != null && o.legendData.Count > 0) {
                    bool white = false;
                    for (int wl = 0; wl < o.legendData.Count; wl = wl + 1) {
                        if (o.legendData[wl] == nmm) { white = true; break; }
                    }
                    if (!white) { continue; }
                }
                cands.Add(new PieLegendItem(si, di, nmm));
            }
        }
        if (cands.Count < 1) { return; }
        int pad = t.paddingMedium;
        int rowH = Canvas.FontHeight(ChartFonts.Legend(app)) + app.Scale(6);
        int gap = app.Scale(8);
        int lgH = o.legendOrient == "vertical" ? cands.Count * rowH : rowH;
        int yCur = Chart.LegendFloatTop(app, geo.panelY, geo.panelH, lgH, pad);
        int x0 = geo.panelX + pad;
        int maxX = geo.panelX + geo.panelW - pad;
        int xCur = x0;
        if (o.legendOrient != "vertical" && cands.Count > 0) {
            int rowW = 0 - gap;
            for (int ci = 0; ci < cands.Count; ci = ci + 1) {
                rowW = rowW + Chart.LegendChipW(app, cands[ci].name) + gap;
            }
            xCur = Chart.LegendFloatLeft(app, geo.panelX, geo.panelW, rowW,
                pad, x0, maxX);
        }
        for (int ci = 0; ci < cands.Count; ci = ci + 1) {
            PieLegendItem item = cands[ci];
            ChartSeries ps = o.series[item.seriesIndex];
            int di = item.dataIndex;
            int col = PieLayout.SliceColor(t, ps, di,
                PieLayout.SlicePalIndex(o, ps, di, item.seriesIndex * 16 + di));
            string lbl = item.name;
            int cw = Chart.LegendChipW(app, lbl);
            if (o.legendOrient == "vertical") { xCur = x0; }
            if (xCur + cw > maxX) { xCur = x0; yCur = yCur + rowH; }
            Chart.DrawLegendChip(app, xCur, yCur, cw, rowH, col, lbl,
                ps.data[di].hidden, 0);
            if (o.legendOrient == "vertical") { yCur = yCur + rowH; }
            else { xCur = xCur + cw + gap; }
        }
    }

    /// pie-on-matrix：series.center 是格名串（matrix-pie 一格一饼），
    /// 解成格矩形圆心画扇形（官方 dataToPoint = rect center；半径
    /// px 声明直接用，百分比按格短边折算）。label.show false 语料，
    /// 扇区标签暂不画。
    static void DrawMatrixPies(App app, ChartOption o, ChartMatrixSpec m,
                               MatGeom geo) {
        Canvas c = app.canvas;
        for (int si = 0; si < o.series.Count; si = si + 1) {
            ChartSeries s = o.series[si];
            if (s.hidden || s.type != ChartType.Pie) { continue; }
            if (s.matCX.Length < 1 && s.matCY.Length < 1) { continue; }
            int xi = s.matCX.Length > 0
                ? m.FindCell(true, s.matCX) : 0 - 1;
            int yi = s.matCY.Length > 0
                ? m.FindCell(false, s.matCY) : 0 - 1;
            if (xi < 0 || yi < 0) { continue; }
            int cx;
            int cy;
            int cw;
            int ch;
            ChartView.MatXCellRect(geo, m, xi, out cx, out cy, out cw, out ch);
            int px;
            int py;
            int pw;
            int ph2;
            ChartView.MatYCellRect(geo, m, yi, out px, out py, out pw, out ph2);
            if (cw < 2 || ch < 2 || pw < 2 || ph2 < 2) { continue; }
            int ccx = cx + cw / 2;
            int ccy = py + ph2 / 2;
            // 半径：series.radius 标量走 GaugeScalar（百分比按格短边、
            // px 按 DPI 缩放；calendar-pie 同款），缺省短边的一半。
            int cell = cw < ph2 ? cw : ph2;
            int r = ChartView.GaugeScalar(app, s.radius, cell);
            if (r <= 0) { r = cell / 2 - app.Scale(1); }
            if (r < 1) { continue; }
            int baseColor = ChartView.SeriesColorAt(app, o, si);
            double total = 0.0;
            for (int di = 0; di < s.data.Count; di = di + 1) {
                double v = s.data[di].number;
                if (v > 0.0) { total = total + v; }
            }
            if (total <= 0.000001) { continue; }
            double acc = (double)(s.startAngle != 0 ? s.startAngle : 90);
            for (int di = 0; di < s.data.Count; di = di + 1) {
                ChartData d = s.data[di];
                if (d.number <= 0.0) { continue; }
                double sweep = d.number * 360.0 / total;
                int a0 = (int)(acc + 0.5);
                int a1 = (int)(acc + sweep + 0.5);
                if (a1 <= a0) { a1 = a0 + 1; }
                // 配色：逐项 itemStyle.color > 逐项 color > 系列色
                // （calendar-pie 同款次序）。
                int col = baseColor;
                if (d.itemStyle != null && d.itemStyle.normal.color != 0) {
                    col = d.itemStyle.normal.color;
                } else if (d.color != 0) {
                    col = d.color;
                }
                c.FillSector(ccx, ccy, 0, r, a0, a1, col);
                acc = acc + sweep;
            }
        }
    }

    /// graph-on-matrix 的端点解析：纯数字串 = 节点序号（官方数字 =
    /// index），否则按节点显示名（第 4 元 labelText）/name 匹配。
    static int MatNodeIndex(ChartSeries s, string key) {
        if (key == null || key.Length < 1) { return 0 - 1; }
        bool digits = true;
        for (int i = 0; i < key.Length; i = i + 1) {
            if (key[i] < '0' || key[i] > '9') { digits = false; break; }
        }
        if (digits) { return Convert.ToInt(key); }
        for (int i = 0; i < s.data.Count; i = i + 1) {
            if (s.data[i].labelText == key || s.data[i].name == key) {
                return i;
            }
        }
        return 0 - 1;
    }

    /// graph-on-matrix：节点 = data 项的格矩形圆心（matrix-graph 的
    /// [x名, y名, 1, 课程名] 写法），links 按端点序连直线，目标端
    /// 画箭头（edgeSymbol 'arrow'），label.show 时节点上方画显示名
    /// （官方 offset [0,-15] verticalAlign bottom）。
    static void DrawMatrixGraph(App app, ChartOption o, ChartMatrixSpec m,
                                MatGeom geo, ChartSeries s, int si) {
        Canvas c = app.canvas;
        int n = s.data.Count;
        if (n < 1) { return; }
        List<ChartPoint> nodePts = new List<ChartPoint>();
        for (int di = 0; di < n; di = di + 1) {
            ChartData d = s.data[di];
            int cx = 0 - 1;
            int cy = 0 - 1;
            if (d.heatX >= 0 && d.heatY >= 0
                && d.heatX < m.xNodes.Count && d.heatY < m.yNodes.Count) {
                int rx0;
                int ry0;
                int rw0;
                int rh0;
                ChartView.MatXCellRect(geo, m, d.heatX, out rx0, out ry0,
                    out rw0, out rh0);
                int px0;
                int py0;
                int pw0;
                int ph0;
                ChartView.MatYCellRect(geo, m, d.heatY, out px0, out py0,
                    out pw0, out ph0);
                if (rw0 > 0 && ph0 > 0) {
                    cx = rx0 + rw0 / 2;
                    cy = py0 + ph0 / 2;
                }
            }
            nodePts.Add(ChartPoint.Of(cx, cy));
        }
        int nodeR = s.symbolSize > 0 ? s.symbolSize / 2 : app.Scale(6);
        int nodeCol = s.color != 0 ? s.color
            : ChartView.SeriesColorAt(app, o, si);
        int lineCol = s.itemStyle.normal.lineStyle.color != 0
            ? s.itemStyle.normal.lineStyle.color : nodeCol;
        int lineW = s.itemStyle.normal.lineStyle.width > 0
            ? s.itemStyle.normal.lineStyle.width : 2;
        // 边先画（压在节点下），目标端箭头。
        for (int li = 0; li < s.links.Count; li = li + 1) {
            ChartLink lk = s.links[li];
            int a = ChartView.MatNodeIndex(s, lk.from);
            int b = ChartView.MatNodeIndex(s, lk.to);
            if (a < 0 || b < 0 || a >= n || b >= n) { continue; }
            if (nodePts[a].x < 0 || nodePts[b].x < 0 || a == b) { continue; }
            c.DrawLine(nodePts[a].x, nodePts[a].y, nodePts[b].x, nodePts[b].y, lineCol, lineW);
            if (s.forceLinkSymbol == "arrow") {
                ChartView.DrawForceArrow(c, nodePts[a].x, nodePts[a].y, nodePts[b].x, nodePts[b].y,
                    nodeR + 1, lineCol);
            }
        }
        // 节点 + 显示名标签。
        for (int di = 0; di < n; di = di + 1) {
            if (nodePts[di].x < 0) { continue; }
            c.FillCircle(nodePts[di].x, nodePts[di].y, nodeR, nodeCol);
            if (s.labelShowT == 1 && s.data[di].labelText.Length > 0) {
                int lf = s.label.color != 0 ? s.label.color : 0;
                if (lf == 0) {
                    lf = Style.Part(app, "chart", "label", "", "", "",
                        Style.SNormal()).FgOr(0);
                }
                int lfFont = s.label.fontSize > 0
                    ? s.label.fontSize : ChartFonts.SeriesLabel(app);
                bool lfBold = s.label.fontWeight == "bold";
                // offset [0,-15] + verticalAlign bottom：文本底边在
                // 圆心上方 15px。多行名（含 \n）逐行居中画。
                string txt = s.data[di].labelText;
                int lineH = lfFont + app.Scale(3);
                int lines = 1;
                for (int ci = 0; ci < txt.Length; ci = ci + 1) {
                    if (txt[ci] == '\n') { lines = lines + 1; }
                }
                int blockH = lines * lineH;
                int ty = nodePts[di].y - app.Scale(15) - blockH;
                int curY = ty;
                int lineStart = 0;
                int txtLen = txt.Length;
                for (int ci = 0; ci <= txtLen; ci = ci + 1) {
                    if (ci == txtLen || txt[ci] == '\n') {
                        if (ci > lineStart) {
                            string line = txt.Substring(lineStart, ci - lineStart);
                            int lw2 = c.MeasureText(line, lfFont);
                            if (lfBold) {
                                c.DrawTextBold(nodePts[di].x - lw2 / 2, curY, line,
                                    lf, lfFont);
                            } else {
                                c.DrawText(nodePts[di].x - lw2 / 2, curY, line, lf, lfFont);
                            }
                        }
                        curY = curY + lineH;
                        lineStart = ci + 1;
                    }
                }
            }
        }
    }

    // ---- 布局备忘（悬停层复用核心层推导好的几何；地图/直角热力
    // 车道同款定式：键 = option 引用 + 面板矩形 + 缩放）。----
    static ChartOption matMemoOpt;
    static int matMemoX;
    static int matMemoY;
    static int matMemoW;
    static int matMemoH;
    static int matMemoScale;
    static MatGeom matMemo;

    static void MatMemoStore(App app, ChartOption o, int x, int y, int w,
                             int h, MatGeom geo) {
        ChartView.matMemoOpt = o;
        ChartView.matMemoX = x;
        ChartView.matMemoY = y;
        ChartView.matMemoW = w;
        ChartView.matMemoH = h;
        ChartView.matMemoScale = app.Scale(100);
        ChartView.matMemo = geo;
    }

    static MatGeom MatMemoLoad(App app, ChartOption o, int x, int y, int w,
                               int h) {
        if (ChartView.matMemoOpt != o || ChartView.matMemo == null) {
            return null;
        }
        if (ChartView.matMemoX != x || ChartView.matMemoY != y
            || ChartView.matMemoW != w || ChartView.matMemoH != h
            || ChartView.matMemoScale != app.Scale(100)) {
            return null;
        }
        return ChartView.matMemo;
    }

    /// 矩阵悬停覆盖层：高亮指针下的体格并显示 "x名 · y名 值"。
    /// 指针不在本图面板或不在体区内直接早退；几何从备忘复用，
    /// miss 才现算（布局纯整数推导，无文本测宽，代价可忽略）。
    static void MatrixHover(App app, int x, int y, int w, int h,
                            ChartOption o) {
        int mx = app.mouseX;
        int my = app.mouseY;
        if (mx < x || mx >= x + w || my < y || my >= y + h) { return; }
        ChartMatrixSpec m = o.matrix;
        if (m == null) { return; }
        Canvas c = app.canvas;
        MatGeom geo = ChartView.MatMemoLoad(app, o, x, y, w, h);
        if (geo == null) {
            int top = Chart.HeadBandBottom(app, y, o.title);
            double eLo = 0.0;
            double eHi = 0.0;
            int maxX = 0 - 1;
            int maxY = 0 - 1;
            ChartView.HeatFactsScan(o, out maxX, out maxY, out eLo, out eHi);
            geo = ChartView.MatLayout(app, x, y, w, h, top, o, eLo, eHi);
            if (geo == null) { return; }
        }
        if (mx < geo.bodyL || mx >= geo.rx + geo.rw
            || my < geo.bodyT || my >= geo.ry + geo.rh) { return; }
        int bodyW = (geo.rx + geo.rw) - geo.bodyL;
        int bodyH = (geo.ry + geo.rh) - geo.bodyT;
        int ci = ChartView.HeatmapIndexAt(mx - geo.bodyL, bodyW, geo.xLeaves);
        int ri = ChartView.HeatmapIndexAt(my - geo.bodyT, bodyH, geo.yLeaves);
        if (ci < 0 || ri < 0) { return; }
        // 找覆盖该体格的数据项（格可落在任意层级，按叶子域判定；
        // 多系列取先声明者）。
        int fsi = 0 - 1;
        int fdi = 0 - 1;
        for (int si = 0; si < o.series.Count && fsi < 0; si = si + 1) {
            ChartSeries s = o.series[si];
            if (s.hidden || s.type != ChartType.Heatmap) { continue; }
            for (int di = 0; di < s.data.Count; di = di + 1) {
                ChartData d = s.data[di];
                if (d.heatX < 0 || d.heatY < 0 || d.gap) { continue; }
                if (d.heatX >= m.xNodes.Count || d.heatY >= m.yNodes.Count) {
                    continue;
                }
                ChartMatrixBandNode xn = m.xNodes[d.heatX];
                ChartMatrixBandNode yn = m.yNodes[d.heatY];
                if (xn.first <= ci && ci < xn.first + xn.span
                    && yn.first <= ri && ri < yn.first + yn.span) {
                    fsi = si;
                    fdi = di;
                    break;
                }
            }
        }
        if (fsi < 0) { return; }
        ChartSeries hs = o.series[fsi];
        ChartData hd = hs.data[fdi];
        int cx;
        int cy;
        int cw;
        int ch;
        ChartView.MatXCellRect(geo, m, hd.heatX, out cx, out cy, out cw, out ch);
        int px;
        int py;
        int pw;
        int ph2;
        ChartView.MatYCellRect(geo, m, hd.heatY, out px, out py, out pw, out ph2);
        c.DrawRect(cx, py, cw, ph2,
            Style.Part(app, "chart", "cell", "", "", "", Style.SNormal()).BorderOr(0), 1);
        string xl = hd.heatX < m.xNodes.Count
            ? m.xNodes[hd.heatX].text : "#" + Convert.ToString(hd.heatX + 1);
        string yl = hd.heatY < m.yNodes.Count
            ? m.yNodes[hd.heatY].text : "#" + Convert.ToString(hd.heatY + 1);
        ChartHit hh = ChartHit.Of(ChartElementType.HeatmapCell,
            fsi, hs.name, fdi, xl, 0, cx, py);
        hh.numberValueSet = hd.numberSet;
        if (hh.numberValueSet) { hh.numberValue = hd.number; }
        ChartView.OfferActiveHit(hh);
        if (o.showTooltip) {
            int chip = hs.color;
            if (geo.ramp != null && geo.ramp.Count >= 2) {
                chip = ChartView.MatColorAt(geo.ramp, geo.dLo, geo.dHi,
                    geo.split, hd.number, 1000);
            }
            List<TooltipRow> tooltipRows = new List<TooltipRow>();
            tooltipRows.Add(TooltipRow.Of(chip,
                xl + " · " + yl + "  " + ChartView.HeatmapGridNumText(hd.number)));
            ChartView.TooltipCard(app, mx, my, x + w, tooltipRows);
        }
    }
}
