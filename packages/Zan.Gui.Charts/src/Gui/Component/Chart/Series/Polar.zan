using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

public partial class ChartView {
    // ---- 极坐标 / 雷达图（角度类别上的序列多边形） ----

    // 雷达图第 j 轴的上限（ECharts radar.indicator.max）：
    // radarMax[j] > 0 用显式值，否则从各系列该轴数据推导并取
    // 友好刻度。纯函数，供 chart_option_behavior 直接断言。
    public static int RadarAxisMax(List<ChartSeries> series, List<int> radarMax, int j) {
        int m = 0;
        if (j < radarMax.Count && radarMax[j] > 0) { m = radarMax[j]; }
        else {
            for (int si = 0; si < series.Count; si = si + 1) {
                ChartSeries s = series[si];
                if (s.hidden) { continue; }
                if (j < s.Count() && s.Value(j) > m) { m = s.Value(j); }
            }
            m = Chart.NiceMax(m);
        }
        if (m < 1) { m = 1; }
        return m;
    }

    // 指针角度（0=正上，顺时针）映射到最近的雷达轴。
    // 角度在 0/360 接缝处必须环回到轴 0，不能把四舍五入后的
    // n 夹到 n-1，否则正上方左侧的小扇区会显示错误轴数据。
    public static int RadarAxisAt(int angle, int n) {
        if (n < 1) { return 0 - 1; }
        int a = angle % 360;
        if (a < 0) { a = a + 360; }
        int axis = (a * n + 180) / 360;
        return axis % n;
    }

    // 雷达图入场动画按数据半径从中心向外展开；tooltip 的可见
    // 命中域必须跟随同一半径，否则 g=0 时中心外的不可见数据也会
    // 提前响应。容差只在已有可见半径时生效。
    public static int RadarTooltipRadius(int radius, int progress, int tolerance) {
        if (radius < 0) { radius = 0; }
        if (progress < 0) { progress = 0; }
        if (progress > 1000) { progress = 1000; }
        if (tolerance < 0) { tolerance = 0; }
        if (progress == 0) { return 0 - 1; }
        return radius * progress / 1000 + tolerance;
    }

    // 极坐标/雷达图渲染入口：同心环（circle/polygon 两种
    // radarShape）+ 可选 splitArea 交替色带 + 轴线与标签；系列画
    // 闭合多边形（可选 areaStyle 半透明填充与符号点）。轴扇区
    // 命中（RadarAxis 事件，dataIndex = 轴下标）与 tooltip，命中
    // 半径跟随入场动画进度。
    // option.polars 非空时走多 polar 路径（DrawPolarMulti），
    // 系列按 polarIndex 分组；空 = 下方单 polar 历史路径原样。
    public static void DrawPolar(App app, int x, int y, int w, int h,
    ChartOption o, int g) {
        if (o.polars.Count > 0) {
            ChartView.DrawPolarMulti(app, x, y, w, h, o, g);
            return;
        }
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int top = Chart.DrawPanelI(app, x, y, w, h, o.legendTextColor, o.title, o.series, o.iwid, o.showLegend);
        // 轴名优先从 radarIndicators 实体列表读取（官方语义）；无雷达组件
        // 时回退旧类目路径。0 系列（纯组件骨架）也走这里。
        List<string> labels = new List<string>();
        if (o.radarIndicators != null && o.radarIndicators.Count > 0) {
            for (int ri = 0; ri < o.radarIndicators.Count; ri = ri + 1) {
                labels.Add(o.radarIndicators[ri].name);
            }
        } else if (o.radarNames.Count > 0) {
            labels = o.radarNames;
        } else {
            labels = o.XCategories();
        }
        int n = labels.Count;
        if (n < 1 && o.series.Count > 0) { n = o.series[0].Count(); }
        if (n < 1) { return; }

        // 每轴独立上限：radarIndicators[j].max > 0 用显式值（ECharts
        // radar.indicator.max），否则从各系列该轴的数据推导并取友好刻度。Zero-Alloc 池化复用。
        Chart.renderContext.EnsureScratch();
        List<int> maxV = Chart.renderContext.scratchI3; maxV.Clear();
        for (int ai = 0; ai < n; ai = ai + 1) {
            int explicitMax = 0;
            if (o.radarIndicators != null && ai < o.radarIndicators.Count && o.radarIndicators[ai].max > 0) {
                explicitMax = o.radarIndicators[ai].max;
            } else if (ai < o.radarMax.Count && o.radarMax[ai] > 0) {
                explicitMax = o.radarMax[ai];
            }
            if (explicitMax > 0) {
                maxV.Add(explicitMax);
            } else {
                maxV.Add(ChartView.RadarAxisMax(o.series, o.radarMax, ai));
            }
        }

        int areaW = w - pad * 2;
        int areaH = (y + h - pad - Chart.legendBottomReserve) - top;
        int r = ChartView.RadialRadius(areaW, areaH, 62);
        if (r < app.Scale(10)) { r = app.Scale(10); }
        int cx = x + pad + areaW / 2;
        int cy = top + areaH / 2;
        int boxX = x + pad;
        int boxY = top;
        int boxW = areaW;
        int boxH = areaH;

        StyleBox sGrid = Style.Part(app, "chart", "grid", "", "", "",
        Style.SNormal());
        bool polyShape = o.radarShape == "polygon";
        int rings = 4;
        // splitArea：环带交替色（先画带再画环线，轮廓压在带上）。
        if (o.radarSplitArea) {
            int areaCol = Style.Part(app, "chart", "split-area", "", "", "",
            Style.SNormal()).BgOr(0);
            if (areaCol == 0) { areaCol = sGrid.BgOr(0); }
            for (int rb = 2; rb <= rings; rb = rb + 2) {
                int r1 = r * rb / rings;
                int r0 = r * (rb - 1) / rings;
                if (polyShape) {
                    // 外环顶点 + 内环逆序顶点 = 偶奇规则下的环形带。Zero-Alloc 池化复用。
                    List<int> bx = Chart.renderContext.pooledPx; bx.Clear();
                    List<int> by = Chart.renderContext.pooledPy; by.Clear();
                    for (int a = 0; a < n; a = a + 1) {
                        int ang = a * 360 / n - 90;
                        bx.Add(cx + ChartView.CosDeg(ang) * r1 / 1000);
                        by.Add(cy + ChartView.SinDeg(ang) * r1 / 1000);
                    }
                    for (int a = n - 1; a >= 0; a = a - 1) {
                        int ang = a * 360 / n - 90;
                        bx.Add(cx + ChartView.CosDeg(ang) * r0 / 1000);
                        by.Add(cy + ChartView.SinDeg(ang) * r0 / 1000);
                    }
                    ChartView.FillPolyAlpha(c, bx, by, areaCol, 26);
                } else {
                    c.FillSector(cx, cy, r0, r1, 0, 360, ChartColor.WithAlpha(areaCol, 26));
                }
            }
        }
        int rr = 1;
        while (rr <= rings) {
            if (polyShape) {
                // polygon 环：按轴角度连成的闭合多边形。Zero-Alloc 池化复用。
                List<int> gx = Chart.renderContext.pooledPx; gx.Clear();
                List<int> gy = Chart.renderContext.pooledPy; gy.Clear();
                for (int a = 0; a < n; a = a + 1) {
                    int ang = a * 360 / n - 90;
                    gx.Add(cx + ChartView.CosDeg(ang) * r * rr / rings / 1000);
                    gy.Add(cy + ChartView.SinDeg(ang) * r * rr / rings / 1000);
                }
                gx.Add(gx[0]);
                gy.Add(gy[0]);
                c.DrawPolyline(gx, gy, sGrid.BgOr(0), 1);
            } else {
                ChartView.RingOutline(c, cx, cy, r * rr / rings, sGrid.BgOr(0));
            }
            rr = rr + 1;
        }
        for (int a = 0; a < n; a = a + 1) {
            int ang = a * 360 / n - 90;
            int ex = cx + ChartView.CosDeg(ang) * r / 1000;
            int ey = cy + ChartView.SinDeg(ang) * r / 1000;
            c.DrawLine(cx, cy, ex, ey, sGrid.BgOr(0), 1);
            string lbl = "";
            if (a < labels.Count) { lbl = labels[a]; }
            if (lbl.Length > 0) {
                int lblCol = o.radarNameColor != 0
                ? o.radarNameColor
                : Style.Part(app, "chart", "axis", "", "", "", Style.SNormal()).FgOr(0);
                ChartView.DrawPolarLabel(app, c, cx, cy, r, ang, lbl,
                lblCol, ChartFonts.SeriesLabel(app), boxX, boxY, boxW, boxH);
            }
        }

        ChartView.PushPlotClip(app, boxX, boxY, boxW, boxH);
        for (int si = 0; si < o.series.Count; si = si + 1) {
            ChartSeries s = o.series[si];
            if (s.hidden) { continue; }
            int col = s.color;
            // 整个雷达多边形（含闭合边）是单次描边，
            // 顶点为平滑的圆角连接，而非逐段接缝。Zero-Alloc 池化复用。
            List<int> lx = Chart.renderContext.pooledPx; lx.Clear();
            List<int> ly = Chart.renderContext.pooledPy; ly.Clear();
            for (int j = 0; j < n && j < s.Count(); j = j + 1) {
                int ang = j * 360 / n - 90;
                int rad = (int)((long)s.Value(j) * g * r / ((long)maxV[j] * 1000L));
                int px = cx + ChartView.CosDeg(ang) * rad / 1000;
                int py = cy + ChartView.SinDeg(ang) * rad / 1000;
                lx.Add(px);
                ly.Add(py);
                if (s.showSymbol != 0) {
                    Chart.DrawSymbol(c, px, py,
                    s.symbolSize > 0
                    ? app.Scale(Chart.SymbolRadius(s.symbolSize, 0))
                    : app.Scale(3),
                    s.symbol, col, 0, 0);
                }
            }
            if (n > 1 && s.Count() >= n && lx.Count > 0) {
                lx.Add(lx[0]);
                ly.Add(ly[0]);
            }
            // areaStyle（ECharts radar.areaStyle）：半透明填充
            // 多边形内部（描边之前，使轮廓保持清晰）；声明了
            // areaStyle.opacity 时按声明值（radar-aqi 0.1 的雾面）。
            if (s.areaStyle && lx.Count > 2) {
                int aA = 70;
                if (s.itemStyle.normal.areaStyle != null
                && s.itemStyle.normal.areaStyle.alpha > 0) {
                    aA = s.itemStyle.normal.areaStyle.alpha;
                }
                ChartView.FillPolyAlpha(c, lx, ly, col, aA);
            }
            if (lx.Count > 1) {
                // lineStyle.width/opacity 按系列生效（radar-aqi 的
                // width 1 + opacity 0.5 细线），缺省 2px 不透明。
                int lw = app.Scale(2);
                int lcol = col;
                if (s.itemStyle.normal.lineStyle.width > 0) {
                    lw = app.Scale(s.itemStyle.normal.lineStyle.width);
                }
                if (s.itemStyle.normal.lineStyle.alpha > 0) {
                    lcol = ChartColor.WithAlpha(col, s.itemStyle.normal.lineStyle.alpha);
                }
                List<int> fx = Chart.renderContext.scratchI1; fx.Clear();
                List<int> fy = Chart.renderContext.scratchI2; fy.Clear();
                for (int pi2 = 0; pi2 < lx.Count; pi2 = pi2 + 1) {
                    fx.Add(lx[pi2] * 256);
                    fy.Add(ly[pi2] * 256);
                }
                c.DrawPolylineFx(fx, fy, lcol, lw);
            }
        }
        c.PopClip();

        // 命中几何与 tooltip 展示解耦：关闭 tooltip 不能关闭
        // 雷达轴扇区的 Hover/MouseOut/Click 事件。
        int mx = ChartView.PointerX(app);
        int my = ChartView.PointerY(app);
        ChartHit hit = ChartView.PaintHit(app, ChartElementType.RadarAxis);
        if (hit != null) {
            int axis = hit.dataIndex;
            if (o.showTooltip) {
                List<TooltipRow> rows = new List<TooltipRow>();
                string hdr = "Axis " + Convert.ToString(axis + 1);
                if (axis < labels.Count) { hdr = labels[axis]; }
                rows.Add(TooltipRow.Of(0, hdr));
                for (int si2 = 0; si2 < o.series.Count; si2 = si2 + 1) {
                    ChartSeries s2 = o.series[si2];
                    if (!s2.hidden && axis < s2.Count()) {
                        string vt = o.radarScaled
                        ? Chart.FracText(s2.Value(axis))
                        : Convert.ToString(s2.Value(axis));
                        rows.Add(TooltipRow.Of(s2.color, s2.name + "  " + vt));
                    }
                }
                ChartView.TooltipCard(app, mx, my, x + w, rows);
            }
        }
    }

    // 多 polar 路径（ECharts polar[] + series.polarIndex）：每个
    // 坐标系独立画网格/轴线/指示器名，系列按 polarIndex 分组
    // 各自绑定圆心/半径/轴上限。线型 solid/dashed/dotted 与
    // 符号形状（含 star5 别名）按系列生效；轴命中与 tooltip
    // 落到最近的 polar。
    public static void DrawPolarMulti(App app, int x, int y, int w, int h,
    ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int top = Chart.DrawPanelI(app, x, y, w, h, o.legendTextColor, o.title, o.series, o.iwid, o.showLegend);
        List<string> labels = o.XCategories();
        int areaW = w - pad * 2;
        int areaH = (y + h - pad - Chart.legendBottomReserve) - top;
        int baseSize = areaW;
        if (areaH < baseSize) { baseSize = areaH; }
        int boxX = x + pad;
        int boxY = top;
        int boxW = areaW;
        int boxH = areaH;

        StyleBox sGrid = Style.Part(app, "chart", "grid", "", "", "",
        Style.SNormal());
        int themeAxisFg = Style.Part(app, "chart", "axis", "", "", "",
        Style.SNormal()).FgOr(0);
        int smallFont = ChartFonts.SeriesLabel(app);

        int pn = o.polars.Count;
        // 逐 polar 预解析几何与样式（并行数组，下标 = polar 序号）。
        List<int> pcx = new List<int>();
        List<int> pcy = new List<int>();
        List<int> pr = new List<int>();
        List<int> paxN = new List<int>();
        List<int> pbase = new List<int>();  // 首轴的 top 角（90-startAngle）
        List<bool> ppoly = new List<bool>();
        List<int> prings = new List<int>();
        List<int> paxisCol = new List<int>();
        List<int> paxisW = new List<int>();
        List<int> psplitCol = new List<int>();
        List<int> psplitW = new List<int>();
        List<List<int>> pmax = new List<List<int>>();
        List<List<string>> plabels = new List<List<string>>();
        List<List<int>> pseries = new List<List<int>>();
        List<List<int>> psplitArea = new List<List<int>>();
        List<PolarNameStyle> pnames = new List<PolarNameStyle>();
        for (int pi = 0; pi < pn; pi = pi + 1) {
            RadarPolar p = o.polars[pi];
            List<string> lbls = new List<string>();
            if (p.indicators.Count > 0) {
                for (int ii = 0; ii < p.indicators.Count; ii = ii + 1) {
                    lbls.Add(p.indicators[ii].text);
                }
            } else {
                lbls = labels;
            }
            int n = lbls.Count;
            if (n < 1 && o.series.Count > 0) { n = o.series[0].Count(); }
            if (n < 1) { n = 1; }

            // 系列按 polarIndex 分组（越界归 0），hidden 跳过。
            List<int> sis = new List<int>();
            for (int si = 0; si < o.series.Count; si = si + 1) {
                ChartSeries s = o.series[si];
                if (s.hidden) { continue; }
                int own = s.polarIndex;
                if (own < 0 || own >= pn) { own = 0; }
                if (own == pi) { sis.Add(si); }
            }

            // 每轴上限：indicators[j].max > 0 显式优先，否则从本 polar
            // 的系列推导（与单 polar 同一套友好刻度）。
            List<int> maxV = new List<int>();
            List<ChartSeries> sub = new List<ChartSeries>();
            for (int si = 0; si < sis.Count; si = si + 1) {
                sub.Add(o.series[sis[si]]);
            }
            for (int ai = 0; ai < n; ai = ai + 1) {
                int m = 0;
                if (ai < p.indicators.Count && p.indicators[ai].max > 0) {
                    m = p.indicators[ai].max;
                } else {
                    m = ChartView.RadarAxisMax(sub, new List<int>(), ai);
                }
                maxV.Add(m);
            }

            int cx = x + pad + areaW / 2;
            int cy = top + areaH / 2;
            if (p.center != null) {
                cx = x + ChartView.GaugeScalar(app, p.center.x, w);
                cy = y + ChartView.GaugeScalar(app, p.center.y, h);
            }
            int r = ChartView.RadialRadius(areaW, areaH, 62);
            if (p.radius.amount != 0) {
                r = ChartView.GaugeScalar(app, p.radius, baseSize / 2);
            }
            if (r < app.Scale(10)) { r = app.Scale(10); }

            pcx.Add(cx); pcy.Add(cy); pr.Add(r);
            paxN.Add(n);
            pbase.Add(90 - p.startAngle);
            string shape = p.type.Length > 0 ? p.type : o.radarShape;
            ppoly.Add(shape == "polygon");
            prings.Add(p.splitNumber > 0 ? p.splitNumber : 4);
            paxisCol.Add(p.axisLineColor != 0 ? p.axisLineColor : sGrid.BgOr(0));
            paxisW.Add(p.axisLineWidth > 0 ? app.Scale(p.axisLineWidth) : 1);
            psplitCol.Add(p.splitLineColor != 0 ? p.splitLineColor : sGrid.BgOr(0));
            psplitW.Add(p.splitLineWidth > 0 ? app.Scale(p.splitLineWidth) : 1);
            pmax.Add(maxV);
            plabels.Add(lbls);
            pseries.Add(sis);
            psplitArea.Add(p.splitAreaColors);
            pnames.Add(new PolarNameStyle(
            p.nameColor != 0 ? p.nameColor : themeAxisFg,
            p.nameFormat));
        }

        // ---- 网格层：splitArea 交替带 -> 分隔环线 -> 轴线与指示器名。
        for (int pi = 0; pi < pn; pi = pi + 1) {
            int cx = pcx[pi]; int cy = pcy[pi]; int r = pr[pi];
            int n = paxN[pi];
            bool polyShape = ppoly[pi];
            int rings = prings[pi];
            List<int> areaCols = psplitArea[pi];
            if (areaCols.Count > 0) {
                for (int rb = 1; rb <= rings; rb = rb + 1) {
                    int col = areaCols[(rb - 1) % areaCols.Count];
                    int r1 = r * rb / rings;
                    int r0 = r * (rb - 1) / rings;
                    if (polyShape) {
                        List<int> bx = Chart.renderContext.pooledPx; bx.Clear();
                        List<int> by = Chart.renderContext.pooledPy; by.Clear();
                        for (int a = 0; a < n; a = a + 1) {
                            int ang = a * 360 / n - 90;
                            bx.Add(cx + ChartView.CosDeg(ang) * r1 / 1000);
                            by.Add(cy + ChartView.SinDeg(ang) * r1 / 1000);
                        }
                        for (int a = n - 1; a >= 0; a = a - 1) {
                            int ang = a * 360 / n - 90;
                            bx.Add(cx + ChartView.CosDeg(ang) * r0 / 1000);
                            by.Add(cy + ChartView.SinDeg(ang) * r0 / 1000);
                        }
                        ChartView.FillPolyAlpha(c, bx, by, col, 300);
                    } else {
                        c.FillSector(cx, cy, r0, r1, 0, 360,
                        ChartColor.WithAlpha(col, 300));
                    }
                }
            }
            int rr = 1;
            while (rr <= rings) {
                if (polyShape) {
                    List<int> gx = Chart.renderContext.pooledPx; gx.Clear();
                    List<int> gy = Chart.renderContext.pooledPy; gy.Clear();
                    for (int a = 0; a < n; a = a + 1) {
                        int ang = a * 360 / n - 90;
                        gx.Add(cx + ChartView.CosDeg(ang) * r * rr / rings / 1000);
                        gy.Add(cy + ChartView.SinDeg(ang) * r * rr / rings / 1000);
                    }
                    gx.Add(gx[0]);
                    gy.Add(gy[0]);
                    c.DrawPolyline(gx, gy, psplitCol[pi], psplitW[pi]);
                } else {
                    c.DrawCircle(cx, cy, r * rr / rings,
                    psplitCol[pi], psplitW[pi]);
                }
                rr = rr + 1;
            }
            for (int a = 0; a < n; a = a + 1) {
                int ang = a * 360 / n - 90;
                int ex = cx + ChartView.CosDeg(ang) * r / 1000;
                int ey = cy + ChartView.SinDeg(ang) * r / 1000;
                c.DrawLine(cx, cy, ex, ey, paxisCol[pi], paxisW[pi]);
                string lbl = "";
                if (a < plabels[pi].Count) { lbl = plabels[pi][a]; }
                if (lbl.Length > 0 && pnames[pi].format.Length > 0) {
                    lbl = pnames[pi].format.Replace("{value}", lbl);
                }
                if (lbl.Length > 0) {
                    ChartView.DrawPolarLabel(app, c, cx, cy, r, ang, lbl,
                    pnames[pi].color, smallFont, boxX, boxY, boxW, boxH);
                }
            }
        }

        // ---- 系列层：逐 polar 画多边形（areaStyle/线型/符号点）。
        ChartView.PushPlotClip(app, boxX, boxY, boxW, boxH);
        for (int pi = 0; pi < pn; pi = pi + 1) {
            RadarPolar p = o.polars[pi];
            int cx = pcx[pi]; int cy = pcy[pi]; int r = pr[pi];
            int n = paxN[pi];
            List<int> maxV = pmax[pi];
            List<int> sis = pseries[pi];
            // 极坐标柱（ECharts 风格 polar[] + coordinateSystem:"polar"）：
            // 本 polar 的全部柱系列一起交给极坐标柱渲染器——堆叠累加与
            // 列宽解算都需要看到同组的全部系列，逐系列单独调用会各自
            // 独占一条列、堆叠失效。
            ChartPolarBarFrame bf = new ChartPolarBarFrame();
            bf.cx = cx; bf.cy = cy;
            bf.r0Px = ChartView.GaugeScalar(app, p.radiusInner, baseSize / 2);
            bf.r1Px = r;
            PolarAxisSpec bax = ChartView.PolarAxisFor(o.angleAxes, pi);
            PolarAxisSpec brx = ChartView.PolarAxisFor(o.radiusAxes, pi);
            bf.aCat = bax != null && bax.type == ChartAxisType.Category;
            bf.rCat = brx != null && brx.type == ChartAxisType.Category;
            bf.aCats = bax != null ? bax.cats : new List<string>();
            bf.rCats = brx != null ? brx.cats : new List<string>();
            bf.startAngle = bax != null ? bax.startAngle : 90;
            bf.endAngle = bax != null ? bax.endAngle : 0;
            bf.endAngleSet = bax != null && bax.endAngleSet;
            bf.clockwise = bax == null || bax.clockwise;
            bf.aOnBand = bax == null || bax.boundaryGap;
            bf.rOnBand = brx == null || brx.boundaryGap;
            ChartView.PolarBarsValueExtentAt(o, true, pi, out bf.aLo, out bf.aHi);
            ChartView.PolarBarsValueExtentAt(o, false, pi, out bf.rLo, out bf.rHi);
            List<ChartSeries> bBars = new List<ChartSeries>();
            List<int> bSi = new List<int>();
            for (int si = 0; si < sis.Count; si = si + 1) {
                ChartSeries bs = o.series[sis[si]];
                if (bs.type != ChartType.Bar) { continue; }
                bBars.Add(bs);
                bSi.Add(sis[si]);
            }
            if (bBars.Count > 0) {
                ChartView.DrawPolarBarSeries(app, c, o, bBars, bSi, bf, g);
            }
            for (int si = 0; si < sis.Count; si = si + 1) {
                ChartSeries s = o.series[sis[si]];
                if (s.type == ChartType.Bar) { continue; }
                int col = s.color;
                if (col == 0 && s.itemStyle != null && s.itemStyle.normal.color != 0) {
                    col = s.itemStyle.normal.color;
                }
                if (col == 0) { col = ChartColor.Palette(t, sis[si]); }
                string ltype = s.itemStyle.normal.lineStyle.type;
                bool dashed = ltype == "dashed" || ltype == "dotted";
                int dashLen = app.Scale(5);
                int gapLen = app.Scale(3);
                if (ltype == "dotted") { dashLen = app.Scale(2); gapLen = app.Scale(2); }
                List<int> lx = Chart.renderContext.pooledPx; lx.Clear();
                List<int> ly = Chart.renderContext.pooledPy; ly.Clear();
                for (int j = 0; j < n && j < s.Count(); j = j + 1) {
                    int ang = j * 360 / n - 90;
                    int rad = (int)((long)s.Value(j) * g * r / ((long)maxV[j] * 1000L));
                    int px = cx + ChartView.CosDeg(ang) * rad / 1000;
                    int py = cy + ChartView.SinDeg(ang) * rad / 1000;
                    lx.Add(px);
                    ly.Add(py);
                    if (s.showSymbol != 0) {
                        Chart.DrawSymbol(c, px, py,
                        s.symbolSize > 0
                        ? app.Scale(Chart.SymbolRadius(s.symbolSize, 0))
                        : app.Scale(3),
                        s.symbol, col, 0, 0);
                    }
                }
                if (n > 1 && s.Count() >= n && lx.Count > 0) {
                    lx.Add(lx[0]);
                    ly.Add(ly[0]);
                }
                if (s.areaStyle && lx.Count > 2) {
                    int aA = 70;
                    if (s.itemStyle.normal.areaStyle != null
                    && s.itemStyle.normal.areaStyle.alpha > 0) {
                        aA = s.itemStyle.normal.areaStyle.alpha;
                    }
                    ChartView.FillPolyAlpha(c, lx, ly, col, aA);
                }
                int lcol = col;
                if (s.itemStyle.normal.lineStyle.alpha > 0) {
                    lcol = ChartColor.WithAlpha(col, s.itemStyle.normal.lineStyle.alpha);
                }
                if (lx.Count > 1) {
                    // lineStyle.width 可覆写默认 2（官方 radar.html 的
                    // 28 年细线扇面用 width 1）。
                    int lw = app.Scale(2);
                    if (s.itemStyle.normal.lineStyle.width > 0) {
                        lw = app.Scale(s.itemStyle.normal.lineStyle.width);
                    }
                    if (dashed) {
                        ChartView.DrawDashed(c, lx, ly, lcol, lw,
                        dashLen, gapLen);
                    } else {
                        List<int> fx = Chart.renderContext.scratchI1; fx.Clear();
                        List<int> fy = Chart.renderContext.scratchI2; fy.Clear();
                        for (int k = 0; k < lx.Count; k = k + 1) {
                            fx.Add(lx[k] * 256);
                            fy.Add(ly[k] * 256);
                        }
                        c.DrawPolylineFx(fx, fy, lcol, lw);
                    }
                }
            }
        }
        c.PopClip();

        // ---- 命中层：取最近 polar 的轴扇区；tooltip 行取该 polar
        // 的系列分区（与单 polar 相同的事件类型）。
        int mx = ChartView.PointerX(app);
        int my = ChartView.PointerY(app);
        ChartHit hit = ChartView.PaintHit(app, ChartElementType.RadarAxis);
        int near = hit != null && hit.seriesIndex >= 0 && hit.seriesIndex < o.series.Count
        ? o.series[hit.seriesIndex].polarIndex : -1;
        int axis = hit != null ? hit.dataIndex : -1;
        if (near >= 0 && axis >= 0 && o.showTooltip) {
            List<TooltipRow> rows = new List<TooltipRow>();
            string hdr = "Axis " + Convert.ToString(axis + 1);
            if (axis < plabels[near].Count) { hdr = plabels[near][axis]; }
            rows.Add(TooltipRow.Of(0, hdr));
            for (int si2 = 0; si2 < pseries[near].Count; si2 = si2 + 1) {
                ChartSeries s2 = o.series[pseries[near][si2]];
                if (axis < s2.Count()) {
                    string vt2 = o.radarScaled
                    ? Chart.FracText(s2.Value(axis))
                    : Convert.ToString(s2.Value(axis));
                    rows.Add(TooltipRow.Of(s2.color, s2.name + "  " + vt2));
                }
            }
            ChartView.TooltipCard(app, mx, my, x + w, rows);
        }
    }
}
