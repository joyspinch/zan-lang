using System;
using Gui;

namespace Gui.Component.Chart;

internal class ChartCandleGeometry {
    internal ChartFrame frame;
    internal List<string> labels;
    internal List<Candle> candles;
    internal int fullN;
    internal int zoomH;
    internal int i0;
    internal int i1;
    internal int n;
    internal int plo;
    internal int phi;
    internal int yTicks;

    internal static ChartCandleGeometry Create(App app, ChartOption o, int x, int y, int w, int h) {
        if (o.series.Count < 1 || o.series[0].candles.Count < 1) { return null; }
        List<Candle> cs = o.series[0].candles;
        int fullN = cs.Count;
        int plotTop = Chart.PanelContentTop(app, x, y, w, o.title, o.series, o.showLegend);
        // dataZoom：窗口索引 [i0,i1]（含端点）；价格范围、
        // 分桶和均线覆盖都只在窗口内。
        int zoomH = 0;
        int i0 = 0;
        int i1 = fullN - 1;
        if (o.zoom && o.iwid != 0 && fullN > 1) {
            i0 = Chart.ZoomI0(app, o, o.iwid, fullN);
            i1 = Chart.ZoomI1(app, o, o.iwid, fullN);
            zoomH = Chart.zoomBarHidden ? 0 : Chart.ZoomBandH(app, o, h);
        }
        int n = i1 - i0 + 1;
        if (n < 1) { n = 1; }

        int lo = cs[i0].low;
        int hi = cs[i0].high;
        for (int i = i0; i <= i1; i = i + 1) {
            if (cs[i].low < lo) { lo = cs[i].low; }
            if (cs[i].high > hi) { hi = cs[i].high; }
        }
        // 折线族覆盖层（如 MA 均线）共用价格轴，
        // 因此 lo/hi 也要包含它们的范围；次轴（axisIndex 1）系列
        // 走自己的包络，不参与价格轴（mix10 成交金额）。
        int ov0 = 1;
        while (ov0 < o.series.Count) {
            ChartSeries s = o.series[ov0];
            if (!s.hidden && s.axisIndex == 0 && ChartView.IsLineFamily(s.type)) {
                for (int k = i0; k <= i1 && k < s.Count(); k = k + 1) {
                    // '-' 占位（Gap）不进极值：MA 前 N-1 项无值，当 0
                    // 计会把包络拖到 0，scale:true 的紧致量程被撑爆
                    // （candlestick-touch 蜡烛压成顶部细线的根因）。
                    if (k < s.data.Count && s.data[k].gap) { continue; }
                    int v = s.Value(k);
                    if (v < lo) { lo = v; }
                    if (v > hi) { hi = v; }
                }
            }
            ov0 = ov0 + 1;
        }
        // ECharts yAxis scale:true + boundaryGap[0.01,0.01]：数据域
        // 两端各外扩 1% 再走 smartSteps nice 包络（不强制含 0）；
        // 显式 min/max 仍固定定义域。折线覆盖层共享同一包络。
        // min/max:'dataMin'/'dataMax'（candlestick-sh 族）：该端钉在
        // 包含折线覆盖层的原始包络上，不走 ScaleRange 的 nice
        // 包络（fixMM 语义）。单端声明时另一端仍走 nice。
        ChartSpan ysp;
        bool declLoB = o.yAxes.Count > 0 && o.yAxes[0].minDataB;
        bool declHiB = o.yAxes.Count > 0 && o.yAxes[0].maxDataB;
        bool declLoN = o.yAxes.Count > 0 && o.yAxes[0].min != ChartOption.Auto();
        bool declHiN = o.yAxes.Count > 0 && o.yAxes[0].max != ChartOption.Auto();
        if (o.yAxes.Count > 0 && ((declLoN && declHiN) || (declLoB && declHiB)
        || (declLoN && declHiB) || (declLoB && declHiN))) {
            ysp = new ChartSpan();
            ysp.lo = declLoB ? lo : o.yAxes[0].min;
            ysp.hi = declHiB ? hi : o.yAxes[0].max;
            ysp.ticks = 5;
        } else if (declLoB || declHiB) {
            ChartSpan raw = new ChartSpan();
            raw.lo = declLoB ? lo : ChartOption.Auto();
            raw.hi = declHiB ? hi : ChartOption.Auto();
            ysp = Chart.ScaleRange(declLoB ? lo : raw.lo, declHiB ? hi : raw.hi);
            if (declLoB) { ysp.lo = lo; }
            if (declHiB) { ysp.hi = hi; }
        } else {
            ysp = Chart.ScaleRange(lo, hi);
        }
        int plo = ysp.lo;
        int phi = ysp.hi;
        int yTicks = ysp.ticks;
        if (yTicks < 1) { yTicks = 5; }

        // 分类轴携带交易日日期（ECharts xAxis.data）时画到
        // 底轴：与蜡烛同宽均布，n 与蜡烛数一致时逐根对齐。
        List<string> kLabs = new List<string>();
        if (o.xAxes.Count > 0) { kLabs = o.xAxes[0].categories; }
        // 全窗口直接复用原类目表：WindowLabels 逐条复制 2.2 万条
        // 字符串也是每帧的固定税（默认视图 i0=0/i1=full-1 时拷贝
        // 结果与输入等价）。
        List<string> winLabs = (i0 == 0 && i1 == fullN - 1)
        ? kLabs : Chart.WindowLabels(kLabs, i0, i1);
        ChartFrame f = Chart.LayoutRangeFrame(app, x, y, w, h - zoomH, plotTop, o);
        f.leftMin = plo; f.leftMax = phi; f.catBoundaryGap = true;
        ChartCandleGeometry geometry = new ChartCandleGeometry();
        geometry.frame = f; geometry.labels = winLabs; geometry.candles = cs;
        geometry.fullN = fullN;
        geometry.zoomH = zoomH;
        geometry.i0 = i0;
        geometry.i1 = i1;
        geometry.n = n;
        geometry.plo = plo;
        geometry.phi = phi;
        geometry.yTicks = yTicks;
        return geometry;
    }

    internal int Columns(App app) {
        if (n <= 44) { return n; }
        int count = frame.plotW / app.Scale(5);
        if (count < 1) { count = 1; }
        return count > n ? n : count;
    }

    internal int BucketLast(App app, int sourceIndex) {
        if (n <= 44) { return sourceIndex; }
        int count = this.Columns(app);
        int bucket = 0;
        while (bucket + 1 < count && i0 + (bucket + 1) * n / count <= sourceIndex) { bucket = bucket + 1; }
        int last = i0 + (bucket + 1) * n / count - 1;
        return last >= fullN ? fullN - 1 : last;
    }

    internal ChartHit Hit(App app, ChartOption option, int px, int py, int growth) {
        if (growth <= 0 || option.series[0].hidden || option.series[0].silent
        || px < frame.plotX || px >= frame.plotX + frame.plotW
        || py < frame.plotY || py >= frame.plotY + frame.plotH) { return null; }
        int bucket = frame.CatIndexAt(px, this.Columns(app));
        int index = i0 + bucket * n / this.Columns(app);
        int last = this.BucketLast(app, index);
        ChartHit hit = ChartHit.Of(ChartElementType.Candlestick, 0, option.series[0].name,
        index, "#" + Convert.ToString(index + 1), candles[last].close, px, py);
        hit.axisIndex = option.series[0].axisIndex;
        return hit;
    }
}
