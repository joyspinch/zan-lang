using System;
using Gui;

namespace Gui.Component.Chart;

internal class ChartPreparedPanel {
    internal ChartOption option;
    internal string kind;
    internal int x; internal int y; internal int w; internal int h;
    internal int growth;
    internal ChartHit hit;
    internal int axisHover = -1;
    internal List<ChartPreparedText> titles = new List<ChartPreparedText>();
    internal ChartPreparedPanel previous;
    internal bool grid;
    internal bool hideZoom;
    internal List<ChartPreparedPanel> panels = new List<ChartPreparedPanel>();
    internal List<ChartPreparedPanel> overlays = new List<ChartPreparedPanel>();
    internal ChartLegendLayout legendLayout;
    internal ChartZoomLayout zoomLayout;
    internal ChartCartesianGeometry cartesianGeometry;
    internal ChartHorizontalGeometry horizontalGeometry;
    internal ChartCandleGeometry candleGeometry;
    internal ChartBubbleGeometry bubbleGeometry;
    internal ChartPictorialGeometry pictorialGeometry;
    internal ChartSunburstGeometry sunburstGeometry;
    internal ChartPieGeometry pieGeometry;
    internal ChartMapGeometry mapGeometry;
    internal ChartScatterGeometry scatterGeometry;
    internal ChartHeatmapGeometry heatmapGeometry;
    internal ChartMatrixGeometry matrixGeometry;
    internal ChartStatisticalGeometry statisticalGeometry;
    internal ChartTreeGeometry treeGeometry;
    internal ChartForceGeometry forceGeometry;
    internal ChartChordGeometry chordGeometry;
    internal ChartTreemapGeometry treemapGeometry;
    internal ChartVennGeometry vennGeometry;
    internal ChartEventRiverGeometry eventRiverGeometry;
    internal ChartThemeRiverGeometry themeRiverGeometry;
    internal ChartSankeyGeometry sankeyGeometry;
    internal ChartRadarGeometry radarGeometry;
    internal ChartGaugeGeometry gaugeGeometry;
    internal ChartFunnelGeometry funnelGeometry;
    internal ChartWordCloudGeometry wordCloudGeometry;
    internal ChartParallelGeometry parallelGeometry;

    internal static ChartPreparedPanel Create(App app, ChartOption option, int x, int y, int w, int h,
    int growth, ChartPreparedPanel previous) {
        return ChartPreparedPanel.CreateKind(app, option, x, y, w, h, growth, previous, ChartView.DispatchKind(option));
    }

    internal static ChartPreparedPanel CreateKind(App app, ChartOption option, int x, int y, int w, int h,
    int growth, ChartPreparedPanel previous, string kind) {
        ChartPreparedPanel panel = new ChartPreparedPanel();
        panel.previous = previous;
        panel.option = option; panel.x = x; panel.y = y; panel.w = w; panel.h = h; panel.growth = growth;
        panel.grid = Chart.gridPanelSub; panel.hideZoom = Chart.zoomBarHidden;
        Chart.legendOpt = option;
        Chart.legendBottomReserve = 0; Chart.zoomBandReserve = 0;
        panel.kind = kind;
        panel.statisticalGeometry = ChartStatisticalGeometry.Create(app, option, x, y, w, h);
        if (kind == "parallel") { panel.parallelGeometry = ChartParallelGeometry.Create(app, option, x, y, w, h, growth, previous != null ? previous.parallelGeometry : null); }
        if (kind == "k") { panel.candleGeometry = ChartCandleGeometry.Create(app, option, x, y, w, h); }
        if (kind == "bubbles") { panel.bubbleGeometry = ChartBubbleGeometry.Create(app, option, x, y, w, h); }
        if (kind == "pictorialBar") { panel.pictorialGeometry = ChartPictorialGeometry.Create(app, option, x, y, w, h); }
        if (kind == "sunburst") { panel.sunburstGeometry = ChartSunburstGeometry.Create(app, option, x, y, w, h, growth); }
        if (kind == "wordCloud") { panel.wordCloudGeometry = ChartWordCloudGeometry.Create(app, option, x, y, w, h,
        previous != null ? previous.wordCloudGeometry : null); }
        if (kind == "pie" || kind == "rose") { panel.pieGeometry = ChartPieGeometry.Create(app, option, x, y, w, h); }
        if (kind == "map") {
            panel.mapGeometry = ChartMapGeometry.Create(app, option, x, y, w, h);
            if (panel.mapGeometry != null) { panel.mapGeometry.overlay = ChartGeoOverlayGeometry.Create(app, option, panel.mapGeometry, growth); }
        }
        if (kind == "radar" || kind == "polar") { panel.radarGeometry = ChartRadarGeometry.Create(app, option, x, y, w, h); }
        if (kind == "gauge") { panel.gaugeGeometry = ChartGaugeGeometry.Create(app, option, x, y, w, h); }
        if (kind == "funnel") { panel.funnelGeometry = ChartFunnelGeometry.Create(app, option, x, y, w, h); }
        if (kind == "treemap") { panel.treemapGeometry = ChartTreemapGeometry.Create(app, option, x, y, w, h, growth); }
        if (kind == "venn") { panel.vennGeometry = ChartVennGeometry.Create(app, option, x, y, w, h, growth); }
        if (kind == "eventRiver") { panel.eventRiverGeometry = ChartEventRiverGeometry.Create(app, option, x, y, w, h, growth); }
        if (kind == "themeRiver") { panel.themeRiverGeometry = ChartThemeRiverGeometry.Create(app, option, x, y, w, h, growth); }
        if (kind == "sankey") { panel.sankeyGeometry = ChartSankeyGeometry.Create(app, option, x, y, w, h, growth); }
        if (kind == "force") { panel.forceGeometry = ChartForceGeometry.Create(app, option, x, y, w, h, growth); }
        if (kind == "chord") { panel.chordGeometry = ChartChordGeometry.Create(app, option, x, y, w, h, growth); }
        if (kind == "tree") { panel.treeGeometry = ChartTreeGeometry.Create(app, option, x, y, w, h); }
        if (kind == "heatmap") { panel.heatmapGeometry = ChartHeatmapGeometry.Create(app, option, x, y, w, h); }
        if (option.matrix != null) { panel.matrixGeometry = ChartMatrixGeometry.Create(app, option, x, y, w, h); }
        ChartSeries lead = ChartView.LeadSeries(option);
        if (kind == "scatter" || (kind == "lines" && option.XCategories().Count == 0 && lead != null && lead.points.Count > 0)) {
            panel.scatterGeometry = ChartScatterGeometry.Create(app, option, x, y, w, h);
        }
        panel.horizontalGeometry = ChartHorizontalGeometry.Create(app, option, x, y, w, h);
        if (panel.horizontalGeometry == null) { panel.cartesianGeometry = ChartCartesianGeometry.Create(app, option, x, y, w, h); }
        if (option.zoom) {
            int px = 0; int pw = 0; int count = 0;
            if (panel.scatterGeometry != null) { px = panel.scatterGeometry.plotX; pw = panel.scatterGeometry.plotW; count = panel.scatterGeometry.fullN; }
            if (panel.horizontalGeometry != null) { px = panel.horizontalGeometry.plotX; pw = panel.horizontalGeometry.plotW; count = panel.horizontalGeometry.fullCount; }
            if (panel.cartesianGeometry != null) { px = panel.cartesianGeometry.frame.plotX; pw = panel.cartesianGeometry.frame.plotW; count = panel.cartesianGeometry.fullCount; }
            if (panel.candleGeometry != null) { px = panel.candleGeometry.frame.plotX; pw = panel.candleGeometry.frame.plotW; count = panel.candleGeometry.fullN; }
            if (panel.bubbleGeometry != null) { px = panel.bubbleGeometry.plotX; pw = panel.bubbleGeometry.plotW; count = panel.bubbleGeometry.fullN; }
            if (pw > 0 && count > 1 && !Chart.zoomBarHidden) { panel.zoomLayout = ChartZoomLayout.Create(app, option, px, pw, x, y, w, h, option.iwid, count); }
        }
        if (option.showLegend) {
            if (kind == "pie" || kind == "rose") {
                panel.legendLayout = ChartLegendLayout.Pie(app, option, x, y, w, h, Chart.HeadBandBottom(app, y, option.title));
            } else if (panel.cartesianGeometry != null || panel.horizontalGeometry != null || kind == "scatter"
            || kind == "heatmap" || kind == "polar" || kind == "radar" || kind == "wordCloud" || kind == "themeRiver") {
                panel.legendLayout = ChartLegendLayout.Series(app, x, y, w, h, option.title, option.series,
                option.zoom ? Chart.ZoomBandH(app, option, h) : 0);
            }
        }
        return panel;
    }

    internal ChartPreparedPanel Find(ChartOption model, int px, int py, int width, int height) {
        if (option == model && x == px && y == py && w == width && h == height) { return this; }
        for (int i = 0; i < panels.Count; i = i + 1) {
            ChartPreparedPanel found = panels[i].Find(model, px, py, width, height);
            if (found != null) { return found; }
        }
        for (int i = 0; i < overlays.Count; i = i + 1) {
            ChartPreparedPanel found = overlays[i].Find(model, px, py, width, height);
            if (found != null) { return found; }
        }
        return null;
    }
    internal void Release(App app) {
        if (parallelGeometry != null) { parallelGeometry.Release(app); }
        for (int i = 0; i < panels.Count; i = i + 1) { panels[i].Release(app); }
        for (int i = 0; i < overlays.Count; i = i + 1) { overlays[i].Release(app); }
    }

    internal void PrepareComplete(App app) {
        if (parallelGeometry != null) { parallelGeometry.PrepareComplete(app); }
        for (int i = 0; i < panels.Count; i = i + 1) { panels[i].PrepareComplete(app); }
        for (int i = 0; i < overlays.Count; i = i + 1) { overlays[i].PrepareComplete(app); }
    }

    internal void BeforePaint(App app) {
        if (parallelGeometry != null) { parallelGeometry.BeforePaint(app); }
        for (int i = 0; i < panels.Count; i = i + 1) { panels[i].BeforePaint(app); }
        for (int i = 0; i < overlays.Count; i = i + 1) { overlays[i].BeforePaint(app); }
    }

    internal void ClearHits() {
        hit = null; axisHover = -1;
        if (themeRiverGeometry != null) { themeRiverGeometry.hoverBand = -1; themeRiverGeometry.hoverTime = -1; }
        for (int i = 0; i < panels.Count; i = i + 1) { panels[i].ClearHits(); }
        for (int i = 0; i < overlays.Count; i = i + 1) { overlays[i].ClearHits(); }
    }

    internal ChartHit Hit(App app, ChartOption root, int x, int y) {
        for (int i = overlays.Count - 1; i >= 0; i = i - 1) {
            ChartHit candidate = overlays[i].Hit(app, root, x, y);
            if (candidate != null) { return candidate; }
        }
        for (int i = panels.Count - 1; i >= 0; i = i - 1) {
            ChartHit candidate = panels[i].Hit(app, root, x, y);
            if (candidate != null) { return candidate; }
        }
        if (x < this.x || x >= this.x + w || y < this.y || y >= this.y + h) { return null; }
        if (horizontalGeometry != null) {
            ChartHorizontalGeometry geometry = horizontalGeometry;
            if (geometry.rowH > 0 && x >= geometry.plotX && x < geometry.plotX + geometry.plotW
            && y >= geometry.plotY && y < geometry.plotY + geometry.plotH) {
                axisHover = (y - geometry.plotY) / geometry.rowH;
                if (axisHover >= geometry.labels.Count) { axisHover = geometry.labels.Count - 1; }
            }
        }
        if (cartesianGeometry != null && cartesianGeometry.kind == "waterfall") {
            ChartFrame frame = cartesianGeometry.frame;
            if (x >= frame.plotX && x < frame.plotX + frame.plotW
            && y >= frame.plotY && y < frame.plotY + frame.plotH && cartesianGeometry.labels.Count > 0) {
                axisHover = frame.CatIndexAt(x, cartesianGeometry.labels.Count);
            }
        }
        if (option.grids.Count > 1 && !option.overlay) {
            hit = matrixGeometry != null ? matrixGeometry.Hit(option, x, y) : null;
        } else { hit = this.BodyHit(app, x, y); }
        if (hit == null || hit.seriesIndex < 0 || hit.seriesIndex >= option.series.Count) { return null; }
        ChartHit result = hit.Clone();
        result.seriesIndex = ChartView.SeriesIndexOf(root, option.series[hit.seriesIndex]);
        return result.seriesIndex >= 0 ? result : null;
    }

    ChartHit BodyHit(App app, int x, int y) {
        if (pieGeometry != null) {
            int index = pieGeometry.HitIndex(app, option, x, y, growth);
            if (index >= 0) {
                PieSlice slice = pieGeometry.layout.slices[index];
                ChartSeries series = option.series[slice.seriesIndex];
                return ChartView.MakeDataHit(series, slice.seriesIndex, slice.dataIndex,
                slice.name, ChartElementType.PieSlice, x, y, slice.value);
            }
        }
        if (parallelGeometry != null) { return parallelGeometry.Hit(x, y); }
        if (pictorialGeometry != null) { return pictorialGeometry.Hit(app, option, x, y); }
        if (sunburstGeometry != null) { return sunburstGeometry.Hit(app, x, y); }
        if (candleGeometry != null) { return candleGeometry.Hit(app, option, x, y, growth); }
        if (bubbleGeometry != null) { return bubbleGeometry.Hit(app, option, x, y, growth); }
        if (statisticalGeometry != null) { return statisticalGeometry.Hit(option, x, y, growth); }
        if (wordCloudGeometry != null) { return wordCloudGeometry.Hit(x, y, growth); }
        if (radarGeometry != null) { return radarGeometry.Hit(app, option, x, y, growth); }
        if (gaugeGeometry != null) { return gaugeGeometry.Hit(option, x, y, growth); }
        if (funnelGeometry != null) { return funnelGeometry.Hit(option, x, y, growth); }
        if (mapGeometry != null) { return mapGeometry.Hit(option, x, y); }
        if (treemapGeometry != null) { return treemapGeometry.Hit(option, x, y); }
        if (vennGeometry != null) { return vennGeometry.Hit(app, option, x, y, growth); }
        if (eventRiverGeometry != null) { return eventRiverGeometry.Hit(app, option, x, y, growth); }
        if (themeRiverGeometry != null) { return themeRiverGeometry.Hit(option, x, y); }
        if (sankeyGeometry != null) { return sankeyGeometry.Hit(app, option, x, y, growth); }
        if (forceGeometry != null) { return forceGeometry.Hit(app, option, x, y, growth); }
        if (chordGeometry != null) { return chordGeometry.Hit(app, option, x, y, growth); }
        if (treeGeometry != null) { return treeGeometry.Hit(app, option, x, y); }
        if (matrixGeometry != null) { return matrixGeometry.Hit(option, x, y); }
        if (heatmapGeometry != null) { return heatmapGeometry.Hit(option, x, y); }
        if (scatterGeometry != null) { return scatterGeometry.Hit(app, option, x, y); }
        if (horizontalGeometry != null) { return horizontalGeometry.Hit(option, x, y, growth, app); }
        if (cartesianGeometry != null) { return cartesianGeometry.Hit(app, option, x, y, growth); }
        return null;
    }

}
