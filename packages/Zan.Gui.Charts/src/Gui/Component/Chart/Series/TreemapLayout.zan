using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// TmPosition 里随行落位而收缩的剩余内容矩形（Zan 无 ref 参数，
// 用对象引用让调用方看到推进）。
public class TmBox {
    public double x;
    public double y;
    public double w;
    public double h;
}

// treemap squarify 布局矩形：绘制与命中共用同一份几何。
public class TmRect {
    public ChartNode node;
    public int depth;
    public int x;
    public int y;
    public int w;
    public int h;

    public static TmRect Of(ChartNode node, int depth, int x, int y, int w, int h) {
        TmRect r = new TmRect();
        r.node = node;
        r.depth = depth;
        r.x = x;
        r.y = y;
        r.w = w;
        r.h = h;
        return r;
    }
}

// 某深度合并后的 treemap 样式（levels[depth] → 系级 tm* → 官方缺省），
// px 值已过 app.Scale。
public class TmStyle {
    public int borderWidth;
    public int gapWidth;
    public int borderColor;
    public int borderColorSat;  // -1 未声明；声明后 borderColor 失效
    public int hasColorSat;  // colorSaturation [lo,hi]（千分值域）
    public int satLo;
    public int satHi;
    public int upperShow;
    public int upperHeight;  // max(borderWidth, show ? height : 0)
    public List<int> color;  // 级 color 数组（null → 继承父级 designated）
    public int colorMappingBy;  // 0 index | 1 value | 2 id
}

// sunburst 深度 d 的环带 [rStart, rEnd]。
public class SunBand {
    public int rStart;
    public int rEnd;
}
