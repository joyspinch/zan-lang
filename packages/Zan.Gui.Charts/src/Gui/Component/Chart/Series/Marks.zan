using System;
using Gui;

namespace Gui.Component.Chart;

// ChartView.Marks.zan - 图表标记子系统（MarkLine 标线、MarkPoint 标点、MarkArea 标域与数值提示）
public partial class ChartView {
    // 系列在窗口 [i0,i1]（含端点）内最大值的下标；
    // 窗口外或空数据返回 -1。markPoint 自动推导共用。
    public static int SeriesMaxIndex(ChartSeries s, int i0, int i1) {
        int maxI = 0 - 1;
        int maxV = 0 - 2147483647 - 1;
        for (int j = i0; j <= i1 && j < s.Count(); j = j + 1) {
            if (j < s.data.Count && s.data[j].gap) { continue; }
            int v = s.Value(j);
            if (v > maxV) { maxV = v; maxI = j; }
        }
        return maxI;
    }
    // 同 SeriesMaxIndex，取最小值下标；空窗口返回 -1。
    public static int SeriesMinIndex(ChartSeries s, int i0, int i1) {
        int minI = 0 - 1;
        int minV = 2147483647;
        for (int j = i0; j <= i1 && j < s.Count(); j = j + 1) {
            if (j < s.data.Count && s.data[j].gap) { continue; }
            int v = s.Value(j);
            if (v < minV) { minV = v; minI = j; }
        }
        return minI;
    }

    // 窗口 [i0,i1] 内系列均值（ECharts markLine type:'average' 的
    // 纯推导 seam；空窗口返回 0）。
    public static int SeriesAverage(ChartSeries s, int i0, int i1) {
        int sum = 0;
        int cnt = 0;
        for (int j = i0; j <= i1 && j < s.Count(); j = j + 1) {
            if (j < s.data.Count && s.data[j].gap) { continue; }
            sum = sum + s.Value(j);
            cnt = cnt + 1;
        }
        if (cnt < 1) { return 0; }
        return sum / cnt;
    }

    // 窗口均值，千分固定点（不会像整数均值那样把 85/7 抹成 12）：
    // sum×1000/cnt（×pointG 定点序列再除 g，原始值均值 = sum/(cnt·g)，
    // 文本需要 avg_raw×1000 = sum×1000/(cnt·g)），中间量走 long。
    // 小数数据项（bar1 的 2.6/162.2）从 Number 取 ×1000 参与累计——
    // 先走 Value() 舍入会把均值砍成整数（41.06 → "41"）。
    public static int SeriesAvg1000(ChartSeries s, int i0, int i1) {
        long sum = 0;  // milli 域累计（大值序列逐项 ×1000，int 会溢）
        int cnt = 0;
        int g = s.pointG > 1 ? s.pointG : 1;
        for (int j = i0; j <= i1 && j < s.Count(); j = j + 1) {
            if (j < s.data.Count && s.data[j].gap) { continue; }
            if (j < s.data.Count && s.data[j].numberSet
                && s.data[j].number != (double)s.data[j].val) {
                double dn = s.data[j].number;
                sum = sum + (int)(dn >= 0 ? dn * 1000.0 + 0.5
                                          : dn * 1000.0 - 0.5);
            } else {
                // data 整数道贡献 ×1000；points 道的 Value 已是
                // ×pointG 定点，按 (1000/g) 折算成 milli 域。
                sum = sum + (long)s.Value(j) * (1000 / g);
            }
            cnt = cnt + 1;
        }
        if (cnt < 1) { return 0; }
        return (int)(sum / (long)cnt);
    }

    // 均值显示串（ECharts markLine 默认标签是具体数值，不是
    // "avg" 字样）：千分固定点四舍五入到两位小数，整数均值不加
    // 小数点（12142 → "12.14"，12000 → "12"）。
    public static string Avg1000Text(int avg1000) {
        int whole = avg1000 / 1000;
        int frac = avg1000 - whole * 1000;
        if (frac < 0) { frac = 0 - frac; }
        frac = (frac + 5) / 10;
        if (frac >= 100) {
            if (whole < 0) { whole = whole - 1; } else { whole = whole + 1; }
            frac = frac - 100;
        }
        if (frac == 0) { return Convert.ToString(whole); }
        string fd = Convert.ToString(frac);
        if (fd.Length < 2) { fd = "0" + fd; }
        return Convert.ToString(whole) + "." + fd;
    }

    // 均值线的 y 像素：均值可带小数，落在两个数据刻度之间。
    // YOf 是仿射（y = B + v*C），因此 y(sum/cnt) = y(0) +
    // (y(sum) - y(0)) / cnt——把 sum 当横向量外推再除以 cnt，
    // 不用浮点也能得到亚数据单位的像素位。×pointG 定点序列
    // 再除 g（sum 本身是定点和）：y(sum/(cnt·g)) =
    // y(0) + (y(sum)−y(0))/(cnt·g)。
    public static int AverageY(ChartFrame f, ChartSeries s, int i0, int i1) {
        int sum = 0;
        int cnt = 0;
        for (int j = i0; j <= i1 && j < s.Count(); j = j + 1) {
            if (j < s.data.Count && s.data[j].gap) { continue; }
            sum = sum + s.Value(j);
            cnt = cnt + 1;
        }
        if (cnt < 1) { return f.YOf(0, s.axisIndex); }
        int y0 = f.YOf(0, s.axisIndex);
        int ySum = f.YOf(sum, s.axisIndex);
        int diff = ySum - y0;
        int den = cnt * (s.pointG > 1 ? s.pointG : 1);
        int q = diff >= 0 ? (diff + den / 2) / den
                          : 0 - ((0 - diff + den / 2) / den);
        return y0 + q;
    }

    // markLine 一条线的实际 y 值（threshold seam）：kind
    // average/min/max 从窗口推导，显式线用 yValue；窗口无数据
    // 返回 Auto() 哨兵 = 不画。
    public static int MarkLineValue(ChartMarkLine m, ChartSeries s, int i0, int i1) {
        if (m.kind == "average") { return ChartView.SeriesAverage(s, i0, i1); }
        if (m.kind == "max") {
            int mi = ChartView.SeriesMaxIndex(s, i0, i1);
            return mi < 0 ? ChartOption.Auto() : s.Value(mi);
        }
        if (m.kind == "min") {
            int mi = ChartView.SeriesMinIndex(s, i0, i1);
            return mi < 0 ? ChartOption.Auto() : s.Value(mi);
        }
        return m.yValue;
    }

    // 值对折线的 x 轴标注线（ECharts markLine data 项
    // valueIndex:0）：对窗口内 points.x 取 max/min/average 画
    // 竖线 + 顶部标签。线色默认 #1e90ff（ECharts 示例惯例）。
    public static void DrawValueXMarkLines(App app, ChartFrame f, ChartSeries s,
                                    int i0, int i1, int nCat) {
        if (s.markLines.Count < 1) { return; }
        Canvas c = app.canvas;
        for (int mi = 0; mi < s.markLines.Count; mi = mi + 1) {
            ChartMarkLine m = s.markLines[mi];
            if (m.valueIndex != 0) { continue; }
            int n = i1 - i0 + 1;
            if (n < 1) { n = 1; }
            int sum = 0;
            int cnt = 0;
            int ext = m.kind == "min" ? 2147483647 : 0 - 2147483647 - 1;
            for (int j = i0; j <= i1 && j < s.points.Count; j = j + 1) {
                int xv = s.points[j].x;
                sum = sum + xv;
                cnt = cnt + 1;
                if (m.kind == "min" && xv < ext) { ext = xv; }
                if (m.kind == "max" && xv > ext) { ext = xv; }
            }
            // 类目系列（data 路径）没有 points：{xAxis:n} 竖线落在
            // 类目槽位上（area-pieces 的区间分隔线）；类目轴无
            // max/min/average 语义。nCat = 窗口内类目数。
            if (s.points.Count < 1) {
                if (m.kind.Length > 0) { continue; }
                if (nCat < 1) { continue; }
                int ci = m.xValue - i0;
                if (ci < 0 || ci >= nCat) { continue; }
            } else if (cnt < 1) { continue; }
            int vx = m.kind.Length > 0 ? ext : m.xValue;
            // 均值可带小数（104/9=11.56），整数 sum/cnt 会把线打在
            // 11 上、与标签对不上。XOfValue 仿射：x(sum/cnt) = x(0)
            // + (x(sum)-x(0))/cnt，四舍五入得亚数据单位的像素位。
            // ×pointG 定点序列 sum 是定点和：x(sum/(cnt·g)) =
            // x(0) + (x(sum)−x(0))/(cnt·g)。
            int lx = 0;
            if (s.points.Count > 0 && m.kind == "average") {
                int x0v = f.XOfValue(0);
                int xSv = f.XOfValue(sum);
                int diff = xSv - x0v;
                int den = cnt * (s.pointG > 1 ? s.pointG : 1);
                int q = diff >= 0 ? (diff + den / 2) / den
                                  : 0 - ((0 - diff + den / 2) / den);
                lx = x0v + q;
            } else if (s.points.Count > 0) {
                lx = f.XOfValue(Chart.PointV(vx, s.pointG));
            } else {
                lx = f.CatX(m.xValue - i0, nCat);
            }
            // ECharts markLine 默认跟随系列色（#1e90ff 是旧参考站
            // 特例，官方画廊一律系列色）。
            int col = m.color != 0 ? m.color : s.color;
            string lt = m.lineType.Length > 0 ? m.lineType : "dashed";
            int dash = app.Scale(6);
            int gap = app.Scale(6);
            if (lt == "dotted") { dash = app.Scale(2); gap = app.Scale(2); }
            int dy = f.plotY;
            while (dy < f.plotY + f.plotH) {
                int seg = dash;
                if (dy + seg > f.plotY + f.plotH) { seg = f.plotY + f.plotH - dy; }
                c.FillRect(lx, dy, 1, seg, col);
                dy = dy + dash + gap;
            }
            if (m.labelShow) {
                int fs = ChartFonts.SeriesLabel(app);
                // 标签默认是具体数值（ECharts markLine.label 默认 {c}），
                // 不是 "max/min/avg" 字样；显式 label 可带 {value} 占位。
                string lbl = m.label;
                if (lbl.Length == 0) {
                    if (m.kind == "average") {
                        int g = s.pointG > 1 ? s.pointG : 1;
                        lbl = ChartView.Avg1000Text(
                            (int)(((long)sum * 1000L) / ((long)cnt * (long)g)));
                    } else {
                        lbl = Chart.PointText(vx, s.pointG);
                    }
                } else {
                    lbl = lbl.Replace("{value}", Chart.PointText(vx, s.pointG));
                }
                int lw = Canvas.MeasureText(lbl, fs);
                int tx = lx - lw / 2;
                if (tx < f.plotX) { tx = f.plotX; }
                if (tx + lw > f.plotX + f.plotW) { tx = f.plotX + f.plotW - lw; }
                c.DrawText(tx, f.plotY + app.Scale(1), lbl, col, fs);
            }
            if (m.endArrow) {
                ChartView.DrawMarkArrow(app, c, lx, f.plotY + f.plotH, col, false);
            }
        }
    }

    // ECharts series.markArea 区间带（o.markAreas）：x 类目竖带
    // 横跨整个绘图区（boundaryGap=false 时贴刻度），y 值横带；
    // 显式 itemStyle 色原样，缺省走主题 mark-area 低透明底。
    // name 非空时在带内顶部居中绘制标签（系列色，同 markLine）。
    public static void DrawMarkAreaBands(App app, ChartFrame f, ChartOption o,
                                  int i0, int nCat, int seriesColor) {
        if (o.markAreas.Count < 1) { return; }
        Canvas c = app.canvas;
        int fs = ChartFonts.SeriesLabel(app);
        for (int i = 0; i < o.markAreas.Count; i = i + 1) {
            ChartMarkArea a = o.markAreas[i];
            int col = a.color;
            if (col == 0) {
                col = ChartColor.WithAlpha(Style.Part(app, "chart", "mark-area",
                    "", "", "", Style.SNormal()).BgOr(0), 28);
            }
            int x0; int x1; int y0; int y1;
            if (a.xMode) {
                if (nCat < 1) { continue; }
                x0 = f.CatX(a.v0 - i0, nCat);
                x1 = f.CatX(a.v1 - i0, nCat);
                if (x1 < x0) { int tmp = x0; x0 = x1; x1 = tmp; }
                if (x1 < f.plotX || x0 > f.plotX + f.plotW) { continue; }
                y0 = f.plotY;
                y1 = f.plotY + f.plotH;
            } else {
                y0 = f.YOf(a.v1, 0);
                y1 = f.YOf(a.v0, 0);
                if (y1 < y0) { int tmp = y0; y0 = y1; y1 = tmp; }
                x0 = f.plotX;
                x1 = f.plotX + f.plotW;
            }
            c.FillRect(x0, y0, x1 - x0, y1 - y0, col);
            if (a.name.Length > 0) {
                int lw = Canvas.MeasureText(a.name, fs);
                int tx = (x0 + x1) / 2 - lw / 2;
                if (tx < f.plotX) { tx = f.plotX; }
                if (tx + lw > f.plotX + f.plotW) { tx = f.plotX + f.plotW - lw; }
                c.DrawText(tx, f.plotY + app.Scale(2), a.name, seriesColor, fs);
            }
        }
    }

    // 值对折线（points 系列）的 markPoint（ECharts series.markPoint）：
    // valueIndex -1（默认纵轴）按 points.y 取 max/min，标签
    // 上/下（ECharts position top/bottom）；valueIndex 0（横轴）
    // 按 points.x 取 max/min，标签右/左。符号/颜色逐项覆盖
    // （参考站 line7：红纵轴 + 蓝横轴空心圆）。
    public static void DrawPointsMarkPoints(App app, ChartFrame f, ChartSeries s,
                                     int i0, int i1) {
        if (s.marks.Count < 1 || s.points.Count < 1) { return; }
        Canvas c = app.canvas;
        for (int mi = 0; mi < s.marks.Count; mi = mi + 1) {
            ChartMarkPoint m = s.marks[mi];
            if (m.kind != "max" && m.kind != "min") { continue; }
            bool onX = m.valueIndex == 0;
            int ext = m.kind == "min" ? 2147483647 : 0 - 2147483647 - 1;
            int found = 0 - 1;
            for (int j = i0; j <= i1 && j < s.points.Count; j = j + 1) {
                int v = Chart.PointV(onX ? s.points[j].x : s.points[j].y,
                    s.pointG);
                if ((m.kind == "min" && v < ext) || (m.kind == "max" && v > ext)) {
                    ext = v;
                    found = j;
                }
            }
            if (found < 0) { continue; }
            int lx = f.XOfValue(Chart.PointV(s.points[found].x, s.pointG));
            int ly = f.YOf(Chart.PointV(s.points[found].y, s.pointG), s.axisIndex);
            int rad = m.sizeSet && m.size > 0 ? m.size / 2 : app.Scale(4);
            int col = m.color != 0 ? m.color : s.color;
            string sym = m.symbol.Length > 0 ? m.symbol : "";
            if (sym.Length > 0) {
                Chart.DrawSymbol(c, lx, ly, rad, sym, col, 0, 0);
            } else {
                c.FillCircle(lx, ly, rad, col);
                ChartView.RingOutline(c, lx, ly, rad, 0xFFFFFFFF);
            }
            // 值对/points 系列的标注：默认 "max/min" 字样补上数值
            // （ECharts markPoint.label 默认 {c}）；显式 label 组合
            // "name: value"（与类目系 DrawSeriesMarks 同形，bar13
            // 的"最大值"不能吞掉数值），{value} 占位仍原样替换。
            string lbl = m.label;
            if (lbl.Length == 0) {
                lbl = m.kind + ": " + Chart.PointText(ext, s.pointG);
            } else if (lbl.IndexOf("{value}") >= 0) {
                lbl = lbl.Replace("{value}", Chart.PointText(ext, s.pointG));
            } else {
                lbl = lbl + ": " + Chart.PointText(ext, s.pointG);
            }
            int fs = ChartFonts.SeriesLabel(app);
            int lw = Canvas.MeasureText(lbl, fs);
            int tx = lx - lw / 2;
            int ty = ly - Canvas.FontHeight(fs) - app.Scale(1);
            if (onX) {
                // 横轴标注：max 贴右侧、min 贴左侧（ECharts right/left）。
                if (m.kind == "max") { tx = lx + rad + app.Scale(2); }
                else { tx = lx - rad - app.Scale(2) - lw; }
                ty = ly - Canvas.FontHeight(fs) / 2;
            } else if (m.kind == "min") {
                ty = ly + rad + app.Scale(2);
            }
            if (tx < f.plotX) { tx = f.plotX; }
            if (tx + lw > f.plotX + f.plotW) { tx = f.plotX + f.plotW - lw; }
            c.DrawText(tx, ty, lbl,
                Style.Part(app, "chart", "label", "", "", "", Style.SNormal()).FgOr(0),
                fs);
        }
    }

    // 数据标签文本（柱状/条形族）：data[i].labelText 覆盖（bar10
    // Forecast 的标签是两系列之和）→ series.labelFmt 模板
    // （{a}=系列名 {b}=类目 {c}=值）→ 缺省数值字符串。
    // 模板带富文本壳（bar-label-rotation 的 "{c}  {name|{a}}"）时
    // 剥壳——壳是样式标记，直接 DrawText 会把花括号画出来；壳内
    // 样式为空（rich 声明 `{}`）时官方渲染与本引擎 plain 同像素。
    public static string LabelText(ChartSeries s, int di, string cat, int v) {
        if (di >= 0 && di < s.data.Count && s.data[di].labelText.Length > 0) {
            return Chart.RichStrip(s.data[di].labelText);
        }
        if (s.labelFmt.Length == 0) { return Convert.ToString(v); }
        string r = s.labelFmt;
        r = r.Replace("{a}", s.name);
        r = r.Replace("{b}", cat);
        r = r.Replace("{c}", Convert.ToString(v));
        return Chart.RichStrip(r);
    }

    // 值对折线（points 系列）的悬停：按距离命中最近点并出
    // tooltip 卡（line7 formatter："系列 : [ x, y ]"）。双数值轴
    // 配 axisPointer type:'cross' 时（tooltip.js _showAxisTrigger）
    // 先画十字虚线（lineStyle dashed width 1），并跟随光标出
    // "( x , y )" 轴值读数——x/y 反解自两个数值轴（getValueFromCoord
    // 的 toFixed(2)-0 语义：两位小数去尾零），文本象限按右缘
    // 100px / 顶缘 50px 阈值择向。
    public static void PointsHover(App app, ChartFrame f, List<ChartSeries> series,
                            int i0, int i1, int g, bool cross) {
        int mx = app.mouseX;
        int my = app.mouseY;
        if (mx < f.plotX || mx >= f.plotX + f.plotW
            || my < f.plotY || my >= f.plotY + f.plotH) { return; }
        // 指针被上层弹层/抽屉接管时不再命中与出卡（悬停穿透）。
        if (app.PointerCaptured()) { return; }
        if (cross) {
            Canvas c = app.canvas;
            int crossCol = Style.Part(app, "chart", "crosshair", "", "", "",
                                      Style.SNormal()).BgOr(0);
            if (crossCol != 0) {
                int lineCol = ChartColor.WithAlpha(crossCol, 200);
                int dash = app.Scale(5);
                int gp = app.Scale(3);
                int cvy = f.plotY;
                while (cvy < f.plotY + f.plotH) {
                    int seg = dash;
                    if (cvy + seg > f.plotY + f.plotH) { seg = f.plotY + f.plotH - cvy; }
                    c.FillRect(mx, cvy, 1, seg, lineCol);
                    cvy = cvy + dash + gp;
                }
                int cvx = f.plotX;
                while (cvx < f.plotX + f.plotW) {
                    int seg = dash;
                    if (cvx + seg > f.plotX + f.plotW) { seg = f.plotX + f.plotW - cvx; }
                    c.FillRect(cvx, my, seg, 1, lineCol);
                    cvx = cvx + dash + gp;
                }
                int fs = ChartFonts.SeriesLabel(app);
                int yAx = 0;
                for (int asi = 0; asi < series.Count; asi = asi + 1) {
                    if (!series[asi].hidden) { yAx = series[asi].axisIndex; break; }
                }
                // x 值反解（×1000 定点中间量）：xLo + (mx-plotX) ×
                // span / plotW，FracText 除回（toFixed(2)-0 同形）。
                long xvF = (long)f.xLo * 1000
                    + (long)(mx - f.plotX) * (long)(f.xHi - f.xLo) * 1000 / f.plotW;
                string coord = "( " + Chart.FracText((int)xvF)
                    + " , " + f.ValueTextAtY(my, yAx) + " )";
                int tw = Canvas.MeasureText(coord, fs);
                int tx = mx + app.Scale(10);
                if (f.plotX + f.plotW - mx <= app.Scale(100)) { tx = mx - app.Scale(10) - tw; }
                int ty = my + app.Scale(10);
                if (my - f.plotY > app.Scale(50)) {
                    ty = my - app.Scale(10) - Canvas.FontHeight(fs);
                }
                int labelFg = Style.Part(app, "chart", "crosshair-label", "", "",
                    "", Style.SNormal()).FgOr(0);
                c.DrawText(tx, ty, coord, labelFg, fs);
            }
        }
        int bestD = 0;
        ChartHit best = null;
        int grab = app.Scale(10);
        for (int si = 0; si < series.Count; si = si + 1) {
            ChartSeries s = series[si];
            if (s.hidden || s.points.Count < 1) { continue; }
            for (int j = i0; j <= i1 && j < s.points.Count; j = j + 1) {
                int px = f.XOfValue(s.points[j].x);
                int py = f.YOf(s.points[j].y, s.axisIndex);
                int dx = mx - px;
                int dy2 = my - py;
                int d2 = dx * dx + dy2 * dy2;
                if (d2 <= grab * grab && (best == null || d2 < bestD)) {
                    bestD = d2;
                    best = ChartView.MakeDataHit(s, si, j,
                        Convert.ToString(s.points[j].x),
                        ChartElementType.ScatterPoint, px, py, s.points[j].y);
                    best.xValueSet = true;
                    best.xValue = (double)s.points[j].x;
                    best.yValueSet = true;
                    best.yValue = (double)s.points[j].y;
                }
            }
        }
        if (best == null) { return; }
        ChartView.OfferActiveHit(best);
        List<TooltipRow> rows = new List<TooltipRow>();
        rows.Add(TooltipRow.Of(best.value,
            best.seriesName + " : [ " + Convert.ToString((int)best.xValue)
            + ", " + Convert.ToString(best.value) + " ]"));
        ChartView.TooltipCard(app, mx, my, 2147483647, rows);
    }

    // 该系列折线是否被 visualMap 逐点着色（连续渐变或分段）：
    // 窗口内任一数据点命中即开——描边切子段插值通道。
    public static bool VisualStrokeOn(ChartOption o, int seriesIndex, ChartSeries s) {
        if (o.visualMaps.Count < 1) { return false; }
        // 的线保持 #5470C6 正是这条规则）。Materialize 会把未声明
        // 的线色回填成调色板色，因此用解析期标记而非运行期颜色。
        return s.visBlocked == false;
    }

    // 系列是否落在 piecewise visualMap 作用域内：分段着色的段
    // 边界取起点 piece 色（硬切换），不做连续渐变。
    public static bool VisualPiecewiseOn(ChartOption o, int seriesIndex) {
        for (int i = 0; i < o.visualMaps.Count; i = i + 1) {
            ChartVisualMap vm = o.visualMaps[i];
            if (vm.type == 1 && (vm.seriesIndex == 0 - 1
                || vm.seriesIndex == seriesIndex)) { return true; }
        }
        return false;
    }

    // markLine 末端箭头（ECharts markLine 默认
    // symbol:['none','arrow']）：horizontal 时在 (ex,ey) 画右向
    // 箭镞，否则画下向箭镞。箭头属线色，尺寸随刻度；终点在
    // 绘图区边上，clip 放行 1px 防整箭头被裁。
    public static void DrawMarkArrow(App app, Canvas c, int ex, int ey, int col,
                              bool horizontal) {
        ChartRenderContext ctx = Chart.renderContext;
        if (ctx == null) {
            Chart.renderContext = new ChartRenderContext();
            ctx = Chart.renderContext;
        }
        ctx.EnsureScratch();
        List<int> vx = ctx.pooledPx;
        List<int> vy = ctx.pooledPy;
        vx.Clear();
        vy.Clear();
        Chart.PolyVerts1000("arrow", vx, vy);
        if (!horizontal) {
            // 上指箭镞旋转 90°（顺时针）为右向：x' = -y, y' = x。
            for (int i = 0; i < vx.Count; i = i + 1) {
                int nx = 0 - vy[i];
                vy[i] = vx[i];
                vx[i] = nx;
            }
        }
        c.PushClip(ex - app.Scale(6), ey - app.Scale(6),
            app.Scale(13), app.Scale(13));
        Chart.FillPoly1000(c, ex, ey, app.Scale(4), vx, vy, col);
        c.PopClip();
    }

    // 系列级 markLine（ECharts series.markLine）：窗口水平线 +
    // 右端标签。kind average/min/max 从窗口推导；显式 yValue。
    // 线色默认系列色（markLine 用 itemStyle 色，非全局 mark
    // 灰），lineType 默认 dashed。柱/线渲染器共用。
    public static void DrawSeriesMarkLines(App app, ChartFrame f, ChartSeries s,
                                    int i0, int i1, ChartOption o) {
        if (s.markLines.Count < 1) { return; }
        Canvas c = app.canvas;
        int nWin = i1 - i0 + 1;
        if (nWin < 1) { nWin = 1; }
        for (int mi = 0; mi < s.markLines.Count; mi = mi + 1) {
            ChartMarkLine m = s.markLines[mi];
            // 两点斜线（coord 对，回归/趋势线）：x 按数值域映射
            // （frame.xLo/xHi，散点等数值 x 视图填充）；类目轴视图
            // 数值域未设时 coord x 是类目下标，按 CatX 槽位映射
            // （line-markline 的 coord:[0,0.3]→[3,1]）。
            if (m.hasEnd) {
                int px1;
                int px2;
                if (f.xHi > f.xLo) {
                    px1 = Chart.ValueX(f.plotX, f.plotW, f.xLo, f.xHi, m.xValue);
                    px2 = Chart.ValueX(f.plotX, f.plotW, f.xLo, f.xHi, m.x2Value);
                } else {
                    px1 = f.CatX(m.xValue, nWin);
                    px2 = f.CatX(m.x2Value, nWin);
                }
                int py1 = f.YOf(Chart.PointV(m.yValue, s.pointG), s.axisIndex);
                int py2 = f.YOf(Chart.PointV(m.y2Value, s.pointG), s.axisIndex);
                int col = m.color != 0 ? m.color : s.color;
                string lt = m.lineType.Length > 0 ? m.lineType : "solid";
                if (lt == "solid") {
                    c.DrawLine(px1, py1, px2, py2, col, 1);
                } else {
                    int dash = app.Scale(6);
                    int gap = lt == "dotted" ? app.Scale(2) : app.Scale(6);
                    if (lt == "dotted") { dash = app.Scale(2); }
                    int adx = px2 > px1 ? px2 - px1 : px1 - px2;
                    int ady = py2 > py1 ? py2 - py1 : py1 - py2;
                    int steps = adx > ady ? adx : ady;
                    if (steps < 1) { steps = 1; }
                    int cur = 0;
                    bool on = true;
                    while (cur < steps) {
                        int end = cur + dash;
                        if (end > steps) { end = steps; }
                        if (on) {
                            c.DrawLine(px1 + (px2 - px1) * cur / steps,
                                py1 + (py2 - py1) * cur / steps,
                                px1 + (px2 - px1) * end / steps,
                                py1 + (py2 - py1) * end / steps, col, 1);
                        }
                        cur = end + gap;
                        on = !on;
                    }
                }
                if (m.labelShow && m.label.Length > 0) {
                    int fs = ChartFonts.SeriesLabel(app);
                    int lw2 = Canvas.MeasureText(m.label, fs);
                    int lx2 = px2 + app.Scale(4);
                    if (lx2 + lw2 > f.plotX + f.plotW) {
                        lx2 = px2 - lw2 - app.Scale(4);
                    }
                    c.DrawText(lx2, py2 - Canvas.FontHeight(fs) - app.Scale(2),
                        m.label, col, fs);
                }
                continue;
            }
            if (m.valueIndex == 0) { continue; }  // x 轴竖线另绘
            bool isAvg = m.kind == "average";
            int val = ChartView.MarkLineValue(m, s, i0, i1);
            if (val == ChartOption.Auto()) { continue; }
            // 均值线画在真实均值处（可带小数），min/max/显式线在
            // 整数数据位上（×pointG 定点值先除回原始域）。
            int ly = isAvg ? ChartView.AverageY(f, s, i0, i1)
                           : f.YOf(Chart.PointV(val, s.pointG), s.axisIndex);
            int col = m.color != 0 ? m.color : s.color;
            string lt = m.lineType;
            if (lt.Length == 0) { lt = "dashed"; }
            if (lt == "solid") {
                c.FillRect(f.plotX, ly, f.plotW, 1, col);
            } else {
                int dash = app.Scale(6);
                int gap = lt == "dotted" ? app.Scale(2) : app.Scale(6);
                if (lt == "dotted") { dash = app.Scale(2); }
                int dx = f.plotX;
                while (dx < f.plotX + f.plotW) {
                    int seg = dash;
                    if (dx + seg > f.plotX + f.plotW) { seg = f.plotX + f.plotW - dx; }
                    c.FillRect(dx, ly, seg, 1, col);
                    dx = dx + dash + gap;
                }
            }
            // 标签默认是具体数值（ECharts 默认 markLine.label 即
            // {c}），不是 "avg/min/max" 字样；显式 label 仍可带
            // {value} 占位。
            // 同 DrawSeriesMarkLines：默认具体数值，显式 label 支持
            // {value} 占位，无占位则 "name: value"。
            if (m.labelShow) {
                // 均值文本一律走千分定点（Avg1000Text 出 "41.06"），
                // min/max/显式线走整数域 PointText；显式 name 的
                // 缺省标签是 "Avg: 41.06"（官方 bar1）。
                string valTxt = isAvg
                    ? ChartView.Avg1000Text(ChartView.SeriesAvg1000(s, i0, i1))
                    : Chart.PointText(val, s.pointG);
                string lbl = m.label;
                if (lbl.Length == 0) {
                    lbl = valTxt;
                } else if (lbl.IndexOf("{value}") >= 0) {
                    lbl = lbl.Replace("{value}", valTxt);
                } else {
                    lbl = lbl + ": " + valTxt;
                }
                int fs = ChartFonts.SeriesLabel(app);
                int lw = Canvas.MeasureText(lbl, fs);
                int lx = f.plotX + f.plotW - lw;
                if (lx < f.plotX) { lx = f.plotX; }
                c.DrawText(lx, ly - Canvas.FontHeight(fs) - app.Scale(1), lbl, col, fs);
            }
            if (m.endArrow) {
                ChartView.DrawMarkArrow(app, c, f.plotX + f.plotW, ly, col, true);
            }
        }
    }

    // 水平柱的系列级 markLine（DrawSeriesMarkLines 的转置）：
    // 值经 lo/hi -> 横向像素映射后画纵向线，顶部标签右旋对齐。
    public static void DrawHBarMarkLines(App app, int plotX, int plotY, int plotW, int plotH,
                                  int lo, int hi, ChartSeries s, int i0, int i1) {
        if (s.markLines.Count < 1) { return; }
        Canvas c = app.canvas;
        for (int mi = 0; mi < s.markLines.Count; mi = mi + 1) {
            ChartMarkLine m = s.markLines[mi];
            int val = ChartView.MarkLineValue(m, s, i0, i1);
            if (val == ChartOption.Auto()) { continue; }
            int lx = Chart.ValueX(plotX, plotW, lo, hi, val);
            int col = m.color != 0 ? m.color : s.color;
            string lt = m.lineType;
            if (lt.Length == 0) { lt = "dashed"; }
            if (lt == "solid") {
                c.FillRect(lx, plotY, 1, plotH, col);
            } else {
                int dash = app.Scale(6);
                int gap = lt == "dotted" ? app.Scale(2) : app.Scale(6);
                if (lt == "dotted") { dash = app.Scale(2); }
                int dy = plotY;
                while (dy < plotY + plotH) {
                    int seg = dash;
                    if (dy + seg > plotY + plotH) { seg = plotY + plotH - dy; }
                    c.FillRect(lx, dy, 1, seg, col);
                    dy = dy + dash + gap;
                }
            }
            if (m.labelShow) {
                // 同 DrawSeriesMarkLines：默认具体数值，显式 label 支持
                // {value} 占位，无占位则 "name: value"。
                string lbl = m.label;
                if (lbl.Length == 0) {
                    if (m.kind == "average") {
                        lbl = ChartView.Avg1000Text(
                            ChartView.SeriesAvg1000(s, i0, i1));
                    } else {
                        lbl = Convert.ToString(val);
                    }
                } else if (lbl.IndexOf("{value}") >= 0) {
                    lbl = lbl.Replace("{value}", Convert.ToString(val));
                } else if (m.kind == "average") {
                    // 横向柱转置版与竖排同语义："Avg: 41.06"。
                    lbl = lbl + ": " + ChartView.Avg1000Text(
                        ChartView.SeriesAvg1000(s, i0, i1));
                } else {
                    lbl = lbl + ": " + Convert.ToString(val);
                }
                int fs = ChartFonts.SeriesLabel(app);
                int lw = Canvas.MeasureText(lbl, fs);
                int tx = lx - lw / 2;
                if (tx < plotX) { tx = plotX; }
                if (tx + lw > plotX + plotW) { tx = plotX + plotW - lw; }
                c.DrawText(tx, plotY - Canvas.FontHeight(fs) - app.Scale(1), lbl, col, fs);
            }
            if (m.endArrow) {
                ChartView.DrawMarkArrow(app, c, lx, plotY + plotH, col, false);
            }
        }
    }

    // 系列 markPoint 标记：o.markPoint=true 时自动标出窗口
    // [i0,i1] 内的最大/最小值；series.marks 的显式项也绘制
    // （dataIndex 定位；kind=max/min 回退到自动推导的极值）。
    // 柱状图与折线图共用。f 提供 YOf 映射。
    // markPoint 的本系列柱内 x：barX 是类目 0 处本系列柱条中线，
    // 数据点挂在第 slot 类目 —— 按类目带宽平移（CatMid 差值含末格
    // 余数摊薄，与主循环 bx = CatLeft + g0 + slot*(barW+gap) 精确
    // 同式）。barX == 0 是折线模式的哨兵：走数据点 CatX。
    public static int BarMarkX(ChartFrame f, int barX, int slot, double band) {
        if (barX == 0) { return 0; }
        return barX + ChartView.RoundPx((double)slot * band);
    }

    public static void DrawSeriesMarks(App app, ChartFrame f, ChartSeries s,
                                int i0, int i1, double band, int barX,
                                ChartOption o) {
        if (!o.markPoint && s.marks.Count < 1) { return; }
        int maxI = ChartView.SeriesMaxIndex(s, i0, i1);
        int minI = ChartView.SeriesMinIndex(s, i0, i1);
        int nWin = i1 - i0 + 1;
        if (nWin < 1) { nWin = 1; }
        if (o.markPoint) {
            bool below = o.showValues || s.labelShow;
            // 徽标里写具体数值（ECharts markPoint.label 默认 {c}），
            // 不是 "max/min" 字样。
            if (maxI >= 0) {
                ChartView.MarkAt(app, f, s, maxI, maxI - i0, nWin,
                    Chart.SeriesNumText(s, maxI), below, 0, "", 0,
                    ChartView.BarMarkX(f, barX, maxI - i0, band));
            }
            if (minI >= 0 && minI != maxI) {
                ChartView.MarkAt(app, f, s, minI, minI - i0, nWin,
                    Chart.SeriesNumText(s, minI), below, 0, "", 0,
                    ChartView.BarMarkX(f, barX, minI - i0, band));
            }
        }
        for (int mi = 0; mi < s.marks.Count; mi = mi + 1) {
            ChartMarkPoint m = s.marks[mi];
            if (m.valueIndex == 0) { continue; }  // x 轴标注由 points 路径绘制
            int idx = m.dataIndex;
            if (idx < 0) {
                if (m.kind == "max") { idx = maxI; }
                else if (m.kind == "min") { idx = minI; }
                else { idx = 0 - 1; }
            }
            if (idx < i0 || idx > i1 || idx >= s.Count()) { continue; }
            // {a}=系列名 {b}=mark data name {c}=值；块自带盒样式，
            // position right（缺省 top）+ distance 锚在 mark 点旁；
            // symbolSize 声明时 mark 点画小点、不再画 pin 气球。
            if (s.markLabelSt != null && s.markLabelSt.rich != null) {
                Canvas c = app.canvas;
                string fmt2 = s.markLabelFmt.Length > 0 ? s.markLabelFmt : "{c}";
                string raw2 = fmt2
                    .Replace("{a}", s.name)
                    .Replace("{b}", m.name)
                    .Replace("{c}", Chart.SeriesNumText(s, idx));
                RichBlock blk = ChartView.RichLayout(app,
                    Chart.RichTokenize(raw2, s.markLabelSt), s.markLabelSt,
                    ChartFonts.SeriesLabel(app));
                int dist2 = s.markLabelDist >= 0
                    ? app.Scale(s.markLabelDist) : app.Scale(5);
                int mxp = ChartView.BarMarkX(f, barX, idx - i0, band);
                int myp = f.YOf(s.Value(idx), s.axisIndex);
                // symbolOffset 偏移
                int mOffX = 0;
                int mOffY = 0;
                if (m.offSet) {
                    mOffX = app.Scale(m.offX);
                    mOffY = app.Scale(m.offY);
                } else if (s.markOffSet) {
                    int mBase = s.markSymbolSize >= 0 ? s.markSymbolSize : 20;
                    mOffX = s.markOffXPct != 0 ? mBase * s.markOffXPct / 100 : app.Scale(s.markOffX);
                    mOffY = s.markOffYPct != 0 ? mBase * s.markOffYPct / 100 : app.Scale(s.markOffY);
                }
                mxp = mxp + mOffX;
                myp = myp + mOffY;
                int inkC = Style.Part(app, "chart", "label", "", "", "",
                    Style.SNormal()).FgOr(0);
                if (s.markLabelPos == "right") {
                    ChartView.RichDraw(app, c, mxp + dist2, myp - blk.h / 2,
                        blk, inkC);
                } else {
                    ChartView.RichDraw(app, c, mxp - blk.w / 2,
                        myp - dist2 - blk.h, blk, inkC);
                }
                if (s.markSymbolSize >= 0) {
                    int sr = app.Scale(s.markSymbolSize);
                    if (sr < 1) { sr = 1; }
                    c.FillCircle(mxp, myp, sr, m.color != 0 ? m.color : s.color);
                }
                continue;
            }
            // ECharts markPoint.label 缺省 {c}：徽标里只写数值——
            // name（年最高/最大值）是 tooltip 元数据，不进徽标。
            string lbl = m.label;
            if (lbl.IndexOf("{value}") >= 0) {
                lbl = lbl.Replace("{value}", Chart.SeriesNumText(s, idx));
            } else {
                lbl = Chart.SeriesNumText(s, idx);
            }
            int mOffX = 0;
            int mOffY = 0;
            if (m.offSet) {
                mOffX = app.Scale(m.offX);
                mOffY = app.Scale(m.offY);
            } else if (s.markOffSet) {
                int mBase = m.sizeSet && m.size > 0 ? m.size : (s.markSymbolSize >= 0 ? s.markSymbolSize : 20);
                mOffX = s.markOffXPct != 0 ? mBase * s.markOffXPct / 100 : app.Scale(s.markOffX);
                mOffY = s.markOffYPct != 0 ? mBase * s.markOffYPct / 100 : app.Scale(s.markOffY);
            }
            int markBx = ChartView.BarMarkX(f, barX, idx - i0, band) + mOffX;
            ChartView.MarkAt(app, f, s, idx, idx - i0, nWin, lbl,
                o.showValues || s.labelShow, m.color, m.symbol,
                m.sizeSet ? m.size : 0,
                markBx, mOffY);
        }
    }

    // 横向柱的 markPoint（转置 xMarkMap；bar-rich-text 摘要卡）：
    // mark 点 y = 本系列柱条在行带内的中心线、x = 值位置（柱端）。
    // series 级 markPoint.label.rich 声明时画富文本卡（position
    // right/top + distance，块自带盒样式），symbolSize 声明时 mark
    // 点画小点；无 rich 的 mark 退化为端点圆徽标 + 数值。
    public static void DrawSeriesMarksH(App app, ChartSeries s,
                                 int baseIdx, int n, double band,
                                 ChartBarCol hbc, int plotY, int plotX,
                                 int plotW, int lo, int hi) {
        if (s.marks.Count < 1) { return; }
        Canvas c = app.canvas;
        int maxI = ChartView.SeriesMaxIndex(s, 0, s.Count() - 1);
        int minI = ChartView.SeriesMinIndex(s, 0, s.Count() - 1);
        for (int mi = 0; mi < s.marks.Count; mi = mi + 1) {
            ChartMarkPoint m = s.marks[mi];
            int idx = m.dataIndex;
            if (idx < 0) {
                if (m.kind == "max") { idx = maxI; }
                else if (m.kind == "min") { idx = minI; }
            }
            if (idx < 0 || idx >= s.Count()) { continue; }
            int rowI = idx - baseIdx;
            if (rowI < 0 || rowI >= n) { continue; }
            int vx = Chart.ValueX(plotX, plotW, lo, hi, s.Value(idx));
            int by = ChartView.BarY0(plotY, rowI, band, hbc.offset);
            int barH = hbc.width > 0.0
                ? ChartView.RoundPx((double)plotY + ((double)rowI + 0.5) * band
                    + hbc.offset + hbc.width) - by
                : 0;
            int myp = by + barH / 2;
            int mOffX = 0;
            int mOffY = 0;
            if (m.offSet) {
                mOffX = app.Scale(m.offX);
                mOffY = app.Scale(m.offY);
            } else if (s.markOffSet) {
                int mBase = s.markSymbolSize >= 0 ? s.markSymbolSize : 20;
                mOffX = s.markOffXPct != 0 ? mBase * s.markOffXPct / 100 : app.Scale(s.markOffX);
                mOffY = s.markOffYPct != 0 ? mBase * s.markOffYPct / 100 : app.Scale(s.markOffY);
            }
            vx = vx + mOffX;
            myp = myp + mOffY;
            if (s.markLabelSt != null && s.markLabelSt.rich != null) {
                string fmt2 = s.markLabelFmt.Length > 0 ? s.markLabelFmt : "{c}";
                string raw2 = fmt2.Replace("{a}", s.name)
                    .Replace("{b}", m.name)
                    .Replace("{c}", Chart.SeriesNumText(s, idx));
                RichBlock blk = ChartView.RichLayout(app,
                    Chart.RichTokenize(raw2, s.markLabelSt), s.markLabelSt,
                    ChartFonts.SeriesLabel(app));
                int dist2 = s.markLabelDist >= 0
                    ? app.Scale(s.markLabelDist) : app.Scale(5);
                int inkC = Style.Part(app, "chart", "label", "", "", "",
                    Style.SNormal()).FgOr(0);
                if (s.markLabelPos == "right") {
                    ChartView.RichDraw(app, c, vx + dist2, myp - blk.h / 2,
                        blk, inkC);
                } else {
                    ChartView.RichDraw(app, c, vx - blk.w / 2,
                        myp - dist2 - blk.h, blk, inkC);
                }
                if (s.markSymbolSize >= 0) {
                    int sr = app.Scale(s.markSymbolSize);
                    if (sr < 1) { sr = 1; }
                    c.FillCircle(vx, myp, sr, m.color != 0 ? m.color : s.color);
                }
            } else {
                // 端点圆徽标 + 数值（ECharts pin 徽标的横向近似）。
                string lbl = Chart.SeriesNumText(s, idx);
                int fs = ChartFonts.SeriesLabel(app);
                int lw = Canvas.MeasureText(lbl, fs);
                int rr = lw / 2 + app.Scale(5);
                int col = m.color != 0 ? m.color : s.color;
                c.FillCircle(vx, myp, rr, col);
                c.DrawText(vx - lw / 2, Canvas.CenterTextYAt(myp, fs), lbl,
                    ChartColor.ContrastFg(col), fs);
            }
        }
    }

    // 在数据点（类别下标 idx，槽位 slot = idx - i0）上绘制单个
    // 标记。无显式 symbol 时画 ECharts 默认的气球徽标（pin，
    // _iconPin 几何：尾尖钉在数据点上、头在上方，头半径 =
    // symbolSize；label 缺省 {c} 只写数值白字居中）——**具体
    // 数值**写在头里，与拐点零重叠。axOv 传入本系列柱条中线在
    // 类目 0 处的像素（ECharts bar.js xMarkMap：显式/自动
    // markPoint 的 x 都是本系列柱内偏移，不是类目带中线；DrawSeriesMarks
    // 已按数据点类目平移，折线传 0 走 CatX）。
    // 显式 symbol 的标记仍画符号 + 点旁小标签。below 为 true 时
    // 徽标翻到点下方——该系列同时显示数值标签时，点上方已被
    // 数值占据。
    public static void MarkAt(App app, ChartFrame f, ChartSeries s, int idx,
                       int slot, int nWin, string lbl, bool below,
                       int colorOv, string symbolOv, int sizeOv, int axOv) {
        ChartView.MarkAt(app, f, s, idx, slot, nWin, lbl, below, colorOv, symbolOv, sizeOv, axOv, 0);
    }

    public static void MarkAt(App app, ChartFrame f, ChartSeries s, int idx,
                       int slot, int nWin, string lbl, bool below,
                       int colorOv, string symbolOv, int sizeOv, int axOv, int dyOv) {
        Canvas c = app.canvas;
        // ECharts symbolSize = 头半径（半宽参数），不折半；缺省 10。
        int rad = sizeOv > 0 ? sizeOv : app.Scale(10);
        int lx = axOv != 0 ? axOv : f.CatX(slot, nWin);
        int ly = f.YOf(s.Value(idx), s.axisIndex) + dyOv;
        int col = colorOv != 0 ? colorOv : s.color;
        if (symbolOv.Length > 0) {
            Chart.DrawSymbol(c, lx, ly, rad, symbolOv, col, 0, 0);
            ChartView.MarkLabelAt(app, c, f, lx, ly, rad, lbl, below);
            return;
        }
        int mFs = ChartFonts.SeriesLabel(app);
        int lw = Canvas.MeasureText(lbl, mFs);
        // 显式 symbolSize 是几何半径（原版 pin 头 = symbolSize 圆、
        // 尾长 1.5r）；数值挤不进头里才按文字宽度撑头（同原版 auto
        // max/min 的 getTextWidth/2+5 文字适配送径）。
        int hr = rad;
        if (lw + app.Scale(2) > hr * 2) { hr = lw / 2 + app.Scale(5); }
        if (hr < app.Scale(8)) { hr = app.Scale(8); }
        // _iconPin：尾尖在数据点 (ly)，头心在尾尖上方 1.5r。
        int cy = below ? ly + hr + hr / 2 : ly - hr - hr / 2;
        // 尾巴小三角：apex 在尾尖，底边藏进气球头（头后画、盖住
        // 底边接缝）。FillPoly1000 顶点千分比，r = hr，apex 落在
        // (0, ±1000)，中心取 cy ∓ hr/2。
        ChartRenderContext ctx = Chart.renderContext;
        if (ctx == null) {
            Chart.renderContext = new ChartRenderContext();
            ctx = Chart.renderContext;
        }
        ctx.EnsureScratch();
        List<int> vx = ctx.pooledPx;
        List<int> vy = ctx.pooledPy;
        vx.Clear();
        vy.Clear();
        vx.Add(0); vy.Add(below ? 0 - 1000 : 1000);
        vx.Add(0 - 300); vy.Add(below ? 250 : 0 - 250);
        vx.Add(300); vy.Add(below ? 250 : 0 - 250);
        Chart.FillPoly1000(c, lx, cy + (below ? 0 - hr / 2 : hr / 2), hr,
            vx, vy, col);
        c.FillCircle(lx, cy, hr, col);
        c.DrawText(lx - lw / 2, Canvas.CenterTextY(cy - hr, hr * 2, mFs),
            lbl, 0xFFFFFFFF, mFs);
    }

    // 符号旁的小标签（显式 symbol 的标记用）：点上方/下方，
    // 水平钳制进绘图区。
    public static void MarkLabelAt(App app, Canvas c, ChartFrame f, int lx,
                            int ly, int rad, string lbl, bool below) {
        int mFs = ChartFonts.SeriesLabel(app);
        int lw = Canvas.MeasureText(lbl, mFs);
        int tx = lx - lw / 2;
        if (tx < f.plotX) { tx = f.plotX; }
        if (tx + lw > f.plotX + f.plotW) { tx = f.plotX + f.plotW - lw; }
        int ty = below ? ly + rad + app.Scale(2)
                       : ly - Canvas.FontHeight(mFs) - app.Scale(1);
        c.DrawText(tx, ty, lbl,
            Style.Part(app, "chart", "label", "", "", "", Style.SNormal()).FgOr(0),
            mFs);
    }

}
