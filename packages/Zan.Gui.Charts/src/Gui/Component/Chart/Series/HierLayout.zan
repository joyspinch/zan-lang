using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// 树形图布局的中间记录：节点 + 深度 + 叶子 span 起点
// （见 ChartView.TreeAssign）。
public class TreeLayoutNode {
    public ChartNode node;
    public int depth;
    public int lo;
    public int count;

    // 构造布局记录：node/depth/lo/count 全按参数记录
    // （count = 子树叶子槽位数，由调用方传入）。
    public static TreeLayoutNode Of(ChartNode node, int depth, int lo, int count) {
        TreeLayoutNode layout = new TreeLayoutNode();
        layout.node = node;
        layout.depth = depth;
        layout.lo = lo;
        layout.count = count;
        return layout;
    }
}

// 桑基图节点布局：按最长路径分层的层号 + 累计流量决定的
// 高度与 x/y 落点（见 ChartView.DrawSankey）。
public class SankeyNodeLayout {
    public string name;
    public int layer;
    public int flowOut;
    public int flowIn;
    public int x;
    public int y;
    public int h;

    // 构造桑基节点：仅记名字，layer/flow/x/y/h 由布局阶段填充。
    public static SankeyNodeLayout Of(string name) {
        SankeyNodeLayout node = new SankeyNodeLayout();
        node.name = name;
        node.layer = 0;
        node.flowOut = 0;
        node.flowIn = 0;
        node.x = 0;
        node.y = 0;
        node.h = 0;
        return node;
    }
}

// 词云单个词条的放置结果：内容（ChartData 引用）+ 轴对齐
// 包围盒 + 字号/颜色/旋转角。坐标相对绘图区。
public class WordCloudItem {
    public ChartData data;
    // 包围盒左上角（rot != 0 时为旋转后的包围盒）。
    public int x;
    public int y;
    public int w;
    public int h;
    public int fontSize;
    public int color;
    // 旋转角（度，0/90 来自 ECharts rotateRange 的两态，自定义角度集
    // 由 wcRotateList 提供）；旋转项的 x/y/w/h 存的是旋转后的包围盒。
    public int rot;

    // 构造词条放置项：内容引用与几何/样式全按参数记录。
    public static WordCloudItem Of(ChartData data, int x, int y, int w, int h,
                            int fontSize, int color, int rot) {
        WordCloudItem item = new WordCloudItem();
        item.data = data;
        item.x = x;
        item.y = y;
        item.w = w;
        item.h = h;
        item.fontSize = fontSize;
        item.color = color;
        item.rot = rot;
        return item;
    }
}

// 词云放置结果的逐帧记忆化条目：螺旋放置只依赖词条内容与
// 盒子几何，即时模式调用方每帧重建 option 对象，按内容指纹
// 复用同一次放置搜索（见 ChartView.DrawWordCloud）。
public class WordCloudCacheEntry {
    public int fp;
    public List<WordCloudItem> items;
    // 按内容指纹查找缓存的放置结果；未命中返回 null。
    public static WordCloudCacheEntry Lookup(List<WordCloudCacheEntry> cache, int fp) {
        for (int i = 0; i < cache.Count; i = i + 1) {
            if (cache[i].fp == fp) { return cache[i]; }
        }
        return null;
    }
    // 存入放置结果（同指纹去重；超出容量时挤掉最旧的一条）。
    public static void Store(List<WordCloudCacheEntry> cache, int fp,
                             List<WordCloudItem> items, int capacity) {
        for (int i = 0; i < cache.Count; i = i + 1) {
            if (cache[i].fp == fp) { return; }
        }
        WordCloudCacheEntry e = new WordCloudCacheEntry();
        e.fp = fp;
        e.items = items;
        if (cache.Count >= capacity) { cache.RemoveAt(0); }
        cache.Add(e);
    }
}
