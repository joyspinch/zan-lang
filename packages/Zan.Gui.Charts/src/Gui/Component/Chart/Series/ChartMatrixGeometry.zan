using System;
using Gui;

namespace Gui.Component.Chart;

internal class ChartMatrixGeometry {
    internal MatGeom layout;

    internal static ChartMatrixGeometry Create(App app, ChartOption o, int x, int y, int w, int h) {
        if (o.matrix == null) { return null; }
        ChartMatrixGeometry geometry = new ChartMatrixGeometry();
        int maxX = -1; int maxY = -1; double low = 0.0; double high = 0.0;
        ChartView.HeatFactsScan(o, out maxX, out maxY, out low, out high);
        geometry.layout = ChartView.MatLayout(app, x, y, w, h,
        Chart.HeadBandBottom(app, y, o.title), o, low, high);
        return geometry;
    }

    internal ChartHit Hit(ChartOption o, int x, int y) {
        MatGeom geo = layout;
        ChartMatrixSpec matrix = o.matrix;
        if (geo == null || matrix == null || x < geo.bodyL || x >= geo.rx + geo.rw
        || y < geo.bodyT || y >= geo.ry + geo.rh) { return null; }
        int col = ChartView.HeatmapIndexAt(x - geo.bodyL, geo.rx + geo.rw - geo.bodyL, geo.xLeaves);
        int row = ChartView.HeatmapIndexAt(y - geo.bodyT, geo.ry + geo.rh - geo.bodyT, geo.yLeaves);
        if (col < 0 || row < 0) { return null; }
        for (int si = 0; si < o.series.Count; si = si + 1) {
            ChartSeries series = o.series[si];
            if (series.hidden || series.silent || series.type != ChartType.Heatmap) { continue; }
            for (int di = 0; di < series.data.Count; di = di + 1) {
                ChartData data = series.data[di];
                if (data.gap || data.heatX < 0 || data.heatY < 0
                || data.heatX >= matrix.xNodes.Count || data.heatY >= matrix.yNodes.Count) { continue; }
                ChartMatrixBandNode xn = matrix.xNodes[data.heatX];
                ChartMatrixBandNode yn = matrix.yNodes[data.heatY];
                if (col < xn.first || col >= xn.first + xn.span || row < yn.first || row >= yn.first + yn.span) { continue; }
                int cx; int cy; int cw; int ch;
                ChartView.MatXCellRect(geo, matrix, data.heatX, out cx, out cy, out cw, out ch);
                int px; int py; int pw; int ph;
                ChartView.MatYCellRect(geo, matrix, data.heatY, out px, out py, out pw, out ph);
                return ChartView.MakeDataHit(series, si, di, xn.text,
                ChartElementType.HeatmapCell, cx, py, data.val);
            }
        }
        return null;
    }
}
