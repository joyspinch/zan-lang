using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// 组件化、带动画的图表控件（Chart 控件的现代形态）。
// 一次性绑定 ChartOption（ECharts 风格：标题 + 轴 + 系列，
// 每个系列携带自己的类型），然后每帧调用 Render。
// 它会播放增长入场动画，绘制渐变/平滑系列和可选的悬停
// 十字线 + 数值工具提示。多级控制对应 ECharts：option.*
// （全局）< series.*（逐系列）< data[i].*（逐项），因此混合图表
// 只是共享同一坐标系的不同类型系列。
public partial class ChartView {
    ChartOption option;
    ChartOption sourceOption;
    ChartOption initialOption;
    ChartController controller;
    string directStatus;
    string directStatusMessage;
    ResolvedChart resolved;
    bool staticFrame;
    // 每个图表稳定的动画键。默认为新 WidgetId，但
    // 即时模式/虚拟化列表中的调用方（控件 id 顺序随
    // 行滚动进出而变动）应通过 Keyed() 传入自有稳定键，
    // 避免增长入场动画每帧被重置为 0。
    int wid;
    public bool suppressCanvasToolbox;

    public int Wid() { return this.wid; }

    // 保留式生命周期通知。图表仍由 Render 驱动，但调用方
    // 可以在创建后订阅，不必改写每个 renderer 的交互分支。
    UiEvent Resized;
    UiEvent Updated;
    UiEvent Disposed;
    int lastRenderW;
    int lastRenderH;
    int directVersion;
    int lastControllerVersion;
    int lastDirectVersion;
    bool hasRendered;
    bool disposed;
    ChartEventHub eventHub;
    int eventHitId;
    ChartHit currentHit;
    int lastZoomLo;
    int lastZoomHi;
    int lastEventStateWid;
    static ChartView activeEventView;

    // —— 跨帧悬停槽（按 wid）——
    // Keyed 每帧新建实例，悬停的跨帧状态（上一帧命中、指针是否
    // 在图上）放在实例字段必然断档：fadeFocus 渐隐读不到上一帧
    // 命中、enter/leave 每帧重触发。状态搬进 wid 键槽，实例可丢弃。
    static List<int> hoverSlotWids;
    static List<ChartHit> hoverSlotHits;
    static List<int> hoverSlotOvers;

    public static int HoverSlotIdx(int wid) {
        if (ChartView.hoverSlotWids == null) { return 0 - 1; }
        for (int i = 0; i < ChartView.hoverSlotWids.Count; i = i + 1) {
            if (ChartView.hoverSlotWids[i] == wid) { return i; }
        }
        return 0 - 1;
    }

    // wid 槽记录的上一帧悬停命中（无则 null）。
    public static ChartHit HoverSlotHit(int wid) {
        int i = ChartView.HoverSlotIdx(wid);
        return i < 0 ? null : ChartView.hoverSlotHits[i];
    }

    public static bool HoverSlotOver(int wid) {
        int i = ChartView.HoverSlotIdx(wid);
        return i >= 0 && ChartView.hoverSlotOvers[i] != 0;
    }

    public static void HoverSlotSet(int wid, ChartHit hit, bool over) {
        if (ChartView.hoverSlotWids == null) {
            ChartView.hoverSlotWids = new List<int>();
            ChartView.hoverSlotHits = new List<ChartHit>();
            ChartView.hoverSlotOvers = new List<int>();
        }
        int i = ChartView.HoverSlotIdx(wid);
        if (i < 0) {
            // 图表数量有限；换页孤儿槽到量即整表重建。
            if (ChartView.hoverSlotWids.Count > 64) {
                ChartView.hoverSlotWids = new List<int>();
                ChartView.hoverSlotHits = new List<ChartHit>();
                ChartView.hoverSlotOvers = new List<int>();
            }
            ChartView.hoverSlotWids.Add(wid);
            ChartView.hoverSlotHits.Add(hit);
            ChartView.hoverSlotOvers.Add(over ? 1 : 0);
            return;
        }
        ChartView.hoverSlotHits[i] = hit;
        ChartView.hoverSlotOvers[i] = over ? 1 : 0;
    }

    // 初始化保留式生命周期字段（事件、动画/版本跟踪、事件 hub）。
    void InitLifecycle() {
        Resized = new UiEvent();
        Updated = new UiEvent();
        Disposed = new UiEvent();
        lastRenderW = 0;
        lastRenderH = 0;
        directVersion = 1;
        lastControllerVersion = 0 - 1;
        lastDirectVersion = 0 - 1;
        hasRendered = false;
        disposed = false;
        eventHub = new ChartEventHub();
        eventHitId = 0 - 1;
        currentHit = null;
        lastZoomLo = 0 - 1;
        lastZoomHi = 0 - 1;
        lastEventStateWid = 0 - 1;
        directStatus = "ready";
        directStatusMessage = "";
    }

    // 把图例开关写回 data.hidden（多数据项）或 series.hidden（单值系列）。
    // 画廊每帧重建 option，必须从 App 状态恢复，否则点了等于没点。
    public static void ApplyDataLegend(App app, ChartOption o) {
        if (o.iwid == 0) { return; }
        for (int si = 0; si < o.series.Count; si = si + 1) {
            ChartSeries s = o.series[si];
            if (s.data.Count > 1) {
                for (int di = 0; di < s.data.Count; di = di + 1) {
                    s.data[di].hidden = app.StateGet(
                        Chart.LegendSliceKey(o.iwid, si, di), 0) == 1;
                    int sel0 = 0;
                    if (s.data[di].selected) { sel0 = 1; }
                    s.data[di].selected = app.StateGet(
                        Chart.PieSelKey(o.iwid, si, di), sel0) == 1;
                }
            } else {
                s.hidden = app.StateGet(Chart.LegendKey(o.iwid, si), 0) == 1;
            }
        }
    }

    // 层级图表（treemap/sunburst）最近一次的悬停命中。
    // 由命中追踪辅助函数设置，调用方立即读取以绘制工具提示，
    // 因此不会跨帧存留。
    static bool tailHooked;  // App 呈现尾段已挂（首帧渲染时自挂）
    static string ttName;
    static int ttVal;
    static int ttX;  // treemap：命中单元格矩形
    static int ttY;
    static int ttW;
    static int ttH;
    static int ttRadius;
    static ChartNode ttNode;
    static int ttA0;  // sunburst：命中扇区扫掠 + 环深度
    static int ttA1;
    static int ttDepth;
    static ChartNode ttSunNode;  // sunburst：命中的叶子节点（typed hit 用）

    // 绑定一个选项（内部深复制为 initialOption 供 Restore 用），
    // 动画/交互键取新 WidgetId。
    public static ChartView Of(ChartOption o) {
        if (o == null) { o = ChartOption.Create(); }
        ChartView v = new ChartView();
        v.InitLifecycle();
        v.option = o;
        v.sourceOption = o;
        v.initialOption = o != null ? o.Clone() : null;
        v.staticFrame = false;
        v.wid = WidgetId.Next();
        return v;
    }

    // 绑定一个选项及调用方所有的稳定动画键。
    public static ChartView Keyed(ChartOption o, int key) {
        if (o == null) { o = ChartOption.Create(); }
        ChartView v = new ChartView();
        v.InitLifecycle();
        v.option = o;
        v.controller = null;
        v.sourceOption = o;
        v.initialOption = o != null ? o.Clone() : null;
        v.staticFrame = false;
        v.wid = key;
        return v;
    }

    // 静态首绘的 Keyed 变体：跳过增长入场动画，首帧即最终
    // 形态（对齐 ECharts 官方示例站的静态示例）。文档预览、
    // 虚拟化单元格与滚动路径上的图表用它，避免卡片滚入视口时
    // 入场动画触发数百毫秒的连续重绘突发。
    public static ChartView KeyedStatic(ChartOption o, int key) {
        ChartView v = ChartView.Keyed(o, key);
        v.staticFrame = true;
        return v;
    }

    // 将 ChartView 绑定到可变 controller。Render 时读取 controller 的当前 option。
    public static ChartView Bind(ChartController controller) {
        ChartView v = new ChartView();
        v.InitLifecycle();
        v.controller = controller;
        if (controller != null) {
            v.option = controller.Option(); v.sourceOption = v.option;
            v.initialOption = controller.GetOption();
        } else {
            v.option = ChartOption.Create(); v.sourceOption = v.option;
            v.initialOption = v.option != null ? v.option.Clone() : null;
        }
        v.staticFrame = false;
        v.wid = WidgetId.Next();
        return v;
    }

    // 带稳定交互键的 controller 绑定，适合列表和虚拟化单元格。
    public static ChartView BindKeyed(ChartController controller, int key) {
        ChartView v = ChartView.Bind(controller);
        v.wid = key;
        return v;
    }

    // 生命周期事件：在保留的 ChartView 实例上订阅。
    // 尺寸回调：Render 帧检测到本图表宽高变化时触发。
    public ChartView OnResize(Action a) { Resized.Add(a); return this; }
    // 更新回调：Render 帧检测到 option/数据版本变化时触发。
    public ChartView OnUpdated(Action a) { Updated.Add(a); return this; }
    // 释放回调：Dispose 时触发一次，随后清空全部回调列表。
    public ChartView OnDisposed(Action a) { Disposed.Add(a); return this; }

    // 注册/移除带载荷的图表交互事件。
    public ChartView On(ChartEventType type, ChartInteractionHandler handler) {
        if (!this.disposed) { this.eventHub.On(type, handler); }
        return this;
    }

    // 注销一个交互事件处理器（按引用匹配最近一个；disposed 后 no-op）。
    public ChartView Off(ChartEventType type, ChartInteractionHandler handler) {
        if (!this.disposed) { this.eventHub.Off(type, handler); }
        return this;
    }

    // 注销全部交互事件处理器；disposed 后为 no-op。返回 this 便于链式。
    public ChartView ClearEvents() {
        if (!this.disposed) { this.eventHub.Clear(); }
        return this;
    }

    // 派发交互事件：先发给自身 eventHub 订阅者，controller 绑定
    // 模式下再转发给 controller（DataChanged 除外，避免回环）。
    void RaiseInteraction(ChartInteractionEvent eventArgs) {
        if (this.disposed || eventArgs == null) { return; }
        this.eventHub.Raise(eventArgs);
        if (this.controller != null
            && eventArgs.type != ChartEventType.DataChanged) {
            this.controller.RaiseEvent(eventArgs);
        }
    }

    // 只派发给自身 eventHub，不转发 controller（本地回声用）。
    void RaiseLocal(ChartInteractionEvent eventArgs) {
        if (this.disposed || eventArgs == null) { return; }
        this.eventHub.Raise(eventArgs);
    }

    // 渲染器侧事件出口：转发给当前帧的 activeEventView
    // （即时模式渲染器没有 view 引用时使用）。
    public static void RaiseActive(ChartInteractionEvent eventArgs) {
        if (ChartView.activeEventView != null) {
            ChartView.activeEventView.RaiseInteraction(eventArgs);
        }
    }

    // 构造仅带类型/wid/像素坐标的图表级事件载荷。
    public static ChartInteractionEvent EventAt(ChartEventType type, int wid,
                                         int px, int py) {
        ChartInteractionEvent e = ChartInteractionEvent.Of(type, wid);
        e.x = px;
        e.y = py;
        return e;
    }

    // 由命中结果构造数据点事件载荷；hit 为 null 时退化为
    // Of(type, wid)（图表级事件）。
    public static ChartInteractionEvent EventFromHit(ChartEventType type, int wid,
                                               ChartHit hit) {
        if (hit == null) { return ChartInteractionEvent.Of(type, wid); }
        ChartInteractionEvent e = ChartInteractionEvent.DataPoint(type, wid,
            hit.seriesIndex, hit.seriesName, hit.dataIndex, hit.dataName,
            hit.elementType);
        e.value = hit.value;
        e.numberValueSet = hit.numberValueSet;
        e.numberValue = hit.numberValue;
        e.xValueSet = hit.xValueSet;
        e.xValue = hit.xValue;
        e.yValueSet = hit.yValueSet;
        e.yValue = hit.yValue;
        e.x = hit.pixelX;
        e.y = hit.pixelY;
        e.axisIndex = hit.axisIndex;
        return e;
    }

    // 当前帧由 renderer 提供的命中候选。renderer 按绘制顺序调用，
    // 后来的具体图元覆盖早先的候选，但不会产生额外事件。
    public static void OfferActiveHit(ChartHit hit) {
        if (ChartView.activeEventView != null && hit != null) {
            ChartView.activeEventView.currentHit = hit;
        }
    }

    // 指针被上层弹层/抽屉/遮罩接管时，图表悬停命中整体静默：
    // 命中点的 tooltip 卡在 PresentFrame 末尾统一绘制，会叠到
    // 弹层上面（悬停穿透）。入口在此统一拦截，各 Offer*/PointsHover
    // 无需重复判断。
    public static bool HoverBlocked(App app) {
        return app == null || app.PointerCaptured();
    }

    // 混合 Cartesian 图在渲染结束后才复算部分 overlay 命中。
    // 系列索引与主体绘制顺序一致：后面的系列视觉上覆盖前面的
    // 系列；较早系列的延迟命中不能反过来遮掉已经命中的后层。
    public static void OfferTopmostCategoryHit(ChartHit hit) {
        if (ChartView.activeEventView == null || hit == null) { return; }
        ChartHit old = ChartView.activeEventView.currentHit;
        if (old == null || hit.seriesIndex >= old.seriesIndex) {
            ChartView.activeEventView.currentHit = hit;
        }
    }

    // 构造数据点命中：数据项名取 s.data[dataIndex].name（无则用
    // fallbackName），并携带 number 值与系列 axisIndex。
    // s 为 null 时返回 null。
    public static ChartHit MakeDataHit(ChartSeries s, int seriesIndex, int dataIndex,
                                string fallbackName, ChartElementType elementType,
                                int px, int py, int value) {
        if (s == null) { return null; }
        string dataName = fallbackName;
        if (dataIndex >= 0 && dataIndex < s.data.Count
            && s.data[dataIndex].name.Length > 0) {
            dataName = s.data[dataIndex].name;
        }
        ChartHit h = ChartHit.Of(elementType, seriesIndex, s.name,
            dataIndex, dataName, value, px, py);
        h.axisIndex = s.axisIndex;
        if (dataIndex >= 0 && dataIndex < s.data.Count) {
            ChartData d = s.data[dataIndex];
            h.numberValueSet = d.numberSet;
            h.numberValue = d.number;
        }
        return h;
    }

    // 折线数据点的 proximity 命中：在绘图区内找最近可见 Line
    // 系列点（命中半径 Scale(10)），命中后经 OfferActiveHit /
    // OfferTopmostCategoryHit 提交。baseIdx 为 dataZoom 窗口基址。
    public static void OfferCategoryPointHits(App app, ChartFrame f,
                                       List<string> labels,
                                       List<ChartSeries> series, int baseIdx,
                                       int g, ChartElementType elementType,
                                       bool forceTopmost) {
        if (f == null || labels == null || labels.Count < 1 || series == null) { return; }
        if (ChartView.HoverBlocked(app)) { return; }
        int mx = app.mouseX;
        int my = app.mouseY;
        if (mx < f.plotX || mx >= f.plotX + f.plotW
            || my < f.plotY || my >= f.plotY + f.plotH) { return; }
        int n = labels.Count;
        int bestD = 0;
        ChartHit best = null;
        for (int si = 0; si < series.Count; si = si + 1) {
            ChartSeries s = series[si];
            if (s == null || s.hidden || s.type != ChartType.Line) { continue; }
            for (int vi = 0; vi < n; vi = vi + 1) {
                int oi = baseIdx + vi;
                if (oi < 0 || oi >= s.Count()) { continue; }
                int px = f.CatX(vi, n);
                int py = f.YOf((int)((long)s.Value(oi) * g / 1000L), s.axisIndex);
                int pdx = mx - px;
                int pdy = my - py;
                int pd2 = pdx * pdx + pdy * pdy;
                if (best == null || pd2 < bestD) {
                    bestD = pd2;
                    best = ChartView.MakeDataHit(s, si, oi, labels[vi],
                        elementType, px, py, s.Value(oi));
                }
                // 线体命中（官方 linePrecision 沿整条折线，不只数据
                // 点半径）：指针到相邻两点连线的距离也计入，归属较
                // 近的端点，值/名语义与点命中一致。平滑曲线近似为
                // 数据点弦，粗抓半径下与视觉线重合。
                if (vi + 1 < n && oi + 1 < s.Count()) {
                    int oj = oi + 1;
                    int qx = f.CatX(vi + 1, n);
                    int qy = f.YOf((int)((long)s.Value(oj) * g / 1000L),
                        s.axisIndex);
                    int sd2 = ChartView.SegDist2(mx, my, px, py, qx, qy);
                    if (sd2 >= 0 && (best == null || sd2 < bestD)) {
                        int qdx = mx - qx;
                        int qdy = my - qy;
                        bool nearerQ = qdx * qdx + qdy * qdy
                            <= pdx * pdx + pdy * pdy;
                        int ui = nearerQ ? vi + 1 : vi;
                        int uoi = nearerQ ? oj : oi;
                        int ux = nearerQ ? qx : px;
                        int uy = nearerQ ? qy : py;
                        bestD = sd2;
                        best = ChartView.MakeDataHit(s, si, uoi, labels[ui],
                            elementType, ux, uy, s.Value(uoi));
                    }
                }
            }
        }
        int hitR = app.Scale(10);
        if (best != null && bestD <= hitR * hitR) {
            best.pixelX = mx;
            best.pixelY = my;
            if (forceTopmost) { ChartView.OfferActiveHit(best); }
            else { ChartView.OfferTopmostCategoryHit(best); }
            // ECharts trigger:'item' 的数据点悬停卡：列卡由
            // CartesianTooltip 负责，声明 item 时它整体不画，官方
            // 凹凸图"悬停某条线出该点值卡"的观感由这里补齐。
            // --nomouse 把 showTooltip 关掉，截图/回归不进卡。
            if (Chart.legendOpt != null && Chart.legendOpt.showTooltip
                && Chart.legendOpt.tooltipTrigger == "item") {
                ChartSeries bs = series[best.seriesIndex];
                string vt = Convert.ToString(best.value);
                if (bs.SeriesFrac(best.dataIndex)) {
                    double dn = bs.Number(best.dataIndex);
                    vt = Chart.FracText((int)(dn * 1000
                        + (dn >= 0 ? 0.5 : 0 - 0.5)));
                }
                List<TooltipRow> rows = new List<TooltipRow>();
                rows.Add(TooltipRow.Of(0, best.dataName));
                rows.Add(TooltipRow.Of(bs.color, bs.name + "  " + vt));
                ChartView.TooltipCard(app, mx, my, f.plotX + f.plotW, rows);
            }
        }
    }

    // 该图（自身 hub 或其 controller）是否订阅了 type 事件。
    public static bool HasInteraction(ChartView v, ChartEventType type) {
        if (v == null) { return false; }
        if (v.eventHub != null && v.eventHub.Count(type) > 0) { return true; }
        if (v.controller != null && v.controller.HasEvent(type)) { return true; }
        return false;
    }

    // 指针到线段 p→q 的距离平方（px²，纯整数运算）；退化段返回
    // -1。t = ((m-p)·ab) 对 len2 的比例钳在 [0,1]，投影点取整后
    // 求距——抓取半径 10px 量级下误差可忽略。
    public static int SegDist2(int mx, int my, int px, int py, int qx, int qy) {
        long abx = qx - px;
        long aby = qy - py;
        long len2 = abx * abx + aby * aby;
        if (len2 <= 0) { return 0 - 1; }
        long t = (long)(mx - px) * abx + (long)(my - py) * aby;
        if (t < 0) { t = 0; }
        if (t > len2) { t = len2; }
        long cx = px + (t * abx) / len2;
        long cy = py + (t * aby) / len2;
        long dx = mx - cx;
        long dy = my - cy;
        return (int)(dx * dx + dy * dy);
    }

    // id 是否属于当前 activeEventView 的可点击命中（id < 0 恒假）；
    // 渲染器用它仲裁扇区/区域点击归属。
    public static bool OwnsActiveClick(App app, int id) {
        if (ChartView.activeEventView == null || id < 0) { return false; }
        return Ui.OwnsClick(app, id);
    }

    // 帧尾指针事件派发：进入/离开、Hover/MouseOut（命中变化时）、
    // Click/DoubleClick（经 eventHitId），随后清空 activeEventView。
    // statusNow != "ready" 时不产生指针事件。
    void DispatchPointerEvents(App app, int x, int y, int w, int h,
                               string statusNow) {
        bool over = statusNow == "ready"
            && app.mouseX >= x && app.mouseX < x + w
            && app.mouseY >= y && app.mouseY < y + h;
        ChartHit hit = over ? this.currentHit : null;
        if (hit != null) {
            hit.pixelX = app.mouseX;
            hit.pixelY = app.mouseY;
        }
        bool wasOver = ChartView.HoverSlotOver(this.wid);
        ChartHit prevHit = ChartView.HoverSlotHit(this.wid);
        bool entered = over && !wasOver;
        bool left = !over && wasOver;
        bool hitChanged = !ChartHit.Same(prevHit, hit);
        if (hitChanged || entered || left) {
            // 悬停可见反馈晚命中一帧：emphasis.focus 渐隐在下一帧
            // 渲染入口才读悬停槽（fadeFocus 帧内静态），item 悬停卡
            // 也随命中重画。hitTester 的 hover 不含系列命中，鼠标
            // 停住后不再有 mousemove 调度重绘——光标停在数据点上会
            // 永远等不到下一帧。命中变化时这里补一帧。
            app.NoteRedrawWhy("chart-hover");
            app.needsRedraw = true;
        }
        if ((hitChanged || left) && prevHit != null) {
            ChartInteractionEvent me = ChartView.EventFromHit(
                ChartEventType.MouseOut, this.wid, prevHit);
            this.RaiseInteraction(me);
        }
        if ((hitChanged || entered) && hit != null) {
            ChartInteractionEvent he = ChartView.EventFromHit(
                ChartEventType.Hover, this.wid, hit);
            this.RaiseInteraction(he);
        } else if (entered && hit == null) {
            ChartInteractionEvent he2 = ChartView.EventAt(
                ChartEventType.Hover, this.wid, app.mouseX, app.mouseY);
            this.RaiseInteraction(he2);
        } else if (left && hit == null && prevHit == null) {
            ChartInteractionEvent me2 = ChartView.EventAt(
                ChartEventType.MouseOut, this.wid, app.mouseX, app.mouseY);
            this.RaiseInteraction(me2);
        }
        if (statusNow == "ready" && this.eventHitId >= 0
            && Ui.Clicked(app, this.eventHitId)) {
            if (hit != null) {
                ChartInteractionEvent ce = ChartView.EventFromHit(
                    ChartEventType.Click, this.wid, hit);
                this.RaiseInteraction(ce);
            } else {
                ChartInteractionEvent ce2 = ChartView.EventAt(
                    ChartEventType.Click, this.wid, app.mouseX, app.mouseY);
                this.RaiseInteraction(ce2);
            }
        }
        if (statusNow == "ready" && this.eventHitId >= 0
            && !app.ClickClaimed()
            && Ui.DoubleClicked(app, this.eventHitId)) {
            ChartInteractionEvent de = hit != null
                ? ChartView.EventFromHit(ChartEventType.DoubleClick, this.wid, hit)
                : ChartView.EventAt(ChartEventType.DoubleClick, this.wid,
                                    app.mouseX, app.mouseY);
            this.RaiseInteraction(de);
        }
        ChartView.HoverSlotSet(this.wid,
            hit == null ? null : ChartHit.Copy(hit), over);
        ChartView.activeEventView = null;
    }

    // 按事件类型注册交互处理器（Click/Hover/LegendSelected/…），
    // 组文档覆盖以下 17 个链式方法，各自对应一个 ChartEventType。
    public ChartView OnClick(ChartInteractionHandler handler) {
        return this.On(ChartEventType.Click, handler);
    }
    // 注册 DoubleClick 交互事件：双击时派发，命中元素或整图坐标。
    public ChartView OnDoubleClick(ChartInteractionHandler handler) {
        return this.On(ChartEventType.DoubleClick, handler);
    }
    // 注册 LegendSelected 交互事件：图例项被选中。
    public ChartView OnLegendSelected(ChartInteractionHandler handler) {
        return this.On(ChartEventType.LegendSelected, handler);
    }
    // 注册 Refresh 交互事件。
    public ChartView OnRefresh(ChartInteractionHandler handler) {
        return this.On(ChartEventType.Refresh, handler);
    }
    // 注册 Restore 交互事件：还原初始 option 时派发。
    public ChartView OnRestore(ChartInteractionHandler handler) {
        return this.On(ChartEventType.Restore, handler);
    }
    // 注册 DataChanged 交互事件：option/数据版本变化时派发。
    public ChartView OnDataChanged(ChartInteractionHandler handler) {
        return this.On(ChartEventType.DataChanged, handler);
    }

    // 返回 option 快照；controller 绑定和直接 option 两种模式都不暴露
    // 内部可变对象。
    public ChartOption GetOption() {
        if (this.controller != null) { return this.controller.GetOption(); }
        if (this.sourceOption != null) { return this.sourceOption.Clone(); }
        return new ChartOption();
    }

    // 状态字符串："ready" / "loading" / "empty" / "error" /
    // "disposed"（controller 绑定模式透传 controller 状态）。
    public string Status() {
        if (this.disposed) { return "disposed"; }
        if (this.controller != null) { return this.controller.Status(); }
        return this.directStatus;
    }

    // 伴随状态的补充消息（SetEmptyMessage/SetErrorMessage 等设置）。
    public string StatusMessage() {
        if (this.disposed) { return ""; }
        if (this.controller != null) { return this.controller.StatusMessage(); }
        return this.directStatusMessage;
    }

    // 实例是否已释放（Dispose 后为真；disposed 后所有操作为 no-op）。
    public bool IsDisposed() { return this.disposed; }

    // 替换 option；绑定 controller 时保留 controller 身份。
    public ChartView SetOption(ChartOption next) {
        if (this.disposed || next == null) { return this; }
        if (this.controller != null) { this.controller.SetOption(next); }
        else {
            this.sourceOption = next; this.option = next;
            this.initialOption = next.Clone();
            this.directStatus = "ready"; this.directStatusMessage = "";
            this.directVersion = this.directVersion + 1;
        }
        return this;
    }

    // 立即模式的显式刷新入口。Render 每帧都会读取最新 option，
    // 因此这里仅提供与 ECharts refresh() 对齐的可链式语义。
    public ChartView Refresh() { return this; }

    // 还原为创建/最近一次 SetOption 时的 initialOption 深拷贝，
    // 并触发 Restore 事件（controller 模式转发 controller.Restore）。
    public ChartView Restore() {
        if (this.disposed) { return this; }
        if (this.controller != null) { this.controller.Restore(); }
        else {
            this.sourceOption = this.initialOption != null ? this.initialOption.Clone() : null; this.option = this.sourceOption;
            this.directStatus = "ready"; this.directStatusMessage = "";
            this.directVersion = this.directVersion + 1;
            ChartInteractionEvent re = ChartInteractionEvent.Of(
                ChartEventType.Restore, this.wid);
            this.RaiseInteraction(re);
        }
        return this;
    }

    // 清空所有系列的 data 列表并把状态置 "empty"（不销毁系列外壳）。
    public ChartView Clear() {
        if (this.disposed) { return this; }
        if (this.controller != null) { this.controller.Clear(); }
        else {
            for (int i = 0; i < this.sourceOption.series.Count; i = i + 1) {
                this.sourceOption.series[i].data = new List<ChartData>();
            }
            this.directStatus = "empty"; this.directStatusMessage = "";
            this.directVersion = this.directVersion + 1;
        }
        return this;
    }

    // 置 "loading" 状态并显示 message（Render 时由状态层覆盖呈现）。
    public ChartView ShowLoading(string message) {
        if (this.disposed) { return this; }
        if (this.controller != null) { this.controller.ShowLoading(message); }
        else {
            this.directStatus = "loading"; this.directStatusMessage = message;
            this.directVersion = this.directVersion + 1;
        }
        return this;
    }

    // 结束 loading，恢复 "ready"。
    public ChartView HideLoading() {
        if (this.disposed) { return this; }
        if (this.controller != null) { this.controller.HideLoading(); }
        else {
            this.directStatus = "ready"; this.directStatusMessage = "";
            this.directVersion = this.directVersion + 1;
        }
        return this;
    }

    // 置 "empty" 状态并自定义空态文案。
    public ChartView SetEmptyMessage(string message) {
        if (this.disposed) { return this; }
        if (this.controller != null) { this.controller.SetEmptyMessage(message); }
        else {
            this.directStatus = "empty"; this.directStatusMessage = message;
            this.directVersion = this.directVersion + 1;
        }
        return this;
    }

    // 置 "error" 状态并自定义错误文案。
    public ChartView SetErrorMessage(string message) {
        if (this.disposed) { return this; }
        if (this.controller != null) { this.controller.SetErrorMessage(message); }
        else {
            this.directStatus = "error"; this.directStatusMessage = message;
            this.directVersion = this.directVersion + 1;
        }
        return this;
    }

    // 释放 view 的事件订阅并使后续 Render/操作失效。
    // controller 的生命周期由创建它的调用方拥有，view 不会替其 Dispose。
    public void Dispose() {
        if (this.disposed) { return; }
        this.disposed = true;
        this.directStatus = "disposed"; this.directStatusMessage = "";
        if (this.Disposed.Count() > 0) { this.Disposed.Raise(); }
        this.Resized.Clear(); this.Updated.Clear();
        if (ChartView.activeEventView == this) { ChartView.activeEventView = null; }
        this.eventHub.Clear();
    }

    // RenderCached 的动态快照槽位分配器：运行时池按需增长
    // （ZAN_SNAP_CACHE_MAX_SLOTS = 512），任意数量的缓存
    // 图表可以共存；将图表嵌入会滚走的单元格的调用方
    // 应 ReleaseCached(slot) 归还像素缓冲区。
    static int cacheSeq = 16;
    // 分配下一个快照槽位（16..511 循环复用，不做占用检查）。
    public static int AllocCacheSlot() {
        int s = ChartView.cacheSeq;
        ChartView.cacheSeq = ChartView.cacheSeq + 1;
        if (s >= 512) { ChartView.cacheSeq = 16; s = 16; }
        return s;
    }

    // ---- 快照缓存与指纹计算解耦至 ChartView.Cache.zan ----
}
