using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Component.Chart;

// 图表系列扩展渲染器注册中心。
// 支持第三方或自定义图表类型通过 SeriesRendererRegistry.Register 注册扩展渲染策略。
public class SeriesRendererRegistry {
    static List<ISeriesRenderer> renderers;

    public static void Register(ISeriesRenderer renderer) {
        if (renderer == null) { return; }
        if (SeriesRendererRegistry.renderers == null) {
            SeriesRendererRegistry.renderers = new List<ISeriesRenderer>();
        }
        SeriesRendererRegistry.renderers.Insert(0, renderer);
    }

    public static ISeriesRenderer Find(string kind) {
        if (SeriesRendererRegistry.renderers == null) { return null; }
        for (int i = 0; i < SeriesRendererRegistry.renderers.Count; i = i + 1) {
            ISeriesRenderer r = SeriesRendererRegistry.renderers[i];
            if (r != null && r.CanRender(kind)) {
                return r;
            }
        }
        return null;
    }
}
