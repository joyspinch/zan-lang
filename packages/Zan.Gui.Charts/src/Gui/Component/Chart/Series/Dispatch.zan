using System;
using Gui;

namespace Gui.Component.Chart;

// ChartView.Dispatch.zan - 图表系列分发调度、Z-序编排、图形元件与富文本渲染
public partial class ChartView {
    // 第一个可见序列（整图系列族从中选取布局
    // 标志位 —— innerPct、roseType、sort、hbar、custom）。
    // N7：ZSort 重排绘制序后，主导系列仍按**声明序**取（declOrder
    // 快照）——官方每系列自带 view，面板主导型不随 z 漂移。
    public static ChartSeries LeadSeries(ChartOption o) {
        if (o.declOrder != null && o.declOrder.Count > 0
            && o.declOrder.Count == o.series.Count) {
            for (int d = 0; d < o.declOrder.Count; d = d + 1) {
                if (!o.declOrder[d].hidden) { return o.declOrder[d]; }
            }
            return o.declOrder[0];
        }
        if (o.series.Count < 1) { return null; }
        for (int i = 0; i < o.series.Count; i = i + 1) {
            if (!o.series[i].hidden) { return o.series[i]; }
        }
        return o.series[0];
    }

    // 地图底图的几何载体。geo 组件形态下用户系列是挂在 geo 上的
    // scatter/lines/graph/custom（coordSys == "geo"，没有 regions），
    // 真正的区域表在 ChartModel 合成的 isGeoBase 系列里；直接写
    // series[].type="map" 的形态则由该系列自己带几何。优先取可见的
    // isGeoBase，其次取首个可见且真的带 regions 的 Map 系列。
    public static ChartSeries MapBaseSeries(ChartOption o) {
        if (o == null || o.series.Count < 1) { return null; }
        for (int i = 0; i < o.series.Count; i = i + 1) {
            ChartSeries s = o.series[i];
            if (!s.hidden && s.isGeoBase && s.regions.Count > 0) { return s; }
        }
        for (int j = 0; j < o.series.Count; j = j + 1) {
            ChartSeries s2 = o.series[j];
            if (!s2.hidden && s2.type == ChartType.Map
                && s2.regions.Count > 0) { return s2; }
        }
        return ChartView.LeadSeries(o);
    }


    // target 系列在 o.series 中的下标（引用相等）；无则 -1。
    public static int SeriesIndexOf(ChartOption o, ChartSeries target) {
        if (o == null || target == null) { return 0 - 1; }
        for (int i = 0; i < o.series.Count; i = i + 1) {
            if (o.series[i] == target) { return i; }
        }
        return 0 - 1;
    }

    // 主导图表族：第一个可见序列的类型（
    // 整图系列族 —— pie、gauge、heatmap 等 —— 从中选择布局，
    // 笛卡尔系列族则逐序列混用）。全部隐藏时仍用首条系列类型，
    // 保留坐标轴/图例，而不是整图变成空状态。
    public static ChartType LeadType(ChartOption o) {
        // N7：声明序语义（declOrder 快照优先，见 LeadSeries）。
        if (o.declOrder != null && o.declOrder.Count == o.series.Count) {
            for (int d = 0; d < o.declOrder.Count; d = d + 1) {
                if (!o.declOrder[d].hidden) { return o.declOrder[d].type; }
            }
            return o.declOrder[0].type;
        }
        for (int i = 0; i < o.series.Count; i = i + 1) {
            if (!o.series[i].hidden) { return o.series[i].type; }
        }
        if (o.series.Count > 0) { return o.series[0].type; }
        return ChartType.Line;
    }

    // N7 系列绘制键 = zlevel*1000 + z（zrender 显示列表序的静态投影；
    // z2 只作用于同系列内图元/hover 层，静态渲染无此层）。未声明的 z
    // 在解析期已按系列型官方缺省赋好（bar/pie/scatter 等 2、line 3——
    // 各 Series.ts）。
    public static int ZKeyOf(ChartSeries s) {
        return s.zlevel * 1000 + s.z;
    }

    // 稳定 argsort：返回按 ZKeyOf 升序的声明下标表（同键保持声明
    // 序——zrender 显示列表稳定语义）。与 hidden 无关：图例开关不得
    // 改变绘制序/键位，否则交互态在帧间漂移。Resolve（图例键绑定、
    // palette、CSS series-N）与 ZSort（物理排序）共用本函数，两处的
    // 序恒等——交互键才能跨帧对上。
    public static void ZOrder(ChartOption o, List<int> order) {
        order.Clear();
        int n = o.series.Count;
        List<int> keys = new List<int>();
        for (int i = 0; i < n; i = i + 1) {
            order.Add(i);
            keys.Add(ChartView.ZKeyOf(o.series[i]));
        }
        for (int a = 1; a < n; a = a + 1) {
            int ov = order[a];
            int kv = keys[a];
            int b = a - 1;
            while (b >= 0 && keys[b] > kv) {
                order[b + 1] = order[b];
                keys[b + 1] = keys[b];
                b = b - 1;
            }
            order[b + 1] = ov;
            keys[b + 1] = kv;
        }
    }

    // 把 o.series 就地重排为 ZOrder 绘制序。重排前先快照声明序
    // （declOrder）：LeadSeries/LeadType/DispatchKind 等「主导系列」
    // 语义读声明序首条可见系列——官方每系列自带 view，面板主导型
    // 不随 z 重排漂移（custom trend z=100 重排后仍是 lead，kind 不变，
    // 只是它画的线落在柱群之上）。快照与 o.series 同引用，图例等
    // 就地写仍穿透。drawOption 每帧由 Resolve 重新物化，声明序恒为准。
    public static void ZSort(ChartOption o) {
        if (o.series.Count < 2) { return; }
        List<int> order = new List<int>();
        ChartView.ZOrder(o, order);
        bool idem = true;
        for (int i = 0; i < order.Count; i = i + 1) {
            if (order[i] != i) { idem = false; break; }
        }
        if (idem) { return; }
        if (o.declOrder == null || o.declOrder.Count != o.series.Count) {
            List<ChartSeries> decl = new List<ChartSeries>();
            for (int i = 0; i < o.series.Count; i = i + 1) {
                decl.Add(o.series[i]);
            }
            o.declOrder = decl;
        }
        List<ChartSeries> sorted = new List<ChartSeries>();
        for (int i = 0; i < order.Count; i = i + 1) {
            sorted.Add(o.series[order[i]]);
        }
        o.series = sorted;
    }

    // 渲染器分发键：每个 ChartType 和 custom kind 都映射到
    // 一个显式渲染器；没有未知类型回退为折线图。
    // 未知/空 kind 返回 "empty"（渲染明确的空状态）。
    // 这是 chart_kinds_complete 测试的确定性锚点。
    public static string DispatchKind(ChartOption o) {
        // 无系列才画空状态。图例关掉最后一条系列时仍按原类型
        // 分发，只是渲染器跳过隐藏序列（坐标轴/图例还在）。
        // 例外：纯组件 option（只有 radar 指示器或 polar 轴、没有
        // 系列）官方画坐标骨架不画 "(no data)"——两个渲染器的
        // 骨架路径 0 系列本就安全。
        if (o.series.Count < 1) {
            if ((o.radarIndicators != null && o.radarIndicators.Count > 0) || o.radarMax.Count > 0 || o.radarNames.Count > 0) { return "radar"; }
            if (o.polars.Count > 0 || o.angleAxes.Count > 0) { return "polarCoord"; }
            if (o.geos.Count > 0) { return "map"; }
            if (o.xAxes.Count > 0 || o.yAxes.Count > 0) { return "cartesian"; }
            if (o.graphics != null && o.graphics.Count > 0) { return "graphic"; }
            return "empty";
        }
        // calendar 坐标系优先于系列类型分发：日历网格是面板骨架，
        // 子系列（heatmap/scatter/graph/pie）都是叠在格上的装饰。
        if (o.calendars.Count > 0) { return "calendar"; }
        // matrix 坐标系同理（ECharts6 coord/matrix）：维度树头带 +
        // 叶子体格是面板骨架，heatmap 等系列是格上的填色。组件缺席
        // 时不劫持（无从布局，落回原类型渲染器）。
        if (o.matrix != null) {
            for (int mxsi = 0; mxsi < o.series.Count; mxsi = mxsi + 1) {
                if (o.series[mxsi].coordSys == "matrix") { return "matrix"; }
            }
        }
        // 极坐标同理（ECharts5/6 angleAxis/radiusAxis 圆框）：
        // coordinateSystem:"polar" 的 line/scatter 系列按角度投影。
        for (int psi = 0; psi < o.series.Count; psi = psi + 1) {
            if (o.series[psi].coordSys == "polar") { return "polarCoord"; }
        }
        // geo 组件同理，且必须是**组件级**判定：geo 底图是面板骨架，
        // 挂在它上面的 scatter/lines/graph/custom/pie 都是投影装饰。
        // 按首个可见系列分发会翻车——geo-choropleth-scatter /
        // coordinateSystem:"geo" 的 scatter，LeadType 判成 scatter，
        // 于是 DrawMap/DrawGeoOverlay 永不执行，底图与全部投影点丢失，
        // 只剩一个空散点坐标系。scatter-map 之所以正常，只是因为它的
        // series[0] 恰好是合成底图载体（isGeoBase）而走 map。
        if (o.geos.Count > 0) { return "map"; }
        ChartType t = ChartView.LeadType(o);
        ChartSeries leadS = ChartView.LeadSeries(o);
        if (t == ChartType.Pie && leadS != null && leadS.piePerPoint) {
            // 以饼代点（mix7）：饼几何由散点面板按点坐标逐个绘制，
            // 面板本身仍是散点坐标系。
            t = ChartType.Scatter;
        }
        if (t == ChartType.Pie) {
            if (leadS != null && leadS.roseType.Length > 0) { return "rose"; }
            return "pie";
        }
        if (t == ChartType.Gauge) { return "gauge"; }
        if (t == ChartType.Heatmap) { return "heatmap"; }
        if (t == ChartType.WordCloud) { return "wordCloud"; }
        if (t == ChartType.Radar) { return "radar"; }
        if (t == ChartType.Funnel) { return "funnel"; }
        if (t == ChartType.Treemap) { return "treemap"; }
        if (t == ChartType.Tree) { return "tree"; }
        if (t == ChartType.K) { return "k"; }
        if (t == ChartType.Chord) { return "chord"; }
        if (t == ChartType.Force) { return "force"; }
        if (t == ChartType.Map) { return "map"; }
        if (t == ChartType.EventRiver) { return "eventRiver"; }
        if (t == ChartType.Custom) {
            string ck = "";
            if (leadS != null) { ck = leadS.custom; }
            if (ck == "sankey") { return "sankey"; }
            if (ck == "box") { return "box"; }
            if (ck == "error") { return "error"; }
            if (ck == "waterfall") { return "waterfall"; }
            if (ck == "sunburst") { return "sunburst"; }
            if (ck == "radialBars") { return "radialBars"; }
            if (ck == "venn") { return "venn"; }
            if (ck == "pictorialBar") { return "pictorialBar"; }
            if (ck == "parallel") { return "parallel"; }
            if (ck == "themeRiver") { return "themeRiver"; }
            if (ck == "lines") { return "linesCustom"; }
            if (ck == "scatter" || (leadS != null && leadS.points.Count > 0
                && (o.xAxes.Count == 0 || o.xAxes[0].type != ChartAxisType.Category))) {
                return "scatter";
            }
            return "empty";
        }
        if (t == ChartType.Bar) {
            // ECharts stack 是系列级声明：任一柱系列带堆叠组即按
            // 堆叠布局走（DrawBars 按 stackName 分组，未入组的系列
            // 各自成列）——不能只看 lead（mix2 lead 直接访问未入组）。
            bool stacked = (leadS != null && leadS.stack != 0);
            if (!stacked) {
                for (int si = 0; si < o.series.Count; si = si + 1) {
                    if (!o.series[si].hidden && o.series[si].type == ChartType.Bar
                        && (o.series[si].stack != 0
                            || o.series[si].stackName.Length > 0)) {
                        stacked = true;
                        break;
                    }
                }
            }
            bool hbar = (leadS != null && leadS.hbar);
            if (stacked && hbar) { return "barStackedHbar"; }
            if (stacked) { return "barStacked"; }
            if (hbar) { return "hbar"; }
            return "bar";
        }
        if (t == ChartType.Scatter) {
            if (leadS != null && leadS.bubbles.Count > 0) { return "bubbles"; }
            return "scatter";
        }
        // 点系列（OfPoints / JSON 的 data:[[x,y],...]）带 Line 类型：
        // ECharts line7 双数值轴——连线画在散点空间里，x 与 y 都按
        // 数值映射。特征是 data 为空而 points 非空；分类轴折线
        // 渲染器只读 data，会缩放成默认 0-5 空轴、什么都不画。
        // DrawScatterCore 把 Line 类型的点系列画成折线，
        // ScatterHover 提示 x/y 数值。
        if (leadS != null && leadS.data.Count == 0
            && leadS.points.Count > 0) {
            // ECharts type:'line' 的值对系列（line7 双数值轴）走折线
            // 渲染器：连线 + 符号 + markLine/markPoint 全套；
            // type:'scatter' 的点云仍走散点渲染器（只画点不连线）。
            if (leadS.type == ChartType.Line) {
                // 堆叠判得在点系列判定**之前**：时间值对（line-tooltip-touch
                // 的 [[ts,v],...] + stack:'a'）落在 points 里，若先按
                // "点系列 → lines" 返回，堆叠判定永远轮不到——两条
                // stack 同名系列各自按原始值画，官方是累计面积带。
                if (leadS.stack != 0 || leadS.stackName.Length > 0) {
                    return "stackedArea";
                }
                return "lines";
            }
            return "scatter";
        }
        // 折线族：堆叠的引导序列渲染累计填充带，其余绘制折线。
        if (leadS != null && leadS.stack != 0) { return "stackedArea"; }
        return "lines";
    }

    // 未知 / 空 kind 的明确空状态：不绘制错误的图表。
    public static void DrawEmptyState(App app, int x, int y, int w, int h, ChartOption o) {
        Theme t = app.theme;
        StyleBox sPanel = Style.Full(app, "chart", "", "", Style.SNormal());
        app.canvas.SurfaceRoundRect(x, y, w, h, t.borderRadiusMedium, sPanel.BgOr(0), sPanel.BorderOr(0), 1);
        if (o.title.Length > 0) {
            app.canvas.DrawText(x + t.paddingMedium, y + t.paddingMedium,
                o.title, sPanel.FgOr(0), Style.FontFallback(app, "large"));
        }
        string msg = "(no data)";
        int mw = Canvas.MeasureText(msg, Style.FontFallback(app, "small"));
        app.canvas.DrawText(x + w / 2 - mw / 2,
            Canvas.CenterTextYAt(y + h / 2, Style.FontFallback(app, "small")),
            msg, Style.Part(app, "chart", "hint", "", "", "", Style.SNormal()).FgOr(0),
            Style.FontFallback(app, "small"));
    }

    // 非.ready 状态的整面覆盖绘制（loading/empty/error 文案；
    // "ready" 为空操作）。
    public static void DrawStatusState(App app, int x, int y, int w, int h,
                                string status, string message) {
        if (status == "ready") { return; }
        Theme t = app.theme;
        StyleBox panel = Style.Full(app, "chart", "", "", Style.SNormal());
        int bg = panel.BgOr(0);
        int fg = panel.FgOr(0);
        if (status == "loading") { bg = 0xCCFFFFFF; }
        if (status == "error") { fg = 0xFFC0392B; }
        app.canvas.SurfaceRoundRect(x, y, w, h, t.borderRadiusMedium, bg,
            panel.BorderOr(0), 1);
        string msg = message;
        if (msg.Length == 0) {
            if (status == "loading") { msg = "Loading..."; }
            else if (status == "empty") { msg = "(no data)"; }
            else if (status == "error") { msg = "Chart error"; }
            else { msg = "(disposed)"; }
        }
        int fs = Style.FontFallback(app, "small");
        int mw = Canvas.MeasureText(msg, fs);
        app.canvas.DrawText(x + w / 2 - mw / 2,
            Canvas.CenterTextYAt(y + h / 2, fs), msg, fg, fs);
    }

    // 任一序列为面积线时返回 true（对应 ECharts line.areaStyle.show）。
    public static bool HasArea(ChartOption o) {
        for (int i = 0; i < o.series.Count; i = i + 1) {
            if (o.series[i].areaStyle) {
                return true;
            }
        }
        return false;
    }

    // 折线族类型以折线绘制（可选填充 / 阶梯 /
    // 堆叠 —— 目前均为 Line 类型；它们是序列的子实体）。
    public static bool IsLineFamily(ChartType t) {
        return t == ChartType.Line;
    }

    // 柱状族类型占据一个柱位（分组 / 堆叠 / 水平）。
    public static bool IsBarFamily(ChartType t) {
        return t == ChartType.Bar;
    }

    // 堆叠组名称的索引，无则 -1（柱状图按 stackName 分组）。
    // ECharts stackStrategy 的组内累加（processor/dataStack.ts:112-165）。
    // 对一组共享 stack 的系列，逐系列算它在**本点**的堆叠顶端值，写进
    // into（与 rawVals 同序同长）。语义逐条对抄：
    // sum 从**本系列自己的值**起算（源码 `let sum = targetData.get(
    // stackedDimension, dataIndex)`）；
    // 再从本系列往前扫前驱 j = idx-1 .. 0，取第一个满足策略条件的
    // 前驱**结果**（不是原始值——链上前驱的结果已是它那条链的和）
    // 累加后 break（源码单次 break，不是全累加）；
    // 条件：all 恒真；positive 要求 val > 0；negative 要求 val < 0；
    // samesign（缺省）要求“当前和与前驱值同号”（sum>=0&&val>0 或
    // sum<=0&&val<0）。
    // **策略按系列各自取**：源码用 `targetStackInfo.seriesModel.get(
    // stackStrategy)`，即算第 idx 条时用第 idx 条自己的声明——同一
    // 堆叠组里各系列可以声明不同策略，故 strategies 是逐下标数组。
    // 找不到合格前驱时结果就是自己的值（源码 stackedOver = NaN）。
    // 于是“段的基线”= 结果 − 自己的值（无前驱时恰为 0），调用方不必
    // 再分辨正负累加器。
    public static void StackResults(List<double> rawVals, List<int> strategies,
                             List<double> into) {
        int n = rawVals.Count;
        for (int idx = 0; idx < n; idx = idx + 1) {
            int strategy = idx < strategies.Count ? strategies[idx] : 0;
            double sum = rawVals[idx];
            for (int j = idx - 1; j >= 0; j = j - 1) {
                double val = into[j];
                bool ok = false;
                if (strategy == 1) { ok = true; }
                else if (strategy == 2) { ok = val > 0.0; }
                else if (strategy == 3) { ok = val < 0.0; }
                else { ok = (sum >= 0.0 && val > 0.0) || (sum <= 0.0 && val < 0.0); }
                if (ok) { sum = sum + val; break; }
            }
            into.Add(sum);
        }
    }

    // 整幅系列在**某一点**的堆叠顶端值（按 series 序，未堆叠系列即自身
    // 值）。分组口径与各渲染器一致：同 `stackName` 成一组（空 stackName
    // 也自成一组，与既有累加器行为一致）。逐系列沿组内前驱跑一次
    // StackResults，取末项。系列数很小（典型 2..10），每点 O(n²) 可接受。
    // 调用方拿 `top[si] − 自身值` 即该段基线。
    public static void StackTopAll(List<ChartSeries> series, int oi,
                            List<double> into) {
        int ns = series.Count;
        for (int si = 0; si < ns; si = si + 1) {
            into.Add(ChartView.StackTopAt(series, si, oi));
        }
    }

    // 同组内到 si 为止的堆叠链结果（= 该系列的堆叠顶端值）。
    // 未堆叠系列（无合格前驱）即自身值。
    public static double StackTopAt(List<ChartSeries> series, int si, int oi) {
        ChartSeries sc = series[si];
        if (!ChartView.IsStackedSeries(sc)) { return sc.Number(oi); }
        List<double> raw = new List<double>();
        List<int> sts = new List<int>();
        for (int j = 0; j <= si; j = j + 1) {
            ChartSeries sj = series[j];
            if (sj.hidden || !ChartView.IsStackedSeries(sj)) { continue; }
            if (sj.stackName != sc.stackName) { continue; }
            raw.Add(sj.Number(oi));
            sts.Add(sj.stackStrategy);
        }
        List<double> res = new List<double>();
        ChartView.StackResults(raw, sts, res);
        if (res.Count < 1) { return sc.Number(oi); }
        return res[res.Count - 1];
    }

    // 第 si 条系列在第 oi 点上的**堆叠基线**（= 该段应从哪条水平/垂直
    // 线起画）。语义 = ECharts processor/dataStack.ts 的 resultVal 减
    // 自身原始值：无合格前驱时恰为 0（段从零轴起画）。
    // 分组口径与各渲染器一致：同 `stackName` 成一组（空 stackName 也
    // 自成一组）。组内只算到 si 为止（含），策略逐系列取自各自声明。
    // 返回原始值单位（调用方按需 ×1000 转定点）。
    public static double StackBaseAt(List<ChartSeries> series, int si, int oi) {
        ChartSeries sc = series[si];
        if (!ChartView.IsStackedSeries(sc)) { return 0.0; }
        return ChartView.StackTopAt(series, si, oi) - sc.Number(oi);
    }

    // 本系列是否声明了堆叠组。ECharts dataStack.ts:44 的
    // `if (stack)` ——空 stack 的系列**不进任何堆叠组**（既不参与
    // 累加，也不作为前驱被后续系列读取），而不是“空名自成一组”。
    // 空名成组只对**列布局**（并排柱分组）成立。
    public static bool IsStackedSeries(ChartSeries s) {
        return s.stackName.Length > 0 || s.stack != 0;
    }

    public static int GroupIndex(List<string> groups, string name) {
        for (int i = 0; i < groups.Count; i = i + 1) {
            if (groups[i] == name) { return i; }
        }
        return 0 - 1;
    }

    // 每帧渲染入口：解析 option（ResolvedChart）、按需播放入场
    // 动画（AnimIntroIn，键 IdHash.HashInt(wid, 500)；map/heatmap/wordCloud/
    // force/treemap 恒静态）、分发渲染器、画工具箱/状态层/dataRange，
    // 并派发指针交互与 Rendered/Resized/Updated/DataChanged 事件。
    public void Render(App app, int x, int y, int w, int h) {
        if (this.disposed) { return; }
        // 首帧自挂 App 呈现尾段（延迟提示的刷新从 App.PresentFrame
        // 的挂点走——App 编译图不背 Chart 家族，真渲染图表的程序才
        // 走到这条注册）。
        if (!ChartView.tailHooked) {
            ChartView.tailHooked = true;
            App.AddPresentTail(ChartView.FlushTooltips);
        }
        bool resized = this.hasRendered && (this.lastRenderW != w || this.lastRenderH != h);
        bool updated = false;
        if (this.controller != null) {
            int cv = this.controller.Version();
            updated = this.hasRendered && cv != this.lastControllerVersion;
            ChartOption current = this.controller.Option();
            // Controller.Dispose() 清空其 option，但 view 仍可把最后一帧
            // 作为背景绘出，并由状态层显示 disposed，而不是把 null
            // 传给 resolved/layout。
            if (current != null) { this.sourceOption = current; }
        } else {
            updated = this.hasRendered && this.directVersion != this.lastDirectVersion;
        }
        if (this.sourceOption == null) { this.sourceOption = ChartOption.Create(); }
        Theme t = app.theme;
        this.resolved = ResolvedChart.Resolve(this.sourceOption, t, app, wid);
        bool animate = this.resolved.animate;
        if (this.staticFrame) { animate = false; }
        string kind0 = ChartView.DispatchKind(this.sourceOption);
        if (kind0 == "map" || kind0 == "heatmap" || kind0 == "wordCloud"
            || kind0 == "force" || kind0 == "treemap") {
            animate = false;
        }
        if (this.sourceOption.backgroundColor != 0) {
            if (this.sourceOption.backgroundGradStops != null
                && this.sourceOption.backgroundGradStops.Count >= 2) {
                int cFrom = this.sourceOption.backgroundGradStops[0];
                int cVia = this.sourceOption.backgroundGradStops.Count >= 3
                    ? this.sourceOption.backgroundGradStops[1] : 0;
                int cTo = this.sourceOption.backgroundGradStops[
                    this.sourceOption.backgroundGradStops.Count - 1];
                app.canvas.FillGradMask(x, y, w, h, 0, 15, 0, cFrom, cVia, cTo);
            } else {
                app.canvas.FillRect(x, y, w, h, this.sourceOption.backgroundColor);
            }
        }

        int g = 1000;
        if (animate) {
            g = app.AnimIntroIn(IdHash.HashInt(wid, 500), this.sourceOption.animMs,
                                x, y, w, h);
        }

        ChartOption drawOption = this.resolved.DrawOption(wid, animate);
        if (app.StateGet(Chart.TbZoomKey(wid), 0) != 0) { drawOption.zoom = true; }
        ChartView.ApplyMagic(drawOption, app.StateGet(Chart.TbMagicKey(wid), 0));
        // connect() 联动：drawOption.iwid 已是组共享基址（组长 wid，
        // 由 Resolve 期登记），渲染器的全部交互键同帧落到组键上。
        option = drawOption;
        Chart.toolReserve = 0;
        Chart.legendOpt = drawOption;  // 图例 orient/selectedMode/formatter 的帧内来源
        if (drawOption.toolboxShow) {
            Chart.toolReserve = ChartToolbox.Width(app, drawOption);
        }
        // dataRange 条固定在控件底部：分派前把高度扣掉，面板与
        // 绘图区只在剩余矩形里布局（同 toolReserve 的帧内约定）。
        int drH = ChartViewDataRange.Height(app, drawOption);
        int innerH = h - drH;
        if (drH > 0 && innerH < app.Scale(80)) { drH = 0; innerH = h; }

        // 把每种图表裁剪到自己的矩形，防止绘图线、柱条、
        // 轴标签和图例溢出到相邻控件。
        // emphasis.focus='series' 渐隐的帧内状态源：读 wid 悬停槽里
        // 上一帧的命中（下面的渲染会重置并重测 currentHit），该系列
        // 声明 focus:'series' 时渲染器把其余系列乘残透明（官方
        // bump 图"鼠标经过其余线渐变"的观感）。
        ChartColor.fadeFocusIdx = -1;
        ChartHit hoverPrev = ChartView.HoverSlotHit(this.wid);
        if (hoverPrev != null && hoverPrev.seriesIndex >= 0
            && hoverPrev.seriesIndex < drawOption.series.Count
            && drawOption.series[hoverPrev.seriesIndex].emphasisFocus
                == "series") {
            ChartColor.fadeFocusIdx = hoverPrev.seriesIndex;
        }
        ChartView.activeEventView = this;
        this.currentHit = null;
        string pointerKind = ChartView.DispatchKind(drawOption);
        bool selectionSurface = (pointerKind == "pie" || pointerKind == "rose")
            ? drawOption.iwid != 0
            : (pointerKind == "map" && drawOption.mapSelect && drawOption.iwid != 0);
        if (this.eventHitId < 0 && (ChartView.HasInteraction(this, ChartEventType.Click)
            || ChartView.HasInteraction(this, ChartEventType.DoubleClick)
            || ChartView.HasInteraction(this, ChartEventType.Hover)
            || ChartView.HasInteraction(this, ChartEventType.MouseOut)
            || ChartView.HasInteraction(this, ChartEventType.PieSelected)
            || ChartView.HasInteraction(this, ChartEventType.MapSelected)
            || selectionSurface)) {
            // 独立作用域 Hash ID，不随即时模式控件的分配顺序漂移。
            this.eventHitId = IdHash.HashInt(this.wid, 970);
        }
        if (this.eventHitId >= 0 && this.Status() == "ready") {
            // 根命中区放在所有 renderer 之前；系列、图例和工具箱
            // 后续注册的区域优先，未被更具体区域命中的空白点击
            // 才到达图表级 Click。
            app.hitTester.RegisterRect(this.eventHitId, x, y, w, h, 0);
        }
        app.canvas.PushClip(x, y, w, h);
        this.DispatchRender(app, x, y, w, innerH, g);
        if (drH > 0) {
            ChartViewDataRange.Draw(app, x, y + innerH, w, drH, drawOption);
        }
        app.canvas.PopClip();

        // ECharts 工具箱：右上角。o.toolboxShow 关闭时不画。
        if (drawOption.toolboxShow) {
            ChartView.DrawToolbox(app, x, y, w, h, this.wid, drawOption);
            ChartView.FlushToolboxSave(app, this.wid);
        }
        ChartView.DrawStatusState(app, x, y, w, h,
            this.Status(), this.StatusMessage());

        string statusNow = this.Status();
        this.DispatchPointerEvents(app, x, y, w, h, statusNow);
        int zlo = statusNow == "ready"
            ? app.StateGet(Chart.ZoomLoKey(this.wid), 0) : 0;
        int zhi = statusNow == "ready"
            ? app.StateGet(Chart.ZoomHiKey(this.wid), 1000) : 1000;
        if (this.lastZoomLo >= 0 && (zlo != this.lastZoomLo || zhi != this.lastZoomHi)) {
            ChartInteractionEvent ze = ChartInteractionEvent.Of(
                ChartEventType.DataZoom, this.wid);
            ze.zoomStart = zlo;
            ze.zoomEnd = zhi;
            ze.x = app.mouseX;
            ze.y = app.mouseY;
            this.RaiseInteraction(ze);
        }
        this.lastZoomLo = zlo;
        this.lastZoomHi = zhi;
        if (resized && this.Resized.Count() > 0) { this.Resized.Raise(); }
        if (resized) {
            ChartInteractionEvent re = ChartView.EventAt(
                ChartEventType.Resize, this.wid, w, h);
            this.RaiseInteraction(re);
        }
        if (updated && this.Updated.Count() > 0) { this.Updated.Raise(); }
        if (updated && this.controller == null) {
            ChartInteractionEvent ue = ChartInteractionEvent.Of(
                ChartEventType.DataChanged, this.wid);
            this.RaiseInteraction(ue);
        }
        if (updated && this.controller != null) {
            ChartInteractionEvent ue2 = ChartInteractionEvent.Of(
                ChartEventType.DataChanged, this.wid);
            this.RaiseLocal(ue2);
        }
        
        this.lastRenderW = w;
        this.lastRenderH = h;
        if (this.controller != null) { this.lastControllerVersion = this.controller.Version(); }
        else { this.lastDirectVersion = this.directVersion; }
        this.hasRendered = true;
        ChartView.activeEventView = null;
        Chart.EndFrame();
    }


    // 工具箱「魔法类型」落地：magic 1/2 把全部 Line/Bar 系列的
    // type 就地改为 Line/Bar（切柱状时关掉 areaStyle）；其余值
    // 空操作。
    public static void ApplyMagic(ChartOption o, int magic) {
        if (magic != 1 && magic != 2) { return; }
        ChartType t = ChartType.Line;
        if (magic == 2) { t = ChartType.Bar; }
        for (int i = 0; i < o.series.Count; i = i + 1) {
            ChartSeries s = o.series[i];
            if (s.type == ChartType.Line || s.type == ChartType.Bar) {
                s.type = t;
                if (t == ChartType.Bar) { s.areaStyle = false; }
            }
        }
    }

    // 显式分发：每个 kind 都有一个明确的分支。没有未知
    // kind 回退为折线图；未知/空 kind 绘制明确空状态。
    void DispatchRender(App app, int x, int y, int w, int h, int g) {
        ChartOption option = this.option;
        // 多 grid 布局（grid[] ≥ 2）全 kind 通用拆分：按 series.
        // xAxisIndex 分组，每组在自己的 grid 矩形里重入分发链；
        // 标题/图例只在全局面板坐标画一次。
        if (option.grids.Count > 1 && !option.overlay) {
            ChartView.DrawMultiGridPanels(app, x, y, w, h, option, g);
            return;
        }
        ChartView.RenderOnce(app, x, y, w, h, option, g);
    }

    // 分发链本体：DispatchRender 与多 grid 子面板共用（子 option
    // 的 kind 按组内系列重算，蜡烛+成交量、行/列布局混排各自
    // 落到正确的渲染器）。
    public static void RenderOnce(App app, int x, int y, int w, int h,
                           ChartOption option, int g) {
        // N7 z/zlevel 绘制序兜底重排（Resolve 主路径已在解析期把
        // 系列表排成 ZOrder 序，这里的调用覆盖直接以源 option 渲染的
        // 路径——Keyed 缓存 miss、图例回放、探针直渲）。同键保持声明
        // 序，本帧排序不回写源 option，声明序恒为准。
        if (!option.overlay) { ChartView.ZSort(option); }
        string kind = ChartView.DispatchKind(option);
        ChartSeries leadS = ChartView.LeadSeries(option);
        // 底部图例占位每图清零（不经 DrawPanelI 的视图不背上一图的值）。
        Chart.legendBottomReserve = 0;
        ISeriesRenderer renderer = SeriesRendererRegistry.Find(kind);
        if (renderer != null) {
            renderer.Render(app, x, y, w, h, option, g);
        } else if (!ChartView.DispatchBuiltin(app, x, y, w, h, option, g, kind)) {
            ChartView.DrawEmptyState(app, x, y, w, h, option);
        }
        // 同 option 混搭（ECharts 每系列自带坐标系/几何）：面板按
        // 主导系列画完后，pie / gauge / funnel 系列按自身 center/
        // radius 叠加绘制（mix2 柱状饼、mix3 地图玫瑰饼、mix11
        // 仪表盘+双漏斗、mix12 折线饼图）。
        ChartView.DrawOverlaySeries(app, x, y, w, h, option, g, kind);
        if (option.graphics != null && option.graphics.Count > 0 && kind != "graphic") {
            ChartView.DrawGraphic(app, x, y, w, h, option, g);
        }
    }

    // 混搭覆盖层：把与面板主导类型不同的 pie/gauge/funnel 系列
    // 逐条再画一遍。覆盖层 option 置 overlay=true（渲染器跳过
    // 面板底/头），交互键沿用 o.iwid（悬停/命中与整板一致）。
    public static void DrawOverlaySeries(App app, int x, int y, int w, int h,
                                  ChartOption o, int g, string kind) {
        for (int i = 0; i < o.series.Count; i = i + 1) {
            ChartSeries s = o.series[i];
            if (s.hidden) { continue; }
            bool pieMain = kind == "pie" || kind == "rose";
            if (s.type == ChartType.Pie && !pieMain && !s.piePerPoint) {
                ChartOption tmp = ChartOption.Create();
                tmp.overlay = true;
                tmp.iwid = o.iwid;
                tmp.showLegend = false;
                tmp.showTooltip = o.showTooltip;
                tmp.pieLabels = o.pieLabels;
                tmp.series = new List<ChartSeries>();
                tmp.series.Add(s);
                ChartView.DrawPie(app, x, y, w, h, tmp, tmp.pieLabels, g);
            } else if (s.type == ChartType.Gauge && kind != "gauge") {
                ChartOption tmp = ChartOption.Create();
                tmp.overlay = true;
                tmp.iwid = o.iwid;
                tmp.showLegend = false;
                tmp.showTooltip = o.showTooltip;
                tmp.series = new List<ChartSeries>();
                tmp.series.Add(s);
                ChartView.DrawGauge(app, x, y, w, h, tmp, g);
            } else if (s.type == ChartType.Funnel && kind != "funnel"
                       && s.center != null && s.radius != null) {
                // ECharts funnel.x/width 折算为「中心 x + 全宽 radius」
                // （mix11 预期/实际双漏斗并列在右半区）。
                ChartOption tmp = ChartOption.Create();
                tmp.overlay = true;
                tmp.iwid = o.iwid;
                tmp.showLegend = false;
                tmp.showTooltip = o.showTooltip;
                tmp.series = new List<ChartSeries>();
                tmp.series.Add(s);
                int fw = ChartView.GaugeScalar(app, s.radius, w);
                if (fw < app.Scale(40)) { fw = app.Scale(40); }
                int fcx = x + ChartView.GaugeScalar(app, s.center.x, w);
                ChartView.DrawFunnel(app, fcx - fw / 2, y, fw, h, tmp, g,
                    s.sort == "ascending");
            }
        }

        // 地图与笛卡尔坐标系混搭（如 geo-organ）：当主面板分发为 map 底图时，
        // 挂在独立 grid 上的非 geo 系列（如柱状/折线/散点）作为覆盖层在本格内绘制。
        if (kind == "map" && (o.xAxes.Count > 0 || o.yAxes.Count > 0)) {
            List<ChartSeries> cartSeries = new List<ChartSeries>();
            for (int ci = 0; ci < o.series.Count; ci = ci + 1) {
                ChartSeries cs = o.series[ci];
                if (!cs.hidden && cs.coordSys != "geo"
                    && (cs.type == ChartType.Bar || cs.type == ChartType.Line || cs.type == ChartType.Scatter)) {
                    cartSeries.Add(cs);
                }
            }
            if (cartSeries.Count > 0) {
                ChartOption tmp = ChartOption.Clone(o);
                if (tmp != null) {
                    tmp.overlay = true;
                    tmp.geos.Clear();
                    tmp.series = cartSeries;
                    string cKind = ChartView.DispatchKind(tmp);
                    Chart.gridPanelSub = true;
                    if (cKind == "bar" || cKind == "hbar" || cKind == "barStacked" || cKind == "barStackedHbar") {
                        bool stacked = cKind == "barStacked" || cKind == "barStackedHbar";
                        bool hbar = cKind == "hbar" || cKind == "barStackedHbar";
                        ChartView.DrawBars(app, x, y, w, h, tmp, g, stacked, hbar);
                    } else if (cKind == "lines" || cKind == "stackedArea") {
                        ChartView.DrawLines(app, x, y, w, h, tmp, g);
                    } else if (cKind == "scatter") {
                        ChartView.DrawScatter(app, x, y, w, h, tmp, g);
                    }
                    Chart.gridPanelSub = false;
                }
            }
        }
    }

    // ---- graphic 原生矢量组件绘制入口 ----
    public static void DrawGraphic(App app, int x, int y, int w, int h, ChartOption o, int g) {
        if (o.graphics == null || o.graphics.Count == 0) { return; }
        Canvas c = app.canvas;
        int top = ChartView.PanelHead(app, x, y, w, h, o.title);
        int pad = app.theme.paddingMedium;
        int areaY = top;
        int areaH = (y + h - pad) - top;
        if (areaH < app.Scale(16)) { areaH = app.Scale(16); }

        for (int i = 0; i < o.graphics.Count; i = i + 1) {
            ChartView.DrawGraphicElement(app, c, x, areaY, w, areaH, o.graphics[i], g);
        }
    }

    public static void DrawGraphicElement(App app, Canvas c, int px, int py, int pw, int ph, ChartGraphic el, int g) {
        if (el == null) { return; }
        int elX = px + app.Scale(el.x);
        int elY = py + app.Scale(el.y);
        if (el.left == "center") {
            elX = px + pw / 2;
        } else if (el.left == "right") {
            elX = px + pw;
        } else if (el.left.Length > 0 && el.left != "left") {
            int num = 0;
            for (int k = 0; k < el.left.Length; k = k + 1) {
                char ch = el.left[k];
                if (ch >= '0' && ch <= '9') { num = num * 10 + (ch - '0'); }
            }
            if (el.left.EndsWith("%")) {
                elX = px + pw * num / 100;
            } else if (num > 0) {
                elX = px + app.Scale(num);
            }
        }

        if (el.top == "center" || el.top == "middle") {
            elY = py + ph / 2;
        } else if (el.top == "bottom") {
            elY = py + ph;
        } else if (el.top.Length > 0 && el.top != "top") {
            int num2 = 0;
            for (int k = 0; k < el.top.Length; k = k + 1) {
                char ch = el.top[k];
                if (ch >= '0' && ch <= '9') { num2 = num2 * 10 + (ch - '0'); }
            }
            if (el.top.EndsWith("%")) {
                elY = py + ph * num2 / 100;
            } else if (num2 > 0) {
                elY = py + app.Scale(num2);
            }
        }

        if (el.type == "group") {
            for (int ci = 0; ci < el.children.Count; ci = ci + 1) {
                ChartView.DrawGraphicElement(app, c, elX, elY, pw, ph, el.children[ci], g);
            }
            return;
        }

        if (el.type == "rect") {
            int rx = elX + app.Scale(el.shapeX);
            int ry = elY + app.Scale(el.shapeY);
            int rw = app.Scale(el.shapeW > 0 ? el.shapeW : 10);
            int rh = app.Scale(el.shapeH > 0 ? el.shapeH : 10);
            if (el.left == "center") { rx = rx - rw / 2; }
            if (el.top == "center" || el.top == "middle") { ry = ry - rh / 2; }
            if (el.hasFill && el.fill != 0) {
                c.FillRect(rx, ry, rw, rh, el.fill);
            }
            if (el.stroke != 0) {
                c.DrawRect(rx, ry, rw, rh, el.stroke, app.Scale(el.strokeWidth > 0 ? el.strokeWidth : 1));
            }
        } else if (el.type == "circle") {
            int cx = elX;
            int cy = elY;
            int cr = app.Scale(el.shapeR > 0 ? el.shapeR : 5);
            if (el.hasFill && el.fill != 0) {
                c.FillCircle(cx, cy, cr, el.fill);
            }
            if (el.stroke != 0) {
                c.DrawCircle(cx, cy, cr, el.stroke, app.Scale(el.strokeWidth > 0 ? el.strokeWidth : 1));
            }
        } else if (el.type == "text") {
            if (el.text != null && el.text.Length > 0) {
                int fs = app.Scale(el.fontSize > 0 ? el.fontSize : 14);
                int col = el.hasFill && el.fill != 0 ? el.fill : (el.stroke != 0 ? el.stroke : Chart.TitleColor());
                List<string> lines = el.text.Split("\n");
                int lineH = Canvas.FontHeight(fs) + app.Scale(4);
                int totalH = lines.Count * lineH;
                int startY = elY;
                if (el.top == "center" || el.top == "middle") {
                    startY = elY - totalH / 2;
                }
                for (int li = 0; li < lines.Count; li = li + 1) {
                    string line = lines[li];
                    int tw = Canvas.MeasureText(line, fs);
                    int lx = elX;
                    if (el.left == "center") { lx = elX - tw / 2; }
                    else if (el.left == "right") { lx = elX - tw; }
                    if (el.fontWeight == "bold") {
                        c.DrawTextBold(lx, startY + li * lineH, line, col, fs);
                    } else {
                        c.DrawText(lx, startY + li * lineH, line, col, fs);
                    }
                }
            }
        }
    }

    // ---- 富文本排版与绘制（Chart.RichTokenize 的下游） ----

    // 量测排版：段表 → 整块盒（含外层 label.padding）。语义按官方
    // SSR 实测钉死（pie-nest：盒高 55 = 22+0+33）：
    // - 行高 = 各段 max(声明 lineHeight, 声明 height + 纵 padding,
    // 字号行盒 + 纵 padding)；整行无任何声明才回退缺省行盒
    // （hr 的 height:0 行高就是 0，不吃回退）。
    // - 段盒在行内垂直居中（饼名/横线/数值三行的文本中线 = 行中线）。
    // - width:'100%' → 全块宽，x 归行首（pie-rich-text 的 abg 底板
    // 同行共享：{title|..}{abg|} 底板盖整行、标题文字压在其上）。
    // - 声明 width 的段：盒 = width + 横向 padding（padding 在外），
    // align 在盒内排文字（表格列）。
    // - 未声明 width 的 align 段：整行内容在块宽内对齐（左/中/右，
    // 取行内第一个这类段的 align；pie-nest a 居中：两标签块宽
    // 61/140，内容整体中线都是块中线）。
    // - 绘制见 RichDraw：底色全部先画（abg 底板压在同行文字下）。
    public static RichBlock RichLayout(App app, List<RichSeg> segs,
                                ChartTextStyle st, int defFs) {
        RichBlock b = new RichBlock();
        b.segs = segs;
        b.st = st;
        b.lines = 0;
        int padT = 0;
        int padR = 0;
        int padB = 0;
        int padL = 0;
        if (st != null) {
            if (st.padT >= 0) { padT = app.Scale(st.padT); }
            if (st.padR >= 0) { padR = app.Scale(st.padR); }
            if (st.padB >= 0) { padB = app.Scale(st.padB); }
            if (st.padL >= 0) { padL = app.Scale(st.padL); }
        }
        for (int i = 0; i < segs.Count; i = i + 1) {
            RichSeg sg = segs[i];
            sg.fsPx = sg.st != null && sg.st.fontSize > 0
                ? app.Scale(sg.st.fontSize) : defFs;
            sg.tw = Canvas.MeasureText(sg.text, sg.fsPx);
            int padL2 = sg.st != null && sg.st.padL >= 0 ? app.Scale(sg.st.padL) : 0;
            int padR2 = sg.st != null && sg.st.padR >= 0 ? app.Scale(sg.st.padR) : 0;
            if (sg.st != null && sg.st.width >= 0) {
                // 官方 width 是内容宽，padding 加在外面（zrender token
                // width:20 + padding [0,20,0,30]）。
                sg.w = app.Scale(sg.st.width) + padL2 + padR2;
            } else if (sg.st != null && sg.st.width == 0 - 2) {
                sg.w = 0 - 1;  // '100%'，第二趟展开
            } else {
                sg.w = sg.tw + padL2 + padR2;
            }
            if (sg.line + 1 > b.lines) { b.lines = sg.line + 1; }
        }
        // 第一趟：自然宽（百分比/撑满段计 0）定块宽。
        int blockW = 0;
        List<int> lineW = new List<int>();
        for (int i = 0; i < b.lines; i = i + 1) { lineW.Add(0); }
        for (int i = 0; i < segs.Count; i = i + 1) {
            RichSeg sg = segs[i];
            if (sg.w >= 0) { lineW[sg.line] = lineW[sg.line] + sg.w; }
        }
        for (int i = 0; i < b.lines; i = i + 1) {
            if (lineW[i] > blockW) { blockW = lineW[i]; }
        }
        if (blockW <= 0) { blockW = 1; }
        // 第二趟：'100%' 展开为全块宽。
        for (int i = 0; i < segs.Count; i = i + 1) {
            RichSeg sg = segs[i];
            if (sg.w == 0 - 1) { sg.w = blockW; }
        }
        // 行高累计 + 段位：x 逐段累计（百分比段 x 归零），段盒在行内
        // 垂直居中。
        int yCur = 0;
        int segI = 0;
        while (segI < segs.Count) {
            int ln = segs[segI].line;
            int lhLine = 0;
            bool declared = false;
            int j = segI;
            while (j < segs.Count && segs[j].line == ln) {
                RichSeg sg = segs[j];
                int hDecl = sg.st != null && sg.st.height >= 0
                    ? sg.st.height : 0 - 1;
                // 段未声明自身 lineHeight 时回落 label 级 lineHeight
                // （gauge-speed detail.lineHeight 40：两段都没声明，
                // 行高 40 来自 detail 级）。
                int lhDecl = sg.st != null && sg.st.lineHeight >= 0
                    ? sg.st.lineHeight
                    : (st.lineHeight >= 0 ? st.lineHeight : 0 - 1);
                if (hDecl >= 0 || lhDecl >= 0) { declared = true; }
                int padT2 = sg.st != null && sg.st.padT >= 0 ? app.Scale(sg.st.padT) : 0;
                int padB2 = sg.st != null && sg.st.padB >= 0 ? app.Scale(sg.st.padB) : 0;
                int hh = Chart.RichSegH(hDecl, Canvas.FontHeight(sg.fsPx),
                    padT2, padB2);
                if (lhDecl >= 0) {
                    int lhD = app.Scale(lhDecl);
                    if (lhD > lhLine) { lhLine = lhD; }
                }
                if (hh > lhLine) { lhLine = hh; }
                sg.h = hh;
                j = j + 1;
            }
            if (lhLine <= 0 && !declared) { lhLine = Canvas.FontHeight(defFs); }
            // 行内容整体在块内对齐：行内第一个"声明了 align 且未声明
            // width"的段决定对齐（SSR 实测 pie-nest：'a' 居中时两标签
            // 块宽 61/140，内容整体中线都落块中线；pie-rich-text 表头
            // 的 valueHead 有 width，align 只在盒内生效不触发行对齐）。
            int contentW = 0;
            int lineAlign = 0 - 1;
            for (int k = segI; k < j; k = k + 1) {
                RichSeg sg = segs[k];
                // '100%' 底板是覆盖层不算行内容（title|abg 同行时
                // contentW 只算文字，标题才能在底板上居中）。
                if (!(sg.w == blockW && sg.st != null
                      && sg.st.width == 0 - 2)) {
                    contentW = contentW + sg.w;
                }
                if (lineAlign < 0 && sg.st != null && sg.st.align >= 0
                    && sg.st.width < 0) {
                    lineAlign = sg.st.align;
                }
            }
            int xShift = 0;
            if (lineAlign == 1) { xShift = (blockW - contentW) / 2; }
            else if (lineAlign == 2) { xShift = blockW - contentW; }
            if (xShift < 0) { xShift = 0; }
            int xCur = 0;
            for (int k = segI; k < j; k = k + 1) {
                RichSeg sg = segs[k];
                sg.x = xCur + xShift;
                sg.y = yCur + (lhLine - sg.h) / 2;
                sg.lh = lhLine;
                if (sg.w == blockW && sg.st != null && sg.st.width == 0 - 2) {
                    sg.x = 0;  // '100%' 底板恒从行首铺到块尾（不随行对齐）
                } else {
                    xCur = xCur + sg.w;
                }
            }
            yCur = yCur + lhLine;
            segI = j;
        }
        b.w = blockW + padL + padR;
        b.h = yCur + padT + padB;
        // 外层 padding 位移进段坐标（绘制端直接加块原点）。
        for (int i = 0; i < segs.Count; i = i + 1) {
            segs[i].x = segs[i].x + padL;
            segs[i].y = segs[i].y + padT;
        }
        return b;
    }

    // A14：带 textBorder/textShadow 的纯文本绘制（ECharts
    // labelStyle.ts:550——zrender 对 textBorderColor/Width 走 stroke
    // 字形、SVG 输出里是 `paint-order:stroke`，即**描边在填充之下**；
    // textShadow 是 filter: drop-shadow）。
    // Canvas 无模糊/无字形描边原语，移植口径：
    // - textBorder → 描边色按 width 圈 4 向（width>=2 加对角 4 向）
    // 各画一遍字形，再画填充字（描边永远垫底）。
    // - textShadow → 无模糊退化为偏移影子；纯 blur（无偏移）近似
    // 为四向 1px 晕圈。垫在描边与填充之下。
    // 无样式文本直接 DrawText（零开销快路）。
    public static void DrawTextStyled(Canvas c, int x, int y, string text,
                               int color, int fs,
                               int tbColor, int tbWidth,
                               int tsColor, int tsBlur, int tsDx, int tsDy) {
        if (text.Length == 0) { return; }
        if (tsColor != 0) {
            int dx = tsDx;
            int dy = tsDy;
            if (tsBlur > 0 && dx == 0 && dy == 0) {
                c.DrawText(x - 1, y, text, tsColor, fs);
                c.DrawText(x + 1, y, text, tsColor, fs);
                c.DrawText(x, y - 1, text, tsColor, fs);
                c.DrawText(x, y + 1, text, tsColor, fs);
            } else {
                c.DrawText(x + dx, y + dy, text, tsColor, fs);
            }
        }
        if (tbColor != 0 && tbWidth > 0) {
            int r = tbWidth;
            if (r >= 2) {
                c.DrawText(x - r, y - r, text, tbColor, fs);
                c.DrawText(x + r, y - r, text, tbColor, fs);
                c.DrawText(x - r, y + r, text, tbColor, fs);
                c.DrawText(x + r, y + r, text, tbColor, fs);
            }
            c.DrawText(x - r, y, text, tbColor, fs);
            c.DrawText(x + r, y, text, tbColor, fs);
            c.DrawText(x, y - r, text, tbColor, fs);
            c.DrawText(x, y + r, text, tbColor, fs);
        }
        c.DrawText(x, y, text, color, fs);
    }

    // DrawTextStyled 的 ChartTextStyle 版（label 级声明）。
    public static void DrawTextStyled(Canvas c, int x, int y, string text,
                               int color, int fs, ChartTextStyle st) {
        if (st == null || (st.tbColor == 0 && st.tsColor == 0)) {
            c.DrawText(x, y, text, color, fs);
            return;
        }
        ChartView.DrawTextStyled(c, x, y, text, color, fs,
            st.tbColor, st.tbWidth, st.tsColor, st.tsBlur, st.tsDx, st.tsDy);
    }

    // 绘制富文本块：整块底板（boxBg/border/圆角）→ 全部段底色片
    // 与线块 → 全部文字（两趟：abg 这类同行底板必须压在同行文字
    // 之下——zrender 段底色先于本段文字，但跨段的 title|abg 需要底
    // 在所有文字下）。文字垂直居中在段盒内。
    public static void RichDraw(App app, Canvas c, int ox, int oy, RichBlock b,
                         int defCol) {
        ChartTextStyle st = b.st;
        if (st != null && st.boxBg != 0 && b.w > 0 && b.h > 0) {
            int rad = st.boxRadius > 0 ? app.Scale(st.boxRadius) : 0;
            c.FillRoundRect(ox, oy, b.w, b.h, rad, st.boxBg);
        }
        if (st != null && st.boxBorder != 0 && st.boxBorderW > 0
            && b.w > 0 && b.h > 0) {
            int rad = st.boxRadius > 0 ? app.Scale(st.boxRadius) : 0;
            c.DrawRoundRect(ox, oy, b.w, b.h, rad, st.boxBorder,
                st.boxBorderW);
        }
        for (int i = 0; i < b.segs.Count; i = i + 1) {
            RichSeg sg = b.segs[i];
            ChartRichStyle rs = sg.st;
            int sx = ox + sg.x;
            int sy = oy + sg.y;
            if (rs == null) { continue; }
            if (rs.backgroundColor != 0 && sg.w > 0 && sg.h > 0) {
                int mask = (rs.radTL > 0 ? Corner.TL() : 0)
                    | (rs.radTR > 0 ? Corner.TR() : 0)
                    | (rs.radBR > 0 ? Corner.BR() : 0)
                    | (rs.radBL > 0 ? Corner.BL() : 0);
                int rad = rs.radTL > 0 ? app.Scale(rs.radTL)
                    : (rs.radTR > 0 ? app.Scale(rs.radTR)
                       : (rs.radBR > 0 ? app.Scale(rs.radBR)
                          : (rs.radBL > 0 ? app.Scale(rs.radBL) : 0)));
                if (mask == Corner.All()) {
                    c.FillRoundRect(sx, sy, sg.w, sg.h, rad, rs.backgroundColor);
                } else {
                    c.FillRoundRectIn(sx, sy, sg.w, sg.h, rad, mask,
                        rs.backgroundColor);
                }
                if (rs.borderColor != 0 && rs.borderWidth > 0) {
                    c.DrawRoundRect(sx, sy, sg.w, sg.h, rad, rs.borderColor,
                        rs.borderWidth);
                }
            } else if (rs.borderColor != 0 && rs.borderWidth > 0
                       && sg.text.Length == 0 && sg.w > 0) {
                // hr 线块：height 0、只有边框——画一条 borderWidth 粗
                // 的横线（zrender 0 高盒的边框）。
                int bw = rs.borderWidth > 0 ? rs.borderWidth : 1;
                c.FillRect(sx, sy + (sg.h - bw) / 2, sg.w, bw, rs.borderColor);
            }
        }
        for (int i = 0; i < b.segs.Count; i = i + 1) {
            RichSeg sg = b.segs[i];
            ChartRichStyle rs = sg.st;
            if (sg.text.Length == 0) { continue; }
            int padL2 = rs != null && rs.padL >= 0 ? app.Scale(rs.padL) : 0;
            int padR2 = rs != null && rs.padR >= 0 ? app.Scale(rs.padR) : 0;
            int col = rs != null && rs.color != 0 ? rs.color : defCol;
            int fh = Canvas.FontHeight(sg.fsPx);
            int tx = ox + sg.x + padL2;
            if (rs != null && rs.align == 1) {
                tx = ox + sg.x + (sg.w - sg.tw) / 2;
            } else if (rs != null && rs.align == 2) {
                tx = ox + sg.x + sg.w - padR2 - sg.tw;
            }
            int ty = oy + sg.y + (sg.h - fh) / 2;
            // A14：段级 textShadow 先垫（zrender 影子在最下）、
            // textBorder 描边次之、填充字最后（paint-order:stroke）。
            if (rs != null && rs.tsColor != 0) {
                int sdx = rs.tsDx;
                int sdy = rs.tsDy;
                if (rs.tsBlur > 0 && sdx == 0 && sdy == 0) {
                    c.DrawText(tx - 1, ty, sg.text, rs.tsColor, sg.fsPx);
                    c.DrawText(tx + 1, ty, sg.text, rs.tsColor, sg.fsPx);
                    c.DrawText(tx, ty - 1, sg.text, rs.tsColor, sg.fsPx);
                    c.DrawText(tx, ty + 1, sg.text, rs.tsColor, sg.fsPx);
                } else {
                    c.DrawText(tx + sdx, ty + sdy, sg.text, rs.tsColor, sg.fsPx);
                }
            }
            bool bold = rs != null && (rs.fontWeight == "bold"
                || rs.fontWeight == "bolder" || rs.fontWeight == "600"
                || rs.fontWeight == "700" || rs.fontWeight == "800");
            if (rs != null && rs.tbColor != 0 && rs.tbWidth > 0) {
                int r = rs.tbWidth;
                if (r >= 2) {
                    c.DrawText(tx - r, ty - r, sg.text, rs.tbColor, sg.fsPx);
                    c.DrawText(tx + r, ty - r, sg.text, rs.tbColor, sg.fsPx);
                    c.DrawText(tx - r, ty + r, sg.text, rs.tbColor, sg.fsPx);
                    c.DrawText(tx + r, ty + r, sg.text, rs.tbColor, sg.fsPx);
                }
                c.DrawText(tx - r, ty, sg.text, rs.tbColor, sg.fsPx);
                c.DrawText(tx + r, ty, sg.text, rs.tbColor, sg.fsPx);
                c.DrawText(tx, ty - r, sg.text, rs.tbColor, sg.fsPx);
                c.DrawText(tx, ty + r, sg.text, rs.tbColor, sg.fsPx);
            }
            if (bold) {
                c.DrawTextBold(tx, ty, sg.text, col, sg.fsPx);
            } else {
                c.DrawText(tx, ty, sg.text, col, sg.fsPx);
            }
        }
    }

    // 内置系列类型直通光栅化分发（解耦空壳中转，提高帧率吞吐）
    public static bool DispatchBuiltin(App app, int x, int y, int w, int h,
                                       ChartOption option, int g, string kind) {
        if (kind == "pie" || kind == "rose") {
            ChartView.DrawPie(app, x, y, w, h, option, option.pieLabels, g);
            return true;
        }
        if (kind == "bar" || kind == "hbar" || kind == "barStacked" || kind == "barStackedHbar") {
            bool stacked = kind == "barStacked" || kind == "barStackedHbar";
            bool hbar = kind == "hbar" || kind == "barStackedHbar";
            ChartView.DrawBars(app, x, y, w, h, option, g, stacked, hbar);
            return true;
        }
        if (kind == "stackedArea") {
            ChartView.DrawStackedArea(app, x, y, w, h, option, g);
            return true;
        }
        if (kind == "lines") {
            ChartView.DrawLines(app, x, y, w, h, option, g);
            return true;
        }
        if (kind == "scatter") {
            ChartView.DrawScatter(app, x, y, w, h, option, g);
            return true;
        }
        if (kind == "bubbles") {
            ChartView.DrawBubbles(app, x, y, w, h, option, g);
            return true;
        }
        if (kind == "calendar") {
            ChartView.DrawCalendar(app, x, y, w, h, option, g);
            return true;
        }
        if (kind == "matrix") {
            ChartView.DrawMatrix(app, x, y, w, h, option, g);
            if (!option.overlay) {
                ChartView.MatrixHover(app, x, y, w, h, option);
            }
            return true;
        }
        if (kind == "polarCoord") {
            ChartView.DrawPolarCoord(app, x, y, w, h, option, g);
            return true;
        }
        if (kind == "gauge") {
            ChartView.DrawGauge(app, x, y, w, h, option, g);
            return true;
        }
        if (kind == "radar") {
            ChartView.DrawPolar(app, x, y, w, h, option, g);
            return true;
        }
        if (kind == "heatmap") {
            ChartView.DrawHeatmap(app, x, y, w, h, option, g);
            return true;
        }
        if (kind == "wordCloud") {
            ChartView.DrawWordCloud(app, x, y, w, h, option, g);
            return true;
        }
        if (kind == "funnel") {
            ChartSeries leadS = ChartView.LeadSeries(option);
            bool pyramid = false;
            if (leadS != null && leadS.sort == "ascending") { pyramid = true; }
            ChartView.DrawFunnel(app, x, y, w, h, option, g, pyramid);
            return true;
        }
        if (kind == "treemap") {
            ChartView.DrawTreemap(app, x, y, w, h, option, g);
            return true;
        }
        if (kind == "tree") {
            ChartView.DrawTree(app, x, y, w, h, option, g);
            return true;
        }
        if (kind == "sankey") {
            ChartView.DrawSankey(app, x, y, w, h, option, g);
            return true;
        }
        if (kind == "sunburst") {
            ChartView.DrawSunburst(app, x, y, w, h, option, g);
            return true;
        }
        if (kind == "k") {
            ChartView.DrawCandles(app, x, y, w, h, option, g);
            return true;
        }
        if (kind == "box") {
            ChartView.DrawBox(app, x, y, w, h, option, g);
            return true;
        }
        if (kind == "error") {
            ChartView.DrawError(app, x, y, w, h, option, g);
            return true;
        }
        if (kind == "waterfall") {
            ChartView.DrawWaterfall(app, x, y, w, h, option, g);
            return true;
        }
        if (kind == "chord") {
            ChartView.DrawChord(app, x, y, w, h, option, g);
            return true;
        }
        if (kind == "force") {
            ChartView.DrawForce(app, x, y, w, h, option, g);
            return true;
        }
        if (kind == "venn") {
            ChartView.DrawVenn(app, x, y, w, h, option, g);
            return true;
        }
        if (kind == "map") {
            ChartView.DrawMap(app, x, y, w, h, option, g);
            return true;
        }
        if (kind == "eventRiver") {
            ChartView.DrawEventRiver(app, x, y, w, h, option, g);
            return true;
        }
        if (kind == "radialBars") {
            ChartView.DrawRadialBars(app, x, y, w, h, option, g);
            return true;
        }
        if (kind == "pictorialBar") {
            ChartView.DrawPictorialBar(app, x, y, w, h, option, g);
            return true;
        }
        if (kind == "parallel") {
            ChartView.DrawParallel(app, x, y, w, h, option, g);
            return true;
        }
        if (kind == "themeRiver") {
            ChartView.DrawThemeRiver(app, x, y, w, h, option, g);
            return true;
        }
        if (kind == "linesCustom") {
            ChartView.DrawLinesCustom(app, x, y, w, h, option, g);
            return true;
        }
        if (kind == "graphic") {
            ChartView.DrawGraphic(app, x, y, w, h, option, g);
            return true;
        }
        return false;
    }
}
