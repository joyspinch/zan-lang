using Gui;
using System;

namespace Gui.Component.Chart;

internal class ChartTreeGeometry {
    internal ChartSeries lead;
    internal ChartNode root;
    internal int plotTop;
    internal int pad;
    internal int ax;
    internal int ay;
    internal int aw;
    internal int ah;
    internal int hintFs;
    internal int hintH;
    internal bool horiz;
    internal int effDepth;
    internal int leaves;
    internal int depth;
    internal int fs;
    internal int fh;
    internal int labelW;
    internal int rad;
    internal int gapSpan;
    internal int gapDep;
    internal int natSpan;
    internal int natDep;
    internal int natW;
    internal int natH;
    internal int zoom;
    internal int panX;
    internal int panY;
    internal int contentSpan;
    internal int contentDep;
    internal int contentW;
    internal int contentH;
    internal int span0;
    internal int dep0;
    internal int spanG;
    internal int depG;
    internal List<TreeLayoutNode> layout = new List<TreeLayoutNode>();

    internal static ChartTreeGeometry Create(App app, ChartOption o, int x, int y, int w, int h) {
        ChartTreeGeometry geometry = new ChartTreeGeometry();
        geometry.Build(app, o, x, y, w, h);
        return geometry;
    }

    void Build(App app, ChartOption o, int x, int y, int w, int h) {
        lead = ChartView.LeadSeries(o);
        if (lead == null || lead.tree == null || lead.tree.Count < 1) { return; }
        root = lead.tree[0];
        if (root == null) { return; }
        plotTop = Chart.HeadBandBottom(app, y, o.title);
        pad = app.theme.paddingMedium;
        ax = x + pad;
        ay = plotTop;
        aw = w - pad * 2;
        ah = (y + h - pad) - plotTop;
        hintFs = ChartFonts.SeriesLabel(app);
        hintH = Canvas.FontHeight(hintFs) + app.Scale(6);
        if (ah > hintH + app.Scale(24)) { ah = ah - hintH; }
        if (aw < app.Scale(10) || ah < app.Scale(10)) { return; }

        horiz = false;
        if (lead.treeOrient == "horizontal") { horiz = true; }

        // N6：官方缺省展开到第 2 层（initialTreeDepth 缺省 2），
        // collapsed 逐项反义；可见叶数/深度决定 span 网格与缩放。
        effDepth = ChartView.TreeExpandDepth(o, ChartView.TreeDepth(root));
        leaves = ChartView.TreeVisLeafCount(root, effDepth, 0);
        depth = ChartView.TreeVisDepth(root, effDepth, 0);
        if (leaves < 1) { leaves = 1; }
        if (depth < 1) { depth = 1; }

        // 字号保持可读：缩放改节点间距，标签跟节点走、越出视口裁掉。
        fs = ChartFonts.SeriesLabel(app);
        fh = Canvas.FontHeight(fs);
        labelW = ChartView.TreeLabelWidth(root, fs);
        rad = app.Scale(4);
        gapSpan = 0;
        gapDep = 0;
        if (horiz) {
            gapSpan = fh + app.Scale(14);
            if (gapSpan < app.Scale(22)) { gapSpan = app.Scale(22); }
            gapDep = labelW + rad * 2 + app.Scale(28);
            if (gapDep < app.Scale(40)) { gapDep = app.Scale(40); }
        } else {
            gapSpan = labelW + app.Scale(16);
            if (gapSpan < app.Scale(36)) { gapSpan = app.Scale(36); }
            gapDep = rad * 2 + fh + app.Scale(22);
            if (gapDep < app.Scale(32)) { gapDep = app.Scale(32); }
        }

        natSpan = leaves * gapSpan;
        natDep = depth * gapDep + app.Scale(8);
        natW = horiz ? (natDep + labelW + rad) : natSpan;
        natH = horiz ? natSpan : (natDep + fh + rad);

        zoom = app.StateGet(Chart.TreeZoomKey(o.iwid), 0);
        panX = app.StateGet(Chart.TreePanXKey(o.iwid), 0);
        panY = app.StateGet(Chart.TreePanYKey(o.iwid), 0);
        if (zoom == 0) {
            zoom = 100;
            if (natW > aw && natW > 0) { zoom = aw * 90 / natW; }
            int zH = 100;
            if (natH > ah && natH > 0) { zH = ah * 90 / natH; }
            if (zH < zoom) { zoom = zH; }
            if (zoom < 20) { zoom = 20; }
            if (zoom > 100) { zoom = 100; }
            panX = natW * zoom / 200 - aw / 2;
            panY = natH * zoom / 200 - ah / 2;
            app.StateSet(Chart.TreeZoomKey(o.iwid), zoom);
            app.StateSet(Chart.TreePanXKey(o.iwid), panX);
            app.StateSet(Chart.TreePanYKey(o.iwid), panY);
        }
        gapSpan = gapSpan * zoom / 100;
        gapDep = gapDep * zoom / 100;
        if (gapSpan < 2) { gapSpan = 2; }
        if (gapDep < 2) { gapDep = 2; }

        contentSpan = leaves * gapSpan;
        contentDep = depth * gapDep + app.Scale(8);
        if (contentSpan < 2) { contentSpan = 2; }
        if (contentDep < 2) { contentDep = 2; }
        contentW = horiz ? (contentDep + labelW + rad) : contentSpan;
        contentH = horiz ? contentSpan : (contentDep + fh + rad);

        panX = ChartView.ClampPan(panX, contentW, aw);
        panY = ChartView.ClampPan(panY, contentH, ah);
        app.StateSet(Chart.TreePanXKey(o.iwid), panX);
        app.StateSet(Chart.TreePanYKey(o.iwid), panY);

        span0 = (horiz ? ay - panY : ax - panX);
        dep0 = (horiz ? ax - panX : ay - panY) + app.Scale(8) * zoom / 100;
        spanG = contentSpan;
        depG = contentDep;

        ChartView.TreeAssignEx(root, 0, 0, effDepth, layout);
    }

    internal ChartHit Hit(App app, ChartOption o, int mx, int my) {
        if (lead == null || lead.silent || layout.Count == 0) { return null; }
        if (mx >= ax && mx < ax + aw
        && my >= ay && my < ay + ah
        && app.StateGet(Chart.TreeDraggingKey(o.iwid), 0) == 0) {
            int best = 0 - 1;
            int bestD2 = 0;
            bool bestDot = false;
            int hitRad = ChartView.TreeHitRadius(rad, zoom, app.Scale(1));
            for (int k = 0; k < layout.Count; k = k + 1) {
                TreeLayoutNode item = layout[k];
                int span = ChartView.TreeSpan(item, spanG, leaves);
                int d = item.depth * gapDep;
                int nx = horiz ? dep0 + d : span0 + span;
                int ny = horiz ? span0 + span : dep0 + d;
                if (nx + hitRad < ax || nx - hitRad >= ax + aw
                || ny + hitRad + fh < ay || ny - hitRad >= ay + ah) {
                    continue;
                }
                string lbl = ChartView.TreeNodeName(item.node);
                int lw = Canvas.MeasureText(lbl, fs);
                int lx = horiz ? nx + rad + app.Scale(6) : nx - lw / 2;
                int ly = horiz ? Canvas.CenterTextYAt(ny, fs) : ny + rad + app.Scale(4);
                int dx = mx - nx;
                int dy = my - ny;
                int d2 = dx * dx + dy * dy;
                bool onDot = dx >= 0 - hitRad && dx <= hitRad
                && dy >= 0 - hitRad && dy <= hitRad
                && d2 <= hitRad * hitRad;
                bool onLbl = mx >= lx && mx < lx + lw && my >= ly && my < ly + fh;
                bool candidate = onDot || onLbl;
                if (!candidate) { continue; }
                // 节点圆点优先于标签；同一优先级取离指针最近者，
                // 避免低 zoom 时 preorder 的前节点吞掉后节点。
                bool replace = best < 0;
                if (!replace && onDot && !bestDot) { replace = true; }
                if (!replace && onDot == bestDot && d2 < bestD2) { replace = true; }
                if (replace) {
                    best = k;
                    bestD2 = d2;
                    bestDot = onDot;
                }
            }
            if (best >= 0) {
                ChartNode hn = layout[best].node;
                int nodeSeries = ChartView.SeriesIndexOf(o, lead);
                // ECharts 节点显式 value（GroupVal）优先于子树累计。
                int hitVal = hn.Total();
                if (hn.val > 0) { hitVal = hn.val; }
                ChartHit th = ChartHit.Of(ChartElementType.Node,
                nodeSeries, lead != null ? lead.name : "", best,
                ChartView.TreeNodeName(hn), hitVal, mx, my);
                if (lead != null) { th.axisIndex = lead.axisIndex; }
                return th;
            }
        }
        return null;
    }
}

internal class ChartTreemapGeometry {
    internal ChartSeries series;
    internal int x; internal int y; internal int w; internal int h; internal int background;
    internal List<TmRect> rects = new List<TmRect>();
    internal static ChartTreemapGeometry Create(App app, ChartOption o, int x, int y, int w, int h, int growth) {
        ChartTreemapGeometry geometry = new ChartTreemapGeometry();
        geometry.series = ChartView.LeadSeries(o);
        ChartSeries series = geometry.series;
        if (series == null || series.tree.Count == 0) { return geometry; }
        int top = Chart.HeadBandBottom(app, y, o.title); int pad = app.theme.paddingMedium;
        int width = w - pad * 2; int height = y + h - pad - top;
        geometry.x = x + pad + (width - width * growth / 1000) / 2;
        geometry.y = top + (height - height * growth / 1000) / 2;
        geometry.w = width * growth / 1000; geometry.h = height * growth / 1000;
        geometry.background = ChartView.TmStyleOf(app, series, 0).borderColor;
        if (geometry.w < app.Scale(4) || geometry.h < app.Scale(4)) { return geometry; }
        Dict<string, int> ids = new Dict<string, int>(); ChartView.TmBuildIdMap(series.tree, ids, 0);
        ChartView.TmLayout(app, series, null, series.tree, 0, geometry.x, geometry.y, geometry.w, geometry.h,
        0, -1, geometry.rects, ids);
        return geometry;
    }
    internal TmRect HitRect(int px, int py) {
        if (!ChartView.TreemapContains(px, py, x, y, w, h, 0)) { return null; }
        for (int i = rects.Count - 1; i >= 0; i = i - 1) {
            TmRect item = rects[i];
            if (item.node != null && ChartView.TreemapContains(px, py, item.x, item.y, item.w, item.h, 0)) { return item; }
        }
        return null;
    }
    internal ChartHit Hit(ChartOption o, int px, int py) {
        if (series == null || series.silent) { return null; }
        TmRect item = this.HitRect(px, py); if (item == null) { return null; }
        ChartHit hit = ChartHit.Of(ChartElementType.Node, ChartView.SeriesIndexOf(o, series), series.name,
        ChartView.TmNodeIndex(series.tree, item.node), ChartView.TreeNodeName(item.node), ChartView.TreemapValue(item.node), px, py);
        hit.axisIndex = series.axisIndex; return hit;
    }
}

internal class ChartForceGeometry {
    internal int pad;
    internal int top;
    internal ChartSeries lead;
    internal int legendW;
    internal int areaW;
    internal int areaH;
    internal int r;
    internal int ox;
    internal int oy;
    internal List<string> nodeNames;
    internal ForceLayout layout;
    internal int tweenN;
    internal List<int> twX;
    internal List<int> twY;
    internal int nn;
    internal List<int> px;
    internal List<int> py;
    internal List<bool> nodeHid;
    internal int maxVal;
    internal int linkCol0;
    internal int nodeCol0;

    internal static ChartForceGeometry Create(App app, ChartOption o, int x, int y, int w, int h, int g) {
        ChartForceGeometry geometry = new ChartForceGeometry();
        geometry.Build(app, o, x, y, w, h, g);
        return geometry;
    }
    void Build(App app, ChartOption o, int x, int y, int w, int h, int g) {
        Theme t = app.theme;
        pad = t.paddingMedium;
        top = Chart.HeadBandBottom(app, y, o.title);
        lead = ChartView.LeadSeries(o);
        // graph 系列可以只有孤立节点（无任何 link）：节点照画。
        if (lead == null
        || (lead.links.Count < 1 && lead.data.Count < 1)) {
            return;
        }

        legendW = 0;
        if (o.showLegend && lead.data.Count <= 16) { legendW = app.Scale(120); }
        areaW = w - pad * 2 - legendW;
        areaH = (y + h - pad) - top;
        r = areaW * 2 / 5;
        if (areaH * 2 / 5 < r) { r = areaH * 2 / 5; }
        if (r < app.Scale(10)) { r = app.Scale(10); }
        // 布局在局部坐标里模拟（原点 = 绘图区左上角）；绘制与
        // 命中时统一平移回屏幕，形状不随卡片滚动位置变化。
        ox = x + pad;
        oy = top;

        // 布局分支（ECharts graph.layout）：circular 落圆周、
        // none 用节点数据坐标（缺坐标的节点回落圆周）、其余
        // （force / 缺省 / ECharts type:'force'）走弹簧模拟。
        nodeNames = new List<string>();
        for (int i = 0; i < lead.data.Count; i = i + 1) {
            nodeNames.Add(lead.data[i].name);
        }
        bool fixedOk = lead.graphLayout == "none"
        && lead.nodeCoords != null
        && lead.nodeCoords.Count == lead.data.Count
        && lead.data.Count > 0;
        if (fixedOk) {
            for (int i = 0; i < lead.nodeCoords.Count; i = i + 1) {
                ChartNodeCoord pt = lead.nodeCoords[i];
                if (pt == null || pt.x < 0 || pt.y < 0) { fixedOk = false; break; }
            }
        }
        if (lead.graphLayout == "circular" || lead.links.Count < 1) {
            layout = ForceLayout.CircularOf(lead.links, nodeNames,
            areaW, areaH);
        } else if (fixedOk) {
            layout = ForceLayout.FixedOfCoords(lead.links, nodeNames,
            lead.nodeCoords, areaW, areaH);
        } else {
            layout = ChartView.CachedForceLayoutK(lead.links,
            r, areaW, areaH, lead.forceScaling, lead.forceGravity,
            lead.forceRepulsion, lead.forceEdgeLength);
        }
        // 入场补间：g<1000 时节点位 = 圆周初值 → 终态的线性插值
        // （ECharts force 的节点收敛入场；同一 ForceLayout 缓存对
        // 只读插值，幂等安全）。g>=1000 或无初值快照时直接终态。
        tweenN = 0;
        twX = null;
        twY = null;
        if (g < 1000 && layout.startCoords != null && layout.startCoords.Count == layout.nodes.Count) {
            twX = new List<int>();
            twY = new List<int>();
            for (int ti = 0; ti < layout.nodes.Count; ti = ti + 1) {
                int sx = layout.startCoords[ti].x;
                int sy = layout.startCoords[ti].y;
                twX.Add(sx + (layout.nodes[ti].x - sx) * g / 1000);
                twY.Add(sy + (layout.nodes[ti].y - sy) * g / 1000);
            }
            tweenN = twX.Count;
        }
        // 逐节点形状 + minRadius/maxRadius 权重插值（不改几何，仅
        // symbol/size 元数据，幂等重放，对共享缓存安全）。
        ForceLayout.ApplyShapes(layout, lead.tree,
        app.Scale(lead.forceMinRadius), app.Scale(lead.forceMaxRadius));
        // ECharts force 的节点即 series.data 项：按名匹配逐节点
        // symbol/symbolSize 覆盖（同样只改元数据，幂等）。
        // symbolSize 直径语义（db5a53bf）：graph JSON（graphLayout
        // 非空）直接存直径；旧 force 路径沿用「半径 ×2」约定。
        for (int di = 0; di < lead.data.Count; di = di + 1) {
            ChartData dd = lead.data[di];
            if (dd.name.Length < 1) { continue; }
            if (dd.symbol.Length < 1 && !dd.sizeSet) { continue; }
            for (int i = 0; i < layout.nodes.Count; i = i + 1) {
                if (layout.nodes[i].name != dd.name) { continue; }
                if (dd.symbol.Length > 0) { layout.nodes[i].symbol = dd.symbol; }
                // ForceNode.size 存直径，绘制端取 /2。
                if (dd.sizeSet && dd.size > 0) {
                    if (lead.graphLayout.Length > 0) { layout.nodes[i].size = dd.size; }
                    else { layout.nodes[i].size = dd.size * 2; }
                }
                break;
            }
        }
        nn = layout.nodes.Count;
        if (nn < 1) { return; }
        // 节点屏幕坐标统一出口：补间期 = 圆周初值→终态的线性插值，
        // 否则终态。（Zan 局部函数不能捕获外层局部量，这里预先
        // 物化成列表，下面命中/边/节点/标签统一读 px/py。）Zero-Alloc 池化复用。
        px = new List<int>();
        py = new List<int>();
        for (int i = 0; i < nn; i = i + 1) {
            if (tweenN > 0) {
                px.Add(ox + twX[i]);
                py.Add(oy + twY[i]);
            } else {
                px.Add(ox + layout.nodes[i].x);
                py.Add(oy + layout.nodes[i].y);
            }
        }
        nodeHid = new List<bool>();
        for (int ni = 0; ni < nn; ni = ni + 1) {
            bool h = false;
            if (o.iwid != 0) {
                // graph 类别节点：图例键按类别下标（点类别 chip 隐整类，
                // 与官方 legend.data=categories 一致）；其余按节点下标。
                int lk = ni;
                if (ni < lead.data.Count && lead.data[ni].hasCat) {
                    lk = lead.data[ni].cat;
                }
                h = app.StateGet(Chart.LegendSliceKey(o.iwid, 0, lk), 0) == 1;
            }
            nodeHid.Add(h);
        }

        maxVal = 1;
        for (int i = 0; i < layout.edges.Count; i = i + 1) {
            if (layout.edges[i].val > maxVal) { maxVal = layout.edges[i].val; }
        }
        // linkStyle/nodeStyle 显式色（0 = 逐节点调色板，现状）。
        linkCol0 = lead.forceLinkColor;
        nodeCol0 = lead.forceNodeColor;
    }
    internal ChartHit Hit(App app, ChartOption o, int mx, int my, int g) {
        if (lead == null || lead.silent) { return null; }
        // 悬停节点（若有）：相邻边高亮。命中半径与实际节点
        // symbol 半径一致，并保留少量边缘容差；不依赖 tooltip 开关。
        // 系列级 symbolSize（graph-simple 的 50）= 默认节点直径。
        int nodeR = app.Scale(5);
        if (lead.symbolSize > 0) { nodeR = app.Scale(lead.symbolSize) / 2; }
        int hoverNode = 0 - 1;
        int best = 0 - 1;
        int bestD = 0;
        bool insideForce = mx >= ox && mx < ox + areaW
        && my >= oy && my < oy + areaH;
        for (int i = 0; i < nn; i = i + 1) {
            if (i < nodeHid.Count && nodeHid[i]) { continue; }
            ForceNode nd = layout.nodes[i];
            int nrHit = nodeR;
            if (nd.size > 0) { nrHit = app.Scale(nd.size) / 2; }
            int hitR = nrHit + app.Scale(2);
            int ddx = mx - px[i];
            int ddy = my - py[i];
            int d2 = ddx * ddx + ddy * ddy;
            if (d2 <= hitR * hitR) {
                if (best < 0 || d2 < bestD) { best = i; bestD = d2; }
            }
        }
        if (!insideForce) { best = 0 - 1; }
        hoverNode = best;
        if (hoverNode >= 0) {
            ForceNode ndHit = layout.nodes[hoverNode];
            int hitValue = ndHit.weight;
            ChartHit fh = ChartHit.Of(ChartElementType.Node, 0, lead.name,
            hoverNode, ndHit.name, hitValue, px[hoverNode], py[hoverNode]);
            return fh;
        }

        return null;
    }
}

internal class ChartChordGeometry {
    internal int pad;
    internal int top;
    internal ChartSeries lead;
    internal ChordLayout layout;
    internal List<ChartLink> links;
    internal int nn;
    internal int nr;
    internal List<bool> nodeHid;
    internal int hoverNode;
    internal int dataNode;
    internal int dataRibbon;
    internal int bodyY;
    internal int areaW;
    internal int areaH;
    internal int r;
    internal int cx;
    internal int cy;
    internal int boxX;
    internal int boxY;
    internal int boxW;
    internal int boxH;
    internal int maxVal;
    internal int ribbonR;
    internal bool thin;
    internal int ringW;
    internal int rInner0;
    internal List<ChartLegendEntry> legends = new List<ChartLegendEntry>();

    internal static ChartChordGeometry Create(App app, ChartOption o, int x, int y, int w, int h, int g) {
        ChartChordGeometry geometry = new ChartChordGeometry();
        geometry.Build(app, o, x, y, w, h, g);
        return geometry;
    }
    void Build(App app, ChartOption o, int x, int y, int w, int h, int g) {
        Theme t = app.theme;
        pad = t.paddingMedium;
        top = Chart.HeadBandBottom(app, y, o.title);
        lead = ChartView.LeadSeries(o);
        if (lead == null) { return; }
        // ECharts chord.matrix：行序展开为 links（对角 = 自环），
        // 节点名 = data[i].name（缺名回退 node-i）；links 非空时优先。
        links = lead.links;
        if (links.Count < 1 && lead.matrix.Count > 0) {
            links = new List<ChartLink>();
            for (int i = 0; i < lead.matrix.Count; i = i + 1) {
                string from = "";
                if (i < lead.data.Count) { from = lead.data[i].name; }
                if (from.Length < 1) { from = "node-" + Convert.ToString(i); }
                List<int> row = lead.matrix[i];
                for (int j = 0; j < row.Count; j = j + 1) {
                    if (row[j] <= 0) { continue; }
                    string to = "";
                    if (j < lead.data.Count) { to = lead.data[j].name; }
                    if (to.Length < 1) { to = "node-" + Convert.ToString(j); }
                    links.Add(ChartLink.Of(from, to, row[j]));
                }
            }
        }
        if (links.Count < 1) { return; }

        layout = ChordLayout.Of(links, lead.chordSort,
        lead.chordSortSub, lead.chordGapDeg);
        nn = layout.nodes.Count;
        if (nn < 1) { return; }
        nr = layout.ribbons.Count;
        nodeHid = new List<bool>();
        for (int ni = 0; ni < nn; ni = ni + 1) {
            bool h = false;
            if (o.iwid != 0) {
                h = app.StateGet(Chart.LegendSliceKey(o.iwid, 0, ni), 0) == 1;
            }
            nodeHid.Add(h);
        }

        hoverNode = 0 - 1;
        dataNode = 0 - 1;
        dataRibbon = 0 - 1;
        bodyY = top;
        if (o.showLegend) {
            int x0 = x + pad;
            int xCur = x0;
            int yCur = top;
            int maxX = x + w - pad;
            int rowH = Canvas.FontHeight(ChartFonts.Legend(app)) + app.Scale(6);
            for (int i = 0; i < nn; i = i + 1) {
                ChordNodeArc naL = layout.nodes[i];
                int cw = Chart.LegendChipW(app, naL.name);
                if (xCur > x0 && xCur + cw > maxX) {
                    xCur = x0;
                    yCur = yCur + rowH;
                }
                if (ChartView.PointerX(app) >= xCur && ChartView.PointerX(app) < xCur + cw
                && ChartView.PointerY(app) >= yCur && ChartView.PointerY(app) < yCur + rowH) {
                    hoverNode = i;
                }
                int key = 0;
                if (o.iwid != 0) { key = Chart.LegendSliceKey(o.iwid, 0, i); }
                bool hid = false;
                if (i < nodeHid.Count) { hid = nodeHid[i]; }
                legends.Add(ChartLegendEntry.Of(3, key, xCur, yCur, cw, rowH, naL.name));
                xCur = xCur + cw + app.Scale(8);
                bodyY = yCur + rowH + app.Scale(4);
            }
        }

        areaW = w - pad * 2;
        areaH = (y + h - pad) - bodyY;
        r = ChartView.RadialRadius(areaW, areaH, 56);
        if (r < app.Scale(20)) { r = app.Scale(20); }
        cx = x + pad + areaW / 2;
        cy = bodyY + areaH / 2;
        boxX = x + pad;
        boxY = bodyY;
        boxW = areaW;
        boxH = areaH;

        maxVal = 1;
        for (int i = 0; i < nr; i = i + 1) {
            if (layout.ribbons[i].val > maxVal) { maxVal = layout.ribbons[i].val; }
        }
        ribbonR = r * 88 / 100;
        thin = lead.chordRibbonType == "path" || lead.innerPct > 0;
        // chordStyle：外环宽（占半径 %，默认 22 = 现状 78/100）。
        ringW = lead.chordRingWidthPct > 0 ? lead.chordRingWidthPct : 22;
        rInner0 = r * (100 - ringW) / 100;
    }
    internal ChartHit Hit(App app, ChartOption o, int mxH, int myH, int g) {
        if (lead == null || lead.silent) { return null; }
        int dataNode = -1; int dataRibbon = -1; int hoverNode = -1;
        int hoverRibbon = 0 - 1;
        int sweepMax = 360 * g / 1000;
        bool insideChord = mxH >= boxX && mxH < boxX + boxW
        && myH >= boxY && myH < boxY + boxH;
        int distH = ChartView.ISqrt((mxH - cx) * (mxH - cx) + (myH - cy) * (myH - cy));
        if (insideChord && distH >= rInner0 && distH <= r + app.Scale(4)) {
            int angH = ChartView.AngleOf(mxH - cx, myH - cy);
            for (int hi = 0; hi < nn; hi = hi + 1) {
                if (hi < nodeHid.Count && nodeHid[hi]) { continue; }
                ChordNodeArc ha = layout.nodes[hi];
                int endH = ha.a1;
                if (endH > ha.a0 + sweepMax) { endH = ha.a0 + sweepMax; }
                if (endH > ha.a0 && ChartView.InSweep(angH, ha.a0, endH)) {
                    hoverNode = hi;
                    dataNode = hi;
                }
            }
        }
        if (dataNode < 0 && insideChord) {
            for (int ri = 0; ri < nr; ri = ri + 1) {
                ChordRibbon rbh = layout.ribbons[ri];
                if (rbh.from < nodeHid.Count && nodeHid[rbh.from]) { continue; }
                if (rbh.to < nodeHid.Count && nodeHid[rbh.to]) { continue; }
                int x1h = ChartView.FillX(cx, ribbonR, rbh.srcAngle);
                int y1h = ChartView.FillY(cy, ribbonR, rbh.srcAngle);
                int x2h = ChartView.FillX(cx, ribbonR, rbh.dstAngle);
                int y2h = ChartView.FillY(cy, ribbonR, rbh.dstAngle);
                int segsH = 12;
                int pxh = x1h;
                int pyh = y1h;
                for (int sih = 1; sih <= segsH; sih = sih + 1) {
                    int tq = sih * 100 / segsH;
                    int it = 100 - tq;
                    int bx = (it * it * x1h + 2 * it * tq * cx + tq * tq * x2h) / 10000;
                    int by = (it * it * y1h + 2 * it * tq * cy + tq * tq * y2h) / 10000;
                    int thH = app.Scale(2) + app.Scale(6) * rbh.val / maxVal;
                    int hitRH = app.Scale(4) + thH / 2;
                    if (ChartView.DistToSeg(mxH, myH, pxh, pyh, bx, by) <= hitRH) {
                        hoverRibbon = ri;
                        dataRibbon = ri;
                    }
                    pxh = bx;
                    pyh = by;
                }
            }
        }

        if (dataNode >= 0) {
            ChordNodeArc nh = layout.nodes[dataNode];
            ChartHit ch = ChartHit.Of(ChartElementType.Node, 0, lead.name,
            dataNode, nh.name, nh.weight, mxH, myH);
            return ch;
        } else if (dataRibbon >= 0) {
            ChordRibbon rh = layout.ribbons[dataRibbon];
            string rn = layout.nodes[rh.from].name + " -> "
            + layout.nodes[rh.to].name;
            ChartHit ch2 = ChartHit.Of(ChartElementType.Link, 0, lead.name,
            dataRibbon, rn, rh.val, mxH, myH);
            return ch2;
        }

        return null;
    }
}

internal class ChartSankeyGeometry {
    internal List<ChartSeries> series;
    internal List<ChartLink> links;
    internal int top;
    internal int pad;
    internal List<SankeyNodeLayout> nodes;
    internal int li;
    internal int relaxRounds;
    internal int maxLayer;
    internal int nLayers;
    internal int nn;
    internal int colW;
    internal int nodeW;
    internal int areaH;
    internal int colH;
    internal int ni;
    int x; int w; internal int maxFlow; internal int maxTh;
    internal static ChartSankeyGeometry Create(App app, ChartOption o, int x, int y, int w, int h, int g) {
        ChartSankeyGeometry geometry = new ChartSankeyGeometry(); geometry.Build(app, o, x, y, w, h); return geometry;
    }
    void Build(App app, ChartOption o, int x, int y, int w, int h) {
        Theme t = app.theme; this.x = x; this.w = w;
        series = o.series;
        if (series.Count < 1 || series[0].links.Count < 1) { return; }
        links = series[0].links;
        top = Chart.HeadBandBottom(app, y, o.title);
        pad = t.paddingMedium;

        // 按首次出现顺序的节点列表。
        nodes = new List<SankeyNodeLayout>();
        li = 0;
        for (; li < links.Count; li = li + 1) {
            ChartLink lk = links[li];
            if (ChartView.SankeyIndexOf(nodes, lk.from) < 0) {
                nodes.Add(SankeyNodeLayout.Of(lk.from));
            }
            if (ChartView.SankeyIndexOf(nodes, lk.to) < 0) {
                nodes.Add(SankeyNodeLayout.Of(lk.to));
            }
        }
        // 最长路径分层：layer(to) >= layer(from) + 1。循环图会让
        // 朴素松弛永不收敛，因此最多跑（节点数-1）轮——简单
        // 路径长度的上界；剩下的回边把目标压到源节点同层，
        // 保证终止且布局稳定。
        relaxRounds = nodes.Count - 1;
        if (relaxRounds < 1) { relaxRounds = 1; }
        for (int rr = 0; rr < relaxRounds; rr = rr + 1) {
            bool changed = false;
            li = 0;
            while (li < links.Count) {
                ChartLink lk = links[li];
                int fi = ChartView.SankeyIndexOf(nodes, lk.from);
                int ti = ChartView.SankeyIndexOf(nodes, lk.to);
                if (nodes[ti].layer < nodes[fi].layer + 1) {
                    nodes[ti].layer = nodes[fi].layer + 1;
                    changed = true;
                }
                li = li + 1;
            }
            if (!changed) { break; }
        }
        // 回边固定：目标层未领先源层的边，把目标放到源同层
        // （循环边的水平退化布局），此后每条边都满足
        // layer(to) >= layer(from)，不再有反向边。
        li = 0;
        while (li < links.Count) {
            ChartLink lk = links[li];
            int fi = ChartView.SankeyIndexOf(nodes, lk.from);
            int ti = ChartView.SankeyIndexOf(nodes, lk.to);
            if (nodes[ti].layer < nodes[fi].layer) {
                nodes[ti].layer = nodes[fi].layer;
            }
            li = li + 1;
        }
        maxLayer = 0;
        for (int nk = 0; nk < nodes.Count; nk = nk + 1) {
            if (nodes[nk].layer > maxLayer) { maxLayer = nodes[nk].layer; }
        }
        if (maxLayer < 1) { maxLayer = 1; }
        nLayers = maxLayer + 1;

        // 节点流量（入/出取较大者）决定节点高度。
        nn = nodes.Count;
        li = 0;
        while (li < links.Count) {
            ChartLink lk = links[li];
            int fi = ChartView.SankeyIndexOf(nodes, lk.from);
            int ti = ChartView.SankeyIndexOf(nodes, lk.to);
            nodes[fi].flowOut = nodes[fi].flowOut + lk.val;
            nodes[ti].flowIn = nodes[ti].flowIn + lk.val;
            li = li + 1;
        }

        colW = (w - pad * 2) / nLayers;
        nodeW = colW * 3 / 8;
        if (nodeW < app.Scale(18)) { nodeW = app.Scale(18); }
        areaH = (y + h - pad) - top;
        colH = areaH * 8 / 10;

        // 每列流量合计，用于垂直堆叠。
        ChartRenderContext ctx = Chart.renderContext;
        if (ctx == null) {
            Chart.renderContext = new ChartRenderContext();
            ctx = Chart.renderContext;
        }
        ctx.EnsureScratch();
        List<int> colTotal = new List<int>();
        List<int> colCum = new List<int>();
        colTotal.Clear();
        colCum.Clear();
        for (int lc = 0; lc < nLayers; lc = lc + 1) { colTotal.Add(0); colCum.Add(0); }
        ni = 0;
        for (; ni < nn; ni = ni + 1) {
            SankeyNodeLayout node = nodes[ni];
            int fl = node.flowOut;
            if (fl < node.flowIn) { fl = node.flowIn; }
            colTotal[node.layer] = colTotal[node.layer] + fl;
        }

        ni = 0;
        while (ni < nn) {
            SankeyNodeLayout node = nodes[ni];
            int fl = node.flowOut;
            if (fl < node.flowIn) { fl = node.flowIn; }
            int th2 = colTotal[node.layer];
            if (th2 < 1) { th2 = 1; }
            node.h = colH * fl / th2;
            if (node.h < app.Scale(4)) { node.h = app.Scale(4); }
            node.x = x + pad + node.layer * colW;
            node.y = top + (areaH - colH) / 2 + colCum[node.layer];
            colCum[node.layer] = colCum[node.layer] + node.h + app.Scale(4);
            ni = ni + 1;
        }

        maxFlow = 1; maxTh = app.Scale(10);
        for (int i = 0; i < links.Count; i = i + 1) { if (links[i].val > maxFlow) { maxFlow = links[i].val; } }
    }
    internal ChartHit Hit(App app, ChartOption o, int mx, int my, int g) {
        if (nodes == null || series.Count == 0 || series[0].silent) { return null; }
        bool insideSankey = g > 0 && mx >= x + pad && mx < x + w - pad
        && my >= top && my < top + areaH;
        // 连线悬停：使用与绘制相同的实际线宽，并限制在绘图区。
        int bestL = 0 - 1;
        int bestD = 0;
        if (insideSankey) {
            li = 0;
            while (li < links.Count) {
                ChartLink lk = links[li];
                int fi = ChartView.SankeyIndexOf(nodes, lk.from);
                int ti = ChartView.SankeyIndexOf(nodes, lk.to);
                SankeyNodeLayout fromNode = nodes[fi];
                SankeyNodeLayout toNode = nodes[ti];
                int x0 = fromNode.x + nodeW;
                int y0 = fromNode.y + fromNode.h / 2;
                int x1 = toNode.x;
                int y1 = toNode.y + toNode.h / 2;
                int d = ChartView.DistToSeg(mx, my, x0, y0, x1, y1);
                int th = maxTh * lk.val / maxFlow;
                if (th < app.Scale(2)) { th = app.Scale(2); }
                int linkR = th / 2 + app.Scale(1);
                if (d <= linkR && (bestL < 0 || d < bestD)) {
                    bestL = li;
                    bestD = d;
                }
                li = li + 1;
            }
        }
        if (bestL >= 0) {
            ChartLink hk = links[bestL];
            string linkName = hk.from + " -> " + hk.to;
            return ChartHit.Of(ChartElementType.Link, 0,
                series[0].name, bestL, linkName, hk.val, mx, my);
        }
        return null;
    }
}

internal class ChartThemeRiverBand {
    internal string name;
    internal int color;
    internal List<int> values = new List<int>();
    internal List<int> top = new List<int>();
    internal List<int> bottom = new List<int>();
    internal List<int> sources = new List<int>();
    internal List<int> indices = new List<int>();
}

// ThemeRiver keeps aggregation, paths and source identities in the prepared frame.
internal class ChartThemeRiverGeometry {
    internal ChartFrame frame;
    internal List<string> times = new List<string>();
    internal List<int> xs = new List<int>();
    internal List<ChartThemeRiverBand> bands = new List<ChartThemeRiverBand>();
    internal int hoverBand = -1;
    internal int hoverTime = -1;
    internal int alpha;

    static int IndexOf(List<string> values, string value) {
        for (int i = 0; i < values.Count; i = i + 1) {
            if (values[i] == value) { return i; }
        }
        return -1;
    }

    internal static ChartThemeRiverGeometry Create(App app, ChartOption o, int x, int y, int w, int h, int growth) {
        ChartThemeRiverGeometry geometry = new ChartThemeRiverGeometry();
        geometry.Build(app, o, x, y, w, h, growth);
        return geometry;
    }

    void Build(App app, ChartOption o, int x, int y, int w, int h, int growth) {
        List<string> names = new List<string>();
        for (int si = 0; si < o.series.Count; si = si + 1) {
            ChartSeries series = o.series[si];
            if (series.custom != "themeRiver") { continue; }
            for (int pi = 0; pi < series.riverPoints.Count; pi = pi + 1) {
                string time = series.riverPoints[pi].time;
                if (ChartThemeRiverGeometry.IndexOf(times, time) < 0) { times.Add(time); }
            }
            for (int ni = 0; ni < series.riverNames.Count; ni = ni + 1) {
                string name = series.riverNames[ni];
                if (ChartThemeRiverGeometry.IndexOf(names, name) < 0) { names.Add(name); }
            }
        }
        if (times.Count < 2 || names.Count < 1) { return; }
        for (int ni = 0; ni < names.Count; ni = ni + 1) {
            ChartThemeRiverBand band = new ChartThemeRiverBand();
            band.name = names[ni]; band.color = ChartColor.Palette(app.theme, ni);
            for (int ti = 0; ti < times.Count; ti = ti + 1) {
                band.values.Add(0); band.sources.Add(-1); band.indices.Add(-1);
            }
            bands.Add(band);
        }
        for (int si = 0; si < o.series.Count; si = si + 1) {
            ChartSeries series = o.series[si];
            if (series.hidden || series.custom != "themeRiver") { continue; }
            for (int pi = 0; pi < series.riverPoints.Count; pi = pi + 1) {
                ChartRiverPoint point = series.riverPoints[pi];
                if (point.category < 0 || point.category >= series.riverNames.Count) { continue; }
                int ni = ChartThemeRiverGeometry.IndexOf(names, series.riverNames[point.category]);
                int ti = ChartThemeRiverGeometry.IndexOf(times, point.time);
                if (ni < 0 || ti < 0) { continue; }
                ChartThemeRiverBand band = bands[ni];
                band.values[ti] = band.values[ti] + point.value;
                // Aggregates expose the last interactive contributing source in draw order.
                if (!series.silent) { band.sources[ti] = si; band.indices[ti] = pi; }
            }
        }
        int top = Chart.PanelContentTop(app, x, y, w, o.title, o.series, o.showLegend);
        frame = Chart.LayoutAxesR(app, x, y, w, h, top, times, o, o.series, -1, -1, -1, -1);
        int maximum = 1;
        for (int ti = 0; ti < times.Count; ti = ti + 1) {
            int sum = 0;
            for (int ni = 0; ni < bands.Count; ni = ni + 1) { sum = sum + bands[ni].values[ti]; }
            if (sum > maximum) { maximum = sum; }
            xs.Add(frame.CatMid(ti, times.Count) * 256);
        }
        List<int> baseline = new List<int>();
        for (int ti = 0; ti < times.Count; ti = ti + 1) { baseline.Add(0); }
        for (int ni = 0; ni < bands.Count; ni = ni + 1) {
            ChartThemeRiverBand band = bands[ni];
            for (int ti = 0; ti < times.Count; ti = ti + 1) {
                int low = baseline[ti]; int high = low + band.values[ti];
                band.bottom.Add((frame.plotY + frame.plotH - (int)((long)low * frame.plotH / maximum)) * 256);
                band.top.Add((frame.plotY + frame.plotH - (int)((long)high * frame.plotH / maximum)) * 256);
                baseline[ti] = high;
            }
        }
        alpha = growth < 1000 ? 60 + 195 * growth / 1000 : 255;
        if (alpha > 255) { alpha = 255; }
    }

    internal ChartHit Hit(ChartOption o, int x, int y) {
        hoverBand = -1; hoverTime = -1;
        if (frame == null || x < frame.plotX || x >= frame.plotX + frame.plotW
        || y < frame.plotY || y >= frame.plotY + frame.plotH) { return null; }
        int ti = frame.CatIndexAt(x, times.Count);
        for (int ni = bands.Count - 1; ni >= 0; ni = ni - 1) {
            ChartThemeRiverBand band = bands[ni];
            if (band.sources[ti] < 0 || y < band.top[ti] / 256 || y > band.bottom[ti] / 256) { continue; }
            int si = band.sources[ti];
            ChartSeries series = o.series[si];
            hoverBand = ni; hoverTime = ti;
            ChartHit hit = ChartHit.Of(ChartElementType.EventBand, si, series.name, band.indices[ti],
            band.name, band.values[ti], x, y);
            hit.axisIndex = series.axisIndex;
            return hit;
        }
        return null;
    }
}

internal class ChartEventRiverGeometry {
    internal int pad;
    internal int top;
    internal ChartSeries lead;
    internal int legendW;
    internal List<string> legNames;
    internal int contentH;
    internal EventRiverLayout layout;
    internal int n;
    internal int plotW;
    internal int revealFront;

    internal static ChartEventRiverGeometry Create(App app, ChartOption o, int x, int y, int w, int h, int g) {
        ChartEventRiverGeometry geometry = new ChartEventRiverGeometry(); geometry.Build(app, o, x, y, w, h, g); return geometry;
    }
    void Build(App app, ChartOption o, int x, int y, int w, int h, int g) {
        Theme t = app.theme;
        pad = t.paddingMedium;
        top = Chart.HeadBandBottom(app, y, o.title);
        lead = ChartView.LeadSeries(o);
        if (lead == null || lead.events.Count < 1) { return; }

        // 图例（可选）：去重事件名，上限 8 条，右侧预留一栏。
        legendW = 0;
        legNames = new List<string>();
        for (int i = 0; i < lead.events.Count && legNames.Count <= 8; i = i + 1) {
            string nm = lead.events[i].name;
            bool dup = false;
            for (int k = 0; k < legNames.Count; k = k + 1) {
                if (legNames[k] == nm) { dup = true; }
            }
            if (!dup) { legNames.Add(nm); }
        }
        if (o.showLegend && legNames.Count > 0 && legNames.Count <= 8) {
            legendW = app.Scale(120);
        }

        contentH = (y + h - pad) - top;
        layout = EventRiverLayout.Of(
        lead.events, x, top, w - legendW, contentH, pad);
        n = layout.bands.Count;
        if (n < 1) { return; }

        // 从左向右按 g 揭示：只画 x <= revealFront 的部分。
        plotW = (w - legendW) - pad * 2;
        if (plotW < 4) { plotW = 4; }
        revealFront = x + pad + plotW * g / 1000;

    }
    internal ChartHit Hit(App app, ChartOption o, int mx, int my, int g) {
        if (lead == null || lead.silent || layout == null) { return null; }
        // 命中严格对应当前帧已绘出的矩形带：x 不得越过
        // revealFront，y 不再额外扩张振幅热区。
        int best = 0 - 1;
        int bestD = 0;
        for (int i = 0; i < n; i = i + 1) {
            EventBand b = layout.bands[i];
            int visibleX1 = b.x1;
            if (visibleX1 > revealFront) { visibleX1 = revealFront; }
            if (visibleX1 <= b.x0) { continue; }
            if (mx >= b.x0 && mx < visibleX1
            && my >= b.y && my < b.y + b.h) {
                int yc = b.y + b.h / 2;
                int dy = my - yc;
                if (dy < 0) { dy = 0 - dy; }
                if (best < 0 || dy < bestD) { best = i; bestD = dy; }
            }
        }
        if (best >= 0) {
            EventBand hb = layout.bands[best];
            if (true) {
                // dataIndex 用 src（稳定排序前的源 events 下标），
                // 不随排序结果漂移。
                ChartHit eh = ChartHit.Of(ChartElementType.EventBand,
                ChartView.SeriesIndexOf(o, lead), lead.name,
                hb.src, hb.name, hb.value, mx, my);
                eh.axisIndex = lead.axisIndex;
                return eh;
            }
        }
        return null;
    }
}
