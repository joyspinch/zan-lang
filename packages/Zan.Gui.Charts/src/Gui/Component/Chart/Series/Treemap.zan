                                100 + (depth - 1) * 70))));
            if (visibleEnd > a && band.rEnd > band.rStart) {
                c.FillSector(cx, cy, band.rStart, band.rEnd, a, visibleEnd, col);
                if (s.tmBorderWidth > 0) {
                    c.DrawArc(cx, cy, band.rStart, band.rEnd, a, visibleEnd,
