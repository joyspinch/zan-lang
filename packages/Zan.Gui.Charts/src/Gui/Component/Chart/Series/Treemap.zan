                        s.tmBorderWidth);
                }
                ChartView.SunLabel(app, s, k, cx, cy, band, a, visibleEnd, depth);
                if (k.children.Count > 0) {
                    ChartView.SunRingList(app, s, cx, cy, rMax, rPer, k.children,
                        depth + 1, a, rawEnd, sweepMax, col);
                }
            }
            a = rawEnd;
        }
    }

}
