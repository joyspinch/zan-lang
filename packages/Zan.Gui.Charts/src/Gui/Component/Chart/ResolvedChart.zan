using System;
using Gui;

namespace Gui.Component.Chart;

// ChartOption 的只读、逐帧规范化结果。
public class ResolvedChart {
    public ChartOption source;
    public List<ResolvedSeries> series;
    public List<int> drawOrder;  // draw index -> declaration index, fixed for this resolve
    public int wid;
    public int stateWid;  // connect 组的交互态基址（组长 wid）；无组 = wid
    public bool animate;
    public int windowStart;  // dataZoom 窗口（类别索引，含端点）；
    public int windowEnd;  // 无 zoom 时 = 全范围 [0, n-1]

    // 逐帧解析入口：确定 connect 组交互态基址 stateWid（组内
    // 首图把组长 wid 登记进组键并初始化共享悬停为 -1）、锁定
    // dataZoom 窗口 [windowStart, windowEnd]（无 zoom 或 n<2 时
    // 为全范围），并逐系列生成 ResolvedSeries（图例隐藏态与
    // CSS chart::series-N 颜色覆写在此一并应用）。
    public static ResolvedChart Resolve(ChartOption source, Theme theme, App app, int wid) {
        ResolvedChart outp = new ResolvedChart();
        outp.source = source;
        outp.series = new List<ResolvedSeries>();
        outp.wid = wid;
        outp.animate = source.animate && source.animation;
        // connect() 联动：交互态（dataZoom 窗口 / 图例开关）统一
        // 存取在组长 wid 上。组长登记在组键里（组内第一张图写入），
        // 本图非组长时用组长 wid 读写这些状态，实现跨图同帧联动。
        int stateWid = wid;
        if (app != null && wid != 0 && source.connectGroup != 0) {
            int gk = Chart.ConnectGroupKey(source.connectGroup);
            int leader = app.StateGet(gk, 0);
            if (leader == 0) {
                app.StateSet(gk, wid);
                app.StateSet(Chart.ConnectHoverKey(wid), 0 - 1);
            } else if (leader != wid) {
                stateWid = leader;
            }
        }
        outp.stateWid = stateWid;
        // dataZoom 窗口在解析期锁定一次，使指纹读取的窗口
        // 与渲染器读取的一致。无 zoom（或 n < 2）时
        // 是干净的全范围，不触发任何 App 状态读写。
        outp.windowStart = 0;
        outp.windowEnd = 0 - 1;
        int n = source.XCategories().Count;
        if (n < 1) { n = 1; }
        if (source.zoom && app != null && stateWid != 0 && n > 1) {
            outp.windowStart = Chart.ZoomI0(app, source, stateWid, n);
            outp.windowEnd = Chart.ZoomI1(app, source, stateWid, n);
            if (outp.windowEnd < outp.windowStart) { outp.windowEnd = outp.windowStart; }
        } else {
            outp.windowStart = 0;
            outp.windowEnd = n - 1;
        }
        // N7：z/zlevel 声明重排系列表（稳定，同键保声明序）。重排后，
        // 绑定在绘制序上；下游渲染器按重排后的表直接画，声明的 z 自然生效
        // （watermark 水印柱压住饼、pictorialBar 负 z 垫底、custom trend z=100
        // 压住柱群）。源 option 不回写——每帧重排，声明序恒为准。
        List<int> zorder = new List<int>();
        ChartView.ZOrder(source, zorder);
        outp.drawOrder = zorder;
        for (int i = 0; i < zorder.Count; i = i + 1) {
            ChartSeries s = source.series[zorder[i]];
            bool hidden = s.hidden;
            if (app != null && stateWid != 0) {
                hidden = app.StateGet(Chart.LegendKey(stateWid, i), hidden ? 1 : 0) == 1;
            }
            ResolvedSeries rs = ResolvedSeries.Of(s, theme, i, wid, outp.animate, hidden,
            source.colorPal);
            // CSS 通道：样式表可用 chart::series-1..8 的 background
            // 覆写该系列的定性色。仅显式规则生效——规则不存在时
            // BgOr 为 0，自动回退 token 调色板 / ECharts 默认色。
            // 两类**显式声明**压过主题层（官方语义）：①系列自带
            // color/itemStyle.color——主题调色板只填未声明的槽；
            // ②根级 color 调色板——option.color 整表替换主题调色板
            // （基线包 echarts6 常驻后，multiple-x-axis/
            // area-stack-gradient 曾被逐槽覆写回默认调色板）。
            bool seriesExplicit = s.color != 0
            || (s.itemStyle != null && s.itemStyle.normal != null && s.itemStyle.normal.color != 0);
            bool rootPal = source.colorPal != null
            && source.colorPal.Count > 0;
            if (app != null && !seriesExplicit && !rootPal) {
                int cssCol = Style.Part(app, "chart",
                "series-" + Convert.ToString((i % 8) + 1),
                "", "", "", Style.SNormal()).BgOr(0);
                if (cssCol != 0) { rs.OverrideColor(cssCol); }
            }
            outp.series.Add(rs);
        }
        return outp;
    }

    // 按源系列引用查找解析快照；未命中返回 null。
    public ResolvedSeries For(ChartSeries source) {
        for (int i = 0; i < this.series.Count; i = i + 1) {
            if (this.series[i].source == source) { return this.series[i]; }
        }
        return null;
    }

    // 把全部解析快照物化为 ChartSeries 副本（顺序 = Resolve 的
    // ZOrder 绘制序；N7 声明 z 的重排在 Resolve 完成，本表已按它排序）。
    // pie/funnel 之外的类型数据集合只读共享（阶段 B）。
    public List<ChartSeries> MaterializeSeries() {
        List<ChartSeries> outp = new List<ChartSeries>();
        for (int i = 0; i < this.series.Count; i = i + 1) {
            outp.Add(this.series[i].Materialize(true));
        }
        return outp;
    }

    // 创建渲染器使用的帧内 option。数据集合继续共享，可能被旧
    // 渲染器修改的 option/series 外壳则复制并与源模型隔离。
    // iwid 用 stateWid（connect 组的组长 wid）：渲染器所有交互
    // 键（dataZoom/图例/十字线）自动落到组共享的键上。
    public ChartOption DrawOption(int wid, bool animate) {
        ChartOption o = this.source.CopyFrame();
        o.series = this.MaterializeSeries();
        // Invert drawOrder: a cyclic permutation is not its own inverse.
        List<ChartSeries> decl = new List<ChartSeries>();
        for (int i = 0; i < o.series.Count; i = i + 1) { decl.Add(null); }
        for (int i = 0; i < this.drawOrder.Count; i = i + 1) {
            decl[this.drawOrder[i]] = o.series[i];
        }
        o.declOrder = decl;
        o.animate = animate;
        o.windowStart = this.windowStart;
        o.windowEnd = this.windowEnd;
        o.iwid = this.stateWid;
        return o;
    }
}
