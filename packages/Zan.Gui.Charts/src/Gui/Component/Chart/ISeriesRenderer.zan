using System;
using Gui;

namespace Gui.Component.Chart;

// 图表系列渲染器策略契约（Strategy Pattern）。
// 解耦 ChartView 巨型分发，使各类图表具备独立的渲染与交互职责，
// 并支持第三方/插件扩展自定义系列渲染器。
public interface ISeriesRenderer {
    // 判定该渲染器是否能够处理指定的系列类型 / 调度标记（如 "pie", "bar", "line" 等）
    bool CanRender(string kind);

    // 执行系列主体的排版与绘制
    void Render(App app, int x, int y, int w, int h, ChartOption option, int g);
}
