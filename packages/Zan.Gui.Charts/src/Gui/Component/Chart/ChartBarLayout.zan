using System;
using System.Text;

namespace Gui.Component.Chart;

/// 一根柱列的布局（ECharts `layout/barGrid.ts` columnMap 的条目）。
/// 同一 stack 的系列共享同一条列；`offset` 是柱左缘相对**类目带中心**
/// 的像素偏移，`width` 是柱宽。两者都是 double —— 带宽 300/7 = 42.857
/// 这类值走整数会系统性偏窄（旧实现 25.25 vs ECharts 29.571）。
class ChartBarCol {
    double offset;
    double width;

    static ChartBarCol Of(double o, double w) {
        return new ChartBarCol { offset = o, width = w };
    }
}

/// 柱形几何：ECharts 6.1 `coord/axisBand.ts` + `layout/barGrid.ts` 的
/// 逐行移植。旧实现用 `step*7/10`（分组）/ `step*9/10`（堆叠）+ 固定
/// 2px 缝近似，并把带宽先截断成 `int step = plotW/n`；数值上与 ECharts
/// 的 barCategoryGap/barGap 解算不等价，官方 40 个 bar 例因此全线偏差。
partial class ChartView {
    /// 类目带带宽（px）—— ECharts 6.1 `coord/axisBand.ts:calcBandWidthForCategoryAxis`
    /// 经 `calcBandWidth(axis, {min: 1})`。
    ///
    /// 柱形的类目轴按"带"排布：`w = 绘图区像素跨度 / 类目数`，末尾
    /// `max(1, w)` 兜底（`calcBandWidth` 的 `min` 参数）。ECharts 是把
    /// "类目轴按 ±0.5 带扩边"（barGrid 的 containShape 处理器）折算进
    /// scale 跨度后在 `calcBandWidth` 里得到同一结果；本引擎的轴定标
    /// 不跑那条协商链，所以直接取带公式。
    ///
    /// 实测锁定（ECharts 6.1 dist，300px 绘图区）：7/3/1 类目单系列的
    /// 柱宽 29.5714/69/207 = 0.69 × (300/7, 300/3, 300/1)，且带
    /// `boundaryGap` 真/假两组柱位逐像素相同——柱形永远按带中心定位，
    /// `boundaryGap:false` 只作用于折线族（`Chart.CatX` 那一路）。
    static double BarBandWidth(int plotW, int count) {
        int c = count;
        if (c < 1) { c = 1; }
        double w = (double)plotW / (double)c;
        if (w < 1.0) { return 1.0; }
        return w;
    }

    /// ECharts 6.1 `util/number.ts:parsePercent`：数值原样；`'N%'` 按
    /// 基准折算 `base*N/100`（可为负，`barCategoryGap:'-130%'` 与
    /// `barGap:'-100%'` 是官方例在用的写法）。返回值 = 选项是否存在
    /// （对应 ECharts 的 `undefined`）；解析不出数字的串按 0。
    static bool PercentOf(string raw, double baseW, out double outV) {
        outV = 0.0;
        if (raw == null || raw.Length < 1) { return false; }
        if (raw.EndsWith("%")) {
            outV = baseW * Encoding.ParseDouble(raw.Substring(0, raw.Length - 1)) / 100.0;
            return true;
        }
        outV = Encoding.ParseDouble(raw);
        return true;
    }

    /// `mathMax((remained - catGap) / (n + (n-1)*gapPct), 0)` 的安全版：
    /// 分母 <= 0 时 ECharts 得到负值或 ±Infinity，取 0 与之一致
    /// （无限宽柱无意义，且 autoWidthCount>=1 时不可达）。
    static double AutoBarWidth(double remained, double catGapNum,
                               int autoCount, double gapPct) {
        double denom = (double)autoCount + (double)(autoCount - 1) * gapPct;
        if (denom <= 0.0) { return 0.0; }
        double w = (remained - catGapNum) / denom;
        if (w < 0.0) { return 0.0; }
        return w;
    }

    /// ECharts 6.1 `layout/barGrid.ts:206-349` `calcBarWidthAndOffset()`。
    ///
    /// 输入：类目带宽 `bandW`；本条轴上的柱系列 `bars`（声明序）；与
    /// `bars` 同序的 `stackIds`（ECharts `getSeriesStackId`：`stack`
    /// 名，未设则 `__ec_stack_<index>` 每条系列独占一列）。
    /// 输出：与 `bars` 同序的列布局，同 stackId 的系列共享同一列对象。
    ///
    /// 三条容易写错的语义，全部照抄源：
    ///  * `barCategoryGap` 缺省 = `max(35 - stack 数*4, 15)%`，按带宽折算
    ///    （stack 数指本条轴上的 stack 组数，不是系列数）；
    ///  * `barGap` 缺省 `'10%'`（`BaseBarSeries.defaultOption.defaultBarGap`），
    ///    按基准 1 解算——它是"柱宽的比例"而非像素；
    ///  * `barGap`/`barCategoryGap` 取**最后一条**声明它们的系列，
    ///    `defaultBarGap` 只看第一条（barGrid.ts:200-205 的 CAUTION，
    ///    历史遗留语义，不是笔误）。
    static List<ChartBarCol> CalcBarCols(double bandW, List<ChartSeries> bars,
                                         List<string> stackIds) {
        List<ChartBarCol> cols = new List<ChartBarCol>();
        int nb = bars.Count;
        if (nb < 1) { return cols; }

        // ---- pass 1：stack 归并 + 逐系列选项（barGrid.ts:222-257） ----
        List<string> stackList = new List<string>();
        List<double> stackW = new List<double>();    // 0 = 未显式声明（ECharts 的 falsy）
        List<double> stackMin = new List<double>();
        List<double> stackMax = new List<double>();
        int autoCount = 0;
        double remained = bandW;
        string gapRaw = "";
        string catGapRaw = "";
        for (int i = 0; i < nb; i = i + 1) {
            ChartSeries s = bars[i];
            string sid = stackIds[i];
            int gi = ChartView.GroupIndex(stackList, sid);
            if (gi < 0) {
                stackList.Add(sid);
                stackW.Add(0.0);
                stackMin.Add(0.0);
                stackMax.Add(0.0);
                autoCount = autoCount + 1;
                gi = stackList.Count - 1;
            }
            if (i == 0) { gapRaw = "10%"; }   // defaultBarGap
            double bwV = 0.0;
            if (ChartView.PercentOf(s.barWidthRaw, bandW, out bwV) && bwV != 0.0) {
                if (stackW[gi] == 0.0) {
                    stackW[gi] = bwV;      // 存声明值（未钳制），钳制在 pass 2
                    remained = remained - (bwV < remained ? bwV : remained);
                }
            }
            double mxV = 0.0;
            if (ChartView.PercentOf(s.barMaxWidthRaw, bandW, out mxV) && mxV != 0.0) {
                stackMax[gi] = mxV;
            }
            double mnV = 0.0;
            if (ChartView.PercentOf(s.barMinWidthRaw, bandW, out mnV) && mnV != 0.0) {
                stackMin[gi] = mnV;
            } else {
                // barMinWidth 缺省 1px，large 模式 0.5（barGrid.ts:181-185
                // `|| (isInLargeMode(seriesModel) ? 0.5 : 1)`）。
                if (s.InLargeMode()) { stackMin[gi] = 0.5; }
                else { stackMin[gi] = 1.0; }
            }
            if (s.barGapRaw.Length > 0) { gapRaw = s.barGapRaw; }
            if (s.barCategoryGapRaw.Length > 0) { catGapRaw = s.barCategoryGapRaw; }
        }
        if (catGapRaw.Length < 1) {
            int pct = 35 - stackList.Count * 4;
            if (pct < 15) { pct = 15; }
            catGapRaw = Convert.ToString(pct) + "%";
        }
        double catGapNum = 0.0;
        ChartView.PercentOf(catGapRaw, bandW, out catGapNum);
        double gapPct = 0.0;
        ChartView.PercentOf(gapRaw, 1.0, out gapPct);
        double autoW = ChartView.AutoBarWidth(remained, catGapNum, autoCount, gapPct);

        // ---- pass 2：max/minWidth 钳制 + 回收余量（barGrid.ts:275-315） ----
        int nStack = stackList.Count;
        for (int i = 0; i < nStack; i = i + 1) {
            double fw = 0.0;
            if (stackW[i] == 0.0) {
                fw = autoW;
                if (stackMax[i] > 0.0 && stackMax[i] < fw) {
                    fw = stackMax[i] < remained ? stackMax[i] : remained;
                }
                if (stackMin[i] > 0.0 && stackMin[i] > fw) { fw = stackMin[i]; }
                if (fw != autoW) {
                    stackW[i] = fw;
                    remained = remained - (fw + gapPct * fw);
                    autoCount = autoCount - 1;
                }
            } else {
                fw = stackW[i];
                if (stackMax[i] > 0.0 && fw > stackMax[i]) { fw = stackMax[i]; }
                if (stackMin[i] > 0.0 && fw < stackMin[i]) { fw = stackMin[i]; }
                stackW[i] = fw;
                remained = remained - (fw + gapPct * fw);
                autoCount = autoCount - 1;
            }
        }
        autoW = ChartView.AutoBarWidth(remained, catGapNum, autoCount, gapPct);

        // ---- 偏移：整组在带内居中（barGrid.ts:317-346） ----
        // widthSum 扣掉最后一列的 barGap（组间才有缝，组尾没有）。
        double widthSum = 0.0;
        for (int i = 0; i < nStack; i = i + 1) {
            if (stackW[i] == 0.0) { stackW[i] = autoW; }
            widthSum = widthSum + stackW[i] * (1.0 + gapPct);
        }
        widthSum = widthSum - stackW[nStack - 1] * gapPct;
        List<ChartBarCol> byStack = new List<ChartBarCol>();
        double off = 0.0 - widthSum / 2.0;
        for (int i = 0; i < nStack; i = i + 1) {
            byStack.Add(ChartBarCol.Of(off, stackW[i]));
            off = off + stackW[i] * (1.0 + gapPct);
        }
        for (int i = 0; i < nb; i = i + 1) {
            int gi = ChartView.GroupIndex(stackList, stackIds[i]);
            cols.Add(byStack[gi]);
        }
        return cols;
    }

    /// 像素取整：各取两端再相减（`x1 - x0`），避免对宽高单独四舍五入
    /// 造成相邻柱 1px 缝或重叠（ECharts 的 rect 是浮点，栅格化时才落
    /// 到像素）。
    static int RoundPx(double v) {
        if (v >= 0.0) { return (int)(v + 0.5); }
        return 0 - (int)(0.0 - v + 0.5);
    }

    /// 柱左缘 / 右缘（绘图区坐标）→ 整数像素矩形。类目 `i` 的带中心是
    /// `plotX + (i + 0.5) * band`（带中心定位，见 `BarBandWidth`）。
    static int BarX0(ChartFrame f, int i, double band, double off) {
        return ChartView.RoundPx((double)f.plotX + ((double)i + 0.5) * band + off);
    }

    /// 水平柱（类目轴在 y）的上缘 / 下缘。ECharts barGrid 横向分支是
    /// `y = coord[1] + columnOffset`（coord[1] 为类目轴像素、即带中心），
    /// `height = columnWidth`；引擎的横向渲染器把类目 0 放在顶部
    /// （`rowY = plotY + i*rowH`），带中心因此同样取 `(i+0.5)*band`。
    static int BarY0(int plotY, int i, double band, double off) {
        return ChartView.RoundPx((double)plotY + ((double)i + 0.5) * band + off);
    }
}
