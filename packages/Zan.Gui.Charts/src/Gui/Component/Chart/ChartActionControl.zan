using System;
using Gui;

namespace Gui.Component.Chart;

// A retained, geometry-only input node for chart chrome. The series and the
// chrome visuals remain in ChartView.OnPaint; this node owns only routed input.
// The parent owns this node strongly, so the back-reference must stay weak.
class ChartActionControl : Control {
    public weak Control actionOwner;
    public int action;
    public int index;
    public int stamp;
    public bool hot;
    public int p0;
    public int p1;
    public int p2;
    public int p3;
    bool dragging;
    bool moved;
    int downX;
    int downY;

    public ChartActionControl(Control owner, int actionKind, int actionIndex) {
        this.InitControl("chartAction");
        this.actionOwner = owner;
        this.action = actionKind;
        this.index = actionIndex;
        this.stamp = 0;
        this.hot = false;
        this.dragging = false;
        this.moved = false;
    }

    public override string Kind() { return "ChartAction"; }
    public override string StyleType() { return "chart-action"; }

    ChartView View() {
        return this.actionOwner is ChartView ? (ChartView)this.actionOwner : null;
    }

    ChartTimeline Timeline() {
        return this.actionOwner is ChartTimeline ? (ChartTimeline)this.actionOwner : null;
    }

    public override void OnPointerEnter(RoutedEventArgs e) {
        base.OnPointerEnter(e);
        this.hot = true;
        ChartView v = this.View();
        if (v != null) { v.UpdateActionPointer(this, e); }
        ChartTimeline timeline = this.Timeline();
        if (timeline != null) { timeline.UpdateActionPointer(this, e); }
    }

    public override void OnPointerLeave(RoutedEventArgs e) {
        base.OnPointerLeave(e);
        this.hot = false;
        ChartView v = this.View();
        if (v != null && !this.dragging) { v.LeaveActionPointer(this, e); }
        ChartTimeline timeline = this.Timeline();
        if (timeline != null && !this.dragging) { timeline.LeaveActionPointer(this, e); }
    }

    public override void OnPointerDown(RoutedEventArgs e) {
        base.OnPointerDown(e);
        ChartView v = this.View();
        ChartTimeline timeline = this.Timeline();
        App app = this.App;
        if (app == null || (v == null && timeline == null)) { return; }
        if (v != null) { v.UpdateActionPointer(this, e); }
        if (timeline != null) { timeline.UpdateActionPointer(this, e); }
        this.downX = e.x;
        this.downY = e.y;
        this.moved = false;
        this.dragging = v != null
        ? v.ActionPointerDown(this, e) : timeline.ActionPointerDown(this, e);
        if (this.dragging) {
            app.CapturePointer(this, true);
            e.Handle();
        }
    }

    public override void OnPointerMove(RoutedEventArgs e) {
        ChartView v = this.View();
        ChartTimeline timeline = this.Timeline();
        if (v == null && timeline == null) { return; }
        if (v != null) { v.UpdateActionPointer(this, e); }
        if (timeline != null) { timeline.UpdateActionPointer(this, e); }
        if (this.dragging) {
            if (e.x != this.downX || e.y != this.downY) { this.moved = true; }
            if (v != null) { v.ActionPointerMove(this, e); }
            if (timeline != null) { timeline.ActionPointerMove(this, e); }
            e.Handle();
        }
    }

    public override void OnPointerUp(RoutedEventArgs e) {
        base.OnPointerUp(e);
        ChartView v = this.View();
        ChartTimeline timeline = this.Timeline();
        App app = this.App;
        if (v == null && timeline == null) { return; }
        if (v != null) { v.UpdateActionPointer(this, e); }
        if (timeline != null) { timeline.UpdateActionPointer(this, e); }
        if (this.dragging) {
            if (v != null) { v.ActionPointerUp(this, e); }
            if (timeline != null) { timeline.ActionPointerUp(this, e); }
            this.dragging = false;
            if (app != null && app.GetCapturedPointer() == this) {
                app.ReleasePointerCapture();
            }
            if (this.moved) { e.Handle(); }
        }
    }

    public override void OnPointerCancel(RoutedEventArgs e) {
        base.OnPointerCancel(e);
        ChartView v = this.View();
        ChartTimeline timeline = this.Timeline();
        App app = this.App;
        if (v != null && this.dragging) { v.ActionPointerUp(this, e); }
        if (timeline != null && this.dragging) { timeline.ActionPointerUp(this, e); }
        this.hot = false;
        if (v != null) { v.LeaveActionPointer(this, e); }
        if (timeline != null) { timeline.LeaveActionPointer(this, e); }
        this.dragging = false;
        this.moved = false;
        if (app != null && app.GetCapturedPointer() == this) {
            app.ReleasePointerCapture();
        }
        e.Handle();
    }

    public override void OnClick(RoutedEventArgs e) {
        ChartView v = this.View();
        ChartTimeline timeline = this.Timeline();
        if (v != null) {
            v.UpdateActionPointer(this, e);
            v.ActionClick(this, e);
        }
        if (timeline != null) { timeline.ActionClick(this, e); }
        e.Handle();
    }

    public override void OnWheel(RoutedEventArgs e) {
        ChartView v = this.View();
        ChartTimeline timeline = this.Timeline();
        if (v != null && v.ActionWheel(this, e)) { e.Handle(); }
        if (timeline != null && timeline.ActionWheel(this, e)) { e.Handle(); }
    }
}
