using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Component.Chart;

// 图表颜色与调色板基元计算（ChartColor）。
// 包含 RGB/Alpha 打包、感知对比度计算、系列聚焦渐隐、色带插值与调色板解析。
public class ChartColor {
    // 不透明 0xFFRRGGBB 打包为正 int（Canvas 转 u32）。
    // r/g/b 各 0..255。
    public static int Rgb(int r, int g, int b) {
        return (int)4278190080 + r * 65536 + g * 256 + b;
    }

    // 与打包不透明颜色相同的 RGB，但替换 alpha（0 透明..255 不透明，
    // 用于面积/扇区填充）。
    public static int WithAlpha(int packed, int a) {
        return (packed - (int)4278190080) + a * 16777216;
    }

    // ECharts 'transparent'：alpha 1/255 的白色——合成后每通道
    // 偏移 <=1，视觉不可见；取非 0 值是为了不与"0 = 继承系列色"
    // 的图表着色语义冲突（瀑布图透明占位柱）。
    public static int Transparent() {
        return ChartColor.WithAlpha(ChartColor.Rgb(255, 255, 255), 1);
    }

    // 在 `bg` 上对比足够的前景：浅底深字、深底白字。
    // 饼图扇区 / 地图填色上的标签用它，避免白字画在黄块上。
    public static int ContrastFg(int bg) {
        int r = bg >> 16 & 255;
        int g = bg >> 8 & 255;
        int b = bg & 255;
        int lum = (r * 299 + g * 587 + b * 114) / 1000;
        if (lum > 155) { return ChartColor.Rgb(32, 36, 42); }
        return ChartColor.Rgb(255, 255, 255);
    }

    // 官方 blur 残透明：ECharts focus 聚焦时非聚焦系列乘默认
    // blur opacity 0.1（bump 图悬停其余线淡出的量）。
    public static int FadeFocusAlpha() { return 26; }

    public static int fadeFocusIdx = -1;

    // 聚焦渐隐取色：无聚焦或 si 即聚焦系列时原色返回，其余系列乘残透明。
    public static int FadeFocusColor(int si, int color) {
        if (ChartColor.fadeFocusIdx < 0 || si == ChartColor.fadeFocusIdx) { return color; }
        return ChartColor.WithAlpha(color, ChartColor.FadeFocusAlpha());
    }

    public static int FadeFocusColor(int si, int color, int currentFocusIdx) {
        if (currentFocusIdx < 0 || si == currentFocusIdx) { return color; }
        return ChartColor.WithAlpha(color, ChartColor.FadeFocusAlpha());
    }

    // 多段线性色带插值（visualMap inRange）：t in [0,1000] 均匀映射
    // 到 colors 首尾之间，段内线性混合。colors 少于 2 个时取首色。
    public static int RampAt(List<int> colors, int t) {
        int n = colors.Count;
        if (n < 1) { return 0; }
        if (n == 1 || t <= 0) { return colors[0]; }
        if (t >= 1000) { return colors[n - 1]; }
        int seg = (n - 1) * t / 1000;
        int f = ((n - 1) * t) % 1000;
        int a = colors[seg];
        int b = colors[seg + 1];
        int r = (a >> 16 & 255) + ((b >> 16 & 255) - (a >> 16 & 255)) * f / 1000;
        int g = (a >> 8 & 255) + ((b >> 8 & 255) - (a >> 8 & 255)) * f / 1000;
        int bl = (a & 255) + ((b & 255) - (a & 255)) * f / 1000;
        return ChartColor.Rgb(r, g, bl);
    }

    // 定性调色板第 i 档：图表皮肤（ChartSkin）优先——图表配色是
    // 独立板块，不占全局皮肤主题的 token；当前皮肤 8 档齐全，
    // 命中即返回。皮肤之后依次是主题的 --chart-1 .. --chart-8
    // token（Theme.chart1..8，0 = 该槽位未定义）与 ECharts 6.1
    // 默认主题调色板（src/visual/tokens.ts，9 档）兜底。
    public static int Palette(Theme t, int i) {
        int skc = ChartSkin.ColorAt(ChartSkin.Current(), i);
        if (skc != 0) { return skc; }
        int m = i % 8;
        if (t != null) {
            if (m == 0 && t.chart1 != 0) { return t.chart1; }
            if (m == 1 && t.chart2 != 0) { return t.chart2; }
            if (m == 2 && t.chart3 != 0) { return t.chart3; }
            if (m == 3 && t.chart4 != 0) { return t.chart4; }
            if (m == 4 && t.chart5 != 0) { return t.chart5; }
            if (m == 5 && t.chart6 != 0) { return t.chart6; }
            if (m == 6 && t.chart7 != 0) { return t.chart7; }
            if (m == 7 && t.chart8 != 0) { return t.chart8; }
        }
        int m9 = i % 9;
        if (m9 == 0) { return ChartColor.Rgb(80, 112, 221); }  // #5070DD
        if (m9 == 1) { return ChartColor.Rgb(182, 214, 52); }  // #B6D634
        if (m9 == 2) { return ChartColor.Rgb(80, 83, 114); }  // #505372
        if (m9 == 3) { return ChartColor.Rgb(255, 153, 77); }  // #FF994D
        if (m9 == 4) { return ChartColor.Rgb(12, 168, 223); }  // #0CA8DF
        if (m9 == 5) { return ChartColor.Rgb(255, 209, 10); }  // #FFD10A
        if (m9 == 6) { return ChartColor.Rgb(251, 98, 139); }  // #FB628B
        if (m9 == 7) { return ChartColor.Rgb(120, 93, 176); }  // #785DB0
        return ChartColor.Rgb(63, 190, 149);  // #3FBE95
    }

    // 系列普通状态的统一颜色回退：显式系列色、normal.color、调色板。
    public static int SeriesPaintColor(ChartSeries s, Theme t, int index) {
        if (s != null) {
            if (s.color != 0) { return s.color; }
            if (s.itemStyle != null && s.itemStyle.normal != null
                && s.itemStyle.normal.color != 0) {
                return s.itemStyle.normal.color;
            }
        }
        return ChartColor.Palette(t, index);
    }
}
