using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Component.Chart;

// 图表几何与投影计算核心（ChartGeometry）。
// 包含 Grid 盒模型解算、NiceScale 量程阶梯、坐标数值投影与多边形命中测试。
public class ChartGeometry {
    // hasValue（mergeLayoutParam 尾部）：!= null 且 != 'auto'。
    public static bool BoxParamHasValue(ChartBoxParam p) {
        return p != null && p.kind != 0;
    }

    // parsePositionOption：百分比 = parseFloat/100*base，数值串 parseFloat。
    public static double GridParsePercent(ChartBoxParam p, double base1, out bool wrote) {
        wrote = false;
        if (p == null || p.kind == 0) { return 0.0; }
        if (p.kind == 2) {
            wrote = true;
            return p.num / 100.0 * base1;
        }
        if (p.kind == 3) {
            if (p.kw == "center" || p.kw == "middle") {
                wrote = true;
                return 0.5 * base1;
            }
            if (p.kw == "left" || p.kw == "top") {
                wrote = true;
                return 0.0;
            }
            if (p.kw == "right" || p.kw == "bottom") {
                wrote = true;
                return base1;
            }
            return 0.0;
        }
        wrote = true;
        return p.num;
    }

    // getLayoutRect（util/layout.ts:263-360）：p = [left,right,top,bottom,width,height]。
    public static ChartLayoutRect GridGetLayoutRect(List<ChartBoxParam> p, double cw, double ch) {
        double left = ChartGeometry.GridParsePercent(p[0], cw, out bool wL);
        double top = ChartGeometry.GridParsePercent(p[2], ch, out bool wT);
        double right = ChartGeometry.GridParsePercent(p[1], cw, out bool wR);
        double bottom = ChartGeometry.GridParsePercent(p[3], ch, out bool wB);
        double width = ChartGeometry.GridParsePercent(p[4], cw, out bool wW);
        double height = ChartGeometry.GridParsePercent(p[5], ch, out bool wH);
        if (!wW) { width = cw - right - left; }
        if (!wH) { height = ch - bottom - top; }
        if (!wL) { left = cw - right - width; }
        if (!wT) { top = ch - bottom - height; }
        ChartLayoutRect r = new ChartLayoutRect();
        r.x = (int)left;
        r.y = (int)top;
        r.width = (int)width;
        r.height = (int)height;
        return r;
    }

    // 以 10 为底的指数计算（带浮点截断补偿）
    public static int QuantityExponent(double val) {
        if (val == 0.0) { return 0; }
        if (val < 0.0) { val = 0.0 - val; }
        return (int)Math.Floor(Math.Log10(val));
    }

    // 10^e 次幂
    public static double Pow10D(int e) {
        return Math.Pow(10.0, (double)e);
    }

    // 指定小数位数的四舍五入
    public static double RoundP(double x, int precision) {
        if (precision <= 0) { return Math.Round(x); }
        double p = ChartGeometry.Pow10D(precision);
        return Math.Round(x * p) / p;
    }

    // ECharts 核心 1/2/3/5/10 阶梯量程算法
    public static double NiceMode(double val, int roundMode) {
        int exp = ChartGeometry.QuantityExponent(val);
        double f = val / ChartGeometry.Pow10D(exp);
        double nf = 10.0;
        if (roundMode <= 0) {
            if (f <= 1.0) { nf = 1.0; }
            else if (f <= 2.0) { nf = 2.0; }
            else if (f <= 3.0) { nf = 3.0; }
            else if (f <= 5.0) { nf = 5.0; }
        } else {
            if (f < 1.5) { nf = 1.0; }
            else if (f < 2.5) { nf = 2.0; }
            else if (f < 4.0) { nf = 3.0; }
            else if (f < 7.0) { nf = 5.0; }
        }
        return nf * ChartGeometry.Pow10D(exp);
    }

    // 射线法判定点 (px, py) 是否在多边形内部
    public static bool PointInPoly(List<ChartPoint> poly, int px, int py) {
        if (poly == null || poly.Count < 3) { return false; }
        bool inside = false;
        int j = poly.Count - 1;
        for (int i = 0; i < poly.Count; i = i + 1) {
            int xi = poly[i].x; int yi = poly[i].y;
            int xj = poly[j].x; int yj = poly[j].y;
            bool intersect = ((yi > py) != (yj > py))
                && (px < (xj - xi) * (py - yi) / (yj - yi == 0 ? 1 : yj - yi) + xi);
            if (intersect) { inside = !inside; }
            j = i;
        }
        return inside;
    }

    // 直角坐标 X 轴数值映射到屏幕像素
    public static int ValueX(int plotX, int plotW, int lo, int hi, int v) {
        if (hi <= lo) { return plotX; }
        return plotX + (int)((long)(v - lo) * (long)plotW / (long)(hi - lo));
    }

    // 直角坐标 Y 轴数值映射到屏幕像素
    public static int ValueY(int plotY, int plotH, int lo, int hi, int v) {
        if (hi <= lo) { return plotY + plotH; }
        return plotY + plotH - (int)((long)(v - lo) * (long)plotH / (long)(hi - lo));
    }
}
