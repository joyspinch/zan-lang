using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Component.Chart;

// 图表几何与投影计算核心（ChartGeometry）。
// 包含 Grid 盒模型解算、NiceScale 量程阶梯、坐标数值投影与多边形命中测试。
public class ChartGeometry {
    // hasValue（mergeLayoutParam 尾部）：!= null 且 != 'auto'。
    public static bool BoxParamHasValue(ChartBoxParam p) {
        return p != null && p.kind != 0;
    }

    // parsePositionOption：百分比 = parseFloat/100*base，数值串 parseFloat。
    public static double GridParsePercent(ChartBoxParam p, double base1, out bool wrote) {
        wrote = false;
        if (p == null || p.kind == 0) { return 0.0; }
        if (p.kind == 2) {
            wrote = true;
            return p.num / 100.0 * base1;
        }
        if (p.kind == 3) {
            if (p.kw == "center" || p.kw == "middle") {
                wrote = true;
                return 0.5 * base1;
            }
            if (p.kw == "left" || p.kw == "top") {
                wrote = true;
                return 0.0;
            }
            if (p.kw == "right" || p.kw == "bottom") {
                wrote = true;
                return base1;
            }
            return 0.0;
        }
        wrote = true;
        return p.num;
    }

    // getLayoutRect（util/layout.ts:263-360）：p = [left,right,top,bottom,width,height]。
    public static ChartLayoutRect GridGetLayoutRect(List<ChartBoxParam> p, double cw, double ch) {
        double left = ChartGeometry.GridParsePercent(p[0], cw, out bool wL);
        double top = ChartGeometry.GridParsePercent(p[2], ch, out bool wT);
        double right = ChartGeometry.GridParsePercent(p[1], cw, out bool wR);
        double bottom = ChartGeometry.GridParsePercent(p[3], ch, out bool wB);
        double width = ChartGeometry.GridParsePercent(p[4], cw, out bool wW);
        double height = ChartGeometry.GridParsePercent(p[5], ch, out bool wH);
        if (!wW) { width = cw - right - left; }
        if (!wH) { height = ch - bottom - top; }
        if (!wL) { left = cw - right - width; }
        if (!wT) { top = ch - bottom - height; }
        ChartBoxParam lh = p[0] != null ? p[0] : p[1];
        if (lh != null && lh.kind == 3) {
            if (lh.kw == "center") { left = cw / 2.0 - width / 2.0; }
            else if (lh.kw == "right") { left = cw - width; }
        }
        ChartBoxParam tv = p[2] != null ? p[2] : p[3];
        if (tv != null && tv.kind == 3) {
            if (tv.kw == "middle" || tv.kw == "center") { top = ch / 2.0 - height / 2.0; }
            else if (tv.kw == "bottom") { top = ch - height; }
        }
        if (!(left > 0.0) && !(left < 0.0)) { left = 0.0; }
        if (!(top > 0.0) && !(top < 0.0)) { top = 0.0; }
        ChartLayoutRect r = new ChartLayoutRect();
        r.x = left;
        r.y = top;
        r.width = width;
        r.height = height;
        return r;
    }

    // mergeLayoutParam 的单族（names = [size, min, max] 六参下标）。
    public static void GridMergeOne(int[] names, List<ChartBoxParam> target,
                             List<ChartBoxParam> newOption) {
        List<ChartBoxParam> merged = new List<ChartBoxParam>();
        List<ChartBoxParam> newParams = new List<ChartBoxParam>();
        for (int ni = 0; ni < 3; ni = ni + 1) {
            merged.Add(target[names[ni]]);
            newParams.Add(null);
        }
        int newValueCount = 0;
        int mergedValueCount = 0;
        for (int ni = 0; ni < 3; ni = ni + 1) {
            if (newOption[names[ni]] != null) {
                newParams[ni] = newOption[names[ni]];
                merged[ni] = newOption[names[ni]];
            }
            if (ChartGeometry.BoxParamHasValue(newParams[ni])) { newValueCount = newValueCount + 1; }
            if (ChartGeometry.BoxParamHasValue(merged[ni])) { mergedValueCount = mergedValueCount + 1; }
        }
        List<ChartBoxParam> result;
        if (mergedValueCount == 2 || newValueCount == 0) {
            result = merged;
        } else if (newValueCount >= 2) {
            result = newParams;
        } else {
            result = newParams;
            for (int ni = 0; ni < 3; ni = ni + 1) {
                if (newParams[ni] == null && target[names[ni]] != null) {
                    result[ni] = target[names[ni]];
                    break;
                }
            }
        }
        for (int ni = 0; ni < 3; ni = ni + 1) {
            target[names[ni]] = result[ni];
        }
    }

    public static void GridMergeLayoutParam(List<ChartBoxParam> target,
                                     List<ChartBoxParam> newOption) {
        int[] hvW = new int[] { 4, 0, 1 };
        int[] hvH = new int[] { 5, 2, 3 };
        ChartGeometry.GridMergeOne(hvW, target, newOption);
        ChartGeometry.GridMergeOne(hvH, target, newOption);
    }

    public static List<ChartBoxParam> GridParamsNew() {
        List<ChartBoxParam> ps = new List<ChartBoxParam>();
        for (int i = 0; i < 6; i = i + 1) { ps.Add(null); }
        return ps;
    }

    public static ChartLayoutRect GridRawRect(ChartBoxParam l, ChartBoxParam r,
                                       ChartBoxParam t, ChartBoxParam b,
                                       ChartBoxParam w, ChartBoxParam h,
                                       double cw, double ch,
                                       bool nullDefaults) {
        List<ChartBoxParam> ps = ChartGeometry.GridParamsNew();
        if (nullDefaults) {
            ps[0] = l;
            ps[1] = r;
            ps[2] = t;
            ps[3] = b;
        } else {
            ps[0] = l != null ? l : ChartBoxParam.Pct(15.0);
            ps[1] = r != null ? r : ChartBoxParam.Pct(10.0);
            ps[2] = t != null ? t : ChartBoxParam.Px(65.0);
            ps[3] = b != null ? b : ChartBoxParam.Px(80.0);
        }
        ps[4] = w;
        ps[5] = h;
        List<ChartBoxParam> declared = ChartGeometry.GridParamsNew();
        declared[0] = l;
        declared[1] = r;
        declared[2] = t;
        declared[3] = b;
        declared[4] = w;
        declared[5] = h;
        ChartGeometry.GridMergeLayoutParam(ps, declared);
        return ChartGeometry.GridGetLayoutRect(ps, cw, ch);
    }

    // expandOrShrinkRect（util/graphic.ts:608-673）的 shrink 半边
    // delta = [top, right, bottom, left]（margin 序），先钳非负，
    // 再负向应用：x -= left、width -= (right+left)…… 尺寸小于
    // minSize 时保持 minSize 并按 delta 方向贴边。
    public static void GridShrinkRect(ChartLayoutRect rect, double mTop,
                               double mRight, double mBottom, double mLeft,
                               double minW, double minH) {
        if (mTop < 0.0) { mTop = 0.0; }
        if (mRight < 0.0) { mRight = 0.0; }
        if (mBottom < 0.0) { mBottom = 0.0; }
        if (mLeft < 0.0) { mLeft = 0.0; }
        double oldW = rect.width;
        double newW = rect.width - mLeft - mRight;
        double minWc = minW;
        if (minWc > oldW) { minWc = oldW; }
        if (minWc < 0.0) { minWc = 0.0; }
        if (newW < minWc) {
            rect.width = minWc;
            rect.x = rect.x + oldW - mRight;
            if (mLeft > 0.0 && mRight <= 0.0) { rect.x = rect.x + mLeft; }
        } else {
            rect.width = newW;
            rect.x = rect.x + mLeft;
        }
        double oldH = rect.height;
        double newH = rect.height - mTop - mBottom;
        double minHc = minH;
        if (minHc > oldH) { minHc = oldH; }
        if (minHc < 0.0) { minHc = 0.0; }
        if (newH < minHc) {
            rect.height = minHc;
            rect.y = rect.y + oldH - mBottom;
            if (mTop > 0.0 && mBottom <= 0.0) { rect.y = rect.y + mTop; }
        } else {
            rect.height = newH;
            rect.y = rect.y + mTop;
        }
    }

    // 以 10 为底的指数计算（带浮点截断补偿）
    public static int QuantityExponent(double val) {
        if (val == 0.0) { return 0; }
        double av = val < 0.0 ? 0.0 - val : val;
        double lg = Math.Log(av) / 2.302585092994046;
        int exp = (int)lg;
        if ((double)exp > lg) { exp = exp - 1; }
        if (av / ChartGeometry.Pow10D(exp) >= 10.0) { exp = exp + 1; }
        return exp;
    }

    // 10^e 次幂
    public static double Pow10D(int e) {
        double r = 1.0;
        int n = e < 0 ? 0 - e : e;
        for (int i = 0; i < n; i = i + 1) { r = r * 10.0; }
        return e < 0 ? 1.0 / r : r;
    }

    // 指定小数位数的四舍五入
    public static double RoundP(double x, int precision) {
        if (precision <= 0) { return Math.Round(x); }
        double p = ChartGeometry.Pow10D(precision);
        return Math.Round(x * p) / p;
    }

    // ECharts 核心 1/2/3/5/10 阶梯量程算法
    public static double NiceMode(double val, int roundMode) {
        int exp = ChartGeometry.QuantityExponent(val);
        double f = val / ChartGeometry.Pow10D(exp);
        double nf = 10.0;
        if (roundMode <= 0) {
            if (f <= 1.0) { nf = 1.0; }
            else if (f <= 2.0) { nf = 2.0; }
            else if (f <= 3.0) { nf = 3.0; }
            else if (f <= 5.0) { nf = 5.0; }
        } else {
            if (f < 1.5) { nf = 1.0; }
            else if (f < 2.5) { nf = 2.0; }
            else if (f < 4.0) { nf = 3.0; }
            else if (f < 7.0) { nf = 5.0; }
        }
        return nf * ChartGeometry.Pow10D(exp);
    }

    // 射线法判定点 (px, py) 是否在多边形内部
    public static bool PointInPoly(List<ChartPoint> poly, int px, int py) {
        if (poly == null || poly.Count < 3) { return false; }
        bool inside = false;
        int j = poly.Count - 1;
        for (int i = 0; i < poly.Count; i = i + 1) {
            int xi = poly[i].x; int yi = poly[i].y;
            int xj = poly[j].x; int yj = poly[j].y;
            bool intersect = ((yi > py) != (yj > py))
                && (px < (xj - xi) * (py - yi) / (yj - yi == 0 ? 1 : yj - yi) + xi);
            if (intersect) { inside = !inside; }
            j = i;
        }
        return inside;
    }

    // 直角坐标 X 轴数值映射到屏幕像素
    public static int ValueX(int plotX, int plotW, int lo, int hi, int v) {
        if (hi <= lo) { return plotX; }
        return plotX + (int)((long)(v - lo) * (long)plotW / (long)(hi - lo));
    }

    // 直角坐标 Y 轴数值映射到屏幕像素
    public static int ValueY(int plotY, int plotH, int lo, int hi, int v) {
        if (hi <= lo) { return plotY + plotH; }
        return plotY + plotH - (int)((long)(v - lo) * (long)plotH / (long)(hi - lo));
    }
}
