using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// Chart.Axes.zan - 直角坐标系构建器（双 Y 轴/对数/时间/多刻度对齐与分类标签排布）
public partial class Chart {
    // 完整直角坐标系：左（+ 可选右）数值轴，友好刻度 / 固定边界 /
    // 翻转 / 对数 / 时间 X 轴、分类标签防重叠、网格内边距覆盖和轴
    // 标题。返回携带两个轴范围的 ChartFrame，所有渲染器通过
    // f.YOf(v, axisIndex) 映射数值。
    public static ChartFrame BuildAxes(App app, int x, int y, int w, int h, int plotTop,
                                List<string> labels, ChartOption o, List<ChartSeries> series) {
        return Chart.BuildAxesR(app, x, y, w, h, plotTop, labels, o, series, 0 - 1, 0 - 1,
            0 - 1, 0 - 1);
    }

    // 带 dataZoom 窗口的 BuildAxes：Y 量程按原始系列上的
    // [i0, i1] 扫描（labels 须已是对应窗口切片）。
    public static ChartFrame BuildAxesW(App app, int x, int y, int w, int h, int plotTop,
                                 List<string> labels, ChartOption o, List<ChartSeries> series,
                                 int i0, int i1) {
        return Chart.BuildAxesR(app, x, y, w, h, plotTop, labels, o, series, 0 - 1, 0 - 1, i0, i1);
    }

    // 同 BuildAxes，但左/右轴使用显式数据最大值
    // （-1 = 从系列逐点推导）；堆叠图传入堆叠总和。
    // winI0/winI1 = dataZoom 可见窗口在**原始系列**上的下标区间
    // （-1,-1 = 无窗口）。Y 量程必须按该区间扫描：调用方（渲染器）
    // 传入的 labels 已是窗口切片，在这里再按 labels.Count 反解窗口
    // 会**二次开窗**（area-simple：2000 个窗口标签再取 10% → 200 点，
    // 量程被压到首个 1%，填充被放大到 1.65×）。窗口只有一个来源：
    // 渲染器算好传进来。
    public static ChartFrame BuildAxesR(App app, int x, int y, int w, int h, int plotTop,
                                 List<string> labels, ChartOption o, List<ChartSeries> series,
                                 int leftDataMax, int rightDataMax,
                                 int winI0, int winI1) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int fs = ChartFonts.AxisLabel(app);
        int fh = Canvas.FontHeight(fs);
        ChartAxis y0 = o.YAxis0();
        ChartAxis y1 = o.YAxis1();
        ChartAxis x0 = o.XAxis0();
        int ticks = y0.ticks;
        if (ticks < 1) { ticks = 5; }

        // dataZoom 可见窗口（-1,-1 = 无窗口，按全量）。窗口由调用方
        // 传入——本函数收到的 labels 已经是窗口切片，不能再自行反解。
        // ECharts 6 默认 filterMode 下 Y 量程随窗口重定：窗口化只
        // 在真的缩放（窗口 ≠ 全量）时生效，未缩放图与旧行为逐像素
        // 一致。长度基准与渲染器 DrawLines/Scatter 的 fullN 同源：
        // 类目 X 用 labels.Count，数值/时间 X 用最长系列长度。
        int zI0 = winI0;
        int zI1 = winI1;

        bool hasRight = o.yAxes.Count > 1;
        if (o.yAxes.Count == 0 && Chart.AnyOnAxis(series, 1)) { hasRight = true; }

        int lData = leftDataMax;
        if (lData < 0) { lData = Chart.AxisMaxFor(series, 0, zI0, zI1, y0.scale, hasRight); }
        bool leftFrac = Chart.SeriesFracAny(series, 0, hasRight);
        // min:'dataMin'（fixMM 语义，scaleRawExtentInfo.ts:241-244）：该端
        // 钉在原始数据极值上——不 nice、不并入 0（固定端 respect fixMM，
        // 单侧并入 0 不生效）。取极值用 scale=true 的原始口径。
        int declLo = y0.min;
        if (y0.minDataB) { declLo = Chart.AxisMinFor(series, 0, zI0, zI1, true, hasRight); }
        int declHi = y0.max;
        if (y0.maxDataB) { declHi = Chart.AxisMaxFor(series, 0, zI0, zI1, true, hasRight); }
        int rawLo = Chart.AxisMinFor(series, 0, zI0, zI1, y0.scale, hasRight);
        int leftLo = Chart.AxisLo(declLo, rawLo, y0.scale);
        int leftHi = Chart.AxisHi(declHi, lData, leftLo);
        // 数值轴 boundaryGap（整数路径）：原始域按声明千分比外扩
        // （官方 fixExtentWithBoundaryGap），仅 min/max 均未固定时。
        if (!leftFrac && (y0.bgLoF != 0 || y0.bgHiF != 0)
            && ChartOption.IsAutoD(y0.minD) && ChartOption.IsAutoD(y0.maxD)) {
            long spanBg = (long)(leftHi - leftLo);
            if (spanBg > 0) {
                leftLo = (int)((long)leftLo - spanBg * y0.bgLoF / 1000);
                leftHi = (int)((long)leftHi + spanBg * y0.bgHiF / 1000);
            }
        }
        // alignTicks 需要的是 **nice 之前**的原始 extent
        // （axisAlignTicks.ts:176 的 targetExtent = 原始域，不是 niceExtent）。
        // 本引擎两条路径的原始域都要留下副本。
        double lRawLo = 0.0;
        double lRawHi = 0.0;
        int leftLoF = 0;
        int leftHiF = 0;
        if (leftFrac) {
            // 小数轴（valueAxis 源码流程）：extent = 固定 min/max 或
            // 原始数据上下界（×1000 定点）；双正锚 min=0 / 双负锚
            // max=0 与向下/向上取整全部由 NiceRange（smartSteps）
            // 承担（line6 流量 0.46..365 + 固定 max 500 → 0..500000
            // 定点 5 段）。两端都固定走 _customerValue——精确等分
            // 不取整（line8 0..30）。
            if (!ChartOption.IsAutoD(y0.minD)) {
                leftLoF = (int)(y0.minD >= 0.0 ? y0.minD * 1000.0 + 0.5
                    : y0.minD * 1000.0 - 0.5);
            } else if (y0.minDataB) {
                leftLoF = Chart.AxisMinForF(series, 0, zI0, zI1, true, hasRight);
            } else {
                leftLoF = Chart.FracAxisLoF(y0.min, series, 0, zI0, zI1, y0.scale, hasRight);
            }
            if (!ChartOption.IsAutoD(y0.maxD)) {
                leftHiF = (int)(y0.maxD >= 0.0 ? y0.maxD * 1000.0 + 0.5
                    : y0.maxD * 1000.0 - 0.5);
            } else if (y0.maxDataB) {
                leftHiF = Chart.AxisMaxForF(series, 0, zI0, zI1, true, hasRight);
            } else {
                leftHiF = Chart.FracAxisHiF(y0.max, series, 0, zI0, zI1, y0.scale, hasRight);
            }
            if (!ChartOption.IsAutoD(y0.minD) && !ChartOption.IsAutoD(y0.maxD)) {
                leftLo = leftLoF / 1000;
                leftHi = leftHiF / 1000;
                lRawLo = (double)leftLoF; lRawHi = (double)leftHiF;
            } else {
                // minInterval/maxInterval 在数据单位上声明，定点域 ×1000。
                // 未声明（AutoD 哨兵）不能乘，否则哨兵失效。
                // boundaryGap（定点路径）：nice 之前按 span 千分比外扩
                // （官方 fixExtentWithBoundaryGap，area-time-axis
                // [0,'100%']：-499..283 → -499..1065 → nice -600..1200）。
                if (y0.bgLoF != 0 || y0.bgHiF != 0) {
                    long spanBg = (long)(leftHiF - leftLoF);
                    if (spanBg > 0) {
                        leftLoF = (int)((long)leftLoF - spanBg * y0.bgLoF / 1000);
                        leftHiF = (int)((long)leftHiF + spanBg * y0.bgHiF / 1000);
                    }
                }
                if (y0.type == ChartAxisType.Log) {
                    // 对数轴（小数域）：官方 LogScale.getExtent 对齐十
                    // 进位，10^floor/ceil（line-log 0.002..2000 →
                    // 0.001..10000，‰ 域 1..10000000）。不走线性 nice。
                    leftLoF = (int)Chart.LogFloorF(leftLoF);
                    leftHiF = (int)Chart.LogCeilF(leftHiF);
                    if (leftHiF <= leftLoF) { leftHiF = leftLoF * 10; }
                    lRawLo = (double)leftLoF; lRawHi = (double)leftHiF;
                    ticks = 1;
                    long dg = (long)leftLoF;
                    int dc = 0;
                    while (dg < leftHiF) { dg = dg * 10L; dc = dc + 1; }
                    ticks = dc > 0 ? dc : 1;
                } else {
                    lRawLo = (double)leftLoF; lRawHi = (double)leftHiF;
                    double lmn = ChartOption.IsAutoD(y0.minInterval)
                        ? ChartOption.AutoD() : y0.minInterval * 1000.0;
                    double lmx = ChartOption.IsAutoD(y0.maxInterval)
                        ? ChartOption.AutoD() : y0.maxInterval * 1000.0;
                    ChartSpan fs2 = Chart.ClampNiceRange(leftLoF, leftHiF, y0.scale, lmn, lmx);
                    leftLoF = fs2.lo;
                    leftHiF = fs2.hi;
                    ticks = fs2.ticks;
                }
                leftLo = leftLoF / 1000;
                leftHi = leftHiF / 1000;
                if (leftLo < 1) { leftLo = 1; }
            }
        }
        int rightLo = 0;
        int rightHi = 1;
        int rightLoF = 0;
        int rightHiF = 0;
        double rRawLo = 0.0;
        double rRawHi = 0.0;
        bool rightFrac = false;
        int rt = ticks;
        if (hasRight) {
            int rData = rightDataMax;
            if (rData < 0) { rData = Chart.AxisMaxFor(series, 1, zI0, zI1, y1.scale, hasRight); }
            int rDeclLo = y1.min;
            if (y1.minDataB) { rDeclLo = Chart.AxisMinFor(series, 1, zI0, zI1, true, hasRight); }
            int rDeclHi = y1.max;
            if (y1.maxDataB) { rDeclHi = Chart.AxisMaxFor(series, 1, zI0, zI1, true, hasRight); }
            rightLo = Chart.AxisLo(rDeclLo, Chart.AxisMinFor(series, 1, zI0, zI1, y1.scale, hasRight), y1.scale);
            rightHi = Chart.AxisHi(rDeclHi, rData, rightLo);
            rightFrac = Chart.SeriesFracAny(series, 1, hasRight);
            if (rightFrac) {
                // 右小数轴（line6 降雨量 -0.955..-0.005 → 定点域
                // -1000..0 步长 200），同左轴流程。
                if (!ChartOption.IsAutoD(y1.minD)) {
                    rightLoF = (int)(y1.minD >= 0.0 ? y1.minD * 1000.0 + 0.5
                        : y1.minD * 1000.0 - 0.5);
                } else {
                    rightLoF = Chart.FracAxisLoF(y1.min, series, 1, zI0, zI1, y1.scale, hasRight);
                }
                if (!ChartOption.IsAutoD(y1.maxD)) {
                    rightHiF = (int)(y1.maxD >= 0.0 ? y1.maxD * 1000.0 + 0.5
                        : y1.maxD * 1000.0 - 0.5);
                } else {
                    rightHiF = Chart.FracAxisHiF(y1.max, series, 1, zI0, zI1, y1.scale, hasRight);
                }
                rRawLo = (double)rightLoF; rRawHi = (double)rightHiF;
                if (!ChartOption.IsAutoD(y1.minD) && !ChartOption.IsAutoD(y1.maxD)) {
                    rightLo = rightLoF / 1000;
                    rightHi = rightHiF / 1000;
                    rt = y1.ticks < 1 ? 5 : y1.ticks;
                } else {
                    double rmn = ChartOption.IsAutoD(y1.minInterval)
                        ? ChartOption.AutoD() : y1.minInterval * 1000.0;
                    double rmx = ChartOption.IsAutoD(y1.maxInterval)
                        ? ChartOption.AutoD() : y1.maxInterval * 1000.0;
                    ChartSpan rs2 = Chart.ClampNiceRange(rightLoF, rightHiF, y1.scale, rmn, rmx);
                    rightLoF = rs2.lo;
                    rightHiF = rs2.hi;
                    rt = rs2.ticks;
                }
                rightLo = rightLoF / 1000;
                rightHi = rightHiF / 1000;
            }
        }
        // 对数轴：仅正值，钳制下界到 ≥1（log10 对 ≤0 无定义）。
        bool leftLog = y0.type == ChartAxisType.Log;
        bool rightLog = hasRight && y1.type == ChartAxisType.Log;
        // 自动量程走 ECharts nice 步长（-76..15 → -80..20，
        // 0..1320 → 0..1400），刻度数随步长；固定 min/max 尊重不取整。
        if (!leftLog && !leftFrac && y0.type == ChartAxisType.Value
            && y0.min == ChartOption.Auto() && y0.max == ChartOption.Auto()
            && !y0.minDataB && !y0.maxDataB
            && (leftDataMax < 0 || y0.scale)) {
            // nice 输入取**原始域**：AxisLo/AxisHi 的 NiceMin/NiceMax
            // 预整是 ECharts 老管道，会先把 -499..283 抹成
            // -500..500、丢掉官方步长判定（SSR 实测 nice(1564/5)
            // 落 3 档 = 300，nice(1000/5) 落 2 档 = 200）。官方流程
            // 是原始域 → fixExtentWithBoundaryGap → niceExtent。
            int nLo = rawLo;
            int nHi = lData;
            if (y0.bgLoF != 0 || y0.bgHiF != 0) {
                long spanBg = (long)nHi - (long)nLo;
                if (spanBg > 0) {
                    nLo = (int)((long)nLo - spanBg * y0.bgLoF / 1000);
                    nHi = (int)((long)nHi + spanBg * y0.bgHiF / 1000);
                }
            }
            lRawLo = (double)nLo;
            lRawHi = (double)nHi;
            ChartSpan ls = Chart.NiceSpan6((int)lRawLo, (int)lRawHi,
                y0.minInterval, y0.maxInterval);
            leftLo = ls.lo;
            leftHi = ls.hi;
            ticks = ls.ticks;
            rt = ticks;
        }
        if (leftLog) {
            // 官方 LogScale.getExtent：域对齐十进位（数据 1..2000 →
            // 1..10000），不是线性 nice 也不是 1 的钳制。
            leftLo = Chart.LogFloorI(leftLo);
            leftHi = Chart.LogCeilI(leftHi);
            if (leftHi <= leftLo) { leftHi = leftLo * 10; }
        }
        // A15：断轴量程另走 BrkNiceExtent（elapsed 跨度定 interval、
        // 域向外扩到整数倍）。普通 nice 的 1/2/5 十档与官方断轴的
        // 1/2/3/5/10 档不同，bar-breaks-simple 会得到 4000000 上界
        // 而官方是 3108000。
        double brkIvL = 0.0;
        if (!leftLog && !leftFrac && y0.type == ChartAxisType.Value
            && y0.breaks != null && y0.breaks.Count > 0) {
            double rlo = (double)Chart.AxisMinFor(series, 0, zI0, zI1, y0.scale);
            if (y0.minDataB) { rlo = (double)Chart.AxisMinFor(series, 0, zI0, zI1, true); }
            else if (y0.min != ChartOption.Auto()) { rlo = (double)y0.min; }
            double rhi = (double)lData;
            if (y0.maxDataB) { rhi = (double)Chart.AxisMaxFor(series, 0, zI0, zI1, true); }
            else if (y0.max != ChartOption.Auto()) { rhi = (double)y0.max; }
            for (int bi = 0; bi < y0.breaks.Count; bi = bi + 1) {
                if (y0.breaks[bi].endD > rhi) { rhi = y0.breaks[bi].endD; }
            }
            List<double> nb = Chart.BrkNiceExtent(y0.breaks, rlo, rhi, y0.ticks);
            leftLo = (int)nb[0];
            leftHi = (int)nb[1];
            brkIvL = nb[2];
        }
        if (rightLog) {
            if (rightLo < 1) { rightLo = 1; }
            if (rightHi < rightLo + 1) { rightHi = rightLo + 1; }
        } else if (hasRight && !rightFrac && y1.type == ChartAxisType.Value
            && y1.min == ChartOption.Auto() && y1.max == ChartOption.Auto()
            && !y1.minDataB && !y1.maxDataB
            && (rightDataMax < 0 || y1.scale)) {
            rRawLo = (double)Chart.AxisMinFor(series, 1, zI0, zI1, y1.scale);
            rRawHi = (double)Chart.AxisMaxFor(series, 1, zI0, zI1, y1.scale);
            ChartSpan rs = Chart.ClampNiceRange((int)rRawLo, (int)rRawHi, y1.scale,
                y1.minInterval, y1.maxInterval);
            rightLo = rs.lo;
            rightHi = rs.hi;
            rt = rs.ticks;
        }
        // A15：右轴断轴量程（同左轴）。
        double brkIvR = 0.0;
        if (hasRight && !rightLog && !rightFrac && y1.type == ChartAxisType.Value
            && y1.breaks != null && y1.breaks.Count > 0) {
            double rrlo = (double)Chart.AxisMinFor(series, 1, zI0, zI1, y1.scale);
            if (y1.min != ChartOption.Auto()) { rrlo = (double)y1.min; }
            double rrhi = (double)Chart.AxisMaxFor(series, 1, zI0, zI1, y1.scale);
            if (y1.max != ChartOption.Auto()) { rrhi = (double)y1.max; }
            for (int bi = 0; bi < y1.breaks.Count; bi = bi + 1) {
                if (y1.breaks[bi].endD > rrhi) { rrhi = y1.breaks[bi].endD; }
            }
            List<double> nb2 = Chart.BrkNiceExtent(y1.breaks, rrlo, rrhi, y1.ticks);
            rightLo = (int)nb2[0];
            rightHi = (int)nb2[1];
            brkIvR = nb2[2];
        }
        // 只在左/右两条**数值轴**之间做：Grid.ts:738-756 逆序扫描
        // 挑 alignTo（不要求对齐的最后一条）；两槽都要求则取 y0。
        // 本引擎只有左/右两槽，第 3 条以上的 y 轴不参与对齐（记债）。
        if (hasRight && !leftLog && !rightLog
            && y0.type == ChartAxisType.Value && y1.type == ChartAxisType.Value
            && (y0.alignTicks || y1.alignTicks)) {
            // 只 y1 要求：把右轴对齐到左轴；
            // 只 y0 要求：把左轴对齐到右轴。
            bool alignRight = y1.alignTicks;
            int segs = alignRight ? ticks : rt;
            if (segs < 1) { segs = 1; }
            if (alignRight) {
                ChartSpan ar = Chart.AlignRange(rRawLo, rRawHi, segs, !y1.scale);
                if (rightFrac) { rightLoF = ar.lo; rightHiF = ar.hi; rightLo = rightLoF / 1000; rightHi = rightHiF / 1000; }
                else { rightLo = ar.lo; rightHi = ar.hi; }
                rt = ar.ticks;
            } else {
                ChartSpan al = Chart.AlignRange(lRawLo, lRawHi, segs, !y0.scale);
                if (leftFrac) { leftLoF = al.lo; leftHiF = al.hi; leftLo = leftLoF / 1000; leftHi = leftHiF / 1000; }
                else { leftLo = al.lo; leftHi = al.hi; }
                ticks = al.ticks;
            }
        }
        // 时间 X 轴：显式 min/max 优先；否则时间域取全部可见系列
        // 时间点（points.x，epoch 天）在 dataZoom 窗口内的 min/max
        // ——窗口化与渲染器的 [i0,i1] 同一语义（官方 area-time-axis
        // start/end 20% 即放大到首段）。此前一律 0..labels-1 整数
        // 天数域，epoch/日期串数据没有落点路径。无时间点的旧整数
        // 天数形态保持原域。
        bool isTime = x0.type == ChartAxisType.Time;
        int tMin = x0.min;
        int tMax = x0.max;
        if (isTime) {
            int fullN = 0;
            for (int fni = 0; fni < series.Count; fni = fni + 1) {
                if (!series[fni].hidden && series[fni].points.Count > fullN) {
                    fullN = series[fni].points.Count;
                }
            }
            int w0 = 0;
            int w1 = fullN - 1;
            if (o.zoom && o.iwid != 0 && fullN > 1) {
                w0 = Chart.ZoomI0(app, o, o.iwid, fullN);
                w1 = Chart.ZoomI1(app, o, o.iwid, fullN);
            }
            int dMin = 0;
            int dMax = 0;
            bool have = false;
            for (int tsi = 0; tsi < series.Count; tsi = tsi + 1) {
                ChartSeries tss = series[tsi];
                if (tss.hidden) { continue; }
                int pcnt = tss.points.Count;
                if (pcnt > w1 + 1) { pcnt = w1 + 1; }
                for (int tpi = w0; tpi < pcnt; tpi = tpi + 1) {
                    // points.x 是 epoch 天 × pointG 的定点值（值对/时间
                    // 系列 pointG=1000），时间域是**裸天**整数：不除回
                    // 会得到 1000× 的天数，TimeLabel 再按天解释就跳回
                    // 1961 年（area-time-axis 比例坏掉的根因）。
                    int tx = Chart.PointV(tss.points[tpi].x, tss.pointG);
                    if (!have || tx < dMin) { dMin = tx; }
                    if (!have || tx > dMax) { dMax = tx; }
                    have = true;
                }
            }
            if (have) {
                if (tMin == ChartOption.Auto()) { tMin = dMin; }
                if (tMax == ChartOption.Auto()) { tMax = dMax; }
                if (tMax <= tMin) { tMax = tMin + 1; }
            }
        }
        if (tMin == ChartOption.Auto()) { tMin = 0; }
        if (tMax == ChartOption.Auto()) {
            tMax = labels.Count - 1;
            if (tMax < tMin + 1) { tMax = tMin + 1; }
        }

        // 轴互换（ECharts yAxis category + xAxis value）与值对折线：
        // X 变成数值轴，范围从 x0.min/max 或数据推导。
        bool catY = y0.type == ChartAxisType.Category;
        bool xValue = catY || x0.type == ChartAxisType.Value;
        int xLo = 0;
        int xHi = 100;
        int xt = ticks;
        if (xValue) {
            // 自动量程走 ECharts nice 步长（气温 -76..15 →
            // -80..20 步长 20）；固定 min/max 尊重不取整。
            if (x0.min != ChartOption.Auto() || x0.max != ChartOption.Auto()) {
                xLo = x0.min;
                if (xLo == ChartOption.Auto()) { xLo = Chart.XMinFor(series, catY, x0.scale); }
                xHi = x0.max;
                if (xHi == ChartOption.Auto()) { xHi = Chart.XMaxFor(series, catY, x0.scale); }
                if (xHi <= xLo) { xHi = xLo + 1; }
            } else {
                // A11：minInterval/maxInterval 同样作用于 X 数值轴
                // （axisNiceTicks.ts:263-264 的 isIntervalOrTime 不分轴）。
                ChartSpan xsp = Chart.ClampNiceRange(
                    Chart.XMinFor(series, catY, x0.scale),
                    Chart.XMaxFor(series, catY, x0.scale), x0.scale,
                    x0.minInterval, x0.maxInterval);
                xLo = xsp.lo;
                xHi = xsp.hi;
                xt = xsp.ticks;
            }
        }

        // ---- axisLine 解算（Grid.ts:614-717 fixAxisOnZero +
        // cartesianAxisHelper.ts axisLineAutoShow）----
        // 骑线：x 轴先挑目标（候选按 y 轴序），y 轴后挑；目标被认领
        // 后不再复用（双 y 轴都够得着 x0 时 y0 赢、y1 留在原位——
        // _scratch/chart_oracle/onzero_multi.js 实测）。TARGET 必须是
        // value/log 且 0 不在域外（EDGE 也算）。像素在 plot 矩形
        // （含 markPad 外扩）定下后再落，这里只定「骑不骑」。
        bool x0RidesY0 = Chart.CanOnZeroTo(y0, leftLo, leftHi, x0.onZero);
        bool x0RidesY1 = false;
        if (!x0RidesY0 && hasRight && o.yAxes.Count > 1) {
            x0RidesY1 = Chart.CanOnZeroTo(y1, rightLo, rightHi, x0.onZero);
        }
        bool y0RidesX0 = Chart.CanOnZeroTo(x0, xLo, xHi, y0.onZero);
        bool y1RidesX0 = false;
        if (!y0RidesX0 && hasRight && o.yAxes.Count > 1) {
            y1RidesX0 = Chart.CanOnZeroTo(x0, xLo, xHi, y1.onZero);
        }
        // axisLine.show 三态：'auto' 只画「对侧是 value/log」的轴
        // （isIntervalOrLogScale；time 不算）。类目轴缺省恒画、
        // value/time/log 缺省 'auto'——标准柱/线图从此只画底部一
        // 根线，与官方 SSR 逐一致（axisline.scan.txt 69/15 清单）。
        bool x0IsVL = x0.type == ChartAxisType.Value
            || x0.type == ChartAxisType.Log;
        bool y0IsVL = y0.type == ChartAxisType.Value
            || y0.type == ChartAxisType.Log;
        bool y0Line = y0.show && Chart.AxisLineDraws(y0.axisLineShow, x0IsVL);
        bool x0Line = x0.show && Chart.AxisLineDraws(x0.axisLineShow, y0IsVL);
        bool y1Line = hasRight && y1.show
            && Chart.AxisLineDraws(y1.axisLineShow, x0IsVL);

        // containLabel/outerBounds 用的纯标签宽（官方 labelUnionRect：
        // 只量文本盒，不加 padding）。
        int yLblRaw = 0;
        int leftGut;
        if (catY && y0.categories.Count > 0) {
            // 类目 Y：左栏取最宽类目标签（含 formatter 展开）。
            int mw = 0;
            for (int cgi = 0; cgi < y0.categories.Count; cgi = cgi + 1) {
                string cgl = y0.categories[cgi];
                if (y0.labelFormatter.Length > 0) { cgl = y0.labelFormatter.Replace("{value}", cgl); }
                int wgi = Canvas.MeasureText(cgl, fs);
                if (wgi > mw) { mw = wgi; }
            }
            yLblRaw = mw;
            leftGut = mw + app.Scale(12) + app.Scale(y0.labelMargin);
        } else {
            yLblRaw = Chart.TickLabelW(leftLo, leftHi, ticks, fs);
            leftGut = Chart.TickLabelW(leftLo, leftHi, ticks, fs) + app.Scale(12) + app.Scale(y0.labelMargin);
            if (leftFrac) {
                // 小数轴标签（"0.5"）比整数影子值（"0"）宽，按定点
                // 域重估最宽刻度文本。
                int fw = Chart.TickLabelWF(leftLoF, leftHiF, ticks, fs);
                if (fw > leftGut) { leftGut = fw + app.Scale(12) + app.Scale(y0.labelMargin); }
                if (fw > yLblRaw) { yLblRaw = fw; }
            }
            if (y0.labelFormatter.Length > 0) {
                int fx = Chart.FormatterExtraW(y0.labelFormatter, leftHi, fs);
                leftGut = leftGut + fx;
                yLblRaw = yLblRaw + fx;
            }
        }
        if (y0.labelInside || !y0.labelShow) {
            leftGut = pad;
        }
        if (y0.offset != 0) {
            leftGut = leftGut + app.Scale(y0.offset);
        }
        int rightGut = pad + app.Scale(y1.labelMargin);
        if (hasRight) {
            if (y1.labelInside || !y1.labelShow) {
                rightGut = pad;
            } else {
                rightGut = Chart.TickLabelW(rightLo, rightHi, rt, fs) + app.Scale(12) + app.Scale(y1.labelMargin);
                if (rightFrac) {
                    int rw = Chart.TickLabelWF(rightLoF, rightHiF, rt, fs) + app.Scale(12) + app.Scale(y1.labelMargin);
                    if (rw > rightGut) { rightGut = rw; }
                }
            }
            if (y1.offset != 0) {
                rightGut = rightGut + app.Scale(y1.offset);
            }
        }
        int botGut = fh + app.Scale(12) + app.Scale(x0.labelMargin);
        if (x0.labelInside || !x0.labelShow) {
            botGut = pad;
        }
        // x 轴名的垂直落点随 nameLocation 变（AxisNamePos）：end/middle 在
        // 轴线下方（middle 再多一整个 gap）、start 骑在轴线上。量出名字
        // 盒底相对"轴线 + 半个行高"多出来的部分补进底栏，否则名字压住
        // 刻度标签。start 态盒底高于轴线下缘，不补。
        // onZero 骑线时例外：end/start 名字贴轴线走进绘图区（middle
        // 留在边界），底部不再需要让位——官方网格从不为轴名留白。
        if (x0.title.Length > 0 && x0.show && !(x0RidesY0 || x0RidesY1)) {
            int xTw = Canvas.MeasureText(x0.title, fs);
            ChartNameBox xb = Chart.AxisNameBoxPx(x0, true, 0, 0, 100, 100,
                false, Chart.NameGapPx(app, x0), fh, Canvas.CenterTextYAt(0, fs),
                xTw, 0 - 1);
            int below = xb.bottom - (fh + fh / 2);
            if (below > 0) { botGut = botGut + below; }
        }
        if (xValue) { botGut = botGut + fh + app.Scale(2); }
        // 旋转分类标签：按最宽标签的旋转后垂直跨度扩底栏（未旋转
        // 与旋转都成立——interval>=0 抽稀时贪心不再兜底防重叠）。
        if (x0.labelRotate != 0 && labels.Count > 0) {
            int rotMaxW = 0;
            for (int ri = 0; ri < labels.Count; ri = ri + 1) {
                int rwi = Canvas.MeasureText(labels[ri], fs);
                if (rwi > rotMaxW) { rotMaxW = rwi; }
            }
            int need = Chart.RotatedLabelH(rotMaxW, fh, x0.labelRotate) + app.Scale(4);
            int baseNeed = fh + app.Scale(12);
            if (need > baseNeed) {
                botGut = botGut - baseNeed + need;
            }
        }

        // ---- A16 绘图矩形：ECharts Grid.resize 首遍
        // getLayoutRect(getBoxLayoutParams())，矩形只由声明的
        // center/middle/bottom/... 专名语义、width/height 优先锚
        // 定）。官方网格从不为轴标签/轴名/图例留白——标签溢出由
        // containLabel / outerBounds 的第二遍收缩处理，图例在
        // 官方是独立组件浮在画布上、根本不改 grid 矩形。
        ChartLayoutRect gr = ChartGeometry.GridRawRect(
            o.gridLeftRaw, o.gridRightRaw, o.gridTopRaw, o.gridBottomRaw,
            o.gridWidthRaw, o.gridHeightRaw, (double)w, (double)h, false);
        int plotX = x + (int)Math.Round(gr.x);
        int plotY = y + (int)Math.Round(gr.y);
        int plotW = (int)Math.Round(gr.width);
        int plotH = (int)Math.Round(gr.height);
        // 右/下缘的命名副本：BuildAxesR 里的右轴标签/底行沿用旧变量。
        int plotRight = plotX + plotW;
        int plotBot = plotY + plotH;
        // containLabel：legacyContainLabel.ts 语义——x 轴（水平，
        // bottom 侧）从高度里扣「标签并集高 + margin」并把 y 下推；
        // y 轴（left 侧）从宽度里扣「标签并集宽 + margin」并把 x
        // 右推。标签并集用与绘制同一套度量（最宽刻度文本 / 行高）。
        if (o.containLabel) {
            // estimateLabelUnionRect（legacyContainLabel.ts）：逐
            // 标签 getTextRect 取并集——y 轴 = 最宽文本盒宽，x 轴 =
            // 文本盒高（官方 12px 文本盒高 12，不是行盒 fh；fallback
            // 度量下 equal font-size）。旋转取旋转后外接盒。
            // axisLabel.fontSize 声明时并集高随字号（bump-chart 16）。
            int xLblH = x0.labelFontSize > 0 ? app.Scale(x0.labelFontSize)
                : (x0.labelSt != null && x0.labelSt.fontSize > 0
                    ? app.Scale(x0.labelSt.fontSize) : app.Scale(12));
            if (x0.labelRotate != 0 && labels.Count > 0) {
                int rotMaxW2 = 0;
                for (int ri2 = 0; ri2 < labels.Count; ri2 = ri2 + 1) {
                    int rwi2 = Canvas.MeasureText(labels[ri2], fs);
                    if (rwi2 > rotMaxW2) { rotMaxW2 = rwi2; }
                }
                rotMaxW2 = Chart.RotatedLabelH(rotMaxW2, app.Scale(12), x0.labelRotate);
                if (rotMaxW2 > xLblH) { xLblH = rotMaxW2; }
            }
            // axisLabel.margin 官方缺省 8（zan 缺省 0 是画距语义）。
            int margin = app.Scale(x0.labelMargin > 0 ? x0.labelMargin : 8);
            int yMargin = app.Scale(y0.labelMargin > 0 ? y0.labelMargin : 8);
            // x 轴（bottom 侧）只缩高度；y 轴（left 侧）缩宽并把 x
            // 右推。y 下移仅发生在 x 轴 position top（语料无）。
            if (x0.show && x0.labelShow) { plotH = plotH - xLblH - margin; }
            if (y0.show && yLblRaw > 0) {
                plotW = plotW - yLblRaw - yMargin;
                plotX = plotX + yLblRaw + yMargin;
            }
        }
        // outerBounds（Grid.ts prepareOuterBounds 'auto'，缺省即跑）：外接矩形
        // 走 getLayoutRect 且缺省四边 0 = 整个容器。layOutGridBy
        // OuterBounds：先估轴标签/轴名盒，凡越过外接边界的溢出量
        // （shrink，noNegative，钳 25%/25% 尺寸）。语料覆盖四类：
        // - y 标签左溢（grid left 0/2px）：mLeft = 标签左缘溢出；
        // - x 轴名 end 态右溢（boxplot-light-velocity2）：mRight；
        // - 外接声明 top/bottom 时标签上下溢出（intraday-breaks-1）。
        if (o.obDeclared && !o.containLabel) {
        ChartLayoutRect ob = ChartGeometry.GridRawRect(
            o.obLeftRaw, o.obRightRaw, o.obTopRaw, o.obBottomRaw,
            null, null, (double)w, (double)h, true);
        double mTop = 0.0;
        double mRight = 0.0;
        double mBottom = 0.0;
        double mLeft = 0.0;
        // 标签盒：官方 labelInfoList.rect（文本盒 + margin 8 的落位）。
        // y 轴标签行盒：右缘贴 plotX - margin，左缘 = 右缘 - 文本宽。
        if (y0.show && yLblRaw > 0) {
            double lblRight = plotX - app.Scale(y0.labelMargin > 0 ? y0.labelMargin : 8);
            double lblLeft = lblRight - yLblRaw;
            mLeft = Math.Max(mLeft, ob.x - lblLeft);
        }
        // 顶/底溢出（x 维标签与 x 轴名）。x 标签行盒：顶 = plot 底
        // + margin，高 = 文本盒高（官方 12px → 12）。
        if (x0.show) {
            double lblH = app.Scale(12);
            double lblTop = plotY + plotH + app.Scale(x0.labelMargin > 0 ? x0.labelMargin : 8);
            mBottom = Math.Max(mBottom, lblTop + lblH - (ob.y + ob.height));
            // 最顶 y 标签垂直居中于绘图区顶边：盒顶 = plotY - h/2。
            if (y0.show) {
                mTop = Math.Max(mTop, ob.y - (plotY - lblH / 2.0));
            }
        }
        // x 轴名 end 态：名字盒在轴右端外（AxisNameBoxPx anchor 0）。
        if (x0.title.Length > 0 && x0.show && x0.nameLocation != "middle") {
            int xTw = Canvas.MeasureText(x0.title, fs);
            ChartNameBox xb = Chart.AxisNameBoxPx(x0, true, plotX, plotY,
                plotW, plotH, false, Chart.NameGapPx(app, x0), fh,
                Canvas.CenterTextYAt(0, fs), xTw, 0 - 1);
            mRight = Math.Max(mRight, xb.right - (ob.x + ob.width));
            mBottom = Math.Max(mBottom, (double)(xb.bottom - (ob.y + ob.height)));
        }
        // y 轴名 end/start 态在绘图区上/下方溢出（intraday 类）。
        if (y0.title.Length > 0 && y0.show) {
            ChartNameBox yb = Chart.AxisNameBoxPx(y0, false, plotX, plotY,
                plotW, plotH, false, Chart.NameGapPx(app, y0), fh,
                Canvas.CenterTextYAt(0, fs), 0, 0 - 1);
            mTop = Math.Max(mTop, (double)(ob.y - yb.top));
        }
        ChartGeometry.GridShrinkRect(gr, mTop, mRight, mBottom, mLeft,
            gr.width * 0.25, gr.height * 0.25);
        plotX = x + (int)Math.Round(gr.x);
        plotY = y + (int)Math.Round(gr.y);
        plotW = (int)Math.Round(gr.width);
        plotH = (int)Math.Round(gr.height);
        if (plotW < app.Scale(20)) { plotW = app.Scale(20); }
        }
        if (plotH < app.Scale(20)) { plotH = app.Scale(20); }

        // 极值贴边留出约半个徽标高度：数据最值逼近 nice 端点时
        // 映射范围向外扩，顶点符号与 min/max 徽标不再被绘图区
        // 裁切；网格/刻度仍取 nice 端点（Tick 副本），端格线悬在
        // 绘图区内侧。0 基线不外扩——面积/柱的填充锚在零线。
        // ECharts 本身从不外扩：只有真的要画 markPoint 徽标
        // （o.markPoint 或显式 marks）才留白，否则 line5 这类
        // 无标注图的量程与原版对不齐。
        bool anyYMark0 = false;
        bool anyYMark1 = false;
        bool anyXMark = false;
        for (int msc = 0; msc < series.Count; msc = msc + 1) {
            ChartSeries msp = series[msc];
            if (msp.hidden) { continue; }
            if (!(o.markPoint || msp.marks.Count > 0)) { continue; }
            if (msp.axisIndex == 1) { anyYMark1 = true; } else { anyYMark0 = true; }
            for (int mkc = 0; mkc < msp.marks.Count; mkc = mkc + 1) {
                if (msp.marks[mkc].valueIndex == 0) { anyXMark = true; }
            }
        }
        int pxPad = app.Scale(16);
        int leftTickLo = leftLo;
        int leftTickHi = leftHi;
        if (anyYMark0 && !leftLog && y0.min == ChartOption.Auto()
            && y0.max == ChartOption.Auto()
            && !y0.minDataB && !y0.maxDataB) {
            int lpad = ((leftHi - leftLo) * pxPad + plotH - 1) / plotH;
            int lDataMin = Chart.AxisMinFor(series, 0, zI0, zI1, y0.scale);
            if (lpad > 0) {
                if (leftHi - lData < lpad) { leftHi = lData + lpad; }
                if (leftLo != 0 && lDataMin > leftLo
                    && lDataMin - leftLo < lpad) {
                    leftLo = lDataMin - lpad;
                }
            }
        }
        int rightTickLo = rightLo;
        int rightTickHi = rightHi;
        if (anyYMark1 && hasRight && !rightLog && y1.min == ChartOption.Auto()
            && y1.max == ChartOption.Auto()) {
            int rpad = ((rightHi - rightLo) * pxPad + plotH - 1) / plotH;
            int rDataMax = rightDataMax;
            if (rDataMax < 0) { rDataMax = Chart.AxisMaxFor(series, 1, zI0, zI1, y1.scale); }
            int rDataMin = Chart.AxisMinFor(series, 1, zI0, zI1, y1.scale);
            if (rpad > 0) {
                if (rightHi - rDataMax < rpad) { rightHi = rDataMax + rpad; }
                if (rightLo != 0 && rDataMin > rightLo
                    && rDataMin - rightLo < rpad) {
                    rightLo = rDataMin - rpad;
                }
            }
        }
        int xTickLo = xLo;
        int xTickHi = xHi;
        if (anyXMark && xValue && !isTime && x0.min == ChartOption.Auto()
            && x0.max == ChartOption.Auto()) {
            int xpad = ((xHi - xLo) * pxPad + plotW - 1) / plotW;
            int xDataMin = Chart.XMinFor(series, catY, x0.scale);
            int xDataMax = Chart.XMaxFor(series, catY, x0.scale);
            if (xpad > 0) {
                if (xHi - xDataMax < xpad) { xHi = xDataMax + xpad; }
                if (xLo != 0 && xDataMin > xLo && xDataMin - xLo < xpad) {
                    xLo = xDataMin - xpad;
                }
                if (xHi <= xLo) { xHi = xLo + 1; }
            }
        }

        ChartFrame f = new ChartFrame();
        // ---- A15 断轴 gapReal 解算 + 挂框 ----
        // 量程（含 nice 与 markPad 外扩）定型后解：占比断带按
        // G = P·S/(1-P) 分摊（S = 最终外层跨度 − Σ断带跨度）；
        // 只挂与最终界相交的断带。X 数值/时间轴同式。
        if (y0.breaks != null && y0.breaks.Count > 0 && !leftFrac) {
            List<ChartBreak> act = new List<ChartBreak>();
            for (int bi = 0; bi < y0.breaks.Count; bi = bi + 1) {
                ChartBreak b = y0.breaks[bi];
                if (Chart.BrkActive(b, (double)leftLo, (double)leftHi)) { act.Add(b); }
            }
            if (act.Count > 0) {
                f.brkL = act;
                f.brkIvL = brkIvL;
                f.brkGapL = Chart.BrkGapReals(act, (double)leftLo, (double)leftHi);
                f.resolvedBrkL = new List<ChartBreakResolved>();
                for (int bi = 0; bi < act.Count; bi = bi + 1) {
                    f.resolvedBrkL.Add(new ChartBreakResolved(act[bi], f.brkGapL[bi]));
                }
                double sp = (double)(leftHi - leftLo);
                double bsp = 0.0;
                for (int bi = 0; bi < act.Count; bi = bi + 1) {
                    bsp = bsp + (act[bi].endD - act[bi].startD);
                }
                double gs = 0.0;
                for (int bi = 0; bi < f.brkGapL.Count; bi = bi + 1) { gs = gs + f.brkGapL[bi]; }
                f.brkSpanL = sp - bsp + gs;
                if (f.brkSpanL < 1.0) { f.brkSpanL = 1.0; }
            }
        }
        if (hasRight && y1.breaks != null && y1.breaks.Count > 0 && !rightFrac) {
            List<ChartBreak> act2 = new List<ChartBreak>();
            for (int bi = 0; bi < y1.breaks.Count; bi = bi + 1) {
                ChartBreak b2 = y1.breaks[bi];
                if (Chart.BrkActive(b2, (double)rightLo, (double)rightHi)) { act2.Add(b2); }
            }
            if (act2.Count > 0) {
                f.brkR = act2;
                f.brkIvR = brkIvR;
                f.brkGapR = Chart.BrkGapReals(act2, (double)rightLo, (double)rightHi);
                f.resolvedBrkR = new List<ChartBreakResolved>();
                for (int bi = 0; bi < act2.Count; bi = bi + 1) {
                    f.resolvedBrkR.Add(new ChartBreakResolved(act2[bi], f.brkGapR[bi]));
                }
                double sp2 = (double)(rightHi - rightLo);
                double bsp2 = 0.0;
                for (int bi = 0; bi < act2.Count; bi = bi + 1) {
                    bsp2 = bsp2 + (act2[bi].endD - act2[bi].startD);
                }
                double gs2 = 0.0;
                for (int bi = 0; bi < f.brkGapR.Count; bi = bi + 1) { gs2 = gs2 + f.brkGapR[bi]; }
                f.brkSpanR = sp2 - bsp2 + gs2;
                if (f.brkSpanR < 1.0) { f.brkSpanR = 1.0; }
            }
        }
        if (!isTime && x0.breaks != null && x0.breaks.Count > 0 && !catY) {
            List<ChartBreak> act3 = new List<ChartBreak>();
            for (int bi = 0; bi < x0.breaks.Count; bi = bi + 1) {
                ChartBreak b3 = x0.breaks[bi];
                if (Chart.BrkActive(b3, (double)xLo, (double)xHi)) { act3.Add(b3); }
            }
            if (act3.Count > 0) {
                f.brkX = act3;
                f.brkGapX = Chart.BrkGapReals(act3, (double)xLo, (double)xHi);
                f.resolvedBrkX = new List<ChartBreakResolved>();
                for (int bi = 0; bi < act3.Count; bi = bi + 1) {
                    f.resolvedBrkX.Add(new ChartBreakResolved(act3[bi], f.brkGapX[bi]));
                }
                double sp3 = (double)(xHi - xLo);
                double bsp3 = 0.0;
                for (int bi = 0; bi < act3.Count; bi = bi + 1) {
                    bsp3 = bsp3 + (act3[bi].endD - act3[bi].startD);
                }
                double gs3 = 0.0;
                for (int bi = 0; bi < f.brkGapX.Count; bi = bi + 1) { gs3 = gs3 + f.brkGapX[bi]; }
                f.brkSpanX = sp3 - bsp3 + gs3;
                if (f.brkSpanX < 1.0) { f.brkSpanX = 1.0; }
            }
        } else if (isTime && x0.breaks != null && x0.breaks.Count > 0) {
            // 时间轴断带：breaks.startD/endD（epoch 毫秒）与帧的
            // timeMin/timeMax 同空间直接比较。
            List<ChartBreak> act4 = new List<ChartBreak>();
            double tLo = (double)tMin;
            double tHi = (double)tMax;
            for (int bi = 0; bi < x0.breaks.Count; bi = bi + 1) {
                ChartBreak b4 = x0.breaks[bi];
                if (Chart.BrkActive(b4, tLo, tHi)) { act4.Add(b4); }
            }
            if (act4.Count > 0) {
                f.brkX = act4;
                f.brkGapX = Chart.BrkGapReals(act4, tLo, tHi);
                f.resolvedBrkX = new List<ChartBreakResolved>();
                for (int bi = 0; bi < act4.Count; bi = bi + 1) {
                    f.resolvedBrkX.Add(new ChartBreakResolved(act4[bi], f.brkGapX[bi]));
                }
                double sp4 = tHi - tLo;
                double bsp4 = 0.0;
                for (int bi = 0; bi < act4.Count; bi = bi + 1) {
                    bsp4 = bsp4 + (act4[bi].endD - act4[bi].startD);
                }
                double gs4 = 0.0;
                for (int bi = 0; bi < f.brkGapX.Count; bi = bi + 1) { gs4 = gs4 + f.brkGapX[bi]; }
                f.brkSpanX = sp4 - bsp4 + gs4;
                if (f.brkSpanX < 1.0) { f.brkSpanX = 1.0; }
            }
        }

        f.plotX = plotX;
        f.plotY = plotY;
        f.plotW = plotW;
        f.plotH = plotH;
        f.leftMin = leftLo;
        f.leftMax = leftHi;
        f.leftMinF = leftLoF;
        f.leftMaxF = leftHiF;
        f.rightMin = rightLo;
        f.rightMax = rightHi;
        f.rightMinF = rightLoF;
        f.rightMaxF = rightHiF;
        f.hasRight = hasRight;
        f.reversed = y0.reversed;
        f.rightReversed = y1.reversed;
        f.leftLog = leftLog;
        f.rightLog = rightLog;
        f.isTime = isTime;
        f.timeMin = tMin;
        f.timeMax = tMax;
        f.catBoundaryGap = x0.boundaryGap;
        f.catY = catY;
        f.xLo = xLo;
        f.xHi = xHi;
        f.leftNegate = y0.labelNegate;
        f.rightNegate = y1.labelNegate;

        // 网格线 + 左右数值标签（对数轴用 10 的幂刻度）
        StyleBox sGrid = Style.Part(app, "chart", "grid", "", "", "",
                                    Style.SNormal());
        StyleBox sAxis = Style.Part(app, "chart", "axis", "", "", "",
                                    Style.SNormal());
        StyleBox sAxisTitle = Style.Part(app, "chart", "axis-title", "", "",
                                         "", Style.SNormal());
        bool grid = o.showGrid && y0.showGrid;
        // splitLine.lineStyle.color 显式值压过主题网格色（轴上未声明
        // splitColor=0 时随皮肤 chart::grid，6.1 官方缺省 #dbdee4）。
        int gridColY = y0.splitColor != 0 ? y0.splitColor : sGrid.BgOr(0);
        int gridColX = x0.splitColor != 0 ? x0.splitColor : sGrid.BgOr(0);
        // axisLabel.margin：标签与轴线的像素距离（官方缺省 8）。此前
        // 写死 6/4，bump-chart 声明的 30 从未生效，左轴数字被 r=10
        // 的拐点符号圈盖住只剩 "#"。
        int yMargL = app.Scale(y0.labelMargin > 0 ? y0.labelMargin : 8);
        int yMargR = app.Scale(y1.labelMargin > 0 ? y1.labelMargin : 8);
        int xMarg = app.Scale(x0.labelMargin > 0 ? x0.labelMargin : 8);
        // ECharts axis.show：false 时整条轴（线/刻度/标签）不画，
        // 网格线仍随 splitLine 语义保留。
        bool y0Show = y0.show;
        bool x0Show = x0.show;
        // ECharts splitArea.show：相邻刻度交替底纹。数值轴默认关，
        // 引擎字段随现代标准默认 false，按轴显式配置打开。
        // 对白底取 3%/5.5% 黑的 alpha 叠加，视觉即参照站的
        // #F7F7F7/#F2F2F2。类目 Y（轴互换）与对数轴不画。
        if (grid && y0.splitArea && !catY && !leftLog
            && y0.type == ChartAxisType.Value
            && plotW > 0 && plotH > 0) {
            int sSpan = leftTickHi - leftTickLo;
            for (int sk = 0; sk < ticks; sk = sk + 1) {
                int sLo = leftTickLo + sSpan * sk / ticks;
                int sHi = leftTickLo + sSpan * (sk + 1) / ticks;
                int syTop = f.YOf(sHi, 0);
                int syBot = f.YOf(sLo, 0);
                if (syBot <= syTop) { continue; }
                c.FillRect(plotX, syTop, plotW, syBot - syTop,
                    sk % 2 == 0 ? 0x08000000 : 0x0E000000);
            }
        }
        // 薄面板（多 grid 成交量条带这类）：刻度行距小于一行字高
        // 时标签隔行画（网格线照画），避免上下叠字糊成一团。
        int yLblStep = 1;
        if (plotH < (ticks + 1) * (fh + app.Scale(4))) { yLblStep = 2; }
        int y0Col = y0.labelColor != 0 ? y0.labelColor : sAxis.FgOr(0);
        int xLineY = plotY + plotH;
        if (x0RidesY0) { xLineY = f.ZeroLineY(0); }
        else if (x0RidesY1) { xLineY = f.ZeroLineY(1); }
        int yLineX = plotX;
        if (y0.offset != 0) { yLineX = y0.position == "right" ? plotX + plotW + app.Scale(y0.offset) : plotX - app.Scale(y0.offset); }
        else if (y0RidesX0) { yLineX = f.ZeroLineX(); }
        int y1LineX = plotX + plotW;
        if (y1.offset != 0) { y1LineX = plotX + plotW + app.Scale(y1.offset); }
        else if (y1RidesX0) { y1LineX = f.ZeroLineX(); }
        if (catY) {
            // 类目 Y（轴互换）：水平网格线 + 槽中类目标签。
            int cn = y0.categories.Count;
            for (int ci = 0; ci < cn; ci = ci + 1) {
                int gy = f.CatMidY(ci, cn);
                if (grid) { c.FillRect(plotX, gy, plotW, 1, gridColY); }
                if (!y0Show) { continue; }
                string ls = y0.categories[ci];
                if (y0.labelFormatter.Length > 0) { ls = y0.labelFormatter.Replace("{value}", ls); }
                int lw = Canvas.MeasureText(ls, fs);
                int rlx0 = y0.labelInside ? plotX + yMargL : plotX - yMargL - lw;
                c.DrawText(rlx0, Canvas.CenterTextYAt(gy, fs),
                    ls, y0Col, fs);
            }
        } else if (leftLog && leftFrac && (leftLoF != 0 || leftHiF != 0)) {
            // 对数轴（小数域）：十进位枚举（‰ 域 ×10 递进），
            // FracText 出 0.001/0.01/1/10000 这类标签。
            long lvF = leftLoF;
            while (lvF <= leftHiF) {
                int gy = f.YOfLogF(lvF, 0);
                if (grid) { c.FillRect(plotX, gy, plotW, 1, gridColY); }
                if (y0Show) {
                    string ls = Chart.LogFracText(lvF);
                    if (y0.labelFormatter.Length > 0) { ls = y0.labelFormatter.Replace("{value}", ls); }
                    int lw = Canvas.MeasureText(ls, fs);
                    int rlx0 = y0.labelInside ? plotX + yMargL : plotX - yMargL - lw;
                    c.DrawText(rlx0, Canvas.CenterTextYAt(gy, fs),
                        ls, y0Col, fs);
                }
                lvF = lvF * 10L;
            }
        } else if (leftLog) {
            List<int> lts = Chart.LogTicks(leftLo, leftHi);
            for (int li = 0; li < lts.Count; li = li + 1) {
                int lv = lts[li];
                int gy = f.YOfLog(lv, 0);
                if (grid) { c.FillRect(plotX, gy, plotW, 1, gridColY); }
                if (!y0Show) { continue; }
                string ls = Convert.ToString(lv);
                if (leftLog) { ls = Chart.Commas(lv); }
                int lw = Canvas.MeasureText(ls, fs);
                int rlx0 = y0.labelInside ? plotX + yMargL : plotX - yMargL - lw;
                c.DrawText(rlx0, Canvas.CenterTextYAt(gy, fs),
                    ls, y0Col, fs);
            }
        } else if (leftFrac) {
            // 小数轴刻度：×1000 定点域等分，标签 FracText 除回
            // （0..500000 定点 5 段 → 0/100/…/500）。
            int leftSpanF = leftHiF - leftLoF;
            for (int k = 0; k <= ticks; k = k + 1) {
                int lvF = leftLoF + leftSpanF * k / ticks;
                int gy = f.YOfF(lvF, 0);
                if (grid) { c.FillRect(plotX, gy, plotW, 1, gridColY); }
                if (!y0Show || k % yLblStep != 0) { continue; }
                string ls = Chart.FracText(y0.labelNegate ? 0 - lvF : lvF);
                if (y0.labelFormatter.Length > 0) { ls = y0.labelFormatter.Replace("{value}", ls); }
                int lw = Canvas.MeasureText(ls, fs);
                int rlx0 = y0.labelInside ? plotX + yMargL : plotX - yMargL - lw;
                c.DrawText(rlx0, Canvas.CenterTextYAt(gy, fs),
                    ls, y0Col, fs);
            }
        } else {
            // 刻度取 Tick 副本（nice 端点）：映射范围留白外扩后，
            // 网格/标签仍落在整数 nice 值上，端格线悬在绘图区内侧。
            // A15：该轴挂断带时刻度表换成 BrkTicks（区间倍数 + 跳断带 +
            // 断带端点对 + 3/4·interval 剪除），像素走 elapsed 映射；
            // interval 按 elapsed 跨度 / ticks 取整十倍档（nice 的近似，
            // 官方 bar-breaks-simple 得 3000、gap0 demo 得 300 同档）。
            if (f.BrkHas(0)) {
                // interval 优先取量程阶段 BrkNiceExtent 存的 brkIvL；
                // 未存（固定 min/max 等旁路）才按当前 elapsed 跨度现算，
                // 取整档与官方 nice ROUND 一致：1/2/3/5/10（阈值
                // 1.5/2.5/4/7），不是无断轴路径的 1/2/5。
                double iv = f.brkIvL;
                if (iv <= 0.0) {
                    double eLo = Chart.BrkElapsed(f.brkL, f.brkGapL, (double)leftTickLo);
                    double eHi = Chart.BrkElapsed(f.brkL, f.brkGapL, (double)leftTickHi);
                    double eSpan = eHi - eLo;
                    if (eSpan < 1.0) { eSpan = 1.0; }
                    iv = eSpan / (ticks > 0 ? (double)ticks : 5.0);
                    double mag = 1.0;
                    while (mag * 10.0 <= iv) { mag = mag * 10.0; }
                    double m = iv / mag;
                    if (m < 1.5) { iv = mag; }
                    else if (m < 2.5) { iv = 2.0 * mag; }
                    else if (m < 4.0) { iv = 3.0 * mag; }
                    else if (m < 7.0) { iv = 5.0 * mag; }
                    else { iv = 10.0 * mag; }
                    if (iv < 1.0) { iv = 1.0; }
                }
                List<double> bts = Chart.BrkTicks(f.brkL, f.brkGapL,
                    (double)leftTickLo, (double)leftTickHi, iv);
                for (int k = 0; k < bts.Count; k = k + 1) {
                    double lvb = bts[k];
                    int lvi = (int)Math.Round(lvb);
                    int gy = f.YOfBrk(lvb, 0);
                    if (grid) { c.FillRect(plotX, gy, plotW, 1, gridColY); }
                    if (!y0Show) { continue; }
                    string ls = Chart.Commas(y0.labelNegate ? 0 - lvi : lvi);
                    if (y0.labelFormatter.Length > 0) { ls = y0.labelFormatter.Replace("{value}", ls); }
                    int lw = Canvas.MeasureText(ls, fs);
                    int rlx0 = y0.labelInside ? plotX + yMargL : plotX - yMargL - lw;
                    c.DrawText(rlx0, Canvas.CenterTextYAt(gy, fs),
                        ls, y0Col, fs);
                }
            } else {
            int leftSpan = leftTickHi - leftTickLo;
            for (int k = 0; k <= ticks; k = k + 1) {
                int lv = leftTickLo + leftSpan * k / ticks;
                int gy = f.YOf(lv, 0);
                if (grid) { c.FillRect(plotX, gy, plotW, 1, gridColY); }
                if (!y0Show || k % yLblStep != 0) { continue; }
                string ls = Chart.Commas(y0.labelNegate ? 0 - lv : lv);
                if (y0.labelFormatter.Length > 0) { ls = y0.labelFormatter.Replace("{value}", ls); }
                int lw = Canvas.MeasureText(ls, fs);
                int rlx0 = y0.labelInside ? plotX + yMargL : plotX - yMargL - lw;
                c.DrawText(rlx0, Canvas.CenterTextYAt(gy, fs),
                    ls, y0Col, fs);
            }
            }
        }
        // ---- A12 minorSplitLine（CartesianAxisView.ts:170-200）----
        // 细分网格线：每两个 nice 刻度之间 splitNumber 等分处画一条
        // 横线（数值轴）。颜色走 chart::minor-grid，缺省回落主网格色。
        // 类目轴不支持（Axis.ts:204 isOrdinalScale 直接返回空）。
        if (grid && (y0.minorSplitLineShow || (hasRight && y1.minorSplitLineShow))) {
            StyleBox sMinor = Style.Part(app, "chart", "minor-grid", "", "", "",
                                        Style.SNormal());
            int mcol = sMinor.BgOr(0) != 0 ? sMinor.BgOr(0) : sGrid.BgOr(0);
            if (y0.minorSplitLineShow && !catY && leftLog) {
                // 对数轴：刻度非等距，逐对插值
                // （minorTicks.ts:41-63），投影走
                // YOfLogF 的定点对数轴。
                if (leftFrac && (leftLoF != 0 || leftHiF != 0)) {
                    // 小数域：每十进位内按 splitNumber 线性插值。
                    long dF = leftLoF;
                    while (dF < leftHiF) {
                        long dF10 = dF * 10L;
                        for (int mk = 1; mk < y0.minorTickSplitNumber; mk = mk + 1) {
                            long mf = dF + (dF10 - dF) * mk / y0.minorTickSplitNumber;
                            if (mf >= leftHiF) { break; }
                            c.FillRect(plotX, f.YOfLogF(mf, 0), plotW, 1, mcol);
                        }
                        dF = dF10;
                    }
                } else {
                    List<int> ltsM = Chart.LogTicks(leftLo, leftHi);
                    List<double> mtsL = new List<double>();
                    Chart.MinorTickValuesPairs(ltsM, y0.minorTickSplitNumber, mtsL);
                    for (int mi = 0; mi < mtsL.Count; mi = mi + 1) {
                        long mf = (long)(mtsL[mi] * 1000.0 + 0.5);
                        c.FillRect(plotX, f.YOfLogF(mf, 0), plotW, 1, mcol);
                    }
                }
            }
            if (y0.minorSplitLineShow && !catY && !leftLog
                && y0.type == ChartAxisType.Value && ticks > 0) {
                List<double> mts = new List<double>();
                if (leftFrac) {
                    Chart.MinorTickValues((double)leftLoF, (double)leftHiF, ticks,
                        y0.minorTickSplitNumber, mts);
                    for (int mi = 0; mi < mts.Count; mi = mi + 1) {
                        int gy = f.YOfF((int)(mts[mi] + 0.5), 0);
                        c.FillRect(plotX, gy, plotW, 1, mcol);
                    }
                } else {
                    Chart.MinorTickValues((double)leftTickLo, (double)leftTickHi, ticks,
                        y0.minorTickSplitNumber, mts);
                    for (int mi = 0; mi < mts.Count; mi = mi + 1) {
                        int gy = f.YOf((int)(mts[mi] + 0.5), 0);
                        c.FillRect(plotX, gy, plotW, 1, mcol);
                    }
                }
            }
            if (hasRight && y1.minorSplitLineShow && !rightLog
                && y1.type == ChartAxisType.Value && rt > 0) {
                List<double> mts = new List<double>();
                if (rightFrac) {
                    Chart.MinorTickValues((double)rightLoF, (double)rightHiF, rt,
                        y1.minorTickSplitNumber, mts);
                    for (int mi = 0; mi < mts.Count; mi = mi + 1) {
                        int gy = f.YOfF((int)(mts[mi] + 0.5), 1);
                        c.FillRect(plotX, gy, plotW, 1, mcol);
                    }
                } else {
                    Chart.MinorTickValues((double)rightTickLo, (double)rightTickHi, rt,
                        y1.minorTickSplitNumber, mts);
                    for (int mi = 0; mi < mts.Count; mi = mi + 1) {
                        int gy = f.YOf((int)(mts[mi] + 0.5), 1);
                        c.FillRect(plotX, gy, plotW, 1, mcol);
                    }
                }
            }
        }
        if (hasRight) {
            int y1Col = y1.labelColor != 0 ? y1.labelColor : sAxis.FgOr(0);
            if (rightLog) {
                List<int> rts = Chart.LogTicks(rightLo, rightHi);
                for (int ri = 0; ri < rts.Count; ri = ri + 1) {
                    int rv = rts[ri];
                    int gy = f.YOfLog(rv, 1);
                    string rs = Chart.Commas(rv);
                    int lw = Canvas.MeasureText(rs, fs);
                    int rlx = y1.labelInside ? y1LineX - yMargR - lw : y1LineX + yMargR;
                    c.DrawText(rlx, Canvas.CenterTextYAt(gy, fs),
                        rs, y1Col, fs);
                }
            } else if (rightFrac) {
                int rightSpanF = rightHiF - rightLoF;
                for (int k = 0; k <= rt; k = k + 1) {
                    int rvF = rightLoF + rightSpanF * k / rt;
                    int gy = f.YOfF(rvF, 1);
                    if (grid) { c.FillRect(plotX, gy, plotW, 1, gridColY); }
                    if (k % yLblStep != 0) { continue; }
                    string rs = Chart.FracText(y1.labelNegate ? 0 - rvF : rvF);
                    if (y1.labelFormatter.Length > 0) { rs = y1.labelFormatter.Replace("{value}", rs); }
                    int lw = Canvas.MeasureText(rs, fs);
                    int rlx = y1.labelInside ? y1LineX - yMargR - lw : y1LineX + yMargR;
                    c.DrawText(rlx, Canvas.CenterTextYAt(gy, fs),
                        rs, y1Col, fs);
                }
            } else if (f.BrkHas(1)) {
                // A15：右值轴挂断带——与左轴同构：interval 优先取量程
                // 阶段的 brkIvR，未存才现算；取整档与官方 nice ROUND
                // 一致（1/2/3/5/10，阈值 1.5/2.5/4/7）。
                double iv = f.brkIvR;
                if (iv <= 0.0) {
                    double eLo = Chart.BrkElapsed(f.brkR, f.brkGapR, (double)rightTickLo);
                    double eHi = Chart.BrkElapsed(f.brkR, f.brkGapR, (double)rightTickHi);
                    double eSpan = eHi - eLo;
                    if (eSpan < 1.0) { eSpan = 1.0; }
                    iv = eSpan / (rt > 0 ? (double)rt : 5.0);
                    double mag = 1.0;
                    while (mag * 10.0 <= iv) { mag = mag * 10.0; }
                    double m2 = iv / mag;
                    if (m2 < 1.5) { iv = mag; }
                    else if (m2 < 2.5) { iv = 2.0 * mag; }
                    else if (m2 < 4.0) { iv = 3.0 * mag; }
                    else if (m2 < 7.0) { iv = 5.0 * mag; }
                    else { iv = 10.0 * mag; }
                    if (iv < 1.0) { iv = 1.0; }
                }
                List<double> bts = Chart.BrkTicks(f.brkR, f.brkGapR,
                    (double)rightTickLo, (double)rightTickHi, iv);
                for (int k = 0; k < bts.Count; k = k + 1) {
                    double rvb = bts[k];
                    int rvi = (int)Math.Round(rvb);
                    int gy = f.YOfBrk(rvb, 1);
                    if (grid) { c.FillRect(plotX, gy, plotW, 1, gridColY); }
                    string rs = Chart.Commas(y1.labelNegate ? 0 - rvi : rvi);
                    if (y1.labelFormatter.Length > 0) { rs = y1.labelFormatter.Replace("{value}", rs); }
                    int lw = Canvas.MeasureText(rs, fs);
                    int rlx = y1.labelInside ? y1LineX - yMargR - lw : y1LineX + yMargR;
                    c.DrawText(rlx, Canvas.CenterTextYAt(gy, fs),
                        rs, y1Col, fs);
                }
            } else {
                int rightSpan = rightTickHi - rightTickLo;
                for (int k = 0; k <= rt; k = k + 1) {
                    int rv = rightTickLo + rightSpan * k / rt;
                    int gy = f.YOf(rv, 1);
                    if (k % yLblStep != 0) { continue; }
                    string rs = Chart.Commas(y1.labelNegate ? 0 - rv : rv);
                    if (y1.labelFormatter.Length > 0) { rs = y1.labelFormatter.Replace("{value}", rs); }
                    int lw = Canvas.MeasureText(rs, fs);
                    int rlx = y1.labelInside ? y1LineX - yMargR - lw : y1LineX + yMargR;
                    c.DrawText(rlx, Canvas.CenterTextYAt(gy, fs),
                        rs, y1Col, fs);
                }
            }
        }
        if (y0Line) {
            int ylcol = y0.axisLineColor != 0 ? y0.axisLineColor : sAxis.BgOr(0);
            if (f.BrkHas(0)) {
                Chart.DrawAxisLineBands(c, yLineX, plotY, plotH, true,
                    app.Scale(2), ylcol, Chart.BrkPixelBands(f, 0));
            } else {
                c.FillRect(yLineX, plotY, app.Scale(2), plotH, ylcol);
            }
        }
        // Y0 轴刻度须（axisTick）
        if (y0.axisTickShow && y0.show) {
            int ytlen = y0.axisTickLength > 0 ? app.Scale(y0.axisTickLength) : app.Scale(5);
            int yth = y0.axisTickWidth > 0 ? app.Scale(y0.axisTickWidth) : 1;
            int ytcol = y0.axisTickColor != 0 ? y0.axisTickColor : (y0.axisLineColor != 0 ? y0.axisLineColor : sAxis.BgOr(0));
            int ytx0 = y0.axisTickInside ? yLineX : yLineX - ytlen;
            if (!catY) {
                int leftSpan = leftTickHi - leftTickLo;
                for (int k = 0; k <= ticks; k = k + 1) {
                    int lv = leftTickLo + leftSpan * k / ticks;
                    int gy = f.YOf(lv, 0);
                    c.FillRect(ytx0, gy - yth / 2, ytlen, yth, ytcol);
                }
            }
        }
        if (x0Line) {
            if (f.brkX != null && f.brkX.Count > 0) {
                Chart.DrawAxisLineBands(c, plotX, xLineY, plotW, false,
                    app.Scale(2), sAxis.BgOr(0), Chart.BrkPixelBands(f, 2));
            } else {
                c.FillRect(plotX, xLineY, plotW, app.Scale(2), sAxis.BgOr(0));
            }
        }
        if (y1Line) {
            int y1col = y1.axisLineColor != 0 ? y1.axisLineColor : sAxis.BgOr(0);
            if (f.BrkHas(1)) {
                Chart.DrawAxisLineBands(c, y1LineX, plotY, plotH, true, 1,
                    y1col, Chart.BrkPixelBands(f, 1));
            } else {
                c.FillRect(y1LineX, plotY, 1, plotH, y1col);
            }
        }
        // Y1 轴刻度须（axisTick）
        if (hasRight && y1.axisTickShow && y1.show) {
            int y1tlen = y1.axisTickLength > 0 ? app.Scale(y1.axisTickLength) : app.Scale(5);
            int y1th = y1.axisTickWidth > 0 ? app.Scale(y1.axisTickWidth) : 1;
            int y1tcol = y1.axisTickColor != 0 ? y1.axisTickColor : (y1.axisLineColor != 0 ? y1.axisLineColor : sAxis.BgOr(0));
            int y1tx0 = y1.axisTickInside ? y1LineX - y1tlen : y1LineX;
            int rightSpan = rightTickHi - rightTickLo;
            for (int k = 0; k <= rt; k = k + 1) {
                int rv = rightTickLo + rightSpan * k / rt;
                int gy = f.YOf(rv, 1);
                c.FillRect(y1tx0, gy - y1th / 2, y1tlen, y1th, y1tcol);
            }
        }

        // 轴级静态 axisPointer：show 官方缺省 'auto'（SSR 实测
        // get('show')）——auto 时**声明了 value 就显示**；显式 false
        // 才隐藏。竖线锚在 value（时间轴 epoch 天 / 数值轴原值），
        // 线色宽走 lineStyle；label 盒画在 x 轴线下方（官方 label
        // 默认白字圆角盒）。画在网格之上、系列之下（官方 z 序）。
        if (x0.axisPointerShow != 0 && x0.apValueSet && plotW > 0 && plotH > 0) {
            int apx = isTime ? f.XOfTime((int)x0.apValue)
                : f.XOfValue((int)(x0.apValue + (x0.apValue >= 0 ? 0.5 : 0 - 0.5)));
            int apCol = x0.apColor != 0 ? x0.apColor : sAxis.BgOr(0);
            int apW = x0.apWidth > 0 ? x0.apWidth : 1;
            if (apx >= plotX && apx <= plotX + plotW) {
                c.FillRect(apx - apW / 2, plotY, apW, plotH, apCol);
                if (x0.apLabelShow && x0.apLabelBg != 0) {
                    string apt = isTime ? Chart.TimeLabel((int)x0.apValue)
                        : Chart.Commas((int)(x0.apValue
                            + (x0.apValue >= 0 ? 0.5 : 0 - 0.5)));
                    int atW = Canvas.MeasureText(apt, fs);
                    int boxW = atW + app.Scale(10);
                    int boxH = fh + app.Scale(2);
                    int boxY = plotY + plotH + app.Scale(4);
                    c.FillRoundRect(apx - boxW / 2, boxY, boxW, boxH,
                        t.borderRadiusSmall, x0.apLabelBg);
                    c.DrawText(apx - atW / 2,
                        boxY + (boxH - Canvas.FontHeight(fs)) / 2,
                        apt, 0xFFFFFF, fs);
                }
            }
        }

        // x 分类标签（时间轴用 TimeLabel 日期刻度；值轴画数值刻度）
        int n = labels.Count;
        if (x0.show && (catY || xValue)) {
            // 轴互换：类目在 Y（上面已画），X 画数值刻度。
            // ECharts 数值轴 splitLine 默认开（类目轴默认关）：
            // 竖向辅助线是轴互换图（line5 类目 Y + 数值 X）唯一
            // 的网格，横线随类目 Y 的 showGrid=false 不画。
            bool gridX = o.showGrid && x0.showGrid;
            // X 刻度同左/右轴取 nice 端点副本（xLo/xHi 已留白外扩）。
            int xspan = xTickHi - xTickLo;
            // ---- A12 minorSplitLine（X 数值轴）----
            // CartesianAxisView.ts:170-200 同一函数按
            // isHorizontal 分支：x 轴画竖线。
            // 类目轴不支持（Axis.ts:204 返回空）。
            if (x0.minorSplitLineShow && !catY && !isTime
                && x0.type == ChartAxisType.Value && xt > 0) {
                StyleBox sMinorX = Style.Part(app, "chart", "minor-grid", "", "", "",
                                             Style.SNormal());
                int mcolX = sMinorX.BgOr(0) != 0 ? sMinorX.BgOr(0) : sGrid.BgOr(0);
                List<double> mtsX = new List<double>();
                Chart.MinorTickValues((double)xTickLo, (double)xTickHi, xt,
                    x0.minorTickSplitNumber, mtsX);
                for (int miX = 0; miX < mtsX.Count; miX = miX + 1) {
                    int gmx = f.XOfValue((int)(mtsX[miX] + 0.5));
                    if (gmx > plotX && gmx < plotX + plotW) {
                        c.FillRect(gmx, plotY, 1, plotH, mcolX);
                    }
                }
            }
            int x0Col = x0.labelColor != 0 ? x0.labelColor : sAxis.FgOr(0);
            int xly = x0.labelInside ? plotBot - xMarg - fh : plotBot + xMarg;
            for (int k = 0; k <= xt; k = k + 1) {
                int xv = xTickLo + xspan * k / xt;
                int gx = f.XOfValue(xv);
                if (gridX) { c.FillRect(gx, plotY, 1, plotH, gridColX); }
                if (x0.axisTickShow) {
                    int xtlen = x0.axisTickLength > 0 ? app.Scale(x0.axisTickLength) : app.Scale(5);
                    int xtw = x0.axisTickWidth > 0 ? app.Scale(x0.axisTickWidth) : 1;
                    int xtcol = x0.axisTickColor != 0 ? x0.axisTickColor : (x0.axisLineColor != 0 ? x0.axisLineColor : sAxis.BgOr(0));
                    int xty0 = x0.axisTickInside ? xLineY - xtlen : xLineY;
                    c.FillRect(gx - xtw / 2, xty0, xtw, xtlen, xtcol);
                }
                string xs2 = Chart.Commas(xv);
                if (x0.labelFormatter.Length > 0) { xs2 = x0.labelFormatter.Replace("{value}", xs2); }
                string xs2m = x0.labelSt != null && x0.labelSt.rich != null
                    ? Chart.RichStrip(xs2) : xs2;
                int lw = Canvas.MeasureText(xs2m, fs);
                int lx = gx - lw / 2;
                if (lx < plotX) { lx = plotX; }
                if (lx + lw > plotX + plotW) { lx = plotX + plotW - lw; }
                Chart.DrawAxisLabel(app, c, x0, xs2, lx, xly,
                    x0Col, fs);
            }
        } else if (x0.show && (n > 0 || isTime)) {
            int x0Col = x0.labelColor != 0 ? x0.labelColor : sAxis.FgOr(0);
            int xly = x0.labelInside ? plotBot - xMarg - fh : plotBot + xMarg;
            if (isTime) {
                List<int> tts = Chart.TimeTicks(tMin, tMax, 6);
                for (int ti = 0; ti < tts.Count; ti = ti + 1) {
                    int tx = f.XOfTime(tts[ti]);
                    if (x0.axisTickShow) {
                        int xtlen = x0.axisTickLength > 0 ? app.Scale(x0.axisTickLength) : app.Scale(5);
                        int xtw = x0.axisTickWidth > 0 ? app.Scale(x0.axisTickWidth) : 1;
                        int xtcol = x0.axisTickColor != 0 ? x0.axisTickColor : (x0.axisLineColor != 0 ? x0.axisLineColor : sAxis.BgOr(0));
                        int xty0 = x0.axisTickInside ? xLineY - xtlen : xLineY;
                        c.FillRect(tx - xtw / 2, xty0, xtw, xtlen, xtcol);
                    }
                    string ls = Chart.TimeLabel(tts[ti]);
                    if (x0.labelFormatter.Length > 0) { ls = x0.labelFormatter.Replace("{value}", ls); }
                    string lsm = x0.labelSt != null && x0.labelSt.rich != null
                        ? Chart.RichStrip(ls) : ls;
                    int lw = Canvas.MeasureText(lsm, fs);
                    int lx = tx - lw / 2;
                    if (lx < plotX) { lx = plotX; }
                    if (lx + lw > plotX + plotW) { lx = plotX + plotW - lw; }
                    Chart.DrawAxisLabel(app, c, x0, ls, lx, xly,
                        x0Col, fs);
                }
            } else {
                int labelGap = app.Scale(6);
                int rot = x0.labelRotate;
                // 刻度线模式（boundaryGap=false）标签以刻度为中心，
                // 首尾标签允许越出绘图区（与数值轴标签同形态）；
                // 带状模式居中在格子内、不越左缘。
                bool tickX = !f.catBoundaryGap && n > 1;
                // ECharts 类目轴 splitLine 默认开、interval 缺省
                // 'auto'（与 axisLabel 同源抽稀）：竖线只落在显示标签
                // 的刻度上——刻度模式落在类目刻度（CatX），带状模式落
                // 在格子边界（CatLeft）；首线与 y 轴重合、末线贴绘图区
                // 右缘，都跳过。密集类目（雨量图 3079 点）不再逐类目
                // 一条竖线糊成灰罩。
                List<int> tickShown = Chart.CategoryTicks(f, labels, fs,
                    plotX, labelGap, x0);
                if (o.showGrid && x0.showGrid) {
                    for (int si3 = 0; si3 < tickShown.Count; si3 = si3 + 1) {
                        int gvi = tickShown[si3];
                        if (!tickX && gvi == 0) { continue; }
                        int gvx = tickX ? f.CatX(gvi, n) : f.CatLeft(gvi, n);
                        if (gvx > plotX && gvx < plotX + plotW) {
                            c.FillRect(gvx, plotY, 1, plotH, gridColX);
                        }
                    }
                }
                if (x0.axisTickShow) {
                    int xtlen = x0.axisTickLength > 0 ? app.Scale(x0.axisTickLength) : app.Scale(5);
                    int xtw = x0.axisTickWidth > 0 ? app.Scale(x0.axisTickWidth) : 1;
                    int xtcol = x0.axisTickColor != 0 ? x0.axisTickColor : (x0.axisLineColor != 0 ? x0.axisLineColor : sAxis.BgOr(0));
                    int xty0 = x0.axisTickInside ? xLineY - xtlen : xLineY;
                    if (x0.axisTickAlignWithLabel) {
                        for (int si3 = 0; si3 < tickShown.Count; si3 = si3 + 1) {
                            int gvi = tickShown[si3];
                            int tx = f.CatX(gvi, n);
                            c.FillRect(tx - xtw / 2, xty0, xtw, xtlen, xtcol);
                        }
                    } else if (f.catBoundaryGap) {
                        for (int ci = 0; ci <= n; ci = ci + 1) {
                            int tx = ci < n ? f.CatLeft(ci, n) : plotX + plotW;
                            c.FillRect(tx - xtw / 2, xty0, xtw, xtlen, xtcol);
                        }
                    } else {
                        for (int si3 = 0; si3 < tickShown.Count; si3 = si3 + 1) {
                            int tx = f.CatLeft(tickShown[si3], n);
                            c.FillRect(tx - xtw / 2, xty0, xtw, xtlen, xtcol);
                        }
                    }
                }
                for (int ti5 = 0; ti5 < tickShown.Count; ti5 = ti5 + 1) {
                    int ci = tickShown[ti5];
                    string lab = labels[ci];
                    if (x0.labelFormatter.Length > 0) { lab = x0.labelFormatter.Replace("{value}", lab); }
                    bool labRich = x0.labelSt != null && x0.labelSt.rich != null;
                    string labm = labRich ? Chart.RichStrip(lab) : lab;
                    int cxs = f.CatLeft(ci, n);
                    int cellW = f.CatWidth(ci, n);
                    int labelW = Canvas.MeasureText(labm, fs);
                    int labelLeft = tickX ? cxs - labelW / 2
                        : cxs + (cellW - labelW) / 2;
                    if (!tickX && labelLeft < cxs) { labelLeft = cxs; }
                    // 直接迭代 tickShown（CategoryTicks 已抽稀），
                    // 不再对未显示的类目做 Replace/MeasureText。
                    if (rot != 0) {
                        // DrawTextRot 绕未旋转行盒左上角顺时针旋转：
                        // 负角取行盒右缘为锚（文本向右下伸展、标签尾
                        // 对齐格子中线），正角取左缘（文本向右上收）。
                        // 富文本块不能整体旋转——画剥壳文本。
                        int ax = labelLeft + labelW;
                        if (rot > 0) { ax = labelLeft; }
                        int rotY = x0.labelInside ? plotBot - app.Scale(4) - fh : plotBot + app.Scale(4);
                        c.DrawTextRot(ax, rotY, labm,
                            x0Col, fs, rot);
                    } else if (tickX) {
                        Chart.DrawAxisLabel(app, c, x0, lab, cxs - labelW / 2,
                            xly, x0Col, fs);
                    } else {
                        Chart.DrawAxisLabelCentered(app, c, x0, lab, cxs,
                            xly, cellW, fh,
                            x0Col, fs);
                    }
                }
            }
        }

        // 第二条 x 轴（双 X 轴图顶轴/副轴，如 multiple-x-axis）：
        // 沿 plotY 绘制顶部轴线、刻度须、刻度标签与轴名。
        if (o.xAxes.Count > 1) {
            ChartAxis x1 = o.XAxis1();
            if (x1 != null && x1.show) {
                int x1Col = x1.axisLineColor != 0 ? x1.axisLineColor : sAxis.BgOr(0);
                c.FillRect(plotX, plotY, plotW, app.Scale(2), x1Col);
                List<string> x1Labels = x1.categories != null && x1.categories.Count > 0
                    ? x1.categories : labels;
                int x1N = x1Labels.Count;
                int x1LblCol = x1.labelColor != 0 ? x1.labelColor : x1Col;
                int x1tlen = x1.axisTickLength > 0 ? app.Scale(x1.axisTickLength) : app.Scale(5);
                int x1tw = x1.axisTickWidth > 0 ? app.Scale(x1.axisTickWidth) : 1;
                int x1tcol = x1.axisTickColor != 0 ? x1.axisTickColor : x1Col;
                for (int x1i = 0; x1i < x1N; x1i = x1i + 1) {
                    int x1cxs = f.CatLeft(x1i, x1N);
                    int x1cellW = f.CatWidth(x1i, x1N);
                    int x1Mid = f.CatX(x1i, x1N);
                    if (x1.axisTickShow) {
                        int x1TickX = x1.axisTickAlignWithLabel ? x1Mid : x1cxs;
                        int x1TickY = x1.axisTickInside ? plotY : plotY - x1tlen;
                        c.FillRect(x1TickX - x1tw / 2, x1TickY, x1tw, x1tlen, x1tcol);
                    }
                    if (x1.labelShow) {
                        string lab1 = x1Labels[x1i];
                        if (x1.labelFormatter.Length > 0) { lab1 = x1.labelFormatter.Replace("{value}", lab1); }
                        int lab1W = Canvas.MeasureText(lab1, fs);
                        int lab1Y = x1.labelInside ? plotY + app.Scale(4) : plotY - app.Scale(4) - fh;
                        c.DrawText(x1Mid - lab1W / 2, lab1Y, lab1, x1LblCol, fs);
                    }
                }
                if (x1.axisTickShow && !x1.axisTickAlignWithLabel && f.catBoundaryGap) {
                    int x1EndTickX = plotX + plotW;
                    int x1EndTickY = x1.axisTickInside ? plotY : plotY - x1tlen;
                    c.FillRect(x1EndTickX - x1tw / 2, x1EndTickY, x1tw, x1tlen, x1tcol);
                }
                Chart.DrawAxisNameAt(app, c, x1, true, plotX, plotY, plotW, plotH, false,
                    sAxisTitle, fs, plotY);
            }
        }

        // 轴名：ECharts 三态（缺省 'end'）+ nameGap（缺省 15）。
        // 几何与实测出处见 Chart.AxisNamePos。骑线时 start/end 态
        // 的名字贴轴线走（middle 留在边界，AxisBuilder.ts:869 的
        // labelOffset 抵回原位）。
        Chart.DrawAxisNameAt(app, c, x0, true, plotX, plotY, plotW, plotH, false,
            sAxisTitle, fs, xLineY);
        Chart.DrawAxisNameAt(app, c, y0, false, plotX, plotY, plotW, plotH,
            y0.position == "right", sAxisTitle, fs, yLineX);
        // 右轴名只在真的存在第二条轴时画（YAxis1 在单轴时会回退
        // 到 YAxis0，不设防会把左轴名镜像到右缘）。
        if (hasRight && o.yAxes.Count > 1) {
            Chart.DrawAxisNameAt(app, c, y1, false, plotX, plotY, plotW, plotH,
                y1.position == "right", sAxisTitle, fs, y1LineX);
        }

        return f;
    }
}
