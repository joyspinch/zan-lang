using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

/// 词云单个词条的放置结果：内容（ChartData 引用）+ 轴对齐
/// 包围盒 + 字号/颜色/旋转角。坐标相对绘图区。
class WordCloudItem {
    ChartData data;
    /// 包围盒左上角（rot != 0 时为旋转后的包围盒）。
    int x;
    int y;
    int w;
    int h;
    int fontSize;
    int color;
    /// 旋转角（度，0/90 来自 ECharts rotateRange 的两态，自定义角度集
    /// 由 wcRotateList 提供）；旋转项的 x/y/w/h 存的是旋转后的包围盒。
    int rot;

    /// 构造词条放置项：内容引用与几何/样式全按参数记录。
    static WordCloudItem Of(ChartData data, int x, int y, int w, int h,
                            int fontSize, int color, int rot) {
        WordCloudItem item = new WordCloudItem();
        item.data = data;
        item.x = x;
        item.y = y;
        item.w = w;
        item.h = h;
        item.fontSize = fontSize;
        item.color = color;
        item.rot = rot;
        return item;
    }
}

/// 词云放置结果的逐帧记忆化条目：螺旋放置只依赖词条内容与
/// 盒子几何，即时模式调用方每帧重建 option 对象，按内容指纹
/// 复用同一次放置搜索（见 ChartView.DrawWordCloud）。
class WordCloudCacheEntry {
    int fp;
    List<WordCloudItem> items;
    /// 按内容指纹查找缓存的放置结果；未命中返回 null。
    static WordCloudCacheEntry Lookup(List<WordCloudCacheEntry> cache, int fp) {
        for (int i = 0; i < cache.Count; i = i + 1) {
            if (cache[i].fp == fp) { return cache[i]; }
        }
        return null;
    }
    /// 存入放置结果（同指纹去重；超出容量时挤掉最旧的一条）。
    static void Store(List<WordCloudCacheEntry> cache, int fp,
                      List<WordCloudItem> items, int capacity) {
        for (int i = 0; i < cache.Count; i = i + 1) {
            if (cache[i].fp == fp) { return; }
        }
        WordCloudCacheEntry e = new WordCloudCacheEntry();
        e.fp = fp;
        e.items = items;
        if (cache.Count >= capacity) { cache.RemoveAt(0); }
        cache.Add(e);
    }
}

/// 树形图布局的中间记录：节点 + 深度 + 叶子 span 起点
/// （见 ChartView.TreeAssign）。
class TreeLayoutNode {
    ChartNode node;
    int depth;
    int lo;
    int count;

    /// 构造布局记录：node/depth/lo/count 全按参数记录
    /// （count = 子树叶子槽位数，由调用方传入）。
    static TreeLayoutNode Of(ChartNode node, int depth, int lo, int count) {
        TreeLayoutNode layout = new TreeLayoutNode();
        layout.node = node;
        layout.depth = depth;
        layout.lo = lo;
        layout.count = count;
        return layout;
    }
}

/// 桑基图节点布局：按最长路径分层的层号 + 累计流量决定的
/// 高度与 x/y 落点（见 ChartView.DrawSankey）。
class SankeyNodeLayout {
    string name;
    int layer;
    int flowOut;
    int flowIn;
    int x;
    int y;
    int h;

    /// 构造桑基节点：仅记名字，layer/flow/x/y/h 由布局阶段填充。
    static SankeyNodeLayout Of(string name) {
        SankeyNodeLayout node = new SankeyNodeLayout();
        node.name = name;
        node.layer = 0;
        node.flowOut = 0;
        node.flowIn = 0;
        node.x = 0;
        node.y = 0;
        node.h = 0;
        return node;
    }
}

/// treemap squarify 布局矩形：绘制与命中共用同一份几何。
class TmRect {
    ChartNode node;
    int depth;
    int x;
    int y;
    int w;
    int h;

    static TmRect Of(ChartNode node, int depth, int x, int y, int w, int h) {
        TmRect r = new TmRect();
        r.node = node;
        r.depth = depth;
        r.x = x;
        r.y = y;
        r.w = w;
        r.h = h;
        return r;
    }
}

/// TmPosition 里随行落位而收缩的剩余内容矩形（Zan 无 ref 参数，
/// 用对象引用让调用方看到推进）。
class TmBox {
    double x;
    double y;
    double w;
    double h;
}

/// 某深度合并后的 treemap 样式（levels[depth] → 系级 tm* → 官方缺省），
/// px 值已过 app.Scale。
class TmStyle {
    int borderWidth;
    int gapWidth;
    int borderColor;
    int borderColorSat;  // -1 未声明；声明后 borderColor 失效
    int hasColorSat;  // colorSaturation [lo,hi]（千分值域）
    int satLo;
    int satHi;
    int upperShow;
    int upperHeight;  // max(borderWidth, show ? height : 0)
    List<int> color;  // 级 color 数组（null → 继承父级 designated）
    int colorMappingBy;  // 0 index | 1 value | 2 id
}

/// sunburst 深度 d 的环带 [rStart, rEnd]。
class SunBand {
    int rStart;
    int rEnd;
}

partial class ChartView {
    /// 节点安全名（null → ""）。
    static string TreeNodeName(ChartNode n) {
        if (n == null || n.name == null) { return ""; }
        return n.name;
    }

    /// 直接子节点数（null → 0）。
    static int TreeChildCount(ChartNode n) {
        if (n == null || n.children == null) { return 0; }
        return n.children.Count;
    }

    /// Treemap 面积只接受正值（负值/零值不占像素）；有子节点时取
    /// 子树累计和，且累计和饱和到 int 上限，避免异常输入把布局
    /// 边界推进到负数或溢出。
    static int TreemapValue(ChartNode n) {
        if (n == null) { return 0; }
        int kids = n.children == null ? 0 : n.children.Count;
        if (kids == 0) { return n.val > 0 ? n.val : 0; }
        int sum = 0;
        for (int i = 0; i < kids; i = i + 1) {
            int v = ChartView.TreemapValue(n.children[i]);
            if (v > 2147483647 - sum) { return 2147483647; }
            sum = sum + v;
        }
        return sum;
    }

    /// 同层节点列表的 TreemapValue 总和（饱和）。
    static int TreemapTotal(List<ChartNode> nodes) {
        if (nodes == null) { return 0; }
        int total = 0;
        for (int i = 0; i < nodes.Count; i = i + 1) {
            int v = ChartView.TreemapValue(nodes[i]);
            if (v > 2147483647 - total) { return 2147483647; }
            total = total + v;
        }
        return total;
    }

    /// 饱和加法：负数钳 0，溢出饱和 int 上限。
    static int TreemapAdd(int left, int right) {
        if (left < 0) { left = 0; }
        if (right < 0) { right = 0; }
        if (right > 2147483647 - left) { return 2147483647; }
        return left + right;
    }

    /// 矩形树图（treemap）绘制入口。官方契约（源对抄
    /// echarts-master/src/chart/treemap/）：getInitialData 恒把 data
    /// 包进虚拟根 {name, children: data}，故 lead.tree 条目是深度 1、
    /// levels[min(depth, len-1)] 与官方 node.depth 对齐；布局是 d3
    /// squarify（treemapLayout.ts 源对抄）；父格底 = borderColor，
    /// 叶格填充 = designated 色（color 数组 index/id/value 映射 +
    /// colorSaturation 线性域）。sort:true → orderBy null → 不排序、
    /// visibleMin 不生效（官方 filterByThreshold 前置条件），语料
    /// 数据已按序给出。`g` 为出现动画进度（千分值 0..1000）。
    static void DrawTreemap(App app, int x, int y, int w, int h,
                            ChartOption o, int g) {
        Canvas c = app.canvas;
        ChartSeries lead = ChartView.LeadSeries(o);
        if (lead == null || lead.tree == null || lead.tree.Count < 1) { return; }
        int plotTop = ChartView.PanelHead(app, x, y, w, h, o.title);
        int pad = app.theme.paddingMedium;
        int areaX = x + pad;
        int areaY = plotTop;
        int areaW = w - pad * 2;
        int areaH = (y + h - pad) - plotTop;
        if (areaW < app.Scale(10) || areaH < app.Scale(10)) { return; }
        int gw = areaW * g / 1000;
        int gh = areaH * g / 1000;
        areaX = areaX + (areaW - gw) / 2;
        areaY = areaY + (areaH - gh) / 2;
        areaW = gw;
        areaH = gh;
        if (areaW < app.Scale(4) || areaH < app.Scale(4)) { return; }

        // 虚拟根（深度 0）底色 = 深度 0 borderColor（官方 renderBackground）。
        TmStyle st0 = ChartView.TmStyleOf(app, lead, 0);
        c.FillRect(areaX, areaY, areaW, areaH, st0.borderColor);

        List<TmRect> rects = new List<TmRect>();
        Dict<string, int> idmap = new Dict<string, int>();
        ChartView.TmBuildIdMap(lead.tree, idmap, 0);
        ChartView.TmLayoutPaint(app, lead, null, lead.tree, 0,
            areaX, areaY, areaW, areaH, 0, 0 - 1, rects, idmap);

        // 命中：同一份几何，倒序取最内格（子格盖在父格上，间隙归父格）。
        int mx = app.mouseX;
        int my = app.mouseY;
        ChartView.ttName = "";
        ChartView.ttVal = 0;
        ChartView.ttNode = null;
        if (ChartView.TreemapContains(mx, my, areaX, areaY, areaW, areaH, 0)) {
            for (int i = rects.Count - 1; i >= 0; i = i - 1) {
                TmRect rc = rects[i];
                if (rc.node == null) { continue; }
                if (!ChartView.TreemapContains(mx, my, rc.x, rc.y, rc.w, rc.h, 0)) {
                    continue;
                }
                ChartView.ttNode = rc.node;
                ChartView.ttName = ChartView.TreeNodeName(rc.node);
                ChartView.ttVal = ChartView.TreemapValue(rc.node);
                ChartView.ttX = rc.x;
                ChartView.ttY = rc.y;
                ChartView.ttW = rc.w;
                ChartView.ttH = rc.h;
                ChartView.ttRadius = 0;
                break;
            }
            if (ChartView.ttNode != null
                && ChartView.activeEventView != null) {
                ChartHit th = ChartHit.Of(ChartElementType.Node,
                    ChartView.SeriesIndexOf(o, lead), lead.name,
                    ChartView.TmNodeIndex(lead.tree, ChartView.ttNode),
                    ChartView.ttName, ChartView.ttVal, mx, my);
                th.axisIndex = lead.axisIndex;
                ChartView.OfferActiveHit(th);
            }
            if (o.showTooltip && ChartView.ttName.Length > 0) {
                // 描出精确悬停单元格的轮廓。
                c.DrawRoundRect(ChartView.ttX, ChartView.ttY,
                    ChartView.ttW, ChartView.ttH, ChartView.ttRadius,
                    0xFFFFFFFF, app.Scale(2));
                List<TooltipRow> rows = new List<TooltipRow>{
                    TooltipRow.Of(0, o.title),
                    TooltipRow.Of(0xFFFFFFFF,
                        ChartView.ttName + "  " + Convert.ToString(ChartView.ttVal)) };
                ChartView.TooltipCard(app, mx, my, x + w, rows);
            }
        }
    }

    /// 官方 mapIdToIndex：全树 preorder 下标（id → 首个命中），
    /// colorMappingBy 'id' 的取值通道；无 id 的节点只占号不建键。
    static int TmBuildIdMap(List<ChartNode> nodes, Dict<string, int> into, int next) {
        if (nodes == null) { return next; }
        for (int i = 0; i < nodes.Count; i = i + 1) {
            ChartNode n = nodes[i];
            if (n == null) { continue; }
            if (n.id != null && n.id.Length > 0 && !into.ContainsKey(n.id)) {
                into.Add(n.id, next);
            }
            next = next + 1;
            next = ChartView.TmBuildIdMap(n.children, into, next);
        }
        return next;
    }

    /// 虚拟根语义的全树 preorder 下标（命中事件 dataIndex）。
    static int TmNodeIndex(List<ChartNode> nodes, ChartNode target) {
        if (nodes == null || target == null) { return 0 - 1; }
        int offset = 0;
        for (int i = 0; i < nodes.Count; i = i + 1) {
            if (nodes[i] == target) { return offset; }
            int sub = ChartView.TreeNodeIndex(nodes[i], target);
            if (sub >= 0) { return offset + sub; }
            offset = offset + ChartView.TreeNodeCount(nodes[i]);
        }
        return 0 - 1;
    }

    /// levels[min(depth, levels.Count-1)]；无 levels 返回 null。
    static ChartLevel TmLevel(ChartSeries s, int depth) {
        if (s == null || s.levels == null || s.levels.Count < 1) { return null; }
        if (depth < 0) { depth = 0; }
        if (depth >= s.levels.Count) { depth = s.levels.Count - 1; }
        return s.levels[depth];
    }

    /// 全系任一 level 声明过 color 数组（setDefault 注入判定用）。
    static bool TmAnyLevelColor(ChartSeries s) {
        if (s.levels == null) { return false; }
        for (int i = 0; i < s.levels.Count; i = i + 1) {
            if (s.levels[i] != null && s.levels[i].color != null
                && s.levels[i].color.Count > 0) { return true; }
        }
        return false;
    }

    /// 深度样式合并（官方 node item → levels[depth] → series → 缺省，
    /// px 过 Scale）。color 决议：级色声明优先；否则在 setDefault
    /// 「级0 无级色时注入全局调色板」语义下，深度 0（或 levels 全空
    /// 的钳位路径）用主题调色板；更深无声明 → null（继承父级）。
    static TmStyle TmStyleOf(App app, ChartSeries s, int depth) {
        ChartLevel lv = ChartView.TmLevel(s, depth);
        TmStyle st = new TmStyle();
        int sc = app.Scale(1);
        if (lv != null && lv.borderWidth >= 0) { st.borderWidth = lv.borderWidth * sc; }
        else if (s.tmBorderWidth >= 0) { st.borderWidth = s.tmBorderWidth * sc; }
        else { st.borderWidth = 0; }
        if (lv != null && lv.gapWidth >= 0) { st.gapWidth = lv.gapWidth * sc; }
        else if (s.tmGapWidth >= 0) { st.gapWidth = s.tmGapWidth * sc; }
        else { st.gapWidth = 0; }
        if (lv != null && lv.borderColor != 0) { st.borderColor = lv.borderColor; }
        else if (s.tmBorderColor != 0) { st.borderColor = s.tmBorderColor; }
        else { st.borderColor = 0xFFFFFFFF; }
        if (lv != null && lv.borderColorSat >= 0) { st.borderColorSat = lv.borderColorSat; }
        else { st.borderColorSat = s.tmBorderColorSat; }
        if (lv != null && lv.hasColorSat == 1) {
            st.hasColorSat = 1;
            st.satLo = lv.satLo;
            st.satHi = lv.satHi;
        } else {
            st.hasColorSat = s.tmHasColorSat;
            st.satLo = s.tmSatLo;
            st.satHi = s.tmSatHi;
        }
        if (lv != null && lv.upperShow >= 0) { st.upperShow = lv.upperShow; }
        else if (s.tmUpperShow >= 0) { st.upperShow = s.tmUpperShow; }
        else { st.upperShow = 0; }
        int uhRaw = 20;
        if (lv != null && lv.upperHeight >= 0) { uhRaw = lv.upperHeight; }
        else if (s.tmUpperHeight >= 0) { uhRaw = s.tmUpperHeight; }
        int uh = st.upperShow == 1 ? app.Scale(uhRaw) : 0;
        st.upperHeight = st.borderWidth > uh ? st.borderWidth : uh;
        if (lv != null && lv.color != null && lv.color.Count > 0) {
            st.color = lv.color;
        } else if (s.levels.Count < 1
            || (depth == 0 && !ChartView.TmAnyLevelColor(s))) {
            st.color = new List<int>();
            for (int pi = 0; pi < 9; pi = pi + 1) {
                st.color.Add(Chart.Palette(app.theme, pi));
            }
        }
        st.colorMappingBy = lv != null ? lv.colorMappingBy : 0;
        return st;
    }

    /// 官方 squareRatio：0.5 × (1 + √5)。
    static double TmSquareRatio() {
        return 1.618033988749895;
    }

    /// double 域 min（squarify 固定长边判定用；DAbs 在
    /// ChartPolarBarLayout 已有）。
    static double DMin(double a, double b) {
        return a < b ? a : b;
    }

    /// 布局/视觉取值：dim 0 = 子树累计（同官方 getValue()），
    /// dim > 0 = 多维 value 对应维原始值（treemap-visual 维 3）。
    static double TmNodeValue(ChartNode n, int dim) {
        if (n == null) { return 0; }
        if (dim > 0 && n.vals != null && dim < n.vals.Count) { return n.vals[dim]; }
        return ChartView.TreemapValue(n);
    }

    /// 官方 worst()：行的最坏纵横比（d3 squarified）。areaMin 走
    /// IEEE 无穷语义（全 0 行 → b 项为 0，与官方一致）。
    static double TmWorst(double rowArea, double areaMax, double areaMin,
                          double side, double ratio) {
        if (rowArea <= 0) { return 1.7976931348623157e308; }
        double squareArea = rowArea * rowArea;
        double f = side * side * ratio;
        double a = f * areaMax / squareArea;
        double b = squareArea / (f * areaMin);
        return a > b ? a : b;
    }

    static double TmRowArea(List<int> row, List<double> areas) {
        double sum = 0;
        for (int i = 0; i < row.Count; i = i + 1) { sum = sum + areas[row[i]]; }
        return sum;
    }

    static double TmRowMax(List<int> row, List<double> areas) {
        double mx = 0;
        for (int i = 0; i < row.Count; i = i + 1) {
            double a = areas[row[i]];
            if (a > mx) { mx = a; }
        }
        return mx;
    }

    static double TmRowMin(List<int> row, List<double> areas) {
        double mn = 1.7976931348623157e308;
        for (int i = 0; i < row.Count; i = i + 1) {
            double a = areas[row[i]];
            if (a > 0 && a < mn) { mn = a; }
        }
        return mn;
    }

    /// 官方 position()：一行沿剩余矩形短边（固定长 side）铺开，
    /// 行厚从剩余矩形上切走；子矩形产出 TmRect（floor 到整数像素），
    /// 深度 = depth（子级）。halfGap 缝隙由 min(halfGap, wh/2) 内缩。
    static void TmPosition(TmBox rect, List<int> row, List<double> areas,
                           double side, double halfGap, bool flush,
                           int depth, List<TmRect> rects) {
        double rowArea = 0;
        for (int i = 0; i < row.Count; i = i + 1) { rowArea = rowArea + areas[row[i]]; }
        bool horiz = side == rect.w;
        double last = horiz ? rect.x : rect.y;
        double other = side > 0 ? rowArea / side : 0;
        double otherLimit = horiz ? rect.h : rect.w;
        if (flush || other > otherLimit) { other = otherLimit; }
        for (int i = 0; i < row.Count; i = i + 1) {
            double step = other > 0 ? areas[row[i]] / other : 0;
            double remain = (horiz ? rect.x + rect.w : rect.y + rect.h) - last;
            double modWH = (i == row.Count - 1 || remain < step) ? remain : step;
            double wh0 = modWH - halfGap * 2;
            if (wh0 < 0) { wh0 = 0; }
            double wh1 = other - halfGap * 2;
            if (wh1 < 0) { wh1 = 0; }
            int nx;
            int ny;
            int nw;
            int nh;
            if (horiz) {
                nx = (int)(last + ChartView.DMin(halfGap, wh0 / 2));
                ny = (int)(rect.y + ChartView.DMin(halfGap, wh1 / 2));
                nw = (int)wh0;
                nh = (int)wh1;
            } else {
                nx = (int)(rect.x + ChartView.DMin(halfGap, wh0 / 2));
                ny = (int)(last + ChartView.DMin(halfGap, wh1 / 2));
                nw = (int)wh1;
                nh = (int)wh0;
            }
            rects.Add(TmRect.Of(null, depth, nx, ny, nw, nh));
            last = last + modWH;
        }
        if (horiz) {
            rect.y = rect.y + other;
            rect.h = rect.h - other;
        } else {
            rect.x = rect.x + other;
            rect.w = rect.w - other;
        }
    }

    /// 官方 dataExtent 拓宽（visualMin/visualMax）后的线性千分比
    /// （VisualMapping linear 的归一域）。
    static int TmValueT(ChartSeries s, double lo, double hi, double v) {
        if (s.visualMin != 0 - 1 && s.visualMin < lo) { lo = s.visualMin; }
        if (s.visualMax != 0 - 1 && s.visualMax > hi) { hi = s.visualMax; }
        if (hi <= lo) { return 0; }
        double tt = (v - lo) / (hi - lo);
        if (tt < 0) { tt = 0; }
        if (tt > 1) { tt = 1; }
        return (int)(tt * 1000.0 + 0.5);
    }

    static int TmLerp(int lo, int hi, int tPerMille) {
        return lo + (hi - lo) * tPerMille / 1000;
    }

    /// zrender modifyHSL 的饱和度通道：ARGB 的 S 置为 sat（千分值
    /// 0..1000），H/L 不变；灰阶（max==min）原样返回。
    static int RgbSat(int color, int satPerMille) {
        int r = (color >> 16) & 255;
        int g = (color >> 8) & 255;
        int b = color & 255;
        double rf = r / 255.0;
        double gf = g / 255.0;
        double bf = b / 255.0;
        double mx = rf;
        if (gf > mx) { mx = gf; }
        if (bf > mx) { mx = bf; }
        double mn = rf;
        if (gf < mn) { mn = gf; }
        if (bf < mn) { mn = bf; }
        if (mx - mn < 0.000001) { return color; }
        double l = (mx + mn) / 2.0;
        double h;
        if (mx == rf) {
            h = (gf - bf) / (mx - mn);
        } else if (mx == gf) {
            h = 2.0 + (bf - rf) / (mx - mn);
        } else {
            h = 4.0 + (rf - gf) / (mx - mn);
        }
        h = h / 6.0;
        if (h < 0) { h = h + 1.0; }
        double s = satPerMille / 1000.0;
        if (s < 0) { s = 0; }
        if (s > 1) { s = 1; }
        double c2 = (1.0 - ChartView.DAbs(2.0 * l - 1.0)) * s;
        double hp = h * 6.0;
        double frac = hp - 2.0 * (int)(hp / 2.0);
        double x = c2 * (1.0 - ChartView.DAbs(frac - 1.0));
        double rr = 0;
        double gg = 0;
        double bb = 0;
        int sector = (int)hp;
        if (sector > 5) { sector = 5; }
        if (sector == 0) { rr = c2; gg = x; }
        else if (sector == 1) { rr = x; gg = c2; }
        else if (sector == 2) { gg = c2; bb = x; }
        else if (sector == 3) { gg = x; bb = c2; }
        else if (sector == 4) { rr = x; bb = c2; }
        else { rr = c2; bb = x; }
        double m = l - c2 / 2.0;
        int ri = (int)((rr + m) * 255.0 + 0.5);
        int gi = (int)((gg + m) * 255.0 + 0.5);
        int bi = (int)((bb + m) * 255.0 + 0.5);
        if (ri < 0) { ri = 0; }
        if (ri > 255) { ri = 255; }
        if (gi < 0) { gi = 0; }
        if (gi > 255) { gi = 255; }
        if (bi < 0) { bi = 0; }
        if (bi > 255) { bi = 255; }
        return (0 - 16777216) + (ri << 16) + (gi << 8) + bi;
    }

    /// 多档渐变取色：stops 均匀分段，t 千分值 0..1000，段内
    /// App.LerpColor 插值（VisualMapping linear × color 数组）。
    static int PaletteLerp(List<int> stops, int tPerMille) {
        if (stops == null || stops.Count < 1) { return 0; }
        if (stops.Count == 1) { return stops[0]; }
        int t = tPerMille;
        if (t < 0) { t = 0; }
        if (t > 1000) { t = 1000; }
        long seg = (long)t * (stops.Count - 1);
        int idx = (int)(seg / 1000);
        int frac = (int)(seg % 1000);
        if (idx >= stops.Count - 1) { return stops[stops.Count - 1]; }
        return App.LerpColor(stops[idx], stops[idx + 1], frac);
    }

    /// 父格上带标签（官方 upperLabel 几何 {x+borderWidth, y,
    /// w-2·borderWidth, upperHeight}，白字，放不下裁剪）。
    static void TmUpperLabel(App app, int x, int y, int w, int hgt, string name) {
        if (name == null || name.Length < 1) { return; }
        Canvas c = app.canvas;
        int fs = ChartFonts.SeriesLabel(app);
        int fh = Canvas.FontHeight(fs);
        if (hgt < fh || w < app.Scale(8)) { return; }
        c.PushClip(x, y, w, hgt);
        ChartView.DrawTextClamped(c, x + app.Scale(3), y + (hgt - fh) / 2,
            name, 0xFFFFFFFF, fs, x, y, w, hgt);
        c.PopClip();
    }

    /// 布局 + 绘制一体递归（官方 squarify 行循环 + treemapVisual 的
    /// designated 视觉传播）：每层先画父格底/上带，再 squarify 铺子格、
    /// 按级映射子色并递归；叶子填充 + 描边 + 标签。rects 收集全部格子
    /// （父先子后，倒序即命中序）。self = 当前节点（虚拟根传 null），
    /// nodes = 其子列表（虚拟根传 lead.tree）。
    static void TmLayoutPaint(App app, ChartSeries s, ChartNode self,
                              List<ChartNode> nodes, int depth,
                              int rx, int ry, int rw, int rh,
                              int desigColor, int desigSat,
                              List<TmRect> rects, Dict<string, int> idmap) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        TmStyle st = ChartView.TmStyleOf(app, s, depth);
        int color = self != null && self.color != 0 ? self.color : desigColor;
        int kids = nodes == null ? 0 : nodes.Count;
        bool overLeaf = s.leafDepth >= 0 && s.leafDepth <= depth;
        if (self != null && (kids < 1 || overLeaf)) {
            // ---- 叶格（或 leafDepth 截断的叶根）：designated 色 ----
            if (color == 0) { color = Chart.Palette(t, 0); }
            int fill = color;
            if (desigSat >= 0) { fill = ChartView.RgbSat(fill, desigSat); }
            int stroke = st.borderColor;
            if (st.borderColorSat >= 0) {
                stroke = ChartView.RgbSat(fill, st.borderColorSat);
            }
            if (rw > 0 && rh > 0) {
                c.FillRect(rx, ry, rw, rh, fill);
                if (st.borderWidth > 0 && rw > st.borderWidth * 2
                    && rh > st.borderWidth * 2) {
                    c.DrawRect(rx, ry, rw, rh, stroke, st.borderWidth);
                }
                ChartView.TreemapCell(app, rx, ry, rw, rh,
                    ChartView.TreeNodeName(self));
            }
            rects.Add(TmRect.Of(self, depth, rx, ry, rw, rh));
            return;
        }
        if (self != null && kids > 0) {
            // ---- 父格：底 = borderColor；borderColorSat 声明时底色 =
            // 自身色调饱和（官方 stroke 失效语义，bg 同源）----
            int bg = st.borderColor;
            if (st.borderColorSat >= 0) {
                int pcol = color != 0 ? color : Chart.Palette(t, 0);
                bg = ChartView.RgbSat(pcol, st.borderColorSat);
            }
            c.FillRect(rx, ry, rw, rh, bg);
            if (st.upperShow == 1 && rh > st.upperHeight) {
                ChartView.TmUpperLabel(app, rx, ry, rw, st.upperHeight,
                    ChartView.TreeNodeName(self));
            }
            rects.Add(TmRect.Of(self, depth, rx, ry, rw, rh));
        }
        if (kids < 1) { return; }

        // ---- 内容区 insets（官方：layoutOffset = borderWidth -
        // halfGapWidth，layoutOffsetUpper = upperHeight - halfGapWidth）----
        double halfGap = st.gapWidth / 2.0;
        double lox = st.borderWidth - halfGap;
        double loy = st.upperHeight - halfGap;
        double cw = rw - lox * 2;
        if (cw < 0) { cw = 0; }
        double chh = rh - lox - loy;
        if (chh < 0) { chh = 0; }
        double totalArea = cw * chh;
        if (totalArea < 1) { return; }

        // ---- 子面积 = 子值 / 和 × 内容区面积（官方 initChildren：
        // 面积恒取维 0 子树和，visualDimension 只喂颜色映射的
        // dataExtent；double 域，obama 量级不溢出）----
        int dim = s.visualDimension;
        double sum = 0;
        List<double> areas = new List<double>();
        for (int i = 0; i < kids; i = i + 1) {
            double v = ChartView.TreemapValue(nodes[i]);
            if (v < 0) { v = 0; }
            areas.Add(v);
            sum = sum + v;
        }
        if (sum <= 0) { return; }
        for (int i = 0; i < kids; i = i + 1) {
            areas[i] = areas[i] / sum * totalArea;
        }

        // ---- 官方 squarify 行循环：worst 变差则整行落位 ----
        TmBox box = new TmBox();
        box.x = rx + lox;
        box.y = ry + loy;
        box.w = cw;
        box.h = chh;
        double side = ChartView.DMin(box.w, box.h);
        double best = 1.7976931348623157e308;
        double ratio = ChartView.TmSquareRatio();
        List<int> row = new List<int>();
        int base0 = rects.Count;
        int i2 = 0;
        while (i2 < kids) {
            row.Add(i2);
            double score = ChartView.TmWorst(ChartView.TmRowArea(row, areas),
                ChartView.TmRowMax(row, areas), ChartView.TmRowMin(row, areas),
                side, ratio);
            if (score <= best) {
                i2 = i2 + 1;
                best = score;
            } else {
                row.RemoveAt(row.Count - 1);
                ChartView.TmPosition(box, row, areas, side, halfGap, false,
                    depth + 1, rects);
                side = ChartView.DMin(box.w, box.h);
                row.Clear();
                best = 1.7976931348623157e308;
            }
        }
        if (row.Count > 0) {
            ChartView.TmPosition(box, row, areas, side, halfGap, true,
                depth + 1, rects);
        }

        // ---- 官方 statistic dataExtent（子级取值域，供映射归一）----
        double extLo = 0;
        double extHi = 0;
        bool hasExt = false;
        for (int i = 0; i < kids; i = i + 1) {
            double v = ChartView.TmNodeValue(nodes[i], dim);
            if (!hasExt) {
                extLo = v;
                extHi = v;
                hasExt = true;
                continue;
            }
            if (v < extLo) { extLo = v; }
            if (v > extHi) { extHi = v; }
        }

        // ---- 官方 buildVisualMapping：color 数组 > (单色 ×
        // colorSaturation 域)；映射不到则子级继承 designated ----
        List<int> colorRange = st.color;
        bool useSatRange = (colorRange == null || colorRange.Count < 1)
            && st.hasColorSat == 1 && color != 0;
        if (colorRange != null && colorRange.Count < 1) { colorRange = null; }

        for (int i = 0; i < kids; i = i + 1) {
            ChartNode child = nodes[i];
            TmRect rc = rects[base0 + i];
            rc.node = child;
            int childColor = color;
            int childSat = desigSat;
            if (colorRange != null) {
                if (st.colorMappingBy == 1) {
                    // 'value'：线性域 × 多档渐变（treemap-visual）。
                    childColor = ChartView.PaletteLerp(colorRange,
                        ChartView.TmValueT(s, extLo, extHi,
                            ChartView.TmNodeValue(child, dim)));
                } else if (st.colorMappingBy == 2) {
                    // 'id'：全树 preorder 号循环（obama）。
                    int di = i;
                    if (child.id != null && child.id.Length > 0) {
                        int found = 0;
                        if (idmap.TryGetValue(child.id, out found)) { di = found; }
                    }
                    childColor = colorRange[di % colorRange.Count];
                } else {
                    // 'index'：兄弟序号循环（官方缺省）。
                    childColor = colorRange[i % colorRange.Count];
                }
            } else if (useSatRange) {
                childSat = ChartView.TmLerp(st.satLo, st.satHi,
                    ChartView.TmValueT(s, extLo, extHi,
                        ChartView.TmNodeValue(child, dim)));
            }
            ChartView.TmLayoutPaint(app, s, child, child.children, depth + 1,
                rc.x, rc.y, rc.w, rc.h, childColor, childSat, rects, idmap);
        }
    }

    /// 矩形树图叶格名称标签（官方 label 缺省 {b} 白字
    /// insideTopLeft），仅放得下时绘制，并用单元格矩形裁剪，
    /// 避免长名称画出格子。
    static void TreemapCell(App app, int x, int y, int w, int h, string name) {
        Canvas c = app.canvas;
        int fs = ChartFonts.SeriesLabel(app);
        int fh = Canvas.FontHeight(fs);
        if (name == null || name.Length < 1) { return; }
        if (w < app.Scale(20) || h < fh + app.Scale(4)) { return; }
        c.PushClip(x, y, w, h);
        ChartView.DrawTextClamped(c, x + app.Scale(3), y + app.Scale(2),
            name, 0xFFFFFFFF, fs, x, y, w, h);
        c.PopClip();
    }

    /// ---- 旭日图（同心环；最内环 = 根的子节点） ----

    /// 子树最大深度（叶 = 1）。
    static int TreeDepth(ChartNode n) {
        int md = 0;
        int childCount = ChartView.TreeChildCount(n);
        for (int i = 0; i < childCount; i = i + 1) {
            int d = ChartView.TreeDepth(n.children[i]);
            if (d > md) { md = d; }
        }
        return md + 1;
    }

    /// 旭日图实际绘制的环数 = 根到叶的父子边数（根节点本身
    /// 不占一圈）；因此 root->leaf 应为 1 圈，而不是 TreeDepth=2
    /// 再额外除以一圈，造成外径只到 rMax/3。
    static int SunburstRingCount(ChartNode root) {
        if (root == null) { return 0; }
        int rings = ChartView.TreeDepth(root) - 1;
        if (rings < 1) { rings = 1; }
        return rings;
    }

    /// 每环厚度：rMax 均分给 rings 环（至少 1px）。
    static int SunburstRingHeight(int rMax, int rings) {
        if (rMax < 1 || rings < 1) { return 0; }
        int ringH = rMax / rings;
        if (ringH < 1) { ringH = 1; }
        return ringH;
    }

    /// 子树节点总数（含根）。
    static int TreeNodeCount(ChartNode n) {
        if (n == null || n.children == null) { return n == null ? 0 : 1; }
        int count = 1;
        for (int i = 0; i < n.children.Count; i = i + 1) {
            count = count + ChartView.TreeNodeCount(n.children[i]);
        }
        return count;
    }

    /// 稳定 preorder 下标供 Tree/Treemap 的 dataIndex 使用；节点对象
    /// 没有独立 id，因此不能使用每帧重新分配的命中句柄。
    /// 不在子树内返回 -1。
    static int TreeNodeIndex(ChartNode root, ChartNode target) {
        if (root == null || target == null) { return 0 - 1; }
        if (root == target) { return 0; }
        int offset = 1;
        int childCount = ChartView.TreeChildCount(root);
        for (int i = 0; i < childCount; i = i + 1) {
            ChartNode child = root.children[i];
            int found = ChartView.TreeNodeIndex(child, target);
            if (found >= 0) { return offset + found; }
            offset = offset + ChartView.TreeNodeCount(child);
        }
        return 0 - 1;
    }

    /// 树图漫游开关（o.roam 透传；独立 seam 便于测试）。
    static bool TreeRoamEnabled(bool roam) { return roam; }

    /// 节点命中热区半径：补固定可访问性余量；zoom < 50 时减半，
    /// 不能随 zoom 无限扩大，否则空白或相邻节点会被远距离圆点吞掉。
    static int TreeHitRadius(int radius, int zoom, int scale) {
        if (radius < 0) { radius = 0; }
        if (scale < 1) { scale = 1; }
        // 命中热区只补固定的可访问性余量；不能随 zoom 无限扩大，
        // 否则空白或相邻节点会被远距离圆点吞掉。
        int extra = scale * 3;
        if (zoom < 50) { extra = scale * 2; }
        return radius + extra;
    }

    /// 圆角矩形包含测试（含圆角处精确判定），treemap 命中用。
    static bool TreemapContains(int px, int py, int x, int y, int w, int h, int radius) {
        if (w < 1 || h < 1 || px < x || px >= x + w || py < y || py >= y + h) {
            return false;
        }
        int rr = radius;
        if (rr < 0) { rr = 0; }
        if (rr > w / 2) { rr = w / 2; }
        if (rr > h / 2) { rr = h / 2; }
        if (rr < 1) { return true; }
        int dx = 0;
        if (px < x + rr) { dx = x + rr - px; }
        if (px >= x + w - rr) { dx = px - (x + w - rr - 1); }
        int dy = 0;
        if (py < y + rr) { dy = y + rr - py; }
        if (py >= y + h - rr) { dy = py - (y + h - rr - 1); }
        if (dx > 0 && dy > 0) {
            return dx * dx + dy * dy <= rr * rr;
        }
        return true;
    }

    /// 旭日图可见扫掠末端：rawEnd 裁到 sweepMax（rawEnd < 0 = 完整圆）。
    static int SunburstVisibleEnd(int rawEnd, int sweepMax) {
        if (sweepMax < 0) { sweepMax = 0; }
        if (sweepMax > 360) { sweepMax = 360; }
        if (rawEnd < 0) { return rawEnd; }
        if (rawEnd > sweepMax) { return sweepMax; }
        return rawEnd;
    }

    /// 旭日图环形命中测试：按 SunRingList 相同的角扫掠 + 环带
    /// 半径遍历，指针角度命中的组节点递归（不做半径早退，否则内
    /// 环会挡住所有外环指针）；叶节点校验指针距离落在环带
    /// [rStart, rEnd]。nodes 为深度 depth 的兄弟组（虚拟根语义，
    /// lead.tree 条目 = 深度 1）。
    static void SunburstHit(App app, ChartSeries s, int cx, int cy,
                            int rMax, int rPer, List<ChartNode> nodes, int depth,
                            int a0, int a1, int sweepMax, int px, int py) {
        if (nodes == null || nodes.Count < 1) { return; }
        int total = 0;
        for (int i = 0; i < nodes.Count; i = i + 1) {
            total = total + nodes[i].Total();
        }
        if (total < 1) { return; }
        int ddx = px - cx;
        int ddy = py - cy;
        int ang = ChartView.AngleOf(ddx, ddy);
        int a = a0;
        int visibleEnd = ChartView.SunburstVisibleEnd(a1, sweepMax);
        if (visibleEnd <= a0) { return; }
        SunBand band = ChartView.SunBandOf(app, s, depth, rMax, rPer);
        for (int i = 0; i < nodes.Count; i = i + 1) {
            ChartNode k = nodes[i];
            int v = k.Total();
            int span = (a1 - a0) * v / total;
            int aEnd = a + span;
            int hitEnd = aEnd;
            if (hitEnd > visibleEnd) { hitEnd = visibleEnd; }
            if (ang >= a && ang < hitEnd) {
                if (k.children.Count > 0) {
                    // 组节点命中角度区间就递归：子叶所在的环带由
                    // 叶子命中处自行校验，这里不做半径早退——否则
                    // 内环的角度检查会挡住所有外环指针。
                    ChartView.SunburstHit(app, s, cx, cy, rMax, rPer, k.children,
                        depth + 1, a, aEnd, sweepMax, px, py);
                } else {
                    int dist = ChartView.ISqrt(ddx * ddx + ddy * ddy);
                    if (dist >= band.rStart && dist <= band.rEnd) {
                        ChartView.ttName = k.name;
                        ChartView.ttVal = v;
                        ChartView.ttA0 = a;
                        // 高亮必须和本帧实际 reveal 的扇区相同，不能
                        // 用未裁剪的 raw end 把尚未绘制的尾部画出来。
                        ChartView.ttA1 = hitEnd;
                        ChartView.ttDepth = depth;
                        ChartView.ttSunNode = k;
                    }
                }
                return;
            }
            a = a + span;
        }
    }

    /// 深度 d 的环带：levels[min(d, len-1)] 的 r0/r 优先（数字 px 过
    /// Scale、百分比对 rMax 折算，官方 parsePercent 对 size/2），
    /// 缺省 = rPer 均分。
    static SunBand SunBandOf(App app, ChartSeries s, int depth, int rMax, int rPer) {
        SunBand b = new SunBand();
        b.rStart = depth * rPer;
        b.rEnd = (depth + 1) * rPer;
        ChartLevel lv = ChartView.TmLevel(s, depth);
        if (lv != null) {
            if (lv.r0Pct >= 0) { b.rStart = lv.r0Pct * rMax / 1000; }
            else if (lv.r0 >= 0) { b.rStart = app.Scale(lv.r0); }
            if (lv.rPct >= 0) { b.rEnd = lv.rPct * rMax / 1000; }
            else if (lv.r >= 0) { b.rEnd = app.Scale(lv.r); }
        }
        if (b.rEnd < b.rStart) { b.rEnd = b.rStart; }
        return b;
    }

    /// 角度归一到 [-90, 90]（DrawTextRot 的钳制域），保证文字不倒置。
    static int SunUpright(int angle) {
        int a = angle % 360;
        if (a > 180) { a = a - 360; }
        if (a > 90) { a = a - 180; }
        if (a < -90) { a = a + 180; }
        return a;
    }

    /// 扇区标签：级/系 rotate 声明（1 radial 2 tangential 3 角度，
    /// 官方缺省 radial），色 = 级色 > 系色 > 图表标签前景；角跨
    /// ≥ 4° 且环带厚 ≥ 字高才画，锚定中点半径（绕锚点旋转，
    /// 锚为未旋行盒左上角）。
    static void SunLabel(App app, ChartSeries s, ChartNode node, int cx, int cy,
                         SunBand band, int a0, int a1, int depth) {
        if (node.name == null || node.name.Length < 1) { return; }
        int span = a1 - a0;
        if (span < 4 || band.rEnd - band.rStart < 1) { return; }
        ChartLevel lv = ChartView.TmLevel(s, depth);
        int mode = lv != null && lv.labelMode != 0 ? lv.labelMode
            : (s.sunLabelMode != 0 ? s.sunLabelMode : 1);
        int color = lv != null && lv.labelColor != 0 ? lv.labelColor
            : (s.sunLabelColor != 0 ? s.sunLabelColor
                : Style.Part(app, "chart", "label", "", "", "",
                    Style.SNormal()).FgOr(0));
        int fs = ChartFonts.SeriesLabel(app);
        int fh = Canvas.FontHeight(fs);
        if (band.rEnd - band.rStart < fh) { return; }
        int tw = Canvas.MeasureText(node.name, fs);
        int mid = (a0 + a1) / 2;
        int rm = (band.rStart + band.rEnd) / 2;
        double rad = mid * 3.14159265358979 / 180.0;
        int px = cx + (int)(Math.Cos(rad) * rm);
        int py = cy + (int)(Math.Sin(rad) * rm);
        Canvas c = app.canvas;
        if (mode == 3) {
            int rot = lv != null && lv.labelMode == 3 ? lv.labelRotate
                : s.sunLabelRotate;
            c.DrawTextRot(px - tw / 2, py - fh / 2, node.name, color, fs,
                ChartView.SunUpright(rot));
            return;
        }
        if (mode == 2) {
            // 切向：沿圆周方向（半径垂线），翻转保持可读。
            c.DrawTextRot(px - tw / 2, py - fh / 2, node.name, color, fs,
                ChartView.SunUpright(mid + 90));
            return;
        }
        if (mode == 1) {
            // 径向：沿半径方向。
            c.DrawTextRot(px - tw / 2, py - fh / 2, node.name, color, fs,
                ChartView.SunUpright(mid));
            return;
        }
        c.DrawTextRot(px - tw / 2, py - fh / 2, node.name, color, fs, 0);
    }

    /// 旭日图绘制入口：lead.tree 条目为深度 1（官方 data 恒在虚拟
    /// 根之下），环带半径按 levels r0/r（缺省均分）；扇区色 = 节点色
    /// > 级单色 > 系级纯色 > 深度 1 主题调色板 > 向父色白化；描边 =
    /// 系级 itemStyle borderWidth/borderColor；标签 rotate radial/
    /// tangential/角度（官方缺省 radial）。支持 hover 高亮 + tooltip
    /// + Node 点击事件。`g` 为出现动画进度（千分值 → 扫掠角）。
    static void DrawSunburst(App app, int x, int y, int w, int h,
                             ChartOption o, int g) {
        Canvas c = app.canvas;
        ChartSeries lead = ChartView.LeadSeries(o);
        if (lead == null || lead.tree == null || lead.tree.Count < 1) { return; }
        int top = ChartView.PanelHead(app, x, y, w, h, o.title);
        int pad = app.theme.paddingMedium;
        int areaY = top;
        int areaH = (y + h - pad) - top;
        if (areaH < app.Scale(16)) { areaH = app.Scale(16); }
        int cx = x + w / 2;
        int cy = areaY + areaH / 2;
        int rMax = (w - pad * 2) / 2;
        if (areaH / 2 < rMax) { rMax = areaH / 2; }
        if (rMax < app.Scale(10)) { rMax = app.Scale(10); }
        int sweepMax = 360 * g / 1000;

        // 环数 = 各根子树的最大父子边数（深度 1 起算）。
        int rings = 1;
        for (int i = 0; i < lead.tree.Count; i = i + 1) {
            int d = ChartView.SunburstRingCount(lead.tree[i]);
            if (d > rings) { rings = d; }
        }
        int rPer = ChartView.SunburstRingHeight(rMax, rings);
        ChartView.SunRingList(app, lead, cx, cy, rMax, rPer, lead.tree, 1,
            0, 360, sweepMax, 0);

        // 命中几何与 tooltip 展示解耦：关闭 tooltip 不能关闭
        // Sunburst 叶子的 Hover/MouseOut/Click 事件。
        int mx = app.mouseX;
        int my = app.mouseY;
        int ddx = mx - cx;
        int ddy = my - cy;
        int dist = ChartView.ISqrt(ddx * ddx + ddy * ddy);
        if (dist <= rMax) {
            ChartView.ttName = "";
            ChartView.ttVal = 0;
            ChartView.ttSunNode = null;
            ChartView.SunburstHit(app, lead, cx, cy, rMax, rPer, lead.tree, 1,
                0, 360, sweepMax, mx, my);
            if (ChartView.ttSunNode != null
                && ChartView.activeEventView != null) {
                ChartHit th = ChartHit.Of(ChartElementType.Node,
                    ChartView.SeriesIndexOf(o, lead), lead.name,
                    ChartView.TmNodeIndex(lead.tree, ChartView.ttSunNode),
                    ChartView.ttName, ChartView.ttVal, mx, my);
                th.axisIndex = lead.axisIndex;
                ChartView.OfferActiveHit(th);
            }
            if (o.showTooltip && ChartView.ttName.Length > 0) {
                // 悬停扇区环带外缘的高亮圆环。
                SunBand hb = ChartView.SunBandOf(app, lead, ChartView.ttDepth,
                    rMax, rPer);
                int hiInner = hb.rEnd - app.Scale(2);
                if (hiInner < hb.rStart) { hiInner = hb.rStart; }
                c.FillSector(cx, cy, hiInner, hb.rEnd,
                    ChartView.ttA0, ChartView.ttA1, 0xFFFFFFFF);
                List<TooltipRow> rows = new List<TooltipRow>{
                    TooltipRow.Of(0, o.title),
                    TooltipRow.Of(0xFFFFFFFF,
                        ChartView.ttName + "  " + Convert.ToString(ChartView.ttVal)) };
                ChartView.TooltipCard(app, mx, my, x + w, rows);
            }
        }
    }

    /// 递归绘制一层旭日环：nodes 为深度 depth 的兄弟组，扇区角按
    /// 子树 Total() 分配；色阶见入口注释，环带经 SunBandOf 决议，
    /// 递归用未裁剪 rawEnd（同官方 startAngle 累计）。
    static void SunRingList(App app, ChartSeries s, int cx, int cy,
                            int rMax, int rPer, List<ChartNode> nodes, int depth,
                            int a0, int a1, int sweepMax, int parentCol) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        if (nodes == null || nodes.Count < 1) { return; }
        int total = 0;
        for (int i = 0; i < nodes.Count; i = i + 1) {
            total = total + nodes[i].Total();
        }
        if (total < 1) { return; }
        SunBand band = ChartView.SunBandOf(app, s, depth, rMax, rPer);
        ChartLevel lv = ChartView.TmLevel(s, depth);
        int a = a0;
        for (int i = 0; i < nodes.Count; i = i + 1) {
            ChartNode k = nodes[i];
            int v = k.Total();
            int span = (a1 - a0) * v / total;
            int rawEnd = a + span;
            int visibleEnd = ChartView.SunburstVisibleEnd(rawEnd, sweepMax);
            int col = k.color != 0 ? k.color
                : (lv != null && lv.colorOne != 0 ? lv.colorOne
                    : (s.sunItemColor != 0 ? s.sunItemColor
                        : (depth == 1 ? Chart.Palette(t, i)
                            : App.LerpColor(parentCol, 0xFFFFFFFF,
                                100 + (depth - 1) * 70))));
            if (visibleEnd > a && band.rEnd > band.rStart) {
                c.FillSector(cx, cy, band.rStart, band.rEnd, a, visibleEnd, col);
                if (s.tmBorderWidth > 0) {
                    c.DrawArc(cx, cy, band.rStart, band.rEnd, a, visibleEnd,
                        s.tmBorderColor != 0 ? s.tmBorderColor : 4294967295,
                        s.tmBorderWidth);
                }
                ChartView.SunLabel(app, s, k, cx, cy, band, a, visibleEnd, depth);
                if (k.children.Count > 0) {
                    ChartView.SunRingList(app, s, cx, cy, rMax, rPer, k.children,
                        depth + 1, a, rawEnd, sweepMax, col);
                }
            }
            a = rawEnd;
        }
    }

    /// ---- 桑基图（分层节点间的流量连线） ----

    /// 节点名 → 列表下标（不存在 = -1，线性查找）。
    static int SankeyIndexOf(List<SankeyNodeLayout> nodes, string name) {
        for (int i = 0; i < nodes.Count; i = i + 1) {
            if (nodes[i].name == name) { return i; }
        }
        return 0 - 1;
    }

    /// 出现动画进度（0..1000）→ 连线/节点 alpha（0..255）。
    static int SankeyRevealAlpha(int progress) {
        if (progress < 0) { progress = 0; }
        if (progress > 1000) { progress = 1000; }
        return 255 * progress / 1000;
    }

    /// 桑基图（sankey）绘制入口：links 驱动，最长路径分层（松弛
    /// 最多 n-1 轮 + 回边压平，循环图布局稳定终止）。节点高度按
    /// max(入, 出) 流量分配；连线按流量定宽，支持连线 hover
    /// tooltip（Link 事件）。`g` 为出现动画进度（0..1000 → alpha）。
    static void DrawSankey(App app, int x, int y, int w, int h,
                           ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        List<ChartSeries> series = o.series;
        if (series.Count < 1 || series[0].links.Count < 1) { return; }
        List<ChartLink> links = series[0].links;
        int top = ChartView.PanelHead(app, x, y, w, h, o.title);
        int pad = t.paddingMedium;

        // 按首次出现顺序的节点列表。
        List<SankeyNodeLayout> nodes = new List<SankeyNodeLayout>();
        int li = 0;
        for (; li < links.Count; li = li + 1) {
            ChartLink lk = links[li];
            if (ChartView.SankeyIndexOf(nodes, lk.from) < 0) {
                nodes.Add(SankeyNodeLayout.Of(lk.from));
            }
            if (ChartView.SankeyIndexOf(nodes, lk.to) < 0) {
                nodes.Add(SankeyNodeLayout.Of(lk.to));
            }
        }
        // 最长路径分层：layer(to) >= layer(from) + 1。循环图会让
        // 朴素松弛永不收敛，因此最多跑（节点数-1）轮——简单
        // 路径长度的上界；剩下的回边把目标压到源节点同层，
        // 保证终止且布局稳定。
        int relaxRounds = nodes.Count - 1;
        if (relaxRounds < 1) { relaxRounds = 1; }
        for (int rr = 0; rr < relaxRounds; rr = rr + 1) {
            bool changed = false;
            li = 0;
            while (li < links.Count) {
                ChartLink lk = links[li];
                int fi = ChartView.SankeyIndexOf(nodes, lk.from);
                int ti = ChartView.SankeyIndexOf(nodes, lk.to);
                if (nodes[ti].layer < nodes[fi].layer + 1) {
                    nodes[ti].layer = nodes[fi].layer + 1;
                    changed = true;
                }
                li = li + 1;
            }
            if (!changed) { break; }
        }
        // 回边固定：目标层未领先源层的边，把目标放到源同层
        // （循环边的水平退化布局），此后每条边都满足
        // layer(to) >= layer(from)，不再有反向边。
        li = 0;
        while (li < links.Count) {
            ChartLink lk = links[li];
            int fi = ChartView.SankeyIndexOf(nodes, lk.from);
            int ti = ChartView.SankeyIndexOf(nodes, lk.to);
            if (nodes[ti].layer < nodes[fi].layer) {
                nodes[ti].layer = nodes[fi].layer;
            }
            li = li + 1;
        }
        int maxLayer = 0;
        for (int nk = 0; nk < nodes.Count; nk = nk + 1) {
            if (nodes[nk].layer > maxLayer) { maxLayer = nodes[nk].layer; }
        }
        if (maxLayer < 1) { maxLayer = 1; }
        int nLayers = maxLayer + 1;

        // 节点流量（入/出取较大者）决定节点高度。
        int nn = nodes.Count;
        li = 0;
        while (li < links.Count) {
            ChartLink lk = links[li];
            int fi = ChartView.SankeyIndexOf(nodes, lk.from);
            int ti = ChartView.SankeyIndexOf(nodes, lk.to);
            nodes[fi].flowOut = nodes[fi].flowOut + lk.val;
            nodes[ti].flowIn = nodes[ti].flowIn + lk.val;
            li = li + 1;
        }

        int colW = (w - pad * 2) / nLayers;
        int nodeW = colW * 3 / 8;
        if (nodeW < app.Scale(18)) { nodeW = app.Scale(18); }
        int areaH = (y + h - pad) - top;
        int colH = areaH * 8 / 10;

        // 每列流量合计，用于垂直堆叠。
        List<int> colTotal = new List<int>();
        List<int> colCum = new List<int>();
        for (int lc = 0; lc < nLayers; lc = lc + 1) { colTotal.Add(0); colCum.Add(0); }
        int ni = 0;
        for (; ni < nn; ni = ni + 1) {
            SankeyNodeLayout node = nodes[ni];
            int fl = node.flowOut;
            if (fl < node.flowIn) { fl = node.flowIn; }
            colTotal[node.layer] = colTotal[node.layer] + fl;
        }

        ni = 0;
        while (ni < nn) {
            SankeyNodeLayout node = nodes[ni];
            int fl = node.flowOut;
            if (fl < node.flowIn) { fl = node.flowIn; }
            int th2 = colTotal[node.layer];
            if (th2 < 1) { th2 = 1; }
            node.h = colH * fl / th2;
            if (node.h < app.Scale(4)) { node.h = app.Scale(4); }
            node.x = x + pad + node.layer * colW;
            node.y = top + (areaH - colH) / 2 + colCum[node.layer];
            colCum[node.layer] = colCum[node.layer] + node.h + app.Scale(4);
            ni = ni + 1;
        }

        // 先画连线（节点会盖住其边缘）：从
        // 源节点右缘到目标节点左缘的粗圆角色带。
        int maxFlow = 1;
        li = 0;
        while (li < links.Count) { if (links[li].val > maxFlow) { maxFlow = links[li].val; } li = li + 1; }
        int maxTh = app.Scale(10);
        int revealAlpha = ChartView.SankeyRevealAlpha(g);
        ChartView.PushPlotClip(app, x + pad, top, w - pad * 2, areaH);
        li = 0;
        while (li < links.Count) {
            ChartLink lk = links[li];
            int fi = ChartView.SankeyIndexOf(nodes, lk.from);
            int ti = ChartView.SankeyIndexOf(nodes, lk.to);
            int th = maxTh * lk.val / maxFlow;
            if (th < app.Scale(2)) { th = app.Scale(2); }
            SankeyNodeLayout fromNode = nodes[fi];
            SankeyNodeLayout toNode = nodes[ti];
            int x0 = fromNode.x + nodeW;
            int y0 = fromNode.y + fromNode.h / 2;
            int x1 = toNode.x;
            int y1 = toNode.y + toNode.h / 2;
            c.DrawLine(x0, y0, x1, y1,
                Chart.WithAlpha(Chart.Palette(t, fi), 170 * revealAlpha / 255), th);
            li = li + 1;
        }
        c.PopClip();

        // 节点 + 标签（源列标签左对齐，其余右对齐）。
        ni = 0;
        while (ni < nn) {
            SankeyNodeLayout node = nodes[ni];
            c.FillRoundRect(node.x, node.y, nodeW, node.h,
                app.Scale(3), Chart.WithAlpha(Chart.Palette(t, ni), revealAlpha));
            int fs = ChartFonts.SeriesLabel(app);
            int fh = Canvas.FontHeight(fs);
            int lx2 = node.x + nodeW + app.Scale(4);
            if (node.layer == 0) {
                lx2 = node.x - app.Scale(4) - Canvas.MeasureText(node.name, fs);
            }
            c.DrawText(lx2, node.y + node.h / 2 - fh / 2,
                node.name,
                Chart.WithAlpha(Style.Part(app, "chart", "label", "", "", "", Style.SNormal()).FgOr(0), revealAlpha), fs);
            ni = ni + 1;
        }

        int mx = app.mouseX;
        int my = app.mouseY;
        bool insideSankey = g > 0 && mx >= x + pad && mx < x + w - pad
            && my >= top && my < top + areaH;
        // 连线悬停：使用与绘制相同的实际线宽，并限制在绘图区。
        int bestL = 0 - 1;
        int bestD = 0;
        if (insideSankey) {
            li = 0;
            while (li < links.Count) {
                ChartLink lk = links[li];
                int fi = ChartView.SankeyIndexOf(nodes, lk.from);
                int ti = ChartView.SankeyIndexOf(nodes, lk.to);
                SankeyNodeLayout fromNode = nodes[fi];
                SankeyNodeLayout toNode = nodes[ti];
                int x0 = fromNode.x + nodeW;
                int y0 = fromNode.y + fromNode.h / 2;
                int x1 = toNode.x;
                int y1 = toNode.y + toNode.h / 2;
                int d = ChartView.DistToSeg(mx, my, x0, y0, x1, y1);
                int th = maxTh * lk.val / maxFlow;
                if (th < app.Scale(2)) { th = app.Scale(2); }
                int linkR = th / 2 + app.Scale(1);
                if (d <= linkR && (bestL < 0 || d < bestD)) {
                    bestL = li;
                    bestD = d;
                }
                li = li + 1;
            }
        }
        if (bestL >= 0) {
            ChartLink hk = links[bestL];
            int fi = ChartView.SankeyIndexOf(nodes, hk.from);
            int ti = ChartView.SankeyIndexOf(nodes, hk.to);
            SankeyNodeLayout fromNode = nodes[fi];
            SankeyNodeLayout toNode = nodes[ti];
            int x0 = fromNode.x + nodeW;
            int y0 = fromNode.y + fromNode.h / 2;
            int x1 = toNode.x;
            int y1 = toNode.y + toNode.h / 2;
            int th = maxTh * hk.val / maxFlow;
            if (th < app.Scale(2)) { th = app.Scale(2); }
            int linkR = th / 2 + app.Scale(1);
            if (bestD <= linkR) {
                string linkName = hk.from + " -> " + hk.to;
                ChartHit sk = ChartHit.Of(ChartElementType.Link, 0,
                    series[0].name, bestL, linkName, hk.val, mx, my);
                ChartView.OfferActiveHit(sk);
                if (o.showTooltip) {
                    c.DrawLine(x0, y0, x1, y1,
                        Chart.WithAlpha(0xFFFFFFFF, revealAlpha), app.Scale(3));
                    List<TooltipRow> rows = new List<TooltipRow>{
                        TooltipRow.Of(0, o.title),
                        TooltipRow.Of(Chart.WithAlpha(Chart.Palette(t, fi), revealAlpha),
                            hk.from + " → " + hk.to + "  " + Convert.ToString(hk.val)) };
                    ChartView.TooltipCard(app, mx, my, x + w, rows);
                }
            }
        }
    }

    // ---- 树形图（ECharts type 'tree'；分层节点连接图） ----

    /// 节点下的叶子槽位数（一个叶子 = 1 个槽位）。
    static int TreeLeafCount(ChartNode n) {
        int childCount = ChartView.TreeChildCount(n);
        if (childCount == 0) { return 1; }
        int s = 0;
        for (int i = 0; i < childCount; i = i + 1) { s = s + ChartView.TreeLeafCount(n.children[i]); }
        return s;
    }

    /// 官方 TreeSeries.ts:185-191 的展开态：item.collapsed 优先
    /// （isExpand = !collapsed），否则 depth <= expandTreeDepth。
    static bool TreeExpanded(ChartNode n, int depth, int effDepth) {
        if (n.collapsed) { return false; }
        return depth <= effDepth;
    }

    /// 展开态子树的可见叶子数（折叠子树算 1 个叶子位）。
    static int TreeVisLeafCount(ChartNode n, int effDepth, int depth) {
        int childCount = ChartView.TreeChildCount(n);
        if (childCount == 0) { return 1; }
        if (!ChartView.TreeExpanded(n, depth, effDepth)) { return 1; }
        int s = 0;
        for (int i = 0; i < childCount; i = i + 1) {
            s = s + ChartView.TreeVisLeafCount(n.children[i], effDepth, depth + 1);
        }
        return s;
    }

    /// 展开态子树的最大可见深度（层数）。
    static int TreeVisDepth(ChartNode n, int effDepth, int depth) {
        int childCount = ChartView.TreeChildCount(n);
        int md = 0;
        if (childCount > 0 && ChartView.TreeExpanded(n, depth, effDepth)) {
            for (int i = 0; i < childCount; i = i + 1) {
                int d = ChartView.TreeVisDepth(n.children[i], effDepth, depth + 1);
                if (d > md) { md = d; }
            }
            return md + 1;
        }
        return 1;
    }

    /// 有效展开深度：expandAndCollapse=false → -1 哨兵（全展开，
    /// 用一个大数）；initialTreeDepth>=0 → 声明值；否则官方缺省 2
    /// （TreeSeries.ts:293）。
    static int TreeExpandDepth(ChartOption o, int fullDepth) {
        ChartSeries lead = ChartView.LeadSeries(o);
        if (lead == null) { return 2; }
        if (!lead.treeExpandCollapse) { return fullDepth + 1; }
        if (lead.initialTreeDepth < 0) { return fullDepth + 1; }
        return lead.initialTreeDepth;
    }


    /// 为每个节点分配 span 坐标：节点跨越叶子 [lo, hi)，
    /// 其中心位于该叶子范围中点。span 在垂直树中
    /// 从左到右，在水平树中从上到下。
    static void TreeAssign(ChartNode n, int lo, int depth,
                           List<TreeLayoutNode> layout) {
        layout.Add(TreeLayoutNode.Of(n, depth, lo, ChartView.TreeLeafCount(n)));
        int childCount = ChartView.TreeChildCount(n);
        if (childCount > 0) {
            int acc = lo;
            for (int i = 0; i < childCount; i = i + 1) {
                ChartView.TreeAssign(n.children[i], acc, depth + 1, layout);
                acc = acc + ChartView.TreeLeafCount(n.children[i]);
            }
        }
    }
    /// 展开态版：折叠节点不产出子节点布局行（官方 collapse 后
    /// 子树不参与布局），其叶子位由 collapsed 子树以 1 位占。
    static void TreeAssignEx(ChartNode n, int lo, int depth, int effDepth,
                             List<TreeLayoutNode> layout) {
        int vis = ChartView.TreeVisLeafCount(n, effDepth, depth);
        layout.Add(TreeLayoutNode.Of(n, depth, lo, vis));
        int childCount = ChartView.TreeChildCount(n);
        if (childCount > 0 && ChartView.TreeExpanded(n, depth, effDepth)) {
            int acc = lo;
            for (int i = 0; i < childCount; i = i + 1) {
                ChartView.TreeAssignEx(n.children[i], acc, depth + 1, effDepth, layout);
                acc = acc + ChartView.TreeVisLeafCount(n.children[i], effDepth, depth + 1);
            }
        }
    }

    /// 布局节点在增长缩放后的 span 上叶子范围的中心。
    static int TreeSpan(TreeLayoutNode node, int spanG, int leaves) {
        long pos = (long)(2 * node.lo + node.count) * spanG / (2 * leaves);
        return (int)pos;
    }

    /// 子树中最宽节点标签（像素），预留树图 span 间距用。
    static int TreeLabelWidth(ChartNode n, int fs) {
        int widest = Canvas.MeasureText(ChartView.TreeNodeName(n), fs);
        int childCount = ChartView.TreeChildCount(n);
        for (int i = 0; i < childCount; i = i + 1) {
            int childW = ChartView.TreeLabelWidth(n.children[i], fs);
            if (childW > widest) { widest = childW; }
        }
        return widest;
    }

    /// 树图父子边折线点集（屏幕坐标）：type 语义同 ECharts2
    /// lineStyle.type——""/"broken" 三段直角、solid 直线、curve
    /// 三次贝塞尔（控制点在深度中点，12 段采样）、dashed/dotted
    /// 直角折线（虚线由调用方 DrawDashed 实现）。
    static void TreeEdgePoints(List<int> xs, List<int> ys,
                               int p0, int p1, int q0, int q1,
                               bool horiz, string type) {
        xs.Clear();
        ys.Clear();
        if (type == "solid") {
            int sx = horiz ? p1 : p0;
            int sy = horiz ? p0 : p1;
            int ex = horiz ? q1 : q0;
            int ey = horiz ? q0 : q1;
            xs.Add(sx); ys.Add(sy);
            xs.Add(ex); ys.Add(ey);
            return;
        }
        if (type == "curve") {
            // 三次贝塞尔（span/depth 二维各自插值）：P0=父、
            // C1=(父 span, 深度中点)、C2=(子 span, 深度中点)、
            // P3=子——出入边都沿深度方向，在中点平滑转向。
            // 权重和恒 1e9，12 段采样。
            int mid = (p1 + q1) / 2;
            for (int i = 0; i <= 12; i = i + 1) {
                int tt = i * 1000 / 12;
                int mt = 1000 - tt;
                long w0 = (long)mt * mt * mt;
                long w1 = 3L * mt * mt * tt;
                long w2 = 3L * mt * tt * tt;
                long w3 = (long)tt * tt * tt;
                int spanC = (int)((w0 * p0 + w1 * p0 + w2 * q0 + w3 * q0) / 1000000000);
                int depC = (int)((w0 * p1 + w1 * mid + w2 * mid + w3 * q1) / 1000000000);
                if (horiz) { xs.Add(depC); ys.Add(spanC); }
                else { xs.Add(spanC); ys.Add(depC); }
            }
            return;
        }
        // broken / dashed / dotted：三段直角。
        if (horiz) {
            int mid = (p1 + q1) / 2;
            xs.Add(p1); ys.Add(p0);
            xs.Add(mid); ys.Add(p0);
            xs.Add(mid); ys.Add(q0);
            xs.Add(q1); ys.Add(q0);
        } else {
            int mid = (p1 + q1) / 2;
            xs.Add(p0); ys.Add(p1);
            xs.Add(p0); ys.Add(mid);
            xs.Add(q0); ys.Add(mid);
            xs.Add(q0); ys.Add(q1);
        }
    }

    /// 词云放置尝试：矩形 (x,y,w,h) 与已放置词条是否都不相交。
    static bool WordCloudFits(List<WordCloudItem> placed, int x, int y, int w, int h) {
        for (int i = 0; i < placed.Count; i = i + 1) {
            WordCloudItem item = placed[i];
            if (x < item.x + item.w && x + w > item.x
                && y < item.y + item.h && y + h > item.y) { return false; }
        }
        return true;
    }

    /// 词云（wordCloud）绘制入口：放置结果按内容指纹缓存（每帧
    /// 重建 option 不重算布局）；字号按权重、放不下自动缩小。
    /// 支持 hover tooltip + WordTag 点击事件。`g` 为出现动画进度。
    static void DrawWordCloud(App app, int x, int y, int w, int h,
                              ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        ChartSeries lead = ChartView.LeadSeries(o);
        int top = Chart.DrawPanelI(app, x, y, w, h, o.legendTextColor, o.title, o.series,
            o.iwid, o.showLegend);
        if (lead == null || lead.data.Count == 0) { return; }

        int pad = app.Scale(10);
        int ax = x + pad;
        int ay = top + app.Scale(2);
        int aw = w - pad * 2;
        int ah = (y + h - pad) - ay;
        if (aw < app.Scale(24) || ah < app.Scale(24)) { return; }

        int maxV = 1;
        for (int i = 0; i < lead.data.Count; i = i + 1) {
            if (lead.data[i].val > maxV) { maxV = lead.data[i].val; }
        }

        int minFs = lead != null && lead.wcMinFontSize > 0
            ? app.Scale(lead.wcMinFontSize) : app.Scale(11);
        int maxFs = lead != null && lead.wcMaxFontSize > 0
            ? app.Scale(lead.wcMaxFontSize) : app.Scale(36);
        if (maxFs > ah / 3) { maxFs = ah / 3; }
        if (maxFs > aw / 6) { maxFs = aw / 6; }
        if (maxFs < minFs) { maxFs = minFs; }
        bool vary = lead != null && lead.wcRotate == "vary";
        string rotList = lead != null ? lead.wcRotateList : "";
        if (rotList == "0") { rotList = ""; }  // 单一 0° = 不旋转，等同空
        if (rotList.Length > 0) { vary = false; }

        int wfp = ChartView.WordCloudFingerprint(lead.data, aw, ah, minFs, maxFs,
            vary ? 1 : 0 + ChartView.WordCloudRotListKey(rotList));
        if (ChartView.wcCache == null) {
            ChartView.wcCache = new List<WordCloudCacheEntry>();
        }
        List<WordCloudItem> placed = null;
        WordCloudCacheEntry hit = WordCloudCacheEntry.Lookup(ChartView.wcCache, wfp);
        if (hit != null) { placed = hit.items; }

        if (placed == null) {
            placed = ChartView.PlaceWordCloud(app, t, lead.data, aw, ah,
                minFs, maxFs, maxV, vary, rotList);
            WordCloudCacheEntry.Store(ChartView.wcCache, wfp, placed, 4);
        }

        int alpha = 255 * g / 1000;
        if (alpha < 0) { alpha = 0; }
        if (alpha > 255) { alpha = 255; }
        c.PushClip(ax, ay, aw, ah);
        for (int wi = 0; wi < placed.Count; wi = wi + 1) {
            WordCloudItem it = placed[wi];
            int col = Chart.WithAlpha(it.color, alpha);
            if (it.rot == 0) {
                c.DrawText(ax + it.x, ay + it.y, it.data.name, col, it.fontSize);
            } else {
                // 绕锚点顺时针 90°：锚点取旋转后包围盒右上角，字形
                // 落回 [x, x+w]×[y, y+h]（w/h 已是交换后的包围盒）。
                c.DrawTextRot(ax + it.x + it.w, ay + it.y, it.data.name,
                    col, it.fontSize, it.rot);
            }
        }
        c.PopClip();

        // typed 命中：词条包围盒（PlaceWordCloud 存的就是轴对齐
        // 包围盒，rot != 0 的 x/y/w/h 也已交换投影），dataIndex 取
        // 源 lead.data 下标（放置顺序按值降序重排，不能直接当
        // data 下标用）。命中计算与 showTooltip 解耦。
        int mx = app.mouseX;
        int my = app.mouseY;
        if (g > 0 && mx >= ax && mx < ax + aw && my >= ay && my < ay + ah
            && ChartView.activeEventView != null) {
            int lx = mx - ax;
            int ly = my - ay;
            for (int wi2 = 0; wi2 < placed.Count; wi2 = wi2 + 1) {
                WordCloudItem it2 = placed[wi2];
                if (lx >= it2.x && lx < it2.x + it2.w
                    && ly >= it2.y && ly < it2.y + it2.h) {
                    int srcIdx = 0 - 1;
                    for (int di = 0; di < lead.data.Count; di = di + 1) {
                        if (lead.data[di] == it2.data) { srcIdx = di; }
                    }
                    if (srcIdx >= 0) {
                        ChartHit wh = ChartHit.Of(ChartElementType.WordTag,
                            ChartView.SeriesIndexOf(o, lead), lead.name,
                            srcIdx, it2.data.name, it2.data.val,
                            mx, my);
                        wh.axisIndex = lead.axisIndex;
                        ChartView.OfferActiveHit(wh);
                    }
                }
            }
        }
    }

    /// 阿基米德螺旋放置：字号按权重，放不下就缩小，坐标相对绘图区。
    /// vary 为真时奇数词条旋转 90°（ECharts wordCloud rotateRange
    /// 的 0/90 两态）；rotList 非空时按词条序号对角度集取模轮转
    /// （ECharts textRotation 数组的确定性取法——随机/任意角度会破坏
    /// 布局缓存与截图回归，角度仍限于 ±90 内由 DrawTextRot 支持）。
    /// 旋转项的包围盒按 |sin|/|cos| 投影计算（非 90° 角不再简单交换
    /// 宽高），碰撞检测与裁剪都用包围盒。
    static List<WordCloudItem> PlaceWordCloud(App app, Theme t, List<ChartData> src,
                                              int aw, int ah, int minFs, int maxFs,
                                              int maxV, bool vary, string rotList) {
        List<int> angles = new List<int>();
        if (rotList != null && rotList.Length > 0) {
            List<string> parts = rotList.Split(',');
            for (int pi = 0; pi < parts.Count; pi = pi + 1) {
                int deg = Convert.ToInt32(parts[pi].Trim());
                if (deg != 0) { angles.Add(deg); }
            }
            if (angles.Count == 0) { angles.Add(0); }
        }
        List<ChartData> words = new List<ChartData>();
        for (int i = 0; i < src.Count; i = i + 1) { words.Add(src[i]); }
        for (int a = 0; a < words.Count; a = a + 1) {
            int best = a;
            for (int b = a + 1; b < words.Count; b = b + 1) {
                if (words[b].val > words[best].val) { best = b; }
            }
            if (best != a) {
                ChartData tmp = words[a];
                words[a] = words[best];
                words[best] = tmp;
            }
        }

        List<WordCloudItem> placed = new List<WordCloudItem>();
        int maxR = (aw < ah ? aw : ah) / 2;
        if (maxR < app.Scale(24)) { maxR = app.Scale(24); }
        int attempts = 480;
        for (int wi = 0; wi < words.Count; wi = wi + 1) {
            ChartData word = words[wi];
            if (word.name.Length < 1) { continue; }
            int fs = minFs + (maxFs - minFs) * word.val / maxV;
            int color = word.color;
            if (color == 0) { color = Chart.Palette(t, wi); }
            int rotDeg = 0;
            if (angles.Count > 0) {
                rotDeg = angles[wi % angles.Count];
            } else if (vary && wi % 2 == 1) {
                rotDeg = 90;
            }
            // 非零角度的占位盒：文本行绕锚点刚性旋转后的轴对齐包围盒。
            // 90° 即宽高交换；其余角度按 |sin|/|cos| 投影（DrawTextRot
            // 钳制 ±90，sin/cos 用同一张千分表）。
            bool rot = rotDeg != 0;
            int ad = rotDeg < 0 ? 0 - rotDeg : rotDeg;
            int sPct = ChartView.SinDeg(ad);
            int cPct = ChartView.CosDeg(ad);
            bool done = false;
            int shrink = 0;
            while (!done && shrink < 10) {
                int tw = Canvas.MeasureText(word.name, fs) + app.Scale(6);
                int th = Canvas.FontHeight(fs) + app.Scale(2);
                // 旋转项占位盒 = 原行绕锚点旋转后的轴对齐包围盒。
                int bw = rot ? (tw * cPct + th * sPct) / 1000 : tw;
                int bh = rot ? (tw * sPct + th * cPct) / 1000 : th;
                if (bw < 1) { bw = 1; }
                if (bh < 1) { bh = 1; }
                if (bw > aw - 2) {
                    if (fs <= minFs) { done = true; }
                    else { fs = fs - 2; if (fs < minFs) { fs = minFs; } }
                    shrink = shrink + 1;
                    continue;
                }
                if (bh > ah - 2) {
                    if (fs <= minFs) { done = true; }
                    else { fs = fs - 2; if (fs < minFs) { fs = minFs; } }
                    shrink = shrink + 1;
                    continue;
                }
                int attempt = 0;
                while (attempt < attempts && !done) {
                    int angle = (attempt * 137 + wi * 53) % 360;
                    int radius = maxR * attempt / attempts;
                    int cx = aw / 2 + ChartView.CosDeg(angle) * radius / 1000;
                    int cy = ah / 2 + ChartView.SinDeg(angle) * radius / 1000;
                    int tx = cx - bw / 2;
                    int ty = cy - bh / 2;
                    if (tx < 0) { tx = 0; }
                    if (ty < 0) { ty = 0; }
                    if (tx + bw > aw) { tx = aw - bw; }
                    if (ty + bh > ah) { ty = ah - bh; }
                    if (tx >= 0 && ty >= 0 && tx + bw <= aw && ty + bh <= ah
                        && ChartView.WordCloudFits(placed, tx, ty, bw, bh)) {
                        placed.Add(WordCloudItem.Of(word, tx, ty, bw, bh, fs, color,
                            rotDeg));
                        done = true;
                    } else {
                        attempt = attempt + 1;
                    }
                }
                if (!done) {
                    if (fs <= minFs) { done = true; }
                    else { fs = fs - 2; if (fs < minFs) { fs = minFs; } }
                    shrink = shrink + 1;
                }
            }
        }
        return placed;
    }

    /// 词云内容指纹（词条 + 盒子几何 + 旋转模式）：布局缓存键，
    /// 必须覆盖所有影响放置结果的输入。
    static int WordCloudFingerprint(List<ChartData> data, int aw, int ah,
                                    int minFs, int maxFs, int rotate) {
        int fp = (aw * 7 + ah * 13 + minFs * 17 + maxFs * 19 + rotate * 29)
            % 2000000000;
        for (int i = 0; i < data.Count; i = i + 1) {
            fp = ChartView.FoldStr(fp, data[i].name, 23);
            fp = (fp * 31 + data[i].val) % 2000000000;
        }
        return fp;
    }

    /// 自定义角度集的指纹成分："0,45,-45" → 稳定小整数（空串 = 0）。
    static int WordCloudRotListKey(string rotList) {
        if (rotList == null || rotList.Length == 0) { return 0; }
        int h = 977;
        for (int i = 0; i < rotList.Length; i = i + 1) {
            h = (h * 31 + rotList[i]) % 997;
        }
        return h + 2;
    }

    /// 词云布局缓存：指纹 → 放置结果（小容量，见 WordCloudCacheEntry）。
    static List<WordCloudCacheEntry> wcCache;

    /// 无限画布网格：世界原点落在视口 (ax - panX, ay - panY)，
    /// 间距随缩放变稀/变密，密到看不清时跳级。
    /// 无限画布网格第一根线：从世界坐标原点向视口 [view0, view0+…)
    /// 对齐的最近网格线。
    static int TreeGridFirst(int origin, int view0, int gs) {
        if (gs < 1) { return view0; }
        int x = origin;
        if (x < view0) {
            int d = view0 - x;
            x = x + (d / gs) * gs;
            if (x < view0) { x = x + gs; }
        } else if (x > view0) {
            int d = x - view0;
            x = x - (d / gs) * gs;
        }
        return x;
    }

    /// 画无限画布网格：世界原点落在视口 (ax - panX, ay - panY)，
    /// 间距随缩放变稀/变密，密到看不清时跳级。
    static void DrawTreeCanvasGrid(App app, Canvas c, int ax, int ay, int aw, int ah,
                                   int panX, int panY, int zoom) {
        int worldStep = app.Scale(28);
        int gs = worldStep * zoom / 100;
        while (gs < app.Scale(18) && worldStep < 512) {
            worldStep = worldStep * 2;
            gs = worldStep * zoom / 100;
        }
        if (gs < 8) { return; }
        int col = Chart.WithAlpha(Style.Part(app, "chart", "grid", "", "", "",
            Style.SNormal()).BgOr(0), 55);
        int originX = ax - panX;
        int originY = ay - panY;
        int gx = ChartView.TreeGridFirst(originX, ax, gs);
        int n = 0;
        while (gx < ax + aw && n < 256) {
            if (gx >= ax) { c.FillRect(gx, ay, 1, ah, col); }
            int nx = gx + gs;
            if (nx <= gx) { n = 256; } else { gx = nx; }
            n = n + 1;
        }
        int gy = ChartView.TreeGridFirst(originY, ay, gs);
        n = 0;
        while (gy < ay + ah && n < 256) {
            if (gy >= ay) { c.FillRect(ax, gy, aw, 1, col); }
            int ny = gy + gs;
            if (ny <= gy) { n = 256; } else { gy = ny; }
            n = n + 1;
        }
    }

    /// 树形图（tree）绘制入口：ECharts type 'tree' 的分层节点连接
    /// 图。roam 开启时滚轮缩放（CaptureWheel 仲裁防外层滚动打架）
    /// + 拖拽平移，首帧自动适配整树；无限画布网格背景。支持
    /// hover tooltip + Node 点击（拖拽超过阈值时吞掉 click）。
    static void DrawTree(App app, int x, int y, int w, int h,
                         ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        ChartSeries lead = ChartView.LeadSeries(o);
        if (lead == null || lead.tree == null || lead.tree.Count < 1) { return; }
        ChartNode root = lead.tree[0];
        if (root == null) { return; }
        int plotTop = ChartView.PanelHead(app, x, y, w, h, o.title);
        int pad = t.paddingMedium;
        int ax = x + pad;
        int ay = plotTop;
        int aw = w - pad * 2;
        int ah = (y + h - pad) - plotTop;
        int hintFs = ChartFonts.SeriesLabel(app);
        int hintH = Canvas.FontHeight(hintFs) + app.Scale(6);
        if (ah > hintH + app.Scale(24)) { ah = ah - hintH; }
        if (aw < app.Scale(10) || ah < app.Scale(10)) { return; }

        bool horiz = false;
        if (lead.treeOrient == "horizontal") { horiz = true; }

        // N6：官方缺省展开到第 2 层（initialTreeDepth 缺省 2），
        // collapsed 逐项反义；可见叶数/深度决定 span 网格与缩放。
        int effDepth = ChartView.TreeExpandDepth(o, ChartView.TreeDepth(root));
        int leaves = ChartView.TreeVisLeafCount(root, effDepth, 0);
        int depth = ChartView.TreeVisDepth(root, effDepth, 0);
        if (leaves < 1) { leaves = 1; }
        if (depth < 1) { depth = 1; }

        // 稳定命中 id（AllocId 每帧换号会让滚轮/拖拽丢目标）。
        // roam 关闭时不注册抓手区域；开启时优先复用图表根命中区，
        // 避免独立 panId 覆盖 ChartView 的 Click/DoubleClick 所有权。
        int panId = Chart.TreeHitKey(o.iwid);
        if (ChartView.activeEventView != null
            && ChartView.activeEventView.eventHitId >= 0) {
            panId = ChartView.activeEventView.eventHitId;
        }
        if (ChartView.TreeRoamEnabled(o.roam)) {
            app.hitTester.RegisterRect(panId, ax, ay, aw, ah, 0);
        }

        // 字号保持可读：缩放改节点间距，标签跟节点走、越出视口裁掉。
        int fs = ChartFonts.SeriesLabel(app);
        int fh = Canvas.FontHeight(fs);
        int labelW = ChartView.TreeLabelWidth(root, fs);
        int rad = app.Scale(4);
        int gapSpan = 0;
        int gapDep = 0;
        if (horiz) {
            gapSpan = fh + app.Scale(14);
            if (gapSpan < app.Scale(22)) { gapSpan = app.Scale(22); }
            gapDep = labelW + rad * 2 + app.Scale(28);
            if (gapDep < app.Scale(40)) { gapDep = app.Scale(40); }
        } else {
            gapSpan = labelW + app.Scale(16);
            if (gapSpan < app.Scale(36)) { gapSpan = app.Scale(36); }
            gapDep = rad * 2 + fh + app.Scale(22);
            if (gapDep < app.Scale(32)) { gapDep = app.Scale(32); }
        }

        int natSpan = leaves * gapSpan;
        int natDep = depth * gapDep + app.Scale(8);
        int natW = horiz ? (natDep + labelW + rad) : natSpan;
        int natH = horiz ? natSpan : (natDep + fh + rad);

        int zoom = app.StateGet(Chart.TreeZoomKey(o.iwid), 0);
        int panX = app.StateGet(Chart.TreePanXKey(o.iwid), 0);
        int panY = app.StateGet(Chart.TreePanYKey(o.iwid), 0);
        if (zoom == 0) {
            zoom = 100;
            if (natW > aw && natW > 0) { zoom = aw * 90 / natW; }
            int zH = 100;
            if (natH > ah && natH > 0) { zH = ah * 90 / natH; }
            if (zH < zoom) { zoom = zH; }
            if (zoom < 20) { zoom = 20; }
            if (zoom > 100) { zoom = 100; }
            panX = natW * zoom / 200 - aw / 2;
            panY = natH * zoom / 200 - ah / 2;
            app.StateSet(Chart.TreeZoomKey(o.iwid), zoom);
            app.StateSet(Chart.TreePanXKey(o.iwid), panX);
            app.StateSet(Chart.TreePanYKey(o.iwid), panY);
        }
        // 滚轮缩放走 CaptureWheel 仲裁（与 ScrollView/DataTable 同一
        // 机制）：只按 hover-id 消费会和外层滚动条打架——指针悬在树
        // 图上滚一格，图缩放的同时整页也滚 60px，图从指针底下挪走后
        // hover 又断，滚轮步幅忽大忽小（用户报告的“滚轮跳跃”）。声明
        // 本绘图区后，最后声明者（即最内层）独占这一格，外层不再滚。
        if (ChartView.TreeRoamEnabled(o.roam)
            && app.CaptureWheel(ax, ay, aw, ah)) {
            int ticks = ChartView.WheelTicks(app);
            int next = ChartView.ZoomByTicks(zoom, ticks, 20, 400);
            if (next != zoom && zoom > 0) {
                panX = (app.mouseX - ax + panX) * next / zoom - (app.mouseX - ax);
                panY = (app.mouseY - ay + panY) * next / zoom - (app.mouseY - ay);
                zoom = next;
                app.StateSet(Chart.TreeZoomKey(o.iwid), zoom);
                app.StateSet(Chart.TreePanXKey(o.iwid), panX);
                app.StateSet(Chart.TreePanYKey(o.iwid), panY);
                app.RequestRedraw();
            }
        }
        gapSpan = gapSpan * zoom / 100;
        gapDep = gapDep * zoom / 100;
        if (gapSpan < 2) { gapSpan = 2; }
        if (gapDep < 2) { gapDep = 2; }

        int contentSpan = leaves * gapSpan;
        int contentDep = depth * gapDep + app.Scale(8);
        if (contentSpan < 2) { contentSpan = 2; }
        if (contentDep < 2) { contentDep = 2; }
        int contentW = horiz ? (contentDep + labelW + rad) : contentSpan;
        int contentH = horiz ? contentSpan : (contentDep + fh + rad);

        if (ChartView.TreeRoamEnabled(o.roam)
            && Ui.PressedDown(app, panId) && app.window.EventButton() == 0) {
            app.StateSet(Chart.TreeDragXKey(o.iwid), app.mouseX);
            app.StateSet(Chart.TreeDragYKey(o.iwid), app.mouseY);
            app.StateSet(Chart.TreeDragPanXKey(o.iwid), panX);
            app.StateSet(Chart.TreeDragPanYKey(o.iwid), panY);
            app.StateSet(Chart.TreeDragMovedKey(o.iwid), 0);
            app.StateSet(Chart.TreeDraggingKey(o.iwid), 1);
            if (app.TouchDevice()) { app.ClaimDrag(); }
        }
        bool treeDragging = app.StateGet(Chart.TreeDraggingKey(o.iwid), 0) == 1;
        if (ChartView.TreeRoamEnabled(o.roam) && treeDragging
            && Ui.Pressed(app, panId) && app.EventKind() == 1) {
            int dxMove = app.mouseX - app.StateGet(Chart.TreeDragXKey(o.iwid), app.mouseX);
            int dyMove = app.mouseY - app.StateGet(Chart.TreeDragYKey(o.iwid), app.mouseY);
            if (dxMove != 0 || dyMove != 0) {
                app.StateSet(Chart.TreeDragMovedKey(o.iwid), 1);
            }
            panX = app.StateGet(Chart.TreeDragPanXKey(o.iwid), panX) - dxMove;
            panY = app.StateGet(Chart.TreeDragPanYKey(o.iwid), panY) - dyMove;
            app.RequestRedraw();
        }
        if (app.EventKind() == 3) {
            if (treeDragging
                && app.StateGet(Chart.TreeDragMovedKey(o.iwid), 0) == 1) {
                app.ClaimClick();
            }
            app.StateSet(Chart.TreeDraggingKey(o.iwid), 0);
            app.StateSet(Chart.TreeDragMovedKey(o.iwid), 0);
        }
        panX = ChartView.ClampPan(panX, contentW, aw);
        panY = ChartView.ClampPan(panY, contentH, ah);
        app.StateSet(Chart.TreePanXKey(o.iwid), panX);
        app.StateSet(Chart.TreePanYKey(o.iwid), panY);

        int span0 = (horiz ? ay - panY : ax - panX);
        int dep0 = (horiz ? ax - panX : ay - panY) + app.Scale(8) * zoom / 100;
        int spanG = contentSpan;
        int depG = contentDep;

        int alpha = 255 * g / 1000;
        if (alpha < 40) { alpha = 40; }
        if (alpha > 255) { alpha = 255; }

        c.PushClip(ax, ay, aw, ah);
        ChartView.DrawTreeCanvasGrid(app, c, ax, ay, aw, ah, panX, panY, zoom);
        List<TreeLayoutNode> layout = new List<TreeLayoutNode>();
        ChartView.TreeAssignEx(root, 0, 0, effDepth, layout);

        int col = 0;
        if (lead != null) { col = lead.color; }
        if (col == 0) { col = Chart.Palette(t, 0); }
        int nodeCol = Chart.WithAlpha(col, alpha);
        // 边样式：treeLine 显式 color/type 优先；都未设置时透传
        // itemStyle.normal.lineStyle（ECharts2 JSON 通道）；再退回
        // 现状网格色直角线。
        int eCol = 0;
        string eType = "";
        int eW = 0;
        int eShadow = 0;
        if (lead != null) {
            eCol = lead.treeLine.color;
            eType = lead.treeLine.type;
            eW = lead.treeLine.width;
            eShadow = lead.treeLine.shadowColor;
            if (eCol == 0 && eType.Length < 1) {
                eCol = lead.itemStyle.normal.lineStyle.color;
                eType = lead.itemStyle.normal.lineStyle.type;
                if (eW == 0) { eW = lead.itemStyle.normal.lineStyle.width; }
            }
        }
        if (eW < 1) { eW = 1; }
        int linkCol = Chart.WithAlpha(eCol == 0
            ? Style.Part(app, "chart", "grid", "", "", "", Style.SNormal()).BgOr(0)
            : eCol, alpha);
        int lblCol = Chart.WithAlpha(Style.Part(app, "chart", "label", "", "", "",
            Style.SNormal()).FgOr(0), alpha);
        // shadowColor 的近似：右下偏移 app.Scale(2) 的暗色底层线
        // （Canvas 无模糊，ECharts2 shadowBlur 3/offset(3,5) 以此代）。
        int shCol = eShadow == 0
            ? 0 : Chart.WithAlpha(eShadow, 90 * alpha / 255);
        List<int> exs = new List<int>();
        List<int> eys = new List<int>();
        List<int> shXs = new List<int>();
        List<int> shYs = new List<int>();
        int ewpx = app.Scale(eW);
        int s2 = app.Scale(2);

        int i = 0;
        while (i < layout.Count) {
            TreeLayoutNode parent = layout[i];
            ChartNode n = parent.node;
            int childCount = ChartView.TreeChildCount(n);
            if (childCount == 0) { i = i + 1; continue; }
            int pSpan = ChartView.TreeSpan(parent, spanG, leaves);
            int pDep = parent.depth * gapDep;
            for (int c0 = 0; c0 < childCount; c0 = c0 + 1) {
                ChartNode ch = n.children[c0];
                int ci = 0;
                for (; ci < layout.Count; ci = ci + 1) {
                    if (layout[ci].node == ch) { break; }
                }
                if (ci >= layout.Count) { continue; }
                TreeLayoutNode child = layout[ci];
                int cSpan = ChartView.TreeSpan(child, spanG, leaves);
                int cDep = child.depth * gapDep;
                int p0 = span0 + pSpan;
                int p1 = dep0 + pDep;
                int q0 = span0 + cSpan;
                int q1 = dep0 + cDep;
                ChartView.TreeEdgePoints(exs, eys, p0, p1, q0, q1, horiz, eType);
                if (shCol != 0) {
                    shXs.Clear();
                    shYs.Clear();
                    for (int si = 0; si < exs.Count; si = si + 1) {
                        shXs.Add(exs[si] + s2);
                        shYs.Add(eys[si] + s2);
                    }
                    c.DrawPolyline(shXs, shYs, shCol, ewpx);
                }
                if (eType == "dashed") {
                    ChartView.DrawDashed(c, exs, eys, linkCol, ewpx,
                        app.Scale(6), app.Scale(4));
                } else if (eType == "dotted") {
                    ChartView.DrawDashed(c, exs, eys, linkCol, ewpx,
                        app.Scale(2), app.Scale(2));
                } else {
                    c.DrawPolyline(exs, eys, linkCol, ewpx);
                }
            }
            i = i + 1;
        }

        for (int j = 0; j < layout.Count; j = j + 1) {
            TreeLayoutNode item = layout[j];
            ChartNode n = item.node;
            int span = ChartView.TreeSpan(item, spanG, leaves);
            int d = item.depth * gapDep;
            int nx = horiz ? dep0 + d : span0 + span;
            int ny = horiz ? span0 + span : dep0 + d;
            if (nx + rad < ax || nx - rad > ax + aw
                || ny + rad + fh + app.Scale(6) < ay || ny - rad > ay + ah) {
                continue;
            }
            c.FillCircle(nx, ny, rad, nodeCol);
            // label.show（ECharts2 默认 true；tree.html 置 false 时
            // 静态不画，悬停 emphasis 时在命中段补画）。
            if (lead.labelShow) {
                string lbl = ChartView.TreeNodeName(n);
                int lw = Canvas.MeasureText(lbl, fs);
                int lx = 0;
                int ly = 0;
                if (horiz) {
                    lx = nx + rad + app.Scale(6);
                    ly = Canvas.CenterTextYAt(ny, fs);
                } else {
                    lx = nx - lw / 2;
                    ly = ny + rad + app.Scale(4);
                }
                c.DrawText(lx, ly, lbl, lblCol, fs);
            }
        }
        c.PopClip();

        c.DrawText(ax + app.Scale(4), ay + ah + app.Scale(2),
            "滚轮缩放  ·  拖拽平移  ·  还原适配",
            Style.Part(app, "chart", "hint", "", "", "", Style.SNormal()).FgOr(0),
            hintFs);

        if (app.mouseX >= ax && app.mouseX < ax + aw
            && app.mouseY >= ay && app.mouseY < ay + ah
            && app.StateGet(Chart.TreeDraggingKey(o.iwid), 0) == 0) {
            int mx = app.mouseX;
            int my = app.mouseY;
            int best = 0 - 1;
            int bestD2 = 0;
            bool bestDot = false;
            int hitRad = ChartView.TreeHitRadius(rad, zoom, app.Scale(1));
            for (int k = 0; k < layout.Count; k = k + 1) {
                TreeLayoutNode item = layout[k];
                int span = ChartView.TreeSpan(item, spanG, leaves);
                int d = item.depth * gapDep;
                int nx = horiz ? dep0 + d : span0 + span;
                int ny = horiz ? span0 + span : dep0 + d;
                if (nx + hitRad < ax || nx - hitRad >= ax + aw
                    || ny + hitRad + fh < ay || ny - hitRad >= ay + ah) {
                    continue;
                }
                string lbl = ChartView.TreeNodeName(item.node);
                int lw = Canvas.MeasureText(lbl, fs);
                int lx = horiz ? nx + rad + app.Scale(6) : nx - lw / 2;
                int ly = horiz ? Canvas.CenterTextYAt(ny, fs) : ny + rad + app.Scale(4);
                int dx = mx - nx;
                int dy = my - ny;
                int d2 = dx * dx + dy * dy;
                bool onDot = dx >= 0 - hitRad && dx <= hitRad
                    && dy >= 0 - hitRad && dy <= hitRad
                    && d2 <= hitRad * hitRad;
                bool onLbl = mx >= lx && mx < lx + lw && my >= ly && my < ly + fh;
                bool candidate = onDot || onLbl;
                if (!candidate) { continue; }
                // 节点圆点优先于标签；同一优先级取离指针最近者，
                // 避免低 zoom 时 preorder 的前节点吞掉后节点。
                bool replace = best < 0;
                if (!replace && onDot && !bestDot) { replace = true; }
                if (!replace && onDot == bestDot && d2 < bestD2) { replace = true; }
                if (replace) {
                    best = k;
                    bestD2 = d2;
                    bestDot = onDot;
                }
            }
            if (best >= 0) {
                ChartNode hn = layout[best].node;
                int nodeSeries = ChartView.SeriesIndexOf(o, lead);
                // ECharts2 节点显式 value（GroupVal）优先于子树累计。
                int hitVal = hn.Total();
                if (hn.val > 0) { hitVal = hn.val; }
                ChartHit th = ChartHit.Of(ChartElementType.Node,
                    nodeSeries, lead != null ? lead.name : "", best,
                    ChartView.TreeNodeName(hn), hitVal, mx, my);
                if (lead != null) { th.axisIndex = lead.axisIndex; }
                ChartView.OfferActiveHit(th);
                if (!lead.labelShow) {
                    // emphasis.label.show = true：静态标签隐藏时悬停补画。
                    int hSpan = ChartView.TreeSpan(layout[best], spanG, leaves);
                    int hDep = layout[best].depth * gapDep;
                    int hnx = horiz ? dep0 + hDep : span0 + hSpan;
                    int hny = horiz ? span0 + hSpan : dep0 + hDep;
                    string hl = ChartView.TreeNodeName(hn);
                    int hlw = Canvas.MeasureText(hl, fs);
                    int hlx = horiz ? hnx + rad + app.Scale(6) : hnx - hlw / 2;
                    int hly = horiz ? Canvas.CenterTextYAt(hny, fs) : hny + rad + app.Scale(4);
                    c.DrawText(hlx, hly, hl, lblCol, fs);
                }
                if (o.showTooltip) {
                    List<TooltipRow> rows = new List<TooltipRow>();
                    rows.Add(TooltipRow.Of(0, o.title));
                    string tv = Convert.ToString(hitVal);
                    rows.Add(TooltipRow.Of(col,
                        ChartView.TreeNodeName(hn) + "  " + tv));
                    ChartView.TooltipCard(app, mx, my, x + w, rows);
                }
            }
        }
    }
}
