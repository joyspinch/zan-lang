using System;

namespace Sdk.Jushuitan.Messages;

// 发货消息（action_code = sync_shipped）
public class ShipmentPushMessage {
    public long o_id;
    public string l_id;
    public string so_id;
    public string lc_id;
    public string order_from;
    public long wms_co_id;
    public string logistics_company;
    public string send_date;
    public bool is_send_all;
    public long shop_id;
    public List<ShipmentPushItem> items;
}

public class ShipmentPushItem {
    public long oi_id;
    public string sku_id;
    public double qty;
    public string name;
    public string outer_oi_id;
    public string so_id;
}

// 库存同步消息（action_code = business_sku_syn）
public class InventoryPushMessage {
    public double customizeQty1;
    public double customizeQty2;
    public double customizeQty3;
    public double pickLock;
    public double returnQty;
    public double purchaseQty;
    public double inQty;
    public double defectiveQty;
    public double qty;
    public string name;
    public string modified;
    public double orderLock;
    public double maxQty;
    public string skuId;
    public double virtualQty;
    public long coid;
    public string iId;
    public long wmscoid;
}

// 售后消息（action_code = trade_after_sale）
public class AfterSalePushMessage {
    public long asId;
    public string soId;
    public string created;
    public long coId;
    public string remark;
    public long oId;
    public string type;
    public string outerAsId;
    public string shopStatus;
    public string goodStatus;
    public string modified;
    public long shopId;
    public string asDate;
    public long wmsCoId;
    public int action;
    public List<AfterSalePushItem> items;
}

public class AfterSalePushItem {
    public string sku_id;
    public int qty;
    public int r_qty;
}

// 票聚消息（action_code = receipt_action，含蓝票与红票冲红字段）
public class ReceiptPushMessage {
    public string invoiceid;
    public string type;
    public string direct;
    public bool naturalperson;
    public bool jysstdywsdqy;
    public bool showbuyerbank;
    public bool showsellerbank;
    public bool showsellerinfo;
    public bool giveupdiscount;
    public bool checkbuyer;
    public bool showbuyerinfo;
    public long coid;
    public string soid;
    public ReceiptSeller seller;
    public ReceiptBuyer buyer;
    public string titletype;
    public double amount;
    public double taxamount;
    public double totalamount;
    public string comment;
    public List<ReceiptDetailItem> details;
    // 红票推送专用字段
    public string taxnumber;
    public string relateinvoiceid;
    public string relateinvoiceno;
    public string reasoncode;
}

public class ReceiptSeller {
    public string id;
    public bool bankAndAccountNotBlank;
    public string sellerName;
    public string taxNumber;
    public string bank;
    public string bankAccount;
    public bool addressAndPhoneNotBlank;
    public string phone;
    public string address;
    public string drawer;
    public string reviewer;
    public string payee;
    public string province;
}

public class ReceiptBuyer {
    public string title;
    public string taxNumber;
    public string bank;
    public string bankAccount;
    public string phone;
    public string address;
    public string email;
    public bool checkBuyer;
}

public class ReceiptDetailItem {
    public string id;
    public string lineType;
    public string skuTaxText;
    public string skuName;
    public bool taxFlag;
    public string amount;
    public double taxAmount;
    public double skuTaxRate;
    public double totalAmount;
    public string skuTaxCode;
    public string specs;
    public string unit;
    public double price;
    public double qty;
    public string dutyFree;
    public string preferentialFlag;
}
