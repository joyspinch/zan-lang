using System;
using System.Json;
using System.Net.Http;
using System.Text;
using Sdk.Jushuitan;

namespace Sdk.Jushuitan.Messages;

// 聚水潭开放平台新版消息接收协议（官方文档 28）。
public static class JushuitanMessageCallback {
    public const string SubscriptionCheck = "epaas_subscribe";
    public const string Shipment = "sync_shipped";
    public const string Inventory = "business_sku_syn";
    public const string AfterSale = "trade_after_sale";
    public const string Receipt = "receipt_action";

    private const string FormMediaType = "application/x-www-form-urlencoded";
    private const string Utf8 = "utf-8";
    private const string ProtocolVersion = "2";
    private const int TimestampDigits = 10;
    private const int MaxCallbackFields = 256;
    private const string AppKeyField = "app_key";
    private const string ActionCodeField = "action_code";
    private const string TimestampField = "timestamp";
    private const string VersionField = "version";
    private const string CharsetField = "charset";
    private const string BizField = "biz";
    private const string SignField = "sign";
    private static const string SuccessJson = "{\"code\":\"0\",\"msg\":\"执行成功\"}";
    private static const string FailureJson = "{\"code\":\"-1\",\"msg\":\"执行失败\"}";

    private static bool IsTrimWs(int c) {
        return c == 32 || c == 9 || c == 10 || c == 13 || c == 11 || c == 12;
    }

    private static int LowerAscii(int c) {
        return (c >= 65 && c <= 90) ? (c + 32) : c;
    }

    private static bool IsFormMediaType(string contentType) {
        if (contentType == null) { return false; }
        int end = contentType.Length;
        for (int i = 0; i < end; i = i + 1) {
            if ((contentType[i] & 255) == 59) { end = i; break; }
        }
        int start = 0;
        while (start < end && JushuitanMessageCallback.IsTrimWs(contentType[start] & 255)) { start = start + 1; }
        while (end > start && JushuitanMessageCallback.IsTrimWs(contentType[end - 1] & 255)) { end = end - 1; }
        if (end - start != 33) { return false; }
        string expected = JushuitanMessageCallback.FormMediaType;
        for (int i = 0; i < 33; i = i + 1) {
            int c = contentType[start + i] & 255;
            if (JushuitanMessageCallback.LowerAscii(c) != (expected[i] & 255)) { return false; }
        }
        return true;
    }

    private static bool IsUtf8(string charset) {
        if (charset.Length != 5) { return false; }
        return JushuitanMessageCallback.LowerAscii(charset[0] & 255) == 117
            && JushuitanMessageCallback.LowerAscii(charset[1] & 255) == 116
            && JushuitanMessageCallback.LowerAscii(charset[2] & 255) == 102
            && (charset[3] & 255) == 45
            && (charset[4] & 255) == 56;
    }

    // 单遍解码切片：无 '%'/ '+' 时直接 Substring，否则直写解码字节缓冲（免先 Substring 再 UrlDecode）。
    private static string DecodeFormSlice(string s, int start, int end, bool hasSpecial) {
        int len = end - start;
        if (len <= 0) { return ""; }
        if (!hasSpecial) {
            return s.Substring(start, len);
        }
        byte[] buf = new byte[len];
        int di = 0;
        int i = start;
        while (i < end) {
            int c = s[i] & 255;
            if (c == 43) { // '+'
                buf[di] = 32;
                di = di + 1;
                i = i + 1;
            } else if (c == 37 && i + 2 < end) {
                int hi = Encoding.HexDigit(s[i + 1] & 255);
                int lo = Encoding.HexDigit(s[i + 2] & 255);
                if (hi >= 0 && lo >= 0) {
                    buf[di] = (byte)((hi << 4) | lo);
                    di = di + 1;
                    i = i + 3;
                } else {
                    buf[di] = 37;
                    di = di + 1;
                    i = i + 1;
                }
            } else {
                buf[di] = (byte)c;
                di = di + 1;
                i = i + 1;
            }
        }
        return NativeMemory.GetString((nint)buf, 0, di);
    }

    public static JushuitanMessage Parse(HttpRequest request, string appKey, string appSecret) {
        return JushuitanMessageCallback.Parse(request, appKey, appSecret, 0L);
    }

    // maxAgeSeconds > 0 时额外校验回调 timestamp 与本机 UTC 时间差，防止重放。
    public static JushuitanMessage Parse(HttpRequest request, string appKey, string appSecret, long maxAgeSeconds) {
        if (maxAgeSeconds < 0L) {
            throw new JushuitanException("client.invalidArguments", "maxAgeSeconds 不能为负数", 0, "");
        }
        if (request == null || !request.IsPost()) {
            throw new JushuitanException("callback.invalidMethod", "消息回调要求 POST 请求", 0, "");
        }
        if (!JushuitanMessageCallback.IsFormMediaType(request.contentType)) {
            throw new JushuitanException("callback.invalidContentType", "消息回调要求 URL 编码表单", 0, "");
        }
        string body = request.body;
        if (String.IsNullOrEmpty(body)) {
            throw new JushuitanException("callback.invalidForm", "消息回调缺少表单", 0, "");
        }

        // 单遍融合校验 + URL 解码 + 重复键检测 + 必填字段提取（仅 2 数组、零 Dictionary 分配与二次扫描），
        // 并保持与原 ValidateForm → GetFormFields → ParseFields 完全一致的异常优先级。
        int len = body.Length;
        int cap = 8;
        string[] signKeys = new string[cap];
        string[] signVals = new string[cap];
        int signCnt = 0;
        long signPayloadLen = 0L;
        bool missingEq = false;
        bool hasDuplicate = false;

        string receivedAppKey = null;
        string actionCode = null;
        string timestamp = null;
        string version = null;
        string charset = null;
        string biz = null;
        string actualSign = null;

        int pos = 0;
        while (pos < len) {
            int pairStart = pos;
            int eq = -1;
            bool keySpecial = false;
            bool valSpecial = false;
            while (pos < len) {
                int c = body[pos] & 255;
                if (c == 37) { // '%'
                    if (len - pos < 3 || Encoding.HexDigit(body[pos + 1] & 255) < 0
                        || Encoding.HexDigit(body[pos + 2] & 255) < 0) {
                        throw new JushuitanException("callback.invalidForm", "消息回调表单含有非法百分号转义", 0, "");
                    }
                    if (eq < 0) { keySpecial = true; } else { valSpecial = true; }
                    pos = pos + 3;
                    continue;
                }
                if (c == 38) { break; } // '&'
                if (c == 61 && eq < 0) { eq = pos; }
                else if (c == 43) { if (eq < 0) { keySpecial = true; } else { valSpecial = true; } }
                pos = pos + 1;
            }
            int pairEnd = pos;
            if (pos < len) { pos = pos + 1; } // skip '&'

            if (eq <= pairStart) {
                missingEq = true;
                continue;
            }
            if (missingEq || hasDuplicate) {
                continue;
            }

            string k = JushuitanMessageCallback.DecodeFormSlice(body, pairStart, eq, keySpecial);
            if (k == JushuitanMessageCallback.SignField) {
                if (actualSign != null) { hasDuplicate = true; continue; }
                actualSign = JushuitanMessageCallback.DecodeFormSlice(body, eq + 1, pairEnd, valSpecial);
                continue;
            }
            for (int d = 0; d < signCnt; d = d + 1) {
                if (signKeys[d] == k) { hasDuplicate = true; break; }
            }
            if (hasDuplicate) { continue; }

            string v = JushuitanMessageCallback.DecodeFormSlice(body, eq + 1, pairEnd, valSpecial);
            if (signCnt >= JushuitanMessageCallback.MaxCallbackFields) {
                throw new JushuitanException("callback.invalidForm", "消息回调表单字段数量超出上限", 0, "");
            }
            if (signCnt >= cap) {
                int nextCap = cap * 2;
                string[] nsk = new string[nextCap];
                string[] nsv = new string[nextCap];
                for (int t = 0; t < signCnt; t = t + 1) { nsk[t] = signKeys[t]; nsv[t] = signVals[t]; }
                signKeys = nsk; signVals = nsv; cap = nextCap;
            }
            signKeys[signCnt] = k;
            signVals[signCnt] = v;
            signCnt = signCnt + 1;
            signPayloadLen = signPayloadLen + (long)k.Length + (long)v.Length;
            if (k == JushuitanMessageCallback.AppKeyField) { receivedAppKey = v; }
            else if (k == JushuitanMessageCallback.ActionCodeField) { actionCode = v; }
            else if (k == JushuitanMessageCallback.TimestampField) { timestamp = v; }
            else if (k == JushuitanMessageCallback.VersionField) { version = v; }
            else if (k == JushuitanMessageCallback.CharsetField) { charset = v; }
            else if (k == JushuitanMessageCallback.BizField) { biz = v; }
        }

        if (missingEq) {
            throw new JushuitanException("callback.invalidForm", "消息回调表单要求非空字段名及等号", 0, "");
        }
        if (hasDuplicate) {
            throw new JushuitanException("callback.invalidForm", "消息回调表单含有重复字段", 0, "");
        }
        if (String.IsNullOrEmpty(appKey) || String.IsNullOrEmpty(appSecret)) {
            throw new JushuitanException("callback.invalidCredentials", "消息回调需要应用 app_key 和 app_secret", 0, "");
        }
        JushuitanMessageCallback.EnsurePresent(receivedAppKey, JushuitanMessageCallback.AppKeyField);
        JushuitanMessageCallback.EnsurePresent(actionCode, JushuitanMessageCallback.ActionCodeField);
        JushuitanMessageCallback.EnsurePresent(timestamp, JushuitanMessageCallback.TimestampField);
        JushuitanMessageCallback.EnsurePresent(version, JushuitanMessageCallback.VersionField);
        JushuitanMessageCallback.EnsurePresent(charset, JushuitanMessageCallback.CharsetField);
        JushuitanMessageCallback.EnsurePresent(biz, JushuitanMessageCallback.BizField);
        JushuitanMessageCallback.EnsurePresent(actualSign, JushuitanMessageCallback.SignField);

        if (!JushuitanMessageCallback.FixedEquals(receivedAppKey, appKey)) {
            throw new JushuitanException("callback.invalidAppKey", "消息回调 app_key 与当前应用不一致", 0, "");
        }
        if (version != JushuitanMessageCallback.ProtocolVersion || !JushuitanMessageCallback.IsUtf8(charset)) {
            throw new JushuitanException("callback.invalidField", "消息回调要求 version=2 和 charset=utf-8", 0, "");
        }
        if (!JushuitanMessageCallback.IsTimestamp(timestamp)) {
            throw new JushuitanException("callback.invalidField", "消息回调 timestamp 必须为 10 位秒级时间戳", 0, "");
        }
        if (maxAgeSeconds > 0L) {
            long ts = 0L;
            for (int i = 0; i < 10; i = i + 1) {
                ts = ts * 10L + (long)((timestamp[i] & 255) - 48);
            }
            long diff = DateTime.UtcNow().ToUnixSeconds() - ts;
            if (diff < 0L) { diff = 0L - diff; }
            if (diff > maxAgeSeconds) {
                throw new JushuitanException("callback.expiredTimestamp", "消息回调 timestamp 超出允许时间窗口", 0, "");
            }
        }
        if (actualSign.Length != 32) {
            throw new JushuitanException("callback.invalidSignature", "消息回调签名无效", 0, "");
        }
        string expected = JushuitanSign.ComputeFromArrays(signKeys, signVals, signCnt, signPayloadLen, appSecret);
        int difference = 0;
        for (int i = 0; i < 32; i = i + 1) {
            difference = difference | ((expected[i] & 255) ^ (actualSign[i] & 255));
        }
        if (difference != 0) {
            throw new JushuitanException("callback.invalidSignature", "消息回调签名无效", 0, "");
        }
        JsonValue payload;
        try {
            payload = JsonValue.Parse(biz);
        } catch (JsonException) {
            throw new JushuitanException("callback.invalidPayload", "消息回调 biz 不是有效的 JSON", 0, "");
        }
        return new JushuitanMessage(receivedAppKey, actionCode, timestamp, version, charset, payload, biz);
    }

    // 框架已解析表单时，传入 UTF-8 解码后的全部单值字段，保留原始值。
    public static JushuitanMessage ParseFields(Dictionary<string, string> fields, string appKey, string appSecret) {
        return JushuitanMessageCallback.ParseFields(fields, appKey, appSecret, 0L);
    }

    public static JushuitanMessage ParseFields(Dictionary<string, string> fields, string appKey,
                                               string appSecret, long maxAgeSeconds) {
        if (maxAgeSeconds < 0L) {
            throw new JushuitanException("client.invalidArguments", "maxAgeSeconds 不能为负数", 0, "");
        }
        if (String.IsNullOrEmpty(appKey) || String.IsNullOrEmpty(appSecret)) {
            throw new JushuitanException("callback.invalidCredentials", "消息回调需要应用 app_key 和 app_secret", 0, "");
        }
        if (fields == null) {
            throw new JushuitanException("callback.invalidForm", "消息回调缺少表单", 0, "");
        }
        string receivedAppKey = JushuitanMessageCallback.RequireField(fields, JushuitanMessageCallback.AppKeyField);
        string actionCode = JushuitanMessageCallback.RequireField(fields, JushuitanMessageCallback.ActionCodeField);
        string timestamp = JushuitanMessageCallback.RequireField(fields, JushuitanMessageCallback.TimestampField);
        string version = JushuitanMessageCallback.RequireField(fields, JushuitanMessageCallback.VersionField);
        string charset = JushuitanMessageCallback.RequireField(fields, JushuitanMessageCallback.CharsetField);
        string biz = JushuitanMessageCallback.RequireField(fields, JushuitanMessageCallback.BizField);
        JushuitanMessageCallback.RequireField(fields, JushuitanMessageCallback.SignField);
        if (!JushuitanMessageCallback.FixedEquals(receivedAppKey, appKey)) {
            throw new JushuitanException("callback.invalidAppKey", "消息回调 app_key 与当前应用不一致", 0, "");
        }
        if (version != JushuitanMessageCallback.ProtocolVersion || !JushuitanMessageCallback.IsUtf8(charset)) {
            throw new JushuitanException("callback.invalidField", "消息回调要求 version=2 和 charset=utf-8", 0, "");
        }
        if (!JushuitanMessageCallback.IsTimestamp(timestamp)) {
            throw new JushuitanException("callback.invalidField", "消息回调 timestamp 必须为 10 位秒级时间戳", 0, "");
        }
        if (maxAgeSeconds > 0L) {
            long ts = 0L;
            for (int i = 0; i < 10; i = i + 1) {
                ts = ts * 10L + (long)((timestamp[i] & 255) - 48);
            }
            long diff = DateTime.UtcNow().ToUnixSeconds() - ts;
            if (diff < 0L) { diff = 0L - diff; }
            if (diff > maxAgeSeconds) {
                throw new JushuitanException("callback.expiredTimestamp", "消息回调 timestamp 超出允许时间窗口", 0, "");
            }
        }
        // 签名覆盖全部实际字段。biz 的空白、字段顺序和转义形式都参与验签。
        if (!JushuitanSign.Verify(fields, appSecret)) {
            throw new JushuitanException("callback.invalidSignature", "消息回调签名无效", 0, "");
        }
        JsonValue payload;
        try {
            payload = JsonValue.Parse(biz);
        } catch (JsonException) {
            throw new JushuitanException("callback.invalidPayload", "消息回调 biz 不是有效的 JSON", 0, "");
        }
        return new JushuitanMessage(receivedAppKey, actionCode, timestamp, version, charset, payload, biz);
    }

    public static string SuccessResponse() {
        return JushuitanMessageCallback.SuccessJson;
    }

    public static string FailureResponse() {
        return JushuitanMessageCallback.FailureJson;
    }

    private static bool FixedEquals(string a, string b) {
        if (a == null || b == null) { return false; }
        int diff = a.Length ^ b.Length;
        int n = a.Length < b.Length ? a.Length : b.Length;
        for (int i = 0; i < n; i = i + 1) {
            diff = diff | ((a[i] & 255) ^ (b[i] & 255));
        }
        return diff == 0;
    }

    private static bool IsBlank(string value) {
        int n = value.Length;
        for (int i = 0; i < n; i = i + 1) {
            if (!JushuitanMessageCallback.IsTrimWs(value[i] & 255)) { return false; }
        }
        return true;
    }

    private static void EnsurePresent(string value, string name) {
        if (value == null || JushuitanMessageCallback.IsBlank(value)) {
            throw new JushuitanException("callback.missingField", "消息回调缺少必填字段 " + name, 0, "");
        }
    }

    private static string RequireField(Dictionary<string, string> fields, string name) {
        string value = "";
        if (!fields.TryGetValue(name, out value) || value == null || JushuitanMessageCallback.IsBlank(value)) {
            throw new JushuitanException("callback.missingField", "消息回调缺少必填字段 " + name, 0, "");
        }
        return value;
    }

    private static bool IsTimestamp(string timestamp) {
        if (timestamp.Length != JushuitanMessageCallback.TimestampDigits) { return false; }
        for (int i = 0; i < 10; i = i + 1) {
            int c = timestamp[i] & 255;
            if (c < 48 || c > 57) { return false; }
        }
        return true;
    }
}
