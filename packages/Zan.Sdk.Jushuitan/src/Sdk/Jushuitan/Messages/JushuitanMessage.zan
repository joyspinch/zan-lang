using System;
using System.Json;
using Sdk.Jushuitan;

namespace Sdk.Jushuitan.Messages;

// 已通过新版消息回调验签的报文。
public class JushuitanMessage {
    public string AppKey;
    public string ActionCode;
    public string Timestamp;
    public string Version;
    public string Charset;
    public JsonValue Payload;
    public string RawPayloadJson;

    public bool IsSubscriptionCheck {
        get { return this.ActionCode == JushuitanMessageCallback.SubscriptionCheck; }
    }

    internal JushuitanMessage(string appKey, string actionCode, string timestamp, string version,
                              string charset, JsonValue payload, string rawPayloadJson) {
        this.AppKey = appKey;
        this.ActionCode = actionCode;
        this.Timestamp = timestamp;
        this.Version = version;
        this.Charset = charset;
        this.Payload = payload;
        this.RawPayloadJson = rawPayloadJson;
    }

    public T Bind<T>() {
        return Json.Deserialize<T>(this.RawPayloadJson);
    }

    public ShipmentPushMessage AsShipment() {
        this.RequireAction(JushuitanMessageCallback.Shipment);
        return Json.Deserialize<ShipmentPushMessage>(this.RawPayloadJson);
    }

    public InventoryPushMessage AsInventory() {
        this.RequireAction(JushuitanMessageCallback.Inventory);
        return Json.Deserialize<InventoryPushMessage>(this.RawPayloadJson);
    }

    public AfterSalePushMessage AsAfterSale() {
        this.RequireAction(JushuitanMessageCallback.AfterSale);
        return Json.Deserialize<AfterSalePushMessage>(this.RawPayloadJson);
    }

    public ReceiptPushMessage AsReceipt() {
        this.RequireAction(JushuitanMessageCallback.Receipt);
        return Json.Deserialize<ReceiptPushMessage>(this.RawPayloadJson);
    }

    private void RequireAction(string expectedAction) {
        if (this.ActionCode != expectedAction) {
            throw new JushuitanException("callback.unexpectedAction",
                "期望消息动作 " + expectedAction + "，实际为 " + this.ActionCode, 0, this.RawPayloadJson);
        }
    }
}
