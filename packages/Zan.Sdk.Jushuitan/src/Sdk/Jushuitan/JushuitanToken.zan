using System;
using System.Json;

namespace Sdk.Jushuitan;

public class JushuitanToken {
    public string AccessToken;
    public string RefreshToken;
    public long ExpiresIn;
    public long ExpiresAtUnixSeconds;
    public string Scope;
    // 商家自研授权响应可能省略公司编码。
    public string CompanyId;

    public JushuitanToken(string accessToken, string refreshToken, long expiresIn, string scope, string companyId) {
        this.AccessToken = accessToken;
        this.RefreshToken = refreshToken;
        this.ExpiresIn = expiresIn;
        this.ExpiresAtUnixSeconds = DateTime.UtcNow().ToUnixSeconds() + expiresIn;
        this.Scope = scope;
        this.CompanyId = companyId;
    }

    public bool IsExpired() {
        return this.IsExpiringSoon(0L);
    }

    public bool IsExpiringSoon(long skewSeconds) {
        long skew = skewSeconds < 0L ? 0L : skewSeconds;
        return DateTime.UtcNow().ToUnixSeconds() + skew >= this.ExpiresAtUnixSeconds;
    }

    public static JushuitanToken Parse(JushuitanResponse response) {
        if (response == null || response.Data == null || !response.Data.IsObject()) {
            throw new JushuitanException("client.invalidTokenResponse", "授权响应缺少 data 对象",
                response == null ? 0 : response.StatusCode, response == null ? "" : response.RawBody);
        }
        JsonValue data = response.Data;
        JsonValue access = data.Get("access_token");
        JsonValue refresh = data.Get("refresh_token");
        JsonValue expires = data.Get("expires_in");
        JsonValue scope = data.Get("scope");
        JsonValue company = data.Get("coid");
        long expiresIn = JushuitanToken.ReadPositiveLong(expires);
        if (access == null || !access.IsString() || access.AsString("").Length == 0 || expiresIn <= 0L) {
            throw new JushuitanException("client.invalidTokenResponse", "授权响应缺少 token 或有效期", response.StatusCode, response.RawBody);
        }
        return new JushuitanToken(
            access.AsString(""),
            refresh == null || !refresh.IsString() ? "" : refresh.AsString(""),
            expiresIn,
            JushuitanToken.ReadScalarString(scope),
            JushuitanToken.ReadScalarString(company)
        );
    }

    private static string ReadScalarString(JsonValue v) {
        if (v == null || v.IsNull()) { return ""; }
        if (v.IsString()) { return v.AsString(""); }
        if (v.IsInt()) { return Convert.ToString(v.AsLong(0L)); }
        return "";
    }

    private static long ReadPositiveLong(JsonValue v) {
        if (v == null || v.IsNull()) { return 0L; }
        if (v.IsInt()) { return v.AsLong(0L); }
        if (v.IsString()) {
            string s = v.AsString("").Trim();
            if (s.Length == 0) { return 0L; }
            for (int i = 0; i < s.Length; i = i + 1) {
                if (s[i] < '0' || s[i] > '9') { return 0L; }
            }
            return Convert.ToInt64(s);
        }
        return 0L;
    }
}
