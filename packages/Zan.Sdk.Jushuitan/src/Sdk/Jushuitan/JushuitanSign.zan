using System;
using System.Text;
using System.Security.Cryptography;

namespace Sdk.Jushuitan;

public static class JushuitanSign {
    public static string Compute(Dictionary<string, string> fields, string secret) {
        if (fields == null || secret == null || secret.Length == 0) {
            throw new JushuitanException("client.invalidArguments", "签名需要参数和应用密钥", 0, "");
        }
        // Dictionary.Keys 返回内部 List，必须复制后再排序以免打乱键值映射。
        List<string> rawKeys = fields.Keys;
        List<string> sorted = new List<string>();
        for (int i = 0; i < rawKeys.Count; i = i + 1) {
            string key = rawKeys[i];
            if (key != "sign") { sorted.Add(key); }
        }
        sorted.Sort();

        StringBuilder source = new StringBuilder();
        source.Append(secret);
        for (int i = 0; i < sorted.Count; i = i + 1) {
            string key = sorted[i];
            source.Append(key);
            source.Append(fields[key]);
        }
        return Convert.ToHexString(Md5.Hash(source.ToString())).ToLowerAscii();
    }

    public static bool Verify(Dictionary<string, string> fields, string secret) {
        if (fields == null) { return false; }
        string actual = "";
        if (!fields.TryGetValue("sign", out actual) || actual == null || actual.Length != 32) { return false; }
        string expected = JushuitanSign.Compute(fields, secret);
        int difference = 0;
        for (int i = 0; i < expected.Length; i = i + 1) {
            difference = difference | (expected[i] ^ actual[i]);
        }
        return difference == 0;
    }

    public static string FormEncode(Dictionary<string, string> fields) {
        if (fields == null || fields.Count == 0) { return ""; }
        StringBuilder body = new StringBuilder();
        List<string> keys = fields.Keys;
        for (int i = 0; i < keys.Count; i = i + 1) {
            if (i > 0) { body.Append("&"); }
            string key = keys[i];
            body.Append(Encoding.UrlEncode(key));
            body.Append("=");
            body.Append(Encoding.UrlEncode(fields[key]));
        }
        return body.ToString();
    }
}
