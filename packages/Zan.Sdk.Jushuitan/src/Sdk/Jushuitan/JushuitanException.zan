using System;

namespace Sdk.Jushuitan;

public class JushuitanException : Exception {
    public string Code;
    public int StatusCode;
    public string Body;

    public JushuitanException(string code, string message, int statusCode, string body)
        : base(message) {
        this.Code = code;
        this.StatusCode = statusCode;
        this.Body = body;
    }

    // 聚水潭文档约定：199（秒级限流）、200（分钟级限流）。
    public bool IsRateLimited {
        get { return this.Code == "199" || this.Code == "200"; }
    }

    // 聚水潭文档约定：100 表示 access_token 无效或过期。
    public bool IsTokenExpired {
        get { return this.Code == "100"; }
    }
}
