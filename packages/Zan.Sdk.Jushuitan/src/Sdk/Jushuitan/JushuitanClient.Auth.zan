using System;
using System.Json;

namespace Sdk.Jushuitan;

public partial class JushuitanClient {
    private static const string AuthorizationUrl = "https://openweb.jushuitan.com/auth";
    private static const string InitTokenPath = "/openWeb/auth/getInitToken";
    private static const string RefreshTokenPath = "/openWeb/auth/refreshToken";
    private static const string AccessTokenPath = "/openWeb/auth/accessToken";

    public string BuildAuthorizationUrl(string state) {
        Dictionary<string, string> fields = this.CommonFields();
        if (state != null && state.Length > 0) { fields.Add("state", state); }
        fields.Add("sign", JushuitanSign.Compute(fields, this.appSecret));
        return JushuitanClient.AuthorizationUrl + "?" + JushuitanSign.FormEncode(fields);
    }

    private static bool FixedEquals(string a, string b) {
        if (a == null || b == null) { return false; }
        int diff = a.Length ^ b.Length;
        int n = a.Length < b.Length ? a.Length : b.Length;
        for (int i = 0; i < n; i = i + 1) {
            diff = diff | ((a[i] & 255) ^ (b[i] & 255));
        }
        return diff == 0;
    }

    // 传入解码后的 GET 查询参数以及本次授权请求保存的预期 state。
    public string VerifyAuthorizationCallback(Dictionary<string, string> fields, string expectedState) {
        return this.VerifyAuthorizationCallback(fields, expectedState, 0L);
    }

    // maxAgeSeconds > 0 时额外校验回调 timestamp 与本机 UTC 时间差，防止重放。
    public string VerifyAuthorizationCallback(Dictionary<string, string> fields, string expectedState, long maxAgeSeconds) {
        JushuitanClient.RequireValue(expectedState, "state");
        string app = "";
        string code = "";
        string state = "";
        if (fields == null || !fields.TryGetValue("app_key", out app) || !JushuitanClient.FixedEquals(app, this.appKey)
            || !fields.TryGetValue("state", out state) || !JushuitanClient.FixedEquals(state, expectedState)
            || !fields.TryGetValue("code", out code) || code == null || code.Length == 0
            || !JushuitanSign.Verify(fields, this.appSecret)) {
            throw new JushuitanException("auth.invalidCallback", "授权回调的应用、状态或签名无效", 0, "");
        }
        if (maxAgeSeconds > 0L) {
            string tsStr = "";
            if (!fields.TryGetValue("timestamp", out tsStr) || tsStr == null || tsStr.Length != 10) {
                throw new JushuitanException("auth.invalidCallback", "授权回调缺少有效的 10 位 timestamp", 0, "");
            }
            long ts = 0L;
            for (int i = 0; i < tsStr.Length; i = i + 1) {
                int c = tsStr[i] & 255;
                if (c < 48 || c > 57) {
                    throw new JushuitanException("auth.invalidCallback", "授权回调 timestamp 非纯数字", 0, "");
                }
                ts = ts * 10L + (long)(c - 48);
            }
            long diff = DateTime.UtcNow().ToUnixSeconds() - ts;
            if (diff < 0L) { diff = 0L - diff; }
            if (diff > maxAgeSeconds) {
                throw new JushuitanException("auth.expiredCallback", "授权回调 timestamp 超出允许时间窗口", 0, "");
            }
        }
        return code;
    }

    // 服务商授权回调成功确认响应（官方文档 25：数值 {"code":0}，不同于消息回调的字符串 "0"）。
    public static string AuthorizationCallbackSuccessResponse() {
        JsonValue ack = JsonValue.NewObject();
        ack.PutInt("code", 0);
        return ack.ToJson();
    }

    public async JushuitanToken GetInitTokenAsync(string code) {
        JushuitanClient.RequireValue(code, "code");
        if (code.Length != 6) {
            throw new JushuitanException("client.invalidArguments", "自研授权 code 必须为六位随机字符串", 0, "");
        }
        return await this.RequestTokenAsync(JushuitanClient.InitTokenPath, "authorization_code", "code", code);
    }

    public async JushuitanToken RefreshTokenAsync(string refreshToken) {
        JushuitanClient.RequireValue(refreshToken, "refresh_token");
        return await this.RequestTokenAsync(JushuitanClient.RefreshTokenPath, "refresh_token", "refresh_token", refreshToken);
    }

    public async JushuitanToken ExchangeAccessTokenAsync(string code) {
        JushuitanClient.RequireValue(code, "code");
        return await this.RequestTokenAsync(JushuitanClient.AccessTokenPath, "authorization_code", "code", code);
    }

    private async JushuitanToken RequestTokenAsync(string path, string grantType, string field, string value) {
        Dictionary<string, string> fields = new Dictionary<string, string>();
        fields.Add("grant_type", grantType);
        fields.Add(field, value);
        if (grantType == "refresh_token") { fields.Add("scope", "all"); }
        JushuitanResponse response = await this.PostFormWithRetryAsync(
            JushuitanClient.ProductionGateway, path, fields, JushuitanResponseMode.DataEnvelope);
        return JushuitanToken.Parse(response);
    }
}
