using System;

namespace System.Jobs;

// 一个已注册的任务处理器。
//
// **为什么处理器签名是"JSON 文本进、`JobResult` 出"**：Zan 没有运行期反射，
// 按任务名反查方法、构造参数、决定类型都做不到。所以任务名 → 处理器的
// 映射必须是**显式注册**的，参数也必须能被显式地序列化/反序列化。
// 泛型便利版（`JobRegistry.RegisterTyped`）把序列化委托一起注册进去，
// 于是"强类型参数"和"可持久化"可以同时成立，且全程无反射。
public class JobHandler {
    // 任务名（注册表的键）。
    public string name;
    // 执行：入参是参数 JSON 文本，返回执行结果。
    public FuncT<string, JobResult> run;
    // 参数规范化：入参是原始 JSON 文本，返回规范化后的 JSON 文本。
    // 非泛型注册时是恒等；泛型注册时是"反序列化再序列化"，用来把
    // 入队时的参数形态和执行时的参数形态对齐。
    public FuncT<string, string> normalize;

    public JobHandler(string name, FuncT<string, JobResult> run) {
        this.name = name != null ? name : "";
        this.run = run;
        this.normalize = null;
    }

    public JobHandler(string name, FuncT<string, JobResult> run,
                     FuncT<string, string> normalize) {
        this.name = name != null ? name : "";
        this.run = run;
        this.normalize = normalize;
    }

    // 规范化参数；没有规范化委托就原样返回。
    public string Normalize(string argsJson) {
        if (this.normalize == null) { return argsJson != null ? argsJson : "{}"; }
        return this.normalize(argsJson != null ? argsJson : "{}");
    }
}
