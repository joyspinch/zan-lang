namespace System.Jobs;

// 任务状态（可区分的状态机节点）。
//
// **为什么要状态而不是一个 bool**：后台任务至少有「排队 / 执行中 / 成功 /
// 还会重试的失败 / 彻底失败 / 被删」六种不同处境，运维要能一眼分清
// "暂时没跑" 和 "永远跑不动了"——后者需要人工介入，前者只需要等。合成
// 一个 `done` 标志就丢掉了这个区分，告警也就没法分级。
public enum JobState {
    // 已入队，等待 worker 领取（runAt 到了就可执行）。
    Enqueued = 0,
    // 已安排到未来时间（runAt 未到，worker 不许碰）。
    Scheduled = 1,
    // 已被 worker 领取，正在执行。
    Processing = 2,
    // 执行成功，终态。
    Succeeded = 3,
    // 执行失败但**还会重试**（runAt 是下次重试时间）。
    Failed = 4,
    // 死信：超过重试上限、或处理器判定为不可重试，终态，需要人工介入。
    Dead = 5,
    // 已被显式删除，终态。
    Deleted = 6,
}

// 状态的英文名（调试输出 / 序列化用；不依赖枚举的字符串格式化行为）。
public class JobStates {
    public static string Name(JobState st) {
        if (st == JobState.Enqueued) { return "Enqueued"; }
        if (st == JobState.Scheduled) { return "Scheduled"; }
        if (st == JobState.Processing) { return "Processing"; }
        if (st == JobState.Succeeded) { return "Succeeded"; }
        if (st == JobState.Failed) { return "Failed"; }
        if (st == JobState.Dead) { return "Dead"; }
        if (st == JobState.Deleted) { return "Deleted"; }
        return "Unknown";
    }

    // 按名字解析状态；不认识返回 false（调用方自己决定怎么处理）。
    public static bool TryParse(string name, out JobState outState) {
        outState = JobState.Enqueued;
        if (name == null) { return false; }
        if (name == "Enqueued") { outState = JobState.Enqueued; return true; }
        if (name == "Scheduled") { outState = JobState.Scheduled; return true; }
        if (name == "Processing") { outState = JobState.Processing; return true; }
        if (name == "Succeeded") { outState = JobState.Succeeded; return true; }
        if (name == "Failed") { outState = JobState.Failed; return true; }
        if (name == "Dead") { outState = JobState.Dead; return true; }
        if (name == "Deleted") { outState = JobState.Deleted; return true; }
        return false;
    }
}
