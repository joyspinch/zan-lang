namespace System.Jobs;

// 处理器的执行结果。
//
// **为什么不让处理器直接抛异常**：抛异常只能表达"失败了"，但后台任务
// 还要回答"还要不要重试"——网络抖动导致的失败重试有意义，参数非法导致
// 的失败重试一万次也没意义。让处理器自己把这两件事说清楚，重试策略
// 才不用去猜异常类型。
//
// 用法：`JobResult.Success()` / `JobResult.Retry("下游超时")` /
// `JobResult.Fail("参数非法")`。
public class JobResult {
    // 是否成功。
    public bool ok;
    // 失败时是否可重试。
    public bool retryable;
    // 失败原因（成功时为空串）。
    public string message;

    JobResult(bool ok, bool retryable, string message) {
        this.ok = ok;
        this.retryable = retryable;
        this.message = message != null ? message : "";
    }

    // 成功。
    public static JobResult Success() {
        return new JobResult(true, false, "");
    }

    // 失败，但可以重试（退避后重排）。
    public static JobResult Retry(string message) {
        return new JobResult(false, true, message);
    }

    // 失败且不可重试（直接进死信）。
    public static JobResult Fail(string message) {
        return new JobResult(false, false, message);
    }

    // 简要描述（调试输出用）。
    public string Describe() {
        if (this.ok) { return "ok"; }
        if (this.retryable) { return "retryable:" + this.message; }
        return "failed:" + this.message;
    }
}
