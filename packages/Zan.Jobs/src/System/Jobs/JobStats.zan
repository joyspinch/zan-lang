namespace System.Jobs;

// 任务统计快照。
//
// **为什么要单独一个快照类**：运维要回答的问题是"现在有多少任务卡住了"，
// 不是"逐条翻记录"。把计数做成一次性快照（而不是每次现算），
// 调用方打印一次就够，也不会因为中途状态变化而前后不一致。
public class JobStats {
    // 总任务数。
    public int total;
    // 排队中。
    public int enqueued;
    // 已安排到未来。
    public int scheduled;
    // 执行中。
    public int processing;
    // 成功。
    public int succeeded;
    // 失败但还会重试。
    public int failed;
    // 死信（需要人工介入）。
    public int dead;
    // 已删除。
    public int deleted;

    public JobStats() {
        this.total = 0;
        this.enqueued = 0;
        this.scheduled = 0;
        this.processing = 0;
        this.succeeded = 0;
        this.failed = 0;
        this.dead = 0;
        this.deleted = 0;
    }

    // 一行摘要（监控 / 日志用）。
    public string Describe() {
        return "total=" + this.total
            + " enqueued=" + this.enqueued
            + " scheduled=" + this.scheduled
            + " processing=" + this.processing
            + " succeeded=" + this.succeeded
            + " failed=" + this.failed
            + " dead=" + this.dead
            + " deleted=" + this.deleted;
    }
}
