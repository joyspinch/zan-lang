namespace System.Jobs;

// 任务队列的错误原因（可区分的错误码）。
//
// **为什么要错误码**：入队失败的原因差别很大——"名字没注册"是接线错误，
// "幂等 id 撞了"是调用方逻辑重复，"存储写不下去"是磁盘问题。三者补救
// 办法完全不同，合成一句话会让排查变慢。
public enum JobError {
    // 没有错误。
    None = 0,
    // 任务名没有在注册表里登记过（worker 领取后找不到处理器）。
    UnknownJob = 1,
    // 幂等冲突：同一个 id 已经在队列里（不是"已存在就复用"，是硬冲突）。
    DuplicateId = 2,
    // 任务名为空或非法。
    InvalidName = 3,
    // 参数非法（比如 JSON 解析不过）。
    InvalidArgs = 4,
    // 存储层失败（写盘失败、被别的进程锁住等）。
    StorageFailure = 5,
    // worker 已经在跑，重复启动被拒。
    AlreadyRunning = 6,
    // 按 id 查不到任务。
    NotFound = 7,
    // 处理器返回了非法结果（既不是成功也不是可重试失败）。
    InvalidResult = 8,
    // 注册表里同一个名字注册了两次。
    DuplicateHandler = 9,
}
