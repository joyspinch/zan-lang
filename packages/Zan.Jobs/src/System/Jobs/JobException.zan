using System;

namespace System.Jobs;

// 后台任务队列的错误。
//
// **异常 + 错误码两个通道**：人看 `Message`（异常自带），程序看 `error`。
public class JobException : Exception {
    // 错误码。
    public JobError error;
    // 相关的任务 id（没有则为空串）。
    public string jobId;

    public JobException(JobError error, string text) : base(text) {
        this.error = error;
        this.jobId = "";
    }

    public JobException(JobError error, string jobId, string text) : base(text) {
        this.error = error;
        this.jobId = jobId != null ? jobId : "";
    }

    // 带原始异常的构造（处理器抛错时用；原异常在 `InnerException` 里）。
    public JobException(JobError error, string jobId, string text, Exception cause) : base(text, cause) {
        this.error = error;
        this.jobId = jobId != null ? jobId : "";
    }

    // 错误码的英文名（调试输出用；不依赖枚举的字符串格式化行为）。
    public string ErrorName() {
        if (this.error == JobError.None) { return "None"; }
        if (this.error == JobError.UnknownJob) { return "UnknownJob"; }
        if (this.error == JobError.DuplicateId) { return "DuplicateId"; }
        if (this.error == JobError.InvalidName) { return "InvalidName"; }
        if (this.error == JobError.InvalidArgs) { return "InvalidArgs"; }
        if (this.error == JobError.StorageFailure) { return "StorageFailure"; }
        if (this.error == JobError.AlreadyRunning) { return "AlreadyRunning"; }
        if (this.error == JobError.NotFound) { return "NotFound"; }
        if (this.error == JobError.InvalidResult) { return "InvalidResult"; }
        if (this.error == JobError.DuplicateHandler) { return "DuplicateHandler"; }
        return "Unknown";
    }
}
