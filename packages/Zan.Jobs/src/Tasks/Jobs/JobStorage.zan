using System;
using System.Collections.Generic;

namespace Tasks.Jobs;

// 任务存储的抽象契约。
//
// **为什么是基类 + 虚方法而不是接口**：Zan 的接口方法在多态位置上
// 已经能正确派发，但**存储层要能在构造时拿到具体实现**（文件存储要在
// 构造里做 replay），基类 + 虚方法让"构造时就能确定实现"这件事自然。
//
// 存储层只做两件事：
// - `Append`：追加一条状态变更（存储自己决定怎么折叠成当前状态）。
// - `Snapshot` / `Find` / `Filter`：读回当前状态。
//
// **并发边界**：实现必须保证"进程内多线程安全"；跨进程是否安全由实现
// 自己声明（`FileJobStorage` 用文件锁做到跨进程单写者）。
public class JobStorage {
    // 追加一条状态变更。
    public virtual void Append(JobRecord record) {
        if (record == null) {
            throw new JobException(JobError.InvalidArgs, "record is null");
        }
    }

    // 当前状态的全量快照。
    public virtual List<JobRecord> Snapshot() {
        return new List<JobRecord>();
    }

    // 按 id 找任务；找不到返回 null。
    public virtual JobRecord Find(string id) {
        if (id == null) { return null; }
        List<JobRecord> all = this.Snapshot();
        for (int i = 0; i < all.Count; i++) {
            if (all[i].id == id) { return all[i]; }
        }
        return null;
    }

    // 原子领取：若 id 对应任务当前可执行（JobRecord.IsRunnableAt），在存储
    // 的同一把锁内置为 Processing（attempts+1、startAt=now、worker 归属、
    // error 清空）并落库，返回领取后的记录；否则不动存储、返回 null。
    // 默认实现由 Find + Append 拼成，两步跨锁，防不了多 worker 并发重复
    // 领取；自带并发控制的内置实现（InMemory/File）覆写了本方法，校验与
    // 置态在锁内一次完成。自定义实现若在意多 worker 并发，也应覆写。
    public virtual JobRecord Claim(string id, long now, string workerId) {
        JobRecord current = this.Find(id);
        if (current == null || !current.IsRunnableAt(now)) { return null; }
        JobRecord rec = current.Copy();
        rec.state = JobState.Processing;
        rec.startAt = now;
        rec.attempts = current.attempts + 1;
        rec.worker = workerId;
        rec.error = "";
        this.Append(rec);
        return rec;
    }

    // 原子删除：置为 Deleted 状态，若不存在返回 false。
    public virtual bool Delete(string id) {
        if (id == null) { return false; }
        JobRecord r = this.Find(id);
        if (r == null) { return false; }
        JobRecord rec = r.Copy();
        rec.state = JobState.Deleted;
        this.Append(rec);
        return true;
    }

    // 原子写回终态：若任务已被标记 Deleted 则不覆写，防止已删除任务复活。
    public virtual bool CompleteUnlessDeleted(JobRecord record) {
        if (record == null || record.id == null) { return false; }
        JobRecord current = this.Find(record.id);
        if (current != null && current.state == JobState.Deleted) { return false; }
        this.Append(record);
        return true;
    }

    // 过滤查询：name 为空表示不限名字；state < 0 表示不限状态；
    // limit <= 0 表示不限条数。
    public virtual List<JobRecord> Filter(string name, int state, int limit) {
        List<JobRecord> items = new List<JobRecord>();
        List<JobRecord> all = this.Snapshot();
        for (int i = 0; i < all.Count; i++) {
            JobRecord r = all[i];
            if (name != null && name.Length > 0 && r.name != name) { continue; }
            if (state >= 0 && (int)r.state != state) { continue; }
            items.Add(r);
            if (limit > 0 && items.Count >= limit) { break; }
        }
        return items;
    }

    // 某个状态的任务条数。
    public virtual int CountByState(JobState st) {
        return this.Filter(null, (int)st, 0).Count;
    }

    // 压实存储（把历史折叠成当前状态，去掉已终结任务的旧版本）。
    // 默认什么都不做——内存实现本来就只有当前状态。
    public virtual void Compact() {
    }
}
