using System;
using System.Collections.Generic;
using System.Threading;

namespace Tasks.Jobs;

// 内存任务存储：只保留当前状态，不落盘。
//
// **用途**：测试、单机短任务、或者"任务丢了也无所谓"的场景。
// 进程重启即丢——这是它的定义，不是缺陷，所以名字里带 InMemory。
//
// **并发安全**：进程内多线程安全（读写操作全链路走实例互斥锁，多实例互不阻塞）。
public class InMemoryJobStorage : JobStorage {
    object syncLock;
    Dictionary<string, JobRecord> index;

    public InMemoryJobStorage() {
        this.syncLock = new object();
        this.index = new Dictionary<string, JobRecord>();
    }

    public override void Append(JobRecord record) {
        if (record == null || record.id == null || record.id.Length == 0) {
            throw new JobException(JobError.InvalidArgs, "record or record id is empty");
        }
        lock (this.syncLock) {
            this.index[record.id] = record;
        }
    }

    public override List<JobRecord> Snapshot() {
        lock (this.syncLock) {
            List<JobRecord> items = new List<JobRecord>();
            List<string> keys = this.index.Keys;
            for (int i = 0; i < keys.Count; i++) {
                JobRecord r = null;
                if (this.index.TryGetValue(keys[i], out r)) { items.Add(r); }
            }
            return items;
        }
    }

    public override JobRecord Find(string id) {
        if (id == null) { return null; }
        lock (this.syncLock) {
            JobRecord r = null;
            if (this.index.TryGetValue(id, out r)) { return r; }
            return null;
        }
    }

    // 原子领取：可执行校验与置 Processing 在实例锁内一次完成，多 worker
    // 并发拉取不会重复执行同一任务。
    public override JobRecord Claim(string id, long now, string workerId) {
        if (id == null) { return null; }
        lock (this.syncLock) {
            JobRecord current = null;
            if (!this.index.TryGetValue(id, out current)) { return null; }
            if (!current.IsRunnableAt(now)) { return null; }
            JobRecord rec = current.Copy();
            rec.state = JobState.Processing;
            rec.startAt = now;
            rec.attempts = current.attempts + 1;
            rec.worker = workerId;
            rec.error = "";
            this.index[rec.id] = rec;
            return rec;
        }
    }

    public override bool Delete(string id) {
        if (id == null) { return false; }
        lock (this.syncLock) {
            JobRecord r = null;
            if (!this.index.TryGetValue(id, out r) || r == null) { return false; }
            JobRecord rec = r.Copy();
            rec.state = JobState.Deleted;
            this.index[rec.id] = rec;
            return true;
        }
    }

    public override bool CompleteUnlessDeleted(JobRecord record) {
        if (record == null || record.id == null) { return false; }
        lock (this.syncLock) {
            JobRecord current = null;
            if (this.index.TryGetValue(record.id, out current) && current != null && current.state == JobState.Deleted) {
                return false;
            }
            this.index[record.id] = record;
            return true;
        }
    }
}
