using System;
using System.Collections.Generic;

namespace Tasks.Jobs;

// Five fields: minute, hour, day of month, month, day of week. The public
// constructor and Parse use the Jobs day intersection rule. ParseHosting
// uses the legacy Hosting grammar and day union rule for stored schedules.
public class CronExpression {
    private string raw;
    private bool hostingDays;
    private bool dayStar;
    private bool weekdayStar;
    public List<bool> minutes;
    public List<bool> hours;
    public List<bool> days;
    public List<bool> months;
    public List<bool> weekdays;

    public string RawExpression { get { return this.raw; } }

    public CronExpression(string expr) {
        if (expr == null || expr.Trim().Length == 0) {
            throw new ArgumentException("Cron expression cannot be empty");
        }
        this.Initialize(expr.Trim(), false);
    }

    private CronExpression(string expr, bool hostingDays) {
        this.Initialize(expr, hostingDays);
    }

    public static CronExpression Parse(string expr) {
        return new CronExpression(expr);
    }

    public static CronExpression ParseHosting(string expr) {
        if (expr == null) { return null; }
        try {
            return new CronExpression(expr, true);
        } catch (FormatException e) {
            return null;
        } catch (OverflowException e) {
            return null;
        }
    }

    private void Initialize(string expr, bool hostingDays) {
        this.raw = expr;
        this.hostingDays = hostingDays;
        this.minutes = CronExpression.CreateBitList(60);
        this.hours = CronExpression.CreateBitList(24);
        this.days = CronExpression.CreateBitList(32);
        this.months = CronExpression.CreateBitList(13);
        this.weekdays = CronExpression.CreateBitList(7);

        List<string> parts = (hostingDays ? expr.Replace("\t", " ") : expr).Split(" ");
        List<string> tokens = new List<string>();
        for (int i = 0; i < parts.Count; i = i + 1) {
            string token = hostingDays ? parts[i] : parts[i].Trim();
            if (token.Length > 0) { tokens.Add(token); }
        }
        if (tokens.Count != 5) {
            throw new FormatException("Expected 5 fields in cron expression, got " + tokens.Count.ToString());
        }
        this.dayStar = tokens[2] == "*";
        this.weekdayStar = tokens[4] == "*";
        this.ParseField(tokens[0], 0, 59, this.minutes, false);
        this.ParseField(tokens[1], 0, 23, this.hours, false);
        this.ParseField(tokens[2], 1, 31, this.days, false);
        this.ParseField(tokens[3], 1, 12, this.months, false);
        this.ParseField(tokens[4], 0, 6, this.weekdays, true);
    }

    private static List<bool> CreateBitList(int size) {
        List<bool> list = new List<bool>();
        for (int i = 0; i < size; i = i + 1) { list.Add(false); }
        return list;
    }

    private int ReadNumber(string text) {
        if (!this.hostingDays) { return Convert.ToInt32(text); }
        if (text.Length == 0) { throw new FormatException("Missing cron number"); }
        for (int i = 0; i < text.Length; i = i + 1) {
            if (text[i] < '0' || text[i] > '9') {
                throw new FormatException("Invalid cron number: " + text);
            }
        }
        return int.Parse(text);
    }

    private void ParseField(string token, int min, int max, List<bool> bits, bool isWeekday) {
        int top = this.hostingDays && isWeekday ? 7 : max;
        List<string> items = token.Split(",");
        for (int i = 0; i < items.Count; i = i + 1) {
            string item = this.hostingDays ? items[i] : items[i].Trim();
            if (item.Length == 0) {
                if (this.hostingDays && (i == 0 || i < items.Count - 1)) {
                    throw new FormatException("Empty cron list item");
                }
                continue;
            }

            int step = 1;
            int slash = item.IndexOf("/");
            string range = item;
            if (slash >= 0) {
                range = item.Substring(0, slash);
                step = this.ReadNumber(item.Substring(slash + 1));
                if (step <= 0) { throw new FormatException("Invalid step in cron: " + item); }
            }
            int start = min;
            int end = top;
            if (range != "*") {
                int dash = range.IndexOf("-");
                if (dash >= 0) {
                    start = this.ReadNumber(range.Substring(0, dash));
                    end = this.ReadNumber(range.Substring(dash + 1));
                } else {
                    start = this.ReadNumber(range);
                    end = slash >= 0 ? top : start;
                }
            }
            if (isWeekday && !this.hostingDays) {
                if (start == 7) { start = 0; }
                if (end == 7) { end = 0; }
            }
            if (start < min || end > top || start > end) {
                // Jobs historically normalizes a Sunday endpoint before expanding the range.
                if (!this.hostingDays && isWeekday && start > end && end == 0) { continue; }
                string message = "Cron value out of range [" + min.ToString() + ".." + top.ToString() + "]: " + item;
                if (this.hostingDays) { throw new FormatException(message); }
                throw new ArgumentOutOfRangeException(message);
            }
            for (int value = start; value <= end;) {
                bits[isWeekday && value == 7 ? 0 : value] = true;
                if (step > end - value) { break; }
                value = value + step;
            }
            // Hosting has always included Sunday when a weekday range reaches 7.
            if (this.hostingDays && isWeekday && end == 7) { bits[0] = true; }
        }
    }

    private bool DayMatches(DateTime dt) {
        bool dom = this.days[dt.day];
        bool dow = this.weekdays[dt.dayOfWeek];
        if (!this.hostingDays) { return dom && dow; }
        if (!this.dayStar && !this.weekdayStar) { return dom || dow; }
        if (!this.dayStar) { return dom; }
        if (!this.weekdayStar) { return dow; }
        return true;
    }

    public bool IsMatching(DateTime dt) {
        if (dt == null) { return false; }
        return this.minutes[dt.minute] && this.hours[dt.hour]
            && this.months[dt.month] && this.DayMatches(dt);
    }

    // Strictly after fromTime, on a minute boundary. Preserve the original
    // Jobs search limit and the Hosting search window of 366 calendar days.
    public DateTime GetNext(DateTime fromTime) {
        if (fromTime == null) { return null; }
        if (this.hostingDays) { return this.GetNextHosting(fromTime); }
        long startMs = (fromTime.epochMs / 60000) * 60000 + 60000;
        DateTime cur = DateTime.FromUnixMilliseconds(startMs);
        for (int i = 0; i < 525600; i = i + 1) {
            if (!this.months[cur.month]) {
                int daysLeft = DateTime.DaysInMonth(cur.year, cur.month) - cur.day + 1;
                cur = cur.AddDays(daysLeft);
                cur = new DateTime((cur.epochMs / 86400000) * 86400000, 0);
                continue;
            }
            if (!this.DayMatches(cur)) {
                cur = cur.AddDays(1);
                cur = new DateTime((cur.epochMs / 86400000) * 86400000, 0);
                continue;
            }
            if (!this.hours[cur.hour]) {
                cur = cur.AddHours(1);
                cur = new DateTime((cur.epochMs / 3600000) * 3600000, 0);
                continue;
            }
            if (this.minutes[cur.minute]) { return cur; }
            cur = cur.AddMinutes(1);
        }
        return null;
    }

    private DateTime GetNextHosting(DateTime fromTime) {
        DateTime cur = fromTime.AddMilliseconds(0 - fromTime.Millisecond()).AddSeconds(60);
        for (int day = 0; day < 366; day = day + 1) {
            if (this.months[cur.month] && this.DayMatches(cur)) {
                for (int h = 0; h < 24; h = h + 1) {
                    if (!this.hours[h]) { continue; }
                    for (int m = 0; m < 60; m = m + 1) {
                        if (!this.minutes[m]) { continue; }
                        DateTime hit = DateTime.FromParts(cur.year, cur.month, cur.day, h, m, 0);
                        if (hit.epochMs > fromTime.epochMs) { return hit; }
                    }
                }
            }
            cur = cur.AddDays(1);
        }
        return null;
    }
}
