using System;
using System.Collections.Generic;

namespace Tasks.Jobs;

// Five fields: minute, hour, day of month, month, day of week. The public
// constructor and Parse use the Jobs day intersection rule. ParseHosting
// uses the legacy Hosting grammar and day union rule for stored schedules.
public class CronExpression {
    private string raw;
    private bool hostingDays;
    private bool dayStar;
    private bool weekdayStar;
    private long minMask;
    private int hourMask;
    private int dayMask;
    private int monthMask;
    private int dowMask;
    private int firstHour;
    private int firstMin;
    private List<bool> minutesCache;
    private List<bool> hoursCache;
    private List<bool> daysCache;
    private List<bool> monthsCache;
    private List<bool> weekdaysCache;

    public List<bool> minutes {
        get {
            if (this.minutesCache == null) { this.minutesCache = CronExpression.MaskToList64(this.minMask, 60); }
            return this.minutesCache;
        }
        set { this.minutesCache = value; }
    }
    public List<bool> hours {
        get {
            if (this.hoursCache == null) { this.hoursCache = CronExpression.MaskToList32(this.hourMask, 24); }
            return this.hoursCache;
        }
        set { this.hoursCache = value; }
    }
    public List<bool> days {
        get {
            if (this.daysCache == null) { this.daysCache = CronExpression.MaskToList32(this.dayMask, 32); }
            return this.daysCache;
        }
        set { this.daysCache = value; }
    }
    public List<bool> months {
        get {
            if (this.monthsCache == null) { this.monthsCache = CronExpression.MaskToList32(this.monthMask, 13); }
            return this.monthsCache;
        }
        set { this.monthsCache = value; }
    }
    public List<bool> weekdays {
        get {
            if (this.weekdaysCache == null) { this.weekdaysCache = CronExpression.MaskToList32(this.dowMask, 7); }
            return this.weekdaysCache;
        }
        set { this.weekdaysCache = value; }
    }

    public string RawExpression { get { return this.raw; } }

    public CronExpression(string expr) {
        if (expr == null) {
            throw new ArgumentException("Cron expression cannot be empty");
        }
        int len = expr.Length;
        if (len == 0) {
            throw new ArgumentException("Cron expression cannot be empty");
        }
        Span<byte> sp = new Span<byte>((nint)expr, len);
        int st = 0;
        int en = len;
        while (st < en && CronExpression.IsTrimSpace(sp[st] & 255)) { st = st + 1; }
        while (en > st && CronExpression.IsTrimSpace(sp[en - 1] & 255)) { en = en - 1; }
        if (st >= en) {
            throw new ArgumentException("Cron expression cannot be empty");
        }
        string trimmed = (st == 0 && en == len) ? expr : expr.Substring(st, en - st);
        this.Initialize(trimmed, false);
    }

    private CronExpression(string expr, bool hostingDays) {
        this.Initialize(expr, hostingDays);
    }

    public static CronExpression Parse(string expr) {
        return new CronExpression(expr);
    }

    public static CronExpression ParseHosting(string expr) {
        if (expr == null) { return null; }
        try {
            return new CronExpression(expr, true);
        } catch (FormatException e) {
            return null;
        } catch (OverflowException e) {
            return null;
        }
    }

    private static bool IsTrimSpace(int c) {
        return c == 32 || (c >= 9 && c <= 13);
    }

    private void Initialize(string expr, bool hostingDays) {
        this.raw = expr;
        this.hostingDays = hostingDays;

        int n = expr.Length;
        Span<byte> sp = new Span<byte>((nint)expr, n);
        int s0 = 0; int e0 = 0;
        int s1 = 0; int e1 = 0;
        int s2 = 0; int e2 = 0;
        int s3 = 0; int e3 = 0;
        int s4 = 0; int e4 = 0;
        int count = 0;

        int pos = 0;
        if (hostingDays) {
            while (pos < n) {
                while (pos < n) {
                    int b = sp[pos] & 255;
                    if (b != 32 && b != 9) { break; }
                    pos = pos + 1;
                }
                if (pos >= n) { break; }
                int st = pos;
                while (pos < n) {
                    int b = sp[pos] & 255;
                    if (b == 32 || b == 9) { break; }
                    pos = pos + 1;
                }
                if (count == 0) { s0 = st; e0 = pos; }
                else if (count == 1) { s1 = st; e1 = pos; }
                else if (count == 2) { s2 = st; e2 = pos; }
                else if (count == 3) { s3 = st; e3 = pos; }
                else if (count == 4) { s4 = st; e4 = pos; }
                count = count + 1;
            }
        } else {
            while (pos < n) {
                while (pos < n && (sp[pos] & 255) == 32) { pos = pos + 1; }
                if (pos >= n) { break; }
                int st = pos;
                while (pos < n && (sp[pos] & 255) != 32) { pos = pos + 1; }
                int en = pos;
                while (st < en && CronExpression.IsTrimSpace(sp[st] & 255)) { st = st + 1; }
                while (en > st && CronExpression.IsTrimSpace(sp[en - 1] & 255)) { en = en - 1; }
                if (st < en) {
                    if (count == 0) { s0 = st; e0 = en; }
                    else if (count == 1) { s1 = st; e1 = en; }
                    else if (count == 2) { s2 = st; e2 = en; }
                    else if (count == 3) { s3 = st; e3 = en; }
                    else if (count == 4) { s4 = st; e4 = en; }
                    count = count + 1;
                }
            }
        }
        if (count != 5) {
            throw new FormatException("Expected 5 fields in cron expression, got " + count.ToString());
        }
        this.dayStar = (e2 - s2 == 1 && (sp[s2] & 255) == 42);
        this.weekdayStar = (e4 - s4 == 1 && (sp[s4] & 255) == 42);

        this.minMask = this.ParseFieldSlice(expr, sp, s0, e0, 0, 59, false);
        this.hourMask = (int)this.ParseFieldSlice(expr, sp, s1, e1, 0, 23, false);
        this.dayMask = (int)this.ParseFieldSlice(expr, sp, s2, e2, 1, 31, false);
        this.monthMask = (int)this.ParseFieldSlice(expr, sp, s3, e3, 1, 12, false);
        this.dowMask = (int)this.ParseFieldSlice(expr, sp, s4, e4, 0, 6, true);
        this.firstHour = CronExpression.NextBit32(this.hourMask, 0, 23);
        this.firstMin = CronExpression.NextBit64(this.minMask, 0, 59);
        this.minutesCache = null;
        this.hoursCache = null;
        this.daysCache = null;
        this.monthsCache = null;
        this.weekdaysCache = null;
    }

    private static List<bool> MaskToList64(long mask, int size) {
        List<bool> list = new List<bool>();
        list.Reserve(size);
        for (int i = 0; i < size; i = i + 1) {
            list.Add(((mask >> i) & 1L) != 0L);
        }
        return list;
    }

    private static List<bool> MaskToList32(int mask, int size) {
        List<bool> list = new List<bool>();
        list.Reserve(size);
        for (int i = 0; i < size; i = i + 1) {
            list.Add(((mask >> i) & 1) != 0);
        }
        return list;
    }

    private static int ReadNumberSlice(string text, Span<byte> sp, int start, int end) {
        if (start >= end) { throw new FormatException("Missing cron number"); }
        long acc = 0L;
        for (int i = start; i < end; i = i + 1) {
            int c = sp[i] & 255;
            if (c < 48 || c > 57) {
                throw new FormatException("Invalid cron number: " + text.Substring(start, end - start));
            }
            acc = acc * 10L + (long)(c - 48);
            if (acc > 2147483647L) {
                throw new OverflowException("Cron number overflow");
            }
        }
        return (int)acc;
    }

    private long ParseFieldSlice(string expr, Span<byte> sp, int fStart, int fEnd, int min, int max, bool isWeekday) {
        int top = this.hostingDays && isWeekday ? 7 : max;
        long mask = 0L;
        int itemIdx = 0;
        int pos = fStart;
        while (true) {
            int comma = pos;
            while (comma < fEnd && (sp[comma] & 255) != 44) { comma = comma + 1; }
            bool hasMore = comma < fEnd;

            int iStart = pos;
            int iEnd = comma;
            if (!this.hostingDays && iStart < iEnd) {
                while (iStart < iEnd && CronExpression.IsTrimSpace(sp[iStart] & 255)) { iStart = iStart + 1; }
                while (iEnd > iStart && CronExpression.IsTrimSpace(sp[iEnd - 1] & 255)) { iEnd = iEnd - 1; }
            }

            if (iStart >= iEnd) {
                if (this.hostingDays && (itemIdx == 0 || hasMore)) {
                    throw new FormatException("Empty cron list item");
                }
            } else {
                int step = 1;
                int slash = -1;
                for (int k = iStart; k < iEnd; k = k + 1) {
                    if ((sp[k] & 255) == 47) { slash = k; break; }
                }
                int rStart = iStart;
                int rEnd = slash >= 0 ? slash : iEnd;
                if (slash >= 0) {
                    step = CronExpression.ReadNumberSlice(expr, sp, slash + 1, iEnd);
                    if (step <= 0) {
                        throw new FormatException("Invalid step in cron: " + expr.Substring(iStart, iEnd - iStart));
                    }
                }
                int start = min;
                int end = top;
                if (!(rEnd - rStart == 1 && (sp[rStart] & 255) == 42)) {
                    int dash = -1;
                    for (int k = rStart; k < rEnd; k = k + 1) {
                        if ((sp[k] & 255) == 45) { dash = k; break; }
                    }
                    if (dash >= 0) {
                        start = CronExpression.ReadNumberSlice(expr, sp, rStart, dash);
                        end = CronExpression.ReadNumberSlice(expr, sp, dash + 1, rEnd);
                    } else {
                        start = CronExpression.ReadNumberSlice(expr, sp, rStart, rEnd);
                        end = slash >= 0 ? top : start;
                    }
                }
                if (isWeekday && !this.hostingDays) {
                    if (start == 7) { start = 0; }
                    if (end == 7) { end = 0; }
                }
                if (start < min || end > top || start > end) {
                    if (!this.hostingDays && isWeekday && start > end && end == 0) {
                        // Jobs historically normalizes a Sunday endpoint before expanding the range.
                    } else {
                        string item = expr.Substring(iStart, iEnd - iStart);
                        string message = "Cron value out of range [" + min.ToString() + ".." + top.ToString() + "]: " + item;
                        if (this.hostingDays) { throw new FormatException(message); }
                        throw new ArgumentOutOfRangeException(message);
                    }
                } else {
                    for (int value = start; value <= end;) {
                        int bit = (isWeekday && value == 7) ? 0 : value;
                        mask = mask | (1L << bit);
                        if (step > end - value) { break; }
                        value = value + step;
                    }
                }
            }

            if (!hasMore) { break; }
            pos = comma + 1;
            itemIdx = itemIdx + 1;
        }
        return mask;
    }

    private bool DayMatchesBits(int day, int dow) {
        bool dom = ((this.dayMask >> day) & 1) != 0;
        bool w = ((this.dowMask >> dow) & 1) != 0;
        if (!this.hostingDays) { return dom && w; }
        if (!this.dayStar && !this.weekdayStar) { return dom || w; }
        if (!this.dayStar) { return dom; }
        if (!this.weekdayStar) { return w; }
        return true;
    }

    private static long FloorToUnit(long value, long unit) {
        long rem = value % unit;
        return rem < 0L ? (value - rem - unit) : (value - rem);
    }

    private static int DaysInMonthFast(int y, int m) {
        if (m == 2) {
            if ((y % 4 == 0 && y % 100 != 0) || (y % 400 == 0)) { return 29; }
            return 28;
        }
        if (m == 4 || m == 6 || m == 9 || m == 11) { return 30; }
        return 31;
    }

    private static int NextBit32(int mask, int fromBit, int maxBit) {
        if (fromBit > maxBit) { return -1; }
        int shifted = mask >> fromBit;
        if (shifted == 0) { return -1; }
        int tz = 0;
        if ((shifted & 0xFFFF) == 0) { tz = tz + 16; shifted = shifted >> 16; }
        if ((shifted & 0xFF) == 0) { tz = tz + 8; shifted = shifted >> 8; }
        if ((shifted & 0xF) == 0) { tz = tz + 4; shifted = shifted >> 4; }
        if ((shifted & 0x3) == 0) { tz = tz + 2; shifted = shifted >> 2; }
        if ((shifted & 0x1) == 0) { tz = tz + 1; }
        int b = fromBit + tz;
        return b <= maxBit ? b : -1;
    }

    private static int NextBit64(long mask, int fromBit, int maxBit) {
        if (fromBit > maxBit) { return -1; }
        long shifted = mask >> fromBit;
        if (shifted == 0L) { return -1; }
        int tz = 0;
        if ((shifted & 0xFFFFFFFFL) == 0L) { tz = tz + 32; shifted = shifted >> 32; }
        if ((shifted & 0xFFFFL) == 0L) { tz = tz + 16; shifted = shifted >> 16; }
        if ((shifted & 0xFFL) == 0L) { tz = tz + 8; shifted = shifted >> 8; }
        if ((shifted & 0xFL) == 0L) { tz = tz + 4; shifted = shifted >> 4; }
        if ((shifted & 0x3L) == 0L) { tz = tz + 2; shifted = shifted >> 2; }
        if ((shifted & 0x1L) == 0L) { tz = tz + 1; }
        int b = fromBit + tz;
        return b <= maxBit ? b : -1;
    }

    public bool IsMatching(DateTime dt) {
        if (dt == null) { return false; }
        int min = dt.minute;
        int hr = dt.hour;
        int mo = dt.month;
        int dy = dt.day;
        int dw = dt.dayOfWeek;
        if (min < 0 || min >= 60 || hr < 0 || hr >= 24
            || mo < 1 || mo > 12 || dy < 1 || dy > 31
            || dw < 0 || dw >= 7) { return false; }
        return ((this.minMask >> min) & 1L) != 0L
            && ((this.hourMask >> hr) & 1) != 0
            && ((this.monthMask >> mo) & 1) != 0
            && this.DayMatchesBits(dy, dw);
    }

    // Strictly after fromTime, on a minute boundary. Preserve the original
    // Jobs search limit and the Hosting search window of 366 calendar days.
    public DateTime GetNext(DateTime fromTime) {
        if (fromTime == null) { return null; }
        if (this.hostingDays) { return this.GetNextHosting(fromTime); }
        if (this.minMask == 0L || this.hourMask == 0 || this.monthMask == 0
            || this.dayMask == 0 || this.dowMask == 0) {
            return null;
        }
        long startMs = CronExpression.FloorToUnit(fromTime.epochMs, 60000L) + 60000L;
        int y;
        int mo;
        int d;
        int h;
        int m;
        int dow;
        if (fromTime.hour < 23 || fromTime.minute < 59) {
            y = fromTime.year;
            mo = fromTime.month;
            d = fromTime.day;
            dow = fromTime.dayOfWeek;
            if (fromTime.minute < 59) {
                h = fromTime.hour;
                m = fromTime.minute + 1;
            } else {
                h = fromTime.hour + 1;
                m = 0;
            }
        } else {
            DateTime cur = DateTime.FromUnixMilliseconds(startMs);
            y = cur.year;
            mo = cur.month;
            d = cur.day;
            h = cur.hour;
            m = cur.minute;
            dow = cur.dayOfWeek;
        }
        long dayStartMs = CronExpression.FloorToUnit(startMs, 86400000L);

        int firstHour = this.firstHour;
        int firstMin = this.firstMin;

        while (y <= 9999) {
            if (((this.monthMask >> mo) & 1) == 0) {
                int dim = CronExpression.DaysInMonthFast(y, mo);
                int delta = dim - d + 1;
                dayStartMs = dayStartMs + (long)delta * 86400000L;
                dow = (dow + delta) % 7;
                d = 1;
                h = 0;
                m = 0;
                mo = mo + 1;
                if (mo > 12) { mo = 1; y = y + 1; }
                continue;
            }
            if (!this.DayMatchesBits(d, dow)) {
                int dim = CronExpression.DaysInMonthFast(y, mo);
                dayStartMs = dayStartMs + 86400000L;
                dow = dow + 1;
                if (dow >= 7) { dow = 0; }
                d = d + 1;
                h = 0;
                m = 0;
                if (d > dim) {
                    d = 1;
                    mo = mo + 1;
                    if (mo > 12) { mo = 1; y = y + 1; }
                }
                continue;
            }
            int nh = CronExpression.NextBit32(this.hourMask, h, 23);
            if (nh < 0) {
                int dim = CronExpression.DaysInMonthFast(y, mo);
                dayStartMs = dayStartMs + 86400000L;
                dow = dow + 1;
                if (dow >= 7) { dow = 0; }
                d = d + 1;
                h = 0;
                m = 0;
                if (d > dim) {
                    d = 1;
                    mo = mo + 1;
                    if (mo > 12) { mo = 1; y = y + 1; }
                }
                continue;
            }
            if (nh > h) {
                long hitMs = dayStartMs + (long)nh * 3600000L + (long)firstMin * 60000L;
                return new DateTime(hitMs, 0);
            }
            int nm = CronExpression.NextBit64(this.minMask, m, 59);
            if (nm >= 0) {
                long hitMs = dayStartMs + (long)h * 3600000L + (long)nm * 60000L;
                return new DateTime(hitMs, 0);
            }
            int nh2 = CronExpression.NextBit32(this.hourMask, h + 1, 23);
            if (nh2 >= 0) {
                long hitMs = dayStartMs + (long)nh2 * 3600000L + (long)firstMin * 60000L;
                return new DateTime(hitMs, 0);
            }
            int dim2 = CronExpression.DaysInMonthFast(y, mo);
            dayStartMs = dayStartMs + 86400000L;
            dow = dow + 1;
            if (dow >= 7) { dow = 0; }
            d = d + 1;
            h = 0;
            m = 0;
            if (d > dim2) {
                d = 1;
                mo = mo + 1;
                if (mo > 12) { mo = 1; y = y + 1; }
            }
        }
        return null;
    }

    private DateTime GetNextHosting(DateTime fromTime) {
        if (this.minMask == 0L || this.hourMask == 0 || this.monthMask == 0) {
            return null;
        }
        long fromMs = fromTime.epochMs;
        long minCandidateMs = CronExpression.FloorToUnit(fromMs, 60000L) + 60000L;
        int y;
        int mo;
        int d;
        int dow;
        long dayStartMs = CronExpression.FloorToUnit(minCandidateMs, 86400000L);
        if (fromTime.hour < 23 || fromTime.minute < 59) {
            y = fromTime.year;
            mo = fromTime.month;
            d = fromTime.day;
            dow = fromTime.dayOfWeek;
        } else {
            DateTime cur = DateTime.FromUnixMilliseconds(minCandidateMs);
            y = cur.year;
            mo = cur.month;
            d = cur.day;
            dow = cur.dayOfWeek;
        }

        int firstHour = this.firstHour;
        int firstMin = this.firstMin;

        for (int day = 0; day < 366; day = day + 1) {
            if (((this.monthMask >> mo) & 1) != 0 && this.DayMatchesBits(d, dow)) {
                if (dayStartMs >= minCandidateMs) {
                    return new DateTime(dayStartMs + (long)firstHour * 3600000L + (long)firstMin * 60000L, 0);
                }
                long diffMin = (minCandidateMs - dayStartMs) / 60000L;
                if (diffMin < 1440L) {
                    int startH = (int)(diffMin / 60L);
                    int startM = (int)(diffMin - (long)startH * 60L);
                    int nh = CronExpression.NextBit32(this.hourMask, startH, 23);
                    if (nh == startH) {
                        int nm = CronExpression.NextBit64(this.minMask, startM, 59);
                        if (nm >= 0) {
                            return new DateTime(dayStartMs + (long)nh * 3600000L + (long)nm * 60000L, 0);
                        }
                        nh = CronExpression.NextBit32(this.hourMask, startH + 1, 23);
                    }
                    if (nh >= 0) {
                        return new DateTime(dayStartMs + (long)nh * 3600000L + (long)firstMin * 60000L, 0);
                    }
                }
            }
            int dim = CronExpression.DaysInMonthFast(y, mo);
            dayStartMs = dayStartMs + 86400000L;
            dow = dow + 1;
            if (dow >= 7) { dow = 0; }
            d = d + 1;
            if (d > dim) {
                d = 1;
                mo = mo + 1;
                if (mo > 12) { mo = 1; y = y + 1; }
            }
        }
        return null;
    }
}
