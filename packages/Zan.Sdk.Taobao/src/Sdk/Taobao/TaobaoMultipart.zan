using System;
using System.Security.Cryptography;
using System.Text;

namespace Sdk.Taobao;

// 字节安全的 multipart/form-data 请求构造器（防止 NUL 字节截断与头部注入）。
public class TaobaoMultipart {
    private string boundary = "ZanTaobao" + Hex.Encode(RandomNumberGenerator.GetBytes(16));
    private List<byte[]> parts = new List<byte[]>();

    public string ContentType() {
        return "multipart/form-data;charset=utf-8;boundary=" + this.boundary;
    }

    public TaobaoMultipart AddField(string name, string value) {
        string header = this.PartHeader(name) + "\"\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n";
        this.parts.Add(Encoding.GetBytes(header + (value == null ? "" : value) + "\r\n"));
        return this;
    }

    public TaobaoMultipart AddFile(string name, TaobaoFileItem item) {
        if (item == null || !item.IsValid()) {
            throw new TaobaoException("client.invalidArguments", "上传文件对象无效: " + name, 0, "");
        }
        return this.AddFileBytes(name, item.FileName, item.MimeType, item.Content);
    }

    public TaobaoMultipart AddFileBytes(string name, string fileName, string mediaType, byte[] bytes) {
        if (bytes == null) {
            throw new TaobaoException("client.invalidArguments", "上传文件字节不能为空", 0, "");
        }
        TaobaoMultipart.ValidatePartHeader(fileName);
        TaobaoMultipart.ValidatePartHeader(mediaType);
        string header = this.PartHeader(name) + "\"; filename=\"" + fileName
            + "\"\r\nContent-Type: " + mediaType + "\r\n\r\n";
        byte[] file = new byte[bytes.Length];
        Array.Copy(bytes, file, bytes.Length);
        this.parts.Add(Encoding.GetBytes(header));
        this.parts.Add(file);
        this.parts.Add(Encoding.GetBytes("\r\n"));
        return this;
    }

    internal byte[] Body(int requestLimit) {
        byte[] end = Encoding.GetBytes("--" + this.boundary + "--\r\n");
        long length = end.Length;
        for (int i = 0; i < this.parts.Count; i = i + 1) {
            length = length + this.parts[i].Length;
        }
        if (length > requestLimit) {
            throw new TaobaoException("client.invalidArguments", "multipart 正文超过请求字节预算", 0, "");
        }
        byte[] body = new byte[(int)length];
        int offset = 0;
        for (int i = 0; i < this.parts.Count; i = i + 1) {
            byte[] part = this.parts[i];
            Array.Copy(part, 0, body, offset, part.Length);
            offset = offset + part.Length;
        }
        Array.Copy(end, 0, body, offset, end.Length);
        return body;
    }

    private string PartHeader(string name) {
        TaobaoMultipart.ValidatePartHeader(name);
        return "--" + this.boundary + "\r\nContent-Disposition: form-data; name=\"" + name;
    }

    private static void ValidatePartHeader(string value) {
        if (value == null || value.Length == 0) {
            throw new TaobaoException("client.invalidArguments", "multipart 部分头不能为空", 0, "");
        }
        for (int i = 0; i < value.Length; i = i + 1) {
            int c = value[i] & 255;
            if (c < 32 || c == 127 || c == 34 || c == 92) {
                throw new TaobaoException("client.invalidArguments", "multipart 部分头包含非法字符", 0, "");
            }
        }
    }
}
