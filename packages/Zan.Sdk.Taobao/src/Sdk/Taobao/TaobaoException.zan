using System;

namespace Sdk.Taobao;

public class TaobaoException : Exception {
    public string Code;
    public string SubCode;
    public string SubMessage;
    public string RequestId;
    public int StatusCode;
    public string Body;

    public TaobaoException(string code, string message, string subCode, string subMessage,
                           string requestId, int statusCode, string body)
        : base(message) {
        this.Code = code == null ? "" : code;
        this.SubCode = subCode == null ? "" : subCode;
        this.SubMessage = subMessage == null ? "" : subMessage;
        this.RequestId = requestId == null ? "" : requestId;
        this.StatusCode = statusCode;
        this.Body = body == null ? "" : body;
    }

    public TaobaoException(string code, string message, int statusCode, string body)
        : this(code, message, "", "", "", statusCode, body) {}

    public bool IsIspError {
        get { return this.SubCode.StartsWith("isp."); }
    }

    public bool IsRateLimited {
        get {
            return this.StatusCode == 429
                || this.Code == "7"
                || this.SubCode == "isp.limited"
                || this.SubCode == "isv.call-limited"
                || this.SubCode.StartsWith("isp.");
        }
    }

    public bool IsSessionExpired {
        get {
            return this.Code == "27"
                || this.SubCode == "session-expired"
                || this.SubCode == "invalid-sessionkey";
        }
    }
}
