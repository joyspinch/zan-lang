using System;
using System.Text;

namespace Sdk.Taobao;

public class TaobaoBatchItem {
    public string Method;
    public Dictionary<string, string> Parameters;
    public string Session;
    public string TargetAppKey;

    public TaobaoBatchItem(string method, Dictionary<string, string>? parameters = null,
                           string session = "", string targetAppKey = "") {
        this.Method = method == null ? "" : method;
        this.Parameters = parameters == null ? new Dictionary<string, string>() : parameters;
        this.Session = session == null ? "" : session;
        this.TargetAppKey = targetAppKey == null ? "" : targetAppKey;
    }
}

public class TaobaoBatchRequest {
    public string PublicMethodValue;
    public Dictionary<string, string> PublicParams;
    public Dictionary<string, string> HeaderParams;
    public List<TaobaoBatchItem> Items;
    public string SeparatorValue;
    public string TargetAppKeyValue;

    public TaobaoBatchRequest() {
        this.PublicMethodValue = "";
        this.PublicParams = new Dictionary<string, string>();
        this.HeaderParams = new Dictionary<string, string>();
        this.Items = new List<TaobaoBatchItem>();
        this.SeparatorValue = "\r\n-S-\r\n";
        this.TargetAppKeyValue = "";
    }

    public TaobaoBatchRequest PublicMethod(string method) {
        this.PublicMethodValue = method == null ? "" : method;
        return this;
    }

    public TaobaoBatchRequest AddPublicParam(string key, string value) {
        if (key != null && key.Length > 0 && value != null) {
            this.PublicParams.Add(key, value);
        }
        return this;
    }

    public TaobaoBatchRequest AddHeader(string key, string value) {
        if (key != null && key.Length > 0 && value != null) {
            this.HeaderParams.Add(key, value);
        }
        return this;
    }

    public TaobaoBatchRequest Separator(string separator) {
        if (separator != null && separator.Length > 0) {
            this.SeparatorValue = separator;
        }
        return this;
    }

    public TaobaoBatchRequest TargetAppKey(string targetAppKey) {
        this.TargetAppKeyValue = targetAppKey == null ? "" : targetAppKey;
        return this;
    }

    public TaobaoBatchRequest Add(string method, Dictionary<string, string>? parameters = null,
                                  string session = "", string targetAppKey = "") {
        this.Items.Add(new TaobaoBatchItem(method, parameters, session, targetAppKey));
        return this;
    }
}

public class TaobaoBatchResponse {
    public List<TaobaoResponse> Responses;
    public int StatusCode;
    public string RawBody;

    public TaobaoBatchResponse(List<TaobaoResponse> responses, int statusCode, string rawBody) {
        this.Responses = responses == null ? new List<TaobaoResponse>() : responses;
        this.StatusCode = statusCode;
        this.RawBody = rawBody == null ? "" : rawBody;
    }

    public int Count {
        get { return this.Responses.Count; }
    }

    public TaobaoResponse Get(int index) {
        return this.Responses[index];
    }

    internal static TaobaoBatchResponse Parse(int statusCode, string body, string separator,
                                              int expectedCount, bool simplify) {
        if (statusCode < 200 || statusCode >= 300) {
            throw new TaobaoException("http." + Convert.ToString(statusCode),
                "淘宝批量 API HTTP 请求失败", statusCode, body);
        }
        if (body == null || body.Length == 0) {
            throw new TaobaoException("client.invalidResponse", "淘宝批量 API 返回空响应", statusCode, "");
        }
        if (separator == null || separator.Length == 0) {
            throw new TaobaoException("client.invalidArguments", "批量响应分隔符不能为空", statusCode, "");
        }

        List<string> parts = TaobaoBatchResponse.SplitBySeparator(body, separator);
        if (parts.Count > 0 && parts.Count != expectedCount) {
            // 网关前置拦截只返回一条统一错误响应。
            TaobaoResponse.Parse(statusCode, parts[0], simplify);
            throw new TaobaoException("client.invalidResponse",
                "批量响应分段数量与请求数不匹配", statusCode, body);
        }

        List<TaobaoResponse> parsed = new List<TaobaoResponse>();
        for (int i = 0; i < parts.Count; i = i + 1) {
            parsed.Add(TaobaoResponse.Parse(statusCode, parts[i], simplify));
        }
        return new TaobaoBatchResponse(parsed, statusCode, body);
    }

    private static List<string> SplitBySeparator(string text, string sep) {
        List<string> result = new List<string>();
        int start = 0;
        while (true) {
            int idx = text.IndexOf(sep, start);
            if (idx < 0) {
                result.Add(text.Substring(start));
                break;
            }
            result.Add(text.Substring(start, idx - start));
            start = idx + sep.Length;
        }
        return result;
    }
}
