    public string Created = "";
    // 视频关联记录的id，和商品相对应
    public long Id = 0L;
    // 视频记录关联的商品的数字id(注意：iid近期即将废弃，请用num_iid参数)
    public string Iid = "";
    // 视频关联记录修改时间（格式：yyyy-MM-dd HH:mm:ss）
    public string Modified = "";
    // 视频记录所关联的商品的数字id
    public long NumIid = 0L;
    // video的url连接地址。淘秀里视频记录里面存储的url地址
    public string Url = "";
    // video的id，对应于视频在淘秀的存储记录
    public long VideoId = 0L;

    public static Video FromJson(JsonValue? obj) {
        Video item = new Video();
        if (obj == null || !obj.IsObject()) { return item; }
        item.Created = TaobaoJson.GetString(obj, "created", "");
        item.Id = TaobaoJson.GetLong(obj, "id", 0L);
        item.Iid = TaobaoJson.GetString(obj, "iid", "");
        item.Modified = TaobaoJson.GetString(obj, "modified", "");
        item.NumIid = TaobaoJson.GetLong(obj, "num_iid", 0L);
        item.Url = TaobaoJson.GetString(obj, "url", "");
        item.VideoId = TaobaoJson.GetLong(obj, "video_id", 0L);
        return item;
    }
