using System;
using System.Json;
using Sdk.Taobao;

namespace Sdk.Taobao.Api.Item;

public class Sku {
    // 商品级别的条形码
    public string Barcode = "";
    // 基础色数据
    public string ChangeProp = "";
    // sku创建日期 时间格式：yyyy-MM-dd HH:mm:ss
    public string Created = "";
    // skuDeliveryTimeType
    public string DeliveryTimeType = "";
    // 扩展sku的id
    public long ExtraId = 0L;
    public string GmtModified = "";
    // sku所属商品id(注意：iid近期即将废弃，请用num_iid参数)
    public string Iid = "";
    // 扩展sku的备注信息
    public string Memo = "";
    // sku最后修改日期 时间格式：yyyy-MM-dd HH:mm:ss
    public string Modified = "";
    // sku所属商品数字id
    public long NumIid = 0L;
    // 商家设置的外部id。天猫和集市的卖家，需要登录才能获取到自己的商家编码，不能获取到他人的商家编码。
    public string OuterId = "";
    // 属于这个sku的商品的价格 取值范围:0-100000000;精确到2位小数;单位:元。如:200.07，表示:200元7分。
    public string Price = "";
    // sku的销售属性组合字符串（颜色，大小，等等，可通过类目API获取某类目下的销售属性）,格式是p1:v1;p2:v2
    public string Properties = "";
    // sku所对应的销售属性的中文名字串，格式如：pid1:vid1:pid_name1:vid_name1;pid2:vid2:pid_name2:vid_name2……
    public string PropertiesName = "";
    // 属于这个sku的商品的数量，
    public long Quantity = 0L;
    // sku时间或
    public string SkuDeliveryTime = "";
    // skuFeature
    public SkuFeature? SkuFeature = null;
    // sku的id
    public long SkuId = 0L;
    // sku图片
    public List<string> SkuPicture = new List<string>();
    // 表示SKu上的产品规格信息
    public long SkuSpecId = 0L;
    // specId
    public string SpecId = "";
    // sku状态。 normal:正常 ；delete:删除
    public string Status = "";
    // 商品在付款减库存的状态下，该sku上未付款的订单数量
    public long WithHoldQuantity = 0L;

    public static Sku FromJson(JsonValue? obj) {
        Sku item = new Sku();
        if (obj == null || !obj.IsObject()) { return item; }
        item.Barcode = TaobaoJson.GetString(obj, "barcode", "");
        item.ChangeProp = TaobaoJson.GetString(obj, "change_prop", "");
        item.Created = TaobaoJson.GetString(obj, "created", "");
        item.DeliveryTimeType = TaobaoJson.GetString(obj, "delivery_time_type", "");
        item.ExtraId = TaobaoJson.GetLong(obj, "extra_id", 0L);
        item.GmtModified = TaobaoJson.GetString(obj, "gmt_modified", "");
        item.Iid = TaobaoJson.GetString(obj, "iid", "");
        item.Memo = TaobaoJson.GetString(obj, "memo", "");
        item.Modified = TaobaoJson.GetString(obj, "modified", "");
        item.NumIid = TaobaoJson.GetLong(obj, "num_iid", 0L);
        item.OuterId = TaobaoJson.GetString(obj, "outer_id", "");
        item.Price = TaobaoJson.GetString(obj, "price", "");
        item.Properties = TaobaoJson.GetString(obj, "properties", "");
        item.PropertiesName = TaobaoJson.GetString(obj, "properties_name", "");
        item.Quantity = TaobaoJson.GetLong(obj, "quantity", 0L);
        item.SkuDeliveryTime = TaobaoJson.GetString(obj, "sku_delivery_time", "");
        JsonValue? v_SkuFeature = TaobaoJson.GetValue(obj, "sku_feature");
        if (v_SkuFeature != null && v_SkuFeature.IsObject()) {
            item.SkuFeature = SkuFeature.FromJson(v_SkuFeature);
        }
        item.SkuId = TaobaoJson.GetLong(obj, "sku_id", 0L);
        item.SkuPicture = TaobaoJson.GetStringList(obj, "sku_picture", "string");
        item.SkuSpecId = TaobaoJson.GetLong(obj, "sku_spec_id", 0L);
        item.SpecId = TaobaoJson.GetString(obj, "spec_id", "");
        item.Status = TaobaoJson.GetString(obj, "status", "");
        item.WithHoldQuantity = TaobaoJson.GetLong(obj, "with_hold_quantity", 0L);
        return item;
    }
}
