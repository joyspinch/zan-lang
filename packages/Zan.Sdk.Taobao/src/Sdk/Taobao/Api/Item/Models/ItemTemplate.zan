using System;
using System.Json;
using Sdk.Taobao;

namespace Sdk.Taobao.Api.Item;

public class ItemTemplate {
    // 用于区分宝贝模板属于内店和外店
    public long ShopType = 0L;
    // 宝贝模板的id
    public long TemplateId = 0L;
    // 宝贝详情模板的名称
    public string TemplateName = "";

    public static ItemTemplate FromJson(JsonValue? obj) {
        ItemTemplate item = new ItemTemplate();
        if (obj == null || !obj.IsObject()) { return item; }
        item.ShopType = TaobaoJson.GetLong(obj, "shop_type", 0L);
        item.TemplateId = TaobaoJson.GetLong(obj, "template_id", 0L);
        item.TemplateName = TaobaoJson.GetString(obj, "template_name", "");
        return item;
    }
}
