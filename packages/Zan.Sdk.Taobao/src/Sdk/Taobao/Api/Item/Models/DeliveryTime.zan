    public string DeliveryTime_ = "";
    // 发货时间类型：相对发货时间、固定发货时间
    public string DeliveryTimeType = "";
    // 是否设置了发货时间：未设置、商品维度、sku维度
    public string NeedDeliveryTime = "";
