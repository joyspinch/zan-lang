// Generated by scripts/generate_catalog.py.

using System;
using System.Json;
using Sdk.Taobao;

namespace Sdk.Taobao.Api.Item;

public class ItemImg {
    // 图片创建时间 时间格式：yyyy-MM-dd HH:mm:ss
    public string Created = "";
    // 商品图片的id，和商品相对应（主图id默认为0）
    public long Id = 0L;
    // 图片放在第几张（多图时可设置）
    public long Position = 0L;
    // 图片链接地址
    public string Url = "";

    public static ItemImg FromJson(JsonValue? obj) {
        ItemImg item = new ItemImg();
        if (obj == null || !obj.IsObject()) { return item; }
        item.Created = TaobaoJson.GetString(obj, "created", "");
        item.Id = TaobaoJson.GetLong(obj, "id", 0L);
        item.Position = TaobaoJson.GetLong(obj, "position", 0L);
        item.Url = TaobaoJson.GetString(obj, "url", "");
        return item;
    }
}
