// Generated by scripts/generate_catalog.py.

using System;
using System.Json;
using Sdk.Taobao;

namespace Sdk.Taobao.Api.Item;

public class Location {
    // 详细地址，最大256个字节（128个中文）
    public string Address = "";
    // 所在城市（中文名称）
    public string City = "";
    // 国家名称
    public string Country = "";
    // 区/县（只适用于物流API）
    public string District = "";
    // 所在省份（中文名称）
    public string State = "";
    // 邮政编码
    public string Zip = "";

    public static Location FromJson(JsonValue? obj) {
        Location item = new Location();
        if (obj == null || !obj.IsObject()) { return item; }
        item.Address = TaobaoJson.GetString(obj, "address", "");
        item.City = TaobaoJson.GetString(obj, "city", "");
        item.Country = TaobaoJson.GetString(obj, "country", "");
        item.District = TaobaoJson.GetString(obj, "district", "");
        item.State = TaobaoJson.GetString(obj, "state", "");
        item.Zip = TaobaoJson.GetString(obj, "zip", "");
        return item;
    }
}
