// Generated by scripts/generate_catalog.py.

using System;
using System.Json;
using Sdk.Taobao;

namespace Sdk.Taobao.Api.Item;

public class ItemDescModule {
    // 描述具体内容
    public string Content = "";
    // 一个List<String>的Json串，里面是模块引导提示，不超过3条（isv提交时可忽略不传）
    public string Intros = "";
    // 模块id ,(注意:用户自定义模块不用填此项。)
    public long ModuleId = 0L;
    // 模块名称
    public string ModuleName = "";
    // 是否必填 （isv提交时可忽略不传）
    public bool Required = false;
    // 淘宝图片空间的地址链接，示例模板，最多不超过三个（isv提交时可忽略不传）
    public string TplUrls = "";
    // cat_mod:表示是运营设置的类目维度模块，usr_mod表示的是商家自定义模块。
    public string Type = "";

    public static ItemDescModule FromJson(JsonValue? obj) {
        ItemDescModule item = new ItemDescModule();
        if (obj == null || !obj.IsObject()) { return item; }
        item.Content = TaobaoJson.GetString(obj, "content", "");
        item.Intros = TaobaoJson.GetString(obj, "intros", "");
        item.ModuleId = TaobaoJson.GetLong(obj, "module_id", 0L);
        item.ModuleName = TaobaoJson.GetString(obj, "module_name", "");
        item.Required = TaobaoJson.GetBool(obj, "required", false);
        item.TplUrls = TaobaoJson.GetString(obj, "tpl_urls", "");
        item.Type = TaobaoJson.GetString(obj, "type", "");
        return item;
    }
}
