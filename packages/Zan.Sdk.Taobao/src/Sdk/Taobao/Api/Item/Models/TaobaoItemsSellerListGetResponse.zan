        item.VideoId = TaobaoJson.GetLong(obj, "video_id", 0L);
        List<JsonValue> list_Videos = TaobaoJson.GetJsonList(obj, "videos");
        for (int i = 0; i < list_Videos.Count; i = i + 1) {
            item.Videos.Add(TaobaoItemsSellerListGetVideo.FromJson(list_Videos[i]));
        }
        item.Violation = TaobaoJson.GetBool(obj, "violation", false);
        item.Volume = TaobaoJson.GetLong(obj, "volume", 0L);
        item.WapDesc = TaobaoJson.GetString(obj, "wap_desc", "");
        item.WapDetailUrl = TaobaoJson.GetString(obj, "wap_detail_url", "");
        item.WirelessDesc = TaobaoJson.GetString(obj, "wireless_desc", "");
        item.WithHoldQuantity = TaobaoJson.GetLong(obj, "with_hold_quantity", 0L);
        item.WwStatus = TaobaoJson.GetBool(obj, "ww_status", false);
        item.DescModules = TaobaoJson.GetString(obj, "desc_modules", "");
        JsonValue? v_CuntaoItemSpecific = TaobaoJson.GetValue(obj, "cuntao_item_specific");
        if (v_CuntaoItemSpecific != null && v_CuntaoItemSpecific.IsObject()) {
            item.CuntaoItemSpecific = TaobaoItemsSellerListGetCuntaoItemSpecific.FromJson(v_CuntaoItemSpecific);
        }
        List<JsonValue> list_ItemRectangleImgs = TaobaoJson.GetJsonList(obj, "item_rectangle_imgs");
        for (int i = 0; i < list_ItemRectangleImgs.Count; i = i + 1) {
            item.ItemRectangleImgs.Add(TaobaoItemsSellerListGetItemImg.FromJson(list_ItemRectangleImgs[i]));
        }
        return item;
    }
}

