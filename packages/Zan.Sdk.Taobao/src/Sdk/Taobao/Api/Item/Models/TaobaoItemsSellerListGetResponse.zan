public class TaobaoItemsSellerListGetPaimaiInfo {
    // 用户自定义的固定保证金。如果用户未传则说明用户选择使用淘宝默认的保证金模式10%，此时deposit等于0.
    public long Deposit = 0L;
    // 增价幅度或降价幅度
    public string Increment = "";
    // 降价拍中的降价间隔
    public long Interval = 0L;
    // 拍卖类型，目前包括增加拍，荷兰拍和降价拍。
    public long Mode = 0L;
    // 降价拍的保留价
    public string Reserve = "";
    // 对于拍卖来说可以设定有效期，这里是有效期的小时数。
    public long ValidHour = 0L;
    // 对于拍卖来说可以设定有效期，这里是有效期的分钟数。
    public long ValidMinute = 0L;
    // 重复上拍总次数，如果不是重复上拍的，则为0
    public long Repeat = 0L;
    // 拍品开始时间
    public string Start = "";
    // 拍品结束时间
    public string End = "";
    // 拍品起拍价
    public long StartPrice = 0L;
    // 拍品封顶价（分）
    public long CeilPrice = 0L;
    // 增加拍延迟周期（分钟）
    public long DelayInMinute = 0L;
    // 拍卖周期（秒钟），非重复上架为（开始时间-结束时间），当为重复上拍时为一次重复上架的时间
    public long Period = 0L;
    // 降价时间周期（分钟）
    public long Frequency = 0L;

    public static TaobaoItemsSellerListGetPaimaiInfo FromJson(JsonValue? obj) {
        TaobaoItemsSellerListGetPaimaiInfo item = new TaobaoItemsSellerListGetPaimaiInfo();
        if (obj == null || !obj.IsObject()) { return item; }
