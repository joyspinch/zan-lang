public class TaobaoItemsSellerListGetLocalityLife {
    // 表示是否使用邮寄 0: 代表不使用邮寄； 1：代表使用邮寄；如果不设置这个值，代表不使用邮寄
    public string ChooseLogis = "";
    // 电子凭证业务属性
    public string Eticket = "";
    // 电子交易凭证有效期，有三种格式：如果有效期为起止日期类型，此值为2012-08-06,2012-08-16 如果有效期为【购买成功日 至】类型则格式为2012-08-16如果有效期为天数类型则格式为15
    public string Expirydate = "";
    // 格式为 码商id:nick
    public string Merchant = "";
    // 网点ID,在参数empty_fields里设置locality_life.network_id可删除网点ID
    public string NetworkId = "";
    // 电子凭证售中自动退款比例
    public long OnsaleAutoRefundRatio = 0L;
    // 退款比例，百分比%前的数字，1-100的正整数值；在参数empty_fields里设置locality_life.refund_ratio可删除退款比例
    public long RefundRatio = 0L;
    // 退款码费承担方。发布电子凭证宝贝的时候会增加“退款码费承担方”配置项，可选填：(1)s（卖家承担） (2)b(买家承担)
    public string Refundmafee = "";
    // 核销打款:1代表核销打款,0代表非核销打款;在参数empty_fields里设置locality_life.verification可删除核销打款
    public string Verification = "";

    public static TaobaoItemsSellerListGetLocalityLife FromJson(JsonValue? obj) {
        TaobaoItemsSellerListGetLocalityLife item = new TaobaoItemsSellerListGetLocalityLife();
        if (obj == null || !obj.IsObject()) { return item; }
        item.ChooseLogis = TaobaoJson.GetString(obj, "choose_logis", "");
        item.Eticket = TaobaoJson.GetString(obj, "eticket", "");
        item.Expirydate = TaobaoJson.GetString(obj, "expirydate", "");
        item.Merchant = TaobaoJson.GetString(obj, "merchant", "");
        item.NetworkId = TaobaoJson.GetString(obj, "network_id", "");
        item.OnsaleAutoRefundRatio = TaobaoJson.GetLong(obj, "onsale_auto_refund_ratio", 0L);
        item.RefundRatio = TaobaoJson.GetLong(obj, "refund_ratio", 0L);
        item.Refundmafee = TaobaoJson.GetString(obj, "refundmafee", "");
        item.Verification = TaobaoJson.GetString(obj, "verification", "");
        return item;
    }
}

