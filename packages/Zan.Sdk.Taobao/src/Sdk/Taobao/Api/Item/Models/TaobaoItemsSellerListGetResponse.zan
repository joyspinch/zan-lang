        item.Reserve = TaobaoJson.GetString(obj, "reserve", "");
        item.ValidHour = TaobaoJson.GetLong(obj, "valid_hour", 0L);
        item.ValidMinute = TaobaoJson.GetLong(obj, "valid_minute", 0L);
        item.Repeat = TaobaoJson.GetLong(obj, "repeat", 0L);
        item.Start = TaobaoJson.GetString(obj, "start", "");
        item.End = TaobaoJson.GetString(obj, "end", "");
        item.StartPrice = TaobaoJson.GetLong(obj, "start_price", 0L);
        item.CeilPrice = TaobaoJson.GetLong(obj, "ceil_price", 0L);
        item.DelayInMinute = TaobaoJson.GetLong(obj, "delay_in_minute", 0L);
        item.Period = TaobaoJson.GetLong(obj, "period", 0L);
        item.Frequency = TaobaoJson.GetLong(obj, "frequency", 0L);
        return item;
    }
}

