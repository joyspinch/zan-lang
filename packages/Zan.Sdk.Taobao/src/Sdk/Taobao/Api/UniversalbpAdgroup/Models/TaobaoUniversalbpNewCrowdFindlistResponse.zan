    public string OptionName = "";
    // 选项值
    public string OptionValue = "";
    // 选项id，(用于关键词推广静态标签生成人群)如基础属性人群标签组合
    public long TagId = 0L;

    public static TaobaoUniversalbpNewCrowdFindlistExtendSeedOptionVO FromJson(JsonValue? obj) {
        TaobaoUniversalbpNewCrowdFindlistExtendSeedOptionVO item = new TaobaoUniversalbpNewCrowdFindlistExtendSeedOptionVO();
        if (obj == null || !obj.IsObject()) { return item; }
        item.OptionName = TaobaoJson.GetString(obj, "option_name", "");
        item.OptionValue = TaobaoJson.GetString(obj, "option_value", "");
        item.TagId = TaobaoJson.GetLong(obj, "tag_id", 0L);
        return item;
    }
}
