using System;
using System.Security.Cryptography;
using System.Text;

namespace Sdk.Taobao;

public static class TaobaoSign {
    public static const string SignMethodHmacSha256 = "hmac-sha256";
    public static const string SignMethodHmac = "hmac";
    public static const string SignMethodMd5 = "md5";

    private static int LowerAscii(int c) {
        return (c >= 65 && c <= 90) ? (c + 32) : c;
    }

    // 0 = hmac-sha256, 1 = hmac, 2 = md5, -1 = unsupported
    private static int ParseMethod(string signMethod) {
        if (signMethod == null || signMethod.Length == 0) { return 0; }
        int n = signMethod.Length;
        if (n == 11) {
            if (TaobaoSign.LowerAscii(signMethod[0] & 255) == 104
                && TaobaoSign.LowerAscii(signMethod[1] & 255) == 109
                && TaobaoSign.LowerAscii(signMethod[2] & 255) == 97
                && TaobaoSign.LowerAscii(signMethod[3] & 255) == 99
                && (signMethod[4] & 255) == 45
                && TaobaoSign.LowerAscii(signMethod[5] & 255) == 115
                && TaobaoSign.LowerAscii(signMethod[6] & 255) == 104
                && TaobaoSign.LowerAscii(signMethod[7] & 255) == 97
                && (signMethod[8] & 255) == 50
                && (signMethod[9] & 255) == 53
                && (signMethod[10] & 255) == 54) {
                return 0;
            }
            return -1;
        }
        if (n == 4) {
            if (TaobaoSign.LowerAscii(signMethod[0] & 255) == 104
                && TaobaoSign.LowerAscii(signMethod[1] & 255) == 109
                && TaobaoSign.LowerAscii(signMethod[2] & 255) == 97
                && TaobaoSign.LowerAscii(signMethod[3] & 255) == 99) {
                return 1;
            }
            return -1;
        }
        if (n == 3) {
            if (TaobaoSign.LowerAscii(signMethod[0] & 255) == 109
                && TaobaoSign.LowerAscii(signMethod[1] & 255) == 100
                && (signMethod[2] & 255) == 53) {
                return 2;
            }
        }
        return -1;
    }

    private static void SiftDownPair(string[] keys, string[] vals, int root, int end) {
        while (true) {
            int child = root * 2 + 1;
            if (child >= end) { break; }
            int swap = root;
            if (String.CompareOrdinal(keys[swap], keys[child]) < 0) {
                swap = child;
            }
            if (child + 1 < end
                && String.CompareOrdinal(keys[swap], keys[child + 1]) < 0) {
                swap = child + 1;
            }
            if (swap == root) { break; }
            string tk = keys[root]; keys[root] = keys[swap]; keys[swap] = tk;
            string tv = vals[root]; vals[root] = vals[swap]; vals[swap] = tv;
            root = swap;
        }
    }

    private static string ToHexUpper(byte[] digest) {
        int n = digest.Length;
        byte[] hex = new byte[n * 2];
        for (int i = 0; i < n; i = i + 1) {
            int b = digest[i] & 255;
            int hi = (b >> 4) & 15;
            int lo = b & 15;
            hex[i * 2] = (byte)(hi < 10 ? hi + 48 : hi + 55);
            hex[i * 2 + 1] = (byte)(lo < 10 ? lo + 48 : lo + 55);
        }
        return NativeMemory.GetString((nint)hex, 0, n * 2);
    }

    private static bool IsUrlUnreserved(int c) {
        return (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
            || (c >= 48 && c <= 57) || c == 45 || c == 95 || c == 46 || c == 126;
    }

    private static int UrlEncodedLen(string s) {
        int n = s.Length;
        int outLen = n;
        for (int i = 0; i < n; i = i + 1) {
            int c = s[i] & 255;
            if (!TaobaoSign.IsUrlUnreserved(c) && c != 32) {
                outLen = outLen + 2;
            }
        }
        return outLen;
    }

    private static int WriteUrlEncoded(byte[] buf, nint bp, int di, string s) {
        int n = s.Length;
        if (n == 0) { return di; }
        int i = 0;
        while (i < n && TaobaoSign.IsUrlUnreserved(s[i] & 255)) { i = i + 1; }
        if (i == n) {
            NativeMemory.Copy(bp + (nint)di, (nint)s, n);
            return di + n;
        }
        if (i > 0) {
            NativeMemory.Copy(bp + (nint)di, (nint)s, i);
            di = di + i;
        }
        while (i < n) {
            int c = s[i] & 255;
            if (TaobaoSign.IsUrlUnreserved(c)) {
                buf[di] = (byte)c;
                di = di + 1;
            } else if (c == 32) {
                buf[di] = 43;
                di = di + 1;
            } else {
                int hi = (c >> 4) & 15;
                int lo = c & 15;
                buf[di] = 37;
                buf[di + 1] = (byte)(hi < 10 ? hi + 48 : hi + 87);
                buf[di + 2] = (byte)(lo < 10 ? lo + 48 : lo + 87);
                di = di + 3;
            }
            i = i + 1;
        }
        return di;
    }

    public static string Compute(Dictionary<string, string> parameters, string secret, string signMethod) {
        return TaobaoSign.ComputeWithBody(parameters, "", secret, signMethod);
    }

    public static string ComputeWithBody(Dictionary<string, string> parameters, string body,
                                         string secret, string signMethod) {
        if (parameters == null || secret == null || secret.Length == 0) {
            throw new TaobaoException("client.invalidArguments", "签名需要参数和应用密钥", 0, "");
        }
        int methodKind = TaobaoSign.ParseMethod(signMethod);
        if (methodKind < 0) {
            throw new TaobaoException("client.invalidArguments", "不支持的签名方式: " + signMethod, 0, "");
        }

        // 单遍抽取有效键值并原地排序（免 order[] 分配与二次字典查询，不改原字典状态）。
        List<string> rawKeys = parameters.Keys;
        int rawCount = rawKeys.Count;
        string[] keys = new string[rawCount];
        string[] vals = new string[rawCount];
        int cnt = 0;
        int payloadLen = 0;
        for (int i = 0; i < rawCount; i = i + 1) {
            string key = rawKeys[i];
            if (key != null && key.Length > 0 && key != "sign") {
                string val = parameters[key];
                if (val != null && val.Length > 0) {
                    keys[cnt] = key;
                    vals[cnt] = val;
                    cnt = cnt + 1;
                    payloadLen = payloadLen + key.Length + val.Length;
                }
            }
        }
        if (cnt > 1) {
            if (cnt <= 32) {
                for (int i = 1; i < cnt; i = i + 1) {
                    string curKey = keys[i];
                    string curVal = vals[i];
                    int j = i - 1;
                    while (j >= 0 && String.CompareOrdinal(keys[j], curKey) > 0) {
                        keys[j + 1] = keys[j];
                        vals[j + 1] = vals[j];
                        j = j - 1;
                    }
                    keys[j + 1] = curKey;
                    vals[j + 1] = curVal;
                }
            } else {
                for (int start = (cnt - 2) / 2; start >= 0; start = start - 1) {
                    TaobaoSign.SiftDownPair(keys, vals, start, cnt);
                }
                for (int end = cnt - 1; end > 0; end = end - 1) {
                    string tk = keys[end]; keys[end] = keys[0]; keys[0] = tk;
                    string tv = vals[end]; vals[end] = vals[0]; vals[0] = tv;
                    TaobaoSign.SiftDownPair(keys, vals, 0, end);
                }
            }
        }

        int secretLen = secret.Length;
        int bodyLen = body == null ? 0 : body.Length;
        int totalLen = payloadLen + bodyLen + (methodKind == 2 ? secretLen * 2 : 0);
        byte[] buf = new byte[totalLen];
        nint bp = (nint)buf;
        int di = 0;
        if (methodKind == 2) {
            NativeMemory.Copy(bp, (nint)secret, secretLen);
            di = secretLen;
        }
        for (int i = 0; i < cnt; i = i + 1) {
            string k = keys[i];
            string v = vals[i];
            int kl = k.Length;
            int vl = v.Length;
            NativeMemory.Copy(bp + (nint)di, (nint)k, kl);
            di = di + kl;
            NativeMemory.Copy(bp + (nint)di, (nint)v, vl);
            di = di + vl;
        }
        if (bodyLen > 0) {
            NativeMemory.Copy(bp + (nint)di, (nint)body, bodyLen);
            di = di + bodyLen;
        }

        byte[] digest;
        if (methodKind == 2) {
            NativeMemory.Copy(bp + (nint)di, (nint)secret, secretLen);
            digest = Md5.Hash(buf, totalLen);
        } else if (methodKind == 0) {
            string msg = NativeMemory.GetString(bp, 0, totalLen);
            digest = Hmac.Sha256Mac(secret, secretLen, msg, totalLen);
        } else {
            string msg = NativeMemory.GetString(bp, 0, totalLen);
            digest = Hmac.Compute(Hmac.MD5, secret, secretLen, msg, totalLen);
        }
        return TaobaoSign.ToHexUpper(digest);
    }

    public static string FormEncode(Dictionary<string, string> fields) {
        if (fields == null || fields.Count == 0) { return ""; }
        List<string> rawKeys = fields.Keys;
        int rawCount = rawKeys.Count;
        string[] vals = new string[rawCount];
        int cnt = 0;
        long totalL = 0L;
        for (int i = 0; i < rawCount; i = i + 1) {
            string key = rawKeys[i];
            if (key == null || key.Length == 0) { continue; }
            string val = fields[key];
            if (val == null) { continue; }
            vals[i] = val;
            if (cnt > 0) { totalL = totalL + 1L; }
            totalL = totalL + (long)TaobaoSign.UrlEncodedLen(key) + 1L + (long)TaobaoSign.UrlEncodedLen(val);
            cnt = cnt + 1;
        }
        if (cnt == 0) { return ""; }
        int total = (int)totalL;
        byte[] buf = new byte[total];
        nint bp = (nint)buf;
        int di = 0;
        bool first = true;
        for (int i = 0; i < rawCount; i = i + 1) {
            string val = vals[i];
            if (val == null) { continue; }
            if (!first) { buf[di] = 38; di = di + 1; }
            first = false;
            di = TaobaoSign.WriteUrlEncoded(buf, bp, di, rawKeys[i]);
            buf[di] = 61; di = di + 1;
            di = TaobaoSign.WriteUrlEncoded(buf, bp, di, val);
        }
        return NativeMemory.GetString(bp, 0, total);
    }

    public static string BuildUrlWithQuery(string basePath, Dictionary<string, string> queryParams) {
        string q = TaobaoSign.FormEncode(queryParams);
        if (q.Length == 0) { return basePath; }
        if (basePath.Contains("?")) { return basePath + "&" + q; }
        return basePath + "?" + q;
    }
}
