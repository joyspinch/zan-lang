using System;
using System.IO;

namespace Sdk.Taobao;

public class TaobaoFileItem {
    public string FileName;
    public byte[] Content;
    public string MimeType;

    public TaobaoFileItem(string fileName, byte[] content, string mimeType = "application/octet-stream") {
        if (fileName == null || fileName.Length == 0) {
            throw new TaobaoException("client.invalidArguments", "上传文件名不能为空", 0, "");
        }
        if (content == null) {
            throw new TaobaoException("client.invalidArguments", "上传文件内容不能为空", 0, "");
        }
        this.FileName = fileName;
        this.Content = content;
        this.MimeType = (mimeType == null || mimeType.Length == 0)
            ? "application/octet-stream"
            : mimeType;
    }

    public static TaobaoFileItem FromBytes(string fileName, byte[] content, string mimeType = "application/octet-stream") {
        return new TaobaoFileItem(fileName, content, mimeType);
    }

    public static const long MaxFileBytes = 64L * 1024L * 1024L;

    public static TaobaoFileItem FromFile(string filePath, string mimeType = "application/octet-stream") {
        if (filePath == null || filePath.Length == 0) {
            throw new TaobaoException("client.invalidArguments", "本地文件路径不能为空", 0, "");
        }
        long size = File.GetSize64(filePath);
        if (size < 0L) {
            throw new TaobaoException("client.invalidArguments", "无法读取本地文件大小或文件不存在", 0, "");
        }
        if (size > TaobaoFileItem.MaxFileBytes) {
            throw new TaobaoException("client.invalidArguments", "上传文件大小超出 64 MiB 上限", 0, "");
        }
        byte[] bytes = File.ReadAllBytes(filePath);
        string name = TaobaoFileItem.ExtractFileName(filePath);
        return new TaobaoFileItem(name, bytes, mimeType);
    }

    public bool IsValid() {
        return this.FileName != null && this.FileName.Length > 0 && this.Content != null;
    }

    private static string ExtractFileName(string path) {
        int s1 = path.LastIndexOf("/");
        int s2 = path.LastIndexOf("\\");
        int cut = s1 > s2 ? s1 : s2;
        if (cut >= 0 && cut + 1 < path.Length) {
            return path.Substring(cut + 1);
        }
        return path;
    }
}
