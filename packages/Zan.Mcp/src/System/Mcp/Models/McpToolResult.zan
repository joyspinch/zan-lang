using System;
using System.Json;

namespace System.Mcp;

// 一次远端工具调用的结果。
//
// ## 结果是**内容数组**，不是一段文本
//
// MCP 的 `tools/call` 回的是 `content: [{type, text}, ...]`——一项内容
// 一个类型。多数服务端只回一项 `text`，但协议允许图片、音频等其它
// 类型。所以本类两样都给：`text` 是**文本项拼起来**的文本（模型直接
// 能吃），`contents` 是**原始内容数组**（要保真时自己看）。
//
// ## 错误是结果的一部分
//
// `isError` 为 true 表示这次调用**失败了**（参数不对、工具内部出错）。
// 它是**结果**，不是异常——远端工具失败不该打断调用方的流程。
public class McpToolResult {
    // 文本内容（`content` 里 type=="text" 的项按顺序拼起来）。
    public string text;

    // true 表示这是**错误结果**（内容是要给模型看的失败说明）。
    public bool isError;

    // 原始内容数组（保真：非文本项只能从这里看）。
    public JsonValue contents;

    public McpToolResult() {
        this.text = "";
        this.isError = false;
        this.contents = null;
    }

    public McpToolResult(string text, bool isError, JsonValue contents) {
        this.text = text == null ? "" : text;
        this.isError = isError;
        this.contents = contents;
    }

    // 从 `tools/call` 的 result 解析。
    //
    // 没有 `content` 字段**不算解析失败**——那是一个空结果，不是坏
    // 响应。`isError` 缺省为 false。
    public static McpToolResult FromResult(JsonValue result) {
        if (result == null || !result.IsObject()) { return null; }
        McpToolResult r = new McpToolResult();
        r.isError = result.Bool("isError", false);
        JsonValue content = result.Get("content");
        if (content == null || !content.IsArray()) { return r; }
        r.contents = content;
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < content.Count(); i = i + 1) {
            JsonValue item = content.At(i);
            if (item == null || !item.IsObject()) { continue; }
            if (item.Str("type", "text") != "text") { continue; }
            string t = item.Str("text", "");
            if (sb.Length > 0) { sb.Append("\n"); }
            sb.Append(t);
        }
        r.text = sb.ToString();
        return r;
    }
}
