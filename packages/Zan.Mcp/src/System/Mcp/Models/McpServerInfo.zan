using System;
using System.Json;

namespace System.Mcp;

// 握手拿到的服务端信息。
//
// ## 协议版本以**服务端回的**为准
//
// 客户端在 `initialize` 里报自己想要的版本，服务端回一个它愿意说的
// 版本。两者不一定相同（老服务端只说老版本）——所以这里存的是**服务
// 端回的那个**，不是客户端请求的那个。
//
// ## capabilities 是"服务端有什么"不是"客户端有什么"
//
// `tools` / `resources` / `prompts` 三项的有无决定了后面能调什么。
// 缺 `tools` 就别去调 `tools/list`（协议上不合法）。
public class McpServerInfo {
    // 服务端名。
    public string name;

    // 服务端版本。
    public string version;

    // 协商后的协议版本。
    public string protocolVersion;

    // 服务端给的使用说明（很多服务端把"先调哪个工具"写在这里）。
    public string instructions;

    // 服务端是否声明了 tools 能力。
    public bool hasTools;

    // 服务端是否声明了 resources 能力。
    public bool hasResources;

    // 服务端是否声明了 prompts 能力。
    public bool hasPrompts;

    public McpServerInfo() {
        this.name = "";
        this.version = "";
        this.protocolVersion = "";
        this.instructions = "";
        this.hasTools = false;
        this.hasResources = false;
        this.hasPrompts = false;
    }

    // 从 `initialize` 的 result 解析。
    public static McpServerInfo FromResult(JsonValue result) {
        if (result == null || !result.IsObject()) { return null; }
        McpServerInfo info = new McpServerInfo();
        info.protocolVersion = result.Str("protocolVersion", "");
        info.instructions = result.Str("instructions", "");
        JsonValue si = result.Get("serverInfo");
        if (si != null && si.IsObject()) {
            info.name = si.Str("name", "");
            info.version = si.Str("version", "");
        }
        JsonValue caps = result.Get("capabilities");
        if (caps != null && caps.IsObject()) {
            info.hasTools = caps.Has("tools");
            info.hasResources = caps.Has("resources");
            info.hasPrompts = caps.Has("prompts");
        }
        return info;
    }
}
