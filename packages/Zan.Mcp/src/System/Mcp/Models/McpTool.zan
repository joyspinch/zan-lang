using System;
using System.Json;

namespace System.Mcp;

// 远端 MCP 工具的声明。
//
// ## 形状与本地 `AiTool` 不同，语义一样
//
// MCP 的参数说明叫 `inputSchema`，OpenAI 兼容的 `AiTool` 叫
// `parameters`，但两边是同一个东西：一份给模型看的 JSON Schema。
// 所以 `Zan.Ai` 那边有一个桥（`McpToolBinding`）把本类转成 `AiTool`
// ——远端工具因此能直接进本地 `ToolRegistry`，调用方不用手工翻译
// 一遍 schema。
//
// ## 工具名是**唯一**的调用依据
//
// 模型回的是"工具名 + 参数"。名字缺失的项没法调用，所以解析时直接
// 丢掉（返回 null），不塞一个空名字进去等模型踩。
public class McpTool {
    // 工具名（模型用它来调用）。
    public string name;

    // 描述（给模型看的：什么时候该用它）。
    public string description;

    // 参数的 JSON Schema（远端给的 `inputSchema` 对象）。
    public JsonValue inputSchema;

    public McpTool() {
        this.name = "";
        this.description = "";
        this.inputSchema = null;
    }

    public McpTool(string name, string description, JsonValue inputSchema) {
        this.name = name == null ? "" : name;
        this.description = description == null ? "" : description;
        this.inputSchema = inputSchema;
    }

    // 从 `tools/list` 的一项解析。缺名字返回 null。
    public static McpTool FromJson(JsonValue v) {
        if (v == null || !v.IsObject()) { return null; }
        string name = v.Str("name", "");
        if (name.Length == 0) { return null; }
        McpTool t = new McpTool();
        t.name = name;
        t.description = v.Str("description", "");
        JsonValue schema = v.Get("inputSchema");
        if (schema == null || !schema.IsObject()) { schema = null; }
        t.inputSchema = schema;
        return t;
    }

    // 参数 schema 的紧凑文本（调试与日志用）。
    public string SchemaText() {
        if (this.inputSchema == null) { return ""; }
        return this.inputSchema.ToJson();
    }
}
