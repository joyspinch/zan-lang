using System;
using System.Json;

namespace System.Mcp;

// 一个远端资源的描述（`resources/list` 的一项）。
//
// 资源是 MCP 里**只读**的那一半：工具是"做事"，资源是"给看"。服务端
// 报的是**描述**（uri/名字/说明/媒体类型），内容要用
// `resources/read` 另取一次。
public class McpResource {
    // 资源 URI（`resources/read` 用它来取）。
    public string uri;

    // 资源名（给人看的）。
    public string name;

    // 资源说明。
    public string description;

    // 媒体类型（text/plain、application/json…）。
    public string mimeType;

    public McpResource() {
        this.uri = "";
        this.name = "";
        this.description = "";
        this.mimeType = "";
    }

    public McpResource(string uri, string name, string description, string mimeType) {
        this.uri = uri == null ? "" : uri;
        this.name = name == null ? "" : name;
        this.description = description == null ? "" : description;
        this.mimeType = mimeType == null ? "" : mimeType;
    }

    // 从 `resources/list` 的一项解析。缺 uri 返回 null（没有 uri 就
    // 取不到内容）。
    public static McpResource FromJson(JsonValue v) {
        if (v == null || !v.IsObject()) { return null; }
        string uri = v.Str("uri", "");
        if (uri.Length == 0) { return null; }
        McpResource r = new McpResource();
        r.uri = uri;
        r.name = v.Str("name", "");
        r.description = v.Str("description", "");
        r.mimeType = v.Str("mimeType", "");
        return r;
    }
}
