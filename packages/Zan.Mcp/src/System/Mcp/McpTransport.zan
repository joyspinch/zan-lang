using System;

namespace System.Mcp;

// 一次 MCP 传输的结果：HTTP 状态码 + 原始正文。
//
// 为什么不直接用 `System.Net.Http.Client.HttpResponse`：MCP 的
// **"没有响应"是合法状态**——通知（notification）没有 id，服务端回
// 202 + 空正文。调用方必须能区分"没有正文"与"正文是空串"，所以这里
// 用一个更小的形状：正文永远是 string，没有就是空串。
public class McpTransportResult {
    // HTTP 状态码（2xx = 成功；其余由调用方判）。
    public int status;

    // 原始正文。
    public string body;

    public McpTransportResult() {
        this.status = 0;
        this.body = "";
    }

    public McpTransportResult(int status, string body) {
        this.status = status;
        this.body = body == null ? "" : body;
    }
}

// MCP 的传输：把一段 JSON-RPC 请求文本送到服务端，返回原始响应。
//
// **抽出来是为了可测**：协议逻辑（握手、工具枚举、错误语义、id 对齐）
// 不该只能拿真服务器验证。测试注入一个假传输就能把请求形状与响应
// 处理钉死——真服务器一次往返就把协议细节全糊过去了。
//
// 返回 null = 传输失败（连不上、超时、抛异常）。具体原因由传输自己
// 决定，客户端会把它并进 `lastError`。
public async delegate McpTransportResult McpTransportFn(string requestJson);
