using System;

namespace Game.Audio;

// 滤波器类型。
public enum FilterKind {
    // 低通：压高频，留低频。
    LowPass = 0,
    // 高通：压低频，留高频。
    HighPass = 1,
    // 带通：只留中频段。
    BandPass = 2,
    // 陷波：挖掉某个频率（去工频嗡声）。
    Notch = 3,
    // 峰化：加强某个频率。
    Peaking = 4,
}

// 一阶低通/高通（RC 型）。
//
// **一阶**（6 dB/oct）而不是二阶（12 dB/oct）：一阶斜率平缓、
// 不会产生明显的相位失真与振铃，做"去噪前的柔化"够用；
// 二阶要处理系数稳定性与过采样，收益不值这个复杂度。
public class OnePoleFilter {
    // 滤波器类型。
    public FilterKind kind;
    // 截止频率（Hz）。
    public double cutoffHz;
    // 采样率。
    public int sampleRate;
    // 归一化系数。
    private double a;
    // 状态。
    private double z1;

    public OnePoleFilter(FilterKind kind, double cutoffHz, int sampleRate) {
        this.kind = kind;
        this.sampleRate = sampleRate > 0 ? sampleRate : 44100;
        this.z1 = 0.0;
        this.SetCutoff(cutoffHz);
    }

    // 设定截止频率。
    public void SetCutoff(double cutoffHz) {
        this.cutoffHz = cutoffHz;
        double nyquist = (double)this.sampleRate * 0.5;
        double fc = cutoffHz;
        if (fc < 1.0) { fc = 1.0; }
        if (fc > nyquist * 0.99) { fc = nyquist * 0.99; }
        // RC 常数：tau = 1/(2*pi*fc)，a = dt/(tau+dt)，dt = 1/fs。
        double dt = 1.0 / (double)this.sampleRate;
        double tau = 1.0 / (2.0 * Math.PI * fc);
        this.a = dt / (tau + dt);
    }

    // 重置状态。
    public void Reset() {
        this.z1 = 0.0;
    }

    // 处理一个样本。
    public double Process(double input) {
        if (this.kind == FilterKind.LowPass) {
            this.z1 = this.z1 + this.a * (input - this.z1);
            return this.z1;
        }
        // 高通 = 输入 - 低通部分
        this.z1 = this.z1 + this.a * (input - this.z1);
        return input - this.z1;
    }
}
