name = "Zan.OCR"
version = "1.0.0"
description = "OCR pipeline for Zan on the PP-OCR ONNX models: pure-Zan PNG decoder (System.Ocr.Png), DB text-detection postprocess (binarize/connected components/exact rectangular unclip), CRNN rec preprocessing and greedy CTC decoding with loadable dictionaries (System.Ocr) — inference rides Zan.ML's runtime-loaded ONNX Runtime"
author = "Zan Team"
license = "MIT"
