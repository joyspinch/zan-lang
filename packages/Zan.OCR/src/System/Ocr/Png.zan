using System;
using System.IO;
using System.IO.Compression;

namespace System.Ocr;

/// <summary>
/// 纯 Zan 的 PNG 解码器——OCR 图像入口（截图/扫描件都是 PNG）。
///
/// 复用 Zan.IO 的 <see cref="Deflate"/> 做 IDAT 解压，本体只做容器与
/// 反滤波。支持范围（OCR 场景的常用交集）：
///   - 位深 8，非隔行（interlace 0）；
///   - 颜色类型 0(灰)/2(RGB)/3(调色板)/4(灰+A)/6(RGBA)；
///   - 五种行滤波 None/Sub/Up/Average/Paeth 全部实现。
/// 解码结果统一展开为 RGBA8，供检测/识别两侧分别归一化。
/// 不校验 CRC（OCR 图像来自本地截图/解码器输出，信任来源）。
/// </summary>
class Png {
    /// 像素宽。
    int width;
    /// 像素高。
    int height;
    /// RGBA8 行主序，长度 width*height*4。
    byte[] rgba;

    static Png Wrap(int w, int h, byte[] pixels) {
        Png p = new Png();
        p.width = w;
        p.height = h;
        p.rgba = pixels;
        return p;
    }

    /// 像素宽。
    int Width() { return this.width; }

    /// 像素高。
    int Height() { return this.height; }

    /// RGBA8 像素（行主序）。
    byte[] Rgba() { return this.rgba; }

    /// <summary>从 PNG 字节解码；格式超出支持范围或损坏时抛
    /// InvalidOperationException。</summary>
    static Png Decode(byte[] bytes) {
        byte[] sig = new byte[8];
        sig[0] = 137; sig[1] = 80; sig[2] = 78; sig[3] = 71;
        sig[4] = 13; sig[5] = 10; sig[6] = 26; sig[7] = 10;
        if (bytes == null || bytes.Length < 8 + 12) {
            throw new InvalidOperationException("PNG 太短: 不足一个 IHDR");
        }
        for (int i = 0; i < 8; i = i + 1) {
            if (bytes[i] != sig[i]) {
                throw new InvalidOperationException("PNG 签名不符");
            }
        }
        int w = 0;
        int h = 0;
        int colorType = -1;
        byte[] idat = null;
        int idatLen = 0;
        byte[] palette = null;
        int pos = 8;
        while (pos + 12 <= bytes.Length) {
            int len = Png.Be32(bytes, pos);
            int dataPos = pos + 8;
            if (dataPos + len + 4 > bytes.Length) {
                throw new InvalidOperationException("PNG 块越界");
            }
            if (Png.TypeIs(bytes, pos + 4, 73, 72, 68, 82)) { // IHDR
                w = Png.Be32(bytes, dataPos);
                h = Png.Be32(bytes, dataPos + 4);
                int depth = bytes[dataPos + 8];
                colorType = bytes[dataPos + 9];
                int compression = bytes[dataPos + 10];
                int filter = bytes[dataPos + 11];
                int interlace = bytes[dataPos + 12];
                if (w <= 0 || h <= 0 || w > 65535 || h > 65535) {
                    throw new InvalidOperationException("PNG 尺寸非法: "
                        + Convert.ToString(w) + "x" + Convert.ToString(h));
                }
                if (depth != 8) {
                    throw new InvalidOperationException("PNG 位深仅支持 8: "
                        + Convert.ToString(depth));
                }
                if (compression != 0 || filter != 0 || interlace != 0) {
                    throw new InvalidOperationException("PNG 仅支持非隔行标准压缩");
                }
                if (colorType != 0 && colorType != 2 && colorType != 3
                    && colorType != 4 && colorType != 6) {
                    throw new InvalidOperationException("PNG 颜色类型不支持: "
                        + Convert.ToString(colorType));
                }
            } else if (Png.TypeIs(bytes, pos + 4, 80, 76, 84, 69)) { // PLTE
                palette = new byte[len];
                for (int i = 0; i < len; i = i + 1) { palette[i] = bytes[dataPos + i]; }
            } else if (Png.TypeIs(bytes, pos + 4, 73, 68, 65, 84)) { // IDAT
                if (idat == null) {
                    idat = new byte[len];
                    idatLen = len;
                    for (int i = 0; i < len; i = i + 1) {
                        idat[i] = bytes[dataPos + i];
                    }
                } else {
                    byte[] grown = new byte[idatLen + len];
                    for (int i = 0; i < idatLen; i = i + 1) { grown[i] = idat[i]; }
                    for (int i = 0; i < len; i = i + 1) {
                        grown[idatLen + i] = bytes[dataPos + i];
                    }
                    idat = grown;
                    idatLen = idatLen + len;
                }
            } else if (Png.TypeIs(bytes, pos + 4, 73, 69, 78, 68)) { // IEND
                break;
            }
            pos = dataPos + len + 4;
        }
        if (colorType < 0 || idat == null) {
            throw new InvalidOperationException("PNG 缺 IHDR 或 IDAT");
        }

        // zlib 流 = 2 字节头 + raw deflate + 4 字节 adler32。
        if (idatLen < 6 || (idat[0] & 15) != 8) {
            throw new InvalidOperationException("PNG IDAT 不是 zlib/deflate 流");
        }
        int channels = Png.ChannelsOf(colorType);
        long need = (long)(w * channels + 1) * h + 16;
        byte[] raw = Deflate.Inflate(idat, 2, idatLen - 2, (int)need);
        if (raw == null) {
            throw new InvalidOperationException("PNG 解压失败");
        }
        Png.CheckAdler(idat, idatLen, raw);
        byte[] rgba = Png.Unfilter(raw, w, h, channels, colorType, palette);
        return Png.Wrap(w, h, rgba);
    }

    static int ChannelsOf(int colorType) {
        if (colorType == 2) { return 3; }
        if (colorType == 4) { return 2; }
        if (colorType == 6) { return 4; }
        return 1;
    }

    /// 大端 32 位读。
    static int Be32(byte[] b, int off) {
        return (b[off] & 255) << 24 | (b[off + 1] & 255) << 16
             | (b[off + 2] & 255) << 8 | (b[off + 3] & 255);
    }

    /// 块类型四字节比较（ASCII）。
    static bool TypeIs(byte[] b, int off, int c0, int c1, int c2, int c3) {
        return (b[off] & 255) == c0 && (b[off + 1] & 255) == c1
            && (b[off + 2] & 255) == c2 && (b[off + 3] & 255) == c3;
    }

    /// 校验 zlib 尾部 adler32（raw 为解压输出）。
    static void CheckAdler(byte[] zbuf, int zlen, byte[] raw) {
        long a = 1;
        long b = 0;
        for (int i = 0; i < raw.Length; i = i + 1) {
            a = (a + (raw[i] & 255)) % 65521;
            b = (b + a) % 65521;
        }
        long want = ((long)(zbuf[zlen - 4] & 255) << 24)
                  | ((long)(zbuf[zlen - 3] & 255) << 16)
                  | ((long)(zbuf[zlen - 2] & 255) << 8)
                  | (long)(zbuf[zlen - 1] & 255);
        if (((b << 16) | a) != want) {
            throw new InvalidOperationException("PNG adler32 校验失败");
        }
    }

    /// 反滤波并展开为 RGBA8。raw 为滤波后扫描线
    /// （每行 1 filter 字节 + w*channels 字节）。
    static byte[] Unfilter(byte[] raw, int w, int h, int channels,
                           int colorType, byte[] palette) {
        int stride = w * channels;
        byte[] cur = new byte[stride];
        byte[] prev = new byte[stride];
        byte[] outPx = new byte[w * h * 4];
        int rawPos = 0;
        for (int y = 0; y < h; y = y + 1) {
            if (rawPos + 1 + stride > raw.Length) {
                throw new InvalidOperationException("PNG 扫描线不完整");
            }
            int ft = raw[rawPos] & 255;
            rawPos = rawPos + 1;
            for (int x = 0; x < stride; x = x + 1) {
                int rv = raw[rawPos + x] & 255;
                int left = x >= channels ? cur[x - channels] & 255 : 0;
                int up = prev[x] & 255;
                int ul = x >= channels ? prev[x - channels] & 255 : 0;
                int v;
                if (ft == 0) {
                    v = rv;
                } else if (ft == 1) {
                    v = rv + left;
                } else if (ft == 2) {
                    v = rv + up;
                } else if (ft == 3) {
                    v = rv + (left + up) / 2;
                } else if (ft == 4) {
                    int pa = up - ul;
                    int pb = left - ul;
                    int pc = left + up - ul - ul;
                    int pred;
                    if (pa < 0) { pa = -pa; }
                    if (pb < 0) { pb = -pb; }
                    if (pc < 0) { pc = -pc; }
                    if (pa <= pb && pa <= pc) {
                        pred = left;
                    } else if (pb <= pc) {
                        pred = up;
                    } else {
                        pred = ul;
                    }
                    v = rv + pred;
                } else {
                    throw new InvalidOperationException("PNG 滤波类型非法: "
                        + Convert.ToString(ft));
                }
                cur[x] = (byte)(v & 255);
            }
            rawPos = rawPos + stride;
            Png.Expand(cur, outPx, y * w * 4, w, channels, colorType, palette);
            for (int x = 0; x < stride; x = x + 1) { prev[x] = cur[x]; }
        }
        return outPx;
    }

    /// 把一行的通道数据展开进 RGBA8 输出。
    static void Expand(byte[] line, byte[] outPx, int outOff, int w,
                       int channels, int colorType, byte[] palette) {
        for (int x = 0; x < w; x = x + 1) {
            int o = outOff + x * 4;
            int p = x * channels;
            if (colorType == 0) {
                byte g = line[p];
                outPx[o] = g; outPx[o + 1] = g; outPx[o + 2] = g;
                outPx[o + 3] = 255;
            } else if (colorType == 2) {
                outPx[o] = line[p];
                outPx[o + 1] = line[p + 1];
                outPx[o + 2] = line[p + 2];
                outPx[o + 3] = 255;
            } else if (colorType == 3) {
                int idx = line[p] & 255;
                if (palette == null || (idx + 1) * 3 > palette.Length) {
                    throw new InvalidOperationException("PNG 调色板索引越界");
                }
                outPx[o] = palette[idx * 3];
                outPx[o + 1] = palette[idx * 3 + 1];
                outPx[o + 2] = palette[idx * 3 + 2];
                outPx[o + 3] = 255;
            } else if (colorType == 4) {
                byte g = line[p];
                outPx[o] = g; outPx[o + 1] = g; outPx[o + 2] = g;
                outPx[o + 3] = line[p + 1];
            } else {
                outPx[o] = line[p];
                outPx[o + 1] = line[p + 1];
                outPx[o + 2] = line[p + 2];
                outPx[o + 3] = line[p + 3];
            }
        }
    }

    /// <summary>从文件读取并解码。</summary>
    static Png DecodeFile(string path) {
        return Png.Decode(File.ReadAllBytes(path));
    }
}
