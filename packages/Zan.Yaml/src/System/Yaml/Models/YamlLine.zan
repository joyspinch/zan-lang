using System;
using System.Text;
using System.Json;
namespace System.Yaml;

// YAML 词法行实体（消除 indents / texts / lineNos 三组平行列表反模式）。
public class YamlLine {
    public int indent;
    public string text;
    public int lineNo;

    public YamlLine(int indent, string text, int lineNo) {
        this.indent = indent;
        this.text = text != null ? text : "";
        this.lineNo = lineNo;
    }
}
