using System;
using System.Test;
using System.Yaml;

// Zan.Yaml 包的无头测试：解析类型还原、列表/嵌套映射、ToYaml 往返。
class YamlRoundTripTests {
    static JsonValue Need(JsonValue v, string key) {
        JsonValue x = v.Get(key);
        if (x == null) { throw new Exception("missing key: " + key); }
        return x;
    }

    static JsonValue NeedAt(JsonValue v, int i) {
        JsonValue x = v.At(i);
        if (x == null) { throw new Exception("missing index: " + Convert.ToString(i)); }
        return x;
    }

    static void Main() {
        const string src = "name: demo\n"
            + "count: 42\n"
            + "ratio: 1.5\n"
            + "ok: true\n"
            + "items:\n"
            + "  - a\n"
            + "  - b\n"
            + "nested:\n"
            + "  key: value\n";

        Test.Group("parse");
        Test.Run("scalars", () => {
            JsonValue v = Yaml.Parse(src);
            Assert.True(v.IsObject(), "root-object");
            Assert.Equal("demo", Need(v, "name").strVal, "name");
            Assert.True(Need(v, "count").IsInt(), "count-is-int");
            Assert.Equal(42L, Need(v, "count").numI, "count");
            Assert.Nearly(1.5, Need(v, "ratio").numD, 0.000001, "ratio");
            Assert.Equal(true, Need(v, "ok").boolVal, "ok");
        });

        Test.Run("sequence-and-nested-map", () => {
            JsonValue v = Yaml.Parse(src);
            JsonValue items = Need(v, "items");
            Assert.True(items.IsArray(), "items-array");
            Assert.Equal(2, items.Count(), "items-len");
            Assert.Equal("a", NeedAt(items, 0).strVal, "item0");
            Assert.Equal("b", NeedAt(items, 1).strVal, "item1");
            JsonValue nested = Need(v, "nested");
            Assert.True(nested.IsObject(), "nested-object");
            Assert.Equal("value", Need(nested, "key").strVal, "nested-key");
        });

        Test.Group("toyaml");
        Test.Run("string-roundtrip", () => {
            JsonValue v = Yaml.Parse(src);
            string text = Yaml.ToYaml(v);
            JsonValue back = Yaml.Parse(text);
            Assert.Equal("demo", Need(back, "name").strVal, "name-back");
            Assert.Equal(42L, Need(back, "count").numI, "count-back");
            Assert.Nearly(1.5, Need(back, "ratio").numD, 0.000001, "ratio-back");
            Assert.Equal(true, Need(back, "ok").boolVal, "ok-back");
        });

        Test.Run("containers-preserved", () => {
            JsonValue v = Yaml.Parse(src);
            JsonValue back = Yaml.Parse(Yaml.ToYaml(v));
            Assert.Equal(2, Need(back, "items").Count(), "items-back-len");
            Assert.Equal("b", NeedAt(Need(back, "items"), 1).strVal, "items-back1");
            Assert.Equal("value", Need(Need(back, "nested"), "key").strVal, "nested-back");
        });

        Test.Finish();
    }
}
