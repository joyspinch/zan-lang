using System;
using System.Collections.Generic;

namespace Game.Common;

// 小地图上的一个标记点。
//
// kind 是**语义类别**（0 普通 / 1 敌人 / 2 友军 / 3 目标），不是颜色：
// 颜色由渲染层按类别查表，模型不碰颜色——换皮肤时不用改逻辑。
public class MinimapEntity {
    // 世界坐标。
    public double x;
    public double y;
    // 类别（0 普通 / 1 敌人 / 2 友军 / 3 目标）。
    public int kind;
    // 是否显示在小地图上。
    public bool visible;

    public MinimapEntity() {
        this.x = 0.0;
        this.y = 0.0;
        this.kind = 0;
        this.visible = true;
    }
}

// 小地图投影：世界坐标 → 小地图像素。
//
// **它替代什么**：模板里每个带小地图的游戏都自己写一遍
// "世界坐标怎么映射到小地图矩形""哪些点在视野外要剔掉"。抄一遍就有
// 两种口径：有的用世界左上角做原点，有的用玩家位置做原点——玩家一动，
// 小地图上别人的标记就整体飘走。
//
// **本类的口径是"视口左上角为原点"**：
//
// - 视口（view）以中心 + 尺寸描述（跟随玩家时只改中心）；
// - 映射：mapX = (worldX - 视口左) × 小地图宽 / 视口宽；
// - 视口尺寸 <= 0 表示**看整个世界**（小地图是全图而非跟随窗口）。
//
// **坐标方向**：世界坐标 y 向下，小地图像素 y 也向下——不翻转。翻转
// 是渲染层的事（有的游戏小地图北在上、有的在下）。
//
// **并发**：非线程安全。
public class Minimap {
    // 世界尺寸。
    public double worldWidth;
    public double worldHeight;
    // 视口中心（世界坐标）。
    public double viewCenterX;
    public double viewCenterY;
    // 视口尺寸（世界坐标）。<= 0 表示看整个世界。
    public double viewWidth;
    public double viewHeight;
    // 小地图绘制尺寸（像素）。
    public double mapWidth;
    public double mapHeight;

    public Minimap(double worldWidth, double worldHeight, double mapWidth, double mapHeight) {
        this.worldWidth = worldWidth > 0.0 ? worldWidth : 1.0;
        this.worldHeight = worldHeight > 0.0 ? worldHeight : 1.0;
        this.viewCenterX = this.worldWidth / 2.0;
        this.viewCenterY = this.worldHeight / 2.0;
        this.viewWidth = 0.0;
        this.viewHeight = 0.0;
        this.mapWidth = mapWidth > 0.0 ? mapWidth : 1.0;
        this.mapHeight = mapHeight > 0.0 ? mapHeight : 1.0;
    }

    // 设置跟随视口（链式）。
    public Minimap WithView(double centerX, double centerY, double width, double height) {
        this.viewCenterX = centerX;
        this.viewCenterY = centerY;
        this.viewWidth = width > 0.0 ? width : 0.0;
        this.viewHeight = height > 0.0 ? height : 0.0;
        return this;
    }

    // 视口左边界（世界坐标）。看全图时是 0。
    public double ViewLeft() {
        if (this.viewWidth <= 0.0) { return 0.0; }
        return this.viewCenterX - this.viewWidth / 2.0;
    }

    // 视口上边界（世界坐标）。看全图时是 0。
    public double ViewTop() {
        if (this.viewHeight <= 0.0) { return 0.0; }
        return this.viewCenterY - this.viewHeight / 2.0;
    }

    // 实际生效的视口宽（看全图时是世界宽）。
    public double EffectiveViewWidth() {
        return this.viewWidth > 0.0 ? this.viewWidth : this.worldWidth;
    }

    // 实际生效的视口高（看全图时是世界高）。
    public double EffectiveViewHeight() {
        return this.viewHeight > 0.0 ? this.viewHeight : this.worldHeight;
    }

    // 世界坐标 x → 小地图像素 x。
    public double MapX(double worldX) {
        return (worldX - this.ViewLeft()) * this.mapWidth / this.EffectiveViewWidth();
    }

    // 世界坐标 y → 小地图像素 y。
    public double MapY(double worldY) {
        return (worldY - this.ViewTop()) * this.mapHeight / this.EffectiveViewHeight();
    }

    // 点是否在视口内（视口外的标记不该画）。
    public bool Contains(double worldX, double worldY) {
        double left = this.ViewLeft();
        double top = this.ViewTop();
        if (worldX < left || worldY < top) { return false; }
        if (worldX > left + this.EffectiveViewWidth()) { return false; }
        if (worldY > top + this.EffectiveViewHeight()) { return false; }
        return true;
    }

    // 每个世界单位对应多少小地图像素（缩放比）。
    public double Scale() {
        return this.mapWidth / this.EffectiveViewWidth();
    }
}

// 小地图标记层：管理一批标记点。
//
// **容量硬上限 + 满了不新增**：标记点是"每帧全量重算"的集合，超量时
// 新增请求被丢弃并计数——静默截断会让"标记偶尔不出现"这类 bug 查不出来。
public class MinimapLayer {
    // 投影参数。
    private Minimap map;
    // 标记点池。
    private List<MinimapEntity> entities;
    // 容量上限。
    private int capacity;
    // 因池满被丢弃的次数。
    private int dropped;

    public MinimapLayer(Minimap map) {
        this.map = map;
        this.capacity = 256;
        this.entities = new List<MinimapEntity>();
        this.dropped = 0;
    }

    public MinimapLayer(Minimap map, int capacity) {
        this.map = map;
        this.capacity = capacity > 0 ? capacity : 1;
        this.entities = new List<MinimapEntity>();
        this.dropped = 0;
    }

    // 容量上限。
    public int Capacity() { return this.capacity; }

    // 标记点总数（含不可见的）。
    public int Count() { return this.entities.Count; }

    // 因池满被丢弃的次数。
    public int DroppedCount() { return this.dropped; }

    // 第 i 个标记点（越界返回 null）。
    public MinimapEntity At(int i) {
        if (i < 0 || i >= this.entities.Count) { return null; }
        return this.entities[i];
    }

    // 投影参数。
    public Minimap Map() { return this.map; }

    // 清空所有标记（不销毁池）。
    public void Clear() {
        for (int i = 0; i < this.entities.Count; i = i + 1) {
            MinimapEntity e = this.entities[i];
            if (e != null) { e.visible = false; }
        }
    }

    // 复用池位：把上一帧用过但本帧没刷新的标记标记为不可见。
    //
    // 典型用法：每帧先 `BeginFrame()`，再给当前可见的实体调 `Add`，
    // 没被重新 Add 的旧标记自动变成不可见——不需要每帧重建整个集合。
    public void BeginFrame() {
        for (int i = 0; i < this.entities.Count; i = i + 1) {
            MinimapEntity e = this.entities[i];
            if (e != null) { e.visible = false; }
        }
    }

    // 添加/更新一个标记。池满返回 null。
    //
    // 复用规则：优先复用**不可见**的池位（上一帧的旧标记），
    // 其次复用可见的最后一个（最新的通常没被看），最后才新建。
    public MinimapEntity Add(double worldX, double worldY, int kind) {
        MinimapEntity slot = null;
        for (int i = 0; i < this.entities.Count; i = i + 1) {
            MinimapEntity e = this.entities[i];
            if (e != null && !e.visible) { slot = e; break; }
        }
        if (slot == null) {
            if (this.entities.Count >= this.capacity) {
                this.dropped = this.dropped + 1;
                return null;
            }
            slot = new MinimapEntity();
            this.entities.Add(slot);
        }
        slot.x = worldX;
        slot.y = worldY;
        slot.kind = kind;
        slot.visible = true;
        return slot;
    }

    // 视口内的可见标记数（剔除视野外的点）。
    public int VisibleCount() {
        int n = 0;
        for (int i = 0; i < this.entities.Count; i = i + 1) {
            MinimapEntity e = this.entities[i];
            if (e == null || !e.visible) { continue; }
            if (this.map.Contains(e.x, e.y)) { n = n + 1; }
        }
        return n;
    }
}
