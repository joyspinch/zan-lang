using System;

namespace System.Messaging;

// 消息持有盒：把消息装进引用类型里，给闭包捕获用。
//
// **为什么要它**：Zan 的闭包不能捕获 `object` 形参（"its runtime ownership is
// not representable yet"），所以中间件链里传递的消息得先装进盒子——盒子是
// 普通类，捕获它没问题，而且捕获的是**同一个盒子**（引用类型 = 共享），
// 消息本身不会被复制。
public class MessageHolder {
    // 装着的消息。
    public object Value;

    public MessageHolder(object value) {
        this.Value = value;
    }
}
