using System;
using System.Collections.Generic;

namespace System.Messaging;

// 消息总线：进程内的发布 / 订阅、命令分发与中间件管道。
//
// **零配置可用**：`new MessageBus()` → 建通道 → `Register` → `Publish`。
//
// **三种投递语义**：
//   - `Publish`（广播）：所有匹配通道的所有订阅者都收到；
//   - `Send`（命令）：**恰好一个**订阅者，零个或多个都报错——命令的语义就是
//     "有人负责办"，接线错了要当场暴露；
//   - `QueryEndpoint`（请求-响应）：处理者由使用者持有，结果类型完整保留。
//
// **通道由使用者建，不由总线按类型自动建**：Zan 没有运行期类型名，总线判断
// "这个类型是不是已经建过通道"只能靠运行期类型试探，会把同类型消息投两遍。
// 一个类型一个通道、通道由使用者持有，问题就不存在了。
//
// **类型分发怎么做**：总线不按类型名找通道，而是让通道自己判断收不收这条
// 消息（`Accepts`）。判定逻辑由**通道的构造器**定型成委托（那时类型参数
// 是具体的），总线只调用委托——详见 `MessageChannelBase` 的注释。
//
// **中间件链**：`Use(...)` 登记的中间件按登记顺序包裹**一次投递**（一次
// `Publish` / `Send` / 查询跑一遍链，不是每个订阅者跑一遍）。中间件必须调用
// `next`，否则这条消息被吞掉。
//
// **错误处理**：
//   - 订阅者抛异常、**没**登记 `OnError`：异常原样抛出（不吞）。
//   - 订阅者抛异常、**已**登记 `OnError`：异常被包装成
//     `MessageException(HandlerFailed)`（原异常在 `InnerException`）交给错误
//     处理器，该通道剩余订阅者不再执行，其它通道继续投递。
//   - 中间件自己抛的异常：原样抛出（中间件是基础设施，它坏了就该炸）。
//
// **消息必须是引用类型**（类）：总线内部按运行期类型分发，值类型没有运行期
// 类型可言（`object` 也装不下值类型，见 TASKS.md 记的编译器缺陷）。
//
// **并发**：非线程安全（通道表与中间件表是逐线程读写的状态）。
public class MessageBus {
    // 登记的通道。
    private List<MessageChannelBase> channels;
    // 中间件链。
    private List<MessageMiddleware> middleware;
    // 错误处理器（没有则订阅者异常直接抛出）。
    private ActionT2<Exception, object> errorHandler;
    // 累计投递的订阅者次数。
    private int delivered;

    public MessageBus() {
        this.channels = new List<MessageChannelBase>();
        this.middleware = new List<MessageMiddleware>();
        this.errorHandler = null;
        this.delivered = 0;
    }

    // 登记一个通道（同一通道登记两次会收到两遍消息）。
    public MessageBus Register(MessageChannelBase channel) {
        if (channel == null) {
            throw new MessageException(MessageError.InvalidHandler, null,
                "MessageBus.Register: the channel must not be null");
        }
        this.channels.Add(channel);
        return this;
    }

    // 把查询端点接到总线的中间件链上（端点仍然由使用者持有）。
    public MessageBus RegisterEndpoint(QueryEndpointBase endpoint) {
        if (endpoint == null) {
            throw new MessageException(MessageError.InvalidHandler, null,
                "MessageBus.RegisterEndpoint: the endpoint must not be null");
        }
        endpoint.Bus = this;
        return this;
    }

    // 登记的通道数量。
    public int ChannelCount() { return this.channels.Count; }

    // 中间件数量。
    public int MiddlewareCount() { return this.middleware.Count; }

    // 累计投递次数（订阅者被调用的总次数）。
    public int DeliveredCount() { return this.delivered; }

    // 是否登记了错误处理器。
    public bool HasErrorHandler() { return this.errorHandler != null; }

    // 登记一个中间件（按登记顺序包裹投递）。
    public MessageBus Use(MessageMiddleware handler) {
        if (handler == null) {
            throw new MessageException(MessageError.InvalidHandler, null,
                "MessageBus.Use: the middleware must not be null");
        }
        this.middleware.Add(handler);
        return this;
    }

    // 登记错误处理器（订阅者抛异常时调用；不登记则原样抛出）。
    public MessageBus OnError(ActionT2<Exception, object> handler) {
        if (handler == null) {
            throw new MessageException(MessageError.InvalidHandler, null,
                "MessageBus.OnError: the handler must not be null");
        }
        this.errorHandler = handler;
        return this;
    }

    // 广播：所有匹配通道的所有订阅者都收到（返回被调用的订阅者数量）。
    public int Publish(object message) {
        if (message == null) {
            throw new MessageException(MessageError.InvalidMessage, null,
                "MessageBus.Publish: the message must not be null");
        }
        MessageDelivery delivery = new MessageDelivery(this, this.channels, new MessageHolder(message));
        Action finalAction = () => { delivery.Run(); };
        this.RunPipeline(message, finalAction);
        int called = delivery.Delivered();
        this.delivered = this.delivered + called;
        return called;
    }

    // 命令：恰好一个订阅者，零个或多个都报错。
    public void Send(object command) {
        if (command == null) {
            throw new MessageException(MessageError.InvalidMessage, null,
                "MessageBus.Send: the command must not be null");
        }
        int handlers = 0;
        for (int i = 0; i < this.channels.Count; i = i + 1) {
            MessageChannelBase channel = this.channels[i];
            if (!channel.Accepts(command)) { continue; }
            handlers = handlers + channel.SubscriberCount();
        }
        if (handlers == 0) {
            throw new MessageException(MessageError.NoHandler, command,
                "MessageBus.Send: no handler is registered for this command");
        }
        if (handlers > 1) {
            throw new MessageException(MessageError.TooManyHandlers, command,
                "MessageBus.Send: expected exactly one handler, got " + handlers.ToString());
        }
        MessageDelivery delivery = new MessageDelivery(this, this.channels, new MessageHolder(command));
        Action finalAction = () => { delivery.Run(); };
        this.RunPipeline(command, finalAction);
        this.delivered = this.delivered + delivery.Delivered();
    }

    // 跑中间件链（公开给查询端点用）。
    public void RunPipeline(object message, Action finalAction) {
        this.RunMiddleware(0, new MessageHolder(message), finalAction);
    }

    // 报告订阅者的异常（登记了错误处理器时用）。
    public void ReportError(Exception cause, object message) {
        if (this.errorHandler == null) { return; }
        string text = cause != null ? cause.Message : "subscriber failed";
        MessageException wrapped = new MessageException(MessageError.HandlerFailed, message, text, cause);
        this.errorHandler(wrapped, message);
    }

    // 逐层跑中间件（递归深度 = 中间件数量）。
    private void RunMiddleware(int index, MessageHolder holder, Action finalAction) {
        if (index >= this.middleware.Count) {
            if (finalAction != null) { finalAction(); }
            return;
        }
        MessageBus self = this;
        Action next = () => { self.RunMiddleware(index + 1, holder, finalAction); };
        MessageMiddleware handler = this.middleware[index];
        handler(holder.Value, next);
    }
}
