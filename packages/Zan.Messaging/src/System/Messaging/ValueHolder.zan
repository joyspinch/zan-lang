using System;

namespace System.Messaging;

// 值持有盒：把一个值装进引用类型里。
//
// **为什么需要它**：Zan 的闭包只能捕获"运行期表示明确"的引用——捕获一个
// `object` 形参会报 "cannot capture parameter ... of type 'object': its
// runtime ownership is not representable yet"，捕获泛型形参也不稳。把值装进
// 盒子，闭包捕获盒子（一个普通类），就绕开了这两个坑。
//
// **这也是"结果用数组盒带出来"的原因**：闭包捕获普通局部变量只拿到副本
// （写进去外面看不见），捕获数组 / 盒子这类引用类型才是共享的。
public class ValueHolder<T> {
    // 装着的值。
    public T Value;

    public ValueHolder(T value) {
        this.Value = value;
    }
}
