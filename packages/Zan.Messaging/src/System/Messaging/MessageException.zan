using System;

namespace System.Messaging;

// 消息总线的错误。
//
// **异常 + 错误码两个通道**：人看 `Message`（异常自带），程序看 `error`。
public class MessageException : Exception {
    // 错误码。
    public MessageError error;
    // 出问题的消息的可读描述（没有则为空串）。
    public string messageText;

    public MessageException(MessageError error, object message, string text) : base(text) {
        this.error = error;
        this.messageText = text != null ? text : "";
    }

    // 带原始异常的构造（订阅者抛错时用；原异常在 `InnerException` 里）。
    public MessageException(MessageError error, object message, string text, Exception cause) : base(text, cause) {
        this.error = error;
        this.messageText = text != null ? text : "";
    }

    // 错误码的英文名（调试输出用；不依赖枚举的字符串格式化行为）。
    public string ErrorName() {
        if (this.error == MessageError.NoHandler) { return "NoHandler"; }
        if (this.error == MessageError.TooManyHandlers) { return "TooManyHandlers"; }
        if (this.error == MessageError.HandlerFailed) { return "HandlerFailed"; }
        if (this.error == MessageError.InvalidHandler) { return "InvalidHandler"; }
        if (this.error == MessageError.InvalidMessage) { return "InvalidMessage"; }
        return "Unknown";
    }
}
