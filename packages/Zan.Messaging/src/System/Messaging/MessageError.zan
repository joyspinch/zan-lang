namespace System.Messaging;

// 消息总线的错误原因（可区分的错误码）。
//
// **为什么要错误码**：总线里"没人处理"、"处理的人太多"、"处理的人炸了"是三种
// 完全不同的接线错误，补救办法也不同（前者是没订阅，后两者是订阅重复或处理
// 逻辑有 bug）。合成一句话会让排查变慢。
public enum MessageError {
    // 没有任何订阅者处理这条消息。
    NoHandler = 0,
    // 订阅者多于一个（命令语义要求恰好一个）。
    TooManyHandlers = 1,
    // 订阅者抛了异常（错误处理器收到的是带这个码的 `MessageException`）。
    HandlerFailed = 2,
    // 处理器 / 中间件 / 通道为 null。
    InvalidHandler = 3,
    // 消息为 null，或类型不对（值类型不能当消息传——总线只走引用类型）。
    InvalidMessage = 4,
}
