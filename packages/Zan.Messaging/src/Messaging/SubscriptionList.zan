using System;
using System.Collections.Generic;

namespace Messaging;

// 订阅表：一个通道的订阅者集合（按订阅顺序依次调用）。
//
// **为什么单独一个类**：通道的"投递委托"要在**通道的构造器里**定型（那时
// 类型参数是具体的）。委托里如果捕获 `this`，就会形成"通道 → 委托 → 通道"
// 的引用环（ARC 回收不掉）。改成捕获这个订阅表：通道 → 委托 → 订阅表，
// 没有环。
public class SubscriptionList<T> {
    // 订阅者槽位（退订后置 null，立即释放闭包引用；空洞过多时保序紧凑防止长期退订内存无限增长）。
    private List<Action<T>> handlers;
    private List<int> ids;
    private Dictionary<int, int> idToSlot;
    private int nextId;
    private int activeCount;

    public SubscriptionList() {
        this.handlers = new List<Action<T>>();
        this.ids = new List<int>();
        this.idToSlot = new Dictionary<int, int>();
        this.nextId = 0;
        this.activeCount = 0;
    }

    // 订阅（返回订阅编号，供退订用）。
    public int Add(Action<T> handler) {
        int id = this.nextId;
        this.nextId = this.nextId + 1;
        if (handler != null) {
            int slot = this.handlers.Count;
            this.handlers.Add(handler);
            this.ids.Add(id);
            this.idToSlot.Add(id, slot);
            this.activeCount = this.activeCount + 1;
        }
        return id;
    }

    // 退订（返回是否真的退订了；编号不存在或已退订都返回 false）。
    public bool Revoke(int subscriptionId) {
        int slot = -1;
        if (!this.idToSlot.TryGetValue(subscriptionId, out slot)) { return false; }
        this.idToSlot.Remove(subscriptionId);
        if (slot >= 0 && slot < this.handlers.Count) {
            this.handlers[slot] = null;
        }
        if (this.activeCount > 0) { this.activeCount = this.activeCount - 1; }
        if (this.handlers.Count >= 32 && this.activeCount * 2 <= this.handlers.Count) {
            this.Compact();
        }
        return true;
    }

    private void Compact() {
        List<Action<T>> nextHandlers = new List<Action<T>>();
        List<int> nextIds = new List<int>();
        Dictionary<int, int> nextMap = new Dictionary<int, int>();
        for (int i = 0; i < this.handlers.Count; i = i + 1) {
            Action<T> h = this.handlers[i];
            if (h == null) { continue; }
            int id = this.ids[i];
            int newSlot = nextHandlers.Count;
            nextHandlers.Add(h);
            nextIds.Add(id);
            nextMap.Add(id, newSlot);
        }
        this.handlers = nextHandlers;
        this.ids = nextIds;
        this.idToSlot = nextMap;
    }

    // 这个订阅编号是否已退订。
    public bool IsRevoked(int subscriptionId) {
        if (subscriptionId < 0 || subscriptionId >= this.nextId) { return false; }
        return !this.idToSlot.ContainsKey(subscriptionId);
    }

    // 有效订阅者数量（已退订的不算）。
    public int Count() {
        return this.activeCount;
    }

    // 广播：所有有效订阅者都收到（返回被调用的数量）。
    public int Publish(T message) {
        return this.Publish(message, null);
    }

    // 广播（带单订阅者异常隔离：onError 非空时逐个捕获异常并继续投递后续订阅者）。
    public int Publish(T message, Action<Exception> onError) {
        int called = 0;
        int n = this.handlers.Count;
        for (int i = 0; i < n; i = i + 1) {
            if (i >= this.handlers.Count) { break; }
            Action<T> h = this.handlers[i];
            if (h == null) { continue; }
            if (onError != null) {
                try {
                    h(message);
                    called = called + 1;
                } catch (Exception ex) {
                    onError(ex);
                }
            } else {
                h(message);
                called = called + 1;
            }
        }
        return called;
    }

    // 命令：只投给唯一一个有效订阅者（调用方要保证只有一个）。
    public void PublishOne(T message) {
        for (int i = 0; i < this.handlers.Count; i = i + 1) {
            Action<T> h = this.handlers[i];
            if (h == null) { continue; }
            h(message);
            return;
        }
    }
}
