using System;
using System.Collections.Generic;

namespace Messaging;

// 一次投递的执行体：把一条消息投给所有"接这条消息"的通道。
//
// **为什么单独一个类**：中间件链的最后一步是一个 `Action`（无参闭包），
// 它要把"消息 + 通道表 + 计数"一起带进投递逻辑。闭包捕获 `this` 会被
// 判成"this 逃逸"，所以这些状态装进一个普通类里，闭包只捕获它。
public class MessageDelivery {
    // 所属总线（错误处理走总线）。
    private MessageBus bus;
    // 通道表。
    private List<MessageChannelBase> channels;
    // 消息。
    private MessageHolder holder;
    // 累计投出去的数量。
    private int deliveredCount;

    public MessageDelivery(MessageBus bus, List<MessageChannelBase> channels, MessageHolder holder) {
        this.bus = bus;
        this.channels = channels;
        this.holder = holder;
        this.deliveredCount = 0;
    }

    // 投递（返回被调用的订阅者数量）。
    public int Run() {
        if (this.channels == null || this.holder == null) { return this.deliveredCount; }
        int channelCount = this.channels.Count;
        object msg = this.holder.Value;
        for (int i = 0; i < channelCount && i < this.channels.Count; i = i + 1) {
            MessageChannelBase channel = this.channels[i];
            if (channel == null) { continue; }
            if (this.bus != null && this.bus.HasErrorHandler()) {
                // 登记了错误处理器：按订阅者粒度隔离异常，不影响同通道后续订阅者与成功计数。
                MessageBus b = this.bus;
                int okCount = channel.TryDispatch(msg, (Exception ex) => {
                    b.ReportError(ex, msg);
                });
                if (okCount >= 0) { this.deliveredCount = this.deliveredCount + okCount; }
            } else {
                // 没登记：订阅者的异常原样抛出（总线里的异常多半是处理逻辑的
                // bug，吞掉会让问题变成"消息莫名其妙没到"）。
                int okCount = channel.TryDispatch(msg);
                if (okCount >= 0) { this.deliveredCount = this.deliveredCount + okCount; }
            }
        }
        return this.deliveredCount;
    }

    // 被调用的订阅者数量。
    public int Delivered() {
        return this.deliveredCount;
    }
}
