namespace Zan.Kafka;

// Kafka 官方二进制网络协议核心常量表与 API 标识
public class KafkaConstants {
    public static const int DEFAULT_PORT = 9092;

    // API Keys (官方协议请求编号)
    public static const int API_PRODUCE = 0;
    public static const int API_FETCH = 1;
    public static const int API_LIST_OFFSETS = 2;
    public static const int API_METADATA = 3;
    public static const int API_OFFSET_COMMIT = 8;
    public static const int API_OFFSET_FETCH = 9;
    public static const int API_FIND_COORDINATOR = 10;
    public static const int API_JOIN_GROUP = 11;
    public static const int API_HEARTBEAT = 12;
    public static const int API_LEAVE_GROUP = 13;
    public static const int API_SYNC_GROUP = 14;
    public static const int API_API_VERSIONS = 18;

    // 常用确认机制 (Acks)
    public static const int ACKS_NONE = 0;
    public static const int ACKS_LEADER = 1;
    public static const int ACKS_ALL = -1;

    // RecordBatch 协议魔数 (Kafka 0.11+ 生产标准)
    public static const int RECORD_BATCH_MAGIC = 2;

    // 错误码 (Error Codes)
    public static const int ERR_NONE = 0;
    public static const int ERR_OFFSET_OUT_OF_RANGE = 1;
    public static const int ERR_CORRUPT_MESSAGE = 2;
    public static const int ERR_UNKNOWN_TOPIC_OR_PARTITION = 3;
    public static const int ERR_LEADER_NOT_AVAILABLE = 5;
    public static const int ERR_NOT_LEADER_OR_FOLLOWER = 6;
    public static const int ERR_REQUEST_TIMED_OUT = 7;
    public static const int ERR_NETWORK_EXCEPTION = 13;
}
