using System;

namespace Zan.Kafka;

// Kafka 消息投递确认结果
public class ProduceResult {
    public string topic;
    public int partition;
    public long offset;
    public int errorCode;
    public long logAppendTime;

    public ProduceResult(string topic, int partition, long offset, int errorCode, long logAppendTime) {
        this.topic = topic;
        this.partition = partition;
        this.offset = offset;
        this.errorCode = errorCode;
        this.logAppendTime = logAppendTime;
    }

    public bool IsSuccess() {
        return this.errorCode == KafkaConstants.ERR_NONE;
    }
}

// Kafka 高性能异步生产者客户端
public class KafkaProducer {
    private KafkaConnection conn;
    public int acks;
    public int timeoutMs;

    public KafkaProducer(KafkaConnection connection) {
        this.conn = connection;
        this.acks = KafkaConstants.ACKS_LEADER;
        this.timeoutMs = 5000;
    }

    // 极简异步连接（使用 Kafka 默认端口 9092）
    public static async KafkaProducer CreateAsync(string host) {
        return await KafkaProducer.CreateAsync(host, KafkaConstants.DEFAULT_PORT);
    }

    public static async KafkaProducer CreateAsync(string host, int port) {
        KafkaConnection c = await KafkaConnection.ConnectAsync(host, port);
        if (c == null) { return null; }
        return new KafkaProducer(c);
    }

    public bool IsConnected() {
        return this.conn != null && this.conn.IsConnected();
    }

    // 查询集群与主题元数据 (Metadata API v1)
    public async List<TopicMetadata> GetMetadataAsync(List<string> topics) {
        if (!this.IsConnected()) { return null; }
        KafkaWriter w = new KafkaWriter(64);
        if (topics == null || topics.Count == 0) {
            w.WriteArrayHeader(0);
        } else {
            w.WriteArrayHeader(topics.Count);
            for (int i = 0; i < topics.Count; i = i + 1) {
                w.WriteString(topics[i]);
            }
        }

        KafkaReader r = await this.conn.SendRequestAsync(KafkaConstants.API_METADATA, 1, w.ToBytes());
        if (r == null) { return null; }

        // 解析 Brokers
        int brokerCount = r.ReadArrayHeader();
        for (int i = 0; i < brokerCount; i = i + 1) {
            int nid = r.ReadInt32();
            string bHost = r.ReadString();
            int bPort = r.ReadInt32();
            string bRack = r.ReadString();
        }

        int controllerId = r.ReadInt32();

        // 解析 TopicMetadata
        int topicCount = r.ReadArrayHeader();
        List<TopicMetadata> res = new List<TopicMetadata>();
        for (int i = 0; i < topicCount; i = i + 1) {
            int tErr = r.ReadInt16();
            string tName = r.ReadString();
            bool isInternal = r.ReadUInt8() != 0;

            TopicMetadata tm = new TopicMetadata(tName, tErr);
            int partCount = r.ReadArrayHeader();
            for (int p = 0; p < partCount; p = p + 1) {
                int pErr = r.ReadInt16();
                int pid = r.ReadInt32();
                int leader = r.ReadInt32();
                PartitionMetadata pm = new PartitionMetadata(pid, leader, pErr);

                int repCount = r.ReadArrayHeader();
                for (int rep = 0; rep < repCount; rep = rep + 1) {
                    pm.replicas.Add(r.ReadInt32());
                }
                int isrCount = r.ReadArrayHeader();
                for (int isr = 0; isr < isrCount; isr = isr + 1) {
                    pm.isr.Add(r.ReadInt32());
                }
                tm.partitions.Add(pm);
            }
            res.Add(tm);
        }
        return res;
    }

    // 极简投递单条消息至默认分区 0
    public async ProduceResult SendAsync(string topic, string value) {
        return await this.SendAsync(topic, 0, null, value);
    }

    // 极简投递带 Key 消息至默认分区 0
    public async ProduceResult SendAsync(string topic, string key, string value) {
        return await this.SendAsync(topic, 0, key, value);
    }

    // 投递单条消息至指定主题与分区 (使用 Kafka 0.11+ RecordBatch v2 标准)
    public async ProduceResult SendAsync(string topic, int partition, string key, string value) {
        KafkaRecord rec = new KafkaRecord(key, value);
        List<KafkaRecord> list = new List<KafkaRecord>();
        list.Add(rec);
        return await this.SendBatchAsync(topic, partition, list);
    }

    // 批量投递多条消息至指定主题与分区
    public async ProduceResult SendBatchAsync(string topic, int partition, List<KafkaRecord> records) {
        if (!this.IsConnected() || records == null || records.Count == 0) {
            return new ProduceResult(topic, partition, -1L, KafkaConstants.ERR_NETWORK_EXCEPTION, 0L);
        }

        // 1. 构建二进制 RecordBatch (含 CRC32C 硬件校验)
        byte[] batchBytes = KafkaRecord.BuildRecordBatch(0L, records);

        // 2. 构造 ProduceRequest v3 请求体
        KafkaWriter w = new KafkaWriter(batchBytes.Length + 128);
        w.WriteString(null); // transactional_id: null
        w.WriteInt16(this.acks);
        w.WriteInt32(this.timeoutMs);

        // Topic 数据数组 (1 个 topic)
        w.WriteArrayHeader(1);
        w.WriteString(topic);

        // Partition 数据数组 (1 个 partition)
        w.WriteArrayHeader(1);
        w.WriteInt32(partition);
        w.WriteBytes(batchBytes);

        // 3. 发送请求
        KafkaReader r = await this.conn.SendRequestAsync(KafkaConstants.API_PRODUCE, 3, w.ToBytes());
        if (r == null) {
            return new ProduceResult(topic, partition, -1L, KafkaConstants.ERR_NETWORK_EXCEPTION, 0L);
        }

        // 4. 解析 ProduceResponse v3 响应体
        int topicCount = r.ReadArrayHeader();
        if (topicCount <= 0) {
            return new ProduceResult(topic, partition, -1L, KafkaConstants.ERR_UNKNOWN_TOPIC_OR_PARTITION, 0L);
        }

        string respTopic = r.ReadString();
        int partCount = r.ReadArrayHeader();
        if (partCount <= 0) {
            return new ProduceResult(topic, partition, -1L, KafkaConstants.ERR_UNKNOWN_TOPIC_OR_PARTITION, 0L);
        }

        int respPart = r.ReadInt32();
        int errCode = r.ReadInt16();
        long baseOffset = r.ReadInt64();
        long logAppendTime = r.ReadInt64();
        long logStartOffset = r.ReadInt64();

        return new ProduceResult(respTopic, respPart, baseOffset, errCode, logAppendTime);
    }

    public void Close() {
        if (this.conn != null) {
            this.conn.Close();
            this.conn = null;
        }
    }

    public void Dispose() {
        this.Close();
    }
}
