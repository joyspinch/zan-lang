using System;
using System.Buffers.Binary;

namespace Messaging.Kafka;

// Kafka 二进制网络协议大端序反序列化解析器（基于 System.Buffers.Binary.BinaryBufferReader）
public class KafkaReader {
    private BinaryBufferReader reader;

    public KafkaReader(byte[] buffer) {
        this.reader = new BinaryBufferReader(buffer);
    }

    public KafkaReader(byte[] buffer, int offset, int length) {
        this.reader = new BinaryBufferReader(buffer, offset, length);
    }

    public int Position() {
        return this.reader.Position();
    }

    public int Remaining() {
        return this.reader.Remaining();
    }

    public void Seek(int newPosition) {
        this.reader.Seek(newPosition);
    }

    public int ReadInt8() {
        return this.reader.ReadInt8();
    }

    public int ReadUInt8() {
        return this.reader.ReadUInt8();
    }

    public int ReadInt16() {
        return this.reader.ReadInt16BE();
    }

    public int ReadInt32() {
        return this.reader.ReadInt32BE();
    }

    public long ReadInt64() {
        return this.reader.ReadInt64BE();
    }

    // Zigzag 解码 Varint (32位变长整数)
    public int ReadVarint() {
        return this.reader.ReadVarint32(true);
    }

    // Zigzag 解码 Varlong (64位变长整数)
    public long ReadVarlong() {
        return this.reader.ReadVarint64(true);
    }

    // 读取标准 Kafka 字符串：2 字节大端有符号长度（-1 为 null）
    public string ReadString() {
        int len = this.ReadInt16();
        if (len < 0) { return null; }
        if (len == 0) { return ""; }
        if (this.Remaining() < len) { return ""; }
        return this.reader.ReadStringUtf8(len);
    }

    public string ReadStringRaw(int len) {
        if (len <= 0 || this.Remaining() < len) { return ""; }
        return this.reader.ReadStringUtf8(len);
    }

    // 读取标准 Kafka 字节数组：4 字节大端有符号长度（-1 为 null）
    public byte[] ReadBytes() {
        int len = this.ReadInt32();
        if (len < 0) { return null; }
        if (len == 0) { return new byte[0]; }
        if (this.Remaining() < len) { return null; }
        return this.reader.ReadBytes(len);
    }

    public byte[] ReadRaw(int count) {
        if (count <= 0 || this.Remaining() < count) { return new byte[0]; }
        return this.reader.ReadBytes(count);
    }

    public int ReadArrayHeader() {
        return this.ReadInt32();
    }
}
