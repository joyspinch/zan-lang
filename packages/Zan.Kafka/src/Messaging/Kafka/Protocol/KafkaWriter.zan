using System;
using System.Buffers.Binary;

namespace Messaging.Kafka;

// Kafka 二进制网络协议大端序序列化工具（基于 System.Buffers.Binary.BinaryBufferWriter）
public class KafkaWriter {
    private BinaryBufferWriter writer;

    public KafkaWriter() {
        this.writer = new BinaryBufferWriter(256);
    }

    public KafkaWriter(int initialCapacity) {
        this.writer = new BinaryBufferWriter(initialCapacity < 64 ? 64 : initialCapacity);
    }

    public void WriteInt8(int v) {
        this.writer.WriteInt8(v);
    }

    public void WriteInt16(int v) {
        this.writer.WriteInt16BE(v);
    }

    public void WriteInt32(int v) {
        this.writer.WriteInt32BE(v);
    }

    public void WriteInt64(long v) {
        this.writer.WriteInt64BE(v);
    }

    // 变长无符号整数编码 (Kafka Record v2 Varint / Zigzag)
    public void WriteVarint(int v) {
        this.writer.WriteVarint32(v, true);
    }

    public void WriteVarlong(long v) {
        this.writer.WriteVarint64(v, true);
    }

    // 写入标准 Kafka 字符串：2 字节有符号大端长度 + 字符串内容（-1 表示 null）
    public void WriteString(string s) {
        if (s == null) {
            this.writer.WriteInt16BE(-1);
            return;
        }
        int len = s.Length;
        this.writer.WriteInt16BE(len);
        if (len > 0) {
            this.writer.WriteStringUtf8(s);
        }
    }

    public void WriteStringRaw(string s) {
        if (s == null || s.Length == 0) { return; }
        this.writer.WriteStringUtf8(s);
    }

    // 写入标准 Kafka 字节数组：4 字节有符号大端长度 + 数据（-1 表示 null）
    public void WriteBytes(byte[] b) {
        if (b == null) {
            this.writer.WriteInt32BE(-1);
            return;
        }
        int len = b.Length;
        this.writer.WriteInt32BE(len);
        if (len > 0) {
            this.writer.WriteBytes(b, 0, len);
        }
    }

    public void WriteRaw(byte[] b, int len) {
        if (b == null || len <= 0) { return; }
        this.writer.WriteBytes(b, 0, len);
    }

    public void WriteArrayHeader(int count) {
        this.writer.WriteInt32BE(count);
    }

    // 回填指定偏移处的 4 字节整数（用于在计算出负载大小或 CRC 后补齐协议头）
    public void PatchInt32(int offset, int v) {
        this.writer.PatchInt32BE(offset, v);
    }

    public int Length() {
        return this.writer.Length();
    }

    public byte[] ToBytes() {
        return this.writer.ToArray();
    }
}
