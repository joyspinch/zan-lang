using System;
using System.Interop;

namespace Messaging.Kafka;

// Kafka 单条消息模型 (包含 Key、Value、时间戳、Offset 与自定义 Headers)
public class KafkaRecord {
    public long offset;
    public long timestamp;
    public string key;
    public string value;
    public Dictionary<string, string> headers;

    public KafkaRecord() {
        this.offset = 0L;
        this.timestamp = 0L;
        this.key = null;
        this.value = null;
        this.headers = new Dictionary<string, string>();
    }

    private KafkaRecord(bool initHeaders) {
        this.offset = 0L;
        this.timestamp = 0L;
        this.key = null;
        this.value = null;
        this.headers = initHeaders ? new Dictionary<string, string>() : null;
    }

    public KafkaRecord(string key, string value) {
        this.offset = 0L;
        this.timestamp = 0L;
        this.key = key;
        this.value = value;
        this.headers = new Dictionary<string, string>();
    }

    private static int Varint32Size(int v) {
        uint u = (uint)((v << 1) ^ (v >> 31));
        if (u < 128U) { return 1; }
        if (u < 16384U) { return 2; }
        if (u < 2097152U) { return 3; }
        if (u < 268435456U) { return 4; }
        return 5;
    }

    private static int Varint64Size(long v) {
        ulong u = (ulong)((v << 1) ^ (v >> 63));
        int n = 1;
        while (u >= 128UL) {
            u = u >> 7;
            n = n + 1;
        }
        return n;
    }

    // 将单条消息直写目标 writer（预算 bodyLen 零 scratch 中转与二次拷贝）
    public void EncodeRecordInto(KafkaWriter dst, long firstTimestamp, int offsetDelta) {
        long tsDelta = this.timestamp > 0L ? this.timestamp - firstTimestamp : 0L;
        int kLen = this.key == null ? -1 : this.key.Length;
        int vLen = this.value == null ? -1 : this.value.Length;
        int bodyLen = 1 + Varint64Size(tsDelta) + Varint32Size(offsetDelta);
        bodyLen = bodyLen + Varint32Size(kLen) + (kLen > 0 ? kLen : 0);
        bodyLen = bodyLen + Varint32Size(vLen) + (vLen > 0 ? vLen : 0);
        bool hasHeaders = this.headers != null && this.headers.Count > 0;
        List<string> hkeys = null;
        if (!hasHeaders) {
            bodyLen = bodyLen + 1; // varint(0)
        } else {
            hkeys = this.headers.Keys;
            bodyLen = bodyLen + Varint32Size(hkeys.Count);
            for (int i = 0; i < hkeys.Count; i = i + 1) {
                string hk = hkeys[i];
                string hv = this.headers[hk];
                bodyLen = bodyLen + Varint32Size(hk.Length) + hk.Length;
                if (hv == null) {
                    bodyLen = bodyLen + 1; // varint(-1) = zigzag 1
                } else {
                    bodyLen = bodyLen + Varint32Size(hv.Length) + hv.Length;
                }
            }
        }

        dst.WriteVarint(bodyLen);
        dst.WriteInt8(0); // attributes
        dst.WriteVarlong(tsDelta);
        dst.WriteVarint(offsetDelta);

        dst.WriteVarint(kLen);
        if (kLen > 0) { dst.WriteStringRaw(this.key); }

        dst.WriteVarint(vLen);
        if (vLen > 0) { dst.WriteStringRaw(this.value); }

        if (!hasHeaders) {
            dst.WriteVarint(0);
        } else {
            dst.WriteVarint(hkeys.Count);
            for (int i = 0; i < hkeys.Count; i = i + 1) {
                string hk = hkeys[i];
                string hv = this.headers[hk];
                dst.WriteVarint(hk.Length);
                dst.WriteStringRaw(hk);
                if (hv == null) {
                    dst.WriteVarint(-1);
                } else {
                    dst.WriteVarint(hv.Length);
                    dst.WriteStringRaw(hv);
                }
            }
        }
    }

    // 将单条消息序列化为 Record v2 字节流 (变长 Varint 编码)
    public byte[] EncodeRecord(long firstTimestamp, int offsetDelta) {
        KafkaWriter res = new KafkaWriter(72);
        this.EncodeRecordInto(res, firstTimestamp, offsetDelta);
        return res.ToBytes();
    }

    // 从 Record v2 二进制流解码单条 Record
    public static KafkaRecord DecodeRecord(KafkaReader r, long baseOffset, long firstTimestamp) {
        if (r == null) { return null; }
        return KafkaRecord.DecodeRecordBounded(r, baseOffset, firstTimestamp, r.Position() + r.Remaining());
    }

    // 在给定批次上界 maxEnd 内解码单条 Record，防止畸形 recordLen 越过 batch 边界读取后续数据
    internal static KafkaRecord DecodeRecordBounded(KafkaReader r, long baseOffset, long firstTimestamp, int maxEnd) {
        if (r == null) { return null; }
        int bufEnd = r.Position() + r.Remaining();
        if (maxEnd > bufEnd) { maxEnd = bufEnd; }
        if (r.Position() >= maxEnd) { return null; }
        int recordLen = r.ReadVarint();
        int startPos = r.Position();
        if (recordLen <= 0 || startPos > maxEnd || recordLen > maxEnd - startPos) { return null; }
        int recordEnd = startPos + recordLen;

        KafkaRecord rec = new KafkaRecord(false);
        if (r.Position() >= recordEnd) { return null; }
        int attr = r.ReadInt8();
        if (r.Position() >= recordEnd) { return null; }
        long tsDelta = r.ReadVarlong();
        rec.timestamp = firstTimestamp + tsDelta;

        if (r.Position() >= recordEnd) { return null; }
        int offsetDelta = r.ReadVarint();
        rec.offset = baseOffset + (long)offsetDelta;

        // Key
        if (r.Position() >= recordEnd) { return null; }
        int keyLen = r.ReadVarint();
        if (keyLen < -1 || keyLen > recordEnd - r.Position()) { return null; }
        if (keyLen >= 0) {
            rec.key = r.ReadStringRaw(keyLen);
        }

        // Value
        if (r.Position() >= recordEnd) { return null; }
        int valLen = r.ReadVarint();
        if (valLen < -1 || valLen > recordEnd - r.Position()) { return null; }
        if (valLen >= 0) {
            rec.value = r.ReadStringRaw(valLen);
        }

        // Headers（零头消息免分配 Dictionary；严格按记录剩余字节上界防 DoS）
        if (r.Position() >= recordEnd) { return null; }
        int hCount = r.ReadVarint();
        int remAfterCount = recordEnd - r.Position();
        if (hCount < 0 || hCount > remAfterCount / 2) { return null; }
        if (hCount > 0) {
            rec.headers = new Dictionary<string, string>();
            for (int i = 0; i < hCount; i = i + 1) {
                if (r.Position() >= recordEnd) { return null; }
                int hkLen = r.ReadVarint();
                if (hkLen < 0 || hkLen > recordEnd - r.Position()) { return null; }
                string hk = r.ReadStringRaw(hkLen);
                if (r.Position() >= recordEnd) { return null; }
                int hvLen = r.ReadVarint();
                if (hvLen < -1 || hvLen > recordEnd - r.Position()) { return null; }
                string hv = "";
                if (hvLen >= 0) {
                    hv = r.ReadStringRaw(hvLen);
                }
                if (hk.Length > 0) {
                    rec.headers[hk] = hv;
                }
            }
        }

        if (r.Position() < recordEnd) {
            r.Seek(recordEnd);
        }
        return rec;
    }

    // 构建符合 Kafka 0.11+ 生产标准的 RecordBatch (包含硬件 CRC32C 校验与 Magic=2)
    public static byte[] BuildRecordBatch(long baseOffset, List<KafkaRecord> records) {
        if (records == null || records.Count == 0) { return new byte[0]; }
        int estCap = 64 + records.Count * 64;
        if (estCap < 512) { estCap = 512; }
        KafkaWriter bw = new KafkaWriter(estCap);

        // 1. baseOffset (8 bytes)
        bw.WriteInt64(baseOffset);

        // 2. batchLength 占位符 (4 bytes, offset = 8)
        int batchLengthOffset = bw.Length();
        bw.WriteInt32(0);

        // 3. partitionLeaderEpoch (4 bytes)
        bw.WriteInt32(0);

        // 4. magic (1 byte = 2)
        bw.WriteInt8(KafkaConstants.RECORD_BATCH_MAGIC);

        // 5. crc 占位符 (4 bytes, offset = 17)
        int crcOffset = bw.Length();
        bw.WriteInt32(0);

        // CRC 校验覆盖从 attributes 开始到 RecordBatch 结束的所有字节
        int crcStartOffset = bw.Length();

        // 6. attributes (2 bytes, 0=无压缩)
        bw.WriteInt16(0);

        // 7. lastOffsetDelta (4 bytes)
        int lastDelta = records.Count - 1;
        bw.WriteInt32(lastDelta);

        // 8. firstTimestamp 与 maxTimestamp (各 8 bytes，严格 UTC Unix 毫秒)
        long now = DateTime.GetCurrentUnixMilliseconds();
        long firstTs = now;
        long maxTs = now;
        for (int i = 0; i < records.Count; i = i + 1) {
            if (records[i] != null && records[i].timestamp > maxTs) {
                maxTs = records[i].timestamp;
            }
        }
        bw.WriteInt64(firstTs);
        bw.WriteInt64(maxTs);

        // 9. producerId (8 bytes), producerEpoch (2 bytes), baseSequence (4 bytes)
        bw.WriteInt64(-1L);
        bw.WriteInt16(-1);
        bw.WriteInt32(-1);

        // 10. records count (4 bytes)
        bw.WriteInt32(records.Count);

        // 11. 写入每条 Record（预算长度直写，零逐条中间分配与二次拷贝）
        for (int i = 0; i < records.Count; i = i + 1) {
            KafkaRecord rec = records[i] != null ? records[i] : new KafkaRecord();
            rec.EncodeRecordInto(bw, firstTs, i);
        }

        // 回填 batchLength (从 partitionLeaderEpoch 到结尾的字节长度)
        int totalLen = bw.Length();
        int batchLen = totalLen - (batchLengthOffset + 4);
        bw.PatchInt32(batchLengthOffset, batchLen);

        // 直接对内部缓冲算硬件加速 Castagnoli CRC32C 并回填，最终只做一次 ToBytes 切片拷贝
        int crcDataLen = totalLen - crcStartOffset;
        int crcVal = (int)NativeMemory.Crc32C((nint)bw.Buffer() + (nint)crcStartOffset, crcDataLen);
        bw.PatchInt32(crcOffset, crcVal);

        return bw.ToBytes();
    }

    // 从二进制字节流解析连续的 RecordBatch 序列并提取所有消息
    public static List<KafkaRecord> ParseRecordBatch(byte[] data, int offset, int length) {
        List<KafkaRecord> list = new List<KafkaRecord>();
        if (data == null || offset < 0 || length < 61 || offset > data.Length - length) { return list; } // 最小 RecordBatch 头部长度 61 字节
        KafkaReader r = new KafkaReader(data, offset, length);

        while (r.Remaining() >= 61) {
            int batchStart = r.Position();
            long baseOffset = r.ReadInt64();
            int batchLen = r.ReadInt32();
            if (batchLen < 49 || r.Remaining() < batchLen) { break; }
            int nextBatchPos = batchStart + 12 + batchLen;

            int partitionLeaderEpoch = r.ReadInt32();
            int magic = r.ReadInt8();
            if (magic != KafkaConstants.RECORD_BATCH_MAGIC) { break; }

            int crc = r.ReadInt32();
            int crcStart = r.Position();
            int crcLen = nextBatchPos - crcStart;
            if (crcLen < 40) { break; }
            int actualCrc = (int)NativeMemory.Crc32C((nint)data + (nint)crcStart, crcLen);
            if (actualCrc != crc) { break; }
            int attr = r.ReadInt16();
            if ((attr & 7) != 0) {
                // 暂未解压缩的压缩批次跳过整个 batch，避免把密文/压缩流当未压缩记录解析。
                r.Seek(nextBatchPos);
                continue;
            }
            int lastOffsetDelta = r.ReadInt32();
            long firstTs = r.ReadInt64();
            long maxTs = r.ReadInt64();
            long producerId = r.ReadInt64();
            int producerEpoch = r.ReadInt16();
            int baseSeq = r.ReadInt32();

            int recordsCount = r.ReadInt32();
            if (recordsCount < 0) { break; }
            if (recordsCount > 0 && recordsCount < 65536) { list.Reserve(list.Count + recordsCount); }
            for (int i = 0; i < recordsCount && r.Position() < nextBatchPos; i = i + 1) {
                KafkaRecord rec = KafkaRecord.DecodeRecordBounded(r, baseOffset, firstTs, nextBatchPos);
                if (rec == null) { break; }
                list.Add(rec);
            }
            r.Seek(nextBatchPos);
        }
        return list;
    }
}
