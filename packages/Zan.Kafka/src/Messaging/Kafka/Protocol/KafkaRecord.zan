using System;
using System.Interop;

namespace Messaging.Kafka;

// Kafka 单条消息模型 (包含 Key、Value、时间戳、Offset 与自定义 Headers)
public class KafkaRecord {
    public long offset;
    public long timestamp;
    public string key;
    public string value;
    public Dictionary<string, string> headers;

    public KafkaRecord() {
        this.offset = 0L;
        this.timestamp = 0L;
        this.key = null;
        this.value = null;
        this.headers = new Dictionary<string, string>();
    }

    public KafkaRecord(string key, string value) {
        this.offset = 0L;
        this.timestamp = 0L;
        this.key = key;
        this.value = value;
        this.headers = new Dictionary<string, string>();
    }

    // 将单条消息序列化为 Record v2 字节流 (变长 Varint 编码)
    public byte[] EncodeRecord(long firstTimestamp, int offsetDelta) {
        KafkaWriter w = new KafkaWriter(64);
        w.WriteInt8(0); // attributes

        long tsDelta = this.timestamp > 0L ? this.timestamp - firstTimestamp : 0L;
        w.WriteVarlong(tsDelta);
        w.WriteVarint(offsetDelta);

        // Key
        if (this.key == null) {
            w.WriteVarint(-1);
        } else {
            w.WriteVarint(this.key.Length);
            w.WriteStringRaw(this.key);
        }

        // Value
        if (this.value == null) {
            w.WriteVarint(-1);
        } else {
            w.WriteVarint(this.value.Length);
            w.WriteStringRaw(this.value);
        }

        // Headers
        if (this.headers == null || this.headers.Count == 0) {
            w.WriteVarint(0);
        } else {
            List<string> hkeys = this.headers.Keys;
            w.WriteVarint(hkeys.Count);
            for (int i = 0; i < hkeys.Count; i = i + 1) {
                string hk = hkeys[i];
                string hv = this.headers[hk];
                w.WriteVarint(hk.Length);
                w.WriteStringRaw(hk);
                if (hv == null) {
                    w.WriteVarint(-1);
                } else {
                    w.WriteVarint(hv.Length);
                    w.WriteStringRaw(hv);
                }
            }
        }

        byte[] body = w.ToBytes();
        KafkaWriter res = new KafkaWriter(body.Length + 8);
        res.WriteVarint(body.Length);
        res.WriteRaw(body, body.Length);
        return res.ToBytes();
    }

    // 从 Record v2 二进制流解码单条 Record
    public static KafkaRecord DecodeRecord(KafkaReader r, long baseOffset, long firstTimestamp) {
        if (r.Remaining() < 1) { return null; }
        int recordLen = r.ReadVarint();
        if (recordLen <= 0 || r.Remaining() < recordLen) { return null; }
        int startPos = r.Position();

        KafkaRecord rec = new KafkaRecord();
        int attr = r.ReadInt8();
        long tsDelta = r.ReadVarlong();
        rec.timestamp = firstTimestamp + tsDelta;

        int offsetDelta = r.ReadVarint();
        rec.offset = baseOffset + (long)offsetDelta;

        // Key
        int keyLen = r.ReadVarint();
        if (keyLen >= 0) {
            rec.key = r.ReadStringRaw(keyLen);
        }

        // Value
        int valLen = r.ReadVarint();
        if (valLen >= 0) {
            rec.value = r.ReadStringRaw(valLen);
        }

        // Headers
        int hCount = r.ReadVarint();
        if (hCount > 0) {
            for (int i = 0; i < hCount; i = i + 1) {
                int hkLen = r.ReadVarint();
                string hk = r.ReadStringRaw(hkLen);
                int hvLen = r.ReadVarint();
                string hv = "";
                if (hvLen >= 0) {
                    hv = r.ReadStringRaw(hvLen);
                }
                if (hk.Length > 0) {
                    rec.headers[hk] = hv;
                }
            }
        }

        int consumed = r.Position() - startPos;
        if (consumed < recordLen) {
            r.Seek(startPos + recordLen);
        }
        return rec;
    }

    // 构建符合 Kafka 0.11+ 生产标准的 RecordBatch (包含硬件 CRC32C 校验与 Magic=2)
    public static byte[] BuildRecordBatch(long baseOffset, List<KafkaRecord> records) {
        if (records == null || records.Count == 0) { return new byte[0]; }
        KafkaWriter bw = new KafkaWriter(512);

        // 1. baseOffset (8 bytes)
        bw.WriteInt64(baseOffset);

        // 2. batchLength 占位符 (4 bytes, offset = 8)
        int batchLengthOffset = bw.Length();
        bw.WriteInt32(0);

        // 3. partitionLeaderEpoch (4 bytes)
        bw.WriteInt32(0);

        // 4. magic (1 byte = 2)
        bw.WriteInt8(KafkaConstants.RECORD_BATCH_MAGIC);

        // 5. crc 占位符 (4 bytes, offset = 17)
        int crcOffset = bw.Length();
        bw.WriteInt32(0);

        // CRC 校验覆盖从 attributes 开始到 RecordBatch 结束的所有字节
        int crcStartOffset = bw.Length();

        // 6. attributes (2 bytes, 0=无压缩)
        bw.WriteInt16(0);

        // 7. lastOffsetDelta (4 bytes)
        int lastDelta = records.Count - 1;
        bw.WriteInt32(lastDelta);

        // 8. firstTimestamp 与 maxTimestamp (各 8 bytes)
        long now = DateTime.Now().epochMs;
        bw.WriteInt64(now);
        bw.WriteInt64(now);

        // 9. producerId (8 bytes), producerEpoch (2 bytes), baseSequence (4 bytes)
        bw.WriteInt64(-1L);
        bw.WriteInt16(-1);
        bw.WriteInt32(-1);

        // 10. records count (4 bytes)
        bw.WriteInt32(records.Count);

        // 11. 写入每条 Record
        for (int i = 0; i < records.Count; i = i + 1) {
            KafkaRecord rec = records[i];
            byte[] rBytes = rec.EncodeRecord(now, i);
            bw.WriteRaw(rBytes, rBytes.Length);
        }

        // 回填 batchLength (从 partitionLeaderEpoch 到结尾的字节长度)
        int totalLen = bw.Length();
        int batchLen = totalLen - (batchLengthOffset + 4);
        bw.PatchInt32(batchLengthOffset, batchLen);

        // 计算硬件加速 Castagnoli CRC32C (attributes 开始)
        byte[] fullBytes = bw.ToBytes();
        int crcDataLen = totalLen - crcStartOffset;
        int crcVal = NativeMemory.Crc32C((nint)fullBytes + (nint)crcStartOffset, crcDataLen);
        bw.PatchInt32(crcOffset, crcVal);

        return bw.ToBytes();
    }

    // 从二进制字节流解析 RecordBatch 并提取所有消息
    public static List<KafkaRecord> ParseRecordBatch(byte[] data, int offset, int length) {
        List<KafkaRecord> list = new List<KafkaRecord>();
        if (data == null || length < 61) { return list; } // 最小 RecordBatch 头部长度 61 字节
        KafkaReader r = new KafkaReader(data, offset, length);

        long baseOffset = r.ReadInt64();
        int batchLen = r.ReadInt32();
        if (batchLen <= 0 || r.Remaining() < batchLen) { return list; }

        int partitionLeaderEpoch = r.ReadInt32();
        int magic = r.ReadInt8();
        if (magic != KafkaConstants.RECORD_BATCH_MAGIC) { return list; }

        int crc = r.ReadInt32();
        int attr = r.ReadInt16();
        int lastOffsetDelta = r.ReadInt32();
        long firstTs = r.ReadInt64();
        long maxTs = r.ReadInt64();
        long producerId = r.ReadInt64();
        int producerEpoch = r.ReadInt16();
        int baseSeq = r.ReadInt32();

        int recordsCount = r.ReadInt32();
        for (int i = 0; i < recordsCount && r.Remaining() > 0; i = i + 1) {
            KafkaRecord rec = KafkaRecord.DecodeRecord(r, baseOffset, firstTs);
            if (rec != null) {
                list.Add(rec);
            }
        }
        return list;
    }
}
