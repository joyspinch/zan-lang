using System;

namespace Messaging.Kafka;

// Kafka Broker 节点元数据模型
public class KafkaBroker {
    public int nodeId;
    public string host;
    public int port;

    public KafkaBroker(int nodeId, string host, int port) {
        this.nodeId = nodeId;
        this.host = host;
        this.port = port;
    }
}

// Kafka 分区元数据模型
public class PartitionMetadata {
    public int partitionId;
    public int leaderId;
    public int errorCode;
    public List<int> replicas;
    public List<int> isr;

    public PartitionMetadata(int partitionId, int leaderId, int errorCode) {
        this.partitionId = partitionId;
        this.leaderId = leaderId;
        this.errorCode = errorCode;
        this.replicas = new List<int>();
        this.isr = new List<int>();
    }
}

// Kafka 主题元数据模型
public class TopicMetadata {
    public string name;
    public int errorCode;
    public List<PartitionMetadata> partitions;

    public TopicMetadata(string name, int errorCode) {
        this.name = name;
        this.errorCode = errorCode;
        this.partitions = new List<PartitionMetadata>();
    }
}
