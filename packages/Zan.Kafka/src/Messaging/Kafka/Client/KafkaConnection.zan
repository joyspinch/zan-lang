using System;
using System.Collections.Generic;
using System.Interop;
using System.Net.Sockets;
using System.Threading;

namespace Messaging.Kafka;

// Kafka 底层物理连接管理器 (管理套接字 I/O、二进制封包解包与关联 ID 多路复用)
public class KafkaConnection {
    public string host;
    public int port;
    public string clientId;
    private nint sock;
    private bool connected;
    private int nextCorrelationId;
    // 协程安全 I/O 门锁（lock(this)+Queue<AsyncGate>，零 OS Mutex 销毁竞态与泄漏）。
    private bool ioBusy;
    private Queue<AsyncGate> ioWaiters;

    public KafkaConnection(string host, int port) {
        this.host = host;
        this.port = port;
        this.clientId = "zan-kafka-client";
        this.sock = -1;
        this.connected = false;
        this.nextCorrelationId = 1;
        this.ioBusy = false;
        this.ioWaiters = new Queue<AsyncGate>();
    }

    public static async KafkaConnection ConnectAsync(string host, int port) {
        KafkaConnection conn = new KafkaConnection(host, port);
        Socket.Initialize();
        TcpClient client = await TcpClient.ConnectAsync(host, port);
        if (client == null) {
            return null;
        }
        nint s = client.GetSocket();
        if (s < 0) {
            return null;
        }
        Socket.SetNoDelay(s);
        conn.sock = s;
        conn.connected = true;
        return conn;
    }

    public bool IsConnected() {
        return this.connected && this.sock >= 0;
    }

    private async bool AcquireIoLockAsync() {
        while (true) {
            AsyncGate gate = null;
            lock (this) {
                if (!this.connected || this.sock < 0) { return false; }
                if (!this.ioBusy) {
                    this.ioBusy = true;
                    return true;
                }
                gate = new AsyncGate();
                this.ioWaiters.Enqueue(gate);
            }
            try {
                await gate.Wait();
            } finally {
                gate.Close();
            }
        }
    }

    private void ReleaseIoLock() {
        AsyncGate next = null;
        lock (this) {
            this.ioBusy = false;
            if (this.ioWaiters != null && this.ioWaiters.Count() > 0) {
                next = this.ioWaiters.Dequeue();
            }
        }
        if (next != null) { next.Signal(); }
    }

    // 发送标准 Kafka 请求并同步等待响应
    public async KafkaReader SendRequestAsync(int apiKey, int apiVersion, byte[] bodyPayload) {
        if (!this.connected || this.sock < 0) { return null; }
        if (!await this.AcquireIoLockAsync()) { return null; }
        try {
            if (!this.connected || this.sock < 0) { return null; }
            int cid = this.nextCorrelationId;
            this.nextCorrelationId = this.nextCorrelationId + 1;

            // 1. 构造请求头 (Request Header v1)
            KafkaWriter hw = new KafkaWriter(32);
            hw.WriteInt16(apiKey);
            hw.WriteInt16(apiVersion);
            hw.WriteInt32(cid);
            hw.WriteString(this.clientId);
            byte[] hdrBytes = hw.ToBytes();

            int bodyLen = bodyPayload != null ? bodyPayload.Length : 0;
            if (bodyLen < 0 || (long)hdrBytes.Length + (long)bodyLen > 67108864L) {
                return null;
            }
            int totalMsgLen = hdrBytes.Length + bodyLen;

            // 2. 发送 4 字节大端总长度 + Header + Body
            KafkaWriter pkt = new KafkaWriter(4 + totalMsgLen);
            pkt.WriteInt32(totalMsgLen);
            pkt.WriteRaw(hdrBytes, hdrBytes.Length);
            if (bodyLen > 0) {
                pkt.WriteRaw(bodyPayload, bodyLen);
            }
            byte[] rawPkt = pkt.ToBytes();
            int sent = await Socket.SendAsync(this.sock, rawPkt, rawPkt.Length);
            if (sent < rawPkt.Length) {
                this.Shutdown();
                return null;
            }

            // 3. 读取 4 字节响应总长度
            byte[] lenBuf = new byte[4];
            int rLen = await this.ReadExactAsync(lenBuf, 4);
            if (rLen < 4) {
                this.Shutdown();
                return null;
            }
            int respLen = ((int)lenBuf[0] << 24) | (((int)lenBuf[1] & 255) << 16) |
                          (((int)lenBuf[2] & 255) << 8) | ((int)lenBuf[3] & 255);
            if (respLen < 4 || respLen > 67108864) { // 至少含 4 字节 correlation_id，防御性上限 64MB
                this.Shutdown();
                return null;
            }

            // 4. 读取完整的响应内容体
            byte[] respBuf = new byte[respLen];
            int rBody = await this.ReadExactAsync(respBuf, respLen);
            if (rBody < respLen) {
                this.Shutdown();
                return null;
            }

            // 5. 解析 Response Header (读取 correlation_id 并校验匹配)
            KafkaReader r = new KafkaReader(respBuf);
            int respCid = r.ReadInt32();
            if (respCid != cid) {
                // 关联 ID 不匹配说明连接流已失步，必须主动断开重建。
                this.Shutdown();
                return null;
            }

            return r;
        } finally {
            this.ReleaseIoLock();
        }
    }

    private async int ReadExactAsync(byte[] outBuf, int count) {
        if (outBuf == null || count <= 0) { return 0; }
        int received = 0;
        while (received < count && this.connected) {
            nint s = this.sock;
            if (s < 0) { return -1; }
            int n = await Socket.RecvPtrAsync(s, (nint)outBuf + (nint)received, count - received);
            if (n <= 0) { return -1; }
            received = received + n;
        }
        return received;
    }

    void Shutdown() {
        // 统一走 Close() 以唤醒所有排队在 ioWaiters 上的协程，防止永久挂起。
        this.Close();
    }

    public void Close() {
        nint s = -1;
        List<AsyncGate> toWake = null;
        lock (this) {
            this.connected = false;
            s = this.sock;
            this.sock = -1;
            if (this.ioWaiters != null && this.ioWaiters.Count() > 0) {
                toWake = new List<AsyncGate>();
                while (this.ioWaiters.Count() > 0) {
                    toWake.Add(this.ioWaiters.Dequeue());
                }
            }
        }
        if (s >= 0) {
            Socket.ShutdownBoth(s);
            Socket.Close(s);
        }
        if (toWake != null) {
            for (int i = 0; i < toWake.Count; i = i + 1) {
                toWake[i].Signal();
            }
        }
    }

    public void Dispose() {
        this.Close();
    }
}
