using System;
using System.Collections.Generic;

namespace Game.Arpg;

// 常用字段断言助手：失败时向 diagnostics 记错误。
public class ArpgValidation {
    // 必填字符串校验：为 null 或空串时记录错误并返回 false，
    // 否则返回 true。
    public static bool Required(
        ArpgDiagnostics diagnostics,
        string newValue,
        string path,
        string code
    ) {
        if (newValue == null || newValue == "") {
            diagnostics.AddError(code, path, "Value is required.");
            return false;
        }
        return true;
    }

    // 正数校验：newValue ≤ 0 时记录错误并返回 false。
    public static bool Positive(
        ArpgDiagnostics diagnostics,
        int newValue,
        string path,
        string code
    ) {
        if (newValue <= 0) {
            diagnostics.AddError(code, path, "Value must be greater than zero.");
            return false;
        }
        return true;
    }
}
