using System;
using System.Collections.Generic;

namespace Game.Arpg;

// 逻辑坐标下的轴对齐矩形（x,y 为左上角）。
public class ArpgRect {
    public double x;
    public double y;
    public double width;
    public double height;

    // 构造矩形。
    public ArpgRect(double x, double y, double width, double height) {
        this.x = x;
        this.y = y;
        this.width = width;
        this.height = height;
    }

    // 左上角 X。
    public double X() { return this.x; }
    // 左上角 Y。
    public double Y() { return this.y; }
    // 宽度。
    public double Width() { return this.width; }
    // 高度。
    public double Height() { return this.height; }
}
