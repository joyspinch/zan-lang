using System;
using System.Collections.Generic;

namespace Game.Arpg;

// 缓动时间线：按序执行的步骤链（引擎.创建缓动 产生，Add 链式
// 追加步骤）。运行时由引擎驱动各步骤，call 步骤按回调 id 触发
// 注册的回调。
public class ArpgTween : IDisposable {
    public List<ArpgTweenStep> steps;

    // 构造空时间线（一般经引擎工厂创建）。
    public ArpgTween() {
        this.steps = new List<ArpgTweenStep>();
    }

    // 追加一个步骤并返回 this（链式）。
    public ArpgTween Add(ArpgTweenStep step) { this.steps.Add(step); return this; }
    // 步骤总数。
    public int StepCount() { return this.steps.Count; }
    // 第 index 个步骤；越界返回 null。
    public ArpgTweenStep StepAt(int index) {
        if (index < 0 || index >= this.steps.Count) { return null; }
        return this.steps[index];
    }

    // 所有步骤的调度总时长（毫秒）。
    public int TotalDuration() {
        int total = 0;
        for (int i = 0; i < this.steps.Count; i = i + 1) {
            ArpgTweenStep s = this.steps[i];
            total = total + s.Duration();
        }
        return total;
    }

    // 释放全部步骤（之后不应再使用本时间线）。
    public void Dispose() {
        for (int i = 0; i < this.steps.Count; i = i + 1) {
            this.steps[i].Dispose();
        }
        this.steps.Clear();
        this.steps = null;
    }
}
