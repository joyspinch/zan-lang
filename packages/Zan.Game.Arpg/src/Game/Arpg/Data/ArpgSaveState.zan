using System;

namespace Game.Arpg.Data;

// 渲染器无关的存档快照。应用可用自己偏好的 JSON、数据库
// 或二进制层序列化此对象。
public class ArpgSaveState : IDisposable {
    public string mapName;
    public int heroX;
    public int heroY;
    public int heroDirection;
    public int heroLevel;
    public int heroHp;
    public int heroMp;
    public int heroExperience;
    public int heroRage;
    public List<ArpgSaveItem> items;
    public List<ArpgSaveEquipment> equipment;
    public List<ArpgSaveSkill> skills;
    public List<ArpgSaveBuff> buffs;

    public ArpgSaveState(
        string mapName,
        int heroX,
        int heroY,
        int heroDirection,
        int heroLevel,
        int heroHp,
        int heroMp
    ) {
        this.mapName = mapName;
        this.heroX = heroX;
        this.heroY = heroY;
        this.heroDirection = heroDirection;
        this.heroLevel = heroLevel;
        this.heroHp = heroHp;
        this.heroMp = heroMp;
        this.heroExperience = 0;
        this.heroRage = 0;
        this.items = new List<ArpgSaveItem>();
        this.equipment = new List<ArpgSaveEquipment>();
        this.skills = new List<ArpgSaveSkill>();
        this.buffs = new List<ArpgSaveBuff>();
    }

    // 以下修改器均返回 this，便于链式构建一个快照：
    // 一次性写入经验与怒气，返回 this。
    public ArpgSaveState SetProgress(int experience, int rage) {
        this.heroExperience = experience;
        this.heroRage = rage;
        return this;
    }
    // 追加一个背包条目；name 为空串或 quantity ≤ 0 时忽略，返回 this。
    public ArpgSaveState AddItem(string name, int quantity) {
        if (name != "" && quantity > 0) {
            this.items.Add(new ArpgSaveItem(name, quantity));
        }
        return this;
    }
    // 追加一件已装备物品；slot 或 itemName 为空串时忽略，返回 this。
    public ArpgSaveState AddEquipment(string slot, string itemName) {
        if (slot != "" && itemName != "") {
            this.equipment.Add(new ArpgSaveEquipment(slot, itemName));
        }
        return this;
    }
    // 追加一个已学技能；name 为空串时忽略，返回 this。
    public ArpgSaveState AddSkill(string name) {
        if (name != "") { this.skills.Add(new ArpgSaveSkill(name)); }
        return this;
    }
    // 追加一个生效中的增益；name 为空串时忽略，remaining 为剩余
    // 毫秒数，返回 this。
    public ArpgSaveState AddBuff(string name, int remaining) {
        if (name != "") { this.buffs.Add(new ArpgSaveBuff(name, remaining)); }
        return this;
    }

    // 存档所在地图名。
    public string MapName() { return this.mapName; }
    // 主角所在格 X。
    public int HeroX() { return this.heroX; }
    // 主角所在格 Y。
    public int HeroY() { return this.heroY; }
    // 主角朝向（-1 或 0~7）。
    public int HeroDirection() { return this.heroDirection; }
    // 主角等级。
    public int HeroLevel() { return this.heroLevel; }
    // 主角当前 HP。
    public int HeroHp() { return this.heroHp; }
    // 主角当前 MP。
    public int HeroMp() { return this.heroMp; }
    // 主角累计经验（构造时为 0，经 SetProgress 写入）。
    public int HeroExperience() { return this.heroExperience; }
    // 主角怒气（构造时为 0，经 SetProgress 写入）。
    public int HeroRage() { return this.heroRage; }
    // 背包条目数。
    public int ItemCount() { return this.items.Count; }
    // 第 index 个背包条目；越界行为由底层 List 决定（抛错）。
    public ArpgSaveItem ItemAt(int index) { return this.items[index]; }
    // 已装备条目数。
    public int EquipmentCount() { return this.equipment.Count; }
    // 第 index 个已装备条目；越界行为由底层 List 决定（抛错）。
    public ArpgSaveEquipment EquipmentAt(int index) { return this.equipment[index]; }
    // 已学技能数。
    public int SkillCount() { return this.skills.Count; }
    // 第 index 个已学技能；越界行为由底层 List 决定（抛错）。
    public ArpgSaveSkill SkillAt(int index) { return this.skills[index]; }
    // 生效中增益数。
    public int BuffCount() { return this.buffs.Count; }
    // 第 index 个生效中增益；越界行为由底层 List 决定（抛错）。
    public ArpgSaveBuff BuffAt(int index) { return this.buffs[index]; }

    // 释放四个条目列表（置 null）；此后不应再读取或序列化该快照。
    public void Dispose() {
        this.items = null;
        this.equipment = null;
        this.skills = null;
        this.buffs = null;
    }
}
