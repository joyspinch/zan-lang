using System;

namespace Game.Arpg.Data;

// 存档中的一个背包条目：物品名与数量。
public class ArpgSaveItem {
    public string name;
    public int quantity;

    public ArpgSaveItem(string name, int quantity) {
        this.name = name;
        this.quantity = quantity;
    }
    // 物品名。
    public string Name() { return this.name; }
    // 数量（恒 ≥ 1，AddItem 已过滤非正值）。
    public int Quantity() { return this.quantity; }
}
