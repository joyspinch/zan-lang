using System;

namespace Game.Arpg.Data;

// 存档中的一件已装备物品：装备槽名与物品名。
public class ArpgSaveEquipment {
    public string slot;
    public string itemName;

    public ArpgSaveEquipment(string slot, string itemName) {
        this.slot = slot;
        this.itemName = itemName;
    }
    // 装备槽名。
    public string Slot() { return this.slot; }
    // 装备的物品名。
    public string ItemName() { return this.itemName; }
}
