using System;

namespace Game.Arpg;

// 节点类型常量：返回节点 kind 字符串（ArpgNodeDefinition 的 kind
// 取值）。IsValid 判断任意字符串是否为受支持的节点类型。
public class ArpgNodeKind {
    // 文本节点类型。
    public static string Text() { return "text"; }
    // 艺术字节点类型（支持描边渲染）。
    public static string ArtText() { return "artText"; }
    // 静态图片节点类型。
    public static string Sprite() { return "sprite"; }
    // 矩形色块节点类型。
    public static string Rectangle() { return "rectangle"; }
    // 圆形节点类型（按 Radius 渲染，缺省取宽高的一半）。
    public static string Circle() { return "circle"; }
    // 帧动画节点类型（按 AddAnimationFrame 的帧序列播放）。
    public static string Animation() { return "animation"; }

    // 判断 kind 是否为受支持的节点类型字符串。
    public static bool IsValid(string kind) {
        return kind == Text()
            || kind == ArtText()
            || kind == Sprite()
            || kind == Rectangle()
            || kind == Circle()
            || kind == Animation();
    }
}
