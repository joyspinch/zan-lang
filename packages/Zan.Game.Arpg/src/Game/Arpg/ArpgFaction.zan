using System;
using System.Collections.Generic;

namespace Game.Arpg;

// 阵营字符串常量。战斗目标判定按 caster 与 target 的阵营比较；
// Any 通配任意阵营。
public class ArpgFaction {
    // 友方（与施法者同阵营）。
    public static string Friendly() { return "friendly"; }
    // 中立（独立阵营，与 friendly/hostile 均不同）。
    public static string Neutral() { return "neutral"; }
    // 敌方（与施法者不同阵营）。
    public static string Hostile() { return "hostile"; }
    // 任意阵营。
    public static string Any() { return "any"; }
}
