using System;

namespace Game.Arpg;

// 文档所述 App.lua 启动配置的类型化等价物。
public class ArpgConfig {
    public string title;
    public int width;
    public int height;
    public int frameRate;
    public bool verticalSync;
    public int screenMode;
    public bool repeatKeys;
    public string defaultFont;
    public ArpgColor background;

    public ArpgConfig() {
        this.title = "Zan Arpg";
        this.width = 1280;
        this.height = 720;
        this.frameRate = 60;
        this.verticalSync = false;
        this.screenMode = ArpgScreenMode.Scale();
        this.repeatKeys = false;
        this.defaultFont = "";
        this.background = ArpgColor.Black();
    }

    // 窗口标题，默认 "Zan Arpg"。
    public string Title() { return this.title; }
    // 窗口宽度（像素），默认 1280。
    public int Width() { return this.width; }
    // 窗口高度（像素），默认 720。
    public int Height() { return this.height; }
    // 目标帧率（FPS），默认 60。
    public int FrameRate() { return this.frameRate; }
    // 是否开启垂直同步（开启时 frameRate 被忽略），默认 false。
    public bool VerticalSync() { return this.verticalSync; }
    // 屏幕模式（ArpgScreenMode 常量 0~3，默认 Scale）。
    public int ScreenMode() { return this.screenMode; }
    // 是否开启按键连发（开启时 OnKeyDown 连发也触发），默认 false。
    public bool RepeatKeys() { return this.repeatKeys; }
    // 默认字体资源 Id，空串表示用内置字体。
    public string DefaultFont() { return this.defaultFont; }
    // 背景色（默认黑色；透明无边框模式下作为 RGB 抠色键）。
    public ArpgColor Background() { return this.background; }
    // 背景色红分量（0~255）。
    public int BackgroundRed() { return this.background.Red(); }
    // 背景色绿分量（0~255）。
    public int BackgroundGreen() { return this.background.Green(); }
    // 背景色蓝分量（0~255）。
    public int BackgroundBlue() { return this.background.Blue(); }
    // 背景色 Alpha（0~255，0 全透明）。
    public int BackgroundAlpha() { return this.background.Alpha(); }

    // 设置窗口标题。
    public void SetTitle(string newTitle) { this.title = newTitle; }
    // 一次性设置窗口尺寸（像素）。
    public void SetSize(int width, int height) {
        this.width = width;
        this.height = height;
    }
    // 设置目标帧率（FPS）。
    public void SetFrameRate(int framesPerSecond) { this.frameRate = framesPerSecond; }
    // 设置是否开启垂直同步。
    public void SetVerticalSync(bool enabled) { this.verticalSync = enabled; }
    // 设置屏幕模式（ArpgScreenMode 常量）。
    public void SetScreenMode(int mode) { this.screenMode = mode; }
    // 设置是否开启按键连发。
    public void SetRepeatKeys(bool enabled) { this.repeatKeys = enabled; }
    // 设置默认字体资源 Id。
    public void SetDefaultFont(string resourceId) { this.defaultFont = resourceId; }
    // 一次性设置背景色 RGBA（各分量 0~255）。
    public void SetBackground(int red, int green, int blue, int alpha) {
        this.background = new ArpgColor(red, green, blue, alpha);
    }

    // 校验启动配置，返回新诊断对象（错误码 L2APP001~L2APP006）。
    // 透明无边框模式下背景 Alpha 为 0 只给警告（抠色键不可见），
    // 其余为错误。应在启动前调用并检查。
    public ArpgDiagnostics Validate() {
        ArpgDiagnostics diagnostics = new ArpgDiagnostics();
        ArpgValidation.Required(
            diagnostics, this.title, "app.title", "L2APP001");
        ArpgValidation.Positive(
            diagnostics, this.width, "app.width", "L2APP002");
        ArpgValidation.Positive(
            diagnostics, this.height, "app.height", "L2APP003");
        ArpgValidation.Positive(
            diagnostics, this.frameRate, "app.frameRate", "L2APP004");
        if (!ArpgScreenMode.IsValid(this.screenMode)) {
            diagnostics.AddError(
                "L2APP005", "app.screenMode", "Screen mode must be between 0 and 3.");
        }
        if (this.screenMode == ArpgScreenMode.TransparentBorderless()
            && this.background.Alpha() == 0) {
            diagnostics.AddWarning(
                "L2APP006",
                "app.background",
                "Transparent borderless mode needs a visible RGB key color.");
        }
        return diagnostics;
    }
}
