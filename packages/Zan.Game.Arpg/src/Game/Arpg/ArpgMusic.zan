using System;

namespace Game.Arpg;

// 音乐播放状态：由 Play/Pause/Stop 驱动，音频适配器据此
// 控制原生混音器。
public class ArpgMusic : IDisposable {
    public string resource;
    public double volume;
    public double pitch;
    public int channel;
    public int length;
    public bool loop;
    public MusicState state;

    public ArpgMusic(string resource) {
        this.resource = resource;
        this.volume = 1.0;
        this.pitch = 1.0;
        this.channel = -1;
        this.length = 0;
        this.loop = false;
        this.state = MusicState.Stopped;
    }
    // 设置音量（1.0 为默认，取值范围由音频适配器解释），返回 this。
    public ArpgMusic SetVolume(double volume) {
        this.volume = volume;
        return this;
    }
    // 设置音调/速度倍率（1.0 为原速），返回 this。
    public ArpgMusic SetPitch(double pitch) {
        this.pitch = pitch;
        return this;
    }
    // 设置混音通道（默认 -1，语义由音频适配器解释），返回 this。
    public ArpgMusic SetChannel(int channel) {
        this.channel = channel;
        return this;
    }
    // 设置是否循环播放，返回 this。
    public ArpgMusic SetLoop(bool loop) {
        this.loop = loop;
        return this;
    }
    // 开始播放：状态无条件置为 Playing（含从 Paused 恢复）。
    public void Play() { this.state = MusicState.Playing; }
    // 暂停播放；仅当前为 Playing 时转入 Paused，其余状态无操作。
    public void Pause() {
        if (this.state == MusicState.Playing) {
            this.state = MusicState.Paused;
        }
    }
    // 停止播放：状态无条件回到 Stopped。
    public void Stop() { this.state = MusicState.Stopped; }
    // 音乐资源路径。
    public string Resource() { return this.resource; }
    // 音量（默认 1.0）。
    public double Volume() { return this.volume; }
    // 音调/速度倍率（默认 1.0）。
    public double Pitch() { return this.pitch; }
    // 混音通道（默认 -1）。
    public int Channel() { return this.channel; }
    // 音频长度（毫秒）；本类不维护（恒为构造初值 0），语义由适配器/调用方定义。
    public int Length() { return this.length; }
    // 是否循环播放。
    public bool Loop() { return this.loop; }
    // 当前播放状态（MusicState 之一，初始 Stopped）。
    public MusicState State() { return this.state; }

    // 释放资源路径引用（置 null）；此后不应再使用该对象。
    public void Dispose() {
        this.resource = null;
    }
}
