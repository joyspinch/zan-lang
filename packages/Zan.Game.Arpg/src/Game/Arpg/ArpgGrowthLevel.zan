using System;
using System.Collections.Generic;

namespace Game.Arpg;

// 成长曲线中的单级条目：某一等级对应的完整属性快照。由
// ArpgGrowthDefinition.AddLevel 创建，业务经 AttributesFor 查询。
public class ArpgGrowthLevel {
    public int level;
    public ArpgAttributes attributes;

    public ArpgGrowthLevel(int level, ArpgAttributes attributes) {
        this.level = level;
        this.attributes = attributes;
    }

    // 返回该条目对应的等级（正整数）。
    public int Level() { return this.level; }
    // 返回该等级的属性快照（共享引用，勿就地修改）。
    public ArpgAttributes Attributes() { return this.attributes; }
}
