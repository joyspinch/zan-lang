using System;
using System.Collections.Generic;

namespace Game.Arpg;

// 类型化菜单：菜单名 + 按序排列的菜单项集合。AddItem 按项名
// upsert（同名覆盖），渲染适配器可消费同一菜单状态。
public class ArpgMenu : IDisposable {
    public string name;
    public List<ArpgMenuItem> items;

    // 构造空菜单。
    public ArpgMenu(string name) {
        this.name = name;
        this.items = new List<ArpgMenuItem>();
    }

    // 菜单名（同一运行时内的唯一键）。
    public string Name() { return this.name; }
    // 追加或按名称覆盖菜单项（item 为 null 忽略），返回 this。
    public ArpgMenu AddItem(ArpgMenuItem item) {
        if (item == null) { return this; }
        int index = this.IndexOf(item.Name());
        if (index < 0) { this.items.Add(item); }
        else { this.items[index] = item; }
        return this;
    }
    // 按项名查找索引；未找到返回 -1。
    public int IndexOf(string itemName) {
        for (int i = 0; i < this.items.Count; i = i + 1) {
            if (this.items[i].Name() == itemName) { return i; }
        }
        return -1;
    }
    // 按项名查找菜单项；未找到返回 null。
    public ArpgMenuItem FindItem(string itemName) {
        int index = this.IndexOf(itemName);
        if (index < 0) { return null; }
        return this.items[index];
    }
    // 菜单项数量。
    public int ItemCount() { return this.items.Count; }
    // 第 index 个菜单项（不查越界）。
    public ArpgMenuItem ItemAt(int index) { return this.items[index]; }

    // 释放菜单项集合（之后不应再使用本菜单）。
    public void Dispose() {
        this.items.Clear();
        this.items = null;
        this.name = null;
    }
}
