namespace Game.Arpg;

// ArpgValue 的类型标签常量：0=Null 1=Text 2=Number
// 3=Boolean 4=Object。配合 Kind() 使用。
public class ArpgValueKind {
    // Null 值类型标签（0）。
    public static int Null() { return 0; }
    // 文本值类型标签（1）。
    public static int Text() { return 1; }
    // 数值值类型标签（2）。
    public static int Number() { return 2; }
    // 布尔值类型标签（3）。
    public static int Boolean() { return 3; }
    // 对象（属性容器）类型标签（4）。
    public static int Object() { return 4; }
}
