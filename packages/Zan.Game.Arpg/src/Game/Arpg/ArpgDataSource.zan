namespace Game.Arpg;

// 每帧由游戏 UI 模板求值的可变 key/newValue 数据源。
public class ArpgDataSource {
    public ArpgValue root;
    public int revision;

    public ArpgDataSource() {
        this.root = ArpgValue.Object();
        this.revision = 0;
    }

    // 返回数据根对象（恒为 Object 形态）。
    public ArpgValue Root() { return this.root; }
    // 修改计数：每次 Set（含各类型便捷封装）自增 1，供模板
    // 缓存/重绘判断是否失效。
    public int Revision() { return this.revision; }

    // 写入根对象上的点分路径并令 Revision() 自增。
    public void Set(string path, ArpgValue newValue) {
        this.root.SetPath(path, newValue);
        this.revision = this.revision + 1;
    }

    // 写入文本值到点分路径（等价 Set(path, Text(...))）。
    public void SetText(string path, string newValue) {
        this.Set(path, ArpgValue.Text(newValue));
    }

    // 写入数值到点分路径。
    public void SetNumber(string path, double newValue) {
        this.Set(path, ArpgValue.Number(newValue));
    }

    // 写入整数值到点分路径。
    public void SetInteger(string path, int newValue) {
        this.Set(path, ArpgValue.Integer(newValue));
    }

    // 写入布尔值到点分路径。
    public void SetBoolean(string path, bool newValue) {
        this.Set(path, ArpgValue.Boolean(newValue));
    }

    // 在根对象上按点分路径取值；路径缺失返回 null。
    public ArpgValue Resolve(string path) { return this.root.Resolve(path); }
}
