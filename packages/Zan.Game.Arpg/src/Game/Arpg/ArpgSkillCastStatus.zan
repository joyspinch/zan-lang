using System;

namespace Game.Arpg;

// 技能施放状态码：ArpgSkillCastResult.Status 的取值，0 为成功，
// 其余为各类失败原因。
public class ArpgSkillCastStatus {
    // 施放成功（常量 0）。
    public static int Success() { return 0; }
    // 技能 Id 不存在（常量 1）。
    public static int UnknownSkill() { return 1; }
    // 施法者未学会该技能（常量 2）。
    public static int NotLearned() { return 2; }
    // 施法者已死亡（常量 3）。
    public static int CasterDead() { return 3; }
    // 技能处于冷却中（常量 4）。
    public static int Cooldown() { return 4; }
    // HP/MP/怒气消耗不足（常量 5）。
    public static int InsufficientResources() { return 5; }
    // 目标超出射程（切比雪夫距离判定，常量 6）。
    public static int OutOfRange() { return 6; }
    // 目标无效（如 null 或阵营不符，常量 7）。
    public static int InvalidTarget() { return 7; }
}
