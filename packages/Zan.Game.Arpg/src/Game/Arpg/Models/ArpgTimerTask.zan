using System;

namespace Game.Arpg;

// 单个定时任务：名称、载荷、触发间隔、累计时间、
// 一次性标志与回调。用单个实体代替六个平行列表。
public class ArpgTimerTask {
    // 任务名（同一调度器内唯一，重名 Add 会先移除旧任务）。
    public string name;
    // 透传给回调的不透明载荷。
    public string payload;
    // 触发间隔毫秒（构造时钳制到 ≥1）。
    public int interval;
    // 已累计的毫秒数（Tick 累加，触发后扣掉一个间隔）。
    public int elapsed;
    // 是否一次性（触发后自动移除）。
    public bool oneShot;
    public ArpgTimedEvent handler;

    // 构造任务；interval 由 Add 钳制，elapsed 从 0 起。
    public ArpgTimerTask(string name, string payload, int interval, bool oneShot,
                  ArpgTimedEvent handler) {
        this.name = name;
        this.payload = payload;
        this.interval = interval;
        this.elapsed = 0;
        this.oneShot = oneShot;
        this.handler = handler;
    }
}
