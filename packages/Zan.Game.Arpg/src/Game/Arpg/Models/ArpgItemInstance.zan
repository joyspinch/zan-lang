namespace Game.Arpg;

// 背包内单个格子的实例：物品定义 + 当前堆叠数量。
public class ArpgItemInstance {
    public ArpgItemDefinition definition;
    public int quantity;

    // 构造一个格子实例。
    public ArpgItemInstance(
        ArpgItemDefinition definition,
        int quantity
    ) {
        this.definition = definition;
        this.quantity = quantity;
    }

    // 物品定义。
    public ArpgItemDefinition Definition() { return this.definition; }
    // 当前堆叠数量。
    public int Quantity() { return this.quantity; }
    // 数量是否已耗尽（≤0）。
    public bool IsEmpty() { return this.quantity <= 0; }

    // 增加数量，受 MaxStack 上限约束，返回实际增加数
    // （count ≤ 0 返回 0，可部分加入）。
    public int Add(int count) {
        if (count <= 0) { return 0; }
        int room = this.definition.MaxStack() - this.quantity;
        int added = count;
        if (added > room) { added = room; }
        this.quantity = this.quantity + added;
        return added;
    }

    // 移除数量，最多移除到 0，返回实际移除数
    // （count ≤ 0 返回 0，可部分移除）。
    public int Remove(int count) {
        if (count <= 0) { return 0; }
        int removed = count;
        if (removed > this.quantity) { removed = this.quantity; }
        this.quantity = this.quantity - removed;
        return removed;
    }
}
