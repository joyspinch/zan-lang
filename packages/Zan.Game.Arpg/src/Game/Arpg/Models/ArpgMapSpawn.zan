namespace Game.Arpg;

// 刷怪点定义：在 (gridX, gridY) 附近 range 格范围内刷 count 只
// 指定阵营/等级的怪物。respawnMilliseconds 为 -1 表示不重生。
public class ArpgMapSpawn {
    public string actorId;
    public string faction;
    public int gridX;
    public int gridY;
    public int range;
    public int count;
    public int level;
    public int direction;
    public int respawnMilliseconds;

    public ArpgMapSpawn(
        string actorId,
        string faction,
        int gridX,
        int gridY,
        int count
    ) {
        this.actorId = actorId;
        this.faction = faction;
        this.gridX = gridX;
        this.gridY = gridY;
        this.range = 0;
        this.count = count;
        this.level = 1;
        this.direction = -1;
        this.respawnMilliseconds = -1;
    }

    // 刷出的角色定义 Id。
    public string ActorId() { return this.actorId; }
    // 刷出角色的阵营。
    public string Faction() { return this.faction; }
    // 刷怪中心格 X。
    public int GridX() { return this.gridX; }
    // 刷怪中心格 Y。
    public int GridY() { return this.gridY; }
    // 随机散布半径（格），默认 0 表示固定在中心点。
    public int Range() { return this.range; }
    // 刷出数量。
    public int Count() { return this.count; }
    // 刷出等级，默认 1。
    public int Level() { return this.level; }
    // 初始朝向（-1 或 0~7），默认 -1 表示未定向。
    public int Direction() { return this.direction; }
    // 重生间隔（毫秒），默认 -1 表示不重生。
    public int RespawnMilliseconds() { return this.respawnMilliseconds; }
    // 设置随机散布半径（格）。
    public void SetRange(int newValue) { this.range = newValue; }
    // 设置刷出等级。
    public void SetLevel(int newValue) { this.level = newValue; }
    // 设置初始朝向（-1 或 0~7）。
    public void SetDirection(int newValue) { this.direction = newValue; }
    // 设置重生间隔（毫秒）；-1 表示不重生。
    public void SetRespawnMilliseconds(int newValue) { this.respawnMilliseconds = newValue; }
}
