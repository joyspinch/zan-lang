namespace Game.Arpg;

// 应用菜单中的单个菜单项：名称（唯一键）、标题、自定义载荷与
// 可见/启用/选中三个状态位。构造时默认可见且启用、未选中；
// Set* 修饰器均返回 this，可链式配置。项被激活时 Payload 随
// ArpgEvents 的 MenuChanged 回调上抛。
public class ArpgMenuItem {
    public string name;
    public string title;
    public string payload;
    public bool visible;
    public bool enabled;
    public bool marked;

    // 构造菜单项；visible/enabled 默认 true，marked 默认 false。
    public ArpgMenuItem(string name, string title, string payload) {
        this.name = name;
        this.title = title;
        this.payload = payload;
        this.visible = true;
        this.enabled = true;
        this.marked = false;
    }

    // 菜单项名（同一菜单内的唯一键）。
    public string Name() { return this.name; }
    // 显示标题。
    public string Title() { return this.title; }
    // 激活时随菜单事件上抛的自定义载荷。
    public string Payload() { return this.payload; }
    // 是否可见（不可见项不会被分派激活）。
    public bool Visible() { return this.visible; }
    // 是否启用（禁用项不会被分派激活）。
    public bool Enabled() { return this.enabled; }
    // 是否带选中标记。
    public bool Marked() { return this.marked; }
    // 设置标题并返回 this（链式）。
    public ArpgMenuItem SetTitle(string title) {
        this.title = title;
        return this;
    }
    // 设置载荷并返回 this（链式）。
    public ArpgMenuItem SetPayload(string payload) {
        this.payload = payload;
        return this;
    }
    // 设置可见性并返回 this（链式）。
    public ArpgMenuItem SetVisible(bool visible) {
        this.visible = visible;
        return this;
    }
    // 设置启用状态并返回 this（链式）。
    public ArpgMenuItem SetEnabled(bool enabled) {
        this.enabled = enabled;
        return this;
    }
    // 设置选中标记并返回 this（链式）。
    public ArpgMenuItem SetMarked(bool marked) {
        this.marked = marked;
        return this;
    }
}
