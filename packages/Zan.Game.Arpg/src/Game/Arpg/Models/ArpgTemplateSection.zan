namespace Game.Arpg;

// 模板解析出的一个连续文本段：内容、终止标记与
// 终止分支（{elseif}）携带的条件表达式。
public class ArpgTemplateSection {
    public string text;
    public int terminator;
    public string condition;

    // 构造一个文本段。
    public ArpgTemplateSection(
        string text,
        int terminator,
        string condition
    ) {
        this.text = text;
        this.terminator = terminator;
        this.condition = condition;
    }

    // 段文本内容。
    public string Text() { return this.text; }
    // 终止标记（ArpgTemplateTerminator 常量之一）。
    public int Terminator() { return this.terminator; }
    // {elseif} 分支携带的条件表达式；非 elseif 段为空串。
    public string Condition() { return this.condition; }
}
