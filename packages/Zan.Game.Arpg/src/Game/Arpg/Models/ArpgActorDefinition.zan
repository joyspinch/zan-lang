using System;

namespace Game.Arpg;

// 可复用的角色组件定义，对应一个角色文件。
public class ArpgActorDefinition {
    public string id;
    public string displayName;
    public bool defaultPlayer;
    public string faction;
    public string growthId;
    public int level;
    public int experienceReward;
    public int attackInterval;
    public int moveInterval;
    public int direction;
    public int visionRange;
    public bool aggressive;
    public bool autoCombat;
    public int respawnMilliseconds;
    public ArpgAttributes attributes;
    public List<string> skills;
    public List<string> startingBuffs;

    public ArpgActorDefinition(string id, string displayName) {
        this.id = id;
        this.displayName = displayName;
        this.defaultPlayer = false;
        this.faction = ArpgFaction.Neutral();
        this.growthId = "";
        this.level = 1;
        this.experienceReward = 0;
        this.attackInterval = 3000;
        this.moveInterval = 1500;
        this.direction = 0;
        this.visionRange = 0;
        this.aggressive = false;
        this.autoCombat = false;
        this.respawnMilliseconds = -1;
        this.attributes = new ArpgAttributes();
        this.skills = new List<string>();
        this.startingBuffs = new List<string>();
    }

    // 角色定义 Id（配置键，创建后不变）。
    public string Id() { return this.id; }
    // 显示名（必填，用于 UI 展示）。
    public string DisplayName() { return this.displayName; }
    // 是否为默认玩家角色；项目应恰好标记一个，由 Project 校验。
    public bool DefaultPlayer() { return this.defaultPlayer; }
    // 阵营（ArpgFaction 常量，默认 Neutral）。
    public string Faction() { return this.faction; }
    // 绑定的成长曲线组件 Id（空串表示未配置；存在性由 Project 校验）。
    public string GrowthId() { return this.growthId; }
    // 等级，默认 1。
    public int Level() { return this.level; }
    // 该角色被击杀时奖励的经验值，默认 0。
    public int ExperienceReward() { return this.experienceReward; }
    // 普通攻击间隔（毫秒），默认 3000；为 0 时 Validate 给出警告。
    public int AttackInterval() { return this.attackInterval; }
    // 移动间隔（毫秒），默认 1500；为 0 时 Validate 给出警告。
    public int MoveInterval() { return this.moveInterval; }
    // 初始朝向（-1 或 0~7，-1 表示未定向），FromDefinition 时灌入实例。
    public int Direction() { return this.direction; }
    // 视野范围（格），默认 0 表示未配置。
    public int VisionRange() { return this.visionRange; }
    // 是否为主动攻击型（默认 false，仅攻击性 AI 使用）。
    public bool Aggressive() { return this.aggressive; }
    // 是否启用自动战斗（默认 false）。
    public bool AutoCombat() { return this.autoCombat; }
    // 重生间隔（毫秒），默认 -1 表示不重生。
    public int RespawnMilliseconds() { return this.respawnMilliseconds; }
    // 基础属性集合（只读视图，配置期通过其 Set* 修改；
    // FromDefinition 时以 AddFrom 灌入实例）。
    public ArpgAttributes Attributes() { return this.attributes; }

    // 设置显示名。
    public void SetDisplayName(string newValue) { this.displayName = newValue; }
    // 设置是否为默认玩家角色。
    public void SetDefaultPlayer(bool newValue) { this.defaultPlayer = newValue; }
    // 设置阵营（ArpgFaction 常量）。
    public void SetFaction(string newValue) { this.faction = newValue; }
    // 设置绑定的成长曲线组件 Id。
    public void SetGrowth(string newValue) { this.growthId = newValue; }
    // 设置等级。
    public void SetLevel(int newValue) { this.level = newValue; }
    // 设置被击杀时奖励的经验值。
    public void SetExperienceReward(int newValue) { this.experienceReward = newValue; }
    // 设置普通攻击间隔（毫秒）。
    public void SetAttackInterval(int newValue) { this.attackInterval = newValue; }
    // 设置移动间隔（毫秒）。
    public void SetMoveInterval(int newValue) { this.moveInterval = newValue; }
    // 设置初始朝向（-1 或 0~7）。
    public void SetDirection(int newValue) { this.direction = newValue; }
    // 设置视野范围（格）。
    public void SetVisionRange(int newValue) { this.visionRange = newValue; }
    // 设置是否为主动攻击型。
    public void SetAggressive(bool newValue) { this.aggressive = newValue; }
    // 设置是否启用自动战斗。
    public void SetAutoCombat(bool newValue) { this.autoCombat = newValue; }
    // 设置重生间隔（毫秒）；-1 表示不重生。
    public void SetRespawnMilliseconds(int newValue) { this.respawnMilliseconds = newValue; }
    // 追加一个初始技能 Id。
    public void AddSkill(string skillId) { this.skills.Add(skillId); }
    // 追加一个初始增益 Id（实例化时由 Project.ApplyStartingBuffs 施加）。
    public void AddStartingBuff(string buffId) { this.startingBuffs.Add(buffId); }
    // 初始技能数量。
    public int SkillCount() { return this.skills.Count; }
    // 按下标读取初始技能 Id；应配合 SkillCount 使用。
    public string SkillAt(int index) { return this.skills[index]; }
    // 初始增益数量。
    public int StartingBuffCount() { return this.startingBuffs.Count; }
    // 按下标读取初始增益 Id；应配合 StartingBuffCount 使用。
    public string StartingBuffAt(int index) { return this.startingBuffs[index]; }

    // 校验角色定义合法性，问题以 L2ACT001~L2ACT006 写入
    // diagnostics（必填缺失、level 非正、direction 越界为错误，
    // 攻击/移动间隔为 0 仅给警告）。应在配置加载完成后调用一次。
    public void Validate(ArpgDiagnostics diagnostics) {
        string path = "actors." + this.id;
        ArpgValidation.Required(diagnostics, this.id, "actors", "L2ACT001");
        ArpgValidation.Required(
            diagnostics, this.displayName, path + ".displayName", "L2ACT002");
        ArpgValidation.Positive(
            diagnostics, this.level, path + ".level", "L2ACT003");
        if (this.direction < -1 || this.direction > 7) {
            diagnostics.AddError(
                "L2ACT004", path + ".direction", "Direction must be -1 or 0 through 7.");
        }
        if (this.attackInterval == 0) {
            diagnostics.AddWarning(
                "L2ACT005",
                path + ".attackInterval",
                "Zero attack interval is usually unintended.");
        }
        if (this.moveInterval == 0) {
            diagnostics.AddWarning(
                "L2ACT006",
                path + ".moveInterval",
                "Zero move interval is usually unintended.");
        }
    }
}
