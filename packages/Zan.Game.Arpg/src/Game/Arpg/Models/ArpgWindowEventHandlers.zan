using System;

namespace Game.Arpg;

// 窗口事件单播槽位集合：每个槽位只保存一个 handler，后注册者覆盖
// 前者。经 ArpgWindowDefinition.Events() 获取；业务代码调用 On*
// 注册回调，框架在窗口生命周期与指针交互时触发 Raise*，不要手动
// 调用 Raise*。
public class ArpgWindowEventHandlers {
    public ArpgWindowCreated created;
    public ArpgWindowVisibilityChanged opened;
    public ArpgWindowVisibilityChanged closed;
    public ArpgWindowUpdated updated;
    public ArpgWindowPointerChanged pointerDown;
    public ArpgWindowPointerChanged pointerUp;
    public ArpgWindowPointerChanged pointerMove;
    public ArpgWindowCustomEvent customEvent;


    // 注册窗口实例化完成回调（全部控件实例化后触发一次）。
    public void OnCreated(ArpgWindowCreated handler) { this.created = handler; }
    // 注册窗口打开回调（Open 或初始可见时触发）。
    public void OnOpened(ArpgWindowVisibilityChanged handler) {
        this.opened = handler;
    }
    // 注册窗口关闭回调（Close 时触发一次）。
    public void OnClosed(ArpgWindowVisibilityChanged handler) {
        this.closed = handler;
    }
    // 注册窗口每帧更新回调（deltaMilliseconds 为帧间隔毫秒）。
    public void OnUpdated(ArpgWindowUpdated handler) { this.updated = handler; }
    // 注册窗口按下回调；返回 true 可消费事件。
    public void OnPointerDown(ArpgWindowPointerChanged handler) {
        this.pointerDown = handler;
    }
    // 注册窗口抬起回调；返回 true 可消费事件。
    public void OnPointerUp(ArpgWindowPointerChanged handler) {
        this.pointerUp = handler;
    }
    // 注册窗口移动回调；返回 true 可消费事件。
    public void OnPointerMove(ArpgWindowPointerChanged handler) {
        this.pointerMove = handler;
    }
    // 注册窗口自定义事件回调（由 FireCustom 触发）。
    public void OnCustomEvent(ArpgWindowCustomEvent handler) {
        this.customEvent = handler;
    }

    // 触发窗口实例化回调；未注册 handler 时为空操作。
    public void RaiseCreated(string windowId) {
        ArpgWindowCreated handler = this.created;
        if (handler != null) { handler(windowId); }
    }

    // 触发窗口打开回调；未注册 handler 时为空操作。
    public void RaiseOpened(string windowId) {
        ArpgWindowVisibilityChanged handler = this.opened;
        if (handler != null) { handler(windowId); }
    }

    // 触发窗口关闭回调；未注册 handler 时为空操作。
    public void RaiseClosed(string windowId) {
        ArpgWindowVisibilityChanged handler = this.closed;
        if (handler != null) { handler(windowId); }
    }

    // 触发窗口每帧更新回调；未注册 handler 时为空操作。
    public void RaiseUpdated(string windowId, int deltaMilliseconds) {
        ArpgWindowUpdated handler = this.updated;
        if (handler != null) { handler(windowId, deltaMilliseconds); }
    }

    // 触发窗口按下回调；未注册时返回 false（事件未消费）。
    public bool RaisePointerDown(
        string windowId,
        string controlId,
        int button,
        int modifiers,
        double x,
        double y
    ) {
        ArpgWindowPointerChanged handler = this.pointerDown;
        if (handler == null) { return false; }
        return handler(windowId, controlId, button, modifiers, x, y);
    }

    // 触发窗口抬起回调；未注册时返回 false（事件未消费）。
    public bool RaisePointerUp(
        string windowId,
        string controlId,
        int button,
        int modifiers,
        double x,
        double y
    ) {
        ArpgWindowPointerChanged handler = this.pointerUp;
        if (handler == null) { return false; }
        return handler(windowId, controlId, button, modifiers, x, y);
    }

    // 触发窗口移动回调；未注册时返回 false（事件未消费）。
    public bool RaisePointerMove(
        string windowId,
        string controlId,
        int button,
        int modifiers,
        double x,
        double y
    ) {
        ArpgWindowPointerChanged handler = this.pointerMove;
        if (handler == null) { return false; }
        return handler(windowId, controlId, button, modifiers, x, y);
    }

    // 触发窗口自定义事件回调；未注册 handler 时为空操作。
    public void RaiseCustom(string windowId, string name, string payload) {
        ArpgWindowCustomEvent handler = this.customEvent;
        if (handler != null) { handler(windowId, name, payload); }
    }
}
