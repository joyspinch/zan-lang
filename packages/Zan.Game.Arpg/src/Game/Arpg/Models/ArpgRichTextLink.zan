using System;
using System.Text;
using Gui;

namespace Game.Arpg;

// 富文本链接（#@标记@内容@ 语法中标记部分的类型化表示）。
// 标记格式为 "action|参数列表"：竖线前是链接动作文本，竖线后
// 可带逗号分隔的 1~4 个参数：样式编号、常态色、悬停色、按下色。
// 颜色参数支持 0xRRGGBBAA；未提供的颜色为全透明。
// 薄适配：解析与存取都委托 Gui.RichTextLink，颜色在边界换算成
// ArpgColor。
public class ArpgRichTextLink {
    Gui.RichTextLink inner;

    public ArpgRichTextLink(string marker) {
        this.inner = new Gui.RichTextLink(marker);
    }

    public ArpgRichTextLink(Gui.RichTextLink inner) {
        this.inner = inner;
    }

    // 内部 Gui 链接对象（适配层内部用）。
    Gui.RichTextLink Inner() { return this.inner; }

    // 链接动作原文（标记中竖线前的部分）。
    public string Raw() { return this.inner.Raw(); }
    // 动作参数个数（按逗号分隔；无参数为 0）。
    public int Count() { return this.inner.Count(); }
    // 第 index 个动作参数（两侧去空白）；越界返回空串。
    public string At(int index) { return this.inner.At(index); }
    // 样式编号（标记第 1 个参数，未提供为 0）。
    public int Style() { return this.inner.Style(); }
    // 常态颜色（未提供时为全透明）。
    public ArpgColor NormalColor() {
        return ArpgRichText.UnpackColor(this.inner.NormalColor());
    }
    // 悬停颜色（未提供时为全透明）。
    public ArpgColor HoverColor() {
        return ArpgRichText.UnpackColor(this.inner.HoverColor());
    }
    // 按下颜色（未提供时为全透明）。
    public ArpgColor PressedColor() {
        return ArpgRichText.UnpackColor(this.inner.PressedColor());
    }
}
