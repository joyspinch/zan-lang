using System;

namespace Game.Arpg;

// 单个类型化全局变量：名称、字符串编码的值与类型标签
// （0 = string，1 = int，2 = bool）。用单个实体代替平行列表。
public class GlobalEntry {
    public string key;
    public string val;
    public int kind;

    public GlobalEntry(string key, string val, int kind) {
        this.key = key;
        this.val = val;
        this.kind = kind;
    }
}
