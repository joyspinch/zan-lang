namespace Game.Arpg;

// 传送门定义：踩到 (gridX, gridY) 时切到 targetMapId 的
// (targetGridX, targetGridY)。id 由 SetId 指定后可用于事件定位。
public class ArpgMapPortal {
    public int gridX;
    public int gridY;
    public string targetMapId;
    public int targetGridX;
    public int targetGridY;
    public int targetDirection;
    public bool clearTargetMap;
    public int id;

    public ArpgMapPortal(
        int gridX,
        int gridY,
        string targetMapId,
        int targetGridX,
        int targetGridY
    ) {
        this.gridX = gridX;
        this.gridY = gridY;
        this.targetMapId = targetMapId;
        this.targetGridX = targetGridX;
        this.targetGridY = targetGridY;
        this.targetDirection = 0;
        this.clearTargetMap = false;
        this.id = 0;
    }

    // 传送门所在格 X。
    public int GridX() { return this.gridX; }
    // 传送门所在格 Y。
    public int GridY() { return this.gridY; }
    // 目标地图 Id（切图后 ArpgMapChanged 回调的 currentMapId）。
    public string TargetMapId() { return this.targetMapId; }
    // 落点格 X。
    public int TargetGridX() { return this.targetGridX; }
    // 落点格 Y。
    public int TargetGridY() { return this.targetGridY; }
    // 落点朝向（0~7），默认 0。
    public int TargetDirection() { return this.targetDirection; }
    // true 时到达后清空目标地图数据（一次性传送，防回传死循环）。
    public bool ClearTargetMap() { return this.clearTargetMap; }
    // 传送门 Id（默认 0，事件回调中非传送门切图为 -1）。
    public int Id() { return this.id; }
    // 设置落点朝向（0~7）。
    public void SetTargetDirection(int newValue) { this.targetDirection = newValue; }
    // 设置是否清空目标地图数据（一次性传送）。
    public void SetClearTargetMap(bool newValue) { this.clearTargetMap = newValue; }
    // 设置传送门 Id。
    public void SetId(int newValue) { this.id = newValue; }
}
