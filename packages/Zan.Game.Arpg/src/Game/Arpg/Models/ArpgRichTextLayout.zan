using System;

namespace Game.Arpg;

// 富文本排版结果：条目列表与整体尺寸/行数。Width 为内容实际
// 最宽行宽（非可用宽度），Height 为总高（含末行行高）。
public class ArpgRichTextLayout {
    public List<ArpgRichTextLayoutItem> items;
    public int width;
    public int height;
    public int lineCount;

    public ArpgRichTextLayout() {
        this.items = new List<ArpgRichTextLayoutItem>();
        this.width = 0;
        this.height = 0;
        this.lineCount = 0;
    }

    // 条目总数。
    public int ItemCount() { return this.items.Count; }
    // 第 index 个条目（不查越界）。
    public ArpgRichTextLayoutItem ItemAt(int index) {
        return this.items[index];
    }
    // 内容实际宽度（最宽行，像素）。
    public int Width() { return this.width; }
    // 内容总高度（像素）。
    public int Height() { return this.height; }
    // 行数。
    public int LineCount() { return this.lineCount; }

    // 追加一个条目（布局器内部使用）。
    public void Add(ArpgRichTextLayoutItem item) { this.items.Add(item); }
    // 一次性设置整体尺寸与行数（布局器内部使用）。
    public void SetSize(int width, int height, int lineCount) {
        this.width = width;
        this.height = height;
        this.lineCount = lineCount;
    }
}
