using System;

namespace Game.Arpg;

// 物品分类常量：ArpgItemDefinition.SetCategory 的合法取值。
// 静态方法返回字符串常量，集中定义分类字面量。
public class ArpgItemCategory {
    // 普通物品分类，常量 "item"（新建物品的默认分类）。
    public static string Item() { return "item"; }
    // 装备分类，常量 "equipment"。
    public static string Equipment() { return "equipment"; }
    // 特殊物品分类，常量 "special"。
    public static string Special() { return "special"; }
}
