using System;

namespace Game.Arpg;

// ZGM 技能公式的小型整数表达式求值器。刻意接受受限的表达式
// 语言（非 Lua）：整数、a.属性/b.属性（来自左右两侧属性表）、
// + - * / ^、一元 +/-、括号与 min/max/clamp 函数。除法与负指数
// 按错误处理；任何语法/求值错误都把 valid 置 false，Evaluate
// 返回错误发生前的部分结果。
public class ArpgFormula {
    public string text;
    public int index;
    public bool valid;
    public ArpgAttributes leftAttrs;
    public ArpgAttributes rightAttrs;

    // 构造求值器：text 为表达式，leftAttrs/rightAttrs 分别对应
    // a.* 与 b.* 属性前缀（可为 null，此时引用前缀即报错）。
    public ArpgFormula(
        string text,
        ArpgAttributes leftAttrs,
        ArpgAttributes rightAttrs
    ) {
        this.text = text;
        this.index = 0;
        this.valid = true;
        this.leftAttrs = leftAttrs;
        this.rightAttrs = rightAttrs;
    }

    // 表达式是否完整有效（无语法/求值错误）。
    public bool IsValid() { return this.valid; }

    // 返回当前字符的字节值；已到末尾返回 -1。
    public int Current() {
        if (this.index >= this.text.Length) { return -1; }
        return this.text[this.index] & 255;
    }

    // 跳过当前位置的空白字符（空格/制表/换行/回车）。
    public void SkipSpace() {
        int n = this.text.Length;
        int idx = this.index;
        if (idx >= n) { return; }
        Span<byte> sp = new Span<byte>((nint)this.text, n);
        while (idx < n) {
            int c = (int)sp[idx];
            if (c != 32 && c != 9 && c != 10 && c != 13) { break; }
            idx = idx + 1;
        }
        this.index = idx;
    }

    // 跳过空白后若当前字符为 expected 则消费之并返回 true。
    public bool Match(int expected) {
        int n = this.text.Length;
        Span<byte> sp = new Span<byte>((nint)this.text, n);
        int idx = this.index;
        while (idx < n) {
            int c = (int)sp[idx];
            if (c != 32 && c != 9 && c != 10 && c != 13) { break; }
            idx = idx + 1;
        }
        this.index = idx;
        if (idx >= n || (int)sp[idx] != expected) { return false; }
        this.index = idx + 1;
        return true;
    }

    // 解析十进制整数；无数字时置错并返回 0（不识别符号与小数）。
    public int ParseNumber() {
        int n = this.text.Length;
        Span<byte> sp = new Span<byte>((nint)this.text, n);
        int idx = this.index;
        while (idx < n) {
            int c = (int)sp[idx];
            if (c != 32 && c != 9 && c != 10 && c != 13) { break; }
            idx = idx + 1;
        }
        int start = idx;
        int result = 0;
        while (idx < n) {
            int c = (int)sp[idx];
            if (c < 48 || c > 57) { break; }
            result = result * 10 + (c - 48);
            idx = idx + 1;
        }
        this.index = idx;
        if (idx == start) {
            this.valid = false;
            return 0;
        }
        return result;
    }

    // 判断 c 是否可作为标识符字符（字母/数字/点/下划线/高位字节）。
    public bool IsNameChar(int c) {
        return (c >= 48 && c <= 57)
            || (c >= 65 && c <= 90)
            || (c >= 97 && c <= 122)
            || c == 46 || c == 95
            || c >= 128;
    }

    // 解析标识符（属性名或函数名）；无有效字符时置错并返回空串。
    public string ParseName() {
        int n = this.text.Length;
        nint tp = (nint)this.text;
        Span<byte> sp = new Span<byte>(tp, n);
        int idx = this.index;
        while (idx < n) {
            int c = (int)sp[idx];
            if (c != 32 && c != 9 && c != 10 && c != 13) { break; }
            idx = idx + 1;
        }
        int start = idx;
        while (idx < n) {
            int c = (int)sp[idx];
            bool ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 90)
                || (c >= 97 && c <= 122) || c == 46 || c == 95 || c >= 128;
            if (!ok) { break; }
            idx = idx + 1;
        }
        this.index = idx;
        if (idx == start) {
            this.valid = false;
            return "";
        }
        return NativeMemory.GetString(tp, start, idx - start);
    }

    // 解析属性引用：a.前缀取左属性表，b.前缀取右属性表（截断取
    // 整）；前缀不符或对应属性表为 null 时置错并返回 0。
    public int Attribute(string name) {
        int n = name.Length;
        if (n > 2) {
            nint np = (nint)name;
            Span<byte> sp = new Span<byte>(np, n);
            if (sp[1] == 46) {
                int c0 = (int)sp[0];
                if (c0 == 97 && this.leftAttrs != null) {
                    return (int)this.leftAttrs.GetCustomPtr(np, 2, n - 2);
                }
                if (c0 == 98 && this.rightAttrs != null) {
                    return (int)this.rightAttrs.GetCustomPtr(np, 2, n - 2);
                }
            }
        }
        this.valid = false;
        return 0;
    }

    private int EvalPrimary(nint tp, Span<byte> sp, int n) {
        int idx = this.index;
        while (idx < n) {
            int c = (int)sp[idx];
            if (c != 32 && c != 9 && c != 10 && c != 13) { break; }
            idx = idx + 1;
        }
        if (idx >= n) {
            this.index = idx;
            this.valid = false;
            return 0;
        }
        int c = (int)sp[idx];
        if (c == 40) {
            this.index = idx + 1;
            int result = this.EvalAddSub(tp, sp, n);
            int ci = this.index;
            while (ci < n) {
                int ws = (int)sp[ci];
                if (ws != 32 && ws != 9 && ws != 10 && ws != 13) { break; }
                ci = ci + 1;
            }
            if (ci < n && sp[ci] == 41) { this.index = ci + 1; }
            else { this.index = ci; this.valid = false; }
            return result;
        }
        if (c >= 48 && c <= 57) {
            int result = c - 48;
            idx = idx + 1;
            while (idx < n) {
                int d = (int)sp[idx];
                if (d < 48 || d > 57) { break; }
                result = result * 10 + (d - 48);
                idx = idx + 1;
            }
            this.index = idx;
            return result;
        }

        // 零分配扫描标识符切片 [nameStart, nameEnd)
        int nameStart = idx;
        while (idx < n) {
            int nc = (int)sp[idx];
            bool ok = (nc >= 48 && nc <= 57) || (nc >= 65 && nc <= 90)
                || (nc >= 97 && nc <= 122) || nc == 46 || nc == 95 || nc >= 128;
            if (!ok) { break; }
            idx = idx + 1;
        }
        if (idx == nameStart) {
            this.index = idx;
            this.valid = false;
            return 0;
        }
        int nameEnd = idx;
        int nameLen = nameEnd - nameStart;
        while (idx < n) {
            int ws = (int)sp[idx];
            if (ws != 32 && ws != 9 && ws != 10 && ws != 13) { break; }
            idx = idx + 1;
        }
        this.index = idx;
        if (idx >= n || sp[idx] != 40) {
            if (nameLen > 2 && sp[nameStart + 1] == 46) {
                int c0 = (int)sp[nameStart];
                if (c0 == 97 && this.leftAttrs != null) {
                    return (int)this.leftAttrs.GetCustomPtr(tp, nameStart + 2, nameLen - 2);
                }
                if (c0 == 98 && this.rightAttrs != null) {
                    return (int)this.rightAttrs.GetCustomPtr(tp, nameStart + 2, nameLen - 2);
                }
            }
            this.valid = false;
            return 0;
        }

        this.index = idx + 1;
        int first = this.EvalAddSub(tp, sp, n);
        if (nameLen == 3 && sp[nameStart] == 109) {
            int c1 = (int)sp[nameStart + 1];
            int c2 = (int)sp[nameStart + 2];
            if (c1 == 105 && c2 == 110) {
                if (!this.MatchSpan(sp, n, 44)) { this.valid = false; return 0; }
                int second = this.EvalAddSub(tp, sp, n);
                if (!this.MatchSpan(sp, n, 41)) { this.valid = false; return 0; }
                return first < second ? first : second;
            }
            if (c1 == 97 && c2 == 120) {
                if (!this.MatchSpan(sp, n, 44)) { this.valid = false; return 0; }
                int second = this.EvalAddSub(tp, sp, n);
                if (!this.MatchSpan(sp, n, 41)) { this.valid = false; return 0; }
                return first > second ? first : second;
            }
        } else if (nameLen == 5 && sp[nameStart] == 99 && sp[nameStart + 1] == 108
            && sp[nameStart + 2] == 97 && sp[nameStart + 3] == 109 && sp[nameStart + 4] == 112) {
            if (!this.MatchSpan(sp, n, 44)) { this.valid = false; return 0; }
            int minimum = this.EvalAddSub(tp, sp, n);
            if (!this.MatchSpan(sp, n, 44)) { this.valid = false; return 0; }
            int maximum = this.EvalAddSub(tp, sp, n);
            if (!this.MatchSpan(sp, n, 41)) { this.valid = false; return 0; }
            if (first < minimum) { return minimum; }
            if (first > maximum) { return maximum; }
            return first;
        }

        this.valid = false;
        return 0;
    }

    private bool MatchSpan(Span<byte> sp, int n, int expected) {
        int idx = this.index;
        while (idx < n) {
            int c = (int)sp[idx];
            if (c != 32 && c != 9 && c != 10 && c != 13) { break; }
            idx = idx + 1;
        }
        if (idx >= n || (int)sp[idx] != expected) {
            this.index = idx;
            return false;
        }
        this.index = idx + 1;
        return true;
    }

    private int EvalUnary(nint tp, Span<byte> sp, int n) {
        int idx = this.index;
        while (idx < n) {
            int c = (int)sp[idx];
            if (c != 32 && c != 9 && c != 10 && c != 13) { break; }
            idx = idx + 1;
        }
        this.index = idx;
        if (idx < n) {
            int c = (int)sp[idx];
            if (c == 45) { this.index = idx + 1; return -this.EvalUnary(tp, sp, n); }
            if (c == 43) { this.index = idx + 1; return this.EvalUnary(tp, sp, n); }
        }
        return this.EvalPrimary(tp, sp, n);
    }

    private int EvalPower(nint tp, Span<byte> sp, int n) {
        int result = this.EvalUnary(tp, sp, n);
        while (true) {
            int idx = this.index;
            while (idx < n) {
                int ws = (int)sp[idx];
                if (ws != 32 && ws != 9 && ws != 10 && ws != 13) { break; }
                idx = idx + 1;
            }
            this.index = idx;
            if (idx >= n || sp[idx] != 94) { return result; }
            this.index = idx + 1;
            int exponent = this.EvalUnary(tp, sp, n);
            result = this.Power(result, exponent);
        }
        return result;
    }

    private int EvalMulDiv(nint tp, Span<byte> sp, int n) {
        int result = this.EvalPower(tp, sp, n);
        while (true) {
            int idx = this.index;
            while (idx < n) {
                int ws = (int)sp[idx];
                if (ws != 32 && ws != 9 && ws != 10 && ws != 13) { break; }
                idx = idx + 1;
            }
            this.index = idx;
            if (idx >= n) { return result; }
            int c = (int)sp[idx];
            if (c == 42) {
                this.index = idx + 1;
                result = result * this.EvalPower(tp, sp, n);
            } else if (c == 47) {
                this.index = idx + 1;
                int divisor = this.EvalPower(tp, sp, n);
                if (divisor == 0) {
                    this.valid = false;
                    result = 0;
                } else {
                    result = result / divisor;
                }
            } else {
                return result;
            }
        }
        return result;
    }

    private int EvalAddSub(nint tp, Span<byte> sp, int n) {
        int result = this.EvalMulDiv(tp, sp, n);
        while (true) {
            int idx = this.index;
            while (idx < n) {
                int ws = (int)sp[idx];
                if (ws != 32 && ws != 9 && ws != 10 && ws != 13) { break; }
                idx = idx + 1;
            }
            this.index = idx;
            if (idx >= n) { return result; }
            int c = (int)sp[idx];
            if (c == 43) {
                this.index = idx + 1;
                result = result + this.EvalMulDiv(tp, sp, n);
            } else if (c == 45) {
                this.index = idx + 1;
                result = result - this.EvalMulDiv(tp, sp, n);
            } else {
                return result;
            }
        }
        return result;
    }

    // 解析基础表达式：数字、括号子表达式、属性引用或
    // min/max/clamp 函数调用；语法不符时置错并返回 0。
    public int ParsePrimary() {
        int n = this.text.Length;
        nint tp = (nint)this.text;
        return this.EvalPrimary(tp, new Span<byte>(tp, n), n);
    }

    // 解析一元 +/- 前缀（可叠加，如 --x）。
    public int ParseUnary() {
        int n = this.text.Length;
        nint tp = (nint)this.text;
        return this.EvalUnary(tp, new Span<byte>(tp, n), n);
    }

    // 整数幂运算（二进制快速幂，保持完全一致的 32 位整型乘法语义）；指数为负置错并返回 0。
    public int Power(int baseValue, int exponent) {
        if (exponent < 0) {
            this.valid = false;
            return 0;
        }
        int result = 1;
        int b = baseValue;
        int e = exponent;
        while (e > 0) {
            if ((e & 1) != 0) { result = result * b; }
            e = e >> 1;
            if (e > 0) { b = b * b; }
        }
        return result;
    }

    // 解析 ^ 幂层（右操作数经一元层，支持 2^-3 形式语法）。
    public int ParsePower() {
        int n = this.text.Length;
        nint tp = (nint)this.text;
        return this.EvalPower(tp, new Span<byte>(tp, n), n);
    }

    // 解析 * / 乘除层；除数为 0 置错且该步结果按 0 计。
    public int ParseMulDiv() {
        int n = this.text.Length;
        nint tp = (nint)this.text;
        return this.EvalMulDiv(tp, new Span<byte>(tp, n), n);
    }

    // 解析 + - 加减层（优先级最低）。
    public int ParseAddSub() {
        int n = this.text.Length;
        nint tp = (nint)this.text;
        return this.EvalAddSub(tp, new Span<byte>(tp, n), n);
    }

    // 求值整个表达式并返回整数结果；有剩余未消费字符视为语法
    // 错误（置错）。结果是否可信以 IsValid 为准。
    public int Evaluate() {
        int n = this.text.Length;
        nint tp = (nint)this.text;
        Span<byte> sp = new Span<byte>(tp, n);
        int result = this.EvalAddSub(tp, sp, n);
        int idx = this.index;
        while (idx < n) {
            int c = (int)sp[idx];
            if (c != 32 && c != 9 && c != 10 && c != 13) { break; }
            idx = idx + 1;
        }
        this.index = idx;
        if (idx < n) { this.valid = false; }
        return result;
    }
}
