using Game.Core;

namespace Game.Arpg;

public delegate void SortedRenderFn(int entityId, int entityType, double footY);

// 保留 Game.Arpg 的构造器、工厂和回调类型，排序状态由 Game.Core 提供。
public class YSortLayer : Game.Core.YSortLayer {
    public YSortLayer(int cap) : base(cap) { }

    public static YSortLayer Create(int cap) {
        return new YSortLayer(cap);
    }

    public void ForEachSorted(SortedRenderFn renderAction) {
        if (renderAction == null) { return; }
        for (int i = 0; i < count; i = i + 1) {
            int slot = orderIndices[i];
            renderAction(entityIds[slot], entityTypes[slot], footY[slot]);
        }
    }
}
