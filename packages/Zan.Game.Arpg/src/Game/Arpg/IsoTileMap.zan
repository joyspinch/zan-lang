using Game.Core;

namespace Game.Arpg;

// 保留 Game.Arpg 的构造器和工厂，地图状态与算法由 Game.Core 提供。
public class IsoTileMap : Game.Core.IsoTileMap {
    public IsoTileMap(int mapW, int mapH, int tileW, int tileH) : base(mapW, mapH, tileW, tileH) { }

    public static IsoTileMap Create(int mapW, int mapH, int tileW, int tileH) {
        return new IsoTileMap(mapW, mapH, tileW, tileH);
    }
}
