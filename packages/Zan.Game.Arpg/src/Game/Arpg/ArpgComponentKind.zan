using System;
using System.Collections.Generic;

namespace Game.Arpg;

// 组件种类字符串常量。ArpgProject 按 kind 归类资源，
// IsValid 判断是否为这八种之一。
public class ArpgComponentKind {
    // 地图组件（"map"）。
    public static string Map() { return "map"; }
    // 角色组件（"actor"）。
    public static string Actor() { return "actor"; }
    // 物品组件（"item"）。
    public static string Item() { return "item"; }
    // 技能组件（"skill"）。
    public static string Skill() { return "skill"; }
    // 增益组件（"buff"）。
    public static string Buff() { return "buff"; }
    // 窗口组件（"window"）。
    public static string Window() { return "window"; }
    // 成长曲线组件（"growth"）。
    public static string Growth() { return "growth"; }
    // 预制体组件（"prefab"）。
    public static string Prefab() { return "prefab"; }

    // kind 是否为合法组件种类。
    public static bool IsValid(string kind) {
        return kind == Map()
            || kind == Actor()
            || kind == Item()
            || kind == Skill()
            || kind == Buff()
            || kind == Window()
            || kind == Growth()
            || kind == Prefab();
    }
}
