using System;

namespace Game.Arpg;

// 鼠标按键常量：Left=0，Right=1，Middle=2。指针事件回调的 button
// 参数取这些值。
public class ArpgPointerButton {
    // 鼠标左键。
    public static int Left() { return 0; }
    // 鼠标右键。
    public static int Right() { return 1; }
    // 鼠标中键。
    public static int Middle() { return 2; }
}
