using System;
using System.Csv;
namespace System.Data;

public class DataCol {
    // 列名（来自 CSV 表头或 AddColumn）。
    public string name;
    // 列类型（ColKind 值）。
    public int kind;
    // Str 列的存储。
    public List<string> text;
    // Int 列的存储。
    public List<long> ints;
    // Float 列的存储。
    public List<double> nums;

    public static DataCol Create(string colName, int colKind) {
        DataCol c = new DataCol();
        c.name = colName;
        c.kind = colKind;
        if (colKind == ColKind.Str) { c.text = new List<string>(); }
        else if (colKind == ColKind.Int) { c.ints = new List<long>(); }
        else { c.nums = new List<double>(); }
        return c;
    }

    public string Name() { return this.name; }
    public int Kind() { return this.kind; }
    public int Count() {
        if (this.kind == ColKind.Str) { return this.text.Count; }
        if (this.kind == ColKind.Int) { return this.ints.Count; }
        return this.nums.Count;
    }

    // 追加一个单元格，值按本列类型转换（跨类型写入按
    // GetStr/SetStr 的转换语义）。
    public void Append(string v) {
        if (this.kind == ColKind.Str) { this.text.Add(v); }
        else if (this.kind == ColKind.Int) { this.ints.Add(v.ToInt64()); }
        else { this.nums.Add(Convert.ToDouble(v)); }
    }

    public void AppendLong(long v) {
        if (this.kind == ColKind.Str) {
            this.text.Add(Convert.ToString(v));
        } else if (this.kind == ColKind.Int) {
            this.ints.Add(v);
        } else {
            this.nums.Add((double)v);
        }
    }

    public void AppendDouble(double v) {
        if (this.kind == ColKind.Str) {
            this.text.Add(Convert.ToString(v));
        } else if (this.kind == ColKind.Int) {
            this.ints.Add((long)v);
        } else {
            this.nums.Add(v);
        }
    }

    // 追加同类型列在 srcRow 行的值（要求两列 kind 相同）。
    public void AppendFrom(DataCol src, int srcRow) {
        if (this.kind == ColKind.Str) { this.text.Add(src.text[srcRow]); }
        else if (this.kind == ColKind.Int) { this.ints.Add(src.ints[srcRow]); }
        else { this.nums.Add(src.nums[srcRow]); }
    }

    // 覆盖 row 行（必须已存在）。
    public void PutStr(int row, string v) {
        if (this.kind == ColKind.Str) { this.text[row] = v; }
        else if (this.kind == ColKind.Int) { this.ints[row] = v.ToInt64(); }
        else { this.nums[row] = Convert.ToDouble(v); }
    }

    public void PutLong(int row, long v) {
        if (this.kind == ColKind.Str) { this.text[row] = Convert.ToString(v); }
        else if (this.kind == ColKind.Int) { this.ints[row] = v; }
        else { this.nums[row] = (double)v; }
    }

    public void PutDouble(int row, double v) {
        if (this.kind == ColKind.Str) { this.text[row] = Convert.ToString(v); }
        else if (this.kind == ColKind.Int) { this.ints[row] = (long)v; }
        else { this.nums[row] = v; }
    }

    public string GetStr(int row) {
        if (this.kind == ColKind.Str) { return this.text[row]; }
        if (this.kind == ColKind.Int) { return Convert.ToString(this.ints[row]); }
        return Convert.ToString(this.nums[row]);
    }

    public long GetLong(int row) {
        if (this.kind == ColKind.Str) { return this.text[row].ToInt64(); }
        if (this.kind == ColKind.Int) { return this.ints[row]; }
        return (long)this.nums[row];
    }

    public double GetDouble(int row) {
        if (this.kind == ColKind.Str) { return Convert.ToDouble(this.text[row]); }
        if (this.kind == ColKind.Int) { return (double)this.ints[row]; }
        return this.nums[row];
    }
}

// 列式内存表：DataFrame 的最小核心。
// for (int i = 0; i < gs.Count; i = i + 1) {
// }
// 设计要点：
// - 列存：每列一个类型化列表（long/double/string），CSV 装载时
// 按整列内容做类型推断；空列推断为 Str。
// - 跨类型访问自动转换：Int 列 GetStr 得十进制文本，Float 列
// GetLong 截断；double ↔ 文本走最短往返格式，往返无损。
// - Filter/SortBy 返回新表；GroupBy 返回的行号组属于原表，
// 配合 Aggregate 系列使用。
// - Join 为内连接哈希实现：右表键列不进结果，其余右表列与左表
// 撞名时加 "_1" 后缀。
