using System;
using Formats.Csv;
namespace System.Data;

public class DataCol {
    // 列名（来自 CSV 表头或 AddColumn）。
    public string name;
    // 列类型（ColKind 值）。
    public int kind;
    // Str 列的存储。
    public List<string> text;
    // Int 列的存储。
    public List<long> ints;
    // Float 列的存储。
    public List<double> nums;
    // 缺失标记位：与值列表等长，true = 该单元格缺失。
    //
    // **为什么用掩码而不是哨兵值**：`0` 与 `""` 都是合法值。用 `0` 当
    // "缺失"的哨兵，会把"这行没填"和"这行填了 0"混为一谈——而这两种
    // 情况的处理方式往往相反（前者要 dropna，后者要保留）。pandas 的
    // `NaN` 之所以好使，是因为 double 有专门的 NaN 位；Zan 的列存是
    // 强类型的 long/double/string，没有 NaN 语义，所以用**独立的
    // 掩码位**表达"缺失"这件事本身。
    //
    // 掩码为空列表 = 该列无缺失（常见情形，省一份内存）。
    public List<bool> missing;

    public static DataCol Create(string colName, int colKind) {
        DataCol c = new DataCol();
        c.name = colName;
        c.kind = colKind;
        if (colKind == ColKind.Str) { c.text = new List<string>(); }
        else if (colKind == ColKind.Int) { c.ints = new List<long>(); }
        else { c.nums = new List<double>(); }
        c.missing = new List<bool>();
        return c;
    }

    public string Name() { return this.name; }
    public int Kind() { return this.kind; }
    public int Count() {
        if (this.kind == ColKind.Str) { return this.text.Count; }
        if (this.kind == ColKind.Int) { return this.ints.Count; }
        return this.nums.Count;
    }

    // 该单元格是否缺失。
    //
    // 掩码为空 = 整列无缺失（快路径）；掩码比值列表短 = 尾部的格子
    // 视为不缺失（掩码按需增长，见 MarkMissing）。
    public bool IsMissing(int row) {
        if (row < 0 || row >= this.missing.Count) { return false; }
        return this.missing[row];
    }

    // 标记某单元格缺失（值仍在存储里，读出来是占位值——所以**读之前
    // 一定要先判 IsMissing**）。
    //
    // 掩码**按需增长**：标记第 row 格时把掩码补齐到 row+1（中间补
    // false）。不能只在"掩码为空"时补齐——那样追加第二个缺失格时
    // 掩码不会跟着长，越界。
    public void MarkMissing(int row) {
        if (row < 0) { return; }
        while (this.missing.Count <= row) {
            this.missing.Add(false);
        }
        this.missing[row] = true;
    }

    // 取消缺失标记。
    public void ClearMissing(int row) {
        if (row < 0 || row >= this.missing.Count) { return; }
        this.missing[row] = false;
    }

    private static long DoubleToLong(double v) {
        if (v != v) { return 0L; }
        if (v >= 9223372036854775808.0) { return 9223372036854775807L; }
        if (v <= -9223372036854775808.0) { return -9223372036854775807L - 1L; }
        return (long)v;
    }

    // 本列缺失的单元格数。
    public int MissingCount() {
        if (this.missing.Count == 0) { return 0; }
        int n = 0;
        int limit = this.missing.Count;
        int total = this.Count();
        if (total < limit) { limit = total; }
        for (int i = 0; i < limit; i = i + 1) {
            if (this.missing[i]) { n = n + 1; }
        }
        return n;
    }

    // 追加一个单元格，值按本列类型转换（跨类型写入按
    // GetStr/SetStr 的转换语义）。
    //
    // 空串追加到 Int/Float 列会被标记为**缺失**（而不是 0）——CSV 里
    // 留空的数字格就是"没填"，不是"填了 0"。这跟 pandas 的行为一致。
    public void Append(string v) {
        if (this.kind == ColKind.Str) { this.text.Add(v == null ? "" : v); }
        else if (this.kind == ColKind.Int) {
            if (v == null || v.Length == 0) {
                this.ints.Add(0L);
                this.MarkMissing(this.ints.Count - 1);
            } else {
                this.ints.Add(v.ToInt64());
            }
        } else {
            if (v == null || v.Length == 0) {
                this.nums.Add(0.0);
                this.MarkMissing(this.nums.Count - 1);
            } else {
                this.nums.Add(Convert.ToDouble(v));
            }
        }
    }

    public void AppendLong(long v) {
        if (this.kind == ColKind.Str) {
            this.text.Add(Convert.ToString(v));
        } else if (this.kind == ColKind.Int) {
            this.ints.Add(v);
        } else {
            this.nums.Add((double)v);
        }
    }

    public void AppendDouble(double v) {
        if (this.kind == ColKind.Str) {
            this.text.Add(Convert.ToString(v));
        } else if (this.kind == ColKind.Int) {
            this.ints.Add(DataCol.DoubleToLong(v));
        } else {
            this.nums.Add(v);
        }
    }

    public void Reserve(int cap) {
        if (cap <= 0) { return; }
        if (this.kind == ColKind.Str) { this.text.Reserve(cap); }
        else if (this.kind == ColKind.Int) { this.ints.Reserve(cap); }
        else { this.nums.Reserve(cap); }
    }

    // 整列复制（同 kind）：按列连续拷贝值与缺失掩码，消除逐格 kind 分支。
    public void CopyFrom(DataCol src) {
        int n = src.Count();
        this.Reserve(n);
        if (this.kind == ColKind.Str) {
            List<string> st = src.text;
            List<string> dt = this.text;
            for (int i = 0; i < n; i = i + 1) { dt.Add(st[i]); }
        } else if (this.kind == ColKind.Int) {
            List<long> si = src.ints;
            List<long> di = this.ints;
            for (int i = 0; i < n; i = i + 1) { di.Add(si[i]); }
        } else {
            List<double> sn = src.nums;
            List<double> dn = this.nums;
            for (int i = 0; i < n; i = i + 1) { dn.Add(sn[i]); }
        }
        int mc = src.missing.Count;
        if (mc > 0) {
            this.missing.Reserve(mc);
            List<bool> sm = src.missing;
            List<bool> dm = this.missing;
            for (int i = 0; i < mc; i = i + 1) { dm.Add(sm[i]); }
        }
    }

    // 按行号数组批量收集同类型列（用于 SortBy / Filter / Join 列式物化）。
    public void GatherFromArray(DataCol src, int[] idx, int count) {
        this.Reserve(count);
        if (this.kind == ColKind.Str) {
            List<string> st = src.text;
            List<string> dt = this.text;
            for (int i = 0; i < count; i = i + 1) { dt.Add(st[idx[i]]); }
        } else if (this.kind == ColKind.Int) {
            List<long> si = src.ints;
            List<long> di = this.ints;
            for (int i = 0; i < count; i = i + 1) { di.Add(si[idx[i]]); }
        } else {
            List<double> sn = src.nums;
            List<double> dn = this.nums;
            for (int i = 0; i < count; i = i + 1) { dn.Add(sn[idx[i]]); }
        }
        int mc = src.missing.Count;
        if (mc > 0) {
            List<bool> sm = src.missing;
            for (int i = 0; i < count; i = i + 1) {
                int r = idx[i];
                if (r < mc && sm[r]) { this.MarkMissing(i); }
            }
        }
    }

    // 按行号列表批量收集同类型列。
    public void GatherFromList(DataCol src, List<int> idx) {
        int count = idx.Count;
        this.Reserve(count);
        if (this.kind == ColKind.Str) {
            List<string> st = src.text;
            List<string> dt = this.text;
            for (int i = 0; i < count; i = i + 1) { dt.Add(st[idx[i]]); }
        } else if (this.kind == ColKind.Int) {
            List<long> si = src.ints;
            List<long> di = this.ints;
            for (int i = 0; i < count; i = i + 1) { di.Add(si[idx[i]]); }
        } else {
            List<double> sn = src.nums;
            List<double> dn = this.nums;
            for (int i = 0; i < count; i = i + 1) { dn.Add(sn[idx[i]]); }
        }
        int mc = src.missing.Count;
        if (mc > 0) {
            List<bool> sm = src.missing;
            for (int i = 0; i < count; i = i + 1) {
                int r = idx[i];
                if (r < mc && sm[r]) { this.MarkMissing(i); }
            }
        }
    }

    // 按行号列表批量收集同类型列（支持 idx[i] < 0 哨兵：填入空值并标记缺失）。
    public void GatherFromListNullable(DataCol src, List<int> idx) {
        int count = idx.Count;
        this.Reserve(count);
        int mc = src.missing.Count;
        if (this.kind == ColKind.Str) {
            List<string> st = src.text;
            List<string> dt = this.text;
            for (int i = 0; i < count; i = i + 1) {
                int r = idx[i];
                if (r < 0) { dt.Add(""); }
                else { dt.Add(st[r]); }
            }
        } else if (this.kind == ColKind.Int) {
            List<long> si = src.ints;
            List<long> di = this.ints;
            for (int i = 0; i < count; i = i + 1) {
                int r = idx[i];
                if (r < 0) {
                    di.Add(0L);
                    this.MarkMissing(i);
                } else {
                    di.Add(si[r]);
                    if (mc > 0 && r < mc && src.missing[r]) { this.MarkMissing(i); }
                }
            }
        } else {
            List<double> sn = src.nums;
            List<double> dn = this.nums;
            for (int i = 0; i < count; i = i + 1) {
                int r = idx[i];
                if (r < 0) {
                    dn.Add(0.0);
                    this.MarkMissing(i);
                } else {
                    dn.Add(sn[r]);
                    if (mc > 0 && r < mc && src.missing[r]) { this.MarkMissing(i); }
                }
            }
        }
        if (this.kind == ColKind.Str && mc > 0) {
            List<bool> sm = src.missing;
            for (int i = 0; i < count; i = i + 1) {
                int r = idx[i];
                if (r >= 0 && r < mc && sm[r]) { this.MarkMissing(i); }
            }
        }
    }

    // 按行号列表批量收集列；当主行号 idx[i] < 0 时从回退列 fb[fbIdx[i]] 补齐（用于 Right/Outer 键列）。
    public void GatherFromListFallback(DataCol src, List<int> idx, DataCol fb, List<int> fbIdx) {
        int count = idx.Count;
        this.Reserve(count);
        for (int i = 0; i < count; i = i + 1) {
            int r = idx[i];
            if (r >= 0) {
                this.AppendFrom(src, r);
            } else {
                int fr = fbIdx[i];
                if (fr >= 0) { this.AppendFrom(fb, fr); }
                else { this.Append(""); }
            }
        }
    }

    // 追加列在 srcRow 行的值（同 kind 走快路径，跨 kind 按缺失/文本语义安全转换）。
    // 缺失标记一并复制。
    public void AppendFrom(DataCol src, int srcRow) {
        if (this.kind != src.kind) {
            if (src.IsMissing(srcRow)) { this.Append(""); }
            else { this.Append(src.GetStr(srcRow)); }
            return;
        }
        if (this.kind == ColKind.Str) { this.text.Add(src.text[srcRow]); }
        else if (this.kind == ColKind.Int) { this.ints.Add(src.ints[srcRow]); }
        else { this.nums.Add(src.nums[srcRow]); }
        if (src.IsMissing(srcRow)) { this.MarkMissing(this.Count() - 1); }
    }

    // 覆盖 row 行（必须已存在）。
    //
    // **写入即"有值"**：写空串到 Int/Float 列会标记为缺失（与 Append
    // 同口径）；写非空值则清掉缺失标记——否则会出现"值是 3 但标记
    // 仍然缺失"的自相矛盾状态。
    public void PutStr(int row, string v) {
        string sv = v == null ? "" : v;
        if (this.kind == ColKind.Str) {
            this.text[row] = sv;
            this.ClearMissing(row);
        } else if (this.kind == ColKind.Int) {
            this.ints[row] = sv.Length == 0 ? 0L : sv.ToInt64();
            if (sv.Length == 0) { this.MarkMissing(row); } else { this.ClearMissing(row); }
        } else {
            this.nums[row] = sv.Length == 0 ? 0.0 : Convert.ToDouble(sv);
            if (sv.Length == 0) { this.MarkMissing(row); } else { this.ClearMissing(row); }
        }
    }

    public void PutLong(int row, long v) {
        if (this.kind == ColKind.Str) {
            this.text[row] = Convert.ToString(v);
        } else if (this.kind == ColKind.Int) {
            this.ints[row] = v;
        } else {
            this.nums[row] = (double)v;
        }
        this.ClearMissing(row);
    }

    public void PutDouble(int row, double v) {
        if (this.kind == ColKind.Str) {
            this.text[row] = Convert.ToString(v);
        } else if (this.kind == ColKind.Int) {
            this.ints[row] = DataCol.DoubleToLong(v);
        } else {
            this.nums[row] = v;
        }
        this.ClearMissing(row);
    }

    public string GetStr(int row) {
        if (this.kind == ColKind.Str) { return this.text[row]; }
        if (this.kind == ColKind.Int) { return Convert.ToString(this.ints[row]); }
        return Convert.ToString(this.nums[row]);
    }

    public long GetLong(int row) {
        if (this.kind == ColKind.Str) { return this.text[row].ToInt64(); }
        if (this.kind == ColKind.Int) { return this.ints[row]; }
        return DataCol.DoubleToLong(this.nums[row]);
    }

    public double GetDouble(int row) {
        if (this.kind == ColKind.Str) { return Convert.ToDouble(this.text[row]); }
        if (this.kind == ColKind.Int) { return (double)this.ints[row]; }
        return this.nums[row];
    }
}
