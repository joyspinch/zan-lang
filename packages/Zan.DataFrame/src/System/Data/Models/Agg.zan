using System;
using System.Csv;
namespace System.Data;

enum Agg {
    Sum,
    Avg,
    Min,
    Max,
    Count
}

// 行谓词：接收行号，返回该行是否保留。闭包可捕获 DataFrame
// 自身来读取单元格值。
delegate bool RowFn(int row);

// 行号比较器（SortBy 的排序键）。
delegate int RowCmpFn(int a, int b);

// 一列的列存：按 kind 只使用对应的那个列表（Int 用 ints、
// Float 用 nums、Str 用 text），其余保持 null 不占内存。
