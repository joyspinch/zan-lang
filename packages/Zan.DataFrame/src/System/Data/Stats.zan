using System;

namespace System.Data;

// 描述统计：单列数值的集中趋势与离散度。
//
// 为什么放在这里而不是新起一个包：统计是对"一列数值"的加工，列是
// DataFrame 的原生概念；独立包会让调用方为了算个中位数先把表搬过去。
// 绘图侧（ChartBridge）在 Zan.Gui.Charts，两边共用同一列语义。
//
// 全部函数吃 List<double>（已解析好的数值列），不自己认列类型——
// 列到数值的转换由调用方按 ColKind 决定（Int/Float 直接取，
// Str 列要不要解析是调用方的判断，不是统计的判断）。
//
// 空集与单元素集的语义：空集返回 0.0（不抛异常——聚合类查询里空组很常见，
// 抛异常会让 GroupBy+Agg 的调用方到处写 try）；单元素集的方差/标准差
// 为 0.0（无离散度）。分位数用线性插值（与 numpy 默认一致）。

public class Stats {
    // 算术平均。空集返回 0.0。
    public static double Mean(List<double> xs) {
        if (xs == null || xs.Count == 0) { return 0.0; }
        double sum = 0.0;
        for (int i = 0; i < xs.Count; i = i + 1) { sum = sum + xs[i]; }
        return sum / (double)xs.Count;
    }

    // 中位数。偶数个取中间两值的平均（插值），奇数个取正中值。
    // 空集返回 0.0。采用期望 O(N) 迭代式快速选择（替代 O(N log N) 全排序）。
    public static double Median(List<double> xs) {
        if (xs == null || xs.Count == 0) { return 0.0; }
        int n = xs.Count;
        if (n == 1) { return xs[0]; }
        double[] a = new double[n];
        for (int i = 0; i < n; i = i + 1) { a[i] = xs[i]; }
        int mid = n / 2;
        double hi = Stats.SelectKth(a, n, mid);
        if ((n & 1) == 1) { return hi; }
        // SelectKth 保证 a[0..mid-1] 均 <= a[mid]，最大值即为有序第 mid-1 项
        double lo = a[0];
        for (int i = 1; i < mid; i = i + 1) {
            if (a[i] > lo) { lo = a[i]; }
        }
        return (lo + hi) * 0.5;
    }

    // 分位数（q ∈ [0,1]）。线性插值法：位置 = q × (n-1)，
    // 取两侧整数下标并按小数部分加权。q 越界按 0 / 1 夹取。
    // 空集返回 0.0。采用期望 O(N) 快速选择 + 线性邻项扫描。
    public static double Percentile(List<double> xs, double q) {
        if (xs == null || xs.Count == 0) { return 0.0; }
        if (q <= 0.0) { return Stats.Min(xs); }
        if (q >= 1.0) { return Stats.Max(xs); }
        int n = xs.Count;
        if (n == 1) { return xs[0]; }
        double[] a = new double[n];
        for (int i = 0; i < n; i = i + 1) { a[i] = xs[i]; }
        double pos = q * (double)(n - 1);
        int lo = (int)pos;
        int hi = lo + 1;
        double vlo = Stats.SelectKth(a, n, lo);
        if (hi >= n) { return vlo; }
        double frac = pos - (double)lo;
        if (frac == 0.0) { return vlo; }
        // SelectKth 保证 a[lo+1..n-1] 均 >= a[lo]，最小值即为有序第 lo+1 项
        double vhi = a[hi];
        for (int i = hi + 1; i < n; i = i + 1) {
            if (a[i] < vhi) { vhi = a[i]; }
        }
        return vlo + (vhi - vlo) * frac;
    }

    // 期望 O(N) 原地快速选择（三数取中 + 3-way 划分，对大量重复值无退化；
    // 返回后保证 a[0..k-1] <= a[k] <= a[k+1..n-1]）。
    private static double SelectKth(double[] a, int n, int k) {
        int lo = 0;
        int hi = n - 1;
        while (hi - lo > 16) {
            int mid = lo + ((hi - lo) >> 1);
            double x = a[lo];
            double y = a[mid];
            double z = a[hi];
            double pivot = x < y ? (y < z ? y : (x < z ? z : x)) : (x < z ? x : (y < z ? z : y));
            int lt = lo;
            int i = lo;
            int gt = hi;
            while (i <= gt) {
                double v = a[i];
                if (v < pivot) {
                    a[i] = a[lt];
                    a[lt] = v;
                    lt = lt + 1;
                    i = i + 1;
                } else if (v > pivot) {
                    a[i] = a[gt];
                    a[gt] = v;
                    gt = gt - 1;
                } else {
                    i = i + 1;
                }
            }
            if (k < lt) {
                hi = lt - 1;
            } else if (k > gt) {
                lo = gt + 1;
            } else {
                return a[k];
            }
        }
        for (int i = lo + 1; i <= hi; i = i + 1) {
            double v = a[i];
            int j = i - 1;
            while (j >= lo && a[j] > v) {
                a[j + 1] = a[j];
                j = j - 1;
            }
            a[j + 1] = v;
        }
        return a[k];
    }

    // 最小值。空集返回 0.0。
    public static double Min(List<double> xs) {
        if (xs == null || xs.Count == 0) { return 0.0; }
        double lo = xs[0];
        for (int i = 1; i < xs.Count; i = i + 1) {
            if (xs[i] < lo) { lo = xs[i]; }
        }
        return lo;
    }

    // 最大值。空集返回 0.0。
    public static double Max(List<double> xs) {
        if (xs == null || xs.Count == 0) { return 0.0; }
        double hi = xs[0];
        for (int i = 1; i < xs.Count; i = i + 1) {
            if (xs[i] > hi) { hi = xs[i]; }
        }
        return hi;
    }

    // 极差（max - min）。单遍扫描；空集返回 0.0。
    public static double Range(List<double> xs) {
        if (xs == null || xs.Count == 0) { return 0.0; }
        double lo = xs[0];
        double hi = lo;
        int n = xs.Count;
        for (int i = 1; i < n; i = i + 1) {
            double v = xs[i];
            if (v < lo) { lo = v; }
            if (v > hi) { hi = v; }
        }
        return hi - lo;
    }

    // 总体方差（除以 n）。空集返回 0.0；单元素集为 0.0。
    public static double Variance(List<double> xs) {
        if (xs == null || xs.Count == 0) { return 0.0; }
        double m = Stats.Mean(xs);
        double acc = 0.0;
        for (int i = 0; i < xs.Count; i = i + 1) {
            double d = xs[i] - m;
            acc = acc + d * d;
        }
        return acc / (double)xs.Count;
    }

    // 样本方差（除以 n-1，n < 2 时为 0.0）。与总体方差的区别只在
    // 分母——做无偏估计时用这个。
    public static double SampleVariance(List<double> xs) {
        if (xs == null || xs.Count < 2) { return 0.0; }
        double m = Stats.Mean(xs);
        double acc = 0.0;
        for (int i = 0; i < xs.Count; i = i + 1) {
            double d = xs[i] - m;
            acc = acc + d * d;
        }
        return acc / (double)(xs.Count - 1);
    }

    // 标准差（总体方差的平方根）。空集返回 0.0。
    public static double StdDev(List<double> xs) {
        if (xs == null || xs.Count == 0) { return 0.0; }
        return Math.Sqrt(Stats.Variance(xs));
    }

    // 样本标准差（样本方差的平方根）。空集/单元素集返回 0.0。
    public static double SampleStdDev(List<double> xs) {
        if (xs == null || xs.Count < 2) { return 0.0; }
        return Math.Sqrt(Stats.SampleVariance(xs));
    }

    // 偏度（Fisher-Pearson 标准化三阶矩，两遍融合：均值 + 同步二/三阶中心矩）。
    public static double Skewness(List<double> xs) {
        if (xs == null || xs.Count < 3) { return 0.0; }
        int n = xs.Count;
        double m = Stats.Mean(xs);
        double acc2 = 0.0;
        double acc3 = 0.0;
        for (int i = 0; i < n; i = i + 1) {
            double d = xs[i] - m;
            double d2 = d * d;
            acc2 = acc2 + d2;
            acc3 = acc3 + d2 * d;
        }
        double v = acc2 / (double)n;
        if (v <= 0.0) { return 0.0; }
        double m3 = acc3 / (double)n;
        return m3 / (v * Math.Sqrt(v));
    }

    // 峰度（超额峰度：四阶矩 / 方差² 减 3，两遍融合：均值 + 同步二/四阶中心矩）。
    public static double Kurtosis(List<double> xs) {
        if (xs == null || xs.Count < 4) { return 0.0; }
        int n = xs.Count;
        double m = Stats.Mean(xs);
        double acc2 = 0.0;
        double acc4 = 0.0;
        for (int i = 0; i < n; i = i + 1) {
            double d = xs[i] - m;
            double d2 = d * d;
            acc2 = acc2 + d2;
            acc4 = acc4 + d2 * d2;
        }
        double v = acc2 / (double)n;
        if (v <= 0.0) { return 0.0; }
        double m4 = acc4 / (double)n;
        return m4 / (v * v) - 3.0;
    }

    // 两个变量的皮尔逊相关系数。样本数 < 2 或任一方方差为 0
    // （常量序列）时返回 0.0——相关性对常量序列无定义。
    public static double Correlation(List<double> xs, List<double> ys) {
        if (xs == null || ys == null) { return 0.0; }
        int n = xs.Count < ys.Count ? xs.Count : ys.Count;
        if (n < 2) { return 0.0; }
        double mx = Stats.MeanOfN(xs, n);
        double my = Stats.MeanOfN(ys, n);
        double sxy = 0.0;
        double sxx = 0.0;
        double syy = 0.0;
        for (int i = 0; i < n; i = i + 1) {
            double dx = xs[i] - mx;
            double dy = ys[i] - my;
            sxy = sxy + dx * dy;
            sxx = sxx + dx * dx;
            syy = syy + dy * dy;
        }
        if (sxx <= 0.0 || syy <= 0.0) { return 0.0; }
        return sxy / (Math.Sqrt(sxx) * Math.Sqrt(syy));
    }

    // 前 n 项之和（Top-N 场景用）。n <= 0 返回 0.0。
    public static double Sum(List<double> xs, int n) {
        if (xs == null || n <= 0) { return 0.0; }
        int take = n < xs.Count ? n : xs.Count;
        double acc = 0.0;
        for (int i = 0; i < take; i = i + 1) { acc = acc + xs[i]; }
        return acc;
    }

    // 排序后的副本（不改动入参）。升序（直接内联三数取中快排，零闭包比较开销）。
    public static List<double> SortedCopy(List<double> xs) {
        List<double> s = new List<double>();
        if (xs == null) { return s; }
        int n = xs.Count;
        s.Reserve(n);
        for (int i = 0; i < n; i = i + 1) { s.Add(xs[i]); }
        if (n > 1) { Stats.QuickSortDoubles(s, 0, n - 1); }
        return s;
    }

    private static void QuickSortDoubles(List<double> a, int lo, int hi) {
        while (hi - lo > 16) {
            int mid = lo + ((hi - lo) >> 1);
            double x = a[lo];
            double y = a[mid];
            double z = a[hi];
            double pivot = x < y ? (y < z ? y : (x < z ? z : x)) : (x < z ? x : (y < z ? z : y));
            int i = lo;
            int j = hi;
            while (i <= j) {
                while (a[i] < pivot) { i = i + 1; }
                while (a[j] > pivot) { j = j - 1; }
                if (i <= j) {
                    double t = a[i];
                    a[i] = a[j];
                    a[j] = t;
                    i = i + 1;
                    j = j - 1;
                }
            }
            if (j - lo < hi - i) {
                if (lo < j) { Stats.QuickSortDoubles(a, lo, j); }
                lo = i;
            } else {
                if (i < hi) { Stats.QuickSortDoubles(a, i, hi); }
                hi = j;
            }
        }
        for (int i = lo + 1; i <= hi; i = i + 1) {
            double v = a[i];
            int j = i - 1;
            while (j >= lo && a[j] > v) {
                a[j + 1] = a[j];
                j = j - 1;
            }
            a[j + 1] = v;
        }
    }

    // 前 n 项均值（只看入参的前 n 个，不排序）。
    private static double MeanOfN(List<double> xs, int n) {
        double acc = 0.0;
        for (int i = 0; i < n; i = i + 1) { acc = acc + xs[i]; }
        return acc / (double)n;
    }
}
