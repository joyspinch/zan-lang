using System;
using System.Csv;
namespace System.Data;

public class DataFrame {
    // 列集（顺序即列序）。
    public List<DataCol> cols;
    // 行数（各列长度恒等于它）。
    public int rowCount;

    public DataFrame() {
        this.cols = new List<DataCol>();
        this.rowCount = 0;
    }

    // 空表。
    public static DataFrame New() {
        return new DataFrame();
    }

    // 从 CSV 文本装载：首记录为表头，其后每记录一行；
    // 逐列推断类型。行数与表头列数不一致的记录按宽松规则补空串/
    // 截断（缺失字段补空，多余字段丢弃）。
    public static DataFrame FromCsv(string text) {
        CsvTable t = Csv.Parse(text);
        DataFrame df = new DataFrame();
        List<string> header = t.Header();
        if (t.RowCount() == 0 || header.Count == 0) { return df; }
        for (int c = 0; c < header.Count; c = c + 1) {
            int kind = DataFrame.InferKind(t, c);
            df.cols.Add(DataCol.Create(header[c], kind));
        }
        df.rowCount = t.RowCount();
        List<List<string>> rows = t.Rows();
        for (int r = 0; r < rows.Count; r = r + 1) {
            List<string> row = rows[r];
            for (int c = 0; c < df.cols.Count; c = c + 1) {
                if (c < row.Count) { df.cols[c].Append(row[c]); }
                else { df.cols[c].Append(""); }
            }
        }
        return df;
    }

    // 第 at 列（0 起）的整列类型推断：全部像整数 → Int；
    // 全部像数值（整数或小数/指数形式）→ Float；否则 Str。
    //
    // **空字段不算"不像整数"**：空格子是"缺失"，不参与类型推断——
    // 否则 `1,,3` 会被推成 Str，数字列退化成文本列。
    // 整列全空 → Str（空串在 Int/Float 语境下无意义）。
    public static int InferKind(CsvTable t, int at) {
        List<List<string>> rows = t.Rows();
        bool allInt = true;
        bool allNum = true;
        bool anyValue = false;
        for (int r = 0; r < rows.Count; r = r + 1) {
            List<string> row = rows[r];
            string v = at < row.Count ? row[at] : "";
            if (v.Length == 0) { continue; }
            anyValue = true;
            bool isInt = DataFrame.LooksInt(v);
            if (!isInt) { allInt = false; }
            if (!isInt && !DataFrame.LooksFloat(v)) { allNum = false; }
            if (!allNum) { break; }
        }
        if (!anyValue) { return ColKind.Str; }
        if (allInt) { return ColKind.Int; }
        if (allNum) { return ColKind.Float; }
        return ColKind.Str;
    }

    // 严格十进制整数形态：可选 +/- 后全数字（不允许空白）。
    public static bool LooksInt(string s) {
        int n = s.Length;
        int i = 0;
        if (n > 0 && ((s[0] & 255) == 45 || (s[0] & 255) == 43)) { i = 1; }
        if (i >= n) { return false; }
        for (; i < n; i = i + 1) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { return false; }
        }
        return true;
    }

    // 严格数值形态：尾数（数字与至多一个小数点，至少一位数字）
    // 加可选指数（e/E [+/-] 数字）。排除 strtod 也接受的
    // inf/nan/十六进制与前后空白。
    public static bool LooksFloat(string s) {
        int n = s.Length;
        int i = 0;
        int digits = 0;
        while (i < n) {
            int c = s[i] & 255;
            if (c >= 48 && c <= 57) { digits = digits + 1; i = i + 1; continue; }
            if (c == 46) { i = i + 1; continue; }
            break;
        }
        if (digits == 0) { return false; }
        if (i < n && ((s[i] & 255) == 101 || (s[i] & 255) == 69)) {
            i = i + 1;
            if (i < n && ((s[i] & 255) == 45 || (s[i] & 255) == 43)) { i = i + 1; }
            int expDigits = 0;
            while (i < n) {
                int c = s[i] & 255;
                if (c < 48 || c > 57) { break; }
                expDigits = expDigits + 1;
                i = i + 1;
            }
            if (expDigits == 0) { return false; }
        }
        return i == n;
    }

    // 加一列（ColKind 值）；新列以默认值补齐到当前行数。
    // 名字重复时本层不拦截（ColIndex 命中第一列）。
    //
    // 新列对已有行**没有值** → Int/Float 列的那些格子标记为**缺失**
    // （不是 0）。"这列在这行没填"与"这行填了 0"是两回事。
    public DataFrame AddColumn(string name, int kind) {
        DataCol c = DataCol.Create(name, kind);
        for (int r = 0; r < this.rowCount; r = r + 1) {
            if (kind == ColKind.Str) { c.Append(""); }
            else if (kind == ColKind.Int) { c.AppendLong(0); c.MarkMissing(r); }
            else { c.AppendDouble(0.0); c.MarkMissing(r); }
        }
        this.cols.Add(c);
        return this;
    }

    // 行数。
    public int Rows() { return this.rowCount; }

    // 列数。
    public int ColCount() { return this.cols.Count; }

    // 列名列表（按列序）。
    public List<string> Names() {
        List<string> names = new List<string>();
        for (int i = 0; i < this.cols.Count; i = i + 1) {
            names.Add(this.cols[i].Name());
        }
        return names;
    }

    // 列序号；不存在返回 -1（命中第一个同名列）。
    public int ColIndex(string name) {
        for (int i = 0; i < this.cols.Count; i = i + 1) {
            if (this.cols[i].Name() == name) { return i; }
        }
        return 0 - 1;
    }

    // 列类型（ColKind 值）；列不存在返回 ColKind.Str。
    public int Kind(string name) {
        int at = this.ColIndex(name);
        if (at < 0) { return ColKind.Str; }
        return this.cols[at].Kind();
    }

    // 追加一个空行，返回其行号。
    //
    // Int/Float 列的新格标记为**缺失**（不是 0）——空行就是"没填"。
    // 随后 `SetInt`/`SetFloat`/`SetStr` 写入的值会清掉缺失标记。
    public int AddRow() {
        int row = this.rowCount;
        this.rowCount = this.rowCount + 1;
        for (int c = 0; c < this.cols.Count; c = c + 1) {
            int kind = this.cols[c].Kind();
            if (kind == ColKind.Str) { this.cols[c].Append(""); }
            else if (kind == ColKind.Int) { this.cols[c].AppendLong(0); this.cols[c].MarkMissing(row); }
            else { this.cols[c].AppendDouble(0.0); this.cols[c].MarkMissing(row); }
        }
        return row;
    }

    // 追加一行并按字符串逐列填入（缺的补空、多的丢弃）。
    public void AddStrRow(params string[] cells) {
        int row = this.AddRow();
        for (int c = 0; c < this.cols.Count && c < cells.Length; c = c + 1) {
            this.cols[c].PutStr(row, cells[c]);
        }
    }

    // 追加一行并按 double 逐列填入（Int 列截断）。
    public void AddFloatRow(params double[] cells) {
        int row = this.AddRow();
        for (int c = 0; c < this.cols.Count && c < cells.Length; c = c + 1) {
            this.cols[c].PutDouble(row, cells[c]);
        }
    }

    // 列存在性守卫：抛出带列名的异常。
    public DataCol ColOrThrow(string name) {
        int at = this.ColIndex(name);
        if (at < 0) {
            throw new InvalidOperationException("DataFrame 没有列: " + name);
        }
        return this.cols[at];
    }

    // 把某列转成新类型（**就地改**，返回本表便于链式调用）。
    //
    // 值按 GetDouble/GetStr 口径转换，**缺失标记原样保留**（转类型不该
    // 改变"有没有值"这件事）。
    //
    // 为什么需要它：往 Int 列填小数时不能截断——1.5 填进 Int 列会变成
    // 1，静默算错。所以要填小数先把列**升成 Float**。
    //
    // Str → 数值列时，空串算缺失（与 CSV 装载同口径）；非空但不是数值的
    // 文本按 Convert.ToDouble 的解析结果（解析不了得 0.0，与本包其它
    // 跨类型访问一致）。
    public DataFrame CastColumn(string name, int kind) {
        int at = this.ColIndex(name);
        if (at < 0) {
            throw new InvalidOperationException("DataFrame 没有列: " + name);
        }
        DataCol old = this.cols[at];
        if (old.Kind() == kind) { return this; }
        DataCol c = DataCol.Create(old.Name(), kind);
        for (int r = 0; r < old.Count(); r = r + 1) {
            bool miss = old.IsMissing(r);
            if (kind == ColKind.Str) {
                c.Append(old.GetStr(r));
            } else if (kind == ColKind.Int) {
                if (miss) { c.AppendLong(0); c.MarkMissing(r); }
                else { c.AppendLong(old.GetLong(r)); }
            } else {
                if (miss) { c.AppendDouble(0.0); c.MarkMissing(r); }
                else { c.AppendDouble(old.GetDouble(r)); }
            }
            if (miss) { c.MarkMissing(r); }
        }
        this.cols[at] = c;
        return this;
    }

    // 读单元格为文本。
    public string GetStr(int row, int col) {
        if (col < 0 || col >= this.cols.Count) { return ""; }
        return this.cols[col].GetStr(row);
    }

    // 按列名读单元格为文本。
    public string GetStr(int row, string col) {
        return this.ColOrThrow(col).GetStr(row);
    }

    // 读单元格为 64 位整数（Float 列截断；Str 列按 strtoll 前缀）。
    public long GetInt(int row, int col) {
        if (col < 0 || col >= this.cols.Count) { return 0; }
        return this.cols[col].GetLong(row);
    }

    public long GetInt(int row, string col) {
        return this.ColOrThrow(col).GetLong(row);
    }

    // 读单元格为 double（Int 列提升；Str 列按 strtod 前缀）。
    public double GetFloat(int row, int col) {
        if (col < 0 || col >= this.cols.Count) { return 0.0; }
        return this.cols[col].GetDouble(row);
    }

    public double GetFloat(int row, string col) {
        return this.ColOrThrow(col).GetDouble(row);
    }

    // 写单元格（文本形态，按列类型转换）。
    public void SetStr(int row, int col, string v) {
        this.cols[col].PutStr(row, v);
    }

    public void SetStr(int row, string col, string v) {
        this.ColOrThrow(col).PutStr(row, v);
    }

    // 写单元格（64 位整数）。
    public void SetInt(int row, int col, long v) {
        this.cols[col].PutLong(row, v);
    }

    public void SetInt(int row, string col, long v) {
        this.ColOrThrow(col).PutLong(row, v);
    }

    // 写单元格（double；Int 列截断）。
    public void SetFloat(int row, int col, double v) {
        this.cols[col].PutDouble(row, v);
    }

    public void SetFloat(int row, string col, double v) {
        this.ColOrThrow(col).PutDouble(row, v);
    }

    // 过滤：谓词为 true 的行组成新表（同一 schema）。
    // 谓词闭包可捕获本帧读取任意单元格。
    public DataFrame Filter(RowFn fn) {
        DataFrame outDf = new DataFrame();
        for (int c = 0; c < this.cols.Count; c = c + 1) {
            outDf.cols.Add(DataCol.Create(this.cols[c].Name(), this.cols[c].Kind()));
        }
        for (int r = 0; r < this.rowCount; r = r + 1) {
            if (fn(r)) {
                for (int c = 0; c < this.cols.Count; c = c + 1) {
                    outDf.cols[c].AppendFrom(this.cols[c], r);
                }
                outDf.rowCount = outDf.rowCount + 1;
            }
        }
        return outDf;
    }

    // 深拷贝：同 schema 同值的新表（列与行都复制，列存不共享）。
    // 改新表不影响原表。
    public DataFrame Copy() {
        DataFrame outDf = new DataFrame();
        for (int c = 0; c < this.cols.Count; c = c + 1) {
            outDf.cols.Add(DataCol.Create(this.cols[c].Name(), this.cols[c].Kind()));
        }
        for (int r = 0; r < this.rowCount; r = r + 1) {
            for (int c = 0; c < this.cols.Count; c = c + 1) {
                outDf.cols[c].AppendFrom(this.cols[c], r);
            }
            outDf.rowCount = outDf.rowCount + 1;
        }
        return outDf;
    }

    // 全部行号（0..Rows()-1），供 Aggregate 系列整表聚合使用。
    public List<int> AllRows() {
        List<int> all = new List<int>();
        for (int r = 0; r < this.rowCount; r = r + 1) { all.Add(r); }
        return all;
    }

    // 按列稳定排序（相等保持原相对顺序），返回新表。
    // desc 为 true 时降序。列不存在抛异常。
    public DataFrame SortBy(string col, bool desc) {
        DataCol key = this.ColOrThrow(col);
        List<int> idx = new List<int>();
        for (int r = 0; r < this.rowCount; r = r + 1) { idx.Add(r); }
        int kind = key.Kind();
        // 闭包捕获键列与方向；相等时返回负数让归并取左，保持稳定。
        RowCmpFn cmp = (int a, int b) => {
            int r = 0;
            if (kind == ColKind.Int) {
                long x = key.ints[a];
                long y = key.ints[b];
                r = x < y ? 0 - 1 : (x > y ? 1 : 0);
            } else if (kind == ColKind.Float) {
                double x = key.nums[a];
                double y = key.nums[b];
                r = x < y ? 0 - 1 : (x > y ? 1 : 0);
            } else {
                r = key.text[a].CompareTo(key.text[b]);
            }
            return desc ? 0 - r : r;
        };
        List<int> tmp = new List<int>();
        DataFrame.MergeSort(idx, tmp, 0, this.rowCount, cmp);
        DataFrame outDf = new DataFrame();
        for (int c = 0; c < this.cols.Count; c = c + 1) {
            outDf.cols.Add(DataCol.Create(this.cols[c].Name(), this.cols[c].Kind()));
        }
        for (int i = 0; i < idx.Count; i = i + 1) {
            for (int c = 0; c < this.cols.Count; c = c + 1) {
                outDf.cols[c].AppendFrom(this.cols[c], idx[i]);
            }
            outDf.rowCount = outDf.rowCount + 1;
        }
        return outDf;
    }

    // 归并排序（稳定）：对 idx[lo, hi) 排序，tmp 为工作缓冲。
    public static void MergeSort(List<int> idx, List<int> tmp, int lo, int hi,
    RowCmpFn cmp) {
        if (hi - lo < 2) { return; }
        int mid = lo + (hi - lo) / 2;
        DataFrame.MergeSort(idx, tmp, lo, mid, cmp);
        DataFrame.MergeSort(idx, tmp, mid, hi, cmp);
        int a = lo;
        int b = mid;
        tmp.Clear();
        while (a < mid && b < hi) {
            if (cmp(idx[b], idx[a]) < 0) { tmp.Add(idx[b]); b = b + 1; }
            else { tmp.Add(idx[a]); a = a + 1; }  // 取左保稳定
        }
        while (a < mid) { tmp.Add(idx[a]); a = a + 1; }
        while (b < hi) { tmp.Add(idx[b]); b = b + 1; }
        for (int i = 0; i < tmp.Count; i = i + 1) {
            idx[lo + i] = tmp[i];
        }
    }

    // 按列分组：键为单元格文本形态，组按首次出现顺序排列。
    // 返回的 RowGroup.Rows() 是本表的行号列表，配合 Aggregate 用。
    public List<RowGroup> GroupBy(string col) {
        DataCol key = this.ColOrThrow(col);
        List<RowGroup> groups = new List<RowGroup>();
        Dictionary<string, RowGroup> map = new Dictionary<string, RowGroup>();
        for (int r = 0; r < this.rowCount; r = r + 1) {
            string k = key.GetStr(r);
            RowGroup g;
            if (map.ContainsKey(k)) {
                g = map[k];
            } else {
                g = RowGroup.Create(k);
                map[k] = g;
                groups.Add(g);
            }
            g.rows.Add(r);
        }
        return groups;
    }

    // 对行号集合按列聚合，返回 double（Count 即行数）。
    // Int 列先累 long 求和避免精度损失；Str 列按数值解析。
    // 空集合：Sum/Count 得 0，Avg/Min/Max 得 0。
    // 行号集合按列聚合。
    //
    // **缺失值不参与聚合**（跳过，而不是当 0）：求和/均值/最值都只看
    // 有效格。`Agg.Count` 仍按行数算（要看有效值个数用
    // `Missing.ValidCount`）。
    //
    // 全部格子都缺失时返回 0.0（沿用本包"空集返回 0"的约定）——不是
    // NaN：NaN 会顺着下游的平均再平均，污染出一片垃圾。
    public double Aggregate(List<int> rows, string col, int op) {
        if (op == Agg.Count) { return (double)rows.Count; }
        DataCol c = this.ColOrThrow(col);
        if (rows.Count == 0) { return 0.0; }
        // 收集有效值（缺失的跳过）。
        int valid = 0;
        double sum = 0.0;
        double low = 0.0;
        double high = 0.0;
        for (int i = 0; i < rows.Count; i = i + 1) {
            int r = rows[i];
            if (c.IsMissing(r)) { continue; }
            double v = c.GetDouble(r);
            if (valid == 0) { low = v; high = v; }
            else {
                if (v < low) { low = v; }
                if (v > high) { high = v; }
            }
            sum = sum + v;
            valid = valid + 1;
        }
        if (valid == 0) { return 0.0; }
        if (op == Agg.Sum) { return sum; }
        if (op == Agg.Avg) { return sum / (double)valid; }
        if (op == Agg.Max) { return high; }
        return low;
    }

    // 行号集合按列求和。
    public double Sum(List<int> rows, string col) {
        return this.Aggregate(rows, col, Agg.Sum);
    }

    // 行号集合按列平均。
    public double Avg(List<int> rows, string col) {
        return this.Aggregate(rows, col, Agg.Avg);
    }

    // 行号集合按列最小值。
    public double Min(List<int> rows, string col) {
        return this.Aggregate(rows, col, Agg.Min);
    }

    // 行号集合按列最大值。
    public double Max(List<int> rows, string col) {
        return this.Aggregate(rows, col, Agg.Max);
    }

    // 内连接：以 left.keyCol == right.rightKeyCol 为等值条件
    // 的哈希连接。结果列为左表全部列加右表除键列外的列；右表列与
    // 左表撞名时加 "_1" 后缀。每对匹配行产出一行（左行序 × 右行序）。
    public DataFrame Join(DataFrame right, string keyCol, string rightKeyCol) {
        int li = this.ColIndex(keyCol);
        int ri = right.ColIndex(rightKeyCol);
        if (li < 0) {
            throw new InvalidOperationException("Join: 左表没有列: " + keyCol);
        }
        if (ri < 0) {
            throw new InvalidOperationException("Join: 右表没有列: " + rightKeyCol);
        }
        Dictionary<string, List<int>> map = new Dictionary<string, List<int>>();
        for (int r = 0; r < right.rowCount; r = r + 1) {
            string k = right.cols[ri].GetStr(r);
            if (!map.ContainsKey(k)) { map[k] = new List<int>(); }
            map[k].Add(r);
        }
        DataFrame outDf = new DataFrame();
        for (int c = 0; c < this.cols.Count; c = c + 1) {
            outDf.cols.Add(DataCol.Create(this.cols[c].Name(), this.cols[c].Kind()));
        }
        for (int c = 0; c < right.cols.Count; c = c + 1) {
            if (c == ri) { continue; }
            string name = right.cols[c].Name();
            if (this.ColIndex(name) >= 0) { name = name + "_1"; }
            outDf.cols.Add(DataCol.Create(name, right.cols[c].Kind()));
        }
        for (int r = 0; r < this.rowCount; r = r + 1) {
            string k = this.cols[li].GetStr(r);
            if (!map.ContainsKey(k)) { continue; }
            List<int> matches = map[k];
            for (int m = 0; m < matches.Count; m = m + 1) {
                for (int c = 0; c < this.cols.Count; c = c + 1) {
                    outDf.cols[c].AppendFrom(this.cols[c], r);
                }
                int oc = this.cols.Count;
                for (int c = 0; c < right.cols.Count; c = c + 1) {
                    if (c == ri) { continue; }
                    outDf.cols[oc].AppendFrom(right.cols[c], matches[m]);
                    oc = oc + 1;
                }
                outDf.rowCount = outDf.rowCount + 1;
            }
        }
        return outDf;
    }

    // 写出 CSV 文本：表头一行加数据行（CRLF 行尾），
    // 需要引号的字段按 Csv.Escape 处理。往返 Parse(ToCsv()) 等价。
    //
    // **缺失格写成空字段**（不是 "0"）——往返后仍是缺失。
    public string ToCsv() {
        StringBuilder sb = new StringBuilder();
        List<string> fields = new List<string>();
        for (int c = 0; c < this.cols.Count; c = c + 1) {
            fields.Add(this.cols[c].Name());
        }
        sb.Append(Csv.RowToText(fields));
        sb.Append("\r\n");
        for (int r = 0; r < this.rowCount; r = r + 1) {
            fields.Clear();
            for (int c = 0; c < this.cols.Count; c = c + 1) {
                if (this.cols[c].IsMissing(r)) { fields.Add(""); }
                else { fields.Add(this.cols[c].GetStr(r)); }
            }
            sb.Append(Csv.RowToText(fields));
            sb.Append("\r\n");
        }
        return sb.ToString();
    }
}

// 一次分组：键（单元格文本形态）+ 属于该组的行号列表。
