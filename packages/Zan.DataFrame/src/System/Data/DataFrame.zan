using System;
using Formats.Csv;
namespace System.Data;

// 列式内存表。
// 设计要点：
// - 列存：每列一个类型化列表（long/double/string），CSV 装载时
//   按整列内容做类型推断；空列推断为 Str。
// - 跨类型访问自动转换：Int 列 GetStr 得十进制文本，Float 列
//   GetLong 截断。
// - Filter/SortBy 返回新表；GroupBy 返回的行号组属于原表，
//   配合 Aggregate 系列使用。
// - Join 为内连接哈希实现：右表键列不进结果，其余右表列与左表
//   撞名时加 "_1" 后缀。
public class DataFrame {
    // 列集（顺序即列序）。
    public List<DataCol> cols;
    // 行数（各列长度恒等于它）。
    public int rowCount;

    public DataFrame() {
        this.cols = new List<DataCol>();
        this.rowCount = 0;
    }

    // 空表。
    public static DataFrame New() {
        return new DataFrame();
    }

    // 从 CSV 文本装载：首记录为表头，其后每记录一行；
    // 逐列推断类型。行数与表头列数不一致的记录按宽松规则补空串/
    // 截断（缺失字段补空，多余字段丢弃）。
    public static DataFrame FromCsv(string text) {
        CsvTable t = Csv.Parse(text);
        DataFrame df = new DataFrame();
        List<string> header = t.Header();
        if (t.RowCount() == 0 || header.Count == 0) { return df; }
        int rc = t.RowCount();
        for (int c = 0; c < header.Count; c = c + 1) {
            int kind = DataFrame.InferKind(t, c);
            DataCol col = DataCol.Create(header[c], kind);
            col.Reserve(rc);
            df.cols.Add(col);
        }
        df.rowCount = rc;
        List<List<string>> rows = t.Rows();
        int colCount = df.cols.Count;
        for (int r = 0; r < rows.Count; r = r + 1) {
            List<string> row = rows[r];
            int rowLen = row.Count;
            for (int c = 0; c < colCount; c = c + 1) {
                if (c < rowLen) { df.cols[c].Append(row[c]); }
                else { df.cols[c].Append(""); }
            }
        }
        return df;
    }

    // 第 at 列（0 起）的整列类型推断：全部像整数 → Int；
    // 全部像数值（整数或小数/指数形式）→ Float；否则 Str。
    //
    // **空字段不算"不像整数"**：空格子是"缺失"，不参与类型推断——
    // 否则 `1,,3` 会被推成 Str，数字列退化成文本列。
    // 整列全空 → Str（空串在 Int/Float 语境下无意义）。
    public static int InferKind(CsvTable t, int at) {
        List<List<string>> rows = t.Rows();
        bool allInt = true;
        bool allNum = true;
        bool anyValue = false;
        for (int r = 0; r < rows.Count; r = r + 1) {
            List<string> row = rows[r];
            string v = at < row.Count ? row[at] : "";
            if (v.Length == 0) { continue; }
            anyValue = true;
            bool isInt = DataFrame.LooksInt(v);
            if (!isInt) { allInt = false; }
            if (!isInt && !DataFrame.LooksFloat(v)) { allNum = false; }
            if (!allNum) { break; }
        }
        if (!anyValue) { return ColKind.Str; }
        if (allInt) { return ColKind.Int; }
        if (allNum) { return ColKind.Float; }
        return ColKind.Str;
    }

    // 严格十进制整数形态：可选 +/- 后全数字（不允许空白）。
    public static bool LooksInt(string s) {
        int n = s.Length;
        int i = 0;
        if (n > 0 && ((s[0] & 255) == 45 || (s[0] & 255) == 43)) { i = 1; }
        if (i >= n) { return false; }
        for (; i < n; i = i + 1) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { return false; }
        }
        return true;
    }

    // 严格数值形态：可选 +/- + 尾数（数字与至多一个小数点，至少一位数字）
    // 加可选指数（e/E [+/-] 数字）。排除 strtod 也接受的
    // inf/nan/十六进制与前后空白。
    public static bool LooksFloat(string s) {
        int n = s.Length;
        int i = 0;
        if (n > 0 && ((s[0] & 255) == 45 || (s[0] & 255) == 43)) { i = 1; }
        int digits = 0;
        int dots = 0;
        while (i < n) {
            int c = s[i] & 255;
            if (c >= 48 && c <= 57) { digits = digits + 1; i = i + 1; continue; }
            if (c == 46) {
                dots = dots + 1;
                if (dots > 1) { return false; }
                i = i + 1;
                continue;
            }
            break;
        }
        if (digits == 0) { return false; }
        if (i < n && ((s[i] & 255) == 101 || (s[i] & 255) == 69)) {
            i = i + 1;
            if (i < n && ((s[i] & 255) == 45 || (s[i] & 255) == 43)) { i = i + 1; }
            int expDigits = 0;
            while (i < n) {
                int c = s[i] & 255;
                if (c < 48 || c > 57) { break; }
                expDigits = expDigits + 1;
                i = i + 1;
            }
            if (expDigits == 0) { return false; }
        }
        return i == n;
    }

    // 加一列（ColKind 值）；新列以默认值补齐到当前行数。
    // 名字重复时本层不拦截（ColIndex 命中第一列）。
    //
    // 新列对已有行**没有值** → Int/Float 列的那些格子标记为**缺失**
    // （不是 0）。"这列在这行没填"与"这行填了 0"是两回事。
    public DataFrame AddColumn(string name, int kind) {
        DataCol c = DataCol.Create(name, kind);
        int rc = this.rowCount;
        c.Reserve(rc);
        if (kind == ColKind.Str) {
            for (int r = 0; r < rc; r = r + 1) { c.text.Add(""); }
        } else if (kind == ColKind.Int) {
            c.missing.Reserve(rc);
            for (int r = 0; r < rc; r = r + 1) { c.ints.Add(0); c.missing.Add(true); }
        } else {
            c.missing.Reserve(rc);
            for (int r = 0; r < rc; r = r + 1) { c.nums.Add(0.0); c.missing.Add(true); }
        }
        this.cols.Add(c);
        return this;
    }

    // 行数。
    public int Rows() { return this.rowCount; }

    // 列数。
    public int ColCount() { return this.cols.Count; }

    // 列名列表（按列序）。
    public List<string> Names() {
        List<string> names = new List<string>();
        for (int i = 0; i < this.cols.Count; i = i + 1) {
            names.Add(this.cols[i].Name());
        }
        return names;
    }

    // 列序号；不存在返回 -1（命中第一个同名列）。
    public int ColIndex(string name) {
        for (int i = 0; i < this.cols.Count; i = i + 1) {
            if (this.cols[i].Name() == name) { return i; }
        }
        return 0 - 1;
    }

    // 列类型（ColKind 值）；列不存在返回 ColKind.Str。
    public int Kind(string name) {
        int at = this.ColIndex(name);
        if (at < 0) { return ColKind.Str; }
        return this.cols[at].Kind();
    }

    // 追加一个空行，返回其行号。
    //
    // Int/Float 列的新格标记为**缺失**（不是 0）——空行就是"没填"。
    // 随后 `SetInt`/`SetFloat`/`SetStr` 写入的值会清掉缺失标记。
    public int AddRow() {
        int row = this.rowCount;
        this.rowCount = this.rowCount + 1;
        for (int c = 0; c < this.cols.Count; c = c + 1) {
            int kind = this.cols[c].Kind();
            if (kind == ColKind.Str) { this.cols[c].Append(""); }
            else if (kind == ColKind.Int) { this.cols[c].AppendLong(0); this.cols[c].MarkMissing(row); }
            else { this.cols[c].AppendDouble(0.0); this.cols[c].MarkMissing(row); }
        }
        return row;
    }

    // 追加一行并按字符串逐列填入（缺的补空、多的丢弃）。
    public void AddStrRow(params string[] cells) {
        int row = this.AddRow();
        for (int c = 0; c < this.cols.Count && c < cells.Length; c = c + 1) {
            this.cols[c].PutStr(row, cells[c]);
        }
    }

    // 追加一行并按 double 逐列填入（Int 列截断）。
    public void AddFloatRow(params double[] cells) {
        int row = this.AddRow();
        for (int c = 0; c < this.cols.Count && c < cells.Length; c = c + 1) {
            this.cols[c].PutDouble(row, cells[c]);
        }
    }

    // 列存在性守卫：抛出带列名的异常。
    public DataCol ColOrThrow(string name) {
        int at = this.ColIndex(name);
        if (at < 0) {
            throw new InvalidOperationException("DataFrame 没有列: " + name);
        }
        return this.cols[at];
    }

    // 把某列转成新类型（**就地改**，返回本表便于链式调用）。
    //
    // 值按 GetDouble/GetStr 口径转换，**缺失标记原样保留**（转类型不该
    // 改变"有没有值"这件事）。
    //
    // 为什么需要它：往 Int 列填小数时不能截断——1.5 填进 Int 列会变成
    // 1，静默算错。所以要填小数先把列**升成 Float**。
    //
    // Str → 数值列时，空串算缺失（与 CSV 装载同口径）；非空但不是数值的
    // 文本按 Convert.ToDouble 的解析结果（解析不了得 0.0，与本包其它
    // 跨类型访问一致）。
    public DataFrame CastColumn(string name, int kind) {
        int at = this.ColIndex(name);
        if (at < 0) {
            throw new InvalidOperationException("DataFrame 没有列: " + name);
        }
        DataCol old = this.cols[at];
        if (old.Kind() == kind) { return this; }
        DataCol c = DataCol.Create(old.Name(), kind);
        for (int r = 0; r < old.Count(); r = r + 1) {
            bool miss = old.IsMissing(r);
            if (kind == ColKind.Str) {
                c.Append(miss ? "" : old.GetStr(r));
            } else if (kind == ColKind.Int) {
                if (miss) { c.AppendLong(0); c.MarkMissing(r); }
                else { c.AppendLong(old.GetLong(r)); }
            } else {
                if (miss) { c.AppendDouble(0.0); c.MarkMissing(r); }
                else { c.AppendDouble(old.GetDouble(r)); }
            }
        }
        this.cols[at] = c;
        return this;
    }

    // 读单元格为文本。
    public string GetStr(int row, int col) {
        if (col < 0 || col >= this.cols.Count) { return ""; }
        return this.cols[col].GetStr(row);
    }

    // 按列名读单元格为文本。
    public string GetStr(int row, string col) {
        return this.ColOrThrow(col).GetStr(row);
    }

    // 读单元格为 64 位整数（Float 列截断；Str 列按 strtoll 前缀）。
    public long GetInt(int row, int col) {
        if (col < 0 || col >= this.cols.Count) { return 0; }
        return this.cols[col].GetLong(row);
    }

    public long GetInt(int row, string col) {
        return this.ColOrThrow(col).GetLong(row);
    }

    // 读单元格为 double（Int 列提升；Str 列按 strtod 前缀）。
    public double GetFloat(int row, int col) {
        if (col < 0 || col >= this.cols.Count) { return 0.0; }
        return this.cols[col].GetDouble(row);
    }

    public double GetFloat(int row, string col) {
        return this.ColOrThrow(col).GetDouble(row);
    }

    // 写单元格（文本形态，按列类型转换）。
    public void SetStr(int row, int col, string v) {
        this.cols[col].PutStr(row, v);
    }

    public void SetStr(int row, string col, string v) {
        this.ColOrThrow(col).PutStr(row, v);
    }

    // 写单元格（64 位整数）。
    public void SetInt(int row, int col, long v) {
        this.cols[col].PutLong(row, v);
    }

    public void SetInt(int row, string col, long v) {
        this.ColOrThrow(col).PutLong(row, v);
    }

    // 写单元格（double；Int 列截断）。
    public void SetFloat(int row, int col, double v) {
        this.cols[col].PutDouble(row, v);
    }

    public void SetFloat(int row, string col, double v) {
        this.ColOrThrow(col).PutDouble(row, v);
    }

    // 过滤：谓词为 true 的行组成新表（同一 schema），列式批量物化。
    // 谓词闭包可捕获本帧读取任意单元格。
    public DataFrame Filter(RowFn fn) {
        List<int> matched = new List<int>();
        int n = this.rowCount;
        for (int r = 0; r < n; r = r + 1) {
            if (fn(r)) { matched.Add(r); }
        }
        DataFrame outDf = new DataFrame();
        outDf.rowCount = matched.Count;
        for (int c = 0; c < this.cols.Count; c = c + 1) {
            DataCol src = this.cols[c];
            DataCol dst = DataCol.Create(src.Name(), src.Kind());
            dst.GatherFromList(src, matched);
            outDf.cols.Add(dst);
        }
        return outDf;
    }

    // 深拷贝：同 schema 同值的新表（列式整列复制，列存不共享）。
    // 改新表不影响原表。
    public DataFrame Copy() {
        DataFrame outDf = new DataFrame();
        outDf.rowCount = this.rowCount;
        for (int c = 0; c < this.cols.Count; c = c + 1) {
            DataCol src = this.cols[c];
            DataCol dst = DataCol.Create(src.Name(), src.Kind());
            dst.CopyFrom(src);
            outDf.cols.Add(dst);
        }
        return outDf;
    }

    // 全部行号（0..Rows()-1），供 Aggregate 系列整表聚合使用。
    public List<int> AllRows() {
        List<int> all = new List<int>();
        all.Reserve(this.rowCount);
        for (int r = 0; r < this.rowCount; r = r + 1) { all.Add(r); }
        return all;
    }

    // 按列稳定排序（相等保持原相对顺序），返回新表。
    // desc 为 true 时降序。列不存在抛异常。
    public DataFrame SortBy(string col, bool desc) {
        DataCol key = this.ColOrThrow(col);
        int n = this.rowCount;
        int[] idx = new int[n];
        for (int r = 0; r < n; r = r + 1) { idx[r] = r; }
        if (n >= 2) {
            int[] tmp = new int[n];
            int kind = key.Kind();
            if (kind == ColKind.Int) {
                DataFrame.MergeSortInt(idx, tmp, 0, n, key.ints, desc);
            } else if (kind == ColKind.Float) {
                DataFrame.MergeSortFloat(idx, tmp, 0, n, key.nums, desc);
            } else {
                DataFrame.MergeSortStr(idx, tmp, 0, n, key.text, desc);
            }
        }
        DataFrame outDf = new DataFrame();
        outDf.rowCount = n;
        for (int c = 0; c < this.cols.Count; c = c + 1) {
            DataCol src = this.cols[c];
            DataCol dst = DataCol.Create(src.Name(), src.Kind());
            dst.GatherFromArray(src, idx, n);
            outDf.cols.Add(dst);
        }
        return outDf;
    }

    private static void MergeSortInt(int[] idx, int[] tmp, int lo, int hi, List<long> vals, bool desc) {
        int len = hi - lo;
        if (len <= 16) {
            for (int i = lo + 1; i < hi; i = i + 1) {
                int cur = idx[i];
                long cv = vals[cur];
                int j = i - 1;
                if (desc) {
                    while (j >= lo && cv > vals[idx[j]]) {
                        idx[j + 1] = idx[j];
                        j = j - 1;
                    }
                } else {
                    while (j >= lo && cv < vals[idx[j]]) {
                        idx[j + 1] = idx[j];
                        j = j - 1;
                    }
                }
                idx[j + 1] = cur;
            }
            return;
        }
        int mid = lo + (len >> 1);
        DataFrame.MergeSortInt(idx, tmp, lo, mid, vals, desc);
        DataFrame.MergeSortInt(idx, tmp, mid, hi, vals, desc);
        int a = lo;
        int b = mid;
        int k = lo;
        if (desc) {
            while (a < mid && b < hi) {
                if (vals[idx[b]] > vals[idx[a]]) { tmp[k] = idx[b]; b = b + 1; }
                else { tmp[k] = idx[a]; a = a + 1; }
                k = k + 1;
            }
        } else {
            while (a < mid && b < hi) {
                if (vals[idx[b]] < vals[idx[a]]) { tmp[k] = idx[b]; b = b + 1; }
                else { tmp[k] = idx[a]; a = a + 1; }
                k = k + 1;
            }
        }
        while (a < mid) { tmp[k] = idx[a]; a = a + 1; k = k + 1; }
        while (b < hi) { tmp[k] = idx[b]; b = b + 1; k = k + 1; }
        NativeMemory.Copy((nint)idx + (nint)lo * 4, (nint)tmp + (nint)lo * 4, (nint)len * 4);
    }

    private static void MergeSortFloat(int[] idx, int[] tmp, int lo, int hi, List<double> vals, bool desc) {
        int len = hi - lo;
        if (len <= 16) {
            for (int i = lo + 1; i < hi; i = i + 1) {
                int cur = idx[i];
                double cv = vals[cur];
                int j = i - 1;
                if (desc) {
                    while (j >= lo && cv > vals[idx[j]]) {
                        idx[j + 1] = idx[j];
                        j = j - 1;
                    }
                } else {
                    while (j >= lo && cv < vals[idx[j]]) {
                        idx[j + 1] = idx[j];
                        j = j - 1;
                    }
                }
                idx[j + 1] = cur;
            }
            return;
        }
        int mid = lo + (len >> 1);
        DataFrame.MergeSortFloat(idx, tmp, lo, mid, vals, desc);
        DataFrame.MergeSortFloat(idx, tmp, mid, hi, vals, desc);
        int a = lo;
        int b = mid;
        int k = lo;
        if (desc) {
            while (a < mid && b < hi) {
                if (vals[idx[b]] > vals[idx[a]]) { tmp[k] = idx[b]; b = b + 1; }
                else { tmp[k] = idx[a]; a = a + 1; }
                k = k + 1;
            }
        } else {
            while (a < mid && b < hi) {
                if (vals[idx[b]] < vals[idx[a]]) { tmp[k] = idx[b]; b = b + 1; }
                else { tmp[k] = idx[a]; a = a + 1; }
                k = k + 1;
            }
        }
        while (a < mid) { tmp[k] = idx[a]; a = a + 1; k = k + 1; }
        while (b < hi) { tmp[k] = idx[b]; b = b + 1; k = k + 1; }
        NativeMemory.Copy((nint)idx + (nint)lo * 4, (nint)tmp + (nint)lo * 4, (nint)len * 4);
    }

    private static void MergeSortStr(int[] idx, int[] tmp, int lo, int hi, List<string> vals, bool desc) {
        int len = hi - lo;
        if (len <= 16) {
            for (int i = lo + 1; i < hi; i = i + 1) {
                int cur = idx[i];
                string cv = vals[cur];
                int j = i - 1;
                if (desc) {
                    while (j >= lo && cv.CompareTo(vals[idx[j]]) > 0) {
                        idx[j + 1] = idx[j];
                        j = j - 1;
                    }
                } else {
                    while (j >= lo && cv.CompareTo(vals[idx[j]]) < 0) {
                        idx[j + 1] = idx[j];
                        j = j - 1;
                    }
                }
                idx[j + 1] = cur;
            }
            return;
        }
        int mid = lo + (len >> 1);
        DataFrame.MergeSortStr(idx, tmp, lo, mid, vals, desc);
        DataFrame.MergeSortStr(idx, tmp, mid, hi, vals, desc);
        int a = lo;
        int b = mid;
        int k = lo;
        if (desc) {
            while (a < mid && b < hi) {
                if (vals[idx[b]].CompareTo(vals[idx[a]]) > 0) { tmp[k] = idx[b]; b = b + 1; }
                else { tmp[k] = idx[a]; a = a + 1; }
                k = k + 1;
            }
        } else {
            while (a < mid && b < hi) {
                if (vals[idx[b]].CompareTo(vals[idx[a]]) < 0) { tmp[k] = idx[b]; b = b + 1; }
                else { tmp[k] = idx[a]; a = a + 1; }
                k = k + 1;
            }
        }
        while (a < mid) { tmp[k] = idx[a]; a = a + 1; k = k + 1; }
        while (b < hi) { tmp[k] = idx[b]; b = b + 1; k = k + 1; }
        NativeMemory.Copy((nint)idx + (nint)lo * 4, (nint)tmp + (nint)lo * 4, (nint)len * 4);
    }

    // 归并排序（稳定）：对 idx[lo, hi) 排序，tmp 为工作缓冲。
    public static void MergeSort(List<int> idx, List<int> tmp, int lo, int hi,
    RowCmpFn cmp) {
        if (hi - lo < 2) { return; }
        int mid = lo + (hi - lo) / 2;
        DataFrame.MergeSort(idx, tmp, lo, mid, cmp);
        DataFrame.MergeSort(idx, tmp, mid, hi, cmp);
        int a = lo;
        int b = mid;
        tmp.Clear();
        while (a < mid && b < hi) {
            if (cmp(idx[b], idx[a]) < 0) { tmp.Add(idx[b]); b = b + 1; }
            else { tmp.Add(idx[a]); a = a + 1; }  // 取左保稳定
        }
        while (a < mid) { tmp.Add(idx[a]); a = a + 1; }
        while (b < hi) { tmp.Add(idx[b]); b = b + 1; }
        for (int i = 0; i < tmp.Count; i = i + 1) {
            idx[lo + i] = tmp[i];
        }
    }

    // 按列分组：键为单元格文本形态，组按首次出现顺序排列。
    // 返回的 RowGroup.Rows() 是本表的行号列表，配合 Aggregate 用。
    public List<RowGroup> GroupBy(string col) {
        DataCol key = this.ColOrThrow(col);
        List<RowGroup> groups = new List<RowGroup>();
        int kind = key.kind;
        int n = this.rowCount;
        if (kind == ColKind.Int) {
            // 整数键快路径：直接以 long 哈希，仅在新建组时格式化一次字符串；缺失值单独成组，不与 0 碰撞。
            List<long> vals = key.ints;
            Dictionary<long, RowGroup> map = new Dictionary<long, RowGroup>();
            RowGroup missGroup = null;
            for (int r = 0; r < n; r = r + 1) {
                if (key.IsMissing(r)) {
                    if (missGroup == null) {
                        missGroup = RowGroup.Create("");
                        groups.Add(missGroup);
                    }
                    missGroup.rows.Add(r);
                    continue;
                }
                long k = vals[r];
                RowGroup g = null;
                if (!map.TryGetValue(k, out g)) {
                    g = RowGroup.Create(Convert.ToString(k));
                    map[k] = g;
                    groups.Add(g);
                }
                g.rows.Add(r);
            }
            return groups;
        }
        if (kind == ColKind.Str) {
            List<string> vals = key.text;
            Dictionary<string, RowGroup> map = new Dictionary<string, RowGroup>();
            for (int r = 0; r < n; r = r + 1) {
                string k = vals[r];
                RowGroup g = null;
                if (!map.TryGetValue(k, out g)) {
                    g = RowGroup.Create(k);
                    map[k] = g;
                    groups.Add(g);
                }
                g.rows.Add(r);
            }
            return groups;
        }
        Dictionary<string, RowGroup> fmap = new Dictionary<string, RowGroup>();
        for (int r = 0; r < n; r = r + 1) {
            string k = key.IsMissing(r) ? "" : key.GetStr(r);
            RowGroup g = null;
            if (!fmap.TryGetValue(k, out g)) {
                g = RowGroup.Create(k);
                fmap[k] = g;
                groups.Add(g);
            }
            g.rows.Add(r);
        }
        return groups;
    }

    // 对行号集合按列聚合，返回 double（Count 即行数）。
    // Int 列先累 long 求和避免精度损失；Str 列按数值解析。
    // 空集合：Sum/Count 得 0，Avg/Min/Max 得 0。
    // 行号集合按列聚合。
    //
    // **缺失值不参与聚合**（跳过，而不是当 0）：求和/均值/最值都只看
    // 有效格。`Agg.Count` 仍按行数算（要看有效值个数用
    // `Missing.ValidCount`）。
    //
    // 全部格子都缺失时返回 0.0（沿用本包"空集返回 0"的约定）——不是
    // NaN：NaN 会顺着下游的平均再平均，污染出一片垃圾。
    public double Aggregate(List<int> rows, string col, int op) {
        if (op == Agg.Count) { return (double)rows.Count; }
        DataCol c = this.ColOrThrow(col);
        int n = rows.Count;
        if (n == 0) { return 0.0; }
        if (c.missing.Count == 0) {
            if (c.kind == ColKind.Float) {
                List<double> nums = c.nums;
                if (op == Agg.Sum || op == Agg.Avg) {
                    double sum = 0.0;
                    for (int i = 0; i < n; i = i + 1) { sum = sum + nums[rows[i]]; }
                    return op == Agg.Sum ? sum : sum / (double)n;
                }
                if (op == Agg.Max) {
                    double hi = nums[rows[0]];
                    for (int i = 1; i < n; i = i + 1) {
                        double v = nums[rows[i]];
                        if (v > hi) { hi = v; }
                    }
                    return hi;
                }
                double lo = nums[rows[0]];
                for (int i = 1; i < n; i = i + 1) {
                    double v = nums[rows[i]];
                    if (v < lo) { lo = v; }
                }
                return lo;
            }
            if (c.kind == ColKind.Int) {
                List<long> ints = c.ints;
                if (op == Agg.Sum || op == Agg.Avg) {
                    double sum = 0.0;
                    for (int i = 0; i < n; i = i + 1) { sum = sum + (double)ints[rows[i]]; }
                    return op == Agg.Sum ? sum : sum / (double)n;
                }
                if (op == Agg.Max) {
                    long hi = ints[rows[0]];
                    for (int i = 1; i < n; i = i + 1) {
                        long v = ints[rows[i]];
                        if (v > hi) { hi = v; }
                    }
                    return (double)hi;
                }
                long lo = ints[rows[0]];
                for (int i = 1; i < n; i = i + 1) {
                    long v = ints[rows[i]];
                    if (v < lo) { lo = v; }
                }
                return (double)lo;
            }
        }
        // 收集有效值（缺失的跳过）。
        int valid = 0;
        double sum2 = 0.0;
        double low = 0.0;
        double high = 0.0;
        for (int i = 0; i < n; i = i + 1) {
            int r = rows[i];
            if (c.IsMissing(r)) { continue; }
            double v = c.GetDouble(r);
            if (valid == 0) { low = v; high = v; }
            else {
                if (v < low) { low = v; }
                if (v > high) { high = v; }
            }
            sum2 = sum2 + v;
            valid = valid + 1;
        }
        if (valid == 0) { return 0.0; }
        if (op == Agg.Sum) { return sum2; }
        if (op == Agg.Avg) { return sum2 / (double)valid; }
        if (op == Agg.Max) { return high; }
        return low;
    }

    // 行号集合按列求和。
    public double Sum(List<int> rows, string col) {
        return this.Aggregate(rows, col, Agg.Sum);
    }

    // 行号集合按列平均。
    public double Avg(List<int> rows, string col) {
        return this.Aggregate(rows, col, Agg.Avg);
    }

    // 行号集合按列最小值。
    public double Min(List<int> rows, string col) {
        return this.Aggregate(rows, col, Agg.Min);
    }

    // 行号集合按列最大值。
    public double Max(List<int> rows, string col) {
        return this.Aggregate(rows, col, Agg.Max);
    }

    // 内连接：以 left.keyCol == right.rightKeyCol 为等值条件
    // 的哈希连接。结果列为左表全部列加右表除键列外的列；右表列与
    // 左表撞名时加 "_1" 后缀。每对匹配行产出一行（左行序 × 右行序）。
    public DataFrame Join(DataFrame right, string keyCol, string rightKeyCol) {
        int li = this.ColIndex(keyCol);
        int ri = right.ColIndex(rightKeyCol);
        if (li < 0) {
            throw new InvalidOperationException("Join: 左表没有列: " + keyCol);
        }
        if (ri < 0) {
            throw new InvalidOperationException("Join: 右表没有列: " + rightKeyCol);
        }
        DataCol lKey = this.cols[li];
        DataCol rKey = right.cols[ri];
        List<int> matchedL = new List<int>();
        List<int> matchedR = new List<int>();
        if (lKey.kind == ColKind.Int && rKey.kind == ColKind.Int) {
            // 双侧整数键：直接 long 哈希，零字符串分配；缺失值单独分桶，避免与 0 误匹配。
            List<long> rVals = rKey.ints;
            Dictionary<long, List<int>> map = new Dictionary<long, List<int>>();
            List<int> missingR = null;
            for (int r = 0; r < right.rowCount; r = r + 1) {
                if (rKey.IsMissing(r)) {
                    if (missingR == null) { missingR = new List<int>(); }
                    missingR.Add(r);
                    continue;
                }
                long k = rVals[r];
                List<int> bucket = null;
                if (!map.TryGetValue(k, out bucket)) {
                    bucket = new List<int>();
                    map[k] = bucket;
                }
                bucket.Add(r);
            }
            List<long> lVals = lKey.ints;
            for (int r = 0; r < this.rowCount; r = r + 1) {
                List<int> matches = null;
                if (lKey.IsMissing(r)) {
                    matches = missingR;
                    if (matches == null) { continue; }
                } else if (!map.TryGetValue(lVals[r], out matches)) {
                    continue;
                }
                for (int m = 0; m < matches.Count; m = m + 1) {
                    matchedL.Add(r);
                    matchedR.Add(matches[m]);
                }
            }
        } else {
            Dictionary<string, List<int>> map = new Dictionary<string, List<int>>();
            for (int r = 0; r < right.rowCount; r = r + 1) {
                string k = rKey.IsMissing(r) ? "" : rKey.GetStr(r);
                List<int> bucket = null;
                if (!map.TryGetValue(k, out bucket)) {
                    bucket = new List<int>();
                    map[k] = bucket;
                }
                bucket.Add(r);
            }
            for (int r = 0; r < this.rowCount; r = r + 1) {
                string k = lKey.IsMissing(r) ? "" : lKey.GetStr(r);
                List<int> matches = null;
                if (!map.TryGetValue(k, out matches)) { continue; }
                for (int m = 0; m < matches.Count; m = m + 1) {
                    matchedL.Add(r);
                    matchedR.Add(matches[m]);
                }
            }
        }
        DataFrame outDf = new DataFrame();
        outDf.rowCount = matchedL.Count;
        for (int c = 0; c < this.cols.Count; c = c + 1) {
            DataCol src = this.cols[c];
            DataCol dst = DataCol.Create(src.Name(), src.Kind());
            dst.GatherFromList(src, matchedL);
            outDf.cols.Add(dst);
        }
        for (int c = 0; c < right.cols.Count; c = c + 1) {
            if (c == ri) { continue; }
            DataCol src = right.cols[c];
            string name = src.Name();
            if (this.ColIndex(name) >= 0) { name = name + "_1"; }
            DataCol dst = DataCol.Create(name, src.Kind());
            dst.GatherFromList(src, matchedR);
            outDf.cols.Add(dst);
        }
        return outDf;
    }

    // 写出 CSV 文本：表头一行加数据行（CRLF 行尾），
    // 需要引号的字段按 Csv.Escape 处理。往返 Parse(ToCsv()) 等价。
    //
    // **缺失格写成空字段**（不是 "0"）——往返后仍是缺失。
    public string ToCsv() {
        StringBuilder sb = new StringBuilder();
        List<string> fields = new List<string>();
        for (int c = 0; c < this.cols.Count; c = c + 1) {
            fields.Add(this.cols[c].Name());
        }
        sb.Append(Csv.RowToText(fields));
        sb.Append("\r\n");
        for (int r = 0; r < this.rowCount; r = r + 1) {
            fields.Clear();
            for (int c = 0; c < this.cols.Count; c = c + 1) {
                if (this.cols[c].IsMissing(r)) { fields.Add(""); }
                else { fields.Add(this.cols[c].GetStr(r)); }
            }
            sb.Append(Csv.RowToText(fields));
            sb.Append("\r\n");
        }
        return sb.ToString();
    }
}
