using System;

namespace System.Data;

// 窗口函数：按行计数的滑动窗口（Rolling）与指数加权移动平均（Ewm）。
// 结果写进新 Float 列（避免 Int 列截断小数）；不用 NaN 表达未算出的行，不足 minPeriods 或 Diff 前 periods 行保持 0.0。
public class Window {
    // 滑动窗口聚合（window<1 视作 1；minPeriods 默认 1，超过 window 按 window 计；outCol 空串默认 "<列>_rolling"）。
    public static DataFrame Rolling(DataFrame df, string valueCol, int window,
            int agg, int minPeriods, string outCol) {
        if (df == null) { throw new InvalidOperationException("Rolling: 表为 null"); }
        int valAt = df.ColIndex(valueCol);
        if (valAt < 0) { throw new InvalidOperationException("Rolling 没有列: " + valueCol); }
        if (window < 1) { window = 1; }
        int need = minPeriods < 1 ? 1 : minPeriods;
        if (need > window) { need = window; }

        DataFrame outp = df.Copy();
        int outAt = Window.EnsureFloatCol(outp, outCol, valueCol + "_rolling");
        int n = df.Rows();
        if (n == 0) { return outp; }
        DataCol src = df.cols[valAt];
        DataCol dst = outp.cols[outAt];

        if (agg == Agg.Count) {
            for (int r = 0; r < n; r = r + 1) {
                int lo = r - window + 1;
                if (lo < 0) { lo = 0; }
                int cnt = r - lo + 1;
                if (cnt >= need) { dst.PutDouble(r, (double)cnt); }
            }
            return outp;
        }

        // 无缺失数值列 O(N) / 零分配滑动窗口快路径。
        if (src.missing.Count == 0 && (src.kind == ColKind.Float || src.kind == ColKind.Int)) {
            double[] vals = new double[n];
            if (src.kind == ColKind.Float) {
                List<double> sn = src.nums;
                for (int r = 0; r < n; r = r + 1) { vals[r] = sn[r]; }
            } else {
                List<long> si = src.ints;
                for (int r = 0; r < n; r = r + 1) { vals[r] = (double)si[r]; }
            }
            if (agg == Agg.Sum || agg == Agg.Avg) {
                if (src.kind == ColKind.Int) {
                    // 整数求和 O(N) 滑动窗口，无浮点误差。
                    List<long> si = src.ints;
                    long run = 0;
                    for (int r = 0; r < n; r = r + 1) {
                        run = run + si[r];
                        if (r >= window) { run = run - si[r - window]; }
                        int cnt = r + 1 < window ? r + 1 : window;
                        if (cnt >= need) {
                            dst.PutDouble(r, agg == Agg.Sum ? (double)run : (double)run / (double)cnt);
                        }
                    }
                    return outp;
                }
                if (window <= 32) {
                    for (int r = 0; r < n; r = r + 1) {
                        int lo = r - window + 1;
                        if (lo < 0) { lo = 0; }
                        int cnt = r - lo + 1;
                        if (cnt < need) { continue; }
                        double s = 0.0;
                        for (int i = lo; i <= r; i = i + 1) { s = s + vals[i]; }
                        dst.PutDouble(r, agg == Agg.Sum ? s : s / (double)cnt);
                    }
                    return outp;
                }
                double runD = 0.0;
                for (int r = 0; r < n; r = r + 1) {
                    runD = runD + vals[r];
                    if (r >= window) { runD = runD - vals[r - window]; }
                    int cnt = r + 1 < window ? r + 1 : window;
                    if (cnt >= need) {
                        dst.PutDouble(r, agg == Agg.Sum ? runD : runD / (double)cnt);
                    }
                }
                return outp;
            }
            // Agg.Min / Agg.Max：单调双端队列 O(N) 且逐位精确。
            int[] dq = new int[n];
            int head = 0;
            int tail = 0;
            bool isMax = agg == Agg.Max;
            for (int r = 0; r < n; r = r + 1) {
                int lo = r - window + 1;
                if (lo < 0) { lo = 0; }
                while (head < tail && dq[head] < lo) { head = head + 1; }
                double vr = vals[r];
                if (isMax) {
                    while (head < tail && vals[dq[tail - 1]] <= vr) { tail = tail - 1; }
                } else {
                    while (head < tail && vals[dq[tail - 1]] >= vr) { tail = tail - 1; }
                }
                dq[tail] = r;
                tail = tail + 1;
                int cnt = r - lo + 1;
                if (cnt >= need) { dst.PutDouble(r, vals[dq[head]]); }
            }
            return outp;
        }

        // 通用路径（含缺失值或 Str 列）：直接扫描窗口，零 windowRows 分配。
        for (int r = 0; r < n; r = r + 1) {
            int lo = r - window + 1;
            if (lo < 0) { lo = 0; }
            if (r - lo + 1 < need) { continue; }
            int valid = 0;
            double sum = 0.0;
            double low = 0.0;
            double high = 0.0;
            for (int i = lo; i <= r; i = i + 1) {
                if (src.IsMissing(i)) { continue; }
                double v = src.GetDouble(i);
                if (valid == 0) { low = v; high = v; }
                else {
                    if (v < low) { low = v; }
                    if (v > high) { high = v; }
                }
                sum = sum + v;
                valid = valid + 1;
            }
            double res = 0.0;
            if (valid > 0) {
                if (agg == Agg.Sum) { res = sum; }
                else if (agg == Agg.Avg) { res = sum / (double)valid; }
                else if (agg == Agg.Max) { res = high; }
                else { res = low; }
            }
            dst.PutDouble(r, res);
        }
        return outp;
    }

    public static DataFrame Rolling(DataFrame df, string valueCol, int window, int agg) {
        return Window.Rolling(df, valueCol, window, agg, 1, "");
    }

    public static DataFrame Rolling(DataFrame df, string valueCol, int window, int agg, int minPeriods) {
        return Window.Rolling(df, valueCol, window, agg, minPeriods, "");
    }

    // 滑动窗口有效性掩码（与行号一一对应，表示样本数是否达到 minPeriods）。
    public static List<bool> RollingValid(DataFrame df, string valueCol, int window, int minPeriods) {
        List<bool> mask = new List<bool>();
        if (df == null) { return mask; }
        if (df.ColIndex(valueCol) < 0) { throw new InvalidOperationException("RollingValid 没有列: " + valueCol); }
        if (window < 1) { window = 1; }
        int need = minPeriods < 1 ? 1 : minPeriods;
        if (need > window) { need = window; }
        for (int r = 0; r < df.Rows(); r = r + 1) {
            int lo = r - window + 1;
            if (lo < 0) { lo = 0; }
            mask.Add((r - lo + 1) >= need);
        }
        return mask;
    }

    public static List<bool> RollingValid(DataFrame df, string valueCol, int window) {
        return Window.RollingValid(df, valueCol, window, 1);
    }

    // 指数加权移动平均：adjust=true 按权重和归一；adjust=false 首行取 x[0] 后按 α·x + (1-α)·y 递推。
    public static DataFrame Ewm(DataFrame df, string valueCol, double alpha,
            bool adjust, string outCol) {
        if (df == null) { throw new InvalidOperationException("Ewm: 表为 null"); }
        int at = df.ColIndex(valueCol);
        if (at < 0) { throw new InvalidOperationException("Ewm 没有列: " + valueCol); }
        if (alpha <= 0.0 || alpha > 1.0) {
            throw new InvalidOperationException("Ewm: alpha 必须在 (0,1]");
        }
        DataFrame outp = df.Copy();
        int outAt = Window.EnsureFloatCol(outp, outCol, valueCol + "_ewm");
        int n = df.Rows();
        DataCol src = df.cols[at];
        DataCol dst = outp.cols[outAt];
        double decay = 1.0 - alpha;
        if (adjust) {
            double num = 0.0;
            double w = 0.0;
            for (int r = 0; r < n; r = r + 1) {
                double x = src.GetDouble(r);
                num = x + decay * num;
                w = 1.0 + decay * w;
                dst.PutDouble(r, num / w);
            }
            return outp;
        }
        if (n > 0) {
            double y = src.GetDouble(0);
            dst.PutDouble(0, y);
            for (int r = 1; r < n; r = r + 1) {
                y = alpha * src.GetDouble(r) + decay * y;
                dst.PutDouble(r, y);
            }
        }
        return outp;
    }

    public static DataFrame Ewm(DataFrame df, string valueCol, double alpha) {
        return Window.Ewm(df, valueCol, alpha, true, "");
    }

    public static DataFrame Ewm(DataFrame df, string valueCol, double alpha, bool adjust) {
        return Window.Ewm(df, valueCol, alpha, adjust, "");
    }

    // 差分 x[t] - x[t-periods]；前 periods 行不写值，outCol 空串默认 "<列>_diff"。
    public static DataFrame Diff(DataFrame df, string valueCol, int periods, string outCol) {
        if (df == null) { throw new InvalidOperationException("Diff: 表为 null"); }
        int at = df.ColIndex(valueCol);
        if (at < 0) { throw new InvalidOperationException("Diff 没有列: " + valueCol); }
        if (periods < 1) { periods = 1; }
        DataFrame outp = df.Copy();
        int outAt = Window.EnsureFloatCol(outp, outCol, valueCol + "_diff");
        DataCol src = df.cols[at];
        DataCol dst = outp.cols[outAt];
        int n = outp.Rows();
        for (int r = periods; r < n; r = r + 1) {
            double cur = src.GetDouble(r);
            double prev = src.GetDouble(r - periods);
            dst.PutDouble(r, cur - prev);
        }
        return outp;
    }

    public static DataFrame Diff(DataFrame df, string valueCol, int periods) {
        return Window.Diff(df, valueCol, periods, "");
    }

    private static int EnsureFloatCol(DataFrame outp, string outCol, string fallback) {
        string name = (outCol == null || outCol.Length == 0) ? fallback : outCol;
        int outAt = outp.ColIndex(name);
        if (outAt < 0) {
            outp.AddColumn(name, ColKind.Float);
            outAt = outp.cols.Count - 1;
        }
        return outAt;
    }
}
