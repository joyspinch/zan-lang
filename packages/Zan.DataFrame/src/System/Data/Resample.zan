using System;

namespace System.Data;

// 时序重采样：把不等间隔的时间序列聚合成等间隔的桶。
//
// 时间列用 **Unix 秒**（long）——这是最通用且无歧义的形式：日期
// 列、口径不同的其它来源都能先转成秒再进来。字符串日期要自己先
// 转（DateTime.ParseDate 只认 "YYYY-MM-DD"，FromParts 可造全量）。
//
// 桶边界：**左闭右开**（[start, end)），与 pandas 的 resample 语义
// 一致。桶标签是该桶的**起始时刻**（unix 秒）。
//
// 空桶：**不产生行**（不是补 0）。补 0 会让"这段时间没数据"和
// "这段时间销量为 0"混为一谈——这在时序上是最容易出错的地方。

public class Resample {
    // 按频率重采样：timeCol 是 unix 秒列，valueCol 是数值列，
    // agg 是聚合算子。
    //
    // 输出表：time（桶起始 unix 秒）+ value（聚合结果）。
    // 行序按桶起始时刻升序。
    //
    // 桶边界（左闭右开）：
    // - Second/Minute/Hour/Day：从 Unix 纪元对齐的固定间隔
    // - Week：以周一 00:00 为起点（Unix 纪元 1970-01-01 是周四，
    //   所以第一周的起点要往前退到上一个周一）
    // - Month：自然月边界
    public static DataFrame ResampleBy(DataFrame df, string timeCol,
            string valueCol, int freq, int agg) {
        if (df == null) { throw new InvalidOperationException("ResampleBy: 表为 null"); }
        int tAt = df.ColIndex(timeCol);
        if (tAt < 0) { throw new InvalidOperationException("ResampleBy 没有列: " + timeCol); }
        int vAt = df.ColIndex(valueCol);
        if (vAt < 0) { throw new InvalidOperationException("ResampleBy 没有列: " + valueCol); }

        DataCol tCol = df.cols[tAt];
        DataCol vCol = df.cols[vAt];
        int nRows = df.Rows();
        bool tIsInt = tCol.kind == ColKind.Int;
        bool vIsFloat = vCol.kind == ColKind.Float;
        bool vIsInt = vCol.kind == ColKind.Int;
        bool vHasMiss = vCol.missing.Count > 0;
        List<long> tInts = tIsInt ? tCol.ints : null;
        List<double> vNums = vIsFloat ? vCol.nums : null;
        List<long> vInts = vIsInt ? vCol.ints : null;

        // 单遍流式聚合：消除每桶 List<int> 堆分配与二次遍历；缓存最近桶 [cacheStart, cacheEnd) 区间，
        // 对有序/局部有序时序免去重复日期分解与字典查找。
        Dictionary<long, int> bucketId = new Dictionary<long, int>();
        List<long> bKeys = new List<long>();
        List<double> bAcc = new List<double>();
        List<int> bCnt = new List<int>();
        long cacheStart = 0L;
        long cacheEnd = 0L;
        int cacheIdx = -1;
        bool sorted = true;
        long lastNewKey = 0L;

        for (int r = 0; r < nRows; r = r + 1) {
            long t = tIsInt ? tInts[r] : tCol.GetLong(r);
            int bi = -1;
            if (cacheIdx >= 0 && t >= cacheStart && t < cacheEnd) {
                bi = cacheIdx;
            } else {
                long b = Resample.BucketStart(t, freq);
                if (!bucketId.TryGetValue(b, out bi)) {
                    bi = bKeys.Count;
                    if (bi > 0 && b < lastNewKey) { sorted = false; }
                    lastNewKey = b;
                    bucketId[b] = bi;
                    bKeys.Add(b);
                    bAcc.Add(0.0);
                    bCnt.Add(0);
                }
                cacheStart = b;
                cacheEnd = Resample.BucketEnd(b, freq);
                cacheIdx = bi;
            }
            if (agg == Agg.Count) {
                bCnt[bi] = bCnt[bi] + 1;
                continue;
            }
            if (vHasMiss && vCol.IsMissing(r)) { continue; }
            double v = vIsFloat ? vNums[r] : (vIsInt ? (double)vInts[r] : vCol.GetDouble(r));
            int c = bCnt[bi];
            if (agg == Agg.Sum || agg == Agg.Avg) {
                bAcc[bi] = bAcc[bi] + v;
            } else if (c == 0) {
                bAcc[bi] = v;
            } else if (agg == Agg.Max) {
                if (v > bAcc[bi]) { bAcc[bi] = v; }
            } else {
                if (v < bAcc[bi]) { bAcc[bi] = v; }
            }
            bCnt[bi] = c + 1;
        }

        int nBuckets = bKeys.Count;
        DataFrame outp = new DataFrame();
        DataCol outT = DataCol.Create(timeCol, ColKind.Int);
        DataCol outV = DataCol.Create(valueCol, ColKind.Float);
        outT.Reserve(nBuckets);
        outV.Reserve(nBuckets);
        List<long> outTInts = outT.ints;
        List<double> outVNums = outV.nums;
        if (sorted) {
            for (int i = 0; i < nBuckets; i = i + 1) {
                outTInts.Add(bKeys[i]);
                int c = bCnt[i];
                if (agg == Agg.Count) { outVNums.Add((double)c); }
                else if (c == 0) { outVNums.Add(0.0); }
                else if (agg == Agg.Avg) { outVNums.Add(bAcc[i] / (double)c); }
                else { outVNums.Add(bAcc[i]); }
            }
        } else {
            List<int> order = new List<int>();
            order.Reserve(nBuckets);
            for (int i = 0; i < nBuckets; i = i + 1) { order.Add(i); }
            order.Sort((int a, int b) => {
                long ka = bKeys[a];
                long kb = bKeys[b];
                if (ka < kb) { return 0 - 1; }
                if (ka > kb) { return 1; }
                return 0;
            });
            for (int i = 0; i < nBuckets; i = i + 1) {
                int idx = order[i];
                outTInts.Add(bKeys[idx]);
                int c = bCnt[idx];
                if (agg == Agg.Count) { outVNums.Add((double)c); }
                else if (c == 0) { outVNums.Add(0.0); }
                else if (agg == Agg.Avg) { outVNums.Add(bAcc[idx] / (double)c); }
                else { outVNums.Add(bAcc[idx]); }
            }
        }
        outp.cols.Add(outT);
        outp.cols.Add(outV);
        outp.rowCount = nBuckets;
        return outp;
    }

    // 桶起始时刻（unix 秒）。
    public static long BucketStart(long t, int freq) {
        if (freq == Freq.Second) { return t; }
        if (freq == Freq.Minute) { return Resample.FloorDiv(t, 60L) * 60L; }
        if (freq == Freq.Hour) { return Resample.FloorDiv(t, 3600L) * 3600L; }
        if (freq == Freq.Day) { return Resample.FloorDiv(t, 86400L) * 86400L; }
        if (freq == Freq.Week) {
            long day = Resample.FloorDiv(t, 86400L);
            // 1970-01-01 是周四（dayOfWeek=4，周一=1）：把纪元推到
            // 当周的周一。day - (dayOfWeek-1) 即本周一的天序。
            int dow = Resample.DayOfWeek(day);
            long monday = day - (dow - 1);
            return monday * 86400L;
        }
        // Month：自然月起点。
        int year = 0;
        int month = 0;
        int day = 0;
        DateTime.CivilFromDays((int)Resample.FloorDiv(t, 86400L), out year, out month, out day);
        return (long)DateTime.DaysFromCivil(year, month, 1) * 86400L;
    }

    // 桶的结束时刻（不含，unix 秒）——用于知道桶覆盖多长时间。
    public static long BucketEnd(long start, int freq) {
        if (freq == Freq.Second) { return start + 1L; }
        if (freq == Freq.Minute) { return start + 60L; }
        if (freq == Freq.Hour) { return start + 3600L; }
        if (freq == Freq.Day) { return start + 86400L; }
        if (freq == Freq.Week) { return start + 7L * 86400L; }
        int year = 0;
        int month = 0;
        int day = 0;
        DateTime.CivilFromDays((int)Resample.FloorDiv(start, 86400L), out year, out month, out day);
        int ny = year;
        int nm = month + 1;
        if (nm > 12) { nm = 1; ny = year + 1; }
        return (long)DateTime.DaysFromCivil(ny, nm, 1) * 86400L;
    }

    // 天序的星期几（周一=1 … 周日=7）。1970-01-01 是周四=4。
    public static int DayOfWeek(long days) {
        // 纪元是周四=4：day 0 → 4，(4 + days - 1) mod 7 归一到 1..7。
        long w = Resample.FloorMod(days + 3L, 7L);   // days=0 → 3
        return (int)w + 1;                          // → 4
    }

    // 向下取整除法（负数也向下——C 的整数除法是向零截断）。
    private static long FloorDiv(long a, long b) {
        long q = a / b;
        if ((a % b != 0) && ((a < 0) != (b < 0))) { q = q - 1; }
        return q;
    }

    // 非负取模。
    private static long FloorMod(long a, long b) {
        long m = a % b;
        if (m < 0) { m = m + b; }
        return m;
    }
}
