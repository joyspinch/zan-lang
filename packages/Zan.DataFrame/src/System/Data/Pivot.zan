using System;
using System.Collections.Generic;

namespace System.Data;

// 透视表与交叉表。
//
// 透视（pivot）把"长表"转成"宽表"：行标签 × 列标签 → 单元格值。
// 交叉表（crosstab）是它的特例——只数个数，不算聚合。
//
// 与 Unstack 的区别：Unstack 是一列 key 展开成多列（每列一个值列），
// 透视是"行标签 + 列标签"两维交叉，值列可以是多个。
//
// 行序与列序都按**首次出现顺序**（不是排序）——与 GroupBy 的
// "组按键首次出现顺序"一致，读者能对照原表核。

public class Pivot {
    // 透视表：index 为行标签列，columns 为列标签列，values 为值列
    // （可多列，按参数顺序），agg 为聚合算子（Agg 值）。
    //
    // 输出表：行标签列 + 每个（列标签 × 值列）一列，列名形如
    // "列标签值_值列名"（拼接而非单用标签——单用会与行标签列撞名）。
    // 缺组合的单元格填聚合的"空集"值（Count 得 0，其余得 0.0）。
    //
    // 行列标签的取值按首次出现顺序排列。
    public static DataFrame PivotTable(DataFrame df, string indexCol,
            string columnsCol, List<string> valueCols, int agg) {
        if (df == null) { throw new InvalidOperationException("PivotTable: 表为 null"); }
        int idxAt = df.ColIndex(indexCol);
        if (idxAt < 0) { throw new InvalidOperationException("PivotTable 没有列: " + indexCol); }
        int colAt = df.ColIndex(columnsCol);
        if (colAt < 0) { throw new InvalidOperationException("PivotTable 没有列: " + columnsCol); }
        List<int> valAt = new List<int>();
        for (int i = 0; i < valueCols.Count; i = i + 1) {
            int at = df.ColIndex(valueCols[i]);
            if (at < 0) {
                throw new InvalidOperationException("PivotTable 没有列: " + valueCols[i]);
            }
            valAt.Add(at);
        }

        // 第一趟：密集整数编码行/列标签，免每行 CellKey 字符串拼接与 List<int> 桶分配。
        int totalRows = df.Rows();
        DataCol idxCol = df.cols[idxAt];
        DataCol colCol = df.cols[colAt];
        List<string> indexValues = new List<string>();
        Dictionary<string, int> indexMap = new Dictionary<string, int>();
        List<string> columnValues = new List<string>();
        Dictionary<string, int> colMap = new Dictionary<string, int>();
        int[] rowIds = new int[totalRows];
        int[] colIds = new int[totalRows];
        for (int r = 0; r < totalRows; r = r + 1) {
            string iv = idxCol.IsMissing(r) ? "" : idxCol.GetStr(r);
            int ri;
            if (!indexMap.TryGetValue(iv, out ri)) {
                ri = indexValues.Count;
                indexMap[iv] = ri;
                indexValues.Add(iv);
            }
            string cv = colCol.IsMissing(r) ? "" : colCol.GetStr(r);
            int ci;
            if (!colMap.TryGetValue(cv, out ci)) {
                ci = columnValues.Count;
                colMap[cv] = ci;
                columnValues.Add(cv);
            }
            rowIds[r] = ri;
            colIds[r] = ci;
        }

        int nIdx = indexValues.Count;
        int nCol = columnValues.Count;
        int nVal = valAt.Count;
        long gridCellsL = (long)nIdx * (long)nCol;
        if (gridCellsL > 268435456L) {
            throw new InvalidOperationException("PivotTable 网格单元数超出上限");
        }
        int gridCells = (int)gridCellsL;

        // 第二趟：扁平数组流式聚合（支持全部 Agg.Count/Sum/Avg/Min/Max，精确跳过缺失格）。
        DataFrame outp = new DataFrame();
        DataCol outIdx = DataCol.Create(indexCol, idxCol.Kind());
        outIdx.Reserve(nIdx);
        for (int i = 0; i < nIdx; i = i + 1) { outIdx.Append(indexValues[i]); }
        outp.cols.Add(outIdx);
        outp.rowCount = nIdx;

        int totalOutVals = nCol * nVal;
        for (int c = 0; c < nCol; c = c + 1) {
            for (int v = 0; v < nVal; v = v + 1) {
                DataCol vc = DataCol.Create(columnValues[c] + "_" + df.cols[valAt[v]].Name(), ColKind.Float);
                vc.Reserve(nIdx);
                outp.cols.Add(vc);
            }
        }

        if (agg == Agg.Count) {
            int[] cnts = new int[gridCells];
            for (int r = 0; r < totalRows; r = r + 1) {
                int cell = rowIds[r] * nCol + colIds[r];
                cnts[cell] = cnts[cell] + 1;
            }
            for (int c = 0; c < nCol; c = c + 1) {
                for (int v = 0; v < nVal; v = v + 1) {
                    List<double> dst = outp.cols[1 + c * nVal + v].nums;
                    for (int i = 0; i < nIdx; i = i + 1) {
                        dst.Add((double)cnts[i * nCol + c]);
                    }
                }
            }
            return outp;
        }

        double[] acc = new double[gridCells];
        int[] validCnt = new int[gridCells];
        for (int v = 0; v < nVal; v = v + 1) {
            if (v > 0) {
                for (int k = 0; k < gridCells; k = k + 1) { acc[k] = 0.0; validCnt[k] = 0; }
            }
            DataCol src = df.cols[valAt[v]];
            bool hasMiss = src.missing.Count > 0;
            int kind = src.kind;
            if (!hasMiss && kind == ColKind.Float) {
                List<double> nums = src.nums;
                if (agg == Agg.Sum || agg == Agg.Avg) {
                    for (int r = 0; r < totalRows; r = r + 1) {
                        int cell = rowIds[r] * nCol + colIds[r];
                        acc[cell] = acc[cell] + nums[r];
                        validCnt[cell] = validCnt[cell] + 1;
                    }
                } else if (agg == Agg.Max) {
                    for (int r = 0; r < totalRows; r = r + 1) {
                        int cell = rowIds[r] * nCol + colIds[r];
                        double x = nums[r];
                        if (validCnt[cell] == 0 || x > acc[cell]) { acc[cell] = x; }
                        validCnt[cell] = validCnt[cell] + 1;
                    }
                } else {
                    for (int r = 0; r < totalRows; r = r + 1) {
                        int cell = rowIds[r] * nCol + colIds[r];
                        double x = nums[r];
                        if (validCnt[cell] == 0 || x < acc[cell]) { acc[cell] = x; }
                        validCnt[cell] = validCnt[cell] + 1;
                    }
                }
            } else if (!hasMiss && kind == ColKind.Int) {
                List<long> ints = src.ints;
                if (agg == Agg.Sum || agg == Agg.Avg) {
                    for (int r = 0; r < totalRows; r = r + 1) {
                        int cell = rowIds[r] * nCol + colIds[r];
                        acc[cell] = acc[cell] + (double)ints[r];
                        validCnt[cell] = validCnt[cell] + 1;
                    }
                } else if (agg == Agg.Max) {
                    for (int r = 0; r < totalRows; r = r + 1) {
                        int cell = rowIds[r] * nCol + colIds[r];
                        double x = (double)ints[r];
                        if (validCnt[cell] == 0 || x > acc[cell]) { acc[cell] = x; }
                        validCnt[cell] = validCnt[cell] + 1;
                    }
                } else {
                    for (int r = 0; r < totalRows; r = r + 1) {
                        int cell = rowIds[r] * nCol + colIds[r];
                        double x = (double)ints[r];
                        if (validCnt[cell] == 0 || x < acc[cell]) { acc[cell] = x; }
                        validCnt[cell] = validCnt[cell] + 1;
                    }
                }
            } else {
                for (int r = 0; r < totalRows; r = r + 1) {
                    if (hasMiss && src.IsMissing(r)) { continue; }
                    int cell = rowIds[r] * nCol + colIds[r];
                    double x = src.GetDouble(r);
                    if (agg == Agg.Sum || agg == Agg.Avg) {
                        acc[cell] = acc[cell] + x;
                    } else if (agg == Agg.Max) {
                        if (validCnt[cell] == 0 || x > acc[cell]) { acc[cell] = x; }
                    } else {
                        if (validCnt[cell] == 0 || x < acc[cell]) { acc[cell] = x; }
                    }
                    validCnt[cell] = validCnt[cell] + 1;
                }
            }
            for (int c = 0; c < nCol; c = c + 1) {
                List<double> dst = outp.cols[1 + c * nVal + v].nums;
                for (int i = 0; i < nIdx; i = i + 1) {
                    int cell = i * nCol + c;
                    int cnt = validCnt[cell];
                    if (cnt == 0) { dst.Add(0.0); }
                    else if (agg == Agg.Avg) { dst.Add(acc[cell] / (double)cnt); }
                    else { dst.Add(acc[cell]); }
                }
            }
        }
        return outp;
    }

    // 透视表（单值列）。
    public static DataFrame PivotTable(DataFrame df, string indexCol,
            string columnsCol, string valueCol, int agg) {
        List<string> vals = new List<string>();
        vals.Add(valueCol);
        return Pivot.PivotTable(df, indexCol, columnsCol, vals, agg);
    }

    // 交叉表：行标签 × 列标签，单元格是**出现次数**。
    //
    // 这是 PivotTable 的 agg=Count 特例，但输出列名不带值列后缀
    // （"列标签"本身），且只有一行标签维度。
    public static DataFrame Crosstab(DataFrame df, string indexCol,
            string columnsCol) {
        if (df == null) { throw new InvalidOperationException("Crosstab: 表为 null"); }
        int idxAt = df.ColIndex(indexCol);
        if (idxAt < 0) { throw new InvalidOperationException("Crosstab 没有列: " + indexCol); }
        int colAt = df.ColIndex(columnsCol);
        if (colAt < 0) { throw new InvalidOperationException("Crosstab 没有列: " + columnsCol); }

        int totalRows = df.Rows();
        DataCol idxCol = df.cols[idxAt];
        DataCol colCol = df.cols[colAt];
        List<string> indexValues = new List<string>();
        Dictionary<string, int> indexMap = new Dictionary<string, int>();
        List<string> columnValues = new List<string>();
        Dictionary<string, int> colMap = new Dictionary<string, int>();
        int[] rowIds = new int[totalRows];
        int[] colIds = new int[totalRows];
        for (int r = 0; r < totalRows; r = r + 1) {
            string iv = idxCol.IsMissing(r) ? "" : idxCol.GetStr(r);
            int ri;
            if (!indexMap.TryGetValue(iv, out ri)) {
                ri = indexValues.Count;
                indexMap[iv] = ri;
                indexValues.Add(iv);
            }
            string cv = colCol.IsMissing(r) ? "" : colCol.GetStr(r);
            int ci;
            if (!colMap.TryGetValue(cv, out ci)) {
                ci = columnValues.Count;
                colMap[cv] = ci;
                columnValues.Add(cv);
            }
            rowIds[r] = ri;
            colIds[r] = ci;
        }
        int nIdx = indexValues.Count;
        int nCol = columnValues.Count;
        long gridCellsL = (long)nIdx * (long)nCol;
        if (gridCellsL > 268435456L) {
            throw new InvalidOperationException("Crosstab 网格单元数超出上限");
        }
        int[] cnts = new int[(int)gridCellsL];
        for (int r = 0; r < totalRows; r = r + 1) {
            int cell = rowIds[r] * nCol + colIds[r];
            cnts[cell] = cnts[cell] + 1;
        }

        DataFrame outp = new DataFrame();
        DataCol outIdx = DataCol.Create(indexCol, idxCol.Kind());
        outIdx.Reserve(nIdx);
        for (int i = 0; i < nIdx; i = i + 1) { outIdx.Append(indexValues[i]); }
        outp.cols.Add(outIdx);
        outp.rowCount = nIdx;
        for (int c = 0; c < nCol; c = c + 1) {
            DataCol cc = DataCol.Create(columnValues[c], ColKind.Int);
            cc.Reserve(nIdx);
            List<long> dst = cc.ints;
            for (int i = 0; i < nIdx; i = i + 1) {
                dst.Add((long)cnts[i * nCol + c]);
            }
            outp.cols.Add(cc);
        }
        return outp;
    }

    // 单元格键：行标签 \u0001 列标签。
    private static string CellKey(string indexValue, string columnValue) {
        return indexValue + "\u0001" + columnValue;
    }
}
