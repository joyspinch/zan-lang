using System;

namespace System.Data;

// DataFrame 的描述统计入口：把"某列"取成数值序列再算。
//
// 列到数值的转换规则与 DataFrame 其它读法一致（GetDouble 的语义）：
// Int 列取值、Float 列取值、Str 列按 strtod 前缀解析（解析不出得 0.0）。
// 统计函数本身只认 List<double>——这里是唯一做类型转换的地方。
//
// 聚合用（GroupBy + Aggregate）仍走 DataFrame.Aggregate；这里是
// "整列"级别的集中趋势与离散度。

public class DataFrameStats {
    // 取一列的数值序列（转换规则见文件头注释）。
    public static List<double> Column(DataFrame df, string col) {
        List<double> xs = new List<double>();
        if (df == null) { return xs; }
        int at = df.ColIndex(col);
        if (at < 0) { return xs; }
        int n = df.Rows();
        for (int r = 0; r < n; r = r + 1) {
            xs.Add(df.GetFloat(r, at));
        }
        return xs;
    }

    // 一列的平均值。列不存在或表为空返回 0.0。
    public static double Mean(DataFrame df, string col) {
        return Stats.Mean(DataFrameStats.Column(df, col));
    }

    // 一列的中位数。
    public static double Median(DataFrame df, string col) {
        return Stats.Median(DataFrameStats.Column(df, col));
    }

    // 一列的分位数（q ∈ [0,1]）。
    public static double Percentile(DataFrame df, string col, double q) {
        return Stats.Percentile(DataFrameStats.Column(df, col), q);
    }

    // 一列的最小值。
    public static double Min(DataFrame df, string col) {
        return Stats.Min(DataFrameStats.Column(df, col));
    }

    // 一列的最大值。
    public static double Max(DataFrame df, string col) {
        return Stats.Max(DataFrameStats.Column(df, col));
    }

    // 一列的极差。
    public static double Range(DataFrame df, string col) {
        return Stats.Range(DataFrameStats.Column(df, col));
    }

    // 一列的总体方差。
    public static double Variance(DataFrame df, string col) {
        return Stats.Variance(DataFrameStats.Column(df, col));
    }

    // 一列的总体标准差。
    public static double StdDev(DataFrame df, string col) {
        return Stats.StdDev(DataFrameStats.Column(df, col));
    }

    // 一列的样本标准差。
    public static double SampleStdDev(DataFrame df, string col) {
        return Stats.SampleStdDev(DataFrameStats.Column(df, col));
    }

    // 一列的偏度。
    public static double Skewness(DataFrame df, string col) {
        return Stats.Skewness(DataFrameStats.Column(df, col));
    }

    // 一列的超额峰度。
    public static double Kurtosis(DataFrame df, string col) {
        return Stats.Kurtosis(DataFrameStats.Column(df, col));
    }

    // 两列的皮尔逊相关系数。
    public static double Correlation(DataFrame df, string colX, string colY) {
        return Stats.Correlation(DataFrameStats.Column(df, colX),
        DataFrameStats.Column(df, colY));
    }
}
