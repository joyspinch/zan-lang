using System;

namespace System.Data;

// DataFrame 的描述统计入口：把"某列"取成数值序列再算。
//
// 列到数值的转换规则与 DataFrame 其它读法一致（GetDouble 的语义）：
// Int 列取值、Float 列取值、Str 列按 strtod 前缀解析（解析不出得 0.0）。
// 统计函数本身只认 List<double>——这里是唯一做类型转换的地方。
//
// 聚合用（GroupBy + Aggregate）仍走 DataFrame.Aggregate；这里是
// "整列"级别的集中趋势与离散度。

public class DataFrameStats {
    // 取一列的数值序列（返回独立副本，转换规则见文件头注释）。
    public static List<double> Column(DataFrame df, string col) {
        List<double> xs = new List<double>();
        if (df == null) { return xs; }
        int at = df.ColIndex(col);
        if (at < 0) { return xs; }
        DataCol c = df.cols[at];
        int n = df.Rows();
        xs.Reserve(n);
        bool hasMiss = c.missing.Count > 0;
        if (!hasMiss && c.kind == ColKind.Float) {
            List<double> nums = c.nums;
            for (int r = 0; r < n; r = r + 1) { xs.Add(nums[r]); }
        } else if (!hasMiss && c.kind == ColKind.Int) {
            List<long> ints = c.ints;
            for (int r = 0; r < n; r = r + 1) { xs.Add((double)ints[r]); }
        } else {
            for (int r = 0; r < n; r = r + 1) {
                if (hasMiss && c.IsMissing(r)) { continue; }
                xs.Add(c.GetDouble(r));
            }
        }
        return xs;
    }

    // 内部只读视图：无缺失 Float 列直接借用 DataCol.nums（零分配零拷贝），其余走 Column。
    private static List<double> ColumnReadOnly(DataFrame df, string col) {
        if (df == null) { return new List<double>(); }
        int at = df.ColIndex(col);
        if (at < 0) { return new List<double>(); }
        DataCol c = df.cols[at];
        if (c.kind == ColKind.Float && c.missing.Count == 0 && c.nums.Count == df.Rows()) {
            return c.nums;
        }
        return DataFrameStats.Column(df, col);
    }

    // 一列的平均值。列不存在或表为空返回 0.0。
    public static double Mean(DataFrame df, string col) {
        return Stats.Mean(DataFrameStats.ColumnReadOnly(df, col));
    }

    // 一列的中位数。
    public static double Median(DataFrame df, string col) {
        return Stats.Median(DataFrameStats.ColumnReadOnly(df, col));
    }

    // 一列的分位数（q ∈ [0,1]）。
    public static double Percentile(DataFrame df, string col, double q) {
        return Stats.Percentile(DataFrameStats.ColumnReadOnly(df, col), q);
    }

    // 一列的最小值。
    public static double Min(DataFrame df, string col) {
        return Stats.Min(DataFrameStats.ColumnReadOnly(df, col));
    }

    // 一列的最大值。
    public static double Max(DataFrame df, string col) {
        return Stats.Max(DataFrameStats.ColumnReadOnly(df, col));
    }

    // 一列的极差。
    public static double Range(DataFrame df, string col) {
        return Stats.Range(DataFrameStats.ColumnReadOnly(df, col));
    }

    // 一列的总体方差。
    public static double Variance(DataFrame df, string col) {
        return Stats.Variance(DataFrameStats.ColumnReadOnly(df, col));
    }

    // 一列的总体标准差。
    public static double StdDev(DataFrame df, string col) {
        return Stats.StdDev(DataFrameStats.ColumnReadOnly(df, col));
    }

    // 一列的样本标准差。
    public static double SampleStdDev(DataFrame df, string col) {
        return Stats.SampleStdDev(DataFrameStats.ColumnReadOnly(df, col));
    }

    // 一列的偏度。
    public static double Skewness(DataFrame df, string col) {
        return Stats.Skewness(DataFrameStats.ColumnReadOnly(df, col));
    }

    // 一列的超额峰度。
    public static double Kurtosis(DataFrame df, string col) {
        return Stats.Kurtosis(DataFrameStats.ColumnReadOnly(df, col));
    }

    // 两列的皮尔逊相关系数（按行对齐并跳过任一列缺失的行）。
    public static double Correlation(DataFrame df, string colX, string colY) {
        if (df == null) { return 0.0; }
        int ax = df.ColIndex(colX);
        int ay = df.ColIndex(colY);
        if (ax < 0 || ay < 0) { return 0.0; }
        DataCol cx = df.cols[ax];
        DataCol cy = df.cols[ay];
        if (cx.missing.Count == 0 && cy.missing.Count == 0) {
            return Stats.Correlation(DataFrameStats.ColumnReadOnly(df, colX),
                DataFrameStats.ColumnReadOnly(df, colY));
        }
        int n = df.Rows();
        List<double> xs = new List<double>();
        List<double> ys = new List<double>();
        xs.Reserve(n);
        ys.Reserve(n);
        for (int r = 0; r < n; r = r + 1) {
            if (cx.IsMissing(r) || cy.IsMissing(r)) { continue; }
            xs.Add(cx.GetDouble(r));
            ys.Add(cy.GetDouble(r));
        }
        return Stats.Correlation(xs, ys);
    }
}
