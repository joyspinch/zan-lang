using System;

namespace Game.Physics3D;

// 持续接触：两个刚体之间的一对接触。
//
// 接触对象是**常驻**的：窄相每步重算流形，但接触对象本身保留，这样上一步
// 累积的冲量（热启动）才能被复用——复用冲量能把堆叠物体稳住，代价只是每步
// 几次额外的冲量施加。
public class Contact {
    public RigidBody bodyA;
    public RigidBody bodyB;
    // 本步的接触流形（窄相产出）。
    public Manifold manifold;
    // 组合后的摩擦系数（几何平均）。
    public double friction;
    // 组合后的弹性系数（取较大者）。
    public double restitution;
    // 最近一次被碰到的步号（用来清理失效接触）。
    public int stamp;

    public Contact(RigidBody bodyA, RigidBody bodyB) {
        this.bodyA = bodyA;
        this.bodyB = bodyB;
        this.manifold = new Manifold();
        this.friction = 0.2;
        this.restitution = 0.0;
        this.stamp = 0;
        this.UpdateMaterial();
    }

    // 按两个刚体的材质重算组合系数。
    //
    // 摩擦取几何平均（两边都滑才算滑）；弹性取**较大**的那个——地面不会把球
    // 的弹性"平均掉"，只给球设 restitution 时照样要弹。
    public void UpdateMaterial() {
        this.friction = Math.Sqrt(this.bodyA.friction * this.bodyB.friction);
        double a = this.bodyA.restitution;
        double b = this.bodyB.restitution;
        this.restitution = a > b ? a : b;
    }

    // 把旧流形上的累积冲量搬到新流形上（热启动）。
    public void AdoptImpulses(Manifold previous) {
        int count = this.manifold.points.Count;
        int previousCount = previous.points.Count;
        if (count > previousCount) { count = previousCount; }
        for (int i = 0; i < count; i = i + 1) {
            this.manifold.points[i].normalImpulse = previous.points[i].normalImpulse;
            this.manifold.points[i].tangentImpulse1 = previous.points[i].tangentImpulse1;
            this.manifold.points[i].tangentImpulse2 = previous.points[i].tangentImpulse2;
        }
    }
}
