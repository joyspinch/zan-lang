using System;

namespace Game.Physics3D;

// 四元数（double，值语义）：刚体的朝向。
//
// **为什么不用欧拉角**：欧拉角有万向锁与顺序歧义（同样的旋转写成不同角度），
// 插值时会翻面。四元数乘法无这些毛病，代价是要归一化。
//
// 约定：q = (x, y, z, w)，w 是标量部分；单位四元数表示旋转。
public struct Quat {
    public double x;
    public double y;
    public double z;
    public double w;

    public Quat(double x, double y, double z, double w) {
        this.x = x;
        this.y = y;
        this.z = z;
        this.w = w;
    }

    // 单位四元数（不旋转）。
    public static Quat Identity { get { return new Quat(0.0, 0.0, 0.0, 1.0); } }

    // 由轴与角度（弧度）构造。
    public static Quat FromAxisAngle(Vec3 axis, double angle) {
        Vec3 n = axis.Normalized();
        if (n.LengthSquared() <= 0.0) { return Quat.Identity; }
        double half = angle * 0.5;
        double s = Math.Sin(half);
        return new Quat(n.x * s, n.y * s, n.z * s, Math.Cos(half));
    }

    // 绕 X 轴旋转。
    public static Quat FromAxisX(double angle) {
        return Quat.FromAxisAngle(Vec3.UnitX, angle);
    }
    // 绕 Y 轴旋转。
    public static Quat FromAxisY(double angle) {
        return Quat.FromAxisAngle(Vec3.UnitY, angle);
    }
    // 绕 Z 轴旋转。
    public static Quat FromAxisZ(double angle) {
        return Quat.FromAxisAngle(Vec3.UnitZ, angle);
    }

    // 四元数乘法（a 之后接 b：先转 b 再转 a）。
    public static Quat operator *(Quat a, Quat b) {
        return new Quat(
            a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y,
            a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x,
            a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w,
            a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z
        );
    }

    // 共轭（单位四元数的逆）。
    public Quat Conjugate() {
        return new Quat(-this.x, -this.y, -this.z, this.w);
    }

    // 范数平方。
    public double NormSquared() {
        return this.x * this.x + this.y * this.y + this.z * this.z + this.w * this.w;
    }

    // 归一化（零四元数返回单位四元数）。
    public Quat Normalized() {
        double n2 = this.NormSquared();
        if (n2 <= 0.000000000001) { return Quat.Identity; }
        double inv = 1.0 / Math.Sqrt(n2);
        return new Quat(this.x * inv, this.y * inv, this.z * inv, this.w * inv);
    }

    // 用四元数旋转向量。
    public Vec3 Rotate(Vec3 v) {
        // v' = v + 2·qvec × (qvec × v + w·v)
        Vec3 qv = new Vec3(this.x, this.y, this.z);
        Vec3 t = Vec3.Cross(qv, v) + v * this.w;
        return v + Vec3.Cross(qv, t) * 2.0;
    }

    // 用四元数的逆旋转向量（世界 → 局部）。
    public Vec3 RotateInverse(Vec3 v) {
        return this.Conjugate().Rotate(v);
    }

    // 把四元数转成 3x3 旋转矩阵（行主序 9 个元素：m[row*3+col]）。
    //
    // **为什么显式给矩阵**：惯量张量是**局部坐标系**下的对角阵，世界系下要
    // 变成 R·I·Rᵀ；每步都算一遍四元数乘法太啰嗦，矩阵形式更直接（也能给
    // 渲染侧用）。
    public double[] ToMatrix() {
        double[] m = new double[9];
        double xx = this.x * this.x;
        double yy = this.y * this.y;
        double zz = this.z * this.z;
        double xy = this.x * this.y;
        double xz = this.x * this.z;
        double yz = this.y * this.z;
        double wx = this.w * this.x;
        double wy = this.w * this.y;
        double wz = this.w * this.z;
        m[0] = 1.0 - 2.0 * (yy + zz);
        m[1] = 2.0 * (xy - wz);
        m[2] = 2.0 * (xz + wy);
        m[3] = 2.0 * (xy + wz);
        m[4] = 1.0 - 2.0 * (xx + zz);
        m[5] = 2.0 * (yz - wx);
        m[6] = 2.0 * (xz - wy);
        m[7] = 2.0 * (yz + wx);
        m[8] = 1.0 - 2.0 * (xx + yy);
        return m;
    }
}
