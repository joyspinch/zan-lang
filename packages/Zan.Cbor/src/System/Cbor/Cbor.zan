using System;
using System.IO;
using System.Json;

namespace System.Cbor;

// CBOR 门面：JsonValue ↔ 线上字节的 schemaless 互转（RFC 8949）。
// 写侧全部确定长度、argument 规范最短、浮点固定 64 位；读侧全
// 形态（indefinite 分片、tag、半精度浮点）。null ↔ 0xF6；byte
// string 读侧按 UTF-8 尽力解码；tag 1（纪元秒）→ ISO 8601 字符串，
// 其余 tag 剥掉取内层。深度上限 512。
class Cbor {
    // 把值树编码成 CBOR 字节（null 视为 0xF6）。
    static byte[] Encode(JsonValue v) {
        CborWriter w = new CborWriter();
        EncodeValue(w, v, 0);
        return w.ToBytes();
    }

    // 解码整段 CBOR 字节（非法即抛 CborException）。
    static JsonValue Decode(byte[] data) {
        CborReader r = new CborReader(data);
        return r.ReadValue(0);
    }

    // 解码切片 [offset, offset+count)。
    static JsonValue Decode(byte[] data, int offset, int count) {
        CborReader r = new CborReader(data, offset, count);
        return r.ReadValue(0);
    }

    // 从文件读入并解码。
    static JsonValue Load(string path) {
        return Cbor.Decode(File.ReadAllBytes(path));
    }

    // 编码并写入文件。
    static void Save(JsonValue v, string path) {
        File.WriteAllBytes(path, Cbor.Encode(v));
    }

    static void EncodeValue(CborWriter w, JsonValue v, int depth) {
        if (depth > 512) {
            throw new CborException("nesting too deep while encoding");
        }
        if (v == null || v.IsNull()) { w.WriteNull(); return; }
        if (v.IsBool()) { w.WriteBool(v.AsBool(false)); return; }
        if (v.IsNumber()) {
            if (v.IsInt()) {
                long n = v.AsLong(0);
                if (n >= 0) { w.WriteUint(n); } else { w.WriteNeg(n); }
            } else {
                w.WriteDouble(v.AsDouble(0));
            }
            return;
        }
        if (v.IsString()) { w.WriteString(v.AsString("")); return; }
        if (v.IsArray()) {
            int n = v.Count();
            w.WriteArrayHeader(n);
            int i = 0;
            while (i < n) {
                EncodeValue(w, v.At(i), depth + 1);
                i = i + 1;
            }
            return;
        }
        if (v.IsObject()) {
            int n = v.Count();
            w.WriteMapHeader(n);
            int i = 0;
            while (i < n) {
                string k = v.KeyAt(i);
                w.WriteString(k);
                EncodeValue(w, v.ValAt(i), depth + 1);
                i = i + 1;
            }
            return;
        }
        throw new CborException("unsupported value kind while encoding");
    }
}
