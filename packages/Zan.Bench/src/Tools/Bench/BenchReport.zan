using System;
using System.Collections.Generic;
using System.Text;

namespace Tools.Bench;

// 基准报告：文本表格 + JSON。
//
// **为什么两种格式都要**：文本给人看（CI 日志里一眼看出哪个用例慢了），
// JSON 给机器看（存成基线、下次对比、接可视化）。JSON 里存的是
// **中位数**（主指标）而不是均值——均值会被偶发尖峰带偏，基线比的是
// 中位数才稳。
public class BenchReport {
    private static const string SPACES64 = "                                                                ";
    private static const string HEX_LOWER = "0123456789abcdef";

    private static void AppendSpaces(StringBuilder sb, int count) {
        nint sp = (nint)BenchReport.SPACES64;
        while (count >= 64) {
            sb.Append(BenchReport.SPACES64);
            count = count - 64;
        }
        if (count > 0) {
            sb.Append(new StringView(sp, count));
        }
    }

    private static int LongDigits(long v) {
        if (v == 0L) { return 1; }
        int len = 0;
        long n = v;
        if (n < 0L) {
            len = 1;
        } else {
            n = -n;
        }
        while (n < 0L) {
            n = n / 10L;
            len = len + 1;
        }
        return len;
    }

    private static int AppendLong(StringBuilder sb, long v, byte[] numBuf) {
        if (v == 0L) {
            sb.Append("0");
            return 1;
        }
        bool neg = v < 0L;
        long n = neg ? v : -v;
        int pos = 24;
        while (n < 0L) {
            long q = n / 10L;
            int rem = (int)(q * 10L - n);
            pos = pos - 1;
            numBuf[pos] = (byte)(48 + rem);
            n = q;
        }
        if (neg) {
            pos = pos - 1;
            numBuf[pos] = 45;
        }
        int len = 24 - pos;
        sb.Append(new StringView((nint)numBuf + (nint)pos, len));
        return len;
    }

    private static void AppendPaddedStr(StringBuilder sb, string s, int width) {
        string text = s == null ? "" : s;
        sb.Append(text);
        int pad = width - text.Length;
        if (pad > 0) { BenchReport.AppendSpaces(sb, pad); }
    }

    private static bool IsFinite(double v) {
        return v == v && (v - v == 0.0);
    }

    private static void AppendPaddedLong(StringBuilder sb, long v, int width, byte[] numBuf) {
        int len = BenchReport.AppendLong(sb, v, numBuf);
        int pad = width - len;
        if (pad > 0) { BenchReport.AppendSpaces(sb, pad); }
    }

    // 文本报告：每个用例一行，列按最长值左对齐补空格。
    public static string Text(List<BenchResult> results) {
        if (results == null || results.Count == 0) {
            return "(no benchmark cases)\n";
        }
        int n = results.Count;
        int w0 = 4;   // "case"
        int w1 = 10;  // "iterations"
        int w2 = 10;  // "median(ns)"
        int w3 = 8;   // "mean(ns)"
        int w4 = 7;   // "min(ns)"
        int w5 = 7;   // "max(ns)"
        int w6 = 6;   // "sd(ns)"
        int w7 = 5;   // "ops/s"
        int w8 = 12;  // "allocated(B)"
        string[] sdStrs = new string[n];
        string[] opsStrs = new string[n];
        for (int i = 0; i < n; i = i + 1) {
            BenchResult r = results[i];
            if (r == null) {
                sdStrs[i] = "0";
                opsStrs[i] = "0";
                continue;
            }
            string rName = r.name == null ? "" : r.name;
            int l0 = rName.Length;
            if (l0 > w0) { w0 = l0; }
            int l1 = BenchReport.LongDigits((long)r.iterations);
            if (l1 > w1) { w1 = l1; }
            int l2 = BenchReport.LongDigits(r.medianNs);
            if (l2 > w2) { w2 = l2; }
            int l3 = BenchReport.LongDigits(r.meanNs);
            if (l3 > w3) { w3 = l3; }
            int l4 = BenchReport.LongDigits(r.minNs);
            if (l4 > w4) { w4 = l4; }
            int l5 = BenchReport.LongDigits(r.maxNs);
            if (l5 > w5) { w5 = l5; }
            string s6 = Convert.ToString(r.stdDevNs);
            sdStrs[i] = s6;
            if (s6.Length > w6) { w6 = s6.Length; }
            string s7 = Convert.ToString(r.opsPerSecond);
            opsStrs[i] = s7;
            if (s7.Length > w7) { w7 = s7.Length; }
            int l8 = BenchReport.LongDigits(r.allocatedBytes);
            if (l8 > w8) { w8 = l8; }
        }

        long lineLenL = (long)w0 + (long)w1 + (long)w2 + (long)w3 + (long)w4
            + (long)w5 + (long)w6 + (long)w7 + (long)w8 + 17L;
        long capL = ((long)n + 1L) * lineLenL;
        int initCap = (capL > 0L && capL < 1048576L) ? (int)capL : 1048576;
        StringBuilder sb = new StringBuilder(initCap);
        BenchReport.AppendPaddedStr(sb, "case", w0);
        sb.Append("  ");
        BenchReport.AppendPaddedStr(sb, "iterations", w1);
        sb.Append("  ");
        BenchReport.AppendPaddedStr(sb, "median(ns)", w2);
        sb.Append("  ");
        BenchReport.AppendPaddedStr(sb, "mean(ns)", w3);
        sb.Append("  ");
        BenchReport.AppendPaddedStr(sb, "min(ns)", w4);
        sb.Append("  ");
        BenchReport.AppendPaddedStr(sb, "max(ns)", w5);
        sb.Append("  ");
        BenchReport.AppendPaddedStr(sb, "sd(ns)", w6);
        sb.Append("  ");
        BenchReport.AppendPaddedStr(sb, "ops/s", w7);
        sb.Append("  ");
        BenchReport.AppendPaddedStr(sb, "allocated(B)", w8);
        sb.Append("\n");

        byte[] numBuf = new byte[24];
        for (int i = 0; i < n; i = i + 1) {
            BenchResult r = results[i];
            if (r == null) { continue; }
            BenchReport.AppendPaddedStr(sb, r.name == null ? "" : r.name, w0);
            sb.Append("  ");
            BenchReport.AppendPaddedLong(sb, (long)r.iterations, w1, numBuf);
            sb.Append("  ");
            BenchReport.AppendPaddedLong(sb, r.medianNs, w2, numBuf);
            sb.Append("  ");
            BenchReport.AppendPaddedLong(sb, r.meanNs, w3, numBuf);
            sb.Append("  ");
            BenchReport.AppendPaddedLong(sb, r.minNs, w4, numBuf);
            sb.Append("  ");
            BenchReport.AppendPaddedLong(sb, r.maxNs, w5, numBuf);
            sb.Append("  ");
            BenchReport.AppendPaddedStr(sb, sdStrs[i], w6);
            sb.Append("  ");
            BenchReport.AppendPaddedStr(sb, opsStrs[i], w7);
            sb.Append("  ");
            BenchReport.AppendPaddedLong(sb, r.allocatedBytes, w8, numBuf);
            sb.Append("\n");
        }
        return sb.ToString();
    }

    // 一行：按列宽左对齐补空格（第一列左对齐，数字列右对齐更好读，
    // 这里统一左对齐——列宽已按内容算好，读起来一样齐）。
    static string Row(string[] cells, int[] widths) {
        if (cells == null || widths == null) { return ""; }
        int cols = cells.Length < widths.Length ? cells.Length : widths.Length;
        long estL = 0L;
        for (int c = 0; c < cols; c = c + 1) {
            int cw = widths[c] > 0 ? widths[c] : 0;
            estL = estL + (long)cw + 2L;
        }
        int initCap = (estL > 0L && estL < 1048576L) ? (int)estL : 1048576;
        StringBuilder sb = new StringBuilder(initCap);
        for (int c = 0; c < cols; c = c + 1) {
            if (c > 0) { sb.Append("  "); }
            BenchReport.AppendPaddedStr(sb, cells[c], widths[c]);
        }
        return sb.ToString();
    }

    private static void QuoteInto(StringBuilder sb, string s) {
        if (s == null || s.Length == 0) {
            sb.Append("\"\"");
            return;
        }
        sb.Append("\"");
        int n = s.Length;
        nint sp = (nint)s;
        nint hp = (nint)BenchReport.HEX_LOWER;
        int start = 0;
        for (int i = 0; i < n; i = i + 1) {
            int c = s[i] & 255;
            if (c == 34 || c == 92 || c < 32) {
                if (i > start) { sb.Append(new StringView(sp + (nint)start, i - start)); }
                if (c == 34) { sb.Append("\\\""); }
                else if (c == 92) { sb.Append("\\\\"); }
                else if (c == 8) { sb.Append("\\b"); }
                else if (c == 12) { sb.Append("\\f"); }
                else if (c == 10) { sb.Append("\\n"); }
                else if (c == 13) { sb.Append("\\r"); }
                else if (c == 9) { sb.Append("\\t"); }
                else {
                    sb.Append("\\u00");
                    sb.Append(new StringView(hp + (nint)((c >> 4) & 15), 1));
                    sb.Append(new StringView(hp + (nint)(c & 15), 1));
                }
                start = i + 1;
            }
        }
        if (n > start) { sb.Append(new StringView(sp + (nint)start, n - start)); }
        sb.Append("\"");
    }

    // JSON 报告（可存成基线文件）。
    public static string Json(List<BenchResult> results) {
        int n = results == null ? 0 : results.Count;
        long capL = 32L + (long)n * 192L;
        int initCap = (capL > 0L && capL < 1048576L) ? (int)capL : 1048576;
        StringBuilder sb = new StringBuilder(initCap);
        sb.Append("{\"benchmarks\":[");
        if (n > 0) {
            byte[] numBuf = new byte[24];
            bool emitted = false;
            for (int i = 0; i < n; i = i + 1) {
                BenchResult r = results[i];
                if (r == null) { continue; }
                if (emitted) { sb.Append(","); }
                emitted = true;
                sb.Append("{\"name\":");
                BenchReport.QuoteInto(sb, r.name);
                sb.Append(",\"iterations\":");
                BenchReport.AppendLong(sb, (long)r.iterations, numBuf);
                sb.Append(",\"medianNs\":");
                BenchReport.AppendLong(sb, r.medianNs, numBuf);
                sb.Append(",\"meanNs\":");
                BenchReport.AppendLong(sb, r.meanNs, numBuf);
                sb.Append(",\"minNs\":");
                BenchReport.AppendLong(sb, r.minNs, numBuf);
                sb.Append(",\"maxNs\":");
                BenchReport.AppendLong(sb, r.maxNs, numBuf);
                sb.Append(",\"stdDevNs\":");
                sb.Append(BenchReport.IsFinite(r.stdDevNs) ? Convert.ToString(r.stdDevNs) : "0");
                sb.Append(",\"opsPerSecond\":");
                sb.Append(BenchReport.IsFinite(r.opsPerSecond) ? Convert.ToString(r.opsPerSecond) : "0");
                sb.Append(",\"allocatedBytes\":");
                BenchReport.AppendLong(sb, r.allocatedBytes, numBuf);
                sb.Append("}");
            }
        }
        sb.Append("]}\n");
        return sb.ToString();
    }

    // JSON 字符串转义（RFC 8259：引号、反斜杠及全部 0x00..0x1F 控制字符）。
    public static string Quote(string s) {
        if (s == null || s.Length == 0) { return "\"\""; }
        int n = s.Length;
        bool needEsc = false;
        for (int i = 0; i < n; i = i + 1) {
            int c = s[i] & 255;
            if (c == 34 || c == 92 || c < 32) {
                needEsc = true;
                break;
            }
        }
        if (!needEsc) {
            byte[] buf = new byte[n + 2];
            buf[0] = 34;
            NativeMemory.Copy((nint)buf + (nint)1, (nint)s, n);
            buf[n + 1] = 34;
            return NativeMemory.GetString((nint)buf, 0, n + 2);
        }
        StringBuilder sb = new StringBuilder(n + 16);
        BenchReport.QuoteInto(sb, s);
        return sb.ToString();
    }

}
