using System;

namespace Tools.Bench;

// 带强类型参数的基准用例（按实参类型特化，避免装箱开销）。
public class BenchCaseT<TArgs> {
    // 用例名（报告与基线对比的键）。
    public string name;
    // 被测操作。
    public Action<TArgs> body;
    // 参数。
    public TArgs args;

    public BenchCase(string name, Action<TArgs> body, TArgs args) {
        this.name = name != null ? name : "";
        this.body = body;
        this.args = args;
    }

    // 跑一次。
    public void Invoke() {
        if (this.body != null) { this.body(this.args); }
    }
}
