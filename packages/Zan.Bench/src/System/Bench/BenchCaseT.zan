using System;

namespace System.Bench;

// 一个带参数的基准用例。
//
// **参数化为什么单独一个泛型类**：基准的输入（要排序的数组、要解析的
// 文本、要哈希的键）类型各异。与其用 `object` 装箱（Zan 没有装箱），
// 不如把参数类型保留在泛型里——泛型实例化时按实参类型特化，调用点零开销。
//
// 用法：
// ```
// BenchCase<int[]> c = new BenchCase<int[]>("sort-1k",
//     (a) => { SortInPlace(a); }, BuildInput());
// ```
public class BenchCaseT<TArgs> {
    // 用例名（报告与基线对比的键）。
    public string name;
    // 被测操作。
    public ActionT<TArgs> body;
    // 参数。
    public TArgs args;

    public BenchCase(string name, ActionT<TArgs> body, TArgs args) {
        this.name = name != null ? name : "";
        this.body = body;
        this.args = args;
    }

    // 跑一次。
    public void Invoke() {
        if (this.body != null) { this.body(this.args); }
    }
}
