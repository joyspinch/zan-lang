using System;

namespace System.Bench;

// 基准测试的错误。
//
// **异常 + 错误码两个通道**：人看 `Message`（异常自带），程序看 `error`。
public class BenchException : Exception {
    // 错误码。
    public BenchError error;
    // 相关的用例名（没有则为空串）。
    public string caseName;

    public BenchException(BenchError error, string text) : base(text) {
        this.error = error;
        this.caseName = "";
    }

    public BenchException(BenchError error, string caseName, string text) : base(text) {
        this.error = error;
        this.caseName = caseName != null ? caseName : "";
    }

    // 带原始异常的构造（被测操作抛错时用；原异常在 `InnerException` 里）。
    public BenchException(BenchError error, string caseName, string text, Exception cause)
            : base(text, cause) {
        this.error = error;
        this.caseName = caseName != null ? caseName : "";
    }

    // 错误码的英文名（调试输出用；不依赖枚举的字符串格式化行为）。
    public string ErrorName() {
        if (this.error == BenchError.None) { return "None"; }
        if (this.error == BenchError.InvalidCase) { return "InvalidCase"; }
        if (this.error == BenchError.DuplicateCase) { return "DuplicateCase"; }
        if (this.error == BenchError.InvalidBaseline) { return "InvalidBaseline"; }
        if (this.error == BenchError.MissingBaseline) { return "MissingBaseline"; }
        if (this.error == BenchError.InvalidOptions) { return "InvalidOptions"; }
        if (this.error == BenchError.CaseFailed) { return "CaseFailed"; }
        return "Unknown";
    }
}
