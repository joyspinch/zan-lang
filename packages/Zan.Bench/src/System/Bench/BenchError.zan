namespace System.Bench;

// 基准测试的错误原因（可区分的错误码）。
//
// **为什么要错误码**：基准失败的原因差别很大——"用例没注册"是接线错误，
// "用例名重复"是覆盖了别人的用例，"基线文件坏了"是数据问题。三者补救
// 办法不同，合成一句话会让排查变慢。
public enum BenchError {
    // 没有错误。
    None = 0,
    // 用例为 null 或名字为空。
    InvalidCase = 1,
    // 同一个名字注册了两次。
    DuplicateCase = 2,
    // 基线数据损坏（不是合法 JSON，或缺必需字段）。
    InvalidBaseline = 3,
    // 基线里没有这个用例（对比时找不到基准值）。
    MissingBaseline = 4,
    // 选项不合法（轮数为负、上下限颠倒等）。
    InvalidOptions = 5,
    // 被测操作抛了异常（原始异常在 `InnerException` 里）。
    CaseFailed = 6,
}
