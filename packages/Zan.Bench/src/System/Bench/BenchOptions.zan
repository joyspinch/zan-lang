namespace System.Bench;

// 基准测量的选项。
//
// **为什么要这么多旋钮**：基准测试最容易出的错不是"测不准"，而是"测的
// 东西不对"——没预热就测（把 JIT/缓存冷启动算进去）、迭代太少（噪声压过
// 信号）、迭代太多（测到的是机器过热与频率下降）。所以预热轮数、迭代
// 下限、目标总时长、迭代上限四个旋钮都要能显式调。
//
// 默认值偏向"快速拿到可信数字"：预热 3 轮、至少 10 轮、目标 200ms、最多
// 1000 轮。判定器与 CI 用 `Quick()`。
public class BenchOptions {
    // 预热轮数（不计入统计）。
    public int warmupIterations;
    // 最少测量轮数。
    public int minIterations;
    // 最多测量轮数。
    public int maxIterations;
    // 目标总测量时长（毫秒）；达到就停（但不会少于 minIterations）。
    public long targetMilliseconds;

    public BenchOptions() {
        this.warmupIterations = 3;
        this.minIterations = 10;
        this.maxIterations = 1000;
        this.targetMilliseconds = 200;
    }

    public BenchOptions(int warmupIterations, int minIterations, int maxIterations,
                        long targetMilliseconds) {
        this.warmupIterations = warmupIterations;
        this.minIterations = minIterations;
        this.maxIterations = maxIterations;
        this.targetMilliseconds = targetMilliseconds;
    }

    // 默认选项。
    public static BenchOptions Default() {
        return new BenchOptions();
    }

    // 快速选项：预热 1 轮、固定 3 轮、不按时间跑——判定器与 CI 用它，
    // 结果稳定可复现（耗时数字本身仍然依赖机器，但轮数是确定的）。
    public static BenchOptions Quick() {
        return new BenchOptions(1, 3, 3, 0);
    }

    // 复制一份（改副本不改原件）。
    public BenchOptions Copy() {
        return new BenchOptions(this.warmupIterations, this.minIterations,
            this.maxIterations, this.targetMilliseconds);
    }
}
