using System;
using System.Collections.Generic;

namespace System.Bench;

// 一个基准用例的测量结果。
//
// **字段口径**（全部是纳秒，除特别标注）：
// - `iterations`  实际测量轮数（不含预热）
// - `totalNs`     所有轮次耗时之和
// - `meanNs`      平均耗时
// - `medianNs`    中位数（**主指标**）
// - `minNs` / `maxNs`  最快 / 最慢一轮
// - `stdDevNs`    样本标准差（相对波动，>0 说明机器不稳）
// - `opsPerSecond` 每秒操作数（1e9 / meanNs）
public class BenchResult {
    // 用例名。
    public string name;
    // 测量轮数（不含预热）。
    public int iterations;
    // 预热轮数。
    public int warmupIterations;
    // 每轮耗时（纳秒）。
    public List<long> samples;
    // 总耗时（纳秒）。
    public long totalNs;
    // 平均耗时（纳秒）。
    public long meanNs;
    // 中位数耗时（纳秒）。
    public long medianNs;
    // 最快一轮（纳秒）。
    public long minNs;
    // 最慢一轮（纳秒）。
    public long maxNs;
    // 样本标准差（纳秒）。
    public double stdDevNs;
    // 每秒操作数。
    public double opsPerSecond;

    public BenchResult() {
        this.name = "";
        this.iterations = 0;
        this.warmupIterations = 0;
        this.samples = new List<long>();
        this.totalNs = 0;
        this.meanNs = 0;
        this.medianNs = 0;
        this.minNs = 0;
        this.maxNs = 0;
        this.stdDevNs = 0.0;
        this.opsPerSecond = 0.0;
    }

    // 每轮的纳秒样本（转成数组，便于排序与统计）。
    public long[] SampleArray() {
        long[] arr = new long[this.samples.Count];
        for (int i = 0; i < this.samples.Count; i++) { arr[i] = this.samples[i]; }
        return arr;
    }

    // 相对波动（标准差 / 均值）；均值 0 时返回 0。
    public double VarianceRatio() {
        if (this.meanNs <= 0) { return 0.0; }
        return this.stdDevNs / (double)this.meanNs;
    }

    // 一行摘要（报告用）。
    public string Describe() {
        return this.name
            + "  median=" + this.medianNs + "ns"
            + "  mean=" + this.meanNs + "ns"
            + "  min=" + this.minNs + "ns"
            + "  max=" + this.maxNs + "ns"
            + "  sd=" + this.stdDevNs
            + "  ops/s=" + this.opsPerSecond
            + "  iters=" + this.iterations;
    }
}
