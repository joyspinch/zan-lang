using System;
using System.Collections.Generic;

namespace System.Bench;

// 统计原语：排序、中位数、标准差。
//
// **为什么自己写而不用现成的**：`List<T>` 没有 `Sort`（内建 List 的成员表
// 里只有 Count/Add/Reserve/AddRange/Insert/RemoveAt/Clear/Contains/
// IndexOf/LastIndexOf/Reverse/ToArray），而基准样本量小（几十到几百），
// 手写插入排序足够，也省掉一个排序 API 的依赖。
//
// **为什么中位数是主指标**：均值会被偶发尖峰拉走（一次 GC 式停顿、一次
// 调度抖动），中位数不会。基准报告以中位数为准，均值只作参考。
public class BenchStats {
    // 原地升序排序（插入排序）。
    public static void Sort(long[] values) {
        if (values == null) { return; }
        int n = values.Length;
        for (int i = 1; i < n; i++) {
            long key = values[i];
            int j = i - 1;
            while (j >= 0 && values[j] > key) {
                values[j + 1] = values[j];
                j = j - 1;
            }
            values[j + 1] = key;
        }
    }

    // 复制并排序（不改动原数组）。
    public static long[] SortedCopy(long[] values) {
        if (values == null) { return new long[0]; }
        long[] copy = new long[values.Length];
        for (int i = 0; i < values.Length; i++) { copy[i] = values[i]; }
        BenchStats.Sort(copy);
        return copy;
    }

    // 中位数（偶数个取中间两个的平均，向下取整）。
    public static long Median(long[] values) {
        if (values == null || values.Length == 0) { return 0; }
        long[] s = BenchStats.SortedCopy(values);
        int n = s.Length;
        if (n % 2 == 1) { return s[n / 2]; }
        return (s[n / 2 - 1] + s[n / 2]) / 2;
    }

    // 最小值。
    public static long Min(long[] values) {
        if (values == null || values.Length == 0) { return 0; }
        long m = values[0];
        for (int i = 1; i < values.Length; i++) {
            if (values[i] < m) { m = values[i]; }
        }
        return m;
    }

    // 最大值。
    public static long Max(long[] values) {
        if (values == null || values.Length == 0) { return 0; }
        long m = values[0];
        for (int i = 1; i < values.Length; i++) {
            if (values[i] > m) { m = values[i]; }
        }
        return m;
    }

    // 均值（整数除法，截断）。
    public static long Mean(long[] values) {
        if (values == null || values.Length == 0) { return 0; }
        long sum = 0;
        for (int i = 0; i < values.Length; i++) { sum = sum + values[i]; }
        return sum / values.Length;
    }

    // 样本标准差（n-1 分母；样本不足 2 个时返回 0）。
    public static double StdDev(long[] values) {
        if (values == null || values.Length < 2) { return 0.0; }
        double mean = 0.0;
        for (int i = 0; i < values.Length; i++) { mean = mean + (double)values[i]; }
        mean = mean / (double)values.Length;
        double sum = 0.0;
        for (int i = 0; i < values.Length; i++) {
            double d = (double)values[i] - mean;
            sum = sum + d * d;
        }
        double variance = sum / (double)(values.Length - 1);
        return BenchStats.Sqrt(variance);
    }

    // 平方根（牛顿迭代；避免依赖浮点内建的具体行为）。
    public static double Sqrt(double v) {
        if (v <= 0.0) { return 0.0; }
        double x = v;
        if (x > 1.0) { x = v / 2.0; }
        for (int i = 0; i < 40; i++) {
            x = 0.5 * (x + v / x);
        }
        return x;
    }
}
