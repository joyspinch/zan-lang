using System;
using System.Collections.Generic;
using System.Text;

namespace System.Bench;

// 基准报告：文本表格 + JSON。
//
// **为什么两种格式都要**：文本给人看（CI 日志里一眼看出哪个用例慢了），
// JSON 给机器看（存成基线、下次对比、接可视化）。JSON 里存的是
// **中位数**（主指标）而不是均值——均值会被偶发尖峰带偏，基线比的是
// 中位数才稳。
public class BenchReport {
    // 文本报告：每个用例一行，列按最长值右对齐补空格。
    public static string Text(List<BenchResult> results) {
        if (results == null || results.Count == 0) {
            return "(no benchmark cases)\n";
        }
        string[] headers = new string[] {
            "case", "iterations", "median(ns)", "mean(ns)", "min(ns)", "max(ns)", "sd(ns)", "ops/s"
        };
        int cols = headers.Length;
        // 每列的最宽值（表头与所有行一起算）。
        int[] widths = new int[cols];
        for (int c = 0; c < cols; c++) { widths[c] = headers[c].Length; }
        List<string[]> rows = new List<string[]>();
        for (int i = 0; i < results.Count; i++) {
            BenchResult r = results[i];
            string[] row = new string[] {
                r.name,
                "" + r.iterations,
                "" + r.medianNs,
                "" + r.meanNs,
                "" + r.minNs,
                "" + r.maxNs,
                Convert.ToString(r.stdDevNs),
                Convert.ToString(r.opsPerSecond)
            };
            for (int c = 0; c < cols; c++) {
                if (row[c].Length > widths[c]) { widths[c] = row[c].Length; }
            }
            rows.Add(row);
        }

        StringBuilder sb = new StringBuilder();
        sb.Append(BenchReport.Row(headers, widths));
        sb.Append("\n");
        for (int i = 0; i < rows.Count; i++) {
            sb.Append(BenchReport.Row(rows[i], widths));
            sb.Append("\n");
        }
        return sb.ToString();
    }

    // 一行：按列宽左对齐补空格（第一列左对齐，数字列右对齐更好读，
    // 这里统一左对齐——列宽已按内容算好，读起来一样齐）。
    static string Row(string[] cells, int[] widths) {
        StringBuilder sb = new StringBuilder();
        for (int c = 0; c < cells.Length; c++) {
            if (c > 0) { sb.Append("  "); }
            sb.Append(cells[c]);
            int pad = widths[c] - cells[c].Length;
            for (int k = 0; k < pad; k++) { sb.Append(" "); }
        }
        return sb.ToString();
    }

    // JSON 报告（可存成基线文件）。
    public static string Json(List<BenchResult> results) {
        StringBuilder sb = new StringBuilder();
        sb.Append("{\"benchmarks\":[");
        for (int i = 0; i < results.Count; i++) {
            BenchResult r = results[i];
            if (i > 0) { sb.Append(","); }
            sb.Append("{\"name\":");
            sb.Append(BenchReport.Quote(r.name));
            sb.Append(",\"iterations\":");
            sb.Append("" + r.iterations);
            sb.Append(",\"medianNs\":");
            sb.Append("" + r.medianNs);
            sb.Append(",\"meanNs\":");
            sb.Append("" + r.meanNs);
            sb.Append(",\"minNs\":");
            sb.Append("" + r.minNs);
            sb.Append(",\"maxNs\":");
            sb.Append("" + r.maxNs);
            sb.Append(",\"stdDevNs\":");
            sb.Append(Convert.ToString(r.stdDevNs));
            sb.Append(",\"opsPerSecond\":");
            sb.Append(Convert.ToString(r.opsPerSecond));
            sb.Append("}");
        }
        sb.Append("]}\n");
        return sb.ToString();
    }

    // JSON 字符串转义（名字里可能有引号 / 反斜杠 / 换行）。
    public static string Quote(string s) {
        if (s == null) { return "\"\""; }
        StringBuilder sb = new StringBuilder();
        sb.Append("\"");
        for (int i = 0; i < s.Length; i++) {
            string c = s.Substring(i, 1);
            if (c == "\"") { sb.Append("\\\""); }
            else if (c == "\\") { sb.Append("\\\\"); }
            else if (c == "\n") { sb.Append("\\n"); }
            else if (c == "\r") { sb.Append("\\r"); }
            else if (c == "\t") { sb.Append("\\t"); }
            else { sb.Append(c); }
        }
        sb.Append("\"");
        return sb.ToString();
    }


}
