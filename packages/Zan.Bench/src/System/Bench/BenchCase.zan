using System;

namespace System.Bench;

// 一个无参的基准用例。
//
// **为什么是类而不是委托**：基准需要名字、参数、预热策略这些元数据，
// 光一个 `Action` 装不下。用类把"被测操作"和"它的名字"绑在一起，
// 报告里才有可读的名字。
public class BenchCase {
    // 用例名（报告与基线对比的键）。
    public string name;
    // 被测操作。
    public Action body;

    public BenchCase(string name, Action body) {
        this.name = name != null ? name : "";
        this.body = body;
    }

    // 跑一次（异常直接往上抛——基准不该吞异常，异常本身就是结果）。
    public void Invoke() {
        if (this.body != null) { this.body(); }
    }
}
