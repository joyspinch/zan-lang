using System;
namespace Scripting.Lua;

// 封装 Lua 协程（Coroutine 线程对象）。
// 协程与主状态机共享全局表与函数，但在独立的栈上运行。
// 协程在注册表中有固定槽位锚定，离开作用域被 ARC 回收时自动释放槽位。
public class LuaCoroutine : IDisposable {
    public nint threadState;
    public long threadSlot;
    public bool isStarted;
    public bool isDead;
    public string error;

    public LuaCoroutine(nint co, long slot) {
        this.threadState = co;
        this.threadSlot = slot;
        this.isStarted = false;
        this.isDead = false;
        this.error = "";
    }

    public void Dispose() {
        if (this.threadSlot != 0) {
            Lua.DropSlot(this.threadSlot);
            this.threadSlot = 0;
        }
        this.threadState = 0;
        this.isDead = true;
    }

    // 从一段 Lua 代码创建并准备一个协程（将代码以文本模式编译为 chunk 压入协程栈顶，拒绝预编译字节码）。
    public static LuaCoroutine Create(string code) {
        Lua.EnsureReady();
        long slot = 0;
        nint co = Lua.NewThread(out slot);
        int rc = Lua.LoadTextInto(co, code == null ? "" : code, "=(coroutine)");
        if (rc != 0) {
            LuaIdxIntFn ty = (LuaIdxIntFn)Lua.addr_type;
            string err = "(load error)";
            int t = ty(co, 0 - 1);
            if (t == Lua.TSTRING || t == Lua.TNUMBER) {
                LuaToStrFn f = (LuaToStrFn)Lua.addr_tolstring;
                string s = f(co, 0 - 1, 0);
                if (s != null) { err = s; }
            }
            Lua.DropSlot(slot);
            throw new InvalidOperationException("Lua 协程代码编译失败: " + err);
        }
        return new LuaCoroutine(co, slot);
    }

    // 从全局已注册的函数名（如 "OnTalk" 或 "Quest.Dialog"）创建协程。
    public static LuaCoroutine CreateFromFunction(string funcName) {
        Lua.EnsureReady();
        long slot = 0;
        nint co = Lua.NewThread(out slot);
        int mark = Lua.Top();
        try {
            Lua.PushPath(funcName, mark);
            if (Lua.addr_xmove != 0) {
                LuaXMoveFn xm = (LuaXMoveFn)Lua.addr_xmove;
                xm(Lua.state, co, 1);
            } else {
                long fnSlot = Lua.StoreTop();
                Lua.PushSlotTo(co, fnSlot);
                Lua.DropSlot(fnSlot);
            }
            Lua.SetTop(mark);
            return new LuaCoroutine(co, slot);
        } catch (Exception ex) {
            Lua.SetTop(mark);
            Lua.DropSlot(slot);
            throw ex;
        }
    }

    // 单步非阻塞恢复协程执行。
    // 返回状态码：
    // Lua.LUA_OK (0): 执行结束。
    // Lua.LUA_YIELD (1): 主动挂起出让，等待下一次唤醒。
    // 其它: 执行报错（可通过 Error 属性读取详细堆栈）。
    public int Resume(params LuaValue[] args) {
        if (this.isDead || this.threadState == 0 || !Lua.IsInitialized()) {
            return Lua.LUA_OK;
        }
        this.isStarted = true;
        int argc = args == null ? 0 : args.Length;
        // 把传入参数压入协程栈前先确保栈空间充足
        Lua.CheckStack(this.threadState, argc + 4);
        for (int i = 0; i < argc; i = i + 1) {
            if (args[i] != null) {
                args[i].PushTo(this.threadState);
            } else {
                Lua.PushSlotTo(this.threadState, 0);
            }
        }

        int nresults = 0;
        int rc = Lua.ResumeThread(this.threadState, argc, out nresults);
        if (rc == Lua.LUA_OK) {
            this.Dispose();
            return Lua.LUA_OK;
        } else if (rc == Lua.LUA_YIELD) {
            // 清理协程挂起时留在协程栈顶的返回值，防止反复 yield 造成协程栈无限增长
            if (nresults > 0 && Lua.addr_settop != 0) {
                LuaVoidIntFn st = (LuaVoidIntFn)Lua.addr_settop;
                st(this.threadState, 0);
            }
            return Lua.LUA_YIELD;
        } else {
            LuaIdxIntFn ty = (LuaIdxIntFn)Lua.addr_type;
            int t = ty(this.threadState, 0 - 1);
            if (t == Lua.TSTRING || t == Lua.TNUMBER) {
                LuaToStrFn f = (LuaToStrFn)Lua.addr_tolstring;
                string s = f(this.threadState, 0 - 1, 0);
                this.error = s != null ? s : "(runtime error)";
            } else {
                this.error = "(runtime error)";
            }
            this.Dispose();
            return rc;
        }
    }

    // 协程是否正处于挂起等待唤醒状态。
    public bool IsSuspended() {
        return !this.isDead && this.isStarted && Lua.Status(this.threadState) == Lua.LUA_YIELD;
    }

    // 协程是否已经执行完毕。
    public bool IsDone() {
        return this.isDead;
    }

    // 底层协程句柄。
    public nint Handle() {
        return this.threadState;
    }
}
