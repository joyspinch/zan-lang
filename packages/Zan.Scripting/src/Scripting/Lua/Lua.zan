using System;
using System.Diagnostics;
namespace Scripting.Lua;

// 进程内 Lua 5.3/5.4 动态嵌入（运行期解析符号；LuaValue 借注册表槽位绑定 ARC 生命周期）。
public class Lua {
    public static int REGISTRY = 0 - 1001000;

    public static int TNIL = 0;
    public static int TBOOLEAN = 1;
    public static int TNUMBER = 3;
    public static int TSTRING = 4;
    public static int TTABLE = 5;
    public static int TFUNCTION = 6;

    public static nint mod;
    public static nint state;
    public static nint addr_newstate;
    public static nint addr_openlibs;
    public static nint addr_close;
    public static nint addr_loadstring;
    public static nint addr_loadbufferx;
    public static nint addr_pcallk;
    public static nint addr_gettop;
    public static nint addr_settop;
    public static nint addr_type;
    public static nint addr_toboolean;
    public static nint addr_tonumberx;
    public static nint addr_tointegerx;
    public static nint addr_tolstring;
    public static nint addr_pushnumber;
    public static nint addr_pushinteger;
    public static nint addr_pushstring;
    public static nint addr_pushboolean;
    public static nint addr_pushnil;
    public static nint addr_pushvalue;
    public static nint addr_pushcclosure;
    public static nint addr_getglobal;
    public static nint addr_setglobal;
    public static nint addr_getfield;
    public static nint addr_setfield;
    public static nint addr_geti;
    public static nint addr_seti;
    public static nint addr_rawgeti;
    public static nint addr_rawseti;
    public static nint addr_rawlen;
    public static nint addr_next;
    public static nint addr_createtable;
    public static nint addr_newthread;
    public static nint addr_resume;
    public static nint addr_yieldk;
    public static nint addr_status;
    public static nint addr_gc;
    public static nint addr_xmove;
    public static nint addr_checkstack;
    private static nint resumeResBuf;

    public static int LUA_OK = 0;
    public static int LUA_YIELD = 1;
    public static int LUA_ERRRUN = 2;
    public static int LUA_ERRSYNTAX = 3;
    public static int LUA_ERRMEM = 4;
    public static int LUA_ERRERR = 5;

    public static int LUA_GCSTOP = 0;
    public static int LUA_GCRESTART = 1;
    public static int LUA_GCCOLLECT = 2;
    public static int LUA_GCCOUNT = 3;
    public static int LUA_GCCOUNTB = 4;
    public static int LUA_GCSTEP = 5;
    public static int LUA_GCSETPAUSE = 6;
    public static int LUA_GCSETSTEPMUL = 7;

    public static bool resolved;
    public static bool initialized;
    // 槽位 1/2 为 Lua 内部占用（LUA_RIDX_MAINTHREAD / LUA_RIDX_GLOBALS）。
    public static long nextSlot;
    private static object stateLock = new object();

    public static bool IsAvailable() { return Lua.TryResolve(); }
    public static bool IsInitialized() {
        lock (Lua.stateLock) {
            return Lua.initialized && Lua.state != 0;
        }
    }

    public static void Initialize() {
        lock (Lua.stateLock) {
            if (Lua.initialized) { return; }
            if (!Lua.TryResolve()) {
                throw new InvalidOperationException(
                    "Lua 运行时不可用:未找到 lua54/lua53 动态库(可调用 Lua.LoadPath 指定路径)");
            }
            Lua.OpenState();
        }
    }

    public static void LoadPath(string libPath) {
        lock (Lua.stateLock) {
            Lua.Finalize();
            Lua.mod = Interop.Load(libPath);
            if (Lua.mod == 0) {
                throw new InvalidOperationException("无法加载 Lua 动态库: " + libPath);
            }
            if (!Lua.ResolveSymbols()) {
                Lua.FreeModule();
                throw new InvalidOperationException("Lua 动态库缺少所需导出符号: " + libPath);
            }
            Lua.resolved = true;
            Lua.OpenState();
        }
    }

    public static void Finalize() {
        lock (Lua.stateLock) {
            if (Lua.state != 0 && Lua.addr_close != 0) {
                LuaVoid1Fn close = (LuaVoid1Fn)Lua.addr_close;
                close(Lua.state);
            }
            Lua.state = 0;
            Lua.initialized = false;
            if (Lua.resumeResBuf != 0) {
                NativeMemory.Free(Lua.resumeResBuf);
                Lua.resumeResBuf = 0;
            }
            LuaScheduler.Reset();
            Lua.FreeModule();
        }
    }

    // 沙箱：移除进程/文件/环境变量/模块、调试库、字节码转储与 GC 操控入口，保留纯计算标准库。
    public static void Sandbox() {
        Lua.EnsureReady();
        Lua.Exec("if os ~= nil then os.execute = nil; os.remove = nil; os.rename = nil; os.exit = nil; os.getenv = nil; os.tmpname = nil; os.setlocale = nil end\n" +
                 "io = nil\ndebug = nil\ncollectgarbage = nil\n" +
                 "if string ~= nil then string.dump = nil end\n" +
                 "if package ~= nil and package.loaded ~= nil then for k in pairs(package.loaded) do package.loaded[k] = nil end end\n" +
                 "dofile = nil; loadfile = nil; load = nil\nrequire = nil; package = nil\n");
    }

    public static nint State() { return Lua.state; }

    public static int Top() {
        if (Lua.state == 0) { return 0; }
        LuaIntFn f = (LuaIntFn)Lua.addr_gettop;
        return f(Lua.state);
    }

    public static void Exec(string code) {
        Lua.EnsureReady();
        int mark = Lua.Top();
        Lua.LoadAt(Lua.state, code, mark);
        Lua.Protected(0, 0, mark, code);
        Lua.SetTop(mark);
    }

    public static void ExecBytes(byte[] chunk, string chunkName) {
        Lua.EnsureReady();
        int mark = Lua.Top();
        Lua.LoadBytes(chunk, chunkName);
        Lua.Protected(0, 0, mark, chunkName);
        Lua.SetTop(mark);
    }

    public static LuaValue Eval(string code) {
        Lua.EnsureReady();
        int mark = Lua.Top();
        Lua.LoadAt(Lua.state, "return " + code, mark);
        Lua.Protected(0, 1, mark, code);
        LuaValue v = LuaValue.CaptureTop();
        Lua.SetTop(mark);
        return v;
    }

    public static LuaValue GetGlobal(string name) {
        Lua.EnsureReady();
        int mark = Lua.Top();
        LuaGetGlobalFn g = (LuaGetGlobalFn)Lua.addr_getglobal;
        int _t = g(Lua.state, name);
        LuaValue v = LuaValue.CaptureTop();
        Lua.SetTop(mark);
        return v;
    }

    public static void SetGlobal(string name, LuaValue v) {
        Lua.EnsureReady();
        int mark = Lua.Top();
        v.Push();
        LuaVoidStrFn s = (LuaVoidStrFn)Lua.addr_setglobal;
        s(Lua.state, name);
        Lua.SetTop(mark);
    }

    public static LuaValue Call(string name, params LuaValue[] args) {
        Lua.EnsureReady();
        int mark = Lua.Top();
        Lua.CheckStack(Lua.state, args.Length + 4);
        Lua.PushPath(name, mark);
        for (int i = 0; i < args.Length; i = i + 1) { args[i].Push(); }
        Lua.Protected(args.Length, 1, mark, name);
        LuaValue v = LuaValue.CaptureTop();
        Lua.SetTop(mark);
        return v;
    }

    public static double CallD(string name, params double[] args) {
        LuaValue[] vs = new LuaValue[args.Length];
        for (int i = 0; i < args.Length; i = i + 1) { vs[i] = Lua.FromDouble(args[i]); }
        return Lua.Call(name, vs).ToDouble();
    }

    public static long CallL(string name, params long[] args) {
        LuaValue[] vs = new LuaValue[args.Length];
        for (int i = 0; i < args.Length; i = i + 1) { vs[i] = Lua.FromLong(args[i]); }
        return Lua.Call(name, vs).ToLong();
    }

    public static string CallS(string name, params string[] args) {
        LuaValue[] vs = new LuaValue[args.Length];
        for (int i = 0; i < args.Length; i = i + 1) { vs[i] = Lua.FromStr(args[i]); }
        return Lua.Call(name, vs).ToStr();
    }

    public static nint NewThread(out long threadSlot) {
        Lua.EnsureReady();
        if (Lua.addr_newthread == 0) {
            throw new InvalidOperationException("当前 Lua 动态库缺少 lua_newthread 导出符号");
        }
        LuaNewThreadFn f = (LuaNewThreadFn)Lua.addr_newthread;
        nint co = f(Lua.state);
        if (co == 0) { throw new InvalidOperationException("创建 Lua 协程线程失败(内存不足)"); }
        threadSlot = Lua.StoreTop();
        return co;
    }

    public static int ResumeThread(nint co, int nargs, out int nresults) {
        nresults = 0;
        if (Lua.addr_resume == 0 || co == 0) { return Lua.LUA_ERRRUN; }
        LuaResumeFn f = (LuaResumeFn)Lua.addr_resume;
        nint resBuf = 0;
        lock (Lua.stateLock) {
            resBuf = Lua.resumeResBuf;
            Lua.resumeResBuf = 0;
        }
        if (resBuf == 0) { resBuf = NativeMemory.Alloc(4); }
        NativeMemory.Fill(resBuf, 0, 4);
        try {
            int rc = f(co, Lua.state, nargs, resBuf);
            Span<byte> s = new Span<byte>(resBuf, 4);
            nresults = (int)s[0] | ((int)s[1] << 8) | ((int)s[2] << 16) | ((int)s[3] << 24);
            return rc;
        } finally {
            bool freed = false;
            lock (Lua.stateLock) {
                if (Lua.resumeResBuf == 0 && Lua.initialized) {
                    Lua.resumeResBuf = resBuf;
                } else {
                    freed = true;
                }
            }
            if (freed) { NativeMemory.Free(resBuf); }
        }
    }

    public static int Status(nint co) {
        if (Lua.addr_status == 0 || co == 0) { return Lua.LUA_OK; }
        LuaStatusFn f = (LuaStatusFn)Lua.addr_status;
        return f(co);
    }

    public static int Yield(nint L, int nresults) {
        if (Lua.addr_yieldk == 0) {
            throw new InvalidOperationException("当前 Lua 动态库缺少 lua_yieldk 导出符号");
        }
        LuaYieldKFn f = (LuaYieldKFn)Lua.addr_yieldk;
        return f(L, nresults, 0, 0);
    }

    public static int StepGC(int stepKBytes) {
        if (Lua.addr_gc == 0 || Lua.state == 0) { return 0; }
        LuaGcFn f = (LuaGcFn)Lua.addr_gc;
        return f(Lua.state, Lua.LUA_GCSTEP, stepKBytes);
    }

    public static bool TryCall(string name, out string error, params LuaValue[] args) {
        error = "";
        try {
            Lua.EnsureReady();
            int mark = Lua.Top();
            Lua.CheckStack(Lua.state, args.Length + 4);
            Lua.PushPath(name, mark);
            for (int i = 0; i < args.Length; i = i + 1) { args[i].Push(); }
            LuaPcallFn f = (LuaPcallFn)Lua.addr_pcallk;
            int rc = f(Lua.state, args.Length, 1, 0, 0, 0);
            if (rc != 0) {
                error = Lua.TopString();
                Lua.SetTop(mark);
                return false;
            }
            Lua.SetTop(mark);
            return true;
        } catch (Exception ex) {
            error = ex.Message;
            return false;
        }
    }

    public static void ExecEncrypted(byte[] cipherBytes, string key, string chunkName) {
        if (cipherBytes == null || cipherBytes.Length == 0) { return; }
        byte[] plain = new byte[cipherBytes.Length];
        try {
            int klen = key.Length;
            if (klen == 0) {
                for (int i = 0; i < cipherBytes.Length; i = i + 1) { plain[i] = cipherBytes[i]; }
            } else {
                for (int i = 0; i < cipherBytes.Length; i = i + 1) {
                    plain[i] = (byte)(cipherBytes[i] ^ (byte)key[i % klen]);
                }
            }
            Lua.ExecBytes(plain, chunkName);
        } finally {
            for (int i = 0; i < plain.Length; i = i + 1) { plain[i] = 0; }
        }
    }

    public static bool RegisterFunction(string name, LuaCFunction fn) {
        if (!Lua.TryResolve()) { return false; }
        Lua.EnsureReady();
        int mark = Lua.Top();
        LuaPushCClosureFn push = (LuaPushCClosureFn)Lua.addr_pushcclosure;
        push(Lua.state, (nint)fn, 0);
        LuaVoidStrFn s = (LuaVoidStrFn)Lua.addr_setglobal;
        s(Lua.state, name);
        Lua.SetTop(mark);
        return true;
    }

    public static LuaValue Nil() { return LuaValue.Wrap(0); }

    public static LuaValue FromDouble(double v) {
        Lua.EnsureReady();
        LuaPushNumFn f = (LuaPushNumFn)Lua.addr_pushnumber;
        f(Lua.state, v);
        return LuaValue.CaptureTop();
    }

    public static LuaValue FromLong(long v) {
        Lua.EnsureReady();
        LuaPushIntFn f = (LuaPushIntFn)Lua.addr_pushinteger;
        f(Lua.state, v);
        return LuaValue.CaptureTop();
    }

    public static LuaValue FromStr(string s) {
        Lua.EnsureReady();
        LuaPushStrFn f = (LuaPushStrFn)Lua.addr_pushstring;
        nint _p = f(Lua.state, s);
        return LuaValue.CaptureTop();
    }

    public static LuaValue FromBool(bool b) {
        Lua.EnsureReady();
        LuaVoidIntFn f = (LuaVoidIntFn)Lua.addr_pushboolean;
        f(Lua.state, b ? 1 : 0);
        return LuaValue.CaptureTop();
    }

    public static LuaValue FromList(List<LuaValue> items) {
        Lua.EnsureReady();
        int mark = Lua.Top();
        LuaCreateTableFn ct = (LuaCreateTableFn)Lua.addr_createtable;
        ct(Lua.state, items.Count, 0);
        LuaSetIFn si = (LuaSetIFn)Lua.addr_rawseti;
        for (int i = 0; i < items.Count; i = i + 1) {
            items[i].Push();
            si(Lua.state, 0 - 2, (long)(i + 1));
        }
        LuaValue t = LuaValue.CaptureTop();
        Lua.SetTop(mark);
        return t;
    }

    // 直接压栈填表，避免逐元素分配临时 LuaValue 注册表槽位。
    public static LuaValue FromListDouble(List<double> items) {
        Lua.EnsureReady();
        int mark = Lua.Top();
        LuaCreateTableFn ct = (LuaCreateTableFn)Lua.addr_createtable;
        ct(Lua.state, items.Count, 0);
        LuaPushNumFn push = (LuaPushNumFn)Lua.addr_pushnumber;
        LuaSetIFn si = (LuaSetIFn)Lua.addr_rawseti;
        for (int i = 0; i < items.Count; i = i + 1) {
            push(Lua.state, items[i]);
            si(Lua.state, 0 - 2, (long)(i + 1));
        }
        LuaValue t = LuaValue.CaptureTop();
        Lua.SetTop(mark);
        return t;
    }

    public static LuaValue FromListLong(List<long> items) {
        Lua.EnsureReady();
        int mark = Lua.Top();
        LuaCreateTableFn ct = (LuaCreateTableFn)Lua.addr_createtable;
        ct(Lua.state, items.Count, 0);
        LuaPushIntFn push = (LuaPushIntFn)Lua.addr_pushinteger;
        LuaSetIFn si = (LuaSetIFn)Lua.addr_rawseti;
        for (int i = 0; i < items.Count; i = i + 1) {
            push(Lua.state, items[i]);
            si(Lua.state, 0 - 2, (long)(i + 1));
        }
        LuaValue t = LuaValue.CaptureTop();
        Lua.SetTop(mark);
        return t;
    }

    public static LuaValue FromListStr(List<string> items) {
        Lua.EnsureReady();
        int mark = Lua.Top();
        LuaCreateTableFn ct = (LuaCreateTableFn)Lua.addr_createtable;
        ct(Lua.state, items.Count, 0);
        LuaPushStrFn push = (LuaPushStrFn)Lua.addr_pushstring;
        LuaSetIFn si = (LuaSetIFn)Lua.addr_rawseti;
        for (int i = 0; i < items.Count; i = i + 1) {
            nint _p = push(Lua.state, items[i]);
            si(Lua.state, 0 - 2, (long)(i + 1));
        }
        LuaValue t = LuaValue.CaptureTop();
        Lua.SetTop(mark);
        return t;
    }

    public static LuaValue FromDict(Dictionary<string, LuaValue> map) {
        Lua.EnsureReady();
        int mark = Lua.Top();
        LuaCreateTableFn ct = (LuaCreateTableFn)Lua.addr_createtable;
        List<string> keys = map.Keys;
        ct(Lua.state, 0, keys.Count);
        LuaSetFieldFn sf = (LuaSetFieldFn)Lua.addr_setfield;
        for (int i = 0; i < keys.Count; i = i + 1) {
            map[keys[i]].Push();
            sf(Lua.state, 0 - 2, keys[i]);
        }
        LuaValue t = LuaValue.CaptureTop();
        Lua.SetTop(mark);
        return t;
    }

    public static LuaValue FromDictStr(Dictionary<string, string> map) {
        Lua.EnsureReady();
        int mark = Lua.Top();
        LuaCreateTableFn ct = (LuaCreateTableFn)Lua.addr_createtable;
        List<string> keys = map.Keys;
        ct(Lua.state, 0, keys.Count);
        LuaPushStrFn push = (LuaPushStrFn)Lua.addr_pushstring;
        LuaSetFieldFn sf = (LuaSetFieldFn)Lua.addr_setfield;
        for (int i = 0; i < keys.Count; i = i + 1) {
            nint _p = push(Lua.state, map[keys[i]]);
            sf(Lua.state, 0 - 2, keys[i]);
        }
        LuaValue t = LuaValue.CaptureTop();
        Lua.SetTop(mark);
        return t;
    }

    public static double ArgDouble(nint L, int index) {
        LuaNumFn f = (LuaNumFn)Lua.addr_tonumberx;
        return f(L, index, 0);
    }

    public static long ArgLong(nint L, int index) {
        LuaIntegerFn f = (LuaIntegerFn)Lua.addr_tointegerx;
        return f(L, index, 0);
    }

    public static string ArgStr(nint L, int index) {
        LuaIdxIntFn ty = (LuaIdxIntFn)Lua.addr_type;
        int t = ty(L, index);
        if (t != Lua.TSTRING && t != Lua.TNUMBER) { return ""; }
        LuaToStrFn f = (LuaToStrFn)Lua.addr_tolstring;
        return f(L, index, 0);
    }

    public static bool ArgBool(nint L, int index) {
        LuaIdxIntFn f = (LuaIdxIntFn)Lua.addr_toboolean;
        return f(L, index) != 0;
    }

    public static int ArgCount(nint L) {
        LuaIntFn f = (LuaIntFn)Lua.addr_gettop;
        return f(L);
    }

    public static int ReturnDouble(nint L, double v) {
        LuaPushNumFn f = (LuaPushNumFn)Lua.addr_pushnumber;
        f(L, v);
        return 1;
    }

    public static int ReturnLong(nint L, long v) {
        LuaPushIntFn f = (LuaPushIntFn)Lua.addr_pushinteger;
        f(L, v);
        return 1;
    }

    public static int ReturnStr(nint L, string s) {
        LuaPushStrFn f = (LuaPushStrFn)Lua.addr_pushstring;
        nint _p = f(L, s);
        return 1;
    }

    public static int ReturnBool(nint L, bool b) {
        LuaVoidIntFn f = (LuaVoidIntFn)Lua.addr_pushboolean;
        f(L, b ? 1 : 0);
        return 1;
    }

    public static int ReturnNil(nint L) {
        LuaVoid1Fn f = (LuaVoid1Fn)Lua.addr_pushnil;
        f(L);
        return 1;
    }

    public static void EnsureReady() {
        if (!Lua.initialized) { Lua.Initialize(); }
    }

    public static void OpenState() {
        LuaNewStateFn ns = (LuaNewStateFn)Lua.addr_newstate;
        Lua.state = ns();
        if (Lua.state == 0) {
            throw new InvalidOperationException("Lua 状态创建失败(内存不足)");
        }
        LuaVoid1Fn open = (LuaVoid1Fn)Lua.addr_openlibs;
        open(Lua.state);
        Lua.nextSlot = 1000;
        Lua.initialized = true;
    }

    public static void SetTop(int n) {
        LuaVoidIntFn f = (LuaVoidIntFn)Lua.addr_settop;
        f(Lua.state, n);
    }

    public static void CheckStack(nint L, int extra) {
        if (L == 0 || extra <= 0 || Lua.addr_checkstack == 0) { return; }
        LuaIdxIntFn f = (LuaIdxIntFn)Lua.addr_checkstack;
        if (f(L, extra) == 0) {
            throw new InvalidOperationException("Lua 栈空间不足（lua_checkstack 失败）");
        }
    }

    // 仅允许文本模式 ("t") 加载源码，拒绝 \x1bLua 预编译字节码绕过沙箱。
    public static int LoadTextInto(nint L, string code, string chunkName) {
        string src = code == null ? "" : code;
        if (src.Length > 0 && (src[0] & 255) == 27) {
            LuaPushStrFn ps = (LuaPushStrFn)Lua.addr_pushstring;
            nint _p = ps(L, "attempt to load a binary chunk (mode is 't')");
            return Lua.LUA_ERRSYNTAX;
        }
        if (Lua.addr_loadbufferx != 0) {
            LuaLoadBufFn fb = (LuaLoadBufFn)Lua.addr_loadbufferx;
            return fb(L, (nint)src, (long)src.Length, chunkName, "t");
        }
        LuaLoadFn f = (LuaLoadFn)Lua.addr_loadstring;
        return f(L, src);
    }

    public static void LoadAt(nint L, string code, int mark) {
        if (Lua.LoadTextInto(L, code, "=(chunk)") != 0) {
            Lua.FailAt("Lua 代码编译失败", mark);
        }
    }

    public static void Load(string code) {
        int mark = Lua.Top();
        Lua.LoadAt(Lua.state, code, mark);
    }

    // 仅宿主内部可达：沙箱已置 nil 脚本侧 load，仅允许文本模式 ("t") 拒绝预编译字节码，加载后立即擦除明文缓冲。
    public static void LoadBytes(byte[] chunk, string chunkName) {
        if (chunk == null || chunk.Length == 0) {
            throw new InvalidOperationException("Lua chunk 为空");
        }
        int mark = Lua.Top();
        LuaLoadBufFn f = (LuaLoadBufFn)Lua.addr_loadbufferx;
        int rc = f(Lua.state, (nint)chunk, (long)chunk.Length, chunkName, "t");
        for (int i = 0; i < chunk.Length; i = i + 1) { chunk[i] = 0; }
        if (rc != 0) { Lua.FailAt("Lua chunk 编译失败: " + chunkName, mark); }
    }

    public static void Protected(int nargs, int nres, int mark, string what) {
        LuaPcallFn f = (LuaPcallFn)Lua.addr_pcallk;
        if (f(Lua.state, nargs, nres, 0, 0, 0) != 0) { Lua.FailAt("Lua 执行失败: " + what, mark); }
    }

    public static void FailAt(string prefix, int mark) {
        string msg = Lua.TopString();
        Lua.SetTop(mark);
        throw new InvalidOperationException(prefix + ": " + msg);
    }

    public static void Fail(string prefix) {
        Lua.FailAt(prefix, 0);
    }

    public static string TopString() {
        LuaIdxIntFn ty = (LuaIdxIntFn)Lua.addr_type;
        int t = ty(Lua.state, 0 - 1);
        if (t != Lua.TSTRING && t != Lua.TNUMBER) { return "(no message)"; }
        LuaToStrFn f = (LuaToStrFn)Lua.addr_tolstring;
        return f(Lua.state, 0 - 1, 0);
    }

    public static void PushPath(string name, int mark) {
        if (name == null || name.Length == 0) {
            Lua.SetTop(mark);
            throw new InvalidOperationException("Lua 找不到函数: " + (name == null ? "" : name));
        }
        LuaGetGlobalFn g = (LuaGetGlobalFn)Lua.addr_getglobal;
        int dot = name.IndexOf(".");
        if (dot < 0) {
            int t0 = g(Lua.state, name);
            if (t0 != Lua.TFUNCTION) {
                Lua.SetTop(mark);
                throw new InvalidOperationException("Lua 找不到函数: " + name);
            }
            return;
        }
        int t = g(Lua.state, name.Substring(0, dot));
        LuaGetFieldFn gf = (LuaGetFieldFn)Lua.addr_getfield;
        int pos = dot + 1;
        int n = name.Length;
        while (pos <= n) {
            if (t != Lua.TTABLE) {
                Lua.SetTop(mark);
                throw new InvalidOperationException("Lua 找不到函数: " + name);
            }
            Lua.CheckStack(Lua.state, 4);
            int nextDot = name.IndexOf(".", pos);
            string seg = nextDot < 0 ? name.Substring(pos, n - pos) : name.Substring(pos, nextDot - pos);
            t = gf(Lua.state, 0 - 1, seg);
            if (nextDot < 0) { break; }
            pos = nextDot + 1;
        }
        if (t != Lua.TFUNCTION) {
            Lua.SetTop(mark);
            throw new InvalidOperationException("Lua 找不到函数: " + name);
        }
        LuaValue fnv = LuaValue.CaptureTop();
        Lua.SetTop(mark);
        fnv.Push();
    }

    public static bool TryResolve() {
        if (Lua.resolved) { return true; }
        if (Lua.mod == 0) {
            string[] cands = new string[] {
                "lua54.dll", "lua53.dll", "lua5.4.dll", "lua5.3.dll",
                "liblua5.4.so", "liblua5.3.so", "liblua54.so", "liblua53.so",
                "liblua.so.5.4", "liblua.so.5.3", "liblua.so",
                "liblua5.4.dylib", "liblua5.3.dylib", "liblua.dylib"
            };
            // 先查 exe 旁（--publish 随附副本），防 Windows CWD/PATH 劫持。
            string appdir = ProcessHost.AppDir();
            if (appdir != "") {
                for (int i = 0; i < cands.Length; i = i + 1) {
                    Lua.mod = Interop.Load(appdir + "/" + cands[i]);
                    if (Lua.mod != 0) { break; }
                }
            }
            for (int i = 0; Lua.mod == 0 && i < cands.Length; i = i + 1) {
                Lua.mod = Interop.Load(cands[i]);
                if (Lua.mod != 0) { break; }
            }
            if (Lua.mod == 0) { return false; }
        }
        if (!Lua.ResolveSymbols()) {
            Interop.Unload(Lua.mod);
            Lua.mod = 0;
            return false;
        }
        Lua.resolved = true;
        return true;
    }

    public static bool ResolveSymbols() {
        Lua.addr_newstate = Interop.Symbol(Lua.mod, "luaL_newstate");
        Lua.addr_openlibs = Interop.Symbol(Lua.mod, "luaL_openlibs");
        Lua.addr_close = Interop.Symbol(Lua.mod, "lua_close");
        Lua.addr_loadstring = Interop.Symbol(Lua.mod, "luaL_loadstring");
        Lua.addr_loadbufferx = Interop.Symbol(Lua.mod, "luaL_loadbufferx");
        Lua.addr_pcallk = Interop.Symbol(Lua.mod, "lua_pcallk");
        Lua.addr_gettop = Interop.Symbol(Lua.mod, "lua_gettop");
        Lua.addr_settop = Interop.Symbol(Lua.mod, "lua_settop");
        Lua.addr_type = Interop.Symbol(Lua.mod, "lua_type");
        Lua.addr_toboolean = Interop.Symbol(Lua.mod, "lua_toboolean");
        Lua.addr_tonumberx = Interop.Symbol(Lua.mod, "lua_tonumberx");
        Lua.addr_tointegerx = Interop.Symbol(Lua.mod, "lua_tointegerx");
        Lua.addr_tolstring = Interop.Symbol(Lua.mod, "lua_tolstring");
        Lua.addr_pushnumber = Interop.Symbol(Lua.mod, "lua_pushnumber");
        Lua.addr_pushinteger = Interop.Symbol(Lua.mod, "lua_pushinteger");
        Lua.addr_pushstring = Interop.Symbol(Lua.mod, "lua_pushstring");
        Lua.addr_pushboolean = Interop.Symbol(Lua.mod, "lua_pushboolean");
        Lua.addr_pushnil = Interop.Symbol(Lua.mod, "lua_pushnil");
        Lua.addr_pushvalue = Interop.Symbol(Lua.mod, "lua_pushvalue");
        Lua.addr_pushcclosure = Interop.Symbol(Lua.mod, "lua_pushcclosure");
        Lua.addr_getglobal = Interop.Symbol(Lua.mod, "lua_getglobal");
        Lua.addr_setglobal = Interop.Symbol(Lua.mod, "lua_setglobal");
        Lua.addr_getfield = Interop.Symbol(Lua.mod, "lua_getfield");
        Lua.addr_setfield = Interop.Symbol(Lua.mod, "lua_setfield");
        Lua.addr_geti = Interop.Symbol(Lua.mod, "lua_geti");
        Lua.addr_seti = Interop.Symbol(Lua.mod, "lua_seti");
        Lua.addr_rawgeti = Interop.Symbol(Lua.mod, "lua_rawgeti");
        Lua.addr_rawseti = Interop.Symbol(Lua.mod, "lua_rawseti");
        Lua.addr_rawlen = Interop.Symbol(Lua.mod, "lua_rawlen");
        Lua.addr_next = Interop.Symbol(Lua.mod, "lua_next");
        Lua.addr_createtable = Interop.Symbol(Lua.mod, "lua_createtable");
        Lua.addr_newthread = Interop.Symbol(Lua.mod, "lua_newthread");
        Lua.addr_resume = Interop.Symbol(Lua.mod, "lua_resume");
        Lua.addr_yieldk = Interop.Symbol(Lua.mod, "lua_yieldk");
        Lua.addr_status = Interop.Symbol(Lua.mod, "lua_status");
        Lua.addr_gc = Interop.Symbol(Lua.mod, "lua_gc");
        Lua.addr_xmove = Interop.Symbol(Lua.mod, "lua_xmove");
        Lua.addr_checkstack = Interop.Symbol(Lua.mod, "lua_checkstack");
        if (Lua.addr_geti == 0) { Lua.addr_geti = Lua.addr_rawgeti; }
        if (Lua.addr_seti == 0) { Lua.addr_seti = Lua.addr_rawseti; }
        return Lua.addr_newstate != 0 && Lua.addr_openlibs != 0
            && Lua.addr_loadstring != 0 && Lua.addr_pcallk != 0
            && Lua.addr_rawgeti != 0 && Lua.addr_rawseti != 0
            && Lua.addr_tolstring != 0 && Lua.addr_createtable != 0;
    }

    public static void FreeModule() {
        if (Lua.mod != 0) {
            Interop.Unload(Lua.mod);
            Lua.mod = 0;
        }
        Lua.resolved = false;
        Lua.addr_newstate = 0;
        Lua.addr_openlibs = 0;
        Lua.addr_close = 0;
        Lua.addr_loadstring = 0;
        Lua.addr_loadbufferx = 0;
        Lua.addr_pcallk = 0;
        Lua.addr_gettop = 0;
        Lua.addr_settop = 0;
        Lua.addr_type = 0;
        Lua.addr_toboolean = 0;
        Lua.addr_tonumberx = 0;
        Lua.addr_tointegerx = 0;
        Lua.addr_tolstring = 0;
        Lua.addr_pushnumber = 0;
        Lua.addr_pushinteger = 0;
        Lua.addr_pushstring = 0;
        Lua.addr_pushboolean = 0;
        Lua.addr_pushnil = 0;
        Lua.addr_pushvalue = 0;
        Lua.addr_pushcclosure = 0;
        Lua.addr_getglobal = 0;
        Lua.addr_setglobal = 0;
        Lua.addr_getfield = 0;
        Lua.addr_setfield = 0;
        Lua.addr_geti = 0;
        Lua.addr_seti = 0;
        Lua.addr_rawgeti = 0;
        Lua.addr_rawseti = 0;
        Lua.addr_rawlen = 0;
        Lua.addr_next = 0;
        Lua.addr_createtable = 0;
        Lua.addr_newthread = 0;
        Lua.addr_resume = 0;
        Lua.addr_yieldk = 0;
        Lua.addr_status = 0;
        Lua.addr_gc = 0;
        Lua.addr_xmove = 0;
        Lua.addr_checkstack = 0;
    }

    public static long StoreTop() {
        lock (Lua.stateLock) {
            long slot = Lua.nextSlot;
            Lua.nextSlot = Lua.nextSlot + 1;
            LuaSetIFn si = (LuaSetIFn)Lua.addr_rawseti;
            si(Lua.state, Lua.REGISTRY, slot);
            return slot;
        }
    }

    public static void PushSlotTo(nint L, long slot) {
        if (L == 0) { return; }
        if (slot == 0) {
            LuaVoid1Fn f = (LuaVoid1Fn)Lua.addr_pushnil;
            f(L);
            return;
        }
        LuaGetIFn g = (LuaGetIFn)Lua.addr_rawgeti;
        int _t = g(L, Lua.REGISTRY, slot);
    }

    public static void PushSlot(long slot) {
        Lua.PushSlotTo(Lua.state, slot);
    }

    public static void DropSlot(long slot) {
        if (slot == 0) { return; }
        lock (Lua.stateLock) {
            if (Lua.state == 0 || !Lua.resolved) { return; }
            LuaVoid1Fn nil = (LuaVoid1Fn)Lua.addr_pushnil;
            nil(Lua.state);
            LuaSetIFn si = (LuaSetIFn)Lua.addr_rawseti;
            si(Lua.state, Lua.REGISTRY, slot);
        }
    }

    public static int TypeOfSlot(long slot) {
        if (slot == 0) { return Lua.TNIL; }
        int mark = Lua.Top();
        Lua.PushSlot(slot);
        LuaIdxIntFn ty = (LuaIdxIntFn)Lua.addr_type;
        int t = ty(Lua.state, 0 - 1);
        Lua.SetTop(mark);
        return t;
    }
}
