using System;
using System.Collections.Generic;

namespace System.Test.Mocks;

// 手写替身（fake / stub / spy）的基类。
//
// **它替代什么**：Moq 的 `new Mock<IFoo>()` 能凭空造一个接口实现（靠代码
// 生成 + 代理），Zan 这边没有那套东西——**替身必须手写**。手写就意味着
// 每个接口的替身都要重复"记录调用"这段样板，本基类把它收掉。
//
// **用法**：
//
// ```zan
// public class FakeUserRepo : MockBase, IUserRepo {
//     private StubValue<int> nextId = new StubValue<int>(1);
//
//     public User Find(int id) {
//         this.Record1("Find", Arg.Text(id));
//         return null;
//     }
//
//     public int Save(string name) {
//         this.Record1("Save", Arg.Text(name));
//         return this.nextId.Value();
//     }
// }
// ```
//
// 断言：
//
// ```zan
// FakeUserRepo repo = new FakeUserRepo();
// repo.Save("张三");
// Assert.True(repo.Calls().Verify("Save", Times.Once()), repo.Calls().Describe());
// ```
//
// **为什么用"记录 + 校验"而不是"断言在替身里"**：断言在替身里会让同一个
// 替身在不同用例里只能断言一次；记录 + 校验允许"先跑一遍，再断言好几条"。
public class MockBase {
    // 调用日志。
    private CallLog log;

    public MockBase() {
        this.log = new CallLog();
    }

    // 调用日志。
    public CallLog Calls() { return this.log; }

    // 记录一次调用（protected：只有派生替身能记，避免测试代码乱记）。
    protected void Record(string method, List<string> args) {
        this.log.Record(method, args);
    }

    // 记录一次无参调用。
    protected void Record0(string method) {
        this.log.Record(method);
    }

    // 记录一次单参调用（实参需已规范化）。
    protected void Record1(string method, string a1) {
        List<string> args = new List<string>();
        args.Add(a1);
        this.log.Record(method, args);
    }

    // 记录一次双参调用。
    protected void Record2(string method, string a1, string a2) {
        List<string> args = new List<string>();
        args.Add(a1);
        args.Add(a2);
        this.log.Record(method, args);
    }

    // 记录一次三参调用。
    protected void Record3(string method, string a1, string a2, string a3) {
        List<string> args = new List<string>();
        args.Add(a1);
        args.Add(a2);
        args.Add(a3);
        this.log.Record(method, args);
    }

    // 某方法被调用了几次。
    public int CallCount(string method) { return this.log.CountOf(method); }

    // 清空调用记录（一个替身在多个用例间复用时用）。
    public void ResetCalls() { this.log.Clear(); }
}
