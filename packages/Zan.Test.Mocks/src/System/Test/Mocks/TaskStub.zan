using System;
using System.Threading;

namespace System.Test.Mocks;

// 异步桩：造一个**已完成 / 已失败 / 永不完成**的 Task。
//
// **场景**：被测代码里有一个 `Task<User> LoadAsync()`，测试里不想真的去
// 发网络请求。没有 `Task.FromResult` 时用 `TaskCompletionSource` 造：
//
// - `Completed(v)`：立刻成功返回 v（最常见的"假装成功"）。
// - `Faulted(msg)`：立刻失败——用来测错误分支（"加载失败时 UI 显示什么"）。
// - `Pending()`：永不完成——用来测超时 / 取消 / 加载中的分支。
//
// **Pending 的代价**：那个 `TaskCompletionSource` 永远不完成，协程永远
// 挂着。它是**测试进程里**的一个挂起协程，测试结束随进程退出而消失；
// 但在同一个测试进程里跑很多个 Pending 用例会攒下挂起协程——一次
// 测试里用一两个就够。
public class TaskStub {
    // 已成功完成的任务。
    public static async Task<T> Completed<T>(T value) {
        TaskCompletionSource<T> tcs = new TaskCompletionSource<T>();
        tcs.SetResult(value);
        return await tcs.Task;
    }

    // 已失败的任务（await 时抛出异常）。
    public static async Task<T> Faulted<T>(string message) {
        TaskCompletionSource<T> tcs = new TaskCompletionSource<T>();
        tcs.SetException(new Exception(message != null ? message : "stubbed failure"));
        return await tcs.Task;
    }

    // 永不完成的任务（测超时 / 取消 / 加载中）。
    public static Task<T> Pending<T>() {
        TaskCompletionSource<T> tcs = new TaskCompletionSource<T>();
        return tcs.Task;
    }
}
