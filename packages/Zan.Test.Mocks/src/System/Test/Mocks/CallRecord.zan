using System;
using System.Collections.Generic;

namespace System.Test.Mocks;

// 一次被记录下来的调用。
//
// **实参存文本**：替身没有反射，拿不到实参的静态类型，只能存规范化后的
// 文本（见 `Arg.Text`）。校验时用匹配器（`ArgMatcher`）比对这些文本。
public class CallRecord {
    // 方法名。
    public string method;
    // 实参（规范化文本）。
    public List<string> args;
    // 调用序号（从 1 开始，保证同一次测试里的顺序可复现）。
    public int sequence;

    public CallRecord(string method, List<string> args, int sequence) {
        this.method = method != null ? method : "";
        this.args = args != null ? args : new List<string>();
        this.sequence = sequence;
    }

    // 实参个数。
    public int ArgCount() { return this.args.Count; }

    // 第 i 个实参。
    public string ArgAt(int i) {
        if (i < 0 || i >= this.args.Count) { return ""; }
        return this.args[i];
    }

    // 可读描述（失败信息用）。
    public string Describe() {
        string s = this.method + "(";
        for (int i = 0; i < this.args.Count; i = i + 1) {
            if (i > 0) { s = s + ", "; }
            s = s + this.args[i];
        }
        return s + ")";
    }
}

// 调用次数期望（Moq 的 `Times.Once()` 那一族）。
//
// **三个模式**：恰好（Exactly）、至少（AtLeast）、至多（AtMost）。
// "恰好 0 次"就是 Never。
public class Times {
    // 模式：0 = 恰好，1 = 至少，2 = 至多。
    public int mode;
    // 次数。
    public int count;

    public Times(int mode, int count) {
        this.mode = mode;
        this.count = count;
    }

    // 恰好 n 次。
    public static Times Exactly(int n) { return new Times(0, n); }

    // 恰好一次。
    public static Times Once() { return new Times(0, 1); }

    // 一次都没有。
    public static Times Never() { return new Times(0, 0); }

    // 至少 n 次。
    public static Times AtLeast(int n) { return new Times(1, n); }

    // 至多 n 次。
    public static Times AtMost(int n) { return new Times(2, n); }

    // 实际次数是否满足期望。
    public bool Accepts(int actual) {
        if (this.mode == 1) { return actual >= this.count; }
        if (this.mode == 2) { return actual <= this.count; }
        return actual == this.count;
    }

    // 可读描述。
    public string Describe() {
        if (this.mode == 1) { return "at least " + this.count.ToString(); }
        if (this.mode == 2) { return "at most " + this.count.ToString(); }
        return "exactly " + this.count.ToString();
    }
}
