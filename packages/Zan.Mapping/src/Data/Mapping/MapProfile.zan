using System;
using System.Collections.Generic;

namespace Data.Mapping;

// 显式映射档案：源类型 → 目标类型（由调用方提供目标工厂，非线程安全）。
public class MapProfile<TSource, TTarget> {
    private List<MapRule<TSource, TTarget>> rules = new List<MapRule<TSource, TTarget>>();
    private Func<TTarget> factory;

    // 目标工厂必填（见类注释）。
    public MapProfile(Func<TTarget> factory) {
        this.factory = factory;
    }

    // 注册一条成员映射规则（链式，兼容类与值类型目标）。
    public MapProfile<TSource, TTarget> Member(string name, Func<TSource, TTarget, TTarget> apply) {
        this.rules.Add(new MapRule<TSource, TTarget>(name, apply));
        return this;
    }

    // 已注册的规则条数。
    public int RuleCount { get { return this.rules.Count; } }

    // 第 index 条规则的成员名（越界返回空串）。
    public string MemberName(int index) {
        if (index < 0 || index >= this.rules.Count) { return ""; }
        return this.rules[index].Name;
    }

    // 全部规则名（按注册顺序）。
    public List<string> MemberNames() {
        List<string> names = new List<string>();
        for (int i = 0; i < this.rules.Count; i = i + 1) {
            names.Add(this.rules[i].Name);
        }
        return names;
    }

    // 映射一条：失败抛 `MappingException`（带成员名）。
    public TTarget Map(TSource source) {
        MappingResult<TTarget> r = this.TryMap(source);
        if (r.IsError) {
            throw new MappingException(r.Error, r.Message, r.Member);
        }
        return r.Target;
    }

    private static MappingResult<TTarget> Fail(MappingError err, string msg, string member) {
        MappingResult<TTarget> res = new MappingResult<TTarget>();
        res.IsError = true;
        res.Error = err;
        res.Message = msg;
        res.Member = member;
        return res;
    }

    // 映射一条：不抛，返回结果对象。
    public MappingResult<TTarget> TryMap(TSource source) {
        if (source == null) {
            return MapProfile<TSource, TTarget>.Fail(MappingError.SourceNull, "source is null", "");
        }
        if (this.factory == null) {
            return MapProfile<TSource, TTarget>.Fail(MappingError.InvalidFactory, "the profile has no target factory", "");
        }
        MappingResult<TTarget> res = new MappingResult<TTarget>();
        try {
            res.Target = this.factory();
        } catch (Exception e) {
            return MapProfile<TSource, TTarget>.Fail(MappingError.InvalidFactory,
                "target factory failed: " + e.Message, "");
        }
        TTarget target = res.Target;
        for (int i = 0; i < this.rules.Count; i = i + 1) {
            MapRule<TSource, TTarget> rule = this.rules[i];
            if (rule.Apply == null) {
                return MapProfile<TSource, TTarget>.Fail(MappingError.MemberFailed,
                    "member '" + rule.Name + "' has no apply function", rule.Name);
            }
            try {
                target = rule.Apply(source, target);
            } catch (Exception e) {
                return MapProfile<TSource, TTarget>.Fail(MappingError.MemberFailed,
                    "member '" + rule.Name + "' failed: " + e.Message, rule.Name);
            }
        }
        res.Target = target;
        return res;
    }

    // 映射一个列表：任一条失败就整体失败（抛 `MappingException`）。
    public List<TTarget> MapList(List<TSource> sources) {
        MappingResult<TTarget> r = this.TryMapList(sources);
        if (r.IsError) {
            throw new MappingException(r.Error, r.Message, r.Member);
        }
        return r.Targets;
    }

    // 映射一个列表：不抛，返回结果对象（结果在 `Targets` 里）。
    public MappingResult<TTarget> TryMapList(List<TSource> sources) {
        if (sources == null) {
            return MapProfile<TSource, TTarget>.Fail(MappingError.InvalidSourceList, "source list is null", "");
        }
        List<TTarget> outv = new List<TTarget>();
        for (int i = 0; i < sources.Count; i = i + 1) {
            MappingResult<TTarget> one = this.TryMap(sources[i]);
            if (one.IsError) {
                MappingResult<TTarget> res = MapProfile<TSource, TTarget>.Fail(
                    one.Error, "item " + i.ToString() + ": " + one.Message, one.Member);
                res.Targets = outv;
                return res;
            }
            outv.Add(one.Target);
        }
        MappingResult<TTarget> ok = new MappingResult<TTarget>();
        ok.Targets = outv;
        return ok;
    }
}
