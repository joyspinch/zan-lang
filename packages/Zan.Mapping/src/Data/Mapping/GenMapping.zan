using System;
using System.Collections.Generic;
using System.Json;

namespace Data.Mapping;

// **能力层**：映射代码生成器——把"映什么"变成**显式**的映射函数源码。
//
// ## 为什么在生成期而不是运行期
//
// AutoMapper 的"按约定自动映射"靠运行期反射：运行期得知道目标类型有哪些
// 成员。Zan 没有反射（没有 `typeof`、没有成员枚举），所以自动匹配只能放在
// **生成期**：读编译期导出的实体元数据（`zanc --gen-meta out.json` 导出的
// JSON），按约定配对成员，生成一段**普通 Zan 源码**。
//
// 生成物是编译期常量：没有反射、没有装箱、没有运行期开销，也没有"约定
// 悄悄变了"的可能（生成物进版本库，diff 得出来）。
//
// ## 约定（AutoMapper 同源的那部分）
//
// 1. **同名同类型**：源与目标都有 `code: string` → 直接拷。
// 2. **扁平化**：目标有 `customerName`，源有 `customer.name` → 拷嵌套成员
//    （一级字段名与二级字段名拼起来大小写无关地相等即命中）。
// 3. 配不上的**如实报出来**，不猜、不静默跳过。
//
// ## 实体元数据格式
//
// `zanc --gen-meta out.json` 导出的 JSON：
// ```json
// { "classes": [ { "name": "Order", "ns": "Demo", "kind": "class",
//                   "fields": [ { "name": "code", "type": "string",
//                                 "static": false, "private": false } ],
//                   "ctors": [ { "params": [] } ] } ] }
// ```
// 字段可见性取自 `private` / `protected`（默认 public）——不可写的字段不参与
// 配对。
public class GenMapping {
    // 按规格生成映射源码；规格不合法抛 `MappingException`（`InvalidSpec`）。
    public static string Emit(MappingSpec spec) {
        string code = "";
        string error = "";
        if (!TryEmit(spec, out code, out error)) {
            throw new MappingException(MappingError.InvalidSpec, error);
        }
        return code;
    }

    // 按规格生成映射源码：不抛的版本（失败返回 false，原因在 `error`）。
    public static bool TryEmit(MappingSpec spec, out string code, out string error) {
        code = "";
        error = "";
        if (spec == null) { error = "spec is null"; return false; }
        string srcType = spec.SourceType != null ? spec.SourceType : "";
        string dstType = spec.TargetType != null ? spec.TargetType : "";
        if (!IsIdentifier(srcType)) {
            error = "source type '" + srcType + "' is not a valid type name";
            return false;
        }
        if (!IsIdentifier(dstType)) {
            error = "target type '" + dstType + "' is not a valid type name";
            return false;
        }
        string cls = spec.ClassName != null && spec.ClassName != ""
            ? spec.ClassName : srcType + "Mapper";
        if (!IsIdentifier(cls)) {
            error = "class name '" + cls + "' is not a valid identifier";
            return false;
        }
        string nsName = spec.NamespaceName != null ? spec.NamespaceName : "";
        if (nsName != "" && !IsNamespace(nsName)) {
            error = "namespace '" + nsName + "' is not valid";
            return false;
        }
        List<MappingMember> members = spec.Members != null ? spec.Members : new List<MappingMember>();
        for (int i = 0; i < members.Count; i = i + 1) {
            MappingMember mem = members[i];
            if (mem == null) {
                error = "member at index " + i + " is null";
                return false;
            }
            string from = mem.From != null ? mem.From : "";
            string to = mem.To != null ? mem.To : "";
            if (!IsMemberPath(from)) {
                error = "source member path '" + from + "' is not valid";
                return false;
            }
            if (!IsIdentifier(to)) {
                error = "target member '" + to + "' is not a valid identifier";
                return false;
            }
        }
        List<string> usings = new List<string>();
        if (spec.Usings != null) {
            for (int i = 0; i < spec.Usings.Count; i = i + 1) {
                string u = spec.Usings[i];
                if (u == null) { continue; }
                if (u != "" && !IsNamespace(u)) {
                    error = "using '" + u + "' is not a valid namespace";
                    return false;
                }
                usings.Add(u);
            }
        }
        code = BuildSource(nsName, cls, srcType, dstType, members,
                           spec.WithListMap, usings);
        return true;
    }

    // 按实体元数据 + 约定生成映射源码：不抛的版本。
    //
    // `nsName` 空串 = 放在全局命名空间；`className` 空串 = 「源类型名 + Mapper」。
    public static bool TryEmitFromEntities(JsonValue entities, string sourceType,
                                           string targetType, string className,
                                           string nsName, bool withListMap,
                                           out string code, out string error) {
        code = "";
        error = "";
        ConventionMatch m = Match(entities, sourceType, targetType);
        if (m.Error != "") { error = m.Error; return false; }
        MappingSpec spec = new MappingSpec();
        spec.SourceType = sourceType;
        spec.TargetType = targetType;
        spec.ClassName = className != null && className != ""
            ? className : sourceType + "Mapper";
        spec.NamespaceName = nsName != null ? nsName : "";
        spec.WithListMap = withListMap;
        for (int i = 0; i < m.Members.Count; i = i + 1) {
            spec.Members.Add(m.Members[i]);
        }
        string srcNs = m.SrcNs;
        string dstNs = m.DstNs;
        if (srcNs != "" && srcNs != spec.NamespaceName) { spec.Usings.Add(srcNs); }
        if (dstNs != "" && dstNs != spec.NamespaceName && dstNs != srcNs) {
            spec.Usings.Add(dstNs);
        }
        return TryEmit(spec, out code, out error);
    }

    // 按约定配对出的成员对（源路径 → 目标成员名）。
    public static List<MappingMember> MatchByConvention(JsonValue entities,
                                                        string sourceType,
                                                        string targetType) {
        return Match(entities, sourceType, targetType).Members;
    }

    // 按约定**配不上**的目标成员名（如类型不同、需要显式转换的）。
    public static List<string> UnmatchedByConvention(JsonValue entities,
                                                     string sourceType,
                                                     string targetType) {
        return Match(entities, sourceType, targetType).Unmatched;
    }

    // ---- 内部实现 ----

    // 约定配对的结果（配上的 + 配不上的）。
    private class ConventionMatch {
        public List<MappingMember> Members = new List<MappingMember>();
        public List<string> Unmatched = new List<string>();
        public string Error = "";
        public string SrcNs = "";
        public string DstNs = "";
    }

    private static string ConcatLowerAscii(string a, string b) {
        int al = a.Length;
        int bl = b.Length;
        int total = al + bl;
        byte[] buf = new byte[total];
        for (int i = 0; i < al; i = i + 1) {
            int c = a[i] & 255;
            buf[i] = (byte)((c >= 65 && c <= 90) ? c + 32 : c);
        }
        for (int i = 0; i < bl; i = i + 1) {
            int c = b[i] & 255;
            buf[al + i] = (byte)((c >= 65 && c <= 90) ? c + 32 : c);
        }
        return NativeMemory.GetString((nint)buf, 0, total);
    }

    private static string LowerAscii(string s) {
        int n = s.Length;
        bool need = false;
        for (int i = 0; i < n; i = i + 1) {
            int c = s[i] & 255;
            if (c >= 65 && c <= 90) { need = true; break; }
        }
        if (!need) { return s; }
        byte[] buf = new byte[n];
        for (int i = 0; i < n; i = i + 1) {
            int c = s[i] & 255;
            buf[i] = (byte)((c >= 65 && c <= 90) ? c + 32 : c);
        }
        return NativeMemory.GetString((nint)buf, 0, n);
    }

    private static bool EqConcatIgnoreCase(string a, string b, string target) {
        int al = a.Length;
        int bl = b.Length;
        if (al + bl != target.Length) { return false; }
        for (int i = 0; i < al; i = i + 1) {
            int c1 = a[i] & 255;
            int c2 = target[i] & 255;
            if (c1 >= 65 && c1 <= 90) { c1 = c1 + 32; }
            if (c2 >= 65 && c2 <= 90) { c2 = c2 + 32; }
            if (c1 != c2) { return false; }
        }
        for (int i = 0; i < bl; i = i + 1) {
            int c1 = b[i] & 255;
            int c2 = target[al + i] & 255;
            if (c1 >= 65 && c1 <= 90) { c1 = c1 + 32; }
            if (c2 >= 65 && c2 <= 90) { c2 = c2 + 32; }
            if (c1 != c2) { return false; }
        }
        return true;
    }

    private static void ExtractWritableFields(JsonValue cls, List<string> names, List<string> types) {
        if (cls == null) { return; }
        JsonValue fields = cls.Get("fields");
        if (fields == null || !fields.IsArray()) { return; }
        int cnt = fields.Count();
        for (int i = 0; i < cnt; i = i + 1) {
            JsonValue f = fields.At(i);
            if (f == null) { continue; }
            if (JsonBool(f.Get("static"), false)) { continue; }
            if (JsonBool(f.Get("private"), false)) { continue; }
            if (JsonBool(f.Get("protected"), false)) { continue; }
            names.Add(JsonStr(f.Get("name"), ""));
            types.Add(JsonStr(f.Get("type"), ""));
        }
    }

    private static ConventionMatch Match(JsonValue entities, string sourceType,
                                         string targetType) {
        ConventionMatch m = new ConventionMatch();
        JsonValue sc = null;
        JsonValue tc = null;
        JsonValue classes = entities == null ? null : entities.Get("classes");
        int classCount = (classes != null && classes.IsArray()) ? classes.Count() : 0;
        if (sourceType != "" && targetType != "" && classCount > 0) {
            for (int i = 0; i < classCount; i = i + 1) {
                JsonValue c = classes.At(i);
                if (c == null) { continue; }
                string cname = JsonStr(c.Get("name"), "");
                if (sc == null && cname == sourceType) { sc = c; }
                if (tc == null && cname == targetType) { tc = c; }
                if (sc != null && tc != null) { break; }
            }
        } else {
            sc = FindClass(entities, sourceType);
            tc = FindClass(entities, targetType);
        }
        if (sc == null) {
            m.Error = "source type '" + sourceType + "' is not in the entity metadata";
            return m;
        }
        if (tc == null) {
            m.Error = "target type '" + targetType + "' is not in the entity metadata";
            return m;
        }
        if (!HasParameterlessCtor(tc)) {
            m.Error = "target type '" + targetType +
                      "' has no parameterless constructor (the generated code uses new " +
                      targetType + "())";
            return m;
        }
        m.SrcNs = JsonStr(sc.Get("ns"), "");
        m.DstNs = JsonStr(tc.Get("ns"), "");

        List<string> sNames = new List<string>();
        List<string> sTypes = new List<string>();
        ExtractWritableFields(sc, sNames, sTypes);
        int sCount = sNames.Count;
        Dict<string, int> sByName = new Dict<string, int>();
        bool sHasDup = false;
        for (int j = 0; j < sCount; j = j + 1) {
            string sn = sNames[j];
            if (sn == "") { continue; }
            if (sByName.ContainsKey(sn)) { sHasDup = true; }
            else { sByName.Add(sn, j); }
        }

        List<string> tNames = new List<string>();
        List<string> tTypes = new List<string>();
        ExtractWritableFields(tc, tNames, tTypes);
        int tCount = tNames.Count;

        bool flatBuilt = false;
        List<string> flatSName = null;
        List<string> flatBName = null;
        List<string> flatBType = null;
        Dict<string, int> flatByLower = null;
        bool flatHasDup = false;

        for (int i = 0; i < tCount; i = i + 1) {
            string tname = tNames[i];
            if (tname == "") { continue; }
            string ttype = tTypes[i];
            string from = "";
            // 约定一：同名同类型
            int sIdx = -1;
            if (sByName.TryGetValue(tname, out sIdx)) {
                if (TypeEq(sTypes[sIdx], ttype)) {
                    from = tname;
                } else if (sHasDup) {
                    for (int j = sIdx + 1; j < sCount; j = j + 1) {
                        if (sNames[j] == tname && TypeEq(sTypes[j], ttype)) {
                            from = tname;
                            break;
                        }
                    }
                }
            }
            // 约定二：扁平化（一级字段 + 它的字段 == 目标名）
            if (from == "") {
                if (!flatBuilt) {
                    flatBuilt = true;
                    flatSName = new List<string>();
                    flatBName = new List<string>();
                    flatBType = new List<string>();
                    Dict<string, JsonValue> classMap = new Dict<string, JsonValue>();
                    for (int ci = 0; ci < classCount; ci = ci + 1) {
                        JsonValue c = classes.At(ci);
                        if (c == null) { continue; }
                        string cname = JsonStr(c.Get("name"), "");
                        if (cname != "" && !classMap.ContainsKey(cname)) {
                            classMap.Add(cname, c);
                        }
                    }
                    List<string> subNames = new List<string>();
                    List<string> subTypes = new List<string>();
                    for (int j = 0; j < sCount; j = j + 1) {
                        string sn = sNames[j];
                        string st = sTypes[j];
                        if (sn == "" || st == "") { continue; }
                        JsonValue sub = null;
                        if (!classMap.TryGetValue(st, out sub) || sub == null) { continue; }
                        subNames.Clear();
                        subTypes.Clear();
                        ExtractWritableFields(sub, subNames, subTypes);
                        for (int k = 0; k < subNames.Count; k = k + 1) {
                            string bn = subNames[k];
                            if (bn == "") { continue; }
                            flatSName.Add(sn);
                            flatBName.Add(bn);
                            flatBType.Add(subTypes[k]);
                        }
                    }
                    if (flatSName.Count > 8) {
                        flatByLower = new Dict<string, int>();
                        for (int k = 0; k < flatSName.Count; k = k + 1) {
                            string lk = ConcatLowerAscii(flatSName[k], flatBName[k]);
                            if (flatByLower.ContainsKey(lk)) { flatHasDup = true; }
                            else { flatByLower.Add(lk, k); }
                        }
                    }
                }
                int fCount = flatSName.Count;
                if (fCount > 0) {
                    if (flatByLower != null) {
                        string tl = LowerAscii(tname);
                        int fIdx = -1;
                        if (flatByLower.TryGetValue(tl, out fIdx)) {
                            if (TypeEq(flatBType[fIdx], ttype)) {
                                from = flatSName[fIdx] + "." + flatBName[fIdx];
                            } else if (flatHasDup) {
                                for (int k = fIdx + 1; k < fCount; k = k + 1) {
                                    if (EqConcatIgnoreCase(flatSName[k], flatBName[k], tname)
                                        && TypeEq(flatBType[k], ttype)) {
                                        from = flatSName[k] + "." + flatBName[k];
                                        break;
                                    }
                                }
                            }
                        }
                    } else {
                        for (int k = 0; k < fCount; k = k + 1) {
                            if (EqConcatIgnoreCase(flatSName[k], flatBName[k], tname)
                                && TypeEq(flatBType[k], ttype)) {
                                from = flatSName[k] + "." + flatBName[k];
                                break;
                            }
                        }
                    }
                }
            }
            if (from == "") { m.Unmatched.Add(tname); continue; }
            m.Members.Add(new MappingMember(from, tname));
        }
        return m;
    }

    // 拼出最终的映射源码。
    private static string BuildSource(string nsName, string className,
                                      string srcType, string dstType,
                                      List<MappingMember> members,
                                      bool withListMap, List<string> usings) {
        int est = 512 + members.Count * 48 + usings.Count * 24 + (withListMap ? 320 : 0);
        StringBuilder sb = new StringBuilder(est);
        sb.Append("// <auto-generated>\n");
        sb.Append("// 由 System.Mapping.GenMapping 生成——重新生成会覆盖，勿手改。\n");
        sb.Append("// 源类型："); sb.Append(srcType); sb.Append("    目标类型："); sb.Append(dstType); sb.Append("\n");
        sb.Append("\n");
        sb.Append("using System;\n");
        if (withListMap) { sb.Append("using System.Collections.Generic;\n"); }
        for (int i = 0; i < usings.Count; i = i + 1) {
            string u = usings[i];
            if (u == "" || u == nsName) { continue; }
            sb.Append("using "); sb.Append(u); sb.Append(";\n");
        }
        sb.Append("\n");
        if (nsName != "") { sb.Append("namespace "); sb.Append(nsName); sb.Append(";\n\n"); }
        sb.Append("public static class "); sb.Append(className); sb.Append(" {\n");
        sb.Append("    // 把 "); sb.Append(srcType); sb.Append(" 映射成 "); sb.Append(dstType);
        sb.Append("（显式字段拷贝，无反射）。\n");
        sb.Append("    public static "); sb.Append(dstType); sb.Append(" Map("); sb.Append(srcType); sb.Append(" src) {\n");
        sb.Append("        "); sb.Append(dstType); sb.Append(" dst = new "); sb.Append(dstType); sb.Append("();\n");
        for (int i = 0; i < members.Count; i = i + 1) {
            MappingMember mem = members[i];
            sb.Append("        dst."); sb.Append(mem.To); sb.Append(" = src."); sb.Append(mem.From); sb.Append(";\n");
        }
        sb.Append("        return dst;\n");
        sb.Append("    }\n");
        if (withListMap) {
            sb.Append("\n");
            sb.Append("    // 列表映射：逐个元素走 Map。\n");
            sb.Append("    public static List<"); sb.Append(dstType); sb.Append("> MapList(List<");
            sb.Append(srcType); sb.Append("> src) {\n");
            sb.Append("        List<"); sb.Append(dstType); sb.Append("> outv = new List<"); sb.Append(dstType); sb.Append(">();\n");
            sb.Append("        for (int i = 0; i < src.Count; i = i + 1) {\n");
            sb.Append("            outv.Add(Map(src[i]));\n");
            sb.Append("        }\n");
            sb.Append("        return outv;\n");
            sb.Append("    }\n");
        }
        sb.Append("}\n");
        return sb.ToString();
    }

    // 在实体元数据里找类（按名字）。
    private static JsonValue FindClass(JsonValue entities, string typeName) {
        if (entities == null || typeName == "") { return null; }
        JsonValue classes = entities.Get("classes");
        if (classes == null || !classes.IsArray()) { return null; }
        for (int i = 0; i < classes.Count(); i = i + 1) {
            JsonValue c = classes.At(i);
            if (c == null) { continue; }
            if (JsonStr(c.Get("name"), "") == typeName) { return c; }
        }
        return null;
    }

    // 目标类型有没有无参构造器（没有显式构造器 = 有隐式无参构造器）。
    private static bool HasParameterlessCtor(JsonValue cls) {
        if (cls == null) { return false; }
        JsonValue ctors = cls.Get("ctors");
        if (ctors == null || !ctors.IsArray() || ctors.Count() == 0) { return true; }
        for (int i = 0; i < ctors.Count(); i = i + 1) {
            JsonValue c = ctors.At(i);
            if (c == null) { continue; }
            JsonValue ps = c.Get("params");
            if (ps == null || !ps.IsArray() || ps.Count() == 0) { return true; }
        }
        return false;
    }

    // 类型名比较（大小写无关——Zan 的内建类型名都是小写，类名首字母大写）。
    private static bool TypeEq(string a, string b) {
        return EqIgnoreCase(a, b);
    }

    private static bool EqIgnoreCase(string a, string b) {
        if (a == null || b == null) { return false; }
        int n = a.Length;
        if (n != b.Length) { return false; }
        for (int i = 0; i < n; i = i + 1) {
            int c1 = a[i] & 255;
            int c2 = b[i] & 255;
            if (c1 == c2) { continue; }
            if (c1 >= 65 && c1 <= 90) { c1 = c1 + 32; }
            if (c2 >= 65 && c2 <= 90) { c2 = c2 + 32; }
            if (c1 != c2) { return false; }
        }
        return true;
    }

    private static string JsonStr(JsonValue v, string dflt) {
        if (v == null) { return dflt; }
        if (v.IsString()) { return v.strVal; }
        return dflt;
    }

    private static bool JsonBool(JsonValue v, bool dflt) {
        if (v == null) { return dflt; }
        if (v.IsBool()) { return v.boolVal; }
        return dflt;
    }

    // 标识符校验：首字符是字母或下划线，其余是字母 / 数字 / 下划线。
    // （Zan 没有 char 类型，字符串下标取的是**字节**，所以按字节值判。）
    private static bool IsIdentifier(string s) {
        if (s == null || s.Length == 0) { return false; }
        int b0 = s[0] & 255;
        if (!IsIdentStart(b0)) { return false; }
        for (int i = 1; i < s.Length; i = i + 1) {
            int b = s[i] & 255;
            if (!IsIdentStart(b) && !IsDigit(b)) { return false; }
        }
        return true;
    }

    private static bool IsDotSeparatedIdentifiers(string s) {
        if (s == null || s.Length == 0) { return false; }
        int n = s.Length;
        bool atStart = true;
        for (int i = 0; i < n; i = i + 1) {
            int b = s[i] & 255;
            if (b == 46) {
                if (atStart) { return false; }
                atStart = true;
            } else if (atStart) {
                if (!IsIdentStart(b)) { return false; }
                atStart = false;
            } else {
                if (!IsIdentStart(b) && !IsDigit(b)) { return false; }
            }
        }
        return !atStart;
    }

    // 成员路径：点分的标识符（`customer.name`）。
    private static bool IsMemberPath(string s) {
        return IsDotSeparatedIdentifiers(s);
    }

    // 命名空间：点分的标识符。
    private static bool IsNamespace(string s) {
        return IsDotSeparatedIdentifiers(s);
    }

    private static bool IsIdentStart(int b) {
        if (b >= 65 && b <= 90) { return true; }
        if (b >= 97 && b <= 122) { return true; }
        if (b == 95) { return true; }
        return false;
    }

    private static bool IsDigit(int b) {
        return b >= 48 && b <= 57;
    }
}
