using System;
using System.Collections.Generic;

namespace System.Mapping;

// 映射结果对象：**不抛异常**的那条路。
//
// 为什么两条路都要：`Map` 失败就抛（调用方不想管错误时最省事），
// `TryMap` 返回结果对象（调用方想按错误码分支时用——比如"源是 null 就
// 跳过这一条，其余继续"）。
public class MappingResult<TTarget> {
    // 是否失败。
    public bool IsError;
    // 失败原因（成功时是 `MappingError.None`）。
    public MappingError Error;
    // 出问题的成员名（成功或不是成员级失败时是空串）。
    public string Member;
    // 人类可读的失败原因（成功时是空串）。
    public string Message;
    // 单条映射的结果（列表映射时不用它）。
    public TTarget Target;
    // 列表映射的结果（单条映射时是 null）。
    public List<TTarget> Targets;

    public MappingResult() {
        this.IsError = false;
        this.Error = MappingError.None;
        this.Member = "";
        this.Message = "";
        this.Targets = null;
    }
}
