namespace System.Mapping;

// 一条成员映射规则。
//
// **规则是"改完再交还"的函数**，不是"就地改"：`(源, 目标) → 新目标`。
// 这样类目标和**结构体目标**都对——结构体是值语义，就地改会改在副本上
// （改完丢掉），交还新值才是对的。
//
// `FuncT2` 而不是 `ActionT2`：交还新值这一半是值语义目标能用的关键。
public class MapRule<TSource, TTarget> {
    // 成员名（错误定位用：失败时异常里带它）。
    public string Name;
    // 应用函数：吃源与目标，交还新的目标。
    public FuncT2<TSource, TTarget, TTarget> Apply;

    public MapRule(string name, FuncT2<TSource, TTarget, TTarget> apply) {
        this.Name = name != null ? name : "";
        this.Apply = apply;
    }
}
