using System;

namespace System.Mapping;

// 映射失败的异常。
//
// **异常 + 错误码两个通道**：人看 `Message`（异常自带），程序看 `error`；
// `member` 指出是哪条成员规则出的问题（成员名 / 转换器名）。
public class MappingException : Exception {
    // 错误码。
    public MappingError error;
    // 出问题的成员名（没有则为空串）。
    public string member;

    public MappingException(MappingError error, string text) : base(text) {
        this.error = error;
        this.member = "";
    }

    // 带成员名的构造（成员规则失败时用）。
    public MappingException(MappingError error, string text, string member) : base(text) {
        this.error = error;
        this.member = member != null ? member : "";
    }

    // 带原始异常的构造（原异常在 `InnerException` 里）。
    public MappingException(MappingError error, string text, string member, Exception cause) : base(text, cause) {
        this.error = error;
        this.member = member != null ? member : "";
    }

    // 错误码的英文名（调试输出用；不依赖枚举的字符串格式化行为）。
    public string ErrorName() {
        if (this.error == MappingError.None) { return "None"; }
        if (this.error == MappingError.SourceNull) { return "SourceNull"; }
        if (this.error == MappingError.MemberFailed) { return "MemberFailed"; }
        if (this.error == MappingError.ConvertFailed) { return "ConvertFailed"; }
        if (this.error == MappingError.InvalidFactory) { return "InvalidFactory"; }
        if (this.error == MappingError.InvalidSourceList) { return "InvalidSourceList"; }
        if (this.error == MappingError.NoRules) { return "NoRules"; }
        if (this.error == MappingError.InvalidSpec) { return "InvalidSpec"; }
        return "Unknown";
    }
}
