using System;

namespace System.Mapping;

// **能力层**：可复用的值转换器（源字段类型与目标字段类型不同时用）。
//
// 映射里最常见的"类型对不上"有两类：格式不同（`int` ↔ `string`）和
// 语义不同（订单号 ↔ 带前缀的展示码）。转换器把这段逻辑收在一处，
// 多个映射规则共用。
//
// 转换失败**抛** `MappingException`（错误码 `ConvertFailed`，转换器名在
// `member` 里）；不想抛的用 `TryConvert`。
public class ValueConverter<TSource, TTarget> {
    // 转换器名（错误定位用）。
    public string Name;
    // 转换函数（失败时抛异常）。
    public FuncT<TSource, TTarget> Convert;

    public ValueConverter(string name, FuncT<TSource, TTarget> convert) {
        this.Name = name != null ? name : "";
        this.Convert = convert;
    }

    // 转换：失败抛 `MappingException`（错误码 `ConvertFailed`）。
    public TTarget Apply(TSource value) {
        if (this.Convert == null) {
            throw new MappingException(MappingError.ConvertFailed,
                "converter '" + this.Name + "' has no convert function", this.Name);
        }
        try {
            return this.Convert(value);
        } catch (Exception e) {
            throw new MappingException(MappingError.ConvertFailed,
                "converter '" + this.Name + "' failed: " + e.Message, this.Name, e);
        }
    }

    // 转换：不抛的版本（失败返回 false，结果是目标类型的默认值）。
    public bool TryConvert(TSource value, out TTarget result) {
        if (this.Convert == null) {
            result = null;
            return false;
        }
        try {
            result = this.Convert(value);
            return true;
        } catch (Exception e) {
            result = null;
            return false;
        }
    }
}
