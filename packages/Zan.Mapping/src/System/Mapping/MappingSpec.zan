using System;
using System.Collections.Generic;

namespace System.Mapping;

// 生成规格：一份"从哪种类型映到哪种类型、映哪些成员"的说明。
//
// `GenMapping` 按它生成**显式**的映射函数源码（不是运行期反射）。
public class MappingSpec {
    // 生成代码所在命名空间（空串 = 放在全局命名空间）。
    public string NamespaceName;
    // 生成的类名（空串 = 用「源类型名 + Mapper」）。
    public string ClassName;
    // 源类型名（生成代码里写的就是它）。
    public string SourceType;
    // 目标类型名。
    public string TargetType;
    // 是否附带生成列表映射（`MapList`）。
    public bool WithListMap;
    // 成员对：源成员路径（点分，可扁平化）→ 目标成员名。
    public List<MappingMember> Members;
    // 额外要 `using` 的命名空间。
    public List<string> Usings;

    public MappingSpec() {
        this.NamespaceName = "";
        this.ClassName = "";
        this.SourceType = "";
        this.TargetType = "";
        this.WithListMap = false;
        this.Members = new List<MappingMember>();
        this.Usings = new List<string>();
    }
}

// 一条成员对：源路径 → 目标成员名。
//
// `From` 支持点分路径（`customer.name` = 扁平化，取源对象的嵌套成员）。
public class MappingMember {
    // 源成员路径（点分）。
    public string From;
    // 目标成员名。
    public string To;

    public MappingMember(string from, string to) {
        this.From = from != null ? from : "";
        this.To = to != null ? to : "";
    }
}
