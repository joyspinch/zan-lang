namespace System.Mapping;

// 映射失败的原因（可区分的错误码）。
//
// **为什么要错误码**：映射失败有好几种——"源对象是 null"、"某条成员规则
// 抛了异常"、"值转换失败"、"工厂没给或给了 null"。合成一句话会让排查变慢：
// 前者该查调用方，后两者该查映射规则本身。
public enum MappingError {
    // 没有失败。
    None = 0,
    // 源对象为 null。
    SourceNull = 1,
    // 某条成员规则抛了异常（失败成员名在异常的 `member` 里）。
    MemberFailed = 2,
    // 值转换失败（转换器名在异常的 `member` 里）。
    ConvertFailed = 3,
    // 档案没给目标工厂，或工厂返回了 null。
    InvalidFactory = 4,
    // 源集合为 null。
    InvalidSourceList = 5,
    // 档案一条规则都没有（映射出来的是目标类型的默认值，不是"映过了"）。
    NoRules = 6,
    // 生成规格本身不合法（生成器用）。
    InvalidSpec = 7,
}
