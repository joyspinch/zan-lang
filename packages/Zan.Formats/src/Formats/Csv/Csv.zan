using System;
using System.Text;
using System.Collections.Generic;

namespace Formats.Csv;

// RFC 4180 CSV 字节级解析与写出（保留 UTF-8 多字节、自动剥除开头 UTF-8 BOM、允许字段内宽松引号 ab"cd）。
// 支持自定义分隔符（ParseSep/SerializeSep）与 CRLF/LF/CR 记录分隔；写出与解析严格互逆且不对 = + - @ 做公式中和（由调用方按场景处理）。
public class Csv {
    // 单条记录字段数上限（防畸形输入撑爆内存，公开可调）。
    public static int MaxFieldsPerRecord = 1000000;

    // 单次解析总记录数上限（不含表头，公开可调）。
    public static int MaxRecords = 1000000;

    // 记录收口：校验字段/记录数上限后，首条归 header、其余归 rows。
    public static void FinishRecord(CsvTable t, List<string> rec) {
        if (rec.Count > Csv.MaxFieldsPerRecord) {
            throw new ArgumentException("CSV record has too many fields ("
                + Convert.ToString(rec.Count) + " > "
                + Convert.ToString(Csv.MaxFieldsPerRecord) + ")");
        }
        if (t.header.Count == 0 && t.rows.Count == 0) {
            t.header = rec;
            return;
        }
        if (t.rows.Count >= Csv.MaxRecords) {
            throw new ArgumentException("CSV input has too many records ("
                + Convert.ToString(t.rows.Count + 1) + " > "
                + Convert.ToString(Csv.MaxRecords) + ")");
        }
        t.rows.Add(rec);
    }

    private static void FlushField(List<string> rec, StringBuilder sb, bool hasQuoted, string text, int start, int end) {
        if (hasQuoted) {
            rec.Add(sb.ToString());
            sb.Clear();
        } else {
            rec.Add(text.Substring(start, end - start));
        }
    }

    // 解析整段 CSV 文本为表（空文本返回零行表）。
    public static CsvTable Parse(string text) {
        return Csv.ParseSep(text, ",");
    }

    // 使用单字符自定义分隔符解析（空或引号/换行回退为逗号）。
    public static CsvTable ParseSep(string text, string separator) {
        CsvTable t = new CsvTable();
        if (text == null) { return t; }
        int sep = 44;
        if (separator != null && separator.Length > 0) {
            sep = separator[0] & 255;
            if (sep == 34 || sep == 13 || sep == 10) { sep = 44; }
        }
        int n = text.Length;
        nint tPtr = (nint)text;
        Span<byte> tbuf = new Span<byte>(tPtr, n);
        int i = 0;
        if (n >= 3 && (tbuf[0] & 255) == 239 && (tbuf[1] & 255) == 187
            && (tbuf[2] & 255) == 191) {
            i = 3;  // UTF-8 BOM
        }
        List<string> rec = new List<string>();
        int colHint = 0;
        StringBuilder sb = null;
        int fieldStart = i;
        bool hasQuoted = false;
        bool dirty = false;
        while (i < n) {
            int c = tbuf[i] & 255;
            if (c == 34) {  // '"'
                if (!hasQuoted) {
                    hasQuoted = true;
                    if (sb == null) { sb = new StringBuilder(); }
                    else { sb.Clear(); }
                    if (i > fieldStart) {
                        sb.Append(new StringView(tPtr + (nint)fieldStart, i - fieldStart));
                    }
                }
                if (sb.Length == 0) {
                    // 字段起始引号：读取到配对闭引号，"" 转义为 "。
                    dirty = true;
                    i = i + 1;
                    while (i < n) {
                        int q = tbuf[i] & 255;
                        if (q == 34) {
                            if (i + 1 < n && (tbuf[i + 1] & 255) == 34) {
                                sb.Append("\"");
                                i = i + 2;
                            } else {
                                i = i + 1;
                                break;
                            }
                        } else {
                            int start = i;
                            int hit = NativeMemory.Find(tPtr, start, 34, n - start);
                            i = hit < 0 ? n : hit;
                            sb.Append(new StringView(tPtr + (nint)start, i - start));
                        }
                    }
                } else {
                    sb.Append("\"");
                    i = i + 1;
                    dirty = true;
                }
                continue;
            }
            if (c == sep) {
                Csv.FlushField(rec, sb, hasQuoted, text, fieldStart, i);
                hasQuoted = false;
                dirty = true;
                i = i + 1;
                fieldStart = i;
                continue;
            }
            if (c == 13 || c == 10) {
                Csv.FlushField(rec, sb, hasQuoted, text, fieldStart, i);
                hasQuoted = false;
                if (c == 13 && i + 1 < n && (tbuf[i + 1] & 255) == 10) {
                    i = i + 2;
                } else {
                    i = i + 1;
                }
                fieldStart = i;
                if (rec.Count > colHint) { colHint = rec.Count; }
                Csv.FinishRecord(t, rec);
                rec = new List<string>();
                if (colHint > 0) { rec.Reserve(colHint); }
                dirty = false;
                continue;
            }
            int begin = i;
            while (i < n) {
                int d = tbuf[i] & 255;
                if (d == sep || d == 13 || d == 10 || d == 34) { break; }
                i = i + 1;
            }
            if (hasQuoted) {
                sb.Append(new StringView(tPtr + (nint)begin, i - begin));
            }
            dirty = true;
        }
        if (dirty) {
            Csv.FlushField(rec, sb, hasQuoted, text, fieldStart, n);
            Csv.FinishRecord(t, rec);
        }
        return t;
    }

    // 解析单行记录（返回首条记录；空行或 null 返回空列表）。
    public static List<string> ParseRow(string line) {
        if (line == null) { return new List<string>(); }
        CsvTable t = Csv.Parse(line);
        if (t.header.Count > 0) { return t.header; }
        if (t.rows.Count > 0) { return t.rows[0]; }
        return new List<string>();
    }

    // 写出单个字段（含逗号、引号或换行时加引号并翻倍内部引号）。
    public static string Escape(string field) {
        return Csv.EscapeSep(field, ",");
    }

    // 同 Escape，使用自定义分隔符判断是否加引号（多字符分隔符按子串匹配）。
    public static string EscapeSep(string field, string separator) {
        if (field == null) { return ""; }
        int flen = field.Length;
        int sepChar = (separator != null && separator.Length == 1) ? (separator[0] & 255) : -1;
        bool needQuote = false;
        if (sepChar >= 0) {
            for (int i = 0; i < flen; i = i + 1) {
                int c = field[i] & 255;
                if (c == sepChar || c == 34 || c == 10 || c == 13) {
                    needQuote = true;
                    break;
                }
            }
        } else {
            if (separator != null && field.IndexOf(separator, 0) >= 0) { needQuote = true; }
            else if (field.IndexOf("\"", 0) >= 0 || field.IndexOf("\n", 0) >= 0 || field.IndexOf("\r", 0) >= 0) { needQuote = true; }
        }
        if (!needQuote) { return field; }
        StringBuilder sb = new StringBuilder();
        sb.Append("\"");
        int last = 0;
        nint fp = (nint)field;
        while (last < flen) {
            int hit = NativeMemory.Find(fp, last, 34, flen - last);
            if (hit < 0) {
                sb.Append(new StringView(fp + (nint)last, flen - last));
                break;
            }
            if (hit > last) { sb.Append(new StringView(fp + (nint)last, hit - last)); }
            sb.Append("\"\"");
            last = hit + 1;
        }
        sb.Append("\"");
        return sb.ToString();
    }

    // 把一条记录写为一行（逗号分隔，不含行尾换行符）。
    public static string RowToText(List<string> fields) {
        return Csv.RowToTextSep(fields, ",");
    }

    // 直接将转义后字段追加到目标 StringBuilder（无须引号时零临时分配）。
    private static void AppendEscapedSep(StringBuilder sb, string field, string separator, int sepChar) {
        if (field == null || field.Length == 0) { return; }
        int flen = field.Length;
        nint fPtr = (nint)field;
        Span<byte> fbuf = new Span<byte>(fPtr, flen);
        bool needQuote = false;
        if (sepChar >= 0) {
            for (int i = 0; i < flen; i = i + 1) {
                int c = fbuf[i] & 255;
                if (c == sepChar || c == 34 || c == 10 || c == 13) {
                    needQuote = true;
                    break;
                }
            }
        } else {
            if (separator != null && field.IndexOf(separator, 0) >= 0) { needQuote = true; }
            else if (field.IndexOf("\"", 0) >= 0 || field.IndexOf("\n", 0) >= 0 || field.IndexOf("\r", 0) >= 0) { needQuote = true; }
        }
        if (!needQuote) {
            sb.Append(field);
            return;
        }
        sb.Append("\"");
        int last = 0;
        while (last < flen) {
            int hit = NativeMemory.Find(fPtr, last, 34, flen - last);
            if (hit < 0) {
                sb.Append(new StringView(fPtr + (nint)last, flen - last));
                break;
            }
            if (hit > last) { sb.Append(new StringView(fPtr + (nint)last, hit - last)); }
            sb.Append("\"\"");
            last = hit + 1;
        }
        sb.Append("\"");
    }

    // 把一条记录写为一行（自定义分隔符，不含行尾换行符）。
    public static string RowToTextSep(List<string> fields, string separator) {
        if (fields == null) { return ""; }
        string sep = separator != null ? separator : ",";
        int sepChar = sep.Length == 1 ? (sep[0] & 255) : -1;
        StringBuilder sb = new StringBuilder();
        int n = fields.Count;
        for (int i = 0; i < n; i = i + 1) {
            if (i > 0) { sb.Append(sep); }
            Csv.AppendEscapedSep(sb, fields[i], sep, sepChar);
        }
        return sb.ToString();
    }

    // 把行列表序列化为 CSV 文本（逗号分隔），每条记录
    // 以 '\n' 结尾。
    public static string Serialize(List<List<string>> rows) {
        return Csv.SerializeSep(rows, ",");
    }

    // 把行列表序列化为 CSV 文本（自定义分隔符），每条
    // 记录以 '\n' 结尾（共享单 StringBuilder 零逐行临时串）。
    public static string SerializeSep(List<List<string>> rows, string separator) {
        if (rows == null) { return ""; }
        int nr = rows.Count;
        string sep = separator != null ? separator : ",";
        int sepChar = sep.Length == 1 ? (sep[0] & 255) : -1;
        int initCap = nr > 2000000 ? 96000000 : (nr * 48 + 32);
        StringBuilder sb = new StringBuilder(initCap);
        for (int r = 0; r < nr; r = r + 1) {
            List<string> fields = rows[r];
            if (fields != null) {
                int nf = fields.Count;
                for (int i = 0; i < nf; i = i + 1) {
                    if (i > 0) { sb.Append(sep); }
                    Csv.AppendEscapedSep(sb, fields[i], sep, sepChar);
                }
            }
            sb.Append("\n");
        }
        return sb.ToString();
    }
}
