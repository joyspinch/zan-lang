using System;
using System.Json;

namespace Formats.MsgPack;

// MessagePack 解码原语：在 byte[] 上游走，ReadValue 按首字节分派
// 递归还原成 System.Json.JsonValue。bin 家族按 UTF-8 尽力解码成
// 字符串（非法序列收敛 U+FFFD）；timestamp extension（type -1）
// 还原成 ISO 8601 UTC 字符串；其他 extension 报错。深度限 512。
public class MsgPackReader {
    byte[] buf;
    nint bufPtr;
    int pos;
    int len;
    string[] keyCache;

    // 包装整段字节。
    public MsgPackReader(byte[] data) {
        if (data == null) { throw new MsgPackException("null input buffer"); }
        buf = data;
        bufPtr = (nint)data;
        pos = 0;
        len = data.Length;
        keyCache = new string[64];
    }

    // 包装切片 [offset, offset+count)。
    public MsgPackReader(byte[] data, int offset, int count) {
        if (data == null || offset < 0 || count < 0 || (long)offset + (long)count > (long)data.Length) {
            throw new MsgPackException("invalid slice range");
        }
        buf = data;
        bufPtr = (nint)data;
        pos = offset;
        len = offset + count;
        keyCache = new string[64];
    }

    public int U8() {
        if (pos >= len) {
            throw new MsgPackException("truncated at byte "
                + Convert.ToString(pos));
        }
        int b = buf[pos] & 255;
        pos = pos + 1;
        return b;
    }

    public int U16BE() {
        if (2 > len - pos) {
            throw new MsgPackException("truncated at byte " + Convert.ToString(pos));
        }
        int v = ((buf[pos] & 255) << 8) | (buf[pos + 1] & 255);
        pos = pos + 2;
        return v;
    }

    public long U32BE() {
        if (4 > len - pos) {
            throw new MsgPackException("truncated at byte " + Convert.ToString(pos));
        }
        long v = ((long)(buf[pos] & 255) << 24)
            | ((long)(buf[pos + 1] & 255) << 16)
            | ((long)(buf[pos + 2] & 255) << 8)
            | (long)(buf[pos + 3] & 255);
        pos = pos + 4;
        return v;
    }

    public long U64BE() {
        if (8 > len - pos) {
            throw new MsgPackException("truncated at byte " + Convert.ToString(pos));
        }
        long v = ((long)(buf[pos] & 255) << 56)
            | ((long)(buf[pos + 1] & 255) << 48)
            | ((long)(buf[pos + 2] & 255) << 40)
            | ((long)(buf[pos + 3] & 255) << 32)
            | ((long)(buf[pos + 4] & 255) << 24)
            | ((long)(buf[pos + 5] & 255) << 16)
            | ((long)(buf[pos + 6] & 255) << 8)
            | (long)(buf[pos + 7] & 255);
        pos = pos + 8;
        return v;
    }

    // 零临时 byte[]，直接从 buf 切片解码 UTF-8 字符串（纯 ASCII 跳过 UTF-8 校验直拷）。
    string TakeString(int n) {
        if (n < 0 || n > len - pos) {
            throw new MsgPackException("truncated at byte "
                + Convert.ToString(pos) + " (need " + Convert.ToString(n) + ")");
        }
        if (n == 0) { return ""; }
        int st = pos;
        Span<byte> s = new Span<byte>(bufPtr + (nint)st, n);
        int orBits = 0;
        for (int i = 0; i < n; i = i + 1) {
            orBits = orBits | (s[i] & 255);
        }
        pos = st + n;
        if ((orBits & 128) == 0) {
            return buf.ToStr(st, n);
        }
        return Encoding.GetString(buf, st, n);
    }

    // 64 槽直接映射 ASCII 键驻留缓存：命中时零堆分配返回已有 map 键。
    string InternMapKey(int n) {
        if (n < 0 || n > len - pos) {
            throw new MsgPackException("truncated at byte "
                + Convert.ToString(pos) + " (need " + Convert.ToString(n) + ")");
        }
        if (n == 0) { return ""; }
        if (n <= 32) {
            int st = pos;
            Span<byte> s = new Span<byte>(bufPtr + (nint)st, n);
            int h = -2128831035;
            int orBits = 0;
            for (int i = 0; i < n; i = i + 1) {
                int c = s[i] & 255;
                orBits = orBits | c;
                h = (h ^ c) * 16777619;
            }
            if ((orBits & 128) == 0) {
                pos = st + n;
                int slot = h & 63;
                string cached = keyCache[slot];
                if (cached != null && cached.Length == n) {
                    bool eq = true;
                    for (int i = 0; i < n; i = i + 1) {
                        if ((s[i] & 255) != (cached[i] & 255)) { eq = false; break; }
                    }
                    if (eq) { return cached; }
                }
                string fresh = buf.ToStr(st, n);
                keyCache[slot] = fresh;
                return fresh;
            }
        }
        string s2 = Encoding.GetString(buf, pos, n);
        pos = pos + n;
        return s2;
    }

    // 零 JsonValue 包装直读 map 键字符串（高频短 ASCII 键走 64 槽驻留缓存）。
    string ReadMapKey(int depth) {
        if (depth > 512) {
            throw new MsgPackException("nesting too deep at byte " + Convert.ToString(pos));
        }
        if (pos >= len) {
            throw new MsgPackException("truncated at byte " + Convert.ToString(pos));
        }
        int b = buf[pos] & 255;
        pos = pos + 1;
        if (b >= 160 && b <= 191) { return InternMapKey(b & 31); }
        if (b == 217) { return InternMapKey(U8()); }
        if (b == 218) { return InternMapKey(U16BE()); }
        if (b == 219) {
            long nL = U32BE();
            if (nL < 0 || nL > 536870912) {
                throw new MsgPackException("str length out of bounds at byte " + Convert.ToString(pos));
            }
            return InternMapKey((int)nL);
        }
        if (b >= 196 && b <= 198) {
            long nL = b == 196 ? (long)U8() : (b == 197 ? (long)U16BE() : U32BE());
            if (nL < 0 || nL > 536870912) {
                throw new MsgPackException("bin length out of bounds at byte " + Convert.ToString(pos));
            }
            return InternMapKey((int)nL);
        }
        throw new MsgPackException("map key is not a string at byte " + Convert.ToString(pos));
    }

    // 取 n 字节（越界抛）。n 用减法比较防 int 溢出绕过。
    byte[] Take(int n) {
        if (n < 0 || n > len - pos) {
            throw new MsgPackException("truncated at byte "
                + Convert.ToString(pos) + " (need " + Convert.ToString(n) + ")");
        }
        byte[] out2 = new byte[n];
        NativeMemory.Copy((nint)out2, (nint)buf + pos, n);
        pos = pos + n;
        return out2;
    }

    // 有符号 8 位（语言无 sbyte，手动符号扩展）。
    int S8() {
        int v = U8();
        if (v >= 128) { v = v - 256; }
        return v;
    }

    // 有符号 16 位。
    int S16() {
        int v = U16BE();
        if (v >= 32768) { v = v - 65536; }
        return v;
    }

    // 读一个完整值。depth 是递归深度（容器嵌套），上限
    // 512——恶意构造的深嵌套会栈溢出，两侧一起限。
    public JsonValue ReadValue(int depth) {
        if (depth > 512) {
            throw new MsgPackException("nesting too deep at byte "
                + Convert.ToString(pos));
        }
        if (pos >= len) {
            throw new MsgPackException("truncated at byte " + Convert.ToString(pos));
        }
        int b = buf[pos] & 255;
        pos = pos + 1;
        if (b < 128) { return JsonValue.NewInt(b); }  // 正 fixint
        if (b >= 224) { return JsonValue.NewInt(b - 256); }  // 负 fixint
        if (b >= 192) {
            switch (b) {
                case 205:  // uint16
                    if (2 > len - pos) { throw new MsgPackException("truncated at byte " + Convert.ToString(pos)); }
                    int u16 = ((buf[pos] & 255) << 8) | (buf[pos + 1] & 255);
                    pos = pos + 2;
                    return JsonValue.NewInt(u16);
                case 204:  // uint8
                    if (pos >= len) { throw new MsgPackException("truncated at byte " + Convert.ToString(pos)); }
                    int u8 = buf[pos] & 255;
                    pos = pos + 1;
                    return JsonValue.NewInt(u8);
                case 206:  // uint32
                    return JsonValue.NewInt(U32BE());
                case 203:  // float64
                    return JsonValue.NewDouble(BitsDouble(U64BE()));
                case 194:
                    return JsonValue.NewBool(false);
                case 195:
                    return JsonValue.NewBool(true);
                case 192:
                    return JsonValue.NewNull();
                case 208:  // int8
                    return JsonValue.NewInt(S8());
                case 209:  // int16
                    return JsonValue.NewInt(S16());
                case 210:  // int32
                    return JsonValue.NewInt((int)U32BE());
                case 211:  // int64
                    return JsonValue.NewInt(U64BE());
                case 207: {  // uint64
                    long v = U64BE();
                    if (v >= 0) { return JsonValue.NewInt(v); }
                    long hi = (v >> 1) & 9223372036854775807;
                    return JsonValue.NewDouble((double)hi * 2.0 + (double)(v & 1));
                }
                case 202:
                    return JsonValue.NewDouble(BitsSingle((int)U32BE()));
                case 217:
                    return JsonValue.NewStr(TakeString(U8()));
                case 218:
                    return JsonValue.NewStr(TakeString(U16BE()));
                case 219: {
                    long nL = U32BE();
                    if (nL < 0 || nL > 536870912) {
                        throw new MsgPackException("str length out of bounds at byte " + Convert.ToString(pos));
                    }
                    return JsonValue.NewStr(TakeString((int)nL));
                }
                case 220:
                    return ArrayOf(U16BE(), depth);
                case 221: {
                    long nL = U32BE();
                    if (nL < 0 || nL > 1000000) {
                        throw new MsgPackException("array length out of bounds: " + Convert.ToString(nL));
                    }
                    return ArrayOf((int)nL, depth);
                }
                case 222:
                    return MapOf(U16BE(), depth);
                case 223: {
                    long nL = U32BE();
                    if (nL < 0 || nL > 1000000) {
                        throw new MsgPackException("map size out of bounds: " + Convert.ToString(nL));
                    }
                    return MapOf((int)nL, depth);
                }
                case 193:
                    throw new MsgPackException("reserved code 0xC1 at byte " + Convert.ToString(pos - 1));
                case 196:
                case 197:
                case 198: {
                    long nL = b == 196 ? (long)U8() : (b == 197 ? (long)U16BE() : U32BE());
                    if (nL < 0 || nL > 536870912) {
                        throw new MsgPackException("bin length out of bounds at byte " + Convert.ToString(pos));
                    }
                    return JsonValue.NewStr(TakeString((int)nL));
                }
                case 199:
                case 200:
                case 201: {
                    long nL = b == 199 ? (long)U8() : (b == 200 ? (long)U16BE() : U32BE());
                    if (nL < 0 || nL > 536870912) {
                        throw new MsgPackException("ext length out of bounds at byte " + Convert.ToString(pos));
                    }
                    int type = S8();
                    return ExtValueSlice(type, (int)nL);
                }
                case 212:
                case 213:
                case 214:
                case 215:
                case 216: {
                    int n = 1 << (b - 212);
                    int type = S8();
                    return ExtValueSlice(type, n);
                }
                default:
                    throw new MsgPackException("unknown code 0x"
                        + Convert.ToString((b >> 4) < 10 ? 48 + (b >> 4) : 87 + (b >> 4))
                        + Convert.ToString((b & 15) < 10 ? 48 + (b & 15) : 87 + (b & 15))
                        + " at byte " + Convert.ToString(pos - 1));
            }
        }
        if (b >= 160) {  // fixstr (160..191)
            return JsonValue.NewStr(TakeString(b & 31));
        }
        if (b >= 144) {  // fixarray (144..159)
            int n = b & 15;
            JsonValue arr = JsonValue.NewArray();
            if (n > 0) {
                if (depth + 1 > 512) {
                    throw new MsgPackException("nesting too deep at byte " + Convert.ToString(pos));
                }
                List<JsonValue> items = arr.items;
                items.Reserve(n);
                for (int i = 0; i < n; i = i + 1) {
                    if (pos < len) {
                        int eb = buf[pos] & 255;
                        if (eb < 128) {
                            pos = pos + 1;
                            items.Add(JsonValue.NewInt(eb));
                            continue;
                        }
                        if (eb == 205 && pos + 2 < len) {
                            int u16 = ((buf[pos + 1] & 255) << 8) | (buf[pos + 2] & 255);
                            pos = pos + 3;
                            items.Add(JsonValue.NewInt(u16));
                            continue;
                        }
                        if (eb == 204 && pos + 1 < len) {
                            int u8 = buf[pos + 1] & 255;
                            pos = pos + 2;
                            items.Add(JsonValue.NewInt(u8));
                            continue;
                        }
                        if (eb >= 224) {
                            pos = pos + 1;
                            items.Add(JsonValue.NewInt(eb - 256));
                            continue;
                        }
                    }
                    items.Add(ReadValue(depth + 1));
                }
            }
            return arr;
        }
        // fixmap (128..143)
        int mn = b & 15;
        JsonValue obj = JsonValue.NewObject();
        if (mn > 0) {
            List<string> ks = obj.keys;
            List<JsonValue> vs = obj.vals;
            ks.Reserve(mn);
            vs.Reserve(mn);
            for (int i = 0; i < mn; i = i + 1) {
                string key = ReadMapKey(depth + 1);
                ks.Add(key);
                vs.Add(ReadValue(depth + 1));
            }
        }
        return obj;
    }

    JsonValue ArrayOf(int n, int depth) {
        if (n < 0 || n > 1000000) {
            throw new MsgPackException("array length out of bounds: " + Convert.ToString(n));
        }
        JsonValue arr = JsonValue.NewArray();
        List<JsonValue> items = arr.items;
        if (n > 0 && n <= 4096) { items.Reserve(n); }
        int i = 0;
        while (i < n) {
            items.Add(ReadValue(depth + 1));
            i = i + 1;
        }
        return arr;
    }

    JsonValue MapOf(int n, int depth) {
        if (n < 0 || n > 1000000) {
            throw new MsgPackException("map size out of bounds: " + Convert.ToString(n));
        }
        JsonValue obj = JsonValue.NewObject();
        List<string> ks = obj.keys;
        List<JsonValue> vs = obj.vals;
        if (n > 0 && n <= 4096) { ks.Reserve(n); vs.Reserve(n); }
        int i = 0;
        while (i < n) {
            string key = ReadMapKey(depth + 1);
            ks.Add(key);
            vs.Add(ReadValue(depth + 1));
            i = i + 1;
        }
        return obj;
    }

    // extension 零拷贝切片直读：消除 timestamp ext 每次 4/8/12 字节临时数组分配。
    JsonValue ExtValueSlice(int type, int n) {
        if (n < 0 || n > len - pos) {
            throw new MsgPackException("truncated at byte "
                + Convert.ToString(pos) + " (need " + Convert.ToString(n) + ")");
        }
        int at = pos;
        pos = pos + n;
        if (type != -1) {
            throw new MsgPackException("unsupported ext type "
                + Convert.ToString(type) + " at byte "
                + Convert.ToString(pos));
        }
        if (n == 4) {
            long sec = U32Of(buf, at);
            return JsonValue.NewStr(IsoFromUnix(sec));
        }
        if (n == 8) {
            long v = U64Of(buf, at);
            long nanos = (v >> 34) & 1073741823;  // 高 30 位
            long sec = v & 17179869183;  // 低 34 位（2^34-1）
            return JsonValue.NewStr(IsoFromUnixNanos(sec, nanos));
        }
        if (n == 12) {
            long nanos = U32Of(buf, at);
            long sec = U64Of(buf, at + 4);
            return JsonValue.NewStr(IsoFromUnixNanos(sec, nanos));
        }
        throw new MsgPackException("timestamp ext must be 4/8/12 bytes, got "
            + Convert.ToString(n));
    }

    // extension 主体：只认 timestamp（type -1），其余报错。
    JsonValue ExtValue(int type, byte[] body) {
        if (type != -1) {
            throw new MsgPackException("unsupported ext type "
                + Convert.ToString(type) + " at byte "
                + Convert.ToString(pos));
        }
        if (body.Length == 4) {
            long sec = U32Of(body, 0);
            return JsonValue.NewStr(IsoFromUnix(sec));
        }
        if (body.Length == 8) {
            long v = U64Of(body, 0);
            long nanos = (v >> 34) & 1073741823;  // 高 30 位
            long sec = v & 17179869183;  // 低 34 位（2^34-1）
            return JsonValue.NewStr(IsoFromUnixNanos(sec, nanos));
        }
        if (body.Length == 12) {
            long nanos = U32Of(body, 0);
            long sec = U64Of(body, 4);
            return JsonValue.NewStr(IsoFromUnixNanos(sec, nanos));
        }
        throw new MsgPackException("timestamp ext must be 4/8/12 bytes, got "
            + Convert.ToString(body.Length));
    }

    long U32Of(byte[] b, int at) {
        return ((long)(b[at] & 255) << 24) | ((long)(b[at + 1] & 255) << 16)
            | ((long)(b[at + 2] & 255) << 8) | (long)(b[at + 3] & 255);
    }

    long U64Of(byte[] b, int at) {
        return ((long)(b[at] & 255) << 56)
            | ((long)(b[at + 1] & 255) << 48)
            | ((long)(b[at + 2] & 255) << 40)
            | ((long)(b[at + 3] & 255) << 32)
            | ((long)(b[at + 4] & 255) << 24)
            | ((long)(b[at + 5] & 255) << 16)
            | ((long)(b[at + 6] & 255) << 8)
            | (long)(b[at + 7] & 255);
    }

    // Unix 秒 → ISO 8601 UTC（"YYYY-MM-DDTHH:MM:SSZ"）。
    private static string IsoFromUnix(long sec) {
        return IsoFromUnixNanos(sec, 0);
    }

    // 带纳秒：非整毫秒截断到毫秒三位（定长缓冲零中间串直写）。
    public static string IsoFromUnixNanos(long sec, long nanos) {
        DateTime t = DateTime.FromUnixSeconds(sec);
        int year = t.Year();
        int month = t.Month();
        int day = t.Day();
        int hour = t.Hour();
        int minute = t.Minute();
        int second = t.Second();
        long ms = nanos / 1000000;
        if (year >= 0 && year < 10000 && ms >= 0 && ms < 1000) {
            int total = ms > 0 ? 24 : 20;
            byte[] outb = new byte[total];
            outb[0] = (byte)(48 + (year / 1000) % 10);
            outb[1] = (byte)(48 + (year / 100) % 10);
            outb[2] = (byte)(48 + (year / 10) % 10);
            outb[3] = (byte)(48 + year % 10);
            outb[4] = 45;
            outb[5] = (byte)(48 + month / 10);
            outb[6] = (byte)(48 + month % 10);
            outb[7] = 45;
            outb[8] = (byte)(48 + day / 10);
            outb[9] = (byte)(48 + day % 10);
            outb[10] = 84;
            outb[11] = (byte)(48 + hour / 10);
            outb[12] = (byte)(48 + hour % 10);
            outb[13] = 58;
            outb[14] = (byte)(48 + minute / 10);
            outb[15] = (byte)(48 + minute % 10);
            outb[16] = 58;
            outb[17] = (byte)(48 + second / 10);
            outb[18] = (byte)(48 + second % 10);
            if (ms > 0) {
                int r = (int)ms;
                outb[19] = 46;
                outb[20] = (byte)(48 + r / 100);
                outb[21] = (byte)(48 + (r / 10) % 10);
                outb[22] = (byte)(48 + r % 10);
                outb[23] = 90;
            } else {
                outb[19] = 90;
            }
            return outb.ToStr(0, total);
        }
        StringBuilder sb = new StringBuilder();
        sb.Append(Pad4(year));
        sb.Append("-");
        sb.Append(Pad2(month));
        sb.Append("-");
        sb.Append(Pad2(day));
        sb.Append("T");
        sb.Append(Pad2(hour));
        sb.Append(":");
        sb.Append(Pad2(minute));
        sb.Append(":");
        sb.Append(Pad2(second));
        if (ms > 0) {
            sb.Append(".");
            if (ms < 100) { sb.Append("0"); }
            if (ms < 10) { sb.Append("0"); }
            sb.Append(Convert.ToString(ms));
        }
        sb.Append("Z");
        return sb.ToString();
    }

    private static string Pad2(int v) {
        if (v >= 0 && v < 100) {
            byte[] buf = new byte[2];
            buf[0] = (byte)(48 + v / 10);
            buf[1] = (byte)(48 + v % 10);
            return buf.ToStr(0, 2);
        }
        return Convert.ToString(v);
    }

    private static string Pad4(int v) {
        if (v >= 0 && v < 10000) {
            byte[] buf = new byte[4];
            buf[0] = (byte)(48 + (v / 1000) % 10);
            buf[1] = (byte)(48 + (v / 100) % 10);
            buf[2] = (byte)(48 + (v / 10) % 10);
            buf[3] = (byte)(48 + v % 10);
            return buf.ToStr(0, 4);
        }
        return Convert.ToString(v);
    }

    // 由 IEEE-754 位型还原 double：编译器内建 bitcast
    // （NativeMemory.AsF64，零开销、逐位精确——次正规/±∞/NaN/-0.0
    // 原位还原）。取代旧逐位累加。float32 家族走 BitsSingle。
    private static double BitsDouble(long bits) {
        return NativeMemory.AsF64(bits);
    }

    // 由 32 位 IEEE-754 位型还原 double（编译器内建 bitcast，单指令精确还原）。
    private static double BitsSingle(int bits) {
        return (double)NativeMemory.AsF32(bits);
    }

    // 字节 → 字符串（UTF-8 尽力，非法序列 U+FFFD；长度显式，
    // 内嵌 NUL 保留）。
    private static string DecodedText(byte[] b) {
        return Encoding.GetString(b, 0, b.Length);
    }
}
