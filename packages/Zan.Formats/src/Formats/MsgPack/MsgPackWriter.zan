using System;
using System.Text;

namespace Formats.MsgPack;

// MessagePack 编码原语：往可增长的 byte[] 里写 nil/bool/整数
// （fixint 到 int64 的规范最短形态）/float64/str/bin/数组头/映射头。
// 字节缓冲倍增扩容整块 NativeMemory.Copy 搬移（与 ByteBuffer 同形）。
// 数值都用大端（MessagePack 规范）。
public class MsgPackWriter {
    // 写侧总量上限：对齐读侧（MsgPackReader 拒绝 >512MB 的载荷），
    // 超限抛 MsgPackException。容量算术全程 64 位——旧的 int 算术在
    // len+extra ≥ 2^31 时首判据回绕误判"有空间"直接写穿，倍增循环
    // 在 >1GB 时同样回绕成死循环。MessagePack 格式没有 str/bin
    // 分片形态（str/bin 均为定长），此上限即终态；大载荷须在应用层
    // 拆分（CBOR 侧的 indefinite 分片见 CborWriter.Chunked）。
    public static long MaxTotalBytes = 536870912;

    byte[] buf;
    int len;

    public MsgPackWriter() {
        buf = new byte[256];
        len = 0;
    }

    // 已编码字节数。
    public int Length() { return len; }

    void EnsureRoom(int extra) {
        if (extra < 0) {
            throw new MsgPackException("invalid write size: " + Convert.ToString(extra));
        }
        long need = (long)len + (long)extra;
        if (need > MsgPackWriter.MaxTotalBytes) {
            throw new MsgPackException("encoded size "
                + Convert.ToString(need) + " exceeds 512MB write limit");
        }
        if (need <= buf.Length) { return; }
        long c = (long)buf.Length * 2;
        if (c < 16) { c = 16; }
        while (c < need) { c = c * 2; }
        byte[] grown = new byte[(int)c];
        NativeMemory.Copy((nint)grown, (nint)buf, len);
        buf = grown;
    }

    // 追加 1 字节。
    public void RawU8(int b) {
        EnsureRoom(1);
        buf[len] = (byte)b;
        len = len + 1;
    }

    public void RawU16BE(int v) {
        EnsureRoom(2);
        buf[len] = (byte)(v >> 8);
        buf[len + 1] = (byte)v;
        len = len + 2;
    }

    public void RawU32BE(long v) {
        EnsureRoom(4);
        buf[len] = (byte)(v >> 24);
        buf[len + 1] = (byte)(v >> 16);
        buf[len + 2] = (byte)(v >> 8);
        buf[len + 3] = (byte)v;
        len = len + 4;
    }

    public void RawU64BE(long v) {
        EnsureRoom(8);
        buf[len] = (byte)(v >> 56);
        buf[len + 1] = (byte)(v >> 48);
        buf[len + 2] = (byte)(v >> 40);
        buf[len + 3] = (byte)(v >> 32);
        buf[len + 4] = (byte)(v >> 24);
        buf[len + 5] = (byte)(v >> 16);
        buf[len + 6] = (byte)(v >> 8);
        buf[len + 7] = (byte)v;
        len = len + 8;
    }

    // nil（0xC0）。
    public void WriteNil() { RawU8(192); }

    // bool（0xC2/0xC3）。
    public void WriteBool(bool b) { RawU8(b ? 195 : 194); }

    // 整数的规范最短形态：0..127 正 fixint、-32..-1 负
    // fixint（都单字节），向上依次 uint8/16/32/64（正）与
    // int8/16/32/64（负）。合并单次 EnsureRoom 直写。
    public void WriteInt(long v) {
        if (v >= 0) {
            if (v < 128) {
                EnsureRoom(1);
                buf[len] = (byte)v;
                len = len + 1;
            } else if (v < 256) {
                EnsureRoom(2);
                int p = len;
                buf[p] = 204;
                buf[p + 1] = (byte)v;
                len = p + 2;
            } else if (v < 65536) {
                EnsureRoom(3);
                int p = len;
                buf[p] = 205;
                buf[p + 1] = (byte)(v >> 8);
                buf[p + 2] = (byte)v;
                len = p + 3;
            } else if (v < 4294967296) {
                EnsureRoom(5);
                int p = len;
                buf[p] = 206;
                buf[p + 1] = (byte)(v >> 24);
                buf[p + 2] = (byte)(v >> 16);
                buf[p + 3] = (byte)(v >> 8);
                buf[p + 4] = (byte)v;
                len = p + 5;
            } else {
                EnsureRoom(9);
                int p = len;
                buf[p] = 207;
                buf[p + 1] = (byte)(v >> 56);
                buf[p + 2] = (byte)(v >> 48);
                buf[p + 3] = (byte)(v >> 40);
                buf[p + 4] = (byte)(v >> 32);
                buf[p + 5] = (byte)(v >> 24);
                buf[p + 6] = (byte)(v >> 16);
                buf[p + 7] = (byte)(v >> 8);
                buf[p + 8] = (byte)v;
                len = p + 9;
            }
        } else {
            if (v >= -32) {
                EnsureRoom(1);
                buf[len] = (byte)(v + 256);
                len = len + 1;
            } else if (v >= -128) {
                EnsureRoom(2);
                int p = len;
                buf[p] = 208;
                buf[p + 1] = (byte)(v + 256);
                len = p + 2;
            } else if (v >= -32768) {
                EnsureRoom(3);
                int p = len;
                long u = v + 65536;
                buf[p] = 209;
                buf[p + 1] = (byte)(u >> 8);
                buf[p + 2] = (byte)u;
                len = p + 3;
            } else if (v >= -2147483648) {
                EnsureRoom(5);
                int p = len;
                long u = v + 4294967296;
                buf[p] = 210;
                buf[p + 1] = (byte)(u >> 24);
                buf[p + 2] = (byte)(u >> 16);
                buf[p + 3] = (byte)(u >> 8);
                buf[p + 4] = (byte)u;
                len = p + 5;
            } else {
                EnsureRoom(9);
                int p = len;
                buf[p] = 211;
                buf[p + 1] = (byte)(v >> 56);
                buf[p + 2] = (byte)(v >> 48);
                buf[p + 3] = (byte)(v >> 40);
                buf[p + 4] = (byte)(v >> 32);
                buf[p + 5] = (byte)(v >> 24);
                buf[p + 6] = (byte)(v >> 16);
                buf[p + 7] = (byte)(v >> 8);
                buf[p + 8] = (byte)v;
                len = p + 9;
            }
        }
    }

    // float64（0xCB + 8 字节大端 IEEE-754）。
    public void WriteDouble(double d) {
        EnsureRoom(9);
        long bits = NativeMemory.AsI64(d);
        int p = len;
        buf[p] = 203;
        buf[p + 1] = (byte)(bits >> 56);
        buf[p + 2] = (byte)(bits >> 48);
        buf[p + 3] = (byte)(bits >> 40);
        buf[p + 4] = (byte)(bits >> 32);
        buf[p + 5] = (byte)(bits >> 24);
        buf[p + 6] = (byte)(bits >> 16);
        buf[p + 7] = (byte)(bits >> 8);
        buf[p + 8] = (byte)bits;
        len = p + 9;
    }

    // string：零临时 byte[]，直接按 str 家族（fixstr/str8/16/32）写 UTF-8 字节。
    public void WriteString(string s) {
        int n = s.Length;
        if (n > MsgPackWriter.MaxTotalBytes - 5) {
            throw new MsgPackException("string length exceeds 512MB write limit");
        }
        if (n <= 31) {
            EnsureRoom(1 + n);
            buf[len] = (byte)(160 | n);
            len = len + 1;
        } else if (n <= 255) {
            EnsureRoom(2 + n);
            buf[len] = 217;
            buf[len + 1] = (byte)n;
            len = len + 2;
        } else if (n <= 65535) {
            EnsureRoom(3 + n);
            buf[len] = 218;
            buf[len + 1] = (byte)(n >> 8);
            buf[len + 2] = (byte)n;
            len = len + 3;
        } else {
            EnsureRoom(5 + n);
            buf[len] = 219;
            buf[len + 1] = (byte)(n >> 24);
            buf[len + 2] = (byte)(n >> 16);
            buf[len + 3] = (byte)(n >> 8);
            buf[len + 4] = (byte)n;
            len = len + 5;
        }
        if (n > 0) {
            NativeMemory.PutString((nint)buf, len, s, n);
            len = len + n;
        }
    }

    // str 家族主体（已编码 UTF-8 字节）。
    public void WriteStrBytes(byte[] b) {
        int n = b.Length;
        if (n <= 31) { RawU8(160 | n); }
        else if (n <= 255) { RawU8(217); RawU8(n); }
        else if (n <= 65535) { RawU8(218); RawU16BE(n); }
        else { RawU8(219); RawU32BE(n); }
        EnsureRoom(n);
        NativeMemory.Copy((nint)buf + len, (nint)b, n);
        len = len + n;
    }

    // bin 家族（bin8/16/32），任意二进制字节。
    public void WriteBin(byte[] b) {
        int n = b.Length;
        if (n <= 255) { RawU8(196); RawU8(n); }
        else if (n <= 65535) { RawU8(197); RawU16BE(n); }
        else { RawU8(198); RawU32BE(n); }
        EnsureRoom(n);
        NativeMemory.Copy((nint)buf + len, (nint)b, n);
        len = len + n;
    }

    // 数组头：n ≤ 15 用 fixarray，否则 array16/32。
    public void WriteArrayHeader(int n) {
        if (n <= 15) {
            EnsureRoom(1);
            buf[len] = (byte)(144 | n);
            len = len + 1;
        } else if (n <= 65535) {
            EnsureRoom(3);
            int p = len;
            buf[p] = 220;
            buf[p + 1] = (byte)(n >> 8);
            buf[p + 2] = (byte)n;
            len = p + 3;
        } else {
            EnsureRoom(5);
            int p = len;
            buf[p] = 221;
            buf[p + 1] = (byte)(n >> 24);
            buf[p + 2] = (byte)(n >> 16);
            buf[p + 3] = (byte)(n >> 8);
            buf[p + 4] = (byte)n;
            len = p + 5;
        }
    }

    // 映射头：n ≤ 15 用 fixmap，否则 map16/32。
    public void WriteMapHeader(int n) {
        if (n <= 15) {
            EnsureRoom(1);
            buf[len] = (byte)(128 | n);
            len = len + 1;
        } else if (n <= 65535) {
            EnsureRoom(3);
            int p = len;
            buf[p] = 222;
            buf[p + 1] = (byte)(n >> 8);
            buf[p + 2] = (byte)n;
            len = p + 3;
        } else {
            EnsureRoom(5);
            int p = len;
            buf[p] = 223;
            buf[p + 1] = (byte)(n >> 24);
            buf[p + 2] = (byte)(n >> 16);
            buf[p + 3] = (byte)(n >> 8);
            buf[p + 4] = (byte)n;
            len = p + 5;
        }
    }

    // 取出已编码字节（复制一份）。
    public byte[] ToBytes() {
        byte[] out2 = new byte[len];
        NativeMemory.Copy((nint)out2, (nint)buf, len);
        return out2;
    }

    // double 的 IEEE-754 位模式：编译器内建 bitcast
    // （NativeMemory.AsI64，零开销、逐位精确——含次正规；NaN 归一为
    // quiet 位型）。取代旧手工归一化（截断丢 1 ULP、次正规指数域
    // 变负）。float32 走 BitsSingle，不在此列。
    public static long DoubleBits(double v) {
        return NativeMemory.AsI64(v);
    }
}
