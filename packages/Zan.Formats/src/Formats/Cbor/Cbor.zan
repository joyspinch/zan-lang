using System;
using System.IO;
using System.Json;

namespace Formats.Cbor;

// CBOR 门面：JsonValue ↔ 线上字节的 schemaless 互转（RFC 8949）。
// 写侧全部确定长度、argument 规范最短、浮点固定 64 位；读侧全
// 形态（indefinite 分片、tag、半精度浮点）。null ↔ 0xF6；byte
// string 读侧按 UTF-8 尽力解码；tag 1（纪元秒）→ ISO 8601 字符串，
// 其余 tag 剥掉取内层。深度上限 512。
public class Cbor {
    // 把值树编码成 CBOR 字节（null 视为 0xF6）。
    public static byte[] Encode(JsonValue v) {
        CborWriter w = new CborWriter();
        EncodeValue(w, v, 0);
        return w.ToBytes();
    }

    // 解码整段 CBOR 字节（非法即抛 CborException）。
    public static JsonValue Decode(byte[] data) {
        CborReader r = new CborReader(data);
        return r.ReadValue(0);
    }

    // 解码切片 [offset, offset+count)。
    public static JsonValue Decode(byte[] data, int offset, int count) {
        CborReader r = new CborReader(data, offset, count);
        return r.ReadValue(0);
    }

    // 从文件读入并解码。
    public static JsonValue Load(string path) {
        return Cbor.Decode(File.ReadAllBytes(path));
    }

    // 编码并写入文件。
    public static void Save(JsonValue v, string path) {
        File.WriteAllBytes(path, Cbor.Encode(v));
    }

    public static void EncodeValue(CborWriter w, JsonValue v, int depth) {
        if (depth > 512) {
            throw new CborException("nesting too deep while encoding");
        }
        if (v == null) { w.WriteNull(); return; }
        int k = v.kind;
        if (k == 0) { w.WriteNull(); return; }
        if (k == 1) { w.WriteBool(v.boolVal); return; }
        if (k == 2) {
            if (v.numRaw == null || v.numRaw.Length == 0) {
                if (v.numIsInt) {
                    long n = v.numI;
                    if (n >= 0) { w.WriteUint(n); } else { w.WriteNeg(n); }
                } else {
                    w.WriteDouble(v.numD);
                }
            } else if (v.IsInt()) {
                long n = v.AsLong(0);
                if (n >= 0) { w.WriteUint(n); } else { w.WriteNeg(n); }
            } else {
                w.WriteDouble(v.AsDouble(0));
            }
            return;
        }
        if (k == 3) {
            string sv = v.strVal;
            w.WriteString(sv != null ? sv : "");
            return;
        }
        if (k == 4) {
            if (v.numArr != null) {
                double[] na = v.numArr;
                int n = na.Length;
                w.WriteArrayHeader(n);
                for (int i = 0; i < n; i = i + 1) {
                    w.WriteDouble(na[i]);
                }
            } else if (v.items != null) {
                List<JsonValue> items = v.items;
                int n = items.Count;
                w.WriteArrayHeader(n);
                for (int i = 0; i < n; i = i + 1) {
                    EncodeValue(w, items[i], depth + 1);
                }
            } else {
                w.WriteArrayHeader(0);
            }
            return;
        }
        if (k == 5) {
            List<string> ks = v.keys;
            List<JsonValue> vs = v.vals;
            int n = ks != null ? ks.Count : 0;
            w.WriteMapHeader(n);
            for (int i = 0; i < n; i = i + 1) {
                w.WriteString(ks[i]);
                EncodeValue(w, vs[i], depth + 1);
            }
            return;
        }
        throw new CborException("unsupported value kind while encoding");
    }
}
