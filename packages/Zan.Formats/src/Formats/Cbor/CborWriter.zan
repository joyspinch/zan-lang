using System;
using System.Buffers.Binary;
using System.Text;

namespace Formats.Cbor;

// CBOR 编码原语（RFC 8949）：常规项确定长度（definite）编码，argument
// 走规范最短形态（additional info 0-23 直接、24-27 定宽）。负整数按
// major type 1（值 = -1 - n，n = ~v 免溢出）。字节缓冲倍增扩容整块
// NativeMemory.Copy 搬移，数值大端。超过 ChunkBytes 的 text/byte 串
// 写成 indefinite 分片（0x7F/0x5F + 定长块 + 0xFF）——读侧
// TakeChunks 原生支持，且对有更小单-item 限的对端更友好；阈值以下
// 保持 definite，输出与历史逐字节一致。
public class CborWriter {
    // 写侧总量上限：对齐读侧 512MB 载荷上限，超限抛 CborException。
    // 容量算术全程 64 位——旧的 int 算术在 len+extra ≥ 2^31 时首判据
    // 回绕误判"有空间"直接写穿，倍增循环在 >1GB 时同样回绕成死循环。
    // 分片不改此限（缓冲仍整体驻内存），它解决的是形态正确性。
    public static long MaxTotalBytes = 536870912;

    // text/byte 串分片阈值：超过即写 indefinite 分片，每块 ≤ 此值。
    // 64MB 在 512MB 单-item 限内留足余量，块头开销可忽略。
    public static long ChunkBytes = 67108864;

    public byte[] buf;
    public int len;

    public CborWriter() {
        buf = new byte[256];
        len = 0;
    }

    // 已编码字节数。
    public int Length() { return len; }

    public void EnsureRoom(int extra) {
        if (extra < 0) {
            throw new CborException("negative buffer growth request");
        }
        long need = (long)len + (long)extra;
        if (need > CborWriter.MaxTotalBytes) {
            throw new CborException("encoded size "
                + Convert.ToString(need) + " exceeds 512MB write limit");
        }
        if (need <= buf.Length) { return; }
        long c = (long)buf.Length * 2;
        if (c < 16) { c = 16; }
        while (c < need) { c = c * 2; }
        byte[] grown = new byte[(int)c];
        NativeMemory.Copy((nint)grown, (nint)buf, len);
        buf = grown;
    }

    public void RawU8(int b) {
        EnsureRoom(1);
        buf[len] = (byte)b;
        len = len + 1;
    }

    public void RawU16BE(int v) {
        EnsureRoom(2);
        int p = len;
        buf[p] = (byte)(v >> 8);
        buf[p + 1] = (byte)v;
        len = p + 2;
    }

    public void RawU32BE(long v) {
        EnsureRoom(4);
        int p = len;
        buf[p] = (byte)(v >> 24);
        buf[p + 1] = (byte)(v >> 16);
        buf[p + 2] = (byte)(v >> 8);
        buf[p + 3] = (byte)v;
        len = p + 4;
    }

    public void RawU64BE(long v) {
        EnsureRoom(8);
        int p = len;
        buf[p] = (byte)(v >> 56);
        buf[p + 1] = (byte)(v >> 48);
        buf[p + 2] = (byte)(v >> 40);
        buf[p + 3] = (byte)(v >> 32);
        buf[p + 4] = (byte)(v >> 24);
        buf[p + 5] = (byte)(v >> 16);
        buf[p + 6] = (byte)(v >> 8);
        buf[p + 7] = (byte)v;
        len = p + 8;
    }

    // 写 major type 头 + argument（规范最短：≤23 内联，24/25/26/27
    // 定宽；明确不产 indefinite）。
    public void Head(int major, long arg) {
        int m = major << 5;
        if (arg >= 0 && arg < 24) {
            EnsureRoom(1);
            buf[len] = (byte)(m | (int)arg);
            len = len + 1;
        } else if (arg >= 0 && arg < 256) {
            EnsureRoom(2);
            int p = len;
            buf[p] = (byte)(m | 24);
            buf[p + 1] = (byte)arg;
            len = p + 2;
        } else if (arg >= 0 && arg < 65536) {
            EnsureRoom(3);
            int p = len;
            buf[p] = (byte)(m | 25);
            buf[p + 1] = (byte)(arg >> 8);
            buf[p + 2] = (byte)arg;
            len = p + 3;
        } else if (arg >= 0 && arg < 4294967296) {
            EnsureRoom(5);
            int p = len;
            buf[p] = (byte)(m | 26);
            buf[p + 1] = (byte)(arg >> 24);
            buf[p + 2] = (byte)(arg >> 16);
            buf[p + 3] = (byte)(arg >> 8);
            buf[p + 4] = (byte)arg;
            len = p + 5;
        } else {
            EnsureRoom(9);
            int p = len;
            buf[p] = (byte)(m | 27);
            buf[p + 1] = (byte)(arg >> 56);
            buf[p + 2] = (byte)(arg >> 48);
            buf[p + 3] = (byte)(arg >> 40);
            buf[p + 4] = (byte)(arg >> 32);
            buf[p + 5] = (byte)(arg >> 24);
            buf[p + 6] = (byte)(arg >> 16);
            buf[p + 7] = (byte)(arg >> 8);
            buf[p + 8] = (byte)arg;
            len = p + 9;
        }
    }

    // 无符号整数（major 0）。
    public void WriteUint(long v) { Head(0, v); }

    // 负整数（major 1，值 = -1 - n；n = ~v 对 long.MinValue 也不溢出）。
    public void WriteNeg(long v) { Head(1, ~v); }

    // text string（major 3）；超过 ChunkBytes 写 indefinite 分片。零中间 byte[] 直写。
    public void WriteString(string s) {
        int n = s.Length;
        if (n > CborWriter.ChunkBytes) {
            ChunkedStr(s);
            return;
        }
        Head(3, n);
        if (n > 0) {
            EnsureRoom(n);
            NativeMemory.PutString((nint)buf, len, s, n);
            len = len + n;
        }
    }

    private void ChunkedStr(string s) {
        RawU8((3 << 5) | 31);
        int slen = s.Length;
        int off = 0;
        nint sp = (nint)s;
        while (off < slen) {
            int n = slen - off;
            if (n > (int)CborWriter.ChunkBytes) {
                n = (int)CborWriter.ChunkBytes;
                // RFC 8949 §3.2.3: 每个 text string 分片本身必须是合法 UTF-8，回退跳过多字节续字节 (10xxxxxx)。
                int rew = 0;
                while (n > 1 && rew < 3 && ((s[off + n] & 192) == 128)) {
                    n = n - 1;
                    rew = rew + 1;
                }
            }
            Head(3, n);
            EnsureRoom(n);
            NativeMemory.Copy((nint)buf + len, sp + off, n);
            len = len + n;
            off = off + n;
        }
        RawU8(255);
    }

    // byte string（major 2）；超过 ChunkBytes 写 indefinite 分片。
    public void WriteBytes(byte[] b) {
        if (b.Length > CborWriter.ChunkBytes) {
            Chunked(2, b);
            return;
        }
        Head(2, b.Length);
        EnsureRoom(b.Length);
        NativeMemory.Copy((nint)buf + len, (nint)b, b.Length);
        len = len + b.Length;
    }

    // indefinite 分片主体：起始字节（major|31）、逐块定长编码、
    // break（0xFF）。等长分块，仅末块可短。
    public void Chunked(int major, byte[] b) {
        int m = major << 5;
        RawU8(m | 31);
        int off = 0;
        while (off < b.Length) {
            int n = b.Length - off;
            if (n > (int)CborWriter.ChunkBytes) { n = (int)CborWriter.ChunkBytes; }
            Head(major, n);
            EnsureRoom(n);
            NativeMemory.Copy((nint)buf + len, (nint)b + off, n);
            len = len + n;
            off = off + n;
        }
        RawU8(255);
    }

    // 数组头（major 4，确定长度）。
    public void WriteArrayHeader(int n) {
        if (n < 0) { throw new CborException("negative array length"); }
        Head(4, n);
    }

    // 映射头（major 5，确定长度）。
    public void WriteMapHeader(int n) {
        if (n < 0) { throw new CborException("negative map length"); }
        Head(5, n);
    }

    public void WriteBool(bool b) { RawU8(b ? 245 : 244); }
    public void WriteNull() { RawU8(246); }

    // float32（0xFA，固定 32 位）。
    public void WriteFloat(float f) {
        EnsureRoom(5);
        int bits = NativeMemory.AsI32(f);
        int p = len;
        buf[p] = 250;
        buf[p + 1] = (byte)(bits >> 24);
        buf[p + 2] = (byte)(bits >> 16);
        buf[p + 3] = (byte)(bits >> 8);
        buf[p + 4] = (byte)bits;
        len = p + 5;
    }

    // float64（0xFB，固定 64 位——不做最短浮点规范化，文档化取舍）。
    public void WriteDouble(double d) {
        EnsureRoom(9);
        long bits = NativeMemory.AsI64(d);
        int p = len;
        buf[p] = 251;
        buf[p + 1] = (byte)(bits >> 56);
        buf[p + 2] = (byte)(bits >> 48);
        buf[p + 3] = (byte)(bits >> 40);
        buf[p + 4] = (byte)(bits >> 32);
        buf[p + 5] = (byte)(bits >> 24);
        buf[p + 6] = (byte)(bits >> 16);
        buf[p + 7] = (byte)(bits >> 8);
        buf[p + 8] = (byte)bits;
        len = p + 9;
    }

    // 任意 tag 头（major 6）。
    public void WriteTag(long tag) { Head(6, tag); }

    // 取出已编码字节（复制一份）。
    public byte[] ToBytes() {
        byte[] out2 = new byte[len];
        NativeMemory.Copy((nint)out2, (nint)buf, len);
        return out2;
    }

    // double 的 IEEE-754 位模式：编译器内建 bitcast
    // （NativeMemory.AsI64，零开销、逐位精确——含次正规；NaN 归一为
    // quiet 位型）。取代旧手工归一化（截断丢 1 ULP、次正规指数域
    // 变负）。
    public static long DoubleBits(double v) {
        return NativeMemory.AsI64(v);
    }
}
