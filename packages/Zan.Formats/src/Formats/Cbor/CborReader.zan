using System;
using System.Buffers.Binary;
using System.Json;

namespace Formats.Cbor;

// CBOR 解码原语：在 byte[] 上游走，ReadValue 按首字节 major type
// 分派还原成 System.Json.JsonValue。全形态：indefinite 长度（文本/
// 字节串分片拼接、数组/映射读到 break）、tag（0/1 时间戳 → ISO
// 字符串，其余按 RFC 建议剥掉继续解码内层）、半精度 0xF9/单精度
// 0xFA/双精度 0xFB 浮点。byte string 按 UTF-8 尽力解码（JsonValue
// 无字节形态）。深度限 512。
public class CborReader {
    public byte[] buf;
    public int pos;
    public int len;
    string[] keyCache;

    // 包装整段字节。
    public CborReader(byte[] data) {
        if (data == null) { throw new CborException("null input buffer"); }
        buf = data;
        pos = 0;
        len = data.Length;
        keyCache = null;
    }

    // 包装切片 [offset, offset+count)。
    public CborReader(byte[] data, int offset, int count) {
        if (data == null || offset < 0 || count < 0 || (long)offset + (long)count > (long)data.Length) {
            throw new CborException("invalid slice range");
        }
        buf = data;
        pos = offset;
        len = offset + count;
        keyCache = null;
    }

    public int U8() {
        if (pos >= len) {
            throw new CborException("truncated at byte "
                + Convert.ToString(pos));
        }
        int b = buf[pos] & 255;
        pos = pos + 1;
        return b;
    }

    public int U16BE() {
        if (len - pos < 2) { throw new CborException("truncated at byte " + Convert.ToString(pos)); }
        int p = pos;
        int v = ((buf[p] & 255) << 8) | (buf[p + 1] & 255);
        pos = p + 2;
        return v;
    }

    public long U32BE() {
        if (len - pos < 4) { throw new CborException("truncated at byte " + Convert.ToString(pos)); }
        int p = pos;
        long v = ((long)(buf[p] & 255) << 24)
            | ((long)(buf[p + 1] & 255) << 16)
            | ((long)(buf[p + 2] & 255) << 8)
            | (long)(buf[p + 3] & 255);
        pos = p + 4;
        return v;
    }

    public long U64BE() {
        if (len - pos < 8) { throw new CborException("truncated at byte " + Convert.ToString(pos)); }
        int p = pos;
        long v = ((long)(buf[p] & 255) << 56)
            | ((long)(buf[p + 1] & 255) << 48)
            | ((long)(buf[p + 2] & 255) << 40)
            | ((long)(buf[p + 3] & 255) << 32)
            | ((long)(buf[p + 4] & 255) << 24)
            | ((long)(buf[p + 5] & 255) << 16)
            | ((long)(buf[p + 6] & 255) << 8)
            | (long)(buf[p + 7] & 255);
        pos = p + 8;
        return v;
    }

    // 读 argument（additional info 0-27；24-31 保留）。返回值带
    // 独立码 31（indefinite）时由调用方分支。
    public long Arg(int ai) {
        if (ai < 24) { return ai; }
        if (ai == 24) { return U8(); }
        if (ai == 25) { return U16BE(); }
        if (ai == 26) { return U32BE(); }
        if (ai == 27) { return U64BE(); }
        throw new CborException("reserved additional info "
            + Convert.ToString(ai) + " at byte " + Convert.ToString(pos));
    }

    // 定长 argument → int 长度/元素数：>512MB（对齐 MsgPack/BSON
    // 读侧载荷上限；输入缓冲本身不超过 2^31，合法值不可能触线）
    // 即抛。直接 (int) 截断会把 2^32+5 静默变成 5，把畸形流"解析"
    // 成错误但合法的结果。
    public int ArgLen(long v) {
        if (v < 0 || v > 536870912) {
            throw new CborException("length " + Convert.ToString(v)
                + " exceeds 512MB limit at byte " + Convert.ToString(pos));
        }
        return (int)v;
    }

    public byte[] Take(int n) {
        if (n < 0 || n > len - pos) {
            throw new CborException("truncated at byte "
                + Convert.ToString(pos) + " (need " + Convert.ToString(n) + ")");
        }
        byte[] out2 = new byte[n];
        NativeMemory.Copy((nint)out2, (nint)buf + pos, n);
        pos = pos + n;
        return out2;
    }

    public string TakeStr(int n) {
        if (n < 0 || n > len - pos) {
            throw new CborException("truncated at byte "
                + Convert.ToString(pos) + " (need " + Convert.ToString(n) + ")");
        }
        if (n == 0) { return ""; }
        string s = buf.ToStr(pos, n);
        pos = pos + n;
        return s;
    }

    // 定长 byte string 直接 UTF-8 解码，消除中间 byte[] 拷贝。
    public string TakeUtf8(int n) {
        if (n < 0 || n > len - pos) {
            throw new CborException("truncated at byte "
                + Convert.ToString(pos) + " (need " + Convert.ToString(n) + ")");
        }
        if (n == 0) { return ""; }
        string s = Encoding.GetString(buf, pos, n);
        pos = pos + n;
        return s;
    }

    // 短 map 键直映缓存（64 槽，FNV-1a 32 + 逐字节精确验证），同构对象数组免重复分配键字符串。
    string TakeCachedKey(int n) {
        if (n < 0 || n > len - pos) {
            throw new CborException("truncated at byte "
                + Convert.ToString(pos) + " (need " + Convert.ToString(n) + ")");
        }
        if (n == 0) { return ""; }
        if (n > 32) {
            string ls = buf.ToStr(pos, n);
            pos = pos + n;
            return ls;
        }
        if (keyCache == null) { keyCache = new string[64]; }
        int p = pos;
        uint h = 2166136261U;
        for (int i = 0; i < n; i = i + 1) {
            h = (h ^ (uint)(buf[p + i] & 255)) * 16777619U;
        }
        int slot = (int)(h & 63U);
        string cached = keyCache[slot];
        if (cached != null && cached.Length == n) {
            bool eq = true;
            for (int i = 0; i < n; i = i + 1) {
                if ((buf[p + i] & 255) != (cached[i] & 255)) { eq = false; break; }
            }
            if (eq) {
                pos = p + n;
                return cached;
            }
        }
        string fresh = buf.ToStr(p, n);
        keyCache[slot] = fresh;
        pos = p + n;
        return fresh;
    }

    // 读一个完整值（深度上限 512）。
    public JsonValue ReadValue(int depth) {
        if (depth > 512) {
            throw new CborException("nesting too deep at byte "
                + Convert.ToString(pos));
        }
        int ib = U8();
        int major = ib >> 5;
        int ai = ib & 31;
        if (major == 0) {  // 无符号整数
            long v = Arg(ai);
            if (v >= 0) { return JsonValue.NewInt(v); }
            // 2^63..2^64-1 → double（精度丢失，文档化）。
            long hi = (v >> 1) & 9223372036854775807;
            return JsonValue.NewDouble((double)hi * 2.0 + (double)(v & 1));
        }
        if (major == 1) {  // 负整数：RFC 8949 定义值为 -1 - n（n 为无符号 64 位参数）
            long n = Arg(ai);
            if (n >= 0) { return JsonValue.NewInt(-1 - n); }
            return JsonValue.NewDouble(0.0 - (1.0 + U64ToDouble(n)));
        }
        if (major == 2) {  // byte string
            if (ai == 31) { return JsonValue.NewStr(TakeChunksStr(2)); }
            return JsonValue.NewStr(TakeUtf8(ArgLen(Arg(ai))));
        }
        if (major == 3) {  // text string
            if (ai == 31) { return JsonValue.NewStr(TakeChunksStr(3)); }
            return JsonValue.NewStr(TakeStr(ArgLen(Arg(ai))));
        }
        if (major == 4) {  // array
            JsonValue arr = JsonValue.NewArray();
            if (ai == 31) {
                while (!AtBreak()) { arr.items.Add(ReadValue(depth + 1)); }
                return arr;
            }
            int n = ArgLen(Arg(ai));
            int rem = len - pos;
            int cap = n < rem ? n : rem;
            if (cap > 0) { arr.items.Reserve(cap); }
            List<JsonValue> items = arr.items;
            int i = 0;
            while (i < n) {
                items.Add(ReadValue(depth + 1));
                i = i + 1;
            }
            return arr;
        }
        if (major == 5) {  // map
            JsonValue obj = JsonValue.NewObject();
            if (ai == 31) {
                while (!AtBreak()) {
                    PutEntry(obj, depth);
                }
                return obj;
            }
            int n = ArgLen(Arg(ai));
            int rem = (len - pos) / 2;
            int cap = n < rem ? n : rem;
            if (cap > 0) {
                obj.keys.Reserve(cap);
                obj.vals.Reserve(cap);
            }
            int i = 0;
            while (i < n) {
                PutEntry(obj, depth);
                i = i + 1;
            }
            return obj;
        }
        if (major == 6) {  // tag
            long tag = Arg(ai);
            if (ai == 31) {
                throw new CborException("indefinite tag at byte "
                    + Convert.ToString(pos));
            }
            JsonValue inner = ReadValue(depth + 1);
            return Tagged(tag, inner);
        }
        return SimpleValue(ai);  // major 7
    }

    // 新建对象快速写入并去重（小对象线性扫描、大对象转 keyIndex，避开重复键且零 CheckCycle 开销）。
    private static void SetObjField(JsonValue obj, string key, JsonValue val) {
        if (obj.keyIndex != null) {
            int existing = 0;
            if (obj.keyIndex.TryGetValue(key, out existing)) {
                obj.vals[existing] = val;
                return;
            }
            int ni = obj.keys.Count;
            obj.keys.Add(key);
            obj.vals.Add(val);
            obj.keyIndex[key] = ni;
            return;
        }
        int cnt = obj.keys.Count;
        if (cnt < 8) {
            for (int i = 0; i < cnt; i = i + 1) {
                if (obj.keys[i] == key) {
                    obj.vals[i] = val;
                    return;
                }
            }
            obj.keys.Add(key);
            obj.vals.Add(val);
            return;
        }
        Dict<string, int> idx = new Dict<string, int>();
        for (int i = 0; i < cnt; i = i + 1) {
            idx[obj.keys[i]] = i;
        }
        obj.keyIndex = idx;
        int ex2 = 0;
        if (idx.TryGetValue(key, out ex2)) {
            obj.vals[ex2] = val;
            return;
        }
        obj.keys.Add(key);
        obj.vals.Add(val);
        idx[key] = cnt;
    }

    // map 条目：key 必须是文本字符串（JsonValue 对象键即字符串）。
    // 定长文本键快路径走短键缓存直接解 string 并去重写入。
    public void PutEntry(JsonValue obj, int depth) {
        if (depth + 1 <= 512 && pos < len) {
            int ib = buf[pos] & 255;
            if ((ib >> 5) == 3) {
                int ai = ib & 31;
                if (ai != 31) {
                    pos = pos + 1;
                    string key = TakeCachedKey(ArgLen(Arg(ai)));
                    JsonValue val = ReadValue(depth + 1);
                    if (!obj.isReadOnly) {
                        CborReader.SetObjField(obj, key, val);
                    } else {
                        obj.Put(key, val);
                    }
                    return;
                }
            }
        }
        JsonValue k = ReadValue(depth + 1);
        if (!k.IsString()) {
            throw new CborException("map key is not a text string at byte "
                + Convert.ToString(pos));
        }
        JsonValue val2 = ReadValue(depth + 1);
        if (!obj.isReadOnly) {
            CborReader.SetObjField(obj, k.AsString(""), val2);
        } else {
            obj.Put(k.AsString(""), val2);
        }
    }

    // indefinite 主体直解为字符串：直接从输入缓冲拷贝各分片到单一累加器再 UTF-8 解码，零每片 byte[] 与末次拷贝。
    string TakeChunksStr(int wantMajor) {
        byte[] acc = new byte[64];
        int n = 0;
        bool closed = false;
        while (pos < len) {
            int ib = buf[pos] & 255;
            pos = pos + 1;  // 消费块头字节
            if (ib == 255) { closed = true; break; }  // break
            int major = ib >> 5;
            int ai = ib & 31;
            if (major != wantMajor || ai == 31) {
                throw new CborException("bad chunk header at byte "
                    + Convert.ToString(pos));
            }
            int clen = ArgLen(Arg(ai));
            if (clen < 0 || clen > len - pos) {
                throw new CborException("truncated at byte "
                    + Convert.ToString(pos) + " (need " + Convert.ToString(clen) + ")");
            }
            long need = (long)n + (long)clen;
            if (need > (long)len || need > 2147483591L) {
                throw new CborException("indefinite chunk length overflow");
            }
            if (need > (long)acc.Length) {
                long c = (long)acc.Length;
                while (c < need) {
                    c = c * 2L;
                    if (c > (long)len) { c = (long)len; break; }
                }
                byte[] grown = new byte[(int)c];
                NativeMemory.Copy((nint)grown, (nint)acc, n);
                acc = grown;
            }
            if (clen > 0) {
                NativeMemory.Copy((nint)acc + n, (nint)buf + pos, clen);
                pos = pos + clen;
                n = n + clen;
            }
        }
        if (!closed) {
            throw new CborException("unterminated indefinite at byte "
                + Convert.ToString(pos));
        }
        if (n == 0) { return ""; }
        return Encoding.GetString(acc, 0, n);
    }

    // indefinite 主体：分片读到 break。wantMajor 校验分片类型一致。
    public byte[] TakeChunks(int wantMajor) {
        byte[] acc = new byte[64];
        int n = 0;
        bool closed = false;
        while (pos < len) {
            int ib = buf[pos] & 255;
            pos = pos + 1;  // 消费块头字节
            if (ib == 255) { closed = true; break; }  // break
            int major = ib >> 5;
            int ai = ib & 31;
            if (major != wantMajor || ai == 31) {
                throw new CborException("bad chunk header at byte "
                    + Convert.ToString(pos));
            }
            int clen = ArgLen(Arg(ai));
            if (clen < 0 || clen > len - pos) {
                throw new CborException("truncated at byte "
                    + Convert.ToString(pos) + " (need " + Convert.ToString(clen) + ")");
            }
            // 64 位容量算术且以输入上限钳制：每个 chunk 来自当前切片，总长度不可能超过 len。
            long need = (long)n + (long)clen;
            if (need > (long)len || need > 2147483591L) {
                throw new CborException("indefinite chunk length overflow");
            }
            if (need > (long)acc.Length) {
                long c = (long)acc.Length;
                while (c < need) {
                    c = c * 2L;
                    if (c > (long)len) { c = (long)len; break; }
                }
                byte[] grown = new byte[(int)c];
                NativeMemory.Copy((nint)grown, (nint)acc, n);
                acc = grown;
            }
            if (clen > 0) {
                NativeMemory.Copy((nint)acc + n, (nint)buf + pos, clen);
                pos = pos + clen;
                n = n + clen;
            }
        }
        if (!closed) {
            throw new CborException("unterminated indefinite at byte "
                + Convert.ToString(pos));
        }
        if (n == acc.Length) { return acc; }
        byte[] out2 = new byte[n];
        if (n > 0) { NativeMemory.Copy((nint)out2, (nint)acc, n); }
        return out2;
    }

    // 窥探 break（0xFF）；非 break 原样返回假（由 ReadValue 继续读）。
    public bool AtBreak() {
        if (pos >= len) {
            throw new CborException("unterminated indefinite at byte "
                + Convert.ToString(pos));
        }
        if ((buf[pos] & 255) == 255) { pos = pos + 1; return true; }
        return false;
    }

    // tag 的目标语义：0 = RFC3339 文本（原样）、1 = 纪元秒（int/double
    // → ISO）；其余 tag 按 RFC 建议剥掉（不解语义，取内层）。tag 1
    // 的内层必须是数值——串/null 之类伪造不出纪元，抛畸形而不是
    // 静默造假时间戳（AsDouble 缺省 0 会把垃圾变成 1970-01-01）。
    public static JsonValue Tagged(long tag, JsonValue inner) {
        if (tag == 0) { return inner; }
        if (tag == 1) {
            if (inner.IsInt()) {
                return JsonValue.NewStr(IsoFromUnixNanos(inner.AsLong(0), 0));
            }
            if (inner.IsNumber()) {
                double d = inner.AsDouble(0);
                if (d != d || d < -62135596800.0 || d > 253402300799.0) {
                    throw new CborException("tag 1 timestamp out of valid finite range");
                }
                long sec = (long)d;
                long ms = (long)((d - (double)sec) * 1000.0);
                if (ms < 0) {
                    sec = sec - 1;
                    ms = ms + 1000;
                }
                return JsonValue.NewStr(IsoFromUnixNanos(sec, ms * 1000000));
            }
            throw new CborException("tag 1 payload must be an integer or float");
        }
        return inner;
    }

    // major 7：simple/float。break 只在 indefinite 循环里合法消费。
    public JsonValue SimpleValue(int ai) {
        if (ai == 20) { return JsonValue.NewBool(false); }
        if (ai == 21) { return JsonValue.NewBool(true); }
        if (ai == 22 || ai == 23) { return JsonValue.NewNull(); }  // null/undefined
        if (ai == 25) { return JsonValue.NewDouble(BitsHalf(U16BE())); }
        if (ai == 26) { return JsonValue.NewDouble(BitsSingle((int)U32BE())); }
        if (ai == 27) { return JsonValue.NewDouble(BitsDouble(U64BE())); }
        if (ai == 24) {
            throw new CborException("unassigned simple value at byte "
                + Convert.ToString(pos - 1));
        }
        if (ai == 31) {
            throw new CborException("unexpected break at byte "
                + Convert.ToString(pos - 1));
        }
        throw new CborException("unexpected simple value " + Convert.ToString(ai)
            + " at byte " + Convert.ToString(pos - 1));
    }

    // 字节 → 字符串（UTF-8 尽力，非法序列 U+FFFD）。
    public static string TextOf(byte[] b) {
        return Encoding.GetString(b, 0, b.Length);
    }

    // Unix 秒 + 纳秒 → ISO 8601 UTC。
    public static string IsoFromUnixNanos(long sec, long nanos) {
        DateTime t = DateTime.FromUnixSeconds(sec);
        int year = t.Year();
        int month = t.Month();
        int day = t.Day();
        int hour = t.Hour();
        int minute = t.Minute();
        int second = t.Second();
        long ms = nanos / 1000000;
        if (year >= 0 && year < 10000 && ms >= 0 && ms < 1000) {
            int total = ms > 0 ? 24 : 20;
            byte[] outb = new byte[total];
            outb[0] = (byte)(48 + (year / 1000) % 10);
            outb[1] = (byte)(48 + (year / 100) % 10);
            outb[2] = (byte)(48 + (year / 10) % 10);
            outb[3] = (byte)(48 + year % 10);
            outb[4] = 45;
            outb[5] = (byte)(48 + month / 10);
            outb[6] = (byte)(48 + month % 10);
            outb[7] = 45;
            outb[8] = (byte)(48 + day / 10);
            outb[9] = (byte)(48 + day % 10);
            outb[10] = 84;
            outb[11] = (byte)(48 + hour / 10);
            outb[12] = (byte)(48 + hour % 10);
            outb[13] = 58;
            outb[14] = (byte)(48 + minute / 10);
            outb[15] = (byte)(48 + minute % 10);
            outb[16] = 58;
            outb[17] = (byte)(48 + second / 10);
            outb[18] = (byte)(48 + second % 10);
            if (ms > 0) {
                int r = (int)ms;
                outb[19] = 46;
                outb[20] = (byte)(48 + r / 100);
                outb[21] = (byte)(48 + (r / 10) % 10);
                outb[22] = (byte)(48 + r % 10);
                outb[23] = 90;
            } else {
                outb[19] = 90;
            }
            return outb.ToStr(0, total);
        }
        StringBuilder sb = new StringBuilder();
        sb.Append(Pad4(year));
        sb.Append("-");
        sb.Append(Pad2(month));
        sb.Append("-");
        sb.Append(Pad2(day));
        sb.Append("T");
        sb.Append(Pad2(hour));
        sb.Append(":");
        sb.Append(Pad2(minute));
        sb.Append(":");
        sb.Append(Pad2(second));
        if (ms > 0) {
            sb.Append(".");
            if (ms < 100) { sb.Append("0"); }
            if (ms < 10) { sb.Append("0"); }
            sb.Append(Convert.ToString(ms));
        }
        sb.Append("Z");
        return sb.ToString();
    }

    public static string Pad2(int v) {
        if (v >= 0 && v < 100) {
            byte[] buf = new byte[2];
            buf[0] = (byte)(48 + v / 10);
            buf[1] = (byte)(48 + v % 10);
            return buf.ToStr(0, 2);
        }
        return Convert.ToString(v);
    }

    public static string Pad4(int v) {
        if (v >= 0 && v < 10000) {
            byte[] buf = new byte[4];
            buf[0] = (byte)(48 + (v / 1000) % 10);
            buf[1] = (byte)(48 + (v / 100) % 10);
            buf[2] = (byte)(48 + (v / 10) % 10);
            buf[3] = (byte)(48 + v % 10);
            return buf.ToStr(0, 4);
        }
        return Convert.ToString(v);
    }

    // u64（作为有符号 long 已为负）→ double 近似。
    public static double U64ToDouble(long v) {
        long hi = (v >> 1) & 9223372036854775807;
        return (double)hi * 2.0 + (double)(v & 1);
    }

    // 半精度位型 → double（半精度的全部值在 double 里精确，零循环直接位构造）。
    public static double BitsHalf(int bits) {
        long signBit = ((long)(bits >> 15) & 1L) << 63;
        int exp = (bits >> 10) & 31;
        int mant = bits & 1023;
        if (exp == 31) {
            if (mant == 0) {
                return NativeMemory.AsF64(signBit | 0x7FF0000000000000L);
            }
            return NativeMemory.AsF64(0x7FF8000000000000L);
        }
        if (exp == 0) {
            if (mant == 0) { return NativeMemory.AsF64(signBit); }
            // 次正规：m * 2^-24（m ≤ 2^10 精确）。
            double v = (double)mant * 5.9604644775390625e-8;
            return signBit != 0L ? (0.0 - v) : v;
        }
        long dBits = signBit | ((long)(exp + 1008) << 52) | ((long)mant << 42);
        return NativeMemory.AsF64(dBits);
    }

    // 32 位 IEEE-754 位型 → double：编译器内建 bitcast
    // （NativeMemory.AsF32，零开销、逐位精确——次正规/±∞/NaN/-0.0 原位还原）。
    public static double BitsSingle(int bits) {
        return (double)NativeMemory.AsF32(bits);
    }

    // 64 位 IEEE-754 位型 → double：编译器内建 bitcast
    // （NativeMemory.AsF64，零开销、逐位精确——次正规/±∞/NaN/-0.0
    // 原位还原）。取代旧逐位累加。
    public static double BitsDouble(long bits) {
        return NativeMemory.AsF64(bits);
    }

    public static double Pow2(int e) {
        if (e >= -1022 && e <= 1023) {
            return NativeMemory.AsF64((long)(e + 1023) << 52);
        }
        double v = 1.0;
        if (e >= 0) {
            int i = 0;
            while (i < e) { v = v * 2.0; i = i + 1; }
        } else {
            int i = 0;
            while (i > e) { v = v / 2.0; i = i - 1; }
        }
        return v;
    }
}
