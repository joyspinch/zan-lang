using System;
using System.Json;
using System.Text;

namespace Formats.Toml;

// 递归下降 TOML 解析器（Toml.Parse 的实现），值树落
// <see cref="JsonValue"/>：整数/浮点走 number，四种日期时间按原文
// 存字符串，表/行内表落 object，数组落 array。
// 字节游标风格与 System.Xml/Json 一致：<c>s[pos] &amp; 255</c> 逐字节
// 判别，格式非法立即抛 <see cref="TomlException"/>（带行列号）。
// 有意宽松的三处（都在 README 声明）：行内表允许跨行；被点号键
// 打开过的表允许再被表头补键；表头重复只查"完全相同的头"。
public class TomlParser {
    // 输入文本与游标。
    string s;
    nint sPtr;
    int pos;
    int len;
    // 数组/行内表嵌套深度上限（与 Json 读写两侧的约定对称）。
    public static int MaxDepth = 512;
    // long 上限（Zan 无 long.MaxValue 表达式，直写常数）。
    public static long MaxLong = 9223372036854775807;

    JsonValue root;
    // 当前表：后续键值对落这里。
    JsonValue cur;
    // 已出现的表头路径（段间以字节 1 连接），查重复定义。
    Dict<string, bool> headers;
    // 64 槽直接映射裸键驻留缓存，消除 [[table]] / 行内表重复字段名分配。
    string[] keyCache;
    // 整数解析溢出哨兵（ParseIntBase 设置，调用方核对后报错）。
    bool intOverflow;
    // 整数解析非法数字位哨兵（0xGG、0b12 这类；ParseIntBase 设置）。
    bool intBadDigit;

    public TomlParser() {}

    // 解析入口。格式非法抛 TomlException（带行列号）。
    public static JsonValue Parse(string src) {
        // BOM 是编码标记不是内容：文件路径已由 File.ReadAllText 剥过，
        // 网络/内嵌文本（Windows 工具常带 EF BB BF）在这里兜底，不剥
        // 首键会带上三个隐形字节。
        if (src.Length >= 3 && (src[0] & 255) == 239 && (src[1] & 255) == 187
            && (src[2] & 255) == 191) {
            src = src.Substring(3);
        }
        TomlParser p = new TomlParser();
        p.s = src;
        p.sPtr = (nint)src;
        p.pos = 0;
        p.len = src.Length;
        p.keyCache = new string[64];
        return p.ReadDocument();
    }

    JsonValue ReadDocument() {
        root = JsonValue.NewObject();
        cur = root;
        headers = new Dict<string, bool>();
        while (pos < len) {
            SkipWsNewlinesComments();
            if (pos >= len) { break; }
            int c = CurB();
            if (c == 91) {  // '['
                ReadTableHeader();
            } else {
                ReadKeyValue(cur, true, 1);
            }
        }
        return root;
    }

    // 表头：[a.b.c] 或 [[arr]]。单段表头走零 List / 零 StringBuilder 快路径。
    void ReadTableHeader() {
        bool arrayTable = Has("[[");
        pos = pos + (arrayTable ? 2 : 1);
        SkipH();
        string firstKey = ReadKey();
        SkipH();
        if (arrayTable && pos + 1 < len && (s[pos] & 255) == 93 && (s[pos + 1] & 255) == 93) {
            pos = pos + 2;
            EndOfLine("table header");
            cur = NavigateSingleHeader(firstKey, true);
            return;
        }
        if (!arrayTable && CurB() == 93) {
            pos = pos + 1;
            EndOfLine("table header");
            cur = NavigateSingleHeader(firstKey, false);
            return;
        }
        List<string> path = new List<string>();
        path.Add(firstKey);
        while (pos < len && CurB() == 46) {
            pos = pos + 1;
            SkipH();
            path.Add(ReadKey());
            SkipH();
        }
        if (arrayTable) {
            if (!Has("]]")) { Err("expected ']]'"); }
            pos = pos + 2;
        } else {
            if (CurB() != 93) { Err("expected ']'"); }  // ']'
            pos = pos + 1;
        }
        EndOfLine("table header");
        cur = NavigateHeader(path, arrayTable);
    }

    JsonValue NavigateSingleHeader(string last, bool arrayTable) {
        JsonValue dest = root.Get(last);
        if (arrayTable) {
            if (dest == null) {
                dest = JsonValue.NewArray();
                int kidx = root.keys.Count;
                root.keys.Add(last);
                root.vals.Add(dest);
                if (root.keyIndex != null) { root.keyIndex[last] = kidx; }
            } else if (!dest.IsArray()) {
                Err("'" + last + "' is not an array of tables");
            }
            JsonValue elem = JsonValue.NewObject();
            dest.items.Add(elem);
            return elem;
        }
        if (dest == null) {
            dest = JsonValue.NewObject();
            int kidx = root.keys.Count;
            root.keys.Add(last);
            root.vals.Add(dest);
            if (root.keyIndex != null) { root.keyIndex[last] = kidx; }
        } else if (!dest.IsObject()) {
            Err("'" + last + "' is not a table");
        }
        string key = "\u0001" + last;
        if (headers.ContainsKey(key)) {
            Err("table defined twice: " + key);
        }
        headers[key] = true;
        return dest;
    }

    // 键值对：path.to.key = value。文档层与表头的对收口到行尾；
    // 行内表里的对以 ',' / '}' 收口，不做行尾校验。
    void ReadKeyValue(JsonValue owner, bool needLineEnd, int depth) {
        if (depth > TomlParser.MaxDepth) { Err("TOML nesting too deep"); }
        string firstKey = ReadKey();
        SkipH();
        if (CurB() == 61) {  // 单段键快路径（无点号，零 List 分配，零 CheckCycle）
            pos = pos + 1;
            SkipH();
            JsonValue v = ReadValue(depth);
            if (owner.Has(firstKey)) { Err("key defined twice: " + firstKey); }
            int idx = owner.keys.Count;
            owner.keys.Add(firstKey);
            owner.vals.Add(v);
            if (owner.keyIndex != null) { owner.keyIndex[firstKey] = idx; }
            if (needLineEnd) { EndOfLine("key-value pair"); }
            return;
        }
        List<string> path = new List<string>();
        path.Add(firstKey);
        while (pos < len && CurB() == 46) {
            pos = pos + 1;
            SkipH();
            path.Add(ReadKey());
            SkipH();
        }
        if (CurB() != 61) { Err("expected '=' after key"); }  // '='
        pos = pos + 1;
        SkipH();
        JsonValue v2 = ReadValue(depth);
        SetValue(owner, path, v2);
        if (needLineEnd) { EndOfLine("key-value pair"); }
    }

    // 键路径：key (. key)*；bare / 基本串 / 字面串三种键型。
    List<string> ReadKeyPath() {
        List<string> path = new List<string>();
        while (pos < len) {
            path.Add(ReadKey());
            SkipH();
            if (CurB() == 46) {  // '.'
                pos = pos + 1;
                SkipH();
                continue;
            }
            break;
        }
        if (path.Count == 0) { Err("expected a key"); }
        return path;
    }

    string ReadKey() {
        int c = CurB();
        if (c == 34) { return ReadBasicString(); }  // '"'
        if (c == 39) { return ReadLiteralString(); }  // '\''
        int start = pos;
        Span<byte> buf = new Span<byte>(sPtr, len);
        int h = -2128831035;
        while (pos < len) {
            int d = buf[pos] & 255;
            bool ok = (d >= 97 && d <= 122) || (d >= 65 && d <= 90)
                || (d >= 48 && d <= 57) || d == 95 || d == 45
                || d >= 128;  // [A-Za-z0-9_-] + 非 ASCII
            if (!ok) { break; }
            h = (h ^ d) * 16777619;
            pos = pos + 1;
        }
        int n = pos - start;
        if (n == 0) { Err("expected a key"); }
        if (n <= 32) {
            int slot = h & 63;
            string cached = keyCache[slot];
            if (cached != null && cached.Length == n) {
                bool eq = true;
                for (int i = 0; i < n; i = i + 1) {
                    if ((buf[start + i] & 255) != (cached[i] & 255)) { eq = false; break; }
                }
                if (eq) { return cached; }
            }
            string fresh = s.Substring(start, n);
            keyCache[slot] = fresh;
            return fresh;
        }
        return s.Substring(start, n);
    }

    // 值分派：字符串/数组/行内表/布尔/数字与日期时间。
    JsonValue ReadValue(int depth) {
        if (depth > TomlParser.MaxDepth) { Err("TOML nesting too deep"); }
        int c = CurB();
        if (c == 34) {  // '"'
            if (Has("\"\"\"")) { return JsonValue.NewStr(ReadMultilineBasic()); }
            return JsonValue.NewStr(ReadBasicString());
        }
        if (c == 39) {  // '\''
            if (Has("'''")) { return JsonValue.NewStr(ReadMultilineLiteral()); }
            return JsonValue.NewStr(ReadLiteralString());
        }
        if (c == 91) { return ReadArray(depth); }  // '['
        if (c == 123) { return ReadInlineTable(depth); }  // '{'
        if (c == 116) {
            if (pos + 4 <= len && (s[pos + 1] & 255) == 114 && (s[pos + 2] & 255) == 117 && (s[pos + 3] & 255) == 101) {
                pos = pos + 4;
                return JsonValue.NewBool(true);
            }
            Err("invalid value");
        }
        if (c == 102) {
            if (pos + 5 <= len && (s[pos + 1] & 255) == 97 && (s[pos + 2] & 255) == 108 && (s[pos + 3] & 255) == 115 && (s[pos + 4] & 255) == 101) {
                pos = pos + 5;
                return JsonValue.NewBool(false);
            }
            Err("invalid value");
        }
        return ReadNumberOrDatetime();
    }

    // 数组：跨行、注释、尾逗号都合法。
    JsonValue ReadArray(int depth) {
        JsonValue arr = JsonValue.NewArray();
        List<JsonValue> items = arr.items;
        pos = pos + 1;  // 消费 '['
        while (pos < len) {
            SkipWsNewlinesComments();
            if (CurB() == 93) { pos = pos + 1; return arr; }  // ']'
            if (pos >= len) { Err("unterminated array"); }
            items.Add(ReadValue(depth + 1));
            SkipWsNewlinesComments();
            int c = CurB();
            if (c == 44) {  // ','
                pos = pos + 1;
                continue;
            }
            if (c == 93) { pos = pos + 1; return arr; }
            Err("expected ',' or ']' in array");
        }
        Err("unterminated array");
        return arr;
    }

    // 行内表：{ k = v, ... }。规范要求单行，这里允许跨行（宽松）。
    JsonValue ReadInlineTable(int depth) {
        JsonValue obj = JsonValue.NewObject();
        pos = pos + 1;  // 消费 '{'
        SkipWsNewlinesComments();
        if (CurB() == 125) { pos = pos + 1; return obj; }  // '}'
        while (pos < len) {
            ReadKeyValue(obj, false, depth + 1);
            SkipWsNewlinesComments();
            int c = CurB();
            if (c == 44) {  // ','
                pos = pos + 1;
                SkipWsNewlinesComments();
                continue;
            }
            if (c == 125) { pos = pos + 1; return obj; }
            Err("expected ',' or '}' in inline table");
        }
        Err("unterminated inline table");
        return obj;
    }

    // 数字与四种日期时间共用一个 token 扫描：纯十进制短整数走零 Substring 切片快路径，
    // 其余（日期/浮点/下划线/0x/0o/0b/19位大整数/inf/nan）回落完整解析。
    JsonValue ReadNumberOrDatetime() {
        int start = pos;
        Span<byte> buf = new Span<byte>(sPtr, len);
        int dStart = start;
        bool neg = false;
        if (pos < len) {
            int c0 = buf[pos] & 255;
            if (c0 == 45) { neg = true; dStart = start + 1; pos = pos + 1; }
            else if (c0 == 43) { dStart = start + 1; pos = pos + 1; }
        }
        bool pureDigits = true;
        long fastVal = 0L;
        while (pos < len) {
            int c = buf[pos] & 255;
            if (c >= 48 && c <= 57) {
                if (pureDigits && pos - dStart < 18) {
                    fastVal = fastVal * 10L + (long)(c - 48);
                }
                pos = pos + 1;
                continue;
            }
            bool tok = (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
                || c == 43 || c == 45 || c == 46 || c == 58 || c == 95;
            if (tok) {
                pureDigits = false;
                pos = pos + 1;
                continue;
            }
            if (c == 32 && pos + 1 < len) {  // ' '
                int nxt = buf[pos + 1] & 255;
                if (nxt >= 48 && nxt <= 57) {  // datetime 空格分隔
                    pureDigits = false;
                    pos = pos + 1;
                    continue;
                }
            }
            break;
        }
        if (pos == start) { Err("expected a value"); }
        int dLen = pos - dStart;
        if (pureDigits && dLen >= 1 && dLen <= 18) {
            return JsonValue.NewInt(neg ? -fastVal : fastVal);
        }
        string tok = s.Substring(start, pos - start);
        string t = NativeMemory.Find((nint)tok, 0, 95, tok.Length) >= 0 ? TomlParser.Strip(tok, "_") : tok;
        // 日期时间：以 4 位年份起头（YYYY-MM-DD...）或纯时间 HH:MM...
        if (TomlParser.DateLike(t)) { return JsonValue.NewStr(tok); }
        bool isInt = TomlParser.IntShape(t);
        if (isInt) {
            this.intOverflow = false;
            this.intBadDigit = false;
            long v = this.ParseIntBase(t);
            if (this.intOverflow) { Err("integer out of 64-bit range: " + tok); }
            if (this.intBadDigit) { Err("invalid digit for base in integer: " + tok); }
            return JsonValue.NewInt(v);
        }
        if (t == "inf" || t == "+inf") { return JsonValue.NewNum("Infinity"); }
        if (t == "-inf") { return JsonValue.NewNum("-Infinity"); }
        if (t == "nan" || t == "+nan" || t == "-nan") { return JsonValue.NewNum("NaN"); }
        if (t.Length > 0 && (t[0] & 255) == 43) {
            t = t.Substring(1, t.Length - 1);  // DoubleOf 不收 '+'
        }
        // 尾部垃圾校验：JsonValue.DoubleOf 遇非数字即停，"1abc" 会
        // 静默变 1.0——TOML 规范本就禁止，改为整段必须吃完。
        if (!TomlParser.FloatShapeStrict(t)) { Err("malformed number: " + tok); }
        double d = JsonValue.DoubleOf(t);
        return JsonValue.NewDouble(d);
    }

    // 基本字符串 "..."：转义 \b \t \n \f \r \" \\ \uXXXX \UXXXXXXXX。
    string ReadBasicString() {
        pos = pos + 1;  // 消费 '"'
        int runStart = pos;
        StringBuilder sb = null;
        nint sp = (nint)s;
        while (pos < len) {
            int c = s[pos] & 255;
            if (c == 34) {
                if (sb == null) {
                    string direct = s.Substring(runStart, pos - runStart);
                    pos = pos + 1;
                    return direct;
                }
                if (pos > runStart) { sb.Append(new StringView(sp + (nint)runStart, pos - runStart)); }
                pos = pos + 1;
                return sb.ToString();
            }
            if (c == 10) { Err("newline in basic string"); }
            if (c == 92) {  // '\'
                if (sb == null) { sb = new StringBuilder(); }
                if (pos > runStart) { sb.Append(new StringView(sp + (nint)runStart, pos - runStart)); }
                pos = pos + 1;
                ReadEscape(sb);
                runStart = pos;
                continue;
            }
            pos = pos + 1;
        }
        Err("unterminated basic string");
        return "";
    }

    // 多行基本字符串 """..."""：开界定符后的首个换行剥掉；
    // 行尾反斜杠吃掉后续空白与换行（行拼接）。
    string ReadMultilineBasic() {
        pos = pos + 3;  // 消费 """
        if (CurB() == 10) { pos = pos + 1; }  // 首换行剥掉
        else if (CurB() == 13 && pos + 1 < len && (s[pos + 1] & 255) == 10) {
            pos = pos + 2;
        }
        int runStart = pos;
        StringBuilder sb = null;
        while (pos < len) {
            int c = s[pos] & 255;
            if (c == 34 && pos + 2 < len && (s[pos + 1] & 255) == 34 && (s[pos + 2] & 255) == 34) {
                // 内容里的 " 允许出现在界定符前："""" = 引号 + 收口。
                if (pos + 3 < len && (s[pos + 3] & 255) == 34) {
                    pos = pos + 1;
                    continue;
                }
                if (sb == null) {
                    string direct = s.Substring(runStart, pos - runStart);
                    pos = pos + 3;
                    return direct;
                }
                if (pos > runStart) { sb.Append(new StringView(sPtr + (nint)runStart, pos - runStart)); }
                pos = pos + 3;
                return sb.ToString();
            }
            if (c == 92) {
                if (sb == null) { sb = new StringBuilder(); }
                if (pos > runStart) { sb.Append(new StringView(sPtr + (nint)runStart, pos - runStart)); }
                if (TomlParser.LineBackslash(s, pos, len)) {
                    // 行尾反斜杠：吃掉反斜杠 + 空白 + 换行。
                    pos = pos + 1;
                    while (pos < len) {
                        int w = s[pos] & 255;
                        if (w == 32 || w == 9 || w == 10 || w == 13) {
                            pos = pos + 1;
                        } else {
                            break;
                        }
                    }
                } else {
                    pos = pos + 1;
                    ReadEscape(sb);
                }
                runStart = pos;
                continue;
            }
            pos = pos + 1;
        }
        Err("unterminated multi-line basic string");
        return "";
    }

    // 字面字符串 '...'：内容原样，无转义。
    string ReadLiteralString() {
        pos = pos + 1;
        int start = pos;
        while (pos < len) {
            int c = s[pos] & 255;
            if (c == 39) {  // '\''
                string t = s.Substring(start, pos - start);
                pos = pos + 1;
                return t;
            }
            if (c == 10) { Err("newline in literal string"); }
            pos = pos + 1;
        }
        Err("unterminated literal string");
        return "";
    }

    // 多行字面字符串 '''...'''：开界定符后的首个换行剥掉，内容原样。
    string ReadMultilineLiteral() {
        pos = pos + 3;
        if (CurB() == 10) { pos = pos + 1; }
        else if (CurB() == 13 && pos + 1 < len && (s[pos + 1] & 255) == 10) {
            pos = pos + 2;
        }
        int start = pos;
        while (pos < len) {
            if (Has("'''")) {
                if (pos + 3 < len && (s[pos + 3] & 255) == 39) {
                    pos = pos + 1;  // 内容里的 '
                    continue;
                }
                string t = s.Substring(start, pos - start);
                pos = pos + 3;
                return t;
            }
            pos = pos + 1;
        }
        Err("unterminated multi-line literal string");
        return "";
    }

    // 把 path 各段在 owner 下导航/创建（中间段必须是表），写入末段。
    // 同表内重复键（a=1\na=2）抛错——对齐表头查重行为与 TOML 规范。
    void SetValue(JsonValue owner, List<string> path, JsonValue v) {
        JsonValue t = owner;
        for (int i = 0; i < path.Count - 1; i = i + 1) {
            string seg = path[i];
            JsonValue nxt = t.Get(seg);
            if (nxt == null) {
                nxt = JsonValue.NewObject();
                int kidx = t.keys.Count;
                t.keys.Add(seg);
                t.vals.Add(nxt);
                if (t.keyIndex != null) { t.keyIndex[seg] = kidx; }
            } else if (!nxt.IsObject()) {
                Err("key '" + seg + "' is not a table");
            }
            t = nxt;
        }
        string last = path[path.Count - 1];
        if (t.Has(last)) { Err("key defined twice: " + last); }
        int lidx = t.keys.Count;
        t.keys.Add(last);
        t.vals.Add(v);
        if (t.keyIndex != null) { t.keyIndex[last] = lidx; }
    }

    // 表头导航：中间段沿表走（遇数组取末元素——[[fruit]] 后的
    // [fruit.physical] 语义）；末段按表/表数组取或建。普通表头的
    // 重复定义查重在这里做：去重键带数组元素序号，不同元素下的
    // 同名子表互不冲突；表数组头（arrayTable）本身允许重复，不查。
    JsonValue NavigateHeader(List<string> path, bool arrayTable) {
        JsonValue t = root;
        StringBuilder kb = arrayTable ? null : new StringBuilder();
        for (int i = 0; i < path.Count - 1; i = i + 1) {
            JsonValue nxt = t.Get(path[i]);
            if (nxt == null) {
                nxt = JsonValue.NewObject();
                t.Set(path[i], nxt);
            } else if (nxt.IsArray() && nxt.Count() > 0
                && nxt.At(nxt.Count() - 1).IsObject()) {
                int idx = nxt.Count() - 1;
                nxt = nxt.At(idx);  // 上一个表数组元素
                if (kb != null) {
                    kb.Append("\u0001");
                    kb.Append(path[i]);
                    kb.Append("#");
                    kb.Append(Convert.ToString(idx));
                }
                t = nxt;
                continue;
            } else if (!nxt.IsObject()) {
                Err("'" + path[i] + "' is not a table");
            }
            if (kb != null) {
                kb.Append("\u0001");
                kb.Append(path[i]);
            }
            t = nxt;
        }
        string last = path[path.Count - 1];
        JsonValue dest = t.Get(last);
        if (arrayTable) {
            if (dest == null) {
                dest = JsonValue.NewArray();
                int kidx = t.keys.Count;
                t.keys.Add(last);
                t.vals.Add(dest);
                if (t.keyIndex != null) { t.keyIndex[last] = kidx; }
            } else if (!dest.IsArray()) {
                Err("'" + last + "' is not an array of tables");
            }
            JsonValue elem = JsonValue.NewObject();
            dest.items.Add(elem);
            return elem;
        }
        if (dest == null) {
            dest = JsonValue.NewObject();
            int kidx = t.keys.Count;
            t.keys.Add(last);
            t.vals.Add(dest);
            if (t.keyIndex != null) { t.keyIndex[last] = kidx; }
        } else if (!dest.IsObject()) {
            Err("'" + last + "' is not a table");
        }
        // 无论新建还是复用都要登记：只登记复用分支会让首个定义漏记，
        // 第二次同名表头查不到重、第三次才报错。
        kb.Append("\u0001");
        kb.Append(last);
        string key = kb.ToString();
        if (headers.ContainsKey(key)) {
            Err("table defined twice: " + key);
        }
        headers[key] = true;
        return dest;
    }

    // 行尾收口：水平空白 + 可选注释，然后必须换行或 EOF。
    void EndOfLine(string what) {
        SkipH();
        if (CurB() == 35) {  // '#'
            int nl = NativeMemory.Find((nint)s, pos, 10, len - pos);
            pos = nl < 0 ? len : nl;
        }
        if (pos >= len) { return; }
        int c = CurB();
        if (c == 10) { pos = pos + 1; return; }
        if (c == 13) {
            pos = pos + 1;
            if (pos < len && (s[pos] & 255) == 10) { pos = pos + 1; }
            return;
        }
        Err("unexpected content after " + what);
    }

    void SkipWsNewlinesComments() {
        while (pos < len) {
            int c = s[pos] & 255;
            if (c == 32 || c == 9 || c == 10 || c == 13) {
                pos = pos + 1;
            } else if (c == 35) {  // '#'
                int nl = NativeMemory.Find((nint)s, pos, 10, len - pos);
                pos = nl < 0 ? len : nl;
            } else {
                return;
            }
        }
    }

    void SkipH() {
        while (pos < len) {
            int c = s[pos] & 255;
            if (c == 32 || c == 9) { pos = pos + 1; } else { return; }
        }
    }

    int CurB() {
        if (pos >= len) { return -1; }
        return s[pos] & 255;
    }

    bool Has(string lit) {
        int n = lit.Length;
        if (pos + n > len) { return false; }
        for (int i = 0; i < n; i = i + 1) {
            if ((s[pos + i] & 255) != (lit[i] & 255)) { return false; }
        }
        return true;
    }

    void ExpectWord(string word) {
        if (!Has(word)) { Err("invalid value"); }
        pos = pos + word.Length;
    }

    // 转义体：pos 指在 '\' 之后，读一个转义并追加进 sb。
    void ReadEscape(StringBuilder sb) {
        if (pos >= len) { Err("unterminated escape"); }
        int c = s[pos] & 255;
        pos = pos + 1;
        if (c == 98) { sb.Append(Encoding.CharFromCode(8)); }  // \b
        else if (c == 116) { sb.Append("\t"); }  // \t
        else if (c == 110) { sb.Append("\n"); }  // \n
        else if (c == 102) { sb.Append(Encoding.CharFromCode(12)); }  // \f
        else if (c == 114) { sb.Append("\r"); }  // \r
        else if (c == 34) { sb.Append("\""); }
        else if (c == 92) { sb.Append("\\"); }
        else if (c == 117 || c == 85) {  // \u \U
            int digits = c == 117 ? 4 : 8;
            if (pos + digits > len) { Err("truncated \\u escape"); }
            int cp = 0;
            for (int i = 0; i < digits; i = i + 1) {
                int d = TomlParser.HexVal(s[pos + i] & 255);
                if (d < 0) { Err("bad hex digit in \\u escape"); }
                cp = cp * 16 + d;
            }
            pos = pos + digits;
            // 控制字符（U+0000..U+001F）转义全拒：TOML 规范本就禁止
            // 控制字符出现在键/基本串中；且 \u0001 会与表头查重键的
            // 段分隔符（字节 1）碰撞，伪造"表头重复定义"。
            if (cp < 32 || (cp >= 55296 && cp <= 57343)) {
                Err("escape cannot be represented (control characters not allowed)");
            }
            sb.Append(Encoding.Utf8FromCodePoint(cp));
        } else {
            Err("unknown escape \\" + s.Substring(pos - 1, 1));
        }
    }

    void Err(string msg) {
        int line = 1;
        int col = 1;
        int stop = pos < len ? pos : len;
        for (int i = 0; i < stop; i = i + 1) {
            if ((s[i] & 255) == 10) {
                line = line + 1;
                col = 1;
            } else {
                col = col + 1;
            }
        }
        throw new TomlException(msg + " at line "
            + Convert.ToString(line) + ", column " + Convert.ToString(col));
    }

    // ---- token 分类与进制解析（静态助手）----

    // 是否日期/时间形态：YYYY-MM-DD 起头，或 HH:MM 起头。
    private static bool DateLike(string t) {
        if (t.Length >= 10 && TomlParser.Digits(t, 0, 4)
            && (t[4] & 255) == 45 && TomlParser.Digits(t, 5, 2)
            && (t[7] & 255) == 45 && TomlParser.Digits(t, 8, 2)) {
            return true;
        }
        if (t.Length >= 5 && TomlParser.Digits(t, 0, 2)
            && (t[2] & 255) == 58 && TomlParser.Digits(t, 3, 2)) {
            return true;
        }
        return false;
    }

    private static bool Digits(string t, int from, int n) {
        if (from + n > t.Length) { return false; }
        for (int i = 0; i < n; i = i + 1) {
            int c = t[from + i] & 255;
            if (c < 48 || c > 57) { return false; }
        }
        return true;
    }

    // 整数形态：[+-]? (0x|0o|0b)? 数字串（下划线已剥）。
    private static bool IntShape(string t) {
        int i = 0;
        if (i < t.Length && ((t[i] & 255) == 43 || (t[i] & 255) == 45)) {
            i = i + 1;
        }
        int rest = t.Length - i;
        if (rest == 0) { return false; }
        if (rest > 2 && (t[i] & 255) == 48) {
            int k = (t[i + 1] & 255);
            if (k == 120 || k == 111 || k == 98) { return true; }  // 0x 0o 0b
        }
        for (int j = i; j < t.Length; j = j + 1) {
            int c = t[j] & 255;
            if (c < 48 || c > 57) { return false; }
        }
        return true;
    }

    // 按前缀进制解析整数（0x 十六进制、0o 八进制、0b 二进制、其余
    // 十进制）。溢出置 intOverflow 哨兵并返回 0；-2^63 的补码边界
    // 单独识别（幅值 2^63 比正侧上限多 1，先于常规累加撞线）。
    long ParseIntBase(string t) {
        int i = 0;
        bool neg = false;
        if (i < t.Length && ((t[i] & 255) == 43 || (t[i] & 255) == 45)) {
            neg = (t[i] & 255) == 45;
            i = i + 1;
        }
        int baseN = 10;
        if (i + 1 < t.Length && (t[i] & 255) == 48) {
            int k = t[i + 1] & 255;
            if (k == 120) { baseN = 16; i = i + 2; }
            else if (k == 111) { baseN = 8; i = i + 2; }
            else if (k == 98) { baseN = 2; i = i + 2; }
        }
        if (i >= t.Length) { return 0; }
        if (neg && baseN == 10 && t.Substring(i, t.Length - i) == "9223372036854775808") {
            return long.MinValue;
        }
        long acc = 0;
        while (i < t.Length) {
            int d = TomlParser.HexVal(t[i] & 255);
            if (d < 0 || d >= baseN) {
                this.intBadDigit = true;  // 0xGG / 0b12：置哨兵让调用方抛
                return 0;
            }
            if (acc > (TomlParser.MaxLong - d) / baseN) {
                this.intOverflow = true;
                return 0;
            }
            acc = acc * baseN + d;
            i = i + 1;
        }
        return neg ? -acc : acc;
    }

    // TOML 浮点形态（严格版）：[+-]? 前导数字 [ '.' 数字+ ] [ ('e'|'E')
    // [+-]? 数字+ ]，整段吃完。ReadNumberOrDatetime 用它把关后才交给
    // DoubleOf 求值。
    private static bool FloatShapeStrict(string t) {
        int i = 0;
        int n = t.Length;
        if (i < n && ((t[i] & 255) == 43 || (t[i] & 255) == 45)) { i = i + 1; }
        int digits = 0;
        while (i < n && (t[i] & 255) >= 48 && (t[i] & 255) <= 57) {
            i = i + 1;
            digits = digits + 1;
        }
        if (digits == 0) { return false; }
        if (i < n && (t[i] & 255) == 46) {  // '.'
            i = i + 1;
            int frac = 0;
            while (i < n && (t[i] & 255) >= 48 && (t[i] & 255) <= 57) {
                i = i + 1;
                frac = frac + 1;
            }
            if (frac == 0) { return false; }
        }
        if (i < n && ((t[i] & 255) == 101 || (t[i] & 255) == 69)) {  // e/E
            i = i + 1;
            if (i < n && ((t[i] & 255) == 43 || (t[i] & 255) == 45)) { i = i + 1; }
            int exp = 0;
            while (i < n && (t[i] & 255) >= 48 && (t[i] & 255) <= 57) {
                i = i + 1;
                exp = exp + 1;
            }
            if (exp == 0) { return false; }
        }
        return i == n;
    }

    private static string Strip(string t, string cut) {
        StringBuilder sb = null;
        int start = 0;
        int n = t.Length;
        int m = cut.Length;
        for (int i = 0; i < n; i = i + 1) {
            int ch = t[i] & 255;
            bool hit = false;
            for (int j = 0; j < m; j = j + 1) {
                if (ch == (cut[j] & 255)) { hit = true; break; }
            }
            if (hit) {
                if (sb == null) { sb = new StringBuilder(); }
                if (i > start) { sb.Append(t.Substring(start, i - start)); }
                start = i + 1;
            }
        }
        if (sb == null) { return t; }
        if (n > start) { sb.Append(t.Substring(start, n - start)); }
        return sb.ToString();
    }

    private static int HexVal(int c) {
        if (c >= 48 && c <= 57) { return c - 48; }
        if (c >= 97 && c <= 102) { return c - 87; }
        if (c >= 65 && c <= 70) { return c - 55; }
        return -1;
    }

    // 反斜杠后是否跟"到行尾只有空白"（行拼接形态）。
    private static bool LineBackslash(string s, int pos, int len) {
        int i = pos + 1;
        while (i < len) {
            int c = s[i] & 255;
            if (c == 32 || c == 9) {
                i = i + 1;
                continue;
            }
            return c == 10 || c == 13;
        }
        return false;
    }

    private static string JoinPath(List<string> path) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < path.Count; i = i + 1) {
            if (i > 0) { sb.Append("\u0001"); }
            sb.Append(path[i]);
        }
        return sb.ToString();
    }
}
