using System;
using System.IO;
using System.Json;
using System.Text;

namespace Formats.Toml;

// TOML 门面：Parse 解析为 JsonValue 值树（表→object、数组→array、日期时间按原文存 string），
// ToToml 序列化回文本（支持语义往返；不含 null，遇 null 抛 TomlException）。
public class Toml {
    // 嵌套深度上限（写侧防环；解析侧同值在 TomlParser）。
    public static int MaxDepth = 512;

    // 解析 TOML 文本；格式非法抛 TomlException（带行列号）。
    public static JsonValue Parse(string src) {
        return TomlParser.Parse(src);
    }

    // 读取并解析文件；文件异常按 IO 异常抛，内容非法抛 TomlException。
    public static JsonValue Load(string path) {
        return Toml.Parse(File.ReadAllText(path));
    }

    // 把值树序列化为 TOML 文本；根须为表，含 null 或深度超限抛 TomlException。
    public static string ToToml(JsonValue root) {
        if (root == null || !root.IsObject()) {
            throw new TomlException("ToToml: root must be a table");
        }
        StringBuilder sb = new StringBuilder(4096);
        byte[] numBuf = new byte[24];
        Toml.WriteTable(sb, root, new List<string>(), 0, numBuf);
        return sb.ToString();
    }

    // 以 TOML 文本写文件。
    public static void Save(string path, JsonValue root) {
        File.WriteAllText(path, Toml.ToToml(root));
    }

    // 零字符串分配写入十进制 64 位整数（复用 24 字节暂存缓冲 + StringView 冲刷）。
    private static void AppendLong(StringBuilder sb, long v, byte[] numBuf) {
        if (v == 0L) { sb.Append("0"); return; }
        if (v == -9223372036854775807L - 1L) { sb.Append("-9223372036854775808"); return; }
        bool neg = v < 0L;
        long u = neg ? -v : v;
        int p = 24;
        while (u > 0L) {
            p = p - 1;
            numBuf[p] = (byte)(48 + (int)(u % 10L));
            u = u / 10L;
        }
        if (neg) {
            p = p - 1;
            numBuf[p] = 45;
        }
        sb.Append(new StringView((nint)numBuf + (nint)p, 24 - p));
    }

    // 一张表：简单键（标量/数组/空表行内）在前，子表头在后。depth
    // 是子表嵌套深度（环/程序构造的深树在 MaxDepth 处抛）。
    private static void WriteTable(StringBuilder sb, JsonValue table, List<string> path, int depth, byte[] numBuf) {
        if (depth > Toml.MaxDepth) {
            throw new TomlException("ToToml: nesting too deep (cycle?)");
        }
        int count = table.Count();
        bool hasSub = false;
        for (int i = 0; i < count; i = i + 1) {
            JsonValue v = table.ValAt(i);
            if (v == null) { continue; }
            if (v.IsObject() && v.Count() > 0) { hasSub = true; continue; }
            if (v.IsArray() && Toml.AllObjects(v)) { hasSub = true; continue; }  // 走表数组头
            Toml.WriteKey(sb, table.KeyAt(i));
            sb.Append(" = ");
            Toml.WriteValue(sb, v, depth + 1, numBuf);
            sb.Append("\n");
        }
        if (!hasSub) { return; }
        for (int i = 0; i < count; i = i + 1) {
            JsonValue v = table.ValAt(i);
            if (v == null) { continue; }
            if (v.IsObject() && v.Count() > 0) {
                path.Add(table.KeyAt(i));
                Toml.WriteSubTable(sb, path, v, false, depth, numBuf);
                path.RemoveAt(path.Count - 1);
                continue;
            }
            if (v.IsArray() && Toml.AllObjects(v)) {
                path.Add(table.KeyAt(i));
                int arrLen = v.Count();
                for (int j = 0; j < arrLen; j = j + 1) {
                    Toml.WriteSubTable(sb, path, v.At(j), true, depth, numBuf);
                }
                path.RemoveAt(path.Count - 1);
            }
        }
    }

    private static void WriteSubTable(StringBuilder sb, List<string> sub, JsonValue child, bool arrayTable, int depth, byte[] numBuf) {
        Toml.Separate(sb);
        Toml.WriteHeader(sb, sub, arrayTable);
        sb.Append("\n");
        Toml.WriteTable(sb, child, sub, depth + 1, numBuf);
    }

    // 值编码：null 非法，标量/数组/行内表全部行内呈现（嵌套对象
    // 在数组里落成行内表，这是它们在 TOML 里唯一的值形态）。
    private static void WriteValue(StringBuilder sb, JsonValue v, int depth, byte[] numBuf) {
        if (depth > Toml.MaxDepth) {
            throw new TomlException("ToToml: nesting too deep (cycle?)");
        }
        if (v == null || v.IsNull()) {
            throw new TomlException("ToToml: TOML has no null value");
        }
        if (v.IsBool()) {
            sb.Append(v.AsBool(false) ? "true" : "false");
            return;
        }
        if (v.IsNumber()) {
            if (v.IsInt()) {
                Toml.AppendLong(sb, v.AsLong(0), numBuf);
            } else {
                sb.Append(JsonValue.NumText(v));
            }
            return;
        }
        if (v.IsString()) {
            Toml.EncodeString(sb, v.AsString(""));
            return;
        }
        if (v.IsArray()) {
            sb.Append("[");
            int arrLen = v.Count();
            for (int i = 0; i < arrLen; i = i + 1) {
                if (i > 0) { sb.Append(", "); }
                Toml.WriteValue(sb, v.At(i), depth + 1, numBuf);
            }
            sb.Append("]");
            return;
        }
        // 行内表；空表紧凑写成 {}，非空才加内侧空格。
        int objLen = v.Count();
        if (objLen == 0) { sb.Append("{}"); return; }
        sb.Append("{ ");
        for (int i = 0; i < objLen; i = i + 1) {
            if (i > 0) { sb.Append(", "); }
            Toml.WriteKey(sb, v.KeyAt(i));
            sb.Append(" = ");
            Toml.WriteValue(sb, v.ValAt(i), depth + 1, numBuf);
        }
        sb.Append(" }");
    }

    // 表头文本直写：[a.b] 或 [[a.b]]。
    private static void WriteHeader(StringBuilder sb, List<string> path, bool arrayTable) {
        sb.Append(arrayTable ? "[[" : "[");
        for (int i = 0; i < path.Count; i = i + 1) {
            if (i > 0) { sb.Append("."); }
            Toml.WriteKey(sb, path[i]);
        }
        sb.Append(arrayTable ? "]]" : "]");
    }

    // 键编码直写：裸键 [A-Za-z0-9_-]+ 直写，其余加引号。
    private static void WriteKey(StringBuilder sb, string key) {
        if (key == null) { key = ""; }
        int n = key.Length;
        bool bare = n > 0;
        for (int i = 0; bare && i < n; i = i + 1) {
            int c = key[i] & 255;
            bool ok = (c >= 97 && c <= 122) || (c >= 65 && c <= 90)
                || (c >= 48 && c <= 57) || c == 95 || c == 45;
            if (!ok) { bare = false; }
        }
        if (bare) { sb.Append(key); return; }
        Toml.EncodeString(sb, key);
    }

    // 基本字符串编码：\ " 与控制字符转义，非 ASCII 原样（UTF-8）；Span<byte> 快扫 + StringView 冲刷。
    private static void EncodeString(StringBuilder sb, string t) {
        sb.Append("\"");
        int from = 0;
        int n = t.Length;
        nint tp = (nint)t;
        Span<byte> buf = new Span<byte>(tp, n);
        for (int i = 0; i < n; i = i + 1) {
            int c = buf[i] & 255;
            if (c > 92 && c != 127) { continue; }
            string rep = null;
            if (c == 34) { rep = "\\\""; }
            else if (c == 92) { rep = "\\\\"; }
            else if (c < 32) {
                if (c == 8) { rep = "\\b"; }
                else if (c == 9) { rep = "\\t"; }
                else if (c == 10) { rep = "\\n"; }
                else if (c == 12) { rep = "\\f"; }
                else if (c == 13) { rep = "\\r"; }
                else { rep = "\\u00" + Toml.Hex2(c); }
            } else if (c == 127) {
                rep = "\\u007F";
            }
            if (rep != null) {
                if (i > from) { sb.Append(new StringView(tp + (nint)from, i - from)); }
                sb.Append(rep);
                from = i + 1;
            }
        }
        if (from == 0) {
            sb.Append(t);
        } else if (from < n) {
            sb.Append(new StringView(tp + (nint)from, n - from));
        }
        sb.Append("\"");
    }

    private static void Separate(StringBuilder sb) {
        if (sb.Length > 0) { sb.Append("\n"); }
    }

    private static List<string> ExtendPath(List<string> path, string key) {
        List<string> sub = new List<string>();
        for (int i = 0; i < path.Count; i = i + 1) { sub.Add(path[i]); }
        sub.Add(key);
        return sub;
    }

    private static bool AllObjects(JsonValue arr) {
        if (arr == null) { return false; }
        int n = arr.Count();
        for (int i = 0; i < n; i = i + 1) {
            JsonValue elem = arr.At(i);
            if (elem == null || !elem.IsObject()) { return false; }
        }
        return n > 0;
    }

    private static string Hex2(int c) {
        int h = (c >> 4) & 15;
        int l = c & 15;
        byte[] buf = new byte[2];
        buf[0] = (byte)(h < 10 ? h + 48 : h + 55);
        buf[1] = (byte)(l < 10 ? l + 48 : l + 55);
        return buf.ToStr(0, 2);
    }
}
