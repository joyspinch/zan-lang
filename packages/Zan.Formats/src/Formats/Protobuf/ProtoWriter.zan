using System;

namespace Formats.Protobuf;

public class ProtoWriter {
    // 64 位长度校验上限（512MB），防止 int 算术回绕写穿或死循环。
    public static long MaxTotalBytes = 536870912;

    byte[] buf;
    int len;
    List<int> openFields;
    List<int> openMarks;

    public ProtoWriter() {
        buf = new byte[64];
        len = 0;
        openFields = new List<int>();
        openMarks = new List<int>();
    }

    public int Length() { return len; }

    void EnsureRoom(int extra) {
        long need = (long)len + (long)extra;
        if (need > ProtoWriter.MaxTotalBytes) {
            throw new ProtoException("encoded size " + Convert.ToString(need) + " exceeds 512MB write limit");
        }
        if (need <= buf.Length) { return; }
        long c = (long)buf.Length * 2;
        if (c < 16) { c = 16; }
        while (c < need) { c = c * 2; }
        byte[] grown = new byte[(int)c];
        NativeMemory.Copy((nint)grown, (nint)buf, len);
        buf = grown;
    }

    public static long Tag(int field, int wire) {
        if (field < 1 || field > 536870911) {
            throw new ProtoException("field number out of range: " + Convert.ToString(field));
        }
        return ((long)field << 3) | (long)wire;
    }

    public void RawU8(int b) {
        EnsureRoom(1);
        buf[len] = (byte)b;
        len = len + 1;
    }

    static int VarintSize(long v) {
        int n = 1;
        long x = v;
        while ((x & -128) != 0) {
            n = n + 1;
            x = (x >> 7) & 144115188075855871;  // 清算术右移符号扩展位
        }
        return n;
    }

    int WriteVarintAt(int at, long v) {
        long x = v;
        while ((x & -128) != 0) {
            buf[at] = (byte)((x & 127) | 128);
            at = at + 1;
            x = (x >> 7) & 144115188075855871;
        }
        buf[at] = (byte)(x & 127);
        return at + 1;
    }

    public void RawVarint(long v) {
        if (v >= 0 && v < 128) {
            EnsureRoom(1);
            buf[len] = (byte)v;
            len = len + 1;
            return;
        }
        EnsureRoom(10);
        len = WriteVarintAt(len, v);
    }

    public void RawFixed64(long v) {
        EnsureRoom(8);
        buf[len] = (byte)v;
        buf[len + 1] = (byte)(v >> 8);
        buf[len + 2] = (byte)(v >> 16);
        buf[len + 3] = (byte)(v >> 24);
        buf[len + 4] = (byte)(v >> 32);
        buf[len + 5] = (byte)(v >> 40);
        buf[len + 6] = (byte)(v >> 48);
        buf[len + 7] = (byte)(v >> 56);
        len = len + 8;
    }

    public void RawFixed32(long v) {
        EnsureRoom(4);
        buf[len] = (byte)v;
        buf[len + 1] = (byte)(v >> 8);
        buf[len + 2] = (byte)(v >> 16);
        buf[len + 3] = (byte)(v >> 24);
        len = len + 4;
    }

    public void WriteInt32(int field, int v) { WriteVarint(field, v); }
    public void WriteInt64(int field, long v) { WriteVarint(field, v); }
    public void WriteUint32(int field, long v) { WriteVarint(field, v); }
    public void WriteUint64(int field, long v) { WriteVarint(field, v); }
    public void WriteBool(int field, bool v) { WriteVarint(field, v ? 1 : 0); }
    public void WriteEnum(int field, int v) { WriteVarint(field, v); }

    public void WriteVarint(int field, long v) {
        RawVarint(Tag(field, 0));
        RawVarint(v);
    }

    public void WriteSint32(int field, int v) {
        WriteVarint(field, (long)((v << 1) ^ (v >> 31)) & 4294967295);
    }

    public void WriteSint64(int field, long v) {
        WriteVarint(field, (v << 1) ^ (v >> 63));
    }

    public void WriteString(int field, string s) {
        if (s == null) { throw new ProtoException("null string payload"); }
        int n = s.Length;
        RawVarint(Tag(field, 2));
        RawVarint(n);
        if (n > 0) {
            EnsureRoom(n);
            NativeMemory.PutString((nint)buf, len, s, n);
            len = len + n;
        }
    }

    public void WriteBytes(int field, byte[] v) { WriteBytesField(field, v, 0, v.Length); }
    public void WriteBytes(int field, byte[] v, int offset, int count) { WriteBytesField(field, v, offset, count); }
    public void WriteMessage(int field, byte[] payload) { WriteBytesField(field, payload, 0, payload.Length); }

    void WriteBytesField(int field, byte[] v, int offset, int count) {
        if (v == null) { throw new ProtoException("null bytes payload"); }
        if (offset < 0 || count < 0 || count > v.Length - offset) {
            throw new ProtoException("bytes slice out of range");
        }
        RawVarint(Tag(field, 2));
        RawVarint(count);
        EnsureRoom(count);
        NativeMemory.Copy((nint)buf + len, (nint)v + offset, count);
        len = len + count;
    }

    public void WriteFixed64(int field, long v) {
        RawVarint(Tag(field, 1));
        RawFixed64(v);
    }

    public void WriteFixed32(int field, long v) {
        RawVarint(Tag(field, 5));
        RawFixed32(v);
    }

    public void WriteDouble(int field, double v) { WriteFixed64(field, DoubleBits(v)); }

    public int BeginMessage(int field) {
        Tag(field, 2);
        openFields.Add(field);
        openMarks.Add(len);
        return len;
    }

    public void EndMessage() {
        int n = openFields.Count;
        if (n == 0) { throw new ProtoException("EndMessage without BeginMessage"); }
        int field = openFields[n - 1];
        int mark = openMarks[n - 1];
        openFields.RemoveAt(n - 1);
        openMarks.RemoveAt(n - 1);
        int payload = len - mark;
        long tag = Tag(field, 2);
        int header = ProtoWriter.VarintSize(tag) + ProtoWriter.VarintSize(payload);
        EnsureRoom(header);
        NativeMemory.Copy((nint)buf + mark + header, (nint)buf + mark, payload);
        int at = WriteVarintAt(mark, tag);
        WriteVarintAt(at, payload);
        len = len + header;
    }

    public byte[] ToBytes() {
        byte[] out2 = new byte[len];
        NativeMemory.Copy((nint)out2, (nint)buf, len);
        return out2;
    }

    public void Reset() { len = 0; }
    public static long DoubleBits(double v) { return NativeMemory.AsI64(v); }
}
