using System;
using System.Text;
using System.Json;
namespace Formats.Yaml;

// YAML core 子集解析器：按行游标递归下降。块映射/块序列（含
// `- key: v` 压缩嵌套——用"虚拟行回灌"统一处理）、流式集合（可跨
// 行拼接）、四种标量（plain/单引/双引/块标量 | 与 > 含 chomping）、
// 锚点 &amp;x 与别名 *x、core schema 类型推断。映射保持出现顺序
// （JsonValue 本身有序）。多文档、标签、合并键不支持（明确报错或
// 按普通键，见 README）。
public class YamlParser {
    // 预分配空白池，用于块标量相对缩进的零临时串输出。
    private static string SpacePool = "                                ";

    // 扁平词法行三列存储（零 YamlLine 堆对象分配）。
    List<int> lineIndents;
    List<string> lineTexts;
    List<int> lineNos;
    Dict<string, JsonValue> anchors;
    string[] keyCache;
    int cur;
    int lineCount;
    int lastLineNo;  // 刚消费行的行号（cur 推进后报错用）

    // 推进游标：先记行号再前进，之后的报错引用 lastLineNo——
    // 直接写 lineNos[cur] 会越界（键在最后一行时 cur == lineCount）。
    void Advance() {
        lastLineNo = lineNos[cur];
        cur = cur + 1;
    }

    // 构造并做行切分与前导处理（BOM/指令/前导注释/一个 --- 起始符）。
    public YamlParser(string src) {
        lineIndents = new List<int>();
        lineTexts = new List<string>();
        lineNos = new List<int>();
        anchors = new Dict<string, JsonValue>();
        keyCache = null;
        // BOM 是编码标记不是内容：文件路径已由 File.ReadAllText 剥过，
        // 网络/内嵌文本（Windows 工具常带 EF BB BF）在这里兜底，不剥
        // 首键会带上三个隐形字节。
        if (src.Length >= 3 && (src[0] & 255) == 239 && (src[1] & 255) == 187
            && (src[2] & 255) == 191) {
            src = src.Substring(3);
        }
        SplitLines(src);
        SkipPrologue();
    }

    void SplitLines(string src) {
        int lineNo = 1;
        int n = src.Length;
        int estLines = (n >> 4) + 8;
        lineIndents.Reserve(estLines);
        lineTexts.Reserve(estLines);
        lineNos.Reserve(estLines);
        nint sp = (nint)src;
        bool hasCr = n > 0 && NativeMemory.Find(sp, 0, 13, n) >= 0;
        if (!hasCr) {
            int lineStart = 0;
            while (lineStart <= n) {
                int nl = lineStart < n ? NativeMemory.Find(sp, lineStart, 10, n - lineStart) : -1;
                int lineEnd = nl < 0 ? n : nl;
                PushLineSlice(src, sp, lineStart, lineEnd, lineNo);
                lineNo = lineNo + 1;
                if (nl < 0) { break; }
                lineStart = nl + 1;
            }
            lineCount = lineTexts.Count;
            return;
        }
        int lineStart2 = 0;
        int i = 0;
        while (i <= n) {
            int c = i < n ? (src[i] & 255) : 10;
            if (c == 13 || c == 10) {
                PushLineSlice(src, sp, lineStart2, i, lineNo);
                lineNo = lineNo + 1;
                i = i + 1;
                if (c == 13 && i < n && (src[i] & 255) == 10) { i = i + 1; }
                lineStart2 = i;
            } else {
                i = i + 1;
            }
        }
        lineCount = lineTexts.Count;
    }

    void PushLineSlice(string src, nint sp, int lineStart, int lineEnd, int lineNo) {
        int ind = lineStart;
        while (ind < lineEnd && (src[ind] & 255) == 32) { ind = ind + 1; }
        if (ind == lineEnd) {
            lineIndents.Add(ind - lineStart);
            lineTexts.Add("");
            lineNos.Add(lineNo);
            return;
        }
        if ((src[ind] & 255) == 9) {
            int k = ind + 1;
            while (k < lineEnd) {
                int c = src[k] & 255;
                if (c != 32 && c != 9) {
                    throw new YamlException("tab indentation is not allowed (line "
                        + Convert.ToString(lineNo) + ")");
                }
                k = k + 1;
            }
        }
        lineIndents.Add(ind - lineStart);
        lineTexts.Add(NativeMemory.GetString(sp, ind, lineEnd - ind));
        lineNos.Add(lineNo);
    }

    // 前导：指令行（%）、注释、空行，以及一个 --- 起始符（带内联
    // 内容时回灌为普通行）。
    void SkipPrologue() {
        while (cur < lineCount) {
            string t = lineTexts[cur];
            if (t.Length == 0 || t[0] == 35 || t[0] == 37) {  // 空/#/%
                cur = cur + 1;
                continue;
            }
            if (t == "---") { cur = cur + 1; continue; }
            if (t.Length >= 4 && t[0] == 45 && t[1] == 45 && t[2] == 45
                && t[3] == 32) {  // "--- x"
                lineIndents[cur] = lineIndents[cur] + 4;
                lineTexts[cur] = t.Substring(4);
                continue;
            }
            break;
        }
    }

    // ===== 主入口 =====

    // 解析单个文档；文件里出现第二个文档（再次 ---）即报错。
    public JsonValue ParseDocument() {
        JsonValue v = ParseBlock(0, 0);
        SkipIgnorable();
        if (cur < lineCount) {
            string t = lineTexts[cur];
            if (t == "---" || (t.Length >= 4 && t[0] == 45 && t[1] == 45
                && t[2] == 45 && t[3] == 32)) {
                throw new YamlException("multi-document input is not supported"
                    + " (line " + Convert.ToString(lineNos[cur]) + ")");
            }
            if (t == "...") { return v; }
            throw new YamlException("unexpected content after document (line "
                + Convert.ToString(lineNos[cur]) + ")");
        }
        return v;
    }

    // 跳过空行与纯注释行；`...` 文档结束符停在这里由调用方判。
    void SkipIgnorable() {
        while (cur < lineCount) {
            string t = lineTexts[cur];
            if (t.Length == 0 || t[0] == 35) { cur = cur + 1; }
            else { break; }
        }
    }

    bool AtDocMarker() {
        if (cur >= lineCount) { return true; }
        string t = lineTexts[cur];
        if (t.Length != 3) { return false; }
        return t == "..." || t == "---";
    }

    // 块节点：序列、映射或裸标量节点（minIndent 是本节点内容允许的
    // 最小缩进）。内容缺席返回 null。depth 是块嵌套深度（ParseBlock
    // ↔ ParseMap/ParseSeq 互递归每层 +1），与 FlowValue 的 512 上限
    // 对齐——无上限的恶意缩进输入会先于一切报错栈溢出。
    JsonValue ParseBlock(int minIndent, int depth) {
        SkipIgnorable();
        if (AtDocMarker()) { return null; }
        if (cur >= lineCount) { return null; }
        int curInd = lineIndents[cur];
        if (curInd < minIndent) { return null; }
        if (depth > 512) {
            throw new YamlException("block nesting too deep (line "
                + Convert.ToString(lineNos[cur]) + ")");
        }
        string t = lineTexts[cur];
        if (t == "-" || (t.Length >= 2 && t[0] == 45 && t[1] == 32)) {
            return ParseSeq(curInd, depth);
        }
        if (FindKeyColon(t) >= 0) { return ParseMap(curInd, depth); }
        return ParseBareNode(depth);
    }

    // ===== 块映射 =====

    JsonValue ParseMap(int indent, int depth) {
        JsonValue obj = JsonValue.NewObject();
        while (true) {
            SkipIgnorable();
            if (AtDocMarker()) { break; }
            if (cur >= lineCount) { break; }
            int curInd = lineIndents[cur];
            if (curInd != indent) {
                if (curInd < indent) { break; }
                throw new YamlException("bad indentation in mapping (line "
                    + Convert.ToString(lineNos[cur]) + ")");
            }
            string t = lineTexts[cur];
            int ci = FindKeyColon(t);
            if (ci < 0) {
                throw new YamlException("expected 'key:' in mapping (line "
                    + Convert.ToString(lineNos[cur]) + ")");
            }
            int ke = ci;
            while (ke > 0 && (t[ke - 1] & 255) == 32) { ke = ke - 1; }
            string key;
            int kc0 = ke > 0 ? (t[0] & 255) : 0;
            if (ke >= 2 && (kc0 == 34 || kc0 == 39)) {
                key = DecodeKey(NativeMemory.GetString((nint)t, 0, ke));
            } else {
                key = InternKey(t, ke);
            }
            int vstart = ci + 1;
            int tl = t.Length;
            while (vstart < tl && (t[vstart] & 255) == 32) { vstart = vstart + 1; }
            Advance();
            string anchor = "";
            JsonValue val;
            int vc0 = vstart < tl ? (t[vstart] & 255) : 0;
            if (vc0 == 38) {  // &anchor
                int sp = vstart + 1;
                while (sp < tl && (t[sp] & 255) != 32) { sp = sp + 1; }
                anchor = NativeMemory.GetString((nint)t, vstart + 1, sp - (vstart + 1));
                while (sp < tl && (t[sp] & 255) == 32) { sp = sp + 1; }
                vstart = sp;
                vc0 = vstart < tl ? (t[vstart] & 255) : 0;
            }
            if (vstart >= tl || vc0 == 35) {
                val = ParseBlock(indent + 1, depth + 1);
                if (val == null) {
                    // 序列子节点允许与键同缩进（key:\n- a）。
                    if (!AtDocMarker() && cur < lineCount
                        && lineIndents[cur] == indent && IsSeqLine(lineTexts[cur])) {
                        val = ParseSeq(indent, depth + 1);
                    } else {
                        val = JsonValue.NewNull();
                    }
                }
            } else if (vc0 == 124 || vc0 == 62) {
                val = ReadBlockScalarSlice(t, vstart, tl, indent);  // | 或 >
            } else if (vc0 == 42) {  // *alias
                val = ResolveAlias(NativeMemory.GetString((nint)t, vstart, tl - vstart));
            } else if (vc0 == 91 || vc0 == 123) {  // [ 或 {
                val = ParseJoinedFlow(NativeMemory.GetString((nint)t, vstart, tl - vstart));
            } else if (vc0 == 34) {
                val = JsonValue.NewStr(DecodeDoubleQuotedSlice(t, vstart, tl));
            } else if (vc0 == 39) {
                val = JsonValue.NewStr(DecodeSingleQuotedSlice(t, vstart, tl));
            } else {
                val = ParsePlainSlice(t, vstart, tl);
            }
            if (anchor.Length > 0) { anchors[anchor] = val; }
            if (obj.Has(key)) {
                throw new YamlException("duplicate key '" + key + "' (line "
                    + Convert.ToString(lastLineNo) + ")");
            }
            int kidx = obj.keys.Count;
            obj.keys.Add(key);
            obj.vals.Add(val);
            if (obj.keyIndex != null) { obj.keyIndex[key] = kidx; }
        }
        return obj;
    }

    // ===== 块序列 =====

    JsonValue ParseSeq(int indent, int depth) {
        JsonValue arr = JsonValue.NewArray();
        List<JsonValue> items = arr.items;
        while (true) {
            SkipIgnorable();
            if (AtDocMarker()) { break; }
            if (cur >= lineCount) { break; }
            if (lineIndents[cur] != indent) { break; }
            if (depth > 512) {
                throw new YamlException("block nesting too deep (line "
                    + Convert.ToString(lineNos[cur]) + ")");
            }
            string t = lineTexts[cur];
            if (!IsSeqLine(t)) { break; }
            if (t.Length == 1) {  // "-" 单独一行
                Advance();
                JsonValue child = ParseBlock(indent + 1, depth + 1);
                if (child == null) { child = JsonValue.NewNull(); }
                items.Add(child);
                continue;
            }
            int sp = 1;
            int tl = t.Length;
            while (sp < tl && (t[sp] & 255) == 32) { sp = sp + 1; }
            string rest = sp < tl ? NativeMemory.GetString((nint)t, sp, tl - sp) : "";
            int contentCol = indent + sp;
            if (rest.Length == 0) {
                // "- "（短横后仅空格）等价 "-" 单独成行：null 项。
                // rest 为空串时取 rest[0] 会越界（运行时致命报告）。
                Advance();
                items.Add(JsonValue.NewNull());
                continue;
            }
            if (rest[0] == 124 || rest[0] == 62) {  // "- |" 块标量
                Advance();
                items.Add(ReadBlockScalar(rest, indent));
                continue;
            }
            // 压缩形式：把剩余内容回灌为 contentCol 列的虚拟行。
            lineIndents[cur] = contentCol;
            lineTexts[cur] = rest;
            JsonValue item = ParseBlock(contentCol, depth + 1);
            if (item == null) { item = JsonValue.NewNull(); }
            items.Add(item);
        }
        return arr;
    }

    // ===== 裸标量节点（根/序列压缩项） =====

    JsonValue ParseBareNode(int depth) {
        string t = lineTexts[cur];
        int indent = lineIndents[cur];
        Advance();
        if (t.Length > 0 && (t[0] == 124 || t[0] == 62)) {
            return ReadBlockScalar(t, indent - 1);
        }
        if (t.Length > 0 && t[0] == 42) { return ResolveAlias(t); }
        if (t.Length > 0 && (t[0] == 91 || t[0] == 123)) {
            return ParseJoinedFlow(t);
        }
        if (t.Length > 0 && t[0] == 38) {  // &a 裸锚点
            int sp = 1;
            int tl = t.Length;
            while (sp < tl && (t[sp] & 255) != 32) { sp = sp + 1; }
            string anchor = t.Substring(1, sp - 1);
            JsonValue v;
            if (sp >= tl) {
                v = ParseBlock(indent + 1, depth + 1);
                if (v == null) { v = JsonValue.NewNull(); }
            } else {
                v = ScalarNode(t.Substring(sp + 1));
            }
            anchors[anchor] = v;
            return v;
        }
        return ScalarNode(t);
    }

    // ===== 标量节点 =====

    // 值位置标量分派：双引/单引解码，plain 走类型推断。rest 已剥行
    // 首空格，这里再容忍锚点后多敲的空格。
    JsonValue ScalarNode(string rest) {
        int b = 0;
        int n = rest.Length;
        while (b < n && (rest[b] & 255) == 32) { b = b + 1; }
        if (b >= n) { return JsonValue.NewNull(); }
        string sub = b == 0 ? rest : rest.Substring(b);
        int c = sub[0] & 255;
        if (c == 34) { return JsonValue.NewStr(DecodeDoubleQuoted(sub)); }
        if (c == 39) { return JsonValue.NewStr(DecodeSingleQuoted(sub)); }
        return TypeScalar(StripComment(sub));
    }

    // ===== 锚点/别名 =====

    JsonValue ResolveAlias(string rest) {
        string trimmed = StripComment(rest);
        string name = trimmed.Substring(1);
        JsonValue found = null;
        if (!anchors.TryGetValue(name, out found)) {
            throw new YamlException("unknown alias '*" + name + "' (line "
                + Convert.ToString(lastLineNo) + ")");
        }
        return found;
    }

    // ===== 块标量（| 字面 / > 折叠，含 chomping 与显式缩进位） =====

    // 短映射键直映缓存（64 槽，FNV-1a 32 + 逐字节验证），对象序列复用键串零分配。
    string InternKey(string t, int klen) {
        if (klen <= 0) { return ""; }
        nint tp = (nint)t;
        if (klen > 32) { return NativeMemory.GetString(tp, 0, klen); }
        if (keyCache == null) { keyCache = new string[64]; }
        Span<byte> tb = new Span<byte>(tp, klen);
        uint h = 2166136261U;
        for (int i = 0; i < klen; i = i + 1) {
            h = (h ^ (uint)(tb[i] & 255)) * 16777619U;
        }
        int slot = (int)(h & 63U);
        string cached = keyCache[slot];
        if (cached != null && cached.Length == klen) {
            Span<byte> cb = new Span<byte>((nint)cached, klen);
            bool eq = true;
            for (int i = 0; i < klen; i = i + 1) {
                if (tb[i] != cb[i]) { eq = false; break; }
            }
            if (eq) { return cached; }
        }
        string fresh = NativeMemory.GetString(tp, 0, klen);
        keyCache[slot] = fresh;
        return fresh;
    }

    // 直接在行切片 [start, end) 上去行尾注释并解析 plain 标量（整数/布尔/null 零中间串分配）。
    JsonValue ParsePlainSlice(string t, int start, int end) {
        int n = end - start;
        if (n <= 0) { return JsonValue.NewNull(); }
        nint tp = (nint)t;
        // 剥除 " #" 行内注释
        if (n >= 2) {
            int pos = start + 1;
            while (pos < end) {
                int hit = NativeMemory.Find(tp, pos, 35, end - pos);
                if (hit < 0) { break; }
                if ((t[hit - 1] & 255) == 32) {
                    int e = hit;
                    while (e > start && (t[e - 1] & 255) == 32) { e = e - 1; }
                    end = e;
                    n = end - start;
                    break;
                }
                pos = hit + 1;
            }
        }
        if (n <= 0) { return JsonValue.NewNull(); }
        int c0 = t[start] & 255;
        // 高频无转义普通字符串直接切片返回，跳过 18 次关键字与数字探测。
        if (c0 != 126 && c0 != 110 && c0 != 78 && c0 != 116 && c0 != 84
            && c0 != 102 && c0 != 70 && c0 != 46 && c0 != 43 && c0 != 45
            && (c0 < 48 || c0 > 57)) {
            return JsonValue.NewStr(NativeMemory.GetString(tp, start, n));
        }
        // 快路径：常见小写 null / true / false / ~ 零串分配
        if (n == 1 && c0 == 126) { return JsonValue.NewNull(); }
        if (n == 4 && c0 == 110 && (t[start + 1] & 255) == 117
            && (t[start + 2] & 255) == 108 && (t[start + 3] & 255) == 108) {
            return JsonValue.NewNull();
        }
        if (n == 4 && c0 == 116 && (t[start + 1] & 255) == 114
            && (t[start + 2] & 255) == 117 && (t[start + 3] & 255) == 101) {
            return JsonValue.NewBool(true);
        }
        if (n == 5 && c0 == 102 && (t[start + 1] & 255) == 97
            && (t[start + 2] & 255) == 108 && (t[start + 3] & 255) == 115
            && (t[start + 4] & 255) == 101) {
            return JsonValue.NewBool(false);
        }
        // 快路径：整数（十进制/0x/0o）直接原地累加，零串分配
        if ((c0 >= 48 && c0 <= 57) || c0 == 45 || c0 == 43) {
            bool neg = c0 == 45;
            int i = (neg || c0 == 43) ? (start + 1) : start;
            if (i < end) {
                long v = 0;
                bool overflow = false;
                bool isInt = true;
                if (end > i + 2 && (t[i] & 255) == 48 && (t[i + 1] & 255) == 120) {
                    int k = i + 2;
                    while (k < end) {
                        int d = HexDigit(t[k] & 255);
                        if (d < 0) { isInt = false; break; }
                        if (v > 576460752303423487L) { overflow = true; }
                        v = (v << 4) + d;
                        k = k + 1;
                    }
                    if (isInt) {
                        if (overflow) { return JsonValue.NewStr(NativeMemory.GetString(tp, start, n)); }
                        return JsonValue.NewInt(neg ? (0 - v) : v);
                    }
                } else if (end > i + 2 && (t[i] & 255) == 48 && (t[i + 1] & 255) == 111) {
                    int k = i + 2;
                    while (k < end) {
                        int c = t[k] & 255;
                        if (c < 48 || c > 55) { isInt = false; break; }
                        if (v > 1152921504606846975L) { overflow = true; }
                        v = (v << 3) + (c - 48);
                        k = k + 1;
                    }
                    if (isInt) {
                        if (overflow) { return JsonValue.NewStr(NativeMemory.GetString(tp, start, n)); }
                        return JsonValue.NewInt(neg ? (0 - v) : v);
                    }
                } else {
                    int k = i;
                    while (k < end) {
                        int c = t[k] & 255;
                        if (c < 48 || c > 57) { isInt = false; break; }
                        if (v > 922337203685477579L) { overflow = true; }
                        v = v * 10 + (c - 48);
                        k = k + 1;
                    }
                    if (isInt) {
                        if (overflow) { return JsonValue.NewStr(NativeMemory.GetString(tp, start, n)); }
                        return JsonValue.NewInt(neg ? (0 - v) : v);
                    }
                }
            }
        }
        return TypeScalar(NativeMemory.GetString(tp, start, n));
    }

    // 块标量切片入口（免分配 header 子串）。
    JsonValue ReadBlockScalar(string header, int parentIndent) {
        return ReadBlockScalarSlice(header, 0, header.Length, parentIndent);
    }

    JsonValue ReadBlockScalarSlice(string header, int hStart, int hEnd, int parentIndent) {
        int style = header[hStart] & 255;  // 124=| 62=>
        int chomp = 0;  // 0 clip -1 strip 1 keep
        int explicitInd = 0;
        int hi = hStart + 1;
        while (hi < hEnd) {
            int c = header[hi] & 255;
            if (c == 45) { chomp = -1; }
            else if (c == 43) { chomp = 1; }
            else if (c >= 49 && c <= 57) { explicitInd = c - 48; }
            else if (c == 32) { break; }
            else if (c == 35) { break; }  // 注释
            else {
                throw new YamlException("bad block scalar header (line "
                    + Convert.ToString(lastLineNo) + ")");
            }
            hi = hi + 1;
        }
        // 单遍流式写入单一 StringBuilder：零 List<string> 与零逐行缩进 StringBuilder 分配。
        StringBuilder body = new StringBuilder(64);
        int blockIndent = 0;
        int trailingBlanks = 0;
        int emittedCount = 0;
        if (explicitInd > 0) { blockIndent = parentIndent + explicitInd; }
        nint spacePtr = (nint)YamlParser.SpacePool;
        while (cur < lineCount) {
            string raw = lineTexts[cur];
            int ind = lineIndents[cur];
            if (raw.Length == 0) {
                trailingBlanks = trailingBlanks + 1;
                cur = cur + 1;
                continue;
            }
            if (blockIndent == 0) {
                if (ind <= parentIndent) { break; }
                blockIndent = ind;
            }
            if (ind < blockIndent) { break; }
            int extra = ind - blockIndent;
            if (style == 124) {  // 字面：原样换行
                while (trailingBlanks > 0) {
                    if (emittedCount > 0) { body.Append("\n"); }
                    emittedCount = emittedCount + 1;
                    trailingBlanks = trailingBlanks - 1;
                }
                if (emittedCount > 0) { body.Append("\n"); }
                emittedCount = emittedCount + 1;
            } else {  // 折叠：单换行变空格
                if (body.Length > 0) {
                    if (trailingBlanks == 0) {
                        body.Append(" ");
                    } else {
                        for (int k = 0; k < trailingBlanks; k = k + 1) { body.Append("\n"); }
                    }
                }
                trailingBlanks = 0;
            }
            if (extra > 0) {
                int rem = extra;
                while (rem >= 32) {
                    body.Append(YamlParser.SpacePool);
                    rem = rem - 32;
                }
                if (rem > 0) { body.Append(new StringView(spacePtr, rem)); }
            }
            body.Append(raw);
            cur = cur + 1;
        }
        if (chomp == 0) {  // clip
            if (body.Length > 0) { body.Append("\n"); }
        } else if (chomp == 1) {  // keep
            if (body.Length > 0) { body.Append("\n"); }
            int k = 0;
            while (k < trailingBlanks) { body.Append("\n"); k = k + 1; }
        }  // strip：不动
        return JsonValue.NewStr(body.ToString());
    }

    // ===== 流式集合（可跨行拼接） =====

    JsonValue ParseJoinedFlow(string first) {
        // 括号余量增量维护：只扫每行新拼入的文本（quote 状态跨行
        // 带回，与重扫整段累积串等价），拼接走 StringBuilder——
        // 原"每行 acc = acc + ... + 重扫 acc"是 O(n²)。
        StringBuilder acc = new StringBuilder();
        acc.Append(first);
        int quote = 0;
        int depth = BracketDepthFrom(first, 0, ref quote);
        while (depth > 0) {
            if (cur >= lineCount) {
                throw new YamlException("unterminated flow collection (line "
                    + Convert.ToString(lastLineNo) + ")");
            }
            string t = lineTexts[cur];
            cur = cur + 1;
            if (t.Length == 0) { continue; }
            string part = StripComment(t);
            acc.Append(" ");
            acc.Append(part);
            depth = BracketDepthFrom(part, depth, ref quote);
        }
        string s = acc.ToString();
        int at = 0;
        JsonValue v = FlowValue(s, ref at, 0);
        return v;
    }

    // 括号余量（引号外的 [ { 计数）增量版：从 (depthIn, quoteIn)
    // 状态继续扫一段新拼入的文本，quote 状态经 ref 带回。<0 说明
    // 多余闭括号。整段重扫的旧写法见 ParseJoinedFlow 注释。
    int BracketDepthFrom(string s, int depthIn, ref int quoteIn) {
        int depth = depthIn;
        int quote = quoteIn;
        int i = 0;
        int n = s.Length;
        while (i < n) {
            int c = s[i] & 255;
            if (quote != 0) {
                if (c == 92 && quote == 34) { i = i + 1; }
                else if (c == quote) { quote = 0; }
            } else if (c == 34 || c == 39) { quote = c; }
            else if (c == 91 || c == 123) { depth = depth + 1; }
            else if (c == 93 || c == 125) { depth = depth - 1; }
            i = i + 1;
        }
        quoteIn = quote;
        return depth;
    }

    // 流式值解析：s[at] 起读一个完整值，结束位置写回 at。
    JsonValue FlowValue(string s, ref int at, int depth) {
        if (depth > 512) {
            throw new YamlException("flow nesting too deep");
        }
        SkipFlowSpace(s, ref at);
        if (at >= s.Length) { return JsonValue.NewNull(); }
        int c = s[at] & 255;
        if (c == 91) {  // [ 数组
            at = at + 1;
            JsonValue arr = JsonValue.NewArray();
            List<JsonValue> items = arr.items;
            while (true) {
                SkipFlowSpace(s, ref at);
                if (at >= s.Length) {
                    throw new YamlException("unterminated flow sequence");
                }
                if ((s[at] & 255) == 93) { at = at + 1; break; }
                items.Add(FlowValue(s, ref at, depth + 1));
                SkipFlowSpace(s, ref at);
                if (at < s.Length && (s[at] & 255) == 44) { at = at + 1; continue; }
                if (at < s.Length && (s[at] & 255) == 93) { at = at + 1; break; }
                throw new YamlException("expected ',' or ']' in flow sequence");
            }
            return arr;
        }
        if (c == 123) {  // { 映射
            at = at + 1;
            JsonValue obj = JsonValue.NewObject();
            while (true) {
                SkipFlowSpace(s, ref at);
                if (at >= s.Length) {
                    throw new YamlException("unterminated flow mapping");
                }
                if ((s[at] & 255) == 125) { at = at + 1; break; }
                JsonValue kv = FlowValue(s, ref at, depth + 1);
                SkipFlowSpace(s, ref at);
                JsonValue vv = JsonValue.NewNull();
                if (at < s.Length && (s[at] & 255) == 58) {  // 键后有值
                    at = at + 1;
                    vv = FlowValue(s, ref at, depth + 1);
                }
                if (!kv.IsString()) {
                    throw new YamlException("flow mapping key must be a scalar");
                }
                string key = kv.AsString("");
                if (obj.Has(key)) {
                    throw new YamlException("duplicate key '" + key
                        + "' in flow mapping");
                }
                int kidx = obj.keys.Count;
                obj.keys.Add(key);
                obj.vals.Add(vv);
                if (obj.keyIndex != null) { obj.keyIndex[key] = kidx; }
                SkipFlowSpace(s, ref at);
                if (at < s.Length && (s[at] & 255) == 44) { at = at + 1; continue; }
                if (at < s.Length && (s[at] & 255) == 125) { at = at + 1; break; }
                throw new YamlException("expected ',' or '}' in flow mapping");
            }
            return obj;
        }
        if (c == 42) { return ResolveAliasFlow(s, ref at); }  // *alias
        return FlowScalar(s, ref at);
    }

    JsonValue ResolveAliasFlow(string s, ref int at) {
        int start = at;
        at = at + 1;
        int n = s.Length;
        while (at < n) {
            int c = s[at] & 255;
            if (c == 32 || c == 44 || c == 93 || c == 125) { break; }
            at = at + 1;
        }
        string name = s.Substring(start + 1, at - start - 1);
        if (!anchors.ContainsKey(name)) {
            throw new YamlException("unknown alias '*" + name + "'");
        }
        return anchors[name];
    }

    // 流式标量：引号串完整解码（无转义快路径零 StringBuilder）；plain 到 , ] } 或 ': ' 止。
    JsonValue FlowScalar(string s, ref int at) {
        int c = s[at] & 255;
        if (c == 34) {  // 双引
            StringBuilder sb = null;
            at = at + 1;
            int chunkStart = at;
            int n = s.Length;
            nint sp = (nint)s;
            while (at < n) {
                int ch = s[at] & 255;
                if (ch == 92) {
                    if (sb == null) { sb = new StringBuilder(); }
                    if (at > chunkStart) { sb.Append(new StringView(sp + (nint)chunkStart, at - chunkStart)); }
                    at = at + 1;
                    ReadEscape(s, ref at, sb);
                    chunkStart = at;
                    continue;
                }
                if (ch == 34) {
                    if (sb == null) {
                        string direct = s.Substring(chunkStart, at - chunkStart);
                        at = at + 1;
                        return JsonValue.NewStr(direct);
                    }
                    if (at > chunkStart) { sb.Append(new StringView(sp + (nint)chunkStart, at - chunkStart)); }
                    at = at + 1;
                    return JsonValue.NewStr(sb.ToString());
                }
                at = at + 1;
            }
            if (sb == null) { return JsonValue.NewStr(s.Substring(chunkStart, at - chunkStart)); }
            if (at > chunkStart) { sb.Append(new StringView(sp + (nint)chunkStart, at - chunkStart)); }
            return JsonValue.NewStr(sb.ToString());
        }
        if (c == 39) {  // 单引
            StringBuilder sb = null;
            at = at + 1;
            int chunkStart = at;
            int n = s.Length;
            nint sp = (nint)s;
            while (at < n) {
                int ch = s[at] & 255;
                if (ch == 39) {
                    if (at + 1 < n && (s[at + 1] & 255) == 39) {
                        if (sb == null) { sb = new StringBuilder(); }
                        if (at > chunkStart) { sb.Append(new StringView(sp + (nint)chunkStart, at - chunkStart)); }
                        sb.Append("'");
                        at = at + 2;
                        chunkStart = at;
                        continue;
                    }
                    if (sb == null) {
                        string direct = s.Substring(chunkStart, at - chunkStart);
                        at = at + 1;
                        return JsonValue.NewStr(direct);
                    }
                    if (at > chunkStart) { sb.Append(new StringView(sp + (nint)chunkStart, at - chunkStart)); }
                    at = at + 1;
                    return JsonValue.NewStr(sb.ToString());
                }
                at = at + 1;
            }
            if (sb == null) { return JsonValue.NewStr(s.Substring(chunkStart, at - chunkStart)); }
            if (at > chunkStart) { sb.Append(new StringView(sp + (nint)chunkStart, at - chunkStart)); }
            return JsonValue.NewStr(sb.ToString());
        }
        int start = at;
        int m = s.Length;
        while (at < m) {
            int ch = s[at] & 255;
            if (ch == 44 || ch == 93 || ch == 125) { break; }
            if (ch == 58) {
                if (at + 1 >= m || (s[at + 1] & 255) == 32) { break; }
            }
            at = at + 1;
        }
        int e = at;
        while (e > start && (s[e - 1] & 255) == 32) { e = e - 1; }
        return TypeScalar(s.Substring(start, e - start));
    }

    void SkipFlowSpace(string s, ref int at) {
        int n = s.Length;
        while (at < n && (s[at] & 255) == 32) { at = at + 1; }
    }

    // ===== 键与标量杂项 =====

    // 找到 key 的冒号（引号外 + 后随空格/行尾）；没有返回 -1。
    int FindKeyColon(string t) {
        int i = 0;
        int n = t.Length;
        int quote = 0;
        while (i < n) {
            int c = t[i] & 255;
            if (quote != 0) {
                if (quote == 34 && c == 92) { i = i + 1; }
                else if (c == quote) { quote = 0; }
            } else if (c == 34 || c == 39) { quote = c; }
            else if (c == 58) {
                if (i + 1 >= n || (t[i + 1] & 255) == 32) { return i; }
            } else if (c == 35 && i > 0 && (t[i - 1] & 255) == 32) {
                return -1;  // 注释起，无键
            }
            i = i + 1;
        }
        return -1;
    }

    // 键文本：引号串解码，plain 去尾空格。
    string DecodeKey(string part) {
        string t = part;
        int e = t.Length;
        while (e > 0 && (t[e - 1] & 255) == 32) { e = e - 1; }
        if (e < t.Length) { t = t.Substring(0, e); }
        if (t.Length >= 2 && t[0] == 34) {
            return DecodeDoubleQuoted(t);
        }
        if (t.Length >= 2 && t[0] == 39) {
            return DecodeSingleQuoted(t);
        }
        return t;
    }

    bool IsCommentOnly(string rest) {
        return rest.Length > 0 && rest[0] == 35;
    }

    bool IsSeqLine(string t) {
        if (t.Length == 1 && t[0] == 45) { return true; }
        return t.Length >= 2 && t[0] == 45 && t[1] == 32;
    }

    // plain 标量去 ` #` 注释（memchr 直跳 `#`，无 `#` 零扫描开销）。
    string StripComment(string s) {
        int n = s.Length;
        if (n < 2) { return s; }
        nint sp = (nint)s;
        int pos = 1;
        while (pos < n) {
            int hit = NativeMemory.Find(sp, pos, 35, n - pos);
            if (hit < 0) { return s; }
            if ((s[hit - 1] & 255) == 32) {
                int e = hit;
                while (e > 0 && (s[e - 1] & 255) == 32) { e = e - 1; }
                return s.Substring(0, e);
            }
            pos = hit + 1;
        }
        return s;
    }

    // 双引标量（整段含首尾引号）解码（无转义快路径零 StringBuilder，转义段走 StringView）。
    string DecodeDoubleQuoted(string t) {
        return DecodeDoubleQuotedSlice(t, 0, t.Length);
    }

    string DecodeDoubleQuotedSlice(string t, int sliceStart, int sliceEnd) {
        StringBuilder sb = null;
        int at = sliceStart + 1;
        int start = at;
        nint tp = (nint)t;
        while (at < sliceEnd) {
            int ch = t[at] & 255;
            if (ch == 34) {
                if (sb == null) { return NativeMemory.GetString(tp, start, at - start); }
                if (at > start) { sb.Append(new StringView(tp + (nint)start, at - start)); }
                return sb.ToString();
            }
            if (ch == 92) {
                if (sb == null) { sb = new StringBuilder(sliceEnd - sliceStart); }
                if (at > start) { sb.Append(new StringView(tp + (nint)start, at - start)); }
                at = at + 1;
                ReadEscape(t, ref at, sb);
                start = at;
                continue;
            }
            at = at + 1;
        }
        if (sb == null) { return NativeMemory.GetString(tp, start, at - start); }
        if (at > start) { sb.Append(new StringView(tp + (nint)start, at - start)); }
        return sb.ToString();
    }

    // 单引标量（整段含首尾引号）解码：'' → '（无转义快路径零 StringBuilder，转义段走 StringView）。
    string DecodeSingleQuoted(string t) {
        return DecodeSingleQuotedSlice(t, 0, t.Length);
    }

    string DecodeSingleQuotedSlice(string t, int sliceStart, int sliceEnd) {
        StringBuilder sb = null;
        int at = sliceStart + 1;
        int start = at;
        nint tp = (nint)t;
        while (at < sliceEnd) {
            int ch = t[at] & 255;
            if (ch == 39) {
                if (at + 1 < sliceEnd && (t[at + 1] & 255) == 39) {
                    if (sb == null) { sb = new StringBuilder(sliceEnd - sliceStart); }
                    if (at > start) { sb.Append(new StringView(tp + (nint)start, at - start)); }
                    sb.Append("'");
                    at = at + 2;
                    start = at;
                    continue;
                }
                if (sb == null) { return NativeMemory.GetString(tp, start, at - start); }
                if (at > start) { sb.Append(new StringView(tp + (nint)start, at - start)); }
                return sb.ToString();
            }
            at = at + 1;
        }
        if (sb == null) { return NativeMemory.GetString(tp, start, at - start); }
        if (at > start) { sb.Append(new StringView(tp + (nint)start, at - start)); }
        return sb.ToString();
    }

    // 反斜杠转义（s[at] 在转义符上），解码追加到 sb。
    void ReadEscape(string s, ref int at, StringBuilder sb) {
        if (at >= s.Length) {
            throw new YamlException("unterminated escape sequence (line "
                + Convert.ToString(lastLineNo) + ")");
        }
        int c = s[at] & 255;
        at = at + 1;
        if (c == 110) { sb.Append("\n"); }
        else if (c == 116) { sb.Append("\t"); }
        else if (c == 114) { sb.Append("\r"); }
        else if (c == 48) {
            throw new YamlException("escape \\0 not supported (line "
                + Convert.ToString(lastLineNo) + ")");
        }
        else if (c == 34) { sb.Append("\""); }
        else if (c == 92) { sb.Append("\\"); }
        else if (c == 47) { sb.Append("/"); }
        else if (c == 98) { sb.Append(Encoding.Utf8FromCodePoint(8)); }
        else if (c == 102) { sb.Append(Encoding.Utf8FromCodePoint(12)); }
        else if (c == 117) {  // \uXXXX
            int cp = Hex4(s, at);
            sb.Append(Encoding.Utf8FromCodePoint(cp));
            at = at + 4;
        } else if (c == 120) {  // \xXX
            int cp = Hex2(s, at);
            sb.Append(Encoding.Utf8FromCodePoint(cp));
            at = at + 2;
        } else {
            throw new YamlException("unknown escape '\\" + s.Substring(at - 1, 1)
                + "' (line " + Convert.ToString(lastLineNo) + ")");
        }
    }

    int Hex4(string s, int at) {
        if (at + 4 > s.Length) {
            throw new YamlException("truncated \\u escape (line "
                + Convert.ToString(lastLineNo) + ")");
        }
        int v = 0;
        int i = 0;
        while (i < 4) {
            int d = HexDigit(s[at + i] & 255);
            if (d < 0) {
                throw new YamlException("invalid hex digit in \\u escape (line "
                    + Convert.ToString(lastLineNo) + ")");
            }
            v = (v << 4) | d;
            i = i + 1;
        }
        return v;
    }

    int Hex2(string s, int at) {
        if (at + 2 > s.Length) {
            throw new YamlException("truncated \\x escape (line "
                + Convert.ToString(lastLineNo) + ")");
        }
        int hi = HexDigit(s[at] & 255);
        int lo = HexDigit(s[at + 1] & 255);
        if (hi < 0 || lo < 0) {
            throw new YamlException("invalid hex digit in \\x escape (line "
                + Convert.ToString(lastLineNo) + ")");
        }
        return (hi << 4) | lo;
    }

    private static int HexDigit(int c) {
        if (c >= 48 && c <= 57) { return c - 48; }
        if (c >= 65 && c <= 70) { return c - 55; }
        if (c >= 97 && c <= 102) { return c - 87; }
        return -1;
    }

    // ===== core schema 类型推断 =====

    // 零堆分配判定 plain 标量是否会被 TypeScalar 识别为非字符串（null/bool/int/float）。
    public static bool IsNonStringScalar(string s) {
        int n = s.Length;
        if (n == 0) { return true; }
        int c0 = s[0] & 255;
        if (c0 == 126 && n == 1) { return true; }  // "~"
        if (c0 == 110 || c0 == 78) {
            if (s == "null" || s == "Null" || s == "NULL") { return true; }
            return false;
        }
        if (c0 == 116 || c0 == 84) {
            if (s == "true" || s == "True" || s == "TRUE") { return true; }
            return false;
        }
        if (c0 == 102 || c0 == 70) {
            if (s == "false" || s == "False" || s == "FALSE") { return true; }
            return false;
        }
        if (c0 == 46 || c0 == 43 || c0 == 45 || (c0 >= 48 && c0 <= 57)) {
            if (s == ".inf" || s == ".Inf" || s == ".INF"
                || s == "+.inf" || s == "+.Inf" || s == "+.INF"
                || s == "-.inf" || s == "-.Inf" || s == "-.INF"
                || s == ".nan" || s == ".NaN" || s == ".NAN") {
                return true;
            }
            if (IsIntShape(s)) {
                long v = 0;
                int i = (c0 == 45 || c0 == 43) ? 1 : 0;
                if (n > i + 1 && s[i] == 48 && s[i + 1] == 120) {
                    i = i + 2;
                    while (i < n) {
                        int d = HexDigit(s[i] & 255);
                        if (d < 0 || v > 576460752303423487) { return false; }
                        v = (v << 4) + d;
                        i = i + 1;
                    }
                    return true;
                }
                if (n > i + 1 && s[i] == 48 && s[i + 1] == 111) {
                    i = i + 2;
                    while (i < n) {
                        int c = s[i] & 255;
                        if (c < 48 || c > 55 || v > 1152921504606846975) { return false; }
                        v = (v << 3) + (c - 48);
                        i = i + 1;
                    }
                    return true;
                }
                while (i < n) {
                    int c = s[i] & 255;
                    if (c < 48 || c > 57 || v > 922337203685477579) { return false; }
                    v = v * 10 + (c - 48);
                    i = i + 1;
                }
                return true;
            }
            if (IsFloatShape(s)) { return true; }
        }
        return false;
    }

    // plain 标量 → null/bool/int/float/string（首字节分派 + 单遍整数融合解析，消除普通串 18 次比较）。
    public static JsonValue TypeScalar(string s) {
        int n = s.Length;
        if (n == 0) { return JsonValue.NewNull(); }
        int c0 = s[0] & 255;
        if (c0 == 126) {
            if (n == 1) { return JsonValue.NewNull(); }
            return JsonValue.NewStr(s);
        }
        if (c0 == 110 || c0 == 78) {
            if (n == 4 && (s == "null" || s == "Null" || s == "NULL")) { return JsonValue.NewNull(); }
            return JsonValue.NewStr(s);
        }
        if (c0 == 116 || c0 == 84) {
            if (n == 4 && (s == "true" || s == "True" || s == "TRUE")) { return JsonValue.NewBool(true); }
            return JsonValue.NewStr(s);
        }
        if (c0 == 102 || c0 == 70) {
            if (n == 5 && (s == "false" || s == "False" || s == "FALSE")) { return JsonValue.NewBool(false); }
            return JsonValue.NewStr(s);
        }
        if (c0 != 46 && c0 != 43 && c0 != 45 && (c0 < 48 || c0 > 57)) {
            return JsonValue.NewStr(s);
        }
        if (c0 == 46) {
            if (n == 4) {
                if (s == ".inf" || s == ".Inf" || s == ".INF") {
                    return JsonValue.NewDouble(NativeMemory.AsF64(0x7FF0000000000000L));
                }
                if (s == ".nan" || s == ".NaN" || s == ".NAN") {
                    return JsonValue.NewDouble(NativeMemory.AsF64(0x7FF8000000000000L));
                }
            }
            if (IsFloatShape(s)) { return JsonValue.NewDouble(DoubleOf(s)); }
            return JsonValue.NewStr(s);
        }
        if (c0 == 43 || c0 == 45) {
            if (n == 5 && (s[1] & 255) == 46) {
                if (c0 == 43 && (s == "+.inf" || s == "+.Inf" || s == "+.INF")) {
                    return JsonValue.NewDouble(NativeMemory.AsF64(0x7FF0000000000000L));
                }
                if (c0 == 45 && (s == "-.inf" || s == "-.Inf" || s == "-.INF")) {
                    return JsonValue.NewDouble(0.0 - NativeMemory.AsF64(0x7FF0000000000000L));
                }
            }
        }
        // 单遍整数快速路径：同时校验形态并累加数值，不合法则顺延浮点评判。
        bool neg = c0 == 45;
        int i = (neg || c0 == 43) ? 1 : 0;
        if (i < n) {
            long v = 0;
            bool overflow = false;
            bool isInt = true;
            if (n > i + 2 && (s[i] & 255) == 48 && (s[i + 1] & 255) == 120) {  // 0x
                int k = i + 2;
                while (k < n) {
                    int d = HexDigit(s[k] & 255);
                    if (d < 0) { isInt = false; break; }
                    if (v > 576460752303423487L) { overflow = true; }
                    v = (v << 4) + d;
                    k = k + 1;
                }
                if (isInt) {
                    if (overflow) { return JsonValue.NewStr(s); }
                    return JsonValue.NewInt(neg ? (0 - v) : v);
                }
            } else if (n > i + 2 && (s[i] & 255) == 48 && (s[i + 1] & 255) == 111) {  // 0o
                int k = i + 2;
                while (k < n) {
                    int c = s[k] & 255;
                    if (c < 48 || c > 55) { isInt = false; break; }
                    if (v > 1152921504606846975L) { overflow = true; }
                    v = (v << 3) + (c - 48);
                    k = k + 1;
                }
                if (isInt) {
                    if (overflow) { return JsonValue.NewStr(s); }
                    return JsonValue.NewInt(neg ? (0 - v) : v);
                }
            } else {
                int k = i;
                while (k < n) {
                    int c = s[k] & 255;
                    if (c < 48 || c > 57) { isInt = false; break; }
                    if (v > 922337203685477579L) { overflow = true; }
                    v = v * 10 + (c - 48);
                    k = k + 1;
                }
                if (isInt) {
                    if (overflow) { return JsonValue.NewStr(s); }
                    return JsonValue.NewInt(neg ? (0 - v) : v);
                }
            }
        }
        if (IsFloatShape(s)) { return JsonValue.NewDouble(DoubleOf(s)); }
        return JsonValue.NewStr(s);
    }

    private static double DoubleOf(string s) {
        double acc = 0.0;
        int i = 0;
        int n = s.Length;
        bool neg = false;
        if (s[0] == 45) { neg = true; i = 1; }
        else if (s[0] == 43) { i = 1; }
        while (i < n) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { break; }
            acc = acc * 10.0 + (double)(c - 48);
            i = i + 1;
        }
        if (i < n && (s[i] & 255) == 46) {
            i = i + 1;
            double scale = 0.1;
            while (i < n) {
                int c = s[i] & 255;
                if (c < 48 || c > 57) { break; }
                acc = acc + (double)(c - 48) * scale;
                scale = scale * 0.1;
                i = i + 1;
            }
        }
        if (i < n && ((s[i] & 255) == 101 || (s[i] & 255) == 69)) {
            i = i + 1;
            bool eneg = false;
            if (i < n && (s[i] & 255) == 45) { eneg = true; i = i + 1; }
            else if (i < n && (s[i] & 255) == 43) { i = i + 1; }
            int ex = 0;
            while (i < n) {
                int c = s[i] & 255;
                if (c < 48 || c > 57) { break; }
                if (ex <= 100000) { ex = ex * 10 + (c - 48); }
                i = i + 1;
            }
            if (ex > 324) {
                acc = eneg ? 0.0 : (acc == 0.0 ? 0.0 : NativeMemory.AsF64(0x7FF0000000000000L));
            } else if (ex > 0) {
                double p = 1.0;
                double base10 = 10.0;
                int e = ex;
                while (e > 0) {
                    if ((e & 1) != 0) { p = p * base10; }
                    base10 = base10 * base10;
                    e = e >> 1;
                }
                acc = eneg ? acc / p : acc * p;
            }
        }
        if (neg) { return 0.0 - acc; }
        return acc;
    }

    // [-+]?\d+ 形态（含 0x/0o 前缀），供 TypeScalar 分流。
    private static bool IsIntShape(string s) {
        int i = 0;
        int n = s.Length;
        if (n == 0) { return false; }
        if (s[0] == 45 || s[0] == 43) { i = 1; }
        if (n > i + 1 && s[i] == 48 && (s[i + 1] == 120 || s[i + 1] == 111)) {
            i = i + 2;
            if (i >= n) { return false; }
            if (s[i - 1] == 120) {
                while (i < n) {
                    int c = s[i] & 255;
                    bool hex = (c >= 48 && c <= 57) || (c >= 97 && c <= 102)
                        || (c >= 65 && c <= 70);
                    if (!hex) { return false; }
                    i = i + 1;
                }
                return true;
            }
            while (i < n) {
                int c = s[i] & 255;
                if (c < 48 || c > 55) { return false; }
                i = i + 1;
            }
            return true;
        }
        if (i >= n) { return false; }
        while (i < n) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { return false; }
            i = i + 1;
        }
        return true;
    }

    // 浮点形态（YAML Core Schema）：可选正负号，至多一个 '.'（若有前后须有数字），可选 e/E 指数。
    private static bool IsFloatShape(string s) {
        int i = 0;
        int n = s.Length;
        if (n == 0) { return false; }
        if (s[0] == 45 || s[0] == 43) { i = 1; }
        if (i >= n) { return false; }
        bool hasDigitsBeforeDot = false;
        while (i < n && s[i] >= 48 && s[i] <= 57) {
            hasDigitsBeforeDot = true;
            i = i + 1;
        }
        bool hasDot = false;
        bool hasDigitsAfterDot = false;
        if (i < n && s[i] == 46) {
            hasDot = true;
            i = i + 1;
            while (i < n && s[i] >= 48 && s[i] <= 57) {
                hasDigitsAfterDot = true;
                i = i + 1;
            }
            if (!hasDigitsBeforeDot && !hasDigitsAfterDot) { return false; }
        }
        bool hasExp = false;
        if (i < n && (s[i] == 101 || s[i] == 69)) {
            hasExp = true;
            i = i + 1;
            if (i < n && (s[i] == 45 || s[i] == 43)) { i = i + 1; }
            bool hasExpDigits = false;
            while (i < n && s[i] >= 48 && s[i] <= 57) {
                hasExpDigits = true;
                i = i + 1;
            }
            if (!hasExpDigits) { return false; }
        }
        return i == n && (hasDot || hasExp) && (hasDigitsBeforeDot || hasDigitsAfterDot);
    }
}
