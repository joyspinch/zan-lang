using System;
using System.Json;
using System.Text;

namespace Formats.Bson;

// BSON 解码原语：在 byte[] 上游走，ReadDocument 按元素类型字节
// 分派递归还原成 System.Json.JsonValue。二进制子类型按 UTF-8 尽力
// 解码成字符串（非法序列收敛 U+FFFD）；ObjectId 还原成 24 位小写
// 十六进制串；datetime（UTC 毫秒）还原成 ISO 8601 UTC 字符串。
// regex/code/timestamp/decimal128/minkey/maxkey 等值模型外的类型
// 报错。深度限 512。文档长度严格校验：声明长度必须与实际消耗一致。
public class BsonReader {
    public byte[] buf;
    public int pos;
    public int len;
    string[] keyCache;

    // 包装整段字节。
    public BsonReader(byte[] data) {
        if (data == null) { throw new BsonException("null input buffer"); }
        buf = data;
        pos = 0;
        len = data.Length;
        keyCache = new string[64];
    }

    // 包装切片 [offset, offset+count)。
    public BsonReader(byte[] data, int offset, int count) {
        if (data == null || offset < 0 || count < 0 || (long)offset + (long)count > (long)data.Length) {
            throw new BsonException("invalid slice range");
        }
        buf = data;
        pos = offset;
        len = offset + count;
        keyCache = new string[64];
    }

    public int U8() {
        if (pos >= len) {
            throw new BsonException("truncated at byte "
                + Convert.ToString(pos));
        }
        int b = buf[pos] & 255;
        pos = pos + 1;
        return b;
    }

    public long U32LE() {
        if (len - pos < 4) {
            pos = len;
            throw new BsonException("truncated at byte " + Convert.ToString(pos));
        }
        int p = pos;
        long v = (long)(buf[p] & 255)
            | ((long)(buf[p + 1] & 255) << 8)
            | ((long)(buf[p + 2] & 255) << 16)
            | ((long)(buf[p + 3] & 255) << 24);
        pos = p + 4;
        return v;
    }

    public long U64LE() {
        if (len - pos < 8) {
            pos = len;
            throw new BsonException("truncated at byte " + Convert.ToString(pos));
        }
        int p = pos;
        long v = (long)(buf[p] & 255)
            | ((long)(buf[p + 1] & 255) << 8)
            | ((long)(buf[p + 2] & 255) << 16)
            | ((long)(buf[p + 3] & 255) << 24)
            | ((long)(buf[p + 4] & 255) << 32)
            | ((long)(buf[p + 5] & 255) << 40)
            | ((long)(buf[p + 6] & 255) << 48)
            | ((long)(buf[p + 7] & 255) << 56);
        pos = p + 8;
        return v;
    }

    // 有符号 32 位（LE 读入后符号扩展由 long 承载，
    // 截回 int 域）。
    public int S32LE() {
        long v = U32LE();
        if (v >= 2147483648) { v = v - 4294967296; }
        return (int)v;
    }

    // 取 n 字节（越界抛）。n 用减法比较防 int 溢出绕过。
    public byte[] Take(int n) {
        if (n < 0 || n > len - pos) {
            throw new BsonException("truncated at byte "
                + Convert.ToString(pos) + " (need " + Convert.ToString(n) + ")");
        }
        byte[] out2 = new byte[n];
        NativeMemory.Copy((nint)out2, (nint)buf + pos, n);
        pos = pos + n;
        return out2;
    }

    // 读一个完整文档（int32 总长 + 元素 + 0x00）。
    // asArray 时按元素顺序还原成 JsonValue 数组（MongoDB 语义：
    // 数组键就是 "0","1",…，键名不参与语义）；否则还原成对象。
    public JsonValue ReadDocument(int depth, bool asArray) {
        if (depth > 512) {
            throw new BsonException("nesting too deep at byte "
                + Convert.ToString(pos));
        }
        int lenAt = pos;
        int total = S32LE();
        if (total < 5) {
            throw new BsonException("document length " + Convert.ToString(total)
                + " below minimum 5 at byte " + Convert.ToString(lenAt));
        }
        if (total > 536870912) {
            throw new BsonException("document length " + Convert.ToString(total)
                + " exceeds 512MB limit at byte " + Convert.ToString(lenAt));
        }
        if (total > len - lenAt) {
            throw new BsonException("truncated document at byte "
                + Convert.ToString(lenAt) + " (declares "
                + Convert.ToString(total) + ")");
        }
        int bodyEnd = lenAt + total;
        int limit = bodyEnd < len ? bodyEnd : len;
        nint bp = (nint)buf;
        Span<byte> sb = new Span<byte>(bp, len);
        if (asArray) {
            JsonValue v = JsonValue.NewArray();
            List<JsonValue> items = v.items;
            while (true) {
                int typeAt = pos;
                if (pos >= len) {
                    throw new BsonException("truncated at byte " + Convert.ToString(pos));
                }
                int t = sb[pos] & 255;
                pos = pos + 1;
                if (t == 0) {
                    if (pos != bodyEnd) {
                        throw new BsonException("document length mismatch at byte "
                            + Convert.ToString(lenAt) + " (declares "
                            + Convert.ToString(total) + ", ends at "
                            + Convert.ToString(pos) + ")");
                    }
                    return v;
                }
                if (typeAt >= bodyEnd) {
                    throw new BsonException("element past document end at byte "
                        + Convert.ToString(typeAt));
                }
                // 数组下标键 99.9% 为 1..3 字节数字 + NUL，内联直跳免 NativeMemory.Find 调用。
                if (pos + 1 < limit && (sb[pos] & 255) != 0 && (sb[pos + 1] & 255) == 0) {
                    pos = pos + 2;
                } else if (pos + 2 < limit && (sb[pos] & 255) != 0 && (sb[pos + 1] & 255) != 0 && (sb[pos + 2] & 255) == 0) {
                    pos = pos + 3;
                } else if (pos + 3 < limit && (sb[pos] & 255) != 0 && (sb[pos + 1] & 255) != 0 && (sb[pos + 2] & 255) != 0 && (sb[pos + 3] & 255) == 0) {
                    pos = pos + 4;
                } else {
                    SkipCStr(bp, bodyEnd);
                }
                if (t == 16 && len - pos >= 4) {
                    int p = pos;
                    long iv = (long)(sb[p] & 255)
                        | ((long)(sb[p + 1] & 255) << 8)
                        | ((long)(sb[p + 2] & 255) << 16)
                        | ((long)(sb[p + 3] & 255) << 24);
                    pos = p + 4;
                    if (iv >= 2147483648) { iv = iv - 4294967296; }
                    items.Add(JsonValue.NewInt((int)iv));
                } else if (t == 18 && len - pos >= 8) {
                    int p = pos;
                    long lv = (long)(sb[p] & 255)
                        | ((long)(sb[p + 1] & 255) << 8)
                        | ((long)(sb[p + 2] & 255) << 16)
                        | ((long)(sb[p + 3] & 255) << 24)
                        | ((long)(sb[p + 4] & 255) << 32)
                        | ((long)(sb[p + 5] & 255) << 40)
                        | ((long)(sb[p + 6] & 255) << 48)
                        | ((long)(sb[p + 7] & 255) << 56);
                    pos = p + 8;
                    items.Add(JsonValue.NewInt(lv));
                } else {
                    items.Add(ReadElement(t, depth));
                }
            }
        } else {
            JsonValue v = JsonValue.NewObject();
            List<string> ks = v.keys;
            List<JsonValue> vs = v.vals;
            while (true) {
                int typeAt = pos;
                if (pos >= len) {
                    throw new BsonException("truncated at byte " + Convert.ToString(pos));
                }
                int t = sb[pos] & 255;
                pos = pos + 1;
                if (t == 0) {
                    if (pos != bodyEnd) {
                        throw new BsonException("document length mismatch at byte "
                            + Convert.ToString(lenAt) + " (declares "
                            + Convert.ToString(total) + ", ends at "
                            + Convert.ToString(pos) + ")");
                    }
                    return v;
                }
                if (typeAt >= bodyEnd) {
                    throw new BsonException("element past document end at byte "
                        + Convert.ToString(typeAt));
                }
                string name = InternCStr(bp, bodyEnd);
                JsonValue elem = ReadElement(t, depth);
                BsonReader.SetObjField(v, name, elem);
            }
        }
    }

    // 新建文档字段去重写入（小对象线性探测、大对象按需建 keyIndex，避免重复键）。
    private static void SetObjField(JsonValue obj, string key, JsonValue val) {
        if (obj.keyIndex != null) {
            int existing = 0;
            if (obj.keyIndex.TryGetValue(key, out existing)) {
                obj.vals[existing] = val;
                return;
            }
            int ni = obj.keys.Count;
            obj.keys.Add(key);
            obj.vals.Add(val);
            obj.keyIndex[key] = ni;
            return;
        }
        int cnt = obj.keys.Count;
        if (cnt < 8) {
            for (int i = 0; i < cnt; i = i + 1) {
                if (obj.keys[i] == key) {
                    obj.vals[i] = val;
                    return;
                }
            }
            obj.keys.Add(key);
            obj.vals.Add(val);
            return;
        }
        Dict<string, int> idx = new Dict<string, int>();
        for (int i = 0; i < cnt; i = i + 1) {
            idx[obj.keys[i]] = i;
        }
        obj.keyIndex = idx;
        int ex2 = 0;
        if (idx.TryGetValue(key, out ex2)) {
            obj.vals[ex2] = val;
            return;
        }
        obj.keys.Add(key);
        obj.vals.Add(val);
        idx[key] = cnt;
    }

    // 数组元素键跳过：零字符串分配，SIMD memchr 直定位终止 NUL。
    void SkipCStr(nint bp, int bodyEnd) {
        int start = pos;
        int limit = bodyEnd < len ? bodyEnd : len;
        int rem = limit - start;
        if (rem > 0) {
            int hit = NativeMemory.Find(bp, start, 0, rem);
            if (hit >= 0) {
                pos = hit + 1;
                return;
            }
        }
        pos = limit;
        throw new BsonException("unterminated element name at byte "
            + Convert.ToString(start));
    }

    // 对象字段名读取 + 64 槽 FNV 直接映射驻留缓存：命中时零字符串堆分配。
    string InternCStr(nint bp, int bodyEnd) {
        int start = pos;
        int limit = bodyEnd < len ? bodyEnd : len;
        int rem = limit - start;
        if (rem > 0) {
            int hit = NativeMemory.Find(bp, start, 0, rem);
            if (hit >= 0) {
                int n = hit - start;
                pos = hit + 1;
                if (n == 0) { return ""; }
                if (n <= 32) {
                    Span<byte> s = new Span<byte>(bp + (nint)start, n);
                    int h = -2128831035;
                    for (int i = 0; i < n; i = i + 1) {
                        h = (h ^ (s[i] & 255)) * 16777619;
                    }
                    int slot = h & 63;
                    string cached = keyCache[slot];
                    if (cached != null && cached.Length == n) {
                        bool eq = true;
                        for (int i = 0; i < n; i = i + 1) {
                            if ((s[i] & 255) != (cached[i] & 255)) { eq = false; break; }
                        }
                        if (eq) { return cached; }
                    }
                    string fresh = buf.ToStr(start, n);
                    keyCache[slot] = fresh;
                    return fresh;
                }
                return buf.ToStr(start, n);
            }
        }
        pos = limit;
        throw new BsonException("unterminated element name at byte "
            + Convert.ToString(start));
    }

    // cstring 元素名：SIMD 扫描到第一个 NUL（cstring 定义上不含 NUL，
    // 首个即终结）；扫到文档尾都没遇到即畸形。直接从 buf 切片解码，零中间数组分配。
    public string CStr(int bodyEnd) {
        int start = pos;
        int limit = bodyEnd < len ? bodyEnd : len;
        int rem = limit - start;
        if (rem > 0) {
            int hit = NativeMemory.Find((nint)buf, start, 0, rem);
            if (hit >= 0) {
                string s = buf.ToStr(start, hit - start);
                pos = hit + 1;
                return s;
            }
        }
        pos = limit;
        throw new BsonException("unterminated element name at byte "
            + Convert.ToString(start));
    }

    // 按类型字节解码单个元素值（switch 跳转表 O(1) 分派）。
    public JsonValue ReadElement(int t, int depth) {
        switch (t) {
            case 16: return JsonValue.NewInt(S32LE());  // int32
            case 18: return JsonValue.NewInt(U64LE());  // int64
            case 2: return JsonValue.NewStr(ReadString());  // string
            case 1: return JsonValue.NewDouble(BitsDouble(U64LE()));  // double
            case 3: return ReadDocument(depth + 1, false);  // document
            case 4: return ReadDocument(depth + 1, true);  // array
            case 8: {  // bool
                int bv = U8();
                if (bv != 0 && bv != 1) {
                    throw new BsonException("boolean value must be 0x00 or 0x01,"
                        + " got 0x" + HexByte(bv) + " at byte "
                        + Convert.ToString(pos - 1));
                }
                return JsonValue.NewBool(bv != 0);
            }
            case 10: return JsonValue.NewNull();  // null
            case 9: return JsonValue.NewStr(IsoFromMs(U64LE()));  // datetime
            case 7: {  // ObjectId（零临时 byte[12] 切片直转 24 字节 hex）
                if (12 > len - pos) {
                    throw new BsonException("truncated at byte " + Convert.ToString(pos) + " (need 12)");
                }
                int st = pos;
                pos = pos + 12;
                byte[] hex = new byte[24];
                int di = 0;
                for (int i = 0; i < 12; i = i + 1) {
                    int v = buf[st + i] & 255;
                    int h = (v >> 4) & 15;
                    int l = v & 15;
                    hex[di]     = (byte)(h < 10 ? h + 48 : h + 87);
                    hex[di + 1] = (byte)(l < 10 ? l + 48 : l + 87);
                    di = di + 2;
                }
                return JsonValue.NewStr(hex.ToStr(0, 24));
            }
            case 5: {  // binary
                int n = S32LE();
                if (n < 0 || n > 536870912) {
                    throw new BsonException("binary length out of bounds at byte " + Convert.ToString(pos));
                }
                int subtype = U8();
                if (subtype == 2) {
                    if (n < 4 || S32LE() != n - 4) {
                        throw new BsonException("binary subtype 0x02 embedded"
                            + " length mismatch at byte " + Convert.ToString(pos));
                    }
                    return JsonValue.NewStr(DecodedText(Take(n - 4)));
                }
                return JsonValue.NewStr(DecodedText(Take(n)));
            }
            default:
                throw new BsonException("unsupported type 0x"
                    + HexByte(t) + " at byte " + Convert.ToString(pos - 1));
        }
    }

    // string 值主体：int32 字节数（含终止 NUL）+ 字节 + NUL，
    // 末字节必须为 0。直接从 buf 切片解码，零中间 byte[] 拷贝。
    public string ReadString() {
        int n = S32LE();
        if (n < 1) {
            throw new BsonException("string length " + Convert.ToString(n)
                + " below minimum 1 at byte " + Convert.ToString(pos));
        }
        if (n > 536870912) {
            throw new BsonException("string length " + Convert.ToString(n)
                + " exceeds 512MB limit at byte " + Convert.ToString(pos));
        }
        if (n > len - pos) {
            throw new BsonException("truncated at byte "
                + Convert.ToString(pos) + " (need " + Convert.ToString(n) + ")");
        }
        if ((buf[pos + n - 1] & 255) != 0) {
            throw new BsonException("string missing NUL terminator at byte "
                + Convert.ToString(pos + n));
        }
        int slen = n - 1;
        int st = pos;
        pos = pos + n;
        if (slen == 0) { return ""; }
        return buf.ToStr(st, slen);
    }

    // 12 字节 ObjectId → 24 位小写十六进制。
    // 平缓冲区直写：省掉 StringBuilder 与每半字节一次 Substring 的堆分配。
    public static string HexOf(byte[] b) {
        int n = b.Length;
        byte[] buf = new byte[n * 2];
        int di = 0;
        for (int i = 0; i < n; i = i + 1) {
            int v = b[i] & 255;
            int h = (v >> 4) & 15;
            int l = v & 15;
            buf[di]     = (byte)(h < 10 ? h + 48 : h + 87);
            buf[di + 1] = (byte)(l < 10 ? l + 48 : l + 87);
            di = di + 2;
        }
        return buf.ToStr(0, n * 2);
    }

    public static string HexByte(int b) {
        int h = (b >> 4) & 15;
        int l = b & 15;
        byte[] buf = new byte[2];
        buf[0] = (byte)(h < 10 ? h + 48 : h + 87);
        buf[1] = (byte)(l < 10 ? l + 48 : l + 87);
        return buf.ToStr(0, 2);
    }

    // UTC 毫秒 → ISO 8601（"YYYY-MM-DDTHH:MM:SS[.fff]Z"）。
    // 毫秒非零才带小数节（与 MsgPack timestamp 的读侧形态一致）。
    // 负毫秒（1970 前）向下取整到秒，避免截断方向错一天。
    public static string IsoFromMs(long ms) {
        long sec = ms / 1000;
        long rem = ms % 1000;
        if (rem < 0) { rem = rem + 1000; sec = sec - 1; }
        DateTime t = DateTime.FromUnixSeconds(sec);
        int year = t.Year();
        int month = t.Month();
        int day = t.Day();
        int hour = t.Hour();
        int minute = t.Minute();
        int second = t.Second();
        if (year >= 0 && year < 10000) {
            int total = rem > 0 ? 24 : 20;
            byte[] outb = new byte[total];
            outb[0] = (byte)(48 + (year / 1000) % 10);
            outb[1] = (byte)(48 + (year / 100) % 10);
            outb[2] = (byte)(48 + (year / 10) % 10);
            outb[3] = (byte)(48 + year % 10);
            outb[4] = 45;
            outb[5] = (byte)(48 + month / 10);
            outb[6] = (byte)(48 + month % 10);
            outb[7] = 45;
            outb[8] = (byte)(48 + day / 10);
            outb[9] = (byte)(48 + day % 10);
            outb[10] = 84;
            outb[11] = (byte)(48 + hour / 10);
            outb[12] = (byte)(48 + hour % 10);
            outb[13] = 58;
            outb[14] = (byte)(48 + minute / 10);
            outb[15] = (byte)(48 + minute % 10);
            outb[16] = 58;
            outb[17] = (byte)(48 + second / 10);
            outb[18] = (byte)(48 + second % 10);
            if (rem > 0) {
                int r = (int)rem;
                outb[19] = 46;
                outb[20] = (byte)(48 + r / 100);
                outb[21] = (byte)(48 + (r / 10) % 10);
                outb[22] = (byte)(48 + r % 10);
                outb[23] = 90;
            } else {
                outb[19] = 90;
            }
            return outb.ToStr(0, total);
        }
        StringBuilder sb = new StringBuilder();
        sb.Append(Pad4(year));
        sb.Append("-");
        sb.Append(Pad2(month));
        sb.Append("-");
        sb.Append(Pad2(day));
        sb.Append("T");
        sb.Append(Pad2(hour));
        sb.Append(":");
        sb.Append(Pad2(minute));
        sb.Append(":");
        sb.Append(Pad2(second));
        if (rem > 0) {
            sb.Append(".");
            if (rem < 100) { sb.Append("0"); }
            if (rem < 10) { sb.Append("0"); }
            sb.Append(Convert.ToString(rem));
        }
        sb.Append("Z");
        return sb.ToString();
    }

    public static string Pad2(int v) {
        if (v >= 0 && v < 100) {
            byte[] buf = new byte[2];
            buf[0] = (byte)(48 + v / 10);
            buf[1] = (byte)(48 + v % 10);
            return buf.ToStr(0, 2);
        }
        return Convert.ToString(v);
    }

    public static string Pad4(int v) {
        if (v >= 0 && v < 10000) {
            byte[] buf = new byte[4];
            buf[0] = (byte)(48 + (v / 1000) % 10);
            buf[1] = (byte)(48 + (v / 100) % 10);
            buf[2] = (byte)(48 + (v / 10) % 10);
            buf[3] = (byte)(48 + v % 10);
            return buf.ToStr(0, 4);
        }
        return Convert.ToString(v);
    }

    // 由 IEEE-754 位型还原 double：编译器内建 bitcast
    // （NativeMemory.AsF64，零开销、逐位精确）。
    public static double BitsDouble(long bits) {
        return NativeMemory.AsF64(bits);
    }

    // 字节 → 字符串（UTF-8 尽力，非法序列 U+FFFD）。
    public static string DecodedText(byte[] b) {
        return Encoding.GetString(b, 0, b.Length);
    }
}
