using System;
using System.Text;

namespace Formats.Bson;

// BSON 编码原语：往可增长的 byte[] 里写小端 32/64 位整数、
// IEEE-754 double、cstring（键）、string（长度前缀 + NUL 终止）。
// 字节缓冲倍增扩容整块 NativeMemory.Copy 搬移（与 MsgPackWriter
// 同形）。BSON 线上格式为小端（区别于 MessagePack 的大端）。
// 嵌套文档/数组先编码进子缓冲得到完整字节（自带长度头与终止符），
// 再作为元素值整体拼接——长度头因此天然自洽，无需回填。
public class BsonWriter {
    // 写侧总量上限：对齐读侧（BsonReader 拒绝 >512MB 的文档），
    // 超限抛 BsonException。容量算术全程 64 位——旧的 int 算术在
    // len+extra ≥ 2^31 时首判据回绕误判"有空间"直接写穿，倍增循环
    // 在 >1GB 时同样回绕成死循环。BSON 的 string/binary 为定长
    // int32 长度头，没有分片形态，此上限即终态；大载荷须在应用层
    // 拆分（CBOR 侧的 indefinite 分片见 CborWriter.Chunked）。
    public static long MaxTotalBytes = 536870912;

    public byte[] buf;
    public int len;

    public BsonWriter() {
        buf = new byte[256];
        len = 0;
    }

    // 已编码字节数。
    public int Length() { return len; }

    public void EnsureRoom(int extra) {
        if (extra < 0) {
            throw new BsonException("invalid write size: " + Convert.ToString(extra));
        }
        long need = (long)len + (long)extra;
        if (need > BsonWriter.MaxTotalBytes) {
            throw new BsonException("encoded size "
                + Convert.ToString(need) + " exceeds 512MB write limit");
        }
        if (need <= buf.Length) { return; }
        long c = (long)buf.Length * 2;
        if (c < 16) { c = 16; }
        while (c < need) { c = c * 2; }
        byte[] grown = new byte[(int)c];
        NativeMemory.Copy((nint)grown, (nint)buf, len);
        buf = grown;
    }

    // 追加 1 字节。
    public void RawU8(int b) {
        EnsureRoom(1);
        buf[len] = (byte)b;
        len = len + 1;
    }

    public void RawU32LE(long v) {
        EnsureRoom(4);
        buf[len] = (byte)v;
        buf[len + 1] = (byte)(v >> 8);
        buf[len + 2] = (byte)(v >> 16);
        buf[len + 3] = (byte)(v >> 24);
        len = len + 4;
    }

    public void RawU64LE(long v) {
        EnsureRoom(8);
        int p = len;
        buf[p] = (byte)v;
        buf[p + 1] = (byte)(v >> 8);
        buf[p + 2] = (byte)(v >> 16);
        buf[p + 3] = (byte)(v >> 24);
        buf[p + 4] = (byte)(v >> 32);
        buf[p + 5] = (byte)(v >> 40);
        buf[p + 6] = (byte)(v >> 48);
        buf[p + 7] = (byte)(v >> 56);
        len = p + 8;
    }

    // 追加一段已编码字节（嵌套文档/数组整体拼接用）。
    public void RawBytes(byte[] b) {
        EnsureRoom(b.Length);
        NativeMemory.Copy((nint)buf + len, (nint)b, b.Length);
        len = len + b.Length;
    }

    // 元素类型字节（0x01 double … 0x12 int64）。
    // 供门面在拼接嵌套值前写类型用。
    public void RawType(int t) { RawU8(t); }

    // 预留 4 字节文档长度头，返回文档起点偏移（配合 EndDocument 原地回填，消除嵌套子缓冲分配与拷贝）。
    public int BeginDocument() {
        int start = len;
        EnsureRoom(4);
        len = len + 4;
        return start;
    }

    // 写入文档终止 NUL 并在 start 处原地回填 4 字节小端总长度。
    public void EndDocument(int start) {
        RawU8(0);
        int total = len - start;
        buf[start] = (byte)total;
        buf[start + 1] = (byte)(total >> 8);
        buf[start + 2] = (byte)(total >> 16);
        buf[start + 3] = (byte)(total >> 24);
    }

    // 拷贝当前已写入字节 [0, len) 成精确长度数组。
    public byte[] ToBytes() {
        byte[] out2 = new byte[len];
        if (len > 0) {
            NativeMemory.Copy((nint)out2, (nint)buf, len);
        }
        return out2;
    }

    // cstring（元素名）：字节后补一个 NUL。键含 NUL
    // 无法在线上表示，抛 BsonException。零中间 byte[] 分配直写。
    public void CStr(string s) {
        int n = s.Length;
        if (n > 0) {
            if (n >= BsonWriter.MaxTotalBytes) {
                throw new BsonException("key length exceeds 512MB write limit");
            }
            if (NativeMemory.Find((nint)s, 0, 0, n) >= 0) {
                throw new BsonException("key contains NUL: " + s);
            }
            EnsureRoom(n + 1);
            NativeMemory.PutString((nint)buf, len, s, n);
            len = len + n;
            buf[len] = 0;
            len = len + 1;
        } else {
            RawU8(0);
        }
    }

    // string 值：int32 字节数（含终止 NUL）+ UTF-8 字节 +
    // NUL。长度前缀消歧，值内 NUL 合法（bson-corpus "Embedded
    // nulls" 向量）；cstring 键才禁 NUL（见 CStr）。零中间 byte[] 直写。
    public void WriteString(string s) {
        int n = s.Length;
        if (n > BsonWriter.MaxTotalBytes - 5) {
            throw new BsonException("string length exceeds 512MB write limit");
        }
        int slen = n + 1;
        EnsureRoom(n + 5);
        int p = len;
        buf[p] = (byte)slen;
        buf[p + 1] = (byte)(slen >> 8);
        buf[p + 2] = (byte)(slen >> 16);
        buf[p + 3] = (byte)(slen >> 24);
        if (n > 0) {
            NativeMemory.PutString((nint)buf, p + 4, s, n);
        }
        buf[p + 4 + n] = 0;
        len = p + 5 + n;
    }

    public void WriteDouble(double d) {
        RawU64LE(NativeMemory.AsI64(d));
    }

    // bool：规范要求 0x00/0x01 单字节。
    public void WriteBool(bool b) { RawU8(b ? 1 : 0); }

    public void WriteInt32(int v) { RawU32LE(v & 4294967295); }

    public void WriteInt64(long v) { RawU64LE(v); }

    // 收尾成一个完整文档：前置 int32 总长（含自身与终止
    // NUL）+ 主体 + 0x00，整体拷出。
    public byte[] FinishDocument() {
        if ((long)len + 5L > (long)BsonWriter.MaxTotalBytes) {
            throw new BsonException("document size exceeds 512MB write limit");
        }
        int total = len + 5;
        byte[] out2 = new byte[total];
        out2[0] = (byte)total;
        out2[1] = (byte)(total >> 8);
        out2[2] = (byte)(total >> 16);
        out2[3] = (byte)(total >> 24);
        NativeMemory.Copy((nint)out2 + 4, (nint)buf, len);
        out2[total - 1] = 0;
        return out2;
    }
}
