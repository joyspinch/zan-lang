using System;
namespace System.Linq;

// GroupBy 产生的一组结果：key 及其元素。
public class Grouping<T> {
    // 分组键的字符串形式（始终设置）。
    public string Key;
    // 使用 GroupBy(KeySelector) 分组时的整数键。
    public int IntKey;
    // 组内元素（按出现顺序）。
    public List<T> Items;

    // 空组：键为空串、元素列表为空。
    public Grouping() {
        Key = "";
        IntKey = 0;
        Items = new List<T>();
    }
}
