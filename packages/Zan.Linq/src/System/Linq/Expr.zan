using System;
namespace System.Linq;

// 目标类型表达式包装器。类型参数 T 为 lambda 遍历的实体或
// 元素类型；声明了
// <c>Expr&lt;T&gt;</c> 参数的方法会以表达式树形式接收 lambda。
public class Expr<T> {
    // 表达式树的根节点；未构造时为 null。
    public ExprNode Root;

    // 空包装：Root 为 null（经 <see cref="From"/> 装入树）。
    public Expr() {
        Root = null;
    }

    // 以给定的根节点包装成一个 Expr<T>。
    public static Expr<T> From(ExprNode root) {
        Expr<T> e = new Expr<T>();
        e.Root = root;
        return e;
    }
}
