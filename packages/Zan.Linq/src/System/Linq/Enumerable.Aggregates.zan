using System;
using System.Collections.Generic;

namespace System.Linq;

// Enumerable.Aggregates.zan - LINQ 聚合计算 (Sum/Min/Max/Average/Aggregate)、
// SQL 扩展算子 (Like/In)、堆 Top-K 优先选择、集合代数 (Union/Intersect/Except) 与字典映射转换 (ToDict)
public partial class Enumerable {

    // 整数序列的和。
    public static int Sum(this List<int> src) {
        int total = 0;
        for (int i = 0; i < src.Count; i = i + 1) {
            total = total + src[i];
        }
        return total;
    }

    // double 序列的和（SumNum 的 C# 风格重载；
    // 由接收者的元素类型选择该重载）。
    public static double Sum(this List<double> src) {
        return Enumerable.SumNum(src);
    }

    // 序列上 double 键之和。
    public static double Sum<T>(this List<T> src, NumKeySelector<T> key) {
        return Enumerable.SumNum<T>(src, key);
    }

    // double 序列的和。
    public static double SumNum(this List<double> src) {
        double total = 0.0;
        for (int i = 0; i < src.Count; i = i + 1) {
            total = total + src[i];
        }
        return total;
    }

    // 序列上整数键之和。
    public static int Sum<T>(this List<T> src, KeySelector<T> key) {
        int total = 0;
        for (int i = 0; i < src.Count; i = i + 1) {
            total = total + key(src[i]);
        }
        return total;
    }

    // 序列上 double 键之和。
    public static double SumNum<T>(this List<T> src, NumKeySelector<T> key) {
        double total = 0.0;
        for (int i = 0; i < src.Count; i = i + 1) {
            total = total + key(src[i]);
        }
        return total;
    }

    // 整数序列的最小值（为空时为 0）。
    public static int Min(this List<int> src) {
        if (src.Count == 0) { return 0; }
        int m = src[0];
        for (int i = 1; i < src.Count; i = i + 1) {
            if (src[i] < m) { m = src[i]; }
        }
        return m;
    }

    // double 序列的最小值（MinNum 的 C# 风格重载；
    // 由接收者的元素类型选择该重载）。
    public static double Min(this List<double> src) {
        return Enumerable.MinNum(src);
    }

    // double 序列的最小值（为空时为 0）。
    public static double MinNum(this List<double> src) {
        if (src.Count == 0) { return 0.0; }
        double m = src[0];
        for (int i = 1; i < src.Count; i = i + 1) {
            if (src[i] < m) { m = src[i]; }
        }
        return m;
    }

    // 序列上最小整数键（为空时为 0）。
    public static int Min<T>(this List<T> src, KeySelector<T> key) {
        if (src.Count == 0) { return 0; }
        int m = key(src[0]);
        for (int i = 1; i < src.Count; i = i + 1) {
            int k = key(src[i]);
            if (k < m) { m = k; }
        }
        return m;
    }

    // 整数序列的最大值（为空时为 0）。
    public static int Max(this List<int> src) {
        if (src.Count == 0) { return 0; }
        int m = src[0];
        for (int i = 1; i < src.Count; i = i + 1) {
            if (src[i] > m) { m = src[i]; }
        }
        return m;
    }

    // double 序列的最大值（MaxNum 的 C# 风格重载；
    // MaxNum）。
    public static double Max(this List<double> src) {
        return Enumerable.MaxNum(src);
    }

    // double 序列的最大值（为空时为 0）。
    public static double MaxNum(this List<double> src) {
        if (src.Count == 0) { return 0.0; }
        double m = src[0];
        for (int i = 1; i < src.Count; i = i + 1) {
            if (src[i] > m) { m = src[i]; }
        }
        return m;
    }

    // 序列上最大整数键（为空时为 0）。
    public static int Max<T>(this List<T> src, KeySelector<T> key) {
        if (src.Count == 0) { return 0; }
        int m = key(src[0]);
        for (int i = 1; i < src.Count; i = i + 1) {
            int k = key(src[i]);
            if (k > m) { m = k; }
        }
        return m;
    }

    // 整数序列的平均值；为空时抛出。
    public static double Average(this List<int> src) {
        if (src.Count == 0) {
            throw new InvalidOperationException("Sequence contains no elements");
        }
        double total = 0.0;
        for (int i = 0; i < src.Count; i = i + 1) {
            total = total + (double)src[i];
        }
        return total / (double)src.Count;
    }

    // double 序列的平均值（AverageNum 的 C# 风格重载；
    // AverageNum）。
    public static double Average(this List<double> src) {
        return Enumerable.AverageNum(src);
    }

    // double 序列的平均值；为空时抛出。
    public static double AverageNum(this List<double> src) {
        if (src.Count == 0) {
            throw new InvalidOperationException("Sequence contains no elements");
        }
        double total = 0.0;
        for (int i = 0; i < src.Count; i = i + 1) {
            total = total + src[i];
        }
        return total / (double)src.Count;
    }

    // 序列上整数键的平均值；为空时抛出。
    public static double Average<T>(this List<T> src, KeySelector<T> key) {
        if (src.Count == 0) {
            throw new InvalidOperationException("Sequence contains no elements");
        }
        double total = 0.0;
        for (int i = 0; i < src.Count; i = i + 1) {
            total = total + (double)key(src[i]);
        }
        return total / (double)src.Count;
    }

    // 对字符串序列执行 SQL LIKE：'%' 匹配任意连续
    // 字符，'_' 恰好匹配一个（如 "a%"、"%.log"、"b_b"）。
    public static List<string> Like(this List<string> src, string pattern) {
        List<string> outp = new List<string>();
        for (int i = 0; i < src.Count; i = i + 1) {
            if (Enumerable.LikeMatch(src[i], pattern)) { outp.Add(src[i]); }
        }
        return outp;
    }

    // text 匹配 SQL LIKE 模式（'%'/'_'）时返回 true。
    public static bool LikeMatch(string text, string pattern) {
        return Enumerable.LikeAt(text, 0, pattern, 0);
    }

    // LikeMatch 的递归体：'%' 尝试消耗任意长度，'_' 匹配单个字符。
    public static bool LikeAt(string t, int ti, string p, int pi) {
        while (pi < p.Length) {
            string pc = p.Substring(pi, 1);
            if (pc == "%") {
                if (Enumerable.LikeAt(t, ti, p, pi + 1)) { return true; }
                int k = ti;
                while (k < t.Length) {
                    if (Enumerable.LikeAt(t, k + 1, p, pi + 1)) { return true; }
                    k = k + 1;
                }
                return false;
            }
            if (ti >= t.Length) { return false; }
            if (pc != "_" && pc != t.Substring(ti, 1)) { return false; }
            ti = ti + 1;
            pi = pi + 1;
        }
        return ti == t.Length;
    }

    // SQL IN：保留 values 中存在的元素（使用 ==）。基于哈希加速。
    public static List<T> In<T>(this List<T> src, List<T> values) {
        List<T> outp = new List<T>();
        if (values.Count <= 4) {
            for (int i = 0; i < src.Count; i = i + 1) {
                if (Enumerable.Contains<T>(values, src[i])) { outp.Add(src[i]); }
            }
            return outp;
        }
        Dict<T, bool> valSet = new Dict<T, bool>();
        for (int vi = 0; vi < values.Count; vi = vi + 1) {
            valSet[values[vi]] = true;
        }
        for (int i = 0; i < src.Count; i = i + 1) {
            if (valSet.ContainsKey(src[i])) { outp.Add(src[i]); }
        }
        return outp;
    }

    // 在给定相等比较器下的 SQL IN（对引用类型
    // 采用 Equals 风格语义）。
    public static List<T> In<T>(this List<T> src, List<T> values, EqualityComparer<T> eq) {
        List<T> outp = new List<T>();
        for (int i = 0; i < src.Count; i = i + 1) {
            if (Enumerable.Contains<T>(values, src[i], eq)) { outp.Add(src[i]); }
        }
        return outp;
    }

    // 对字符串执行 SQL IN，按值比较（InStr 的 C# 风格重载；
    // InStr）。
    public static List<string> In(this List<string> src, List<string> values) {
        return Enumerable.InStr(src, values);
    }

    // 对字符串执行 SQL IN，按值比较。基于哈希加速。
    public static List<string> InStr(this List<string> src, List<string> values) {
        List<string> outp = new List<string>();
        if (values.Count <= 4) {
            for (int i = 0; i < src.Count; i = i + 1) {
                if (Enumerable.ContainsStr(values, src[i])) { outp.Add(src[i]); }
            }
            return outp;
        }
        Dict<string, bool> valSet = new Dict<string, bool>();
        for (int vi = 0; vi < values.Count; vi = vi + 1) {
            valSet[values[vi]] = true;
        }
        for (int i = 0; i < src.Count; i = i + 1) {
            if (valSet.ContainsKey(src[i])) { outp.Add(src[i]); }
        }
        return outp;
    }

    // 基于优先队列（堆）求整数键最小的前 k 个元素（升序排序，O(N log K)）。
    // 当 k 远小于序列长度时，显著优于全量排序后再 Take。
    public static List<T> TakeTop<T>(this List<T> src, KeySelector<T> key, int k) {
        if (k <= 0 || src.Count == 0) { return new List<T>(); }
        if (k >= src.Count) { return Enumerable.MergeSortInt<T>(src, key, 1); }
        List<T> hItem = new List<T>();
        List<int> hKey = new List<int>();
        for (int i = 0; i < src.Count; i = i + 1) {
            T item = src[i];
            int kv = key(item);
            if (hItem.Count < k) {
                hItem.Add(item);
                hKey.Add(kv);
                int c = hItem.Count - 1;
                while (c > 0) {
                    int p = (c - 1) / 2;
                    if (hKey[c] > hKey[p]) {
                        int tk = hKey[c]; hKey[c] = hKey[p]; hKey[p] = tk;
                        T ti = hItem[c]; hItem[c] = hItem[p]; hItem[p] = ti;
                        c = p;
                    } else {
                        break;
                    }
                }
            } else if (kv < hKey[0]) {
                hItem[0] = item;
                hKey[0] = kv;
                int p = 0;
                int n = hItem.Count;
                while (p * 2 + 1 < n) {
                    int left = p * 2 + 1;
                    int right = left + 1;
                    int largest = p;
                    if (left < n && hKey[left] > hKey[largest]) { largest = left; }
                    if (right < n && hKey[right] > hKey[largest]) { largest = right; }
                    if (largest == p) {
                        break;
                    }
                    int tk = hKey[p]; hKey[p] = hKey[largest]; hKey[largest] = tk;
                    T ti = hItem[p]; hItem[p] = hItem[largest]; hItem[largest] = ti;
                    p = largest;
                }
            }
        }
        int cur = hItem.Count;
        while (cur > 1) {
            int last = cur - 1;
            int tk = hKey[0]; hKey[0] = hKey[last]; hKey[last] = tk;
            T ti = hItem[0]; hItem[0] = hItem[last]; hItem[last] = ti;
            cur = last;
            int p = 0;
            while (p * 2 + 1 < cur) {
                int left = p * 2 + 1;
                int right = left + 1;
                int largest = p;
                if (left < cur && hKey[left] > hKey[largest]) { largest = left; }
                if (right < cur && hKey[right] > hKey[largest]) { largest = right; }
                if (largest == p) {
                    break;
                }
                int swk = hKey[p]; hKey[p] = hKey[largest]; hKey[largest] = swk;
                T swi = hItem[p]; hItem[p] = hItem[largest]; hItem[largest] = swi;
                p = largest;
            }
        }
        return hItem;
    }

    // 基于优先队列（堆）求整数键最大的前 k 个元素（降序排序，O(N log K)）。
    public static List<T> TakeTopDescending<T>(this List<T> src, KeySelector<T> key, int k) {
        if (k <= 0 || src.Count == 0) { return new List<T>(); }
        if (k >= src.Count) { return Enumerable.MergeSortInt<T>(src, key, -1); }
        List<T> hItem = new List<T>();
        List<int> hKey = new List<int>();
        for (int i = 0; i < src.Count; i = i + 1) {
            T item = src[i];
            int kv = key(item);
            if (hItem.Count < k) {
                hItem.Add(item);
                hKey.Add(kv);
                int c = hItem.Count - 1;
                while (c > 0) {
                    int p = (c - 1) / 2;
                    if (hKey[c] < hKey[p]) {
                        int tk = hKey[c]; hKey[c] = hKey[p]; hKey[p] = tk;
                        T ti = hItem[c]; hItem[c] = hItem[p]; hItem[p] = ti;
                        c = p;
                    } else {
                        break;
                    }
                }
            } else if (kv > hKey[0]) {
                hItem[0] = item;
                hKey[0] = kv;
                int p = 0;
                int n = hItem.Count;
                while (p * 2 + 1 < n) {
                    int left = p * 2 + 1;
                    int right = left + 1;
                    int smallest = p;
                    if (left < n && hKey[left] < hKey[smallest]) { smallest = left; }
                    if (right < n && hKey[right] < hKey[smallest]) { smallest = right; }
                    if (smallest == p) {
                        break;
                    }
                    int tk = hKey[p]; hKey[p] = hKey[smallest]; hKey[smallest] = tk;
                    T ti = hItem[p]; hItem[p] = hItem[smallest]; hItem[smallest] = ti;
                    p = smallest;
                }
            }
        }
        int cur = hItem.Count;
        while (cur > 1) {
            int last = cur - 1;
            int tk = hKey[0]; hKey[0] = hKey[last]; hKey[last] = tk;
            T ti = hItem[0]; hItem[0] = hItem[last]; hItem[last] = ti;
            cur = last;
            int p = 0;
            while (p * 2 + 1 < cur) {
                int left = p * 2 + 1;
                int right = left + 1;
                int smallest = p;
                if (left < cur && hKey[left] < hKey[smallest]) { smallest = left; }
                if (right < cur && hKey[right] < hKey[smallest]) { smallest = right; }
                if (smallest == p) {
                    break;
                }
                int swk = hKey[p]; hKey[p] = hKey[smallest]; hKey[smallest] = swk;
                T swi = hItem[p]; hItem[p] = hItem[smallest]; hItem[smallest] = swi;
                p = smallest;
            }
        }
        return hItem;
    }

    // ===== 集合代数算子（基于哈希 O(N + M) 加速） =====

    // 并集并去重（保留元素首次出现的顺序，O(N + M)）。
    public static List<T> Union<T>(this List<T> first, List<T> second) {
        List<T> outp = new List<T>();
        Dict<T, bool> seen = new Dict<T, bool>();
        for (int i = 0; i < first.Count; i = i + 1) {
            T item = first[i];
            if (!seen.ContainsKey(item)) {
                seen[item] = true;
                outp.Add(item);
            }
        }
        for (int i = 0; i < second.Count; i = i + 1) {
            T item = second[i];
            if (!seen.ContainsKey(item)) {
                seen[item] = true;
                outp.Add(item);
            }
        }
        return outp;
    }

    // 字符串并集并去重（保留元素首次出现的顺序，O(N + M)）。
    public static List<string> UnionStr(this List<string> first, List<string> second) {
        List<string> outp = new List<string>();
        Dict<string, bool> seen = new Dict<string, bool>();
        for (int i = 0; i < first.Count; i = i + 1) {
            string item = first[i];
            if (!seen.ContainsKey(item)) {
                seen[item] = true;
                outp.Add(item);
            }
        }
        for (int i = 0; i < second.Count; i = i + 1) {
            string item = second[i];
            if (!seen.ContainsKey(item)) {
                seen[item] = true;
                outp.Add(item);
            }
        }
        return outp;
    }

    // 交集并去重（保留在 first 中首次出现的顺序，O(N + M)）。
    public static List<T> Intersect<T>(this List<T> first, List<T> second) {
        List<T> outp = new List<T>();
        if (first.Count == 0 || second.Count == 0) { return outp; }
        Dict<T, bool> secondSet = new Dict<T, bool>();
        for (int i = 0; i < second.Count; i = i + 1) {
            secondSet[second[i]] = true;
        }
        Dict<T, bool> emitted = new Dict<T, bool>();
        for (int i = 0; i < first.Count; i = i + 1) {
            T item = first[i];
            if (secondSet.ContainsKey(item) && !emitted.ContainsKey(item)) {
                emitted[item] = true;
                outp.Add(item);
            }
        }
        return outp;
    }

    // 字符串交集并去重（保留在 first 中首次出现的顺序，O(N + M)）。
    public static List<string> IntersectStr(this List<string> first, List<string> second) {
        List<string> outp = new List<string>();
        if (first.Count == 0 || second.Count == 0) { return outp; }
        Dict<string, bool> secondSet = new Dict<string, bool>();
        for (int i = 0; i < second.Count; i = i + 1) {
            secondSet[second[i]] = true;
        }
        Dict<string, bool> emitted = new Dict<string, bool>();
        for (int i = 0; i < first.Count; i = i + 1) {
            string item = first[i];
            if (secondSet.ContainsKey(item) && !emitted.ContainsKey(item)) {
                emitted[item] = true;
                outp.Add(item);
            }
        }
        return outp;
    }

    // 差集并去重（属于 first 且不属于 second 的元素，保留首次出现的顺序，O(N + M)）。
    public static List<T> Except<T>(this List<T> first, List<T> second) {
        List<T> outp = new List<T>();
        if (first.Count == 0) { return outp; }
        Dict<T, bool> secondSet = new Dict<T, bool>();
        for (int i = 0; i < second.Count; i = i + 1) {
            secondSet[second[i]] = true;
        }
        Dict<T, bool> emitted = new Dict<T, bool>();
        for (int i = 0; i < first.Count; i = i + 1) {
            T item = first[i];
            if (!secondSet.ContainsKey(item) && !emitted.ContainsKey(item)) {
                emitted[item] = true;
                outp.Add(item);
            }
        }
        return outp;
    }

    // 字符串差集并去重（属于 first 且不属于 second 的元素，保留首次出现的顺序，O(N + M)）。
    public static List<string> ExceptStr(this List<string> first, List<string> second) {
        List<string> outp = new List<string>();
        if (first.Count == 0) { return outp; }
        Dict<string, bool> secondSet = new Dict<string, bool>();
        for (int i = 0; i < second.Count; i = i + 1) {
            secondSet[second[i]] = true;
        }
        Dict<string, bool> emitted = new Dict<string, bool>();
        for (int i = 0; i < first.Count; i = i + 1) {
            string item = first[i];
            if (!secondSet.ContainsKey(item) && !emitted.ContainsKey(item)) {
                emitted[item] = true;
                outp.Add(item);
            }
        }
        return outp;
    }

    // 将序列转换为 Dict&lt;int, T&gt; 映射表（整数键，值为元素本身）。
    public static Dict<int, T> ToDictInt<T>(this List<T> src, KeySelector<T> keySel) {
        Dict<int, T> dict = new Dict<int, T>();
        for (int i = 0; i < src.Count; i = i + 1) {
            T item = src[i];
            dict[keySel(item)] = item;
        }
        return dict;
    }

    // 将序列转换为 Dict&lt;string, T&gt; 映射表（字符串键，值为元素本身）。
    public static Dict<string, T> ToDictStr<T>(this List<T> src, StrKeySelector<T> keySel) {
        Dict<string, T> dict = new Dict<string, T>();
        for (int i = 0; i < src.Count; i = i + 1) {
            T item = src[i];
            dict[keySel(item)] = item;
        }
        return dict;
    }

    // 将序列转换为 Dict&lt;int, V&gt; 映射表（整数键，自定义值投影）。
    public static Dict<int, V> ToDictInt<T, V>(this List<T> src, KeySelector<T> keySel, Selector<T, V> valSel) {
        Dict<int, V> dict = new Dict<int, V>();
        for (int i = 0; i < src.Count; i = i + 1) {
            T item = src[i];
            dict[keySel(item)] = valSel(item);
        }
        return dict;
    }

    // 将序列转换为 Dict&lt;string, V&gt; 映射表（字符串键，自定义值投影）。
    public static Dict<string, V> ToDictStr<T, V>(this List<T> src, StrKeySelector<T> keySel, Selector<T, V> valSel) {
        Dict<string, V> dict = new Dict<string, V>();
        for (int i = 0; i < src.Count; i = i + 1) {
            T item = src[i];
            dict[keySel(item)] = valSel(item);
        }
        return dict;
    }
}
