using System;

namespace System.Linq;

// 针对 <see cref="List&lt;T&gt;"/> 的零分配惰性求值流水线（Stream Pipeline）。
// 核心特性：
// 1. 零中间分配（Zero Allocation）：Where/Skip/Take/TakeWhile 不创建任何中间 List；
// 2. 短路提前终止（Short-Circuiting）：Take(k)、First()、Any() 在满足条件时立即 break，不再扫描后续元素；
// 3. 单趟遍历（Single Pass）：所有谓词在一个内联循环中流水线式过滤，CPU 缓存行高度亲和。
// 示例：
// .Where((User u) => u.age >= 18)
// .Skip(20)
// .Take(10)
// .Select&lt;int&gt;((User u) => u.id)
// .ToList();
public class Stream<T> {
    public List<T> src;
    public List<Predicate<T>> filters;
    public Predicate<T> takeWhilePred;
    public int skipN;
    public int takeN;
    public bool distinct;

    public Stream(List<T> src) {
        this.src = src;
        this.filters = new List<Predicate<T>>();
        this.takeWhilePred = null;
        this.skipN = 0;
        this.takeN = -1;
        this.distinct = false;
    }

    // 克隆当前流的配置副本。
    public Stream<T> Clone() {
        Stream<T> c = new Stream<T>(this.src);
        for (int i = 0; i < this.filters.Count; i = i + 1) {
            c.filters.Add(this.filters[i]);
        }
        c.takeWhilePred = this.takeWhilePred;
        c.skipN = this.skipN;
        c.takeN = this.takeN;
        c.distinct = this.distinct;
        return c;
    }

    // 从 List 创建流。
    public static Stream<T> Of(List<T> src) {
        return new Stream<T>(src);
    }

    // 保留满足谓词的元素（中间操作，惰性追加）。多次调用按 AND 组合。
    public Stream<T> Where(Predicate<T> pred) {
        this.filters.Add(pred);
        return this;
    }

    // 跳过前 n 个满足过滤条件的元素（中间操作）。
    public Stream<T> Skip(int n) {
        this.skipN = this.skipN + n;
        return this;
    }

    // 截取最多 n 个元素（中间操作，在终结操作时支持极速短路）。
    public Stream<T> Take(int n) {
        if (this.takeN < 0 || n < this.takeN) {
            this.takeN = n;
        }
        return this;
    }

    // 当谓词返回 true 时持续提取，遇到首个 false 立即终结整条流（中间操作）。
    public Stream<T> TakeWhile(Predicate<T> pred) {
        this.takeWhilePred = pred;
        return this;
    }

    // 流式去重（中间操作，基于哈希表保证唯一性）。
    public Stream<T> Distinct() {
        this.distinct = true;
        return this;
    }

    // 使用 selector 变换元素类型并开启新子流（中间操作）。
    public Stream<R> Select<R>(Selector<T, R> selector) {
        List<R> mapped = new List<R>();
        int skipped = 0;
        Dict<T, bool> seen = this.distinct ? new Dict<T, bool>() : null;

        for (int i = 0; i < this.src.Count; i = i + 1) {
            T item = this.src[i];
            if (this.takeWhilePred != null && !this.takeWhilePred(item)) {
                break;
            }
            bool pass = true;
            for (int f = 0; f < this.filters.Count; f = f + 1) {
                if (!this.filters[f](item)) {
                    pass = false;
                    break;
                }
            }
            if (pass) {
                if (seen != null) {
                    if (seen.ContainsKey(item)) { continue; }
                    seen[item] = true;
                }
                if (skipped < this.skipN) {
                    skipped = skipped + 1;
                } else {
                    mapped.Add(selector(item));
                    if (this.takeN >= 0 && mapped.Count >= this.takeN) {
                        break;
                    }
                }
            }
        }
        return new Stream<R>(mapped);
    }

    // ===== 终结操作（Terminal Operations） =====

    // 物化为新的 List&lt;T&gt;（单趟遍历，按需提前终止）。
    public List<T> ToList() {
        List<T> res = new List<T>();
        if (this.takeN == 0) { return res; }

        int skipped = 0;
        Dict<T, bool> seen = this.distinct ? new Dict<T, bool>() : null;

        for (int i = 0; i < this.src.Count; i = i + 1) {
            T item = this.src[i];
            if (this.takeWhilePred != null && !this.takeWhilePred(item)) {
                break;
            }
            bool pass = true;
            for (int f = 0; f < this.filters.Count; f = f + 1) {
                if (!this.filters[f](item)) {
                    pass = false;
                    break;
                }
            }
            if (pass) {
                if (seen != null) {
                    if (seen.ContainsKey(item)) { continue; }
                    seen[item] = true;
                }
                if (skipped < this.skipN) {
                    skipped = skipped + 1;
                } else {
                    res.Add(item);
                    if (this.takeN >= 0 && res.Count >= this.takeN) {
                        break;
                    }
                }
            }
        }
        return res;
    }

    // 返回第一个匹配元素。匹配到立即退出循环（短路）。空序列抛异常。
    public T First() {
        List<T> r = this.Clone().Take(1).ToList();
        if (r.Count == 0) {
            throw new InvalidOperationException("Sequence contains no elements");
        }
        return r[0];
    }

    // 返回第一个匹配元素，无匹配时返回给定的默认值。匹配到立即退出循环（短路）。
    public T FirstOrDefault(T dflt) {
        List<T> r = this.Clone().Take(1).ToList();
        if (r.Count > 0) { return r[0]; }
        return dflt;
    }

    // 是否存在至少一个满足流过滤条件的元素（找到首个匹配项即短路退出）。
    public bool Any() {
        List<T> r = this.Clone().Take(1).ToList();
        return r.Count > 0;
    }

    // 流中是否存在满足特定谓词的元素（短路）。
    public bool Any(Predicate<T> pred) {
        return this.Clone().Where(pred).Any();
    }

    // 流中是否所有满足现有过滤的元素均满足给定谓词（短路）。
    public bool All(Predicate<T> pred) {
        int skipped = 0;
        Dict<T, bool> seen = this.distinct ? new Dict<T, bool>() : null;

        for (int i = 0; i < this.src.Count; i = i + 1) {
            T item = this.src[i];
            if (this.takeWhilePred != null && !this.takeWhilePred(item)) {
                break;
            }
            bool pass = true;
            for (int f = 0; f < this.filters.Count; f = f + 1) {
                if (!this.filters[f](item)) {
                    pass = false;
                    break;
                }
            }
            if (pass) {
                if (seen != null) {
                    if (seen.ContainsKey(item)) { continue; }
                    seen[item] = true;
                }
                if (skipped < this.skipN) {
                    skipped = skipped + 1;
                } else {
                    if (!pred(item)) {
                        return false;
                    }
                    if (this.takeN >= 0) {
                        // 计数控制
                    }
                }
            }
        }
        return true;
    }

    // 统计匹配元素总数（尊重 Take/Skip 约束）。
    public int Count() {
        if (this.takeN == 0) { return 0; }
        int count = 0;
        int skipped = 0;
        Dict<T, bool> seen = this.distinct ? new Dict<T, bool>() : null;

        for (int i = 0; i < this.src.Count; i = i + 1) {
            T item = this.src[i];
            if (this.takeWhilePred != null && !this.takeWhilePred(item)) {
                break;
            }
            bool pass = true;
            for (int f = 0; f < this.filters.Count; f = f + 1) {
                if (!this.filters[f](item)) {
                    pass = false;
                    break;
                }
            }
            if (pass) {
                if (seen != null) {
                    if (seen.ContainsKey(item)) { continue; }
                    seen[item] = true;
                }
                if (skipped < this.skipN) {
                    skipped = skipped + 1;
                } else {
                    count = count + 1;
                    if (this.takeN >= 0 && count >= this.takeN) {
                        break;
                    }
                }
            }
        }
        return count;
    }

    // 遍历消费流中每一个有效元素。
    public void ForEach(Action<T> action) {
        int skipped = 0;
        int yielded = 0;
        Dict<T, bool> seen = this.distinct ? new Dict<T, bool>() : null;

        for (int i = 0; i < this.src.Count; i = i + 1) {
            T item = this.src[i];
            if (this.takeWhilePred != null && !this.takeWhilePred(item)) {
                break;
            }
            bool pass = true;
            for (int f = 0; f < this.filters.Count; f = f + 1) {
                if (!this.filters[f](item)) {
                    pass = false;
                    break;
                }
            }
            if (pass) {
                if (seen != null) {
                    if (seen.ContainsKey(item)) { continue; }
                    seen[item] = true;
                }
                if (skipped < this.skipN) {
                    skipped = skipped + 1;
                } else {
                    action(item);
                    yielded = yielded + 1;
                    if (this.takeN >= 0 && yielded >= this.takeN) {
                        break;
                    }
                }
            }
        }
    }

    // 返回最后一个匹配元素。空序列抛异常。
    public T Last() {
        List<T> r = this.ToList();
        if (r.Count == 0) {
            throw new InvalidOperationException("Sequence contains no elements");
        }
        return r[r.Count - 1];
    }

    // 返回最后一个匹配元素，无匹配时返回给定的默认值。
    public T LastOrDefault(T dflt) {
        List<T> r = this.ToList();
        if (r.Count > 0) { return r[r.Count - 1]; }
        return dflt;
    }

    // 返回流中指定索引处的元素。索引越界抛异常。
    public T ElementAt(int index) {
        if (index < 0) {
            throw new ArgumentOutOfRangeException("index");
        }
        List<T> r = this.Clone().Skip(index).Take(1).ToList();
        if (r.Count == 0) {
            throw new ArgumentOutOfRangeException("index");
        }
        return r[0];
    }

    // 返回流中指定索引处的元素，越界时返回默认值。
    public T ElementAtOrDefault(int index, T dflt) {
        if (index < 0) { return dflt; }
        List<T> r = this.Clone().Skip(index).Take(1).ToList();
        if (r.Count > 0) { return r[0]; }
        return dflt;
    }

    // 检查流中是否包含指定元素。
    public bool Contains(T item) {
        foreach (var x in this) {
            if (x == item) { return true; }
        }
        return false;
    }

    // 在流末尾追加一个元素。
    public Stream<T> Append(T item) {
        List<T> current = this.ToList();
        current.Add(item);
        return new Stream<T>(current);
    }

    // 在流头部追加一个元素。
    public Stream<T> Prepend(T item) {
        List<T> current = new List<T>();
        current.Add(item);
        List<T> rest = this.ToList();
        for (int i = 0; i < rest.Count; i = i + 1) {
            current.Add(rest[i]);
        }
        return new Stream<T>(current);
    }

    // 连接另一个流。
    public Stream<T> Concat(Stream<T> other) {
        List<T> current = this.ToList();
        List<T> next = other.ToList();
        for (int i = 0; i < next.Count; i = i + 1) {
            current.Add(next[i]);
        }
        return new Stream<T>(current);
    }

    // 为流开启原生 duck-typed foreach 迭代器支持
    public StreamEnumerator<T> GetEnumerator() {
        return new StreamEnumerator<T>(this);
    }
}

// 针对 Stream<T> 的轻量单趟流式迭代器，实现 GetEnumerator / MoveNext / Current 协议。
public class StreamEnumerator<T> {
    Stream<T> stream;
    int index;
    int yielded;
    int skipped;
    T current;
    Dict<T, bool> seen;

    public StreamEnumerator(Stream<T> stream) {
        this.stream = stream;
        this.index = 0;
        this.yielded = 0;
        this.skipped = 0;
        this.seen = stream.distinct ? new Dict<T, bool>() : null;
    }

    public bool MoveNext() {
        if (this.stream.takeN >= 0 && this.yielded >= this.stream.takeN) {
            return false;
        }
        while (this.index < this.stream.src.Count) {
            T item = this.stream.src[this.index];
            this.index = this.index + 1;
            if (this.stream.takeWhilePred != null && !this.stream.takeWhilePred(item)) {
                return false;
            }
            bool pass = true;
            for (int f = 0; f < this.stream.filters.Count; f = f + 1) {
                if (!this.stream.filters[f](item)) {
                    pass = false;
                    break;
                }
            }
            if (pass) {
                if (this.seen != null) {
                    if (this.seen.ContainsKey(item)) { continue; }
                    this.seen[item] = true;
                }
                if (this.skipped < this.stream.skipN) {
                    this.skipped = this.skipped + 1;
                    continue;
                }
                this.current = item;
                this.yielded = this.yielded + 1;
                return true;
            }
        }
        return false;
    }

    public T Current {
        get { return this.current; }
    }
}

