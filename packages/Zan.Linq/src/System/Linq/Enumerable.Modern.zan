using System;
using System.Collections.Generic;

namespace System.Linq;

// Enumerable.Modern.zan - 现代化 LINQ 高频操作符：
// Chunk (序列分块)、DistinctBy (键去重)、MinBy/MaxBy (键极值选择)、
// Zip (序列拉链组合)、SequenceEqual (序列一致性比较)、DefaultIfEmpty (空序列保底值)、
// Prepend / Append (序列首尾追加)
public partial class Enumerable {

    // 将序列拆分成大小最多为 size 的块列表。
    public static List<List<T>> Chunk<T>(this List<T> src, int size) {
        if (size <= 0) {
            throw new ArgumentOutOfRangeException("Chunk size must be greater than 0");
        }
        List<List<T>> chunks = new List<List<T>>();
        if (src == null || src.Count == 0) {
            return chunks;
        }
        List<T> current = new List<T>();
        for (int i = 0; i < src.Count; i = i + 1) {
            current.Add(src[i]);
            if (current.Count == size) {
                chunks.Add(current);
                current = new List<T>();
            }
        }
        if (current.Count > 0) {
            chunks.Add(current);
        }
        return chunks;
    }

    // 根据指定的键选择器去重，保留首次出现的元素（基于 Dict<K, bool> 哈希查找）。
    public static List<T> DistinctBy<T, K>(this List<T> src, Selector<T, K> keySelector) {
        List<T> outp = new List<T>();
        if (src == null || src.Count == 0) { return outp; }
        Dict<K, bool> seen = new Dict<K, bool>();
        for (int i = 0; i < src.Count; i = i + 1) {
            T item = src[i];
            K k = keySelector(item);
            if (!seen.ContainsKey(k)) {
                seen[k] = true;
                outp.Add(item);
            }
        }
        return outp;
    }

    // 根据指定的键选择器求两个序列的并集（基于 Dict<K, bool>，保留首次出现的元素）。
    public static List<T> UnionBy<T, K>(this List<T> first, List<T> second, Selector<T, K> keySelector) {
        List<T> outp = new List<T>();
        if (keySelector == null) { return outp; }
        Dict<K, bool> seen = new Dict<K, bool>();
        if (first != null) {
            for (int i = 0; i < first.Count; i = i + 1) {
                T item = first[i];
                K k = keySelector(item);
                if (!seen.ContainsKey(k)) {
                    seen[k] = true;
                    outp.Add(item);
                }
            }
        }
        if (second != null) {
            for (int i = 0; i < second.Count; i = i + 1) {
                T item = second[i];
                K k = keySelector(item);
                if (!seen.ContainsKey(k)) {
                    seen[k] = true;
                    outp.Add(item);
                }
            }
        }
        return outp;
    }

    // 根据指定的键选择器求两个序列的交集（以 first 中元素为主，仅保留其键也存在于 second 的项）。
    public static List<T> IntersectBy<T, K>(this List<T> first, List<T> second, Selector<T, K> keySelector) {
        List<T> outp = new List<T>();
        if (first == null || second == null || keySelector == null) { return outp; }
        Dict<K, bool> secondKeys = new Dict<K, bool>();
        for (int i = 0; i < second.Count; i = i + 1) {
            K k = keySelector(second[i]);
            secondKeys[k] = true;
        }
        Dict<K, bool> seen = new Dict<K, bool>();
        for (int i = 0; i < first.Count; i = i + 1) {
            T item = first[i];
            K k = keySelector(item);
            if (secondKeys.ContainsKey(k) && !seen.ContainsKey(k)) {
                seen[k] = true;
                outp.Add(item);
            }
        }
        return outp;
    }

    // 根据指定的键选择器求差集（保留 first 中存在、但其键不存在于 second 的元素）。
    public static List<T> ExceptBy<T, K>(this List<T> first, List<T> second, Selector<T, K> keySelector) {
        List<T> outp = new List<T>();
        if (first == null || keySelector == null) { return outp; }
        if (second == null || second.Count == 0) {
            return first.DistinctBy(keySelector);
        }
        Dict<K, bool> secondKeys = new Dict<K, bool>();
        for (int i = 0; i < second.Count; i = i + 1) {
            K k = keySelector(second[i]);
            secondKeys[k] = true;
        }
        Dict<K, bool> seen = new Dict<K, bool>();
        for (int i = 0; i < first.Count; i = i + 1) {
            T item = first[i];
            K k = keySelector(item);
            if (!secondKeys.ContainsKey(k) && !seen.ContainsKey(k)) {
                seen[k] = true;
                outp.Add(item);
            }
        }
        return outp;
    }

    // 返回具有最小整数键的元素；若序列为空则抛出 InvalidOperationException。
    public static T MinBy<T>(this List<T> src, KeySelector<T> keySelector) {
        if (src == null || src.Count == 0) {
            throw new InvalidOperationException("Sequence contains no elements");
        }
        T minItem = src[0];
        int minKey = keySelector(minItem);
        for (int i = 1; i < src.Count; i = i + 1) {
            T item = src[i];
            int k = keySelector(item);
            if (k < minKey) {
                minKey = k;
                minItem = item;
            }
        }
        return minItem;
    }

    // 返回具有最小 double 键的元素；若序列为空则抛出 InvalidOperationException。
    public static T MinByNum<T>(this List<T> src, NumKeySelector<T> keySelector) {
        if (src == null || src.Count == 0) {
            throw new InvalidOperationException("Sequence contains no elements");
        }
        T minItem = src[0];
        double minKey = keySelector(minItem);
        for (int i = 1; i < src.Count; i = i + 1) {
            T item = src[i];
            double k = keySelector(item);
            if (k < minKey) {
                minKey = k;
                minItem = item;
            }
        }
        return minItem;
    }

    // 返回具有最小 string 键的元素；若序列为空则抛出 InvalidOperationException。
    public static T MinByStr<T>(this List<T> src, StrKeySelector<T> keySelector) {
        if (src == null || src.Count == 0) {
            throw new InvalidOperationException("Sequence contains no elements");
        }
        T minItem = src[0];
        string minKey = keySelector(minItem);
        for (int i = 1; i < src.Count; i = i + 1) {
            T item = src[i];
            string k = keySelector(item);
            if (k < minKey) {
                minKey = k;
                minItem = item;
            }
        }
        return minItem;
    }

    // 返回具有最大整数键的元素；若序列为空则抛出 InvalidOperationException。
    public static T MaxBy<T>(this List<T> src, KeySelector<T> keySelector) {
        if (src == null || src.Count == 0) {
            throw new InvalidOperationException("Sequence contains no elements");
        }
        T maxItem = src[0];
        int maxKey = keySelector(maxItem);
        for (int i = 1; i < src.Count; i = i + 1) {
            T item = src[i];
            int k = keySelector(item);
            if (k > maxKey) {
                maxKey = k;
                maxItem = item;
            }
        }
        return maxItem;
    }

    // 返回具有最大 double 键的元素；若序列为空则抛出 InvalidOperationException。
    public static T MaxByNum<T>(this List<T> src, NumKeySelector<T> keySelector) {
        if (src == null || src.Count == 0) {
            throw new InvalidOperationException("Sequence contains no elements");
        }
        T maxItem = src[0];
        double maxKey = keySelector(maxItem);
        for (int i = 1; i < src.Count; i = i + 1) {
            T item = src[i];
            double k = keySelector(item);
            if (k > maxKey) {
                maxKey = k;
                maxItem = item;
            }
        }
        return maxItem;
    }

    // 返回具有最大 string 键的元素；若序列为空则抛出 InvalidOperationException。
    public static T MaxByStr<T>(this List<T> src, StrKeySelector<T> keySelector) {
        if (src == null || src.Count == 0) {
            throw new InvalidOperationException("Sequence contains no elements");
        }
        T maxItem = src[0];
        string maxKey = keySelector(maxItem);
        for (int i = 1; i < src.Count; i = i + 1) {
            T item = src[i];
            string k = keySelector(item);
            if (k > maxKey) {
                maxKey = k;
                maxItem = item;
            }
        }
        return maxItem;
    }

    // 将两个序列通过 selector 组合成单个新序列。结果序列长度为两个序列长度的较小值。
    public static List<R> Zip<T1, T2, R>(this List<T1> first, List<T2> second, ZipSelector<T1, T2, R> selector) {
        List<R> outp = new List<R>();
        if (first == null || second == null) { return outp; }
        int count = first.Count;
        if (second.Count < count) { count = second.Count; }
        for (int i = 0; i < count; i = i + 1) {
            outp.Add(selector(first[i], second[i]));
        }
        return outp;
    }

    // 在序列开头添加指定元素并返回新序列。
    public static List<T> Prepend<T>(this List<T> src, T element) {
        List<T> outp = new List<T>();
        outp.Add(element);
        if (src != null) {
            for (int i = 0; i < src.Count; i = i + 1) {
                outp.Add(src[i]);
            }
        }
        return outp;
    }

    // 在序列末尾追加指定元素并返回新序列。
    public static List<T> Append<T>(this List<T> src, T element) {
        List<T> outp = new List<T>();
        if (src != null) {
            for (int i = 0; i < src.Count; i = i + 1) {
                outp.Add(src[i]);
            }
        }
        outp.Add(element);
        return outp;
    }

    // 判断两个序列是否元素一一对应且值相等（使用 == 比较）。
    public static bool SequenceEqual<T>(this List<T> first, List<T> second) {
        if (first == null && second == null) { return true; }
        if (first == null || second == null) { return false; }
        if (first.Count != second.Count) { return false; }
        for (int i = 0; i < first.Count; i = i + 1) {
            if (first[i] != second[i]) { return false; }
        }
        return true;
    }

    // 判断两个序列在给定相等比较器下是否元素一一对应且相等。
    public static bool SequenceEqual<T>(this List<T> first, List<T> second, EqualityComparer<T> eq) {
        if (first == null && second == null) { return true; }
        if (first == null || second == null) { return false; }
        if (first.Count != second.Count) { return false; }
        for (int i = 0; i < first.Count; i = i + 1) {
            if (!eq(first[i], second[i])) { return false; }
        }
        return true;
    }

    // 序列为空时返回包含类型默认值的单元素列表；非空时返回原序列的浅拷贝。
    public static List<T> DefaultIfEmpty<T>(this List<T> src) {
        if (src != null && src.Count > 0) {
            return Enumerable.ToList<T>(src);
        }
        List<T> outp = new List<T>();
        T d = 0;
        outp.Add(d);
        return outp;
    }

    // 序列为空时返回包含指定保底值的单元素列表；非空时返回原序列的浅拷贝。
    public static List<T> DefaultIfEmpty<T>(this List<T> src, T defaultValue) {
        if (src != null && src.Count > 0) {
            return Enumerable.ToList<T>(src);
        }
        List<T> outp = new List<T>();
        outp.Add(defaultValue);
        return outp;
    }
}
