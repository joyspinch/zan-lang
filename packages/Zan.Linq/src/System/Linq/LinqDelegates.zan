using System;

namespace System.Linq;

public delegate bool Predicate<T>(T item);
public delegate R Selector<T, R>(T item);
public delegate int KeySelector<T>(T item);
public delegate string StrKeySelector<T>(T item);
public delegate double NumKeySelector<T>(T item);
public delegate A Accumulator<T, A>(A acc, T item);
public delegate bool EqualityComparer<T>(T a, T b);
public delegate R ZipSelector<T1, T2, R>(T1 first, T2 second);
