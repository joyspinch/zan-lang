                map[k] = g;
                groups.Add(g);
            }
            Grouping<R> target = map[k];
            target.Items.Add(items[i]);
        }
        return groups;
    }

    // 为序列的每个元素附加一个计算值（LINQ let 子句的降解目标）。
    public static List<QPair<T, R>> With<T, R>(this List<T> src, Selector<T, R> fn) {
        List<QPair<T, R>> outp = new List<QPair<T, R>>();
        for (int i = 0; i < src.Count; i = i + 1) {
            outp.Add(new QPair<T, R>(src[i], fn(src[i])));
        }
        return outp;
    }

    // 按整数键对两个序列执行内连接（LINQ join 子句降解目标）。
    public static List<QPair<T, U>> JoinPairs<T, U>(this List<T> src, List<U> inner, KeySelector<T> outerKey, KeySelector<U> innerKey) {
        List<QPair<T, U>> outp = new List<QPair<T, U>>();
        for (int i = 0; i < src.Count; i = i + 1) {
            int ok = outerKey(src[i]);
            for (int j = 0; j < inner.Count; j = j + 1) {
                if (ok == innerKey(inner[j])) {
                    outp.Add(new QPair<T, U>(src[i], inner[j]));
                }
            }
        }
        return outp;
    }

    // 按字符串键对两个序列执行内连接（LINQ join 子句降解目标）。
    public static List<QPair<T, U>> JoinPairs<T, U>(this List<T> src, List<U> inner, StrKeySelector<T> outerKey, StrKeySelector<U> innerKey) {
        List<QPair<T, U>> outp = new List<QPair<T, U>>();
        for (int i = 0; i < src.Count; i = i + 1) {
            string ok = outerKey(src[i]);
            for (int j = 0; j < inner.Count; j = j + 1) {
                if (ok == innerKey(inner[j])) {
                    outp.Add(new QPair<T, U>(src[i], inner[j]));
                }
            }
        }
        return outp;
    }

    // 按整数键对两个序列执行分组连接（LINQ join ... into 子句降解目标）。
    public static List<QPair<T, List<U>>> JoinInto<T, U>(this List<T> src, List<U> inner, KeySelector<T> outerKey, KeySelector<U> innerKey) {
        List<QPair<T, List<U>>> outp = new List<QPair<T, List<U>>>();
        for (int i = 0; i < src.Count; i = i + 1) {
            int ok = outerKey(src[i]);
            List<U> group = new List<U>();
            for (int j = 0; j < inner.Count; j = j + 1) {
                if (ok == innerKey(inner[j])) {
                    group.Add(inner[j]);
                }
            }
            outp.Add(new QPair<T, List<U>>(src[i], group));
        }
        return outp;
    }

    // 按字符串键对两个序列执行分组连接（LINQ join ... into 子句降解目标）。
    public static List<QPair<T, List<U>>> JoinInto<T, U>(this List<T> src, List<U> inner, StrKeySelector<T> outerKey, StrKeySelector<U> innerKey) {
        List<QPair<T, List<U>>> outp = new List<QPair<T, List<U>>>();
        for (int i = 0; i < src.Count; i = i + 1) {
            string ok = outerKey(src[i]);
            List<U> group = new List<U>();
            for (int j = 0; j < inner.Count; j = j + 1) {
                if (ok == innerKey(inner[j])) {
                    group.Add(inner[j]);
                }
            }
            outp.Add(new QPair<T, List<U>>(src[i], group));
        }
        return outp;
    }

    // 按整数键对元素投影并分组（LINQ group e by k 子句降解目标）。
    public static List<Grouping<R>> GroupBySel<T, R>(this List<T> src, KeySelector<T> key, Selector<T, R> elem) {
        List<Grouping<R>> groups = new List<Grouping<R>>();
        Dict<int, Grouping<R>> map = new Dict<int, Grouping<R>>();
        for (int i = 0; i < src.Count; i = i + 1) {
            int k = key(src[i]);
            if (!map.ContainsKey(k)) {
                Grouping<R> g = new Grouping<R>();
                g.IntKey = k;
                g.Key = Convert.ToString(k);
                map[k] = g;
                groups.Add(g);
            }
            Grouping<R> target = map[k];
            target.Items.Add(elem(src[i]));
        }
        return groups;
    }

    // 按字符串键对元素投影并分组（LINQ group e by k 子句降解目标）。
    public static List<Grouping<R>> GroupBySelStr<T, R>(this List<T> src, StrKeySelector<T> key, Selector<T, R> elem) {
        List<Grouping<R>> groups = new List<Grouping<R>>();
        Dict<string, Grouping<R>> map = new Dict<string, Grouping<R>>();
        for (int i = 0; i < src.Count; i = i + 1) {
            string k = key(src[i]);
            if (!map.ContainsKey(k)) {
                Grouping<R> g = new Grouping<R>();
                g.Key = k;
                map[k] = g;
                groups.Add(g);
            }
            Grouping<R> target = map[k];
            target.Items.Add(elem(src[i]));
        }
        return groups;
    }

    // 从 seed 开始把序列折叠进累加器。
    public static A Aggregate<T, A>(this List<T> src, A seed, Accumulator<T, A> folder) {
        A acc = seed;
        for (int i = 0; i < src.Count; i = i + 1) {
            acc = folder(acc, src[i]);
        }
        return acc;
    }

    // 数值聚合算子 (Sum/Min/Max/Average)、SQL 扩展 (Like/In)、堆 Top-K、
    // 集合代数 (Union/Intersect/Except) 与字典转换 (ToDict) 见 Enumerable.Aggregates.zan
}
