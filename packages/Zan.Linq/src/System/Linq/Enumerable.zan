using System;
namespace System.Linq;

// 对 List&lt;T&gt; 的类型化、即时求值的 LINQ 风格查询操作符。
// 操作符是扩展方法（`this List&lt;T&gt;` 接收者），可像 C# 一样链式调用；
// lambda 参数类型从接收者的元素类型推断。
// 静态调用形式（Enumerable.Where(nums, pred)）同样可用。
// 结果物化为新的 List，因此可以复用并
// 多次枚举。
// bool ok = nums.Any(x => x > 100);
// 排序键是类型化的：OrderBy 接受 int 键，OrderByStr 接受 string 键，
// OrderByNum 接受 double 键（分开命名是因为仅 delegate 返回类型不同的重载
// 无法从无类型 lambda 解析）。
// OrderBy(k1, k2) 按主、次两个 int 键排序。出于同样
// 的原因，double 序列聚合使用 *Num 命名
// First/Last/Single 在空序列（Single 对不明确的序列）时抛出
// InvalidOperationException，与 C# 一致；*OrDefault 变体
// 则返回类型默认值。
public partial class Enumerable {
    // 为序列开启零分配惰性流水线（Stream Pipeline）。
    // 中间操作（Where/Skip/Take/TakeWhile/Distinct/Select）不分配临时列表，
    // 终结操作（ToList/First/Count/Any/All/ForEach）进行单趟遍历并短路提前终止。
    public static Stream<T> AsStream<T>(this List<T> src) {
        return new Stream<T>(src);
    }

    // 为序列开启零堆分配（Zero-Alloc）值流水线（ValueEnumerable）。
    // 配合 duck-typed foreach 与链式迭代器（Where/Select/Skip/Take），
    // 避免产生任何中间 List<T> 堆对象。
    public static ValueEnumerable<T> AsValueEnumerable<T>(this List<T> src) {
        return new ValueEnumerable<T>(src);
    }

    // 保留 pred 返回 true 的元素。
    public static List<T> Where<T>(this List<T> src, Predicate<T> pred) {
        List<T> outp = new List<T>();
        for (int i = 0; i < src.Count; i = i + 1) {
            if (pred(src[i])) { outp.Add(src[i]); }
        }
        return outp;
    }

    // 用 selector 投影每个元素。
    public static List<R> Select<T, R>(this List<T> src, Selector<T, R> selector) {
        List<R> outp = new List<R>();
        for (int i = 0; i < src.Count; i = i + 1) {
            outp.Add(selector(src[i]));
        }
        return outp;
    }

    // 将每个元素投影为 List 并展平结果。
    public static List<R> SelectMany<T, R>(this List<T> src, Selector<T, List<R>> selector) {
        List<R> outp = new List<R>();
        for (int i = 0; i < src.Count; i = i + 1) {
            List<R> part = selector(src[i]);
            for (int j = 0; j < part.Count; j = j + 1) {
                outp.Add(part[j]);
            }
        }
        return outp;
    }

    // 任一元素满足 pred 时返回 true。
    public static bool Any<T>(this List<T> src, Predicate<T> pred) {
        for (int i = 0; i < src.Count; i = i + 1) {
            if (pred(src[i])) { return true; }
        }
        return false;
    }

    // 序列至少有一个元素时返回 true。
    public static bool Any<T>(this List<T> src) {
        return src.Count > 0;
    }

    // 所有元素都满足 pred 时返回 true。
    public static bool All<T>(this List<T> src, Predicate<T> pred) {
        for (int i = 0; i < src.Count; i = i + 1) {
            if (!pred(src[i])) { return false; }
        }
        return true;
    }

    // 满足 pred 的元素个数。
    public static int Count<T>(this List<T> src, Predicate<T> pred) {
        int n = 0;
        for (int i = 0; i < src.Count; i = i + 1) {
            if (pred(src[i])) { n = n + 1; }
        }
        return n;
    }

    // 元素总数。
    public static int Count<T>(this List<T> src) {
        return src.Count;
    }

    // 第一个元素；为空时抛出 InvalidOperationException。
    public static T First<T>(this List<T> src) {
        if (src.Count == 0) {
            throw new InvalidOperationException("Sequence contains no elements");
        }
        return src[0];
    }

    // 第一个满足 pred 的元素；无匹配时抛出。
    public static T First<T>(this List<T> src, Predicate<T> pred) {
        for (int i = 0; i < src.Count; i = i + 1) {
            if (pred(src[i])) { return src[i]; }
        }
        throw new InvalidOperationException("Sequence contains no matching element");
    }

    // 第一个元素；为空时返回类型默认值。
    public static T FirstOrDefault<T>(this List<T> src) {
        if (src.Count > 0) { return src[0]; }
        T d = 0;
        return d;
    }

    // 第一个满足 pred 的元素，否则返回类型默认值。
    public static T FirstOrDefault<T>(this List<T> src, Predicate<T> pred) {
        for (int i = 0; i < src.Count; i = i + 1) {
            if (pred(src[i])) { return src[i]; }
        }
        T d = 0;
        return d;
    }

    // 最后一个元素；为空时抛出 InvalidOperationException。
    public static T Last<T>(this List<T> src) {
        if (src.Count == 0) {
            throw new InvalidOperationException("Sequence contains no elements");
        }
        return src[src.Count - 1];
    }

    // 最后一个满足 pred 的元素；无匹配时抛出。
    public static T Last<T>(this List<T> src, Predicate<T> pred) {
        for (int i = src.Count - 1; i >= 0; i = i - 1) {
            if (pred(src[i])) { return src[i]; }
        }
        throw new InvalidOperationException("Sequence contains no matching element");
    }

    // 最后一个元素；为空时返回类型默认值。
    public static T LastOrDefault<T>(this List<T> src) {
        if (src.Count > 0) { return src[src.Count - 1]; }
        T d = 0;
        return d;
    }

    // 最后一个满足 pred 的元素，否则返回类型默认值。
    public static T LastOrDefault<T>(this List<T> src, Predicate<T> pred) {
        for (int i = src.Count - 1; i >= 0; i = i - 1) {
            if (pred(src[i])) { return src[i]; }
        }
        T d = 0;
        return d;
    }

    // 唯一的元素；序列不恰为单个元素时抛出。
    public static T Single<T>(this List<T> src) {
        if (src.Count == 0) {
            throw new InvalidOperationException("Sequence contains no elements");
        }
        if (src.Count > 1) {
            throw new InvalidOperationException("Sequence contains more than one element");
        }
        return src[0];
    }

    // 唯一满足 pred 的元素；零个或多个时抛出。
    public static T Single<T>(this List<T> src, Predicate<T> pred) {
        int found = -1;
        for (int i = 0; i < src.Count; i = i + 1) {
            if (pred(src[i])) {
                if (found >= 0) {
                    throw new InvalidOperationException("Sequence contains more than one matching element");
                }
                found = i;
            }
        }
        if (found < 0) {
            throw new InvalidOperationException("Sequence contains no matching element");
        }
        return src[found];
    }

    // 唯一的元素；为空时返回类型默认值，多个时抛出。
    public static T SingleOrDefault<T>(this List<T> src) {
        if (src.Count > 1) {
            throw new InvalidOperationException("Sequence contains more than one element");
        }
        if (src.Count == 1) { return src[0]; }
        T d = 0;
        return d;
    }

    // 唯一匹配的元素，否则返回类型默认值；多个时抛出。
    public static T SingleOrDefault<T>(this List<T> src, Predicate<T> pred) {
        int found = -1;
        for (int i = 0; i < src.Count; i = i + 1) {
            if (pred(src[i])) {
                if (found >= 0) {
                    throw new InvalidOperationException("Sequence contains more than one matching element");
                }
                found = i;
            }
        }
        if (found >= 0) { return src[found]; }
        T d = 0;
        return d;
    }

    // target 存在时返回 true（对元素类型使用 ==；
    // 对引用类型是同一性比较，而非结构相等）。
    public static bool Contains<T>(this List<T> src, T target) {
        for (int i = 0; i < src.Count; i = i + 1) {
            if (src[i] == target) { return true; }
        }
        return false;
    }

    // 在给定的相等比较器下 target 存在时返回 true
    // （对引用类型采用 Equals 风格语义）。
    public static bool Contains<T>(this List<T> src, T target, EqualityComparer<T> eq) {
        for (int i = 0; i < src.Count; i = i + 1) {
            if (eq(src[i], target)) { return true; }
        }
        return false;
    }

    // 按字符串值比较，target 存在时返回 true
    // （ContainsStr 的 C# 风格重载）。
    public static bool Contains(this List<string> src, string target) {
        return Enumerable.ContainsStr(src, target);
    }

    // 按字符串值比较，target 存在时返回 true。
    public static bool ContainsStr(this List<string> src, string target) {
        for (int i = 0; i < src.Count; i = i + 1) {
            string s = src[i];
            if (s == target) { return true; }
        }
        return false;
    }

    // 序列的浅拷贝，作为新 List。
    public static List<T> ToList<T>(this List<T> src) {
        List<T> outp = new List<T>();
        for (int i = 0; i < src.Count; i = i + 1) {
            outp.Add(src[i]);
        }
        return outp;
    }

    // 前 count 个元素（不足则全部）。
    public static List<T> Take<T>(this List<T> src, int count) {
        List<T> outp = new List<T>();
        for (int i = 0; i < src.Count && i < count; i = i + 1) {
            outp.Add(src[i]);
        }
        return outp;
    }

    // 取 pred 成立时的前导元素。
    public static List<T> TakeWhile<T>(this List<T> src, Predicate<T> pred) {
        List<T> outp = new List<T>();
        for (int i = 0; i < src.Count; i = i + 1) {
            if (!pred(src[i])) { return outp; }
            outp.Add(src[i]);
        }
        return outp;
    }

    // 跳过前 count 个元素后的所有元素。
    public static List<T> Skip<T>(this List<T> src, int count) {
        List<T> outp = new List<T>();
        int i = count;
        if (i < 0) { i = 0; }
        for (; i < src.Count; i = i + 1) {
            outp.Add(src[i]);
        }
        return outp;
    }

    // pred 成立的前导段之后的元素。
    public static List<T> SkipWhile<T>(this List<T> src, Predicate<T> pred) {
        List<T> outp = new List<T>();
        int i = 0;
        for (; i < src.Count && pred(src[i]); i = i + 1) { }
        for (; i < src.Count; i = i + 1) {
            outp.Add(src[i]);
        }
        return outp;
    }

    // 反转顺序后的元素。
    public static List<T> Reverse<T>(this List<T> src) {
        List<T> outp = new List<T>();
        for (int i = src.Count - 1; i >= 0; i = i - 1) {
            outp.Add(src[i]);
        }
        return outp;
    }

    // 去重元素，保留首次出现（使用 ==；
    // 对引用类型是同一性比较，而非结构相等）。基于哈希表 O(N) 实现。
    public static List<T> Distinct<T>(this List<T> src) {
        List<T> outp = new List<T>();
        if (src.Count <= 4) {
            for (int i = 0; i < src.Count; i = i + 1) {
                if (!Enumerable.Contains<T>(outp, src[i])) { outp.Add(src[i]); }
            }
            return outp;
        }
        Dict<T, bool> seen = new Dict<T, bool>();
        for (int i = 0; i < src.Count; i = i + 1) {
            T item = src[i];
            if (!seen.ContainsKey(item)) {
                seen[item] = true;
                outp.Add(item);
            }
        }
        return outp;
    }

    // 在给定相等比较器下去重，保留
    // 首次出现（对引用类型采用 Equals 风格语义）。
    // 复杂度 O(N²)：比较器是裸委托，只有相等判断、拿不到哈希值，
    // 无法像 == 版 Distinct 那样用 Dict 桶化——比较器判定相等的两个
    // 元素可以落在任意桶里，跨桶仍要两两比较。大序列（几千元素
    // 以上）且元素的 == 恰好就是想要的结构相等时，请改用
    // 无比较器的 Distinct()（O(N) 哈希实现）。
    public static List<T> Distinct<T>(this List<T> src, EqualityComparer<T> eq) {
        List<T> outp = new List<T>();
        for (int i = 0; i < src.Count; i = i + 1) {
            if (!Enumerable.Contains<T>(outp, src[i], eq)) { outp.Add(src[i]); }
        }
        return outp;
    }

    // 按值比较去重字符串（DistinctStr 的 C# 风格重载；
    // 由接收者的元素类型选择该重载）。
    public static List<string> Distinct(this List<string> src) {
        return Enumerable.DistinctStr(src);
    }

    // 按值比较去重字符串，保留首次出现。基于哈希表 O(N) 实现。
    public static List<string> DistinctStr(this List<string> src) {
        List<string> outp = new List<string>();
        if (src.Count <= 4) {
            for (int i = 0; i < src.Count; i = i + 1) {
                if (!Enumerable.ContainsStr(outp, src[i])) { outp.Add(src[i]); }
            }
            return outp;
        }
        Dict<string, bool> seen = new Dict<string, bool>();
        for (int i = 0; i < src.Count; i = i + 1) {
            string s = src[i];
            if (!seen.ContainsKey(s)) {
                seen[s] = true;
                outp.Add(s);
            }
        }
        return outp;
    }

    // 按字符串键升序排序（OrderByStr 的 C# 风格重载；
    // 由 lambda 的键类型选择该重载）。
    public static List<T> OrderBy<T>(this List<T> src, StrKeySelector<T> key) {
        return Enumerable.MergeSortStr<T>(src, key, false);
    }

    // 按 double 键升序排序（OrderByNum 的 C# 风格重载；
    // OrderByNum）。
    public static List<T> OrderBy<T>(this List<T> src, NumKeySelector<T> key) {
        return Enumerable.MergeSortNum<T>(src, key, false);
    }

    // 按字符串键降序排序。
    public static List<T> OrderByDescending<T>(this List<T> src, StrKeySelector<T> key) {
        return Enumerable.MergeSortStr<T>(src, key, true);
    }

    // 按 double 键降序排序。
    public static List<T> OrderByDescending<T>(this List<T> src, NumKeySelector<T> key) {
        return Enumerable.MergeSortNum<T>(src, key, true);
    }

    // 按整数键升序排序（稳定归并排序）。
    public static List<T> OrderBy<T>(this List<T> src, KeySelector<T> key) {
        return Enumerable.MergeSortInt<T>(src, key, 1);
    }

    // 按主、次两个整数键升序排序（稳定）。单趟归并同时
    // 比较两键：主键相等时按次键定序，两键都相等时保留原有相对
    // 顺序——与"先按次键、再按主键各做一次稳定排序"等价，但键
    // 预计算与归并都只做一遍。
    public static List<T> OrderBy<T>(this List<T> src, KeySelector<T> key1, KeySelector<T> key2) {
        return Enumerable.MergeSortInt2<T>(src, key1, key2);
    }

    // 按整数键降序排序（稳定归并排序）。
    public static List<T> OrderByDescending<T>(this List<T> src, KeySelector<T> key) {
        return Enumerable.MergeSortInt<T>(src, key, -1);
    }

    // 按字符串键升序排序（稳定归并排序）。
    public static List<T> OrderByStr<T>(this List<T> src, StrKeySelector<T> key) {
        return Enumerable.MergeSortStr<T>(src, key, false);
    }

    // 按字符串键降序排序（稳定归并排序）。
    public static List<T> OrderByStrDescending<T>(this List<T> src, StrKeySelector<T> key) {
        return Enumerable.MergeSortStr<T>(src, key, true);
    }

    // 按 double 键升序排序（稳定归并排序）。
    public static List<T> OrderByNum<T>(this List<T> src, NumKeySelector<T> key) {
        return Enumerable.MergeSortNum<T>(src, key, false);
    }

    // 按 double 键降序排序（稳定归并排序）。
    public static List<T> OrderByNumDescending<T>(this List<T> src, NumKeySelector<T> key) {
        return Enumerable.MergeSortNum<T>(src, key, true);
    }

    /* 基于预计算 int 键的自底向上稳定归并排序；sign 翻转排序方向。 工作缓冲用 T[]/int[] 定长数组：每一轮归并都把 b/kb 的 [0,n) 整段 重写完才会被读，n 槽未初始化缓冲就够——不再需要 ToList(src) 那份把元素逐个 Add 的全量拷贝。 */
    public static List<T> MergeSortInt<T>(List<T> src, KeySelector<T> key, int sign) {
        int n = src.Count;
        if (n < 2) { return Enumerable.ToList<T>(src); }
        T[] a = new T[n];
        T[] b = new T[n];
        int[] ka = new int[n];
        int[] kb = new int[n];
        for (int i = 0; i < n; i = i + 1) { a[i] = src[i]; ka[i] = sign * key(src[i]); }
        int width = 1;
        while (width < n) {
            int lo = 0;
            while (lo < n) {
                int mid = lo + width;
                if (mid > n) { mid = n; }
                int hi = lo + width + width;
                if (hi > n) { hi = n; }
                int l = lo;
                int r = mid;
                int o = lo;
                while (l < mid && r < hi) {
                    if (ka[l] <= ka[r]) { b[o] = a[l]; kb[o] = ka[l]; l = l + 1; }
                    else { b[o] = a[r]; kb[o] = ka[r]; r = r + 1; }
                    o = o + 1;
                }
                while (l < mid) { b[o] = a[l]; kb[o] = ka[l]; l = l + 1; o = o + 1; }
                while (r < hi) { b[o] = a[r]; kb[o] = ka[r]; r = r + 1; o = o + 1; }
                lo = hi;
            }
            T[] tl = a; a = b; b = tl;
            int[] tk = ka; ka = kb; kb = tk;
            width = width + width;
        }
        List<T> outp = new List<T>();
        outp.Reserve(n);
        for (int i = 0; i < n; i = i + 1) { outp.Add(a[i]); }
        return outp;
    }

    /* 双 int 键版：主键相等时比较次键；两键都相等取左（先到的元素在
 * a 侧），稳定性与"先次键、后主键两次稳定排序"一致。 */
    public static List<T> MergeSortInt2<T>(List<T> src, KeySelector<T> key1, KeySelector<T> key2) {
        int n = src.Count;
        if (n < 2) { return Enumerable.ToList<T>(src); }
        T[] a = new T[n];
        T[] b = new T[n];
        int[] k1a = new int[n];
        int[] k1b = new int[n];
        int[] k2a = new int[n];
        int[] k2b = new int[n];
        for (int i = 0; i < n; i = i + 1) {
            a[i] = src[i];
            k1a[i] = key1(src[i]);
            k2a[i] = key2(src[i]);
        }
        int width = 1;
        while (width < n) {
            int lo = 0;
            while (lo < n) {
                int mid = lo + width;
                if (mid > n) { mid = n; }
                int hi = lo + width + width;
                if (hi > n) { hi = n; }
                int l = lo;
                int r = mid;
                int o = lo;
                while (l < mid && r < hi) {
                    int k1l = k1a[l];
                    int k1r = k1a[r];
                    bool takeLeft;
                    if (k1l != k1r) { takeLeft = k1l < k1r; }
                    else { takeLeft = k2a[l] <= k2a[r]; }
                    if (takeLeft) { b[o] = a[l]; k1b[o] = k1l; k2b[o] = k2a[l]; l = l + 1; }
                    else { b[o] = a[r]; k1b[o] = k1r; k2b[o] = k2a[r]; r = r + 1; }
                    o = o + 1;
                }
                while (l < mid) { b[o] = a[l]; k1b[o] = k1a[l]; k2b[o] = k2a[l]; l = l + 1; o = o + 1; }
                while (r < hi) { b[o] = a[r]; k1b[o] = k1a[r]; k2b[o] = k2a[r]; r = r + 1; o = o + 1; }
                lo = hi;
            }
            T[] tl = a; a = b; b = tl;
            int[] t1 = k1a; k1a = k1b; k1b = t1;
            int[] t2 = k2a; k2a = k2b; k2b = t2;
            width = width + width;
        }
        List<T> outp = new List<T>();
        outp.Reserve(n);
        for (int i = 0; i < n; i = i + 1) { outp.Add(a[i]); }
        return outp;
    }

    /* 基于预计算 string 键的自底向上稳定归并排序。缓冲形态见 MergeSortInt。 */
    public static List<T> MergeSortStr<T>(List<T> src, StrKeySelector<T> key, bool desc) {
        int n = src.Count;
        if (n < 2) { return Enumerable.ToList<T>(src); }
        T[] a = new T[n];
        T[] b = new T[n];
        string[] ka = new string[n];
        string[] kb = new string[n];
        for (int i = 0; i < n; i = i + 1) { a[i] = src[i]; ka[i] = key(src[i]); }
        int width = 1;
        while (width < n) {
            int lo = 0;
            while (lo < n) {
                int mid = lo + width;
                if (mid > n) { mid = n; }
                int hi = lo + width + width;
                if (hi > n) { hi = n; }
                int l = lo;
                int r = mid;
                int o = lo;
                while (l < mid && r < hi) {
                    string kl = ka[l];
                    string kr = ka[r];
                    bool takeLeft = kl <= kr;
                    if (desc) { takeLeft = kl >= kr; }
                    if (takeLeft) { b[o] = a[l]; kb[o] = ka[l]; l = l + 1; }
                    else { b[o] = a[r]; kb[o] = ka[r]; r = r + 1; }
                    o = o + 1;
                }
                while (l < mid) { b[o] = a[l]; kb[o] = ka[l]; l = l + 1; o = o + 1; }
                while (r < hi) { b[o] = a[r]; kb[o] = ka[r]; r = r + 1; o = o + 1; }
                lo = hi;
            }
            T[] tl = a; a = b; b = tl;
            string[] tk = ka; ka = kb; kb = tk;
            width = width + width;
        }
        List<T> outp = new List<T>();
        outp.Reserve(n);
        for (int i = 0; i < n; i = i + 1) { outp.Add(a[i]); }
        return outp;
    }

    /* 基于预计算 double 键的自底向上稳定归并排序。缓冲形态见 MergeSortInt。 */
    public static List<T> MergeSortNum<T>(List<T> src, NumKeySelector<T> key, bool desc) {
        int n = src.Count;
        if (n < 2) { return Enumerable.ToList<T>(src); }
        T[] a = new T[n];
        T[] b = new T[n];
        double[] ka = new double[n];
        double[] kb = new double[n];
        for (int i = 0; i < n; i = i + 1) { a[i] = src[i]; ka[i] = key(src[i]); }
        int width = 1;
        while (width < n) {
            int lo = 0;
            while (lo < n) {
                int mid = lo + width;
                if (mid > n) { mid = n; }
                int hi = lo + width + width;
                if (hi > n) { hi = n; }
                int l = lo;
                int r = mid;
                int o = lo;
                while (l < mid && r < hi) {
                    double kl = ka[l];
                    double kr = ka[r];
                    bool takeLeft = kl <= kr;
                    if (desc) { takeLeft = kl >= kr; }
                    if (takeLeft) { b[o] = a[l]; kb[o] = ka[l]; l = l + 1; }
                    else { b[o] = a[r]; kb[o] = ka[r]; r = r + 1; }
                    o = o + 1;
                }
                while (l < mid) { b[o] = a[l]; kb[o] = ka[l]; l = l + 1; o = o + 1; }
                while (r < hi) { b[o] = a[r]; kb[o] = ka[r]; r = r + 1; o = o + 1; }
                lo = hi;
            }
            T[] tl = a; a = b; b = tl;
            double[] tk = ka; ka = kb; kb = tk;
            width = width + width;
        }
        List<T> outp = new List<T>();
        outp.Reserve(n);
        for (int i = 0; i < n; i = i + 1) { outp.Add(a[i]); }
        return outp;
    }


    // 按预先计算的整数键列表稳定排序（升序）。
    public static List<T> OrderByKeysInt<T>(this List<T> src, List<int> keys) {
        return Enumerable.MergeSortKeysInt<T>(src, keys, 1);
    }

    // 按预先计算的整数键列表稳定排序（降序）。
    public static List<T> OrderByKeysIntDescending<T>(this List<T> src, List<int> keys) {
        return Enumerable.MergeSortKeysInt<T>(src, keys, -1);
    }

    // 按预先计算的 long 键列表稳定排序（升序）。
    public static List<T> OrderByKeysLong<T>(this List<T> src, List<long> keys) {
        return Enumerable.MergeSortKeysLong<T>(src, keys, 1);
    }

    // 按预先计算的 long 键列表稳定排序（降序）。
    public static List<T> OrderByKeysLongDescending<T>(this List<T> src, List<long> keys) {
        return Enumerable.MergeSortKeysLong<T>(src, keys, -1);
    }

    // 按预先计算的 double 键列表稳定排序（升序）。
    public static List<T> OrderByKeysNum<T>(this List<T> src, List<double> keys) {
        return Enumerable.MergeSortKeysNum<T>(src, keys, false);
    }

    // 按预先计算的 double 键列表稳定排序（降序）。
    public static List<T> OrderByKeysNumDescending<T>(this List<T> src, List<double> keys) {
        return Enumerable.MergeSortKeysNum<T>(src, keys, true);
    }

    // 按预先计算的字符串键列表稳定排序（升序）。
    public static List<T> OrderByKeysStr<T>(this List<T> src, List<string> keys) {
        return Enumerable.MergeSortKeysStr<T>(src, keys, false);
    }

    // 按预先计算的字符串键列表稳定排序（降序）。
    public static List<T> OrderByKeysStrDescending<T>(this List<T> src, List<string> keys) {
        return Enumerable.MergeSortKeysStr<T>(src, keys, true);
    }

    /* 基于预计算 int 键的自底向上稳定归并排序（键列表与 src 并行； sign 翻转排序方向）。 键列表按值拷贝一份再排：两个缓冲区每轮互换，第二轮之后 `kb` 指向的就是 传进来的那个 list，直接拿它当 scratch 会把**调用方的键列表原地改成排序后 的样子**——同一个键列表连排两次，第二次拿到的已是被改过的数据，结果就是错的。 */
    public static List<T> MergeSortKeysInt<T>(List<T> src, List<int> keys, int sign) {
        List<T> a = Enumerable.ToList<T>(src);
        int n = a.Count;
        if (n < 2) { return a; }
        List<T> b = Enumerable.ToList<T>(src);
        List<int> ka = new List<int>();
        List<int> kb = new List<int>();
        for (int i = 0; i < n; i = i + 1) { ka.Add(keys[i]); kb.Add(0); }
        int width = 1;
        while (width < n) {
            int lo = 0;
            while (lo < n) {
                int mid = lo + width;
                if (mid > n) { mid = n; }
                int hi = lo + width + width;
                if (hi > n) { hi = n; }
                int l = lo;
                int r = mid;
                int o = lo;
                while (l < mid && r < hi) {
                    if (sign * ka[l] <= sign * ka[r]) { b[o] = a[l]; kb[o] = ka[l]; l = l + 1; }
                    else { b[o] = a[r]; kb[o] = ka[r]; r = r + 1; }
                    o = o + 1;
                }
                while (l < mid) { b[o] = a[l]; kb[o] = ka[l]; l = l + 1; o = o + 1; }
                while (r < hi) { b[o] = a[r]; kb[o] = ka[r]; r = r + 1; o = o + 1; }
                lo = hi;
            }
            List<T> tl = a; a = b; b = tl;
            List<int> tk = ka; ka = kb; kb = tk;
            width = width + width;
        }
        return a;
    }

    /* 基于预计算 long 键的自底向上稳定归并排序。 */
    /* 键列表按值拷贝，理由见 MergeSortKeysInt。 */
    public static List<T> MergeSortKeysLong<T>(List<T> src, List<long> keys, int sign) {
        List<T> a = Enumerable.ToList<T>(src);
        int n = a.Count;
        if (n < 2) { return a; }
        List<T> b = Enumerable.ToList<T>(src);
        List<long> ka = new List<long>();
        List<long> kb = new List<long>();
        for (int i = 0; i < n; i = i + 1) { ka.Add(keys[i]); kb.Add(0); }
        int width = 1;
        while (width < n) {
            int lo = 0;
            while (lo < n) {
                int mid = lo + width;
                if (mid > n) { mid = n; }
                int hi = lo + width + width;
                if (hi > n) { hi = n; }
                int l = lo;
                int r = mid;
                int o = lo;
                while (l < mid && r < hi) {
                    if (sign * ka[l] <= sign * ka[r]) { b[o] = a[l]; kb[o] = ka[l]; l = l + 1; }
                    else { b[o] = a[r]; kb[o] = ka[r]; r = r + 1; }
                    o = o + 1;
                }
                while (l < mid) { b[o] = a[l]; kb[o] = ka[l]; l = l + 1; o = o + 1; }
                while (r < hi) { b[o] = a[r]; kb[o] = ka[r]; r = r + 1; o = o + 1; }
                lo = hi;
            }
            List<T> tl = a; a = b; b = tl;
            List<long> tk = ka; ka = kb; kb = tk;
            width = width + width;
        }
        return a;
    }

    /* 基于预计算 string 键的自底向上稳定归并排序。 */
    /* 键列表按值拷贝，理由见 MergeSortKeysInt。 */
    public static List<T> MergeSortKeysStr<T>(List<T> src, List<string> keys, bool desc) {
        List<T> a = Enumerable.ToList<T>(src);
        int n = a.Count;
        if (n < 2) { return a; }
        List<T> b = Enumerable.ToList<T>(src);
        List<string> ka = new List<string>();
        List<string> kb = new List<string>();
        for (int i = 0; i < n; i = i + 1) { ka.Add(keys[i]); kb.Add(""); }
        int width = 1;
        while (width < n) {
            int lo = 0;
            while (lo < n) {
                int mid = lo + width;
                if (mid > n) { mid = n; }
                int hi = lo + width + width;
                if (hi > n) { hi = n; }
                int l = lo;
                int r = mid;
                int o = lo;
                while (l < mid && r < hi) {
                    string kl = ka[l];
                    string kr = ka[r];
                    bool takeLeft = kl <= kr;
                    if (desc) { takeLeft = kl >= kr; }
                    if (takeLeft) { b[o] = a[l]; kb[o] = ka[l]; l = l + 1; }
                    else { b[o] = a[r]; kb[o] = ka[r]; r = r + 1; }
                    o = o + 1;
                }
                while (l < mid) { b[o] = a[l]; kb[o] = ka[l]; l = l + 1; o = o + 1; }
                while (r < hi) { b[o] = a[r]; kb[o] = ka[r]; r = r + 1; o = o + 1; }
                lo = hi;
            }
            List<T> tl = a; a = b; b = tl;
            List<string> tk = ka; ka = kb; kb = tk;
            width = width + width;
        }
        return a;
    }

    /* 基于预计算 double 键的自底向上稳定归并排序。 */
    /* 键列表按值拷贝，理由见 MergeSortKeysInt。 */
    public static List<T> MergeSortKeysNum<T>(List<T> src, List<double> keys, bool desc) {
        List<T> a = Enumerable.ToList<T>(src);
        int n = a.Count;
        if (n < 2) { return a; }
        List<T> b = Enumerable.ToList<T>(src);
        List<double> ka = new List<double>();
        List<double> kb = new List<double>();
        for (int i = 0; i < n; i = i + 1) { ka.Add(keys[i]); kb.Add(0.0); }
        int width = 1;
        while (width < n) {
            int lo = 0;
            while (lo < n) {
                int mid = lo + width;
                if (mid > n) { mid = n; }
                int hi = lo + width + width;
                if (hi > n) { hi = n; }
                int l = lo;
                int r = mid;
                int o = lo;
                while (l < mid && r < hi) {
                    double kl = ka[l];
                    double kr = ka[r];
                    bool takeLeft = kl <= kr;
                    if (desc) { takeLeft = kl >= kr; }
                    if (takeLeft) { b[o] = a[l]; kb[o] = ka[l]; l = l + 1; }
                    else { b[o] = a[r]; kb[o] = ka[r]; r = r + 1; }
                    o = o + 1;
                }
                while (l < mid) { b[o] = a[l]; kb[o] = ka[l]; l = l + 1; o = o + 1; }
                while (r < hi) { b[o] = a[r]; kb[o] = ka[r]; r = r + 1; o = o + 1; }
                lo = hi;
            }
            List<T> tl = a; a = b; b = tl;
            List<double> tk = ka; ka = kb; kb = tk;
            width = width + width;
        }
        return a;
    }

    // 按整数键对元素分组。Grouping.IntKey 保存
    // 键；Grouping.Key 保存其字符串形式。分组顺序按首次
    // 出现排序。基于哈希表 O(N) 实现。
    public static List<Grouping<T>> GroupBy<T>(this List<T> src, KeySelector<T> key) {
        List<Grouping<T>> groups = new List<Grouping<T>>();
        Dict<int, Grouping<T>> map = new Dict<int, Grouping<T>>();
        for (int i = 0; i < src.Count; i = i + 1) {
            int k = key(src[i]);
            if (!map.ContainsKey(k)) {
                Grouping<T> g = new Grouping<T>();
                g.IntKey = k;
                g.Key = Convert.ToString(k);
                map[k] = g;
                groups.Add(g);
            }
            Grouping<T> target = map[k];
            target.Items.Add(src[i]);
        }
        return groups;
    }

    // 按字符串键分组（GroupByStr 的 C# 风格重载；
    // 由 lambda 的键类型选择该重载）。
    public static List<Grouping<T>> GroupBy<T>(this List<T> src, StrKeySelector<T> key) {
        return Enumerable.GroupByStr<T>(src, key);
    }

    // 按字符串键（按值比较）分组。分组
    // 顺序按首次出现排列。基于哈希表 O(N) 实现。
    public static List<Grouping<T>> GroupByStr<T>(this List<T> src, StrKeySelector<T> key) {
        List<Grouping<T>> groups = new List<Grouping<T>>();
        Dict<string, Grouping<T>> map = new Dict<string, Grouping<T>>();
        for (int i = 0; i < src.Count; i = i + 1) {
            string k = key(src[i]);
            if (!map.ContainsKey(k)) {
                Grouping<T> g = new Grouping<T>();
                g.Key = k;
                map[k] = g;
                groups.Add(g);
            }
            Grouping<T> target = map[k];
            target.Items.Add(src[i]);
        }
        return groups;
    }

    // 按预先计算的整数键分组（键与元素列表并行；
    // Grouping.Items 为投影后的元素）。基于哈希表 O(N) 实现。
    public static List<Grouping<R>> GroupByKeysInt<T, R>(this List<T> src, List<int> keys, List<R> items) {
        List<Grouping<R>> groups = new List<Grouping<R>>();
        Dict<int, Grouping<R>> map = new Dict<int, Grouping<R>>();
        for (int i = 0; i < src.Count; i = i + 1) {
            int k = keys[i];
            if (!map.ContainsKey(k)) {
                Grouping<R> g = new Grouping<R>();
                g.IntKey = k;
                g.Key = Convert.ToString(k);
                map[k] = g;
                groups.Add(g);
            }
            Grouping<R> target = map[k];
            target.Items.Add(items[i]);
        }
        return groups;
    }

    // 按预先计算的字符串键分组（键与元素列表并行；
    // Grouping.Items 为投影后的元素）。基于哈希表 O(N) 实现。
    public static List<Grouping<R>> GroupByKeysStr<T, R>(this List<T> src, List<string> keys, List<R> items) {
        List<Grouping<R>> groups = new List<Grouping<R>>();
        Dict<string, Grouping<R>> map = new Dict<string, Grouping<R>>();
        for (int i = 0; i < src.Count; i = i + 1) {
