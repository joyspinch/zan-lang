using System;
using System.Collections.Generic;
using System.Drawing.Imaging;
using System.Media.Video;
using Gui;
using Gui.Backend;

namespace Gui.Widget;

// 高性能视频播放控件：
// - 后台线程运行 MediaPlaybackSession（音频硬件主时钟 A/V 同步，UI 线程零阻塞）；
// - 仅在 FrameVersion 递增时将双缓冲最新帧发布到交替 mem: 纹理键并 Blit；
// - 原生支持多路商用实时动态水印（固定/跑马灯/碰壁漂移/定时随机跳位/全屏斜纹平铺/半透明台标 Logo）；
// - 内置底部播放/暂停按钮、可拖拽进度条与时间码显示（可通过 ShowControls 关闭）。
public class VideoPlayer : Control, IDisposable {
    public override Control CreateCloneShell() { return new VideoPlayer(); }

    public Binding<string> Src;
    public string Fit = "contain";
    public bool AutoPlay = false;
    public bool Loop = false;
    public bool ShowControls = true;
    public VideoWatermark Watermark = null;

    private List<VideoWatermark> extraWatermarks = null;
    private long watermarkOriginMs = 0;
    private string resolvedSrc = null;
    private MediaPlaybackSession session = null;
    private long publishedVersion = -1;
    private int keySlot = 0;
    private string currentKey = "";
    private string keyPrefix = "";
    private bool scrubbing = false;
    private bool disposed = false;
    private weak AppLoopRegistration loopRegistration = null;

    private static int nextPlayerId = 1;

    private void InitPlayer(string src) {
        this.InitControl("video-player");
        this.styleSurfaceOwned = true;
        this.Src = src;
        int id = VideoPlayer.nextPlayerId;
        VideoPlayer.nextPlayerId = id + 1;
        this.keyPrefix = "mem:vp_" + Convert.ToString(id) + "_";
        this.session = new MediaPlaybackSession();
    }

    public VideoPlayer() { this.InitPlayer(""); }
    public VideoPlayer(string src) { this.InitPlayer(src); }

    public MediaPlaybackSession Session {
        get { return this.session; }
    }

    public PlaybackState State {
        get { return this.session != null ? this.session.State : PlaybackState.Stopped; }
    }

    public long PositionMs {
        get { return this.session != null ? this.session.PositionMs : 0; }
    }

    public long DurationMs {
        get { return this.session != null ? this.session.DurationMs : 0; }
    }

    public void Play() {
        if (this.disposed) return;
        this.ResolveSource();
        if (this.session != null) { this.session.Play(); }
        this.RequestRedraw();
    }

    public void Pause() {
        if (this.session != null) { this.session.Pause(); }
        this.RequestRedraw();
    }

    public void TogglePause() {
        if (this.disposed) return;
        this.ResolveSource();
        if (this.session != null) { this.session.TogglePause(); }
        this.RequestRedraw();
    }

    public void Stop() {
        if (this.session != null) { this.session.Stop(); }
        this.RequestRedraw();
    }

    public void SeekMs(long targetMs) {
        if (this.disposed) return;
        this.ResolveSource();
        if (this.session != null) {
            this.session.SeekMs(targetMs);
            this.SyncFrameToKey();
        }
        this.RequestRedraw();
    }

    public void SetVolume(double vol) {
        if (this.session != null) { this.session.SetVolume(vol); }
    }

    public void SetSpeed(double speed) {
        if (this.session != null) { this.session.SetSpeed(speed); }
    }

    // 追加一层实时动态水印（支持多路叠加，如全屏斜纹 + 随机跳位 ID + 台标 Logo）。
    public void AddWatermark(VideoWatermark watermark) {
        if (watermark == null) return;
        if (this.extraWatermarks == null) {
            this.extraWatermarks = new List<VideoWatermark>();
        }
        this.extraWatermarks.Add(watermark);
        this.RequestRedraw();
    }

    public void ClearWatermarks() {
        this.Watermark = null;
        if (this.extraWatermarks != null) {
            this.extraWatermarks.Clear();
        }
        this.RequestRedraw();
    }

    private void EnsureLifecycleHook(App app) {
        if (this.disposed || app == null || !app.isRunning) return;
        AppLoopRegistration reg = this.loopRegistration;
        if (reg != null && reg.active && reg.host == app) return;
        if (reg != null) { reg.Invalidate(); }
        this.loopRegistration = app.RegisterLoopParticipant(this, new VideoPlayerLifecycle(this));
    }

    private void ReleaseTextures() {
        this.publishedVersion = -1;
        this.keySlot = 0;
        if (this.currentKey != "") {
            Canvas.EvictImage(this.keyPrefix + "0");
            Canvas.EvictImage(this.keyPrefix + "1");
            this.currentKey = "";
        }
    }

    private void ResolveSource() {
        if (this.disposed) return;
        string src = this.Src != null ? this.Src.Get() : "";
        if (src == null) src = "";
        if (this.resolvedSrc != null && src == this.resolvedSrc) return;
        this.resolvedSrc = src;
        this.ReleaseTextures();
        if (this.session != null) {
            this.session.Close();
        }
        if (src == "") {
            this.RequestRedraw();
            return;
        }
        if (this.session == null) {
            this.session = new MediaPlaybackSession();
        }
        this.session.Loop = this.Loop;
        if (this.session.Open(src)) {
            this.SyncFrameToKey();
            if (this.AutoPlay) {
                this.session.Play();
            }
        }
        this.RequestRedraw();
    }

    private void SyncFrameToKey() {
        if (this.session == null) return;
        long ver = this.session.FrameVersion;
        if (ver <= 0 || ver == this.publishedVersion) return;
        this.keySlot = 1 - this.keySlot;
        string key = this.keyPrefix + Convert.ToString(this.keySlot);
        if (this.session.PublishFrameToImageKey(key)) {
            this.currentKey = key;
            this.publishedVersion = ver;
        }
    }

    private int ControlBarHeight(App app) {
        return app.Scale(36);
    }

    private bool IsControlBarVisible(App app) {
        return this.ShowControls && this.bh >= app.Scale(64);
    }

    private void ComputeTrackBounds(App app, string timeText, out int trackX, out int trackW, out int timeX) {
        int pad = app.Scale(10);
        int fs = Style.FontFallback(app, "small");
        int btnW = app.Scale(28);
        int timeW = Canvas.MeasureText(timeText, fs);
        timeX = this.bx + this.bw - pad - timeW;
        trackX = this.bx + pad + btnW + pad;
        trackW = timeX - pad - trackX;
    }

    private static string FormatTimeMs(long ms) {
        if (ms < 0) ms = 0;
        long totalSec = ms / 1000;
        long min = totalSec / 60;
        long sec = totalSec % 60;
        string mStr = Convert.ToString(min);
        string sStr = Convert.ToString(sec);
        if (mStr.Length < 2) mStr = "0" + mStr;
        if (sStr.Length < 2) sStr = "0" + sStr;
        return mStr + ":" + sStr;
    }

    public override void OnMeasure(App app) {
        if (!this.disposed) {
            this.EnsureLifecycleHook(app);
            this.ResolveSource();
        }
        StyleBox s = this.ResolveStyleAs(app, "video-player", Class, Style.SNormal());
        int cssW = s.WidthOr(-1);
        int cssH = s.HeightOr(-1);
        int dw = cssW > 0 ? cssW : app.Scale(640);
        int dh = cssH > 0 ? cssH : app.Scale(360);
        if (cssW > 0 && cssH <= 0 && this.session != null && this.session.VideoWidth > 0 && this.session.VideoHeight > 0) {
            dh = (int)((long)cssW * (long)this.session.VideoHeight / (long)this.session.VideoWidth);
        } else if (cssH > 0 && cssW <= 0 && this.session != null && this.session.VideoWidth > 0 && this.session.VideoHeight > 0) {
            dw = (int)((long)cssH * (long)this.session.VideoWidth / (long)this.session.VideoHeight);
        }
        this.prefW = dw;
        this.prefH = dh;
    }

    public override void OnPaint(App app) {
        if (this.disposed) return;
        this.EnsureLifecycleHook(app);
        this.ResolveSource();
        if (this.bw <= 0 || this.bh <= 0) return;

        if (this.session != null) {
            this.session.Loop = this.Loop;
            this.SyncFrameToKey();
        }

        Canvas c = app.canvas;
        // 黑色影院底（派生自主题 scrim，保证明暗皮肤下视频对比度一致）
        c.FillRect(this.bx, this.by, this.bw, this.bh, ColorMath.WithAlpha(app.theme.scrim, 255));

        int vx = this.bx;
        int vy = this.by;
        int vwOut = this.bw;
        int vhOut = this.bh;
        if (this.currentKey != "" && this.session != null
            && this.session.VideoWidth > 0 && this.session.VideoHeight > 0) {
            this.BlitVideo(c, this.session.VideoWidth, this.session.VideoHeight,
                           out vx, out vy, out vwOut, out vhOut);
        }

        bool ctrlVisible = this.IsControlBarVisible(app);
        int wmClipH = vhOut;
        if (ctrlVisible) {
            int barTop = this.by + this.bh - this.ControlBarHeight(app);
            if (vy + wmClipH > barTop) {
                wmClipH = barTop - vy;
            }
        }
        if (vwOut > 0 && wmClipH > 0) {
            this.PaintAllWatermarks(app, c, vx, vy, vwOut, wmClipH);
        }

        if (ctrlVisible) {
            this.PaintControlBar(app, c);
        }

        bool isPlaying = this.session != null && this.session.State == PlaybackState.Playing;
        if (isPlaying
            || (this.session != null
                && (this.session.HasPendingSeek
                    || (this.session.FrameVersion > 0 && this.session.FrameVersion != this.publishedVersion)))
            || this.HasPausedDynamicWatermark()) {
            app.RequestRedraw();
        }
    }

    private bool HasPausedDynamicWatermark() {
        if (this.Watermark != null && this.Watermark.Enabled
            && this.Watermark.AnimateWhenPaused && this.Watermark.IsDynamic()) {
            return true;
        }
        if (this.extraWatermarks != null) {
            for (int i = 0; i < this.extraWatermarks.Count; i = i + 1) {
                VideoWatermark wm = this.extraWatermarks[i];
                if (wm != null && wm.Enabled && wm.AnimateWhenPaused && wm.IsDynamic()) {
                    return true;
                }
            }
        }
        return false;
    }

    private void PaintAllWatermarks(App app, Canvas c, int vx, int vy, int vw, int vh) {
        if (this.Watermark == null && (this.extraWatermarks == null || this.extraWatermarks.Count == 0)) {
            return;
        }
        long nowTick = Environment.TickCount64;
        if (this.watermarkOriginMs == 0) {
            this.watermarkOriginMs = nowTick;
        }
        long wallElapsed = nowTick - this.watermarkOriginMs;
        long posMs = this.PositionMs;
        long durMs = this.DurationMs;

        c.PushClip(vx, vy, vw, vh);
        if (this.Watermark != null) {
            this.PaintOneWatermark(app, c, this.Watermark, vx, vy, vw, vh, posMs, durMs, wallElapsed);
        }
        if (this.extraWatermarks != null) {
            for (int i = 0; i < this.extraWatermarks.Count; i = i + 1) {
                VideoWatermark wm = this.extraWatermarks[i];
                if (wm != null) {
                    this.PaintOneWatermark(app, c, wm, vx, vy, vw, vh, posMs, durMs, wallElapsed);
                }
            }
        }
        c.PopClip();
    }

    private void PaintOneWatermark(App app, Canvas c, VideoWatermark wm,
                                   int vx, int vy, int vw, int vh,
                                   long posMs, long durMs, long wallElapsed) {
        if (!wm.Enabled) return;
        int alpha = wm.EffectiveAlpha255();
        if (alpha <= 0) return;

        long elapsed = wm.AnimateWhenPaused ? wallElapsed : (posMs > 0 ? posMs : wallElapsed);
        int mx = app.Scale(wm.MarginX);
        int my = app.Scale(wm.MarginY);
        int speed = app.Scale(wm.SpeedPxPerSec > 0 ? wm.SpeedPxPerSec : 70);

        // 1. 半透明图片 Logo 水印
        if (wm.ImagePath != null && wm.ImagePath != "") {
            int iw = wm.ImageWidth > 0 ? app.Scale(wm.ImageWidth) : ImageCodec.Width(wm.ImagePath);
            int ih = wm.ImageHeight > 0 ? app.Scale(wm.ImageHeight) : ImageCodec.Height(wm.ImagePath);
            if (iw > 0 && ih > 0) {
                int lx; int ly;
                wm.ComputePosition(vx, vy, vw, vh, iw, ih, elapsed, mx, my, speed, out lx, out ly);
                int opPm = wm.EffectiveOpacityPm();
                if (opPm >= 1000) {
                    c.BlitImage(wm.ImagePath, lx, ly, iw, ih, 0, 0, 0, 0);
                } else if (c.PushLayerOpacity(lx, ly, iw, ih, opPm)) {
                    c.BlitImage(wm.ImagePath, 0, 0, iw, ih, 0, 0, 0, 0);
                    c.PopLayer();
                }
            }
        }

        // 2. 实时文字水印
        string text = wm.ResolveText(posMs, durMs);
        if (text == null || text == "") return;

        int fs = app.Scale(wm.FontSize > 6 ? wm.FontSize : 16);
        int fg = (wm.Color & 0x00FFFFFF) | (alpha << 24);
        int shAlpha = (alpha * 7) / 10;
        if (shAlpha < 1 && alpha > 0) shAlpha = 1;
        int shadow = shAlpha << 24; // 黑色半透明投影

        if (wm.Mode == VideoWatermarkMode.Tiled) {
            int tw = Canvas.MeasureText(text, fs);
            int gapX = app.Scale(wm.TileGapX > 40 ? wm.TileGapX : 180);
            int gapY = app.Scale(wm.TileGapY > 40 ? wm.TileGapY : 120);
            int stepX = tw + gapX;
            if (stepX < app.Scale(80)) stepX = app.Scale(80);
            int rowIdx = 0;
            for (int py = vy - gapY; py < vy + vh + gapY; py = py + gapY) {
                int xOff = ((rowIdx & 1) == 1) ? (stepX / 2) : 0;
                for (int px = vx - stepX + xOff; px < vx + vw + stepX; px = px + stepX) {
                    if (wm.EnableShadow) {
                        c.DrawTextRot(px + 1, py + 1, text, shadow, fs, wm.AngleDegrees);
                    }
                    c.DrawTextRot(px, py, text, fg, fs, wm.AngleDegrees);
                }
                rowIdx = rowIdx + 1;
            }
            return;
        }

        int itemW = Canvas.MeasureText(text, fs);
        int itemH = fs + app.Scale(4);
        int tx; int ty;
        wm.ComputePosition(vx, vy, vw, vh, itemW, itemH, elapsed, mx, my, speed, out tx, out ty);
        if (wm.EnableShadow) {
            if (wm.Bold) { c.DrawTextBold(tx + 1, ty + 1, text, shadow, fs); }
            else { c.DrawText(tx + 1, ty + 1, text, shadow, fs); }
        }
        if (wm.Bold) { c.DrawTextBold(tx, ty, text, fg, fs); }
        else { c.DrawText(tx, ty, text, fg, fs); }
    }

    private void BlitVideo(Canvas c, int vw, int vh, out int vx, out int vy, out int vwOut, out int vhOut) {
        c.PushClip(this.bx, this.by, this.bw, this.bh);
        if (this.Fit == "fill") {
            vx = this.bx; vy = this.by; vwOut = this.bw; vhOut = this.bh;
            c.BlitImage(this.currentKey, this.bx, this.by, this.bw, this.bh, 0, 0, 0, 0);
        } else {
            long lhs = (long)this.bw * (long)vh;
            long rhs = (long)this.bh * (long)vw;
            int dw = this.bw;
            int dh = this.bh;
            bool cover = this.Fit == "cover";
            if ((cover && lhs < rhs) || (!cover && lhs > rhs)) {
                dw = (int)((long)this.bh * (long)vw / (long)vh);
            } else {
                dh = (int)((long)this.bw * (long)vh / (long)vw);
            }
            int dx = this.bx + (this.bw - dw) / 2;
            int dy = this.by + (this.bh - dh) / 2;
            c.BlitImage(this.currentKey, dx, dy, dw, dh, 0, 0, 0, 0);
            vx = dx < this.bx ? this.bx : dx;
            vy = dy < this.by ? this.by : dy;
            int rx = (dx + dw) > (this.bx + this.bw) ? (this.bx + this.bw) : (dx + dw);
            int ry = (dy + dh) > (this.by + this.bh) ? (this.by + this.bh) : (dy + dh);
            vwOut = rx - vx;
            vhOut = ry - vy;
        }
        c.PopClip();
    }

    private void PaintControlBar(App app, Canvas c) {
        int barH = this.ControlBarHeight(app);
        int barY = this.by + this.bh - barH;
        c.FillRect(this.bx, barY, this.bw, barH, ColorMath.WithAlpha(app.theme.scrim, 184));

        int pad = app.Scale(10);
        int fs = Style.FontFallback(app, "small");
        int ty = Canvas.CenterTextY(barY, barH, fs);

        bool playing = this.session != null && this.session.State == PlaybackState.Playing;
        string btnText = playing ? "II" : ">";
        c.DrawText(this.bx + pad + app.Scale(6), ty, btnText, app.theme.onScrim, fs);

        long pos = this.PositionMs;
        long dur = this.DurationMs;
        string timeText = VideoPlayer.FormatTimeMs(pos) + " / " + VideoPlayer.FormatTimeMs(dur);
        int trackX;
        int trackW;
        int timeX;
        this.ComputeTrackBounds(app, timeText, out trackX, out trackW, out timeX);
        c.DrawText(timeX, ty, timeText, ColorMath.ScaleAlpha(app.theme.onScrim, 850), fs);

        if (trackW > app.Scale(24)) {
            int trackH = app.Scale(6);
            int trackY = barY + (barH - trackH) / 2;
            c.FillRect(trackX, trackY, trackW, trackH, app.theme.scrimChipHover);
            if (dur > 0) {
                int fillW = (int)((long)trackW * pos / dur);
                if (fillW < 0) fillW = 0;
                if (fillW > trackW) fillW = trackW;
                c.FillRect(trackX, trackY, fillW, trackH, app.theme.primary);
            }
        }
    }

    private void SeekByPointerX(App app, int px) {
        if (this.session == null || this.session.DurationMs <= 0) return;
        string timeText = VideoPlayer.FormatTimeMs(this.PositionMs) + " / " + VideoPlayer.FormatTimeMs(this.DurationMs);
        int trackX;
        int trackW;
        int timeX;
        this.ComputeTrackBounds(app, timeText, out trackX, out trackW, out timeX);
        if (trackW <= app.Scale(24)) return;
        int rel = px - trackX;
        if (rel < 0) rel = 0;
        if (rel > trackW) rel = trackW;
        long target = (this.session.DurationMs * (long)rel) / (long)trackW;
        this.session.SeekMs(target);
        this.SyncFrameToKey();
    }

    public override void OnPointerDown(RoutedEventArgs e) {
        App app = this.FindApp();
        if (e.handled || this.disposed || this.IsDisabled() || app == null || app.window.EventButton() != 0) return;
        this.ResolveSource();
        int barH = this.ControlBarHeight(app);
        int barY = this.by + this.bh - barH;
        if (this.IsControlBarVisible(app) && e.y >= barY) {
            int pad = app.Scale(10);
            int btnEnd = this.bx + pad + app.Scale(28) + pad;
            string timeText = VideoPlayer.FormatTimeMs(this.PositionMs) + " / " + VideoPlayer.FormatTimeMs(this.DurationMs);
            int trackX;
            int trackW;
            int timeX;
            this.ComputeTrackBounds(app, timeText, out trackX, out trackW, out timeX);
            if (e.x <= btnEnd) {
                this.TogglePause();
            } else if (trackW > app.Scale(24) && e.x >= trackX && e.x <= trackX + trackW) {
                this.scrubbing = true;
                app.CapturePointer(this, true);
                this.SeekByPointerX(app, e.x);
            }
        } else {
            this.TogglePause();
        }
        app.RequestRedraw();
        e.Handle();
    }

    public override void OnPointerMove(RoutedEventArgs e) {
        App app = this.FindApp();
        if (e.handled || !this.scrubbing) return;
        if (this.disposed || this.IsDisabled()) {
            this.scrubbing = false;
            if (app != null && app.GetCapturedPointer() == this) {
                app.ReleasePointerCapture();
            }
            return;
        }
        if (app == null || app.GetCapturedPointer() != this) return;
        this.SeekByPointerX(app, e.x);
        app.RequestRedraw();
        e.Handle();
    }

    public override void OnPointerUp(RoutedEventArgs e) {
        App app = this.FindApp();
        if (!this.scrubbing) return;
        this.scrubbing = false;
        if (app != null && app.GetCapturedPointer() == this) {
            app.ReleasePointerCapture();
        }
        if (this.disposed || this.IsDisabled()) return;
        e.Handle();
    }

    public override void OnPointerCancel(RoutedEventArgs e) {
        base.OnPointerCancel(e);
        this.scrubbing = false;
        App app = this.FindApp();
        if (app != null && app.GetCapturedPointer() == this) {
            app.ReleasePointerCapture();
        }
    }

    internal void OnAppStopped() {
        this.loopRegistration = null;
        this.Dispose();
    }

    public void Dispose() {
        if (this.disposed) return;
        this.disposed = true;
        this.scrubbing = false;
        AppLoopRegistration reg = this.loopRegistration;
        this.loopRegistration = null;
        if (reg != null) { reg.Invalidate(); }
        this.resolvedSrc = null;
        this.Watermark = null;
        if (this.extraWatermarks != null) {
            this.extraWatermarks.Clear();
            this.extraWatermarks = null;
        }
        this.ReleaseTextures();
        if (this.session != null) {
            this.session.Dispose();
            this.session = null;
        }
    }
}

internal class VideoPlayerLifecycle : AppLoopParticipant, AppLoopStopped {
    weak VideoPlayer owner;

    internal VideoPlayerLifecycle(VideoPlayer player) {
        this.owner = player;
    }

    public void Tick(App app, int now) { }
    public int NextDeadline() { return -1; }

    public void Stopped(App app) {
        VideoPlayer player = this.owner;
        if (player != null) { player.OnAppStopped(); }
    }
}
