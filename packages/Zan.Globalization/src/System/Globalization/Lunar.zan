using System;
namespace System.Globalization;

// 农历查询与干支/生肖/节气计算（1900-01-31 ~ 2100-12-31，基于紫金山天文台历算表核对）。
// 年干支/生肖以正月初一为界，月干支以十二节为界，日干支按公历日计算；非节气日返回 ""。
public class Lunar {
    static bool tablesReady = false;
    static int[] yearCodes;
    static int[] yearDaysPrefix;
    static int totalDaysCached;
    static int anchorDaysCached;
    static byte[] jieQiDays;
    static string yearDataCached;
    static string jieQiDataCached;
    static string[] ganNames;
    static string[] zhiNames;
    static string[] animalNames;
    static string[] monthBases;
    static string[] digitCns;
    static string[] dayNames;
    static string[] termNames;

    private static void EnsureTables() {
        if (Lunar.tablesReady) { return; }
        Lunar.ganNames = new string[] { "甲", "乙", "丙", "丁", "戊", "己", "庚", "辛", "壬", "癸" };
        Lunar.zhiNames = new string[] { "子", "丑", "寅", "卯", "辰", "巳", "午", "未", "申", "酉", "戌", "亥" };
        Lunar.animalNames = new string[] { "鼠", "牛", "虎", "兔", "龙", "蛇", "马", "羊", "猴", "鸡", "狗", "猪" };
        Lunar.monthBases = new string[] { "正月", "二月", "三月", "四月", "五月", "六月", "七月", "八月", "九月", "十月", "冬月", "腊月" };
        Lunar.digitCns = new string[] { "一", "二", "三", "四", "五", "六", "七", "八", "九" };
        Lunar.dayNames = new string[] {
            "初一", "初二", "初三", "初四", "初五", "初六", "初七", "初八", "初九", "初十",
            "十一", "十二", "十三", "十四", "十五", "十六", "十七", "十八", "十九", "二十",
            "廿一", "廿二", "廿三", "廿四", "廿五", "廿六", "廿七", "廿八", "廿九", "三十"
        };
        Lunar.termNames = new string[] {
            "小寒", "大寒", "立春", "雨水", "惊蛰", "春分", "清明", "谷雨", "立夏", "小满", "芒种", "夏至",
            "小暑", "大暑", "立秋", "处暑", "白露", "秋分", "寒露", "霜降", "立冬", "小雪", "大雪", "冬至"
        };

        string yd = Lunar.YearData();
        int[] codes = new int[201];
        int[] pref = new int[202];
        pref[0] = 0;
        for (int idx = 0; idx < 201; idx = idx + 1) {
            int baseIdx = idx * 6;
            int v = 0;
            for (int i = 0; i < 5; i = i + 1) {
                int c = yd[baseIdx + i] & 255;
                int d = 0;
                if (c >= 48 && c <= 57) { d = c - 48; }
                else if (c >= 65 && c <= 70) { d = c - 55; }
                else if (c >= 97 && c <= 102) { d = c - 87; }
                v = (v << 4) | d;
            }
            codes[idx] = v;
            pref[idx + 1] = pref[idx] + Lunar.YearLen(v);
        }
        Lunar.yearCodes = codes;
        Lunar.yearDaysPrefix = pref;

        string jq = Lunar.JieQiData();
        int totalEntries = 201 * 24;
        int jqEntries = jq.Length / 2;
        if (jqEntries > totalEntries) { jqEntries = totalEntries; }
        byte[] jqd = new byte[totalEntries];
        for (int idx = 0; idx < jqEntries; idx = idx + 1) {
            int p = idx * 2;
            int d0 = (jq[p] & 255) - 48;
            int d1 = (jq[p + 1] & 255) - 48;
            if (d0 < 0 || d0 > 9) { d0 = 0; }
            if (d1 < 0 || d1 > 9) { d1 = 0; }
            jqd[idx] = (byte)(d0 * 10 + d1);
        }
        Lunar.jieQiDays = jqd;
        Lunar.anchorDaysCached = DateTime.DaysFromCivil(1900, 1, 31);
        Lunar.totalDaysCached = DateTime.DaysFromCivil(2100, 12, 31) - Lunar.anchorDaysCached + 1;
        Lunar.tablesReady = true;
    }

    // ---- 干支/生肖名称表(每字 UTF-8 3 字节) ----

    // 天干名,`i` 任意整数(内部取模 10)。
    public static string GanName(int i) {
        Lunar.EnsureTables();
        return Lunar.ganNames[Lunar.Mod(i, 10)];
    }

    // 地支名,`i` 任意整数(内部取模 12)。
    public static string ZhiName(int i) {
        Lunar.EnsureTables();
        return Lunar.zhiNames[Lunar.Mod(i, 12)];
    }

    // 生肖名(地支序):子鼠、丑牛、寅虎、卯兔、辰龙、巳蛇、
    // 午马、未羊、申猴、酉鸡、戌狗、亥猪。
    public static string AnimalName(int i) {
        Lunar.EnsureTables();
        return Lunar.animalNames[Lunar.Mod(i, 12)];
    }

    // 农历月份名:正月、二月 ... 冬月(十一)、腊月(十二)。
    public static string MonthBase(int m) {
        Lunar.EnsureTables();
        return Lunar.monthBases[m - 1];
    }

    // 数字 1..9 的中文写法。
    public static string DigitCn(int n) {
        Lunar.EnsureTables();
        return Lunar.digitCns[n - 1];
    }

    // 农历日名:初一 .. 三十(含初十、二十、廿九等)。
    public static string DayName(int day) {
        Lunar.EnsureTables();
        if (day >= 1 && day <= 30) { return Lunar.dayNames[day - 1]; }
        if (day == 10) { return "初十"; }
        if (day == 20) { return "二十"; }
        if (day == 30) { return "三十"; }
        if (day < 10) { return "初" + Lunar.DigitCn(day); }
        if (day < 20) { return "十" + Lunar.DigitCn(day - 10); }
        return "廿" + Lunar.DigitCn(day - 20);
    }

    // 二十四节气名(序:小寒、大寒、立春 ... 冬至)。
    public static string TermName(int t) {
        Lunar.EnsureTables();
        return Lunar.termNames[t];
    }

    // ---- 数据表 ----

    // 农历年表:1900..2100 每年 5 位十六进制(空格分隔)。
    // 编码:bit0..11 = 1~12 月大小(1=30 天),bit12..15 = 闰月号
    // (0=无闰),bit16 = 闰月大小。
    public static string YearData() {
        if (Lunar.yearDataCached != null) { return Lunar.yearDataCached; }
        Lunar.yearDataCached = ""
            + "08BD2 00752 00EA5 05B2A 0064B 00A9B 14AA6 0056A 00B59 02BAA 00752 06DA5 "
            + "00B25 00A4B 15A4B 002AD 0056B 025B5 00DA9 17E92 00E92 00D25 05D2D 00A56 "
            + "002B6 14AD5 006D4 00EA9 02F4A 00E92 066A6 0052B 00A57 15956 00B5A 006D4 "
            + "13761 00749 17B13 00A93 0052B 1651B 00AAD 0056A 14DA5 00BA4 00B49 02D4B "
            + "00A95 07AAD 00536 00AAD 15ACA 005B2 00DA5 13EA2 00D4A 08595 00A97 00556 "
            + "06575 00AD5 006D2 04755 00EA5 0064A 0364F 00A9B 07ADA 0056A 00B69 05BB2 "
            + "00B52 00B25 04B2B 00A4B 08AAB 002AD 0056D 165A9 00DA9 00D92 04E95 00D25 "
            + "0AE4D 00A56 002B6 062F5 006D5 00EA9 05F52 00E92 00D26 0352E 00A57 08AD6 "
            + "0035A 006D5 05B69 00749 00693 04A9B 0052B 00A5B 02AAE 0056A 07DD5 00BA4 "
            + "00B49 05D53 00A95 0052D 0455D 00AB5 09BAA 005D2 00DA5 16E8A 00D4A 00C95 "
            + "04A9E 00556 00AB5 02ADA 006D2 06765 00725 0064B 05657 00CAB 0055A 0356E "
            + "00B69 0BF52 00B52 00B25 16D0B 00A4B 004AB 052BB 005AD 00B6A 02DAA 00D92 "
            + "07EA5 00D25 00A55 15A4D 004B6 005B5 136D2 00EC9 08F92 00E92 00D26 16516 "
            + "00A57 004D6 14365 00755 00749 0374B 00693 07AAB 0052B 00A5B 05ABA 0056A "
            + "00B65 04BAA 00B4A 08D95 00A95 0052D 0656D 00AB5 005AA 045D5 00DA5 00D4A "
            + "03E4D 00C96 07CCE 00556 00AB5 15AD2 006D2 00EA5 0472A 0068B 08697 004AB "
            + "0055B 16556 00B6A 00752 04B95 00B45 00A8B 02A4F 004AB";
        return Lunar.yearDataCached;
    }

    // 二十四节气日表:1900..2100 每年 24 个节气(序同
    // TermName)各 2 位十进制的"日",共 48 字符/年,连续拼接。
    public static string JieQiData() {
        if (Lunar.jieQiDataCached != null) { return Lunar.jieQiDataCached; }
        Lunar.jieQiDataCached = ""
            + ""
            + ""
            + "";
        return Lunar.jieQiDataCached;
    }

    // 农历年的编码(见 YearData)。
    public static int YearCode(int ly) {
        Lunar.EnsureTables();
        return Lunar.yearCodes[ly - 1900];
    }

    // 某年某节气(0..23)在当月第几日。
    public static int JieQiDay(int year, int term) {
        Lunar.EnsureTables();
        return Lunar.jieQiDays[(year - 1900) * 24 + term] & 255;
    }

    // 十六进制字符 → 数值(0..15);未知字符返回 0。
    public static int HexDigit(string ch) {
        if (ch == null || ch.Length == 0) { return 0; }
        int c = ch[0] & 255;
        if (c >= 48 && c <= 57) { return c - 48; }
        if (c >= 65 && c <= 70) { return c - 55; }
        if (c >= 97 && c <= 102) { return c - 87; }
        return 0;
    }

    // 十进制字符 → 数值(0..9)。
    public static int Digit(string ch) {
        if (ch == null || ch.Length == 0) { return 0; }
        int c = (ch[0] & 255) - 48;
        if (c >= 0 && c <= 9) { return c; }
        return 0;
    }

    // 正负通用的取模(结果与 `b` 同号,恒非负)。
    public static int Mod(int a, int b) {
        int r = a % b;
        if (r < 0) { r = r + b; }
        return r;
    }

    // ---- 公历 → 农历 ----

    // 农历支持范围的总天数(1900-01-31 ~ 2100-12-31)。
    public static int TotalDays() {
        Lunar.EnsureTables();
        return Lunar.totalDaysCached;
    }

    // 某农历月（大小月）的天数。
    public static int MonthLen(int code, int m) {
        if ((code & (1 << (m - 1))) != 0) { return 30; }
        return 29;
    }

    // 闰月号(0 = 无闰月)。
    public static int LeapMonth(int code) {
        return (code >> 12) & 0xF;
    }

    // 闰月天数。
    public static int LeapLen(int code) {
        if ((code & 0x10000) != 0) { return 30; }
        return 29;
    }

    // 某农历年的总天数。
    public static int YearLen(int code) {
        int n = 348;
        int m = 1;
        while (m <= 12) {
            if ((code & (1 << (m - 1))) != 0) { n = n + 1; }
            m = m + 1;
        }
        if (Lunar.LeapMonth(code) != 0) { n = n + Lunar.LeapLen(code); }
        return n;
    }

    // 公历日期 → 农历日期。超出 1900-01-31 ~ 2100-12-31 抛
    // ArgumentException。
    public static LunarDate FromSolar(int year, int month, int day) {
        Lunar.EnsureTables();
        int days = DateTime.DaysFromCivil(year, month, day);
        int offset = days - Lunar.anchorDaysCached;
        if (offset < 0 || offset >= Lunar.totalDaysCached) {
            throw new ArgumentException("日期超出农历支持范围 1900-01-31 ~ 2100-12-31");
        }
        // 二分查找所属农历年（yearDaysPrefix 单调递增，最多 8 次比较）
        int[] pref = Lunar.yearDaysPrefix;
        int lo = 0;
        int hi = 200;
        while (lo < hi) {
            int mid = (lo + hi + 1) >> 1;
            if (pref[mid] <= offset) { lo = mid; }
            else { hi = mid - 1; }
        }
        int ly = 1900 + lo;
        offset = offset - pref[lo];
        int code = Lunar.yearCodes[lo];
        int leap = (code >> 12) & 0xF;
        int m = 1;
        while (m <= 12) {
            int reg = (code & (1 << (m - 1))) != 0 ? 30 : 29;
            if (offset < reg) { return new LunarDate(year, month, day, ly, m, offset + 1, false); }
            offset = offset - reg;
            if (m == leap) {
                int lm = (code & 0x10000) != 0 ? 30 : 29;
                if (offset < lm) { return new LunarDate(year, month, day, ly, m, offset + 1, true); }
                offset = offset - lm;
            }
            m = m + 1;
        }
        throw new ArgumentException("无法转换该日期");
    }

    // 今天的农历日期(按 DateTime.Now,本机时区墙钟,同 DateTime 约定)。
    public static LunarDate Now() {
        DateTime now = DateTime.Now();
        return Lunar.FromSolar(now.Year(), now.Month(), now.Day());
    }

    // ---- 便捷查询(公历参数版) ----

    // 年干支(以农历正月初一为界)。
    public static string YearGanZhi(int year, int month, int day) {
        return Lunar.FromSolar(year, month, day).YearGanZhi();
    }

    // 月干支(以节气月为界)。
    public static string MonthGanZhi(int year, int month, int day) {
        return Lunar.FromSolar(year, month, day).MonthGanZhi();
    }

    // 日干支,如 "甲辰"。按公历日直接计算,不限于农历支持范围。
    public static string DayGanZhi(int year, int month, int day) {
        int idx = Lunar.Mod(
            Lunar.DaysFromCivil(year, month, day)
            - Lunar.DaysFromCivil(1900, 1, 1) + 10, 60);  // 1900-01-01 = 甲戌
        return Lunar.GanName(idx) + Lunar.ZhiName(idx);
    }

    // 生肖(以农历正月初一为界)。
    public static string Zodiac(int year, int month, int day) {
        return Lunar.FromSolar(year, month, day).Zodiac();
    }

    // 当日节气名(小寒..冬至);非节气日返回 ""。
    public static string SolarTerm(int year, int month, int day) {
        if (year < 1900 || year > 2100 || month < 1 || month > 12) { return ""; }
        Lunar.EnsureTables();
        int t0 = (month - 1) * 2;
        int baseIdx = (year - 1900) * 24 + t0;
        if ((Lunar.jieQiDays[baseIdx] & 255) == day) { return Lunar.termNames[t0]; }
        if ((Lunar.jieQiDays[baseIdx + 1] & 255) == day) { return Lunar.termNames[t0 + 1]; }
        return "";
    }

    // 公历日序数(自 1970-01-01 起),与 DateTime 算法一致。
    public static int DaysFromCivil(int year, int month, int day) {
        return DateTime.DaysFromCivil(year, month, day);
    }
}
