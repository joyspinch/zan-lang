using System;

namespace System.Globalization;

// 农历(阴历)查询:公历 → 农历日期,以及干支(年/月/日)、生肖、
// 农历月日中文名与二十四节气。纯算法 + 内置数据表,全平台一致。
// LunarDate d = Lunar.FromSolar(2024, 2, 10);
// d.YearGanZhi();      // "甲辰"
// d.MonthName();       // "正月"
// d.DayName();         // "初一"
// d.ToString();        // "甲辰年正月初一"
// Lunar.SolarTerm(2024, 2, 4);   // "立春"(非节气日返回 "")
// 数据与规则说明:
// - 支持范围 1900-01-31(农历庚子年正月初一)~ 2100-12-31;
// - 农历年表(每年各月大小、闰月号与闰月大小)与二十四节气逐日表
// 均由权威历表(lunar_python,紫金山天文台历算)导出,并与该库在
// 1900..2100 全部 73384 天逐日核对一致;
// - 年干支以农历正月初一为界(与生肖一致);月干支以节气月为界
// (立春为年界、十二节为月界,与通书一致);日干支按公历日计算;
// - 节气按"当天"匹配:返回该日的节气名,非节气日返回空串。
class Lunar {
    // ---- 干支/生肖名称表(每字 UTF-8 3 字节) ----

    // 天干名,`i` 任意整数(内部取模 10)。
    static string GanName(int i) {
        return "甲乙丙丁戊己庚辛壬癸".Substring(Lunar.Mod(i, 10) * 3, 3);
    }

    // 地支名,`i` 任意整数(内部取模 12)。
    static string ZhiName(int i) {
        return "子丑寅卯辰巳午未申酉戌亥".Substring(Lunar.Mod(i, 12) * 3, 3);
    }

    // 生肖名(地支序):子鼠、丑牛、寅虎、卯兔、辰龙、巳蛇、
    // 午马、未羊、申猴、酉鸡、戌狗、亥猪。
    static string AnimalName(int i) {
        return "鼠牛虎兔龙蛇马羊猴鸡狗猪".Substring(Lunar.Mod(i, 12) * 3, 3);
    }

    // 农历月份名:正月、二月 ... 冬月(十一)、腊月(十二)。
    static string MonthBase(int m) {
        return "正二三四五六七八九十冬腊".Substring((m - 1) * 3, 3) + "月";
    }

    // 数字 1..9 的中文写法。
    static string DigitCn(int n) {
        return "一二三四五六七八九".Substring((n - 1) * 3, 3);
    }

    // 农历日名:初一 .. 三十(含初十、二十、廿九等)。
    static string DayName(int day) {
        if (day == 10) { return "初十"; }
        if (day == 20) { return "二十"; }
        if (day == 30) { return "三十"; }
        if (day < 10) { return "初" + Lunar.DigitCn(day); }
        if (day < 20) { return "十" + Lunar.DigitCn(day - 10); }
        return "廿" + Lunar.DigitCn(day - 20);
    }

    // 二十四节气名(序:小寒、大寒、立春 ... 冬至)。
    static string TermName(int t) {
        return ("小寒大寒立春雨水惊蛰春分清明谷雨立夏小满芒种夏至"
              + "小暑大暑立秋处暑白露秋分寒露霜降立冬小雪大雪冬至")
            .Substring(t * 6, 6);
    }

    // ---- 数据表 ----

    // 农历年表:1900..2100 每年 5 位十六进制(空格分隔)。
    // 编码:bit0..11 = 1~12 月大小(1=30 天),bit12..15 = 闰月号
    // (0=无闰),bit16 = 闰月大小。
        static string YearData() {
        return ""
            + "08BD2 00752 00EA5 05B2A 0064B 00A9B 14AA6 0056A 00B59 02BAA 00752 06DA5 "
            + "00B25 00A4B 15A4B 002AD 0056B 025B5 00DA9 17E92 00E92 00D25 05D2D 00A56 "
            + "002B6 14AD5 006D4 00EA9 02F4A 00E92 066A6 0052B 00A57 15956 00B5A 006D4 "
            + "13761 00749 17B13 00A93 0052B 1651B 00AAD 0056A 14DA5 00BA4 00B49 02D4B "
            + "00A95 07AAD 00536 00AAD 15ACA 005B2 00DA5 13EA2 00D4A 08595 00A97 00556 "
            + "06575 00AD5 006D2 04755 00EA5 0064A 0364F 00A9B 07ADA 0056A 00B69 05BB2 "
            + "00B52 00B25 04B2B 00A4B 08AAB 002AD 0056D 165A9 00DA9 00D92 04E95 00D25 "
            + "0AE4D 00A56 002B6 062F5 006D5 00EA9 05F52 00E92 00D26 0352E 00A57 08AD6 "
            + "0035A 006D5 05B69 00749 00693 04A9B 0052B 00A5B 02AAE 0056A 07DD5 00BA4 "
            + "00B49 05D53 00A95 0052D 0455D 00AB5 09BAA 005D2 00DA5 16E8A 00D4A 00C95 "
            + "04A9E 00556 00AB5 02ADA 006D2 06765 00725 0064B 05657 00CAB 0055A 0356E "
            + "00B69 0BF52 00B52 00B25 16D0B 00A4B 004AB 052BB 005AD 00B6A 02DAA 00D92 "
            + "07EA5 00D25 00A55 15A4D 004B6 005B5 136D2 00EC9 08F92 00E92 00D26 16516 "
            + "00A57 004D6 14365 00755 00749 0374B 00693 07AAB 0052B 00A5B 05ABA 0056A "
            + "00B65 04BAA 00B4A 08D95 00A95 0052D 0656D 00AB5 005AA 045D5 00DA5 00D4A "
            + "03E4D 00C96 07CCE 00556 00AB5 15AD2 006D2 00EA5 0472A 0068B 08697 004AB "
            + "0055B 16556 00B6A 00752 04B95 00B45 00A8B 02A4F 004AB";
    }

    // 二十四节气日表:1900..2100 每年 24 个节气(序同
    // TermName)各 2 位十进制的"日",共 48 字符/年,连续拼接。
    static string JieQiData() {
        return ""
            + ""
            + ""
            + "";
    }

    // 农历年的编码(见 YearData)。
    static int YearCode(int ly) {
        string s = Lunar.YearData();
        string h = s.Substring((ly - 1900) * 6, 5);
        int v = 0;
        for (int i = 0; i < 5; i = i + 1) {
            v = v * 16 + Lunar.HexDigit(h.Substring(i, 1));
        }
        return v;
    }

    // 某年某节气(0..23)在当月第几日。
    static int JieQiDay(int year, int term) {
        string s = Lunar.JieQiData();
        int i = (year - 1900) * 48 + term * 2;
        return Lunar.Digit(s.Substring(i, 1)) * 10 + Lunar.Digit(s.Substring(i + 1, 1));
    }

    // 十六进制字符 → 数值(0..15);未知字符返回 0。
    static int HexDigit(string ch) {
        if (ch == "0") { return 0; }
        if (ch == "1") { return 1; }
        if (ch == "2") { return 2; }
        if (ch == "3") { return 3; }
        if (ch == "4") { return 4; }
        if (ch == "5") { return 5; }
        if (ch == "6") { return 6; }
        if (ch == "7") { return 7; }
        if (ch == "8") { return 8; }
        if (ch == "9") { return 9; }
        if (ch == "a" || ch == "A") { return 10; }
        if (ch == "b" || ch == "B") { return 11; }
        if (ch == "c" || ch == "C") { return 12; }
        if (ch == "d" || ch == "D") { return 13; }
        if (ch == "e" || ch == "E") { return 14; }
        return 15;
    }

    // 十进制字符 → 数值(0..9)。
    static int Digit(string ch) {
        if (ch == "0") { return 0; }
        if (ch == "1") { return 1; }
        if (ch == "2") { return 2; }
        if (ch == "3") { return 3; }
        if (ch == "4") { return 4; }
        if (ch == "5") { return 5; }
        if (ch == "6") { return 6; }
        if (ch == "7") { return 7; }
        if (ch == "8") { return 8; }
        return 9;
    }

    // 正负通用的取模(结果与 `b` 同号,恒非负)。
    static int Mod(int a, int b) {
        int r = a % b;
        if (r < 0) { r = r + b; }
        return r;
    }

    // ---- 公历 → 农历 ----

    // 农历支持范围的总天数(1900-01-31 ~ 2100-12-31)。
    static int TotalDays() {
        return Lunar.DaysFromCivil(2100, 12, 31) - Lunar.DaysFromCivil(1900, 1, 31) + 1;
    }

    // 某公历月第 1 个月(大小月)的天数。
    static int MonthLen(int code, int m) {
        if ((code & (1 << (m - 1))) != 0) { return 30; }
        return 29;
    }

    // 闰月号(0 = 无闰月)。
    static int LeapMonth(int code) {
        return (code >> 12) & 0xF;
    }

    // 闰月天数。
    static int LeapLen(int code) {
        if ((code & 0x10000) != 0) { return 30; }
        return 29;
    }

    // 某农历年的总天数。
    static int YearLen(int code) {
        int n = 348;
        int m = 1;
        while (m <= 12) {
            if ((code & (1 << (m - 1))) != 0) { n = n + 1; }
            m = m + 1;
        }
        if (Lunar.LeapMonth(code) != 0) { n = n + Lunar.LeapLen(code); }
        return n;
    }

    // 公历日期 → 农历日期。超出 1900-01-31 ~ 2100-12-31 抛
    // ArgumentException。
    static LunarDate FromSolar(int year, int month, int day) {
        int days = Lunar.DaysFromCivil(year, month, day);
        int anchor = Lunar.DaysFromCivil(1900, 1, 31);
        int offset = days - anchor;
        if (offset < 0 || offset >= Lunar.TotalDays()) {
            throw new ArgumentException("日期超出农历支持范围 1900-01-31 ~ 2100-12-31");
        }
        int ly = 1900;
        while (true) {
            int len = Lunar.YearLen(Lunar.YearCode(ly));
            if (offset < len) { break; }
            offset = offset - len;
            ly = ly + 1;
        }
        int code = Lunar.YearCode(ly);
        int leap = Lunar.LeapMonth(code);
        int m = 1;
        while (m <= 12) {
            if (m == leap) {
                int reg = Lunar.MonthLen(code, m);
                if (offset < reg) { return new LunarDate(year, month, day, ly, m, offset + 1, false); }
                offset = offset - reg;
                int lm = Lunar.LeapLen(code);
                if (offset < lm) { return new LunarDate(year, month, day, ly, m, offset + 1, true); }
                offset = offset - lm;
                m = m + 1;
            } else {
                int len = Lunar.MonthLen(code, m);
                if (offset < len) { return new LunarDate(year, month, day, ly, m, offset + 1, false); }
                offset = offset - len;
                m = m + 1;
            }
        }
        throw new ArgumentException("无法转换该日期");
    }

    // 今天的农历日期(按 DateTime.Now,UTC 时刻,同 DateTime 约定)。
    static LunarDate Now() {
        DateTime now = DateTime.Now();
        return Lunar.FromSolar(now.Year(), now.Month(), now.Day());
    }

    // ---- 便捷查询(公历参数版) ----

    // 年干支(以农历正月初一为界)。
    static string YearGanZhi(int year, int month, int day) {
        return Lunar.FromSolar(year, month, day).YearGanZhi();
    }

    // 月干支(以节气月为界)。
    static string MonthGanZhi(int year, int month, int day) {
        return Lunar.FromSolar(year, month, day).MonthGanZhi();
    }

    // 日干支,如 "甲辰"。按公历日直接计算,不限于农历支持范围。
    static string DayGanZhi(int year, int month, int day) {
        int idx = Lunar.Mod(
            Lunar.DaysFromCivil(year, month, day)
            - Lunar.DaysFromCivil(1900, 1, 1) + 10, 60);  // 1900-01-01 = 甲戌
        return Lunar.GanName(idx) + Lunar.ZhiName(idx);
    }

    // 生肖(以农历正月初一为界)。
    static string Zodiac(int year, int month, int day) {
        return Lunar.FromSolar(year, month, day).Zodiac();
    }

    // 当日节气名(小寒..冬至);非节气日返回 ""。
    static string SolarTerm(int year, int month, int day) {
        if (year < 1900 || year > 2100) { return ""; }
        for (int t = 0; t < 24; t = t + 1) {
            if (t / 2 + 1 == month && Lunar.JieQiDay(year, t) == day) {
                return Lunar.TermName(t);
            }
        }
        return "";
    }

    // 公历日序数(自 1970-01-01 起),与 DateTime 算法一致。
    static int DaysFromCivil(int year, int month, int day) {
        return DateTime.DaysFromCivil(year, month, day);
    }
}

// 一个农历日期:年/月/日 + 是否闰月,及干支/生肖/中文名查询。
class LunarDate {
    int solarYear;
    int solarMonth;
    int solarDay;
    int year;  // 农历年
    int month;  // 农历月 1..12
    int day;  // 农历日 1..30
    bool isLeap;  // 是否闰月

    LunarDate(int sy, int sm, int sd, int y, int m, int d, bool leap) {
        solarYear = sy;
        solarMonth = sm;
        solarDay = sd;
        year = y;
        month = m;
        day = d;
        isLeap = leap;
    }

    // 农历年。
    int Year() { return year; }

    // 农历月 1..12。
    int Month() { return month; }

    // 农历日 1..30。
    int Day() { return day; }

    // 是否闰月。
    bool IsLeapMonth() { return isLeap; }

    // 年干支,如 "甲辰"(按农历正月初一为界,与生肖一致)。
    string YearGanZhi() {
        int idx = Lunar.Mod(year - 1984, 60);  // 1984 甲子年
        return Lunar.GanName(idx) + Lunar.ZhiName(idx);
    }

    // 生肖,如 "龙"。
    string Zodiac() {
        return Lunar.AnimalName(year - 1984);
    }

    // 月干支(节气月,以立春为年界、十二节为月界),如 "丙寅"。
    // 与农历月份无关,闰月沿用其所在节气月。
    string MonthGanZhi() {
        int lichun = Lunar.DaysFromCivil(solarYear, 2, Lunar.JieQiDay(solarYear, 2));
        int today = Lunar.DaysFromCivil(solarYear, solarMonth, solarDay);
        int jieYear = solarYear;
        if (today < lichun) { jieYear = solarYear - 1; }
        // 十二节:立春(0) 惊蛰(1) 清明(2) 立夏(3) 芒种(4) 小暑(5)
        // 立秋(6) 白露(7) 寒露(8) 立冬(9) 大雪(10) 小寒(11)
        int last = -1;
        int i = 0;
        while (i < 12) {
            int yy = jieYear;
            if (i == 11) { yy = jieYear + 1; }  // 小寒在次年 1 月
            if (yy < 1900 || yy > 2100) { i = i + 1; continue; }
            int term = Lunar.Mod((i + 1) * 2, 24);
            int d0 = Lunar.DaysFromCivil(yy, term / 2 + 1, Lunar.JieQiDay(yy, term));
            if (d0 <= today) { last = i; }
            i = i + 1;
        }
        int k = last < 0 ? 0 : last;
        int yearIdx = Lunar.Mod(jieYear - 1984, 60);
        int firstGan = (yearIdx % 10 % 5) * 2 + 2;  // 甲己之年丙作首...
        int mg = Lunar.Mod(firstGan + k, 10);
        int mz = Lunar.Mod(k + 2, 12);
        return Lunar.GanName(mg) + Lunar.ZhiName(mz);
    }

    // 日干支,如 "甲辰"(按公历日直接计算,不限于农历范围)。
    string DayGanZhi() {
        return Lunar.DayGanZhi(solarYear, solarMonth, solarDay);
    }

    // 农历月份中文名,闰月带 "闰" 前缀,如 "正月"、"闰二月"。
    string MonthName() {
        string b = Lunar.MonthBase(month);
        if (isLeap) { return "闰" + b; }
        return b;
    }

    // 农历日中文名,如 "初一"、"廿三"。
    string DayName() {
        return Lunar.DayName(day);
    }

    // 完整表示,如 "甲辰年正月初一"、"癸卯年闰二月初一"。
    string ToString() {
        return this.YearGanZhi() + "年" + this.MonthName() + this.DayName();
    }
}
