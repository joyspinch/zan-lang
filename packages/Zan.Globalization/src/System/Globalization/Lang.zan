using System;
using System.IO;
using System.Json;

namespace System.Globalization;

// 键式多语言查找（Apple .strings 同构）：源码保留英文原文作键（同时作缺省值），
// 运行时按语言代码加载 <dir>/<code>.json 平铺键值包并缓存；未命中回退缺省串。
// 同形异义可用 '@' 后缀消歧（如 "Cloud@云服务"），源语言展示时由调用方剥除。
public class Lang {
    // 当前语言代码（"en" / "zh" / ...）。空串 = 源语言（键本身），
    // 查找直接返回缺省串，不查表。
    public static string code = "";

    // 已解析的语言包缓存（语言代码 -> 键值表）。
    public static Dictionary<string, Dictionary<string, string>> packs;

    // 语言包所在目录的候选列表（LoadDir/LoadDirs 记录）。按序探测：
    // 仓库内运行用工程相对路径，发布形态用 exe 旁的 assets/ 相对路径。
    public static List<string> dirs;

    private static object packLock = new object();

    private static bool IsSafeCode(string c) {
        if (c == null || c.Length == 0) { return false; }
        for (int i = 0; i < c.Length; i = i + 1) {
            int b = c[i] & 255;
            if (b < 32 || b == 47 || b == 58 || b == 92 || b == 127) { return false; }
            if (b == 46 && i + 1 < c.Length && (c[i + 1] & 255) == 46) { return false; }
        }
        return true;
    }

    // 当前语言代码。
    public static string Code() {
        lock (Lang.packLock) {
            return Lang.code;
        }
    }

    // 切换语言（"en"/"zh"/...；空串 = 源语言）。包在首次
    // 查找时按需加载；未知语言在查找时表现为回退缺省串。返回是否
    // 发生了变化。
    public static bool Set(string newCode) {
        string next = newCode == null ? "" : newCode;
        if (next != "" && !Lang.IsSafeCode(next)) { return false; }
        lock (Lang.packLock) {
            if (Lang.code == next) { return false; }
            Lang.code = next;
            return true;
        }
    }

    // 设置语言包目录并立即预载当前语言的包（可选）。之后
    // 每次切语言都会从同一目录按需加载对应包。
    public static void LoadDir(string langDir) {
        List<string> ds = new List<string>();
        ds.Add(langDir);
        Lang.LoadDirs(ds);
    }

    // 同 LoadDir，但接受一组按序探测的候选目录（第一个存在
    // 对应包文件的获胜）——与宿主程序自己的资产路径解析约定对齐。
    public static void LoadDirs(List<string> langDirs) {
        string cur = "";
        List<string> copy = null;
        if (langDirs != null) {
            copy = new List<string>();
            for (int i = 0; i < langDirs.Count; i = i + 1) {
                copy.Add(langDirs[i]);
            }
        }
        lock (Lang.packLock) {
            Lang.dirs = copy;
            if (Lang.packs != null) { Lang.packs.Clear(); }
            cur = Lang.code;
        }
        if (cur != "") { Lang.Pack(cur); }
    }

    // 两参查找：key 为英文原文，dflt 为缺省串；命中语言包返回译文，否则回退 dflt。
    public static string Tr(string key, string dflt) {
        string cur = "";
        lock (Lang.packLock) {
            cur = Lang.code;
        }
        if (cur == "" || key == null || key == "") { return dflt; }
        Dictionary<string, string> pack = Lang.Pack(cur);
        if (pack == null) { return dflt; }
        string v = null;
        if (pack.TryGetValue(key, out v)) { return v; }
        return dflt;
    }

    // 单参查找：未命中语言包时回退 key 本身（含 '@' 消歧后缀，需展示层自行剥除）。
    public static string Tr(string key) {
        return Lang.Tr(key, key);
    }

    // 语言代码 -> 键值表；解析失败/文件缺失返回 null（查找
    // 逐条回退缺省串，不打断程序）。包只解析一次，之后走缓存。
    public static Dictionary<string, string> Pack(string code) {
        if (!Lang.IsSafeCode(code)) { return null; }
        List<string> searchDirs = null;
        lock (Lang.packLock) {
            Dictionary<string, string> cached = null;
            if (Lang.packs != null && Lang.packs.TryGetValue(code, out cached)) {
                return cached;
            }
            if (Lang.dirs != null) {
                searchDirs = new List<string>();
                for (int i = 0; i < Lang.dirs.Count; i = i + 1) {
                    searchDirs.Add(Lang.dirs[i]);
                }
            }
        }
        Dictionary<string, string> pack = null;
        if (searchDirs != null) {
            for (int di = 0; di < searchDirs.Count; di = di + 1) {
                string dir = searchDirs[di];
                if (dir == null || dir.Length == 0) { continue; }
                string path = dir + "/" + code + ".json";
                if (!File.Exists(path)) { continue; }
                JsonValue root = null;
                try {
                    string raw = File.ReadAllText(path);
                    root = raw != null ? JsonValue.Parse(raw) : null;
                } catch (Exception) {
                    root = null;
                }
                if (root != null && root.IsObject()) {
                    pack = new Dictionary<string, string>();
                    for (int i = 0; i < root.Count(); i = i + 1) {
                        JsonValue v = root.ValAt(i);
                        if (v == null || !v.IsString()) { continue; }
                        pack[root.KeyAt(i)] = v.AsString("");
                    }
                }
                break;  // 文件存在即认领（坏包也如此），与 DataText 一致
            }
        }
        lock (Lang.packLock) {
            if (Lang.packs == null) {
                Lang.packs = new Dictionary<string, Dictionary<string, string>>();
            }
            Dictionary<string, string> existing = null;
            if (Lang.packs.TryGetValue(code, out existing)) {
                return existing;
            }
            Lang.packs[code] = pack;
            return pack;
        }
    }
}
