using System;
namespace System.Globalization;

// 一个农历日期:年/月/日 + 是否闰月,及干支/生肖/中文名查询。
public class LunarDate {
    public int solarYear;
    public int solarMonth;
    public int solarDay;
    public int year;  // 农历年
    public int month;  // 农历月 1..12
    public int day;  // 农历日 1..30
    public bool isLeap;  // 是否闰月

    public LunarDate(int sy, int sm, int sd, int y, int m, int d, bool leap) {
        solarYear = sy;
        solarMonth = sm;
        solarDay = sd;
        year = y;
        month = m;
        day = d;
        isLeap = leap;
    }

    // 农历年。
    public int Year() { return year; }

    // 农历月 1..12。
    public int Month() { return month; }

    // 农历日 1..30。
    public int Day() { return day; }

    // 是否闰月。
    public bool IsLeapMonth() { return isLeap; }

    // 年干支,如 "甲辰"(按农历正月初一为界,与生肖一致)。
    public string YearGanZhi() {
        int idx = Lunar.Mod(year - 1984, 60);  // 1984 甲子年
        return Lunar.GanName(idx) + Lunar.ZhiName(idx);
    }

    // 生肖,如 "龙"。
    public string Zodiac() {
        return Lunar.AnimalName(year - 1984);
    }

    // 月干支(节气月,以立春为年界、十二节为月界),如 "丙寅"。
    // 与农历月份无关,闰月沿用其所在节气月。
    public string MonthGanZhi() {
        int lichun = Lunar.DaysFromCivil(solarYear, 2, Lunar.JieQiDay(solarYear, 2));
        int today = Lunar.DaysFromCivil(solarYear, solarMonth, solarDay);
        int jieYear = solarYear;
        if (today < lichun) { jieYear = solarYear - 1; }
        // 十二节:立春(0) 惊蛰(1) 清明(2) 立夏(3) 芒种(4) 小暑(5)
        // 立秋(6) 白露(7) 寒露(8) 立冬(9) 大雪(10) 小寒(11)
        int last = -1;
        int i = 0;
        while (i < 12) {
            int yy = jieYear;
            if (i == 11) { yy = jieYear + 1; }  // 小寒在次年 1 月
            if (yy < 1900 || yy > 2100) { i = i + 1; continue; }
            int term = Lunar.Mod((i + 1) * 2, 24);
            int d0 = Lunar.DaysFromCivil(yy, term / 2 + 1, Lunar.JieQiDay(yy, term));
            if (d0 <= today) { last = i; }
            i = i + 1;
        }
        int k = last < 0 ? 0 : last;
        int yearIdx = Lunar.Mod(jieYear - 1984, 60);
        int firstGan = (yearIdx % 10 % 5) * 2 + 2;  // 甲己之年丙作首...
        int mg = Lunar.Mod(firstGan + k, 10);
        int mz = Lunar.Mod(k + 2, 12);
        return Lunar.GanName(mg) + Lunar.ZhiName(mz);
    }

    // 日干支,如 "甲辰"(按公历日直接计算,不限于农历范围)。
    public string DayGanZhi() {
        return Lunar.DayGanZhi(solarYear, solarMonth, solarDay);
    }

    // 农历月份中文名,闰月带 "闰" 前缀,如 "正月"、"闰二月"。
    public string MonthName() {
        string b = Lunar.MonthBase(month);
        if (isLeap) { return "闰" + b; }
        return b;
    }

    // 农历日中文名,如 "初一"、"廿三"。
    public string DayName() {
        return Lunar.DayName(day);
    }

    // 完整表示,如 "甲辰年正月初一"、"癸卯年闰二月初一"。
    public string ToString() {
        return this.YearGanZhi() + "年" + this.MonthName() + this.DayName();
    }
}
