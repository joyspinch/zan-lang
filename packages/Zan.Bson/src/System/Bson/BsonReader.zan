using System;
using System.Json;
using System.Text;

namespace System.Bson;

/// <summary>
/// BSON 解码原语：在 byte[] 上游走，ReadDocument 按元素类型字节
/// 分派递归还原成 System.Json.JsonValue。二进制子类型按 UTF-8 尽力
/// 解码成字符串（非法序列收敛 U+FFFD）；ObjectId 还原成 24 位小写
/// 十六进制串；datetime（UTC 毫秒）还原成 ISO 8601 UTC 字符串。
/// regex/code/timestamp/decimal128/minkey/maxkey 等值模型外的类型
/// 报错。深度限 512。文档长度严格校验：声明长度必须与实际消耗一致。
/// </summary>
class BsonReader {
    byte[] buf;
    int pos;
    int len;

    /// 包装整段字节。
    public BsonReader(byte[] data) {
        buf = data;
        pos = 0;
        len = data.Length;
    }

    /// 包装切片 [offset, offset+count)。
    public BsonReader(byte[] data, int offset, int count) {
        buf = data;
        pos = offset;
        len = offset + count;
    }

    int U8() {
        if (pos >= len) {
            throw new BsonException("truncated at byte "
                + Convert.ToString(pos));
        }
        int b = buf[pos] & 255;
        pos = pos + 1;
        return b;
    }

    long U32LE() {
        long v = U8();
        v = v | ((long)U8() << 8);
        v = v | ((long)U8() << 16);
        return v | ((long)U8() << 24);
    }

    long U64LE() {
        long v = 0;
        int i = 0;
        while (i < 8) {
            v = v | ((long)U8() << (i * 8));
            i = i + 1;
        }
        return v;
    }

    /// <summary>有符号 32 位（LE 读入后符号扩展由 long 承载，
    /// 截回 int 域）。</summary>
    int S32LE() {
        long v = U32LE();
        if (v >= 2147483648) { v = v - 4294967296; }
        return (int)v;
    }

    /// <summary>取 n 字节（越界抛）。n 用减法比较防 int 溢出绕过。</summary>
    byte[] Take(int n) {
        if (n < 0 || n > len - pos) {
            throw new BsonException("truncated at byte "
                + Convert.ToString(pos) + " (need " + Convert.ToString(n) + ")");
        }
        byte[] out2 = new byte[n];
        NativeMemory.Copy((nint)out2, (nint)buf + pos, n);
        pos = pos + n;
        return out2;
    }

    /// <summary>读一个完整文档（int32 总长 + 元素 + 0x00）。
    /// asArray 时按元素顺序还原成 JsonValue 数组（MongoDB 语义：
    /// 数组键就是 "0","1",…，键名不参与语义）；否则还原成对象。</summary>
    JsonValue ReadDocument(int depth, bool asArray) {
        if (depth > 512) {
            throw new BsonException("nesting too deep at byte "
                + Convert.ToString(pos));
        }
        int lenAt = pos;
        int total = S32LE();
        if (total < 5) {
            throw new BsonException("document length " + Convert.ToString(total)
                + " below minimum 5 at byte " + Convert.ToString(lenAt));
        }
        if (total > 536870912) {
            throw new BsonException("document length " + Convert.ToString(total)
                + " exceeds 512MB limit at byte " + Convert.ToString(lenAt));
        }
        if (total > len - lenAt) {
            throw new BsonException("truncated document at byte "
                + Convert.ToString(lenAt) + " (declares "
                + Convert.ToString(total) + ")");
        }
        int bodyEnd = lenAt + total;
        JsonValue v = asArray ? JsonValue.NewArray() : JsonValue.NewObject();
        while (true) {
            int typeAt = pos;
            int t = U8();
            if (t == 0) {
                // 终止符：声明长度必须恰好消耗完（多出的尾部字节同属畸形）。
                if (pos != bodyEnd) {
                    throw new BsonException("document length mismatch at byte "
                        + Convert.ToString(lenAt) + " (declares "
                        + Convert.ToString(total) + ", ends at "
                        + Convert.ToString(pos) + ")");
                }
                return v;
            }
            if (typeAt >= bodyEnd) {
                throw new BsonException("element past document end at byte "
                    + Convert.ToString(typeAt));
            }
            string name = CStr(bodyEnd);
            JsonValue item = ReadElement(t, depth);
            if (asArray) { v.Append(item); } else { v.Put(name, item); }
        }
    }

    /// cstring 元素名：扫描到第一个 NUL（cstring 定义上不含 NUL，
    /// 首个即终结）；扫到文档尾都没遇到即畸形。
    string CStr(int bodyEnd) {
        int start = pos;
        while (pos < bodyEnd && pos < len) {
            if ((buf[pos] & 255) == 0) {
                int n = pos - start;
                pos = start;
                byte[] b = Take(n);
                pos = pos + 1;
                return Encoding.GetString(b, 0, b.Length);
            }
            pos = pos + 1;
        }
        throw new BsonException("unterminated element name at byte "
            + Convert.ToString(start));
    }

    /// 按类型字节解码单个元素值（流已定位在值起点）。
    JsonValue ReadElement(int t, int depth) {
        if (t == 1) {  // double
            return JsonValue.NewDouble(BitsDouble(U64LE()));
        }
        if (t == 2) {  // string
            return JsonValue.NewStr(DecodedText(StringBody()));
        }
        if (t == 3) { return ReadDocument(depth + 1, false); }  // document
        if (t == 4) { return ReadDocument(depth + 1, true); }  // array
        if (t == 5) {  // binary
            int n = S32LE();
            if (n < 0 || n > 536870912) {
                throw new BsonException("binary length out of bounds at byte " + Convert.ToString(pos));
            }
            int subtype = U8();
            if (subtype == 2) {
                // 过时的 subtype 0x02：payload 前置 int32 内嵌长度，
                // 必须与外层一致（n = 4 + inner），不符即畸形。
                if (n < 4 || S32LE() != n - 4) {
                    throw new BsonException("binary subtype 0x02 embedded"
                        + " length mismatch at byte " + Convert.ToString(pos));
                }
                return JsonValue.NewStr(DecodedText(Take(n - 4)));
            }
            return JsonValue.NewStr(DecodedText(Take(n)));
        }
        if (t == 7) { return JsonValue.NewStr(HexOf(Take(12))); }  // ObjectId
        if (t == 8) {  // bool
            int bv = U8();
            if (bv != 0 && bv != 1) {
                throw new BsonException("boolean value must be 0x00 or 0x01,"
                    + " got 0x" + HexByte(bv) + " at byte "
                    + Convert.ToString(pos - 1));
            }
            return JsonValue.NewBool(bv != 0);
        }
        if (t == 9) { return JsonValue.NewStr(IsoFromMs(U64LE())); }  // datetime
        if (t == 10) { return JsonValue.NewNull(); }  // null
        if (t == 16) { return JsonValue.NewInt(S32LE()); }  // int32
        if (t == 18) { return JsonValue.NewInt(U64LE()); }  // int64
        throw new BsonException("unsupported type 0x"
            + HexByte(t) + " at byte " + Convert.ToString(pos - 1));
    }

    /// string 值主体：int32 字节数（含终止 NUL）+ 字节 + NUL，
    /// 末字节必须为 0。
    byte[] StringBody() {
        int n = S32LE();
        if (n < 1) {
            throw new BsonException("string length " + Convert.ToString(n)
                + " below minimum 1 at byte " + Convert.ToString(pos));
        }
        if (n > 536870912) {
            throw new BsonException("string length " + Convert.ToString(n)
                + " exceeds 512MB limit at byte " + Convert.ToString(pos));
        }
        byte[] b = Take(n);
        if ((b[n - 1] & 255) != 0) {
            throw new BsonException("string missing NUL terminator at byte "
                + Convert.ToString(pos));
        }
        byte[] body = new byte[n - 1];
        NativeMemory.Copy((nint)body, (nint)b, n - 1);
        return body;
    }

    /// 12 字节 ObjectId → 24 位小写十六进制。
    static string HexOf(byte[] b) {
        StringBuilder sb = new StringBuilder();
        string hex = "0123456789abcdef";
        int i = 0;
        while (i < b.Length) {
            int v = b[i] & 255;
            sb.Append(hex.Substring(v >> 4, 1));
            sb.Append(hex.Substring(v & 15, 1));
            i = i + 1;
        }
        return sb.ToString();
    }

    static string HexByte(int b) {
        string hex = "0123456789abcdef";
        return hex.Substring((b >> 4) & 15, 1) + hex.Substring(b & 15, 1);
    }

    /// <summary>UTC 毫秒 → ISO 8601（"YYYY-MM-DDTHH:MM:SS[.fff]Z"）。
    /// 毫秒非零才带小数节（与 MsgPack timestamp 的读侧形态一致）。
    /// 负毫秒（1970 前）向下取整到秒，避免截断方向错一天。</summary>
    static string IsoFromMs(long ms) {
        long sec = ms / 1000;
        long rem = ms % 1000;
        if (rem < 0) { rem = rem + 1000; sec = sec - 1; }
        DateTime t = DateTime.FromUnixSeconds(sec);
        StringBuilder sb = new StringBuilder();
        sb.Append(Pad4(t.Year()));
        sb.Append("-");
        sb.Append(Pad2(t.Month()));
        sb.Append("-");
        sb.Append(Pad2(t.Day()));
        sb.Append("T");
        sb.Append(Pad2(t.Hour()));
        sb.Append(":");
        sb.Append(Pad2(t.Minute()));
        sb.Append(":");
        sb.Append(Pad2(t.Second()));
        if (rem > 0) {
            sb.Append(".");
            if (rem < 100) { sb.Append("0"); }
            if (rem < 10) { sb.Append("0"); }
            sb.Append(Convert.ToString(rem));
        }
        sb.Append("Z");
        return sb.ToString();
    }

    static string Pad2(int v) {
        if (v < 10) { return "0" + Convert.ToString(v); }
        return Convert.ToString(v);
    }

    static string Pad4(int v) {
        string s = Convert.ToString(v);
        while (s.Length < 4) { s = "0" + s; }
        return s;
    }

    /// 由 IEEE-754 位型还原 double：编译器内建 bitcast
    /// （NativeMemory.AsF64，零开销、逐位精确）。
    static double BitsDouble(long bits) {
        return NativeMemory.AsF64(bits);
    }

    /// 字节 → 字符串（UTF-8 尽力，非法序列 U+FFFD）。
    static string DecodedText(byte[] b) {
        return Encoding.GetString(b, 0, b.Length);
    }
}
