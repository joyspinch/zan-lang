using System;
using System.IO;
using System.Json;

namespace System.Bson;

// BSON 门面：JsonValue ↔ 线上字节的 schemaless 互转。根必须是
// 文档（对象）——BSON 规范如此，数组/标量请自行包一层。整型形态
// 数字（JsonValue.IsInt）按值域选 int32/int64，浮点形态走 double
// （形态保持，与 MsgPack 同约定）；null ↔ null；读侧 binary 按
// UTF-8 尽力解码成字符串、ObjectId 还原 24 位十六进制、datetime
// 还原 ISO 8601 UTC 字符串。深度上限 512，与 System.Json 对称。
// Unpack 读首个文档后忽略尾部字节（可从多文档流里取第一个）。
class Bson {
    // 递归深度上限（编码/解码两侧一起限）。
    static int MaxDepth = 512;

    // 把文档编码成 BSON 字节。根必须是对象；键不得含
    // NUL（cstring 语义）。
    static byte[] Pack(JsonValue v) {
        if (v == null || !v.IsObject()) {
            throw new BsonException("root must be a document (object)");
        }
        BsonWriter w = new BsonWriter();
        int n = v.Count();
        int i = 0;
        while (i < n) {
            EncodeElement(w, v.KeyAt(i), v.ValAt(i), 0);
            i = i + 1;
        }
        return w.FinishDocument();
    }

    // 解码整段 BSON 字节的首个文档（非法即抛 BsonException）。
    static JsonValue Unpack(byte[] data) {
        BsonReader r = new BsonReader(data);
        return r.ReadDocument(0, false);
    }

    // 解码切片 [offset, offset+count)。
    static JsonValue Unpack(byte[] data, int offset, int count) {
        BsonReader r = new BsonReader(data, offset, count);
        return r.ReadDocument(0, false);
    }

    // 从文件读入并解码。
    static JsonValue Load(string path) {
        return Bson.Unpack(File.ReadAllBytes(path));
    }

    // 编码并写入文件。
    static void Save(JsonValue v, string path) {
        File.WriteAllBytes(path, Bson.Pack(v));
    }

    // 编码单个元素：类型字节 + cstring 键 + 值。嵌套
    // 文档/数组先编进子缓冲（FinishDocument 自带头尾），再整体
    // 拼接——长度天然自洽。
    static void EncodeElement(BsonWriter w, string key, JsonValue v, int depth) {
        if (depth > Bson.MaxDepth) {
            throw new BsonException("nesting too deep while packing");
        }
        if (v == null || v.IsNull()) { w.RawType(10); w.CStr(key); return; }
        if (v.IsBool()) { w.RawType(8); w.CStr(key); w.WriteBool(v.AsBool(false)); return; }
        if (v.IsNumber()) {
            if (v.IsInt()) {
                long n = v.AsLong(0);
                if (n >= -2147483648 && n <= 2147483647) {
                    w.RawType(16); w.CStr(key); w.WriteInt32((int)n);
                } else {
                    w.RawType(18); w.CStr(key); w.WriteInt64(n);
                }
            } else {
                w.RawType(1); w.CStr(key); w.WriteDouble(v.AsDouble(0));
            }
            return;
        }
        if (v.IsString()) { w.RawType(2); w.CStr(key); w.WriteString(v.AsString("")); return; }
        if (v.IsArray()) {
            BsonWriter child = new BsonWriter();
            int n = v.Count();
            int i = 0;
            while (i < n) {
                EncodeElement(child, Convert.ToString(i), v.At(i), depth + 1);
                i = i + 1;
            }
            w.RawType(4); w.CStr(key); w.RawBytes(child.FinishDocument());
            return;
        }
        if (v.IsObject()) {
            BsonWriter child = new BsonWriter();
            int n = v.Count();
            int i = 0;
            while (i < n) {
                EncodeElement(child, v.KeyAt(i), v.ValAt(i), depth + 1);
                i = i + 1;
            }
            w.RawType(3); w.CStr(key); w.RawBytes(child.FinishDocument());
            return;
        }
        throw new BsonException("unsupported value kind while packing");
    }
}
