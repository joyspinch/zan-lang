using System;
using System.Collections.Generic;

namespace Game.Tycoon;

// 餐厅与经营模拟后厨出餐队列（KitchenQueue）。
// 对应《潜水员戴夫》、开罗系列餐厅核心后厨烹饪逻辑：
// 菜单下单排队、多灶台并行烹饪、火候进度推进、出餐完成通知与超时烧焦机制。
public class KitchenQueue {
    public class CookingTask {
        public int orderId;
        public string recipeId;
        public double totalTime;
        public double currentTime;
        public bool isDone;
        public bool isBurnt;

        public CookingTask(int orderId, string recipeId, double cookDuration) {
            this.orderId = orderId;
            this.recipeId = recipeId != null ? recipeId : "";
            this.totalTime = cookDuration > 0.0 ? cookDuration : 5.0;
            this.currentTime = 0.0;
            this.isDone = false;
            this.isBurnt = false;
        }

        public double Progress { get { return totalTime > 0.0 ? currentTime / totalTime : 0.0; } }
    }

    public List<CookingTask> activeTasks;
    public int maxStoves; // 最大并行灶台/烹饪槽位数 (如默认 3 个灶台)

    public KitchenQueue(int maxStoves) {
        this.maxStoves = maxStoves > 0 ? maxStoves : 3;
        this.activeTasks = new List<CookingTask>();
    }

    public static KitchenQueue Create(int maxStoves) {
        return new KitchenQueue(maxStoves);
    }

    public int ActiveCount { get { return activeTasks.Count; } }
    public bool CanAcceptNewOrder { get { return activeTasks.Count < maxStoves; } }

    // 下单开始烹饪
    public bool StartCooking(int orderId, string recipeId, double cookDuration) {
        if (!CanAcceptNewOrder) {
            return false;
        }
        activeTasks.Add(new CookingTask(orderId, recipeId, cookDuration));
        return true;
    }

    // 逐帧推进烹饪进度
    public void Update(double dt) {
        if (dt <= 0.0) { return; }

        for (int i = 0; i < activeTasks.Count; i = i + 1) {
            CookingTask t = activeTasks[i];
            if (!t.isDone) {
                t.currentTime = t.currentTime + dt;
                if (t.currentTime >= t.totalTime) {
                    t.currentTime = t.totalTime;
                    t.isDone = true; // 烹饪完成，出餐待取！
                }
            }
        }
    }

    // 服务员取走已烹饪好的菜品
    public bool TakeReadyDish(int orderId, out string outRecipeId) {
        outRecipeId = "";
        for (int i = 0; i < activeTasks.Count; i = i + 1) {
            CookingTask t = activeTasks[i];
            if (t.orderId == orderId && t.isDone) {
                outRecipeId = t.recipeId;
                activeTasks.RemoveAt(i);
                return true;
            }
        }
        return false;
    }
}
