// 定向信息
public class LocalPushOcProjectGetResponseDataAudience {
    public JsonValue? RawJson;
    // 定向包id
    public long AudiencePackageId;
    // 地域类型
    public string District;
    // 行政区域信息 ，当district=REGION 行政区域划分时有效且必填
    public LocalPushOcProjectGetResponseDataAudienceRegion? Region;
    // 自定义区域设置
    public LocalPushOcProjectGetResponseDataAudienceCustomArea? CustomArea;
    // 门店附近定向设置
    public LocalPushOcProjectGetResponseDataAudiencePoiAround? PoiAround;
    // 年龄 可选值: AGE_ABOVE_50 50+ AGE_ABOVE_60 60+ AGE_BETWEEN_0_17 0-17 AGE_BETWEEN_1...
    public List<string> Age;
    // 性别，不传默认不限 可选值: FEMALE 女 MALE 男 NONE 不限
    public string Gender;
    // 定向人群包ID
    public List<long> RetargetingTags;
    // 排除人群包ID
    public List<long> RetargetingTagsExclude;
    // 过滤已转化的维度 可选值: ADVERTISER 投放账户 CUSTOMER 公司账户 NO_EXCLUDE 不过滤 ORGANIZATION 组织账户 ...
    public string HideIfConverted;
    // 过滤高活跃用户 可选值: FILTER_AWEME_ABNORMAL_ACTIVE_TYPE_OFF 关闭过滤高活跃用户 FILTER_AWEME_ABN...
    public string FilterAwemeAbnormalActive;
    // 过滤高关注数用户 可选值: FILTER_AWEME_FANS_COUNT_TYPE_OFF 关闭过滤高关注数用户 FILTER_AWEME_FANS_C...
    public string FilterAwemeFansCount;
    // 行为兴趣设置 可选值: INTERESTACTION_AUTO 系统推荐 INTERESTACTION_CUSTOM 自定义 INTERESTACTION...
    public string CustomizedInterestAction;
    // 兴趣设置
    public LocalPushOcProjectGetResponseDataAudienceInterestConfig? InterestConfig;
    // 行为
    public LocalPushOcProjectGetResponseDataAudienceActionConfig? ActionConfig;
    // 智能定向拓展 可选值: OFF ON
    public string AutoExtendTargets;

    public static LocalPushOcProjectGetResponseDataAudience? FromJson(JsonValue? obj) {
        if (obj != null && obj.IsString()) {
            try { obj = JsonValue.Parse(obj.AsString("")); } catch (Exception e) { }
        }
        if (obj == null || !obj.IsObject()) { return null; }
        LocalPushOcProjectGetResponseDataAudience model = new LocalPushOcProjectGetResponseDataAudience();
        model.RawJson = obj;
        model.AudiencePackageId = OceanEngineJson.GetLong(obj, "audience_package_id", 0L);
        model.District = OceanEngineJson.GetString(obj, "district", "");
        model.Region = LocalPushOcProjectGetResponseDataAudienceRegion.FromJson(OceanEngineJson.GetValue(obj, "region"));
        model.CustomArea = LocalPushOcProjectGetResponseDataAudienceCustomArea.FromJson(OceanEngineJson.GetValue(obj, "custom_area"));
        model.PoiAround = LocalPushOcProjectGetResponseDataAudiencePoiAround.FromJson(OceanEngineJson.GetValue(obj, "poi_around"));
        model.Age = OceanEngineJson.GetStringList(obj, "age");
        model.Gender = OceanEngineJson.GetString(obj, "gender", "");
        model.RetargetingTags = OceanEngineJson.GetLongList(obj, "retargeting_tags");
        model.RetargetingTagsExclude = OceanEngineJson.GetLongList(obj, "retargeting_tags_exclude");
        model.HideIfConverted = OceanEngineJson.GetString(obj, "hide_if_converted", "");
        model.FilterAwemeAbnormalActive = OceanEngineJson.GetString(obj, "filter_aweme_abnormal_active", "");
        model.FilterAwemeFansCount = OceanEngineJson.GetString(obj, "filter_aweme_fans_count", "");
        model.CustomizedInterestAction = OceanEngineJson.GetString(obj, "customized_interest_action", "");
        model.InterestConfig = LocalPushOcProjectGetResponseDataAudienceInterestConfig.FromJson(OceanEngineJson.GetValue(obj, "interest_config"));
        model.ActionConfig = LocalPushOcProjectGetResponseDataAudienceActionConfig.FromJson(OceanEngineJson.GetValue(obj, "action_config"));
        model.AutoExtendTargets = OceanEngineJson.GetString(obj, "auto_extend_targets", "");
        return model;
    }
}

