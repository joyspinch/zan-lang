    public JsonValue? RawJson;
    // 兴趣类目词
    public List<long> InterestCategories;
    // 兴趣关键词
    public List<long> InterestWords;

    public static LocalPushOcProjectGetResponseDataAudienceInterestConfig? FromJson(JsonValue? obj) {
        if (obj != null && obj.IsString()) {
            try { obj = JsonValue.Parse(obj.AsString("")); } catch (Exception e) { }
        }
        if (obj == null || !obj.IsObject()) { return null; }
        LocalPushOcProjectGetResponseDataAudienceInterestConfig model = new LocalPushOcProjectGetResponseDataAudienceInterestConfig();
        model.RawJson = obj;
        model.InterestCategories = OceanEngineJson.GetLongList(obj, "interest_categories");
        model.InterestWords = OceanEngineJson.GetLongList(obj, "interest_words");
        return model;
    }
}

