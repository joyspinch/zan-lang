// 获取Access Token (/open_api/oauth2/access_token/, doc=1696710505596940)
public class LocalPushOauth2AccessTokenRequest {
    private OceanEngineTypedRequest req;

    public LocalPushOauth2AccessTokenRequest() {
        this.req = new OceanEngineTypedRequest();
    }

    // 开发者应用ID 可在开发者后台-应用管理处查看
    public LocalPushOauth2AccessTokenRequest AppId(long appId) {
        this.req.BodyLong("app_id", appId);
        return this;
    }

    // 开发者应用的私钥Secret 应用管理页面选择应用编辑即可进入查看到应用详情信息 注意： 填入secret与app_id需对应，否则将会报错
    public LocalPushOauth2AccessTokenRequest Secret(string secret) {
        this.req.BodyString("secret", secret);
        return this;
    }

    // 授权码，在授权完成后回调时会提供该授权码， 授权介绍可参考：【 应用如何申请账户授权 】 注意： 10分钟有效期，且只能使用一次
    public LocalPushOauth2AccessTokenRequest AuthCode(string authCode) {
        this.req.BodyString("auth_code", authCode);
        return this;
    }

    public LocalPushOauth2AccessTokenRequest SetField(string key, JsonValue? val) {
        this.req.BodyValue(key, val);
        return this;
    }

    public JsonValue BodyObject() {
        return this.req.BodyObject();
    }
}

