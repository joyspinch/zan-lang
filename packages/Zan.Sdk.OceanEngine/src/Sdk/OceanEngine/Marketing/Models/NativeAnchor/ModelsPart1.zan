    // 锚点头部图片list，推荐尺寸为2：1的横图
    public List<MarketingNativeAnchorDetailResponseDataListItemNetServiceAnchorHeadImageListItem> HeadImageList;
    // APP标签列表，每个标签长度：1～4；标签个数：1～3
    public List<string> AppTags;
    // 引导文案，长度：1～15
    public string GuideText;
    // APP图片比例， 100 ：尺寸为2：1的横图 200 ：尺寸为3：5的竖图
    public long AnchorImageMode;
    // APP图片，图片个数 3～8
    public List<MarketingNativeAnchorDetailResponseDataListItemNetServiceAnchorAppImagesItem> AppImages;
    // APP详情，1～100
    public string AppDescription;
    // 投放内容，网服锚点必填，允许值： GENERAL ：常规应用下载 （默认值） 如选择“跳转微信”投放内容，则直接传入对应的跳转场景枚举： 跳转场景=添加微...
    public string NetServiceType;
    // 微信小程序ID，锚点类型为网服且net_service_type为 MICRO_APP 必填
    public long InstanceId;
    // 微信小程序/快应用路径参数，如有跳转指定页面，需填写
    public string PathParam;
    // 应用icon图，网服锚点类型且net_service_type为 MICRO_APP 必填 比例为1：1，大小不超过1M，图片个数为1
    public List<MarketingNativeAnchorDetailResponseDataListItemNetServiceAnchorIconImagesItem> IconImages;
    // 快应用ID，网服锚点类型且net_service_type为 QUICK_APP 必填
    public long QuickAppId;
    // 小说章节，非必填，填写小说章节预览，字数1~9999
    public string NovelChapter;
    // net_service_type为 WECHAT_PACKAGE 时，该参数代表微信号码包ID net_service_type为 WECOM_PACKA...
    public long WechatPackageId;
    // 微信跳转链接
    public string WechatExternalUrl;

