    // 素材的文件名，可自定义素材名，不传择默认取文件名，最长255个字符 同一素材已上传，重新上传不会修改文件名称
    public MarketingToolsEbpVideoUploadRequest FileName(string fileName) {
        this.req.FormField("file_name", fileName);
        return this;
    }

    // 视频url地址 仅支持开发者购置连山云素材服务上传生成的tos链接上传，不支持其他三方链接地址
    public MarketingToolsEbpVideoUploadRequest VideoUrl(string videoUrl) {
        this.req.FormField("video_url", videoUrl);
        return this;
    }

    // 视频素材是否为AIGC生成
    public MarketingToolsEbpVideoUploadRequest IsAigc(bool isAigc) {
        this.req.FormBool("is_aigc", isAigc);
        return this;
    }

    // 系统标签 可选值: GAME_NON_STANDARD 游戏非标素材 IAA_ONLY 仅投 IAA
    public MarketingToolsEbpVideoUploadRequest SystemTagNames(JsonValue? systemTagNames) {
        this.req.FormJson("system_tag_names", systemTagNames);
        return this;
    }

    // 自定义标签
    public MarketingToolsEbpVideoUploadRequest CustomTagNames(JsonValue? customTagNames) {
        this.req.FormJson("custom_tag_names", customTagNames);
        return this;
    }

    public MarketingToolsEbpVideoUploadRequest SetField(string key, string val) {
        this.req.FormField(key, val);
        return this;
    }

    public OceanEngineMultipart BuildMultipart() {
        return this.req.BuildMultipart();
    }
}

