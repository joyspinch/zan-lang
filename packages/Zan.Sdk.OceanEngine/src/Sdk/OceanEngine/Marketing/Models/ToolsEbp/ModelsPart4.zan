// 当前最新审核通过版本应用详情
public class MarketingToolsEbpAppDetailResponseDataCurrentVersion {
    public JsonValue? RawJson;
    // app 名称
    public string AppName;
    // 版本信息，示例： 9.87.00.00
    public string VersionName;
    // 版本编号，示例： 9870000
    public string VersionCode;
    // 审核拒绝原因
    public string AuditMessage;
    // 画风分类 应用-游戏类目下该参数必填 填写题材标签的末级分类ID category_id，分类及ID详见 【应用管理标签及类目】
    public string ArtStyle;
    // 网络环境 应用-游戏类目下该参数必填,最多支持传入3个 填写网络环境的末级分类ID category_id，分类及ID详见 【应用管理标签及类目】
    public List<string> NetworkEnvironment;
    // 特色标签 应用-游戏类目下该参数必填,最多支持传入3个 填写网络环境的末级分类ID category_id，分类及ID详见 【应用管理标签及类目】
    public List<string> FeatureTags;
    // 盒子内游戏名称, 自定义填写,仅题材标签=游戏盒子时需填写
    public string GameBoxName;
    // IP类型，枚举值： 文学类IP LITERARY 影视类IP FILM 动漫类IP ANIMATION 文化艺术类IP ARTISTIC 其他 OTHER...
    public List<string> GameIpType;
    // 细分IP，自定义填写，举例：如三国、西游等
    public string GameIpTag;
    // 代言人名字，自定义填写
    public string Spokesperson;
    // 变现模式，枚举值 IAA 营销 IAAP 混合 IAP 付费
    public string RevenueModel;
    // 是否包含网赚内容
    public bool HasOnlineEarning;
    // 最低付费档位区间（元），枚举值： SIX_TEN 6~10 TEN_TWENTY 10~20 TWENTY_FIFTY 20~50 ZERO_FIVE 0~5
    public string MinPaymentTierRange;
    // 中间付费档位区间（元），枚举值： ABOVE_500 500以上 BELOW_100 100以下 FROM_100_TO_500 100~500
    public string MidPaymentTierRange;
    // 最高付费档位区间（元），枚举值： ABOVE_1000 1000以上 BELOW_500 500以下 FROM_500_TO_1000 500-1000
    public string MaxPaymentTierRange;
    // 最高充值档位（元），枚举值： ABOVE_200 200以上 FROM_100_TO_200 100-200 FROM_FIFTY_TO_HUNDRED ...
    public string MaxRechargeTier;
    // 最低充值档位（元），枚举值： FROM_100_TO_200 100-200 FROM_FIFTY_TO_HUNDRED 50-100 FROM_ONE_...
    public string MinRechargeTier;
