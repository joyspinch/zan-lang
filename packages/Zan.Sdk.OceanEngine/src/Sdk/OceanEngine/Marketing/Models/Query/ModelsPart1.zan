// json返回值
public class MarketingQueryProjectResponseData {
    public JsonValue? RawJson;
    // 项目列表
    public List<MarketingQueryProjectResponseDataProjectInfoListItem> ProjectInfoList;
    // 总量
    public long Total;
    // 页码游标值
    public long Cursor;

    public static MarketingQueryProjectResponseData? FromJson(JsonValue? obj) {
        if (obj != null && obj.IsString()) {
            try { obj = JsonValue.Parse(obj.AsString("")); } catch (Exception e) { }
        }
        if (obj == null || !obj.IsObject()) { return null; }
        MarketingQueryProjectResponseData model = new MarketingQueryProjectResponseData();
        model.RawJson = obj;
        model.ProjectInfoList = new List<MarketingQueryProjectResponseDataProjectInfoListItem>();
        JsonValue? arrProjectInfoList = OceanEngineJson.GetValue(obj, "project_info_list");
        if (arrProjectInfoList != null && arrProjectInfoList.IsArray()) {
            for (int i = 0; i < arrProjectInfoList.Count(); i = i + 1) {
                MarketingQueryProjectResponseDataProjectInfoListItem? item = MarketingQueryProjectResponseDataProjectInfoListItem.FromJson(arrProjectInfoList.At(i));
                if (item != null) { model.ProjectInfoList.Add((MarketingQueryProjectResponseDataProjectInfoListItem)item); }
            }
        }
        model.Total = OceanEngineJson.GetLong(obj, "total", 0L);
        model.Cursor = OceanEngineJson.GetLong(obj, "cursor", 0L);
        return model;
    }
}

