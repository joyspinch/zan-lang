// 直播间数据
public class MarketingReportLiveRoomAnalysisGetResponseDataListItem {
    public JsonValue? RawJson;
    // 主播头像URL
    public string AnchorAvatar;
    // 主播ID
    public long AnchorId;
    // 主播昵称
    public string AnchorNick;
    // 直播间截图URL
    public string RoomCover;
    // 直播开始时间，格式为%Y-%m-%d %H:%M:%S
    public string RoomCreateTime;
    // 直播结束时间，格式为%Y-%m-%d %H:%M:%S
    public string RoomFinishTime;
    // 直播间ID
    public long RoomId;
    // 直播间二维码URL，仅直播状态为开播中的直播间包含该字段
    public string RoomQrcode;
    // 直播间状态，枚举值： END 关播 LIVING 开播 PAUSE 暂停 PREPARING 准备
    public string RoomStatus;
    // 直播间标题
    public string RoomTitle;
    // 指标字段
    public MarketingReportLiveRoomAnalysisGetResponseDataListItemFields? Fields;

    public static MarketingReportLiveRoomAnalysisGetResponseDataListItem? FromJson(JsonValue? obj) {
        if (obj != null && obj.IsString()) {
            try { obj = JsonValue.Parse(obj.AsString("")); } catch (Exception e) { }
        }
        if (obj == null || !obj.IsObject()) { return null; }
        MarketingReportLiveRoomAnalysisGetResponseDataListItem model = new MarketingReportLiveRoomAnalysisGetResponseDataListItem();
        model.RawJson = obj;
        model.AnchorAvatar = OceanEngineJson.GetString(obj, "anchor_avatar", "");
        model.AnchorId = OceanEngineJson.GetLong(obj, "anchor_id", 0L);
        model.AnchorNick = OceanEngineJson.GetString(obj, "anchor_nick", "");
        model.RoomCover = OceanEngineJson.GetString(obj, "room_cover", "");
        model.RoomCreateTime = OceanEngineJson.GetString(obj, "room_create_time", "");
        model.RoomFinishTime = OceanEngineJson.GetString(obj, "room_finish_time", "");
        model.RoomId = OceanEngineJson.GetLong(obj, "room_id", 0L);
        model.RoomQrcode = OceanEngineJson.GetString(obj, "room_qrcode", "");
        model.RoomStatus = OceanEngineJson.GetString(obj, "room_status", "");
        model.RoomTitle = OceanEngineJson.GetString(obj, "room_title", "");
        model.Fields = MarketingReportLiveRoomAnalysisGetResponseDataListItemFields.FromJson(OceanEngineJson.GetValue(obj, "fields"));
        return model;
    }
