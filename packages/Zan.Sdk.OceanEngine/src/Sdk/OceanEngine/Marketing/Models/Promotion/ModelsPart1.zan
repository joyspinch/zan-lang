// 更新失败的营销列表
public class MarketingPromotionBidUpdateResponseDataErrorsItem {
    public JsonValue? RawJson;
    // 营销ID
    public long PromotionId;
    // 错误信息
    public string ErrorMessage;

    public static MarketingPromotionBidUpdateResponseDataErrorsItem? FromJson(JsonValue? obj) {
        if (obj != null && obj.IsString()) {
            try { obj = JsonValue.Parse(obj.AsString("")); } catch (Exception e) { }
        }
        if (obj == null || !obj.IsObject()) { return null; }
        MarketingPromotionBidUpdateResponseDataErrorsItem model = new MarketingPromotionBidUpdateResponseDataErrorsItem();
        model.RawJson = obj;
        model.PromotionId = OceanEngineJson.GetLong(obj, "promotion_id", 0L);
        model.ErrorMessage = OceanEngineJson.GetString(obj, "error_message", "");
        return model;
    }
}

// json返回值
public class MarketingPromotionBidUpdateResponseData {
    public JsonValue? RawJson;
    // 更新成功的营销ID集合
    public List<long> PromotionIds;
    // 更新失败的营销列表
    public List<MarketingPromotionBidUpdateResponseDataErrorsItem> Errors;

    public static MarketingPromotionBidUpdateResponseData? FromJson(JsonValue? obj) {
        if (obj != null && obj.IsString()) {
            try { obj = JsonValue.Parse(obj.AsString("")); } catch (Exception e) { }
        }
        if (obj == null || !obj.IsObject()) { return null; }
        MarketingPromotionBidUpdateResponseData model = new MarketingPromotionBidUpdateResponseData();
        model.RawJson = obj;
        model.PromotionIds = OceanEngineJson.GetLongList(obj, "promotion_ids");
        model.Errors = new List<MarketingPromotionBidUpdateResponseDataErrorsItem>();
        JsonValue? arrErrors = OceanEngineJson.GetValue(obj, "errors");
        if (arrErrors != null && arrErrors.IsArray()) {
            for (int i = 0; i < arrErrors.Count(); i = i + 1) {
                MarketingPromotionBidUpdateResponseDataErrorsItem? item = MarketingPromotionBidUpdateResponseDataErrorsItem.FromJson(arrErrors.At(i));
                if (item != null) { model.Errors.Add((MarketingPromotionBidUpdateResponseDataErrorsItem)item); }
            }
        }
        return model;
    }
}

