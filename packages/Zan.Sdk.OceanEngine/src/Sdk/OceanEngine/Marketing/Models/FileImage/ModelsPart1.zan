        this.req.FormField("filename", filename);
        return this;
    }

    // 图片素材是否为AIGC生成
    public MarketingFileImageAdRequest IsAigc(bool isAigc) {
        this.req.FormBool("is_aigc", isAigc);
        return this;
    }

