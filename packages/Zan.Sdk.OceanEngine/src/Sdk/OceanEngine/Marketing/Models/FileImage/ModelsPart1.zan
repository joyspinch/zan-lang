        this.req = new OceanEngineTypedRequest();
    }

    // 广告主ID
    public MarketingFileImageAdRequest AdvertiserId(long advertiserId) {
        this.req.FormLong("advertiser_id", advertiserId);
        return this;
    }

    // 图片上传方式 默认值：UPLOAD_BY_FILE 允许值：UPLOAD_BY_FILE、UPLOAD_BY_URL 可选值: UPLOAD_BY_FIL...
    public MarketingFileImageAdRequest UploadType(string uploadType) {
        this.req.FormField("upload_type", uploadType);
        return this;
    }

