    public MarketingFileImageAdRequest ImageFile(string fileName, string mediaType, byte[] bytes) {
        this.req.FormFile("image_file", fileName, mediaType, bytes, "image_signature");
        return this;
    }

    // 图片url地址，如http://xxx.xxx upload_type为UPLOAD_BY_URL必填
    public MarketingFileImageAdRequest ImageUrl(string imageUrl) {
        this.req.FormField("image_url", imageUrl);
        return this;
    }

    // 素材的文件名，可自定义素材名，不传则默认取文件名，最长255个字符 注：若同一素材已进行上传，重新上传不会改名
