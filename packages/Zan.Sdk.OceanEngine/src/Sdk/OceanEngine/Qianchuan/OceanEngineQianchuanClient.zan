using System;
using System.Json;
using System.Net.External;
using System.Net.Tls;
using Sdk.OceanEngine;

namespace Sdk.OceanEngine.Qianchuan;

// 巨量千川开放平台客户端。
public class OceanEngineQianchuanClient {
    private OceanEngineTransport transport;

    public OceanEngineQianchuanClient() {
        this.transport = new OceanEngineTransport();
    }

    private OceanEngineQianchuanClient(OceanEngineTransport transport) {
        this.transport = transport;
    }

    public string AccessToken { get { return this.transport.AccessToken; } }
    public string AppAccessToken { get { return this.transport.AppAccessToken; } }

    public OceanEngineQianchuanClient SetAccessToken(string token) {
        this.transport.SetAccessToken(token);
        return this;
    }

    public OceanEngineQianchuanClient SetAppAccessToken(string token) {
        this.transport.SetAppAccessToken(token);
        return this;
    }

    public OceanEngineQianchuanClient WithAccessToken(string token) {
        return new OceanEngineQianchuanClient(this.transport.CloneWithTokens(token, this.transport.AppAccessToken));
    }

    public OceanEngineQianchuanClient WithAppAccessToken(string token) {
        return new OceanEngineQianchuanClient(this.transport.CloneWithTokens(this.transport.AccessToken, token));
    }

    public OceanEngineQianchuanClient Server(string host, int port, bool useTls = true) {
        this.transport.Server(host, port, useTls);
        return this;
    }

    public OceanEngineQianchuanClient Timeout(int ms) {
        this.transport.Timeout(ms);
        return this;
    }

    public OceanEngineQianchuanClient MaxRetries(int n) {
        this.transport.MaxRetries(n);
        return this;
    }

    public OceanEngineQianchuanClient WithCallPolicy(ExternalCallPolicy policy) {
        this.transport.WithCallPolicy(policy);
        return this;
    }

    public OceanEngineQianchuanClient PinPublicKey(string spkiSha256Base64) {
        this.transport.PinPublicKey(spkiSha256Base64);
        return this;
    }

    public OceanEngineQianchuanClient SetCertPolicy(CertPolicyFn fn) {
        this.transport.SetCertPolicy(fn);
        return this;
    }

    public OceanEngineQianchuanClient SetClientCertificate(string certFile, string keyFile) {
        this.transport.SetClientCertificate(certFile, keyFile);
        return this;
    }

    public async OceanEngineResponse ExchangeTokenAsync(long appId, string secret, string authCode) {
        JsonValue body = JsonValue.NewObject();
        body.PutInt("app_id", appId);
        body.Set("secret", JsonValue.NewStr(secret));
        body.Set("grant_type", JsonValue.NewStr("auth_code"));
        body.Set("auth_code", JsonValue.NewStr(authCode));
        return await this.transport.PostJsonAsync(OceanEngineGateway.Ad, "/open_api/oauth2/access_token/",
            body, OceanEngineCredential.None);
    }

    public async OceanEngineResponse RefreshTokenAsync(long appId, string secret, string refreshToken) {
        JsonValue body = JsonValue.NewObject();
        body.PutInt("app_id", appId);
        body.Set("secret", JsonValue.NewStr(secret));
        body.Set("grant_type", JsonValue.NewStr("refresh_token"));
        body.Set("refresh_token", JsonValue.NewStr(refreshToken));
        return await this.transport.PostJsonAsync(OceanEngineGateway.Ad, "/open_api/oauth2/refresh_token/",
            body, OceanEngineCredential.None);
    }

    public async OceanEngineResponse GetAuthorizedAccountsAsync(string accessToken) {
        JsonValue query = JsonValue.NewObject();
        query.Set("access_token", JsonValue.NewStr(accessToken));
        return await this.transport.GetAsync(OceanEngineGateway.Api, "/open_api/oauth2/advertiser/get/",
            query, OceanEngineCredential.None);
    }

    public async OceanEngineResponse GetAsync(OceanEngineGateway gateway, string path, JsonValue? query,
        OceanEngineCredential credential, string tokenOverride = "", string directArray = "") {
        return await this.transport.GetAsync(gateway, path, query, credential, tokenOverride, directArray);
    }

    public async OceanEngineResponse PostJsonAsync(OceanEngineGateway gateway, string path, JsonValue? body,
        OceanEngineCredential credential, string tokenOverride = "", string directArray = "") {
        return await this.transport.PostJsonAsync(gateway, path, body, credential, tokenOverride, directArray);
    }

    public async OceanEngineResponse PostMultipartAsync(OceanEngineGateway gateway, string path,
        OceanEngineMultipart form, OceanEngineCredential credential, string tokenOverride = "",
        string directArray = "") {
        return await this.transport.PostMultipartAsync(gateway, path, form, credential, tokenOverride, directArray);
    }

    public async OceanEngineResponse CallAsync(OceanEngineGateway gateway, string method, string path,
        JsonValue? queryOrBody = null, OceanEngineCredential credential = OceanEngineCredential.AccessToken) {
        if (method == "GET") {
            return await this.transport.GetAsync(gateway, path, queryOrBody, credential);
        }
        if (method == "POST") {
            return await this.transport.PostJsonAsync(gateway, path, queryOrBody, credential);
        }
        throw new ArgumentException("仅支持 GET 或 POST");
    }
}
