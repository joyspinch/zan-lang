using System;
using System.Json;
using System.Net.External;
using System.Net.Tls;
using Sdk.OceanEngine;

namespace Sdk.OceanEngine.ServeMarket;

// 群峰服务市场开放平台客户端。
public class OceanEngineServeMarketClient {
    private OceanEngineTransport transport;

    public OceanEngineServeMarketClient() {
        this.transport = new OceanEngineTransport();
    }

    private OceanEngineServeMarketClient(OceanEngineTransport transport) {
        this.transport = transport;
    }

    public string AccessToken { get { return this.transport.AccessToken; } }
    public string AppAccessToken { get { return this.transport.AppAccessToken; } }

    public OceanEngineServeMarketClient SetAccessToken(string token) {
        this.transport.SetAccessToken(token);
        return this;
    }

    public OceanEngineServeMarketClient SetAppAccessToken(string token) {
        this.transport.SetAppAccessToken(token);
        return this;
    }

    public OceanEngineServeMarketClient WithAccessToken(string token) {
        return new OceanEngineServeMarketClient(this.transport.CloneWithTokens(token, this.transport.AppAccessToken));
    }

    public OceanEngineServeMarketClient WithAppAccessToken(string token) {
        return new OceanEngineServeMarketClient(this.transport.CloneWithTokens(this.transport.AccessToken, token));
    }

    public OceanEngineServeMarketClient Server(string host, int port, bool useTls = true) {
        this.transport.Server(host, port, useTls);
        return this;
    }

    public OceanEngineServeMarketClient Timeout(int ms) {
        this.transport.Timeout(ms);
        return this;
    }

    public OceanEngineServeMarketClient MaxRetries(int n) {
        this.transport.MaxRetries(n);
        return this;
    }

    public OceanEngineServeMarketClient WithCallPolicy(ExternalCallPolicy policy) {
        this.transport.WithCallPolicy(policy);
        return this;
    }

    public OceanEngineServeMarketClient PinPublicKey(string spkiSha256Base64) {
        this.transport.PinPublicKey(spkiSha256Base64);
        return this;
    }

    public OceanEngineServeMarketClient SetCertPolicy(CertPolicyFn fn) {
        this.transport.SetCertPolicy(fn);
        return this;
    }

    public OceanEngineServeMarketClient SetClientCertificate(string certFile, string keyFile) {
        this.transport.SetClientCertificate(certFile, keyFile);
        return this;
    }

    public async OceanEngineResponse GetAppAccessTokenAsync(long appId, string secret) {
        JsonValue body = JsonValue.NewObject();
        body.PutInt("app_id", appId);
        body.Set("secret", JsonValue.NewStr(secret));
        return await this.transport.PostJsonAsync(OceanEngineGateway.Open, "/open_api/oauth2/app_access_token/",
            body, OceanEngineCredential.None);
    }

    public async OceanEngineResponse GetAsync(OceanEngineGateway gateway, string path, JsonValue? query,
        OceanEngineCredential credential, string tokenOverride = "", string directArray = "") {
        return await this.transport.GetAsync(gateway, path, query, credential, tokenOverride, directArray);
    }

    public async OceanEngineResponse PostJsonAsync(OceanEngineGateway gateway, string path, JsonValue? body,
        OceanEngineCredential credential, string tokenOverride = "", string directArray = "") {
        return await this.transport.PostJsonAsync(gateway, path, body, credential, tokenOverride, directArray);
    }

    public async OceanEngineResponse PostMultipartAsync(OceanEngineGateway gateway, string path,
        OceanEngineMultipart form, OceanEngineCredential credential, string tokenOverride = "",
        string directArray = "") {
        return await this.transport.PostMultipartAsync(gateway, path, form, credential, tokenOverride, directArray);
    }

    public async OceanEngineResponse CallAsync(OceanEngineGateway gateway, string method, string path,
        JsonValue? queryOrBody = null, OceanEngineCredential credential = OceanEngineCredential.AppAccessToken) {
        if (method == "GET") {
            return await this.transport.GetAsync(gateway, path, queryOrBody, credential);
        }
        if (method == "POST") {
            return await this.transport.PostJsonAsync(gateway, path, queryOrBody, credential);
        }
        throw new ArgumentException("仅支持 GET 或 POST");
    }
}
