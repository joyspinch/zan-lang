using System;
using System.Json;

namespace Sdk.OceanEngine;

// 生成的强类型请求内部累加器（支持 Query/Body JSON、int64 与 multipart 表单）。
public class OceanEngineTypedRequest {
    private JsonValue? query;
    private JsonValue? body;
    private List<string> formKeys;
    private List<string> formValues;
    private string fileField;
    private string fileName;
    private string fileMediaType;
    private byte[]? fileBytes;
    private string signatureField;

    public OceanEngineTypedRequest() {
        this.query = null;
        this.body = null;
        this.formKeys = null;
        this.formValues = null;
        this.fileField = "";
        this.fileName = "";
        this.fileMediaType = "";
        this.fileBytes = null;
        this.signatureField = "";
    }

    private JsonValue EnsureQuery() {
        if (this.query == null) { this.query = JsonValue.NewObject(); }
        return (JsonValue)this.query;
    }

    private JsonValue EnsureBody() {
        if (this.body == null) { this.body = JsonValue.NewObject(); }
        return (JsonValue)this.body;
    }

    private void EnsureForm() {
        if (this.formKeys == null) {
            this.formKeys = new List<string>();
            this.formValues = new List<string>();
        }
    }

    public static JsonValue StringsArray(List<string> items) {
        JsonValue arr = JsonValue.NewArray();
        if (items != null) {
            for (int i = 0; i < items.Count; i = i + 1) { arr.Append(JsonValue.NewStr(items[i])); }
        }
        return arr;
    }

    public static JsonValue IntsArray(List<int> items) {
        JsonValue arr = JsonValue.NewArray();
        if (items != null) {
            for (int i = 0; i < items.Count; i = i + 1) { arr.AppendInt((long)items[i]); }
        }
        return arr;
    }

    public static JsonValue LongsArray(List<long> items) {
        JsonValue arr = JsonValue.NewArray();
        if (items != null) {
            for (int i = 0; i < items.Count; i = i + 1) { arr.AppendInt(items[i]); }
        }
        return arr;
    }

    public static JsonValue DoublesArray(List<double> items) {
        JsonValue arr = JsonValue.NewArray();
        if (items != null) {
            for (int i = 0; i < items.Count; i = i + 1) { arr.Append(JsonValue.NewDouble(items[i])); }
        }
        return arr;
    }

    public static JsonValue BoolsArray(List<bool> items) {
        JsonValue arr = JsonValue.NewArray();
        if (items != null) {
            for (int i = 0; i < items.Count; i = i + 1) { arr.Append(JsonValue.NewBool(items[i])); }
        }
        return arr;
    }

    public OceanEngineTypedRequest QueryString(string key, string val) {
        this.EnsureQuery().Set(key, JsonValue.NewStr(val)); return this;
    }
    public OceanEngineTypedRequest QueryInt(string key, int val) {
        this.EnsureQuery().PutInt(key, (long)val); return this;
    }
    public OceanEngineTypedRequest QueryLong(string key, long val) {
        this.EnsureQuery().PutInt(key, val); return this;
    }
    public OceanEngineTypedRequest QueryDouble(string key, double val) {
        this.EnsureQuery().Set(key, JsonValue.NewDouble(val)); return this;
    }
    public OceanEngineTypedRequest QueryBool(string key, bool val) {
        this.EnsureQuery().Set(key, JsonValue.NewBool(val)); return this;
    }
    public OceanEngineTypedRequest QueryStrings(string key, List<string> items) {
        this.EnsureQuery().Set(key, OceanEngineTypedRequest.StringsArray(items)); return this;
    }
    public OceanEngineTypedRequest QueryInts(string key, List<int> items) {
        this.EnsureQuery().Set(key, OceanEngineTypedRequest.IntsArray(items)); return this;
    }
    public OceanEngineTypedRequest QueryLongs(string key, List<long> items) {
        this.EnsureQuery().Set(key, OceanEngineTypedRequest.LongsArray(items)); return this;
    }
    public OceanEngineTypedRequest QueryValue(string key, JsonValue? val) {
        if (val != null) { this.EnsureQuery().Set(key, (JsonValue)val); }
        return this;
    }

    public OceanEngineTypedRequest BodyString(string key, string val) {
        this.EnsureBody().Set(key, JsonValue.NewStr(val)); return this;
    }
    public OceanEngineTypedRequest BodyInt(string key, int val) {
        this.EnsureBody().PutInt(key, (long)val); return this;
    }
    public OceanEngineTypedRequest BodyLong(string key, long val) {
        this.EnsureBody().PutInt(key, val); return this;
    }
    public OceanEngineTypedRequest BodyDouble(string key, double val) {
        this.EnsureBody().Set(key, JsonValue.NewDouble(val)); return this;
    }
    public OceanEngineTypedRequest BodyBool(string key, bool val) {
        this.EnsureBody().Set(key, JsonValue.NewBool(val)); return this;
    }
    public OceanEngineTypedRequest BodyStrings(string key, List<string> items) {
        this.EnsureBody().Set(key, OceanEngineTypedRequest.StringsArray(items)); return this;
    }
    public OceanEngineTypedRequest BodyInts(string key, List<int> items) {
        this.EnsureBody().Set(key, OceanEngineTypedRequest.IntsArray(items)); return this;
    }
    public OceanEngineTypedRequest BodyLongs(string key, List<long> items) {
        this.EnsureBody().Set(key, OceanEngineTypedRequest.LongsArray(items)); return this;
    }
    public OceanEngineTypedRequest BodyDoubles(string key, List<double> items) {
        this.EnsureBody().Set(key, OceanEngineTypedRequest.DoublesArray(items)); return this;
    }
    public OceanEngineTypedRequest BodyBools(string key, List<bool> items) {
        this.EnsureBody().Set(key, OceanEngineTypedRequest.BoolsArray(items)); return this;
    }
    public OceanEngineTypedRequest BodyValue(string key, JsonValue? val) {
        if (val != null) { this.EnsureBody().Set(key, (JsonValue)val); }
        return this;
    }

    public OceanEngineTypedRequest FormField(string key, string val) {
        this.EnsureForm();
        for (int i = 0; i < this.formKeys.Count; i = i + 1) {
            if (this.formKeys[i] == key) {
                this.formValues[i] = val;
                return this;
            }
        }
        this.formKeys.Add(key);
        this.formValues.Add(val);
        return this;
    }

    public OceanEngineTypedRequest FormLong(string key, long val) {
        return this.FormField(key, Convert.ToString(val));
    }

    public OceanEngineTypedRequest FormInt(string key, int val) {
        return this.FormField(key, Convert.ToString(val));
    }

    public OceanEngineTypedRequest FormBool(string key, bool val) {
        return this.FormField(key, val ? "true" : "false");
    }

    public OceanEngineTypedRequest FormJson(string key, JsonValue? val) {
        if (val != null) { return this.FormField(key, val.ToJson()); }
        return this;
    }

    public OceanEngineTypedRequest FormFile(string fieldName, string fileName, string mediaType,
        byte[] bytes, string signatureField = "") {
        if (bytes == null) { throw new ArgumentException("上传文件字节不能为空"); }
        this.fileField = fieldName;
        this.fileName = fileName;
        this.fileMediaType = mediaType;
        this.fileBytes = bytes;
        this.signatureField = signatureField == null ? "" : signatureField;
        return this;
    }

    public JsonValue? QueryObject() { return this.query; }

    public JsonValue BodyObject() {
        if (this.body == null) { return JsonValue.NewObject(); }
        return (JsonValue)this.body;
    }

    public OceanEngineMultipart BuildMultipart() {
        OceanEngineMultipart form = new OceanEngineMultipart();
        bool hasSig = false;
        if (this.formKeys != null) {
            for (int i = 0; i < this.formKeys.Count; i = i + 1) {
                string k = this.formKeys[i];
                if (this.signatureField.Length > 0 && k == this.signatureField) { hasSig = true; }
                form.AddField(k, this.formValues[i]);
            }
        }
        if (this.fileBytes != null) {
            byte[] raw = (byte[])this.fileBytes;
            if (this.signatureField.Length > 0 && !hasSig) {
                form.AddField(this.signatureField, OceanEngineMultipart.ComputeMd5Hex(raw));
            }
            form.AddFile(this.fileField, this.fileName, this.fileMediaType, raw);
        }
        return form;
    }
}
