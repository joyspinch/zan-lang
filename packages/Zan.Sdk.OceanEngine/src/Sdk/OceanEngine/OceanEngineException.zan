using System;

namespace Sdk.OceanEngine;

// 巨量引擎开放平台 SDK 统一异常（含 HTTP 状态码、平台业务 code 与 request_id）。
public class OceanEngineException : Exception {
    private string code;
    public string Code { get { return this.code; } }
    private int statusCode;
    public int StatusCode { get { return this.statusCode; } }
    private string requestId;
    public string RequestId { get { return this.requestId; } }

    public OceanEngineException(string code, string message, int statusCode, string requestId) {
        this.code = code;
        this.statusCode = statusCode;
        this.requestId = requestId;
        this.Message = code + ": " + message;
    }
}
