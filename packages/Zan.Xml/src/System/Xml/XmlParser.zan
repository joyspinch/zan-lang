using System;
using System.Text;

namespace System.Xml;

// 递归下降 XML 解析器（XmlDocument.Parse 实现）：按字节游标逐字节判别（保留 UTF-8 多字节名），
// 支持元素/属性、文本、5 种命名实体及 &#DDD;/&#xHH;、CDATA、注释、PI、XML 声明与 DOCTYPE（不解析命名空间）；非法格式抛带行列号的 XmlException。
public class XmlParser {
    // 输入文本、原始字节指针与游标（s 持有所有权，basePtr 供零 ARC 热扫描）。
    public string s;
    public nint basePtr;
    public int pos;
    public int len;
    StringBuilder scratch;
    string[] nameCache;
    // 读写对称的嵌套深度上限，防止无界递归耗尽调用栈。
    public static int MaxDepth = 512;

    // 解析入口（自动剥除前导 UTF-8 BOM）。
    public static XmlDocument Parse(string src) {
        if (src.Length >= 3 && (src[0] & 255) == 239 && (src[1] & 255) == 187
        && (src[2] & 255) == 191) {
            src = src.Substring(3);
        }
        XmlParser p = new XmlParser();
        p.s = src;
        p.basePtr = (nint)src;
        p.pos = 0;
        p.len = src.Length;
        return p.ReadDocument();
    }

    // 文档层：空白/声明/注释/PI/DOCTYPE 间恰一个根元素。
    public XmlDocument ReadDocument() {
        XmlDocument doc = new XmlDocument();
        bool sawRoot = false;
        while (pos < len) {
            SkipWs();
            if (pos >= len) { break; }
            int c = CurB();
            if (c != 60) {  // '<'
                Err("unexpected text outside the root element");
            }
            if (Has("<!--")) {
                doc.children.Add(ReadComment());
            } else if (Has("<?")) {
                doc.children.Add(ReadPiOrDecl());
            } else if (Has("<!DOCTYPE") || Has("<!doctype")) {
                doc.children.Add(ReadDoctype());
            } else if (Has("<!")) {
                Err("unexpected <! construct at document level");
            } else {
                if (sawRoot) { Err("multiple root elements"); }
                doc.children.Add(ReadElement(1));
                sawRoot = true;
            }
        }
        if (!sawRoot) { Err("no root element"); }
        return doc;
    }

    // 读取开始标签、属性及子内容（自闭合则跳过内容）。
    private XmlNode ReadElement(int depth) {
        if (depth > XmlParser.MaxDepth) { Err("XML nesting too deep"); }
        pos = pos + 1;  // 消费 '<'
        string name = ReadName();
        XmlNode elem = XmlNode.NewElement(name);
        if (!ReadAttrs(elem, false)) {
            ReadChildren(elem, depth);
        }
        return elem;
    }

    // 读取属性列表直到 '>'、'/>' 或（isDecl=true 时的）'?>'；返回是否自闭合。
    private bool ReadAttrs(XmlNode elem, bool isDecl) {
        while (pos < len) {
            SkipWs();
            int c = CurB();
            if (isDecl) {
                if (c == 63) {  // '?'
                    if (pos + 1 < len && (s[pos + 1] & 255) == 62) {
                        pos = pos + 2;
                        return true;
                    }
                    Err("bad character after '?' in xml declaration");
                }
            } else {
                if (c == 62) { pos = pos + 1; return false; }  // '>'
                if (c == 47) {  // '/'
                    if (pos + 1 < len && (s[pos + 1] & 255) == 62) {
                        pos = pos + 2;
                        return true;
                    }
                    Err("expected '>' after '/'");
                }
            }
            string aname = ReadName();
            SkipWs();
            if (CurB() != 61) { Err("expected '=' after attribute name"); }
            pos = pos + 1;  // 消费 '='
            SkipWs();
            int q = CurB();
            if (q != 34 && q != 39) { Err("attribute value must be quoted"); }
            pos = pos + 1;  // 消费引号
            int n = this.len;
            int start = this.pos;
            int hit = NativeMemory.Find(this.basePtr, start, q, n - start);
            if (hit < 0) {
                this.pos = n;
                Err("unterminated attribute value");
            }
            this.pos = hit + 1;  // 消费闭引号
            // XML WFC: Unique Att Spec — 重复属性名立即报错。
            if (elem.attrs != null) {
                for (int ai = 0; ai < elem.attrs.Count; ai = ai + 1) {
                    if (elem.attrs[ai].name == aname) {
                        Err("duplicate attribute '" + aname + "' on <" + (elem.name == null ? "" : elem.name) + ">");
                    }
                }
            }
            XmlAttribute a = new XmlAttribute();
            a.name = aname;
            a.value = DecodeSlice(start, hit - start);
            if (elem.attrs == null) { elem.attrs = new List<XmlAttribute>(); }
            elem.attrs.Add(a);
        }
        Err("unterminated tag <" + (elem.name == null ? "" : elem.name) + ">");
        return false;
    }

    // 读取元素子节点与文本直到匹配的结束标签。
    private void ReadChildren(XmlNode elem, int depth) {
        nint bp = this.basePtr;
        int n = this.len;
        Span<byte> buf = new Span<byte>(bp, n);
        while (pos < n) {
            int c = buf[pos] & 255;
            if (c != 60) {  // '<'
                int start = this.pos;
                int hit = NativeMemory.Find(bp, start, 60, n - start);
                int end = hit < 0 ? n : hit;
                this.pos = end;
                elem.MergeText(DecodeSlice(start, end - start));
                continue;
            }
            int next = (pos + 1 < n) ? (buf[pos + 1] & 255) : -1;
            if (next == 47) {  // '</'
                pos = pos + 2;
                // 快路径：直接按字节匹配 elem.name，零结束标签名字符串分配。
                string expect = elem.name;
                int elen = expect.Length;
                if (pos + elen < n) {
                    Span<byte> eb = new Span<byte>((nint)expect, elen);
                    bool ok = true;
                    for (int k = 0; k < elen; k = k + 1) {
                        if (buf[pos + k] != eb[k]) { ok = false; break; }
                    }
                    if (ok) {
                        int after = buf[pos + elen] & 255;
                        if (after == 62) {
                            pos = pos + elen + 1;
                            return;
                        }
                        if (after == 32 || after == 9 || after == 10 || after == 13) {
                            pos = pos + elen;
                            SkipWs();
                            if (CurB() != 62) { Err("expected '>' after closing tag name"); }
                            pos = pos + 1;
                            return;
                        }
                    }
                }
                string closeName = ReadName();
                SkipWs();
                if (CurB() != 62) { Err("expected '>' after closing tag name"); }
                pos = pos + 1;  // 消费 '>'
                if (closeName != elem.name) {
                    Err("mismatched closing tag </" + closeName
                        + "> for <" + elem.name + ">");
                }
                return;
            }
            if (next == 33) {  // '<!'
                if (Has("<!--")) {
                    elem.AddChild(ReadComment());
                    continue;
                }
                if (Has("<![CDATA[")) {
                    elem.AddChild(ReadCdata());
                    continue;
                }
                Err("unexpected <! construct in element content");
            }
            if (next == 63) {  // '<?'
                elem.AddChild(ReadPiOrDecl());
                continue;
            }
            XmlNode child = ReadElement(depth + 1);
            elem.AddChild(child);
        }
        Err("unclosed element <" + elem.name + ">");
    }

    private string ReadUntil(int skipPrefix, string closeDelim, string unterminatedMsg) {
        pos = pos + skipPrefix;
        int start = pos;
        int hit = s.IndexOf(closeDelim, start);
        if (hit < 0) {
            pos = len;
            Err(unterminatedMsg);
            return "";
        }
        pos = hit + closeDelim.Length;
        return NativeMemory.GetString(this.basePtr, start, hit - start);
    }

    // 读取 '<!--...-->' 注释（正文原样保留）。
    private XmlNode ReadComment() {
        return XmlNode.NewComment(ReadUntil(4, "-->", "unterminated comment"));
    }

    // 读取 '<![CDATA[...]]>' 段（在首个 ']]>' 截断）。
    XmlNode ReadCdata() {
        return XmlNode.NewCdata(ReadUntil(9, "]]>", "unterminated CDATA section"));
    }

    // 读取 '<?...'：目标为 'xml' 走声明，其余为 PI。
    XmlNode ReadPiOrDecl() {
        pos = pos + 2;  // 消费 '<?'
        string target = ReadName();
        if (target == "xml") {
            XmlNode decl = XmlNode.NewDecl();
            ReadAttrs(decl, true);
            return decl;
        }
        SkipWs();
        int start = pos;
        int hit = s.IndexOf("?>", start);
        if (hit < 0) {
            pos = len;
            Err("unterminated processing instruction");
        }
        XmlNode pi = XmlNode.NewPi(target, NativeMemory.GetString(this.basePtr, start, hit - start));
        pos = hit + 2;  // 消费 '?>'
        return pi;
    }

    // 读取 '<!DOCTYPE...>' 原文（跳过引号内与内部子集 [...] 嵌套内的 '>'，不做 DTD 校验）。
    XmlNode ReadDoctype() {
        int start = pos;
        pos = pos + 2;  // 消费 '<!'
        int bracketDepth = 0;
        int quote = 0;
        while (pos < len) {
            int c = s[pos] & 255;
            if (quote != 0) {
                if (c == quote) { quote = 0; }
            } else if (c == 34 || c == 39) {  // '"' or '\''
                quote = c;
            } else if (c == 91) {  // '['
                bracketDepth = bracketDepth + 1;
            } else if (c == 93) {  // ']'
                if (bracketDepth > 0) { bracketDepth = bracketDepth - 1; }
            } else if (c == 62 && bracketDepth == 0) {  // '>'
                pos = pos + 1;
                return XmlNode.NewDoctype(s.Substring(start, pos - start));
            }
            pos = pos + 1;
        }
        Err("unterminated DOCTYPE declaration");
        return null;
    }

    // 读取 XML 名字（ASCII 字母/数字/_ - . : 及 UTF-8 多字节；Span+128 位掩码零 ARC 判定）。
    string ReadName() {
        int n = this.len;
        int p = this.pos;
        int start = p;
        Span<byte> buf = new Span<byte>(this.basePtr, n);
        while (p < n) {
            int c = buf[p] & 255;
            if (c < 64) {
                if ((0x07FF600000000000L & (1L << c)) == 0L) { break; }
            } else if (c < 128) {
                if ((0x07FFFFFE87FFFFFEL & (1L << (c - 64))) == 0L) { break; }
            }
            p = p + 1;
        }
        this.pos = p;
        int nlen = p - start;
        if (nlen == 0) { Err("expected a name"); }
        // 短标签/属性名直映缓存（64 槽，FNV-1a 32 + 逐字节验证），高频重复标签名零堆分配。
        if (nlen <= 32) {
            if (this.nameCache == null) { this.nameCache = new string[64]; }
            uint h = 2166136261U;
            for (int i = 0; i < nlen; i = i + 1) {
                h = (h ^ (uint)(buf[start + i] & 255)) * 16777619U;
            }
            int slot = (int)(h & 63U);
            string cached = this.nameCache[slot];
            if (cached != null && cached.Length == nlen) {
                Span<byte> cb = new Span<byte>((nint)cached, nlen);
                bool eq = true;
                for (int i = 0; i < nlen; i = i + 1) {
                    if (buf[start + i] != cb[i]) { eq = false; break; }
                }
                if (eq) { return cached; }
            }
            string fresh = NativeMemory.GetString(this.basePtr, start, nlen);
            this.nameCache[slot] = fresh;
            return fresh;
        }
        return NativeMemory.GetString(this.basePtr, start, nlen);
    }

    // 预缓存常见纯空白缩进文本（"\n" + 0..16 空格），美化 XML 解析零堆分配。
    private static string[] IndentTextCache = new string[] {
        "\n",
        "\n ",
        "\n  ",
        "\n   ",
        "\n    ",
        "\n     ",
        "\n      ",
        "\n       ",
        "\n        ",
        "\n         ",
        "\n          ",
        "\n           ",
        "\n            ",
        "\n             ",
        "\n              ",
        "\n               ",
        "\n                "
    };

    // 直接对源切片 [start, start+slen) 做零中间串实体解码与 CR 归一，复用 scratch StringBuilder。
    string DecodeSlice(int start, int slen) {
        if (slen <= 0) { return ""; }
        nint rp = this.basePtr + (nint)start;
        // 快路径：常见标签间 "\n   " 缩进空白直接返回只读缓存串，零堆分配。
        if (slen <= 17) {
            Span<byte> wbuf = new Span<byte>(rp, slen);
            if ((wbuf[0] & 255) == 10) {
                bool allSp = true;
                for (int k = 1; k < slen; k = k + 1) {
                    if ((wbuf[k] & 255) != 32) { allSp = false; break; }
                }
                if (allSp) { return XmlParser.IndentTextCache[slen - 1]; }
            }
        }
        int scan = NativeMemory.IndexOfAny(rp, slen, (byte)38, (byte)13);
        if (scan < 0) { return NativeMemory.GetString(this.basePtr, start, slen); }
        Span<byte> rbuf = new Span<byte>(rp, slen);
        StringBuilder sb = this.scratch;
        if (sb == null) {
            sb = new StringBuilder(slen < 64 ? 64 : slen);
            this.scratch = sb;
        } else {
            sb.Clear();
        }
        if (scan > 0) { sb.Append(new StringView(rp, scan)); }
        int i = scan;
        while (i < slen) {
            int c = rbuf[i] & 255;
            if (c == 38) {  // '&'
                i = ReadEntityPtr(rp, rbuf, slen, i, sb);
            } else if (c == 13) {  // '\r'
                if (i + 1 < slen && (rbuf[i + 1] & 255) == 10) { i = i + 1; }
                sb.Append("\n");
                i = i + 1;
            } else {
                int rel = NativeMemory.IndexOfAny(rp + (nint)i, slen - i, (byte)38, (byte)13);
                int j = rel < 0 ? slen : (i + rel);
                sb.Append(new StringView(rp + (nint)i, j - i));
                i = j;
            }
        }
        return sb.ToString();
    }

    // 指针版实体解码：零临时 raw 字符串构造。
    int ReadEntityPtr(nint rp, Span<byte> rbuf, int rlen, int i, StringBuilder sb) {
        int rem = rlen - (i + 1);
        if (rem > 12) { rem = 12; }
        int semi = rem > 0 ? NativeMemory.Find(rp, i + 1, 59, rem) : -1;
        if (semi < 0 || semi - i > 12) {
            Err("malformed entity reference");
        }
        int entStart = i + 1;
        int entLen = semi - entStart;
        if (entLen == 2) {
            int c0 = rbuf[entStart] & 255;
            int c1 = rbuf[entStart + 1] & 255;
            if (c0 == 108 && c1 == 116) { sb.Append("<"); return semi + 1; }  // lt
            if (c0 == 103 && c1 == 116) { sb.Append(">"); return semi + 1; }  // gt
        } else if (entLen == 3) {
            if ((rbuf[entStart] & 255) == 97 && (rbuf[entStart + 1] & 255) == 109
                && (rbuf[entStart + 2] & 255) == 112) {
                sb.Append("&"); return semi + 1;  // amp
            }
        } else if (entLen == 4) {
            int c0 = rbuf[entStart] & 255;
            int c1 = rbuf[entStart + 1] & 255;
            int c2 = rbuf[entStart + 2] & 255;
            int c3 = rbuf[entStart + 3] & 255;
            if (c0 == 113 && c1 == 117 && c2 == 111 && c3 == 116) { sb.Append("\""); return semi + 1; }  // quot
            if (c0 == 97 && c1 == 112 && c2 == 111 && c3 == 115) { sb.Append("'"); return semi + 1; }    // apos
        }
        if (entLen > 0 && (rbuf[entStart] & 255) == 35) {  // '#'
            int cp = 0;
            int k = 1;
            bool hex = false;
            if (entLen > 1) {
                int h = rbuf[entStart + 1] & 255;
                if (h == 120 || h == 88) {  // 'x' 'X'
                    hex = true;
                    k = 2;
                }
            }
            if (k >= entLen) { Err("empty character reference"); }
            while (k < entLen) {
                int d = XmlParser.DigitVal(rbuf[entStart + k] & 255, hex);
                if (d < 0) { Err("invalid character reference &" + NativeMemory.GetString(rp, entStart, entLen) + ";"); }
                cp = cp * (hex ? 16 : 10) + d;
                if (cp > 1114111) { Err("character reference out of range"); }
                k = k + 1;
            }
            if (cp == 0 || (cp >= 55296 && cp <= 57343)) {
                Err("character reference cannot be represented");
            }
            sb.Append(Encoding.Utf8FromCodePoint(cp));
            return semi + 1;
        }
        Err("unknown entity &" + NativeMemory.GetString(rp, entStart, entLen) + ";");
        return semi + 1;
    }

    // 实体解码与 CR 归一（\r\n / \r → \n）；SIMD 双字节扫描 + StringView 零临时字符串冲刷。
    string DecodeText(string raw) {
        int n = raw.Length;
        if (n == 0) { return raw; }
        nint rp = (nint)raw;
        int scan = NativeMemory.IndexOfAny(rp, n, (byte)38, (byte)13);
        if (scan < 0) { return raw; }
        Span<byte> rbuf = new Span<byte>(rp, n);
        StringBuilder sb = new StringBuilder(n);
        if (scan > 0) { sb.Append(new StringView(rp, scan)); }
        int i = scan;
        while (i < n) {
            int c = rbuf[i] & 255;
            if (c == 38) {  // '&'
                i = ReadEntity(raw, rp, n, i, sb);
            } else if (c == 13) {  // '\r'
                if (i + 1 < n && (rbuf[i + 1] & 255) == 10) { i = i + 1; }
                sb.Append("\n");
                i = i + 1;
            } else {
                int rel = NativeMemory.IndexOfAny(rp + (nint)i, n - i, (byte)38, (byte)13);
                int j = rel < 0 ? n : (i + rel);
                sb.Append(new StringView(rp + (nint)i, j - i));
                i = j;
            }
        }
        return sb.ToString();
    }

    // 解码 raw 中自 i 起（raw[i] == '&'）的一个实体，把结果追加进
    // sb，返回 ';' 之后的新游标。5 种命名实体与数字字符引用零 Substring 直判。
    int ReadEntity(string raw, nint rp, int rlen, int i, StringBuilder sb) {
        int rem = rlen - (i + 1);
        if (rem > 12) { rem = 12; }
        int semi = rem > 0 ? NativeMemory.Find(rp, i + 1, 59, rem) : -1;
        if (semi < 0 || semi - i > 12) {
            Err("malformed entity reference");
        }
        int entStart = i + 1;
        int entLen = semi - entStart;
        if (entLen == 2) {
            int c0 = raw[entStart] & 255;
            int c1 = raw[entStart + 1] & 255;
            if (c0 == 108 && c1 == 116) { sb.Append("<"); return semi + 1; }  // lt
            if (c0 == 103 && c1 == 116) { sb.Append(">"); return semi + 1; }  // gt
        } else if (entLen == 3) {
            if ((raw[entStart] & 255) == 97 && (raw[entStart + 1] & 255) == 109
                && (raw[entStart + 2] & 255) == 112) {
                sb.Append("&"); return semi + 1;  // amp
            }
        } else if (entLen == 4) {
            int c0 = raw[entStart] & 255;
            int c1 = raw[entStart + 1] & 255;
            int c2 = raw[entStart + 2] & 255;
            int c3 = raw[entStart + 3] & 255;
            if (c0 == 113 && c1 == 117 && c2 == 111 && c3 == 116) { sb.Append("\""); return semi + 1; }  // quot
            if (c0 == 97 && c1 == 112 && c2 == 111 && c3 == 115) { sb.Append("'"); return semi + 1; }    // apos
        }
        if (entLen > 0 && (raw[entStart] & 255) == 35) {  // '#'
            int cp = 0;
            int k = 1;
            bool hex = false;
            if (entLen > 1) {
                int h = raw[entStart + 1] & 255;
                if (h == 120 || h == 88) {  // 'x' 'X'
                    hex = true;
                    k = 2;
                }
            }
            if (k >= entLen) { Err("empty character reference"); }
            while (k < entLen) {
                int d = XmlParser.DigitVal(raw[entStart + k] & 255, hex);
                if (d < 0) { Err("invalid character reference &" + raw.Substring(entStart, entLen) + ";"); }
                cp = cp * (hex ? 16 : 10) + d;
                if (cp > 1114111) { Err("character reference out of range"); }
                k = k + 1;
            }
            // U+0000 装不进以 NUL 结尾的 Zan 字符串；代理区不成码点。
            if (cp == 0 || (cp >= 55296 && cp <= 57343)) {
                Err("character reference cannot be represented");
            }
            sb.Append(Encoding.Utf8FromCodePoint(cp));
            return semi + 1;
        }
        Err("unknown entity &" + raw.Substring(entStart, entLen) + ";");
        return semi + 1;
    }

    // 一个数字字符的值；非法返回 -1。hex 关掉时只收十进制。
    private static int DigitVal(int c, bool hex) {
        if (c >= 48 && c <= 57) { return c - 48; }
        if (hex && c >= 97 && c <= 102) { return c - 87; }
        if (hex && c >= 65 && c <= 70) { return c - 55; }
        return -1;
    }

    void SkipWs() {
        int n = this.len;
        int p = this.pos;
        Span<byte> buf = new Span<byte>(this.basePtr, n);
        while (p < n) {
            int c = buf[p] & 255;
            if (c == 32 || c == 9 || c == 10 || c == 13) {
                p = p + 1;
            } else {
                break;
            }
        }
        this.pos = p;
    }

    int CurB() {
        if (pos >= len) { return -1; }
        return new Span<byte>(this.basePtr, this.len)[pos] & 255;
    }

    // 游标处是否恰为 lit。
    bool Has(string lit) {
        int n = lit.Length;
        if (pos + n > len) { return false; }
        Span<byte> buf = new Span<byte>(this.basePtr, this.len);
        Span<byte> lbuf = new Span<byte>((nint)lit, n);
        int p = pos;
        for (int i = 0; i < n; i = i + 1) {
            if ((buf[p + i] & 255) != (lbuf[i] & 255)) { return false; }
        }
        return true;
    }

    // 抛带行列号的 XmlException。行列号现算：只走错误路径，
    // O(n) 一次可接受。
    void Err(string msg) {
        int line = 1;
        int col = 1;
        int stop = pos < len ? pos : len;
        for (int i = 0; i < stop; i = i + 1) {
            if ((s[i] & 255) == 10) {
                line = line + 1;
                col = 1;
            } else {
                col = col + 1;
            }
        }
        throw new XmlException(msg + " at line "
            + Convert.ToString(line) + ", column " + Convert.ToString(col));
    }
}
