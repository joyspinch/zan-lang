using System;
using System.Text;

namespace System.Xml;

// 递归下降 XML 解析器（XmlDocument.Parse 实现）：按字节游标逐字节判别（保留 UTF-8 多字节名），
// 支持元素/属性、文本、5 种命名实体及 &#DDD;/&#xHH;、CDATA、注释、PI、XML 声明与 DOCTYPE（不解析命名空间）；非法格式抛带行列号的 XmlException。
public class XmlParser {
    // 输入文本与游标。
    public string s;
    public int pos;
    public int len;
    // 读写对称的嵌套深度上限，防止无界递归耗尽调用栈。
    public static int MaxDepth = 512;

    // 解析入口（自动剥除前导 UTF-8 BOM）。
    public static XmlDocument Parse(string src) {
        if (src.Length >= 3 && (src[0] & 255) == 239 && (src[1] & 255) == 187
        && (src[2] & 255) == 191) {
            src = src.Substring(3);
        }
        XmlParser p = new XmlParser();
        p.s = src;
        p.pos = 0;
        p.len = src.Length;
        return p.ReadDocument();
    }

    // 文档层：空白/声明/注释/PI/DOCTYPE 间恰一个根元素。
    public XmlDocument ReadDocument() {
        XmlDocument doc = new XmlDocument();
        bool sawRoot = false;
        while (pos < len) {
            SkipWs();
            if (pos >= len) { break; }
            int c = CurB();
            if (c != 60) {  // '<'
                Err("unexpected text outside the root element");
            }
            if (Has("<!--")) {
                doc.children.Add(ReadComment());
            } else if (Has("<?")) {
                doc.children.Add(ReadPiOrDecl());
            } else if (Has("<!DOCTYPE") || Has("<!doctype")) {
                doc.children.Add(ReadDoctype());
            } else if (Has("<!")) {
                Err("unexpected <! construct at document level");
            } else {
                if (sawRoot) { Err("multiple root elements"); }
                doc.children.Add(ReadElement(1));
                sawRoot = true;
            }
        }
        if (!sawRoot) { Err("no root element"); }
        return doc;
    }

    // 读取开始标签、属性及子内容（自闭合则跳过内容）。
    private XmlNode ReadElement(int depth) {
        if (depth > XmlParser.MaxDepth) { Err("XML nesting too deep"); }
        pos = pos + 1;  // 消费 '<'
        string name = ReadName();
        XmlNode elem = XmlNode.NewElement(name);
        if (!ReadAttrs(elem, false)) {
            ReadChildren(elem, depth);
        }
        return elem;
    }

    // 读取属性列表直到 '>'、'/>' 或（isDecl=true 时的）'?>'；返回是否自闭合。
    private bool ReadAttrs(XmlNode elem, bool isDecl) {
        while (pos < len) {
            SkipWs();
            int c = CurB();
            if (isDecl) {
                if (c == 63) {  // '?'
                    if (pos + 1 < len && (s[pos + 1] & 255) == 62) {
                        pos = pos + 2;
                        return true;
                    }
                    Err("bad character after '?' in xml declaration");
                }
            } else {
                if (c == 62) { pos = pos + 1; return false; }  // '>'
                if (c == 47) {  // '/'
                    if (pos + 1 < len && (s[pos + 1] & 255) == 62) {
                        pos = pos + 2;
                        return true;
                    }
                    Err("expected '>' after '/'");
                }
            }
            string aname = ReadName();
            SkipWs();
            if (CurB() != 61) { Err("expected '=' after attribute name"); }
            pos = pos + 1;  // 消费 '='
            SkipWs();
            int q = CurB();
            if (q != 34 && q != 39) { Err("attribute value must be quoted"); }
            pos = pos + 1;  // 消费引号
            int start = pos;
            while (pos < len && (s[pos] & 255) != q) { pos = pos + 1; }
            if (pos >= len) { Err("unterminated attribute value"); }
            string raw = s.Substring(start, pos - start);
            pos = pos + 1;  // 消费闭引号
            // XML WFC: Unique Att Spec — 重复属性名立即报错。
            if (elem.attrs != null) {
                for (int ai = 0; ai < elem.attrs.Count; ai = ai + 1) {
                    if (elem.attrs[ai].name == aname) {
                        Err("duplicate attribute '" + aname + "' on <" + (elem.name == null ? "" : elem.name) + ">");
                    }
                }
            }
            XmlAttribute a = new XmlAttribute();
            a.name = aname;
            a.value = DecodeText(raw);
            elem.AddAttr(a);
        }
        Err("unterminated tag <" + (elem.name == null ? "" : elem.name) + ">");
        return false;
    }

    // 读取元素子节点与文本直到匹配的结束标签。
    private void ReadChildren(XmlNode elem, int depth) {
        while (pos < len) {
            int c = CurB();
            if (c != 60) {  // '<'
                int start = pos;
                while (pos < len && (s[pos] & 255) != 60) { pos = pos + 1; }
                elem.MergeText(DecodeText(s.Substring(start, pos - start)));
                continue;
            }
            if (Has("</")) {
                pos = pos + 2;
                string closeName = ReadName();
                SkipWs();
                if (CurB() != 62) { Err("expected '>' after closing tag name"); }
                pos = pos + 1;  // 消费 '>'
                if (closeName != elem.name) {
                    Err("mismatched closing tag </" + closeName
                        + "> for <" + elem.name + ">");
                }
                return;
            }
            if (Has("<!--")) {
                elem.AddChild(ReadComment());
                continue;
            }
            if (Has("<![CDATA[")) {
                elem.AddChild(ReadCdata());
                continue;
            }
            if (Has("<?")) {
                elem.AddChild(ReadPiOrDecl());
                continue;
            }
            if (Has("<!")) { Err("unexpected <! construct in element content"); }
            XmlNode child = ReadElement(depth + 1);
            elem.AddChild(child);
        }
        Err("unclosed element <" + elem.name + ">");
    }

    private string ReadUntil(int skipPrefix, string closeDelim, string unterminatedMsg) {
        pos = pos + skipPrefix;
        int start = pos;
        int dlen = closeDelim.Length;
        while (pos < len) {
            if (Has(closeDelim)) {
                string text = s.Substring(start, pos - start);
                pos = pos + dlen;
                return text;
            }
            pos = pos + 1;
        }
        Err(unterminatedMsg);
        return "";
    }

    // 读取 '<!--...-->' 注释（正文原样保留）。
    private XmlNode ReadComment() {
        return XmlNode.NewComment(ReadUntil(4, "-->", "unterminated comment"));
    }

    // 读取 '<![CDATA[...]]>' 段（在首个 ']]>' 截断）。
    XmlNode ReadCdata() {
        return XmlNode.NewCdata(ReadUntil(9, "]]>", "unterminated CDATA section"));
    }

    // 读取 '<?...'：目标为 'xml' 走声明，其余为 PI。
    XmlNode ReadPiOrDecl() {
        pos = pos + 2;  // 消费 '<?'
        string target = ReadName();
        if (target == "xml") {
            XmlNode decl = XmlNode.NewDecl();
            ReadAttrs(decl, true);
            return decl;
        }
        SkipWs();
        int start = pos;
        while (pos < len) {
            if (Has("?>")) { break; }
            pos = pos + 1;
        }
        if (pos >= len) { Err("unterminated processing instruction"); }
        XmlNode pi = XmlNode.NewPi(target, s.Substring(start, pos - start));
        pos = pos + 2;  // 消费 '?>'
        return pi;
    }

    // 读取 '<!DOCTYPE...>' 原文（跳过内部子集 [...] 内的 '>'，不做 DTD 校验）。
    XmlNode ReadDoctype() {
        int start = pos;
        pos = pos + 2;  // 消费 '<!'
        bool bracket = false;
        while (pos < len) {
            int c = s[pos] & 255;
            if (c == 91) { bracket = true; }  // '['
            else if (c == 93) { bracket = false; }  // ']'
            else if (c == 62 && !bracket) {  // '>'
                pos = pos + 1;
                return XmlNode.NewDoctype(s.Substring(start, pos - start));
            }
            pos = pos + 1;
        }
        Err("unterminated DOCTYPE declaration");
        return null;
    }

    // 读取 XML 名字（ASCII 字母/数字/_ - . : 及 UTF-8 多字节）。
    string ReadName() {
        int start = pos;
        while (pos < len) {
            int c = s[pos] & 255;
            bool ok = (c >= 97 && c <= 122) || (c >= 65 && c <= 90)
                || (c >= 48 && c <= 57) || c == 95 || c == 45
                || c == 46 || c == 58 || c >= 128;
            if (!ok) { break; }
            pos = pos + 1;
        }
        if (pos == start) { Err("expected a name"); }
        return s.Substring(start, pos - start);
    }

    // 实体解码与 CR 归一（\r\n / \r → \n）；无 '&' / '\r' 时零分配原串返回。
    string DecodeText(string raw) {
        int n = raw.Length;
        int scan = 0;
        while (scan < n) {
            int c = raw[scan] & 255;
            if (c == 38 || c == 13) { break; }  // '&' '\r'
            scan = scan + 1;
        }
        if (scan >= n) { return raw; }
        StringBuilder sb = new StringBuilder();
        if (scan > 0) { sb.Append(raw.Substring(0, scan)); }
        int i = scan;
        while (i < n) {
            int c = raw[i] & 255;
            if (c == 38) {  // '&'
                i = ReadEntity(raw, i, sb);
            } else if (c == 13) {  // '\r'
                if (i + 1 < n && (raw[i + 1] & 255) == 10) { i = i + 1; }
                sb.Append("\n");
                i = i + 1;
            } else {
                int j = i;
                while (j < n) {
                    int d = raw[j] & 255;
                    if (d == 38 || d == 13) { break; }
                    j = j + 1;
                }
                sb.Append(raw.Substring(i, j - i));
                i = j;
            }
        }
        return sb.ToString();
    }

    // 解码 raw 中自 i 起（raw[i] == '&'）的一个实体，把结果追加进
    // sb，返回 ';' 之后的新游标。未知实体与非法数字引用报错。
    int ReadEntity(string raw, int i, StringBuilder sb) {
        int semi = XmlNode.IndexOf(raw, ";", i + 1);
        if (semi < 0 || semi - i > 12) {
            Err("malformed entity reference");
        }
        string ent = raw.Substring(i + 1, semi - i - 1);
        if (ent == "lt") { sb.Append("<"); }
        else if (ent == "gt") { sb.Append(">"); }
        else if (ent == "amp") { sb.Append("&"); }
        else if (ent == "quot") { sb.Append("\""); }
        else if (ent == "apos") { sb.Append("'"); }
        else if (ent.Length > 0 && (ent[0] & 255) == 35) {  // '#'
            int cp = 0;
            int k = 1;
            bool hex = false;
            if (ent.Length > 1) {
                int h = ent[1] & 255;
                if (h == 120 || h == 88) {  // 'x' 'X'
                    hex = true;
                    k = 2;
                }
            }
            if (k >= ent.Length) { Err("empty character reference"); }
            while (k < ent.Length) {
                int d = XmlParser.DigitVal(ent[k] & 255, hex);
                if (d < 0) { Err("invalid character reference &" + ent + ";"); }
                cp = cp * (hex ? 16 : 10) + d;
                if (cp > 1114111) { Err("character reference out of range"); }
                k = k + 1;
            }
            // U+0000 装不进以 NUL 结尾的 Zan 字符串；代理区不成码点。
            if (cp == 0 || (cp >= 55296 && cp <= 57343)) {
                Err("character reference cannot be represented");
            }
            sb.Append(Encoding.Utf8FromCodePoint(cp));
        } else {
            Err("unknown entity &" + ent + ";");
        }
        return semi + 1;
    }

    // 一个数字字符的值；非法返回 -1。hex 关掉时只收十进制。
    private static int DigitVal(int c, bool hex) {
        if (c >= 48 && c <= 57) { return c - 48; }
        if (hex && c >= 97 && c <= 102) { return c - 87; }
        if (hex && c >= 65 && c <= 70) { return c - 55; }
        return -1;
    }

    void SkipWs() {
        while (pos < len) {
            int c = s[pos] & 255;
            if (c == 32 || c == 9 || c == 10 || c == 13) {
                pos = pos + 1;
            } else {
                return;
            }
        }
    }

    int CurB() {
        if (pos >= len) { return -1; }
        return s[pos] & 255;
    }

    // 游标处是否恰为 lit。
    bool Has(string lit) {
        int n = lit.Length;
        if (pos + n > len) { return false; }
        for (int i = 0; i < n; i = i + 1) {
            if ((s[pos + i] & 255) != (lit[i] & 255)) { return false; }
        }
        return true;
    }

    // 抛带行列号的 XmlException。行列号现算：只走错误路径，
    // O(n) 一次可接受。
    void Err(string msg) {
        int line = 1;
        int col = 1;
        int stop = pos < len ? pos : len;
        for (int i = 0; i < stop; i = i + 1) {
            if ((s[i] & 255) == 10) {
                line = line + 1;
                col = 1;
            } else {
                col = col + 1;
            }
        }
        throw new XmlException(msg + " at line "
            + Convert.ToString(line) + ", column " + Convert.ToString(col));
    }
}
