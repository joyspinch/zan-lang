using System;
using System.Text;
namespace System.Xml;

// XML 树节点：以 kind 区分元素(0)/文本(1)/CDATA(2)/注释(3)/PI(4)/声明(5)/DOCTYPE(6)。
// 无 prefix 查询在精确匹配未命中时回退至本地名匹配（适配带变化前缀的报文）。
public class XmlNode {
    // 节点类别：0 元素，1 文本，2 CDATA，3 注释，4 PI，5 声明，6 DOCTYPE。
    public int kind;
    // 元素名 / PI 与声明的目标名；DOCTYPE 时不用（原文存 text）。
    public string name;
    // 文本与 CDATA 的内容；注释与 PI 的正文；DOCTYPE 的原文。
    public string text;
    // 元素属性（其余类别为 null）。
    public List<XmlAttribute> attrs;
    // 子节点（仅元素有）。
    public List<XmlNode> children;

    // 构造元素节点。
    public static XmlNode NewElement(string name) {
        XmlNode n = new XmlNode();
        n.kind = 0;
        n.name = name;
        return n;
    }

    // 构造文本节点。
    public static XmlNode NewText(string text) {
        XmlNode n = new XmlNode();
        n.kind = 1;
        n.text = text;
        return n;
    }

    // 构造 CDATA 节点（内容原样保存，不参与实体解码）。
    public static XmlNode NewCdata(string text) {
        XmlNode n = new XmlNode();
        n.kind = 2;
        n.text = text;
        return n;
    }

    // 构造注释节点。
    public static XmlNode NewComment(string text) {
        XmlNode n = new XmlNode();
        n.kind = 3;
        n.text = text;
        return n;
    }

    // 构造处理指令节点（<?target body?>）。
    public static XmlNode NewPi(string target, string body) {
        XmlNode n = new XmlNode();
        n.kind = 4;
        n.name = target;
        n.text = body;
        return n;
    }

    // 构造 XML 声明节点；版本/编码/standalone 走属性表。
    public static XmlNode NewDecl() {
        XmlNode n = new XmlNode();
        n.kind = 5;
        n.name = "xml";
        return n;
    }

    // 构造 DOCTYPE 节点（text 存 <!DOCTYPE ...> 原文）。
    public static XmlNode NewDoctype(string raw) {
        XmlNode n = new XmlNode();
        n.kind = 6;
        n.text = raw;
        return n;
    }

    // 是否元素节点。
    public bool IsElement() {
        return kind == 0;
    }

    // 追加子节点（懒建 children 列表）。
    public void AddChild(XmlNode child) {
        if (children == null) { children = new List<XmlNode>(); }
        children.Add(child);
    }

    // 追加文本：上一子节点已是文本就并入，避免实体解码把一段
    // 文本切成多个碎片节点。
    public void MergeText(string piece) {
        if (piece.Length == 0) { return; }
        if (children != null && children.Count > 0) {
            XmlNode last = children[children.Count - 1];
            if (last.kind == 1) {
                last.text = last.text + piece;
                return;
            }
        }
        AddChild(XmlNode.NewText(piece));
    }

    // 追加文本（语义同 MergeText）。
    public void AddText(string text) {
        MergeText(text);
    }

    private int IndexOfAttr(string attrName) {
        if (attrs == null) { return -1; }
        for (int i = 0; i < attrs.Count; i = i + 1) {
            if (attrs[i].name == attrName) { return i; }
        }
        return -1;
    }

    // 追加或覆盖同名属性。
    public void AddAttr(XmlAttribute a) {
        if (attrs == null) { attrs = new List<XmlAttribute>(); }
        int idx = IndexOfAttr(a.name);
        if (idx >= 0) {
            attrs[idx].value = a.value;
            return;
        }
        attrs.Add(a);
    }

    // 设置属性：已有同名则改值，否则追加。
    public void SetAttr(string attrName, string value) {
        int idx = IndexOfAttr(attrName);
        if (idx >= 0) {
            attrs[idx].value = value;
            return;
        }
        XmlAttribute a = new XmlAttribute();
        a.name = attrName;
        a.value = value;
        if (attrs == null) { attrs = new List<XmlAttribute>(); }
        attrs.Add(a);
    }

    // 取属性值；不存在返回 null。无前缀的名字回退本地名匹配。
    public string Attr(string attrName) {
        int idx = IndexOfAttr(attrName);
        if (idx >= 0) { return attrs[idx].value; }
        if (attrs != null && XmlNode.IndexOf(attrName, ":", 0) < 0) {
            for (int i = 0; i < attrs.Count; i = i + 1) {
                if (XmlNode.LocalNameOf(attrs[i].name) == attrName) {
                    return attrs[i].value;
                }
            }
        }
        return null;
    }

    // 取属性值；不存在返回 fallback。
    public string AttrOr(string attrName, string fallback) {
        string v = Attr(attrName);
        if (v == null) { return fallback; }
        return v;
    }

    // 本地名：原样名字里最后一个 ':' 之后的部分；无前缀时原样返回。
    public string LocalName() {
        return XmlNode.LocalNameOf(name);
    }

    // 限定名的本地名部分（最后一个 ':' 之后）；无 ':' 原样返回。
    public static string LocalNameOf(string qname) {
        if (qname == null) { return ""; }
        int colon = -1;
        for (int i = qname.Length - 1; i >= 0; i = i - 1) {
            if ((qname[i] & 255) == 58) {
                colon = i;
                break;
            }
        }
        if (colon < 0) { return qname; }
        return qname.Substring(colon + 1, qname.Length - colon - 1);
    }

    // 子节点按名匹配规则：先精确匹配原样名字；查询名不带 ':'
    // 时再回退本地名匹配。带前缀的查询只做精确匹配。
    public bool MatchesName(string want) {
        if (name == want) { return true; }
        if (XmlNode.IndexOf(want, ":", 0) >= 0) { return false; }
        return XmlNode.LocalNameOf(name) == want;
    }

    // 第一个按 MatchesName 命中的子元素；没有返回 null。
    public XmlNode Element(string name) {
        if (children == null) { return null; }
        for (int i = 0; i < children.Count; i = i + 1) {
            XmlNode c = children[i];
            if (c.kind == 0 && c.MatchesName(name)) { return c; }
        }
        return null;
    }

    // 全部按 MatchesName 命中的子元素（按文档顺序）。
    public List<XmlNode> Elements(string name) {
        List<XmlNode> outList = new List<XmlNode>();
        if (children == null) { return outList; }
        for (int i = 0; i < children.Count; i = i + 1) {
            XmlNode c = children[i];
            if (c.kind == 0 && c.MatchesName(name)) { outList.Add(c); }
        }
        return outList;
    }

    // 子元素列表（跳过文本/注释等，按文档顺序；不含孙辈）。
    public List<XmlNode> ElementChildren() {
        List<XmlNode> outList = new List<XmlNode>();
        if (children == null) { return outList; }
        for (int i = 0; i < children.Count; i = i + 1) {
            if (children[i].kind == 0) { outList.Add(children[i]); }
        }
        return outList;
    }

    // 递归拼接自身与全部后代的文本/CDATA 内容（同 .NET InnerText）。
    public string InnerText() {
        if (kind == 1 || kind == 2) {
            return text;
        }
        if (children == null || children.Count == 0) {
            return "";
        }
        if (children.Count == 1) {
            XmlNode c0 = children[0];
            if (c0.kind == 1 || c0.kind == 2) {
                return c0.text;
            }
        }
        StringBuilder sb = new StringBuilder();
        AppendTextInto(sb);
        return sb.ToString();
    }

    public void AppendTextInto(StringBuilder sb) {
        if (kind == 1 || kind == 2) {
            sb.Append(text);
            return;
        }
        if (children == null) { return; }
        for (int i = 0; i < children.Count; i = i + 1) {
            children[i].AppendTextInto(sb);
        }
    }

    // 按 UTF-8 字节在 s 中自 from 起查找子串，未命中返回 -1（直通编译器 SIMD IndexOf）。
    public static int IndexOf(string s, string needle, int from) {
        if (from < 0) { from = 0; }
        return s.IndexOf(needle, from);
    }
}
