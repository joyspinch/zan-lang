using System;
using System.Text;
namespace System.Xml;

// XML 属性。名字原样保留（可带命名空间前缀，如 <c>D:href</c>）；
// 值为实体解码、CR 归一后的文本。
public class XmlAttribute {
    // 属性名（原样，含前缀）。
    public string name;
    // 属性值（已解码）。
    public string value;
}

// XML 树节点。元素/文本/CDATA/注释/PI/声明/DOCTYPE 用
// <see cref="kind"/> 区分：元素持有 <see cref="attrs"/> 与
// <see cref="children"/>，其余类别只用 <see cref="text"/> 承载内容。
// 命名空间不做解析（没有 xmlns 作用域表）：名字按原文匹配，
// 用不带前缀的名字查找时回退到"忽略前缀只比本地名"，这样
// <c>Element("href")</c> 能命中 <c>&lt;D:href&gt;</c>——WebDAV、
// WeChat 这类前缀随服务器变化的报文靠这一条规则就够用。
