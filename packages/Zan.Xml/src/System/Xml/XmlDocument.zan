using System;
using System.IO;
using System.Text;

namespace System.Xml;

// XML 文档：文档级节点（声明/注释/PI/根元素，按原文顺序）+
// 解析与序列化门面。
// 解析（XmlDocument.Parse）与序列化（ToXml/ToPrettyXml）互为逆
// 操作：写出的文本再次 Parse 得到语义相同的树。序列化不是字节
// 级还原——实体统一成最短形（<c>&amp;#65;</c> → <c>A</c>）、自闭合
// 空元素统一成 <c>&lt;a/&gt;</c>、\r 归一后再按需转义——但信息无损。
public class XmlDocument {
    // 序列化递归深度上限：对照读侧 XmlParser.MaxDepth（512）。解析
    // 出来的树天然不越线（元素深度 ≤ 512）；程序手工构造的环/深树
    // 在写侧也拦下，超限抛 XmlException。
    public static int MaxDepth = 512;

    // 文档级节点序列（声明/注释/PI/根元素，按原文顺序）。
    public List<XmlNode> children = new List<XmlNode>();

    // 解析 XML 文本。格式非法抛 <see cref="XmlException"/>。
    public static XmlDocument Parse(string xml) {
        return XmlParser.Parse(xml);
    }

    // 读取并解析 <paramref name="path"/> 处的文件。文件
    // 读不了（不存在/无权限）按 IO 异常抛；内容非法按
    // <see cref="XmlException"/> 抛。
    public static XmlDocument Load(string path) {
        return XmlDocument.Parse(File.ReadAllText(path));
    }

    // 根元素；文档没有元素时返回 null。
    public XmlNode RootElement() {
        for (int i = 0; i < children.Count; i = i + 1) {
            if (children[i].kind == 0) { return children[i]; }
        }
        return null;
    }

    // 根元素下按名查找的快捷方式（规则同 XmlNode.Element）。
    public XmlNode Element(string name) {
        XmlNode root = RootElement();
        if (root == null) { return null; }
        return root.Element(name);
    }

    // 预分配空白池，用于单次 StringView 缩进输出。
    private static string IndentSpaces = "                                ";

    // 紧凑序列化：保留全部节点（注释/CDATA/PI/声明），不引入
    // 任何空白。
    public string ToXml() {
        StringBuilder sb = new StringBuilder(4096);
        for (int i = 0; i < children.Count; i = i + 1) {
            XmlDocument.WriteNode(sb, children[i], 0, false);
        }
        return sb.ToString();
    }

    // 缩进序列化（2 空格/层）：纯空白文本节点略去；唯一非空
    // 文本子节点的元素行内输出。同样可被 Parse 无损读回。
    public string ToPrettyXml() {
        StringBuilder sb = new StringBuilder(4096);
        for (int i = 0; i < children.Count; i = i + 1) {
            XmlDocument.WriteNode(sb, children[i], 0, true);
            if (children[i].kind != 0) { sb.Append("\n"); }
        }
        return sb.ToString();
    }

    // 以紧凑形式写文件（UTF-8）。
    public void Save(string path) {
        File.WriteAllText(path, ToXml());
    }

    // 序列化一个节点（含全部后代）。约定：元素收尾时自带换行
    // （pretty 模式），非元素类别不带——由调用方补，保证文档层
    // 每个顶层块后恰一个换行。深度帽只对元素计（文本/CDATA 等叶
    // 节点无后代，不做无谓拒绝——解析侧允许元素深度到 512，其
    // 叶子内容在 513 层也必须能写回）。
    public static void WriteNode(StringBuilder sb, XmlNode n, int depth, bool pretty) {
        if (n.kind == 0 && depth > XmlDocument.MaxDepth) {
            throw new XmlException("XML nesting too deep to serialize (cycle?)");
        }
        if (n.kind == 1) {
            XmlDocument.EscapeText(sb, n.text);
            return;
        }
        if (n.kind == 2) {
            XmlDocument.EmitCdata(sb, n.text);
            return;
        }
        if (n.kind == 3) {
            string ct = n.text == null ? "" : n.text;
            if (ct.IndexOf("--") >= 0 || (ct.Length > 0 && (ct[ct.Length - 1] & 255) == 45)) {
                throw new XmlException("XML comment cannot contain '--' or end with '-'");
            }
            sb.Append("<!--");
            sb.Append(ct);
            sb.Append("-->");
            return;
        }
        if (n.kind == 4) {
            string pt = n.text == null ? "" : n.text;
            if (pt.IndexOf("?>") >= 0) {
                throw new XmlException("XML processing instruction cannot contain '?>'");
            }
            sb.Append("<?");
            sb.Append(n.name);
            if (pt.Length > 0) {
                sb.Append(" ");
                sb.Append(pt);
            }
            sb.Append("?>");
            return;
        }
        if (n.kind == 5) {
            sb.Append("<?xml");
            XmlDocument.WriteAttrs(sb, n);
            sb.Append("?>");
            return;
        }
        if (n.kind == 6) {
            sb.Append(n.text);  // DOCTYPE 原文
            return;
        }
        // 元素
        XmlDocument.Indent(sb, depth, pretty);
        sb.Append("<");
        sb.Append(n.name);
        XmlDocument.WriteAttrs(sb, n);
        int count = n.children == null ? 0 : n.children.Count;
        if (count == 0) {
            sb.Append("/>");
            XmlDocument.Newline(sb, pretty);
            return;
        }
        sb.Append(">");
        // 行内：唯一子节点是非空文本/CDATA。
        if (pretty && count == 1 && (n.children[0].kind == 1 || n.children[0].kind == 2)
            && XmlDocument.HasNonSpace(n.children[0].text)) {
            XmlDocument.WriteNode(sb, n.children[0], depth + 1, pretty);
            sb.Append("</");
            sb.Append(n.name);
            sb.Append(">");
            XmlDocument.Newline(sb, pretty);
            return;
        }
        XmlDocument.Newline(sb, pretty);
        for (int i = 0; i < count; i = i + 1) {
            XmlNode ch = n.children[i];
            if (pretty && ch.kind == 1 && !XmlDocument.HasNonSpace(ch.text)) {
                continue;  // 纯空白略去
            }
            XmlDocument.WriteNode(sb, ch, depth + 1, pretty);
        }
        XmlDocument.Indent(sb, depth, pretty);
        sb.Append("</");
        sb.Append(n.name);
        sb.Append(">");
        XmlDocument.Newline(sb, pretty);
    }

    public static void WriteAttrs(StringBuilder sb, XmlNode n) {
        if (n.attrs == null) { return; }
        for (int i = 0; i < n.attrs.Count; i = i + 1) {
            sb.Append(" ");
            sb.Append(n.attrs[i].name);
            sb.Append("=\"");
            XmlDocument.EscapeAttr(sb, n.attrs[i].value);
            sb.Append("\"");
        }
    }

    // CDATA 回写：内容里的 "]]&gt;" 拆成 "]]]]&gt;&lt;![CDATA[&gt;"
    // （.NET 同款技巧），读回得到原内容。
    public static void EmitCdata(StringBuilder sb, string text) {
        sb.Append("<![CDATA[");
        if (text == null || text.Length == 0) {
            sb.Append("]]>");
            return;
        }
        int tlen = text.Length;
        nint tp = (nint)text;
        // 快路径：先用 SIMD memchr 查 ']'，无 ']' 则不可能含 "]]>"，直接整串写入。
        int rb = NativeMemory.Find(tp, 0, 93, tlen);
        if (rb < 0 || rb + 2 >= tlen) {
            sb.Append(text);
            sb.Append("]]>");
            return;
        }
        int hit = XmlNode.IndexOf(text, "]]>", rb);
        if (hit < 0) {
            sb.Append(text);
            sb.Append("]]>");
            return;
        }
        int from = 0;
        while (hit >= 0) {
            sb.Append(new StringView(tp + (nint)from, hit + 2 - from));
            sb.Append("]]><![CDATA[>");
            from = hit + 3;
            hit = XmlNode.IndexOf(text, "]]>", from);
        }
        if (from < tlen) {
            sb.Append(new StringView(tp + (nint)from, tlen - from));
        }
        sb.Append("]]>");
    }

    // 文本转义：&amp; &lt; &gt; 与 \r（\r 不转义会在解析时被
    // CR 归一吃掉，往返即失真）。
    public static void EscapeText(StringBuilder sb, string t) {
        XmlDocument.EscapeRuns(sb, t, false);
    }

    // 属性值转义：在文本转义之上加 &quot; &#39; 与 \n \t（属性值里的
    // 引号/换行/制表会破坏引号结构与行内可读性；单引号虽非本包
    // writer 所用，防纵深统一转义）。
    public static void EscapeAttr(StringBuilder sb, string t) {
        XmlDocument.EscapeRuns(sb, t, true);
    }

    public static void EscapeRuns(StringBuilder sb, string t, bool isAttr) {
        if (sb == null || t == null || t.Length == 0) { return; }
        int n = t.Length;
        nint tp = (nint)t;
        Span<byte> buf = new Span<byte>(tp, n);
        int from = 0;
        for (int i = 0; i < n; i = i + 1) {
            int c = buf[i] & 255;
            // 所有需转义字符（\t,\n,\r,",&,',<,>）均 <= 62，单分支跳过全部字母与 UTF-8 字节。
            if (c > 62) { continue; }
            string rep = null;
            if (c == 38) { rep = "&amp;"; }
            else if (c == 60) { rep = "&lt;"; }
            else if (c == 62) { rep = "&gt;"; }
            else if (c == 13) { rep = "&#13;"; }
            else if (isAttr) {
                if (c == 34) { rep = "&quot;"; }
                else if (c == 39) { rep = "&#39;"; }
                else if (c == 10) { rep = "&#10;"; }
                else if (c == 9) { rep = "&#9;"; }
            }
            if (rep != null) {
                if (i > from) { sb.Append(new StringView(tp + (nint)from, i - from)); }
                sb.Append(rep);
                from = i + 1;
            }
        }
        if (from == 0) {
            sb.Append(t);
        } else if (from < n) {
            sb.Append(new StringView(tp + (nint)from, n - from));
        }
    }

    public static void Indent(StringBuilder sb, int depth, bool pretty) {
        if (!pretty || depth <= 0) { return; }
        int rem = depth * 2;
        nint sp = (nint)XmlDocument.IndentSpaces;
        while (rem >= 32) {
            sb.Append(XmlDocument.IndentSpaces);
            rem = rem - 32;
        }
        if (rem > 0) {
            sb.Append(new StringView(sp, rem));
        }
    }

    public static void Newline(StringBuilder sb, bool pretty) {
        if (pretty) { sb.Append("\n"); }
    }

    private static bool HasNonSpace(string s) {
        if (s == null) { return false; }
        int n = s.Length;
        Span<byte> buf = new Span<byte>((nint)s, n);
        for (int i = 0; i < n; i = i + 1) {
            int c = buf[i] & 255;
            if (c != 32 && (c < 9 || c > 13)) { return true; }
        }
        return false;
    }
}
