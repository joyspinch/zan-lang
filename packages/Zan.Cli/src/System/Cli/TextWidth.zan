using System;
using System.Text;

namespace System.Cli;

// 终端显示宽度。
//
// 字符串的字节数（string.Length）不是显示宽度：中文/日文/韩文是双宽字符
// （占两列），组合记号（重音、变体选择符）占零列。表格对齐、进度条、
// 截断都必须按显示宽度算，否则中文表格会歪。
//
// 宽度表按 East Asian Width 的 Wide/Fullwidth 与零宽规则实现，覆盖
// CJK、假名、谚文、全角标点、常用 emoji 区段与 CJK 扩展 B 以后。
public class TextWidth {
    private static const string SPACES64 = "                                                                ";

    // 字符串的显示宽度（列数）。ASCII 快路径与 2/3 字节 UTF-8 内联解码，零 int[1] 堆分配。
    public static int Width(string s) {
        if (s == null) { return 0; }
        int n = s.Length;
        int w = 0;
        int i = 0;
        int[] slot = null;
        while (i < n) {
            int b0 = s[i] & 255;
            if (b0 < 128) {
                if (b0 >= 32 && b0 < 127) { w = w + 1; }
                i = i + 1;
                continue;
            }
            if (b0 >= 0xE0 && b0 <= 0xEF && i + 2 < n) {
                int b1 = s[i + 1] & 255;
                int b2 = s[i + 2] & 255;
                if ((b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80) {
                    int cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F);
                    if (cp >= 0x0800 && (cp < 0xD800 || cp > 0xDFFF)) {
                        w = w + TextWidth.RuneWidth(cp);
                        i = i + 3;
                        continue;
                    }
                }
            } else if (b0 >= 0xC2 && b0 <= 0xDF && i + 1 < n) {
                int b1 = s[i + 1] & 255;
                if ((b1 & 0xC0) == 0x80) {
                    int cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F);
                    w = w + TextWidth.RuneWidth(cp);
                    i = i + 2;
                    continue;
                }
            }
            if (slot == null) { slot = new int[1]; }
            int used = Encoding.DecodeCodePoint(s, i, slot);
            if (used <= 0) { used = 1; }
            w = w + TextWidth.RuneWidth(slot[0]);
            i = i + used;
        }
        return w;
    }

    // 单个码点的显示宽度：0（零宽/控制）、1（常规）、2（宽字符）。
    public static int RuneWidth(int cp) {
        if (cp >= 0x20 && cp < 0x7f) { return 1; }
        if (cp < 0xa0) { return 0; }
        if (cp < 0x0300) { return 1; }
        if (cp >= 0x4e00 && cp <= 0x9fff) { return 2; }
        if (cp < 0x1100) { return TextWidth.IsZeroWidth(cp) ? 0 : 1; }
        if (TextWidth.IsZeroWidth(cp)) { return 0; }
        if (TextWidth.IsWide(cp)) { return 2; }
        return 1;
    }

    // 零宽：组合记号、变体选择符、零宽连接符/空格等。
    public static bool IsZeroWidth(int cp) {
        if (cp < 0x0300 || cp > 0xe01ef) { return false; }
        if (cp < 0x2000) {
            if (cp <= 0x036f) { return true; }
            if (cp >= 0x0483 && cp <= 0x0489) { return true; }
            if (cp >= 0x0591 && cp <= 0x05c5) {
                if (cp <= 0x05bd) { return true; }
                if (cp == 0x05bf || cp == 0x05c1 || cp == 0x05c2 || cp == 0x05c4 || cp == 0x05c5) { return true; }
                return false;
            }
            if (cp >= 0x0610 && cp <= 0x06ed) {
                if (cp <= 0x061a) { return true; }
                if (cp >= 0x064b && cp <= 0x065f) { return true; }
                if (cp == 0x0670) { return true; }
                if (cp >= 0x06d6 && cp <= 0x06dc) { return true; }
                if (cp >= 0x06df && cp <= 0x06e4) { return true; }
                if (cp == 0x06e7 || cp == 0x06e8) { return true; }
                if (cp >= 0x06ea) { return true; }
                return false;
            }
            if (cp >= 0x0e31 && cp <= 0x0e4e) {
                if (cp == 0x0e31) { return true; }
                if (cp >= 0x0e34 && cp <= 0x0e3a) { return true; }
                if (cp >= 0x0e47) { return true; }
                return false;
            }
            if (cp >= 0x1ab0 && cp <= 0x1aff) { return true; }
            if (cp >= 0x1dc0 && cp <= 0x1dff) { return true; }
            return false;
        }
        if (cp <= 0x20f0) {
            if (cp >= 0x200b && cp <= 0x200f) { return true; }
            if (cp >= 0x202a && cp <= 0x202e) { return true; }
            if (cp >= 0x2060 && cp <= 0x2064) { return true; }
            if (cp >= 0x20d0) { return true; }
            return false;
        }
        if (cp >= 0xfe00 && cp <= 0xfeff) {
            if (cp <= 0xfe0f) { return true; }
            if (cp >= 0xfe20 && cp <= 0xfe2f) { return true; }
            if (cp == 0xfeff) { return true; }
            return false;
        }
        if (cp >= 0xe0100) { return true; }
        return false;
    }

    // 宽字符（East Asian Wide / Fullwidth）。
    public static bool IsWide(int cp) {
        if (cp < 0x1100 || cp > 0x3fffd) { return false; }
        if (cp >= 0x4e00 && cp <= 0x9fff) { return true; }
        if (cp <= 0x4dbf) {
            if (cp <= 0x115f) { return true; }
            if (cp >= 0x2e80 && cp <= 0x303e) { return true; }
            if (cp >= 0x3041) { return true; }
            return false;
        }
        if (cp < 0x10000) {
            if (cp <= 0xa4cf) { return cp >= 0xa000; }
            if (cp >= 0xa960 && cp <= 0xa97f) { return true; }
            if (cp >= 0xac00 && cp <= 0xd7a3) { return true; }
            if (cp >= 0xf900 && cp <= 0xfaff) { return true; }
            if (cp >= 0xfe10 && cp <= 0xfe19) { return true; }
            if (cp >= 0xfe30 && cp <= 0xfe6f) { return true; }
            if (cp >= 0xff00 && cp <= 0xff60) { return true; }
            if (cp >= 0xffe0 && cp <= 0xffe6) { return true; }
            return false;
        }
        if (cp >= 0x20000) { return true; }
        if (cp >= 0x1f300 && cp <= 0x1f64f) { return true; }
        if (cp >= 0x1f900 && cp <= 0x1f9ff) { return true; }
        return false;
    }

    // 重复拼接指定文本 count 次（精确单缓冲直写，零 StringBuilder 扩容）。
    public static string Repeat(string piece, int count) {
        if (piece == null || piece.Length == 0 || count <= 0) { return ""; }
        if (count == 1) { return piece; }
        int plen = piece.Length;
        int total = plen * count;
        byte[] buf = new byte[total];
        nint bp = (nint)buf;
        if (plen == 1) {
            NativeMemory.Fill(bp, piece[0] & 255, total);
        } else {
            NativeMemory.Copy(bp, (nint)piece, plen);
            int filled = plen;
            while (filled < total) {
                int step = total - filled;
                if (step > filled) { step = filled; }
                NativeMemory.Copy(bp + (nint)filled, bp, step);
                filled = filled + step;
            }
        }
        return NativeMemory.GetString(bp, 0, total);
    }

    // n 个空格。
    public static string Spaces(int n) {
        if (n <= 0) { return ""; }
        if (n <= 64) { return TextWidth.SPACES64.Substring(0, n); }
        byte[] buf = new byte[n];
        NativeMemory.Fill((nint)buf, 32, n);
        return NativeMemory.GetString((nint)buf, 0, n);
    }

    internal static void AppendSpaces(StringBuilder sb, int n) {
        while (n >= 64) {
            sb.Append(TextWidth.SPACES64);
            n = n - 64;
        }
        if (n > 0) {
            sb.Append(new StringView((nint)TextWidth.SPACES64, n));
        }
    }

    internal static void PadInto(StringBuilder sb, string text, int curWidth, int targetWidth, int align) {
        if (curWidth >= targetWidth) {
            sb.Append(text);
            return;
        }
        int total = targetWidth - curWidth;
        if (align == 2) {
            TextWidth.AppendSpaces(sb, total);
            sb.Append(text);
            return;
        }
        if (align == 1) {
            int left = total / 2;
            TextWidth.AppendSpaces(sb, left);
            sb.Append(text);
            TextWidth.AppendSpaces(sb, total - left);
            return;
        }
        sb.Append(text);
        TextWidth.AppendSpaces(sb, total);
    }

    // 按显示宽度补齐。align：0 = 左，1 = 中，2 = 右。
    // 已经超宽的文本原样返回（不截断——截断是 Truncate 的事）。
    public static string Pad(string s, int width, int align) {
        string text = s == null ? "" : s;
        int cur = TextWidth.Width(text);
        if (cur >= width) { return text; }
        int total = width - cur;
        int tlen = text.Length;
        int outLen = tlen + total;
        byte[] buf = new byte[outLen];
        nint bp = (nint)buf;
        if (align == 2) {
            NativeMemory.Fill(bp, 32, total);
            if (tlen > 0) { NativeMemory.Copy(bp + (nint)total, (nint)text, tlen); }
        } else if (align == 1) {
            int left = total / 2;
            int right = total - left;
            if (left > 0) { NativeMemory.Fill(bp, 32, left); }
            if (tlen > 0) { NativeMemory.Copy(bp + (nint)left, (nint)text, tlen); }
            if (right > 0) { NativeMemory.Fill(bp + (nint)(left + tlen), 32, right); }
        } else {
            if (tlen > 0) { NativeMemory.Copy(bp, (nint)text, tlen); }
            NativeMemory.Fill(bp + (nint)tlen, 32, total);
        }
        return NativeMemory.GetString(bp, 0, outLen);
    }

    // 截断到显示宽度，超出部分用省略号（"…" 占一列）。单遍扫描，零 int[1] 分配。
    // width <= 0 返回空串。
    public static string Truncate(string s, int width) {
        if (s == null || width <= 0) { return ""; }
        int n = s.Length;
        int budget = width - 1;
        int w = 0;
        int i = 0;
        int cutIdx = 0;
        int[] slot = null;
        while (i < n) {
            int b0 = s[i] & 255;
            int rw = 0;
            int used = 1;
            if (b0 < 128) {
                rw = (b0 >= 32 && b0 < 127) ? 1 : 0;
            } else if (b0 >= 0xE0 && b0 <= 0xEF && i + 2 < n
                    && ((s[i + 1] & 255) & 0xC0) == 0x80 && ((s[i + 2] & 255) & 0xC0) == 0x80) {
                int cp = ((b0 & 0x0F) << 12) | (((s[i + 1] & 255) & 0x3F) << 6) | ((s[i + 2] & 255) & 0x3F);
                if (cp >= 0x0800 && (cp < 0xD800 || cp > 0xDFFF)) {
                    rw = TextWidth.RuneWidth(cp);
                    used = 3;
                } else {
                    if (slot == null) { slot = new int[1]; }
                    used = Encoding.DecodeCodePoint(s, i, slot);
                    if (used <= 0) { used = 1; }
                    rw = TextWidth.RuneWidth(slot[0]);
                }
            } else if (b0 >= 0xC2 && b0 <= 0xDF && i + 1 < n && ((s[i + 1] & 255) & 0xC0) == 0x80) {
                int cp = ((b0 & 0x1F) << 6) | ((s[i + 1] & 255) & 0x3F);
                rw = TextWidth.RuneWidth(cp);
                used = 2;
            } else {
                if (slot == null) { slot = new int[1]; }
                used = Encoding.DecodeCodePoint(s, i, slot);
                if (used <= 0) { used = 1; }
                rw = TextWidth.RuneWidth(slot[0]);
            }
            w = w + rw;
            if (w > width) {
                if (budget <= 0 || cutIdx <= 0) { return "…"; }
                byte[] outBuf = new byte[cutIdx + 3];
                nint obp = (nint)outBuf;
                NativeMemory.Copy(obp, (nint)s, cutIdx);
                outBuf[cutIdx] = 0xE2;
                outBuf[cutIdx + 1] = 0x80;
                outBuf[cutIdx + 2] = 0xA6;
                return NativeMemory.GetString(obp, 0, cutIdx + 3);
            }
            i = i + used;
            if (w <= budget) { cutIdx = i; }
        }
        return s;
    }
}
