using System;
using System.Text;

namespace System.Cli;

// 终端显示宽度。
//
// 字符串的字节数（string.Length）不是显示宽度：中文/日文/韩文是双宽字符
// （占两列），组合记号（重音、变体选择符）占零列。表格对齐、进度条、
// 截断都必须按显示宽度算，否则中文表格会歪。
//
// 宽度表按 East Asian Width 的 Wide/Fullwidth 与零宽规则实现，覆盖
// CJK、假名、谚文、全角标点、常用 emoji 区段与 CJK 扩展 B 以后。
public class TextWidth {
    // 字符串的显示宽度（列数）。
    public static int Width(string s) {
        if (s == null) { return 0; }
        int n = s.Length;
        int w = 0;
        int i = 0;
        int[] slot = new int[1];
        while (i < n) {
            int used = Encoding.DecodeCodePoint(s, i, slot);
            if (used <= 0) { used = 1; }
            w = w + TextWidth.RuneWidth(slot[0]);
            i = i + used;
        }
        return w;
    }

    // 单个码点的显示宽度：0（零宽/控制）、1（常规）、2（宽字符）。
    public static int RuneWidth(int cp) {
        if (cp <= 0) { return 0; }
        if (cp < 0x20) { return 0; }
        if (cp >= 0x7f && cp < 0xa0) { return 0; }
        if (TextWidth.IsZeroWidth(cp)) { return 0; }
        if (TextWidth.IsWide(cp)) { return 2; }
        return 1;
    }

    // 零宽：组合记号、变体选择符、零宽连接符/空格等。
    public static bool IsZeroWidth(int cp) {
        if (cp >= 0x0300 && cp <= 0x036f) { return true; }
        if (cp >= 0x0483 && cp <= 0x0489) { return true; }
        if (cp >= 0x0591 && cp <= 0x05bd) { return true; }
        if (cp >= 0x05bf && cp <= 0x05bf) { return true; }
        if (cp >= 0x05c1 && cp <= 0x05c2) { return true; }
        if (cp >= 0x05c4 && cp <= 0x05c5) { return true; }
        if (cp >= 0x0610 && cp <= 0x061a) { return true; }
        if (cp >= 0x064b && cp <= 0x065f) { return true; }
        if (cp >= 0x0670 && cp <= 0x0670) { return true; }
        if (cp >= 0x06d6 && cp <= 0x06dc) { return true; }
        if (cp >= 0x06df && cp <= 0x06e4) { return true; }
        if (cp >= 0x06e7 && cp <= 0x06e8) { return true; }
        if (cp >= 0x06ea && cp <= 0x06ed) { return true; }
        if (cp >= 0x0e31 && cp <= 0x0e31) { return true; }
        if (cp >= 0x0e34 && cp <= 0x0e3a) { return true; }
        if (cp >= 0x0e47 && cp <= 0x0e4e) { return true; }
        if (cp >= 0x200b && cp <= 0x200f) { return true; }
        if (cp >= 0x202a && cp <= 0x202e) { return true; }
        if (cp >= 0x2060 && cp <= 0x2064) { return true; }
        if (cp >= 0x20d0 && cp <= 0x20f0) { return true; }
        if (cp >= 0xfe00 && cp <= 0xfe0f) { return true; }
        if (cp >= 0xfe20 && cp <= 0xfe2f) { return true; }
        if (cp >= 0xfeff && cp <= 0xfeff) { return true; }
        if (cp >= 0x1ab0 && cp <= 0x1aff) { return true; }
        if (cp >= 0x1dc0 && cp <= 0x1dff) { return true; }
        if (cp >= 0xe0100 && cp <= 0xe01ef) { return true; }
        return false;
    }

    // 宽字符（East Asian Wide / Fullwidth）。
    public static bool IsWide(int cp) {
        if (cp >= 0x1100 && cp <= 0x115f) { return true; }
        if (cp >= 0x2e80 && cp <= 0x303e) { return true; }
        if (cp >= 0x3041 && cp <= 0x33ff) { return true; }
        if (cp >= 0x3400 && cp <= 0x4dbf) { return true; }
        if (cp >= 0x4e00 && cp <= 0x9fff) { return true; }
        if (cp >= 0xa000 && cp <= 0xa4cf) { return true; }
        if (cp >= 0xa960 && cp <= 0xa97f) { return true; }
        if (cp >= 0xac00 && cp <= 0xd7a3) { return true; }
        if (cp >= 0xf900 && cp <= 0xfaff) { return true; }
        if (cp >= 0xfe10 && cp <= 0xfe19) { return true; }
        if (cp >= 0xfe30 && cp <= 0xfe6f) { return true; }
        if (cp >= 0xff00 && cp <= 0xff60) { return true; }
        if (cp >= 0xffe0 && cp <= 0xffe6) { return true; }
        if (cp >= 0x1f300 && cp <= 0x1f64f) { return true; }
        if (cp >= 0x1f900 && cp <= 0x1f9ff) { return true; }
        if (cp >= 0x20000 && cp <= 0x3fffd) { return true; }
        return false;
    }

    // n 个空格。
    public static string Spaces(int n) {
        if (n <= 0) { return ""; }
        string outp = "";
        for (int i = 0; i < n; i = i + 1) { outp = outp + " "; }
        return outp;
    }

    // 按显示宽度补齐。align：0 = 左，1 = 中，2 = 右。
    // 已经超宽的文本原样返回（不截断——截断是 Truncate 的事）。
    public static string Pad(string s, int width, int align) {
        string text = s == null ? "" : s;
        int cur = TextWidth.Width(text);
        if (cur >= width) { return text; }
        int total = width - cur;
        if (align == 2) { return TextWidth.Spaces(total) + text; }
        if (align == 1) {
            int left = total / 2;
            int right = total - left;
            return TextWidth.Spaces(left) + text + TextWidth.Spaces(right);
        }
        return text + TextWidth.Spaces(total);
    }

    // 截断到显示宽度，超出部分用省略号（"…" 占一列）。
    // width <= 0 返回空串。
    public static string Truncate(string s, int width) {
        if (s == null) { return ""; }
        if (width <= 0) { return ""; }
        if (TextWidth.Width(s) <= width) { return s; }
        int budget = width - 1;
        if (budget <= 0) { return "…"; }
        string outp = "";
        int w = 0;
        int i = 0;
        int n = s.Length;
        int[] slot = new int[1];
        while (i < n) {
            int used = Encoding.DecodeCodePoint(s, i, slot);
            if (used <= 0) { used = 1; }
            int rw = TextWidth.RuneWidth(slot[0]);
            if (w + rw > budget) { break; }
            outp = outp + s.Substring(i, used);
            w = w + rw;
            i = i + used;
        }
        return outp + "…";
    }
}
