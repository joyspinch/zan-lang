using System;

namespace System.Cli;

// 命令行输出门面。
//
// 语义化的几行输出（成功/失败/警告/提示/标题）都从这里走，颜色开关
// 统一在 Ansi 里，调用方不用在每处判断"该不该上色"。
public class Cli {
    // 颜色是否启用。
    public static bool ColorEnabled() {
        return Ansi.Enabled();
    }

    // 显式开关颜色（应用启动时按环境或参数决定）。
    public static void EnableColor(bool on) {
        Ansi.SetEnabled(on);
    }

    // 写一行（带换行）。
    public static void WriteLine(string text) {
        Console.Write(text);
        Console.Write("\n");
    }

    // 写一段文本（不带换行）：表格这类多行块的落笔处。
    public static void Write(string text) {
        Console.Write(text);
    }

    // 写一行带样式的文本。
    public static void Line(Style style, string text) {
        if (style == null) {
            Cli.WriteLine(text);
            return;
        }
        Cli.WriteLine(style.Apply(text));
    }

    // 成功（绿）。
    public static void Success(string text) {
        Cli.Line(Style.Green(), text);
    }

    // 失败（红）。
    public static void Error(string text) {
        Cli.Line(Style.Red(), text);
    }

    // 警告（黄）。
    public static void Warning(string text) {
        Cli.Line(Style.Yellow(), text);
    }

    // 提示（青）。
    public static void Info(string text) {
        Cli.Line(Style.Cyan(), text);
    }

    // 标题（加粗）。
    public static void Header(string text) {
        Cli.Line(Style.Bold(), text);
    }

    // 分隔线（默认 40 列）。
    public static void Rule(int width) {
        int w = width;
        if (w <= 0) { w = 40; }
        string line = "";
        for (int i = 0; i < w; i = i + 1) { line = line + "─"; }
        Cli.WriteLine(line);
    }

    // 打印一张表格。
    public static void Table(Table table) {
        if (table == null) { return; }
        Cli.Write(table.Render());
    }
}
