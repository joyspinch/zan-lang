using System;

namespace System.Cli;

// 作用域样式：给一段文本套上 SGR 序列，套完立刻复位。
//
// 与 Console.ForegroundColor 的区别：后者是**粘性**的（设了之后后面所有
// 输出都带着颜色，直到改回来），前者是**局部**的——样式只作用于 Apply
// 的那一个字符串。这样"一行里只有一段是红的"才画得出来。
//
// 用法：
//   string line = Style.Bold().AddFg(2).Apply("ok");
//   string mixed = Style.Fg(1).Apply("错误") + "，" + Style.Fg(2).Apply("正常");
public class Style {
    // 累积的 SGR 序列（未启用颜色时为空串）。
    public string codes;

    public Style() {
        this.codes = "";
    }

    // 追加一段 SGR 序列（链式）。
    public Style Add(string code) {
        if (code != null && code.Length > 0) {
            this.codes = this.codes + code;
        }
        return this;
    }

    public Style AddBold() { return this.Add(Ansi.Bold()); }
    public Style AddDim() { return this.Add(Ansi.Dim()); }
    public Style AddItalic() { return this.Add(Ansi.Italic()); }
    public Style AddUnderline() { return this.Add(Ansi.Underline()); }
    public Style AddStrikethrough() { return this.Add(Ansi.Strikethrough()); }
    public Style AddReverse() { return this.Add(Ansi.Reverse()); }
    public Style AddFg(int color) { return this.Add(Ansi.Fg(color)); }
    public Style AddBg(int color) { return this.Add(Ansi.Bg(color)); }
    public Style AddFg256(int index) { return this.Add(Ansi.Fg256(index)); }
    public Style AddBg256(int index) { return this.Add(Ansi.Bg256(index)); }
    public Style AddFgRgb(int r, int g, int b) { return this.Add(Ansi.FgRgb(r, g, b)); }
    public Style AddBgRgb(int r, int g, int b) { return this.Add(Ansi.BgRgb(r, g, b)); }

    // 套样式。颜色关闭时原样返回文本。
    public string Apply(string text) {
        if (text == null) { return ""; }
        if (this.codes.Length == 0) { return text; }
        if (!Ansi.Enabled()) { return text; }
        return this.codes + text + Ansi.Reset();
    }

    /* ---------- 常用样式 ---------- */

    public static Style Bold() { return new Style().AddBold(); }
    public static Style Dim() { return new Style().AddDim(); }
    public static Style Italic() { return new Style().AddItalic(); }
    public static Style Underline() { return new Style().AddUnderline(); }

    // 前景色：0 黑 1 红 2 绿 3 黄 4 蓝 5 品红 6 青 7 白
    //         8 亮黑（灰）9 亮红 10 亮绿 11 亮黄 12 亮蓝 13 亮品红 14 亮青 15 亮白
    public static Style Fg(int color) { return new Style().AddFg(color); }
    public static Style Bg(int color) { return new Style().AddBg(color); }

    public static Style Black() { return new Style().AddFg(0); }
    public static Style Red() { return new Style().AddFg(1); }
    public static Style Green() { return new Style().AddFg(2); }
    public static Style Yellow() { return new Style().AddFg(3); }
    public static Style Blue() { return new Style().AddFg(4); }
    public static Style Magenta() { return new Style().AddFg(5); }
    public static Style Cyan() { return new Style().AddFg(6); }
    public static Style White() { return new Style().AddFg(7); }
    public static Style Gray() { return new Style().AddFg(8); }

    public static Style OnRed() { return new Style().AddBg(1); }
    public static Style OnGreen() { return new Style().AddBg(2); }
    public static Style OnYellow() { return new Style().AddBg(3); }
    public static Style OnBlue() { return new Style().AddBg(4); }
}
