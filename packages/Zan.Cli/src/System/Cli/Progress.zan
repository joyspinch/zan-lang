using System;

namespace System.Cli;

// 进度条。
//
// 渲染是纯函数（Render 返回字符串，不写终端），所以进度条在测试里可以
// 逐字节断言，不依赖计时器也不依赖终端。ProgressBar 负责"把进度画到
// 同一行"，Progress 负责状态推进。
//
// 条形字符（█ ░）在 East Asian Width 里是歧义宽度；需要绝对确定的场合
// 用 AsciiBar() 换成 # / -。
public class ProgressBar {
    // 条的总宽度（列）。
    public int width;
    // 已完成部分 / 未完成部分的字符。
    public string fill;
    public string empty;
    // 是否在末尾显示百分比。
    public bool showPercent;

    public ProgressBar(int width) {
        this.width = width;
        this.fill = "█";
        this.empty = "░";
        this.showPercent = true;
    }

    // 换成 ASCII 条（# 与 -）。
    public ProgressBar AsciiBar() {
        this.fill = "#";
        this.empty = "-";
        return this;
    }

    // 渲染进度条本体（不含百分比）。
    public string RenderBar(double fraction) {
        double f = fraction;
        if (f < 0.0) { f = 0.0; }
        if (f > 1.0) { f = 1.0; }
        int w = this.width;
        if (w < 0) { w = 0; }
        int done = (int)(f * (double)w + 0.5);
        if (done > w) { done = w; }
        if (done < 0) { done = 0; }
        string outp = "";
        for (int i = 0; i < done; i = i + 1) { outp = outp + this.fill; }
        for (int i = done; i < w; i = i + 1) { outp = outp + this.empty; }
        return outp;
    }

    // 渲染完整进度条（含百分比）。
    public string Render(double fraction) {
        string bar = this.RenderBar(fraction);
        if (!this.showPercent) { return bar; }
        double f = fraction;
        if (f < 0.0) { f = 0.0; }
        if (f > 1.0) { f = 1.0; }
        int pct = (int)(f * 100.0 + 0.5);
        return "[" + bar + "] " + pct + "%";
    }

    // 按"已完成/总数"渲染（总数为 0 时按 0% 处理）。
    public string RenderCount(int current, int total) {
        if (total <= 0) { return this.Render(0.0); }
        return this.Render((double)current / (double)total);
    }
}

// 把进度画在同一行的进度指示器。
//
// 用法：
//   Progress p = new Progress(20, "编译");
//   p.Update(0.5);
//   p.Done();
public class Progress {
    public ProgressBar bar;
    public string message;
    public bool done;

    public Progress(int width, string message) {
        this.bar = new ProgressBar(width);
        this.message = message == null ? "" : message;
        this.done = false;
    }

    // 推进到 fraction（0..1），原地重画。
    public void Update(double fraction) {
        if (this.done) { return; }
        string text = this.message + " " + this.bar.Render(fraction);
        Console.Write("\r" + text);
    }

    // 结束（补一个换行）。
    public void Done() {
        if (this.done) { return; }
        this.done = true;
        Console.Write("\n");
    }
}
