using System;
using System.Collections.Generic;

namespace System.Cli;

// 交互式提示。
//
// 两个方向都做成可注入：
//   - 读取器（Func<string>）：喂什么就返回什么，交互解析可断言；
//   - 输出 sink（ActionT<string>）：提示语写到哪里，提示文本可断言。
// 默认读取器读控制台一行，默认 sink 写控制台。
//
// 用法：
//   string name = Prompt.Text("名字", "alice");
//   bool go = Prompt.Confirm("继续", true);
//   int pick = Prompt.Select("选一个", options);
public class Prompt {
    // 默认读取器：读控制台一行。
    public static Func<string> DefaultReader() {
        return () => Console.ReadLine();
    }

    // 默认输出 sink：写控制台。
    public static ActionT<string> ConsoleWriter() {
        return s => Console.Write(s);
    }

    /* ---------- 文本 ---------- */

    // 文本提示（写控制台）：回车用默认值。
    public static string Text(string label, string defaultValue, Func<string> reader) {
        return Prompt.TextTo(Prompt.ConsoleWriter(), label, defaultValue, reader);
    }

    // 文本提示（写到指定 sink）。
    public static string TextTo(ActionT<string> writer, string label, string defaultValue,
                                Func<string> reader) {
        string def = defaultValue == null ? "" : defaultValue;
        string suffix = def.Length > 0 ? " [" + def + "]" : "";
        Prompt.Write(writer, label + suffix + ": ");
        string line = Prompt.Read(reader);
        if (line == null) { return def; }
        string trimmed = line.Trim();
        if (trimmed.Length == 0) { return def; }
        return trimmed;
    }

    /* ---------- 确认 ---------- */

    // 确认提示（写控制台）：y/n，空输入用默认值。
    public static bool Confirm(string label, bool defaultValue, Func<string> reader) {
        return Prompt.ConfirmTo(Prompt.ConsoleWriter(), label, defaultValue, reader);
    }

    // 确认提示（写到指定 sink）。
    public static bool ConfirmTo(ActionT<string> writer, string label, bool defaultValue,
                                 Func<string> reader) {
        string hint = defaultValue ? " [Y/n]" : " [y/N]";
        Prompt.Write(writer, label + hint + ": ");
        string line = Prompt.Read(reader);
        if (line == null) { return defaultValue; }
        string t = line.Trim().ToLower();
        if (t.Length == 0) { return defaultValue; }
        if (t == "y" || t == "yes" || t == "是") { return true; }
        if (t == "n" || t == "no" || t == "否") { return false; }
        return defaultValue;
    }

    /* ---------- 单选 ---------- */

    // 单选提示（写控制台）：打印选项（1 起编号），读入编号。
    public static int Select(string label, List<string> options, Func<string> reader) {
        return Prompt.SelectTo(Prompt.ConsoleWriter(), label, options, reader);
    }

    // 单选提示（写到指定 sink）。输入无效时重复询问；读到 EOF 返回 -1。
    public static int SelectTo(ActionT<string> writer, string label, List<string> options,
                               Func<string> reader) {
        Prompt.Write(writer, label + "\n");
        if (options != null) {
            for (int i = 0; i < options.Count; i = i + 1) {
                Prompt.Write(writer, "  " + (i + 1) + ") " + options[i] + "\n");
            }
        }
        while (true) {
            Prompt.Write(writer, "> ");
            string line = Prompt.Read(reader);
            if (line == null) { return -1; }
            string t = line.Trim();
            if (t.Length == 0) { continue; }
            int idx = t.ToInt32();
            if (options != null && idx >= 1 && idx <= options.Count) { return idx - 1; }
            Prompt.Write(writer, "无效的选项，请重新输入\n");
        }
    }

    /* ---------- 内部 ---------- */

    // 读一行；reader 为 null 时用默认读取器。
    public static string Read(Func<string> reader) {
        if (reader == null) { reader = Prompt.DefaultReader(); }
        return reader();
    }

    // 写一段；writer 为 null 时写控制台。
    public static void Write(ActionT<string> writer, string text) {
        if (writer == null) {
            Console.Write(text);
            return;
        }
        writer(text);
    }
}
