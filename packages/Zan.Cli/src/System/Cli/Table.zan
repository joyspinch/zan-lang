using System;
using System.Collections.Generic;

namespace System.Cli;

// 表格的一列。align：0 = 左，1 = 中，2 = 右。width：0 = 按内容自适应。
public class TableColumn {
    public string title;
    public int align;
    public int width;

    public TableColumn(string title, int align) {
        this.title = title == null ? "" : title;
        this.align = align;
        this.width = 0;
    }
}

// 终端表格。
//
// 对齐按**显示宽度**算（TextWidth），不是字节数：中文表头与中文单元格
// 在等宽终端里必须和 ASCII 列对齐。列宽自适应（取表头与所有单元格的
// 最大显示宽度），也可以用 TableColumn.width 钉死。
//
// 三种边框：无（0）/ ASCII（1）/ Unicode（2）。Unicode 边框用的是制表
// 字符，在 East Asian Width 里是"歧义宽度"——极少数按 CJK 宽度渲染的
// 终端会把它当两列，需要绝对确定的场合用 ASCII 边框。
public class Table {
    public List<TableColumn> columns;
    public List<List<string>> rows;
    // 0 = 无边框，1 = ASCII，2 = Unicode。
    public int border;

    public Table() {
        this.columns = new List<TableColumn>();
        this.rows = new List<List<string>>();
        this.border = 2;
    }

    // 加一列（链式）。
    public Table AddColumn(string title, int align) {
        this.columns.Add(new TableColumn(title, align));
        return this;
    }

    // 加一行（链式）。单元格数可以少于列数（缺的按空处理）。
    public Table AddRow(params string[] cells) {
        List<string> row = new List<string>();
        if (cells != null) {
            for (int i = 0; i < cells.Length; i = i + 1) { row.Add(cells[i]); }
        }
        this.rows.Add(row);
        return this;
    }

    // 切到 ASCII 边框。
    public Table AsciiBorder() {
        this.border = 1;
        return this;
    }

    // 切到 Unicode 边框（默认）。
    public Table UnicodeBorder() {
        this.border = 2;
        return this;
    }

    // 去掉边框。
    public Table NoBorder() {
        this.border = 0;
        return this;
    }

    private static const string DASHES32 = "--------------------------------";
    private static const string HBARS16 = "────────────────";

    private static void AppendRepeat(StringBuilder sb, string fill, int count) {
        if (count <= 0) { return; }
        if (fill == "-") {
            while (count >= 32) {
                sb.Append(Table.DASHES32);
                count = count - 32;
            }
            if (count > 0) {
                sb.Append(new StringView((nint)Table.DASHES32, count));
            }
            return;
        }
        if (fill == "─") {
            while (count >= 16) {
                sb.Append(Table.HBARS16);
                count = count - 16;
            }
            if (count > 0) {
                sb.Append(new StringView((nint)Table.HBARS16, count * 3));
            }
            return;
        }
        for (int k = 0; k < count; k = k + 1) { sb.Append(fill); }
    }

    private static int TrimmedEnd(string s) {
        int e = s.Length;
        while (e > 0) {
            int b = s[e - 1] & 255;
            if (b == 32 || b == 9 || b == 10 || b == 13 || b == 11 || b == 12) {
                e = e - 1;
            } else {
                break;
            }
        }
        return e;
    }

    // 渲染成表格文本（末尾带换行）。缓存每格显示宽度，消除二次 Width 计算与逐格 Pad 临时串。
    public string Render() {
        int n = this.columns.Count;
        if (n == 0) { return ""; }
        int rowCount = this.rows.Count;
        int[] widths = new int[n];
        int[] aligns = new int[n];
        int[] cellWidths = new int[(rowCount + 1) * n];
        int sumW = 0;
        for (int c = 0; c < n; c = c + 1) {
            TableColumn col = this.columns[c];
            aligns[c] = col.align;
            int hw = TextWidth.Width(col.title);
            cellWidths[c] = hw;
            int w = hw;
            for (int r = 0; r < rowCount; r = r + 1) {
                List<string> row = this.rows[r];
                int cw = 0;
                if (c < row.Count) {
                    cw = TextWidth.Width(row[c]);
                    if (cw > w) { w = cw; }
                }
                cellWidths[(r + 1) * n + c] = cw;
            }
            if (col.width > 0) { w = col.width; }
            widths[c] = w;
            sumW = sumW + w;
        }

        int lineEst = sumW * 2 + n * 6 + 8;
        StringBuilder sb = new StringBuilder(lineEst * (rowCount + 4));
        if (this.border == 2) {
            this.AppendRule(sb, widths, "┌", "┬", "┐", "─");
        } else if (this.border == 1) {
            this.AppendRule(sb, widths, "+", "+", "+", "-");
        }

        // 表头直接渲染（免构造 List<string> head）
        this.AppendHeaderCached(sb, widths, aligns, cellWidths, n);
        if (this.border != 0) {
            if (this.border == 2) {
                this.AppendRule(sb, widths, "├", "┼", "┤", "─");
            } else {
                this.AppendRule(sb, widths, "+", "+", "+", "-");
            }
        }

        // 数据行
        for (int r = 0; r < rowCount; r = r + 1) {
            this.AppendRowCached(sb, widths, aligns, this.rows[r], cellWidths, (r + 1) * n, n);
        }

        if (this.border != 0) {
            if (this.border == 2) {
                this.AppendRule(sb, widths, "└", "┴", "┘", "─");
            } else {
                this.AppendRule(sb, widths, "+", "+", "+", "-");
            }
        }
        return sb.ToString();
    }

    private void AppendHeaderCached(StringBuilder sb, int[] widths, int[] aligns, int[] cellWidths, int n) {
        if (this.border != 0) {
            string vbar = this.VerticalBar();
            for (int c = 0; c < n; c = c + 1) {
                sb.Append(vbar);
                sb.Append(" ");
                TextWidth.PadInto(sb, this.columns[c].title, cellWidths[c], widths[c], aligns[c]);
                sb.Append(" ");
            }
            sb.Append(vbar);
            sb.Append("\n");
            return;
        }
        int lastCol = -1;
        int lastTrim = 0;
        for (int c = n - 1; c >= 0; c = c - 1) {
            int te = Table.TrimmedEnd(this.columns[c].title);
            if (te > 0) {
                lastCol = c;
                lastTrim = te;
                break;
            }
        }
        for (int c = 0; c < lastCol; c = c + 1) {
            TextWidth.PadInto(sb, this.columns[c].title, cellWidths[c], widths[c], aligns[c]);
            sb.Append("  ");
        }
        if (lastCol >= 0) {
            string lt = this.columns[lastCol].title;
            int cw = cellWidths[lastCol];
            int tw = widths[lastCol];
            int al = aligns[lastCol];
            if (tw > cw) {
                if (al == 2) { TextWidth.AppendSpaces(sb, tw - cw); }
                else if (al == 1) { TextWidth.AppendSpaces(sb, (tw - cw) / 2); }
            }
            if (lastTrim == lt.Length) {
                sb.Append(lt);
            } else {
                sb.Append(new StringView((nint)lt, lastTrim));
            }
        }
        sb.Append("\n");
    }

    private void AppendRowCached(StringBuilder sb, int[] widths, int[] aligns, List<string> cells,
                                 int[] cellWidths, int baseIdx, int n) {
        int cellCount = cells == null ? 0 : cells.Count;
        if (this.border != 0) {
            string vbar = this.VerticalBar();
            for (int c = 0; c < n; c = c + 1) {
                sb.Append(vbar);
                sb.Append(" ");
                string text = (c < cellCount && cells[c] != null) ? cells[c] : "";
                TextWidth.PadInto(sb, text, cellWidths[baseIdx + c], widths[c], aligns[c]);
                sb.Append(" ");
            }
            sb.Append(vbar);
            sb.Append("\n");
            return;
        }
        int lastCol = -1;
        int lastTrim = 0;
        for (int c = n - 1; c >= 0; c = c - 1) {
            if (c < cellCount && cells[c] != null) {
                int te = Table.TrimmedEnd(cells[c]);
                if (te > 0) {
                    lastCol = c;
                    lastTrim = te;
                    break;
                }
            }
        }
        for (int c = 0; c < lastCol; c = c + 1) {
            string text = (c < cellCount && cells[c] != null) ? cells[c] : "";
            TextWidth.PadInto(sb, text, cellWidths[baseIdx + c], widths[c], aligns[c]);
            sb.Append("  ");
        }
        if (lastCol >= 0) {
            string lt = cells[lastCol];
            int cw = cellWidths[baseIdx + lastCol];
            int tw = widths[lastCol];
            int al = aligns[lastCol];
            if (tw > cw) {
                if (al == 2) { TextWidth.AppendSpaces(sb, tw - cw); }
                else if (al == 1) { TextWidth.AppendSpaces(sb, (tw - cw) / 2); }
            }
            if (lastTrim == lt.Length) {
                sb.Append(lt);
            } else {
                sb.Append(new StringView((nint)lt, lastTrim));
            }
        }
        sb.Append("\n");
    }

    // 画一条横线。
    public void AppendRule(StringBuilder sb, int[] widths, string left, string mid,
                           string right, string fill) {
        sb.Append(left);
        for (int c = 0; c < widths.Length; c = c + 1) {
            if (c > 0) { sb.Append(mid); }
            Table.AppendRepeat(sb, fill, widths[c] + 2);
        }
        sb.Append(right);
        sb.Append("\n");
    }

    // 画一行单元格。
    public void AppendRow(StringBuilder sb, int[] widths, List<string> cells) {
        int n = widths.Length;
        int cellCount = cells == null ? 0 : cells.Count;
        int colCount = this.columns.Count;
        if (this.border != 0) {
            string vbar = this.VerticalBar();
            for (int c = 0; c < n; c = c + 1) {
                sb.Append(vbar);
                sb.Append(" ");
                string text = (c < cellCount && cells[c] != null) ? cells[c] : "";
                int align = c < colCount ? this.columns[c].align : 0;
                TextWidth.PadInto(sb, text, TextWidth.Width(text), widths[c], align);
                sb.Append(" ");
            }
            sb.Append(vbar);
            sb.Append("\n");
            return;
        }
        int lastCol = -1;
        int lastTrim = 0;
        for (int c = n - 1; c >= 0; c = c - 1) {
            if (c < cellCount && cells[c] != null) {
                int te = Table.TrimmedEnd(cells[c]);
                if (te > 0) {
                    lastCol = c;
                    lastTrim = te;
                    break;
                }
            }
        }
        for (int c = 0; c < lastCol; c = c + 1) {
            string text = (c < cellCount && cells[c] != null) ? cells[c] : "";
            int align = c < colCount ? this.columns[c].align : 0;
            TextWidth.PadInto(sb, text, TextWidth.Width(text), widths[c], align);
            sb.Append("  ");
        }
        if (lastCol >= 0) {
            string lt = cells[lastCol];
            int cw = TextWidth.Width(lt);
            int tw = widths[lastCol];
            int al = lastCol < colCount ? this.columns[lastCol].align : 0;
            if (tw > cw) {
                if (al == 2) { TextWidth.AppendSpaces(sb, tw - cw); }
                else if (al == 1) { TextWidth.AppendSpaces(sb, (tw - cw) / 2); }
            }
            if (lastTrim == lt.Length) {
                sb.Append(lt);
            } else {
                sb.Append(new StringView((nint)lt, lastTrim));
            }
        }
        sb.Append("\n");
    }

    // 竖线字符（按边框风格）。
    public string VerticalBar() {
        if (this.border == 2) { return "│"; }
        return "|";
    }
}
