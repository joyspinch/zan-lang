using System;
using System.Collections.Generic;

namespace System.Cli;

// 命令行取值的严格解析（直接对接系统标准 TryParse 原语）。
public class CliValue {
    // 严格的整数解析：整串都是十进制数字（可带正负号）才算合法。
    public static bool TryInt(string s, out int value) {
        return int.TryParse(s, out value);
    }

    // 严格的浮点解析：支持符号、小数与科学计数法。
    public static bool TryFloat(string s, out double value) {
        return double.TryParse(s, out value);
    }

    private static bool EqualsRangeAsciiIgnoreCase(string s, int start, int len, string lowerLit) {
        if (len != lowerLit.Length) { return false; }
        for (int i = 0; i < len; i = i + 1) {
            int c = s[start + i] & 255;
            if (c >= 65 && c <= 90) { c = c + 32; }
            if (c != (lowerLit[i] & 255)) { return false; }
        }
        return true;
    }

    // 布尔取值：true/1/yes/on 为真，false/0/no/off 为假；其它一律非法。
    public static bool TryBool(string s, out bool value) {
        value = false;
        if (s == null) { return false; }
        int start = 0;
        int end = s.Length;
        while (start < end && (s[start] & 255) <= 32) { start = start + 1; }
        while (end > start && (s[end - 1] & 255) <= 32) { end = end - 1; }
        int len = end - start;
        if (len == 0) { return false; }
        if (len == 1) {
            int c = s[start] & 255;
            if (c == 49) { value = true; return true; }
            if (c == 48) { value = false; return true; }
            return false;
        }
        if (CliValue.EqualsRangeAsciiIgnoreCase(s, start, len, "true")
            || CliValue.EqualsRangeAsciiIgnoreCase(s, start, len, "yes")
            || CliValue.EqualsRangeAsciiIgnoreCase(s, start, len, "on")) {
            value = true;
            return true;
        }
        if (CliValue.EqualsRangeAsciiIgnoreCase(s, start, len, "false")
            || CliValue.EqualsRangeAsciiIgnoreCase(s, start, len, "no")
            || CliValue.EqualsRangeAsciiIgnoreCase(s, start, len, "off")) {
            value = false;
            return true;
        }
        return false;
    }

    // 是否为真（宽松：只认明确为真的写法，其余为假）。
    public static bool IsTrue(string s) {
        bool v;
        if (TryBool(s, out v)) { return v; }
        return false;
    }
}
