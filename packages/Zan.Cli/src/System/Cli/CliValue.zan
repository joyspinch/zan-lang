using System;
using System.Collections.Generic;

namespace System.Cli;

// 命令行取值的严格解析。
//
// 不用 Convert.ToInt32 / Convert.ToDouble：它们是 strtoll / strtod
// 语义（"12abc" 得 12、"abc" 得 0、空串得 0），命令行校验要用它们
// 就等于把 "--count abc" 悄悄当成 0——用户以为自己传了数量，程序
// 当成 0 跑完了。宁可报"expects an integer"，也不要猜。
public class CliValue {
    // 严格的整数解析：整串都是十进制数字（可带正负号）才算合法。
    public static bool TryInt(string s, out int value) {
        value = 0;
        if (s == null) { return false; }
        int len = s.Length;
        if (len == 0) { return false; }
        int pos = 0;
        bool neg = false;
        if (s[0] == '-' || s[0] == '+') {
            neg = s[0] == '-';
            pos = 1;
            if (len == 1) { return false; }
        }
        long acc = 0;
        for (int i = pos; i < len; i = i + 1) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { return false; }
            acc = acc * 10 + (long)(c - 48);
            if (acc > 2147483647) { return false; }
        }
        value = neg ? (int)(0 - acc) : (int)acc;
        return true;
    }

    // 严格的浮点解析：整串都能被 strtod 吃掉（允许前后空白以外的
    // 完整消费）才算合法。
    public static bool TryFloat(string s, out double value) {
        value = 0;
        if (s == null) { return false; }
        int len = s.Length;
        if (len == 0) { return false; }
        int pos = 0;
        if (s[pos] == '-' || s[pos] == '+') { pos = 1; }
        bool digits = false;
        bool dot = false;
        for (int i = pos; i < len; i = i + 1) {
            int c = s[i] & 255;
            if (c >= 48 && c <= 57) { digits = true; continue; }
            if (c == '.' && !dot) { dot = true; continue; }
            if ((c == 'e' || c == 'E') && digits) {
                // 指数部分：可选符号 + 至少一位数字
                int j = i + 1;
                if (j < len && (s[j] == '-' || s[j] == '+')) { j = j + 1; }
                if (j >= len) { return false; }
                bool expDigits = false;
                for (int k = j; k < len; k = k + 1) {
                    int d = s[k] & 255;
                    if (d < 48 || d > 57) { return false; }
                    expDigits = true;
                }
                if (!expDigits) { return false; }
                value = s.ToDouble();
                return true;
            }
            return false;
        }
        if (!digits) { return false; }
        value = s.ToDouble();
        return true;
    }

    // 布尔取值：true/1/yes/on 为真，false/0/no/off 为假；其它一律非法。
    public static bool TryBool(string s, out bool value) {
        value = false;
        if (s == null) { return false; }
        string t = s.Trim().ToLower();
        if (t == "true" || t == "1" || t == "yes" || t == "on") {
            value = true;
            return true;
        }
        if (t == "false" || t == "0" || t == "no" || t == "off") {
            value = false;
            return true;
        }
        return false;
    }

    // 是否为真（宽松：只认明确为真的写法，其余为假）。
    public static bool IsTrue(string s) {
        bool v;
        if (TryBool(s, out v)) { return v; }
        return false;
    }
}
