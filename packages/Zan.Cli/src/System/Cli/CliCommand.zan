using System;
using System.Collections.Generic;

namespace System.Cli;

// 一个命令：名字、别名、描述、选项、子命令、动作。
//
// 命令树靠"子命令"表达：`app db migrate` 里 db 是 migrate 的父命令。
// 父命令自己也可以带选项与动作（既是分组又是可执行命令）。
public class CliCommand {
    public string name;
    // 别名（"mig" 之于 "migrate"）。
    public List<string> aliases;
    public string description;
    // 用法行（不给就按选项自动生成）。
    public string usageText;
    public List<CliOption> options;
    public List<CliCommand> children;
    // 动作（null = 只做分组，执行时打印帮助）。
    public CliAction action;
    // 从根到这个命令的路径（"mytool db migrate"）。
    //
    // 这里存**字符串**而不是父命令指针：父子互指会构成引用环，ARC
    // 收不掉，进程退出时整棵命令树会被报成"仍可达"的泄漏。路径在
    // 挂到父命令时一次性算好，用不着回头找爹。
    public string path;

    internal CliOption[] shortTable;
    internal int shortTableCount;

    public CliCommand(string name) {
        this.name = name == null ? "" : name;
        this.aliases = new List<string>();
        this.description = "";
        this.usageText = "";
        this.options = new List<CliOption>();
        this.children = new List<CliCommand>();
        this.action = null;
        this.path = this.name;
        this.shortTable = null;
        this.shortTableCount = -1;
    }

    // 加一个别名。
    public CliCommand Alias(string a) {
        if (a != null && a.Length > 0) { this.aliases.Add(a); }
        return this;
    }

    // 一句话描述（帮助里显示）。
    public CliCommand Describe(string d) {
        this.description = d == null ? "" : d;
        return this;
    }

    // 自定义用法行。
    public CliCommand Usage(string u) {
        this.usageText = u == null ? "" : u;
        return this;
    }

    // 加一个选项。
    public CliCommand AddOption(CliOption opt) {
        if (opt != null) {
            this.options.Add(opt);
            this.shortTableCount = -1;
        }
        return this;
    }

    private bool ContainsDescendant(CliCommand target, int depth) {
        if (target == null || depth > 128) { return true; }
        for (int i = 0; i < this.children.Count; i = i + 1) {
            CliCommand c = this.children[i];
            if (c == null) { continue; }
            if (c == target) { return true; }
            if (c.ContainsDescendant(target, depth + 1)) { return true; }
        }
        return false;
    }

    // 加一个子命令。
    public CliCommand AddCommand(CliCommand child) {
        if (child == null) { return this; }
        if (child == this || child.ContainsDescendant(this, 0)) {
            throw new InvalidOperationException("CliCommand: cycle detected");
        }
        this.children.Add(child);
        child.path = this.path + " " + child.name;
        // 整棵子树的路径要重算：子命令可能先在自己的父下建好（那时
        // 父还没挂到根上，路径是 "db migrate"），等父挂上去时前缀才变。
        child.RebuildPaths(0);
        return this;
    }

    // 重算自己下面所有子命令的路径。
    void RebuildPaths(int depth) {
        if (depth > 128) { return; }
        for (int i = 0; i < this.children.Count; i = i + 1) {
            CliCommand c = this.children[i];
            if (c == null) { continue; }
            c.path = this.path + " " + c.name;
            c.RebuildPaths(depth + 1);
        }
    }

    // 绑动作。
    public CliCommand On(CliAction fn) {
        this.action = fn;
        return this;
    }

    // 按名字或别名找子命令。
    public CliCommand Find(string nameOrAlias) {
        if (nameOrAlias == null) { return null; }
        int cnt = this.children.Count;
        for (int i = 0; i < cnt; i = i + 1) {
            CliCommand c = this.children[i];
            if (c.name == nameOrAlias) { return c; }
            int ac = c.aliases.Count;
            for (int k = 0; k < ac; k = k + 1) {
                if (c.aliases[k] == nameOrAlias) { return c; }
            }
        }
        return null;
    }

    // 按长名找选项（只找非位置参数）。
    public CliOption FindOption(string name) {
        if (name == null) { return null; }
        int cnt = this.options.Count;
        for (int i = 0; i < cnt; i = i + 1) {
            CliOption o = this.options[i];
            if (!o.positional && o.name == name) { return o; }
        }
        return null;
    }

    internal void EnsureShortTable() {
        int cnt = this.options.Count;
        if (this.shortTable != null && this.shortTableCount == cnt) { return; }
        CliOption[] tbl = this.shortTable;
        if (tbl == null) { tbl = new CliOption[128]; }
        else {
            for (int z = 0; z < 128; z = z + 1) { tbl[z] = null; }
        }
        for (int i = 0; i < cnt; i = i + 1) {
            CliOption o = this.options[i];
            if (!o.positional && o.shortName.Length == 1) {
                int b = o.shortName[0] & 255;
                if (b < 128 && tbl[b] == null) { tbl[b] = o; }
            }
        }
        this.shortTable = tbl;
        this.shortTableCount = cnt;
    }

    // 按短名找选项。
    public CliOption FindShort(string shortName) {
        if (shortName == null || shortName.Length == 0) { return null; }
        if (shortName.Length == 1) {
            int ch = shortName[0] & 255;
            if (ch < 128 && this.options.Count > 0) {
                this.EnsureShortTable();
                CliOption hit = this.shortTable[ch];
                if (hit != null && !hit.positional && hit.shortName.Length == 1
                    && (hit.shortName[0] & 255) == ch) {
                    return hit;
                }
            }
        }
        int cnt = this.options.Count;
        for (int i = 0; i < cnt; i = i + 1) {
            CliOption o = this.options[i];
            if (!o.positional && o.shortName == shortName) { return o; }
        }
        return null;
    }

    // 位置参数（按声明顺序）。
    public List<CliOption> Positionals() {
        List<CliOption> out2 = new List<CliOption>();
        int cnt = this.options.Count;
        for (int i = 0; i < cnt; i = i + 1) {
            if (this.options[i].positional) { out2.Add(this.options[i]); }
        }
        return out2;
    }

    // 从根到这个命令的路径（"app db migrate"）。
    public string Path() {
        return this.path;
    }
}
