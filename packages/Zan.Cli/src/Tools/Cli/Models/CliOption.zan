using System;

namespace Tools.Cli;

// 一个选项或位置参数的声明。
//
// 选项（--name）：命令行里写成 "--name value" 或 "--name=value"；
// 布尔选项写成 "--flag"（等价 true），也可显式 "--flag=false"。
// 短选项（-n）：只给单字母，可与长选项并存。
//
// 位置参数：按出现顺序填入，帮助文本里显示它的名字与类型。
public class CliOption {
    // 长名（"verbose"）；位置参数也用它做键。
    public string name;
    // 短名（"v"）；空串表示没有。
    public string shortName;
    // 帮助文本。
    public string helpText;
    // 值类型（CliType.*）。
    public int type;
    // 是否必填。
    public bool required;
    // 是否位置参数。
    public bool positional;
    // 位置参数是否可重复（收集成一个列表）。
    public bool variadic;
    // 默认值（hasDefault 为真时生效）。
    public string defaultValue;
    public bool hasDefault;

    public CliOption(string name, int type) {
        this.name = name == null ? "" : name;
        this.shortName = "";
        this.helpText = "";
        this.type = type;
        this.required = false;
        this.positional = false;
        this.variadic = false;
        this.defaultValue = "";
        this.hasDefault = false;
    }

    // 绑一个短名（"-v"）。
    public CliOption Short(string s) {
        this.shortName = s == null ? "" : s;
        return this;
    }

    // 帮助文本。
    public CliOption Help(string h) {
        this.helpText = h == null ? "" : h;
        return this;
    }

    // 必填：缺了就报用法错误。
    public CliOption Required() {
        this.required = true;
        return this;
    }

    // 位置参数（按出现顺序填）。
    public CliOption AsPositional() {
        this.positional = true;
        return this;
    }

    // 位置参数可重复（"files a b c"）。
    public CliOption Variadic() {
        this.positional = true;
        this.variadic = true;
        return this;
    }

    // 默认值。
    public CliOption Default(string v) {
        this.defaultValue = v == null ? "" : v;
        this.hasDefault = true;
        return this;
    }
}
