using System;

namespace Tools.Cli;

// 命令行参数的值类型。
public class CliType {
    public const int String = 0;
    public const int Int = 1;
    public const int Float = 2;
    public const int Bool = 3;

    // 类型名（帮助文本里显示）。
    public static string Name(int type) {
        if (type == CliType.Int) { return "int"; }
        if (type == CliType.Float) { return "float"; }
        if (type == CliType.Bool) { return ""; }
        return "string";
    }
}
