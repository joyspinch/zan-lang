using System;
using System.Collections.Generic;

namespace Tools.Cli;

// 命令行取值的严格解析（直接对接系统标准 TryParse 原语）。
public class CliValue {
    // 严格的整数解析：整串都是十进制数字（可带正负号）才算合法。
    public static bool TryInt(string s, out int value) {
        return int.TryParse(s, out value);
    }

    // 严格的浮点解析：支持符号、小数与科学计数法。
    public static bool TryFloat(string s, out double value) {
        return double.TryParse(s, out value);
    }

    // 布尔取值：true/1/yes/on 为真，false/0/no/off 为假；其它一律非法。
    public static bool TryBool(string s, out bool value) {
        value = false;
        if (s == null) { return false; }
        string t = s.Trim();
        if (bool.TryParse(t, out value)) {
            return true;
        }
        string lower = t.ToLower();
        if (lower == "1" || lower == "yes" || lower == "on") {
            value = true;
            return true;
        }
        if (lower == "0" || lower == "no" || lower == "off") {
            value = false;
            return true;
        }
        return false;
    }

    // 是否为真（宽松：只认明确为真的写法，其余为假）。
    public static bool IsTrue(string s) {
        bool v;
        if (TryBool(s, out v)) { return v; }
        return false;
    }
}
