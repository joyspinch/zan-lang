using System;
using System.Text;
using System.Collections.Generic;
using System.Json;

namespace System.Diagnostics;

// 事件渲染：把 LogEvent 变成一行可落盘的文本。
//
// 规范要点（docs/STDLIB_COMPONENT_STANDARDS.md §2.1）：
// JSON 一律走 `JsonValue` 序列化，**禁止手拼字符串**——
// 手拼的转义规则必然漏（控制字符、U+2028、孤立代理项），
// 产出的就不是合法 JSON，下游解析器会在最不该炸的地方炸。
public class LogFormatter {
    // 按格式号渲染一行（含结尾换行）。
    public static string Format(LogEvent e, int fmt) {
        if (fmt == (int)LogFormat.JSON) { return LogFormatter.Json(e); }
        return LogFormatter.Text(e);
    }

    // 文本形态：`时间 [级别] wid [分类] 正文 [=> 作用域…] 键=值 …`
    // 无分类、无作用域、无字段时与历史 `Log.Write` 的输出逐字节一致。
    public static string Text(LogEvent e) {
        StringBuilder sb = new StringBuilder();
        sb.Append(e.timestamp.ToString());
        sb.Append(" [");
        sb.Append(Log.LevelName(e.level));
        sb.Append("] ");
        sb.Append(Convert.ToString(ProcessHost.WorkerId()));
        if (e.category.Length > 0) {
            sb.Append(" [");
            sb.Append(e.category);
            sb.Append("]");
        }
        sb.Append(" ");
        sb.Append(e.message);
        int sn = e.scopes.Count;
        for (int i = 0; i < sn; i = i + 1) {
            sb.Append(" => ");
            sb.Append(e.scopes[i]);
        }
        List<string> keys = e.fields.Keys;
        int n = keys.Count;
        for (int i = 0; i < n; i = i + 1) {
            string v = "";
            if (!e.fields.TryGetValue(keys[i], out v)) { continue; }
            sb.Append(" ");
            sb.Append(keys[i]);
            sb.Append("=");
            sb.Append(v);
        }
        sb.Append("\n");
        return sb.ToString();
    }

    // JSON 形态：time/level/pid/wid/[traceId]/[spanId]/[category]/msg/[scopes]/[fields]
    // 字段顺序即插入顺序（JsonValue 保持对象键序），与历史 JSON 行一致。
    public static string Json(LogEvent e) {
        JsonValue o = JsonValue.NewObject();
        o.PutStr("time", e.timestamp.ToString());
        o.PutStr("level", Log.LevelName(e.level).Trim());
        o.PutInt("pid", ProcessHost.Pid());
        o.PutInt("wid", ProcessHost.WorkerId());
        if (e.traceId.Length > 0) { o.PutStr("traceId", e.traceId); }
        if (e.spanId.Length > 0) { o.PutStr("spanId", e.spanId); }
        if (e.category.Length > 0) { o.PutStr("category", e.category); }
        o.PutStr("msg", e.message);
        int sn = e.scopes.Count;
        if (sn > 0) {
            JsonValue arr = JsonValue.NewArray();
            for (int i = 0; i < sn; i = i + 1) {
                arr.AppendStr(e.scopes[i]);
            }
            o.Set("scopes", arr);
        }
        List<string> keys = e.fields.Keys;
        int n = keys.Count;
        if (n > 0) {
            JsonValue fo = JsonValue.NewObject();
            for (int i = 0; i < n; i = i + 1) {
                string v = "";
                if (!e.fields.TryGetValue(keys[i], out v)) { continue; }
                fo.Set(keys[i], JsonValue.NewStr(v));
            }
            o.Set("fields", fo);
        }
        return o.ToJson() + "\n";
    }
}
