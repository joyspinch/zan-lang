using System;
using System.Collections.Generic;

namespace System.Diagnostics;

// Prometheus 文本 exposition 格式导出器（Prometheus data model 的
// text/plain; version=0.0.4，即 /metrics 端点的标准格式）。
//
// 稀疏核心：Counter/Gauge/Histogram 三种基础类型 + 按标签集的
// 键控索引，覆盖 prometheus-net 与 prometheus-client 各语言库的
// 主干用法（Prometheus 官方 client 亦以此三类为基）。Snapshot()
// 输出规范文本：# HELP/# TYPE 头、带 label 的样本行、histogram
// 的 _bucket{le=...}/_sum/_count 全家。标签值转义（反斜杠、
// 双引号、换行）按规范处理；metric 名与标签名校验只保留
// [a-zA-Z_:][a-zA-Z0-9_:]*（不合法字符在注册时丢弃，防注入
// exposition 流）。
public class Prometheus {
    // counter/gauge/histogram 样本：名字 + 标签集（键控结构，一对
    // List 平行存储标签键值——标签数固定为创建时给定，不是业务记录）。
    public class Sample {
        public string name;
        public List<string> labelKeys;
        public List<string> labelValues;
        public double value;
        // histogram 专用：桶上沿（不含 +Inf；输出时补最后一桶）与计数/和。
        public List<double> bucketEdges;
        public List<long> bucketCounts;
        public long hCount;
        public double hSum;
        // 扁平化零容器调用热路径字段（多单元编译下避免 List<T> 跨单元索引调用）。
        internal Sample familyNext;
        internal int kLen;
        internal string k0;
        internal string k1;
        internal string k2;
        internal string v0;
        internal string v1;
        internal string v2;
        internal string[] fastKeys;
        internal string[] fastVals;
        internal double[] fastEdges;
        internal long[] fastCounts;
        internal string[] fastBucketPrefixes;
        internal bool edgesAscending;
        // 预格式化渲染前缀缓存（注册时构建一次，Snapshot 热路径直接整块拷贝）。
        internal string cachedLabelBrace;
        internal string cachedLabelInner;
        internal string cachedSamplePrefix;
        internal string cachedInfPrefix;
        internal string cachedSumPrefix;
        internal string cachedCountPrefix;
    }

    List<Sample> metrics;
    Dictionary<string, Sample> idx;  // name + '{' + 标签串 -> 样本
    // HELP 文本：metric 名 -> 已规范化（换行转空格）说明（首个注册者生效）。
    Dictionary<string, string> help;
    // TYPE：metric 名 -> "counter"/"gauge"/"histogram"。
    Dictionary<string, string> types;
    // 增量维护的 metric 家族顺序、侵入式链表头尾与预格式头块。
    List<string> familyOrder;
    Dictionary<string, Sample> familyHead;
    Dictionary<string, Sample> familyTail;
    Dictionary<string, int> familyCount;
    Dictionary<string, string> familyHeaders;

    public Prometheus() {
        this.metrics = new List<Sample>();
        this.idx = new Dictionary<string, Sample>();
        this.help = new Dictionary<string, string>();
        this.types = new Dictionary<string, string>();
        this.familyOrder = new List<string>();
        this.familyHead = new Dictionary<string, Sample>();
        this.familyTail = new Dictionary<string, Sample>();
        this.familyCount = new Dictionary<string, int>();
        this.familyHeaders = new Dictionary<string, string>();
    }

    // ---- 名称与标签合法性 ----

    // 统一清洗标识符（allowColon 为 true 时允许 ':'，用于 metric 名；
    // 全串合法时零分配直返原串，含非法字符时单缓冲写出）。
    private static string CleanIdent(string name, bool allowColon) {
        if (name == null) { return ""; }
        int n = name.Length;
        int firstBad = -1;
        for (int i = 0; i < n; i = i + 1) {
            int c = name[i] & 255;
            bool ok = (c >= 97 && c <= 122) || (c >= 65 && c <= 90)
                || c == 95 || (allowColon && c == 58)
                || (i > 0 && c >= 48 && c <= 57);
            if (!ok) { firstBad = i; break; }
        }
        if (firstBad < 0) { return name; }
        byte[] buf = new byte[n];
        nint bp = (nint)buf;
        if (firstBad > 0) {
            NativeMemory.Copy(bp, (nint)name, firstBad);
        }
        int w = firstBad;
        for (int i = firstBad + 1; i < n; i = i + 1) {
            int c = name[i] & 255;
            bool ok = (c >= 97 && c <= 122) || (c >= 65 && c <= 90)
                || c == 95 || (allowColon && c == 58)
                || (w > 0 && c >= 48 && c <= 57);
            if (ok) {
                buf[w] = (byte)c;
                w = w + 1;
            }
        }
        if (w == 0) { return ""; }
        return NativeMemory.GetString(bp, 0, w);
    }

    // metric 名首字符 [a-zA-Z_:]，后续 [a-zA-Z0-9_:]；不合法字符剔除。
    public static string CleanName(string name) {
        return Prometheus.CleanIdent(name, true);
    }

    // 标签名首字符 [a-zA-Z_]，后续 [a-zA-Z0-9_]。
    public static string CleanLabel(string name) {
        return Prometheus.CleanIdent(name, false);
    }

    // 标签值转义：\ " \n 三字符按规范（无特殊字符时零分配直返原串，否则单缓冲写出）。
    public static string EscapeValue(string v) {
        if (v == null) { return ""; }
        int n = v.Length;
        int extra = 0;
        int firstSpec = -1;
        for (int i = 0; i < n; i = i + 1) {
            int c = v[i] & 255;
            if (c == 92 || c == 34 || c == 10) {
                if (firstSpec < 0) { firstSpec = i; }
                extra = extra + 1;
            }
        }
        if (firstSpec < 0) { return v; }
        int total = n + extra;
        byte[] buf = new byte[total];
        nint bp = (nint)buf;
        if (firstSpec > 0) {
            NativeMemory.Copy(bp, (nint)v, firstSpec);
        }
        int w = firstSpec;
        for (int i = firstSpec; i < n; i = i + 1) {
            int c = v[i] & 255;
            if (c == 92) {
                buf[w] = (byte)92; buf[w + 1] = (byte)92; w = w + 2;
            } else if (c == 34) {
                buf[w] = (byte)92; buf[w + 1] = (byte)34; w = w + 2;
            } else if (c == 10) {
                buf[w] = (byte)92; buf[w + 1] = (byte)110; w = w + 2;
            } else {
                buf[w] = (byte)c; w = w + 1;
            }
        }
        return NativeMemory.GetString(bp, 0, total);
    }

    // 数值格式化：整数不带小数点，其余 double.ToString；NaN/Inf
    // 按规范输出 NaN/+Inf/-Inf（NaN: v!=v；无穷: v-v!=0，与
    // JsonValue.NumText 同一判定惯例）。
    public static string FormatValue(double v) {
        if (v != v) { return "NaN"; }
        if (v - v != 0) {
            return v > 0 ? "+Inf" : "-Inf";
        }
        if (v == (long)v && v >= -9007199254740992 && v <= 9007199254740992) {
            return Convert.ToString((long)v);
        }
        return Convert.ToString(v);
    }

    private static string BuildLabelBrace(List<string> keys, List<string> values) {
        if (keys == null || keys.Count == 0) { return ""; }
        int kn = keys.Count;
        int total = 2; // '{' + '}'
        for (int i = 0; i < kn; i = i + 1) {
            if (i > 0) { total = total + 1; } // ','
            string ev = Prometheus.EscapeValue(values[i]);
            total = total + keys[i].Length + 3 + ev.Length; // k="v"
        }
        byte[] buf = new byte[total];
        nint bp = (nint)buf;
        int p = 0;
        buf[p] = (byte)123; p = p + 1;
        for (int i = 0; i < kn; i = i + 1) {
            if (i > 0) { buf[p] = (byte)44; p = p + 1; }
            string k = keys[i];
            if (k.Length > 0) { NativeMemory.Copy(bp + (nint)p, (nint)k, k.Length); p = p + k.Length; }
            buf[p] = (byte)61; buf[p + 1] = (byte)34; p = p + 2;
            string ev = Prometheus.EscapeValue(values[i]);
            if (ev.Length > 0) { NativeMemory.Copy(bp + (nint)p, (nint)ev, ev.Length); p = p + ev.Length; }
            buf[p] = (byte)34; p = p + 1;
        }
        buf[p] = (byte)125;
        return NativeMemory.GetString(bp, 0, total);
    }

    private static string BuildLabelInnerFromBrace(string labelBrace) {
        if (labelBrace.Length == 0) { return "}"; }
        // labelBrace 形如 "{k=\"v\"}" -> 把首字节 '{' 换成 ',' 即 ",k=\"v\"}"。
        int n = labelBrace.Length;
        byte[] buf = new byte[n];
        nint bp = (nint)buf;
        NativeMemory.Copy(bp, (nint)labelBrace, n);
        buf[0] = (byte)44;
        return NativeMemory.GetString(bp, 0, n);
    }

    // ---- 注册与写入 ----

    // 注册 HELP/TYPE（首个注册者生效；同名不同类型忽略后者）。
    void Declare(string name, string type, string helpText) {
        if (!this.types.ContainsKey(name)) {
            this.types.Add(name, type);
            string header = "";
            if (helpText != null && helpText.Length > 0) {
                string cleanHelp = helpText;
                if (NativeMemory.Find((nint)cleanHelp, 0, 92, cleanHelp.Length) >= 0) {
                    cleanHelp = cleanHelp.Replace("\\", "\\\\");
                }
                if (NativeMemory.Find((nint)cleanHelp, 0, 13, cleanHelp.Length) >= 0) {
                    cleanHelp = cleanHelp.Replace("\r", " ");
                }
                if (NativeMemory.Find((nint)cleanHelp, 0, 10, cleanHelp.Length) >= 0) {
                    cleanHelp = cleanHelp.Replace("\n", " ");
                }
                this.help.Add(name, cleanHelp);
                header = "# HELP " + name + " " + cleanHelp + "\n# TYPE " + name + " " + type + "\n";
            } else {
                header = "# TYPE " + name + " " + type + "\n";
            }
            this.familyHeaders[name] = header;
        }
    }

    Sample FindOrCreate(string rawName, string type, string helpText,
                       List<string> labelKeys, List<string> labelValues) {
        if (rawName == null || rawName.Length == 0) { return null; }

        int lkCount = labelKeys != null ? labelKeys.Count : 0;
        int lvCount = labelValues != null ? labelValues.Count : 0;

        // 零分配快路径 1：无标签且已注册。
        if (lkCount == 0) {
            Sample fast = null;
            if (this.idx.TryGetValue(rawName, out fast)) {
                return fast;
            }
        } else {
            // 零分配快路径 2：侵入式链表 + 扁平标量字段比对（循环内零 List<T> 调用）。
            Sample head = null;
            if (this.familyHead.TryGetValue(rawName, out head)) {
                int fc = 0;
                if (this.familyCount.TryGetValue(rawName, out fc) && fc <= 16) {
                    if (lkCount == 1) {
                        string lk0 = labelKeys[0];
                        string lv0 = lvCount > 0 ? labelValues[0] : "";
                        Sample cand = head;
                        while (cand != null) {
                            if (cand.kLen == 1 && cand.v0 == lv0 && cand.k0 == lk0) { return cand; }
                            cand = cand.familyNext;
                        }
                    } else if (lkCount == 2) {
                        string lk0 = labelKeys[0];
                        string lk1 = labelKeys[1];
                        string lv0 = lvCount > 0 ? labelValues[0] : "";
                        string lv1 = lvCount > 1 ? labelValues[1] : "";
                        Sample cand = head;
                        while (cand != null) {
                            if (cand.kLen == 2 && cand.v0 == lv0 && cand.v1 == lv1
                                && cand.k0 == lk0 && cand.k1 == lk1) { return cand; }
                            cand = cand.familyNext;
                        }
                    } else if (lkCount == 3) {
                        string lk0 = labelKeys[0];
                        string lk1 = labelKeys[1];
                        string lk2 = labelKeys[2];
                        string lv0 = lvCount > 0 ? labelValues[0] : "";
                        string lv1 = lvCount > 1 ? labelValues[1] : "";
                        string lv2 = lvCount > 2 ? labelValues[2] : "";
                        Sample cand = head;
                        while (cand != null) {
                            if (cand.kLen == 3 && cand.v1 == lv1 && cand.v0 == lv0 && cand.v2 == lv2
                                && cand.k0 == lk0 && cand.k1 == lk1 && cand.k2 == lk2) { return cand; }
                            cand = cand.familyNext;
                        }
                    } else {
                        Sample cand = head;
                        while (cand != null) {
                            if (cand.kLen == lkCount) {
                                string[] fk = cand.fastKeys;
                                string[] fv = cand.fastVals;
                                bool match = true;
                                for (int i = 0; i < lkCount; i = i + 1) {
                                    string lv = i < lvCount ? labelValues[i] : "";
                                    if (fv[i] != lv || fk[i] != labelKeys[i]) {
                                        match = false;
                                        break;
                                    }
                                }
                                if (match) { return cand; }
                            }
                            cand = cand.familyNext;
                        }
                    }
                }
            }
        }

        // 完整规范化路径（首次注册、高基数或含非法字符的输入）。
        string name = Prometheus.CleanName(rawName);
        if (name.Length == 0) { return null; }
        List<string> ck = new List<string>();
        List<string> cv = new List<string>();
        if (lkCount > 0) {
            for (int i = 0; i < lkCount; i = i + 1) {
                string k = Prometheus.CleanLabel(labelKeys[i]);
                if (k.Length == 0) { continue; }
                ck.Add(k);
                cv.Add(i < lvCount ? labelValues[i] : "");
            }
        }
        string labelBrace = Prometheus.BuildLabelBrace(ck, cv);
        string key = labelBrace.Length == 0 ? name : (name + labelBrace);
        Sample s = null;
        if (!this.idx.TryGetValue(key, out s)) {
            s = new Sample();
            s.name = name;
            s.labelKeys = ck;
            s.labelValues = cv;
            s.value = 0;
            int cn = ck.Count;
            s.kLen = cn;
            if (cn > 0) {
                s.k0 = ck[0]; s.v0 = cv[0];
                if (cn > 1) { s.k1 = ck[1]; s.v1 = cv[1]; }
                if (cn > 2) { s.k2 = ck[2]; s.v2 = cv[2]; }
                string[] fk = new string[cn];
                string[] fv = new string[cn];
                for (int i = 0; i < cn; i = i + 1) {
                    fk[i] = ck[i];
                    fv[i] = cv[i];
                }
                s.fastKeys = fk;
                s.fastVals = fv;
            }
            s.cachedLabelBrace = labelBrace;
            s.cachedLabelInner = Prometheus.BuildLabelInnerFromBrace(labelBrace);
            s.cachedSamplePrefix = key + " ";
            this.metrics.Add(s);
            this.idx.Add(key, s);
            Sample tail = null;
            if (!this.familyTail.TryGetValue(name, out tail)) {
                this.familyHead[name] = s;
                this.familyTail[name] = s;
                this.familyCount[name] = 1;
                this.familyOrder.Add(name);
            } else {
                tail.familyNext = s;
                this.familyTail[name] = s;
                this.familyCount[name] = this.familyCount[name] + 1;
            }
        }
        this.Declare(name, type, helpText);
        return s;
    }

    // 计数器：只增不减（调用方自己维护增量语义）。
    public void CounterInc(string name, string helpText, double delta) {
        this.CounterIncLabeled(name, helpText, delta, null, null);
    }

    public void CounterIncLabeled(string name, string helpText, double delta,
                                  List<string> labelKeys, List<string> labelValues) {
        if (!(delta >= 0.0) || delta != delta) { return; }
        lock (this) {
            Sample s = this.FindOrCreate(name, "counter", helpText, labelKeys, labelValues);
            if (s == null) { return; }
            s.value = s.value + delta;
        }
    }

    // 仪表：直接设值。
    public void GaugeSet(string name, string helpText, double value) {
        this.GaugeSetLabeled(name, helpText, value, null, null);
    }

    public void GaugeSetLabeled(string name, string helpText, double value,
                                List<string> labelKeys, List<string> labelValues) {
        lock (this) {
            Sample s = this.FindOrCreate(name, "gauge", helpText, labelKeys, labelValues);
            if (s == null) { return; }
            s.value = value;
        }
    }

    // 直方图：edges 升序桶上沿（如 10/50/100/500/1000，单位自定）。
    // 观测值落入首个 >= 值的桶；sum/count 同步累计。同一样本重复
    // 调用即累计语义（与 prometheus client 的 Observe 一致）。
    public void HistogramObserve(string name, string helpText, List<double> edges,
                                 List<string> labelKeys, List<string> labelValues,
                                 double v) {
        if (v != v) { return; }
        lock (this) {
            Sample s = this.FindOrCreate(name, "histogram", helpText, labelKeys, labelValues);
            if (s == null) { return; }
            if (s.fastEdges == null) {
                int rawEn = edges != null ? edges.Count : 0;
                List<double> cleanEdges = new List<double>();
                for (int i = 0; i < rawEn; i = i + 1) {
                    double e = edges[i];
                    if (e != e) { continue; }
                    cleanEdges.Add(e);
                }
                int en = cleanEdges.Count;
                s.bucketEdges = new List<double>();
                s.bucketCounts = new List<long>();
                double[] fe = new double[en];
                long[] fc = new long[en];
                string[] fp = new string[en];
                bool asc = true;
                for (int i = 0; i < en; i = i + 1) {
                    double edge = cleanEdges[i];
                    if (i > 0 && edge < fe[i - 1]) { asc = false; }
                    fe[i] = edge;
                    fc[i] = 0L;
                    fp[i] = s.name + "_bucket{le=\"" + Prometheus.FormatValue(edge) + "\"" + s.cachedLabelInner + " ";
                    s.bucketEdges.Add(edge);
                    s.bucketCounts.Add(0);
                }
                s.fastEdges = fe;
                s.fastCounts = fc;
                s.fastBucketPrefixes = fp;
                s.edgesAscending = asc;
                s.cachedInfPrefix = s.name + "_bucket{le=\"+Inf\"" + s.cachedLabelInner + " ";
                s.cachedSumPrefix = s.name + "_sum" + s.cachedLabelBrace + " ";
                s.cachedCountPrefix = s.name + "_count" + s.cachedLabelBrace + " ";
            }
            s.hCount = s.hCount + 1;
            s.hSum = s.hSum + v;
            double[] be = s.fastEdges;
            long[] bc = s.fastCounts;
            int bn = be.Length;
            if (s.edgesAscending) {
                for (int i = bn - 1; i >= 0; i = i - 1) {
                    if (v > be[i]) { break; }
                    bc[i] = bc[i] + 1L;
                }
            } else {
                for (int i = 0; i < bn; i = i + 1) {
                    if (v <= be[i]) {
                        bc[i] = bc[i] + 1L;
                    }
                }
            }
        }
    }

    // ---- 输出缓冲辅助 ----

    private static int WriteLongDec(byte[] buf, int pos, long v) {
        if (v == 0L) {
            buf[pos] = (byte)48;
            return pos + 1;
        }
        if (v < 0L) {
            buf[pos] = (byte)45;
            pos = pos + 1;
            v = -v;
        }
        int start = pos;
        while (v > 0L) {
            long q = v / 10L;
            buf[pos] = (byte)(48 + (int)(v - q * 10L));
            pos = pos + 1;
            v = q;
        }
        int l = start;
        int r = pos - 1;
        while (l < r) {
            byte tmp = buf[l];
            buf[l] = buf[r];
            buf[r] = tmp;
            l = l + 1;
            r = r - 1;
        }
        return pos;
    }

    private static byte[] EnsureCap(byte[] buf, int need, out nint bp) {
        if (need < 0) {
            throw new InvalidOperationException("Prometheus snapshot buffer overflow");
        }
        if (need <= buf.Length) {
            bp = (nint)buf;
            return buf;
        }
        long newCap = (long)buf.Length * 2L;
        if (newCap < 512L) { newCap = 512L; }
        while (newCap < (long)need) {
            newCap = newCap * 2L;
        }
        if (newCap > 2147483591L) {
            if ((long)need > 2147483591L) {
                throw new InvalidOperationException("Prometheus snapshot exceeds max buffer size");
            }
            newCap = 2147483591L;
        }
        byte[] grown = new byte[(int)newCap];
        NativeMemory.Copy((nint)grown, (nint)buf, buf.Length);
        bp = (nint)grown;
        return grown;
    }

    private static int AppendStr(ref byte[] buf, ref nint bp, int pos, string s) {
        int sl = s.Length;
        if (sl == 0) { return pos; }
        if (pos + sl > buf.Length) {
            buf = Prometheus.EnsureCap(buf, pos + sl, out bp);
        }
        NativeMemory.Copy(bp + (nint)pos, (nint)s, sl);
        return pos + sl;
    }

    private static int AppendCountLine(ref byte[] buf, ref nint bp, int pos, string prefix, long count) {
        int pl = prefix.Length;
        if (pos + pl + 24 > buf.Length) {
            buf = Prometheus.EnsureCap(buf, pos + pl + 24, out bp);
        }
        if (pl > 0) {
            NativeMemory.Copy(bp + (nint)pos, (nint)prefix, pl);
            pos = pos + pl;
        }
        if (count >= -9007199254740992L && count <= 9007199254740992L) {
            pos = Prometheus.WriteLongDec(buf, pos, count);
        } else {
            string fs = Prometheus.FormatValue((double)count);
            pos = Prometheus.AppendStr(ref buf, ref bp, pos, fs);
            if (pos + 1 > buf.Length) { buf = Prometheus.EnsureCap(buf, pos + 1, out bp); }
        }
        buf[pos] = (byte)10;
        return pos + 1;
    }

    private static int AppendDoubleLine(ref byte[] buf, ref nint bp, int pos, string prefix, double v) {
        int pl = prefix.Length;
        if (pos + pl + 32 > buf.Length) {
            buf = Prometheus.EnsureCap(buf, pos + pl + 32, out bp);
        }
        if (pl > 0) {
            NativeMemory.Copy(bp + (nint)pos, (nint)prefix, pl);
            pos = pos + pl;
        }
        if (v != v) {
            buf[pos] = (byte)78; buf[pos + 1] = (byte)97; buf[pos + 2] = (byte)78;
            pos = pos + 3;
        } else if (v - v != 0.0) {
            if (v > 0.0) {
                buf[pos] = (byte)43; buf[pos + 1] = (byte)73; buf[pos + 2] = (byte)110; buf[pos + 3] = (byte)102;
            } else {
                buf[pos] = (byte)45; buf[pos + 1] = (byte)73; buf[pos + 2] = (byte)110; buf[pos + 3] = (byte)102;
            }
            pos = pos + 4;
        } else if (v == (double)(long)v && v >= -9007199254740992.0 && v <= 9007199254740992.0) {
            pos = Prometheus.WriteLongDec(buf, pos, (long)v);
        } else {
            string fs = Convert.ToString(v);
            pos = Prometheus.AppendStr(ref buf, ref bp, pos, fs);
            if (pos + 1 > buf.Length) { buf = Prometheus.EnsureCap(buf, pos + 1, out bp); }
        }
        buf[pos] = (byte)10;
        return pos + 1;
    }

    // ---- 输出 ----

    // 生成 text/plain; version=0.0.4 全量文本。输出顺序：按首次注册的
    // metric 家族顺序，同 metric 名的所有样本严格连排（即使交错注册也只
    // 输出一次 # HELP/# TYPE）。直方图 bucketCounts 在 Observe 时已按
    // 累计语义写入，此处直接输出并补 +Inf 桶与 _sum/_count。
    public string Snapshot() {
        lock (this) {
            int fc = this.familyOrder.Count;
            if (fc == 0) { return ""; }
            long initCapL = (long)this.metrics.Count * 256L + (long)fc * 96L;
            if (initCapL < 512L) { initCapL = 512L; }
            if (initCapL > 67108864L) { initCapL = 67108864L; }
            byte[] buf = new byte[(int)initCapL];
            nint bp = (nint)buf;
            int pos = 0;

            for (int f = 0; f < fc; f = f + 1) {
                string fname = this.familyOrder[f];
                string hdr = null;
                if (this.familyHeaders.TryGetValue(fname, out hdr)) {
                    pos = Prometheus.AppendStr(ref buf, ref bp, pos, hdr);
                }
                Sample s = null;
                this.familyHead.TryGetValue(fname, out s);
                while (s != null) {
                    if (s.fastEdges != null) {
                        string[] bps = s.fastBucketPrefixes;
                        long[] bcs = s.fastCounts;
                        int bn = bps.Length;
                        for (int b = 0; b < bn; b = b + 1) {
                            pos = Prometheus.AppendCountLine(ref buf, ref bp, pos, bps[b], bcs[b]);
                        }
                        pos = Prometheus.AppendCountLine(ref buf, ref bp, pos, s.cachedInfPrefix, s.hCount);
                        pos = Prometheus.AppendDoubleLine(ref buf, ref bp, pos, s.cachedSumPrefix, s.hSum);
                        pos = Prometheus.AppendCountLine(ref buf, ref bp, pos, s.cachedCountPrefix, s.hCount);
                    } else {
                        pos = Prometheus.AppendDoubleLine(ref buf, ref bp, pos, s.cachedSamplePrefix, s.value);
                    }
                    s = s.familyNext;
                }
            }
            return NativeMemory.GetString(bp, 0, pos);
        }
    }
}
