using System;
using System.IO;

namespace System.Diagnostics;

/// <summary>
/// 单个进程快照条目。`name` 为不含扩展名的镜像名
/// （Windows）或可执行文件基名（Linux）。`exePath` 与 `memoryBytes`
/// 由 <see cref="ProcessList.ByPid"/> 填充（需要打开句柄，
/// 因此批量接口 <see cref="ProcessList.List"/> 省略它们）。
/// </summary>
class ProcessEntry {
    /// <summary>进程 ID。</summary>
    public int pid;
    /// <summary>不含扩展名的镜像名（Windows）或可执行文件基名（Linux）。</summary>
    public string name;
    /// <summary>可执行文件完整路径；仅 ByPid 填充，其余为 ""。</summary>
    public string exePath;
    /// <summary>父进程 PID。</summary>
    public int parentPid;
    /// <summary>线程数。</summary>
    public int threads;
    /// 工作集（字节）（Windows）/ 常驻集（Linux）。无法读取时
    /// 返回 -1（拒绝访问、僵尸进程、竞态）。
    public long memoryBytes;
}

/// <summary>
/// 进程枚举。Windows 遍历 Toolhelp32 快照；Linux 扫描
/// /proc。两者都为每个进程填充 pid/name/parentPid/threads，并可
/// 解析单个 pid 的可执行文件路径和内存占用。支持全平台（Windows/Linux/macOS 原生适配）。
/// </summary>
class ProcessList {
    /// <summary>所有可见进程的快照（pid、name、parent、
    /// 线程数）。开销低——不逐个进程打开句柄。</summary>
    static List<ProcessEntry> List() {
        #if WINDOWS
        return ProcessList.WinList();
        #elif LINUX
        return ProcessList.LinuxList();
        #elif MACOS
        return ProcessList.MacList();
        #else
        return new List<ProcessEntry>();
        #endif
    }

    /// <summary>名称等于 `name` 的所有进程（不区分大小写，
    /// Windows 上带或不带 .exe 扩展名均可）。没有则返回空列表。</summary>
    static List<ProcessEntry> ByName(string name) {
        List<ProcessEntry> all = ProcessList.List();
        List<ProcessEntry> hits = new List<ProcessEntry>();
        string want = name.ToLower();
        if (ProcessList.EndsWith(want, ".exe")) {
            want = want.Substring(0, want.Length - 4);
        }
        for (int i = 0; i < all.Count; i = i + 1) {
            string n = all[i].name.ToLower();
            if (ProcessList.EndsWith(n, ".exe")) {
                n = n.Substring(0, n.Length - 4);
            }
            if (n == want) { hits.Add(all[i]); }
        }
        return hits;
    }

    /// <summary>单个 pid 的详细信息：额外填充 exePath 与 memoryBytes。进程不存在
    /// （或拒绝访问）时返回 null。</summary>
    static ProcessEntry ByPid(int pid) {
        List<ProcessEntry> all = ProcessList.List();
        for (int i = 0; i < all.Count; i = i + 1) {
            if (all[i].pid == pid) {
                ProcessEntry e = all[i];
                e.exePath = ProcessList.ExePath(pid);
                e.memoryBytes = ProcessList.MemoryUsage(pid);
                return e;
            }
        }
        return null;
    }

    /// <summary>当前进程的 PID；不支持的平台返回 0。</summary>
    static int SelfPid() {
            return AppPath.Pid();
        }

    /// <summary>`pid` 的工作集（Windows）/ 常驻集（Linux），单位为
    /// 字节；不可读时返回 -1。</summary>
    static long MemoryUsage(int pid) {
        #if WINDOWS
        return ProcessList.WinMemory(pid);
        #elif LINUX
        return ProcessList.LinuxMemory(pid);
        #elif MACOS
        return ProcessList.MacMemory(pid);
        #else
        return -1;
        #endif
    }

    /// <summary>进程镜像的完整路径；不可读时返回 ""。</summary>
    static string ExePath(int pid) {
        #if WINDOWS
        return ProcessList.WinExePath(pid);
        #elif LINUX
        return ProcessList.LinuxExePath(pid);
        #elif MACOS
        return ProcessList.MacExePath(pid);
        #else
        return "";
        #endif
    }

    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "CreateToolhelp32Snapshot")]
    static extern nint WinCreateSnapshot(int flags, int pid);

    [DllImport("kernel32", EntryPoint = "Process32FirstW")]
    static extern int WinProcess32FirstW(nint snap, nint entry);

    [DllImport("kernel32", EntryPoint = "Process32NextW")]
    static extern int WinProcess32NextW(nint snap, nint entry);

    [DllImport("kernel32", EntryPoint = "CloseHandle")]
    static extern int WinCloseHandle(nint handle);

    [DllImport("kernel32", EntryPoint = "GetCurrentProcessId")]
    static extern int WinGetCurrentProcessId();

    [DllImport("kernel32", EntryPoint = "OpenProcess")]
    static extern nint WinOpenProcess(int access, int inherit, int pid);

    [DllImport("psapi", EntryPoint = "GetProcessMemoryInfo")]
    static extern int WinGetProcessMemoryInfo(nint proc, nint counters, int cb);

    [DllImport("kernel32", EntryPoint = "QueryFullProcessImageNameW")]
    static extern int WinQueryFullProcessImageNameW(nint proc, int flags,
                                                    nint buf, nint size);

    /// Windows 实现：遍历 Toolhelp32 快照；快照失败返回空列表。
    static List<ProcessEntry> WinList() {
        List<ProcessEntry> list = new List<ProcessEntry>();
        nint snap = ProcessList.WinCreateSnapshot(0x00000002 /*TH32CS_SNAPPROCESS*/, 0);
        if (snap == 0 || snap == (nint)(0 - 1)) { return list; }
        // 核心契约与语义定义。
        // 核心契约与语义定义。
        // exe[260] = 564 字节，对齐到 568——dwSize 必须是
        // 完整对齐后的 sizeof，否则 Process32FirstW 会以
        // ERROR_INVALID_DATA 失败。
        nint entry = NativeMemory.Alloc(568);
        try {
            new Span<int>(entry, 2)[0] = 568;  // dwSize
            bool first = true;
            int ok = 1;
            while (ok != 0) {
                if (first) {
                    ok = ProcessList.WinProcess32FirstW(snap, entry);
                    first = false;
                } else {
                    ok = ProcessList.WinProcess32NextW(snap, entry);
                }
                if (ok == 0) { break; }
                Span<int> w = new Span<int>(entry, 11);
                ProcessEntry e = new ProcessEntry();
                e.pid = w[2];
                e.threads = w[7];
                e.parentPid = w[8];
                e.name = ProcessList.BaseName(Wide.Read(entry + 44));
                list.Add(e);
            }
        } finally {
            NativeMemory.Free(entry);
            ProcessList.WinCloseHandle(snap);
        }
        return list;
    }

    /// Windows 实现：GetProcessMemoryInfo 读取工作集；打不开进程返回 -1。
    static long WinMemory(int pid) {
        nint proc = ProcessList.WinOpenProcess(0x1000 /*PROCESS_QUERY_LIMITED_INFORMATION*/, 0, pid);
        if (proc == 0) { return -1; }
        nint counters = NativeMemory.Alloc(80);
        long mem = -1;
        try {
            int ok = ProcessList.WinGetProcessMemoryInfo(proc, counters, 80);
            if (ok != 0) {
                // 核心契约与语义定义。
                mem = new Span<long>(counters + 8, 9)[1];  // WorkingSetSize @ 16
            }
        } finally {
            NativeMemory.Free(counters);
            ProcessList.WinCloseHandle(proc);
        }
        return mem;
    }

    /// Windows 实现：QueryFullProcessImageNameW；打不开进程返回 ""。
    static string WinExePath(int pid) {
        nint proc = ProcessList.WinOpenProcess(0x1000 /*PROCESS_QUERY_LIMITED_INFORMATION*/, 0, pid);
        if (proc == 0) { return ""; }
        nint buf = NativeMemory.Alloc(512 * 2 + 2);
        nint size = NativeMemory.Alloc(4);
        string s = "";
        try {
            new Span<int>(size, 1)[0] = 512;
            int ok = ProcessList.WinQueryFullProcessImageNameW(proc, 0, buf, size);
            if (ok != 0) { s = Wide.Read(buf); }
        } finally {
            NativeMemory.Free(buf);
            NativeMemory.Free(size);
            ProcessList.WinCloseHandle(proc);
        }
        return s;
    }
    #endif

    #if LINUX
    /// Linux 实现：枚举 /proc 下数字命名的目录。
    static List<ProcessEntry> LinuxList() {
        List<ProcessEntry> list = new List<ProcessEntry>();
        List<string> dirs = Directory.GetDirectories("/proc");
        for (int i = 0; i < dirs.Count; i = i + 1) {
            string d = dirs[i];
            string name = ProcessList.BaseName(d);
            int pid = ProcessList.ParseInt(name);
            if (pid > 0) {
                ProcessEntry e = ProcessList.LinuxEntry(pid);
                if (e != null) { list.Add(e); }
            }
        }
        return list;
    }

    /// 从 /proc/<pid>/stat 组装条目（exePath 不在此填）；读不到时返回 null。
    static ProcessEntry LinuxEntry(int pid) {
        // 系统底层交互与数据流转契约
        // 空格和括号，因此要找到最后一个 ')'。
        string stat = "";
        try {
            stat = File.ReadAllText("/proc/" + Convert.ToString(pid) + "/stat");
        } catch {
            return null;
        }
        int rp = ProcessList.LastIndexOf(stat, ")");
        if (rp < 0) { return null; }
        string rest = stat.Substring(rp + 2, stat.Length - rp - 2);
        // 核心契约与语义定义。
        // （comm 之后从 1 起算）第 4 个字段是 ppid，第 20 个字段是 threads。
        int stateEnd = ProcessList.IndexOf(rest, " ", 0);
        if (stateEnd < 0) { return null; }
        string ppidTok = rest.Substring(stateEnd + 1, ProcessList.TokenLen(rest, stateEnd + 1));
        int ppid = ProcessList.ParseInt(ppidTok);
        int threads = ProcessList.StatField(rest, 19);  // 第 20 个字段（从 1 起算）
        ProcessEntry e = new ProcessEntry();
        e.pid = pid;
        e.name = ProcessList.BaseName(stat.Substring(2, rp - 2));  // comm
        e.parentPid = ppid;
        e.threads = threads;
        e.memoryBytes = -1;
        return e;
    }

    /// `s` 中按空格分隔的令牌的第 `index` 个（从 0 起算）。
    static int StatField(string s, int index) {
        int field = 0;
        int i = 0;
        while (i < s.Length && field < index) {
            int len = ProcessList.TokenLen(s, i);
            if (len == 0) { i = i + 1; continue; }
            field = field + 1;
            i = i + len;
        }
        if (field != index) { return 0; }
        int tlen = ProcessList.TokenLen(s, i);
        if (tlen == 0) { return 0; }
        return ProcessList.ParseInt(s.Substring(i, tlen));
    }

    /// `s` 中从 `from` 起到下一个空格的令牌长度（按字节/单元计）。
    static int TokenLen(string s, int from) {
        int i = from;
        while (i < s.Length && (s[i] & 255) != 32) { i = i + 1; }
        return i - from;
    }

    /// Linux 实现：解析 /proc/<pid>/status 的 VmRSS 行（kB -> 字节）。
    static long LinuxMemory(int pid) {
        string status = "";
        try {
            status = File.ReadAllText("/proc/" + Convert.ToString(pid) + "/status");
        } catch {
            return -1;
        }
        // VmRSS:   12345 kB
        int idx = ProcessList.IndexOf(status, "VmRSS:", 0);
        if (idx < 0) { return -1; }
        int eol = ProcessList.IndexOf(status, "\n", idx);
        if (eol < 0) { eol = status.Length; }
        string line = status.Substring(idx, eol - idx);
        int kbEnd = ProcessList.IndexOf(line, " ", 6);
        if (kbEnd < 0) { return -1; }
        long kb = ProcessList.ParseLong(line.Substring(6, kbEnd - 6).Trim());
        if (kb < 0) { return -1; }
        return kb * 1024;
    }

    /// Linux 实现：取 /proc/<pid>/cmdline 的第一个 NUL 前的 argv[0]。
    static string LinuxExePath(int pid) {
        // cmdline 以 NUL 分隔；argv[0] 在最前。cmdline 为空时
        // 回退到 comm 名称（内核线程、僵尸进程）。
        string cmd = "";
        try {
            cmd = File.ReadAllText("/proc/" + Convert.ToString(pid) + "/cmdline");
        } catch {
            return "";
        }
        if (cmd == "") { return ""; }
        int nul = ProcessList.IndexOf(cmd, "\0", 0);
        if (nul < 0) { return cmd; }
        return cmd.Substring(0, nul);
    }
    #endif

    #if MACOS
    /// macOS 实现：通过 /bin/ps -axo pid,ppid,rss,comm 解析进程列表。
    static List<ProcessEntry> MacList() {
        List<ProcessEntry> list = new List<ProcessEntry>();
        List<string> args = new List<string>();
        args.Add("-axo");
        args.Add("pid,ppid,rss,comm");
        ProcessResult res = Process.CaptureSafe("/bin/ps", args);
        List<string> lines = res.lines;
        for (int i = 1; i < lines.Count; i = i + 1) {
            string line = lines[i].Trim();
            if (line == "") { continue; }
            int s1 = line.IndexOf(" ");
            if (s1 < 0) { continue; }
            string pidStr = line.Substring(0, s1).Trim();
            string rest1 = line.Substring(s1 + 1, line.Length - s1 - 1).Trim();
            int s2 = rest1.IndexOf(" ");
            if (s2 < 0) { continue; }
            string ppidStr = rest1.Substring(0, s2).Trim();
            string rest2 = rest1.Substring(s2 + 1, rest1.Length - s2 - 1).Trim();
            int s3 = rest2.IndexOf(" ");
            if (s3 < 0) { continue; }
            string rssStr = rest2.Substring(0, s3).Trim();
            string comm = rest2.Substring(s3 + 1, rest2.Length - s3 - 1).Trim();

            int pid = ProcessList.ParseInt(pidStr);
            if (pid > 0) {
                ProcessEntry e = new ProcessEntry();
                e.pid = pid;
                e.parentPid = ProcessList.ParseInt(ppidStr);
                long rss = ProcessList.ParseLong(rssStr);
                e.memoryBytes = (rss > 0) ? rss * 1024 : -1;
                e.threads = 1;
                e.name = ProcessList.BaseName(comm);
                list.Add(e);
            }
        }
        return list;
    }

    /// macOS 实现：ps -p <pid> -o rss= 读取常驻集内存（KB -> 字节）。
    static long MacMemory(int pid) {
        List<string> args = new List<string>();
        args.Add("-p");
        args.Add(Convert.ToString(pid));
        args.Add("-o");
        args.Add("rss=");
        ProcessResult res = Process.CaptureSafe("/bin/ps", args);
        if (res.lines.Count > 0) {
            long kb = ProcessList.ParseLong(res.lines[0].Trim());
            if (kb > 0) { return kb * 1024; }
        }
        return -1;
    }

    /// macOS 实现：ps -p <pid> -o comm= 读取进程可执行路径。
    static string MacExePath(int pid) {
        List<string> args = new List<string>();
        args.Add("-p");
        args.Add(Convert.ToString(pid));
        args.Add("-o");
        args.Add("comm=");
        ProcessResult res = Process.CaptureSafe("/bin/ps", args);
        if (res.lines.Count > 0) {
            return res.lines[0].Trim();
        }
        return "";
    }
    #endif

    /// 路径的最后一段（"C:\a\b.exe" -> "b.exe"，"/a/b" -> "b"）。
    static string BaseName(string path) {
        int bs = ProcessList.LastIndexOf(path, "\\");
        int fs = ProcessList.LastIndexOf(path, "/");
        int at = bs;
        if (fs > at) { at = fs; }
        if (at < 0) { return path; }
        return path.Substring(at + 1, path.Length - at - 1);
    }

    /// 从 `from` 起查找 `needle` 的首次出现，找不到返回 -1。
    static int IndexOf(string hay, string needle, int from) {
        if (hay == null || needle == null) { return -1; }
        if (from < 0) { from = 0; }
        if (from > hay.Length) { return -1; }
        return hay.IndexOf(needle, from);
    }

    /// `needle` 在 `hay` 中最后一次出现的下标，找不到返回 -1。
    static int LastIndexOf(string hay, string needle) {
        if (hay == null || needle == null) { return -1; }
        return hay.LastIndexOf(needle);
    }

    /// `s` 是否以 `tail` 结尾（区分大小写）。
    static bool EndsWith(string s, string tail) {
        if (s == null || tail == null) { return false; }
        return s.EndsWith(tail);
    }

    /// 十进制解析为 int；空串/非数字/带符号返回 -1。
    static int ParseInt(string s) {
        if (s == null || s.Length == 0) { return -1; }
        int v = 0;
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (c < 0x30 || c > 0x39) { return -1; }
            v = v * 10 + (c - 0x30);
        }
        return v;
    }

    /// 十进制解析为 long；空串/非数字/带符号返回 -1。
    static long ParseLong(string s) {
        if (s == null || s.Length == 0) { return -1; }
        long v = 0;
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (c < 0x30 || c > 0x39) { return -1; }
            v = v * 10 + (c - 0x30);
        }
        return v;
    }

    /// 取 `ch` 编码后首字节的值（用于判断 ASCII 数字）。
    static int CodeOf(string ch) {
        if (ch == null || ch.Length == 0) { return 0; }
        return ch[0] & 255;
    }
}
