namespace System.Diagnostics;

// 日志落地端：能力层的输出契约。
//
// 约定：
// - `Write` **不得抛出**。日志是诊断旁路，写失败必须自己吞掉并降级，
//   让业务因为"日志盘满了"而 500 是本末倒置（参照 Log.Write 的既有约定）。
// - `Name` 返回稳定标识（"console" / "file" / "memory" …），
//   供 `Log.Sinks()` 自省、诊断输出与配置回显使用。
//
// 层次：本接口属于能力层，门面层（Log / Logger）只认它，
// 不认具体实现——加一个 sink 不该改门面代码。
public interface ILogSink {
    // 写一条事件。实现必须自行处理失败（吞掉异常）。
    void Write(LogEvent e);

    // sink 的稳定标识。
    string Name();
}
