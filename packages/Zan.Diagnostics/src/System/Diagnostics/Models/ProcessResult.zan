using System;

namespace System.Diagnostics;

// 一次已完成的进程捕获：退出码加上按行拆分的
// stdout+stderr。见 <see cref="Process.Capture"/>。
public class ProcessResult {
    // 子进程退出码；经 shell 执行时为 shell 报告的码，
    // 启动失败（Capture 的 POSIX 分支）为 -1。
    public int exitCode;
    // 按行拆分的 stdout+stderr；启动失败时可能为 null。
    public List<string> lines;

    // 构造空结果：退出码 0、无输出行；实际内容由 Capture 填充。
    public ProcessResult() {
        this.exitCode = 0;
        this.lines = null;
    }

    // 命令是否以 0 退出。
    public bool Ok() { return this.exitCode == 0; }

    public int ExitCode() { return this.exitCode; }

    public List<string> Lines() { return this.lines; }

    // 把捕获的各行重新拼成一段文本（以 '\n' 分隔）。
    public string Text() {
        StringBuilder sb = new StringBuilder();
        if (this.lines == null) { return ""; }
        for (int i = 0; i < this.lines.Count; i = i + 1) {
            if (i > 0) { sb.Append("\n"); }
            sb.Append(this.lines[i]);
        }
        return sb.ToString();
    }
}
