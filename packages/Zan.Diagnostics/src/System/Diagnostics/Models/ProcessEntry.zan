using System;

namespace System.Diagnostics;

// 单个进程快照条目。`name` 为不含扩展名的镜像名
// （Windows）或可执行文件基名（Linux）。`exePath` 与 `memoryBytes`
// 由 <see cref="ProcessList.ByPid"/> 填充（需要打开句柄，
// 因此批量接口 <see cref="ProcessList.List"/> 省略它们）。
public class ProcessEntry {
    // 进程 ID。
    public int pid;
    // 不含扩展名的镜像名（Windows）或可执行文件基名（Linux）。
    public string name;
    // 可执行文件完整路径；仅 ByPid 填充，其余为 ""。
    public string exePath;
    // 父进程 PID。
    public int parentPid;
    // 线程数。
    public int threads;
    // 工作集（字节）（Windows）/ 常驻集（Linux）。无法读取时
    // 返回 -1（拒绝访问、僵尸进程、竞态）。
    public long memoryBytes;

    public ProcessEntry() {
        this.pid = 0;
        this.name = "";
        this.exePath = "";
        this.parentPid = 0;
        this.threads = 0;
        this.memoryBytes = 0;
    }
}
