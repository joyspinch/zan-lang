using System;

namespace System.Diagnostics;

// 慢 SQL 排行榜聚合统计项（规范化 SQL 语句、总次数、最大/平均耗时）。
public class SqlAgg {
    public string sql;  // normalized statement
    public long count;  // times executed
    public long totalUs;  // summed elapsed microseconds across executions
    public long maxUs;  // slowest single execution

    // 构造一行以归一化语句为键的聚合，各计数从零开始。
    public SqlAgg(string sql) {
        this.sql = sql;
        this.count = 0;
        this.totalUs = 0;
        this.maxUs = 0;
    }
}
