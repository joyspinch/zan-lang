using System;

namespace System.Diagnostics;

// 服务端异常记录项（时间戳、请求路径与异常描述）。
public class ErrEntry {
    public long ts;
    public string origin;
    public string detail;

    // 构造一条错误记录；`ts` 直接采用调用方传入的 epoch 秒。
    public ErrEntry(long ts, string origin, string detail) {
        this.ts = ts;
        this.origin = origin;
        this.detail = detail;
    }
}
