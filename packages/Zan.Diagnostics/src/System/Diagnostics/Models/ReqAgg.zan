using System;

namespace System.Diagnostics;

public class ReqAgg {
    public string method;  // "GET"
    // 路由模式（"/user/{id}"）或资源路径。
    public string path;  // route pattern ("/user/{id}") or asset path
    public string req;
    public long count;  // times served
    public long totalUs;  // summed elapsed microseconds
    public long maxUs;  // slowest single hit
    public long errors;  // 5xx responses
    public long failed;
    public long rejected;  // 429: refused by a rate limit, not by the handler

    // 构造一行以端点为键的聚合；`req` 字段在此拼成 "METHOD path" 联合形式。
    public ReqAgg(string method, string path) {
        this.method = method;
        this.path = path;
        this.req = method + " " + path;
        this.count = 0;
        this.totalUs = 0;
        this.maxUs = 0;
        this.errors = 0;
        this.failed = 0;
        this.rejected = 0;
    }
}
