using System;
using System.IO;
using System.Text;
using System.Collections.Generic;
using System.Json;

namespace System.Diagnostics;

// 进程级滚动文件日志（历史门面）+ 结构化事件的进程级落地。
//
// 写文件是日志的默认去处：服务跑在后台（worker、守护进程、
// Windows 上没有控制台）时，只写 stdout 等于什么都没记，
// 出事后无从查起。
// 文件名是一个**模式**，每次写入时展开，展开结果变化即为一次滚动：
// {yyyy} 年   {MM} 月   {dd} 日   {HH} 时
// {pid}  进程号        {wid} worker 序号（master 为 0）
// 模式里可以带目录分隔符，缺的目录在写入前自动递归创建，因此默认的
// `"{yyyy}{MM}/{dd}.log"` 会按月分目录、按日分文件（logs/202608/13.log）。
// 例如 `"{yyyy}-{MM}-{dd}.log"` 每天一个文件（平铺），
// `"{yyyy}{MM}/{dd}-{HH}.log"` 按月分目录、每小时一个。
// 另外可设上限字节数，超过就切到 `名字.1`、`名字.2` …（见 MaxFileSize）。
// 同一个文件可以被多个进程共写：每条记录都是「打开→追加→关闭」，
// 不长期持有句柄，所以 master 与全部 worker 写同一个日期文件即可，
// 无需按进程分文件，跨天也能各自滚到新文件。
// 用法：
// <code>
// Log.MaxFileSize(64 * 1024 * 1024);
// </code>
//
// 结构化日志（新增）：`LogHub` 持有落地端注册表与作用域栈，
// `Logger` 是绑定到它的分类日志器：
// <code>
// LogHub hub = LogHub.WithProcessSinks();
// Logger log = hub.Logger("app");
// log.Info("ready", Logger.Fields("port", "8080"));
// hub.Shutdown();
// </code>
// 注册表是**实例级**的，不是静态的：包级 static 持有集合在进程退出时
// 不会被释放（编译器只释放主编译单元的静态字段），集合里的落地端、
// 事件、字段字典会整条留到进程结束。注册表由使用者持有，生命周期
// 跟着使用者走。
//
// 本门面只持有两个落地端实例（console / file），不持有任何集合。
public class Log {
    // 级别常量，供 Configure / Write 使用。
    public static const int TRACE = 0;
    public static const int DEBUG = 1;
    public static const int INFO = 2;
    public static const int WARN = 3;
    public static const int ERROR = 4;
    public static const int FATAL = 5;

    public static string dir = "";
    public static string pattern = "{yyyy}{MM}/{dd}.log";
    public static int minLevel = 2;
    public static int format = 0;
    public static long maxBytes = 0;
    public static bool toConsole = true;
    public static bool enabled = false;
    public static string lastPath = "";

    // 进程级落地端（惰性创建；实例而非集合，退出时可释放）。
    static FileLogSink fileSink;
    static ConsoleLogSink consoleSink;

    // 设置日志输出格式（LogFormat.TEXT 或 LogFormat.JSON）。
    public static void SetFormat(int fmt) { Log.format = fmt; }

    // 获取当前日志格式。
    public static int Format() { return Log.format; }

    // 设置最低日志输出级别。
    public static void SetMinLevel(int level) { Log.minLevel = level; }

    // 启用文件日志：`dir` 目录（不存在则创建），`pattern`
    // 见类说明，`minLevel` 以下的记录被丢弃。
    public static void Configure(string dir, string pattern, int minLevel) {
        Log.dir = dir;
        if (pattern != "") { Log.pattern = pattern; }
        Log.minLevel = minLevel;
        Log.enabled = true;
        if (dir != "" && !Directory.Exists(dir)) {
            Directory.CreateDirectoryRecursive(dir);
        }
    }

    // 是否已经配置过文件日志（调用过 Configure）。库代码用它
    // 判断该不该给出一个默认去处，而不覆盖应用自己选的目录。
    public static bool IsEnabled() { return Log.enabled; }

    // 单个文件的字节上限，超过后滚动到 `名字.1`、`名字.2` …
    // 传 0 关闭按大小滚动（只按文件名模式滚动）。
    public static void MaxFileSize(long bytes) { Log.maxBytes = bytes; }

    // 是否同时写到控制台（默认写）。后台服务应关掉。
    public static void EchoToConsole(bool on) { Log.toConsole = on; }

    // 当前生效的日志文件完整路径。
    public static string CurrentPath() {
        return LogPaths.CurrentPath(Log.dir, Log.pattern);
    }

    // 记录一条 TRACE 级消息。
    public static void Trace(string msg) { Log.Write(Log.TRACE, msg); }
    // 记录一条 DEBUG 级消息。
    public static void Debug(string msg) { Log.Write(Log.DEBUG, msg); }
    // 记录一条 INFO 级消息。
    public static void Info(string msg) { Log.Write(Log.INFO, msg); }
    // 记录一条 WARN 级消息。
    public static void Warn(string msg) { Log.Write(Log.WARN, msg); }
    // 记录一条 ERROR 级消息。
    public static void Error(string msg) { Log.Write(Log.ERROR, msg); }
    // 记录一条 FATAL 级消息。
    public static void Fatal(string msg) { Log.Write(Log.FATAL, msg); }

    // 写一条记录：`时间 [级别] pid/wid 正文`。文件写入失败
    // （目录被删、文件被杀毒/索引器短暂独占）绝不向上抛：日志是诊断
    // 旁路，写不进去只能降级到控制台，拖垮业务流程就是本末倒置
    // （实测：AppendAllText 抛 IOException 曾让服务端目录装载三次
    // 全灭，服务带空目录上线）。失败后清 lastPath，下一条重验目录。
    public static void Write(int level, string msg) {
        if (level < Log.minLevel) { return; }
        LogEvent e = new LogEvent(level, "", msg);
        // 链路注入：当前 Activity 的 trace/span 随记录落地
        // （历史 JSON 形态带 traceId/spanId 字段，保持不变）。
        Activity act = Activity.Current;
        if (act != null) {
            e.traceId = act.traceId;
            e.spanId = act.spanId;
        }
        Log.EmitProcess(e);
    }

    // 进程级落地：控制台（按开关）→ 滚动文件（按开关）。
    // `LogHub` 开了 processSinks 时也走这里。
    public static void EmitProcess(LogEvent e) {
        if (e == null) { return; }
        if (Log.toConsole || !Log.enabled) {
            Log.ConsoleSink().Write(e);
        }
        if (Log.enabled) {
            FileLogSink fs = Log.FileSink();
            fs.dir = Log.dir;
            fs.pattern = Log.pattern;
            fs.maxBytes = Log.maxBytes;
            fs.format = Log.format;
            fs.Write(e);
        }
    }

    // ---- 工具 ---------------------------------------------------------

    // JSON 转义（走 JsonValue 序列化，不手拼转义表）。
    // 返回值是**不含首尾引号**的转义后正文。
    public static string EscapeJson(string str) {
        if (str == null) { return ""; }
        string j = JsonValue.NewStr(str).ToJson();
        if (j.Length >= 2) { return j.Substring(1, j.Length - 2); }
        return j;
    }

    // 把已写满的 `path` 改名为第一个空闲的 `path.N`，返回仍然
    // 可写的原路径。改名失败（文件被占用）时原样返回，宁可让文件超限
    // 也不能丢日志。
    public static string RollBySize(string path) {
        return LogPaths.RollBySize(path);
    }

    // 级别名（INFO/WARN 各补一个空格对齐到 5 字符）；level 越界时
    // 钳到 [TRACE, FATAL]。
    public static string LevelName(int level) {
        if (level < Log.TRACE) { level = Log.TRACE; }
        if (level > Log.FATAL) { level = Log.FATAL; }
        string name = ((LogLevel)level).ToString();
        if (level == Log.INFO || level == Log.WARN) { return name + " "; }
        return name;
    }

    // 建出 `path` 的父目录。模式带目录时（按月分目录）新的一个月
    // 就是一个还不存在的目录，Configure 那次创建管不到它。
    public static void EnsureDirFor(string path) {
        LogPaths.EnsureDirFor(path);
    }

    // 平台路径分隔符。
    public static string Sep() {
        return LogPaths.Sep();
    }

    // 展开文件名模式中的 {yyyy} {MM} {dd} {HH} {pid} {wid}。
    public static string Expand(string pattern, DateTime t) {
        return LogPaths.Expand(pattern, t);
    }

    // 同 <see cref="Expand"/>，但 {wid} 用给定的序号展开：
    // master 要为**即将派生**的 worker 算出文件名，那不是它自己的序号。
    public static string ExpandFor(string pattern, DateTime t, int wid) {
        return LogPaths.ExpandFor(pattern, t, wid);
    }

    // 把 `text` 中所有字面 `from` 替换为 `to`。
    public static string Replace(string text, string from, string to) {
        return LogPaths.Replace(text, from, to);
    }

    // ---- 内部状态 -----------------------------------------------------

    static FileLogSink FileSink() {
        if (Log.fileSink == null) { Log.fileSink = new FileLogSink(); }
        return Log.fileSink;
    }

    static ConsoleLogSink ConsoleSink() {
        if (Log.consoleSink == null) {
            Log.consoleSink = new ConsoleLogSink(Log.format);
        }
        Log.consoleSink.format = Log.format;
        return Log.consoleSink;
    }
}
