using System;

namespace System.Diagnostics;

// 控制台落地端：把事件按当前格式打到 stdout。
// 与历史 `Log.Write` 的控制台行为一致（同一份渲染器，
// 因此控制台与文件里的内容不会分叉）。
public class ConsoleLogSink : ILogSink {
    public int format;

    public ConsoleLogSink(int format) {
        this.format = format;
    }

    public string Name() { return "console"; }

    public void Write(LogEvent e) {
        if (e == null) { return; }
        Console.Write(LogFormatter.Format(e, this.format));
    }
}
