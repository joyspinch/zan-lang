using System;
using System.Collections.Generic;

namespace System.Diagnostics;

// 内存落地端：保留最近 N 条事件。
//
// 用途：自测断言、进程内"日志查看器"面板、崩溃现场快照。
// 超出容量时丢最旧的（环形语义：诊断看的是最近的，不是全部）。
public class MemoryLogSink : LogSink {
    public int capacity;
    List<LogEvent> events;

    public MemoryLogSink() {
        this.capacity = 256;
        this.events = new List<LogEvent>();
    }

    public MemoryLogSink(int capacity) {
        if (capacity < 1) { capacity = 1; }
        this.capacity = capacity;
        this.events = new List<LogEvent>();
    }

    public override string Name() { return "memory"; }

    public override void Write(LogEvent e) {
        if (e == null) { return; }
        this.events.Add(e);
        int n = this.events.Count;
        int over = n - this.capacity;
        if (over > 0) {
            for (int i = 0; i < over; i = i + 1) {
                this.events.RemoveAt(0);
            }
        }
    }

    public int Count() { return this.events.Count; }

    // 第 i 条（0 为最旧）。越界返回 null。
    public LogEvent At(int i) {
        if (i < 0 || i >= this.events.Count) { return null; }
        return this.events[i];
    }

    // 最近一条；没有则返回 null。
    public LogEvent Last() {
        int n = this.events.Count;
        if (n == 0) { return null; }
        return this.events[n - 1];
    }

    public void Clear() { this.events.Clear(); }

    // 正文包含 `text` 的事件条数（自测与查看器的常用检索）。
    public int CountContaining(string text) {
        int hit = 0;
        int n = this.events.Count;
        for (int i = 0; i < n; i = i + 1) {
            if (this.events[i].message.Contains(text)) { hit = hit + 1; }
        }
        return hit;
    }
}

