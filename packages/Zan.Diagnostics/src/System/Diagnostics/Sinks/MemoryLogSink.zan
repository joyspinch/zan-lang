using System;
using System.Collections.Generic;

namespace System.Diagnostics;

// 内存落地端：保留最近 N 条事件。
//
// 用途：自测断言、进程内"日志查看器"面板、崩溃现场快照。
// 超出容量时丢最旧的（环形语义：诊断看的是最近的，不是全部）。
public class MemoryLogSink : LogSink {
    public int capacity;
    LogEvent[] ring;
    int head;
    int count;

    public MemoryLogSink() {
        this.capacity = 256;
        this.ring = new LogEvent[256];
        this.head = 0;
        this.count = 0;
    }

    public MemoryLogSink(int capacity) {
        if (capacity < 1) { capacity = 1; }
        this.capacity = capacity;
        this.ring = new LogEvent[capacity];
        this.head = 0;
        this.count = 0;
    }

    public override string Name() { return "memory"; }

    private void SyncCapacity() {
        int cap = this.capacity < 1 ? 1 : this.capacity;
        if (this.ring != null && this.ring.Length == cap) { return; }
        LogEvent[] next = new LogEvent[cap];
        int keep = this.count < cap ? this.count : cap;
        int skip = this.count - keep;
        int oldCap = this.ring != null ? this.ring.Length : 0;
        for (int i = 0; i < keep; i = i + 1) {
            next[i] = this.ring[(this.head + skip + i) % oldCap];
        }
        this.ring = next;
        this.head = 0;
        this.count = keep;
    }

    public override void Write(LogEvent e) {
        if (e == null) { return; }
        lock (this) {
            this.SyncCapacity();
            int cap = this.ring.Length;
            if (this.count < cap) {
                this.ring[(this.head + this.count) % cap] = e;
                this.count = this.count + 1;
            } else {
                this.ring[this.head] = e;
                this.head = (this.head + 1) % cap;
            }
        }
    }

    public int Count() {
        lock (this) { return this.count; }
    }

    // 第 i 条（0 为最旧）。越界返回 null。
    public LogEvent At(int i) {
        lock (this) {
            if (i < 0 || i >= this.count) { return null; }
            return this.ring[(this.head + i) % this.ring.Length];
        }
    }

    // 最近一条；没有则返回 null。
    public LogEvent Last() {
        lock (this) {
            if (this.count == 0) { return null; }
            return this.ring[(this.head + this.count - 1) % this.ring.Length];
        }
    }

    public void Clear() {
        lock (this) {
            int cap = this.ring != null ? this.ring.Length : 0;
            for (int i = 0; i < this.count; i = i + 1) {
                this.ring[(this.head + i) % cap] = null;
            }
            this.head = 0;
            this.count = 0;
        }
    }

    // 正文包含 `text` 的事件条数（自测与查看器的常用检索）。
    public int CountContaining(string text) {
        lock (this) {
            int hit = 0;
            int cap = this.ring != null ? this.ring.Length : 0;
            for (int i = 0; i < this.count; i = i + 1) {
                if (this.ring[(this.head + i) % cap].message.Contains(text)) { hit = hit + 1; }
            }
            return hit;
        }
    }
}

