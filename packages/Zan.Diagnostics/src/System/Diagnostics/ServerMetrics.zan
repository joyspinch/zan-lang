using System;
using System.Collections.Generic;
using System.IO;
using System.Json;
using System.Threading;

namespace System.Diagnostics;

// 服务端异常捕获沉淀槽：持久化错误记录供管理看板检索。
public delegate void ErrorSink(long ts, string origin, string detail);

// 分片指标桶：每线程哈希到独立分片，消除多核请求/查询热路径上的全局锁争用。
internal class MetricsShard {
    public AtomicInt concurrent;
    public AtomicInt concurrentPeak;
    public int reqCount;
    public int reqErrors;
    public int reqFailed;
    public int reqRejected;
    public int reqUnmatched;
    public long reqTotalUs;
    public long reqMaxUs;
    public List<SlowEntry> slowReqs;

    public int queryCount;
    public long queryTotalUs;
    public long queryMaxUs;
    public List<SlowEntry> slowQueries;

    public List<ReqAgg> routeSlots;
    public List<ReqAgg> reqAgg;
    public Dictionary<string, ReqAgg> reqIdx;
    public List<SqlAgg> sqlAgg;
    public Dictionary<string, SqlAgg> sqlIdx;

    public int seriesCap;
    public long[] sSec;
    public int[] sReq;
    public int[] sErr;
    public long[] sTotalUs;
    public long[] sMaxUs;
    public int[] sQuery;
    public long[] sQueryUs;
    public int[] sHist;

    public MetricsShard(int seriesCap) {
        this.concurrent = new AtomicInt(0);
        this.concurrentPeak = new AtomicInt(0);
        this.reqCount = 0;
        this.reqErrors = 0;
        this.reqFailed = 0;
        this.reqRejected = 0;
        this.reqUnmatched = 0;
        this.reqTotalUs = 0;
        this.reqMaxUs = 0;
        this.slowReqs = new List<SlowEntry>();
        this.queryCount = 0;
        this.queryTotalUs = 0;
        this.queryMaxUs = 0;
        this.slowQueries = new List<SlowEntry>();
        this.routeSlots = new List<ReqAgg>();
        this.reqAgg = new List<ReqAgg>();
        this.reqIdx = new Dictionary<string, ReqAgg>();
        this.sqlAgg = new List<SqlAgg>();
        this.sqlIdx = new Dictionary<string, SqlAgg>();
        this.seriesCap = seriesCap;
        this.sSec = new long[seriesCap];
        this.sReq = new int[seriesCap];
        this.sErr = new int[seriesCap];
        this.sTotalUs = new long[seriesCap];
        this.sMaxUs = new long[seriesCap];
        this.sQuery = new int[seriesCap];
        this.sQueryUs = new long[seriesCap];
        this.sHist = new int[seriesCap * ServerMetrics.HIST_BINS];
        for (int i = 0; i < seriesCap; i = i + 1) { this.sSec[i] = 0 - 1; }
    }

    public int SeriesSlot(long sec) {
        int idx = (int)(sec % (long)this.seriesCap);
        if (this.sSec[idx] == sec) { return idx; }
        this.sSec[idx] = sec;
        this.sReq[idx] = 0;
        this.sErr[idx] = 0;
        this.sTotalUs[idx] = 0;
        this.sMaxUs[idx] = 0;
        this.sQuery[idx] = 0;
        this.sQueryUs[idx] = 0;
        int hbase = idx * ServerMetrics.HIST_BINS;
        for (int b = 0; b < ServerMetrics.HIST_BINS; b = b + 1) {
            this.sHist[hbase + b] = 0;
        }
        return idx;
    }

    public void CountRequest(long sec, int status, long us) {
        this.reqCount = this.reqCount + 1;
        this.reqTotalUs = this.reqTotalUs + us;
        if (us > this.reqMaxUs) { this.reqMaxUs = us; }
        if (status >= 500) { this.reqErrors = this.reqErrors + 1; }
        if (status >= 400) { this.reqFailed = this.reqFailed + 1; }
        if (status == 429) { this.reqRejected = this.reqRejected + 1; }

        int idx = this.SeriesSlot(sec);
        this.sReq[idx] = this.sReq[idx] + 1;
        this.sTotalUs[idx] = this.sTotalUs[idx] + us;
        if (us > this.sMaxUs[idx]) { this.sMaxUs[idx] = us; }
        if (status >= 500) { this.sErr[idx] = this.sErr[idx] + 1; }
        int hb = idx * ServerMetrics.HIST_BINS + ServerMetrics.HistBin(us);
        this.sHist[hb] = this.sHist[hb] + 1;
    }

    public void FoldEndpoint(int slot, string method, string path, long us, int status, int reqAggCap) {
        ReqAgg a = null;
        if (slot >= 0) {
            while (this.routeSlots.Count <= slot) { this.routeSlots.Add(null); }
            a = this.routeSlots[slot];
            if (a == null) {
                a = new ReqAgg(method, path);
                this.routeSlots[slot] = a;
                this.AddAgg(a);
            }
        } else {
            string key = method + " " + path;
            if (!this.reqIdx.TryGetValue(key, out a)) {
                if (this.reqAgg.Count >= reqAggCap) { return; }
                a = new ReqAgg(method, path);
                this.AddAgg(a);
            }
        }
        a.count = a.count + 1;
        a.totalUs = a.totalUs + us;
        if (us > a.maxUs) { a.maxUs = us; }
        if (status >= 500) { a.errors = a.errors + 1; }
        if (status >= 400) { a.failed = a.failed + 1; }
        if (status == 429) { a.rejected = a.rejected + 1; }
    }

    void AddAgg(ReqAgg a) {
        this.reqAgg.Add(a);
        string key = a.method + " " + a.path;
        if (!this.reqIdx.ContainsKey(key)) { this.reqIdx.Add(key, a); }
    }

    public void RecordQuery(long sec, string norm, long us, int sqlAggCap, int slowQueryMs, int ringCap) {
        this.queryCount = this.queryCount + 1;
        this.queryTotalUs = this.queryTotalUs + us;
        if (us > this.queryMaxUs) { this.queryMaxUs = us; }

        int idx = this.SeriesSlot(sec);
        this.sQuery[idx] = this.sQuery[idx] + 1;
        this.sQueryUs[idx] = this.sQueryUs[idx] + us;

        SqlAgg a = null;
        if (!this.sqlIdx.TryGetValue(norm, out a)) {
            if (this.sqlAgg.Count < sqlAggCap) {
                a = new SqlAgg(norm);
                this.sqlAgg.Add(a);
                this.sqlIdx.Add(norm, a);
            }
        }
        if (a != null) {
            a.count = a.count + 1;
            a.totalUs = a.totalUs + us;
            if (us > a.maxUs) { a.maxUs = us; }
        }

        if (us >= (long)slowQueryMs * 1000) {
            this.slowQueries.Add(new SlowEntry(norm, us));
            if (this.slowQueries.Count > ringCap) {
                this.slowQueries.RemoveAt(0);
            }
        }
    }
}

// 进程内服务器指标聚合器（单例经 Global()）：请求/查询吞吐与延迟、
// 慢操作环形缓冲、每秒序列，以及 /admin/stats 形状的 JSON 快照。
public class ServerMetrics {
    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "GetTickCount64")]
    private static extern long GetTickCount64();
    [DllImport("kernel32", EntryPoint = "GetCurrentProcess")]
    private static extern nint GetCurrentProcess();
    [DllImport("kernel32", EntryPoint = "GetProcessTimes")]
    private static extern int GetProcessTimes(nint h, string cre, string ex, string kern, string usr);
    [DllImport("psapi", EntryPoint = "GetProcessMemoryInfo")]
    private static extern int GetProcessMemoryInfo(nint h, string counters, int cb);
    #else
    [DllImport("crt", EntryPoint = "gettimeofday")]
    private static extern int gettimeofday(string tv, nint tz);
    #endif
    #if MACOS
    // libSystem: struct rusage (user/system CPU) and proc_pid_rusage
    // (rusage_info_v0.ri_resident_size -- the current resident set).
    [DllImport("crt", EntryPoint = "getrusage")]
    private static extern int getrusage(int who, string usage);
    [DllImport("crt", EntryPoint = "getpid")]
    private static extern int getpid();
    [DllImport("crt", EntryPoint = "proc_pid_rusage")]
    private static extern int proc_pid_rusage(int pid, int flavor, string buffer);
    #endif

    [DllImport("crt")]
    private static extern nint fopen(string path, string mode);
    [DllImport("crt")]
    private static extern long fwrite(string buf, long size, long count, nint fp);
    [DllImport("crt")]
    private static extern int fclose(nint fp);

    [DllImport("crt", EntryPoint = "zan_monotonic_us")]
    private static extern long NativeMonotonicUs();

    private static const int SHARD_COUNT = 32;

    int slowReqMs;  // slow-request threshold, configured in ms
    int slowQueryMs;  // slow-query threshold, configured in ms
    int sqlAggCap;  // distinct statement shapes kept
    int reqAggCap;  // distinct endpoints kept
    MetricsShard[] shards;

    List<ErrEntry> errors;
    int errCap;  // entries kept in memory
    AtomicInt errTotal;  // errors seen since start
    object errLock;
    // 错误追加写入的日志文件路径（"" = 不写文件）。
    string errLogPath;  // append-only sink ("" disables the file)
    // 调试模式下错误同时回显到 stdout。
    bool errDebug;  // also echo to stdout (debug mode only)

    long startMillis;
    long lastWallMs;  // for CPU% delta sampling
    long lastCpuMs;
    long lastCpuPct;  // last percentage measured over a real window
    int ringCap;

    int seriesCap;
    long[] sSampleSec;
    // 该秒的进程 CPU%（-1 = 未知）。
    int[] sCpu;  // process CPU% at that second (-1 unknown)
    // 该秒的常驻内存字节数（-1 = 未知）。
    long[] sRss;  // resident bytes at that second (-1 unknown)
    long seriesLastWall;
    long seriesLastCpu;  // from the snapshot's own delta state
    AtomicInt lastSampledSec;
    object sampleLock;
    object snapshotLock;

    // 每个请求进出各改一次：原子计数，不进 lock(this)。
    AtomicInt concurrent;
    AtomicInt concurrentPeak;
    AtomicInt streams;
    AtomicInt streamFrames;
    AtomicInt streamBytes;

    ErrorSink errSink;

    // 私有构造：唯一入口是 Global()。各计数、分片桶、环形缓冲与每秒序列在此初始化。
    ServerMetrics() {
        this.slowReqMs = 500;
        this.slowQueryMs = 200;
        this.sqlAggCap = 200;
        this.reqAggCap = 200;
        this.errors = new List<ErrEntry>();
        this.errCap = 100;
        this.errTotal = new AtomicInt(0);
        this.errLock = new object();
        this.errLogPath = "logs/error.log";
        this.errDebug = false;
        this.startMillis = ServerMetrics.MonoMillis();
        this.lastWallMs = this.startMillis;
        this.lastCpuMs = 0;
        this.lastCpuPct = 0 - 1;
        this.ringCap = 32;

        this.seriesCap = 300;  // five minutes of one-second buckets
        this.shards = new MetricsShard[ServerMetrics.SHARD_COUNT];
        for (int i = 0; i < ServerMetrics.SHARD_COUNT; i = i + 1) {
            this.shards[i] = new MetricsShard(this.seriesCap);
        }
        this.sSampleSec = new long[this.seriesCap];
        this.sCpu = new int[this.seriesCap];
        this.sRss = new long[this.seriesCap];
        for (int i = 0; i < this.seriesCap; i = i + 1) {
            this.sSampleSec[i] = 0 - 1;
            this.sCpu[i] = 0 - 1;
            this.sRss[i] = 0 - 1;
        }
        this.seriesLastWall = this.startMillis;
        this.seriesLastCpu = 0;
        this.lastSampledSec = new AtomicInt(0 - 1);
        this.sampleLock = new object();
        this.snapshotLock = new object();
        this.concurrent = new AtomicInt(0);
        this.concurrentPeak = new AtomicInt(0);
        this.streams = new AtomicInt(0);
        this.streamFrames = new AtomicInt(0);
        this.streamBytes = new AtomicInt(0);
        this.errSink = null;
    }

    private int ShardIndex() {
        long tid = Thread.CurrentId();
        long h = (tid ^ (tid >> 4) ^ (tid >> 8)) * 2654435761L;
        return (int)(h & 31);
    }

    private MetricsShard Shard() {
        return this.shards[this.ShardIndex()];
    }

    // 分片进入/离开并发计数：返回进入时命中的分片下标，离开时按原下标递减，
    // 既消除多核全局原子争用，又保证协程跨线程迁移时加减严格配对不漂移。
    public int EnterShard() {
        int idx = this.ShardIndex();
        MetricsShard shard = this.shards[idx];
        long cur = shard.concurrent.Increment();
        long peak = shard.concurrentPeak.Load();
        while (cur > peak) {
            long prev = shard.concurrentPeak.CompareExchange(peak, cur);
            if (prev == peak) { break; }
            peak = prev;
        }
        return idx;
    }

    public void LeaveShard(int shardIdx) {
        if (shardIdx < 0 || shardIdx >= ServerMetrics.SHARD_COUNT) { return; }
        long _rem = this.shards[shardIdx].concurrent.Decrement();
    }

    public void Entered() {
        long cur = this.concurrent.Increment();
        long peak = this.concurrentPeak.Load();
        while (cur > peak) {
            long prev = this.concurrentPeak.CompareExchange(peak, cur);
            if (prev == peak) { break; }
            peak = prev;
        }
    }

    // 一次请求离开，与 Entered() 配对；计数不会减到零以下。
    public void Left() {
        long cur = this.concurrent.Load();
        while (cur > 0) {
            long seen = this.concurrent.CompareExchange(cur, cur - 1);
            if (seen == cur) { break; }
            cur = seen;
        }
    }

    public void StreamOpened() {
        long _s = this.streams.Increment();
    }

    // 一条长连接关闭，`frames`/`bytes` 为其存续期内的累计推送量，并入总量。
    public void StreamClosed(long frames, long bytes) {
        long cur = this.streams.Load();
        while (cur > 0) {
            long prev = this.streams.CompareExchange(cur, cur - 1);
            if (prev == cur) { break; }
            cur = prev;
        }
        long _f = this.streamFrames.Add(frames);
        long _b = this.streamBytes.Add(bytes);
    }

    public static const int HIST_BINS = 13;
    // 桶 `bin` 的上沿（微秒）；最后一桶为 long 最大值，兜住其余一切。
    public static long HistEdge(int bin) {
        if (bin == 0) { return 100; }
        if (bin == 1) { return 250; }
        if (bin == 2) { return 500; }
        if (bin == 3) { return 1000; }
        if (bin == 4) { return 2500; }
        if (bin == 5) { return 5000; }
        if (bin == 6) { return 10000; }
        if (bin == 7) { return 25000; }
        if (bin == 8) { return 50000; }
        if (bin == 9) { return 100000; }
        if (bin == 10) { return 500000; }
        if (bin == 11) { return 2000000; }
        return 9223372036854775807;
    }

    // `us` 落入的直方图桶下标（0 起）；超过所有上沿落在最后一桶。
    public static int HistBin(long us) {
        if (us <= 10000) {
            if (us <= 1000) {
                if (us <= 250) { return us <= 100 ? 0 : 1; }
                return us <= 500 ? 2 : 3;
            }
            if (us <= 5000) { return us <= 2500 ? 4 : 5; }
            return 6;
        }
        if (us <= 100000) {
            if (us <= 50000) { return us <= 25000 ? 7 : 8; }
            return 9;
        }
        if (us <= 500000) { return 10; }
        if (us <= 2000000) { return 11; }
        return 12;
    }

    private void SampleSeriesSecondIfNeeded(long sec) {
        long prev = this.lastSampledSec.Load();
        if (prev == sec) { return; }
        if (this.lastSampledSec.CompareExchange(prev, sec) != prev) { return; }
        int idx = (int)(sec % (long)this.seriesCap);
        long rss = ServerMetrics.MemoryRssBytes();
        long cpuMs = ServerMetrics.CpuMillis();
        lock (this.sampleLock) {
            this.sSampleSec[idx] = sec;
            this.sRss[idx] = rss;
            this.sCpu[idx] = 0 - 1;
            long nowWall = sec * 1000;
            if (cpuMs >= 0) {
                long dWall = nowWall - this.seriesLastWall;
                long dCpu = cpuMs - this.seriesLastCpu;
                if (dWall > 0 && dCpu >= 0) {
                    this.sCpu[idx] = (int)((dCpu * 100) / dWall);
                }
                this.seriesLastWall = nowWall;
                this.seriesLastCpu = cpuMs;
            }
        }
    }

    static ServerMetrics inst;
    static byte[] monoBuf;
    // 进程级共享单例；首次调用时构造，此后所有请求共用一份。
    public static ServerMetrics Global() {
        if (inst == null) { inst = new ServerMetrics(); }
        return inst;
    }

    // 设置慢请求阈值（毫秒）；返回自身以便链式配置。
    public ServerMetrics SlowRequestMs(int ms) { this.slowReqMs = ms; return this; }
    // 设置慢查询阈值（毫秒）；返回自身以便链式配置。
    public ServerMetrics SlowQueryMs(int ms) { this.slowQueryMs = ms; return this; }

    // forever.
    public ServerMetrics ErrorLog(string path, bool debugConsole) {
        this.errLogPath = path;
        this.errDebug = debugConsole;
        if (path.Length > 0) {
            Log.EnsureDirFor(Log.Expand(path, DateTime.Now()));
        }
        return this;
    }
    // 打开/关闭错误同时回显到 stdout；返回自身以便链式配置。
    public ServerMetrics DebugConsole(bool on) { this.errDebug = on; return this; }
    // 当前是否把错误回显到 stdout。
    public bool DebugConsoleOn() { return this.errDebug; }

    // 向错误日志追加一行并在 close 时落盘，进程随即崩溃记录也能存活。
    // 错误罕见，不在任何热路径上；请求路径不碰磁盘。
    private void AppendErrLine(string line) {
        if (this.errLogPath.Length == 0) { return; }
        string path = Log.Expand(this.errLogPath, DateTime.Now());
        Log.EnsureDirFor(path);
        nint fp = fopen(path, "ab");
        if (fp == 0) { return; }
        long _w = fwrite(line, 1, line.Length, fp);
        int _c = fclose(fp);
    }

    public void RecordError(long ts, string origin, string detail) {
        long _et = this.errTotal.Increment();
        lock (this.errLock) {
            this.errors.Add(new ErrEntry(ts, origin, detail));
            while (this.errors.Count > this.errCap) { this.errors.RemoveAt(0); }
        }
        if (this.errSink != null) { this.errSink(ts, origin, detail); }
        this.AppendErrLine("[" + DateTime.FromUnixSeconds(ts).ToString() + "] "
            + origin + " | " + detail + "\n");
        if (this.errDebug) {
            Console.WriteLine("[error] " + origin + " | " + detail);
        }
    }

    public ServerMetrics OnError(ErrorSink fn) { this.errSink = fn; return this; }

    // 启动以来记录的错误总数（含已滚出内存 ring 的条目）。
    public long ErrorTotal() { return this.errTotal.Load(); }

    public List<ServerErrorDoc> RecentErrors(int limit) {
        List<ServerErrorDoc> outp = new List<ServerErrorDoc>();
        lock (this.errLock) {
            int n = this.errors.Count;
            for (int i = n - 1; i >= 0 && outp.Count < limit; i = i - 1) {
                ErrEntry e = this.errors[i];
                ServerErrorDoc d = new ServerErrorDoc();
                d.ts = e.ts;
                d.origin = e.origin;
                d.detail = e.detail;
                outp.Add(d);
            }
        }
        return outp;
    }

    // ---- OS probes ----

    // 从 `buf` 的 `off` 起按小端读 `n` 字节为无符号整数（探针缓冲区用）。
    private static long LeInt(byte[] buf, int off, int n) {
        long v = 0;
        long mul = 1;
        for (int k = 0; k < n; k = k + 1) {
            v = v + (buf[off + k] & 255) * mul;
            mul = mul * 256;
        }
        return v;
    }

    public static long MonoMicros() {
        return NativeMonotonicUs();
    }

    public static long MonoMillis() {
        #if WINDOWS
        return GetTickCount64();
        #else
        if (monoBuf == null) { monoBuf = new byte[16]; }
        byte[] tv = monoBuf;
        int r = gettimeofday(tv, 0);
        long sec = ServerMetrics.LeInt(tv, 0, 8);
        long usec = ServerMetrics.LeInt(tv, 8, 8);
        return sec * 1000 + usec / 1000;
        #endif
    }

    public static long CpuMillis() {
        #if WINDOWS
        nint h = GetCurrentProcess();
        byte[] cre = new byte[8];
        byte[] ex = new byte[8];
        byte[] kern = new byte[8];
        byte[] usr = new byte[8];
        int ok = GetProcessTimes(h, cre, ex, kern, usr);
        long k = ServerMetrics.LeInt(kern, 0, 8);
        long u = ServerMetrics.LeInt(usr, 0, 8);
        if (ok == 0) { return 0 - 1; }
        return (k + u) / 10000;  // 100ns units -> ms
        #elif LINUX
        if (!File.Exists("/proc/self/stat")) { return 0 - 1; }
        string s = File.ReadAllText("/proc/self/stat");
        int rp = ServerMetrics.LastIndexOf(s, ")");
        if (rp < 0) { return 0 - 1; }
        string rest = s.Substring(rp + 2, s.Length - (rp + 2));
        List<string> f = ServerMetrics.SplitWs(rest);
        if (f.Count < 13) { return 0 - 1; }
        long utime = Convert.ToInt64(f[11]);
        long stime = Convert.ToInt64(f[12]);
        return (utime + stime) * 10;  // assumes 100 Hz USER_HZ -> *1000/100
        #elif MACOS
        // struct rusage: ru_utime and ru_stime are timevals (i64 seconds,
        // i32 microseconds + padding on Darwin)
        byte[] ru = new byte[144];
        if (getrusage(0, ru) != 0) { return 0 - 1; }
        long us = ServerMetrics.LeInt(ru, 0, 8) * 1000000 + ServerMetrics.LeInt(ru, 8, 4)
            + ServerMetrics.LeInt(ru, 16, 8) * 1000000 + ServerMetrics.LeInt(ru, 24, 4);
        return us / 1000;
        #else
        return 0 - 1;
        #endif
    }

    public static long MemoryRssBytes() {
        #if WINDOWS
        nint h = GetCurrentProcess();
        byte[] c = new byte[72];
        int ok = GetProcessMemoryInfo(h, c, 72);
        long rss = ServerMetrics.LeInt(c, 16, 8);  // WorkingSetSize
        if (ok == 0) { return 0 - 1; }
        return rss;
        #elif LINUX
        if (!File.Exists("/proc/self/statm")) { return 0 - 1; }
        string s = File.ReadAllText("/proc/self/statm");
        List<string> f = ServerMetrics.SplitWs(s);
        if (f.Count < 2) { return 0 - 1; }
        long residentPages = Convert.ToInt64(f[1]);
        return residentPages * 4096;
        #elif MACOS
        // rusage_info_v0: uuid[16], then u64 user/system time, pkg idle and
        // interrupt wakeups, pageins, wired size, resident size (offset 64)
        byte[] info = new byte[256];
        if (proc_pid_rusage(getpid(), 0, info) != 0) { return 0 - 1; }
        return ServerMetrics.LeInt(info, 64, 8);
        #else
        return 0 - 1;
        #endif
    }

    // 字符 `ch` 在 `s` 中最后一次出现的下标，找不到返回 -1。
    private static int LastIndexOf(string s, string ch) {
        if (s == null || ch == null) { return 0 - 1; }
        return s.LastIndexOf(ch);
    }

    // 按空白（空格/制表/换行）拆分 `s`，连续空白算一个分隔，不产生空段。
    private static List<string> SplitWs(string s) {
        List<string> parts = new List<string>();
        if (s == null) { return parts; }
        int n = s.Length;
        int start = 0;
        bool inToken = false;
        for (int i = 0; i < n; i = i + 1) {
            int c = s[i] & 255;
            if (c == 32 || c == 9 || c == 10 || c == 13) {
                if (inToken) {
                    parts.Add(s.Substring(start, i - start));
                    inToken = false;
                }
            } else {
                if (!inToken) {
                    start = i;
                    inToken = true;
                }
            }
        }
        if (inToken) {
            parts.Add(s.Substring(start, n - start));
        }
        return parts;
    }

    // ---- recording ----

    void RecordRoute(int slot, string method, string pattern, int status, long us) {
        this.RecordRouteAt(slot, method, pattern, status, us, ServerMetrics.MonoMillis() / 1000);
    }

    public void RecordRouteAt(int slot, string method, string pattern, int status, long us, long sec) {
        this.SampleSeriesSecondIfNeeded(sec);
        MetricsShard shard = this.Shard();
        lock (shard) {
            shard.CountRequest(sec, status, us);
            shard.FoldEndpoint(slot, method, pattern, us, status, this.reqAggCap);
            if (us >= (long)this.slowReqMs * 1000) {
                shard.slowReqs.Add(new SlowEntry(method + " " + pattern + " -> "
                    + Convert.ToString(status), us));
                if (shard.slowReqs.Count > this.ringCap) {
                    shard.slowReqs.RemoveAt(0);
                }
            }
        }
    }

    void RecordUnmatched(int status, long us) {
        this.RecordUnmatchedAt(status, us, ServerMetrics.MonoMillis() / 1000);
    }

    public void RecordUnmatchedAt(int status, long us, long sec) {
        this.SampleSeriesSecondIfNeeded(sec);
        MetricsShard shard = this.Shard();
        lock (shard) {
            shard.reqUnmatched = shard.reqUnmatched + 1;
            shard.CountRequest(sec, status, us);
        }
    }

    // normalization at all.
    public void RecordRequest(string method, string path, int status, long us) {
        string folded = ServerMetrics.FoldPath(path);
        long sec = ServerMetrics.MonoMillis() / 1000;
        this.SampleSeriesSecondIfNeeded(sec);
        MetricsShard shard = this.Shard();
        lock (shard) {
            shard.CountRequest(sec, status, us);
            shard.FoldEndpoint(0 - 1, method, folded, us, status, this.reqAggCap);
            if (us >= (long)this.slowReqMs * 1000) {
                shard.slowReqs.Add(new SlowEntry(method + " " + path + " -> " + Convert.ToString(status), us));
                if (shard.slowReqs.Count > this.ringCap) {
                    shard.slowReqs.RemoveAt(0);
                }
            }
        }
    }

    private static bool IsAllDigits(string s) {
        return ServerMetrics.RangeIsDigits(s, 0, s.Length);
    }

    private static bool RangeIsDigits(string s, int start, int end) {
        if (end <= start) { return false; }
        for (int i = start; i < end; i = i + 1) {
            int c = s[i];
            if (c < 48 || c > 57) { return false; }
        }
        return true;
    }

    private static string NormalizePath(string method, string path) {
        return method + " " + ServerMetrics.FoldPath(path);
    }

    private static string FoldPath(string path) {
        int n = path.Length;
        int q = 0;
        while (q < n && path[q] != '?') { q = q + 1; }
        StringBuilder outp = new StringBuilder();
        int i = 0;
        bool first = true;
        while (true) {
            int st = i;
            while (i < q && path[i] != '/') { i = i + 1; }
            if (!first) { outp.Append("/"); }
            first = false;
            if (ServerMetrics.RangeIsDigits(path, st, i)) { outp.Append(":id"); }
            else if (i > st) { outp.Append(path.Substring(st, i - st)); }
            if (i >= q) { break; }
            i = i + 1;
        }
        return outp.ToString();
    }

    void RecordQuery(string sql, long us) {
        string norm = ServerMetrics.NormalizeSql(sql);
        if (norm.Length > 400) { norm = norm.Substring(0, 400); }
        long sec = ServerMetrics.MonoMicros() / 1000000;
        this.SampleSeriesSecondIfNeeded(sec);
        MetricsShard shard = this.Shard();
        lock (shard) {
            shard.RecordQuery(sec, norm, us, this.sqlAggCap, this.slowQueryMs, this.ringCap);
        }
    }

    public static string NormalizeSql(string sql) {
        StringBuilder sb = new StringBuilder();
        int n = sql.Length;
        int i = 0;
        int holes = 0;
        bool lastSpace = false;
        while (i < n) {
            int c = sql[i];
            if (c == '\'') {
                i = i + 1;
                while (i < n) {
                    if (sql[i] == '\'') {
                        if (i + 1 < n && sql[i + 1] == '\'') {
                            i = i + 2; continue;
                        }
                        i = i + 1; break;
                    }
                    i = i + 1;
                }
                sb.Append("?"); holes = holes + 1; lastSpace = false; continue;
            }
            if (c >= 48 && c <= 57) {
                while (i < n) {
                    int d = sql[i];
                    if ((d >= 48 && d <= 57) || d == '.' || d == 'e'
                        || d == 'E' || d == 'x' || d == 'X') { i = i + 1; }
                    else { break; }
                }
                sb.Append("?"); holes = holes + 1; lastSpace = false; continue;
            }
            if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
                if (!lastSpace) { sb.Append(" "); lastSpace = true; }
                i = i + 1; continue;
            }
            if (c == '?') {
                sb.Append("?"); holes = holes + 1; lastSpace = false;
                i = i + 1; continue;
            }
            // cost of recording a query.
            int st = i;
            while (i < n) {
                int d = sql[i];
                if (d == '\'' || d == '?' || (d >= 48 && d <= 57) || d == ' '
                    || d == '\t' || d == '\n' || d == '\r') { break; }
                i = i + 1;
            }
            sb.Append(sql.Substring(st, i - st)); lastSpace = false;
        }
        string flat = sb.ToString();
        if (holes < 2) { return flat.Trim(); }
        return ServerMetrics.CollapsePlaceholders(flat).Trim();
    }

    private static string CollapsePlaceholders(string s) {
        StringBuilder sb = new StringBuilder();
        int n = s.Length;
        int i = 0;
        while (i < n) {
            if (s[i] == '?') {
                int j = i;
                int cnt = 0;
                bool more = true;
                while (more) {
                    if (j < n && s[j] == '?') {
                        cnt = cnt + 1; j = j + 1;
                        while (j < n && s[j] == ' ') { j = j + 1; }
                        if (j < n && s[j] == ',') {
                            j = j + 1;
                            while (j < n && s[j] == ' ') { j = j + 1; }
                        } else {
                            more = false;
                        }
                    } else {
                        more = false;
                    }
                }
                sb.Append("?");
                if (cnt >= 2) { i = j; } else { i = i + 1; }
                continue;
            }
            int st = i;
            while (i < n && s[i] != '?') { i = i + 1; }
            sb.Append(s.Substring(st, i - st));
        }
        return sb.ToString();
    }

    public JsonValue TopSqlJson(int limit) {
        JsonValue outp = JsonValue.NewArray();
        List<SqlAgg> pool = new List<SqlAgg>();
        Dictionary<string, SqlAgg> merged = new Dictionary<string, SqlAgg>();
        for (int s = 0; s < ServerMetrics.SHARD_COUNT; s = s + 1) {
            MetricsShard shard = this.shards[s];
            lock (shard) {
                for (int k = 0; k < shard.sqlAgg.Count; k = k + 1) {
                    SqlAgg src = shard.sqlAgg[k];
                    SqlAgg dst = null;
                    if (!merged.TryGetValue(src.sql, out dst)) {
                        dst = new SqlAgg(src.sql);
                        merged.Add(src.sql, dst);
                        pool.Add(dst);
                    }
                    dst.count = dst.count + src.count;
                    dst.totalUs = dst.totalUs + src.totalUs;
                    if (src.maxUs > dst.maxUs) { dst.maxUs = src.maxUs; }
                }
            }
        }
        while (outp.Count() < limit && pool.Count > 0) {
            int best = 0;
            for (int k = 1; k < pool.Count; k = k + 1) {
                if (pool[k].totalUs > pool[best].totalUs) { best = k; }
            }
            SqlAgg a = pool[best];
            JsonValue d = JsonValue.NewObject();
            d.Put("sql", ServerMetrics.DocStr(a.sql));
            d.Put("count", ServerMetrics.DocNum(a.count));
            d.Put("total_us", ServerMetrics.DocNum(a.totalUs));
            d.Put("avg_us", ServerMetrics.DocNum(a.count > 0 ? a.totalUs / a.count : 0));
            d.Put("max_us", ServerMetrics.DocNum(a.maxUs));
            outp.Append(d);
            pool.RemoveAt(best);
        }
        return outp;
    }

    public JsonValue TopReqJson(int limit) {
        JsonValue outp = JsonValue.NewArray();
        List<ReqAgg> pool = new List<ReqAgg>();
        Dictionary<string, ReqAgg> merged = new Dictionary<string, ReqAgg>();
        for (int s = 0; s < ServerMetrics.SHARD_COUNT; s = s + 1) {
            MetricsShard shard = this.shards[s];
            lock (shard) {
                for (int k = 0; k < shard.reqAgg.Count; k = k + 1) {
                    ReqAgg src = shard.reqAgg[k];
                    ReqAgg dst = null;
                    if (!merged.TryGetValue(src.req, out dst)) {
                        dst = new ReqAgg(src.method, src.path);
                        merged.Add(src.req, dst);
                        pool.Add(dst);
                    }
                    dst.count = dst.count + src.count;
                    dst.totalUs = dst.totalUs + src.totalUs;
                    if (src.maxUs > dst.maxUs) { dst.maxUs = src.maxUs; }
                    dst.errors = dst.errors + src.errors;
                    dst.failed = dst.failed + src.failed;
                    dst.rejected = dst.rejected + src.rejected;
                }
            }
        }
        while (outp.Count() < limit && pool.Count > 0) {
            int best = 0;
            for (int k = 1; k < pool.Count; k = k + 1) {
                if (pool[k].totalUs > pool[best].totalUs) { best = k; }
            }
            ReqAgg a = pool[best];
            JsonValue d = JsonValue.NewObject();
            d.Put("req", ServerMetrics.DocStr(a.req));
            d.Put("method", ServerMetrics.DocStr(a.method));
            d.Put("path", ServerMetrics.DocStr(a.path));
            d.Put("count", ServerMetrics.DocNum(a.count));
            d.Put("total_us", ServerMetrics.DocNum(a.totalUs));
            d.Put("avg_us", ServerMetrics.DocNum(a.count > 0 ? a.totalUs / a.count : 0));
            d.Put("max_us", ServerMetrics.DocNum(a.maxUs));
            d.Put("errors", ServerMetrics.DocNum(a.errors));
            d.Put("failed", ServerMetrics.DocNum(a.failed));
            d.Put("rejected", ServerMetrics.DocNum(a.rejected));
            outp.Append(d);
            pool.RemoveAt(best);
        }
        return outp;
    }

    // 慢请求 ring 的 JSON 数组（{"req","us"}），按记录先后排列。
    public JsonValue SlowReqJson() {
        JsonValue outp = JsonValue.NewArray();
        for (int s = 0; s < ServerMetrics.SHARD_COUNT; s = s + 1) {
            MetricsShard shard = this.shards[s];
            lock (shard) {
                foreach (SlowEntry e in shard.slowReqs) {
                    JsonValue o = JsonValue.NewObject();
                    o.Put("req", ServerMetrics.DocStr(e.text));
                    o.Put("us", ServerMetrics.DocNum(e.us));
                    outp.Append(o);
                }
            }
        }
        return outp;
    }

    // 慢查询 ring 的 JSON 数组（{"sql","us"}），按记录先后排列。
    public JsonValue SlowQueryJson() {
        JsonValue outp = JsonValue.NewArray();
        for (int s = 0; s < ServerMetrics.SHARD_COUNT; s = s + 1) {
            MetricsShard shard = this.shards[s];
            lock (shard) {
                foreach (SlowEntry e in shard.slowQueries) {
                    JsonValue o = JsonValue.NewObject();
                    o.Put("sql", ServerMetrics.DocStr(e.text));
                    o.Put("us", ServerMetrics.DocNum(e.us));
                    outp.Append(o);
                }
            }
        }
        return outp;
    }

    long SeriesPercentile(int[] hist, int k, long maxUs, int pct) {
        int hbase = k * ServerMetrics.HIST_BINS;
        long total = 0;
        for (int b = 0; b < ServerMetrics.HIST_BINS; b = b + 1) {
            total = total + hist[hbase + b];
        }
        if (total == 0) { return 0; }
        long want = (total * (long)pct + 99) / 100;
        if (want < 1) { want = 1; }
        if (want > total) { want = total; }
        long seen = 0;
        for (int b = 0; b < ServerMetrics.HIST_BINS; b = b + 1) {
            seen = seen + hist[hbase + b];
            if (seen >= want) {
                if (b == ServerMetrics.HIST_BINS - 1) { return maxUs; }
                long edge = ServerMetrics.HistEdge(b);
                if (edge > maxUs) { return maxUs; }
                return edge;
            }
        }
        return maxUs;
    }

    string SeriesJson(int seconds) {
        int want = seconds;
        if (want <= 0) { want = 60; }
        if (want > this.seriesCap) { want = this.seriesCap; }

        long now = ServerMetrics.MonoMicros() / 1000000;
        long from = now - (long)want + 1;
        if (from < 0) { from = 0; }
        if (now < 0) { now = 0; }
        want = (int)(now - from + 1);

        bool[] mLive = new bool[want];
        int[] mReq = new int[want];
        int[] mErr = new int[want];
        long[] mTotalUs = new long[want];
        long[] mMaxUs = new long[want];
        int[] mQuery = new int[want];
        long[] mQueryUs = new long[want];
        int[] mHist = new int[want * ServerMetrics.HIST_BINS];
        int[] mCpu = new int[want];
        long[] mRss = new long[want];
        for (int k = 0; k < want; k = k + 1) {
            mCpu[k] = 0 - 1;
            mRss[k] = 0 - 1;
        }

        for (int s = 0; s < ServerMetrics.SHARD_COUNT; s = s + 1) {
            MetricsShard shard = this.shards[s];
            lock (shard) {
                for (int k = 0; k < want; k = k + 1) {
                    long sec = from + (long)k;
                    int idx = (int)(sec % (long)this.seriesCap);
                    if (shard.sSec[idx] == sec) {
                        mLive[k] = true;
                        mReq[k] = mReq[k] + shard.sReq[idx];
                        mErr[k] = mErr[k] + shard.sErr[idx];
                        mTotalUs[k] = mTotalUs[k] + shard.sTotalUs[idx];
                        if (shard.sMaxUs[idx] > mMaxUs[k]) { mMaxUs[k] = shard.sMaxUs[idx]; }
                        mQuery[k] = mQuery[k] + shard.sQuery[idx];
                        mQueryUs[k] = mQueryUs[k] + shard.sQueryUs[idx];
                        int sBase = idx * ServerMetrics.HIST_BINS;
                        int mBase = k * ServerMetrics.HIST_BINS;
                        for (int b = 0; b < ServerMetrics.HIST_BINS; b = b + 1) {
                            mHist[mBase + b] = mHist[mBase + b] + shard.sHist[sBase + b];
                        }
                    }
                }
            }
        }

        lock (this.sampleLock) {
            for (int k = 0; k < want; k = k + 1) {
                long sec = from + (long)k;
                int idx = (int)(sec % (long)this.seriesCap);
                if (this.sSampleSec[idx] == sec) {
                    mCpu[k] = this.sCpu[idx];
                    mRss[k] = this.sRss[idx];
                }
            }
        }

        int lastCpu = 0 - 1;
        long lastRss = 0 - 1;
        StringBuilder sb = new StringBuilder();
        sb.Append("{\"step_ms\":1000,\"count\":");
        sb.Append(Convert.ToString(want));
        sb.Append(",\"points\":[");
        for (int k = 0; k < want; k = k + 1) {
            long sec = from + (long)k;
            if (k > 0) { sb.Append(","); }
            long req = 0;
            long err = 0;
            long avg = 0;
            long p95 = 0;
            long max = 0;
            long q = 0;
            long qavg = 0;
            if (mLive[k]) {
                req = mReq[k];
                err = mErr[k];
                if (mReq[k] > 0) { avg = mTotalUs[k] / mReq[k]; }
                p95 = this.SeriesPercentile(mHist, k, mMaxUs[k], 95);
                max = mMaxUs[k];
                q = mQuery[k];
                if (mQuery[k] > 0) { qavg = mQueryUs[k] / mQuery[k]; }
                if (mCpu[k] >= 0) { lastCpu = mCpu[k]; }
                if (mRss[k] >= 0) { lastRss = mRss[k]; }
            }
            sb.Append("{\"t\":");
            sb.Append(Convert.ToString(sec - now));  // seconds ago, 0 = now
            sb.Append(",\"req\":");
            sb.Append(Convert.ToString(req));
            sb.Append(",\"err\":");
            sb.Append(Convert.ToString(err));
            sb.Append(",\"avg_us\":");
            sb.Append(Convert.ToString(avg));
            sb.Append(",\"p95_us\":");
            sb.Append(Convert.ToString(p95));
            sb.Append(",\"max_us\":");
            sb.Append(Convert.ToString(max));
            sb.Append(",\"queries\":");
            sb.Append(Convert.ToString(q));
            sb.Append(",\"query_avg_us\":");
            sb.Append(Convert.ToString(qavg));
            sb.Append(",\"cpu_percent\":");
            sb.Append(Convert.ToString(lastCpu));
            sb.Append(",\"mem_rss_bytes\":");
            sb.Append(Convert.ToString(lastRss));
            sb.Append("}");
        }
        sb.Append("]}");
        return sb.ToString();
    }

    static int CpuWindowMs = 200;

    // 以十进制文本构造 JSON 数值叶子。
    private static JsonValue DocNum(long v) { return JsonValue.NewNum(Convert.ToString(v)); }
    // 构造 JSON 字符串叶子；null 映射为 JSON null。
    private static JsonValue DocStr(string s) {
        if (s == null) { return JsonValue.NewNull(); }
        return JsonValue.NewStr(s);
    }

    // 生成本进程的指标快照 JSON（/admin/stats 形状）：uptime、CPU/内存、
    // 请求与查询计数、并发与流负载、慢操作列表和 top SQL/端点排行。
    public string SnapshotJson() {
        long nowWall = ServerMetrics.MonoMillis();
        long cpuMs = ServerMetrics.CpuMillis();
        long uptime = nowWall - this.startMillis;
        long cpuPct;
        lock (this.snapshotLock) {
            cpuPct = this.lastCpuPct;
            if (cpuMs >= 0) {
                long dWall = nowWall - this.lastWallMs;
                if (dWall >= (long)ServerMetrics.CpuWindowMs) {
                    cpuPct = ((cpuMs - this.lastCpuMs) * 100) / dWall;
                    this.lastWallMs = nowWall;
                    this.lastCpuMs = cpuMs;
                    this.lastCpuPct = cpuPct;
                }
            }
        }

        long totReq = 0;
        long totReqErr = 0;
        long totReqFail = 0;
        long totReqRej = 0;
        long totReqUnmatched = 0;
        long totReqUs = 0;
        long maxReqUs = 0;
        int slowReqCnt = 0;
        long totQ = 0;
        long totQUs = 0;
        long maxQUs = 0;
        int slowQCnt = 0;
        long shardConc = 0;
        long shardPeak = 0;
        for (int s = 0; s < ServerMetrics.SHARD_COUNT; s = s + 1) {
            MetricsShard shard = this.shards[s];
            shardConc = shardConc + shard.concurrent.Load();
            shardPeak = shardPeak + shard.concurrentPeak.Load();
            lock (shard) {
                totReq = totReq + shard.reqCount;
                totReqErr = totReqErr + shard.reqErrors;
                totReqFail = totReqFail + shard.reqFailed;
                totReqRej = totReqRej + shard.reqRejected;
                totReqUnmatched = totReqUnmatched + shard.reqUnmatched;
                totReqUs = totReqUs + shard.reqTotalUs;
                if (shard.reqMaxUs > maxReqUs) { maxReqUs = shard.reqMaxUs; }
                slowReqCnt = slowReqCnt + shard.slowReqs.Count;
                totQ = totQ + shard.queryCount;
                totQUs = totQUs + shard.queryTotalUs;
                if (shard.queryMaxUs > maxQUs) { maxQUs = shard.queryMaxUs; }
                slowQCnt = slowQCnt + shard.slowQueries.Count;
            }
        }
        long concTotal = this.concurrent.Load() + shardConc;
        if (concTotal < 0) { concTotal = 0; }
        long concPeakTotal = this.concurrentPeak.Load();
        if (shardPeak > concPeakTotal) { concPeakTotal = shardPeak; }

        long reqAvg = 0;
        if (totReq > 0) { reqAvg = totReqUs / totReq; }
        long qAvg = 0;
        if (totQ > 0) { qAvg = totQUs / totQ; }

        JsonValue requests = JsonValue.NewObject();
        requests.Put("count", ServerMetrics.DocNum(totReq));
        requests.Put("errors", ServerMetrics.DocNum(totReqErr));
        requests.Put("failed", ServerMetrics.DocNum(totReqFail));
        requests.Put("rejected", ServerMetrics.DocNum(totReqRej));
        requests.Put("unmatched", ServerMetrics.DocNum(totReqUnmatched));
        requests.Put("total_us", ServerMetrics.DocNum(totReqUs));
        requests.Put("avg_us", ServerMetrics.DocNum(reqAvg));
        requests.Put("max_us", ServerMetrics.DocNum(maxReqUs));
        requests.Put("slow_threshold_us",
            ServerMetrics.DocNum((long)this.slowReqMs * 1000));
        requests.Put("slow_count", ServerMetrics.DocNum(slowReqCnt));

        JsonValue queries = JsonValue.NewObject();
        queries.Put("count", ServerMetrics.DocNum(totQ));
        queries.Put("total_us", ServerMetrics.DocNum(totQUs));
        queries.Put("avg_us", ServerMetrics.DocNum(qAvg));
        queries.Put("max_us", ServerMetrics.DocNum(maxQUs));
        queries.Put("slow_threshold_us",
            ServerMetrics.DocNum((long)this.slowQueryMs * 1000));
        queries.Put("slow_count", ServerMetrics.DocNum(slowQCnt));

        JsonValue load = JsonValue.NewObject();
        load.Put("concurrent", ServerMetrics.DocNum(concTotal));
        load.Put("peak", ServerMetrics.DocNum(concPeakTotal));
        load.Put("streams", ServerMetrics.DocNum(this.streams.Load()));
        load.Put("stream_frames", ServerMetrics.DocNum(this.streamFrames.Load()));
        load.Put("stream_bytes", ServerMetrics.DocNum(this.streamBytes.Load()));

        JsonValue o = JsonValue.NewObject();
        o.Put("uptime_ms", ServerMetrics.DocNum(uptime));
        o.Put("pid", ServerMetrics.DocNum(ProcessHost.Pid()));
        o.Put("worker_id", ServerMetrics.DocNum(ProcessHost.WorkerId()));
        o.Put("cpu_ms", ServerMetrics.DocNum(cpuMs));
        o.Put("cpu_percent", ServerMetrics.DocNum(cpuPct));
        o.Put("mem_rss_bytes", ServerMetrics.DocNum(ServerMetrics.MemoryRssBytes()));
        o.Put("requests", requests);
        o.Put("queries", queries);
        o.Put("load", load);
        o.Put("slow_requests", this.SlowReqJson());
        o.Put("slow_queries", this.SlowQueryJson());
        o.Put("top_sql", this.TopSqlJson(20));
        o.Put("top_requests", this.TopReqJson(20));
        return o.ToJson();
    }
}
