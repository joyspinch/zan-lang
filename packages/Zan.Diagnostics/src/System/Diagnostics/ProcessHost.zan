using System;
using System.IO;

namespace System.Diagnostics;

// 跨平台进程与守护进程支持：PID、环境变量、AppDir、POSIX Daemonize（setsid/nohup）及 SO_REUSEPORT 多 worker 派生。
public class ProcessHost {
    // 须保留 [DllImport("crt")]（裸 extern 会被降低为常量 0 并破坏 POSIX 路径）。
    [DllImport("crt")]
    private static extern string getenv(string name);

    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "GetCurrentProcessId")]
    private static extern int GetCurrentProcessId();
    [DllImport("kernel32", EntryPoint = "GetEnvironmentVariableW")]
    private static extern int GetEnvironmentVariableW(nint name, nint buf, int size);
    #elif LINUX || MACOS
    [DllImport("crt")]
    private static extern int getpid();
    #endif

    public static int Pid() {
        #if WINDOWS
        return GetCurrentProcessId();
        #elif WASM32
        return 0;
        #else
        return getpid();
        #endif
    }

    // 读取环境变量，未设置时返回 ""。
    public static string Env(string name) {
        #if WINDOWS
        // 读实时 Win32 环境块（CRT getenv 仅抓启动快照，会漏掉父进程注入的变量）。
        nint wname = Wide.Of(name);
        nint buf = NativeMemory.Alloc(8192);
        int n = GetEnvironmentVariableW(wname, buf, 4096);
        string text = (n > 0 && n < 4096) ? Wide.Read(buf) : "";
        NativeMemory.Free(buf);
        Wide.Free(wname);
        return text;
        #else
        string v = getenv(name);
        return v == null ? "" : v;
        #endif
    }

    public static string SelfExe() { return Environment.ProcessPath; }

    // 返回程序自带资源目录（优先 ZAN_APP_DIR，macOS .app 包解析到 Contents/Resources）。
    public static string AppDir() {
        string app = ProcessHost.Env("ZAN_APP_DIR");
        if (app != "") { return app; }
        string exe = ProcessHost.SelfExe();
        if (exe == "") { return ""; }
        string dir = Path.GetDirectoryName(exe);
        if (dir == "") { return ""; }
        string parent = Path.GetDirectoryName(dir);
        if (Path.GetFileName(dir) == "MacOS" && Path.GetFileName(parent) == "Contents") {
            return parent + "/Resources";
        }
        return dir;
    }

    // 若 AppDir() 下存在 marker，则将当前工作目录切换过去并返回 true。
    public static bool UseAppDir(string marker) {
        string dir = ProcessHost.AppDir();
        if (dir == "") { return false; }
        string probe = dir + "/" + marker;
        if (!File.Exists(probe) && !Directory.Exists(probe)) { return false; }
        if (Directory.GetCurrentDirectory() == dir) { return false; }
        Directory.SetCurrentDirectory(dir);
        return true;
    }

    public static int WorkerId() {
        string v = ProcessHost.Env("ZAN_WORKER_ID");
        return v == "" ? 0 : Convert.ToInt32(v);
    }

    public static bool IsWorker() { return ProcessHost.Env("ZAN_WORKER_ID") != ""; }

    public static bool MultiProcessSupported() {
        #if WINDOWS
        return false;
        #else
        return true;
        #endif
    }

    public static bool Daemonize() { return ProcessHost.DaemonizeTo("", ""); }

    // Linux 用 setsid、macOS 用 nohup 后台化并重定向输出到 logPath；其余平台或已守护时返回 false。
    public static bool DaemonizeTo(string logPath, string logDir) {
        if (ProcessHost.IsWorker() || ProcessHost.Env("ZAN_DAEMON") != "") { return false; }
        string exe = ProcessHost.SelfExe();
        if (exe == "") { return false; }
        #if LINUX || MACOS
        #if LINUX
        string cmd = "setsid";
        #else
        string cmd = "nohup";
        #endif
        List<string> shArgs = new List<string>();
        shArgs.Add("-c");
        if (logPath != "") {
            shArgs.Add("ZAN_DAEMON=1 ZAN_LOG_DIR=\"$1\" " + cmd + " \"$2\" >> \"$3\" 2>&1");
            shArgs.Add("sh");
            shArgs.Add(logDir);
            shArgs.Add(exe);
            shArgs.Add(logPath);
        } else {
            shArgs.Add("ZAN_DAEMON=1 ZAN_LOG_DIR=\"$1\" " + cmd + " \"$2\"");
            shArgs.Add("sh");
            shArgs.Add(logDir);
            shArgs.Add(exe);
        }
        Process.StartDetachedSafe("/bin/sh", shArgs);
        return true;
        #else
        return false;
        #endif
    }

    public static int SpawnWorkers(int count) {
        if (count <= 1 || !ProcessHost.MultiProcessSupported() || ProcessHost.IsWorker()) { return 0; }
        string exe = ProcessHost.SelfExe();
        if (exe == "") { return 0; }
        int spawned = 0;
        for (int i = 1; i < count; i = i + 1) {
            List<string> wargs = new List<string>();
            wargs.Add("ZAN_WORKER_ID=" + Convert.ToString(i));
            wargs.Add(exe);
            Process.StartDetachedSafe("env", wargs);
            spawned = spawned + 1;
        }
        return spawned;
    }
}
