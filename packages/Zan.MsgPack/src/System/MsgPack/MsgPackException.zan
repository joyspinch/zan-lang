using System;

namespace System.MsgPack;

/// <summary>当 MessagePack 字节流非法（截断、0xC1 保留码、未知
/// extension 类型、字符串含 NUL）或写出的 JsonValue 结构超限
/// （深度、容器长度超过 32 位）时抛出。</summary>
class MsgPackException : Exception {
    /// 以描述格式错误的消息构造（带出错字节偏移）。
    public MsgPackException(string message) {
        Message = message;
    }
}
