using System;
using System.IO;
using System.Json;

namespace System.MsgPack;

// MessagePack 门面：JsonValue ↔ 线上字节的 schemaless 互转。
// 整型形态数字（JsonValue.IsInt）走 msgpack 整数家族，浮点走
// float64；null ↔ nil；bin 家族读侧尽力按 UTF-8 解码成字符串；
// timestamp extension 读侧还原成 ISO 8601 UTC 字符串。深度上限
// 512，与 System.Json 对称。
class MsgPack {
    // 递归深度上限（编码/解码两侧一起限）。
    static int MaxDepth = 512;

    // 把值树编码成 MessagePack 字节。null 视为 nil；
    // 对象键必须能转成字符串（JsonValue 对象键本来就是字符串）。
    static byte[] Pack(JsonValue v) {
        MsgPackWriter w = new MsgPackWriter();
        EncodeValue(w, v, 0);
        return w.ToBytes();
    }

    // 解码整段 MessagePack 字节（非法即抛 MsgPackException）。
    static JsonValue Unpack(byte[] data) {
        MsgPackReader r = new MsgPackReader(data);
        return r.ReadValue(0);
    }

    // 解码切片 [offset, offset+count)。
    static JsonValue Unpack(byte[] data, int offset, int count) {
        MsgPackReader r = new MsgPackReader(data, offset, count);
        return r.ReadValue(0);
    }

    // 从文件读入并解码。
    static JsonValue Load(string path) {
        return MsgPack.Unpack(File.ReadAllBytes(path));
    }

    // 编码并写入文件。
    static void Save(JsonValue v, string path) {
        File.WriteAllBytes(path, MsgPack.Pack(v));
    }

    static void EncodeValue(MsgPackWriter w, JsonValue v, int depth) {
        if (depth > MsgPack.MaxDepth) {
            throw new MsgPackException("nesting too deep while packing");
        }
        if (v == null || v.IsNull()) { w.WriteNil(); return; }
        if (v.IsBool()) { w.WriteBool(v.AsBool(false)); return; }
        if (v.IsNumber()) {
            if (v.IsInt()) {
                w.WriteInt(v.AsLong(0));
            } else {
                w.WriteDouble(v.AsDouble(0));
            }
            return;
        }
        if (v.IsString()) { w.WriteString(v.AsString("")); return; }
        if (v.IsArray()) {
            int n = v.Count();
            w.WriteArrayHeader(n);
            int i = 0;
            while (i < n) {
                EncodeValue(w, v.At(i), depth + 1);
                i = i + 1;
            }
            return;
        }
        if (v.IsObject()) {
            int n = v.Count();
            w.WriteMapHeader(n);
            int i = 0;
            while (i < n) {
                string k = v.KeyAt(i);
                w.WriteString(k);
                EncodeValue(w, v.ValAt(i), depth + 1);
                i = i + 1;
            }
            return;
        }
        throw new MsgPackException("unsupported value kind while packing");
    }
}
