using System;
using System.Text;
namespace System.Text.RegularExpressions;

// 一次进行中的匹配：输入、正在填充的捕获槽、空循环
// 检查用的槽位和剩余步骤预算。与 RegexProgram 分离，使编译后的
// 模式保持不可变，可对多个输入进行匹配。
public class RegexRun {
    // 输入字节缓冲区。
    public nint input;
    // 输入长度（字节）。
    public int len;
    // 正在填充的捕获槽（2 * GroupCount() 个）。
    public List<int> caps;
    // 空循环检查槽。
    public List<int> marks;
    // 剩余回溯步数预算。
    public int budget;
    // 匹配成功时的结束位置。
    public int end;
    // 本次尝试的起点（\G）
    public int origin;
    // 环视 / 原子组子程序的结束位置
    public int subEnd;
    // 回溯预算耗尽
    public bool overflow;

    public RegexRun() {
        this.input = 0;
        this.len = 0;
        this.caps = null;
        this.marks = new List<int>();
        this.budget = 0;
        this.end = -1;
        this.origin = 0;
        this.subEnd = -1;
        this.overflow = false;
    }
}
