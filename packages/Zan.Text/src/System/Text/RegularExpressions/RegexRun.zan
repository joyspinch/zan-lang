using System;
using System.Text;
namespace System.Text.RegularExpressions;

// 一次进行中的匹配：输入、正在填充的捕获槽、空循环
// 检查用的槽位和剩余步骤预算。与 RegexProgram 分离，使编译后的
// 模式保持不可变，可对多个输入进行匹配。
public class RegexRun {
    // 输入字符串（持有所有权）与原始 UTF-8 字节指针（供零 ARC Span 直读）。
    public string input;
    public nint inputPtr;
    // 输入长度（字节）。
    public int len;
    // 正在填充的捕获槽（2 * GroupCount() 个，复用数组避免逐位置分配）。
    public int[] caps;
    // 空循环检查槽（仅 marks > 0 时分配，复用数组）。
    public int[] marks;
    // 剩余回溯步数预算。
    public int budget;
    // 匹配成功时的结束位置。
    public int end;
    // 本次尝试的起点（\G）
    public int origin;
    // 环视 / 原子组子程序的结束位置
    public int subEnd;
    // 回溯预算耗尽
    public bool overflow;

    public RegexRun() {
        this.input = "";
        this.inputPtr = (nint)0;
        this.len = 0;
        this.caps = null;
        this.marks = null;
        this.budget = 0;
        this.end = -1;
        this.origin = 0;
        this.subEnd = -1;
        this.overflow = false;
    }

    public static RegexRun Create(string input, int len, int slots, int markCount) {
        RegexRun r = new RegexRun();
        r.input = input;
        r.inputPtr = (nint)input;
        r.len = len;
        r.caps = new int[slots];
        if (markCount > 0) {
            r.marks = new int[markCount];
        }
        return r;
    }
}
