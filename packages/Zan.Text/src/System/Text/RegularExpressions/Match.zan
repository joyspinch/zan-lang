using System;

namespace System.Text.RegularExpressions;

// 一次正则匹配的结果：起始位置、覆盖范围，
// 以及各捕获组捕获的文本。
// Match m = re.Find("order 42");
// if (m.Success()) {
// 核心契约与语义定义。
// Console.WriteLine(m.Group(1));
// }
// 组 0 为整个匹配。未参与的组
// 返回 Index -1，值为 ""。
class Match {
    bool success;
    string input;
    List<int> caps;
    int groups;

    Match() {
        this.success = false;
        this.input = "";
        this.caps = new List<int>();
        this.groups = 0;
    }

    // 构造失败的匹配（Find 在无匹配时返回它）。
    static Match Failure() {
        return new Match();
    }

    // 从原始捕获偏移构造匹配。
    static Match FromCaps(string input, List<int> caps, int groups) {
        Match m = new Match();
        m.success = true;
        m.input = input;
        m.groups = groups;
        for (int i = 0; i < caps.Count; i = i + 1) {
            m.caps.Add(caps[i]);
        }
        return m;
    }

    // 模式匹配成功时返回 true。
    bool Success() { return this.success; }

    // 整个匹配的起始偏移，无匹配时为 -1。
    int Index() { return this.GroupIndex(0); }

    // 整个匹配的长度，无匹配时为 0。
    int Length() { return this.GroupLength(0); }

    // 匹配的文本，无匹配时为 ""。
    string Value() { return this.Group(0); }

    // 组的总数，含组 0。
    int GroupCount() { return this.groups; }

    // 组 `n` 的起始偏移；组未
    // 参与时返回 -1。
    int GroupIndex(int n) {
        if (!this.success || n < 0 || n >= this.groups) { return -1; }
        return this.caps[n * 2];
    }

    // 组 `n` 的长度，未参与时为 0。
    int GroupLength(int n) {
        if (!this.success || n < 0 || n >= this.groups) { return 0; }
        int s = this.caps[n * 2];
        int e = this.caps[n * 2 + 1];
        if (s < 0 || e < s) { return 0; }
        return e - s;
    }

    // 组 `n` 的文本，未参与时为 ""。
    string Group(int n) {
        int s = this.GroupIndex(n);
        int len = this.GroupLength(n);
        if (s < 0) { return ""; }
        return this.input.Substring(s, len);
    }

    // 组 `n` 参与了匹配时返回 true。
    bool GroupSuccess(int n) {
        return this.GroupIndex(n) >= 0;
    }
}
