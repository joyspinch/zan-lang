using System;
using System.Text;
namespace System.Text.RegularExpressions;

// 正则表达式命名组实体（消除 groupNames/groupNums 平行列表反模式）。
public class RegexNamedGroup {
    public string name;
    public int groupNum;

    public RegexNamedGroup(string name, int groupNum) {
        this.name = name;
        this.groupNum = groupNum;
    }
}
