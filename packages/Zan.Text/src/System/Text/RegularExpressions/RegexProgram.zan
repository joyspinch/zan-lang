using System;
using System.Text;
namespace System.Text.RegularExpressions;

// UTF-8 码点级编译正则程序与有界回溯解释器（供 Regex 内部使用）。
public partial class RegexProgram {
    public static int OpChar() { return 1; }
    public static int OpAny() { return 2; }
    public static int OpClass() { return 3; }
    public static int OpMatch() { return 4; }
    public static int OpJmp() { return 5; }
    public static int OpSplit() { return 6; }
    public static int OpSave() { return 7; }
    public static int OpBol() { return 8; }
    public static int OpEol() { return 9; }
    public static int OpWordB() { return 10; }
    public static int OpBackref() { return 11; }
    public static int OpBos() { return 12; }
    public static int OpEos() { return 13; }
    public static int OpGpos() { return 14; }
    public static int OpMark() { return 15; }
    public static int OpEmptyChk() { return 16; }
    public static int OpLook() { return 17; }
    public static int OpLookEnd() { return 18; }
    public static int OpClassRepGreedy() { return 19; }
    public static int OpClassRepLazy() { return 20; }
    public static int OpAnyRepGreedy() { return 21; }
    public static int OpAnyRepLazy() { return 22; }

    public static int LookAhead() { return 0; }
    public static int LookAheadNeg() { return 1; }
    public static int LookBehind() { return 2; }
    public static int LookBehindNeg() { return 3; }
    public static int LookAtomic() { return 4; }

    public static int MemRange() { return 0; }
    public static int MemNotSet() { return 1; }

    List<int> op;
    List<int> ax;
    List<int> ay;
    List<int> az;

    List<int> clsKind;
    List<int> clsLo;
    List<int> clsHi;
    List<int> clsStart;
    List<int> clsCount;
    List<int> clsNeg;

    List<RegexNamedGroup> namedGroups;

    int groups;
    int marks;
    bool ignoreCase;
    // 与步数预算（2M）互补：防单量词在长输入上深递归打穿线程栈。
    static int MaxRecursionDepth = 10000;
    bool multiline;
    bool dotAll;
    string pattern;
    string error;

    nint pbuf;
    int plen;
    int ppos;
    int parseDepth;

    // 编译期冻结的扁平字节码、128 位 ASCII 字符类位图与扫描预过滤元数据。
    int[] opArr;
    int[] axArr;
    int[] ayArr;
    int[] azArr;
    long[] clsMaskLo;
    long[] clsMaskHi;
    // startKind: 0=无预过滤, 1=仅起点(^/\A), 2=精确 ASCII 首字节, 3=ASCII 首字符位图
    public int startKind;
    public int startByte;
    public string startByteStr;
    public long startMaskLo;
    public long startMaskHi;
    public bool startAllowsNonAscii;
    // 必现 ASCII 字面量字节（>=1 时所有成功匹配均须经过该字节，供 memchr 快拒）
    public int reqByte;
    public string reqByteStr;

    public RegexProgram() {
        this.op = new List<int>();
        this.ax = new List<int>();
        this.ay = new List<int>();
        this.az = new List<int>();
        this.clsKind = new List<int>();
        this.clsLo = new List<int>();
        this.clsHi = new List<int>();
        this.clsStart = new List<int>();
        this.clsCount = new List<int>();
        this.clsNeg = new List<int>();
        this.namedGroups = new List<RegexNamedGroup>();
        this.groups = 1;
        this.marks = 0;
        this.ignoreCase = false;
        this.multiline = false;
        this.dotAll = false;
        this.pattern = "";
        this.error = "";
        this.pbuf = 0;
        this.plen = 0;
        this.ppos = 0;
        this.parseDepth = 0;
        this.opArr = null;
        this.axArr = null;
        this.ayArr = null;
        this.azArr = null;
        this.clsMaskLo = null;
        this.clsMaskHi = null;
        this.startKind = 0;
        this.startByte = -1;
        this.startByteStr = "";
        this.startMaskLo = 0L;
        this.startMaskHi = 0L;
        this.startAllowsNonAscii = true;
        this.reqByte = -1;
        this.reqByteStr = "";
    }

    public static RegexProgram Compile(string pattern, bool ignoreCase) {
        RegexProgram p = new RegexProgram();
        p.pattern = pattern;
        p.ignoreCase = ignoreCase;
        p.plen = pattern.Length;
        p.pbuf = NativeMemory.Alloc(p.plen + 1);
        try {
            if (p.plen > 0) { NativeMemory.PutString(p.pbuf, 0, pattern, p.plen); }
            p.ParseInlineFlags();
            p.Emit(RegexProgram.OpSave(), 0, 0, 0);
            p.ParseAlt();
            if (p.error.Length == 0 && p.ppos < p.plen) {
                p.error = "unexpected ')' at " + p.ppos;
            }
            p.Emit(RegexProgram.OpSave(), 1, 0, 0);
            p.Emit(RegexProgram.OpMatch(), 0, 0, 0);
        } finally {
            if (p.pbuf != 0) {
                NativeMemory.Free(p.pbuf);
                p.pbuf = 0;
            }
        }
        if (p.error.Length == 0) {
            p.Freeze();
        }
        return p;
    }

    public int MarkCount() { return this.marks; }

    // 冻结扁平指令数组、预计算字符类 128 位 ASCII 位图，并推导起始与必现字面量预过滤器。
    void Freeze() {
        int n = this.op.Count;
        int[] oa = new int[n];
        int[] xa = new int[n];
        int[] ya = new int[n];
        int[] za = new int[n];
        for (int i = 0; i < n; i = i + 1) {
            oa[i] = this.op[i];
            xa[i] = this.ax[i];
            ya[i] = this.ay[i];
            za[i] = this.az[i];
        }
        this.opArr = oa;
        this.axArr = xa;
        this.ayArr = ya;
        this.azArr = za;

        int ncls = this.clsStart.Count;
        if (ncls > 0) {
            long[] mlo = new long[ncls];
            long[] mhi = new long[ncls];
            for (int ci = 0; ci < ncls; ci = ci + 1) {
                long lo = 0L;
                long hi = 0L;
                for (int c = 0; c < 64; c = c + 1) {
                    if (this.ClassHasSlow(ci, c)) { lo = lo | (1L << c); }
                }
                for (int c = 64; c < 128; c = c + 1) {
                    if (this.ClassHasSlow(ci, c)) { hi = hi | (1L << (c - 64)); }
                }
                mlo[ci] = lo;
                mhi[ci] = hi;
            }
            this.clsMaskLo = mlo;
            this.clsMaskHi = mhi;
        }

        // 1. 起始预过滤：跳过开头的 OpSave(7) 与 PlusAt 写入的 OpMark(15)
        int pc = 0;
        while (pc < n && (oa[pc] == 7 || oa[pc] == 15)) {
            pc = pc + 1;
        }
        if (pc < n) {
            int o0 = oa[pc];
            if ((o0 == 8 && !this.multiline) || o0 == 12) {
                this.startKind = 1;
            } else if (o0 == 1) {
                int ch = xa[pc];
                if (ch > 0 && ch < 128) {
                    if (!this.ignoreCase) {
                        this.startKind = 2;
                        this.startByte = ch;
                        this.startByteStr = Encoding.Utf8FromCodePoint(ch);
                        this.startAllowsNonAscii = false;
                    } else {
                        int f = RegexProgram.Fold(ch);
                        long lo = 0L;
                        long hi = 0L;
                        if (f < 64) { lo = lo | (1L << f); } else { hi = hi | (1L << (f - 64)); }
                        if (f >= 97 && f <= 122) {
                            int u = f - 32;
                            hi = hi | (1L << (u - 64));
                        }
                        this.startKind = 3;
                        this.startMaskLo = lo;
                        this.startMaskHi = hi;
                        this.startAllowsNonAscii = false;
                    }
                }
            } else if (o0 == 3) {
                int ci = xa[pc];
                this.startKind = 3;
                this.startMaskLo = this.clsMaskLo[ci];
                this.startMaskHi = this.clsMaskHi[ci];
                bool nonAscii = this.clsNeg[ci] == 1;
                if (!nonAscii) {
                    int cFrom = this.clsStart[ci];
                    int cTo = cFrom + this.clsCount[ci];
                    for (int k = cFrom; k < cTo; k = k + 1) {
                        if (this.clsKind[k] == 1 || this.clsHi[k] >= 128) {
                            nonAscii = true;
                            break;
                        }
                    }
                }
                this.startAllowsNonAscii = nonAscii;
            }
        }

        // 2. 必现 ASCII 字面量字节（仅沿严格后支配前向边扫描，绝不跨交替/可选分支猜测）
        int bestReq = -1;
        int bestScore = 0;
        int wpc = 0;
        int guard = 0;
        while (wpc >= 0 && wpc < n && guard < n) {
            guard = guard + 1;
            int wo = oa[wpc];
            if (wo == 4) { break; }
            if (wo == 1) {
                int ch = xa[wpc];
                if (ch > 0 && ch < 128 && !this.ignoreCase) {
                    int score = ((ch >= 97 && ch <= 122) || (ch >= 65 && ch <= 90) || (ch >= 48 && ch <= 57)) ? 1 : 2;
                    if (score > bestScore) {
                        bestScore = score;
                        bestReq = ch;
                    }
                }
                wpc = wpc + 1;
            } else if (wo == 2 || wo == 3 || wo == 7 || wo == 8 || wo == 9 || wo == 10
                    || wo == 11 || wo == 12 || wo == 13 || wo == 14 || wo == 15) {
                wpc = wpc + 1;
            } else if (wo == 5) {
                int tgt = xa[wpc];
                if (tgt > wpc) { wpc = tgt; } else { break; }
            } else if (wo == 16) {
                // PlusAt 生成模式：[OpMark, body, OpEmptyChk(slot, end), OpSplit(loopBack, end), end...]
                int endPc = ya[wpc];
                if (endPc == wpc + 2 && wpc + 1 < n && oa[wpc + 1] == 6) {
                    int sx = xa[wpc + 1];
                    int sy = ya[wpc + 1];
                    if ((sx < wpc && sy == endPc) || (sy < wpc && sx == endPc)) {
                        wpc = endPc;
                    } else {
                        break;
                    }
                } else {
                    break;
                }
            } else if (wo == 17) {
                int cont = ya[wpc];
                if (cont > wpc) { wpc = cont; } else { break; }
            } else {
                break;
            }
        }
        if (bestReq > 0 && !(this.startKind == 2 && this.startByte == bestReq)) {
            this.reqByte = bestReq;
            this.reqByteStr = Encoding.Utf8FromCodePoint(bestReq);
        }

        // 3. 检测前缀 `C+ R`（纯 ASCII 字符类正闭包紧跟不含于 C 的精确 ASCII 字面量 R）：
        //    支持 ScanFromStr 用 SIMD memchr 直跳 R 再反向回扫 C 起点，避免无关前缀 O(L²) 回溯。
        if (!this.ignoreCase) {
            int p4 = 0;
            while (p4 < n && oa[p4] == 7) { p4 = p4 + 1; }
            if (p4 + 4 < n && oa[p4] == 15 && oa[p4 + 1] == 3
                && oa[p4 + 2] == 16 && ya[p4 + 2] == p4 + 4
                && oa[p4 + 3] == 6) {
                int sx = xa[p4 + 3];
                int sy = ya[p4 + 3];
                if ((sx == p4 && sy == p4 + 4) || (sy == p4 && sx == p4 + 4)) {
                    int ci = xa[p4 + 1];
                    bool nonAscii = this.clsNeg[ci] == 1;
                    if (!nonAscii) {
                        int cFrom = this.clsStart[ci];
                        int cTo = cFrom + this.clsCount[ci];
                        for (int k = cFrom; k < cTo; k = k + 1) {
                            if (this.clsKind[k] == 1 || this.clsHi[k] >= 128) {
                                nonAscii = true;
                                break;
                            }
                        }
                    }
                    if (!nonAscii) {
                        int aPc = p4 + 4;
                        while (aPc < n && oa[aPc] == 7) { aPc = aPc + 1; }
                        if (aPc < n && oa[aPc] == 1) {
                            int ch = xa[aPc];
                            if (ch > 0 && ch < 128) {
                                long m = ch < 64 ? this.clsMaskLo[ci] : this.clsMaskHi[ci];
                                if ((m & (1L << (ch & 63))) == 0L) {
                                    this.startKind = 4;
                                    this.startMaskLo = this.clsMaskLo[ci];
                                    this.startMaskHi = this.clsMaskHi[ci];
                                    this.startAllowsNonAscii = false;
                                    this.reqByte = ch;
                                    this.reqByteStr = Encoding.Utf8FromCodePoint(ch);
                                }
                            }
                        }
                    }
                }
            }
        }

        // 4. 窥孔融合：把单 OpClass / OpAny 的 PlusAt/StarAt 循环合并为单条重复指令（原地覆写入口，不移位 PC）
        int fi = 0;
        while (fi < n) {
            if (fi + 3 < n && oa[fi] == 15 && (oa[fi + 1] == 3 || oa[fi + 1] == 2)
                && oa[fi + 2] == 16 && ya[fi + 2] == fi + 4 && oa[fi + 3] == 6) {
                int sx = xa[fi + 3];
                int sy = ya[fi + 3];
                bool isGreedy = (sx == fi && sy == fi + 4);
                bool isLazy = (sx == fi + 4 && sy == fi);
                if (isGreedy || isLazy) {
                    if (oa[fi + 1] == 3) {
                        oa[fi] = isGreedy ? 19 : 20;
                        xa[fi] = xa[fi + 1];
                        ya[fi] = 1;
                        za[fi] = fi + 4;
                    } else {
                        oa[fi] = isGreedy ? 21 : 22;
                        xa[fi] = 0;
                        ya[fi] = 1;
                        za[fi] = fi + 4;
                    }
                    fi = fi + 4;
                    continue;
                }
            }
            if (fi + 4 < n && oa[fi] == 6 && oa[fi + 1] == 15 && (oa[fi + 2] == 3 || oa[fi + 2] == 2)
                && oa[fi + 3] == 16 && ya[fi + 3] == fi + 5
                && oa[fi + 4] == 5 && xa[fi + 4] == fi) {
                int sx = xa[fi];
                int sy = ya[fi];
                bool isGreedy = (sx == fi + 1 && sy == fi + 5);
                bool isLazy = (sx == fi + 5 && sy == fi + 1);
                if (isGreedy || isLazy) {
                    if (oa[fi + 2] == 3) {
                        oa[fi] = isGreedy ? 19 : 20;
                        xa[fi] = xa[fi + 2];
                        ya[fi] = 0;
                        za[fi] = fi + 5;
                    } else {
                        oa[fi] = isGreedy ? 21 : 22;
                        xa[fi] = 0;
                        ya[fi] = 0;
                        za[fi] = fi + 5;
                    }
                    fi = fi + 5;
                    continue;
                }
            }
            fi = fi + 1;
        }
    }

    public string Error() { return this.error; }
    public int GroupCount() { return this.groups; }
    public string Pattern() { return this.pattern; }

    public int GroupNumber(string name) {
        if (this.namedGroups != null) {
            for (int i = 0; i < this.namedGroups.Count; i = i + 1) {
                if (this.namedGroups[i].name == name) { return this.namedGroups[i].groupNum; }
            }
        }
        return -1;
    }

    public List<string> GroupNames() {
        List<string> names = new List<string>();
        if (this.namedGroups != null) {
            for (int i = 0; i < this.namedGroups.Count; i = i + 1) {
                names.Add(this.namedGroups[i].name);
            }
        }
        return names;
    }

    // 返回 `(cp << 3) | byteLen`，到达末尾返回 -1；非法 UTF-8（含过长编码、代理项、超 U+10FFFF）回退为 U+FFFD/1 字节以保证前进。
    public static int DecodeAt(nint buf, int len, int sp) {
        if (sp < 0 || sp >= len) { return -1; }
        int b0 = new Span<byte>(buf + sp, 1)[0];
        if (b0 < 128) { return (b0 * 8) | 1; }
        if (b0 < 194 || b0 > 244) { return (65533 * 8) | 1; }
        int need = 0;
        int cp = 0;
        if (b0 >= 240) {
            need = 3;
            cp = b0 - 240;
        } else if (b0 >= 224) {
            need = 2;
            cp = b0 - 224;
        } else {
            need = 1;
            cp = b0 - 192;
        }
        for (int k = 1; k <= need; k = k + 1) {
            if (sp + k >= len) { return (65533 * 8) | 1; }
            int b = new Span<byte>(buf + sp + k, 1)[0];
            if (b < 128 || b >= 192) { return (65533 * 8) | 1; }
            cp = cp * 64 + (b - 128);
        }
        if (need == 2 && (cp < 2048 || (cp >= 55296 && cp <= 57343))) {
            return (65533 * 8) | 1;
        }
        if (need == 3 && (cp < 65536 || cp > 1114111)) {
            return (65533 * 8) | 1;
        }
        return (cp * 8) | (need + 1);
    }

    public static int StepWidth(nint buf, int len, int sp) {
        int packed = RegexProgram.DecodeAt(buf, len, sp);
        return packed < 0 ? 1 : packed & 7;
    }

    // 直接从 string 解码 UTF-8 码点（零 NativeMemory 拷贝、零 Span 包装；拒绝过长/代理项/超 U+10FFFF）。
    public static int DecodeStrAt(string s, int len, int sp) {
        if (sp < 0 || sp >= len) { return -1; }
        int b0 = s[sp] & 255;
        if (b0 < 128) { return (b0 << 3) | 1; }
        if (b0 < 194 || b0 > 244) { return (65533 << 3) | 1; }
        int need = 0;
        int cp = 0;
        if (b0 >= 240) {
            need = 3;
            cp = b0 - 240;
        } else if (b0 >= 224) {
            need = 2;
            cp = b0 - 224;
        } else {
            need = 1;
            cp = b0 - 192;
        }
        for (int k = 1; k <= need; k = k + 1) {
            if (sp + k >= len) { return (65533 << 3) | 1; }
            int b = s[sp + k] & 255;
            if (b < 128 || b >= 192) { return (65533 << 3) | 1; }
            cp = (cp << 6) | (b - 128);
        }
        if (need == 2 && (cp < 2048 || (cp >= 55296 && cp <= 57343))) {
            return (65533 << 3) | 1;
        }
        if (need == 3 && (cp < 65536 || cp > 1114111)) {
            return (65533 << 3) | 1;
        }
        return (cp << 3) | (need + 1);
    }

    public static int StepWidthStr(string s, int len, int sp) {
        if (sp < 0 || sp >= len) { return 1; }
        int b0 = s[sp] & 255;
        if (b0 < 128) { return 1; }
        int packed = RegexProgram.DecodeStrAt(s, len, sp);
        return packed < 0 ? 1 : packed & 7;
    }

    public static int Utf8Len(int cp) {
        if (cp < 128) { return 1; }
        if (cp < 2048) { return 2; }
        if (cp < 65536) { return 3; }
        return 4;
    }

    public static int MaxInstructions() { return 65536; }

    public int Emit(int o, int x, int y, int z) {
        if (this.op.Count >= 65536) {
            if (this.error.Length == 0) {
                this.error = "compiled regex exceeds maximum instruction limit (65536)";
            }
            return this.op.Count > 0 ? this.op.Count - 1 : 0;
        }
        this.op.Add(o);
        this.ax.Add(x);
        this.ay.Add(y);
        this.az.Add(z);
        return this.op.Count - 1;
    }

    int Here() { return this.op.Count; }

    public static bool XIsPc(int o) {
        return o == RegexProgram.OpJmp() || o == RegexProgram.OpSplit();
    }

    public static bool YIsPc(int o) {
        return o == RegexProgram.OpSplit() || o == RegexProgram.OpLook()
            || o == RegexProgram.OpEmptyChk();
    }

    public int CopyRange(int from, int to) {
        if (this.error.Length > 0) { return this.op.Count; }
        int delta = this.op.Count - from;
        for (int i = from; i < to; i = i + 1) {
            if (this.error.Length > 0) { break; }
            int o = this.op[i];
            int x = RegexProgram.XIsPc(o) ? this.ax[i] + delta : this.ax[i];
            int y = RegexProgram.YIsPc(o) ? this.ay[i] + delta : this.ay[i];
            this.Emit(o, x, y, this.az[i]);
        }
        return delta;
    }

    // (?i) 仅做 ASCII 大小写折叠。
    public static int Fold(int c) {
        if (c >= 65 && c <= 90) { return c + 32; }
        return c;
    }

    public static bool IsWordCp(int c) {
        if (c >= 48 && c <= 57) { return true; }
        if (c >= 65 && c <= 90) { return true; }
        if (c >= 97 && c <= 122) { return true; }
        return c == 95;
    }

    public static bool InShorthand(int kind, int c) {
        if (kind == 100) { return c >= 48 && c <= 57; }
        if (kind == 119) { return RegexProgram.IsWordCp(c); }
        if (kind == 115) { return c == 32 || (c >= 9 && c <= 13); }
        return false;
    }

    public bool ClassHasSlow(int ci, int c) {
        int from = this.clsStart[ci];
        int to = from + this.clsCount[ci];
        bool hit = false;
        for (int i = from; i < to && !hit; i = i + 1) {
            if (this.clsKind[i] == 1) {
                if (!RegexProgram.InShorthand(this.clsLo[i], c)) { hit = true; }
            } else {
                int lo = this.clsLo[i];
                int hi = this.clsHi[i];
                if (c >= lo && c <= hi) { hit = true; }
                if (this.ignoreCase && !hit) {
                    int f = RegexProgram.Fold(c);
                    int u = f - 32;
                    if (f >= lo && f <= hi) { hit = true; }
                    if (c >= 97 && c <= 122 && u >= lo && u <= hi) { hit = true; }
                }
            }
        }
        return this.clsNeg[ci] == 1 ? !hit : hit;
    }

    public bool ClassHas(int ci, int c) {
        if (c >= 0 && c < 128 && this.clsMaskLo != null) {
            return c < 64
                ? ((this.clsMaskLo[ci] & (1L << c)) != 0L)
                : ((this.clsMaskHi[ci] & (1L << (c - 64))) != 0L);
        }
        return this.ClassHasSlow(ci, c);
    }

    // 复用 RegexRun 在指定起点执行一次匹配（零堆分配），返回匹配终点、-1 无匹配、-2 预算耗尽。
    public int RunAtStr(RegexRun run, int start, int origin) {
        int slots = this.groups * 2;
        for (int i = 0; i < slots; i = i + 1) { run.caps[i] = -1; }
        int mcnt = this.marks;
        if (mcnt > 0) {
            for (int i = 0; i < mcnt; i = i + 1) { run.marks[i] = -1; }
        }
        run.budget = 2000000;
        run.origin = origin;
        run.overflow = false;
        run.end = -1;
        if (this.Step(run, 0, start, 0)) { return run.end; }
        return run.overflow ? -2 : -1;
    }

    bool MatchAssertion(int o, int pc, RegexRun run, int sp) {
        int len = run.len;
        Span<byte> buf = new Span<byte>(run.inputPtr, len);
        if (o == 8) {
            if (sp == 0) { return true; }
            return this.multiline && (buf[sp - 1] & 255) == 10;
        }
        if (o == 9) {
            if (sp == len) { return true; }
            if ((buf[sp] & 255) != 10) { return false; }
            return this.multiline || sp == len - 1;
        }
        if (o == 12) { return sp == 0; }
        if (o == 13) {
            if (sp == len) { return true; }
            return this.axArr[pc] == 1 && sp == len - 1
                && (buf[sp] & 255) == 10;
        }
        if (o == 14) { return sp == run.origin; }
        bool before = sp > 0 && RegexProgram.IsWordCp(buf[sp - 1] & 255);
        bool after = false;
        if (sp < len) {
            int b = buf[sp] & 255;
            if (b < 128) {
                after = RegexProgram.IsWordCp(b);
            } else {
                int packed = RegexProgram.DecodeAt(run.inputPtr, len, sp);
                after = RegexProgram.IsWordCp(packed >> 3);
            }
        }
        bool boundary = before != after;
        return this.axArr[pc] == 1 ? boundary : !boundary;
    }

    int StepBackref(RegexRun run, int group, int sp) {
        int gs = run.caps[group * 2];
        int ge = run.caps[group * 2 + 1];
        if (gs < 0 || ge < gs) { return sp; }
        int n = ge - gs;
        if (sp + n > run.len) { return -1; }
        Span<byte> buf = new Span<byte>(run.inputPtr, run.len);
        for (int k = 0; k < n; k = k + 1) {
            int a = buf[gs + k] & 255;
            int b = buf[sp + k] & 255;
            if (a != b) {
                if (!this.ignoreCase || RegexProgram.Fold(a) != RegexProgram.Fold(b)) { return -1; }
            }
        }
        return sp + n;
    }

    public bool Step(RegexRun run, int pc, int sp, int depth) {
        if (depth > RegexProgram.MaxRecursionDepth) {
            throw new RegexBudgetException("regular expression recursion deeper than "
                + Convert.ToString(RegexProgram.MaxRecursionDepth)
                + " (pattern quantifier nesting on long input)");
        }
        int len = run.len;
        nint inpPtr = run.inputPtr;
        Span<byte> buf = new Span<byte>(inpPtr, len);
        while (true) {
            if (run.overflow) { return false; }
            run.budget = run.budget - 1;
            if (run.budget <= 0) {
                run.overflow = true;
                return false;
            }
            int o = this.opArr[pc];
            if (o == 3) {
                // OpClass (最热指令)
                if (sp >= len) { return false; }
                int b0 = buf[sp] & 255;
                int ci = this.axArr[pc];
                if (b0 < 128) {
                    long mask = b0 < 64 ? this.clsMaskLo[ci] : this.clsMaskHi[ci];
                    if ((mask & (1L << (b0 & 63))) == 0L) { return false; }
                    pc = pc + 1;
                    sp = sp + 1;
                } else {
                    int packed = RegexProgram.DecodeAt(inpPtr, len, sp);
                    if (packed < 0 || !this.ClassHasSlow(ci, packed >> 3)) { return false; }
                    pc = pc + 1;
                    sp = sp + (packed & 7);
                }
            } else if (o == 19) {
                // OpClassRepGreedy: 单条紧循环吞并连续字符类，再从最长处回溯
                int ci = this.axArr[pc];
                int minReq = this.ayArr[pc];
                int nextPc = this.azArr[pc];
                long mlo = this.clsMaskLo[ci];
                long mhi = this.clsMaskHi[ci];
                int startSp = sp;
                int cur = sp;
                bool hasNonAscii = false;
                while (cur < len) {
                    int b = buf[cur] & 255;
                    if (b < 128) {
                        long mask = b < 64 ? mlo : mhi;
                        if ((mask & (1L << (b & 63))) == 0L) { break; }
                        cur = cur + 1;
                    } else {
                        int packed = RegexProgram.DecodeAt(inpPtr, len, cur);
                        if (packed < 0 || !this.ClassHasSlow(ci, packed >> 3)) { break; }
                        hasNonAscii = true;
                        cur = cur + (packed & 7);
                    }
                }
                if (minReq > 0 && cur == startSp) { return false; }
                int spanLen = cur - startSp;
                if (spanLen > 0) {
                    run.budget = run.budget - spanLen;
                    if (run.budget <= 0) { run.overflow = true; return false; }
                }
                if (!hasNonAscii) {
                    int minSp = startSp + minReq;
                    while (cur > minSp) {
                        if (this.Step(run, nextPc, cur, depth + 1)) { return true; }
                        if (run.overflow) { return false; }
                        run.budget = run.budget - 1;
                        if (run.budget <= 0) { run.overflow = true; return false; }
                        cur = cur - 1;
                    }
                    pc = nextPc;
                    sp = cur;
                } else {
                    int[] pos = new int[spanLen + 1];
                    int cnt = 0;
                    int p = startSp;
                    pos[0] = p;
                    while (p < cur) {
                        int b = buf[p] & 255;
                        p = p + (b < 128 ? 1 : (RegexProgram.DecodeAt(inpPtr, len, p) & 7));
                        cnt = cnt + 1;
                        pos[cnt] = p;
                    }
                    int idx = cnt;
                    while (idx > minReq) {
                        if (this.Step(run, nextPc, pos[idx], depth + 1)) { return true; }
                        if (run.overflow) { return false; }
                        run.budget = run.budget - 1;
                        if (run.budget <= 0) { run.overflow = true; return false; }
                        idx = idx - 1;
                    }
                    pc = nextPc;
                    sp = pos[minReq];
                }
            } else if (o == 20) {
                // OpClassRepLazy: 先满足 minReq，再逐字符向后尝试
                int ci = this.axArr[pc];
                int minReq = this.ayArr[pc];
                int nextPc = this.azArr[pc];
                long mlo = this.clsMaskLo[ci];
                long mhi = this.clsMaskHi[ci];
                int cur = sp;
                if (minReq > 0) {
                    if (cur >= len) { return false; }
                    int b0 = buf[cur] & 255;
                    if (b0 < 128) {
                        long mask = b0 < 64 ? mlo : mhi;
                        if ((mask & (1L << (b0 & 63))) == 0L) { return false; }
                        cur = cur + 1;
                    } else {
                        int packed = RegexProgram.DecodeAt(inpPtr, len, cur);
                        if (packed < 0 || !this.ClassHasSlow(ci, packed >> 3)) { return false; }
                        cur = cur + (packed & 7);
                    }
                }
                while (true) {
                    if (this.Step(run, nextPc, cur, depth + 1)) { return true; }
                    if (run.overflow || cur >= len) { return false; }
                    run.budget = run.budget - 1;
                    if (run.budget <= 0) { run.overflow = true; return false; }
                    int b = buf[cur] & 255;
                    if (b < 128) {
                        long mask = b < 64 ? mlo : mhi;
                        if ((mask & (1L << (b & 63))) == 0L) { return false; }
                        cur = cur + 1;
                    } else {
                        int packed = RegexProgram.DecodeAt(inpPtr, len, cur);
                        if (packed < 0 || !this.ClassHasSlow(ci, packed >> 3)) { return false; }
                        cur = cur + (packed & 7);
                    }
                }
            } else if (o == 21) {
                // OpAnyRepGreedy: SIMD memchr 定位行尾，再反向回溯
                int minReq = this.ayArr[pc];
                int nextPc = this.azArr[pc];
                int startSp = sp;
                int limit = len;
                if (!this.dotAll && sp < len) {
                    int nl = NativeMemory.Find(inpPtr, sp, 10, len - sp);
                    if (nl >= 0) { limit = nl; }
                }
                if (minReq > 0 && limit == startSp) { return false; }
                int spanLen = limit - startSp;
                if (spanLen > 0) {
                    run.budget = run.budget - spanLen;
                    if (run.budget <= 0) { run.overflow = true; return false; }
                }
                bool hasNonAscii = false;
                for (int k = startSp; k < limit; k = k + 1) {
                    if ((buf[k] & 128) != 0) { hasNonAscii = true; break; }
                }
                if (!hasNonAscii) {
                    int minSp = startSp + minReq;
                    int cur = limit;
                    while (cur > minSp) {
                        if (this.Step(run, nextPc, cur, depth + 1)) { return true; }
                        if (run.overflow) { return false; }
                        run.budget = run.budget - 1;
                        if (run.budget <= 0) { run.overflow = true; return false; }
                        cur = cur - 1;
                    }
                    pc = nextPc;
                    sp = cur;
                } else {
                    int[] pos = new int[spanLen + 1];
                    int cnt = 0;
                    int p = startSp;
                    pos[0] = p;
                    while (p < limit) {
                        int b = buf[p] & 255;
                        p = p + (b < 128 ? 1 : (RegexProgram.DecodeAt(inpPtr, len, p) & 7));
                        cnt = cnt + 1;
                        pos[cnt] = p;
                    }
                    int idx = cnt;
                    while (idx > minReq) {
                        if (this.Step(run, nextPc, pos[idx], depth + 1)) { return true; }
                        if (run.overflow) { return false; }
                        run.budget = run.budget - 1;
                        if (run.budget <= 0) { run.overflow = true; return false; }
                        idx = idx - 1;
                    }
                    pc = nextPc;
                    sp = pos[minReq];
                }
            } else if (o == 22) {
                // OpAnyRepLazy
                int minReq = this.ayArr[pc];
                int nextPc = this.azArr[pc];
                int cur = sp;
                if (minReq > 0) {
                    if (cur >= len) { return false; }
                    int b0 = buf[cur] & 255;
                    if (b0 < 128) {
                        if (!this.dotAll && b0 == 10) { return false; }
                        cur = cur + 1;
                    } else {
                        int packed = RegexProgram.DecodeAt(inpPtr, len, cur);
                        if (packed < 0) { return false; }
                        cur = cur + (packed & 7);
                    }
                }
                while (true) {
                    if (this.Step(run, nextPc, cur, depth + 1)) { return true; }
                    if (run.overflow || cur >= len) { return false; }
                    run.budget = run.budget - 1;
                    if (run.budget <= 0) { run.overflow = true; return false; }
                    int b = buf[cur] & 255;
                    if (b < 128) {
                        if (!this.dotAll && b == 10) { return false; }
                        cur = cur + 1;
                    } else {
                        int packed = RegexProgram.DecodeAt(inpPtr, len, cur);
                        if (packed < 0) { return false; }
                        cur = cur + (packed & 7);
                    }
                }
            } else if (o == 1) {
                // OpChar
                if (sp >= len) { return false; }
                int b0 = buf[sp] & 255;
                int want = this.axArr[pc];
                if (b0 < 128) {
                    if (b0 != want && (!this.ignoreCase || RegexProgram.Fold(b0) != RegexProgram.Fold(want))) {
                        return false;
                    }
                    pc = pc + 1;
                    sp = sp + 1;
                } else {
                    int packed = RegexProgram.DecodeAt(inpPtr, len, sp);
                    if (packed < 0) { return false; }
                    int c = packed >> 3;
                    if (c != want && (!this.ignoreCase || RegexProgram.Fold(c) != RegexProgram.Fold(want))) {
                        return false;
                    }
                    pc = pc + 1;
                    sp = sp + (packed & 7);
                }
            } else if (o == 6) {
                // OpSplit
                if (this.Step(run, this.axArr[pc], sp, depth + 1)) { return true; }
                if (run.overflow) { return false; }
                pc = this.ayArr[pc];
            } else if (o == 5) {
                // OpJmp
                pc = this.axArr[pc];
            } else if (o == 7) {
                // OpSave
                int slot = this.axArr[pc];
                int old = run.caps[slot];
                run.caps[slot] = sp;
                if (this.Step(run, pc + 1, sp, depth + 1)) { return true; }
                run.caps[slot] = old;
                return false;
            } else if (o == 15) {
                // OpMark
                int slot = this.axArr[pc];
                int old = run.marks[slot];
                run.marks[slot] = sp;
                if (this.Step(run, pc + 1, sp, depth + 1)) { return true; }
                run.marks[slot] = old;
                return false;
            } else if (o == 16) {
                // OpEmptyChk
                pc = run.marks[this.axArr[pc]] == sp ? this.ayArr[pc] : pc + 1;
            } else if (o == 2) {
                // OpAny
                if (sp >= len) { return false; }
                int b0 = buf[sp] & 255;
                if (b0 < 128) {
                    if (!this.dotAll && b0 == 10) { return false; }
                    pc = pc + 1;
                    sp = sp + 1;
                } else {
                    int packed = RegexProgram.DecodeAt(inpPtr, len, sp);
                    if (packed < 0) { return false; }
                    pc = pc + 1;
                    sp = sp + (packed & 7);
                }
            } else if (o == 4) {
                // OpMatch
                run.end = sp;
                return true;
            } else if (o == 17) {
                // OpLook
                int kind = this.axArr[pc];
                int cont = this.ayArr[pc];
                int at = sp;
                if (kind == 2 || kind == 3) {
                    at = sp - this.azArr[pc];
                    if (at < 0) {
                        if (kind == 2) { return false; }
                        pc = cont;
                        continue;
                    }
                }
                int savedEnd = run.subEnd;
                run.subEnd = -1;
                bool ok = this.Step(run, pc + 1, at, depth + 1);
                if (run.overflow) { return false; }
                int subEnd = run.subEnd;
                run.subEnd = savedEnd;
                bool neg = kind == 1 || kind == 3;
                if (neg ? ok : !ok) { return false; }
                if (kind == 4) { sp = subEnd; }
                pc = cont;
            } else if (o == 18) {
                // OpLookEnd
                run.subEnd = sp;
                return true;
            } else if (o == 11) {
                // OpBackref
                int nextSp = this.StepBackref(run, this.axArr[pc], sp);
                if (nextSp < 0) { return false; }
                pc = pc + 1;
                sp = nextSp;
            } else {
                if (!this.MatchAssertion(o, pc, run, sp)) { return false; }
                pc = pc + 1;
            }
        }
        return false;
    }
}
