using System;

namespace System.Text.RegularExpressions;

// 正则表达式：搜索、提取、替换和分割。
// Regex re = Regex.Compile("(\\w+)=(\\d+)");
// Match m = re.Find("port=8080");
// 模式只编译一次（指令程序，见 RegexProgram），
// 之后可对多个输入匹配。匹配采用最左优先
// 回溯，与 Perl/.NET 相同：`a|ab` 优先 `a`，贪婪量词尽量多取，
// 需要时再让出；其惰性 `?` 形式
// 则相反。
// 匹配以 **UTF-8 码点** 为单位：`.` 吃掉整个字符（"中" 而不是它的
// 第一个字节），字符类里可以直接写非 ASCII 字符（`[中文]`）。
// 支持的语法：字面量、`.`、字符类 `[a-z]` / `[^a-z]`（类内可用
// `\d \D \w \W \s \S` 与 POSIX `[[:digit:]]` 等）、
// `\d \D \w \W \s \S \b \B \A \z \Z \G`、
// 转义 `\n \r \t \f \v \a \e \0 \xHH \x{...} \uXXXX \cX`、
// 分组 `( )` `(?: )` `(?&lt;name&gt; )`、原子组 `(?&gt; )`、注释 `(?# )`、
// 环视 `(?= ) (?! ) (?&lt;= ) (?&lt;! )`（回顾须定长）、交替 `|`、
// 量词 `* + ? {n} {n,} {n,m}`（均有惰性形式）、锚点 `^ $`、
// 反向引用 `\1`-`\99` 与 `\k&lt;name&gt;`，以及只能写在模式开头的
// 内联标志 `(?i)`（ASCII 大小写）、`(?m)`（`^ $` 匹配行边界）、
// `(?s)`（`.` 也匹配换行）。
// 大小写折叠与 `\d \w \s` 都只覆盖 ASCII；`\p{...}`、占有量词、
// 八进制转义、作用域内联标志 `(?i:...)` 等未实现的语法在
// **编译期报错**，不会被当成普通字符"接受但永不匹配"。
// 格式错误的模式在编译期抛出 ArgumentException。为避免病态模式
// 失控，匹配器设有回溯步骤预算：耗尽时抛出
// <see cref="RegexBudgetException"/>，而不是把超时伪装成"无匹配"。
public class Regex {
    RegexProgram prog;
    string pattern;

    public Regex() {
        this.prog = null;
        this.pattern = "";
    }

    public Regex(string pattern) {
        Regex re = Regex.CompileOptions(pattern, false);
        this.prog = re.prog;
        this.pattern = re.pattern;
    }

    public Regex(string pattern, bool ignoreCase) {
        Regex re = Regex.CompileOptions(pattern, ignoreCase);
        this.prog = re.prog;
        this.pattern = re.pattern;
    }

    // 编译 `pattern`，格式
    // 非法时抛出 ArgumentException。
    public static Regex Compile(string pattern) {
        return Regex.CompileOptions(pattern, false);
    }

    // 编译 `pattern`，可选择对 ASCII 字母
    // 不区分大小写。
    public static Regex CompileOptions(string pattern, bool ignoreCase) {
        if (pattern == null) {
            throw new ArgumentException("Invalid regular expression: pattern is null");
        }
        RegexProgram p = RegexProgram.Compile(pattern, ignoreCase);
        if (p.Error().Length > 0) {
            // throw 不会释放此帧的局部变量，所以先丢弃失败的
            // 程序再退出
            string why = p.Error();
            p = null;
            throw new ArgumentException("Invalid regular expression '" + pattern
                                        + "': " + why);
        }
        Regex re = new Regex();
        re.prog = p;
        re.pattern = pattern;
        return re;
    }

    // `pattern` 非法的原因，编译通过则为 ""。
    // 让调用方无需捕获异常即可检查用户输入的模式。
    public static string Validate(string pattern) {
        if (pattern == null) { return "pattern is null"; }
        RegexProgram p = RegexProgram.Compile(pattern, false);
        return p.Error();
    }

    // 此实例编译所用的模式。
    public string Pattern() { return this.pattern; }

    // 捕获组数量，含组 0。
    public int GroupCount() { return this.prog.GroupCount(); }

    // 命名组 `name` 的组号，没有该名字时返回 -1。
    public int GroupNumber(string name) { return this.prog.GroupNumber(name); }

    // 所有命名组的名字。
    public List<string> GroupNames() { return this.prog.GroupNames(); }

    // 模式在 `input` 任意位置匹配时返回 true（零 Match 分配快路径）。
    public bool IsMatch(string input) {
        if (input == null) { return false; }
        int len = input.Length;
        RegexRun run = RegexRun.Create(input, len, this.prog.GroupCount() * 2, this.prog.MarkCount());
        int rc = this.ScanFromStr(input, len, 0, run);
        if (rc == -2) { this.Overflow(0); }
        return rc >= 0;
    }

    // 最左侧的匹配；无匹配则返回失败的 Match。
    public Match Find(string input) {
        return this.FindFrom(input, 0);
    }

    // 从 `start` 处或之后开始的最左侧匹配（零拷贝直读 string）。
    public Match FindFrom(string input, int start) {
        if (input == null) { return Match.Failure(); }
        int len = input.Length;
        if (start < 0) { start = 0; }
        if (start > len) { return Match.Failure(); }
        RegexRun run = RegexRun.Create(input, len, this.prog.GroupCount() * 2, this.prog.MarkCount());
        int rc = this.ScanFromStr(input, len, start, run);
        if (rc == -2) { this.Overflow(start); }
        if (rc < 0) { return Match.Failure(); }
        return Match.FromCapsArr(input, run.caps, this.prog.GroupCount());
    }

    // 在 `input` 上从 `start` 起找最左匹配（复用 RegexRun，带起始/必现字节 SIMD 预过滤）。
    // 返回 0 表示成功（`run.caps` 已填好），-1 无匹配，-2 预算耗尽。
    public int ScanFromStr(string input, int len, int start, RegexRun run) {
        RegexProgram p = this.prog;
        nint ptr = run.inputPtr;
        int sk = p.startKind;
        int reqB = p.reqByte;
        if (sk == 4) {
            // C+ R 锚定反向预过滤：SIMD memchr 直跳 R，再反扫连续 C 起点（严格保最左匹配语义）
            Span<byte> buf4 = new Span<byte>(ptr, len);
            long mlo = p.startMaskLo;
            long mhi = p.startMaskHi;
            int search = start + 1;
            while (search < len) {
                int hit = NativeMemory.Find(ptr, search, reqB, len - search);
                if (hit < 0) { return -1; }
                int rStart = hit;
                while (rStart > start) {
                    int b = buf4[rStart - 1] & 255;
                    if (b >= 128) { break; }
                    long m = b < 64 ? mlo : mhi;
                    if ((m & (1L << (b & 63))) == 0L) { break; }
                    rStart = rStart - 1;
                }
                for (int at4 = rStart; at4 < hit; at4 = at4 + 1) {
                    int end4 = p.RunAtStr(run, at4, start);
                    if (end4 == -2) { return -2; }
                    if (end4 >= 0) { return 0; }
                }
                search = hit + 1;
            }
            return -1;
        }
        // 必现字面量快拒：SIMD memchr 一步排除无命中输入
        int nextReq = len;
        if (reqB > 0) {
            if (start >= len) { return -1; }
            nextReq = NativeMemory.Find(ptr, start, reqB, len - start);
            if (nextReq < 0) { return -1; }
        }
        if (sk == 1) {
            // 仅在开头匹配 (^ / \A)
            if (start != 0) { return -1; }
            int end0 = p.RunAtStr(run, 0, start);
            if (end0 == -2) { return -2; }
            return end0 >= 0 ? 0 : -1;
        }
        if (sk == 2) {
            // 精确 ASCII 首字节：用 SIMD NativeMemory.Find 直接跳至候选起点
            int sb0 = p.startByte;
            int at = start;
            while (at < len) {
                int hit = NativeMemory.Find(ptr, at, sb0, len - at);
                if (hit < 0) { return -1; }
                if (reqB > 0 && hit > nextReq) {
                    nextReq = NativeMemory.Find(ptr, hit, reqB, len - hit);
                    if (nextReq < 0) { return -1; }
                }
                int end = p.RunAtStr(run, hit, start);
                if (end == -2) { return -2; }
                if (end >= 0) { return 0; }
                at = hit + 1;
            }
            return -1;
        }
        if (sk == 3) {
            // 起始字符类 128 位 ASCII 位图快跳：Span 零 ARC 直读
            Span<byte> buf3 = new Span<byte>(ptr, len);
            long mlo = p.startMaskLo;
            long mhi = p.startMaskHi;
            bool allowNonAscii = p.startAllowsNonAscii;
            int at = start;
            while (at < len) {
                int b = buf3[at] & 255;
                if (b < 128) {
                    long mask = b < 64 ? mlo : mhi;
                    if ((mask & (1L << (b & 63))) == 0L) {
                        at = at + 1;
                        continue;
                    }
                } else if (!allowNonAscii) {
                    at = at + RegexProgram.StepWidth(ptr, len, at);
                    continue;
                }
                if (reqB > 0 && at > nextReq) {
                    nextReq = NativeMemory.Find(ptr, at, reqB, len - at);
                    if (nextReq < 0) { return -1; }
                }
                int end = p.RunAtStr(run, at, start);
                if (end == -2) { return -2; }
                if (end >= 0) { return 0; }
                at = at + (b < 128 ? 1 : RegexProgram.StepWidth(ptr, len, at));
            }
            return -1;
        }
        int at0 = start;
        while (true) {
            int end = p.RunAtStr(run, at0, start);
            if (end == -2) { return -2; }
            if (end >= 0) { return 0; }
            if (at0 >= len) { return -1; }
            at0 = at0 + RegexProgram.StepWidth(ptr, len, at0);
        }
        return -1;
    }

    // 回溯预算耗尽：把它作为错误报出去，调用方才能
    // 区分"这个模式在这段输入上代价失控"和"确实没有匹配"。
    public void Overflow(int start) {
        throw new RegexBudgetException("regular expression '" + this.pattern
            + "' exhausted its backtracking budget at offset " + start);
    }

    // 从左到右的所有不重叠匹配。空匹配会前进一个码点，
    // 保证扫描必然终止。
    public List<Match> Matches(string input) {
        List<Match> all = new List<Match>();
        if (input == null) { return all; }
        int len = input.Length;
        int groups = this.prog.GroupCount();
        RegexRun run = RegexRun.Create(input, len, groups * 2, this.prog.MarkCount());
        int at = 0;
        while (at <= len) {
            int rc = this.ScanFromStr(input, len, at, run);
            if (rc == -2) { this.Overflow(at); }
            if (rc < 0) { break; }
            Match m = Match.FromCapsArr(input, run.caps, groups);
            all.Add(m);
            int mStart = run.caps[0];
            int mEnd = run.caps[1];
            int next = mEnd;
            if (mEnd == mStart) {
                next = next + RegexProgram.StepWidthStr(input, len, next);
            }
            at = next;
        }
        return all;
    }

    // 不重叠匹配的数量（零 Match / 零 List 分配快路径）。
    public int Count(string input) {
        if (input == null) { return 0; }
        int len = input.Length;
        int groups = this.prog.GroupCount();
        RegexRun run = RegexRun.Create(input, len, groups * 2, this.prog.MarkCount());
        int total = 0;
        int at = 0;
        while (at <= len) {
            int rc = this.ScanFromStr(input, len, at, run);
            if (rc == -2) { this.Overflow(at); }
            if (rc < 0) { break; }
            total = total + 1;
            int mStart = run.caps[0];
            int mEnd = run.caps[1];
            int next = mEnd;
            if (mEnd == mStart) {
                next = next + RegexProgram.StepWidthStr(input, len, next);
            }
            at = next;
        }
        return total;
    }

    // 替换所有匹配。`replacement` 里 `$1` / `${1}` /
    // `${name}` 是捕获组，`$&amp;` 是整个匹配，`$$` 是字面量 '$'。
    // 预编译替换模板为扁平段表，直接写入单一 byte[] 缓冲，零中间 string 分配。
    public string Replace(string input, string replacement) {
        if (input == null) { return ""; }
        int len = input.Length;
        int groups = this.prog.GroupCount();
        RegexRun run = RegexRun.Create(input, len, groups * 2, this.prog.MarkCount());
        int rc = this.ScanFromStr(input, len, 0, run);
        if (rc == -2) { this.Overflow(0); }
        if (rc < 0) { return input; }

        string rep = replacement == null ? "" : replacement;
        int repLen = rep.Length;
        nint repPtr = repLen > 0 ? (nint)rep : (nint)0;
        bool plain = repLen == 0 || NativeMemory.Find(repPtr, 0, 36, repLen) < 0;

        // 预解析含 '$' 的替换模板为 (kind, a, b) 段：
        // kind=0 表示 rep[a..a+b) 字面量；kind=1 表示捕获组号 a；kind=2 表示单个 '$' 字节。
        int[] segKind = null;
        int[] segA = null;
        int[] segB = null;
        int segCount = 0;
        if (!plain) {
            int maxSeg = repLen + 2;
            segKind = new int[maxSeg];
            segA = new int[maxSeg];
            segB = new int[maxSeg];
            Span<byte> rbuf = new Span<byte>(repPtr, repLen);
            int i = 0;
            int start = 0;
            while (i < repLen) {
                int c = rbuf[i] & 255;
                if (c != 36 || i + 1 >= repLen) {
                    i = i + 1;
                    continue;
                }
                if (i > start) {
                    segKind[segCount] = 0;
                    segA[segCount] = start;
                    segB[segCount] = i - start;
                    segCount = segCount + 1;
                }
                int d = rbuf[i + 1] & 255;
                if (d == 36) {
                    segKind[segCount] = 2;
                    segA[segCount] = 0;
                    segB[segCount] = 1;
                    segCount = segCount + 1;
                    i = i + 2;
                    start = i;
                } else if (d == 38) {
                    segKind[segCount] = 1;
                    segA[segCount] = 0;
                    segB[segCount] = 0;
                    segCount = segCount + 1;
                    i = i + 2;
                    start = i;
                } else if (d == 123) {
                    int close = NativeMemory.Find(repPtr, i + 2, 125, repLen - (i + 2));
                    if (close < 0) {
                        i = i + 1;
                        start = i - 1;
                    } else {
                        string body = NativeMemory.GetString(repPtr, i + 2, close - i - 2);
                        int gi = this.RefNumber(body);
                        if (gi < 0) {
                            segKind[segCount] = 0;
                            segA[segCount] = i;
                            segB[segCount] = close - i + 1;
                            segCount = segCount + 1;
                        } else if (gi < groups) {
                            segKind[segCount] = 1;
                            segA[segCount] = gi;
                            segB[segCount] = 0;
                            segCount = segCount + 1;
                        }
                        i = close + 1;
                        start = i;
                    }
                } else if (d >= 48 && d <= 57) {
                    int gi = d - 48;
                    int j = i + 2;
                    while (j < repLen) {
                        int dj = rbuf[j] & 255;
                        if (dj >= 48 && dj <= 57 && gi * 10 + (dj - 48) < groups) {
                            gi = gi * 10 + (dj - 48);
                            j = j + 1;
                        } else {
                            break;
                        }
                    }
                    if (gi < groups) {
                        segKind[segCount] = 1;
                        segA[segCount] = gi;
                        segB[segCount] = 0;
                        segCount = segCount + 1;
                    }
                    i = j;
                    start = i;
                } else {
                    i = i + 1;
                    start = i - 1;
                }
            }
            if (start < repLen) {
                segKind[segCount] = 0;
                segA[segCount] = start;
                segB[segCount] = repLen - start;
                segCount = segCount + 1;
            }
        }

        int cap = len > 2147483527 ? 2147483591 : len + 64;
        byte[] outBuf = new byte[cap];
        int outLen = 0;
        nint inPtr = run.inputPtr;
        int[] caps = run.caps;
        int outPos = 0;
        int at = 0;
        while (true) {
            int mStart = caps[0];
            int mEnd = caps[1];
            int gap = mStart - outPos;
            if (gap > 0) {
                if ((long)outLen + (long)gap > (long)cap) {
                    outBuf = Regex.GrowReplaceBuf(outBuf, outLen, gap);
                    cap = outBuf.Length;
                }
                NativeMemory.Copy((nint)outBuf + outLen, inPtr + outPos, gap);
                outLen = outLen + gap;
            }
            if (plain) {
                if (repLen > 0) {
                    if ((long)outLen + (long)repLen > (long)cap) {
                        outBuf = Regex.GrowReplaceBuf(outBuf, outLen, repLen);
                        cap = outBuf.Length;
                    }
                    NativeMemory.Copy((nint)outBuf + outLen, repPtr, repLen);
                    outLen = outLen + repLen;
                }
            } else {
                for (int s = 0; s < segCount; s = s + 1) {
                    int k = segKind[s];
                    if (k == 0) {
                        int slen = segB[s];
                        if ((long)outLen + (long)slen > (long)cap) {
                            outBuf = Regex.GrowReplaceBuf(outBuf, outLen, slen);
                            cap = outBuf.Length;
                        }
                        if (slen == 1) {
                            outBuf[outLen] = (byte)(rep[segA[s]] & 255);
                        } else {
                            NativeMemory.Copy((nint)outBuf + outLen, repPtr + segA[s], slen);
                        }
                        outLen = outLen + slen;
                    } else if (k == 1) {
                        int gi = segA[s];
                        int gs = caps[gi * 2];
                        int ge = caps[gi * 2 + 1];
                        int glen = ge - gs;
                        if (gs >= 0 && glen > 0) {
                            if ((long)outLen + (long)glen > (long)cap) {
                                outBuf = Regex.GrowReplaceBuf(outBuf, outLen, glen);
                                cap = outBuf.Length;
                            }
                            NativeMemory.Copy((nint)outBuf + outLen, inPtr + gs, glen);
                            outLen = outLen + glen;
                        }
                    } else {
                        if ((long)outLen + 1L > (long)cap) {
                            outBuf = Regex.GrowReplaceBuf(outBuf, outLen, 1);
                            cap = outBuf.Length;
                        }
                        outBuf[outLen] = 36;
                        outLen = outLen + 1;
                    }
                }
            }
            outPos = mEnd;
            int next = mEnd;
            if (mEnd == mStart) {
                next = next + RegexProgram.StepWidth(inPtr, len, next);
            }
            at = next;
            if (at > len) { break; }
            rc = this.ScanFromStr(input, len, at, run);
            if (rc == -2) { this.Overflow(at); }
            if (rc < 0) { break; }
        }
        int tail = len - outPos;
        if (tail > 0) {
            if ((long)outLen + (long)tail > (long)cap) {
                outBuf = Regex.GrowReplaceBuf(outBuf, outLen, tail);
            }
            NativeMemory.Copy((nint)outBuf + outLen, inPtr + outPos, tail);
            outLen = outLen + tail;
        }
        return NativeMemory.GetString((nint)outBuf, 0, outLen);
    }

    private static byte[] GrowReplaceBuf(byte[] outBuf, int outLen, int extra) {
        long need = (long)outLen + (long)extra;
        if (need > 2147483591L) {
            throw new InvalidOperationException("Regex.Replace output exceeds maximum byte length");
        }
        long ncap = (long)outBuf.Length;
        if (ncap < 64L) { ncap = 64L; }
        while (ncap < need) {
            ncap = ncap * 2L;
            if (ncap > 2147483591L) { ncap = 2147483591L; break; }
        }
        byte[] nb = new byte[(int)ncap];
        if (outLen > 0) { NativeMemory.Copy((nint)nb, (nint)outBuf, outLen); }
        return nb;
    }

    // 零 Match / 零临时 StringBuilder 直接把替换串展开写入目标 sb。
    private void AppendExpanded(StringBuilder sb, nint inPtr, int[] caps, int groups, string replacement) {
        int n = replacement.Length;
        nint rPtr = (nint)replacement;
        Span<byte> rbuf = new Span<byte>(rPtr, n);
        int i = 0;
        int start = 0;
        while (i < n) {
            int c = rbuf[i] & 255;
            if (c != 36 || i + 1 >= n) {
                i = i + 1;
                continue;
            }
            if (i > start) {
                sb.Append(NativeMemory.GetString(rPtr, start, i - start));
            }
            int d = rbuf[i + 1] & 255;
            if (d == 36) {
                sb.Append("$");
                i = i + 2;
                start = i;
            } else if (d == 38) {
                int gs0 = caps[0];
                int ge0 = caps[1];
                if (gs0 >= 0 && ge0 > gs0) {
                    sb.Append(NativeMemory.GetString(inPtr, gs0, ge0 - gs0));
                }
                i = i + 2;
                start = i;
            } else if (d == 123) {
                int close = NativeMemory.Find(rPtr, i + 2, 125, n - (i + 2));
                if (close < 0) {
                    i = i + 1;
                    start = i - 1;
                } else {
                    string body = NativeMemory.GetString(rPtr, i + 2, close - i - 2);
                    int gi = this.RefNumber(body);
                    if (gi < 0) {
                        sb.Append(NativeMemory.GetString(rPtr, i, close - i + 1));
                    } else if (gi < groups) {
                        int gs = caps[gi * 2];
                        int ge = caps[gi * 2 + 1];
                        if (gs >= 0 && ge > gs) {
                            sb.Append(NativeMemory.GetString(inPtr, gs, ge - gs));
                        }
                    }
                    i = close + 1;
                    start = i;
                }
            } else if (d >= 48 && d <= 57) {
                int gi = d - 48;
                int j = i + 2;
                while (j < n) {
                    int dj = rbuf[j] & 255;
                    if (dj >= 48 && dj <= 57 && gi * 10 + (dj - 48) < groups) {
                        gi = gi * 10 + (dj - 48);
                        j = j + 1;
                    } else {
                        break;
                    }
                }
                if (gi < groups) {
                    int gs = caps[gi * 2];
                    int ge = caps[gi * 2 + 1];
                    if (gs >= 0 && ge > gs) {
                        sb.Append(NativeMemory.GetString(inPtr, gs, ge - gs));
                    }
                }
                i = j;
                start = i;
            } else {
                i = i + 1;
                start = i - 1;
            }
        }
        if (start < n) {
            sb.Append(NativeMemory.GetString(rPtr, start, n - start));
        }
    }

    // 仅替换第一个匹配。
    public string ReplaceFirst(string input, string replacement) {
        Match m = this.Find(input);
        if (!m.Success()) { return input; }
        StringBuilder sb = new StringBuilder();
        sb.Append(input.Substring(0, m.Index()));
        sb.Append(this.ExpandFor(replacement, m));
        int at = m.Index() + m.Length();
        if (at < input.Length) {
            sb.Append(input.Substring(at, input.Length - at));
        }
        return sb.ToString();
    }

    // 按 `replacement` 里的 `$1` / `${12}` / `${name}` /
    // `$&amp;` / `$$` 展开替换文本。供"先匹配、再单独构建替换串"的场景
    // 使用（例如 FindBar 逐个替换时只取展开后的文本喂给编辑器），规则与
    // Replace / ReplaceFirst 内部的展开完全一致。
    public string Expand(string replacement, Match m) {
        return this.ExpandFor(replacement, m);
    }

    // 在替换字符串中展开 `$1` / `${12}` / `${name}` /
    // `$&amp;` / `$$`。无法解析的 `$` 原样保留。
    public string ExpandFor(string replacement, Match m) {
        if (replacement == null || replacement.Length == 0) { return ""; }
        if (replacement.IndexOf("$") < 0) { return replacement; }
        StringBuilder sb = new StringBuilder();
        int i = 0;
        int start = 0;
        int n = replacement.Length;
        while (i < n) {
            int c = replacement[i] & 255;
            if (c != 36 || i + 1 >= n) {
                i = i + 1;
                continue;
            }
            if (i > start) {
                sb.Append(replacement.Substring(start, i - start));
            }
            int d = replacement[i + 1] & 255;
            if (d == 36) {
                sb.Append("$");
                i = i + 2;
                start = i;
            } else if (d == 38) {
                sb.Append(m.Group(0));
                i = i + 2;
                start = i;
            } else if (d == 123) {
                int close = replacement.IndexOf("}", i + 2);
                if (close < 0) {
                    i = i + 1;
                    start = i - 1;
                } else {
                    string body = replacement.Substring(i + 2, close - i - 2);
                    int gi = this.RefNumber(body);
                    if (gi < 0) {
                        sb.Append(replacement.Substring(i, close - i + 1));
                    } else {
                        sb.Append(m.Group(gi));
                    }
                    i = close + 1;
                    start = i;
                }
            } else if (d >= 48 && d <= 57) {
                int gi = d - 48;
                int j = i + 2;
                while (j < n) {
                    int dj = replacement[j] & 255;
                    if (dj >= 48 && dj <= 57 && gi * 10 + (dj - 48) < this.prog.GroupCount()) {
                        gi = gi * 10 + (dj - 48);
                        j = j + 1;
                    } else {
                        break;
                    }
                }
                sb.Append(m.Group(gi));
                i = j;
                start = i;
            } else {
                i = i + 1;
                start = i - 1;
            }
        }
        if (start < n) {
            sb.Append(replacement.Substring(start, n - start));
        }
        return sb.ToString();
    }

    // `${...}` 里的组号或组名对应的组号，无法解析时 -1。
    public int RefNumber(string body) {
        if (body == null || body.Length == 0) { return -1; }
        long v = 0L;
        int len = body.Length;
        int gc = this.prog.GroupCount();
        for (int i = 0; i < len; i = i + 1) {
            int c = body[i] & 255;
            if (c < 48 || c > 57) {
                return this.prog.GroupNumber(body);
            }
            v = v * 10L + (long)(c - 48);
            if (v >= (long)gc) { return -1; }
        }
        return (int)v;
    }

    // 十进制字符的数值（'0'-&gt;0 … '9'-&gt;9）；非数字字符返回 0。
    public static int DigitValue(string d) {
        if (d == null || d.Length == 0) { return 0; }
        int c = d[0] & 255;
        if (c >= 0x30 && c <= 0x39) { return c - 0x30; }
        return 0;
    }

    // 判断是否为十进制字符 '0'-'9'。
    public static bool IsDigit(string d) {
        if (d == null || d.Length == 0) { return false; }
        int c = d[0] & 255;
        return c >= 0x30 && c <= 0x39;
    }

    // 在每个匹配处分割 `input`。空匹配会被跳过，
    // 因此能匹配空串的模式不会让结果爆炸。
    public List<string> Split(string input) {
        List<string> parts = new List<string>();
        if (input == null) { return parts; }
        List<Match> all = this.Matches(input);
        int at = 0;
        for (int i = 0; i < all.Count; i = i + 1) {
            Match m = all[i];
            if (m.Length() > 0) {
                parts.Add(input.Substring(at, m.Index() - at));
                at = m.Index() + m.Length();
            }
        }
        parts.Add(input.Substring(at, input.Length - at));
        return parts;
    }

    // 一次性匹配，不保留编译后的模式。
    public static bool Matched(string input, string pattern) {
        return Regex.Compile(pattern).IsMatch(input);
    }

    // 一次性替换，不保留编译后的模式。
    public static string Replaced(string input, string pattern, string replacement) {
        return Regex.Compile(pattern).Replace(input, replacement);
    }

    public static bool IsMatch(string input, string pattern) {
        return Matched(input, pattern);
    }

    public static Match Match(string input, string pattern) {
        return Regex.Compile(pattern).Find(input);
    }

    public static string Replace(string input, string pattern, string replacement) {
        return Replaced(input, pattern, replacement);
    }

    public static bool IsMetaChar(int c) {
        return c == 92 || c == 46 || c == 94 || c == 36 || c == 124
            || c == 40 || c == 41 || c == 91 || c == 93 || c == 123
            || c == 125 || c == 42 || c == 43 || c == 63 || c == 45 || c == 35;
    }

    // 转义 `text` 中的元字符，使其
    // 按字面匹配（单遍惰性 StringBuilder，零单字符 Substring）。
    public static string Escape(string text) {
        if (text == null) { return ""; }
        int n = text.Length;
        if (n == 0) { return ""; }
        StringBuilder sb = null;
        int start = 0;
        for (int i = 0; i < n; i = i + 1) {
            if (Regex.IsMetaChar(text[i] & 255)) {
                if (sb == null) { sb = new StringBuilder(); }
                if (i > start) {
                    sb.Append(text.Substring(start, i - start));
                }
                sb.Append("\\");
                start = i;
            }
        }
        if (sb == null) { return text; }
        if (n > start) {
            sb.Append(text.Substring(start, n - start));
        }
        return sb.ToString();
    }
}
