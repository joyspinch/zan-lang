using System;
using System.Json;
namespace System.Text;

public class Bm25Document {
    public int id;
    public int length;
    public long order;
    Dictionary<string, Bm25Term> terms = new Dictionary<string, Bm25Term>();
    List<Bm25Term> termList = new List<Bm25Term>();

    public Bm25Document(int id, long order) {
        this.id = id;
        this.order = order;
    }
}

