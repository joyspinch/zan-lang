using System;

namespace System.Text;

// 模糊字符串匹配：用于符号/文件搜索的子序列打分，外加
// 按查询词对文档排序的 BM25 索引。纯算法实现，
// 不依赖平台。
// 核心契约与语义定义。
class Fuzzy {
    static bool SameByte(int a, int b) {
        if (a == b) { return true; }
        if (a >= 65 && a <= 90) { a = a + 32; }
        if (b >= 65 && b <= 90) { b = b + 32; }
        return a == b;
    }

    // 当 `query` 作为 `candidate` 的子序列出现时返回 true
    // （字符按顺序、忽略大小写）。
    static bool Matches(string query, string candidate) {
        if (query == null || query.Length == 0) { return true; }
        if (candidate == null) { return false; }
        int qlen = query.Length;
        int clen = candidate.Length;
        int qi = 0;
        for (int ci = 0; ci < clen && qi < qlen; ci = ci + 1) {
            int qa = query[qi] & 255;
            int ca = candidate[ci] & 255;
            if (Fuzzy.SameByte(qa, ca)) {
                qi = qi + 1;
            }
        }
        return qi == qlen;
    }

    // [0,1] 的相似度：完全匹配（忽略大小写）为 1.0，
    // 有间隔则递减。连续片段、词首和驼峰边界有加分
    // （因此对 "FileList"，"flst" 优于 "flts"）。
    // `query` 不是子序列时返回 0。
    static double Score(string query, string candidate) {
        if (query == null || query.Length == 0) { return 1.0; }
        if (candidate == null || candidate.Length == 0) { return 0.0; }
        if (!Fuzzy.Matches(query, candidate)) { return 0.0; }
        if (Fuzzy.SameStrIgnoreCase(query, candidate)) { return 1.0; }

        // 贪婪最左匹配，统计连续长度与边界命中。
        int score = 0;
        int qi = 0;
        int run = 0;
        int qlen = query.Length;
        int clen = candidate.Length;
        for (int ci = 0; ci < clen && qi < qlen; ci = ci + 1) {
            int qa = query[qi] & 255;
            int ca = candidate[ci] & 255;
            if (Fuzzy.SameByte(qa, ca)) {
                run = run + 1;
                // 连续匹配比孤立字符得分更高。
                int gain = 1;
                if (run >= 2) { gain = 2; }
                // 边界加分：词首或驼峰边界。
                if (run == 1) {
                    if (ci == 0 || Fuzzy.IsBoundary(candidate, ci)) { gain = 3; }
                }
                score = score + gain;
                qi = qi + 1;
            } else {
                run = 0;
            }
        }
        double maxScore = (double)(query.Length * 3);
        double s = (double)score;
        return s / maxScore;
    }

    // 判断 s[i] 是否落在词边界上：边界指紧跟非字母的字母，
    // 或紧邻大写字母的小写字母（驼峰）。i 为 0 视为词首，返回 true。
    static bool IsBoundary(string s, int i) {
        if (i <= 0) { return true; }
        if (s == null || i >= s.Length) { return false; }
        int p = s[i - 1] & 255;
        int c = s[i] & 255;
        bool prevAlpha = (p >= 65 && p <= 90) || (p >= 97 && p <= 122);
        bool curAlpha = (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
        if (!prevAlpha && curAlpha) { return true; }
        bool prevLower = (p >= 97 && p <= 122);
        bool curUpper = (c >= 65 && c <= 90);
        if (prevLower && curUpper) { return true; }
        return false;
    }

    // 判断是否为 ASCII 字母（A-Z、a-z），只看首字符的低 8 位。
    static bool IsLetter(string ch) {
        if (ch == null || ch.Length == 0) { return false; }
        int c = ch[0] & 255;
        return (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
    }

    // 判断是否为 ASCII 大写字母（A-Z），只看首字符的低 8 位。
    static bool IsUpper(string ch) {
        if (ch == null || ch.Length == 0) { return false; }
        int c = ch[0] & 255;
        return c >= 65 && c <= 90;
    }

    // 判断是否为 ASCII 小写字母（a-z），只看首字符的低 8 位。
    static bool IsLower(string ch) {
        if (ch == null || ch.Length == 0) { return false; }
        int c = ch[0] & 255;
        return c >= 97 && c <= 122;
    }

    // 忽略大小写比较两个单字符（转小写后判等）。
    static bool SameChar(string a, string b) {
        if (a == null || b == null || a.Length == 0 || b.Length == 0) { return false; }
        return Fuzzy.SameByte(a[0] & 255, b[0] & 255);
    }

    // 区分大小写的字符串相等（`==` 的具名包装）。
    static bool SameStr(string a, string b) {
        return a == b;
    }

    // 忽略大小写的相等：完全匹配的定义（Score 承诺 1.0）
    // 与 <see cref="Matches"/> 一样不区分大小写。
    static bool SameStrIgnoreCase(string a, string b) {
        if (a == null || b == null) { return a == b; }
        if (a.Length != b.Length) { return false; }
        for (int i = 0; i < a.Length; i = i + 1) {
            if (!Fuzzy.SameByte(a[i] & 255, b[i] & 255)) { return false; }
        }
        return true;
    }
}
