using System;

namespace System.Text;

/// <summary>
/// Converts Chinese characters to pinyin (the official romanization) for
/// search, sorting and abbreviation matching — the same job the IDE's
/// symbol/file search does. Covers every GB2312 hanzi (level 1 + level 2,
/// 6763 characters); polyphones use their most common reading, which is what
/// search/ordering consumers want.
/// string py = Pinyin.ToPinyin("中文");     // "zhongwen"
/// string ab = Pinyin.Initials("中文");     // "ZW"
/// string py = Pinyin.ToPinyin("Zan 语言"); // "Zan  yuyan"
/// Non-hanzi characters pass through unchanged. The lookup table is built
/// lazily on first use and cached.
/// The dictionary itself lives in a data file (`pinyin.txt`, one
/// "汉字拼音" line per GB2312 hanzi), not in compiled code — like the Gui
/// icon packs it is resolved at run time through a discovery chain: env
/// `ZAN_PINYIN_DATA` (file), `pinyin.txt` beside the exe, embedded resource
/// `text/pinyin.txt` (zanc bakes the stdlib copy into every published
/// program carrying this module), then the stdlib source tree for source
/// checkouts. A replacement file overrides the baked-in table without
/// recompiling anything. Deliberately no System.IO dependency here: this
/// module must stay tiny for every program that merely touches pinyin.
/// </summary>
class Pinyin {
    /// Lazily built "hanzi -> pinyin" table (null until first lookup).
    static Dictionary<string, string> cache;

    /// <summary>The full pinyin of `text`: every hanzi becomes its pinyin,
    /// everything else (letters, digits, spaces, punctuation) stays as-is.
    /// Returns "" for empty input.</summary>
    static string ToPinyin(string text) {
        if (text == null || text.Length == 0) { return ""; }
        StringBuilder sb = new StringBuilder();
        int i = 0;
        int len = text.Length;
        int nonHanStart = 0;
        while (i < len) {
            int c0 = text[i] & 255;
            int w = Pinyin.Utf8ByteWidth(c0);
            if (w == 3 && i + 3 <= len) {
                string han = text.Substring(i, 3);
                string py = Pinyin.Lookup(han);
                if (py.Length > 0) {
                    if (i > nonHanStart) {
                        sb.Append(text.Substring(nonHanStart, i - nonHanStart));
                    }
                    sb.Append(py);
                    i = i + 3;
                    nonHanStart = i;
                    continue;
                }
            }
            i = i + w;
        }
        if (i > nonHanStart) {
            sb.Append(text.Substring(nonHanStart, i - nonHanStart));
        }
        return sb.ToString();
    }

    /// <summary>The first letter of each hanzi's pinyin, uppercased; other
    /// characters pass through. "中文" -> "ZW", "hello 世界" -> "hello S".</summary>
    static string Initials(string text) {
        if (text == null || text.Length == 0) { return ""; }
        StringBuilder sb = new StringBuilder();
        int i = 0;
        int len = text.Length;
        int nonHanStart = 0;
        while (i < len) {
            int c0 = text[i] & 255;
            int w = Pinyin.Utf8ByteWidth(c0);
            if (w == 3 && i + 3 <= len) {
                string han = text.Substring(i, 3);
                string py = Pinyin.Lookup(han);
                if (py.Length > 0) {
                    if (i > nonHanStart) {
                        sb.Append(text.Substring(nonHanStart, i - nonHanStart));
                    }
                    sb.Append(py.Substring(0, 1).ToUpper());
                    i = i + 3;
                    nonHanStart = i;
                    continue;
                }
            }
            i = i + w;
        }
        if (i > nonHanStart) {
            sb.Append(text.Substring(nonHanStart, i - nonHanStart));
        }
        return sb.ToString();
    }

    /// <summary>The pinyin of a single hanzi (pass any one-character string).
    /// Returns "" when `ch` is not a hanzi in the table.</summary>
    static string ToPinyinChar(string ch) {
        if (ch != null && ch.Length == 3) { return Pinyin.Lookup(ch); }
        return "";
    }

    /// The cached table, built on first use.
    static Dictionary<string, string> Table() {
        if (Pinyin.cache == null) { Pinyin.cache = Pinyin.Build(); }
        return Pinyin.cache;
    }

    /// Parse the "汉字拼音" dictionary text (one hanzi+pinyin per line)
    /// into the table; short or malformed lines are skipped.
    static Dictionary<string, string> Build() {
        Dictionary<string, string> d = new Dictionary<string, string>();
        string data = Pinyin.LoadData();
        List<string> lines = data.Split("\n");
        for (int i = 0; i < lines.Count; i = i + 1) {
            string line = lines[i];
            // CRLF 检出的工作区里 data 文件每行尾带 \r（blob 是 LF、autocrlf 检出成
            // CRLF），不剥掉就会把 "yi\r" 当成拼音值，Windows 上全表查不中。
            if (line.Length > 0 && (line[line.Length - 1] & 255) == 13) {
                line = line.Substring(0, line.Length - 1);
            }
            // "汉字拼音": 3-byte hanzi + ascii pinyin
            if (line.Length >= 4) {
                d[line.Substring(0, 3)] = line.Substring(3, line.Length - 3);
            }
        }
        return d;
    }

    /// Pinyin of one hanzi, or "" when it is not in the table.
    static string Lookup(string han) {
        string v = "";
        if (Pinyin.Table().TryGetValue(han, v)) { return v; }
        return "";
    }

    /// <summary>UTF-8 byte width of the first byte: 1 for ASCII,
    /// 2/3/4 for multi-byte sequences.</summary>
    static int Utf8ByteWidth(int c0) {
        if ((c0 & 0x80) == 0) { return 1; }
        if ((c0 & 0xE0) == 0xC0) { return 2; }
        if ((c0 & 0xF0) == 0xE0) { return 3; }
        return 4;
    }

    /// <summary>UTF-8 byte width of the first character: 1 for ASCII,
    /// 2/3/4 for multi-byte sequences.</summary>
    static int Utf8Width(string ch) {
        if (ch == null || ch.Length == 0) { return 0; }
        return Pinyin.Utf8ByteWidth(ch[0] & 255);
    }

    [DllImport("crt")]
    static extern string getenv(string name);

    [DllImport("crt", EntryPoint = "zan_file_fopen")]
    static extern nint zan_pkg_fopen(string path, string mode);

    [DllImport("crt")]
    static extern int fclose(nint fp);

    [DllImport("crt")]
    static extern long fread(byte[] buf, long size, long count, nint fp);

    // embedded-resource API (also declared in System.IO.File; declared here
    // too so this module keeps its zero-System.IO dependency footprint)
    [DllImport("crt")]
    static extern int zan_embed_has(string name);

    [DllImport("crt")]
    static extern string zan_embed_read(string name);

    /// getenv wrapper returning "" instead of null.
    static string Env(string name) {
        string v = getenv(name);
        if (v == null) { return ""; }
        return v;
    }

    /// <summary>Read a whole small text file via raw CRT handles — the same
    /// primitives File.ReadAllText uses, minus the System.IO dependency.</summary>
    static string ReadSmallFile(string path) {
        nint fp = zan_pkg_fopen(path, "rb");
        if (fp == 0) { return ""; }
        StringBuilder sb = new StringBuilder();
        byte[] chunk = new byte[8192];
        long n = fread(chunk, 1, 8192, fp);
        while (n > 0) {
            sb.Append(chunk.ToStr(0, (int)n));
            n = fread(chunk, 1, 8192, fp);
        }
        fclose(fp);
        return sb.ToString();
    }

    /// <summary>Directory of the running executable ("" when unknown);
    /// resolved through the same primitives ProcessHost.SelfExe uses.</summary>
    static string ExeDir() {
        string exe = "";
#if WINDOWS
        nint buf = NativeMemory.Alloc(8192);
        int n = GetModuleFileNameW(0, buf, 4096);
        if (n > 0 && n < 4096) { exe = Pinyin.WideToStr(buf); }
        NativeMemory.Free(buf);
#else
        byte[] b = new byte[4097];
        int n = readlink("/proc/self/exe", b, 4096);
        if (n > 0 && n <= 4096) { exe = b.ToStr(0, n); }
#endif
        int i = exe.Length;
        while (i > 0) {
            int c = exe[i - 1] & 255;
            if (c == 47 || c == 92) { break; }
            i = i - 1;
        }
        return exe.Substring(0, i);
    }

#if WINDOWS
    [DllImport("kernel32", EntryPoint = "GetModuleFileNameW")]
    static extern int GetModuleFileNameW(nint hModule, nint buf, int size);

    [DllImport("kernel32", EntryPoint = "WideCharToMultiByte")]
    static extern int ToMulti(int page, int flags, nint wide, int wideLen,
                              nint mb, int mbLen, nint defChar, nint usedDef);

    /// <summary>NUL-terminated UTF-16 buffer -> Zan string (mirrors
    /// Wide.Read; kept local to avoid a System dependency).</summary>
    static string WideToStr(nint p) {
        if (p == 0) { return ""; }
        int bytes = Pinyin.ToMulti(65001, 0, p, -1, 0, 0, 0, 0);
        if (bytes <= 1) { return ""; }
        nint outBuf = NativeMemory.Alloc(bytes + 1);
        Pinyin.ToMulti(65001, 0, p, -1, outBuf, bytes, 0, 0);
        string s = NativeMemory.GetString(outBuf, 0, bytes - 1);
        NativeMemory.Free(outBuf);
        return s;
    }
#else
    [DllImport("crt")]
    static extern int readlink(string path, byte[] buf, int size);
#endif

    /// <summary>True when the path opens as a readable file. (fopen on a
    /// directory succeeds on POSIX, but the discovery chain only ever asks
    /// for concrete file names, so a handle check is enough here.)</summary>
    static bool ReadableFile(string path) {
        nint fp = zan_pkg_fopen(path, "rb");
        if (fp == 0) { return false; }
        fclose(fp);
        return true;
    }

    /// True when the named embedded resource exists.
    static bool EmbedExists(string path) {
        return zan_embed_has(path) != 0;
    }

    /// <summary>Load the "汉字拼音" dictionary text through the same kind of
    /// discovery chain the Gui icon packs use: env override, a file beside
    /// the exe, embedded resources, the stdlib source tree. Returns "" when
    /// nothing is found — the table then stays empty and lookups pass hanzi
    /// through unchanged.</summary>
    static string LoadData() {
        string p = Pinyin.Env("ZAN_PINYIN_DATA");
        if (p.Length > 0 && Pinyin.ReadableFile(p)) { return Pinyin.ReadSmallFile(p); }
        string exe = Pinyin.ExeDir();
        p = exe + "/pinyin.txt";
        if (Pinyin.ReadableFile(p)) { return Pinyin.ReadSmallFile(p); }
        if (Pinyin.EmbedExists("text/pinyin.txt")) {
            return zan_embed_read("text/pinyin.txt");
        }
        // Source checkout: the exe lives under <repo>/{build,dist,tests,...},
        // so walk up looking for the package copy (bounded, no System.IO).
        // ExeDir keeps its trailing separator, which would make the loop
        // below break on the first character every round -- strip it first.
        string dir = exe;
        if (dir.Length > 0) {
            int last = dir[dir.Length - 1] & 255;
            if (last == 47 || last == 92) {
                dir = dir.Substring(0, dir.Length - 1);
            }
        }
        for (int up = 0; up < 6; up = up + 1) {
            int i = dir.Length;
            while (i > 0) {
                int c = dir[i - 1] & 255;
                if (c == 47 || c == 92) { break; }
                i = i - 1;
            }
            dir = dir.Substring(0, i);
            if (dir.Length == 0) { break; }
            p = dir + "packages/Zan.Text/src/System/Text/data/pinyin.txt";
            if (Pinyin.ReadableFile(p)) { return Pinyin.ReadSmallFile(p); }
        }
        return "";
    }
}
