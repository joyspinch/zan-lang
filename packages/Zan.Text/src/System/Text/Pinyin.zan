using System;

namespace System.Text;

// string py = Pinyin.ToPinyin("中文");     // "zhongwen"
// string ab = Pinyin.Initials("中文");     // "ZW"
// string py = Pinyin.ToPinyin("Zan 语言"); // "Zan  yuyan"
// "汉字拼音" line per GB2312 hanzi), not in compiled code — like the Gui
internal class PinyinTables {
    public string[] bmpTable;
    public byte[] bmpInitial;
    public byte[] bmpBlob;
    public int[] bmpOffLen;
    public Dictionary<string, string> extraCache;
}

public class Pinyin {
    public static Dictionary<string, string> cache;
    private static PinyinTables s_tables;
    private static string initLock = "Zan.Pinyin.Init";

    private static PinyinTables EnsureTables() {
        PinyinTables cached = Pinyin.s_tables;
        if (cached != null) { return cached; }
        lock (Pinyin.initLock) {
            if (Pinyin.s_tables != null) { return Pinyin.s_tables; }
            string[] tbl = new string[20992];
            byte[] ini = new byte[20992];
            int[] offLen = new int[20992];
            byte[] blob = new byte[4096];
            nint blobPtr = (nint)blob;
            int blobLen = 0;
            Dictionary<string, int> blobOffs = new Dictionary<string, int>();
            Dictionary<string, string> extra = null;
            Dictionary<string, string> intern = new Dictionary<string, string>();
            string data = Pinyin.LoadData();
            int dataLen = data.Length;
            nint dPtr = dataLen > 0 ? (nint)data : 0;
            Span<byte> dsp = new Span<byte>(dPtr, dataLen);
            int pos = 0;
            while (pos < dataLen) {
                int nl = NativeMemory.Find(dPtr, pos, 10, dataLen - pos);
                int lineEnd = nl >= 0 ? nl : dataLen;
                int contentEnd = lineEnd;
                // CRLF 检出的工作区里 data 文件每行尾带 \r，剥除尾 \r
                if (contentEnd > pos && (dsp[contentEnd - 1] & 255) == 13) {
                    contentEnd = contentEnd - 1;
                }
                if (contentEnd - pos >= 4) {
                    int c0 = dsp[pos] & 255;
                    int pyLen = contentEnd - pos - 3;
                    string rawPy = data.Substring(pos + 3, pyLen);
                    string py = "";
                    if (!intern.TryGetValue(rawPy, out py)) {
                        intern[rawPy] = rawPy;
                        py = rawPy;
                    }
                    if ((c0 & 0xF0) == 0xE0) {
                        int cp = ((c0 & 0x0F) << 12) | ((dsp[pos + 1] & 0x3F) << 6) | (dsp[pos + 2] & 0x3F);
                        if (cp >= 0x4E00 && cp <= 0x9FFF) {
                            int idx = cp - 0x4E00;
                            tbl[idx] = py;
                            int ch0 = py[0] & 255;
                            ini[idx] = (ch0 >= 97 && ch0 <= 122) ? (byte)(ch0 - 96) : (byte)255;
                            if (pyLen > 0 && pyLen <= 15) {
                                int bo = 0;
                                if (!blobOffs.TryGetValue(py, out bo)) {
                                    if (blobLen + pyLen > blob.Length) {
                                        blob = Pinyin.GrowBuf(blob, blobLen, blobLen + pyLen, out blobPtr);
                                    }
                                    bo = blobLen;
                                    NativeMemory.Copy(blobPtr + (nint)bo, (nint)py, pyLen);
                                    blobLen = blobLen + pyLen;
                                    blobOffs[py] = bo;
                                }
                                offLen[idx] = (bo << 4) | pyLen;
                            }
                        } else {
                            if (extra == null) { extra = new Dictionary<string, string>(); }
                            extra[data.Substring(pos, 3)] = py;
                        }
                    } else {
                        if (extra == null) { extra = new Dictionary<string, string>(); }
                        extra[data.Substring(pos, 3)] = py;
                    }
                }
                pos = nl >= 0 ? nl + 1 : dataLen;
            }
            byte[] finalBlob = new byte[blobLen > 0 ? blobLen : 1];
            if (blobLen > 0) { NativeMemory.Copy((nint)finalBlob, blobPtr, blobLen); }
            PinyinTables built = new PinyinTables();
            built.bmpTable = tbl;
            built.bmpInitial = ini;
            built.bmpBlob = finalBlob;
            built.bmpOffLen = offLen;
            built.extraCache = extra;
            Pinyin.s_tables = built;
            return built;
        }
    }

    private static byte[] GrowBuf(byte[] buf, int used, int need, out nint bp) {
        int cap = buf.Length * 2;
        if (cap < 64) { cap = 64; }
        while (cap < need) { cap = cap * 2; }
        byte[] grown = new byte[cap];
        nint gp = (nint)grown;
        if (used > 0) { NativeMemory.Copy(gp, (nint)buf, used); }
        bp = gp;
        return grown;
    }

    public static string ToPinyin(string text) {
        if (text == null || text.Length == 0) { return ""; }
        PinyinTables tables = Pinyin.s_tables;
        if (tables == null) { tables = Pinyin.EnsureTables(); }
        byte[] blob = tables.bmpBlob;
        int[] offLen = tables.bmpOffLen;
        string[] tbl = tables.bmpTable;
        Dictionary<string, string> extra = tables.extraCache;

        int len = text.Length;
        nint tPtr = (nint)text;
        Span<byte> tsp = new Span<byte>(tPtr, len);
        Span<byte> blobSp = new Span<byte>((nint)blob, blob.Length);
        Span<int> offSp = new Span<int>((nint)offLen, offLen.Length);
        byte[] outBuf = null;
        nint outPtr = (nint)0;
        Span<byte> outSp = new Span<byte>((nint)0, 0);
        int outCap = 0;
        int di = 0;
        int i = 0;
        int nonHanStart = 0;
        while (i < len) {
            int c0 = tsp[i] & 255;
            if ((c0 & 0x80) == 0) {
                i = i + 1;
                continue;
            }
            if ((c0 & 0xF0) == 0xE0 && i + 3 <= len) {
                int cp = ((c0 & 0x0F) << 12) | ((tsp[i + 1] & 0x3F) << 6) | (tsp[i + 2] & 0x3F);
                if (cp >= 0x4E00 && cp <= 0x9FFF) {
                    int entry = offSp[cp - 0x4E00];
                    if (entry != 0) {
                        int pyLen = entry & 15;
                        int pyOff = entry >> 4;
                        int segLen = i - nonHanStart;
                        if (outBuf == null) {
                            outCap = len * 2 + 16;
                            if (outCap < segLen + pyLen) { outCap = segLen + pyLen + 16; }
                            outBuf = new byte[outCap];
                            outPtr = (nint)outBuf;
                            outSp = new Span<byte>(outPtr, outCap);
                        } else if (di + segLen + pyLen > outCap) {
                            outBuf = Pinyin.GrowBuf(outBuf, di, di + segLen + pyLen, out outPtr);
                            outCap = outBuf.Length;
                            outSp = new Span<byte>(outPtr, outCap);
                        }
                        if (segLen > 0) {
                            if (segLen <= 8) {
                                for (int k = 0; k < segLen; k = k + 1) {
                                    outSp[di + k] = tsp[nonHanStart + k];
                                }
                            } else {
                                NativeMemory.Copy(outPtr + (nint)di, tPtr + (nint)nonHanStart, segLen);
                            }
                            di = di + segLen;
                        }
                        for (int k = 0; k < pyLen; k = k + 1) {
                            outSp[di + k] = blobSp[pyOff + k];
                        }
                        di = di + pyLen;
                        i = i + 3;
                        nonHanStart = i;
                        continue;
                    }
                    string py = tbl[cp - 0x4E00];
                    if (py != null && py.Length > 0) {
                        int segLen = i - nonHanStart;
                        int pyLen = py.Length;
                        if (outBuf == null) {
                            outCap = len * 2 + 16;
                            if (outCap < segLen + pyLen) { outCap = segLen + pyLen + 16; }
                            outBuf = new byte[outCap];
                            outPtr = (nint)outBuf;
                            outSp = new Span<byte>(outPtr, outCap);
                        } else if (di + segLen + pyLen > outCap) {
                            outBuf = Pinyin.GrowBuf(outBuf, di, di + segLen + pyLen, out outPtr);
                            outCap = outBuf.Length;
                            outSp = new Span<byte>(outPtr, outCap);
                        }
                        if (segLen > 0) {
                            NativeMemory.Copy(outPtr + (nint)di, tPtr + (nint)nonHanStart, segLen);
                            di = di + segLen;
                        }
                        NativeMemory.Copy(outPtr + (nint)di, (nint)py, pyLen);
                        di = di + pyLen;
                        i = i + 3;
                        nonHanStart = i;
                        continue;
                    }
                    i = i + 3;
                    continue;
                } else if (extra != null) {
                    string py = "";
                    if (extra.TryGetValue(text.Substring(i, 3), out py) && py.Length > 0) {
                        int segLen = i - nonHanStart;
                        int pyLen = py.Length;
                        if (outBuf == null) {
                            outCap = len * 2 + 16;
                            if (outCap < segLen + pyLen) { outCap = segLen + pyLen + 16; }
                            outBuf = new byte[outCap];
                            outPtr = (nint)outBuf;
                            outSp = new Span<byte>(outPtr, outCap);
                        } else if (di + segLen + pyLen > outCap) {
                            outBuf = Pinyin.GrowBuf(outBuf, di, di + segLen + pyLen, out outPtr);
                            outCap = outBuf.Length;
                            outSp = new Span<byte>(outPtr, outCap);
                        }
                        if (segLen > 0) {
                            NativeMemory.Copy(outPtr + (nint)di, tPtr + (nint)nonHanStart, segLen);
                            di = di + segLen;
                        }
                        NativeMemory.Copy(outPtr + (nint)di, (nint)py, pyLen);
                        di = di + pyLen;
                        i = i + 3;
                        nonHanStart = i;
                        continue;
                    }
                }
                i = i + 3;
                continue;
            }
            int step = Pinyin.Utf8ByteWidth(c0);
            if (step > len - i) { step = len - i; }
            i = i + step;
        }
        if (outBuf == null) { return text; }
        int tail = len - nonHanStart;
        if (tail > 0) {
            if (di + tail > outCap) {
                outBuf = Pinyin.GrowBuf(outBuf, di, di + tail, out outPtr);
            }
            NativeMemory.Copy(outPtr + (nint)di, tPtr + (nint)nonHanStart, tail);
            di = di + tail;
        }
        return NativeMemory.GetString(outPtr, 0, di);
    }

    // characters pass through. "中文" -> "ZW", "hello 世界" -> "hello SJ".
    public static string Initials(string text) {
        if (text == null || text.Length == 0) { return ""; }
        PinyinTables tables = Pinyin.s_tables;
        if (tables == null) { tables = Pinyin.EnsureTables(); }
        byte[] ini = tables.bmpInitial;
        string[] tbl = tables.bmpTable;
        Dictionary<string, string> extra = tables.extraCache;

        int len = text.Length;
        nint tPtr = (nint)text;
        Span<byte> tsp = new Span<byte>(tPtr, len);
        Span<byte> iniSp = new Span<byte>((nint)ini, ini.Length);
        byte[] outBuf = null;
        nint outPtr = (nint)0;
        Span<byte> outSp = new Span<byte>((nint)0, 0);
        int di = 0;
        int i = 0;
        int nonHanStart = 0;
        while (i < len) {
            int c0 = tsp[i] & 255;
            if ((c0 & 0x80) == 0) {
                i = i + 1;
                continue;
            }
            if ((c0 & 0xF0) == 0xE0 && i + 3 <= len) {
                int cp = ((c0 & 0x0F) << 12) | ((tsp[i + 1] & 0x3F) << 6) | (tsp[i + 2] & 0x3F);
                if (cp >= 0x4E00 && cp <= 0x9FFF) {
                    int idx = cp - 0x4E00;
                    int code = iniSp[idx] & 255;
                    if (code != 0) {
                        if (outBuf == null) {
                            outBuf = new byte[len];
                            outPtr = (nint)outBuf;
                            outSp = new Span<byte>(outPtr, len);
                        }
                        int segLen = i - nonHanStart;
                        if (segLen > 0) {
                            if (segLen <= 8) {
                                for (int k = 0; k < segLen; k = k + 1) {
                                    outSp[di + k] = tsp[nonHanStart + k];
                                }
                            } else {
                                NativeMemory.Copy(outPtr + (nint)di, tPtr + (nint)nonHanStart, segLen);
                            }
                            di = di + segLen;
                        }
                        if (code <= 26) {
                            outSp[di] = (byte)(64 + code);
                        } else {
                            outSp[di] = (byte)(tbl[idx][0] & 255);
                        }
                        di = di + 1;
                        i = i + 3;
                        nonHanStart = i;
                        continue;
                    }
                } else if (extra != null) {
                    string py = "";
                    if (extra.TryGetValue(text.Substring(i, 3), out py) && py.Length > 0) {
                        if (outBuf == null) {
                            outBuf = new byte[len];
                            outPtr = (nint)outBuf;
                            outSp = new Span<byte>(outPtr, len);
                        }
                        int segLen = i - nonHanStart;
                        if (segLen > 0) {
                            NativeMemory.Copy(outPtr + (nint)di, tPtr + (nint)nonHanStart, segLen);
                            di = di + segLen;
                        }
                        int ch0 = py[0] & 255;
                        outSp[di] = (byte)((ch0 >= 97 && ch0 <= 122) ? (ch0 - 32) : ch0);
                        di = di + 1;
                        i = i + 3;
                        nonHanStart = i;
                        continue;
                    }
                }
                i = i + 3;
                continue;
            }
            int step = Pinyin.Utf8ByteWidth(c0);
            if (step > len - i) { step = len - i; }
            i = i + step;
        }
        if (outBuf == null) { return text; }
        int tail = len - nonHanStart;
        if (tail > 0) {
            NativeMemory.Copy(outPtr + (nint)di, tPtr + (nint)nonHanStart, tail);
            di = di + tail;
        }
        return NativeMemory.GetString(outPtr, 0, di);
    }

    public static string ToPinyinChar(string ch) {
        if (ch != null && ch.Length == 3) { return Pinyin.Lookup(ch); }
        return "";
    }

    public static Dictionary<string, string> Table() {
        lock (Pinyin.initLock) {
            if (Pinyin.cache == null) { Pinyin.cache = Pinyin.Build(); }
            return Pinyin.cache;
        }
    }

    // Parse the "汉字拼音" dictionary text (one hanzi+pinyin per line)
    static Dictionary<string, string> Build() {
        Dictionary<string, string> d = new Dictionary<string, string>();
        string data = Pinyin.LoadData();
        int dataLen = data.Length;
        nint dPtr = dataLen > 0 ? (nint)data : 0;
        int pos = 0;
        while (pos < dataLen) {
            int nl = NativeMemory.Find(dPtr, pos, 10, dataLen - pos);
            int lineEnd = nl >= 0 ? nl : dataLen;
            int contentEnd = lineEnd;
            if (contentEnd > pos && (data[contentEnd - 1] & 255) == 13) {
                contentEnd = contentEnd - 1;
            }
            // "汉字拼音": 3-byte hanzi + ascii pinyin
            if (contentEnd - pos >= 4) {
                d[data.Substring(pos, 3)] = data.Substring(pos + 3, contentEnd - pos - 3);
            }
            pos = nl >= 0 ? nl + 1 : dataLen;
        }
        return d;
    }

    public static string Lookup(string han) {
        if (han == null || han.Length == 0) { return ""; }
        PinyinTables tables = Pinyin.s_tables;
        if (tables == null) { tables = Pinyin.EnsureTables(); }
        if (han.Length == 3) {
            Span<byte> sp = new Span<byte>((nint)han, 3);
            int c0 = sp[0] & 255;
            if ((c0 & 0xF0) == 0xE0) {
                int cp = ((c0 & 0x0F) << 12) | ((sp[1] & 0x3F) << 6) | (sp[2] & 0x3F);
                if (cp >= 0x4E00 && cp <= 0x9FFF) {
                    string py = tables.bmpTable[cp - 0x4E00];
                    return py != null ? py : "";
                }
            }
        }
        Dictionary<string, string> extra = tables.extraCache;
        if (extra != null) {
            string v = "";
            if (extra.TryGetValue(han, out v)) { return v; }
        }
        return "";
    }

    // 拆卸拼音静态缓存表，便于泄漏检查与按需释放。
    public static void Teardown() {
        lock (Pinyin.initLock) {
            Pinyin.s_tables = null;
            if (Pinyin.cache != null) {
                Pinyin.cache.Clear();
                Pinyin.cache = null;
            }
        }
    }

    public static int Utf8ByteWidth(int c0) {
        if ((c0 & 0x80) == 0) { return 1; }
        if ((c0 & 0xE0) == 0xC0) { return 2; }
        if ((c0 & 0xF0) == 0xE0) { return 3; }
        return 4;
    }

    public static int Utf8Width(string ch) {
        if (ch == null || ch.Length == 0) { return 0; }
        return Pinyin.Utf8ByteWidth(ch[0] & 255);
    }

    [DllImport("crt", EntryPoint = "zan_file_fopen")]
    private static extern nint zan_pkg_fopen(string path, string mode);

    [DllImport("crt")]
    private static extern int fclose(nint fp);

    [DllImport("crt")]
    private static extern long fread(byte[] buf, long size, long count, nint fp);

    [DllImport("crt")]
    private static extern int zan_embed_has(string name);

    [DllImport("crt")]
    private static extern string zan_embed_read(string name);

    public static string ReadSmallFile(string path) {
        nint fp = zan_pkg_fopen(path, "rb");
        if (fp == 0) { return ""; }
        try {
            StringBuilder sb = new StringBuilder();
            byte[] chunk = new byte[8192];
            long n = fread(chunk, 1, 8192, fp);
            while (n > 0) {
                sb.Append(chunk.ToStr(0, (int)n));
                n = fread(chunk, 1, 8192, fp);
            }
            return sb.ToString();
        } finally {
            fclose(fp);
        }
    }

    public static string ExeDir() {
        string exe = "";
#if WINDOWS
        nint buf = NativeMemory.Alloc(8192);
        if (buf == 0) { return ""; }
        try {
            int n = GetModuleFileNameW(0, buf, 4096);
            if (n > 0 && n < 4096) { exe = Pinyin.WideToStr(buf); }
        } finally {
            NativeMemory.Free(buf);
        }
#else
        byte[] b = new byte[4097];
        int n = readlink("/proc/self/exe", b, 4096);
        if (n > 0 && n <= 4096) { exe = b.ToStr(0, n); }
#endif
        int i = exe.Length;
        while (i > 0) {
            int c = exe[i - 1] & 255;
            if (c == 47 || c == 92) { break; }
            i = i - 1;
        }
        return exe.Substring(0, i);
    }

#if WINDOWS
    [DllImport("kernel32", EntryPoint = "GetModuleFileNameW")]
    private static extern int GetModuleFileNameW(nint hModule, nint buf, int size);

    [DllImport("kernel32", EntryPoint = "WideCharToMultiByte")]
    private static extern int ToMulti(int page, int flags, nint wide, int wideLen,
                              nint mb, int mbLen, nint defChar, nint usedDef);

    public static string WideToStr(nint p) {
        if (p == 0) { return ""; }
        int bytes = Pinyin.ToMulti(65001, 0, p, -1, 0, 0, 0, 0);
        if (bytes <= 1 || bytes > 1048576) { return ""; }
        nint outBuf = NativeMemory.Alloc(bytes + 1);
        if (outBuf == 0) { return ""; }
        try {
            int written = Pinyin.ToMulti(65001, 0, p, -1, outBuf, bytes, 0, 0);
            if (written <= 1 || written > bytes) { return ""; }
            return NativeMemory.GetString(outBuf, 0, written - 1);
        } finally {
            NativeMemory.Free(outBuf);
        }
    }
#else
    [DllImport("crt")]
    private static extern int readlink(string path, byte[] buf, int size);
#endif

    public static bool ReadableFile(string path) {
        nint fp = zan_pkg_fopen(path, "rb");
        if (fp == 0) { return false; }
        fclose(fp);
        return true;
    }

    public static bool EmbedExists(string path) {
        return zan_embed_has(path) != 0;
    }

    // Load the "汉字拼音" dictionary text through the same kind of
    public static string LoadData() {
        string exe = Pinyin.ExeDir();
        string p = exe + "/pinyin.txt";
        if (Pinyin.ReadableFile(p)) { return Pinyin.ReadSmallFile(p); }
        if (Pinyin.EmbedExists("text/pinyin.txt")) {
            return zan_embed_read("text/pinyin.txt");
        }
        if (exe.Length > 0) {
            p = exe + "/packages/Zan.Text/src/System/Text/data/pinyin.txt";
            if (Pinyin.ReadableFile(p)) { return Pinyin.ReadSmallFile(p); }
        }
        p = "packages/Zan.Text/src/System/Text/data/pinyin.txt";
        if (Pinyin.ReadableFile(p)) { return Pinyin.ReadSmallFile(p); }
        return "";
    }
}
